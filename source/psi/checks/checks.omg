use psi::source::source;

// What checking concludes about a typed source set: its rejections, the
// number of definedness obligations it discharged, and each machine's crash
// routes. Checking runs after typing and owns the source obligations of
// wiki/spec/language/numeric_values.md and
// wiki/spec/language/state_contracts.md: an index stays inside its
// collection, an Exact operation's result fits its carrier, a divisor is
// nonzero, a narrowing conversion fits, a shift count fits the width, and a
// call or state jump establishes the target's `requires` facts. An
// obligation the facts at its program point cannot prove rejects; proof
// search failing is not a refutation, and it grants nothing
// (wiki/spec/language/effects.md#recoverable-outcomes-and-strict-use).
public data CheckDiagnosticCode [copy] {
    case None;
    // A body holds more integer subjects, or a machine more states, than
    // the checker's tables.
    case CheckCapacityExceeded;
    // A fact outside the forms checking reasons with: a proposition
    // application that must hold, or a `satisfies` requirement's or
    // satisfier's contract facts.
    case UnsupportedFact;
    // An expression form checking does not reason about yet.
    case UnsupportedCheck;
    case IndexOutOfBounds;
    case ArithmeticOverflow;
    case DivisorMayBeZero;
    case ConversionOutOfRange;
    case ShiftCountOutOfRange;
    case RequirementUnproven;
    case DomainUnproven;
    // A crash route outside the machine's published crash causes.
    case CrashNotDeclared;
    // A normal return whose machine's `ensures` facts are not proved.
    case GuaranteeUnproven;
    // A cyclic transition of a terminating body whose ranking descent is
    // not proved, or that no `terminates by` witness ranks.
    case RankUnproven;
    // A terminating body that reaches an operation without a usable
    // termination guarantee.
    case ProgressUnproven;
    // A use of a place a path has moved, of a part of it or of a whole
    // containing it, or a write into a moved place's part.
    case UseAfterMove;
    // A by-value use of an affine or linear place reached through a
    // reference or bound from a borrowed subject.
    case MoveOutOfBorrow;
    // A linear value an exit, a discard or one path of a reconvergence
    // leaves unconsumed.
    case LinearUnconsumed;
    // An assignment over a live linear place.
    case LinearOverwritten;
    // A call argument accessing a place an earlier argument holds, either
    // exclusively.
    case OverlappingArguments;
    // An access to a place a live loan held by a local covers, the loan or
    // the access exclusive.
    case LoanConflict;
    // An exit returning a loan of storage the body owns.
    case LoanEscapes;
    // A recast's target representation does not follow from its source's
    // (checking/recasts.omg).
    case RepresentationUnproven;
    // A read, a shared or exclusive borrow, or an inspection of a place
    // reached through a `&write` reference
    // (wiki/spec/language/ownership.md#borrows-and-aliases).
    case WriteOnlyObservation;
    // A `terminates by` witness's rank range the entry rank or a cyclic
    // arrival's rank is not proved within, or whose endpoints a cyclic
    // arrival changes (wiki/spec/language/termination.md#ranking).
    case RankRangeUnproven;
}

public data CheckDiagnostic [copy] {
    code: CheckDiagnosticCode;
    source_span: SourceSpan;
}

// A machine's crash causes. `declared` causes come from its `crashes`
// clauses; a private machine without any is `inferred` and publishes what
// its body derives. `trap` and `abort` are the derived causes: its own crash
// statements and Trapping operations, and its callees' published causes
// (wiki/spec/language/effects.md#guarded-crashes).
public data CrashRoutes [copy] {
    declares_trap: bool;
    declares_abort: bool;
    inferred: bool;
    trap: bool;
    abort: bool;
}

// Machines check independently, so one rejection does not end checking: each
// pass over the machines (their bodies, their crash routes, their supply
// clauses) records the first rejection of every machine it rejects, in the
// order found, until 64 are recorded.
public data Checks
where
    machine_count <= 10240,
    diagnostic_count <= 64,
{
    routes: [CrashRoutes; 10240];
    machine_count: u64;
    obligation_count: u64 in Wrapping;
    diagnostics: [CheckDiagnostic; 64];
    diagnostic_count: u64;
    accepted: bool;
    // Whether the machine a pass is at has not rejected yet; its checking
    // stops at its first rejection.
    machine_accepted: bool;
    // Public slot records for trait requirements: returned-borrow origins
    // and parameter qualification preconditions. The parameter index is the
    // requirement's dense reference-parameter lane.
    slot_origins: [SlotReturnedBorrowOrigin; 64];
    slot_origin_count: u64;
    slot_qualifications: [SlotParameterQualification; 64];
    slot_qualification_count: u64;
}

// A returned borrow's public input. `Parameter` names a reference parameter.
// `Invocation` is a result the requirement does not borrow from an input.
public data SlotOriginKind [copy] {
    case Parameter;
    case Invocation;
}

public data SlotReturnedBorrowOrigin [copy] {
    kind: SlotOriginKind;
    parameter_index: u64 in Trapping;
}

// One declared domain a reference parameter must already carry.
public data SlotParameterQualification [copy] {
    parameter_index: u64 in Trapping;
    domain_item: u64 in Trapping;
}

// A pass moves on to another machine.
public machine Checks::open_machine(checks: &mut Checks) {
    checks.machine_accepted = true;
}

public machine Checks::reject(checks: &mut Checks, code: CheckDiagnosticCode, source_span: SourceSpan) {
    transition checks.machine_accepted {
        true -> first(checks, code, source_span)
        _ -> done()
    }

    machine first(checks: &mut Checks, code: CheckDiagnosticCode, source_span: SourceSpan) {
        checks.accepted = false;
        checks.machine_accepted = false;
        let index: u64 = checks.diagnostic_count;
        transition index < 64 {
            true -> recorded(checks, code, source_span, index)
            _ -> done()
        }
    }

    machine recorded(checks: &mut Checks, code: CheckDiagnosticCode, source_span: SourceSpan, index: u64)
    requires index < 64
    {
        checks.diagnostics[index] = CheckDiagnostic { code: code, source_span: source_span };
        checks.diagnostic_count = index + 1;
    }

    machine done() {}
}

// The rejection at `index`, in the order checking found them.
public machine Checks::diagnostic(checks: &Checks, index: u64 in Trapping) -> CheckDiagnostic
crashes Trap
{
    transition index < checks.diagnostic_count && index < 64 {
        true -> read(checks, index)
        _ -> invalid()
    }

    machine read(checks: &Checks, index: u64 in Trapping) -> CheckDiagnostic
    requires index < 64
    {
        checks.diagnostics[index]
    }

    machine invalid() -> CheckDiagnostic {
        crash Trap;
    }
}

public machine Checks::routes(checks: &Checks, machine: u64 in Trapping) -> CrashRoutes
crashes Trap
{
    transition machine < checks.machine_count {
        true -> read(checks, machine)
        _ -> invalid()
    }

    machine read(checks: &Checks, machine: u64 in Trapping) -> CrashRoutes {
        checks.routes[machine]
    }

    machine invalid() -> CrashRoutes {
        crash Trap;
    }
}

public machine Checks::set_routes(checks: &mut Checks, machine: u64 in Trapping, routes: CrashRoutes)
crashes Trap
{
    transition machine < checks.machine_count {
        true -> write(checks, machine, routes)
        _ -> invalid()
    }

    machine write(checks: &mut Checks, machine: u64 in Trapping, routes: CrashRoutes) {
        checks.routes[machine] = routes;
    }

    machine invalid() {
        crash Trap;
    }
}

public machine Checks::clear_slot_records(checks: &mut Checks) {
    checks.slot_origin_count = 0;
    checks.slot_qualification_count = 0;
}

public machine Checks::push_slot_origin(
    checks: &mut Checks,
    kind: SlotOriginKind,
    parameter_index: u64 in Trapping
) -> bool
crashes Trap
{
    let index: u64 = checks.slot_origin_count;
    transition index < 64 {
        true -> write(checks, kind, parameter_index, index)
        _ -> full()
    }

    machine write(checks: &mut Checks, kind: SlotOriginKind, parameter_index: u64 in Trapping, index: u64) -> bool
    requires index < 64
    {
        checks.slot_origins[index] = SlotReturnedBorrowOrigin { kind: kind, parameter_index: parameter_index };
        checks.slot_origin_count = index + 1;
        true
    }

    machine full() -> bool {
        false
    }
}

public machine Checks::slot_origin(checks: &Checks, index: u64 in Trapping) -> SlotReturnedBorrowOrigin
crashes Trap
{
    transition index < checks.slot_origin_count && index < 64 {
        true -> read(checks, index)
        _ -> invalid()
    }

    machine read(checks: &Checks, index: u64 in Trapping) -> SlotReturnedBorrowOrigin
    requires index < 64
    {
        checks.slot_origins[index]
    }

    machine invalid() -> SlotReturnedBorrowOrigin {
        crash Trap;
    }
}

public machine Checks::push_slot_qualification(
    checks: &mut Checks,
    parameter_index: u64 in Trapping,
    domain_item: u64 in Trapping
) -> bool
crashes Trap
{
    let index: u64 = checks.slot_qualification_count;
    transition index < 64 {
        true -> write(checks, parameter_index, domain_item, index)
        _ -> full()
    }

    machine write(
        checks: &mut Checks,
        parameter_index: u64 in Trapping,
        domain_item: u64 in Trapping,
        index: u64
    ) -> bool
    requires index < 64
    {
        checks.slot_qualifications[index] = SlotParameterQualification {
            parameter_index: parameter_index,
            domain_item: domain_item
        };
        checks.slot_qualification_count = index + 1;
        true
    }

    machine full() -> bool {
        false
    }
}

public machine Checks::slot_qualification(checks: &Checks, index: u64 in Trapping) -> SlotParameterQualification
crashes Trap
{
    transition index < checks.slot_qualification_count && index < 64 {
        true -> read(checks, index)
        _ -> invalid()
    }

    machine read(checks: &Checks, index: u64 in Trapping) -> SlotParameterQualification
    requires index < 64
    {
        checks.slot_qualifications[index]
    }

    machine invalid() -> SlotParameterQualification {
        crash Trap;
    }
}
