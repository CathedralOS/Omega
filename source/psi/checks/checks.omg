use psi::source::source;

// What checking concludes about a typed source set: its rejections, the
// number of definedness obligations it discharged, and each machine's crash
// routes. Checking runs after typing and owns the source obligations of
// wiki/spec/language/numeric_values.md and
// wiki/spec/language/state_contracts.md: an index stays inside its
// collection, an Exact operation's result fits its carrier, a divisor is
// nonzero, a narrowing conversion fits, a shift count fits the width, and a
// call or state jump establishes the target's `requires` facts. An
// obligation the facts at its program point cannot prove rejects; proof
// search failing is not a refutation, and it grants nothing
// (wiki/spec/language/effects.md#recoverable-outcomes-and-strict-use).
pub data CheckDiagnosticCode [copy] {
    case None;
    // A body holds more integer subjects, or a machine more states, than
    // the checker's tables.
    case CheckCapacityExceeded;
    // A fact outside the forms checking reasons with: a proposition
    // application that must hold, or a `satisfies` requirement's or
    // satisfier's contract facts.
    case UnsupportedFact;
    // An expression form checking does not reason about yet.
    case UnsupportedCheck;
    case IndexOutOfBounds;
    case ArithmeticOverflow;
    case DivisorMayBeZero;
    case ConversionOutOfRange;
    case ShiftCountOutOfRange;
    case RequirementUnproven;
    case DomainUnproven;
    // A crash route outside the machine's published crash causes.
    case CrashNotDeclared;
    // A normal return whose machine's `ensures` facts are not proved.
    case GuaranteeUnproven;
    // A cyclic transition of a terminating body whose ranking descent is
    // not proved, or that no `terminates by` witness ranks.
    case RankUnproven;
    // A terminating body that reaches an operation without a usable
    // termination guarantee.
    case ProgressUnproven;
    // A use of a place a path has moved, of a part of it or of a whole
    // containing it, or a write into a moved place's part.
    case UseAfterMove;
    // A by-value use of an affine or linear place reached through a
    // reference or bound from a borrowed subject.
    case MoveOutOfBorrow;
    // A linear value an exit, a discard or one path of a reconvergence
    // leaves unconsumed.
    case LinearUnconsumed;
    // An assignment over a live linear place.
    case LinearOverwritten;
    // A call argument accessing a place an earlier argument holds, either
    // exclusively.
    case OverlappingArguments;
    // An access to a place a live loan held by a local covers, the loan or
    // the access exclusive.
    case LoanConflict;
    // An exit returning a loan of storage the body owns.
    case LoanEscapes;
    // A recast's target representation does not follow from its source's
    // (checking/recasts.omg).
    case RepresentationUnproven;
    // A read, a shared or exclusive borrow, or an inspection of a place
    // reached through a `&write` reference
    // (wiki/spec/language/ownership.md#borrows-and-aliases).
    case WriteOnlyObservation;
}

pub data CheckDiagnostic [copy] {
    code: CheckDiagnosticCode;
    source_span: SourceSpan;
}

// A machine's crash causes. `declared` causes come from its `crashes`
// clauses; a private machine without any is `inferred` and publishes what
// its body derives. `trap` and `abort` are the derived causes: its own crash
// statements and Trapping operations, and its callees' published causes
// (wiki/spec/language/effects.md#guarded-crashes).
pub data CrashRoutes [copy] {
    declares_trap: bool;
    declares_abort: bool;
    inferred: bool;
    trap: bool;
    abort: bool;
}

// Machines check independently, so one rejection does not end checking: each
// pass over the machines (their bodies, their crash routes, their supply
// clauses) records the first rejection of every machine it rejects, in the
// order found, until 64 are recorded.
pub data Checks
where
    machine_count <= 2048,
    diagnostic_count <= 64,
{
    routes: [CrashRoutes; 2048];
    machine_count: u64;
    obligation_count: u64 in Wrapping;
    diagnostics: [CheckDiagnostic; 64];
    diagnostic_count: u64;
    accepted: bool;
    // Whether the machine a pass is at has not rejected yet; its checking
    // stops at its first rejection.
    machine_accepted: bool;
}

// A pass moves on to another machine.
pub machine Checks::open_machine(checks: &mut Checks) {
    checks.machine_accepted = true;
}

pub machine Checks::reject(checks: &mut Checks, code: CheckDiagnosticCode, source_span: SourceSpan) {
    transition checks.machine_accepted {
        true -> first(checks, code, source_span)
        _ -> done()
    }

    state first(checks: &mut Checks, code: CheckDiagnosticCode, source_span: SourceSpan) {
        checks.accepted = false;
        checks.machine_accepted = false;
        let index: u64 = checks.diagnostic_count;
        transition index < 64 {
            true -> recorded(checks, code, source_span, index)
            _ -> done()
        }
    }

    state recorded(checks: &mut Checks, code: CheckDiagnosticCode, source_span: SourceSpan, index: u64)
    requires index < 64
    {
        checks.diagnostics[index] = CheckDiagnostic { code: code, source_span: source_span };
        checks.diagnostic_count = index + 1;
    }

    state done() {}
}

// The rejection at `index`, in the order checking found them.
pub machine Checks::diagnostic(checks: &Checks, index: u64 in Trapping) -> CheckDiagnostic
crashes Trap
{
    transition index < checks.diagnostic_count && index < 64 {
        true -> read(checks, index)
        _ -> invalid()
    }

    state read(checks: &Checks, index: u64 in Trapping) -> CheckDiagnostic
    requires index < 64
    {
        checks.diagnostics[index]
    }

    state invalid() -> CheckDiagnostic {
        crash Trap;
    }
}

pub machine Checks::routes(checks: &Checks, machine: u64 in Trapping) -> CrashRoutes
crashes Trap
{
    transition machine < checks.machine_count {
        true -> read(checks, machine)
        _ -> invalid()
    }

    state read(checks: &Checks, machine: u64 in Trapping) -> CrashRoutes {
        checks.routes[machine]
    }

    state invalid() -> CrashRoutes {
        crash Trap;
    }
}

pub machine Checks::set_routes(checks: &mut Checks, machine: u64 in Trapping, routes: CrashRoutes)
crashes Trap
{
    transition machine < checks.machine_count {
        true -> write(checks, machine, routes)
        _ -> invalid()
    }

    state write(checks: &mut Checks, machine: u64 in Trapping, routes: CrashRoutes) {
        checks.routes[machine] = routes;
    }

    state invalid() {
        crash Trap;
    }
}
