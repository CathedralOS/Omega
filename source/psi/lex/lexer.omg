use psi::source::source;
use psi::tokens::tokens;

// Source-to-token spelling phase for the first product-source live slice.
// Chapter 1's LEXICAL-PROFILE-V1 is authoritative: ASCII identifiers,
// space/tab/CR/LF whitespace, byte-preserving cooked literals, and no raw
// strings or codepoint escapes.

pub data Lexer {
    source: SourceUnit;
    output: TokenStream;

    cursor: u64 in Trapping;
    token_start: u64 in Trapping;
    token_end: u64 in Trapping;
    scalar: u32 in Trapping;
    scalar_width: u64 in Trapping;
    decode_valid: bool;
    byte0: u32 in Trapping;
    byte1: u32 in Trapping;
    byte2: u32 in Trapping;
    byte3: u32 in Trapping;
    index1: u64 in Trapping;
    index2: u64 in Trapping;
    index3: u64 in Trapping;

    decoded_start: u64 in Trapping;
    copy_cursor: u64 in Trapping;
    copy_end: u64 in Trapping;
    escape_start: u64 in Trapping;
    digit_value: u32 in Trapping;
    comment_depth: u64 in Trapping;

    numeric_base: NumericBase;
    numeric_empty_digits: bool;
    numeric_has_suffix: bool;
    numeric_is_float: bool;
    numeric_has_exponent: bool;
    numeric_empty_exponent: bool;
    numeric_saw_digit: bool;
    predicate_result: bool;

    span_cursor: u64 in Trapping;
    candidate_cursor: u64 in Trapping;
}

pub machine Lexer::initialize(lexer: &mut Lexer, source_id: u32 in Trapping) {
    SourceUnit::clear(&mut lexer.source, SourceId { value: source_id });
    TokenStream::clear(&mut lexer.output, SourceId { value: source_id });
    lexer.cursor = 0;
}

pub machine Lexer::append_source_byte(lexer: &mut Lexer, byte: u8) {
    SourceUnit::append(&mut lexer.source, byte);
}

pub machine Lexer::reject(
    lexer: &mut Lexer,
    code: LexDiagnosticCode,
    start: u64 in Trapping,
    end: u64 in Trapping
) {
    TokenStream::reject(&mut lexer.output, lexer.source.id, code, start, end);
}

// Decode one Unicode scalar at an exact byte coordinate. The source buffer is
// not assumed valid before this operation; overlong forms, surrogates, and
// values beyond U+10FFFF all fail.
machine Lexer::decode_at(lexer: &mut Lexer, index: u64 in Trapping) {
    lexer.decode_valid = false;
    lexer.scalar = 0;
    lexer.scalar_width = 0;
    transition index < lexer.source.length {
        true -> first(lexer, index)
        _ -> done()
    }

    state first(lexer: &mut Lexer, index: u64 in Trapping) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, index);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 < 128 {
            true -> ascii(lexer)
            _ -> two_lead(lexer, index)
        }
    }

    state ascii(lexer: &mut Lexer) {
        lexer.scalar = lexer.byte0;
        lexer.scalar_width = 1;
        lexer.decode_valid = true;
    }

    state two_lead(lexer: &mut Lexer, index: u64 in Trapping) {
        transition lexer.byte0 >= 194 && lexer.byte0 <= 223 {
            true -> two_bound(lexer, index)
            _ -> three_lead(lexer, index)
        }
    }

    state two_bound(lexer: &mut Lexer, index: u64 in Trapping) {
        lexer.index1 = index + 1;
        transition lexer.index1 < lexer.source.length {
            true -> two_tail(lexer)
            _ -> done()
        }
    }

    state two_tail(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        lexer.byte1 = source_byte as u32 in Trapping;
        transition lexer.byte1 >= 128 && lexer.byte1 <= 191 {
            true -> two_value(lexer)
            _ -> done()
        }
    }

    state two_value(lexer: &mut Lexer) {
        lexer.scalar = (lexer.byte0 - 192) * 64 + (lexer.byte1 - 128);
        lexer.scalar_width = 2;
        lexer.decode_valid = true;
    }

    state three_lead(lexer: &mut Lexer, index: u64 in Trapping) {
        transition lexer.byte0 >= 224 && lexer.byte0 <= 239 {
            true -> three_bound(lexer, index)
            _ -> four_lead(lexer, index)
        }
    }

    state three_bound(lexer: &mut Lexer, index: u64 in Trapping) {
        lexer.index1 = index + 1;
        lexer.index2 = index + 2;
        transition lexer.index2 < lexer.source.length {
            true -> three_bytes(lexer)
            _ -> done()
        }
    }

    state three_bytes(lexer: &mut Lexer) {
        let first_tail: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        let second_tail: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index2);
        lexer.byte1 = first_tail as u32 in Trapping;
        lexer.byte2 = second_tail as u32 in Trapping;
        transition lexer.byte2 >= 128 && lexer.byte2 <= 191 {
            true -> three_second(lexer)
            _ -> done()
        }
    }

    state three_second(lexer: &mut Lexer) {
        transition lexer.byte0 == 224 {
            true -> three_e0(lexer)
            _ -> three_ed_check(lexer)
        }
    }

    state three_e0(lexer: &mut Lexer) {
        transition lexer.byte1 >= 160 && lexer.byte1 <= 191 {
            true -> three_value(lexer)
            _ -> done()
        }
    }

    state three_ed_check(lexer: &mut Lexer) {
        transition lexer.byte0 == 237 {
            true -> three_ed(lexer)
            _ -> three_regular(lexer)
        }
    }

    state three_ed(lexer: &mut Lexer) {
        transition lexer.byte1 >= 128 && lexer.byte1 <= 159 {
            true -> three_value(lexer)
            _ -> done()
        }
    }

    state three_regular(lexer: &mut Lexer) {
        transition lexer.byte1 >= 128 && lexer.byte1 <= 191 {
            true -> three_value(lexer)
            _ -> done()
        }
    }

    state three_value(lexer: &mut Lexer) {
        lexer.scalar = (lexer.byte0 - 224) * 4096
            + (lexer.byte1 - 128) * 64
            + (lexer.byte2 - 128);
        lexer.scalar_width = 3;
        lexer.decode_valid = true;
    }

    state four_lead(lexer: &mut Lexer, index: u64 in Trapping) {
        transition lexer.byte0 >= 240 && lexer.byte0 <= 244 {
            true -> four_bound(lexer, index)
            _ -> done()
        }
    }

    state four_bound(lexer: &mut Lexer, index: u64 in Trapping) {
        lexer.index1 = index + 1;
        lexer.index2 = index + 2;
        lexer.index3 = index + 3;
        transition lexer.index3 < lexer.source.length {
            true -> four_bytes(lexer)
            _ -> done()
        }
    }

    state four_bytes(lexer: &mut Lexer) {
        let first_tail: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        let second_tail: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index2);
        let third_tail: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index3);
        lexer.byte1 = first_tail as u32 in Trapping;
        lexer.byte2 = second_tail as u32 in Trapping;
        lexer.byte3 = third_tail as u32 in Trapping;
        transition lexer.byte2 >= 128 && lexer.byte2 <= 191
            && lexer.byte3 >= 128 && lexer.byte3 <= 191 {
            true -> four_second(lexer)
            _ -> done()
        }
    }

    state four_second(lexer: &mut Lexer) {
        transition lexer.byte0 == 240 {
            true -> four_f0(lexer)
            _ -> four_f4_check(lexer)
        }
    }

    state four_f0(lexer: &mut Lexer) {
        transition lexer.byte1 >= 144 && lexer.byte1 <= 191 {
            true -> four_value(lexer)
            _ -> done()
        }
    }

    state four_f4_check(lexer: &mut Lexer) {
        transition lexer.byte0 == 244 {
            true -> four_f4(lexer)
            _ -> four_regular(lexer)
        }
    }

    state four_f4(lexer: &mut Lexer) {
        transition lexer.byte1 >= 128 && lexer.byte1 <= 143 {
            true -> four_value(lexer)
            _ -> done()
        }
    }

    state four_regular(lexer: &mut Lexer) {
        transition lexer.byte1 >= 128 && lexer.byte1 <= 191 {
            true -> four_value(lexer)
            _ -> done()
        }
    }

    state four_value(lexer: &mut Lexer) {
        lexer.scalar = (lexer.byte0 - 240) * 262144
            + (lexer.byte1 - 128) * 4096
            + (lexer.byte2 - 128) * 64
            + (lexer.byte3 - 128);
        lexer.scalar_width = 4;
        lexer.decode_valid = true;
    }

    state done() {}
}

machine Lexer::is_whitespace(lexer: &mut Lexer, scalar: u32 in Trapping) {
    lexer.predicate_result = false;
    transition scalar {
        9 -> yes(lexer)
        10 -> yes(lexer)
        13 -> yes(lexer)
        32 -> yes(lexer)
        _ -> no(lexer)
    }
    state yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    state no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::is_identifier_start(lexer: &mut Lexer, scalar: u32 in Trapping) {
    lexer.predicate_result = false;
    transition scalar == 95 {
        true -> yes(lexer)
        _ -> upper(lexer, scalar)
    }
    state upper(lexer: &mut Lexer, scalar: u32 in Trapping) { transition scalar >= 65 && scalar <= 90 { true -> yes(lexer) _ -> lower(lexer, scalar) } }
    state lower(lexer: &mut Lexer, scalar: u32 in Trapping) { transition scalar >= 97 && scalar <= 122 { true -> yes(lexer) _ -> no(lexer) } }
    state yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    state no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::is_identifier_continue(lexer: &mut Lexer, scalar: u32 in Trapping) {
    lexer.predicate_result = false;
    transition scalar == 95 {
        true -> yes(lexer)
        _ -> upper(lexer, scalar)
    }
    state upper(lexer: &mut Lexer, scalar: u32 in Trapping) { transition scalar >= 65 && scalar <= 90 { true -> yes(lexer) _ -> lower(lexer, scalar) } }
    state lower(lexer: &mut Lexer, scalar: u32 in Trapping) { transition scalar >= 97 && scalar <= 122 { true -> yes(lexer) _ -> digit(lexer, scalar) } }
    state digit(lexer: &mut Lexer, scalar: u32 in Trapping) { transition scalar >= 48 && scalar <= 57 { true -> yes(lexer) _ -> no(lexer) } }
    state yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    state no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::validate_utf8(lexer: &mut Lexer) {
    lexer.cursor = 0;
    transition { _ -> step(lexer) }

    state step(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode(lexer)
            _ -> complete()
        }
    }

    state decode(lexer: &mut Lexer) {
        Lexer::decode_at(lexer, lexer.cursor);
        transition lexer.decode_valid {
            true -> advance(lexer)
            _ -> invalid(lexer)
        }
    }

    state advance(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + lexer.scalar_width;
        transition { _ -> step(lexer) }
    }

    state invalid(lexer: &mut Lexer) {
        Lexer::reject(lexer, LexDiagnosticCode::InvalidUtf8, lexer.cursor, lexer.cursor + 1);
    }

    state complete() {}
}

machine Lexer::push_token(lexer: &mut Lexer, kind: Token) {
    Lexer::retain_token(lexer, kind);
}

machine Lexer::retain_token(lexer: &mut Lexer, kind: Token) {
    let retained_decoded_start: u64 in Trapping = lexer.decoded_start;
    let retained_decoded_end: u64 in Trapping =
        lexer.output.decoded_length as u64 in Trapping;
    let retained_decoded_length: u64 in Trapping =
        retained_decoded_end - retained_decoded_start;
    let mut token: Token = kind;
    token.source = lexer.source.id.value;
    token.start = lexer.token_start;
    token.end = lexer.token_end;
    token.decoded_start = retained_decoded_start;
    token.decoded_length = retained_decoded_length;
    TokenStream::push(&mut lexer.output, token);
    transition lexer.output.last_retained {
        true -> done()
        _ -> full(lexer)
    }
    state full(lexer: &mut Lexer) {
        Lexer::reject(lexer, LexDiagnosticCode::TokenCapacityExceeded,
            lexer.token_start,
            lexer.token_end
        );
    }
    state done() {}
}

machine Lexer::push_decoded(lexer: &mut Lexer, byte: u8) {
    TokenStream::push_decoded(&mut lexer.output, byte);
    transition lexer.output.last_retained {
        true -> done()
        _ -> full(lexer)
    }
    state full(lexer: &mut Lexer) {
        Lexer::reject(lexer, LexDiagnosticCode::DecodedCapacityExceeded,
            lexer.token_start,
            lexer.cursor
        );
    }
    state done() {}
}

machine Lexer::span_equals(
    lexer: &mut Lexer,
    start: u64 in Trapping,
    end: u64 in Trapping,
    candidate: &[u8]
) {
    lexer.predicate_result = false;
    transition end - start == candidate.len {
        true -> scan(lexer, start, candidate, 0)
        _ -> no(lexer)
    }

    state scan(lexer: &mut Lexer, start: u64 in Trapping, candidate: &[u8], index: u64 in Trapping) {
        transition index < candidate.len {
            true -> address(lexer, start, candidate, index)
            _ -> yes(lexer)
        }
    }

    state address(lexer: &mut Lexer, start: u64 in Trapping, candidate: &[u8], index: u64 in Trapping) {
        lexer.candidate_cursor = start + index;
        transition { _ -> compare(lexer, start, candidate, index) }
    }

    state compare(lexer: &mut Lexer, start: u64 in Trapping, candidate: &[u8], index: u64 in Trapping) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.candidate_cursor);
        let candidate_byte: u8 = candidate[index];
        transition source_byte == candidate_byte {
            true -> scan(lexer, start, candidate, index + 1)
            _ -> no(lexer)
        }
    }

    state yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    state no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::classify_keyword(lexer: &mut Lexer) {
    Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "as"); let matched: bool = lexer.predicate_result;
    transition matched { true -> as_kw(lexer) _ -> calling_convention_kw(lexer) }
    state calling_convention_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "calling_convention"); let matched: bool = lexer.predicate_result; transition matched { true -> calling_convention_yes(lexer) _ -> capability_kw(lexer) } }
    state capability_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "capability"); let matched: bool = lexer.predicate_result; transition matched { true -> capability_yes(lexer) _ -> contains_kw(lexer) } }
    state contains_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "contains"); let matched: bool = lexer.predicate_result; transition matched { true -> contains_yes(lexer) _ -> data_kw(lexer) } }
    state data_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "data"); let matched: bool = lexer.predicate_result; transition matched { true -> data_yes(lexer) _ -> else_kw(lexer) } }
    state else_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "else"); let matched: bool = lexer.predicate_result; transition matched { true -> else_yes(lexer) _ -> false_kw(lexer) } }
    state false_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "false"); let matched: bool = lexer.predicate_result; transition matched { true -> false_yes(lexer) _ -> foreign_kw(lexer) } }
    state foreign_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "foreign"); let matched: bool = lexer.predicate_result; transition matched { true -> foreign_yes(lexer) _ -> host_kw(lexer) } }
    state host_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "host"); let matched: bool = lexer.predicate_result; transition matched { true -> host_yes(lexer) _ -> if_kw(lexer) } }
    state if_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "if"); let matched: bool = lexer.predicate_result; transition matched { true -> if_yes(lexer) _ -> let_kw(lexer) } }
    state let_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "let"); let matched: bool = lexer.predicate_result; transition matched { true -> let_yes(lexer) _ -> library_kw(lexer) } }
    state library_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "library"); let matched: bool = lexer.predicate_result; transition matched { true -> library_yes(lexer) _ -> loop_kw(lexer) } }
    state loop_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "loop"); let matched: bool = lexer.predicate_result; transition matched { true -> loop_yes(lexer) _ -> machine_kw(lexer) } }
    state machine_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "machine"); let matched: bool = lexer.predicate_result; transition matched { true -> machine_yes(lexer) _ -> match_kw(lexer) } }
    state match_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "match"); let matched: bool = lexer.predicate_result; transition matched { true -> match_yes(lexer) _ -> owns_kw(lexer) } }
    state owns_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "owns"); let matched: bool = lexer.predicate_result; transition matched { true -> owns_yes(lexer) _ -> platform_kw(lexer) } }
    state platform_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "platform"); let matched: bool = lexer.predicate_result; transition matched { true -> platform_yes(lexer) _ -> pub_kw(lexer) } }
    state pub_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "pub"); let matched: bool = lexer.predicate_result; transition matched { true -> pub_yes(lexer) _ -> return_kw(lexer) } }
    state return_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "return"); let matched: bool = lexer.predicate_result; transition matched { true -> return_yes(lexer) _ -> self_type_kw(lexer) } }
    state self_type_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "Self"); let matched: bool = lexer.predicate_result; transition matched { true -> self_type_yes(lexer) _ -> self_value_kw(lexer) } }
    state self_value_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "lexer"); let matched: bool = lexer.predicate_result; transition matched { true -> self_value_yes(lexer) _ -> state_kw(lexer) } }
    state state_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "state"); let matched: bool = lexer.predicate_result; transition matched { true -> state_yes(lexer) _ -> struct_kw(lexer) } }
    state struct_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "struct"); let matched: bool = lexer.predicate_result; transition matched { true -> struct_yes(lexer) _ -> target_kw(lexer) } }
    state target_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "target"); let matched: bool = lexer.predicate_result; transition matched { true -> target_yes(lexer) _ -> transition_kw(lexer) } }
    state transition_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "transition"); let matched: bool = lexer.predicate_result; transition matched { true -> transition_yes(lexer) _ -> true_kw(lexer) } }
    state true_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "true"); let matched: bool = lexer.predicate_result; transition matched { true -> true_yes(lexer) _ -> use_kw(lexer) } }
    state use_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "use"); let matched: bool = lexer.predicate_result; transition matched { true -> use_yes(lexer) _ -> when_kw(lexer) } }
    state when_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "when"); let matched: bool = lexer.predicate_result; transition matched { true -> when_yes(lexer) _ -> while_kw(lexer) } }
    state while_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "while"); let matched: bool = lexer.predicate_result; transition matched { true -> while_yes(lexer) _ -> case_kw(lexer) } }
    state case_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "case"); let matched: bool = lexer.predicate_result; transition matched { true -> case_yes(lexer) _ -> copy_kw(lexer) } }
    state copy_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "copy"); let matched: bool = lexer.predicate_result; transition matched { true -> copy_yes(lexer) _ -> linear_kw(lexer) } }
    state linear_kw(lexer: &mut Lexer) { Lexer::span_equals(lexer, lexer.token_start, lexer.token_end, "linear"); let matched: bool = lexer.predicate_result; transition matched { true -> linear_yes(lexer) _ -> identifier(lexer) } }

    state as_kw(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::As }); }
    state calling_convention_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::CallingConvention }); }
    state capability_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Capability }); }
    state contains_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Contains }); }
    state data_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Data }); }
    state else_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Else }); }
    state false_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::False }); }
    state foreign_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Foreign }); }
    state host_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Host }); }
    state if_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::If }); }
    state let_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Let }); }
    state library_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Library }); }
    state loop_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Loop }); }
    state machine_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Machine }); }
    state match_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Match }); }
    state owns_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Owns }); }
    state platform_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Platform }); }
    state pub_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Pub }); }
    state return_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Return }); }
    state self_type_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::SelfType }); }
    state self_value_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::SelfValue }); }
    state state_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::State }); }
    state struct_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Struct }); }
    state target_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Target }); }
    state transition_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Transition }); }
    state true_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::True }); }
    state use_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Use }); }
    state when_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::When }); }
    state while_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::While }); }
    state case_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Case }); }
    state copy_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Copy }); }
    state linear_yes(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Keyword { keyword: KeywordKind::Linear }); }
    state identifier(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Identifier); }
}

machine Lexer::lex_identifier(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    Lexer::decode_at(lexer, lexer.cursor);
    lexer.cursor = lexer.cursor + lexer.scalar_width;
    transition { _ -> continue_scan(lexer) }

    state continue_scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode_next(lexer)
            _ -> finish(lexer)
        }
    }

    state decode_next(lexer: &mut Lexer) {
        Lexer::decode_at(lexer, lexer.cursor);
        Lexer::is_identifier_continue(lexer, lexer.scalar); let continues: bool = lexer.predicate_result;
        transition continues {
            true -> advance(lexer)
            _ -> finish(lexer)
        }
    }

    state advance(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + lexer.scalar_width;
        transition { _ -> continue_scan(lexer) }
    }

    state finish(lexer: &mut Lexer) {
        lexer.token_end = lexer.cursor;
        Lexer::classify_keyword(lexer);
    }
}

machine Lexer::lex_whitespace(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    transition { _ -> scan(lexer) }

    state scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode(lexer)
            _ -> finish(lexer)
        }
    }

    state decode(lexer: &mut Lexer) {
        Lexer::decode_at(lexer, lexer.cursor);
        Lexer::is_whitespace(lexer, lexer.scalar); let whitespace: bool = lexer.predicate_result;
        transition whitespace {
            true -> advance(lexer)
            _ -> finish(lexer)
        }
    }

    state advance(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + lexer.scalar_width;
        transition { _ -> scan(lexer) }
    }

    state finish(lexer: &mut Lexer) {
        lexer.token_end = lexer.cursor;
        Lexer::push_token(lexer, Token::Whitespace);
    }
}

machine Lexer::lex_line_comment(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    lexer.cursor = lexer.cursor + 2;
    transition { _ -> scan(lexer) }

    state scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> byte(lexer)
            _ -> finish(lexer)
        }
    }

    state byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        transition source_byte == 10 {
            true -> consume_newline(lexer)
            _ -> advance(lexer)
        }
    }

    state advance(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + 1;
        transition { _ -> scan(lexer) }
    }

    state consume_newline(lexer: &mut Lexer) {
        lexer.token_end = lexer.cursor;
        lexer.cursor = lexer.cursor + 1;
        Lexer::push_token(lexer, Token::LineComment);
    }

    state finish(lexer: &mut Lexer) {
        lexer.token_end = lexer.cursor;
        Lexer::push_token(lexer, Token::LineComment);
    }
}

machine Lexer::lex_block_comment(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    lexer.cursor = lexer.cursor + 2;
    lexer.comment_depth = 1;
    transition { _ -> scan(lexer) }

    state scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> pair_bound(lexer)
            _ -> unterminated(lexer)
        }
    }

    state pair_bound(lexer: &mut Lexer) {
        lexer.index1 = lexer.cursor + 1;
        transition lexer.index1 < lexer.source.length {
            true -> open_check(lexer)
            _ -> advance(lexer)
        }
    }

    state open_check(lexer: &mut Lexer) {
        let first_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        let second_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        transition first_byte == 47 && second_byte == 42 {
            true -> open(lexer)
            _ -> close_check(lexer)
        }
    }

    state open(lexer: &mut Lexer) {
        lexer.comment_depth = lexer.comment_depth + 1;
        lexer.cursor = lexer.cursor + 2;
        transition { _ -> scan(lexer) }
    }

    state close_check(lexer: &mut Lexer) {
        let first_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        let second_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        transition first_byte == 42 && second_byte == 47 {
            true -> close(lexer)
            _ -> advance(lexer)
        }
    }

    state close(lexer: &mut Lexer) {
        lexer.comment_depth = lexer.comment_depth - 1;
        lexer.cursor = lexer.cursor + 2;
        transition lexer.comment_depth == 0 {
            true -> finish(lexer)
            _ -> scan(lexer)
        }
    }

    state advance(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + 1;
        transition { _ -> scan(lexer) }
    }

    state finish(lexer: &mut Lexer) {
        lexer.token_end = lexer.cursor;
        Lexer::push_token(lexer, Token::BlockComment);
    }

    state unterminated(lexer: &mut Lexer) {
        Lexer::reject(lexer, LexDiagnosticCode::UnterminatedBlockComment,
            lexer.token_start,
            lexer.source.length as u64 in Trapping
        );
    }
}

machine Lexer::hex_digit_value(lexer: &mut Lexer, byte: u32 in Trapping) {
    lexer.digit_value = 4294967295;
    transition byte >= 48 && byte <= 57 {
        true -> decimal(lexer, byte)
        _ -> lower(lexer, byte)
    }
    state decimal(lexer: &mut Lexer, byte: u32 in Trapping) { lexer.digit_value = byte - 48; }
    state lower(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 97 && byte <= 102 { true -> lower_yes(lexer, byte) _ -> upper(lexer, byte) } }
    state lower_yes(lexer: &mut Lexer, byte: u32 in Trapping) { lexer.digit_value = byte - 87; }
    state upper(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 65 && byte <= 70 { true -> upper_yes(lexer, byte) _ -> done() } }
    state upper_yes(lexer: &mut Lexer, byte: u32 in Trapping) { lexer.digit_value = byte - 55; }
    state done() {}
}

machine Lexer::copy_source_to_decoded(lexer: &mut Lexer) {
    transition { _ -> scan(lexer) }

    state scan(lexer: &mut Lexer) {
        transition lexer.copy_cursor < lexer.copy_end {
        true -> copy(lexer)
        _ -> done()
        }
    }
    state copy(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.copy_cursor);
        Lexer::push_decoded(lexer, source_byte);
        lexer.copy_cursor = lexer.copy_cursor + 1;
        transition lexer.output.accepted { true -> scan(lexer) _ -> done() }
    }
    state done() {}
}

machine Lexer::lex_cooked_string(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    lexer.cursor = lexer.cursor + 1;
    transition { _ -> scan(lexer) }

    state scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode(lexer)
            _ -> unterminated(lexer)
        }
    }

    state decode(lexer: &mut Lexer) {
        Lexer::decode_at(lexer, lexer.cursor);
        transition lexer.scalar == 34 {
            true -> finish(lexer)
            _ -> newline_check(lexer)
        }
    }

    state newline_check(lexer: &mut Lexer) {
        transition lexer.scalar == 10 || lexer.scalar == 13 {
            true -> outside_profile_line(lexer)
            _ -> slash(lexer)
        }
    }

    state slash(lexer: &mut Lexer) {
        transition lexer.scalar == 92 {
            true -> escape_begin(lexer)
            _ -> copy_scalar(lexer)
        }
    }

    state copy_scalar(lexer: &mut Lexer) {
        lexer.copy_cursor = lexer.cursor;
        lexer.copy_end = lexer.cursor + lexer.scalar_width;
        Lexer::copy_source_to_decoded(lexer);
        lexer.cursor = lexer.copy_end;
        transition lexer.output.accepted { true -> scan(lexer) _ -> done() }
    }

    state escape_begin(lexer: &mut Lexer) {
        lexer.escape_start = lexer.cursor;
        lexer.cursor = lexer.cursor + 1;
        transition lexer.cursor < lexer.source.length {
            true -> escape_byte(lexer)
            _ -> unterminated_escape(lexer)
        }
    }

    state escape_byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 {
            34 -> escaped_quote(lexer)
            92 -> escaped_slash(lexer)
            110 -> escaped_n(lexer)
            114 -> escaped_r(lexer)
            116 -> escaped_t(lexer)
            48 -> escaped_zero(lexer)
            120 -> hex_begin(lexer)
            117 -> outside_profile_escape(lexer)
            _ -> unsupported_escape(lexer)
        }
    }

    state escaped_quote(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 34); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }
    state escaped_slash(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 92); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }
    state escaped_n(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 10); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }
    state escaped_r(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 13); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }
    state escaped_t(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 9); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }
    state escaped_zero(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 0); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }

    state hex_begin(lexer: &mut Lexer) {
        lexer.index1 = lexer.cursor + 1;
        lexer.index2 = lexer.cursor + 2;
        transition lexer.index2 < lexer.source.length {
            true -> hex_first(lexer)
            _ -> hex_unterminated(lexer)
        }
    }

    state hex_first(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        Lexer::hex_digit_value(lexer, source_byte as u32 in Trapping);
        lexer.byte1 = lexer.digit_value;
        transition lexer.byte1 < 16 {
            true -> hex_second(lexer)
            _ -> hex_invalid_first(lexer)
        }
    }

    state hex_second(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index2);
        Lexer::hex_digit_value(lexer, source_byte as u32 in Trapping);
        lexer.byte2 = lexer.digit_value;
        transition lexer.byte2 < 16 {
            true -> hex_emit(lexer)
            _ -> hex_invalid_second(lexer)
        }
    }

    state hex_emit(lexer: &mut Lexer) {
        Lexer::push_decoded(lexer, (lexer.byte1 * 16 + lexer.byte2) as u8);
        lexer.cursor = lexer.cursor + 3;
        transition lexer.output.accepted { true -> scan(lexer) _ -> done() }
    }

    state finish(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + 1;
        lexer.token_end = lexer.cursor;
        Lexer::push_token(lexer, Token::StringLiteral);
    }

    state unterminated(lexer: &mut Lexer) { Lexer::reject(lexer, LexDiagnosticCode::UnterminatedStringLiteral, lexer.token_start, lexer.source.length as u64 in Trapping); }
    state unterminated_escape(lexer: &mut Lexer) { Lexer::reject(lexer, LexDiagnosticCode::UnterminatedStringEscape, lexer.token_start, lexer.source.length as u64 in Trapping); }
    state unsupported_escape(lexer: &mut Lexer) { Lexer::reject(lexer, LexDiagnosticCode::UnsupportedEscape, lexer.escape_start, lexer.cursor + 1); }
    state hex_unterminated(lexer: &mut Lexer) { Lexer::reject(lexer, LexDiagnosticCode::UnterminatedHexEscape, lexer.escape_start, lexer.source.length as u64 in Trapping); }
    state hex_invalid_first(lexer: &mut Lexer) { Lexer::reject(lexer, LexDiagnosticCode::InvalidHexEscapeDigit, lexer.cursor + 1, lexer.cursor + 2); }
    state hex_invalid_second(lexer: &mut Lexer) { Lexer::reject(lexer, LexDiagnosticCode::InvalidHexEscapeDigit, lexer.cursor + 2, lexer.cursor + 3); }
    state outside_profile_escape(lexer: &mut Lexer) {
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile,
            lexer.escape_start,
            lexer.cursor + 1
        );
    }
    state outside_profile_line(lexer: &mut Lexer) {
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile,
            lexer.cursor,
            lexer.cursor + 1
        );
    }
    state done() {}
}

machine Lexer::digit_in_base(lexer: &mut Lexer, byte: u32 in Trapping, base: NumericBase) {
    lexer.predicate_result = false;
    transition base {
        NumericBase::Binary -> binary(lexer, byte)
        NumericBase::Octal -> octal(lexer, byte)
        NumericBase::Decimal -> decimal(lexer, byte)
        NumericBase::Hexadecimal -> hex(lexer, byte)
    }
    state binary(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 48 && byte <= 49 { true -> yes(lexer) _ -> no(lexer) } }
    state octal(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 48 && byte <= 55 { true -> yes(lexer) _ -> no(lexer) } }
    state decimal(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 48 && byte <= 57 { true -> yes(lexer) _ -> no(lexer) } }
    state hex(lexer: &mut Lexer, byte: u32 in Trapping) {
        transition byte >= 48 && byte <= 57 {
            true -> yes(lexer)
            _ -> hex_alpha(lexer, byte)
        }
    }
    state hex_alpha(lexer: &mut Lexer, byte: u32 in Trapping) {
        transition byte >= 65 && byte <= 70 {
            true -> yes(lexer)
            _ -> hex_lower(lexer, byte)
        }
    }
    state hex_lower(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 97 && byte <= 102 { true -> yes(lexer) _ -> no(lexer) } }
    state yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    state no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::consume_digits(lexer: &mut Lexer) {
    lexer.numeric_saw_digit = false;
    transition { _ -> scan(lexer) }
    state scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> byte(lexer)
            _ -> done()
        }
    }
    state byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 == 95 {
            true -> underscore(lexer)
            _ -> digit(lexer)
        }
    }
    state underscore(lexer: &mut Lexer) { lexer.cursor = lexer.cursor + 1; transition { _ -> scan(lexer) } }
    state digit(lexer: &mut Lexer) {
        Lexer::digit_in_base(lexer, lexer.byte0, lexer.numeric_base); let digit: bool = lexer.predicate_result;
        transition digit {
            true -> consume(lexer)
            _ -> done()
        }
    }
    state consume(lexer: &mut Lexer) { lexer.numeric_saw_digit = true; lexer.cursor = lexer.cursor + 1; transition { _ -> scan(lexer) } }
    state done() {}
}

machine Lexer::consume_suffix(lexer: &mut Lexer) {
    lexer.numeric_has_suffix = false;
    transition lexer.cursor < lexer.source.length {
        true -> decode_first(lexer)
        _ -> done()
    }
    state decode_first(lexer: &mut Lexer) {
        Lexer::decode_at(lexer, lexer.cursor);
        Lexer::is_identifier_start(lexer, lexer.scalar); let starts: bool = lexer.predicate_result;
        transition starts {
            true -> consume(lexer)
            _ -> done()
        }
    }
    state consume(lexer: &mut Lexer) {
        lexer.numeric_has_suffix = true;
        lexer.cursor = lexer.cursor + lexer.scalar_width;
        transition lexer.cursor < lexer.source.length { true -> decode_next(lexer) _ -> done() }
    }
    state decode_next(lexer: &mut Lexer) {
        Lexer::decode_at(lexer, lexer.cursor);
        Lexer::is_identifier_continue(lexer, lexer.scalar); let continues: bool = lexer.predicate_result;
        transition continues { true -> consume(lexer) _ -> done() }
    }
    state done() {}
}

machine Lexer::dot_starts_float(lexer: &mut Lexer) {
    lexer.predicate_result = false;
    transition lexer.cursor + 1 < lexer.source.length {
        true -> decode_after(lexer)
        _ -> yes(lexer)
    }
    state decode_after(lexer: &mut Lexer) {
        Lexer::decode_at(lexer, lexer.cursor + 1);
        transition lexer.scalar >= 48 && lexer.scalar <= 57 {
            true -> yes(lexer)
            _ -> dotdot(lexer)
        }
    }
    state dotdot(lexer: &mut Lexer) {
        transition lexer.scalar == 46 {
            true -> no(lexer)
            _ -> identifier(lexer)
        }
    }
    state identifier(lexer: &mut Lexer) {
        Lexer::is_identifier_start(lexer, lexer.scalar);
        transition lexer.predicate_result { true -> no(lexer) _ -> yes(lexer) }
    }
    state yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    state no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::lex_number(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    lexer.numeric_base = NumericBase::Decimal;
    lexer.numeric_empty_digits = false;
    lexer.numeric_has_suffix = false;
    lexer.numeric_is_float = false;
    lexer.numeric_has_exponent = false;
    lexer.numeric_empty_exponent = false;
    let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
    transition source_byte == 46 {
        true -> leading_dot(lexer)
        _ -> integer_begin(lexer)
    }

    state leading_dot(lexer: &mut Lexer) {
        lexer.numeric_is_float = true;
        lexer.cursor = lexer.cursor + 1;
        Lexer::consume_digits(lexer);
        transition { _ -> exponent_check(lexer) }
    }

    state integer_begin(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte0 = source_byte as u32 in Trapping;
        lexer.cursor = lexer.cursor + 1;
        transition lexer.byte0 == 48 {
            true -> prefix_bound(lexer)
            _ -> decimal_digits(lexer)
        }
    }

    state prefix_bound(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> prefix(lexer)
            _ -> dot_check(lexer)
        }
    }

    state prefix(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte1 = source_byte as u32 in Trapping;
        transition lexer.byte1 == 98 || lexer.byte1 == 66 {
            true -> binary_prefix(lexer)
            _ -> octal_check(lexer)
        }
    }
    state binary_prefix(lexer: &mut Lexer) { lexer.numeric_base = NumericBase::Binary; lexer.cursor = lexer.cursor + 1; transition { _ -> based_digits(lexer) } }
    state octal_check(lexer: &mut Lexer) { transition lexer.byte1 == 111 || lexer.byte1 == 79 { true -> octal_prefix(lexer) _ -> hex_check(lexer) } }
    state octal_prefix(lexer: &mut Lexer) { lexer.numeric_base = NumericBase::Octal; lexer.cursor = lexer.cursor + 1; transition { _ -> based_digits(lexer) } }
    state hex_check(lexer: &mut Lexer) { transition lexer.byte1 == 120 || lexer.byte1 == 88 { true -> hex_prefix(lexer) _ -> decimal_digits(lexer) } }
    state hex_prefix(lexer: &mut Lexer) { lexer.numeric_base = NumericBase::Hexadecimal; lexer.cursor = lexer.cursor + 1; transition { _ -> based_digits(lexer) } }
    state based_digits(lexer: &mut Lexer) {
        Lexer::consume_digits(lexer);
        lexer.numeric_empty_digits = !lexer.numeric_saw_digit;
        transition { _ -> suffix(lexer) }
    }
    state decimal_digits(lexer: &mut Lexer) { Lexer::consume_digits(lexer); transition { _ -> dot_check(lexer) } }

    state dot_check(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> dot_byte(lexer)
            _ -> exponent_check(lexer)
        }
    }
    state dot_byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        transition source_byte == 46 {
            true -> dot_decision(lexer)
            _ -> exponent_check(lexer)
        }
    }
    state dot_decision(lexer: &mut Lexer) {
        Lexer::dot_starts_float(lexer); let starts: bool = lexer.predicate_result;
        transition starts {
            true -> dot_consume(lexer)
            _ -> exponent_check(lexer)
        }
    }
    state dot_consume(lexer: &mut Lexer) {
        lexer.numeric_is_float = true;
        lexer.cursor = lexer.cursor + 1;
        Lexer::consume_digits(lexer);
        transition { _ -> exponent_check(lexer) }
    }

    state exponent_check(lexer: &mut Lexer) {
        transition lexer.numeric_base == NumericBase::Decimal
            && lexer.cursor < lexer.source.length {
            true -> exponent_byte(lexer)
            _ -> suffix(lexer)
        }
    }
    state exponent_byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 == 101 || lexer.byte0 == 69 {
            true -> exponent_begin(lexer)
            _ -> suffix(lexer)
        }
    }
    state exponent_begin(lexer: &mut Lexer) {
        lexer.numeric_is_float = true;
        lexer.numeric_has_exponent = true;
        lexer.cursor = lexer.cursor + 1;
        transition lexer.cursor < lexer.source.length { true -> exponent_sign(lexer) _ -> exponent_digits(lexer) }
    }
    state exponent_sign(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 == 43 || lexer.byte0 == 45 { true -> exponent_sign_consume(lexer) _ -> exponent_digits(lexer) }
    }
    state exponent_sign_consume(lexer: &mut Lexer) { lexer.cursor = lexer.cursor + 1; transition { _ -> exponent_digits(lexer) } }
    state exponent_digits(lexer: &mut Lexer) {
        lexer.numeric_base = NumericBase::Decimal;
        Lexer::consume_digits(lexer);
        lexer.numeric_empty_exponent = !lexer.numeric_saw_digit;
        transition { _ -> suffix(lexer) }
    }

    state suffix(lexer: &mut Lexer) {
        Lexer::consume_suffix(lexer);
        transition { _ -> finish(lexer) }
    }
    state finish(lexer: &mut Lexer) {
        lexer.token_end = lexer.cursor;
        transition lexer.numeric_is_float { true -> emit_float(lexer) _ -> emit_integer(lexer) }
    }
    state emit_float(lexer: &mut Lexer) {
        Lexer::push_token(lexer, Token::Float {
            has_exponent: lexer.numeric_has_exponent,
            empty_exponent: lexer.numeric_empty_exponent,
            has_suffix: lexer.numeric_has_suffix
        });
    }
    state emit_integer(lexer: &mut Lexer) {
        Lexer::push_token(lexer, Token::Integer {
            base: lexer.numeric_base,
            empty_digits: lexer.numeric_empty_digits,
            has_suffix: lexer.numeric_has_suffix
        });
    }
}

machine Lexer::lex_punctuation(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    let first_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
    lexer.byte0 = first_byte as u32 in Trapping;
    lexer.byte1 = 4294967295;
    lexer.byte2 = 4294967295;
    lexer.index1 = lexer.cursor + 1;
    lexer.index2 = lexer.cursor + 2;
    transition lexer.index1 < lexer.source.length { true -> second(lexer) _ -> classify(lexer) }
    state second(lexer: &mut Lexer) { let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1); lexer.byte1 = source_byte as u32 in Trapping; transition lexer.index2 < lexer.source.length { true -> third(lexer) _ -> classify(lexer) } }
    state third(lexer: &mut Lexer) { let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index2); lexer.byte2 = source_byte as u32 in Trapping; transition { _ -> classify(lexer) } }

    state classify(lexer: &mut Lexer) {
        transition lexer.byte0 {
            38 -> ampersand(lexer)
            39 -> single_apostrophe(lexer)
            42 -> asterisk(lexer)
            94 -> single_caret(lexer)
            58 -> colon(lexer)
            44 -> single_comma(lexer)
            46 -> dot(lexer)
            61 -> equal(lexer)
            33 -> exclamation(lexer)
            62 -> greater(lexer)
            35 -> single_hash(lexer)
            123 -> single_left_brace(lexer)
            91 -> single_left_bracket(lexer)
            40 -> single_left_paren(lexer)
            60 -> less(lexer)
            45 -> minus(lexer)
            37 -> percent(lexer)
            124 -> pipe(lexer)
            43 -> plus(lexer)
            125 -> single_right_brace(lexer)
            93 -> single_right_bracket(lexer)
            41 -> single_right_paren(lexer)
            59 -> single_semicolon(lexer)
            47 -> slash(lexer)
            126 -> single_tilde(lexer)
            _ -> unsupported(lexer)
        }
    }

    state ampersand(lexer: &mut Lexer) { transition lexer.byte1 == 38 { true -> and_and(lexer) _ -> single_ampersand(lexer) } }
    state colon(lexer: &mut Lexer) { transition lexer.byte1 == 58 { true -> colon_colon(lexer) _ -> single_colon(lexer) } }
    state dot(lexer: &mut Lexer) { transition lexer.byte1 == 46 { true -> dotdot(lexer) _ -> single_dot(lexer) } }
    state dotdot(lexer: &mut Lexer) { transition lexer.byte2 == 61 { true -> dotdot_equal(lexer) _ -> dotdot_plain(lexer) } }
    state equal(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> equal_equal(lexer) _ -> single_equal(lexer) } }
    state exclamation(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> exclamation_equal(lexer) _ -> single_exclamation(lexer) } }
    state greater(lexer: &mut Lexer) { transition lexer.byte1 == 62 { true -> greater_greater(lexer) _ -> greater_equal_check(lexer) } }
    state greater_equal_check(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> greater_equal(lexer) _ -> single_greater(lexer) } }
    state less(lexer: &mut Lexer) { transition lexer.byte1 == 60 { true -> less_less(lexer) _ -> less_equal_check(lexer) } }
    state less_equal_check(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> less_equal(lexer) _ -> single_less(lexer) } }
    state minus(lexer: &mut Lexer) { transition lexer.byte1 == 62 { true -> arrow(lexer) _ -> minus_equal_check(lexer) } }
    state minus_equal_check(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> minus_equal(lexer) _ -> single_minus(lexer) } }
    state percent(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> percent_equal(lexer) _ -> single_percent(lexer) } }
    state pipe(lexer: &mut Lexer) { transition lexer.byte1 == 124 { true -> pipe_pipe(lexer) _ -> single_pipe(lexer) } }
    state plus(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> plus_equal(lexer) _ -> single_plus(lexer) } }
    state asterisk(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> asterisk_equal(lexer) _ -> single_asterisk(lexer) } }
    state slash(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> slash_equal(lexer) _ -> single_slash(lexer) } }

    state single_ampersand(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Ampersand, 1); }
    state and_and(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::AndAnd, 2); }
    state single_apostrophe(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Apostrophe, 1); }
    state arrow(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Arrow, 2); }
    state single_asterisk(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Asterisk, 1); }
    state single_caret(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Caret, 1); }
    state single_colon(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Colon, 1); }
    state colon_colon(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::ColonColon, 2); }
    state single_comma(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Comma, 1); }
    state single_dot(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Dot, 1); }
    state dotdot_plain(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::DotDot, 2); }
    state dotdot_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::DotDotEqual, 3); }
    state single_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Equal, 1); }
    state equal_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::EqualEqual, 2); }
    state single_exclamation(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Exclamation, 1); }
    state exclamation_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::ExclamationEqual, 2); }
    state single_greater(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Greater, 1); }
    state greater_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::GreaterEqual, 2); }
    state greater_greater(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::GreaterGreater, 2); }
    state single_hash(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Hash, 1); }
    state single_left_brace(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::LeftBrace, 1); }
    state single_left_bracket(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::LeftBracket, 1); }
    state single_left_paren(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::LeftParen, 1); }
    state single_less(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Less, 1); }
    state less_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::LessEqual, 2); }
    state less_less(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::LessLess, 2); }
    state single_minus(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Minus, 1); }
    state minus_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::MinusEqual, 2); }
    state single_percent(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Percent, 1); }
    state percent_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::PercentEqual, 2); }
    state single_pipe(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Pipe, 1); }
    state pipe_pipe(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::PipePipe, 2); }
    state single_plus(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Plus, 1); }
    state plus_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::PlusEqual, 2); }
    state asterisk_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::AsteriskEqual, 2); }
    state slash_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::SlashEqual, 2); }
    state single_right_brace(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::RightBrace, 1); }
    state single_right_bracket(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::RightBracket, 1); }
    state single_right_paren(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::RightParen, 1); }
    state single_semicolon(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Semicolon, 1); }
    state single_slash(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Slash, 1); }
    state single_tilde(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Tilde, 1); }
    state unsupported(lexer: &mut Lexer) {
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile,
            lexer.token_start,
            lexer.token_start + lexer.scalar_width
        );
    }
}

machine Lexer::emit_punctuation(lexer: &mut Lexer, kind: PunctuationKind, length: u64 in Trapping) {
    lexer.cursor = lexer.cursor + length;
    lexer.token_end = lexer.cursor;
    Lexer::push_token(lexer, Token::Punctuation { punctuation: kind });
}

machine Lexer::reject_raw_string_candidate(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.cursor = lexer.cursor + 1;
    transition { _ -> scan(lexer) }

    state scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> byte(lexer)
            _ -> reject_prefix(lexer)
        }
    }

    state byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        transition source_byte == 35 {
            true -> hash(lexer)
            _ -> quote(lexer)
        }
    }

    state hash(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + 1;
        transition { _ -> scan(lexer) }
    }

    state quote(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        transition source_byte == 34 {
            true -> reject_quote(lexer)
            _ -> reject_prefix(lexer)
        }
    }

    state reject_quote(lexer: &mut Lexer) {
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile,
            lexer.token_start,
            lexer.cursor + 1
        );
    }

    state reject_prefix(lexer: &mut Lexer) {
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile,
            lexer.token_start,
            lexer.cursor
        );
    }
}

machine Lexer::is_raw_string_candidate(lexer: &mut Lexer) {
    lexer.predicate_result = false;
    lexer.candidate_cursor = lexer.cursor + 1;
    transition { _ -> scan(lexer) }

    state scan(lexer: &mut Lexer) {
        transition lexer.candidate_cursor < lexer.source.length {
            true -> byte(lexer)
            _ -> no(lexer)
        }
    }

    state byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.candidate_cursor);
        transition source_byte == 35 {
            true -> hash(lexer)
            _ -> quote(lexer)
        }
    }

    state hash(lexer: &mut Lexer) {
        lexer.candidate_cursor = lexer.candidate_cursor + 1;
        transition { _ -> scan(lexer) }
    }

    state quote(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.candidate_cursor);
        transition source_byte == 34 {
            true -> yes(lexer)
            _ -> no(lexer)
        }
    }

    state yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    state no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::lex_next(lexer: &mut Lexer) {
    Lexer::decode_at(lexer, lexer.cursor);
    transition lexer.scalar >= 128 {
        true -> outside_profile_syntax(lexer)
        _ -> whitespace_check(lexer)
    }
    state outside_profile_syntax(lexer: &mut Lexer) {
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile,
            lexer.cursor,
            lexer.cursor + lexer.scalar_width
        );
    }
    state whitespace_check(lexer: &mut Lexer) {
        Lexer::is_whitespace(lexer, lexer.scalar); let whitespace: bool = lexer.predicate_result;
        transition whitespace {
            true -> whitespace(lexer)
            _ -> line_comment_bound(lexer)
        }
    }
    state whitespace(lexer: &mut Lexer) { Lexer::lex_whitespace(lexer); }
    state line_comment_bound(lexer: &mut Lexer) { lexer.index1 = lexer.cursor + 1; transition lexer.scalar == 47 && lexer.index1 < lexer.source.length { true -> comment_second(lexer) _ -> raw_check(lexer) } }
    state comment_second(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 == 47 { true -> line_comment(lexer) _ -> block_comment_check(lexer) }
    }
    state line_comment(lexer: &mut Lexer) { Lexer::lex_line_comment(lexer); }
    state block_comment_check(lexer: &mut Lexer) { transition lexer.byte0 == 42 { true -> block_comment(lexer) _ -> raw_check(lexer) } }
    state block_comment(lexer: &mut Lexer) { Lexer::lex_block_comment(lexer); }
    state raw_check(lexer: &mut Lexer) {
        transition lexer.scalar == 114 {
            true -> raw_candidate(lexer)
            _ -> identifier_check(lexer)
        }
    }
    state raw_candidate(lexer: &mut Lexer) {
        Lexer::is_raw_string_candidate(lexer); let candidate: bool = lexer.predicate_result;
        transition candidate {
            true -> raw(lexer)
            _ -> identifier_check(lexer)
        }
    }
    state raw(lexer: &mut Lexer) { Lexer::reject_raw_string_candidate(lexer); }
    state identifier_check(lexer: &mut Lexer) { Lexer::is_identifier_start(lexer, lexer.scalar); let starts: bool = lexer.predicate_result; transition starts { true -> identifier(lexer) _ -> number_check(lexer) } }
    state identifier(lexer: &mut Lexer) { Lexer::lex_identifier(lexer); }
    state number_check(lexer: &mut Lexer) { transition lexer.scalar >= 48 && lexer.scalar <= 57 { true -> number(lexer) _ -> leading_dot_check(lexer) } }
    state leading_dot_check(lexer: &mut Lexer) { lexer.index1 = lexer.cursor + 1; transition lexer.scalar == 46 && lexer.index1 < lexer.source.length { true -> leading_dot_second(lexer) _ -> string_check(lexer) } }
    state leading_dot_second(lexer: &mut Lexer) { let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1); lexer.byte0 = source_byte as u32 in Trapping; transition lexer.byte0 >= 48 && lexer.byte0 <= 57 { true -> number(lexer) _ -> string_check(lexer) } }
    state number(lexer: &mut Lexer) { Lexer::lex_number(lexer); }
    state string_check(lexer: &mut Lexer) { transition lexer.scalar == 34 { true -> string(lexer) _ -> punctuation(lexer) } }
    state string(lexer: &mut Lexer) { Lexer::lex_cooked_string(lexer); }
    state punctuation(lexer: &mut Lexer) { Lexer::lex_punctuation(lexer); }
}

// Bounded array reads carry their collection's Trapping policy, so tokenizing
// publishes the same crash route its callees do.
pub machine Lexer::tokenize(lexer: &mut Lexer)
crashes Trap
{
    TokenStream::clear(&mut lexer.output, lexer.source.id);
    Lexer::validate_utf8(&mut lexer);
    transition lexer.output.accepted {
        true -> begin(lexer)
        _ -> done()
    }
    state begin(lexer: &mut Lexer) { lexer.cursor = 0; transition { _ -> scan(lexer) } }
    state scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> token(lexer)
            _ -> done()
        }
    }
    state token(lexer: &mut Lexer) {
        Lexer::lex_next(&mut lexer);
        transition lexer.output.accepted { true -> scan(lexer) _ -> done() }
    }
    state done() {}
}
