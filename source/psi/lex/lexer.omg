use psi::source::source;
use psi::tokens::tokens;

// Source-to-token spelling phase for the first product-source live slice.
// Chapter 1's LEXICAL-PROFILE-V1 is authoritative: ASCII identifiers,
// space/tab/CR/LF whitespace, byte-preserving cooked literals, and no raw
// strings or codepoint escapes. Whitespace and comments separate tokens and
// are checked (an unterminated block comment rejects) but are not stored:
// no consumer reads them, and the stream holds only what the parser reads.

public data Lexer {
    source: SourceUnit;
    output: TokenStream;

    cursor: u64 in Trapping;
    token_start: u64 in Trapping;
    token_end: u64 in Trapping;
    scalar: u32 in Trapping;
    scalar_width: u64 in Trapping;
    decode_valid: bool;
    byte0: u32 in Trapping;
    byte1: u32 in Trapping;
    byte2: u32 in Trapping;
    byte3: u32 in Trapping;
    index1: u64 in Trapping;
    index2: u64 in Trapping;
    index3: u64 in Trapping;

    decoded_start: u64 in Trapping;
    copy_cursor: u64 in Trapping;
    copy_end: u64 in Trapping;
    escape_start: u64 in Trapping;
    digit_value: u32 in Trapping;
    comment_depth: u64 in Trapping;

    numeric_base: NumericBase;
    numeric_empty_digits: bool;
    numeric_has_suffix: bool;
    numeric_is_float: bool;
    numeric_has_exponent: bool;
    numeric_empty_exponent: bool;
    numeric_saw_digit: bool;
    predicate_result: bool;

    span_cursor: u64 in Trapping;
    candidate_cursor: u64 in Trapping;
}

public machine Lexer::initialize(lexer: &mut Lexer, source_id: u32 in Trapping) {
    SourceUnit::clear(&mut lexer.source, SourceId { value: source_id });
    TokenStream::clear(&mut lexer.output, SourceId { value: source_id });
    lexer.cursor = 0;
}

public machine Lexer::append_source_byte(lexer: &mut Lexer, byte: u8) {
    SourceUnit::append(&mut lexer.source, byte);
}

public machine Lexer::reject(
    lexer: &mut Lexer,
    code: LexDiagnosticCode,
    start: u64 in Trapping,
    end: u64 in Trapping
) {
    TokenStream::reject(&mut lexer.output, lexer.source.id, code, start, end);
}

// Decode one Unicode scalar at an exact byte coordinate. The source buffer is
// not assumed valid before this operation; overlong forms, surrogates, and
// values beyond U+10FFFF all fail.
// The scalar predicates below classify the scalar the last decode recorded.
// Decode the scalar `distance` bytes past the cursor. The position is read
// here, so a caller lends the lexer without also reading its cursor.
machine Lexer::decode_ahead(lexer: &mut Lexer, distance: u64 in Trapping) {
    let index: u64 in Trapping = lexer.cursor + distance;
    lexer.decode_valid = false;
    lexer.scalar = 0;
    lexer.scalar_width = 0;
    transition index < lexer.source.length {
        true -> first(lexer, index)
        _ -> done()
    }

    machine first(lexer: &mut Lexer, index: u64 in Trapping) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, index);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 < 128 {
            true -> ascii(lexer)
            _ -> two_lead(lexer, index)
        }
    }

    machine ascii(lexer: &mut Lexer) {
        lexer.scalar = lexer.byte0;
        lexer.scalar_width = 1;
        lexer.decode_valid = true;
    }

    machine two_lead(lexer: &mut Lexer, index: u64 in Trapping) {
        transition lexer.byte0 >= 194 && lexer.byte0 <= 223 {
            true -> two_bound(lexer, index)
            _ -> three_lead(lexer, index)
        }
    }

    machine two_bound(lexer: &mut Lexer, index: u64 in Trapping) {
        lexer.index1 = index + 1;
        transition lexer.index1 < lexer.source.length {
            true -> two_tail(lexer)
            _ -> done()
        }
    }

    machine two_tail(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        lexer.byte1 = source_byte as u32 in Trapping;
        transition lexer.byte1 >= 128 && lexer.byte1 <= 191 {
            true -> two_value(lexer)
            _ -> done()
        }
    }

    machine two_value(lexer: &mut Lexer) {
        lexer.scalar = (lexer.byte0 - 192) * 64 + (lexer.byte1 - 128);
        lexer.scalar_width = 2;
        lexer.decode_valid = true;
    }

    machine three_lead(lexer: &mut Lexer, index: u64 in Trapping) {
        transition lexer.byte0 >= 224 && lexer.byte0 <= 239 {
            true -> three_bound(lexer, index)
            _ -> four_lead(lexer, index)
        }
    }

    machine three_bound(lexer: &mut Lexer, index: u64 in Trapping) {
        lexer.index1 = index + 1;
        lexer.index2 = index + 2;
        transition lexer.index2 < lexer.source.length {
            true -> three_bytes(lexer)
            _ -> done()
        }
    }

    machine three_bytes(lexer: &mut Lexer) {
        let first_tail: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        let second_tail: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index2);
        lexer.byte1 = first_tail as u32 in Trapping;
        lexer.byte2 = second_tail as u32 in Trapping;
        transition lexer.byte2 >= 128 && lexer.byte2 <= 191 {
            true -> three_second(lexer)
            _ -> done()
        }
    }

    machine three_second(lexer: &mut Lexer) {
        transition lexer.byte0 == 224 {
            true -> three_e0(lexer)
            _ -> three_ed_check(lexer)
        }
    }

    machine three_e0(lexer: &mut Lexer) {
        transition lexer.byte1 >= 160 && lexer.byte1 <= 191 {
            true -> three_value(lexer)
            _ -> done()
        }
    }

    machine three_ed_check(lexer: &mut Lexer) {
        transition lexer.byte0 == 237 {
            true -> three_ed(lexer)
            _ -> three_regular(lexer)
        }
    }

    machine three_ed(lexer: &mut Lexer) {
        transition lexer.byte1 >= 128 && lexer.byte1 <= 159 {
            true -> three_value(lexer)
            _ -> done()
        }
    }

    machine three_regular(lexer: &mut Lexer) {
        transition lexer.byte1 >= 128 && lexer.byte1 <= 191 {
            true -> three_value(lexer)
            _ -> done()
        }
    }

    machine three_value(lexer: &mut Lexer) {
        lexer.scalar = (lexer.byte0 - 224) * 4096
            + (lexer.byte1 - 128) * 64
            + (lexer.byte2 - 128);
        lexer.scalar_width = 3;
        lexer.decode_valid = true;
    }

    machine four_lead(lexer: &mut Lexer, index: u64 in Trapping) {
        transition lexer.byte0 >= 240 && lexer.byte0 <= 244 {
            true -> four_bound(lexer, index)
            _ -> done()
        }
    }

    machine four_bound(lexer: &mut Lexer, index: u64 in Trapping) {
        lexer.index1 = index + 1;
        lexer.index2 = index + 2;
        lexer.index3 = index + 3;
        transition lexer.index3 < lexer.source.length {
            true -> four_bytes(lexer)
            _ -> done()
        }
    }

    machine four_bytes(lexer: &mut Lexer) {
        let first_tail: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        let second_tail: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index2);
        let third_tail: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index3);
        lexer.byte1 = first_tail as u32 in Trapping;
        lexer.byte2 = second_tail as u32 in Trapping;
        lexer.byte3 = third_tail as u32 in Trapping;
        transition lexer.byte2 >= 128 && lexer.byte2 <= 191
            && lexer.byte3 >= 128 && lexer.byte3 <= 191 {
            true -> four_second(lexer)
            _ -> done()
        }
    }

    machine four_second(lexer: &mut Lexer) {
        transition lexer.byte0 == 240 {
            true -> four_f0(lexer)
            _ -> four_f4_check(lexer)
        }
    }

    machine four_f0(lexer: &mut Lexer) {
        transition lexer.byte1 >= 144 && lexer.byte1 <= 191 {
            true -> four_value(lexer)
            _ -> done()
        }
    }

    machine four_f4_check(lexer: &mut Lexer) {
        transition lexer.byte0 == 244 {
            true -> four_f4(lexer)
            _ -> four_regular(lexer)
        }
    }

    machine four_f4(lexer: &mut Lexer) {
        transition lexer.byte1 >= 128 && lexer.byte1 <= 143 {
            true -> four_value(lexer)
            _ -> done()
        }
    }

    machine four_regular(lexer: &mut Lexer) {
        transition lexer.byte1 >= 128 && lexer.byte1 <= 191 {
            true -> four_value(lexer)
            _ -> done()
        }
    }

    machine four_value(lexer: &mut Lexer) {
        lexer.scalar = (lexer.byte0 - 240) * 262144
            + (lexer.byte1 - 128) * 4096
            + (lexer.byte2 - 128) * 64
            + (lexer.byte3 - 128);
        lexer.scalar_width = 4;
        lexer.decode_valid = true;
    }

    machine done() {}
}

machine Lexer::is_whitespace(lexer: &mut Lexer) {
    let scalar: u32 in Trapping = lexer.scalar;
    lexer.predicate_result = false;
    transition scalar {
        9 -> yes(lexer)
        10 -> yes(lexer)
        13 -> yes(lexer)
        32 -> yes(lexer)
        _ -> no(lexer)
    }
    machine yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    machine no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::is_identifier_start(lexer: &mut Lexer) {
    let scalar: u32 in Trapping = lexer.scalar;
    lexer.predicate_result = false;
    transition scalar == 95 {
        true -> yes(lexer)
        _ -> upper(lexer, scalar)
    }
    machine upper(lexer: &mut Lexer, scalar: u32 in Trapping) { transition scalar >= 65 && scalar <= 90 { true -> yes(lexer) _ -> lower(lexer, scalar) } }
    machine lower(lexer: &mut Lexer, scalar: u32 in Trapping) { transition scalar >= 97 && scalar <= 122 { true -> yes(lexer) _ -> no(lexer) } }
    machine yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    machine no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::is_identifier_continue(lexer: &mut Lexer) {
    let scalar: u32 in Trapping = lexer.scalar;
    lexer.predicate_result = false;
    transition scalar == 95 {
        true -> yes(lexer)
        _ -> upper(lexer, scalar)
    }
    machine upper(lexer: &mut Lexer, scalar: u32 in Trapping) { transition scalar >= 65 && scalar <= 90 { true -> yes(lexer) _ -> lower(lexer, scalar) } }
    machine lower(lexer: &mut Lexer, scalar: u32 in Trapping) { transition scalar >= 97 && scalar <= 122 { true -> yes(lexer) _ -> digit(lexer, scalar) } }
    machine digit(lexer: &mut Lexer, scalar: u32 in Trapping) { transition scalar >= 48 && scalar <= 57 { true -> yes(lexer) _ -> no(lexer) } }
    machine yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    machine no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::validate_utf8(lexer: &mut Lexer) {
    lexer.cursor = 0;
    transition { _ -> step(lexer) }

    machine step(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode(lexer)
            _ -> complete()
        }
    }

    machine decode(lexer: &mut Lexer) {
        Lexer::decode_ahead(lexer, 0);
        transition lexer.decode_valid {
            true -> advance(lexer)
            _ -> invalid(lexer)
        }
    }

    machine advance(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + lexer.scalar_width;
        transition { _ -> step(lexer) }
    }

    machine invalid(lexer: &mut Lexer) {
        let start: u64 in Trapping = lexer.cursor;
        let end: u64 in Trapping = lexer.cursor + 1;
        Lexer::reject(lexer, LexDiagnosticCode::InvalidUtf8, start, end);
    }

    machine complete() {}
}

machine Lexer::push_token(lexer: &mut Lexer, kind: Token) {
    Lexer::retain_token(lexer, kind);
}

machine Lexer::retain_token(lexer: &mut Lexer, kind: Token) {
    let retained_decoded_start: u64 in Trapping = lexer.decoded_start;
    let retained_decoded_end: u64 in Trapping =
        lexer.output.decoded_length as u64 in Trapping;
    let retained_decoded_length: u64 in Trapping =
        retained_decoded_end - retained_decoded_start;
    let mut token: Token = kind;
    token.source = lexer.source.id.value;
    token.start = lexer.token_start;
    token.end = lexer.token_end;
    token.decoded_start = retained_decoded_start;
    token.decoded_length = retained_decoded_length;
    TokenStream::push(&mut lexer.output, token);
    transition lexer.output.last_retained {
        true -> done()
        _ -> full(lexer)
    }
    machine full(lexer: &mut Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.token_end;
        Lexer::reject(lexer, LexDiagnosticCode::TokenCapacityExceeded, start, end);
    }
    machine done() {}
}

machine Lexer::push_decoded(lexer: &mut Lexer, byte: u8) {
    TokenStream::push_decoded(&mut lexer.output, byte);
    transition lexer.output.last_retained {
        true -> done()
        _ -> full(lexer)
    }
    machine full(lexer: &mut Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.cursor;
        Lexer::reject(lexer, LexDiagnosticCode::DecodedCapacityExceeded, start, end);
    }
    machine done() {}
}

// Whether the current token's source span spells `candidate`, recorded in
// `predicate_result`. The span is read here rather than passed: a caller that
// lends the lexer exclusively may not also read its fields as later operands.
machine Lexer::token_equals(lexer: &mut Lexer, candidate: &[u8]) {
    lexer.predicate_result = false;
    let start: u64 in Trapping = lexer.token_start;
    let end: u64 in Trapping = lexer.token_end;
    transition end - start == candidate.len {
        true -> scan(lexer, start, candidate, 0)
        _ -> no(lexer)
    }

    machine scan(lexer: &mut Lexer, start: u64 in Trapping, candidate: &[u8], index: u64 in Trapping) {
        transition index < candidate.len {
            true -> address(lexer, start, candidate, index)
            _ -> yes(lexer)
        }
    }

    machine address(lexer: &mut Lexer, start: u64 in Trapping, candidate: &[u8], index: u64 in Trapping) {
        lexer.candidate_cursor = start + index;
        transition { _ -> compare(lexer, start, candidate, index) }
    }

    machine compare(lexer: &mut Lexer, start: u64 in Trapping, candidate: &[u8], index: u64 in Trapping) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.candidate_cursor);
        let candidate_byte: u8 = candidate[index];
        transition source_byte == candidate_byte {
            true -> scan(lexer, start, candidate, index + 1)
            _ -> no(lexer)
        }
    }

    machine yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    machine no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::classify_keyword(lexer: &mut Lexer) {
    Lexer::token_equals(lexer, "as"); let matched: bool = lexer.predicate_result;
    transition matched { true -> yes(lexer, KeywordKind::As) _ -> calling_convention_kw(lexer) }
    machine calling_convention_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "calling_convention"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::CallingConvention) _ -> capability_kw(lexer) } }
    machine capability_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "capability"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Capability) _ -> contains_kw(lexer) } }
    machine contains_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "contains"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Contains) _ -> data_kw(lexer) } }
    machine data_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "data"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Data) _ -> else_kw(lexer) } }
    machine else_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "else"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Else) _ -> false_kw(lexer) } }
    machine false_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "false"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::False) _ -> foreign_kw(lexer) } }
    machine foreign_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "foreign"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Foreign) _ -> host_kw(lexer) } }
    machine host_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "host"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Host) _ -> if_kw(lexer) } }
    machine if_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "if"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::If) _ -> let_kw(lexer) } }
    machine let_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "let"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Let) _ -> library_kw(lexer) } }
    machine library_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "library"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Library) _ -> loop_kw(lexer) } }
    machine loop_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "loop"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Loop) _ -> machine_kw(lexer) } }
    machine machine_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "machine"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Machine) _ -> match_kw(lexer) } }
    machine match_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "match"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Match) _ -> owns_kw(lexer) } }
    machine owns_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "owns"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Owns) _ -> platform_kw(lexer) } }
    machine platform_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "platform"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Platform) _ -> public_kw(lexer) } }
    machine public_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "public"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Public) _ -> return_kw(lexer) } }
    machine return_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "return"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Return) _ -> self_value_kw(lexer) } }
    machine self_value_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "self"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::SelfValue) _ -> state_kw(lexer) } }
    machine state_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "state"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::State) _ -> struct_kw(lexer) } }
    machine struct_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "struct"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Struct) _ -> target_kw(lexer) } }
    machine target_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "target"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Target) _ -> transition_kw(lexer) } }
    machine transition_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "transition"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Transition) _ -> true_kw(lexer) } }
    machine true_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "true"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::True) _ -> use_kw(lexer) } }
    machine use_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "use"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Use) _ -> when_kw(lexer) } }
    machine when_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "when"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::When) _ -> while_kw(lexer) } }
    machine while_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "while"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::While) _ -> case_kw(lexer) } }
    machine case_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "case"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Case) _ -> copy_kw(lexer) } }
    machine copy_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "copy"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Copy) _ -> linear_kw(lexer) } }
    machine linear_kw(lexer: &mut Lexer) { Lexer::token_equals(lexer, "linear"); let matched: bool = lexer.predicate_result; transition matched { true -> yes(lexer, KeywordKind::Linear) _ -> identifier(lexer) } }

    machine yes(lexer: &mut Lexer, keyword: KeywordKind) { Lexer::push_token(lexer, Token::Keyword { keyword: keyword }); }
    machine identifier(lexer: &mut Lexer) { Lexer::push_token(lexer, Token::Identifier); }
}

machine Lexer::lex_identifier(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    Lexer::decode_ahead(lexer, 0);
    lexer.cursor = lexer.cursor + lexer.scalar_width;
    transition { _ -> continue_scan(lexer) }

    machine continue_scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode_next(lexer)
            _ -> finish(lexer)
        }
    }

    machine decode_next(lexer: &mut Lexer) {
        Lexer::decode_ahead(lexer, 0);
        Lexer::is_identifier_continue(lexer); let continues: bool = lexer.predicate_result;
        transition continues {
            true -> advance(lexer)
            _ -> finish(lexer)
        }
    }

    machine advance(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + lexer.scalar_width;
        transition { _ -> continue_scan(lexer) }
    }

    // A word's spelling is its decoded bytes, so contextual words such as the
    // `in` of a qualified type compare against `TokenStream::decoded`.
    machine finish(lexer: &mut Lexer) {
        lexer.token_end = lexer.cursor;
        lexer.copy_cursor = lexer.token_start;
        lexer.copy_end = lexer.token_end;
        Lexer::copy_source_to_decoded(lexer);
        transition lexer.output.accepted {
            true -> classify(lexer)
            _ -> rejected()
        }
    }

    machine classify(lexer: &mut Lexer) {
        Lexer::classify_keyword(lexer);
    }

    machine rejected() {}
}

machine Lexer::lex_whitespace(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    transition { _ -> scan(lexer) }

    machine scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode(lexer)
            _ -> finish(lexer)
        }
    }

    machine decode(lexer: &mut Lexer) {
        Lexer::decode_ahead(lexer, 0);
        Lexer::is_whitespace(lexer); let whitespace: bool = lexer.predicate_result;
        transition whitespace {
            true -> advance(lexer)
            _ -> finish(lexer)
        }
    }

    machine advance(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + lexer.scalar_width;
        transition { _ -> scan(lexer) }
    }

    machine finish(lexer: &mut Lexer) {}
}

machine Lexer::lex_line_comment(lexer: &mut Lexer) {
    lexer.cursor = lexer.cursor + 2;
    transition { _ -> scan(lexer) }

    machine scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> byte(lexer)
            _ -> finish(lexer)
        }
    }

    machine byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        transition source_byte == 10 {
            true -> consume_newline(lexer)
            _ -> advance(lexer)
        }
    }

    machine advance(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + 1;
        transition { _ -> scan(lexer) }
    }

    machine consume_newline(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + 1;
    }

    machine finish(lexer: &mut Lexer) {}
}

machine Lexer::lex_block_comment(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.cursor = lexer.cursor + 2;
    lexer.comment_depth = 1;
    transition { _ -> scan(lexer) }

    machine scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> pair_bound(lexer)
            _ -> unterminated(lexer)
        }
    }

    machine pair_bound(lexer: &mut Lexer) {
        lexer.index1 = lexer.cursor + 1;
        transition lexer.index1 < lexer.source.length {
            true -> open_check(lexer)
            _ -> advance(lexer)
        }
    }

    machine open_check(lexer: &mut Lexer) {
        let first_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        let second_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        transition first_byte == 47 && second_byte == 42 {
            true -> open(lexer)
            _ -> close_check(lexer)
        }
    }

    machine open(lexer: &mut Lexer) {
        lexer.comment_depth = lexer.comment_depth + 1;
        lexer.cursor = lexer.cursor + 2;
        transition { _ -> scan(lexer) }
    }

    machine close_check(lexer: &mut Lexer) {
        let first_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        let second_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        transition first_byte == 42 && second_byte == 47 {
            true -> close(lexer)
            _ -> advance(lexer)
        }
    }

    machine close(lexer: &mut Lexer) {
        lexer.comment_depth = lexer.comment_depth - 1;
        lexer.cursor = lexer.cursor + 2;
        transition lexer.comment_depth == 0 {
            true -> finish(lexer)
            _ -> scan(lexer)
        }
    }

    machine advance(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + 1;
        transition { _ -> scan(lexer) }
    }

    machine finish(lexer: &mut Lexer) {}

    machine unterminated(lexer: &mut Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.source.length as u64 in Trapping;
        Lexer::reject(lexer, LexDiagnosticCode::UnterminatedBlockComment, start, end);
    }
}

machine Lexer::hex_digit_value(lexer: &mut Lexer, byte: u32 in Trapping) {
    lexer.digit_value = 4294967295;
    transition byte >= 48 && byte <= 57 {
        true -> decimal(lexer, byte)
        _ -> lower(lexer, byte)
    }
    machine decimal(lexer: &mut Lexer, byte: u32 in Trapping) { lexer.digit_value = byte - 48; }
    machine lower(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 97 && byte <= 102 { true -> lower_yes(lexer, byte) _ -> upper(lexer, byte) } }
    machine lower_yes(lexer: &mut Lexer, byte: u32 in Trapping) { lexer.digit_value = byte - 87; }
    machine upper(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 65 && byte <= 70 { true -> upper_yes(lexer, byte) _ -> done() } }
    machine upper_yes(lexer: &mut Lexer, byte: u32 in Trapping) { lexer.digit_value = byte - 55; }
    machine done() {}
}

machine Lexer::copy_source_to_decoded(lexer: &mut Lexer) {
    transition { _ -> scan(lexer) }

    machine scan(lexer: &mut Lexer) {
        transition lexer.copy_cursor < lexer.copy_end {
        true -> copy(lexer)
        _ -> done()
        }
    }
    machine copy(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.copy_cursor);
        Lexer::push_decoded(lexer, source_byte);
        lexer.copy_cursor = lexer.copy_cursor + 1;
        transition lexer.output.accepted { true -> scan(lexer) _ -> done() }
    }
    machine done() {}
}

machine Lexer::lex_cooked_string(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    lexer.cursor = lexer.cursor + 1;
    transition { _ -> scan(lexer) }

    machine scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode(lexer)
            _ -> unterminated(lexer)
        }
    }

    machine decode(lexer: &mut Lexer) {
        Lexer::decode_ahead(lexer, 0);
        transition lexer.scalar == 34 {
            true -> finish(lexer)
            _ -> newline_check(lexer)
        }
    }

    machine newline_check(lexer: &mut Lexer) {
        transition lexer.scalar == 10 || lexer.scalar == 13 {
            true -> outside_profile_line(lexer)
            _ -> slash(lexer)
        }
    }

    machine slash(lexer: &mut Lexer) {
        transition lexer.scalar == 92 {
            true -> escape_begin(lexer)
            _ -> copy_scalar(lexer)
        }
    }

    machine copy_scalar(lexer: &mut Lexer) {
        lexer.copy_cursor = lexer.cursor;
        lexer.copy_end = lexer.cursor + lexer.scalar_width;
        Lexer::copy_source_to_decoded(lexer);
        lexer.cursor = lexer.copy_end;
        transition lexer.output.accepted { true -> scan(lexer) _ -> done() }
    }

    machine escape_begin(lexer: &mut Lexer) {
        lexer.escape_start = lexer.cursor;
        lexer.cursor = lexer.cursor + 1;
        transition lexer.cursor < lexer.source.length {
            true -> escape_byte(lexer)
            _ -> unterminated_escape(lexer)
        }
    }

    machine escape_byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 {
            34 -> escaped_quote(lexer)
            92 -> escaped_slash(lexer)
            110 -> escaped_n(lexer)
            114 -> escaped_r(lexer)
            116 -> escaped_t(lexer)
            48 -> escaped_zero(lexer)
            120 -> hex_begin(lexer)
            117 -> outside_profile_escape(lexer)
            _ -> unsupported_escape(lexer)
        }
    }

    machine escaped_quote(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 34); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }
    machine escaped_slash(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 92); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }
    machine escaped_n(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 10); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }
    machine escaped_r(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 13); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }
    machine escaped_t(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 9); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }
    machine escaped_zero(lexer: &mut Lexer) { Lexer::push_decoded(lexer, 0); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer) _ -> done() } }

    machine hex_begin(lexer: &mut Lexer) {
        lexer.index1 = lexer.cursor + 1;
        lexer.index2 = lexer.cursor + 2;
        transition lexer.index2 < lexer.source.length {
            true -> hex_first(lexer)
            _ -> hex_unterminated(lexer)
        }
    }

    machine hex_first(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        Lexer::hex_digit_value(lexer, source_byte as u32 in Trapping);
        lexer.byte1 = lexer.digit_value;
        transition lexer.byte1 < 16 {
            true -> hex_second(lexer)
            _ -> hex_invalid_first(lexer)
        }
    }

    machine hex_second(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index2);
        Lexer::hex_digit_value(lexer, source_byte as u32 in Trapping);
        lexer.byte2 = lexer.digit_value;
        transition lexer.byte2 < 16 {
            true -> hex_emit(lexer)
            _ -> hex_invalid_second(lexer)
        }
    }

    machine hex_emit(lexer: &mut Lexer) {
        let byte: u8 = (lexer.byte1 * 16 + lexer.byte2) as u8;
        Lexer::push_decoded(lexer, byte);
        lexer.cursor = lexer.cursor + 3;
        transition lexer.output.accepted { true -> scan(lexer) _ -> done() }
    }

    machine finish(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + 1;
        lexer.token_end = lexer.cursor;
        Lexer::push_token(lexer, Token::StringLiteral);
    }

    machine unterminated(lexer: &mut Lexer) { let start: u64 in Trapping = lexer.token_start; let end: u64 in Trapping = lexer.source.length as u64 in Trapping; Lexer::reject(lexer, LexDiagnosticCode::UnterminatedStringLiteral, start, end); }
    machine unterminated_escape(lexer: &mut Lexer) { let start: u64 in Trapping = lexer.token_start; let end: u64 in Trapping = lexer.source.length as u64 in Trapping; Lexer::reject(lexer, LexDiagnosticCode::UnterminatedStringEscape, start, end); }
    machine unsupported_escape(lexer: &mut Lexer) { let start: u64 in Trapping = lexer.escape_start; let end: u64 in Trapping = lexer.cursor + 1; Lexer::reject(lexer, LexDiagnosticCode::UnsupportedEscape, start, end); }
    machine hex_unterminated(lexer: &mut Lexer) { let start: u64 in Trapping = lexer.escape_start; let end: u64 in Trapping = lexer.source.length as u64 in Trapping; Lexer::reject(lexer, LexDiagnosticCode::UnterminatedHexEscape, start, end); }
    machine hex_invalid_first(lexer: &mut Lexer) { let start: u64 in Trapping = lexer.cursor + 1; let end: u64 in Trapping = lexer.cursor + 2; Lexer::reject(lexer, LexDiagnosticCode::InvalidHexEscapeDigit, start, end); }
    machine hex_invalid_second(lexer: &mut Lexer) { let start: u64 in Trapping = lexer.cursor + 2; let end: u64 in Trapping = lexer.cursor + 3; Lexer::reject(lexer, LexDiagnosticCode::InvalidHexEscapeDigit, start, end); }
    machine outside_profile_escape(lexer: &mut Lexer) {
        let start: u64 in Trapping = lexer.escape_start;
        let end: u64 in Trapping = lexer.cursor + 1;
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }
    machine outside_profile_line(lexer: &mut Lexer) {
        let start: u64 in Trapping = lexer.cursor;
        let end: u64 in Trapping = lexer.cursor + 1;
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }
    machine done() {}
}

// Whether the current byte is a digit of the current numeric literal's base.
machine Lexer::digit_in_base(lexer: &mut Lexer) {
    let byte: u32 in Trapping = lexer.byte0;
    let base: NumericBase = lexer.numeric_base;
    lexer.predicate_result = false;
    transition base {
        NumericBase::Binary -> binary(lexer, byte)
        NumericBase::Octal -> octal(lexer, byte)
        NumericBase::Decimal -> decimal(lexer, byte)
        NumericBase::Hexadecimal -> hex(lexer, byte)
    }
    machine binary(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 48 && byte <= 49 { true -> yes(lexer) _ -> no(lexer) } }
    machine octal(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 48 && byte <= 55 { true -> yes(lexer) _ -> no(lexer) } }
    machine decimal(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 48 && byte <= 57 { true -> yes(lexer) _ -> no(lexer) } }
    machine hex(lexer: &mut Lexer, byte: u32 in Trapping) {
        transition byte >= 48 && byte <= 57 {
            true -> yes(lexer)
            _ -> hex_alpha(lexer, byte)
        }
    }
    machine hex_alpha(lexer: &mut Lexer, byte: u32 in Trapping) {
        transition byte >= 65 && byte <= 70 {
            true -> yes(lexer)
            _ -> hex_lower(lexer, byte)
        }
    }
    machine hex_lower(lexer: &mut Lexer, byte: u32 in Trapping) { transition byte >= 97 && byte <= 102 { true -> yes(lexer) _ -> no(lexer) } }
    machine yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    machine no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::consume_digits(lexer: &mut Lexer) {
    lexer.numeric_saw_digit = false;
    transition { _ -> scan(lexer) }
    machine scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> byte(lexer)
            _ -> done()
        }
    }
    machine byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 == 95 {
            true -> underscore(lexer)
            _ -> digit(lexer)
        }
    }
    machine underscore(lexer: &mut Lexer) { lexer.cursor = lexer.cursor + 1; transition { _ -> scan(lexer) } }
    machine digit(lexer: &mut Lexer) {
        Lexer::digit_in_base(lexer); let digit: bool = lexer.predicate_result;
        transition digit {
            true -> consume(lexer)
            _ -> done()
        }
    }
    machine consume(lexer: &mut Lexer) { lexer.numeric_saw_digit = true; lexer.cursor = lexer.cursor + 1; transition { _ -> scan(lexer) } }
    machine done() {}
}

machine Lexer::consume_suffix(lexer: &mut Lexer) {
    lexer.numeric_has_suffix = false;
    transition lexer.cursor < lexer.source.length {
        true -> decode_first(lexer)
        _ -> done()
    }
    machine decode_first(lexer: &mut Lexer) {
        Lexer::decode_ahead(lexer, 0);
        Lexer::is_identifier_start(lexer); let starts: bool = lexer.predicate_result;
        transition starts {
            true -> consume(lexer)
            _ -> done()
        }
    }
    machine consume(lexer: &mut Lexer) {
        lexer.numeric_has_suffix = true;
        lexer.cursor = lexer.cursor + lexer.scalar_width;
        transition lexer.cursor < lexer.source.length { true -> decode_next(lexer) _ -> done() }
    }
    machine decode_next(lexer: &mut Lexer) {
        Lexer::decode_ahead(lexer, 0);
        Lexer::is_identifier_continue(lexer); let continues: bool = lexer.predicate_result;
        transition continues { true -> consume(lexer) _ -> done() }
    }
    machine done() {}
}

machine Lexer::dot_starts_float(lexer: &mut Lexer) {
    lexer.predicate_result = false;
    transition lexer.cursor + 1 < lexer.source.length {
        true -> decode_after(lexer)
        _ -> yes(lexer)
    }
    machine decode_after(lexer: &mut Lexer) {
        Lexer::decode_ahead(lexer, 1);
        transition lexer.scalar >= 48 && lexer.scalar <= 57 {
            true -> yes(lexer)
            _ -> dotdot(lexer)
        }
    }
    machine dotdot(lexer: &mut Lexer) {
        transition lexer.scalar == 46 {
            true -> no(lexer)
            _ -> identifier(lexer)
        }
    }
    machine identifier(lexer: &mut Lexer) {
        Lexer::is_identifier_start(lexer);
        transition lexer.predicate_result { true -> no(lexer) _ -> yes(lexer) }
    }
    machine yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    machine no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::lex_number(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    lexer.numeric_base = NumericBase::Decimal;
    lexer.numeric_empty_digits = false;
    lexer.numeric_has_suffix = false;
    lexer.numeric_is_float = false;
    lexer.numeric_has_exponent = false;
    lexer.numeric_empty_exponent = false;
    let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
    transition source_byte == 46 {
        true -> leading_dot(lexer)
        _ -> integer_begin(lexer)
    }

    machine leading_dot(lexer: &mut Lexer) {
        lexer.numeric_is_float = true;
        lexer.cursor = lexer.cursor + 1;
        Lexer::consume_digits(lexer);
        transition { _ -> exponent_check(lexer) }
    }

    machine integer_begin(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte0 = source_byte as u32 in Trapping;
        lexer.cursor = lexer.cursor + 1;
        transition lexer.byte0 == 48 {
            true -> prefix_bound(lexer)
            _ -> decimal_digits(lexer)
        }
    }

    machine prefix_bound(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> prefix(lexer)
            _ -> dot_check(lexer)
        }
    }

    machine prefix(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte1 = source_byte as u32 in Trapping;
        transition lexer.byte1 == 98 || lexer.byte1 == 66 {
            true -> binary_prefix(lexer)
            _ -> octal_check(lexer)
        }
    }
    machine binary_prefix(lexer: &mut Lexer) { lexer.numeric_base = NumericBase::Binary; lexer.cursor = lexer.cursor + 1; transition { _ -> based_digits(lexer) } }
    machine octal_check(lexer: &mut Lexer) { transition lexer.byte1 == 111 || lexer.byte1 == 79 { true -> octal_prefix(lexer) _ -> hex_check(lexer) } }
    machine octal_prefix(lexer: &mut Lexer) { lexer.numeric_base = NumericBase::Octal; lexer.cursor = lexer.cursor + 1; transition { _ -> based_digits(lexer) } }
    machine hex_check(lexer: &mut Lexer) { transition lexer.byte1 == 120 || lexer.byte1 == 88 { true -> hex_prefix(lexer) _ -> decimal_digits(lexer) } }
    machine hex_prefix(lexer: &mut Lexer) { lexer.numeric_base = NumericBase::Hexadecimal; lexer.cursor = lexer.cursor + 1; transition { _ -> based_digits(lexer) } }
    machine based_digits(lexer: &mut Lexer) {
        Lexer::consume_digits(lexer);
        lexer.numeric_empty_digits = !lexer.numeric_saw_digit;
        transition { _ -> suffix(lexer) }
    }
    machine decimal_digits(lexer: &mut Lexer) { Lexer::consume_digits(lexer); transition { _ -> dot_check(lexer) } }

    machine dot_check(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> dot_byte(lexer)
            _ -> exponent_check(lexer)
        }
    }
    machine dot_byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        transition source_byte == 46 {
            true -> dot_decision(lexer)
            _ -> exponent_check(lexer)
        }
    }
    machine dot_decision(lexer: &mut Lexer) {
        Lexer::dot_starts_float(lexer); let starts: bool = lexer.predicate_result;
        transition starts {
            true -> dot_consume(lexer)
            _ -> exponent_check(lexer)
        }
    }
    machine dot_consume(lexer: &mut Lexer) {
        lexer.numeric_is_float = true;
        lexer.cursor = lexer.cursor + 1;
        Lexer::consume_digits(lexer);
        transition { _ -> exponent_check(lexer) }
    }

    machine exponent_check(lexer: &mut Lexer) {
        transition lexer.numeric_base == NumericBase::Decimal
            && lexer.cursor < lexer.source.length {
            true -> exponent_byte(lexer)
            _ -> suffix(lexer)
        }
    }
    machine exponent_byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 == 101 || lexer.byte0 == 69 {
            true -> exponent_begin(lexer)
            _ -> suffix(lexer)
        }
    }
    machine exponent_begin(lexer: &mut Lexer) {
        lexer.numeric_is_float = true;
        lexer.numeric_has_exponent = true;
        lexer.cursor = lexer.cursor + 1;
        transition lexer.cursor < lexer.source.length { true -> exponent_sign(lexer) _ -> exponent_digits(lexer) }
    }
    machine exponent_sign(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 == 43 || lexer.byte0 == 45 { true -> exponent_sign_consume(lexer) _ -> exponent_digits(lexer) }
    }
    machine exponent_sign_consume(lexer: &mut Lexer) { lexer.cursor = lexer.cursor + 1; transition { _ -> exponent_digits(lexer) } }
    machine exponent_digits(lexer: &mut Lexer) {
        lexer.numeric_base = NumericBase::Decimal;
        Lexer::consume_digits(lexer);
        lexer.numeric_empty_exponent = !lexer.numeric_saw_digit;
        transition { _ -> suffix(lexer) }
    }

    machine suffix(lexer: &mut Lexer) {
        Lexer::consume_suffix(lexer);
        transition { _ -> finish(lexer) }
    }
    machine finish(lexer: &mut Lexer) {
        lexer.token_end = lexer.cursor;
        transition lexer.numeric_is_float { true -> emit_float(lexer) _ -> emit_integer(lexer) }
    }
    machine emit_float(lexer: &mut Lexer) {
        let float: Token = Token::Float {
            has_exponent: lexer.numeric_has_exponent,
            empty_exponent: lexer.numeric_empty_exponent,
            has_suffix: lexer.numeric_has_suffix
        };
        Lexer::push_token(lexer, float);
    }
    machine emit_integer(lexer: &mut Lexer) {
        let integer: Token = Token::Integer {
            base: lexer.numeric_base,
            empty_digits: lexer.numeric_empty_digits,
            has_suffix: lexer.numeric_has_suffix
        };
        Lexer::push_token(lexer, integer);
    }
}

machine Lexer::lex_punctuation(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as u64 in Trapping;
    let first_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
    lexer.byte0 = first_byte as u32 in Trapping;
    lexer.byte1 = 4294967295;
    lexer.byte2 = 4294967295;
    lexer.index1 = lexer.cursor + 1;
    lexer.index2 = lexer.cursor + 2;
    transition lexer.index1 < lexer.source.length { true -> second(lexer) _ -> classify(lexer) }
    machine second(lexer: &mut Lexer) { let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1); lexer.byte1 = source_byte as u32 in Trapping; transition lexer.index2 < lexer.source.length { true -> third(lexer) _ -> classify(lexer) } }
    machine third(lexer: &mut Lexer) { let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index2); lexer.byte2 = source_byte as u32 in Trapping; transition { _ -> classify(lexer) } }

    machine classify(lexer: &mut Lexer) {
        transition lexer.byte0 {
            38 -> ampersand(lexer)
            39 -> single_apostrophe(lexer)
            42 -> asterisk(lexer)
            94 -> single_caret(lexer)
            58 -> colon(lexer)
            44 -> single_comma(lexer)
            46 -> dot(lexer)
            61 -> equal(lexer)
            33 -> exclamation(lexer)
            62 -> greater(lexer)
            35 -> single_hash(lexer)
            123 -> single_left_brace(lexer)
            91 -> single_left_bracket(lexer)
            40 -> single_left_paren(lexer)
            60 -> less(lexer)
            45 -> minus(lexer)
            37 -> percent(lexer)
            124 -> pipe(lexer)
            43 -> plus(lexer)
            125 -> single_right_brace(lexer)
            93 -> single_right_bracket(lexer)
            41 -> single_right_paren(lexer)
            59 -> single_semicolon(lexer)
            47 -> slash(lexer)
            126 -> single_tilde(lexer)
            _ -> unsupported(lexer)
        }
    }

    machine ampersand(lexer: &mut Lexer) { transition lexer.byte1 == 38 { true -> and_and(lexer) _ -> single_ampersand(lexer) } }
    machine colon(lexer: &mut Lexer) { transition lexer.byte1 == 58 { true -> colon_colon(lexer) _ -> single_colon(lexer) } }
    machine dot(lexer: &mut Lexer) { transition lexer.byte1 == 46 { true -> dotdot(lexer) _ -> single_dot(lexer) } }
    machine dotdot(lexer: &mut Lexer) { transition lexer.byte2 == 61 { true -> dotdot_equal(lexer) _ -> dotdot_plain(lexer) } }
    machine equal(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> equal_equal(lexer) _ -> single_equal(lexer) } }
    machine exclamation(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> exclamation_equal(lexer) _ -> single_exclamation(lexer) } }
    // `>>` stays two `>` tokens: nested static argument lists close one `>`
    // at a time, and the expression grammar reads adjacent `>` `>` as a shift.
    machine greater(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> greater_equal(lexer) _ -> single_greater(lexer) } }
    machine less(lexer: &mut Lexer) { transition lexer.byte1 == 60 { true -> less_less(lexer) _ -> less_equal_check(lexer) } }
    machine less_equal_check(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> less_equal(lexer) _ -> single_less(lexer) } }
    machine minus(lexer: &mut Lexer) { transition lexer.byte1 == 62 { true -> arrow(lexer) _ -> minus_equal_check(lexer) } }
    machine minus_equal_check(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> minus_equal(lexer) _ -> single_minus(lexer) } }
    machine percent(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> percent_equal(lexer) _ -> single_percent(lexer) } }
    machine pipe(lexer: &mut Lexer) { transition lexer.byte1 == 124 { true -> pipe_pipe(lexer) _ -> single_pipe(lexer) } }
    machine plus(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> plus_equal(lexer) _ -> single_plus(lexer) } }
    machine asterisk(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> asterisk_equal(lexer) _ -> single_asterisk(lexer) } }
    machine slash(lexer: &mut Lexer) { transition lexer.byte1 == 61 { true -> slash_equal(lexer) _ -> single_slash(lexer) } }

    machine single_ampersand(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Ampersand, 1); }
    machine and_and(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::AndAnd, 2); }
    machine single_apostrophe(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Apostrophe, 1); }
    machine arrow(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Arrow, 2); }
    machine single_asterisk(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Asterisk, 1); }
    machine single_caret(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Caret, 1); }
    machine single_colon(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Colon, 1); }
    machine colon_colon(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::ColonColon, 2); }
    machine single_comma(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Comma, 1); }
    machine single_dot(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Dot, 1); }
    machine dotdot_plain(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::DotDot, 2); }
    machine dotdot_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::DotDotEqual, 3); }
    machine single_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Equal, 1); }
    machine equal_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::EqualEqual, 2); }
    machine single_exclamation(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Exclamation, 1); }
    machine exclamation_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::ExclamationEqual, 2); }
    machine single_greater(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Greater, 1); }
    machine greater_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::GreaterEqual, 2); }
    machine single_hash(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Hash, 1); }
    machine single_left_brace(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::LeftBrace, 1); }
    machine single_left_bracket(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::LeftBracket, 1); }
    machine single_left_paren(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::LeftParen, 1); }
    machine single_less(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Less, 1); }
    machine less_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::LessEqual, 2); }
    machine less_less(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::LessLess, 2); }
    machine single_minus(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Minus, 1); }
    machine minus_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::MinusEqual, 2); }
    machine single_percent(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Percent, 1); }
    machine percent_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::PercentEqual, 2); }
    machine single_pipe(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Pipe, 1); }
    machine pipe_pipe(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::PipePipe, 2); }
    machine single_plus(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Plus, 1); }
    machine plus_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::PlusEqual, 2); }
    machine asterisk_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::AsteriskEqual, 2); }
    machine slash_equal(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::SlashEqual, 2); }
    machine single_right_brace(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::RightBrace, 1); }
    machine single_right_bracket(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::RightBracket, 1); }
    machine single_right_paren(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::RightParen, 1); }
    machine single_semicolon(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Semicolon, 1); }
    machine single_slash(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Slash, 1); }
    machine single_tilde(lexer: &mut Lexer) { Lexer::emit_punctuation(lexer, PunctuationKind::Tilde, 1); }
    machine unsupported(lexer: &mut Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.token_start + lexer.scalar_width;
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }
}

machine Lexer::emit_punctuation(lexer: &mut Lexer, kind: PunctuationKind, length: u64 in Trapping) {
    lexer.cursor = lexer.cursor + length;
    lexer.token_end = lexer.cursor;
    Lexer::push_token(lexer, Token::Punctuation { punctuation: kind });
}

machine Lexer::reject_raw_string_candidate(lexer: &mut Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.cursor = lexer.cursor + 1;
    transition { _ -> scan(lexer) }

    machine scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> byte(lexer)
            _ -> reject_prefix(lexer)
        }
    }

    machine byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        transition source_byte == 35 {
            true -> hash(lexer)
            _ -> quote(lexer)
        }
    }

    machine hash(lexer: &mut Lexer) {
        lexer.cursor = lexer.cursor + 1;
        transition { _ -> scan(lexer) }
    }

    machine quote(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.cursor);
        transition source_byte == 34 {
            true -> reject_quote(lexer)
            _ -> reject_prefix(lexer)
        }
    }

    machine reject_quote(lexer: &mut Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.cursor + 1;
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }

    machine reject_prefix(lexer: &mut Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.cursor;
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }
}

machine Lexer::is_raw_string_candidate(lexer: &mut Lexer) {
    lexer.predicate_result = false;
    lexer.candidate_cursor = lexer.cursor + 1;
    transition { _ -> scan(lexer) }

    machine scan(lexer: &mut Lexer) {
        transition lexer.candidate_cursor < lexer.source.length {
            true -> byte(lexer)
            _ -> no(lexer)
        }
    }

    machine byte(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.candidate_cursor);
        transition source_byte == 35 {
            true -> hash(lexer)
            _ -> quote(lexer)
        }
    }

    machine hash(lexer: &mut Lexer) {
        lexer.candidate_cursor = lexer.candidate_cursor + 1;
        transition { _ -> scan(lexer) }
    }

    machine quote(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.candidate_cursor);
        transition source_byte == 34 {
            true -> yes(lexer)
            _ -> no(lexer)
        }
    }

    machine yes(lexer: &mut Lexer) { lexer.predicate_result = true; }
    machine no(lexer: &mut Lexer) { lexer.predicate_result = false; }
}

machine Lexer::lex_next(lexer: &mut Lexer) {
    Lexer::decode_ahead(lexer, 0);
    transition lexer.scalar >= 128 {
        true -> outside_profile_syntax(lexer)
        _ -> whitespace_check(lexer)
    }
    machine outside_profile_syntax(lexer: &mut Lexer) {
        let start: u64 in Trapping = lexer.cursor;
        let end: u64 in Trapping = lexer.cursor + lexer.scalar_width;
        Lexer::reject(lexer, LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }
    machine whitespace_check(lexer: &mut Lexer) {
        Lexer::is_whitespace(lexer); let whitespace: bool = lexer.predicate_result;
        transition whitespace {
            true -> whitespace(lexer)
            _ -> line_comment_bound(lexer)
        }
    }
    machine whitespace(lexer: &mut Lexer) { Lexer::lex_whitespace(lexer); }
    machine line_comment_bound(lexer: &mut Lexer) { lexer.index1 = lexer.cursor + 1; transition lexer.scalar == 47 && lexer.index1 < lexer.source.length { true -> comment_second(lexer) _ -> raw_check(lexer) } }
    machine comment_second(lexer: &mut Lexer) {
        let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1);
        lexer.byte0 = source_byte as u32 in Trapping;
        transition lexer.byte0 == 47 { true -> line_comment(lexer) _ -> block_comment_check(lexer) }
    }
    machine line_comment(lexer: &mut Lexer) { Lexer::lex_line_comment(lexer); }
    machine block_comment_check(lexer: &mut Lexer) { transition lexer.byte0 == 42 { true -> block_comment(lexer) _ -> raw_check(lexer) } }
    machine block_comment(lexer: &mut Lexer) { Lexer::lex_block_comment(lexer); }
    machine raw_check(lexer: &mut Lexer) {
        transition lexer.scalar == 114 {
            true -> raw_candidate(lexer)
            _ -> identifier_check(lexer)
        }
    }
    machine raw_candidate(lexer: &mut Lexer) {
        Lexer::is_raw_string_candidate(lexer); let candidate: bool = lexer.predicate_result;
        transition candidate {
            true -> raw(lexer)
            _ -> identifier_check(lexer)
        }
    }
    machine raw(lexer: &mut Lexer) { Lexer::reject_raw_string_candidate(lexer); }
    machine identifier_check(lexer: &mut Lexer) { Lexer::is_identifier_start(lexer); let starts: bool = lexer.predicate_result; transition starts { true -> identifier(lexer) _ -> number_check(lexer) } }
    machine identifier(lexer: &mut Lexer) { Lexer::lex_identifier(lexer); }
    machine number_check(lexer: &mut Lexer) { transition lexer.scalar >= 48 && lexer.scalar <= 57 { true -> number(lexer) _ -> leading_dot_check(lexer) } }
    machine leading_dot_check(lexer: &mut Lexer) { lexer.index1 = lexer.cursor + 1; transition lexer.scalar == 46 && lexer.index1 < lexer.source.length { true -> leading_dot_second(lexer) _ -> string_check(lexer) } }
    machine leading_dot_second(lexer: &mut Lexer) { let source_byte: u8 = SourceUnit::byte_or_nul(&lexer.source, lexer.index1); lexer.byte0 = source_byte as u32 in Trapping; transition lexer.byte0 >= 48 && lexer.byte0 <= 57 { true -> number(lexer) _ -> string_check(lexer) } }
    machine number(lexer: &mut Lexer) { Lexer::lex_number(lexer); }
    machine string_check(lexer: &mut Lexer) { transition lexer.scalar == 34 { true -> string(lexer) _ -> punctuation(lexer) } }
    machine string(lexer: &mut Lexer) { Lexer::lex_cooked_string(lexer); }
    machine punctuation(lexer: &mut Lexer) { Lexer::lex_punctuation(lexer); }
}

// Bounded array reads carry their collection's Trapping policy, so tokenizing
// publishes the same crash route its callees do.
public machine Lexer::tokenize(lexer: &mut Lexer)
crashes Trap
{
    TokenStream::clear(&mut lexer.output, lexer.source.id);
    Lexer::validate_utf8(&mut lexer);
    transition lexer.output.accepted {
        true -> begin(lexer)
        _ -> done()
    }
    machine begin(lexer: &mut Lexer) { lexer.cursor = 0; transition { _ -> scan(lexer) } }
    machine scan(lexer: &mut Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> token(lexer)
            _ -> done()
        }
    }
    machine token(lexer: &mut Lexer) {
        Lexer::lex_next(&mut lexer);
        transition lexer.output.accepted { true -> scan(lexer) _ -> done() }
    }
    machine done() {}
}
