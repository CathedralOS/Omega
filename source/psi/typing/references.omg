use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::typing::literals;
use psi::typing::typer;

// Every written type, row by row. A type's rows follow their children in the
// syntax table, so one pass in table order meets each row after the rows it
// names and interns it from their types and its own binding. Integer static
// arguments and array lengths read their spelling here; a named static value
// (a `const` parameter) has no value before evaluation exists and rejects.
public machine Typer::type_references(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution)
crashes Trap
{
    typer.output.reference_count = syntax.type_reference_count;
    transition { _ -> next(typer, sources, syntax, resolution, 0) }

    machine next(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        transition index < typer.output.reference_count && index < 65536 && typer.output.accepted {
            true -> row(typer, sources, syntax, resolution, index)
            _ -> done()
        }
    }

    machine row(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping)
    requires index < 65536
    {
        let reference: TypeReference = SyntaxTrees::type_reference(syntax, index);
        let binding: TypeBinding = resolution.type_bindings[index];
        let domain: DomainBinding = resolution.domain_bindings[index];
        transition binding {
            TypeBinding::Builtin { builtin } -> builtin(typer, sources, syntax, resolution, index, reference, builtin, domain)
            TypeBinding::Data { item } -> data(typer, sources, syntax, resolution, index, reference, item, domain)
            TypeBinding::GenericParameter { parameter } -> generic(typer, sources, syntax, resolution, index, reference, parameter, domain)
            TypeBinding::Reference -> referenced(typer, sources, syntax, resolution, index, reference)
            TypeBinding::Array -> array(typer, sources, syntax, resolution, index, reference, domain)
            TypeBinding::Slice -> slice(typer, sources, syntax, resolution, index, reference, domain)
            TypeBinding::Literal -> literal(typer, sources, syntax, resolution, index, reference)
            TypeBinding::Trait { item } -> trait_application(typer, sources, syntax, resolution, index, item)
            TypeBinding::Machine { handle } -> application(typer, sources, syntax, resolution, index)
            TypeBinding::Conformance { item } -> conformance_argument(typer, sources, syntax, resolution, index, reference)
            _ -> unsupported(typer, reference)
        }
    }

    // A trait application (a trait's parent, a conformance's satisfied
    // trait, an evidence binder's trait) and a static argument naming a
    // machine are not types: the row takes none, and an application's
    // arguments' rows intern as ever. Every argument must occupy the slot
    // of its declared kind, in the order the trait wrote its telescope.
    machine trait_application(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, item: u64 in Trapping) {
        Typing::set_reference_type(&mut typer.output, index, 0);
        Typer::check_trait_telescope(typer, syntax, resolution, index, item);
        transition { _ -> next(typer, sources, syntax, resolution, index + 1) }
    }

    machine application(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        Typing::set_reference_type(&mut typer.output, index, 0);
        transition { _ -> next(typer, sources, syntax, resolution, index + 1) }
    }

    // A conformance is an implementation argument only when a trait
    // application lists it. A call's static argument naming a conformance
    // stays unsupported: this typer does not yet bind a machine's separate
    // evidence telescope.
    machine conformance_argument(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, reference: TypeReference) {
        let admitted: bool = Typer::trait_slot_argument(syntax, resolution, index);
        transition admitted {
            true -> application(typer, sources, syntax, resolution, index)
            _ -> unsupported(typer, reference)
        }
    }

    machine builtin(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        builtin: BuiltinType,
        domain: DomainBinding
    ) {
        let admitted: bool = Typer::domain_admitted(builtin, domain);
        let mut row: TypeRow = TypeRow::of(TypeKind::Builtin);
        row.builtin = builtin;
        row.domain = domain;
        row.domain_item = NameResolution::domain_item(resolution, index);
        transition admitted {
            true -> intern(typer, sources, syntax, resolution, index, reference, row)
            _ -> domain_rejected(typer, reference)
        }
    }

    // A data type's arguments are its argument rows' types; their count must
    // match the declaration's generic parameters, lifetimes aside, which an
    // application does not spell.
    machine data(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        item: u64 in Trapping,
        domain: DomainBinding
    ) {
        let expected: u64 in Trapping = Typer::applied_parameter_count(syntax, item);
        transition domain == DomainBinding::Unqualified || domain == DomainBinding::Declared {
            true -> data_arity(typer, sources, syntax, resolution, index, reference, item, expected)
            _ -> domain_rejected(typer, reference)
        }
    }

    machine data_arity(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        item: u64 in Trapping,
        expected: u64 in Trapping
    ) {
        let first: u64 in Trapping = typer.output.types.argument_count as u64 in Trapping;
        transition reference.argument_count == expected {
            true -> data_argument(typer, sources, syntax, resolution, index, reference, item, first, 0)
            _ -> arity_rejected(typer, reference)
        }
    }

    machine data_argument(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        item: u64 in Trapping,
        first: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < reference.argument_count {
            true -> data_argument_push(typer, sources, syntax, resolution, index, reference, item, first, offset)
            _ -> data_row(typer, sources, syntax, resolution, index, reference, item, first)
        }
    }

    machine data_argument_push(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        item: u64 in Trapping,
        first: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let argument_row: u64 in Trapping = SyntaxTrees::type_argument(syntax, reference.first_argument + offset);
        let argument: u64 in Trapping = Typing::reference_type(&typer.output, argument_row);
        let kept: bool = TypeTable::push_argument(&mut typer.output.types, argument);
        transition kept {
            true -> data_argument(typer, sources, syntax, resolution, index, reference, item, first, offset + 1)
            _ -> full(typer, reference)
        }
    }

    machine data_row(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        item: u64 in Trapping,
        first: u64 in Trapping
    ) {
        let mut row: TypeRow = TypeRow::of(TypeKind::Data);
        row.item = item;
        row.first_argument = first;
        row.argument_count = reference.argument_count;
        row.domain = NameResolution::domain_binding_at(resolution, index);
        row.domain_item = NameResolution::domain_item(resolution, index);
        transition { _ -> intern(typer, sources, syntax, resolution, index, reference, row) }
    }

    machine generic(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        parameter: u64 in Trapping,
        domain: DomainBinding
    ) {
        let mut row: TypeRow = TypeRow::of(TypeKind::GenericParameter);
        row.item = parameter;
        transition domain == DomainBinding::Unqualified {
            true -> intern(typer, sources, syntax, resolution, index, reference, row)
            _ -> domain_rejected(typer, reference)
        }
    }

    machine referenced(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference
    ) {
        let mut row: TypeRow = TypeRow::of(TypeKind::Reference);
        row.access = reference.access;
        row.inner = Typing::reference_type(&typer.output, reference.inner);
        transition { _ -> intern(typer, sources, syntax, resolution, index, reference, row) }
    }

    machine array(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        domain: DomainBinding
    ) {
        let length_row: TypeReference = SyntaxTrees::type_reference(syntax, reference.length);
        let length: u64 in Trapping = Typing::reference_type(&typer.output, reference.length);
        let extent: TypeRow = TypeTable::row(&typer.output.types, length);
        let parameter: bool = Typer::const_parameter(syntax, extent);
        transition extent.kind == TypeKind::StaticInteger || parameter {
            true -> array_length(typer, sources, syntax, resolution, index, reference, domain)
            _ -> length_rejected(typer, length_row)
        }
    }

    machine array_length(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        domain: DomainBinding
    ) {
        let length: u64 in Trapping = Typing::reference_type(&typer.output, reference.length);
        let mut row: TypeRow = TypeRow::of(TypeKind::Array);
        row.inner = Typing::reference_type(&typer.output, reference.inner);
        row.length = length;
        row.domain = domain;
        row.domain_item = NameResolution::domain_item(resolution, index);
        let admitted: bool = Typer::collection_qualifier(domain);
        transition admitted {
            true -> intern(typer, sources, syntax, resolution, index, reference, row)
            _ -> domain_rejected(typer, reference)
        }
    }

    machine slice(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        domain: DomainBinding
    ) {
        let mut row: TypeRow = TypeRow::of(TypeKind::Slice);
        row.inner = Typing::reference_type(&typer.output, reference.inner);
        row.domain = domain;
        row.domain_item = NameResolution::domain_item(resolution, index);
        let admitted: bool = Typer::collection_qualifier(domain);
        transition admitted {
            true -> intern(typer, sources, syntax, resolution, index, reference, row)
            _ -> domain_rejected(typer, reference)
        }
    }

    machine literal(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference
    ) {
        let value: LiteralValue = Typer::literal_value(sources, reference.name.source_span);
        let mut row: TypeRow = TypeRow::of(TypeKind::StaticInteger);
        row.length = value.magnitude as u64 in Trapping;
        transition value.valid && !value.has_suffix {
            true -> intern(typer, sources, syntax, resolution, index, reference, row)
            _ -> literal_rejected(typer, reference)
        }
    }

    machine intern(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        reference: TypeReference,
        row: TypeRow
    ) {
        let handle: u64 in Trapping = TypeTable::intern(&mut typer.output.types, row);
        Typing::set_reference_type(&mut typer.output, index, handle);
        transition handle > 0 {
            true -> next(typer, sources, syntax, resolution, index + 1)
            _ -> full(typer, reference)
        }
    }

    machine unsupported(typer: &mut Typer, reference: TypeReference) {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::UnsupportedTypeForm, reference.source_span);
    }

    machine domain_rejected(typer: &mut Typer, reference: TypeReference) {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::UnsupportedDomain, reference.source_span);
    }

    machine arity_rejected(typer: &mut Typer, reference: TypeReference) {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::GenericArgumentCount, reference.source_span);
    }

    machine length_rejected(typer: &mut Typer, length_row: TypeReference) {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::UnsupportedArrayLength, length_row.source_span);
    }

    machine literal_rejected(typer: &mut Typer, reference: TypeReference) {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::UnsupportedLiteral, reference.source_span);
    }

    machine full(typer: &mut Typer, reference: TypeReference) {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::TypeCapacityExceeded, reference.source_span);
    }

    machine done() {}
}

// Whether `domain` may qualify `builtin`: an arithmetic policy qualifies a
// fixed integer, `Finite` a float, a declared domain the carrier resolution
// matched it to (wiki/spec/language/domains.md#declaration-and-membership),
// and anything may stay unqualified
// (wiki/spec/language/numeric_values.md#overflow-policies). A case's implied
// domain qualifies data, never a builtin.
machine Typer::domain_admitted(builtin: BuiltinType, domain: DomainBinding) -> bool {
    transition domain {
        DomainBinding::Unqualified -> yes()
        DomainBinding::Finite -> float(builtin)
        DomainBinding::Declared -> yes()
        DomainBinding::Case -> no()
        _ -> integer(builtin)
    }

    machine no() -> bool {
        false
    }

    machine float(builtin: BuiltinType) -> bool {
        builtin == BuiltinType::F32 || builtin == BuiltinType::F64
    }

    machine integer(builtin: BuiltinType) -> bool {
        let fixed: bool = Typer::fixed_integer(builtin);
        fixed
    }

    machine yes() -> bool {
        true
    }
}

// Whether `builtin` is a fixed-width integer carrier.
public machine Typer::fixed_integer(builtin: BuiltinType) -> bool {
    builtin == BuiltinType::I8 || builtin == BuiltinType::I16 || builtin == BuiltinType::I32
        || builtin == BuiltinType::I64 || builtin == BuiltinType::U8 || builtin == BuiltinType::U16
        || builtin == BuiltinType::U32 || builtin == BuiltinType::U64
}

// The generic parameters an application of data `item` spells: every
// declared parameter except lifetimes.
machine Typer::applied_parameter_count(syntax: &SyntaxTrees, item: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let data_item: DataItem = SyntaxTrees::data_item(syntax, item);
    transition { _ -> count(syntax, data_item, 0, 0) }

    machine count(syntax: &SyntaxTrees, data_item: DataItem, offset: u64 in Trapping, applied: u64 in Trapping) -> u64 in Trapping {
        transition offset < data_item.generic_parameter_count {
            true -> parameter(syntax, data_item, offset, applied)
            _ -> result(applied)
        }
    }

    machine parameter(syntax: &SyntaxTrees, data_item: DataItem, offset: u64 in Trapping, applied: u64 in Trapping) -> u64 in Trapping {
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, data_item.first_generic_parameter + offset);
        transition generic.kind == GenericParameterKind::Lifetime {
            true -> count(syntax, data_item, offset + 1, applied)
            _ -> count(syntax, data_item, offset + 1, applied + 1)
        }
    }

    machine result(applied: u64 in Trapping) -> u64 in Trapping {
        applied
    }
}

// Whether a type row is a `const` generic parameter, the only binder an
// inline array's static extent may name
// (wiki/spec/language/generics.md#value-binders-and-const-requirements).
public machine Typer::const_parameter(syntax: &SyntaxTrees, row: TypeRow) -> bool
crashes Trap
{
    transition row.kind == TypeKind::GenericParameter {
        true -> declared(syntax, row.item)
        _ -> no()
    }

    machine declared(syntax: &SyntaxTrees, parameter: u64 in Trapping) -> bool {
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, parameter);
        generic.kind == GenericParameterKind::Const
    }

    machine no() -> bool {
        false
    }
}

// The qualifiers an array or slice type takes: none, an arithmetic policy
// its integer or Boolean elements read under
// (wiki/spec/language/numeric_values.md), or a declared domain.
public machine Typer::collection_qualifier(domain: DomainBinding) -> bool {
    transition domain {
        DomainBinding::Unqualified -> yes()
        DomainBinding::Wrapping -> yes()
        DomainBinding::Saturating -> yes()
        DomainBinding::Trapping -> yes()
        DomainBinding::Declared -> yes()
        _ -> no()
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Whether type-reference `row` is an argument of some trait application.
// The parent's binding is enough: argument rows are typed before the parent
// root, and resolution has already recorded which root is a trait.
public machine Typer::trait_slot_argument(syntax: &SyntaxTrees, resolution: &NameResolution, row: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> parent(syntax, resolution, row, 0) }

    machine parent(syntax: &SyntaxTrees, resolution: &NameResolution, row: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < syntax.type_reference_count {
            true -> kind(syntax, resolution, row, index)
            _ -> no()
        }
    }

    machine kind(syntax: &SyntaxTrees, resolution: &NameResolution, row: u64 in Trapping, index: u64 in Trapping) -> bool {
        let binding: TypeBinding = NameResolution::type_binding_at(resolution, index);
        transition binding {
            TypeBinding::Trait { item } -> arguments(syntax, resolution, row, index)
            _ -> parent(syntax, resolution, row, index + 1)
        }
    }

    machine arguments(syntax: &SyntaxTrees, resolution: &NameResolution, row: u64 in Trapping, index: u64 in Trapping) -> bool {
        let reference: TypeReference = SyntaxTrees::type_reference(syntax, index);
        transition { _ -> argument(syntax, resolution, row, index, reference, 0) }
    }

    machine argument(syntax: &SyntaxTrees, resolution: &NameResolution, row: u64 in Trapping, index: u64 in Trapping, reference: TypeReference, offset: u64 in Trapping) -> bool {
        transition offset < reference.argument_count {
            true -> listed(syntax, resolution, row, index, reference, offset)
            _ -> parent(syntax, resolution, row, index + 1)
        }
    }

    machine listed(syntax: &SyntaxTrees, resolution: &NameResolution, row: u64 in Trapping, index: u64 in Trapping, reference: TypeReference, offset: u64 in Trapping) -> bool {
        let handle: u64 in Trapping = SyntaxTrees::type_argument(syntax, reference.first_argument + offset);
        transition handle == row {
            true -> yes()
            _ -> argument(syntax, resolution, row, index, reference, offset + 1)
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Non-lifetime binders of one telescope. Lifetimes are a separate argument run.
machine Typer::runtime_binder_count(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(syntax, first, count, 0, 0) }

    machine next(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping, counted: u64 in Trapping) -> u64 in Trapping {
        transition offset < count {
            true -> one(syntax, first, count, offset, counted)
            _ -> result(counted)
        }
    }

    machine one(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping, counted: u64 in Trapping) -> u64 in Trapping {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, first + offset);
        transition parameter.kind == GenericParameterKind::Lifetime {
            true -> next(syntax, first, count, offset + 1, counted)
            _ -> next(syntax, first, count, offset + 1, counted + 1)
        }
    }

    machine result(counted: u64 in Trapping) -> u64 in Trapping {
        counted
    }
}

// Whether static argument `binding` may occupy a binder of `kind`.
// An evidence slot takes a named implementation or a forwarded evidence
// binder. A type slot takes a type. A const slot takes a static integer or
// a const binder. A value slot also permits a runtime-capable value binder.
// Order is the caller's: this predicate does not search.
public machine Typer::slot_accepts(syntax: &SyntaxTrees, kind: GenericParameterKind, binding: TypeBinding) -> bool
crashes Trap
{
    transition kind {
        GenericParameterKind::Evidence -> evidence(syntax, binding)
        GenericParameterKind::Type -> type_slot(syntax, binding)
        GenericParameterKind::Const -> const_slot(syntax, binding)
        GenericParameterKind::Value -> value_slot(syntax, binding)
        GenericParameterKind::Machine -> machine_slot(syntax, binding)
        _ -> no()
    }

    machine evidence(syntax: &SyntaxTrees, binding: TypeBinding) -> bool {
        transition binding {
            TypeBinding::Conformance { item } -> yes()
            TypeBinding::GenericParameter { parameter } -> generic_kind(syntax, parameter, GenericParameterKind::Evidence)
            _ -> no()
        }
    }

    machine type_slot(syntax: &SyntaxTrees, binding: TypeBinding) -> bool {
        transition binding {
            TypeBinding::Builtin { builtin } -> yes()
            TypeBinding::Data { item } -> yes()
            TypeBinding::Reference -> yes()
            TypeBinding::Array -> yes()
            TypeBinding::Slice -> yes()
            TypeBinding::GenericParameter { parameter } -> generic_kind(syntax, parameter, GenericParameterKind::Type)
            _ -> no()
        }
    }

    machine const_slot(syntax: &SyntaxTrees, binding: TypeBinding) -> bool {
        transition binding {
            TypeBinding::Literal -> yes()
            TypeBinding::GenericParameter { parameter } -> generic_kind(syntax, parameter, GenericParameterKind::Const)
            _ -> no()
        }
    }

    machine machine_slot(syntax: &SyntaxTrees, binding: TypeBinding) -> bool {
        transition binding {
            TypeBinding::Machine { handle } -> yes()
            TypeBinding::GenericParameter { parameter } -> generic_kind(syntax, parameter, GenericParameterKind::Machine)
            _ -> no()
        }
    }

    machine value_slot(syntax: &SyntaxTrees, binding: TypeBinding) -> bool {
        transition binding {
            TypeBinding::Literal -> yes()
            TypeBinding::GenericParameter { parameter } -> value_parameter(syntax, parameter)
            _ -> no()
        }
    }

    machine value_parameter(syntax: &SyntaxTrees, parameter: u64 in Trapping) -> bool {
        let declared: GenericParameter = SyntaxTrees::generic_parameter(syntax, parameter);
        declared.kind == GenericParameterKind::Value || declared.kind == GenericParameterKind::Const
    }

    machine generic_kind(syntax: &SyntaxTrees, parameter: u64 in Trapping, expected: GenericParameterKind) -> bool {
        let declared: GenericParameter = SyntaxTrees::generic_parameter(syntax, parameter);
        declared.kind == expected
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Match one trait application's arguments to its authored telescope.
// Lifetimes are not in this argument run. A short or long run rejects as a
// count; a run of the right length with a binder in the wrong category
// rejects at that argument.
public machine Typer::check_trait_telescope(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, item: u64 in Trapping)
crashes Trap
{
    let reference: TypeReference = SyntaxTrees::type_reference(syntax, index);
    let declared: TraitItem = SyntaxTrees::trait_item(syntax, item);
    let expected: u64 in Trapping = Typer::runtime_binder_count(syntax, declared.first_generic_parameter, declared.generic_parameter_count);
    transition reference.argument_count == expected {
        true -> parameter(typer, syntax, resolution, declared, reference, 0, 0)
        _ -> count_rejected(typer, reference)
    }

    machine parameter(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, declared: TraitItem, reference: TypeReference, offset: u64 in Trapping, position: u64 in Trapping) {
        transition offset < declared.generic_parameter_count && typer.output.accepted {
            true -> kind(typer, syntax, resolution, declared, reference, offset, position)
            _ -> done()
        }
    }

    machine kind(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, declared: TraitItem, reference: TypeReference, offset: u64 in Trapping, position: u64 in Trapping) {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, declared.first_generic_parameter + offset);
        transition parameter.kind {
            GenericParameterKind::Lifetime -> parameter(typer, syntax, resolution, declared, reference, offset + 1, position)
            _ -> slot(typer, syntax, resolution, declared, reference, offset, position, parameter)
        }
    }

    machine slot(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, declared: TraitItem, reference: TypeReference, offset: u64 in Trapping, position: u64 in Trapping, parameter: GenericParameter) {
        transition position < reference.argument_count {
            true -> classify(typer, syntax, resolution, declared, reference, offset, position, parameter)
            _ -> count_rejected(typer, reference)
        }
    }

    machine classify(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, declared: TraitItem, reference: TypeReference, offset: u64 in Trapping, position: u64 in Trapping, parameter: GenericParameter) {
        let argument: u64 in Trapping = SyntaxTrees::type_argument(syntax, reference.first_argument + position);
        let binding: TypeBinding = NameResolution::type_binding_at(resolution, argument);
        let fits: bool = Typer::slot_accepts(syntax, parameter.kind, binding);
        transition fits {
            true -> parameter(typer, syntax, resolution, declared, reference, offset + 1, position + 1)
            _ -> slot_rejected(typer, syntax, argument)
        }
    }

    machine slot_rejected(typer: &mut Typer, syntax: &SyntaxTrees, argument: u64 in Trapping) {
        let row: TypeReference = SyntaxTrees::type_reference(syntax, argument);
        Typing::reject(&mut typer.output, TypeDiagnosticCode::UnsupportedTypeForm, row.source_span);
    }

    machine count_rejected(typer: &mut Typer, reference: TypeReference) {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::GenericArgumentCount, reference.source_span);
    }

    machine done() {}
}
