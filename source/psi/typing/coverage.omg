use psi::integers::integers;
use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::typing::typer;

// Coverage (wiki/spec/language/patterns.md#coverage-and-domain-tests): every
// dispatch covers its admitted subject, and a value no arm matches is a
// compile error, not a fall-through. Transitions and value-position matches
// share the judgement. Arms cover a dispatch when one is `_` or the guard
// `true`; over a subject, when they name both Booleans of a Boolean subject
// or every case of its data; over guards, when two compare one expression
// with `true` and with `false`, or one pair of expressions with `==` and
// with `!=`, the two sides structurally the same (`Typer::same_tree`). Any
// other ladder of literals, comparisons or predicates closes with `_`.
pub machine Typer::covers(
    typer: &Typer,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    range: ArmRange,
    subject_type: u64 in Trapping
) -> bool
crashes Trap
{
    let closed: bool = Typer::closing_arm(syntax, range);
    transition closed {
        true -> answer(true)
        _ -> open(typer, sources, syntax, resolution, range, subject_type)
    }

    state open(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, range: ArmRange, subject_type: u64 in Trapping) -> bool {
        transition subject_type > 0 {
            true -> subject(typer, syntax, resolution, range, subject_type)
            _ -> guards(typer, sources, syntax, range)
        }
    }

    state subject(typer: &Typer, syntax: &SyntaxTrees, resolution: &NameResolution, range: ArmRange, subject_type: u64 in Trapping) -> bool {
        let base: u64 in Trapping = Typer::referent(typer, subject_type);
        let row: TypeRow = TypeTable::row(&typer.output.types, base);
        transition row.kind == TypeKind::Data {
            true -> data(syntax, resolution, range, row.item)
            _ -> boolean(typer, syntax, resolution, range, base)
        }
    }

    state boolean(typer: &Typer, syntax: &SyntaxTrees, resolution: &NameResolution, range: ArmRange, base: u64 in Trapping) -> bool {
        let holds: bool = Typer::arm_present(syntax, resolution, range, ArmPatternKind::Literal, true, 0);
        let fails: bool = Typer::arm_present(syntax, resolution, range, ArmPatternKind::Literal, false, 0);
        let covered: bool = base == typer.output.boolean && holds && fails;
        transition { _ -> answer(covered) }
    }

    // A record has no cases for its arms to name.
    state data(syntax: &SyntaxTrees, resolution: &NameResolution, range: ArmRange, item: u64 in Trapping) -> bool {
        let declared: DataItem = SyntaxTrees::data_item(syntax, item);
        transition declared.case_count > 0 {
            true -> case(syntax, resolution, range, declared, 0)
            _ -> answer(false)
        }
    }

    state case(syntax: &SyntaxTrees, resolution: &NameResolution, range: ArmRange, declared: DataItem, offset: u64 in Trapping) -> bool {
        transition offset < declared.case_count {
            true -> case_named(syntax, resolution, range, declared, offset)
            _ -> answer(true)
        }
    }

    state case_named(syntax: &SyntaxTrees, resolution: &NameResolution, range: ArmRange, declared: DataItem, offset: u64 in Trapping) -> bool {
        let named: bool = Typer::arm_present(syntax, resolution, range, ArmPatternKind::Case, false, declared.first_case + offset);
        transition named {
            true -> case(syntax, resolution, range, declared, offset + 1)
            _ -> answer(false)
        }
    }

    state guards(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, range: ArmRange) -> bool {
        let opposed: bool = Typer::opposed_guards(typer, sources, syntax, range);
        transition { _ -> answer(opposed) }
    }

    state answer(covered: bool) -> bool {
        covered
    }
}

// Whether an arm matches every value: `_`, or the guard `true`.
machine Typer::closing_arm(syntax: &SyntaxTrees, range: ArmRange) -> bool
crashes Trap
{
    transition { _ -> arm(syntax, range, 0) }

    state arm(syntax: &SyntaxTrees, range: ArmRange, offset: u64 in Trapping) -> bool {
        transition offset < range.count {
            true -> candidate(syntax, range, offset)
            _ -> answer(false)
        }
    }

    // A guarded arm is selected only while its guard holds, so it closes
    // nothing.
    state candidate(syntax: &SyntaxTrees, range: ArmRange, offset: u64 in Trapping) -> bool {
        let arm: TransitionArm = SyntaxTrees::range_arm(syntax, range, offset);
        transition arm.has_guard {
            true -> arm(syntax, range, offset + 1)
            _ -> unguarded(syntax, range, offset, arm)
        }
    }

    state unguarded(syntax: &SyntaxTrees, range: ArmRange, offset: u64 in Trapping, arm: TransitionArm) -> bool {
        transition arm.kind {
            ArmPatternKind::Wildcard -> answer(true)
            ArmPatternKind::Guard -> guard(syntax, range, offset, arm)
            _ -> arm(syntax, range, offset + 1)
        }
    }

    state guard(syntax: &SyntaxTrees, range: ArmRange, offset: u64 in Trapping, arm: TransitionArm) -> bool {
        let pattern: Expression = SyntaxTrees::expression(syntax, arm.pattern);
        transition pattern.kind == ExpressionKind::Boolean && pattern.flag {
            true -> answer(true)
            _ -> arm(syntax, range, offset + 1)
        }
    }

    state answer(closed: bool) -> bool {
        closed
    }
}

// Whether the dispatch has an arm of pattern `kind`: for a literal, the
// Boolean `flag`; for a case, the data case `data_case`.
machine Typer::arm_present(
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    range: ArmRange,
    kind: ArmPatternKind,
    flag: bool,
    data_case: u64 in Trapping
) -> bool
crashes Trap
{
    transition { _ -> arm(syntax, resolution, range, kind, flag, data_case, 0) }

    state arm(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        range: ArmRange,
        kind: ArmPatternKind,
        flag: bool,
        data_case: u64 in Trapping,
        offset: u64 in Trapping
    ) -> bool {
        transition offset < range.count {
            true -> candidate(syntax, resolution, range, kind, flag, data_case, offset)
            _ -> answer(false)
        }
    }

    state candidate(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        range: ArmRange,
        kind: ArmPatternKind,
        flag: bool,
        data_case: u64 in Trapping,
        offset: u64 in Trapping
    ) -> bool {
        let arm: TransitionArm = SyntaxTrees::range_arm(syntax, range, offset);
        transition arm.kind == kind && !arm.has_guard {
            true -> same_kind(syntax, resolution, range, kind, flag, data_case, offset, arm)
            _ -> arm(syntax, resolution, range, kind, flag, data_case, offset + 1)
        }
    }

    state same_kind(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        range: ArmRange,
        kind: ArmPatternKind,
        flag: bool,
        data_case: u64 in Trapping,
        offset: u64 in Trapping,
        arm: TransitionArm
    ) -> bool {
        transition kind {
            ArmPatternKind::Literal -> literal(syntax, resolution, range, kind, flag, data_case, offset, arm)
            ArmPatternKind::Case -> case_pattern(syntax, resolution, range, kind, flag, data_case, offset, arm)
            _ -> answer(true)
        }
    }

    state literal(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        range: ArmRange,
        kind: ArmPatternKind,
        flag: bool,
        data_case: u64 in Trapping,
        offset: u64 in Trapping,
        arm: TransitionArm
    ) -> bool {
        let pattern: Expression = SyntaxTrees::expression(syntax, arm.pattern);
        transition pattern.kind == ExpressionKind::Boolean && pattern.flag == flag {
            true -> answer(true)
            _ -> arm(syntax, resolution, range, kind, flag, data_case, offset + 1)
        }
    }

    state case_pattern(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        range: ArmRange,
        kind: ArmPatternKind,
        flag: bool,
        data_case: u64 in Trapping,
        offset: u64 in Trapping,
        arm: TransitionArm
    ) -> bool {
        let binding: ValueBinding = NameResolution::value_binding(resolution, arm.pattern);
        let named: u64 in Trapping = Typer::named_case(binding);
        transition named == data_case + 1 {
            true -> answer(true)
            _ -> arm(syntax, resolution, range, kind, flag, data_case, offset + 1)
        }
    }

    state answer(present: bool) -> bool {
        present
    }
}

// The data case a binding names, plus one; zero for any other binding.
machine Typer::named_case(binding: ValueBinding) -> u64 in Trapping {
    transition binding {
        ValueBinding::DataCase { item, data_case } -> found(data_case + 1)
        _ -> found(0)
    }

    state found(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// Whether two guards are complementary: `x == true` and `x == false`, or
// `l == r` and `l != r`.
machine Typer::opposed_guards(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, range: ArmRange) -> bool
crashes Trap
{
    transition { _ -> first(typer, sources, syntax, range, 0) }

    state first(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, range: ArmRange, offset: u64 in Trapping) -> bool {
        transition offset < range.count {
            true -> first_guard(typer, sources, syntax, range, offset)
            _ -> answer(false)
        }
    }

    state first_guard(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, range: ArmRange, offset: u64 in Trapping) -> bool {
        let arm: TransitionArm = SyntaxTrees::range_arm(syntax, range, offset);
        let pattern: Expression = SyntaxTrees::expression(syntax, arm.pattern);
        transition arm.kind == ArmPatternKind::Guard && pattern.kind == ExpressionKind::Binary
            && pattern.operator == OperatorKind::Equal {
            true -> second(typer, sources, syntax, range, offset, pattern, 0)
            _ -> first(typer, sources, syntax, range, offset + 1)
        }
    }

    state second(
        typer: &Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        range: ArmRange,
        offset: u64 in Trapping,
        equal: Expression,
        other: u64 in Trapping
    ) -> bool {
        transition other < range.count {
            true -> second_guard(typer, sources, syntax, range, offset, equal, other)
            _ -> first(typer, sources, syntax, range, offset + 1)
        }
    }

    state second_guard(
        typer: &Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        range: ArmRange,
        offset: u64 in Trapping,
        equal: Expression,
        other: u64 in Trapping
    ) -> bool {
        let arm: TransitionArm = SyntaxTrees::range_arm(syntax, range, other);
        let pattern: Expression = SyntaxTrees::expression(syntax, arm.pattern);
        let complementary: bool = arm.kind == ArmPatternKind::Guard && Typer::complementary(typer, sources, syntax, equal, pattern);
        transition complementary {
            true -> answer(true)
            _ -> second(typer, sources, syntax, range, offset, equal, other + 1)
        }
    }

    state answer(opposed: bool) -> bool {
        opposed
    }
}

// Whether `other` fails exactly where the equality `equal` holds: it is
// `!=` of the same sides, or, when `equal` compares an expression with a
// Boolean literal, the same comparison with the other literal.
machine Typer::complementary(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, equal: Expression, other: Expression) -> bool
crashes Trap
{
    transition other.kind == ExpressionKind::Binary {
        true -> binary(typer, sources, syntax, equal, other)
        _ -> answer(false)
    }

    state binary(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, equal: Expression, other: Expression) -> bool {
        transition other.operator {
            OperatorKind::NotEqual -> negated(typer, sources, syntax, equal, other)
            OperatorKind::Equal -> literals(typer, sources, syntax, equal, other)
            _ -> answer(false)
        }
    }

    state negated(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, equal: Expression, other: Expression) -> bool {
        let left: bool = Typer::same_tree(typer, sources, syntax, equal.left, other.left);
        let right: bool = Typer::same_tree(typer, sources, syntax, equal.right, other.right);
        transition { _ -> answer(left && right) }
    }

    state literals(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, equal: Expression, other: Expression) -> bool {
        let first: BooleanComparison = Typer::boolean_comparison(syntax, equal);
        let second: BooleanComparison = Typer::boolean_comparison(syntax, other);
        transition first.compared && second.compared && first.value != second.value {
            true -> same_subject(typer, sources, syntax, first, second)
            _ -> answer(false)
        }
    }

    state same_subject(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, first: BooleanComparison, second: BooleanComparison) -> bool {
        let same: bool = Typer::same_tree(typer, sources, syntax, first.subject, second.subject);
        transition { _ -> answer(same) }
    }

    state answer(complementary: bool) -> bool {
        complementary
    }
}

// An equality of an expression with a Boolean literal, either side.
pub data BooleanComparison [copy] {
    compared: bool;
    subject: u64 in Trapping;
    value: bool;
}

machine Typer::boolean_comparison(syntax: &SyntaxTrees, equal: Expression) -> BooleanComparison
crashes Trap
{
    let left: Expression = SyntaxTrees::expression(syntax, equal.left);
    let right: Expression = SyntaxTrees::expression(syntax, equal.right);
    transition right.kind == ExpressionKind::Boolean {
        true -> compared(equal.left, right.flag)
        _ -> left_literal(equal, left)
    }

    state left_literal(equal: Expression, left: Expression) -> BooleanComparison {
        transition left.kind == ExpressionKind::Boolean {
            true -> compared(equal.right, left.flag)
            _ -> uncompared()
        }
    }

    state compared(subject: u64 in Trapping, value: bool) -> BooleanComparison {
        BooleanComparison { compared: true, subject: subject, value: value }
    }

    state uncompared() -> BooleanComparison {
        BooleanComparison { compared: false, subject: 0, value: false }
    }
}

// Whether two expression trees are structurally the same: node by node, the
// same kinds, operators, types and spellings, with names, paths, fields,
// literals, operators, indexes and casts compared and any other node, a call
// among them, never the same. A tree's nodes are contiguous and children
// precede parents, so equal trees align at equal offsets from their lowest
// nodes.
pub machine Typer::same_tree(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, left_root: u64 in Trapping, right_root: u64 in Trapping) -> bool
crashes Trap
{
    let left: Expression = SyntaxTrees::expression(syntax, left_root);
    let right: Expression = SyntaxTrees::expression(syntax, right_root);
    let last: u64 in Trapping = left_root - left.first_row;
    transition last == right_root - right.first_row {
        true -> node(typer, sources, syntax, left.first_row, right.first_row, 0, last)
        _ -> answer(false)
    }

    state node(
        typer: &Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_low: u64 in Trapping,
        right_low: u64 in Trapping,
        offset: u64 in Trapping,
        last: u64 in Trapping
    ) -> bool {
        let same: bool = Typer::same_node(typer, sources, syntax, left_low, right_low, offset);
        transition same && offset < last {
            true -> node(typer, sources, syntax, left_low, right_low, offset + 1, last)
            _ -> answer(same)
        }
    }

    state answer(same: bool) -> bool {
        same
    }
}

// Whether the nodes at `offset` within two aligned trees are the same.
machine Typer::same_node(typer: &Typer, sources: &SourceSet, syntax: &SyntaxTrees, left_low: u64 in Trapping, right_low: u64 in Trapping, offset: u64 in Trapping) -> bool
crashes Trap
{
    let left_handle: u64 in Trapping = left_low + offset;
    let right_handle: u64 in Trapping = right_low + offset;
    let left: Expression = SyntaxTrees::expression(syntax, left_handle);
    let right: Expression = SyntaxTrees::expression(syntax, right_handle);
    let left_type: u64 in Trapping = Typing::expression_type(&typer.output, left_handle);
    let right_type: u64 in Trapping = Typing::expression_type(&typer.output, right_handle);
    let shaped: bool = left.kind == right.kind && left.operator == right.operator && left.flag == right.flag
        && left.count == right.count && left_type == right_type;
    transition shaped {
        true -> kind(typer, sources, syntax, left_low, right_low, left_handle, right_handle, left, right)
        _ -> answer(false)
    }

    state kind(
        typer: &Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_low: u64 in Trapping,
        right_low: u64 in Trapping,
        left_handle: u64 in Trapping,
        right_handle: u64 in Trapping,
        left: Expression,
        right: Expression
    ) -> bool {
        transition left.kind {
            ExpressionKind::Name -> spelled(sources, left.name.source_span, right.name.source_span)
            ExpressionKind::Path -> path(sources, syntax, left, right, 0)
            ExpressionKind::Integer -> valued(typer, left_handle, right_handle)
            ExpressionKind::Boolean -> answer(true)
            ExpressionKind::Field -> field(sources, left_low, right_low, left, right)
            ExpressionKind::Unary -> children(left_low, right_low, left, right, false)
            ExpressionKind::Cast -> children(left_low, right_low, left, right, false)
            ExpressionKind::Binary -> children(left_low, right_low, left, right, true)
            ExpressionKind::Index -> children(left_low, right_low, left, right, true)
            _ -> answer(false)
        }
    }

    state spelled(sources: &SourceSet, left: SourceSpan, right: SourceSpan) -> bool {
        let same: bool = SourceSet::spans_equal(sources, left, right);
        transition { _ -> answer(same) }
    }

    state path(sources: &SourceSet, syntax: &SyntaxTrees, left: Expression, right: Expression, member: u64 in Trapping) -> bool {
        transition member < left.count {
            true -> path_member(sources, syntax, left, right, member)
            _ -> answer(true)
        }
    }

    state path_member(sources: &SourceSet, syntax: &SyntaxTrees, left: Expression, right: Expression, member: u64 in Trapping) -> bool {
        let left_member: IdentifierSpan = SyntaxTrees::member(syntax, left.first + member);
        let right_member: IdentifierSpan = SyntaxTrees::member(syntax, right.first + member);
        let same: bool = SourceSet::spans_equal(sources, left_member.source_span, right_member.source_span);
        transition same {
            true -> path(sources, syntax, left, right, member + 1)
            _ -> answer(false)
        }
    }

    state valued(typer: &Typer, left_handle: u64 in Trapping, right_handle: u64 in Trapping) -> bool {
        let left_value: ExactInteger = Typing::value(&typer.output, left_handle);
        let right_value: ExactInteger = Typing::value(&typer.output, right_handle);
        let left_denominator: u64 in Trapping = Typing::denominator(&typer.output, left_handle);
        let right_denominator: u64 in Trapping = Typing::denominator(&typer.output, right_handle);
        let same: bool = left_value.negative == right_value.negative && left_value.magnitude == right_value.magnitude
            && left_denominator == right_denominator;
        transition { _ -> answer(same) }
    }

    state field(sources: &SourceSet, left_low: u64 in Trapping, right_low: u64 in Trapping, left: Expression, right: Expression) -> bool {
        let same: bool = SourceSet::spans_equal(sources, left.name.source_span, right.name.source_span);
        transition same {
            true -> children(left_low, right_low, left, right, false)
            _ -> answer(false)
        }
    }

    // Children sit at the same offsets in both trees.
    state children(left_low: u64 in Trapping, right_low: u64 in Trapping, left: Expression, right: Expression, both: bool) -> bool {
        let left_child: bool = left.left >= left_low && right.left >= right_low && left.left - left_low == right.left - right_low;
        let right_child: bool = !both
            || (left.right >= left_low && right.right >= right_low && left.right - left_low == right.right - right_low);
        transition { _ -> answer(left_child && right_child) }
    }

    state answer(same: bool) -> bool {
        same
    }
}
