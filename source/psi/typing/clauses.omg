use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::typing::admission;
use psi::typing::expressions;
use psi::typing::generics;
use psi::typing::typer;

// Clauses (wiki/spec/language/machines.md#supply). A machine that
// `satisfies` an exact trait requirement inherits its contract, so its
// signature must be the requirement's with the trait's type parameters
// replaced by the clause's static arguments: as many parameters, each of
// the substituted type, and the same result. A requirement with generic
// parameters of its own, or a trait with parameters other than types and
// lifetimes, rejects as unsupported. The `via` payload and a `terminates by`
// witness's subjects and view type like any expression.
pub machine Typer::type_clauses(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution)
crashes Trap
{
    transition { _ -> next_machine(typer, sources, syntax, resolution, 0) }

    state next_machine(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        transition index < syntax.machine_count && typer.output.accepted {
            true -> machine(typer, sources, syntax, resolution, index)
            _ -> done()
        }
    }

    state machine(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        transition { _ -> next_clause(typer, sources, syntax, resolution, index, item, 0) }
    }

    state next_clause(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < item.clause_count && typer.output.accepted {
            true -> clause(typer, sources, syntax, resolution, index, item, offset)
            _ -> next_machine(typer, sources, syntax, resolution, index + 1)
        }
    }

    state clause(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        let handle: u64 in Trapping = item.first_clause + offset;
        let clause: Clause = SyntaxTrees::clause(syntax, handle);
        transition clause.kind {
            ClauseKind::Satisfies -> satisfies(typer, sources, syntax, resolution, index, item, offset, handle, clause)
            ClauseKind::Terminates -> terminates(typer, sources, syntax, resolution, index, item, offset, handle, clause)
            _ -> next_clause(typer, sources, syntax, resolution, index, item, offset + 1)
        }
    }

    state satisfies(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        clause: Clause
    ) {
        let requirement: ValueBinding = NameResolution::requirement(resolution, handle);
        Typer::type_satisfied_requirement(typer, sources, syntax, resolution, item, clause, requirement);
        transition { _ -> next_clause(typer, sources, syntax, resolution, index, item, offset + 1) }
    }

    state terminates(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        clause: Clause
    ) {
        Typer::type_ranking(typer, sources, syntax, resolution, handle, clause);
        transition { _ -> next_clause(typer, sources, syntax, resolution, index, item, offset + 1) }
    }

    state done() {}
}

// One `satisfies` clause of `satisfier`: bind the trait's parameters to the
// clause's arguments, compare the signatures, then type the `via` payload.
machine Typer::type_satisfied_requirement(
    typer: &mut Typer,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    satisfier: MachineItem,
    clause: Clause,
    binding: ValueBinding
)
crashes Trap
{
    transition binding {
        ValueBinding::Machine { handle } -> requirement(typer, sources, syntax, resolution, satisfier, clause, handle)
        _ -> invalid()
    }

    state requirement(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        handle: u64 in Trapping
    ) {
        let required: MachineItem = SyntaxTrees::machine_item(syntax, handle);
        let owner: MachineOwner = NameResolution::machine_owner(resolution, handle);
        transition required.generic_parameter_count == 0 && owner.container == MachineContainer::Trait {
            true -> owned(typer, sources, syntax, resolution, satisfier, clause, required, owner)
            _ -> reject(typer, TypeDiagnosticCode::UnsupportedTypeForm, clause.source_span)
        }
    }

    state owned(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        owner: MachineOwner
    ) {
        let declared: TraitItem = SyntaxTrees::trait_item(syntax, owner.item);
        transition { _ -> bindings(typer, sources, syntax, resolution, satisfier, clause, required, declared) }
    }

    state bindings(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        declared: TraitItem
    ) {
        Typer::begin_bindings(typer);
        transition { _ -> parameter(typer, sources, syntax, resolution, satisfier, clause, required, declared, 0, 0) }
    }

    // The trait's parameters in order, lifetimes aside, each bound to the
    // clause's next static argument.
    state parameter(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        declared: TraitItem,
        offset: u64 in Trapping,
        position: u64 in Trapping
    ) {
        transition offset < declared.generic_parameter_count {
            true -> parameter_kind(typer, sources, syntax, resolution, satisfier, clause, required, declared, offset, position)
            _ -> counted(typer, sources, syntax, resolution, satisfier, clause, required, position)
        }
    }

    state parameter_kind(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        declared: TraitItem,
        offset: u64 in Trapping,
        position: u64 in Trapping
    ) {
        let handle: u64 in Trapping = declared.first_generic_parameter + offset;
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, handle);
        transition generic.kind {
            GenericParameterKind::Lifetime -> parameter(typer, sources, syntax, resolution, satisfier, clause, required, declared, offset + 1, position)
            GenericParameterKind::Type -> argument(typer, sources, syntax, resolution, satisfier, clause, required, declared, offset, position, handle)
            _ -> reject(typer, TypeDiagnosticCode::UnsupportedTypeForm, clause.source_span)
        }
    }

    state argument(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        declared: TraitItem,
        offset: u64 in Trapping,
        position: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        transition position < clause.argument_count {
            true -> bound(typer, sources, syntax, resolution, satisfier, clause, required, declared, offset, position, handle)
            _ -> reject(typer, TypeDiagnosticCode::GenericArgumentCount, clause.source_span)
        }
    }

    state bound(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        declared: TraitItem,
        offset: u64 in Trapping,
        position: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        let row: u64 in Trapping = SyntaxTrees::type_argument(syntax, clause.first_argument + position);
        let argument_type: u64 in Trapping = Typing::reference_type(&typer.output, row);
        Typer::bind(typer, handle, argument_type);
        transition { _ -> parameter(typer, sources, syntax, resolution, satisfier, clause, required, declared, offset + 1, position + 1) }
    }

    state counted(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        position: u64 in Trapping
    ) {
        transition position == clause.argument_count {
            true -> signature(typer, sources, syntax, resolution, satisfier, clause, required)
            _ -> reject(typer, TypeDiagnosticCode::GenericArgumentCount, clause.source_span)
        }
    }

    state signature(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem
    ) {
        let same: bool = Typer::same_satisfied_signature(typer, syntax, satisfier, required, clause.source_span);
        transition same {
            true -> payload(typer, sources, syntax, resolution, clause)
            _ -> reject(typer, TypeDiagnosticCode::SatisfierMismatch, clause.source_span)
        }
    }

    state payload(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, clause: Clause) {
        transition clause.has_expression {
            true -> typed_payload(typer, sources, syntax, resolution, clause)
            _ -> done()
        }
    }

    state typed_payload(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, clause: Clause) {
        Typer::type_tree(typer, sources, syntax, resolution, clause.expression);
    }

    state reject(typer: &mut Typer, code: TypeDiagnosticCode, source_span: SourceSpan) {
        Typing::reject(&mut typer.output, code, source_span);
    }

    state invalid() {
        crash Trap;
    }

    state done() {}
}

// Whether `satisfier`'s parameters and result are `required`'s under the
// live bindings.
machine Typer::same_satisfied_signature(
    typer: &mut Typer,
    syntax: &SyntaxTrees,
    satisfier: MachineItem,
    required: MachineItem,
    source_span: SourceSpan
) -> bool
crashes Trap
{
    transition satisfier.parameter_count == required.parameter_count {
        true -> parameter(typer, syntax, satisfier, required, source_span, 0)
        _ -> differs()
    }

    state parameter(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        satisfier: MachineItem,
        required: MachineItem,
        source_span: SourceSpan,
        offset: u64 in Trapping
    ) -> bool {
        transition offset < satisfier.parameter_count {
            true -> compared(typer, syntax, satisfier, required, source_span, offset)
            _ -> result(typer, satisfier, required, source_span)
        }
    }

    state compared(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        satisfier: MachineItem,
        required: MachineItem,
        source_span: SourceSpan,
        offset: u64 in Trapping
    ) -> bool {
        let own: Parameter = SyntaxTrees::parameter(syntax, satisfier.first_parameter + offset);
        let owed: Parameter = SyntaxTrees::parameter(syntax, required.first_parameter + offset);
        let own_type: u64 in Trapping = Typing::reference_type(&typer.output, own.type_reference);
        let written: u64 in Trapping = Typing::reference_type(&typer.output, owed.type_reference);
        let owed_type: u64 in Trapping = Typer::substitute_bound(typer, written, source_span);
        transition own_type == owed_type {
            true -> parameter(typer, syntax, satisfier, required, source_span, offset + 1)
            _ -> differs()
        }
    }

    state result(typer: &mut Typer, satisfier: MachineItem, required: MachineItem, source_span: SourceSpan) -> bool {
        let own_result: u64 in Trapping = Typer::declared_result(typer, satisfier.has_return_type, satisfier.return_type, typer.output.unit);
        let written: u64 in Trapping = Typer::declared_result(typer, required.has_return_type, required.return_type, typer.output.unit);
        let owed_result: u64 in Trapping = Typer::substitute_bound(typer, written, source_span);
        own_result == owed_result
    }

    state differs() -> bool {
        false
    }
}

// A `terminates by` witness: its subjects, then its view.
machine Typer::type_ranking(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause)
crashes Trap
{
    transition { _ -> subject(typer, sources, syntax, resolution, handle, clause, 0) }

    state subject(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause, offset: u64 in Trapping) {
        transition offset < clause.argument_count && typer.output.accepted {
            true -> typed_subject(typer, sources, syntax, resolution, handle, clause, offset)
            _ -> view(typer, sources, syntax, resolution, handle, clause)
        }
    }

    state typed_subject(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause, offset: u64 in Trapping) {
        let root: u64 in Trapping = SyntaxTrees::argument(syntax, clause.first_argument + offset);
        Typer::type_tree(typer, sources, syntax, resolution, root);
        transition { _ -> subject(typer, sources, syntax, resolution, handle, clause, offset + 1) }
    }

    // The view names the ranking vocabulary, not a value; only
    // `Nat::IncreasingTo`'s limit is an expression.
    state view(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause) {
        let view: RankingView = NameResolution::ranking_view(resolution, handle);
        transition view {
            RankingView::IncreasingTo -> limit(typer, sources, syntax, resolution, clause)
            RankingView::Measure -> measured(typer, sources, syntax, resolution, handle, clause)
            _ -> done()
        }
    }

    // A declared measure ranks one subject: of its parameter's type, or of
    // the data a lexicographic measure's owner names
    // (wiki/spec/language/termination.md#ranking).
    state measured(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause) {
        let measure: MachineItem = SyntaxTrees::machine_item(syntax, NameResolution::ranking_measure(resolution, handle));
        let root: u64 in Trapping = SyntaxTrees::argument(syntax, clause.first_argument);
        transition clause.argument_count == 1 {
            true -> subject_kind(typer, sources, syntax, measure, root)
            _ -> mismatched(typer, syntax, clause.expression)
        }
    }

    state subject_kind(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, measure: MachineItem, root: u64 in Trapping) {
        transition measure.component_count > 0 {
            true -> owned_subject(typer, sources, syntax, measure, root)
            _ -> admitted_subject(typer, syntax, measure, root)
        }
    }

    state admitted_subject(typer: &mut Typer, syntax: &SyntaxTrees, measure: MachineItem, root: u64 in Trapping) {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, measure.first_parameter);
        let wanted: u64 in Trapping = Typing::reference_type(&typer.output, parameter.type_reference);
        let admitted: bool = Typer::admit(typer, syntax, wanted, root, false);
    }

    state owned_subject(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, measure: MachineItem, root: u64 in Trapping) {
        let subject: u64 in Trapping = Typing::expression_type(&typer.output, root);
        let row: TypeRow = TypeTable::row(&typer.output.types, subject);
        transition row.kind == TypeKind::Data {
            true -> owned_data(typer, sources, syntax, measure, root, row.item)
            _ -> mismatched(typer, syntax, root)
        }
    }

    state owned_data(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, measure: MachineItem, root: u64 in Trapping, item: u64 in Trapping) {
        let data: DataItem = SyntaxTrees::data_item(syntax, item);
        let same: bool = SourceSet::spans_equal(sources, data.name.source_span, measure.owner.source_span);
        transition same {
            true -> done()
            _ -> mismatched(typer, syntax, root)
        }
    }

    state mismatched(typer: &mut Typer, syntax: &SyntaxTrees, handle: u64 in Trapping) {
        let written: Expression = SyntaxTrees::expression(syntax, handle);
        Typing::reject(&mut typer.output, TypeDiagnosticCode::MismatchedTypes, written.source_span);
    }

    state limit(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, clause: Clause) {
        let written: Expression = SyntaxTrees::expression(syntax, clause.expression);
        let root: u64 in Trapping = SyntaxTrees::argument(syntax, written.first);
        Typer::type_tree(typer, sources, syntax, resolution, root);
    }

    state done() {}
}
