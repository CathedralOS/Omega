// Clauses (wiki/spec/language/machines.md#supply). A machine that
// `satisfies` an exact trait requirement inherits its contract, so its
// signature must be the requirement's with the trait's type parameters
// replaced by the clause's static arguments: as many parameters, each of
// the substituted type, and the same result. A requirement with generic
// parameters of its own, or a trait with parameters other than types and
// lifetimes, rejects as unsupported. The `via` payload and a `terminates by`
// witness's subjects and view type like any expression.
public machine type_clauses(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution)
crashes Trap
{
    transition { _ -> next_machine(typer, sources, syntax, resolution, 0) }

    machine next_machine(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        transition index < syntax.machine_count && typer.output.accepted {
            true -> machine(typer, sources, syntax, resolution, index)
            _ -> done()
        }
    }

    machine machine(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, index);
        transition { _ -> next_clause(typer, sources, syntax, resolution, index, item, 0) }
    }

    machine next_clause(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < item.clause_count && typer.output.accepted {
            true -> clause(typer, sources, syntax, resolution, index, item, offset)
            _ -> next_machine(typer, sources, syntax, resolution, index + 1)
        }
    }

    machine clause(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        let handle: u64 in Trapping = item.first_clause + offset;
        let clause: Clause = syntax_trees_clause(syntax, handle);
        transition clause.kind {
            ClauseKind::Satisfies -> satisfies(typer, sources, syntax, resolution, index, item, offset, handle, clause)
            ClauseKind::Terminates -> terminates(typer, sources, syntax, resolution, index, item, offset, handle, clause)
            _ -> next_clause(typer, sources, syntax, resolution, index, item, offset + 1)
        }
    }

    machine satisfies(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        clause: Clause
    ) {
        let requirement: ValueBinding = name_resolution_requirement(resolution, handle);
        type_satisfied_requirement(typer, sources, syntax, resolution, item, clause, requirement);
        transition { _ -> next_clause(typer, sources, syntax, resolution, index, item, offset + 1) }
    }

    machine terminates(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        clause: Clause
    ) {
        type_ranking(typer, sources, syntax, resolution, handle, clause);
        transition { _ -> next_clause(typer, sources, syntax, resolution, index, item, offset + 1) }
    }

    machine done() {}
}

// One `satisfies` clause of `satisfier`: bind the trait's parameters to the
// clause's arguments, compare the signatures, then type the `via` payload.
machine type_satisfied_requirement(
    typer: &mut Typer,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    satisfier: MachineItem,
    clause: Clause,
    binding: ValueBinding
)
crashes Trap
{
    transition binding {
        ValueBinding::Machine { handle } -> requirement(typer, sources, syntax, resolution, satisfier, clause, handle)
        _ -> invalid()
    }

    machine requirement(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        handle: u64 in Trapping
    ) {
        let required: MachineItem = machine_item(syntax, handle);
        let owner: MachineOwner = machine_owner(resolution, handle);
        transition required.parent == 0 && required.generic_parameter_count == 0 && owner.container == MachineContainer::Trait {
            true -> owned(typer, sources, syntax, resolution, satisfier, clause, required, owner)
            _ -> reject(typer, TypeDiagnosticCode::UnsupportedTypeForm, clause.source_span)
        }
    }

    machine owned(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        owner: MachineOwner
    ) {
        let declared: TraitItem = trait_item(syntax, owner.item);
        transition { _ -> bindings(typer, sources, syntax, resolution, satisfier, clause, required, declared) }
    }

    machine bindings(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        declared: TraitItem
    ) {
        begin_bindings(typer);
        transition { _ -> parameter(typer, sources, syntax, resolution, satisfier, clause, required, declared, 0, 0) }
    }

    // The trait's parameters in order, lifetimes aside, each bound to the
    // clause's next static argument.
    machine parameter(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        declared: TraitItem,
        offset: u64 in Trapping,
        position: u64 in Trapping
    ) {
        transition offset < declared.generic_parameter_count {
            true -> parameter_kind(typer, sources, syntax, resolution, satisfier, clause, required, declared, offset, position)
            _ -> counted(typer, sources, syntax, resolution, satisfier, clause, required, position)
        }
    }

    machine parameter_kind(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        declared: TraitItem,
        offset: u64 in Trapping,
        position: u64 in Trapping
    ) {
        let handle: u64 in Trapping = declared.first_generic_parameter + offset;
        let generic: GenericParameter = syntax_trees_generic_parameter(syntax, handle);
        transition generic.kind {
            GenericParameterKind::Lifetime -> parameter(typer, sources, syntax, resolution, satisfier, clause, required, declared, offset + 1, position)
            GenericParameterKind::Type -> argument(typer, sources, syntax, resolution, satisfier, clause, required, declared, offset, position, handle)
            _ -> reject(typer, TypeDiagnosticCode::UnsupportedTypeForm, clause.source_span)
        }
    }

    machine argument(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        declared: TraitItem,
        offset: u64 in Trapping,
        position: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        transition position < clause.argument_count {
            true -> bound(typer, sources, syntax, resolution, satisfier, clause, required, declared, offset, position, handle)
            _ -> reject(typer, TypeDiagnosticCode::GenericArgumentCount, clause.source_span)
        }
    }

    machine bound(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        declared: TraitItem,
        offset: u64 in Trapping,
        position: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        let row: u64 in Trapping = type_argument(syntax, clause.first_argument + position);
        let argument_type: u64 in Trapping = reference_type(&typer.output, row);
        typer_bind(typer, handle, argument_type);
        transition { _ -> parameter(typer, sources, syntax, resolution, satisfier, clause, required, declared, offset + 1, position + 1) }
    }

    machine counted(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem,
        position: u64 in Trapping
    ) {
        transition position == clause.argument_count {
            true -> signature(typer, sources, syntax, resolution, satisfier, clause, required)
            _ -> reject(typer, TypeDiagnosticCode::GenericArgumentCount, clause.source_span)
        }
    }

    machine signature(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        satisfier: MachineItem,
        clause: Clause,
        required: MachineItem
    ) {
        let same: bool = same_satisfied_signature(typer, syntax, satisfier, required, clause.source_span);
        transition same {
            true -> payload(typer, sources, syntax, resolution, clause)
            _ -> reject(typer, TypeDiagnosticCode::SatisfierMismatch, clause.source_span)
        }
    }

    machine payload(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, clause: Clause) {
        transition clause.has_expression {
            true -> typed_payload(typer, sources, syntax, resolution, clause)
            _ -> done()
        }
    }

    machine typed_payload(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, clause: Clause) {
        type_tree(typer, sources, syntax, resolution, clause.expression);
    }

    machine reject(typer: &mut Typer, code: TypeDiagnosticCode, source_span: SourceSpan) {
        typing_reject(&mut typer.output, code, source_span);
    }

    machine invalid() {
        crash Trap;
    }

    machine done() {}
}

// Whether `satisfier`'s parameters and result are `required`'s under the
// live bindings.
machine same_satisfied_signature(
    typer: &mut Typer,
    syntax: &SyntaxTrees,
    satisfier: MachineItem,
    required: MachineItem,
    source_span: SourceSpan
) -> bool
crashes Trap
{
    transition satisfier.parameter_count == required.parameter_count {
        true -> parameter(typer, syntax, satisfier, required, source_span, 0)
        _ -> differs()
    }

    machine parameter(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        satisfier: MachineItem,
        required: MachineItem,
        source_span: SourceSpan,
        offset: u64 in Trapping
    ) -> bool {
        transition offset < satisfier.parameter_count {
            true -> compared(typer, syntax, satisfier, required, source_span, offset)
            _ -> result(typer, satisfier, required, source_span)
        }
    }

    machine compared(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        satisfier: MachineItem,
        required: MachineItem,
        source_span: SourceSpan,
        offset: u64 in Trapping
    ) -> bool {
        let own: Parameter = syntax_trees_parameter(syntax, satisfier.first_parameter + offset);
        let owed: Parameter = syntax_trees_parameter(syntax, required.first_parameter + offset);
        let own_type: u64 in Trapping = reference_type(&typer.output, own.type_reference);
        let written: u64 in Trapping = reference_type(&typer.output, owed.type_reference);
        let owed_type: u64 in Trapping = substitute_bound(typer, written, source_span);
        transition own_type == owed_type {
            true -> parameter(typer, syntax, satisfier, required, source_span, offset + 1)
            _ -> differs()
        }
    }

    machine result(typer: &mut Typer, satisfier: MachineItem, required: MachineItem, source_span: SourceSpan) -> bool {
        let own_result: u64 in Trapping = declared_result(typer, satisfier.has_return_type, satisfier.return_type, typer.output.unit);
        let written: u64 in Trapping = declared_result(typer, required.has_return_type, required.return_type, typer.output.unit);
        let owed_result: u64 in Trapping = substitute_bound(typer, written, source_span);
        own_result == owed_result
    }

    machine differs() -> bool {
        false
    }
}

// A `terminates by` witness: its subjects, then its view.
machine type_ranking(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause)
crashes Trap
{
    transition clause.has_range {
        true -> ranged(typer, sources, syntax, resolution, handle, clause)
        _ -> subject(typer, sources, syntax, resolution, handle, clause, 0)
    }

    // A rank range's endpoints are integers, an anonymous literal landing at
    // `u64` as an index range's does (wiki/spec/language/termination.md#ranking).
    machine ranged(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause) {
        type_tree(typer, sources, syntax, resolution, clause.range);
        transition { _ -> subject(typer, sources, syntax, resolution, handle, clause, 0) }
    }

    machine subject(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause, offset: u64 in Trapping) {
        transition offset < clause.argument_count && typer.output.accepted {
            true -> typed_subject(typer, sources, syntax, resolution, handle, clause, offset)
            _ -> view(typer, sources, syntax, resolution, handle, clause)
        }
    }

    machine typed_subject(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause, offset: u64 in Trapping) {
        let root: u64 in Trapping = syntax_trees_argument(syntax, clause.first_argument + offset);
        type_tree(typer, sources, syntax, resolution, root);
        transition { _ -> subject(typer, sources, syntax, resolution, handle, clause, offset + 1) }
    }

    // The view names the ranking vocabulary, not a value; only
    // `Nat::IncreasingTo`'s limit is an expression.
    machine view(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause) {
        let view: RankingView = ranking_view(resolution, handle);
        transition view {
            RankingView::IncreasingTo -> limit(typer, sources, syntax, resolution, clause)
            RankingView::Measure -> measured(typer, sources, syntax, resolution, handle, clause)
            _ -> done()
        }
    }

    // A declared measure ranks one subject: of its parameter's type, or of
    // the data a lexicographic measure's owner names
    // (wiki/spec/language/termination.md#ranking).
    machine measured(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping, clause: Clause) {
        let measure: MachineItem = machine_item(syntax, ranking_measure(resolution, handle));
        let root: u64 in Trapping = syntax_trees_argument(syntax, clause.first_argument);
        transition clause.argument_count == 1 {
            true -> subject_kind(typer, sources, syntax, measure, root)
            _ -> mismatched(typer, syntax, clause.expression)
        }
    }

    machine subject_kind(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, measure: MachineItem, root: u64 in Trapping) {
        transition measure.component_count > 0 {
            true -> owned_subject(typer, sources, syntax, measure, root)
            _ -> admitted_subject(typer, syntax, measure, root)
        }
    }

    machine admitted_subject(typer: &mut Typer, syntax: &SyntaxTrees, measure: MachineItem, root: u64 in Trapping) {
        let parameter: Parameter = syntax_trees_parameter(syntax, measure.first_parameter);
        let wanted: u64 in Trapping = reference_type(&typer.output, parameter.type_reference);
        let admitted: bool = typer_admit(typer, syntax, wanted, root, false);
    }

    machine owned_subject(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, measure: MachineItem, root: u64 in Trapping) {
        let subject: u64 in Trapping = typing_expression_type(&typer.output, root);
        let row: TypeRow = type_table_row(&typer.output.types, subject);
        transition row.kind == TypeKind::Data {
            true -> owned_data(typer, sources, syntax, measure, root, row.item)
            _ -> mismatched(typer, syntax, root)
        }
    }

    machine owned_data(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, measure: MachineItem, root: u64 in Trapping, item: u64 in Trapping) {
        let data: DataItem = syntax_trees_data_item(syntax, item);
        let same: bool = spans_equal(sources, data.name.source_span, measure.owner.source_span);
        transition same {
            true -> done()
            _ -> mismatched(typer, syntax, root)
        }
    }

    machine mismatched(typer: &mut Typer, syntax: &SyntaxTrees, handle: u64 in Trapping) {
        let written: Expression = syntax_trees_expression(syntax, handle);
        typing_reject(&mut typer.output, TypeDiagnosticCode::MismatchedTypes, written.source_span);
    }

    machine limit(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, clause: Clause) {
        let written: Expression = syntax_trees_expression(syntax, clause.expression);
        let root: u64 in Trapping = syntax_trees_argument(syntax, written.first);
        type_tree(typer, sources, syntax, resolution, root);
    }

    machine done() {}
}
