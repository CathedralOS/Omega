use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::typing::calls;
use psi::typing::generics;
use psi::typing::typer;

// Static machine binders (wiki/spec/language/generics.md, Static machine
// binder categories). A `machine F` binder with a `where machine F(...)`
// contract is called through that contract: its arguments meet the
// contract's parameters and the call has the contract's result. A call of
// a generic machine supplies each machine binder a static argument naming
// a machine or forwarding a binder of the caller's; static arguments match
// binders by kind, machines to machine binders and types to the others,
// each in order. The argument must have its binder's contract signature
// under the call's bindings, and the contract may bind the callee's other
// generic parameters from it (`U` of `map<T, U, machine F>` from `F`'s
// result). A generic machine as an argument is not supported yet.

// A callable signature: a contract's or a machine's parameters and result.
public data CallableSignature [copy] {
    present: bool;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    has_return_type: bool;
    return_type: u64 in Trapping;
}

// Whether a machine binder's argument selects a machine.
public machine Typer::selects_machine_argument(argument: MachineArgument) -> bool {
    transition argument {
        MachineArgument::Absent -> no()
        _ -> yes()
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Whether a static argument row names a machine (declared or forwarded).
public machine Typer::names_machine(syntax: &SyntaxTrees, resolution: &NameResolution, row: u64 in Trapping) -> bool
crashes Trap
{
    let argument: MachineArgument = NameResolution::machine_argument(syntax, resolution, row);
    transition argument {
        MachineArgument::Absent -> no()
        _ -> yes()
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

public machine Typer::bind_machine(typer: &mut Typer, parameter: u64 in Trapping, argument: MachineArgument)
crashes Trap
{
    transition parameter < 256 {
        true -> write(typer, parameter, argument)
        _ -> invalid()
    }

    machine write(typer: &mut Typer, parameter: u64 in Trapping, argument: MachineArgument)
    requires parameter < 256
    {
        typer.machine_bound[parameter] = argument;
        typer.machine_stamps[parameter] = typer.binding_generation as u64;
    }

    machine invalid() {
        crash Trap;
    }
}

// The argument bound to machine binder `parameter` in the live set.
public machine Typer::machine_bound(typer: &Typer, parameter: u64 in Trapping) -> MachineArgument
crashes Trap
{
    transition parameter < 256 {
        true -> read(typer, parameter)
        _ -> absent()
    }

    machine read(typer: &Typer, parameter: u64 in Trapping) -> MachineArgument
    requires parameter < 256
    {
        let stamp: u64 = typer.machine_stamps[parameter];
        transition stamp == typer.binding_generation {
            true -> live(typer, parameter)
            _ -> absent()
        }
    }

    machine live(typer: &Typer, parameter: u64 in Trapping) -> MachineArgument
    requires parameter < 256
    {
        typer.machine_bound[parameter]
    }

    machine absent() -> MachineArgument {
        MachineArgument::Absent
    }
}

// The callable contract of machine binder `parameter`, when it has one.
public machine Typer::binder_signature(syntax: &SyntaxTrees, resolution: &NameResolution, parameter: u64 in Trapping) -> CallableSignature
crashes Trap
{
    let contract: BinderContract = NameResolution::binder_contract(resolution, parameter);
    transition contract.present {
        true -> written(syntax, contract.contract)
        _ -> none()
    }

    machine written(syntax: &SyntaxTrees, handle: u64 in Trapping) -> CallableSignature {
        let declared: Contract = SyntaxTrees::contract(syntax, handle);
        CallableSignature {
            present: true,
            first_parameter: declared.first_parameter,
            parameter_count: declared.parameter_count,
            has_return_type: declared.has_return_type,
            return_type: declared.return_type
        }
    }

    machine none() -> CallableSignature {
        CallableSignature { present: false, first_parameter: 0, parameter_count: 0, has_return_type: false, return_type: 0 }
    }
}

// A machine argument's signature: a declared non-generic machine's own, a
// forwarded binder's contract.
public machine Typer::argument_signature(syntax: &SyntaxTrees, resolution: &NameResolution, argument: MachineArgument) -> CallableSignature
crashes Trap
{
    transition argument {
        MachineArgument::Declared { machine } -> declared(syntax, machine)
        MachineArgument::Forwarded { parameter } -> forwarded(syntax, resolution, parameter)
        _ -> none()
    }

    machine declared(syntax: &SyntaxTrees, machine: u64 in Trapping) -> CallableSignature {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, machine);
        transition item.generic_parameter_count == 0 {
            true -> signature(item)
            _ -> none()
        }
    }

    machine signature(item: MachineItem) -> CallableSignature {
        CallableSignature {
            present: true,
            first_parameter: item.first_parameter,
            parameter_count: item.parameter_count,
            has_return_type: item.has_return_type,
            return_type: item.return_type
        }
    }

    machine forwarded(syntax: &SyntaxTrees, resolution: &NameResolution, parameter: u64 in Trapping) -> CallableSignature {
        let signature: CallableSignature = Typer::binder_signature(syntax, resolution, parameter);
        signature
    }

    machine none() -> CallableSignature {
        CallableSignature { present: false, first_parameter: 0, parameter_count: 0, has_return_type: false, return_type: 0 }
    }
}

// A signature's result type: its declared type, else Unit.
public machine Typer::signature_result(typer: &Typer, signature: CallableSignature) -> u64 in Trapping
crashes Trap
{
    let result: u64 in Trapping = Typer::declared_result(typer, signature.has_return_type, signature.return_type, typer.output.unit);
    result
}

// A signature parameter's declared type.
public machine Typer::signature_parameter(typer: &Typer, syntax: &SyntaxTrees, signature: CallableSignature, offset: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let parameter: Parameter = SyntaxTrees::parameter(syntax, signature.first_parameter + offset);
    let handle: u64 in Trapping = Typing::reference_type(&typer.output, parameter.type_reference);
    handle
}

// Unify each machine binder's contract in `first .. first + count` with its
// bound argument's signature, binding the callee's other generic
// parameters the contract names.
public machine Typer::unify_machine_arguments(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(typer, syntax, resolution, first, count, 0) }

    machine next(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) {
        transition offset < count {
            true -> binder(typer, syntax, resolution, first, count, offset)
            _ -> done()
        }
    }

    machine binder(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) {
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, first + offset);
        let contract: CallableSignature = Typer::binder_signature(syntax, resolution, first + offset);
        let argument: MachineArgument = Typer::machine_bound(typer, first + offset);
        let signature: CallableSignature = Typer::argument_signature(syntax, resolution, argument);
        transition generic.kind == GenericParameterKind::Machine && contract.present && signature.present
            && contract.parameter_count == signature.parameter_count {
            true -> parameter(typer, syntax, resolution, first, count, offset, contract, signature, 0)
            _ -> next(typer, syntax, resolution, first, count, offset + 1)
        }
    }

    machine parameter(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature,
        index: u64 in Trapping
    ) {
        transition index < contract.parameter_count {
            true -> unified(typer, syntax, resolution, first, count, offset, contract, signature, index)
            _ -> result(typer, syntax, resolution, first, count, offset, contract, signature)
        }
    }

    machine unified(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature,
        index: u64 in Trapping
    ) {
        let wanted: u64 in Trapping = Typer::signature_parameter(typer, syntax, contract, index);
        let given: u64 in Trapping = Typer::signature_parameter(typer, syntax, signature, index);
        Typer::unify(typer, first, count, wanted, given);
        transition { _ -> parameter(typer, syntax, resolution, first, count, offset, contract, signature, index + 1) }
    }

    machine result(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature
    ) {
        let wanted: u64 in Trapping = Typer::signature_result(typer, contract);
        let given: u64 in Trapping = Typer::signature_result(typer, signature);
        Typer::unify(typer, first, count, wanted, given);
        transition { _ -> next(typer, syntax, resolution, first, count, offset + 1) }
    }

    machine done() {}
}

// Whether every machine binder in `first .. first + count` has a contract
// and an argument with exactly that signature under the live bindings:
// the same arity, and each parameter and the result equal once the
// contract's types are substituted.
public machine Typer::machine_arguments_refine(
    typer: &mut Typer,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    first: u64 in Trapping,
    count: u64 in Trapping,
    source_span: SourceSpan
) -> bool
crashes Trap
{
    transition { _ -> next(typer, syntax, resolution, first, count, source_span, 0) }

    machine next(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, source_span: SourceSpan, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> binder(typer, syntax, resolution, first, count, source_span, offset)
            _ -> refined()
        }
    }

    machine binder(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, source_span: SourceSpan, offset: u64 in Trapping) -> bool {
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, first + offset);
        transition generic.kind == GenericParameterKind::Machine {
            true -> machine(typer, syntax, resolution, first, count, source_span, offset)
            _ -> next(typer, syntax, resolution, first, count, source_span, offset + 1)
        }
    }

    machine machine(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, source_span: SourceSpan, offset: u64 in Trapping) -> bool {
        let contract: CallableSignature = Typer::binder_signature(syntax, resolution, first + offset);
        let argument: MachineArgument = Typer::machine_bound(typer, first + offset);
        let signature: CallableSignature = Typer::argument_signature(syntax, resolution, argument);
        transition contract.present && signature.present && contract.parameter_count == signature.parameter_count {
            true -> parameter(typer, syntax, resolution, first, count, source_span, offset, contract, signature, 0)
            _ -> unrefined()
        }
    }

    machine parameter(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        source_span: SourceSpan,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature,
        index: u64 in Trapping
    ) -> bool {
        transition index < contract.parameter_count {
            true -> compared(typer, syntax, resolution, first, count, source_span, offset, contract, signature, index)
            _ -> result(typer, syntax, resolution, first, count, source_span, offset, contract, signature)
        }
    }

    machine compared(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        source_span: SourceSpan,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature,
        index: u64 in Trapping
    ) -> bool {
        let wanted: u64 in Trapping = Typer::signature_parameter(typer, syntax, contract, index);
        let substituted: u64 in Trapping = Typer::substitute_bound(typer, wanted, source_span);
        let given: u64 in Trapping = Typer::signature_parameter(typer, syntax, signature, index);
        transition substituted == given {
            true -> parameter(typer, syntax, resolution, first, count, source_span, offset, contract, signature, index + 1)
            _ -> unrefined()
        }
    }

    machine result(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        source_span: SourceSpan,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature
    ) -> bool {
        let wanted: u64 in Trapping = Typer::signature_result(typer, contract);
        let substituted: u64 in Trapping = Typer::substitute_bound(typer, wanted, source_span);
        let given: u64 in Trapping = Typer::signature_result(typer, signature);
        transition substituted == given {
            true -> next(typer, syntax, resolution, first, count, source_span, offset + 1)
            _ -> unrefined()
        }
    }

    machine refined() -> bool {
        true
    }

    machine unrefined() -> bool {
        false
    }
}

// A call of machine binder `parameter`: its arguments meet its contract's
// parameters and the call has the contract's result. A binder without a
// contract cannot be called.
public machine Typer::type_binder_call(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, expression: Expression, parameter: u64 in Trapping)
crashes Trap
{
    let contract: CallableSignature = Typer::binder_signature(syntax, resolution, parameter);
    transition contract.present {
        true -> counted(typer, syntax, index, expression, parameter, contract)
        _ -> not_callable(typer, syntax, expression)
    }

    machine counted(typer: &mut Typer, syntax: &SyntaxTrees, index: u64 in Trapping, expression: Expression, parameter: u64 in Trapping, contract: CallableSignature) {
        transition contract.parameter_count == expression.count {
            true -> called(typer, syntax, index, expression, parameter, contract)
            _ -> reject(typer, expression, TypeDiagnosticCode::NoMatchingMachine)
        }
    }

    machine called(typer: &mut Typer, syntax: &SyntaxTrees, index: u64 in Trapping, expression: Expression, parameter: u64 in Trapping, contract: CallableSignature) {
        let result: u64 in Trapping = Typer::signature_result(typer, contract);
        Typing::set_selection(&mut typer.output, index, Selection::Binder { parameter: parameter });
        Typing::set_expression_type(&mut typer.output, index, result);
        Typer::bind_arguments(typer, syntax, expression, contract.first_parameter, false, 0);
    }

    machine not_callable(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression) {
        let callee: Expression = SyntaxTrees::expression(syntax, expression.left);
        Typing::reject(&mut typer.output, TypeDiagnosticCode::NotCallable, callee.source_span);
    }

    machine reject(typer: &mut Typer, expression: Expression, code: TypeDiagnosticCode) {
        Typing::reject(&mut typer.output, code, expression.source_span);
    }
}
