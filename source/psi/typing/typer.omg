// Typing over a name-resolved source set. The pass runs in fail-closed
// steps: every written type reference interns (references.omg), then each
// constant's value types against its declared type, then each
// machine body's statements type in authored order (statements.omg), each
// statement's expression trees in table order, children before parents
// (expressions.omg). An anonymous integer tree lands where its destination
// is known: a declared local, a parameter, a field, an operand of a typed
// operation, a cast or a result. The first rejection is the diagnostic.
public data Typer {
    output: Typing;
    // Which expressions have typed.
    typed: [bool; 131072];
    // Generic bindings (generics.omg): a type per generic-parameter handle,
    // live while its stamp equals `binding_generation`.
    bound: [u64; 256];
    bound_stamps: [u64; 256];
    binding_generation: u64 in Wrapping;
    // Each machine binder's selected static argument (binders.omg), live
    // while its stamp equals `binding_generation`.
    machine_bound: [MachineArgument; 256];
    machine_stamps: [u64; 256];
    // Substitution memo per type handle, live while its stamp equals
    // `memo_generation`, and the work stack substitution and unification share.
    memo: [u64; 8192];
    memo_stamps: [u64; 8192];
    memo_generation: u64 in Wrapping;
    work: [u64; 4096];
}

public machine type_check(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution)
crashes Trap
{
    typer_clear(typer, syntax);
    type_references(typer, sources, syntax, resolution);
    transition typer.output.accepted {
        true -> constants(typer, sources, syntax, resolution)
        _ -> done()
    }

    machine constants(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution) {
        type_constants(typer, sources, syntax, resolution);
        transition typer.output.accepted {
            true -> bodies(typer, sources, syntax, resolution)
            _ -> done()
        }
    }

    machine bodies(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution) {
        type_bodies(typer, sources, syntax, resolution);
        transition typer.output.accepted {
            true -> facts(typer, sources, syntax, resolution)
            _ -> done()
        }
    }

    machine facts(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution) {
        type_facts(typer, sources, syntax, resolution);
        transition typer.output.accepted {
            true -> clauses(typer, sources, syntax, resolution)
            _ -> done()
        }
    }

    machine clauses(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution) {
        type_clauses(typer, sources, syntax, resolution);
    }

    machine done() {}
}

// Empty annotations over `syntax`, with the absent row and the unit,
// Boolean and anonymous-integer types interned first.
machine typer_clear(typer: &mut Typer, syntax: &SyntaxTrees)
crashes Trap
{
    typer.output.accepted = true;
    typer.output.diagnostic.code = TypeDiagnosticCode::None;
    let absent_row: TypeRow = type_row_of(TypeKind::Absent);
    typer.output.types.rows[0] = absent_row;
    typer.output.types.row_count = 1;
    typer.output.types.argument_count = 0;
    typer.output.reference_count = 0;
    typer.output.binder_count = syntax.pattern_field_count;
    typer.output.construct_count = syntax.construct_field_count;
    typer.output.expression_count = syntax.expression_count;
    let unit_row: TypeRow = type_row_of(TypeKind::Unit);
    let unit: u64 in Trapping = type_table_intern(&mut typer.output.types, unit_row);
    let mut boolean_row: TypeRow = type_row_of(TypeKind::Builtin);
    boolean_row.builtin = BuiltinType::Bool;
    let boolean: u64 in Trapping = type_table_intern(&mut typer.output.types, boolean_row);
    let anonymous_row: TypeRow = type_row_of(TypeKind::AnonymousInteger);
    let anonymous: u64 in Trapping = type_table_intern(&mut typer.output.types, anonymous_row);
    let anonymous_float_row: TypeRow = type_row_of(TypeKind::AnonymousFloat);
    let anonymous_float: u64 in Trapping = type_table_intern(&mut typer.output.types, anonymous_float_row);
    typer.output.unit = unit;
    typer.output.boolean = boolean;
    typer.output.anonymous = anonymous;
    typer.output.anonymous_float = anonymous_float;
    transition { _ -> expression(typer, 0) }

    machine expression(typer: &mut Typer, index: u64 in Trapping) {
        transition index < typer.output.expression_count {
            true -> clear_expression(typer, index)
            _ -> binder(typer, 0)
        }
    }

    machine clear_expression(typer: &mut Typer, index: u64 in Trapping) {
        set_expression_type(&mut typer.output, index, 0);
        set_selection(&mut typer.output, index, Selection::None);
        set_adaptation(&mut typer.output, index, Adaptation::None);
        typing_set_value(&mut typer.output, index, ExactInteger { negative: false, magnitude: 0 });
        set_roster(&mut typer.output, index, 0);
        mark_typed(typer, index, false);
        transition { _ -> expression(typer, index + 1) }
    }

    machine binder(typer: &mut Typer, index: u64 in Trapping) {
        transition index < typer.output.binder_count {
            true -> clear_binder(typer, index)
            _ -> construct(typer, 0)
        }
    }

    machine clear_binder(typer: &mut Typer, index: u64 in Trapping) {
        set_binder_type(&mut typer.output, index, 0);
        set_binder_member(&mut typer.output, index, MemberTarget::Unknown);
        transition { _ -> binder(typer, index + 1) }
    }

    machine construct(typer: &mut Typer, index: u64 in Trapping) {
        transition index < typer.output.construct_count {
            true -> clear_construct(typer, index)
            _ -> done()
        }
    }

    machine clear_construct(typer: &mut Typer, index: u64 in Trapping) {
        set_construct_target(&mut typer.output, index, MemberTarget::Unknown);
        transition { _ -> construct(typer, index + 1) }
    }

    machine done() {}
}

// Each constant's value, landed at its declared type like a `let`
// initializer (wiki/spec/language/constants.md).
machine type_constants(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution)
crashes Trap
{
    transition { _ -> next(typer, sources, syntax, resolution, 0) }

    machine next(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        transition index < syntax.constant_count && typer.output.accepted {
            true -> value(typer, sources, syntax, resolution, index)
            _ -> done()
        }
    }

    machine value(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        let item: ConstantItem = constant_item(syntax, index);
        type_tree(typer, sources, syntax, resolution, item.value);
        let declared: u64 in Trapping = reference_type(&typer.output, item.type_reference);
        transition typer.output.accepted {
            true -> admit(typer, sources, syntax, resolution, index, declared, item.value)
            _ -> done()
        }
    }

    machine admit(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, declared: u64 in Trapping, value: u64 in Trapping) {
        let admitted: bool = typer_admit(typer, syntax, declared, value, false);
        transition { _ -> next(typer, sources, syntax, resolution, index + 1) }
    }

    machine done() {}
}

// Every declaration checks its own executable body and result. An omitted
// result is Unit, independent of lexical ancestry.
machine type_bodies(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution)
crashes Trap
{
    transition { _ -> next_machine(typer, sources, syntax, resolution, 0) }

    machine next_machine(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        transition index < syntax.machine_count && typer.output.accepted {
            true -> entry(typer, sources, syntax, resolution, index)
            _ -> done()
        }
    }

    machine entry(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, index);
        let result: u64 in Trapping = declared_result(typer, item.has_return_type, item.return_type, typer.output.unit);
        type_body(typer, sources, syntax, resolution, item.first_statement, item.statement_count, result);
        require_body_completion(typer, syntax, item, result);
        transition { _ -> next_machine(typer, sources, syntax, resolution, index + 1) }
    }

    machine done() {}
}

// The type a declared result reference names, or `otherwise`.
public machine declared_result(typer: &Typer, has_type: bool, reference: u64 in Trapping, otherwise: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition has_type {
        true -> declared(typer, reference)
        _ -> fallback(otherwise)
    }

    machine declared(typer: &Typer, reference: u64 in Trapping) -> u64 in Trapping {
        reference_type(&typer.output, reference)
    }

    machine fallback(otherwise: u64 in Trapping) -> u64 in Trapping {
        otherwise
    }
}

// `handle` with every reference layer removed: what `.field` and `[index]`
// project from (wiki/spec/language/expressions.md, "Dot access remains
// data-field projection").
public machine typer_referent(typer: &Typer, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let row: TypeRow = type_table_row(&typer.output.types, handle);
    transition row.kind == TypeKind::Reference {
        true -> inner(typer, row.inner)
        _ -> result(handle)
    }

    machine inner(typer: &Typer, handle: u64 in Trapping) -> u64 in Trapping {
        let row: TypeRow = type_table_row(&typer.output.types, handle);
        transition row.kind == TypeKind::Reference {
            true -> inner(typer, row.inner)
            _ -> result(handle)
        }
    }

    machine result(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// The type a value is read as: a reference to a builtin scalar, through
// every layer, reads as its referent where the scalar is needed, as a place
// of reference type denotes its referent's storage. Every traversed layer
// must permit observation: a write-only layer anywhere in the chain keeps
// the original reference type, so no scalar read is admitted. Other types
// likewise read as themselves.
public machine typer_read_type(typer: &Typer, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> referenced(typer, handle, handle, typer.output.types.row_count) }

    machine referenced(typer: &Typer, original: u64 in Trapping, handle: u64 in Trapping, remaining: u64 in Trapping) -> u64 in Trapping {
        let row: TypeRow = type_table_row(&typer.output.types, handle);
        transition row.kind == TypeKind::Reference {
            true -> layer(typer, original, row, remaining)
            _ -> scalar(original, handle, row)
        }
    }

    machine layer(typer: &Typer, original: u64 in Trapping, row: TypeRow, remaining: u64 in Trapping) -> u64 in Trapping {
        transition row.access != ReferenceAccess::WriteOnly && remaining > 0 {
            true -> referenced(typer, original, row.inner, remaining - 1)
            _ -> result(original)
        }
    }

    machine scalar(original: u64 in Trapping, handle: u64 in Trapping, row: TypeRow) -> u64 in Trapping {
        transition row.kind == TypeKind::Builtin {
            true -> result(handle)
            _ -> result(original)
        }
    }

    machine result(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// Intern a row the typer builds; a full table rejects at `source_span` and
// yields the absent type.
public machine typer_intern(typer: &mut Typer, row: TypeRow, source_span: SourceSpan) -> u64 in Trapping
crashes Trap
{
    let handle: u64 in Trapping = type_table_intern(&mut typer.output.types, row);
    transition handle > 0 {
        true -> result(handle)
        _ -> full(typer, source_span)
    }

    machine full(typer: &mut Typer, source_span: SourceSpan) -> u64 in Trapping {
        typing_reject(&mut typer.output, TypeDiagnosticCode::TypeCapacityExceeded, source_span);
        transition { _ -> result(0) }
    }

    machine result(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// Guarded scratch access: the typed marks share the expression table's
// bound, and the traversal stack its own.
public machine is_typed(typer: &Typer, index: u64 in Trapping) -> bool
crashes Trap
{
    transition index < 131072 {
        true -> read(typer, index)
        _ -> invalid()
    }

    machine read(typer: &Typer, index: u64 in Trapping) -> bool {
        typer.typed[index]
    }

    machine invalid() -> bool {
        crash Trap;
    }
}

public machine mark_typed(typer: &mut Typer, index: u64 in Trapping, typed: bool)
crashes Trap
{
    transition index < 131072 {
        true -> write(typer, index, typed)
        _ -> invalid()
    }

    machine write(typer: &mut Typer, index: u64 in Trapping, typed: bool) {
        typer.typed[index] = typed;
    }

    machine invalid() {
        crash Trap;
    }
}
