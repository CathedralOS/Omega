use psi::integers::integers;
use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::typing::admission;
use psi::typing::arrays;
use psi::typing::binders;
use psi::typing::clauses;
use psi::typing::coverage;
use psi::typing::expressions;
use psi::typing::facts;
use psi::typing::generics;
use psi::typing::joins;
use psi::typing::landing;
use psi::typing::literals;
use psi::typing::matches;
use psi::typing::memberships;
use psi::typing::references;
use psi::typing::statements;

// Typing over a name-resolved source set. The pass runs in fail-closed
// steps: every written type reference interns (references.omg), then each
// constant's value types against its declared type, then each
// machine body's statements type in authored order (statements.omg), each
// statement's expression trees in table order, children before parents
// (expressions.omg). An anonymous integer tree lands where its destination
// is known: a declared local, a parameter, a field, an operand of a typed
// operation, a cast or a result. The first rejection is the diagnostic.
pub data Typer {
    output: Typing;
    // Which expressions have typed.
    typed: [bool; 131072];
    // Generic bindings (generics.omg): a type per generic-parameter handle,
    // live while its stamp equals `binding_generation`.
    bound: [u64; 256];
    bound_stamps: [u64; 256];
    binding_generation: u64 in Wrapping;
    // Each machine binder's selected static argument (binders.omg), live
    // while its stamp equals `binding_generation`.
    machine_bound: [MachineArgument; 256];
    machine_stamps: [u64; 256];
    // Substitution memo per type handle, live while its stamp equals
    // `memo_generation`, and the work stack substitution and unification share.
    memo: [u64; 8192];
    memo_stamps: [u64; 8192];
    memo_generation: u64 in Wrapping;
    work: [u64; 4096];
}

pub machine Typer::type_check(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution)
crashes Trap
{
    Typer::clear(typer, syntax);
    Typer::type_references(typer, sources, syntax, resolution);
    transition typer.output.accepted {
        true -> constants(typer, sources, syntax, resolution)
        _ -> done()
    }

    state constants(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution) {
        Typer::type_constants(typer, sources, syntax, resolution);
        transition typer.output.accepted {
            true -> bodies(typer, sources, syntax, resolution)
            _ -> done()
        }
    }

    state bodies(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution) {
        Typer::type_bodies(typer, sources, syntax, resolution);
        transition typer.output.accepted {
            true -> facts(typer, sources, syntax, resolution)
            _ -> done()
        }
    }

    state facts(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution) {
        Typer::type_facts(typer, sources, syntax, resolution);
        transition typer.output.accepted {
            true -> clauses(typer, sources, syntax, resolution)
            _ -> done()
        }
    }

    state clauses(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution) {
        Typer::type_clauses(typer, sources, syntax, resolution);
    }

    state done() {}
}

// Empty annotations over `syntax`, with the absent row and the unit,
// Boolean and anonymous-integer types interned first.
machine Typer::clear(typer: &mut Typer, syntax: &SyntaxTrees)
crashes Trap
{
    typer.output.accepted = true;
    typer.output.diagnostic.code = TypeDiagnosticCode::None;
    let absent_row: TypeRow = TypeRow::of(TypeKind::Absent);
    typer.output.types.rows[0] = absent_row;
    typer.output.types.row_count = 1;
    typer.output.types.argument_count = 0;
    typer.output.reference_count = 0;
    typer.output.binder_count = syntax.pattern_field_count;
    typer.output.construct_count = syntax.construct_field_count;
    typer.output.expression_count = syntax.expression_count;
    let unit_row: TypeRow = TypeRow::of(TypeKind::Unit);
    let unit: u64 in Trapping = TypeTable::intern(&mut typer.output.types, unit_row);
    let mut boolean_row: TypeRow = TypeRow::of(TypeKind::Builtin);
    boolean_row.builtin = BuiltinType::Bool;
    let boolean: u64 in Trapping = TypeTable::intern(&mut typer.output.types, boolean_row);
    let anonymous_row: TypeRow = TypeRow::of(TypeKind::AnonymousInteger);
    let anonymous: u64 in Trapping = TypeTable::intern(&mut typer.output.types, anonymous_row);
    let anonymous_float_row: TypeRow = TypeRow::of(TypeKind::AnonymousFloat);
    let anonymous_float: u64 in Trapping = TypeTable::intern(&mut typer.output.types, anonymous_float_row);
    typer.output.unit = unit;
    typer.output.boolean = boolean;
    typer.output.anonymous = anonymous;
    typer.output.anonymous_float = anonymous_float;
    transition { _ -> expression(typer, 0) }

    state expression(typer: &mut Typer, index: u64 in Trapping) {
        transition index < typer.output.expression_count {
            true -> clear_expression(typer, index)
            _ -> binder(typer, 0)
        }
    }

    state clear_expression(typer: &mut Typer, index: u64 in Trapping) {
        Typing::set_expression_type(&mut typer.output, index, 0);
        Typing::set_selection(&mut typer.output, index, Selection::None);
        Typing::set_adaptation(&mut typer.output, index, Adaptation::None);
        Typing::set_value(&mut typer.output, index, ExactInteger { negative: false, magnitude: 0 });
        Typer::mark_typed(typer, index, false);
        transition { _ -> expression(typer, index + 1) }
    }

    state binder(typer: &mut Typer, index: u64 in Trapping) {
        transition index < typer.output.binder_count {
            true -> clear_binder(typer, index)
            _ -> construct(typer, 0)
        }
    }

    state clear_binder(typer: &mut Typer, index: u64 in Trapping) {
        Typing::set_binder_type(&mut typer.output, index, 0);
        Typing::set_binder_member(&mut typer.output, index, MemberTarget::Unknown);
        transition { _ -> binder(typer, index + 1) }
    }

    state construct(typer: &mut Typer, index: u64 in Trapping) {
        transition index < typer.output.construct_count {
            true -> clear_construct(typer, index)
            _ -> done()
        }
    }

    state clear_construct(typer: &mut Typer, index: u64 in Trapping) {
        Typing::set_construct_target(&mut typer.output, index, MemberTarget::Unknown);
        transition { _ -> construct(typer, index + 1) }
    }

    state done() {}
}

// Each constant's value, landed at its declared type like a `let`
// initializer (wiki/spec/language/constants.md).
machine Typer::type_constants(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution)
crashes Trap
{
    transition { _ -> next(typer, sources, syntax, resolution, 0) }

    state next(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        transition index < syntax.constant_count && typer.output.accepted {
            true -> value(typer, sources, syntax, resolution, index)
            _ -> done()
        }
    }

    state value(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        let item: ConstantItem = SyntaxTrees::constant_item(syntax, index);
        Typer::type_tree(typer, sources, syntax, resolution, item.value);
        let declared: u64 in Trapping = Typing::reference_type(&typer.output, item.type_reference);
        transition typer.output.accepted {
            true -> admit(typer, sources, syntax, resolution, index, declared, item.value)
            _ -> done()
        }
    }

    state admit(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, declared: u64 in Trapping, value: u64 in Trapping) {
        let admitted: bool = Typer::admit(typer, syntax, declared, value, false);
        transition { _ -> next(typer, sources, syntax, resolution, index + 1) }
    }

    state done() {}
}

// Each machine's entry body, then its states. A state's result is its own
// declared type or, when it declares none, the machine's: a state's terminal
// value completes the invocation (wiki/spec/language/state_contracts.md).
machine Typer::type_bodies(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution)
crashes Trap
{
    transition { _ -> next_machine(typer, sources, syntax, resolution, 0) }

    state next_machine(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        transition index < syntax.machine_count && typer.output.accepted {
            true -> entry(typer, sources, syntax, resolution, index)
            _ -> done()
        }
    }

    state entry(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let result: u64 in Trapping = Typer::declared_result(typer, item.has_return_type, item.return_type, typer.output.unit);
        Typer::type_body(typer, sources, syntax, resolution, item.first_statement, item.statement_count, result);
        transition { _ -> next_state(typer, sources, syntax, resolution, index, item, result, 0) }
    }

    state next_state(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        item: MachineItem,
        machine_result: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < item.state_count && typer.output.accepted {
            true -> state_body(typer, sources, syntax, resolution, index, item, machine_result, offset)
            _ -> next_machine(typer, sources, syntax, resolution, index + 1)
        }
    }

    state state_body(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        item: MachineItem,
        machine_result: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        let result: u64 in Trapping = Typer::declared_result(typer, state_item.has_return_type, state_item.return_type, machine_result);
        Typer::type_body(typer, sources, syntax, resolution, state_item.first_statement, state_item.statement_count, result);
        transition { _ -> next_state(typer, sources, syntax, resolution, index, item, machine_result, offset + 1) }
    }

    state done() {}
}

// The type a declared result reference names, or `otherwise`.
pub machine Typer::declared_result(typer: &Typer, has_type: bool, reference: u64 in Trapping, otherwise: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition has_type {
        true -> declared(typer, reference)
        _ -> fallback(otherwise)
    }

    state declared(typer: &Typer, reference: u64 in Trapping) -> u64 in Trapping {
        Typing::reference_type(&typer.output, reference)
    }

    state fallback(otherwise: u64 in Trapping) -> u64 in Trapping {
        otherwise
    }
}

// `handle` with every reference layer removed: what `.field` and `[index]`
// project from (wiki/spec/language/expressions.md, "Dot access remains
// data-field projection").
pub machine Typer::referent(typer: &Typer, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let row: TypeRow = TypeTable::row(&typer.output.types, handle);
    transition row.kind == TypeKind::Reference {
        true -> inner(typer, row.inner)
        _ -> result(handle)
    }

    state inner(typer: &Typer, handle: u64 in Trapping) -> u64 in Trapping {
        let row: TypeRow = TypeTable::row(&typer.output.types, handle);
        transition row.kind == TypeKind::Reference {
            true -> inner(typer, row.inner)
            _ -> result(handle)
        }
    }

    state result(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// The type a value is read as: a reference to a builtin scalar, through
// every layer, reads as its referent where the scalar is needed, as a place
// of reference type denotes its referent's storage; a write-only reference
// (wiki/spec/language/ownership.md#borrows-and-aliases) and any other type
// read as themselves.
pub machine Typer::read_type(typer: &Typer, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let row: TypeRow = TypeTable::row(&typer.output.types, handle);
    transition row.kind == TypeKind::Reference && row.access != ReferenceAccess::WriteOnly {
        true -> referenced(typer, handle)
        _ -> result(handle)
    }

    state referenced(typer: &Typer, handle: u64 in Trapping) -> u64 in Trapping {
        let referent: u64 in Trapping = Typer::referent(typer, handle);
        let row: TypeRow = TypeTable::row(&typer.output.types, referent);
        transition row.kind == TypeKind::Builtin {
            true -> result(referent)
            _ -> result(handle)
        }
    }

    state result(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// Intern a row the typer builds; a full table rejects at `source_span` and
// yields the absent type.
pub machine Typer::intern(typer: &mut Typer, row: TypeRow, source_span: SourceSpan) -> u64 in Trapping
crashes Trap
{
    let handle: u64 in Trapping = TypeTable::intern(&mut typer.output.types, row);
    transition handle > 0 {
        true -> result(handle)
        _ -> full(typer, source_span)
    }

    state full(typer: &mut Typer, source_span: SourceSpan) -> u64 in Trapping {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::TypeCapacityExceeded, source_span);
        transition { _ -> result(0) }
    }

    state result(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// Guarded scratch access: the typed marks share the expression table's
// bound, and the traversal stack its own.
pub machine Typer::is_typed(typer: &Typer, index: u64 in Trapping) -> bool
crashes Trap
{
    transition index < 131072 {
        true -> read(typer, index)
        _ -> invalid()
    }

    state read(typer: &Typer, index: u64 in Trapping) -> bool {
        typer.typed[index]
    }

    state invalid() -> bool {
        crash Trap;
    }
}

pub machine Typer::mark_typed(typer: &mut Typer, index: u64 in Trapping, typed: bool)
crashes Trap
{
    transition index < 131072 {
        true -> write(typer, index, typed)
        _ -> invalid()
    }

    state write(typer: &mut Typer, index: u64 in Trapping, typed: bool) {
        typer.typed[index] = typed;
    }

    state invalid() {
        crash Trap;
    }
}
