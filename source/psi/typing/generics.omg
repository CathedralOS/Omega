use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::typing::binders;
use psi::typing::landing;
use psi::typing::references;
use psi::typing::typer;

// Generic substitution and inference over the interned type table
// (wiki/spec/language/generics.md). Bindings map generic-parameter handles to
// types; a binding is live while its stamp equals the typer's binding
// generation, so starting a new binding set costs one increment. A data
// application binds its declaration's parameters to its arguments; a call to
// a generic machine binds the machine's parameters from explicit static
// arguments and by unifying each parameter type with its argument's type.
// Substitution rebuilds a type bottom-up: children are interned before
// parents, so a post-order walk with a per-call memo visits each distinct
// subtree once.

// A fresh binding set.
public machine Typer::begin_bindings(typer: &mut Typer) {
    typer.binding_generation = typer.binding_generation + 1;
}

public machine Typer::bind(typer: &mut Typer, parameter: u64 in Trapping, handle: u64 in Trapping)
crashes Trap
{
    transition parameter < 256 {
        true -> write(typer, parameter, handle)
        _ -> invalid()
    }

    machine write(typer: &mut Typer, parameter: u64 in Trapping, handle: u64 in Trapping) {
        typer.bound[parameter] = handle as u64;
        typer.bound_stamps[parameter] = typer.binding_generation as u64;
    }

    machine invalid() {
        crash Trap;
    }
}

// The type bound to `parameter` in the live set, or zero.
public machine Typer::bound_type(typer: &Typer, parameter: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition parameter < 256 {
        true -> read(typer, parameter)
        _ -> absent()
    }

    machine read(typer: &Typer, parameter: u64 in Trapping) -> u64 in Trapping {
        let stamp: u64 = typer.bound_stamps[parameter];
        let handle: u64 = typer.bound[parameter];
        transition stamp == typer.binding_generation {
            true -> found(handle)
            _ -> absent()
        }
    }

    machine found(handle: u64) -> u64 in Trapping {
        handle as u64 in Trapping
    }

    machine absent() -> u64 in Trapping {
        0
    }
}

// Bind the generic parameters of data type `owner`'s declaration to its
// arguments, in the order an application spells them (lifetimes aside).
public machine Typer::bind_data_arguments(typer: &mut Typer, syntax: &SyntaxTrees, owner: TypeRow)
crashes Trap
{
    transition owner.kind == TypeKind::Data && owner.argument_count > 0 {
        true -> declared(typer, syntax, owner)
        _ -> done()
    }

    machine declared(typer: &mut Typer, syntax: &SyntaxTrees, owner: TypeRow) {
        let item: DataItem = SyntaxTrees::data_item(syntax, owner.item);
        transition { _ -> next(typer, syntax, owner, item, 0, 0) }
    }

    machine next(typer: &mut Typer, syntax: &SyntaxTrees, owner: TypeRow, item: DataItem, offset: u64 in Trapping, position: u64 in Trapping) {
        transition offset < item.generic_parameter_count && position < owner.argument_count {
            true -> parameter(typer, syntax, owner, item, offset, position)
            _ -> done()
        }
    }

    machine parameter(typer: &mut Typer, syntax: &SyntaxTrees, owner: TypeRow, item: DataItem, offset: u64 in Trapping, position: u64 in Trapping) {
        let handle: u64 in Trapping = item.first_generic_parameter + offset;
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, handle);
        transition generic.kind == GenericParameterKind::Lifetime {
            true -> next(typer, syntax, owner, item, offset + 1, position)
            _ -> bound(typer, syntax, owner, item, offset, position, handle)
        }
    }

    machine bound(typer: &mut Typer, syntax: &SyntaxTrees, owner: TypeRow, item: DataItem, offset: u64 in Trapping, position: u64 in Trapping, handle: u64 in Trapping) {
        let argument: u64 in Trapping = TypeTable::argument(&typer.output.types, owner.first_argument + position);
        Typer::bind(typer, handle, argument);
        transition { _ -> next(typer, syntax, owner, item, offset + 1, position + 1) }
    }

    machine done() {}
}

// Whether every non-lifetime generic parameter in `first .. first + count`
// is bound in the live set: a machine binder to a static argument
// (binders.omg), any other to a type.
public machine Typer::all_bound(typer: &Typer, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(typer, syntax, first, count, 0) }

    machine next(typer: &Typer, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> parameter(typer, syntax, first, count, offset)
            _ -> yes()
        }
    }

    machine parameter(typer: &Typer, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, first + offset);
        let bound: u64 in Trapping = Typer::bound_type(typer, first + offset);
        let argument: MachineArgument = Typer::machine_bound(typer, first + offset);
        let selected: bool = Typer::selects_machine_argument(argument);
        let machine: bool = generic.kind == GenericParameterKind::Machine && selected;
        transition generic.kind == GenericParameterKind::Lifetime || bound > 0 || machine {
            true -> next(typer, syntax, first, count, offset + 1)
            _ -> no()
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// `handle` with every generic parameter bound in the live set replaced.
// Unbound parameters stay as written.
public machine Typer::substitute_bound(typer: &mut Typer, handle: u64 in Trapping, source_span: SourceSpan) -> u64 in Trapping
crashes Trap
{
    typer.memo_generation = typer.memo_generation + 1;
    Typer::work_store(typer, 0, handle * 2);
    transition { _ -> next(typer, handle, source_span, 1) }

    machine next(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping) -> u64 in Trapping {
        transition depth > 0 && typer.output.accepted {
            true -> visit(typer, root, source_span, depth - 1)
            _ -> result(typer, root)
        }
    }

    machine visit(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping) -> u64 in Trapping {
        let entry: u64 in Trapping = Typer::work_load(typer, depth);
        let current: u64 in Trapping = entry / 2;
        let expanded: bool = entry % 2 == 1;
        let memoized: bool = Typer::memoized(typer, current);
        transition memoized {
            true -> next(typer, root, source_span, depth)
            _ -> examine(typer, root, source_span, depth, current, expanded)
        }
    }

    machine examine(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, expanded: bool) -> u64 in Trapping {
        let row: TypeRow = TypeTable::row(&typer.output.types, current);
        transition row.kind {
            TypeKind::GenericParameter -> parameter(typer, root, source_span, depth, current, row)
            TypeKind::Reference -> wrapper(typer, root, source_span, depth, current, row, expanded)
            TypeKind::Array -> array(typer, root, source_span, depth, current, row, expanded)
            TypeKind::Slice -> wrapper(typer, root, source_span, depth, current, row, expanded)
            TypeKind::Data -> data(typer, root, source_span, depth, current, row, expanded)
            _ -> remember(typer, root, source_span, depth, current, current)
        }
    }

    machine parameter(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow) -> u64 in Trapping {
        let bound: u64 in Trapping = Typer::bound_type(typer, row.item);
        transition bound > 0 {
            true -> remember(typer, root, source_span, depth, current, bound)
            _ -> remember(typer, root, source_span, depth, current, current)
        }
    }

    machine remember(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, mapped: u64 in Trapping) -> u64 in Trapping {
        Typer::memo_store(typer, current, mapped);
        transition { _ -> next(typer, root, source_span, depth) }
    }

    // An array substitutes its element and its extent first.
    machine array(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow, expanded: bool) -> u64 in Trapping {
        transition expanded {
            true -> rearray(typer, root, source_span, depth, current, row)
            _ -> expand_array(typer, root, source_span, depth, current, row)
        }
    }

    machine expand_array(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow) -> u64 in Trapping {
        Typer::work_store(typer, depth, current * 2 + 1);
        Typer::work_store(typer, depth + 1, row.inner * 2);
        Typer::work_store(typer, depth + 2, row.length * 2);
        transition { _ -> next(typer, root, source_span, depth + 3) }
    }

    machine rearray(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow) -> u64 in Trapping {
        let inner: u64 in Trapping = Typer::memo_load(typer, row.inner);
        let length: u64 in Trapping = Typer::memo_load(typer, row.length);
        let mut wrapped: TypeRow = TypeRow::of(row.kind);
        wrapped.domain = row.domain;
        wrapped.length = length;
        wrapped.inner = inner;
        let handle: u64 in Trapping = Typer::intern(typer, wrapped, source_span);
        transition { _ -> remember(typer, root, source_span, depth, current, handle) }
    }

    // A reference or slice substitutes its one child first.
    machine wrapper(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow, expanded: bool) -> u64 in Trapping {
        transition expanded {
            true -> rewrap(typer, root, source_span, depth, current, row)
            _ -> expand_wrapper(typer, root, source_span, depth, current, row)
        }
    }

    machine expand_wrapper(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow) -> u64 in Trapping {
        Typer::work_store(typer, depth, current * 2 + 1);
        Typer::work_store(typer, depth + 1, row.inner * 2);
        transition { _ -> next(typer, root, source_span, depth + 2) }
    }

    machine rewrap(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow) -> u64 in Trapping {
        let inner: u64 in Trapping = Typer::memo_load(typer, row.inner);
        let mut wrapped: TypeRow = TypeRow::of(row.kind);
        wrapped.access = row.access;
        wrapped.domain = row.domain;
        wrapped.inner = inner;
        let handle: u64 in Trapping = Typer::intern(typer, wrapped, source_span);
        transition { _ -> remember(typer, root, source_span, depth, current, handle) }
    }

    // A data application substitutes each argument first.
    machine data(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow, expanded: bool) -> u64 in Trapping {
        transition expanded || row.argument_count == 0 {
            true -> reapply(typer, root, source_span, depth, current, row)
            _ -> expand_data(typer, root, source_span, depth, current, row)
        }
    }

    machine expand_data(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow) -> u64 in Trapping {
        Typer::work_store(typer, depth, current * 2 + 1);
        transition { _ -> push_arguments(typer, root, source_span, depth + 1, row, 0) }
    }

    machine push_arguments(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, row: TypeRow, offset: u64 in Trapping) -> u64 in Trapping {
        transition offset < row.argument_count {
            true -> push_argument(typer, root, source_span, depth, row, offset)
            _ -> next(typer, root, source_span, depth)
        }
    }

    machine push_argument(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, row: TypeRow, offset: u64 in Trapping) -> u64 in Trapping {
        let argument: u64 in Trapping = TypeTable::argument(&typer.output.types, row.first_argument + offset);
        Typer::work_store(typer, depth, argument * 2);
        transition { _ -> push_arguments(typer, root, source_span, depth + 1, row, offset + 1) }
    }

    // The arguments' substitutes become a tentative run, interned with the
    // declaration as a new application (or the existing equal one).
    machine reapply(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow) -> u64 in Trapping {
        let first: u64 in Trapping = typer.output.types.argument_count as u64 in Trapping;
        transition { _ -> reapply_argument(typer, root, source_span, depth, current, row, first, 0) }
    }

    machine reapply_argument(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow, first: u64 in Trapping, offset: u64 in Trapping) -> u64 in Trapping {
        transition offset < row.argument_count {
            true -> reapply_push(typer, root, source_span, depth, current, row, first, offset)
            _ -> reapplied(typer, root, source_span, depth, current, row, first)
        }
    }

    machine reapply_push(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow, first: u64 in Trapping, offset: u64 in Trapping) -> u64 in Trapping {
        let argument: u64 in Trapping = TypeTable::argument(&typer.output.types, row.first_argument + offset);
        let mapped: u64 in Trapping = Typer::memo_load(typer, argument);
        let kept: bool = TypeTable::push_argument(&mut typer.output.types, mapped);
        transition kept {
            true -> reapply_argument(typer, root, source_span, depth, current, row, first, offset + 1)
            _ -> full(typer, source_span)
        }
    }

    machine reapplied(typer: &mut Typer, root: u64 in Trapping, source_span: SourceSpan, depth: u64 in Trapping, current: u64 in Trapping, row: TypeRow, first: u64 in Trapping) -> u64 in Trapping {
        let mut applied: TypeRow = TypeRow::of(TypeKind::Data);
        applied.item = row.item;
        applied.first_argument = first;
        applied.argument_count = row.argument_count;
        let handle: u64 in Trapping = Typer::intern(typer, applied, source_span);
        transition { _ -> remember(typer, root, source_span, depth, current, handle) }
    }

    machine full(typer: &mut Typer, source_span: SourceSpan) -> u64 in Trapping {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::TypeCapacityExceeded, source_span);
        transition { _ -> failed() }
    }

    machine failed() -> u64 in Trapping {
        0
    }

    machine result(typer: &mut Typer, root: u64 in Trapping) -> u64 in Trapping {
        let mapped: u64 in Trapping = Typer::memo_load(typer, root);
        mapped
    }
}

// Unify a parameter type with an argument's type, binding each generic
// parameter in `first .. first + count` the first time the walk meets it. A
// shared-reference parameter matches an owned argument by its referent, as
// implicit lending admits it. Conflicts are not reported here: the caller
// admits each argument at the substituted parameter type afterwards.
public machine Typer::unify(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, parameter: u64 in Trapping, argument: u64 in Trapping)
crashes Trap
{
    Typer::work_store(typer, 0, parameter);
    Typer::work_store(typer, 1, argument);
    transition { _ -> next(typer, first, count, 2) }

    machine next(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping) {
        transition depth >= 2 {
            true -> pair(typer, first, count, depth - 2)
            _ -> done()
        }
    }

    machine pair(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping) {
        let wanted: u64 in Trapping = Typer::work_load(typer, depth);
        let given: u64 in Trapping = Typer::work_load(typer, depth + 1);
        let wanted_row: TypeRow = TypeTable::row(&typer.output.types, wanted);
        let given_row: TypeRow = TypeTable::row(&typer.output.types, given);
        transition wanted_row.kind {
            TypeKind::GenericParameter -> parameter(typer, first, count, depth, wanted_row, given)
            TypeKind::Reference -> reference(typer, first, count, depth, wanted_row, given_row, given)
            TypeKind::Array -> array(typer, first, count, depth, wanted_row, given_row)
            TypeKind::Slice -> collection(typer, first, count, depth, wanted_row, given_row)
            TypeKind::Data -> data(typer, first, count, depth, wanted_row, given_row, 0)
            _ -> next(typer, first, count, depth)
        }
    }

    machine parameter(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping, wanted_row: TypeRow, given: u64 in Trapping) {
        let bound: u64 in Trapping = Typer::bound_type(typer, wanted_row.item);
        let unlanded: bool = Typer::unlanded(typer, given);
        let concrete: bool = given > 0 && !unlanded;
        transition wanted_row.item >= first && wanted_row.item < first + count && bound == 0 && concrete {
            true -> bind(typer, first, count, depth, wanted_row, given)
            _ -> next(typer, first, count, depth)
        }
    }

    machine bind(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping, wanted_row: TypeRow, given: u64 in Trapping) {
        Typer::bind(typer, wanted_row.item, given);
        transition { _ -> next(typer, first, count, depth) }
    }

    machine reference(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping, wanted_row: TypeRow, given_row: TypeRow, given: u64 in Trapping) {
        transition given_row.kind == TypeKind::Reference {
            true -> push(typer, first, count, depth, wanted_row.inner, given_row.inner)
            _ -> lent(typer, first, count, depth, wanted_row, given)
        }
    }

    machine lent(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping, wanted_row: TypeRow, given: u64 in Trapping) {
        transition wanted_row.access == ReferenceAccess::Shared {
            true -> push(typer, first, count, depth, wanted_row.inner, given)
            _ -> next(typer, first, count, depth)
        }
    }

    // An array's extent unifies too, binding a `const` parameter from a
    // given static extent.
    machine array(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping, wanted_row: TypeRow, given_row: TypeRow) {
        transition given_row.kind == TypeKind::Array {
            true -> extents(typer, first, count, depth, wanted_row, given_row)
            _ -> next(typer, first, count, depth)
        }
    }

    machine extents(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping, wanted_row: TypeRow, given_row: TypeRow) {
        Typer::work_store(typer, depth, wanted_row.length);
        Typer::work_store(typer, depth + 1, given_row.length);
        transition { _ -> push(typer, first, count, depth + 2, wanted_row.inner, given_row.inner) }
    }

    machine collection(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping, wanted_row: TypeRow, given_row: TypeRow) {
        transition given_row.kind == wanted_row.kind {
            true -> push(typer, first, count, depth, wanted_row.inner, given_row.inner)
            _ -> next(typer, first, count, depth)
        }
    }

    machine data(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping, wanted_row: TypeRow, given_row: TypeRow, offset: u64 in Trapping) {
        transition given_row.kind == TypeKind::Data && given_row.item == wanted_row.item
            && given_row.argument_count == wanted_row.argument_count && offset < wanted_row.argument_count {
            true -> data_argument(typer, first, count, depth, wanted_row, given_row, offset)
            _ -> next(typer, first, count, depth)
        }
    }

    machine data_argument(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping, wanted_row: TypeRow, given_row: TypeRow, offset: u64 in Trapping) {
        let wanted: u64 in Trapping = TypeTable::argument(&typer.output.types, wanted_row.first_argument + offset);
        let given: u64 in Trapping = TypeTable::argument(&typer.output.types, given_row.first_argument + offset);
        Typer::work_store(typer, depth, wanted);
        Typer::work_store(typer, depth + 1, given);
        transition { _ -> data(typer, first, count, depth + 2, wanted_row, given_row, offset + 1) }
    }

    machine push(typer: &mut Typer, first: u64 in Trapping, count: u64 in Trapping, depth: u64 in Trapping, wanted: u64 in Trapping, given: u64 in Trapping) {
        Typer::work_store(typer, depth, wanted);
        Typer::work_store(typer, depth + 1, given);
        transition { _ -> next(typer, first, count, depth + 2) }
    }

    machine done() {}
}

// Guarded scratch access for substitution and unification.
machine Typer::work_store(typer: &mut Typer, depth: u64 in Trapping, value: u64 in Trapping)
crashes Trap
{
    transition depth < 4096 {
        true -> write(typer, depth, value)
        _ -> invalid()
    }

    machine write(typer: &mut Typer, depth: u64 in Trapping, value: u64 in Trapping) {
        typer.work[depth] = value as u64;
    }

    machine invalid() {
        crash Trap;
    }
}

machine Typer::work_load(typer: &Typer, depth: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition depth < 4096 {
        true -> read(typer, depth)
        _ -> invalid()
    }

    machine read(typer: &Typer, depth: u64 in Trapping) -> u64 in Trapping {
        typer.work[depth] as u64 in Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

machine Typer::memoized(typer: &Typer, handle: u64 in Trapping) -> bool
crashes Trap
{
    transition handle < 8192 {
        true -> read(typer, handle)
        _ -> invalid()
    }

    machine read(typer: &Typer, handle: u64 in Trapping) -> bool {
        let stamp: u64 = typer.memo_stamps[handle];
        stamp == typer.memo_generation
    }

    machine invalid() -> bool {
        crash Trap;
    }
}

machine Typer::memo_load(typer: &Typer, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let memoized: bool = Typer::memoized(typer, handle);
    transition memoized && handle < 8192 {
        true -> read(typer, handle)
        _ -> unchanged(handle)
    }

    machine read(typer: &Typer, handle: u64 in Trapping) -> u64 in Trapping {
        typer.memo[handle] as u64 in Trapping
    }

    machine unchanged(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

machine Typer::memo_store(typer: &mut Typer, handle: u64 in Trapping, mapped: u64 in Trapping)
crashes Trap
{
    transition handle < 8192 {
        true -> write(typer, handle, mapped)
        _ -> invalid()
    }

    machine write(typer: &mut Typer, handle: u64 in Trapping, mapped: u64 in Trapping) {
        typer.memo[handle] = mapped as u64;
        typer.memo_stamps[handle] = typer.memo_generation as u64;
    }

    machine invalid() {
        crash Trap;
    }
}
