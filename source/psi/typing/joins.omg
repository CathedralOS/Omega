use psi::syntax::syntax;
use psi::types::types;
use psi::typing::admission;
use psi::typing::landing;
use psi::typing::statements;
use psi::typing::typer;

// The values one expression joins into one type: a value-position match's
// arm values and a fixed-array literal's elements (wiki/spec/language/
// patterns.md, "compatible arm values"). The first value of a fixed type
// gives the join its type, and every other value has that type, lands there
// as an unlanded value, or is `Never`; a value qualified differently, or one
// that would meet it only by a loan or a membership, is incompatible. When
// no value fixes a type, the values are unlanded and share one shape:
// anonymous numbers and choices join as an anonymous choice, and anonymous
// arrays of one shape as that array (landing.omg).

// The type of the first value of a fixed type, or zero.
public machine Typer::fixed_join(typer: &Typer, syntax: &SyntaxTrees, values: JoinedValues) -> u64 in Trapping
crashes Trap
{
    transition { _ -> value(typer, syntax, values, 0) }

    machine value(typer: &Typer, syntax: &SyntaxTrees, values: JoinedValues, offset: u64 in Trapping) -> u64 in Trapping {
        transition offset < values.count {
            true -> candidate(typer, syntax, values, offset)
            _ -> found(0)
        }
    }

    machine candidate(typer: &Typer, syntax: &SyntaxTrees, values: JoinedValues, offset: u64 in Trapping) -> u64 in Trapping {
        let handle: u64 in Trapping = SyntaxTrees::joined_value(syntax, values, offset);
        let value_type: u64 in Trapping = Typing::expression_type(&typer.output, handle);
        let unlanded: bool = Typer::unlanded(typer, value_type);
        let never: bool = Typer::never_type(typer, value_type);
        transition unlanded || never {
            true -> value(typer, syntax, values, offset + 1)
            _ -> found(value_type)
        }
    }

    machine found(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// Each value meets the join's type exactly, by landing there, or as `Never`.
public machine Typer::admit_joined(typer: &mut Typer, syntax: &SyntaxTrees, values: JoinedValues, result_type: u64 in Trapping)
crashes Trap
{
    transition { _ -> value(typer, syntax, values, result_type, 0) }

    machine value(typer: &mut Typer, syntax: &SyntaxTrees, values: JoinedValues, result_type: u64 in Trapping, offset: u64 in Trapping) {
        transition offset < values.count && typer.output.accepted {
            true -> admission(typer, syntax, values, result_type, offset)
            _ -> done()
        }
    }

    machine admission(typer: &mut Typer, syntax: &SyntaxTrees, values: JoinedValues, result_type: u64 in Trapping, offset: u64 in Trapping) {
        let handle: u64 in Trapping = SyntaxTrees::joined_value(syntax, values, offset);
        let admission: Admission = Typer::admission(typer, syntax, result_type, handle);
        transition admission {
            Admission::Exact -> value(typer, syntax, values, result_type, offset + 1)
            Admission::Landed -> landed(typer, syntax, values, result_type, offset, handle)
            _ -> incompatible(typer, syntax, handle, admission)
        }
    }

    machine landed(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        values: JoinedValues,
        result_type: u64 in Trapping,
        offset: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        let admitted: bool = Typer::admit(typer, syntax, result_type, handle, false);
        transition { _ -> value(typer, syntax, values, result_type, offset + 1) }
    }

    machine incompatible(typer: &mut Typer, syntax: &SyntaxTrees, handle: u64 in Trapping, admission: Admission) {
        let value: Expression = SyntaxTrees::expression(syntax, handle);
        transition admission {
            Admission::OutOfRange -> rejected(typer, value, TypeDiagnosticCode::LiteralOutOfRange)
            Admission::Fraction -> rejected(typer, value, TypeDiagnosticCode::AnonymousFraction)
            _ -> rejected(typer, value, TypeDiagnosticCode::MismatchedTypes)
        }
    }

    machine rejected(typer: &mut Typer, value: Expression, code: TypeDiagnosticCode) {
        Typing::reject(&mut typer.output, code, value.source_span);
    }

    machine done() {}
}

// The unlanded type values of no fixed type share: an anonymous choice for
// anonymous numbers and choices, one anonymous array type for anonymous
// arrays, or, when every value is `Never`, the first value's type. A value
// whose shape differs from those before it is named, its handle plus one.
public data UnlandedJoin [copy] {
    joined: u64 in Trapping;
    mismatch: u64 in Trapping;
}

public machine Typer::unlanded_join(typer: &mut Typer, syntax: &SyntaxTrees, values: JoinedValues) -> UnlandedJoin
crashes Trap
{
    let choice_row: TypeRow = TypeRow::of(TypeKind::AnonymousChoice);
    let choice: u64 in Trapping = TypeTable::intern(&mut typer.output.types, choice_row);
    transition { _ -> value(typer, syntax, values, choice, 0, 0) }

    machine value(typer: &mut Typer, syntax: &SyntaxTrees, values: JoinedValues, choice: u64 in Trapping, shape: u64 in Trapping, offset: u64 in Trapping) -> UnlandedJoin {
        transition offset < values.count {
            true -> candidate(typer, syntax, values, choice, shape, offset)
            _ -> finished(typer, syntax, values, shape)
        }
    }

    machine candidate(typer: &mut Typer, syntax: &SyntaxTrees, values: JoinedValues, choice: u64 in Trapping, shape: u64 in Trapping, offset: u64 in Trapping) -> UnlandedJoin {
        let handle: u64 in Trapping = SyntaxTrees::joined_value(syntax, values, offset);
        let value_type: u64 in Trapping = Typing::expression_type(&typer.output, handle);
        let row: TypeRow = TypeTable::row(&typer.output.types, value_type);
        let value_shape: u64 in Trapping = Typer::scalar_or_array(row, value_type, choice);
        transition value_shape == 0 || value_shape == shape {
            true -> value(typer, syntax, values, choice, shape, offset + 1)
            _ -> differing(typer, syntax, values, choice, shape, offset, handle, value_shape)
        }
    }

    machine differing(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        values: JoinedValues,
        choice: u64 in Trapping,
        shape: u64 in Trapping,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        value_shape: u64 in Trapping
    ) -> UnlandedJoin {
        transition shape == 0 {
            true -> value(typer, syntax, values, choice, value_shape, offset + 1)
            _ -> mismatched(handle)
        }
    }

    machine finished(typer: &mut Typer, syntax: &SyntaxTrees, values: JoinedValues, shape: u64 in Trapping) -> UnlandedJoin {
        let first: u64 in Trapping = SyntaxTrees::joined_value(syntax, values, 0);
        let first_type: u64 in Trapping = Typing::expression_type(&typer.output, first);
        transition shape > 0 {
            true -> joined(shape)
            _ -> joined(first_type)
        }
    }

    machine joined(handle: u64 in Trapping) -> UnlandedJoin {
        UnlandedJoin { joined: handle, mismatch: 0 }
    }

    machine mismatched(handle: u64 in Trapping) -> UnlandedJoin {
        UnlandedJoin { joined: 0, mismatch: handle + 1 }
    }
}

// An unlanded value's shape: the anonymous choice for a scalar, its own type
// for an anonymous array; zero for `Never`.
machine Typer::scalar_or_array(row: TypeRow, handle: u64 in Trapping, choice: u64 in Trapping) -> u64 in Trapping {
    transition row.kind {
        TypeKind::AnonymousArray -> shaped(handle)
        TypeKind::AnonymousInteger -> shaped(choice)
        TypeKind::AnonymousFloat -> shaped(choice)
        TypeKind::AnonymousChoice -> shaped(choice)
        _ -> shaped(0)
    }

    machine shaped(shape: u64 in Trapping) -> u64 in Trapping {
        shape
    }
}
