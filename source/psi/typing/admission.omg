// Admission preserves the exact declared domain set. Expected types choose
// carriers for anonymous values; adding, retaining or removing a domain is an
// explicit cast. Ordinary borrowing and array-to-slice views retain their
// independent access and storage rules.
// An unlanded match or array literal (landing.omg) lands where each
// anonymous number among its values would, at a destination of its shape.
public data Admission [copy] {
    case Rejected;
    case NotAValue;
    case OutOfRange;
    case Exact;
    case Landed;
    case SharedLend;
    // An existing reference attenuated to shared access; no new value borrow.
    case SharedReborrow;
    case Qualified;
    case Read;
    // An anonymous value with a fractional part at an integer destination.
    case Fraction;
    case FractionalIntermediate;
}

public machine typer_admission(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping) -> Admission
crashes Trap
{
    let actual: u64 in Trapping = typing_expression_type(&typer.output, expression);
    transition actual > 0 {
        true -> valued(typer, syntax, destination, expression, actual)
        _ -> not_a_value()
    }

    machine valued(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, actual: u64 in Trapping) -> Admission {
        transition actual == destination {
            true -> exact()
            _ -> different(typer, syntax, destination, expression, actual)
        }
    }

    machine different(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, actual: u64 in Trapping) -> Admission {
        let read: u64 in Trapping = typer_read_type(typer, actual);
        transition read != actual && read == destination {
            true -> reading()
            _ -> kinds(typer, syntax, destination, expression, actual)
        }
    }

    machine kinds(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, actual: u64 in Trapping) -> Admission {
        let wanted: TypeRow = type_table_row(&typer.output.types, destination);
        let given: TypeRow = type_table_row(&typer.output.types, actual);
        transition given.kind {
            TypeKind::AnonymousInteger -> literal(typer, expression, wanted)
            TypeKind::AnonymousFloat -> literal(typer, expression, wanted)
            TypeKind::AnonymousChoice -> unlanded(typer, syntax, destination, expression)
            TypeKind::AnonymousArray -> unlanded(typer, syntax, destination, expression)
            _ -> quoted(typer, syntax, wanted, given, actual, expression)
        }
    }

    machine quoted(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        let written: Expression = syntax_trees_expression(syntax, expression);
        transition written.kind == ExpressionKind::String && wanted.kind == TypeKind::Array {
            true -> copied(typer, expression, wanted)
            _ -> typed(typer, syntax, wanted, given, actual, expression)
        }
    }

    machine copied(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow) -> Admission {
        let element: TypeRow = type_table_row(&typer.output.types, wanted.inner);
        let extent: TypeRow = type_table_row(&typer.output.types, wanted.length);
        let length: ExactInteger = typing_value(&typer.output, expression);
        let bytes: bool = element.kind == TypeKind::Builtin && element.builtin == BuiltinType::U8
            && element.domain == DomainBinding::Unqualified;
        let exact: bool = extent.kind == TypeKind::StaticInteger && extent.length == (length.magnitude as u64 in Trapping);
        transition bytes && wanted.domain == DomainBinding::Unqualified && exact {
            true -> landed()
            _ -> rejected()
        }
    }

    machine literal(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow) -> Admission {
        let admission: Admission = literal_admission(typer, expression, wanted);
        admission
    }

    machine unlanded(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        let landing: Landing = typer_landing(typer, syntax, destination, expression);
        landing.admission
    }

    machine typed(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        transition given.kind == TypeKind::Builtin && given.builtin == BuiltinType::Never {
            true -> exact()
            _ -> carried(typer, syntax, wanted, given, actual, expression)
        }
    }

    machine carried(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        let same: bool = same_carrier(&typer.output.types, wanted, given);
        transition same {
            true -> rejected()
            _ -> lending(typer, syntax, wanted, given, actual, expression)
        }
    }

    machine lending(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        transition wanted.kind == TypeKind::Reference {
            true -> referenced(typer, syntax, wanted, given, actual, expression)
            _ -> unapplied(syntax, wanted, given)
        }
    }

    // A reference to a whole array views it as a slice of its elements,
    // a shared view from either reference.
    machine referenced(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        let expands_write_only: bool = given.kind == TypeKind::Reference && given.access == ReferenceAccess::WriteOnly
            && wanted.access != ReferenceAccess::WriteOnly;
        transition expands_write_only {
            true -> rejected()
            false -> viewed(typer, wanted, given, actual)
        }
    }

    // Access authority is settled before array/slice representation: a
    // write-only reference cannot acquire read authority through a view.
    machine viewed(typer: &Typer, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping) -> Admission {
        let viewed: bool = views_array(typer, wanted, given);
        transition viewed {
            true -> reference_adaptation(wanted, given)
            false -> access(wanted, given, actual)
        }
    }

    // A bare range meets only a shared-reference destination: a mutable
    // subrange is written `&mut items[start..end]`, and an expected
    // `&mut [T]` never inserts the borrow
    // (wiki/spec/language/expressions.md#borrowed-range-access).
    machine access(wanted: TypeRow, given: TypeRow, actual: u64 in Trapping) -> Admission {
        transition wanted.access == ReferenceAccess::Shared {
            true -> shared(wanted, given, actual)
            _ -> attenuating(wanted, given)
        }
    }

    // A `&write T` destination carries a mutable reference to `T`; whether
    // the attenuation is spelled `&write` at the argument is judged where
    // the admission is bound (`typer_admit`), so a candidate taking it is
    // selected and its unspelled attenuation is named, not a missing
    // machine.
    machine attenuating(wanted: TypeRow, given: TypeRow) -> Admission {
        let mutable: bool = given.kind == TypeKind::Reference && given.access == ReferenceAccess::Mutable
            && given.inner == wanted.inner;
        transition wanted.access == ReferenceAccess::WriteOnly && mutable {
            true -> exact()
            _ -> rejected()
        }
    }

    machine shared(wanted: TypeRow, given: TypeRow, actual: u64 in Trapping) -> Admission {
        transition actual == wanted.inner {
            true -> lend()
            _ -> reborrow(wanted, given)
        }
    }

    machine reborrow(wanted: TypeRow, given: TypeRow) -> Admission {
        transition given.kind == TypeKind::Reference && given.inner == wanted.inner {
            true -> reference_adaptation(wanted, given)
            _ -> rejected()
        }
    }

    // Keep the selected shared access on the admitted value. The caller may
    // forward an existing descriptor, but this use lends its referent shared.
    machine reference_adaptation(wanted: TypeRow, given: TypeRow) -> Admission {
        transition wanted.access == ReferenceAccess::Shared && given.access == ReferenceAccess::Mutable {
            true -> shared_reborrow()
            false -> exact()
        }
    }

    machine shared_reborrow() -> Admission { Admission::SharedReborrow }

    machine unapplied(syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow) -> Admission {
        transition wanted.kind == TypeKind::Data && given.kind == TypeKind::Data && wanted.item == given.item
            && given.argument_count == 0 {
            true -> generic_data(syntax, wanted)
            _ -> rejected()
        }
    }

    machine generic_data(syntax: &SyntaxTrees, wanted: TypeRow) -> Admission {
        let applied: u64 in Trapping = applied_parameter_count(syntax, wanted.item);
        transition applied > 0 {
            true -> exact()
            _ -> rejected()
        }
    }

    machine exact() -> Admission {
        Admission::Exact
    }

    machine landed() -> Admission {
        Admission::Landed
    }

    machine lend() -> Admission {
        Admission::SharedLend
    }

    machine reading() -> Admission {
        Admission::Read
    }

    machine rejected() -> Admission {
        Admission::Rejected
    }

    machine out_of_range() -> Admission {
        Admission::OutOfRange
    }

    machine not_a_value() -> Admission {
        Admission::NotAValue
    }
}

// An anonymous number, `expression`, at a destination of row `wanted`: it
// lands at a float format by one rounding, and an anonymous integer at a
// fixed integer it fits.
public machine literal_admission(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow) -> Admission
crashes Trap
{
    let actual: u64 in Trapping = typing_expression_type(&typer.output, expression);
    let float_destination: bool = wanted.kind == TypeKind::Builtin
        && (wanted.builtin == BuiltinType::F32 || wanted.builtin == BuiltinType::F64);
    transition wanted.domain == DomainBinding::Unqualified {
        true -> unqualified(typer, expression, wanted, actual, float_destination)
        _ -> rejected()
    }

    machine unqualified(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow, actual: u64 in Trapping, float_destination: bool) -> Admission {
        transition float_destination {
            true -> landed()
            _ -> integer_literal(typer, expression, wanted, actual)
        }
    }

    machine integer_literal(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow, actual: u64 in Trapping) -> Admission {
        transition actual == typer.output.anonymous {
            true -> anonymous(typer, expression, wanted)
            _ -> rejected()
        }
    }

    // Integer landing requires an integral, in-range value
    // (wiki/spec/language/numeric_values.md).
    machine anonymous(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow) -> Admission {
        let value: ExactInteger = typing_value(&typer.output, expression);
        let denominator: u64 in Trapping = typing_denominator(&typer.output, expression);
        let fixed: bool = fixed_integer(wanted.builtin);
        let fits: bool = exact_integer_fits(wanted.builtin, value);
        transition wanted.kind == TypeKind::Builtin && fixed {
            true -> landing(fits, denominator == 1, typing_fractional_origin(&typer.output, expression))
            _ -> rejected()
        }
    }

    machine landing(fits: bool, integral: bool, origin: u64 in Trapping) -> Admission {
        transition integral {
            true -> acknowledged(fits, origin)
            _ -> fraction()
        }
    }

    machine acknowledged(fits: bool, origin: u64 in Trapping) -> Admission {
        transition origin == 0 {
            true -> ranged(fits)
            _ -> fractional_intermediate()
        }
    }

    machine fractional_intermediate() -> Admission { Admission::FractionalIntermediate }

    machine ranged(fits: bool) -> Admission {
        transition fits {
            true -> landed()
            _ -> out_of_range()
        }
    }

    machine fraction() -> Admission {
        Admission::Fraction
    }

    machine landed() -> Admission {
        Admission::Landed
    }

    machine rejected() -> Admission {
        Admission::Rejected
    }

    machine out_of_range() -> Admission {
        Admission::OutOfRange
    }
}

// Admit `expression` at `destination`, recording a landing or an implicit
// shared loan (only where `lend` allows one: a call argument), or reject at
// the expression, or at an unlanded value's number that does not land.
// Whether it was admitted.
public machine typer_admit(typer: &mut Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, lend: bool) -> bool
crashes Trap
{
    let admission: Admission = typer_admission(typer, syntax, destination, expression);
    let actual: u64 in Trapping = typing_expression_type(&typer.output, expression);
    let given: TypeRow = type_table_row(&typer.output.types, actual);
    let chosen: bool = given.kind == TypeKind::AnonymousChoice || given.kind == TypeKind::AnonymousArray;
    let blamed: u64 in Trapping = blamed_value(typer, syntax, destination, expression, chosen && admission != Admission::Landed);
    let written: Expression = syntax_trees_expression(syntax, blamed);
    let wanted: TypeRow = type_table_row(&typer.output.types, destination);
    let spelled: Expression = syntax_trees_expression(syntax, expression);
    let write_only: bool = wanted.kind == TypeKind::Reference && wanted.access == ReferenceAccess::WriteOnly;
    let attenuated: bool = spelled.kind == ExpressionKind::Unary && spelled.operator == OperatorKind::BorrowWrite;
    transition write_only && !attenuated {
        true -> reject(typer, spelled, TypeDiagnosticCode::ImplicitAttenuation)
        _ -> judged(typer, syntax, destination, expression, lend, admission, chosen, written, blamed)
    }

    // A `&write` destination is met only by a `&write` borrow: attenuation
    // from mutable access, and forwarding, are spelled at the argument
    // (wiki/spec/language/expressions.md#calls-places-and-temporaries).
    machine judged(typer: &mut Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, lend: bool, admission: Admission, chosen: bool, written: Expression, blamed: u64 in Trapping) -> bool {
        transition admission {
            Admission::Exact -> admitted()
            Admission::Landed -> landing(typer, syntax, destination, expression, chosen)
            Admission::SharedLend -> lent(typer, syntax, written, expression, lend)
            Admission::SharedReborrow -> mark_lent(typer, expression)
            Admission::Qualified -> qualified(typer, expression)
            Admission::Read -> read(typer, expression)
            Admission::OutOfRange -> reject(typer, written, TypeDiagnosticCode::LiteralOutOfRange)
            Admission::Fraction -> reject(typer, written, TypeDiagnosticCode::AnonymousFraction)
            Admission::FractionalIntermediate -> fractional_origin(typer, syntax, blamed)
            Admission::NotAValue -> reject(typer, written, TypeDiagnosticCode::NotAValue)
            Admission::Rejected -> reject(typer, written, TypeDiagnosticCode::MismatchedTypes)
        }
    }

    machine fractional_origin(typer: &mut Typer, syntax: &SyntaxTrees, blamed: u64 in Trapping) -> bool {
        let origin: u64 in Trapping = typing_fractional_origin(&typer.output, blamed);
        transition origin > 0 {
            true -> origin_span(typer, syntax, origin - 1)
            _ -> invalid_origin()
        }
    }

    machine origin_span(typer: &mut Typer, syntax: &SyntaxTrees, origin: u64 in Trapping) -> bool {
        let written: Expression = syntax_trees_expression(syntax, origin);
        transition { _ -> reject(typer, written, TypeDiagnosticCode::FractionalIntermediate) }
    }

    machine invalid_origin() -> bool { crash Trap; }

    machine landing(typer: &mut Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, chosen: bool) -> bool {
        transition chosen {
            true -> chosen_arms(typer, syntax, destination, expression)
            _ -> landed(typer, destination, expression)
        }
    }

    machine landed(typer: &mut Typer, destination: u64 in Trapping, expression: u64 in Trapping) -> bool {
        set_expression_type(&mut typer.output, expression, destination);
        set_adaptation(&mut typer.output, expression, Adaptation::Landed);
        transition { _ -> admitted() }
    }

    machine chosen_arms(typer: &mut Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping) -> bool {
        typer_land(typer, syntax, destination, expression);
        transition { _ -> admitted() }
    }

    // A call argument lends implicitly; elsewhere only a range slice, a
    // view of its collection.
    machine lent(typer: &mut Typer, syntax: &SyntaxTrees, written: Expression, expression: u64 in Trapping, lend: bool) -> bool {
        let selector: Expression = syntax_trees_expression(syntax, written.right);
        let sliced: bool = written.kind == ExpressionKind::Index && selector.kind == ExpressionKind::Range;
        transition lend || sliced {
            true -> mark_lent(typer, expression)
            _ -> reject(typer, written, TypeDiagnosticCode::MismatchedTypes)
        }
    }

    machine qualified(typer: &mut Typer, expression: u64 in Trapping) -> bool {
        set_adaptation(&mut typer.output, expression, Adaptation::Qualified);
        transition { _ -> admitted() }
    }

    machine read(typer: &mut Typer, expression: u64 in Trapping) -> bool {
        set_adaptation(&mut typer.output, expression, Adaptation::Read);
        transition { _ -> admitted() }
    }

    machine mark_lent(typer: &mut Typer, expression: u64 in Trapping) -> bool {
        set_adaptation(&mut typer.output, expression, Adaptation::SharedLend);
        transition { _ -> admitted() }
    }

    machine reject(typer: &mut Typer, written: Expression, code: TypeDiagnosticCode) -> bool {
        typing_reject(&mut typer.output, code, written.source_span);
        transition { _ -> refused() }
    }

    machine admitted() -> bool {
        true
    }

    machine refused() -> bool {
        false
    }
}

// The value a refused admission names: an unlanded value's first number
// that does not land, else the expression itself.
machine blamed_value(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, chosen: bool) -> u64 in Trapping
crashes Trap
{
    transition chosen {
        true -> arm(typer, syntax, destination, expression)
        _ -> found(expression)
    }

    machine arm(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping) -> u64 in Trapping {
        let landing: Landing = typer_landing(typer, syntax, destination, expression);
        transition { _ -> found(landing.value) }
    }

    machine found(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// Whether `expression` would be admitted at `destination`, lending allowed:
// the test overload selection applies to each candidate.
public machine admissible(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping) -> bool
crashes Trap
{
    let admission: Admission = typer_admission(typer, syntax, destination, expression);
    transition admission {
        Admission::Exact -> yes()
        Admission::Landed -> yes()
        Admission::SharedLend -> yes()
        Admission::SharedReborrow -> yes()
        Admission::Qualified -> yes()
        Admission::Read -> yes()
        _ -> no()
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Whether a reference to an array meets a slice reference of its element
// and qualifier, a shared one from either access and an exclusive one from
// an exclusive reference.
public machine views_array(typer: &Typer, wanted: TypeRow, given: TypeRow) -> bool
crashes Trap
{
    let access: bool = given.access == wanted.access || wanted.access == ReferenceAccess::Shared;
    transition given.kind == TypeKind::Reference && access {
        true -> referents(typer, wanted, given)
        _ -> answer(false)
    }

    machine referents(typer: &Typer, wanted: TypeRow, given: TypeRow) -> bool {
        let array: TypeRow = type_table_row(&typer.output.types, given.inner);
        let slice: TypeRow = type_table_row(&typer.output.types, wanted.inner);
        let viewed: bool = array.kind == TypeKind::Array && slice.kind == TypeKind::Slice && array.inner == slice.inner
            && array.domain == slice.domain && array.domain_item == slice.domain_item;
        transition { _ -> answer(viewed) }
    }

    machine answer(viewed: bool) -> bool {
        viewed
    }
}

