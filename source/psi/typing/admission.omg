use psi::integers::integers;
use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::typing::literals;
use psi::typing::landing;
use psi::typing::references;
use psi::typing::typer;

// How a value meets a destination of a known type: a declared local, a
// parameter, a field, a typed operand or a result. The types are equal; an
// anonymous integer lands at a fixed-integer destination it fits; a value of
// type `Never` meets anything; a shared-reference parameter lends a value of
// its referent implicitly and accepts an exclusive loan as a shared one
// (wiki/spec/language/expressions.md#calls-places-and-temporaries); and a
// payload-free case of generic data, which spells no arguments, meets any
// application of its data; a reference to a builtin scalar meets the scalar
// by reading its referent (`Typer::read_type`); a reference to a whole array
// views it as a slice of its elements; and an exclusive-reference
// destination lends a range slice reached through an exclusive reference. A quoted literal copies its bytes into an
// unqualified fixed byte array of exactly its length
// (wiki/spec/language/data_and_literals.md#quoted-bytes), and a range
// slice is a view a shared-reference destination lends from wherever it
// stands (wiki/spec/language/expressions.md#indexing-and-ranges). Of two types qualifying one carrier
// (wiki/spec/language/domains.md#exact-coercion-and-erasure), a value meets
// a destination its declared domain qualifies by a membership checking
// proves, and a predicate-only declared domain disappears implicitly; a
// routed one, an arithmetic policy or a case's domain does not.
// An unlanded match or array literal (landing.omg) lands where each
// anonymous number among its values would, at a destination of its shape.
pub data Admission [copy] {
    case Rejected;
    case NotAValue;
    case OutOfRange;
    case Exact;
    case Landed;
    case SharedLend;
    case Qualified;
    case Read;
    // An anonymous value with a fractional part at an integer destination.
    case Fraction;
}

pub machine Typer::admission(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping) -> Admission
crashes Trap
{
    let actual: u64 in Trapping = Typing::expression_type(&typer.output, expression);
    transition actual > 0 {
        true -> valued(typer, syntax, destination, expression, actual)
        _ -> not_a_value()
    }

    state valued(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, actual: u64 in Trapping) -> Admission {
        transition actual == destination {
            true -> exact()
            _ -> different(typer, syntax, destination, expression, actual)
        }
    }

    state different(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, actual: u64 in Trapping) -> Admission {
        let read: u64 in Trapping = Typer::read_type(typer, actual);
        transition read != actual && read == destination {
            true -> reading()
            _ -> kinds(typer, syntax, destination, expression, actual)
        }
    }

    state kinds(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, actual: u64 in Trapping) -> Admission {
        let wanted: TypeRow = TypeTable::row(&typer.output.types, destination);
        let given: TypeRow = TypeTable::row(&typer.output.types, actual);
        transition given.kind {
            TypeKind::AnonymousInteger -> literal(typer, expression, wanted)
            TypeKind::AnonymousFloat -> literal(typer, expression, wanted)
            TypeKind::AnonymousChoice -> unlanded(typer, syntax, destination, expression)
            TypeKind::AnonymousArray -> unlanded(typer, syntax, destination, expression)
            _ -> quoted(typer, syntax, wanted, given, actual, expression)
        }
    }

    state quoted(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        let written: Expression = SyntaxTrees::expression(syntax, expression);
        transition written.kind == ExpressionKind::String && wanted.kind == TypeKind::Array {
            true -> copied(typer, expression, wanted)
            _ -> typed(typer, syntax, wanted, given, actual, expression)
        }
    }

    state copied(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow) -> Admission {
        let element: TypeRow = TypeTable::row(&typer.output.types, wanted.inner);
        let extent: TypeRow = TypeTable::row(&typer.output.types, wanted.length);
        let length: ExactInteger = Typing::value(&typer.output, expression);
        let bytes: bool = element.kind == TypeKind::Builtin && element.builtin == BuiltinType::U8
            && element.domain == DomainBinding::Unqualified;
        let exact: bool = extent.kind == TypeKind::StaticInteger && extent.length == (length.magnitude as u64 in Trapping);
        let fits: bool = extent.kind == TypeKind::StaticInteger && extent.length >= (length.magnitude as u64 in Trapping);
        transition bytes && wanted.domain == DomainBinding::Unqualified && exact {
            true -> landed()
            _ -> bounded(bytes && fits, wanted.domain == DomainBinding::Declared)
        }
    }

    // A quoted literal that fits replaces the live bytes of a bounded byte
    // array, a fixed byte array under a declared domain
    // (wiki/spec/terminal-psi/structural_access.md, bounded byte
    // replacement); the domain's predicates are then proved of its octets.
    state bounded(fits: bool, declared: bool) -> Admission {
        transition fits && declared {
            true -> qualified()
            _ -> rejected()
        }
    }

    state literal(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow) -> Admission {
        let admission: Admission = Typer::literal_admission(typer, expression, wanted);
        admission
    }

    state unlanded(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        let landing: Landing = Typer::landing(typer, syntax, destination, expression);
        landing.admission
    }

    state typed(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        transition given.kind == TypeKind::Builtin && given.builtin == BuiltinType::Never {
            true -> exact()
            _ -> carried(typer, syntax, wanted, given, actual, expression)
        }
    }

    state carried(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        let same: bool = TypeTable::same_carrier(&typer.output.types, wanted, given);
        transition same {
            true -> requalified(typer, syntax, wanted, given, expression)
            _ -> lending(typer, syntax, wanted, given, actual, expression)
        }
    }

    state requalified(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, expression: u64 in Trapping) -> Admission {
        let wanted_qualified: TypeRow = TypeTable::qualified_row(&typer.output.types, wanted);
        let given_qualified: TypeRow = TypeTable::qualified_row(&typer.output.types, given);
        let written: Expression = SyntaxTrees::expression(syntax, expression);
        transition wanted_qualified.domain == DomainBinding::Declared {
            true -> qualified()
            _ -> forgotten(syntax, wanted_qualified, given_qualified, written.kind == ExpressionKind::Integer)
        }
    }

    // A suffixed literal chose its carrier, not an arithmetic policy: at a
    // policy-qualified destination of that carrier it lands there
    // (wiki/spec/language/numeric_values.md). Any other typed value keeps
    // its policy and does not convert implicitly.
    state forgotten(syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, suffixed: bool) -> Admission {
        let predicate: bool = wanted.domain == DomainBinding::Unqualified && given.domain == DomainBinding::Declared;
        transition suffixed && given.domain == DomainBinding::Unqualified && wanted.domain != DomainBinding::Declared {
            true -> landed()
            _ -> declared_only(syntax, given, predicate)
        }
    }

    state declared_only(syntax: &SyntaxTrees, given: TypeRow, predicate: bool) -> Admission {
        transition predicate {
            true -> predicate_only(syntax, given)
            _ -> rejected()
        }
    }

    state predicate_only(syntax: &SyntaxTrees, given: TypeRow) -> Admission {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, given.domain_item);
        transition item.route_count == 0 {
            true -> exact()
            _ -> rejected()
        }
    }

    state qualified() -> Admission {
        Admission::Qualified
    }

    state lending(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        transition wanted.kind == TypeKind::Reference {
            true -> referenced(typer, syntax, wanted, given, actual, expression)
            _ -> unapplied(syntax, wanted, given)
        }
    }

    // A reference to a whole array views it as a slice of its elements,
    // a shared view from either reference.
    state referenced(typer: &Typer, syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, expression: u64 in Trapping) -> Admission {
        let viewed: bool = Typer::views_array(typer, wanted, given);
        let write_only: bool = given.kind == TypeKind::Reference && given.access == ReferenceAccess::WriteOnly;
        transition viewed {
            true -> exact()
            _ -> observed(wanted, given, actual, write_only)
        }
    }

    // A write-only reference meets no other reference type: it reads as
    // nothing (wiki/spec/language/ownership.md#borrows-and-aliases).
    state observed(wanted: TypeRow, given: TypeRow, actual: u64 in Trapping, write_only: bool) -> Admission {
        transition write_only {
            true -> rejected()
            _ -> access(wanted, given, actual)
        }
    }

    // A bare range meets only a shared-reference destination: a mutable
    // subrange is written `&mut items[start..end]`, and an expected
    // `&mut [T]` never inserts the borrow
    // (wiki/spec/language/expressions.md#borrowed-range-access).
    state access(wanted: TypeRow, given: TypeRow, actual: u64 in Trapping) -> Admission {
        transition wanted.access == ReferenceAccess::Shared {
            true -> shared(wanted, given, actual)
            _ -> attenuating(wanted, given)
        }
    }

    // A `&write T` destination carries a mutable reference to `T`; whether
    // the attenuation is spelled `&write` at the argument is judged where
    // the admission is bound (`Typer::admit`), so a candidate taking it is
    // selected and its unspelled attenuation is named, not a missing
    // machine.
    state attenuating(wanted: TypeRow, given: TypeRow) -> Admission {
        let mutable: bool = given.kind == TypeKind::Reference && given.access == ReferenceAccess::Mutable
            && given.inner == wanted.inner;
        transition wanted.access == ReferenceAccess::WriteOnly && mutable {
            true -> exact()
            _ -> rejected()
        }
    }

    state shared(wanted: TypeRow, given: TypeRow, actual: u64 in Trapping) -> Admission {
        transition actual == wanted.inner {
            true -> lend()
            _ -> reborrow(wanted, given)
        }
    }

    state reborrow(wanted: TypeRow, given: TypeRow) -> Admission {
        transition given.kind == TypeKind::Reference && given.inner == wanted.inner {
            true -> exact()
            _ -> rejected()
        }
    }

    state unapplied(syntax: &SyntaxTrees, wanted: TypeRow, given: TypeRow) -> Admission {
        transition wanted.kind == TypeKind::Data && given.kind == TypeKind::Data && wanted.item == given.item
            && given.argument_count == 0 {
            true -> generic_data(syntax, wanted)
            _ -> rejected()
        }
    }

    state generic_data(syntax: &SyntaxTrees, wanted: TypeRow) -> Admission {
        let applied: u64 in Trapping = Typer::applied_parameter_count(syntax, wanted.item);
        transition applied > 0 {
            true -> exact()
            _ -> rejected()
        }
    }

    state exact() -> Admission {
        Admission::Exact
    }

    state landed() -> Admission {
        Admission::Landed
    }

    state lend() -> Admission {
        Admission::SharedLend
    }

    state reading() -> Admission {
        Admission::Read
    }

    state rejected() -> Admission {
        Admission::Rejected
    }

    state out_of_range() -> Admission {
        Admission::OutOfRange
    }

    state not_a_value() -> Admission {
        Admission::NotAValue
    }
}

// An anonymous number, `expression`, at a destination of row `wanted`: it
// lands at a float format by one rounding, and an anonymous integer at a
// fixed integer it fits.
pub machine Typer::literal_admission(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow) -> Admission
crashes Trap
{
    let actual: u64 in Trapping = Typing::expression_type(&typer.output, expression);
    let float_destination: bool = wanted.kind == TypeKind::Builtin
        && (wanted.builtin == BuiltinType::F32 || wanted.builtin == BuiltinType::F64);
    transition float_destination {
        true -> landed()
        _ -> integer_literal(typer, expression, wanted, actual)
    }

    state integer_literal(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow, actual: u64 in Trapping) -> Admission {
        transition actual == typer.output.anonymous {
            true -> anonymous(typer, expression, wanted)
            _ -> rejected()
        }
    }

    // Integer landing requires an integral, in-range value
    // (wiki/spec/language/numeric_values.md).
    state anonymous(typer: &Typer, expression: u64 in Trapping, wanted: TypeRow) -> Admission {
        let value: ExactInteger = Typing::value(&typer.output, expression);
        let denominator: u64 in Trapping = Typing::denominator(&typer.output, expression);
        let fixed: bool = Typer::fixed_integer(wanted.builtin);
        let fits: bool = ExactInteger::fits(wanted.builtin, value);
        transition wanted.kind == TypeKind::Builtin && fixed {
            true -> landing(fits, denominator == 1)
            _ -> rejected()
        }
    }

    state landing(fits: bool, integral: bool) -> Admission {
        transition integral {
            true -> ranged(fits)
            _ -> fraction()
        }
    }

    state ranged(fits: bool) -> Admission {
        transition fits {
            true -> landed()
            _ -> out_of_range()
        }
    }

    state fraction() -> Admission {
        Admission::Fraction
    }

    state landed() -> Admission {
        Admission::Landed
    }

    state rejected() -> Admission {
        Admission::Rejected
    }

    state out_of_range() -> Admission {
        Admission::OutOfRange
    }
}

// Admit `expression` at `destination`, recording a landing or an implicit
// shared loan (only where `lend` allows one: a call argument), or reject at
// the expression, or at an unlanded value's number that does not land.
// Whether it was admitted.
pub machine Typer::admit(typer: &mut Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, lend: bool) -> bool
crashes Trap
{
    let admission: Admission = Typer::admission(typer, syntax, destination, expression);
    let actual: u64 in Trapping = Typing::expression_type(&typer.output, expression);
    let given: TypeRow = TypeTable::row(&typer.output.types, actual);
    let chosen: bool = given.kind == TypeKind::AnonymousChoice || given.kind == TypeKind::AnonymousArray;
    let blamed: u64 in Trapping = Typer::blamed_value(typer, syntax, destination, expression, chosen && admission != Admission::Landed);
    let written: Expression = SyntaxTrees::expression(syntax, blamed);
    let wanted: TypeRow = TypeTable::row(&typer.output.types, destination);
    let spelled: Expression = SyntaxTrees::expression(syntax, expression);
    let write_only: bool = wanted.kind == TypeKind::Reference && wanted.access == ReferenceAccess::WriteOnly;
    let attenuated: bool = spelled.kind == ExpressionKind::Unary && spelled.operator == OperatorKind::BorrowWrite;
    transition write_only && !attenuated {
        true -> reject(typer, spelled, TypeDiagnosticCode::ImplicitAttenuation)
        _ -> judged(typer, syntax, destination, expression, lend, admission, chosen, written)
    }

    // A `&write` destination is met only by a `&write` borrow: attenuation
    // from mutable access, and forwarding, are spelled at the argument
    // (wiki/spec/language/expressions.md#calls-places-and-temporaries).
    state judged(typer: &mut Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, lend: bool, admission: Admission, chosen: bool, written: Expression) -> bool {
        transition admission {
            Admission::Exact -> admitted()
            Admission::Landed -> landing(typer, syntax, destination, expression, chosen)
            Admission::SharedLend -> lent(typer, syntax, written, expression, lend)
            Admission::Qualified -> qualified(typer, expression)
            Admission::Read -> read(typer, expression)
            Admission::OutOfRange -> reject(typer, written, TypeDiagnosticCode::LiteralOutOfRange)
            Admission::Fraction -> reject(typer, written, TypeDiagnosticCode::AnonymousFraction)
            Admission::NotAValue -> reject(typer, written, TypeDiagnosticCode::NotAValue)
            Admission::Rejected -> reject(typer, written, TypeDiagnosticCode::MismatchedTypes)
        }
    }

    state landing(typer: &mut Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, chosen: bool) -> bool {
        transition chosen {
            true -> chosen_arms(typer, syntax, destination, expression)
            _ -> landed(typer, destination, expression)
        }
    }

    state landed(typer: &mut Typer, destination: u64 in Trapping, expression: u64 in Trapping) -> bool {
        Typing::set_expression_type(&mut typer.output, expression, destination);
        Typing::set_adaptation(&mut typer.output, expression, Adaptation::Landed);
        transition { _ -> admitted() }
    }

    state chosen_arms(typer: &mut Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping) -> bool {
        Typer::land(typer, syntax, destination, expression);
        transition { _ -> admitted() }
    }

    // A call argument lends implicitly; elsewhere only a range slice, a
    // view of its collection.
    state lent(typer: &mut Typer, syntax: &SyntaxTrees, written: Expression, expression: u64 in Trapping, lend: bool) -> bool {
        let selector: Expression = SyntaxTrees::expression(syntax, written.right);
        let sliced: bool = written.kind == ExpressionKind::Index && selector.kind == ExpressionKind::Range;
        transition lend || sliced {
            true -> mark_lent(typer, expression)
            _ -> reject(typer, written, TypeDiagnosticCode::MismatchedTypes)
        }
    }

    state qualified(typer: &mut Typer, expression: u64 in Trapping) -> bool {
        Typing::set_adaptation(&mut typer.output, expression, Adaptation::Qualified);
        transition { _ -> admitted() }
    }

    state read(typer: &mut Typer, expression: u64 in Trapping) -> bool {
        Typing::set_adaptation(&mut typer.output, expression, Adaptation::Read);
        transition { _ -> admitted() }
    }

    state mark_lent(typer: &mut Typer, expression: u64 in Trapping) -> bool {
        Typing::set_adaptation(&mut typer.output, expression, Adaptation::SharedLend);
        transition { _ -> admitted() }
    }

    state reject(typer: &mut Typer, written: Expression, code: TypeDiagnosticCode) -> bool {
        Typing::reject(&mut typer.output, code, written.source_span);
        transition { _ -> refused() }
    }

    state admitted() -> bool {
        true
    }

    state refused() -> bool {
        false
    }
}

// The value a refused admission names: an unlanded value's first number
// that does not land, else the expression itself.
machine Typer::blamed_value(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping, chosen: bool) -> u64 in Trapping
crashes Trap
{
    transition chosen {
        true -> arm(typer, syntax, destination, expression)
        _ -> found(expression)
    }

    state arm(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping) -> u64 in Trapping {
        let landing: Landing = Typer::landing(typer, syntax, destination, expression);
        transition { _ -> found(landing.value) }
    }

    state found(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// Whether `expression` would be admitted at `destination`, lending allowed:
// the test overload selection applies to each candidate.
pub machine Typer::admissible(typer: &Typer, syntax: &SyntaxTrees, destination: u64 in Trapping, expression: u64 in Trapping) -> bool
crashes Trap
{
    let admission: Admission = Typer::admission(typer, syntax, destination, expression);
    transition admission {
        Admission::Exact -> yes()
        Admission::Landed -> yes()
        Admission::SharedLend -> yes()
        Admission::Qualified -> yes()
        Admission::Read -> yes()
        _ -> no()
    }

    state yes() -> bool {
        true
    }

    state no() -> bool {
        false
    }
}

// Whether a reference to an array meets a slice reference of its element
// and qualifier, a shared one from either access and an exclusive one from
// an exclusive reference.
pub machine Typer::views_array(typer: &Typer, wanted: TypeRow, given: TypeRow) -> bool
crashes Trap
{
    let access: bool = given.access == wanted.access || wanted.access == ReferenceAccess::Shared;
    transition given.kind == TypeKind::Reference && access {
        true -> referents(typer, wanted, given)
        _ -> answer(false)
    }

    state referents(typer: &Typer, wanted: TypeRow, given: TypeRow) -> bool {
        let array: TypeRow = TypeTable::row(&typer.output.types, given.inner);
        let slice: TypeRow = TypeTable::row(&typer.output.types, wanted.inner);
        let viewed: bool = array.kind == TypeKind::Array && slice.kind == TypeKind::Slice && array.inner == slice.inner
            && array.domain == slice.domain && array.domain_item == slice.domain_item;
        transition { _ -> answer(viewed) }
    }

    state answer(viewed: bool) -> bool {
        viewed
    }
}

