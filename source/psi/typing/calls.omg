use psi::resolution::resolution;
use psi::resolve::containers;
use psi::resolve::imports;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::typing::admission;
use psi::typing::binders;
use psi::typing::expressions;
use psi::typing::generics;
use psi::typing::references;
use psi::typing::typer;

// Calls and constructions (wiki/spec/language/expressions.md#calls-places-and-temporaries).
// Resolution bound a callee to the first machine of its overload family:
// every machine the call's unit can see with the same path, a member's
// owner being its trait or conformance. Typing selects the one family
// member whose parameters admit the authored arguments; none or several
// reject. A transition target supplies its state's parameters. A
// shared-reference parameter may lend its argument implicitly; every other
// loan is explicit. A trait requirement or default runs only through a
// selected conformance, a member of a generic conformance needs that
// conformance's arguments, and a target-scoped family's body is chosen by
// realization: each rejects as unsupported here. A proposition application
// selects nothing: it is a Boolean statement whose arguments meet the
// proposition's parameters.
// The explicit static arguments of a call `path<arguments>(...)`: a run of
// `SyntaxTrees::type_arguments`. A plain call has none.
public data StaticArguments [copy] {
    first: u64 in Trapping;
    count: u64 in Trapping;
}

public machine Typer::type_call(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, expression: Expression)
crashes Trap
{
    let callee: Expression = SyntaxTrees::expression(syntax, expression.left);
    transition callee.kind == ExpressionKind::Apply {
        true -> applied(typer, sources, syntax, resolution, index, expression, callee)
        _ -> plain(typer, sources, syntax, resolution, index, expression)
    }

    machine plain(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, expression: Expression) {
        let binding: ValueBinding = NameResolution::value_binding(resolution, expression.left);
        let statics: StaticArguments = StaticArguments { first: 0, count: 0 };
        transition binding {
            ValueBinding::Machine { handle } -> supplied(typer, sources, syntax, resolution, index, expression, handle, statics)
            ValueBinding::State { handle } -> state_target(typer, syntax, index, expression, handle)
            ValueBinding::Proposition { proposition } -> applied_proposition(typer, syntax, resolution, index, expression, proposition, statics)
            ValueBinding::GenericParameter { parameter } -> binder(typer, syntax, resolution, index, expression, parameter)
            ValueBinding::BytePredicate { predicate } -> byte_predicate(typer, syntax, index, expression)
            ValueBinding::LayoutQuery { query } -> layout_query(typer, syntax, index, expression, statics)
            _ -> not_callable(typer, syntax, expression)
        }
    }

    machine byte_predicate(typer: &mut Typer, syntax: &SyntaxTrees, index: u64 in Trapping, expression: Expression) {
        Typer::type_byte_predicate(typer, syntax, index, expression);
    }

    machine layout_query(typer: &mut Typer, syntax: &SyntaxTrees, index: u64 in Trapping, expression: Expression, statics: StaticArguments) {
        Typer::type_layout_query(typer, syntax, index, expression, statics);
    }

    // A machine binder is called through its `where machine` contract
    // (binders.omg).
    machine binder(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, expression: Expression, parameter: u64 in Trapping) {
        Typer::type_binder_call(typer, syntax, resolution, index, expression, parameter);
    }

    // `path<arguments>(...)` names a machine whose generic parameters the
    // static arguments supply in order.
    machine applied(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, expression: Expression, callee: Expression) {
        let binding: ValueBinding = NameResolution::value_binding(resolution, callee.left);
        let statics: StaticArguments = StaticArguments { first: callee.first, count: callee.count };
        transition binding {
            ValueBinding::Machine { handle } -> supplied(typer, sources, syntax, resolution, index, expression, handle, statics)
            ValueBinding::Proposition { proposition } -> applied_proposition(typer, syntax, resolution, index, expression, proposition, statics)
            ValueBinding::LayoutQuery { query } -> layout_query(typer, syntax, index, expression, statics)
            _ -> not_callable(typer, syntax, expression)
        }
    }

    machine applied_proposition(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        expression: Expression,
        handle: u64 in Trapping,
        statics: StaticArguments
    ) {
        Typer::type_proposition(typer, syntax, resolution, index, expression, handle, statics);
    }

    machine supplied(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        expression: Expression,
        handle: u64 in Trapping,
        statics: StaticArguments
    ) {
        let unsupplied: bool = Typer::unsupplied_callee(syntax, resolution, handle);
        transition unsupplied {
            true -> reject(typer, expression, TypeDiagnosticCode::UnsupportedExpression)
            _ -> family(typer, sources, syntax, resolution, index, expression, handle, statics)
        }
    }

    machine family(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        expression: Expression,
        handle: u64 in Trapping,
        statics: StaticArguments
    ) {
        let matches: u64 in Trapping = Typer::matching_machines(typer, sources, syntax, resolution, expression, handle, statics, 0, 0);
        transition matches == 1 {
            true -> select(typer, sources, syntax, resolution, index, expression, handle, statics, 0)
            _ -> unmatched(typer, expression, matches)
        }
    }

    // Find the one admitted family member again, which leaves its generic
    // bindings live, and bind its arguments and result through them.
    machine select(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        index: u64 in Trapping,
        expression: Expression,
        named: u64 in Trapping,
        statics: StaticArguments,
        candidate: u64 in Trapping
    ) {
        let member: bool = Typer::family_admits(typer, sources, syntax, resolution, expression, named, statics, candidate);
        transition member {
            true -> selected(typer, syntax, index, expression, statics, candidate)
            _ -> select(typer, sources, syntax, resolution, index, expression, named, statics, candidate + 1)
        }
    }

    machine selected(typer: &mut Typer, syntax: &SyntaxTrees, index: u64 in Trapping, expression: Expression, statics: StaticArguments, candidate: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, candidate);
        let generic: bool = item.generic_parameter_count > 0;
        let declared: u64 in Trapping = Typer::declared_result(typer, item.has_return_type, item.return_type, typer.output.unit);
        let result: u64 in Trapping = Typer::substitute_if(typer, declared, generic, expression.source_span);
        Typing::set_selection(&mut typer.output, index, Selection::Machine { handle: candidate });
        Typing::set_expression_type(&mut typer.output, index, result);
        Typer::bind_arguments(typer, syntax, expression, item.first_parameter, generic, 0);
    }

    machine unmatched(typer: &mut Typer, expression: Expression, matches: u64 in Trapping) {
        transition matches == 0 {
            true -> reject(typer, expression, TypeDiagnosticCode::NoMatchingMachine)
            _ -> reject(typer, expression, TypeDiagnosticCode::AmbiguousMachine)
        }
    }

    // A transition target names a state of its machine; its arguments are
    // the state's parameters. The jump is not a value: its type is unit.
    machine state_target(typer: &mut Typer, syntax: &SyntaxTrees, index: u64 in Trapping, expression: Expression, handle: u64 in Trapping) {
        let target: StateItem = SyntaxTrees::state_item(syntax, handle);
        Typing::set_selection(&mut typer.output, index, Selection::State { handle: handle });
        let unit_type: u64 in Trapping = typer.output.unit;
        Typing::set_expression_type(&mut typer.output, index, unit_type);
        transition target.parameter_count == expression.count {
            true -> state_arguments(typer, syntax, expression, target)
            _ -> reject(typer, expression, TypeDiagnosticCode::TargetArgumentCount)
        }
    }

    machine state_arguments(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression, target: StateItem) {
        Typer::bind_arguments(typer, syntax, expression, target.first_parameter, false, 0);
    }

    machine not_callable(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression) {
        let callee: Expression = SyntaxTrees::expression(syntax, expression.left);
        Typing::reject(&mut typer.output, TypeDiagnosticCode::NotCallable, callee.source_span);
    }

    machine reject(typer: &mut Typer, expression: Expression, code: TypeDiagnosticCode) {
        Typing::reject(&mut typer.output, code, expression.source_span);
    }
}

// `handle` through the live generic bindings when `generic`.
public machine Typer::substitute_if(typer: &mut Typer, handle: u64 in Trapping, generic: bool, source_span: SourceSpan) -> u64 in Trapping
crashes Trap
{
    transition generic {
        true -> substituted(typer, handle, source_span)
        _ -> unchanged(handle)
    }

    machine substituted(typer: &mut Typer, handle: u64 in Trapping, source_span: SourceSpan) -> u64 in Trapping {
        let mapped: u64 in Trapping = Typer::substitute_bound(typer, handle, source_span);
        mapped
    }

    machine unchanged(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// How many machines from `candidate` on are family members of `named` that
// admit the call's arguments.
machine Typer::matching_machines(
    typer: &mut Typer,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    expression: Expression,
    named: u64 in Trapping,
    statics: StaticArguments,
    candidate: u64 in Trapping,
    count: u64 in Trapping
) -> u64 in Trapping
crashes Trap
{
    transition candidate < syntax.machine_count {
        true -> test(typer, sources, syntax, resolution, expression, named, statics, candidate, count)
        _ -> result(count)
    }

    machine test(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        expression: Expression,
        named: u64 in Trapping,
        statics: StaticArguments,
        candidate: u64 in Trapping,
        count: u64 in Trapping
    ) -> u64 in Trapping {
        let member: bool = Typer::family_admits(typer, sources, syntax, resolution, expression, named, statics, candidate);
        transition member {
            true -> next(typer, sources, syntax, resolution, expression, named, statics, candidate + 1, count + 1)
            _ -> next(typer, sources, syntax, resolution, expression, named, statics, candidate + 1, count)
        }
    }

    machine next(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        expression: Expression,
        named: u64 in Trapping,
        statics: StaticArguments,
        candidate: u64 in Trapping,
        count: u64 in Trapping
    ) -> u64 in Trapping {
        transition candidate < syntax.machine_count {
            true -> test(typer, sources, syntax, resolution, expression, named, statics, candidate, count)
            _ -> result(count)
        }
    }

    machine result(count: u64 in Trapping) -> u64 in Trapping {
        count
    }
}

// Whether machine `candidate` belongs to the family of machine `named` (the
// same path) as the call's unit sees it, needs nothing typing does not
// supply, and has parameters admitting the call's arguments. A generic
// candidate first binds its parameters from the static arguments and by
// unifying each parameter with its argument (generics.omg); every parameter
// must be bound, and each argument is then admitted at the substituted
// parameter type. The bindings stay live after an admitted candidate.
machine Typer::family_admits(
    typer: &mut Typer,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    expression: Expression,
    named: u64 in Trapping,
    statics: StaticArguments,
    candidate: u64 in Trapping
) -> bool
crashes Trap
{
    let representative: MachineItem = SyntaxTrees::machine_item(syntax, named);
    let path: MachineOwner = NameResolution::machine_owner(resolution, named);
    let item: MachineItem = SyntaxTrees::machine_item(syntax, candidate);
    let spelled: bool = Resolver::machine_spells(resolution, sources, item, candidate, path.has_owner, path.owner.source_span,
        representative.name.source_span);
    let unsupplied: bool = Typer::unsupplied_callee(syntax, resolution, candidate);
    transition spelled && !unsupplied && item.parameter_count == expression.count {
        true -> visible(typer, sources, syntax, resolution, expression, statics, item, candidate)
        _ -> no()
    }

    machine visible(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        expression: Expression,
        statics: StaticArguments,
        item: MachineItem,
        candidate: u64 in Trapping
    ) -> bool {
        let seen: bool = Resolver::machine_visible_if(resolution, sources, syntax, true, expression.source_span.source, item, candidate);
        transition seen {
            true -> shape(typer, syntax, resolution, expression, statics, item)
            _ -> no()
        }
    }

    machine shape(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, expression: Expression, statics: StaticArguments, item: MachineItem) -> bool {
        transition item.generic_parameter_count > 0 {
            true -> generic(typer, syntax, resolution, expression, statics, item)
            _ -> concrete(typer, syntax, expression, statics, item)
        }
    }

    machine concrete(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression, statics: StaticArguments, item: MachineItem) -> bool {
        transition statics.count == 0 {
            true -> arguments(typer, syntax, expression, item, false, 0)
            _ -> no()
        }
    }

    machine generic(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, expression: Expression, statics: StaticArguments, item: MachineItem) -> bool {
        Typer::begin_bindings(typer);
        let explicit: bool = Typer::bind_static_arguments(typer, syntax, resolution, item.first_generic_parameter, item.generic_parameter_count, statics);
        transition explicit {
            true -> inferred(typer, syntax, resolution, expression, item)
            _ -> no()
        }
    }

    // A machine binder's contract also binds the parameters it names from
    // its argument's signature, which must then be the contract's.
    machine inferred(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, expression: Expression, item: MachineItem) -> bool {
        Typer::unify_arguments(typer, syntax, expression, item.first_parameter, item.first_generic_parameter, item.generic_parameter_count);
        Typer::unify_machine_arguments(typer, syntax, resolution, item.first_generic_parameter, item.generic_parameter_count);
        let complete: bool = Typer::all_bound(typer, syntax, item.first_generic_parameter, item.generic_parameter_count);
        transition complete {
            true -> refined(typer, syntax, resolution, expression, item)
            _ -> no()
        }
    }

    machine refined(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, expression: Expression, item: MachineItem) -> bool {
        let refines: bool = Typer::machine_arguments_refine(typer, syntax, resolution, item.first_generic_parameter, item.generic_parameter_count, expression.source_span);
        transition refines {
            true -> arguments(typer, syntax, expression, item, true, 0)
            _ -> no()
        }
    }

    machine arguments(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression, item: MachineItem, generic: bool, offset: u64 in Trapping) -> bool {
        transition offset < expression.count {
            true -> argument(typer, syntax, expression, item, generic, offset)
            _ -> yes()
        }
    }

    machine argument(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression, item: MachineItem, generic: bool, offset: u64 in Trapping) -> bool {
        let argument: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + offset);
        let parameter: Parameter = SyntaxTrees::parameter(syntax, item.first_parameter + offset);
        let declared: u64 in Trapping = Typing::reference_type(&typer.output, parameter.type_reference);
        let destination: u64 in Trapping = Typer::substitute_if(typer, declared, generic, expression.source_span);
        let admitted: bool = Typer::admissible(typer, syntax, destination, argument);
        transition admitted {
            true -> arguments(typer, syntax, expression, item, generic, offset + 1)
            _ -> no()
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Whether a call of machine `handle` needs what typing does not supply: its
// container's generic arguments (a generic conformance's member), a selected
// conformance (a trait requirement or default), or a realization's choice
// among target-scoped bodies.
machine Typer::unsupplied_callee(syntax: &SyntaxTrees, resolution: &NameResolution, handle: u64 in Trapping) -> bool
crashes Trap
{
    let item: MachineItem = SyntaxTrees::machine_item(syntax, handle);
    let owner: MachineOwner = NameResolution::machine_owner(resolution, handle);
    let container: TypeScope = Resolver::container_scope(syntax, owner);
    container.generic_parameter_count > 0 || owner.container == MachineContainer::Trait
        || owner.container == MachineContainer::Refinement || item.has_target
}

// Bind a signature's generic parameters `first..first + count`, lifetimes
// aside, to the call's static arguments by kind: a static argument naming
// a machine (binders.omg) to the next machine binder, any other to the next
// other parameter, each in order. Whether they fit: one per machine binder,
// and none or one per other parameter (none leaves those to inference).
machine Typer::bind_static_arguments(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, statics: StaticArguments) -> bool
crashes Trap
{
    let machines: u64 in Trapping = Typer::machine_static_count(syntax, resolution, statics);
    let binders: u64 in Trapping = Typer::kind_count(syntax, first, count, true);
    let others: u64 in Trapping = Typer::kind_count(syntax, first, count, false);
    let types: u64 in Trapping = statics.count - machines;
    transition machines == binders && (types == 0 || types == others) {
        true -> next(typer, syntax, resolution, first, count, statics, 0, 0, 0)
        _ -> unfitted()
    }

    machine next(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, statics: StaticArguments, offset: u64 in Trapping, typed: u64 in Trapping, machined: u64 in Trapping) -> bool {
        transition offset < count {
            true -> parameter(typer, syntax, resolution, first, count, statics, offset, typed, machined)
            _ -> fitted()
        }
    }

    machine parameter(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, statics: StaticArguments, offset: u64 in Trapping, typed: u64 in Trapping, machined: u64 in Trapping) -> bool {
        let handle: u64 in Trapping = first + offset;
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, handle);
        transition generic.kind {
            GenericParameterKind::Lifetime -> next(typer, syntax, resolution, first, count, statics, offset + 1, typed, machined)
            GenericParameterKind::Machine -> machine(typer, syntax, resolution, first, count, statics, offset, typed, machined, handle)
            _ -> other(typer, syntax, resolution, first, count, statics, offset, typed, machined, handle)
        }
    }

    machine machine(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, statics: StaticArguments, offset: u64 in Trapping, typed: u64 in Trapping, machined: u64 in Trapping, handle: u64 in Trapping) -> bool {
        let position: u64 in Trapping = Typer::nth_static(syntax, resolution, statics, true, machined);
        let row: u64 in Trapping = SyntaxTrees::type_argument(syntax, statics.first + position);
        let argument: MachineArgument = NameResolution::machine_argument(syntax, resolution, row);
        Typer::bind_machine(typer, handle, argument);
        transition { _ -> next(typer, syntax, resolution, first, count, statics, offset + 1, typed, machined + 1) }
    }

    machine other(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, statics: StaticArguments, offset: u64 in Trapping, typed: u64 in Trapping, machined: u64 in Trapping, handle: u64 in Trapping) -> bool {
        let machines: u64 in Trapping = Typer::machine_static_count(syntax, resolution, statics);
        transition statics.count > machines {
            true -> typed_argument(typer, syntax, resolution, first, count, statics, offset, typed, machined, handle)
            _ -> next(typer, syntax, resolution, first, count, statics, offset + 1, typed, machined)
        }
    }

    machine typed_argument(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, first: u64 in Trapping, count: u64 in Trapping, statics: StaticArguments, offset: u64 in Trapping, typed: u64 in Trapping, machined: u64 in Trapping, handle: u64 in Trapping) -> bool {
        let position: u64 in Trapping = Typer::nth_static(syntax, resolution, statics, false, typed);
        let row: u64 in Trapping = SyntaxTrees::type_argument(syntax, statics.first + position);
        let argument: u64 in Trapping = Typing::reference_type(&typer.output, row);
        Typer::bind(typer, handle, argument);
        transition { _ -> next(typer, syntax, resolution, first, count, statics, offset + 1, typed + 1, machined) }
    }

    machine fitted() -> bool {
        true
    }

    machine unfitted() -> bool {
        false
    }
}

// How many of a call's static arguments name machines.
machine Typer::machine_static_count(syntax: &SyntaxTrees, resolution: &NameResolution, statics: StaticArguments) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(syntax, resolution, statics, 0, 0) }

    machine next(syntax: &SyntaxTrees, resolution: &NameResolution, statics: StaticArguments, position: u64 in Trapping, counted: u64 in Trapping) -> u64 in Trapping {
        transition position < statics.count {
            true -> argument(syntax, resolution, statics, position, counted)
            _ -> finished(counted)
        }
    }

    machine argument(syntax: &SyntaxTrees, resolution: &NameResolution, statics: StaticArguments, position: u64 in Trapping, counted: u64 in Trapping) -> u64 in Trapping {
        let row: u64 in Trapping = SyntaxTrees::type_argument(syntax, statics.first + position);
        let machine: bool = Typer::names_machine(syntax, resolution, row);
        transition machine {
            true -> next(syntax, resolution, statics, position + 1, counted + 1)
            _ -> next(syntax, resolution, statics, position + 1, counted)
        }
    }

    machine finished(counted: u64 in Trapping) -> u64 in Trapping {
        counted
    }
}

// How many of the generic parameters `first .. first + count` are machine
// binders (`machines`) or, lifetimes aside, other parameters.
machine Typer::kind_count(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, machines: bool) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(syntax, first, count, machines, 0, 0) }

    machine next(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, machines: bool, offset: u64 in Trapping, counted: u64 in Trapping) -> u64 in Trapping {
        transition offset < count {
            true -> parameter(syntax, first, count, machines, offset, counted)
            _ -> finished(counted)
        }
    }

    machine parameter(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, machines: bool, offset: u64 in Trapping, counted: u64 in Trapping) -> u64 in Trapping {
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, first + offset);
        let machine: bool = generic.kind == GenericParameterKind::Machine;
        let lifetime: bool = generic.kind == GenericParameterKind::Lifetime;
        transition !lifetime && machine == machines {
            true -> next(syntax, first, count, machines, offset + 1, counted + 1)
            _ -> next(syntax, first, count, machines, offset + 1, counted)
        }
    }

    machine finished(counted: u64 in Trapping) -> u64 in Trapping {
        counted
    }
}

// The position among a call's static arguments of the `wanted`-th (from
// zero) that names a machine (`machines`) or a type.
machine Typer::nth_static(syntax: &SyntaxTrees, resolution: &NameResolution, statics: StaticArguments, machines: bool, wanted: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(syntax, resolution, statics, machines, wanted, 0, 0) }

    machine next(syntax: &SyntaxTrees, resolution: &NameResolution, statics: StaticArguments, machines: bool, wanted: u64 in Trapping, position: u64 in Trapping, seen: u64 in Trapping) -> u64 in Trapping {
        transition position < statics.count {
            true -> argument(syntax, resolution, statics, machines, wanted, position, seen)
            _ -> finished(position)
        }
    }

    machine argument(syntax: &SyntaxTrees, resolution: &NameResolution, statics: StaticArguments, machines: bool, wanted: u64 in Trapping, position: u64 in Trapping, seen: u64 in Trapping) -> u64 in Trapping {
        let row: u64 in Trapping = SyntaxTrees::type_argument(syntax, statics.first + position);
        let machine: bool = Typer::names_machine(syntax, resolution, row);
        transition machine == machines {
            true -> matched(syntax, resolution, statics, machines, wanted, position, seen)
            _ -> next(syntax, resolution, statics, machines, wanted, position + 1, seen)
        }
    }

    machine matched(syntax: &SyntaxTrees, resolution: &NameResolution, statics: StaticArguments, machines: bool, wanted: u64 in Trapping, position: u64 in Trapping, seen: u64 in Trapping) -> u64 in Trapping {
        transition seen == wanted {
            true -> finished(position)
            _ -> next(syntax, resolution, statics, machines, wanted, position + 1, seen + 1)
        }
    }

    machine finished(position: u64 in Trapping) -> u64 in Trapping {
        position
    }
}

// Unify each parameter type of a generic signature with its argument's
// type, binding the signature's generic parameters
// `first_generic..first_generic + generic_count` that the parameter types
// mention.
machine Typer::unify_arguments(
    typer: &mut Typer,
    syntax: &SyntaxTrees,
    expression: Expression,
    first_parameter: u64 in Trapping,
    first_generic: u64 in Trapping,
    generic_count: u64 in Trapping
)
crashes Trap
{
    transition { _ -> next(typer, syntax, expression, first_parameter, first_generic, generic_count, 0) }

    machine next(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        expression: Expression,
        first_parameter: u64 in Trapping,
        first_generic: u64 in Trapping,
        generic_count: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < expression.count {
            true -> argument(typer, syntax, expression, first_parameter, first_generic, generic_count, offset)
            _ -> done()
        }
    }

    machine argument(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        expression: Expression,
        first_parameter: u64 in Trapping,
        first_generic: u64 in Trapping,
        generic_count: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let argument: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + offset);
        let parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + offset);
        let wanted: u64 in Trapping = Typing::reference_type(&typer.output, parameter.type_reference);
        let given: u64 in Trapping = Typing::expression_type(&typer.output, argument);
        Typer::unify(typer, first_generic, generic_count, wanted, given);
        transition { _ -> next(typer, syntax, expression, first_parameter, first_generic, generic_count, offset + 1) }
    }

    machine done() {}
}

// A proposition application, which resolution admits only as a whole fact
// (wiki/language_guide/chapter_10_compile_time_proofs.md): a statement, so
// a Boolean, not a call; it selects and runs nothing. Its arguments meet
// the proposition's parameters by ordinary admission, a generic
// proposition's through the bindings its static arguments and argument
// types give, as a generic machine call's do.
machine Typer::type_proposition(
    typer: &mut Typer,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    index: u64 in Trapping,
    expression: Expression,
    handle: u64 in Trapping,
    statics: StaticArguments
)
crashes Trap
{
    let item: PropositionItem = SyntaxTrees::proposition_item(syntax, handle);
    let boolean_type: u64 in Trapping = typer.output.boolean;
    Typing::set_expression_type(&mut typer.output, index, boolean_type);
    transition item.parameter_count == expression.count {
        true -> shape(typer, syntax, resolution, expression, item, statics)
        _ -> reject(typer, expression, TypeDiagnosticCode::PropositionArgumentCount)
    }

    machine shape(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, expression: Expression, item: PropositionItem, statics: StaticArguments) {
        transition item.generic_parameter_count > 0 {
            true -> generic(typer, syntax, resolution, expression, item, statics)
            _ -> concrete(typer, syntax, expression, item, statics)
        }
    }

    machine concrete(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression, item: PropositionItem, statics: StaticArguments) {
        transition statics.count == 0 {
            true -> arguments(typer, syntax, expression, item, false)
            _ -> reject(typer, expression, TypeDiagnosticCode::GenericArgumentCount)
        }
    }

    machine generic(typer: &mut Typer, syntax: &SyntaxTrees, resolution: &NameResolution, expression: Expression, item: PropositionItem, statics: StaticArguments) {
        Typer::begin_bindings(typer);
        let explicit: bool = Typer::bind_static_arguments(typer, syntax, resolution, item.first_generic_parameter, item.generic_parameter_count, statics);
        transition explicit {
            true -> inferred(typer, syntax, expression, item)
            _ -> reject(typer, expression, TypeDiagnosticCode::GenericArgumentCount)
        }
    }

    machine inferred(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression, item: PropositionItem) {
        Typer::unify_arguments(typer, syntax, expression, item.first_parameter, item.first_generic_parameter, item.generic_parameter_count);
        let complete: bool = Typer::all_bound(typer, syntax, item.first_generic_parameter, item.generic_parameter_count);
        transition complete {
            true -> arguments(typer, syntax, expression, item, true)
            _ -> reject(typer, expression, TypeDiagnosticCode::UninferredGenericArgument)
        }
    }

    machine arguments(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression, item: PropositionItem, generic: bool) {
        Typer::bind_arguments(typer, syntax, expression, item.first_parameter, generic, 0);
    }

    machine reject(typer: &mut Typer, expression: Expression, code: TypeDiagnosticCode) {
        Typing::reject(&mut typer.output, code, expression.source_span);
    }
}

// Admit each argument of `expression` at its parameter, in order; a generic
// callee's parameters through its live bindings.
public machine Typer::bind_arguments(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression, first_parameter: u64 in Trapping, generic: bool, offset: u64 in Trapping)
crashes Trap
{
    transition offset < expression.count && typer.output.accepted {
        true -> argument(typer, syntax, expression, first_parameter, generic, offset)
        _ -> done()
    }

    machine argument(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression, first_parameter: u64 in Trapping, generic: bool, offset: u64 in Trapping) {
        let argument: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + offset);
        let parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + offset);
        let declared: u64 in Trapping = Typing::reference_type(&typer.output, parameter.type_reference);
        let destination: u64 in Trapping = Typer::substitute_if(typer, declared, generic, expression.source_span);
        let admitted: bool = Typer::admit(typer, syntax, destination, argument, true);
        transition { _ -> next(typer, syntax, expression, first_parameter, generic, offset + 1) }
    }

    machine next(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression, first_parameter: u64 in Trapping, generic: bool, offset: u64 in Trapping) {
        transition offset < expression.count && typer.output.accepted {
            true -> argument(typer, syntax, expression, first_parameter, generic, offset)
            _ -> done()
        }
    }

    machine done() {}
}

// `Path { field: value, ... }`: a record names its data declaration, a case
// value its case (`Type::Case { ... }`), whose payload fields join the common
// fields. Each authored field names a declared one once and admits its
// value; an omitted field is zero-initialized, which checking judges against
// the type's default domain (wiki/spec/language/data_and_literals.md).
// Generic data is applied to the arguments its field values imply.
public machine Typer::type_construct(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, expression: Expression)
crashes Trap
{
    let binding: ValueBinding = NameResolution::value_binding(resolution, expression.left);
    transition binding {
        ValueBinding::Data { item } -> record(typer, sources, syntax, index, expression, item)
        ValueBinding::DataCase { item, data_case } -> case_value(typer, sources, syntax, index, expression, item, data_case)
        _ -> reject(typer, expression, TypeDiagnosticCode::NotConstructible)
    }

    machine record(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, expression: Expression, item: u64 in Trapping) {
        let declared: DataItem = SyntaxTrees::data_item(syntax, item);
        transition declared.case_count == 0 {
            true -> shaped(typer, sources, syntax, index, expression, item, declared, false, 0)
            _ -> reject(typer, expression, TypeDiagnosticCode::NotConstructible)
        }
    }

    machine case_value(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        expression: Expression,
        item: u64 in Trapping,
        data_case: u64 in Trapping
    ) {
        let declared: DataItem = SyntaxTrees::data_item(syntax, item);
        transition { _ -> shaped(typer, sources, syntax, index, expression, item, declared, true, data_case) }
    }

    // Generic data takes the arguments its field values imply
    // (generics.omg): every parameter must be bound by some field.
    machine shaped(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        expression: Expression,
        item: u64 in Trapping,
        declared: DataItem,
        has_case: bool,
        data_case: u64 in Trapping
    ) {
        let applied: u64 in Trapping = Typer::applied_parameter_count(syntax, item);
        transition applied > 0 {
            true -> generic(typer, sources, syntax, index, expression, item, declared, has_case, data_case)
            _ -> concrete(typer, sources, syntax, index, expression, item, declared, has_case, data_case)
        }
    }

    machine concrete(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        expression: Expression,
        item: u64 in Trapping,
        declared: DataItem,
        has_case: bool,
        data_case: u64 in Trapping
    ) {
        let mut row: TypeRow = TypeRow::of(TypeKind::Data);
        row.item = item;
        let handle: u64 in Trapping = Typer::intern(typer, row, expression.source_span);
        Typing::set_expression_type(&mut typer.output, index, handle);
        Typer::construct_fields(typer, sources, syntax, expression, declared, has_case, data_case, false, 0);
    }

    machine generic(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        expression: Expression,
        item: u64 in Trapping,
        declared: DataItem,
        has_case: bool,
        data_case: u64 in Trapping
    ) {
        let inferred: bool = Typer::infer_construction(typer, sources, syntax, expression, declared, has_case, data_case);
        transition inferred {
            true -> applied_type(typer, sources, syntax, index, expression, item, declared, has_case, data_case)
            _ -> reject(typer, expression, TypeDiagnosticCode::UninferredGenericArgument)
        }
    }

    machine applied_type(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        expression: Expression,
        item: u64 in Trapping,
        declared: DataItem,
        has_case: bool,
        data_case: u64 in Trapping
    ) {
        let handle: u64 in Trapping = Typer::bound_application(typer, syntax, item, declared, expression.source_span);
        Typing::set_expression_type(&mut typer.output, index, handle);
        Typer::construct_fields(typer, sources, syntax, expression, declared, has_case, data_case, true, 0);
    }

    machine reject(typer: &mut Typer, expression: Expression, code: TypeDiagnosticCode) {
        Typing::reject(&mut typer.output, code, expression.source_span);
    }
}

machine Typer::construct_fields(
    typer: &mut Typer,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    expression: Expression,
    declared: DataItem,
    has_case: bool,
    data_case: u64 in Trapping,
    generic: bool,
    offset: u64 in Trapping
)
crashes Trap
{
    transition offset < expression.count && typer.output.accepted {
        true -> field(typer, sources, syntax, expression, declared, has_case, data_case, generic, offset)
        _ -> done()
    }

    machine field(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        expression: Expression,
        declared: DataItem,
        has_case: bool,
        data_case: u64 in Trapping,
        generic: bool,
        offset: u64 in Trapping
    ) {
        let written: ConstructField = SyntaxTrees::construct_field(syntax, expression.first + offset);
        let repeated: bool = Typer::repeats_field(sources, syntax, expression, offset, written);
        let reference: u64 in Trapping = Typer::member_field_type(sources, syntax, declared, has_case, data_case, written.name);
        transition repeated {
            true -> reject(typer, written, TypeDiagnosticCode::DuplicateConstructionField)
            _ -> known(typer, sources, syntax, expression, declared, has_case, data_case, generic, offset, written, reference)
        }
    }

    machine known(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        expression: Expression,
        declared: DataItem,
        has_case: bool,
        data_case: u64 in Trapping,
        generic: bool,
        offset: u64 in Trapping,
        written: ConstructField,
        reference: u64 in Trapping
    ) {
        transition reference < 18446744073709551615 {
            true -> admit(typer, sources, syntax, expression, declared, has_case, data_case, generic, offset, written, reference)
            _ -> reject(typer, written, TypeDiagnosticCode::UnknownConstructionField)
        }
    }

    machine admit(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        expression: Expression,
        declared: DataItem,
        has_case: bool,
        data_case: u64 in Trapping,
        generic: bool,
        offset: u64 in Trapping,
        written: ConstructField,
        reference: u64 in Trapping
    ) {
        let declared_type: u64 in Trapping = Typing::reference_type(&typer.output, reference);
        let destination: u64 in Trapping = Typer::substitute_if(typer, declared_type, generic, written.source_span);
        let admitted: bool = Typer::admit(typer, syntax, destination, written.value, false);
        let target: MemberTarget = Typer::member_target(sources, syntax, declared, has_case, data_case, written.name);
        Typing::set_construct_target(&mut typer.output, expression.first + offset, target);
        transition { _ -> next(typer, sources, syntax, expression, declared, has_case, data_case, generic, offset + 1) }
    }

    machine next(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        expression: Expression,
        declared: DataItem,
        has_case: bool,
        data_case: u64 in Trapping,
        generic: bool,
        offset: u64 in Trapping
    ) {
        transition offset < expression.count && typer.output.accepted {
            true -> field(typer, sources, syntax, expression, declared, has_case, data_case, generic, offset)
            _ -> done()
        }
    }

    machine reject(typer: &mut Typer, written: ConstructField, code: TypeDiagnosticCode) {
        Typing::reject(&mut typer.output, code, written.source_span);
    }

    machine done() {}
}

// Bind `declared`'s generic parameters by unifying each authored field's
// declared type with its value's type. Whether every parameter is bound.
machine Typer::infer_construction(
    typer: &mut Typer,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    expression: Expression,
    declared: DataItem,
    has_case: bool,
    data_case: u64 in Trapping
) -> bool
crashes Trap
{
    Typer::begin_bindings(typer);
    transition { _ -> next(typer, sources, syntax, expression, declared, has_case, data_case, 0) }

    machine next(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, expression: Expression, declared: DataItem, has_case: bool, data_case: u64 in Trapping, offset: u64 in Trapping) -> bool {
        transition offset < expression.count {
            true -> field(typer, sources, syntax, expression, declared, has_case, data_case, offset)
            _ -> complete(typer, syntax, declared)
        }
    }

    machine field(typer: &mut Typer, sources: &SourceSet, syntax: &SyntaxTrees, expression: Expression, declared: DataItem, has_case: bool, data_case: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let written: ConstructField = SyntaxTrees::construct_field(syntax, expression.first + offset);
        let reference: u64 in Trapping = Typer::member_field_type(sources, syntax, declared, has_case, data_case, written.name);
        transition reference < 18446744073709551615 {
            true -> unify(typer, sources, syntax, expression, declared, has_case, data_case, offset, written, reference)
            _ -> next(typer, sources, syntax, expression, declared, has_case, data_case, offset + 1)
        }
    }

    machine unify(
        typer: &mut Typer,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        expression: Expression,
        declared: DataItem,
        has_case: bool,
        data_case: u64 in Trapping,
        offset: u64 in Trapping,
        written: ConstructField,
        reference: u64 in Trapping
    ) -> bool {
        let wanted: u64 in Trapping = Typing::reference_type(&typer.output, reference);
        let given: u64 in Trapping = Typing::expression_type(&typer.output, written.value);
        Typer::unify(typer, declared.first_generic_parameter, declared.generic_parameter_count, wanted, given);
        transition { _ -> next(typer, sources, syntax, expression, declared, has_case, data_case, offset + 1) }
    }

    machine complete(typer: &mut Typer, syntax: &SyntaxTrees, declared: DataItem) -> bool {
        let bound: bool = Typer::all_bound(typer, syntax, declared.first_generic_parameter, declared.generic_parameter_count);
        bound
    }
}

// Data `item` applied to its parameters' live bindings, in order.
machine Typer::bound_application(typer: &mut Typer, syntax: &SyntaxTrees, item: u64 in Trapping, declared: DataItem, source_span: SourceSpan) -> u64 in Trapping
crashes Trap
{
    let first: u64 in Trapping = typer.output.types.argument_count as u64 in Trapping;
    transition { _ -> next(typer, syntax, item, declared, source_span, first, 0, 0) }

    machine next(typer: &mut Typer, syntax: &SyntaxTrees, item: u64 in Trapping, declared: DataItem, source_span: SourceSpan, first: u64 in Trapping, offset: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping {
        transition offset < declared.generic_parameter_count {
            true -> parameter(typer, syntax, item, declared, source_span, first, offset, count)
            _ -> applied(typer, item, source_span, first, count)
        }
    }

    machine parameter(typer: &mut Typer, syntax: &SyntaxTrees, item: u64 in Trapping, declared: DataItem, source_span: SourceSpan, first: u64 in Trapping, offset: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping {
        let handle: u64 in Trapping = declared.first_generic_parameter + offset;
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, handle);
        transition generic.kind == GenericParameterKind::Lifetime {
            true -> next(typer, syntax, item, declared, source_span, first, offset + 1, count)
            _ -> argument(typer, syntax, item, declared, source_span, first, offset, count, handle)
        }
    }

    machine argument(
        typer: &mut Typer,
        syntax: &SyntaxTrees,
        item: u64 in Trapping,
        declared: DataItem,
        source_span: SourceSpan,
        first: u64 in Trapping,
        offset: u64 in Trapping,
        count: u64 in Trapping,
        handle: u64 in Trapping
    ) -> u64 in Trapping {
        let bound: u64 in Trapping = Typer::bound_type(typer, handle);
        let kept: bool = TypeTable::push_argument(&mut typer.output.types, bound);
        transition kept {
            true -> next(typer, syntax, item, declared, source_span, first, offset + 1, count + 1)
            _ -> full(typer, source_span)
        }
    }

    machine applied(typer: &mut Typer, item: u64 in Trapping, source_span: SourceSpan, first: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping {
        let mut row: TypeRow = TypeRow::of(TypeKind::Data);
        row.item = item;
        row.first_argument = first;
        row.argument_count = count;
        let handle: u64 in Trapping = Typer::intern(typer, row, source_span);
        handle
    }

    machine full(typer: &mut Typer, source_span: SourceSpan) -> u64 in Trapping {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::TypeCapacityExceeded, source_span);
        transition { _ -> failed() }
    }

    machine failed() -> u64 in Trapping {
        0
    }
}

// Whether an earlier field of the construction spells `written`'s name.
machine Typer::repeats_field(sources: &SourceSet, syntax: &SyntaxTrees, expression: Expression, offset: u64 in Trapping, written: ConstructField) -> bool
crashes Trap
{
    transition { _ -> prior(sources, syntax, expression, offset, written, 0) }

    machine prior(sources: &SourceSet, syntax: &SyntaxTrees, expression: Expression, offset: u64 in Trapping, written: ConstructField, earlier: u64 in Trapping) -> bool {
        transition earlier < offset {
            true -> compare(sources, syntax, expression, offset, written, earlier)
            _ -> no()
        }
    }

    machine compare(sources: &SourceSet, syntax: &SyntaxTrees, expression: Expression, offset: u64 in Trapping, written: ConstructField, earlier: u64 in Trapping) -> bool {
        let before: ConstructField = SyntaxTrees::construct_field(syntax, expression.first + earlier);
        let spelled: bool = SourceSet::spans_equal(sources, before.name.source_span, written.name.source_span);
        transition spelled {
            true -> yes()
            _ -> prior(sources, syntax, expression, offset, written, earlier + 1)
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// The member `name` denotes in a construction or pattern of `declared`: a
// common field, else, with `has_case`, a payload field of `data_case`.
public machine Typer::member_target(sources: &SourceSet, syntax: &SyntaxTrees, declared: DataItem, has_case: bool, data_case: u64 in Trapping, name: IdentifierSpan) -> MemberTarget
crashes Trap
{
    transition { _ -> common(sources, syntax, declared, has_case, data_case, name, 0) }

    machine common(sources: &SourceSet, syntax: &SyntaxTrees, declared: DataItem, has_case: bool, data_case: u64 in Trapping, name: IdentifierSpan, offset: u64 in Trapping) -> MemberTarget {
        transition offset < declared.field_count {
            true -> common_compare(sources, syntax, declared, has_case, data_case, name, offset)
            _ -> payload_start(sources, syntax, has_case, data_case, name)
        }
    }

    machine common_compare(sources: &SourceSet, syntax: &SyntaxTrees, declared: DataItem, has_case: bool, data_case: u64 in Trapping, name: IdentifierSpan, offset: u64 in Trapping) -> MemberTarget {
        let field: DataField = SyntaxTrees::field(syntax, declared.first_field + offset);
        let spelled: bool = SourceSet::spans_equal(sources, field.name.source_span, name.source_span);
        transition spelled {
            true -> found(MemberTarget::Common { field: declared.first_field + offset })
            _ -> common(sources, syntax, declared, has_case, data_case, name, offset + 1)
        }
    }

    machine payload_start(sources: &SourceSet, syntax: &SyntaxTrees, has_case: bool, data_case: u64 in Trapping, name: IdentifierSpan) -> MemberTarget {
        let selected: DataCase = SyntaxTrees::data_case(syntax, data_case);
        transition has_case {
            true -> payload(sources, syntax, selected, name, 0)
            _ -> found(MemberTarget::Unknown)
        }
    }

    machine payload(sources: &SourceSet, syntax: &SyntaxTrees, selected: DataCase, name: IdentifierSpan, offset: u64 in Trapping) -> MemberTarget {
        transition offset < selected.payload_field_count {
            true -> payload_compare(sources, syntax, selected, name, offset)
            _ -> found(MemberTarget::Unknown)
        }
    }

    machine payload_compare(sources: &SourceSet, syntax: &SyntaxTrees, selected: DataCase, name: IdentifierSpan, offset: u64 in Trapping) -> MemberTarget {
        let field: DataField = SyntaxTrees::payload_field(syntax, selected.first_payload_field + offset);
        let spelled: bool = SourceSet::spans_equal(sources, field.name.source_span, name.source_span);
        transition spelled {
            true -> found(MemberTarget::Payload { field: selected.first_payload_field + offset })
            _ -> payload(sources, syntax, selected, name, offset + 1)
        }
    }

    machine found(target: MemberTarget) -> MemberTarget {
        target
    }
}

// The type reference of the member `name` denotes, or the maximum handle
// when it denotes none.
public machine Typer::member_field_type(sources: &SourceSet, syntax: &SyntaxTrees, declared: DataItem, has_case: bool, data_case: u64 in Trapping, name: IdentifierSpan) -> u64 in Trapping
crashes Trap
{
    let target: MemberTarget = Typer::member_target(sources, syntax, declared, has_case, data_case, name);
    let reference: u64 in Trapping = Typer::target_reference(syntax, target);
    reference
}

// A member's declared type reference, or the maximum handle for none.
public machine Typer::target_reference(syntax: &SyntaxTrees, target: MemberTarget) -> u64 in Trapping
crashes Trap
{
    transition target {
        MemberTarget::Common { field } -> common(syntax, field)
        MemberTarget::Payload { field } -> payload(syntax, field)
        _ -> none()
    }

    machine common(syntax: &SyntaxTrees, field: u64 in Trapping) -> u64 in Trapping {
        let declared: DataField = SyntaxTrees::field(syntax, field);
        declared.type_reference
    }

    machine payload(syntax: &SyntaxTrees, field: u64 in Trapping) -> u64 in Trapping {
        let declared: DataField = SyntaxTrees::payload_field(syntax, field);
        declared.type_reference
    }

    machine none() -> u64 in Trapping {
        18446744073709551615
    }
}

// A primitive byte predicate (wiki/spec/terminal-psi/byte_views.md) applies
// to one byte view, a `u8` slice or array or a reference to one, and is a
// Boolean.
// `size_of<T>()` and `align_of<T>()` query a data layout
// (wiki/spec/language/counts_and_addresses.md): one static type argument,
// no value arguments, and a `u64` result.
machine Typer::type_layout_query(typer: &mut Typer, syntax: &SyntaxTrees, index: u64 in Trapping, expression: Expression, statics: StaticArguments)
crashes Trap
{
    let mut count_row: TypeRow = TypeRow::of(TypeKind::Builtin);
    count_row.builtin = BuiltinType::U64;
    let count: u64 in Trapping = Typer::intern(typer, count_row, expression.source_span);
    Typing::set_expression_type(&mut typer.output, index, count);
    transition statics.count == 1 {
        true -> arguments(typer, expression)
        _ -> reject(typer, expression, TypeDiagnosticCode::GenericArgumentCount)
    }

    machine arguments(typer: &mut Typer, expression: Expression) {
        transition expression.count == 0 {
            true -> done()
            _ -> reject(typer, expression, TypeDiagnosticCode::NoMatchingMachine)
        }
    }

    machine reject(typer: &mut Typer, expression: Expression, code: TypeDiagnosticCode) {
        Typing::reject(&mut typer.output, code, expression.source_span);
    }

    machine done() {}
}

machine Typer::type_byte_predicate(typer: &mut Typer, syntax: &SyntaxTrees, index: u64 in Trapping, expression: Expression)
crashes Trap
{
    let boolean: u64 in Trapping = typer.output.boolean;
    Typing::set_expression_type(&mut typer.output, index, boolean);
    transition expression.count == 1 {
        true -> argument(typer, syntax, expression)
        _ -> reject(typer, expression)
    }

    machine argument(typer: &mut Typer, syntax: &SyntaxTrees, expression: Expression) {
        let handle: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first);
        let viewed: u64 in Trapping = Typing::expression_type(&typer.output, handle);
        let referent: u64 in Trapping = Typer::referent(typer, viewed);
        let view: TypeRow = TypeTable::row(&typer.output.types, referent);
        let element: TypeRow = TypeTable::row(&typer.output.types, view.inner);
        let bytes: bool = (view.kind == TypeKind::Slice || view.kind == TypeKind::Array)
            && element.kind == TypeKind::Builtin && element.builtin == BuiltinType::U8;
        transition bytes {
            true -> done()
            _ -> reject(typer, expression)
        }
    }

    machine reject(typer: &mut Typer, expression: Expression) {
        Typing::reject(&mut typer.output, TypeDiagnosticCode::NoMatchingMachine, expression.source_span);
    }

    machine done() {}
}
