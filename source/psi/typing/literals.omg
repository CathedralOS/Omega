use psi::resolution::resolution;
use psi::source::source;
use psi::types::types;
use psi::typing::typer;

// Integer literal spellings and anonymous integer values
// (wiki/spec/language/numeric_values.md#literal-landing-and-destinations).
// A spelling is an optional `0b`/`0o`/`0x` base prefix, digits of that base
// with `_` separators, and an optional carrier suffix. A suffixed literal is
// typed at its suffix; an unsuffixed one is anonymous until it lands. Values
// stay exact: a magnitude past 2^64 - 1 rejects instead of wrapping.

pub data LiteralValue [copy] {
    valid: bool;
    has_suffix: bool;
    suffix: BuiltinType;
    magnitude: u64 in Wrapping;
}

pub machine Typer::literal_value(sources: &SourceSet, span: SourceSpan) -> LiteralValue
crashes Trap
{
    let first: u8 = SourceSet::byte_or_nul(sources, span.source, span.span.start);
    let second: u8 = SourceSet::byte_or_nul(sources, span.source, span.span.start + 1);
    let prefixed: bool = first == 48 && span.span.start + 2 <= span.span.end;
    transition prefixed {
        true -> prefix(sources, span, second)
        _ -> digits(sources, span, span.span.start, 10, 0, false)
    }

    state prefix(sources: &SourceSet, span: SourceSpan, second: u8) -> LiteralValue {
        transition second == 98 || second == 66 {
            true -> digits(sources, span, span.span.start + 2, 2, 0, false)
            _ -> octal(sources, span, second)
        }
    }

    state octal(sources: &SourceSet, span: SourceSpan, second: u8) -> LiteralValue {
        transition second == 111 || second == 79 {
            true -> digits(sources, span, span.span.start + 2, 8, 0, false)
            _ -> hexadecimal(sources, span, second)
        }
    }

    state hexadecimal(sources: &SourceSet, span: SourceSpan, second: u8) -> LiteralValue {
        transition second == 120 || second == 88 {
            true -> digits(sources, span, span.span.start + 2, 16, 0, false)
            _ -> digits(sources, span, span.span.start, 10, 0, false)
        }
    }

    state digits(
        sources: &SourceSet,
        span: SourceSpan,
        index: u64 in Trapping,
        base: u64 in Wrapping,
        magnitude: u64 in Wrapping,
        seen: bool
    ) -> LiteralValue {
        transition index < span.span.end {
            true -> digit(sources, span, index, base, magnitude, seen)
            _ -> finish(seen, magnitude)
        }
    }

    state digit(
        sources: &SourceSet,
        span: SourceSpan,
        index: u64 in Trapping,
        base: u64 in Wrapping,
        magnitude: u64 in Wrapping,
        seen: bool
    ) -> LiteralValue {
        let byte: u8 = SourceSet::byte_or_nul(sources, span.source, index);
        let value: u64 in Wrapping = Typer::digit_value(byte);
        transition byte == 95 {
            true -> digits(sources, span, index + 1, base, magnitude, seen)
            _ -> digit_in_base(sources, span, index, base, magnitude, seen, value)
        }
    }

    state digit_in_base(
        sources: &SourceSet,
        span: SourceSpan,
        index: u64 in Trapping,
        base: u64 in Wrapping,
        magnitude: u64 in Wrapping,
        seen: bool,
        value: u64 in Wrapping
    ) -> LiteralValue {
        transition value < base {
            true -> accumulate(sources, span, index, base, magnitude, value)
            _ -> suffix(sources, span, index, seen, magnitude)
        }
    }

    state accumulate(
        sources: &SourceSet,
        span: SourceSpan,
        index: u64 in Trapping,
        base: u64 in Wrapping,
        magnitude: u64 in Wrapping,
        value: u64 in Wrapping
    ) -> LiteralValue {
        let limit: u64 in Wrapping = (18446744073709551615 - value) / base;
        transition magnitude <= limit {
            true -> digits(sources, span, index + 1, base, magnitude * base + value, true)
            _ -> invalid()
        }
    }

    state suffix(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, seen: bool, magnitude: u64 in Wrapping) -> LiteralValue {
        let rest: SourceSpan = SourceSpan { source: span.source, span: Span { start: index, end: span.span.end } };
        let carrier: SuffixCarrier = Typer::suffix_carrier(sources, rest);
        transition seen && carrier.known {
            true -> suffixed(carrier.builtin, magnitude)
            _ -> invalid()
        }
    }

    state finish(seen: bool, magnitude: u64 in Wrapping) -> LiteralValue {
        transition seen {
            true -> plain(magnitude)
            _ -> invalid()
        }
    }

    state plain(magnitude: u64 in Wrapping) -> LiteralValue {
        LiteralValue { valid: true, has_suffix: false, suffix: BuiltinType::U64, magnitude: magnitude }
    }

    state suffixed(builtin: BuiltinType, magnitude: u64 in Wrapping) -> LiteralValue {
        LiteralValue { valid: true, has_suffix: true, suffix: builtin, magnitude: magnitude }
    }

    state invalid() -> LiteralValue {
        LiteralValue { valid: false, has_suffix: false, suffix: BuiltinType::U64, magnitude: 0 }
    }
}

// A digit byte's value in any base up to 16, or 16 when it is no digit.
machine Typer::digit_value(byte: u8) -> u64 in Wrapping {
    transition byte >= 48 && byte <= 57 {
        true -> decimal(byte)
        _ -> lower(byte)
    }

    state decimal(byte: u8) -> u64 in Wrapping {
        (byte as u64 in Wrapping) - 48
    }

    state lower(byte: u8) -> u64 in Wrapping {
        transition byte >= 97 && byte <= 102 {
            true -> lower_value(byte)
            _ -> upper(byte)
        }
    }

    state lower_value(byte: u8) -> u64 in Wrapping {
        (byte as u64 in Wrapping) - 87
    }

    state upper(byte: u8) -> u64 in Wrapping {
        transition byte >= 65 && byte <= 70 {
            true -> upper_value(byte)
            _ -> none()
        }
    }

    state upper_value(byte: u8) -> u64 in Wrapping {
        (byte as u64 in Wrapping) - 55
    }

    state none() -> u64 in Wrapping {
        16
    }
}

pub data SuffixCarrier [copy] {
    known: bool;
    builtin: BuiltinType;
}

// The fixed-integer carrier a literal suffix names.
machine Typer::suffix_carrier(sources: &SourceSet, rest: SourceSpan) -> SuffixCarrier
crashes Trap
{
    let u8_suffix: bool = SourceSet::span_spells(sources, rest, "u8");
    let u16_suffix: bool = SourceSet::span_spells(sources, rest, "u16");
    let u32_suffix: bool = SourceSet::span_spells(sources, rest, "u32");
    let u64_suffix: bool = SourceSet::span_spells(sources, rest, "u64");
    let i8_suffix: bool = SourceSet::span_spells(sources, rest, "i8");
    let i16_suffix: bool = SourceSet::span_spells(sources, rest, "i16");
    let i32_suffix: bool = SourceSet::span_spells(sources, rest, "i32");
    let i64_suffix: bool = SourceSet::span_spells(sources, rest, "i64");
    transition u8_suffix {
        true -> known(BuiltinType::U8)
        _ -> second(u16_suffix, u32_suffix, u64_suffix, i8_suffix, i16_suffix, i32_suffix, i64_suffix)
    }

    state second(u16_suffix: bool, u32_suffix: bool, u64_suffix: bool, i8_suffix: bool, i16_suffix: bool, i32_suffix: bool, i64_suffix: bool) -> SuffixCarrier {
        transition u16_suffix {
            true -> known(BuiltinType::U16)
            _ -> third(u32_suffix, u64_suffix, i8_suffix, i16_suffix, i32_suffix, i64_suffix)
        }
    }

    state third(u32_suffix: bool, u64_suffix: bool, i8_suffix: bool, i16_suffix: bool, i32_suffix: bool, i64_suffix: bool) -> SuffixCarrier {
        transition u32_suffix {
            true -> known(BuiltinType::U32)
            _ -> fourth(u64_suffix, i8_suffix, i16_suffix, i32_suffix, i64_suffix)
        }
    }

    state fourth(u64_suffix: bool, i8_suffix: bool, i16_suffix: bool, i32_suffix: bool, i64_suffix: bool) -> SuffixCarrier {
        transition u64_suffix {
            true -> known(BuiltinType::U64)
            _ -> fifth(i8_suffix, i16_suffix, i32_suffix, i64_suffix)
        }
    }

    state fifth(i8_suffix: bool, i16_suffix: bool, i32_suffix: bool, i64_suffix: bool) -> SuffixCarrier {
        transition i8_suffix {
            true -> known(BuiltinType::I8)
            _ -> sixth(i16_suffix, i32_suffix, i64_suffix)
        }
    }

    state sixth(i16_suffix: bool, i32_suffix: bool, i64_suffix: bool) -> SuffixCarrier {
        transition i16_suffix {
            true -> known(BuiltinType::I16)
            _ -> seventh(i32_suffix, i64_suffix)
        }
    }

    state seventh(i32_suffix: bool, i64_suffix: bool) -> SuffixCarrier {
        transition i32_suffix {
            true -> known(BuiltinType::I32)
            _ -> eighth(i64_suffix)
        }
    }

    state eighth(i64_suffix: bool) -> SuffixCarrier {
        transition i64_suffix {
            true -> known(BuiltinType::I64)
            _ -> unknown()
        }
    }

    state known(builtin: BuiltinType) -> SuffixCarrier {
        SuffixCarrier { known: true, builtin: builtin }
    }

    state unknown() -> SuffixCarrier {
        SuffixCarrier { known: false, builtin: BuiltinType::U64 }
    }
}

// The bytes a quoted literal spells between its quotes, each escape one
// byte: `\xNN` four characters, any other escape two
// (wiki/spec/language/data_and_literals.md#quoted-bytes).
// The primitive byte predicates a quoted literal's octets satisfy, as the
// roster bits `Typing::rosters` keeps (`valid_utf8` 1, `no_nul` 2,
// `ascii_only` 4, `non_empty` 8), decided over the literal's bytes with its
// escapes decoded as the lexer decodes them. UTF-8 validity follows the
// encoding's lead-byte classes: a lead owes `pending` continuation bytes,
// the first of them within `low..=high`, and no sequence may be left open.
pub machine Typer::quoted_roster(sources: &SourceSet, span: SourceSpan) -> u64 in Trapping
crashes Trap
{
    transition span.span.start + 2 <= span.span.end {
        true -> next(sources, span, span.span.start + 1, span.span.end - 1, 0, 128, 191, true, true, true, false)
        _ -> finished(0, true, true, true, false)
    }

    state next(
        sources: &SourceSet,
        span: SourceSpan,
        index: u64 in Trapping,
        end: u64 in Trapping,
        pending: u64 in Trapping,
        low: u64 in Trapping,
        high: u64 in Trapping,
        utf8: bool,
        nul_free: bool,
        ascii: bool,
        any: bool
    ) -> u64 in Trapping {
        transition index < end {
            true -> byte(sources, span, index, end, pending, low, high, utf8, nul_free, ascii, any)
            _ -> finished(pending, utf8, nul_free, ascii, any)
        }
    }

    state byte(
        sources: &SourceSet,
        span: SourceSpan,
        index: u64 in Trapping,
        end: u64 in Trapping,
        pending: u64 in Trapping,
        low: u64 in Trapping,
        high: u64 in Trapping,
        utf8: bool,
        nul_free: bool,
        ascii: bool,
        any: bool
    ) -> u64 in Trapping {
        let source_byte: u8 = SourceSet::byte_or_nul(sources, span.source, index);
        let value: u64 in Trapping = source_byte as u64 in Trapping;
        transition source_byte == 92 {
            true -> escaped(sources, span, index, end, pending, low, high, utf8, nul_free, ascii, any)
            _ -> decoded(sources, span, index + 1, end, value, pending, low, high, utf8, nul_free, ascii, any)
        }
    }

    state escaped(
        sources: &SourceSet,
        span: SourceSpan,
        index: u64 in Trapping,
        end: u64 in Trapping,
        pending: u64 in Trapping,
        low: u64 in Trapping,
        high: u64 in Trapping,
        utf8: bool,
        nul_free: bool,
        ascii: bool,
        any: bool
    ) -> u64 in Trapping {
        let kind: u8 = SourceSet::byte_or_nul(sources, span.source, index + 1);
        let first: u8 = SourceSet::byte_or_nul(sources, span.source, index + 2);
        let second: u8 = SourceSet::byte_or_nul(sources, span.source, index + 3);
        let hex: u64 in Trapping = Typer::hex_value(first) * 16 + Typer::hex_value(second);
        let simple: u64 in Trapping = Typer::escape_byte(kind);
        transition kind == 120 {
            true -> decoded(sources, span, index + 4, end, hex, pending, low, high, utf8, nul_free, ascii, any)
            _ -> decoded(sources, span, index + 2, end, simple, pending, low, high, utf8, nul_free, ascii, any)
        }
    }

    state decoded(
        sources: &SourceSet,
        span: SourceSpan,
        index: u64 in Trapping,
        end: u64 in Trapping,
        value: u64 in Trapping,
        pending: u64 in Trapping,
        low: u64 in Trapping,
        high: u64 in Trapping,
        utf8: bool,
        nul_free: bool,
        ascii: bool,
        any: bool
    ) -> u64 in Trapping {
        let nul_ok: bool = nul_free && value != 0;
        let ascii_ok: bool = ascii && value < 128;
        transition pending > 0 {
            true -> continuation(sources, span, index, end, value, pending, low, high, utf8, nul_ok, ascii_ok)
            _ -> lead(sources, span, index, end, value, utf8, nul_ok, ascii_ok)
        }
    }

    state continuation(
        sources: &SourceSet,
        span: SourceSpan,
        index: u64 in Trapping,
        end: u64 in Trapping,
        value: u64 in Trapping,
        pending: u64 in Trapping,
        low: u64 in Trapping,
        high: u64 in Trapping,
        utf8: bool,
        nul_free: bool,
        ascii: bool
    ) -> u64 in Trapping {
        let fits: bool = value >= low && value <= high;
        transition { _ -> next(sources, span, index, end, pending - 1, 128, 191, utf8 && fits, nul_free, ascii, true) }
    }

    state lead(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, value: u64 in Trapping, utf8: bool, nul_free: bool, ascii: bool) -> u64 in Trapping {
        transition value < 128 {
            true -> next(sources, span, index, end, 0, 128, 191, utf8, nul_free, ascii, true)
            _ -> two(sources, span, index, end, value, utf8, nul_free, ascii)
        }
    }

    state two(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, value: u64 in Trapping, utf8: bool, nul_free: bool, ascii: bool) -> u64 in Trapping {
        transition value >= 194 && value <= 223 {
            true -> next(sources, span, index, end, 1, 128, 191, utf8, nul_free, ascii, true)
            _ -> three(sources, span, index, end, value, utf8, nul_free, ascii)
        }
    }

    state three(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, value: u64 in Trapping, utf8: bool, nul_free: bool, ascii: bool) -> u64 in Trapping {
        transition value == 224 {
            true -> next(sources, span, index, end, 2, 160, 191, utf8, nul_free, ascii, true)
            _ -> three_plain(sources, span, index, end, value, utf8, nul_free, ascii)
        }
    }

    state three_plain(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, value: u64 in Trapping, utf8: bool, nul_free: bool, ascii: bool) -> u64 in Trapping {
        transition (value >= 225 && value <= 236) || value == 238 || value == 239 {
            true -> next(sources, span, index, end, 2, 128, 191, utf8, nul_free, ascii, true)
            _ -> three_surrogate(sources, span, index, end, value, utf8, nul_free, ascii)
        }
    }

    state three_surrogate(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, value: u64 in Trapping, utf8: bool, nul_free: bool, ascii: bool) -> u64 in Trapping {
        transition value == 237 {
            true -> next(sources, span, index, end, 2, 128, 159, utf8, nul_free, ascii, true)
            _ -> four(sources, span, index, end, value, utf8, nul_free, ascii)
        }
    }

    state four(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, value: u64 in Trapping, utf8: bool, nul_free: bool, ascii: bool) -> u64 in Trapping {
        transition value == 240 {
            true -> next(sources, span, index, end, 3, 144, 191, utf8, nul_free, ascii, true)
            _ -> four_plain(sources, span, index, end, value, utf8, nul_free, ascii)
        }
    }

    state four_plain(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, value: u64 in Trapping, utf8: bool, nul_free: bool, ascii: bool) -> u64 in Trapping {
        transition value >= 241 && value <= 243 {
            true -> next(sources, span, index, end, 3, 128, 191, utf8, nul_free, ascii, true)
            _ -> four_last(sources, span, index, end, value, utf8, nul_free, ascii)
        }
    }

    state four_last(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, value: u64 in Trapping, utf8: bool, nul_free: bool, ascii: bool) -> u64 in Trapping {
        transition value == 244 {
            true -> next(sources, span, index, end, 3, 128, 143, utf8, nul_free, ascii, true)
            _ -> next(sources, span, index, end, 0, 128, 191, false, nul_free, ascii, true)
        }
    }

    state finished(pending: u64 in Trapping, utf8: bool, nul_free: bool, ascii: bool, any: bool) -> u64 in Trapping {
        let roster: u64 in Trapping = Typer::roster_bits(utf8 && pending == 0, nul_free, ascii, any);
        roster
    }
}

// The roster bits for the predicates that hold.
machine Typer::roster_bits(utf8: bool, nul_free: bool, ascii: bool, any: bool) -> u64 in Trapping
crashes Trap
{
    transition utf8 {
        true -> nul(1, nul_free, ascii, any)
        _ -> nul(0, nul_free, ascii, any)
    }

    state nul(bits: u64 in Trapping, nul_free: bool, ascii: bool, any: bool) -> u64 in Trapping {
        transition nul_free {
            true -> ascii_bit(bits + 2, ascii, any)
            _ -> ascii_bit(bits, ascii, any)
        }
    }

    state ascii_bit(bits: u64 in Trapping, ascii: bool, any: bool) -> u64 in Trapping {
        transition ascii {
            true -> any_bit(bits + 4, any)
            _ -> any_bit(bits, any)
        }
    }

    state any_bit(bits: u64 in Trapping, any: bool) -> u64 in Trapping {
        transition any {
            true -> answer(bits + 8)
            _ -> answer(bits)
        }
    }

    state answer(bits: u64 in Trapping) -> u64 in Trapping {
        bits
    }
}

// The byte a simple escape `\k` decodes to, as the lexer decodes it.
machine Typer::escape_byte(kind: u8) -> u64 in Trapping
crashes Trap
{
    transition kind {
        110 -> answer(10)
        114 -> answer(13)
        116 -> answer(9)
        48 -> answer(0)
        _ -> answer(kind as u64 in Trapping)
    }

    state answer(byte: u64 in Trapping) -> u64 in Trapping {
        byte
    }
}

// A hexadecimal digit's value; zero for any other byte.
machine Typer::hex_value(byte: u8) -> u64 in Trapping
crashes Trap
{
    let value: u64 in Trapping = byte as u64 in Trapping;
    transition value >= 48 && value <= 57 {
        true -> answer(value - 48)
        _ -> letter(value)
    }

    state letter(value: u64 in Trapping) -> u64 in Trapping {
        transition value >= 97 && value <= 102 {
            true -> answer(value - 87)
            _ -> upper(value)
        }
    }

    state upper(value: u64 in Trapping) -> u64 in Trapping {
        transition value >= 65 && value <= 70 {
            true -> answer(value - 55)
            _ -> answer(0)
        }
    }

    state answer(value: u64 in Trapping) -> u64 in Trapping {
        value
    }
}

pub machine Typer::quoted_length(sources: &SourceSet, span: SourceSpan) -> u64 in Trapping
crashes Trap
{
    transition span.span.start + 2 <= span.span.end {
        true -> next(sources, span, span.span.start + 1, span.span.end - 1, 0)
        _ -> answer(0)
    }

    state next(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping {
        transition index < end {
            true -> byte(sources, span, index, end, count)
            _ -> answer(count)
        }
    }

    state byte(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping {
        let byte: u8 = SourceSet::byte_or_nul(sources, span.source, index);
        transition byte == 92 {
            true -> escape(sources, span, index, end, count)
            _ -> next(sources, span, index + 1, end, count + 1)
        }
    }

    state escape(sources: &SourceSet, span: SourceSpan, index: u64 in Trapping, end: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping {
        let kind: u8 = SourceSet::byte_or_nul(sources, span.source, index + 1);
        transition kind == 120 {
            true -> next(sources, span, index + 4, end, count + 1)
            _ -> next(sources, span, index + 2, end, count + 1)
        }
    }

    state answer(count: u64 in Trapping) -> u64 in Trapping {
        count
    }
}
