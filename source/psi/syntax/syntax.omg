// The type row of one trait parent, by its index in `trait_parents`.
pub machine SyntaxTrees::trait_parent(syntax_trees: &SyntaxTrees, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < syntax_trees.trait_parent_count {
        true -> read(syntax_trees, index)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, index: u64 in Trapping) -> u64 in Trapping {
        syntax_trees.trait_parents[index] as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// The authored name of a data member: a direct field's name or a case's name.
pub machine SyntaxTrees::member_name(syntax_trees: &SyntaxTrees, member: DataMember) -> IdentifierSpan
crashes Trap
{
    transition member.kind {
        DataMemberKind::Field -> field_name(syntax_trees, member.item_index)
        DataMemberKind::Case -> case_name(syntax_trees, member.item_index)
    }

    state field_name(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        let field: DataField = SyntaxTrees::field(syntax_trees, handle);
        field.name
    }

    state case_name(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        let data_case: DataCase = SyntaxTrees::data_case(syntax_trees, handle);
        data_case.name
    }
}

// The lifetime argument at `index` in `type_lifetimes`.
pub machine SyntaxTrees::type_lifetime(syntax_trees: &SyntaxTrees, index: u64 in Trapping) -> IdentifierSpan
crashes Trap
{
    transition index < syntax_trees.type_lifetime_count && index < 1024 {
        true -> read(syntax_trees, index)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, index: u64 in Trapping) -> IdentifierSpan
    requires index < 1024
    {
        syntax_trees.type_lifetimes[index]
    }

    state invalid() -> IdentifierSpan {
        crash Trap;
    }
}
