    transition handle < syntax_trees.constant_count {
        true -> read(syntax_trees, handle)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        syntax_trees.constants[handle]
    }

    state invalid() -> ConstantItem {
        crash Trap;
    }
}

pub machine SyntaxTrees::proposition_item(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> PropositionItem
crashes Trap
{
    transition handle < syntax_trees.proposition_count {
        true -> read(syntax_trees, handle)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        syntax_trees.propositions[handle]
    }

    state invalid() -> PropositionItem {
        crash Trap;
    }
}

