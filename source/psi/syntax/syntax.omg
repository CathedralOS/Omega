// The values one expression joins into one type: a value-position match's
// arm values (`arms`), or a fixed-array literal's elements.
pub data JoinedValues [copy] {
    arms: bool;
    first: u64 in Trapping;
    count: u64 in Trapping;
}

// The values a match or an array literal joins.
pub machine SyntaxTrees::joined_values(expression: Expression) -> JoinedValues {
    let arms: bool = expression.kind == ExpressionKind::Match;
    JoinedValues { arms: arms, first: expression.first, count: expression.count }
}

// The value `offset` of a join: an arm's value or an element.
pub machine SyntaxTrees::joined_value(syntax_trees: &SyntaxTrees, values: JoinedValues, offset: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition values.arms {
        true -> arm(syntax_trees, values.first + offset)
        _ -> element(syntax_trees, values.first + offset)
    }

    state arm(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping {
        let arm: TransitionArm = SyntaxTrees::match_arm(syntax_trees, handle);
        arm.target
    }

    state element(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping {
        let value: u64 in Trapping = SyntaxTrees::argument(syntax_trees, handle);
        value
    }
}

// A dispatch's arms: a transition's in `arms`, or, `matched`, a
// value-position match's in `match_arms`.
pub data ArmRange [copy] {
    matched: bool;
    first: u64 in Trapping;
    count: u64 in Trapping;
}

// The arm `offset` of a dispatch's range.
pub machine SyntaxTrees::range_arm(syntax_trees: &SyntaxTrees, range: ArmRange, offset: u64 in Trapping) -> TransitionArm
crashes Trap
{
    transition range.matched {
        true -> matched(syntax_trees, range.first + offset)
        _ -> transitioned(syntax_trees, range.first + offset)
    }

    state matched(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> TransitionArm {
        let arm: TransitionArm = SyntaxTrees::match_arm(syntax_trees, handle);
        arm
    }

    state transitioned(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> TransitionArm {
        let arm: TransitionArm = SyntaxTrees::arm(syntax_trees, handle);
        arm
    }
}

// One arm of a value-position match: a `Wildcard`, `Literal` or `Case`
// value pattern whose `Value` target is the arm's value. Match arms keep
// their own table, so a match nested in a transition arm never splits that
// transition's contiguous arm range.
pub machine SyntaxTrees::match_arm(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> TransitionArm
crashes Trap
{
    transition handle < syntax_trees.match_arm_count {
        true -> read(syntax_trees, handle)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        syntax_trees.match_arms[handle]
    }

    state invalid() -> TransitionArm {
        crash Trap;
    }
}

