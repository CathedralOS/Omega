// The type row of one static argument, by its index in `type_arguments`.
pub machine SyntaxTrees::type_argument(syntax_trees: &SyntaxTrees, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < syntax_trees.type_argument_count {
        true -> read(syntax_trees, index)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, index: u64 in Trapping) -> u64 in Trapping {
        syntax_trees.type_arguments[index] as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

