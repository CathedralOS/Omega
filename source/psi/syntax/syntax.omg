// A type reference's `in` qualifier as written: its owner path, if any,
// through its name.
pub machine TypeReference::qualifier_span(reference: TypeReference) -> SourceSpan {
    transition reference.has_domain_owner {
        true -> owned(reference)
        _ -> bare(reference)
    }

    state owned(reference: TypeReference) -> SourceSpan {
        SourceSpan {
            source: reference.domain.source_span.source,
            span: Span { start: reference.domain_owner.source_span.span.start, end: reference.domain.source_span.span.end }
        }
    }

    state bare(reference: TypeReference) -> SourceSpan {
        reference.domain.source_span
    }
}

