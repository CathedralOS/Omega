use psi::source::source;

// Bounded source-shaped storage for the live product parser slices. Handles
// are dense indices into owner-local tables; no symbol or package meaning is
// assigned here.

pub data IdentifierSpan [copy] {
    source_span: SourceSpan;
}

pub data UseItem [copy] {
    first_member: u64 in Trapping;
    member_count: u64 in Trapping;
    source_span: SourceSpan;
}

pub data TypeReferenceKind [copy] {
    case Named;
    case Reference;
    case Array;
    case Slice;
    case Literal;
}

pub data ReferenceAccess [copy] {
    case Shared;
    case Mutable;
}

// One row per type form. A whole type fills a contiguous run of rows that
// ends at its root: every row follows its children, and `first_row` is where
// its own run begins. `Named` carries its `name`; an application
// (`Binding<Console>`) also carries `argument_count` argument rows listed in
// `SyntaxTrees::type_arguments` from `first_argument`. `Reference` (`&T`,
// `&mut T`) carries its `access`. `Reference`, `Array` (`[T; N]`) and
// `Slice` (`[T]`) name their referee or element in `inner`, and `Array` names
// its length row, a `Literal` or a `Named` static value, in `length`.
// `Literal` is an integer static argument or length spelled by `name`.
// `Named`, `Array` and `Slice` rows may carry an `in Domain` qualifier.
// Fields a form does not carry are zero.
pub data TypeReference [copy] {
    kind: TypeReferenceKind;
    name: IdentifierSpan;
    has_domain: bool;
    domain: IdentifierSpan;
    access: ReferenceAccess;
    inner: u64 in Trapping;
    length: u64 in Trapping;
    first_argument: u64 in Trapping;
    argument_count: u64 in Trapping;
    first_row: u64 in Trapping;
    source_span: SourceSpan;
}

pub data DataField [copy] {
    name: IdentifierSpan;
    type_reference: u64 in Trapping;
    source_span: SourceSpan;
}

pub data DataCase [copy] {
    name: IdentifierSpan;
    first_payload_field: u64 in Trapping;
    payload_field_count: u64 in Trapping;
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    source_span: SourceSpan;
}

pub data DataMemberKind [copy] {
    case Field;
    case Case;
}

pub data DataMember [copy] {
    kind: DataMemberKind;
    item_index: u64 in Trapping;
    source_span: SourceSpan;
}

pub data DataMultiplicity [copy] {
    case Affine;
    case Unrestricted;
    case Linear;
}

pub data GenericParameterKind [copy] {
    case Lifetime;
    case Type;
    case Const;
    case Value;
    case Machine;
}

// One declared generic parameter on a `data` header: `'a`, `T`,
// `const N: Ty`, `u: Ty`, or `machine M`, with its property bounds.
pub data GenericParameter [copy] {
    kind: GenericParameterKind;
    name: IdentifierSpan;
    has_type_reference: bool;
    type_reference: u64 in Trapping;
    bounds: DataMultiplicity;
    source_span: SourceSpan;
}

pub data DataItem [copy] {
    name: IdentifierSpan;
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    first_member: u64 in Trapping;
    member_count: u64 in Trapping;
    first_field: u64 in Trapping;
    field_count: u64 in Trapping;
    first_case: u64 in Trapping;
    case_count: u64 in Trapping;
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    multiplicity: DataMultiplicity;
    is_public: bool;
    source_span: SourceSpan;
}

// One typed parameter of a machine or state: `name: Type`.
pub data Parameter [copy] {
    name: IdentifierSpan;
    type_reference: u64 in Trapping;
    source_span: SourceSpan;
}

// Expression syntax. Children are handles into `SyntaxTrees::expressions`;
// a parenthesized group adds no node. `first`/`count` select a kind's range:
// a path's or call's callee members in `SyntaxTrees::members`, a call's
// arguments in `SyntaxTrees::arguments`, or a construction's fields in
// `SyntaxTrees::construct_fields` (its type path then lives in `left`'s
// members through a Path or Name child). Unused fields of a kind are zero.
pub data ExpressionKind [copy] {
    case Name;
    case Path;
    case Integer;
    case Boolean;
    case String;
    case Field;
    case Index;
    case Unary;
    case Apply;
    case Binary;
    case Cast;
    case Call;
    case Construct;
}

pub data OperatorKind [copy] {
    case None;
    case Or;
    case And;
    case Equal;
    case NotEqual;
    case Less;
    case LessEqual;
    case Greater;
    case GreaterEqual;
    case BitOr;
    case BitXor;
    case BitAnd;
    case ShiftLeft;
    case ShiftRight;
    case Add;
    case Subtract;
    case Multiply;
    case Divide;
    case Modulo;
    case Not;
    case Negate;
    case BitNot;
    case Borrow;
    case BorrowMutable;
    case Suspend;
    case Block;
    case SuspendBlock;
}

pub data Expression [copy] {
    kind: ExpressionKind;
    operator: OperatorKind;
    left: u64 in Trapping;
    right: u64 in Trapping;
    first: u64 in Trapping;
    count: u64 in Trapping;
    flag: bool;
    name: IdentifierSpan;
    type_reference: u64 in Trapping;
    first_row: u64 in Trapping;
    source_span: SourceSpan;
}

// One `name: value` field of a construction `Path { name: value, ... }`.
pub data ConstructField [copy] {
    name: IdentifierSpan;
    value: u64 in Trapping;
    source_span: SourceSpan;
}

pub data CrashCause [copy] {
    case Trap;
    case Abort;
}

// Statement syntax. `Let` declares `name` with a type and an optional
// initializer in `value`; `Assign` stores `value` into the place `target`;
// `Expression` evaluates `value` for its effect; `Tail` is a body's final
// unterminated expression, its result; `Crash` ends the body with `cause`;
// `Transition` selects among its arms, over the subject in `value` when
// `has_value` holds.
pub data StatementKind [copy] {
    case Let;
    case Assign;
    case Expression;
    case Tail;
    case Crash;
    case Transition;
}

// One arm of a `transition` block. `Guard` arms (subjectless blocks) hold a
// Boolean expression in `pattern`; `Wildcard` is `_`; `Literal` holds a
// literal pattern expression; `Case` holds the case path expression and a
// contiguous range of `SyntaxTrees::pattern_fields`. `target` is the
// successor call expression, or zero with `terminal` for `-> {}`.
pub data ArmPatternKind [copy] {
    case Guard;
    case Wildcard;
    case Literal;
    case Case;
}

pub data TransitionArm [copy] {
    kind: ArmPatternKind;
    pattern: u64 in Trapping;
    first_field: u64 in Trapping;
    field_count: u64 in Trapping;
    target: u64 in Trapping;
    terminal: bool;
    source_span: SourceSpan;
}

// One field of a case pattern: a binder (`keyword`) or a nested value
// (`punctuation: PunctuationKind::Comma`).
pub data PatternField [copy] {
    name: IdentifierSpan;
    has_value: bool;
    value: u64 in Trapping;
    source_span: SourceSpan;
}

pub data Statement [copy] {
    kind: StatementKind;
    name: IdentifierSpan;
    is_mutable: bool;
    type_reference: u64 in Trapping;
    has_value: bool;
    value: u64 in Trapping;
    target: u64 in Trapping;
    cause: CrashCause;
    first_arm: u64 in Trapping;
    arm_count: u64 in Trapping;
    source_span: SourceSpan;
}

// One clause between a declaration's head and its body. `Reaches` names
// services and `Invokes` a binding, both in `SyntaxTrees::members`; `Crashes`
// records its cause; `Requires`, `Ensures` and each `Where` fact hold a fact
// expression; `Suspends` and `Blocks` carry nothing more. Machines, states,
// data declarations and cases each own a contiguous range of clauses.
pub data ClauseKind [copy] {
    case Reaches;
    case Invokes;
    case Suspends;
    case Blocks;
    case Crashes;
    case Requires;
    case Ensures;
    case Where;
}

pub data ClauseOwner [copy] {
    case Machine;
    case State;
    case Data;
    case DataCase;
}

pub data Clause [copy] {
    kind: ClauseKind;
    first_member: u64 in Trapping;
    member_count: u64 in Trapping;
    cause: CrashCause;
    expression: u64 in Trapping;
    source_span: SourceSpan;
}

// A named state member of a machine body. Its parameters are a contiguous
// range of `SyntaxTrees::parameters`.
pub data StateItem [copy] {
    name: IdentifierSpan;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    has_return_type: bool;
    return_type: u64 in Trapping;
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    first_statement: u64 in Trapping;
    statement_count: u64 in Trapping;
    source_span: SourceSpan;
}

// A `machine` declaration. `Owner::name` records the owner path member;
// a free-standing machine has no owner and an empty owner span. The
// parameters and return type are the entry's signature; `first_state` and
// `state_count` cover the authored `state` members; the entry's own
// statements precede them in the body.
pub data MachineItem [copy] {
    has_owner: bool;
    owner: IdentifierSpan;
    name: IdentifierSpan;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    has_return_type: bool;
    return_type: u64 in Trapping;
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    first_statement: u64 in Trapping;
    statement_count: u64 in Trapping;
    first_state: u64 in Trapping;
    state_count: u64 in Trapping;
    is_public: bool;
    source_span: SourceSpan;
}

pub data RootItemKind [copy] {
    case Use;
    case Data;
    case Machine;
}

pub data RootItem [copy] {
    kind: RootItemKind;
    item_index: u64 in Trapping;
    source_span: SourceSpan;
}

pub data ParseDiagnosticCode [copy] {
    case None;
    case LexicalInputRejected;
    case UnsupportedRootItem;
    case ExpectedPathMember;
    case ExpectedPathSeparatorOrSemicolon;
    case RootCapacityExceeded;
    case UseCapacityExceeded;
    case PathMemberCapacityExceeded;
    case TokenInputCapacityExceeded;
    case ExpectedItemAfterPub;
    case ExpectedDataName;
    case ExpectedDataBody;
    case ExpectedDataFieldColon;
    case ExpectedDataFieldType;
    case ExpectedDataFieldEnd;
    case DataCapacityExceeded;
    case DataFieldCapacityExceeded;
    case TypeReferenceCapacityExceeded;
    case ExpectedDataProperty;
    case ExpectedDataPropertyEnd;
    case ExpectedDataCaseName;
    case ExpectedDataCaseEnd;
    case DataMemberCapacityExceeded;
    case DataCaseCapacityExceeded;
    case ExpectedDataCasePayloadField;
    case ExpectedDataCasePayloadFieldColon;
    case ExpectedDataCasePayloadFieldType;
    case ExpectedDataCasePayloadSeparatorOrEnd;
    case DataCasePayloadFieldCapacityExceeded;
    case DuplicateDataMultiplicity;
    case ConflictingDataMultiplicity;
    case ExpectedTypeQualifierDomain;
    case ExpectedDataGenericParameter;
    case ExpectedDataGenericParameterName;
    case ExpectedDataGenericParameterColon;
    case ExpectedDataGenericParameterType;
    case ExpectedDataGenericParameterEnd;
    case DataGenericParameterCapacityExceeded;
    case DataGenericLifetimeOrdering;
    case ExpectedMachineName;
    case ExpectedMachineParameterOrEnd;
    case ExpectedMachineParameter;
    case ExpectedMachineParameterColon;
    case ExpectedMachineParameterType;
    case ExpectedMachineParameterEnd;
    case ExpectedMachineReturnType;
    case ExpectedMachineBody;
    case ExpectedMachineBodyEnd;
    case ExpectedStateName;
    case ExpectedStateBody;
    case ExpectedStateBodyEnd;
    case MachineCapacityExceeded;
    case ParameterCapacityExceeded;
    case StateCapacityExceeded;
    case ExpectedOperand;
    case ExpectedExpressionPathMember;
    case ExpectedFieldName;
    case ExpectedGroupEnd;
    case ExpectedIndexEnd;
    case ExpectedCallArgument;
    case ExpectedCallArgumentEnd;
    case ExpectedCastType;
    case ExpectedStructLiteralFieldOrEnd;
    case ExpectedStructLiteralFieldColon;
    case ExpectedStructLiteralValue;
    case ExpectedStructLiteralFieldEnd;
    case ExpressionCapacityExceeded;
    case ExpressionNestingExceeded;
    case ArgumentCapacityExceeded;
    case ConstructFieldCapacityExceeded;
    case ExpectedLocalDataName;
    case ExpectedLocalDataColon;
    case ExpectedLocalDataType;
    case ExpectedLocalDataInitialValue;
    case ExpectedLocalDataEnd;
    case ExpectedAssignmentValue;
    case ExpectedAssignmentSemicolon;
    case ExpectedStatementEnd;
    case ExpectedCrashCause;
    case ExpectedCrashEnd;
    case StatementCapacityExceeded;
    case ExpectedTransitionSubject;
    case ExpectedTransitionArm;
    case ExpectedTransitionArrow;
    case ExpectedTransitionTarget;
    case ExpectedTransitionTargetOpen;
    case ExpectedTransitionTargetClose;
    case ExpectedPatternField;
    case ExpectedPatternFieldEnd;
    case ArmCapacityExceeded;
    case PatternFieldCapacityExceeded;
    case ExpectedReachService;
    case ExpectedInvokesBinding;
    case ExpectedClauseEnd;
    case ExpectedClauseFact;
    case ClauseCapacityExceeded;
    case ExpectedArrayElementType;
    case ExpectedArraySeparatorOrEnd;
    case ExpectedArrayLength;
    case ExpectedArrayEnd;
    case ExpectedStaticArgument;
    case ExpectedStaticArgumentEnd;
    case TypeNestingCapacityExceeded;
    case TypeArgumentCapacityExceeded;
    case ClauseNotAdmitted;
    case DuplicateCallAcknowledgement;
    case CallAcknowledgementOrder;
}

pub data ParseDiagnostic [copy] {
    code: ParseDiagnosticCode;
    source_span: SourceSpan;
}

pub data SyntaxTrees
where
    root_count <= 256,
    use_count <= 256,
    member_count <= 8192,
    data_count <= 256,
    generic_parameter_count <= 256,
    field_count <= 1024,
    data_member_count <= 1024,
    case_count <= 512,
    payload_field_count <= 1024,
    type_reference_count <= 4096,
    type_argument_count <= 1024,
    machine_count <= 256,
    parameter_count <= 4096,
    state_count <= 2048,
    expression_count <= 8192,
    argument_count <= 4096,
    construct_field_count <= 2048,
    statement_count <= 4096,
    arm_count <= 4096,
    pattern_field_count <= 2048,
    clause_count <= 1024,
{
    roots: [RootItem; 256] in Trapping;
    root_count: u64;
    uses: [UseItem; 256] in Trapping;
    use_count: u64;
    members: [IdentifierSpan; 8192] in Trapping;
    member_count: u64;
    data_items: [DataItem; 256] in Trapping;
    data_count: u64;
    generic_parameters: [GenericParameter; 256] in Trapping;
    generic_parameter_count: u64;
    fields: [DataField; 1024] in Trapping;
    field_count: u64;
    data_members: [DataMember; 1024] in Trapping;
    data_member_count: u64;
    cases: [DataCase; 512] in Trapping;
    case_count: u64;
    payload_fields: [DataField; 1024] in Trapping;
    payload_field_count: u64;
    type_references: [TypeReference; 4096] in Trapping;
    type_reference_count: u64;
    type_arguments: [u64; 1024] in Trapping;
    type_argument_count: u64;
    machines: [MachineItem; 256] in Trapping;
    machine_count: u64;
    parameters: [Parameter; 4096] in Trapping;
    parameter_count: u64;
    states: [StateItem; 2048] in Trapping;
    state_count: u64;
    expressions: [Expression; 8192] in Trapping;
    expression_count: u64;
    arguments: [u64; 4096] in Trapping;
    argument_count: u64;
    construct_fields: [ConstructField; 2048] in Trapping;
    construct_field_count: u64;
    statements: [Statement; 4096] in Trapping;
    statement_count: u64;
    arms: [TransitionArm; 4096] in Trapping;
    arm_count: u64;
    pattern_fields: [PatternField; 2048] in Trapping;
    pattern_field_count: u64;
    clauses: [Clause; 1024] in Trapping;
    clause_count: u64;
    diagnostic: ParseDiagnostic;
    accepted: bool;
}

pub machine SyntaxTrees::clear(syntax_trees: &mut SyntaxTrees, source: SourceId) {
    syntax_trees.root_count = 0;
    syntax_trees.use_count = 0;
    syntax_trees.member_count = 0;
    syntax_trees.data_count = 0;
    syntax_trees.generic_parameter_count = 0;
    syntax_trees.field_count = 0;
    syntax_trees.data_member_count = 0;
    syntax_trees.case_count = 0;
    syntax_trees.payload_field_count = 0;
    syntax_trees.type_reference_count = 0;
    syntax_trees.type_argument_count = 0;
    syntax_trees.machine_count = 0;
    syntax_trees.parameter_count = 0;
    syntax_trees.state_count = 0;
    syntax_trees.expression_count = 0;
    syntax_trees.argument_count = 0;
    syntax_trees.construct_field_count = 0;
    syntax_trees.statement_count = 0;
    syntax_trees.arm_count = 0;
    syntax_trees.pattern_field_count = 0;
    syntax_trees.clause_count = 0;
    syntax_trees.accepted = true;
    syntax_trees.diagnostic.code = ParseDiagnosticCode::None;
    syntax_trees.diagnostic.source_span.source = source;
    syntax_trees.diagnostic.source_span.span.start = 0;
    syntax_trees.diagnostic.source_span.span.end = 0;
}

pub machine SyntaxTrees::reject(
    syntax_trees: &mut SyntaxTrees,
    code: ParseDiagnosticCode,
    source: SourceId,
    start: u64 in Trapping,
    end: u64 in Trapping
) {
    syntax_trees.accepted = false;
    syntax_trees.diagnostic.code = code;
    syntax_trees.diagnostic.source_span.source = source;
    syntax_trees.diagnostic.source_span.span.start = start;
    syntax_trees.diagnostic.source_span.span.end = end;
}

// Table reads by handle. The parser stores only handles inside its tables, so
// a handle at or past a table's count is a violated producer invariant: the
// read crashes rather than returning another declaration's row.
pub machine SyntaxTrees::data_item(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> DataItem
crashes Trap
{
    transition handle < syntax_trees.data_count {
        true -> read(syntax_trees, handle)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        syntax_trees.data_items[handle]
    }

    state invalid() -> DataItem {
        crash Trap;
    }
}

pub machine SyntaxTrees::data_member(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> DataMember
crashes Trap
{
    transition handle < syntax_trees.data_member_count {
        true -> read(syntax_trees, handle)
