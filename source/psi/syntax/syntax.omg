}

pub data ParseDiagnostic [copy] {
    code: ParseDiagnosticCode;
    source_span: SourceSpan;
}

pub data SyntaxTrees
where
    root_count <= 4096,
    use_count <= 1024,
    member_count <= 32000,
    data_count <= 256,
    generic_parameter_count <= 256,
    field_count <= 1024,
    data_member_count <= 2048,
    case_count <= 1536,
    payload_field_count <= 1024,
    type_reference_count <= 65536,
    type_argument_count <= 1024,
    type_lifetime_count <= 1024,
    machine_count <= 2048,
    parameter_count <= 32768,
    state_count <= 8192,
    expression_count <= 131072,
    argument_count <= 65536,
    construct_field_count <= 4096,
    statement_count <= 16384,
    arm_count <= 8192,
    pattern_field_count <= 2048,
    clause_count <= 2048,
    name_path_count <= 2048,
    trait_count <= 256,
    trait_parent_count <= 512,
    conformance_count <= 256,
    conformance_row_count <= 512,
    domain_count <= 256,
    constant_count <= 512,
    proposition_count <= 256,
    contract_count <= 256,
    match_arm_count <= 1024,
    definition_count <= 256,
{
    roots: [RootItem; 4096] in Trapping;
    root_count: u64;
    uses: [UseItem; 1024] in Trapping;
    use_count: u64;
    members: [IdentifierSpan; 32000] in Trapping;
    member_count: u64;
    data_items: [DataItem; 256] in Trapping;
    data_count: u64;
    generic_parameters: [GenericParameter; 256] in Trapping;
    generic_parameter_count: u64;
    fields: [DataField; 1024] in Trapping;
    field_count: u64;
    data_members: [DataMember; 2048] in Trapping;
    data_member_count: u64;
    cases: [DataCase; 1536] in Trapping;
    case_count: u64;
    payload_fields: [DataField; 1024] in Trapping;
    payload_field_count: u64;
    type_references: [TypeReference; 65536] in Trapping;
    type_reference_count: u64;
    type_arguments: [u64; 1024] in Trapping;
    type_argument_count: u64;
    // The lifetime arguments of applied names, each run named by its row.
    type_lifetimes: [IdentifierSpan; 1024];
    type_lifetime_count: u64;
    machines: [MachineItem; 2048] in Trapping;
    machine_count: u64;
    parameters: [Parameter; 32768] in Trapping;
    parameter_count: u64;
    states: [StateItem; 8192] in Trapping;
    state_count: u64;
    expressions: [Expression; 131072] in Trapping;
    expression_count: u64;
    arguments: [u64; 65536] in Trapping;
    argument_count: u64;
    construct_fields: [ConstructField; 4096] in Trapping;
    construct_field_count: u64;
    statements: [Statement; 16384] in Trapping;
    statement_count: u64;
    arms: [TransitionArm; 8192] in Trapping;
    arm_count: u64;
    pattern_fields: [PatternField; 2048] in Trapping;
    pattern_field_count: u64;
    clauses: [Clause; 2048] in Trapping;
    clause_count: u64;
    name_paths: [NamePath; 2048] in Trapping;
    name_path_count: u64;
    traits: [TraitItem; 256] in Trapping;
    trait_count: u64;
    trait_parents: [u64; 512] in Trapping;
    trait_parent_count: u64;
    conformances: [ConformanceItem; 256] in Trapping;
    conformance_count: u64;
    conformance_rows: [ConformanceRow; 512] in Trapping;
    conformance_row_count: u64;
    domains: [DomainItem; 256] in Trapping;
    domain_count: u64;
    constants: [ConstantItem; 512] in Trapping;
    constant_count: u64;
    propositions: [PropositionItem; 256] in Trapping;
    proposition_count: u64;
    contracts: [Contract; 256] in Trapping;
    contract_count: u64;
    match_arms: [TransitionArm; 1024] in Trapping;
    match_arm_count: u64;
    definitions: [DefinitionItem; 256] in Trapping;
    definition_count: u64;
    diagnostic: ParseDiagnostic;
    accepted: bool;
}

pub machine SyntaxTrees::clear(syntax_trees: &mut SyntaxTrees, source: SourceId) {
    syntax_trees.root_count = 0;
    syntax_trees.use_count = 0;
    syntax_trees.member_count = 0;
    syntax_trees.data_count = 0;
    syntax_trees.generic_parameter_count = 0;
    syntax_trees.field_count = 0;
    syntax_trees.data_member_count = 0;
    syntax_trees.case_count = 0;
    syntax_trees.payload_field_count = 0;
    syntax_trees.type_reference_count = 0;
    syntax_trees.type_argument_count = 0;
    syntax_trees.type_lifetime_count = 0;
    syntax_trees.machine_count = 0;
    syntax_trees.parameter_count = 0;
    syntax_trees.state_count = 0;
    syntax_trees.expression_count = 0;
    syntax_trees.argument_count = 0;
    syntax_trees.construct_field_count = 0;
    syntax_trees.statement_count = 0;
    syntax_trees.arm_count = 0;
    syntax_trees.pattern_field_count = 0;
    syntax_trees.clause_count = 0;
    syntax_trees.name_path_count = 0;
    syntax_trees.trait_count = 0;
    syntax_trees.trait_parent_count = 0;
    syntax_trees.conformance_count = 0;
    syntax_trees.conformance_row_count = 0;
    syntax_trees.domain_count = 0;
    syntax_trees.constant_count = 0;
    syntax_trees.proposition_count = 0;
    syntax_trees.contract_count = 0;
    syntax_trees.match_arm_count = 0;
    syntax_trees.definition_count = 0;
    syntax_trees.accepted = true;
    syntax_trees.diagnostic.code = ParseDiagnosticCode::None;
    syntax_trees.diagnostic.source_span.source = source;
    syntax_trees.diagnostic.source_span.span.start = 0;
    syntax_trees.diagnostic.source_span.span.end = 0;
}

pub machine SyntaxTrees::reject(
    syntax_trees: &mut SyntaxTrees,
    code: ParseDiagnosticCode,
    source: SourceId,
    start: u64 in Trapping,
    end: u64 in Trapping
) {
    syntax_trees.accepted = false;
    syntax_trees.diagnostic.code = code;
    syntax_trees.diagnostic.source_span.source = source;
    syntax_trees.diagnostic.source_span.span.start = start;
    syntax_trees.diagnostic.source_span.span.end = end;
}

// Table reads by handle. The parser stores only handles inside its tables, so
// a handle at or past a table's count is a violated producer invariant: the
// read crashes rather than returning another declaration's row.
pub machine SyntaxTrees::root_item(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> RootItem
crashes Trap
{
    transition handle < syntax_trees.root_count {
        true -> read(syntax_trees, handle)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        syntax_trees.roots[handle]
    }

    state invalid() -> RootItem {
        crash Trap;
    }
}

