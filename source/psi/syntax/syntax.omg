use psi::source::source;

// Bounded source-shaped storage for the live product parser slices. Handles
// are dense indices into owner-local tables; no symbol or package meaning is
// assigned here.

pub data IdentifierSpan [copy] {
    source_span: SourceSpan;
}

pub data UseItem [copy] {
    first_member: u64 in Trapping;
    member_count: u64 in Trapping;
    source_span: SourceSpan;
}

pub data TypeReferenceKind [copy] {
    case Named;
    case Reference;
    case Array;
    case Slice;
    case Literal;
}

pub data ReferenceAccess [copy] {
    case Shared;
    case Mutable;
    // `&write T`: exclusive mutation without observation
    // (wiki/spec/language/ownership.md#borrows-and-aliases).
    case WriteOnly;
}

// One row per type form. A whole type fills a contiguous run of rows that
// ends at its root: every row follows its children, and `first_row` is where
// its own run begins. `Named` carries its `name`; an application
// (`Binding<Console>`) also carries `argument_count` argument rows listed in
// `SyntaxTrees::type_arguments` from `first_argument`. `Reference` (`&T`,
// `&mut T`, `&write T`) carries its `access`. `Reference`, `Array` (`[T; N]`) and
// `Slice` (`[T]`) name their referee or element in `inner`, and `Array` names
// its length row, a `Literal` or a `Named` static value, in `length`.
// `Literal` is an integer static argument or length spelled by `name`.
// `Named`, `Array` and `Slice` rows may carry an `in Domain` qualifier: its
// own name is `domain`, and a path qualifier (`in Type::Case`) keeps the
// members before that name in `domain_owner`.
// Fields a form does not carry are zero.
pub data TypeReference [copy] {
    kind: TypeReferenceKind;
    name: IdentifierSpan;
    has_domain: bool;
    domain: IdentifierSpan;
    has_domain_owner: bool;
    domain_owner: IdentifierSpan;
    access: ReferenceAccess;
    inner: u64 in Trapping;
    length: u64 in Trapping;
    first_argument: u64 in Trapping;
    argument_count: u64 in Trapping;
    // A reference's lifetime tag `&'tag T`, and an applied name's lifetime
    // arguments `Name<'tag, ...>`, a run in `type_lifetimes`
    // (wiki/spec/language/lifetimes.md#binders-and-source-applications).
    has_lifetime: bool;
    lifetime: IdentifierSpan;
    first_lifetime: u64 in Trapping;
    lifetime_count: u64 in Trapping;
    first_row: u64 in Trapping;
    source_span: SourceSpan;
}

// A field or case may carry a stable schema identity `#N`
// (wiki/spec/layouts/plans.md): `has_identity` and the integer literal's span
// in `identity`. Identities are not runtime discriminants; their numbering
// rules are resolution's question.
pub data DataField [copy] {
    name: IdentifierSpan;
    has_identity: bool;
    identity: SourceSpan;
    type_reference: u64 in Trapping;
    source_span: SourceSpan;
}

pub data DataCase [copy] {
    name: IdentifierSpan;
    has_identity: bool;
    identity: SourceSpan;
    first_payload_field: u64 in Trapping;
    payload_field_count: u64 in Trapping;
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    source_span: SourceSpan;
}

pub data DataMemberKind [copy] {
    case Field;
    case Case;
}

pub data DataMember [copy] {
    kind: DataMemberKind;
    item_index: u64 in Trapping;
    source_span: SourceSpan;
}

pub data DataMultiplicity [copy] {
    case Affine;
    case Unrestricted;
    case Linear;
}

pub data GenericParameterKind [copy] {
    case Lifetime;
    case Type;
    case Const;
    case Value;
    case Machine;
    case Proposition;
    case Evidence;
}

// One declared generic parameter on a declaration head: `'a`, `T`,
// `const N: Ty`, `u: Ty`, `machine M`, `proposition R`, or the evidence
// binder `Order satisfies Ranked<T>`, whose trait application is its type
// reference, with its property bounds.
pub data GenericParameter [copy] {
    kind: GenericParameterKind;
    name: IdentifierSpan;
    has_type_reference: bool;
    type_reference: u64 in Trapping;
    bounds: DataMultiplicity;
    source_span: SourceSpan;
}

pub data DataItem [copy] {
    name: IdentifierSpan;
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    first_member: u64 in Trapping;
    member_count: u64 in Trapping;
    first_field: u64 in Trapping;
    field_count: u64 in Trapping;
    first_case: u64 in Trapping;
    case_count: u64 in Trapping;
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    multiplicity: DataMultiplicity;
    // `boundary data` leaves its representation to a crossing: it declares
    // no members and no `where` facts.
    is_boundary: bool;
    is_public: bool;
    source_span: SourceSpan;
}

// One typed parameter of a machine or state: `name: Type`.
pub data Parameter [copy] {
    name: IdentifierSpan;
    type_reference: u64 in Trapping;
    // `mut name: Type`: the body may assign the parameter.
    is_mutable: bool;
    source_span: SourceSpan;
}

// Expression syntax. Children are handles into `SyntaxTrees::expressions`;
// a parenthesized group adds no node. A Name holds its one identifier in
// `name` and stores no member row. `first`/`count` select a kind's range:
// a Path's members, two or more, in `SyntaxTrees::members`, a call's
// arguments in `SyntaxTrees::arguments`, a construction's fields in
// `SyntaxTrees::construct_fields` (its type path is its `left` child, a Name
// or a Path), a membership's domains in
// `SyntaxTrees::name_paths`, or a value-position match's arms in
// `SyntaxTrees::match_arms`, or a fixed-array literal's elements
// `[a, b, c]` in `SyntaxTrees::arguments`. A membership `value in A & B` tests its value
// `left` against each domain, joined by `operator` (`And` for `&`, `Or` for
// `|`, `None` for one domain); a match tests its subject `left` against each
// arm's pattern in order, and each arm's target is its value. A range
// (`a..b`, `a..=b` with `flag`, and the open `a..`, `..b`, `..`) stands only
// as an index's operand, a range slice: its start is `left` when `first` is
// 1 and its end `right` when `count` is 1. Unused fields
// of a kind are zero.
pub data ExpressionKind [copy] {
    case Name;
    case Path;
    case Integer;
    case Float;
    case Boolean;
    case String;
    case Field;
    case Index;
    case Unary;
    case Apply;
    case Binary;
    case Cast;
    case Call;
    case Construct;
    case Membership;
    case Match;
    case Range;
    case Array;
}

pub data OperatorKind [copy] {
    case None;
    case Or;
    case And;
    case Equal;
    case NotEqual;
    case Less;
    case LessEqual;
    case Greater;
    case GreaterEqual;
    case BitOr;
    case BitXor;
    case BitAnd;
    case ShiftLeft;
    case ShiftRight;
    case Add;
    case Subtract;
    case Multiply;
    case Divide;
    case Modulo;
    case Not;
    case Negate;
    case BitNot;
    case Borrow;
    case BorrowMutable;
    case Suspend;
    case Block;
    case SuspendBlock;
    case BorrowWrite;
}

pub data Expression [copy] {
    kind: ExpressionKind;
    operator: OperatorKind;
    left: u64 in Trapping;
    right: u64 in Trapping;
    first: u64 in Trapping;
    count: u64 in Trapping;
    flag: bool;
    name: IdentifierSpan;
    type_reference: u64 in Trapping;
    first_row: u64 in Trapping;
    source_span: SourceSpan;
}

// One `name: value` field of a construction `Path { name: value, ... }`.
pub data ConstructField [copy] {
    name: IdentifierSpan;
    value: u64 in Trapping;
    source_span: SourceSpan;
}

pub data CrashCause [copy] {
    case Trap;
    case Abort;
}

// Statement syntax. `Let` declares `name` with a type and an optional
// initializer in `value`; `Assign` stores `value` into the place `target`;
// `Expression` evaluates `value` for its effect; `Tail` is a body's final
// unterminated expression, its result; `Crash` ends the body with `cause`;
// `Transition` selects among its arms, over the subject in `value` when
// `has_value` holds; `Discard` (`_ = value;`) evaluates `value` and drops its
// result intentionally.
pub data StatementKind [copy] {
    case Let;
    case Assign;
    case Expression;
    case Tail;
    case Crash;
    case Transition;
    case Discard;
}

// One arm of a `transition` block. `Guard` arms (subjectless blocks) hold a
// Boolean expression in `pattern`; `Wildcard` is `_`; `Literal` holds a
// literal pattern expression; `Case` holds the case path expression and a
// contiguous range of `SyntaxTrees::pattern_fields`. `target` is the arm's
// target expression, of kind `target_kind`, or zero for `-> {}`.
pub data ArmPatternKind [copy] {
    case Guard;
    case Wildcard;
    case Literal;
    case Case;
}

// What an arm's target spells (wiki/spec/language/state_contracts.md). A
// `Call` names a declaration, `name(arguments)` or `Owner::name(arguments)`,
// possibly acknowledged (`suspend block f(x)`); resolution decides whether it
// jumps to a state or completes the machine through a terminal call. A
// `Value` is any other expression, a terminal value that completes the
// machine. `Unit` is the explicit Unit completion `{}`.
pub data ArmTargetKind [copy] {
    case Call;
    case Value;
    case Unit;
}

pub data TransitionArm [copy] {
    kind: ArmPatternKind;
    pattern: u64 in Trapping;
    first_field: u64 in Trapping;
    field_count: u64 in Trapping;
    target_kind: ArmTargetKind;
    target: u64 in Trapping;
    source_span: SourceSpan;
}

// One field of a case pattern: a binder (`keyword`), a renamed binder
// (`keyword as word`, `rename` naming the binder), a waived field
// (`keyword as _`, which binds nothing) or a nested value
// (`punctuation: PunctuationKind::Comma`).
pub data PatternField [copy] {
    name: IdentifierSpan;
    has_value: bool;
    value: u64 in Trapping;
    has_rename: bool;
    rename: IdentifierSpan;
    is_waived: bool;
    source_span: SourceSpan;
}

pub data Statement [copy] {
    kind: StatementKind;
    name: IdentifierSpan;
    is_mutable: bool;
    type_reference: u64 in Trapping;
    has_value: bool;
    value: u64 in Trapping;
    target: u64 in Trapping;
    cause: CrashCause;
    first_arm: u64 in Trapping;
    arm_count: u64 in Trapping;
    source_span: SourceSpan;
}

// One clause between a declaration's head and its body. `Reaches` names
// services and `Invokes` a binding, both in `SyntaxTrees::members`; `Crashes`
// records its cause; `Requires`, `Ensures` and each `Where` fact hold a fact
// expression; `Suspends` and `Blocks` carry nothing more. `Satisfies` names
// one exact trait requirement `Trait<arguments>::requirement`: the trait's
// path and then the requirement in `SyntaxTrees::members`, the trait's static
// arguments in `SyntaxTrees::type_arguments`, an optional satisfier label
// `as Name` and an optional binding payload `via value` as its expression.
// `Terminates` is the termination promise; `terminates by subjects [-> View]`
// adds its ranking witness: the ranked subjects in `SyntaxTrees::arguments`
// and the view, a path or an argumented view call, as its expression.
// Machines, contracts, states, data declarations and cases each own a
// contiguous range of clauses.
pub data ClauseKind [copy] {
    case Reaches;
    case Invokes;
    case Suspends;
    case Blocks;
    case Crashes;
    case Requires;
    case Ensures;
    case Where;
    case Satisfies;
    case Terminates;
}

// Whose clauses a clause list reads. A trait member is a machine whose `;`
// before `requires` ends it, since `requires Parent;` is then the trait's
// body parent; a contract's clauses end at its `;`; each clause of a
// refinement member ends at its own `;`.
pub data ClauseOwner [copy] {
    case Machine;
    case TraitMember;
    case Contract;
    case Refinement;
    case State;
    case Data;
    case DataCase;
    case Domain;
}

pub data Clause [copy] {
    kind: ClauseKind;
    first_member: u64 in Trapping;
    member_count: u64 in Trapping;
    cause: CrashCause;
    expression: u64 in Trapping;
    has_expression: bool;
    first_argument: u64 in Trapping;
    argument_count: u64 in Trapping;
    has_label: bool;
    label: IdentifierSpan;
    source_span: SourceSpan;
}

// A named state member of a machine body. Its parameters are a contiguous
// range of `SyntaxTrees::parameters`.
pub data StateItem [copy] {
    name: IdentifierSpan;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    has_return_type: bool;
    return_type: u64 in Trapping;
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    first_statement: u64 in Trapping;
    statement_count: u64 in Trapping;
    source_span: SourceSpan;
}

// Where a machine declaration stands: at the root, or as a member of a
// trait, a named conformance or a transparent refinement, whose item covers
// its contiguous range. A refinement member names one base requirement,
// possibly qualified by the base trait (`Base::requirement`), or every one
// (`machine *`), and carries only the operational clauses it narrows.
pub data MachineContainer [copy] {
    case Root;
    case Trait;
    case Conformance;
    case Refinement;
}

// The fixed operator token an ordinary machine declaration may bind
// (`machine + Vec2::add(...)`, wiki/spec/language/expressions.md "Operator
// declarations"): a closed, compiler-owned vocabulary. `None` is a tokenless
// named machine.
pub data OperatorToken [copy] {
    case None;
    case Add;
    case Subtract;
    case Multiply;
    case Divide;
    case Modulo;
    case Equal;
    case NotEqual;
    case Less;
    case LessEqual;
    case Greater;
    case GreaterEqual;
    case Index;
    case Range;
}

// A `machine` declaration. `Owner::name` records the owner path member;
// a free-standing machine has no owner and an empty owner span. Its generic
// parameters are a contiguous range of `SyntaxTrees::generic_parameters`;
// its `where machine` contracts, one per static machine binder, a contiguous
// range of `SyntaxTrees::contracts`. A fixed token after `machine` binds
// `operator`, spelled at `token`.
// The parameters and return type are the entry's signature; `first_state`
// and `state_count` cover the authored `state` members; the entry's own
// statements precede them in the body. A bodyless declaration ends at `;`
// and owns no statements or states. Every expression of the declaration,
// in its clauses and its bodies, lies in the contiguous range from
// `first_expression`. A target-scoped declaration (`linux_arm64 machine
// ...`) names its target, one body of the family the path keys by target;
// `boundary machine` marks a crossing.
pub data MachineItem [copy] {
    has_owner: bool;
    owner: IdentifierSpan;
    name: IdentifierSpan;
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    has_return_type: bool;
    return_type: u64 in Trapping;
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    first_statement: u64 in Trapping;
    statement_count: u64 in Trapping;
    first_state: u64 in Trapping;
    state_count: u64 in Trapping;
    has_body: bool;
    first_expression: u64 in Trapping;
    expression_count: u64 in Trapping;
    has_target: bool;
    target: IdentifierSpan;
    is_boundary: bool;
    container: MachineContainer;
    is_public: bool;
    operator: OperatorToken;
    token: IdentifierSpan;
    first_contract: u64 in Trapping;
    contract_count: u64 in Trapping;
    every_requirement: bool;
    source_span: SourceSpan;
}

// A declaration-site contract for a static binder of a machine or trait
// head. A `Machine` contract `where machine Name [<binders>] [(parameters)]
// [-> Type] clauses ;` gives a machine binder its callable signature, or
// with a `Satisfies` clause (`where machine Name satisfies Trait::member;`)
// an exact requirement; a `Proposition` contract `where proposition
// Name(parameters);` gives a proposition binder its signature. Which binder
// a contract names is resolution's question: a contract may also name a
// binder of an earlier contract's own generic parameters.
pub data ContractKind [copy] {
    case Machine;
    case Proposition;
}

pub data Contract [copy] {
    kind: ContractKind;
    name: IdentifierSpan;
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    has_return_type: bool;
    return_type: u64 in Trapping;
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    source_span: SourceSpan;
}

// A `::`-separated name path, `a::b::c`, as a contiguous range of
// `SyntaxTrees::members`: a domain's establishment routes and alias
// constituents, and both sides of a conformance's reference rows.
pub data NamePath [copy] {
    first_member: u64 in Trapping;
    member_count: u64 in Trapping;
    source_span: SourceSpan;
}

// A `trait` declaration names machine requirements. Its parents, written in
// the header (`: A<T> + B`) and then in the body (`requires A;`), are
// type-reference handles in `SyntaxTrees::trait_parents`; its member
// machines are a contiguous range of `SyntaxTrees::machines` whose container
// is `Trait`; its `where proposition` contracts are a contiguous range of
// `SyntaxTrees::contracts`. `boundary trait` declares service requirements
// at a crossing. A transparent refinement `trait Name = Base { ... }` names a
// structural bound on a `Base` conformance, the type reference `base`: it
// has no parents or contracts, and its members' container is `Refinement`.
// Its generic parameters are the header's own; each member machine's follow
// them in its own range.
pub data TraitItem [copy] {
    name: IdentifierSpan;
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    first_parent: u64 in Trapping;
    parent_count: u64 in Trapping;
    first_machine: u64 in Trapping;
    machine_count: u64 in Trapping;
    is_boundary: bool;
    is_public: bool;
    first_contract: u64 in Trapping;
    contract_count: u64 in Trapping;
    is_refinement: bool;
    base: u64 in Trapping;
    source_span: SourceSpan;
}

// A named implementation `Name<binders> satisfies Trait<arguments> { rows }`.
// The satisfied trait application is one type reference. Checked members are
// a contiguous range of `SyntaxTrees::machines` whose container is
// `Conformance`; reference rows bind a requirement to an existing machine.
// Its generic parameters are the header's own, as for a trait.
pub data ConformanceItem [copy] {
    name: IdentifierSpan;
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    trait_type: u64 in Trapping;
    first_machine: u64 in Trapping;
    machine_count: u64 in Trapping;
    first_row: u64 in Trapping;
    row_count: u64 in Trapping;
    is_public: bool;
    source_span: SourceSpan;
}

// One reference row `Trait::requirement = Path;`: both sides are name-path
// handles.
pub data ConformanceRow [copy] {
    requirement: u64 in Trapping;
    target: u64 in Trapping;
    source_span: SourceSpan;
}

// A `domain` declaration `domain<binders> Carrier::Name<indices>(subject)`.
// The carrier is a type-reference handle, the index arguments a range of
// `SyntaxTrees::type_arguments`. A predicate domain keeps its `requires`
// facts as clauses and its `established by` routes as name paths; a
// transparent alias (`= A & B;`) keeps its constituents as name paths.
pub data DomainItem [copy] {
    carrier: u64 in Trapping;
    name: IdentifierSpan;
    first_argument: u64 in Trapping;
    argument_count: u64 in Trapping;
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    has_subject: bool;
    subject: IdentifierSpan;
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    first_route: u64 in Trapping;
    route_count: u64 in Trapping;
    is_alias: bool;
    first_constituent: u64 in Trapping;
    constituent_count: u64 in Trapping;
    is_public: bool;
    source_span: SourceSpan;
}

// A `const [Owner::]NAME: Type = value;` declaration. `value` is an
// expression handle.
pub data ConstantItem [copy] {
    has_owner: bool;
    owner: IdentifierSpan;
    name: IdentifierSpan;
    type_reference: u64 in Trapping;
    value: u64 in Trapping;
    is_public: bool;
    source_span: SourceSpan;
}

// What a proposition declares after its signature: nothing more (`;`), a
// witness type (`evidence Type;`) or a transparent fact (`= fact;`).
pub data PropositionBody [copy] {
    case Primitive;
    case Evidence;
    case Transparent;
}

// A `proposition Name<binders>(parameters)` declaration. `evidence` is a
// type-reference handle and `fact` an expression handle; the one its body
// does not carry is zero.
pub data PropositionItem [copy] {
    name: IdentifierSpan;
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    body: PropositionBody;
    evidence: u64 in Trapping;
    fact: u64 in Trapping;
    is_public: bool;
    source_span: SourceSpan;
}

// A named mathematical definition `let Name<binders>(parameters): Type =
// term;`, or with `is_boundary` an admitted assumption `boundary let ...;`
// without a term. `result_type` is a type-reference handle and `term` an
// expression handle, zero without one.
pub data DefinitionItem [copy] {
    name: IdentifierSpan;
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    result_type: u64 in Trapping;
    has_term: bool;
    term: u64 in Trapping;
    is_boundary: bool;
    is_public: bool;
    source_span: SourceSpan;
}

pub data RootItemKind [copy] {
    case Use;
    case Data;
    case Machine;
    case Trait;
    case Conformance;
    case Domain;
    case Constant;
    case Proposition;
    case Definition;
}

pub data RootItem [copy] {
    kind: RootItemKind;
    item_index: u64 in Trapping;
    source_span: SourceSpan;
}

pub data ParseDiagnosticCode [copy] {
    case None;
    case LexicalInputRejected;
    case UnsupportedRootItem;
    case ExpectedPathMember;
    case ExpectedPathSeparatorOrSemicolon;
    case RootCapacityExceeded;
    case UseCapacityExceeded;
    case PathMemberCapacityExceeded;
    case TokenInputCapacityExceeded;
    case ExpectedItemAfterPub;
    case ExpectedDataName;
    case ExpectedDataBody;
    case ExpectedDataFieldColon;
    case ExpectedDataFieldType;
    case ExpectedDataFieldEnd;
    case DataCapacityExceeded;
    case DataFieldCapacityExceeded;
    case TypeReferenceCapacityExceeded;
    case ExpectedDataProperty;
    case ExpectedDataPropertyEnd;
    case ExpectedDataCaseName;
    case ExpectedDataCaseEnd;
    case DataMemberCapacityExceeded;
    case DataCaseCapacityExceeded;
    case ExpectedDataCasePayloadField;
    case ExpectedDataCasePayloadFieldColon;
    case ExpectedDataCasePayloadFieldType;
    case ExpectedDataCasePayloadSeparatorOrEnd;
    case DataCasePayloadFieldCapacityExceeded;
    case DuplicateDataMultiplicity;
    case ConflictingDataMultiplicity;
    case ExpectedTypeQualifierDomain;
    case ExpectedGenericParameter;
    case ExpectedGenericParameterName;
    case ExpectedGenericParameterColon;
    case ExpectedGenericParameterType;
    case ExpectedGenericParameterEnd;
    case GenericParameterCapacityExceeded;
    case GenericLifetimeOrdering;
    case ExpectedLifetimeName;
    case ExpectedMachineName;
    case ExpectedMachineParameterOrEnd;
    case ExpectedMachineParameter;
    case ExpectedMachineParameterColon;
    case ExpectedMachineParameterType;
    case ExpectedMachineParameterEnd;
    case ExpectedMachineReturnType;
    case ExpectedMachineBody;
    case ExpectedMachineBodyEnd;
    case ExpectedStateName;
    case ExpectedStateBody;
    case ExpectedStateBodyEnd;
    case MachineCapacityExceeded;
    case ParameterCapacityExceeded;
    case StateCapacityExceeded;
    case ExpectedOperand;
    case ExpectedExpressionPathMember;
    case ExpectedFieldName;
    case ExpectedGroupEnd;
    case ExpectedIndexEnd;
    case ExpectedCallArgument;
    case ExpectedCallArgumentEnd;
    case ExpectedCastType;
    case ExpectedStructLiteralFieldOrEnd;
    case ExpectedStructLiteralFieldColon;
    case ExpectedStructLiteralValue;
    case ExpectedStructLiteralFieldEnd;
    case ExpressionCapacityExceeded;
    case ExpressionNestingExceeded;
    case ArgumentCapacityExceeded;
    case ConstructFieldCapacityExceeded;
    case ExpectedLocalDataName;
    case ExpectedLocalDataColon;
    case ExpectedLocalDataType;
    case ExpectedLocalDataInitialValue;
    case ExpectedLocalDataEnd;
    case ExpectedAssignmentValue;
    case ExpectedAssignmentSemicolon;
    case ExpectedStatementEnd;
    case ExpectedCrashCause;
    case ExpectedCrashEnd;
    case StatementCapacityExceeded;
    case ExpectedTransitionSubject;
    case ExpectedTransitionArm;
    case ExpectedTransitionArrow;
    case ExpectedTransitionTarget;
    case ExpectedTransitionTargetOpen;
    case ExpectedTransitionTargetClose;
    case ExpectedPatternField;
    case ExpectedPatternFieldEnd;
    case ArmCapacityExceeded;
    case PatternFieldCapacityExceeded;
    case ExpectedReachService;
    case ExpectedInvokesBinding;
    case ExpectedClauseEnd;
    case ExpectedClauseFact;
