pub machine SyntaxTrees::argument(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition handle < syntax_trees.argument_count {
        true -> read(syntax_trees, handle)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        syntax_trees.arguments[handle]
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

pub machine SyntaxTrees::arm(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> TransitionArm
crashes Trap
{
    transition handle < syntax_trees.arm_count {
        true -> read(syntax_trees, handle)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        syntax_trees.arms[handle]
    }

    state invalid() -> TransitionArm {
        crash Trap;
    }
}

pub machine SyntaxTrees::pattern_field(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> PatternField
crashes Trap
{
    transition handle < syntax_trees.pattern_field_count {
        true -> read(syntax_trees, handle)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        syntax_trees.pattern_fields[handle]
    }

    state invalid() -> PatternField {
        crash Trap;
    }
}

pub machine SyntaxTrees::clause(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) -> Clause
crashes Trap
{
    transition handle < syntax_trees.clause_count {
        true -> read(syntax_trees, handle)
        _ -> invalid()
    }

    state read(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        syntax_trees.clauses[handle]
    }

    state invalid() -> Clause {
        crash Trap;
    }
}

// The authored name of a data member: a direct field's name or a case's name.
pub machine SyntaxTrees::member_name(syntax_trees: &SyntaxTrees, member: DataMember) -> IdentifierSpan
crashes Trap
{
    transition member.kind {
        DataMemberKind::Field -> field_name(syntax_trees, member.item_index)
        DataMemberKind::Case -> case_name(syntax_trees, member.item_index)
    }

    state field_name(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        let field: DataField = SyntaxTrees::field(syntax_trees, handle);
        field.name
    }

    state case_name(syntax_trees: &SyntaxTrees, handle: u64 in Trapping) {
        let data_case: DataCase = SyntaxTrees::data_case(syntax_trees, handle);
        data_case.name
    }
}
