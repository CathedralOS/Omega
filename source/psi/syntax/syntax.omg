    case ExpectedTraitRequirementEnd;
    case TraitCapacityExceeded;
    case TraitParentCapacityExceeded;
    case ExpectedConformanceSatisfies;
    case ExpectedConformanceTrait;
    case ExpectedConformanceBody;
    case ExpectedConformanceMember;
    case ExpectedConformanceRowEquals;
    case ExpectedConformanceRowTarget;
    case ExpectedConformanceRowEnd;
    case ConformanceCapacityExceeded;
    case ConformanceRowCapacityExceeded;
    case ExpectedDomainCarrier;
