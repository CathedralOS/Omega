use psi::source::source;
use psi::syntax::syntax;

// Name bindings for the parsed roots of a compilation's source set. Each
// binding table is indexed by the syntax table whose names it binds
// (`SyntaxTrees::type_references`, `expressions`, `name_paths`, `machines`),
// so each syntax handle keeps its identity; no table repeats a spelling. The
// zero binding is the unresolved state, and an accepted resolution leaves
// none.

// Compiler-installed type names, in the reference compiler's builtin order.
pub data BuiltinType [copy] {
    case Bool;
    case I8;
    case I16;
    case I32;
    case I64;
    case U8;
    case U16;
    case U32;
    case U64;
    case Address;
    case F32;
    case F64;
    case Slice;
    case Result;
    case SyscallResult;
    case Terminal;
    case Never;
    case UInt;
    case Int;
    case AtomicBool;
    case AtomicU32;
    case AtomicU64;
}

// What a type reference's name denotes: a compiler-installed type, a data
// declaration (its `SyntaxTrees::data_items` handle), or a generic parameter
// of the enclosing declaration (its `SyntaxTrees::generic_parameters`
// handle). A trait (`SyntaxTrees::traits`) is named only where a trait
// application stands: a trait's parents and a conformance's satisfied trait.
// A named conformance (`SyntaxTrees::conformances`) is named only as a static
// argument. Reference, array, slice and integer rows name no declaration:
// each binds by its form, and the rows of its run carry the names' bindings.
pub data TypeBinding [copy] {
    case Unresolved;
    // Two visible declarations spell the name; the reference rejects.
    case Ambiguous;
    case Builtin(builtin: BuiltinType);
    case Data(item: u64 in Trapping);
    case GenericParameter(parameter: u64 in Trapping);
    case Reference;
    case Array;
    case Slice;
    case Literal;
    case Trait(item: u64 in Trapping);
    case Conformance(item: u64 in Trapping);
    // A static argument naming a machine (the first declaration of its
    // overload family), for a callee's machine binder.
    case Machine(handle: u64 in Trapping);
}

// A machine binder's callable contract, `where machine F(...) -> T`
// (wiki/spec/language/generics.md, Static machine binder categories): the
// contract row the binder carries, when it has one.
pub data BinderContract [copy] {
    present: bool;
    contract: u64 in Trapping;
}

// What a name or path in an expression denotes, indexed like
// `SyntaxTrees::expressions`. A membership `value in Type::Case` binds the
// case whose implied domain it names; other expressions that are not names
// stay `NotAName`; an accepted resolution leaves no `Unresolved` name. A machine
// binding names the first declaration of its overload family; typing selects
// among the family. A trait requirement or a conformance member is a machine
// like any other, named through its container. A generic parameter binding
// names a value or machine binder of the enclosing machine (or of the trait
// or conformance containing it) by its `SyntaxTrees::generic_parameters`
// handle. A constant binding names a `SyntaxTrees::constants` handle, and a
// proposition binding a `SyntaxTrees::propositions` handle.
pub data ValueBinding [copy] {
    case NotAName;
    case Unresolved;
    // Two visible declarations spell the name; the reference rejects.
    case Ambiguous;
    case Local(statement: u64 in Trapping);
    case Parameter(parameter: u64 in Trapping);
    case PatternBinder(field: u64 in Trapping);
    case State(handle: u64 in Trapping);
    case Machine(handle: u64 in Trapping);
    case Data(item: u64 in Trapping);
    case DataCase(item: u64 in Trapping, data_case: u64 in Trapping);
    case GenericParameter(parameter: u64 in Trapping);
    case Constant(constant: u64 in Trapping);
    // A bare name in a data declaration's `where` fact: one of its fields.
    case Field(field: u64 in Trapping);
    // A bare name in a case's own `where` fact: one of that case's payload
    // fields (`SyntaxTrees::payload_fields`).
    case PayloadField(field: u64 in Trapping);
    // `result` in a machine's `ensures` fact: the value the machine returns
    // (wiki/spec/language/state_contracts.md#returns-and-proof-use).
    case ReturnedValue(machine: u64 in Trapping);
    // The callee of a proposition application, which stands only as a
    // whole fact (wiki/language_guide/chapter_10_compile_time_proofs.md).
    case Proposition(proposition: u64 in Trapping);
    // A domain declaration's subject binder in its predicates: the value the
    // domain classifies (wiki/spec/language/domains.md#declaration-and-membership).
    case DomainSubject(domain: u64 in Trapping);
    // A compiler-known primitive byte predicate applied to a byte view.
    case BytePredicate(predicate: BytePredicate);
}

// The primitive byte predicates over a byte view
// (wiki/spec/terminal-psi/byte_views.md, wiki/spec/terminal-psi/encoding.md):
// `valid_utf8`, `no_nul`, `ascii_only` and `non_empty`. A declaration of the
// same spelling is found first.
pub data BytePredicate [copy] {
    case ValidUtf8;
    case NoNul;
    case AsciiOnly;
    case NonEmpty;
}

// What a `::` name path denotes, indexed like `SyntaxTrees::name_paths`: a
// machine (both sides of a conformance's reference row, a domain's
// establishment route; a trait requirement is a machine) or a domain (an
// alias constituent).
pub data PathBinding [copy] {
    case Unresolved;
    case Machine(handle: u64 in Trapping);
    case Domain(item: u64 in Trapping);
}

// The generic parameters a type name may bind: the enclosing declaration's
// contiguous range of `SyntaxTrees::generic_parameters`, then, for a trait or
// conformance member, its container's range, which the member's own shadow.
pub data TypeScope [copy] {
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    first_outer_parameter: u64 in Trapping;
    outer_parameter_count: u64 in Trapping;
}

// What the `in Domain` qualifier of a type reference denotes. A bare
// reference stays `Unqualified`. The arithmetic policies and `Finite` are
// compiler-known; `Declared` is a `domain` declaration whose handle is the
// row's `NameResolution::domain_items` entry, and `Case` a case's implied
// domain (`Type::Case`), whose entry is the case's `SyntaxTrees::data_cases`
// handle.
pub data DomainBinding [copy] {
    case Unqualified;
    case Wrapping;
    case Saturating;
    case Trapping;
    case Finite;
    case Declared;
    case Case;
}

// Where a machine declaration stands and the owner its path spells. A root
// machine's owner is its authored `Owner::`; a trait requirement or default
// and a conformance member are named through their container (`Trait::name`,
// `Conformance::name`), whose `SyntaxTrees::traits` or `conformances` handle
// is `item`. Overload families, duplicates and callees compare these paths.
pub data MachineOwner [copy] {
    container: MachineContainer;
    item: u64 in Trapping;
    has_owner: bool;
    owner: IdentifierSpan;
}

pub data ResolveDiagnosticCode [copy] {
    case None;
    case UnresolvedImport;
    // A `use` whose first member spells another package's name, or one of
    // its requester's build-scope aliases, without a product dependency
    // alias of the requester selecting it.
    case UndeclaredDependency;
    // A data, trait or conformance name spells a builtin type, or a domain
    // name a compiler-known domain.
    case ShadowsBuiltin;
    case DuplicateData;
    case DuplicateDataMember;
    case DuplicateCasePayloadField;
    case PayloadFieldCollidesWithCommonField;
    case UnknownDataType;
    case UnknownDomain;
    case DuplicateParameter;
    case DuplicateState;
    case DuplicateMachine;
    case DuplicateGenericParameter;
    case UnknownName;
    case AmbiguousName;
    case PartialStableIdentities;
    case DuplicateStableIdentity;
    case InvalidStableIdentity;
    // A declaration kind resolution does not bind yet: a mathematical
    // definition (`let` root) or a transparent trait refinement. It rejects
    // at its root rather than resolving as if absent.
    case UnsupportedDeclaration;
    // A form whose bindings resolution does not record yet rejects at that
    // form: an operator token outside an ordinary owned machine (or `==`,
    // `!=`, `[]`, `[..]`), a `where machine` or `where proposition`
    // contract, a `satisfies` clause naming its trait through a module path,
    // or a proposition or evidence binder.
    case UnsupportedOperatorToken;
    case UnsupportedMachineContract;
    case UnsupportedClause;
    case UnsupportedGenericParameter;
    // An expression form resolution does not bind yet: a membership in
    // several domains at once, or a proposition application inside a
    // larger fact.
    case UnsupportedExpression;
    // A trait, conformance, domain, constant or proposition repeats an
    // earlier declaration of its namespace in one module.
    case DuplicateDeclaration;
    // A trait or conformance named where a type stands.
    case NotAType;
    // A trait position names something other than a trait.
    case NotATrait;
    // A reference row's left side, or a `satisfies` clause, names no
    // requirement of its trait.
    case NotARequirement;
    // A token-bound machine whose owner is not a data declaration of its own
    // package: only a closed family's semantic home publishes its tokens.
    case ForeignOperatorHome;
    // A proposition applied where a value is computed: a body, a
    // transition target, a constant's value, a clause's payload. A
    // proposition names a statement, not an executable condition
    // (wiki/spec/proofs/mathematical_bindings.md#assumptions-and-executable-demand).
    case ProofOnlyApplication;
    // A `where machine` contract whose name is none of its machine's
    // `machine` binders.
    case ContractNamesNoBinder;
    // A second `where machine` contract for one binder.
    case DuplicateContract;
    // A `terminates by` view outside the compiler's ranking vocabulary.
    case UnsupportedRankingView;
    // A lifetime tag no binder of the declaration declares, and an applied
    // name whose lifetime arguments, when it spells any, differ in count
    // from its declaration's lifetime binders
    // (wiki/spec/language/lifetimes.md).
    case UndeclaredLifetime;
    case LifetimeArgumentCount;
    // A computed measure without exactly one parameter, a result type and
    // a one-expression body, or a lexicographic measure whose owner is no
    // data declaration (wiki/spec/language/termination.md#ranking).
    case MeasureForm;
    // A lexicographic component naming no field of the measure's owner.
    case UnknownMeasureComponent;
}

pub data ResolveDiagnostic [copy] {
    code: ResolveDiagnosticCode;
    source_span: SourceSpan;
}

pub data NameResolution
where
    binding_count <= 65536,
    value_binding_count <= 131072,
    path_binding_count <= 2048,
    machine_owner_count <= 2048,
    requirement_count <= 2048,
{
    type_bindings: [TypeBinding; 65536];
    domain_bindings: [DomainBinding; 65536];
    domain_items: [u64; 65536];
    binding_count: u64;
    value_bindings: [ValueBinding; 131072];
    value_binding_count: u64;
    path_bindings: [PathBinding; 2048];
    path_binding_count: u64;
    machine_owners: [MachineOwner; 2048];
    machine_owner_count: u64;
    // Each clause's exact trait requirement, by clause handle: a `satisfies`
    // clause binds the requirement machine it names, every other clause
    // nothing (`NotAName`).
    requirements: [ValueBinding; 2048];
    requirement_count: u64;
    // Each machine's operator home, by machine handle: the data declaration
    // a token-bound machine's owner names; `Unresolved` for a machine
    // binding no token.
    operator_homes: [TypeBinding; 2048];
    // Each generic parameter's callable contract, by generic parameter
    // handle.
    binder_contracts: [BinderContract; 256];
    // Each `terminates by` clause's ranking view, by clause handle.
    ranking_views: [RankingView; 2048];
    // For a clause whose view is a declared measure, that measure's machine
    // handle.
    ranking_measures: [u64; 2048];
    // For each component of a lexicographic measure, by member handle, the
    // field handle of its owner it names, plus one; zero for none.
    component_fields: [u64; 32000];
    // For each state parameter of a ranked machine, by parameter handle, the
    // offset among its machine's entry parameters of the one of the same
    // spelling, plus one; zero for none.
    rank_carriers: [u64; 32768];
    diagnostic: ResolveDiagnostic;
    accepted: bool;
}

pub machine NameResolution::clear(resolution: &mut NameResolution, source: SourceId) {
    resolution.binding_count = 0;
    resolution.value_binding_count = 0;
    resolution.path_binding_count = 0;
    resolution.machine_owner_count = 0;
    resolution.requirement_count = 0;
    resolution.accepted = true;
    resolution.diagnostic.code = ResolveDiagnosticCode::None;
    resolution.diagnostic.source_span.source = source;
    resolution.diagnostic.source_span.span.start = 0;
    resolution.diagnostic.source_span.span.end = 0;
}

pub machine NameResolution::reject(
    resolution: &mut NameResolution,
    code: ResolveDiagnosticCode,
    source_span: SourceSpan
) {
    resolution.accepted = false;
    resolution.diagnostic.code = code;
    resolution.diagnostic.source_span = source_span;
}

// The binding of expression `index`, which must be below the bound count.
pub machine NameResolution::value_binding(resolution: &NameResolution, index: u64 in Trapping) -> ValueBinding
crashes Trap
{
    transition index < resolution.value_binding_count {
        true -> read(resolution, index)
        _ -> invalid()
    }

    state read(resolution: &NameResolution, index: u64 in Trapping) -> ValueBinding {
        resolution.value_bindings[index]
    }

    state invalid() -> ValueBinding {
        crash Trap;
    }
}

// A machine binder's static argument: a declared machine (the first
// declaration of the family its name binds), or a binder of the caller's
// forwarded.
pub data MachineArgument [copy] {
    case Absent;
    case Declared(machine: u64 in Trapping);
    case Forwarded(parameter: u64 in Trapping);
}

// What static argument row `row` names for a machine binder
// (wiki/spec/language/generics.md#static-machine-binder-categories).
pub machine NameResolution::machine_argument(syntax: &SyntaxTrees, resolution: &NameResolution, row: u64 in Trapping) -> MachineArgument
crashes Trap
{
    let binding: TypeBinding = NameResolution::type_binding_at(resolution, row);
    transition binding {
        TypeBinding::Machine { handle } -> chosen(MachineArgument::Declared { machine: handle })
        TypeBinding::GenericParameter { parameter } -> generic(syntax, parameter)
        _ -> chosen(MachineArgument::Absent)
    }

    state generic(syntax: &SyntaxTrees, parameter: u64 in Trapping) -> MachineArgument {
        let declared: GenericParameter = SyntaxTrees::generic_parameter(syntax, parameter);
        transition declared.kind == GenericParameterKind::Machine {
            true -> chosen(MachineArgument::Forwarded { parameter: parameter })
            _ -> chosen(MachineArgument::Absent)
        }
    }

    state chosen(argument: MachineArgument) -> MachineArgument {
        argument
    }
}

// The callable contract generic parameter `parameter` carries; none for a
// parameter beyond the table.
pub machine NameResolution::binder_contract(resolution: &NameResolution, parameter: u64 in Trapping) -> BinderContract {
    transition parameter < 256 {
        true -> read(resolution, parameter)
        _ -> none()
    }

    state read(resolution: &NameResolution, parameter: u64 in Trapping) -> BinderContract
    requires parameter < 256
    {
        resolution.binder_contracts[parameter]
    }

    state none() -> BinderContract {
        BinderContract { present: false, contract: 0 }
    }
}

pub machine NameResolution::set_binder_contract(resolution: &mut NameResolution, parameter: u64 in Trapping, contract: BinderContract)
crashes Trap
{
    transition parameter < 256 {
        true -> write(resolution, parameter, contract)
        _ -> invalid()
    }

    state write(resolution: &mut NameResolution, parameter: u64 in Trapping, contract: BinderContract)
    requires parameter < 256
    {
        resolution.binder_contracts[parameter] = contract;
    }

    state invalid() {
        crash Trap;
    }
}

// The requirement clause `index` names, which must be below the bound count.
pub machine NameResolution::requirement(resolution: &NameResolution, index: u64 in Trapping) -> ValueBinding
crashes Trap
{
    transition index < resolution.requirement_count {
        true -> read(resolution, index)
        _ -> invalid()
    }

    state read(resolution: &NameResolution, index: u64 in Trapping) -> ValueBinding {
        resolution.requirements[index]
    }

    state invalid() -> ValueBinding {
        crash Trap;
    }
}

// The data a token-bound machine `handle` is homed at, or `Unresolved`;
// `handle` must be below the machine count.
pub machine NameResolution::operator_home(resolution: &NameResolution, handle: u64 in Trapping) -> TypeBinding
crashes Trap
{
    transition handle < resolution.machine_owner_count {
        true -> read(resolution, handle)
        _ -> invalid()
    }

    state read(resolution: &NameResolution, handle: u64 in Trapping) -> TypeBinding {
        resolution.operator_homes[handle]
    }

    state invalid() -> TypeBinding {
        crash Trap;
    }
}

// Where machine `handle` stands, which must be below the bound count.
pub machine NameResolution::machine_owner(resolution: &NameResolution, handle: u64 in Trapping) -> MachineOwner
crashes Trap
{
    transition handle < resolution.machine_owner_count {
        true -> read(resolution, handle)
        _ -> invalid()
    }

    state read(resolution: &NameResolution, handle: u64 in Trapping) -> MachineOwner {
        resolution.machine_owners[handle]
    }

    state invalid() -> MachineOwner {
        crash Trap;
    }
}

// The qualifier kind of type reference `row`, below the bound count.
pub machine NameResolution::domain_binding_at(resolution: &NameResolution, row: u64 in Trapping) -> DomainBinding
crashes Trap
{
    transition row < resolution.binding_count {
        true -> read(resolution, row)
        _ -> invalid()
    }

    state read(resolution: &NameResolution, row: u64 in Trapping) -> DomainBinding {
        resolution.domain_bindings[row]
    }

    state invalid() -> DomainBinding {
        crash Trap;
    }
}

// The declared domain or case of type reference `row`, below the bound
// count.
pub machine NameResolution::domain_item(resolution: &NameResolution, row: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition row < resolution.binding_count {
        true -> read(resolution, row)
        _ -> invalid()
    }

    state read(resolution: &NameResolution, row: u64 in Trapping) -> u64 in Trapping {
        resolution.domain_items[row] as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// The binding of name path `handle`, below the bound count.
pub machine NameResolution::path_binding(resolution: &NameResolution, handle: u64 in Trapping) -> PathBinding
crashes Trap
{
    transition handle < resolution.path_binding_count {
        true -> read(resolution, handle)
        _ -> invalid()
    }

    state read(resolution: &NameResolution, handle: u64 in Trapping) -> PathBinding {
        resolution.path_bindings[handle]
    }

    state invalid() -> PathBinding {
        crash Trap;
    }
}

// The binding of type reference `row` while resolution runs: every row
// below the syntax table's count, bound or not yet.
pub machine NameResolution::type_binding_at(resolution: &NameResolution, row: u64 in Trapping) -> TypeBinding
crashes Trap
{
    transition row < 65536 {
        true -> read(resolution, row)
        _ -> invalid()
    }

    state read(resolution: &NameResolution, row: u64 in Trapping) -> TypeBinding {
        resolution.type_bindings[row]
    }

    state invalid() -> TypeBinding {
        crash Trap;
    }
}

// The binding of name path `handle` while resolution runs.
pub machine NameResolution::path_binding_at(resolution: &NameResolution, handle: u64 in Trapping) -> PathBinding
crashes Trap
{
    transition handle < 2048 {
        true -> read(resolution, handle)
        _ -> invalid()
    }

    state read(resolution: &NameResolution, handle: u64 in Trapping) -> PathBinding {
        resolution.path_bindings[handle]
    }

    state invalid() -> PathBinding {
        crash Trap;
    }
}

// The well-founded order a `terminates by` witness ranks its subjects in
// (wiki/spec/language/termination.md#ranking): a closed vocabulary the
// compiler owns. `Default` is a witness without `-> View`, which the
// subjects' carriers elaborate: a single unsigned integer descends as a
// natural and a two-subject tuple ranks by its bounded distance.
// `Descending` is `Nat::Descending`; `BoundedDistance` is
// `Nat::BoundedDistance` over `(lower, upper)`, the distance from the lower
// subject up to the upper; `SliceLength` is `Slice::Length`, a slice's
// length; `IncreasingTo` is `Nat::IncreasingTo(limit)`, one climbing subject's
// distance up to the view's argument.
pub data RankingView [copy] {
    case Default;
    case Descending;
    case BoundedDistance;
    case SliceLength;
    case IncreasingTo;
    // A declared measure, the machine `ranking_measures` records for the
    // clause (wiki/spec/language/termination.md#ranking).
    case Measure;
}

pub machine NameResolution::ranking_view(resolution: &NameResolution, clause: u64 in Trapping) -> RankingView {
    transition clause < 2048 {
        true -> read(resolution, clause)
        _ -> none()
    }

    state read(resolution: &NameResolution, clause: u64 in Trapping) -> RankingView
    requires clause < 2048
    {
        resolution.ranking_views[clause]
    }

    state none() -> RankingView {
        RankingView::Default
    }
}

pub machine NameResolution::set_ranking_view(resolution: &mut NameResolution, clause: u64 in Trapping, view: RankingView)
crashes Trap
{
    transition clause < 2048 {
        true -> write(resolution, clause, view)
        _ -> invalid()
    }

    state write(resolution: &mut NameResolution, clause: u64 in Trapping, view: RankingView)
    requires clause < 2048
    {
        resolution.ranking_views[clause] = view;
    }

    state invalid() {
        crash Trap;
    }
}

// The offset of the entry parameter state parameter `parameter` carries,
// plus one; zero for none or a parameter beyond the table.
pub machine NameResolution::ranking_measure(resolution: &NameResolution, clause: u64 in Trapping) -> u64 in Trapping {
    transition clause < 2048 {
        true -> read(resolution, clause)
        _ -> none()
    }

    state read(resolution: &NameResolution, clause: u64 in Trapping) -> u64 in Trapping
    requires clause < 2048
    {
        resolution.ranking_measures[clause] as u64 in Trapping
    }

    state none() -> u64 in Trapping {
        0
    }
}

pub machine NameResolution::set_ranking_measure(resolution: &mut NameResolution, clause: u64 in Trapping, measure: u64 in Trapping)
crashes Trap
{
    transition clause < 2048 {
        true -> write(resolution, clause, measure)
        _ -> invalid()
    }

    state write(resolution: &mut NameResolution, clause: u64 in Trapping, measure: u64 in Trapping)
    requires clause < 2048
    {
        resolution.ranking_measures[clause] = measure as u64;
    }

    state invalid() {
        crash Trap;
    }
}

