use psi::source::source;

// Name bindings for the parsed `use`/`data` roots of one source unit. The
// binding tables are indexed like `SyntaxTrees::type_references`, so each
// syntax handle keeps its identity; no table repeats a spelling. The zero
// binding is the unresolved state, and an accepted resolution leaves none.

// Compiler-installed type names, in the reference compiler's builtin order.
pub data BuiltinType [copy] {
    case Bool;
    case I8;
    case I16;
    case I32;
    case I64;
    case U8;
    case U16;
    case U32;
    case U64;
    case Address;
    case F32;
    case F64;
    case Slice;
    case Result;
    case SyscallResult;
    case Terminal;
    case Never;
    case UInt;
    case Int;
    case AtomicBool;
    case AtomicU32;
    case AtomicU64;
}

// What a type reference's name denotes: a compiler-installed type, a data
// declaration of this unit (its `SyntaxTrees::data_items` handle), or a
// generic parameter of the enclosing declaration (its
// `SyntaxTrees::generic_parameters` handle).
// Reference, array, slice and integer rows name no declaration: each binds
// by its form, and the rows of its run carry the names' bindings.
pub data TypeBinding [copy] {
    case Unresolved;
    // Two visible declarations spell the name; the reference rejects.
    case Ambiguous;
    case Builtin(builtin: BuiltinType);
    case Data(item: u64 in Trapping);
    case GenericParameter(parameter: u64 in Trapping);
    case Reference;
    case Array;
    case Slice;
    case Literal;
}

// What a name or path in an expression denotes, indexed like
// `SyntaxTrees::expressions`. A membership `value in Type::Case` binds the
// case whose implied domain it names; other expressions that are not names
// stay `NotAName`; an accepted resolution leaves no `Unresolved` name. A machine
// binding names the first declaration of its overload family; typing selects
// among the family. A generic parameter binding names a value or machine
// binder of the enclosing machine by its `SyntaxTrees::generic_parameters`
// handle.
pub data ValueBinding [copy] {
    case NotAName;
    case Unresolved;
    // Two visible declarations spell the name; the reference rejects.
    case Ambiguous;
    case Local(statement: u64 in Trapping);
    case Parameter(parameter: u64 in Trapping);
    case PatternBinder(field: u64 in Trapping);
    case State(handle: u64 in Trapping);
    case Machine(handle: u64 in Trapping);
    case Data(item: u64 in Trapping);
    case DataCase(item: u64 in Trapping, data_case: u64 in Trapping);
    case GenericParameter(parameter: u64 in Trapping);
}

// The generic parameters a type name may bind: the enclosing declaration's
// contiguous range of `SyntaxTrees::generic_parameters`.
pub data TypeScope [copy] {
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
}

// What the `in Domain` qualifier of a type reference denotes. A bare
// reference stays `Unqualified`. The arithmetic policies and `Finite` are
// compiler-known; every other domain needs a `domain` declaration, which the
// current grammar cannot supply.
pub data DomainBinding [copy] {
    case Unqualified;
    case Wrapping;
    case Saturating;
    case Trapping;
    case Finite;
}

pub data ResolveDiagnosticCode [copy] {
    case None;
    case UnresolvedImport;
    case DataShadowsBuiltinType;
    case DuplicateData;
    case DuplicateDataMember;
    case DuplicateCasePayloadField;
    case PayloadFieldCollidesWithCommonField;
    case UnknownDataType;
    case UnknownDomain;
    case DuplicateParameter;
    case DuplicateState;
    case DuplicateMachine;
    case DuplicateGenericParameter;
    case UnknownName;
    case AmbiguousName;
    case PartialStableIdentities;
    case DuplicateStableIdentity;
    case InvalidStableIdentity;
    // A declaration kind resolution does not bind yet: a trait, conformance,
    // domain, constant, proposition or mathematical definition, or a
    // target-scoped or boundary machine. It rejects at its root rather than
    // resolving as if absent.
    case UnsupportedDeclaration;
    // A machine form that names declarations resolution does not bind yet
    // rejects at that form: an operator token, a `where machine` contract, a
    // `satisfies` or `terminates` clause, or a proposition or evidence
    // binder.
    case UnsupportedOperatorToken;
    case UnsupportedMachineContract;
    case UnsupportedClause;
    case UnsupportedGenericParameter;
    // An expression form resolution does not bind yet: a membership in
    // several domains at once.
    case UnsupportedExpression;
}

pub data ResolveDiagnostic [copy] {
    code: ResolveDiagnosticCode;
    source_span: SourceSpan;
}

pub data NameResolution
where
    binding_count <= 16384,
    value_binding_count <= 65536,
{
    type_bindings: [TypeBinding; 16384];
    domain_bindings: [DomainBinding; 16384];
    binding_count: u64;
    value_bindings: [ValueBinding; 65536];
    value_binding_count: u64;
    diagnostic: ResolveDiagnostic;
    accepted: bool;
}

pub machine NameResolution::clear(resolution: &mut NameResolution, source: SourceId) {
    resolution.binding_count = 0;
    resolution.value_binding_count = 0;
    resolution.accepted = true;
    resolution.diagnostic.code = ResolveDiagnosticCode::None;
    resolution.diagnostic.source_span.source = source;
    resolution.diagnostic.source_span.span.start = 0;
    resolution.diagnostic.source_span.span.end = 0;
}

pub machine NameResolution::reject(
    resolution: &mut NameResolution,
    code: ResolveDiagnosticCode,
    source_span: SourceSpan
) {
    resolution.accepted = false;
    resolution.diagnostic.code = code;
    resolution.diagnostic.source_span = source_span;
}

// The binding of expression `index`, which must be below the bound count.
pub machine NameResolution::value_binding(resolution: &NameResolution, index: u64 in Trapping) -> ValueBinding
crashes Trap
{
    transition index < resolution.value_binding_count {
        true -> read(resolution, index)
        _ -> invalid()
    }

    state read(resolution: &NameResolution, index: u64 in Trapping) -> ValueBinding {
        resolution.value_bindings[index]
    }

    state invalid() -> ValueBinding {
        crash Trap;
    }
}
