// Bind a type row in the role its syntax owner supplies, including builtin names and domain qualifiers.

// What a type's root position admits. A trait application stands as a
// trait's parent or a conformance's satisfied trait; a static argument may
// also name a conformance; every other position names a type. A row inside
// a type is always a type, or a conformance as an applied name's argument.
public data TypeRole [copy] {
    case Type;
    case Trait;
    case StaticArgument;
}

// What a bound row names, for its position's admission.
data BoundKind [copy] {
    case Type;
    case Trait;
    case Conformance;
}

// Bind one type in its owner's scope. A type fills a contiguous run of
// rows that ends at its root, so every row of the run binds in order: a
// named row binds its name and an `in` domain, and a reference, array, slice
// or integer row binds by its form. Nested rows need no recursion. `role` is
// what the root's position admits.
public machine bind_type_reference(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    root: u64 in Trapping,
    role: TypeRole
)
crashes Trap
{
    let root_row: TypeReference = syntax_trees_type_reference(syntax, root);
    transition { _ -> next(resolver, sources, syntax, scope, root, role, root_row.first_row) }

    machine next(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        root: u64 in Trapping,
        role: TypeRole,
        row: u64 in Trapping
    ) {
        transition row <= root && resolver.output.accepted {
            true -> bind(resolver, sources, syntax, scope, root, role, row)
            _ -> done()
        }
    }

    machine bind(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        root: u64 in Trapping,
        role: TypeRole,
        row: u64 in Trapping
    ) {
        bind_type_row(resolver, sources, syntax, scope, row, row == root, role);
        transition { _ -> next(resolver, sources, syntax, scope, root, role, row + 1) }
    }

    machine done() {}
}

// One row. A trait binds only at the root of a trait position, and a trait
// position admits nothing else; a conformance binds as a static argument's
// root or as an applied name's argument, never under a reference, array or
// slice, which bind only types.
machine bind_type_row(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    row: u64 in Trapping,
    is_root: bool,
    role: TypeRole
)
crashes Trap
{
    let type_reference: TypeReference = syntax_trees_type_reference(syntax, row);
    let whole: IdentifierSpan = IdentifierSpan { source_span: type_reference.source_span };
    let lifetimes: bool = lifetimes_declared(sources, syntax, scope, type_reference);
    transition lifetimes {
        true -> kinds(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole)
        _ -> reject(resolver, ResolveDiagnosticCode::UndeclaredLifetime, whole)
    }

    machine kinds(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference,
        whole: IdentifierSpan
    ) {
        transition type_reference.kind {
            TypeReferenceKind::Named -> arity(resolver, sources, syntax, scope, row, is_root, role, type_reference)
            TypeReferenceKind::Reference -> holder(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, TypeBinding::Reference)
            TypeReferenceKind::Array -> holder(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, TypeBinding::Array)
            TypeReferenceKind::Slice -> holder(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, TypeBinding::Slice)
            TypeReferenceKind::Literal -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, TypeBinding::Literal, BoundKind::Type)
        }
    }

    // An applied data name supplies as many lifetime arguments as the data
    // declares lifetime binders, or elides them all; other names take none.
    machine arity(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference
    ) {
        let binding: TypeBinding = type_binding(sources, syntax, scope, type_reference.name.source_span);
        let declared: u64 in Trapping = lifetime_arity(syntax, binding);
        transition declared == type_reference.lifetime_count || type_reference.lifetime_count == 0 {
            true -> named(resolver, sources, syntax, scope, row, is_root, role, type_reference)
            _ -> reject(resolver, ResolveDiagnosticCode::LifetimeArgumentCount, type_reference.name)
        }
    }

    machine named(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference
    ) {
        let binding: TypeBinding = type_binding(sources, syntax, scope,
            type_reference.name.source_span
        );
        transition binding {
            TypeBinding::Unresolved -> unnamed(resolver, sources, syntax, scope, row, is_root, role, type_reference)
            TypeBinding::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, type_reference.name)
            TypeBinding::Trait { item } -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, type_reference.name, binding, BoundKind::Trait)
            TypeBinding::Conformance { item } -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, type_reference.name, binding, BoundKind::Conformance)
            _ -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, type_reference.name, binding, BoundKind::Type)
        }
    }

    // A name no type spells: a static argument may name a machine, for a
    // callee's machine binder (wiki/spec/language/generics.md, Static
    // machine binder categories); anything else is unknown.
    machine unnamed(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference
    ) {
        transition is_root && role == TypeRole::StaticArgument && !type_reference.has_domain {
            true -> machine_argument(resolver, sources, syntax, scope, row, type_reference)
            _ -> reject(resolver, ResolveDiagnosticCode::UnknownDataType, type_reference.name)
        }
    }

    machine machine_argument(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, row: u64 in Trapping, type_reference: TypeReference) {
        let binding: ValueBinding = declaration_callee(&resolver.output, sources, syntax, scope.lexical_machine, type_reference.name.source_span);
        transition binding {
            ValueBinding::Machine { handle } -> bounded(resolver, sources, syntax, scope, row, type_reference, TypeBinding::Machine { handle: handle })
            ValueBinding::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, type_reference.name)
            _ -> reject(resolver, ResolveDiagnosticCode::UnknownDataType, type_reference.name)
        }
    }

    // A reference, array or slice holds a type, never a conformance.
    machine holder(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference,
        whole: IdentifierSpan,
        binding: TypeBinding
    ) {
        let held: TypeBinding = type_binding_at(&resolver.output, type_reference.inner);
        let held_row: TypeReference = syntax_trees_type_reference(syntax, type_reference.inner);
        transition held {
            TypeBinding::Conformance { item } -> reject(resolver, ResolveDiagnosticCode::NotAType, held_row.name)
            _ -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, binding, BoundKind::Type)
        }
    }

    machine placed(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference,
        spelled: IdentifierSpan,
        binding: TypeBinding,
        kind: BoundKind
    ) {
        let trait_root: bool = is_root && role == TypeRole::Trait;
        transition kind {
            BoundKind::Trait -> admitted(resolver, sources, syntax, scope, row, type_reference, spelled, binding, trait_root, ResolveDiagnosticCode::NotAType)
            BoundKind::Conformance -> admitted(resolver, sources, syntax, scope, row, type_reference, spelled, binding,
                !is_root || role == TypeRole::StaticArgument, ResolveDiagnosticCode::NotAType)
            BoundKind::Type -> admitted(resolver, sources, syntax, scope, row, type_reference, spelled, binding, !trait_root, ResolveDiagnosticCode::NotATrait)
        }
    }

    machine admitted(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        type_reference: TypeReference,
        spelled: IdentifierSpan,
        binding: TypeBinding,
        admits: bool,
        code: ResolveDiagnosticCode
    ) {
        transition admits {
            true -> bounded(resolver, sources, syntax, scope, row, type_reference, binding)
            _ -> reject(resolver, code, spelled)
        }
    }

    machine bounded(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        type_reference: TypeReference,
        binding: TypeBinding
    ) {
        transition row < 65536 {
            true -> store(resolver, sources, syntax, scope, row, type_reference, binding)
            _ -> invalid()
        }
    }

    machine store(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        type_reference: TypeReference,
        binding: TypeBinding
    ) {
        resolver.output.type_bindings[row] = binding;
        resolver.output.domain_bindings[row] = DomainBinding::Unqualified;
        resolver.output.domain_items[row] = 0;
        transition type_reference.has_domain {
            true -> qualified(resolver, sources, syntax, scope, row, type_reference)
            _ -> done()
        }
    }

    machine qualified(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        type_reference: TypeReference
    ) {
        bind_domain(resolver, sources, syntax, scope, row, type_reference);
    }

    machine reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        name_resolution_reject(&mut resolver.output, code, name.source_span);
    }

    machine invalid() {
        crash Trap;
    }

    machine done() {}
}

// The declaration a type name denotes in `scope`: an enclosing generic
// parameter by spelling (lifetimes are not type names), the declaration's
// own before its container's, then a builtin type, then the one data, trait
// or conformance declaration the name's unit can see.
public machine type_binding(
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    name: SourceSpan
) -> TypeBinding
crashes Trap
{
    let own: Lookup = generic_named(sources, syntax, scope.first_generic_parameter, scope.generic_parameter_count, name);
    transition own {
        Lookup::Found { handle } -> found(TypeBinding::GenericParameter { parameter: handle })
        _ -> outer(sources, syntax, scope, name)
    }

    machine outer(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan) -> TypeBinding {
        let container: Lookup = scoped_generic_named(sources, syntax, scope, name);
        transition container {
            Lookup::Found { handle } -> found(TypeBinding::GenericParameter { parameter: handle })
            _ -> builtin(sources, syntax, name)
        }
    }

    machine builtin(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> TypeBinding {
        let binding: TypeBinding = builtin_type(sources, name);
        transition binding {
            TypeBinding::Unresolved -> declared(sources, syntax, name)
            _ -> found(binding)
        }
    }

    // A visible data declaration, trait or conformance of the spelling; two
    // of them, of any kinds, make the name ambiguous.
    machine declared(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> TypeBinding {
        let data: Lookup = data_named(sources, syntax, name);
        transition data {
            Lookup::Found { handle } -> data_found(sources, syntax, name, handle)
            Lookup::Ambiguous -> found(TypeBinding::Ambiguous)
            Lookup::Absent -> traits(sources, syntax, name)
        }
    }

    machine data_found(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan, item: u64 in Trapping) -> TypeBinding {
        let rivals: bool = trait_or_conformance_named(sources, syntax, name);
        transition rivals {
            true -> found(TypeBinding::Ambiguous)
            _ -> found(TypeBinding::Data { item: item })
        }
    }

    machine traits(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> TypeBinding {
        let traits: Lookup = declared_named(sources, syntax, DeclarationKind::Trait, false, name, name);
        transition traits {
            Lookup::Found { handle } -> trait_found(sources, syntax, name, handle)
            Lookup::Ambiguous -> found(TypeBinding::Ambiguous)
            Lookup::Absent -> conformances(sources, syntax, name)
        }
    }

    machine trait_found(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan, item: u64 in Trapping) -> TypeBinding {
        let conformances: Lookup = declared_named(sources, syntax, DeclarationKind::Conformance, false, name, name);
        transition conformances {
            Lookup::Absent -> found(TypeBinding::Trait { item: item })
            _ -> found(TypeBinding::Ambiguous)
        }
    }

    machine conformances(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> TypeBinding {
        let conformances: Lookup = declared_named(sources, syntax, DeclarationKind::Conformance, false, name, name);
        transition conformances {
            Lookup::Found { handle } -> found(TypeBinding::Conformance { item: handle })
            Lookup::Ambiguous -> found(TypeBinding::Ambiguous)
            Lookup::Absent -> found(TypeBinding::Unresolved)
        }
    }

    machine found(binding: TypeBinding) -> TypeBinding {
        binding
    }
}

// Whether a trait or a conformance of the spelling is visible.
machine trait_or_conformance_named(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> bool
crashes Trap
{
    let traits: Lookup = declared_named(sources, syntax, DeclarationKind::Trait, false, name, name);
    transition traits {
        Lookup::Absent -> conformances(sources, syntax, name)
        _ -> yes()
    }

    machine conformances(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> bool {
        let conformances: Lookup = declared_named(sources, syntax, DeclarationKind::Conformance, false, name, name);
        transition conformances {
            Lookup::Absent -> no()
            _ -> yes()
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// The domain an `in` qualifier names. A bare name is a compiler-known
// domain by spelling, else the one declared domain of that name whose
// carrier admits the qualified type (domains.omg). A path `Owner::Name`
// names what a membership's path names (names.omg): a case of data `Owner`,
// whose implied domain qualifies only that data, or the declared domain
// over the type `Owner` names in `scope`, whose carrier must admit the
// qualified type (wiki/spec/language/modules.md#foreign-attached-declaration-paths).
// A longer path crosses a package, which this source set cannot bind.
// Generic parameters do not bind domains.
machine bind_domain(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    reference: u64 in Trapping,
    type_reference: TypeReference
)
// The caller binds only references it has bounded by the syntax table.
requires reference < 65536
crashes Trap
{
    let whole: SourceSpan = qualifier_span(type_reference);
    transition type_reference.has_domain_owner {
        true -> owned(resolver, sources, syntax, scope, reference, type_reference, whole)
        _ -> bare(resolver, sources, syntax, reference, type_reference.domain)
    }

    machine bare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, reference: u64 in Trapping, domain: IdentifierSpan) {
        let known: DomainBinding = known_domain(sources, domain.source_span);
        transition known {
            DomainBinding::Unqualified -> declared(resolver, sources, syntax, reference, domain)
            _ -> bind(resolver, reference, known, 0)
        }
    }

    machine declared(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, reference: u64 in Trapping, domain: IdentifierSpan) {
        let lookup: Lookup = resolver_declared_domain(resolver, sources, syntax, reference, domain.source_span);
        transition lookup {
            Lookup::Found { handle } -> bind(resolver, reference, DomainBinding::Declared, handle)
            Lookup::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, domain.source_span)
            Lookup::Absent -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, domain.source_span)
        }
    }

    machine owned(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        reference: u64 in Trapping,
        type_reference: TypeReference,
        whole: SourceSpan
    ) {
        let named: DomainPath = resolver_domain_path(resolver, sources, syntax, scope,
            type_reference.domain_owner.source_span, type_reference.domain.source_span
        );
        transition named {
            DomainPath::Case { item, data_case } -> case_domain(resolver, reference, whole, item, data_case)
            DomainPath::Declared { item } -> declared_carrier(resolver, sources, syntax, reference, type_reference, whole, item)
            DomainPath::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, whole)
            DomainPath::Absent -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    machine case_domain(resolver: &mut Resolver, reference: u64 in Trapping, whole: SourceSpan, owner: u64 in Trapping, data_case: u64 in Trapping) {
        let qualified: TypeBinding = type_binding_at(&resolver.output, reference);
        transition qualified {
            TypeBinding::Data { item } -> case_carrier(resolver, reference, whole, item == owner, data_case)
            _ -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    machine case_carrier(resolver: &mut Resolver, reference: u64 in Trapping, whole: SourceSpan, own: bool, data_case: u64 in Trapping) {
        transition own {
            true -> bind(resolver, reference, DomainBinding::Case, data_case)
            _ -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    machine declared_carrier(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        reference: u64 in Trapping,
        type_reference: TypeReference,
        whole: SourceSpan,
        domain: u64 in Trapping
    ) {
        let admitted: bool = domain_admits(resolver, sources, syntax, domain, reference, type_reference.domain.source_span);
        transition admitted {
            true -> bind(resolver, reference, DomainBinding::Declared, domain)
            _ -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    machine bind(resolver: &mut Resolver, reference: u64 in Trapping, binding: DomainBinding, item: u64 in Trapping) {
        resolver.output.domain_bindings[reference] = binding;
        resolver.output.domain_items[reference] = item as u64;
    }

    machine reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, source_span: SourceSpan) {
        name_resolution_reject(&mut resolver.output, code, source_span);
    }
}

// Whether a name is spelled like a builtin type
// (wiki/spec/language/modules.md#builtin-type-names): an installed builtin,
// or the open-ended integer family `i`, `u`, and either letter followed by
// decimal digits, whether or not the digits form a valid width. `u7` and
// `u128` install no type, yet no declaration may introduce a type with
// those spellings, so this test is wider than `builtin_type`.
public machine builtin_type_spelling(sources: &SourceSet, name: SourceSpan) -> bool
crashes Trap
{
    let installed: TypeBinding = builtin_type(sources, name);
    transition installed {
        TypeBinding::Unresolved -> family(sources, name)
        _ -> yes()
    }

    machine family(sources: &SourceSet, name: SourceSpan) -> bool {
        let first: u8 = source_set_byte_or_nul(sources, name.source, name.span.start);
        transition name.span.end > name.span.start && (first == 105 || first == 117) {
            true -> digits(sources, name, name.span.start + 1)
            _ -> no()
        }
    }

    machine digits(sources: &SourceSet, name: SourceSpan, index: u64 in Trapping) -> bool {
        transition index < name.span.end {
            true -> digit(sources, name, index)
            _ -> yes()
        }
    }

    machine digit(sources: &SourceSet, name: SourceSpan, index: u64 in Trapping) -> bool {
        let byte: u8 = source_set_byte_or_nul(sources, name.source, index);
        transition byte >= 48 && byte <= 57 {
            true -> digits(sources, name, index + 1)
            _ -> no()
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// The compiler-installed type a name spells, or `Unresolved`. Builtin names
// are not source declarations, so they match by spelling, not by span.
public machine builtin_type(sources: &SourceSet, name: SourceSpan) -> TypeBinding
crashes Trap
{
    let matched: bool = span_spells(sources, name, "bool");
    transition matched { true -> found(BuiltinType::Bool) _ -> spells_i8(sources, name) }

    machine spells_i8(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "i8");
        transition matched { true -> found(BuiltinType::I8) _ -> spells_i16(sources, name) }
    }

    machine spells_i16(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "i16");
        transition matched { true -> found(BuiltinType::I16) _ -> spells_i32(sources, name) }
    }

    machine spells_i32(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "i32");
        transition matched { true -> found(BuiltinType::I32) _ -> spells_i64(sources, name) }
    }

    machine spells_i64(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "i64");
        transition matched { true -> found(BuiltinType::I64) _ -> spells_u8(sources, name) }
    }

    machine spells_u8(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "u8");
        transition matched { true -> found(BuiltinType::U8) _ -> spells_u16(sources, name) }
    }

    machine spells_u16(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "u16");
        transition matched { true -> found(BuiltinType::U16) _ -> spells_u32(sources, name) }
    }

    machine spells_u32(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "u32");
        transition matched { true -> found(BuiltinType::U32) _ -> spells_u64(sources, name) }
    }

    machine spells_u64(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "u64");
        transition matched { true -> found(BuiltinType::U64) _ -> spells_addr(sources, name) }
    }

    machine spells_addr(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "addr");
        transition matched { true -> found(BuiltinType::Address) _ -> spells_f32(sources, name) }
    }

    machine spells_f32(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "f32");
        transition matched { true -> found(BuiltinType::F32) _ -> spells_f64(sources, name) }
    }

    machine spells_f64(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "f64");
        transition matched { true -> found(BuiltinType::F64) _ -> spells_slice(sources, name) }
    }

    machine spells_slice(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "Slice");
        transition matched { true -> found(BuiltinType::Slice) _ -> spells_syscallresult(sources, name) }
    }

    machine spells_syscallresult(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "SyscallResult");
        transition matched { true -> found(BuiltinType::SyscallResult) _ -> spells_terminal(sources, name) }
    }

    machine spells_terminal(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "Terminal");
        transition matched { true -> found(BuiltinType::Terminal) _ -> spells_never(sources, name) }
    }

    machine spells_never(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "Never");
        transition matched { true -> found(BuiltinType::Never) _ -> spells_uint(sources, name) }
    }

    machine spells_uint(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "UInt");
        transition matched { true -> found(BuiltinType::UInt) _ -> spells_int(sources, name) }
    }

    machine spells_int(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "Int");
        transition matched { true -> found(BuiltinType::Int) _ -> spells_atomicbool(sources, name) }
    }

    machine spells_atomicbool(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "AtomicBool");
        transition matched { true -> found(BuiltinType::AtomicBool) _ -> spells_atomicu32(sources, name) }
    }

    machine spells_atomicu32(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "AtomicU32");
        transition matched { true -> found(BuiltinType::AtomicU32) _ -> spells_atomicu64(sources, name) }
    }

    machine spells_atomicu64(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
        let matched: bool = span_spells(sources, name, "AtomicU64");
        transition matched { true -> found(BuiltinType::AtomicU64) _ -> absent() }
    }

    machine found(builtin: BuiltinType) -> TypeBinding {
        TypeBinding::Builtin { builtin: builtin }
    }

    machine absent() -> TypeBinding {
        TypeBinding::Unresolved
    }
}
