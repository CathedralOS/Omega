// A machine name binds at one lexical tier in one module. Every declaration
// in that family shares the same import route. Across packages only its public
// members are visible; each use records which chain typing may walk.
public machine bind_visible_overloads(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> clear(resolver, sources, syntax, 0) }
    machine clear(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition (index as -Trapping) < syntax.machine_count && index < 10240 {
            true -> clear_one(resolver, sources, syntax, index)
            false -> next(resolver, sources, syntax, 0)
        }
    }
    machine clear_one(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        resolver.overload_heads[index as -Trapping] = OverloadLinks { all: 0, exported: 0 };
        transition { _ -> clear(resolver, sources, syntax, index + 1) }
    }

    machine next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition (index as -Trapping) < syntax.expression_count && index < 131072 {
            true -> inspect(resolver, sources, syntax, index)
            false -> done()
        }
    }
    machine inspect(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let binding: ValueBinding = resolver.output.value_bindings[index as -Trapping];
        transition binding {
            ValueBinding::Machine { handle } -> bind(resolver, sources, syntax, index, handle)
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }
    machine bind(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, handle: u64 in Trapping) {
        let expression: Expression = syntax_trees_expression(syntax, index);
        let candidates: VisibleOverloads = visible_overloads(resolver, sources, syntax, handle, expression.source_span.source);
        resolver.output.value_bindings[index as -Trapping] = ValueBinding::Overloads { representative: handle, candidates: candidates };
        transition { _ -> next(resolver, sources, syntax, index + 1) }
    }
    machine done() {}
}

machine visible_overloads(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, representative: u64 in Trapping, from: SourceId) -> VisibleOverloads
crashes Trap
{
    let item: MachineItem = machine_item(syntax, representative);
    let declared: SourceId = item.name.source_span.source;
    let seen: bool = resolver_visible(sources, syntax, from, declared, true);
    let local: bool = resolver_same_package(sources, overload_unit_index(from), overload_unit_index(declared));
    transition seen && representative < 10240 {
        true -> family(resolver, sources, syntax, representative, item, local)
        _ -> VisibleOverloads { first: 0, public_only: false }
    }

    machine family(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, representative: u64 in Trapping, item: MachineItem, local: bool) -> VisibleOverloads {
        let heads: OverloadLinks = resolver.overload_heads[representative as -Trapping];
        transition heads.all > 0 {
            true -> selected(heads, local)
            _ -> build(resolver, sources, syntax, representative, item, local)
        }
    }

    machine build(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, representative: u64 in Trapping, item: MachineItem, local: bool) -> VisibleOverloads {
        let path: MachineOwner = machine_owner(&resolver.output, representative);
        let empty: OverloadLinks = OverloadLinks { all: 0, exported: 0 };
        let heads: OverloadLinks = link_overloads(resolver, sources, syntax, item, path, syntax.machine_count as +Trapping, empty);
        transition representative < 10240 {
            true -> cache(resolver, representative, heads, local)
            _ -> invalid()
        }
    }
    machine cache(resolver: &mut Resolver, representative: u64 in Trapping, heads: OverloadLinks, local: bool) -> VisibleOverloads {
        resolver.overload_heads[representative as -Trapping] = heads;
        transition { _ -> selected(heads, local) }
    }
    machine selected(heads: OverloadLinks, local: bool) -> VisibleOverloads {
        transition local {
            true -> VisibleOverloads { first: heads.all, public_only: false }
            false -> VisibleOverloads { first: heads.exported, public_only: true }
        }
    }
    machine invalid() -> VisibleOverloads { crash Trap; }
}

// Prepending in reverse declaration order gives both views stable forward
// iteration. Links are stored once per declaration, regardless of call count.
machine link_overloads(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, named: MachineItem, path: MachineOwner, end: u64 in Trapping, heads: OverloadLinks) -> OverloadLinks
crashes Trap
{
    transition end > 0 {
        true -> candidate(resolver, sources, syntax, named, path, end - 1, heads)
        false -> heads
    }

    machine candidate(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, named: MachineItem, path: MachineOwner, index: u64 in Trapping, heads: OverloadLinks) -> OverloadLinks {
        let item: MachineItem = machine_item(syntax, index);
        let same: bool = machine_spells(&resolver.output, sources, item, index, path.has_owner, path.owner.source_span, named.name.source_span);
        transition same && item.parent == named.parent {
            true -> owner(resolver, sources, syntax, named, path, index, item, heads)
            false -> link_overloads(resolver, sources, syntax, named, path, index, heads)
        }
    }

    machine owner(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, named: MachineItem, path: MachineOwner, index: u64 in Trapping, item: MachineItem, heads: OverloadLinks) -> OverloadLinks {
        let same: bool = resolver_same_module(sources, overload_unit_index(named.name.source_span.source), overload_unit_index(item.name.source_span.source));
        transition same {
            true -> prepend(resolver, sources, syntax, named, path, index, item, heads)
            false -> link_overloads(resolver, sources, syntax, named, path, index, heads)
        }
    }

    machine prepend(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, named: MachineItem, path: MachineOwner, index: u64 in Trapping, item: MachineItem, heads: OverloadLinks) -> OverloadLinks {
        let exported: bool = machine_public(&resolver.output, syntax, item, index);
        let first: OverloadLinks = prepend_overload(&mut resolver.output.overloads, index, heads, exported);
        transition { _ -> link_overloads(resolver, sources, syntax, named, path, index, first) }
    }
}

// Source IDs are 32-bit. SourceSet lookups use a 64-bit unit index.
machine overload_unit_index(source: SourceId) -> u64 in Trapping {
    ((source.value as -Trapping) as u64) as +Trapping
}

// The first visible machine whose path is `name` (owned by `owner` when
// `owned`): its overload family's representative, since typing selects
// among a module's overloads. A machine's path is its `MachineOwner`'s, so
// `Trait::requirement` and `Conformance::member` name container members. A
// visible machine of the same path in another module makes the name
// ambiguous.
public machine machine_named(
    resolution: &NameResolution,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    owned: bool,
    owner: SourceSpan,
    name: SourceSpan
) -> Lookup
crashes Trap
{
    transition { _ -> next(resolution, sources, syntax, owned, owner, name, 0) }

    machine next(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owned: bool, owner: SourceSpan, name: SourceSpan, index: u64 in Trapping) -> Lookup {
        transition index < syntax.machine_count {
            true -> candidate(resolution, sources, syntax, owned, owner, name, index)
            _ -> absent()
        }
    }

    machine candidate(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owned: bool, owner: SourceSpan, name: SourceSpan, index: u64 in Trapping) -> Lookup {
        let item: MachineItem = machine_item(syntax, index);
        let named: bool = item.parent == 0 && machine_spells(resolution, sources, item, index, owned, owner, name);
        let visible: bool = machine_visible_if(resolution, sources, syntax, named, name.source, item, index);
        transition visible {
            true -> rival(resolution, sources, syntax, owned, owner, name, index, item.name.source_span.source, index + 1)
            _ -> next(resolution, sources, syntax, owned, owner, name, index + 1)
        }
    }

    machine rival(
        resolution: &NameResolution,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        owned: bool,
        owner: SourceSpan,
        name: SourceSpan,
        found: u64 in Trapping,
        family: SourceId,
        index: u64 in Trapping
    ) -> Lookup {
        transition index < syntax.machine_count {
            true -> rival_candidate(resolution, sources, syntax, owned, owner, name, found, family, index)
            _ -> unique(found)
        }
    }

    machine rival_candidate(
        resolution: &NameResolution,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        owned: bool,
        owner: SourceSpan,
        name: SourceSpan,
        found: u64 in Trapping,
        family: SourceId,
        index: u64 in Trapping
    ) -> Lookup {
        let item: MachineItem = machine_item(syntax, index);
        let named: bool = item.parent == 0 && machine_spells(resolution, sources, item, index, owned, owner, name);
        let visible: bool = machine_visible_if(resolution, sources, syntax, named, name.source, item, index);
        let overload: bool = resolver_same_module(sources, family.value as u64 in Trapping,
            item.name.source_span.source.value as u64 in Trapping);
        transition visible && !overload {
            true -> ambiguous()
            _ -> rival(resolution, sources, syntax, owned, owner, name, found, family, index + 1)
        }
    }

    machine unique(found: u64 in Trapping) -> Lookup {
        Lookup::Found { handle: found }
    }

    machine absent() -> Lookup {
        Lookup::Absent
    }

    machine ambiguous() -> Lookup {
        Lookup::Ambiguous
    }
}

// Whether machine `handle` (row `item`) has the path `name` (owned by
// `owner` when `owned`), through its `MachineOwner`.
public machine machine_spells(
    resolution: &NameResolution,
    sources: &SourceSet,
    item: MachineItem,
    handle: u64 in Trapping,
    owned: bool,
    owner: SourceSpan,
    name: SourceSpan
) -> bool
crashes Trap
{
    let path: MachineOwner = machine_owner(resolution, handle);
    let named: bool = spans_equal(sources, item.name.source_span, name);
    let owner_named: bool = spans_equal(sources, path.owner.source_span, owner);
    let callable: bool = item.container != MachineContainer::Measure;
    callable && named && path.has_owner == owned && (!owned || owner_named)
}

// A machine's visibility, tested only when its spelling matched.
public machine machine_visible_if(
    resolution: &NameResolution,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    named: bool,
    from: SourceId,
    item: MachineItem,
    handle: u64 in Trapping
) -> bool
crashes Trap
{
    transition named {
        true -> test(resolution, sources, syntax, from, item, handle)
        _ -> hidden()
    }

    machine test(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, from: SourceId, item: MachineItem, handle: u64 in Trapping) -> bool {
        let is_public: bool = machine_public(resolution, syntax, item, handle);
        resolver_visible(sources, syntax, from, item.name.source_span.source, is_public)
    }

    machine hidden() -> bool {
        false
    }
}

// Whether machine `handle` (row `item`) is `public`: a root machine by its own
// marker, a trait's or conformance's member by its container's.
public machine machine_public(resolution: &NameResolution, syntax: &SyntaxTrees, item: MachineItem, handle: u64 in Trapping) -> bool
crashes Trap
{
    let owner: MachineOwner = machine_owner(resolution, handle);
    transition owner.container {
        MachineContainer::Root -> answer(item.is_public)
        MachineContainer::Measure -> answer(false)
        MachineContainer::Trait -> trait_container(syntax, owner.item)
        MachineContainer::Refinement -> trait_container(syntax, owner.item)
        MachineContainer::Conformance -> conformance_container(syntax, owner.item)
    }

    machine trait_container(syntax: &SyntaxTrees, index: u64 in Trapping) -> bool {
        let container: TraitItem = trait_item(syntax, index);
        container.is_public
    }

    machine conformance_container(syntax: &SyntaxTrees, index: u64 in Trapping) -> bool {
        let container: ConformanceItem = conformance_item(syntax, index);
        container.is_public
    }

    machine answer(is_public: bool) -> bool {
        is_public
    }
}
