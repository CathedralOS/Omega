// Walk the syntax owners that supply a type reference’s lexical scope. The binding of each individual type lives in type_names.omg.

// Type references of each data declaration: its generic-parameter
// annotations, then its members' references in authored order. Every type
// reference has exactly one owner, so this walk binds the whole table.
machine bind_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, sources, syntax, 0) }

    machine next_data(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        transition data_index < syntax.data_count {
            true -> data_references(resolver, sources, syntax, data_index)
            _ -> done()
        }
    }

    machine data_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        let item: DataItem = syntax_trees_data_item(syntax, data_index);
        let scope: TypeScope = data_scope(item);
        bind_generic_annotations(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, 0)
            _ -> done()
        }
    }

    machine member(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.member_count {
            true -> member_kind(resolver, sources, syntax, data_index, item, offset)
            _ -> next_data(resolver, sources, syntax, data_index + 1)
        }
    }

    machine member_kind(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let data_member: DataMember = syntax_trees_data_member(syntax, item.first_member + offset);
        transition data_member.kind {
            DataMemberKind::Field -> field_reference(resolver, sources, syntax, data_index, item, offset, data_member.item_index)
            DataMemberKind::Case -> case_references(resolver, sources, syntax, data_index, item, offset, data_member.item_index)
        }
    }

    machine field_reference(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, handle: u64 in Trapping) {
        let field: DataField = syntax_trees_field(syntax, handle);
        let scope: TypeScope = data_scope(item);
        bind_type_reference(resolver, sources, syntax, scope, field.type_reference, TypeRole::Type);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, offset + 1)
            _ -> done()
        }
    }

    machine case_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, handle: u64 in Trapping) {
        let data_case: DataCase = syntax_trees_data_case(syntax, handle);
        transition { _ -> payload(resolver, sources, syntax, data_index, item, offset, data_case, 0) }
    }

    machine payload(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        transition field_offset < data_case.payload_field_count {
            true -> payload_reference(resolver, sources, syntax, data_index, item, offset, data_case, field_offset)
            _ -> member(resolver, sources, syntax, data_index, item, offset + 1)
        }
    }

    machine payload_reference(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        let field: DataField = syntax_trees_payload_field(syntax, data_case.first_payload_field + field_offset);
        let scope: TypeScope = data_scope(item);
        bind_type_reference(resolver, sources, syntax, scope, field.type_reference, TypeRole::Type);
        transition resolver.output.accepted {
            true -> payload(resolver, sources, syntax, data_index, item, offset, data_case, field_offset + 1)
            _ -> done()
        }
    }

    machine done() {}
}

// Type references of every trait, conformance, constant and proposition,
// each in its declaration's scope: a trait's generic annotations and
// parents, which name traits; a conformance's generic annotations and
// satisfied trait; a constant's type; a proposition's generic annotations,
// parameter types and evidence type.
machine bind_declaration_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> traits(resolver, sources, syntax, 0) }

    machine traits(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.trait_count && resolver.output.accepted {
            true -> trait_annotations(resolver, sources, syntax, index)
            _ -> conformances(resolver, sources, syntax, 0)
        }
    }

    machine trait_annotations(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: TraitItem = trait_item(syntax, index);
        let scope: TypeScope = resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        bind_generic_annotations(resolver, sources, syntax, scope);
        transition { _ -> parents(resolver, sources, syntax, index, item, scope, 0) }
    }

    machine parents(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: TraitItem, scope: TypeScope, offset: u64 in Trapping) {
        transition offset < item.parent_count && resolver.output.accepted {
            true -> parent(resolver, sources, syntax, index, item, scope, offset)
            _ -> traits(resolver, sources, syntax, index + 1)
        }
    }

    machine parent(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: TraitItem, scope: TypeScope, offset: u64 in Trapping) {
        let row: u64 in Trapping = trait_parent(syntax, item.first_parent + offset);
        bind_type_reference(resolver, sources, syntax, scope, row, TypeRole::Trait);
        transition { _ -> parents(resolver, sources, syntax, index, item, scope, offset + 1) }
    }

    machine conformances(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.conformance_count && resolver.output.accepted {
            true -> conformance(resolver, sources, syntax, index)
            _ -> constants(resolver, sources, syntax, 0)
        }
    }

    machine conformance(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: ConformanceItem = conformance_item(syntax, index);
        let scope: TypeScope = resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        bind_generic_annotations(resolver, sources, syntax, scope);
        bind_type_reference(resolver, sources, syntax, scope, item.trait_type, TypeRole::Trait);
        transition { _ -> conformances(resolver, sources, syntax, index + 1) }
    }

    machine constants(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.constant_count && resolver.output.accepted {
            true -> constant(resolver, sources, syntax, index)
            _ -> propositions(resolver, sources, syntax, 0)
        }
    }

    machine constant(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: ConstantItem = constant_item(syntax, index);
        let scope: TypeScope = empty_scope();
        bind_type_reference(resolver, sources, syntax, scope, item.type_reference, TypeRole::Type);
        transition { _ -> constants(resolver, sources, syntax, index + 1) }
    }

    machine propositions(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.proposition_count && resolver.output.accepted {
            true -> proposition(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    machine proposition(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: PropositionItem = proposition_item(syntax, index);
        let scope: TypeScope = resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        bind_generic_annotations(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> proposition_signature(resolver, sources, syntax, index, item, scope)
            _ -> done()
        }
    }

    machine proposition_signature(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: PropositionItem, scope: TypeScope) {
        bind_signature(resolver, sources, syntax, scope, item.first_parameter, item.parameter_count, false, 0);
        transition resolver.output.accepted && item.body == PropositionBody::Evidence {
            true -> evidence(resolver, sources, syntax, index, item, scope)
            _ -> propositions(resolver, sources, syntax, index + 1)
        }
    }

    machine evidence(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: PropositionItem, scope: TypeScope) {
        bind_type_reference(resolver, sources, syntax, scope, item.evidence, TypeRole::Type);
        transition { _ -> propositions(resolver, sources, syntax, index + 1) }
    }

    machine done() {}
}

// Machine signatures: each machine's generic annotations, its parameter and
// return types and its `requires machine` contracts, all in
// the machine's scope (a trait or conformance member's includes its
// container's generic parameters).
machine bind_machine_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_machine(resolver, sources, syntax, 0) }

    machine next_machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> machine_signature(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    machine machine_signature(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, index);
        let scope: TypeScope = resolver_machine_scope(&resolver.output, syntax, index);
        bind_generic_annotations(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> entry_signature(resolver, sources, syntax, index, item, scope)
            _ -> done()
        }
    }

    machine entry_signature(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        scope: TypeScope
    ) {
        bind_signature(resolver, sources, syntax, scope, item.first_parameter, item.parameter_count,
            item.has_return_type, item.return_type
        );
        transition resolver.output.accepted {
            true -> contract_signature(resolver, sources, syntax, index, item, scope, 0)
            _ -> done()
        }
    }

    // Each `requires machine` contract's signature, in the machine's scope.
    machine contract_signature(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        scope: TypeScope,
        offset: u64 in Trapping
    ) {
        transition offset < item.contract_count && resolver.output.accepted {
            true -> bind_contract(resolver, sources, syntax, index, item, scope, offset)
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    machine bind_contract(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        scope: TypeScope,
        offset: u64 in Trapping
    ) {
        let written: Contract = syntax_trees_contract(syntax, item.first_contract + offset);
        bind_signature(resolver, sources, syntax, scope, written.first_parameter, written.parameter_count,
            written.has_return_type, written.return_type
        );
        transition { _ -> contract_signature(resolver, sources, syntax, index, item, scope, offset + 1) }
    }

    machine done() {}
}

// One signature's parameter types, then its return type when present, in
// its machine's scope.
machine bind_signature(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping,
    has_return_type: bool,
    return_type: u64 in Trapping
)
crashes Trap
{
    transition { _ -> parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, 0) }

    machine parameter(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        has_return_type: bool,
        return_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < parameter_count {
            true -> bind_parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, offset)
            _ -> result(resolver, sources, syntax, scope, has_return_type, return_type)
        }
    }

    machine bind_parameter(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        has_return_type: bool,
        return_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let parameter: Parameter = syntax_trees_parameter(syntax, first_parameter + offset);
        bind_type_reference(resolver, sources, syntax, scope, parameter.type_reference, TypeRole::Type);
        transition resolver.output.accepted {
            true -> parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, offset + 1)
            _ -> done()
        }
    }

    machine result(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        has_return_type: bool,
        return_type: u64 in Trapping
    ) {
        transition has_return_type {
            true -> bind_result(resolver, sources, syntax, scope, return_type)
            _ -> done()
        }
    }

    machine bind_result(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, return_type: u64 in Trapping) {
        bind_type_reference(resolver, sources, syntax, scope, return_type, TypeRole::Type);
    }

    machine done() {}
}

// Body type references: every `let` statement's type, then every cast's
// target type and every static application's arguments, in table order. A
// machine's statements and its expressions each fill a contiguous run, and
// machines follow one another in both tables, so one pass with a cursor on
// the owning machine binds each in that machine's scope. Statements belong
// to machines only; an expression outside every machine binds in the scope
// of the declaration whose fact or value holds it (`detached_scope`).
machine bind_body_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> statement(resolver, sources, syntax, 0, 0) }

    machine statement(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition index < syntax.statement_count && resolver.output.accepted {
            true -> statement_owner(resolver, sources, syntax, index, owner)
            _ -> expressions(resolver, sources, syntax)
        }
    }

    machine statement_owner(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition owner < syntax.machine_count {
            true -> statement_in(resolver, sources, syntax, index, owner)
            _ -> invalid()
        }
    }

    machine statement_in(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, owner);
        let end: u64 in Trapping = resolver_statement_end(syntax, item);
        transition index < end {
            true -> statement_kind(resolver, sources, syntax, index, owner, item)
            _ -> statement_owner(resolver, sources, syntax, index, owner + 1)
        }
    }

    machine statement_kind(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        item: MachineItem
    ) {
        let statement: Statement = syntax_trees_statement(syntax, index);
        let scope: TypeScope = resolver_machine_scope(&resolver.output, syntax, owner);
        transition statement.kind {
            StatementKind::Let -> bind_local(resolver, sources, syntax, index, owner, scope, statement.type_reference)
            _ -> statement(resolver, sources, syntax, index + 1, owner)
        }
    }

    machine bind_local(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        reference: u64 in Trapping
    ) {
        bind_type_reference(resolver, sources, syntax, scope, reference, TypeRole::Type);
        transition { _ -> statement(resolver, sources, syntax, index + 1, owner) }
    }

    machine expressions(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        transition resolver.output.accepted {
            true -> expression(resolver, sources, syntax, 0, 0)
            _ -> done()
        }
    }

    machine expression(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition index < syntax.expression_count && resolver.output.accepted {
            true -> expression_owner(resolver, sources, syntax, index, owner)
            _ -> done()
        }
    }

    // Move the cursor past machines whose run ends at or before `index`.
    machine expression_owner(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let scope: TypeScope = detached_scope(syntax, index);
        transition owner < syntax.machine_count {
            true -> expression_in(resolver, sources, syntax, index, owner)
            _ -> expression_kind(resolver, sources, syntax, index, owner, scope)
        }
    }

    machine expression_in(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, owner);
        transition index < item.first_expression + item.expression_count {
            true -> expression_scope(resolver, sources, syntax, index, owner, item)
            _ -> expression_owner(resolver, sources, syntax, index, owner + 1)
        }
    }

    machine expression_scope(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        item: MachineItem
    ) {
        let owned: TypeScope = resolver_machine_scope(&resolver.output, syntax, owner);
        let unowned: TypeScope = detached_scope(syntax, index);
        transition index >= item.first_expression {
            true -> expression_kind(resolver, sources, syntax, index, owner, owned)
            _ -> expression_kind(resolver, sources, syntax, index, owner, unowned)
        }
    }

    machine expression_kind(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope
    ) {
        let expression: Expression = syntax_trees_expression(syntax, index);
        transition expression.kind {
            ExpressionKind::Cast -> cast_form(resolver, sources, syntax, index, owner, scope, expression)
            ExpressionKind::Apply -> static_argument(resolver, sources, syntax, index, owner, scope, expression, 0)
            _ -> expression(resolver, sources, syntax, index + 1, owner)
        }
    }

    // A static application's arguments are types (or integer values) listed
    // in `type_arguments`; each binds like a body type.
    machine static_argument(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        application: Expression,
        offset: u64 in Trapping
    ) {
        transition offset < application.count && resolver.output.accepted {
            true -> bind_static_argument(resolver, sources, syntax, index, owner, scope, application, offset)
            _ -> expression(resolver, sources, syntax, index + 1, owner)
        }
    }

    machine bind_static_argument(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        application: Expression,
        offset: u64 in Trapping
    ) {
        let argument: u64 in Trapping = type_argument(syntax, application.first + offset);
        bind_type_reference(resolver, sources, syntax, scope, argument, TypeRole::StaticArgument);
        transition { _ -> static_argument(resolver, sources, syntax, index, owner, scope, application, offset + 1) }
    }

    // A domain-only cast has no carrier type-reference row. Its zero field
    // is unused storage, not an alias for the first authored type. The
    // supported compiler-known policy name is classified at type checking;
    // other domain forms remain explicit coverage refusals there.
    machine cast_form(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        cast: Expression
    ) {
        transition cast.flag {
            true -> expression(resolver, sources, syntax, index + 1, owner)
            _ -> bind_cast(resolver, sources, syntax, index, owner, scope, cast.type_reference)
        }
    }

    machine bind_cast(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        reference: u64 in Trapping
    ) {
        bind_type_reference(resolver, sources, syntax, scope, reference, TypeRole::Type);
        transition { _ -> expression(resolver, sources, syntax, index + 1, owner) }
    }

    // Every statement lies in a machine's run.
    machine invalid() {
        crash Trap;
    }

    machine done() {}
}

// The scope of expression `index` outside every machine: a domain's
// predicate facts see its generic parameters, a transparent proposition's
// fact its own, a data declaration's or case's `requires` facts the data's; a
// constant's value has no generic parameters. Only casts and static
// applications ask, so the scan is rare.
machine detached_scope(syntax: &SyntaxTrees, index: u64 in Trapping) -> TypeScope
crashes Trap
{
    transition { _ -> domain(syntax, index, 0) }

    machine domain(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        transition offset < syntax.domain_count {
            true -> domain_facts(syntax, index, offset)
            _ -> proposition(syntax, index, 0)
        }
    }

    machine domain_facts(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        let item: DomainItem = syntax_trees_domain_item(syntax, offset);
        let holds: bool = clauses_hold(syntax, item.first_clause, item.clause_count, index);
        let scope: TypeScope = resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        transition holds {
            true -> found(scope)
            _ -> domain(syntax, index, offset + 1)
        }
    }

    machine proposition(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        transition offset < syntax.proposition_count {
            true -> proposition_fact(syntax, index, offset)
            _ -> data(syntax, index, 0)
        }
    }

    machine proposition_fact(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        let item: PropositionItem = proposition_item(syntax, offset);
        let holds: bool = tree_holds(syntax, item.body == PropositionBody::Transparent, item.fact, index);
        let scope: TypeScope = resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        transition holds {
            true -> found(scope)
            _ -> proposition(syntax, index, offset + 1)
        }
    }

    machine data(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        let empty: TypeScope = empty_scope();
        transition offset < syntax.data_count {
            true -> data_facts(syntax, index, offset)
            _ -> found(empty)
        }
    }

    machine data_facts(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        let item: DataItem = syntax_trees_data_item(syntax, offset);
        let holds: bool = clauses_hold(syntax, item.first_clause, item.clause_count, index);
        let scope: TypeScope = data_scope(item);
        transition holds {
            true -> found(scope)
            _ -> case_facts(syntax, index, offset, item, 0)
        }
    }

    machine case_facts(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) -> TypeScope {
        transition case_offset < item.case_count {
            true -> case_holds(syntax, index, offset, item, case_offset)
            _ -> data(syntax, index, offset + 1)
        }
    }

    machine case_holds(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) -> TypeScope {
        let data_case: DataCase = syntax_trees_data_case(syntax, item.first_case + case_offset);
        let holds: bool = clauses_hold(syntax, data_case.first_clause, data_case.clause_count, index);
        let scope: TypeScope = data_scope(item);
        transition holds {
            true -> found(scope)
            _ -> case_facts(syntax, index, offset, item, case_offset + 1)
        }
    }

    machine found(scope: TypeScope) -> TypeScope {
        scope
    }
}

// Whether expression `index` lies in the fact tree of one of the clauses
// `first..first + count`.
machine clauses_hold(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(syntax, first, count, index, 0) }

    machine next(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> clause(syntax, first, count, index, offset)
            _ -> no()
        }
    }

    machine clause(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let fact: Clause = syntax_trees_clause(syntax, first + offset);
        let factual: bool = fact.kind == ClauseKind::Requires || fact.kind == ClauseKind::Ensures;
        let holds: bool = tree_holds(syntax, factual, fact.expression, index);
        transition holds {
            true -> yes()
            _ -> next(syntax, first, count, index, offset + 1)
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Whether expression `index` lies in the tree rooted at `root`, whose rows
// run from the root's first row to the root; `present` says a tree exists.
machine tree_holds(syntax: &SyntaxTrees, present: bool, root: u64 in Trapping, index: u64 in Trapping) -> bool
crashes Trap
{
    transition present {
        true -> run(syntax, root, index)
        _ -> no()
    }

    machine run(syntax: &SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping) -> bool {
        let expression: Expression = syntax_trees_expression(syntax, root);
        expression.first_row <= index && index <= root
    }

    machine no() -> bool {
        false
    }
}

// A declaration owns only its executable statements; descendants have independent ranges.
machine resolver_statement_end(syntax: &SyntaxTrees, item: MachineItem) -> u64 in Trapping {
    item.first_statement + item.statement_count
}
