// The generic and lifetime names admitted by a declaration and its enclosing declarations.

// A data declaration's type scope: its own generic parameters.
machine data_scope(item: DataItem) -> TypeScope {
    resolver_scope(item.first_generic_parameter, item.generic_parameter_count)
}

// A declaration's own generic parameters as a scope with no container.
public machine resolver_scope(first: u64 in Trapping, count: u64 in Trapping) -> TypeScope {
    TypeScope {
        lexical_machine: 0,
        first_generic_parameter: first,
        generic_parameter_count: count,
        first_outer_parameter: 0,
        outer_parameter_count: 0
    }
}

// Signature-local parameters compare by position; inherited lexical binders
// retain their exact declaration identity instead of becoming call operands.
data GenericCoordinate [copy] {
    case Declaration(position: u64 in Trapping);
    case Container(position: u64 in Trapping);
    case Lexical(parameter: u64 in Trapping);
}

machine generic_coordinate(scope: TypeScope, parameter: u64 in Trapping) -> GenericCoordinate {
    transition parameter >= scope.first_generic_parameter
        && parameter - scope.first_generic_parameter < scope.generic_parameter_count {
        true -> own(parameter - scope.first_generic_parameter)
        false -> outer(scope, parameter)
    }
    machine own(position: u64 in Trapping) -> GenericCoordinate {
        GenericCoordinate::Declaration { position: position }
    }
    machine outer(scope: TypeScope, parameter: u64 in Trapping) -> GenericCoordinate {
        transition parameter >= scope.first_outer_parameter && parameter - scope.first_outer_parameter < scope.outer_parameter_count {
            true -> container(parameter - scope.first_outer_parameter)
            false -> lexical(parameter)
        }
    }
    machine container(position: u64 in Trapping) -> GenericCoordinate {
        GenericCoordinate::Container { position: position }
    }
    machine lexical(parameter: u64 in Trapping) -> GenericCoordinate {
        GenericCoordinate::Lexical { parameter: parameter }
    }
}

machine same_generic_coordinate(left: GenericCoordinate, right: GenericCoordinate) -> bool {
    transition left {
        GenericCoordinate::Declaration { position } -> declaration(position, right)
        GenericCoordinate::Container { position } -> container(position, right)
        GenericCoordinate::Lexical { parameter } -> lexical(parameter, right)
    }
    machine declaration(position: u64 in Trapping, right: GenericCoordinate) -> bool {
        transition right { GenericCoordinate::Declaration { position as other } -> equal(position, other) _ -> different() }
    }
    machine container(position: u64 in Trapping, right: GenericCoordinate) -> bool {
        transition right { GenericCoordinate::Container { position as other } -> equal(position, other) _ -> different() }
    }
    machine lexical(parameter: u64 in Trapping, right: GenericCoordinate) -> bool {
        transition right { GenericCoordinate::Lexical { parameter as other } -> equal(parameter, other) _ -> different() }
    }
    machine equal(left: u64 in Trapping, right: u64 in Trapping) -> bool { left == right }
    machine different() -> bool { false }
}

// The generic parameters of one declaration share one namespace, whatever
// their kinds. A type binder introduces a type name, so like a data
// declaration it may not use a builtin type spelling: `machine pick<u32>`
// would otherwise make `u32` in its signature mean the binder. A value,
// machine or proposition binder may, because it never competes with a type.
public machine check_generic_names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, scope, 0) }

    machine next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        transition offset < scope.generic_parameter_count {
            true -> named(resolver, sources, syntax, scope, offset)
            _ -> done()
        }
    }

    machine named(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        let parameter: GenericParameter = syntax_trees_generic_parameter(syntax, scope.first_generic_parameter + offset);
        transition parameter.kind == GenericParameterKind::Type {
            true -> type_binder(resolver, sources, syntax, scope, offset, parameter.name)
            _ -> prior(resolver, sources, syntax, scope, offset, parameter.name, 0)
        }
    }

    machine type_binder(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, name: IdentifierSpan) {
        let builtin: bool = builtin_type_spelling(sources, name.source_span);
        transition builtin {
            true -> shadow(resolver, name)
            _ -> prior(resolver, sources, syntax, scope, offset, name, 0)
        }
    }

    machine shadow(resolver: &mut Resolver, name: IdentifierSpan) {
        name_resolution_reject(&mut resolver.output, ResolveDiagnosticCode::ShadowsBuiltin, name.source_span);
    }

    machine prior(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, name: IdentifierSpan, earlier: u64 in Trapping) {
        transition earlier < offset {
            true -> compare(resolver, sources, syntax, scope, offset, name, earlier)
            _ -> next(resolver, sources, syntax, scope, offset + 1)
        }
    }

    machine compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, name: IdentifierSpan, earlier: u64 in Trapping) {
        let earlier_parameter: GenericParameter = syntax_trees_generic_parameter(syntax, scope.first_generic_parameter + earlier);
        let equal: bool = spans_equal(sources, name.source_span,
            earlier_parameter.name.source_span
        );
        transition equal {
            true -> duplicate(resolver, name)
            _ -> prior(resolver, sources, syntax, scope, offset, name, earlier + 1)
        }
    }

    machine duplicate(resolver: &mut Resolver, name: IdentifierSpan) {
        name_resolution_reject(&mut resolver.output, ResolveDiagnosticCode::DuplicateGenericParameter, name.source_span);
    }

    machine done() {}
}

// The type annotations of one declaration's value binders (`const N: u64`,
// `Count: u32`) and the trait application of an evidence binder
// (`Reader satisfies Reading<Value>`), each in the declaration's own scope.
// An evidence binder's application is a trait, not a type: binding it as a
// type would reject the trait name and would also hide that the binder
// selects code. Earlier binders of the same telescope are already in scope,
// so `Reading<Value>` sees `Value` whether it was declared before `Reader`.
public machine bind_generic_annotations(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, scope, 0) }

    machine next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        transition offset < scope.generic_parameter_count && resolver.output.accepted {
            true -> annotation(resolver, sources, syntax, scope, offset)
            _ -> done()
        }
    }

    machine annotation(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        let parameter: GenericParameter = syntax_trees_generic_parameter(syntax, scope.first_generic_parameter + offset);
        transition parameter.has_type_reference {
            true -> role(resolver, sources, syntax, scope, offset, parameter)
            _ -> next(resolver, sources, syntax, scope, offset + 1)
        }
    }

    machine role(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, parameter: GenericParameter) {
        transition parameter.kind {
            GenericParameterKind::Evidence -> bind(resolver, sources, syntax, scope, offset, parameter.type_reference, TypeRole::Trait)
            _ -> bind(resolver, sources, syntax, scope, offset, parameter.type_reference, TypeRole::Type)
        }
    }

    machine bind(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, reference: u64 in Trapping, role: TypeRole) {
        bind_type_reference(resolver, sources, syntax, scope, reference, role);
        transition { _ -> next(resolver, sources, syntax, scope, offset + 1) }
    }

    machine done() {}
}

// The generic parameter of `first..first + count` spelled `name`; a
// lifetime names no type.
machine generic_named(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan) -> Lookup
crashes Trap
{
    transition { _ -> next(sources, syntax, first, count, name, 0) }

    machine next(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, offset: u64 in Trapping) -> Lookup {
        transition offset < count {
            true -> candidate(sources, syntax, first, count, name, offset)
            _ -> absent()
        }
    }

    machine candidate(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, offset: u64 in Trapping) -> Lookup {
        let parameter: GenericParameter = syntax_trees_generic_parameter(syntax, first + offset);
        let equal: bool = spans_equal(sources, name, parameter.name.source_span);
        transition equal && parameter.kind != GenericParameterKind::Lifetime {
            true -> found(first + offset)
            _ -> next(sources, syntax, first, count, name, offset + 1)
        }
    }

    machine found(handle: u64 in Trapping) -> Lookup {
        Lookup::Found { handle: handle }
    }

    machine absent() -> Lookup {
        Lookup::Absent
    }
}

public machine empty_scope() -> TypeScope {
    resolver_scope(0, 0)
}

// Whether every lifetime tag a type row spells, its reference tag and its
// applied name's lifetime arguments, names a lifetime binder of the
// declaration or its container.
machine lifetimes_declared(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, type_reference: TypeReference) -> bool
crashes Trap
{
    let tagged: bool = lifetime_named(sources, syntax, scope, type_reference.lifetime.source_span);
    transition type_reference.has_lifetime && !tagged {
        true -> answer(false)
        _ -> argument(sources, syntax, scope, type_reference, 0)
    }

    machine argument(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, type_reference: TypeReference, offset: u64 in Trapping) -> bool {
        transition offset < type_reference.lifetime_count {
            true -> tag(sources, syntax, scope, type_reference, offset)
            _ -> answer(true)
        }
    }

    machine tag(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, type_reference: TypeReference, offset: u64 in Trapping) -> bool {
        let spelled: IdentifierSpan = type_lifetime(syntax, type_reference.first_lifetime + offset);
        let declared: bool = lifetime_named(sources, syntax, scope, spelled.source_span);
        transition declared {
            true -> argument(sources, syntax, scope, type_reference, offset + 1)
            _ -> answer(false)
        }
    }

    machine answer(declared: bool) -> bool {
        declared
    }
}

// Whether a lifetime binder spelled `name` is declared by the scope's own
// declaration or its container.
machine lifetime_named(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan) -> bool
crashes Trap
{
    let own: bool = lifetime_among(sources, syntax, scope.first_generic_parameter, scope.generic_parameter_count, name);
    let outer: bool = scoped_lifetime_named(sources, syntax, scope, name, scope_parent(syntax, scope));
    own || outer
}

// Whether a lifetime binder spelled `name` lies in the generic parameters
// `first..first + count`.
machine lifetime_among(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan) -> bool
crashes Trap
{
    transition { _ -> next(sources, syntax, first, count, name, 0) }

    machine next(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> candidate(sources, syntax, first, count, name, offset)
            _ -> answer(false)
        }
    }

    machine candidate(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, offset: u64 in Trapping) -> bool {
        let parameter: GenericParameter = syntax_trees_generic_parameter(syntax, first + offset);
        let equal: bool = spans_equal(sources, name, parameter.name.source_span);
        transition equal && parameter.kind == GenericParameterKind::Lifetime {
            true -> answer(true)
            _ -> next(sources, syntax, first, count, name, offset + 1)
        }
    }

    machine answer(declared: bool) -> bool {
        declared
    }
}

// How many lifetime binders the declaration a type name binds declares:
// data counts its lifetime parameters; any other binding declares none.
machine lifetime_arity(syntax: &SyntaxTrees, binding: TypeBinding) -> u64 in Trapping
crashes Trap
{
    transition binding {
        TypeBinding::Data { item } -> data(syntax, item)
        _ -> answer(0)
    }

    machine data(syntax: &SyntaxTrees, item: u64 in Trapping) -> u64 in Trapping {
        let declaration: DataItem = syntax_trees_data_item(syntax, item);
        transition { _ -> next(syntax, declaration.first_generic_parameter, declaration.generic_parameter_count, 0, 0) }
    }

    machine next(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping, found: u64 in Trapping) -> u64 in Trapping {
        transition offset < count {
            true -> candidate(syntax, first, count, offset, found)
            _ -> answer(found)
        }
    }

    machine candidate(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping, found: u64 in Trapping) -> u64 in Trapping {
        let parameter: GenericParameter = syntax_trees_generic_parameter(syntax, first + offset);
        transition parameter.kind == GenericParameterKind::Lifetime {
            true -> next(syntax, first, count, offset + 1, found + 1)
            _ -> next(syntax, first, count, offset + 1, found)
        }
    }

    machine answer(count: u64 in Trapping) -> u64 in Trapping {
        count
    }
}

// Walk retained lexical declarations before the root container's telescope.
public machine scoped_generic_named(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan) -> Lookup
crashes Trap
{
    transition { _ -> ancestor(sources, syntax, scope, name, scope_parent(syntax, scope)) }
    machine ancestor(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan, parent: u64 in Trapping) -> Lookup {
        transition parent > 0 {
            true -> declared(sources, syntax, scope, name, parent - 1)
            false -> outer(sources, syntax, scope, name)
        }
    }
    machine declared(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan, machine_handle: u64 in Trapping) -> Lookup {
        let item: MachineItem = machine_item(syntax, machine_handle);
        let named: Lookup = generic_named(sources, syntax, item.first_generic_parameter, item.generic_parameter_count, name);
        transition named {
            Lookup::Found { handle } -> static_parameter(sources, syntax, scope, name, item.parent, handle)
            _ -> ancestor(sources, syntax, scope, name, item.parent)
        }
    }
    machine static_parameter(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan, parent: u64 in Trapping, handle: u64 in Trapping) -> Lookup {
        let parameter: GenericParameter = syntax_trees_generic_parameter(syntax, handle);
        transition parameter.kind == GenericParameterKind::Value {
            true -> ancestor(sources, syntax, scope, name, parent)
            false -> Lookup::Found { handle: handle }
        }
    }

    machine outer(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan) -> Lookup {
        generic_named(sources, syntax, scope.first_outer_parameter, scope.outer_parameter_count, name)
    }
}

machine scoped_lifetime_named(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan, parent: u64 in Trapping) -> bool
crashes Trap
{
    transition parent > 0 {
        true -> declared(sources, syntax, scope, name, parent - 1)
        false -> lifetime_among(sources, syntax, scope.first_outer_parameter, scope.outer_parameter_count, name)
    }
    machine declared(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan, handle: u64 in Trapping) -> bool {
        let item: MachineItem = machine_item(syntax, handle);
        let present: bool = lifetime_among(sources, syntax, item.first_generic_parameter, item.generic_parameter_count, name);
        transition present {
            true -> true
            false -> scoped_lifetime_named(sources, syntax, scope, name, item.parent)
        }
    }
}

// The scope retains its exact declaration, including when it owns no binders.
// Generic lookup already searched that declaration's own span; ancestry starts
// at its parent. Non-machine scopes have no lexical declaration context.
machine scope_parent(syntax: &SyntaxTrees, scope: TypeScope) -> u64 in Trapping
crashes Trap
{
    transition scope.lexical_machine > 0 {
        true -> declared(syntax, scope.lexical_machine - 1)
        false -> 0
    }
    machine declared(syntax: &SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping {
        let item: MachineItem = machine_item(syntax, handle);
        item.parent
    }
}
