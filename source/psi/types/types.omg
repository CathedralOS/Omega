use psi::integers::integers;
use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;

// The types of one compilation and what typing records about its syntax.
// Types are interned: one row per distinct type, so two types are equal
// exactly when their handles are. A row's children (a referee, an element,
// an applied argument) are interned before it, so every child handle is
// smaller than its parent's. Row zero is the absent type.

pub data TypeKind [copy] {
    case Absent;
    // A compiler-installed type, with its `in` qualifier.
    case Builtin;
    // A data declaration (`item`), applied to the argument run.
    case Data;
    // `&T` or `&mut T`: `access` over `inner`.
    case Reference;
    // `[inner; length]`, with its `in` qualifier; `length` is the handle of
    // its extent's type, a static integer or a `const` generic parameter
    // (wiki/spec/language/generics.md#value-binders-and-const-requirements),
    // so substitution and unification treat it as one more child.
    case Array;
    // `[inner]`, with its `in` qualifier.
    case Slice;
    // A generic parameter of the enclosing declaration (`item`).
    case GenericParameter;
    // An integer static argument (`length` holds its value).
    case StaticInteger;
    // The result of a machine or state that declares none.
    case Unit;
    // An integer literal tree that has not landed at a destination yet. Its
    // exact value lives with the expression (an `ExactInteger`).
    case AnonymousInteger;
    // A decimal literal tree that has not landed at a float format yet.
    // Landing rounds once (wiki/spec/language/numeric_values.md); the value
    // is evaluation's, not typing's.
    case AnonymousFloat;
}

// Fields a kind does not carry are zero.
pub data TypeRow [copy] {
    kind: TypeKind;
    builtin: BuiltinType;
    domain: DomainBinding;
    // A `Declared` qualifier's domain declaration or a `Case` qualifier's
    // case; zero for an arithmetic policy or none.
    domain_item: u64 in Trapping;
    item: u64 in Trapping;
    access: ReferenceAccess;
    inner: u64 in Trapping;
    length: u64 in Trapping;
    first_argument: u64 in Trapping;
    argument_count: u64 in Trapping;
}

pub data TypeTable
where
    row_count <= 8192,
    argument_count <= 4096,
{
    rows: [TypeRow; 8192];
    row_count: u64;
    arguments: [u64; 4096];
    argument_count: u64;
}

// What a name, call or projection selected. A call selects one machine of
// the overload family resolution bound; a transition target its state; a
// `.field` the common field it projects, or a collection's `.len` its count.
pub data Selection [copy] {
    case None;
    case Machine(handle: u64 in Trapping);
    case State(handle: u64 in Trapping);
    case Field(field: u64 in Trapping);
    case Length;
    // A call of a machine binder through its `where machine` contract, by
    // generic parameter handle.
    case Binder(parameter: u64 in Trapping);
}

// How an expression meets its destination. `Landed` marks the root of an
// anonymous integer tree that took its destination's carrier; `SharedLend`
// an argument a shared-reference parameter lends implicitly.
pub data Adaptation [copy] {
    case None;
    case Landed;
    case SharedLend;
    // A value of a type's carrier admitted where the type is qualified by a
    // declared domain: checking proves its predicates.
    case Qualified;
}

pub data TypeDiagnosticCode [copy] {
    case None;
    case TypeCapacityExceeded;
    case UnsupportedTypeForm;
    case GenericArgumentCount;
    case UnsupportedArrayLength;
    case UnsupportedDomain;
    case MismatchedTypes;
    case LiteralOutOfRange;
    case UnsupportedLiteral;
    case AnonymousValueOutOfRange;
    case AnonymousRemainder;
    case UnknownField;
    case ProjectionOfNonData;
    case IndexOfNonCollection;
    case NonIntegerIndex;
    case OperandMismatch;
    case NotBoolean;
    case UnsupportedEquality;
    case NoMatchingMachine;
    case AmbiguousMachine;
    case NotCallable;
    case NotAValue;
    case UnknownConstructionField;
    case DuplicateConstructionField;
    case NotConstructible;
    case CaseOfOtherData;
    case UnknownPatternField;
    case InvalidCast;
    case NotAPlace;
    case TerminalResultMismatch;
    case AnonymousFraction;
    case UnsupportedExpression;
    case TargetArgumentCount;
    case UninferredGenericArgument;
    // A machine's signature is not the requirement's it `satisfies`, under
    // the clause's trait arguments.
    case SatisfierMismatch;
    // An expression statement drops a non-Unit result without `_ =`.
    case SilentDiscard;
    // `_ =` before something other than a call.
    case DiscardsNoCall;
    // A proposition applied to more or fewer arguments than its parameters.
    case PropositionArgumentCount;
}

pub data TypeDiagnostic [copy] {
    code: TypeDiagnosticCode;
    source_span: SourceSpan;
}

// The declared field a construction's written value establishes or a
// pattern field matches: one of its data's common fields, or a payload field
// of the case it writes or matches.
pub data MemberTarget [copy] {
    case Unknown;
    case Common(field: u64 in Trapping);
    case Payload(field: u64 in Trapping);
}

// Typing's annotations, indexed by syntax handles: a type per type-reference
// row, per expression and per pattern field, an expression's selection,
// adaptation and anonymous value. `unit`, `boolean` and `anonymous` are the
// handles of those types in `types`.
pub data Typing
where
    reference_count <= 32768,
    expression_count <= 131072,
    binder_count <= 2048,
    construct_count <= 2048,
{
    types: TypeTable;
    reference_types: [u64; 32768];
    reference_count: u64;
    expression_types: [u64; 131072];
    selections: [Selection; 131072];
    adaptations: [Adaptation; 131072];
    values: [ExactInteger; 131072];
    expression_count: u64;
    binder_types: [u64; 2048];
    // Each pattern field's member, indexed like `binder_types`.
    binder_members: [MemberTarget; 2048];
    binder_count: u64;
    // Each construction field's member.
    construct_targets: [MemberTarget; 2048];
    construct_count: u64;
    unit: u64 in Trapping;
    boolean: u64 in Trapping;
    anonymous: u64 in Trapping;
    anonymous_float: u64 in Trapping;
    diagnostic: TypeDiagnostic;
    accepted: bool;
}

pub machine Typing::reject(typing: &mut Typing, code: TypeDiagnosticCode, source_span: SourceSpan) {
    typing.accepted = false;
    typing.diagnostic.code = code;
    typing.diagnostic.source_span = source_span;
}

// Guarded table access. Every index typing uses is a syntax handle below its
// table's count, so an index at or past it is a violated producer invariant:
// the access crashes rather than reading another row.
pub machine Typing::reference_type(typing: &Typing, row: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition row < typing.reference_count {
        true -> read(typing, row)
        _ -> invalid()
    }

    state read(typing: &Typing, row: u64 in Trapping) -> u64 in Trapping {
        typing.reference_types[row] as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

pub machine Typing::set_reference_type(typing: &mut Typing, row: u64 in Trapping, handle: u64 in Trapping)
crashes Trap
{
    transition row < typing.reference_count {
        true -> write(typing, row, handle)
        _ -> invalid()
    }

    state write(typing: &mut Typing, row: u64 in Trapping, handle: u64 in Trapping) {
        typing.reference_types[row] = handle as u64;
    }

    state invalid() {
        crash Trap;
    }
}

