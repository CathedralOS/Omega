    }

    machine invalid() -> ExactInteger {
        crash Trap;
    }
}

// An anonymous expression's exact rational: its value over its denominator.
public machine Typing::rational(typing: &Typing, index: u64 in Trapping) -> Rational
crashes Trap
{
    let numerator: ExactInteger = Typing::value(typing, index);
    let denominator: u64 in Trapping = Typing::denominator(typing, index);
    Rational { numerator: numerator, denominator: denominator as u64 in Wrapping }
}

// A quoted literal's predicate roster (`rosters`); zero for any other
// expression.
public machine Typing::roster(typing: &Typing, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < typing.expression_count {
        true -> read(typing, index)
        _ -> invalid()
    }

    machine read(typing: &Typing, index: u64 in Trapping) -> u64 in Trapping {
        let stored: u64 = typing.rosters[index];
        stored as u64 in Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

public machine Typing::set_roster(typing: &mut Typing, index: u64 in Trapping, roster: u64 in Trapping)
crashes Trap
{
    transition index < typing.expression_count {
        true -> write(typing, index, roster)
        _ -> invalid()
    }

    machine write(typing: &mut Typing, index: u64 in Trapping, roster: u64 in Trapping) {
        typing.rosters[index] = roster as u64;
    }

    machine invalid() {
        crash Trap;
    }
}

// The denominator of an anonymous expression's value, at least one.
public machine Typing::denominator(typing: &Typing, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < typing.expression_count {
        true -> read(typing, index)
        _ -> invalid()
    }

    machine read(typing: &Typing, index: u64 in Trapping) -> u64 in Trapping {
        let stored: u64 = typing.denominators[index];
        transition stored > 1 {
            true -> fraction(stored)
            _ -> integral()
        }
    }

    machine fraction(stored: u64) -> u64 in Trapping {
        stored as u64 in Trapping
    }

    machine integral() -> u64 in Trapping {
        1
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

public machine Typing::set_rational(typing: &mut Typing, index: u64 in Trapping, value: Rational)
crashes Trap
{
    transition index < typing.expression_count {
        true -> write(typing, index, value)
        _ -> invalid()
    }

    machine write(typing: &mut Typing, index: u64 in Trapping, value: Rational) {
        typing.values[index] = value.numerator;
        typing.denominators[index] = value.denominator as u64;
    }

    machine invalid() {
        crash Trap;
    }
}

public machine Typing::set_value(typing: &mut Typing, index: u64 in Trapping, value: ExactInteger)
crashes Trap
{
    transition index < typing.expression_count {
        true -> write(typing, index, value)
        _ -> invalid()
    }

    machine write(typing: &mut Typing, index: u64 in Trapping, value: ExactInteger) {
        typing.values[index] = value;
        typing.denominators[index] = 0;
    }

    machine invalid() {
        crash Trap;
    }
}

