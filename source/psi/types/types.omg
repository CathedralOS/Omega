// An empty row of `kind`.
public machine TypeRow::of(kind: TypeKind) -> TypeRow {
    TypeRow {
        kind: kind,
        builtin: BuiltinType::Bool,
        domain: DomainBinding::Unqualified,
        domain_item: 0,
        item: 0,
        access: ReferenceAccess::Shared,
        inner: 0,
        length: 0,
        first_argument: 0,
        argument_count: 0
    }
}

public machine TypeTable::row(table: &TypeTable, handle: u64 in Trapping) -> TypeRow
crashes Trap
{
    transition handle < table.row_count {
        true -> read(table, handle)
        _ -> invalid()
    }

    machine read(table: &TypeTable, handle: u64 in Trapping) -> TypeRow {
        table.rows[handle]
    }

    machine invalid() -> TypeRow {
        crash Trap;
    }
}

public machine TypeTable::argument(table: &TypeTable, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < table.argument_count {
        true -> read(table, index)
        _ -> invalid()
    }

    machine read(table: &TypeTable, index: u64 in Trapping) -> u64 in Trapping {
        table.arguments[index] as u64 in Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// Append one argument to the tentative run at the arguments tail; false when
// the table is full.
public machine TypeTable::push_argument(table: &mut TypeTable, argument: u64 in Trapping) -> bool
crashes Trap
{
    transition table.argument_count < 4096 {
        true -> push(table, argument)
        _ -> full()
    }

    machine push(table: &mut TypeTable, argument: u64 in Trapping) -> bool {
        table.arguments[table.argument_count] = argument as u64;
        table.argument_count = table.argument_count + 1;
        true
    }

    machine full() -> bool {
        false
    }
}

// Intern `row`. An argument run must be the tentative run the caller just
// appended at the arguments tail: an equal existing row releases it. Zero
// when the table is full.
public machine TypeTable::intern(table: &mut TypeTable, row: TypeRow) -> u64 in Trapping
crashes Trap
{
    transition { _ -> scan(table, row, 1) }

    machine scan(table: &mut TypeTable, row: TypeRow, index: u64 in Trapping) -> u64 in Trapping {
        transition index < table.row_count {
            true -> compare(table, row, index)
            _ -> append(table, row)
        }
    }

    machine compare(table: &mut TypeTable, row: TypeRow, index: u64 in Trapping) -> u64 in Trapping {
        let existing: TypeRow = TypeTable::row(table, index);
        let same: bool = TypeTable::same_row(table, existing, row);
        transition same {
            true -> found(table, row, index)
            _ -> scan(table, row, index + 1)
        }
    }

    // The tentative run ends the argument table, so releasing it moves the
    // count back to where the run starts.
    machine found(table: &mut TypeTable, row: TypeRow, index: u64 in Trapping) -> u64 in Trapping {
        transition row.argument_count > 0 && row.first_argument <= table.argument_count {
            true -> release(table, row.first_argument, index)
            _ -> result(index)
        }
    }

    machine release(table: &mut TypeTable, first_argument: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping
    requires first_argument <= 4096
    {
        table.argument_count = first_argument as u64;
        transition { _ -> result(index) }
    }

    machine append(table: &mut TypeTable, row: TypeRow) -> u64 in Trapping {
        transition table.row_count < 8192 {
            true -> store(table, row)
            _ -> full()
        }
    }

    machine store(table: &mut TypeTable, row: TypeRow) -> u64 in Trapping {
        let handle: u64 in Trapping = table.row_count as u64 in Trapping;
        table.rows[handle] = row;
        table.row_count = table.row_count + 1;
        transition { _ -> result(handle) }
    }

    machine result(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }

    machine full() -> u64 in Trapping {
        0
    }
}

// Whether two rows denote one type: equal fields and equal argument runs.
machine TypeTable::same_row(table: &TypeTable, left: TypeRow, right: TypeRow) -> bool
crashes Trap
{
    transition left.kind == right.kind
        && left.builtin == right.builtin
        && left.domain == right.domain
        && left.domain_item == right.domain_item
        && left.item == right.item
        && left.access == right.access
        && left.inner == right.inner
        && left.length == right.length
        && left.argument_count == right.argument_count {
        true -> arguments(table, left, right, 0)
        _ -> different()
    }

    machine arguments(table: &TypeTable, left: TypeRow, right: TypeRow, offset: u64 in Trapping) -> bool {
        transition offset < left.argument_count {
            true -> argument(table, left, right, offset)
            _ -> same()
        }
    }

    machine argument(table: &TypeTable, left: TypeRow, right: TypeRow, offset: u64 in Trapping) -> bool {
        let left_argument: u64 in Trapping = TypeTable::argument(table, left.first_argument + offset);
        let right_argument: u64 in Trapping = TypeTable::argument(table, right.first_argument + offset);
        transition left_argument == right_argument {
            true -> arguments(table, left, right, offset + 1)
            _ -> different()
        }
    }

    machine same() -> bool {
        true
    }

    machine different() -> bool {
        false
    }
}

// `row` with its domain qualifier removed: the carrier it qualifies.
public machine TypeRow::carrier(row: TypeRow) -> TypeRow {
    let mut carrier: TypeRow = row;
    carrier.domain = DomainBinding::Unqualified;
    carrier.domain_item = 0;
    carrier
}

// Whether two rows qualify one carrier: equal once their qualifiers are
// removed, a reference's from its referent (`&[u8] in Path` qualifies the
// slice it refers to).
// The type a reference row's referent has, through every reference layer;
// any other type itself.
public machine Typing::referent_of(typing: &Typing, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let row: TypeRow = TypeTable::row(&typing.types, handle);
    transition row.kind == TypeKind::Reference {
        true -> inner(typing, row.inner, 0)
        _ -> result(handle)
    }

    machine inner(typing: &Typing, handle: u64 in Trapping, depth: u64 in Trapping) -> u64 in Trapping {
        let row: TypeRow = TypeTable::row(&typing.types, handle);
        transition row.kind == TypeKind::Reference && depth < 16 {
            true -> inner(typing, row.inner, depth + 1)
            _ -> result(handle)
        }
    }

    machine result(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

public machine TypeTable::same_carrier(table: &TypeTable, left: TypeRow, right: TypeRow) -> bool
crashes Trap
{
    transition left.kind == TypeKind::Reference && right.kind == TypeKind::Reference {
        true -> referents(table, left, right)
        _ -> rows(table, left, right)
    }

    machine referents(table: &TypeTable, left: TypeRow, right: TypeRow) -> bool {
        let left_referent: TypeRow = TypeTable::row(table, left.inner);
        let right_referent: TypeRow = TypeTable::row(table, right.inner);
        transition left.access == right.access {
            true -> rows(table, left_referent, right_referent)
            _ -> different()
        }
    }

    machine rows(table: &TypeTable, left: TypeRow, right: TypeRow) -> bool {
        let left_carrier: TypeRow = TypeRow::carrier(left);
        let right_carrier: TypeRow = TypeRow::carrier(right);
        let same: bool = TypeTable::same_row(table, left_carrier, right_carrier);
        same
    }

    machine different() -> bool {
        false
    }
}

// The row a type's domain qualifier sits on: its own, or a reference's
// referent's.
public machine TypeTable::qualified_row(table: &TypeTable, row: TypeRow) -> TypeRow
crashes Trap
{
    transition row.kind == TypeKind::Reference {
        true -> referent(table, row.inner)
        _ -> own(row)
    }

    machine referent(table: &TypeTable, inner: u64 in Trapping) -> TypeRow {
        let referent_row: TypeRow = TypeTable::row(table, inner);
        referent_row
    }

    machine own(row: TypeRow) -> TypeRow {
        row
    }
}

// The bytes a builtin scalar occupies: Booleans and 8-bit integers one,
// 16-bit integers two, 32-bit integers and `f32` four, 64-bit integers and
// `f64` eight; zero for any other type.
public machine TypeTable::carrier_width(row: TypeRow) -> u64 in Trapping {
    transition row.kind == TypeKind::Builtin {
        true -> builtin(row.builtin)
        _ -> width(0)
    }

    machine builtin(builtin: BuiltinType) -> u64 in Trapping {
        transition builtin {
            BuiltinType::Bool -> width(1)
            BuiltinType::U8 -> width(1)
            BuiltinType::I8 -> width(1)
            BuiltinType::U16 -> width(2)
            BuiltinType::I16 -> width(2)
            BuiltinType::U32 -> width(4)
            BuiltinType::I32 -> width(4)
            BuiltinType::F32 -> width(4)
            BuiltinType::U64 -> width(8)
            BuiltinType::I64 -> width(8)
            BuiltinType::F64 -> width(8)
            _ -> width(0)
        }
    }

    machine width(bytes: u64 in Trapping) -> u64 in Trapping {
        bytes
    }
}

public machine Typing::binder_subject(typing: &Typing, field: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition field < typing.binder_count {
        true -> read(typing, field)
        _ -> invalid()
    }
    machine read(typing: &Typing, field: u64 in Trapping) -> u64 in Trapping { typing.binder_subjects[field] as u64 in Trapping }
    machine invalid() -> u64 in Trapping { crash Trap; }
}
public machine Typing::set_binder_subject(typing: &mut Typing, field: u64 in Trapping, subject: u64 in Trapping)
crashes Trap
{
    transition field < typing.binder_count {
        true -> write(typing, field, subject)
        _ -> invalid()
    }
    machine write(typing: &mut Typing, field: u64 in Trapping, subject: u64 in Trapping) { typing.binder_subjects[field] = subject as u64; }
    machine invalid() { crash Trap; }
}

public machine Typing::static_operand_type(typing: &Typing, expression: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition expression < typing.expression_count && expression < 131072 { true -> read(typing, expression) _ -> invalid() }
    machine read(typing: &Typing, expression: u64 in Trapping) -> u64 in Trapping
    requires expression < 131072
    { typing.static_operand_types[expression] as u64 in Trapping }
    machine invalid() -> u64 in Trapping { crash Trap; }
}
public machine Typing::set_static_operand_type(typing: &mut Typing, expression: u64 in Trapping, type_handle: u64 in Trapping)
crashes Trap
{
    transition expression < typing.expression_count && expression < 131072 { true -> write(typing, expression, type_handle) _ -> invalid() }
    machine write(typing: &mut Typing, expression: u64 in Trapping, type_handle: u64 in Trapping)
    requires expression < 131072
    { typing.static_operand_types[expression] = type_handle as u64; }
    machine invalid() { crash Trap; }
}

public machine Typing::same_pattern(left: SourceSpan, right: SourceSpan) -> bool {
    left.source.value == right.source.value && left.span.start == right.span.start && left.span.end == right.span.end
}
public machine Typing::pattern_residual(typing: &Typing, index: u64 in Trapping) -> PatternResidual
crashes Trap
{
    transition index < typing.pattern_residual_count && index < 4096 { true -> read(typing, index) _ -> invalid() }
    machine read(typing: &Typing, index: u64 in Trapping) -> PatternResidual
    requires index < 4096
    { typing.pattern_residuals[index] }
    machine invalid() -> PatternResidual { crash Trap; }
}
public machine Typing::record_pattern_residual(typing: &mut Typing, row: PatternResidual)
crashes Trap
{
    transition row.type_handle > 0 { true -> next(typing, row, 0) _ -> full(typing, row.pattern) }
    machine next(typing: &mut Typing, row: PatternResidual, index: u64 in Trapping) {
        transition index < typing.pattern_residual_count && index < 4096 { true -> candidate(typing, row, index) _ -> append(typing, row, index) }
    }
    machine candidate(typing: &mut Typing, row: PatternResidual, index: u64 in Trapping)
    requires index < 4096
    {
        let previous: PatternResidual = typing.pattern_residuals[index];
        let same: bool = Typing::same_pattern(previous.pattern, row.pattern) && previous.component_kind == row.component_kind && previous.component == row.component;
        transition same { true -> update(typing, row, index) _ -> next(typing, row, index + 1) }
    }
    machine update(typing: &mut Typing, row: PatternResidual, index: u64 in Trapping)
    requires index < 4096
    { typing.pattern_residuals[index] = row; }
    machine append(typing: &mut Typing, row: PatternResidual, index: u64 in Trapping) {
        transition index < 4096 { true -> entered(typing, row, index) _ -> full(typing, row.pattern) }
    }
    machine entered(typing: &mut Typing, row: PatternResidual, index: u64 in Trapping)
    requires index < 4096
    {
        typing.pattern_residuals[index] = row;
        typing.pattern_residual_count = index + 1;
    }
    machine full(typing: &mut Typing, span: SourceSpan) { Typing::reject(typing, TypeDiagnosticCode::TypeCapacityExceeded, span); }
}

public machine Typing::case_view_multiplicity(typing: &Typing, handle: u64 in Trapping) -> DataMultiplicity
crashes Trap
{
    transition handle < 8192 { true -> read(typing, handle) _ -> DataMultiplicity::Linear }
    machine read(typing: &Typing, handle: u64 in Trapping) -> DataMultiplicity
    requires handle < 8192
    { typing.case_view_modes[handle] }
}
public machine Typing::set_case_view_multiplicity(typing: &mut Typing, handle: u64 in Trapping, mode: DataMultiplicity)
crashes Trap
{
    transition handle < 8192 { true -> write(typing, handle, mode) _ -> invalid() }
    machine write(typing: &mut Typing, handle: u64 in Trapping, mode: DataMultiplicity)
    requires handle < 8192
    { typing.case_view_modes[handle] = mode; }
    machine invalid() { crash Trap; }
}
public machine Typing::join_multiplicity(first: DataMultiplicity, second: DataMultiplicity) -> DataMultiplicity {
    transition first == DataMultiplicity::Linear || second == DataMultiplicity::Linear { true -> DataMultiplicity::Linear _ -> affine(first, second) }
    machine affine(first: DataMultiplicity, second: DataMultiplicity) -> DataMultiplicity {
        transition first == DataMultiplicity::Affine || second == DataMultiplicity::Affine { true -> DataMultiplicity::Affine _ -> DataMultiplicity::Unrestricted }
    }
}
