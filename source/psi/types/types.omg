// An empty row of `kind`.
pub machine TypeRow::of(kind: TypeKind) -> TypeRow {
    TypeRow {
        kind: kind,
        builtin: BuiltinType::Bool,
        domain: DomainBinding::Unqualified,
        domain_item: 0,
        item: 0,
        access: ReferenceAccess::Shared,
        inner: 0,
        length: 0,
        first_argument: 0,
        argument_count: 0
    }
}

pub machine TypeTable::row(table: &TypeTable, handle: u64 in Trapping) -> TypeRow
crashes Trap
{
    transition handle < table.row_count {
        true -> read(table, handle)
        _ -> invalid()
    }

    state read(table: &TypeTable, handle: u64 in Trapping) -> TypeRow {
        table.rows[handle]
    }

    state invalid() -> TypeRow {
        crash Trap;
    }
}

pub machine TypeTable::argument(table: &TypeTable, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < table.argument_count {
        true -> read(table, index)
        _ -> invalid()
    }

    state read(table: &TypeTable, index: u64 in Trapping) -> u64 in Trapping {
        table.arguments[index] as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// Append one argument to the tentative run at the arguments tail; false when
// the table is full.
pub machine TypeTable::push_argument(table: &mut TypeTable, argument: u64 in Trapping) -> bool
crashes Trap
{
    transition table.argument_count < 4096 {
        true -> push(table, argument)
        _ -> full()
    }

    state push(table: &mut TypeTable, argument: u64 in Trapping) -> bool {
        table.arguments[table.argument_count] = argument as u64;
        table.argument_count = table.argument_count + 1;
        true
    }

    state full() -> bool {
        false
    }
}

// Intern `row`. An argument run must be the tentative run the caller just
// appended at the arguments tail: an equal existing row releases it. Zero
// when the table is full.
pub machine TypeTable::intern(table: &mut TypeTable, row: TypeRow) -> u64 in Trapping
crashes Trap
{
    transition { _ -> scan(table, row, 1) }

    state scan(table: &mut TypeTable, row: TypeRow, index: u64 in Trapping) -> u64 in Trapping {
        transition index < table.row_count {
            true -> compare(table, row, index)
            _ -> append(table, row)
        }
    }

    state compare(table: &mut TypeTable, row: TypeRow, index: u64 in Trapping) -> u64 in Trapping {
        let existing: TypeRow = TypeTable::row(table, index);
        let same: bool = TypeTable::same_row(table, existing, row);
        transition same {
            true -> found(table, row, index)
            _ -> scan(table, row, index + 1)
        }
    }

    // The tentative run ends the argument table, so releasing it moves the
    // count back to where the run starts.
    state found(table: &mut TypeTable, row: TypeRow, index: u64 in Trapping) -> u64 in Trapping {
        transition row.argument_count > 0 && row.first_argument <= table.argument_count {
            true -> release(table, row.first_argument, index)
            _ -> result(index)
        }
    }

    state release(table: &mut TypeTable, first_argument: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping
    requires first_argument <= 4096
    {
        table.argument_count = first_argument as u64;
        transition { _ -> result(index) }
    }

    state append(table: &mut TypeTable, row: TypeRow) -> u64 in Trapping {
        transition table.row_count < 8192 {
            true -> store(table, row)
            _ -> full()
        }
    }

    state store(table: &mut TypeTable, row: TypeRow) -> u64 in Trapping {
        let handle: u64 in Trapping = table.row_count as u64 in Trapping;
        table.rows[handle] = row;
        table.row_count = table.row_count + 1;
        transition { _ -> result(handle) }
    }

    state result(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }

    state full() -> u64 in Trapping {
        0
    }
}

// Whether two rows denote one type: equal fields and equal argument runs.
machine TypeTable::same_row(table: &TypeTable, left: TypeRow, right: TypeRow) -> bool
crashes Trap
{
    transition left.kind == right.kind
        && left.builtin == right.builtin
        && left.domain == right.domain
        && left.domain_item == right.domain_item
        && left.item == right.item
        && left.access == right.access
        && left.inner == right.inner
        && left.length == right.length
        && left.argument_count == right.argument_count {
        true -> arguments(table, left, right, 0)
        _ -> different()
    }

    state arguments(table: &TypeTable, left: TypeRow, right: TypeRow, offset: u64 in Trapping) -> bool {
        transition offset < left.argument_count {
            true -> argument(table, left, right, offset)
            _ -> same()
        }
    }

    state argument(table: &TypeTable, left: TypeRow, right: TypeRow, offset: u64 in Trapping) -> bool {
        let left_argument: u64 in Trapping = TypeTable::argument(table, left.first_argument + offset);
        let right_argument: u64 in Trapping = TypeTable::argument(table, right.first_argument + offset);
        transition left_argument == right_argument {
            true -> arguments(table, left, right, offset + 1)
            _ -> different()
        }
    }

    state same() -> bool {
        true
    }

    state different() -> bool {
        false
    }
}

// `row` with its domain qualifier removed: the carrier it qualifies.
pub machine TypeRow::carrier(row: TypeRow) -> TypeRow {
    let mut carrier: TypeRow = row;
    carrier.domain = DomainBinding::Unqualified;
    carrier.domain_item = 0;
    carrier
}

// Whether two rows qualify one carrier: equal once their qualifiers are
// removed, a reference's from its referent (`&[u8] in Path` qualifies the
// slice it refers to).
pub machine TypeTable::same_carrier(table: &TypeTable, left: TypeRow, right: TypeRow) -> bool
crashes Trap
{
    transition left.kind == TypeKind::Reference && right.kind == TypeKind::Reference {
        true -> referents(table, left, right)
        _ -> rows(table, left, right)
    }

    state referents(table: &TypeTable, left: TypeRow, right: TypeRow) -> bool {
        let left_referent: TypeRow = TypeTable::row(table, left.inner);
        let right_referent: TypeRow = TypeTable::row(table, right.inner);
        transition left.access == right.access {
            true -> rows(table, left_referent, right_referent)
            _ -> different()
        }
    }

    state rows(table: &TypeTable, left: TypeRow, right: TypeRow) -> bool {
        let left_carrier: TypeRow = TypeRow::carrier(left);
        let right_carrier: TypeRow = TypeRow::carrier(right);
        let same: bool = TypeTable::same_row(table, left_carrier, right_carrier);
        same
    }

    state different() -> bool {
        false
    }
}

// The row a type's domain qualifier sits on: its own, or a reference's
// referent's.
pub machine TypeTable::qualified_row(table: &TypeTable, row: TypeRow) -> TypeRow
crashes Trap
{
    transition row.kind == TypeKind::Reference {
        true -> referent(table, row.inner)
        _ -> own(row)
    }

    state referent(table: &TypeTable, inner: u64 in Trapping) -> TypeRow {
        let referent_row: TypeRow = TypeTable::row(table, inner);
        referent_row
    }

    state own(row: TypeRow) -> TypeRow {
        row
    }
}
