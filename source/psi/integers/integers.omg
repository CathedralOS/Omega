use psi::resolution::resolution;

// Exact mathematical integers, shared by literal folding (typing) and bounds
// reasoning (checking). A value is a sign and a magnitude below 2^64, so
// every fixed-integer carrier's range is representable
// (wiki/spec/language/numeric_values.md#integer-equality-and-order).
// Arithmetic is exact: `valid` fails when a result leaves the magnitude
// range, or a quotient is inexact or divides by zero. Zero is never
// negative.
public data ExactInteger [copy] {
    negative: bool;
    magnitude: u64 in Wrapping;
}

public data ExactResult [copy] {
    valid: bool;
    value: ExactInteger;
}

public machine ExactInteger::of(magnitude: u64 in Wrapping) -> ExactInteger {
    ExactInteger { negative: false, magnitude: magnitude }
}

public machine ExactInteger::negate(value: ExactInteger) -> ExactInteger {
    ExactInteger { negative: !value.negative && value.magnitude > 0, magnitude: value.magnitude }
}

public machine ExactInteger::add(left: ExactInteger, right: ExactInteger) -> ExactResult {
    transition left.negative == right.negative {
        true -> same_sign(left, right)
        _ -> opposite(left, right)
    }

    machine same_sign(left: ExactInteger, right: ExactInteger) -> ExactResult {
        transition left.magnitude <= 18446744073709551615 - right.magnitude {
            true -> sum(left, right)
            _ -> overflow()
        }
    }

    machine sum(left: ExactInteger, right: ExactInteger) -> ExactResult {
        ExactResult {
            valid: true,
            value: ExactInteger { negative: left.negative, magnitude: left.magnitude + right.magnitude }
        }
    }

    // Opposite signs: the larger magnitude keeps its sign.
    machine opposite(left: ExactInteger, right: ExactInteger) -> ExactResult {
        transition left.magnitude >= right.magnitude {
            true -> difference(left.negative, left.magnitude - right.magnitude)
            _ -> difference(right.negative, right.magnitude - left.magnitude)
        }
    }

    machine difference(negative: bool, magnitude: u64 in Wrapping) -> ExactResult {
        ExactResult { valid: true, value: ExactInteger { negative: negative && magnitude > 0, magnitude: magnitude } }
    }

    machine overflow() -> ExactResult {
        ExactResult { valid: false, value: ExactInteger { negative: false, magnitude: 0 } }
    }
}

public machine ExactInteger::subtract(left: ExactInteger, right: ExactInteger) -> ExactResult {
    let negated: ExactInteger = ExactInteger::negate(right);
    let result: ExactResult = ExactInteger::add(left, negated);
    result
}

public machine ExactInteger::multiply(left: ExactInteger, right: ExactInteger) -> ExactResult {
    transition left.magnitude == 0 || right.magnitude == 0 {
        true -> zero()
        _ -> bounded(left, right)
    }

    machine bounded(left: ExactInteger, right: ExactInteger) -> ExactResult {
        transition left.magnitude <= 18446744073709551615 / right.magnitude {
            true -> product(left, right)
            _ -> overflow()
        }
    }

    machine product(left: ExactInteger, right: ExactInteger) -> ExactResult {
        ExactResult {
            valid: true,
            value: ExactInteger { negative: left.negative != right.negative, magnitude: left.magnitude * right.magnitude }
        }
    }

    machine zero() -> ExactResult {
        ExactResult { valid: true, value: ExactInteger { negative: false, magnitude: 0 } }
    }

    machine overflow() -> ExactResult {
        ExactResult { valid: false, value: ExactInteger { negative: false, magnitude: 0 } }
    }
}

// Rational division keeps only an exact integral quotient.
public machine ExactInteger::divide(left: ExactInteger, right: ExactInteger) -> ExactResult {
    transition right.magnitude > 0 {
        true -> divisible(left, right)
        _ -> inexact()
    }

    machine divisible(left: ExactInteger, right: ExactInteger) -> ExactResult {
        transition left.magnitude % right.magnitude == 0 {
            true -> quotient(left, right)
            _ -> inexact()
        }
    }

    machine quotient(left: ExactInteger, right: ExactInteger) -> ExactResult {
        let magnitude: u64 in Wrapping = left.magnitude / right.magnitude;
        ExactResult {
            valid: true,
            value: ExactInteger { negative: left.negative != right.negative && magnitude > 0, magnitude: magnitude }
        }
    }

    machine inexact() -> ExactResult {
        ExactResult { valid: false, value: ExactInteger { negative: false, magnitude: 0 } }
    }
}

// Whether `left <= right`.
public machine ExactInteger::at_most(left: ExactInteger, right: ExactInteger) -> bool {
    transition left.negative == right.negative {
        true -> same_sign(left, right)
        _ -> opposite(left.negative)
    }

    machine same_sign(left: ExactInteger, right: ExactInteger) -> bool {
        transition left.negative {
            true -> ordered(right.magnitude, left.magnitude)
            _ -> ordered(left.magnitude, right.magnitude)
        }
    }

    machine ordered(lower: u64 in Wrapping, upper: u64 in Wrapping) -> bool {
        lower <= upper
    }

    machine opposite(left_negative: bool) -> bool {
        left_negative
    }
}

// The least value of a fixed-integer carrier; zero for any other type.
public machine ExactInteger::minimum(builtin: BuiltinType) -> ExactInteger {
    transition builtin {
        BuiltinType::I8 -> negative(128)
        BuiltinType::I16 -> negative(32768)
        BuiltinType::I32 -> negative(2147483648)
        BuiltinType::I64 -> negative(9223372036854775808)
        _ -> unsigned()
    }

    machine negative(magnitude: u64 in Wrapping) -> ExactInteger {
        ExactInteger { negative: true, magnitude: magnitude }
    }

    machine unsigned() -> ExactInteger {
        ExactInteger { negative: false, magnitude: 0 }
    }
}

// The greatest value of a fixed-integer carrier, one for a Boolean (true
// is 1, false 0); zero for any other type.
public machine ExactInteger::maximum(builtin: BuiltinType) -> ExactInteger {
    transition builtin {
        BuiltinType::Bool -> positive(1)
        BuiltinType::I8 -> positive(127)
        BuiltinType::I16 -> positive(32767)
        BuiltinType::I32 -> positive(2147483647)
        BuiltinType::I64 -> positive(9223372036854775807)
        BuiltinType::U8 -> positive(255)
        BuiltinType::U16 -> positive(65535)
        BuiltinType::U32 -> positive(4294967295)
        BuiltinType::U64 -> positive(18446744073709551615)
        _ -> positive(0)
    }

    machine positive(magnitude: u64 in Wrapping) -> ExactInteger {
        ExactInteger { negative: false, magnitude: magnitude }
    }
}

// Whether `builtin` is a fixed-width integer carrier.
public machine ExactInteger::is_carrier(builtin: BuiltinType) -> bool {
    transition builtin {
        BuiltinType::I8 -> yes()
        BuiltinType::I16 -> yes()
        BuiltinType::I32 -> yes()
        BuiltinType::I64 -> yes()
        BuiltinType::U8 -> yes()
        BuiltinType::U16 -> yes()
        BuiltinType::U32 -> yes()
        BuiltinType::U64 -> yes()
        _ -> no()
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Whether an exact integer fits a fixed-integer carrier.
public machine ExactInteger::fits(builtin: BuiltinType, value: ExactInteger) -> bool {
    let carrier: bool = ExactInteger::is_carrier(builtin);
    let least: ExactInteger = ExactInteger::minimum(builtin);
    let greatest: ExactInteger = ExactInteger::maximum(builtin);
    let above: bool = ExactInteger::at_most(least, value);
    let below: bool = ExactInteger::at_most(value, greatest);
    carrier && above && below
}

// `value` reduced modulo its carrier's width into the carrier's range, as a
// Wrapping operation's result (wiki/spec/language/numeric_values.md#overflow-policies).
// The mask is the width's ones: the carrier's greatest magnitude plus its
// least one.
public machine ExactInteger::wrap(builtin: BuiltinType, value: ExactInteger) -> ExactInteger {
    let least: ExactInteger = ExactInteger::minimum(builtin);
    let greatest: ExactInteger = ExactInteger::maximum(builtin);
    let mask: u64 in Wrapping = greatest.magnitude + least.magnitude;
    let complement: u64 in Wrapping = 0 - value.magnitude;
    transition value.negative {
        true -> residue(least, greatest, mask, complement & mask)
        _ -> residue(least, greatest, mask, value.magnitude & mask)
    }

    // A signed residue above the greatest value stands for the residue less
    // 2^width.
    machine residue(least: ExactInteger, greatest: ExactInteger, mask: u64 in Wrapping, residue: u64 in Wrapping) -> ExactInteger {
        let wraps: bool = least.negative && residue > greatest.magnitude;
        let magnitude: u64 in Wrapping = (mask - residue) + 1;
        transition wraps {
            true -> negative(magnitude)
            _ -> positive(residue)
        }
    }

    machine negative(magnitude: u64 in Wrapping) -> ExactInteger {
        ExactInteger { negative: true, magnitude: magnitude }
    }

    machine positive(magnitude: u64 in Wrapping) -> ExactInteger {
        ExactInteger { negative: false, magnitude: magnitude }
    }
}

// `value` clamped to its carrier's range, as a Saturating operation's
// result.
public machine ExactInteger::saturate(builtin: BuiltinType, value: ExactInteger) -> ExactInteger {
    let least: ExactInteger = ExactInteger::minimum(builtin);
    let greatest: ExactInteger = ExactInteger::maximum(builtin);
    let above_least: bool = ExactInteger::at_most(least, value);
    let below_greatest: bool = ExactInteger::at_most(value, greatest);
    transition above_least {
        true -> upper(greatest, value, below_greatest)
        _ -> answer(least)
    }

    machine upper(greatest: ExactInteger, value: ExactInteger, below_greatest: bool) -> ExactInteger {
        transition below_greatest {
            true -> answer(value)
            _ -> answer(greatest)
        }
    }

    machine answer(value: ExactInteger) -> ExactInteger {
        value
    }
}

// The remainder of a division truncating toward zero: its magnitude the
// magnitudes' remainder and its sign the dividend's
// (wiki/spec/language/numeric_values.md#integer-quotient-and-remainder).
// Invalid for a zero divisor.
public machine ExactInteger::remainder(left: ExactInteger, right: ExactInteger) -> ExactResult {
    transition right.magnitude > 0 {
        true -> divided(left, right.magnitude)
        _ -> undefined(left)
    }

    machine divided(left: ExactInteger, divisor: u64 in Wrapping) -> ExactResult
    requires divisor > 0
    {
        let magnitude: u64 in Wrapping = left.magnitude % divisor;
        ExactResult { valid: true, value: ExactInteger { negative: left.negative && magnitude > 0, magnitude: magnitude } }
    }

    machine undefined(left: ExactInteger) -> ExactResult {
        ExactResult { valid: false, value: left }
    }
}

// Exact rationals of wholly anonymous arithmetic
// (wiki/spec/language/numeric_values.md): a numerator and a positive
// denominator with common factors removed, zero as `0/1`. Arithmetic is
// exact; `valid` fails when a numerator or denominator leaves the magnitude
// range, or a divisor is zero. An integral value has denominator 1.
public data Rational [copy] {
    numerator: ExactInteger;
    denominator: u64 in Wrapping;
}

public data RationalResult [copy] {
    valid: bool;
    value: Rational;
}

public machine Rational::of(value: ExactInteger) -> Rational {
    Rational { numerator: value, denominator: 1 }
}

// The greatest common divisor of two magnitudes, at least one nonzero.
public machine Rational::common_divisor(left: u64 in Wrapping, right: u64 in Wrapping) -> u64 in Wrapping {
    transition right == 0 {
        true -> found(left)
        _ -> step(right, left % right)
    }

    machine step(left: u64 in Wrapping, right: u64 in Wrapping) -> u64 in Wrapping {
        transition right == 0 {
            true -> found(left)
            _ -> step(right, left % right)
        }
    }

    machine found(divisor: u64 in Wrapping) -> u64 in Wrapping {
        divisor
    }
}

// `numerator / denominator` in lowest terms; a zero denominator is invalid.
public machine Rational::reduced(numerator: ExactInteger, denominator: u64 in Wrapping) -> RationalResult {
    transition denominator == 0 {
        true -> invalid()
        _ -> nonzero(numerator, denominator)
    }

    machine nonzero(numerator: ExactInteger, denominator: u64 in Wrapping) -> RationalResult {
        let divisor: u64 in Wrapping = Rational::common_divisor(numerator.magnitude, denominator);
        transition numerator.magnitude == 0 {
            true -> zero()
            _ -> divided(numerator, denominator, divisor)
        }
    }

    machine divided(numerator: ExactInteger, denominator: u64 in Wrapping, divisor: u64 in Wrapping) -> RationalResult {
        transition divisor > 0 {
            true -> lowest(numerator, denominator, divisor)
            _ -> invalid()
        }
    }

    machine lowest(numerator: ExactInteger, denominator: u64 in Wrapping, divisor: u64 in Wrapping) -> RationalResult {
        RationalResult {
            valid: true,
            value: Rational {
                numerator: ExactInteger { negative: numerator.negative, magnitude: numerator.magnitude / divisor },
                denominator: denominator / divisor
            }
        }
    }

    machine zero() -> RationalResult {
        RationalResult { valid: true, value: Rational { numerator: ExactInteger { negative: false, magnitude: 0 }, denominator: 1 } }
    }

    machine invalid() -> RationalResult {
        RationalResult { valid: false, value: Rational { numerator: ExactInteger { negative: false, magnitude: 0 }, denominator: 1 } }
    }
}

// (a/b) + (c/d) = (a*d + c*b) / (b*d).
public machine Rational::add(left: Rational, right: Rational) -> RationalResult {
    let left_scaled: ExactResult = ExactInteger::multiply(left.numerator, ExactInteger::of(right.denominator));
    let right_scaled: ExactResult = ExactInteger::multiply(right.numerator, ExactInteger::of(left.denominator));
    let sum: ExactResult = ExactInteger::add(left_scaled.value, right_scaled.value);
    let scale: ExactResult = ExactInteger::multiply(ExactInteger::of(left.denominator), ExactInteger::of(right.denominator));
    transition left_scaled.valid && right_scaled.valid && sum.valid && scale.valid {
        true -> reduced(sum.value, scale.value.magnitude)
        _ -> invalid()
    }

    machine reduced(numerator: ExactInteger, denominator: u64 in Wrapping) -> RationalResult {
        let result: RationalResult = Rational::reduced(numerator, denominator);
        result
    }

    machine invalid() -> RationalResult {
        RationalResult { valid: false, value: Rational { numerator: ExactInteger { negative: false, magnitude: 0 }, denominator: 1 } }
    }
}

public machine Rational::subtract(left: Rational, right: Rational) -> RationalResult {
    let negated: Rational = Rational { numerator: ExactInteger::negate(right.numerator), denominator: right.denominator };
    let result: RationalResult = Rational::add(left, negated);
    result
}

// (a/b) * (c/d) = (a*c) / (b*d).
public machine Rational::multiply(left: Rational, right: Rational) -> RationalResult {
    let product: ExactResult = ExactInteger::multiply(left.numerator, right.numerator);
    let scale: ExactResult = ExactInteger::multiply(ExactInteger::of(left.denominator), ExactInteger::of(right.denominator));
    transition product.valid && scale.valid {
        true -> reduced(product.value, scale.value.magnitude)
        _ -> invalid()
    }

    machine reduced(numerator: ExactInteger, denominator: u64 in Wrapping) -> RationalResult {
        let result: RationalResult = Rational::reduced(numerator, denominator);
        result
    }

    machine invalid() -> RationalResult {
        RationalResult { valid: false, value: Rational { numerator: ExactInteger { negative: false, magnitude: 0 }, denominator: 1 } }
    }
}

// (a/b) / (c/d) = (a*d) / (b*c), the sign on the numerator; a zero divisor
// has no value.
public machine Rational::divide(left: Rational, right: Rational) -> RationalResult {
    let numerator: ExactResult = ExactInteger::multiply(left.numerator, ExactInteger::of(right.denominator));
    let scale: ExactResult = ExactInteger::multiply(ExactInteger::of(left.denominator), ExactInteger::of(right.numerator.magnitude));
    let signed: ExactInteger = ExactInteger { negative: numerator.value.negative != right.numerator.negative && numerator.value.magnitude > 0, magnitude: numerator.value.magnitude };
    transition right.numerator.magnitude > 0 && numerator.valid && scale.valid {
        true -> reduced(signed, scale.value.magnitude)
        _ -> invalid()
    }

    machine reduced(numerator: ExactInteger, denominator: u64 in Wrapping) -> RationalResult {
        let result: RationalResult = Rational::reduced(numerator, denominator);
        result
    }

    machine invalid() -> RationalResult {
        RationalResult { valid: false, value: Rational { numerator: ExactInteger { negative: false, magnitude: 0 }, denominator: 1 } }
    }
}
