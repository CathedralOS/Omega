use psi::checking::arithmetic;
use psi::checking::checker;
use psi::checking::evaluation;
use psi::checking::obligations;
use psi::checking::places;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// The values of a fact tree's nodes, children before parents. A fact
// (`requires`, `where`) is a proof expression, not executed code: its nodes
// take the same values as a body's (places, constants, fixed-integer
// operators and conversions) but owe no obligations and have no effects,
// and a call in it is known only by its result type, except a primitive
// byte predicate, decided from its argument (`Checker::predicate_value`).
// Keeping this walk
// apart from the body's also keeps deciding a callee's facts from re-entering
// the walk of the call that owes them.
pub machine Checker::evaluate_fact_run(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    root: u64 in Trapping,
    low: u64 in Trapping
)
crashes Trap
{
    transition { _ -> node(checker, syntax, resolution, typing, root, low) }

    state node(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, handle: u64 in Trapping) {
        transition handle <= root {
            true -> evaluated(checker, syntax, resolution, typing, root, handle)
            _ -> done()
        }
    }

    state evaluated(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, handle: u64 in Trapping) {
        let value: Value = Checker::fact_value(checker, syntax, resolution, typing, handle);
        Checker::set_value(checker, handle, value);
        transition { _ -> node(checker, syntax, resolution, typing, root, handle + 1) }
    }

    state done() {}
}

machine Checker::fact_value(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping) -> Value
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, handle);
    let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
    let row: TypeRow = TypeTable::row(&typing.types, type_handle);
    let integer: bool = row.kind == TypeKind::Builtin && ExactInteger::is_carrier(row.builtin);
    transition expression.kind {
        ExpressionKind::Name -> name(checker, syntax, resolution, typing, handle, type_handle)
        ExpressionKind::Path -> path(syntax, resolution, typing, handle, type_handle, row)
        ExpressionKind::Integer -> literal(typing, handle)
        ExpressionKind::Boolean -> boolean(expression)
        ExpressionKind::Field -> field(checker, typing, handle, expression, type_handle)
        ExpressionKind::Unary -> unary(checker, expression, row, integer)
        ExpressionKind::Binary -> binary(checker, expression, row, integer)
        ExpressionKind::Cast -> cast(checker, typing, expression, row, integer)
        ExpressionKind::Call -> call(checker, syntax, resolution, typing, expression, row)
        _ -> typed(row)
    }

    state call(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression, row: TypeRow) -> Value {
        let binding: ValueBinding = NameResolution::value_binding(resolution, expression.left);
        transition binding {
            ValueBinding::BytePredicate { predicate } -> predicated(checker, syntax, resolution, typing, expression, predicate)
            _ -> typed(row)
        }
    }

    state predicated(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression, predicate: BytePredicate) -> Value {
        let argument: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first);
        let value: Value = Checker::predicate_value(checker, syntax, resolution, typing, argument, predicate);
        value
    }

    state name(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, type_handle: u64 in Trapping) -> Value {
        let value: Value = Checker::name_value(checker, syntax, resolution, typing, handle, type_handle);
        value
    }

    // A path to a constant is its value; any other path, its type's.
    state path(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, type_handle: u64 in Trapping, row: TypeRow) -> Value {
        let binding: ValueBinding = NameResolution::value_binding(resolution, handle);
        transition binding {
            ValueBinding::Constant { constant } -> constant(syntax, typing, constant, type_handle)
            _ -> typed(row)
        }
    }

    state constant(syntax: &SyntaxTrees, typing: &Typing, constant: u64 in Trapping, type_handle: u64 in Trapping) -> Value {
        let value: Value = Checker::constant_value(syntax, typing, constant, type_handle);
        value
    }

    state literal(typing: &Typing, handle: u64 in Trapping) -> Value {
        let literal: ExactInteger = Typing::value(typing, handle);
        let value: Value = Value::constant(literal);
        value
    }

    state boolean(expression: Expression) -> Value {
        let value: Value = Value::truth(expression.flag);
        value
    }

    state field(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, expression: Expression, type_handle: u64 in Trapping) -> Value {
        let value: Value = Checker::member_value(checker, typing, handle, expression, type_handle);
        value
    }

    state unary(checker: &mut Checker, expression: Expression, row: TypeRow, integer: bool) -> Value {
        transition expression.operator {
            OperatorKind::Borrow -> borrowed(checker, expression)
            OperatorKind::BorrowMutable -> borrowed(checker, expression)
            OperatorKind::BorrowWrite -> borrowed(checker, expression)
            OperatorKind::Negate -> negated(checker, expression, row, integer)
            _ -> typed(row)
        }
    }

    state borrowed(checker: &Checker, expression: Expression) -> Value {
        let operand: Value = Checker::value_at(checker, expression.left);
        let value: Value = Value::at_place(operand.place);
        value
    }

    state negated(checker: &mut Checker, expression: Expression, row: TypeRow, integer: bool) -> Value {
        transition integer {
            true -> negation(checker, expression, row)
            _ -> typed(row)
        }
    }

    state negation(checker: &mut Checker, expression: Expression, row: TypeRow) -> Value {
        let value: Value = Checker::negation_value(checker, expression, row, false);
        value
    }

    state binary(checker: &mut Checker, expression: Expression, row: TypeRow, integer: bool) -> Value {
        transition integer {
            true -> arithmetic(checker, expression, row)
            _ -> typed(row)
        }
    }

    state arithmetic(checker: &mut Checker, expression: Expression, row: TypeRow) -> Value {
        let value: Value = Checker::binary_value(checker, expression, row, false);
        value
    }

    state cast(checker: &mut Checker, typing: &Typing, expression: Expression, row: TypeRow, integer: bool) -> Value {
        transition integer {
            true -> conversion(checker, typing, expression, row)
            _ -> recast(checker, expression, row)
        }
    }

    // A recast borrows its operand's storage under another shape
    // (wiki/spec/layouts/recasts.md), so its value is that storage's place,
    // as a borrow's is. The storage keeps its facts under its own carrier;
    // a view of another carrier reads it as unknown and its writes forget
    // it (references.omg, flow.omg).
    state recast(checker: &Checker, expression: Expression, row: TypeRow) -> Value {
        transition row.kind == TypeKind::Reference {
            true -> borrowed(checker, expression)
            _ -> typed(row)
        }
    }

    state conversion(checker: &mut Checker, typing: &Typing, expression: Expression, row: TypeRow) -> Value {
        let value: Value = Checker::conversion_value(checker, typing, expression, row, false);
        value
    }

    state typed(row: TypeRow) -> Value {
        let value: Value = Value::typed(row);
        value
    }
}
