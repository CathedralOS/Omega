use psi::integers::integers;

// Difference bounds over a body's integer subjects: the one relational
// engine checking uses for live integer facts
// (wiki/spec/language/state_contracts.md#mutation-and-subject-identity).
// A zone holds, for each ordered pair of subjects, an upper bound on the
// second minus the first; subject 0 is the constant zero, so a bound from 0
// to `s` is `s`'s upper bound and from `s` to 0 is the negation of its lower
// bound. A zone stays closed: every entry is the tightest bound its facts
// imply, so a query is one read, and forgetting a subject keeps the rest
// closed. A contradictory set of facts is infeasible: no execution reaches
// that point, and every query holds there.

// An upper bound: an exact integer, or none.
public data Bound [copy] {
    finite: bool;
    value: ExactInteger;
}

public machine Bound::none() -> Bound {
    Bound { finite: false, value: ExactInteger { negative: false, magnitude: 0 } }
}

public machine Bound::exactly(value: ExactInteger) -> Bound {
    Bound { finite: true, value: value }
}

// The bound on a sum of two differences. A sum beyond the magnitude range is
// weakened, never tightened: a positive overflow bounds nothing, and a
// negative one is clamped to the least representable value.
public machine Bound::add(left: Bound, right: Bound) -> Bound {
    transition left.finite && right.finite {
        true -> finite(left.value, right.value)
        _ -> unbounded()
    }

    state finite(left: ExactInteger, right: ExactInteger) -> Bound {
        let sum: ExactResult = ExactInteger::add(left, right);
        transition sum.valid {
            true -> exact(sum.value)
            _ -> overflowed(left.negative)
        }
    }

    state exact(value: ExactInteger) -> Bound {
        Bound { finite: true, value: value }
    }

    state overflowed(negative: bool) -> Bound {
        transition negative {
            true -> least()
            _ -> unbounded()
        }
    }

    state least() -> Bound {
        Bound { finite: true, value: ExactInteger { negative: true, magnitude: 18446744073709551615 } }
    }

    state unbounded() -> Bound {
        Bound { finite: false, value: ExactInteger { negative: false, magnitude: 0 } }
    }
}

// Whether `left` is at least as tight as `right`.
public machine Bound::at_most(left: Bound, right: Bound) -> bool {
    transition right.finite {
        true -> finite(left, right.value)
        _ -> always()
    }

    state finite(left: Bound, right: ExactInteger) -> bool {
        transition left.finite {
            true -> compared(left.value, right)
            _ -> never()
        }
    }

    state compared(left: ExactInteger, right: ExactInteger) -> bool {
        let ordered: bool = ExactInteger::at_most(left, right);
        ordered
    }

    state always() -> bool {
        true
    }

    state never() -> bool {
        false
    }
}

// Whether a bound is below zero: a cycle through it is contradictory.
public machine Bound::negative(bound: Bound) -> bool {
    bound.finite && bound.value.negative
}

public data Zone [copy] {
    bounds: [Bound; 4096];
    count: u64;
    infeasible: bool;
}

// An unconstrained zone over `count` subjects, the zero subject included.
public machine Zone::open(zone: &mut Zone, count: u64 in Trapping)
crashes Trap
{
    transition count <= 64 {
        true -> cleared(zone, count)
        _ -> invalid()
    }

    state cleared(zone: &mut Zone, count: u64 in Trapping) {
        zone.count = count as u64;
        zone.infeasible = false;
        transition { _ -> entry(zone, 0) }
    }

    state entry(zone: &mut Zone, index: u64 in Trapping) {
        transition index < 4096 {
            true -> clear(zone, index)
            _ -> done()
        }
    }

    state clear(zone: &mut Zone, index: u64 in Trapping)
    requires index < 4096
    {
        let row: u64 in Trapping = index / 64;
        let column: u64 in Trapping = index % 64;
        transition row == column {
            true -> diagonal(zone, index)
            _ -> unbounded(zone, index)
        }
    }

    state diagonal(zone: &mut Zone, index: u64 in Trapping)
    requires index < 4096
    {
        zone.bounds[index] = Bound { finite: true, value: ExactInteger { negative: false, magnitude: 0 } };
        transition { _ -> entry(zone, index + 1) }
    }

    state unbounded(zone: &mut Zone, index: u64 in Trapping)
    requires index < 4096
    {
        zone.bounds[index] = Bound { finite: false, value: ExactInteger { negative: false, magnitude: 0 } };
        transition { _ -> entry(zone, index + 1) }
    }

    state done() {}

    state invalid() {
        crash Trap;
    }
}

// The bound on `to - from`.
public machine Zone::bound(zone: &Zone, from: u64 in Trapping, to: u64 in Trapping) -> Bound
crashes Trap
{
    transition from < 64 && to < 64 {
        true -> located(zone, from * 64 + to)
        _ -> invalid()
    }

    state located(zone: &Zone, index: u64 in Trapping) -> Bound {
        transition index < 4096 {
            true -> read(zone, index)
            _ -> invalid()
        }
    }

    state read(zone: &Zone, index: u64 in Trapping) -> Bound
    requires index < 4096
    {
        zone.bounds[index]
    }

    state invalid() -> Bound {
        crash Trap;
    }
}

// Tighten the bound on `to - from` to `bound` when that is tighter.
machine Zone::tighten(zone: &mut Zone, from: u64 in Trapping, to: u64 in Trapping, bound: Bound)
crashes Trap
{
    let current: Bound = Zone::bound(zone, from, to);
    let tighter: bool = Bound::at_most(current, bound);
    transition tighter {
        true -> done()
        _ -> store(zone, from * 64 + to, bound)
    }

    state store(zone: &mut Zone, index: u64 in Trapping, bound: Bound) {
        transition index < 4096 {
            true -> write(zone, index, bound)
            _ -> invalid()
        }
    }

    state write(zone: &mut Zone, index: u64 in Trapping, bound: Bound)
    requires index < 4096
    {
        zone.bounds[index] = bound;
    }

    state done() {}

    state invalid() {
        crash Trap;
    }
}

// Whether the zone implies `to - from <= value`.
public machine Zone::implies(zone: &Zone, from: u64 in Trapping, to: u64 in Trapping, value: ExactInteger) -> bool
crashes Trap
{
    transition zone.infeasible {
        true -> vacuous()
        _ -> compared(zone, from, to, value)
    }

    state compared(zone: &Zone, from: u64 in Trapping, to: u64 in Trapping, value: ExactInteger) -> bool {
        let known: Bound = Zone::bound(zone, from, to);
        let wanted: Bound = Bound::exactly(value);
        let implied: bool = Bound::at_most(known, wanted);
        implied
    }

    state vacuous() -> bool {
        true
    }
}

// Add the fact `to - from <= bound`, keeping the zone closed: each pair's
// bound tightens through the new edge, which needs one pass when the zone
// is already closed. Every row uses the new edge's own bound: the row of
// `from` stores it only when its turn comes, and no row can tighten the
// edge further, since the cycle through it is non-negative.
public machine Zone::constrain(zone: &mut Zone, from: u64 in Trapping, to: u64 in Trapping, bound: Bound)
crashes Trap
{
    let back: Bound = Zone::bound(zone, to, from);
    let cycle: Bound = Bound::add(bound, back);
    let contradictory: bool = Bound::negative(cycle);
    transition bound.finite && !zone.infeasible {
        true -> feasible(zone, from, to, bound, contradictory)
        _ -> done()
    }

    state feasible(zone: &mut Zone, from: u64 in Trapping, to: u64 in Trapping, bound: Bound, contradictory: bool) {
        transition contradictory {
            true -> infeasible(zone)
            _ -> row(zone, from, to, bound, 0)
        }
    }

    state infeasible(zone: &mut Zone) {
        zone.infeasible = true;
    }

    state row(zone: &mut Zone, from: u64 in Trapping, to: u64 in Trapping, bound: Bound, first: u64 in Trapping) {
        transition first < zone.count {
            true -> through(zone, from, to, bound, first)
            _ -> done()
        }
    }

    state through(zone: &mut Zone, from: u64 in Trapping, to: u64 in Trapping, bound: Bound, first: u64 in Trapping) {
        let into: Bound = Zone::bound(zone, first, from);
        let through: Bound = Bound::add(into, bound);
        transition { _ -> column(zone, from, to, bound, through, first, 0) }
    }

    state column(
        zone: &mut Zone,
        from: u64 in Trapping,
        to: u64 in Trapping,
        bound: Bound,
        through: Bound,
        first: u64 in Trapping,
        second: u64 in Trapping
    ) {
        transition second < zone.count {
            true -> relax(zone, from, to, bound, through, first, second)
            _ -> next_row(zone, from, to, bound, first)
        }
    }

    state relax(
        zone: &mut Zone,
        from: u64 in Trapping,
        to: u64 in Trapping,
        bound: Bound,
        through: Bound,
        first: u64 in Trapping,
        second: u64 in Trapping
    ) {
        let out: Bound = Zone::bound(zone, to, second);
        let path: Bound = Bound::add(through, out);
        Zone::tighten(zone, first, second, path);
        transition { _ -> column(zone, from, to, bound, through, first, second + 1) }
    }

    state next_row(zone: &mut Zone, from: u64 in Trapping, to: u64 in Trapping, bound: Bound, first: u64 in Trapping) {
        transition { _ -> row(zone, from, to, bound, first + 1) }
    }

    state done() {}
}

// Forget everything known about `subject`, as when it is overwritten. The
// rest of a closed zone stays closed.
public machine Zone::forget(zone: &mut Zone, subject: u64 in Trapping)
crashes Trap
{
    transition { _ -> other(zone, subject, 0) }

    state other(zone: &mut Zone, subject: u64 in Trapping, index: u64 in Trapping) {
        transition index < zone.count {
            true -> clear(zone, subject, index)
            _ -> done()
        }
    }

    state clear(zone: &mut Zone, subject: u64 in Trapping, index: u64 in Trapping) {
        transition index == subject {
            true -> other(zone, subject, index + 1)
            _ -> unbound(zone, subject, index)
        }
    }

    state unbound(zone: &mut Zone, subject: u64 in Trapping, index: u64 in Trapping) {
        let none: Bound = Bound::none();
        Zone::set(zone, subject, index, none);
        Zone::set(zone, index, subject, none);
        transition { _ -> other(zone, subject, index + 1) }
    }

    state done() {}
}

// Overwrite the bound on `to - from`.
machine Zone::set(zone: &mut Zone, from: u64 in Trapping, to: u64 in Trapping, bound: Bound)
crashes Trap
{
    transition from < 64 && to < 64 {
        true -> store(zone, from * 64 + to, bound)
        _ -> invalid()
    }

    state store(zone: &mut Zone, index: u64 in Trapping, bound: Bound) {
        transition index < 4096 {
            true -> write(zone, index, bound)
            _ -> invalid()
        }
    }

    state write(zone: &mut Zone, index: u64 in Trapping, bound: Bound)
    requires index < 4096
    {
        zone.bounds[index] = bound;
    }

    state invalid() {
        crash Trap;
    }
}

// Keep in `zone` only what both it and `other` imply: the bound of each
// pair is the looser of the two. Joining with an infeasible zone changes
// nothing; joining an infeasible zone takes the other. Whether `zone`
// changed. The pointwise loosening of two closed zones is closed.
public machine Zone::join(zone: &mut Zone, other: &Zone) -> bool
crashes Trap
{
    transition other.infeasible {
        true -> unchanged()
        _ -> reachable(zone, other)
    }

    state reachable(zone: &mut Zone, other: &Zone) -> bool {
        transition zone.infeasible {
            true -> replaced(zone, other)
            _ -> entry(zone, other, 0, false)
        }
    }

    state replaced(zone: &mut Zone, other: &Zone) -> bool {
        zone.infeasible = false;
        zone.count = other.count;
        transition { _ -> copy(zone, other, 0) }
    }

    state copy(zone: &mut Zone, other: &Zone, index: u64 in Trapping) -> bool {
        transition index < 4096 {
            true -> copy_entry(zone, other, index)
            _ -> changed()
        }
    }

    state copy_entry(zone: &mut Zone, other: &Zone, index: u64 in Trapping) -> bool
    requires index < 4096
    {
        zone.bounds[index] = other.bounds[index];
        transition { _ -> copy(zone, other, index + 1) }
    }

    state entry(zone: &mut Zone, other: &Zone, index: u64 in Trapping, loosened: bool) -> bool {
        transition index < 4096 {
            true -> compare(zone, other, index, loosened)
            _ -> finished(loosened)
        }
    }

    state compare(zone: &mut Zone, other: &Zone, index: u64 in Trapping, loosened: bool) -> bool
    requires index < 4096
    {
        let mine: Bound = zone.bounds[index];
        let theirs: Bound = other.bounds[index];
        let covered: bool = Bound::at_most(theirs, mine);
        transition covered {
            true -> entry(zone, other, index + 1, loosened)
            _ -> loosen(zone, other, index, theirs)
        }
    }

    state loosen(zone: &mut Zone, other: &Zone, index: u64 in Trapping, theirs: Bound) -> bool
    requires index < 4096
    {
        zone.bounds[index] = theirs;
        transition { _ -> entry(zone, other, index + 1, true) }
    }

    state finished(loosened: bool) -> bool {
        loosened
    }

    state unchanged() -> bool {
        false
    }

    state changed() -> bool {
        true
    }
}

// Widening for a join that keeps loosening around a cycle: every bound that
// `before` held tighter than `zone` now holds is dropped, so a loop's facts
// settle after finitely many rounds. Each remaining entry is still a valid
// bound, so the zone stays sound; it is not re-closed, which could undo the
// widening.
public machine Zone::widen(zone: &mut Zone, before: &Zone)
crashes Trap
{
    transition before.infeasible || zone.infeasible {
        true -> done()
        _ -> entry(zone, before, 0)
    }

    state entry(zone: &mut Zone, before: &Zone, index: u64 in Trapping) {
        transition index < 4096 {
            true -> compare(zone, before, index)
            _ -> done()
        }
    }

    state compare(zone: &mut Zone, before: &Zone, index: u64 in Trapping)
    requires index < 4096
    {
        let now: Bound = zone.bounds[index];
        let then: Bound = before.bounds[index];
        let stable: bool = Bound::at_most(now, then);
        transition stable {
            true -> entry(zone, before, index + 1)
            _ -> drop(zone, before, index)
        }
    }

    state drop(zone: &mut Zone, before: &Zone, index: u64 in Trapping)
    requires index < 4096
    {
        zone.bounds[index] = Bound { finite: false, value: ExactInteger { negative: false, magnitude: 0 } };
        transition { _ -> entry(zone, before, index + 1) }
    }

    state done() {}
}
