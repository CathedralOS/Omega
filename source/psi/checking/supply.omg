// Supply is checked after all bodies, crash routes and termination settle.
// Signatures, public fact implication, operational ceilings and crash subsets
// are independent conjuncts (machines.md#substitution). Fact implication uses
// arbitrary formal values, never a particular static caller or supplier body.
public machine check_supply(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing)
crashes Trap
{
    transition { _ -> next_machine(checker, syntax, resolution, typing, 0) }

    machine next_machine(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        transition index < syntax.machine_count && checker.output.diagnostic_count < 64 {
            true -> machine(checker, syntax, resolution, typing, index)
            _ -> done()
        }
    }

    machine machine(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        open_machine(&mut checker.output);
        let item: MachineItem = machine_item(syntax, index);
        transition { _ -> next_clause(checker, syntax, resolution, typing, index, item, 0) }
    }

    machine next_clause(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        transition offset < item.clause_count && checker.output.machine_accepted {
            true -> clause(checker, syntax, resolution, typing, index, item, offset)
            _ -> supplied(checker, syntax, resolution, typing, index)
        }
    }

    machine supplied(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        check_supplied_calls(checker, syntax, resolution, typing, index);
        check_progress(checker, syntax, resolution, index);
        transition { _ -> next_machine(checker, syntax, resolution, typing, index + 1) }
    }

    machine clause(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        let handle: u64 in Trapping = item.first_clause + offset;
        let clause: Clause = syntax_trees_clause(syntax, handle);
        transition clause.kind {
            ClauseKind::Satisfies -> satisfies(checker, syntax, resolution, typing, index, item, offset, handle, clause)
            ClauseKind::Terminates -> terminates(checker, syntax, resolution, typing, index, item, offset, clause)
            _ -> next_clause(checker, syntax, resolution, typing, index, item, offset + 1)
        }
    }

    machine satisfies(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution, typing: &Typing,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        clause: Clause
    ) {
        let requirement: ValueBinding = name_resolution_requirement(resolution, handle);
        check_refinement(checker, syntax, resolution, typing, index, item, clause, requirement);
        transition { _ -> next_clause(checker, syntax, resolution, typing, index, item, offset + 1) }
    }

    machine terminates(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution, typing: &Typing,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        clause: Clause
    ) {
        transition !item.has_body && clause.argument_count > 0 {
            true -> unranked(checker, syntax, resolution, typing, index, clause.source_span)
            _ -> next_clause(checker, syntax, resolution, typing, index, item, offset + 1)
        }
    }

    machine unranked(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, source_span: SourceSpan) {
        checks_reject(&mut checker.output, CheckDiagnosticCode::UnsupportedCheck, source_span);
        transition { _ -> next_machine(checker, syntax, resolution, typing, index + 1) }
    }

    machine done() {}
}

// A body promising termination must have settled as terminating
// (termination.omg); one whose own graph is unranked was rejected as its
// cycle was walked.
machine check_progress(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, machine: u64 in Trapping)
crashes Trap
{
    let item: MachineItem = machine_item(syntax, machine);
    let termination: TerminationClause = checker_termination_clause(syntax, resolution, item);
    let terminating: bool = settled_termination(checker, machine);
    transition item.has_body && termination.promised && !terminating && checker.output.machine_accepted {
        true -> unproven(checker, syntax, termination.promise)
        _ -> done()
    }

    machine unproven(checker: &mut Checker, syntax: &SyntaxTrees, promise: u64 in Trapping) {
        let clause: Clause = syntax_trees_clause(syntax, promise);
        checks_reject(&mut checker.output, CheckDiagnosticCode::ProgressUnproven, clause.source_span);
    }

    machine done() {}
}

// Refine the static machine arguments of each call machine `caller` makes.
machine check_supplied_calls(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, caller: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, caller, 0) }

    machine next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, caller: u64 in Trapping, index: u64 in Trapping) {
        transition index < checker.supplied_count && index < 1024 && checker.output.machine_accepted {
            true -> entry(checker, syntax, resolution, typing, caller, index)
            _ -> done()
        }
    }

    machine entry(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, caller: u64 in Trapping, index: u64 in Trapping)
    requires index < 1024
    {
        let supplied: SuppliedCall = checker.supplied[index];
        transition supplied.caller == caller as u64 {
            true -> call(checker, syntax, resolution, typing, caller, index, supplied)
            _ -> next(checker, syntax, resolution, typing, caller, index + 1)
        }
    }

    machine call(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, caller: u64 in Trapping, index: u64 in Trapping, supplied: SuppliedCall) {
        let call: u64 in Trapping = supplied.call as u64 in Trapping;
        let callee: u64 in Trapping = supplied.callee as u64 in Trapping;
        refine_static_arguments(checker, syntax, resolution, typing, call, callee);
        transition { _ -> next(checker, syntax, resolution, typing, caller, index + 1) }
    }

    machine done() {}
}

// Each of machine `callee`'s machine binders takes, in order, the next of
// the call's static arguments that names a machine, as typing bound them.
machine refine_static_arguments(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, call: u64 in Trapping, callee: u64 in Trapping)
crashes Trap
{
    let expression: Expression = syntax_trees_expression(syntax, call);
    let applied: Expression = syntax_trees_expression(syntax, expression.left);
    let item: MachineItem = machine_item(syntax, callee);
    transition applied.kind == ExpressionKind::Apply {
        true -> binder(checker, syntax, resolution, typing, applied, item, callee, 0, 0)
        _ -> done()
    }

    machine binder(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, applied: Expression, item: MachineItem, owner: u64 in Trapping, offset: u64 in Trapping, position: u64 in Trapping) {
        transition offset < item.generic_parameter_count {
            true -> kind(checker, syntax, resolution, typing, applied, item, owner, offset, position)
            _ -> done()
        }
    }

    machine kind(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, applied: Expression, item: MachineItem, owner: u64 in Trapping, offset: u64 in Trapping, position: u64 in Trapping) {
        let generic: GenericParameter = syntax_trees_generic_parameter(syntax, item.first_generic_parameter + offset);
        transition generic.kind == GenericParameterKind::Machine {
            true -> seek(checker, syntax, resolution, typing, applied, item, owner, offset, position)
            _ -> binder(checker, syntax, resolution, typing, applied, item, owner, offset + 1, position)
        }
    }

    machine seek(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, applied: Expression, item: MachineItem, owner: u64 in Trapping, offset: u64 in Trapping, position: u64 in Trapping) {
        transition position < applied.count {
            true -> candidate(checker, syntax, resolution, typing, applied, item, owner, offset, position)
            _ -> done()
        }
    }

    machine candidate(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, applied: Expression, item: MachineItem, owner: u64 in Trapping, offset: u64 in Trapping, position: u64 in Trapping) {
        let row: u64 in Trapping = type_argument(syntax, applied.first + position);
        let argument: MachineArgument = name_resolution_machine_argument(syntax, resolution, row);
        transition argument {
            MachineArgument::Absent -> seek(checker, syntax, resolution, typing, applied, item, owner, offset, position + 1)
            _ -> refine(checker, syntax, resolution, typing, applied, item, owner, offset, position, argument, row)
        }
    }

    machine refine(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution, typing: &Typing,
        applied: Expression,
        item: MachineItem, owner: u64 in Trapping,
        offset: u64 in Trapping,
        position: u64 in Trapping,
        argument: MachineArgument,
        row: u64 in Trapping
    ) {
        let contract: BinderContract = binder_contract(resolution, item.first_generic_parameter + offset);
        let reference: TypeReference = syntax_trees_type_reference(syntax, row);
        refine_machine_argument(checker, syntax, resolution, typing, owner, contract, argument, reference.source_span);
        transition { _ -> binder(checker, syntax, resolution, typing, applied, item, owner, offset + 1, position + 1) }
    }

    machine done() {}
}

// Static suppliers refine the same full public clause roster as declared
// requirements. Typing already authenticated the complete signature. Facts
// are compared in arbitrary worlds, independently of a particular call.
machine refine_machine_argument(
    checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution,
    typing: &Typing, owner: u64 in Trapping, contract: BinderContract,
    argument: MachineArgument, source_span: SourceSpan
)
crashes Trap
{
    transition contract.present {
        true -> contracted(checker, syntax, resolution, typing, owner, contract.contract, argument, source_span)
        _ -> {}
    }
    machine contracted(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, owner: u64 in Trapping, handle: u64 in Trapping, argument: MachineArgument, source_span: SourceSpan) {
        let written: Contract = syntax_trees_contract(syntax, handle);
        let required: CallClauses = CallClauses { first_clause: written.first_clause, clause_count: written.clause_count, first_parameter: written.first_parameter, parameter_count: written.parameter_count, has_return_type: written.has_return_type, return_type: written.return_type };
        transition argument {
            MachineArgument::Declared { machine } -> selected(checker, syntax, resolution, typing, owner, required, Selection::Machine { handle: machine }, source_span)
            MachineArgument::Forwarded { parameter } -> selected(checker, syntax, resolution, typing, owner, required, Selection::Binder { parameter: parameter }, source_span)
            _ -> unrefined(checker, source_span)
        }
    }
    machine selected(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, owner: u64 in Trapping, required: CallClauses, target: Selection, source_span: SourceSpan) {
        let given: CallClauses = call_clauses(syntax, resolution, target);
        let routes: CrashRoutes = selected_routes(checker, syntax, given, target);
        let allowed: CrashRoutes = declared_causes(syntax, required.first_clause, required.clause_count);
        let trap: bool = checker_published(routes.inferred, routes.trap, routes.declares_trap);
        let abort: bool = checker_published(routes.inferred, routes.abort, routes.declares_abort);
        transition (trap && !allowed.declares_trap) || (abort && !allowed.declares_abort) {
            true -> undeclared(checker, source_span)
            _ -> facts(checker, syntax, resolution, typing, owner, required, given, target, source_span)
        }
    }
    machine facts(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, owner: u64 in Trapping, required: CallClauses, given: CallClauses, target: Selection, source_span: SourceSpan) {
        let operational: bool = callable_markers_refine(checker, syntax, resolution, required, given, target);
        let held: bool = operational && callable_facts_refine(checker, syntax, resolution, typing, owner, required, given, target);
        transition held { true -> {} _ -> unrefined(checker, source_span) }
    }
    machine unrefined(checker: &mut Checker, source_span: SourceSpan) {
        checks_reject(&mut checker.output, CheckDiagnosticCode::RefinementUnproven, source_span);
    }
    machine undeclared(checker: &mut Checker, source_span: SourceSpan) {
        checks_reject(&mut checker.output, CheckDiagnosticCode::CrashNotDeclared, source_span);
    }
}

machine selected_routes(checker: &Checker, syntax: &SyntaxTrees, clauses: CallClauses, target: Selection) -> CrashRoutes
crashes Trap
{
    transition target {
        Selection::Machine { handle } -> checks_routes(&checker.output, handle)
        _ -> declared_causes(syntax, clauses.first_clause, clauses.clause_count)
    }
}

// A named satisfier refines the same public contract as a static supplier.
machine check_refinement(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    machine: u64 in Trapping,
    satisfier: MachineItem,
    clause: Clause,
    binding: ValueBinding
)
crashes Trap
{
    transition binding {
        ValueBinding::Machine { handle } -> required(checker, syntax, resolution, typing, machine, satisfier, clause, handle)
        _ -> invalid()
    }

    machine required(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        machine: u64 in Trapping,
        satisfier: MachineItem,
        clause: Clause,
        handle: u64 in Trapping
    ) {
        let required: CallClauses = call_clauses(syntax, resolution, Selection::Machine { handle: handle });
        let given: CallClauses = call_clauses(syntax, resolution, Selection::Machine { handle: machine });
        let operational: bool = callable_markers_refine(checker, syntax, resolution, required, given, Selection::Machine { handle: machine });
        let held: bool = operational && callable_facts_refine(checker, syntax, resolution, typing, handle, required, given, Selection::Machine { handle: machine });
        transition held {
            true -> routes(checker, machine, clause, handle)
            _ -> unrefined(checker, clause.source_span)
        }
    }

    machine unrefined(checker: &mut Checker, source_span: SourceSpan) {
        checks_reject(&mut checker.output, CheckDiagnosticCode::RefinementUnproven, source_span);
    }

    machine routes(checker: &mut Checker, machine: u64 in Trapping, clause: Clause, handle: u64 in Trapping) {
        let own: CrashRoutes = checks_routes(&checker.output, machine);
        let owed: CrashRoutes = checks_routes(&checker.output, handle);
        let trap: bool = checker_published(own.inferred, own.trap, own.declares_trap);
        let abort: bool = checker_published(own.inferred, own.abort, own.declares_abort);
        let allowed_trap: bool = checker_published(owed.inferred, owed.trap, owed.declares_trap);
        let allowed_abort: bool = checker_published(owed.inferred, owed.abort, owed.declares_abort);
        transition (trap && !allowed_trap) || (abort && !allowed_abort) {
            true -> undeclared(checker, clause.source_span)
            _ -> done()
        }
    }

    machine undeclared(checker: &mut Checker, source_span: SourceSpan) {
        checks_reject(&mut checker.output, CheckDiagnosticCode::CrashNotDeclared, source_span);
    }

    machine invalid() {
        crash Trap;
    }

    machine done() {}
}
