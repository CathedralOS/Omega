use psi::checking::cases;
use psi::checking::constructions;
use psi::checking::arrivals;
use psi::checking::checker;
use psi::checking::contracts;
use psi::checking::evaluation;
use psi::checking::flow;
use psi::checking::obligations;
use psi::checking::places;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// Default domains (wiki/spec/language/dependent_values.md#default-domains-and-zero-initialization).
// An established value of data whose declaration carries `requires` facts
// satisfies them: a parameter's from entry, a pattern binder's, and an
// initialized local's. Uninitialized storage (`let mut t: T;`) is no
// established value and gains nothing. Facts are installed field by field:
// when a field of such a value becomes a place, the facts naming that field
// are assumed with the value's fields for their field names (and those
// fields become places too). A call holding an exclusive loan of the value
// restores its domain on return, so the facts of a forgotten field are
// installed again. Installing runs between expression nodes, never inside
// the creation of a place, so it never re-enters itself.
public data DomainMark [copy] {
    case Unseen;
    case Pending;
    case Installed;
}

public machine Checker::domain_mark(checker: &Checker, index: u64 in Trapping) -> DomainMark
crashes Trap
{
    transition index < 256 {
        true -> read(checker, index)
        _ -> invalid()
    }

    machine read(checker: &Checker, index: u64 in Trapping) -> DomainMark
    requires index < 256
    {
        checker.domains[index]
    }

    machine invalid() -> DomainMark {
        crash Trap;
    }
}

public machine Checker::set_domain_mark(checker: &mut Checker, index: u64 in Trapping, mark: DomainMark)
crashes Trap
{
    transition index < 256 {
        true -> write(checker, index, mark)
        _ -> invalid()
    }

    machine write(checker: &mut Checker, index: u64 in Trapping, mark: DomainMark)
    requires index < 256
    {
        checker.domains[index] = mark;
    }

    machine invalid() {
        crash Trap;
    }
}

// A new field place (zero-based) owes the facts naming its field.
public machine Checker::note_field(checker: &mut Checker, index: u64 in Trapping)
crashes Trap
{
    Checker::set_domain_mark(checker, index, DomainMark::Pending);
    checker.domains_pending = true;
}

// Install every owed field's facts.
public machine Checker::install_domains(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing)
crashes Trap
{
    transition checker.domains_pending {
        true -> sweep(checker, syntax, resolution, typing)
        _ -> done()
    }

    machine sweep(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing) {
        checker.domains_pending = false;
        transition { _ -> next(checker, syntax, resolution, typing, 0) }
    }

    machine next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        transition index < checker.place_count {
            true -> visit(checker, syntax, resolution, typing, index)
            _ -> done()
        }
    }

    machine visit(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        let mark: DomainMark = Checker::domain_mark(checker, index);
        transition mark == DomainMark::Pending {
            true -> install(checker, syntax, resolution, typing, index)
            _ -> next(checker, syntax, resolution, typing, index + 1)
        }
    }

    machine install(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        Checker::set_domain_mark(checker, index, DomainMark::Installed);
        let field: Place = Checker::place_at(checker, index);
        let established: bool = Checker::established(checker, syntax, field.parent);
        let owner: Place = Checker::place_or_absent(checker, field.parent);
        let row: TypeRow = Checker::referent_row(typing, owner.type_handle);
        transition established && row.kind == TypeKind::Data {
            true -> facts(checker, syntax, resolution, typing, index, field, row.item)
            _ -> next(checker, syntax, resolution, typing, index + 1)
        }
    }

    machine facts(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, field: Place, item_handle: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, item_handle);
        let parent: u64 in Trapping = checker.fields_parent;
        checker.fields_parent = field.parent;
        let subject: Value = Checker::place_value(checker, field.parent);
        let required: bool = Checker::data_predicates(checker, syntax, resolution, typing, subject, item, false);
        let assumed: bool = Checker::decide_requires_facts(checker, syntax, resolution, typing, item.first_clause, item.clause_count, field.handle, false);
        checker.fields_parent = parent;
        transition { _ -> saved(checker, syntax, resolution, typing, index, field, item, 0) }
    }

    // The facts hold of the established value on every path: a zone saved
    // before the field was entered (an open `&&`/`||` context or a
    // transition's) takes them too, or a later join or restore would lose
    // them. The places the facts name exist by now, so assuming them there
    // enters none.
    machine saved(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, field: Place, item: DataItem, slot: u64 in Trapping) {
        transition slot < checker.saved_count && slot < 8 {
            true -> into_saved(checker, syntax, resolution, typing, index, field, item, slot)
            _ -> next(checker, syntax, resolution, typing, index + 1)
        }
    }

    machine into_saved(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, field: Place, item: DataItem, slot: u64 in Trapping)
    requires slot < 8
    {
        checker.stashed = checker.zone;
        checker.zone = checker.saved[slot];
        let parent: u64 in Trapping = checker.fields_parent;
        checker.fields_parent = field.parent;
        let subject: Value = Checker::place_value(checker, field.parent);
        let required: bool = Checker::data_predicates(checker, syntax, resolution, typing, subject, item, false);
        let assumed: bool = Checker::decide_requires_facts(checker, syntax, resolution, typing, item.first_clause, item.clause_count, field.handle, false);
        checker.fields_parent = parent;
        checker.saved[slot] = checker.zone;
        checker.zone = checker.stashed;
        transition { _ -> saved(checker, syntax, resolution, typing, index, field, item, slot + 1) }
    }

    machine done() {}
}

// Whether the place (one-based) belongs to an established value: its root
// is a parameter, a pattern binder, a call's result, a construction, an
// operand's snapshot or a local with an initializer.
public machine Checker::established(checker: &Checker, syntax: &SyntaxTrees, place: u64 in Trapping) -> bool
crashes Trap
{
    transition place > 0 {
        true -> climb(checker, syntax, place, 0)
        _ -> no()
    }

    machine climb(checker: &Checker, syntax: &SyntaxTrees, current: u64 in Trapping, depth: u64 in Trapping) -> bool {
        let entry: Place = Checker::place_at(checker, current - 1);
        transition (entry.kind == PlaceKind::Field || entry.kind == PlaceKind::Payload || entry.kind == PlaceKind::Length) && entry.parent > 0 && depth < 256 {
            true -> climb(checker, syntax, entry.parent, depth + 1)
            _ -> root(syntax, entry)
        }
    }

    machine root(syntax: &SyntaxTrees, entry: Place) -> bool {
        transition entry.kind {
            PlaceKind::Parameter -> yes()
            PlaceKind::Binder -> yes()
            PlaceKind::Call -> yes()
            PlaceKind::Construction -> yes()
            PlaceKind::Snapshot -> yes()
            PlaceKind::Local -> local(syntax, entry.handle)
            _ -> no()
        }
    }

    machine local(syntax: &SyntaxTrees, statement: u64 in Trapping) -> bool {
        let declaration: Statement = SyntaxTrees::statement(syntax, statement);
        declaration.has_value
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Assume (or, when `proving`, report whether the facts prove) each typed
// `requires` fact of a clause run that names `field`. An untyped fact naming
// it is not proved.
machine Checker::decide_requires_facts(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    first_clause: u64 in Trapping,
    clause_count: u64 in Trapping,
    field: u64 in Trapping,
    proving: bool
) -> bool
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, first_clause, first_clause + clause_count, field, proving) }

    machine next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, field: u64 in Trapping, proving: bool) -> bool {
        transition index < end {
            true -> clause(checker, syntax, resolution, typing, index, end, field, proving)
            _ -> held()
        }
    }

    machine clause(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, field: u64 in Trapping, proving: bool) -> bool {
        let clause: Clause = SyntaxTrees::clause(syntax, index);
        let named: bool = clause.kind == ClauseKind::Requires && clause.has_expression;
        transition named {
            true -> fact(checker, syntax, resolution, typing, index, end, field, proving, clause)
            _ -> next(checker, syntax, resolution, typing, index + 1, end, field, proving)
        }
    }

    machine fact(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, field: u64 in Trapping, proving: bool, clause: Clause) -> bool {
        let mentions: bool = Checker::mentions_field(syntax, resolution, clause.expression, field);
        let typed: bool = Checker::typed_fact(typing, clause);
        transition mentions {
            true -> owed(checker, syntax, resolution, typing, index, end, field, proving, clause.expression, typed)
            _ -> next(checker, syntax, resolution, typing, index + 1, end, field, proving)
        }
    }

    machine owed(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        index: u64 in Trapping,
        end: u64 in Trapping,
        field: u64 in Trapping,
        proving: bool,
        root: u64 in Trapping,
        typed: bool
    ) -> bool {
        transition typed {
            true -> decided(checker, syntax, resolution, typing, index, end, field, proving, root)
            _ -> untyped(checker, syntax, resolution, typing, index, end, field, proving)
        }
    }

    machine untyped(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, field: u64 in Trapping, proving: bool) -> bool {
        transition proving {
            true -> failed()
            _ -> next(checker, syntax, resolution, typing, index + 1, end, field, proving)
        }
    }

    machine decided(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, field: u64 in Trapping, proving: bool, root: u64 in Trapping) -> bool {
        let holds: bool = Checker::decide_fact(checker, syntax, resolution, typing, root, proving);
        transition holds {
            true -> next(checker, syntax, resolution, typing, index + 1, end, field, proving)
            _ -> failed()
        }
    }

    machine held() -> bool {
        true
    }

    machine failed() -> bool {
        false
    }
}

// Whether a fact's tree names `field` (a data fact's bare field name).
public machine Checker::mentions_field(syntax: &SyntaxTrees, resolution: &NameResolution, root: u64 in Trapping, wanted: u64 in Trapping) -> bool
crashes Trap
{
    let tree: Expression = SyntaxTrees::expression(syntax, root);
    transition { _ -> next(syntax, resolution, root, wanted, tree.first_row) }

    machine next(syntax: &SyntaxTrees, resolution: &NameResolution, root: u64 in Trapping, wanted: u64 in Trapping, handle: u64 in Trapping) -> bool {
        transition handle <= root {
            true -> node(syntax, resolution, root, wanted, handle)
            _ -> absent()
        }
    }

    machine node(syntax: &SyntaxTrees, resolution: &NameResolution, root: u64 in Trapping, wanted: u64 in Trapping, handle: u64 in Trapping) -> bool {
        let binding: ValueBinding = NameResolution::value_binding(resolution, handle);
        transition binding {
            ValueBinding::Field { field } -> named(syntax, resolution, root, wanted, handle, field)
            _ -> next(syntax, resolution, root, wanted, handle + 1)
        }
    }

    machine named(syntax: &SyntaxTrees, resolution: &NameResolution, root: u64 in Trapping, wanted: u64 in Trapping, handle: u64 in Trapping, found: u64 in Trapping) -> bool {
        transition found == wanted {
            true -> present()
            _ -> next(syntax, resolution, root, wanted, handle + 1)
        }
    }

    machine present() -> bool {
        true
    }

    machine absent() -> bool {
        false
    }
}

// After a value is forgotten, the facts installed for its fields and for
// fields inside it are owed again.
public machine Checker::reopen_domains(checker: &mut Checker, place: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(checker, place, 0) }

    machine next(checker: &mut Checker, place: u64 in Trapping, index: u64 in Trapping) {
        transition index < checker.place_count {
            true -> visit(checker, place, index)
            _ -> done()
        }
    }

    machine visit(checker: &mut Checker, place: u64 in Trapping, index: u64 in Trapping) {
        let within: bool = Checker::within(checker, index + 1, place);
        let mark: DomainMark = Checker::domain_mark(checker, index);
        transition within && mark == DomainMark::Installed {
            true -> reopened(checker, place, index)
            _ -> next(checker, place, index + 1)
        }
    }

    machine reopened(checker: &mut Checker, place: u64 in Trapping, index: u64 in Trapping) {
        Checker::set_domain_mark(checker, index, DomainMark::Pending);
        checker.domains_pending = true;
        transition { _ -> next(checker, place, index + 1) }
    }

    machine done() {}
}

// Whether storing the field place `written` (one-based) left its value's
// domain intact: every fact naming the field holds as the value's fields
// now are, including conditional predicates selected by the exact live tag.
public machine Checker::domain_holds(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, written: u64 in Trapping) -> bool
crashes Trap
{
    let field: Place = Checker::place_or_absent(checker, written);
    let owner: Place = Checker::place_or_absent(checker, field.parent);
    let row: TypeRow = Checker::referent_row(typing, owner.type_handle);
    transition row.kind == TypeKind::Data && field.parent > 0 {
        true -> data(checker, syntax, resolution, typing, field, row.item)
        _ -> held()
    }

    machine data(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, field: Place, item_handle: u64 in Trapping) -> bool {
        let item: DataItem = SyntaxTrees::data_item(syntax, item_handle);
        let parent: u64 in Trapping = checker.fields_parent;
        checker.fields_parent = field.parent;
        let subject: Value = Checker::place_value(checker, field.parent);
        let required: bool = Checker::data_predicates_after_write(checker, syntax, resolution, typing, subject, item, field);
        let held: bool = Checker::decide_requires_facts(checker, syntax, resolution, typing, item.first_clause, item.clause_count, field.handle, true);
        checker.fields_parent = parent;
        required && held
    }

    machine held() -> bool {
        true
    }
}

// Whether a value of data `item_handle`, of case `data_case` when
// `has_case`, with the construction fields from `first` (`count` of them)
// written, establishes its default-domain requires predicates: every fact holds with the
// exact provisional subject and the field values written there,
// zero for a field left out (wiki/spec/language/dependent_values.md:
// construction proves the domain; data_and_literals.md#case-constraints:
// construction proves the selected case's conditions). Common and payload
// fields together beyond 64 are not proved.
public machine Checker::construction_holds(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    item_handle: u64 in Trapping,
    has_case: bool,
    data_case: u64 in Trapping,
    first: u64 in Trapping,
    count: u64 in Trapping
) -> bool
crashes Trap
{
    let item: DataItem = SyntaxTrees::data_item(syntax, item_handle);
    let selected: DataCase = Checker::selected_case(syntax, has_case, data_case);
    let total: u64 in Trapping = item.field_count + selected.payload_field_count;
    transition total <= 64 {
        true -> zero(checker, syntax, resolution, typing, item, selected, has_case, first, count, total, 0)
        _ -> unproved()
    }

    machine zero(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        item: DataItem,
        selected: DataCase,
        has_case: bool,
        first: u64 in Trapping,
        count: u64 in Trapping,
        total: u64 in Trapping,
        slot: u64 in Trapping
    ) -> bool {
        transition slot < total {
            true -> zeroed(checker, syntax, resolution, typing, item, selected, has_case, first, count, total, slot)
            _ -> written(checker, syntax, resolution, typing, item, selected, has_case, first, count, total, 0)
        }
    }

    machine zeroed(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        item: DataItem,
        selected: DataCase,
        has_case: bool,
        first: u64 in Trapping,
        count: u64 in Trapping,
        total: u64 in Trapping,
        slot: u64 in Trapping
    ) -> bool {
        let zero: Value = Value::constant(ExactInteger { negative: false, magnitude: 0 });
        Checker::set_argument(checker, slot, zero);
        transition { _ -> zero(checker, syntax, resolution, typing, item, selected, has_case, first, count, total, slot + 1) }
    }

    machine written(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        item: DataItem,
        selected: DataCase,
        has_case: bool,
        first: u64 in Trapping,
        count: u64 in Trapping,
        total: u64 in Trapping,
        offset: u64 in Trapping
    ) -> bool {
        transition offset < count {
            true -> field(checker, syntax, resolution, typing, item, selected, has_case, first, count, total, offset)
            _ -> decided(checker, syntax, resolution, typing, item, selected, has_case, total)
        }
    }

    machine field(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        item: DataItem,
        selected: DataCase,
        has_case: bool,
        first: u64 in Trapping,
        count: u64 in Trapping,
        total: u64 in Trapping,
        offset: u64 in Trapping
    ) -> bool {
        let written: ConstructField = SyntaxTrees::construct_field(syntax, first + offset);
        let target: MemberTarget = Typing::construct_target(typing, first + offset);
        let value: Value = Checker::value_at(checker, written.value);
        let slot: u64 in Trapping = Checker::member_slot(item, selected, target);
        transition slot < total {
            true -> stored(checker, syntax, resolution, typing, item, selected, has_case, first, count, total, offset, slot, value)
            _ -> written(checker, syntax, resolution, typing, item, selected, has_case, first, count, total, offset + 1)
        }
    }

    machine stored(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        item: DataItem,
        selected: DataCase,
        has_case: bool,
        first: u64 in Trapping,
        count: u64 in Trapping,
        total: u64 in Trapping,
        offset: u64 in Trapping,
        slot: u64 in Trapping,
        value: Value
    ) -> bool {
        Checker::set_argument(checker, slot, value);
        transition { _ -> written(checker, syntax, resolution, typing, item, selected, has_case, first, count, total, offset + 1) }
    }

    machine decided(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        item: DataItem,
        selected: DataCase,
        has_case: bool,
        total: u64 in Trapping
    ) -> bool {
        let substituting: bool = checker.field_values;
        let field_first: u64 in Trapping = checker.field_first;
        let arguments: u64 in Trapping = checker.argument_count;
        checker.field_values = true;
        checker.field_first = item.first_field;
        checker.argument_count = total;
        Checker::seed_construction_subject(checker, syntax, typing, item, selected, 0);
        let required: bool = Checker::decide_facts(checker, syntax, resolution, typing, item.first_clause, item.clause_count, ClauseKind::Requires, true);
        checker.field_values = substituting;
        checker.field_first = field_first;
        checker.argument_count = arguments;
        required
    }

    machine unproved() -> bool {
        false
    }
}

// The case a construction or arm selects, or, without one, a case with no
// payload fields and no clauses.
public machine Checker::selected_case(syntax: &SyntaxTrees, has_case: bool, data_case: u64 in Trapping) -> DataCase
crashes Trap
{
    transition has_case {
        true -> declared(syntax, data_case)
        _ -> none(syntax)
    }

    machine declared(syntax: &SyntaxTrees, data_case: u64 in Trapping) -> DataCase {
        let selected: DataCase = SyntaxTrees::data_case(syntax, data_case);
        selected
    }

    machine none(syntax: &SyntaxTrees) -> DataCase {
        let mut empty: DataCase;
        empty.first_payload_field = 0;
        empty.payload_field_count = 0;
        empty
    }
}

// The argument slot a construction's member stands in while facts are
// decided: a common field's offset, then the selected case's payload fields
// after every common field; `total` and beyond for none.
public machine Checker::member_slot(item: DataItem, selected: DataCase, target: MemberTarget) -> u64 in Trapping
crashes Trap
{
    transition target {
        MemberTarget::Common { field } -> common(item, field)
        MemberTarget::Payload { field } -> payload(item, selected, field)
        _ -> none()
    }

    machine common(item: DataItem, field: u64 in Trapping) -> u64 in Trapping {
        transition field >= item.first_field && field - item.first_field < item.field_count {
            true -> slot(field - item.first_field)
            _ -> none()
        }
    }

    machine payload(item: DataItem, selected: DataCase, field: u64 in Trapping) -> u64 in Trapping {
        transition field >= selected.first_payload_field && field - selected.first_payload_field < selected.payload_field_count {
            true -> slot(item.field_count + (field - selected.first_payload_field))
            _ -> none()
        }
    }

    machine slot(offset: u64 in Trapping) -> u64 in Trapping {
        offset
    }

    machine none() -> u64 in Trapping {
        18446744073709551615
    }
}

// The default predicate is about this exact completed value. Only established
// roots may assume it; a provisional construction owes it from written inputs.
public machine Checker::data_predicates(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, subject: Value, item: DataItem, proving: bool) -> bool
crashes Trap
{
    let established: bool = Checker::established(checker, syntax, subject.place);
    transition proving || established {
        true -> decided(checker, syntax, resolution, typing, subject, item, proving)
        _ -> false
    }
    machine decided(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, subject: Value, item: DataItem, proving: bool) -> bool {
        let previous: Value = checker.subject;
        let subjecting: bool = checker.subjecting;
        let previous_template: u64 in Trapping = checker.static_template;
        checker.static_template = 0;
        checker.subject = subject;
        checker.subjecting = true;
        let held: bool = Checker::decide_facts(checker, syntax, resolution, typing, item.first_clause, item.clause_count, ClauseKind::Requires, proving);
        checker.subject = previous;
        checker.subjecting = subjecting;
        checker.static_template = previous_template;
        held
    }
}

machine Checker::seed_construction_subject(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, item: DataItem, selected: DataCase, offset: u64 in Trapping)
crashes Trap
{
    transition offset < item.field_count + selected.payload_field_count {
        true -> component(checker, syntax, typing, item, selected, offset)
        _ -> done()
    }
    machine component(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, item: DataItem, selected: DataCase, offset: u64 in Trapping) {
        let common: bool = offset < item.field_count;
        let field: u64 in Trapping = match common { true -> item.first_field + offset false -> selected.first_payload_field + (offset - item.field_count) };
        let kind: PlaceKind = match common { true -> PlaceKind::Field false -> PlaceKind::Payload };
        let declared: DataField = match common { true -> SyntaxTrees::field(syntax, field) false -> SyntaxTrees::payload_field(syntax, field) };
        let type_handle: u64 in Trapping = Typing::reference_type(typing, declared.type_reference);
        let value: Value = Checker::argument_value(checker, offset);
        let parent: u64 in Trapping = checker.subject.place;
        Checker::write_pending_component(checker, typing, kind, parent, field, type_handle, value);
        transition { _ -> Checker::seed_construction_subject(checker, syntax, typing, item, selected, offset + 1) }
    }
    machine done() {}
}

// Only predicates whose read footprint intersects the changed component need
// restoration. The established owner already owes every other predicate; an
// unrelated field store cannot invalidate its tag or another field's value.
// Calls and non-case memberships retain the conservative whole-owner footprint.
machine Checker::data_predicates_after_write(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, subject: Value, item: DataItem, written: Place) -> bool
crashes Trap
{
    let previous: Value = checker.subject;
    let subjecting: bool = checker.subjecting;
    checker.subject = subject;
    checker.subjecting = true;
    let held: bool = Checker::restore_data_predicates(checker, syntax, resolution, typing, item.first_clause, item.first_clause + item.clause_count, written);
    checker.subject = previous;
    checker.subjecting = subjecting;
    held
}

machine Checker::restore_data_predicates(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, written: Place) -> bool
crashes Trap
{
    transition index < end { true -> clause(checker, syntax, resolution, typing, index, end, written) _ -> result(true) }
    machine clause(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, written: Place) -> bool {
        let current: Clause = SyntaxTrees::clause(syntax, index);
        transition current.kind == ClauseKind::Requires && current.has_expression {
            true -> predicate(checker, syntax, resolution, typing, index, end, written, current.expression)
            _ -> next(checker, syntax, resolution, typing, index, end, written)
        }
    }
    machine predicate(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, written: Place, root: u64 in Trapping) -> bool {
        let affected: bool = Checker::predicate_reads_component(syntax, resolution, typing, root, written);
        transition affected { true -> owed(checker, syntax, resolution, typing, index, end, written, root) _ -> next(checker, syntax, resolution, typing, index, end, written) }
    }
    machine owed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, written: Place, root: u64 in Trapping) -> bool {
        let typed: bool = Typing::expression_type(typing, root) == typing.boolean;
        let held: bool = typed && Checker::decide_fact(checker, syntax, resolution, typing, root, true);
        transition held { true -> next(checker, syntax, resolution, typing, index, end, written) _ -> result(false) }
    }
    machine next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, written: Place) -> bool {
        transition { _ -> Checker::restore_data_predicates(checker, syntax, resolution, typing, index + 1, end, written) }
    }
    machine result(held: bool) -> bool { held }
}

machine Checker::predicate_reads_component(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, written: Place) -> bool
crashes Trap
{
    let tree: Expression = SyntaxTrees::expression(syntax, root);
    transition { _ -> node(syntax, resolution, typing, root, written, tree.first_row) }
    machine node(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, written: Place, index: u64 in Trapping) -> bool {
        transition index <= root { true -> expression(syntax, resolution, typing, root, written, index) _ -> result(false) }
    }
    machine expression(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, written: Place, index: u64 in Trapping) -> bool {
        let current: Expression = SyntaxTrees::expression(syntax, index);
        transition current.kind == ExpressionKind::Call || current.kind == ExpressionKind::Cast || current.kind == ExpressionKind::Unary || current.kind == ExpressionKind::Match {
            true -> whole_or_negation(syntax, resolution, typing, root, written, index, current)
            _ -> membership(syntax, resolution, typing, root, written, index, current)
        }
    }
    machine whole_or_negation(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, written: Place, index: u64 in Trapping, current: Expression) -> bool {
        transition current.kind == ExpressionKind::Unary && current.operator == OperatorKind::Not { true -> next(syntax, resolution, typing, root, written, index) _ -> result(true) }
    }
    machine membership(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, written: Place, index: u64 in Trapping, current: Expression) -> bool {
        transition current.kind == ExpressionKind::Membership { true -> membership_binding(syntax, resolution, typing, root, written, index) _ -> selected(syntax, resolution, typing, root, written, index) }
    }
    machine membership_binding(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, written: Place, index: u64 in Trapping) -> bool {
        let binding: ValueBinding = NameResolution::value_binding(resolution, index);
        transition binding { ValueBinding::DataCase { item as _, data_case as _ } -> next(syntax, resolution, typing, root, written, index) _ -> result(true) }
    }
    machine selected(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, written: Place, index: u64 in Trapping) -> bool {
        let selection: Selection = Typing::selection(typing, index);
        transition selection {
            Selection::Field { field } -> field(syntax, resolution, typing, root, written, index, PlaceKind::Field, field)
            Selection::PayloadField { data_case as _, field } -> field(syntax, resolution, typing, root, written, index, PlaceKind::Payload, field)
            Selection::Machine { handle as _ } -> result(true)
            Selection::Binder { parameter as _ } -> result(true)
            _ -> bare(syntax, resolution, typing, root, written, index)
        }
    }
    machine bare(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, written: Place, index: u64 in Trapping) -> bool {
        let binding: ValueBinding = NameResolution::value_binding(resolution, index);
        transition binding { ValueBinding::Field { field } -> field(syntax, resolution, typing, root, written, index, PlaceKind::Field, field) _ -> next(syntax, resolution, typing, root, written, index) }
    }
    machine field(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, written: Place, index: u64 in Trapping, kind: PlaceKind, field: u64 in Trapping) -> bool {
        transition written.kind == kind && written.handle == field { true -> result(true) _ -> next(syntax, resolution, typing, root, written, index) }
    }
    machine next(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, written: Place, index: u64 in Trapping) -> bool {
        transition { _ -> node(syntax, resolution, typing, root, written, index + 1) }
    }
    machine result(affected: bool) -> bool { affected }
}
