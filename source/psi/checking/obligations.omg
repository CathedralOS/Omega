use psi::checking::arithmetic;
use psi::checking::checker;
use psi::checking::recasts;
use psi::checking::constructions;
use psi::checking::contracts;
use psi::checking::domains;
use psi::checking::evaluation;
use psi::checking::flow;
use psi::checking::matches;
use psi::checking::places;
use psi::checking::references;
use psi::checking::qualification;
use psi::checking::termination;
use psi::checks::checks;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// Each expression node's value, from its children's, and its definedness
// obligations: a place's subject, a literal's constant, an index inside its
// collection (wiki/spec/language/numeric_values.md#collection-bounds),
// fixed-integer operators and conversions (arithmetic.omg), and a call's
// `requires` facts, effects and `ensures` facts. Values only gather facts
// while `checking` is false; obligations reject only when it holds, after
// the body's facts have settled.
pub machine Checker::evaluate_node(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    handle: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, handle);
    let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
    let row: TypeRow = TypeTable::row(&typing.types, type_handle);
    let integer: bool = row.kind == TypeKind::Builtin && ExactInteger::is_carrier(row.builtin);
    transition expression.kind {
        ExpressionKind::Name -> name(checker, syntax, resolution, typing, handle, type_handle)
        ExpressionKind::Integer -> literal(checker, typing, handle)
        ExpressionKind::Boolean -> boolean(checker, handle, expression)
        ExpressionKind::Field -> field(checker, typing, handle, expression, type_handle)
        ExpressionKind::Index -> index(checker, syntax, typing, handle, expression, row, checking)
        ExpressionKind::Unary -> unary(checker, handle, expression, row, integer, checking)
        ExpressionKind::Binary -> binary(checker, syntax, resolution, typing, handle, expression, row, integer, checking)
        ExpressionKind::Cast -> qualified_cast(checker, syntax, resolution, typing, handle, expression, type_handle, row, integer, checking)
        ExpressionKind::Call -> call(checker, syntax, resolution, typing, handle, expression, row, checking)
        ExpressionKind::Construct -> construct(checker, syntax, resolution, typing, handle, expression, type_handle, row, checking)
        ExpressionKind::Path -> path(checker, syntax, resolution, typing, handle, expression, type_handle, row, checking)
        ExpressionKind::Match -> matched(checker, syntax, resolution, typing, handle, checking)
        ExpressionKind::Array -> array_literal(checker, syntax, resolution, typing, handle, expression, row, checking)
        _ -> typed(checker, handle, row)
    }

    // An array literal's elements meet its element type's qualification.
    state array_literal(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        row: TypeRow,
        checking: bool
    ) {
        transition checking {
            true -> array_element(checker, syntax, resolution, typing, handle, expression, row, 0)
            _ -> typed(checker, handle, row)
        }
    }

    state array_element(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        row: TypeRow,
        offset: u64 in Trapping
    ) {
        transition offset < expression.count {
            true -> element_qualified(checker, syntax, resolution, typing, handle, expression, row, offset)
            _ -> typed(checker, handle, row)
        }
    }

    state element_qualified(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        row: TypeRow,
        offset: u64 in Trapping
    ) {
        let element: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + offset);
        let value: Value = Checker::value_at(checker, element);
        let written: Expression = SyntaxTrees::expression(syntax, element);
        Checker::require_qualification(checker, syntax, resolution, typing, row.inner, element, value, written.source_span);
        transition { _ -> array_element(checker, syntax, resolution, typing, handle, expression, row, offset + 1) }
    }

    state matched(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, checking: bool) {
        Checker::close_match(checker, syntax, resolution, typing, handle, checking);
    }

    state name(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, type_handle: u64 in Trapping) {
        let value: Value = Checker::name_value(checker, syntax, resolution, typing, handle, type_handle);
        let read: Value = Checker::read_interval(typing, type_handle, value);
        Checker::set_value(checker, handle, read);
    }

    state literal(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping) {
        let literal: ExactInteger = Typing::value(typing, handle);
        let value: Value = Value::constant(literal);
        Checker::set_value(checker, handle, value);
    }

    state boolean(checker: &mut Checker, handle: u64 in Trapping, expression: Expression) {
        let value: Value = Value::truth(expression.flag);
        Checker::set_value(checker, handle, value);
    }

    state field(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, expression: Expression, type_handle: u64 in Trapping) {
        let value: Value = Checker::member_value(checker, typing, handle, expression, type_handle);
        Checker::set_value(checker, handle, value);
    }

    // `collection[index]`: the index lies in `0..len`.
    state index(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow, checking: bool) {
        let base: Value = Checker::value_at(checker, expression.left);
        let collection: TypeRow = Checker::collection_row(typing, expression.left);
        let length: Value = Checker::collection_length(checker, typing, collection, base);
        let operand: Expression = SyntaxTrees::expression(syntax, expression.right);
        transition operand.kind == ExpressionKind::Range {
            true -> sliced(checker, typing, handle, expression, operand, row, length, base, checking)
            _ -> element(checker, handle, expression, row, length, checking)
        }
    }

    state element(checker: &mut Checker, handle: u64 in Trapping, expression: Expression, row: TypeRow, length: Value, checking: bool) {
        let position: Value = Checker::value_at(checker, expression.right);
        let below: bool = Checker::proves_less(checker, position, length);
        let zero: Value = Value::constant(ExactInteger { negative: false, magnitude: 0 });
        let above: bool = Checker::proves_at_most(checker, zero, position);
        transition checking && !(below && above) {
            true -> out_of_bounds(checker, handle, expression, row)
            _ -> typed(checker, handle, row)
        }
    }

    // A range slice stays within its collection
    // (wiki/spec/language/expressions.md, Indexing and ranges): its start,
    // zero when omitted, is at most its exclusive end, which is at most the
    // length; an omitted end is the length, and an inclusive end `b` is the
    // exclusive end `b + 1`, valid when `b` is a valid index: neither
    // negative nor past the last element.
    state sliced(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, expression: Expression, operand: Expression, row: TypeRow, length: Value, base: Value, checking: bool) {
        let zero: Value = Value::constant(ExactInteger { negative: false, magnitude: 0 });
        let one: Value = Value::constant(ExactInteger { negative: false, magnitude: 1 });
        let start: Value = Checker::range_endpoint(checker, operand.first == 1, operand.left, zero);
        let end: Value = Checker::range_endpoint(checker, operand.count == 1, operand.right, length);
        let interval: Value = Value::sum(end, one);
        let successor: Value = Value::offset_sum(end, one, interval);
        let inclusive: bool = operand.flag && operand.count == 1;
        let within: bool = Checker::proves_at_most(checker, end, length);
        let index_valid: bool = Checker::proves_less(checker, end, length);
        let ordered: bool = Checker::proves_at_most(checker, start, end);
        let ordered_inclusive: bool = Checker::proves_at_most(checker, start, successor);
        let nonnegative: bool = Checker::proves_at_most(checker, zero, start);
        let end_index: bool = Checker::proves_at_most(checker, zero, end) && index_valid;
        let valid: bool = nonnegative && ((inclusive && end_index && ordered_inclusive) || (!inclusive && within && ordered));
        let bound: Value = Checker::range_end(end, successor, inclusive);
        transition checking && !valid {
            true -> out_of_bounds(checker, handle, expression, row)
            _ -> range_viewed(checker, typing, handle, row, base, start, bound)
        }
    }

    // A range slice of a placed collection is a view: a place of its own
    // below the collection, whose live length is the range's extent
    // (wiki/spec/terminal-psi/byte_views.md). A write through it forgets
    // the collection's contents (`Checker::forget_backing`).
    state range_viewed(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, row: TypeRow, base: Value, start: Value, bound: Value) {
        transition base.place > 0 {
            true -> view_place(checker, typing, handle, base.place, start, bound)
            _ -> typed(checker, handle, row)
        }
    }

    state view_place(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, collection: u64 in Trapping, start: Value, bound: Value) {
        let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
        let view: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Referent, handle, collection, type_handle);
        let length_place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Length, 0, view, 0);
        // Kept as a linear term when the start is a constant, so
        // `items[1..]` is one shorter than `items` in the zone.
        let interval: Value = Value::difference(bound, start);
        let extent: Value = Value::offset_difference(bound, start, interval);
        Checker::bind_place(checker, typing, length_place, extent);
        let value: Value = Value::at_place(view);
        Checker::set_value(checker, handle, value);
    }

    state out_of_bounds(checker: &mut Checker, handle: u64 in Trapping, expression: Expression, row: TypeRow) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::IndexOutOfBounds, expression.source_span);
        transition { _ -> typed(checker, handle, row) }
    }

    // A borrow names its operand's place; a negation is arithmetic.
    state unary(checker: &mut Checker, handle: u64 in Trapping, expression: Expression, row: TypeRow, integer: bool, checking: bool) {
        transition expression.operator {
            OperatorKind::Borrow -> borrowed(checker, handle, expression)
            OperatorKind::BorrowMutable -> borrowed(checker, handle, expression)
            OperatorKind::BorrowWrite -> borrowed(checker, handle, expression)
            OperatorKind::Negate -> negated(checker, handle, expression, row, integer, checking)
            _ -> typed(checker, handle, row)
        }
    }

    state borrowed(checker: &mut Checker, handle: u64 in Trapping, expression: Expression) {
        let operand: Value = Checker::value_at(checker, expression.left);
        let value: Value = Value::at_place(operand.place);
        Checker::set_value(checker, handle, value);
    }

    state negated(checker: &mut Checker, handle: u64 in Trapping, expression: Expression, row: TypeRow, integer: bool, checking: bool) {
        transition integer {
            true -> negation(checker, handle, expression, row, checking)
            _ -> typed(checker, handle, row)
        }
    }

    state negation(checker: &mut Checker, handle: u64 in Trapping, expression: Expression, row: TypeRow, checking: bool) {
        let value: Value = Checker::negation_value(checker, expression, row, checking);
        Checker::set_value(checker, handle, value);
    }

    // Comparisons and Boolean operators carry no obligation, and float
    // arithmetic follows its format's rules, outside this slice.
    // An operator typing selected a machine for is a call of that machine
    // with its operands as arguments; any other is builtin.
    state binary(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        row: TypeRow,
        integer: bool,
        checking: bool
    ) {
        let selection: Selection = Typing::selection(typing, handle);
        let selected: bool = Checker::selects_machine(selection);
        transition selected {
            true -> call(checker, syntax, resolution, typing, handle, expression, row, checking)
            _ -> builtin(checker, handle, expression, row, integer, checking)
        }
    }

    state builtin(checker: &mut Checker, handle: u64 in Trapping, expression: Expression, row: TypeRow, integer: bool, checking: bool) {
        transition integer {
            true -> arithmetic(checker, handle, expression, row, checking)
            _ -> typed(checker, handle, row)
        }
    }

    state arithmetic(checker: &mut Checker, handle: u64 in Trapping, expression: Expression, row: TypeRow, checking: bool) {
        let value: Value = Checker::binary_value(checker, expression, row, checking);
        Checker::set_value(checker, handle, value);
    }

    // A cast to a type a declared domain qualifies proves its predicates of
    // the operand, whose denotation it keeps (qualification.omg).
    state qualified_cast(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        type_handle: u64 in Trapping,
        row: TypeRow,
        integer: bool,
        checking: bool
    ) {
        transition checking {
            true -> cast_qualification(checker, syntax, resolution, typing, handle, expression, type_handle, row, integer)
            _ -> cast(checker, syntax, typing, handle, expression, row, integer, checking)
        }
    }

    state cast_qualification(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        type_handle: u64 in Trapping,
        row: TypeRow,
        integer: bool
    ) {
        let operand: Value = Checker::value_at(checker, expression.left);
        Checker::require_qualification(checker, syntax, resolution, typing, type_handle, expression.left, operand, expression.source_span);
        transition { _ -> cast(checker, syntax, typing, handle, expression, row, integer, true) }
    }

    state cast(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow, integer: bool, checking: bool) {
        transition row.kind == TypeKind::Reference {
            true -> recast(checker, syntax, typing, handle, expression, row, checking)
            _ -> scalar_cast(checker, typing, handle, expression, row, integer, checking)
        }
    }

    state recast(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow, checking: bool) {
        Checker::check_recast(checker, syntax, typing, expression, row, checking);
        transition { _ -> typed(checker, handle, row) }
    }

    state scalar_cast(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow, integer: bool, checking: bool) {
        transition integer {
            true -> conversion(checker, typing, handle, expression, row, checking)
            _ -> typed(checker, handle, row)
        }
    }

    state conversion(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow, checking: bool) {
        let value: Value = Checker::conversion_value(checker, typing, expression, row, checking);
        Checker::set_value(checker, handle, value);
    }

    // In the checking walk a call is recorded for crash routes and its
    // callee's `requires` facts are owed as it is entered. A machine call
    // may change what its write frame says below its exclusive arguments
    // (frames.omg); a jump only transfers its arguments, whose facts its
    // state's arrival projects. Its result lies in its type's range, or,
    // when its callee `ensures` facts, is a place those facts describe. The fact-gathering walks may visit a body several
    // times; a replayed call keeps the result its evaluation gave.
    state call(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow, checking: bool) {
        transition checker.replay {
            true -> replayed(checker, typing, handle, row)
            _ -> entered(checker, syntax, resolution, typing, handle, expression, row, checking)
        }
    }

    state replayed(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, row: TypeRow) {
        let place: u64 in Trapping = Checker::find_place(checker, PlaceKind::Call, handle, 0);
        transition place > 0 {
            true -> placed(checker, typing, handle, place)
            _ -> typed(checker, handle, row)
        }
    }

    state placed(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, place: u64 in Trapping) {
        let value: Value = Checker::reference_value(checker, typing, place);
        Checker::set_value(checker, handle, value);
    }

    state entered(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow, checking: bool) {
        let binding: ValueBinding = NameResolution::value_binding(resolution, expression.left);
        transition binding {
            ValueBinding::BytePredicate { predicate } -> predicated(checker, syntax, resolution, typing, handle, expression, predicate)
            _ -> selected(checker, syntax, resolution, typing, handle, expression, row, checking)
        }
    }

    // A primitive byte predicate's truth: of a quoted literal by its octets,
    // of a domain's subject under decision by the literal being qualified,
    // and of a value whose declared domain requires that predicate; unknown
    // otherwise.
    state predicated(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, predicate: BytePredicate) {
        let argument: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first);
        let truth: Value = Checker::predicate_value(checker, syntax, resolution, typing, argument, predicate);
        Checker::set_value(checker, handle, truth);
    }

    state selected(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow, checking: bool) {
        let selection: Selection = Typing::selection(typing, handle);
        Checker::record_self_call(checker, selection);
        transition checking {
            true -> recorded(checker, syntax, resolution, typing, handle, expression, row)
            _ -> effects(checker, syntax, resolution, typing, handle, expression, row)
        }
    }

    state recorded(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, node: u64 in Trapping, expression: Expression, row: TypeRow) {
        let selection: Selection = Typing::selection(typing, node);
        Checker::record_call(checker, syntax, resolution, selection);
        Checker::record_supply(checker, syntax, selection, node);
        Checker::require_call_qualifications(checker, syntax, resolution, typing, selection, expression);
        Checker::require_self_descent(checker, syntax, resolution, typing, selection, expression);
        Checker::require_callee_facts(checker, syntax, resolution, typing, selection, expression);
        transition { _ -> effects(checker, syntax, resolution, typing, node, expression, row) }
    }

    state effects(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, node: u64 in Trapping, expression: Expression, row: TypeRow) {
        let selection: Selection = Typing::selection(typing, node);
        let called: bool = Checker::selects_machine(selection);
        transition called {
            true -> released(checker, syntax, resolution, typing, node, expression, row)
            _ -> resulted(checker, syntax, typing, node, expression, row)
        }
    }

    // A returned reference is a place of its own, standing for its referent
    // (references.omg); any other result is known by its type.
    state resulted(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, node: u64 in Trapping, expression: Expression, row: TypeRow) {
        transition row.kind == TypeKind::Reference {
            true -> returned_view(checker, syntax, typing, node, expression, row)
            _ -> typed(checker, node, row)
        }
    }

    // An exclusive returned reference may reach any storage an exclusive
    // argument lent (wiki/spec/language/lifetimes.md#returned-views), and
    // a write through it is not a write the callee's frame records: what
    // those arguments reach is released whole before the view is formed.
    state returned_view(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, node: u64 in Trapping, expression: Expression, row: TypeRow) {
        transition row.access == ReferenceAccess::Shared {
            true -> viewed(checker, typing, node)
            _ -> sourced_view(checker, syntax, typing, node, expression, row)
        }
    }

    // An exclusive view needs every exclusive source's storage known: a
    // write through a view of unknown storage stays refused, as a write
    // through that source would be, rather than gaining facts of its own.
    state sourced_view(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, node: u64 in Trapping, expression: Expression, row: TypeRow) {
        let placed: bool = Checker::exclusive_arguments_placed(checker, syntax, typing, expression, 0);
        transition placed {
            true -> released_view(checker, syntax, typing, node, expression)
            _ -> typed(checker, node, row)
        }
    }

    state released_view(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, node: u64 in Trapping, expression: Expression) {
        Checker::release_exclusive_arguments(checker, syntax, typing, expression, Selection::None);
        transition { _ -> viewed(checker, typing, node) }
    }

    // The call's value is what the returned reference denotes: a scalar
    // referent's own subject, or the call place standing for the referent,
    // so a local capturing it reads and writes that storage.
    state viewed(checker: &mut Checker, typing: &Typing, node: u64 in Trapping) {
        let type_handle: u64 in Trapping = Typing::expression_type(typing, node);
        let place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Call, node, 0, type_handle);
        let referent: Value = Checker::reference_value(checker, typing, place);
        Checker::set_value(checker, node, referent);
    }

    // A machine binder may be any machine meeting its contract, so whatever
    // its exclusive arguments reach may change, and no guarantee follows.
    state released(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, node: u64 in Trapping, expression: Expression, row: TypeRow) {
        let selection: Selection = Typing::selection(typing, node);
        Checker::release_exclusive_arguments(checker, syntax, typing, expression, selection);
        transition selection {
            Selection::Machine { handle } -> callee(checker, syntax, resolution, typing, node, expression, row, handle)
            _ -> resulted(checker, syntax, typing, node, expression, row)
        }
    }

    state callee(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, node: u64 in Trapping, expression: Expression, row: TypeRow, machine: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, machine);
        let guarantees: bool = Checker::declares(syntax, item.first_clause, item.clause_count, ClauseKind::Ensures);
        transition guarantees {
            true -> guaranteed(checker, syntax, resolution, typing, node, expression, item)
            _ -> resulted(checker, syntax, typing, node, expression, row)
        }
    }

    state guaranteed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, node: u64 in Trapping, expression: Expression, item: MachineItem) {
        let type_handle: u64 in Trapping = Typing::expression_type(typing, node);
        let place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Call, node, 0, type_handle);
        let value: Value = Checker::reference_value(checker, typing, place);
        Checker::set_value(checker, node, value);
        Checker::assume_guarantees(checker, syntax, resolution, typing, item, expression, value);
    }

    // Establishing a value of data with `where` facts owes them, and a case
    // value its case's own facts too: a construction over the values it
    // writes, a payload-free case value (`Type::Case`) over zero fields.
    state construct(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, type_handle: u64 in Trapping, row: TypeRow, checking: bool) {
        let constrained: bool = Checker::constrained(syntax, typing, type_handle);
        let binding: ValueBinding = NameResolution::value_binding(resolution, expression.left);
        transition checking && constrained {
            true -> written(checker, syntax, resolution, typing, handle, expression, row, binding)
            _ -> composed(checker, syntax, resolution, typing, handle, expression, row)
        }
    }

    state written(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow, binding: ValueBinding) {
        transition binding {
            ValueBinding::Data { item } -> constructed(checker, syntax, resolution, typing, handle, expression, row, item, false, 0, expression.first, expression.count)
            ValueBinding::DataCase { item, data_case } -> constructed(checker, syntax, resolution, typing, handle, expression, row, item, true, data_case, expression.first, expression.count)
            _ -> composed(checker, syntax, resolution, typing, handle, expression, row)
        }
    }

    state path(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, type_handle: u64 in Trapping, row: TypeRow, checking: bool) {
        let constrained: bool = Checker::constrained(syntax, typing, type_handle);
        let binding: ValueBinding = NameResolution::value_binding(resolution, handle);
        let constructing: bool = checking && constrained;
        transition binding {
            ValueBinding::Constant { constant } -> constant(checker, syntax, typing, handle, constant, type_handle)
            _ -> case_path(checker, syntax, resolution, typing, handle, expression, row, binding, constructing)
        }
    }

    state case_path(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        row: TypeRow,
        binding: ValueBinding,
        constructing: bool
    ) {
        transition constructing {
            true -> case_value(checker, syntax, resolution, typing, handle, expression, row, binding)
            _ -> typed(checker, handle, row)
        }
    }

    state case_value(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow, binding: ValueBinding) {
        transition binding {
            ValueBinding::DataCase { item, data_case } -> constructed(checker, syntax, resolution, typing, handle, expression, row, item, true, data_case, 0, 0)
            _ -> typed(checker, handle, row)
        }
    }

    state constant(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, constant: u64 in Trapping, type_handle: u64 in Trapping) {
        let value: Value = Checker::constant_value(syntax, typing, constant, type_handle);
        Checker::set_value(checker, handle, value);
    }

    state constructed(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        row: TypeRow,
        item: u64 in Trapping,
        has_case: bool,
        data_case: u64 in Trapping,
        first: u64 in Trapping,
        count: u64 in Trapping
    ) {
        let held: bool = Checker::construction_holds(checker, syntax, resolution, typing, item, has_case, data_case, first, count);
        transition held {
            true -> composed(checker, syntax, resolution, typing, handle, expression, row)
            _ -> unproven_domain(checker, syntax, resolution, typing, handle, expression, row)
        }
    }

    state unproven_domain(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::DomainUnproven, expression.source_span);
        transition { _ -> composed(checker, syntax, resolution, typing, handle, expression, row) }
    }

    // A construction's value: its own place, the fields it writes pending
    // below it.
    state composed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, row: TypeRow) {
        Checker::construction_value(checker, syntax, resolution, typing, handle, expression, row);
    }

    // A value known only by its type: a fixed integer's carrier range.
    state typed(checker: &mut Checker, handle: u64 in Trapping, row: TypeRow) {
        let value: Value = Value::typed(row);
        Checker::set_value(checker, handle, value);
    }
}

// A range endpoint's value when it is written, else `omitted`'s.
// A range's exclusive end: the written end, or its successor when the
// range is inclusive.
machine Checker::range_end(end: Value, successor: Value, inclusive: bool) -> Value {
    transition inclusive {
        true -> answer(successor)
        _ -> answer(end)
    }

    state answer(bound: Value) -> Value {
        bound
    }
}

machine Checker::range_endpoint(checker: &Checker, written: bool, handle: u64 in Trapping, omitted: Value) -> Value
crashes Trap
{
    transition written {
        true -> read(checker, handle)
        _ -> absent(omitted)
    }

    state read(checker: &Checker, handle: u64 in Trapping) -> Value {
        let value: Value = Checker::value_at(checker, handle);
        value
    }

    state absent(omitted: Value) -> Value {
        omitted
    }
}

// A callee's `requires` facts must hold at the call; a machine binder's
// call owes its `where machine` contract's.
machine Checker::require_callee_facts(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, selection: Selection, expression: Expression)
crashes Trap
{
    let clauses: CallClauses = Checker::call_clauses(syntax, resolution, selection);
    transition clauses.clause_count > 0 {
        true -> owed(checker, syntax, resolution, typing, clauses, expression)
        _ -> done()
    }

    state owed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, clauses: CallClauses, expression: Expression) {
        let held: bool = Checker::decide_call_facts(checker, syntax, resolution, typing, clauses.first_clause, clauses.clause_count, clauses.first_parameter, expression, ClauseKind::Requires, true);
        transition held {
            true -> done()
            _ -> unproven(checker, expression)
        }
    }

    state unproven(checker: &mut Checker, expression: Expression) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::RequirementUnproven, expression.source_span);
    }

    state done() {}
}

// The collection type an index or `.len` applies to, through references.
pub machine Checker::collection_row(typing: &Typing, handle: u64 in Trapping) -> TypeRow
crashes Trap
{
    let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
    let row: TypeRow = Checker::referent_row(typing, type_handle);
    row
}

// A type's row through any references.
pub machine Checker::referent_row(typing: &Typing, type_handle: u64 in Trapping) -> TypeRow
crashes Trap
{
    let row: TypeRow = TypeTable::row(&typing.types, type_handle);
    transition { _ -> through(typing, row, 0) }

    state through(typing: &Typing, row: TypeRow, depth: u64 in Trapping) -> TypeRow {
        transition row.kind == TypeKind::Reference && depth < 16 {
            true -> referent(typing, row.inner, depth)
            _ -> found(row)
        }
    }

    state referent(typing: &Typing, inner: u64 in Trapping, depth: u64 in Trapping) -> TypeRow {
        let row: TypeRow = TypeTable::row(&typing.types, inner);
        transition { _ -> through(typing, row, depth + 1) }
    }

    state found(row: TypeRow) -> TypeRow {
        row
    }
}

// An array's extent: its static integer, or for a `const` generic extent
// any `u64`, since one body serves every specialization.
// Whether every exclusive reference argument of a call has known storage
// (`Checker::storage_origin`), from operand `offset` on.
pub machine Checker::exclusive_arguments_placed(checker: &Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, offset: u64 in Trapping) -> bool
crashes Trap
{
    let count: u64 in Trapping = Checker::operand_count(expression);
    transition offset < count {
        true -> operand(checker, syntax, typing, expression, offset, count)
        _ -> answer(true)
    }

    state operand(checker: &Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, offset: u64 in Trapping, count: u64 in Trapping) -> bool {
        let handle: u64 in Trapping = Checker::operand(syntax, expression, offset);
        let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
        let row: TypeRow = TypeTable::row(&typing.types, type_handle);
        let exclusive: bool = row.kind == TypeKind::Reference && row.access != ReferenceAccess::Shared;
        let origin: u64 in Trapping = Checker::storage_origin(checker, syntax, typing, handle);
        transition exclusive && origin == 0 {
            true -> answer(false)
            _ -> next(checker, syntax, typing, expression, offset, count)
        }
    }

    state next(checker: &Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, offset: u64 in Trapping, count: u64 in Trapping) -> bool {
        transition offset + 1 < count {
            true -> operand(checker, syntax, typing, expression, offset + 1, count)
            _ -> answer(true)
        }
    }

    state answer(placed: bool) -> bool {
        placed
    }
}

// Whether a collection row is a bounded byte array: a fixed byte array
// under a declared domain, whose runtime storage is the bounded `{len,
// bytes}` carrier with a live length rather than an always-full array
// (wiki/spec/terminal-psi/byte_views.md).
pub machine Checker::bounded_bytes(typing: &Typing, collection: TypeRow) -> bool
crashes Trap
{
    let element: TypeRow = TypeTable::row(&typing.types, collection.inner);
    collection.kind == TypeKind::Array && collection.domain == DomainBinding::Declared
        && element.kind == TypeKind::Builtin && element.builtin == BuiltinType::U8
}

// The truth of primitive byte predicate `predicate` of `argument`.
pub machine Checker::predicate_value(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, argument: u64 in Trapping, predicate: BytePredicate) -> Value
crashes Trap
{
    let written: Expression = SyntaxTrees::expression(syntax, argument);
    let binding: ValueBinding = NameResolution::value_binding(resolution, argument);
    let bit: u64 in Trapping = Checker::roster_bit(predicate);
    transition written.kind == ExpressionKind::String {
        true -> literal(typing, argument, bit)
        _ -> bound(checker, syntax, resolution, typing, argument, binding, bit, predicate)
    }

    state literal(typing: &Typing, argument: u64 in Trapping, bit: u64 in Trapping) -> Value {
        let roster: u64 in Trapping = Typing::roster(typing, argument);
        transition { _ -> truth((roster & bit) != 0) }
    }

    state bound(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, argument: u64 in Trapping, binding: ValueBinding, bit: u64 in Trapping, predicate: BytePredicate) -> Value {
        transition binding {
            ValueBinding::DomainSubject { domain } -> subject(checker, bit)
            _ -> declared(syntax, resolution, typing, argument, predicate)
        }
    }

    state subject(checker: &Checker, bit: u64 in Trapping) -> Value {
        let roster: u64 in Trapping = checker.subject_roster;
        transition checker.subject_literal {
            true -> truth((roster & bit) != 0)
            _ -> unknown()
        }
    }

    state declared(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, argument: u64 in Trapping, predicate: BytePredicate) -> Value {
        let type_handle: u64 in Trapping = Typing::expression_type(typing, argument);
        let domain: u64 in Trapping = Checker::qualifying_domain(typing, type_handle);
        transition domain > 0 {
            true -> required(syntax, resolution, domain - 1, predicate)
            _ -> unknown()
        }
    }

    state required(syntax: &SyntaxTrees, resolution: &NameResolution, domain: u64 in Trapping, predicate: BytePredicate) -> Value {
        let declares: bool = Checker::domain_requires(syntax, resolution, domain, predicate);
        transition declares {
            true -> truth(true)
            _ -> unknown()
        }
    }

    state truth(holds: bool) -> Value {
        let value: Value = Value::truth(holds);
        value
    }

    state unknown() -> Value {
        let value: Value = Value::unknown();
        value
    }
}

// The roster bit of a primitive byte predicate.
machine Checker::roster_bit(predicate: BytePredicate) -> u64 in Trapping {
    transition predicate {
        BytePredicate::ValidUtf8 -> answer(1)
        BytePredicate::NoNul -> answer(2)
        BytePredicate::AsciiOnly -> answer(4)
        BytePredicate::NonEmpty -> answer(8)
    }

    state answer(bit: u64 in Trapping) -> u64 in Trapping {
        bit
    }
}

// Whether a declared domain's `requires` facts include primitive byte
// predicate `predicate` of the domain's subject.
machine Checker::domain_requires(syntax: &SyntaxTrees, resolution: &NameResolution, domain: u64 in Trapping, predicate: BytePredicate) -> bool
crashes Trap
{
    let item: DomainItem = SyntaxTrees::domain_item(syntax, domain);
    transition { _ -> next(syntax, resolution, item.first_clause, item.first_clause + item.clause_count, predicate) }

    state next(syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, end: u64 in Trapping, predicate: BytePredicate) -> bool {
        transition index < end {
            true -> clause(syntax, resolution, index, end, predicate)
            _ -> answer(false)
        }
    }

    state clause(syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, end: u64 in Trapping, predicate: BytePredicate) -> bool {
        let written: Clause = SyntaxTrees::clause(syntax, index);
        transition written.kind == ClauseKind::Requires && written.has_expression {
            true -> fact(syntax, resolution, index, end, predicate, written.expression)
            _ -> next(syntax, resolution, index + 1, end, predicate)
        }
    }

    state fact(syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, end: u64 in Trapping, predicate: BytePredicate, fact_handle: u64 in Trapping) -> bool {
        let expression: Expression = SyntaxTrees::expression(syntax, fact_handle);
        transition expression.kind == ExpressionKind::Call && expression.count == 1 {
            true -> callee(syntax, resolution, index, end, predicate, expression)
            _ -> next(syntax, resolution, index + 1, end, predicate)
        }
    }

    state callee(syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, end: u64 in Trapping, wanted: BytePredicate, expression: Expression) -> bool {
        let binding: ValueBinding = NameResolution::value_binding(resolution, expression.left);
        let argument: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first);
        let subject: ValueBinding = NameResolution::value_binding(resolution, argument);
        transition binding {
            ValueBinding::BytePredicate { predicate } -> named_predicate(syntax, resolution, index, end, wanted, predicate, subject)
            _ -> next(syntax, resolution, index + 1, end, wanted)
        }
    }

    state named_predicate(syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, end: u64 in Trapping, predicate: BytePredicate, named: BytePredicate, subject: ValueBinding) -> bool {
        transition subject {
            ValueBinding::DomainSubject { domain } -> matched(syntax, resolution, index, end, predicate, named)
            _ -> next(syntax, resolution, index + 1, end, predicate)
        }
    }

    state matched(syntax: &SyntaxTrees, resolution: &NameResolution, index: u64 in Trapping, end: u64 in Trapping, predicate: BytePredicate, named: BytePredicate) -> bool {
        transition named == predicate {
            true -> answer(true)
            _ -> next(syntax, resolution, index + 1, end, predicate)
        }
    }

    state answer(requires: bool) -> bool {
        requires
    }
}

pub machine Checker::array_extent(typing: &Typing, collection: TypeRow) -> Value
crashes Trap
{
    let extent: TypeRow = TypeTable::row(&typing.types, collection.length);
    transition extent.kind == TypeKind::StaticInteger {
        true -> fixed(extent.length)
        _ -> parametric()
    }

    state fixed(length: u64 in Trapping) -> Value {
        let magnitude: u64 in Wrapping = length as u64 in Wrapping;
        let value: Value = Value::constant(ExactInteger { negative: false, magnitude: magnitude });
        value
    }

    state parametric() -> Value {
        let value: Value = Value::carrier(BuiltinType::U64);
        value
    }
}

// A collection's length: an array's from its type, a slice's from its place.
pub machine Checker::collection_length(checker: &mut Checker, typing: &Typing, collection: TypeRow, base: Value) -> Value
crashes Trap
{
    let bounded: bool = Checker::bounded_bytes(typing, collection);
    transition collection.kind == TypeKind::Array && !bounded {
        true -> fixed(typing, collection)
        _ -> sliced(checker, typing, base)
    }

    state fixed(typing: &Typing, collection: TypeRow) -> Value {
        let extent: Value = Checker::array_extent(typing, collection);
        extent
    }

    // A slice or a bounded byte array indexes against its live length.
    state sliced(checker: &mut Checker, typing: &Typing, base: Value) -> Value {
        transition base.place > 0 {
            true -> counted(checker, typing, base.place)
            _ -> unknown()
        }
    }

    state counted(checker: &mut Checker, typing: &Typing, parent: u64 in Trapping) -> Value {
        let place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Length, 0, parent, 0);
        let value: Value = Checker::place_value(checker, place);
        value
    }

    state unknown() -> Value {
        let unknown: Value = Value::unknown();
        unknown
    }
}

// Whether typing selected a machine, or a machine binder through its
// contract.
pub machine Checker::selects_machine(selection: Selection) -> bool {
    transition selection {
        Selection::Machine { handle } -> yes()
        Selection::Binder { parameter } -> yes()
        _ -> no()
    }

    state yes() -> bool {
        true
    }

    state no() -> bool {
        false
    }
}

// How many operands a call-like expression passes: a call's arguments, or
// an operator's operands when typing selected a machine for it.
pub machine Checker::operand_count(expression: Expression) -> u64 in Trapping {
    transition expression.kind {
        ExpressionKind::Binary -> two()
        _ -> arguments(expression.count)
    }

    state two() -> u64 in Trapping {
        2
    }

    state arguments(count: u64 in Trapping) -> u64 in Trapping {
        count
    }
}

// The handle of a call-like expression's operand `offset`: a call's
// argument, or an operator's left then right operand.
pub machine Checker::operand(syntax: &SyntaxTrees, expression: Expression, offset: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition expression.kind {
        ExpressionKind::Binary -> sides(expression, offset)
        _ -> argument(syntax, expression, offset)
    }

    state sides(expression: Expression, offset: u64 in Trapping) -> u64 in Trapping {
        transition offset == 0 {
            true -> chosen(expression.left)
            _ -> chosen(expression.right)
        }
    }

    state argument(syntax: &SyntaxTrees, expression: Expression, offset: u64 in Trapping) -> u64 in Trapping {
        let handle: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + offset);
        handle
    }

    state chosen(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}
