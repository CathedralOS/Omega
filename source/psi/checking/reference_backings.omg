use psi::checking::checker;
use psi::checking::evaluation;
use psi::checking::loans;
use psi::checking::places;
use psi::checking::reference_origins;
use psi::checking::references;
use psi::checks::checks;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;
use psi::resolution::resolution;
use psi::checking::obligations;

// A result's possible backing is separate from its logical proof subject.
// Groups and their edge spans are immutable after publication. Transporting
// a view never redirects an older alias to a later call's actual arguments.
public data ReferenceView [copy] {
    first: u64 in Trapping;
    count: u64 in Trapping;
}

// Publish once at the common call boundary, before any actual is released.
// A roster is may-alias evidence, never equality or borrowing permission.
public machine Checker::publish_reference_backings(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, node: u64 in Trapping, expression: Expression)
crashes Trap
{
    let type_handle: u64 in Trapping = Typing::expression_type(typing, node);
    let retained: bool = Checker::holds_references(syntax, typing, type_handle);
    transition retained {
        true -> opened(checker, syntax, resolution, typing, node, expression, type_handle)
        false -> {}
    }
    machine opened(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, node: u64 in Trapping, expression: Expression, type_handle: u64 in Trapping) {
        let place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Call, node, 0, type_handle);
        transition place > 0 && place <= 256 && checker.reference_view_count < 256 {
            true -> group(checker, syntax, resolution, typing, expression, place, checker.reference_view_count)
            false -> full(checker, expression.source_span)
        }
    }
    machine group(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression, place: u64 in Trapping, index: u64 in Trapping)
    requires index < 256
    requires place > 0
    requires place <= 256
    {
        checker.reference_views[index] = ReferenceView { first: checker.reference_backing_count, count: 0 };
        checker.reference_view_count = index + 1;
        transition { _ -> next(checker, syntax, resolution, typing, expression, place, index, 0) }
    }
    machine next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression, place: u64 in Trapping, group: u64 in Trapping, offset: u64 in Trapping)
    requires group < 256
    requires place > 0
    requires place <= 256
    {
        let count: u64 in Trapping = Checker::operand_count(expression);
        transition offset < count {
            true -> argument(checker, syntax, resolution, typing, expression, place, group, offset)
            false -> home(checker, typing, expression, place, group + 1)
        }
    }
    machine argument(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression, place: u64 in Trapping, group: u64 in Trapping, offset: u64 in Trapping)
    requires group < 256
    requires place > 0
    requires place <= 256
    {
        let handle: u64 in Trapping = Checker::operand(syntax, expression, offset);
        Checker::append_argument_backing(checker, syntax, resolution, typing, expression, group, handle);
        transition { _ -> next(checker, syntax, resolution, typing, expression, place, group, offset + 1) }
    }
    machine home(checker: &mut Checker, typing: &Typing, expression: Expression, place: u64 in Trapping, backing: u64 in Trapping)
    requires place > 0
    requires place <= 256
    {
        let entry: Place = Checker::place_at(checker, place - 1);
        let home: u64 in Trapping = Checker::place(checker, typing, PlaceKind::View, backing, 0, entry.type_handle);
        transition home > 0 && home <= 256 {
            true -> publish(checker, place - 1, home - 1, backing)
            false -> full(checker, expression.source_span)
        }
    }
    machine publish(checker: &mut Checker, index: u64 in Trapping, home: u64 in Trapping, backing: u64 in Trapping)
    requires index < 256
    requires home < 256
    {
        let origin: ReferenceOrigin = ReferenceOrigin::View { place: home + 1, backing: backing };
        // The call selects its newest publication; captured aliases name
        // the separate immutable home, not this mutable call-site record.
        checker.reference_origins[index] = origin;
        checker.reference_origins[home] = origin;
    }
    machine full(checker: &mut Checker, source_span: SourceSpan) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, source_span);
    }
}

machine Checker::append_argument_backing(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, call: Expression, group: u64 in Trapping, handle: u64 in Trapping)
requires group < 256
crashes Trap
{
    let adaptation: Adaptation = Typing::adaptation(typing, handle);
    transition adaptation == Adaptation::Read {
        true -> {}
        false -> typed(checker, syntax, resolution, typing, call, group, handle)
    }
    machine typed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, call: Expression, group: u64 in Trapping, handle: u64 in Trapping)
    requires group < 256
    {
        let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
        let row: TypeRow = TypeTable::row(&typing.types, type_handle);
        transition row.kind == TypeKind::Reference || Typing::adaptation(typing, handle) == Adaptation::SharedLend {
            true -> reference(checker, syntax, resolution, typing, call, group, handle)
            false -> carrier(checker, syntax, typing, call, group, handle, type_handle)
        }
    }
    machine reference(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, call: Expression, group: u64 in Trapping, handle: u64 in Trapping)
    requires group < 256
    {
        let value: Value = Checker::value_at(checker, handle);
        transition value.place > 0 {
            true -> placed(checker, call, group, value.place)
            false -> footprint(checker, syntax, resolution, typing, call, group, handle)
        }
    }
    machine placed(checker: &mut Checker, call: Expression, group: u64 in Trapping, place: u64 in Trapping)
    requires group < 256
    {
        let origin: ReferenceOrigin = Checker::exact_reference_origin(checker, place);
        Checker::append_reference_backing(checker, group, origin, call.source_span);
    }
    machine footprint(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, call: Expression, group: u64 in Trapping, handle: u64 in Trapping)
    requires group < 256
    {
        let place: u64 in Trapping = Checker::written_origin(checker, syntax, resolution, typing, handle);
        transition place > 0 {
            true -> located(checker, call, group, place)
            false -> unknown(checker, call, group)
        }
    }
    machine located(checker: &mut Checker, call: Expression, group: u64 in Trapping, place: u64 in Trapping)
    requires group < 256
    {
        Checker::append_reference_backing(checker, group, ReferenceOrigin::Footprint { place: place }, call.source_span);
    }
    machine carrier(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, call: Expression, group: u64 in Trapping, handle: u64 in Trapping, type_handle: u64 in Trapping)
    requires group < 256
    {
        let retained: bool = Checker::holds_references(syntax, typing, type_handle);
        transition retained {
            true -> carried(checker, call, group, handle)
            false -> {}
        }
    }
    machine carried(checker: &mut Checker, call: Expression, group: u64 in Trapping, handle: u64 in Trapping)
    requires group < 256
    {
        let value: Value = Checker::value_at(checker, handle);
        let backing: u64 in Trapping = Checker::reference_view_backing(checker, value.place);
        transition backing > 0 {
            true -> inherited(checker, call, group, value.place, backing)
            false -> unknown(checker, call, group)
        }
    }
    machine inherited(checker: &mut Checker, call: Expression, group: u64 in Trapping, place: u64 in Trapping, backing: u64 in Trapping)
    requires group < 256
    {
        Checker::append_reference_backing(checker, group, ReferenceOrigin::View { place: place, backing: backing }, call.source_span);
    }
    // An owned carrier without a complete published roster may contain
    // unmaterialized reference fields/elements. Existing visible paths are
    // not evidence that those are all its backing. Reads remain logical;
    // a later write through this result must refuse incomplete backing.
    machine unknown(checker: &mut Checker, call: Expression, group: u64 in Trapping)
    requires group < 256
    {
        Checker::append_reference_backing(checker, group, ReferenceOrigin::Unknown, call.source_span);
    }
}

machine Checker::append_reference_backing(checker: &mut Checker, group: u64 in Trapping, origin: ReferenceOrigin, source_span: SourceSpan)
requires group < 256
crashes Trap
{
    transition checker.reference_backing_count < 256 {
        true -> write(checker, group, origin, checker.reference_backing_count)
        false -> full(checker, source_span)
    }
    machine write(checker: &mut Checker, group: u64 in Trapping, origin: ReferenceOrigin, index: u64 in Trapping)
    requires group < 256
    requires index < 256
    {
        checker.reference_backings[index] = origin;
        checker.reference_backing_count = index + 1;
        let mut view: ReferenceView = checker.reference_views[group];
        view.count = view.count + 1;
        checker.reference_views[group] = view;
    }
    machine full(checker: &mut Checker, source_span: SourceSpan) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, source_span);
    }
}
