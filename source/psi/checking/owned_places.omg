use psi::checking::checker;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// Owned places (wiki/spec/language/ownership.md): which places a body owns,
// how two of them overlap, and what multiplicity a type carries. A body's
// owned places are its by-value parameters, its locals and its pattern
// binders, with the field paths below them; an index stands for its whole
// collection unless two integer-literal indexes differ, and a place reached
// through a reference belongs to its loan, not to the body.

// A type's multiplicity: an integer, Boolean, float, address, reference or
// slice view copies; data has its declared multiplicity, linear when a type
// argument is declared linear; an array has its element's and a generic
// parameter its bound's.
pub machine Checker::multiplicity(syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping) -> DataMultiplicity
crashes Trap
{
    transition { _ -> level(syntax, typing, handle, 0) }

    state level(syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, depth: u64 in Trapping) -> DataMultiplicity {
        let row: TypeRow = TypeTable::row(&typing.types, handle);
        transition row.kind {
            TypeKind::Data -> data(syntax, typing, row)
            TypeKind::Array -> array(syntax, typing, row, depth)
            TypeKind::GenericParameter -> generic(syntax, row)
            _ -> answer(DataMultiplicity::Unrestricted)
        }
    }

    state array(syntax: &SyntaxTrees, typing: &Typing, row: TypeRow, depth: u64 in Trapping) -> DataMultiplicity {
        transition depth < 16 {
            true -> level(syntax, typing, row.inner, depth + 1)
            _ -> answer(DataMultiplicity::Affine)
        }
    }

    state generic(syntax: &SyntaxTrees, row: TypeRow) -> DataMultiplicity {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, row.item);
        transition { _ -> answer(parameter.bounds) }
    }

    state data(syntax: &SyntaxTrees, typing: &Typing, row: TypeRow) -> DataMultiplicity {
        let item: DataItem = SyntaxTrees::data_item(syntax, row.item);
        let linear: bool = Checker::linear_argument(syntax, typing, row, 0);
        transition linear {
            true -> answer(DataMultiplicity::Linear)
            _ -> answer(item.multiplicity)
        }
    }

    state answer(multiplicity: DataMultiplicity) -> DataMultiplicity {
        multiplicity
    }
}

// Whether a type argument of data row `row`, from `offset`, is declared
// linear (data, an array of it, or a generic parameter bound linear).
machine Checker::linear_argument(syntax: &SyntaxTrees, typing: &Typing, row: TypeRow, offset: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(syntax, typing, row, offset) }

    state next(syntax: &SyntaxTrees, typing: &Typing, row: TypeRow, offset: u64 in Trapping) -> bool {
        transition offset < row.argument_count {
            true -> argument(syntax, typing, row, offset)
            _ -> answer(false)
        }
    }

    state argument(syntax: &SyntaxTrees, typing: &Typing, row: TypeRow, offset: u64 in Trapping) -> bool {
        let handle: u64 in Trapping = TypeTable::argument(&typing.types, row.first_argument + offset);
        let declared: bool = Checker::declared_linear(syntax, typing, handle);
        transition declared {
            true -> answer(true)
            _ -> next(syntax, typing, row, offset + 1)
        }
    }

    state answer(linear: bool) -> bool {
        linear
    }
}

// Whether a type is declared linear on its own: linear data, an array of
// it, or a generic parameter bound linear.
machine Checker::declared_linear(syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> level(syntax, typing, handle, 0) }

    state level(syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, depth: u64 in Trapping) -> bool {
        let row: TypeRow = TypeTable::row(&typing.types, handle);
        transition row.kind {
            TypeKind::Data -> data(syntax, row)
            TypeKind::Array -> array(syntax, typing, row, depth)
            TypeKind::GenericParameter -> generic(syntax, row)
            _ -> answer(false)
        }
    }

    state array(syntax: &SyntaxTrees, typing: &Typing, row: TypeRow, depth: u64 in Trapping) -> bool {
        transition depth < 16 {
            true -> level(syntax, typing, row.inner, depth + 1)
            _ -> answer(false)
        }
    }

    state data(syntax: &SyntaxTrees, row: TypeRow) -> bool {
        let item: DataItem = SyntaxTrees::data_item(syntax, row.item);
        let linear: bool = item.multiplicity == DataMultiplicity::Linear;
        transition { _ -> answer(linear) }
    }

    state generic(syntax: &SyntaxTrees, row: TypeRow) -> bool {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, row.item);
        let linear: bool = parameter.bounds == DataMultiplicity::Linear;
        transition { _ -> answer(linear) }
    }

    state answer(linear: bool) -> bool {
        linear
    }
}

// The owned root of a place expression: its root, unless a reference lies
// on its path.
pub machine Checker::place_root(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    Checker::path_root(syntax, resolution, typing, handle, false)
}

// The root of a place expression, as a key: a local's statement, a
// parameter or a pattern binder, reached through fields (a field selecting
// `.len` is no place) and indexes, and through references when `through`
// holds. Zero for any other expression.
pub machine Checker::path_root(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, through: bool) -> u64 in Trapping
crashes Trap
{
    transition { _ -> step(syntax, resolution, typing, handle, through, 0) }

    state step(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, node: u64 in Trapping, through: bool, depth: u64 in Trapping) -> u64 in Trapping {
        let expression: Expression = SyntaxTrees::expression(syntax, node);
        let field: bool = Checker::field_place(typing, node, expression);
        transition expression.kind {
            ExpressionKind::Name -> named(resolution, node)
            ExpressionKind::Index -> base(syntax, resolution, typing, expression.left, through, depth)
            ExpressionKind::Field -> field_step(syntax, resolution, typing, expression.left, through, depth, field)
            ExpressionKind::Cast -> recast(syntax, resolution, typing, expression, through, depth)
            _ -> answer(0)
        }
    }

    // A recast views its operand's storage: `&place as &T` roots at the
    // place, and a recast reference value at the reference's place.
    state recast(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression, through: bool, depth: u64 in Trapping) -> u64 in Trapping {
        let operand: Expression = SyntaxTrees::expression(syntax, expression.left);
        let borrow: bool = operand.kind == ExpressionKind::Unary
            && (operand.operator == OperatorKind::Borrow || operand.operator == OperatorKind::BorrowMutable
                || operand.operator == OperatorKind::BorrowWrite);
        transition borrow && depth < 64 {
            true -> step(syntax, resolution, typing, operand.left, through, depth + 1)
            _ -> recast_reference(syntax, resolution, typing, expression.left, through, depth)
        }
    }

    state recast_reference(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, operand: u64 in Trapping, through: bool, depth: u64 in Trapping) -> u64 in Trapping {
        transition depth < 64 {
            true -> step(syntax, resolution, typing, operand, through, depth + 1)
            _ -> answer(0)
        }
    }

    state field_step(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        base: u64 in Trapping,
        through: bool,
        depth: u64 in Trapping,
        field: bool
    ) -> u64 in Trapping {
        transition field {
            true -> base(syntax, resolution, typing, base, through, depth)
            _ -> answer(0)
        }
    }

    state base(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, base: u64 in Trapping, through: bool, depth: u64 in Trapping) -> u64 in Trapping {
        let base_type: u64 in Trapping = Typing::expression_type(typing, base);
        let row: TypeRow = TypeTable::row(&typing.types, base_type);
        let stops: bool = (row.kind == TypeKind::Reference && !through) || depth >= 64;
        transition stops {
            true -> answer(0)
            _ -> step(syntax, resolution, typing, base, through, depth + 1)
        }
    }

    state named(resolution: &NameResolution, node: u64 in Trapping) -> u64 in Trapping {
        let binding: ValueBinding = NameResolution::value_binding(resolution, node);
        transition binding {
            ValueBinding::Local { statement } -> answer(statement * 4 + 1)
            ValueBinding::Parameter { parameter } -> answer(parameter * 4 + 2)
            ValueBinding::PatternBinder { field } -> answer(field * 4 + 3)
            _ -> answer(0)
        }
    }

    state answer(key: u64 in Trapping) -> u64 in Trapping {
        key
    }
}

// Whether a field expression selects a field, a place, rather than `.len`.
pub machine Checker::field_place(typing: &Typing, node: u64 in Trapping, expression: Expression) -> bool
crashes Trap
{
    let selection: Selection = Typing::selection(typing, node);
    let projected: bool = expression.kind == ExpressionKind::Field;
    transition selection {
        Selection::Field { field } -> answer(projected)
        _ -> answer(false)
    }

    state answer(field: bool) -> bool {
        field
    }
}

// How many index steps a place expression takes from its root.
pub machine Checker::index_steps(syntax: &SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> step(syntax, handle, 0, 0) }

    state step(syntax: &SyntaxTrees, node: u64 in Trapping, steps: u64 in Trapping, walked: u64 in Trapping) -> u64 in Trapping {
        let expression: Expression = SyntaxTrees::expression(syntax, node);
        transition walked < 64 && (expression.kind == ExpressionKind::Field || expression.kind == ExpressionKind::Index) {
            true -> inner(syntax, expression, steps, walked)
            _ -> answer(steps)
        }
    }

    state inner(syntax: &SyntaxTrees, expression: Expression, steps: u64 in Trapping, walked: u64 in Trapping) -> u64 in Trapping {
        transition expression.kind == ExpressionKind::Index {
            true -> step(syntax, expression.left, steps + 1, walked + 1)
            _ -> step(syntax, expression.left, steps, walked + 1)
        }
    }

    state answer(steps: u64 in Trapping) -> u64 in Trapping {
        steps
    }
}

// How many field steps lie between a place expression and its root; an
// index is transparent.
pub machine Checker::place_depth(syntax: &SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> step(syntax, handle, 0, 0) }

    state step(syntax: &SyntaxTrees, node: u64 in Trapping, depth: u64 in Trapping, walked: u64 in Trapping) -> u64 in Trapping {
        let expression: Expression = SyntaxTrees::expression(syntax, node);
        transition walked < 64 && (expression.kind == ExpressionKind::Field || expression.kind == ExpressionKind::Index) {
            true -> inner(syntax, expression, depth, walked)
            _ -> answer(depth)
        }
    }

    state inner(syntax: &SyntaxTrees, expression: Expression, depth: u64 in Trapping, walked: u64 in Trapping) -> u64 in Trapping {
        transition expression.kind == ExpressionKind::Field {
            true -> step(syntax, expression.left, depth + 1, walked + 1)
            _ -> step(syntax, expression.left, depth, walked + 1)
        }
    }

    state answer(depth: u64 in Trapping) -> u64 in Trapping {
        depth
    }
}

// The place `steps` field steps above `handle` toward its root, past
// indexes.
machine Checker::place_ancestor(syntax: &SyntaxTrees, handle: u64 in Trapping, steps: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> step(syntax, handle, steps, 0) }

    state step(syntax: &SyntaxTrees, node: u64 in Trapping, remaining: u64 in Trapping, walked: u64 in Trapping) -> u64 in Trapping {
        let expression: Expression = SyntaxTrees::expression(syntax, node);
        transition remaining > 0 && walked < 64 {
            true -> inner(syntax, node, expression, remaining, walked)
            _ -> answer(node)
        }
    }

    state inner(syntax: &SyntaxTrees, node: u64 in Trapping, expression: Expression, remaining: u64 in Trapping, walked: u64 in Trapping) -> u64 in Trapping {
        transition expression.kind {
            ExpressionKind::Field -> step(syntax, expression.left, remaining - 1, walked + 1)
            ExpressionKind::Index -> step(syntax, expression.left, remaining, walked + 1)
            _ -> answer(node)
        }
    }

    state answer(node: u64 in Trapping) -> u64 in Trapping {
        node
    }
}

// Whether two place expressions of one depth name the same path: the same
// field at every step and alike indexes, down to the same root, which a
// reference may lie above when `through` holds. Indexes are alike unless
// both are integer literals of different values.
machine Checker::same_field_path(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, left: u64 in Trapping, right: u64 in Trapping, through: bool) -> bool
crashes Trap
{
    transition { _ -> step(syntax, resolution, typing, left, right, through, 0) }

    state step(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, left: u64 in Trapping, right: u64 in Trapping, through: bool, walked: u64 in Trapping) -> bool {
        let left_expression: Expression = SyntaxTrees::expression(syntax, left);
        let right_expression: Expression = SyntaxTrees::expression(syntax, right);
        let both_indexes: bool = left_expression.kind == ExpressionKind::Index && right_expression.kind == ExpressionKind::Index;
        transition both_indexes && walked < 64 {
            true -> indexes(syntax, resolution, typing, left_expression, right_expression, through, walked)
            _ -> unindexed(syntax, resolution, typing, left, right, through, walked)
        }
    }

    state indexes(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        left_expression: Expression,
        right_expression: Expression,
        through: bool,
        walked: u64 in Trapping
    ) -> bool {
        let distinct: bool = Checker::distinct_indexes(syntax, typing, left_expression.right, right_expression.right);
        transition distinct {
            true -> answer(false)
            _ -> step(syntax, resolution, typing, left_expression.left, right_expression.left, through, walked + 1)
        }
    }

    state unindexed(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, left: u64 in Trapping, right: u64 in Trapping, through: bool, walked: u64 in Trapping) -> bool {
        let left_node: u64 in Trapping = Checker::skip_indexes(syntax, left);
        let right_node: u64 in Trapping = Checker::skip_indexes(syntax, right);
        let left_expression: Expression = SyntaxTrees::expression(syntax, left_node);
        let right_expression: Expression = SyntaxTrees::expression(syntax, right_node);
        let both_fields: bool = left_expression.kind == ExpressionKind::Field && right_expression.kind == ExpressionKind::Field;
        transition both_fields && walked < 64 {
            true -> fields(syntax, resolution, typing, left_node, right_node, left_expression, right_expression, through, walked)
            _ -> roots(syntax, resolution, typing, left_node, right_node, through)
        }
    }

    state fields(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        left_node: u64 in Trapping,
        right_node: u64 in Trapping,
        left_expression: Expression,
        right_expression: Expression,
        through: bool,
        walked: u64 in Trapping
    ) -> bool {
        let left_field: u64 in Trapping = Checker::selected_field(typing, left_node);
        let right_field: u64 in Trapping = Checker::selected_field(typing, right_node);
        transition left_field == right_field {
            true -> step(syntax, resolution, typing, left_expression.left, right_expression.left, through, walked + 1)
            _ -> answer(false)
        }
    }

    state roots(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, left_node: u64 in Trapping, right_node: u64 in Trapping, through: bool) -> bool {
        let left_root: u64 in Trapping = Checker::path_root(syntax, resolution, typing, left_node, through);
        let right_root: u64 in Trapping = Checker::path_root(syntax, resolution, typing, right_node, through);
        let left_expression: Expression = SyntaxTrees::expression(syntax, left_node);
        let right_expression: Expression = SyntaxTrees::expression(syntax, right_node);
        let same: bool = left_expression.kind == ExpressionKind::Name && right_expression.kind == ExpressionKind::Name
            && left_root > 0 && left_root == right_root;
        transition { _ -> answer(same) }
    }

    state answer(same: bool) -> bool {
        same
    }
}

// Whether two index operands are integer literals of different values.
pub machine Checker::distinct_indexes(syntax: &SyntaxTrees, typing: &Typing, left: u64 in Trapping, right: u64 in Trapping) -> bool
crashes Trap
{
    let left_expression: Expression = SyntaxTrees::expression(syntax, left);
    let right_expression: Expression = SyntaxTrees::expression(syntax, right);
    let literals: bool = left_expression.kind == ExpressionKind::Integer && right_expression.kind == ExpressionKind::Integer;
    transition literals {
        true -> compared(typing, left, right)
        _ -> answer(false)
    }

    state compared(typing: &Typing, left: u64 in Trapping, right: u64 in Trapping) -> bool {
        let left_value: ExactInteger = Typing::value(typing, left);
        let right_value: ExactInteger = Typing::value(typing, right);
        let below: bool = ExactInteger::at_most(left_value, right_value);
        let above: bool = ExactInteger::at_most(right_value, left_value);
        let distinct: bool = !(below && above);
        transition { _ -> answer(distinct) }
    }

    state answer(distinct: bool) -> bool {
        distinct
    }
}

// The node below any indexes at `handle`.
machine Checker::skip_indexes(syntax: &SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> step(syntax, handle, 0) }

    state step(syntax: &SyntaxTrees, node: u64 in Trapping, walked: u64 in Trapping) -> u64 in Trapping {
        let expression: Expression = SyntaxTrees::expression(syntax, node);
        transition expression.kind == ExpressionKind::Index && walked < 64 {
            true -> step(syntax, expression.left, walked + 1)
            _ -> answer(node)
        }
    }

    state answer(node: u64 in Trapping) -> u64 in Trapping {
        node
    }
}

// The field a field expression selects, plus one; zero for any other.
machine Checker::selected_field(typing: &Typing, node: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let selection: Selection = Typing::selection(typing, node);
    transition selection {
        Selection::Field { field } -> answer(field + 1)
        _ -> answer(0)
    }

    state answer(field: u64 in Trapping) -> u64 in Trapping {
        field
    }
}

// How two places relate: the place `other` contains the place `used` or is
// it (`Inside`), lies inside it (`Encloses`), or neither.
pub data PlaceRelation [copy] {
    case Apart;
    case Inside;
    case Encloses;
}

// How a used place relates to a moved one, owned roots only.
pub machine Checker::place_relation(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, used: u64 in Trapping, moved: u64 in Trapping) -> PlaceRelation
crashes Trap
{
    Checker::path_relation(syntax, resolution, typing, used, moved, false)
}

// How two places relate, their roots reached through references when
// `through` holds.
pub machine Checker::path_relation(
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    used: u64 in Trapping,
    other: u64 in Trapping,
    through: bool
) -> PlaceRelation
crashes Trap
{
    let used_root: u64 in Trapping = Checker::path_root(syntax, resolution, typing, used, through);
    let other_root: u64 in Trapping = Checker::path_root(syntax, resolution, typing, other, through);
    let used_depth: u64 in Trapping = Checker::place_depth(syntax, used);
    let other_depth: u64 in Trapping = Checker::place_depth(syntax, other);
    transition used_root > 0 && used_root == other_root {
        true -> rooted(syntax, resolution, typing, used, other, used_depth, other_depth, through)
        _ -> answer(PlaceRelation::Apart)
    }

    state rooted(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        used: u64 in Trapping,
        other: u64 in Trapping,
        used_depth: u64 in Trapping,
        other_depth: u64 in Trapping,
        through: bool
    ) -> PlaceRelation {
        transition used_depth >= other_depth {
            true -> within(syntax, resolution, typing, used, other, used_depth - other_depth, through)
            _ -> around(syntax, resolution, typing, used, other, other_depth - used_depth, through)
        }
    }

    state within(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        used: u64 in Trapping,
        other: u64 in Trapping,
        steps: u64 in Trapping,
        through: bool
    ) -> PlaceRelation {
        let ancestor: u64 in Trapping = Checker::place_ancestor(syntax, used, steps);
        let same: bool = Checker::same_field_path(syntax, resolution, typing, ancestor, other, through);
        transition same {
            true -> answer(PlaceRelation::Inside)
            _ -> answer(PlaceRelation::Apart)
        }
    }

    state around(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        used: u64 in Trapping,
        other: u64 in Trapping,
        steps: u64 in Trapping,
        through: bool
    ) -> PlaceRelation {
        let ancestor: u64 in Trapping = Checker::place_ancestor(syntax, other, steps);
        let same: bool = Checker::same_field_path(syntax, resolution, typing, used, ancestor, through);
        transition same {
            true -> answer(PlaceRelation::Encloses)
            _ -> answer(PlaceRelation::Apart)
        }
    }

    state answer(relation: PlaceRelation) -> PlaceRelation {
        relation
    }
}

// Whether a place expression reaches its value through a reference: a
// field or an index whose base, at any step, is a reference.
// Whether a place is, or is reached through, a write-only reference: the
// place itself, or a field (a `.len` selection reads metadata, not the
// referent) or element base along its path, of type `&write T`.
pub machine Checker::through_write_only(syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> step(syntax, typing, handle, 0) }

    state step(syntax: &SyntaxTrees, typing: &Typing, node: u64 in Trapping, walked: u64 in Trapping) -> bool {
        let expression: Expression = SyntaxTrees::expression(syntax, node);
        let node_type: u64 in Trapping = Typing::expression_type(typing, node);
        let row: TypeRow = TypeTable::row(&typing.types, node_type);
        let write_only: bool = row.kind == TypeKind::Reference && row.access == ReferenceAccess::WriteOnly;
        let field: bool = Checker::field_place(typing, node, expression);
        let projected: bool = field || expression.kind == ExpressionKind::Index;
        transition write_only {
            true -> answer(true)
            _ -> deeper(syntax, typing, expression.left, walked, projected)
        }
    }

    state deeper(syntax: &SyntaxTrees, typing: &Typing, base: u64 in Trapping, walked: u64 in Trapping, projected: bool) -> bool {
        transition projected && walked < 64 {
            true -> step(syntax, typing, base, walked + 1)
            _ -> answer(false)
        }
    }

    state answer(through: bool) -> bool {
        through
    }
}

pub machine Checker::borrowed_place(syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> step(syntax, typing, handle, 0) }

    state step(syntax: &SyntaxTrees, typing: &Typing, node: u64 in Trapping, walked: u64 in Trapping) -> bool {
        let expression: Expression = SyntaxTrees::expression(syntax, node);
        let projected: bool = expression.kind == ExpressionKind::Field || expression.kind == ExpressionKind::Index;
        transition projected && walked < 64 {
            true -> base(syntax, typing, expression.left, walked)
            _ -> answer(false)
        }
    }

    state base(syntax: &SyntaxTrees, typing: &Typing, base: u64 in Trapping, walked: u64 in Trapping) -> bool {
        let base_type: u64 in Trapping = Typing::expression_type(typing, base);
        let row: TypeRow = TypeTable::row(&typing.types, base_type);
        transition row.kind == TypeKind::Reference {
            true -> answer(true)
            _ -> step(syntax, typing, base, walked + 1)
        }
    }

    state answer(borrowed: bool) -> bool {
        borrowed
    }
}

// Whether two place expressions name one place: one root, one depth and the
// same field at every step.
pub machine Checker::same_owned_place(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, left: u64 in Trapping, right: u64 in Trapping) -> bool
crashes Trap
{
    transition left == right {
        true -> answer(true)
        _ -> compared(syntax, resolution, typing, left, right)
    }

    state compared(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, left: u64 in Trapping, right: u64 in Trapping) -> bool {
        let relation: PlaceRelation = Checker::place_relation(syntax, resolution, typing, left, right);
        let left_depth: u64 in Trapping = Checker::place_depth(syntax, left);
        let right_depth: u64 in Trapping = Checker::place_depth(syntax, right);
        let same: bool = relation == PlaceRelation::Inside && left_depth == right_depth;
        transition { _ -> answer(same) }
    }

    state answer(same: bool) -> bool {
        same
    }
}
