use psi::checking::aliases;
use psi::checking::checker;
use psi::checking::flow;
use psi::checking::evaluation;
use psi::checking::facts;
use psi::checking::frames;
use psi::checking::obligations;
use psi::checking::places;
use psi::checking::zone;
use psi::integers::integers;
use psi::syntax::syntax;
use psi::types::types;

// Operands captured before a later operand writes what they read
// (wiki/spec/language/state_contracts.md#mutation-and-subject-identity:
// "Copies transport facts about the captured value, not source expressions
// to be reevaluated after mutation"). A call that may write a place it
// receives exclusively runs after the operands evaluated before it: its own
// and the earlier operands of every expression around it. Before the call
// forgets what is known of that place, each such operand whose value reads
// it moves to a snapshot keyed by the lending operand: an integer to a
// fresh subject equal to the one it read, a record to a place holding the
// fields known of it. Any other value keeps its interval and loses its
// place. A reference denotes live storage, not its former contents, and
// keeps its place; a Read adaptation instead consumes a scalar snapshot.
// Every exclusive operand the call writes through keeps its live place.

// A call's write footprint. Named frames apply to field identities along
// a scalar's path; whole/unknown frames apply to the entire referent.
pub data WriteFootprint [copy] {
    place: u64 in Trapping;
    callee: u64 in Trapping;
    whole: bool;
}

// Whether a represented scalar lies under a written field. Aggregate
// operands are captured separately: their written fields can still be
// pending, or completely unrepresented until a later contract reads them.
machine Checker::written_subject(checker: &Checker, subject: u64 in Trapping, write: WriteFootprint) -> bool
crashes Trap
{
    let inside: bool = Checker::within(checker, subject, write.place);
    transition inside {
        true -> step(checker, subject, write)
        _ -> no()
    }

    state step(checker: &Checker, current: u64 in Trapping, write: WriteFootprint) -> bool {
        transition write.whole {
            true -> yes()
            _ -> narrow(checker, current, write)
        }
    }

    state narrow(checker: &Checker, current: u64 in Trapping, write: WriteFootprint) -> bool {
        transition current > 0 && current != write.place {
            true -> inspect(checker, current, write)
            _ -> no()
        }
    }

    state inspect(checker: &Checker, current: u64 in Trapping, write: WriteFootprint) -> bool {
        let entry: Place = Checker::place_at(checker, current - 1);
        let written: bool = entry.kind == PlaceKind::Field && Checker::writes_field(checker, write.callee, entry.handle);
        transition written {
            true -> yes()
            _ -> step(checker, entry.parent, write)
        }
    }

    state yes() -> bool { true }
    state no() -> bool { false }
}

// Snapshot every operand evaluated before the call `expression` whose value
// reads the storage in `write`, lent exclusively by operand `lender`.
pub machine Checker::snapshot_operands(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    typing: &Typing,
    expression: Expression,
    lender: u64 in Trapping,
    write: WriteFootprint
)
crashes Trap
{
    transition { _ -> own(checker, syntax, typing, expression, lender, write, 0) }

    state own(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, lender: u64 in Trapping, write: WriteFootprint, offset: u64 in Trapping) {
        let count: u64 in Trapping = Checker::operand_count(expression);
        transition offset < count {
            true -> operand(checker, syntax, typing, expression, lender, write, offset)
            _ -> earlier(checker, syntax, typing, expression, lender, write)
        }
    }

    state operand(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, lender: u64 in Trapping, write: WriteFootprint, offset: u64 in Trapping) {
        let handle: u64 in Trapping = Checker::operand(syntax, expression, offset);
        Checker::snapshot_tree(checker, syntax, typing, handle, lender, write);
        transition { _ -> own(checker, syntax, typing, expression, lender, write, offset + 1) }
    }

    // The operands before the call's subtree that no node evaluated since
    // has taken: walking back, each is the root of the subtree that ends
    // just before the previous one starts.
    state earlier(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, lender: u64 in Trapping, write: WriteFootprint) {
        transition expression.first_row > checker.tree_low {
            true -> pending(checker, syntax, typing, lender, write, expression.first_row - 1)
            _ -> done()
        }
    }

    state pending(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, lender: u64 in Trapping, write: WriteFootprint, root: u64 in Trapping) {
        let tree: Expression = SyntaxTrees::expression(syntax, root);
        Checker::snapshot_tree(checker, syntax, typing, root, lender, write);
        transition tree.first_row > checker.tree_low {
            true -> pending(checker, syntax, typing, lender, write, tree.first_row - 1)
            _ -> done()
        }
    }

    state done() {}
}

// Facts may later inspect a completed operand's children: assuming a
// comparison uses its two reads, even after the comparison itself became a
// Boolean. Capture every evaluated descendant, not just the operand root.
// The caller supplies completed subtrees only; later nodes have no values.
machine Checker::snapshot_tree(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint)
crashes Trap
{
    let tree: Expression = SyntaxTrees::expression(syntax, root);
    transition { _ -> node(checker, typing, root, lender, write, tree.first_row) }

    state node(checker: &mut Checker, typing: &Typing, root: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, handle: u64 in Trapping) {
        transition handle <= root {
            true -> captured(checker, typing, root, lender, write, handle)
            _ -> done()
        }
    }

    state captured(checker: &mut Checker, typing: &Typing, root: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, handle: u64 in Trapping) {
        Checker::snapshot_node(checker, typing, handle, lender, write);
        transition { _ -> node(checker, typing, root, lender, write, handle + 1) }
    }

    state done() {}
}

// Capture one completed node before a write overlaps its value. Records
// retain the complete known/pending field tree even when the written field
// has no place yet. Scalar reads use the frame along their existing path;
// snapshotting a disjoint scalar on one short-circuit path loses its live
// equality at the join, despite the call preserving that scalar.
machine Checker::snapshot_node(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint)
crashes Trap
{
    transition handle >= checker.tree_low {
        true -> evaluated(checker, typing, handle, lender, write, handle - checker.tree_low)
        _ -> done()
    }

    // Only a node of the open tree has a value.
    state evaluated(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, offset: u64 in Trapping) {
        let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
        let row: TypeRow = TypeTable::row(&typing.types, type_handle);
        let adaptation: Adaptation = Typing::adaptation(typing, handle);
        let read: bool = row.kind != TypeKind::Reference || adaptation == Adaptation::Read;
        transition offset < checker.tree_size && read {
            true -> valued(checker, typing, handle, lender, write, type_handle, row)
            _ -> done()
        }
    }

    state valued(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, type_handle: u64 in Trapping, row: TypeRow) {
        let value: Value = Checker::value_at(checker, handle);
        transition value.known && value.subject > 0 {
            true -> term(checker, typing, handle, lender, write, value)
            _ -> placed(checker, typing, handle, lender, write, type_handle, row, value)
        }
    }

    state term(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, value: Value) {
        let owner: u64 in Trapping = Checker::subject_place(checker, value.subject);
        let reads: bool = owner > 0 && Checker::written_subject(checker, owner, write);
        transition reads {
            true -> integer(checker, typing, handle, lender, value, owner)
            _ -> done()
        }
    }

    state integer(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, lender: u64 in Trapping, value: Value, owner: u64 in Trapping) {
        let read: Place = Checker::place_at(checker, owner - 1);
        let snapshot: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Snapshot, lender, owner, read.type_handle);
        transition snapshot > 0 {
            true -> numbered(checker, handle, value, snapshot)
            _ -> unplaced(checker, handle, value)
        }
    }

    state numbered(checker: &mut Checker, handle: u64 in Trapping, value: Value, snapshot: u64 in Trapping) {
        let entry: Place = Checker::place_at(checker, snapshot - 1);
        transition entry.subject > 0 {
            true -> captured(checker, handle, value, snapshot, entry.subject)
            _ -> unplaced(checker, handle, value)
        }
    }

    // The snapshot's subject equals the one read: captured - read <= 0 and
    // read - captured <= 0. Every operand reading that subject at this call
    // shares the snapshot.
    state captured(checker: &mut Checker, handle: u64 in Trapping, value: Value, snapshot: u64 in Trapping, subject: u64 in Trapping) {
        let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
        let unknown: Value = Value::unknown();
        let own: Value = Value { place: 0, known: true, subject: subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        let read: Value = Value { place: 0, known: true, subject: value.subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        Zone::forget(&mut checker.zone, subject);
        Checker::constrain_difference(checker, own, read, zero);
        Checker::constrain_difference(checker, read, own, zero);
        let exact: bool = value.place > 0 && value.offset.magnitude == 0;
        transition exact {
            true -> moved(checker, handle, value, snapshot, subject)
            _ -> moved(checker, handle, value, 0, subject)
        }
    }

    state moved(checker: &mut Checker, handle: u64 in Trapping, value: Value, snapshot: u64 in Trapping, subject: u64 in Trapping) {
        Checker::set_value(checker, handle, Value { place: snapshot, known: true, subject: subject, offset: value.offset, ceiling: value.ceiling, floor: value.floor });
    }

    state placed(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, type_handle: u64 in Trapping, row: TypeRow, value: Value) {
        let reads: bool = value.place > 0 && (Checker::within(checker, value.place, write.place) || Checker::within(checker, write.place, value.place));
        transition reads {
            true -> shaped(checker, typing, handle, lender, type_handle, row, value)
            _ -> done()
        }
    }

    state shaped(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, lender: u64 in Trapping, type_handle: u64 in Trapping, row: TypeRow, value: Value) {
        transition row.kind == TypeKind::Data {
            true -> record(checker, typing, handle, lender, type_handle, value)
            _ -> unplaced(checker, handle, value)
        }
    }

    // A record's snapshot holds the fields known of what it read.
    state record(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, lender: u64 in Trapping, type_handle: u64 in Trapping, value: Value) {
        let snapshot: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Snapshot, lender, value.place, type_handle);
        transition snapshot > 0 {
            true -> fields(checker, typing, handle, value, snapshot)
            _ -> unplaced(checker, handle, value)
        }
    }

    state fields(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, value: Value, snapshot: u64 in Trapping) {
        Checker::forget_place(checker, typing, snapshot);
        Checker::copy_fields(checker, typing, snapshot, value.place);
        Checker::set_value(checker, handle, Value { place: snapshot, known: value.known, subject: 0, offset: value.offset, ceiling: value.ceiling, floor: value.floor });
    }

    state unplaced(checker: &mut Checker, handle: u64 in Trapping, value: Value) {
        Checker::set_value(checker, handle, Value { place: 0, known: false, subject: 0, offset: value.offset, ceiling: value.ceiling, floor: value.floor });
    }

    state done() {}
}

// Retain the evaluated dispatch subject before exploring either arm. Its
// scratch window is separate from later guards/targets; value facts use the
// same snapshots as call operands, so writes cannot reinterpret old reads.
// Snapshotting is performed once before the arm zone is saved.
pub machine Checker::capture_subject(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, present: bool) -> CapturedSubject
crashes Trap
{
    let frame: TreeFrame = Checker::tree_frame(checker);
    let captured: CapturedSubject = CapturedSubject { frame: frame, floor: checker.retained_values };
    transition present && checker.output.machine_accepted {
        true -> retain(checker, syntax, typing, root, captured)
        _ -> done(captured)
    }

    state retain(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, captured: CapturedSubject) -> CapturedSubject {
        checker.retained_values = captured.frame.base + captured.frame.size;
        transition { _ -> node(checker, syntax, typing, root, captured, captured.frame.low) }
    }

    state node(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, captured: CapturedSubject, handle: u64 in Trapping) -> CapturedSubject {
        transition handle <= root {
            true -> valued(checker, syntax, typing, root, captured, handle)
            _ -> done(captured)
        }
    }

    state valued(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, captured: CapturedSubject, handle: u64 in Trapping) -> CapturedSubject {
        let value: Value = Checker::value_at(checker, handle);
        transition value.known && value.subject > 0 {
            true -> term(checker, syntax, typing, root, captured, handle, value)
            _ -> placed(checker, syntax, typing, root, captured, handle, value, value.place)
        }
    }

    state term(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, captured: CapturedSubject, handle: u64 in Trapping, value: Value) -> CapturedSubject {
        let place: u64 in Trapping = Checker::subject_place(checker, value.subject);
        transition { _ -> placed(checker, syntax, typing, root, captured, handle, value, place) }
    }

    state placed(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, captured: CapturedSubject, handle: u64 in Trapping, value: Value, place: u64 in Trapping) -> CapturedSubject {
        transition place > 0 {
            true -> snapshotted(checker, syntax, typing, root, captured, handle, value, place)
            _ -> node(checker, syntax, typing, root, captured, handle + 1)
        }
    }

    state snapshotted(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, captured: CapturedSubject, handle: u64 in Trapping, value: Value, place: u64 in Trapping) -> CapturedSubject {
        let write: WriteFootprint = WriteFootprint { place: place, callee: 0, whole: true };
        Checker::snapshot_node(checker, typing, handle, root, write);
        let saved: Value = Checker::value_at(checker, handle);
        Checker::copy_alias(checker, value.place, saved.place);
        transition { _ -> node(checker, syntax, typing, root, captured, handle + 1) }
    }

    state done(captured: CapturedSubject) -> CapturedSubject { captured }
}
