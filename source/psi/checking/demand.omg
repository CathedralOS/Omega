use psi::checking::arrivals;
use psi::checking::checker;
use psi::checking::contracts;
use psi::checking::domains;
use psi::checking::obligations;
use psi::checking::places;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// Arrival demand. A jump projects onto its target state the facts of field
// paths below the state's parameters (arrivals.omg), at most 40 per state.
// Projecting whatever the jumping body touched first loses the facts the
// target needs once a wide value fills the slots (a parser state that read
// two dozen fields before its guard), so each state's paths are derived,
// before its machine's facts are gathered, from what needs them:
//
// - the integer and Boolean fields and lengths its own statements read
//   below its parameters, a slice's length wherever it indexes one;
// - what each state it jumps to demands below the parameter it passes,
//   behind the path the argument names (`next(p)` passes the target's
//   demand on `p` through, `next(&mut p.output)` prefixes it with `output`);
// - what each machine it calls reads below a parameter in its `requires`
//   facts, behind the path the argument names;
// - the fields a data declaration's `where` fact names beside a demanded
//   field, whose relation a store into that field must keep.
//
// Demand settles over a machine's states to a fixed point; a path beyond a
// state's 40 arrives unknown.
pub machine Checker::derive_demand(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem)
crashes Trap
{
    transition { _ -> round(checker, syntax, resolution, typing, item) }

    state round(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem) {
        transition { _ -> next(checker, syntax, resolution, typing, item, 0, false) }
    }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, changed: bool) {
        transition offset < item.state_count {
            true -> member_state(checker, syntax, resolution, typing, item, offset, changed)
            _ -> settled(checker, syntax, resolution, typing, item, changed)
        }
    }

    state member_state(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, changed: bool) {
        let body: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        let read: bool = Checker::demand_statements(checker, syntax, resolution, typing, item, offset, body);
        let related: bool = Checker::demand_siblings(checker, syntax, resolution, typing, offset);
        transition { _ -> next(checker, syntax, resolution, typing, item, offset + 1, changed || read || related) }
    }

    state settled(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, changed: bool) {
        transition changed {
            true -> round(checker, syntax, resolution, typing, item)
            _ -> done()
        }
    }

    state done() {}
}

// A member path below a parameter in a range: whether the expression names
// one (a parameter itself has depth zero), and the path.
pub data MemberChain [copy] {
    rooted: bool;
    path: ArrivalPath;
}

// The member path `handle` names: field and `.len` steps (and borrows) down
// to a name bound to a parameter from `first_parameter` (`parameter_count`
// of them), at most four steps.
pub machine Checker::member_chain(
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    handle: u64 in Trapping,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping
) -> MemberChain
crashes Trap
{
    let empty: ArrivalStep = ArrivalStep { length: false, field: 0, type_handle: 0 };
    let none: ArrivalPath = ArrivalPath { parameter: 0, depth: 0, step0: empty, step1: empty, step2: empty, step3: empty };
    transition { _ -> walk(syntax, resolution, typing, handle, first_parameter, parameter_count, none, 0) }

    // Steps collect outermost first and are reversed at the root.
    state walk(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        current: u64 in Trapping,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        path: ArrivalPath,
        count: u64 in Trapping
    ) -> MemberChain {
        let expression: Expression = SyntaxTrees::expression(syntax, current);
        transition expression.kind {
            ExpressionKind::Field -> member(syntax, resolution, typing, current, expression, first_parameter, parameter_count, path, count)
            ExpressionKind::Unary -> borrowed(syntax, resolution, typing, expression, first_parameter, parameter_count, path, count)
            ExpressionKind::Name -> root(resolution, current, first_parameter, parameter_count, path, count)
            _ -> unrooted(path)
        }
    }

    state member(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        current: u64 in Trapping,
        expression: Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        path: ArrivalPath,
        count: u64 in Trapping
    ) -> MemberChain {
        let selection: Selection = Typing::selection(typing, current);
        let type_handle: u64 in Trapping = Typing::expression_type(typing, current);
        transition selection {
            Selection::Field { field } -> stepped(syntax, resolution, typing, expression, first_parameter, parameter_count, path, count, ArrivalStep { length: false, field: field, type_handle: type_handle })
            Selection::Length -> stepped(syntax, resolution, typing, expression, first_parameter, parameter_count, path, count, ArrivalStep { length: true, field: 0, type_handle: type_handle })
            _ -> unrooted(path)
        }
    }

    state stepped(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        expression: Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        path: ArrivalPath,
        count: u64 in Trapping,
        step: ArrivalStep
    ) -> MemberChain {
        transition count < 4 {
            true -> extended(syntax, resolution, typing, expression, first_parameter, parameter_count, path, count, step)
            _ -> unrooted(path)
        }
    }

    state extended(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        expression: Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        path: ArrivalPath,
        count: u64 in Trapping,
        step: ArrivalStep
    ) -> MemberChain {
        let longer: ArrivalPath = ArrivalPath::with_step(path, count, step);
        transition { _ -> walk(syntax, resolution, typing, expression.left, first_parameter, parameter_count, longer, count + 1) }
    }

    state borrowed(
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        expression: Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        path: ArrivalPath,
        count: u64 in Trapping
    ) -> MemberChain {
        let borrow: bool = expression.operator == OperatorKind::BorrowMutable || expression.operator == OperatorKind::Borrow
            || expression.operator == OperatorKind::BorrowWrite;
        transition borrow {
            true -> walk(syntax, resolution, typing, expression.left, first_parameter, parameter_count, path, count)
            _ -> unrooted(path)
        }
    }

    state root(resolution: &NameResolution, current: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, path: ArrivalPath, count: u64 in Trapping) -> MemberChain {
        let binding: ValueBinding = NameResolution::value_binding(resolution, current);
        transition binding {
            ValueBinding::Parameter { parameter } -> parameter(first_parameter, parameter_count, path, count, parameter)
            _ -> unrooted(path)
        }
    }

    state parameter(first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, path: ArrivalPath, count: u64 in Trapping, parameter: u64 in Trapping) -> MemberChain {
        transition parameter >= first_parameter && parameter - first_parameter < parameter_count {
            true -> rooted(path, count, parameter - first_parameter)
            _ -> unrooted(path)
        }
    }

    state rooted(path: ArrivalPath, count: u64 in Trapping, offset: u64 in Trapping) -> MemberChain {
        let mut ordered: ArrivalPath = ArrivalPath::reversed(path, count);
        ordered.parameter = offset;
        MemberChain { rooted: true, path: ordered }
    }

    state unrooted(path: ArrivalPath) -> MemberChain {
        MemberChain { rooted: false, path: path }
    }
}

// `prefix` followed by `suffix`'s steps, below `prefix`'s parameter; depth
// zero when together they pass four steps.
pub machine ArrivalPath::joined(prefix: ArrivalPath, suffix: ArrivalPath) -> ArrivalPath
crashes Trap
{
    transition prefix.depth + suffix.depth <= 4 {
        true -> next(prefix, suffix, 0)
        _ -> overlong(prefix)
    }

    state next(path: ArrivalPath, suffix: ArrivalPath, index: u64 in Trapping) -> ArrivalPath {
        transition index < suffix.depth && index < 4 {
            true -> step(path, suffix, index)
            _ -> finished(path)
        }
    }

    state step(path: ArrivalPath, suffix: ArrivalPath, index: u64 in Trapping) -> ArrivalPath {
        let taken: ArrivalStep = ArrivalPath::step(suffix, index);
        let mut longer: ArrivalPath = ArrivalPath::with_step(path, path.depth, taken);
        longer.depth = path.depth + 1;
        transition { _ -> next(longer, suffix, index + 1) }
    }

    state finished(path: ArrivalPath) -> ArrivalPath {
        path
    }

    state overlong(prefix: ArrivalPath) -> ArrivalPath {
        let mut none: ArrivalPath = prefix;
        none.depth = 0;
        none
    }
}

// The demand of one state's statements: every tree they evaluate.
machine Checker::demand_statements(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem) -> bool
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, item, offset, body, 0, false) }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, index: u64 in Trapping, changed: bool) -> bool {
        transition index < body.statement_count {
            true -> statement(checker, syntax, resolution, typing, item, offset, body, index, changed)
            _ -> finished(changed)
        }
    }

    state statement(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, index: u64 in Trapping, changed: bool) -> bool {
        let statement: Statement = SyntaxTrees::statement(syntax, body.first_statement + index);
        let valued: bool = Checker::demand_valued(checker, syntax, resolution, typing, item, offset, body, statement);
        let arms: bool = Checker::demand_arms(checker, syntax, resolution, typing, item, offset, body, statement);
        transition { _ -> next(checker, syntax, resolution, typing, item, offset, body, index + 1, changed || valued || arms) }
    }

    state finished(changed: bool) -> bool {
        changed
    }
}

// A statement's value tree, and an assignment's target tree.
machine Checker::demand_valued(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement) -> bool
crashes Trap
{
    let assigned: bool = statement.kind == StatementKind::Assign;
    let evaluated: bool = statement.has_value && statement.kind != StatementKind::Crash;
    transition { _ -> value(checker, syntax, resolution, typing, item, offset, body, statement, assigned, evaluated) }

    state value(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement, assigned: bool, evaluated: bool) -> bool {
        transition evaluated || assigned {
            true -> valued(checker, syntax, resolution, typing, item, offset, body, statement, assigned)
            _ -> target(checker, syntax, resolution, typing, item, offset, body, statement, assigned, false)
        }
    }

    state valued(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement, assigned: bool) -> bool {
        let grew: bool = Checker::demand_tree(checker, syntax, resolution, typing, item, offset, body, statement.value);
        transition { _ -> target(checker, syntax, resolution, typing, item, offset, body, statement, assigned, grew) }
    }

    state target(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement, assigned: bool, changed: bool) -> bool {
        transition assigned {
            true -> targeted(checker, syntax, resolution, typing, item, offset, body, statement, changed)
            _ -> finished(changed)
        }
    }

    state targeted(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement, changed: bool) -> bool {
        let grew: bool = Checker::demand_tree(checker, syntax, resolution, typing, item, offset, body, statement.target);
        changed || grew
    }

    state finished(changed: bool) -> bool {
        changed
    }
}

// A transition's arms: each guard, and each target that is not `{}`.
machine Checker::demand_arms(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement) -> bool
crashes Trap
{
    transition statement.kind == StatementKind::Transition {
        true -> next(checker, syntax, resolution, typing, item, offset, body, statement, 0, false)
        _ -> finished(false)
    }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement, index: u64 in Trapping, changed: bool) -> bool {
        transition index < statement.arm_count {
            true -> arm(checker, syntax, resolution, typing, item, offset, body, statement, index, changed)
            _ -> finished(changed)
        }
    }

    state arm(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement, index: u64 in Trapping, changed: bool) -> bool {
        let arm: TransitionArm = SyntaxTrees::arm(syntax, statement.first_arm + index);
        transition arm.kind == ArmPatternKind::Guard {
            true -> guarded(checker, syntax, resolution, typing, item, offset, body, statement, index, changed, arm)
            _ -> targeted(checker, syntax, resolution, typing, item, offset, body, statement, index, changed, arm)
        }
    }

    state guarded(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement, index: u64 in Trapping, changed: bool, arm: TransitionArm) -> bool {
        let grew: bool = Checker::demand_tree(checker, syntax, resolution, typing, item, offset, body, arm.pattern);
        transition { _ -> targeted(checker, syntax, resolution, typing, item, offset, body, statement, index, changed || grew, arm) }
    }

    state targeted(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement, index: u64 in Trapping, changed: bool, arm: TransitionArm) -> bool {
        transition arm.target_kind != ArmTargetKind::Unit {
            true -> target(checker, syntax, resolution, typing, item, offset, body, statement, index, changed, arm)
            _ -> next(checker, syntax, resolution, typing, item, offset, body, statement, index + 1, changed)
        }
    }

    state target(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, statement: Statement, index: u64 in Trapping, changed: bool, arm: TransitionArm) -> bool {
        let grew: bool = Checker::demand_tree(checker, syntax, resolution, typing, item, offset, body, arm.target);
        transition { _ -> next(checker, syntax, resolution, typing, item, offset, body, statement, index + 1, changed || grew) }
    }

    state finished(changed: bool) -> bool {
        changed
    }
}

// Every node of the tree rooted at `root`.
machine Checker::demand_tree(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, root: u64 in Trapping) -> bool
crashes Trap
{
    let tree: Expression = SyntaxTrees::expression(syntax, root);
    transition { _ -> next(checker, syntax, resolution, typing, item, offset, body, root, tree.first_row, false) }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, root: u64 in Trapping, handle: u64 in Trapping, changed: bool) -> bool {
        transition handle <= root {
            true -> node(checker, syntax, resolution, typing, item, offset, body, root, handle, changed)
            _ -> finished(changed)
        }
    }

    state node(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, root: u64 in Trapping, handle: u64 in Trapping, changed: bool) -> bool {
        let grew: bool = Checker::demand_node(checker, syntax, resolution, typing, item, offset, body, handle);
        transition { _ -> next(checker, syntax, resolution, typing, item, offset, body, root, handle + 1, changed || grew) }
    }

    state finished(changed: bool) -> bool {
        changed
    }
}

// One node: an integer member read below a parameter is demanded; a jump
// passes its target's demand back, and a machine call its callee's
// `requires` reads.
machine Checker::demand_node(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, handle: u64 in Trapping) -> bool
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, handle);
    let selection: Selection = Typing::selection(typing, handle);
    transition expression.kind {
        ExpressionKind::Field -> read(checker, syntax, resolution, typing, offset, body, handle)
        ExpressionKind::Index -> indexed(checker, syntax, resolution, typing, offset, body, expression)
        ExpressionKind::Call -> called(checker, syntax, resolution, typing, item, offset, body, expression, selection)
        ExpressionKind::Binary -> called(checker, syntax, resolution, typing, item, offset, body, expression, selection)
        _ -> unchanged()
    }

    state read(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, body: StateItem, handle: u64 in Trapping) -> bool {
        let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
        let carrier: BuiltinType = Checker::carrier(typing, type_handle);
        let integer: bool = Checker::has_subject(carrier);
        let chain: MemberChain = Checker::member_chain(syntax, resolution, typing, handle, body.first_parameter, body.parameter_count);
        transition integer && chain.rooted && chain.path.depth > 0 {
            true -> demanded(checker, offset, chain.path)
            _ -> unchanged()
        }
    }

    state demanded(checker: &mut Checker, offset: u64 in Trapping, path: ArrivalPath) -> bool {
        let added: bool = Checker::add_arrival_path(checker, offset, path);
        added
    }

    // Indexing a slice reads its length, as the bounds check does.
    state indexed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, body: StateItem, expression: Expression) -> bool {
        let collection: TypeRow = Checker::collection_row(typing, expression.left);
        let chain: MemberChain = Checker::member_chain(syntax, resolution, typing, expression.left, body.first_parameter, body.parameter_count);
        let empty: ArrivalStep = ArrivalStep { length: false, field: 0, type_handle: 0 };
        let length: ArrivalStep = ArrivalStep { length: true, field: 0, type_handle: 0 };
        let suffix: ArrivalPath = ArrivalPath { parameter: 0, depth: 1, step0: length, step1: empty, step2: empty, step3: empty };
        let lengthed: ArrivalPath = ArrivalPath::joined(chain.path, suffix);
        transition collection.kind == TypeKind::Slice {
            true -> sliced(checker, offset, chain.rooted, lengthed)
            _ -> unchanged()
        }
    }

    state sliced(checker: &mut Checker, offset: u64 in Trapping, rooted: bool, path: ArrivalPath) -> bool {
        let added: bool = Checker::add_rooted(checker, offset, rooted, path);
        added
    }

    state called(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, expression: Expression, selection: Selection) -> bool {
        transition selection {
            Selection::State { handle } -> jump(checker, syntax, resolution, typing, item, offset, body, expression, handle)
            Selection::Machine { handle } -> callee(checker, syntax, resolution, typing, offset, body, expression, selection)
            Selection::Binder { parameter } -> callee(checker, syntax, resolution, typing, offset, body, expression, selection)
            _ -> unchanged()
        }
    }

    state jump(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping, body: StateItem, expression: Expression, target_state: u64 in Trapping) -> bool {
        transition target_state >= item.first_state && target_state - item.first_state < item.state_count {
            true -> passed(checker, syntax, resolution, typing, offset, body, expression, target_state - item.first_state)
            _ -> unchanged()
        }
    }

    state passed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, body: StateItem, expression: Expression, target: u64 in Trapping) -> bool {
        let grew: bool = Checker::demand_successor(checker, syntax, resolution, typing, offset, body, expression, target);
        grew
    }

    state callee(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, body: StateItem, expression: Expression, selection: Selection) -> bool {
        let clauses: CallClauses = Checker::call_clauses(syntax, resolution, selection);
        let grew: bool = Checker::demand_callee(checker, syntax, resolution, typing, offset, body, expression, clauses);
        grew
    }

    state unchanged() -> bool {
        false
    }
}

// Each path state `target` demands below its parameter `k`, behind the path
// the jump's argument `k` names below this state's parameters.
machine Checker::demand_successor(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, body: StateItem, expression: Expression, target: u64 in Trapping) -> bool
crashes Trap
{
    let count: u64 in Trapping = Checker::path_count(checker, target);
    transition { _ -> next(checker, syntax, resolution, typing, offset, body, expression, target, count, 0, false) }

    state next(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        offset: u64 in Trapping,
        body: StateItem,
        expression: Expression,
        target: u64 in Trapping,
        count: u64 in Trapping,
        index: u64 in Trapping,
        changed: bool
    ) -> bool {
        transition index < count && index < 40 {
            true -> path(checker, syntax, resolution, typing, offset, body, expression, target, count, index, changed)
            _ -> finished(changed)
        }
    }

    state path(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        offset: u64 in Trapping,
        body: StateItem,
        expression: Expression,
        target: u64 in Trapping,
        count: u64 in Trapping,
        index: u64 in Trapping,
        changed: bool
    ) -> bool {
        let wanted: ArrivalPath = Checker::arrival_path(checker, target, index);
        transition wanted.parameter < expression.count {
            true -> argument(checker, syntax, resolution, typing, offset, body, expression, target, count, index, changed, wanted)
            _ -> next(checker, syntax, resolution, typing, offset, body, expression, target, count, index + 1, changed)
        }
    }

    state argument(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        offset: u64 in Trapping,
        body: StateItem,
        expression: Expression,
        target: u64 in Trapping,
        count: u64 in Trapping,
        index: u64 in Trapping,
        changed: bool,
        wanted: ArrivalPath
    ) -> bool {
        let handle: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + wanted.parameter);
        let chain: MemberChain = Checker::member_chain(syntax, resolution, typing, handle, body.first_parameter, body.parameter_count);
        let behind: ArrivalPath = ArrivalPath::joined(chain.path, wanted);
        let added: bool = Checker::add_rooted(checker, offset, chain.rooted, behind);
        transition { _ -> next(checker, syntax, resolution, typing, offset, body, expression, target, count, index + 1, changed || added) }
    }

    state finished(changed: bool) -> bool {
        changed
    }
}

// Each path a callee's `requires` facts (a machine binder's: its contract's)
// read below its parameter `k`, behind the path the call's argument `k`
// names below this state's parameters.
machine Checker::demand_callee(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, body: StateItem, expression: Expression, clauses: CallClauses) -> bool
crashes Trap
{
    transition { _ -> clause(checker, syntax, resolution, typing, offset, body, expression, clauses, 0, false) }

    state clause(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, body: StateItem, expression: Expression, clauses: CallClauses, index: u64 in Trapping, changed: bool) -> bool {
        transition index < clauses.clause_count {
            true -> requirement(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed)
            _ -> finished(changed)
        }
    }

    state requirement(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, body: StateItem, expression: Expression, clauses: CallClauses, index: u64 in Trapping, changed: bool) -> bool {
        let clause: Clause = SyntaxTrees::clause(syntax, clauses.first_clause + index);
        transition clause.kind == ClauseKind::Requires && clause.has_expression {
            true -> fact(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed, clause.expression)
            _ -> clause(checker, syntax, resolution, typing, offset, body, expression, clauses, index + 1, changed)
        }
    }

    state fact(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, body: StateItem, expression: Expression, clauses: CallClauses, index: u64 in Trapping, changed: bool, root: u64 in Trapping) -> bool {
        let tree: Expression = SyntaxTrees::expression(syntax, root);
        transition { _ -> node(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed, root, tree.first_row) }
    }

    state node(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        offset: u64 in Trapping,
        body: StateItem,
        expression: Expression,
        clauses: CallClauses,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping
    ) -> bool {
        transition handle <= root {
            true -> read(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed, root, handle)
            _ -> clause(checker, syntax, resolution, typing, offset, body, expression, clauses, index + 1, changed)
        }
    }

    state read(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        offset: u64 in Trapping,
        body: StateItem,
        expression: Expression,
        clauses: CallClauses,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping
    ) -> bool {
        let node_expression: Expression = SyntaxTrees::expression(syntax, handle);
        let wanted: MemberChain = Checker::member_chain(syntax, resolution, typing, handle, clauses.first_parameter, clauses.parameter_count);
        let count: u64 in Trapping = Checker::operand_count(expression);
        transition node_expression.kind == ExpressionKind::Field && wanted.rooted && wanted.path.depth > 0 && wanted.path.parameter < count {
            true -> lent(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed, root, handle, wanted.path)
            _ -> node(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed, root, handle + 1)
        }
    }

    state lent(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        offset: u64 in Trapping,
        body: StateItem,
        expression: Expression,
        clauses: CallClauses,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping,
        wanted: ArrivalPath
    ) -> bool {
        let argument: u64 in Trapping = Checker::operand(syntax, expression, wanted.parameter);
        let chain: MemberChain = Checker::member_chain(syntax, resolution, typing, argument, body.first_parameter, body.parameter_count);
        let behind: ArrivalPath = ArrivalPath::joined(chain.path, wanted);
        let added: bool = Checker::add_rooted(checker, offset, chain.rooted, behind);
        transition { _ -> node(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed || added, root, handle + 1) }
    }

    state finished(changed: bool) -> bool {
        changed
    }
}

// Add a joined path when its argument was rooted below this state's
// parameters.
machine Checker::add_rooted(checker: &mut Checker, offset: u64 in Trapping, rooted: bool, path: ArrivalPath) -> bool
crashes Trap
{
    transition rooted && path.depth > 0 {
        true -> added(checker, offset, path)
        _ -> unchanged()
    }

    state added(checker: &mut Checker, offset: u64 in Trapping, path: ArrivalPath) -> bool {
        let grew: bool = Checker::add_arrival_path(checker, offset, path);
        grew
    }

    state unchanged() -> bool {
        false
    }
}

// For each of state `offset`'s paths ending in a field, the fields its
// declaration's `where` facts name beside it, at the same depth.
machine Checker::demand_siblings(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, offset, 0, false) }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, index: u64 in Trapping, changed: bool) -> bool {
        let count: u64 in Trapping = Checker::path_count(checker, offset);
        transition index < count && index < 40 {
            true -> path(checker, syntax, resolution, typing, offset, index, changed)
            _ -> finished(changed)
        }
    }

    state path(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, index: u64 in Trapping, changed: bool) -> bool {
        let path: ArrivalPath = Checker::arrival_path(checker, offset, index);
        transition path.depth > 0 && path.depth <= 4 {
            true -> last(checker, syntax, resolution, typing, offset, index, changed, path)
            _ -> next(checker, syntax, resolution, typing, offset, index + 1, changed)
        }
    }

    state last(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, index: u64 in Trapping, changed: bool, path: ArrivalPath) -> bool {
        let step: ArrivalStep = ArrivalPath::step(path, path.depth - 1);
        transition step.length {
            true -> next(checker, syntax, resolution, typing, offset, index + 1, changed)
            _ -> related(checker, syntax, resolution, typing, offset, index, changed, path, step.field)
        }
    }

    state related(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, index: u64 in Trapping, changed: bool, path: ArrivalPath, field: u64 in Trapping) -> bool {
        let added: bool = Checker::demand_field_relatives(checker, syntax, resolution, typing, offset, path, field);
        transition { _ -> next(checker, syntax, resolution, typing, offset, index + 1, changed || added) }
    }

    state finished(changed: bool) -> bool {
        changed
    }
}

// The fields each `where` fact naming `field` of its declaration names, as
// paths beside `path` (whose last step is `field`).
machine Checker::demand_field_relatives(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, path: ArrivalPath, field: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> owner(checker, syntax, resolution, typing, offset, path, field, 0) }

    state owner(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, path: ArrivalPath, field: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < syntax.data_count {
            true -> declaration(checker, syntax, resolution, typing, offset, path, field, index)
            _ -> finished(false)
        }
    }

    state declaration(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, path: ArrivalPath, field: u64 in Trapping, index: u64 in Trapping) -> bool {
        let item: DataItem = SyntaxTrees::data_item(syntax, index);
        transition field >= item.first_field && field - item.first_field < item.field_count {
            true -> clause(checker, syntax, resolution, typing, offset, path, field, item, 0, false)
            _ -> owner(checker, syntax, resolution, typing, offset, path, field, index + 1)
        }
    }

    state clause(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, path: ArrivalPath, field: u64 in Trapping, item: DataItem, index: u64 in Trapping, changed: bool) -> bool {
        transition index < item.clause_count {
            true -> fact(checker, syntax, resolution, typing, offset, path, field, item, index, changed)
            _ -> finished(changed)
        }
    }

    state fact(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, path: ArrivalPath, field: u64 in Trapping, item: DataItem, index: u64 in Trapping, changed: bool) -> bool {
        let clause: Clause = SyntaxTrees::clause(syntax, item.first_clause + index);
        transition clause.kind == ClauseKind::Where && clause.has_expression {
            true -> mentioned(checker, syntax, resolution, typing, offset, path, field, item, index, changed, clause.expression)
            _ -> clause(checker, syntax, resolution, typing, offset, path, field, item, index + 1, changed)
        }
    }

    state mentioned(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, path: ArrivalPath, field: u64 in Trapping, item: DataItem, index: u64 in Trapping, changed: bool, root: u64 in Trapping) -> bool {
        let named: bool = Checker::mentions_field(syntax, resolution, root, field);
        transition named {
            true -> relatives(checker, syntax, resolution, typing, offset, path, field, item, index, changed, root)
            _ -> clause(checker, syntax, resolution, typing, offset, path, field, item, index + 1, changed)
        }
    }

    state relatives(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, path: ArrivalPath, field: u64 in Trapping, item: DataItem, index: u64 in Trapping, changed: bool, root: u64 in Trapping) -> bool {
        let tree: Expression = SyntaxTrees::expression(syntax, root);
        transition { _ -> node(checker, syntax, resolution, typing, offset, path, field, item, index, changed, root, tree.first_row) }
    }

    state node(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        offset: u64 in Trapping,
        path: ArrivalPath,
        field: u64 in Trapping,
        item: DataItem,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping
    ) -> bool {
        transition handle <= root {
            true -> named(checker, syntax, resolution, typing, offset, path, field, item, index, changed, root, handle)
            _ -> clause(checker, syntax, resolution, typing, offset, path, field, item, index + 1, changed)
        }
    }

    state named(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        offset: u64 in Trapping,
        path: ArrivalPath,
        field: u64 in Trapping,
        item: DataItem,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping
    ) -> bool {
        let binding: ValueBinding = NameResolution::value_binding(resolution, handle);
        transition binding {
            ValueBinding::Field { field as sibling } -> sibling(checker, syntax, resolution, typing, offset, path, field, item, index, changed, root, handle, sibling)
            _ -> node(checker, syntax, resolution, typing, offset, path, field, item, index, changed, root, handle + 1)
        }
    }

    state sibling(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        offset: u64 in Trapping,
        path: ArrivalPath,
        field: u64 in Trapping,
        item: DataItem,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping,
        sibling: u64 in Trapping
    ) -> bool {
        let declared: DataField = SyntaxTrees::field(syntax, sibling);
        let type_handle: u64 in Trapping = Typing::reference_type(typing, declared.type_reference);
        let step: ArrivalStep = ArrivalStep { length: false, field: sibling, type_handle: type_handle };
        let beside: ArrivalPath = ArrivalPath::with_step(path, path.depth - 1, step);
        let added: bool = Checker::add_arrival_path(checker, offset, beside);
        transition { _ -> node(checker, syntax, resolution, typing, offset, path, field, item, index, changed || added, root, handle + 1) }
    }

    state finished(changed: bool) -> bool {
        changed
    }
}
