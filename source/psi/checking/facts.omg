use psi::checking::checker;
use psi::checking::evaluation;
use psi::checking::zone;
use psi::integers::integers;
use psi::syntax::syntax;
use psi::types::types;

// Facts a Boolean expression establishes when it is known to hold, or known
// to fail: a selected guard arm, the left operand on the right of `&&`, a
// state's `requires`. An integer comparison between linear terms is a
// difference fact; against any other integer value it bounds the term by
// that value's interval. A conjunction holds both sides, a failed
// disjunction fails both, and `!` swaps. Any other Boolean with a value, a
// place or a call's result, is 1 when it holds and 0 when it fails. An
// equality of other non-integers establishes nothing. The tree has been evaluated,
// so its nodes' values are known; the walk keeps its own stack of
// (handle, holds) pairs, each packed as `handle * 2 + holds`.
public machine Checker::assume(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, holds: bool)
crashes Trap
{
    checker.assumption_count = 0;
    Checker::push_assumption(checker, root, holds);
    transition { _ -> next(checker, syntax) }

    machine next(checker: &mut Checker, syntax: &SyntaxTrees) {
        transition checker.assumption_count > 0 {
            true -> pop(checker, syntax)
            _ -> done()
        }
    }

    machine pop(checker: &mut Checker, syntax: &SyntaxTrees) {
        let packed: u64 in Trapping = Checker::pop_assumption(checker);
        let handle: u64 in Trapping = packed / 2;
        let holds: bool = packed % 2 == 1;
        let expression: Expression = SyntaxTrees::expression(syntax, handle);
        transition expression.kind {
            ExpressionKind::Binary -> binary(checker, syntax, expression, holds)
            ExpressionKind::Unary -> unary(checker, syntax, expression, holds)
            ExpressionKind::Boolean -> literal(checker, syntax, expression, holds)
            _ -> truth(checker, syntax, handle, holds)
        }
    }

    // value - truth <= 0 and truth - value <= 0.
    machine truth(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, holds: bool) {
        let value: Value = Checker::value_at(checker, handle);
        let expected: Value = Value::truth(holds);
        let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
        Checker::constrain_difference(checker, value, expected, zero);
        Checker::constrain_difference(checker, expected, value, zero);
        transition { _ -> next(checker, syntax) }
    }

    machine unary(checker: &mut Checker, syntax: &SyntaxTrees, expression: Expression, holds: bool) {
        transition expression.operator == OperatorKind::Not {
            true -> negated(checker, syntax, expression.left, !holds)
            _ -> next(checker, syntax)
        }
    }

    machine negated(checker: &mut Checker, syntax: &SyntaxTrees, operand: u64 in Trapping, holds: bool) {
        Checker::push_assumption(checker, operand, holds);
        transition { _ -> next(checker, syntax) }
    }

    // A Boolean literal contradicting its assumption makes the point
    // unreachable.
    machine literal(checker: &mut Checker, syntax: &SyntaxTrees, expression: Expression, holds: bool) {
        transition expression.flag != holds {
            true -> contradiction(checker, syntax)
            _ -> next(checker, syntax)
        }
    }

    machine contradiction(checker: &mut Checker, syntax: &SyntaxTrees) {
        checker.zone.infeasible = true;
        transition { _ -> next(checker, syntax) }
    }

    machine binary(checker: &mut Checker, syntax: &SyntaxTrees, expression: Expression, holds: bool) {
        let left: Value = Checker::value_at(checker, expression.left);
        let right: Value = Checker::value_at(checker, expression.right);
        let operator: OperatorKind = Checker::polarized(expression.operator, holds);
        transition operator {
            OperatorKind::And -> both(checker, syntax, expression, holds)
            OperatorKind::Or -> both(checker, syntax, expression, holds)
            OperatorKind::Less -> related(checker, syntax, left, right, true)
            OperatorKind::LessEqual -> related(checker, syntax, left, right, false)
            OperatorKind::Greater -> related(checker, syntax, right, left, true)
            OperatorKind::GreaterEqual -> related(checker, syntax, right, left, false)
            OperatorKind::Equal -> equal(checker, syntax, left, right)
            OperatorKind::NotEqual -> unequal(checker, syntax, left, right)
            _ -> next(checker, syntax)
        }
    }

    // `a && b` holding, or `a || b` failing: both operands, alike.
    machine both(checker: &mut Checker, syntax: &SyntaxTrees, expression: Expression, holds: bool) {
        transition (expression.operator == OperatorKind::And) == holds {
            true -> pushed(checker, syntax, expression, holds)
            _ -> next(checker, syntax)
        }
    }

    machine pushed(checker: &mut Checker, syntax: &SyntaxTrees, expression: Expression, holds: bool) {
        Checker::push_assumption(checker, expression.left, holds);
        Checker::push_assumption(checker, expression.right, holds);
        transition { _ -> next(checker, syntax) }
    }

    // `lesser < greater` is `lesser - greater <= -1`; `<=` bounds it by 0.
    machine related(checker: &mut Checker, syntax: &SyntaxTrees, lesser: Value, greater: Value, strict: bool) {
        let bound: ExactInteger = Checker::slack(strict);
        Checker::constrain_difference(checker, lesser, greater, bound);
        transition { _ -> next(checker, syntax) }
    }

    machine equal(checker: &mut Checker, syntax: &SyntaxTrees, left: Value, right: Value) {
        let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
        Checker::constrain_difference(checker, left, right, zero);
        Checker::constrain_difference(checker, right, left, zero);
        transition { _ -> next(checker, syntax) }
    }

    // `left != right` excludes one value, which a difference bound holds
    // only beside an order the facts already prove: `left >= right` becomes
    // `left >= right + 1` (an unsigned value known nonzero is at least one),
    // and `left <= right` becomes `left <= right - 1`. Both at once make the
    // point unreachable.
    machine unequal(checker: &mut Checker, syntax: &SyntaxTrees, left: Value, right: Value) {
        let below: ExactInteger = ExactInteger { negative: true, magnitude: 1 };
        let at_least: bool = Checker::proves_at_most(checker, right, left);
        let at_most: bool = Checker::proves_at_most(checker, left, right);
        transition at_least {
            true -> raised(checker, syntax, left, right, at_most, below)
            _ -> lowered(checker, syntax, left, right, at_most, below)
        }
    }

    machine raised(checker: &mut Checker, syntax: &SyntaxTrees, left: Value, right: Value, at_most: bool, below: ExactInteger) {
        Checker::constrain_difference(checker, right, left, below);
        transition { _ -> lowered(checker, syntax, left, right, at_most, below) }
    }

    machine lowered(checker: &mut Checker, syntax: &SyntaxTrees, left: Value, right: Value, at_most: bool, below: ExactInteger) {
        transition at_most {
            true -> capped(checker, syntax, left, right, below)
            _ -> next(checker, syntax)
        }
    }

    machine capped(checker: &mut Checker, syntax: &SyntaxTrees, left: Value, right: Value, below: ExactInteger) {
        Checker::constrain_difference(checker, left, right, below);
        transition { _ -> next(checker, syntax) }
    }

    machine done() {}
}

machine Checker::slack(strict: bool) -> ExactInteger {
    transition strict {
        true -> below()
        _ -> zero()
    }

    machine below() -> ExactInteger {
        ExactInteger { negative: true, magnitude: 1 }
    }

    machine zero() -> ExactInteger {
        ExactInteger { negative: false, magnitude: 0 }
    }
}

// The comparison a failed `operator` establishes: its complement. `&&` and
// `||` keep their spelling; `both` reads the polarity.
public machine Checker::polarized(operator: OperatorKind, holds: bool) -> OperatorKind {
    transition holds {
        true -> kept(operator)
        _ -> complement(operator)
    }

    machine kept(operator: OperatorKind) -> OperatorKind {
        operator
    }

    machine complement(operator: OperatorKind) -> OperatorKind {
        transition operator {
            OperatorKind::Less -> chosen(OperatorKind::GreaterEqual)
            OperatorKind::LessEqual -> chosen(OperatorKind::Greater)
            OperatorKind::Greater -> chosen(OperatorKind::LessEqual)
            OperatorKind::GreaterEqual -> chosen(OperatorKind::Less)
            OperatorKind::Equal -> chosen(OperatorKind::NotEqual)
            OperatorKind::NotEqual -> chosen(OperatorKind::Equal)
            _ -> chosen(operator)
        }
    }

    machine chosen(operator: OperatorKind) -> OperatorKind {
        operator
    }
}

// Establish `left - right <= bound` for two integer values: a difference of
// their subjects when both are linear terms, otherwise a bound on the one
// that is, from the other's interval.
public machine Checker::constrain_difference(checker: &mut Checker, left: Value, right: Value, bound: ExactInteger)
crashes Trap
{
    transition left.known && right.known {
        true -> terms(checker, left, right, bound)
        _ -> one_side(checker, left, right, bound)
    }

    // (l + a) - (r + b) <= c gives l - r <= c - a + b.
    machine terms(checker: &mut Checker, left: Value, right: Value, bound: ExactInteger) {
        let shifted: ExactResult = ExactInteger::subtract(bound, left.offset);
        let moved: ExactResult = ExactInteger::add(shifted.value, right.offset);
        let finite: bool = shifted.valid && moved.valid;
        Zone::constrain(&mut checker.zone, right.subject, left.subject, Bound { finite: finite, value: moved.value });
    }

    machine one_side(checker: &mut Checker, left: Value, right: Value, bound: ExactInteger) {
        transition left.known {
            true -> left_term(checker, left, right, bound)
            _ -> right_side(checker, left, right, bound)
        }
    }

    // l + a <= c + right gives l <= c + ceiling(right) - a.
    machine left_term(checker: &mut Checker, left: Value, right: Value, bound: ExactInteger) {
        let exact: Bound = Bound::exactly(bound);
        let limit: Bound = Bound::add(exact, right.ceiling);
        let negated: ExactInteger = ExactInteger::negate(left.offset);
        let shift: Bound = Bound::exactly(negated);
        let upper: Bound = Bound::add(limit, shift);
        Zone::constrain(&mut checker.zone, 0, left.subject, upper);
    }

    machine right_side(checker: &mut Checker, left: Value, right: Value, bound: ExactInteger) {
        transition right.known {
            true -> right_term(checker, left, right, bound)
            _ -> done()
        }
    }

    // left - (r + b) <= c gives -r <= c + floor(left) + b.
    machine right_term(checker: &mut Checker, left: Value, right: Value, bound: ExactInteger) {
        let exact: Bound = Bound::exactly(bound);
        let limit: Bound = Bound::add(exact, left.floor);
        let shift: Bound = Bound::exactly(right.offset);
        let lower: Bound = Bound::add(limit, shift);
        Zone::constrain(&mut checker.zone, right.subject, 0, lower);
    }

    machine done() {}
}

machine Checker::push_assumption(checker: &mut Checker, handle: u64 in Trapping, holds: bool)
crashes Trap
{
    let polarity: u64 in Trapping = Checker::polarity(holds);
    let packed: u64 in Trapping = handle * 2 + polarity;
    transition checker.assumption_count < 128 {
        true -> push(checker, checker.assumption_count, packed)
        _ -> full()
    }

    machine push(checker: &mut Checker, index: u64, packed: u64 in Trapping) {
        transition index < 128 {
            true -> write(checker, index, packed)
            _ -> full()
        }
    }

    machine write(checker: &mut Checker, index: u64, packed: u64 in Trapping)
    requires index < 128
    {
        checker.assumptions[index] = packed as u64;
        checker.assumption_count = index + 1;
    }

    // A deeper Boolean tree than the stack holds is simply not assumed.
    machine full() {}
}

machine Checker::polarity(holds: bool) -> u64 in Trapping {
    transition holds {
        true -> one()
        _ -> zero()
    }

    machine one() -> u64 in Trapping {
        1
    }

    machine zero() -> u64 in Trapping {
        0
    }
}

machine Checker::pop_assumption(checker: &mut Checker) -> u64 in Trapping
crashes Trap
{
    transition checker.assumption_count > 0 && checker.assumption_count <= 128 {
        true -> read(checker, checker.assumption_count - 1)
        _ -> invalid()
    }

    machine read(checker: &mut Checker, index: u64) -> u64 in Trapping
    requires index < 128
    {
        checker.assumption_count = index;
        checker.assumptions[index] as u64 in Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// Whether the facts prove a Boolean expression whose tree has been
// evaluated: every comparison it needs follows from the zone or the
// operands' intervals. A conjunction needs both sides, a failed disjunction
// both failures, `!` swaps, and a disjunction (or a failed conjunction)
// needs one of its sides to be a comparison or literal that proves. Goals
// keep the assumption stack's packing, `handle * 2 + holds`.
public machine Checker::proves(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping) -> bool
crashes Trap
{
    checker.assumption_count = 0;
    Checker::push_assumption(checker, root, true);
    transition { _ -> next(checker, syntax) }

    machine next(checker: &mut Checker, syntax: &SyntaxTrees) -> bool {
        transition checker.assumption_count > 0 {
            true -> goal(checker, syntax)
            _ -> proved()
        }
    }

    machine goal(checker: &mut Checker, syntax: &SyntaxTrees) -> bool {
        let packed: u64 in Trapping = Checker::pop_assumption(checker);
        let handle: u64 in Trapping = packed / 2;
        let holds: bool = packed % 2 == 1;
        let expression: Expression = SyntaxTrees::expression(syntax, handle);
        let logical: bool = expression.kind == ExpressionKind::Binary
            && (expression.operator == OperatorKind::And || expression.operator == OperatorKind::Or);
        let negation: bool = expression.kind == ExpressionKind::Unary && expression.operator == OperatorKind::Not;
        transition logical {
            true -> connective(checker, syntax, expression, holds)
            _ -> single(checker, syntax, handle, expression, holds, negation)
        }
    }

    // `a && b` holding or `a || b` failing needs both sides; the other two
    // need one side.
    machine connective(checker: &mut Checker, syntax: &SyntaxTrees, expression: Expression, holds: bool) -> bool {
        transition (expression.operator == OperatorKind::And) == holds {
            true -> both(checker, syntax, expression, holds)
            _ -> either(checker, syntax, expression, holds)
        }
    }

    machine both(checker: &mut Checker, syntax: &SyntaxTrees, expression: Expression, holds: bool) -> bool {
        Checker::push_assumption(checker, expression.left, holds);
        Checker::push_assumption(checker, expression.right, holds);
        transition { _ -> next(checker, syntax) }
    }

    machine either(checker: &mut Checker, syntax: &SyntaxTrees, expression: Expression, holds: bool) -> bool {
        let left: bool = Checker::proves_atom(checker, syntax, expression.left, holds);
        let right: bool = Checker::proves_atom(checker, syntax, expression.right, holds);
        transition left || right {
            true -> next(checker, syntax)
            _ -> unproved()
        }
    }

    machine single(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, expression: Expression, holds: bool, negation: bool) -> bool {
        transition negation {
            true -> negated(checker, syntax, expression.left, !holds)
            _ -> atom(checker, syntax, handle, holds)
        }
    }

    machine negated(checker: &mut Checker, syntax: &SyntaxTrees, operand: u64 in Trapping, holds: bool) -> bool {
        Checker::push_assumption(checker, operand, holds);
        transition { _ -> next(checker, syntax) }
    }

    machine atom(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, holds: bool) -> bool {
        let proved: bool = Checker::proves_atom(checker, syntax, handle, holds);
        transition proved {
            true -> next(checker, syntax)
            _ -> unproved()
        }
    }

    machine proved() -> bool {
        true
    }

    machine unproved() -> bool {
        false
    }
}

// Whether a comparison or Boolean literal holds (or fails, when `holds` is
// false) wherever the zone does, or any other Boolean's value is 1 (or 0).
// Two values of one place are equal however little the zone knows of it, a
// Boolean's included.
public machine Checker::proves_atom(checker: &Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, holds: bool) -> bool
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, handle);
    transition expression.kind {
        ExpressionKind::Binary -> comparison(checker, expression, holds)
        ExpressionKind::Boolean -> literal(expression.flag == holds)
        _ -> truth(checker, handle, holds)
    }

    machine truth(checker: &Checker, handle: u64 in Trapping, holds: bool) -> bool {
        let value: Value = Checker::value_at(checker, handle);
        let expected: Value = Value::truth(holds);
        let at_most: bool = Checker::proves_at_most(checker, value, expected);
        let at_least: bool = Checker::proves_at_most(checker, expected, value);
        transition { _ -> literal(at_most && at_least) }
    }

    machine comparison(checker: &Checker, expression: Expression, holds: bool) -> bool {
        let left: Value = Checker::value_at(checker, expression.left);
        let right: Value = Checker::value_at(checker, expression.right);
        let operator: OperatorKind = Checker::polarized(expression.operator, holds);
        let less: bool = Checker::proves_less(checker, left, right);
        let greater: bool = Checker::proves_less(checker, right, left);
        let same: bool = left.place > 0 && left.place == right.place;
        let at_most: bool = same || Checker::proves_at_most(checker, left, right);
        let at_least: bool = same || Checker::proves_at_most(checker, right, left);
        transition operator {
            OperatorKind::Less -> literal(less)
            OperatorKind::LessEqual -> literal(at_most)
            OperatorKind::Greater -> literal(greater)
            OperatorKind::GreaterEqual -> literal(at_least)
            OperatorKind::Equal -> literal(at_most && at_least)
            OperatorKind::NotEqual -> literal(less || greater)
            _ -> unproved()
        }
    }

    machine literal(proved: bool) -> bool {
        proved
    }

    machine unproved() -> bool {
        false
    }
}
