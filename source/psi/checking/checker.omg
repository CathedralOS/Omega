use psi::checking::aliases;
use psi::checking::arrivals;
use psi::checking::constructions;
use psi::checking::completions;
use psi::checking::invocations;
use psi::checking::contracts;
use psi::checking::demand;
use psi::checking::domains;
use psi::checking::evaluation;
use psi::checking::flow;
use psi::checking::frames;
use psi::checking::holds;
use psi::checking::matches;
use psi::checking::obligations;
use psi::checking::ownership;
use psi::checking::places;
use psi::checking::qualification;
use psi::checking::references;
use psi::checking::ranking;
use psi::checking::snapshots;
use psi::checking::supply;
use psi::checking::termination;
use psi::checking::zone;
use psi::checks::checks;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// Checking over a typed source set (checks.omg). Every machine declaration
// owns its parameters, executable range, result and contract. Private invocation
// arrivals gather exact argument facts to a fixed point; every reached body is
// checked against the join of all its predecessors, widening recurrent edges.
// An uninvoked declaration is independently checked under its own parameters
// and requirements. Lexical ancestry locates declarations but supplies no facts.
// Crash routes and termination settle over the selected call graph, then each
// satisfaction must refine its declared requirement. One rejected declaration
// does not prevent independent declarations from reporting their obligations.
public data Checker {
    output: Checks;
    // The body being walked: its places, its integer subjects and its zone.
    places: [Place; 256];
    place_count: u64;
    // Captured local-reference storage origins; zero means unknown.
    reference_origins: [u64; 256];
    // Whether a captured origin is only the storage containing an
    // untracked element (references.omg): the reference writes within it
    // and reads nothing of it.
    reference_footprints: [bool; 256];
    // Each place's default domain (domains.omg), and the place whose fields a
    // `where` fact's field names stand for while it is installed.
    domains: [DomainMark; 256];
    domains_pending: bool;
    fields_parent: u64 in Trapping;
    subject_count: u64;
    overflowed: bool;
    zone: Zone;
    // The trees being evaluated, innermost last: each node's value at the
    // tree's base plus its offset from the tree's lowest handle, and where
    // its `&&`/`||` right operands begin. A tree evaluated while another is
    // open, such as a callee's `requires` fact, takes the values and
    // contexts above its caller's.
    values: [Value; 4096];
    tree_base: u64 in Trapping;
    tree_low: u64 in Trapping;
    tree_size: u64 in Trapping;
    frames: [TreeFrame; 8];
    frame_count: u64;
    replay: bool;
    // Statement trees use scratch above every retained dispatch subject.
    // Their evaluated values survive guards and targets without replay.
    retained_values: u64 in Trapping;
    // Monotone through one machine's walks, including branch restoration.
    // A nonempty call write frame advances it; proof-only nested trees and
    // bookkeeping copies do not. Replay requires unchanged storage.
    write_epoch: u64 in Trapping;
    context_starts: [u64; 64];
    context_operators: [u64; 64];
    context_first: u64;
    context_count: u64;
    // The tree's value-position matches (matches.omg), each with its next
    // arm event pending.
    matches: [u64; 16];
    match_events: [u64; 16];
    match_count: u64;
    assumptions: [u64; 128];
    assumption_count: u64;
    // Saved zones: open `&&`/`||` contexts, transition arms and matches.
    saved: [Zone; 8];
    saved_owners: [u64; 8];
    saved_count: u64;
    // The machine being checked: its private callees' arrival facts and the
    // worklist of declarations whose arrival loosened.
    terminal_calls: [bool; 131072];
    machine: u64 in Trapping;
    graph_root: u64 in Trapping;
    bodies: [u64; 128];
    body_count: u64 in Trapping;
    arrivals: [Zone; 128];
    reached: [bool; 128];
    loosenings: [u64; 128];
    // The order in which declarations were first reached, and the body being
    // walked (zero for the entry, a declaration's offset plus one): a jump into a
    // declaration reached no later than its own is a back edge, and only a back
    // edge's target widens, since every cycle has one.
    discovery: [u64; 128];
    discovered: u64;
    walking: u64;
    queued: [bool; 128];
    queue: [u64; 128];
    queue_count: u64;
    projection: [Value; 64];
    // Each declaration's arrival field paths (arrivals.omg), 40 per declaration.
    paths: [ArrivalPath; 5120];
    path_counts: [u64; 128];
    // While a target's `requires` facts are decided, its parameters from
    // `argument_first` stand for these argument values.
    arguments: [Value; 64];
    argument_first: u64 in Trapping;
    argument_count: u64 in Trapping;
    substituting: bool;
    // While a machine's `ensures` facts are decided, `result` stands for
    // `returned`: what one of its returns produces, or a call's result.
    returned: Value;
    returning: bool;
    // While a domain's predicates are decided, its subject binder stands
    // for `subject` (qualification.omg).
    subject: Value;
    subjecting: bool;
    // While a quoted literal's qualification is decided, its predicate roster
    // answers the domain's byte predicates of the subject.
    subject_literal: bool;
    subject_roster: u64 in Trapping;
    // While a return's result is decided, the machine being checked is the
    // origin of the routed domains that name it (qualification.omg).
    minting: bool;
    // Whether the body being walked computes a rank: a measure's body is a
    // mathematical computation over naturals
    // (wiki/spec/language/termination.md#ranking), so its fixed-integer
    // results are exact rather than carrier obligations.
    exact_body: bool;
    // While a construction's `where` facts are decided, the fields from
    // `field_first` stand for the same argument values.
    field_values: bool;
    field_first: u64 in Trapping;
    // While a case's own `where` facts are decided or assumed, its payload
    // fields from `payload_first` stand for the argument values from
    // `payload_slot`: what a construction writes, or an arm's binders.
    payload_values: bool;
    payload_first: u64 in Trapping;
    payload_slot: u64 in Trapping;
    contribution: Zone;
    // Scratch copies: a runtime-indexed zone is copied out before an
    // operation borrows it and stored back after.
    previous: Zone;
    merged: Zone;
    // The current zone while a saved one takes an established value's
    // domain facts (domains.omg).
    stashed: Zone;
    trap_route: bool;
    abort_route: bool;
    // Universal, own-entry completion queries share the exact invocation graph.
    invocations: InvocationGraph;
    completions: [NumericCompletion; 10240];
    entry_rank: NormalizedRank;
    entry_rank_bounds: RankBounds;
    entry_rank_has_range: bool;
    collecting_completion: bool;
    completion_seen: bool;
    completion_value: Value;
    // Machine calls, caller and callee, for settling crash routes.
    callers: [u64; 32768];
    callees: [u64; 32768];
    call_count: u64;
    // Calls supplying static machine arguments, refined against their
    // binders' contracts once crash routes settle (supply.omg).
    supplied: [SuppliedCall; 1024];
    supplied_count: u64;
    // Write frames (frames.omg): per parameter, whether its body may replace
    // an exclusive parameter's whole referent; per machine, whether its
    // writes are unknown, and the data fields it may write, a row of 1,024
    // per machine.
    whole_writes: [bool; 32768];
    unknown_writes: [bool; 10240];
    field_writes: [bool; 2097152];
    // Per declaration, completed global component/termination summaries.
    binder_calls: [bool; 10240];
    terminating: [bool; 10240];
    components_done: [bool; 10240];
    rank_reported: [bool; 10240];
    // The ownership walk of the body being checked (ownership.omg).
    ownership: Ownership;
    // Boolean aliases (aliases.omg): each aliased place, the condition it
    // stands for and how many places existed when it was bound.
    aliases: AliasTable;
    saved_aliases: [AliasTable; 8];
    // Fields constructions wrote that no place holds yet (constructions.omg).
    pending: [PendingField; 32];
    pending_count: u64;
}

public machine Checker::check(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing)
crashes Trap
{
    Checker::clear(checker, syntax);
    Checker::initialize_terminal_calls(checker, syntax);
    Checker::derive_frames(checker, syntax, resolution, typing);
    Checker::derive_completions(checker, syntax, resolution, typing);
    transition { _ -> next_machine(checker, syntax, resolution, typing, 0) }

    machine next_machine(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        transition index < syntax.machine_count && checker.output.diagnostic_count < 64 {
            true -> machine(checker, syntax, resolution, typing, index)
            _ -> settle(checker, syntax, resolution)
        }
    }

    machine machine(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        transition item.has_body && item.parent == 0 {
            true -> body(checker, syntax, resolution, typing, index)
            _ -> next_machine(checker, syntax, resolution, typing, index + 1)
        }
    }

    machine body(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        Checker::check_machine(checker, syntax, resolution, typing, index);
        transition { _ -> next_machine(checker, syntax, resolution, typing, index + 1) }
    }

    // A body that rejected may have stopped before some of its crash sites;
    // its routes are then a subset of what it derives, so settling them
    // finds no cause that a whole walk would not.
    machine settle(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution) {
        Checker::settle_routes(checker, syntax);
        Checker::settle_termination(checker, syntax, resolution);
        Checker::check_supply(checker, syntax, resolution);
    }
}

// An accepted, empty result, with every machine's declared crash causes.
machine Checker::clear(checker: &mut Checker, syntax: &SyntaxTrees)
crashes Trap
{
    checker.output.accepted = true;
    checker.output.machine_accepted = true;
    checker.output.diagnostic_count = 0;
    checker.output.obligation_count = 0;
    checker.output.machine_count = syntax.machine_count;
    checker.call_count = 0;
    checker.supplied_count = 0;
    transition { _ -> next(checker, syntax, 0) }

    machine next(checker: &mut Checker, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> declared(checker, syntax, index)
            _ -> done()
        }
    }

    machine declared(checker: &mut Checker, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let routes: CrashRoutes = Checker::declared_routes(syntax, item);
        Checks::set_routes(&mut checker.output, index, routes);
        Checker::reset_termination(checker, index);
        transition { _ -> next(checker, syntax, index + 1) }
    }

    machine done() {}
}

// A machine's declared crash causes. A private machine with a body and no
// crash clause asks for inference.
machine Checker::declared_routes(syntax: &SyntaxTrees, item: MachineItem) -> CrashRoutes
crashes Trap
{
    let causes: CrashRoutes = Checker::declared_causes(syntax, item.first_clause, item.clause_count);
    CrashRoutes {
        declares_trap: causes.declares_trap,
        declares_abort: causes.declares_abort,
        inferred: !(causes.declares_trap || causes.declares_abort) && !item.is_public && item.has_body,
        trap: false,
        abort: false
    }
}

// The causes a clause run's `crashes` clauses declare.
public machine Checker::declared_causes(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping) -> CrashRoutes
crashes Trap
{
    transition { _ -> next(syntax, first, first + count, false, false) }

    machine next(syntax: &SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping, trap: bool, abort: bool) -> CrashRoutes {
        transition index < end {
            true -> clause(syntax, index, end, trap, abort)
            _ -> finished(trap, abort)
        }
    }

    machine clause(syntax: &SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping, trap: bool, abort: bool) -> CrashRoutes {
        let clause: Clause = SyntaxTrees::clause(syntax, index);
        let crashes: bool = clause.kind == ClauseKind::Crashes;
        let traps: bool = crashes && clause.cause == CrashCause::Trap;
        let aborts: bool = crashes && clause.cause == CrashCause::Abort;
        transition { _ -> next(syntax, index + 1, end, trap || traps, abort || aborts) }
    }

    machine finished(trap: bool, abort: bool) -> CrashRoutes {
        CrashRoutes { declares_trap: trap, declares_abort: abort, inferred: false, trap: false, abort: false }
    }
}

// One machine: gather facts to a fixed point, then check every body,
// then publish its local crash routes.
public machine Checker::check_machine(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping)
crashes Trap
{
    let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
    Checks::open_machine(&mut checker.output);
    Checker::prepare_body(checker, item, index);
    Checker::collect_bodies(checker, syntax, index);
    checker.trap_route = false;
    checker.abort_route = false;
    checker.queue_count = 0;
    checker.discovered = 0;
    checker.walking = 0;
    transition checker.body_count <= 128 && !checker.overflowed {
        true -> cleared(checker, syntax, resolution, typing, index, item)
        _ -> too_many(checker, item)
    }

    machine cleared(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem) {
        transition { _ -> arrivals(checker, syntax, resolution, typing, index, item, 0) }
    }

    machine arrivals(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        transition offset < checker.body_count {
            true -> unreached(checker, syntax, resolution, typing, index, item, offset)
            _ -> explore(checker, syntax, resolution, typing, index, item)
        }
    }

    machine unreached(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        Checker::reset_arrival(checker, offset);
        transition { _ -> arrivals(checker, syntax, resolution, typing, index, item, offset + 1) }
    }

    machine explore(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem) {
        Checker::derive_demand(checker, syntax, resolution, typing, item);
        Checker::open_entry(checker, syntax, resolution, typing, item);
        Checker::walk_body(checker, syntax, resolution, typing, item.first_statement, item.statement_count, false);
        transition { _ -> drain(checker, syntax, resolution, typing, index, item) }
    }

    machine drain(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem) {
        transition checker.queue_count > 0 && checker.output.machine_accepted {
            true -> revisit(checker, syntax, resolution, typing, index, item)
            _ -> closed(checker, syntax, resolution, typing, index, item)
        }
    }

    // The fact-gathering walks took every edge the checking walk can.
    machine closed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem) {
        checker.machine = index;
        transition { _ -> check_entry(checker, syntax, resolution, typing, index, item) }
    }

    machine revisit(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem) {
        let offset: u64 in Trapping = Checker::dequeue(checker);
        Checker::walk_machine(checker, syntax, resolution, typing, offset, true, false);
        transition { _ -> drain(checker, syntax, resolution, typing, index, item) }
    }

    // Crash routes come from the checking walk alone: a fact-gathering walk
    // may see a site its settled facts disprove.
    machine check_entry(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem) {
        checker.machine = index;
        checker.trap_route = false;
        checker.abort_route = false;
        Checker::open_entry(checker, syntax, resolution, typing, item);
        Checker::require_rank_range_entry(checker, syntax, resolution, typing, item);
        Checker::walk_body(checker, syntax, resolution, typing, item.first_statement, item.statement_count, true);
        Checker::own_body(
            checker,
            syntax,
            resolution,
            typing,
            item.first_parameter,
            item.parameter_count,
            item.first_statement,
            item.statement_count,
            item.source_span
        );
        Checker::publish_body_routes(checker, index);
        transition { _ -> check_state(checker, syntax, resolution, typing, index, item, 0) }
    }

    machine check_state(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        transition offset < checker.body_count && checker.output.machine_accepted {
            true -> reached(checker, syntax, resolution, typing, index, item, offset)
            _ -> publish(checker, index, item)
        }
    }

    // A declaration no walk reached is still checked, from its parameters'
    // carrier ranges and its own `requires` facts alone.
    machine reached(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        let arrived: bool = Checker::was_reached(checker, offset);
        Checker::walk_machine(checker, syntax, resolution, typing, offset, arrived, true);
        transition { _ -> check_state(checker, syntax, resolution, typing, index, item, offset + 1) }
    }

    machine publish(checker: &mut Checker, index: u64 in Trapping, item: MachineItem) {
        transition checker.overflowed {
            true -> overflowed(checker, item)
            _ -> done()
        }
    }

    machine overflowed(checker: &mut Checker, item: MachineItem) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, item.source_span);
    }

    machine too_many(checker: &mut Checker, item: MachineItem) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, item.source_span);
    }

    machine done() {}
}

// Every independent abstract walk starts with the same body-local scratch.
public machine Checker::prepare_body(checker: &mut Checker, item: MachineItem, index: u64 in Trapping) {
    // A previous machine's rejection may have stopped its walk inside a
    // context, frame or substitution.
    checker.saved_count = 0;
    checker.frame_count = 0;
    checker.context_count = 0;
    checker.match_count = 0;
    checker.replay = false;
    checker.write_epoch = 0;
    checker.retained_values = 0;
    checker.substituting = false;
    checker.returning = false;
    checker.subjecting = false;
    checker.subject_literal = false;
    checker.minting = false;
    checker.exact_body = item.container == MachineContainer::Measure;
    checker.field_values = false;
    checker.payload_values = false;
    checker.domains_pending = false;
    checker.fields_parent = 0;
    checker.machine = index;
    checker.graph_root = index;
    checker.overflowed = false;
    checker.entry_rank.valid = false;
    checker.entry_rank_has_range = false;
}

// The entry body's places: its parameters, each integer one in its
// carrier's range, under the machine's `requires` facts.
public machine Checker::open_entry(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem)
crashes Trap
{
    checker.walking = 0;
    Checker::open_places(checker);
    Checker::enter_parameters(checker, syntax, typing, item.first_parameter, item.parameter_count);
    Checker::assume_parameter_qualifications(checker, syntax, resolution, typing, item.first_parameter, item.parameter_count);
    Checker::assume_requirements(checker, syntax, resolution, typing, item.first_clause, item.clause_count);
    Checker::install_domains(checker, syntax, resolution, typing);
}

// A declaration's places: its parameters, in order, so its integer and Boolean
// parameters are subjects 1, 2, ... as its arrival zone numbers them, then its arrival when
// a walk reached it (`arrival`).
machine Checker::walk_machine(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    offset: u64 in Trapping,
    arrival: bool,
    checking: bool
)
crashes Trap
{
    let handle: u64 in Trapping = Checker::body_handle(checker, offset);
    let declaration: MachineItem = SyntaxTrees::machine_item(syntax, handle);
    checker.machine = handle;
    checker.trap_route = false;
    checker.abort_route = false;
    let walking: u64 in Trapping = offset + 1;
    checker.walking = walking as u64;
    Checker::open_places(checker);
    Checker::enter_parameters(checker, syntax, typing, declaration.first_parameter, declaration.parameter_count);
    let numbered: bool = Checker::enter_paths(checker, typing, offset, declaration.first_parameter);
    transition numbered && arrival {
        true -> arrived(checker, syntax, resolution, typing, offset, declaration, checking)
        _ -> opened(checker, syntax, resolution, typing, declaration, checking)
    }

    machine arrived(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, offset: u64 in Trapping, declaration: MachineItem, checking: bool) {
        Checker::arrive(checker, offset);
        Checker::restore_ranges(checker, typing);
        transition { _ -> opened(checker, syntax, resolution, typing, declaration, checking) }
    }

    // A body whose paths did not take their arrival's numbering keeps only
    // its places' carrier ranges.
    machine opened(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, declaration: MachineItem, checking: bool) {
        Checker::assume_parameter_qualifications(checker, syntax, resolution, typing, declaration.first_parameter, declaration.parameter_count);
        Checker::assume_requirements(checker, syntax, resolution, typing, declaration.first_clause, declaration.clause_count);
        Checker::install_domains(checker, syntax, resolution, typing);
        Checker::require_rank_range_entry(checker, syntax, resolution, typing, declaration);
        Checker::walk_body(checker, syntax, resolution, typing, declaration.first_statement, declaration.statement_count, checking);
        transition checking {
            true -> owned(checker, syntax, resolution, typing, declaration)
            _ -> done()
        }
    }

    // The checking walk owns the body while its places are open: the
    // ownership walk (ownership.omg) reads the storage origins its
    // reference locals captured.
    machine owned(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, declaration: MachineItem) {
        Checker::own_body(
            checker,
            syntax,
            resolution,
            typing,
            declaration.first_parameter,
            declaration.parameter_count,
            declaration.first_statement,
            declaration.statement_count,
            declaration.source_span
        );
        let machine: u64 in Trapping = checker.machine;
        Checker::publish_body_routes(checker, machine);
    }

    machine done() {}
}

machine Checker::enter_parameters(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, first: u64 in Trapping, count: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(checker, syntax, typing, first, first + count) }

    machine next(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping) {
        transition index < end {
            true -> enter(checker, syntax, typing, index, end)
            _ -> done()
        }
    }

    machine enter(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping) {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, index);
        let type_handle: u64 in Trapping = Typing::reference_type(typing, parameter.type_reference);
        let place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Parameter, index, 0, type_handle);
        transition { _ -> next(checker, syntax, typing, index + 1, end) }
    }

    machine done() {}
}

// Machine-local declaration tables, guarded by the declaration's offset.
machine Checker::reset_arrival(checker: &mut Checker, offset: u64 in Trapping)
crashes Trap
{
    transition offset < 128 {
        true -> reset(checker, offset)
        _ -> invalid()
    }

    machine reset(checker: &mut Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        checker.reached[offset] = false;
        checker.queued[offset] = false;
        checker.loosenings[offset] = 0;
        checker.discovery[offset] = 0;
        checker.path_counts[offset] = 0;
    }

    machine invalid() {
        crash Trap;
    }
}

machine Checker::was_reached(checker: &Checker, offset: u64 in Trapping) -> bool
crashes Trap
{
    transition offset < 128 {
        true -> read(checker, offset)
        _ -> invalid()
    }

    machine read(checker: &Checker, offset: u64 in Trapping) -> bool
    requires offset < 128
    {
        checker.reached[offset]
    }

    machine invalid() -> bool {
        crash Trap;
    }
}

machine Checker::arrive(checker: &mut Checker, offset: u64 in Trapping)
crashes Trap
{
    transition offset < 128 {
        true -> copy(checker, offset)
        _ -> invalid()
    }

    machine copy(checker: &mut Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        checker.zone = checker.arrivals[offset];
    }

    machine invalid() {
        crash Trap;
    }
}

machine Checker::dequeue(checker: &mut Checker) -> u64 in Trapping
crashes Trap
{
    transition checker.queue_count > 0 {
        true -> pop(checker, checker.queue_count - 1)
        _ -> invalid()
    }

    machine pop(checker: &mut Checker, index: u64) -> u64 in Trapping {
        transition index < 128 {
            true -> read(checker, index)
            _ -> invalid()
        }
    }

    machine read(checker: &mut Checker, index: u64) -> u64 in Trapping
    requires index < 128
    {
        let offset: u64 = checker.queue[index];
        checker.queue_count = index;
        transition offset < 128 {
            true -> unqueued(checker, offset)
            _ -> invalid()
        }
    }

    machine unqueued(checker: &mut Checker, offset: u64) -> u64 in Trapping
    requires offset < 128
    {
        checker.queued[offset] = false;
        offset as u64 in Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

machine Checker::enqueue(checker: &mut Checker, offset: u64 in Trapping)
crashes Trap
{
    transition offset < 128 {
        true -> candidate(checker, offset)
        _ -> invalid()
    }

    machine candidate(checker: &mut Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        let queued: bool = checker.queued[offset];
        transition queued {
            true -> done()
            _ -> push(checker, offset, checker.queue_count)
        }
    }

    machine push(checker: &mut Checker, offset: u64 in Trapping, index: u64)
    requires offset < 128
    {
        transition index < 128 {
            true -> write(checker, offset, index)
            _ -> invalid()
        }
    }

    machine write(checker: &mut Checker, offset: u64 in Trapping, index: u64)
    requires offset < 128, index < 128
    {
        checker.queue[index] = offset as u64;
        checker.queue_count = index + 1;
        checker.queued[offset] = true;
    }

    machine done() {}

    machine invalid() {
        crash Trap;
    }
}

// A jump's contribution to its declaration's arrival: for each pair of the
// declaration's integer and Boolean parameters, the zone's bound on the
// difference of their
// arguments (or of their intervals when either is no linear term), with the
// zero subject for each one's own range. The arrival keeps what every
// contribution so far implies; after three loosenings, bounds that keep
// loosening are dropped.
public machine Checker::contribute(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, call: u64 in Trapping, declaration: u64 in Trapping)
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, call);
    let item: MachineItem = SyntaxTrees::machine_item(syntax, declaration);
    let offset: u64 in Trapping = Checker::body_slot(checker, declaration) - 1;
    let zero: Value = Value::constant(ExactInteger { negative: false, magnitude: 0 });
    Checker::set_projection(checker, 0, zero);
    transition checker.zone.infeasible {
        true -> done()
        _ -> parameter(checker, syntax, typing, expression, item, offset, 0, 1)
    }

    // Project each integer parameter's argument, numbering them as the
    // declaration's body will.
    machine parameter(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: MachineItem,
        offset: u64 in Trapping,
        index: u64 in Trapping,
        subject: u64 in Trapping
    ) {
        transition index < item.parameter_count && index < expression.count {
            true -> argument(checker, syntax, typing, expression, item, offset, index, subject)
            _ -> paths(checker, syntax, typing, expression, item, offset, subject)
        }
    }

    machine argument(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: MachineItem,
        offset: u64 in Trapping,
        index: u64 in Trapping,
        subject: u64 in Trapping
    ) {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, item.first_parameter + index);
        let type_handle: u64 in Trapping = Typing::reference_type(typing, parameter.type_reference);
        let carrier: BuiltinType = Checker::carrier(typing, type_handle);
        let integer: bool = Checker::has_subject(carrier);
        let handle: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + index);
        let value: Value = Checker::value_at(checker, handle);
        transition integer && subject < 64 {
            true -> projected(checker, syntax, typing, expression, item, offset, index, subject, value)
            _ -> parameter(checker, syntax, typing, expression, item, offset, index + 1, subject)
        }
    }

    machine projected(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: MachineItem,
        offset: u64 in Trapping,
        index: u64 in Trapping,
        subject: u64 in Trapping,
        value: Value
    ) {
        Checker::set_projection(checker, subject, value);
        transition { _ -> parameter(checker, syntax, typing, expression, item, offset, index + 1, subject + 1) }
    }

    // Then the field paths below its other arguments.
    machine paths(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, item: MachineItem, offset: u64 in Trapping, first_subject: u64 in Trapping) {
        let count: u64 in Trapping = Checker::project_paths(checker, syntax, typing, expression, item, offset, first_subject);
        transition { _ -> project(checker, offset, count) }
    }

    machine project(checker: &mut Checker, offset: u64 in Trapping, count: u64 in Trapping) {
        Zone::open(&mut checker.contribution, 64);
        transition { _ -> row(checker, offset, count, 0) }
    }

    machine row(checker: &mut Checker, offset: u64 in Trapping, count: u64 in Trapping, from: u64 in Trapping) {
        transition from < count {
            true -> column(checker, offset, count, from, 0)
            _ -> joined(checker, offset)
        }
    }

    machine column(checker: &mut Checker, offset: u64 in Trapping, count: u64 in Trapping, from: u64 in Trapping, to: u64 in Trapping) {
        transition to < count {
            true -> pair(checker, offset, count, from, to)
            _ -> row(checker, offset, count, from + 1)
        }
    }

    machine pair(checker: &mut Checker, offset: u64 in Trapping, count: u64 in Trapping, from: u64 in Trapping, to: u64 in Trapping) {
        let first: Value = Checker::projection_at(checker, from);
        let second: Value = Checker::projection_at(checker, to);
        let bound: Bound = Checker::projected_bound(checker, first, second);
        transition from == to {
            true -> column(checker, offset, count, from, to + 1)
            _ -> stored(checker, offset, count, from, to, bound)
        }
    }

    machine stored(checker: &mut Checker, offset: u64 in Trapping, count: u64 in Trapping, from: u64 in Trapping, to: u64 in Trapping, bound: Bound) {
        Zone::set(&mut checker.contribution, from, to, bound);
        transition { _ -> column(checker, offset, count, from, to + 1) }
    }

    machine joined(checker: &mut Checker, offset: u64 in Trapping) {
        Checker::join_arrival(checker, offset);
    }

    machine done() {}
}

// The bound on `second - first` for two projected argument values.
machine Checker::projected_bound(checker: &Checker, first: Value, second: Value) -> Bound
crashes Trap
{
    transition first.known && second.known {
        true -> related(checker, first, second)
        _ -> intervals(first, second)
    }

    machine related(checker: &Checker, first: Value, second: Value) -> Bound {
        let bound: Bound = Checker::difference_bound(checker, first, second);
        bound
    }

    machine intervals(first: Value, second: Value) -> Bound {
        let bound: Bound = Bound::add(second.ceiling, first.floor);
        bound
    }
}

machine Checker::join_arrival(checker: &mut Checker, offset: u64 in Trapping)
crashes Trap
{
    transition offset < 128 {
        true -> arrival(checker, offset)
        _ -> invalid()
    }

    machine arrival(checker: &mut Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        let reached: bool = checker.reached[offset];
        transition reached {
            true -> loosen(checker, offset)
            _ -> first(checker, offset)
        }
    }

    machine first(checker: &mut Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        let order: u64 in Trapping = checker.discovered as u64 in Trapping;
        let next: u64 in Trapping = order + 1;
        checker.arrivals[offset] = checker.contribution;
        checker.reached[offset] = true;
        checker.discovery[offset] = order as u64;
        checker.discovered = next as u64;
        Checker::enqueue(checker, offset);
    }

    machine loosen(checker: &mut Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        checker.previous = checker.arrivals[offset];
        checker.merged = checker.arrivals[offset];
        let changed: bool = Zone::join(&mut checker.merged, &checker.contribution);
        transition changed {
            true -> loosened(checker, offset)
            _ -> done()
        }
    }

    machine loosened(checker: &mut Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        let count: u64 in Trapping = checker.loosenings[offset] as u64 in Trapping;
        let next: u64 in Trapping = count + 1;
        checker.loosenings[offset] = next as u64;
        let back: bool = Checker::back_edge(checker, offset);
        transition count >= 3 && back {
            true -> widen(checker, offset)
            _ -> store(checker, offset)
        }
    }

    machine widen(checker: &mut Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        Zone::widen(&mut checker.merged, &checker.previous);
        transition { _ -> store(checker, offset) }
    }

    machine store(checker: &mut Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        checker.arrivals[offset] = checker.merged;
        Checker::enqueue(checker, offset);
    }

    machine done() {}

    machine invalid() {
        crash Trap;
    }
}

machine Checker::set_projection(checker: &mut Checker, subject: u64 in Trapping, value: Value)
crashes Trap
{
    transition subject < 64 {
        true -> write(checker, subject, value)
        _ -> invalid()
    }

    machine write(checker: &mut Checker, subject: u64 in Trapping, value: Value)
    requires subject < 64
    {
        checker.projection[subject] = value;
    }

    machine invalid() {
        crash Trap;
    }
}

machine Checker::projection_at(checker: &Checker, subject: u64 in Trapping) -> Value
crashes Trap
{
    transition subject < 64 {
        true -> read(checker, subject)
        _ -> invalid()
    }

    machine read(checker: &Checker, subject: u64 in Trapping) -> Value
    requires subject < 64
    {
        checker.projection[subject]
    }

    machine invalid() -> Value {
        crash Trap;
    }
}

// Record a call to a machine for crash-route settlement. A machine binder's
// call derives the causes its `where machine` contract declares.
public machine Checker::record_call(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, selection: Selection)
crashes Trap
{
    transition selection {
        Selection::Machine { handle } -> machine(checker, handle)
        Selection::Binder { parameter } -> binder(checker, syntax, resolution, selection)
        _ -> done()
    }

    machine binder(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, selection: Selection) {
        let clauses: CallClauses = Checker::call_clauses(syntax, resolution, selection);
        let causes: CrashRoutes = Checker::declared_causes(syntax, clauses.first_clause, clauses.clause_count);
        checker.trap_route = checker.trap_route || causes.declares_trap;
        checker.abort_route = checker.abort_route || causes.declares_abort;
        Checker::record_binder_call(checker);
    }

    machine machine(checker: &mut Checker, callee: u64 in Trapping) {
        transition checker.call_count < 32768 {
            true -> write(checker, checker.call_count, callee)
            _ -> full(checker)
        }
    }

    machine write(checker: &mut Checker, index: u64, callee: u64 in Trapping)
    requires index < 32768
    {
        checker.callers[index] = checker.machine as u64;
        checker.callees[index] = callee as u64;
        checker.call_count = index + 1;
    }

    machine full(checker: &mut Checker) {
        checker.overflowed = true;
    }

    machine done() {}
}

// A call of machine `callee` from machine `caller` that supplies its
// machine binders static arguments.
public data SuppliedCall [copy] {
    caller: u64;
    call: u64;
    callee: u64;
}

// Record a call whose selected machine has machine binders: its static
// arguments must refine their contracts, which supply.omg decides once
// crash routes settle.
public machine Checker::record_supply(checker: &mut Checker, syntax: &SyntaxTrees, selection: Selection, call: u64 in Trapping)
crashes Trap
{
    transition selection {
        Selection::Machine { handle } -> selected(checker, syntax, call, handle)
        _ -> done()
    }

    machine selected(checker: &mut Checker, syntax: &SyntaxTrees, call: u64 in Trapping, callee: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, callee);
        let binds: bool = Checker::binds_machines(syntax, item.first_generic_parameter, item.generic_parameter_count);
        transition binds {
            true -> supplying(checker, call, callee)
            _ -> done()
        }
    }

    machine supplying(checker: &mut Checker, call: u64 in Trapping, callee: u64 in Trapping) {
        transition checker.supplied_count < 1024 {
            true -> write(checker, checker.supplied_count, call, callee)
            _ -> full(checker)
        }
    }

    machine write(checker: &mut Checker, index: u64, call: u64 in Trapping, callee: u64 in Trapping)
    requires index < 1024
    {
        checker.supplied[index] = SuppliedCall { caller: checker.machine as u64, call: call as u64, callee: callee as u64 };
        checker.supplied_count = index + 1;
    }

    machine full(checker: &mut Checker) {
        checker.overflowed = true;
    }

    machine done() {}
}

// Whether any generic parameter in `first .. first + count` is a machine
// binder.
public machine Checker::binds_machines(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(syntax, first, count, 0) }

    machine next(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> parameter(syntax, first, count, offset)
            _ -> none()
        }
    }

    machine parameter(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let generic: GenericParameter = SyntaxTrees::generic_parameter(syntax, first + offset);
        transition generic.kind == GenericParameterKind::Machine {
            true -> found()
            _ -> next(syntax, first, count, offset + 1)
        }
    }

    machine found() -> bool {
        true
    }

    machine none() -> bool {
        false
    }
}

// After a call, what the callee may write through an exclusive argument may
// have changed (frames.omg): everything below the argument when the callee
// may replace its parameter's whole referent or its writes are unknown (a
// machine binder's always are), else each field place below it whose field
// the callee may write.
public machine Checker::release_exclusive_arguments(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, selection: Selection)
crashes Trap
{
    transition selection {
        Selection::Machine { handle } -> framed(checker, syntax, typing, expression, handle)
        _ -> unframed(checker, syntax, typing, expression)
    }

    machine framed(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, callee: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, callee);
        let unknown: bool = Checker::writes_unknown(checker, callee);
        transition { _ -> next(checker, syntax, typing, expression, callee, item.first_parameter, item.parameter_count, unknown, 0) }
    }

    // Unknown writes release every exclusive argument whole, so no callee
    // frame is read.
    machine unframed(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression) {
        transition { _ -> next(checker, syntax, typing, expression, 0, 0, 0, true, 0) }
    }

    machine next(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping) {
        let count: u64 in Trapping = Checker::operand_count(expression);
        transition offset < count {
            true -> argument(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset)
            _ -> done()
        }
    }

    machine argument(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping) {
        let handle: u64 in Trapping = Checker::operand(syntax, expression, offset);
        let value: Value = Checker::value_at(checker, handle);
        let exclusive: bool = Checker::exclusive_value(typing, handle);
        let whole: bool = Checker::writes_whole(checker, first_parameter + offset);
        transition exclusive {
            true -> origin(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, handle, unknown || whole || offset >= parameter_count)
            _ -> next(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset + 1)
        }
    }

    machine origin(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, handle: u64 in Trapping, whole: bool) {
        let place: u64 in Trapping = Checker::storage_origin(checker, syntax, typing, handle);
        transition place > 0 {
            true -> lent(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, handle, place, whole)
            _ -> unknown_origin(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, whole)
        }
    }

    // A complete empty frame cannot mutate even an unknown referent. Any
    // nonempty frame needs an origin; a returned reference is not evidence
    // of a disjoint new place.
    machine unknown_origin(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, whole: bool) {
        let changes: bool = Checker::frame_changes(checker, syntax, callee, whole);
        transition changes {
            true -> unrepresented(checker, expression)
            _ -> next(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset + 1)
        }
    }

    machine unrepresented(checker: &mut Checker, expression: Expression) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::UnsupportedCheck, expression.source_span);
    }

    // The operands evaluated before the call keep what they read there.
    machine lent(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        callee: u64 in Trapping,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        unknown: bool,
        offset: u64 in Trapping,
        lender: u64 in Trapping,
        place: u64 in Trapping,
        whole: bool
    ) {
        let changes: bool = Checker::frame_changes(checker, syntax, callee, whole);
        transition changes {
            true -> changed(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, lender, place, whole)
            _ -> next(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset + 1)
        }
    }

    machine changed(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, lender: u64 in Trapping, place: u64 in Trapping, whole: bool) {
        checker.write_epoch = checker.write_epoch + 1;
        let write: WriteFootprint = WriteFootprint { place: place, callee: callee, whole: whole };
        Checker::snapshot_operands(checker, syntax, typing, expression, lender, write);
        transition whole {
            true -> released(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, place)
            _ -> narrowed(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, place)
        }
    }

    machine released(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, place: u64 in Trapping) {
        Checker::forget_place(checker, typing, place);
        transition { _ -> next(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset + 1) }
    }

    machine narrowed(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, place: u64 in Trapping) {
        Checker::forget_written_fields(checker, typing, place, callee);
        transition { _ -> next(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset + 1) }
    }

    machine done() {}
}

// An empty complete write frame changes no storage and must not prevent
// replay. Unknown/whole writes always count; named field writes may be
// pending and therefore need not have a place yet.
machine Checker::frame_changes(checker: &Checker, syntax: &SyntaxTrees, callee: u64 in Trapping, whole: bool) -> bool
crashes Trap
{
    transition whole {
        true -> answer(true)
        _ -> field(checker, syntax, callee, 0)
    }

    machine field(checker: &Checker, syntax: &SyntaxTrees, callee: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < syntax.field_count {
            true -> inspected(checker, syntax, callee, index)
            _ -> answer(false)
        }
    }

    machine inspected(checker: &Checker, syntax: &SyntaxTrees, callee: u64 in Trapping, index: u64 in Trapping) -> bool {
        let writes: bool = Checker::writes_field(checker, callee, index);
        transition writes {
            true -> answer(true)
            _ -> field(checker, syntax, callee, index + 1)
        }
    }

    machine answer(changes: bool) -> bool {
        changes
    }
}

// Forget each field place strictly below `place` (one-based) whose field
// `callee` may write, with everything inside it.
public machine Checker::forget_written_fields(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, callee: u64 in Trapping)
crashes Trap
{
    Checker::settle_written_pending(checker, typing, place, callee);
    Checker::forget_aliases(checker, place);
    transition { _ -> next(checker, typing, place, callee, 0) }

    machine next(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, callee: u64 in Trapping, index: u64 in Trapping) {
        transition index < checker.place_count {
            true -> visit(checker, typing, place, callee, index)
            _ -> done()
        }
    }

    machine visit(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, callee: u64 in Trapping, index: u64 in Trapping) {
        let candidate: Place = Checker::place_at(checker, index);
        let inside: bool = Checker::within(checker, index + 1, place);
        let written: bool = Checker::writes_field(checker, callee, candidate.handle);
        transition index + 1 != place && inside && candidate.kind == PlaceKind::Field && written {
            true -> forgotten(checker, typing, place, callee, index)
            _ -> next(checker, typing, place, callee, index + 1)
        }
    }

    machine forgotten(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, callee: u64 in Trapping, index: u64 in Trapping) {
        Checker::forget_place(checker, typing, index + 1);
        transition { _ -> next(checker, typing, place, callee, index + 1) }
    }

    machine done() {}
}

// Settle crash routes over the call graph: a caller derives each cause its
// callees publish, a callee inferring its causes publishes what it derives
// and any other publishes what it declares, until nothing changes. Then a
// machine that does not infer must declare every cause it derives.
machine Checker::settle_routes(checker: &mut Checker, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> sweep(checker, syntax, 0, false) }

    machine sweep(checker: &mut Checker, syntax: &SyntaxTrees, index: u64 in Trapping, changed: bool) {
        transition index < checker.call_count {
            true -> edge(checker, syntax, index, changed)
            _ -> swept(checker, syntax, changed)
        }
    }

    machine edge(checker: &mut Checker, syntax: &SyntaxTrees, index: u64 in Trapping, changed: bool) {
        let call: u64 in Trapping = index;
        let caller: u64 in Trapping = Checker::caller_at(checker, call);
        let callee: u64 in Trapping = Checker::callee_at(checker, call);
        let from: CrashRoutes = Checks::routes(&checker.output, callee);
        let into: CrashRoutes = Checks::routes(&checker.output, caller);
        let trap: bool = Checker::published(from.inferred, from.trap, from.declares_trap);
        let abort: bool = Checker::published(from.inferred, from.abort, from.declares_abort);
        let gained: bool = (trap && !into.trap) || (abort && !into.abort);
        transition gained {
            true -> gain(checker, syntax, index, caller, into, trap, abort)
            _ -> sweep(checker, syntax, index + 1, changed)
        }
    }

    machine gain(checker: &mut Checker, syntax: &SyntaxTrees, index: u64 in Trapping, caller: u64 in Trapping, into: CrashRoutes, trap: bool, abort: bool) {
        let routes: CrashRoutes = CrashRoutes {
            declares_trap: into.declares_trap,
            declares_abort: into.declares_abort,
            inferred: into.inferred,
            trap: into.trap || trap,
            abort: into.abort || abort
        };
        Checks::set_routes(&mut checker.output, caller, routes);
        transition { _ -> sweep(checker, syntax, index + 1, true) }
    }

    machine swept(checker: &mut Checker, syntax: &SyntaxTrees, changed: bool) {
        transition changed {
            true -> sweep(checker, syntax, 0, false)
            _ -> fit(checker, syntax, 0)
        }
    }

    machine fit(checker: &mut Checker, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count && checker.output.diagnostic_count < 64 {
            true -> machine(checker, syntax, index)
            _ -> done()
        }
    }

    machine machine(checker: &mut Checker, syntax: &SyntaxTrees, index: u64 in Trapping) {
        Checks::open_machine(&mut checker.output);
        let routes: CrashRoutes = Checks::routes(&checker.output, index);
        let undeclared: bool = !routes.inferred
            && ((routes.trap && !routes.declares_trap) || (routes.abort && !routes.declares_abort));
        transition undeclared {
            true -> rejected(checker, syntax, index)
            _ -> fit(checker, syntax, index + 1)
        }
    }

    machine rejected(checker: &mut Checker, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CrashNotDeclared, item.source_span);
        transition { _ -> fit(checker, syntax, index + 1) }
    }

    machine done() {}
}

// What a callee publishes for one cause.
public machine Checker::published(inferred: bool, derived: bool, declared: bool) -> bool {
    transition inferred {
        true -> chosen(derived)
        _ -> chosen(declared)
    }

    machine chosen(cause: bool) -> bool {
        cause
    }
}

machine Checker::caller_at(checker: &Checker, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < checker.call_count && index < 32768 {
        true -> read(checker, index)
        _ -> invalid()
    }

    machine read(checker: &Checker, index: u64 in Trapping) -> u64 in Trapping
    requires index < 32768
    {
        checker.callers[index] as u64 in Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

machine Checker::callee_at(checker: &Checker, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < checker.call_count && index < 32768 {
        true -> read(checker, index)
        _ -> invalid()
    }

    machine read(checker: &Checker, index: u64 in Trapping) -> u64 in Trapping
    requires index < 32768
    {
        checker.callees[index] as u64 in Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// Whether the body being walked jumps back to declaration `offset`: a declaration reached
// no later than its own, itself included.
machine Checker::back_edge(checker: &Checker, offset: u64 in Trapping) -> bool
crashes Trap
{
    let walking: u64 in Trapping = checker.walking as u64 in Trapping;
    transition walking > 0 && walking <= 128 && offset < 128 {
        true -> compared(checker, offset, walking - 1)
        _ -> forward()
    }

    machine compared(checker: &Checker, offset: u64 in Trapping, source: u64 in Trapping) -> bool
    requires offset < 128, source < 128
    {
        let target_order: u64 = checker.discovery[offset];
        let source_order: u64 = checker.discovery[source];
        target_order <= source_order
    }

    machine forward() -> bool {
        false
    }
}

// The declaration group closes private uses; graph edges still come only from
// selected calls with explicit evaluated actuals. Slot zero is the public/root
// invocation, whose arbitrary entry inputs prevent importing a recursive caller's facts.
public machine Checker::collect_bodies(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping)
crashes Trap
{
    checker.body_count = 0;
    transition { _ -> candidate(checker, syntax, root, 0) }
    machine candidate(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> ancestry(checker, syntax, root, index, index)
            false -> done()
        }
    }
    machine ancestry(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping, ancestor: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, ancestor);
        transition item.parent > 0 {
            true -> parent(checker, syntax, root, index, item.parent - 1)
            false -> candidate(checker, syntax, root, index + 1)
        }
    }
    machine parent(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping, ancestor: u64 in Trapping) {
        transition ancestor == root {
            true -> retain(checker, syntax, root, index)
            false -> ancestry(checker, syntax, root, index, ancestor)
        }
    }
    machine retain(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping) {
        transition checker.body_count < 128 {
            true -> bounded(checker, syntax, root, index, checker.body_count)
            false -> full(checker)
        }
    }
    machine bounded(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping, slot: u64 in Trapping)
    requires slot < 128
    {
        checker.bodies[slot] = index as u64;
        checker.body_count = slot + 1;
        transition { _ -> candidate(checker, syntax, root, index + 1) }
    }
    machine full(checker: &mut Checker) { checker.overflowed = true; }
    machine done() {}
}

public machine Checker::body_handle(checker: &Checker, slot: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition slot < checker.body_count && slot < 128 {
        true -> checker.bodies[slot] as u64 in Trapping
        false -> invalid()
    }
    machine invalid() -> u64 in Trapping { crash Trap; }
}

// Slot+1; zero means either the root entry or a call outside this graph.
public machine Checker::body_slot(checker: &Checker, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> candidate(checker, handle, 0) }
    machine candidate(checker: &Checker, handle: u64 in Trapping, slot: u64 in Trapping) -> u64 in Trapping {
        transition slot < checker.body_count && slot < 128 {
            true -> compare(checker, handle, slot)
            false -> 0
        }
    }
    machine compare(checker: &Checker, handle: u64 in Trapping, slot: u64 in Trapping) -> u64 in Trapping
    requires slot < 128
    {
        transition checker.bodies[slot] == handle {
            true -> (slot + 1)
            false -> candidate(checker, handle, slot + 1)
        }
    }
}

// Each declaration publishes its own body routes; call-graph settlement composes them.
machine Checker::publish_body_routes(checker: &mut Checker, index: u64 in Trapping)
crashes Trap
{
        let routes: CrashRoutes = Checks::routes(&checker.output, index);
        let local: CrashRoutes = CrashRoutes {
            declares_trap: routes.declares_trap,
            declares_abort: routes.declares_abort,
            inferred: routes.inferred,
            trap: checker.trap_route,
            abort: checker.abort_route
        };
        Checks::set_routes(&mut checker.output, index, local);
}
