use psi::checking::checker;
use psi::checking::obligations;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// Write frames (wiki/spec/language/dependent_values.md#mutation-frames). A
// call's exclusive arguments may change only what the callee writes through
// them, so a checked implementation may derive a narrower frame from the
// callee's bodies than everything the loans reach. A machine's frame, over
// its entry body and every state body, is:
//
// - per parameter, whether the machine may replace the whole referent of an
//   exclusive parameter: an assignment to the parameter itself, an element
//   store into it (`p[i] = v`), or passing it on to a callee or state
//   parameter that may;
// - the data fields it may write anywhere through an exclusive loan: a
//   store whose target ends in a field (`p.a.b = v`, `p.a[i] = v` writes
//   `a`), or the field a borrowed argument names when a callee may replace
//   its whole referent, with every callee's fields too;
// - whether its writes are unknown: a write through a reference local or
//   pattern binder, a call to a machine without a body, or an exclusive
//   argument to anything but a machine or state. Such a machine keeps the
//   conservative frame: its exclusive arguments lose everything below them.
//
// Writes to a body's own locals and by-value parameters stay out of its
// frame. Frames settle to a fixed point over the call graph before any body
// is checked, so a recursive machine's frame includes its own writes.
pub machine Checker::derive_frames(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing)
crashes Trap
{
    transition { _ -> clear_parameter(checker, syntax, resolution, typing, 0) }

    state clear_parameter(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        transition index < syntax.parameter_count && index < 32768 {
            true -> parameter_cleared(checker, syntax, resolution, typing, index)
            _ -> clear_machine(checker, syntax, resolution, typing, 0)
        }
    }

    state parameter_cleared(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping)
    requires index < 32768
    {
        checker.whole_writes[index] = false;
        transition { _ -> clear_parameter(checker, syntax, resolution, typing, index + 1) }
    }

    state clear_machine(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        transition index < syntax.machine_count && index < 2048 {
            true -> machine_cleared(checker, syntax, resolution, typing, index)
            _ -> round(checker, syntax, resolution, typing)
        }
    }

    state machine_cleared(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping)
    requires index < 2048
    {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        checker.unknown_writes[index] = !item.has_body;
        Checker::clear_field_writes(checker, index);
        transition { _ -> clear_machine(checker, syntax, resolution, typing, index + 1) }
    }

    state round(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing) {
        transition { _ -> next(checker, syntax, resolution, typing, 0, false) }
    }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, changed: bool) {
        transition index < syntax.machine_count {
            true -> machine(checker, syntax, resolution, typing, index, changed)
            _ -> settled(checker, syntax, resolution, typing, changed)
        }
    }

    state machine(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, changed: bool) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let grew: bool = Checker::frame_machine(checker, syntax, resolution, typing, index, item);
        transition { _ -> next(checker, syntax, resolution, typing, index + 1, changed || grew) }
    }

    state settled(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, changed: bool) {
        transition changed {
            true -> round(checker, syntax, resolution, typing)
            _ -> done()
        }
    }

    state done() {}
}

// One pass over a machine's writes: its bodies' stores, then every call and
// jump in its expressions. Whether its frame grew.
machine Checker::frame_machine(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, item: MachineItem) -> bool
crashes Trap
{
    transition item.has_body {
        true -> entry(checker, syntax, resolution, typing, machine, item)
        _ -> unchanged()
    }

    state entry(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, item: MachineItem) -> bool {
        let stores: bool = Checker::frame_stores(checker, syntax, resolution, typing, machine, item.first_statement, item.statement_count);
        transition { _ -> member_state(checker, syntax, resolution, typing, machine, item, 0, stores) }
    }

    state member_state(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, item: MachineItem, offset: u64 in Trapping, changed: bool) -> bool {
        transition offset < item.state_count {
            true -> state_stores(checker, syntax, resolution, typing, machine, item, offset, changed)
            _ -> expression(checker, syntax, resolution, typing, machine, item, 0, changed)
        }
    }

    state state_stores(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, item: MachineItem, offset: u64 in Trapping, changed: bool) -> bool {
        let body: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        let stores: bool = Checker::frame_stores(checker, syntax, resolution, typing, machine, body.first_statement, body.statement_count);
        transition { _ -> member_state(checker, syntax, resolution, typing, machine, item, offset + 1, changed || stores) }
    }

    state expression(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, item: MachineItem, offset: u64 in Trapping, changed: bool) -> bool {
        transition offset < item.expression_count {
            true -> selected(checker, syntax, resolution, typing, machine, item, offset, changed)
            _ -> finished(changed)
        }
    }

    state selected(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, item: MachineItem, offset: u64 in Trapping, changed: bool) -> bool {
        let handle: u64 in Trapping = item.first_expression + offset;
        let grew: bool = Checker::frame_call(checker, syntax, resolution, typing, machine, handle);
        transition { _ -> expression(checker, syntax, resolution, typing, machine, item, offset + 1, changed || grew) }
    }

    state finished(changed: bool) -> bool {
        changed
    }

    state unchanged() -> bool {
        false
    }
}

// The assignments among a body's statements.
machine Checker::frame_stores(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, first: u64 in Trapping, count: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, machine, first, first + count, false) }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, changed: bool) -> bool {
        transition index < end {
            true -> statement(checker, syntax, resolution, typing, machine, index, end, changed)
            _ -> finished(changed)
        }
    }

    state statement(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, changed: bool) -> bool {
        let statement: Statement = SyntaxTrees::statement(syntax, index);
        transition statement.kind == StatementKind::Assign {
            true -> stored(checker, syntax, resolution, typing, machine, index, end, changed, statement.target)
            _ -> next(checker, syntax, resolution, typing, machine, index + 1, end, changed)
        }
    }

    state stored(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, changed: bool, target: u64 in Trapping) -> bool {
        let grew: bool = Checker::frame_write(checker, syntax, resolution, typing, machine, target);
        transition { _ -> next(checker, syntax, resolution, typing, machine, index + 1, end, changed || grew) }
    }

    state finished(changed: bool) -> bool {
        changed
    }
}

// A call or jump at `handle`: a machine's frame joins the caller's, and an
// exclusive argument whose parameter may be replaced whole is written whole
// in the caller; an exclusive argument to anything else is an unknown write.
machine Checker::frame_call(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, handle: u64 in Trapping) -> bool
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, handle);
    let selection: Selection = Typing::selection(typing, handle);
    transition expression.kind == ExpressionKind::Call || expression.kind == ExpressionKind::Binary {
        true -> called(checker, syntax, resolution, typing, machine, expression, selection)
        _ -> unchanged()
    }

    state called(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, expression: Expression, selection: Selection) -> bool {
        transition selection {
            Selection::Machine { handle } -> callee(checker, syntax, resolution, typing, machine, expression, handle)
            Selection::State { handle } -> jump(checker, syntax, resolution, typing, machine, expression, handle)
            _ -> opaque(checker, syntax, typing, machine, expression)
        }
    }

    state callee(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, expression: Expression, callee: u64 in Trapping) -> bool {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, callee);
        let unknown: bool = Checker::writes_unknown(checker, callee);
        let fields: bool = Checker::merge_field_writes(checker, machine, callee);
        let spread: bool = Checker::mark_unknown(checker, machine, unknown);
        let passed: bool = Checker::frame_arguments(checker, syntax, resolution, typing, machine, expression, item.first_parameter, item.parameter_count, unknown);
        fields || spread || passed
    }

    state jump(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, expression: Expression, target_state: u64 in Trapping) -> bool {
        let item: StateItem = SyntaxTrees::state_item(syntax, target_state);
        let passed: bool = Checker::frame_arguments(checker, syntax, resolution, typing, machine, expression, item.first_parameter, item.parameter_count, false);
        passed
    }

    state opaque(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, machine: u64 in Trapping, expression: Expression) -> bool {
        let lends: bool = Checker::lends_exclusively(syntax, typing, expression);
        let marked: bool = Checker::mark_unknown(checker, machine, lends);
        marked
    }

    state unchanged() -> bool {
        false
    }
}

// Each exclusive argument whose parameter (from `first_parameter`) may be
// replaced whole, or every one when the callee's writes are unknown, is a
// whole write of what the argument names.
machine Checker::frame_arguments(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    machine: u64 in Trapping,
    expression: Expression,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping,
    unknown: bool
) -> bool
crashes Trap
{
    let count: u64 in Trapping = Checker::operand_count(expression);
    transition { _ -> next(checker, syntax, resolution, typing, machine, expression, first_parameter, parameter_count, unknown, count, 0, false) }

    state next(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        machine: u64 in Trapping,
        expression: Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        unknown: bool,
        count: u64 in Trapping,
        offset: u64 in Trapping,
        changed: bool
    ) -> bool {
        transition offset < count && offset < parameter_count {
            true -> argument(checker, syntax, resolution, typing, machine, expression, first_parameter, parameter_count, unknown, count, offset, changed)
            _ -> finished(changed)
        }
    }

    state argument(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        machine: u64 in Trapping,
        expression: Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        unknown: bool,
        count: u64 in Trapping,
        offset: u64 in Trapping,
        changed: bool
    ) -> bool {
        let handle: u64 in Trapping = Checker::operand(syntax, expression, offset);
        let exclusive: bool = Checker::exclusive_value(typing, handle);
        let whole: bool = Checker::writes_whole(checker, first_parameter + offset);
        transition exclusive && (unknown || whole) {
            true -> written(checker, syntax, resolution, typing, machine, expression, first_parameter, parameter_count, unknown, count, offset, changed, handle)
            _ -> next(checker, syntax, resolution, typing, machine, expression, first_parameter, parameter_count, unknown, count, offset + 1, changed)
        }
    }

    state written(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        machine: u64 in Trapping,
        expression: Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        unknown: bool,
        count: u64 in Trapping,
        offset: u64 in Trapping,
        changed: bool,
        handle: u64 in Trapping
    ) -> bool {
        let grew: bool = Checker::frame_write(checker, syntax, resolution, typing, machine, handle);
        transition { _ -> next(checker, syntax, resolution, typing, machine, expression, first_parameter, parameter_count, unknown, count, offset + 1, changed || grew) }
    }

    state finished(changed: bool) -> bool {
        changed
    }
}

// A write of the place expression `handle` names, walking through borrows,
// element indexes and fields to its root: the first field the walk meets
// (`p.a.b = v` writes `b`, `p.a[i] = v` writes `a`), or, meeting none, the
// whole referent of the exclusive parameter at its root. A root local or
// by-value parameter is the body's own storage; a root reference local or
// binder, or any other root, is an unknown write.
machine Checker::frame_write(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, handle: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> step(checker, syntax, resolution, typing, machine, handle, false, 0) }

    // `fielded` once the walk has met a field, `written` that field.
    state step(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        machine: u64 in Trapping,
        current: u64 in Trapping,
        fielded: bool,
        written: u64 in Trapping
    ) -> bool {
        let expression: Expression = SyntaxTrees::expression(syntax, current);
        transition expression.kind {
            ExpressionKind::Field -> member(checker, syntax, resolution, typing, machine, current, expression, fielded, written)
            ExpressionKind::Index -> step(checker, syntax, resolution, typing, machine, expression.left, fielded, written)
            ExpressionKind::Unary -> borrowed(checker, syntax, resolution, typing, machine, expression, fielded, written)
            ExpressionKind::Name -> root(checker, resolution, typing, machine, current, fielded, written)
            _ -> unknown(checker, machine)
        }
    }

    state member(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        machine: u64 in Trapping,
        current: u64 in Trapping,
        expression: Expression,
        fielded: bool,
        written: u64 in Trapping
    ) -> bool {
        let selection: Selection = Typing::selection(typing, current);
        transition selection {
            Selection::Field { field } -> met(checker, syntax, resolution, typing, machine, expression, fielded, written, field)
            _ -> unknown(checker, machine)
        }
    }

    state met(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        machine: u64 in Trapping,
        expression: Expression,
        fielded: bool,
        written: u64 in Trapping,
        field: u64 in Trapping
    ) -> bool {
        transition fielded {
            true -> step(checker, syntax, resolution, typing, machine, expression.left, true, written)
            _ -> step(checker, syntax, resolution, typing, machine, expression.left, true, field)
        }
    }

    state borrowed(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        machine: u64 in Trapping,
        expression: Expression,
        fielded: bool,
        written: u64 in Trapping
    ) -> bool {
        let borrow: bool = expression.operator == OperatorKind::BorrowMutable || expression.operator == OperatorKind::Borrow
            || expression.operator == OperatorKind::BorrowWrite;
        transition borrow {
            true -> step(checker, syntax, resolution, typing, machine, expression.left, fielded, written)
            _ -> unknown(checker, machine)
        }
    }

    state root(checker: &mut Checker, resolution: &NameResolution, typing: &Typing, machine: u64 in Trapping, current: u64 in Trapping, fielded: bool, written: u64 in Trapping) -> bool {
        let binding: ValueBinding = NameResolution::value_binding(resolution, current);
        let exclusive: bool = Checker::exclusive_value(typing, current);
        let shared: bool = Checker::shared_value(typing, current);
        transition binding {
            ValueBinding::Parameter { parameter } -> parameter(checker, machine, parameter, fielded, written, exclusive || shared)
            ValueBinding::Local { statement } -> owned(checker, machine, exclusive || shared)
            ValueBinding::PatternBinder { field as _ } -> owned(checker, machine, exclusive || shared)
            _ -> unknown(checker, machine)
        }
    }

    // Through a parameter holding a reference: a field it reaches, or its
    // whole referent. A by-value parameter is the body's own.
    state parameter(checker: &mut Checker, machine: u64 in Trapping, parameter: u64 in Trapping, fielded: bool, written: u64 in Trapping, referent: bool) -> bool {
        transition referent {
            true -> through(checker, machine, parameter, fielded, written)
            _ -> unchanged()
        }
    }

    state through(checker: &mut Checker, machine: u64 in Trapping, parameter: u64 in Trapping, fielded: bool, written: u64 in Trapping) -> bool {
        transition fielded {
            true -> field_written(checker, machine, written)
            _ -> whole(checker, parameter)
        }
    }

    state field_written(checker: &mut Checker, machine: u64 in Trapping, field: u64 in Trapping) -> bool {
        let grew: bool = Checker::add_field_write(checker, machine, field);
        grew
    }

    state whole(checker: &mut Checker, parameter: u64 in Trapping) -> bool {
        let grew: bool = Checker::mark_whole(checker, parameter);
        grew
    }

    // A local or binder holding a reference writes what it borrows, which
    // this pass does not follow; one holding a value is the body's own.
    state owned(checker: &mut Checker, machine: u64 in Trapping, referent: bool) -> bool {
        transition referent {
            true -> unknown(checker, machine)
            _ -> unchanged()
        }
    }

    state unknown(checker: &mut Checker, machine: u64 in Trapping) -> bool {
        let grew: bool = Checker::mark_unknown(checker, machine, true);
        grew
    }

    state unchanged() -> bool {
        false
    }
}

// Whether any of a call's operands is lent exclusively.
machine Checker::lends_exclusively(syntax: &SyntaxTrees, typing: &Typing, expression: Expression) -> bool
crashes Trap
{
    let count: u64 in Trapping = Checker::operand_count(expression);
    transition { _ -> next(syntax, typing, expression, count, 0) }

    state next(syntax: &SyntaxTrees, typing: &Typing, expression: Expression, count: u64 in Trapping, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> operand(syntax, typing, expression, count, offset)
            _ -> none()
        }
    }

    state operand(syntax: &SyntaxTrees, typing: &Typing, expression: Expression, count: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let handle: u64 in Trapping = Checker::operand(syntax, expression, offset);
        let exclusive: bool = Checker::exclusive_value(typing, handle);
        transition exclusive {
            true -> some()
            _ -> next(syntax, typing, expression, count, offset + 1)
        }
    }

    state some() -> bool {
        true
    }

    state none() -> bool {
        false
    }
}

// Whether an expression supplies a live exclusive (`&mut`) reference.
// A scalar Read consumes the referent's captured value instead.
pub machine Checker::exclusive_value(typing: &Typing, handle: u64 in Trapping) -> bool
crashes Trap
{
    let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
    let row: TypeRow = TypeTable::row(&typing.types, type_handle);
    let adaptation: Adaptation = Typing::adaptation(typing, handle);
    row.kind == TypeKind::Reference && row.access != ReferenceAccess::Shared && adaptation != Adaptation::Read
}

// Whether an expression's value is a shared (`&`) reference.
machine Checker::shared_value(typing: &Typing, handle: u64 in Trapping) -> bool
crashes Trap
{
    let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
    let row: TypeRow = TypeTable::row(&typing.types, type_handle);
    let adaptation: Adaptation = Typing::adaptation(typing, handle);
    row.kind == TypeKind::Reference && row.access == ReferenceAccess::Shared && adaptation != Adaptation::Read
}

// Frame tables, guarded by their bounds; a write beyond them is unknown.
pub machine Checker::writes_unknown(checker: &Checker, machine: u64 in Trapping) -> bool {
    transition machine < 2048 {
        true -> read(checker, machine)
        _ -> unknown()
    }

    state read(checker: &Checker, machine: u64 in Trapping) -> bool
    requires machine < 2048
    {
        checker.unknown_writes[machine]
    }

    state unknown() -> bool {
        true
    }
}

// Mark a machine's writes unknown when `unknown`; whether that changed.
machine Checker::mark_unknown(checker: &mut Checker, machine: u64 in Trapping, unknown: bool) -> bool {
    let marked: bool = Checker::writes_unknown(checker, machine);
    transition unknown && !marked && machine < 2048 {
        true -> mark(checker, machine)
        _ -> unchanged()
    }

    state mark(checker: &mut Checker, machine: u64 in Trapping) -> bool
    requires machine < 2048
    {
        checker.unknown_writes[machine] = true;
        true
    }

    state unchanged() -> bool {
        false
    }
}

pub machine Checker::writes_whole(checker: &Checker, parameter: u64 in Trapping) -> bool {
    transition parameter < 32768 {
        true -> read(checker, parameter)
        _ -> whole()
    }

    state read(checker: &Checker, parameter: u64 in Trapping) -> bool
    requires parameter < 32768
    {
        checker.whole_writes[parameter]
    }

    state whole() -> bool {
        true
    }
}

machine Checker::mark_whole(checker: &mut Checker, parameter: u64 in Trapping) -> bool {
    let marked: bool = Checker::writes_whole(checker, parameter);
    transition !marked && parameter < 32768 {
        true -> mark(checker, parameter)
        _ -> unchanged()
    }

    state mark(checker: &mut Checker, parameter: u64 in Trapping) -> bool
    requires parameter < 32768
    {
        checker.whole_writes[parameter] = true;
        true
    }

    state unchanged() -> bool {
        false
    }
}

// Whether a machine may write a data field (`SyntaxTrees::fields`); a field
// or machine beyond the tables may be written.
pub machine Checker::writes_field(checker: &Checker, machine: u64 in Trapping, field: u64 in Trapping) -> bool
crashes Trap
{
    transition machine < 2048 && field < 1024 {
        true -> read(checker, machine * 1024 + field)
        _ -> written()
    }

    state read(checker: &Checker, index: u64 in Trapping) -> bool {
        transition index < 2097152 {
            true -> entry(checker, index)
            _ -> written()
        }
    }

    state entry(checker: &Checker, index: u64 in Trapping) -> bool
    requires index < 2097152
    {
        checker.field_writes[index]
    }

    state written() -> bool {
        true
    }
}

// Record a field write; a field beyond the table makes the machine's writes
// unknown. Whether that changed the frame.
machine Checker::add_field_write(checker: &mut Checker, machine: u64 in Trapping, field: u64 in Trapping) -> bool
crashes Trap
{
    transition machine < 2048 && field < 1024 {
        true -> slot(checker, machine, machine * 1024 + field)
        _ -> beyond(checker, machine)
    }

    state slot(checker: &mut Checker, machine: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < 2097152 {
            true -> entry(checker, index)
            _ -> beyond(checker, machine)
        }
    }

    state entry(checker: &mut Checker, index: u64 in Trapping) -> bool
    requires index < 2097152
    {
        let marked: bool = checker.field_writes[index];
        checker.field_writes[index] = true;
        !marked
    }

    state beyond(checker: &mut Checker, machine: u64 in Trapping) -> bool {
        let grew: bool = Checker::mark_unknown(checker, machine, true);
        grew
    }
}

// Every field `from` may write, `into` may write too. Whether `into` grew.
machine Checker::merge_field_writes(checker: &mut Checker, into: u64 in Trapping, from: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(checker, into, from, 0, false) }

    state next(checker: &mut Checker, into: u64 in Trapping, from: u64 in Trapping, field: u64 in Trapping, changed: bool) -> bool {
        transition field < 1024 {
            true -> field(checker, into, from, field, changed)
            _ -> finished(changed)
        }
    }

    state field(checker: &mut Checker, into: u64 in Trapping, from: u64 in Trapping, field: u64 in Trapping, changed: bool) -> bool {
        let written: bool = Checker::writes_field(checker, from, field);
        transition written {
            true -> merged(checker, into, from, field, changed)
            _ -> next(checker, into, from, field + 1, changed)
        }
    }

    state merged(checker: &mut Checker, into: u64 in Trapping, from: u64 in Trapping, field: u64 in Trapping, changed: bool) -> bool {
        let grew: bool = Checker::add_field_write(checker, into, field);
        transition { _ -> next(checker, into, from, field + 1, changed || grew) }
    }

    state finished(changed: bool) -> bool {
        changed
    }
}

machine Checker::clear_field_writes(checker: &mut Checker, machine: u64 in Trapping)
crashes Trap
{
    transition machine < 2048 {
        true -> next(checker, machine * 1024, 0)
        _ -> done()
    }

    state next(checker: &mut Checker, base: u64 in Trapping, field: u64 in Trapping) {
        let index: u64 in Trapping = base + field;
        transition field < 1024 && index < 2097152 {
            true -> cleared(checker, base, field, index)
            _ -> done()
        }
    }

    state cleared(checker: &mut Checker, base: u64 in Trapping, field: u64 in Trapping, index: u64 in Trapping)
    requires index < 2097152
    {
        checker.field_writes[index] = false;
        transition { _ -> next(checker, base, field + 1) }
    }

    state done() {}
}
