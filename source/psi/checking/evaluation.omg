use psi::checking::checker;
use psi::checking::places;
use psi::checking::zone;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// What checking knows about one expression: the place it names, a linear
// term (`subject + offset`, a constant when the subject is zero) when its
// value is one, and its interval. `ceiling` bounds the value from above and
// `floor` bounds its negation, the zone's convention, so a sum of bounds
// that overflows always weakens rather than tightens. Expression trees are
// evaluated bottom-up in table order, children before parents, each node's
// value kept by its offset from the tree's lowest handle.
pub data Value [copy] {
    place: u64 in Trapping;
    known: bool;
    subject: u64 in Trapping;
    offset: ExactInteger;
    ceiling: Bound;
    floor: Bound;
}

pub machine Value::unknown() -> Value {
    Value {
        place: 0,
        known: false,
        subject: 0,
        offset: ExactInteger { negative: false, magnitude: 0 },
        ceiling: Bound { finite: false, value: ExactInteger { negative: false, magnitude: 0 } },
        floor: Bound { finite: false, value: ExactInteger { negative: false, magnitude: 0 } }
    }
}

pub machine Value::constant(value: ExactInteger) -> Value {
    let negated: ExactInteger = ExactInteger::negate(value);
    Value {
        place: 0,
        known: true,
        subject: 0,
        offset: value,
        ceiling: Bound { finite: true, value: value },
        floor: Bound { finite: true, value: negated }
    }
}

// The interval of a carrier: its exact range.
pub machine Value::carrier(builtin: BuiltinType) -> Value {
    let least: ExactInteger = ExactInteger::minimum(builtin);
    let greatest: ExactInteger = ExactInteger::maximum(builtin);
    let negated: ExactInteger = ExactInteger::negate(least);
    let unknown: Value = Value::unknown();
    Value {
        place: 0,
        known: false,
        subject: 0,
        offset: unknown.offset,
        ceiling: Bound { finite: true, value: greatest },
        floor: Bound { finite: true, value: negated }
    }
}

// Whether the value is a constant.
pub machine Value::is_constant(value: Value) -> bool {
    value.known && value.subject == 0
}

// The least value, when bounded below.
pub machine Value::least(value: Value) -> Bound {
    let negated: ExactInteger = ExactInteger::negate(value.floor.value);
    Bound { finite: value.floor.finite, value: negated }
}

// Whether every value of the interval lies in `builtin`'s range.
pub machine Value::within(value: Value, builtin: BuiltinType) -> bool {
    let range: Value = Value::carrier(builtin);
    let below: bool = Bound::at_most(value.ceiling, range.ceiling);
    let above: bool = Bound::at_most(value.floor, range.floor);
    below && above
}

// The interval narrowed to `builtin`'s range.
pub machine Value::clamped(value: Value, builtin: BuiltinType) -> Value {
    let range: Value = Value::carrier(builtin);
    let ceiling_tighter: bool = Bound::at_most(value.ceiling, range.ceiling);
    let floor_tighter: bool = Bound::at_most(value.floor, range.floor);
    let ceiling: Bound = Value::pick(ceiling_tighter, value.ceiling, range.ceiling);
    let floor: Bound = Value::pick(floor_tighter, value.floor, range.floor);
    Value { place: value.place, known: value.known, subject: value.subject, offset: value.offset, ceiling: ceiling, floor: floor }
}

// The interval of a value, without its place or term.
pub machine Value::interval(value: Value) -> Value {
    let unknown: Value = Value::unknown();
    Value { place: 0, known: false, subject: 0, offset: unknown.offset, ceiling: value.ceiling, floor: value.floor }
}

// The least interval holding both values' (a floor is stored negated, so
// the greater floor is the lower bound).
pub machine Value::hull(left: Value, right: Value) -> Value {
    let left_ceiling: bool = Bound::at_most(right.ceiling, left.ceiling);
    let left_floor: bool = Bound::at_most(right.floor, left.floor);
    let ceiling: Bound = Value::pick(left_ceiling, left.ceiling, right.ceiling);
    let floor: Bound = Value::pick(left_floor, left.floor, right.floor);
    let unknown: Value = Value::unknown();
    Value { place: 0, known: false, subject: 0, offset: unknown.offset, ceiling: ceiling, floor: floor }
}

machine Value::pick(first: bool, when: Bound, otherwise: Bound) -> Bound {
    transition first {
        true -> chosen(when)
        _ -> chosen(otherwise)
    }

    state chosen(bound: Bound) -> Bound {
        bound
    }
}

// The interval of `subject + offset` in the current zone.
pub machine Checker::term_value(checker: &Checker, place: u64 in Trapping, subject: u64 in Trapping, offset: ExactInteger) -> Value
crashes Trap
{
    let upper: Bound = Zone::bound(&checker.zone, 0, subject);
    let lower: Bound = Zone::bound(&checker.zone, subject, 0);
    let shift: Bound = Bound::exactly(offset);
    let negated: ExactInteger = ExactInteger::negate(offset);
    let unshift: Bound = Bound::exactly(negated);
    let ceiling: Bound = Bound::add(upper, shift);
    let floor: Bound = Bound::add(lower, unshift);
    Value { place: place, known: true, subject: subject, offset: offset, ceiling: ceiling, floor: floor }
}

// The value of the expression tree node `handle`, which has been evaluated.
// A linear term's interval is read from the zone again: facts installed
// after the node was evaluated (a field's `where` facts, an assumption)
// hold of it too.
pub machine Checker::value_at(checker: &Checker, handle: u64 in Trapping) -> Value
crashes Trap
{
    transition handle >= checker.tree_low {
        true -> offset(checker, handle - checker.tree_low)
        _ -> invalid()
    }

    state offset(checker: &Checker, offset: u64 in Trapping) -> Value {
        let index: u64 in Trapping = checker.tree_base + offset;
        transition offset < checker.tree_size && index < 4096 {
            true -> read(checker, index)
            _ -> invalid()
        }
    }

    state read(checker: &Checker, index: u64 in Trapping) -> Value
    requires index < 4096
    {
        let stored: Value = checker.values[index];
        transition stored.known && stored.subject > 0 {
            true -> current(checker, stored)
            _ -> kept(stored)
        }
    }

    state current(checker: &Checker, stored: Value) -> Value {
        let value: Value = Checker::term_value(checker, stored.place, stored.subject, stored.offset);
        value
    }

    state kept(stored: Value) -> Value {
        stored
    }

    state invalid() -> Value {
        crash Trap;
    }
}

pub machine Checker::set_value(checker: &mut Checker, handle: u64 in Trapping, value: Value)
crashes Trap
{
    transition handle >= checker.tree_low {
        true -> offset(checker, handle - checker.tree_low, value)
        _ -> invalid()
    }

    state offset(checker: &mut Checker, offset: u64 in Trapping, value: Value) {
        let index: u64 in Trapping = checker.tree_base + offset;
        transition offset < checker.tree_size && index < 4096 {
            true -> write(checker, index, value)
            _ -> invalid()
        }
    }

    state write(checker: &mut Checker, index: u64 in Trapping, value: Value)
    requires index < 4096
    {
        checker.values[index] = value;
    }

    state invalid() {
        crash Trap;
    }
}

// Interval arithmetic. Each bound sums with the overflow rule of
// `Bound::add`, which only weakens.
pub machine Value::sum(left: Value, right: Value) -> Value {
    let ceiling: Bound = Bound::add(left.ceiling, right.ceiling);
    let floor: Bound = Bound::add(left.floor, right.floor);
    let unknown: Value = Value::unknown();
    Value { place: 0, known: false, subject: 0, offset: unknown.offset, ceiling: ceiling, floor: floor }
}

pub machine Value::negation(value: Value) -> Value {
    let unknown: Value = Value::unknown();
    Value { place: 0, known: false, subject: 0, offset: unknown.offset, ceiling: value.floor, floor: value.ceiling }
}

pub machine Value::difference(left: Value, right: Value) -> Value {
    let negated: Value = Value::negation(right);
    let result: Value = Value::sum(left, negated);
    result
}

// Whether the value is known to be at least zero.
pub machine Value::nonnegative(value: Value) -> bool {
    value.floor.finite && (value.floor.value.negative || value.floor.value.magnitude == 0)
}

// A product of two nonnegative intervals; any other product is unbounded.
pub machine Value::product(left: Value, right: Value) -> Value {
    let left_nonnegative: bool = Value::nonnegative(left);
    let right_nonnegative: bool = Value::nonnegative(right);
    transition left_nonnegative && right_nonnegative {
        true -> nonnegative(left, right)
        _ -> unbounded()
    }

    state nonnegative(left: Value, right: Value) -> Value {
        let least_left: Bound = Value::least(left);
        let least_right: Bound = Value::least(right);
        let lower: ExactResult = ExactInteger::multiply(least_left.value, least_right.value);
        let upper: ExactResult = ExactInteger::multiply(left.ceiling.value, right.ceiling.value);
        let negated: ExactInteger = ExactInteger::negate(lower.value);
        let unknown: Value = Value::unknown();
        let ceiling_finite: bool = left.ceiling.finite && right.ceiling.finite && upper.valid;
        let ceiling: Bound = Bound { finite: ceiling_finite, value: upper.value };
        let floor: Bound = Bound { finite: lower.valid, value: negated };
        Value { place: 0, known: false, subject: 0, offset: unknown.offset, ceiling: ceiling, floor: floor }
    }

    state unbounded() -> Value {
        let unknown: Value = Value::unknown();
        unknown
    }
}

// A quotient of a nonnegative interval by a positive one; any other
// quotient is unbounded.
pub machine Value::quotient(left: Value, right: Value) -> Value {
    let left_nonnegative: bool = Value::nonnegative(left);
    let divisor: Bound = Value::least(right);
    let positive: bool = divisor.finite && !divisor.value.negative && divisor.value.magnitude > 0;
    transition left_nonnegative && positive {
        true -> divided(left, right, divisor.value.magnitude)
        _ -> unbounded()
    }

    state divided(left: Value, right: Value, least_divisor: u64 in Wrapping) -> Value {
        let unknown: Value = Value::unknown();
        let ceiling: Bound = Value::divided_ceiling(left.ceiling, least_divisor);
        let least_left: Bound = Value::least(left);
        let floor: Bound = Value::divided_floor(least_left.value.magnitude, right.ceiling);
        Value { place: 0, known: false, subject: 0, offset: unknown.offset, ceiling: ceiling, floor: floor }
    }

    state unbounded() -> Value {
        let unknown: Value = Value::unknown();
        unknown
    }
}

machine Value::divided_ceiling(ceiling: Bound, divisor: u64 in Wrapping) -> Bound {
    transition ceiling.finite && divisor > 0 {
        true -> divided(ceiling.value.magnitude / divisor)
        _ -> unbounded()
    }

    state divided(magnitude: u64 in Wrapping) -> Bound {
        Bound { finite: true, value: ExactInteger { negative: false, magnitude: magnitude } }
    }

    state unbounded() -> Bound {
        Bound { finite: false, value: ExactInteger { negative: false, magnitude: 0 } }
    }
}

// The negated least quotient of a dividend at least `least` by a divisor at
// most `ceiling`: zero when the divisor is unbounded.
machine Value::divided_floor(least: u64 in Wrapping, ceiling: Bound) -> Bound {
    transition ceiling.finite && ceiling.value.magnitude > 0 && !ceiling.value.negative {
        true -> divided(least / ceiling.value.magnitude)
        _ -> zero()
    }

    state divided(magnitude: u64 in Wrapping) -> Bound {
        Bound { finite: true, value: ExactInteger { negative: magnitude > 0, magnitude: magnitude } }
    }

    state zero() -> Bound {
        Bound { finite: true, value: ExactInteger { negative: false, magnitude: 0 } }
    }
}

// A remainder of a nonnegative interval by a positive one lies below the
// divisor and at most the dividend.
pub machine Value::remainder(left: Value, right: Value) -> Value {
    let left_nonnegative: bool = Value::nonnegative(left);
    let divisor: Bound = Value::least(right);
    let positive: bool = divisor.finite && !divisor.value.negative && divisor.value.magnitude > 0;
    transition left_nonnegative && positive && right.ceiling.finite {
        true -> bounded(left, right.ceiling.value.magnitude - 1)
        _ -> unbounded()
    }

    state bounded(left: Value, below_divisor: u64 in Wrapping) -> Value {
        let unknown: Value = Value::unknown();
        let divisor_bound: Bound = Bound { finite: true, value: ExactInteger { negative: false, magnitude: below_divisor } };
        let tighter: bool = Bound::at_most(left.ceiling, divisor_bound);
        let ceiling: Bound = Value::pick(tighter, left.ceiling, divisor_bound);
        let floor: Bound = Bound { finite: true, value: ExactInteger { negative: false, magnitude: 0 } };
        Value { place: 0, known: false, subject: 0, offset: unknown.offset, ceiling: ceiling, floor: floor }
    }

    state unbounded() -> Value {
        let unknown: Value = Value::unknown();
        unknown
    }
}

// A bitwise AND of nonnegative values is at most either operand.
pub machine Value::conjunction(left: Value, right: Value) -> Value {
    let left_nonnegative: bool = Value::nonnegative(left);
    let right_nonnegative: bool = Value::nonnegative(right);
    transition left_nonnegative && right_nonnegative {
        true -> bounded(left, right)
        _ -> unbounded()
    }

    state bounded(left: Value, right: Value) -> Value {
        let unknown: Value = Value::unknown();
        let tighter: bool = Bound::at_most(left.ceiling, right.ceiling);
        let ceiling: Bound = Value::pick(tighter, left.ceiling, right.ceiling);
        let floor: Bound = Bound { finite: true, value: ExactInteger { negative: false, magnitude: 0 } };
        Value { place: 0, known: false, subject: 0, offset: unknown.offset, ceiling: ceiling, floor: floor }
    }

    state unbounded() -> Value {
        let unknown: Value = Value::unknown();
        unknown
    }
}

// A right shift of a nonnegative value is at most the value.
pub machine Value::shifted_right(left: Value) -> Value {
    let nonnegative: bool = Value::nonnegative(left);
    transition nonnegative {
        true -> bounded(left)
        _ -> unbounded()
    }

    state bounded(left: Value) -> Value {
        let unknown: Value = Value::unknown();
        let floor: Bound = Bound { finite: true, value: ExactInteger { negative: false, magnitude: 0 } };
        Value { place: 0, known: false, subject: 0, offset: unknown.offset, ceiling: left.ceiling, floor: floor }
    }

    state unbounded() -> Value {
        let unknown: Value = Value::unknown();
        unknown
    }
}

// `left + right` as a linear term when one side is a constant.
pub machine Value::offset_sum(left: Value, right: Value, interval: Value) -> Value {
    let right_constant: bool = Value::is_constant(right);
    let left_constant: bool = Value::is_constant(left);
    transition left.known && right_constant {
        true -> shifted(left.subject, left.offset, right.offset, interval)
        _ -> other(left, right, left_constant, interval)
    }

    state other(left: Value, right: Value, left_constant: bool, interval: Value) -> Value {
        transition right.known && left_constant {
            true -> shifted(right.subject, right.offset, left.offset, interval)
            _ -> plain(interval)
        }
    }

    state shifted(subject: u64 in Trapping, offset: ExactInteger, by: ExactInteger, interval: Value) -> Value {
        let moved: ExactResult = ExactInteger::add(offset, by);
        transition moved.valid {
            true -> linear(subject, moved.value, interval)
            _ -> plain(interval)
        }
    }

    state linear(subject: u64 in Trapping, offset: ExactInteger, interval: Value) -> Value {
        Value { place: 0, known: true, subject: subject, offset: offset, ceiling: interval.ceiling, floor: interval.floor }
    }

    state plain(interval: Value) -> Value {
        interval
    }
}

// `left - right` as a linear term when `right` is a constant.
pub machine Value::offset_difference(left: Value, right: Value, interval: Value) -> Value {
    let right_constant: bool = Value::is_constant(right);
    transition left.known && right_constant {
        true -> shifted(left.subject, left.offset, right.offset, interval)
        _ -> plain(interval)
    }

    state shifted(subject: u64 in Trapping, offset: ExactInteger, by: ExactInteger, interval: Value) -> Value {
        let moved: ExactResult = ExactInteger::subtract(offset, by);
        transition moved.valid {
            true -> linear(subject, moved.value, interval)
            _ -> plain(interval)
        }
    }

    state linear(subject: u64 in Trapping, offset: ExactInteger, interval: Value) -> Value {
        Value { place: 0, known: true, subject: subject, offset: offset, ceiling: interval.ceiling, floor: interval.floor }
    }

    state plain(interval: Value) -> Value {
        interval
    }
}

// The tightest bound the zone gives on `right - left` for two linear terms;
// unbounded when either is not one.
pub machine Checker::difference_bound(checker: &Checker, left: Value, right: Value) -> Bound
crashes Trap
{
    transition left.known && right.known {
        true -> related(checker, left, right)
        _ -> unbounded()
    }

    state related(checker: &Checker, left: Value, right: Value) -> Bound {
        let between: Bound = Zone::bound(&checker.zone, left.subject, right.subject);
        let offsets: ExactResult = ExactInteger::subtract(right.offset, left.offset);
        let shift: Bound = Bound { finite: offsets.valid, value: offsets.value };
        let bound: Bound = Bound::add(between, shift);
        bound
    }

    state unbounded() -> Bound {
        Bound { finite: false, value: ExactInteger { negative: false, magnitude: 0 } }
    }
}

// Whether `left < right` holds wherever the zone does: through the zone's
// relation between their terms, or through their intervals.
pub machine Checker::proves_less(checker: &Checker, left: Value, right: Value) -> bool
crashes Trap
{
    let below: ExactInteger = ExactInteger { negative: true, magnitude: 1 };
    let wanted: Bound = Bound::exactly(below);
    let related: Bound = Checker::difference_bound(checker, right, left);
    let through_zone: bool = Bound::at_most(related, wanted);
    let separated: Bound = Bound::add(left.ceiling, right.floor);
    let through_intervals: bool = Bound::at_most(separated, wanted);
    checker.zone.infeasible || through_zone || through_intervals
}

// Whether `left <= right` holds wherever the zone does.
pub machine Checker::proves_at_most(checker: &Checker, left: Value, right: Value) -> bool
crashes Trap
{
    let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
    let wanted: Bound = Bound::exactly(zero);
    let related: Bound = Checker::difference_bound(checker, right, left);
    let through_zone: bool = Bound::at_most(related, wanted);
    let separated: Bound = Bound::add(left.ceiling, right.floor);
    let through_intervals: bool = Bound::at_most(separated, wanted);
    checker.zone.infeasible || through_zone || through_intervals
}

// Whether the value is never zero.
pub machine Checker::proves_nonzero(checker: &Checker, value: Value) -> bool {
    let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
    let below: ExactInteger = ExactInteger { negative: true, magnitude: 1 };
    let positive_wanted: Bound = Bound::exactly(below);
    let positive: bool = Bound::at_most(value.floor, positive_wanted);
    let negative: bool = Bound::at_most(value.ceiling, positive_wanted);
    checker.zone.infeasible || positive || negative
}

// A value known only as a place, such as a record or a reference.
pub machine Value::at_place(place: u64 in Trapping) -> Value {
    let unknown: Value = Value::unknown();
    Value { place: place, known: false, subject: 0, offset: unknown.offset, ceiling: unknown.ceiling, floor: unknown.floor }
}

// A value known only by its type: a fixed integer's carrier range.
pub machine Value::typed(row: TypeRow) -> Value {
    let integer: bool = row.kind == TypeKind::Builtin && ExactInteger::is_carrier(row.builtin);
    transition integer {
        true -> ranged(row.builtin)
        _ -> unbounded()
    }

    state ranged(builtin: BuiltinType) -> Value {
        let range: Value = Value::carrier(builtin);
        range
    }

    state unbounded() -> Value {
        let value: Value = Value::unknown();
        value
    }
}
