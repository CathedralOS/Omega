use psi::checking::aliases;
use psi::checking::checker;
use psi::checking::contracts;
use psi::checking::domains;
use psi::checking::evaluation;
use psi::checking::fact_values;
use psi::checking::facts;
use psi::checking::matches;
use psi::checking::obligations;
use psi::checking::places;
use psi::checking::qualification;
use psi::checking::references;
use psi::checking::snapshots;
use psi::checking::termination;
use psi::checking::zone;
use psi::checks::checks;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;

// Live facts through one body (wiki/spec/language/state_contracts.md). Its
// statements run in order: a `let` binds its local to its initializer's
// value, an assignment evaluates its value, then its target, then forgets
// the overwritten place and binds the new value, and a crash ends the path.
// A transition's arms each see the facts their selection implies, the
// failure of every earlier guard among them; a jump to a state projects the
// facts about its arguments onto the state's integer parameters. Inside an
// expression, the right operand of `&&` sees its left operand hold and that
// of `||` sees it fail; after the operator, facts hold only when they hold
// whether or not the right operand ran.

// Evaluate the tree rooted at `root`, children before parents.
pub machine Checker::evaluate_tree(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    root: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let tree: Expression = SyntaxTrees::expression(syntax, root);
    let low: u64 in Trapping = tree.first_row;
    let size: u64 in Trapping = root - low + 1;
    transition size <= 4096 {
        true -> sized(checker, syntax, resolution, typing, root, low, size, checking)
        _ -> oversized(checker, syntax, root)
    }

    // A statement-level tree starts the values afresh.
    state sized(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        size: u64 in Trapping,
        checking: bool
    ) {
        checker.frame_count = 0;
        checker.tree_base = 0;
        checker.tree_low = low;
        checker.tree_size = size;
        checker.context_first = 0;
        checker.context_count = 0;
        checker.match_count = 0;
        Checker::evaluate_run(checker, syntax, resolution, typing, root, low, checking);
        Checker::install_domains(checker, syntax, resolution, typing);
    }

    state oversized(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, root);
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }
}

// Decide a whole fact: a membership through its domain
// (`Checker::decide_membership`), any other fact as a tree.
pub machine Checker::decide_fact(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    root: u64 in Trapping,
    proving: bool
) -> bool
crashes Trap
{
    let tree: Expression = SyntaxTrees::expression(syntax, root);
    transition tree.kind == ExpressionKind::Membership {
        true -> membership(checker, syntax, resolution, typing, root, proving)
        _ -> tree_fact(checker, syntax, resolution, typing, root, proving)
    }

    state membership(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, proving: bool) -> bool {
        let decided: bool = Checker::decide_membership(checker, syntax, resolution, typing, root, proving);
        decided
    }

    state tree_fact(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, proving: bool) -> bool {
        let decided: bool = Checker::decide_tree(checker, syntax, resolution, typing, root, proving);
        decided
    }
}

// Evaluate a fact tree while another may be open, then assume it or, when
// `proving`, report whether the facts prove it. Its values sit above the
// open tree's and are gone when it returns. A fact is a proof expression:
// evaluating it executes nothing, so it adds no crash route and its calls
// have no effects (fact_values.omg). A proposition application states
// what no zone fact expresses: assuming it establishes nothing, and where
// it must hold, checking cannot decide it and rejects it as unsupported. A
// membership inside a larger fact is an unknown Boolean.
pub machine Checker::decide_tree(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    root: u64 in Trapping,
    proving: bool
) -> bool
crashes Trap
{
    let tree: Expression = SyntaxTrees::expression(syntax, root);
    let applied: bool = Checker::applies_proposition(syntax, resolution, tree);
    transition applied {
        true -> proposition(checker, tree, proving)
        _ -> sized(checker, syntax, resolution, typing, root, tree, proving)
    }

    state proposition(checker: &mut Checker, tree: Expression, proving: bool) -> bool {
        transition proving {
            true -> unsupported(checker, tree)
            _ -> assumed()
        }
    }

    state unsupported(checker: &mut Checker, tree: Expression) -> bool {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::UnsupportedFact, tree.source_span);
        transition { _ -> unproved() }
    }

    state assumed() -> bool {
        true
    }

    state unproved() -> bool {
        false
    }

    state sized(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        tree: Expression,
        proving: bool
    ) -> bool {
        let low: u64 in Trapping = tree.first_row;
        let size: u64 in Trapping = root - low + 1;
        let base: u64 in Trapping = Checker::next_base(checker);
        transition base + size <= 4096 && checker.frame_count < 8 {
            true -> framed(checker, syntax, resolution, typing, root, low, size, base, proving)
            _ -> undecided(proving)
        }
    }

    state framed(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        size: u64 in Trapping,
        base: u64 in Trapping,
        proving: bool
    ) -> bool {
        let trap_route: bool = checker.trap_route;
        let abort_route: bool = checker.abort_route;
        Checker::push_frame(checker);
        checker.tree_base = base;
        checker.tree_low = low;
        checker.tree_size = size;
        checker.context_first = checker.context_count;
        Checker::evaluate_fact_run(checker, syntax, resolution, typing, root, low);
        let decided: bool = Checker::decide(checker, syntax, root, proving);
        checker.trap_route = trap_route;
        checker.abort_route = abort_route;
        Checker::pop_frame(checker);
        decided
    }

    // Too deep to evaluate: nothing is assumed and nothing is proved.
    state undecided(proving: bool) -> bool {
        !proving
    }
}

// The value of `operand` in the fact tree rooted at `root`, evaluated like
// any fact tree above the open one; unknown when too deep to evaluate.
pub machine Checker::fact_operand(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    root: u64 in Trapping,
    operand: u64 in Trapping
) -> Value
crashes Trap
{
    let tree: Expression = SyntaxTrees::expression(syntax, root);
    let low: u64 in Trapping = tree.first_row;
    let size: u64 in Trapping = root - low + 1;
    let base: u64 in Trapping = Checker::next_base(checker);
    transition base + size <= 4096 && checker.frame_count < 8 {
        true -> framed(checker, syntax, resolution, typing, root, operand, low, size, base)
        _ -> unknown()
    }

    state framed(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        operand: u64 in Trapping,
        low: u64 in Trapping,
        size: u64 in Trapping,
        base: u64 in Trapping
    ) -> Value {
        let trap_route: bool = checker.trap_route;
        let abort_route: bool = checker.abort_route;
        Checker::push_frame(checker);
        checker.tree_base = base;
        checker.tree_low = low;
        checker.tree_size = size;
        checker.context_first = checker.context_count;
        Checker::evaluate_fact_run(checker, syntax, resolution, typing, root, low);
        let value: Value = Checker::value_at(checker, operand);
        checker.trap_route = trap_route;
        checker.abort_route = abort_route;
        Checker::pop_frame(checker);
        value
    }

    state unknown() -> Value {
        let value: Value = Value::unknown();
        value
    }
}

// Whether a fact is a proposition application, which resolution admits
// only as a whole fact: `P(...)` or `P<...>(...)`.
machine Checker::applies_proposition(syntax: &SyntaxTrees, resolution: &NameResolution, tree: Expression) -> bool
crashes Trap
{
    transition tree.kind == ExpressionKind::Call {
        true -> callee(syntax, resolution, tree.left)
        _ -> answer(false)
    }

    state callee(syntax: &SyntaxTrees, resolution: &NameResolution, left: u64 in Trapping) -> bool {
        let written: Expression = SyntaxTrees::expression(syntax, left);
        transition written.kind == ExpressionKind::Apply {
            true -> named(resolution, written.left)
            _ -> named(resolution, left)
        }
    }

    state named(resolution: &NameResolution, handle: u64 in Trapping) -> bool {
        let binding: ValueBinding = NameResolution::value_binding(resolution, handle);
        transition binding {
            ValueBinding::Proposition { proposition } -> answer(true)
            _ -> answer(false)
        }
    }

    state answer(applied: bool) -> bool {
        applied
    }
}

machine Checker::decide(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, proving: bool) -> bool
crashes Trap
{
    transition proving {
        true -> proved(checker, syntax, root)
        _ -> assumed(checker, syntax, root)
    }

    state proved(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping) -> bool {
        let holds: bool = Checker::proves(checker, syntax, root);
        holds
    }

    state assumed(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping) -> bool {
        Checker::assume(checker, syntax, root, true);
        true
    }
}

// The nodes of the tree in the current frame, children before parents.
machine Checker::evaluate_run(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    root: u64 in Trapping,
    low: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    transition { _ -> scan(checker, syntax, resolution, typing, root, low, low, checking) }

    // Record where each `&&`/`||` right operand begins, and each match.
    state scan(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        checking: bool
    ) {
        transition handle <= root {
            true -> scan_node(checker, syntax, resolution, typing, root, low, handle, checking)
            _ -> node(checker, syntax, resolution, typing, root, low, checking)
        }
    }

    state scan_node(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        checking: bool
    ) {
        let expression: Expression = SyntaxTrees::expression(syntax, handle);
        let logical: bool = expression.kind == ExpressionKind::Binary
            && (expression.operator == OperatorKind::And || expression.operator == OperatorKind::Or);
        transition logical {
            true -> context(checker, syntax, resolution, typing, root, low, handle, expression.right, checking)
            _ -> matched(checker, syntax, resolution, typing, root, low, handle, expression, checking)
        }
    }

    state matched(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        expression: Expression,
        checking: bool
    ) {
        transition expression.kind == ExpressionKind::Match {
            true -> record_match(checker, syntax, resolution, typing, root, low, handle, checking)
            _ -> scan(checker, syntax, resolution, typing, root, low, handle + 1, checking)
        }
    }

    state record_match(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        checking: bool
    ) {
        Checker::add_match(checker, syntax, handle);
        transition { _ -> scan(checker, syntax, resolution, typing, root, low, handle + 1, checking) }
    }

    state context(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        right: u64 in Trapping,
        checking: bool
    ) {
        let operand: Expression = SyntaxTrees::expression(syntax, right);
        Checker::add_context(checker, operand.first_row, handle);
        transition { _ -> scan(checker, syntax, resolution, typing, root, low, handle + 1, checking) }
    }

    state node(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        handle: u64 in Trapping,
        checking: bool
    ) {
        transition handle <= root {
            true -> enter(checker, syntax, resolution, typing, root, handle, checking)
            _ -> done()
        }
    }

    state enter(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        root: u64 in Trapping,
        handle: u64 in Trapping,
        checking: bool
    ) {
        Checker::install_domains(checker, syntax, resolution, typing);
        Checker::open_contexts(checker, syntax, handle);
        Checker::advance_matches(checker, syntax, resolution, typing, handle, checking);
        Checker::evaluate_node(checker, syntax, resolution, typing, handle, checking);
        Checker::close_context(checker, handle);
        transition { _ -> node(checker, syntax, resolution, typing, root, handle + 1, checking) }
    }

    state done() {}
}

// One open tree's evaluation state, saved while a tree evaluated inside it
// runs.
pub data TreeFrame [copy] {
    base: u64 in Trapping;
    low: u64 in Trapping;
    size: u64 in Trapping;
    context_first: u64;
    context_count: u64;
}

// Where a fact tree's values begin: past the most recent tree's, which may
// still be open.
machine Checker::next_base(checker: &Checker) -> u64 in Trapping {
    checker.tree_base + checker.tree_size
}

machine Checker::push_frame(checker: &mut Checker)
crashes Trap
{
    let frame: TreeFrame = TreeFrame {
        base: checker.tree_base,
        low: checker.tree_low,
        size: checker.tree_size,
        context_first: checker.context_first,
        context_count: checker.context_count
    };
    transition checker.frame_count < 8 {
        true -> write(checker, checker.frame_count, frame)
        _ -> invalid()
    }

    state write(checker: &mut Checker, index: u64, frame: TreeFrame)
    requires index < 8
    {
        checker.frames[index] = frame;
        checker.frame_count = index + 1;
    }

    state invalid() {
        crash Trap;
    }
}

// Close the innermost tree: its caller's values and contexts are current
// again.
machine Checker::pop_frame(checker: &mut Checker)
crashes Trap
{
    transition checker.frame_count > 0 && checker.frame_count <= 8 {
        true -> read(checker, checker.frame_count - 1)
        _ -> invalid()
    }

    state read(checker: &mut Checker, index: u64)
    requires index < 8
    {
        let frame: TreeFrame = checker.frames[index];
        checker.frame_count = index;
        checker.tree_base = frame.base;
        checker.tree_low = frame.low;
        checker.tree_size = frame.size;
        checker.context_first = frame.context_first;
        checker.context_count = frame.context_count;
    }

    state invalid() {
        crash Trap;
    }
}

// Evaluate an already evaluated tree again for its values alone: its calls
// record nothing and release nothing a second time.
pub machine Checker::replay_tree(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping)
crashes Trap
{
    checker.replay = true;
    Checker::evaluate_tree(checker, syntax, resolution, typing, root, false);
    checker.replay = false;
}

machine Checker::add_context(checker: &mut Checker, start: u64 in Trapping, operator: u64 in Trapping)
crashes Trap
{
    transition checker.context_count < 64 {
        true -> write(checker, checker.context_count, start, operator)
        _ -> full()
    }

    state write(checker: &mut Checker, index: u64, start: u64 in Trapping, operator: u64 in Trapping)
    requires index < 64
    {
        checker.context_starts[index] = start as u64;
        checker.context_operators[index] = operator as u64;
        checker.context_count = index + 1;
    }

    // An operand without a context simply gains no assumption.
    state full() {}
}

// Open every context whose right operand begins at `handle`: save the
// facts, then assume the left operand held (`&&`) or failed (`||`). A
// context's saved zone is owned by its operator's handle plus one; owner
// zero is a transition's, whose arms restore it, and expression handle zero
// must not close it.
machine Checker::open_contexts(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping)
crashes Trap
{
    transition { _ -> first(checker, syntax, handle) }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, index: u64) {
        transition index < checker.context_count && index < 64 {
            true -> candidate(checker, syntax, handle, index)
            _ -> done()
        }
    }

    state first(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping) {
        transition { _ -> next(checker, syntax, handle, checker.context_first) }
    }

    state candidate(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, index: u64)
    requires index < 64
    {
        let start: u64 = checker.context_starts[index];
        let operator: u64 = checker.context_operators[index];
        transition start == handle {
            true -> open(checker, syntax, handle, index, operator as u64 in Trapping)
            _ -> next(checker, syntax, handle, index + 1)
        }
    }

    state open(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, index: u64, operator: u64 in Trapping) {
        let saved: bool = Checker::save_zone(checker, operator + 1);
        let expression: Expression = SyntaxTrees::expression(syntax, operator);
        let holds: bool = expression.operator == OperatorKind::And;
        transition saved {
            true -> assumed(checker, syntax, handle, index, expression.left, holds)
            _ -> next(checker, syntax, handle, index + 1)
        }
    }

    state assumed(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, index: u64, left: u64 in Trapping, holds: bool) {
        Checker::assume(checker, syntax, left, holds);
        transition { _ -> next(checker, syntax, handle, index + 1) }
    }

    state done() {}
}

// After an `&&`/`||` node: keep what holds whether or not its right operand
// ran, the join of the saved facts and the current ones.
machine Checker::close_context(checker: &mut Checker, handle: u64 in Trapping)
crashes Trap
{
    transition checker.saved_count > 0 && checker.saved_count <= 8 {
        true -> top(checker, handle, checker.saved_count - 1)
        _ -> done()
    }

    state top(checker: &mut Checker, handle: u64 in Trapping, index: u64)
    requires index < 8
    {
        let owner: u64 = checker.saved_owners[index];
        transition owner == handle + 1 {
            true -> joined(checker, index)
            _ -> done()
        }
    }

    state joined(checker: &mut Checker, index: u64)
    requires index < 8
    {
        checker.previous = checker.saved[index];
        let changed: bool = Zone::join(&mut checker.zone, &checker.previous);
        checker.saved_count = index;
    }

    state done() {}
}

// Push a copy of the zone, owned by `owner`, or report that the stack is
// full.
pub machine Checker::save_zone(checker: &mut Checker, owner: u64 in Trapping) -> bool
crashes Trap
{
    transition checker.saved_count < 8 {
        true -> push(checker, checker.saved_count, owner)
        _ -> full()
    }

    state push(checker: &mut Checker, index: u64, owner: u64 in Trapping) -> bool
    requires index < 8
    {
        checker.saved[index] = checker.zone;
        checker.saved_owners[index] = owner as u64;
        checker.saved_count = index + 1;
        true
    }

    state full() -> bool {
        false
    }
}

// Replace the zone by the top saved copy, keeping it saved.
pub machine Checker::restore_zone(checker: &mut Checker)
crashes Trap
{
    transition checker.saved_count > 0 && checker.saved_count <= 8 {
        true -> copy(checker, checker.saved_count - 1)
        _ -> invalid()
    }

    state copy(checker: &mut Checker, index: u64)
    requires index < 8
    {
        checker.zone = checker.saved[index];
    }

    state invalid() {
        crash Trap;
    }
}

// Overwrite the top saved copy with the zone.
pub machine Checker::resave_zone(checker: &mut Checker)
crashes Trap
{
    transition checker.saved_count > 0 && checker.saved_count <= 8 {
        true -> copy(checker, checker.saved_count - 1)
        _ -> invalid()
    }

    state copy(checker: &mut Checker, index: u64)
    requires index < 8
    {
        checker.saved[index] = checker.zone;
    }

    state invalid() {
        crash Trap;
    }
}

pub machine Checker::drop_saved(checker: &mut Checker) {
    transition checker.saved_count > 0 {
        true -> drop(checker)
        _ -> done()
    }

    state drop(checker: &mut Checker) {
        checker.saved_count = checker.saved_count - 1;
    }

    state done() {}
}

// One body's statements, from its opening facts. A body that runs off its
// end returns its tail's value, else Unit, and owes its machine's `ensures`
// facts there.
pub machine Checker::walk_body(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    first_statement: u64 in Trapping,
    statement_count: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, first_statement, first_statement, first_statement + statement_count, checking) }

    state next(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        first: u64 in Trapping,
        index: u64 in Trapping,
        end: u64 in Trapping,
        checking: bool
    ) {
        transition index < end && checker.output.machine_accepted {
            true -> statement(checker, syntax, resolution, typing, first, index, end, checking)
            _ -> finished(checker, syntax, resolution, typing, first, end, checking)
        }
    }

    state statement(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        first: u64 in Trapping,
        index: u64 in Trapping,
        end: u64 in Trapping,
        checking: bool
    ) {
        Checker::walk_statement(checker, syntax, resolution, typing, index, checking);
        transition { _ -> next(checker, syntax, resolution, typing, first, index + 1, end, checking) }
    }

    state finished(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        first: u64 in Trapping,
        end: u64 in Trapping,
        checking: bool
    ) {
        transition checking && checker.output.machine_accepted && !checker.zone.infeasible {
            true -> returned(checker, syntax, resolution, typing, first, end)
            _ -> done()
        }
    }

    state returned(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, first: u64 in Trapping, end: u64 in Trapping) {
        transition end > first {
            true -> last(checker, syntax, resolution, typing, end - 1)
            _ -> empty(checker, syntax, resolution, typing)
        }
    }

    state last(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        let statement: Statement = SyntaxTrees::statement(syntax, index);
        transition statement.kind == StatementKind::Tail {
            true -> tail(checker, syntax, resolution, typing, statement)
            _ -> unit(checker, syntax, resolution, typing, statement.source_span)
        }
    }

    state tail(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement) {
        let value: Value = Checker::value_at(checker, statement.value);
        Checker::require_result_qualification(checker, syntax, resolution, typing, statement.value, value, statement.source_span);
        Checker::require_guarantees(checker, syntax, resolution, typing, value, statement.source_span);
    }

    state empty(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, checker.machine);
        transition { _ -> unit(checker, syntax, resolution, typing, item.source_span) }
    }

    state unit(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, source_span: SourceSpan) {
        let value: Value = Value::unknown();
        Checker::require_guarantees(checker, syntax, resolution, typing, value, source_span);
    }

    state done() {}
}

machine Checker::walk_statement(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    index: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let statement: Statement = SyntaxTrees::statement(syntax, index);
    transition statement.kind {
        StatementKind::Let -> binding(checker, syntax, resolution, typing, index, statement, checking)
        StatementKind::Assign -> assignment(checker, syntax, resolution, typing, statement, checking)
        StatementKind::Crash -> crashed(checker, statement)
        StatementKind::Transition -> transition_statement(checker, syntax, resolution, typing, statement, checking)
        _ -> evaluated(checker, syntax, resolution, typing, statement, checking)
    }

    state binding(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        index: u64 in Trapping,
        statement: Statement,
        checking: bool
    ) {
        let type_handle: u64 in Trapping = Typing::reference_type(typing, statement.type_reference);
        let place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Local, index, 0, type_handle);
        transition statement.has_value {
            true -> initialized(checker, syntax, resolution, typing, statement, place, type_handle, checking)
            _ -> done()
        }
    }

    // A qualified local's initializer meets its qualification, which then
    // holds of the local (qualification.omg).
    state initialized(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        place: u64 in Trapping,
        type_handle: u64 in Trapping,
        checking: bool
    ) {
        let epoch: u64 in Trapping = checker.write_epoch;
        Checker::evaluate_tree(checker, syntax, resolution, typing, statement.value, checking);
        let value: Value = Checker::value_at(checker, statement.value);
        let replayable: bool = Checker::alias_replayable(checker, syntax, resolution, typing, statement.value, place, epoch);
        Checker::initialize_place(checker, typing, place, value);
        Checker::replace_live_length(checker, syntax, typing, type_handle, statement.value, place);
        Checker::record_alias(checker, syntax, typing, place, statement.value, value, replayable);
        let bound: Value = Checker::reference_value(checker, typing, place);
        Checker::assume_qualification(checker, syntax, resolution, typing, type_handle, bound);
        transition checking {
            true -> qualified_local(checker, syntax, resolution, typing, statement, type_handle, value)
            _ -> done()
        }
    }

    state qualified_local(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement, type_handle: u64 in Trapping, value: Value) {
        Checker::require_qualification(checker, syntax, resolution, typing, type_handle, statement.value, value, statement.source_span);
    }

    state assignment(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        checking: bool
    ) {
        let epoch: u64 in Trapping = checker.write_epoch;
        Checker::evaluate_tree(checker, syntax, resolution, typing, statement.target, checking);
        let target: Value = Checker::value_at(checker, statement.target);
        let owner: u64 in Trapping = Checker::window_owner(checker, syntax, typing, target.place);
        // The target's tree values live only while its tree is the frame;
        // the value's evaluation replaces that frame, so a destination
        // without a place (an element) resolves its storage origin now.
        let origin: u64 in Trapping = Checker::storage_origin(checker, syntax, typing, statement.target);
        Checker::evaluate_tree(checker, syntax, resolution, typing, statement.value, checking);
        let value: Value = Checker::value_at(checker, statement.value);
        let destination: u64 in Trapping = Typing::expression_type(typing, statement.target);
        Checker::require_stored_qualification(checker, syntax, resolution, typing, destination, statement.value, value, statement.source_span, checking);
        let replayable: bool = Checker::alias_replayable(checker, syntax, resolution, typing, statement.value, target.place, epoch);
        Checker::store_value(checker, syntax, resolution, typing, statement, target, value, origin);
        Checker::replace_live_length(checker, syntax, typing, destination, statement.value, target.place);
        Checker::record_alias(checker, syntax, typing, target.place, statement.value, value, replayable);
        transition owner > 0 {
            true -> window(checker, syntax, resolution, typing, statement, target.place, owner, checking)
            _ -> done()
        }
    }

    // A field store into a value whose data carries `where` facts would
    // open an invariant window this slice does not close.
    // Storing a field of a value whose data carries `where` facts opens an
    // invariant window; the statement must close it again: the facts hold
    // of the value's fields as they now are
    // (wiki/spec/language/dependent_values.md#invariant-windows).
    state window(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        written: u64 in Trapping,
        owner: u64 in Trapping,
        checking: bool
    ) {
        let closed: bool = Checker::domain_holds(checker, syntax, resolution, typing, written);
        transition closed {
            true -> restored(checker, written)
            _ -> open_window(checker, statement, checking)
        }
    }

    state restored(checker: &mut Checker, written: u64 in Trapping) {
        Checker::reopen_domains(checker, written);
    }

    state open_window(checker: &mut Checker, statement: Statement, checking: bool) {
        transition checking {
            true -> unclosed(checker, statement)
            _ -> done()
        }
    }

    state unclosed(checker: &mut Checker, statement: Statement) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::DomainUnproven, statement.source_span);
    }

    // A crash ends the path: nothing after it runs.
    state crashed(checker: &mut Checker, statement: Statement) {
        transition statement.cause {
            CrashCause::Trap -> trapped(checker)
            CrashCause::Abort -> aborted(checker)
        }
    }

    state trapped(checker: &mut Checker) {
        checker.trap_route = true;
        checker.zone.infeasible = true;
    }

    state aborted(checker: &mut Checker) {
        checker.abort_route = true;
        checker.zone.infeasible = true;
    }

    state transition_statement(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        checking: bool
    ) {
        Checker::walk_transition(checker, syntax, resolution, typing, statement, checking);
    }

    state evaluated(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        checking: bool
    ) {
        Checker::evaluate_tree(checker, syntax, resolution, typing, statement.value, checking);
    }

    state done() {}
}

// Replay is valid only while the expression still denotes the value read.
// A call write during evaluation rules it out. The destination must also
// not overwrite a scalar read of the expression (flag = !flag). Inspect a
// proof-only copy before binding: assignment target evaluation has already
// replaced the RHS tree, so its transient value slots cannot be consulted.
// Nested proof evaluation preserves the caller's frame and has no effects.
machine Checker::alias_replayable(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, destination: u64 in Trapping, epoch: u64 in Trapping) -> bool
crashes Trap
{
    let type_handle: u64 in Trapping = Typing::expression_type(typing, root);
    transition epoch == checker.write_epoch && type_handle == typing.boolean && destination > 0 {
        true -> sized(checker, syntax, resolution, typing, root, destination)
        _ -> answer(false)
    }

    state sized(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, destination: u64 in Trapping) -> bool {
        let tree: Expression = SyntaxTrees::expression(syntax, root);
        let size: u64 in Trapping = root - tree.first_row + 1;
        let base: u64 in Trapping = Checker::next_base(checker);
        transition base + size <= 4096 && checker.frame_count < 8 {
            true -> framed(checker, syntax, resolution, typing, root, destination, tree.first_row, size, base)
            _ -> answer(false)
        }
    }

    state framed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, destination: u64 in Trapping, low: u64 in Trapping, size: u64 in Trapping, base: u64 in Trapping) -> bool {
        Checker::push_frame(checker);
        checker.tree_base = base;
        checker.tree_low = low;
        checker.tree_size = size;
        checker.context_first = checker.context_count;
        Checker::evaluate_fact_run(checker, syntax, resolution, typing, root, low);
        let reads: bool = Checker::tree_reads_place(checker, root, low, destination);
        Checker::pop_frame(checker);
        !reads
    }

    state answer(replayable: bool) -> bool {
        replayable
    }
}

// A field receiver names storage; it does not read every field of that
// storage. Scalar subjects distinguish guard.count from the destination
// guard.valid, preserving aliases assigned into independent fields.
machine Checker::tree_reads_place(checker: &Checker, root: u64 in Trapping, low: u64 in Trapping, destination: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> node(checker, root, destination, low) }

    state node(checker: &Checker, root: u64 in Trapping, destination: u64 in Trapping, handle: u64 in Trapping) -> bool {
        transition handle <= root {
            true -> inspected(checker, root, destination, handle)
            _ -> answer(false)
        }
    }

    state inspected(checker: &Checker, root: u64 in Trapping, destination: u64 in Trapping, handle: u64 in Trapping) -> bool {
        let value: Value = Checker::value_at(checker, handle);
        let owner: u64 in Trapping = Checker::subject_place(checker, value.subject);
        let reads: bool = value.known && value.subject > 0 && owner > 0 && Checker::within(checker, owner, destination);
        transition reads {
            true -> answer(true)
            _ -> node(checker, root, destination, handle + 1)
        }
    }

    state answer(reads: bool) -> bool {
        reads
    }
}

// An untracked array element still writes its collection. A reference with
// no captured origin may alias any live place; refuse that write until its
// footprint can be represented instead of leaving unrelated-looking facts.
// Store `value` at the target: a located place binds it; an element or
// other placeless destination forgets what its storage `origin` (resolved
// while the target's tree was the frame) held.
// A quoted literal stored into a bounded byte array replaces its live length
// with the literal's (wiki/spec/terminal-psi/structural_access.md, bounded
// byte replacement): the length place below the written place binds to it.
// `destination` is the written place's type.
pub machine Checker::replace_live_length(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, destination: u64 in Trapping, value: u64 in Trapping, place: u64 in Trapping)
crashes Trap
{
    let written: Expression = SyntaxTrees::expression(syntax, value);
    let row: TypeRow = TypeTable::row(&typing.types, Typing::referent_of(typing, destination));
    let bounded: bool = Checker::bounded_bytes(typing, row);
    transition place > 0 && bounded && written.kind == ExpressionKind::String {
        true -> replaced(checker, typing, value, place)
        _ -> done()
    }

    state replaced(checker: &mut Checker, typing: &Typing, value: u64 in Trapping, place: u64 in Trapping) {
        let length_place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Length, 0, place, 0);
        let length: Value = Value::constant(Typing::value(typing, value));
        Checker::bind_place(checker, typing, length_place, length);
    }

    state done() {}
}

machine Checker::store_value(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement, target: Value, value: Value, origin: u64 in Trapping)
crashes Trap
{
    let replaced: bool = Checker::replace_reference(checker, syntax, resolution, typing, statement, value);
    transition replaced {
        true -> done()
        _ -> destination(checker, typing, statement, target, value, origin)
    }

    state destination(checker: &mut Checker, typing: &Typing, statement: Statement, target: Value, value: Value, origin: u64 in Trapping) {
        transition target.place > 0 {
            true -> located(checker, typing, target.place, value)
            _ -> containing(checker, typing, statement, origin)
        }
    }

    state located(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, value: Value) {
        Checker::bind_place(checker, typing, place, value);
    }

    state containing(checker: &mut Checker, typing: &Typing, statement: Statement, origin: u64 in Trapping) {
        transition origin > 0 {
            true -> forgotten(checker, typing, origin)
            _ -> unknown(checker, statement)
        }
    }

    state forgotten(checker: &mut Checker, typing: &Typing, origin: u64 in Trapping) {
        let place: Place = Checker::place_at(checker, origin - 1);
        let row: TypeRow = Checker::referent_row(typing, place.type_handle);
        transition row.kind == TypeKind::Array || row.kind == TypeKind::Slice {
            true -> contents(checker, typing, origin)
            _ -> whole(checker, typing, origin)
        }
    }

    // The missing element place still identifies its collection footprint.
    // This store preserves the collection's own length, unlike replacing it.
    state contents(checker: &mut Checker, typing: &Typing, origin: u64 in Trapping) {
        Checker::forget_contents(checker, typing, origin);
    }

    state whole(checker: &mut Checker, typing: &Typing, origin: u64 in Trapping) {
        Checker::forget_place(checker, typing, origin);
    }

    state unknown(checker: &mut Checker, statement: Statement) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::UnsupportedCheck, statement.source_span);
    }

    state done() {}
}

// A place takes a new value: its old facts and those of everything inside
// it are forgotten, and an integer place takes the value's term or
// interval.
pub machine Checker::bind_place(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, value: Value)
crashes Trap
{
    transition place > 0 {
        true -> forget(checker, typing, place, value)
        _ -> done()
    }

    // A value whose term names a subject inside the overwritten place, the
    // place's own included (`x = x + 1`), names the old contents: after the
    // place is forgotten that subject stands for the new ones, so only the
    // value's interval, read before forgetting, carries over.
    state forget(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, value: Value) {
        let owner: u64 in Trapping = Checker::subject_place(checker, value.subject);
        let inside: bool = Checker::within(checker, owner, place);
        let stale: bool = value.known && value.subject > 0 && (owner == 0 || inside);
        Checker::forget_place(checker, typing, place);
        Checker::copy_fields(checker, typing, place, value.place);
        let entry: Place = Checker::place_at(checker, place - 1);
        transition entry.subject > 0 {
            true -> rebound(checker, entry.subject, value, stale)
            _ -> done()
        }
    }

    state rebound(checker: &mut Checker, subject: u64 in Trapping, value: Value, stale: bool) {
        transition stale {
            true -> ranged(checker, subject, value)
            _ -> bound(checker, subject, value)
        }
    }

    // subject <= ceiling and -subject <= floor (the floor is stored negated).
    state ranged(checker: &mut Checker, subject: u64 in Trapping, value: Value) {
        Zone::constrain(&mut checker.zone, 0, subject, value.ceiling);
        Zone::constrain(&mut checker.zone, subject, 0, value.floor);
    }

    // subject - value <= 0 and value - subject <= 0.
    state bound(checker: &mut Checker, subject: u64 in Trapping, value: Value) {
        let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
        let unknown: Value = Value::unknown();
        let own: Value = Value { place: 0, known: true, subject: subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        Checker::constrain_difference(checker, own, value, zero);
        Checker::constrain_difference(checker, value, own, zero);
    }

    state done() {}
}

// A transition: the subject once, then each arm under its selection's
// facts, every earlier guard failing.
machine Checker::walk_transition(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    statement: Statement,
    checking: bool
)
crashes Trap
{
    transition statement.has_value {
        true -> subject(checker, syntax, resolution, typing, statement, checking)
        _ -> arms(checker, syntax, resolution, typing, statement, checking, true)
    }

    state subject(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        checking: bool
    ) {
        let epoch: u64 in Trapping = checker.write_epoch;
        Checker::evaluate_tree(checker, syntax, resolution, typing, statement.value, checking);
        let replayable: bool = epoch == checker.write_epoch;
        transition { _ -> arms(checker, syntax, resolution, typing, statement, checking, replayable) }
    }

    state arms(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        checking: bool,
        replayable: bool
    ) {
        let saved: bool = Checker::save_zone(checker, 0);
        transition saved {
            true -> arm(checker, syntax, resolution, typing, statement, 0, checking, replayable)
            _ -> overflow(checker, statement)
        }
    }

    state arm(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        offset: u64 in Trapping,
        checking: bool,
        replayable: bool
    ) {
        transition offset < statement.arm_count && checker.output.machine_accepted {
            true -> selected(checker, syntax, resolution, typing, statement, offset, checking, replayable)
            _ -> finished(checker)
        }
    }

    state selected(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        offset: u64 in Trapping,
        checking: bool,
        replayable: bool
    ) {
        let arm: TransitionArm = SyntaxTrees::arm(syntax, statement.first_arm + offset);
        Checker::restore_zone(checker);
        Checker::select_arm(checker, syntax, resolution, typing, statement, arm, true, checking, replayable);
        Checker::select_guard(checker, syntax, resolution, typing, arm, true, checking);
        Checker::walk_target(checker, syntax, resolution, typing, arm, checking);
        Checker::restore_zone(checker);
        Checker::select_arm(checker, syntax, resolution, typing, statement, arm, false, checking, replayable);
        Checker::select_guard(checker, syntax, resolution, typing, arm, false, checking);
        Checker::resave_zone(checker);
        transition { _ -> arm(checker, syntax, resolution, typing, statement, offset + 1, checking, replayable) }
    }

    // Typing proved the arms cover the subject (typing/coverage.omg): no
    // path passes over every arm.
    state finished(checker: &mut Checker) {
        Checker::drop_saved(checker);
        checker.zone.infeasible = true;
    }

    state overflow(checker: &mut Checker, statement: Statement) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, statement.source_span);
    }
}

// An arm's `if` guard, evaluated after its pattern's facts and binders:
// the guard holds on the selected arm. Passing over the arm establishes
// its failure only where the pattern alone always matched (`_`); after any
// other pattern the subject may have failed to match instead.
pub machine Checker::select_guard(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    arm: TransitionArm,
    chosen: bool,
    checking: bool
)
crashes Trap
{
    transition arm.has_guard && (chosen || arm.kind == ArmPatternKind::Wildcard) {
        true -> evaluated(checker, syntax, resolution, typing, arm, chosen, checking)
        _ -> done()
    }

    state evaluated(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, arm: TransitionArm, chosen: bool, checking: bool) {
        Checker::evaluate_tree(checker, syntax, resolution, typing, arm.guard, checking);
        Checker::assume(checker, syntax, arm.guard, chosen);
        Checker::assume_alias(checker, syntax, resolution, typing, arm.guard, chosen);
    }

    state done() {}
}

// The facts of a transition's arm being selected (`chosen`) or passed over
// (`Checker::arm_facts`). Its guard is a tree of its own, evaluated here;
// its subject and literal pattern are trees evaluated before, evaluated
// again for their values where the facts need them.
machine Checker::select_arm(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    statement: Statement,
    arm: TransitionArm,
    chosen: bool,
    checking: bool,
    replayable: bool
)
crashes Trap
{
    // A subject whose evaluation wrote storage has captured reads that a
    // replay cannot recover. Its post-evaluation zone remains usable, but
    // syntax alone grants no additional subject facts on either arm.
    transition statement.has_value && !replayable {
        true -> captured(checker, typing, arm, chosen)
        _ -> classify(checker, syntax, resolution, typing, statement, arm, chosen, checking)
    }

    state captured(checker: &mut Checker, typing: &Typing, arm: TransitionArm, chosen: bool) {
        transition chosen {
            true -> unknown_binders(checker, typing, arm, 0)
            _ -> done()
        }
    }

    // Withholding subject facts never preserves an old binder value.
    // Ordinary pattern bindings still start from their declared type.
    state unknown_binders(checker: &mut Checker, typing: &Typing, arm: TransitionArm, offset: u64 in Trapping) {
        transition offset < arm.field_count {
            true -> unknown_binder(checker, typing, arm, offset)
            _ -> done()
        }
    }

    state unknown_binder(checker: &mut Checker, typing: &Typing, arm: TransitionArm, offset: u64 in Trapping) {
        let handle: u64 in Trapping = arm.first_field + offset;
        let type_handle: u64 in Trapping = Typing::binder_type(typing, handle);
        transition type_handle > 0 {
            true -> reset_binder(checker, typing, arm, offset, handle, type_handle)
            _ -> unknown_binders(checker, typing, arm, offset + 1)
        }
    }

    state reset_binder(checker: &mut Checker, typing: &Typing, arm: TransitionArm, offset: u64 in Trapping, handle: u64 in Trapping, type_handle: u64 in Trapping) {
        let place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Binder, handle, 0, type_handle);
        Checker::forget_place(checker, typing, place);
        transition { _ -> unknown_binders(checker, typing, arm, offset + 1) }
    }

    state classify(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement, arm: TransitionArm, chosen: bool, checking: bool) {
        let unknown: Value = Value::unknown();
        transition arm.kind {
            ArmPatternKind::Guard -> guard(checker, syntax, resolution, typing, statement, arm, chosen, checking, unknown)
            ArmPatternKind::Literal -> literal(checker, syntax, resolution, typing, statement, arm, chosen, unknown)
            ArmPatternKind::Case -> case_arm(checker, syntax, resolution, typing, statement, arm, chosen, unknown)
            _ -> done()
        }
    }

    state guard(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        arm: TransitionArm,
        chosen: bool,
        checking: bool,
        unknown: Value
    ) {
        Checker::evaluate_tree(checker, syntax, resolution, typing, arm.pattern, checking);
        Checker::arm_facts(checker, syntax, resolution, typing, statement.value, unknown, arm, chosen);
        Checker::assume_alias(checker, syntax, resolution, typing, arm.pattern, chosen);
    }

    state literal(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        arm: TransitionArm,
        chosen: bool,
        unknown: Value
    ) {
        let pattern: Expression = SyntaxTrees::expression(syntax, arm.pattern);
        transition pattern.kind == ExpressionKind::Boolean {
            true -> subject_facts(checker, syntax, resolution, typing, statement, arm, chosen, unknown)
            _ -> integer(checker, syntax, resolution, typing, statement, arm, chosen)
        }
    }

    // Passing over an integer literal establishes nothing.
    state integer(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        arm: TransitionArm,
        chosen: bool
    ) {
        transition chosen {
            true -> pattern_value(checker, syntax, resolution, typing, statement, arm)
            _ -> done()
        }
    }

    state pattern_value(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement, arm: TransitionArm) {
        Checker::replay_tree(checker, syntax, resolution, typing, arm.pattern);
        let pattern: Value = Checker::value_at(checker, arm.pattern);
        transition { _ -> subject_facts(checker, syntax, resolution, typing, statement, arm, true, pattern) }
    }

    // Passing over a case or a value pattern establishes nothing.
    state case_arm(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        arm: TransitionArm,
        chosen: bool,
        unknown: Value
    ) {
        transition chosen {
            true -> pattern_value(checker, syntax, resolution, typing, statement, arm)
            _ -> done()
        }
    }

    state subject_facts(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        arm: TransitionArm,
        chosen: bool,
        pattern: Value
    ) {
        Checker::replay_tree(checker, syntax, resolution, typing, statement.value);
        Checker::arm_facts(checker, syntax, resolution, typing, statement.value, pattern, arm, chosen);
        Checker::assume_subject_alias(checker, syntax, resolution, typing, statement.value, arm, chosen);
    }

    state done() {}
}

// The facts of an arm being selected (`chosen`) or passed over, from the
// current values of its subject and patterns (`pattern` is a value
// pattern's): a guard holds or fails, a Boolean literal arm makes the
// subject hold or fail, and another value pattern, an integer literal or a
// path denoting no case, makes the subject equal it. Passing over a value
// pattern establishes nothing. A case arm's binders are places of their
// payload types, and a chosen case arm assumes its case's own `where`
// facts.
pub machine Checker::arm_facts(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    subject: u64 in Trapping,
    pattern: Value,
    arm: TransitionArm,
    chosen: bool
)
crashes Trap
{
    transition arm.kind {
        ArmPatternKind::Guard -> assumed(checker, syntax, arm.pattern, chosen)
        ArmPatternKind::Literal -> literal(checker, syntax, subject, pattern, arm, chosen)
        ArmPatternKind::Case -> case_arm(checker, syntax, resolution, typing, subject, pattern, arm, chosen)
        _ -> done()
    }

    state assumed(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, holds: bool) {
        Checker::assume(checker, syntax, root, holds);
    }

    // `true -> ...` over a Boolean subject: the subject holds when chosen;
    // `false -> ...` the reverse.
    state literal(checker: &mut Checker, syntax: &SyntaxTrees, subject: u64 in Trapping, pattern: Value, arm: TransitionArm, chosen: bool) {
        let written: Expression = SyntaxTrees::expression(syntax, arm.pattern);
        let holds: bool = written.flag == chosen;
        transition written.kind == ExpressionKind::Boolean {
            true -> assumed(checker, syntax, subject, holds)
            _ -> integer(checker, subject, pattern, chosen)
        }
    }

    state integer(checker: &mut Checker, subject: u64 in Trapping, pattern: Value, chosen: bool) {
        transition chosen {
            true -> equal(checker, subject, pattern)
            _ -> done()
        }
    }

    state equal(checker: &mut Checker, subject: u64 in Trapping, pattern: Value) {
        let subject_value: Value = Checker::value_at(checker, subject);
        let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
        Checker::constrain_difference(checker, subject_value, pattern, zero);
        Checker::constrain_difference(checker, pattern, subject_value, zero);
    }

    state case_arm(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        subject: u64 in Trapping,
        pattern: Value,
        arm: TransitionArm,
        chosen: bool
    ) {
        let binding: ValueBinding = NameResolution::value_binding(resolution, arm.pattern);
        transition chosen {
            true -> matched(checker, syntax, resolution, typing, subject, pattern, arm, binding)
            _ -> done()
        }
    }

    // A case pattern assumes its case's facts; a path denoting no case is a
    // value pattern, which the subject equals.
    state matched(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        subject: u64 in Trapping,
        pattern: Value,
        arm: TransitionArm,
        binding: ValueBinding
    ) {
        transition binding {
            ValueBinding::DataCase { item, data_case } -> selected(checker, syntax, resolution, typing, subject, arm, data_case)
            _ -> equal(checker, subject, pattern)
        }
    }

    state selected(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, subject: u64 in Trapping, arm: TransitionArm, data_case: u64 in Trapping) {
        Checker::assume_case_facts(checker, syntax, resolution, typing, subject, arm, data_case);
    }

    state done() {}
}

// An arm's target: a jump contributes its arguments' facts to its state's
// arrival; a terminal call or value is evaluated where it completes, and it
// and the Unit completion `{}` return, owing the machine's `ensures` facts.
machine Checker::walk_target(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    arm: TransitionArm,
    checking: bool
)
crashes Trap
{
    transition checker.zone.infeasible {
        true -> done()
        _ -> feasible(checker, syntax, resolution, typing, arm, checking)
    }

    state feasible(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        arm: TransitionArm,
        checking: bool
    ) {
        transition arm.target_kind == ArmTargetKind::Unit {
            true -> completed(checker, syntax, resolution, typing, arm, checking)
            _ -> evaluated(checker, syntax, resolution, typing, arm, checking)
        }
    }

    state completed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, arm: TransitionArm, checking: bool) {
        let value: Value = Value::unknown();
        transition checking {
            true -> owed(checker, syntax, resolution, typing, arm, value)
            _ -> done()
        }
    }

    state owed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, arm: TransitionArm, value: Value) {
        Checker::require_guarantees(checker, syntax, resolution, typing, value, arm.source_span);
    }

    state evaluated(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        arm: TransitionArm,
        checking: bool
    ) {
        Checker::evaluate_tree(checker, syntax, resolution, typing, arm.target, checking);
        let selection: Selection = Typing::selection(typing, arm.target);
        transition selection {
            Selection::State { handle } -> jump(checker, syntax, resolution, typing, arm.target, handle, checking)
            _ -> terminal(checker, syntax, resolution, typing, arm, checking)
        }
    }

    state terminal(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, arm: TransitionArm, checking: bool) {
        let value: Value = Checker::value_at(checker, arm.target);
        transition checking {
            true -> returned(checker, syntax, resolution, typing, arm, value)
            _ -> done()
        }
    }

    // A returned value meets the result's qualification and its machine's
    // `ensures` facts.
    state returned(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, arm: TransitionArm, value: Value) {
        Checker::require_result_qualification(checker, syntax, resolution, typing, arm.target, value, arm.source_span);
        transition { _ -> owed(checker, syntax, resolution, typing, arm, value) }
    }

    // A jump is an edge of the body's local control graph
    // (termination.omg), to its target state's node.
    state jump(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, call: u64 in Trapping, state: u64 in Trapping, checking: bool) {
        let node: u64 in Trapping = state - checker.first_state + 1;
        Checker::record_edge(checker, node);
        transition checking {
            true -> required(checker, syntax, resolution, typing, call, state, node)
            _ -> contributed(checker, syntax, typing, call, state)
        }
    }

    // A target state's `requires` facts must hold at the jump, and a cyclic
    // jump of a terminating body descends its ranking.
    state required(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, call: u64 in Trapping, state: u64 in Trapping, node: u64 in Trapping) {
        let item: StateItem = SyntaxTrees::state_item(syntax, state);
        let expression: Expression = SyntaxTrees::expression(syntax, call);
        Checker::require_descent(checker, syntax, resolution, typing, expression, node, item.first_parameter, item.parameter_count);
        Checker::require_argument_qualifications(checker, syntax, resolution, typing, expression, item.first_parameter, item.parameter_count);
        let held: bool = Checker::decide_call_facts(checker, syntax, resolution, typing, item.first_clause, item.clause_count, item.first_parameter, expression, ClauseKind::Requires, true);
        transition held {
            true -> done()
            _ -> unproven(checker, expression)
        }
    }

    state unproven(checker: &mut Checker, expression: Expression) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::RequirementUnproven, expression.source_span);
    }

    state contributed(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, call: u64 in Trapping, state: u64 in Trapping) {
        Checker::contribute(checker, syntax, typing, call, state);
    }

    state done() {}
}
