use psi::checking::checker;
use psi::checking::constructions;
use psi::checking::evaluation;
use psi::checking::places;
use psi::checking::zone;
use psi::syntax::syntax;
use psi::types::types;

// Field paths an arrival carries. Besides a state's integer and Boolean
// parameters, a jump projects the subject places it knows below an argument
// that is a place (`table.count` for a parameter `table: &mut Table`), so a
// guard on a field reaches the state the guard selects. A path is the parameter's
// offset and up to four projections, each a field or a slice's `.len` with
// the type of the place it reaches. A state keeps the up to 40 paths its
// demand derives (demand.omg), numbered after its subject parameters; its
// body enters them as places in that order, so its subjects match its
// arrival zone's. A path one jump did not project is unknown in that jump's
// contribution.
public data ArrivalStep [copy] {
    length: bool;
    field: u64 in Trapping;
    type_handle: u64 in Trapping;
}

public data ArrivalPath [copy] {
    parameter: u64 in Trapping;
    depth: u64 in Trapping;
    step0: ArrivalStep;
    step1: ArrivalStep;
    step2: ArrivalStep;
    step3: ArrivalStep;
}

// A path's projection at `index` (0 through 3).
public machine ArrivalPath::step(path: ArrivalPath, index: u64 in Trapping) -> ArrivalStep {
    transition index {
        0 -> chosen(path.step0)
        1 -> chosen(path.step1)
        2 -> chosen(path.step2)
        _ -> chosen(path.step3)
    }

    machine chosen(step: ArrivalStep) -> ArrivalStep {
        step
    }
}

// The first `count` steps of `path`, collected deepest first, in order from
// the parameter, as a path of that depth.
public machine ArrivalPath::reversed(path: ArrivalPath, count: u64 in Trapping) -> ArrivalPath
crashes Trap
{
    let mut ordered: ArrivalPath = path;
    ordered.depth = count;
    transition { _ -> swap(ordered, 0, count) }

    machine swap(path: ArrivalPath, low: u64 in Trapping, count: u64 in Trapping) -> ArrivalPath {
        transition low * 2 + 1 < count {
            true -> swapped(path, low, count)
            _ -> finished(path)
        }
    }

    machine swapped(path: ArrivalPath, low: u64 in Trapping, count: u64 in Trapping) -> ArrivalPath {
        let high: u64 in Trapping = count - 1 - low;
        transition low < 4 && high < 4 {
            true -> exchanged(path, low, high, count)
            _ -> finished(path)
        }
    }

    machine exchanged(path: ArrivalPath, low: u64 in Trapping, high: u64 in Trapping, count: u64 in Trapping) -> ArrivalPath {
        let lower: ArrivalStep = ArrivalPath::step(path, low);
        let higher: ArrivalStep = ArrivalPath::step(path, high);
        let moved: ArrivalPath = ArrivalPath::with_step(path, low, higher);
        let result: ArrivalPath = ArrivalPath::with_step(moved, high, lower);
        transition { _ -> swap(result, low + 1, count) }
    }

    machine finished(path: ArrivalPath) -> ArrivalPath {
        path
    }
}

// `path` with its projection at `index` (0 through 3) replaced.
public machine ArrivalPath::with_step(path: ArrivalPath, index: u64 in Trapping, step: ArrivalStep) -> ArrivalPath {
    transition index {
        0 -> first(path, step)
        1 -> second(path, step)
        2 -> third(path, step)
        _ -> fourth(path, step)
    }

    machine first(path: ArrivalPath, step: ArrivalStep) -> ArrivalPath {
        ArrivalPath { parameter: path.parameter, depth: path.depth, step0: step, step1: path.step1, step2: path.step2, step3: path.step3 }
    }

    machine second(path: ArrivalPath, step: ArrivalStep) -> ArrivalPath {
        ArrivalPath { parameter: path.parameter, depth: path.depth, step0: path.step0, step1: step, step2: path.step2, step3: path.step3 }
    }

    machine third(path: ArrivalPath, step: ArrivalStep) -> ArrivalPath {
        ArrivalPath { parameter: path.parameter, depth: path.depth, step0: path.step0, step1: path.step1, step2: step, step3: path.step3 }
    }

    machine fourth(path: ArrivalPath, step: ArrivalStep) -> ArrivalPath {
        ArrivalPath { parameter: path.parameter, depth: path.depth, step0: path.step0, step1: path.step1, step2: path.step2, step3: step }
    }
}

public machine Checker::path_count(checker: &Checker, offset: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition offset < 128 {
        true -> read(checker, offset)
        _ -> invalid()
    }

    machine read(checker: &Checker, offset: u64 in Trapping) -> u64 in Trapping
    requires offset < 128
    {
        checker.path_counts[offset] as u64 in Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

public machine Checker::set_path_count(checker: &mut Checker, offset: u64 in Trapping, count: u64 in Trapping)
crashes Trap
{
    transition offset < 128 {
        true -> write(checker, offset, count)
        _ -> invalid()
    }

    machine write(checker: &mut Checker, offset: u64 in Trapping, count: u64 in Trapping)
    requires offset < 128
    {
        checker.path_counts[offset] = count as u64;
    }

    machine invalid() {
        crash Trap;
    }
}

public machine Checker::arrival_path(checker: &Checker, offset: u64 in Trapping, index: u64 in Trapping) -> ArrivalPath
crashes Trap
{
    transition offset < 128 && index < 40 {
        true -> slot(checker, offset * 40 + index)
        _ -> invalid()
    }

    machine slot(checker: &Checker, slot: u64 in Trapping) -> ArrivalPath {
        transition slot < 5120 {
            true -> read(checker, slot)
            _ -> invalid()
        }
    }

    machine read(checker: &Checker, slot: u64 in Trapping) -> ArrivalPath
    requires slot < 5120
    {
        checker.paths[slot]
    }

    machine invalid() -> ArrivalPath {
        crash Trap;
    }
}

machine Checker::store_arrival_path(checker: &mut Checker, offset: u64 in Trapping, index: u64 in Trapping, path: ArrivalPath)
crashes Trap
{
    transition offset < 128 && index < 40 {
        true -> slot(checker, offset * 40 + index, path)
        _ -> invalid()
    }

    machine slot(checker: &mut Checker, slot: u64 in Trapping, path: ArrivalPath) {
        transition slot < 5120 {
            true -> write(checker, slot, path)
            _ -> invalid()
        }
    }

    machine write(checker: &mut Checker, slot: u64 in Trapping, path: ArrivalPath)
    requires slot < 5120
    {
        checker.paths[slot] = path;
    }

    machine invalid() {
        crash Trap;
    }
}

// The path from place `outer` (one-based) down to place `inner`, when
// `inner` lies strictly within it by at most four field or `.len` steps;
// depth zero otherwise.
public machine Checker::path_below(checker: &Checker, outer: u64 in Trapping, inner: u64 in Trapping, parameter: u64 in Trapping) -> ArrivalPath
crashes Trap
{
    let empty: ArrivalStep = ArrivalStep { length: false, field: 0, type_handle: 0 };
    let none: ArrivalPath = ArrivalPath { parameter: parameter, depth: 0, step0: empty, step1: empty, step2: empty, step3: empty };
    transition { _ -> climb(checker, outer, inner, none, 0) }

    // Collect steps upward from `current`, deepest last: the step at
    // `count` from the bottom is written at index `count` and reversed at
    // the end.
    machine climb(checker: &Checker, outer: u64 in Trapping, current: u64 in Trapping, path: ArrivalPath, count: u64 in Trapping) -> ArrivalPath {
        transition current == outer && count > 0 {
            true -> reversed(path, count)
            _ -> step(checker, outer, current, path, count)
        }
    }

    machine step(checker: &Checker, outer: u64 in Trapping, current: u64 in Trapping, path: ArrivalPath, count: u64 in Trapping) -> ArrivalPath {
        let place: Place = Checker::place_at(checker, current - 1);
        let projection: bool = place.kind == PlaceKind::Field || place.kind == PlaceKind::Length;
        transition projection && place.parent > 0 && count < 4 {
            true -> recorded(checker, outer, place, path, count)
            _ -> outside(path)
        }
    }

    machine recorded(checker: &Checker, outer: u64 in Trapping, place: Place, path: ArrivalPath, count: u64 in Trapping) -> ArrivalPath {
        let step: ArrivalStep = ArrivalStep { length: place.kind == PlaceKind::Length, field: place.handle, type_handle: place.type_handle };
        let extended: ArrivalPath = ArrivalPath::with_step(path, count, step);
        transition { _ -> climb(checker, outer, place.parent, extended, count + 1) }
    }

    machine reversed(path: ArrivalPath, count: u64 in Trapping) -> ArrivalPath {
        let ordered: ArrivalPath = ArrivalPath::reversed(path, count);
        ordered
    }

    machine outside(path: ArrivalPath) -> ArrivalPath {
        let mut none: ArrivalPath = path;
        none.depth = 0;
        none
    }
}

// Whether two paths name the same place below the same parameter.
machine Checker::same_path(first: ArrivalPath, second: ArrivalPath) -> bool {
    transition first.parameter == second.parameter && first.depth == second.depth {
        true -> steps(first, second, 0)
        _ -> no()
    }

    machine steps(first: ArrivalPath, second: ArrivalPath, index: u64 in Trapping) -> bool {
        transition index < first.depth && index < 4 {
            true -> step(first, second, index)
            _ -> yes()
        }
    }

    machine step(first: ArrivalPath, second: ArrivalPath, index: u64 in Trapping) -> bool {
        let left: ArrivalStep = ArrivalPath::step(first, index);
        let right: ArrivalStep = ArrivalPath::step(second, index);
        transition left.length == right.length && left.field == right.field {
            true -> steps(first, second, index + 1)
            _ -> no()
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// The index of `path` among state `offset`'s paths, the ones its demand
// derived (demand.omg); 40 when it has none.
public machine Checker::path_index(checker: &Checker, offset: u64 in Trapping, path: ArrivalPath) -> u64 in Trapping
crashes Trap
{
    let count: u64 in Trapping = Checker::path_count(checker, offset);
    transition { _ -> search(checker, offset, path, count, 0) }

    machine search(checker: &Checker, offset: u64 in Trapping, path: ArrivalPath, count: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        transition index < count && index < 40 {
            true -> compare(checker, offset, path, count, index)
            _ -> found(40)
        }
    }

    machine compare(checker: &Checker, offset: u64 in Trapping, path: ArrivalPath, count: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        let existing: ArrivalPath = Checker::arrival_path(checker, offset, index);
        let same: bool = Checker::same_path(existing, path);
        transition same {
            true -> found(index)
            _ -> search(checker, offset, path, count, index + 1)
        }
    }

    machine found(index: u64 in Trapping) -> u64 in Trapping {
        index
    }
}

// Add `path` to state `offset`'s paths when it is new and there is room.
// Whether it was added.
public machine Checker::add_arrival_path(checker: &mut Checker, offset: u64 in Trapping, path: ArrivalPath) -> bool
crashes Trap
{
    let index: u64 in Trapping = Checker::path_index(checker, offset, path);
    let count: u64 in Trapping = Checker::path_count(checker, offset);
    transition index == 40 && count < 40 && path.depth > 0 && path.depth <= 4 {
        true -> appended(checker, offset, path, count)
        _ -> unchanged()
    }

    machine appended(checker: &mut Checker, offset: u64 in Trapping, path: ArrivalPath, count: u64 in Trapping) -> bool {
        Checker::store_arrival_path(checker, offset, count, path);
        Checker::set_path_count(checker, offset, count + 1);
        true
    }

    machine unchanged() -> bool {
        false
    }
}

// Enter state `offset`'s paths as places below its parameters, in order.
// Whether every path's place took the subject its arrival numbers it with.
public machine Checker::enter_paths(checker: &mut Checker, typing: &Typing, offset: u64 in Trapping, first_parameter: u64 in Trapping) -> bool
crashes Trap
{
    let count: u64 in Trapping = Checker::path_count(checker, offset);
    transition { _ -> next(checker, typing, offset, first_parameter, count, 0, true) }

    machine next(checker: &mut Checker, typing: &Typing, offset: u64 in Trapping, first_parameter: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping, matched: bool) -> bool {
        transition index < count && index < 40 {
            true -> path(checker, typing, offset, first_parameter, count, index, matched)
            _ -> finished(matched)
        }
    }

    machine path(checker: &mut Checker, typing: &Typing, offset: u64 in Trapping, first_parameter: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping, matched: bool) -> bool {
        let path: ArrivalPath = Checker::arrival_path(checker, offset, index);
        let expected: u64 in Trapping = checker.subject_count as u64 in Trapping;
        let root: u64 in Trapping = Checker::find_place(checker, PlaceKind::Parameter, first_parameter + path.parameter, 0);
        let place: u64 in Trapping = Checker::enter_path(checker, typing, root, path);
        let entry: Place = Checker::place_or_absent(checker, place);
        let numbered: bool = place > 0 && entry.subject == expected;
        transition { _ -> next(checker, typing, offset, first_parameter, count, index + 1, matched && numbered) }
    }

    machine finished(matched: bool) -> bool {
        matched
    }
}

// The places of `path` below `root` (one-based), entered as needed; the
// last one, or zero when `root` is absent.
public machine Checker::enter_path(checker: &mut Checker, typing: &Typing, root: u64 in Trapping, path: ArrivalPath) -> u64 in Trapping
crashes Trap
{
    transition { _ -> step(checker, typing, root, path, 0) }

    machine step(checker: &mut Checker, typing: &Typing, current: u64 in Trapping, path: ArrivalPath, index: u64 in Trapping) -> u64 in Trapping {
        transition current > 0 && index < path.depth && index < 4 {
            true -> entered(checker, typing, current, path, index)
            _ -> finished(current)
        }
    }

    machine entered(checker: &mut Checker, typing: &Typing, current: u64 in Trapping, path: ArrivalPath, index: u64 in Trapping) -> u64 in Trapping {
        let projection: ArrivalStep = ArrivalPath::step(path, index);
        let kind: PlaceKind = Checker::step_kind(projection.length);
        let place: u64 in Trapping = Checker::place(checker, typing, kind, projection.field, current, projection.type_handle);
        transition { _ -> step(checker, typing, place, path, index + 1) }
    }

    machine finished(current: u64 in Trapping) -> u64 in Trapping {
        current
    }
}

machine Checker::step_kind(length: bool) -> PlaceKind {
    transition length {
        true -> chosen(PlaceKind::Length)
        _ -> chosen(PlaceKind::Field)
    }

    machine chosen(kind: PlaceKind) -> PlaceKind {
        kind
    }
}

// A place (one-based) or, for zero, a place with no subject.
public machine Checker::place_or_absent(checker: &Checker, place: u64 in Trapping) -> Place
crashes Trap
{
    transition place > 0 {
        true -> entry(checker, place)
        _ -> absent()
    }

    machine entry(checker: &Checker, place: u64 in Trapping) -> Place {
        let entry: Place = Checker::place_at(checker, place - 1);
        entry
    }

    machine absent() -> Place {
        Place { kind: PlaceKind::Parameter, handle: 0, parent: 0, type_handle: 0, subject: 0 }
    }
}

// Project a jump's field paths: every integer place below an argument that
// is a place, into state `offset`'s path slots after its `first_subject`
// integer-parameter subjects. Slots this jump does not reach are unknown.
// The number of projected subjects, the zero subject included.
public machine Checker::project_paths(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    typing: &Typing,
    expression: Expression,
    item: StateItem,
    offset: u64 in Trapping,
    first_subject: u64 in Trapping
) -> u64 in Trapping
crashes Trap
{
    transition { _ -> clear(checker, syntax, typing, expression, item, offset, first_subject, 0) }

    machine clear(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: StateItem,
        offset: u64 in Trapping,
        first_subject: u64 in Trapping,
        slot: u64 in Trapping
    ) -> u64 in Trapping {
        transition slot < 40 && first_subject + slot < 64 {
            true -> cleared(checker, syntax, typing, expression, item, offset, first_subject, slot)
            _ -> parameter(checker, syntax, typing, expression, item, offset, first_subject, 0)
        }
    }

    machine cleared(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: StateItem,
        offset: u64 in Trapping,
        first_subject: u64 in Trapping,
        slot: u64 in Trapping
    ) -> u64 in Trapping {
        let unknown: Value = Value::unknown();
        Checker::set_projection(checker, first_subject + slot, unknown);
        transition { _ -> clear(checker, syntax, typing, expression, item, offset, first_subject, slot + 1) }
    }

    machine parameter(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: StateItem,
        offset: u64 in Trapping,
        first_subject: u64 in Trapping,
        index: u64 in Trapping
    ) -> u64 in Trapping {
        transition index < item.parameter_count && index < expression.count {
            true -> argument(checker, syntax, typing, expression, item, offset, first_subject, index)
            _ -> counted(checker, offset, first_subject)
        }
    }

    machine argument(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: StateItem,
        offset: u64 in Trapping,
        first_subject: u64 in Trapping,
        index: u64 in Trapping
    ) -> u64 in Trapping {
        let handle: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + index);
        let value: Value = Checker::value_at(checker, handle);
        transition value.place > 0 && value.subject == 0 {
            true -> settled(checker, syntax, typing, expression, item, offset, first_subject, index, value.place)
            _ -> parameter(checker, syntax, typing, expression, item, offset, first_subject, index + 1)
        }
    }

    // Fields a construction wrote below the argument become its places.
    machine settled(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: StateItem,
        offset: u64 in Trapping,
        first_subject: u64 in Trapping,
        index: u64 in Trapping,
        root: u64 in Trapping
    ) -> u64 in Trapping {
        Checker::settle_pending(checker, typing, root);
        transition { _ -> place(checker, syntax, typing, expression, item, offset, first_subject, index, root, 0) }
    }

    // Each subject place of the body below the argument's place.
    machine place(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: StateItem,
        offset: u64 in Trapping,
        first_subject: u64 in Trapping,
        index: u64 in Trapping,
        root: u64 in Trapping,
        candidate: u64 in Trapping
    ) -> u64 in Trapping {
        transition candidate < checker.place_count {
            true -> below(checker, syntax, typing, expression, item, offset, first_subject, index, root, candidate)
            _ -> parameter(checker, syntax, typing, expression, item, offset, first_subject, index + 1)
        }
    }

    machine below(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: StateItem,
        offset: u64 in Trapping,
        first_subject: u64 in Trapping,
        index: u64 in Trapping,
        root: u64 in Trapping,
        candidate: u64 in Trapping
    ) -> u64 in Trapping {
        let entry: Place = Checker::place_at(checker, candidate);
        let path: ArrivalPath = Checker::path_below(checker, root, candidate + 1, index);
        transition entry.subject > 0 && path.depth > 0 {
            true -> projected(checker, syntax, typing, expression, item, offset, first_subject, index, root, candidate, path)
            _ -> place(checker, syntax, typing, expression, item, offset, first_subject, index, root, candidate + 1)
        }
    }

    machine projected(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: StateItem,
        offset: u64 in Trapping,
        first_subject: u64 in Trapping,
        index: u64 in Trapping,
        root: u64 in Trapping,
        candidate: u64 in Trapping,
        path: ArrivalPath
    ) -> u64 in Trapping {
        let slot: u64 in Trapping = Checker::path_index(checker, offset, path);
        let value: Value = Checker::place_value(checker, candidate + 1);
        transition slot < 40 && first_subject + slot < 64 {
            true -> stored(checker, syntax, typing, expression, item, offset, first_subject, index, root, candidate, first_subject + slot, value)
            _ -> place(checker, syntax, typing, expression, item, offset, first_subject, index, root, candidate + 1)
        }
    }

    machine stored(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        expression: Expression,
        item: StateItem,
        offset: u64 in Trapping,
        first_subject: u64 in Trapping,
        index: u64 in Trapping,
        root: u64 in Trapping,
        candidate: u64 in Trapping,
        subject: u64 in Trapping,
        value: Value
    ) -> u64 in Trapping {
        Checker::set_projection(checker, subject, value);
        transition { _ -> place(checker, syntax, typing, expression, item, offset, first_subject, index, root, candidate + 1) }
    }

    machine counted(checker: &mut Checker, offset: u64 in Trapping, first_subject: u64 in Trapping) -> u64 in Trapping {
        let paths: u64 in Trapping = Checker::path_count(checker, offset);
        let count: u64 in Trapping = first_subject + paths;
        transition count <= 64 {
            true -> total(count)
            _ -> total(64)
        }
    }

    machine total(count: u64 in Trapping) -> u64 in Trapping {
        count
    }
}
