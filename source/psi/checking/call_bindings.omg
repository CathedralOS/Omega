// A complete positional roster. Missing capacity is not an unbound formal:
// no fact is admitted from an incomplete substitution.
public data ArgumentValues [copy] {
    valid: bool;
    count: u64 in Trapping;
    values: [Value; 64];
}

// The live substitution is shared with construction/domain field bindings.
// Nested fact use restores the exact roster and all its interpretation flags.
public data ArgumentScope [copy] {
    arguments: ArgumentValues;
    substituting: bool;
    first_parameter: u64 in Trapping;
    field_values: bool;
    field_first: u64 in Trapping;
    fields_parent: u64 in Trapping;
}

public machine argument_values_empty(arguments: &mut ArgumentValues)
crashes Trap
{
    arguments.valid = true;
    arguments.count = 0;
    transition { _ -> next(arguments, 0) }
    machine next(arguments: &mut ArgumentValues, offset: u64 in Trapping) {
        transition offset < 64 {
            true -> clear(arguments, offset)
            _ -> {}
        }
    }
    machine clear(arguments: &mut ArgumentValues, offset: u64 in Trapping)
    requires offset < 64
    {
        arguments.values[offset] = value_unknown();
        transition { _ -> next(arguments, offset + 1) }
    }
}

public machine capture_argument_scope(checker: &Checker, scope: &mut ArgumentScope)
crashes Trap
{
    argument_values_empty(&mut scope.arguments);
    scope.substituting = checker.substituting;
    scope.first_parameter = 0;
    scope.field_values = checker.field_values;
    scope.field_first = 0;
    scope.fields_parent = checker.fields_parent;
    transition checker.substituting || checker.field_values {
        true -> active(checker, scope)
        _ -> {}
    }
    machine active(checker: &Checker, scope: &mut ArgumentScope) {
        scope.arguments.count = checker.argument_count;
        scope.arguments.valid = checker.argument_count <= 64;
        transition checker.substituting {
            true -> parameters(checker, scope)
            _ -> fields(checker, scope)
        }
    }
    machine parameters(checker: &Checker, scope: &mut ArgumentScope) {
        scope.first_parameter = checker.argument_first;
        transition { _ -> fields(checker, scope) }
    }
    machine fields(checker: &Checker, scope: &mut ArgumentScope) {
        transition checker.field_values {
            true -> field_roster(checker, scope)
            _ -> next(checker, scope, 0)
        }
    }
    machine field_roster(checker: &Checker, scope: &mut ArgumentScope) {
        scope.field_first = checker.field_first;
        transition { _ -> next(checker, scope, 0) }
    }
    machine next(checker: &Checker, scope: &mut ArgumentScope, offset: u64 in Trapping) {
        transition offset < scope.arguments.count && offset < 64 {
            true -> capture(checker, scope, offset)
            _ -> {}
        }
    }
    machine capture(checker: &Checker, scope: &mut ArgumentScope, offset: u64 in Trapping)
    requires offset < 64
    {
        scope.arguments.values[offset] = argument_value(checker, offset);
        transition { _ -> next(checker, scope, offset + 1) }
    }
}

public machine restore_argument_scope(checker: &mut Checker, scope: &ArgumentScope)
crashes Trap
{
    checker.substituting = scope.substituting;
    checker.argument_first = scope.first_parameter;
    checker.argument_count = scope.arguments.count;
    checker.field_values = scope.field_values;
    checker.field_first = scope.field_first;
    checker.fields_parent = scope.fields_parent;
    transition { _ -> next(checker, scope, 0) }
    machine next(checker: &mut Checker, scope: &ArgumentScope, offset: u64 in Trapping) {
        transition offset < 64 {
            true -> restore(checker, scope, offset)
            _ -> {}
        }
    }
    machine restore(checker: &mut Checker, scope: &ArgumentScope, offset: u64 in Trapping)
    requires offset < 64
    {
        checker.arguments[offset] = scope.arguments.values[offset];
        transition { _ -> next(checker, scope, offset + 1) }
    }
}

public machine capture_call_arguments(checker: &Checker, syntax: &SyntaxTrees, call: Expression, arguments: &mut ArgumentValues)
crashes Trap
{
    argument_values_empty(arguments);
    arguments.count = operand_count(call);
    arguments.valid = arguments.count <= 64;
    transition { _ -> next(checker, syntax, call, arguments, 0) }
    machine next(checker: &Checker, syntax: &SyntaxTrees, call: Expression, arguments: &mut ArgumentValues, offset: u64 in Trapping) {
        transition offset < arguments.count && offset < 64 {
            true -> capture(checker, syntax, call, arguments, offset)
            _ -> {}
        }
    }
    machine capture(checker: &Checker, syntax: &SyntaxTrees, call: Expression, arguments: &mut ArgumentValues, offset: u64 in Trapping)
    requires offset < 64
    {
        let handle: u64 in Trapping = checker_operand(syntax, call, offset);
        arguments.values[offset] = value_at(checker, handle);
        transition { _ -> next(checker, syntax, call, arguments, offset + 1) }
    }
}

// Apply an authenticated complete roster to a declaration-owned clause run.
// This is the same fact evaluator for real calls and universal refinement;
// only the producer of the actual values differs.
public machine decide_bound_facts(
    checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution,
    typing: &Typing, clauses: CallClauses, arguments: &ArgumentValues,
    kind: ClauseKind, proving: bool
) -> bool
crashes Trap
{
    transition arguments.valid && arguments.count == clauses.parameter_count && arguments.count <= 64 {
        true -> scoped(checker, syntax, resolution, typing, clauses, arguments, kind, proving)
        _ -> false
    }
    machine scoped(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, clauses: CallClauses, arguments: &ArgumentValues, kind: ClauseKind, proving: bool) -> bool {
        let mut previous: ArgumentScope;
        capture_argument_scope(checker, &mut previous);
        transition previous.arguments.valid {
            true -> installed(checker, syntax, resolution, typing, clauses, arguments, kind, proving, &previous)
            _ -> false
        }
    }
    machine installed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, clauses: CallClauses, arguments: &ArgumentValues, kind: ClauseKind, proving: bool, previous: &ArgumentScope) -> bool {
        install_argument_values(checker, clauses.first_parameter, arguments);
        let held: bool = decide_facts(checker, syntax, resolution, typing, clauses.first_clause, clauses.clause_count, kind, proving);
        restore_argument_scope(checker, previous);
        held
    }
}

public machine install_argument_values(checker: &mut Checker, first: u64 in Trapping, arguments: &ArgumentValues)
crashes Trap
{
    checker.substituting = true;
    checker.argument_first = first;
    checker.argument_count = arguments.count;
    checker.field_values = false;
    checker.fields_parent = 0;
    transition { _ -> next(checker, arguments, 0) }
    machine next(checker: &mut Checker, arguments: &ArgumentValues, offset: u64 in Trapping) {
        transition offset < arguments.count && offset < 64 {
            true -> install(checker, arguments, offset)
            _ -> {}
        }
    }
    machine install(checker: &mut Checker, arguments: &ArgumentValues, offset: u64 in Trapping)
    requires offset < 64
    {
        checker.arguments[offset] = arguments.values[offset];
        transition { _ -> next(checker, arguments, offset + 1) }
    }
}
