use psi::checking::aliases;
use psi::checking::checker;
use psi::checking::evaluation;
use psi::checking::flow;
use psi::checking::qualification;
use psi::checking::zone;
use psi::checks::checks;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// Value-position matches inside an evaluated tree
// (wiki/spec/language/patterns.md). A match evaluates its subject once; each
// arm then runs on the facts after the subject, assuming its own pattern
// selected and every earlier pattern passed over (`Checker::arm_facts`, as
// a transition's arms do); the facts after the match are the join of its
// arms' ends, and its value the hull of its arms' values. A tree evaluates
// in handle order, so a match's events fire as evaluation reaches them: as
// an arm begins (its pattern's first node, or its value's for `_`) and as
// its value begins, then at the match node itself. A match keeps two saved
// zones owned by its handle plus one: below, the join of the arms that have
// ended, unreached until the first does; above, the facts the next arm
// starts from. A match whose events the checker cannot track rejects as
// exceeding its capacity rather than letting its arms run on one another's
// facts.

// Record a match the tree's scan met, its first event pending.
pub machine Checker::add_match(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping)
crashes Trap
{
    transition checker.match_count < 16 {
        true -> write(checker, checker.match_count, handle)
        _ -> full(checker, syntax, handle)
    }

    state write(checker: &mut Checker, index: u64, handle: u64 in Trapping)
    requires index < 16
    {
        checker.matches[index] = handle as u64;
        checker.match_events[index] = 0;
        checker.match_count = index + 1;
    }

    state full(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, handle);
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }
}

// Fire every match event that begins at `handle`: an enclosing match's
// before a nested one's, whose handle is lower.
pub machine Checker::advance_matches(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    handle: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, handle, checker.match_count, checking) }

    state next(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        remaining: u64,
        checking: bool
    ) {
        transition remaining > 0 && remaining <= 16 {
            true -> record(checker, syntax, resolution, typing, handle, remaining - 1, checking)
            _ -> done()
        }
    }

    state record(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        index: u64,
        checking: bool
    )
    requires index < 16
    {
        let match_handle: u64 = checker.matches[index];
        let event: u64 = checker.match_events[index];
        Checker::fire_events(checker, syntax, resolution, typing, handle, match_handle as u64 in Trapping, index, event as u64 in Trapping, checking);
        transition { _ -> next(checker, syntax, resolution, typing, handle, index, checking) }
    }

    state done() {}
}

// Fire the events of the match at `match_handle` that begin at `handle`,
// from `event`, and keep the next one pending.
machine Checker::fire_events(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    handle: u64 in Trapping,
    match_handle: u64 in Trapping,
    index: u64,
    event: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, match_handle);
    transition { _ -> pending(checker, syntax, resolution, typing, handle, match_handle, expression, index, event, checking) }

    state pending(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        match_handle: u64 in Trapping,
        expression: Expression,
        index: u64,
        event: u64 in Trapping,
        checking: bool
    ) {
        let begins: u64 in Trapping = Checker::event_handle(syntax, expression, event);
        transition begins == handle {
            true -> fire(checker, syntax, resolution, typing, handle, match_handle, expression, index, event, checking)
            _ -> keep(checker, index, event)
        }
    }

    state fire(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        match_handle: u64 in Trapping,
        expression: Expression,
        index: u64,
        event: u64 in Trapping,
        checking: bool
    ) {
        Checker::match_event(checker, syntax, resolution, typing, match_handle, expression, event, checking);
        transition { _ -> pending(checker, syntax, resolution, typing, handle, match_handle, expression, index, event + 1, checking) }
    }

    state keep(checker: &mut Checker, index: u64, event: u64 in Trapping) {
        transition index < 16 {
            true -> write(checker, index, event)
            _ -> done()
        }
    }

    state write(checker: &mut Checker, index: u64, event: u64 in Trapping)
    requires index < 16
    {
        checker.match_events[index] = event as u64;
    }

    state done() {}
}

// Where a match's event `event` begins: arm `event / 2`'s pattern for an
// even event (its value for `_`), the arm's value for an odd one. Past its
// arms, no node begins one.
machine Checker::event_handle(syntax: &SyntaxTrees, expression: Expression, event: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let offset: u64 in Trapping = event / 2;
    let valued: bool = event % 2 == 1;
    transition offset < expression.count {
        true -> arm(syntax, expression, offset, valued)
        _ -> at(18446744073709551615)
    }

    state arm(syntax: &SyntaxTrees, expression: Expression, offset: u64 in Trapping, valued: bool) -> u64 in Trapping {
        let arm: TransitionArm = SyntaxTrees::match_arm(syntax, expression.first + offset);
        let value: Expression = SyntaxTrees::expression(syntax, arm.target);
        transition valued || arm.kind == ArmPatternKind::Wildcard {
            true -> at(value.first_row)
            _ -> pattern(syntax, arm)
        }
    }

    state pattern(syntax: &SyntaxTrees, arm: TransitionArm) -> u64 in Trapping {
        let pattern: Expression = SyntaxTrees::expression(syntax, arm.pattern);
        transition { _ -> at(pattern.first_row) }
    }

    state at(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// One event of a match: its first arm saves the arms' join, unreached, and
// the facts after the subject; each later arm ends the one before and
// starts from those facts with the earlier pattern passed over; an arm's
// value begins with its own pattern selected.
machine Checker::match_event(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    match_handle: u64 in Trapping,
    expression: Expression,
    event: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let offset: u64 in Trapping = event / 2;
    let valued: bool = event % 2 == 1;
    let held: bool = Checker::holds_match(checker, match_handle);
    transition valued {
        true -> selected(checker, syntax, resolution, typing, expression, offset, held)
        _ -> begun(checker, syntax, resolution, typing, match_handle, expression, offset, held, checking)
    }

    state begun(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        match_handle: u64 in Trapping,
        expression: Expression,
        offset: u64 in Trapping,
        held: bool,
        checking: bool
    ) {
        transition offset == 0 {
            true -> opened(checker, match_handle, expression)
            _ -> following(checker, syntax, resolution, typing, match_handle, expression, offset, held, checking)
        }
    }

    state opened(checker: &mut Checker, match_handle: u64 in Trapping, expression: Expression) {
        let joined: bool = Checker::save_zone(checker, match_handle + 1);
        transition joined {
            true -> unreached(checker, match_handle, expression)
            _ -> overflow(checker, expression)
        }
    }

    state unreached(checker: &mut Checker, match_handle: u64 in Trapping, expression: Expression) {
        Checker::unreach_saved(checker);
        let saved: bool = Checker::save_zone(checker, match_handle + 1);
        transition saved {
            true -> done()
            _ -> half_saved(checker, expression)
        }
    }

    // Only the join was saved: drop it, so no later arm or join meets it.
    state half_saved(checker: &mut Checker, expression: Expression) {
        Checker::drop_saved(checker);
        transition { _ -> overflow(checker, expression) }
    }

    state following(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        match_handle: u64 in Trapping,
        expression: Expression,
        offset: u64 in Trapping,
        held: bool,
        checking: bool
    ) {
        transition held {
            true -> passed_over(checker, syntax, resolution, typing, match_handle, expression, offset - 1, checking)
            _ -> done()
        }
    }

    state passed_over(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        match_handle: u64 in Trapping,
        expression: Expression,
        previous: u64 in Trapping,
        checking: bool
    ) {
        Checker::end_arm(checker, syntax, resolution, typing, match_handle, expression, previous, checking);
        Checker::restore_zone(checker);
        let arm: TransitionArm = SyntaxTrees::match_arm(syntax, expression.first + previous);
        let pattern: Value = Checker::pattern_value(checker, arm);
        Checker::arm_facts(checker, syntax, resolution, typing, expression.left, pattern, arm, false);
        Checker::resave_zone(checker);
    }

    state selected(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression, offset: u64 in Trapping, held: bool) {
        transition held {
            true -> chosen(checker, syntax, resolution, typing, expression, offset)
            _ -> done()
        }
    }

    state chosen(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression, offset: u64 in Trapping) {
        let arm: TransitionArm = SyntaxTrees::match_arm(syntax, expression.first + offset);
        let pattern: Value = Checker::pattern_value(checker, arm);
        Checker::arm_facts(checker, syntax, resolution, typing, expression.left, pattern, arm, true);
    }

    state overflow(checker: &mut Checker, expression: Expression) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }

    state done() {}
}

// A pattern's value, already evaluated; unknown for `_`.
machine Checker::pattern_value(checker: &Checker, arm: TransitionArm) -> Value
crashes Trap
{
    transition arm.kind == ArmPatternKind::Literal || arm.kind == ArmPatternKind::Case {
        true -> literal(checker, arm)
        _ -> unknown()
    }

    state literal(checker: &Checker, arm: TransitionArm) -> Value {
        let value: Value = Checker::value_at(checker, arm.pattern);
        value
    }

    state unknown() -> Value {
        let value: Value = Value::unknown();
        value
    }
}

// The match node: its last arm ends, the facts after it are its arms'
// join, and its value is already their hull. A match the checker could not
// track has already been rejected; its value is its type's.
pub machine Checker::close_match(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, checking: bool)
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, handle);
    let held: bool = Checker::holds_match(checker, handle);
    transition held {
        true -> closed(checker, syntax, resolution, typing, handle, expression, checking)
        _ -> untracked(checker, typing, handle)
    }

    state closed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, checking: bool) {
        Checker::end_arm(checker, syntax, resolution, typing, handle, expression, expression.count - 1, checking);
        Checker::take_join(checker);
    }

    state untracked(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping) {
        let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
        let row: TypeRow = TypeTable::row(&typing.types, type_handle);
        let value: Value = Value::typed(row);
        Checker::set_value(checker, handle, value);
    }
}

// An arm's value ends: a value landed at a qualified match type meets the
// qualification, its facts join the arms that have ended, and its interval
// widens the match's value.
machine Checker::end_arm(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    match_handle: u64 in Trapping,
    expression: Expression,
    offset: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let arm: TransitionArm = SyntaxTrees::match_arm(syntax, expression.first + offset);
    let value: Value = Checker::value_at(checker, arm.target);
    transition checking {
        true -> qualified(checker, syntax, resolution, typing, match_handle, offset, arm, value)
        _ -> joined(checker, match_handle, offset, value)
    }

    state qualified(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        match_handle: u64 in Trapping,
        offset: u64 in Trapping,
        arm: TransitionArm,
        value: Value
    ) {
        let match_type: u64 in Trapping = Typing::expression_type(typing, match_handle);
        let written: Expression = SyntaxTrees::expression(syntax, arm.target);
        Checker::require_qualification(checker, syntax, resolution, typing, match_type, arm.target, value, written.source_span);
        transition { _ -> joined(checker, match_handle, offset, value) }
    }

    state joined(checker: &mut Checker, match_handle: u64 in Trapping, offset: u64 in Trapping, value: Value) {
        Checker::join_arms(checker);
        transition offset == 0 {
            true -> first(checker, match_handle, value)
            _ -> widened(checker, match_handle, value)
        }
    }

    state first(checker: &mut Checker, match_handle: u64 in Trapping, value: Value) {
        let interval: Value = Value::interval(value);
        Checker::set_value(checker, match_handle, interval);
    }

    state widened(checker: &mut Checker, match_handle: u64 in Trapping, value: Value) {
        let so_far: Value = Checker::value_at(checker, match_handle);
        let hull: Value = Value::hull(so_far, value);
        Checker::set_value(checker, match_handle, hull);
    }
}

// Whether the two top saved zones are the match's.
machine Checker::holds_match(checker: &Checker, match_handle: u64 in Trapping) -> bool
crashes Trap
{
    transition checker.saved_count >= 2 && checker.saved_count <= 8 {
        true -> owners(checker, match_handle, checker.saved_count - 2)
        _ -> answer(false)
    }

    state owners(checker: &Checker, match_handle: u64 in Trapping, below: u64) -> bool
    requires below < 7
    {
        let join: u64 = checker.saved_owners[below];
        let start: u64 = checker.saved_owners[below + 1];
        let held: bool = join == match_handle + 1 && start == match_handle + 1;
        transition { _ -> answer(held) }
    }

    state answer(held: bool) -> bool {
        held
    }
}

// Mark the top saved zone unreached: the join of no arms.
machine Checker::unreach_saved(checker: &mut Checker)
crashes Trap
{
    transition checker.saved_count > 0 && checker.saved_count <= 8 {
        true -> mark(checker, checker.saved_count - 1)
        _ -> invalid()
    }

    state mark(checker: &mut Checker, index: u64)
    requires index < 8
    {
        checker.merged = checker.saved[index];
        checker.merged.infeasible = true;
        checker.saved[index] = checker.merged;
    }

    state invalid() {
        crash Trap;
    }
}

// Join the zone into the match's arms so far, the saved zone below the top.
machine Checker::join_arms(checker: &mut Checker)
crashes Trap
{
    transition checker.saved_count >= 2 && checker.saved_count <= 8 {
        true -> join(checker, checker.saved_count - 2)
        _ -> invalid()
    }

    state join(checker: &mut Checker, index: u64)
    requires index < 8
    {
        checker.merged = checker.saved[index];
        let current_live: bool = !checker.merged.infeasible;
        let other_live: bool = !checker.zone.infeasible;
        let mut aliases: AliasTable = checker.saved_aliases[index];
        let other: AliasTable = checker.aliases;
        AliasTable::join(&mut aliases, &other, current_live, other_live);
        checker.saved_aliases[index] = aliases;
        let changed: bool = Zone::join(&mut checker.merged, &checker.zone);
        checker.saved[index] = checker.merged;
    }

    state invalid() {
        crash Trap;
    }
}

// The facts after the match: its arms' join, both its saved zones dropped.
machine Checker::take_join(checker: &mut Checker)
crashes Trap
{
    transition checker.saved_count >= 2 && checker.saved_count <= 8 {
        true -> take(checker, checker.saved_count - 2)
        _ -> invalid()
    }

    state take(checker: &mut Checker, index: u64)
    requires index < 8
    {
        checker.zone = checker.saved[index];
        checker.aliases = checker.saved_aliases[index];
        checker.saved_count = index;
    }

    state invalid() {
        crash Trap;
    }
}
