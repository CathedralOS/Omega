use psi::checking::checker;
use psi::checking::evaluation;
use psi::checking::zone;
use psi::checks::checks;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// Fixed-integer operators and conversions
// (wiki/spec/language/numeric_values.md). An operation's policy is its
// result type's qualifier: an unqualified (Exact) result must fit its
// carrier, Wrapping and Saturating results are total, and a Trapping
// operation that may leave its carrier is a `Trap` crash site
// (#overflow-policies). A divisor is nonzero under every policy but
// Trapping, where zero is the trap (#integer-quotient-and-remainder); a
// shift count lies below the width unless Wrapping reduces it or Trapping
// traps (#shift-counts).

// The value of a binary operator whose result is a fixed integer.
pub machine Checker::binary_value(checker: &mut Checker, expression: Expression, row: TypeRow, checking: bool) -> Value
crashes Trap
{
    let left: Value = Checker::value_at(checker, expression.left);
    let right: Value = Checker::value_at(checker, expression.right);
    transition expression.operator {
        OperatorKind::Add -> add(checker, expression, row, left, right, checking)
        OperatorKind::Subtract -> subtract(checker, expression, row, left, right, checking)
        OperatorKind::Multiply -> multiply(checker, expression, row, left, right, checking)
        OperatorKind::Divide -> divide(checker, expression, row, left, right, checking)
        OperatorKind::Modulo -> modulo(checker, expression, row, left, right, checking)
        OperatorKind::BitAnd -> bitwise(row, left, right)
        OperatorKind::ShiftLeft -> shift(checker, expression, row, left, right, false, checking)
        OperatorKind::ShiftRight -> shift(checker, expression, row, left, right, true, checking)
        _ -> carrier(row)
    }

    state add(checker: &mut Checker, expression: Expression, row: TypeRow, left: Value, right: Value, checking: bool) -> Value {
        let interval: Value = Value::sum(left, right);
        let linear: Value = Value::offset_sum(left, right, interval);
        let result: Value = Checker::policy_result(checker, expression, row, linear, CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    // A difference also uses the zone's relation between its operands.
    state subtract(checker: &mut Checker, expression: Expression, row: TypeRow, left: Value, right: Value, checking: bool) -> Value {
        let interval: Value = Value::difference(left, right);
        let above: Bound = Checker::difference_bound(checker, right, left);
        let below: Bound = Checker::difference_bound(checker, left, right);
        let ceiling_tighter: bool = Bound::at_most(above, interval.ceiling);
        let floor_tighter: bool = Bound::at_most(below, interval.floor);
        let ceiling: Bound = Value::pick(ceiling_tighter, above, interval.ceiling);
        let floor: Bound = Value::pick(floor_tighter, below, interval.floor);
        let related: Value = Value { place: 0, known: false, subject: 0, offset: interval.offset, ceiling: ceiling, floor: floor };
        let linear: Value = Value::offset_difference(left, right, related);
        let result: Value = Checker::policy_result(checker, expression, row, linear, CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    state multiply(checker: &mut Checker, expression: Expression, row: TypeRow, left: Value, right: Value, checking: bool) -> Value {
        let interval: Value = Value::product(left, right);
        let result: Value = Checker::policy_result(checker, expression, row, interval, CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    state divide(checker: &mut Checker, expression: Expression, row: TypeRow, left: Value, right: Value, checking: bool) -> Value {
        let interval: Value = Value::quotient(left, right);
        Checker::require_divisor(checker, expression, row, right, checking);
        let result: Value = Checker::policy_result(checker, expression, row, interval, CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    state modulo(checker: &mut Checker, expression: Expression, row: TypeRow, left: Value, right: Value, checking: bool) -> Value {
        let interval: Value = Value::remainder(left, right);
        Checker::require_divisor(checker, expression, row, right, checking);
        let result: Value = Checker::policy_result(checker, expression, row, interval, CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    // A bitwise AND of nonnegative values stays below either operand; other
    // bitwise operators are total over the carrier.
    state bitwise(row: TypeRow, left: Value, right: Value) -> Value {
        let interval: Value = Value::conjunction(left, right);
        let clamped: Value = Value::clamped(interval, row.builtin);
        clamped
    }

    state shift(checker: &mut Checker, expression: Expression, row: TypeRow, left: Value, right: Value, rightward: bool, checking: bool) -> Value {
        Checker::require_shift_count(checker, expression, row, right, checking);
        transition rightward {
            true -> shifted_right(checker, expression, row, left, right, checking)
            _ -> shifted_left(checker, expression, row, checking)
        }
    }

    // A right shift stays below its operand.
    state shifted_right(checker: &mut Checker, expression: Expression, row: TypeRow, left: Value, right: Value, checking: bool) -> Value {
        let narrowed: Value = Value::shifted_right(left, right);
        let result: Value = Checker::policy_result(checker, expression, row, narrowed, CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    // A left shift is bounded only by its carrier: an Exact one would need a
    // proof this slice does not make.
    state shifted_left(checker: &mut Checker, expression: Expression, row: TypeRow, checking: bool) -> Value {
        let unknown: Value = Value::unknown();
        let result: Value = Checker::policy_result(checker, expression, row, unknown, CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    state carrier(row: TypeRow) -> Value {
        let range: Value = Value::carrier(row.builtin);
        range
    }
}

// The value of a negation whose result is a fixed integer.
pub machine Checker::negation_value(checker: &mut Checker, expression: Expression, row: TypeRow, checking: bool) -> Value
crashes Trap
{
    let operand: Value = Checker::value_at(checker, expression.left);
    let constant: bool = Value::is_constant(operand);
    transition constant {
        true -> folded(operand)
        _ -> negated(checker, expression, row, operand, checking)
    }

    state folded(operand: Value) -> Value {
        let negated: ExactInteger = ExactInteger::negate(operand.offset);
        let value: Value = Value::constant(negated);
        value
    }

    state negated(checker: &mut Checker, expression: Expression, row: TypeRow, operand: Value, checking: bool) -> Value {
        let interval: Value = Value::negation(operand);
        let result: Value = Checker::policy_result(checker, expression, row, interval, CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }
}

// `value as Target` for a fixed-integer target never changes the denoted
// value (wiki/spec/language/domains.md#exact-coercion-and-erasure): there is
// no hidden wrapping, saturation or trapping in `as`, whatever the target's
// policy, which governs only the target's later operations. The value must
// fit the target carrier, and keeps its term. A Boolean converts to zero or
// one.
pub machine Checker::conversion_value(checker: &mut Checker, typing: &Typing, expression: Expression, row: TypeRow, checking: bool) -> Value
crashes Trap
{
    let source: Value = Checker::value_at(checker, expression.left);
    let source_type: u64 in Trapping = Typing::expression_type(typing, expression.left);
    let read_source: u64 in Trapping = Checker::read_type(typing, source_type);
    let source_row: TypeRow = TypeTable::row(&typing.types, read_source);
    transition source_row.kind == TypeKind::Builtin && source_row.builtin == BuiltinType::Bool {
        true -> boolean()
        _ -> converted(checker, expression, row, source, checking)
    }

    state boolean() -> Value {
        let zero: Value = Value::constant(ExactInteger { negative: false, magnitude: 0 });
        let one: Value = Value::constant(ExactInteger { negative: false, magnitude: 1 });
        Value { place: 0, known: false, subject: 0, offset: zero.offset, ceiling: one.ceiling, floor: zero.floor }
    }

    state converted(checker: &mut Checker, expression: Expression, row: TypeRow, source: Value, checking: bool) -> Value {
        let fits: bool = Value::within(source, row.builtin);
        let kept: Value = Value { place: 0, known: source.known, subject: source.subject, offset: source.offset, ceiling: source.ceiling, floor: source.floor };
        transition fits || !checking {
            true -> exact(kept, row, fits)
            _ -> rejected(checker, expression, row)
        }
    }

    state exact(kept: Value, row: TypeRow, fits: bool) -> Value {
        transition fits {
            true -> preserved(kept)
            _ -> carrier(row)
        }
    }

    state preserved(kept: Value) -> Value {
        kept
    }

    state rejected(checker: &mut Checker, expression: Expression, row: TypeRow) -> Value {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::ConversionOutOfRange, expression.source_span);
        transition { _ -> carrier(row) }
    }

    state carrier(row: TypeRow) -> Value {
        let range: Value = Value::carrier(row.builtin);
        range
    }
}

// The policy of a fixed-integer result: an Exact result must fit (else
// `code` rejects when checking), a Trapping one that may not is a crash
// site, Wrapping keeps the result only when it cannot wrap, and Saturating
// clamps. A term survives only where the result is the mathematical one.
pub machine Checker::policy_result(checker: &mut Checker, expression: Expression, row: TypeRow, result: Value, code: CheckDiagnosticCode, checking: bool) -> Value
crashes Trap
{
    let fits: bool = Value::within(result, row.builtin);
    transition fits || checker.exact_body {
        true -> exact(result)
        _ -> overflow(checker, expression, row, result, code, checking)
    }

    state exact(result: Value) -> Value {
        result
    }

    state overflow(checker: &mut Checker, expression: Expression, row: TypeRow, result: Value, code: CheckDiagnosticCode, checking: bool) -> Value {
        transition row.domain {
            DomainBinding::Trapping -> trapping(checker, row, result)
            DomainBinding::Wrapping -> wrapped(row, result)
            DomainBinding::Saturating -> saturated(row, result)
            _ -> unproven(checker, expression, row, code, checking)
        }
    }

    state trapping(checker: &mut Checker, row: TypeRow, result: Value) -> Value {
        checker.trap_route = true;
        let clamped: Value = Value::clamped(result, row.builtin);
        clamped
    }

    // A constant wraps or saturates exactly; any other wrapped value may be
    // anywhere in its carrier.
    state wrapped(row: TypeRow, result: Value) -> Value {
        let constant: bool = Value::is_constant(result);
        transition constant {
            true -> wrapped_constant(row, result)
            _ -> carrier(row)
        }
    }

    state wrapped_constant(row: TypeRow, result: Value) -> Value {
        let wrapped: ExactInteger = ExactInteger::wrap(row.builtin, result.offset);
        let value: Value = Value::constant(wrapped);
        value
    }

    state carrier(row: TypeRow) -> Value {
        let range: Value = Value::carrier(row.builtin);
        range
    }

    state saturated(row: TypeRow, result: Value) -> Value {
        let constant: bool = Value::is_constant(result);
        transition constant {
            true -> saturated_constant(row, result)
            _ -> saturated_range(row, result)
        }
    }

    state saturated_constant(row: TypeRow, result: Value) -> Value {
        let saturated: ExactInteger = ExactInteger::saturate(row.builtin, result.offset);
        let value: Value = Value::constant(saturated);
        value
    }

    state saturated_range(row: TypeRow, result: Value) -> Value {
        let clamped: Value = Value::clamped(result, row.builtin);
        let unknown: Value = Value::unknown();
        Value { place: 0, known: false, subject: 0, offset: unknown.offset, ceiling: clamped.ceiling, floor: clamped.floor }
    }

    state unproven(checker: &mut Checker, expression: Expression, row: TypeRow, code: CheckDiagnosticCode, checking: bool) -> Value {
        transition checking {
            true -> rejected(checker, expression, row, code)
            _ -> carrier(row)
        }
    }

    state rejected(checker: &mut Checker, expression: Expression, row: TypeRow, code: CheckDiagnosticCode) -> Value {
        Checks::reject(&mut checker.output, code, expression.source_span);
        let range: Value = Value::carrier(row.builtin);
        range
    }
}

// A zero divisor is undefined under every policy but Trapping, where it is
// the trap.
pub machine Checker::require_divisor(checker: &mut Checker, expression: Expression, row: TypeRow, divisor: Value, checking: bool)
crashes Trap
{
    let nonzero: bool = Checker::proves_nonzero(checker, divisor);
    transition nonzero {
        true -> done()
        _ -> zero(checker, expression, row, checking)
    }

    state zero(checker: &mut Checker, expression: Expression, row: TypeRow, checking: bool) {
        transition row.domain == DomainBinding::Trapping {
            true -> trapped(checker)
            _ -> undefined(checker, expression, checking)
        }
    }

    state trapped(checker: &mut Checker) {
        checker.trap_route = true;
    }

    state undefined(checker: &mut Checker, expression: Expression, checking: bool) {
        transition checking {
            true -> rejected(checker, expression)
            _ -> done()
        }
    }

    state rejected(checker: &mut Checker, expression: Expression) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::DivisorMayBeZero, expression.source_span);
    }

    state done() {}
}

// A shift count outside `0..width` is undefined unless Wrapping reduces it,
// and the trap under Trapping.
pub machine Checker::require_shift_count(checker: &mut Checker, expression: Expression, row: TypeRow, count: Value, checking: bool)
crashes Trap
{
    let width: u64 in Trapping = Checker::width(row.builtin);
    let magnitude: u64 in Wrapping = width as u64 in Wrapping;
    let bits: Value = Value::constant(ExactInteger { negative: false, magnitude: magnitude });
    let zero: Value = Value::constant(ExactInteger { negative: false, magnitude: 0 });
    let below: bool = Checker::proves_less(checker, count, bits);
    let above: bool = Checker::proves_at_most(checker, zero, count);
    transition (below && above) || row.domain == DomainBinding::Wrapping {
        true -> done()
        _ -> outside(checker, expression, row, checking)
    }

    state outside(checker: &mut Checker, expression: Expression, row: TypeRow, checking: bool) {
        transition row.domain == DomainBinding::Trapping {
            true -> trapped(checker)
            _ -> undefined(checker, expression, checking)
        }
    }

    state trapped(checker: &mut Checker) {
        checker.trap_route = true;
    }

    state undefined(checker: &mut Checker, expression: Expression, checking: bool) {
        transition checking {
            true -> rejected(checker, expression)
            _ -> done()
        }
    }

    state rejected(checker: &mut Checker, expression: Expression) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::ShiftCountOutOfRange, expression.source_span);
    }

    state done() {}
}

// The bit width of a fixed-integer carrier.
pub machine Checker::width(builtin: BuiltinType) -> u64 in Trapping {
    transition builtin {
        BuiltinType::I8 -> bits(8)
        BuiltinType::U8 -> bits(8)
        BuiltinType::I16 -> bits(16)
        BuiltinType::U16 -> bits(16)
        BuiltinType::I32 -> bits(32)
        BuiltinType::U32 -> bits(32)
        _ -> bits(64)
    }

    state bits(count: u64 in Trapping) -> u64 in Trapping {
        count
    }
}
