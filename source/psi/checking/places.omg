use psi::checking::aliases;
use psi::checking::arrivals;
use psi::checking::checker;
use psi::checking::constructions;
use psi::checking::contracts;
use psi::checking::domains;
use psi::checking::evaluation;
use psi::checking::facts;
use psi::checking::obligations;
use psi::checking::references;
use psi::checking::zone;
use psi::checks::checks;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// The places a body names and the integer and Boolean subjects among them. A place is a
// parameter, a local, a case-pattern binder, a call's result, a
// construction, an operand's snapshot, or a field or slice length of
// another place; equal paths are one place. An integer place is a subject of
// the body's zone, entered with its carrier's range: a fixed integer's value
// always lies in its carrier, whatever its policy
// (wiki/spec/language/numeric_values.md#integer-equality-and-order). Facts
// about a place hold until a write to it or to a place containing it.
pub data PlaceKind [copy] {
    case Parameter;
    case Local;
    case Binder;
    case Field;
    case Length;
    // The scalar contents of a reference parameter, below its storage root.
    case Referent;
    // A call's result, by the call's expression handle: the value its
    // callee's `ensures` facts describe.
    case Call;
    // A construction's value, by its expression handle, its fields pending
    // below it (constructions.omg).
    case Construction;
    // What an operand read before a later operand wrote it, by the lending
    // operand's handle under the place read (snapshots.omg).
    case Snapshot;
}

pub data Place [copy] {
    kind: PlaceKind;
    // The parameter, `let` statement, pattern field or data field handle.
    handle: u64 in Trapping;
    // The containing place of a field or length.
    parent: u64 in Trapping;
    type_handle: u64 in Trapping;
    // The zone subject of an integer place; zero for any other.
    subject: u64 in Trapping;
}

pub machine Checker::place_at(checker: &Checker, index: u64 in Trapping) -> Place
crashes Trap
{
    transition index < checker.place_count && index < 256 {
        true -> read(checker, index)
        _ -> invalid()
    }

    state read(checker: &Checker, index: u64 in Trapping) -> Place
    requires index < 256
    {
        checker.places[index]
    }

    state invalid() -> Place {
        crash Trap;
    }
}

// The carrier of an interned type's subject: a fixed integer's, `Bool` for
// a Boolean, whose subject is 1 when true and 0 when false, or `Never` when
// the type has no subject.
pub machine Checker::carrier(typing: &Typing, type_handle: u64 in Trapping) -> BuiltinType
crashes Trap
{
    let row: TypeRow = TypeTable::row(&typing.types, type_handle);
    let integer: bool = ExactInteger::is_carrier(row.builtin);
    transition row.kind == TypeKind::Builtin && (integer || row.builtin == BuiltinType::Bool) {
        true -> found(row.builtin)
        _ -> none()
    }

    state found(builtin: BuiltinType) -> BuiltinType {
        builtin
    }

    state none() -> BuiltinType {
        BuiltinType::Never
    }
}

// Whether a place of this carrier is a subject: a fixed integer or a
// Boolean.
pub machine Checker::has_subject(carrier: BuiltinType) -> bool {
    ExactInteger::is_carrier(carrier) || carrier == BuiltinType::Bool
}

// Clear the body's places and open its zone over the zero subject alone.
pub machine Checker::open_places(checker: &mut Checker)
crashes Trap
{
    checker.place_count = 0;
    checker.subject_count = 1;
    checker.domains_pending = false;
    checker.alias_count = 0;
    checker.pending_count = 0;
    Checker::clear_reference_origins(checker);
    Zone::open(&mut checker.zone, 64);
}

// The place `kind`/`handle` under `parent`, entered on first use. Zero when
// the tables are full, which rejects the body.
pub machine Checker::place(
    checker: &mut Checker,
    typing: &Typing,
    kind: PlaceKind,
    handle: u64 in Trapping,
    parent: u64 in Trapping,
    type_handle: u64 in Trapping
) -> u64 in Trapping
crashes Trap
{
    transition { _ -> search(checker, typing, kind, handle, parent, type_handle, 0) }

    state search(
        checker: &mut Checker,
        typing: &Typing,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        index: u64 in Trapping
    ) -> u64 in Trapping {
        transition index < checker.place_count {
            true -> compare(checker, typing, kind, handle, parent, type_handle, index)
            _ -> enter(checker, typing, kind, handle, parent, type_handle)
        }
    }

    state compare(
        checker: &mut Checker,
        typing: &Typing,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        index: u64 in Trapping
    ) -> u64 in Trapping {
        let place: Place = Checker::place_at(checker, index);
        let same: bool = Checker::same_place(place, kind, handle, parent);
        transition same {
            true -> found(index)
            _ -> search(checker, typing, kind, handle, parent, type_handle, index + 1)
        }
    }

    state found(index: u64 in Trapping) -> u64 in Trapping {
        index + 1
    }

    state enter(
        checker: &mut Checker,
        typing: &Typing,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping
    ) -> u64 in Trapping {
        let carrier: BuiltinType = Checker::place_carrier(typing, kind, type_handle);
        let integer: bool = Checker::has_subject(carrier);
        transition checker.place_count < 256 {
            true -> room(checker, kind, handle, parent, type_handle, carrier, integer)
            _ -> full(checker)
        }
    }

    state room(
        checker: &mut Checker,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        carrier: BuiltinType,
        integer: bool
    ) -> u64 in Trapping {
        transition integer {
            true -> subject(checker, kind, handle, parent, type_handle, carrier)
            _ -> plain(checker, kind, handle, parent, type_handle)
        }
    }

    state plain(
        checker: &mut Checker,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping
    ) -> u64 in Trapping {
        let place: Place = Place { kind: kind, handle: handle, parent: parent, type_handle: type_handle, subject: 0 };
        transition { _ -> stored(checker, place) }
    }

    state subject(
        checker: &mut Checker,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        carrier: BuiltinType
    ) -> u64 in Trapping {
        let subject: u64 in Trapping = checker.subject_count as u64 in Trapping;
        transition subject < 64 {
            true -> numbered(checker, kind, handle, parent, type_handle, carrier, subject)
            _ -> full(checker)
        }
    }

    state numbered(
        checker: &mut Checker,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        carrier: BuiltinType,
        subject: u64 in Trapping
    ) -> u64 in Trapping {
        let next: u64 in Trapping = subject + 1;
        checker.subject_count = next as u64;
        Checker::enter_range(checker, subject, carrier);
        let place: Place = Place { kind: kind, handle: handle, parent: parent, type_handle: type_handle, subject: subject };
        transition { _ -> stored(checker, place) }
    }

    state stored(checker: &mut Checker, place: Place) -> u64 in Trapping {
        let index: u64 = checker.place_count;
        Checker::store_place(checker, index, place);
        let position: u64 in Trapping = index as u64 in Trapping;
        let next: u64 in Trapping = position + 1;
        checker.place_count = next as u64;
        Checker::set_domain_mark(checker, position, DomainMark::Unseen);
        transition place.kind == PlaceKind::Field {
            true -> field(checker, place, position, next)
            _ -> entered(next)
        }
    }

    // A field a construction wrote there holds its value.
    state field(checker: &mut Checker, place: Place, position: u64 in Trapping, next: u64 in Trapping) -> u64 in Trapping {
        Checker::note_field(checker, position);
        Checker::take_pending(checker, place);
        next
    }

    state entered(next: u64 in Trapping) -> u64 in Trapping {
        next
    }

    // A full table loses the place; the body rejects once it ends.
    state full(checker: &mut Checker) -> u64 in Trapping {
        checker.overflowed = true;
        0
    }
}

// A place's carrier: a slice length's is `u64`, any other place's its type's.
pub machine Checker::place_carrier(typing: &Typing, kind: PlaceKind, type_handle: u64 in Trapping) -> BuiltinType
crashes Trap
{
    transition kind == PlaceKind::Length {
        true -> length()
        _ -> typed(typing, type_handle)
    }

    state length() -> BuiltinType {
        BuiltinType::U64
    }

    state typed(typing: &Typing, type_handle: u64 in Trapping) -> BuiltinType {
        let carrier: BuiltinType = Checker::carrier(typing, type_handle);
        carrier
    }
}

// The place `kind`/`handle` under `parent` (one-based), or zero when the
// body has not entered it.
pub machine Checker::find_place(checker: &Checker, kind: PlaceKind, handle: u64 in Trapping, parent: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> search(checker, kind, handle, parent, 0) }

    state search(checker: &Checker, kind: PlaceKind, handle: u64 in Trapping, parent: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        transition index < checker.place_count {
            true -> compare(checker, kind, handle, parent, index)
            _ -> absent()
        }
    }

    state compare(checker: &Checker, kind: PlaceKind, handle: u64 in Trapping, parent: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        let place: Place = Checker::place_at(checker, index);
        let same: bool = Checker::same_place(place, kind, handle, parent);
        transition same {
            true -> found(index + 1)
            _ -> search(checker, kind, handle, parent, index + 1)
        }
    }

    state found(place: u64 in Trapping) -> u64 in Trapping {
        place
    }

    state absent() -> u64 in Trapping {
        0
    }
}

machine Checker::same_place(place: Place, kind: PlaceKind, handle: u64 in Trapping, parent: u64 in Trapping) -> bool {
    place.kind == kind && place.handle == handle && place.parent == parent
}

machine Checker::store_place(checker: &mut Checker, index: u64, place: Place)
crashes Trap
{
    transition index < 256 {
        true -> write(checker, index, place)
        _ -> invalid()
    }

    state write(checker: &mut Checker, index: u64, place: Place) {
        checker.places[index] = place;
    }

    state invalid() {
        crash Trap;
    }
}

// A new subject's value lies in its carrier's range.
pub machine Checker::enter_range(checker: &mut Checker, subject: u64 in Trapping, carrier: BuiltinType)
crashes Trap
{
    let least: ExactInteger = ExactInteger::minimum(carrier);
    let greatest: ExactInteger = ExactInteger::maximum(carrier);
    let floor: ExactInteger = ExactInteger::negate(least);
    let upper: Bound = Bound::exactly(greatest);
    let lower: Bound = Bound::exactly(floor);
    Zone::constrain(&mut checker.zone, 0, subject, upper);
    Zone::constrain(&mut checker.zone, subject, 0, lower);
    transition { _ -> saved(checker, subject, upper, lower, 0) }

    // The range is a fact of the place's type, so it holds on every path:
    // a zone saved before the place was entered (an open `&&`/`||` context
    // or transition) takes it too, or a later join would lose it.
    state saved(checker: &mut Checker, subject: u64 in Trapping, upper: Bound, lower: Bound, index: u64 in Trapping) {
        transition index < checker.saved_count && index < 8 {
            true -> ranged(checker, subject, upper, lower, index)
            _ -> done()
        }
    }

    state ranged(checker: &mut Checker, subject: u64 in Trapping, upper: Bound, lower: Bound, index: u64 in Trapping)
    requires index < 8
    {
        checker.merged = checker.saved[index];
        Zone::constrain(&mut checker.merged, 0, subject, upper);
        Zone::constrain(&mut checker.merged, subject, 0, lower);
        checker.saved[index] = checker.merged;
        transition { _ -> saved(checker, subject, upper, lower, index + 1) }
    }

    state done() {}
}

// Every subject place's carrier range, again. A state's arrival replaces the
// zone its places were entered in, and widening may have dropped a bound
// that only the carrier implied; the range holds on every arrival all the
// same.
pub machine Checker::restore_ranges(checker: &mut Checker, typing: &Typing)
crashes Trap
{
    transition { _ -> next(checker, typing, 0) }

    state next(checker: &mut Checker, typing: &Typing, index: u64 in Trapping) {
        transition index < checker.place_count {
            true -> visit(checker, typing, index)
            _ -> done()
        }
    }

    state visit(checker: &mut Checker, typing: &Typing, index: u64 in Trapping) {
        let candidate: Place = Checker::place_at(checker, index);
        transition candidate.subject > 0 {
            true -> ranged(checker, typing, index, candidate)
            _ -> next(checker, typing, index + 1)
        }
    }

    state ranged(checker: &mut Checker, typing: &Typing, index: u64 in Trapping, candidate: Place) {
        let carrier: BuiltinType = Checker::place_carrier(typing, candidate.kind, candidate.type_handle);
        Checker::enter_range(checker, candidate.subject, carrier);
        transition { _ -> next(checker, typing, index + 1) }
    }

    state done() {}
}

// Forget every fact about `place` and the places it contains, as a write to
// it or an exclusive loan of it may change them all. The carrier ranges
// return with the subjects.
pub machine Checker::forget_place(checker: &mut Checker, typing: &Typing, place: u64 in Trapping)
crashes Trap
{
    Checker::forget_storage(checker, typing, place, false);
    Checker::forget_backing(checker, typing, place);
}

// A view (a range slice's place, a referent below its collection with the
// slice's node as its handle) shares its collection's storage: writing or
// lending it exclusively may change any of the collection's contents.
pub machine Checker::forget_backing(checker: &mut Checker, typing: &Typing, place: u64 in Trapping)
crashes Trap
{
    transition place > 0 && place <= 256 {
        true -> entered(checker, typing, place)
        _ -> done()
    }

    state entered(checker: &mut Checker, typing: &Typing, place: u64 in Trapping) {
        let entry: Place = Checker::place_at(checker, place - 1);
        transition entry.kind == PlaceKind::Referent && entry.handle > 0 && entry.parent > 0 {
            true -> backing(checker, typing, entry.parent)
            _ -> done()
        }
    }

    state backing(checker: &mut Checker, typing: &Typing, collection: u64 in Trapping) {
        Checker::forget_storage(checker, typing, collection, true);
    }

    state done() {}
}

// An element store changes collection contents, not the collection's own
// length. Nested lengths are still mutable contents: replacing an element
// may replace a slice inside it. Keep all other write bookkeeping shared.
pub machine Checker::forget_contents(checker: &mut Checker, typing: &Typing, place: u64 in Trapping)
crashes Trap
{
    Checker::forget_storage(checker, typing, place, true);
    Checker::forget_backing(checker, typing, place);
}

machine Checker::forget_storage(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, contents: bool)
crashes Trap
{
    Checker::forget_pending(checker, typing, place);
    Checker::forget_aliases(checker, place);
    transition { _ -> next(checker, typing, place, contents, 0) }

    state next(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, contents: bool, index: u64 in Trapping) {
        transition index < checker.place_count {
            true -> visit(checker, typing, place, contents, index)
            _ -> done(checker, place)
        }
    }

    state visit(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, contents: bool, index: u64 in Trapping) {
        let within: bool = Checker::within(checker, index + 1, place);
        let candidate: Place = Checker::place_at(checker, index);
        let length: bool = contents && candidate.kind == PlaceKind::Length && candidate.parent == place;
        transition within && candidate.subject > 0 && !length {
            true -> clear(checker, typing, place, contents, index, candidate)
            _ -> next(checker, typing, place, contents, index + 1)
        }
    }

    state clear(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, contents: bool, index: u64 in Trapping, candidate: Place) {
        let carrier: BuiltinType = Checker::place_carrier(typing, candidate.kind, candidate.type_handle);
        Zone::forget(&mut checker.zone, candidate.subject);
        Checker::enter_range(checker, candidate.subject, carrier);
        transition { _ -> next(checker, typing, place, contents, index + 1) }
    }

    state done(checker: &mut Checker, place: u64 in Trapping) {
        Checker::reopen_domains(checker, place);
    }
}

// The value (one-based place) whose invariant window storing `place` opens:
// the owner of a stored field when its data carries `where` facts, else
// zero.
pub machine Checker::window_owner(checker: &Checker, syntax: &SyntaxTrees, typing: &Typing, place: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition place > 0 {
        true -> stored(checker, syntax, typing, place)
        _ -> none()
    }

    state stored(checker: &Checker, syntax: &SyntaxTrees, typing: &Typing, place: u64 in Trapping) -> u64 in Trapping {
        let entry: Place = Checker::place_at(checker, place - 1);
        transition entry.kind == PlaceKind::Field && entry.parent > 0 {
            true -> parent(checker, syntax, typing, entry.parent)
            _ -> none()
        }
    }

    state parent(checker: &Checker, syntax: &SyntaxTrees, typing: &Typing, parent: u64 in Trapping) -> u64 in Trapping {
        let owner: Place = Checker::place_at(checker, parent - 1);
        let constrained: bool = Checker::constrained(syntax, typing, owner.type_handle);
        transition constrained {
            true -> found(parent)
            _ -> none()
        }
    }

    state found(parent: u64 in Trapping) -> u64 in Trapping {
        parent
    }

    state none() -> u64 in Trapping {
        0
    }
}

// Whether place `inner` (one-based) is `outer` (one-based) or lies within it.
pub machine Checker::within(checker: &Checker, inner: u64 in Trapping, outer: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> step(checker, inner, outer, 0) }

    state step(checker: &Checker, current: u64 in Trapping, outer: u64 in Trapping, depth: u64 in Trapping) -> bool {
        transition current == outer {
            true -> yes()
            _ -> climb(checker, current, outer, depth)
        }
    }

    state climb(checker: &Checker, current: u64 in Trapping, outer: u64 in Trapping, depth: u64 in Trapping) -> bool {
        transition current > 0 && depth < 256 {
            true -> parent(checker, current, outer, depth)
            _ -> no()
        }
    }

    state parent(checker: &Checker, current: u64 in Trapping, outer: u64 in Trapping, depth: u64 in Trapping) -> bool {
        let place: Place = Checker::place_at(checker, current - 1);
        transition place.kind == PlaceKind::Field || place.kind == PlaceKind::Length || place.kind == PlaceKind::Referent {
            true -> step(checker, place.parent, outer, depth + 1)
            _ -> no()
        }
    }

    state yes() -> bool {
        true
    }

    state no() -> bool {
        false
    }
}

// The value of a name: the place of a local, parameter or binder. A name
// binding a state, machine or data declaration is no place.
pub machine Checker::name_value(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    handle: u64 in Trapping,
    type_handle: u64 in Trapping
) -> Value
crashes Trap
{
    let binding: ValueBinding = NameResolution::value_binding(resolution, handle);
    transition binding {
        ValueBinding::Constant { constant } -> constant_value(syntax, typing, constant, type_handle)
        ValueBinding::Local { statement } -> rooted(checker, typing, PlaceKind::Local, statement, type_handle)
        ValueBinding::Parameter { parameter } -> parameter(checker, typing, parameter, type_handle)
        ValueBinding::PatternBinder { field } -> rooted(checker, typing, PlaceKind::Binder, field, type_handle)
        ValueBinding::Field { field } -> field_name(checker, typing, field, type_handle)
        ValueBinding::PayloadField { field } -> payload_name(checker, field)
        ValueBinding::ReturnedValue { machine } -> returned(checker)
        ValueBinding::DomainSubject { domain } -> subject(checker)
        _ -> unbounded()
    }

    state constant_value(syntax: &SyntaxTrees, typing: &Typing, constant: u64 in Trapping, type_handle: u64 in Trapping) -> Value {
        let value: Value = Checker::constant_value(syntax, typing, constant, type_handle);
        value
    }

    // A domain predicate's subject binder: the value it is decided for.
    state subject(checker: &Checker) -> Value {
        transition checker.subjecting {
            true -> subject_value(checker)
            _ -> unbounded()
        }
    }

    state subject_value(checker: &Checker) -> Value {
        let value: Value = checker.subject;
        value
    }

    // An `ensures` fact's `result`: the returned value it is decided for.
    state returned(checker: &Checker) -> Value {
        transition checker.returning {
            true -> returned_value(checker)
            _ -> unbounded()
        }
    }

    state returned_value(checker: &Checker) -> Value {
        let value: Value = checker.returned;
        value
    }

    // A `where` fact's field name: the value a construction writes there
    // while its facts are decided, else the field of `fields_parent` while
    // that value's domain is installed.
    state field_name(checker: &mut Checker, typing: &Typing, field: u64 in Trapping, type_handle: u64 in Trapping) -> Value {
        transition checker.field_values && field >= checker.field_first {
            true -> written(checker, field - checker.field_first)
            _ -> installed(checker, typing, field, type_handle)
        }
    }

    // A case fact's payload name: what the construction writes there, or the
    // arm's binder for it, while the case's facts are decided or assumed.
    state payload_name(checker: &Checker, field: u64 in Trapping) -> Value {
        transition checker.payload_values && field >= checker.payload_first {
            true -> written(checker, checker.payload_slot + (field - checker.payload_first))
            _ -> unbounded()
        }
    }

    // A construction's fact: the value written to the field.
    state written(checker: &Checker, offset: u64 in Trapping) -> Value {
        let value: Value = Checker::argument_value(checker, offset);
        value
    }

    state installed(checker: &mut Checker, typing: &Typing, field: u64 in Trapping, type_handle: u64 in Trapping) -> Value {
        transition checker.fields_parent > 0 {
            true -> member(checker, typing, field, checker.fields_parent, type_handle)
            _ -> unbounded()
        }
    }

    state member(checker: &mut Checker, typing: &Typing, field: u64 in Trapping, parent: u64 in Trapping, type_handle: u64 in Trapping) -> Value {
        let place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Field, field, parent, type_handle);
        let value: Value = Checker::reference_value(checker, typing, place);
        value
    }

    // While a target's `requires` or `ensures` facts are decided, its
    // parameters stand for the call's arguments.
    state parameter(checker: &mut Checker, typing: &Typing, parameter: u64 in Trapping, type_handle: u64 in Trapping) -> Value {
        let substituted: bool = checker.substituting
            && parameter >= checker.argument_first
            && parameter - checker.argument_first < checker.argument_count;
        transition substituted {
            true -> argument(checker, typing, parameter - checker.argument_first, type_handle)
            _ -> rooted(checker, typing, PlaceKind::Parameter, parameter, type_handle)
        }
    }

    // The argument slot holds what was passed; a reference parameter stands
    // for that argument's referent, as reading the parameter does, so a
    // fact about `index` with `index: &mut u64` binds to the lent storage.
    state argument(checker: &mut Checker, typing: &Typing, offset: u64 in Trapping, type_handle: u64 in Trapping) -> Value {
        let value: Value = Checker::argument_value(checker, offset);
        let row: TypeRow = TypeTable::row(&typing.types, type_handle);
        transition row.kind == TypeKind::Reference && value.place > 0 {
            true -> referent(checker, typing, value.place)
            _ -> passed(value)
        }
    }

    state referent(checker: &mut Checker, typing: &Typing, place: u64 in Trapping) -> Value {
        let value: Value = Checker::reference_value(checker, typing, place);
        value
    }

    state passed(value: Value) -> Value {
        value
    }

    state rooted(checker: &mut Checker, typing: &Typing, kind: PlaceKind, binding: u64 in Trapping, type_handle: u64 in Trapping) -> Value {
        let place: u64 in Trapping = Checker::place(checker, typing, kind, binding, 0, type_handle);
        let value: Value = Checker::reference_value(checker, typing, place);
        value
    }

    state unbounded() -> Value {
        let value: Value = Value::unknown();
        value
    }
}

// A constant's value: exact when its initializer is an anonymous integer
// tree landed at its fixed-integer type, else its type's range.
pub machine Checker::constant_value(syntax: &SyntaxTrees, typing: &Typing, constant: u64 in Trapping, type_handle: u64 in Trapping) -> Value
crashes Trap
{
    let declaration: ConstantItem = SyntaxTrees::constant_item(syntax, constant);
    let adaptation: Adaptation = Typing::adaptation(typing, declaration.value);
    let row: TypeRow = TypeTable::row(&typing.types, type_handle);
    let integer: bool = row.kind == TypeKind::Builtin && ExactInteger::is_carrier(row.builtin);
    transition adaptation == Adaptation::Landed && integer {
        true -> exact(typing, declaration)
        _ -> typed(row)
    }

    state exact(typing: &Typing, declaration: ConstantItem) -> Value {
        let landed: ExactInteger = Typing::value(typing, declaration.value);
        let value: Value = Value::constant(landed);
        value
    }

    state typed(row: TypeRow) -> Value {
        let value: Value = Value::typed(row);
        value
    }
}

// The value of `.field` or `.len`: a place below its operand's place, or,
// for a value that is no place (a call's result), its type's range. An
// array's length is its type's.
pub machine Checker::member_value(
    checker: &mut Checker,
    typing: &Typing,
    handle: u64 in Trapping,
    expression: Expression,
    type_handle: u64 in Trapping
) -> Value
crashes Trap
{
    let selection: Selection = Typing::selection(typing, handle);
    let base: Value = Checker::value_at(checker, expression.left);
    let row: TypeRow = TypeTable::row(&typing.types, type_handle);
    transition selection {
        Selection::Field { field } -> member(checker, typing, PlaceKind::Field, field, base.place, type_handle, row)
        Selection::Length -> length(checker, typing, expression, base.place, type_handle, row)
        _ -> unbounded()
    }

    // A fixed array's `.len` is its extent; a bounded byte array's is its
    // live length, a place below the array's.
    state length(checker: &mut Checker, typing: &Typing, expression: Expression, parent: u64 in Trapping, type_handle: u64 in Trapping, row: TypeRow) -> Value {
        let collection: TypeRow = Checker::collection_row(typing, expression.left);
        let bounded: bool = Checker::bounded_bytes(typing, collection);
        transition collection.kind == TypeKind::Array && !bounded {
            true -> fixed(typing, collection)
            _ -> member(checker, typing, PlaceKind::Length, 0, parent, type_handle, row)
        }
    }

    state fixed(typing: &Typing, collection: TypeRow) -> Value {
        let extent: Value = Checker::array_extent(typing, collection);
        extent
    }

    state member(
        checker: &mut Checker,
        typing: &Typing,
        kind: PlaceKind,
        binding: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        row: TypeRow
    ) -> Value {
        transition parent > 0 {
            true -> projected(checker, typing, kind, binding, parent, type_handle)
            _ -> carried(row)
        }
    }

    state projected(checker: &mut Checker, typing: &Typing, kind: PlaceKind, binding: u64 in Trapping, parent: u64 in Trapping, type_handle: u64 in Trapping) -> Value {
        let place: u64 in Trapping = Checker::place(checker, typing, kind, binding, parent, type_handle);
        let value: Value = Checker::reference_value(checker, typing, place);
        value
    }

    state carried(row: TypeRow) -> Value {
        let value: Value = Value::typed(row);
        value
    }

    state unbounded() -> Value {
        let value: Value = Value::unknown();
        value
    }
}

// A place's value: its subject's term and interval, or the place alone.
pub machine Checker::place_value(checker: &Checker, place: u64 in Trapping) -> Value
crashes Trap
{
    transition place > 0 {
        true -> entered(checker, place)
        _ -> unbounded()
    }

    state entered(checker: &Checker, place: u64 in Trapping) -> Value {
        let entry: Place = Checker::place_at(checker, place - 1);
        transition entry.subject > 0 {
            true -> term(checker, place, entry.subject)
            _ -> located(place)
        }
    }

    state term(checker: &Checker, place: u64 in Trapping, subject: u64 in Trapping) -> Value {
        let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
        let value: Value = Checker::term_value(checker, place, subject, zero);
        value
    }

    state located(place: u64 in Trapping) -> Value {
        let value: Value = Value::at_place(place);
        value
    }

    state unbounded() -> Value {
        let value: Value = Value::unknown();
        value
    }
}

// The place (one-based) whose subject is `subject`; zero when none is.
pub machine Checker::subject_place(checker: &Checker, subject: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition subject > 0 {
        true -> next(checker, subject, 0)
        _ -> absent()
    }

    state next(checker: &Checker, subject: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        transition index < checker.place_count {
            true -> candidate(checker, subject, index)
            _ -> absent()
        }
    }

    state candidate(checker: &Checker, subject: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        let place: Place = Checker::place_at(checker, index);
        transition place.subject == subject {
            true -> found(index + 1)
            _ -> next(checker, subject, index + 1)
        }
    }

    state found(place: u64 in Trapping) -> u64 in Trapping {
        place
    }

    state absent() -> u64 in Trapping {
        0
    }
}
// A record bound from another place takes that place's known paths: each
// subject place within `source` by at most four field or `.len` steps
// (arrivals.omg) equals the same path below `target` from here on, and
// each field pending below `source` is pending below `target` too. A
// slice bound from a view thus keeps the view's length.
pub machine Checker::copy_fields(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping)
crashes Trap
{
    Checker::copy_pending(checker, typing, target, source);
    let end: u64 in Trapping = checker.place_count as u64 in Trapping;
    transition target > 0 && source > 0 && target != source {
        true -> next(checker, typing, target, source, 0, end)
        _ -> done()
    }

    // Places the copy enters lie past `end`.
    state next(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping) {
        transition index < end && index < 256 {
            true -> candidate(checker, typing, target, source, index, end)
            _ -> done()
        }
    }

    state candidate(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping) {
        let entry: Place = Checker::place_at(checker, index);
        let path: ArrivalPath = Checker::path_below(checker, source, index + 1, 0);
        transition entry.subject > 0 && path.depth > 0 {
            true -> copied(checker, typing, target, source, index, end, entry.subject, path)
            _ -> next(checker, typing, target, source, index + 1, end)
        }
    }

    state copied(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, subject: u64 in Trapping, path: ArrivalPath) {
        let copy: u64 in Trapping = Checker::enter_path(checker, typing, target, path);
        transition copy > 0 {
            true -> equated(checker, typing, target, source, index, end, subject, copy)
            _ -> done()
        }
    }

    // copy - source <= 0 and source - copy <= 0.
    state equated(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, subject: u64 in Trapping, copy: u64 in Trapping) {
        let copied: Place = Checker::place_at(checker, copy - 1);
        let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
        let unknown: Value = Value::unknown();
        let original: Value = Value { place: 0, known: true, subject: subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        let duplicate: Value = Value { place: 0, known: true, subject: copied.subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        transition copied.subject > 0 {
            true -> related(checker, typing, target, source, index, end, original, duplicate)
            _ -> next(checker, typing, target, source, index + 1, end)
        }
    }

    state related(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, original: Value, duplicate: Value) {
        let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
        Checker::constrain_difference(checker, original, duplicate, zero);
        Checker::constrain_difference(checker, duplicate, original, zero);
        transition { _ -> next(checker, typing, target, source, index + 1, end) }
    }

    state done() {}
}
