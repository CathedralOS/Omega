use psi::checking::checker;
use psi::checking::holds;
use psi::checking::loans;
use psi::checking::owned_places;
use psi::checks::checks;
use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;
use psi::types::types;

// Ownership of owned places (wiki/spec/language/ownership.md). A value of an
// unrestricted (`[copy]`) type copies, an affine one moves at most once and
// a linear one exactly once on every path. A use of a place a path has
// moved, of a part of it or of a whole containing it, rejects, and a
// by-value use of an affine or linear place moves it. A borrow, an implicit
// shared loan, a callee, a dispatch subject or pattern, a membership's
// value, a `.len`, and an order, equality or logical operand inspect
// without moving. A by-value use of a place reached through a reference, or
// of a binder of a borrowed subject, would move out of a loan and rejects.
// Assigning a moved place re-establishes it; writing into a moved place's
// part rejects, and overwriting a live linear place rejects. Every exit (a
// tail value, a jump, a terminal call or value, the end of a Unit body) must
// have moved each owed linear place whole, a jump's arguments moving into
// the state they enter; a crash abandons them. A linear value discarded (a
// statement's value, a projected temporary) or moved on one path of a
// reconvergence only (an `&&`/`||` right operand, some arms of a match)
// rejects. A transition's arms are separate paths, and so are a
// value-position match's, joined after it: a place moved on any arm is
// moved after the match.

// How a tree node's value is used by its parent. `Inspect`, the zero role,
// reads without moving; `Value` takes the value; `Base` is a projection's
// base, whose place the parent uses; `Borrow` lends it shared and
// `Exclusive` exclusively; `Drop` discards it (a statement's value); `Write`
// is an assignment's target; `WriteLend` lends it for writing without
// observation (`&write`).
pub data UseRole [copy] {
    case Inspect;
    case Value;
    case Base;
    case Borrow;
    case Exclusive;
    case Drop;
    case Write;
    case WriteLend;
    // The base of a `.len` selection: its metadata is read, never its
    // contents, so a write-only reference reaches it.
    case Measure;
}

// A path's moved places, as the place expressions that moved them.
pub data MovedSet [copy] {
    places: [u64; 64];
    count: u64;
}

// How the moved places cover a written place: not at all, by a moved place
// that is it, or by a moved whole it lies strictly within.
pub data PlaceCover [copy] {
    case Uncovered;
    case Exact;
    case Within;
}

// The ownership walk of one body.
pub data Ownership {
    moved: MovedSet;
    // A transition's moved places once its arm's guard ran.
    arm_saved: MovedSet;
    // The linear roots holding an obligation on this path, as place keys
    // (`Checker::place_root`).
    owed: [u64; 64];
    owed_count: u64;
    // Pattern binders of a borrowed subject, as place keys.
    borrowed: [u64; 64];
    borrowed_count: u64;
    // The tree being walked: each node's role from its lowest handle `low`,
    // and the ranges of its `&&`/`||` right operands.
    roles: [UseRole; 4096];
    low: u64 in Trapping;
    conditional_starts: [u64; 32];
    conditional_ends: [u64; 32];
    conditional_count: u64;
    // The tree's value-position matches, each with its next arm, how many
    // of its arms ended, its moved places after its subject, and the join
    // of its ended arms with how many arms moved each joined place (a row
    // of 64 per match). `joining` is the join being extended.
    matches: [u64; 8];
    match_arms: [u64; 8];
    match_ended: [u64; 8];
    before: [MovedSet; 8];
    joined: [MovedSet; 8];
    votes: [u64; 512];
    match_count: u64;
    joining: MovedSet;
    // A crash or an exit ended the body's path.
    ended: bool;
    // Loans held by locals (loans.omg): each local's last use, by its place
    // key, and each loan's holder, place, exclusivity and whether it
    // borrows storage the body owns; the statement being walked.
    use_locals: [u64; 128];
    use_last: [u64; 128];
    use_count: u64;
    loan_holders: [u64; 64];
    loan_places: [u64; 64];
    loan_exclusive: [bool; 64];
    loan_owned: [bool; 64];
    loan_count: u64;
    statement: u64 in Trapping;
}

// The ownership walk of a machine's bodies: its entry and every state, each
// from its own parameters.
pub machine Checker::check_ownership(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem)
crashes Trap
{
    Checker::own_body(
        checker,
        syntax,
        resolution,
        typing,
        item.first_parameter,
        item.parameter_count,
        item.first_statement,
        item.statement_count,
        item.source_span
    );
    transition { _ -> next_state(checker, syntax, resolution, typing, item, 0) }

    state next_state(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping) {
        transition offset < item.state_count && checker.output.machine_accepted {
            true -> state_body(checker, syntax, resolution, typing, item, offset)
            _ -> done()
        }
    }

    state state_body(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem, offset: u64 in Trapping) {
        let state: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        Checker::own_body(
            checker,
            syntax,
            resolution,
            typing,
            state.first_parameter,
            state.parameter_count,
            state.first_statement,
            state.statement_count,
            state.source_span
        );
        transition { _ -> next_state(checker, syntax, resolution, typing, item, offset + 1) }
    }

    state done() {}
}

// One body's paths, its by-value linear parameters owed from its start. A
// body that runs off its end exits there.
machine Checker::own_body(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping,
    first_statement: u64 in Trapping,
    statement_count: u64 in Trapping,
    source_span: SourceSpan
)
crashes Trap
{
    checker.ownership.moved.count = 0;
    checker.ownership.owed_count = 0;
    checker.ownership.borrowed_count = 0;
    checker.ownership.ended = false;
    transition { _ -> parameter(checker, syntax, resolution, typing, first_parameter, first_parameter + parameter_count, first_statement, first_statement + statement_count, source_span) }

    state parameter(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        index: u64 in Trapping,
        parameter_end: u64 in Trapping,
        first_statement: u64 in Trapping,
        statement_end: u64 in Trapping,
        source_span: SourceSpan
    ) {
        transition index < parameter_end {
            true -> owe_parameter(checker, syntax, resolution, typing, index, parameter_end, first_statement, statement_end, source_span)
            _ -> uses(checker, syntax, resolution, typing, first_statement, statement_end, source_span)
        }
    }

    state uses(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        first_statement: u64 in Trapping,
        statement_end: u64 in Trapping,
        source_span: SourceSpan
    ) {
        Checker::find_last_uses(checker, syntax, resolution, first_statement, statement_end);
        transition { _ -> statement(checker, syntax, resolution, typing, first_statement, statement_end, source_span) }
    }

    state owe_parameter(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        index: u64 in Trapping,
        parameter_end: u64 in Trapping,
        first_statement: u64 in Trapping,
        statement_end: u64 in Trapping,
        source_span: SourceSpan
    ) {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, index);
        let type_handle: u64 in Trapping = Typing::reference_type(typing, parameter.type_reference);
        let multiplicity: DataMultiplicity = Checker::multiplicity(syntax, typing, type_handle);
        Checker::owe_linear(checker, multiplicity, index * 4 + 2, parameter.source_span);
        transition { _ -> parameter(checker, syntax, resolution, typing, index + 1, parameter_end, first_statement, statement_end, source_span) }
    }

    state statement(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        index: u64 in Trapping,
        end: u64 in Trapping,
        source_span: SourceSpan
    ) {
        transition index < end && checker.output.machine_accepted && !checker.ownership.ended {
            true -> walk(checker, syntax, resolution, typing, index, end, source_span)
            _ -> finished(checker, syntax, resolution, typing, source_span)
        }
    }

    state walk(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        index: u64 in Trapping,
        end: u64 in Trapping,
        source_span: SourceSpan
    ) {
        checker.ownership.statement = index;
        Checker::own_statement(checker, syntax, resolution, typing, index);
        transition { _ -> statement(checker, syntax, resolution, typing, index + 1, end, source_span) }
    }

    state finished(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, source_span: SourceSpan) {
        transition checker.output.machine_accepted && !checker.ownership.ended {
            true -> exit(checker, syntax, resolution, typing, source_span)
            _ -> done()
        }
    }

    state exit(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, source_span: SourceSpan) {
        Checker::own_exit(checker, syntax, resolution, typing, source_span);
    }

    state done() {}
}

machine Checker::own_statement(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping)
crashes Trap
{
    let statement: Statement = SyntaxTrees::statement(syntax, index);
    transition statement.kind {
        StatementKind::Let -> binding(checker, syntax, resolution, typing, index, statement)
        StatementKind::Assign -> assignment(checker, syntax, resolution, typing, statement)
        StatementKind::Tail -> tail(checker, syntax, resolution, typing, statement)
        StatementKind::Crash -> crashed(checker)
        StatementKind::Transition -> transition_statement(checker, syntax, resolution, typing, statement)
        _ -> evaluated(checker, syntax, resolution, typing, statement)
    }

    state binding(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, statement: Statement) {
        transition statement.has_value {
            true -> initialized(checker, syntax, resolution, typing, index, statement)
            _ -> done()
        }
    }

    // An initialized linear local is owed; a declared one establishes no
    // obligation until it is assigned.
    state initialized(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, statement: Statement) {
        Checker::own_tree(checker, syntax, resolution, typing, statement.value, UseRole::Value);
        let type_handle: u64 in Trapping = Typing::expression_type(typing, statement.value);
        let multiplicity: DataMultiplicity = Checker::multiplicity(syntax, typing, type_handle);
        Checker::owe_linear(checker, multiplicity, index * 4 + 1, statement.source_span);
        Checker::create_loans(checker, syntax, resolution, typing, index, statement);
    }

    // The value is evaluated before the place it is stored in.
    state assignment(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement) {
        Checker::own_tree(checker, syntax, resolution, typing, statement.value, UseRole::Value);
        let previous_count: u64 = checker.ownership.loan_count;
        let holder: u64 in Trapping = Checker::capture_local_loans(checker, syntax, resolution, typing, statement);
        // Capture uses the RHS roles before the target walk replaces them.
        // The target walk does not append, retire, or compact held loans.
        Checker::own_tree(checker, syntax, resolution, typing, statement.target, UseRole::Write);
        Ownership::replace_loan_holder(&mut checker.ownership, holder, previous_count);
    }

    state tail(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement) {
        Checker::own_tree(checker, syntax, resolution, typing, statement.value, UseRole::Value);
        Checker::own_escape(checker, syntax, resolution, typing, statement.value);
        Checker::own_exit(checker, syntax, resolution, typing, statement.source_span);
        checker.ownership.ended = true;
    }

    state crashed(checker: &mut Checker) {
        checker.ownership.ended = true;
    }

    state transition_statement(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement) {
        Checker::own_transition(checker, syntax, resolution, typing, statement);
        checker.ownership.ended = true;
    }

    state evaluated(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement) {
        Checker::own_tree(checker, syntax, resolution, typing, statement.value, UseRole::Drop);
    }

    state done() {}
}

// A transition's subject is inspected; each arm is a path of its own, after
// its guard and every earlier one, and exits through its target.
machine Checker::own_transition(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement)
crashes Trap
{
    transition statement.has_value {
        true -> subject(checker, syntax, resolution, typing, statement)
        _ -> arm(checker, syntax, resolution, typing, statement, false, 0)
    }

    state subject(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, statement: Statement) {
        Checker::own_tree(checker, syntax, resolution, typing, statement.value, UseRole::Inspect);
        let borrowed: bool = Checker::borrowed_subject(syntax, typing, statement.value);
        transition { _ -> arm(checker, syntax, resolution, typing, statement, borrowed, 0) }
    }

    state arm(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        borrowed: bool,
        offset: u64 in Trapping
    ) {
        transition offset < statement.arm_count && checker.output.machine_accepted {
            true -> guarded(checker, syntax, resolution, typing, statement, borrowed, offset)
            _ -> done()
        }
    }

    state guarded(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        borrowed: bool,
        offset: u64 in Trapping
    ) {
        let arm: TransitionArm = SyntaxTrees::arm(syntax, statement.first_arm + offset);
        transition arm.kind == ArmPatternKind::Guard {
            true -> guard(checker, syntax, resolution, typing, statement, borrowed, offset, arm)
            _ -> clause(checker, syntax, resolution, typing, statement, borrowed, offset, arm)
        }
    }

    state guard(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        borrowed: bool,
        offset: u64 in Trapping,
        arm: TransitionArm
    ) {
        Checker::own_tree(checker, syntax, resolution, typing, arm.pattern, UseRole::Inspect);
        transition { _ -> clause(checker, syntax, resolution, typing, statement, borrowed, offset, arm) }
    }

    // An arm's `if` guard inspects as a guard pattern does.
    state clause(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        borrowed: bool,
        offset: u64 in Trapping,
        arm: TransitionArm
    ) {
        transition arm.has_guard {
            true -> clause_owned(checker, syntax, resolution, typing, statement, borrowed, offset, arm)
            _ -> selected(checker, syntax, resolution, typing, statement, borrowed, offset, arm)
        }
    }

    state clause_owned(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        borrowed: bool,
        offset: u64 in Trapping,
        arm: TransitionArm
    ) {
        Checker::own_tree(checker, syntax, resolution, typing, arm.guard, UseRole::Inspect);
        transition { _ -> selected(checker, syntax, resolution, typing, statement, borrowed, offset, arm) }
    }

    state selected(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        statement: Statement,
        borrowed: bool,
        offset: u64 in Trapping,
        arm: TransitionArm
    ) {
        checker.ownership.arm_saved = checker.ownership.moved;
        Checker::borrow_binders(checker, arm, borrowed);
        Checker::own_target(checker, syntax, resolution, typing, arm);
        checker.ownership.moved = checker.ownership.arm_saved;
        transition { _ -> arm(checker, syntax, resolution, typing, statement, borrowed, offset + 1) }
    }

    state done() {}
}

// An arm's target: a jump or terminal call moves its arguments, a terminal
// value is taken, and the arm exits.
machine Checker::own_target(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, arm: TransitionArm)
crashes Trap
{
    transition arm.target_kind == ArmTargetKind::Unit {
        true -> exit(checker, syntax, resolution, typing, arm)
        _ -> evaluated(checker, syntax, resolution, typing, arm)
    }

    // A terminal call or value leaves the body; a jump stays in it.
    state evaluated(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, arm: TransitionArm) {
        Checker::own_tree(checker, syntax, resolution, typing, arm.target, UseRole::Value);
        let selection: Selection = Typing::selection(typing, arm.target);
        transition selection {
            Selection::State { handle as _ } -> exit(checker, syntax, resolution, typing, arm)
            _ -> terminal(checker, syntax, resolution, typing, arm)
        }
    }

    state terminal(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, arm: TransitionArm) {
        Checker::own_escape(checker, syntax, resolution, typing, arm.target);
        transition { _ -> exit(checker, syntax, resolution, typing, arm) }
    }

    state exit(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, arm: TransitionArm) {
        transition checker.output.machine_accepted {
            true -> owed(checker, syntax, resolution, typing, arm)
            _ -> done()
        }
    }

    state owed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, arm: TransitionArm) {
        Checker::own_exit(checker, syntax, resolution, typing, arm.source_span);
    }

    state done() {}
}

// Whether a dispatch subject is borrowed: a reference, or a place reached
// through one.
machine Checker::borrowed_subject(syntax: &SyntaxTrees, typing: &Typing, subject: u64 in Trapping) -> bool
crashes Trap
{
    let subject_type: u64 in Trapping = Typing::expression_type(typing, subject);
    let row: TypeRow = TypeTable::row(&typing.types, subject_type);
    let through: bool = Checker::borrowed_place(syntax, typing, subject);
    let borrowed: bool = row.kind == TypeKind::Reference || through;
    transition { _ -> answer(borrowed) }

    state answer(borrowed: bool) -> bool {
        borrowed
    }
}

// A borrowed subject's case pattern binds its fields as borrowed binders.
machine Checker::borrow_binders(checker: &mut Checker, arm: TransitionArm, borrowed: bool)
crashes Trap
{
    transition borrowed && arm.kind == ArmPatternKind::Case {
        true -> next(checker, arm, arm.first_field)
        _ -> done()
    }

    state next(checker: &mut Checker, arm: TransitionArm, index: u64 in Trapping) {
        transition index < arm.first_field + arm.field_count {
            true -> bind(checker, arm, index)
            _ -> done()
        }
    }

    state bind(checker: &mut Checker, arm: TransitionArm, index: u64 in Trapping) {
        let kept: bool = Ownership::borrow_binder(&mut checker.ownership, index * 4 + 3);
        transition kept {
            true -> next(checker, arm, index + 1)
            _ -> full(checker, arm)
        }
    }

    state full(checker: &mut Checker, arm: TransitionArm) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, arm.source_span);
    }

    state done() {}
}

// An exit: every owed linear place must have moved whole on this path.
machine Checker::own_exit(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, source_span: SourceSpan)
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, source_span, 0) }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, source_span: SourceSpan, index: u64 in Trapping) {
        transition index < checker.ownership.owed_count && checker.output.machine_accepted {
            true -> owed(checker, syntax, resolution, typing, source_span, index)
            _ -> done()
        }
    }

    state owed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, source_span: SourceSpan, index: u64 in Trapping) {
        let key: u64 in Trapping = Ownership::owed_at(&checker.ownership, index);
        let moved: bool = Checker::root_moved(checker, syntax, resolution, typing, key);
        transition moved {
            true -> next(checker, syntax, resolution, typing, source_span, index + 1)
            _ -> unconsumed(checker, source_span)
        }
    }

    state unconsumed(checker: &mut Checker, source_span: SourceSpan) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::LinearUnconsumed, source_span);
    }

    state done() {}
}

// Owe a linear place from here on.
machine Checker::owe_linear(checker: &mut Checker, multiplicity: DataMultiplicity, key: u64 in Trapping, source_span: SourceSpan)
crashes Trap
{
    transition multiplicity == DataMultiplicity::Linear {
        true -> owe(checker, key, source_span)
        _ -> done()
    }

    state owe(checker: &mut Checker, key: u64 in Trapping, source_span: SourceSpan) {
        let kept: bool = Ownership::owe(&mut checker.ownership, key);
        transition kept {
            true -> done()
            _ -> full(checker, source_span)
        }
    }

    state full(checker: &mut Checker, source_span: SourceSpan) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, source_span);
    }

    state done() {}
}

// One statement-level tree: its nodes' roles from `role` at its root, then
// its uses in evaluation order, children before parents, with its matches'
// arm events as they begin.
machine Checker::own_tree(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, role: UseRole)
crashes Trap
{
    let tree: Expression = SyntaxTrees::expression(syntax, root);
    let low: u64 in Trapping = tree.first_row;
    transition low <= root && root - low < 4096 {
        true -> sized(checker, syntax, resolution, typing, root, low, role)
        _ -> oversized(checker, tree)
    }

    state sized(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, low: u64 in Trapping, role: UseRole) {
        checker.ownership.low = low;
        checker.ownership.conditional_count = 0;
        checker.ownership.match_count = 0;
        Checker::assign_roles(checker, syntax, typing, root, low, role);
        Checker::scan_owned_tree(checker, syntax, root, low);
        transition { _ -> node(checker, syntax, resolution, typing, root, low) }
    }

    state node(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, handle: u64 in Trapping) {
        transition handle <= root && checker.output.machine_accepted {
            true -> visit(checker, syntax, resolution, typing, root, handle)
            _ -> done()
        }
    }

    state visit(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping, handle: u64 in Trapping) {
        Checker::own_match_events(checker, syntax, resolution, typing, handle);
        Checker::own_node(checker, syntax, resolution, typing, handle);
        Checker::replace_lent_holders(checker, syntax, resolution, typing, handle);
        Checker::check_holds(checker, syntax, resolution, typing, handle);
        Checker::close_owned_match(checker, syntax, resolution, typing, handle);
        transition { _ -> node(checker, syntax, resolution, typing, root, handle + 1) }
    }

    state oversized(checker: &mut Checker, tree: Expression) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, tree.source_span);
    }

    state done() {}
}

// Every node of a tree inspects, its root takes `role`, and each node then
// passes roles to its children, parents first: a child's handle is below
// its parent's.
machine Checker::assign_roles(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, low: u64 in Trapping, role: UseRole)
crashes Trap
{
    transition { _ -> clear(checker, syntax, typing, root, low, role, low) }

    state clear(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, low: u64 in Trapping, role: UseRole, handle: u64 in Trapping) {
        transition handle <= root {
            true -> cleared(checker, syntax, typing, root, low, role, handle)
            _ -> rooted(checker, syntax, typing, root, low, role)
        }
    }

    state cleared(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, low: u64 in Trapping, role: UseRole, handle: u64 in Trapping) {
        Checker::set_role(checker, handle, UseRole::Inspect);
        transition { _ -> clear(checker, syntax, typing, root, low, role, handle + 1) }
    }

    state rooted(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, root: u64 in Trapping, low: u64 in Trapping, role: UseRole) {
        Checker::set_role(checker, root, role);
        transition { _ -> descend(checker, syntax, typing, low, root) }
    }

    state descend(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, low: u64 in Trapping, handle: u64 in Trapping) {
        Checker::pass_role(checker, syntax, typing, handle);
        transition handle > low {
            true -> descend(checker, syntax, typing, low, handle - 1)
            _ -> done()
        }
    }

    state done() {}
}

// A node passes its children their roles. Only roles that can move or lend
// a place differ from inspection: a call's arguments and a construction's
// fields are taken, a field's or an index's base is its place's base, a
// borrow lends, and an array's elements, a match's arm values and a
// suspending or blocking call's operand take the node's own role.
machine Checker::pass_role(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping)
crashes Trap
{
    let role: UseRole = Checker::role_of(checker, handle);
    let expression: Expression = SyntaxTrees::expression(syntax, handle);
    transition expression.kind {
        ExpressionKind::Field -> field(checker, typing, handle, expression)
        ExpressionKind::Index -> child(checker, typing, expression.left, UseRole::Base)
        ExpressionKind::Unary -> unary(checker, typing, expression, role)
        ExpressionKind::Call -> elements(checker, syntax, typing, expression.first, expression.first + expression.count, UseRole::Value)
        ExpressionKind::Construct -> fields(checker, syntax, typing, expression.first, expression.first + expression.count)
        ExpressionKind::Match -> arms(checker, syntax, typing, expression.first, expression.first + expression.count, role)
        ExpressionKind::Array -> elements(checker, syntax, typing, expression.first, expression.first + expression.count, role)
        _ -> done()
    }

    // `.len` measures its base.
    state field(checker: &mut Checker, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        let place: bool = Checker::field_place(typing, handle, expression);
        transition place {
            true -> child(checker, typing, expression.left, UseRole::Base)
            _ -> child(checker, typing, expression.left, UseRole::Measure)
        }
    }

    state unary(checker: &mut Checker, typing: &Typing, expression: Expression, role: UseRole) {
        let wraps: bool = expression.operator == OperatorKind::Suspend
            || expression.operator == OperatorKind::Block
            || expression.operator == OperatorKind::SuspendBlock;
        transition expression.operator {
            OperatorKind::Borrow -> child(checker, typing, expression.left, UseRole::Borrow)
            OperatorKind::BorrowMutable -> child(checker, typing, expression.left, UseRole::Exclusive)
            OperatorKind::BorrowWrite -> child(checker, typing, expression.left, UseRole::WriteLend)
            _ -> wrapped(checker, typing, expression, role, wraps)
        }
    }

    state wrapped(checker: &mut Checker, typing: &Typing, expression: Expression, role: UseRole, wraps: bool) {
        transition wraps {
            true -> child(checker, typing, expression.left, role)
            _ -> done()
        }
    }

    state child(checker: &mut Checker, typing: &Typing, node: u64 in Trapping, role: UseRole) {
        Checker::set_child_role(checker, typing, node, role);
    }

    state elements(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, role: UseRole) {
        transition index < end {
            true -> element(checker, syntax, typing, index, end, role)
            _ -> done()
        }
    }

    state element(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, role: UseRole) {
        let node: u64 in Trapping = SyntaxTrees::argument(syntax, index);
        Checker::set_child_role(checker, typing, node, role);
        transition { _ -> elements(checker, syntax, typing, index + 1, end, role) }
    }

    state fields(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping) {
        transition index < end {
            true -> construct_field(checker, syntax, typing, index, end)
            _ -> done()
        }
    }

    state construct_field(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping) {
        let field: ConstructField = SyntaxTrees::construct_field(syntax, index);
        Checker::set_child_role(checker, typing, field.value, UseRole::Value);
        transition { _ -> fields(checker, syntax, typing, index + 1, end) }
    }

    state arms(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, role: UseRole) {
        transition index < end {
            true -> arm(checker, syntax, typing, index, end, role)
            _ -> done()
        }
    }

    state arm(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, index: u64 in Trapping, end: u64 in Trapping, role: UseRole) {
        let arm: TransitionArm = SyntaxTrees::match_arm(syntax, index);
        Checker::set_child_role(checker, typing, arm.target, role);
        transition { _ -> arms(checker, syntax, typing, index + 1, end, role) }
    }

    state done() {}
}

// A child's role, unless typing lends it implicitly to a shared-reference
// parameter.
machine Checker::set_child_role(checker: &mut Checker, typing: &Typing, node: u64 in Trapping, role: UseRole)
crashes Trap
{
    let adaptation: Adaptation = Typing::adaptation(typing, node);
    transition adaptation {
        Adaptation::SharedLend -> set(checker, node, UseRole::Borrow)
        _ -> set(checker, node, role)
    }

    state set(checker: &mut Checker, node: u64 in Trapping, role: UseRole) {
        Checker::set_role(checker, node, role);
    }
}

machine Checker::set_role(checker: &mut Checker, handle: u64 in Trapping, role: UseRole)
crashes Trap
{
    let low: u64 in Trapping = checker.ownership.low;
    transition handle >= low {
        true -> offset(checker, handle - low, role)
        _ -> done()
    }

    state offset(checker: &mut Checker, offset: u64 in Trapping, role: UseRole) {
        transition offset < 4096 {
            true -> write(checker, offset, role)
            _ -> done()
        }
    }

    state write(checker: &mut Checker, offset: u64 in Trapping, role: UseRole)
    requires offset < 4096
    {
        checker.ownership.roles[offset] = role;
    }

    state done() {}
}

// A node's role in the tree being walked; a node outside it inspects.
machine Checker::role_of(checker: &Checker, handle: u64 in Trapping) -> UseRole
crashes Trap
{
    let low: u64 in Trapping = checker.ownership.low;
    transition handle >= low {
        true -> offset(checker, handle - low)
        _ -> answer(UseRole::Inspect)
    }

    state offset(checker: &Checker, offset: u64 in Trapping) -> UseRole {
        transition offset < 4096 {
            true -> read(checker, offset)
            _ -> answer(UseRole::Inspect)
        }
    }

    state read(checker: &Checker, offset: u64 in Trapping) -> UseRole
    requires offset < 4096
    {
        let role: UseRole = checker.ownership.roles[offset];
        transition { _ -> answer(role) }
    }

    state answer(role: UseRole) -> UseRole {
        role
    }
}

// Record the tree's `&&`/`||` right operands and its matches.
machine Checker::scan_owned_tree(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, low: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(checker, syntax, root, low) }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, handle: u64 in Trapping) {
        transition handle <= root && checker.output.machine_accepted {
            true -> scan(checker, syntax, root, handle)
            _ -> done()
        }
    }

    state scan(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, handle: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, handle);
        let logical: bool = expression.kind == ExpressionKind::Binary
            && (expression.operator == OperatorKind::And || expression.operator == OperatorKind::Or);
        transition logical {
            true -> conditional(checker, syntax, root, handle, expression)
            _ -> matched(checker, syntax, root, handle, expression)
        }
    }

    state conditional(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, handle: u64 in Trapping, expression: Expression) {
        let operand: Expression = SyntaxTrees::expression(syntax, expression.right);
        let kept: bool = Ownership::add_conditional(&mut checker.ownership, operand.first_row, expression.right);
        transition kept {
            true -> next(checker, syntax, root, handle + 1)
            _ -> full(checker, expression)
        }
    }

    state matched(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, handle: u64 in Trapping, expression: Expression) {
        transition expression.kind == ExpressionKind::Match {
            true -> add_match(checker, syntax, root, handle, expression)
            _ -> next(checker, syntax, root, handle + 1)
        }
    }

    state add_match(checker: &mut Checker, syntax: &SyntaxTrees, root: u64 in Trapping, handle: u64 in Trapping, expression: Expression) {
        let kept: bool = Ownership::add_match(&mut checker.ownership, handle);
        transition kept {
            true -> next(checker, syntax, root, handle + 1)
            _ -> full(checker, expression)
        }
    }

    state full(checker: &mut Checker, expression: Expression) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }

    state done() {}
}

// One node's use. A place used other than as a base must not overlap a
// moved place, and a by-value use of an affine or linear place moves it.
machine Checker::own_node(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping)
crashes Trap
{
    let role: UseRole = Checker::role_of(checker, handle);
    transition role {
        UseRole::Base -> temporary(checker, syntax, typing, handle)
        UseRole::Write -> written(checker, syntax, resolution, typing, handle)
        _ -> used(checker, syntax, resolution, typing, handle, role)
    }

    state written(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping) {
        Checker::own_write(checker, syntax, resolution, typing, handle);
    }

    state used(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, role: UseRole) {
        let root: u64 in Trapping = Checker::place_root(syntax, resolution, typing, handle);
        let through: bool = Checker::borrowed_place(syntax, typing, handle);
        let binder: bool = Ownership::borrows(&checker.ownership, root);
        let borrowed: bool = through || (root > 0 && binder);
        transition root > 0 || through {
            true -> place(checker, syntax, resolution, typing, handle, role, borrowed)
            _ -> value(checker, syntax, typing, handle, role)
        }
    }

    // A place reached through a write-only reference is written or lent
    // `&write`, never read, borrowed otherwise, or inspected
    // (wiki/spec/language/ownership.md#borrows-and-aliases).
    state place(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, role: UseRole, borrowed: bool) {
        let observes: bool = role != UseRole::WriteLend && role != UseRole::Measure
            && Checker::through_write_only(syntax, typing, handle);
        transition observes {
            true -> rejected(checker, syntax, handle, CheckDiagnosticCode::WriteOnlyObservation)
            _ -> accessed(checker, syntax, resolution, typing, handle, role, borrowed)
        }
    }

    state accessed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, role: UseRole, borrowed: bool) {
        let excludes: bool = Checker::access_excludes(syntax, typing, handle, role);
        Checker::loan_access(checker, syntax, resolution, typing, handle, excludes);
        let conflict: bool = Checker::moved_conflict(checker, syntax, resolution, typing, handle);
        let taken: bool = role == UseRole::Value || role == UseRole::Drop;
        transition conflict {
            true -> rejected(checker, syntax, handle, CheckDiagnosticCode::UseAfterMove)
            _ -> taken_place(checker, syntax, typing, handle, role, borrowed, taken)
        }
    }

    state taken_place(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, role: UseRole, borrowed: bool, taken: bool) {
        transition taken {
            true -> by_value(checker, syntax, typing, handle, role, borrowed)
            _ -> done()
        }
    }

    state by_value(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, role: UseRole, borrowed: bool) {
        let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
        let multiplicity: DataMultiplicity = Checker::multiplicity(syntax, typing, type_handle);
        transition multiplicity {
            DataMultiplicity::Unrestricted -> done()
            DataMultiplicity::Linear -> linear(checker, syntax, handle, role, borrowed)
            _ -> moves(checker, syntax, handle, borrowed)
        }
    }

    // A linear place moves only into a destination, and only where every
    // path through the tree moves it.
    state linear(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, role: UseRole, borrowed: bool) {
        let conditional: bool = Ownership::conditional(&checker.ownership, handle);
        let discarded: bool = role == UseRole::Drop || conditional;
        transition discarded && !borrowed {
            true -> rejected(checker, syntax, handle, CheckDiagnosticCode::LinearUnconsumed)
            _ -> moves(checker, syntax, handle, borrowed)
        }
    }

    state moves(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, borrowed: bool) {
        transition borrowed {
            true -> rejected(checker, syntax, handle, CheckDiagnosticCode::MoveOutOfBorrow)
            _ -> record(checker, syntax, handle)
        }
    }

    state record(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping) {
        let kept: bool = MovedSet::add(&mut checker.ownership.moved, handle);
        transition kept {
            true -> done()
            _ -> rejected(checker, syntax, handle, CheckDiagnosticCode::CheckCapacityExceeded)
        }
    }

    state value(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, role: UseRole) {
        transition role == UseRole::Drop {
            true -> temporary(checker, syntax, typing, handle)
            _ -> done()
        }
    }

    // A temporary a statement discards or a projection reads from is
    // dropped: a linear one is lost.
    state temporary(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, handle);
        let produced: bool = expression.kind == ExpressionKind::Call
            || expression.kind == ExpressionKind::Construct
            || expression.kind == ExpressionKind::Match
            || expression.kind == ExpressionKind::Array;
        transition produced {
            true -> produced_value(checker, syntax, typing, handle)
            _ -> done()
        }
    }

    state produced_value(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping) {
        let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
        let multiplicity: DataMultiplicity = Checker::multiplicity(syntax, typing, type_handle);
        transition multiplicity == DataMultiplicity::Linear {
            true -> rejected(checker, syntax, handle, CheckDiagnosticCode::LinearUnconsumed)
            _ -> done()
        }
    }

    state rejected(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, code: CheckDiagnosticCode) {
        let expression: Expression = SyntaxTrees::expression(syntax, handle);
        Checks::reject(&mut checker.output, code, expression.source_span);
    }

    state done() {}
}

// An assignment's target place. Writing inside a moved place rejects;
// writing a moved place or a whole containing moved parts re-establishes
// them; overwriting a live owed linear place rejects; and a written linear
// root is owed.
machine Checker::own_write(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping)
crashes Trap
{
    Checker::loan_access(checker, syntax, resolution, typing, handle, true);
    let root: u64 in Trapping = Checker::place_root(syntax, resolution, typing, handle);
    transition root > 0 {
        true -> owned(checker, syntax, resolution, typing, handle, root)
        _ -> done()
    }

    state owned(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, root: u64 in Trapping) {
        let cover: PlaceCover = Checker::moved_cover(checker, syntax, resolution, typing, handle);
        let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
        let multiplicity: DataMultiplicity = Checker::multiplicity(syntax, typing, type_handle);
        transition cover {
            PlaceCover::Within -> rejected(checker, syntax, handle, CheckDiagnosticCode::UseAfterMove)
            PlaceCover::Exact -> replaced(checker, syntax, resolution, typing, handle, root, multiplicity)
            _ -> live(checker, syntax, resolution, typing, handle, root, multiplicity)
        }
    }

    state live(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        root: u64 in Trapping,
        multiplicity: DataMultiplicity
    ) {
        let owed: bool = Ownership::owes(&checker.ownership, root);
        transition owed && multiplicity == DataMultiplicity::Linear {
            true -> rejected(checker, syntax, handle, CheckDiagnosticCode::LinearOverwritten)
            _ -> replaced(checker, syntax, resolution, typing, handle, root, multiplicity)
        }
    }

    state replaced(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        root: u64 in Trapping,
        multiplicity: DataMultiplicity
    ) {
        Checker::reestablish(checker, syntax, resolution, typing, handle);
        let depth: u64 in Trapping = Checker::place_depth(syntax, handle);
        let expression: Expression = SyntaxTrees::expression(syntax, handle);
        transition depth == 0 {
            true -> owe(checker, root, multiplicity, expression)
            _ -> done()
        }
    }

    state owe(checker: &mut Checker, root: u64 in Trapping, multiplicity: DataMultiplicity, expression: Expression) {
        Checker::owe_linear(checker, multiplicity, root, expression.source_span);
    }

    state rejected(checker: &mut Checker, syntax: &SyntaxTrees, handle: u64 in Trapping, code: CheckDiagnosticCode) {
        let expression: Expression = SyntaxTrees::expression(syntax, handle);
        Checks::reject(&mut checker.output, code, expression.source_span);
    }

    state done() {}
}

// Whether a used place overlaps a moved one: lies within it, is it, or
// contains a moved part.
machine Checker::moved_conflict(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, handle, 0) }

    state next(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < checker.ownership.moved.count {
            true -> entry(checker, syntax, resolution, typing, handle, index)
            _ -> answer(false)
        }
    }

    state entry(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, index: u64 in Trapping) -> bool {
        let moved: u64 in Trapping = MovedSet::at(&checker.ownership.moved, index);
        let relation: PlaceRelation = Checker::place_relation(syntax, resolution, typing, handle, moved);
        transition relation {
            PlaceRelation::Apart -> next(checker, syntax, resolution, typing, handle, index + 1)
            _ -> answer(true)
        }
    }

    state answer(conflict: bool) -> bool {
        conflict
    }
}

// How the moved places cover a written place.
machine Checker::moved_cover(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping) -> PlaceCover
crashes Trap
{
    let depth: u64 in Trapping = Checker::place_depth(syntax, handle);
    transition { _ -> next(checker, syntax, resolution, typing, handle, depth, 0, PlaceCover::Uncovered) }

    state next(
        checker: &Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        depth: u64 in Trapping,
        index: u64 in Trapping,
        cover: PlaceCover
    ) -> PlaceCover {
        transition index < checker.ownership.moved.count {
            true -> entry(checker, syntax, resolution, typing, handle, depth, index, cover)
            _ -> answer(cover)
        }
    }

    state entry(
        checker: &Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        depth: u64 in Trapping,
        index: u64 in Trapping,
        cover: PlaceCover
    ) -> PlaceCover {
        let moved: u64 in Trapping = MovedSet::at(&checker.ownership.moved, index);
        let relation: PlaceRelation = Checker::place_relation(syntax, resolution, typing, handle, moved);
        let moved_depth: u64 in Trapping = Checker::place_depth(syntax, moved);
        transition relation {
            PlaceRelation::Inside -> inside(checker, syntax, resolution, typing, handle, depth, index, moved, moved_depth)
            _ -> next(checker, syntax, resolution, typing, handle, depth, index + 1, cover)
        }
    }

    state inside(
        checker: &Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        depth: u64 in Trapping,
        index: u64 in Trapping,
        moved: u64 in Trapping,
        moved_depth: u64 in Trapping
    ) -> PlaceCover {
        transition depth > moved_depth {
            true -> answer(PlaceCover::Within)
            _ -> level(checker, syntax, resolution, typing, handle, depth, index, moved)
        }
    }

    // At the moved place's own field path, a store through more index steps
    // than the moved place has writes inside it: an element of a moved
    // collection is not the whole value that re-establishes it.
    state level(
        checker: &Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        depth: u64 in Trapping,
        index: u64 in Trapping,
        moved: u64 in Trapping
    ) -> PlaceCover {
        let written_steps: u64 in Trapping = Checker::index_steps(syntax, handle);
        let moved_steps: u64 in Trapping = Checker::index_steps(syntax, moved);
        transition written_steps > moved_steps {
            true -> answer(PlaceCover::Within)
            _ -> next(checker, syntax, resolution, typing, handle, depth, index + 1, PlaceCover::Exact)
        }
    }

    state answer(cover: PlaceCover) -> PlaceCover {
        cover
    }
}

// A written place is established again, with every moved place it is or
// contains.
machine Checker::reestablish(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, handle, 0) }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, index: u64 in Trapping) {
        transition index < checker.ownership.moved.count {
            true -> entry(checker, syntax, resolution, typing, handle, index)
            _ -> done()
        }
    }

    state entry(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, index: u64 in Trapping) {
        let moved: u64 in Trapping = MovedSet::at(&checker.ownership.moved, index);
        let relation: PlaceRelation = Checker::place_relation(syntax, resolution, typing, moved, handle);
        transition relation == PlaceRelation::Inside {
            true -> removed(checker, syntax, resolution, typing, handle, index)
            _ -> next(checker, syntax, resolution, typing, handle, index + 1)
        }
    }

    // The last place takes the removed one's slot and is examined next.
    state removed(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, index: u64 in Trapping) {
        MovedSet::remove(&mut checker.ownership.moved, index);
        transition { _ -> next(checker, syntax, resolution, typing, handle, index) }
    }

    state done() {}
}

// Whether a moved place is the whole root `key`.
machine Checker::root_moved(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, key: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, key, 0) }

    state next(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, key: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < checker.ownership.moved.count {
            true -> entry(checker, syntax, resolution, typing, key, index)
            _ -> answer(false)
        }
    }

    state entry(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, key: u64 in Trapping, index: u64 in Trapping) -> bool {
        let moved: u64 in Trapping = MovedSet::at(&checker.ownership.moved, index);
        let root: u64 in Trapping = Checker::place_root(syntax, resolution, typing, moved);
        let depth: u64 in Trapping = Checker::place_depth(syntax, moved);
        let whole: bool = root == key && depth == 0;
        transition whole {
            true -> answer(true)
            _ -> next(checker, syntax, resolution, typing, key, index + 1)
        }
    }

    state answer(moved: bool) -> bool {
        moved
    }
}

// Fire the arm events of the tree's matches that begin at `handle`, an
// enclosing match's before a nested one's. The first arm saves the moved
// places after the subject; each later one joins the arm before it into
// the match's join and starts again from them.
machine Checker::own_match_events(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping)
crashes Trap
{
    let count: u64 in Trapping = checker.ownership.match_count as u64 in Trapping;
    transition { _ -> next(checker, syntax, resolution, typing, handle, count) }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, remaining: u64 in Trapping) {
        transition remaining > 0 && checker.output.machine_accepted {
            true -> matched_slot(checker, syntax, resolution, typing, handle, remaining - 1)
            _ -> done()
        }
    }

    state matched_slot(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, slot: u64 in Trapping) {
        let match_handle: u64 in Trapping = Ownership::match_at(&checker.ownership, slot);
        let next_arm: u64 in Trapping = Ownership::match_arm_at(&checker.ownership, slot);
        let expression: Expression = SyntaxTrees::expression(syntax, match_handle);
        transition next_arm < expression.count {
            true -> pending(checker, syntax, resolution, typing, handle, slot, expression, next_arm)
            _ -> next(checker, syntax, resolution, typing, handle, slot)
        }
    }

    state pending(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        slot: u64 in Trapping,
        expression: Expression,
        next_arm: u64 in Trapping
    ) {
        let arm: TransitionArm = SyntaxTrees::match_arm(syntax, expression.first + next_arm);
        let begins: u64 in Trapping = Checker::arm_start(syntax, arm);
        transition begins == handle {
            true -> begin(checker, syntax, resolution, typing, handle, slot, expression, next_arm, arm)
            _ -> next(checker, syntax, resolution, typing, handle, slot)
        }
    }

    state begin(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        slot: u64 in Trapping,
        expression: Expression,
        next_arm: u64 in Trapping,
        arm: TransitionArm
    ) {
        Ownership::set_match_arm(&mut checker.ownership, slot, next_arm + 1);
        let borrowed: bool = Checker::borrowed_subject(syntax, typing, expression.left);
        Checker::borrow_binders(checker, arm, borrowed);
        transition next_arm == 0 {
            true -> first(checker, syntax, resolution, typing, handle, slot)
            _ -> later(checker, syntax, resolution, typing, handle, slot, expression)
        }
    }

    state first(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, slot: u64 in Trapping) {
        Ownership::open_match(&mut checker.ownership, slot);
        transition { _ -> next(checker, syntax, resolution, typing, handle, slot) }
    }

    state later(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        slot: u64 in Trapping,
        expression: Expression
    ) {
        Checker::end_owned_arm(checker, syntax, resolution, typing, slot, expression);
        Ownership::restart_arm(&mut checker.ownership, slot);
        transition { _ -> next(checker, syntax, resolution, typing, handle, slot) }
    }

    state done() {}
}

// Where a match arm begins: its pattern's first node, or its value's for
// `_`.
machine Checker::arm_start(syntax: &SyntaxTrees, arm: TransitionArm) -> u64 in Trapping
crashes Trap
{
    transition arm.kind == ArmPatternKind::Wildcard {
        true -> at(syntax, arm.target)
        _ -> at(syntax, arm.pattern)
    }

    state at(syntax: &SyntaxTrees, node: u64 in Trapping) -> u64 in Trapping {
        let expression: Expression = SyntaxTrees::expression(syntax, node);
        expression.first_row
    }
}

// At a match's own node its last arm ends: the path continues from the
// join of its arms, and a linear place some arms moved and others did not
// is lost on those.
machine Checker::close_owned_match(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping)
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, handle);
    transition expression.kind == ExpressionKind::Match && checker.output.machine_accepted {
        true -> find(checker, syntax, resolution, typing, handle, expression, 0)
        _ -> done()
    }

    state find(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        slot: u64 in Trapping
    ) {
        transition slot < checker.ownership.match_count {
            true -> candidate(checker, syntax, resolution, typing, handle, expression, slot)
            _ -> done()
        }
    }

    state candidate(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        slot: u64 in Trapping
    ) {
        let match_handle: u64 in Trapping = Ownership::match_at(&checker.ownership, slot);
        transition match_handle == handle {
            true -> close(checker, syntax, resolution, typing, expression, slot)
            _ -> find(checker, syntax, resolution, typing, handle, expression, slot + 1)
        }
    }

    state close(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression, slot: u64 in Trapping) {
        Checker::end_owned_arm(checker, syntax, resolution, typing, slot, expression);
        Ownership::take_join(&mut checker.ownership, slot);
        Checker::require_joined_linear(checker, syntax, typing, slot, expression);
    }

    state done() {}
}

// Join an ended arm's moved places into its match's join: each joined
// place counts the arms that moved it.
machine Checker::end_owned_arm(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, slot: u64 in Trapping, expression: Expression)
crashes Trap
{
    Ownership::load_join(&mut checker.ownership, slot);
    transition { _ -> next(checker, syntax, resolution, typing, slot, expression, 0) }

    state next(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        slot: u64 in Trapping,
        expression: Expression,
        index: u64 in Trapping
    ) {
        transition index < checker.ownership.moved.count {
            true -> entry(checker, syntax, resolution, typing, slot, expression, index)
            _ -> ended(checker, slot)
        }
    }

    state entry(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        slot: u64 in Trapping,
        expression: Expression,
        index: u64 in Trapping
    ) {
        let place: u64 in Trapping = MovedSet::at(&checker.ownership.moved, index);
        let found: u64 in Trapping = Checker::joined_place(checker, syntax, resolution, typing, place);
        transition found > 0 {
            true -> vote(checker, syntax, resolution, typing, slot, expression, index, found - 1)
            _ -> join(checker, syntax, resolution, typing, slot, expression, index, place)
        }
    }

    state vote(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        slot: u64 in Trapping,
        expression: Expression,
        index: u64 in Trapping,
        joined: u64 in Trapping
    ) {
        Ownership::vote(&mut checker.ownership, slot, joined, false);
        transition { _ -> next(checker, syntax, resolution, typing, slot, expression, index + 1) }
    }

    state join(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        slot: u64 in Trapping,
        expression: Expression,
        index: u64 in Trapping,
        place: u64 in Trapping
    ) {
        let position: u64 in Trapping = checker.ownership.joining.count as u64 in Trapping;
        let kept: bool = MovedSet::add(&mut checker.ownership.joining, place);
        transition kept {
            true -> first_vote(checker, syntax, resolution, typing, slot, expression, index, position)
            _ -> full(checker, expression)
        }
    }

    state first_vote(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        slot: u64 in Trapping,
        expression: Expression,
        index: u64 in Trapping,
        position: u64 in Trapping
    ) {
        Ownership::vote(&mut checker.ownership, slot, position, true);
        transition { _ -> next(checker, syntax, resolution, typing, slot, expression, index + 1) }
    }

    state ended(checker: &mut Checker, slot: u64 in Trapping) {
        Ownership::store_join(&mut checker.ownership, slot);
    }

    state full(checker: &mut Checker, expression: Expression) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }
}

// Where the join being extended holds `place`, plus one; zero when it does
// not.
machine Checker::joined_place(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, place: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, place, 0) }

    state next(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, place: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        transition index < checker.ownership.joining.count {
            true -> entry(checker, syntax, resolution, typing, place, index)
            _ -> answer(0)
        }
    }

    state entry(checker: &Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, place: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        let joined: u64 in Trapping = MovedSet::at(&checker.ownership.joining, index);
        let same: bool = Checker::same_owned_place(syntax, resolution, typing, place, joined);
        transition same {
            true -> answer(index + 1)
            _ -> next(checker, syntax, resolution, typing, place, index + 1)
        }
    }

    state answer(found: u64 in Trapping) -> u64 in Trapping {
        found
    }
}

// After a match, a linear place fewer than all its arms moved rejects.
machine Checker::require_joined_linear(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, slot: u64 in Trapping, expression: Expression)
crashes Trap
{
    let arms: u64 in Trapping = Ownership::match_ended_at(&checker.ownership, slot);
    transition { _ -> next(checker, syntax, typing, slot, expression, arms, 0) }

    state next(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, slot: u64 in Trapping, expression: Expression, arms: u64 in Trapping, index: u64 in Trapping) {
        transition index < checker.ownership.moved.count && checker.output.machine_accepted {
            true -> entry(checker, syntax, typing, slot, expression, arms, index)
            _ -> done()
        }
    }

    state entry(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, slot: u64 in Trapping, expression: Expression, arms: u64 in Trapping, index: u64 in Trapping) {
        let votes: u64 in Trapping = Ownership::votes_at(&checker.ownership, slot, index);
        transition votes < arms {
            true -> partial(checker, syntax, typing, slot, expression, arms, index)
            _ -> next(checker, syntax, typing, slot, expression, arms, index + 1)
        }
    }

    state partial(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, slot: u64 in Trapping, expression: Expression, arms: u64 in Trapping, index: u64 in Trapping) {
        let place: u64 in Trapping = MovedSet::at(&checker.ownership.moved, index);
        let type_handle: u64 in Trapping = Typing::expression_type(typing, place);
        let multiplicity: DataMultiplicity = Checker::multiplicity(syntax, typing, type_handle);
        transition multiplicity == DataMultiplicity::Linear {
            true -> unconsumed(checker, expression)
            _ -> next(checker, syntax, typing, slot, expression, arms, index + 1)
        }
    }

    state unconsumed(checker: &mut Checker, expression: Expression) {
        Checks::reject(&mut checker.output, CheckDiagnosticCode::LinearUnconsumed, expression.source_span);
    }

    state done() {}
}

// The moved place at `index`.
pub machine MovedSet::at(set: &MovedSet, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < 64 {
        true -> read(set, index)
        _ -> invalid()
    }

    state read(set: &MovedSet, index: u64 in Trapping) -> u64 in Trapping
    requires index < 64
    {
        let place: u64 = set.places[index];
        place as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// Add a moved place; false when the set is full.
pub machine MovedSet::add(set: &mut MovedSet, place: u64 in Trapping) -> bool
crashes Trap
{
    transition set.count < 64 {
        true -> write(set, place, set.count)
        _ -> full()
    }

    state write(set: &mut MovedSet, place: u64 in Trapping, index: u64) -> bool
    requires index < 64
    {
        set.places[index] = place as u64;
        set.count = index + 1;
        true
    }

    state full() -> bool {
        false
    }
}

// Remove the place at `index`: the last one takes its slot.
pub machine MovedSet::remove(set: &mut MovedSet, index: u64 in Trapping)
crashes Trap
{
    transition set.count > 0 && index < set.count {
        true -> remove_at(set, index, set.count - 1)
        _ -> invalid()
    }

    state remove_at(set: &mut MovedSet, index: u64 in Trapping, final_index: u64) {
        transition index < 64 && final_index < 64 {
            true -> write(set, index, final_index)
            _ -> invalid()
        }
    }

    state write(set: &mut MovedSet, index: u64 in Trapping, final_index: u64)
    requires index < 64, final_index < 64
    {
        let place: u64 = set.places[final_index];
        set.places[index] = place;
        set.count = final_index;
    }

    state invalid() {
        crash Trap;
    }
}

// Whether `key` is owed.
pub machine Ownership::owes(ownership: &Ownership, key: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(ownership, key, 0) }

    state next(ownership: &Ownership, key: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < ownership.owed_count && index < 64 {
            true -> entry(ownership, key, index)
            _ -> answer(false)
        }
    }

    state entry(ownership: &Ownership, key: u64 in Trapping, index: u64 in Trapping) -> bool
    requires index < 64
    {
        let owed: u64 = ownership.owed[index];
        transition owed == key {
            true -> answer(true)
            _ -> next(ownership, key, index + 1)
        }
    }

    state answer(owed: bool) -> bool {
        owed
    }
}

// Owe `key` once; false when the table is full.
pub machine Ownership::owe(ownership: &mut Ownership, key: u64 in Trapping) -> bool
crashes Trap
{
    let owed: bool = Ownership::owes(ownership, key);
    transition owed {
        true -> answer(true)
        _ -> add(ownership, key, ownership.owed_count)
    }

    state add(ownership: &mut Ownership, key: u64 in Trapping, index: u64) -> bool {
        transition index < 64 {
            true -> write(ownership, key, index)
            _ -> answer(false)
        }
    }

    state write(ownership: &mut Ownership, key: u64 in Trapping, index: u64) -> bool
    requires index < 64
    {
        ownership.owed[index] = key as u64;
        ownership.owed_count = index + 1;
        true
    }

    state answer(kept: bool) -> bool {
        kept
    }
}

// The owed key at `index`.
pub machine Ownership::owed_at(ownership: &Ownership, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < 64 {
        true -> read(ownership, index)
        _ -> invalid()
    }

    state read(ownership: &Ownership, index: u64 in Trapping) -> u64 in Trapping
    requires index < 64
    {
        let key: u64 = ownership.owed[index];
        key as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// Whether `key` is a binder of a borrowed subject.
pub machine Ownership::borrows(ownership: &Ownership, key: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(ownership, key, 0) }

    state next(ownership: &Ownership, key: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < ownership.borrowed_count && index < 64 {
            true -> entry(ownership, key, index)
            _ -> answer(false)
        }
    }

    state entry(ownership: &Ownership, key: u64 in Trapping, index: u64 in Trapping) -> bool
    requires index < 64
    {
        let borrowed: u64 = ownership.borrowed[index];
        transition borrowed == key {
            true -> answer(true)
            _ -> next(ownership, key, index + 1)
        }
    }

    state answer(borrowed: bool) -> bool {
        borrowed
    }
}

// Record a binder of a borrowed subject; false when the table is full.
pub machine Ownership::borrow_binder(ownership: &mut Ownership, key: u64 in Trapping) -> bool
crashes Trap
{
    let borrowed: bool = Ownership::borrows(ownership, key);
    transition borrowed {
        true -> answer(true)
        _ -> add(ownership, key, ownership.borrowed_count)
    }

    state add(ownership: &mut Ownership, key: u64 in Trapping, index: u64) -> bool {
        transition index < 64 {
            true -> write(ownership, key, index)
            _ -> answer(false)
        }
    }

    state write(ownership: &mut Ownership, key: u64 in Trapping, index: u64) -> bool
    requires index < 64
    {
        ownership.borrowed[index] = key as u64;
        ownership.borrowed_count = index + 1;
        true
    }

    state answer(kept: bool) -> bool {
        kept
    }
}

// Record an `&&`/`||` right operand's handles; false when the table is
// full.
pub machine Ownership::add_conditional(ownership: &mut Ownership, start: u64 in Trapping, end: u64 in Trapping) -> bool
crashes Trap
{
    transition ownership.conditional_count < 32 {
        true -> write(ownership, start, end, ownership.conditional_count)
        _ -> full()
    }

    state write(ownership: &mut Ownership, start: u64 in Trapping, end: u64 in Trapping, index: u64) -> bool
    requires index < 32
    {
        ownership.conditional_starts[index] = start as u64;
        ownership.conditional_ends[index] = end as u64;
        ownership.conditional_count = index + 1;
        true
    }

    state full() -> bool {
        false
    }
}

// Whether a node lies in an `&&`/`||` right operand: on one path of a
// reconvergence only.
pub machine Ownership::conditional(ownership: &Ownership, handle: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(ownership, handle, 0) }

    state next(ownership: &Ownership, handle: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < ownership.conditional_count && index < 32 {
            true -> entry(ownership, handle, index)
            _ -> answer(false)
        }
    }

    state entry(ownership: &Ownership, handle: u64 in Trapping, index: u64 in Trapping) -> bool
    requires index < 32
    {
        let start: u64 = ownership.conditional_starts[index];
        let end: u64 = ownership.conditional_ends[index];
        let within: bool = start <= handle && handle <= end;
        transition within {
            true -> answer(true)
            _ -> next(ownership, handle, index + 1)
        }
    }

    state answer(within: bool) -> bool {
        within
    }
}

// Record a match of the tree, its first arm pending; false when the table
// is full.
pub machine Ownership::add_match(ownership: &mut Ownership, handle: u64 in Trapping) -> bool
crashes Trap
{
    transition ownership.match_count < 8 {
        true -> write(ownership, handle, ownership.match_count)
        _ -> full()
    }

    state write(ownership: &mut Ownership, handle: u64 in Trapping, index: u64) -> bool
    requires index < 8
    {
        ownership.matches[index] = handle as u64;
        ownership.match_arms[index] = 0;
        ownership.match_ended[index] = 0;
        ownership.match_count = index + 1;
        true
    }

    state full() -> bool {
        false
    }
}

pub machine Ownership::match_at(ownership: &Ownership, slot: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition slot < 8 {
        true -> read(ownership, slot)
        _ -> invalid()
    }

    state read(ownership: &Ownership, slot: u64 in Trapping) -> u64 in Trapping
    requires slot < 8
    {
        let handle: u64 = ownership.matches[slot];
        handle as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

pub machine Ownership::match_arm_at(ownership: &Ownership, slot: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition slot < 8 {
        true -> read(ownership, slot)
        _ -> invalid()
    }

    state read(ownership: &Ownership, slot: u64 in Trapping) -> u64 in Trapping
    requires slot < 8
    {
        let arm: u64 = ownership.match_arms[slot];
        arm as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

pub machine Ownership::match_ended_at(ownership: &Ownership, slot: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition slot < 8 {
        true -> read(ownership, slot)
        _ -> invalid()
    }

    state read(ownership: &Ownership, slot: u64 in Trapping) -> u64 in Trapping
    requires slot < 8
    {
        let ended: u64 = ownership.match_ended[slot];
        ended as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

pub machine Ownership::set_match_arm(ownership: &mut Ownership, slot: u64 in Trapping, arm: u64 in Trapping)
crashes Trap
{
    transition slot < 8 {
        true -> write(ownership, slot, arm)
        _ -> invalid()
    }

    state write(ownership: &mut Ownership, slot: u64 in Trapping, arm: u64 in Trapping)
    requires slot < 8
    {
        ownership.match_arms[slot] = arm as u64;
    }

    state invalid() {
        crash Trap;
    }
}

// A match's first arm begins: the moved places after its subject are
// saved, and no arm has ended.
pub machine Ownership::open_match(ownership: &mut Ownership, slot: u64 in Trapping)
crashes Trap
{
    transition slot < 8 {
        true -> write(ownership, slot)
        _ -> invalid()
    }

    state write(ownership: &mut Ownership, slot: u64 in Trapping)
    requires slot < 8
    {
        ownership.before[slot] = ownership.moved;
        ownership.joining = ownership.moved;
        ownership.joining.count = 0;
        ownership.joined[slot] = ownership.joining;
        ownership.match_ended[slot] = 0;
    }

    state invalid() {
        crash Trap;
    }
}

// A later arm starts from the moved places after the subject.
pub machine Ownership::restart_arm(ownership: &mut Ownership, slot: u64 in Trapping)
crashes Trap
{
    transition slot < 8 {
        true -> write(ownership, slot)
        _ -> invalid()
    }

    state write(ownership: &mut Ownership, slot: u64 in Trapping)
    requires slot < 8
    {
        ownership.moved = ownership.before[slot];
    }

    state invalid() {
        crash Trap;
    }
}

pub machine Ownership::load_join(ownership: &mut Ownership, slot: u64 in Trapping)
crashes Trap
{
    transition slot < 8 {
        true -> write(ownership, slot)
        _ -> invalid()
    }

    state write(ownership: &mut Ownership, slot: u64 in Trapping)
    requires slot < 8
    {
        ownership.joining = ownership.joined[slot];
    }

    state invalid() {
        crash Trap;
    }
}

// The join extended by an ended arm is stored, one more arm ended.
pub machine Ownership::store_join(ownership: &mut Ownership, slot: u64 in Trapping)
crashes Trap
{
    transition slot < 8 {
        true -> write(ownership, slot)
        _ -> invalid()
    }

    state write(ownership: &mut Ownership, slot: u64 in Trapping)
    requires slot < 8
    {
        let ended: u64 = ownership.match_ended[slot];
        ownership.joined[slot] = ownership.joining;
        transition ended < 1024 {
            true -> counted(ownership, slot, ended)
            _ -> invalid()
        }
    }

    // A match has at most 1,024 arms.
    state counted(ownership: &mut Ownership, slot: u64 in Trapping, ended: u64)
    requires slot < 8, ended < 1024
    {
        ownership.match_ended[slot] = ended + 1;
    }

    state invalid() {
        crash Trap;
    }
}

// The path after a match continues from the join of its arms.
pub machine Ownership::take_join(ownership: &mut Ownership, slot: u64 in Trapping)
crashes Trap
{
    transition slot < 8 {
        true -> write(ownership, slot)
        _ -> invalid()
    }

    state write(ownership: &mut Ownership, slot: u64 in Trapping)
    requires slot < 8
    {
        ownership.moved = ownership.joined[slot];
    }

    state invalid() {
        crash Trap;
    }
}

// Count one more arm moving joined place `index` of match `slot`, or the
// first.
pub machine Ownership::vote(ownership: &mut Ownership, slot: u64 in Trapping, index: u64 in Trapping, first: bool)
crashes Trap
{
    transition slot < 8 && index < 64 {
        true -> located(ownership, slot * 64 + index, first)
        _ -> invalid()
    }

    state located(ownership: &mut Ownership, cell: u64 in Trapping, first: bool) {
        transition cell < 512 {
            true -> write(ownership, cell, first)
            _ -> invalid()
        }
    }

    state write(ownership: &mut Ownership, cell: u64 in Trapping, first: bool)
    requires cell < 512
    {
        let votes: u64 = ownership.votes[cell];
        transition first {
            true -> store(ownership, cell, 1)
            _ -> bounded(ownership, cell, votes)
        }
    }

    state bounded(ownership: &mut Ownership, cell: u64 in Trapping, votes: u64)
    requires cell < 512
    {
        transition votes < 1024 {
            true -> counted(ownership, cell, votes)
            _ -> invalid()
        }
    }

    // An arm votes once per joined place, and a match has at most 1,024
    // arms.
    state counted(ownership: &mut Ownership, cell: u64 in Trapping, votes: u64)
    requires cell < 512, votes < 1024
    {
        ownership.votes[cell] = votes + 1;
    }

    state store(ownership: &mut Ownership, cell: u64 in Trapping, votes: u64)
    requires cell < 512
    {
        ownership.votes[cell] = votes;
    }

    state invalid() {
        crash Trap;
    }
}

pub machine Ownership::votes_at(ownership: &Ownership, slot: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition slot < 8 && index < 64 {
        true -> located(ownership, slot * 64 + index)
        _ -> invalid()
    }

    state located(ownership: &Ownership, cell: u64 in Trapping) -> u64 in Trapping {
        transition cell < 512 {
            true -> read(ownership, cell)
            _ -> invalid()
        }
    }

    state read(ownership: &Ownership, cell: u64 in Trapping) -> u64 in Trapping
    requires cell < 512
    {
        let votes: u64 = ownership.votes[cell];
        votes as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}
