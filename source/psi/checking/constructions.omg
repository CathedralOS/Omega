use psi::checking::arrivals;
use psi::checking::checker;
use psi::checking::evaluation;
use psi::checking::facts;
use psi::checking::frames;
use psi::checking::places;
use psi::integers::integers;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// The fields a construction writes
// (wiki/spec/language/state_contracts.md#mutation-and-subject-identity).
// A construction's value is a place of its own, keyed by its expression
// handle. Each integer or Boolean field it writes is pending below that
// place until something reads the field: a field place entered there takes
// the value written, and a copy of the place (a `let`, a store, an
// argument) takes the pending fields with the known ones, so the facts cost
// a subject only once a field is read. A write to a place drops the pending fields below
// it; a write to what a pending field read first enters that field, so it
// keeps the value it captured. A jump enters its arguments' pending fields
// before projecting them (arrivals.omg).

// A field a construction wrote and no place holds yet.
pub data PendingField [copy] {
    // The one-based place the field lies below.
    parent: u64 in Trapping;
    // The data field's handle.
    field: u64 in Trapping;
    type_handle: u64 in Trapping;
    value: Value;
}

// The value of a data construction `handle`: its place, its integer and
// Boolean fields pending below it. A case construction is its type's range.
pub machine Checker::construction_value(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    handle: u64 in Trapping,
    expression: Expression,
    row: TypeRow
)
crashes Trap
{
    let type_handle: u64 in Trapping = Typing::expression_type(typing, handle);
    let binding: ValueBinding = NameResolution::value_binding(resolution, expression.left);
    transition binding {
        ValueBinding::Data { item as _ } -> data(checker, syntax, typing, handle, expression, type_handle)
        _ -> typed(checker, handle, row)
    }

    state data(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, expression: Expression, type_handle: u64 in Trapping) {
        let place: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Construction, handle, 0, type_handle);
        transition place > 0 {
            true -> placed(checker, syntax, typing, handle, expression, place)
            _ -> unplaced(checker, handle)
        }
    }

    // A construction evaluated again writes its fields afresh.
    state placed(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, expression: Expression, place: u64 in Trapping) {
        Checker::forget_place(checker, typing, place);
        transition { _ -> next_field(checker, syntax, typing, handle, expression, place, 0) }
    }

    state next_field(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, expression: Expression, place: u64 in Trapping, offset: u64 in Trapping) {
        transition offset < expression.count {
            true -> written(checker, syntax, typing, handle, expression, place, offset)
            _ -> valued(checker, handle, place)
        }
    }

    state written(checker: &mut Checker, syntax: &SyntaxTrees, typing: &Typing, handle: u64 in Trapping, expression: Expression, place: u64 in Trapping, offset: u64 in Trapping) {
        let written: ConstructField = SyntaxTrees::construct_field(syntax, expression.first + offset);
        let target: MemberTarget = Typing::construct_target(typing, expression.first + offset);
        let value: Value = Checker::value_at(checker, written.value);
        transition target {
            MemberTarget::Common { field } -> common(checker, syntax, typing, handle, expression, place, offset, field, value)
            _ -> next_field(checker, syntax, typing, handle, expression, place, offset + 1)
        }
    }

    state common(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        place: u64 in Trapping,
        offset: u64 in Trapping,
        field: u64 in Trapping,
        value: Value
    ) {
        let declared: DataField = SyntaxTrees::field(syntax, field);
        let field_type: u64 in Trapping = Typing::reference_type(typing, declared.type_reference);
        let carrier: BuiltinType = Checker::carrier(typing, field_type);
        let integer: bool = Checker::has_subject(carrier);
        transition integer {
            true -> pending(checker, syntax, typing, handle, expression, place, offset, field, field_type, value)
            _ -> held(checker, syntax, typing, handle, expression, place, offset, field, field_type, value)
        }
    }

    state pending(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        place: u64 in Trapping,
        offset: u64 in Trapping,
        field: u64 in Trapping,
        field_type: u64 in Trapping,
        value: Value
    ) {
        Checker::write_pending(checker, typing, place, field, field_type, value);
        transition { _ -> next_field(checker, syntax, typing, handle, expression, place, offset + 1) }
    }

    // A slice or record field written from a place (a view, another
    // construction) takes the subject paths below that place, so the
    // record's `items.len` is the view's length.
    state held(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        place: u64 in Trapping,
        offset: u64 in Trapping,
        field: u64 in Trapping,
        field_type: u64 in Trapping,
        value: Value
    ) {
        transition value.place > 0 {
            true -> adopted(checker, syntax, typing, handle, expression, place, offset, field, field_type, value.place)
            _ -> next_field(checker, syntax, typing, handle, expression, place, offset + 1)
        }
    }

    state adopted(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        typing: &Typing,
        handle: u64 in Trapping,
        expression: Expression,
        place: u64 in Trapping,
        offset: u64 in Trapping,
        field: u64 in Trapping,
        field_type: u64 in Trapping,
        source: u64 in Trapping
    ) {
        let written: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Field, field, place, field_type);
        Checker::copy_fields(checker, typing, written, source);
        transition { _ -> next_field(checker, syntax, typing, handle, expression, place, offset + 1) }
    }

    state valued(checker: &mut Checker, handle: u64 in Trapping, place: u64 in Trapping) {
        let value: Value = Checker::place_value(checker, place);
        Checker::set_value(checker, handle, value);
    }

    state unplaced(checker: &mut Checker, handle: u64 in Trapping) {
        let value: Value = Value::unknown();
        Checker::set_value(checker, handle, value);
    }

    state typed(checker: &mut Checker, handle: u64 in Trapping, row: TypeRow) {
        let value: Value = Value::typed(row);
        Checker::set_value(checker, handle, value);
    }
}

// Write an integer or Boolean field below `parent`: into its place when it
// has one, else pending. A full table drops the field, which only forgets
// facts.
pub machine Checker::write_pending(checker: &mut Checker, typing: &Typing, parent: u64 in Trapping, field: u64 in Trapping, type_handle: u64 in Trapping, value: Value)
crashes Trap
{
    let carrier: BuiltinType = Checker::carrier(typing, type_handle);
    let integer: bool = Checker::has_subject(carrier);
    transition integer {
        true -> located(checker, parent, field, type_handle, value)
        _ -> done()
    }

    state located(checker: &mut Checker, parent: u64 in Trapping, field: u64 in Trapping, type_handle: u64 in Trapping, value: Value) {
        let existing: u64 in Trapping = Checker::find_place(checker, PlaceKind::Field, field, parent);
        transition existing > 0 {
            true -> bound(checker, existing, value)
            _ -> pending(checker, parent, field, type_handle, value)
        }
    }

    state bound(checker: &mut Checker, existing: u64 in Trapping, value: Value) {
        let entry: Place = Checker::place_at(checker, existing - 1);
        Checker::equate_subject(checker, entry.subject, value);
    }

    state pending(checker: &mut Checker, parent: u64 in Trapping, field: u64 in Trapping, type_handle: u64 in Trapping, value: Value) {
        transition checker.pending_count < 32 {
            true -> stored(checker, PendingField { parent: parent, field: field, type_handle: type_handle, value: value }, checker.pending_count)
            _ -> done()
        }
    }

    state stored(checker: &mut Checker, entry: PendingField, index: u64)
    requires index < 32
    {
        checker.pending[index] = entry;
        checker.pending_count = index + 1;
    }

    state done() {}
}

// A field place just entered below a place takes the value pending there.
pub machine Checker::take_pending(checker: &mut Checker, entry: Place)
crashes Trap
{
    transition entry.kind == PlaceKind::Field && entry.subject > 0 {
        true -> next(checker, entry, 0)
        _ -> done()
    }

    state next(checker: &mut Checker, entry: Place, index: u64 in Trapping) {
        transition index < checker.pending_count && index < 32 {
            true -> candidate(checker, entry, index)
            _ -> done()
        }
    }

    state candidate(checker: &mut Checker, entry: Place, index: u64 in Trapping)
    requires index < 32
    {
        let pending: PendingField = checker.pending[index];
        transition pending.parent == entry.parent && pending.field == entry.handle {
            true -> taken(checker, entry, index, pending.value)
            _ -> next(checker, entry, index + 1)
        }
    }

    state taken(checker: &mut Checker, entry: Place, index: u64 in Trapping, value: Value) {
        Checker::equate_subject(checker, entry.subject, value);
        Checker::remove_pending(checker, index);
    }

    state done() {}
}

// subject - value <= 0 and value - subject <= 0: equal to a linear term, or
// within an interval.
pub machine Checker::equate_subject(checker: &mut Checker, subject: u64 in Trapping, value: Value)
crashes Trap
{
    transition subject > 0 {
        true -> equated(checker, subject, value)
        _ -> done()
    }

    state equated(checker: &mut Checker, subject: u64 in Trapping, value: Value) {
        let zero: ExactInteger = ExactInteger { negative: false, magnitude: 0 };
        let unknown: Value = Value::unknown();
        let own: Value = Value { place: 0, known: true, subject: subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        Checker::constrain_difference(checker, own, value, zero);
        Checker::constrain_difference(checker, value, own, zero);
    }

    state done() {}
}

// Remove pending entry `index`: the last takes its slot.
machine Checker::remove_pending(checker: &mut Checker, index: u64 in Trapping)
crashes Trap
{
    transition checker.pending_count > 0 && checker.pending_count <= 32 && index < 32 {
        true -> moved(checker, index, checker.pending_count - 1)
        _ -> done()
    }

    state moved(checker: &mut Checker, index: u64 in Trapping, last: u64)
    requires index < 32, last < 32
    {
        let entry: PendingField = checker.pending[last];
        checker.pending[index] = entry;
        checker.pending_count = last;
    }

    state done() {}
}

// Before `place` is written: its pending fields are gone, and every pending
// field that read it enters its own place, keeping the value it captured.
pub machine Checker::forget_pending(checker: &mut Checker, typing: &Typing, place: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(checker, typing, place, 0) }

    state next(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, index: u64 in Trapping) {
        transition index < checker.pending_count && index < 32 {
            true -> candidate(checker, typing, place, index)
            _ -> done()
        }
    }

    state candidate(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, index: u64 in Trapping)
    requires index < 32
    {
        let pending: PendingField = checker.pending[index];
        let below: bool = Checker::within(checker, pending.parent, place);
        transition below {
            true -> dropped(checker, typing, place, index)
            _ -> sourced(checker, typing, place, index, pending)
        }
    }

    // The slot now holds the last entry, examined next.
    state dropped(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, index: u64 in Trapping) {
        Checker::remove_pending(checker, index);
        transition { _ -> next(checker, typing, place, index) }
    }

    state sourced(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, index: u64 in Trapping, pending: PendingField) {
        let owner: u64 in Trapping = Checker::subject_place(checker, pending.value.subject);
        let reads: bool = pending.value.known && owner > 0 && Checker::within(checker, owner, place);
        transition reads {
            true -> entered(checker, typing, place, index, pending)
            _ -> next(checker, typing, place, index + 1)
        }
    }

    // The slot then holds the last entry, examined next.
    state entered(checker: &mut Checker, typing: &Typing, place: u64 in Trapping, index: u64 in Trapping, pending: PendingField) {
        Checker::remove_pending(checker, index);
        Checker::enter_pending(checker, typing, pending);
        transition { _ -> next(checker, typing, place, index) }
    }

    state done() {}
}

// Enter a removed pending field as its place, holding its value; a full
// place table drops it.
machine Checker::enter_pending(checker: &mut Checker, typing: &Typing, pending: PendingField)
crashes Trap
{
    let field: u64 in Trapping = Checker::place(checker, typing, PlaceKind::Field, pending.field, pending.parent, pending.type_handle);
    transition field > 0 {
        true -> entered(checker, field, pending.value)
        _ -> done()
    }

    state entered(checker: &mut Checker, field: u64 in Trapping, value: Value) {
        let entry: Place = Checker::place_at(checker, field - 1);
        Checker::equate_subject(checker, entry.subject, value);
    }

    state done() {}
}

// A copy takes pending fields along the same projected paths as represented
// fields. Keeping only immediate children loses a nested construction's
// values when the enclosing record is copied or captured.
pub machine Checker::copy_pending(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping)
crashes Trap
{
    transition target > 0 && source > 0 && target != source {
        true -> next(checker, typing, target, source, 0, checker.pending_count)
        _ -> done()
    }

    // Entries the copy appends lie past `end`.
    state next(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64) {
        transition index < end && index < 32 {
            true -> candidate(checker, typing, target, source, index, end)
            _ -> done()
        }
    }

    state candidate(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64)
    requires index < 32
    {
        let pending: PendingField = checker.pending[index];
        let path: ArrivalPath = Checker::path_below(checker, source, pending.parent, 0);
        transition pending.parent == source || path.depth > 0 {
            true -> copied(checker, typing, target, source, index, end, pending, path)
            _ -> next(checker, typing, target, source, index + 1, end)
        }
    }

    state copied(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64, pending: PendingField, path: ArrivalPath) {
        let parent: u64 in Trapping = Checker::enter_path(checker, typing, target, path);
        transition parent > 0 {
            true -> written(checker, typing, target, source, index, end, pending, parent)
            _ -> next(checker, typing, target, source, index + 1, end)
        }
    }

    state written(checker: &mut Checker, typing: &Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64, pending: PendingField, parent: u64 in Trapping) {
        Checker::write_pending(checker, typing, parent, pending.field, pending.type_handle, pending.value);
        transition { _ -> next(checker, typing, target, source, index + 1, end) }
    }

    state done() {}
}

// Enter every field pending below `parent` as its place.
pub machine Checker::settle_pending(checker: &mut Checker, typing: &Typing, parent: u64 in Trapping)
crashes Trap
{
    Checker::settle_pending_fields(checker, typing, parent, false, 0);
}

// A narrow call frame must see pending fields it writes as places before
// invalidating those places. Untouched siblings keep their pending values;
// forgetting the entire parent here would discard their construction facts.
pub machine Checker::settle_written_pending(checker: &mut Checker, typing: &Typing, parent: u64 in Trapping, callee: u64 in Trapping)
crashes Trap
{
    Checker::settle_pending_fields(checker, typing, parent, true, callee);
}

machine Checker::settle_pending_fields(checker: &mut Checker, typing: &Typing, parent: u64 in Trapping, written_only: bool, callee: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(checker, typing, parent, written_only, callee, 0) }

    state next(checker: &mut Checker, typing: &Typing, parent: u64 in Trapping, written_only: bool, callee: u64 in Trapping, index: u64 in Trapping) {
        transition index < checker.pending_count && index < 32 {
            true -> candidate(checker, typing, parent, written_only, callee, index)
            _ -> done()
        }
    }

    state candidate(checker: &mut Checker, typing: &Typing, parent: u64 in Trapping, written_only: bool, callee: u64 in Trapping, index: u64 in Trapping)
    requires index < 32
    {
        let pending: PendingField = checker.pending[index];
        let below: bool = pending.parent == parent || (written_only && Checker::within(checker, pending.parent, parent));
        let selected: bool = !written_only || Checker::writes_field(checker, callee, pending.field);
        transition below && selected {
            true -> entered(checker, typing, parent, written_only, callee, index, pending)
            _ -> next(checker, typing, parent, written_only, callee, index + 1)
        }
    }

    // The slot then holds the last entry, examined next.
    state entered(checker: &mut Checker, typing: &Typing, parent: u64 in Trapping, written_only: bool, callee: u64 in Trapping, index: u64 in Trapping, pending: PendingField) {
        Checker::remove_pending(checker, index);
        Checker::enter_pending(checker, typing, pending);
        transition { _ -> next(checker, typing, parent, written_only, callee, index) }
    }

    state done() {}
}
