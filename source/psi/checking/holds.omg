use psi::checking::checker;
use psi::checking::owned_places;
use psi::checking::ownership;
use psi::checks::checks;
use psi::resolution::resolution;
use psi::syntax::syntax;
use psi::types::types;

// The places one call holds together (wiki/spec/language/ownership.md#borrows-and-aliases).
// A call evaluates its arguments in order. An argument that lends a place
// (`&mut place`, `&place`, an implicit shared loan, or a reference value)
// holds it until the call returns; a copied read or a computed value holds
// nothing once the next argument begins. An earlier argument's hold
// conflicts with every overlapping access of a later argument (a read, a
// loan, or a nested call's argument inside it) when either is exclusive.
// Places overlap when one's path is a prefix of the other's, through
// references; integer-literal indexes that differ are apart. A local jump
// that forwards an exclusive reference parameter whole passes its body's
// data parent on and holds nothing new beside the jump's other arguments,
// unless it forwards that parameter twice.

// What an argument holds while its call runs: nothing, or a shared or an
// exclusive loan of a place expression.
pub data Hold [copy] {
    case Released;
    case Shared(place: u64 in Trapping);
    case Exclusive(place: u64 in Trapping);
}

// A call's arguments, pairwise: an earlier argument's hold against every
// access of a later one.
pub machine Checker::check_holds(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping)
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, handle);
    transition expression.kind == ExpressionKind::Call && expression.count > 1 && checker.output.machine_accepted {
        true -> called(checker, syntax, resolution, typing, handle, expression)
        _ -> done()
    }

    state called(checker: &mut Checker, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        let selection: Selection = Typing::selection(typing, handle);
        let first_parameter: u64 in Trapping = Checker::callee_parameters(syntax, selection);
        transition selection {
            Selection::State { handle as _ } -> earlier(checker, syntax, resolution, typing, expression, true, first_parameter, 0)
            _ -> earlier(checker, syntax, resolution, typing, expression, false, first_parameter, 0)
        }
    }

    state earlier(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        expression: Expression,
        jump: bool,
        first_parameter: u64 in Trapping,
        index: u64 in Trapping
    ) {
        transition index + 1 < expression.count && checker.output.machine_accepted {
            true -> held(checker, syntax, resolution, typing, expression, jump, first_parameter, index)
            _ -> done()
        }
    }

    state held(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        expression: Expression,
        jump: bool,
        first_parameter: u64 in Trapping,
        index: u64 in Trapping
    ) {
        let argument: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + index);
        let hold: Hold = Checker::argument_hold(syntax, typing, argument);
        let forwards: bool = jump && Checker::forwards_parameter(syntax, resolution, typing, argument);
        let shared: bool = Checker::shared_parameter(syntax, typing, first_parameter, index);
        let exclusive: bool = !shared;
        transition hold {
            Hold::Shared { place } -> later(checker, syntax, resolution, typing, expression, jump, first_parameter, index, place, false, forwards, index + 1)
            Hold::Exclusive { place } -> later(checker, syntax, resolution, typing, expression, jump, first_parameter, index, place, exclusive, forwards, index + 1)
            _ -> earlier(checker, syntax, resolution, typing, expression, jump, first_parameter, index + 1)
        }
    }

    state later(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        expression: Expression,
        jump: bool,
        first_parameter: u64 in Trapping,
        index: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        forwards: bool,
        other: u64 in Trapping
    ) {
        transition other < expression.count && checker.output.machine_accepted {
            true -> paired(checker, syntax, resolution, typing, expression, jump, first_parameter, index, place, exclusive, forwards, other)
            _ -> earlier(checker, syntax, resolution, typing, expression, jump, first_parameter, index + 1)
        }
    }

    // A forwarded data parent pairs only with a second forwarding of its
    // parameter.
    state paired(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        expression: Expression,
        jump: bool,
        first_parameter: u64 in Trapping,
        index: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        forwards: bool,
        other: u64 in Trapping
    ) {
        let argument: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + other);
        let forwarded: bool = jump && Checker::forwards_parameter(syntax, resolution, typing, argument);
        transition forwards || forwarded {
            true -> forwarding(checker, syntax, resolution, typing, expression, jump, first_parameter, index, place, exclusive, forwards, other, forwards && forwarded)
            _ -> scanned(checker, syntax, resolution, typing, expression, jump, first_parameter, index, place, exclusive, forwards, other)
        }
    }

    state forwarding(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        expression: Expression,
        jump: bool,
        first_parameter: u64 in Trapping,
        index: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        forwards: bool,
        other: u64 in Trapping,
        both: bool
    ) {
        transition both {
            true -> scanned(checker, syntax, resolution, typing, expression, jump, first_parameter, index, place, exclusive, forwards, other)
            _ -> later(checker, syntax, resolution, typing, expression, jump, first_parameter, index, place, exclusive, forwards, other + 1)
        }
    }

    state scanned(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        expression: Expression,
        jump: bool,
        first_parameter: u64 in Trapping,
        index: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        forwards: bool,
        other: u64 in Trapping
    ) {
        let argument: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + other);
        Checker::scan_accesses(checker, syntax, resolution, typing, argument, place, exclusive);
        transition { _ -> later(checker, syntax, resolution, typing, expression, jump, first_parameter, index, place, exclusive, forwards, other + 1) }
    }

    state done() {}
}

// What an argument holds: the place an implicit shared loan or a borrow
// lends, or a reference value's referent; a reference read for its scalar
// holds nothing.
machine Checker::argument_hold(syntax: &SyntaxTrees, typing: &Typing, argument: u64 in Trapping) -> Hold
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, argument);
    let adaptation: Adaptation = Typing::adaptation(typing, argument);
    transition adaptation {
        Adaptation::SharedLend -> answer(Hold::Shared { place: argument })
        Adaptation::Read -> answer(Hold::Released)
        _ -> lent(typing, argument, expression)
    }

    state lent(typing: &Typing, argument: u64 in Trapping, expression: Expression) -> Hold {
        let unary: bool = expression.kind == ExpressionKind::Unary;
        transition unary {
            true -> borrowed(typing, argument, expression)
            _ -> referenced(typing, argument)
        }
    }

    state borrowed(typing: &Typing, argument: u64 in Trapping, expression: Expression) -> Hold {
        transition expression.operator {
            OperatorKind::Borrow -> answer(Hold::Shared { place: expression.left })
            OperatorKind::BorrowMutable -> answer(Hold::Exclusive { place: expression.left })
            _ -> referenced(typing, argument)
        }
    }

    state referenced(typing: &Typing, argument: u64 in Trapping) -> Hold {
        let argument_type: u64 in Trapping = Typing::expression_type(typing, argument);
        let row: TypeRow = TypeTable::row(&typing.types, argument_type);
        let mutable: bool = row.access == ReferenceAccess::Mutable;
        transition row.kind == TypeKind::Reference {
            true -> reference(argument, mutable)
            _ -> answer(Hold::Released)
        }
    }

    state reference(argument: u64 in Trapping, mutable: bool) -> Hold {
        transition mutable {
            true -> answer(Hold::Exclusive { place: argument })
            _ -> answer(Hold::Shared { place: argument })
        }
    }

    state answer(hold: Hold) -> Hold {
        hold
    }
}

// Whether an argument forwards an exclusive reference parameter whole.
machine Checker::forwards_parameter(syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, argument: u64 in Trapping) -> bool
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, argument);
    transition expression.kind == ExpressionKind::Name {
        true -> named(resolution, typing, argument)
        _ -> answer(false)
    }

    state named(resolution: &NameResolution, typing: &Typing, argument: u64 in Trapping) -> bool {
        let binding: ValueBinding = NameResolution::value_binding(resolution, argument);
        let argument_type: u64 in Trapping = Typing::expression_type(typing, argument);
        let row: TypeRow = TypeTable::row(&typing.types, argument_type);
        let exclusive: bool = row.kind == TypeKind::Reference && row.access == ReferenceAccess::Mutable;
        transition binding {
            ValueBinding::Parameter { parameter } -> answer(exclusive)
            _ -> answer(false)
        }
    }

    state answer(forwards: bool) -> bool {
        forwards
    }
}

// Every access inside a later argument against an earlier argument's hold
// of `place`: an overlapping access conflicts when either is exclusive.
machine Checker::scan_accesses(
    checker: &mut Checker,
    syntax: &SyntaxTrees,
    resolution: &NameResolution,
    typing: &Typing,
    argument: u64 in Trapping,
    place: u64 in Trapping,
    exclusive: bool
)
crashes Trap
{
    let tree: Expression = SyntaxTrees::expression(syntax, argument);
    transition { _ -> next(checker, syntax, resolution, typing, argument, place, exclusive, tree.first_row) }

    state next(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        argument: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        node: u64 in Trapping
    ) {
        transition node <= argument && checker.output.machine_accepted {
            true -> access(checker, syntax, resolution, typing, argument, place, exclusive, node)
            _ -> done()
        }
    }

    state access(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        argument: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        node: u64 in Trapping
    ) {
        let role: UseRole = Checker::role_of(checker, node);
        let root: u64 in Trapping = Checker::path_root(syntax, resolution, typing, node, true);
        transition role == UseRole::Base || root == 0 {
            true -> next(checker, syntax, resolution, typing, argument, place, exclusive, node + 1)
            _ -> overlapping(checker, syntax, resolution, typing, argument, place, exclusive, node, role)
        }
    }

    state overlapping(
        checker: &mut Checker,
        syntax: &SyntaxTrees,
        resolution: &NameResolution,
        typing: &Typing,
        argument: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        node: u64 in Trapping,
        role: UseRole
    ) {
        let relation: PlaceRelation = Checker::path_relation(syntax, resolution, typing, node, place, true);
        let excludes: bool = Checker::exclusive_access(typing, node, role);
        let conflict: bool = relation != PlaceRelation::Apart && (exclusive || excludes);
        transition conflict {
            true -> rejected(checker, syntax, node)
            _ -> next(checker, syntax, resolution, typing, argument, place, exclusive, node + 1)
        }
    }

    state rejected(checker: &mut Checker, syntax: &SyntaxTrees, node: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, node);
        Checks::reject(&mut checker.output, CheckDiagnosticCode::OverlappingArguments, expression.source_span);
    }

    state done() {}
}

// Whether a place access is exclusive: lent `&mut`, or an exclusive
// reference passed on rather than read.
machine Checker::exclusive_access(typing: &Typing, node: u64 in Trapping, role: UseRole) -> bool
crashes Trap
{
    let node_type: u64 in Trapping = Typing::expression_type(typing, node);
    let row: TypeRow = TypeTable::row(&typing.types, node_type);
    let adaptation: Adaptation = Typing::adaptation(typing, node);
    let reference: bool = row.kind == TypeKind::Reference && row.access == ReferenceAccess::Mutable
        && adaptation != Adaptation::Read;
    let exclusive: bool = role == UseRole::Exclusive || (role == UseRole::Value && reference);
    transition { _ -> answer(exclusive) }

    state answer(exclusive: bool) -> bool {
        exclusive
    }
}

// The handle of a call's callee's first parameter, plus one: a machine's or
// a state's; zero when the callee has no parameter list here.
pub machine Checker::callee_parameters(syntax: &SyntaxTrees, selection: Selection) -> u64 in Trapping
crashes Trap
{
    transition selection {
        Selection::Machine { handle } -> machine_parameters(syntax, handle)
        Selection::State { handle } -> state_parameters(syntax, handle)
        _ -> answer(0)
    }

    state machine_parameters(syntax: &SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, handle);
        let first: u64 in Trapping = item.first_parameter + 1;
        transition { _ -> answer(first) }
    }

    state state_parameters(syntax: &SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping {
        let item: StateItem = SyntaxTrees::state_item(syntax, handle);
        let first: u64 in Trapping = item.first_parameter + 1;
        transition { _ -> answer(first) }
    }

    state answer(first: u64 in Trapping) -> u64 in Trapping {
        first
    }
}

// Whether a call's parameter `offset` is a shared reference: an exclusive
// argument passed there is held shared.
pub machine Checker::shared_parameter(syntax: &SyntaxTrees, typing: &Typing, first_parameter: u64 in Trapping, offset: u64 in Trapping) -> bool
crashes Trap
{
    transition first_parameter > 0 {
        true -> located(syntax, typing, first_parameter, offset)
        _ -> answer(false)
    }

    state located(syntax: &SyntaxTrees, typing: &Typing, first_parameter: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let index: u64 in Trapping = (first_parameter - 1) + offset;
        transition { _ -> declared(syntax, typing, index) }
    }

    state declared(syntax: &SyntaxTrees, typing: &Typing, index: u64 in Trapping) -> bool {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, index);
        let type_handle: u64 in Trapping = Typing::reference_type(typing, parameter.type_reference);
        let row: TypeRow = TypeTable::row(&typing.types, type_handle);
        let shared: bool = row.kind == TypeKind::Reference && row.access == ReferenceAccess::Shared;
        transition { _ -> answer(shared) }
    }

    state answer(shared: bool) -> bool {
        shared
    }
}
