// Gate-owned black-box lexer/parser harness. It lives in the gate package so
// the gate's build root can bind `ParserHarness::main` as its own product
// entry; the product compiler closure under `source/psi` never includes it.

use omega_language_std::console;
use omega::language::core::service;
use psi::lex::lexer;
use psi::parse::parser;
use psi::syntax::syntax;

pub data ParserHarness {
    console: Binding<Console>;
    lexer: Lexer;
    parser: Parser;
}

pub machine ParserHarness::main(&mut self)
reaches Console
invokes Console;
crashes Trap
blocks;
{
    self.lexer.initialize(1);
    transition { _ -> read() }

    state read(&mut self) {
        let input: ByteRead = block self.console.read_byte();
        transition input {
            ByteRead::Byte { value } -> retain(value)
            _ -> tokenize()
        }
    }

    state retain(&mut self, value: i32) {
        self.lexer.append_source_byte(value as u8);
        transition self.lexer.source.last_retained {
            true -> read()
            _ -> source_full()
        }
    }

    state source_full(&mut self) {
        // The rejection span is read before the lexer is borrowed mutably:
        // a call's mutable receiver cannot overlap an argument read.
        let length: u64 [0..=65536] = self.lexer.source.length;
        self.lexer.reject(LexDiagnosticCode::SourceCapacityExceeded, length, length);
        self.console.exit_process(252);
    }

    state tokenize(&mut self) {
        self.lexer.tokenize();
        transition self.lexer.output.accepted {
            true -> prepare_parse()
            _ -> rejected()
        }
    }

    state prepare_parse(&mut self) {
        self.parser.initialize(
            self.lexer.source.id,
            self.lexer.source.length
        );
        transition { _ -> parse() }
    }

    state parse(&mut self) {
        self.parser.parse(&self.lexer.output);
        transition self.parser.output.accepted {
            true -> accepted()
            _ -> parse_rejected()
        }
    }

    state accepted(&mut self) {
        self.write_parse_observation();
        self.console.exit_process(0);
    }

    state parse_rejected(&mut self) {
        self.write_parse_observation();
        self.console.exit_process(250);
    }

    state rejected(&mut self) {
        self.console.exit_process(251);
    }
}

// Versioned canonical structural parse observation. Every scalar coordinate
// and count is little-endian u64. The stream begins with `OMGPAR8\0`, version
// 8, acceptance and diagnostic fields, followed by ordered root, use-item,
// path-member, data-item, authored data-member, direct data-field, case-payload
// field, data-case, type-reference, and generic-parameter tables.
// Type-reference rows append a qualified flag and the domain coordinates
// (zeros for bare named types). Data-item rows end with the item's
// generic-parameter base and count, and generic-parameter rows carry kind,
// name, optional type-reference handle, bounds, and span. This is hosted
// development tooling, not an Omega ABI.
machine ParserHarness::write_parse_observation(&mut self) reaches Console {
    self.write_byte(79);
    self.write_byte(77);
    self.write_byte(71);
    self.write_byte(80);
    self.write_byte(65);
    self.write_byte(82);
    self.write_byte(56);
    self.write_byte(0);
    self.write_u64(8);
    transition self.parser.output.accepted {
        true -> parse_accepted_header()
        _ -> parse_rejected_header()
    }

    state parse_accepted_header(&mut self) {
        self.write_byte(1);
        transition { _ -> parse_diagnostic_none() }
    }

    state parse_rejected_header(&mut self) {
        self.write_byte(0);
        transition self.parser.output.diagnostic.code {
            ParseDiagnosticCode::None -> parse_diagnostic_none()
            ParseDiagnosticCode::LexicalInputRejected -> parse_diagnostic(1)
            ParseDiagnosticCode::UnsupportedRootItem -> parse_diagnostic(2)
            ParseDiagnosticCode::ExpectedPathMember -> parse_diagnostic(3)
            ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon -> parse_diagnostic(4)
            ParseDiagnosticCode::RootCapacityExceeded -> parse_diagnostic(5)
            ParseDiagnosticCode::UseCapacityExceeded -> parse_diagnostic(6)
            ParseDiagnosticCode::PathMemberCapacityExceeded -> parse_diagnostic(7)
            ParseDiagnosticCode::TokenInputCapacityExceeded -> parse_diagnostic(8)
            ParseDiagnosticCode::ExpectedDataAfterPub -> parse_diagnostic(9)
            ParseDiagnosticCode::ExpectedDataName -> parse_diagnostic(10)
            ParseDiagnosticCode::ExpectedDataBody -> parse_diagnostic(11)
            ParseDiagnosticCode::ExpectedDataFieldColon -> parse_diagnostic(12)
            ParseDiagnosticCode::ExpectedDataFieldType -> parse_diagnostic(13)
            ParseDiagnosticCode::ExpectedDataFieldEnd -> parse_diagnostic(14)
            ParseDiagnosticCode::DataCapacityExceeded -> parse_diagnostic(15)
            ParseDiagnosticCode::DataFieldCapacityExceeded -> parse_diagnostic(16)
            ParseDiagnosticCode::TypeReferenceCapacityExceeded -> parse_diagnostic(17)
            ParseDiagnosticCode::ExpectedDataProperty -> parse_diagnostic(18)
            ParseDiagnosticCode::ExpectedDataPropertyEnd -> parse_diagnostic(19)
            ParseDiagnosticCode::ExpectedDataCaseName -> parse_diagnostic(20)
            ParseDiagnosticCode::ExpectedDataCaseEnd -> parse_diagnostic(21)
            ParseDiagnosticCode::DataMemberCapacityExceeded -> parse_diagnostic(22)
            ParseDiagnosticCode::DataCaseCapacityExceeded -> parse_diagnostic(23)
            ParseDiagnosticCode::ExpectedDataCasePayloadField -> parse_diagnostic(24)
            ParseDiagnosticCode::ExpectedDataCasePayloadFieldColon -> parse_diagnostic(25)
            ParseDiagnosticCode::ExpectedDataCasePayloadFieldType -> parse_diagnostic(26)
            ParseDiagnosticCode::ExpectedDataCasePayloadSeparatorOrEnd -> parse_diagnostic(27)
            ParseDiagnosticCode::DataCasePayloadFieldCapacityExceeded -> parse_diagnostic(28)
            ParseDiagnosticCode::DuplicateDataMultiplicity -> parse_diagnostic(29)
            ParseDiagnosticCode::ConflictingDataMultiplicity -> parse_diagnostic(30)
            ParseDiagnosticCode::ExpectedTypeQualifierDomain -> parse_diagnostic(31)
            ParseDiagnosticCode::ExpectedDataGenericParameter -> parse_diagnostic(32)
            ParseDiagnosticCode::ExpectedDataGenericParameterName -> parse_diagnostic(33)
            ParseDiagnosticCode::ExpectedDataGenericParameterColon -> parse_diagnostic(34)
            ParseDiagnosticCode::ExpectedDataGenericParameterType -> parse_diagnostic(35)
            ParseDiagnosticCode::ExpectedDataGenericParameterEnd -> parse_diagnostic(36)
            ParseDiagnosticCode::DataGenericParameterCapacityExceeded -> parse_diagnostic(37)
            ParseDiagnosticCode::DataGenericLifetimeOrdering -> parse_diagnostic(38)
            ParseDiagnosticCode::DuplicateDataGenericParameter -> parse_diagnostic(39)
        }
    }

    state parse_diagnostic_none(&mut self) {
        self.write_byte(0);
        transition { _ -> parse_diagnostic_coordinates() }
    }

    state parse_diagnostic(&mut self, tag: u8) {
        self.write_byte(tag);
        transition { _ -> parse_diagnostic_coordinates() }
    }

    state parse_diagnostic_coordinates(&mut self) {
        self.write_u64(self.parser.output.diagnostic.source_span.source.value as u64);
        self.write_u64(self.parser.output.diagnostic.source_span.span.start);
        self.write_u64(self.parser.output.diagnostic.source_span.span.end);
        self.write_u64(self.parser.output.root_count);
        transition self.parser.output.root_count > 0 {
            true -> parse_root(0)
            _ -> parse_use_count()
        }
    }

    state parse_root(&mut self, index: u64 [0..=255]) {
        let root: RootItem = self.parser.output.roots[index];
        transition root.kind {
            RootItemKind::Use -> parse_root_use(root, index)
            RootItemKind::Data -> parse_root_data(root, index)
        }
    }

    state parse_root_use(
        &mut self,
        root: RootItem,
        index: u64 [0..=255]
    ) {
        self.write_byte(1);
        self.write_u64(root.item_index);
        self.write_u64(root.source_span.source.value as u64);
        self.write_u64(root.source_span.span.start);
        self.write_u64(root.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.root_count {
            true -> parse_root_bound(next)
            _ -> parse_use_count()
        }
    }

    state parse_root_data(
        &mut self,
        root: RootItem,
        index: u64 [0..=255]
    ) {
        self.write_byte(2);
        self.write_u64(root.item_index);
        self.write_u64(root.source_span.source.value as u64);
        self.write_u64(root.source_span.span.start);
        self.write_u64(root.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.root_count {
            true -> parse_root_bound(next)
            _ -> parse_use_count()
        }
    }

    state parse_root_bound(&mut self, next: u64) {
        transition next < 256 {
            true -> parse_root(next)
            _ -> parse_use_count()
        }
    }

    state parse_use_count(&mut self) {
        self.write_u64(self.parser.output.use_count);
        transition self.parser.output.use_count > 0 {
            true -> parse_use_item(0)
            _ -> parse_member_count()
        }
    }

    state parse_use_item(&mut self, index: u64 [0..=255]) {
        let item: UseItem = self.parser.output.uses[index];
        self.write_u64(item.first_member);
        self.write_u64(item.member_count);
        self.write_u64(item.source_span.source.value as u64);
        self.write_u64(item.source_span.span.start);
        self.write_u64(item.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.use_count {
            true -> parse_use_bound(next)
            _ -> parse_member_count()
        }
    }

    state parse_use_bound(&mut self, next: u64) {
        transition next < 256 {
            true -> parse_use_item(next)
            _ -> parse_member_count()
        }
    }

    state parse_member_count(&mut self) {
        self.write_u64(self.parser.output.member_count);
        transition self.parser.output.member_count > 0 {
            true -> parse_member(0)
            _ -> parse_data_count()
        }
    }

    state parse_member(&mut self, index: u64 [0..=1023]) {
        let member: IdentifierSpan = self.parser.output.members[index];
        self.write_u64(member.source_span.source.value as u64);
        self.write_u64(member.source_span.span.start);
        self.write_u64(member.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.member_count {
            true -> parse_member_bound(next)
            _ -> parse_data_count()
        }
    }

    state parse_member_bound(&mut self, next: u64) {
        transition next < 1024 {
            true -> parse_member(next)
            _ -> parse_data_count()
        }
    }

    state parse_data_count(&mut self) {
        self.write_u64(self.parser.output.data_count);
        transition self.parser.output.data_count > 0 {
            true -> parse_data_item(0)
            _ -> parse_data_member_count()
        }
    }

    state parse_data_item(&mut self, index: u64 [0..=255]) {
        let item: DataItem = self.parser.output.data_items[index];
        self.write_u64(item.name.source_span.source.value as u64);
        self.write_u64(item.name.source_span.span.start);
        self.write_u64(item.name.source_span.span.end);
        self.write_u64(item.first_member);
        self.write_u64(item.member_count);
        self.write_u64(item.first_field);
        self.write_u64(item.field_count);
        self.write_u64(item.first_case);
        self.write_u64(item.case_count);
        transition item.multiplicity {
            DataMultiplicity::Affine -> parse_data_multiplicity(item, index, 0)
            DataMultiplicity::Unrestricted -> parse_data_multiplicity(item, index, 1)
            DataMultiplicity::Linear -> parse_data_multiplicity(item, index, 2)
        }
    }

    state parse_data_multiplicity(
        &mut self,
        item: DataItem,
        index: u64 [0..=255],
        multiplicity: u8
    ) {
        self.write_byte(multiplicity);
        transition item.is_public {
            true -> parse_data_public(item, index)
            _ -> parse_data_private(item, index)
        }
    }

    state parse_data_public(
        &mut self,
        item: DataItem,
        index: u64 [0..=255]
    ) {
        self.write_byte(1);
        transition { _ -> parse_data_span(item, index) }
    }

    state parse_data_private(
        &mut self,
        item: DataItem,
        index: u64 [0..=255]
    ) {
        self.write_byte(0);
        transition { _ -> parse_data_span(item, index) }
    }

    state parse_data_span(
        &mut self,
        item: DataItem,
        index: u64 [0..=255]
    ) {
        self.write_u64(item.source_span.source.value as u64);
        self.write_u64(item.source_span.span.start);
        self.write_u64(item.source_span.span.end);
        self.write_u64(item.first_generic_parameter);
        self.write_u64(item.generic_parameter_count);
        let next: u64 = index + 1;
        transition next < self.parser.output.data_count {
            true -> parse_data_bound(next)
            _ -> parse_data_member_count()
        }
    }

    state parse_data_bound(&mut self, next: u64) {
        transition next < 256 {
            true -> parse_data_item(next)
            _ -> parse_data_member_count()
        }
    }

    state parse_data_member_count(&mut self) {
        self.write_u64(self.parser.output.data_member_count);
        transition self.parser.output.data_member_count > 0 {
            true -> parse_data_member(0)
            _ -> parse_field_count()
        }
    }

    state parse_data_member(&mut self, index: u64 [0..=1023]) {
        let member: DataMember = self.parser.output.data_members[index];
        transition member.kind {
            DataMemberKind::Field -> parse_data_member_kind(member, index, 1)
            DataMemberKind::Case -> parse_data_member_kind(member, index, 2)
        }
    }

    state parse_data_member_kind(
        &mut self,
        member: DataMember,
        index: u64 [0..=1023],
        kind: u8
    ) {
        self.write_byte(kind);
        self.write_u64(member.item_index);
        self.write_u64(member.source_span.source.value as u64);
        self.write_u64(member.source_span.span.start);
        self.write_u64(member.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.data_member_count {
            true -> parse_data_member_bound(next)
            _ -> parse_field_count()
        }
    }

    state parse_data_member_bound(&mut self, next: u64) {
        transition next < 1024 {
            true -> parse_data_member(next)
            _ -> parse_field_count()
        }
    }

    state parse_field_count(&mut self) {
        self.write_u64(self.parser.output.field_count);
        transition self.parser.output.field_count > 0 {
            true -> parse_field(0)
            _ -> parse_case_count()
        }
    }

    state parse_field(&mut self, index: u64 [0..=1023]) {
        let field: DataField = self.parser.output.fields[index];
        self.write_u64(field.name.source_span.source.value as u64);
        self.write_u64(field.name.source_span.span.start);
        self.write_u64(field.name.source_span.span.end);
        self.write_u64(field.type_reference);
        self.write_u64(field.source_span.source.value as u64);
        self.write_u64(field.source_span.span.start);
        self.write_u64(field.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.field_count {
            true -> parse_field_bound(next)
            _ -> parse_payload_field_count()
        }
    }

    state parse_field_bound(&mut self, next: u64) {
        transition next < 1024 {
            true -> parse_field(next)
            _ -> parse_payload_field_count()
        }
    }

    state parse_payload_field_count(&mut self) {
        self.write_u64(self.parser.output.payload_field_count);
        transition self.parser.output.payload_field_count > 0 {
            true -> parse_payload_field(0)
            _ -> parse_case_count()
        }
    }

    state parse_payload_field(&mut self, index: u64 [0..=1023]) {
        let field: DataField = self.parser.output.payload_fields[index];
        self.write_u64(field.name.source_span.source.value as u64);
        self.write_u64(field.name.source_span.span.start);
        self.write_u64(field.name.source_span.span.end);
        self.write_u64(field.type_reference);
        self.write_u64(field.source_span.source.value as u64);
        self.write_u64(field.source_span.span.start);
        self.write_u64(field.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.payload_field_count {
            true -> parse_payload_field_bound(next)
            _ -> parse_case_count()
        }
    }

    state parse_payload_field_bound(&mut self, next: u64) {
        transition next < 1024 {
            true -> parse_payload_field(next)
            _ -> parse_case_count()
        }
    }

    state parse_case_count(&mut self) {
        self.write_u64(self.parser.output.case_count);
        transition self.parser.output.case_count > 0 {
            true -> parse_case(0)
            _ -> parse_type_reference_count()
        }
    }

    state parse_case(&mut self, index: u64 [0..=511]) {
        let data_case: DataCase = self.parser.output.cases[index];
        self.write_u64(data_case.name.source_span.source.value as u64);
        self.write_u64(data_case.name.source_span.span.start);
        self.write_u64(data_case.name.source_span.span.end);
        self.write_u64(data_case.source_span.source.value as u64);
        self.write_u64(data_case.source_span.span.start);
        self.write_u64(data_case.source_span.span.end);
        self.write_u64(data_case.first_payload_field);
        self.write_u64(data_case.payload_field_count);
        let next: u64 = index + 1;
        transition next < self.parser.output.case_count {
            true -> parse_case_bound(next)
            _ -> parse_type_reference_count()
        }
    }

    state parse_case_bound(&mut self, next: u64) {
        transition next < 512 {
            true -> parse_case(next)
            _ -> parse_type_reference_count()
        }
    }

    state parse_type_reference_count(&mut self) {
        self.write_u64(self.parser.output.type_reference_count);
        transition self.parser.output.type_reference_count > 0 {
            true -> parse_type_reference(0)
            _ -> parse_done()
        }
    }

    state parse_type_reference(&mut self, index: u64 [0..=1023]) {
        let type_reference: TypeReference =
            self.parser.output.type_references[index];
        transition type_reference.kind {
            TypeReferenceKind::Named -> parse_named_type_reference(type_reference, index)
            TypeReferenceKind::Qualified -> parse_qualified_type_reference(
                type_reference,
                index
            )
        }
    }

    state parse_qualified_type_reference(
        &mut self,
        type_reference: TypeReference,
        index: u64 [0..=1023]
    ) {
        self.write_byte(2);
        self.write_u64(type_reference.name.source_span.source.value as u64);
        self.write_u64(type_reference.name.source_span.span.start);
        self.write_u64(type_reference.name.source_span.span.end);
        self.write_u64(type_reference.source_span.source.value as u64);
        self.write_u64(type_reference.source_span.span.start);
        self.write_u64(type_reference.source_span.span.end);
        self.write_byte(1);
        self.write_u64(type_reference.domain.source_span.source.value as u64);
        self.write_u64(type_reference.domain.source_span.span.start);
        self.write_u64(type_reference.domain.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.type_reference_count {
            true -> parse_type_reference_bound(next)
            _ -> parse_done()
        }
    }

    state parse_named_type_reference(
        &mut self,
        type_reference: TypeReference,
        index: u64 [0..=1023]
    ) {
        self.write_byte(1);
        self.write_u64(type_reference.name.source_span.source.value as u64);
        self.write_u64(type_reference.name.source_span.span.start);
        self.write_u64(type_reference.name.source_span.span.end);
        self.write_u64(type_reference.source_span.source.value as u64);
        self.write_u64(type_reference.source_span.span.start);
        self.write_u64(type_reference.source_span.span.end);
        self.write_byte(0);
        self.write_u64(0);
        self.write_u64(0);
        self.write_u64(0);
        let next: u64 = index + 1;
        transition next < self.parser.output.type_reference_count {
            true -> parse_type_reference_bound(next)
            _ -> parse_done()
        }
    }

    state parse_type_reference_bound(&mut self, next: u64) {
        transition next < 1024 {
            true -> parse_type_reference(next)
            _ -> parse_generic_count()
        }
    }

    state parse_generic_count(&mut self) {
        self.write_u64(self.parser.output.generic_parameter_count);
        transition self.parser.output.generic_parameter_count > 0 {
            true -> parse_generic_parameter(0)
            _ -> parse_done()
        }
    }

    state parse_generic_parameter(&mut self, index: u64 [0..=255]) {
        let parameter: GenericParameter = self.parser.output.generic_parameters[index];
        transition parameter.kind {
            GenericParameterKind::Lifetime -> parse_generic_parameter_kind(parameter, index, 1)
            GenericParameterKind::Type -> parse_generic_parameter_kind(parameter, index, 2)
            GenericParameterKind::Const -> parse_generic_parameter_kind(parameter, index, 3)
            GenericParameterKind::Value -> parse_generic_parameter_kind(parameter, index, 4)
            GenericParameterKind::Machine -> parse_generic_parameter_kind(parameter, index, 5)
        }
    }

    state parse_generic_parameter_kind(
        &mut self,
        parameter: GenericParameter,
        index: u64 [0..=255],
        kind: u8
    ) {
        self.write_byte(kind);
        transition { _ -> parse_generic_parameter_name(parameter, index) }
    }

    state parse_generic_parameter_name(
        &mut self,
        parameter: GenericParameter,
        index: u64 [0..=255]
    ) {
        self.write_u64(parameter.name.source_span.source.value as u64);
        self.write_u64(parameter.name.source_span.span.start);
        self.write_u64(parameter.name.source_span.span.end);
        transition parameter.has_type_reference {
            true -> parse_generic_parameter_typed(parameter, index)
            _ -> parse_generic_parameter_untyped(parameter, index)
        }
    }

    state parse_generic_parameter_typed(
        &mut self,
        parameter: GenericParameter,
        index: u64 [0..=255]
    ) {
        self.write_byte(1);
        self.write_u64(parameter.type_reference);
        transition { _ -> parse_generic_parameter_bounds(parameter, index) }
    }

    state parse_generic_parameter_untyped(
        &mut self,
        parameter: GenericParameter,
        index: u64 [0..=255]
    ) {
        self.write_byte(0);
        self.write_u64(0);
        transition { _ -> parse_generic_parameter_bounds(parameter, index) }
    }

    state parse_generic_parameter_bounds(
        &mut self,
        parameter: GenericParameter,
        index: u64 [0..=255]
    ) {
        transition parameter.bounds {
            DataMultiplicity::Affine -> parse_generic_parameter_bounded(parameter, index, 0)
            DataMultiplicity::Unrestricted -> parse_generic_parameter_bounded(parameter, index, 1)
            DataMultiplicity::Linear -> parse_generic_parameter_bounded(parameter, index, 2)
        }
    }

    state parse_generic_parameter_bounded(
        &mut self,
        parameter: GenericParameter,
        index: u64 [0..=255],
        bounds: u8
    ) {
        self.write_byte(bounds);
        self.write_u64(parameter.source_span.source.value as u64);
        self.write_u64(parameter.source_span.span.start);
        self.write_u64(parameter.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.generic_parameter_count {
            true -> parse_generic_parameter_bound(next)
            _ -> parse_done()
        }
    }

    state parse_generic_parameter_bound(&mut self, next: u64) {
        transition next < 256 {
            true -> parse_generic_parameter(next)
            _ -> parse_done()
        }
    }

    state parse_done(&mut self) { }
}

machine ParserHarness::write_u64(&mut self, value: u64 in Trapping) reaches Console {
    self.write_byte((value % 256) as u8);
    self.write_byte((value / 256 % 256) as u8);
    self.write_byte((value / 65536 % 256) as u8);
    self.write_byte((value / 16777216 % 256) as u8);
    self.write_byte((value / 4294967296 % 256) as u8);
    self.write_byte((value / 1099511627776 % 256) as u8);
    self.write_byte((value / 281474976710656 % 256) as u8);
    self.write_byte((value / 72057594037927936 % 256) as u8);
}

machine ParserHarness::write_byte(&mut self, value: u8) reaches Console {
    let mut output: u8 = value;
    self.console.write_byte(output as i32);
}
