// Gate-owned black-box lexer/parser harness. It lives in the gate package so
// the gate's build root can bind `ParserHarness::main` as its own product
// entry; the product compiler closure under `source/psi` never includes it.

use omega_language_std::console;
use omega::language::core::binding;
use psi::lex::lexer;
use psi::parse::parser;
use psi::syntax::syntax;

pub data ParserHarness {
    console: Binding<Console>;
    lexer: Lexer;
    parser: Parser;
}

pub machine ParserHarness::main(&mut self)
reaches Console
invokes Console;
crashes Trap
blocks;
{
    Lexer::initialize(&mut self.lexer, 1);
    transition { _ -> read() }

    state read(&mut self) {
        let input: ByteRead = block self.console.read_byte();
        transition input {
            ByteRead::Byte { value } -> retain(value)
            _ -> tokenize()
        }
    }

    state retain(&mut self, value: i32) {
        Lexer::append_source_byte(&mut self.lexer, value as u8);
        transition self.lexer.source.last_retained {
            true -> read()
            _ -> source_full()
        }
    }

    state source_full(&mut self) {
        // The rejection span is read before the lexer is borrowed mutably:
        // a call's mutable receiver cannot overlap an argument read.
        let length: u64 [0..=65536] = self.lexer.source.length;
        Lexer::reject(&mut self.lexer, LexDiagnosticCode::SourceCapacityExceeded,
            length as u64 in Trapping,
            length as u64 in Trapping
        );
        self.console.exit_process(252);
    }

    state tokenize(&mut self) {
        Lexer::tokenize(&mut self.lexer);
        transition self.lexer.output.accepted {
            true -> prepare_parse()
            _ -> rejected()
        }
    }

    state prepare_parse(&mut self) {
        Parser::initialize(&mut self.parser, self.lexer.source.id,
            self.lexer.source.length as u64 in Trapping
        );
        transition { _ -> parse() }
    }

    state parse(&mut self) {
        Parser::parse(&mut self.parser, &self.lexer.output);
        transition self.parser.output.accepted {
            true -> accepted()
            _ -> parse_rejected()
        }
    }

    state accepted(&mut self) {
        ParserHarness::write_parse_observation(&mut self);
        self.console.exit_process(0);
    }

    state parse_rejected(&mut self) {
        ParserHarness::write_parse_observation(&mut self);
        self.console.exit_process(250);
    }

    state rejected(&mut self) {
        self.console.exit_process(251);
    }
}

// Versioned canonical structural parse observation. Every scalar coordinate
// and count is little-endian u64. The stream begins with `OMGPAR8\0`, version
// 8, acceptance and diagnostic fields, followed by ordered root, use-item,
// path-member, data-item, authored data-member, direct data-field, case-payload
// field, data-case, type-reference, and generic-parameter tables.
// Type-reference rows append a qualified flag and the domain coordinates
// (zeros for bare named types). Data-item rows end with the item's
// generic-parameter base and count, and generic-parameter rows carry kind,
// name, optional type-reference handle, bounds, and span. This is hosted
// development tooling, not an Omega ABI.
machine ParserHarness::write_parse_observation(parser_harness: &mut ParserHarness) reaches Console {
    ParserHarness::write_byte(parser_harness, 79);
    ParserHarness::write_byte(parser_harness, 77);
    ParserHarness::write_byte(parser_harness, 71);
    ParserHarness::write_byte(parser_harness, 80);
    ParserHarness::write_byte(parser_harness, 65);
    ParserHarness::write_byte(parser_harness, 82);
    ParserHarness::write_byte(parser_harness, 56);
    ParserHarness::write_byte(parser_harness, 0);
    ParserHarness::write_u64(parser_harness, 8);
    transition parser_harness.parser.output.accepted {
        true -> parse_accepted_header(parser_harness)
        _ -> parse_rejected_header(parser_harness)
    }

    state parse_accepted_header(parser_harness: &mut ParserHarness) {
        ParserHarness::write_byte(parser_harness, 1);
        transition { _ -> parse_diagnostic_none(parser_harness) }
    }

    state parse_rejected_header(parser_harness: &mut ParserHarness) {
        ParserHarness::write_byte(parser_harness, 0);
        transition parser_harness.parser.output.diagnostic.code {
            ParseDiagnosticCode::None -> parse_diagnostic_none(parser_harness)
            ParseDiagnosticCode::LexicalInputRejected -> parse_diagnostic(parser_harness, 1)
            ParseDiagnosticCode::UnsupportedRootItem -> parse_diagnostic(parser_harness, 2)
            ParseDiagnosticCode::ExpectedPathMember -> parse_diagnostic(parser_harness, 3)
            ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon -> parse_diagnostic(parser_harness, 4)
            ParseDiagnosticCode::RootCapacityExceeded -> parse_diagnostic(parser_harness, 5)
            ParseDiagnosticCode::UseCapacityExceeded -> parse_diagnostic(parser_harness, 6)
            ParseDiagnosticCode::PathMemberCapacityExceeded -> parse_diagnostic(parser_harness, 7)
            ParseDiagnosticCode::TokenInputCapacityExceeded -> parse_diagnostic(parser_harness, 8)
            ParseDiagnosticCode::ExpectedDataAfterPub -> parse_diagnostic(parser_harness, 9)
            ParseDiagnosticCode::ExpectedDataName -> parse_diagnostic(parser_harness, 10)
            ParseDiagnosticCode::ExpectedDataBody -> parse_diagnostic(parser_harness, 11)
            ParseDiagnosticCode::ExpectedDataFieldColon -> parse_diagnostic(parser_harness, 12)
            ParseDiagnosticCode::ExpectedDataFieldType -> parse_diagnostic(parser_harness, 13)
            ParseDiagnosticCode::ExpectedDataFieldEnd -> parse_diagnostic(parser_harness, 14)
            ParseDiagnosticCode::DataCapacityExceeded -> parse_diagnostic(parser_harness, 15)
            ParseDiagnosticCode::DataFieldCapacityExceeded -> parse_diagnostic(parser_harness, 16)
            ParseDiagnosticCode::TypeReferenceCapacityExceeded -> parse_diagnostic(parser_harness, 17)
            ParseDiagnosticCode::ExpectedDataProperty -> parse_diagnostic(parser_harness, 18)
            ParseDiagnosticCode::ExpectedDataPropertyEnd -> parse_diagnostic(parser_harness, 19)
            ParseDiagnosticCode::ExpectedDataCaseName -> parse_diagnostic(parser_harness, 20)
            ParseDiagnosticCode::ExpectedDataCaseEnd -> parse_diagnostic(parser_harness, 21)
            ParseDiagnosticCode::DataMemberCapacityExceeded -> parse_diagnostic(parser_harness, 22)
            ParseDiagnosticCode::DataCaseCapacityExceeded -> parse_diagnostic(parser_harness, 23)
            ParseDiagnosticCode::ExpectedDataCasePayloadField -> parse_diagnostic(parser_harness, 24)
            ParseDiagnosticCode::ExpectedDataCasePayloadFieldColon -> parse_diagnostic(parser_harness, 25)
            ParseDiagnosticCode::ExpectedDataCasePayloadFieldType -> parse_diagnostic(parser_harness, 26)
            ParseDiagnosticCode::ExpectedDataCasePayloadSeparatorOrEnd -> parse_diagnostic(parser_harness, 27)
            ParseDiagnosticCode::DataCasePayloadFieldCapacityExceeded -> parse_diagnostic(parser_harness, 28)
            ParseDiagnosticCode::DuplicateDataMultiplicity -> parse_diagnostic(parser_harness, 29)
            ParseDiagnosticCode::ConflictingDataMultiplicity -> parse_diagnostic(parser_harness, 30)
            ParseDiagnosticCode::ExpectedTypeQualifierDomain -> parse_diagnostic(parser_harness, 31)
            ParseDiagnosticCode::ExpectedDataGenericParameter -> parse_diagnostic(parser_harness, 32)
            ParseDiagnosticCode::ExpectedDataGenericParameterName -> parse_diagnostic(parser_harness, 33)
            ParseDiagnosticCode::ExpectedDataGenericParameterColon -> parse_diagnostic(parser_harness, 34)
            ParseDiagnosticCode::ExpectedDataGenericParameterType -> parse_diagnostic(parser_harness, 35)
            ParseDiagnosticCode::ExpectedDataGenericParameterEnd -> parse_diagnostic(parser_harness, 36)
            ParseDiagnosticCode::DataGenericParameterCapacityExceeded -> parse_diagnostic(parser_harness, 37)
            ParseDiagnosticCode::DataGenericLifetimeOrdering -> parse_diagnostic(parser_harness, 38)
            ParseDiagnosticCode::DuplicateDataGenericParameter -> parse_diagnostic(parser_harness, 39)
        }
    }

    state parse_diagnostic_none(parser_harness: &mut ParserHarness) {
        ParserHarness::write_byte(parser_harness, 0);
        transition { _ -> parse_diagnostic_coordinates(parser_harness) }
    }

    state parse_diagnostic(parser_harness: &mut ParserHarness, tag: u8) {
        ParserHarness::write_byte(parser_harness, tag);
        transition { _ -> parse_diagnostic_coordinates(parser_harness) }
    }

    state parse_diagnostic_coordinates(parser_harness: &mut ParserHarness) {
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.diagnostic.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.diagnostic.source_span.span.start);
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.diagnostic.source_span.span.end);
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.root_count as u64 in Trapping);
        transition parser_harness.parser.output.root_count > 0 {
            true -> parse_root(parser_harness, 0)
            _ -> parse_use_count(parser_harness)
        }
    }

    state parse_root(parser_harness: &mut ParserHarness, index: u64 [0..=255]) {
        let root: RootItem = parser_harness.parser.output.roots[index];
        transition root.kind {
            RootItemKind::Use -> parse_root_use(parser_harness, root, index)
            RootItemKind::Data -> parse_root_data(parser_harness, root, index)
        }
    }

    state parse_root_use(
        parser_harness: &mut ParserHarness,
        root: RootItem,
        index: u64 [0..=255]
    ) {
        ParserHarness::write_byte(parser_harness, 1);
        ParserHarness::write_u64(parser_harness, root.item_index);
        ParserHarness::write_u64(parser_harness, root.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, root.source_span.span.start);
        ParserHarness::write_u64(parser_harness, root.source_span.span.end);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.root_count {
            true -> parse_root_bound(parser_harness, next)
            _ -> parse_use_count(parser_harness)
        }
    }

    state parse_root_data(
        parser_harness: &mut ParserHarness,
        root: RootItem,
        index: u64 [0..=255]
    ) {
        ParserHarness::write_byte(parser_harness, 2);
        ParserHarness::write_u64(parser_harness, root.item_index);
        ParserHarness::write_u64(parser_harness, root.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, root.source_span.span.start);
        ParserHarness::write_u64(parser_harness, root.source_span.span.end);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.root_count {
            true -> parse_root_bound(parser_harness, next)
            _ -> parse_use_count(parser_harness)
        }
    }

    state parse_root_bound(parser_harness: &mut ParserHarness, next: u64) {
        transition next < 256 {
            true -> parse_root(parser_harness, next)
            _ -> parse_use_count(parser_harness)
        }
    }

    state parse_use_count(parser_harness: &mut ParserHarness) {
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.use_count as u64 in Trapping);
        transition parser_harness.parser.output.use_count > 0 {
            true -> parse_use_item(parser_harness, 0)
            _ -> parse_member_count(parser_harness)
        }
    }

    state parse_use_item(parser_harness: &mut ParserHarness, index: u64 [0..=255]) {
        let item: UseItem = parser_harness.parser.output.uses[index];
        ParserHarness::write_u64(parser_harness, item.first_member);
        ParserHarness::write_u64(parser_harness, item.member_count as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, item.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, item.source_span.span.start);
        ParserHarness::write_u64(parser_harness, item.source_span.span.end);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.use_count {
            true -> parse_use_bound(parser_harness, next)
            _ -> parse_member_count(parser_harness)
        }
    }

    state parse_use_bound(parser_harness: &mut ParserHarness, next: u64) {
        transition next < 256 {
            true -> parse_use_item(parser_harness, next)
            _ -> parse_member_count(parser_harness)
        }
    }

    state parse_member_count(parser_harness: &mut ParserHarness) {
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.member_count as u64 in Trapping);
        transition parser_harness.parser.output.member_count > 0 {
            true -> parse_member(parser_harness, 0)
            _ -> parse_data_count(parser_harness)
        }
    }

    state parse_member(parser_harness: &mut ParserHarness, index: u64 [0..=1023]) {
        let member: IdentifierSpan = parser_harness.parser.output.members[index];
        ParserHarness::write_u64(parser_harness, member.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, member.source_span.span.start);
        ParserHarness::write_u64(parser_harness, member.source_span.span.end);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.member_count {
            true -> parse_member_bound(parser_harness, next)
            _ -> parse_data_count(parser_harness)
        }
    }

    state parse_member_bound(parser_harness: &mut ParserHarness, next: u64) {
        transition next < 1024 {
            true -> parse_member(parser_harness, next)
            _ -> parse_data_count(parser_harness)
        }
    }

    state parse_data_count(parser_harness: &mut ParserHarness) {
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.data_count as u64 in Trapping);
        transition parser_harness.parser.output.data_count > 0 {
            true -> parse_data_item(parser_harness, 0)
            _ -> parse_data_member_count(parser_harness)
        }
    }

    state parse_data_item(parser_harness: &mut ParserHarness, index: u64 [0..=255]) {
        let item: DataItem = parser_harness.parser.output.data_items[index];
        ParserHarness::write_u64(parser_harness, item.name.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, item.name.source_span.span.start);
        ParserHarness::write_u64(parser_harness, item.name.source_span.span.end);
        ParserHarness::write_u64(parser_harness, item.first_member);
        ParserHarness::write_u64(parser_harness, item.member_count as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, item.first_field);
        ParserHarness::write_u64(parser_harness, item.field_count as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, item.first_case);
        ParserHarness::write_u64(parser_harness, item.case_count as u64 in Trapping);
        transition item.multiplicity {
            DataMultiplicity::Affine -> parse_data_multiplicity(parser_harness, item, index, 0)
            DataMultiplicity::Unrestricted -> parse_data_multiplicity(parser_harness, item, index, 1)
            DataMultiplicity::Linear -> parse_data_multiplicity(parser_harness, item, index, 2)
        }
    }

    state parse_data_multiplicity(
        parser_harness: &mut ParserHarness,
        item: DataItem,
        index: u64 [0..=255],
        multiplicity: u8
    ) {
        ParserHarness::write_byte(parser_harness, multiplicity);
        transition item.is_public {
            true -> parse_data_public(parser_harness, item, index)
            _ -> parse_data_private(parser_harness, item, index)
        }
    }

    state parse_data_public(
        parser_harness: &mut ParserHarness,
        item: DataItem,
        index: u64 [0..=255]
    ) {
        ParserHarness::write_byte(parser_harness, 1);
        transition { _ -> parse_data_span(parser_harness, item, index) }
    }

    state parse_data_private(
        parser_harness: &mut ParserHarness,
        item: DataItem,
        index: u64 [0..=255]
    ) {
        ParserHarness::write_byte(parser_harness, 0);
        transition { _ -> parse_data_span(parser_harness, item, index) }
    }

    state parse_data_span(
        parser_harness: &mut ParserHarness,
        item: DataItem,
        index: u64 [0..=255]
    ) {
        ParserHarness::write_u64(parser_harness, item.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, item.source_span.span.start);
        ParserHarness::write_u64(parser_harness, item.source_span.span.end);
        ParserHarness::write_u64(parser_harness, item.first_generic_parameter);
        ParserHarness::write_u64(parser_harness, item.generic_parameter_count as u64 in Trapping);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.data_count {
            true -> parse_data_bound(parser_harness, next)
            _ -> parse_data_member_count(parser_harness)
        }
    }

    state parse_data_bound(parser_harness: &mut ParserHarness, next: u64) {
        transition next < 256 {
            true -> parse_data_item(parser_harness, next)
            _ -> parse_data_member_count(parser_harness)
        }
    }

    state parse_data_member_count(parser_harness: &mut ParserHarness) {
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.data_member_count as u64 in Trapping);
        transition parser_harness.parser.output.data_member_count > 0 {
            true -> parse_data_member(parser_harness, 0)
            _ -> parse_field_count(parser_harness)
        }
    }

    state parse_data_member(parser_harness: &mut ParserHarness, index: u64 [0..=1023]) {
        let member: DataMember = parser_harness.parser.output.data_members[index];
        transition member.kind {
            DataMemberKind::Field -> parse_data_member_kind(parser_harness, member, index, 1)
            DataMemberKind::Case -> parse_data_member_kind(parser_harness, member, index, 2)
        }
    }

    state parse_data_member_kind(
        parser_harness: &mut ParserHarness,
        member: DataMember,
        index: u64 [0..=1023],
        kind: u8
    ) {
        ParserHarness::write_byte(parser_harness, kind);
        ParserHarness::write_u64(parser_harness, member.item_index);
        ParserHarness::write_u64(parser_harness, member.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, member.source_span.span.start);
        ParserHarness::write_u64(parser_harness, member.source_span.span.end);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.data_member_count {
            true -> parse_data_member_bound(parser_harness, next)
            _ -> parse_field_count(parser_harness)
        }
    }

    state parse_data_member_bound(parser_harness: &mut ParserHarness, next: u64) {
        transition next < 1024 {
            true -> parse_data_member(parser_harness, next)
            _ -> parse_field_count(parser_harness)
        }
    }

    state parse_field_count(parser_harness: &mut ParserHarness) {
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.field_count as u64 in Trapping);
        transition parser_harness.parser.output.field_count > 0 {
            true -> parse_field(parser_harness, 0)
            _ -> parse_case_count(parser_harness)
        }
    }

    state parse_field(parser_harness: &mut ParserHarness, index: u64 [0..=1023]) {
        let field: DataField = parser_harness.parser.output.fields[index];
        ParserHarness::write_u64(parser_harness, field.name.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, field.name.source_span.span.start);
        ParserHarness::write_u64(parser_harness, field.name.source_span.span.end);
        ParserHarness::write_u64(parser_harness, field.type_reference);
        ParserHarness::write_u64(parser_harness, field.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, field.source_span.span.start);
        ParserHarness::write_u64(parser_harness, field.source_span.span.end);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.field_count {
            true -> parse_field_bound(parser_harness, next)
            _ -> parse_payload_field_count(parser_harness)
        }
    }

    state parse_field_bound(parser_harness: &mut ParserHarness, next: u64) {
        transition next < 1024 {
            true -> parse_field(parser_harness, next)
            _ -> parse_payload_field_count(parser_harness)
        }
    }

    state parse_payload_field_count(parser_harness: &mut ParserHarness) {
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.payload_field_count as u64 in Trapping);
        transition parser_harness.parser.output.payload_field_count > 0 {
            true -> parse_payload_field(parser_harness, 0)
            _ -> parse_case_count(parser_harness)
        }
    }

    state parse_payload_field(parser_harness: &mut ParserHarness, index: u64 [0..=1023]) {
        let field: DataField = parser_harness.parser.output.payload_fields[index];
        ParserHarness::write_u64(parser_harness, field.name.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, field.name.source_span.span.start);
        ParserHarness::write_u64(parser_harness, field.name.source_span.span.end);
        ParserHarness::write_u64(parser_harness, field.type_reference);
        ParserHarness::write_u64(parser_harness, field.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, field.source_span.span.start);
        ParserHarness::write_u64(parser_harness, field.source_span.span.end);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.payload_field_count {
            true -> parse_payload_field_bound(parser_harness, next)
            _ -> parse_case_count(parser_harness)
        }
    }

    state parse_payload_field_bound(parser_harness: &mut ParserHarness, next: u64) {
        transition next < 1024 {
            true -> parse_payload_field(parser_harness, next)
            _ -> parse_case_count(parser_harness)
        }
    }

    state parse_case_count(parser_harness: &mut ParserHarness) {
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.case_count as u64 in Trapping);
        transition parser_harness.parser.output.case_count > 0 {
            true -> parse_case(parser_harness, 0)
            _ -> parse_type_reference_count(parser_harness)
        }
    }

    state parse_case(parser_harness: &mut ParserHarness, index: u64 [0..=511]) {
        let data_case: DataCase = parser_harness.parser.output.cases[index];
        ParserHarness::write_u64(parser_harness, data_case.name.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, data_case.name.source_span.span.start);
        ParserHarness::write_u64(parser_harness, data_case.name.source_span.span.end);
        ParserHarness::write_u64(parser_harness, data_case.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, data_case.source_span.span.start);
        ParserHarness::write_u64(parser_harness, data_case.source_span.span.end);
        ParserHarness::write_u64(parser_harness, data_case.first_payload_field);
        ParserHarness::write_u64(parser_harness, data_case.payload_field_count as u64 in Trapping);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.case_count {
            true -> parse_case_bound(parser_harness, next)
            _ -> parse_type_reference_count(parser_harness)
        }
    }

    state parse_case_bound(parser_harness: &mut ParserHarness, next: u64) {
        transition next < 512 {
            true -> parse_case(parser_harness, next)
            _ -> parse_type_reference_count(parser_harness)
        }
    }

    state parse_type_reference_count(parser_harness: &mut ParserHarness) {
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.type_reference_count as u64 in Trapping);
        transition parser_harness.parser.output.type_reference_count > 0 {
            true -> parse_type_reference(parser_harness, 0)
            _ -> parse_done()
        }
    }

    state parse_type_reference(parser_harness: &mut ParserHarness, index: u64 [0..=1023]) {
        let type_reference: TypeReference =
            parser_harness.parser.output.type_references[index];
        transition type_reference.kind {
            TypeReferenceKind::Named -> parse_named_type_reference(parser_harness, type_reference, index)
            TypeReferenceKind::Qualified -> parse_qualified_type_reference(parser_harness, type_reference,
                index
            )
        }
    }

    state parse_qualified_type_reference(
        parser_harness: &mut ParserHarness,
        type_reference: TypeReference,
        index: u64 [0..=1023]
    ) {
        ParserHarness::write_byte(parser_harness, 2);
        ParserHarness::write_u64(parser_harness, type_reference.name.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, type_reference.name.source_span.span.start);
        ParserHarness::write_u64(parser_harness, type_reference.name.source_span.span.end);
        ParserHarness::write_u64(parser_harness, type_reference.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, type_reference.source_span.span.start);
        ParserHarness::write_u64(parser_harness, type_reference.source_span.span.end);
        ParserHarness::write_byte(parser_harness, 1);
        ParserHarness::write_u64(parser_harness, type_reference.domain.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, type_reference.domain.source_span.span.start);
        ParserHarness::write_u64(parser_harness, type_reference.domain.source_span.span.end);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.type_reference_count {
            true -> parse_type_reference_bound(parser_harness, next)
            _ -> parse_done()
        }
    }

    state parse_named_type_reference(
        parser_harness: &mut ParserHarness,
        type_reference: TypeReference,
        index: u64 [0..=1023]
    ) {
        ParserHarness::write_byte(parser_harness, 1);
        ParserHarness::write_u64(parser_harness, type_reference.name.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, type_reference.name.source_span.span.start);
        ParserHarness::write_u64(parser_harness, type_reference.name.source_span.span.end);
        ParserHarness::write_u64(parser_harness, type_reference.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, type_reference.source_span.span.start);
        ParserHarness::write_u64(parser_harness, type_reference.source_span.span.end);
        ParserHarness::write_byte(parser_harness, 0);
        ParserHarness::write_u64(parser_harness, 0);
        ParserHarness::write_u64(parser_harness, 0);
        ParserHarness::write_u64(parser_harness, 0);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.type_reference_count {
            true -> parse_type_reference_bound(parser_harness, next)
            _ -> parse_done()
        }
    }

    state parse_type_reference_bound(parser_harness: &mut ParserHarness, next: u64) {
        transition next < 1024 {
            true -> parse_type_reference(parser_harness, next)
            _ -> parse_generic_count(parser_harness)
        }
    }

    state parse_generic_count(parser_harness: &mut ParserHarness) {
        ParserHarness::write_u64(parser_harness, parser_harness.parser.output.generic_parameter_count as u64 in Trapping);
        transition parser_harness.parser.output.generic_parameter_count > 0 {
            true -> parse_generic_parameter(parser_harness, 0)
            _ -> parse_done()
        }
    }

    state parse_generic_parameter(parser_harness: &mut ParserHarness, index: u64 [0..=255]) {
        let parameter: GenericParameter = parser_harness.parser.output.generic_parameters[index];
        transition parameter.kind {
            GenericParameterKind::Lifetime -> parse_generic_parameter_kind(parser_harness, parameter, index, 1)
            GenericParameterKind::Type -> parse_generic_parameter_kind(parser_harness, parameter, index, 2)
            GenericParameterKind::Const -> parse_generic_parameter_kind(parser_harness, parameter, index, 3)
            GenericParameterKind::Value -> parse_generic_parameter_kind(parser_harness, parameter, index, 4)
            GenericParameterKind::Machine -> parse_generic_parameter_kind(parser_harness, parameter, index, 5)
        }
    }

    state parse_generic_parameter_kind(
        parser_harness: &mut ParserHarness,
        parameter: GenericParameter,
        index: u64 [0..=255],
        kind: u8
    ) {
        ParserHarness::write_byte(parser_harness, kind);
        transition { _ -> parse_generic_parameter_name(parser_harness, parameter, index) }
    }

    state parse_generic_parameter_name(
        parser_harness: &mut ParserHarness,
        parameter: GenericParameter,
        index: u64 [0..=255]
    ) {
        ParserHarness::write_u64(parser_harness, parameter.name.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, parameter.name.source_span.span.start);
        ParserHarness::write_u64(parser_harness, parameter.name.source_span.span.end);
        transition parameter.has_type_reference {
            true -> parse_generic_parameter_typed(parser_harness, parameter, index)
            _ -> parse_generic_parameter_untyped(parser_harness, parameter, index)
        }
    }

    state parse_generic_parameter_typed(
        parser_harness: &mut ParserHarness,
        parameter: GenericParameter,
        index: u64 [0..=255]
    ) {
        ParserHarness::write_byte(parser_harness, 1);
        ParserHarness::write_u64(parser_harness, parameter.type_reference);
        transition { _ -> parse_generic_parameter_bounds(parser_harness, parameter, index) }
    }

    state parse_generic_parameter_untyped(
        parser_harness: &mut ParserHarness,
        parameter: GenericParameter,
        index: u64 [0..=255]
    ) {
        ParserHarness::write_byte(parser_harness, 0);
        ParserHarness::write_u64(parser_harness, 0);
        transition { _ -> parse_generic_parameter_bounds(parser_harness, parameter, index) }
    }

    state parse_generic_parameter_bounds(parser_harness: &mut ParserHarness, parameter: GenericParameter,
        index: u64 [0..=255]
    ) {
        transition parameter.bounds {
            DataMultiplicity::Affine -> parse_generic_parameter_bounded(parser_harness, parameter, index, 0)
            DataMultiplicity::Unrestricted -> parse_generic_parameter_bounded(parser_harness, parameter, index, 1)
            DataMultiplicity::Linear -> parse_generic_parameter_bounded(parser_harness, parameter, index, 2)
        }
    }

    state parse_generic_parameter_bounded(
        parser_harness: &mut ParserHarness,
        parameter: GenericParameter,
        index: u64 [0..=255],
        bounds: u8
    ) {
        ParserHarness::write_byte(parser_harness, bounds);
        ParserHarness::write_u64(parser_harness, parameter.source_span.source.value as u64 in Trapping);
        ParserHarness::write_u64(parser_harness, parameter.source_span.span.start);
        ParserHarness::write_u64(parser_harness, parameter.source_span.span.end);
        let next: u64 = index + 1;
        transition next < parser_harness.parser.output.generic_parameter_count {
            true -> parse_generic_parameter_bound(parser_harness, next)
            _ -> parse_done()
        }
    }

    state parse_generic_parameter_bound(parser_harness: &mut ParserHarness, next: u64) {
        transition next < 256 {
            true -> parse_generic_parameter(parser_harness, next)
            _ -> parse_done()
        }
    }

    state parse_done() { }
}

machine ParserHarness::write_u64(parser_harness: &mut ParserHarness, value: u64 in Trapping) reaches Console {
    ParserHarness::write_byte(parser_harness, (value % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 256 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 65536 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 16777216 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 4294967296 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 1099511627776 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 281474976710656 % 256) as u8);
    ParserHarness::write_byte(parser_harness, (value / 72057594037927936 % 256) as u8);
}

machine ParserHarness::write_byte(parser_harness: &mut ParserHarness, value: u8) reaches Console {
    let mut output: u8 = value;
    parser_harness.console.write_byte(output as i32);
}
