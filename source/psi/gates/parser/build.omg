// The gate receives one exact target from its invocation; these root rows are
// bindings for those profiles, not a source-declared support set.

machine build(builder: &mut Build) {
    Build::application(builder, "psi_parser_gate");
    builder.select_provider<omega_language_std::Console, omega_language_std::ConsoleNativeProvider>();
    Build::bind(builder, windows_x86_64::ProgramEntry, ParserHarness::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, ParserHarness::main);
    Build::bind(builder, linux_arm64::ProgramEntry, ParserHarness::main);
    Build::bind(builder, macos_arm64::ProgramEntry, ParserHarness::main);
    Build::depend(builder, Source::Path {
        location: "../../../library/std"
    });
    Build::depend_as(builder, "psi", Source::Path {
        location: "../.."
    });
}
