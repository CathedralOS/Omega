// The gate receives one exact target from its invocation; these root rows are
// bindings for those profiles, not a source-declared support set.

machine build(builder: &mut Build) {
    builder.application("psi-parser-gate");
    builder.select_provider<Console, ConsoleNativeProvider>();
    builder.roots.bind(windows_x86_64::ProgramEntry, ParserHarness::main);
    builder.roots.bind(linux_x86_64::ProgramEntry, ParserHarness::main);
    builder.roots.bind(linux_arm64::ProgramEntry, ParserHarness::main);
    builder.roots.bind(macos_arm64::ProgramEntry, ParserHarness::main);
    builder.depend(Source::Path {
        location: "../../../library/std"
    });
    builder.depend_as("psi", Source::Path {
        location: "../.."
    });
}
use psi::parse::harness;
