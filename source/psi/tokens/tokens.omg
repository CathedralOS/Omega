use psi::source::source;

// Product token vocabulary for the source-to-token phase. Token spans index
// the source unit; word tokens (identifiers and keywords) and cooked string
// tokens additionally retain their exact decoded byte range in
// TokenStream::decoded. LEXICAL-PROFILE-V1 admits
// only ASCII syntax; non-ASCII bytes remain opaque inside comments and literal
// bodies.

public data NumericBase [copy] {
    case Binary;
    case Octal;
    case Decimal;
    case Hexadecimal;
}

public data KeywordKind [copy] {
    case As;
    case CallingConvention;
    case Capability;
    case Contains;
    case Data;
    case Else;
    case False;
    case Foreign;
    case Host;
    case If;
    case Let;
    case Library;
    case Loop;
    case Machine;
    case Match;
    case Owns;
    case Platform;
    case Public;
    case Return;
    case SelfValue;
    case State;
    case Struct;
    case Target;
    case Transition;
    case True;
    case Use;
    case When;
    case While;
    // Contextual declaration words remain valid identifiers outside their
    // exact parser positions; the parser's name-like rule admits them.
    case Case;
    case Copy;
    case Linear;
}

public data PunctuationKind [copy] {
    case Ampersand;
    case AndAnd;
    case Apostrophe;
    case Arrow;
    case Asterisk;
    case Caret;
    case Colon;
    case ColonColon;
    case Comma;
    case Dot;
    case DotDot;
    case DotDotEqual;
    case Equal;
    case EqualEqual;
    case Exclamation;
    case ExclamationEqual;
    case Greater;
    case GreaterEqual;
    case Hash;
    case LeftBrace;
    case LeftBracket;
    case LeftParen;
    case Less;
    case LessEqual;
    case LessLess;
    case Minus;
    case Percent;
    case Pipe;
    case PipePipe;
    case Plus;
    case PlusEqual;
    case MinusEqual;
    case AsteriskEqual;
    case SlashEqual;
    case PercentEqual;
    case RightBrace;
    case RightBracket;
    case RightParen;
    case Semicolon;
    case Slash;
    case Tilde;
}

// The stored token is itself the vocabulary sum. Consumers classify this one
// value directly; no nested kind field or numeric observation projection exists.
public data Token [copy] {
    source: u32 in Trapping;
    start: u64 in Trapping;
    end: u64 in Trapping;
    decoded_start: u64 in Trapping;
    decoded_length: u64 in Trapping;
    case Identifier;
    case Integer(
        base: NumericBase,
        empty_digits: bool,
        has_suffix: bool
    );
    case Float(
        has_exponent: bool,
        empty_exponent: bool,
        has_suffix: bool
    );
    case StringLiteral;
    case Keyword(keyword: KeywordKind);
    case Punctuation(punctuation: PunctuationKind);
}

public data LexDiagnosticCode [copy] {
    case None;
    case InvalidUtf8;
    case OutsideLexicalProfile;
    case UnterminatedBlockComment;
    case UnterminatedStringLiteral;
    case UnterminatedStringEscape;
    case UnsupportedEscape;
    case UnterminatedHexEscape;
    case InvalidHexEscapeDigit;
    case TokenCapacityExceeded;
    case SourceCapacityExceeded;
    case DecodedCapacityExceeded;
}

public data LexDiagnostic [copy] {
    code: LexDiagnosticCode;
    source_span: SourceSpan;
}

public data TokenStream
where
    token_count <= 65536,
    decoded_length <= 131072,
{
    tokens: [Token; 65536] in Trapping;
    token_count: u64;
    decoded: [u8; 131072] in Trapping;
    decoded_length: u64;
    diagnostic: LexDiagnostic;
    accepted: bool;
    last_retained: bool;
}

machine TokenStream::clear(token_stream: &mut TokenStream, source: SourceId) {
    token_stream.token_count = 0;
    token_stream.decoded_length = 0;
    token_stream.accepted = true;
    token_stream.last_retained = true;
    token_stream.diagnostic.code = LexDiagnosticCode::None;
    token_stream.diagnostic.source_span.source = source;
    token_stream.diagnostic.source_span.span.start = 0;
    token_stream.diagnostic.source_span.span.end = 0;
}

machine TokenStream::reject(
    token_stream: &mut TokenStream,
    source: SourceId,
    code: LexDiagnosticCode,
    start: u64 in Trapping,
    end: u64 in Trapping
) {
    token_stream.accepted = false;
    token_stream.diagnostic.code = code;
    token_stream.diagnostic.source_span.source = source;
    token_stream.diagnostic.source_span.span.start = start;
    token_stream.diagnostic.source_span.span.end = end;
}

machine TokenStream::push(
    token_stream: &mut TokenStream,
    token: Token
) {
    token_stream.last_retained = false;
    transition token_stream.token_count < 65536 {
        true -> retain(token_stream, token)
        _ -> full(token_stream)
    }

    machine retain(token_stream: &mut TokenStream, token: Token) {
        token_stream.tokens[token_stream.token_count] = token;
        token_stream.token_count = token_stream.token_count + 1;
        token_stream.last_retained = true;
    }

    machine full(token_stream: &mut TokenStream) {
        token_stream.last_retained = false;
    }
}

machine TokenStream::push_decoded(token_stream: &mut TokenStream, byte: u8) {
    token_stream.last_retained = false;
    transition token_stream.decoded_length < 131072 {
        true -> retain(token_stream, byte)
        _ -> full(token_stream)
    }

    machine retain(token_stream: &mut TokenStream, byte: u8) {
        token_stream.decoded[token_stream.decoded_length] = byte as u8 in Trapping;
        token_stream.decoded_length = token_stream.decoded_length + 1;
        token_stream.last_retained = true;
    }

    machine full(token_stream: &mut TokenStream) {
        token_stream.last_retained = false;
    }
}
