use psi::resolution::resolution;
use psi::resolve::containers;
use psi::resolve::imports;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Domain declarations (wiki/spec/language/domains.md). A domain is
// carrier-qualified: `domain<binders> Carrier::Name<indices>(subject)`. Its
// carrier and index arguments bind in its own generic scope before any other
// type reference, so an `in Name` qualifier anywhere can select by carrier:
// a short name selects the visible domain of that name whose carrier is the
// qualified type, where the domain's own generic parameters stand for any
// type (wiki/spec/language/modules.md#foreign-attached-declaration-paths).
// Two such candidates compete and reject as ambiguous. Alias constituents
// (`= A & C::B`) name domains the same way, a bare one by the alias's own
// carrier; establishment routes (`established by Path`) name a trait
// requirement or an exact machine as a callee would. The predicate facts and
// the subject binder belong to checking, like every other fact.

// Each domain's generic annotations, carrier and index arguments, in its
// own scope.
public machine Resolver::bind_domain_carriers(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0) }

    machine next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.domain_count && resolver.output.accepted {
            true -> carrier(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    machine carrier(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        Resolver::bind_generic_annotations(resolver, sources, syntax, scope);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, item.carrier, TypeRole::Type);
        transition { _ -> argument(resolver, sources, syntax, index, item, scope, 0) }
    }

    machine argument(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: DomainItem, scope: TypeScope, offset: u64 in Trapping) {
        transition offset < item.argument_count && resolver.output.accepted {
            true -> bind_argument(resolver, sources, syntax, index, item, scope, offset)
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine bind_argument(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: DomainItem, scope: TypeScope, offset: u64 in Trapping) {
        let row: u64 in Trapping = SyntaxTrees::type_argument(syntax, item.first_argument + offset);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, row, TypeRole::StaticArgument);
        transition { _ -> argument(resolver, sources, syntax, index, item, scope, offset + 1) }
    }

    machine done() {}
}

// Domain names: none spells a compiler-known domain, and a module declares
// one name over one carrier type once.
public machine Resolver::check_domains(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0) }

    machine next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.domain_count && resolver.output.accepted {
            true -> domain(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    machine domain(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, index);
        let known: DomainBinding = Resolver::known_domain(sources, item.name.source_span);
        transition known {
            DomainBinding::Unqualified -> prior(resolver, sources, syntax, index, item, 0)
            _ -> reject(resolver, ResolveDiagnosticCode::ShadowsBuiltin, item.name)
        }
    }

    machine prior(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: DomainItem, earlier: u64 in Trapping) {
        transition earlier < index {
            true -> compare(resolver, sources, syntax, index, item, earlier)
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: DomainItem, earlier: u64 in Trapping) {
        let earlier_item: DomainItem = SyntaxTrees::domain_item(syntax, earlier);
        let named: bool = SourceSet::spans_equal(sources, item.name.source_span, earlier_item.name.source_span);
        let same_module: bool = Resolver::same_module(sources, item.name.source_span.source.value as u64 in Trapping,
            earlier_item.name.source_span.source.value as u64 in Trapping);
        transition named && same_module {
            true -> carriers(resolver, sources, syntax, index, item, earlier, earlier_item)
            _ -> prior(resolver, sources, syntax, index, item, earlier + 1)
        }
    }

    machine carriers(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: DomainItem, earlier: u64 in Trapping, earlier_item: DomainItem) {
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        let earlier_scope: TypeScope = Resolver::scope(earlier_item.first_generic_parameter, earlier_item.generic_parameter_count);
        let same: bool = Resolver::same_type(resolver, sources, syntax, scope, item.carrier, earlier_scope, earlier_item.carrier);
        transition same {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateDeclaration, item.name)
            _ -> prior(resolver, sources, syntax, index, item, earlier + 1)
        }
    }

    machine reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    machine done() {}
}

// The compiler-known domain a name spells, or `Unqualified`.
public machine Resolver::known_domain(sources: &SourceSet, name: SourceSpan) -> DomainBinding
crashes Trap
{
    let matched: bool = SourceSet::span_spells(sources, name, "Wrapping");
    transition matched {
        true -> found(DomainBinding::Wrapping)
        _ -> saturating(sources, name)
    }

    machine saturating(sources: &SourceSet, name: SourceSpan) -> DomainBinding {
        let matched: bool = SourceSet::span_spells(sources, name, "Saturating");
        transition matched {
            true -> found(DomainBinding::Saturating)
            _ -> trapping(sources, name)
        }
    }

    machine trapping(sources: &SourceSet, name: SourceSpan) -> DomainBinding {
        let matched: bool = SourceSet::span_spells(sources, name, "Trapping");
        transition matched {
            true -> found(DomainBinding::Trapping)
            _ -> finite(sources, name)
        }
    }

    machine finite(sources: &SourceSet, name: SourceSpan) -> DomainBinding {
        let matched: bool = SourceSet::span_spells(sources, name, "Finite");
        transition matched {
            true -> found(DomainBinding::Finite)
            _ -> found(DomainBinding::Unqualified)
        }
    }

    machine found(binding: DomainBinding) -> DomainBinding {
        binding
    }
}

// The declared domain `name` selects for the type whose root is row `row`:
// the one visible domain of that name whose carrier admits the type.
public machine Resolver::declared_domain(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, row: u64 in Trapping, name: SourceSpan) -> Lookup
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, row, name, 0) }

    machine next(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, row: u64 in Trapping, name: SourceSpan, index: u64 in Trapping) -> Lookup {
        transition index < syntax.domain_count {
            true -> candidate(resolver, sources, syntax, row, name, index)
            _ -> absent()
        }
    }

    machine candidate(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, row: u64 in Trapping, name: SourceSpan, index: u64 in Trapping) -> Lookup {
        let admitted: bool = Resolver::domain_admits(resolver, sources, syntax, index, row, name);
        transition admitted {
            true -> rival(resolver, sources, syntax, row, name, index, index + 1)
            _ -> next(resolver, sources, syntax, row, name, index + 1)
        }
    }

    machine rival(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, row: u64 in Trapping, name: SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> Lookup {
        transition index < syntax.domain_count {
            true -> rival_candidate(resolver, sources, syntax, row, name, found, index)
            _ -> unique(found)
        }
    }

    machine rival_candidate(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, row: u64 in Trapping, name: SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> Lookup {
        let admitted: bool = Resolver::domain_admits(resolver, sources, syntax, index, row, name);
        transition admitted {
            true -> ambiguous()
            _ -> rival(resolver, sources, syntax, row, name, found, index + 1)
        }
    }

    machine unique(found: u64 in Trapping) -> Lookup {
        Lookup::Found { handle: found }
    }

    machine absent() -> Lookup {
        Lookup::Absent
    }

    machine ambiguous() -> Lookup {
        Lookup::Ambiguous
    }
}

// Whether domain `index` is named `name`, visible from it, and carried by
// the type rooted at `row`.
public machine Resolver::domain_admits(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, row: u64 in Trapping, name: SourceSpan) -> bool
crashes Trap
{
    let item: DomainItem = SyntaxTrees::domain_item(syntax, index);
    let named: bool = SourceSet::spans_equal(sources, item.name.source_span, name);
    let visible: bool = Resolver::visible_if(sources, syntax, named, name.source, item.name.source_span.source, item.is_public);
    transition visible {
        true -> carried(resolver, sources, syntax, item, row)
        _ -> no()
    }

    machine carried(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: DomainItem, row: u64 in Trapping) -> bool {
        Resolver::carrier_matches(resolver, sources, syntax, item, row)
    }

    machine no() -> bool {
        false
    }
}

// Whether domain `item`'s carrier is the type rooted at `actual`. Both types
// are runs listing children before parents, so walking both from their roots
// toward their first rows meets each row's children after it, in the same
// order whenever the rows agree. A carrier row naming one of the domain's
// own generic parameters stands for any type: the walk skips the whole
// subtree the actual type has in its place. No recursion or stack is needed.
public machine Resolver::carrier_matches(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: DomainItem, actual: u64 in Trapping) -> bool
crashes Trap
{
    let carrier_root: TypeReference = SyntaxTrees::type_reference(syntax, item.carrier);
    let actual_root: TypeReference = SyntaxTrees::type_reference(syntax, actual);
    transition { _ -> step(resolver, sources, syntax, item, carrier_root.first_row, item.carrier + 1, actual_root.first_row, actual + 1) }

    // `carrier_end` and `actual_end` are one past the next rows to compare.
    machine step(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        item: DomainItem,
        carrier_first: u64 in Trapping,
        carrier_end: u64 in Trapping,
        actual_first: u64 in Trapping,
        actual_end: u64 in Trapping
    ) -> bool {
        transition carrier_end > carrier_first {
            true -> pair(resolver, sources, syntax, item, carrier_first, carrier_end, actual_first, actual_end)
            _ -> finished(actual_first, actual_end)
        }
    }

    machine pair(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        item: DomainItem,
        carrier_first: u64 in Trapping,
        carrier_end: u64 in Trapping,
        actual_first: u64 in Trapping,
        actual_end: u64 in Trapping
    ) -> bool {
        transition actual_end > actual_first {
            true -> wildcard(resolver, sources, syntax, item, carrier_first, carrier_end, actual_first, actual_end)
            _ -> different()
        }
    }

    machine wildcard(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        item: DomainItem,
        carrier_first: u64 in Trapping,
        carrier_end: u64 in Trapping,
        actual_first: u64 in Trapping,
        actual_end: u64 in Trapping
    ) -> bool {
        let carrier_binding: TypeBinding = NameResolution::type_binding_at(&resolver.output, carrier_end - 1);
        transition carrier_binding {
            TypeBinding::GenericParameter { parameter } -> generic(resolver, sources, syntax, item, carrier_first, carrier_end, actual_first, actual_end, parameter)
            _ -> head(resolver, sources, syntax, item, carrier_first, carrier_end, actual_first, actual_end)
        }
    }

    machine generic(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        item: DomainItem,
        carrier_first: u64 in Trapping,
        carrier_end: u64 in Trapping,
        actual_first: u64 in Trapping,
        actual_end: u64 in Trapping,
        parameter: u64 in Trapping
    ) -> bool {
        let skipped: TypeReference = SyntaxTrees::type_reference(syntax, actual_end - 1);
        transition parameter >= item.first_generic_parameter && parameter < item.first_generic_parameter + item.generic_parameter_count {
            true -> step(resolver, sources, syntax, item, carrier_first, carrier_end - 1, actual_first, skipped.first_row)
            _ -> head(resolver, sources, syntax, item, carrier_first, carrier_end, actual_first, actual_end)
        }
    }

    machine head(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        item: DomainItem,
        carrier_first: u64 in Trapping,
        carrier_end: u64 in Trapping,
        actual_first: u64 in Trapping,
        actual_end: u64 in Trapping
    ) -> bool {
        let same: bool = Resolver::same_head(resolver, sources, syntax, carrier_end - 1, actual_end - 1);
        transition same {
            true -> step(resolver, sources, syntax, item, carrier_first, carrier_end - 1, actual_first, actual_end - 1)
            _ -> different()
        }
    }

    machine finished(actual_first: u64 in Trapping, actual_end: u64 in Trapping) -> bool {
        actual_end == actual_first
    }

    machine different() -> bool {
        false
    }
}

// Whether two rows agree in form, access, argument count and binding,
// regardless of their own `in` qualifiers. Integer rows compare by spelling.
machine Resolver::same_head(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, left: u64 in Trapping, right: u64 in Trapping) -> bool
crashes Trap
{
    let left_row: TypeReference = SyntaxTrees::type_reference(syntax, left);
    let right_row: TypeReference = SyntaxTrees::type_reference(syntax, right);
    transition left_row.kind == right_row.kind && left_row.access == right_row.access
        && left_row.argument_count == right_row.argument_count {
        true -> spelling(resolver, sources, left, right, left_row, right_row)
        _ -> different()
    }

    machine spelling(resolver: &Resolver, sources: &SourceSet, left: u64 in Trapping, right: u64 in Trapping, left_row: TypeReference, right_row: TypeReference) -> bool {
        let same: bool = SourceSet::spans_equal(sources, left_row.name.source_span, right_row.name.source_span);
        transition left_row.kind == TypeReferenceKind::Literal && !same {
            true -> different()
            _ -> bindings(resolver, left, right)
        }
    }

    machine bindings(resolver: &Resolver, left: u64 in Trapping, right: u64 in Trapping) -> bool {
        Resolver::same_bound_rows(&resolver.output, left, right)
    }

    machine different() -> bool {
        false
    }
}

// Whether rows `left` and `right`, of one form, bind the same declaration.
// Reference, array, slice and integer rows bind by form, which the caller
// matched; unresolved, ambiguous, trait and conformance rows name no carrier.
machine Resolver::same_bound_rows(resolution: &NameResolution, left: u64 in Trapping, right: u64 in Trapping) -> bool
crashes Trap
{
    let left_binding: TypeBinding = NameResolution::type_binding_at(resolution, left);
    transition left_binding {
        TypeBinding::Builtin { builtin } -> builtin_row(resolution, builtin, right)
        TypeBinding::Data { item } -> data_row(resolution, item, right)
        TypeBinding::GenericParameter { parameter } -> generic_row(resolution, parameter, right)
        TypeBinding::Reference -> answer(true)
        TypeBinding::Array -> answer(true)
        TypeBinding::Slice -> answer(true)
        TypeBinding::Literal -> answer(true)
        _ -> answer(false)
    }

    machine builtin_row(resolution: &NameResolution, left_builtin: BuiltinType, right: u64 in Trapping) -> bool {
        let right_binding: TypeBinding = NameResolution::type_binding_at(resolution, right);
        transition right_binding {
            TypeBinding::Builtin { builtin } -> answer(left_builtin == builtin)
            _ -> answer(false)
        }
    }

    machine data_row(resolution: &NameResolution, left_item: u64 in Trapping, right: u64 in Trapping) -> bool {
        let right_binding: TypeBinding = NameResolution::type_binding_at(resolution, right);
        transition right_binding {
            TypeBinding::Data { item } -> answer(left_item == item)
            _ -> answer(false)
        }
    }

    machine generic_row(resolution: &NameResolution, left_parameter: u64 in Trapping, right: u64 in Trapping) -> bool {
        let right_binding: TypeBinding = NameResolution::type_binding_at(resolution, right);
        transition right_binding {
            TypeBinding::GenericParameter { parameter } -> answer(left_parameter == parameter)
            _ -> answer(false)
        }
    }

    machine answer(same: bool) -> bool {
        same
    }
}

// Establishment routes and alias constituents, in domain order.
public machine Resolver::bind_domain_paths(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0) }

    machine next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.domain_count && resolver.output.accepted {
            true -> routes(resolver, sources, syntax, index, 0)
            _ -> done()
        }
    }

    machine routes(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, index);
        transition offset < item.route_count && resolver.output.accepted {
            true -> route(resolver, sources, syntax, index, offset, item.first_route + offset)
            _ -> constituents(resolver, sources, syntax, index, 0)
        }
    }

    machine route(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, path: u64 in Trapping) {
        Resolver::bind_machine_path(resolver, sources, syntax, path);
        transition { _ -> routes(resolver, sources, syntax, index, offset + 1) }
    }

    machine constituents(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, index);
        transition offset < item.constituent_count && resolver.output.accepted {
            true -> constituent(resolver, sources, syntax, index, offset, item, item.first_constituent + offset)
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine constituent(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, item: DomainItem, path: u64 in Trapping) {
        let name_path: NamePath = SyntaxTrees::name_path(syntax, path);
        let lookup: Lookup = Resolver::constituent_domain(resolver, sources, syntax, item, name_path);
        transition lookup {
            Lookup::Found { handle } -> bound(resolver, sources, syntax, index, offset, path, handle)
            Lookup::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, name_path)
            Lookup::Absent -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, name_path)
        }
    }

    machine bound(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, path: u64 in Trapping, handle: u64 in Trapping) {
        Resolver::set_path_binding(resolver, path, PathBinding::Domain { item: handle });
        transition { _ -> constituents(resolver, sources, syntax, index, offset + 1) }
    }

    machine reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name_path: NamePath) {
        NameResolution::reject(&mut resolver.output, code, name_path.source_span);
    }

    machine done() {}
}

// The domain an alias constituent names: `Name` over the alias's own
// carrier, or `Carrier::Name` over the type `Carrier` names in the alias's
// scope. A longer path crosses a package, which this source set cannot bind.
machine Resolver::constituent_domain(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, alias: DomainItem, name_path: NamePath) -> Lookup
crashes Trap
{
    transition name_path.member_count {
        1 -> bare(resolver, sources, syntax, alias, name_path)
        2 -> qualified(resolver, sources, syntax, alias, name_path)
        _ -> absent()
    }

    machine bare(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, alias: DomainItem, name_path: NamePath) -> Lookup {
        let name: IdentifierSpan = SyntaxTrees::member(syntax, name_path.first_member);
        Resolver::declared_domain(resolver, sources, syntax, alias.carrier, name.source_span)
    }

    machine qualified(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, alias: DomainItem, name_path: NamePath) -> Lookup {
        let carrier: IdentifierSpan = SyntaxTrees::member(syntax, name_path.first_member);
        let name: IdentifierSpan = SyntaxTrees::member(syntax, name_path.first_member + 1);
        let scope: TypeScope = Resolver::scope(alias.first_generic_parameter, alias.generic_parameter_count);
        Resolver::domain_by_head(resolver, sources, syntax, scope, carrier.source_span, name.source_span)
    }

    machine absent() -> Lookup {
        Lookup::Absent
    }
}

// The visible domain named `name` whose carrier's root binds like the type
// `carrier` names in `scope`, or is one of the domain's own generic
// parameters.
public machine Resolver::domain_by_head(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, carrier: SourceSpan, name: SourceSpan) -> Lookup
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, scope, carrier, name, 0) }

    machine next(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, carrier: SourceSpan, name: SourceSpan, index: u64 in Trapping) -> Lookup {
        transition index < syntax.domain_count {
            true -> candidate(resolver, sources, syntax, scope, carrier, name, index)
            _ -> absent()
        }
    }

    machine candidate(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, carrier: SourceSpan, name: SourceSpan, index: u64 in Trapping) -> Lookup {
        let admitted: bool = Resolver::domain_head_admits(resolver, sources, syntax, index, scope, carrier, name);
        transition admitted {
            true -> rival(resolver, sources, syntax, scope, carrier, name, index, index + 1)
            _ -> next(resolver, sources, syntax, scope, carrier, name, index + 1)
        }
    }

    machine rival(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, carrier: SourceSpan, name: SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> Lookup {
        transition index < syntax.domain_count {
            true -> rival_candidate(resolver, sources, syntax, scope, carrier, name, found, index)
            _ -> unique(found)
        }
    }

    machine rival_candidate(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, carrier: SourceSpan, name: SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> Lookup {
        let admitted: bool = Resolver::domain_head_admits(resolver, sources, syntax, index, scope, carrier, name);
        transition admitted {
            true -> ambiguous()
            _ -> rival(resolver, sources, syntax, scope, carrier, name, found, index + 1)
        }
    }

    machine unique(found: u64 in Trapping) -> Lookup {
        Lookup::Found { handle: found }
    }

    machine absent() -> Lookup {
        Lookup::Absent
    }

    machine ambiguous() -> Lookup {
        Lookup::Ambiguous
    }
}

machine Resolver::domain_head_admits(
    resolver: &Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    index: u64 in Trapping,
    scope: TypeScope,
    carrier: SourceSpan,
    name: SourceSpan
) -> bool
crashes Trap
{
    let item: DomainItem = SyntaxTrees::domain_item(syntax, index);
    let named: bool = SourceSet::spans_equal(sources, item.name.source_span, name);
    let visible: bool = Resolver::visible_if(sources, syntax, named, name.source, item.name.source_span.source, item.is_public);
    transition visible {
        true -> head(resolver, sources, syntax, item, scope, carrier)
        _ -> answer(false)
    }

    machine head(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, declared: DomainItem, scope: TypeScope, carrier: SourceSpan) -> bool {
        let own: TypeBinding = NameResolution::type_binding_at(&resolver.output, declared.carrier);
        transition own {
            TypeBinding::GenericParameter { parameter } -> own_generic(declared, parameter)
            TypeBinding::Builtin { builtin } -> builtin_carrier(sources, syntax, scope, carrier, builtin)
            TypeBinding::Data { item } -> data_carrier(sources, syntax, scope, carrier, item)
            _ -> answer(false)
        }
    }

    // A domain's own parameters carry any type; the carrier names none here.
    machine own_generic(declared: DomainItem, parameter: u64 in Trapping) -> bool {
        parameter >= declared.first_generic_parameter && parameter < declared.first_generic_parameter + declared.generic_parameter_count
    }

    machine builtin_carrier(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, carrier: SourceSpan, own: BuiltinType) -> bool {
        let named: TypeBinding = Resolver::type_binding(sources, syntax, scope, carrier);
        transition named {
            TypeBinding::Builtin { builtin } -> answer(own == builtin)
            _ -> answer(false)
        }
    }

    machine data_carrier(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, carrier: SourceSpan, own: u64 in Trapping) -> bool {
        let named: TypeBinding = Resolver::type_binding(sources, syntax, scope, carrier);
        transition named {
            TypeBinding::Data { item } -> answer(own == item)
            _ -> answer(false)
        }
    }

    machine answer(admitted: bool) -> bool {
        admitted
    }
}

// The one visible domain named `name`, whatever its carrier; several are
// ambiguous until the carrier is known.
public machine Resolver::domain_named(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> Lookup
crashes Trap
{
    transition { _ -> next(sources, syntax, name, 0) }

    machine next(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan, index: u64 in Trapping) -> Lookup {
        transition index < syntax.domain_count {
            true -> candidate(sources, syntax, name, index)
            _ -> absent()
        }
    }

    machine candidate(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan, index: u64 in Trapping) -> Lookup {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, index);
        let named: bool = SourceSet::spans_equal(sources, item.name.source_span, name);
        let visible: bool = Resolver::visible_if(sources, syntax, named, name.source, item.name.source_span.source, item.is_public);
        transition visible {
            true -> rival(sources, syntax, name, index, index + 1)
            _ -> next(sources, syntax, name, index + 1)
        }
    }

    machine rival(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> Lookup {
        transition index < syntax.domain_count {
            true -> rival_candidate(sources, syntax, name, found, index)
            _ -> unique(found)
        }
    }

    machine rival_candidate(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> Lookup {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, index);
        let named: bool = SourceSet::spans_equal(sources, item.name.source_span, name);
        let visible: bool = Resolver::visible_if(sources, syntax, named, name.source, item.name.source_span.source, item.is_public);
        transition visible {
            true -> ambiguous()
            _ -> rival(sources, syntax, name, found, index + 1)
        }
    }

    machine unique(found: u64 in Trapping) -> Lookup {
        Lookup::Found { handle: found }
    }

    machine absent() -> Lookup {
        Lookup::Absent
    }

    machine ambiguous() -> Lookup {
        Lookup::Ambiguous
    }
}
