use psi::resolution::resolution;
use psi::resolve::containers;
use psi::resolve::facts;
use psi::resolve::imports;
use psi::resolve::names;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Clause names (wiki/spec/language/machines.md#supply). A `satisfies` clause
// names one exact requirement of a visible trait, `Trait<arguments>::name`:
// the trait binds like a trait position, its static arguments like any
// static argument in the machine's generic scope, and the requirement is
// the trait's member of that name. Its `via` payload is a compile-time value
// (wiki/spec/build/foreign_bindings.md), so it binds in the machine's static
// scope: its value binders and constants, never its parameters. A
// `terminates by subjects [-> View]` witness ranks the body's entry
// parameters: its subjects and view bind as a `requires` fact's names do
// (wiki/spec/language/termination.md). A trait reached through a module
// path rejects as unsupported.
public machine Resolver::bind_clause_names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_machine(resolver, sources, syntax, 0) }

    machine next_machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count && resolver.output.accepted {
            true -> machine(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    machine machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        transition { _ -> next_clause(resolver, sources, syntax, index, item, 0) }
    }

    machine next_clause(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        transition offset < item.clause_count && resolver.output.accepted {
            true -> clause(resolver, sources, syntax, index, item, offset)
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    machine clause(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        let handle: u64 in Trapping = item.first_clause + offset;
        let clause: Clause = SyntaxTrees::clause(syntax, handle);
        transition clause.kind {
            ClauseKind::Satisfies -> satisfies(resolver, sources, syntax, index, item, offset, handle, clause)
            ClauseKind::Terminates -> terminates(resolver, sources, syntax, index, item, offset, handle, clause)
            _ -> next_clause(resolver, sources, syntax, index, item, offset + 1)
        }
    }

    machine satisfies(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        clause: Clause
    ) {
        Resolver::bind_satisfied_requirement(resolver, sources, syntax, index, handle, clause);
        transition { _ -> next_clause(resolver, sources, syntax, index, item, offset + 1) }
    }

    machine terminates(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        clause: Clause
    ) {
        let scope: NameScope = Resolver::fact_scope(true, index, item.first_parameter, item.parameter_count, false);
        Resolver::bind_ranking(resolver, sources, syntax, scope, handle, clause);
        transition clause.argument_count > 0 {
            true -> ranked(resolver, sources, syntax, index, item, offset)
            _ -> next_clause(resolver, sources, syntax, index, item, offset + 1)
        }
    }

    machine ranked(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        Resolver::bind_rank_carriers(resolver, sources, syntax, item);
        transition { _ -> next_clause(resolver, sources, syntax, index, item, offset + 1) }
    }

    machine done() {}
}

// One `satisfies` clause of machine `machine`: its trait's static
// arguments, its trait and requirement, then its `via` payload.
machine Resolver::bind_satisfied_requirement(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    machine: u64 in Trapping,
    clause_handle: u64 in Trapping,
    clause: Clause
)
crashes Trap
{
    let scope: TypeScope = Resolver::machine_scope(&resolver.output, syntax, machine);
    transition { _ -> argument(resolver, sources, syntax, machine, clause_handle, clause, scope, 0) }

    machine argument(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        machine: u64 in Trapping,
        clause_handle: u64 in Trapping,
        clause: Clause,
        scope: TypeScope,
        offset: u64 in Trapping
    ) {
        transition offset < clause.argument_count && resolver.output.accepted {
            true -> bind_argument(resolver, sources, syntax, machine, clause_handle, clause, scope, offset)
            _ -> path(resolver, sources, syntax, machine, clause_handle, clause, scope)
        }
    }

    machine bind_argument(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        machine: u64 in Trapping,
        clause_handle: u64 in Trapping,
        clause: Clause,
        scope: TypeScope,
        offset: u64 in Trapping
    ) {
        let row: u64 in Trapping = SyntaxTrees::type_argument(syntax, clause.first_argument + offset);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, row, TypeRole::StaticArgument);
        transition { _ -> argument(resolver, sources, syntax, machine, clause_handle, clause, scope, offset + 1) }
    }

    // The trait's path is one name: `Trait::requirement`.
    machine path(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        machine: u64 in Trapping,
        clause_handle: u64 in Trapping,
        clause: Clause,
        scope: TypeScope
    ) {
        transition resolver.output.accepted && clause.member_count == 2 {
            true -> named(resolver, sources, syntax, machine, clause_handle, clause, scope)
            _ -> qualified(resolver, clause)
        }
    }

    machine named(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        machine: u64 in Trapping,
        clause_handle: u64 in Trapping,
        clause: Clause,
        scope: TypeScope
    ) {
        let owner: IdentifierSpan = SyntaxTrees::member(syntax, clause.first_member);
        let binding: TypeBinding = Resolver::type_binding(sources, syntax, scope, owner.source_span);
        transition binding {
            TypeBinding::Trait { item } -> requirement(resolver, sources, syntax, machine, clause_handle, clause, item)
            TypeBinding::Unresolved -> reject(resolver, ResolveDiagnosticCode::UnknownDataType, owner.source_span)
            TypeBinding::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, owner.source_span)
            _ -> reject(resolver, ResolveDiagnosticCode::NotATrait, owner.source_span)
        }
    }

    machine requirement(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        machine: u64 in Trapping,
        clause_handle: u64 in Trapping,
        clause: Clause,
        trait_index: u64 in Trapping
    ) {
        let name: IdentifierSpan = SyntaxTrees::member(syntax, clause.first_member + 1);
        let member: Lookup = Resolver::trait_member_named(sources, syntax, trait_index, name.source_span);
        transition member {
            Lookup::Found { handle } -> found(resolver, sources, syntax, machine, clause_handle, clause, handle)
            _ -> reject(resolver, ResolveDiagnosticCode::NotARequirement, name.source_span)
        }
    }

    machine found(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        machine: u64 in Trapping,
        clause_handle: u64 in Trapping,
        clause: Clause,
        requirement: u64 in Trapping
    ) {
        Resolver::set_requirement(resolver, clause_handle, ValueBinding::Machine { handle: requirement });
        transition clause.has_expression {
            true -> payload(resolver, sources, syntax, machine, clause)
            _ -> done()
        }
    }

    // The payload sees the machine's binders and constants, not its
    // parameters.
    machine payload(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, machine: u64 in Trapping, clause: Clause) {
        let scope: NameScope = Resolver::fact_scope(true, machine, 0, 0, false);
        Resolver::bind_tree(resolver, sources, syntax, scope, clause.expression);
    }

    machine qualified(resolver: &mut Resolver, clause: Clause) {
        transition resolver.output.accepted {
            true -> reject(resolver, ResolveDiagnosticCode::UnsupportedClause, clause.source_span)
            _ -> done()
        }
    }

    machine reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, code, source_span);
    }

    machine done() {}
}

// A `terminates by` witness: each ranked subject, then its view, which
// names the compiler's ranking vocabulary by spelling rather than a
// declaration (resolution.omg, `RankingView`); `Nat::IncreasingTo`'s limit
// binds as a subject does.
machine Resolver::bind_ranking(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, handle: u64 in Trapping, clause: Clause)
crashes Trap
{
    transition clause.has_range {
        true -> range(resolver, sources, syntax, scope, handle, clause)
        _ -> subject(resolver, sources, syntax, scope, handle, clause, 0)
    }

    // The rank range's endpoints bind as the subjects do
    // (wiki/spec/language/termination.md#ranking).
    machine range(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, handle: u64 in Trapping, clause: Clause) {
        Resolver::bind_tree(resolver, sources, syntax, scope, clause.range);
        transition { _ -> subject(resolver, sources, syntax, scope, handle, clause, 0) }
    }

    machine subject(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, handle: u64 in Trapping, clause: Clause, offset: u64 in Trapping) {
        transition offset < clause.argument_count && resolver.output.accepted {
            true -> bind_subject(resolver, sources, syntax, scope, handle, clause, offset)
            _ -> view(resolver, sources, syntax, scope, handle, clause)
        }
    }

    machine bind_subject(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, handle: u64 in Trapping, clause: Clause, offset: u64 in Trapping) {
        let root: u64 in Trapping = SyntaxTrees::argument(syntax, clause.first_argument + offset);
        Resolver::bind_tree(resolver, sources, syntax, scope, root);
        transition { _ -> subject(resolver, sources, syntax, scope, handle, clause, offset + 1) }
    }

    machine view(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, handle: u64 in Trapping, clause: Clause) {
        transition clause.has_expression && resolver.output.accepted {
            true -> spelled(resolver, sources, syntax, scope, handle, clause)
            _ -> chosen(resolver, handle, RankingView::Default)
        }
    }

    machine spelled(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, handle: u64 in Trapping, clause: Clause) {
        let spelling: ViewSpelling = Resolver::spelled_view(sources, syntax, clause.expression);
        let written: Expression = SyntaxTrees::expression(syntax, clause.expression);
        transition spelling.known {
            true -> known(resolver, sources, syntax, scope, handle, spelling.view, written)
            _ -> declared(resolver, sources, syntax, handle, written)
        }
    }

    // Outside the vocabulary, a two-member path names a declared measure
    // (wiki/spec/language/termination.md#ranking).
    machine declared(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, handle: u64 in Trapping, written: Expression) {
        transition written.kind == ExpressionKind::Path && written.count == 2 {
            true -> measure(resolver, sources, syntax, handle, written)
            _ -> unsupported(resolver, written.source_span)
        }
    }

    machine measure(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, handle: u64 in Trapping, written: Expression) {
        let owner: IdentifierSpan = SyntaxTrees::member(syntax, written.first);
        let name: IdentifierSpan = SyntaxTrees::member(syntax, written.first + 1);
        let found: u64 in Trapping = Resolver::measure_named(sources, syntax, owner.source_span, name.source_span);
        transition found > 0 {
            true -> measured(resolver, handle, found - 1)
            _ -> unsupported(resolver, written.source_span)
        }
    }

    machine measured(resolver: &mut Resolver, handle: u64 in Trapping, measure: u64 in Trapping) {
        NameResolution::set_ranking_view(&mut resolver.output, handle, RankingView::Measure);
        NameResolution::set_ranking_measure(&mut resolver.output, handle, measure);
    }

    machine known(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, handle: u64 in Trapping, view: RankingView, written: Expression) {
        NameResolution::set_ranking_view(&mut resolver.output, handle, view);
        transition view {
            RankingView::IncreasingTo -> limit(resolver, sources, syntax, scope, written)
            _ -> done()
        }
    }

    machine limit(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, written: Expression) {
        let root: u64 in Trapping = SyntaxTrees::argument(syntax, written.first);
        Resolver::bind_tree(resolver, sources, syntax, scope, root);
    }

    machine chosen(resolver: &mut Resolver, handle: u64 in Trapping, view: RankingView) {
        NameResolution::set_ranking_view(&mut resolver.output, handle, view);
    }

    machine unsupported(resolver: &mut Resolver, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnsupportedRankingView, source_span);
    }

    machine done() {}
}

// A ranking view's spelling: whether it is one of the vocabulary's.
data ViewSpelling [copy] {
    known: bool;
    view: RankingView;
}

// The view a `-> View` expression spells: a two-member path, or for
// `Nat::IncreasingTo` a call of one with one argument.
machine Resolver::spelled_view(sources: &SourceSet, syntax: &SyntaxTrees, handle: u64 in Trapping) -> ViewSpelling
crashes Trap
{
    let written: Expression = SyntaxTrees::expression(syntax, handle);
    transition written.kind {
        ExpressionKind::Path -> path(sources, syntax, written, false)
        ExpressionKind::Call -> call(sources, syntax, written)
        _ -> unknown()
    }

    machine call(sources: &SourceSet, syntax: &SyntaxTrees, written: Expression) -> ViewSpelling {
        let callee: Expression = SyntaxTrees::expression(syntax, written.left);
        transition callee.kind == ExpressionKind::Path && written.count == 1 {
            true -> path(sources, syntax, callee, true)
            _ -> unknown()
        }
    }

    machine path(sources: &SourceSet, syntax: &SyntaxTrees, path: Expression, argumented: bool) -> ViewSpelling {
        transition path.count == 2 {
            true -> members(sources, syntax, path, argumented)
            _ -> unknown()
        }
    }

    machine members(sources: &SourceSet, syntax: &SyntaxTrees, path: Expression, argumented: bool) -> ViewSpelling {
        let owner: IdentifierSpan = SyntaxTrees::member(syntax, path.first);
        let name: IdentifierSpan = SyntaxTrees::member(syntax, path.first + 1);
        let nat: bool = SourceSet::span_spells(sources, owner.source_span, "Nat");
        let slice: bool = SourceSet::span_spells(sources, owner.source_span, "Slice");
        let descending: bool = SourceSet::span_spells(sources, name.source_span, "Descending");
        let bounded: bool = SourceSet::span_spells(sources, name.source_span, "BoundedDistance");
        let increasing: bool = SourceSet::span_spells(sources, name.source_span, "IncreasingTo");
        let length: bool = SourceSet::span_spells(sources, name.source_span, "Length");
        transition argumented {
            true -> argumented_view(nat && increasing)
            _ -> plain_view(nat && descending, nat && bounded, slice && length)
        }
    }

    machine argumented_view(increasing: bool) -> ViewSpelling {
        transition increasing {
            true -> known(RankingView::IncreasingTo)
            _ -> unknown()
        }
    }

    machine plain_view(descending: bool, bounded: bool, length: bool) -> ViewSpelling {
        transition descending {
            true -> known(RankingView::Descending)
            _ -> distance(bounded, length)
        }
    }

    machine distance(bounded: bool, length: bool) -> ViewSpelling {
        transition bounded {
            true -> known(RankingView::BoundedDistance)
            _ -> sliced(length)
        }
    }

    machine sliced(length: bool) -> ViewSpelling {
        transition length {
            true -> known(RankingView::SliceLength)
            _ -> unknown()
        }
    }

    machine known(view: RankingView) -> ViewSpelling {
        ViewSpelling { known: true, view: view }
    }

    machine unknown() -> ViewSpelling {
        ViewSpelling { known: false, view: RankingView::Default }
    }
}

// Each state parameter of a ranked machine carries the entry parameter of
// its spelling: a state's ranked subjects are its formals of the entry
// subjects' names, so each backedge ranks its target state's exact formals
// (wiki/spec/language/termination.md#subject-preservation).
machine Resolver::bind_rank_carriers(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem)
crashes Trap
{
    transition { _ -> next_state(resolver, sources, syntax, item, 0) }

    machine next_state(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem, offset: u64 in Trapping) {
        transition offset < item.state_count {
            true -> member_state(resolver, sources, syntax, item, offset)
            _ -> done()
        }
    }

    machine member_state(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem, offset: u64 in Trapping) {
        let body: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        transition { _ -> next_parameter(resolver, sources, syntax, item, offset, body, 0) }
    }

    machine next_parameter(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem, offset: u64 in Trapping, body: StateItem, index: u64 in Trapping) {
        transition index < body.parameter_count {
            true -> parameter(resolver, sources, syntax, item, offset, body, index)
            _ -> next_state(resolver, sources, syntax, item, offset + 1)
        }
    }

    // A formal spelled as an entry subject carries it; otherwise it carries
    // the entry subject every arrival at its state passes it, directly or
    // through another formal already known to carry one
    // (wiki/spec/language/termination.md#subject-preservation: state
    // arrivals retain their entry subjects' lineage). Arrivals passing
    // different subjects leave the formal uncarried.
    machine parameter(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem, offset: u64 in Trapping, body: StateItem, index: u64 in Trapping) {
        let handle: u64 in Trapping = body.first_parameter + index;
        let spelled: u64 in Trapping = Resolver::same_spelled_parameter(sources, syntax, handle, item.first_parameter, item.parameter_count);
        let received: u64 in Trapping = Resolver::received_parameter(resolver, syntax, item, item.first_state + offset, index);
        transition spelled > 0 {
            true -> carried(resolver, sources, syntax, item, offset, body, index, handle, spelled)
            _ -> carried(resolver, sources, syntax, item, offset, body, index, handle, received)
        }
    }

    machine carried(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem, offset: u64 in Trapping, body: StateItem, index: u64 in Trapping, handle: u64 in Trapping, carried: u64 in Trapping) {
        NameResolution::set_rank_carrier(&mut resolver.output, handle, carried);
        transition { _ -> next_parameter(resolver, sources, syntax, item, offset, body, index + 1) }
    }

    machine done() {}
}

// The entry parameter (offset plus one) that every arrival at state `state`
// passes to its formal at `position`: an argument naming an entry
// parameter, or a state formal already carrying one; zero when no arrival
// passes one or two arrivals disagree. Arrivals are the transition arms of
// the entry body and of every state body whose target calls `state`.
machine Resolver::received_parameter(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> statement(resolver, syntax, item, state, position, item.first_statement, item.first_statement + item.statement_count, 0, 0, false) }

    // Walk the entry statements, then each state's, `found` holding the
    // agreed carrier so far (zero before any) and `disagreed` a conflict.
    machine statement(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, next_state: u64 in Trapping, found: u64 in Trapping, disagreed: bool) -> u64 in Trapping {
        transition index < end {
            true -> transition_arms(resolver, syntax, item, state, position, index, end, next_state, found, disagreed)
            _ -> more_states(resolver, syntax, item, state, position, next_state, found, disagreed)
        }
    }

    machine transition_arms(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, next_state: u64 in Trapping, found: u64 in Trapping, disagreed: bool) -> u64 in Trapping {
        let written: Statement = SyntaxTrees::statement(syntax, index);
        transition written.kind == StatementKind::Transition {
            true -> arm(resolver, syntax, item, state, position, index, end, next_state, found, disagreed, written.first_arm, written.first_arm + written.arm_count)
            _ -> statement(resolver, syntax, item, state, position, index + 1, end, next_state, found, disagreed)
        }
    }

    machine arm(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, next_state: u64 in Trapping, found: u64 in Trapping, disagreed: bool, arm_index: u64 in Trapping, arm_end: u64 in Trapping) -> u64 in Trapping {
        transition arm_index < arm_end {
            true -> target(resolver, syntax, item, state, position, index, end, next_state, found, disagreed, arm_index, arm_end)
            _ -> statement(resolver, syntax, item, state, position, index + 1, end, next_state, found, disagreed)
        }
    }

    machine target(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, next_state: u64 in Trapping, found: u64 in Trapping, disagreed: bool, arm_index: u64 in Trapping, arm_end: u64 in Trapping) -> u64 in Trapping {
        let written: TransitionArm = SyntaxTrees::arm(syntax, arm_index);
        let passed: u64 in Trapping = Resolver::passed_subject(resolver, syntax, item, state, position, written);
        transition passed > 0 {
            true -> agree(resolver, syntax, item, state, position, index, end, next_state, found, disagreed, arm_index, arm_end, passed)
            _ -> arm(resolver, syntax, item, state, position, index, end, next_state, found, disagreed, arm_index + 1, arm_end)
        }
    }

    machine agree(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, next_state: u64 in Trapping, found: u64 in Trapping, disagreed: bool, arm_index: u64 in Trapping, arm_end: u64 in Trapping, passed: u64 in Trapping) -> u64 in Trapping {
        let conflict: bool = found > 0 && found != passed;
        transition { _ -> arm(resolver, syntax, item, state, position, index, end, next_state, passed, disagreed || conflict, arm_index + 1, arm_end) }
    }

    machine more_states(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping, next_state: u64 in Trapping, found: u64 in Trapping, disagreed: bool) -> u64 in Trapping {
        transition next_state < item.state_count {
            true -> state_body(resolver, syntax, item, state, position, next_state, found, disagreed)
            _ -> answer(found, disagreed)
        }
    }

    machine state_body(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping, next_state: u64 in Trapping, found: u64 in Trapping, disagreed: bool) -> u64 in Trapping {
        let body: StateItem = SyntaxTrees::state_item(syntax, item.first_state + next_state);
        transition { _ -> statement(resolver, syntax, item, state, position, body.first_statement, body.first_statement + body.statement_count, next_state + 1, found, disagreed) }
    }

    machine answer(found: u64 in Trapping, disagreed: bool) -> u64 in Trapping {
        transition disagreed {
            true -> none()
            _ -> some(found)
        }
    }

    machine some(found: u64 in Trapping) -> u64 in Trapping {
        found
    }

    machine none() -> u64 in Trapping {
        0
    }
}

// The entry subject (offset plus one) arm `written` passes to formal
// `position` of state `state`: zero unless its target calls that state
// with, at `position`, a name of an entry parameter or of a formal
// already carrying one.
machine Resolver::passed_subject(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping, written: TransitionArm) -> u64 in Trapping
crashes Trap
{
    transition written.target_kind == ArmTargetKind::Call {
        true -> call(resolver, syntax, item, state, position, written.target)
        _ -> none()
    }

    machine call(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping, target: u64 in Trapping) -> u64 in Trapping {
        let expression: Expression = SyntaxTrees::expression(syntax, target);
        let callee: ValueBinding = NameResolution::value_binding_at(&resolver.output, expression.left);
        transition callee {
            ValueBinding::State { handle } -> this_state(resolver, syntax, item, state, position, expression, handle)
            _ -> none()
        }
    }

    machine this_state(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, state: u64 in Trapping, position: u64 in Trapping, expression: Expression, handle: u64 in Trapping) -> u64 in Trapping {
        transition handle == state && position < expression.count {
            true -> argument(resolver, syntax, item, expression, position)
            _ -> none()
        }
    }

    machine argument(resolver: &Resolver, syntax: &SyntaxTrees, item: MachineItem, expression: Expression, position: u64 in Trapping) -> u64 in Trapping {
        let node: u64 in Trapping = SyntaxTrees::argument(syntax, expression.first + position);
        let written: Expression = SyntaxTrees::expression(syntax, node);
        let binding: ValueBinding = NameResolution::value_binding_at(&resolver.output, node);
        transition written.kind == ExpressionKind::Name {
            true -> named(resolver, item, binding)
            _ -> none()
        }
    }

    machine named(resolver: &Resolver, item: MachineItem, binding: ValueBinding) -> u64 in Trapping {
        transition binding {
            ValueBinding::Parameter { parameter } -> parameter_of(resolver, item, parameter)
            _ -> none()
        }
    }

    // An entry parameter is its own subject; a state formal carries what it
    // was bound to carry, zero while unknown.
    machine parameter_of(resolver: &Resolver, item: MachineItem, parameter: u64 in Trapping) -> u64 in Trapping {
        let entry: bool = parameter >= item.first_parameter && parameter - item.first_parameter < item.parameter_count;
        transition entry {
            true -> some(parameter - item.first_parameter + 1)
            _ -> some(NameResolution::rank_carrier(&resolver.output, parameter))
        }
    }

    machine some(found: u64 in Trapping) -> u64 in Trapping {
        found
    }

    machine none() -> u64 in Trapping {
        0
    }
}

// The offset plus one of the parameter in `first .. first + count` spelled
// as parameter `handle`; zero for none.
machine Resolver::same_spelled_parameter(sources: &SourceSet, syntax: &SyntaxTrees, handle: u64 in Trapping, first: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let wanted: Parameter = SyntaxTrees::parameter(syntax, handle);
    transition { _ -> next(sources, syntax, wanted, first, count, 0) }

    machine next(sources: &SourceSet, syntax: &SyntaxTrees, wanted: Parameter, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) -> u64 in Trapping {
        transition offset < count {
            true -> compare(sources, syntax, wanted, first, count, offset)
            _ -> none()
        }
    }

    machine compare(sources: &SourceSet, syntax: &SyntaxTrees, wanted: Parameter, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) -> u64 in Trapping {
        let candidate: Parameter = SyntaxTrees::parameter(syntax, first + offset);
        let same: bool = SourceSet::spans_equal(sources, wanted.name.source_span, candidate.name.source_span);
        transition same {
            true -> found(offset + 1)
            _ -> next(sources, syntax, wanted, first, count, offset + 1)
        }
    }

    machine found(carried: u64 in Trapping) -> u64 in Trapping {
        carried
    }

    machine none() -> u64 in Trapping {
        0
    }
}

machine Resolver::set_requirement(resolver: &mut Resolver, clause: u64 in Trapping, binding: ValueBinding)
crashes Trap
{
    transition clause < 2048 {
        true -> store(resolver, clause, binding)
        _ -> invalid()
    }

    machine store(resolver: &mut Resolver, clause: u64 in Trapping, binding: ValueBinding)
    requires clause < 2048
    {
        resolver.output.requirements[clause] = binding;
    }

    machine invalid() {
        crash Trap;
    }
}
