use psi::resolution::resolution;
use psi::source::source;
use psi::syntax::syntax;

// Name resolution over the parsed roots of one source unit. The pass runs in
// fail-closed steps, each completing before the next begins: imports,
// top-level data names, member namespaces, data type references, machine
// signature type references, body type references (`let` types and cast
// targets), then machine namespaces. The first rejection is
// the diagnostic. Lookup mirrors the reference resolver: an
// enclosing generic parameter, then a builtin type, then a data declaration
// of this unit. Builtin and duplicate declarations reject before any lookup,
// so the builtin and data tiers never compete for one spelling.
//
// The unit is the whole compilation's source set. A `use` therefore names a
// source outside that set and rejects; supplying more sources is the
// compiler request's job, not resolution's.
pub data Resolver {
    output: NameResolution;
    source: SourceId;
}

pub machine Resolver::initialize(resolver: &mut Resolver, source: SourceId) {
    NameResolution::clear(&mut resolver.output, source);
    resolver.source = source;
}

pub machine Resolver::resolve(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees)
crashes Trap
{
    NameResolution::clear(&mut resolver.output, resolver.source);
    transition syntax.use_count > 0 {
        true -> unresolved_import(resolver, syntax)
        _ -> declarations(resolver, source_unit, syntax)
    }

    state unresolved_import(resolver: &mut Resolver, syntax: &SyntaxTrees) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnresolvedImport,
            syntax.uses[0].source_span
        );
    }

    state declarations(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees) {
        Resolver::declare_data(resolver, source_unit, syntax);
        transition resolver.output.accepted {
            true -> members(resolver, source_unit, syntax)
            _ -> done()
        }
    }

    state members(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees) {
        Resolver::check_members(resolver, source_unit, syntax);
        transition resolver.output.accepted {
            true -> references(resolver, source_unit, syntax)
            _ -> done()
        }
    }

    state references(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees) {
        Resolver::bind_references(resolver, source_unit, syntax);
        transition resolver.output.accepted {
            true -> machine_references(resolver, source_unit, syntax)
            _ -> done()
        }
    }

    state machine_references(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees) {
        Resolver::bind_machine_references(resolver, source_unit, syntax);
        transition resolver.output.accepted {
            true -> body_references(resolver, source_unit, syntax)
            _ -> done()
        }
    }

    state body_references(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees) {
        Resolver::bind_body_references(resolver, source_unit, syntax);
        transition resolver.output.accepted {
            true -> machines(resolver, source_unit, syntax)
            _ -> done()
        }
    }

    state machines(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees) {
        Resolver::check_machines(resolver, source_unit, syntax);
        transition resolver.output.accepted {
            true -> publish(resolver, syntax)
            _ -> done()
        }
    }

    state publish(resolver: &mut Resolver, syntax: &SyntaxTrees) {
        resolver.output.binding_count = syntax.type_reference_count;
    }

    state done() {}
}

// Top-level data names. A name that spells a builtin type rejects: references
// would bind the builtin and the declaration could never be named. A name an
// earlier declaration already took rejects at the later declaration.
machine Resolver::declare_data(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, source_unit, syntax, 0) }

    state next(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.data_count {
            true -> builtin_shadow(resolver, source_unit, syntax, index)
            _ -> done()
        }
    }

    state builtin_shadow(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, index);
        let builtin: TypeBinding = Resolver::builtin_type(source_unit, item.name.source_span.span);
        transition builtin {
            TypeBinding::Unresolved -> earlier(resolver, source_unit, syntax, index, item.name, 0)
            _ -> reject(resolver, ResolveDiagnosticCode::DataShadowsBuiltinType, item.name)
        }
    }

    state earlier(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < index {
            true -> compare(resolver, source_unit, syntax, index, name, prior)
            _ -> next(resolver, source_unit, syntax, index + 1)
        }
    }

    state compare(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_item: DataItem = SyntaxTrees::data_item(syntax, prior);
        let equal: bool = SourceUnit::spans_equal(source_unit, name.source_span.span,
            prior_item.name.source_span.span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateData, name)
            _ -> earlier(resolver, source_unit, syntax, index, name, prior + 1)
        }
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    state done() {}
}

// Member namespaces of each data declaration. Direct fields and cases share
// one namespace in authored order. Each case's payload fields have their own
// namespace, which the declaration's direct (common) fields also occupy.
machine Resolver::check_members(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, source_unit, syntax, 0) }

    state next_data(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        transition data_index < syntax.data_count {
            true -> data_members(resolver, source_unit, syntax, data_index)
            _ -> done()
        }
    }

    state data_members(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, data_index);
        transition { _ -> generic(resolver, source_unit, syntax, data_index, item, 0) }
    }

    // Generic parameters of every kind share one namespace.
    state generic(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.generic_parameter_count {
            true -> generic_named(resolver, source_unit, syntax, data_index, item, offset)
            _ -> member(resolver, source_unit, syntax, data_index, item, 0)
        }
    }

    state generic_named(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, item.first_generic_parameter + offset);
        transition { _ -> generic_prior(resolver, source_unit, syntax, data_index, item, offset, parameter.name, 0) }
    }

    state generic_prior(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < offset {
            true -> generic_compare(resolver, source_unit, syntax, data_index, item, offset, name, prior)
            _ -> generic(resolver, source_unit, syntax, data_index, item, offset + 1)
        }
    }

    state generic_compare(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, item.first_generic_parameter + prior);
        let equal: bool = SourceUnit::spans_equal(source_unit, name.source_span.span,
            prior_parameter.name.source_span.span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateGenericParameter, name)
            _ -> generic_prior(resolver, source_unit, syntax, data_index, item, offset, name, prior + 1)
        }
    }

    state member(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.member_count {
            true -> member_named(resolver, source_unit, syntax, data_index, item, offset)
            _ -> cases(resolver, source_unit, syntax, data_index, item, 0)
        }
    }

    state member_named(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let data_member: DataMember = SyntaxTrees::data_member(syntax, item.first_member + offset);
        let name: IdentifierSpan = SyntaxTrees::member_name(syntax, data_member);
        transition { _ -> member_prior(resolver, source_unit, syntax, data_index, item, offset, name, 0) }
    }

    state member_prior(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < offset {
            true -> member_compare(resolver, source_unit, syntax, data_index, item, offset, name, prior)
            _ -> member(resolver, source_unit, syntax, data_index, item, offset + 1)
        }
    }

    state member_compare(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_member: DataMember = SyntaxTrees::data_member(syntax, item.first_member + prior);
        let prior_name: IdentifierSpan = SyntaxTrees::member_name(syntax, prior_member);
        let equal: bool = SourceUnit::spans_equal(source_unit, name.source_span.span,
            prior_name.source_span.span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateDataMember, name)
            _ -> member_prior(resolver, source_unit, syntax, data_index, item, offset, name, prior + 1)
        }
    }

    state cases(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) {
        transition case_offset < item.case_count {
            true -> case_payload(resolver, source_unit, syntax, data_index, item, case_offset)
            _ -> next_data(resolver, source_unit, syntax, data_index + 1)
        }
    }

    state case_payload(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, item.first_case + case_offset);
        transition { _ -> payload(resolver, source_unit, syntax, data_index, item, case_offset, data_case, 0) }
    }

    state payload(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        transition field_offset < data_case.payload_field_count {
            true -> payload_named(resolver, source_unit, syntax, data_index, item, case_offset, data_case, field_offset)
            _ -> cases(resolver, source_unit, syntax, data_index, item, case_offset + 1)
        }
    }

    state payload_named(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        let field: DataField = SyntaxTrees::payload_field(syntax, data_case.first_payload_field + field_offset);
        transition { _ -> payload_prior(resolver, source_unit, syntax, data_index, item, case_offset, data_case, field_offset, field.name, 0) }
    }

    state payload_prior(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < field_offset {
            true -> payload_compare(resolver, source_unit, syntax, data_index, item, case_offset, data_case, field_offset, name, prior)
            _ -> common(resolver, source_unit, syntax, data_index, item, case_offset, data_case, field_offset, name, 0)
        }
    }

    state payload_compare(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_field: DataField = SyntaxTrees::payload_field(syntax, data_case.first_payload_field + prior);
        let equal: bool = SourceUnit::spans_equal(source_unit, name.source_span.span,
            prior_field.name.source_span.span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateCasePayloadField, name)
            _ -> payload_prior(resolver, source_unit, syntax, data_index, item, case_offset, data_case, field_offset, name, prior + 1)
        }
    }

    state common(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, common_offset: u64 in Trapping) {
        transition common_offset < item.field_count {
            true -> common_compare(resolver, source_unit, syntax, data_index, item, case_offset, data_case, field_offset, name, common_offset)
            _ -> payload(resolver, source_unit, syntax, data_index, item, case_offset, data_case, field_offset + 1)
        }
    }

    state common_compare(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, common_offset: u64 in Trapping) {
        let common_field: DataField = SyntaxTrees::field(syntax, item.first_field + common_offset);
        let equal: bool = SourceUnit::spans_equal(source_unit, name.source_span.span,
            common_field.name.source_span.span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::PayloadFieldCollidesWithCommonField, name)
            _ -> common(resolver, source_unit, syntax, data_index, item, case_offset, data_case, field_offset, name, common_offset + 1)
        }
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    state done() {}
}

// Type references of each data declaration: its generic-parameter
// annotations, then its members' references in authored order. Every type
// reference has exactly one owner, so this walk binds the whole table.
machine Resolver::bind_references(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, source_unit, syntax, 0) }

    state next_data(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        transition data_index < syntax.data_count {
            true -> data_references(resolver, source_unit, syntax, data_index)
            _ -> done()
        }
    }

    state data_references(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, data_index);
        transition { _ -> generic(resolver, source_unit, syntax, data_index, item, 0) }
    }

    state generic(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.generic_parameter_count {
            true -> generic_annotation(resolver, source_unit, syntax, data_index, item, offset)
            _ -> member(resolver, source_unit, syntax, data_index, item, 0)
        }
    }

    state generic_annotation(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax,
            item.first_generic_parameter + offset
        );
        transition parameter.has_type_reference {
            true -> bind_generic(resolver, source_unit, syntax, data_index, item, offset, parameter.type_reference)
            _ -> generic(resolver, source_unit, syntax, data_index, item, offset + 1)
        }
    }

    state bind_generic(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, reference: u64 in Trapping) {
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::bind_type_reference(resolver, source_unit, syntax, scope, reference);
        transition resolver.output.accepted {
            true -> generic(resolver, source_unit, syntax, data_index, item, offset + 1)
            _ -> done()
        }
    }

    state member(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.member_count {
            true -> member_kind(resolver, source_unit, syntax, data_index, item, offset)
            _ -> next_data(resolver, source_unit, syntax, data_index + 1)
        }
    }

    state member_kind(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let data_member: DataMember = SyntaxTrees::data_member(syntax, item.first_member + offset);
        transition data_member.kind {
            DataMemberKind::Field -> field_reference(resolver, source_unit, syntax, data_index, item, offset, data_member.item_index)
            DataMemberKind::Case -> case_references(resolver, source_unit, syntax, data_index, item, offset, data_member.item_index)
        }
    }

    state field_reference(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, handle: u64 in Trapping) {
        let field: DataField = SyntaxTrees::field(syntax, handle);
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::bind_type_reference(resolver, source_unit, syntax, scope, field.type_reference);
        transition resolver.output.accepted {
            true -> member(resolver, source_unit, syntax, data_index, item, offset + 1)
            _ -> done()
        }
    }

    state case_references(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, handle: u64 in Trapping) {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, handle);
        transition { _ -> payload(resolver, source_unit, syntax, data_index, item, offset, data_case, 0) }
    }

    state payload(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        transition field_offset < data_case.payload_field_count {
            true -> payload_reference(resolver, source_unit, syntax, data_index, item, offset, data_case, field_offset)
            _ -> member(resolver, source_unit, syntax, data_index, item, offset + 1)
        }
    }

    state payload_reference(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        let field: DataField = SyntaxTrees::payload_field(syntax, data_case.first_payload_field + field_offset);
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::bind_type_reference(resolver, source_unit, syntax, scope, field.type_reference);
        transition resolver.output.accepted {
            true -> payload(resolver, source_unit, syntax, data_index, item, offset, data_case, field_offset + 1)
            _ -> done()
        }
    }

    state done() {}
}

// A data declaration's type scope: its own generic parameters.
machine Resolver::data_scope(item: DataItem) -> TypeScope {
    TypeScope {
        first_generic_parameter: item.first_generic_parameter,
        generic_parameter_count: item.generic_parameter_count
    }
}

// Bind one type in its owner's scope. A type fills a contiguous run of
// rows that ends at its root, so every row of the run binds in order: a
// named row binds its name and an `in` domain, and a reference, array, slice
// or integer row binds by its form. Nested rows need no recursion.
machine Resolver::bind_type_reference(
    resolver: &mut Resolver,
    source_unit: &SourceUnit,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    root: u64 in Trapping
)
crashes Trap
{
    let root_row: TypeReference = SyntaxTrees::type_reference(syntax, root);
    transition { _ -> next(resolver, source_unit, syntax, scope, root, root_row.first_row) }

    state next(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        root: u64 in Trapping,
        row: u64 in Trapping
    ) {
        transition row <= root && resolver.output.accepted {
            true -> bind(resolver, source_unit, syntax, scope, root, row)
            _ -> done()
        }
    }

    state bind(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        root: u64 in Trapping,
        row: u64 in Trapping
    ) {
        Resolver::bind_type_row(resolver, source_unit, syntax, scope, row);
        transition { _ -> next(resolver, source_unit, syntax, scope, root, row + 1) }
    }

    state done() {}
}

machine Resolver::bind_type_row(
    resolver: &mut Resolver,
    source_unit: &SourceUnit,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    row: u64 in Trapping
)
crashes Trap
{
    let type_reference: TypeReference = SyntaxTrees::type_reference(syntax, row);
    transition type_reference.kind {
        TypeReferenceKind::Named -> named(resolver, source_unit, syntax, scope, row, type_reference)
        TypeReferenceKind::Reference -> formed(resolver, source_unit, row, type_reference, TypeBinding::Reference)
        TypeReferenceKind::Array -> formed(resolver, source_unit, row, type_reference, TypeBinding::Array)
        TypeReferenceKind::Slice -> formed(resolver, source_unit, row, type_reference, TypeBinding::Slice)
        TypeReferenceKind::Literal -> formed(resolver, source_unit, row, type_reference, TypeBinding::Literal)
    }

    state named(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        type_reference: TypeReference
    ) {
        let binding: TypeBinding = Resolver::type_binding(source_unit, syntax, scope,
            type_reference.name.source_span.span
        );
        transition binding {
            TypeBinding::Unresolved -> unknown_type(resolver, type_reference.name)
            _ -> formed(resolver, source_unit, row, type_reference, binding)
        }
    }

    state formed(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        row: u64 in Trapping,
        type_reference: TypeReference,
        binding: TypeBinding
    ) {
        transition row < 4096 {
            true -> store(resolver, source_unit, row, type_reference, binding)
            _ -> invalid()
        }
    }

    state store(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        row: u64 in Trapping,
        type_reference: TypeReference,
        binding: TypeBinding
    ) {
        resolver.output.type_bindings[row] = binding;
        transition type_reference.has_domain {
            true -> qualified(resolver, source_unit, row, type_reference.domain)
            _ -> unqualified(resolver, row)
        }
    }

    state unqualified(resolver: &mut Resolver, row: u64 in Trapping) {
        transition row < 4096 {
            true -> unqualified_store(resolver, row)
            _ -> invalid()
        }
    }

    state unqualified_store(resolver: &mut Resolver, row: u64 in Trapping) {
        resolver.output.domain_bindings[row] = DomainBinding::Unqualified;
    }

    state qualified(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        row: u64 in Trapping,
        domain: IdentifierSpan
    ) {
        Resolver::bind_domain(resolver, source_unit, row, domain);
    }

    state unknown_type(resolver: &mut Resolver, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnknownDataType,
            name.source_span
        );
    }

    state invalid() {
        crash Trap;
    }
}

// The declaration a type name denotes in `scope`: an enclosing generic
// parameter by spelling (lifetimes are not type names), then a builtin type,
// then a data declaration of this unit.
machine Resolver::type_binding(
    source_unit: &SourceUnit,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    name: Span
) -> TypeBinding
crashes Trap
{
    transition { _ -> generic(source_unit, syntax, scope, name, 0) }

    state generic(source_unit: &SourceUnit, syntax: &SyntaxTrees, scope: TypeScope, name: Span, offset: u64 in Trapping) {
        transition offset < scope.generic_parameter_count {
            true -> generic_kind(source_unit, syntax, scope, name, offset)
            _ -> builtin(source_unit, syntax, name)
        }
    }

    state generic_kind(
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        name: Span,
        offset: u64 in Trapping
    ) {
        let handle: u64 in Trapping = scope.first_generic_parameter + offset;
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, handle);
        transition parameter.kind {
            GenericParameterKind::Lifetime -> generic(source_unit, syntax, scope, name, offset + 1)
            _ -> generic_compare(source_unit, syntax, scope, name, offset, handle, parameter.name)
        }
    }

    state generic_compare(
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        name: Span,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        parameter_name: IdentifierSpan
    ) {
        let equal: bool = SourceUnit::spans_equal(source_unit, name, parameter_name.source_span.span);
        transition equal {
            true -> generic_found(handle)
            _ -> generic(source_unit, syntax, scope, name, offset + 1)
        }
    }

    state generic_found(parameter: u64 in Trapping) {
        TypeBinding::GenericParameter { parameter: parameter }
    }

    state builtin(source_unit: &SourceUnit, syntax: &SyntaxTrees, name: Span) {
        let binding: TypeBinding = Resolver::builtin_type(source_unit, name);
        transition binding {
            TypeBinding::Unresolved -> data(source_unit, syntax, name, 0)
            _ -> found(binding)
        }
    }

    state found(binding: TypeBinding) {
        binding
    }

    state data(source_unit: &SourceUnit, syntax: &SyntaxTrees, name: Span, index: u64 in Trapping) {
        transition index < syntax.data_count {
            true -> data_compare(source_unit, syntax, name, index)
            _ -> unresolved()
        }
    }

    state data_compare(source_unit: &SourceUnit, syntax: &SyntaxTrees, name: Span, index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, index);
        let equal: bool = SourceUnit::spans_equal(source_unit, name, item.name.source_span.span);
        transition equal {
            true -> data_found(index)
            _ -> data(source_unit, syntax, name, index + 1)
        }
    }

    state data_found(index: u64 in Trapping) {
        TypeBinding::Data { item: index }
    }

    state unresolved() {
        TypeBinding::Unresolved
    }
}

// The compiler-known domain an `in` qualifier names. Generic parameters do
// not bind domains, and no other domain can be declared in the current
// grammar, so any other spelling rejects.
machine Resolver::bind_domain(
    resolver: &mut Resolver,
    source_unit: &SourceUnit,
    reference: u64 in Trapping,
    domain: IdentifierSpan
)
// The caller binds only references it has bounded by the syntax table.
requires reference < 4096
crashes Trap
{
    let matched: bool = SourceUnit::span_spells(source_unit, domain.source_span.span, "Wrapping");
    transition matched {
        true -> bind(resolver, reference, DomainBinding::Wrapping)
        _ -> saturating(resolver, source_unit, reference, domain)
    }

    state saturating(resolver: &mut Resolver, source_unit: &SourceUnit, reference: u64 in Trapping, domain: IdentifierSpan) {
        let matched: bool = SourceUnit::span_spells(source_unit, domain.source_span.span, "Saturating");
        transition matched {
            true -> bind(resolver, reference, DomainBinding::Saturating)
            _ -> trapping(resolver, source_unit, reference, domain)
        }
    }

    state trapping(resolver: &mut Resolver, source_unit: &SourceUnit, reference: u64 in Trapping, domain: IdentifierSpan) {
        let matched: bool = SourceUnit::span_spells(source_unit, domain.source_span.span, "Trapping");
        transition matched {
            true -> bind(resolver, reference, DomainBinding::Trapping)
            _ -> finite(resolver, source_unit, reference, domain)
        }
    }

    state finite(resolver: &mut Resolver, source_unit: &SourceUnit, reference: u64 in Trapping, domain: IdentifierSpan) {
        let matched: bool = SourceUnit::span_spells(source_unit, domain.source_span.span, "Finite");
        transition matched {
            true -> bind(resolver, reference, DomainBinding::Finite)
            _ -> unknown(resolver, domain)
        }
    }

    state bind(resolver: &mut Resolver, reference: u64 in Trapping, binding: DomainBinding) {
        resolver.output.domain_bindings[reference] = binding;
    }

    state unknown(resolver: &mut Resolver, domain: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnknownDomain,
            domain.source_span
        );
    }
}

// The compiler-installed type a name spells, or `Unresolved`. Builtin names
// are not source declarations, so they match by spelling, not by span.
machine Resolver::builtin_type(source_unit: &SourceUnit, name: Span) -> TypeBinding {
    let matched: bool = SourceUnit::span_spells(source_unit, name, "bool");
    transition matched { true -> found(BuiltinType::Bool) _ -> spells_i8(source_unit, name) }

    state spells_i8(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "i8");
        transition matched { true -> found(BuiltinType::I8) _ -> spells_i16(source_unit, name) }
    }

    state spells_i16(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "i16");
        transition matched { true -> found(BuiltinType::I16) _ -> spells_i32(source_unit, name) }
    }

    state spells_i32(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "i32");
        transition matched { true -> found(BuiltinType::I32) _ -> spells_i64(source_unit, name) }
    }

    state spells_i64(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "i64");
        transition matched { true -> found(BuiltinType::I64) _ -> spells_u8(source_unit, name) }
    }

    state spells_u8(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "u8");
        transition matched { true -> found(BuiltinType::U8) _ -> spells_u16(source_unit, name) }
    }

    state spells_u16(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "u16");
        transition matched { true -> found(BuiltinType::U16) _ -> spells_u32(source_unit, name) }
    }

    state spells_u32(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "u32");
        transition matched { true -> found(BuiltinType::U32) _ -> spells_u64(source_unit, name) }
    }

    state spells_u64(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "u64");
        transition matched { true -> found(BuiltinType::U64) _ -> spells_addr(source_unit, name) }
    }

    state spells_addr(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "addr");
        transition matched { true -> found(BuiltinType::Address) _ -> spells_f32(source_unit, name) }
    }

    state spells_f32(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "f32");
        transition matched { true -> found(BuiltinType::F32) _ -> spells_f64(source_unit, name) }
    }

    state spells_f64(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "f64");
        transition matched { true -> found(BuiltinType::F64) _ -> spells_slice(source_unit, name) }
    }

    state spells_slice(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "Slice");
        transition matched { true -> found(BuiltinType::Slice) _ -> spells_result(source_unit, name) }
    }

    state spells_result(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "Result");
        transition matched { true -> found(BuiltinType::Result) _ -> spells_syscallresult(source_unit, name) }
    }

    state spells_syscallresult(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "SyscallResult");
        transition matched { true -> found(BuiltinType::SyscallResult) _ -> spells_terminal(source_unit, name) }
    }

    state spells_terminal(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "Terminal");
        transition matched { true -> found(BuiltinType::Terminal) _ -> spells_never(source_unit, name) }
    }

    state spells_never(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "Never");
        transition matched { true -> found(BuiltinType::Never) _ -> spells_uint(source_unit, name) }
    }

    state spells_uint(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "UInt");
        transition matched { true -> found(BuiltinType::UInt) _ -> spells_int(source_unit, name) }
    }

    state spells_int(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "Int");
        transition matched { true -> found(BuiltinType::Int) _ -> spells_atomicbool(source_unit, name) }
    }

    state spells_atomicbool(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "AtomicBool");
        transition matched { true -> found(BuiltinType::AtomicBool) _ -> spells_atomicu32(source_unit, name) }
    }

    state spells_atomicu32(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "AtomicU32");
        transition matched { true -> found(BuiltinType::AtomicU32) _ -> spells_atomicu64(source_unit, name) }
    }

    state spells_atomicu64(source_unit: &SourceUnit, name: Span) {
        let matched: bool = SourceUnit::span_spells(source_unit, name, "AtomicU64");
        transition matched { true -> found(BuiltinType::AtomicU64) _ -> absent() }
    }

    state found(builtin: BuiltinType) {
        TypeBinding::Builtin { builtin: builtin }
    }

    state absent() {
        TypeBinding::Unresolved
    }
}

// Machine signatures: each machine's parameter and return types, then each
// state's. Machines declare no generics in this grammar slice, so every name
// resolves in the empty scope.
machine Resolver::bind_machine_references(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_machine(resolver, source_unit, syntax, 0) }

    state next_machine(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> machine_signature(resolver, source_unit, syntax, index)
            _ -> done()
        }
    }

    state machine_signature(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        Resolver::bind_signature(resolver, source_unit, syntax, item.first_parameter, item.parameter_count,
            item.has_return_type, item.return_type
        );
        transition resolver.output.accepted {
            true -> state_signature(resolver, source_unit, syntax, index, item, 0)
            _ -> done()
        }
    }

    state state_signature(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < item.state_count {
            true -> bind_state(resolver, source_unit, syntax, index, item, offset)
            _ -> next_machine(resolver, source_unit, syntax, index + 1)
        }
    }

    state bind_state(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        Resolver::bind_signature(resolver, source_unit, syntax, state_item.first_parameter,
            state_item.parameter_count, state_item.has_return_type, state_item.return_type
        );
        transition resolver.output.accepted {
            true -> state_signature(resolver, source_unit, syntax, index, item, offset + 1)
            _ -> done()
        }
    }

    state done() {}
}

// One signature's parameter types, then its return type when present.
machine Resolver::bind_signature(
    resolver: &mut Resolver,
    source_unit: &SourceUnit,
    syntax: &SyntaxTrees,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping,
    has_return_type: bool,
    return_type: u64 in Trapping
)
crashes Trap
{
    transition { _ -> parameter(resolver, source_unit, syntax, first_parameter, parameter_count, has_return_type, return_type, 0) }

    state parameter(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        has_return_type: bool,
        return_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < parameter_count {
            true -> bind_parameter(resolver, source_unit, syntax, first_parameter, parameter_count, has_return_type, return_type, offset)
            _ -> result(resolver, source_unit, syntax, has_return_type, return_type)
        }
    }

    state bind_parameter(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        has_return_type: bool,
        return_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + offset);
        let scope: TypeScope = Resolver::empty_scope();
        Resolver::bind_type_reference(resolver, source_unit, syntax, scope, parameter.type_reference);
        transition resolver.output.accepted {
            true -> parameter(resolver, source_unit, syntax, first_parameter, parameter_count, has_return_type, return_type, offset + 1)
            _ -> done()
        }
    }

    state result(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        has_return_type: bool,
        return_type: u64 in Trapping
    ) {
        transition has_return_type {
            true -> bind_result(resolver, source_unit, syntax, return_type)
            _ -> done()
        }
    }

    state bind_result(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, return_type: u64 in Trapping) {
        let scope: TypeScope = Resolver::empty_scope();
        Resolver::bind_type_reference(resolver, source_unit, syntax, scope, return_type);
    }

    state done() {}
}

machine Resolver::empty_scope() -> TypeScope {
    TypeScope { first_generic_parameter: 0, generic_parameter_count: 0 }
}

// Machine namespaces. Each signature's parameter names are distinct, and
// a machine's state names are distinct; a state may repeat the machine's own
// name and its parameters' names. Two machines may share an owner and name
// only as overloads: identical parameter types make the later one a
// duplicate.
machine Resolver::check_machines(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_machine(resolver, source_unit, syntax, 0) }

    state next_machine(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> machine_parameters(resolver, source_unit, syntax, index)
            _ -> done()
        }
    }

    state machine_parameters(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        Resolver::check_parameter_names(resolver, source_unit, syntax, item.first_parameter, item.parameter_count);
        transition resolver.output.accepted {
            true -> state_names(resolver, source_unit, syntax, index, item, 0)
            _ -> done()
        }
    }

    state state_names(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < item.state_count {
            true -> state_name(resolver, source_unit, syntax, index, item, offset)
            _ -> overloads(resolver, source_unit, syntax, index, item, 0)
        }
    }

    state state_name(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        Resolver::check_parameter_names(resolver, source_unit, syntax, state_item.first_parameter,
            state_item.parameter_count
        );
        transition resolver.output.accepted {
            true -> state_prior(resolver, source_unit, syntax, index, item, offset, state_item.name, 0)
            _ -> done()
        }
    }

    state state_prior(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        prior: u64 in Trapping
    ) {
        transition prior < offset {
            true -> state_compare(resolver, source_unit, syntax, index, item, offset, name, prior)
            _ -> state_names(resolver, source_unit, syntax, index, item, offset + 1)
        }
    }

    state state_compare(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        prior: u64 in Trapping
    ) {
        let prior_state: StateItem = SyntaxTrees::state_item(syntax, item.first_state + prior);
        let equal: bool = SourceUnit::spans_equal(source_unit, name.source_span.span,
            prior_state.name.source_span.span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateState, name)
            _ -> state_prior(resolver, source_unit, syntax, index, item, offset, name, prior + 1)
        }
    }

    state overloads(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        prior: u64 in Trapping
    ) {
        transition prior < index {
            true -> overload_compare(resolver, source_unit, syntax, index, item, prior)
            _ -> next_machine(resolver, source_unit, syntax, index + 1)
        }
    }

    state overload_compare(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        prior: u64 in Trapping
    ) {
        let prior_item: MachineItem = SyntaxTrees::machine_item(syntax, prior);
        let same: bool = Resolver::same_machine_signature(resolver, source_unit, syntax, item, prior_item);
        transition same {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateMachine, item.name)
            _ -> overloads(resolver, source_unit, syntax, index, item, prior + 1)
        }
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    state done() {}
}

// Each parameter name of one signature differs from every earlier one.
machine Resolver::check_parameter_names(
    resolver: &mut Resolver,
    source_unit: &SourceUnit,
    syntax: &SyntaxTrees,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping
)
crashes Trap
{
    transition { _ -> next(resolver, source_unit, syntax, first_parameter, parameter_count, 0) }

    state next(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < parameter_count {
            true -> named(resolver, source_unit, syntax, first_parameter, parameter_count, offset)
            _ -> done()
        }
    }

    state named(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + offset);
        transition { _ -> prior(resolver, source_unit, syntax, first_parameter, parameter_count, offset, parameter.name, 0) }
    }

    state prior(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        earlier: u64 in Trapping
    ) {
        transition earlier < offset {
            true -> compare(resolver, source_unit, syntax, first_parameter, parameter_count, offset, name, earlier)
            _ -> next(resolver, source_unit, syntax, first_parameter, parameter_count, offset + 1)
        }
    }

    state compare(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        earlier: u64 in Trapping
    ) {
        let earlier_parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + earlier);
        let equal: bool = SourceUnit::spans_equal(source_unit, name.source_span.span,
            earlier_parameter.name.source_span.span
        );
        transition equal {
            true -> duplicate(resolver, name)
            _ -> prior(resolver, source_unit, syntax, first_parameter, parameter_count, offset, name, earlier + 1)
        }
    }

    state duplicate(resolver: &mut Resolver, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::DuplicateParameter, name.source_span);
    }

    state done() {}
}

// Whether two machines declare the same overload: the same owner (or none),
// the same name and the same parameter types, position by position.
machine Resolver::same_machine_signature(
    resolver: &Resolver,
    source_unit: &SourceUnit,
    syntax: &SyntaxTrees,
    left: MachineItem,
    right: MachineItem
) -> bool
crashes Trap
{
    let same_name: bool = SourceUnit::spans_equal(source_unit, left.name.source_span.span,
        right.name.source_span.span
    );
    transition same_name && left.has_owner == right.has_owner && left.parameter_count == right.parameter_count {
        true -> owner(resolver, source_unit, syntax, left, right)
        _ -> different()
    }

    state owner(resolver: &Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, left: MachineItem, right: MachineItem) {
        let same_owner: bool = SourceUnit::spans_equal(source_unit, left.owner.source_span.span,
            right.owner.source_span.span
        );
        transition same_owner {
            true -> parameter(resolver, source_unit, syntax, left, right, 0)
            _ -> different()
        }
    }

    state parameter(
        resolver: &Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        left: MachineItem,
        right: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < left.parameter_count {
            true -> compare(resolver, source_unit, syntax, left, right, offset)
            _ -> same()
        }
    }

    state compare(
        resolver: &Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        left: MachineItem,
        right: MachineItem,
        offset: u64 in Trapping
    ) {
        let left_parameter: Parameter = SyntaxTrees::parameter(syntax, left.first_parameter + offset);
        let right_parameter: Parameter = SyntaxTrees::parameter(syntax, right.first_parameter + offset);
        let equal: bool = Resolver::same_type(resolver, source_unit, syntax, left_parameter.type_reference,
            right_parameter.type_reference
        );
        transition equal {
            true -> parameter(resolver, source_unit, syntax, left, right, offset + 1)
            _ -> different()
        }
    }

    state same() {
        true
    }

    state different() {
        false
    }
}

// Whether two bound types are the same type. A run lists a type's rows
// children-first, and each form fixes its child count, so two runs denote the
// same type exactly when they have the same length and agree row by row in
// form, access, argument count, binding and domain. Integer rows compare by
// spelling until static evaluation lands.
machine Resolver::same_type(
    resolver: &Resolver,
    source_unit: &SourceUnit,
    syntax: &SyntaxTrees,
    left: u64 in Trapping,
    right: u64 in Trapping
) -> bool
crashes Trap
{
    let left_root: TypeReference = SyntaxTrees::type_reference(syntax, left);
    let right_root: TypeReference = SyntaxTrees::type_reference(syntax, right);
    transition left - left_root.first_row == right - right_root.first_row {
        true -> rows(resolver, source_unit, syntax, left_root.first_row, right_root.first_row, left)
        _ -> different()
    }

    state rows(
        resolver: &Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        left_row: u64 in Trapping,
        right_row: u64 in Trapping,
        left_root: u64 in Trapping
    ) {
        transition left_row <= left_root {
            true -> row(resolver, source_unit, syntax, left_row, right_row, left_root)
            _ -> equal()
        }
    }

    state row(
        resolver: &Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        left_row: u64 in Trapping,
        right_row: u64 in Trapping,
        left_root: u64 in Trapping
    ) {
        let same: bool = Resolver::same_type_row(resolver, source_unit, syntax, left_row, right_row);
        transition same {
            true -> rows(resolver, source_unit, syntax, left_row + 1, right_row + 1, left_root)
            _ -> different()
        }
    }

    state equal() {
        true
    }

    state different() {
        false
    }
}

machine Resolver::same_type_row(
    resolver: &Resolver,
    source_unit: &SourceUnit,
    syntax: &SyntaxTrees,
    left: u64 in Trapping,
    right: u64 in Trapping
) -> bool
crashes Trap
{
    let left_row: TypeReference = SyntaxTrees::type_reference(syntax, left);
    let right_row: TypeReference = SyntaxTrees::type_reference(syntax, right);
    transition left_row.kind == right_row.kind && left_row.access == right_row.access
        && left_row.argument_count == right_row.argument_count {
        true -> spelling(resolver, source_unit, left, right, left_row, right_row)
        _ -> different()
    }

    state spelling(
        resolver: &Resolver,
        source_unit: &SourceUnit,
        left: u64 in Trapping,
        right: u64 in Trapping,
        left_row: TypeReference,
        right_row: TypeReference
    ) {
        transition left_row.kind {
            TypeReferenceKind::Literal -> literal(resolver, source_unit, left, right, left_row, right_row)
            _ -> bounded(resolver, left, right)
        }
    }

    state literal(
        resolver: &Resolver,
        source_unit: &SourceUnit,
        left: u64 in Trapping,
        right: u64 in Trapping,
        left_row: TypeReference,
        right_row: TypeReference
    ) {
        let same: bool = SourceUnit::spans_equal(source_unit, left_row.name.source_span.span,
            right_row.name.source_span.span
        );
        transition same {
            true -> bounded(resolver, left, right)
            _ -> different()
        }
    }

    state bounded(resolver: &Resolver, left: u64 in Trapping, right: u64 in Trapping) {
        transition left < 4096 && right < 4096 {
            true -> compare(resolver, left, right)
            _ -> different()
        }
    }

    state compare(resolver: &Resolver, left: u64 in Trapping, right: u64 in Trapping) {
        let left_domain: DomainBinding = resolver.output.domain_bindings[left];
        let right_domain: DomainBinding = resolver.output.domain_bindings[right];
        transition left_domain == right_domain {
            true -> same_binding(resolver.output.type_bindings[left], resolver.output.type_bindings[right])
            _ -> different()
        }
    }

    // TypeBinding carries payloads, so its cases are matched pairwise.
    state same_binding(left: TypeBinding, right: TypeBinding) {
        transition left {
            TypeBinding::Builtin { builtin } -> builtin_binding(builtin, right)
            TypeBinding::Data { item } -> data_binding(item, right)
            TypeBinding::GenericParameter { parameter } -> generic_binding(parameter, right)
            TypeBinding::Unresolved -> different()
            _ -> formed()
        }
    }

    state builtin_binding(left_builtin: BuiltinType, right: TypeBinding) {
        transition right {
            TypeBinding::Builtin { builtin } -> same_builtin(left_builtin, builtin)
            _ -> different()
        }
    }

    state same_builtin(left: BuiltinType, right: BuiltinType) {
        left == right
    }

    state data_binding(left_item: u64 in Trapping, right: TypeBinding) {
        transition right {
            TypeBinding::Data { item } -> same_handle(left_item, item)
            _ -> different()
        }
    }

    state generic_binding(left_parameter: u64 in Trapping, right: TypeBinding) {
        transition right {
            TypeBinding::GenericParameter { parameter } -> same_handle(left_parameter, parameter)
            _ -> different()
        }
    }

    state same_handle(left: u64 in Trapping, right: u64 in Trapping) {
        left == right
    }

    // Reference, array, slice and integer rows bind by form, which the
    // kinds already matched.
    state formed() {
        true
    }

    state different() {
        false
    }
}

// Body type references: every `let` statement's type, then every cast's
// target type, in table order. Bodies belong to machines, which declare no
// generics in this grammar slice, so each binds in the empty scope.
machine Resolver::bind_body_references(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> statement(resolver, source_unit, syntax, 0) }

    state statement(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.statement_count {
            true -> statement_kind(resolver, source_unit, syntax, index)
            _ -> expression(resolver, source_unit, syntax, 0)
        }
    }

    state statement_kind(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let statement: Statement = SyntaxTrees::statement(syntax, index);
        transition statement.kind {
            StatementKind::Let -> bind_local(resolver, source_unit, syntax, index, statement.type_reference)
            _ -> statement(resolver, source_unit, syntax, index + 1)
        }
    }

    state bind_local(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        reference: u64 in Trapping
    ) {
        let scope: TypeScope = Resolver::empty_scope();
        Resolver::bind_type_reference(resolver, source_unit, syntax, scope, reference);
        transition resolver.output.accepted {
            true -> statement(resolver, source_unit, syntax, index + 1)
            _ -> done()
        }
    }

    state expression(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.expression_count {
            true -> expression_kind(resolver, source_unit, syntax, index)
            _ -> done()
        }
    }

    state expression_kind(resolver: &mut Resolver, source_unit: &SourceUnit, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, index);
        transition expression.kind {
            ExpressionKind::Cast -> bind_cast(resolver, source_unit, syntax, index, expression.type_reference)
            ExpressionKind::Apply -> static_argument(resolver, source_unit, syntax, index, expression, 0)
            _ -> expression(resolver, source_unit, syntax, index + 1)
        }
    }

    // A static application's arguments are types (or integer values) listed
    // in `type_arguments`; each binds in the empty scope like a body type.
    state static_argument(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        application: Expression,
        offset: u64 in Trapping
    ) {
        transition offset < application.count {
            true -> bind_static_argument(resolver, source_unit, syntax, index, application, offset)
            _ -> expression(resolver, source_unit, syntax, index + 1)
        }
    }

    state bind_static_argument(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        application: Expression,
        offset: u64 in Trapping
    ) {
        let argument: u64 in Trapping = SyntaxTrees::type_argument(syntax, application.first + offset);
        let scope: TypeScope = Resolver::empty_scope();
        Resolver::bind_type_reference(resolver, source_unit, syntax, scope, argument);
        transition resolver.output.accepted {
            true -> static_argument(resolver, source_unit, syntax, index, application, offset + 1)
            _ -> done()
        }
    }

    state bind_cast(
        resolver: &mut Resolver,
        source_unit: &SourceUnit,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        reference: u64 in Trapping
    ) {
        let scope: TypeScope = Resolver::empty_scope();
        Resolver::bind_type_reference(resolver, source_unit, syntax, scope, reference);
        transition resolver.output.accepted {
            true -> expression(resolver, source_unit, syntax, index + 1)
            _ -> done()
        }
    }

    state done() {}
}
