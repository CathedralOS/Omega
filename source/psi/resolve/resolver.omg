use psi::resolution::resolution;
use psi::resolve::clauses;
use psi::resolve::containers;
use psi::resolve::contracts;
use psi::resolve::domains;
use psi::resolve::forms;
use psi::resolve::identities;
use psi::resolve::facts;
use psi::resolve::imports;
use psi::resolve::names;
use psi::resolve::operators;
use psi::source::source;
use psi::syntax::syntax;

// Name resolution over the parsed roots of a compilation's source units. The
// pass runs in fail-closed steps, each completing before the next begins:
// machine owners (containers.omg), forms it does not bind yet (forms.omg),
// imports, declaration names, member and
// generic namespaces, stable identities (identities.omg), domain carriers
// (domains.omg), then type references: data declarations', the other
// declarations' (trait parents, satisfied traits, constant and proposition
// types), machine signatures' and body types (`let` types, cast targets and
// static arguments); then machine namespaces, name paths (reference rows,
// routes and alias constituents) and expression names. The first rejection
// is the diagnostic. A type name binds an enclosing generic parameter, then a
// builtin type, then a data, trait or conformance declaration the
// reference's unit can see (imports.omg); where it stands decides which of
// those it may be. Builtin and duplicate declarations reject before any
// lookup, so the builtin and declaration tiers never compete for one
// spelling; two visible declarations of one spelling reject as ambiguous.
pub data Resolver {
    output: NameResolution;
    // Name-resolution scratch: what each expression's position lets it name.
    name_roles: [NameRole; 131072];
}

// What a type's root position admits. A trait application stands as a
// trait's parent or a conformance's satisfied trait; a static argument may
// also name a conformance; every other position names a type. A row inside
// a type is always a type, or a conformance as an applied name's argument.
pub data TypeRole [copy] {
    case Type;
    case Trait;
    case StaticArgument;
}

// What a bound row names, for its position's admission.
data BoundKind [copy] {
    case Type;
    case Trait;
    case Conformance;
}

pub machine Resolver::initialize(resolver: &mut Resolver) {
    NameResolution::clear(&mut resolver.output, SourceId { value: 0 });
}

pub machine Resolver::resolve(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    NameResolution::clear(&mut resolver.output, SourceId { value: 0 });
    Resolver::place_machines(resolver, syntax);
    Resolver::check_declaration_forms(resolver, syntax);
    transition resolver.output.accepted {
        true -> imports(resolver, sources, syntax)
        _ -> done()
    }

    state imports(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::check_imports(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> declarations(resolver, sources, syntax)
            _ -> done()
        }
    }

    state declarations(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::declare_roots(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> members(resolver, sources, syntax)
            _ -> done()
        }
    }

    state members(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::check_members(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> declaration_generics(resolver, sources, syntax)
            _ -> done()
        }
    }

    state declaration_generics(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::check_declaration_namespaces(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> contracts(resolver, sources, syntax)
            _ -> done()
        }
    }

    state contracts(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_machine_contracts(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> identities(resolver, sources, syntax)
            _ -> done()
        }
    }

    state identities(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::check_stable_identities(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> domain_carriers(resolver, sources, syntax)
            _ -> done()
        }
    }

    state domain_carriers(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_domain_carriers(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> domains(resolver, sources, syntax)
            _ -> done()
        }
    }

    state domains(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::check_domains(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> references(resolver, sources, syntax)
            _ -> done()
        }
    }

    state references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> declaration_references(resolver, sources, syntax)
            _ -> done()
        }
    }

    state declaration_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_declaration_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> machine_references(resolver, sources, syntax)
            _ -> done()
        }
    }

    state machine_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_machine_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> body_references(resolver, sources, syntax)
            _ -> done()
        }
    }

    state body_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_body_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> machines(resolver, sources, syntax)
            _ -> done()
        }
    }

    state machines(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::check_machines(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> operators(resolver, sources, syntax)
            _ -> done()
        }
    }

    state operators(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_operator_homes(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> paths(resolver, sources, syntax)
            _ -> done()
        }
    }

    state paths(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_conformance_rows(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> domain_paths(resolver, sources, syntax)
            _ -> done()
        }
    }

    state domain_paths(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_domain_paths(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> names(resolver, sources, syntax)
            _ -> done()
        }
    }

    state names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_body_names(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> facts(resolver, sources, syntax)
            _ -> done()
        }
    }

    state facts(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_fact_names(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> clauses(resolver, sources, syntax)
            _ -> done()
        }
    }

    state clauses(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_clause_names(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> publish(resolver, syntax)
            _ -> done()
        }
    }

    state publish(resolver: &mut Resolver, syntax: &SyntaxTrees) {
        resolver.output.binding_count = syntax.type_reference_count;
        resolver.output.value_binding_count = syntax.expression_count;
        resolver.output.path_binding_count = syntax.name_path_count;
        resolver.output.requirement_count = syntax.clause_count;
    }

    state done() {}
}

// The namespace a root's name occupies within its module: data, traits and
// conformances share the type names, constants are values by owner and
// name, and propositions name logical declarations. `use` rows, machines
// (overload families, check_machines) and domains (by carrier,
// domains.omg) are checked apart.
pub data RootNamespace [copy] {
    case None;
    case Type;
    case Constant;
    case Proposition;
}

pub data RootName [copy] {
    kind: RootItemKind;
    space: RootNamespace;
    has_owner: bool;
    owner: IdentifierSpan;
    name: IdentifierSpan;
}

machine Resolver::root_name(syntax: &SyntaxTrees, index: u64 in Trapping) -> RootName
crashes Trap
{
    let root: RootItem = SyntaxTrees::root_item(syntax, index);
    transition root.kind {
        RootItemKind::Data -> declared(syntax, root, RootNamespace::Type, DeclarationKind::Data)
        RootItemKind::Trait -> declared(syntax, root, RootNamespace::Type, DeclarationKind::Trait)
        RootItemKind::Conformance -> declared(syntax, root, RootNamespace::Type, DeclarationKind::Conformance)
        RootItemKind::Constant -> declared(syntax, root, RootNamespace::Constant, DeclarationKind::Constant)
        RootItemKind::Proposition -> declared(syntax, root, RootNamespace::Proposition, DeclarationKind::Proposition)
        _ -> none(root)
    }

    state declared(syntax: &SyntaxTrees, root: RootItem, space: RootNamespace, kind: DeclarationKind) -> RootName {
        let path: DeclarationPath = Resolver::declaration_path(syntax, kind, root.item_index);
        RootName { kind: root.kind, space: space, has_owner: path.has_owner, owner: path.owner, name: path.name }
    }

    state none(root: RootItem) -> RootName {
        let span: IdentifierSpan = IdentifierSpan { source_span: root.source_span };
        RootName { kind: root.kind, space: RootNamespace::None, has_owner: false, owner: span, name: span }
    }
}

// Declaration names, root by root. A type name that spells a builtin type
// rejects: references would bind the builtin and the declaration could
// never be named. A path an earlier root of the same module and namespace
// already took rejects at the later root, as duplicate data when both are
// data; other modules' declarations conflict only where both are visible to
// one reference.
machine Resolver::declare_roots(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.root_count {
            true -> root(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state root(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let declared: RootName = Resolver::root_name(syntax, index);
        transition declared.space {
            RootNamespace::None -> next(resolver, sources, syntax, index + 1)
            RootNamespace::Type -> builtin_shadow(resolver, sources, syntax, index, declared)
            _ -> earlier(resolver, sources, syntax, index, declared, 0)
        }
    }

    state builtin_shadow(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, declared: RootName) {
        let builtin: TypeBinding = Resolver::builtin_type(sources, declared.name.source_span);
        transition builtin {
            TypeBinding::Unresolved -> earlier(resolver, sources, syntax, index, declared, 0)
            _ -> reject(resolver, ResolveDiagnosticCode::ShadowsBuiltin, declared.name)
        }
    }

    state earlier(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, declared: RootName, prior: u64 in Trapping) {
        transition prior < index {
            true -> compare(resolver, sources, syntax, index, declared, prior)
            _ -> competing(resolver, sources, syntax, index, declared)
        }
    }

    // A constant's path is a value path that a case (`Owner::Case`) or a
    // machine of its module must not also spell.
    state competing(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, declared: RootName) {
        transition declared.space == RootNamespace::Constant {
            true -> constant_path(resolver, sources, syntax, index, declared)
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    state constant_path(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, declared: RootName) {
        let spelled: bool = Resolver::value_path_taken(&resolver.output, sources, syntax, declared);
        transition spelled {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateDeclaration, declared.name)
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    state compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, declared: RootName, prior: u64 in Trapping) {
        let other: RootName = Resolver::root_name(syntax, prior);
        let named: bool = SourceSet::spans_equal(sources, declared.name.source_span, other.name.source_span);
        let owner_named: bool = SourceSet::spans_equal(sources, declared.owner.source_span, other.owner.source_span);
        let same_module: bool = Resolver::same_module(sources, declared.name.source_span.source.value as u64 in Trapping,
            other.name.source_span.source.value as u64 in Trapping);
        transition declared.space == other.space && named && declared.has_owner == other.has_owner
            && (!declared.has_owner || owner_named) && same_module {
            true -> duplicate(resolver, declared, other)
            _ -> earlier(resolver, sources, syntax, index, declared, prior + 1)
        }
    }

    state duplicate(resolver: &mut Resolver, declared: RootName, other: RootName) {
        transition declared.kind == RootItemKind::Data && other.kind == RootItemKind::Data {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateData, declared.name)
            _ -> reject(resolver, ResolveDiagnosticCode::DuplicateDeclaration, declared.name)
        }
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    state done() {}
}

// Whether a case or a machine of `declared`'s module spells its path: a
// case `Owner::NAME` of a data declaration `Owner`, or a machine whose path
// is the constant's.
machine Resolver::value_path_taken(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, declared: RootName) -> bool
crashes Trap
{
    transition { _ -> machine_at(resolution, sources, syntax, declared, 0) }

    state machine_at(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        transition index < syntax.machine_count {
            true -> machine_path(resolution, sources, syntax, declared, index)
            _ -> owner_data(sources, syntax, declared, 0)
        }
    }

    state machine_path(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let spelled: bool = Resolver::machine_spells(resolution, sources, item, index, declared.has_owner,
            declared.owner.source_span, declared.name.source_span);
        let same_module: bool = Resolver::same_module(sources, declared.name.source_span.source.value as u64 in Trapping,
            item.name.source_span.source.value as u64 in Trapping);
        transition spelled && same_module {
            true -> taken()
            _ -> machine_at(resolution, sources, syntax, declared, index + 1)
        }
    }

    state owner_data(sources: &SourceSet, syntax: &SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        transition declared.has_owner && index < syntax.data_count {
            true -> owner_named(sources, syntax, declared, index)
            _ -> free()
        }
    }

    state owner_named(sources: &SourceSet, syntax: &SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        let item: DataItem = SyntaxTrees::data_item(syntax, index);
        let named: bool = SourceSet::spans_equal(sources, item.name.source_span, declared.owner.source_span);
        let same_module: bool = Resolver::same_module(sources, declared.name.source_span.source.value as u64 in Trapping,
            item.name.source_span.source.value as u64 in Trapping);
        transition named && same_module {
            true -> case_at(sources, syntax, declared, index, item, 0)
            _ -> owner_data(sources, syntax, declared, index + 1)
        }
    }

    state case_at(sources: &SourceSet, syntax: &SyntaxTrees, declared: RootName, index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) -> bool {
        transition offset < item.case_count {
            true -> case_named(sources, syntax, declared, index, item, offset)
            _ -> owner_data(sources, syntax, declared, index + 1)
        }
    }

    state case_named(sources: &SourceSet, syntax: &SyntaxTrees, declared: RootName, index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) -> bool {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, item.first_case + offset);
        let named: bool = SourceSet::spans_equal(sources, data_case.name.source_span, declared.name.source_span);
        transition named {
            true -> taken()
            _ -> case_at(sources, syntax, declared, index, item, offset + 1)
        }
    }

    state taken() -> bool {
        true
    }

    state free() -> bool {
        false
    }
}

// The generic parameter names of every trait, conformance, domain and
// proposition, and each proposition's parameter names. Data declarations'
// generics check with their members, machines' with their signatures.
machine Resolver::check_declaration_namespaces(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> traits(resolver, sources, syntax, 0) }

    state traits(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.trait_count && resolver.output.accepted {
            true -> trait_generics(resolver, sources, syntax, index)
            _ -> conformances(resolver, sources, syntax, 0)
        }
    }

    state trait_generics(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: TraitItem = SyntaxTrees::trait_item(syntax, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        Resolver::check_generic_names(resolver, sources, syntax, scope);
        transition { _ -> traits(resolver, sources, syntax, index + 1) }
    }

    state conformances(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.conformance_count && resolver.output.accepted {
            true -> conformance_generics(resolver, sources, syntax, index)
            _ -> domains(resolver, sources, syntax, 0)
        }
    }

    state conformance_generics(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: ConformanceItem = SyntaxTrees::conformance_item(syntax, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        Resolver::check_generic_names(resolver, sources, syntax, scope);
        transition { _ -> conformances(resolver, sources, syntax, index + 1) }
    }

    state domains(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.domain_count && resolver.output.accepted {
            true -> domain_generics(resolver, sources, syntax, index)
            _ -> propositions(resolver, sources, syntax, 0)
        }
    }

    state domain_generics(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        Resolver::check_generic_names(resolver, sources, syntax, scope);
        transition { _ -> domains(resolver, sources, syntax, index + 1) }
    }

    state propositions(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.proposition_count && resolver.output.accepted {
            true -> proposition_generics(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state proposition_generics(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: PropositionItem = SyntaxTrees::proposition_item(syntax, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        Resolver::check_generic_names(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> proposition_parameters(resolver, sources, syntax, index, item)
            _ -> done()
        }
    }

    state proposition_parameters(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: PropositionItem) {
        Resolver::check_parameter_names(resolver, sources, syntax, item.first_parameter, item.parameter_count);
        transition { _ -> propositions(resolver, sources, syntax, index + 1) }
    }

    state done() {}
}

// Member namespaces of each data declaration. Direct fields and cases share
// one namespace in authored order. Each case's payload fields have their own
// namespace, which the declaration's direct (common) fields also occupy.
machine Resolver::check_members(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, sources, syntax, 0) }

    state next_data(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        transition data_index < syntax.data_count {
            true -> data_members(resolver, sources, syntax, data_index)
            _ -> done()
        }
    }

    state data_members(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, data_index);
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::check_generic_names(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, 0)
            _ -> done()
        }
    }

    state member(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.member_count {
            true -> member_named(resolver, sources, syntax, data_index, item, offset)
            _ -> cases(resolver, sources, syntax, data_index, item, 0)
        }
    }

    state member_named(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let data_member: DataMember = SyntaxTrees::data_member(syntax, item.first_member + offset);
        let name: IdentifierSpan = SyntaxTrees::member_name(syntax, data_member);
        transition { _ -> member_prior(resolver, sources, syntax, data_index, item, offset, name, 0) }
    }

    state member_prior(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < offset {
            true -> member_compare(resolver, sources, syntax, data_index, item, offset, name, prior)
            _ -> member(resolver, sources, syntax, data_index, item, offset + 1)
        }
    }

    state member_compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_member: DataMember = SyntaxTrees::data_member(syntax, item.first_member + prior);
        let prior_name: IdentifierSpan = SyntaxTrees::member_name(syntax, prior_member);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            prior_name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateDataMember, name)
            _ -> member_prior(resolver, sources, syntax, data_index, item, offset, name, prior + 1)
        }
    }

    state cases(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) {
        transition case_offset < item.case_count {
            true -> case_payload(resolver, sources, syntax, data_index, item, case_offset)
            _ -> next_data(resolver, sources, syntax, data_index + 1)
        }
    }

    state case_payload(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, item.first_case + case_offset);
        transition { _ -> payload(resolver, sources, syntax, data_index, item, case_offset, data_case, 0) }
    }

    state payload(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        transition field_offset < data_case.payload_field_count {
            true -> payload_named(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset)
            _ -> cases(resolver, sources, syntax, data_index, item, case_offset + 1)
        }
    }

    state payload_named(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        let field: DataField = SyntaxTrees::payload_field(syntax, data_case.first_payload_field + field_offset);
        transition { _ -> payload_prior(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, field.name, 0) }
    }

    state payload_prior(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < field_offset {
            true -> payload_compare(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, prior)
            _ -> common(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, 0)
        }
    }

    state payload_compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_field: DataField = SyntaxTrees::payload_field(syntax, data_case.first_payload_field + prior);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            prior_field.name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateCasePayloadField, name)
            _ -> payload_prior(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, prior + 1)
        }
    }

    state common(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, common_offset: u64 in Trapping) {
        transition common_offset < item.field_count {
            true -> common_compare(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, common_offset)
            _ -> payload(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset + 1)
        }
    }

    state common_compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, common_offset: u64 in Trapping) {
        let common_field: DataField = SyntaxTrees::field(syntax, item.first_field + common_offset);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            common_field.name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::PayloadFieldCollidesWithCommonField, name)
            _ -> common(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, common_offset + 1)
        }
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    state done() {}
}

// Type references of each data declaration: its generic-parameter
// annotations, then its members' references in authored order. Every type
// reference has exactly one owner, so this walk binds the whole table.
machine Resolver::bind_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, sources, syntax, 0) }

    state next_data(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        transition data_index < syntax.data_count {
            true -> data_references(resolver, sources, syntax, data_index)
            _ -> done()
        }
    }

    state data_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, data_index);
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::bind_generic_annotations(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, 0)
            _ -> done()
        }
    }

    state member(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.member_count {
            true -> member_kind(resolver, sources, syntax, data_index, item, offset)
            _ -> next_data(resolver, sources, syntax, data_index + 1)
        }
    }

    state member_kind(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let data_member: DataMember = SyntaxTrees::data_member(syntax, item.first_member + offset);
        transition data_member.kind {
            DataMemberKind::Field -> field_reference(resolver, sources, syntax, data_index, item, offset, data_member.item_index)
            DataMemberKind::Case -> case_references(resolver, sources, syntax, data_index, item, offset, data_member.item_index)
        }
    }

    state field_reference(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, handle: u64 in Trapping) {
        let field: DataField = SyntaxTrees::field(syntax, handle);
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, field.type_reference, TypeRole::Type);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, offset + 1)
            _ -> done()
        }
    }

    state case_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, handle: u64 in Trapping) {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, handle);
        transition { _ -> payload(resolver, sources, syntax, data_index, item, offset, data_case, 0) }
    }

    state payload(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        transition field_offset < data_case.payload_field_count {
            true -> payload_reference(resolver, sources, syntax, data_index, item, offset, data_case, field_offset)
            _ -> member(resolver, sources, syntax, data_index, item, offset + 1)
        }
    }

    state payload_reference(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        let field: DataField = SyntaxTrees::payload_field(syntax, data_case.first_payload_field + field_offset);
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, field.type_reference, TypeRole::Type);
        transition resolver.output.accepted {
            true -> payload(resolver, sources, syntax, data_index, item, offset, data_case, field_offset + 1)
            _ -> done()
        }
    }

    state done() {}
}

// A data declaration's type scope: its own generic parameters.
machine Resolver::data_scope(item: DataItem) -> TypeScope {
    Resolver::scope(item.first_generic_parameter, item.generic_parameter_count)
}

// A declaration's own generic parameters as a scope with no container.
pub machine Resolver::scope(first: u64 in Trapping, count: u64 in Trapping) -> TypeScope {
    TypeScope {
        first_generic_parameter: first,
        generic_parameter_count: count,
        first_outer_parameter: 0,
        outer_parameter_count: 0
    }
}

// Where generic parameter `parameter` stands in `scope`: the container's
// parameters first, then the declaration's own. Two scopes' parameters at
// one position are the same binder for comparing signatures.
machine Resolver::scope_position(scope: TypeScope, parameter: u64 in Trapping) -> u64 in Trapping {
    transition parameter >= scope.first_generic_parameter
        && parameter < scope.first_generic_parameter + scope.generic_parameter_count {
        true -> own(scope.outer_parameter_count + parameter - scope.first_generic_parameter)
        _ -> own(parameter - scope.first_outer_parameter)
    }

    state own(position: u64 in Trapping) -> u64 in Trapping {
        position
    }
}

// Type references of every trait, conformance, constant and proposition,
// each in its declaration's scope: a trait's generic annotations and
// parents, which name traits; a conformance's generic annotations and
// satisfied trait; a constant's type; a proposition's generic annotations,
// parameter types and evidence type.
machine Resolver::bind_declaration_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> traits(resolver, sources, syntax, 0) }

    state traits(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.trait_count && resolver.output.accepted {
            true -> trait_annotations(resolver, sources, syntax, index)
            _ -> conformances(resolver, sources, syntax, 0)
        }
    }

    state trait_annotations(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: TraitItem = SyntaxTrees::trait_item(syntax, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        Resolver::bind_generic_annotations(resolver, sources, syntax, scope);
        transition { _ -> parents(resolver, sources, syntax, index, item, scope, 0) }
    }

    state parents(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: TraitItem, scope: TypeScope, offset: u64 in Trapping) {
        transition offset < item.parent_count && resolver.output.accepted {
            true -> parent(resolver, sources, syntax, index, item, scope, offset)
            _ -> traits(resolver, sources, syntax, index + 1)
        }
    }

    state parent(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: TraitItem, scope: TypeScope, offset: u64 in Trapping) {
        let row: u64 in Trapping = SyntaxTrees::trait_parent(syntax, item.first_parent + offset);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, row, TypeRole::Trait);
        transition { _ -> parents(resolver, sources, syntax, index, item, scope, offset + 1) }
    }

    state conformances(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.conformance_count && resolver.output.accepted {
            true -> conformance(resolver, sources, syntax, index)
            _ -> constants(resolver, sources, syntax, 0)
        }
    }

    state conformance(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: ConformanceItem = SyntaxTrees::conformance_item(syntax, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        Resolver::bind_generic_annotations(resolver, sources, syntax, scope);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, item.trait_type, TypeRole::Trait);
        transition { _ -> conformances(resolver, sources, syntax, index + 1) }
    }

    state constants(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.constant_count && resolver.output.accepted {
            true -> constant(resolver, sources, syntax, index)
            _ -> propositions(resolver, sources, syntax, 0)
        }
    }

    state constant(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: ConstantItem = SyntaxTrees::constant_item(syntax, index);
        let scope: TypeScope = Resolver::empty_scope();
        Resolver::bind_type_reference(resolver, sources, syntax, scope, item.type_reference, TypeRole::Type);
        transition { _ -> constants(resolver, sources, syntax, index + 1) }
    }

    state propositions(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.proposition_count && resolver.output.accepted {
            true -> proposition(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state proposition(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: PropositionItem = SyntaxTrees::proposition_item(syntax, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        Resolver::bind_generic_annotations(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> proposition_signature(resolver, sources, syntax, index, item, scope)
            _ -> done()
        }
    }

    state proposition_signature(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: PropositionItem, scope: TypeScope) {
        Resolver::bind_signature(resolver, sources, syntax, scope, item.first_parameter, item.parameter_count, false, 0);
        transition resolver.output.accepted && item.body == PropositionBody::Evidence {
            true -> evidence(resolver, sources, syntax, index, item, scope)
            _ -> propositions(resolver, sources, syntax, index + 1)
        }
    }

    state evidence(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: PropositionItem, scope: TypeScope) {
        Resolver::bind_type_reference(resolver, sources, syntax, scope, item.evidence, TypeRole::Type);
        transition { _ -> propositions(resolver, sources, syntax, index + 1) }
    }

    state done() {}
}

// The generic parameters of one declaration share one namespace, whatever
// their kinds.
pub machine Resolver::check_generic_names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, scope, 0) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        transition offset < scope.generic_parameter_count {
            true -> named(resolver, sources, syntax, scope, offset)
            _ -> done()
        }
    }

    state named(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, scope.first_generic_parameter + offset);
        transition { _ -> prior(resolver, sources, syntax, scope, offset, parameter.name, 0) }
    }

    state prior(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, name: IdentifierSpan, earlier: u64 in Trapping) {
        transition earlier < offset {
            true -> compare(resolver, sources, syntax, scope, offset, name, earlier)
            _ -> next(resolver, sources, syntax, scope, offset + 1)
        }
    }

    state compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, name: IdentifierSpan, earlier: u64 in Trapping) {
        let earlier_parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, scope.first_generic_parameter + earlier);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            earlier_parameter.name.source_span
        );
        transition equal {
            true -> duplicate(resolver, name)
            _ -> prior(resolver, sources, syntax, scope, offset, name, earlier + 1)
        }
    }

    state duplicate(resolver: &mut Resolver, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::DuplicateGenericParameter, name.source_span);
    }

    state done() {}
}

// The type annotations of one declaration's value binders (`const N: u64`,
// `Count: u32`), each in the declaration's own scope.
pub machine Resolver::bind_generic_annotations(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, scope, 0) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        transition offset < scope.generic_parameter_count && resolver.output.accepted {
            true -> annotation(resolver, sources, syntax, scope, offset)
            _ -> done()
        }
    }

    state annotation(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, scope.first_generic_parameter + offset);
        transition parameter.has_type_reference {
            true -> bind(resolver, sources, syntax, scope, offset, parameter.type_reference)
            _ -> next(resolver, sources, syntax, scope, offset + 1)
        }
    }

    state bind(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, reference: u64 in Trapping) {
        Resolver::bind_type_reference(resolver, sources, syntax, scope, reference, TypeRole::Type);
        transition { _ -> next(resolver, sources, syntax, scope, offset + 1) }
    }

    state done() {}
}

// Bind one type in its owner's scope. A type fills a contiguous run of
// rows that ends at its root, so every row of the run binds in order: a
// named row binds its name and an `in` domain, and a reference, array, slice
// or integer row binds by its form. Nested rows need no recursion. `role` is
// what the root's position admits.
pub machine Resolver::bind_type_reference(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    root: u64 in Trapping,
    role: TypeRole
)
crashes Trap
{
    let root_row: TypeReference = SyntaxTrees::type_reference(syntax, root);
    transition { _ -> next(resolver, sources, syntax, scope, root, role, root_row.first_row) }

    state next(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        root: u64 in Trapping,
        role: TypeRole,
        row: u64 in Trapping
    ) {
        transition row <= root && resolver.output.accepted {
            true -> bind(resolver, sources, syntax, scope, root, role, row)
            _ -> done()
        }
    }

    state bind(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        root: u64 in Trapping,
        role: TypeRole,
        row: u64 in Trapping
    ) {
        Resolver::bind_type_row(resolver, sources, syntax, scope, row, row == root, role);
        transition { _ -> next(resolver, sources, syntax, scope, root, role, row + 1) }
    }

    state done() {}
}

// One row. A trait binds only at the root of a trait position, and a trait
// position admits nothing else; a conformance binds as a static argument's
// root or as an applied name's argument, never under a reference, array or
// slice, which bind only types.
machine Resolver::bind_type_row(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    row: u64 in Trapping,
    is_root: bool,
    role: TypeRole
)
crashes Trap
{
    let type_reference: TypeReference = SyntaxTrees::type_reference(syntax, row);
    let whole: IdentifierSpan = IdentifierSpan { source_span: type_reference.source_span };
    let lifetimes: bool = Resolver::lifetimes_declared(sources, syntax, scope, type_reference);
    transition lifetimes {
        true -> kinds(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole)
        _ -> reject(resolver, ResolveDiagnosticCode::UndeclaredLifetime, whole)
    }

    state kinds(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference,
        whole: IdentifierSpan
    ) {
        transition type_reference.kind {
            TypeReferenceKind::Named -> arity(resolver, sources, syntax, scope, row, is_root, role, type_reference)
            TypeReferenceKind::Reference -> holder(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, TypeBinding::Reference)
            TypeReferenceKind::Array -> holder(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, TypeBinding::Array)
            TypeReferenceKind::Slice -> holder(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, TypeBinding::Slice)
            TypeReferenceKind::Literal -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, TypeBinding::Literal, BoundKind::Type)
        }
    }

    // An applied data name supplies as many lifetime arguments as the data
    // declares lifetime binders, or elides them all; other names take none.
    state arity(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference
    ) {
        let binding: TypeBinding = Resolver::type_binding(sources, syntax, scope, type_reference.name.source_span);
        let declared: u64 in Trapping = Resolver::lifetime_arity(syntax, binding);
        transition declared == type_reference.lifetime_count || type_reference.lifetime_count == 0 {
            true -> named(resolver, sources, syntax, scope, row, is_root, role, type_reference)
            _ -> reject(resolver, ResolveDiagnosticCode::LifetimeArgumentCount, type_reference.name)
        }
    }

    state named(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference
    ) {
        let binding: TypeBinding = Resolver::type_binding(sources, syntax, scope,
            type_reference.name.source_span
        );
        transition binding {
            TypeBinding::Unresolved -> unnamed(resolver, sources, syntax, scope, row, is_root, role, type_reference)
            TypeBinding::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, type_reference.name)
            TypeBinding::Trait { item } -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, type_reference.name, binding, BoundKind::Trait)
            TypeBinding::Conformance { item } -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, type_reference.name, binding, BoundKind::Conformance)
            _ -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, type_reference.name, binding, BoundKind::Type)
        }
    }

    // A name no type spells: a static argument may name a machine, for a
    // callee's machine binder (wiki/spec/language/generics.md, Static
    // machine binder categories); anything else is unknown.
    state unnamed(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference
    ) {
        transition is_root && role == TypeRole::StaticArgument && !type_reference.has_domain {
            true -> machine_argument(resolver, sources, syntax, scope, row, type_reference)
            _ -> reject(resolver, ResolveDiagnosticCode::UnknownDataType, type_reference.name)
        }
    }

    state machine_argument(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, row: u64 in Trapping, type_reference: TypeReference) {
        let lookup: Lookup = Resolver::machine_named(&resolver.output, sources, syntax, false, type_reference.name.source_span, type_reference.name.source_span);
        transition lookup {
            Lookup::Found { handle } -> bounded(resolver, sources, syntax, scope, row, type_reference, TypeBinding::Machine { handle: handle })
            Lookup::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, type_reference.name)
            Lookup::Absent -> reject(resolver, ResolveDiagnosticCode::UnknownDataType, type_reference.name)
        }
    }

    // A reference, array or slice holds a type, never a conformance.
    state holder(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference,
        whole: IdentifierSpan,
        binding: TypeBinding
    ) {
        let held: TypeBinding = NameResolution::type_binding_at(&resolver.output, type_reference.inner);
        let held_row: TypeReference = SyntaxTrees::type_reference(syntax, type_reference.inner);
        transition held {
            TypeBinding::Conformance { item } -> reject(resolver, ResolveDiagnosticCode::NotAType, held_row.name)
            _ -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, binding, BoundKind::Type)
        }
    }

    state placed(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: TypeReference,
        spelled: IdentifierSpan,
        binding: TypeBinding,
        kind: BoundKind
    ) {
        let trait_root: bool = is_root && role == TypeRole::Trait;
        transition kind {
            BoundKind::Trait -> admitted(resolver, sources, syntax, scope, row, type_reference, spelled, binding, trait_root, ResolveDiagnosticCode::NotAType)
            BoundKind::Conformance -> admitted(resolver, sources, syntax, scope, row, type_reference, spelled, binding,
                !is_root || role == TypeRole::StaticArgument, ResolveDiagnosticCode::NotAType)
            BoundKind::Type -> admitted(resolver, sources, syntax, scope, row, type_reference, spelled, binding, !trait_root, ResolveDiagnosticCode::NotATrait)
        }
    }

    state admitted(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        type_reference: TypeReference,
        spelled: IdentifierSpan,
        binding: TypeBinding,
        admits: bool,
        code: ResolveDiagnosticCode
    ) {
        transition admits {
            true -> bounded(resolver, sources, syntax, scope, row, type_reference, binding)
            _ -> reject(resolver, code, spelled)
        }
    }

    state bounded(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        type_reference: TypeReference,
        binding: TypeBinding
    ) {
        transition row < 65536 {
            true -> store(resolver, sources, syntax, scope, row, type_reference, binding)
            _ -> invalid()
        }
    }

    state store(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        type_reference: TypeReference,
        binding: TypeBinding
    ) {
        resolver.output.type_bindings[row] = binding;
        resolver.output.domain_bindings[row] = DomainBinding::Unqualified;
        resolver.output.domain_items[row] = 0;
        transition type_reference.has_domain {
            true -> qualified(resolver, sources, syntax, scope, row, type_reference)
            _ -> done()
        }
    }

    state qualified(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        type_reference: TypeReference
    ) {
        Resolver::bind_domain(resolver, sources, syntax, scope, row, type_reference);
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    state invalid() {
        crash Trap;
    }

    state done() {}
}

// The declaration a type name denotes in `scope`: an enclosing generic
// parameter by spelling (lifetimes are not type names), the declaration's
// own before its container's, then a builtin type, then the one data, trait
// or conformance declaration the name's unit can see.
pub machine Resolver::type_binding(
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    name: SourceSpan
) -> TypeBinding
crashes Trap
{
    let own: Lookup = Resolver::generic_named(sources, syntax, scope.first_generic_parameter, scope.generic_parameter_count, name);
    transition own {
        Lookup::Found { handle } -> found(TypeBinding::GenericParameter { parameter: handle })
        _ -> outer(sources, syntax, scope, name)
    }

    state outer(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan) -> TypeBinding {
        let container: Lookup = Resolver::generic_named(sources, syntax, scope.first_outer_parameter, scope.outer_parameter_count, name);
        transition container {
            Lookup::Found { handle } -> found(TypeBinding::GenericParameter { parameter: handle })
            _ -> builtin(sources, syntax, name)
        }
    }

    state builtin(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> TypeBinding {
        let binding: TypeBinding = Resolver::builtin_type(sources, name);
        transition binding {
            TypeBinding::Unresolved -> declared(sources, syntax, name)
            _ -> found(binding)
        }
    }

    // A visible data declaration, trait or conformance of the spelling; two
    // of them, of any kinds, make the name ambiguous.
    state declared(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> TypeBinding {
        let data: Lookup = Resolver::data_named(sources, syntax, name);
        transition data {
            Lookup::Found { handle } -> data_found(sources, syntax, name, handle)
            Lookup::Ambiguous -> found(TypeBinding::Ambiguous)
            Lookup::Absent -> traits(sources, syntax, name)
        }
    }

    state data_found(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan, item: u64 in Trapping) -> TypeBinding {
        let rivals: bool = Resolver::trait_or_conformance_named(sources, syntax, name);
        transition rivals {
            true -> found(TypeBinding::Ambiguous)
            _ -> found(TypeBinding::Data { item: item })
        }
    }

    state traits(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> TypeBinding {
        let traits: Lookup = Resolver::declared_named(sources, syntax, DeclarationKind::Trait, false, name, name);
        transition traits {
            Lookup::Found { handle } -> trait_found(sources, syntax, name, handle)
            Lookup::Ambiguous -> found(TypeBinding::Ambiguous)
            Lookup::Absent -> conformances(sources, syntax, name)
        }
    }

    state trait_found(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan, item: u64 in Trapping) -> TypeBinding {
        let conformances: Lookup = Resolver::declared_named(sources, syntax, DeclarationKind::Conformance, false, name, name);
        transition conformances {
            Lookup::Absent -> found(TypeBinding::Trait { item: item })
            _ -> found(TypeBinding::Ambiguous)
        }
    }

    state conformances(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> TypeBinding {
        let conformances: Lookup = Resolver::declared_named(sources, syntax, DeclarationKind::Conformance, false, name, name);
        transition conformances {
            Lookup::Found { handle } -> found(TypeBinding::Conformance { item: handle })
            Lookup::Ambiguous -> found(TypeBinding::Ambiguous)
            Lookup::Absent -> found(TypeBinding::Unresolved)
        }
    }

    state found(binding: TypeBinding) -> TypeBinding {
        binding
    }
}

// Whether a trait or a conformance of the spelling is visible.
machine Resolver::trait_or_conformance_named(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> bool
crashes Trap
{
    let traits: Lookup = Resolver::declared_named(sources, syntax, DeclarationKind::Trait, false, name, name);
    transition traits {
        Lookup::Absent -> conformances(sources, syntax, name)
        _ -> yes()
    }

    state conformances(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> bool {
        let conformances: Lookup = Resolver::declared_named(sources, syntax, DeclarationKind::Conformance, false, name, name);
        transition conformances {
            Lookup::Absent -> no()
            _ -> yes()
        }
    }

    state yes() -> bool {
        true
    }

    state no() -> bool {
        false
    }
}

// The generic parameter of `first..first + count` spelled `name`; a
// lifetime names no type.
machine Resolver::generic_named(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan) -> Lookup
crashes Trap
{
    transition { _ -> next(sources, syntax, first, count, name, 0) }

    state next(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, offset: u64 in Trapping) -> Lookup {
        transition offset < count {
            true -> candidate(sources, syntax, first, count, name, offset)
            _ -> absent()
        }
    }

    state candidate(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, offset: u64 in Trapping) -> Lookup {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, first + offset);
        let equal: bool = SourceSet::spans_equal(sources, name, parameter.name.source_span);
        transition equal && parameter.kind != GenericParameterKind::Lifetime {
            true -> found(first + offset)
            _ -> next(sources, syntax, first, count, name, offset + 1)
        }
    }

    state found(handle: u64 in Trapping) -> Lookup {
        Lookup::Found { handle: handle }
    }

    state absent() -> Lookup {
        Lookup::Absent
    }
}

// The domain an `in` qualifier names. A bare name is a compiler-known
// domain by spelling, else the one declared domain of that name whose
// carrier admits the qualified type (domains.omg). A path `Owner::Name`
// names what a membership's path names (names.omg): a case of data `Owner`,
// whose implied domain qualifies only that data, or the declared domain
// over the type `Owner` names in `scope`, whose carrier must admit the
// qualified type (wiki/spec/language/modules.md#foreign-attached-declaration-paths).
// A longer path crosses a package, which this source set cannot bind.
// Generic parameters do not bind domains.
machine Resolver::bind_domain(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    reference: u64 in Trapping,
    type_reference: TypeReference
)
// The caller binds only references it has bounded by the syntax table.
requires reference < 65536
crashes Trap
{
    let whole: SourceSpan = TypeReference::qualifier_span(type_reference);
    transition type_reference.has_domain_owner {
        true -> owned(resolver, sources, syntax, scope, reference, type_reference, whole)
        _ -> bare(resolver, sources, syntax, reference, type_reference.domain)
    }

    state bare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, reference: u64 in Trapping, domain: IdentifierSpan) {
        let known: DomainBinding = Resolver::known_domain(sources, domain.source_span);
        transition known {
            DomainBinding::Unqualified -> declared(resolver, sources, syntax, reference, domain)
            _ -> bind(resolver, reference, known, 0)
        }
    }

    state declared(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, reference: u64 in Trapping, domain: IdentifierSpan) {
        let lookup: Lookup = Resolver::declared_domain(resolver, sources, syntax, reference, domain.source_span);
        transition lookup {
            Lookup::Found { handle } -> bind(resolver, reference, DomainBinding::Declared, handle)
            Lookup::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, domain.source_span)
            Lookup::Absent -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, domain.source_span)
        }
    }

    state owned(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        reference: u64 in Trapping,
        type_reference: TypeReference,
        whole: SourceSpan
    ) {
        let named: DomainPath = Resolver::domain_path(resolver, sources, syntax, scope,
            type_reference.domain_owner.source_span, type_reference.domain.source_span
        );
        transition named {
            DomainPath::Case { item, data_case } -> case_domain(resolver, reference, whole, item, data_case)
            DomainPath::Declared { item } -> declared_carrier(resolver, sources, syntax, reference, type_reference, whole, item)
            DomainPath::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, whole)
            DomainPath::Absent -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    state case_domain(resolver: &mut Resolver, reference: u64 in Trapping, whole: SourceSpan, owner: u64 in Trapping, data_case: u64 in Trapping) {
        let qualified: TypeBinding = NameResolution::type_binding_at(&resolver.output, reference);
        transition qualified {
            TypeBinding::Data { item } -> case_carrier(resolver, reference, whole, item == owner, data_case)
            _ -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    state case_carrier(resolver: &mut Resolver, reference: u64 in Trapping, whole: SourceSpan, own: bool, data_case: u64 in Trapping) {
        transition own {
            true -> bind(resolver, reference, DomainBinding::Case, data_case)
            _ -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    state declared_carrier(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        reference: u64 in Trapping,
        type_reference: TypeReference,
        whole: SourceSpan,
        domain: u64 in Trapping
    ) {
        let admitted: bool = Resolver::domain_admits(resolver, sources, syntax, domain, reference, type_reference.domain.source_span);
        transition admitted {
            true -> bind(resolver, reference, DomainBinding::Declared, domain)
            _ -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    state bind(resolver: &mut Resolver, reference: u64 in Trapping, binding: DomainBinding, item: u64 in Trapping) {
        resolver.output.domain_bindings[reference] = binding;
        resolver.output.domain_items[reference] = item as u64;
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, code, source_span);
    }
}

// The compiler-installed type a name spells, or `Unresolved`. Builtin names
// are not source declarations, so they match by spelling, not by span.
pub machine Resolver::builtin_type(sources: &SourceSet, name: SourceSpan) -> TypeBinding
crashes Trap
{
    let matched: bool = SourceSet::span_spells(sources, name, "bool");
    transition matched { true -> found(BuiltinType::Bool) _ -> spells_i8(sources, name) }

    state spells_i8(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "i8");
        transition matched { true -> found(BuiltinType::I8) _ -> spells_i16(sources, name) }
    }

    state spells_i16(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "i16");
        transition matched { true -> found(BuiltinType::I16) _ -> spells_i32(sources, name) }
    }

    state spells_i32(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "i32");
        transition matched { true -> found(BuiltinType::I32) _ -> spells_i64(sources, name) }
    }

    state spells_i64(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "i64");
        transition matched { true -> found(BuiltinType::I64) _ -> spells_u8(sources, name) }
    }

    state spells_u8(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "u8");
        transition matched { true -> found(BuiltinType::U8) _ -> spells_u16(sources, name) }
    }

    state spells_u16(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "u16");
        transition matched { true -> found(BuiltinType::U16) _ -> spells_u32(sources, name) }
    }

    state spells_u32(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "u32");
        transition matched { true -> found(BuiltinType::U32) _ -> spells_u64(sources, name) }
    }

    state spells_u64(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "u64");
        transition matched { true -> found(BuiltinType::U64) _ -> spells_addr(sources, name) }
    }

    state spells_addr(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "addr");
        transition matched { true -> found(BuiltinType::Address) _ -> spells_f32(sources, name) }
    }

    state spells_f32(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "f32");
        transition matched { true -> found(BuiltinType::F32) _ -> spells_f64(sources, name) }
    }

    state spells_f64(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "f64");
        transition matched { true -> found(BuiltinType::F64) _ -> spells_slice(sources, name) }
    }

    state spells_slice(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "Slice");
        transition matched { true -> found(BuiltinType::Slice) _ -> spells_result(sources, name) }
    }

    state spells_result(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "Result");
        transition matched { true -> found(BuiltinType::Result) _ -> spells_syscallresult(sources, name) }
    }

    state spells_syscallresult(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "SyscallResult");
        transition matched { true -> found(BuiltinType::SyscallResult) _ -> spells_terminal(sources, name) }
    }

    state spells_terminal(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "Terminal");
        transition matched { true -> found(BuiltinType::Terminal) _ -> spells_never(sources, name) }
    }

    state spells_never(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "Never");
        transition matched { true -> found(BuiltinType::Never) _ -> spells_uint(sources, name) }
    }

    state spells_uint(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "UInt");
        transition matched { true -> found(BuiltinType::UInt) _ -> spells_int(sources, name) }
    }

    state spells_int(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "Int");
        transition matched { true -> found(BuiltinType::Int) _ -> spells_atomicbool(sources, name) }
    }

    state spells_atomicbool(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "AtomicBool");
        transition matched { true -> found(BuiltinType::AtomicBool) _ -> spells_atomicu32(sources, name) }
    }

    state spells_atomicu32(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "AtomicU32");
        transition matched { true -> found(BuiltinType::AtomicU32) _ -> spells_atomicu64(sources, name) }
    }

    state spells_atomicu64(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "AtomicU64");
        transition matched { true -> found(BuiltinType::AtomicU64) _ -> absent() }
    }

    state found(builtin: BuiltinType) {
        TypeBinding::Builtin { builtin: builtin }
    }

    state absent() {
        TypeBinding::Unresolved
    }
}

// Machine signatures: each machine's generic annotations, its parameter and
// return types, its `where machine` contracts', then each state's, all in
// the machine's scope (a trait or conformance member's includes its
// container's generic parameters).
machine Resolver::bind_machine_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_machine(resolver, sources, syntax, 0) }

    state next_machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> machine_signature(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state machine_signature(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let scope: TypeScope = Resolver::machine_scope(&resolver.output, syntax, index);
        Resolver::bind_generic_annotations(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> entry_signature(resolver, sources, syntax, index, item, scope)
            _ -> done()
        }
    }

    state entry_signature(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        scope: TypeScope
    ) {
        Resolver::bind_signature(resolver, sources, syntax, scope, item.first_parameter, item.parameter_count,
            item.has_return_type, item.return_type
        );
        transition resolver.output.accepted {
            true -> contract_signature(resolver, sources, syntax, index, item, scope, 0)
            _ -> done()
        }
    }

    // Each `where machine` contract's signature, in the machine's scope.
    state contract_signature(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        scope: TypeScope,
        offset: u64 in Trapping
    ) {
        transition offset < item.contract_count && resolver.output.accepted {
            true -> bind_contract(resolver, sources, syntax, index, item, scope, offset)
            _ -> state_signature(resolver, sources, syntax, index, item, 0)
        }
    }

    state bind_contract(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        scope: TypeScope,
        offset: u64 in Trapping
    ) {
        let written: Contract = SyntaxTrees::contract(syntax, item.first_contract + offset);
        Resolver::bind_signature(resolver, sources, syntax, scope, written.first_parameter, written.parameter_count,
            written.has_return_type, written.return_type
        );
        transition { _ -> contract_signature(resolver, sources, syntax, index, item, scope, offset + 1) }
    }

    state state_signature(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < item.state_count {
            true -> bind_state(resolver, sources, syntax, index, item, offset)
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    state bind_state(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        let scope: TypeScope = Resolver::machine_scope(&resolver.output, syntax, index);
        Resolver::bind_signature(resolver, sources, syntax, scope, state_item.first_parameter,
            state_item.parameter_count, state_item.has_return_type, state_item.return_type
        );
        transition resolver.output.accepted {
            true -> state_signature(resolver, sources, syntax, index, item, offset + 1)
            _ -> done()
        }
    }

    state done() {}
}

// One signature's parameter types, then its return type when present, in
// its machine's scope.
machine Resolver::bind_signature(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping,
    has_return_type: bool,
    return_type: u64 in Trapping
)
crashes Trap
{
    transition { _ -> parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, 0) }

    state parameter(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        has_return_type: bool,
        return_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < parameter_count {
            true -> bind_parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, offset)
            _ -> result(resolver, sources, syntax, scope, has_return_type, return_type)
        }
    }

    state bind_parameter(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        has_return_type: bool,
        return_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + offset);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, parameter.type_reference, TypeRole::Type);
        transition resolver.output.accepted {
            true -> parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, offset + 1)
            _ -> done()
        }
    }

    state result(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        has_return_type: bool,
        return_type: u64 in Trapping
    ) {
        transition has_return_type {
            true -> bind_result(resolver, sources, syntax, scope, return_type)
            _ -> done()
        }
    }

    state bind_result(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, return_type: u64 in Trapping) {
        Resolver::bind_type_reference(resolver, sources, syntax, scope, return_type, TypeRole::Type);
    }

    state done() {}
}

pub machine Resolver::empty_scope() -> TypeScope {
    Resolver::scope(0, 0)
}

// Machine namespaces. A machine's generic parameter names are distinct,
// each signature's parameter names are distinct, and a machine's state names
// are distinct; a state may repeat the machine's own name and its
// parameters' names, and a member's generic parameters may shadow its
// container's. Two machines of one module may share a path (owner and name,
// a member's owner being its container) only as overloads: identical generic
// parameter kinds and parameter types make the later one a duplicate, unless
// both are target-scoped bodies for different targets, which form one family
// keyed by target (wiki/spec/language/machines.md#target-scoped-families). An
// untargeted body beside a targeted one of the same signature is a duplicate.
machine Resolver::check_machines(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_machine(resolver, sources, syntax, 0) }

    state next_machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> machine_parameters(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state machine_parameters(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        Resolver::check_generic_names(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> machine_parameter_names(resolver, sources, syntax, index, item)
            _ -> done()
        }
    }

    state machine_parameter_names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem) {
        Resolver::check_parameter_names(resolver, sources, syntax, item.first_parameter, item.parameter_count);
        transition resolver.output.accepted {
            true -> state_names(resolver, sources, syntax, index, item, 0)
            _ -> done()
        }
    }

    state state_names(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < item.state_count {
            true -> state_name(resolver, sources, syntax, index, item, offset)
            _ -> overloads(resolver, sources, syntax, index, item, 0)
        }
    }

    state state_name(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        Resolver::check_parameter_names(resolver, sources, syntax, state_item.first_parameter,
            state_item.parameter_count
        );
        transition resolver.output.accepted {
            true -> state_prior(resolver, sources, syntax, index, item, offset, state_item.name, 0)
            _ -> done()
        }
    }

    state state_prior(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        prior: u64 in Trapping
    ) {
        transition prior < offset {
            true -> state_compare(resolver, sources, syntax, index, item, offset, name, prior)
            _ -> state_names(resolver, sources, syntax, index, item, offset + 1)
        }
    }

    state state_compare(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        prior: u64 in Trapping
    ) {
        let prior_state: StateItem = SyntaxTrees::state_item(syntax, item.first_state + prior);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            prior_state.name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateState, name)
            _ -> state_prior(resolver, sources, syntax, index, item, offset, name, prior + 1)
        }
    }

    state overloads(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        prior: u64 in Trapping
    ) {
        transition prior < index {
            true -> overload_compare(resolver, sources, syntax, index, item, prior)
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    state overload_compare(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        prior: u64 in Trapping
    ) {
        let prior_item: MachineItem = SyntaxTrees::machine_item(syntax, prior);
        let same: bool = Resolver::same_machine_signature(resolver, sources, syntax, index, prior);
        let same_module: bool = Resolver::same_module(sources, item.name.source_span.source.value as u64 in Trapping,
            prior_item.name.source_span.source.value as u64 in Trapping);
        transition same && same_module {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateMachine, item.name)
            _ -> overloads(resolver, sources, syntax, index, item, prior + 1)
        }
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    state done() {}
}

// Each parameter name of one signature differs from every earlier one.
pub machine Resolver::check_parameter_names(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping
)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, first_parameter, parameter_count, 0) }

    state next(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < parameter_count {
            true -> named(resolver, sources, syntax, first_parameter, parameter_count, offset)
            _ -> done()
        }
    }

    state named(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + offset);
        transition { _ -> prior(resolver, sources, syntax, first_parameter, parameter_count, offset, parameter.name, 0) }
    }

    state prior(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        earlier: u64 in Trapping
    ) {
        transition earlier < offset {
            true -> compare(resolver, sources, syntax, first_parameter, parameter_count, offset, name, earlier)
            _ -> next(resolver, sources, syntax, first_parameter, parameter_count, offset + 1)
        }
    }

    state compare(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        earlier: u64 in Trapping
    ) {
        let earlier_parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + earlier);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            earlier_parameter.name.source_span
        );
        transition equal {
            true -> duplicate(resolver, name)
            _ -> prior(resolver, sources, syntax, first_parameter, parameter_count, offset, name, earlier + 1)
        }
    }

    state duplicate(resolver: &mut Resolver, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::DuplicateParameter, name.source_span);
    }

    state done() {}
}

// Whether two machines declare the same overload body: the same path (owner,
// or none, and name), the same parameters (same_parameters) and no two
// distinct targets.
machine Resolver::same_machine_signature(
    resolver: &Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    left_handle: u64 in Trapping,
    right_handle: u64 in Trapping
) -> bool
crashes Trap
{
    let left: MachineItem = SyntaxTrees::machine_item(syntax, left_handle);
    let right: MachineItem = SyntaxTrees::machine_item(syntax, right_handle);
    let left_owner: MachineOwner = NameResolution::machine_owner(&resolver.output, left_handle);
    let right_owner: MachineOwner = NameResolution::machine_owner(&resolver.output, right_handle);
    let same_name: bool = SourceSet::spans_equal(sources, left.name.source_span,
        right.name.source_span
    );
    let same_owner: bool = SourceSet::spans_equal(sources, left_owner.owner.source_span,
        right_owner.owner.source_span
    );
    transition same_name && left_owner.has_owner == right_owner.has_owner && (!left_owner.has_owner || same_owner) {
        true -> parameters(resolver, sources, syntax, left_handle, right_handle, left, right)
        _ -> different()
    }

    state parameters(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_handle: u64 in Trapping,
        right_handle: u64 in Trapping,
        left: MachineItem,
        right: MachineItem
    ) -> bool {
        let same: bool = Resolver::same_parameters(resolver, sources, syntax, left_handle, right_handle);
        transition same {
            true -> targets(sources, left, right)
            _ -> different()
        }
    }

    // Bodies for two different targets are members of one family.
    state targets(sources: &SourceSet, left: MachineItem, right: MachineItem) -> bool {
        let same_target: bool = SourceSet::spans_equal(sources, left.target.source_span, right.target.source_span);
        transition left.has_target && right.has_target && !same_target {
            true -> different()
            _ -> same()
        }
    }

    state same() -> bool {
        true
    }

    state different() -> bool {
        false
    }
}

// Whether two machines take the same parameters: the same generic parameter
// kinds and the same parameter types, position by position. A generic
// parameter in a parameter type matches the one at the same position of the
// other machine's scope, so `f<T>(value: T)` and `f<U>(other: U)` match.
pub machine Resolver::same_parameters(
    resolver: &Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    left_handle: u64 in Trapping,
    right_handle: u64 in Trapping
) -> bool
crashes Trap
{
    let left: MachineItem = SyntaxTrees::machine_item(syntax, left_handle);
    let right: MachineItem = SyntaxTrees::machine_item(syntax, right_handle);
    transition left.parameter_count == right.parameter_count && left.generic_parameter_count == right.generic_parameter_count {
        true -> generic(resolver, sources, syntax, left_handle, right_handle, left, right, 0)
        _ -> different()
    }

    state generic(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_handle: u64 in Trapping,
        right_handle: u64 in Trapping,
        left: MachineItem,
        right: MachineItem,
        offset: u64 in Trapping
    ) -> bool {
        transition offset < left.generic_parameter_count {
            true -> generic_kind(resolver, sources, syntax, left_handle, right_handle, left, right, offset)
            _ -> parameter(resolver, sources, syntax, left_handle, right_handle, left, right, 0)
        }
    }

    state generic_kind(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_handle: u64 in Trapping,
        right_handle: u64 in Trapping,
        left: MachineItem,
        right: MachineItem,
        offset: u64 in Trapping
    ) -> bool {
        let left_parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, left.first_generic_parameter + offset);
        let right_parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, right.first_generic_parameter + offset);
        transition left_parameter.kind == right_parameter.kind {
            true -> generic(resolver, sources, syntax, left_handle, right_handle, left, right, offset + 1)
            _ -> different()
        }
    }

    state parameter(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_handle: u64 in Trapping,
        right_handle: u64 in Trapping,
        left: MachineItem,
        right: MachineItem,
        offset: u64 in Trapping
    ) -> bool {
        transition offset < left.parameter_count {
            true -> compare(resolver, sources, syntax, left_handle, right_handle, left, right, offset)
            _ -> same()
        }
    }

    state compare(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_handle: u64 in Trapping,
        right_handle: u64 in Trapping,
        left: MachineItem,
        right: MachineItem,
        offset: u64 in Trapping
    ) -> bool {
        let left_parameter: Parameter = SyntaxTrees::parameter(syntax, left.first_parameter + offset);
        let right_parameter: Parameter = SyntaxTrees::parameter(syntax, right.first_parameter + offset);
        let left_scope: TypeScope = Resolver::machine_scope(&resolver.output, syntax, left_handle);
        let right_scope: TypeScope = Resolver::machine_scope(&resolver.output, syntax, right_handle);
        let equal: bool = Resolver::same_type(resolver, sources, syntax, left_scope, left_parameter.type_reference,
            right_scope, right_parameter.type_reference
        );
        transition equal {
            true -> parameter(resolver, sources, syntax, left_handle, right_handle, left, right, offset + 1)
            _ -> different()
        }
    }

    state same() -> bool {
        true
    }

    state different() -> bool {
        false
    }
}

// Whether two bound types, each in its declaration's scope, are the same
// type. A run lists a type's rows children-first, and each form fixes its
// child count, so two runs denote the same type exactly when they have the
// same length and agree row by row in form, access, argument count, binding
// and domain. Generic parameters agree by position in their scopes. Integer
// rows compare by spelling until static evaluation lands.
pub machine Resolver::same_type(
    resolver: &Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    left_scope: TypeScope,
    left: u64 in Trapping,
    right_scope: TypeScope,
    right: u64 in Trapping
) -> bool
crashes Trap
{
    let left_root: TypeReference = SyntaxTrees::type_reference(syntax, left);
    let right_root: TypeReference = SyntaxTrees::type_reference(syntax, right);
    transition left - left_root.first_row == right - right_root.first_row {
        true -> rows(resolver, sources, syntax, left_scope, left_root.first_row, right_scope, right_root.first_row, left)
        _ -> different()
    }

    state rows(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_scope: TypeScope,
        left_row: u64 in Trapping,
        right_scope: TypeScope,
        right_row: u64 in Trapping,
        left_root: u64 in Trapping
    ) {
        transition left_row <= left_root {
            true -> row(resolver, sources, syntax, left_scope, left_row, right_scope, right_row, left_root)
            _ -> equal()
        }
    }

    state row(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_scope: TypeScope,
        left_row: u64 in Trapping,
        right_scope: TypeScope,
        right_row: u64 in Trapping,
        left_root: u64 in Trapping
    ) {
        let same: bool = Resolver::same_type_row(resolver, sources, syntax, left_scope, left_row, right_scope, right_row);
        transition same {
            true -> rows(resolver, sources, syntax, left_scope, left_row + 1, right_scope, right_row + 1, left_root)
            _ -> different()
        }
    }

    state equal() {
        true
    }

    state different() {
        false
    }
}

machine Resolver::same_type_row(
    resolver: &Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    left_scope: TypeScope,
    left: u64 in Trapping,
    right_scope: TypeScope,
    right: u64 in Trapping
) -> bool
crashes Trap
{
    let left_row: TypeReference = SyntaxTrees::type_reference(syntax, left);
    let right_row: TypeReference = SyntaxTrees::type_reference(syntax, right);
    transition left_row.kind == right_row.kind && left_row.access == right_row.access
        && left_row.argument_count == right_row.argument_count {
        true -> spelling(resolver, sources, left_scope, left, right_scope, right, left_row, right_row)
        _ -> different()
    }

    state spelling(
        resolver: &Resolver,
        sources: &SourceSet,
        left_scope: TypeScope,
        left: u64 in Trapping,
        right_scope: TypeScope,
        right: u64 in Trapping,
        left_row: TypeReference,
        right_row: TypeReference
    ) {
        transition left_row.kind {
            TypeReferenceKind::Literal -> literal(resolver, sources, left_scope, left, right_scope, right, left_row, right_row)
            _ -> bounded(resolver, left_scope, left, right_scope, right)
        }
    }

    state literal(
        resolver: &Resolver,
        sources: &SourceSet,
        left_scope: TypeScope,
        left: u64 in Trapping,
        right_scope: TypeScope,
        right: u64 in Trapping,
        left_row: TypeReference,
        right_row: TypeReference
    ) {
        let same: bool = SourceSet::spans_equal(sources, left_row.name.source_span,
            right_row.name.source_span
        );
        transition same {
            true -> bounded(resolver, left_scope, left, right_scope, right)
            _ -> different()
        }
    }

    state bounded(resolver: &Resolver, left_scope: TypeScope, left: u64 in Trapping, right_scope: TypeScope, right: u64 in Trapping) {
        transition left < 65536 && right < 65536 {
            true -> compare(resolver, left_scope, left, right_scope, right)
            _ -> different()
        }
    }

    state compare(resolver: &Resolver, left_scope: TypeScope, left: u64 in Trapping, right_scope: TypeScope, right: u64 in Trapping) {
        let left_domain: DomainBinding = resolver.output.domain_bindings[left];
        let right_domain: DomainBinding = resolver.output.domain_bindings[right];
        let left_item: u64 = resolver.output.domain_items[left];
        let right_item: u64 = resolver.output.domain_items[right];
        transition left_domain == right_domain && left_item == right_item {
            true -> same_binding(left_scope, resolver.output.type_bindings[left], right_scope, resolver.output.type_bindings[right])
            _ -> different()
        }
    }

    // TypeBinding carries payloads, so its cases are matched pairwise.
    state same_binding(left_scope: TypeScope, left: TypeBinding, right_scope: TypeScope, right: TypeBinding) {
        transition left {
            TypeBinding::Builtin { builtin } -> builtin_binding(builtin, right)
            TypeBinding::Data { item } -> data_binding(item, right)
            TypeBinding::GenericParameter { parameter } -> generic_binding(left_scope, parameter, right_scope, right)
            TypeBinding::Trait { item } -> trait_binding(item, right)
            TypeBinding::Conformance { item } -> conformance_binding(item, right)
            TypeBinding::Machine { handle } -> machine_binding(handle, right)
            TypeBinding::Unresolved -> different()
            TypeBinding::Ambiguous -> different()
            _ -> formed()
        }
    }

    state trait_binding(left_item: u64 in Trapping, right: TypeBinding) {
        transition right {
            TypeBinding::Trait { item } -> same_handle(left_item, item)
            _ -> different()
        }
    }

    state conformance_binding(left_item: u64 in Trapping, right: TypeBinding) {
        transition right {
            TypeBinding::Conformance { item } -> same_handle(left_item, item)
            _ -> different()
        }
    }

    state machine_binding(left_handle: u64 in Trapping, right: TypeBinding) {
        transition right {
            TypeBinding::Machine { handle } -> same_handle(left_handle, handle)
            _ -> different()
        }
    }

    state builtin_binding(left_builtin: BuiltinType, right: TypeBinding) {
        transition right {
            TypeBinding::Builtin { builtin } -> same_builtin(left_builtin, builtin)
            _ -> different()
        }
    }

    state same_builtin(left: BuiltinType, right: BuiltinType) {
        left == right
    }

    state data_binding(left_item: u64 in Trapping, right: TypeBinding) {
        transition right {
            TypeBinding::Data { item } -> same_handle(left_item, item)
            _ -> different()
        }
    }

    state generic_binding(left_scope: TypeScope, left_parameter: u64 in Trapping, right_scope: TypeScope, right: TypeBinding) {
        transition right {
            TypeBinding::GenericParameter { parameter } -> same_position(left_scope, left_parameter, right_scope, parameter)
            _ -> different()
        }
    }

    state same_position(left_scope: TypeScope, left_parameter: u64 in Trapping, right_scope: TypeScope, right_parameter: u64 in Trapping) {
        let left_position: u64 in Trapping = Resolver::scope_position(left_scope, left_parameter);
        let right_position: u64 in Trapping = Resolver::scope_position(right_scope, right_parameter);
        left_position == right_position
    }

    state same_handle(left: u64 in Trapping, right: u64 in Trapping) {
        left == right
    }

    // Reference, array, slice and integer rows bind by form, which the
    // kinds already matched.
    state formed() {
        true
    }

    state different() {
        false
    }
}

// Body type references: every `let` statement's type, then every cast's
// target type and every static application's arguments, in table order. A
// machine's statements and its expressions each fill a contiguous run, and
// machines follow one another in both tables, so one pass with a cursor on
// the owning machine binds each in that machine's scope. Statements belong
// to machines only; an expression outside every machine binds in the scope
// of the declaration whose fact or value holds it (`detached_scope`).
machine Resolver::bind_body_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> statement(resolver, sources, syntax, 0, 0) }

    state statement(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition index < syntax.statement_count && resolver.output.accepted {
            true -> statement_owner(resolver, sources, syntax, index, owner)
            _ -> expressions(resolver, sources, syntax)
        }
    }

    state statement_owner(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition owner < syntax.machine_count {
            true -> statement_in(resolver, sources, syntax, index, owner)
            _ -> invalid()
        }
    }

    state statement_in(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, owner);
        let end: u64 in Trapping = Resolver::statement_end(syntax, item);
        transition index < end {
            true -> statement_kind(resolver, sources, syntax, index, owner, item)
            _ -> statement_owner(resolver, sources, syntax, index, owner + 1)
        }
    }

    state statement_kind(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        item: MachineItem
    ) {
        let statement: Statement = SyntaxTrees::statement(syntax, index);
        let scope: TypeScope = Resolver::machine_scope(&resolver.output, syntax, owner);
        transition statement.kind {
            StatementKind::Let -> bind_local(resolver, sources, syntax, index, owner, scope, statement.type_reference)
            _ -> statement(resolver, sources, syntax, index + 1, owner)
        }
    }

    state bind_local(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        reference: u64 in Trapping
    ) {
        Resolver::bind_type_reference(resolver, sources, syntax, scope, reference, TypeRole::Type);
        transition { _ -> statement(resolver, sources, syntax, index + 1, owner) }
    }

    state expressions(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        transition resolver.output.accepted {
            true -> expression(resolver, sources, syntax, 0, 0)
            _ -> done()
        }
    }

    state expression(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition index < syntax.expression_count && resolver.output.accepted {
            true -> expression_owner(resolver, sources, syntax, index, owner)
            _ -> done()
        }
    }

    // Move the cursor past machines whose run ends at or before `index`.
    state expression_owner(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let scope: TypeScope = Resolver::detached_scope(syntax, index);
        transition owner < syntax.machine_count {
            true -> expression_in(resolver, sources, syntax, index, owner)
            _ -> expression_kind(resolver, sources, syntax, index, owner, scope)
        }
    }

    state expression_in(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, owner);
        transition index < item.first_expression + item.expression_count {
            true -> expression_scope(resolver, sources, syntax, index, owner, item)
            _ -> expression_owner(resolver, sources, syntax, index, owner + 1)
        }
    }

    state expression_scope(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        item: MachineItem
    ) {
        let owned: TypeScope = Resolver::machine_scope(&resolver.output, syntax, owner);
        let unowned: TypeScope = Resolver::detached_scope(syntax, index);
        transition index >= item.first_expression {
            true -> expression_kind(resolver, sources, syntax, index, owner, owned)
            _ -> expression_kind(resolver, sources, syntax, index, owner, unowned)
        }
    }

    state expression_kind(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope
    ) {
        let expression: Expression = SyntaxTrees::expression(syntax, index);
        transition expression.kind {
            ExpressionKind::Cast -> bind_cast(resolver, sources, syntax, index, owner, scope, expression.type_reference)
            ExpressionKind::Apply -> static_argument(resolver, sources, syntax, index, owner, scope, expression, 0)
            _ -> expression(resolver, sources, syntax, index + 1, owner)
        }
    }

    // A static application's arguments are types (or integer values) listed
    // in `type_arguments`; each binds like a body type.
    state static_argument(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        application: Expression,
        offset: u64 in Trapping
    ) {
        transition offset < application.count && resolver.output.accepted {
            true -> bind_static_argument(resolver, sources, syntax, index, owner, scope, application, offset)
            _ -> expression(resolver, sources, syntax, index + 1, owner)
        }
    }

    state bind_static_argument(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        application: Expression,
        offset: u64 in Trapping
    ) {
        let argument: u64 in Trapping = SyntaxTrees::type_argument(syntax, application.first + offset);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, argument, TypeRole::StaticArgument);
        transition { _ -> static_argument(resolver, sources, syntax, index, owner, scope, application, offset + 1) }
    }

    state bind_cast(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        reference: u64 in Trapping
    ) {
        Resolver::bind_type_reference(resolver, sources, syntax, scope, reference, TypeRole::Type);
        transition { _ -> expression(resolver, sources, syntax, index + 1, owner) }
    }

    // Every statement lies in a machine's run.
    state invalid() {
        crash Trap;
    }

    state done() {}
}

// The scope of expression `index` outside every machine: a domain's
// predicate facts see its generic parameters, a transparent proposition's
// fact its own, a data declaration's or case's `where` facts the data's; a
// constant's value has no generic parameters. Only casts and static
// applications ask, so the scan is rare.
machine Resolver::detached_scope(syntax: &SyntaxTrees, index: u64 in Trapping) -> TypeScope
crashes Trap
{
    transition { _ -> domain(syntax, index, 0) }

    state domain(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        transition offset < syntax.domain_count {
            true -> domain_facts(syntax, index, offset)
            _ -> proposition(syntax, index, 0)
        }
    }

    state domain_facts(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, offset);
        let holds: bool = Resolver::clauses_hold(syntax, item.first_clause, item.clause_count, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        transition holds {
            true -> found(scope)
            _ -> domain(syntax, index, offset + 1)
        }
    }

    state proposition(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        transition offset < syntax.proposition_count {
            true -> proposition_fact(syntax, index, offset)
            _ -> data(syntax, index, 0)
        }
    }

    state proposition_fact(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        let item: PropositionItem = SyntaxTrees::proposition_item(syntax, offset);
        let holds: bool = Resolver::tree_holds(syntax, item.body == PropositionBody::Transparent, item.fact, index);
        let scope: TypeScope = Resolver::scope(item.first_generic_parameter, item.generic_parameter_count);
        transition holds {
            true -> found(scope)
            _ -> proposition(syntax, index, offset + 1)
        }
    }

    state data(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        let empty: TypeScope = Resolver::empty_scope();
        transition offset < syntax.data_count {
            true -> data_facts(syntax, index, offset)
            _ -> found(empty)
        }
    }

    state data_facts(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> TypeScope {
        let item: DataItem = SyntaxTrees::data_item(syntax, offset);
        let holds: bool = Resolver::clauses_hold(syntax, item.first_clause, item.clause_count, index);
        let scope: TypeScope = Resolver::data_scope(item);
        transition holds {
            true -> found(scope)
            _ -> case_facts(syntax, index, offset, item, 0)
        }
    }

    state case_facts(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) -> TypeScope {
        transition case_offset < item.case_count {
            true -> case_holds(syntax, index, offset, item, case_offset)
            _ -> data(syntax, index, offset + 1)
        }
    }

    state case_holds(syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) -> TypeScope {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, item.first_case + case_offset);
        let holds: bool = Resolver::clauses_hold(syntax, data_case.first_clause, data_case.clause_count, index);
        let scope: TypeScope = Resolver::data_scope(item);
        transition holds {
            true -> found(scope)
            _ -> case_facts(syntax, index, offset, item, case_offset + 1)
        }
    }

    state found(scope: TypeScope) -> TypeScope {
        scope
    }
}

// Whether expression `index` lies in the fact tree of one of the clauses
// `first..first + count`.
machine Resolver::clauses_hold(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(syntax, first, count, index, 0) }

    state next(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> clause(syntax, first, count, index, offset)
            _ -> no()
        }
    }

    state clause(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let fact: Clause = SyntaxTrees::clause(syntax, first + offset);
        let factual: bool = fact.kind == ClauseKind::Requires || fact.kind == ClauseKind::Ensures || fact.kind == ClauseKind::Where;
        let holds: bool = Resolver::tree_holds(syntax, factual, fact.expression, index);
        transition holds {
            true -> yes()
            _ -> next(syntax, first, count, index, offset + 1)
        }
    }

    state yes() -> bool {
        true
    }

    state no() -> bool {
        false
    }
}

// Whether expression `index` lies in the tree rooted at `root`, whose rows
// run from the root's first row to the root; `present` says a tree exists.
machine Resolver::tree_holds(syntax: &SyntaxTrees, present: bool, root: u64 in Trapping, index: u64 in Trapping) -> bool
crashes Trap
{
    transition present {
        true -> run(syntax, root, index)
        _ -> no()
    }

    state run(syntax: &SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping) -> bool {
        let expression: Expression = SyntaxTrees::expression(syntax, root);
        expression.first_row <= index && index <= root
    }

    state no() -> bool {
        false
    }
}

// Where a machine's statement run ends: after its last state's statements,
// or after its entry statements when it declares no state.
machine Resolver::statement_end(syntax: &SyntaxTrees, item: MachineItem) -> u64 in Trapping
crashes Trap
{
    transition item.state_count > 0 {
        true -> last_state(syntax, item)
        _ -> entry(item)
    }

    state last_state(syntax: &SyntaxTrees, item: MachineItem) -> u64 in Trapping {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + item.state_count - 1);
        state_item.first_statement + state_item.statement_count
    }

    state entry(item: MachineItem) -> u64 in Trapping {
        item.first_statement + item.statement_count
    }
}

// Whether every lifetime tag a type row spells, its reference tag and its
// applied name's lifetime arguments, names a lifetime binder of the
// declaration or its container.
machine Resolver::lifetimes_declared(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, type_reference: TypeReference) -> bool
crashes Trap
{
    let tagged: bool = Resolver::lifetime_named(sources, syntax, scope, type_reference.lifetime.source_span);
    transition type_reference.has_lifetime && !tagged {
        true -> answer(false)
        _ -> argument(sources, syntax, scope, type_reference, 0)
    }

    state argument(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, type_reference: TypeReference, offset: u64 in Trapping) -> bool {
        transition offset < type_reference.lifetime_count {
            true -> tag(sources, syntax, scope, type_reference, offset)
            _ -> answer(true)
        }
    }

    state tag(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, type_reference: TypeReference, offset: u64 in Trapping) -> bool {
        let spelled: IdentifierSpan = SyntaxTrees::type_lifetime(syntax, type_reference.first_lifetime + offset);
        let declared: bool = Resolver::lifetime_named(sources, syntax, scope, spelled.source_span);
        transition declared {
            true -> argument(sources, syntax, scope, type_reference, offset + 1)
            _ -> answer(false)
        }
    }

    state answer(declared: bool) -> bool {
        declared
    }
}

// Whether a lifetime binder spelled `name` is declared by the scope's own
// declaration or its container.
machine Resolver::lifetime_named(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan) -> bool
crashes Trap
{
    let own: bool = Resolver::lifetime_among(sources, syntax, scope.first_generic_parameter, scope.generic_parameter_count, name);
    let outer: bool = Resolver::lifetime_among(sources, syntax, scope.first_outer_parameter, scope.outer_parameter_count, name);
    own || outer
}

// Whether a lifetime binder spelled `name` lies in the generic parameters
// `first..first + count`.
machine Resolver::lifetime_among(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan) -> bool
crashes Trap
{
    transition { _ -> next(sources, syntax, first, count, name, 0) }

    state next(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> candidate(sources, syntax, first, count, name, offset)
            _ -> answer(false)
        }
    }

    state candidate(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, offset: u64 in Trapping) -> bool {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, first + offset);
        let equal: bool = SourceSet::spans_equal(sources, name, parameter.name.source_span);
        transition equal && parameter.kind == GenericParameterKind::Lifetime {
            true -> answer(true)
            _ -> next(sources, syntax, first, count, name, offset + 1)
        }
    }

    state answer(declared: bool) -> bool {
        declared
    }
}

// How many lifetime binders the declaration a type name binds declares:
// data counts its lifetime parameters; any other binding declares none.
machine Resolver::lifetime_arity(syntax: &SyntaxTrees, binding: TypeBinding) -> u64 in Trapping
crashes Trap
{
    transition binding {
        TypeBinding::Data { item } -> data(syntax, item)
        _ -> answer(0)
    }

    state data(syntax: &SyntaxTrees, item: u64 in Trapping) -> u64 in Trapping {
        let declaration: DataItem = SyntaxTrees::data_item(syntax, item);
        transition { _ -> next(syntax, declaration.first_generic_parameter, declaration.generic_parameter_count, 0, 0) }
    }

    state next(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping, found: u64 in Trapping) -> u64 in Trapping {
        transition offset < count {
            true -> candidate(syntax, first, count, offset, found)
            _ -> answer(found)
        }
    }

    state candidate(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping, found: u64 in Trapping) -> u64 in Trapping {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, first + offset);
        transition parameter.kind == GenericParameterKind::Lifetime {
            true -> next(syntax, first, count, offset + 1, found + 1)
            _ -> next(syntax, first, count, offset + 1, found)
        }
    }

    state answer(count: u64 in Trapping) -> u64 in Trapping {
        count
    }
}
