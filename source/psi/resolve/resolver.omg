use psi::resolution::resolution;
use psi::resolve::identities;
use psi::resolve::imports;
use psi::resolve::names;
use psi::source::source;
use psi::syntax::syntax;

// Name resolution over the parsed roots of a compilation's source units. The
// pass runs in fail-closed steps, each completing before the next begins:
// declaration kinds it binds, imports, top-level data names, member
// namespaces, stable identities (identities.omg), data type references,
// machine signature type references, body type references (`let` types,
// cast targets and static arguments), machine namespaces, then expression
// names. The first rejection is the diagnostic. Lookup mirrors the reference resolver: an
// enclosing generic parameter, then a builtin type, then a data declaration
// the reference's unit can see (imports.omg). Builtin and duplicate
// declarations reject before any lookup, so the builtin and data tiers
// never compete for one spelling; two visible declarations of one spelling
// reject as ambiguous.
pub data Resolver {
    output: NameResolution;
    // Name-resolution scratch: what each expression's position lets it name.
    name_roles: [NameRole; 65536];
}

pub machine Resolver::initialize(resolver: &mut Resolver) {
    NameResolution::clear(&mut resolver.output, SourceId { value: 0 });
}

pub machine Resolver::resolve(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    NameResolution::clear(&mut resolver.output, SourceId { value: 0 });
    Resolver::check_declaration_kinds(resolver, syntax);
    transition resolver.output.accepted {
        true -> imports(resolver, sources, syntax)
        _ -> done()
    }

    state imports(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::check_imports(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> declarations(resolver, sources, syntax)
            _ -> done()
        }
    }

    state declarations(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::declare_data(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> members(resolver, sources, syntax)
            _ -> done()
        }
    }

    state members(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::check_members(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> identities(resolver, sources, syntax)
            _ -> done()
        }
    }

    state identities(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::check_stable_identities(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> references(resolver, sources, syntax)
            _ -> done()
        }
    }

    state references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> machine_references(resolver, sources, syntax)
            _ -> done()
        }
    }

    state machine_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_machine_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> body_references(resolver, sources, syntax)
            _ -> done()
        }
    }

    state body_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_body_references(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> machines(resolver, sources, syntax)
            _ -> done()
        }
    }

    state machines(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::check_machines(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> names(resolver, sources, syntax)
            _ -> done()
        }
    }

    state names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_body_names(resolver, sources, syntax);
        transition resolver.output.accepted {
            true -> publish(resolver, syntax)
            _ -> done()
        }
    }

    state publish(resolver: &mut Resolver, syntax: &SyntaxTrees) {
        resolver.output.binding_count = syntax.type_reference_count;
        resolver.output.value_binding_count = syntax.expression_count;
    }

    state done() {}
}

// The declaration kinds this resolver binds: `use`, `data` (`boundary data`
// declares an opaque type name like any other) and untargeted, non-boundary
// machines. Every other root rejects at its span, in source order, before
// any binding: its names would otherwise be absent from every scope.
machine Resolver::check_declaration_kinds(resolver: &mut Resolver, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, syntax, 0) }

    state next(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.root_count {
            true -> root(resolver, syntax, index)
            _ -> done()
        }
    }

    state root(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let root: RootItem = SyntaxTrees::root_item(syntax, index);
        transition root.kind {
            RootItemKind::Use -> next(resolver, syntax, index + 1)
            RootItemKind::Data -> next(resolver, syntax, index + 1)
            RootItemKind::Machine -> machine_root(resolver, syntax, index, root)
            _ -> reject(resolver, root.source_span)
        }
    }

    state machine_root(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping, root: RootItem) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, root.item_index);
        transition item.has_target || item.is_boundary {
            true -> reject(resolver, root.source_span)
            _ -> next(resolver, syntax, index + 1)
        }
    }

    state reject(resolver: &mut Resolver, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnsupportedDeclaration, source_span);
    }

    state done() {}
}

// Top-level data names. A name that spells a builtin type rejects: references
// would bind the builtin and the declaration could never be named. A name an
// earlier declaration of the same module already took rejects at the later
// declaration; other modules' declarations conflict only where both are
// visible to one reference.
machine Resolver::declare_data(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.data_count {
            true -> builtin_shadow(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state builtin_shadow(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, index);
        let builtin: TypeBinding = Resolver::builtin_type(sources, item.name.source_span);
        transition builtin {
            TypeBinding::Unresolved -> earlier(resolver, sources, syntax, index, item.name, 0)
            _ -> reject(resolver, ResolveDiagnosticCode::DataShadowsBuiltinType, item.name)
        }
    }

    state earlier(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < index {
            true -> compare(resolver, sources, syntax, index, name, prior)
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    state compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_item: DataItem = SyntaxTrees::data_item(syntax, prior);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            prior_item.name.source_span
        );
        let same_module: bool = Resolver::same_module(sources, name.source_span.source.value as u64 in Trapping,
            prior_item.name.source_span.source.value as u64 in Trapping);
        transition equal && same_module {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateData, name)
            _ -> earlier(resolver, sources, syntax, index, name, prior + 1)
        }
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    state done() {}
}

// Member namespaces of each data declaration. Direct fields and cases share
// one namespace in authored order. Each case's payload fields have their own
// namespace, which the declaration's direct (common) fields also occupy.
machine Resolver::check_members(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, sources, syntax, 0) }

    state next_data(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        transition data_index < syntax.data_count {
            true -> data_members(resolver, sources, syntax, data_index)
            _ -> done()
        }
    }

    state data_members(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, data_index);
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::check_generic_names(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, 0)
            _ -> done()
        }
    }

    state member(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.member_count {
            true -> member_named(resolver, sources, syntax, data_index, item, offset)
            _ -> cases(resolver, sources, syntax, data_index, item, 0)
        }
    }

    state member_named(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let data_member: DataMember = SyntaxTrees::data_member(syntax, item.first_member + offset);
        let name: IdentifierSpan = SyntaxTrees::member_name(syntax, data_member);
        transition { _ -> member_prior(resolver, sources, syntax, data_index, item, offset, name, 0) }
    }

    state member_prior(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < offset {
            true -> member_compare(resolver, sources, syntax, data_index, item, offset, name, prior)
            _ -> member(resolver, sources, syntax, data_index, item, offset + 1)
        }
    }

    state member_compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_member: DataMember = SyntaxTrees::data_member(syntax, item.first_member + prior);
        let prior_name: IdentifierSpan = SyntaxTrees::member_name(syntax, prior_member);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            prior_name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateDataMember, name)
            _ -> member_prior(resolver, sources, syntax, data_index, item, offset, name, prior + 1)
        }
    }

    state cases(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) {
        transition case_offset < item.case_count {
            true -> case_payload(resolver, sources, syntax, data_index, item, case_offset)
            _ -> next_data(resolver, sources, syntax, data_index + 1)
        }
    }

    state case_payload(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, item.first_case + case_offset);
        transition { _ -> payload(resolver, sources, syntax, data_index, item, case_offset, data_case, 0) }
    }

    state payload(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        transition field_offset < data_case.payload_field_count {
            true -> payload_named(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset)
            _ -> cases(resolver, sources, syntax, data_index, item, case_offset + 1)
        }
    }

    state payload_named(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        let field: DataField = SyntaxTrees::payload_field(syntax, data_case.first_payload_field + field_offset);
        transition { _ -> payload_prior(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, field.name, 0) }
    }

    state payload_prior(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < field_offset {
            true -> payload_compare(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, prior)
            _ -> common(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, 0)
        }
    }

    state payload_compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_field: DataField = SyntaxTrees::payload_field(syntax, data_case.first_payload_field + prior);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            prior_field.name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateCasePayloadField, name)
            _ -> payload_prior(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, prior + 1)
        }
    }

    state common(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, common_offset: u64 in Trapping) {
        transition common_offset < item.field_count {
            true -> common_compare(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, common_offset)
            _ -> payload(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset + 1)
        }
    }

    state common_compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, common_offset: u64 in Trapping) {
        let common_field: DataField = SyntaxTrees::field(syntax, item.first_field + common_offset);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            common_field.name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::PayloadFieldCollidesWithCommonField, name)
            _ -> common(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, common_offset + 1)
        }
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    state done() {}
}

// Type references of each data declaration: its generic-parameter
// annotations, then its members' references in authored order. Every type
// reference has exactly one owner, so this walk binds the whole table.
machine Resolver::bind_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, sources, syntax, 0) }

    state next_data(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        transition data_index < syntax.data_count {
            true -> data_references(resolver, sources, syntax, data_index)
            _ -> done()
        }
    }

    state data_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, data_index);
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::bind_generic_annotations(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, 0)
            _ -> done()
        }
    }

    state member(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.member_count {
            true -> member_kind(resolver, sources, syntax, data_index, item, offset)
            _ -> next_data(resolver, sources, syntax, data_index + 1)
        }
    }

    state member_kind(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let data_member: DataMember = SyntaxTrees::data_member(syntax, item.first_member + offset);
        transition data_member.kind {
            DataMemberKind::Field -> field_reference(resolver, sources, syntax, data_index, item, offset, data_member.item_index)
            DataMemberKind::Case -> case_references(resolver, sources, syntax, data_index, item, offset, data_member.item_index)
        }
    }

    state field_reference(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, handle: u64 in Trapping) {
        let field: DataField = SyntaxTrees::field(syntax, handle);
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, field.type_reference);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, offset + 1)
            _ -> done()
        }
    }

    state case_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, handle: u64 in Trapping) {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, handle);
        transition { _ -> payload(resolver, sources, syntax, data_index, item, offset, data_case, 0) }
    }

    state payload(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        transition field_offset < data_case.payload_field_count {
            true -> payload_reference(resolver, sources, syntax, data_index, item, offset, data_case, field_offset)
            _ -> member(resolver, sources, syntax, data_index, item, offset + 1)
        }
    }

    state payload_reference(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        let field: DataField = SyntaxTrees::payload_field(syntax, data_case.first_payload_field + field_offset);
        let scope: TypeScope = Resolver::data_scope(item);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, field.type_reference);
        transition resolver.output.accepted {
            true -> payload(resolver, sources, syntax, data_index, item, offset, data_case, field_offset + 1)
            _ -> done()
        }
    }

    state done() {}
}

// A data declaration's type scope: its own generic parameters.
machine Resolver::data_scope(item: DataItem) -> TypeScope {
    TypeScope {
        first_generic_parameter: item.first_generic_parameter,
        generic_parameter_count: item.generic_parameter_count
    }
}

// A machine's type scope: its own generic parameters, which its states and
// bodies share.
machine Resolver::machine_scope(item: MachineItem) -> TypeScope {
    TypeScope {
        first_generic_parameter: item.first_generic_parameter,
        generic_parameter_count: item.generic_parameter_count
    }
}

// The generic parameters of one declaration share one namespace, whatever
// their kinds.
machine Resolver::check_generic_names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, scope, 0) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        transition offset < scope.generic_parameter_count {
            true -> named(resolver, sources, syntax, scope, offset)
            _ -> done()
        }
    }

    state named(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, scope.first_generic_parameter + offset);
        transition { _ -> prior(resolver, sources, syntax, scope, offset, parameter.name, 0) }
    }

    state prior(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, name: IdentifierSpan, earlier: u64 in Trapping) {
        transition earlier < offset {
            true -> compare(resolver, sources, syntax, scope, offset, name, earlier)
            _ -> next(resolver, sources, syntax, scope, offset + 1)
        }
    }

    state compare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, name: IdentifierSpan, earlier: u64 in Trapping) {
        let earlier_parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, scope.first_generic_parameter + earlier);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            earlier_parameter.name.source_span
        );
        transition equal {
            true -> duplicate(resolver, name)
            _ -> prior(resolver, sources, syntax, scope, offset, name, earlier + 1)
        }
    }

    state duplicate(resolver: &mut Resolver, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::DuplicateGenericParameter, name.source_span);
    }

    state done() {}
}

// The type annotations of one declaration's value binders (`const N: u64`,
// `Count: u32`), each in the declaration's own scope.
machine Resolver::bind_generic_annotations(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, scope, 0) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        transition offset < scope.generic_parameter_count && resolver.output.accepted {
            true -> annotation(resolver, sources, syntax, scope, offset)
            _ -> done()
        }
    }

    state annotation(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping) {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, scope.first_generic_parameter + offset);
        transition parameter.has_type_reference {
            true -> bind(resolver, sources, syntax, scope, offset, parameter.type_reference)
            _ -> next(resolver, sources, syntax, scope, offset + 1)
        }
    }

    state bind(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, offset: u64 in Trapping, reference: u64 in Trapping) {
        Resolver::bind_type_reference(resolver, sources, syntax, scope, reference);
        transition { _ -> next(resolver, sources, syntax, scope, offset + 1) }
    }

    state done() {}
}

// Bind one type in its owner's scope. A type fills a contiguous run of
// rows that ends at its root, so every row of the run binds in order: a
// named row binds its name and an `in` domain, and a reference, array, slice
// or integer row binds by its form. Nested rows need no recursion.
machine Resolver::bind_type_reference(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    root: u64 in Trapping
)
crashes Trap
{
    let root_row: TypeReference = SyntaxTrees::type_reference(syntax, root);
    transition { _ -> next(resolver, sources, syntax, scope, root, root_row.first_row) }

    state next(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        root: u64 in Trapping,
        row: u64 in Trapping
    ) {
        transition row <= root && resolver.output.accepted {
            true -> bind(resolver, sources, syntax, scope, root, row)
            _ -> done()
        }
    }

    state bind(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        root: u64 in Trapping,
        row: u64 in Trapping
    ) {
        Resolver::bind_type_row(resolver, sources, syntax, scope, row);
        transition { _ -> next(resolver, sources, syntax, scope, root, row + 1) }
    }

    state done() {}
}

machine Resolver::bind_type_row(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    row: u64 in Trapping
)
crashes Trap
{
    let type_reference: TypeReference = SyntaxTrees::type_reference(syntax, row);
    transition type_reference.kind {
        TypeReferenceKind::Named -> named(resolver, sources, syntax, scope, row, type_reference)
        TypeReferenceKind::Reference -> formed(resolver, sources, row, type_reference, TypeBinding::Reference)
        TypeReferenceKind::Array -> formed(resolver, sources, row, type_reference, TypeBinding::Array)
        TypeReferenceKind::Slice -> formed(resolver, sources, row, type_reference, TypeBinding::Slice)
        TypeReferenceKind::Literal -> formed(resolver, sources, row, type_reference, TypeBinding::Literal)
    }

    state named(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        row: u64 in Trapping,
        type_reference: TypeReference
    ) {
        let binding: TypeBinding = Resolver::type_binding(sources, syntax, scope,
            type_reference.name.source_span
        );
        transition binding {
            TypeBinding::Unresolved -> unknown_type(resolver, type_reference.name)
            TypeBinding::Ambiguous -> ambiguous_type(resolver, type_reference.name)
            _ -> formed(resolver, sources, row, type_reference, binding)
        }
    }

    state formed(
        resolver: &mut Resolver,
        sources: &SourceSet,
        row: u64 in Trapping,
        type_reference: TypeReference,
        binding: TypeBinding
    ) {
        transition row < 16384 {
            true -> store(resolver, sources, row, type_reference, binding)
            _ -> invalid()
        }
    }

    state store(
        resolver: &mut Resolver,
        sources: &SourceSet,
        row: u64 in Trapping,
        type_reference: TypeReference,
        binding: TypeBinding
    ) {
        resolver.output.type_bindings[row] = binding;
        transition type_reference.has_domain {
            true -> qualified(resolver, sources, row, type_reference.domain)
            _ -> unqualified(resolver, row)
        }
    }

    state unqualified(resolver: &mut Resolver, row: u64 in Trapping) {
        transition row < 16384 {
            true -> unqualified_store(resolver, row)
            _ -> invalid()
        }
    }

    state unqualified_store(resolver: &mut Resolver, row: u64 in Trapping) {
        resolver.output.domain_bindings[row] = DomainBinding::Unqualified;
    }

    state qualified(
        resolver: &mut Resolver,
        sources: &SourceSet,
        row: u64 in Trapping,
        domain: IdentifierSpan
    ) {
        Resolver::bind_domain(resolver, sources, row, domain);
    }

    state unknown_type(resolver: &mut Resolver, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnknownDataType,
            name.source_span
        );
    }

    state ambiguous_type(resolver: &mut Resolver, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::AmbiguousName, name.source_span);
    }

    state invalid() {
        crash Trap;
    }
}

// The declaration a type name denotes in `scope`: an enclosing generic
// parameter by spelling (lifetimes are not type names), then a builtin type,
// then a data declaration the name's unit can see.
machine Resolver::type_binding(
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    name: SourceSpan
) -> TypeBinding
crashes Trap
{
    transition { _ -> generic(sources, syntax, scope, name, 0) }

    state generic(sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, name: SourceSpan, offset: u64 in Trapping) {
        transition offset < scope.generic_parameter_count {
            true -> generic_kind(sources, syntax, scope, name, offset)
            _ -> builtin(sources, syntax, name)
        }
    }

    state generic_kind(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        name: SourceSpan,
        offset: u64 in Trapping
    ) {
        let handle: u64 in Trapping = scope.first_generic_parameter + offset;
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, handle);
        transition parameter.kind {
            GenericParameterKind::Lifetime -> generic(sources, syntax, scope, name, offset + 1)
            _ -> generic_compare(sources, syntax, scope, name, offset, handle, parameter.name)
        }
    }

    state generic_compare(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        name: SourceSpan,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        parameter_name: IdentifierSpan
    ) {
        let equal: bool = SourceSet::spans_equal(sources, name, parameter_name.source_span);
        transition equal {
            true -> generic_found(handle)
            _ -> generic(sources, syntax, scope, name, offset + 1)
        }
    }

    state generic_found(parameter: u64 in Trapping) {
        TypeBinding::GenericParameter { parameter: parameter }
    }

    state builtin(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) {
        let binding: TypeBinding = Resolver::builtin_type(sources, name);
        transition binding {
            TypeBinding::Unresolved -> data(sources, syntax, name)
            _ -> found(binding)
        }
    }

    state data(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) {
        let lookup: Lookup = Resolver::data_named(sources, syntax, name);
        transition lookup {
            Lookup::Found { handle } -> found(TypeBinding::Data { item: handle })
            Lookup::Ambiguous -> found(TypeBinding::Ambiguous)
            Lookup::Absent -> found(TypeBinding::Unresolved)
        }
    }

    state found(binding: TypeBinding) {
        binding
    }
}

// The compiler-known domain an `in` qualifier names. Generic parameters do
// not bind domains, and no other domain can be declared in the current
// grammar, so any other spelling rejects.
machine Resolver::bind_domain(
    resolver: &mut Resolver,
    sources: &SourceSet,
    reference: u64 in Trapping,
    domain: IdentifierSpan
)
// The caller binds only references it has bounded by the syntax table.
requires reference < 16384
crashes Trap
{
    let matched: bool = SourceSet::span_spells(sources, domain.source_span, "Wrapping");
    transition matched {
        true -> bind(resolver, reference, DomainBinding::Wrapping)
        _ -> saturating(resolver, sources, reference, domain)
    }

    state saturating(resolver: &mut Resolver, sources: &SourceSet, reference: u64 in Trapping, domain: IdentifierSpan) {
        let matched: bool = SourceSet::span_spells(sources, domain.source_span, "Saturating");
        transition matched {
            true -> bind(resolver, reference, DomainBinding::Saturating)
            _ -> trapping(resolver, sources, reference, domain)
        }
    }

    state trapping(resolver: &mut Resolver, sources: &SourceSet, reference: u64 in Trapping, domain: IdentifierSpan) {
        let matched: bool = SourceSet::span_spells(sources, domain.source_span, "Trapping");
        transition matched {
            true -> bind(resolver, reference, DomainBinding::Trapping)
            _ -> finite(resolver, sources, reference, domain)
        }
    }

    state finite(resolver: &mut Resolver, sources: &SourceSet, reference: u64 in Trapping, domain: IdentifierSpan) {
        let matched: bool = SourceSet::span_spells(sources, domain.source_span, "Finite");
        transition matched {
            true -> bind(resolver, reference, DomainBinding::Finite)
            _ -> unknown(resolver, domain)
        }
    }

    state bind(resolver: &mut Resolver, reference: u64 in Trapping, binding: DomainBinding) {
        resolver.output.domain_bindings[reference] = binding;
    }

    state unknown(resolver: &mut Resolver, domain: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnknownDomain,
            domain.source_span
        );
    }
}

// The compiler-installed type a name spells, or `Unresolved`. Builtin names
// are not source declarations, so they match by spelling, not by span.
machine Resolver::builtin_type(sources: &SourceSet, name: SourceSpan) -> TypeBinding {
    let matched: bool = SourceSet::span_spells(sources, name, "bool");
    transition matched { true -> found(BuiltinType::Bool) _ -> spells_i8(sources, name) }

    state spells_i8(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "i8");
        transition matched { true -> found(BuiltinType::I8) _ -> spells_i16(sources, name) }
    }

    state spells_i16(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "i16");
        transition matched { true -> found(BuiltinType::I16) _ -> spells_i32(sources, name) }
    }

    state spells_i32(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "i32");
        transition matched { true -> found(BuiltinType::I32) _ -> spells_i64(sources, name) }
    }

    state spells_i64(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "i64");
        transition matched { true -> found(BuiltinType::I64) _ -> spells_u8(sources, name) }
    }

    state spells_u8(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "u8");
        transition matched { true -> found(BuiltinType::U8) _ -> spells_u16(sources, name) }
    }

    state spells_u16(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "u16");
        transition matched { true -> found(BuiltinType::U16) _ -> spells_u32(sources, name) }
    }

    state spells_u32(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "u32");
        transition matched { true -> found(BuiltinType::U32) _ -> spells_u64(sources, name) }
    }

    state spells_u64(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "u64");
        transition matched { true -> found(BuiltinType::U64) _ -> spells_addr(sources, name) }
    }

    state spells_addr(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "addr");
        transition matched { true -> found(BuiltinType::Address) _ -> spells_f32(sources, name) }
    }

    state spells_f32(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "f32");
        transition matched { true -> found(BuiltinType::F32) _ -> spells_f64(sources, name) }
    }

    state spells_f64(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "f64");
        transition matched { true -> found(BuiltinType::F64) _ -> spells_slice(sources, name) }
    }

    state spells_slice(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "Slice");
        transition matched { true -> found(BuiltinType::Slice) _ -> spells_result(sources, name) }
    }

    state spells_result(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "Result");
        transition matched { true -> found(BuiltinType::Result) _ -> spells_syscallresult(sources, name) }
    }

    state spells_syscallresult(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "SyscallResult");
        transition matched { true -> found(BuiltinType::SyscallResult) _ -> spells_terminal(sources, name) }
    }

    state spells_terminal(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "Terminal");
        transition matched { true -> found(BuiltinType::Terminal) _ -> spells_never(sources, name) }
    }

    state spells_never(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "Never");
        transition matched { true -> found(BuiltinType::Never) _ -> spells_uint(sources, name) }
    }

    state spells_uint(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "UInt");
        transition matched { true -> found(BuiltinType::UInt) _ -> spells_int(sources, name) }
    }

    state spells_int(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "Int");
        transition matched { true -> found(BuiltinType::Int) _ -> spells_atomicbool(sources, name) }
    }

    state spells_atomicbool(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "AtomicBool");
        transition matched { true -> found(BuiltinType::AtomicBool) _ -> spells_atomicu32(sources, name) }
    }

    state spells_atomicu32(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "AtomicU32");
        transition matched { true -> found(BuiltinType::AtomicU32) _ -> spells_atomicu64(sources, name) }
    }

    state spells_atomicu64(sources: &SourceSet, name: SourceSpan) {
        let matched: bool = SourceSet::span_spells(sources, name, "AtomicU64");
        transition matched { true -> found(BuiltinType::AtomicU64) _ -> absent() }
    }

    state found(builtin: BuiltinType) {
        TypeBinding::Builtin { builtin: builtin }
    }

    state absent() {
        TypeBinding::Unresolved
    }
}

// Machine signatures: each machine's generic annotations, its parameter and
// return types, then each state's, all in the machine's own scope.
machine Resolver::bind_machine_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_machine(resolver, sources, syntax, 0) }

    state next_machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> machine_signature(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state machine_signature(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let scope: TypeScope = Resolver::machine_scope(item);
        Resolver::bind_generic_annotations(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> entry_signature(resolver, sources, syntax, index, item, scope)
            _ -> done()
        }
    }

    state entry_signature(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        scope: TypeScope
    ) {
        Resolver::bind_signature(resolver, sources, syntax, scope, item.first_parameter, item.parameter_count,
            item.has_return_type, item.return_type
        );
        transition resolver.output.accepted {
            true -> state_signature(resolver, sources, syntax, index, item, 0)
            _ -> done()
        }
    }

    state state_signature(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < item.state_count {
            true -> bind_state(resolver, sources, syntax, index, item, offset)
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    state bind_state(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        let scope: TypeScope = Resolver::machine_scope(item);
        Resolver::bind_signature(resolver, sources, syntax, scope, state_item.first_parameter,
            state_item.parameter_count, state_item.has_return_type, state_item.return_type
        );
        transition resolver.output.accepted {
            true -> state_signature(resolver, sources, syntax, index, item, offset + 1)
            _ -> done()
        }
    }

    state done() {}
}

// One signature's parameter types, then its return type when present, in
// its machine's scope.
machine Resolver::bind_signature(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: TypeScope,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping,
    has_return_type: bool,
    return_type: u64 in Trapping
)
crashes Trap
{
    transition { _ -> parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, 0) }

    state parameter(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        has_return_type: bool,
        return_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < parameter_count {
            true -> bind_parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, offset)
            _ -> result(resolver, sources, syntax, scope, has_return_type, return_type)
        }
    }

    state bind_parameter(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        has_return_type: bool,
        return_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + offset);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, parameter.type_reference);
        transition resolver.output.accepted {
            true -> parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, offset + 1)
            _ -> done()
        }
    }

    state result(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: TypeScope,
        has_return_type: bool,
        return_type: u64 in Trapping
    ) {
        transition has_return_type {
            true -> bind_result(resolver, sources, syntax, scope, return_type)
            _ -> done()
        }
    }

    state bind_result(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: TypeScope, return_type: u64 in Trapping) {
        Resolver::bind_type_reference(resolver, sources, syntax, scope, return_type);
    }

    state done() {}
}

machine Resolver::empty_scope() -> TypeScope {
    TypeScope { first_generic_parameter: 0, generic_parameter_count: 0 }
}

// Machine namespaces. A machine's generic parameter names are distinct,
// each signature's parameter names are distinct, and a machine's state names
// are distinct; a state may repeat the machine's own name and its
// parameters' names. Two machines of one module may share an owner and name
// only as overloads: identical generic parameter kinds and parameter types
// make the later one a duplicate.
machine Resolver::check_machines(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_machine(resolver, sources, syntax, 0) }

    state next_machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> machine_parameters(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state machine_parameters(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let scope: TypeScope = Resolver::machine_scope(item);
        Resolver::check_generic_names(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> machine_parameter_names(resolver, sources, syntax, index, item)
            _ -> done()
        }
    }

    state machine_parameter_names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem) {
        Resolver::check_parameter_names(resolver, sources, syntax, item.first_parameter, item.parameter_count);
        transition resolver.output.accepted {
            true -> state_names(resolver, sources, syntax, index, item, 0)
            _ -> done()
        }
    }

    state state_names(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < item.state_count {
            true -> state_name(resolver, sources, syntax, index, item, offset)
            _ -> overloads(resolver, sources, syntax, index, item, 0)
        }
    }

    state state_name(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        Resolver::check_parameter_names(resolver, sources, syntax, state_item.first_parameter,
            state_item.parameter_count
        );
        transition resolver.output.accepted {
            true -> state_prior(resolver, sources, syntax, index, item, offset, state_item.name, 0)
            _ -> done()
        }
    }

    state state_prior(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        prior: u64 in Trapping
    ) {
        transition prior < offset {
            true -> state_compare(resolver, sources, syntax, index, item, offset, name, prior)
            _ -> state_names(resolver, sources, syntax, index, item, offset + 1)
        }
    }

    state state_compare(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        prior: u64 in Trapping
    ) {
        let prior_state: StateItem = SyntaxTrees::state_item(syntax, item.first_state + prior);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            prior_state.name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateState, name)
            _ -> state_prior(resolver, sources, syntax, index, item, offset, name, prior + 1)
        }
    }

    state overloads(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        prior: u64 in Trapping
    ) {
        transition prior < index {
            true -> overload_compare(resolver, sources, syntax, index, item, prior)
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    state overload_compare(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        prior: u64 in Trapping
    ) {
        let prior_item: MachineItem = SyntaxTrees::machine_item(syntax, prior);
        let same: bool = Resolver::same_machine_signature(resolver, sources, syntax, item, prior_item);
        let same_module: bool = Resolver::same_module(sources, item.name.source_span.source.value as u64 in Trapping,
            prior_item.name.source_span.source.value as u64 in Trapping);
        transition same && same_module {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateMachine, item.name)
            _ -> overloads(resolver, sources, syntax, index, item, prior + 1)
        }
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, code, name.source_span);
    }

    state done() {}
}

// Each parameter name of one signature differs from every earlier one.
machine Resolver::check_parameter_names(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping
)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, first_parameter, parameter_count, 0) }

    state next(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < parameter_count {
            true -> named(resolver, sources, syntax, first_parameter, parameter_count, offset)
            _ -> done()
        }
    }

    state named(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + offset);
        transition { _ -> prior(resolver, sources, syntax, first_parameter, parameter_count, offset, parameter.name, 0) }
    }

    state prior(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        earlier: u64 in Trapping
    ) {
        transition earlier < offset {
            true -> compare(resolver, sources, syntax, first_parameter, parameter_count, offset, name, earlier)
            _ -> next(resolver, sources, syntax, first_parameter, parameter_count, offset + 1)
        }
    }

    state compare(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        offset: u64 in Trapping,
        name: IdentifierSpan,
        earlier: u64 in Trapping
    ) {
        let earlier_parameter: Parameter = SyntaxTrees::parameter(syntax, first_parameter + earlier);
        let equal: bool = SourceSet::spans_equal(sources, name.source_span,
            earlier_parameter.name.source_span
        );
        transition equal {
            true -> duplicate(resolver, name)
            _ -> prior(resolver, sources, syntax, first_parameter, parameter_count, offset, name, earlier + 1)
        }
    }

    state duplicate(resolver: &mut Resolver, name: IdentifierSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::DuplicateParameter, name.source_span);
    }

    state done() {}
}

// Whether two machines declare the same overload: the same owner (or none),
// the same name, the same generic parameter kinds and the same parameter
// types, position by position. A generic parameter in a parameter type
// matches the one at the same position of the other machine's list, so
// `f<T>(value: T)` and `f<U>(other: U)` are one overload.
machine Resolver::same_machine_signature(
    resolver: &Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    left: MachineItem,
    right: MachineItem
) -> bool
crashes Trap
{
    let same_name: bool = SourceSet::spans_equal(sources, left.name.source_span,
        right.name.source_span
    );
    transition same_name && left.has_owner == right.has_owner && left.parameter_count == right.parameter_count
        && left.generic_parameter_count == right.generic_parameter_count {
        true -> owner(resolver, sources, syntax, left, right)
        _ -> different()
    }

    state owner(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, left: MachineItem, right: MachineItem) {
        let same_owner: bool = SourceSet::spans_equal(sources, left.owner.source_span,
            right.owner.source_span
        );
        transition same_owner {
            true -> generic(resolver, sources, syntax, left, right, 0)
            _ -> different()
        }
    }

    state generic(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left: MachineItem,
        right: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < left.generic_parameter_count {
            true -> generic_kind(resolver, sources, syntax, left, right, offset)
            _ -> parameter(resolver, sources, syntax, left, right, 0)
        }
    }

    state generic_kind(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left: MachineItem,
        right: MachineItem,
        offset: u64 in Trapping
    ) {
        let left_parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, left.first_generic_parameter + offset);
        let right_parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, right.first_generic_parameter + offset);
        transition left_parameter.kind == right_parameter.kind {
            true -> generic(resolver, sources, syntax, left, right, offset + 1)
            _ -> different()
        }
    }

    state parameter(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left: MachineItem,
        right: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < left.parameter_count {
            true -> compare(resolver, sources, syntax, left, right, offset)
            _ -> same()
        }
    }

    state compare(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left: MachineItem,
        right: MachineItem,
        offset: u64 in Trapping
    ) {
        let left_parameter: Parameter = SyntaxTrees::parameter(syntax, left.first_parameter + offset);
        let right_parameter: Parameter = SyntaxTrees::parameter(syntax, right.first_parameter + offset);
        let left_scope: TypeScope = Resolver::machine_scope(left);
        let right_scope: TypeScope = Resolver::machine_scope(right);
        let equal: bool = Resolver::same_type(resolver, sources, syntax, left_scope, left_parameter.type_reference,
            right_scope, right_parameter.type_reference
        );
        transition equal {
            true -> parameter(resolver, sources, syntax, left, right, offset + 1)
            _ -> different()
        }
    }

    state same() {
        true
    }

    state different() {
        false
    }
}

// Whether two bound types, each in its declaration's scope, are the same
// type. A run lists a type's rows children-first, and each form fixes its
// child count, so two runs denote the same type exactly when they have the
// same length and agree row by row in form, access, argument count, binding
// and domain. Generic parameters agree by position in their scopes. Integer
// rows compare by spelling until static evaluation lands.
machine Resolver::same_type(
    resolver: &Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    left_scope: TypeScope,
    left: u64 in Trapping,
    right_scope: TypeScope,
    right: u64 in Trapping
) -> bool
crashes Trap
{
    let left_root: TypeReference = SyntaxTrees::type_reference(syntax, left);
    let right_root: TypeReference = SyntaxTrees::type_reference(syntax, right);
    transition left - left_root.first_row == right - right_root.first_row {
        true -> rows(resolver, sources, syntax, left_scope, left_root.first_row, right_scope, right_root.first_row, left)
        _ -> different()
    }

    state rows(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_scope: TypeScope,
        left_row: u64 in Trapping,
        right_scope: TypeScope,
        right_row: u64 in Trapping,
        left_root: u64 in Trapping
    ) {
        transition left_row <= left_root {
            true -> row(resolver, sources, syntax, left_scope, left_row, right_scope, right_row, left_root)
            _ -> equal()
        }
    }

    state row(
        resolver: &Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        left_scope: TypeScope,
        left_row: u64 in Trapping,
        right_scope: TypeScope,
        right_row: u64 in Trapping,
        left_root: u64 in Trapping
    ) {
        let same: bool = Resolver::same_type_row(resolver, sources, syntax, left_scope, left_row, right_scope, right_row);
        transition same {
            true -> rows(resolver, sources, syntax, left_scope, left_row + 1, right_scope, right_row + 1, left_root)
            _ -> different()
        }
    }

    state equal() {
        true
    }

    state different() {
        false
    }
}

machine Resolver::same_type_row(
    resolver: &Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    left_scope: TypeScope,
    left: u64 in Trapping,
    right_scope: TypeScope,
    right: u64 in Trapping
) -> bool
crashes Trap
{
    let left_row: TypeReference = SyntaxTrees::type_reference(syntax, left);
    let right_row: TypeReference = SyntaxTrees::type_reference(syntax, right);
    transition left_row.kind == right_row.kind && left_row.access == right_row.access
        && left_row.argument_count == right_row.argument_count {
        true -> spelling(resolver, sources, left_scope, left, right_scope, right, left_row, right_row)
        _ -> different()
    }

    state spelling(
        resolver: &Resolver,
        sources: &SourceSet,
        left_scope: TypeScope,
        left: u64 in Trapping,
        right_scope: TypeScope,
        right: u64 in Trapping,
        left_row: TypeReference,
        right_row: TypeReference
    ) {
        transition left_row.kind {
            TypeReferenceKind::Literal -> literal(resolver, sources, left_scope, left, right_scope, right, left_row, right_row)
            _ -> bounded(resolver, left_scope, left, right_scope, right)
        }
    }

    state literal(
        resolver: &Resolver,
        sources: &SourceSet,
        left_scope: TypeScope,
        left: u64 in Trapping,
        right_scope: TypeScope,
        right: u64 in Trapping,
        left_row: TypeReference,
        right_row: TypeReference
    ) {
        let same: bool = SourceSet::spans_equal(sources, left_row.name.source_span,
            right_row.name.source_span
        );
        transition same {
            true -> bounded(resolver, left_scope, left, right_scope, right)
            _ -> different()
        }
    }

    state bounded(resolver: &Resolver, left_scope: TypeScope, left: u64 in Trapping, right_scope: TypeScope, right: u64 in Trapping) {
        transition left < 16384 && right < 16384 {
            true -> compare(resolver, left_scope, left, right_scope, right)
            _ -> different()
        }
    }

    state compare(resolver: &Resolver, left_scope: TypeScope, left: u64 in Trapping, right_scope: TypeScope, right: u64 in Trapping) {
        let left_domain: DomainBinding = resolver.output.domain_bindings[left];
        let right_domain: DomainBinding = resolver.output.domain_bindings[right];
        transition left_domain == right_domain {
            true -> same_binding(left_scope, resolver.output.type_bindings[left], right_scope, resolver.output.type_bindings[right])
            _ -> different()
        }
    }

    // TypeBinding carries payloads, so its cases are matched pairwise.
    state same_binding(left_scope: TypeScope, left: TypeBinding, right_scope: TypeScope, right: TypeBinding) {
        transition left {
            TypeBinding::Builtin { builtin } -> builtin_binding(builtin, right)
            TypeBinding::Data { item } -> data_binding(item, right)
            TypeBinding::GenericParameter { parameter } -> generic_binding(left_scope, parameter, right_scope, right)
            TypeBinding::Unresolved -> different()
            _ -> formed()
        }
    }

    state builtin_binding(left_builtin: BuiltinType, right: TypeBinding) {
        transition right {
            TypeBinding::Builtin { builtin } -> same_builtin(left_builtin, builtin)
            _ -> different()
        }
    }

    state same_builtin(left: BuiltinType, right: BuiltinType) {
        left == right
    }

    state data_binding(left_item: u64 in Trapping, right: TypeBinding) {
        transition right {
            TypeBinding::Data { item } -> same_handle(left_item, item)
            _ -> different()
        }
    }

    state generic_binding(left_scope: TypeScope, left_parameter: u64 in Trapping, right_scope: TypeScope, right: TypeBinding) {
        transition right {
            TypeBinding::GenericParameter { parameter } -> same_handle(left_parameter - left_scope.first_generic_parameter,
                parameter - right_scope.first_generic_parameter)
            _ -> different()
        }
    }

    state same_handle(left: u64 in Trapping, right: u64 in Trapping) {
        left == right
    }

    // Reference, array, slice and integer rows bind by form, which the
    // kinds already matched.
    state formed() {
        true
    }

    state different() {
        false
    }
}

// Body type references: every `let` statement's type, then every cast's
// target type and every static application's arguments, in table order. A
// machine's statements and its expressions each fill a contiguous run, and
// machines follow one another in both tables, so one pass with a cursor on
// the owning machine binds each in that machine's scope. Statements belong
// to machines only; an expression outside every machine, in a data
// declaration's `where` fact, binds in the empty scope.
machine Resolver::bind_body_references(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> statement(resolver, sources, syntax, 0, 0) }

    state statement(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition index < syntax.statement_count && resolver.output.accepted {
            true -> statement_owner(resolver, sources, syntax, index, owner)
            _ -> expressions(resolver, sources, syntax)
        }
    }

    state statement_owner(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition owner < syntax.machine_count {
            true -> statement_in(resolver, sources, syntax, index, owner)
            _ -> invalid()
        }
    }

    state statement_in(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, owner);
        let end: u64 in Trapping = Resolver::statement_end(syntax, item);
        transition index < end {
            true -> statement_kind(resolver, sources, syntax, index, owner, item)
            _ -> statement_owner(resolver, sources, syntax, index, owner + 1)
        }
    }

    state statement_kind(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        item: MachineItem
    ) {
        let statement: Statement = SyntaxTrees::statement(syntax, index);
        let scope: TypeScope = Resolver::machine_scope(item);
        transition statement.kind {
            StatementKind::Let -> bind_local(resolver, sources, syntax, index, owner, scope, statement.type_reference)
            _ -> statement(resolver, sources, syntax, index + 1, owner)
        }
    }

    state bind_local(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        reference: u64 in Trapping
    ) {
        Resolver::bind_type_reference(resolver, sources, syntax, scope, reference);
        transition { _ -> statement(resolver, sources, syntax, index + 1, owner) }
    }

    state expressions(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        transition resolver.output.accepted {
            true -> expression(resolver, sources, syntax, 0, 0)
            _ -> done()
        }
    }

    state expression(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition index < syntax.expression_count && resolver.output.accepted {
            true -> expression_owner(resolver, sources, syntax, index, owner)
            _ -> done()
        }
    }

    // Move the cursor past machines whose run ends at or before `index`.
    state expression_owner(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let scope: TypeScope = Resolver::empty_scope();
        transition owner < syntax.machine_count {
            true -> expression_in(resolver, sources, syntax, index, owner)
            _ -> expression_kind(resolver, sources, syntax, index, owner, scope)
        }
    }

    state expression_in(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, owner);
        transition index < item.first_expression + item.expression_count {
            true -> expression_scope(resolver, sources, syntax, index, owner, item)
            _ -> expression_owner(resolver, sources, syntax, index, owner + 1)
        }
    }

    state expression_scope(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        item: MachineItem
    ) {
        let owned: TypeScope = Resolver::machine_scope(item);
        let unowned: TypeScope = Resolver::empty_scope();
        transition index >= item.first_expression {
            true -> expression_kind(resolver, sources, syntax, index, owner, owned)
            _ -> expression_kind(resolver, sources, syntax, index, owner, unowned)
        }
    }

    state expression_kind(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope
    ) {
        let expression: Expression = SyntaxTrees::expression(syntax, index);
        transition expression.kind {
            ExpressionKind::Cast -> bind_cast(resolver, sources, syntax, index, owner, scope, expression.type_reference)
            ExpressionKind::Apply -> static_argument(resolver, sources, syntax, index, owner, scope, expression, 0)
            _ -> expression(resolver, sources, syntax, index + 1, owner)
        }
    }

    // A static application's arguments are types (or integer values) listed
    // in `type_arguments`; each binds like a body type.
    state static_argument(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        application: Expression,
        offset: u64 in Trapping
    ) {
        transition offset < application.count && resolver.output.accepted {
            true -> bind_static_argument(resolver, sources, syntax, index, owner, scope, application, offset)
            _ -> expression(resolver, sources, syntax, index + 1, owner)
        }
    }

    state bind_static_argument(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        application: Expression,
        offset: u64 in Trapping
    ) {
        let argument: u64 in Trapping = SyntaxTrees::type_argument(syntax, application.first + offset);
        Resolver::bind_type_reference(resolver, sources, syntax, scope, argument);
        transition { _ -> static_argument(resolver, sources, syntax, index, owner, scope, application, offset + 1) }
    }

    state bind_cast(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: TypeScope,
        reference: u64 in Trapping
    ) {
        Resolver::bind_type_reference(resolver, sources, syntax, scope, reference);
        transition { _ -> expression(resolver, sources, syntax, index + 1, owner) }
    }

    // Every statement lies in a machine's run.
    state invalid() {
        crash Trap;
    }

    state done() {}
}

// Where a machine's statement run ends: after its last state's statements,
// or after its entry statements when it declares no state.
machine Resolver::statement_end(syntax: &SyntaxTrees, item: MachineItem) -> u64 in Trapping
crashes Trap
{
    transition item.state_count > 0 {
        true -> last_state(syntax, item)
        _ -> entry(item)
    }

    state last_state(syntax: &SyntaxTrees, item: MachineItem) -> u64 in Trapping {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + item.state_count - 1);
        state_item.first_statement + state_item.statement_count
    }

    state entry(item: MachineItem) -> u64 in Trapping {
        item.first_statement + item.statement_count
    }
}
