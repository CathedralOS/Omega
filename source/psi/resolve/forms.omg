use psi::resolution::resolution;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Forms whose bindings resolution does not record yet. A mathematical
// definition (`let` root) or a transparent trait refinement rejects at its
// root; a trait's `where proposition` contract at that contract. A machine,
// whatever contains it, that gives a static machine binder a `where machine`
// contract, or declares a proposition binder, rejects at that form rather
// than resolving as if it were absent: a contract's binder needs a binding
// table this resolver does not keep yet. An evidence binder
// (`Reader satisfies Reading<Value>`) is admitted on a trait telescope,
// in the position the author wrote it among the other binders. Its trait
// application is an ordinary type reference bound as a trait, so earlier
// binders in that mixed telescope are in scope; the binder is not a stored
// type and not a second telescope. The same binder on a machine, data
// declaration, conformance, domain or proposition still rejects: machines
// keep a separate evidence telescope this resolver does not record, and the
// other declarations do not admit implementation parameters. An operator
// token binds (operators.omg)
// only on an ordinary owned machine (`machine + Vector::add`) and for an
// arithmetic or order token; a trait requirement's token (selected through
// a proof-static binder), an unqualified machine's (homed through a declared
// domain), equality's (the sealed `Equatable` route) and the collection
// tokens `[]` and `[..]` reject at the token. `satisfies` and `terminates`
// clauses bind in clauses.omg.
public machine Resolver::check_declaration_forms(resolver: &mut Resolver, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> root(resolver, syntax, 0) }

    machine root(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.root_count && resolver.output.accepted {
            true -> root_kind(resolver, syntax, index)
            _ -> machine_at(resolver, syntax, 0)
        }
    }

    machine root_kind(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: RootItem = SyntaxTrees::root_item(syntax, index);
        transition item.kind {
            RootItemKind::Definition -> reject(resolver, ResolveDiagnosticCode::UnsupportedDeclaration, item.source_span)
            RootItemKind::Trait -> trait_root(resolver, syntax, index, item)
            RootItemKind::Data -> data_binders(resolver, syntax, index, item)
            RootItemKind::Conformance -> conformance_binders(resolver, syntax, index, item)
            RootItemKind::Domain -> domain_binders(resolver, syntax, index, item)
            RootItemKind::Proposition -> proposition_binders(resolver, syntax, index, item)
            _ -> root(resolver, syntax, index + 1)
        }
    }

    machine data_binders(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping, item: RootItem) {
        let declared: DataItem = SyntaxTrees::data_item(syntax, item.item_index);
        Resolver::check_binder_forms(resolver, syntax, declared.first_generic_parameter, declared.generic_parameter_count, false);
        transition { _ -> root(resolver, syntax, index + 1) }
    }

    machine conformance_binders(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping, item: RootItem) {
        let declared: ConformanceItem = SyntaxTrees::conformance_item(syntax, item.item_index);
        Resolver::check_binder_forms(resolver, syntax, declared.first_generic_parameter, declared.generic_parameter_count, false);
        transition { _ -> root(resolver, syntax, index + 1) }
    }

    machine domain_binders(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping, item: RootItem) {
        let declared: DomainItem = SyntaxTrees::domain_item(syntax, item.item_index);
        Resolver::check_binder_forms(resolver, syntax, declared.first_generic_parameter, declared.generic_parameter_count, false);
        transition { _ -> root(resolver, syntax, index + 1) }
    }

    machine proposition_binders(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping, item: RootItem) {
        let declared: PropositionItem = SyntaxTrees::proposition_item(syntax, item.item_index);
        Resolver::check_binder_forms(resolver, syntax, declared.first_generic_parameter, declared.generic_parameter_count, false);
        transition { _ -> root(resolver, syntax, index + 1) }
    }

    machine trait_root(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping, item: RootItem) {
        let declared: TraitItem = SyntaxTrees::trait_item(syntax, item.item_index);
        transition declared.is_refinement {
            true -> reject(resolver, ResolveDiagnosticCode::UnsupportedDeclaration, item.source_span)
            _ -> trait_contracts(resolver, syntax, index, declared)
        }
    }

    machine trait_contracts(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping, declared: TraitItem) {
        transition declared.contract_count == 0 {
            true -> trait_binders(resolver, syntax, index, declared)
            _ -> trait_contract(resolver, syntax, declared)
        }
    }

    machine trait_binders(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping, declared: TraitItem) {
        Resolver::check_binder_forms(resolver, syntax, declared.first_generic_parameter, declared.generic_parameter_count, true);
        transition { _ -> root(resolver, syntax, index + 1) }
    }

    machine trait_contract(resolver: &mut Resolver, syntax: &SyntaxTrees, declared: TraitItem) {
        let first: Contract = SyntaxTrees::contract(syntax, declared.first_contract);
        transition { _ -> reject(resolver, ResolveDiagnosticCode::UnsupportedMachineContract, first.source_span) }
    }

    machine machine_at(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count && resolver.output.accepted {
            true -> machine_forms(resolver, syntax, index)
            _ -> done()
        }
    }

    machine machine_forms(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        Resolver::check_machine_forms(resolver, syntax, item);
        transition { _ -> machine_at(resolver, syntax, index + 1) }
    }

    machine reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, code, source_span);
    }

    machine done() {}
}

// A declaration's proposition binder rejects at that binder. An evidence
// binder rejects unless `admit_evidence` (a trait telescope) keeps it.
machine Resolver::check_binder_forms(resolver: &mut Resolver, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, admit_evidence: bool)
crashes Trap
{
    transition { _ -> next(resolver, syntax, first, count, admit_evidence, 0) }

    machine next(resolver: &mut Resolver, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, admit_evidence: bool, offset: u64 in Trapping) {
        transition offset < count {
            true -> binder(resolver, syntax, first, count, admit_evidence, offset)
            _ -> done()
        }
    }

    machine binder(resolver: &mut Resolver, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, admit_evidence: bool, offset: u64 in Trapping) {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, first + offset);
        transition parameter.kind {
            GenericParameterKind::Proposition -> reject(resolver, parameter.source_span)
            GenericParameterKind::Evidence -> evidence(resolver, syntax, first, count, admit_evidence, offset, parameter.source_span)
            _ -> next(resolver, syntax, first, count, admit_evidence, offset + 1)
        }
    }

    machine evidence(resolver: &mut Resolver, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, admit_evidence: bool, offset: u64 in Trapping, source_span: SourceSpan) {
        transition admit_evidence {
            true -> next(resolver, syntax, first, count, admit_evidence, offset + 1)
            _ -> reject(resolver, source_span)
        }
    }

    machine reject(resolver: &mut Resolver, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnsupportedGenericParameter, source_span);
    }

    machine done() {}
}

// One machine's forms, in authored order.
public machine Resolver::check_machine_forms(resolver: &mut Resolver, syntax: &SyntaxTrees, item: MachineItem)
crashes Trap
{
    let bindable: bool = Resolver::bindable_token(item.operator);
    transition item.operator == OperatorToken::None || (bindable && item.container == MachineContainer::Root && item.has_owner) {
        true -> contracts(resolver, syntax, item)
        _ -> reject(resolver, ResolveDiagnosticCode::UnsupportedOperatorToken, item.token.source_span)
    }

    // A structural callable contract (`where machine F(...) -> T` with
    // `requires`, `crashes`, `suspends` and `blocks` clauses) binds; a
    // nominal one (`satisfies`), one with its own binders, a proposition
    // contract, and `ensures`, `reaches` or `invokes` clauses reject as
    // unsupported (wiki/spec/language/generics.md, Static machine binder
    // categories).
    machine contracts(resolver: &mut Resolver, syntax: &SyntaxTrees, item: MachineItem) {
        transition { _ -> contract(resolver, syntax, item, 0) }
    }

    machine contract(resolver: &mut Resolver, syntax: &SyntaxTrees, item: MachineItem, offset: u64 in Trapping) {
        transition offset < item.contract_count && resolver.output.accepted {
            true -> shaped(resolver, syntax, item, offset)
            _ -> generic(resolver, syntax, item, 0)
        }
    }

    machine shaped(resolver: &mut Resolver, syntax: &SyntaxTrees, item: MachineItem, offset: u64 in Trapping) {
        let written: Contract = SyntaxTrees::contract(syntax, item.first_contract + offset);
        let clauses: bool = Resolver::callable_contract_clauses(syntax, written.first_clause, written.clause_count);
        transition written.kind == ContractKind::Machine && written.generic_parameter_count == 0 && clauses {
            true -> contract(resolver, syntax, item, offset + 1)
            _ -> reject(resolver, ResolveDiagnosticCode::UnsupportedMachineContract, written.source_span)
        }
    }

    machine generic(resolver: &mut Resolver, syntax: &SyntaxTrees, item: MachineItem, offset: u64 in Trapping) {
        transition offset < item.generic_parameter_count {
            true -> generic_kind(resolver, syntax, item, offset)
            _ -> done()
        }
    }

    machine generic_kind(resolver: &mut Resolver, syntax: &SyntaxTrees, item: MachineItem, offset: u64 in Trapping) {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, item.first_generic_parameter + offset);
        transition parameter.kind {
            GenericParameterKind::Proposition -> reject(resolver, ResolveDiagnosticCode::UnsupportedGenericParameter, parameter.source_span)
            GenericParameterKind::Evidence -> reject(resolver, ResolveDiagnosticCode::UnsupportedGenericParameter, parameter.source_span)
            _ -> generic(resolver, syntax, item, offset + 1)
        }
    }

    machine reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, code, source_span);
    }

    machine done() {}
}

// Whether a structural contract's clauses are ones this resolver binds:
// `requires` facts and the operational `crashes`, `suspends` and `blocks`.
machine Resolver::callable_contract_clauses(syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(syntax, first, first + count) }

    machine next(syntax: &SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping) -> bool {
        transition index < end {
            true -> clause(syntax, index, end)
            _ -> admitted()
        }
    }

    machine clause(syntax: &SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping) -> bool {
        let written: Clause = SyntaxTrees::clause(syntax, index);
        transition written.kind {
            ClauseKind::Requires -> next(syntax, index + 1, end)
            ClauseKind::Crashes -> next(syntax, index + 1, end)
            ClauseKind::Suspends -> next(syntax, index + 1, end)
            ClauseKind::Blocks -> next(syntax, index + 1, end)
            _ -> refused()
        }
    }

    machine admitted() -> bool {
        true
    }

    machine refused() -> bool {
        false
    }
}

// Whether resolution binds a direct machine's `token`: the arithmetic and
// order tokens.
public machine Resolver::bindable_token(token: OperatorToken) -> bool {
    transition token {
        OperatorToken::Add -> yes()
        OperatorToken::Subtract -> yes()
        OperatorToken::Multiply -> yes()
        OperatorToken::Divide -> yes()
        OperatorToken::Modulo -> yes()
        OperatorToken::Less -> yes()
        OperatorToken::LessEqual -> yes()
        OperatorToken::Greater -> yes()
        OperatorToken::GreaterEqual -> yes()
        _ -> no()
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}
