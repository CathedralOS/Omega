use psi::resolution::resolution;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Stable schema identities (wiki/spec/layouts/plans.md#policy-evaluation-and-schema).
// Each data declaration has one identity scope for its direct fields, one
// for its cases and one for each case's payload fields. Numbering is
// all-or-nothing within a scope: once one member carries `#N`, every member
// does. A numbered scope's identities are distinct nonnegative `u64`
// values, compared by value rather than spelling (`#1` and `#0x1` collide).
// Identities are not runtime discriminants and bind nothing.

public data IdentityScopeKind [copy] {
    case Fields;
    case Cases;
    case PayloadFields;
}

// One scope: a contiguous range of the fields, cases or payload-fields
// table.
public data IdentityScope [copy] {
    kind: IdentityScopeKind;
    first: u64 in Trapping;
    count: u64 in Trapping;
    // Declaration index for Fields/Cases, exact case index for PayloadFields.
    owner: u64 in Trapping;
}

// One member of a scope: its name and, when numbered, its literal's span.
public data MemberIdentity [copy] {
    name: IdentifierSpan;
    has_identity: bool;
    identity: SourceSpan;
}

// An identity literal's value, or not `valid` when the literal has a suffix
// or exceeds `u64`.
public data IdentityValue [copy] {
    valid: bool;
    value: u64 in Trapping;
}

public machine Resolver::check_stable_identities(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, sources, syntax, 0) }

    machine next_data(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.data_count && resolver.output.accepted {
            true -> declaration(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    machine declaration(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, index);
        transition item.field_count > 0 && item.case_count > 0 {
            true -> mixed_retirements(resolver, sources, syntax, index, item, 0)
            _ -> fields(resolver, sources, syntax, index, item)
        }
    }

    // A bare declaration retirement cannot choose between a mixed shape's
    // independent field and case scopes. Keep the existing refusal rather
    // than donating the number to both scopes.
    machine mixed_retirements(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        index: u64 in Trapping, item: DataItem, offset: u64 in Trapping)
    {
        transition offset < syntax.retired_identity_count {
            true -> mixed_retirement(resolver, sources, syntax, index, item, offset)
            _ -> fields(resolver, sources, syntax, index, item)
        }
    }

    machine mixed_retirement(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        index: u64 in Trapping, item: DataItem, offset: u64 in Trapping)
    {
        let retired: RetiredIdentity = SyntaxTrees::retired_identity(syntax, offset);
        transition retired.owner_kind == RetiredIdentityOwner::Declaration && retired.owner == index {
            true -> ambiguous_retirement(resolver, retired.source_span)
            _ -> mixed_retirements(resolver, sources, syntax, index, item, offset + 1)
        }
    }

    machine ambiguous_retirement(resolver: &mut Resolver, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnsupportedDeclaration, source_span);
    }

    machine fields(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        index: u64 in Trapping, item: DataItem)
    {
        Resolver::check_identity_scope(resolver, sources, syntax, IdentityScope {
            kind: IdentityScopeKind::Fields,
            first: item.first_field,
            count: item.field_count,
            owner: index
        });
        transition resolver.output.accepted {
            true -> cases(resolver, sources, syntax, index, item)
            _ -> done()
        }
    }

    machine cases(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: DataItem) {
        Resolver::check_identity_scope(resolver, sources, syntax, IdentityScope {
            kind: IdentityScopeKind::Cases,
            first: item.first_case,
            count: item.case_count,
            owner: index
        });
        transition { _ -> payload(resolver, sources, syntax, index, item, 0) }
    }

    machine payload(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.case_count && resolver.output.accepted {
            true -> payload_scope(resolver, sources, syntax, index, item, offset)
            _ -> next_data(resolver, sources, syntax, index + 1)
        }
    }

    machine payload_scope(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, item.first_case + offset);
        Resolver::check_identity_scope(resolver, sources, syntax, IdentityScope {
            kind: IdentityScopeKind::PayloadFields,
            first: data_case.first_payload_field,
            count: data_case.payload_field_count,
            owner: item.first_case + offset
        });
        transition { _ -> payload(resolver, sources, syntax, index, item, offset + 1) }
    }

    machine done() {}
}

// One scope: unnumbered, or numbered throughout with valid, distinct
// identities. An unnumbered member of a numbered scope rejects at its name;
// an invalid or repeated identity rejects at its literal.
machine Resolver::check_identity_scope(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: IdentityScope)
crashes Trap
{
    let retired: bool = Resolver::identity_scope_has_retirements(syntax, scope);
    transition retired {
        true -> member_at(resolver, sources, syntax, scope, 0)
        _ -> numbered(resolver, sources, syntax, scope, 0)
    }

    machine numbered(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: IdentityScope, offset: u64 in Trapping) {
        transition offset < scope.count {
            true -> numbered_member(resolver, sources, syntax, scope, offset)
            _ -> retired_at(resolver, sources, syntax, scope, 0)
        }
    }

    machine numbered_member(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: IdentityScope, offset: u64 in Trapping) {
        let member: MemberIdentity = Resolver::member_identity(syntax, scope, offset);
        transition member.has_identity {
            true -> member_at(resolver, sources, syntax, scope, 0)
            _ -> numbered(resolver, sources, syntax, scope, offset + 1)
        }
    }

    machine member_at(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: IdentityScope, offset: u64 in Trapping) {
        transition offset < scope.count {
            true -> member(resolver, sources, syntax, scope, offset)
            _ -> retired_at(resolver, sources, syntax, scope, 0)
        }
    }

    machine member(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: IdentityScope, offset: u64 in Trapping) {
        let identity: MemberIdentity = Resolver::member_identity(syntax, scope, offset);
        transition identity.has_identity {
            true -> value(resolver, sources, syntax, scope, offset, identity)
            _ -> reject(resolver, ResolveDiagnosticCode::PartialStableIdentities, identity.name.source_span)
        }
    }

    machine value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: IdentityScope, offset: u64 in Trapping, identity: MemberIdentity) {
        let decoded: IdentityValue = Resolver::identity_value(sources, identity.identity);
        transition decoded.valid {
            true -> prior(resolver, sources, syntax, scope, offset, identity, decoded.value, 0)
            _ -> reject(resolver, ResolveDiagnosticCode::InvalidStableIdentity, identity.identity)
        }
    }

    machine prior(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: IdentityScope,
        offset: u64 in Trapping,
        identity: MemberIdentity,
        decoded: u64 in Trapping,
        earlier: u64 in Trapping
    ) {
        transition earlier < offset {
            true -> compare(resolver, sources, syntax, scope, offset, identity, decoded, earlier)
            _ -> member_at(resolver, sources, syntax, scope, offset + 1)
        }
    }

    // Earlier identities already decoded validly.
    machine compare(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: IdentityScope,
        offset: u64 in Trapping,
        identity: MemberIdentity,
        decoded: u64 in Trapping,
        earlier: u64 in Trapping
    ) {
        let earlier_identity: MemberIdentity = Resolver::member_identity(syntax, scope, earlier);
        let earlier_value: IdentityValue = Resolver::identity_value(sources, earlier_identity.identity);
        transition earlier_value.value == decoded {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateStableIdentity, identity.identity)
            _ -> prior(resolver, sources, syntax, scope, offset, identity, decoded, earlier + 1)
        }
    }

    machine retired_at(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        scope: IdentityScope, offset: u64 in Trapping)
    {
        transition offset < syntax.retired_identity_count && resolver.output.accepted {
            true -> retired_member(resolver, sources, syntax, scope, offset)
            _ -> done()
        }
    }

    machine retired_member(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        scope: IdentityScope, offset: u64 in Trapping)
    {
        let retired: RetiredIdentity = SyntaxTrees::retired_identity(syntax, offset);
        let selected: bool = Resolver::retirement_in_scope(syntax, scope, retired);
        transition selected {
            true -> retired_value(resolver, sources, syntax, scope, offset, retired)
            _ -> retired_at(resolver, sources, syntax, scope, offset + 1)
        }
    }

    machine retired_value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        scope: IdentityScope, offset: u64 in Trapping, retired: RetiredIdentity)
    {
        let decoded: IdentityValue = Resolver::identity_value(sources, retired.identity);
        transition decoded.valid {
            true -> retired_live(resolver, sources, syntax, scope, offset, retired, decoded.value, 0)
            _ -> reject(resolver, ResolveDiagnosticCode::InvalidStableIdentity, retired.identity)
        }
    }

    machine retired_live(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        scope: IdentityScope, offset: u64 in Trapping, retired: RetiredIdentity,
        decoded: u64 in Trapping, live: u64 in Trapping)
    {
        transition live < scope.count {
            true -> retired_compare_live(resolver, sources, syntax, scope, offset, retired, decoded, live)
            _ -> retired_prior(resolver, sources, syntax, scope, offset, retired, decoded, 0)
        }
    }

    machine retired_compare_live(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        scope: IdentityScope, offset: u64 in Trapping, retired: RetiredIdentity,
        decoded: u64 in Trapping, live: u64 in Trapping)
    {
        let member: MemberIdentity = Resolver::member_identity(syntax, scope, live);
        let value: IdentityValue = Resolver::identity_value(sources, member.identity);
        transition value.value == decoded {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateStableIdentity, retired.identity)
            _ -> retired_live(resolver, sources, syntax, scope, offset, retired, decoded, live + 1)
        }
    }

    machine retired_prior(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        scope: IdentityScope, offset: u64 in Trapping, retired: RetiredIdentity,
        decoded: u64 in Trapping, prior: u64 in Trapping)
    {
        transition prior < offset {
            true -> retired_compare_prior(resolver, sources, syntax, scope, offset, retired, decoded, prior)
            _ -> retired_at(resolver, sources, syntax, scope, offset + 1)
        }
    }

    machine retired_compare_prior(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        scope: IdentityScope, offset: u64 in Trapping, retired: RetiredIdentity,
        decoded: u64 in Trapping, prior: u64 in Trapping)
    {
        let previous: RetiredIdentity = SyntaxTrees::retired_identity(syntax, prior);
        let selected: bool = Resolver::retirement_in_scope(syntax, scope, previous);
        transition selected {
            true -> retired_compare_value(resolver, sources, syntax, scope, offset, retired, decoded, prior, previous)
            _ -> retired_prior(resolver, sources, syntax, scope, offset, retired, decoded, prior + 1)
        }
    }

    machine retired_compare_value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees,
        scope: IdentityScope, offset: u64 in Trapping, retired: RetiredIdentity,
        decoded: u64 in Trapping, prior: u64 in Trapping, previous: RetiredIdentity)
    {
        let value: IdentityValue = Resolver::identity_value(sources, previous.identity);
        transition value.value == decoded {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateStableIdentity, retired.identity)
            _ -> retired_prior(resolver, sources, syntax, scope, offset, retired, decoded, prior + 1)
        }
    }

    machine reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, code, source_span);
    }

    machine done() {}
}

machine Resolver::member_identity(syntax: &SyntaxTrees, scope: IdentityScope, offset: u64 in Trapping) -> MemberIdentity
crashes Trap
{
    transition scope.kind {
        IdentityScopeKind::Fields -> field(syntax, scope.first + offset)
        IdentityScopeKind::Cases -> data_case(syntax, scope.first + offset)
        IdentityScopeKind::PayloadFields -> payload_field(syntax, scope.first + offset)
    }

    machine field(syntax: &SyntaxTrees, handle: u64 in Trapping) -> MemberIdentity {
        let field: DataField = SyntaxTrees::field(syntax, handle);
        MemberIdentity { name: field.name, has_identity: field.has_identity, identity: field.identity }
    }

    machine payload_field(syntax: &SyntaxTrees, handle: u64 in Trapping) -> MemberIdentity {
        let field: DataField = SyntaxTrees::payload_field(syntax, handle);
        MemberIdentity { name: field.name, has_identity: field.has_identity, identity: field.identity }
    }

    machine data_case(syntax: &SyntaxTrees, handle: u64 in Trapping) -> MemberIdentity {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, handle);
        MemberIdentity { name: data_case.name, has_identity: data_case.has_identity, identity: data_case.identity }
    }
}

// The value of an identity literal: decimal digits, or `0x`, `0o` or `0b`
// and digits of that base, with `_` separators. Any other byte, a suffix
// included, or a value past `u64` leaves it invalid.
machine Resolver::identity_value(sources: &SourceSet, literal: SourceSpan) -> IdentityValue
crashes Trap
{
    let first: u8 = SourceSet::byte_or_nul(sources, literal.source, literal.span.start);
    let second: u8 = SourceSet::byte_or_nul(sources, literal.source, literal.span.start + 1);
    let prefixed: bool = first == 48 && literal.span.start + 1 < literal.span.end;
    transition prefixed {
        true -> prefix(sources, literal, second)
        _ -> digits(sources, literal, literal.span.start, 10, 0, false)
    }

    machine prefix(sources: &SourceSet, literal: SourceSpan, second: u8) -> IdentityValue {
        let hexadecimal: bool = second == 120 || second == 88;
        let octal: bool = second == 111 || second == 79;
        let binary: bool = second == 98 || second == 66;
        transition hexadecimal {
            true -> digits(sources, literal, literal.span.start + 2, 16, 0, false)
            _ -> octal_prefix(sources, literal, octal, binary)
        }
    }

    machine octal_prefix(sources: &SourceSet, literal: SourceSpan, octal: bool, binary: bool) -> IdentityValue {
        transition octal {
            true -> digits(sources, literal, literal.span.start + 2, 8, 0, false)
            _ -> binary_prefix(sources, literal, binary)
        }
    }

    machine binary_prefix(sources: &SourceSet, literal: SourceSpan, binary: bool) -> IdentityValue {
        transition binary {
            true -> digits(sources, literal, literal.span.start + 2, 2, 0, false)
            _ -> digits(sources, literal, literal.span.start, 10, 0, false)
        }
    }

    machine digits(
        sources: &SourceSet,
        literal: SourceSpan,
        index: u64 in Trapping,
        radix: u64 in Trapping,
        value: u64 in Trapping,
        any: bool
    ) -> IdentityValue {
        transition index < literal.span.end {
            true -> digit(sources, literal, index, radix, value, any)
            _ -> finish(value, any)
        }
    }

    machine digit(
        sources: &SourceSet,
        literal: SourceSpan,
        index: u64 in Trapping,
        radix: u64 in Trapping,
        value: u64 in Trapping,
        any: bool
    ) -> IdentityValue {
        let byte: u8 = SourceSet::byte_or_nul(sources, literal.source, index);
        let decoded: u64 in Trapping = Resolver::digit_value(byte);
        transition byte == 95 {
            true -> digits(sources, literal, index + 1, radix, value, any)
            _ -> radix_digit(sources, literal, index, radix, value, decoded)
        }
    }

    machine radix_digit(
        sources: &SourceSet,
        literal: SourceSpan,
        index: u64 in Trapping,
        radix: u64 in Trapping,
        value: u64 in Trapping,
        decoded: u64 in Trapping
    ) -> IdentityValue {
        transition decoded < radix {
            true -> accumulate(sources, literal, index, radix, value, decoded)
            _ -> invalid()
        }
    }

    // `value * radix + decoded` stays within `u64` exactly when `value` is
    // at most `(u64::MAX - decoded) / radix`.
    machine accumulate(
        sources: &SourceSet,
        literal: SourceSpan,
        index: u64 in Trapping,
        radix: u64 in Trapping,
        value: u64 in Trapping,
        decoded: u64 in Trapping
    ) -> IdentityValue {
        transition value <= (18446744073709551615 - decoded) / radix {
            true -> digits(sources, literal, index + 1, radix, value * radix + decoded, true)
            _ -> invalid()
        }
    }

    machine finish(value: u64 in Trapping, any: bool) -> IdentityValue {
        IdentityValue { valid: any, value: value }
    }

    machine invalid() -> IdentityValue {
        IdentityValue { valid: false, value: 0 }
    }
}

// A digit byte's value in bases up to 16; any other byte is 16, which no
// base admits.
machine Resolver::digit_value(byte: u8) -> u64 in Trapping {
    let decimal: bool = byte >= 48 && byte <= 57;
    let lower: bool = byte >= 97 && byte <= 102;
    let upper: bool = byte >= 65 && byte <= 70;
    transition decimal {
        true -> offset(byte, 48)
        _ -> letter(byte, lower, upper)
    }

    machine letter(byte: u8, lower: bool, upper: bool) -> u64 in Trapping {
        transition lower {
            true -> offset(byte, 87)
            _ -> upper_letter(byte, upper)
        }
    }

    machine upper_letter(byte: u8, upper: bool) -> u64 in Trapping {
        transition upper {
            true -> offset(byte, 55)
            _ -> other()
        }
    }

    machine offset(byte: u8, base: u64 in Trapping) -> u64 in Trapping {
        (byte as u64 in Trapping) - base
    }

    machine other() -> u64 in Trapping {
        16
    }
}

// Retirements activate numbered mode without contributing live members.
machine Resolver::identity_scope_has_retirements(syntax: &SyntaxTrees, scope: IdentityScope) -> bool
crashes Trap
{
    transition { _ -> next(syntax, scope, 0) }
    machine next(syntax: &SyntaxTrees, scope: IdentityScope, offset: u64 in Trapping) -> bool {
        transition offset < syntax.retired_identity_count {
            true -> inspect(syntax, scope, offset)
            _ -> absent()
        }
    }
    machine inspect(syntax: &SyntaxTrees, scope: IdentityScope, offset: u64 in Trapping) -> bool {
        let retired: RetiredIdentity = SyntaxTrees::retired_identity(syntax, offset);
        let selected: bool = Resolver::retirement_in_scope(syntax, scope, retired);
        transition selected {
            true -> present()
            _ -> next(syntax, scope, offset + 1)
        }
    }
    machine present() -> bool { true }
    machine absent() -> bool { false }
}

machine Resolver::retirement_in_scope(syntax: &SyntaxTrees, scope: IdentityScope, retired: RetiredIdentity) -> bool
crashes Trap
{
    transition retired.owner == scope.owner {
        true -> kind(syntax, scope, retired)
        _ -> absent()
    }
    machine kind(syntax: &SyntaxTrees, scope: IdentityScope, retired: RetiredIdentity) -> bool {
        transition scope.kind {
            IdentityScopeKind::Fields -> fields(syntax, scope, retired)
            IdentityScopeKind::Cases -> cases(syntax, scope, retired)
            IdentityScopeKind::PayloadFields -> payload(retired)
        }
    }
    machine fields(syntax: &SyntaxTrees, scope: IdentityScope, retired: RetiredIdentity) -> bool {
        let item: DataItem = SyntaxTrees::data_item(syntax, scope.owner);
        retired.owner_kind == RetiredIdentityOwner::Declaration && item.case_count == 0
    }
    machine cases(syntax: &SyntaxTrees, scope: IdentityScope, retired: RetiredIdentity) -> bool {
        let item: DataItem = SyntaxTrees::data_item(syntax, scope.owner);
        retired.owner_kind == RetiredIdentityOwner::Declaration && item.field_count == 0
    }
    machine payload(retired: RetiredIdentity) -> bool {
        retired.owner_kind == RetiredIdentityOwner::Payload
    }
    machine absent() -> bool { false }
}
