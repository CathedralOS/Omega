use psi::resolution::resolution;
use psi::resolve::containers;
use psi::resolve::domains;
use psi::resolve::imports;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Expression names. Every name and path in a machine body, and in a
// constant's value, binds in the order of
// wiki/spec/language/modules.md#resolution: a local binding, then the body's
// parameters (a state sees only its own, never the entry's), then the
// machine's generic parameters (a trait or conformance member's own, then
// its container's), then the unit's declarations. Where the name stands
// decides which declarations it may name: a value names a value binder
// (`Count: u32`, `const N: u64`) or a constant, a call's callee a machine
// binder, then a fellow member of the enclosing trait or conformance, then a
// machine or a proposition, a call-shaped transition target a state of its
// machine before any callee, a construction's path a data declaration or
// `Type::Case`, a case pattern's path a case, and a path in value position a
// case, an owned constant (`Owner::NAME`) or an owned machine. A callee path names a
// machine through its owner, so `Trait::requirement` names a trait
// requirement and `Conformance::member` a conformance's member, or the
// machine its reference row or its trait supplies for that requirement. A
// value target binds as any value, and so do a value-position match's
// subject, value patterns and values. A pattern field renamed `field as
// name` binds as `name`, and a waived `field as _` binds nothing. A
// membership binds the case its `Type::Case` domain names, or the domain
// declaration its path names (`Carrier::Name`, or a name only one visible
// domain declares). A proposition applies only as a whole fact
// (`requires P(x)`); applied where a value is computed it rejects. Field
// selection (`value.field`) needs the value's type and is typing's
// question, not resolution's. Facts bind in facts.omg; domain predicates
// and proposition bodies bind no names yet.

// What a name's position lets it name. Children precede their parent in the
// expression table, so one pass over the table gives each child its role
// before the bodies bind.
pub data NameRole [copy] {
    case Value;
    case Callee;
    case Target;
    case Construction;
    case CasePattern;
}

// One body's names: its machine, its parameters and its statements, and how
// far into the statements locals are visible. A transition arm adds the
// binders of its case pattern for its target.
pub data NameScope [copy] {
    // A constant's value has no enclosing machine.
    has_machine: bool;
    machine: u64 in Trapping;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    first_statement: u64 in Trapping;
    visible_statement_end: u64 in Trapping;
    first_binder: u64 in Trapping;
    binder_count: u64 in Trapping;
    // Whether `result` names the machine's returned value: its `ensures`
    // facts.
    names_result: bool;
    // Whether the names are a fact's, rooted at `fact_root`: only there may
    // a proposition apply.
    in_fact: bool;
    fact_root: u64 in Trapping;
    // Whether the names are domain `subject_domain`'s predicates, where its
    // subject binder names the classified value.
    names_subject: bool;
    subject_domain: u64 in Trapping;
}

pub machine Resolver::bind_body_names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    Resolver::assign_name_roles(resolver, syntax);
    transition { _ -> next_machine(resolver, sources, syntax, 0) }

    state next_machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count && resolver.output.accepted {
            true -> entry(resolver, sources, syntax, index)
            _ -> constants(resolver, sources, syntax)
        }
    }

    state constants(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees) {
        Resolver::bind_constant_values(resolver, sources, syntax);
    }

    state entry(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        Resolver::bind_body(resolver, sources, syntax, index, item.first_parameter, item.parameter_count,
            item.first_statement, item.statement_count
        );
        transition { _ -> next_state(resolver, sources, syntax, index, item, 0) }
    }

    state next_state(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < item.state_count && resolver.output.accepted {
            true -> state_body(resolver, sources, syntax, index, item, offset)
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    state state_body(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        Resolver::bind_body(resolver, sources, syntax, index, state_item.first_parameter,
            state_item.parameter_count, state_item.first_statement, state_item.statement_count
        );
        transition { _ -> next_state(resolver, sources, syntax, index, item, offset + 1) }
    }

    state done() {}
}

// Each constant's value, with no locals, parameters or generic binders in
// scope.
machine Resolver::bind_constant_values(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.constant_count && resolver.output.accepted {
            true -> value(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: ConstantItem = SyntaxTrees::constant_item(syntax, index);
        Resolver::bind_tree(resolver, sources, syntax, NameScope {
            has_machine: false,
            machine: 0,
            first_parameter: 0,
            parameter_count: 0,
            first_statement: 0,
            visible_statement_end: 0,
            first_binder: 0,
            binder_count: 0,
            names_result: false,
            in_fact: false,
            fact_root: 0,
            names_subject: false,
            subject_domain: 0
        }, item.value);
        transition { _ -> next(resolver, sources, syntax, index + 1) }
    }

    state done() {}
}

// Calls, applications and constructions give their first child its role;
// every other node is a value.
machine Resolver::assign_name_roles(resolver: &mut Resolver, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, syntax, 0) }

    state next(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.expression_count {
            true -> clear(resolver, syntax, index)
            _ -> parents(resolver, syntax, 0)
        }
    }

    state clear(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        Resolver::set_role(resolver, index, NameRole::Value);
        transition index < 131072 {
            true -> unbound(resolver, syntax, index)
            _ -> next(resolver, syntax, index + 1)
        }
    }

    state unbound(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        resolver.output.value_bindings[index] = ValueBinding::NotAName;
        transition { _ -> next(resolver, syntax, index + 1) }
    }

    state parents(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.expression_count {
            true -> parent(resolver, syntax, index)
            _ -> done()
        }
    }

    state parent(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, index);
        transition expression.kind {
            ExpressionKind::Call -> child(resolver, syntax, index, expression.left, NameRole::Callee)
            ExpressionKind::Apply -> child(resolver, syntax, index, expression.left, NameRole::Callee)
            ExpressionKind::Construct -> child(resolver, syntax, index, expression.left, NameRole::Construction)
            _ -> parents(resolver, syntax, index + 1)
        }
    }

    state child(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping, left: u64 in Trapping, role: NameRole) {
        Resolver::set_role(resolver, left, role);
        transition { _ -> parents(resolver, syntax, index + 1) }
    }

    state done() {}
}

machine Resolver::set_role(resolver: &mut Resolver, index: u64 in Trapping, role: NameRole)
crashes Trap
{
    transition index < 131072 {
        true -> store(resolver, index, role)
        _ -> invalid()
    }

    state store(resolver: &mut Resolver, index: u64 in Trapping, role: NameRole) {
        resolver.name_roles[index] = role;
    }

    state invalid() {
        crash Trap;
    }
}

pub machine Resolver::role(resolver: &Resolver, index: u64 in Trapping) -> NameRole
crashes Trap
{
    transition index < 131072 {
        true -> read(resolver, index)
        _ -> invalid()
    }

    state read(resolver: &Resolver, index: u64 in Trapping) -> NameRole {
        resolver.name_roles[index]
    }

    state invalid() -> NameRole {
        crash Trap;
    }
}

// One body: each statement binds with the locals of the statements before
// it in scope.
machine Resolver::bind_body(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    machine_index: u64 in Trapping,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping,
    first_statement: u64 in Trapping,
    statement_count: u64 in Trapping
)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, NameScope {
        has_machine: true,
        machine: machine_index,
        first_parameter: first_parameter,
        parameter_count: parameter_count,
        first_statement: first_statement,
        visible_statement_end: first_statement,
        first_binder: 0,
        binder_count: 0,
        names_result: false,
        in_fact: false,
        fact_root: 0,
        names_subject: false,
        subject_domain: 0
    }, first_statement + statement_count) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, end: u64 in Trapping) {
        transition scope.visible_statement_end < end && resolver.output.accepted {
            true -> statement(resolver, sources, syntax, scope, end)
            _ -> done()
        }
    }

    state statement(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, end: u64 in Trapping) {
        Resolver::bind_statement(resolver, sources, syntax, scope);
        transition { _ -> next(resolver, sources, syntax, Resolver::through_statement(scope), end) }
    }

    state done() {}
}

// The scope after one more statement: its `let`, if any, becomes visible.
machine Resolver::through_statement(scope: NameScope) -> NameScope {
    NameScope {
        has_machine: scope.has_machine,
        machine: scope.machine,
        first_parameter: scope.first_parameter,
        parameter_count: scope.parameter_count,
        first_statement: scope.first_statement,
        visible_statement_end: scope.visible_statement_end + 1,
        first_binder: scope.first_binder,
        binder_count: scope.binder_count,
        names_result: scope.names_result,
        in_fact: scope.in_fact,
        fact_root: scope.fact_root,
        names_subject: scope.names_subject,
        subject_domain: scope.subject_domain
    }
}

machine Resolver::with_binders(scope: NameScope, first_binder: u64 in Trapping, binder_count: u64 in Trapping) -> NameScope {
    NameScope {
        has_machine: scope.has_machine,
        machine: scope.machine,
        first_parameter: scope.first_parameter,
        parameter_count: scope.parameter_count,
        first_statement: scope.first_statement,
        visible_statement_end: scope.visible_statement_end,
        first_binder: first_binder,
        binder_count: binder_count,
        names_result: scope.names_result,
        in_fact: scope.in_fact,
        fact_root: scope.fact_root,
        names_subject: scope.names_subject,
        subject_domain: scope.subject_domain
    }
}

// The statement at `scope.visible_statement_end` binds its expressions; its
// own `let` is not yet visible to its initializer.
machine Resolver::bind_statement(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope)
crashes Trap
{
    let statement: Statement = SyntaxTrees::statement(syntax, scope.visible_statement_end);
    transition statement.kind {
        StatementKind::Let -> optional_value(resolver, sources, syntax, scope, statement)
        StatementKind::Assign -> assignment(resolver, sources, syntax, scope, statement)
        StatementKind::Expression -> value(resolver, sources, syntax, scope, statement.value)
        StatementKind::Discard -> value(resolver, sources, syntax, scope, statement.value)
        StatementKind::Tail -> value(resolver, sources, syntax, scope, statement.value)
        StatementKind::Crash -> done()
        StatementKind::Transition -> subject(resolver, sources, syntax, scope, statement)
    }

    state optional_value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement) {
        transition statement.has_value {
            true -> value(resolver, sources, syntax, scope, statement.value)
            _ -> done()
        }
    }

    state assignment(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement) {
        Resolver::bind_tree(resolver, sources, syntax, scope, statement.target);
        transition { _ -> value(resolver, sources, syntax, scope, statement.value) }
    }

    state value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, root: u64 in Trapping) {
        Resolver::bind_tree(resolver, sources, syntax, scope, root);
    }

    state subject(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement) {
        transition statement.has_value {
            true -> subject_value(resolver, sources, syntax, scope, statement)
            _ -> arm(resolver, sources, syntax, scope, statement, 0)
        }
    }

    state subject_value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement) {
        Resolver::bind_tree(resolver, sources, syntax, scope, statement.value);
        transition { _ -> arm(resolver, sources, syntax, scope, statement, 0) }
    }

    state arm(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement, offset: u64 in Trapping) {
        transition offset < statement.arm_count && resolver.output.accepted {
            true -> bind_arm(resolver, sources, syntax, scope, statement, offset)
            _ -> done()
        }
    }

    state bind_arm(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement, offset: u64 in Trapping) {
        Resolver::bind_arm(resolver, sources, syntax, scope, statement.first_arm + offset);
        transition { _ -> arm(resolver, sources, syntax, scope, statement, offset + 1) }
    }

    state done() {}
}

// A guard or literal pattern binds as a value; a case pattern's path names a
// case and its field values bind as values. The arm's target then binds with
// the pattern's binders in scope, its callee naming a state or a machine.
machine Resolver::bind_arm(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, handle: u64 in Trapping)
crashes Trap
{
    let arm: TransitionArm = SyntaxTrees::arm(syntax, handle);
    transition arm.kind {
        ArmPatternKind::Guard -> pattern_value(resolver, sources, syntax, scope, arm)
        ArmPatternKind::Literal -> pattern_value(resolver, sources, syntax, scope, arm)
        ArmPatternKind::Case -> case_pattern(resolver, sources, syntax, scope, arm)
        ArmPatternKind::Wildcard -> guard_clause(resolver, sources, syntax, scope, arm)
    }

    state pattern_value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        Resolver::bind_tree(resolver, sources, syntax, scope, arm.pattern);
        transition { _ -> guard_clause(resolver, sources, syntax, scope, arm) }
    }

    // The arm's `if` guard binds with the pattern's binders in scope, as
    // its target does.
    state guard_clause(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        transition arm.has_guard && resolver.output.accepted {
            true -> guard_bound(resolver, sources, syntax, scope, arm)
            _ -> target(resolver, sources, syntax, scope, arm)
        }
    }

    state guard_bound(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        Resolver::bind_tree(resolver, sources, syntax, scope, arm.guard);
        transition { _ -> target(resolver, sources, syntax, scope, arm) }
    }

    state case_pattern(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        Resolver::set_role(resolver, arm.pattern, NameRole::CasePattern);
        Resolver::bind_tree(resolver, sources, syntax, scope, arm.pattern);
        transition { _ -> field(resolver, sources, syntax, scope, arm, 0) }
    }

    state field(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm, offset: u64 in Trapping) {
        transition offset < arm.field_count && resolver.output.accepted {
            true -> field_value(resolver, sources, syntax, scope, arm, offset)
            _ -> binders(resolver, sources, syntax, scope, arm)
        }
    }

    state field_value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm, offset: u64 in Trapping) {
        let pattern_field: PatternField = SyntaxTrees::pattern_field(syntax, arm.first_field + offset);
        transition pattern_field.has_value {
            true -> bound_field_value(resolver, sources, syntax, scope, arm, offset, pattern_field.value)
            _ -> field(resolver, sources, syntax, scope, arm, offset + 1)
        }
    }

    state bound_field_value(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: NameScope,
        arm: TransitionArm,
        offset: u64 in Trapping,
        value: u64 in Trapping
    ) {
        Resolver::bind_tree(resolver, sources, syntax, scope, value);
        transition { _ -> field(resolver, sources, syntax, scope, arm, offset + 1) }
    }

    state binders(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        transition { _ -> guard_clause(resolver, sources, syntax, Resolver::with_binders(scope, arm.first_field, arm.field_count), arm) }
    }

    state target(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        transition resolver.output.accepted {
            true -> target_kind(resolver, sources, syntax, scope, arm)
            _ -> done()
        }
    }

    state target_kind(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        transition arm.target_kind {
            ArmTargetKind::Call -> target_callee(resolver, sources, syntax, scope, arm)
            ArmTargetKind::Value -> value_target(resolver, sources, syntax, scope, arm)
            ArmTargetKind::Unit -> done()
        }
    }

    state value_target(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        Resolver::bind_tree(resolver, sources, syntax, scope, arm.target);
    }

    // The target is a call, or an acknowledged call (`suspend block f()`).
    state target_callee(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        let target: Expression = SyntaxTrees::expression(syntax, arm.target);
        transition target.kind {
            ExpressionKind::Call -> mark_target(resolver, sources, syntax, scope, arm, target.left)
            _ -> acknowledged(resolver, sources, syntax, scope, arm, target.left)
        }
    }

    state acknowledged(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm, call: u64 in Trapping) {
        let acknowledged_call: Expression = SyntaxTrees::expression(syntax, call);
        transition { _ -> mark_target(resolver, sources, syntax, scope, arm, acknowledged_call.left) }
    }

    state mark_target(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm, callee: u64 in Trapping) {
        Resolver::set_role(resolver, callee, NameRole::Target);
        Resolver::bind_tree(resolver, sources, syntax, scope, arm.target);
    }

    state done() {}
}

// Every name and path in the expression rooted at `root`: its subtree is the
// contiguous run from the root's first row to the root.
pub machine Resolver::bind_tree(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, root: u64 in Trapping)
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, root);
    transition { _ -> next(resolver, sources, syntax, scope, root, expression.first_row) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, root: u64 in Trapping, index: u64 in Trapping) {
        transition index <= root && resolver.output.accepted {
            true -> node(resolver, sources, syntax, scope, root, index)
            _ -> done()
        }
    }

    state node(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, root: u64 in Trapping, index: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, index);
        transition expression.kind {
            ExpressionKind::Name -> name(resolver, sources, syntax, scope, root, index, expression)
            ExpressionKind::Path -> name(resolver, sources, syntax, scope, root, index, expression)
            ExpressionKind::Membership -> membership(resolver, sources, syntax, scope, root, index, expression)
            _ -> next(resolver, sources, syntax, scope, root, index + 1)
        }
    }

    state membership(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: NameScope,
        root: u64 in Trapping,
        index: u64 in Trapping,
        expression: Expression
    ) {
        Resolver::bind_membership(resolver, sources, syntax, scope, index, expression);
        transition { _ -> next(resolver, sources, syntax, scope, root, index + 1) }
    }

    state name(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: NameScope,
        root: u64 in Trapping,
        index: u64 in Trapping,
        expression: Expression
    ) {
        Resolver::bind_name(resolver, sources, syntax, scope, index, expression);
        transition { _ -> next(resolver, sources, syntax, scope, root, index + 1) }
    }

    state done() {}
}

// One name or path, by its role. An unresolved name rejects at its span,
// and so does a proposition applied where none may be.
machine Resolver::bind_name(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: NameScope,
    index: u64 in Trapping,
    expression: Expression
)
crashes Trap
{
    let role: NameRole = Resolver::role(resolver, index);
    let binding: ValueBinding = Resolver::name_binding(&resolver.output, sources, syntax, scope, expression, role);
    transition binding {
        ValueBinding::Unresolved -> unresolved(resolver, expression)
        ValueBinding::Ambiguous -> ambiguous(resolver, expression)
        ValueBinding::Proposition { proposition } -> applied(resolver, syntax, scope, index, expression, binding)
        _ -> bound(resolver, index, binding)
    }

    state applied(resolver: &mut Resolver, syntax: &SyntaxTrees, scope: NameScope, index: u64 in Trapping, expression: Expression, binding: ValueBinding) {
        let code: ResolveDiagnosticCode = Resolver::proposition_site(syntax, scope.in_fact, scope.fact_root, index);
        transition code == ResolveDiagnosticCode::None {
            true -> bound(resolver, index, binding)
            _ -> misplaced(resolver, code, expression)
        }
    }

    state misplaced(resolver: &mut Resolver, code: ResolveDiagnosticCode, expression: Expression) {
        NameResolution::reject(&mut resolver.output, code, expression.source_span);
    }

    state bound(resolver: &mut Resolver, index: u64 in Trapping, binding: ValueBinding) {
        transition index < 131072 {
            true -> store(resolver, index, binding)
            _ -> invalid()
        }
    }

    state store(resolver: &mut Resolver, index: u64 in Trapping, binding: ValueBinding) {
        resolver.output.value_bindings[index] = binding;
    }

    state unresolved(resolver: &mut Resolver, expression: Expression) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnknownName, expression.source_span);
    }

    state ambiguous(resolver: &mut Resolver, expression: Expression) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::AmbiguousName, expression.source_span);
    }

    state invalid() {
        crash Trap;
    }
}

// What a name in `role` denotes, or `Unresolved`.
pub machine Resolver::name_binding(
    resolution: &NameResolution,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: NameScope,
    expression: Expression,
    role: NameRole
) -> ValueBinding
crashes Trap
{
    transition expression.kind {
        ExpressionKind::Name -> single(resolution, sources, syntax, scope, expression, role)
        _ -> path(resolution, sources, syntax, scope, expression, role)
    }

    state single(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, expression: Expression, role: NameRole) -> ValueBinding {
        let name: SourceSpan = expression.name.source_span;
        transition role {
            NameRole::Value -> Resolver::local_name(resolution, sources, syntax, scope, name)
            NameRole::Callee -> Resolver::callee_name(resolution, sources, syntax, scope, name)
            NameRole::Target -> Resolver::target_name(resolution, sources, syntax, scope, name)
            NameRole::Construction -> Resolver::data_name(sources, syntax, name)
            NameRole::CasePattern -> unresolved()
        }
    }

    // `Owner::name` names a case of data `Owner`, an owned constant or a
    // machine `Owner::name`; a longer path crosses a package, which a single
    // unit cannot bind.
    state path(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, expression: Expression, role: NameRole) -> ValueBinding {
        transition expression.count == 2 {
            true -> owned_members(resolution, sources, syntax, expression, role)
            _ -> unresolved()
        }
    }

    state owned_members(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, expression: Expression, role: NameRole) -> ValueBinding {
        let owner: IdentifierSpan = SyntaxTrees::member(syntax, expression.first);
        let member: IdentifierSpan = SyntaxTrees::member(syntax, expression.first + 1);
        transition { _ -> owned(resolution, sources, syntax, role, owner.source_span, member.source_span) }
    }

    state owned(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, role: NameRole, owner: SourceSpan, name: SourceSpan) -> ValueBinding {
        transition role {
            NameRole::Callee -> Resolver::owned_callee(resolution, sources, syntax, owner, name)
            NameRole::Target -> Resolver::owned_callee(resolution, sources, syntax, owner, name)
            _ -> Resolver::case_or_machine(resolution, sources, syntax, owner, name)
        }
    }

    state unresolved() -> ValueBinding {
        ValueBinding::Unresolved
    }
}

// A value name: the latest earlier `let` of this body, then the arm's
// pattern binders, then the body's parameters, then, in a domain's
// predicates, its subject binder, then, in an `ensures` fact, `result`,
// then a value binder of the enclosing machine, then a constant.
// An entry parameter spelled `result` shadows the returned value.
machine Resolver::local_name(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding
crashes Trap
{
    transition { _ -> local(resolution, sources, syntax, scope, name, scope.visible_statement_end) }

    state local(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, end: u64 in Trapping) -> ValueBinding {
        transition end > scope.first_statement {
            true -> local_statement(resolution, sources, syntax, scope, name, end - 1)
            _ -> binder(resolution, sources, syntax, scope, name, 0)
        }
    }

    state local_statement(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, index: u64 in Trapping) -> ValueBinding {
        let statement: Statement = SyntaxTrees::statement(syntax, index);
        let spelled: bool = SourceSet::spans_equal(sources, statement.name.source_span, name);
        transition statement.kind == StatementKind::Let && spelled {
            true -> found(ValueBinding::Local { statement: index })
            _ -> local(resolution, sources, syntax, scope, name, index)
        }
    }

    state binder(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        transition offset < scope.binder_count {
            true -> binder_field(resolution, sources, syntax, scope, name, offset)
            _ -> parameter(resolution, sources, syntax, scope, name, 0)
        }
    }

    // A binder is spelled by its rename (`field as name`), else by its field;
    // a waived field (`field as _`) binds nothing.
    state binder_field(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        let field: PatternField = SyntaxTrees::pattern_field(syntax, scope.first_binder + offset);
        let binder: IdentifierSpan = Resolver::binder_spelling(field);
        let spelled: bool = SourceSet::spans_equal(sources, binder.source_span, name);
        transition spelled && !field.has_value && !field.is_waived {
            true -> found(ValueBinding::PatternBinder { field: scope.first_binder + offset })
            _ -> binder(resolution, sources, syntax, scope, name, offset + 1)
        }
    }

    state parameter(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        transition offset < scope.parameter_count {
            true -> parameter_named(resolution, sources, syntax, scope, name, offset)
            _ -> subject(resolution, sources, syntax, scope, name)
        }
    }

    state subject(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding {
        transition scope.names_subject {
            true -> subject_named(resolution, sources, syntax, scope, name)
            _ -> returned(resolution, sources, syntax, scope, name)
        }
    }

    state subject_named(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, scope.subject_domain);
        let spelled: bool = SourceSet::spans_equal(sources, item.subject.source_span, name);
        transition item.has_subject && spelled {
            true -> found(ValueBinding::DomainSubject { domain: scope.subject_domain })
            _ -> returned(resolution, sources, syntax, scope, name)
        }
    }

    state returned(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding {
        let spelled: bool = SourceSet::span_spells(sources, name, "result");
        transition scope.names_result && spelled {
            true -> found(ValueBinding::ReturnedValue { machine: scope.machine })
            _ -> generic(resolution, sources, syntax, scope, name)
        }
    }

    state generic(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding {
        let binder: ValueBinding = Resolver::generic_name(resolution, sources, syntax, scope, name, false);
        transition binder {
            ValueBinding::GenericParameter { parameter } -> found(binder)
            _ -> constant(sources, syntax, name)
        }
    }

    state constant(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> ValueBinding {
        Resolver::constant_name(sources, syntax, false, name, name)
    }

    state parameter_named(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, scope.first_parameter + offset);
        let spelled: bool = SourceSet::spans_equal(sources, parameter.name.source_span, name);
        transition spelled {
            true -> found(ValueBinding::Parameter { parameter: scope.first_parameter + offset })
            _ -> parameter(resolution, sources, syntax, scope, name, offset + 1)
        }
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// The name a pattern field binds: its rename, else its own field name.
machine Resolver::binder_spelling(field: PatternField) -> IdentifierSpan {
    transition field.has_rename {
        true -> renamed(field)
        _ -> own(field)
    }

    state renamed(field: PatternField) {
        field.rename
    }

    state own(field: PatternField) {
        field.name
    }
}

// A membership `value in Domain` tests its value against one domain. A
// path `Owner::Name` names a case's implied domain, bound as the
// membership's value binding, or a declared domain (`Resolver::domain_path`);
// a declared domain binds in `NameResolution::path_bindings`. A bare name
// binds the one visible domain declaring it. Several bare candidates need
// the tested value's type to choose by carrier, and a membership in several
// domains at once is an expression form resolution does not bind yet: both
// reject as unsupported.
machine Resolver::bind_membership(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: NameScope,
    index: u64 in Trapping,
    expression: Expression
)
crashes Trap
{
    transition expression.count == 1 {
        true -> domain(resolver, sources, syntax, scope, index, expression)
        _ -> reject(resolver, ResolveDiagnosticCode::UnsupportedExpression, expression.source_span)
    }

    state domain(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, index: u64 in Trapping, expression: Expression) {
        let path: NamePath = SyntaxTrees::name_path(syntax, expression.first);
        transition path.member_count {
            1 -> bare(resolver, sources, syntax, expression.first, path)
            2 -> owned(resolver, sources, syntax, scope, index, expression.first, path)
            _ -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, path.source_span)
        }
    }

    state owned(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, index: u64 in Trapping, path_handle: u64 in Trapping, path: NamePath) {
        let owner: IdentifierSpan = SyntaxTrees::member(syntax, path.first_member);
        let member: IdentifierSpan = SyntaxTrees::member(syntax, path.first_member + 1);
        let types: TypeScope = Resolver::name_scope_types(&resolver.output, syntax, scope);
        let named: DomainPath = Resolver::domain_path(resolver, sources, syntax, types, owner.source_span, member.source_span);
        transition named {
            DomainPath::Case { item, data_case } -> bound(resolver, index, ValueBinding::DataCase { item: item, data_case: data_case })
            DomainPath::Declared { item } -> path_bound(resolver, path_handle, item)
            DomainPath::Ambiguous -> reject(resolver, ResolveDiagnosticCode::AmbiguousName, path.source_span)
            DomainPath::Absent -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, path.source_span)
        }
    }

    state bare(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, path_handle: u64 in Trapping, path: NamePath) {
        let name: IdentifierSpan = SyntaxTrees::member(syntax, path.first_member);
        let declared: Lookup = Resolver::domain_named(sources, syntax, name.source_span);
        transition declared {
            Lookup::Found { handle } -> path_bound(resolver, path_handle, handle)
            Lookup::Ambiguous -> reject(resolver, ResolveDiagnosticCode::UnsupportedExpression, path.source_span)
            Lookup::Absent -> reject(resolver, ResolveDiagnosticCode::UnknownDomain, path.source_span)
        }
    }

    state path_bound(resolver: &mut Resolver, path_handle: u64 in Trapping, domain: u64 in Trapping) {
        Resolver::set_path_binding(resolver, path_handle, PathBinding::Domain { item: domain });
    }

    state bound(resolver: &mut Resolver, index: u64 in Trapping, binding: ValueBinding) {
        transition index < 131072 {
            true -> store(resolver, index, binding)
            _ -> invalid()
        }
    }

    state store(resolver: &mut Resolver, index: u64 in Trapping, binding: ValueBinding) {
        resolver.output.value_bindings[index] = binding;
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, code, source_span);
    }

    state invalid() {
        crash Trap;
    }
}

// What a domain path `Owner::Name` names, wherever a domain stands: a case
// of data `Owner`, whose implied domain it is
// (wiki/spec/language/data_and_literals.md), or the declared domain `Name`
// whose carrier binds like the type `Owner` names in `types`
// (wiki/spec/language/modules.md#foreign-attached-declaration-paths). A
// case and a declared domain of one path compete.
pub data DomainPath [copy] {
    case Absent;
    case Ambiguous;
    case Case(item: u64 in Trapping, data_case: u64 in Trapping);
    case Declared(item: u64 in Trapping);
}

pub machine Resolver::domain_path(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, types: TypeScope, owner: SourceSpan, name: SourceSpan) -> DomainPath
crashes Trap
{
    let named: ValueBinding = Resolver::case_or_machine(&resolver.output, sources, syntax, owner, name);
    let declared: Lookup = Resolver::domain_by_head(resolver, sources, syntax, types, owner, name);
    transition named {
        ValueBinding::DataCase { item, data_case } -> case_domain(declared, item, data_case)
        ValueBinding::Ambiguous -> found(DomainPath::Ambiguous)
        _ -> declared_domain(declared)
    }

    state case_domain(declared: Lookup, item: u64 in Trapping, data_case: u64 in Trapping) -> DomainPath {
        transition declared {
            Lookup::Absent -> found(DomainPath::Case { item: item, data_case: data_case })
            _ -> found(DomainPath::Ambiguous)
        }
    }

    state declared_domain(declared: Lookup) -> DomainPath {
        transition declared {
            Lookup::Found { handle } -> found(DomainPath::Declared { item: handle })
            Lookup::Ambiguous -> found(DomainPath::Ambiguous)
            Lookup::Absent -> found(DomainPath::Absent)
        }
    }

    state found(path: DomainPath) -> DomainPath {
        path
    }
}

// The type scope of a name scope: its machine's, or none for a constant's
// value.
machine Resolver::name_scope_types(resolution: &NameResolution, syntax: &SyntaxTrees, scope: NameScope) -> TypeScope
crashes Trap
{
    transition scope.has_machine {
        true -> machine_types(resolution, syntax, scope.machine)
        _ -> none()
    }

    state machine_types(resolution: &NameResolution, syntax: &SyntaxTrees, machine_index: u64 in Trapping) -> TypeScope {
        Resolver::machine_scope(resolution, syntax, machine_index)
    }

    state none() -> TypeScope {
        Resolver::empty_scope()
    }
}

// The constant `name` (owned by `owner` when `owned`) denotes.
machine Resolver::constant_name(sources: &SourceSet, syntax: &SyntaxTrees, owned: bool, owner: SourceSpan, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let lookup: Lookup = Resolver::declared_named(sources, syntax, DeclarationKind::Constant, owned, owner, name);
    transition lookup {
        Lookup::Found { handle } -> found(ValueBinding::Constant { constant: handle })
        Lookup::Ambiguous -> found(ValueBinding::Ambiguous)
        Lookup::Absent -> found(ValueBinding::Unresolved)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// A machine whose path is `name` (owned by `owner` when `owned`): its
// overload family's first declaration, since typing selects among the
// overloads.
pub machine Resolver::machine_name(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owned: bool, owner: SourceSpan, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let lookup: Lookup = Resolver::machine_named(resolution, sources, syntax, owned, owner, name);
    transition lookup {
        Lookup::Found { handle } -> found(ValueBinding::Machine { handle: handle })
        Lookup::Ambiguous -> found(ValueBinding::Ambiguous)
        Lookup::Absent -> found(ValueBinding::Unresolved)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// A callee path `Owner::name`: the machine of that path, else, for a named
// conformance `Owner` declaring no such member, the machine its row or its
// trait supplies for requirement `name` (containers.omg).
machine Resolver::owned_callee(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let binding: ValueBinding = Resolver::machine_name(resolution, sources, syntax, true, owner, name);
    transition binding {
        ValueBinding::Unresolved -> row(resolution, sources, syntax, owner, name)
        _ -> found(binding)
    }

    state row(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan) -> ValueBinding {
        Resolver::conformance_row_named(resolution, sources, syntax, owner, name)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// A transition target: a state of the machine, else a callee.
machine Resolver::target_name(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let item: MachineItem = SyntaxTrees::machine_item(syntax, scope.machine);
    transition { _ -> next(resolution, sources, syntax, scope, item, name, 0) }

    state next(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, item: MachineItem, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        transition offset < item.state_count {
            true -> candidate(resolution, sources, syntax, scope, item, name, offset)
            _ -> callee(resolution, sources, syntax, scope, name)
        }
    }

    state candidate(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, item: MachineItem, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        let named: bool = SourceSet::spans_equal(sources, state_item.name.source_span, name);
        transition named {
            true -> found(ValueBinding::State { handle: item.first_state + offset })
            _ -> next(resolution, sources, syntax, scope, item, name, offset + 1)
        }
    }

    state callee(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding {
        Resolver::callee_name(resolution, sources, syntax, scope, name)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// A single-name callee: a machine binder of the enclosing machine, else a
// fellow member of its trait or conformance, else a free machine.
machine Resolver::callee_name(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let binder: ValueBinding = Resolver::generic_name(resolution, sources, syntax, scope, name, true);
    transition binder {
        ValueBinding::GenericParameter { parameter } -> found(binder)
        _ -> enclosing(resolution, sources, syntax, scope, name)
    }

    state enclosing(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding {
        transition scope.has_machine {
            true -> container(resolution, sources, syntax, scope, name)
            _ -> free_machine(resolution, sources, syntax, name)
        }
    }

    state container(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding {
        let owner: MachineOwner = NameResolution::machine_owner(resolution, scope.machine);
        transition owner.container == MachineContainer::Root || owner.container == MachineContainer::Measure {
            true -> free_machine(resolution, sources, syntax, name)
            _ -> fellow(resolution, sources, syntax, owner, name)
        }
    }

    state fellow(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owner: MachineOwner, name: SourceSpan) -> ValueBinding {
        let member: ValueBinding = Resolver::owned_callee(resolution, sources, syntax, owner.owner.source_span, name);
        transition member {
            ValueBinding::Unresolved -> free_machine(resolution, sources, syntax, name)
            _ -> found(member)
        }
    }

    state free_machine(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> ValueBinding {
        Resolver::free_callee(resolution, sources, syntax, name)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// A free callee: the machine or the proposition `name` names. Machines and
// propositions are one callee tier, so a machine and a proposition of one
// spelling are ambiguous.
pub machine Resolver::free_callee(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let named_machine: ValueBinding = Resolver::machine_name(resolution, sources, syntax, false, name, name);
    let named_proposition: Lookup = Resolver::declared_named(sources, syntax, DeclarationKind::Proposition, false, name, name);
    transition named_proposition {
        Lookup::Absent -> machine_found(sources, named_machine, name)
        Lookup::Ambiguous -> found(ValueBinding::Ambiguous)
        Lookup::Found { handle } -> proposition_found(named_machine, handle)
    }

    state machine_found(sources: &SourceSet, named_machine: ValueBinding, name: SourceSpan) -> ValueBinding {
        transition named_machine {
            ValueBinding::Unresolved -> primitive(sources, name)
            _ -> found(named_machine)
        }
    }

    state primitive(sources: &SourceSet, name: SourceSpan) -> ValueBinding {
        let binding: ValueBinding = Resolver::byte_predicate(sources, name);
        binding
    }

    state proposition_found(named_machine: ValueBinding, handle: u64 in Trapping) -> ValueBinding {
        transition named_machine {
            ValueBinding::Unresolved -> found(ValueBinding::Proposition { proposition: handle })
            _ -> found(ValueBinding::Ambiguous)
        }
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// The primitive byte predicate `name` spells, else unresolved.
machine Resolver::byte_predicate(sources: &SourceSet, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let utf8: bool = SourceSet::span_spells(sources, name, "valid_utf8");
    let nul: bool = SourceSet::span_spells(sources, name, "no_nul");
    let ascii: bool = SourceSet::span_spells(sources, name, "ascii_only");
    let empty: bool = SourceSet::span_spells(sources, name, "non_empty");
    transition utf8 {
        true -> found(BytePredicate::ValidUtf8)
        _ -> nul_spelled(nul, ascii, empty)
    }

    state nul_spelled(nul: bool, ascii: bool, empty: bool) -> ValueBinding {
        transition nul {
            true -> found(BytePredicate::NoNul)
            _ -> ascii_spelled(ascii, empty)
        }
    }

    state ascii_spelled(ascii: bool, empty: bool) -> ValueBinding {
        transition ascii {
            true -> found(BytePredicate::AsciiOnly)
            _ -> empty_spelled(empty)
        }
    }

    state empty_spelled(empty: bool) -> ValueBinding {
        transition empty {
            true -> found(BytePredicate::NonEmpty)
            _ -> unresolved()
        }
    }

    state found(predicate: BytePredicate) -> ValueBinding {
        ValueBinding::BytePredicate { predicate: predicate }
    }

    state unresolved() -> ValueBinding {
        ValueBinding::Unresolved
    }
}

// Where a proposition may apply: as a whole fact, `P(...)` or `P<...>(...)`
// with `index` its callee's name. A proposition names a statement, so it
// never applies where a value is computed (`ProofOnlyApplication`), and an
// application inside a larger fact is a form resolution does not bind yet.
// `None` admits the application.
pub machine Resolver::proposition_site(syntax: &SyntaxTrees, in_fact: bool, root: u64 in Trapping, index: u64 in Trapping) -> ResolveDiagnosticCode
crashes Trap
{
    transition in_fact {
        true -> fact(syntax, root, index)
        _ -> found(ResolveDiagnosticCode::ProofOnlyApplication)
    }

    state fact(syntax: &SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping) -> ResolveDiagnosticCode {
        let whole: Expression = SyntaxTrees::expression(syntax, root);
        transition whole.kind == ExpressionKind::Call {
            true -> called(syntax, whole.left, index)
            _ -> found(ResolveDiagnosticCode::UnsupportedExpression)
        }
    }

    state called(syntax: &SyntaxTrees, callee: u64 in Trapping, index: u64 in Trapping) -> ResolveDiagnosticCode {
        let written: Expression = SyntaxTrees::expression(syntax, callee);
        let applied: bool = callee == index || (written.kind == ExpressionKind::Apply && written.left == index);
        transition applied {
            true -> found(ResolveDiagnosticCode::None)
            _ -> found(ResolveDiagnosticCode::UnsupportedExpression)
        }
    }

    state found(code: ResolveDiagnosticCode) -> ResolveDiagnosticCode {
        code
    }
}

// A generic parameter of the enclosing machine named `name`, its own before
// its container's: a machine binder when `machine_binder` holds, else a
// value binder (`Count: u32`, `const N: u64`). Type and lifetime binders
// name no value, and a constant's value has no enclosing machine.
machine Resolver::generic_name(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, machine_binder: bool) -> ValueBinding
crashes Trap
{
    transition scope.has_machine {
        true -> machine_scope(resolution, sources, syntax, scope, name, machine_binder)
        _ -> domain_scope(sources, syntax, scope, name, machine_binder)
    }

    // A domain's predicates see its own generic parameters
    // (`domain<const Capacity: u64> u64::AtMost<Capacity>(value)`).
    state domain_scope(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, machine_binder: bool) -> ValueBinding {
        transition scope.names_subject {
            true -> domain_binders(sources, syntax, scope, name, machine_binder)
            _ -> found(ValueBinding::Unresolved)
        }
    }

    state domain_binders(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, machine_binder: bool) -> ValueBinding {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, scope.subject_domain);
        let binder: ValueBinding = Resolver::binder_named(sources, syntax, item.first_generic_parameter, item.generic_parameter_count, name, machine_binder);
        binder
    }

    state machine_scope(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, machine_binder: bool) -> ValueBinding {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, scope.machine);
        let own: ValueBinding = Resolver::binder_named(sources, syntax, item.first_generic_parameter, item.generic_parameter_count, name, machine_binder);
        transition own {
            ValueBinding::GenericParameter { parameter } -> found(own)
            _ -> outer(resolution, sources, syntax, scope, name, machine_binder)
        }
    }

    state outer(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, machine_binder: bool) -> ValueBinding {
        let owner: MachineOwner = NameResolution::machine_owner(resolution, scope.machine);
        let container: TypeScope = Resolver::container_scope(syntax, owner);
        Resolver::binder_named(sources, syntax, container.first_generic_parameter, container.generic_parameter_count, name, machine_binder)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// The binder of `first..first + count` named `name` and naming a machine
// (`machine_binder`) or a value.
machine Resolver::binder_named(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, machine_binder: bool) -> ValueBinding
crashes Trap
{
    transition { _ -> next(sources, syntax, first, count, name, machine_binder, 0) }

    state next(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, machine_binder: bool, offset: u64 in Trapping) -> ValueBinding {
        transition offset < count {
            true -> candidate(sources, syntax, first, count, name, machine_binder, offset)
            _ -> found(ValueBinding::Unresolved)
        }
    }

    state candidate(sources: &SourceSet, syntax: &SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, name: SourceSpan, machine_binder: bool, offset: u64 in Trapping) -> ValueBinding {
        let handle: u64 in Trapping = first + offset;
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, handle);
        let named: bool = SourceSet::spans_equal(sources, parameter.name.source_span, name);
        let admitted: bool = Resolver::binder_names(parameter.kind, machine_binder);
        transition named && admitted {
            true -> found(ValueBinding::GenericParameter { parameter: handle })
            _ -> next(sources, syntax, first, count, name, machine_binder, offset + 1)
        }
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// Whether a binder of `kind` names a machine (`machine_binder`) or a value.
pub machine Resolver::binder_names(kind: GenericParameterKind, machine_binder: bool) -> bool {
    transition kind {
        GenericParameterKind::Machine -> machine_kind(machine_binder)
        GenericParameterKind::Value -> value_kind(machine_binder)
        GenericParameterKind::Const -> value_kind(machine_binder)
        _ -> other()
    }

    state machine_kind(machine_binder: bool) {
        machine_binder
    }

    state value_kind(machine_binder: bool) {
        !machine_binder
    }

    state other() {
        false
    }
}

// A construction's data declaration.
machine Resolver::data_name(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let lookup: Lookup = Resolver::data_named(sources, syntax, name);
    transition lookup {
        Lookup::Found { handle } -> found(ValueBinding::Data { item: handle })
        Lookup::Ambiguous -> found(ValueBinding::Ambiguous)
        Lookup::Absent -> found(ValueBinding::Unresolved)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// `Owner::name` in value position: a case of data `Owner`, else a constant
// `Owner::name`, else a machine `Owner::name`.
machine Resolver::case_or_machine(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let owner_data: ValueBinding = Resolver::data_name(sources, syntax, owner);
    transition owner_data {
        ValueBinding::Data { item } -> cases(resolution, sources, syntax, owner, name, item)
        ValueBinding::Ambiguous -> found(ValueBinding::Ambiguous)
        _ -> owned_constant(resolution, sources, syntax, owner, name)
    }

    state cases(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan, item: u64 in Trapping) -> ValueBinding {
        let data_item: DataItem = SyntaxTrees::data_item(syntax, item);
        transition { _ -> case_at(resolution, sources, syntax, owner, name, item, data_item, 0) }
    }

    state case_at(
        resolution: &NameResolution,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        owner: SourceSpan,
        name: SourceSpan,
        item: u64 in Trapping,
        data_item: DataItem,
        offset: u64 in Trapping
    ) -> ValueBinding {
        transition offset < data_item.case_count {
            true -> case_named(resolution, sources, syntax, owner, name, item, data_item, offset)
            _ -> owned_constant(resolution, sources, syntax, owner, name)
        }
    }

    state case_named(
        resolution: &NameResolution,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        owner: SourceSpan,
        name: SourceSpan,
        item: u64 in Trapping,
        data_item: DataItem,
        offset: u64 in Trapping
    ) -> ValueBinding {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, data_item.first_case + offset);
        let named: bool = SourceSet::spans_equal(sources, data_case.name.source_span, name);
        transition named {
            true -> case_found(resolution, sources, syntax, owner, name, item, data_item.first_case + offset)
            _ -> case_at(resolution, sources, syntax, owner, name, item, data_item, offset + 1)
        }
    }

    // A visible constant of the same path competes with the case.
    state case_found(
        resolution: &NameResolution,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        owner: SourceSpan,
        name: SourceSpan,
        item: u64 in Trapping,
        data_case: u64 in Trapping
    ) -> ValueBinding {
        let rival: Lookup = Resolver::declared_named(sources, syntax, DeclarationKind::Constant, true, owner, name);
        transition rival {
            Lookup::Absent -> found(ValueBinding::DataCase { item: item, data_case: data_case })
            _ -> found(ValueBinding::Ambiguous)
        }
    }

    state owned_constant(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan) -> ValueBinding {
        let constant: ValueBinding = Resolver::constant_name(sources, syntax, true, owner, name);
        transition constant {
            ValueBinding::Unresolved -> owned_machine(resolution, sources, syntax, owner, name)
            _ -> found(constant)
        }
    }

    state owned_machine(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan) -> ValueBinding {
        Resolver::machine_name(resolution, sources, syntax, true, owner, name)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}
