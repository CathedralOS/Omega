use psi::resolution::resolution;
use psi::resolve::imports;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Expression names. Every name and path in a machine body binds in the
// order of wiki/spec/language/modules.md#resolution: a local binding, then
// the body's parameters (a state sees only its own, never the entry's), then
// the machine's generic parameters, then the unit's declarations. Where the
// name stands decides which declarations it may name: a value names a value
// binder (`Count: u32`, `const N: u64`), a call's callee a machine binder or
// a machine, a call-shaped transition target a state of its machine, then a
// machine binder, then a machine, a construction's path a data declaration
// or `Type::Case`, a case pattern's path a case, and a path in value position
// a case or an owned machine. A value target binds as any value. Field
// selection (`value.field`) needs the value's type and is typing's
// question, not resolution's.

// What a name's position lets it name. Children precede their parent in the
// expression table, so one pass over the table gives each child its role
// before the bodies bind.
pub data NameRole [copy] {
    case Value;
    case Callee;
    case Target;
    case Construction;
    case CasePattern;
}

// One body's names: its machine, its parameters and its statements, and how
// far into the statements locals are visible. A transition arm adds the
// binders of its case pattern for its target.
pub data NameScope [copy] {
    machine: u64 in Trapping;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    first_statement: u64 in Trapping;
    visible_statement_end: u64 in Trapping;
    first_binder: u64 in Trapping;
    binder_count: u64 in Trapping;
}

pub machine Resolver::bind_body_names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    Resolver::assign_name_roles(resolver, syntax);
    transition { _ -> next_machine(resolver, sources, syntax, 0) }

    state next_machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count && resolver.output.accepted {
            true -> entry(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state entry(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        Resolver::bind_body(resolver, sources, syntax, index, item.first_parameter, item.parameter_count,
            item.first_statement, item.statement_count
        );
        transition { _ -> next_state(resolver, sources, syntax, index, item, 0) }
    }

    state next_state(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        transition offset < item.state_count && resolver.output.accepted {
            true -> state_body(resolver, sources, syntax, index, item, offset)
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    state state_body(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping
    ) {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        Resolver::bind_body(resolver, sources, syntax, index, state_item.first_parameter,
            state_item.parameter_count, state_item.first_statement, state_item.statement_count
        );
        transition { _ -> next_state(resolver, sources, syntax, index, item, offset + 1) }
    }

    state done() {}
}

// Calls, applications and constructions give their first child its role;
// every other node is a value.
machine Resolver::assign_name_roles(resolver: &mut Resolver, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, syntax, 0) }

    state next(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.expression_count {
            true -> clear(resolver, syntax, index)
            _ -> parents(resolver, syntax, 0)
        }
    }

    state clear(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        Resolver::set_role(resolver, index, NameRole::Value);
        transition index < 32768 {
            true -> unbound(resolver, syntax, index)
            _ -> next(resolver, syntax, index + 1)
        }
    }

    state unbound(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        resolver.output.value_bindings[index] = ValueBinding::NotAName;
        transition { _ -> next(resolver, syntax, index + 1) }
    }

    state parents(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.expression_count {
            true -> parent(resolver, syntax, index)
            _ -> done()
        }
    }

    state parent(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, index);
        transition expression.kind {
            ExpressionKind::Call -> child(resolver, syntax, index, expression.left, NameRole::Callee)
            ExpressionKind::Apply -> child(resolver, syntax, index, expression.left, NameRole::Callee)
            ExpressionKind::Construct -> child(resolver, syntax, index, expression.left, NameRole::Construction)
            _ -> parents(resolver, syntax, index + 1)
        }
    }

    state child(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping, left: u64 in Trapping, role: NameRole) {
        Resolver::set_role(resolver, left, role);
        transition { _ -> parents(resolver, syntax, index + 1) }
    }

    state done() {}
}

machine Resolver::set_role(resolver: &mut Resolver, index: u64 in Trapping, role: NameRole)
crashes Trap
{
    transition index < 32768 {
        true -> store(resolver, index, role)
        _ -> invalid()
    }

    state store(resolver: &mut Resolver, index: u64 in Trapping, role: NameRole) {
        resolver.name_roles[index] = role;
    }

    state invalid() {
        crash Trap;
    }
}

machine Resolver::role(resolver: &Resolver, index: u64 in Trapping) -> NameRole
crashes Trap
{
    transition index < 32768 {
        true -> read(resolver, index)
        _ -> invalid()
    }

    state read(resolver: &Resolver, index: u64 in Trapping) -> NameRole {
        resolver.name_roles[index]
    }

    state invalid() -> NameRole {
        crash Trap;
    }
}

// One body: each statement binds with the locals of the statements before
// it in scope.
machine Resolver::bind_body(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    machine_index: u64 in Trapping,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping,
    first_statement: u64 in Trapping,
    statement_count: u64 in Trapping
)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, NameScope {
        machine: machine_index,
        first_parameter: first_parameter,
        parameter_count: parameter_count,
        first_statement: first_statement,
        visible_statement_end: first_statement,
        first_binder: 0,
        binder_count: 0
    }, first_statement + statement_count) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, end: u64 in Trapping) {
        transition scope.visible_statement_end < end && resolver.output.accepted {
            true -> statement(resolver, sources, syntax, scope, end)
            _ -> done()
        }
    }

    state statement(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, end: u64 in Trapping) {
        Resolver::bind_statement(resolver, sources, syntax, scope);
        transition { _ -> next(resolver, sources, syntax, Resolver::through_statement(scope), end) }
    }

    state done() {}
}

// The scope after one more statement: its `let`, if any, becomes visible.
machine Resolver::through_statement(scope: NameScope) -> NameScope {
    NameScope {
        machine: scope.machine,
        first_parameter: scope.first_parameter,
        parameter_count: scope.parameter_count,
        first_statement: scope.first_statement,
        visible_statement_end: scope.visible_statement_end + 1,
        first_binder: scope.first_binder,
        binder_count: scope.binder_count
    }
}

machine Resolver::with_binders(scope: NameScope, first_binder: u64 in Trapping, binder_count: u64 in Trapping) -> NameScope {
    NameScope {
        machine: scope.machine,
        first_parameter: scope.first_parameter,
        parameter_count: scope.parameter_count,
        first_statement: scope.first_statement,
        visible_statement_end: scope.visible_statement_end,
        first_binder: first_binder,
        binder_count: binder_count
    }
}

// The statement at `scope.visible_statement_end` binds its expressions; its
// own `let` is not yet visible to its initializer.
machine Resolver::bind_statement(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope)
crashes Trap
{
    let statement: Statement = SyntaxTrees::statement(syntax, scope.visible_statement_end);
    transition statement.kind {
        StatementKind::Let -> optional_value(resolver, sources, syntax, scope, statement)
        StatementKind::Assign -> assignment(resolver, sources, syntax, scope, statement)
        StatementKind::Expression -> value(resolver, sources, syntax, scope, statement.value)
        StatementKind::Tail -> value(resolver, sources, syntax, scope, statement.value)
        StatementKind::Crash -> done()
        StatementKind::Transition -> subject(resolver, sources, syntax, scope, statement)
    }

    state optional_value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement) {
        transition statement.has_value {
            true -> value(resolver, sources, syntax, scope, statement.value)
            _ -> done()
        }
    }

    state assignment(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement) {
        Resolver::bind_tree(resolver, sources, syntax, scope, statement.target);
        transition { _ -> value(resolver, sources, syntax, scope, statement.value) }
    }

    state value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, root: u64 in Trapping) {
        Resolver::bind_tree(resolver, sources, syntax, scope, root);
    }

    state subject(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement) {
        transition statement.has_value {
            true -> subject_value(resolver, sources, syntax, scope, statement)
            _ -> arm(resolver, sources, syntax, scope, statement, 0)
        }
    }

    state subject_value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement) {
        Resolver::bind_tree(resolver, sources, syntax, scope, statement.value);
        transition { _ -> arm(resolver, sources, syntax, scope, statement, 0) }
    }

    state arm(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement, offset: u64 in Trapping) {
        transition offset < statement.arm_count && resolver.output.accepted {
            true -> bind_arm(resolver, sources, syntax, scope, statement, offset)
            _ -> done()
        }
    }

    state bind_arm(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, statement: Statement, offset: u64 in Trapping) {
        Resolver::bind_arm(resolver, sources, syntax, scope, statement.first_arm + offset);
        transition { _ -> arm(resolver, sources, syntax, scope, statement, offset + 1) }
    }

    state done() {}
}

// A guard or literal pattern binds as a value; a case pattern's path names a
// case and its field values bind as values. The arm's target then binds with
// the pattern's binders in scope, its callee naming a state or a machine.
machine Resolver::bind_arm(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, handle: u64 in Trapping)
crashes Trap
{
    let arm: TransitionArm = SyntaxTrees::arm(syntax, handle);
    transition arm.kind {
        ArmPatternKind::Guard -> pattern_value(resolver, sources, syntax, scope, arm)
        ArmPatternKind::Literal -> pattern_value(resolver, sources, syntax, scope, arm)
        ArmPatternKind::Case -> case_pattern(resolver, sources, syntax, scope, arm)
        ArmPatternKind::Wildcard -> target(resolver, sources, syntax, scope, arm)
    }

    state pattern_value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        Resolver::bind_tree(resolver, sources, syntax, scope, arm.pattern);
        transition { _ -> target(resolver, sources, syntax, scope, arm) }
    }

    state case_pattern(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        Resolver::set_role(resolver, arm.pattern, NameRole::CasePattern);
        Resolver::bind_tree(resolver, sources, syntax, scope, arm.pattern);
        transition { _ -> field(resolver, sources, syntax, scope, arm, 0) }
    }

    state field(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm, offset: u64 in Trapping) {
        transition offset < arm.field_count && resolver.output.accepted {
            true -> field_value(resolver, sources, syntax, scope, arm, offset)
            _ -> binders(resolver, sources, syntax, scope, arm)
        }
    }

    state field_value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm, offset: u64 in Trapping) {
        let pattern_field: PatternField = SyntaxTrees::pattern_field(syntax, arm.first_field + offset);
        transition pattern_field.has_value {
            true -> bound_field_value(resolver, sources, syntax, scope, arm, offset, pattern_field.value)
            _ -> field(resolver, sources, syntax, scope, arm, offset + 1)
        }
    }

    state bound_field_value(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: NameScope,
        arm: TransitionArm,
        offset: u64 in Trapping,
        value: u64 in Trapping
    ) {
        Resolver::bind_tree(resolver, sources, syntax, scope, value);
        transition { _ -> field(resolver, sources, syntax, scope, arm, offset + 1) }
    }

    state binders(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        transition { _ -> target(resolver, sources, syntax, Resolver::with_binders(scope, arm.first_field, arm.field_count), arm) }
    }

    state target(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        transition resolver.output.accepted {
            true -> target_kind(resolver, sources, syntax, scope, arm)
            _ -> done()
        }
    }

    state target_kind(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        transition arm.target_kind {
            ArmTargetKind::Call -> target_callee(resolver, sources, syntax, scope, arm)
            ArmTargetKind::Value -> value_target(resolver, sources, syntax, scope, arm)
            ArmTargetKind::Unit -> done()
        }
    }

    state value_target(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        Resolver::bind_tree(resolver, sources, syntax, scope, arm.target);
    }

    // The target is a call, or an acknowledged call (`suspend block f()`).
    state target_callee(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm) {
        let target: Expression = SyntaxTrees::expression(syntax, arm.target);
        transition target.kind {
            ExpressionKind::Call -> mark_target(resolver, sources, syntax, scope, arm, target.left)
            _ -> acknowledged(resolver, sources, syntax, scope, arm, target.left)
        }
    }

    state acknowledged(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm, call: u64 in Trapping) {
        let acknowledged_call: Expression = SyntaxTrees::expression(syntax, call);
        transition { _ -> mark_target(resolver, sources, syntax, scope, arm, acknowledged_call.left) }
    }

    state mark_target(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, arm: TransitionArm, callee: u64 in Trapping) {
        Resolver::set_role(resolver, callee, NameRole::Target);
        Resolver::bind_tree(resolver, sources, syntax, scope, arm.target);
    }

    state done() {}
}

// Every name and path in the expression rooted at `root`: its subtree is the
// contiguous run from the root's first row to the root.
machine Resolver::bind_tree(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, root: u64 in Trapping)
crashes Trap
{
    let expression: Expression = SyntaxTrees::expression(syntax, root);
    transition { _ -> next(resolver, sources, syntax, scope, root, expression.first_row) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, root: u64 in Trapping, index: u64 in Trapping) {
        transition index <= root && resolver.output.accepted {
            true -> node(resolver, sources, syntax, scope, root, index)
            _ -> done()
        }
    }

    state node(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, root: u64 in Trapping, index: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, index);
        transition expression.kind {
            ExpressionKind::Name -> name(resolver, sources, syntax, scope, root, index, expression)
            ExpressionKind::Path -> name(resolver, sources, syntax, scope, root, index, expression)
            _ -> next(resolver, sources, syntax, scope, root, index + 1)
        }
    }

    state name(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        scope: NameScope,
        root: u64 in Trapping,
        index: u64 in Trapping,
        expression: Expression
    ) {
        Resolver::bind_name(resolver, sources, syntax, scope, index, expression);
        transition { _ -> next(resolver, sources, syntax, scope, root, index + 1) }
    }

    state done() {}
}

// One name or path, by its role. An unresolved name rejects at its span.
machine Resolver::bind_name(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: NameScope,
    index: u64 in Trapping,
    expression: Expression
)
crashes Trap
{
    let role: NameRole = Resolver::role(resolver, index);
    let binding: ValueBinding = Resolver::name_binding(sources, syntax, scope, expression, role);
    transition binding {
        ValueBinding::Unresolved -> unresolved(resolver, expression)
        ValueBinding::Ambiguous -> ambiguous(resolver, expression)
        _ -> bound(resolver, index, binding)
    }

    state bound(resolver: &mut Resolver, index: u64 in Trapping, binding: ValueBinding) {
        transition index < 32768 {
            true -> store(resolver, index, binding)
            _ -> invalid()
        }
    }

    state store(resolver: &mut Resolver, index: u64 in Trapping, binding: ValueBinding) {
        resolver.output.value_bindings[index] = binding;
    }

    state unresolved(resolver: &mut Resolver, expression: Expression) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnknownName, expression.source_span);
    }

    state ambiguous(resolver: &mut Resolver, expression: Expression) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::AmbiguousName, expression.source_span);
    }

    state invalid() {
        crash Trap;
    }
}

// What a name in `role` denotes, or `Unresolved`.
machine Resolver::name_binding(
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: NameScope,
    expression: Expression,
    role: NameRole
) -> ValueBinding
crashes Trap
{
    transition expression.kind {
        ExpressionKind::Name -> single(sources, syntax, scope, expression, role)
        _ -> path(sources, syntax, scope, expression, role)
    }

    state single(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, expression: Expression, role: NameRole) -> ValueBinding {
        let name: SourceSpan = expression.name.source_span;
        transition role {
            NameRole::Value -> Resolver::local_name(sources, syntax, scope, name)
            NameRole::Callee -> Resolver::callee_name(sources, syntax, scope, name)
            NameRole::Target -> Resolver::target_name(sources, syntax, scope, name)
            NameRole::Construction -> Resolver::data_name(sources, syntax, name)
            NameRole::CasePattern -> unresolved()
        }
    }

    // `Owner::name` names a case of data `Owner` or a machine `Owner::name`;
    // a longer path crosses a package, which a single unit cannot bind.
    state path(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, expression: Expression, role: NameRole) -> ValueBinding {
        transition expression.count == 2 {
            true -> owned_members(sources, syntax, expression, role)
            _ -> unresolved()
        }
    }

    state owned_members(sources: &SourceSet, syntax: &SyntaxTrees, expression: Expression, role: NameRole) -> ValueBinding {
        let owner: IdentifierSpan = SyntaxTrees::member(syntax, expression.first);
        let member: IdentifierSpan = SyntaxTrees::member(syntax, expression.first + 1);
        transition { _ -> owned(sources, syntax, role, owner.source_span, member.source_span) }
    }

    state owned(sources: &SourceSet, syntax: &SyntaxTrees, role: NameRole, owner: SourceSpan, name: SourceSpan) -> ValueBinding {
        transition role {
            NameRole::Callee -> Resolver::machine_name(sources, syntax, true, owner, name)
            NameRole::Target -> Resolver::machine_name(sources, syntax, true, owner, name)
            _ -> Resolver::case_or_machine(sources, syntax, owner, name)
        }
    }

    state unresolved() -> ValueBinding {
        ValueBinding::Unresolved
    }
}

// A value name: the latest earlier `let` of this body, then the arm's
// pattern binders, then the body's parameters.
machine Resolver::local_name(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding
crashes Trap
{
    transition { _ -> local(sources, syntax, scope, name, scope.visible_statement_end) }

    state local(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, end: u64 in Trapping) -> ValueBinding {
        transition end > scope.first_statement {
            true -> local_statement(sources, syntax, scope, name, end - 1)
            _ -> binder(sources, syntax, scope, name, 0)
        }
    }

    state local_statement(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, index: u64 in Trapping) -> ValueBinding {
        let statement: Statement = SyntaxTrees::statement(syntax, index);
        let spelled: bool = SourceSet::spans_equal(sources, statement.name.source_span, name);
        transition statement.kind == StatementKind::Let && spelled {
            true -> found(ValueBinding::Local { statement: index })
            _ -> local(sources, syntax, scope, name, index)
        }
    }

    state binder(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        transition offset < scope.binder_count {
            true -> binder_field(sources, syntax, scope, name, offset)
            _ -> parameter(sources, syntax, scope, name, 0)
        }
    }

    state binder_field(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        let field: PatternField = SyntaxTrees::pattern_field(syntax, scope.first_binder + offset);
        let spelled: bool = SourceSet::spans_equal(sources, field.name.source_span, name);
        transition spelled && !field.has_value {
            true -> found(ValueBinding::PatternBinder { field: scope.first_binder + offset })
            _ -> binder(sources, syntax, scope, name, offset + 1)
        }
    }

    state parameter(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        transition offset < scope.parameter_count {
            true -> parameter_named(sources, syntax, scope, name, offset)
            _ -> generic(sources, syntax, scope, name)
        }
    }

    state generic(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding {
        Resolver::generic_name(sources, syntax, scope, name, false)
    }

    state parameter_named(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        let parameter: Parameter = SyntaxTrees::parameter(syntax, scope.first_parameter + offset);
        let spelled: bool = SourceSet::spans_equal(sources, parameter.name.source_span, name);
        transition spelled {
            true -> found(ValueBinding::Parameter { parameter: scope.first_parameter + offset })
            _ -> parameter(sources, syntax, scope, name, offset + 1)
        }
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// A machine named `name` (and owned by `owner` when `owned`): its overload
// family's first declaration, since typing selects among the overloads.
machine Resolver::machine_name(sources: &SourceSet, syntax: &SyntaxTrees, owned: bool, owner: SourceSpan, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let lookup: Lookup = Resolver::machine_named(sources, syntax, owned, owner, name);
    transition lookup {
        Lookup::Found { handle } -> found(ValueBinding::Machine { handle: handle })
        Lookup::Ambiguous -> found(ValueBinding::Ambiguous)
        Lookup::Absent -> found(ValueBinding::Unresolved)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// A transition target: a state of the machine, else a callee.
machine Resolver::target_name(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let item: MachineItem = SyntaxTrees::machine_item(syntax, scope.machine);
    transition { _ -> next(sources, syntax, scope, item, name, 0) }

    state next(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, item: MachineItem, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        transition offset < item.state_count {
            true -> candidate(sources, syntax, scope, item, name, offset)
            _ -> callee(sources, syntax, scope, name)
        }
    }

    state candidate(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, item: MachineItem, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        let named: bool = SourceSet::spans_equal(sources, state_item.name.source_span, name);
        transition named {
            true -> found(ValueBinding::State { handle: item.first_state + offset })
            _ -> next(sources, syntax, scope, item, name, offset + 1)
        }
    }

    state callee(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding {
        Resolver::callee_name(sources, syntax, scope, name)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// A single-name callee: a machine binder of the enclosing machine, else a
// free machine.
machine Resolver::callee_name(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let binder: ValueBinding = Resolver::generic_name(sources, syntax, scope, name, true);
    transition binder {
        ValueBinding::GenericParameter { parameter } -> found(binder)
        _ -> free_machine(sources, syntax, name)
    }

    state free_machine(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> ValueBinding {
        Resolver::machine_name(sources, syntax, false, name, name)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// A generic parameter of the enclosing machine named `name`: a machine
// binder when `machine_binder` holds, else a value binder (`Count: u32`,
// `const N: u64`). Type and lifetime binders name no value.
machine Resolver::generic_name(sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, name: SourceSpan, machine_binder: bool) -> ValueBinding
crashes Trap
{
    let item: MachineItem = SyntaxTrees::machine_item(syntax, scope.machine);
    transition { _ -> next(sources, syntax, item, name, machine_binder, 0) }

    state next(sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem, name: SourceSpan, machine_binder: bool, offset: u64 in Trapping) -> ValueBinding {
        transition offset < item.generic_parameter_count {
            true -> candidate(sources, syntax, item, name, machine_binder, offset)
            _ -> found(ValueBinding::Unresolved)
        }
    }

    state candidate(sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem, name: SourceSpan, machine_binder: bool, offset: u64 in Trapping) -> ValueBinding {
        let handle: u64 in Trapping = item.first_generic_parameter + offset;
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, handle);
        let named: bool = SourceSet::spans_equal(sources, parameter.name.source_span, name);
        let admitted: bool = Resolver::binder_names(parameter.kind, machine_binder);
        transition named && admitted {
            true -> found(ValueBinding::GenericParameter { parameter: handle })
            _ -> next(sources, syntax, item, name, machine_binder, offset + 1)
        }
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// Whether a binder of `kind` names a machine (`machine_binder`) or a value.
machine Resolver::binder_names(kind: GenericParameterKind, machine_binder: bool) -> bool {
    transition kind {
        GenericParameterKind::Machine -> machine_kind(machine_binder)
        GenericParameterKind::Value -> value_kind(machine_binder)
        GenericParameterKind::Const -> value_kind(machine_binder)
        _ -> other()
    }

    state machine_kind(machine_binder: bool) {
        machine_binder
    }

    state value_kind(machine_binder: bool) {
        !machine_binder
    }

    state other() {
        false
    }
}

// A construction's data declaration.
machine Resolver::data_name(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let lookup: Lookup = Resolver::data_named(sources, syntax, name);
    transition lookup {
        Lookup::Found { handle } -> found(ValueBinding::Data { item: handle })
        Lookup::Ambiguous -> found(ValueBinding::Ambiguous)
        Lookup::Absent -> found(ValueBinding::Unresolved)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

// `Owner::name`: a case of data `Owner`, else a machine `Owner::name`.
machine Resolver::case_or_machine(sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan) -> ValueBinding
crashes Trap
{
    let owner_data: ValueBinding = Resolver::data_name(sources, syntax, owner);
    transition owner_data {
        ValueBinding::Data { item } -> cases(sources, syntax, owner, name, item)
        ValueBinding::Ambiguous -> found(ValueBinding::Ambiguous)
        _ -> owned_machine(sources, syntax, owner, name)
    }

    state cases(sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan, item: u64 in Trapping) -> ValueBinding {
        let data_item: DataItem = SyntaxTrees::data_item(syntax, item);
        transition { _ -> case_at(sources, syntax, owner, name, item, data_item, 0) }
    }

    state case_at(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        owner: SourceSpan,
        name: SourceSpan,
        item: u64 in Trapping,
        data_item: DataItem,
        offset: u64 in Trapping
    ) -> ValueBinding {
        transition offset < data_item.case_count {
            true -> case_named(sources, syntax, owner, name, item, data_item, offset)
            _ -> owned_machine(sources, syntax, owner, name)
        }
    }

    state case_named(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        owner: SourceSpan,
        name: SourceSpan,
        item: u64 in Trapping,
        data_item: DataItem,
        offset: u64 in Trapping
    ) -> ValueBinding {
        let data_case: DataCase = SyntaxTrees::data_case(syntax, data_item.first_case + offset);
        let named: bool = SourceSet::spans_equal(sources, data_case.name.source_span, name);
        transition named {
            true -> found(ValueBinding::DataCase { item: item, data_case: data_item.first_case + offset })
            _ -> case_at(sources, syntax, owner, name, item, data_item, offset + 1)
        }
    }

    state owned_machine(sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan) -> ValueBinding {
        Resolver::machine_name(sources, syntax, true, owner, name)
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}
