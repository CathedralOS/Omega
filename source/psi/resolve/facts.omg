use psi::resolution::resolution;
use psi::resolve::names;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Fact names. A machine's or state's `requires` fact names that body's
// parameters (and the machine's value binders) exactly as its statements
// do, with no locals in scope (wiki/spec/language/state_contracts.md), and
// a `where machine` contract's names its own parameters. A
// machine's `ensures` fact names the same, and `result` the value it
// returns unless an entry parameter spells `result` (same page, Returns and
// proof use). A data declaration's `where` fact names its
// fields bare, then its value binders, and a case's own `where` fact names
// that case's payload fields before them; another case's payload is not in
// scope (wiki/spec/language/data_and_literals.md#case-constraints). A path
// in either names a case or an owned machine. A fact's callee is a machine or a
// proposition, and a proposition applies only as a whole fact,
// `requires P(x)`; inside a larger fact (`P(x) && x > 0`) it rejects as
// unsupported (wiki/language_guide/chapter_10_compile_time_proofs.md). A
// domain's `requires` predicates name its subject binder.
public machine Resolver::bind_fact_names(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_machine(resolver, sources, syntax, 0) }

    machine next_machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count && resolver.output.accepted {
            true -> machine(resolver, sources, syntax, index)
            _ -> next_data(resolver, sources, syntax, 0)
        }
    }

    machine machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let scope: NameScope = Resolver::fact_scope(true, index, item.first_parameter, item.parameter_count, false);
        Resolver::bind_clause_facts(resolver, sources, syntax, scope, item.first_clause, item.clause_count, ClauseKind::Requires);
        let returning: NameScope = Resolver::fact_scope(true, index, item.first_parameter, item.parameter_count, true);
        Resolver::bind_clause_facts(resolver, sources, syntax, returning, item.first_clause, item.clause_count, ClauseKind::Ensures);
        transition { _ -> next_contract(resolver, sources, syntax, index, item, 0) }
    }

    // A `where machine` contract's `requires` facts name its own parameters.
    machine next_contract(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        transition offset < item.contract_count && resolver.output.accepted {
            true -> contract_facts(resolver, sources, syntax, index, item, offset)
            _ -> next_state(resolver, sources, syntax, index, item, 0)
        }
    }

    machine contract_facts(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        let written: Contract = SyntaxTrees::contract(syntax, item.first_contract + offset);
        let scope: NameScope = Resolver::fact_scope(true, index, written.first_parameter, written.parameter_count, false);
        Resolver::bind_clause_facts(resolver, sources, syntax, scope, written.first_clause, written.clause_count, ClauseKind::Requires);
        transition { _ -> next_contract(resolver, sources, syntax, index, item, offset + 1) }
    }

    machine next_state(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        transition offset < item.state_count && resolver.output.accepted {
            true -> state_facts(resolver, sources, syntax, index, item, offset)
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    machine state_facts(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        let state_item: StateItem = SyntaxTrees::state_item(syntax, item.first_state + offset);
        let scope: NameScope = Resolver::fact_scope(true, index, state_item.first_parameter, state_item.parameter_count, false);
        Resolver::bind_clause_facts(resolver, sources, syntax, scope, state_item.first_clause, state_item.clause_count, ClauseKind::Requires);
        transition { _ -> next_state(resolver, sources, syntax, index, item, offset + 1) }
    }

    machine next_data(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.data_count && resolver.output.accepted {
            true -> data(resolver, sources, syntax, index)
            _ -> next_domain(resolver, sources, syntax, 0)
        }
    }

    // A domain's predicates name its subject binder
    // (wiki/spec/language/domains.md#declaration-and-membership).
    machine next_domain(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.domain_count && resolver.output.accepted {
            true -> domain(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    machine domain(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: DomainItem = SyntaxTrees::domain_item(syntax, index);
        let scope: NameScope = Resolver::subject_scope(index);
        Resolver::bind_clause_facts(resolver, sources, syntax, scope, item.first_clause, item.clause_count, ClauseKind::Requires);
        transition { _ -> next_domain(resolver, sources, syntax, index + 1) }
    }

    machine data(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: DataItem = SyntaxTrees::data_item(syntax, index);
        Resolver::bind_data_facts(resolver, sources, syntax, item, item.first_clause, item.clause_count, 0, 0);
        transition { _ -> next_case(resolver, sources, syntax, index, item, 0) }
    }

    machine next_case(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.case_count && resolver.output.accepted {
            true -> case_facts(resolver, sources, syntax, index, item, offset)
            _ -> next_data(resolver, sources, syntax, index + 1)
        }
    }

    machine case_facts(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let declared: DataCase = SyntaxTrees::data_case(syntax, item.first_case + offset);
        Resolver::bind_data_facts(
            resolver,
            sources,
            syntax,
            item,
            declared.first_clause,
            declared.clause_count,
            declared.first_payload_field,
            declared.payload_field_count
        );
        transition { _ -> next_case(resolver, sources, syntax, index, item, offset + 1) }
    }

    machine done() {}
}

// A body's parameters with no statements visible, and in an `ensures`
// fact its returned value; a data fact has no enclosing machine.
machine Resolver::fact_scope(
    has_machine: bool,
    machine: u64 in Trapping,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping,
    names_result: bool
) -> NameScope {
    NameScope {
        has_machine: has_machine,
        machine: machine,
        first_parameter: first_parameter,
        parameter_count: parameter_count,
        first_statement: 0,
        visible_statement_end: 0,
        first_binder: 0,
        binder_count: 0,
        names_result: names_result,
        in_fact: false,
        fact_root: 0,
        names_subject: false,
        subject_domain: 0
    }
}

// Domain `domain`'s predicates: its subject binder and no machine.
machine Resolver::subject_scope(domain: u64 in Trapping) -> NameScope {
    NameScope {
        has_machine: false,
        machine: 0,
        first_parameter: 0,
        parameter_count: 0,
        first_statement: 0,
        visible_statement_end: 0,
        first_binder: 0,
        binder_count: 0,
        names_result: false,
        in_fact: false,
        fact_root: 0,
        names_subject: true,
        subject_domain: domain
    }
}

// `scope` within the fact rooted at `root`, where a proposition may apply.
machine Resolver::within_fact(scope: NameScope, root: u64 in Trapping) -> NameScope {
    NameScope {
        has_machine: scope.has_machine,
        machine: scope.machine,
        first_parameter: scope.first_parameter,
        parameter_count: scope.parameter_count,
        first_statement: scope.first_statement,
        visible_statement_end: scope.visible_statement_end,
        first_binder: scope.first_binder,
        binder_count: scope.binder_count,
        names_result: scope.names_result,
        in_fact: true,
        fact_root: root,
        names_subject: scope.names_subject,
        subject_domain: scope.subject_domain
    }
}

// The facts of `kind` in a clause run, in `scope`.
machine Resolver::bind_clause_facts(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    scope: NameScope,
    first_clause: u64 in Trapping,
    clause_count: u64 in Trapping,
    kind: ClauseKind
)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, scope, first_clause, first_clause + clause_count, kind) }

    machine next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, index: u64 in Trapping, end: u64 in Trapping, kind: ClauseKind) {
        transition index < end && resolver.output.accepted {
            true -> clause(resolver, sources, syntax, scope, index, end, kind)
            _ -> done()
        }
    }

    machine clause(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, index: u64 in Trapping, end: u64 in Trapping, kind: ClauseKind) {
        let clause: Clause = SyntaxTrees::clause(syntax, index);
        transition clause.kind == kind && clause.has_expression {
            true -> fact(resolver, sources, syntax, scope, index, end, kind, clause.expression)
            _ -> next(resolver, sources, syntax, scope, index + 1, end, kind)
        }
    }

    machine fact(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, scope: NameScope, index: u64 in Trapping, end: u64 in Trapping, kind: ClauseKind, root: u64 in Trapping) {
        let within: NameScope = Resolver::within_fact(scope, root);
        Resolver::bind_tree(resolver, sources, syntax, within, root);
        transition { _ -> next(resolver, sources, syntax, scope, index + 1, end, kind) }
    }

    machine done() {}
}

// A case's payload fields, which its own `where` facts name before the
// declaration's fields; none for the declaration's own facts.
data FactPayload [copy] {
    first: u64 in Trapping;
    count: u64 in Trapping;
}

// The `where` facts in a data declaration's clause run: its own, or with
// `payload_count` payload fields from `first_payload`, one case's.
machine Resolver::bind_data_facts(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    item: DataItem,
    first_clause: u64 in Trapping,
    clause_count: u64 in Trapping,
    first_payload: u64 in Trapping,
    payload_count: u64 in Trapping
)
crashes Trap
{
    let payload: FactPayload = FactPayload { first: first_payload, count: payload_count };
    transition { _ -> next(resolver, sources, syntax, item, payload, first_clause, first_clause + clause_count) }

    machine next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, payload: FactPayload, index: u64 in Trapping, end: u64 in Trapping) {
        transition index < end && resolver.output.accepted {
            true -> clause(resolver, sources, syntax, item, payload, index, end)
            _ -> done()
        }
    }

    machine clause(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, payload: FactPayload, index: u64 in Trapping, end: u64 in Trapping) {
        let clause: Clause = SyntaxTrees::clause(syntax, index);
        transition clause.kind == ClauseKind::Where && clause.has_expression {
            true -> fact(resolver, sources, syntax, item, payload, index, end, clause.expression)
            _ -> next(resolver, sources, syntax, item, payload, index + 1, end)
        }
    }

    machine fact(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, payload: FactPayload, index: u64 in Trapping, end: u64 in Trapping, root: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(syntax, root);
        transition { _ -> node(resolver, sources, syntax, item, payload, index, end, root, expression.first_row) }
    }

    machine node(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        item: DataItem,
        payload: FactPayload,
        index: u64 in Trapping,
        end: u64 in Trapping,
        root: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        transition handle <= root && resolver.output.accepted {
            true -> named(resolver, sources, syntax, item, payload, index, end, root, handle)
            _ -> next(resolver, sources, syntax, item, payload, index + 1, end)
        }
    }

    machine named(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        item: DataItem,
        payload: FactPayload,
        index: u64 in Trapping,
        end: u64 in Trapping,
        root: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        let expression: Expression = SyntaxTrees::expression(syntax, handle);
        Resolver::bind_data_name(resolver, sources, syntax, item, payload, root, handle, expression);
        transition { _ -> node(resolver, sources, syntax, item, payload, index, end, root, handle + 1) }
    }

    machine done() {}
}

// One name of the data fact rooted at `root`: a value name binds one of the
// case's payload fields, then a field of the declaration, then its value
// binders; a callee a machine or a
// proposition, which applies only as the whole fact; a path as anywhere
// else.
machine Resolver::bind_data_name(
    resolver: &mut Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    item: DataItem,
    payload: FactPayload,
    root: u64 in Trapping,
    handle: u64 in Trapping,
    expression: Expression
)
crashes Trap
{
    let role: NameRole = Resolver::role(resolver, handle);
    transition expression.kind {
        ExpressionKind::Name -> single(resolver, sources, syntax, item, payload, root, handle, expression, role)
        ExpressionKind::Path -> path(resolver, sources, syntax, root, handle, expression, role)
        _ -> done()
    }

    machine single(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, payload: FactPayload, root: u64 in Trapping, handle: u64 in Trapping, expression: Expression, role: NameRole) {
        transition role {
            NameRole::Value -> value(resolver, sources, syntax, item, payload, root, handle, expression)
            NameRole::Callee -> callee(resolver, sources, syntax, root, handle, expression)
            _ -> bound(resolver, syntax, root, handle, expression, ValueBinding::Unresolved)
        }
    }

    machine value(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, payload: FactPayload, root: u64 in Trapping, handle: u64 in Trapping, expression: Expression) {
        let binding: ValueBinding = Resolver::data_value_name(sources, syntax, item, payload, expression.name.source_span);
        transition { _ -> bound(resolver, syntax, root, handle, expression, binding) }
    }

    machine callee(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, root: u64 in Trapping, handle: u64 in Trapping, expression: Expression) {
        let binding: ValueBinding = Resolver::free_callee(&resolver.output, sources, syntax, expression.name.source_span);
        transition { _ -> bound(resolver, syntax, root, handle, expression, binding) }
    }

    machine path(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, root: u64 in Trapping, handle: u64 in Trapping, expression: Expression, role: NameRole) {
        let scope: NameScope = Resolver::fact_scope(false, 0, 0, 0, false);
        let binding: ValueBinding = Resolver::name_binding(&resolver.output, sources, syntax, scope, expression, role);
        transition { _ -> bound(resolver, syntax, root, handle, expression, binding) }
    }

    machine bound(resolver: &mut Resolver, syntax: &SyntaxTrees, root: u64 in Trapping, handle: u64 in Trapping, expression: Expression, binding: ValueBinding) {
        transition binding {
            ValueBinding::Unresolved -> unresolved(resolver, expression)
            ValueBinding::Ambiguous -> ambiguous(resolver, expression)
            ValueBinding::Proposition { proposition } -> applied(resolver, syntax, root, handle, expression, binding)
            _ -> stored(resolver, handle, binding)
        }
    }

    machine applied(resolver: &mut Resolver, syntax: &SyntaxTrees, root: u64 in Trapping, handle: u64 in Trapping, expression: Expression, binding: ValueBinding) {
        let code: ResolveDiagnosticCode = Resolver::proposition_site(syntax, true, root, handle);
        transition code == ResolveDiagnosticCode::None {
            true -> stored(resolver, handle, binding)
            _ -> misplaced(resolver, code, expression)
        }
    }

    machine stored(resolver: &mut Resolver, handle: u64 in Trapping, binding: ValueBinding) {
        transition handle < 131072 {
            true -> store(resolver, handle, binding)
            _ -> invalid()
        }
    }

    machine store(resolver: &mut Resolver, handle: u64 in Trapping, binding: ValueBinding)
    requires handle < 131072
    {
        resolver.output.value_bindings[handle] = binding;
    }

    machine unresolved(resolver: &mut Resolver, expression: Expression) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnknownName, expression.source_span);
    }

    machine ambiguous(resolver: &mut Resolver, expression: Expression) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::AmbiguousName, expression.source_span);
    }

    machine misplaced(resolver: &mut Resolver, code: ResolveDiagnosticCode, expression: Expression) {
        NameResolution::reject(&mut resolver.output, code, expression.source_span);
    }

    machine invalid() {
        crash Trap;
    }

    machine done() {}
}

// A bare value name in a data fact: one of the case's payload fields, then
// one of the declaration's own fields, then one of its value binders.
machine Resolver::data_value_name(sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, payload: FactPayload, name: SourceSpan) -> ValueBinding
crashes Trap
{
    transition { _ -> payload_field(sources, syntax, item, payload, name, 0) }

    machine payload_field(sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, payload: FactPayload, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        transition offset < payload.count {
            true -> payload_named(sources, syntax, item, payload, name, offset)
            _ -> field(sources, syntax, item, name, 0)
        }
    }

    machine payload_named(sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, payload: FactPayload, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        let field: DataField = SyntaxTrees::payload_field(syntax, payload.first + offset);
        let spelled: bool = SourceSet::spans_equal(sources, field.name.source_span, name);
        transition spelled {
            true -> found(ValueBinding::PayloadField { field: payload.first + offset })
            _ -> payload_field(sources, syntax, item, payload, name, offset + 1)
        }
    }

    machine field(sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        transition offset < item.field_count {
            true -> field_named(sources, syntax, item, name, offset)
            _ -> binder(sources, syntax, item, name, 0)
        }
    }

    machine field_named(sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        let field: DataField = SyntaxTrees::field(syntax, item.first_field + offset);
        let spelled: bool = SourceSet::spans_equal(sources, field.name.source_span, name);
        transition spelled {
            true -> found(ValueBinding::Field { field: item.first_field + offset })
            _ -> field(sources, syntax, item, name, offset + 1)
        }
    }

    machine binder(sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        transition offset < item.generic_parameter_count {
            true -> binder_named(sources, syntax, item, name, offset)
            _ -> found(ValueBinding::Unresolved)
        }
    }

    machine binder_named(sources: &SourceSet, syntax: &SyntaxTrees, item: DataItem, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        let handle: u64 in Trapping = item.first_generic_parameter + offset;
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, handle);
        let spelled: bool = SourceSet::spans_equal(sources, parameter.name.source_span, name);
        let value: bool = Resolver::binder_names(parameter.kind, false);
        transition spelled && value {
            true -> found(ValueBinding::GenericParameter { parameter: handle })
            _ -> binder(sources, syntax, item, name, offset + 1)
        }
    }

    machine found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}
