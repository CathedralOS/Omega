use psi::resolution::resolution;
use psi::resolve::imports;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Trait and conformance members (wiki/spec/language/conformances.md). Inside
// a trait `machine` declares a requirement (bodyless) or its default; inside
// a named conformance it declares the satisfier of the block's corresponding
// requirement. Each is a machine like any other, named through its
// container: `Trait::requirement`, `Conformance::member`. The container's
// generic parameters cover the member's signature and body, and the member's
// own shadow them. Reference rows `Trait::requirement = Path;` bind one
// requirement to an existing machine. Which requirement a member or row
// fills, and whether every row is filled once, is checking's question.

// Every machine's `MachineOwner`, in machine order: a root machine keeps its
// authored owner; a member takes its container's name. Containers cover
// contiguous machine ranges, so one pass per container table places them.
pub machine Resolver::place_machines(resolver: &mut Resolver, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> root(resolver, syntax, 0) }

    state root(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> root_owner(resolver, syntax, index)
            _ -> traits(resolver, syntax, 0)
        }
    }

    state root_owner(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        Resolver::set_machine_owner(resolver, index, MachineOwner {
            container: item.container,
            item: 0,
            has_owner: item.has_owner,
            owner: item.owner
        });
        transition { _ -> root(resolver, syntax, index + 1) }
    }

    state traits(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.trait_count {
            true -> trait_members(resolver, syntax, index)
            _ -> conformances(resolver, syntax, 0)
        }
    }

    state trait_members(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: TraitItem = SyntaxTrees::trait_item(syntax, index);
        let container: MachineContainer = Resolver::trait_container(item.is_refinement);
        let owner: MachineOwner = MachineOwner {
            container: container,
            item: index,
            has_owner: true,
            owner: item.name
        };
        Resolver::place_members(resolver, item.first_machine, item.machine_count, owner);
        transition { _ -> traits(resolver, syntax, index + 1) }
    }

    state conformances(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.conformance_count {
            true -> conformance_members(resolver, syntax, index)
            _ -> done(resolver, syntax)
        }
    }

    state conformance_members(resolver: &mut Resolver, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: ConformanceItem = SyntaxTrees::conformance_item(syntax, index);
        let owner: MachineOwner = MachineOwner {
            container: MachineContainer::Conformance,
            item: index,
            has_owner: true,
            owner: item.name
        };
        Resolver::place_members(resolver, item.first_machine, item.machine_count, owner);
        transition { _ -> conformances(resolver, syntax, index + 1) }
    }

    state done(resolver: &mut Resolver, syntax: &SyntaxTrees) {
        resolver.output.machine_owner_count = syntax.machine_count;
    }
}

// A trait's members are requirements and defaults; a transparent
// refinement's members only refine its base's requirements.
machine Resolver::trait_container(is_refinement: bool) -> MachineContainer {
    transition is_refinement {
        true -> found(MachineContainer::Refinement)
        _ -> found(MachineContainer::Trait)
    }

    state found(container: MachineContainer) -> MachineContainer {
        container
    }
}

machine Resolver::place_members(resolver: &mut Resolver, first: u64 in Trapping, count: u64 in Trapping, owner: MachineOwner)
crashes Trap
{
    transition { _ -> next(resolver, first, count, owner, 0) }

    state next(resolver: &mut Resolver, first: u64 in Trapping, count: u64 in Trapping, owner: MachineOwner, offset: u64 in Trapping) {
        transition offset < count {
            true -> place(resolver, first, count, owner, offset)
            _ -> done()
        }
    }

    state place(resolver: &mut Resolver, first: u64 in Trapping, count: u64 in Trapping, owner: MachineOwner, offset: u64 in Trapping) {
        Resolver::set_machine_owner(resolver, first + offset, owner);
        transition { _ -> next(resolver, first, count, owner, offset + 1) }
    }

    state done() {}
}

machine Resolver::set_machine_owner(resolver: &mut Resolver, handle: u64 in Trapping, owner: MachineOwner)
crashes Trap
{
    transition handle < 2048 {
        true -> store(resolver, handle, owner)
        _ -> invalid()
    }

    state store(resolver: &mut Resolver, handle: u64 in Trapping, owner: MachineOwner) {
        resolver.output.machine_owners[handle] = owner;
    }

    state invalid() {
        crash Trap;
    }
}

// A machine's type scope: its own generic parameters, then its container's.
pub machine Resolver::machine_scope(resolution: &NameResolution, syntax: &SyntaxTrees, handle: u64 in Trapping) -> TypeScope
crashes Trap
{
    let item: MachineItem = SyntaxTrees::machine_item(syntax, handle);
    let owner: MachineOwner = NameResolution::machine_owner(resolution, handle);
    let outer: TypeScope = Resolver::container_scope(syntax, owner);
    TypeScope {
        first_generic_parameter: item.first_generic_parameter,
        generic_parameter_count: item.generic_parameter_count,
        first_outer_parameter: outer.first_generic_parameter,
        outer_parameter_count: outer.generic_parameter_count
    }
}

// A container's own generic parameters as a scope; a root machine has none.
pub machine Resolver::container_scope(syntax: &SyntaxTrees, owner: MachineOwner) -> TypeScope
crashes Trap
{
    transition owner.container {
        MachineContainer::Root -> none()
        MachineContainer::Measure -> none()
        MachineContainer::Trait -> trait_scope(syntax, owner.item)
        MachineContainer::Conformance -> conformance_scope(syntax, owner.item)
        MachineContainer::Refinement -> trait_scope(syntax, owner.item)
    }

    state none() -> TypeScope {
        Resolver::empty_scope()
    }

    state trait_scope(syntax: &SyntaxTrees, index: u64 in Trapping) -> TypeScope {
        let item: TraitItem = SyntaxTrees::trait_item(syntax, index);
        Resolver::scope(item.first_generic_parameter, item.generic_parameter_count)
    }

    state conformance_scope(syntax: &SyntaxTrees, index: u64 in Trapping) -> TypeScope {
        let item: ConformanceItem = SyntaxTrees::conformance_item(syntax, index);
        Resolver::scope(item.first_generic_parameter, item.generic_parameter_count)
    }
}

// Reference rows `Trait::requirement = Path;`. The left side names a trait
// requirement: `Trait::requirement`, or a bare requirement of the satisfied
// trait. The right side names an existing machine as a callee would. Both
// bindings land in `NameResolution::path_bindings`.
pub machine Resolver::bind_conformance_rows(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next_conformance(resolver, sources, syntax, 0) }

    state next_conformance(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.conformance_count && resolver.output.accepted {
            true -> rows(resolver, sources, syntax, index, 0)
            _ -> done()
        }
    }

    state rows(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) {
        let item: ConformanceItem = SyntaxTrees::conformance_item(syntax, index);
        transition offset < item.row_count && resolver.output.accepted {
            true -> row(resolver, sources, syntax, index, offset, item.first_row + offset)
            _ -> next_conformance(resolver, sources, syntax, index + 1)
        }
    }

    state row(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, row_handle: u64 in Trapping) {
        let conformance_row: ConformanceRow = SyntaxTrees::conformance_row(syntax, row_handle);
        let requirement: PathBinding = Resolver::requirement_path(&resolver.output, sources, syntax, index, conformance_row.requirement);
        transition requirement {
            PathBinding::Machine { handle } -> requirement_found(resolver, sources, syntax, index, offset, conformance_row, handle)
            _ -> unknown(resolver, syntax, conformance_row.requirement)
        }
    }

    state requirement_found(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        offset: u64 in Trapping,
        conformance_row: ConformanceRow,
        requirement: u64 in Trapping
    ) {
        let owner: MachineOwner = NameResolution::machine_owner(&resolver.output, requirement);
        transition owner.container == MachineContainer::Trait {
            true -> requirement_bound(resolver, sources, syntax, index, offset, conformance_row, requirement)
            _ -> not_requirement(resolver, syntax, conformance_row.requirement)
        }
    }

    state requirement_bound(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        offset: u64 in Trapping,
        conformance_row: ConformanceRow,
        requirement: u64 in Trapping
    ) {
        Resolver::set_path_binding(resolver, conformance_row.requirement, PathBinding::Machine { handle: requirement });
        Resolver::bind_machine_path(resolver, sources, syntax, conformance_row.target);
        transition { _ -> rows(resolver, sources, syntax, index, offset + 1) }
    }

    state unknown(resolver: &mut Resolver, syntax: &SyntaxTrees, path: u64 in Trapping) {
        let name_path: NamePath = SyntaxTrees::name_path(syntax, path);
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnknownName, name_path.source_span);
    }

    state not_requirement(resolver: &mut Resolver, syntax: &SyntaxTrees, path: u64 in Trapping) {
        let name_path: NamePath = SyntaxTrees::name_path(syntax, path);
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::NotARequirement, name_path.source_span);
    }

    state done() {}
}

// A reference row's requirement path: `Owner::name` as a machine path, or a
// bare name among the satisfied trait's members. An ambiguous path stays
// unresolved here and rejects as unknown at the row.
machine Resolver::requirement_path(
    resolution: &NameResolution,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    conformance: u64 in Trapping,
    path: u64 in Trapping
) -> PathBinding
crashes Trap
{
    let name_path: NamePath = SyntaxTrees::name_path(syntax, path);
    transition name_path.member_count == 1 {
        true -> bare(resolution, sources, syntax, conformance, name_path)
        _ -> qualified(resolution, sources, syntax, name_path)
    }

    state bare(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, conformance: u64 in Trapping, name_path: NamePath) -> PathBinding {
        let declared: ConformanceItem = SyntaxTrees::conformance_item(syntax, conformance);
        let name: IdentifierSpan = SyntaxTrees::member(syntax, name_path.first_member);
        let binding: TypeBinding = NameResolution::type_binding_at(resolution, declared.trait_type);
        transition binding {
            TypeBinding::Trait { item } -> member(syntax, sources, item, name)
            _ -> unresolved()
        }
    }

    state member(syntax: &SyntaxTrees, sources: &SourceSet, trait_index: u64 in Trapping, name: IdentifierSpan) -> PathBinding {
        let found: Lookup = Resolver::trait_member_named(sources, syntax, trait_index, name.source_span);
        transition found {
            Lookup::Found { handle } -> machine_found(handle)
            _ -> unresolved()
        }
    }

    state qualified(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, name_path: NamePath) -> PathBinding {
        Resolver::machine_path_binding(resolution, sources, syntax, name_path)
    }

    state machine_found(handle: u64 in Trapping) -> PathBinding {
        PathBinding::Machine { handle: handle }
    }

    state unresolved() -> PathBinding {
        PathBinding::Unresolved
    }
}

// Bind name path `path` to the machine it names as a callee would, or
// reject it as unknown or ambiguous at its span.
pub machine Resolver::bind_machine_path(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, path: u64 in Trapping)
crashes Trap
{
    let name_path: NamePath = SyntaxTrees::name_path(syntax, path);
    let lookup: Lookup = Resolver::machine_path_lookup(&resolver.output, sources, syntax, name_path);
    transition lookup {
        Lookup::Found { handle } -> bound(resolver, path, handle)
        Lookup::Ambiguous -> ambiguous(resolver, name_path)
        Lookup::Absent -> unknown(resolver, name_path)
    }

    state bound(resolver: &mut Resolver, path: u64 in Trapping, handle: u64 in Trapping) {
        Resolver::set_path_binding(resolver, path, PathBinding::Machine { handle: handle });
    }

    state ambiguous(resolver: &mut Resolver, name_path: NamePath) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::AmbiguousName, name_path.source_span);
    }

    state unknown(resolver: &mut Resolver, name_path: NamePath) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::UnknownName, name_path.source_span);
    }
}

// The machine a name path names: a free machine for one member, an owned
// machine (a trait requirement or conformance member included) for two. A
// longer path crosses a package, which this source set cannot bind.
pub machine Resolver::machine_path_lookup(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, name_path: NamePath) -> Lookup
crashes Trap
{
    transition name_path.member_count {
        1 -> free(resolution, sources, syntax, name_path)
        2 -> owned(resolution, sources, syntax, name_path)
        _ -> absent()
    }

    state free(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, name_path: NamePath) -> Lookup {
        let name: IdentifierSpan = SyntaxTrees::member(syntax, name_path.first_member);
        Resolver::machine_named(resolution, sources, syntax, false, name.source_span, name.source_span)
    }

    state owned(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, name_path: NamePath) -> Lookup {
        let owner: IdentifierSpan = SyntaxTrees::member(syntax, name_path.first_member);
        let name: IdentifierSpan = SyntaxTrees::member(syntax, name_path.first_member + 1);
        Resolver::machine_named(resolution, sources, syntax, true, owner.source_span, name.source_span)
    }

    state absent() -> Lookup {
        Lookup::Absent
    }
}

machine Resolver::machine_path_binding(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, name_path: NamePath) -> PathBinding
crashes Trap
{
    let lookup: Lookup = Resolver::machine_path_lookup(resolution, sources, syntax, name_path);
    transition lookup {
        Lookup::Found { handle } -> machine_found(handle)
        _ -> unresolved()
    }

    state machine_found(handle: u64 in Trapping) -> PathBinding {
        PathBinding::Machine { handle: handle }
    }

    state unresolved() -> PathBinding {
        PathBinding::Unresolved
    }
}

// The first member of trait `trait_index` named `name`: its overload
// family's representative.
pub machine Resolver::trait_member_named(sources: &SourceSet, syntax: &SyntaxTrees, trait_index: u64 in Trapping, name: SourceSpan) -> Lookup
crashes Trap
{
    let item: TraitItem = SyntaxTrees::trait_item(syntax, trait_index);
    transition { _ -> next(sources, syntax, item, name, 0) }

    state next(sources: &SourceSet, syntax: &SyntaxTrees, item: TraitItem, name: SourceSpan, offset: u64 in Trapping) -> Lookup {
        transition offset < item.machine_count {
            true -> candidate(sources, syntax, item, name, offset)
            _ -> absent()
        }
    }

    state candidate(sources: &SourceSet, syntax: &SyntaxTrees, item: TraitItem, name: SourceSpan, offset: u64 in Trapping) -> Lookup {
        let member: MachineItem = SyntaxTrees::machine_item(syntax, item.first_machine + offset);
        let named: bool = SourceSet::spans_equal(sources, member.name.source_span, name);
        transition named {
            true -> found(item.first_machine + offset)
            _ -> next(sources, syntax, item, name, offset + 1)
        }
    }

    state found(handle: u64 in Trapping) -> Lookup {
        Lookup::Found { handle: handle }
    }

    state absent() -> Lookup {
        Lookup::Absent
    }
}

// `Conformance::name` when the block declares no member `name`: the machine
// its reference row for that requirement names, else the satisfied trait's
// requirement or default of that name. Calling it selects the conformance's
// row for the requirement (wiki/spec/language/conformances.md#complete-row-identity).
pub machine Resolver::conformance_row_named(
    resolution: &NameResolution,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    owner: SourceSpan,
    name: SourceSpan
) -> ValueBinding
crashes Trap
{
    let conformance: Lookup = Resolver::declared_named(sources, syntax, DeclarationKind::Conformance, false, owner, owner);
    transition conformance {
        Lookup::Found { handle } -> rows(resolution, sources, syntax, handle, name, 0)
        Lookup::Ambiguous -> found(ValueBinding::Ambiguous)
        Lookup::Absent -> found(ValueBinding::Unresolved)
    }

    state rows(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, conformance: u64 in Trapping, name: SourceSpan, offset: u64 in Trapping) -> ValueBinding {
        let item: ConformanceItem = SyntaxTrees::conformance_item(syntax, conformance);
        transition offset < item.row_count {
            true -> row(resolution, sources, syntax, conformance, name, offset, item.first_row + offset)
            _ -> trait_requirement(resolution, sources, syntax, item, name)
        }
    }

    state row(
        resolution: &NameResolution,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        conformance: u64 in Trapping,
        name: SourceSpan,
        offset: u64 in Trapping,
        handle: u64 in Trapping
    ) -> ValueBinding {
        let conformance_row: ConformanceRow = SyntaxTrees::conformance_row(syntax, handle);
        let requirement: NamePath = SyntaxTrees::name_path(syntax, conformance_row.requirement);
        let last: IdentifierSpan = SyntaxTrees::member(syntax, requirement.first_member + requirement.member_count - 1);
        let named: bool = SourceSet::spans_equal(sources, last.source_span, name);
        transition named {
            true -> row_target(resolution, conformance_row.target)
            _ -> rows(resolution, sources, syntax, conformance, name, offset + 1)
        }
    }

    state row_target(resolution: &NameResolution, path: u64 in Trapping) -> ValueBinding {
        let target: PathBinding = NameResolution::path_binding_at(resolution, path);
        transition target {
            PathBinding::Machine { handle } -> found(ValueBinding::Machine { handle: handle })
            _ -> found(ValueBinding::Unresolved)
        }
    }

    state trait_requirement(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, declared: ConformanceItem, name: SourceSpan) -> ValueBinding {
        let binding: TypeBinding = NameResolution::type_binding_at(resolution, declared.trait_type);
        transition binding {
            TypeBinding::Trait { item } -> requirement(sources, syntax, item, name)
            _ -> found(ValueBinding::Unresolved)
        }
    }

    state requirement(sources: &SourceSet, syntax: &SyntaxTrees, trait_index: u64 in Trapping, name: SourceSpan) -> ValueBinding {
        let member: Lookup = Resolver::trait_member_named(sources, syntax, trait_index, name);
        transition member {
            Lookup::Found { handle } -> found(ValueBinding::Machine { handle: handle })
            _ -> found(ValueBinding::Unresolved)
        }
    }

    state found(binding: ValueBinding) -> ValueBinding {
        binding
    }
}

pub machine Resolver::set_path_binding(resolver: &mut Resolver, path: u64 in Trapping, binding: PathBinding)
crashes Trap
{
    transition path < 2048 {
        true -> store(resolver, path, binding)
        _ -> invalid()
    }

    state store(resolver: &mut Resolver, path: u64 in Trapping, binding: PathBinding) {
        resolver.output.path_bindings[path] = binding;
    }

    state invalid() {
        crash Trap;
    }
}
