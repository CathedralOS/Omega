use psi::resolution::resolution;
use psi::resolve::containers;
use psi::resolve::forms;
use psi::resolve::imports;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Operator homes (wiki/spec/language/expressions.md#operator-families). A
// qualified token-bound machine `machine <= Nat::less_or_equal(...)`
// establishes its semantic home through its owner: the data declaration
// `Nat`. Direct families are closed, so only the home's own package may
// publish its token bindings: an owner naming a builtin carrier, a trait or
// another package's data rejects at the owner. Two machines binding one
// token at one home with the same parameters are duplicate participating
// shapes and reject at the later one. Typing selects among a home's machines
// by their operands (typing/operators.omg).
public machine Resolver::bind_operator_homes(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0) }

    machine next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count && resolver.output.accepted {
            true -> machine(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    machine machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        Resolver::set_operator_home(resolver, index, TypeBinding::Unresolved);
        transition item.operator == OperatorToken::None {
            true -> next(resolver, sources, syntax, index + 1)
            _ -> owner(resolver, sources, syntax, index, item)
        }
    }

    machine owner(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, entry: MachineItem) {
        let scope: TypeScope = Resolver::machine_scope(&resolver.output, syntax, index);
        let binding: TypeBinding = Resolver::type_binding(sources, syntax, scope, entry.owner.source_span);
        transition binding {
            TypeBinding::Data { item } -> data_home(resolver, sources, syntax, index, entry, item)
            _ -> foreign(resolver, entry)
        }
    }

    machine data_home(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, entry: MachineItem, data: u64 in Trapping) {
        let declared: DataItem = SyntaxTrees::data_item(syntax, data);
        let machine_unit: u64 in Trapping = entry.name.source_span.source.value as u64 in Trapping;
        let data_unit: u64 in Trapping = declared.name.source_span.source.value as u64 in Trapping;
        let own: bool = Resolver::same_package(sources, machine_unit, data_unit);
        transition own {
            true -> homed(resolver, sources, syntax, index, entry, data)
            _ -> foreign(resolver, entry)
        }
    }

    machine homed(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, entry: MachineItem, data: u64 in Trapping) {
        Resolver::set_operator_home(resolver, index, TypeBinding::Data { item: data });
        let duplicate: bool = Resolver::earlier_operator_shape(resolver, sources, syntax, index, entry.operator, data);
        transition duplicate {
            true -> repeated(resolver, entry)
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine foreign(resolver: &mut Resolver, entry: MachineItem) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::ForeignOperatorHome, entry.owner.source_span);
    }

    machine repeated(resolver: &mut Resolver, entry: MachineItem) {
        NameResolution::reject(&mut resolver.output, ResolveDiagnosticCode::DuplicateMachine, entry.name.source_span);
    }

    machine done() {}
}

// Whether a machine before `handle` binds `token` at home `data` with the
// same parameters.
machine Resolver::earlier_operator_shape(
    resolver: &Resolver,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    handle: u64 in Trapping,
    token: OperatorToken,
    data: u64 in Trapping
) -> bool
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, handle, token, data, 0) }

    machine next(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, handle: u64 in Trapping, token: OperatorToken, data: u64 in Trapping, earlier: u64 in Trapping) -> bool {
        transition earlier < handle {
            true -> candidate(resolver, sources, syntax, handle, token, data, earlier)
            _ -> unique()
        }
    }

    machine candidate(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, handle: u64 in Trapping, token: OperatorToken, data: u64 in Trapping, earlier: u64 in Trapping) -> bool {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, earlier);
        let home: TypeBinding = NameResolution::operator_home(&resolver.output, earlier);
        let same_home: bool = Resolver::homed_at(home, data);
        transition item.operator == token && same_home {
            true -> shape(resolver, sources, syntax, handle, token, data, earlier)
            _ -> next(resolver, sources, syntax, handle, token, data, earlier + 1)
        }
    }

    machine shape(resolver: &Resolver, sources: &SourceSet, syntax: &SyntaxTrees, handle: u64 in Trapping, token: OperatorToken, data: u64 in Trapping, earlier: u64 in Trapping) -> bool {
        let same: bool = Resolver::same_parameters(resolver, sources, syntax, earlier, handle);
        transition same {
            true -> repeated()
            _ -> next(resolver, sources, syntax, handle, token, data, earlier + 1)
        }
    }

    machine repeated() -> bool {
        true
    }

    machine unique() -> bool {
        false
    }
}

// Whether an operator home is data declaration `data`.
public machine Resolver::homed_at(home: TypeBinding, data: u64 in Trapping) -> bool {
    transition home {
        TypeBinding::Data { item } -> data_item(item, data)
        _ -> elsewhere()
    }

    machine data_item(item: u64 in Trapping, data: u64 in Trapping) -> bool {
        item == data
    }

    machine elsewhere() -> bool {
        false
    }
}

machine Resolver::set_operator_home(resolver: &mut Resolver, handle: u64 in Trapping, home: TypeBinding)
crashes Trap
{
    transition handle < 2048 {
        true -> store(resolver, handle, home)
        _ -> invalid()
    }

    machine store(resolver: &mut Resolver, handle: u64 in Trapping, home: TypeBinding)
    requires handle < 2048
    {
        resolver.output.operator_homes[handle] = home;
    }

    machine invalid() {
        crash Trap;
    }
}
