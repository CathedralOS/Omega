use psi::resolution::resolution;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Machine binder contracts (wiki/spec/language/generics.md, Static machine
// binder categories). Each `where machine Name(...)` contract of a machine
// gives the one `machine` binder of that machine spelled `Name` its
// callable signature; the clause declares the binder's contract rather
// than inferring it from calls, so a contract naming no such binder, or a
// second contract for one binder, rejects. A binder without a contract has
// none: calling it rejects in typing.
public machine Resolver::bind_machine_contracts(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> clear(resolver, sources, syntax, 0) }

    machine clear(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, parameter: u64 in Trapping) {
        transition parameter < syntax.generic_parameter_count {
            true -> cleared(resolver, sources, syntax, parameter)
            _ -> next_machine(resolver, sources, syntax, 0)
        }
    }

    machine cleared(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, parameter: u64 in Trapping) {
        NameResolution::set_binder_contract(&mut resolver.output, parameter, BinderContract { present: false, contract: 0 });
        transition { _ -> clear(resolver, sources, syntax, parameter + 1) }
    }

    machine next_machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count && resolver.output.accepted {
            true -> machine(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    machine machine(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        transition { _ -> next_contract(resolver, sources, syntax, index, item, 0) }
    }

    machine next_contract(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        transition offset < item.contract_count && resolver.output.accepted {
            true -> contract(resolver, sources, syntax, index, item, offset)
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    machine contract(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        let handle: u64 in Trapping = item.first_contract + offset;
        let written: Contract = SyntaxTrees::contract(syntax, handle);
        let binder: u64 in Trapping = Resolver::contract_binder(sources, syntax, item, written.name.source_span);
        transition binder < item.generic_parameter_count {
            true -> named(resolver, sources, syntax, index, item, offset, handle, written, item.first_generic_parameter + binder)
            _ -> reject(resolver, ResolveDiagnosticCode::ContractNamesNoBinder, written.name.source_span)
        }
    }

    machine named(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        written: Contract,
        parameter: u64 in Trapping
    ) {
        let existing: BinderContract = NameResolution::binder_contract(&resolver.output, parameter);
        transition existing.present {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateContract, written.name.source_span)
            _ -> bound(resolver, sources, syntax, index, item, offset, handle, parameter)
        }
    }

    machine bound(
        resolver: &mut Resolver,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        index: u64 in Trapping,
        item: MachineItem,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        parameter: u64 in Trapping
    ) {
        NameResolution::set_binder_contract(&mut resolver.output, parameter, BinderContract { present: true, contract: handle });
        transition { _ -> next_contract(resolver, sources, syntax, index, item, offset + 1) }
    }

    machine reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, source_span: SourceSpan) {
        NameResolution::reject(&mut resolver.output, code, source_span);
    }

    machine done() {}
}

// The offset among `item`'s generic parameters of its `machine` binder
// spelled `name`; the parameter count when none is.
machine Resolver::contract_binder(sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem, name: SourceSpan) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(sources, syntax, item, name, 0) }

    machine next(sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem, name: SourceSpan, offset: u64 in Trapping) -> u64 in Trapping {
        transition offset < item.generic_parameter_count {
            true -> candidate(sources, syntax, item, name, offset)
            _ -> found(item.generic_parameter_count)
        }
    }

    machine candidate(sources: &SourceSet, syntax: &SyntaxTrees, item: MachineItem, name: SourceSpan, offset: u64 in Trapping) -> u64 in Trapping {
        let parameter: GenericParameter = SyntaxTrees::generic_parameter(syntax, item.first_generic_parameter + offset);
        let spelled: bool = SourceSet::spans_equal(sources, parameter.name.source_span, name);
        transition spelled && parameter.kind == GenericParameterKind::Machine {
            true -> found(offset)
            _ -> next(sources, syntax, item, name, offset + 1)
        }
    }

    machine found(offset: u64 in Trapping) -> u64 in Trapping {
        offset
    }
}
