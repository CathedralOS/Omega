use psi::resolution::resolution;
use psi::resolve::resolver;
use psi::source::source;
use psi::syntax::syntax;

// Which declarations a source unit can name (wiki/spec/language/modules.md,
// wiki/spec/packages/boundaries.md). Every unit belongs to a package and to
// a module within it; a module is its package and its path together, so one
// path in two packages names two modules. A unit sees its own module's
// declarations, whichever of the module's units declares them, and the
// declarations of each module its `use` rows import; an import affects only
// the unit that writes it and is not transitive. Within one package every
// declaration is visible to an importer; across packages only a `pub` one
// is, a trait's or conformance's member taking its container's visibility.
//
// A `use` path's leading members select the package of the module it names
// (`import_target`). The language's toolchain mount `omega::language::core`
// selects the toolchain's core package from every package
// (wiki/spec/packages/toolchain.md). Otherwise a first member spelling one
// of the requester's product dependency aliases selects that dependency,
// and one spelling the requester's own name its own package; the rest of
// the path is the module's path there. Any other path is a module path of
// the requester's own package. A first member spelling another package's
// name, or one of the requester's build-scope aliases, where the
// requester's package holds no such module, is an undeclared dependency: a
// package's name grants nothing without an edge, and build edges never
// authorize product imports (wiki/spec/build/declarations.md).
//
// Visibility is computed from the syntax tables and the source set on
// demand rather than kept as resolver state: lookups test it only for a
// declaration whose spelling already matched, and a unit has few `use` rows.

// The package a `use` path selects, and how many of its leading members
// select it; the members after them spell the module's path there. `found`
// is false when the toolchain mount names no supplied toolchain package.
pub data ImportTarget [copy] {
    found: bool;
    package: u64 in Trapping;
    selector_count: u64 in Trapping;
}

// Every `use` names a supplied module; the first that names none rejects.
pub machine Resolver::check_imports(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0) }

    state next(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.use_count {
            true -> import(resolver, sources, syntax, index)
            _ -> done()
        }
    }

    state import(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, index: u64 in Trapping) {
        let use_item: UseItem = SyntaxTrees::use_item(syntax, index);
        let target: ImportTarget = Resolver::import_target(sources, syntax, use_item);
        let named: bool = Resolver::names_some_unit(sources, syntax, use_item, target, 0);
        transition named {
            true -> next(resolver, sources, syntax, index + 1)
            _ -> unresolved(resolver, sources, syntax, use_item, target)
        }
    }

    state unresolved(resolver: &mut Resolver, sources: &SourceSet, syntax: &SyntaxTrees, use_item: UseItem, target: ImportTarget) {
        let undeclared: bool = Resolver::undeclared_dependency(sources, syntax, use_item, target);
        transition undeclared {
            true -> reject(resolver, ResolveDiagnosticCode::UndeclaredDependency, use_item)
            _ -> reject(resolver, ResolveDiagnosticCode::UnresolvedImport, use_item)
        }
    }

    state reject(resolver: &mut Resolver, code: ResolveDiagnosticCode, use_item: UseItem) {
        NameResolution::reject(&mut resolver.output, code, use_item.source_span);
    }

    state done() {}
}

// The package `use_item`'s path selects and the members selecting it.
pub machine Resolver::import_target(sources: &SourceSet, syntax: &SyntaxTrees, use_item: UseItem) -> ImportTarget
crashes Trap
{
    let requester: u64 in Trapping = SourceSet::unit_package(sources, use_item.source_span.source.value as u64 in Trapping);
    let mounted: bool = Resolver::names_toolchain_mount(sources, syntax, use_item);
    transition mounted {
        true -> toolchain(sources, 0)
        _ -> first(sources, syntax, use_item, requester)
    }

    state toolchain(sources: &SourceSet, package: u64 in Trapping) -> ImportTarget {
        transition package < sources.package_count {
            true -> toolchain_candidate(sources, package)
            _ -> missing()
        }
    }

    state toolchain_candidate(sources: &SourceSet, package: u64 in Trapping) -> ImportTarget {
        let row: PackageRow = SourceSet::package_row(sources, package);
        transition row.toolchain {
            true -> selected(package, 3)
            _ -> toolchain(sources, package + 1)
        }
    }

    state first(sources: &SourceSet, syntax: &SyntaxTrees, use_item: UseItem, requester: u64 in Trapping) -> ImportTarget {
        let member: IdentifierSpan = SyntaxTrees::member(syntax, use_item.first_member);
        let spelling: SourceSpan = member.source_span;
        transition { _ -> alias(sources, requester, spelling, 0) }
    }

    state alias(sources: &SourceSet, requester: u64 in Trapping, spelling: SourceSpan, index: u64 in Trapping) -> ImportTarget {
        transition index < sources.dependency_count {
            true -> alias_candidate(sources, requester, spelling, index)
            _ -> own(sources, requester, spelling)
        }
    }

    state alias_candidate(sources: &SourceSet, requester: u64 in Trapping, spelling: SourceSpan, index: u64 in Trapping) -> ImportTarget {
        let edge: DependencyRow = SourceSet::dependency_row(sources, index);
        let named: bool = Resolver::edge_names(sources, edge, requester, DependencyScope::Product, spelling);
        transition named {
            true -> selected(edge.target, 1)
            _ -> alias(sources, requester, spelling, index + 1)
        }
    }

    state own(sources: &SourceSet, requester: u64 in Trapping, spelling: SourceSpan) -> ImportTarget {
        let row: PackageRow = SourceSet::package_row(sources, requester);
        let named: bool = SourceSet::span_names(sources, spelling, row.name);
        transition named {
            true -> selected(requester, 1)
            _ -> selected(requester, 0)
        }
    }

    state selected(package: u64 in Trapping, selector_count: u64 in Trapping) -> ImportTarget {
        ImportTarget { found: true, package: package, selector_count: selector_count }
    }

    state missing() -> ImportTarget {
        ImportTarget { found: false, package: 0, selector_count: 0 }
    }
}

// Whether `use_item` begins with the toolchain mount `omega::language::core`,
// which claims every path below it.
machine Resolver::names_toolchain_mount(sources: &SourceSet, syntax: &SyntaxTrees, use_item: UseItem) -> bool
crashes Trap
{
    transition use_item.member_count >= 3 {
        true -> member(sources, syntax, use_item, 0)
        _ -> no()
    }

    state member(sources: &SourceSet, syntax: &SyntaxTrees, use_item: UseItem, offset: u64 in Trapping) -> bool {
        let spelling: IdentifierSpan = SyntaxTrees::member(syntax, use_item.first_member + offset);
        let omega: bool = SourceSet::span_spells(sources, spelling.source_span, "omega");
        let language: bool = SourceSet::span_spells(sources, spelling.source_span, "language");
        let core: bool = SourceSet::span_spells(sources, spelling.source_span, "core");
        transition (offset == 0 && omega) || (offset == 1 && language) || (offset == 2 && core) {
            true -> spelled(sources, syntax, use_item, offset)
            _ -> no()
        }
    }

    state spelled(sources: &SourceSet, syntax: &SyntaxTrees, use_item: UseItem, offset: u64 in Trapping) -> bool {
        transition offset < 2 {
            true -> member(sources, syntax, use_item, offset + 1)
            _ -> yes()
        }
    }

    state yes() -> bool {
        true
    }

    state no() -> bool {
        false
    }
}

// Whether `edge` is `requester`'s edge of `scope` whose alias `spelling`
// spells.
machine Resolver::edge_names(
    sources: &SourceSet,
    edge: DependencyRow,
    requester: u64 in Trapping,
    scope: DependencyScope,
    spelling: SourceSpan
) -> bool
crashes Trap
{
    transition edge.requester == requester && edge.scope == scope {
        true -> spelled(sources, edge, spelling)
        _ -> no()
    }

    state spelled(sources: &SourceSet, edge: DependencyRow, spelling: SourceSpan) -> bool {
        SourceSet::span_names(sources, spelling, edge.alias)
    }

    state no() -> bool {
        false
    }
}

// Whether an import that names no module is an undeclared dependency: its
// path would be a module path of the requester's own package, but its first
// member spells another package's name or one of the requester's
// build-scope aliases.
machine Resolver::undeclared_dependency(sources: &SourceSet, syntax: &SyntaxTrees, use_item: UseItem, target: ImportTarget) -> bool
crashes Trap
{
    let requester: u64 in Trapping = SourceSet::unit_package(sources, use_item.source_span.source.value as u64 in Trapping);
    let member: IdentifierSpan = SyntaxTrees::member(syntax, use_item.first_member);
    let spelling: SourceSpan = member.source_span;
    transition target.found && target.selector_count == 0 {
        true -> named_package(sources, requester, spelling, 0)
        _ -> no()
    }

    state named_package(sources: &SourceSet, requester: u64 in Trapping, spelling: SourceSpan, index: u64 in Trapping) -> bool {
        transition index < sources.package_count {
            true -> package_candidate(sources, requester, spelling, index)
            _ -> build_alias(sources, requester, spelling, 0)
        }
    }

    state package_candidate(sources: &SourceSet, requester: u64 in Trapping, spelling: SourceSpan, index: u64 in Trapping) -> bool {
        let row: PackageRow = SourceSet::package_row(sources, index);
        let named: bool = SourceSet::span_names(sources, spelling, row.name);
        transition named && index != requester {
            true -> yes()
            _ -> named_package(sources, requester, spelling, index + 1)
        }
    }

    state build_alias(sources: &SourceSet, requester: u64 in Trapping, spelling: SourceSpan, index: u64 in Trapping) -> bool {
        transition index < sources.dependency_count {
            true -> build_alias_candidate(sources, requester, spelling, index)
            _ -> no()
        }
    }

    state build_alias_candidate(sources: &SourceSet, requester: u64 in Trapping, spelling: SourceSpan, index: u64 in Trapping) -> bool {
        let edge: DependencyRow = SourceSet::dependency_row(sources, index);
        let named: bool = Resolver::edge_names(sources, edge, requester, DependencyScope::Build, spelling);
        transition named {
            true -> yes()
            _ -> build_alias(sources, requester, spelling, index + 1)
        }
    }

    state yes() -> bool {
        true
    }

    state no() -> bool {
        false
    }
}

// Whether some unit at or after `unit` belongs to the module `use_item`
// names in the package `target` selects.
machine Resolver::names_some_unit(
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    use_item: UseItem,
    target: ImportTarget,
    unit: u64 in Trapping
) -> bool
crashes Trap
{
    transition unit < sources.unit_count {
        true -> candidate(sources, syntax, use_item, target, unit)
        _ -> none()
    }

    state candidate(sources: &SourceSet, syntax: &SyntaxTrees, use_item: UseItem, target: ImportTarget, unit: u64 in Trapping) -> bool {
        let named: bool = Resolver::use_names_unit(sources, syntax, use_item, target, unit);
        transition named {
            true -> some()
            _ -> next(sources, syntax, use_item, target, unit + 1)
        }
    }

    state next(sources: &SourceSet, syntax: &SyntaxTrees, use_item: UseItem, target: ImportTarget, unit: u64 in Trapping) -> bool {
        transition unit < sources.unit_count {
            true -> candidate(sources, syntax, use_item, target, unit)
            _ -> none()
        }
    }

    state some() -> bool {
        true
    }

    state none() -> bool {
        false
    }
}

// Whether a declaration of unit `declared`, `pub` when `public`, is one a
// reference in `from` may name: one of the same unit or module, or one a
// `use` of `from` imports, which across packages must be `pub`.
pub machine Resolver::visible(sources: &SourceSet, syntax: &SyntaxTrees, from: SourceId, declared: SourceId, public: bool) -> bool
crashes Trap
{
    let from_unit: u64 in Trapping = from.value as u64 in Trapping;
    let declared_unit: u64 in Trapping = declared.value as u64 in Trapping;
    let same_module: bool = Resolver::same_module(sources, from_unit, declared_unit);
    let same_package: bool = Resolver::same_package(sources, from_unit, declared_unit);
    transition from_unit == declared_unit || same_module {
        true -> seen()
        _ -> exposed(sources, syntax, from, declared_unit, public || same_package)
    }

    state exposed(sources: &SourceSet, syntax: &SyntaxTrees, from: SourceId, declared_unit: u64 in Trapping, open: bool) -> bool {
        transition open {
            true -> imported(sources, syntax, from, declared_unit, 0)
            _ -> unseen()
        }
    }

    state imported(sources: &SourceSet, syntax: &SyntaxTrees, from: SourceId, declared_unit: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < syntax.use_count {
            true -> use_row(sources, syntax, from, declared_unit, index)
            _ -> unseen()
        }
    }

    state use_row(sources: &SourceSet, syntax: &SyntaxTrees, from: SourceId, declared_unit: u64 in Trapping, index: u64 in Trapping) -> bool {
        let use_item: UseItem = SyntaxTrees::use_item(syntax, index);
        transition use_item.source_span.source.value == from.value {
            true -> own_use(sources, syntax, from, declared_unit, index, use_item)
            _ -> imported(sources, syntax, from, declared_unit, index + 1)
        }
    }

    state own_use(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        from: SourceId,
        declared_unit: u64 in Trapping,
        index: u64 in Trapping,
        use_item: UseItem
    ) -> bool {
        let target: ImportTarget = Resolver::import_target(sources, syntax, use_item);
        let named: bool = Resolver::use_names_unit(sources, syntax, use_item, target, declared_unit);
        transition named {
            true -> seen()
            _ -> imported(sources, syntax, from, declared_unit, index + 1)
        }
    }

    state seen() -> bool {
        true
    }

    state unseen() -> bool {
        false
    }
}

// Whether two units belong to one package.
pub machine Resolver::same_package(sources: &SourceSet, left: u64 in Trapping, right: u64 in Trapping) -> bool {
    let left_package: u64 in Trapping = SourceSet::unit_package(sources, left);
    let right_package: u64 in Trapping = SourceSet::unit_package(sources, right);
    left_package == right_package
}

// Whether two units belong to one module: one package and one module path.
pub machine Resolver::same_module(sources: &SourceSet, left: u64 in Trapping, right: u64 in Trapping) -> bool
crashes Trap
{
    let left_length: u64 in Trapping = SourceSet::path_length(sources, left);
    let right_length: u64 in Trapping = SourceSet::path_length(sources, right);
    let same_package: bool = Resolver::same_package(sources, left, right);
    transition same_package && left_length == right_length {
        true -> compare(sources, left, right, left_length, 0)
        _ -> different()
    }

    state compare(sources: &SourceSet, left: u64 in Trapping, right: u64 in Trapping, length: u64 in Trapping, index: u64 in Trapping) -> bool {
        let left_byte: u8 = SourceSet::path_byte_or_nul(sources, left, index);
        let right_byte: u8 = SourceSet::path_byte_or_nul(sources, right, index);
        transition index < length {
            true -> byte(sources, left, right, length, index, left_byte == right_byte)
            _ -> same()
        }
    }

    state byte(sources: &SourceSet, left: u64 in Trapping, right: u64 in Trapping, length: u64 in Trapping, index: u64 in Trapping, equal: bool) -> bool {
        transition equal {
            true -> compare(sources, left, right, length, index + 1)
            _ -> different()
        }
    }

    state same() -> bool {
        true
    }

    state different() -> bool {
        false
    }
}

// Whether `use_item`, selecting `target`, names unit `unit`'s module: the
// unit belongs to the selected package, and the members after the selecting
// ones, in order and joined by `::`, spell its module path.
pub machine Resolver::use_names_unit(
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    use_item: UseItem,
    target: ImportTarget,
    unit: u64 in Trapping
) -> bool
crashes Trap
{
    let length: u64 in Trapping = SourceSet::path_length(sources, unit);
    let package: u64 in Trapping = SourceSet::unit_package(sources, unit);
    transition target.found && package == target.package && target.selector_count < use_item.member_count {
        true -> member(sources, syntax, use_item, unit, length, target.selector_count, 0)
        _ -> different()
    }

    // `position` is where member `member` must begin in the module path.
    state member(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        use_item: UseItem,
        unit: u64 in Trapping,
        length: u64 in Trapping,
        member: u64 in Trapping,
        position: u64 in Trapping
    ) -> bool {
        let spelling: IdentifierSpan = SyntaxTrees::member(syntax, use_item.first_member + member);
        let width: u64 in Trapping = spelling.source_span.span.end - spelling.source_span.span.start;
        transition position + width <= length {
            true -> spell(sources, syntax, use_item, unit, length, member, position, spelling.source_span, 0)
            _ -> different()
        }
    }

    state spell(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        use_item: UseItem,
        unit: u64 in Trapping,
        length: u64 in Trapping,
        member: u64 in Trapping,
        position: u64 in Trapping,
        spelling: SourceSpan,
        offset: u64 in Trapping
    ) -> bool {
        let source_byte: u8 = SourceSet::byte_or_nul(sources, spelling.source, spelling.span.start + offset);
        let path_byte: u8 = SourceSet::path_byte_or_nul(sources, unit, position + offset);
        transition offset < spelling.span.end - spelling.span.start {
            true -> spelled_byte(sources, syntax, use_item, unit, length, member, position, spelling, offset, source_byte == path_byte)
            _ -> member_end(sources, syntax, use_item, unit, length, member, position + offset)
        }
    }

    state spelled_byte(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        use_item: UseItem,
        unit: u64 in Trapping,
        length: u64 in Trapping,
        member: u64 in Trapping,
        position: u64 in Trapping,
        spelling: SourceSpan,
        offset: u64 in Trapping,
        equal: bool
    ) -> bool {
        transition equal {
            true -> spell(sources, syntax, use_item, unit, length, member, position, spelling, offset + 1)
            _ -> different()
        }
    }

    // After the last member the path must end; otherwise `::` follows.
    state member_end(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        use_item: UseItem,
        unit: u64 in Trapping,
        length: u64 in Trapping,
        member: u64 in Trapping,
        position: u64 in Trapping
    ) -> bool {
        transition member + 1 < use_item.member_count {
            true -> separator(sources, syntax, use_item, unit, length, member, position)
            _ -> ended(length, position)
        }
    }

    state separator(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        use_item: UseItem,
        unit: u64 in Trapping,
        length: u64 in Trapping,
        member: u64 in Trapping,
        position: u64 in Trapping
    ) -> bool {
        let first: u8 = SourceSet::path_byte_or_nul(sources, unit, position);
        let second: u8 = SourceSet::path_byte_or_nul(sources, unit, position + 1);
        transition first == 58 && second == 58 {
            true -> member(sources, syntax, use_item, unit, length, member + 1, position + 2)
            _ -> different()
        }
    }

    state ended(length: u64 in Trapping, position: u64 in Trapping) -> bool {
        position == length
    }

    state different() -> bool {
        false
    }
}

// What a name denotes among the declarations its unit can see.
pub data Lookup [copy] {
    case Absent;
    case Found(handle: u64 in Trapping);
    case Ambiguous;
}

// The declaration tables a name or `Owner::name` path selects by spelling.
// Data, traits and conformances are type names, constants values and
// propositions logical declarations. Domains select by carrier as well
// (domains.omg) and machines by overload family (`machine_named`).
pub data DeclarationKind [copy] {
    case Data;
    case Trait;
    case Conformance;
    case Constant;
    case Proposition;
}

// The path a declaration's name spells: its owner when it has one, then its
// name. Only a constant takes an owner (`const Owner::NAME`). `is_public`
// is the declaration's `pub`.
pub data DeclarationPath [copy] {
    has_owner: bool;
    owner: IdentifierSpan;
    name: IdentifierSpan;
    is_public: bool;
}

pub machine Resolver::declaration_count(syntax: &SyntaxTrees, kind: DeclarationKind) -> u64 in Trapping {
    transition kind {
        DeclarationKind::Data -> count(syntax.data_count as u64 in Trapping)
        DeclarationKind::Trait -> count(syntax.trait_count as u64 in Trapping)
        DeclarationKind::Conformance -> count(syntax.conformance_count as u64 in Trapping)
        DeclarationKind::Constant -> count(syntax.constant_count as u64 in Trapping)
        DeclarationKind::Proposition -> count(syntax.proposition_count as u64 in Trapping)
    }

    state count(value: u64 in Trapping) -> u64 in Trapping {
        value
    }
}

pub machine Resolver::declaration_path(syntax: &SyntaxTrees, kind: DeclarationKind, index: u64 in Trapping) -> DeclarationPath
crashes Trap
{
    transition kind {
        DeclarationKind::Data -> data(syntax, index)
        DeclarationKind::Trait -> trait_name(syntax, index)
        DeclarationKind::Conformance -> conformance(syntax, index)
        DeclarationKind::Constant -> constant(syntax, index)
        DeclarationKind::Proposition -> proposition(syntax, index)
    }

    state data(syntax: &SyntaxTrees, index: u64 in Trapping) -> DeclarationPath {
        let item: DataItem = SyntaxTrees::data_item(syntax, index);
        DeclarationPath { has_owner: false, owner: item.name, name: item.name, is_public: item.is_public }
    }

    state trait_name(syntax: &SyntaxTrees, index: u64 in Trapping) -> DeclarationPath {
        let item: TraitItem = SyntaxTrees::trait_item(syntax, index);
        DeclarationPath { has_owner: false, owner: item.name, name: item.name, is_public: item.is_public }
    }

    state conformance(syntax: &SyntaxTrees, index: u64 in Trapping) -> DeclarationPath {
        let item: ConformanceItem = SyntaxTrees::conformance_item(syntax, index);
        DeclarationPath { has_owner: false, owner: item.name, name: item.name, is_public: item.is_public }
    }

    state constant(syntax: &SyntaxTrees, index: u64 in Trapping) -> DeclarationPath {
        let item: ConstantItem = SyntaxTrees::constant_item(syntax, index);
        DeclarationPath { has_owner: item.has_owner, owner: item.owner, name: item.name, is_public: item.is_public }
    }

    state proposition(syntax: &SyntaxTrees, index: u64 in Trapping) -> DeclarationPath {
        let item: PropositionItem = SyntaxTrees::proposition_item(syntax, index);
        DeclarationPath { has_owner: false, owner: item.name, name: item.name, is_public: item.is_public }
    }
}

// Whether a declaration's path is `name` (owned by `owner` when `owned`).
pub machine Resolver::path_spells(sources: &SourceSet, path: DeclarationPath, owned: bool, owner: SourceSpan, name: SourceSpan) -> bool
crashes Trap
{
    let named: bool = SourceSet::spans_equal(sources, path.name.source_span, name);
    let owner_named: bool = SourceSet::spans_equal(sources, path.owner.source_span, owner);
    named && path.has_owner == owned && (!owned || owner_named)
}

// The declaration of `kind` that `name` (owned by `owner` when `owned`)
// denotes from its own unit. A second visible declaration of the path
// belongs to another module (a module's duplicates reject earlier), so it
// makes the name ambiguous.
pub machine Resolver::declared_named(
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    kind: DeclarationKind,
    owned: bool,
    owner: SourceSpan,
    name: SourceSpan
) -> Lookup
crashes Trap
{
    let count: u64 in Trapping = Resolver::declaration_count(syntax, kind);
    transition { _ -> next(sources, syntax, kind, owned, owner, name, count, 0) }

    state next(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        kind: DeclarationKind,
        owned: bool,
        owner: SourceSpan,
        name: SourceSpan,
        count: u64 in Trapping,
        index: u64 in Trapping
    ) -> Lookup {
        transition index < count {
            true -> candidate(sources, syntax, kind, owned, owner, name, count, index)
            _ -> absent()
        }
    }

    state candidate(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        kind: DeclarationKind,
        owned: bool,
        owner: SourceSpan,
        name: SourceSpan,
        count: u64 in Trapping,
        index: u64 in Trapping
    ) -> Lookup {
        let path: DeclarationPath = Resolver::declaration_path(syntax, kind, index);
        let named: bool = Resolver::path_spells(sources, path, owned, owner, name);
        let visible: bool = Resolver::visible_if(sources, syntax, named, name.source, path.name.source_span.source, path.is_public);
        transition visible {
            true -> rival(sources, syntax, kind, owned, owner, name, count, index, index + 1)
            _ -> next(sources, syntax, kind, owned, owner, name, count, index + 1)
        }
    }

    state rival(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        kind: DeclarationKind,
        owned: bool,
        owner: SourceSpan,
        name: SourceSpan,
        count: u64 in Trapping,
        found: u64 in Trapping,
        index: u64 in Trapping
    ) -> Lookup {
        transition index < count {
            true -> rival_candidate(sources, syntax, kind, owned, owner, name, count, found, index)
            _ -> unique(found)
        }
    }

    state rival_candidate(
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        kind: DeclarationKind,
        owned: bool,
        owner: SourceSpan,
        name: SourceSpan,
        count: u64 in Trapping,
        found: u64 in Trapping,
        index: u64 in Trapping
    ) -> Lookup {
        let path: DeclarationPath = Resolver::declaration_path(syntax, kind, index);
        let named: bool = Resolver::path_spells(sources, path, owned, owner, name);
        let visible: bool = Resolver::visible_if(sources, syntax, named, name.source, path.name.source_span.source, path.is_public);
        transition visible {
            true -> ambiguous()
            _ -> rival(sources, syntax, kind, owned, owner, name, count, found, index + 1)
        }
    }

    state unique(found: u64 in Trapping) -> Lookup {
        Lookup::Found { handle: found }
    }

    state absent() -> Lookup {
        Lookup::Absent
    }

    state ambiguous() -> Lookup {
        Lookup::Ambiguous
    }
}

// The data declaration `name` denotes from its own unit.
pub machine Resolver::data_named(sources: &SourceSet, syntax: &SyntaxTrees, name: SourceSpan) -> Lookup
crashes Trap
{
    Resolver::declared_named(sources, syntax, DeclarationKind::Data, false, name, name)
}

// The first visible machine whose path is `name` (owned by `owner` when
// `owned`): its overload family's representative, since typing selects
// among a module's overloads. A machine's path is its `MachineOwner`'s, so
// `Trait::requirement` and `Conformance::member` name container members. A
// visible machine of the same path in another module makes the name
// ambiguous.
pub machine Resolver::machine_named(
    resolution: &NameResolution,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    owned: bool,
    owner: SourceSpan,
    name: SourceSpan
) -> Lookup
crashes Trap
{
    transition { _ -> next(resolution, sources, syntax, owned, owner, name, 0) }

    state next(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owned: bool, owner: SourceSpan, name: SourceSpan, index: u64 in Trapping) -> Lookup {
        transition index < syntax.machine_count {
            true -> candidate(resolution, sources, syntax, owned, owner, name, index)
            _ -> absent()
        }
    }

    state candidate(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, owned: bool, owner: SourceSpan, name: SourceSpan, index: u64 in Trapping) -> Lookup {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let named: bool = Resolver::machine_spells(resolution, sources, item, index, owned, owner, name);
        let visible: bool = Resolver::machine_visible_if(resolution, sources, syntax, named, name.source, item, index);
        transition visible {
            true -> rival(resolution, sources, syntax, owned, owner, name, index, item.name.source_span.source, index + 1)
            _ -> next(resolution, sources, syntax, owned, owner, name, index + 1)
        }
    }

    state rival(
        resolution: &NameResolution,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        owned: bool,
        owner: SourceSpan,
        name: SourceSpan,
        found: u64 in Trapping,
        family: SourceId,
        index: u64 in Trapping
    ) -> Lookup {
        transition index < syntax.machine_count {
            true -> rival_candidate(resolution, sources, syntax, owned, owner, name, found, family, index)
            _ -> unique(found)
        }
    }

    state rival_candidate(
        resolution: &NameResolution,
        sources: &SourceSet,
        syntax: &SyntaxTrees,
        owned: bool,
        owner: SourceSpan,
        name: SourceSpan,
        found: u64 in Trapping,
        family: SourceId,
        index: u64 in Trapping
    ) -> Lookup {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let named: bool = Resolver::machine_spells(resolution, sources, item, index, owned, owner, name);
        let visible: bool = Resolver::machine_visible_if(resolution, sources, syntax, named, name.source, item, index);
        let overload: bool = Resolver::same_module(sources, family.value as u64 in Trapping,
            item.name.source_span.source.value as u64 in Trapping);
        transition visible && !overload {
            true -> ambiguous()
            _ -> rival(resolution, sources, syntax, owned, owner, name, found, family, index + 1)
        }
    }

    state unique(found: u64 in Trapping) -> Lookup {
        Lookup::Found { handle: found }
    }

    state absent() -> Lookup {
        Lookup::Absent
    }

    state ambiguous() -> Lookup {
        Lookup::Ambiguous
    }
}

// Whether machine `handle` (row `item`) has the path `name` (owned by
// `owner` when `owned`), through its `MachineOwner`.
pub machine Resolver::machine_spells(
    resolution: &NameResolution,
    sources: &SourceSet,
    item: MachineItem,
    handle: u64 in Trapping,
    owned: bool,
    owner: SourceSpan,
    name: SourceSpan
) -> bool
crashes Trap
{
    let path: MachineOwner = NameResolution::machine_owner(resolution, handle);
    let named: bool = SourceSet::spans_equal(sources, item.name.source_span, name);
    let owner_named: bool = SourceSet::spans_equal(sources, path.owner.source_span, owner);
    let callable: bool = item.container != MachineContainer::Measure;
    callable && named && path.has_owner == owned && (!owned || owner_named)
}

// The declared measure `Owner::name` (wiki/spec/language/termination.md),
// as its machine handle plus one; zero for none. A measure is a view, not a
// callee, so `machine_spells` never matches one.
pub machine Resolver::measure_named(sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(sources, syntax, owner, name, 0) }

    state next(sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan, index: u64 in Trapping) -> u64 in Trapping {
        transition index < syntax.machine_count {
            true -> candidate(sources, syntax, owner, name, index)
            _ -> absent()
        }
    }

    state candidate(sources: &SourceSet, syntax: &SyntaxTrees, owner: SourceSpan, name: SourceSpan, index: u64 in Trapping) -> u64 in Trapping {
        let item: MachineItem = SyntaxTrees::machine_item(syntax, index);
        let named: bool = item.container == MachineContainer::Measure && item.has_owner
            && SourceSet::spans_equal(sources, item.name.source_span, name)
            && SourceSet::spans_equal(sources, item.owner.source_span, owner);
        transition named {
            true -> found(index)
            _ -> next(sources, syntax, owner, name, index + 1)
        }
    }

    state found(index: u64 in Trapping) -> u64 in Trapping {
        index + 1
    }

    state absent() -> u64 in Trapping {
        0
    }
}

// Visibility, tested only for a declaration whose spelling matched.
pub machine Resolver::visible_if(
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    named: bool,
    from: SourceId,
    declared: SourceId,
    public: bool
) -> bool
crashes Trap
{
    transition named {
        true -> test(sources, syntax, from, declared, public)
        _ -> hidden()
    }

    state test(sources: &SourceSet, syntax: &SyntaxTrees, from: SourceId, declared: SourceId, public: bool) -> bool {
        Resolver::visible(sources, syntax, from, declared, public)
    }

    state hidden() -> bool {
        false
    }
}

// A machine's visibility, tested only when its spelling matched.
pub machine Resolver::machine_visible_if(
    resolution: &NameResolution,
    sources: &SourceSet,
    syntax: &SyntaxTrees,
    named: bool,
    from: SourceId,
    item: MachineItem,
    handle: u64 in Trapping
) -> bool
crashes Trap
{
    transition named {
        true -> test(resolution, sources, syntax, from, item, handle)
        _ -> hidden()
    }

    state test(resolution: &NameResolution, sources: &SourceSet, syntax: &SyntaxTrees, from: SourceId, item: MachineItem, handle: u64 in Trapping) -> bool {
        let public: bool = Resolver::machine_public(resolution, syntax, item, handle);
        Resolver::visible(sources, syntax, from, item.name.source_span.source, public)
    }

    state hidden() -> bool {
        false
    }
}

// Whether machine `handle` (row `item`) is `pub`: a root machine by its own
// marker, a trait's or conformance's member by its container's.
pub machine Resolver::machine_public(resolution: &NameResolution, syntax: &SyntaxTrees, item: MachineItem, handle: u64 in Trapping) -> bool
crashes Trap
{
    let owner: MachineOwner = NameResolution::machine_owner(resolution, handle);
    transition owner.container {
        MachineContainer::Root -> answer(item.is_public)
        MachineContainer::Measure -> answer(false)
        MachineContainer::Trait -> trait_container(syntax, owner.item)
        MachineContainer::Refinement -> trait_container(syntax, owner.item)
        MachineContainer::Conformance -> conformance_container(syntax, owner.item)
    }

    state trait_container(syntax: &SyntaxTrees, index: u64 in Trapping) -> bool {
        let container: TraitItem = SyntaxTrees::trait_item(syntax, index);
        container.is_public
    }

    state conformance_container(syntax: &SyntaxTrees, index: u64 in Trapping) -> bool {
        let container: ConformanceItem = SyntaxTrees::conformance_item(syntax, index);
        container.is_public
    }

    state answer(public: bool) -> bool {
        public
    }
}
