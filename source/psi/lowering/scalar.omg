// A closed in-process lowering slice. Every result is ordinary u8, its value
// identity is its operation index, and callee identities retain declaration
// order. These are the IntegerConstant, ExactInteger*, Call and scalar-return
// meanings in wiki/spec/terminal-psi/{encoding,calls_and_outcomes}.md.
// The consumer needs neither syntax nor source bytes. Full portable publication
// must additionally retain canonical declaration/contract/obligation identities;
// checker acceptance and counts cannot substitute for those records.
public data ScalarOperationKind [copy] {
    case IntegerConstant;
    case ExactIntegerAdd;
    case ExactIntegerSubtract;
    case ExactIntegerMultiply;
    case ExactIntegerDivide;
    case ExactIntegerRemainder;
    case Call;
}

public data ScalarOperation [copy] {
    kind: ScalarOperationKind;
    left: u64 in Trapping;
    right: u64 in Trapping;
}

public data ScalarMachine [copy] {
    first: u64 in Trapping;
    count: u64 in Trapping;
    // The scalar return terminator, distinct from the ordered operations.
    result: u64 in Trapping;
}

public data ScalarStatus [copy] {
    case Complete;
    case Unchecked;
    case Unsupported;
    case Capacity;
}

public data ScalarProgram {
    operations: [ScalarOperation; 16384] in Trapping;
    operation_count: u64 in Trapping;
    machines: [ScalarMachine; 10240] in Trapping;
    machine_count: u64 in Trapping;
    entry: u64 in Trapping;
    status: ScalarStatus;
}

public data ScalarLowerer {
    output: ScalarProgram;
    // Handles are one-based so absence cannot accidentally name operation 0.
    values: [u64; 131072] in Trapping;
    locals: [u64; 16384] in Trapping;
    work: [u64; 4096] in Trapping;
    ready: [bool; 4096] in Trapping;
    work_count: u64 in Trapping;
    colors: [u8; 10240] in Trapping;
    cursors: [u64; 10240] in Trapping;
    calls: [u64; 10240] in Trapping;
    call_count: u64 in Trapping;
}

public machine scalar_operation(program: &ScalarProgram, index: u64 in Trapping) -> ScalarOperation
crashes Trap
{
    transition index < program.operation_count && index < 16384 {
        true -> read(program, index)
        _ -> invalid()
    }
    machine read(program: &ScalarProgram, index: u64 in Trapping) -> ScalarOperation { program.operations[index] }
    machine invalid() -> ScalarOperation { crash Trap; }
}

public machine scalar_machine_at(program: &ScalarProgram, index: u64 in Trapping) -> ScalarMachine
crashes Trap
{
    transition index < program.machine_count && index < 10240 {
        true -> read(program, index)
        _ -> invalid()
    }
    machine read(program: &ScalarProgram, index: u64 in Trapping) -> ScalarMachine { program.machines[index] }
    machine invalid() -> ScalarMachine { crash Trap; }
}

machine scalar_append(lowerer: &mut ScalarLowerer, kind: ScalarOperationKind, left: u64 in Trapping, right: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let index: u64 in Trapping = lowerer.output.operation_count;
    transition index < 16384 {
        true -> store(lowerer, kind, left, right, index)
        _ -> full(lowerer)
    }
    machine store(lowerer: &mut ScalarLowerer, kind: ScalarOperationKind, left: u64 in Trapping, right: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        lowerer.output.operations[index] = ScalarOperation { kind: kind, left: left, right: right };
        lowerer.output.operation_count = index + 1;
        index + 1
    }
    machine full(lowerer: &mut ScalarLowerer) -> u64 in Trapping {
        lowerer.output.status = ScalarStatus::Capacity;
        0
    }
}

// Syntax handles are checked again at the storage boundary. Producer
// invariants must not become unchecked physical array accesses.
machine scalar_value(lowerer: &ScalarLowerer, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition handle < 131072 {
        true -> read(lowerer, handle)
        _ -> invalid()
    }
    machine read(lowerer: &ScalarLowerer, handle: u64 in Trapping) -> u64 in Trapping {
        lowerer.values[handle] as u64 in Trapping
    }
    machine invalid() -> u64 in Trapping { crash Trap; }
}

machine scalar_local(lowerer: &ScalarLowerer, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition handle < 16384 {
        true -> read(lowerer, handle)
        _ -> invalid()
    }
    machine read(lowerer: &ScalarLowerer, handle: u64 in Trapping) -> u64 in Trapping {
        lowerer.locals[handle] as u64 in Trapping
    }
    machine invalid() -> u64 in Trapping { crash Trap; }
}

machine scalar_bind(lowerer: &mut ScalarLowerer, handle: u64 in Trapping, value: u64 in Trapping)
crashes Trap
{
    transition handle < 16384 {
        true -> write(lowerer, handle, value)
        _ -> invalid()
    }
    machine write(lowerer: &mut ScalarLowerer, handle: u64 in Trapping, value: u64 in Trapping) {
        lowerer.locals[handle] = value;
    }
    machine invalid() { crash Trap; }
}

// Only ordinary u8 is admitted. Wrapping, saturating and trapping policies
// need their own operations and cannot be silently erased by this slice.
machine scalar_byte_type(typing: &Typing, handle: u64 in Trapping) -> bool
crashes Trap
{
    let row: TypeRow = type_table_row(&typing.types, handle);
    transition row.kind {
        TypeKind::Builtin -> builtin(row)
        _ -> no()
    }
    machine builtin(row: TypeRow) -> bool {
        transition row.builtin {
            BuiltinType::U8 -> policy(row)
            _ -> no()
        }
    }
    machine policy(row: TypeRow) -> bool {
        transition row.domain { DomainBinding::Unqualified -> yes() _ -> no() }
    }
    machine yes() -> bool { true }
    machine no() -> bool { false }
}

// A checked policy cast preserves the u8 payload. This predicate permits
// storage and identity casts only; arithmetic and callable boundaries keep
// scalar_byte_type's unqualified requirement.
machine scalar_byte_storage(typing: &Typing, handle: u64 in Trapping) -> bool
crashes Trap
{
    let row: TypeRow = type_table_row(&typing.types, handle);
    let policy: bool = row.domain == DomainBinding::Unqualified
        || row.domain == DomainBinding::Wrapping || row.domain == DomainBinding::Saturating
        || row.domain == DomainBinding::Trapping;
    row.kind == TypeKind::Builtin && row.builtin == BuiltinType::U8 && policy
}

public machine scalar_lower(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, checks: &Checks, entry: u64 in Trapping)
crashes Trap
{
    lowerer.output.operation_count = 0;
    lowerer.output.machine_count = 0;
    lowerer.output.entry = entry;
    lowerer.output.status = ScalarStatus::Unchecked;
    transition syntax.accepted && resolution.accepted && typing.accepted && checks.accepted {
        true -> select(lowerer, syntax, resolution, typing, entry)
        _ -> done()
    }
    machine select(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, entry: u64 in Trapping) {
        lowerer.output.status = ScalarStatus::Unsupported;
        transition entry < syntax.machine_count && syntax.machine_count <= 10240
            && syntax.erased_binding_count == 0 {
            true -> entry_root(lowerer, syntax, resolution, typing, entry)
            _ -> done()
        }
    }
    // Lexical helpers remain ordinary resolved callees, but this synthetic
    // external invocation does not grant access to a parent's private scope.
    machine entry_root(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, entry: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, entry);
        transition item.parent == 0 {
            true -> begin(lowerer, syntax, resolution, typing)
            _ -> done()
        }
    }
    machine begin(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing) {
        lowerer.output.status = ScalarStatus::Complete;
        transition { _ -> roots(lowerer, syntax, resolution, typing, 0) }
    }
    // Global declarations are outside this closed slice even when unused.
    // Checking only machine bodies would silently admit unsupported roots.
    machine roots(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        transition index < syntax.root_count {
            true -> root(lowerer, syntax, resolution, typing, index)
            _ -> next(lowerer, syntax, resolution, typing, 0)
        }
    }
    machine root(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        let item: RootItem = root_item(syntax, index);
        transition item.kind {
            RootItemKind::Machine -> roots(lowerer, syntax, resolution, typing, index + 1)
            _ -> unsupported(lowerer)
        }
    }
    machine next(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> body(lowerer, syntax, resolution, typing, index)
            _ -> acyclic(lowerer)
        }
    }
    machine body(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, index);
        // In particular, checking a body under its requires clauses does not
        // establish them for the synthetic external entry. No clauses are
        // admitted until entry call formation carries that ordinary proof.
        transition item.has_body && item.has_return_type && item.parameter_count == 0
            && item.generic_parameter_count == 0 && !item.is_boundary && !item.has_target
            && !item.has_owner && item.container == MachineContainer::Root
            && item.contract_count == 0 && item.component_count == 0 && item.clause_count == 0
            && item.statement_count > 0 {
            true -> result(lowerer, syntax, resolution, typing, index, item)
            _ -> unsupported(lowerer)
        }
    }
    machine result(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem) {
        let handle: u64 in Trapping = reference_type(typing, item.return_type);
        let valid: bool = scalar_byte_type(typing, handle);
        let first: u64 in Trapping = lowerer.output.operation_count;
        transition valid {
            true -> statements(lowerer, syntax, resolution, typing, index, item, 0, first)
            _ -> unsupported(lowerer)
        }
    }
    machine statements(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping, first: u64 in Trapping) {
        let statement: Statement = syntax_trees_statement(syntax, item.first_statement + offset);
        transition statement.kind {
            StatementKind::Let -> local(lowerer, syntax, resolution, typing, index, item, offset, first, statement)
            StatementKind::Tail -> terminal(lowerer, syntax, resolution, typing, index, item, offset, first, statement)
            _ -> unsupported(lowerer)
        }
    }
    machine local(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping, first: u64 in Trapping, statement: Statement) {
        transition !statement.is_mutable && statement.has_value && offset + 1 < item.statement_count {
            true -> local_type(lowerer, syntax, resolution, typing, index, item, offset, first, statement)
            _ -> unsupported(lowerer)
        }
    }
    machine local_type(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping, first: u64 in Trapping, statement: Statement) {
        let handle: u64 in Trapping = reference_type(typing, statement.type_reference);
        let valid: bool = scalar_byte_storage(typing, handle);
        transition valid {
            true -> initialize(lowerer, syntax, resolution, typing, index, item, offset, first, statement)
            _ -> unsupported(lowerer)
        }
    }
    machine initialize(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping, first: u64 in Trapping, statement: Statement) {
        scalar_expression(lowerer, syntax, resolution, typing, statement.value);
        transition lowerer.output.status {
            ScalarStatus::Complete -> bind(lowerer, syntax, resolution, typing, index, item, offset, first, statement)
            _ -> done()
        }
    }
    machine bind(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping, first: u64 in Trapping, statement: Statement) {
        let value: u64 in Trapping = scalar_value(lowerer, statement.value);
        scalar_bind(lowerer, item.first_statement + offset, value);
        transition { _ -> statements(lowerer, syntax, resolution, typing, index, item, offset + 1, first) }
    }
    machine terminal(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping, first: u64 in Trapping, statement: Statement) {
        transition offset + 1 == item.statement_count {
            true -> value(lowerer, syntax, resolution, typing, index, first, statement)
            _ -> unsupported(lowerer)
        }
    }
    machine value(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, first: u64 in Trapping, statement: Statement) {
        scalar_expression(lowerer, syntax, resolution, typing, statement.value);
        transition lowerer.output.status {
            ScalarStatus::Complete -> finish(lowerer, syntax, resolution, typing, index, first, statement)
            _ -> done()
        }
    }
    machine finish(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, first: u64 in Trapping, statement: Statement) {
        transition index < 10240 {
            true -> store(lowerer, syntax, resolution, typing, index, first, statement)
            _ -> unsupported(lowerer)
        }
    }
    machine store(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, first: u64 in Trapping, statement: Statement) {
        let result: u64 in Trapping = scalar_value(lowerer, statement.value);
        lowerer.output.machines[index] = ScalarMachine {
            first: first,
            count: lowerer.output.operation_count - first,
            result: result - 1
        };
        lowerer.output.machine_count = index + 1;
        transition { _ -> next(lowerer, syntax, resolution, typing, index + 1) }
    }
    machine acyclic(lowerer: &mut ScalarLowerer) { scalar_acyclic(lowerer); }
    machine unsupported(lowerer: &mut ScalarLowerer) { lowerer.output.status = ScalarStatus::Unsupported; }
    machine done() {}
}

// An explicit traversal stack preserves left-to-right evaluation without
// making source nesting consume the host language's native call stack.
machine scalar_expression(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, root: u64 in Trapping)
crashes Trap
{
    lowerer.work_count = 1;
    lowerer.work[0] = root;
    lowerer.ready[0] = false;
    transition { _ -> next(lowerer, syntax, resolution, typing) }
    machine next(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing) {
        let count: u64 in Trapping = lowerer.work_count;
        transition count > 0 && count <= 4096 {
            true -> node(lowerer, syntax, resolution, typing, count - 1)
            _ -> done()
        }
    }
    machine node(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, slot: u64 in Trapping) {
        let handle: u64 in Trapping = lowerer.work[slot] as u64 in Trapping;
        let expression: Expression = syntax_trees_expression(syntax, handle);
        transition lowerer.ready[slot] {
            true -> completed(lowerer, syntax, resolution, typing, handle, expression)
            _ -> classify(lowerer, syntax, resolution, typing, handle, expression)
        }
    }
    machine classify(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        let landed: bool = typing_landed_integer(typing, handle, expression);
        transition landed {
            true -> literal(lowerer, syntax, resolution, typing, handle)
            _ -> form(lowerer, syntax, resolution, typing, handle, expression)
        }
    }
    machine form(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        transition expression.kind {
            ExpressionKind::Integer -> literal(lowerer, syntax, resolution, typing, handle)
            ExpressionKind::Name -> local(lowerer, syntax, resolution, typing, handle)
            ExpressionKind::Call -> call(lowerer, syntax, resolution, typing, handle, expression)
            ExpressionKind::Binary -> children(lowerer, syntax, resolution, typing, expression)
            ExpressionKind::Cast -> cast(lowerer, syntax, resolution, typing, handle, expression)
            _ -> unsupported(lowerer)
        }
    }
    // Explicit anonymous landing has already typed its operand. Only a
    // checked identity conversion within this slice can disappear here.
    machine cast(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        let target: u64 in Trapping = typing_expression_type(typing, handle);
        let operand: u64 in Trapping = typing_expression_type(typing, expression.left);
        let supported: bool = scalar_byte_storage(typing, target) && scalar_byte_storage(typing, operand);
        transition supported {
            true -> cast_room(lowerer, syntax, resolution, typing, expression)
            _ -> unsupported(lowerer)
        }
    }
    machine cast_room(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression) {
        transition lowerer.work_count < 4096 {
            true -> cast_child(lowerer, syntax, resolution, typing, expression)
            _ -> full(lowerer)
        }
    }
    machine cast_child(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression) {
        lowerer.ready[lowerer.work_count - 1] = true;
        lowerer.work[lowerer.work_count] = expression.left;
        lowerer.ready[lowerer.work_count] = false;
        lowerer.work_count = lowerer.work_count + 1;
        transition { _ -> next(lowerer, syntax, resolution, typing) }
    }
    machine completed(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        transition expression.kind {
            ExpressionKind::Cast -> cast_value(lowerer, syntax, resolution, typing, handle, expression)
            _ -> binary(lowerer, syntax, resolution, typing, handle, expression)
        }
    }
    machine cast_value(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        let result: u64 in Trapping = scalar_value(lowerer, expression.left);
        transition { _ -> record(lowerer, syntax, resolution, typing, handle, result) }
    }
    machine literal(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping) {
        let value: ExactInteger = typing_value(typing, handle);
        let denominator: u64 in Trapping = typing_denominator(typing, handle);
        transition !value.negative && value.magnitude <= 255 && denominator <= 1 {
            true -> constant(lowerer, syntax, resolution, typing, handle, value.magnitude as u64 in Trapping)
            _ -> unsupported(lowerer)
        }
    }
    machine constant(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, value: u64 in Trapping) {
        let result: u64 in Trapping = scalar_append(lowerer, ScalarOperationKind::IntegerConstant, value, 0);
        transition { _ -> record(lowerer, syntax, resolution, typing, handle, result) }
    }
    machine local(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping) {
        let binding: ValueBinding = value_binding(resolution, handle);
        transition binding {
            ValueBinding::Local { statement } -> local_value(lowerer, syntax, resolution, typing, handle, statement)
            _ -> unsupported(lowerer)
        }
    }
    machine local_value(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, statement: u64 in Trapping) {
        let result: u64 in Trapping = scalar_local(lowerer, statement);
        transition { _ -> record(lowerer, syntax, resolution, typing, handle, result) }
    }
    machine call(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        transition expression.count == 0 {
            true -> selected(lowerer, syntax, resolution, typing, handle)
            _ -> unsupported(lowerer)
        }
    }
    machine selected(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping) {
        let selection: Selection = typing_selection(typing, handle);
        transition selection {
            Selection::Machine { handle as callee } -> invoke(lowerer, syntax, resolution, typing, handle, callee)
            _ -> unsupported(lowerer)
        }
    }
    machine invoke(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, callee: u64 in Trapping) {
        let result: u64 in Trapping = scalar_append(lowerer, ScalarOperationKind::Call, callee, 0);
        transition { _ -> record(lowerer, syntax, resolution, typing, handle, result) }
    }
    machine children(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression) {
        transition lowerer.work_count <= 4094 {
            true -> push(lowerer, syntax, resolution, typing, expression)
            _ -> full(lowerer)
        }
    }
    machine push(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, expression: Expression) {
        lowerer.ready[lowerer.work_count - 1] = true;
        lowerer.work[lowerer.work_count] = expression.right;
        lowerer.ready[lowerer.work_count] = false;
        lowerer.work[lowerer.work_count + 1] = expression.left;
        lowerer.ready[lowerer.work_count + 1] = false;
        lowerer.work_count = lowerer.work_count + 2;
        transition { _ -> next(lowerer, syntax, resolution, typing) }
    }
    machine binary(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        let result_type: u64 in Trapping = typing_expression_type(typing, handle);
        let valid: bool = scalar_byte_type(typing, result_type);
        transition valid {
            true -> builtin(lowerer, syntax, resolution, typing, handle, expression)
            _ -> unsupported(lowerer)
        }
    }
    machine builtin(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        let selection: Selection = typing_selection(typing, handle);
        transition selection {
            Selection::None -> operation(lowerer, syntax, resolution, typing, handle, expression)
            _ -> unsupported(lowerer)
        }
    }
    machine operation(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression) {
        transition expression.operator {
            OperatorKind::Add -> arithmetic(lowerer, syntax, resolution, typing, handle, expression, ScalarOperationKind::ExactIntegerAdd)
            OperatorKind::Subtract -> arithmetic(lowerer, syntax, resolution, typing, handle, expression, ScalarOperationKind::ExactIntegerSubtract)
            OperatorKind::Multiply -> arithmetic(lowerer, syntax, resolution, typing, handle, expression, ScalarOperationKind::ExactIntegerMultiply)
            OperatorKind::Divide -> arithmetic(lowerer, syntax, resolution, typing, handle, expression, ScalarOperationKind::ExactIntegerDivide)
            OperatorKind::Modulo -> arithmetic(lowerer, syntax, resolution, typing, handle, expression, ScalarOperationKind::ExactIntegerRemainder)
            _ -> unsupported(lowerer)
        }
    }
    machine arithmetic(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, expression: Expression, kind: ScalarOperationKind) {
        let left: u64 in Trapping = scalar_value(lowerer, expression.left);
        let right: u64 in Trapping = scalar_value(lowerer, expression.right);
        let result: u64 in Trapping = scalar_append(lowerer, kind, left - 1, right - 1);
        transition { _ -> record(lowerer, syntax, resolution, typing, handle, result) }
    }
    machine record(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, result: u64 in Trapping) {
        transition result > 0 && handle < 131072 {
            true -> store(lowerer, syntax, resolution, typing, handle, result)
            _ -> absent(lowerer)
        }
    }
    machine absent(lowerer: &mut ScalarLowerer) {
        transition lowerer.output.status {
            ScalarStatus::Complete -> unsupported(lowerer)
            _ -> done()
        }
    }
    machine store(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, handle: u64 in Trapping, result: u64 in Trapping) {
        lowerer.values[handle] = result;
        lowerer.work_count = lowerer.work_count - 1;
        transition { _ -> next(lowerer, syntax, resolution, typing) }
    }
    machine unsupported(lowerer: &mut ScalarLowerer) { lowerer.output.status = ScalarStatus::Unsupported; }
    machine full(lowerer: &mut ScalarLowerer) { lowerer.output.status = ScalarStatus::Capacity; }
    machine done() {}
}

// Runtime recursive cycles require proper tail transfer. Until that terminator
// is lowered, refuse every cycle instead of emitting frame-growing recursion.
// A linear DFS inspects each machine and call once; it is not a reachability
// matrix, and declaration order cannot change acceptance.
machine scalar_acyclic(lowerer: &mut ScalarLowerer)
crashes Trap
{
    lowerer.call_count = 0;
    transition { _ -> clear(lowerer, 0) }
    machine clear(lowerer: &mut ScalarLowerer, index: u64 in Trapping) {
        transition index < lowerer.output.machine_count && index < 10240 {
            true -> reset(lowerer, index)
            _ -> select_root(lowerer, 0)
        }
    }
    machine reset(lowerer: &mut ScalarLowerer, index: u64 in Trapping) {
        lowerer.colors[index] = 0;
        transition { _ -> clear(lowerer, index + 1) }
    }
    machine select_root(lowerer: &mut ScalarLowerer, index: u64 in Trapping) {
        transition index < lowerer.output.machine_count && index < 10240 {
            true -> color(lowerer, index)
            _ -> done()
        }
    }
    machine color(lowerer: &mut ScalarLowerer, index: u64 in Trapping) {
        transition lowerer.colors[index] == 0 {
            true -> push(lowerer, index, index)
            _ -> select_root(lowerer, index + 1)
        }
    }
    machine push(lowerer: &mut ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        transition lowerer.call_count < 10240 && callee < 10240 {
            true -> pushed(lowerer, root, callee)
            _ -> unsupported(lowerer)
        }
    }
    machine pushed(lowerer: &mut ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        lowerer.calls[lowerer.call_count] = callee;
        lowerer.call_count = lowerer.call_count + 1;
        lowerer.colors[callee] = 1;
        lowerer.cursors[callee] = 0;
        transition { _ -> walk(lowerer, root) }
    }
    machine walk(lowerer: &mut ScalarLowerer, root: u64 in Trapping) {
        transition lowerer.call_count > 0 && lowerer.call_count <= 10240 {
            true -> top(lowerer, root)
            _ -> select_root(lowerer, root + 1)
        }
    }
    machine top(lowerer: &mut ScalarLowerer, root: u64 in Trapping) {
        let handle: u64 in Trapping = lowerer.calls[lowerer.call_count - 1] as u64 in Trapping;
        transition handle < 10240 {
            true -> body(lowerer, root, handle)
            _ -> unsupported(lowerer)
        }
    }
    machine body(lowerer: &mut ScalarLowerer, root: u64 in Trapping, handle: u64 in Trapping) {
        let body: ScalarMachine = scalar_machine_at(&lowerer.output, handle);
        let offset: u64 in Trapping = lowerer.cursors[handle] as u64 in Trapping;
        transition offset < body.count {
            true -> operation(lowerer, root, handle, body.first + offset, offset)
            _ -> pop(lowerer, root, handle)
        }
    }
    machine operation(lowerer: &mut ScalarLowerer, root: u64 in Trapping, handle: u64 in Trapping, index: u64 in Trapping, offset: u64 in Trapping) {
        let operation: ScalarOperation = scalar_operation(&lowerer.output, index);
        lowerer.cursors[handle] = offset + 1;
        transition operation.kind {
            ScalarOperationKind::Call -> callee(lowerer, root, operation.left)
            _ -> walk(lowerer, root)
        }
    }
    machine callee(lowerer: &mut ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        transition callee < lowerer.output.machine_count && callee < 10240 {
            true -> visit(lowerer, root, callee)
            _ -> unsupported(lowerer)
        }
    }
    machine visit(lowerer: &mut ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        transition lowerer.colors[callee] {
            0 -> push(lowerer, root, callee)
            1 -> unsupported(lowerer)
            _ -> walk(lowerer, root)
        }
    }
    machine pop(lowerer: &mut ScalarLowerer, root: u64 in Trapping, handle: u64 in Trapping) {
        lowerer.colors[handle] = 2;
        lowerer.call_count = lowerer.call_count - 1;
        transition { _ -> walk(lowerer, root) }
    }
    machine unsupported(lowerer: &mut ScalarLowerer) { lowerer.output.status = ScalarStatus::Unsupported; }
    machine done() {}
}
