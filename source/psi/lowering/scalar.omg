// A closed in-process lowering slice with scalar values and owned storage.
// Value identity is its operation index, type identity indexes the shared
// layout table, and callee/field identities retain checked declarations.
// Memory, calls and control have the ordinary meanings described in
// wiki/spec/terminal-psi/{structural_access,calls_and_outcomes}.md.
// The consumer needs neither syntax nor source bytes. Full portable publication
// must additionally retain canonical declaration/contract/obligation identities;
// checker acceptance and counts cannot substitute for those records.
public data ScalarOperationKind [copy] {
    case IntegerConstant;
    case ExactIntegerAdd;
    case ExactIntegerSubtract;
    case ExactIntegerMultiply;
    case ExactIntegerDivide;
    case ExactIntegerRemainder;
    case Call;
    case FrameAddress;
    case AddressOffset;
    case AddressIndex;
    case Load;
    case Store;
    case Copy;
    case Zero;
    case IntegerEqual;
    case UnsignedLess;
    case BooleanNot;
    case BranchZero;
    case BranchNonzero;
    case Label;
    case ReturnValue;
    case ReturnUnit;
    case Trap;
}

public data ScalarOperation [copy] {
    kind: ScalarOperationKind;
    left: u64 in Trapping;
    right: u64 in Trapping;
    // Memory width/stride or call argument count, according to kind.
    extra: u64 in Trapping;
}

public data ScalarMachine [copy] {
    first: u64 in Trapping;
    count: u64 in Trapping;
    storage_size: u64 in Trapping;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    argument_capacity: u64 in Trapping;
}

public data ScalarParameter [copy] {
    offset: u64 in Trapping;
    type_handle: u64 in Trapping;
}

public data ScalarExpressionStage [copy] {
    case Ready;
    case ShortCircuitLeft;
    case ShortCircuitRight;
}

public data ScalarStatus [copy] {
    case Complete;
    case Unchecked;
    case Unsupported;
    case Capacity;
}

public data ScalarProgram {
    // Layout identity is the checked type handle. Offsets name declared
    // fields, never source spellings; all memory consumers share this table.
    layouts: [ScalarLayout; 8192];
    layout_count: u64;
    field_offsets: [u64; 1024];
    parameters: [ScalarParameter; 32768];
    parameter_count: u64;
    arguments: [u64; 65536];
    argument_count: u64 in Trapping;
    operations: [ScalarOperation; 16384];
    operation_count: u64 in Trapping;
    machines: [ScalarMachine; 10240];
    machine_count: u64 in Trapping;
    entry: u64 in Trapping;
    status: ScalarStatus;
}

public data ScalarLowerer {
    output: ScalarProgram;
    layout_states: [ScalarLayoutState; 8192];
    layout_work: [u64; 8192];
    layout_cursors: [u64; 8192];
    layout_sizes: [u64; 8192];
    layout_work_count: u64 in Trapping;
    storage_size: u64 in Trapping;
    argument_capacity: u64 in Trapping;
    current_machine: u64 in Trapping;
    // Handles are one-based so absence cannot accidentally name operation 0.
    values: [u64 in Trapping; 131072];
    locals: [u64 in Trapping; 16384];
    work: [u64 in Trapping; 4096];
    ready: [bool; 4096];
    place_mode: [bool; 4096];
    stages: [ScalarExpressionStage; 4096];
    pending: [u64; 4096];
    temporaries: [u64; 4096];
    work_count: u64 in Trapping;
    colors: [u8; 10240];
    cursors: [u64 in Trapping; 10240];
    calls: [u64 in Trapping; 10240];
    call_count: u64 in Trapping;
}

public machine scalar_operation(program: &ScalarProgram, index: u64 in Trapping) -> ScalarOperation
crashes Trap
{
    transition index < program.operation_count && index < 16384 {
        true -> read(program, index)
        _ -> invalid()
    }
    machine read(program: &ScalarProgram, index: u64 in Trapping) -> ScalarOperation { program.operations[(index) as -Trapping] }
    machine invalid() -> ScalarOperation { crash Trap; }
}

public machine scalar_machine_at(program: &ScalarProgram, index: u64 in Trapping) -> ScalarMachine
crashes Trap
{
    transition index < program.machine_count && index < 10240 {
        true -> read(program, index)
        _ -> invalid()
    }
    machine read(program: &ScalarProgram, index: u64 in Trapping) -> ScalarMachine { program.machines[(index) as -Trapping] }
    machine invalid() -> ScalarMachine { crash Trap; }
}

public machine scalar_parameter_at(program: &ScalarProgram, index: u64 in Trapping) -> ScalarParameter
crashes Trap
{
    transition index < program.parameter_count && index < 32768 {
        true -> read(program, index)
        _ -> invalid()
    }
    machine read(program: &ScalarProgram, index: u64 in Trapping) -> ScalarParameter { program.parameters[index as -Trapping] }
    machine invalid() -> ScalarParameter { crash Trap; }
}

public machine scalar_argument_at(program: &ScalarProgram, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < program.argument_count && index < 65536 {
        true -> read(program, index)
        _ -> invalid()
    }
    machine read(program: &ScalarProgram, index: u64 in Trapping) -> u64 in Trapping {
        program.arguments[index as -Trapping] as u64 +Trapping
    }
    machine invalid() -> u64 in Trapping { crash Trap; }
}

public machine scalar_append(lowerer: &mut ScalarLowerer, kind: ScalarOperationKind, left: u64 in Trapping, right: u64 in Trapping, extra: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let index: u64 in Trapping = lowerer.output.operation_count;
    transition index < 16384 {
        true -> store(lowerer, kind, left, right, extra, index)
        _ -> full(lowerer)
    }
    machine store(lowerer: &mut ScalarLowerer, kind: ScalarOperationKind, left: u64 in Trapping, right: u64 in Trapping, extra: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        lowerer.output.operations[(index) as -Trapping] = ScalarOperation { kind: kind, left: left, right: right, extra: extra };
        lowerer.output.operation_count = index + 1;
        index + 1
    }
    machine full(lowerer: &mut ScalarLowerer) -> u64 in Trapping {
        lowerer.output.status = ScalarStatus::Capacity;
        0 as u64 +Trapping
    }
}

// Syntax handles are checked again at the storage boundary. Producer
// invariants must not become unchecked physical array accesses.
public machine scalar_value(lowerer: &ScalarLowerer, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition handle < 131072 {
        true -> read(lowerer, handle)
        _ -> invalid()
    }
    machine read(lowerer: &ScalarLowerer, handle: u64 in Trapping) -> u64 in Trapping {
        lowerer.values[(handle) as -Trapping]
    }
    machine invalid() -> u64 in Trapping { crash Trap; }
}

public machine scalar_local(lowerer: &ScalarLowerer, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition handle < 16384 {
        true -> read(lowerer, handle)
        _ -> invalid()
    }
    machine read(lowerer: &ScalarLowerer, handle: u64 in Trapping) -> u64 in Trapping {
        lowerer.locals[(handle) as -Trapping]
    }
    machine invalid() -> u64 in Trapping { crash Trap; }
}

public machine scalar_bind(lowerer: &mut ScalarLowerer, handle: u64 in Trapping, value: u64 in Trapping)
crashes Trap
{
    transition handle < 16384 {
        true -> write(lowerer, handle, value)
        _ -> invalid()
    }
    machine write(lowerer: &mut ScalarLowerer, handle: u64 in Trapping, value: u64 in Trapping) {
        lowerer.locals[(handle) as -Trapping] = value;
    }
    machine invalid() { crash Trap; }
}

// Only ordinary u8 is admitted. Wrapping, saturating and trapping policies
// need their own operations and cannot be silently erased by this slice.
machine scalar_byte_type(typing: &Typing, handle: u64 in Trapping) -> bool
crashes Trap
{
    let row: TypeRow = type_table_row(&typing.types, handle);
    transition row.kind {
        TypeKind::Builtin -> builtin(row)
        _ -> no()
    }
    machine builtin(row: TypeRow) -> bool {
        transition row.builtin {
            BuiltinType::U8 -> policy(row)
            _ -> no()
        }
    }
    machine policy(row: TypeRow) -> bool {
        transition row.domain { DomainBinding::Unqualified -> yes() _ -> no() }
    }
    machine yes() -> bool { true }
    machine no() -> bool { false }
}

// The synthetic entry has no caller-provided arguments or premises. Other
// machines retain independent parameter storage and ordinary checked calls.
public machine scalar_lower(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, checks: &Checks, entry: u64 in Trapping)
crashes Trap
{
    lowerer.output.operation_count = 0 as u64 +Trapping;
    lowerer.output.machine_count = 0 as u64 +Trapping;
    lowerer.output.argument_count = 0 as u64 +Trapping;
    lowerer.output.parameter_count = syntax.parameter_count;
    lowerer.output.entry = entry;
    lowerer.output.status = ScalarStatus::Unchecked;
    transition syntax.accepted && resolution.accepted && typing.accepted && checks.accepted {
        true -> select(lowerer, syntax, resolution, typing, entry)
        _ -> done()
    }
    machine select(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, entry: u64 in Trapping) {
        lowerer.output.status = ScalarStatus::Unsupported;
        transition entry < syntax.machine_count && syntax.machine_count <= 10240
            && syntax.erased_binding_count == 0 && syntax.parameter_count <= 32768 {
            true -> entry_root(lowerer, syntax, resolution, typing, entry)
            _ -> done()
        }
    }
    machine entry_root(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, entry: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, entry);
        transition item.parent == 0 && item.parameter_count == 0 && item.has_return_type
            && item.clause_count == 0 && !item.has_owner && item.container == MachineContainer::Root {
            true -> entry_result(lowerer, syntax, resolution, typing, item)
            _ -> done()
        }
    }
    machine entry_result(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, item: MachineItem) {
        let handle: u64 in Trapping = reference_type(typing, item.return_type);
        let supported: bool = scalar_byte_type(typing, handle);
        transition supported {
            true -> begin(lowerer, syntax, resolution, typing)
            _ -> done()
        }
    }
    machine begin(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing) {
        lowerer.output.status = ScalarStatus::Complete;
        scalar_layout_clear(lowerer, typing);
        transition { _ -> roots(lowerer, syntax, resolution, typing, 0 as u64 +Trapping) }
    }
    machine roots(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        transition index < syntax.root_count && lowerer.output.status == ScalarStatus::Complete {
            true -> root(lowerer, syntax, resolution, typing, index)
            _ -> machines(lowerer, syntax, resolution, typing, 0 as u64 +Trapping)
        }
    }
    machine root(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        let item: RootItem = root_item(syntax, index);
        transition item.kind {
            RootItemKind::Machine -> roots(lowerer, syntax, resolution, typing, index + 1)
            RootItemKind::Data -> data_root(lowerer, syntax, resolution, typing, index, item)
            _ -> unsupported(lowerer)
        }
    }
    machine data_root(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, root: RootItem) {
        let item: DataItem = syntax_trees_data_item(syntax, root.item_index);
        transition item.generic_parameter_count == 0 && item.case_count == 0 && !item.is_boundary
            && item.multiplicity != DataMultiplicity::Linear {
            true -> roots(lowerer, syntax, resolution, typing, index + 1)
            _ -> unsupported(lowerer)
        }
    }
    machine machines(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        transition lowerer.output.status {
            ScalarStatus::Complete -> next(lowerer, syntax, resolution, typing, index)
            _ -> done()
        }
    }
    machine next(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> body(lowerer, syntax, resolution, typing, index)
            _ -> acyclic(lowerer)
        }
    }
    machine body(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, index);
        transition item.has_body && item.generic_parameter_count == 0 && !item.is_boundary && !item.has_target
            && !item.has_owner && item.container == MachineContainer::Root
            && item.contract_count == 0 && item.component_count == 0 && item.clause_count == 0 {
            true -> result(lowerer, syntax, resolution, typing, index, item)
            _ -> unsupported(lowerer)
        }
    }
    machine result(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem) {
        let handle: u64 in Trapping = scalar_result_type(typing, item);
        scalar_require_layout(lowerer, syntax, typing, handle);
        transition lowerer.output.status {
            ScalarStatus::Complete -> result_layout(lowerer, syntax, resolution, typing, index, item, handle)
            _ -> done()
        }
    }
    machine result_layout(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, handle: u64 in Trapping) {
        let layout: ScalarLayout = scalar_layout_at(&lowerer.output, handle);
        transition layout.kind == ScalarLayoutKind::Scalar || layout.kind == ScalarLayoutKind::Unit {
            true -> parameters(lowerer, syntax, resolution, typing, index, item)
            _ -> unsupported(lowerer)
        }
    }
    machine parameters(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem) {
        lowerer.storage_size = 0 as u64 +Trapping;
        lowerer.argument_capacity = 0 as u64 +Trapping;
        lowerer.current_machine = index;
        scalar_parameters(lowerer, syntax, typing, item);
        transition lowerer.output.status {
            ScalarStatus::Complete -> statements(lowerer, syntax, resolution, typing, index, item)
            _ -> done()
        }
    }
    machine statements(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem) {
        let first: u64 in Trapping = lowerer.output.operation_count;
        scalar_statements(lowerer, syntax, resolution, typing, item);
        transition lowerer.output.status {
            ScalarStatus::Complete -> store(lowerer, syntax, resolution, typing, index, item, first)
            _ -> done()
        }
    }
    machine store(lowerer: &mut ScalarLowerer, syntax: &SyntaxTrees, resolution: &NameResolution, typing: &Typing, index: u64 in Trapping, item: MachineItem, first: u64 in Trapping) {
        lowerer.output.machines[index as -Trapping] = ScalarMachine {
            first: first, count: lowerer.output.operation_count - first,
            storage_size: lowerer.storage_size,
            first_parameter: item.first_parameter, parameter_count: item.parameter_count,
            argument_capacity: lowerer.argument_capacity
        };
        lowerer.output.machine_count = index + 1;
        transition { _ -> machines(lowerer, syntax, resolution, typing, index + 1) }
    }
    machine acyclic(lowerer: &mut ScalarLowerer) { scalar_acyclic(lowerer); }
    machine unsupported(lowerer: &mut ScalarLowerer) { lowerer.output.status = ScalarStatus::Unsupported; }
    machine done() {}
}

public machine scalar_result_type(typing: &Typing, item: MachineItem) -> u64 in Trapping
crashes Trap
{
    transition item.has_return_type {
        true -> declared(typing, item.return_type)
        _ -> unit(typing)
    }
    machine declared(typing: &Typing, reference: u64 in Trapping) -> u64 in Trapping { reference_type(typing, reference) }
    machine unit(typing: &Typing) -> u64 in Trapping { typing.unit }
}

// Runtime recursive cycles require proper tail transfer. Until that terminator
// is lowered, refuse every cycle instead of emitting frame-growing recursion.
// A linear DFS inspects each machine and call once; it is not a reachability
// matrix, and declaration order cannot change acceptance.
machine scalar_acyclic(lowerer: &mut ScalarLowerer)
crashes Trap
{
    lowerer.call_count = 0 as u64 +Trapping;
    transition { _ -> clear(lowerer, 0 as u64 +Trapping) }
    machine clear(lowerer: &mut ScalarLowerer, index: u64 in Trapping) {
        transition index < lowerer.output.machine_count && index < 10240 {
            true -> reset(lowerer, index)
            _ -> select_root(lowerer, 0 as u64 +Trapping)
        }
    }
    machine reset(lowerer: &mut ScalarLowerer, index: u64 in Trapping) {
        lowerer.colors[(index) as -Trapping] = 0;
        transition { _ -> clear(lowerer, index + 1) }
    }
    machine select_root(lowerer: &mut ScalarLowerer, index: u64 in Trapping) {
        transition index < lowerer.output.machine_count && index < 10240 {
            true -> color(lowerer, index)
            _ -> done()
        }
    }
    machine color(lowerer: &mut ScalarLowerer, index: u64 in Trapping) {
        transition lowerer.colors[(index) as -Trapping] == 0 {
            true -> push(lowerer, index, index)
            _ -> select_root(lowerer, index + 1)
        }
    }
    machine push(lowerer: &mut ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        transition lowerer.call_count < 10240 && callee < 10240 {
            true -> pushed(lowerer, root, callee)
            _ -> unsupported(lowerer)
        }
    }
    machine pushed(lowerer: &mut ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        lowerer.calls[(lowerer.call_count) as -Trapping] = callee;
        lowerer.call_count = lowerer.call_count + 1;
        lowerer.colors[(callee) as -Trapping] = 1;
        lowerer.cursors[(callee) as -Trapping] = 0 as u64 +Trapping;
        transition { _ -> walk(lowerer, root) }
    }
    machine walk(lowerer: &mut ScalarLowerer, root: u64 in Trapping) {
        transition lowerer.call_count > 0 && lowerer.call_count <= 10240 {
            true -> top(lowerer, root)
            _ -> select_root(lowerer, root + 1)
        }
    }
    machine top(lowerer: &mut ScalarLowerer, root: u64 in Trapping) {
        let handle: u64 in Trapping = lowerer.calls[(lowerer.call_count - 1) as -Trapping];
        transition handle < 10240 {
            true -> body(lowerer, root, handle)
            _ -> unsupported(lowerer)
        }
    }
    machine body(lowerer: &mut ScalarLowerer, root: u64 in Trapping, handle: u64 in Trapping) {
        let body: ScalarMachine = scalar_machine_at(&lowerer.output, handle);
        let offset: u64 in Trapping = lowerer.cursors[(handle) as -Trapping];
        transition offset < body.count {
            true -> operation(lowerer, root, handle, body.first + offset, offset)
            _ -> pop(lowerer, root, handle)
        }
    }
    machine operation(lowerer: &mut ScalarLowerer, root: u64 in Trapping, handle: u64 in Trapping, index: u64 in Trapping, offset: u64 in Trapping) {
        let operation: ScalarOperation = scalar_operation(&lowerer.output, index);
        lowerer.cursors[(handle) as -Trapping] = offset + 1;
        transition operation.kind {
            ScalarOperationKind::Call -> callee(lowerer, root, operation.left)
            _ -> walk(lowerer, root)
        }
    }
    machine callee(lowerer: &mut ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        transition callee < lowerer.output.machine_count && callee < 10240 {
            true -> visit(lowerer, root, callee)
            _ -> unsupported(lowerer)
        }
    }
    machine visit(lowerer: &mut ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        transition lowerer.colors[(callee) as -Trapping] {
            0 -> push(lowerer, root, callee)
            1 -> unsupported(lowerer)
            _ -> walk(lowerer, root)
        }
    }
    machine pop(lowerer: &mut ScalarLowerer, root: u64 in Trapping, handle: u64 in Trapping) {
        lowerer.colors[(handle) as -Trapping] = 2;
        lowerer.call_count = lowerer.call_count - 1;
        transition { _ -> walk(lowerer, root) }
    }
    machine unsupported(lowerer: &mut ScalarLowerer) { lowerer.output.status = ScalarStatus::Unsupported; }
    machine done() {}
}
