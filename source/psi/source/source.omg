// Product Psi source custody for the current hosted compiler slice.
//
// Source coordinates are byte offsets. UTF-8 validation belongs at the
// source-unit boundary; the lexer never repairs invalid input or substitutes
// host paths for authored source identity.

pub data SourceId [copy] {
    value: u32 in Trapping;
}

pub data Span [copy] {
    start: u64 in Trapping;
    end: u64 in Trapping;
}

pub data SourceSpan [copy] {
    source: SourceId;
    span: Span;
}

pub data SourceUnit {
    id: SourceId;
    bytes: [u8; 65536] in Trapping;
    length: u64 [0..=65536];
    last_retained: bool;
}

machine SourceUnit::clear(&mut self, id: SourceId) {
    self.id = id;
    self.length = 0;
    self.last_retained = true;
}

machine SourceUnit::append(&mut self, byte: u8) {
    self.last_retained = false;
    transition self.length < 65536 {
        true -> retain()
        _ -> full()
    }

    state retain(&mut self) {
        self.bytes[self.length] = byte;
        self.length = self.length + 1;
        self.last_retained = true;
    }

    state full(&mut self) {
        self.last_retained = false;
    }
}

// Centralize the backing-array proof. Lexer callers establish their stronger
// lexical bounds before reading; the NUL fallback makes a violated internal
// coordinate fail token recognition instead of performing an unchecked read.
machine SourceUnit::byte_or_nul(&self, index: u64 in Trapping) -> u8 {
    transition index < self.length {
        true -> retain()
        _ -> absent()
    }

    state retain(&self) {
        self.bytes[index]
    }

    state absent(&self) {
        0
    }
}
