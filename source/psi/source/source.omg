// Product Psi source custody for the current hosted compiler slice.
//
// Source coordinates are byte offsets. UTF-8 validation belongs at the
// source-unit boundary; the lexer never repairs invalid input or substitutes
// host paths for authored source identity.

pub data SourceId [copy] {
    value: u32 in Trapping;
}

pub data Span [copy] {
    start: u64 in Trapping;
    end: u64 in Trapping;
}

pub data SourceSpan [copy] {
    source: SourceId;
    span: Span;
}

pub data SourceUnit
where
    length <= 65536,
{
    id: SourceId;
    bytes: [u8; 65536] in Trapping;
    length: u64;
    last_retained: bool;
}

machine SourceUnit::clear(source_unit: &mut SourceUnit, id: SourceId) {
    source_unit.id = id;
    source_unit.length = 0;
    source_unit.last_retained = true;
}

machine SourceUnit::append(source_unit: &mut SourceUnit, byte: u8) {
    source_unit.last_retained = false;
    transition source_unit.length < 65536 {
        true -> retain(source_unit, byte)
        _ -> full(source_unit)
    }

    state retain(source_unit: &mut SourceUnit, byte: u8) {
        source_unit.bytes[source_unit.length] = byte;
        source_unit.length = source_unit.length + 1;
        source_unit.last_retained = true;
    }

    state full(source_unit: &mut SourceUnit) {
        source_unit.last_retained = false;
    }
}

// Centralize the backing-array proof. Lexer callers establish their stronger
// lexical bounds before reading; the NUL fallback makes a violated internal
// coordinate fail token recognition instead of performing an unchecked read.
// The forwarded coordinate is proven against the array's own length: the
// `length` range does not transport through the retained-length comparison.
machine SourceUnit::byte_or_nul(source_unit: &SourceUnit, index: u64 in Trapping) -> u8 {
    transition index < source_unit.length {
        true -> retain(source_unit, index)
        _ -> absent()
    }

    state retain(source_unit: &SourceUnit, index: u64 in Trapping) {
        transition index < 65536 {
            true -> read(source_unit, index)
            _ -> absent()
        }
    }

    state read(source_unit: &SourceUnit, index: u64 in Trapping) {
        // `bytes` is `[u8; 65536] in Trapping`, so the element read carries
        // the array's policy while this machine results in a plain `u8`.
        source_unit.bytes[index] as u8
    }

    state absent() {
        0
    }
}

// Whether two spans of this unit spell the same bytes. Identifier spellings
// are their source bytes under LEXICAL-PROFILE-V1 (no escapes), so name
// comparison reads the unit rather than a decoded copy.
machine SourceUnit::spans_equal(source_unit: &SourceUnit, left: Span, right: Span) -> bool {
    transition left.end - left.start == right.end - right.start {
        true -> scan(source_unit, left.start, right.start, left.end)
        _ -> different()
    }

    state scan(
        source_unit: &SourceUnit,
        left_cursor: u64 in Trapping,
        right_cursor: u64 in Trapping,
        left_end: u64 in Trapping
    ) {
        transition left_cursor < left_end {
            true -> compare(source_unit, left_cursor, right_cursor, left_end)
            _ -> same()
        }
    }

    state compare(
        source_unit: &SourceUnit,
        left_cursor: u64 in Trapping,
        right_cursor: u64 in Trapping,
        left_end: u64 in Trapping
    ) {
        let left_byte: u8 = SourceUnit::byte_or_nul(source_unit, left_cursor);
        let right_byte: u8 = SourceUnit::byte_or_nul(source_unit, right_cursor);
        transition left_byte == right_byte {
            true -> scan(source_unit, left_cursor + 1, right_cursor + 1, left_end)
            _ -> different()
        }
    }

    state same() {
        true
    }

    state different() {
        false
    }
}

// Whether a span of this unit spells exactly `spelling`.
machine SourceUnit::span_spells(source_unit: &SourceUnit, span: Span, spelling: &[u8]) -> bool {
    transition span.end - span.start == spelling.len {
        true -> scan(source_unit, span.start, spelling, 0)
        _ -> different()
    }

    state scan(source_unit: &SourceUnit, cursor: u64 in Trapping, spelling: &[u8], index: u64 in Trapping) {
        transition index < spelling.len {
            true -> compare(source_unit, cursor, spelling, index)
            _ -> same()
        }
    }

    state compare(source_unit: &SourceUnit, cursor: u64 in Trapping, spelling: &[u8], index: u64 in Trapping) {
        let source_byte: u8 = SourceUnit::byte_or_nul(source_unit, cursor);
        let spelling_byte: u8 = spelling[index];
        transition source_byte == spelling_byte {
            true -> scan(source_unit, cursor + 1, spelling, index + 1)
            _ -> different()
        }
    }

    state same() {
        true
    }

    state different() {
        false
    }
}
