// Product Psi source custody for the current hosted compiler slice.
//
// Source coordinates are byte offsets. UTF-8 validation belongs at the
// source-unit boundary; the lexer never repairs invalid input or substitutes
// host paths for authored source identity.

pub data SourceId [copy] {
    value: u32 in Trapping;
}

pub data Span [copy] {
    start: u64 in Trapping;
    end: u64 in Trapping;
}

pub data SourceSpan [copy] {
    source: SourceId;
    span: Span;
}

pub data SourceUnit
where
    length <= 131072,
{
    id: SourceId;
    bytes: [u8; 131072] in Trapping;
    length: u64;
    last_retained: bool;
}

machine SourceUnit::clear(source_unit: &mut SourceUnit, id: SourceId) {
    source_unit.id = id;
    source_unit.length = 0;
    source_unit.last_retained = true;
}

machine SourceUnit::append(source_unit: &mut SourceUnit, byte: u8) {
    source_unit.last_retained = false;
    transition source_unit.length < 131072 {
        true -> retain(source_unit, byte)
        _ -> full(source_unit)
    }

    state retain(source_unit: &mut SourceUnit, byte: u8) {
        source_unit.bytes[source_unit.length] = byte as u8 in Trapping;
        source_unit.length = source_unit.length + 1;
        source_unit.last_retained = true;
    }

    state full(source_unit: &mut SourceUnit) {
        source_unit.last_retained = false;
    }
}

// Centralize the backing-array proof. Lexer callers establish their stronger
// lexical bounds before reading; the NUL fallback makes a violated internal
// coordinate fail token recognition instead of performing an unchecked read.
// The forwarded coordinate is proven against the array's own length: the
// `length` range does not transport through the retained-length comparison.
machine SourceUnit::byte_or_nul(source_unit: &SourceUnit, index: u64 in Trapping) -> u8 {
    transition index < source_unit.length {
        true -> retain(source_unit, index)
        _ -> absent()
    }

    state retain(source_unit: &SourceUnit, index: u64 in Trapping) {
        transition index < 131072 {
            true -> read(source_unit, index)
            _ -> absent()
        }
    }

    state read(source_unit: &SourceUnit, index: u64 in Trapping) {
        // `bytes` is `[u8; 131072] in Trapping`, so the element read carries
        // the array's policy while this machine results in a plain `u8`.
        source_unit.bytes[index] as u8
    }

    state absent() {
        0
    }
}

// A logical name path as the compilation names it, `a::b::c`: the path of a
// module within its package, by which a source unit belongs to its module
// and `use` selects modules, or a one-segment package name or dependency
// alias.
pub data ModulePath
where
    length <= 256,
{
    bytes: [u8; 256] in Trapping;
    length: u64;
}

pub machine ModulePath::clear(module_path: &mut ModulePath) {
    module_path.length = 0;
}

// Append one byte; the path's provision is exhausted when it reports false.
pub machine ModulePath::append(module_path: &mut ModulePath, byte: u8) -> bool {
    transition module_path.length < 256 {
        true -> retain(module_path, byte)
        _ -> full()
    }

    state retain(module_path: &mut ModulePath, byte: u8) -> bool {
        module_path.bytes[module_path.length] = byte as u8 in Trapping;
        module_path.length = module_path.length + 1;
        true
    }

    state full() -> bool {
        false
    }
}

pub data SourceRange [copy] {
    start: u64 in Trapping;
    length: u64 in Trapping;
}

// A package of one compilation (wiki/spec/build/compiler_request.md): its
// declared name, a range of the path arena, or the toolchain's core package,
// which carries no name and which every package selects through the
// language's mount `omega::language::core` rather than by a dependency
// alias (wiki/spec/packages/toolchain.md).
pub data PackageRow [copy] {
    name: SourceRange;
    toolchain: bool;
}

// Which checked context a dependency edge authorizes: ordinary product
// imports, or the build entry's and its local helpers' imports. An alias of
// one scope never stands in for the other.
pub data DependencyScope [copy] {
    case Product;
    case Build;
}

// A requester-local dependency edge, as the request's edge rows give it:
// within package `requester`'s `scope` imports, `alias` (a range of the path
// arena) names package `target`.
pub data DependencyRow [copy] {
    requester: u64 in Trapping;
    scope: DependencyScope;
    alias: SourceRange;
    target: u64 in Trapping;
}

// Every source unit of one compilation, with the package and the module
// within it each belongs to, and the packages' requester-local dependency
// edges. A unit's `SourceId` is its position, so a `SourceSpan` names its
// bytes wherever the span is stored, and spans of different units compare
// through the set. Units, module paths, package names and aliases share
// bounded arenas; the request's graph validation, not this set, rejects
// duplicate aliases of one requester and scope.
pub data SourceSet
where
    unit_count <= 128,
    byte_count <= 4194304,
    path_byte_count <= 16384,
    package_count <= 64,
    dependency_count <= 256,
{
    bytes: [u8; 4194304] in Trapping;
    byte_count: u64;
    path_bytes: [u8; 16384] in Trapping;
    path_byte_count: u64;
    units: [SourceRange; 128] in Trapping;
    paths: [SourceRange; 128] in Trapping;
    unit_packages: [u64; 128] in Trapping;
    unit_count: u64;
    packages: [PackageRow; 64] in Trapping;
    package_count: u64;
    dependencies: [DependencyRow; 256] in Trapping;
    dependency_count: u64;
}

pub machine SourceSet::clear(sources: &mut SourceSet) {
    sources.byte_count = 0;
    sources.path_byte_count = 0;
    sources.unit_count = 0;
    sources.package_count = 0;
    sources.dependency_count = 0;
}

// Add a unit of package `package` as the next `SourceId`, or report false
// when the package is not in the set or the set's provisions cannot hold
// the unit.
pub machine SourceSet::add(
    sources: &mut SourceSet,
    unit: &SourceUnit,
    package: u64 in Trapping,
    module_path: &ModulePath
) -> bool
crashes Trap
{
    transition sources.unit_count < 128
        && package < sources.package_count
        && unit.length <= 4194304 - sources.byte_count
        && module_path.length <= 16384 - sources.path_byte_count {
        true -> path(sources, unit, package, module_path)
        _ -> full()
    }

    state path(sources: &mut SourceSet, unit: &SourceUnit, package: u64 in Trapping, module_path: &ModulePath) -> bool {
        let path: SourceRange = SourceSet::store_name(sources, module_path);
        transition { _ -> bytes(sources, unit, package, path, 0) }
    }

    state bytes(sources: &mut SourceSet, unit: &SourceUnit, package: u64 in Trapping, path: SourceRange, index: u64 in Trapping) -> bool {
        transition index < unit.length {
            true -> unit_byte(sources, unit, package, path, index)
            _ -> record(sources, unit, package, path)
        }
    }

    state unit_byte(sources: &mut SourceSet, unit: &SourceUnit, package: u64 in Trapping, path: SourceRange, index: u64 in Trapping) -> bool {
        let at: u64 in Trapping = (sources.byte_count as u64 in Trapping) + index;
        let byte: u8 = SourceUnit::byte_or_nul(unit, index);
        transition at < 4194304 {
            true -> store_unit_byte(sources, unit, package, path, index, at, byte)
            _ -> invalid()
        }
    }

    state store_unit_byte(
        sources: &mut SourceSet,
        unit: &SourceUnit,
        package: u64 in Trapping,
        path: SourceRange,
        index: u64 in Trapping,
        at: u64 in Trapping,
        byte: u8
    ) -> bool {
        sources.bytes[at] = byte as u8 in Trapping;
        transition { _ -> bytes(sources, unit, package, path, index + 1) }
    }

    // The unit's bytes begin where the arena ended before it.
    state record(sources: &mut SourceSet, unit: &SourceUnit, package: u64 in Trapping, path: SourceRange) -> bool {
        let unit_count: u64 in Trapping = sources.unit_count as u64 in Trapping;
        let unit_start: u64 in Trapping = sources.byte_count as u64 in Trapping;
        let unit_length: u64 in Trapping = unit.length as u64 in Trapping;
        let unit_end: u64 in Trapping = unit_start + unit_length;
        transition unit_count < 128 && unit_end <= 4194304 {
            true -> store_ranges(sources, unit_count, unit_start, unit_length, unit_end, package, path)
            _ -> invalid()
        }
    }

    state store_ranges(
        sources: &mut SourceSet,
        unit_count: u64 in Trapping,
        unit_start: u64 in Trapping,
        unit_length: u64 in Trapping,
        unit_end: u64 in Trapping,
        package: u64 in Trapping,
        path: SourceRange
    ) -> bool
    requires unit_count < 128, unit_end <= 4194304
    {
        sources.units[unit_count] = SourceRange { start: unit_start, length: unit_length };
        sources.paths[unit_count] = path;
        sources.unit_packages[unit_count] = package as u64 in Trapping;
        sources.byte_count = unit_end as u64;
        sources.unit_count = (unit_count + 1) as u64;
        true
    }

    state full() -> bool {
        false
    }

    state invalid() -> bool {
        crash Trap;
    }
}

// Add a package named `name`, or the toolchain package (whose name is
// empty), as the next package index, or report false when the set's
// provisions cannot hold it.
pub machine SourceSet::add_package(sources: &mut SourceSet, name: &ModulePath, toolchain: bool) -> bool
crashes Trap
{
    transition sources.package_count < 64 && name.length <= 16384 - sources.path_byte_count {
        true -> store(sources, name, toolchain)
        _ -> full()
    }

    state store(sources: &mut SourceSet, name: &ModulePath, toolchain: bool) -> bool {
        let range: SourceRange = SourceSet::store_name(sources, name);
        let index: u64 in Trapping = sources.package_count as u64 in Trapping;
        transition index < 64 {
            true -> record(sources, index, range, toolchain)
            _ -> full()
        }
    }

    state record(sources: &mut SourceSet, index: u64 in Trapping, range: SourceRange, toolchain: bool) -> bool
    requires index < 64
    {
        sources.packages[index] = PackageRow { name: range, toolchain: toolchain };
        sources.package_count = (index + 1) as u64;
        true
    }

    state full() -> bool {
        false
    }
}

// Add the edge by which `alias` names package `target` within package
// `requester`'s `scope` imports, or report false when either package is not
// in the set or the set's provisions cannot hold the edge.
pub machine SourceSet::add_dependency(
    sources: &mut SourceSet,
    requester: u64 in Trapping,
    scope: DependencyScope,
    alias: &ModulePath,
    target: u64 in Trapping
) -> bool
crashes Trap
{
    transition sources.dependency_count < 256
        && requester < sources.package_count
        && target < sources.package_count
        && alias.length <= 16384 - sources.path_byte_count {
        true -> store(sources, requester, scope, alias, target)
        _ -> refused()
    }

    state store(
        sources: &mut SourceSet,
        requester: u64 in Trapping,
        scope: DependencyScope,
        alias: &ModulePath,
        target: u64 in Trapping
    ) -> bool {
        let range: SourceRange = SourceSet::store_name(sources, alias);
        let index: u64 in Trapping = sources.dependency_count as u64 in Trapping;
        transition index < 256 {
            true -> record(sources, index, requester, scope, range, target)
            _ -> refused()
        }
    }

    state record(
        sources: &mut SourceSet,
        index: u64 in Trapping,
        requester: u64 in Trapping,
        scope: DependencyScope,
        range: SourceRange,
        target: u64 in Trapping
    ) -> bool
    requires index < 256
    {
        sources.dependencies[index] = DependencyRow { requester: requester, scope: scope, alias: range, target: target };
        sources.dependency_count = (index + 1) as u64;
        true
    }

    state refused() -> bool {
        false
    }
}

// Append `name` to the path arena and give its range. Callers check the
// arena's provision first, so running out of it is an internal fault.
machine SourceSet::store_name(sources: &mut SourceSet, name: &ModulePath) -> SourceRange
crashes Trap
{
    transition { _ -> next(sources, name, 0) }

    state next(sources: &mut SourceSet, name: &ModulePath, index: u64 in Trapping) -> SourceRange {
        transition index < name.length {
            true -> byte(sources, name, index)
            _ -> stored(sources, name)
        }
    }

    state byte(sources: &mut SourceSet, name: &ModulePath, index: u64 in Trapping) -> SourceRange {
        let at: u64 in Trapping = (sources.path_byte_count as u64 in Trapping) + index;
        transition index < 256 && at < 16384 {
            true -> store(sources, name, index, at)
            _ -> invalid()
        }
    }

    state store(sources: &mut SourceSet, name: &ModulePath, index: u64 in Trapping, at: u64 in Trapping) -> SourceRange {
        sources.path_bytes[at] = name.bytes[index] as u8 in Trapping;
        transition { _ -> next(sources, name, index + 1) }
    }

    state stored(sources: &mut SourceSet, name: &ModulePath) -> SourceRange {
        let start: u64 in Trapping = sources.path_byte_count as u64 in Trapping;
        let length: u64 in Trapping = name.length as u64 in Trapping;
        let end: u64 in Trapping = start + length;
        transition end <= 16384 {
            true -> advance(sources, start, length, end)
            _ -> invalid()
        }
    }

    state advance(sources: &mut SourceSet, start: u64 in Trapping, length: u64 in Trapping, end: u64 in Trapping) -> SourceRange
    requires end <= 16384
    {
        sources.path_byte_count = end as u64;
        SourceRange { start: start, length: length }
    }

    state invalid() -> SourceRange {
        crash Trap;
    }
}

// The byte at `index` of unit `source`, or NUL past the unit's end; as for
// `SourceUnit::byte_or_nul`, the fallback makes a violated coordinate fail a
// comparison rather than read another unit.
pub machine SourceSet::byte_or_nul(sources: &SourceSet, source: SourceId, index: u64 in Trapping) -> u8
crashes Trap
{
    let unit: u64 in Trapping = source.value as u64 in Trapping;
    transition unit < sources.unit_count {
        true -> unit_range(sources, unit, index)
        _ -> absent()
    }

    state unit_range(sources: &SourceSet, unit: u64 in Trapping, index: u64 in Trapping) {
        transition unit < 128 {
            true -> within(sources, sources.units[unit], index)
            _ -> absent()
        }
    }

    state within(sources: &SourceSet, range: SourceRange, index: u64 in Trapping) {
        transition index < range.length {
            true -> located(sources, range.start + index)
            _ -> absent()
        }
    }

    state located(sources: &SourceSet, at: u64 in Trapping) {
        transition at < 4194304 {
            true -> read(sources, at)
            _ -> absent()
        }
    }

    state read(sources: &SourceSet, at: u64 in Trapping) {
        sources.bytes[at] as u8
    }

    state absent() {
        0
    }
}

// Whether two spans, of any units, spell the same bytes. Identifier
// spellings are their source bytes under LEXICAL-PROFILE-V1 (no escapes), so
// name comparison reads the units rather than a decoded copy.
pub machine SourceSet::spans_equal(sources: &SourceSet, left: SourceSpan, right: SourceSpan) -> bool
crashes Trap
{
    transition left.span.end - left.span.start == right.span.end - right.span.start {
        true -> scan(sources, left, right, 0)
        _ -> different()
    }

    state scan(sources: &SourceSet, left: SourceSpan, right: SourceSpan, offset: u64 in Trapping) {
        transition offset < left.span.end - left.span.start {
            true -> compare(sources, left, right, offset)
            _ -> same()
        }
    }

    state compare(sources: &SourceSet, left: SourceSpan, right: SourceSpan, offset: u64 in Trapping) {
        let left_byte: u8 = SourceSet::byte_or_nul(sources, left.source, left.span.start + offset);
        let right_byte: u8 = SourceSet::byte_or_nul(sources, right.source, right.span.start + offset);
        transition left_byte == right_byte {
            true -> scan(sources, left, right, offset + 1)
            _ -> different()
        }
    }

    state same() {
        true
    }

    state different() {
        false
    }
}

// Whether a span spells exactly `spelling`.
pub machine SourceSet::span_spells(sources: &SourceSet, span: SourceSpan, spelling: &[u8]) -> bool
crashes Trap
{
    transition span.span.end - span.span.start == spelling.len {
        true -> scan(sources, span, spelling, 0)
        _ -> different()
    }

    state scan(sources: &SourceSet, span: SourceSpan, spelling: &[u8], index: u64 in Trapping) {
        transition index < spelling.len {
            true -> compare(sources, span, spelling, index)
            _ -> same()
        }
    }

    state compare(sources: &SourceSet, span: SourceSpan, spelling: &[u8], index: u64 in Trapping) {
        let source_byte: u8 = SourceSet::byte_or_nul(sources, span.source, span.span.start + index);
        let spelling_byte: u8 = spelling[index];
        transition source_byte == spelling_byte {
            true -> scan(sources, span, spelling, index + 1)
            _ -> different()
        }
    }

    state same() {
        true
    }

    state different() {
        false
    }
}

// The byte at `index` of unit `unit`'s module path, or NUL past its end.
pub machine SourceSet::path_byte_or_nul(sources: &SourceSet, unit: u64 in Trapping, index: u64 in Trapping) -> u8
crashes Trap
{
    transition unit < sources.unit_count {
        true -> unit_range(sources, unit, index)
        _ -> absent()
    }

    state unit_range(sources: &SourceSet, unit: u64 in Trapping, index: u64 in Trapping) {
        transition unit < 128 {
            true -> within(sources, sources.paths[unit], index)
            _ -> absent()
        }
    }

    state within(sources: &SourceSet, range: SourceRange, index: u64 in Trapping) {
        transition index < range.length {
            true -> located(sources, range.start + index)
            _ -> absent()
        }
    }

    state located(sources: &SourceSet, at: u64 in Trapping) {
        transition at < 16384 {
            true -> read(sources, at)
            _ -> absent()
        }
    }

    state read(sources: &SourceSet, at: u64 in Trapping) {
        sources.path_bytes[at] as u8
    }

    state absent() {
        0
    }
}

// The length of unit `unit`'s module path; zero for no unit.
pub machine SourceSet::path_length(sources: &SourceSet, unit: u64 in Trapping) -> u64 in Trapping {
    transition unit < sources.unit_count && unit < 128 {
        true -> read(sources, unit)
        _ -> none()
    }

    state read(sources: &SourceSet, unit: u64 in Trapping) -> u64 in Trapping {
        sources.paths[unit].length
    }

    state none() -> u64 in Trapping {
        0
    }
}

// The package unit `unit` belongs to; zero for no unit.
pub machine SourceSet::unit_package(sources: &SourceSet, unit: u64 in Trapping) -> u64 in Trapping {
    transition unit < sources.unit_count && unit < 128 {
        true -> read(sources, unit)
        _ -> none()
    }

    state read(sources: &SourceSet, unit: u64 in Trapping) -> u64 in Trapping {
        sources.unit_packages[unit]
    }

    state none() -> u64 in Trapping {
        0
    }
}

// Package `package`'s row; an unnamed ordinary package for no package.
pub machine SourceSet::package_row(sources: &SourceSet, package: u64 in Trapping) -> PackageRow {
    transition package < sources.package_count && package < 64 {
        true -> read(sources, package)
        _ -> none()
    }

    state read(sources: &SourceSet, package: u64 in Trapping) -> PackageRow {
        sources.packages[package]
    }

    state none() -> PackageRow {
        PackageRow { name: SourceRange { start: 0, length: 0 }, toolchain: false }
    }
}

// Dependency edge `index`; for no edge, a build edge of no requester (64 is
// past every package index).
pub machine SourceSet::dependency_row(sources: &SourceSet, index: u64 in Trapping) -> DependencyRow {
    transition index < sources.dependency_count && index < 256 {
        true -> read(sources, index)
        _ -> none()
    }

    state read(sources: &SourceSet, index: u64 in Trapping) -> DependencyRow {
        sources.dependencies[index]
    }

    state none() -> DependencyRow {
        DependencyRow {
            requester: 64,
            scope: DependencyScope::Build,
            alias: SourceRange { start: 0, length: 0 },
            target: 0
        }
    }
}

// Whether a span spells exactly the path-arena bytes of `name`, a package
// name or dependency alias.
pub machine SourceSet::span_names(sources: &SourceSet, span: SourceSpan, name: SourceRange) -> bool
crashes Trap
{
    transition span.span.end - span.span.start == name.length {
        true -> scan(sources, span, name, 0)
        _ -> different()
    }

    state scan(sources: &SourceSet, span: SourceSpan, name: SourceRange, index: u64 in Trapping) -> bool {
        transition index < name.length {
            true -> compare(sources, span, name, index)
            _ -> same()
        }
    }

    state compare(sources: &SourceSet, span: SourceSpan, name: SourceRange, index: u64 in Trapping) -> bool {
        let source_byte: u8 = SourceSet::byte_or_nul(sources, span.source, span.span.start + index);
        let name_byte: u8 = SourceSet::name_byte_or_nul(sources, name.start + index);
        transition source_byte == name_byte {
            true -> scan(sources, span, name, index + 1)
            _ -> different()
        }
    }

    state same() -> bool {
        true
    }

    state different() -> bool {
        false
    }
}

// The path-arena byte at `at`, or NUL past the arena's end.
machine SourceSet::name_byte_or_nul(sources: &SourceSet, at: u64 in Trapping) -> u8 {
    transition at < sources.path_byte_count && at < 16384 {
        true -> read(sources, at)
        _ -> absent()
    }

    state read(sources: &SourceSet, at: u64 in Trapping) -> u8 {
        sources.path_bytes[at] as u8
    }

    state absent() -> u8 {
        0
    }
}
