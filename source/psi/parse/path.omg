use psi::parse::clause;
use psi::parse::input;
use psi::parse::parser;
use psi::syntax::syntax;
use psi::tokens::tokens;

// `name {:: name}`, a name path, entered at its first name. Its members
// append to `SyntaxTrees::members` and its row to `SyntaxTrees::name_paths`;
// the row's handle lands in `name_path_result`. `missing` is the caller's
// diagnostic for an absent first name; a name missing after `::` is
// `ExpectedPathMember`.
public machine Parser::parse_name_path(parser: &mut Parser, input: &TokenStream, missing: ParseDiagnosticCode)
crashes Trap
{
    let first_member: u64 in Trapping = parser.output.member_count as u64 in Trapping;
    Parser::expect_name(parser, input, missing);
    transition parser.output.accepted {
        true -> member(parser, input, first_member, parser.name_start)
        _ -> done()
    }

    machine member(parser: &mut Parser, input: &TokenStream, first_member: u64 in Trapping, start: u64 in Trapping) {
        let name_start: u64 in Trapping = parser.name_start;
        let name_end: u64 in Trapping = parser.name_end;
        Parser::append_member(parser, input, name_start, name_end);
        transition parser.output.accepted {
            true -> separator(parser, input, first_member, start)
            _ -> done()
        }
    }

    machine separator(parser: &mut Parser, input: &TokenStream, first_member: u64 in Trapping, start: u64 in Trapping) {
        let more: bool = Parser::at_punctuation(parser, input, PunctuationKind::ColonColon);
        transition more {
            true -> next_member(parser, input, first_member, start)
            _ -> retain_capacity(parser, input, first_member, start)
        }
    }

    machine next_member(parser: &mut Parser, input: &TokenStream, first_member: u64 in Trapping, start: u64 in Trapping) {
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedPathMember);
        transition parser.output.accepted {
            true -> member(parser, input, first_member, start)
            _ -> done()
        }
    }

    machine retain_capacity(parser: &mut Parser, input: &TokenStream, first_member: u64 in Trapping, start: u64 in Trapping) {
        transition parser.output.name_path_count < 2048 {
            true -> retain(parser, first_member, start)
            _ -> full(parser, input)
        }
    }

    machine retain(parser: &mut Parser, first_member: u64 in Trapping, start: u64 in Trapping) {
        parser.name_path_result = parser.output.name_path_count as u64 in Trapping;
        parser.output.name_paths[parser.output.name_path_count] = NamePath {
            first_member: first_member,
            member_count: (parser.output.member_count as u64 in Trapping) - first_member,
            source_span: Parser::source_span(parser, start, parser.name_end)
        };
        parser.output.name_path_count = parser.output.name_path_count + 1;
    }

    machine full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::NamePathCapacityExceeded);
    }

    machine done() {}
}

// Where a retained name path starts.
machine Parser::name_path_start(parser: &Parser, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let path: NamePath = SyntaxTrees::name_path(&parser.output, handle);
    path.source_span.span.start
}
