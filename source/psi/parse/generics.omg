use psi::parse::data;
use psi::parse::input;
use psi::parse::parser;
use psi::parse::types;
use psi::syntax::syntax;
use psi::tokens::tokens;

// `<parameter {, parameter}>` on a declaration head, entered at `<`:
//
//     parameter = `'` name                        lifetime
//               | `machine` name                  static machine binder
//               | `proposition` name              proposition binder
//               | `const` name `:` type [properties]   static value binder
//               | name `satisfies` type           conformance evidence binder
//               | name `:` type [properties]      runtime value binder
//               | name [properties]               type parameter
//
// An evidence binder names an implementation of the trait application it
// satisfies, not a type; a machine or proposition binder takes its signature
// from a `where` contract of its declaration.
// Lifetimes precede every other binder. Each parameter is retained as soon
// as it is whole, so a rejection keeps every parameter before it. Repeated
// names are a resolution question, not a grammar one.
public machine Parser::parse_generic_parameters(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    Parser::take_current(parser, input);
    parser.generic_saw_runtime = false;
    transition { _ -> parameter(parser, input) }

    machine parameter(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.generic_parameter_count < 256 {
            true -> opener(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::GenericParameterCapacityExceeded)
        }
    }

    machine opener(parser: &mut Parser, input: &TokenStream) {
        let tick: bool = Parser::at_punctuation(parser, input, PunctuationKind::Apostrophe);
        transition tick {
            true -> lifetime(parser, input)
            _ -> machine_word(parser, input)
        }
    }

    machine lifetime(parser: &mut Parser, input: &TokenStream) {
        transition parser.generic_saw_runtime {
            true -> reject(parser, input, ParseDiagnosticCode::GenericLifetimeOrdering)
            _ -> lifetime_name(parser, input)
        }
    }

    machine lifetime_name(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        let start: u64 in Trapping = parser.token_start;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedGenericParameterName);
        transition parser.output.accepted {
            true -> retain(parser, input, Parser::generic_parameter(parser, GenericParameterKind::Lifetime, start))
            _ -> done()
        }
    }

    machine machine_word(parser: &mut Parser, input: &TokenStream) {
        let machine: bool = Parser::at_keyword(parser, input, KeywordKind::Machine);
        transition machine {
            true -> binder(parser, input, GenericParameterKind::Machine)
            _ -> const_word(parser, input)
        }
    }

    machine const_word(parser: &mut Parser, input: &TokenStream) {
        let constant: bool = Parser::at_word(parser, input, "const");
        transition constant {
            true -> binder(parser, input, GenericParameterKind::Const)
            _ -> proposition_word(parser, input)
        }
    }

    machine proposition_word(parser: &mut Parser, input: &TokenStream) {
        let proposition: bool = Parser::at_word(parser, input, "proposition");
        transition proposition {
            true -> binder(parser, input, GenericParameterKind::Proposition)
            _ -> bare_name(parser, input)
        }
    }

    // `machine`, `proposition` and `const` introduce a binder name.
    machine binder(parser: &mut Parser, input: &TokenStream, kind: GenericParameterKind) {
        Parser::take_current(parser, input);
        let start: u64 in Trapping = parser.token_start;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedGenericParameterName);
        transition parser.output.accepted {
            true -> binder_named(parser, input, Parser::generic_parameter(parser, kind, start))
            _ -> done()
        }
    }

    machine binder_named(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        transition parameter.kind {
            GenericParameterKind::Const -> const_colon(parser, input, parameter)
            _ -> retain(parser, input, parameter)
        }
    }

    machine const_colon(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Colon,
            ParseDiagnosticCode::ExpectedGenericParameterColon
        );
        transition parser.output.accepted {
            true -> typed(parser, input, parameter)
            _ -> done()
        }
    }

    machine bare_name(parser: &mut Parser, input: &TokenStream) {
        let name: bool = Parser::at_name(parser, input);
        transition name {
            true -> type_parameter(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedGenericParameter)
        }
    }

    // After a bare name, `:` makes a runtime value binder, `satisfies` an
    // evidence binder, `[` opens the type parameter's bounds, and a tick is a
    // lifetime after a runtime binder.
    machine type_parameter(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.name_start = parser.token_start;
        parser.name_end = parser.token_end;
        let parameter: GenericParameter = Parser::generic_parameter(parser, GenericParameterKind::Type,
            parser.token_start
        );
        let value: bool = Parser::at_punctuation(parser, input, PunctuationKind::Colon);
        let evidence: bool = Parser::at_word(parser, input, "satisfies");
        let tick: bool = Parser::at_punctuation(parser, input, PunctuationKind::Apostrophe);
        transition value {
            true -> value_colon(parser, input, parameter)
            _ -> evidence_word(parser, input, parameter, evidence, tick)
        }
    }

    machine evidence_word(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter, evidence: bool, tick: bool) {
        transition evidence {
            true -> evidence_trait(parser, input, Parser::with_generic_kind(parameter, GenericParameterKind::Evidence))
            _ -> type_tail(parser, input, parameter, tick)
        }
    }

    // The satisfied trait application is the binder's type reference; an
    // implementation takes no property bounds.
    machine evidence_trait(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        Parser::take_current(parser, input);
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedEvidenceTrait);
        transition parser.output.accepted {
            true -> retain(parser, input, Parser::with_generic_type(parser, parameter, parser.type_result))
            _ -> done()
        }
    }

    machine type_tail(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter, tick: bool) {
        transition tick {
            true -> reject(parser, input, ParseDiagnosticCode::GenericLifetimeOrdering)
            _ -> bounds(parser, input, parameter)
        }
    }

    machine value_colon(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        Parser::take_current(parser, input);
        transition { _ -> typed(parser, input, Parser::with_generic_kind(parameter, GenericParameterKind::Value)) }
    }

    machine typed(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedGenericParameterType);
        transition parser.output.accepted {
            true -> bounds(parser, input, Parser::with_generic_type(parser, parameter, parser.type_result))
            _ -> done()
        }
    }

    machine bounds(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        let bracket: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBracket);
        transition bracket {
            true -> bounds_list(parser, input, parameter)
            _ -> retain(parser, input, parameter)
        }
    }

    machine bounds_list(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        Parser::parse_properties(parser, input);
        transition parser.output.accepted {
            true -> retain(parser, input, Parser::with_generic_bounds(parser, parameter, parser.property_multiplicity))
            _ -> done()
        }
    }

    // Lifetimes leave the ordering open; every other binder closes it.
    machine retain(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        transition parameter.kind {
            GenericParameterKind::Lifetime -> store(parser, input, parameter)
            _ -> runtime(parser, input, parameter)
        }
    }

    machine runtime(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        parser.generic_saw_runtime = true;
        transition { _ -> store(parser, input, parameter) }
    }

    machine store(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        transition parser.output.generic_parameter_count < 256 {
            true -> stored(parser, input, parameter)
            _ -> reject(parser, input, ParseDiagnosticCode::GenericParameterCapacityExceeded)
        }
    }

    machine stored(parser: &mut Parser, input: &TokenStream, parameter: GenericParameter) {
        parser.output.generic_parameters[parser.output.generic_parameter_count] = parameter;
        parser.output.generic_parameter_count = parser.output.generic_parameter_count + 1;
        let comma: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition comma {
            true -> next(parser, input)
            _ -> close(parser, input)
        }
    }

    machine next(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> parameter(parser, input) }
    }

    machine close(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Greater,
            ParseDiagnosticCode::ExpectedGenericParameterEnd
        );
    }

    machine reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    machine done() {}
}

// A parameter named by the last name step, spanning from `start` through the
// last taken token; the `with_` constructors add a type, kind or bounds.
machine Parser::generic_parameter(parser: &Parser, kind: GenericParameterKind, start: u64 in Trapping) -> GenericParameter {
    GenericParameter {
        kind: kind,
        name: Parser::identifier_span(parser, parser.name_start, parser.name_end),
        has_type_reference: false,
        type_reference: 0,
        bounds: DataMultiplicity::Affine,
        source_span: Parser::source_span(parser, start, parser.token_end)
    }
}

machine Parser::with_generic_kind(parameter: GenericParameter, kind: GenericParameterKind) -> GenericParameter {
    GenericParameter {
        kind: kind,
        name: parameter.name,
        has_type_reference: parameter.has_type_reference,
        type_reference: parameter.type_reference,
        bounds: parameter.bounds,
        source_span: parameter.source_span
    }
}

machine Parser::with_generic_type(
    parser: &Parser,
    parameter: GenericParameter,
    type_reference: u64 in Trapping
) -> GenericParameter {
    GenericParameter {
        kind: parameter.kind,
        name: parameter.name,
        has_type_reference: true,
        type_reference: type_reference,
        bounds: parameter.bounds,
        source_span: Parser::source_span(parser, parameter.source_span.span.start, parser.type_end)
    }
}

machine Parser::with_generic_bounds(
    parser: &Parser,
    parameter: GenericParameter,
    bounds: DataMultiplicity
) -> GenericParameter {
    GenericParameter {
        kind: parameter.kind,
        name: parameter.name,
        has_type_reference: parameter.has_type_reference,
        type_reference: parameter.type_reference,
        bounds: bounds,
        source_span: Parser::source_span(parser, parameter.source_span.span.start, parser.token_end)
    }
}
