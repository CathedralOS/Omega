use psi::parse::clause;
use psi::parse::generics;
use psi::parse::input;
use psi::parse::machine;
use psi::parse::parser;
use psi::parse::types;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

// `[public] [boundary] trait Name [<generic parameters>] [: Parent {+ Parent}]
// {where proposition Name(parameters);} { member* }`, entered at the `trait`
// word. A parent is a type application retained in
// `SyntaxTrees::trait_parents`; each proposition binder takes its signature
// from a `where proposition` contract. A member is a machine requirement
// (machine.omg's grammar, contained by the trait) or a body parent
// `requires Parent;`, which joins the header's parents. A transparent
// refinement `trait Name [<generic parameters>] = Base { refinement* }`
// instead bounds a base conformance: each `machine (* | [Base::]requirement)
// clause*` narrows the base's operational axes with `reaches [rows];`,
// `suspends [true | false];`, `blocks [true | false];` and `terminates;`.
// The item and its root are retained at the closing `}`.
public machine Parser::parse_trait(
    parser: &mut Parser,
    input: &TokenStream,
    item_start: u64 in Trapping,
    is_public: bool,
    is_boundary: bool
)
crashes Trap
{
    parser.declaration_start = item_start;
    parser.declaration_is_public = is_public;
    parser.declaration_is_boundary = is_boundary;
    transition parser.output.trait_count < 256 {
        true -> keyword(parser, input)
        _ -> reject(parser, input, ParseDiagnosticCode::TraitCapacityExceeded)
    }

    state keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.declaration_first_generic = parser.output.generic_parameter_count as u64 in Trapping;
        parser.declaration_first_parent = parser.output.trait_parent_count as u64 in Trapping;
        parser.declaration_first_contract = parser.output.contract_count as u64 in Trapping;
        parser.declaration_is_refinement = false;
        parser.declaration_type = 0;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedTraitName);
        transition parser.output.accepted {
            true -> named(parser, input)
            _ -> done()
        }
    }

    state named(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_name_start = parser.name_start;
        parser.declaration_name_end = parser.name_end;
        let generic: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        transition generic {
            true -> generics(parser, input)
            _ -> parents(parser, input)
        }
    }

    state generics(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_generic_parameters(parser, input);
        transition parser.output.accepted {
            true -> parents(parser, input)
            _ -> done()
        }
    }

    state parents(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_generic_count = (parser.output.generic_parameter_count as u64 in Trapping) - parser.declaration_first_generic;
        let listed: bool = Parser::at_punctuation(parser, input, PunctuationKind::Colon);
        let refines: bool = Parser::at_punctuation(parser, input, PunctuationKind::Equal);
        transition listed {
            true -> next_parent(parser, input)
            _ -> refinement_word(parser, input, refines)
        }
    }

    state refinement_word(parser: &mut Parser, input: &TokenStream, refines: bool) {
        transition refines {
            true -> refinement_base(parser, input)
            _ -> contracts(parser, input)
        }
    }

    state refinement_base(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedRefinementBase);
        parser.declaration_type = parser.type_result;
        parser.declaration_is_refinement = true;
        transition parser.output.accepted {
            true -> refinement_body(parser, input)
            _ -> done()
        }
    }

    state refinement_body(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::LeftBrace, ParseDiagnosticCode::ExpectedTraitBody);
        parser.declaration_first_machine = parser.output.machine_count as u64 in Trapping;
        transition parser.output.accepted {
            true -> refinement_member(parser, input)
            _ -> done()
        }
    }

    state refinement_member(parser: &mut Parser, input: &TokenStream) {
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBrace);
        let narrowed: bool = Parser::at_keyword(parser, input, KeywordKind::Machine);
        transition closing {
            true -> close(parser, input)
            _ -> refinement_narrowing(parser, input, narrowed)
        }
    }

    state refinement_narrowing(parser: &mut Parser, input: &TokenStream, narrowed: bool) {
        transition narrowed {
            true -> narrowing(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedTraitMember)
        }
    }

    state narrowing(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_refinement_member(parser, input);
        transition parser.output.accepted {
            true -> refinement_member(parser, input)
            _ -> done()
        }
    }

    state next_parent(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedTraitParent);
        transition parser.output.accepted {
            true -> header_parent(parser, input, parser.type_result)
            _ -> done()
        }
    }

    state header_parent(parser: &mut Parser, input: &TokenStream, parent: u64 in Trapping) {
        Parser::append_trait_parent(parser, input, parent);
        let more: bool = Parser::at_punctuation(parser, input, PunctuationKind::Plus);
        transition parser.output.accepted && more {
            true -> next_parent(parser, input)
            _ -> header_end(parser, input)
        }
    }

    state header_end(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.accepted {
            true -> contracts(parser, input)
            _ -> done()
        }
    }

    // `where proposition Name(parameters);`, one per proposition binder.
    state contracts(parser: &mut Parser, input: &TokenStream) {
        let facts: bool = Parser::at_word(parser, input, "where");
        let proposition: bool = Parser::next_is_word(parser, input, "proposition");
        transition facts && proposition {
            true -> contract(parser, input)
            _ -> body(parser, input)
        }
    }

    state contract(parser: &mut Parser, input: &TokenStream) {
        let token: Token = input.tokens[parser.current_index];
        parser.contract_start = token.start;
        Parser::take_current(parser, input);
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedContractName);
        transition parser.output.accepted {
            true -> contract_signature(parser, input)
            _ -> done()
        }
    }

    state contract_signature(parser: &mut Parser, input: &TokenStream) {
        parser.contract_name_start = parser.name_start;
        parser.contract_name_end = parser.name_end;
        Parser::parse_parameters(parser, input);
        transition parser.output.accepted {
            true -> contract_end(parser, input)
            _ -> done()
        }
    }

    state contract_end(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedContractEnd);
        transition parser.output.accepted {
            true -> contract_retained(parser, input)
            _ -> done()
        }
    }

    state contract_retained(parser: &mut Parser, input: &TokenStream) {
        let contract: Contract = Contract {
            kind: ContractKind::Proposition,
            name: Parser::identifier_span(parser, parser.contract_name_start, parser.contract_name_end),
            first_generic_parameter: parser.output.generic_parameter_count as u64 in Trapping,
            generic_parameter_count: 0,
            first_parameter: parser.signature_first_parameter,
            parameter_count: parser.signature_parameter_count,
            has_return_type: false,
            return_type: 0,
            first_clause: parser.output.clause_count as u64 in Trapping,
            clause_count: 0,
            source_span: Parser::source_span(parser, parser.contract_start, parser.token_end)
        };
        Parser::retain_contract(parser, input, contract);
        transition parser.output.accepted {
            true -> contracts(parser, input)
            _ -> done()
        }
    }

    state body(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::LeftBrace, ParseDiagnosticCode::ExpectedTraitBody);
        parser.declaration_first_machine = parser.output.machine_count as u64 in Trapping;
        transition parser.output.accepted {
            true -> member(parser, input)
            _ -> done()
        }
    }

    state member(parser: &mut Parser, input: &TokenStream) {
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBrace);
        transition closing {
            true -> close(parser, input)
            _ -> machine_member(parser, input)
        }
    }

    state machine_member(parser: &mut Parser, input: &TokenStream) {
        let required: bool = Parser::at_keyword(parser, input, KeywordKind::Machine);
        transition required {
            true -> requirement(parser, input)
            _ -> parent_member(parser, input)
        }
    }

    state requirement(parser: &mut Parser, input: &TokenStream) {
        let token: Token = input.tokens[parser.current_index];
        let head: MachineHead = Parser::member_machine_head(token.start, MachineContainer::Trait);
        let index: u64 in Trapping = parser.output.machine_count as u64 in Trapping;
        let boundary: bool = parser.declaration_is_boundary;
        Parser::parse_machine(parser, input, head);
        transition parser.output.accepted {
            true -> requirement_contract(parser, input, index, boundary)
            _ -> done()
        }
    }

    // The trait owns boundary identity; its member has no boundary keyword
    // or executable receiver of its own. Read the member's produced clause
    // range, including a zero-member Reaches row, instead of inferring an
    // absent contract from a selected/default implementation body.
    state requirement_contract(parser: &mut Parser, input: &TokenStream, index: u64 in Trapping, boundary: bool) {
        transition boundary {
            true -> boundary_contract(parser, input, index)
            _ -> member(parser, input)
        }
    }

    state boundary_contract(parser: &mut Parser, input: &TokenStream, index: u64 in Trapping) {
        let declaration: MachineItem = SyntaxTrees::machine_item(&parser.output, index);
        transition { _ -> reach_clause(parser, input, declaration.first_clause, declaration.clause_count, 0) }
    }

    state reach_clause(parser: &mut Parser, input: &TokenStream, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) {
        transition offset < count {
            true -> inspected_clause(parser, input, first, count, offset)
            _ -> reject(parser, input, ParseDiagnosticCode::MissingBoundaryReachCeiling)
        }
    }

    state inspected_clause(parser: &mut Parser, input: &TokenStream, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) {
        let clause: Clause = SyntaxTrees::clause(&parser.output, first + offset);
        transition clause.kind == ClauseKind::Reaches {
            true -> member(parser, input)
            _ -> reach_clause(parser, input, first, count, offset + 1)
        }
    }

    state parent_member(parser: &mut Parser, input: &TokenStream) {
        let composed: bool = Parser::at_word(parser, input, "requires");
        transition composed {
            true -> body_parent(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedTraitMember)
        }
    }

    state body_parent(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedTraitParent);
        transition parser.output.accepted {
            true -> body_parent_end(parser, input, parser.type_result)
            _ -> done()
        }
    }

    state body_parent_end(parser: &mut Parser, input: &TokenStream, parent: u64 in Trapping) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedTraitRequirementEnd);
        transition parser.output.accepted {
            true -> body_parent_retained(parser, input, parent)
            _ -> done()
        }
    }

    state body_parent_retained(parser: &mut Parser, input: &TokenStream, parent: u64 in Trapping) {
        Parser::append_trait_parent(parser, input, parent);
        transition parser.output.accepted {
            true -> member(parser, input)
            _ -> done()
        }
    }

    state close(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition parser.output.trait_count < 256 {
            true -> root_capacity(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::TraitCapacityExceeded)
        }
    }

    state root_capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.root_count < 4096 {
            true -> retain(parser)
            _ -> reject(parser, input, ParseDiagnosticCode::RootCapacityExceeded)
        }
    }

    state retain(parser: &mut Parser) {
        let trait_index: u64 in Trapping = parser.output.trait_count as u64 in Trapping;
        let span: SourceSpan = Parser::source_span(parser, parser.declaration_start, parser.token_end);
        parser.output.traits[parser.output.trait_count] = TraitItem {
            name: Parser::identifier_span(parser, parser.declaration_name_start, parser.declaration_name_end),
            first_generic_parameter: parser.declaration_first_generic,
            generic_parameter_count: parser.declaration_generic_count,
            first_parent: parser.declaration_first_parent,
            parent_count: (parser.output.trait_parent_count as u64 in Trapping) - parser.declaration_first_parent,
            first_machine: parser.declaration_first_machine,
            machine_count: (parser.output.machine_count as u64 in Trapping) - parser.declaration_first_machine,
            is_boundary: parser.declaration_is_boundary,
            is_public: parser.declaration_is_public,
            first_contract: parser.declaration_first_contract,
            contract_count: (parser.output.contract_count as u64 in Trapping) - parser.declaration_first_contract,
            is_refinement: parser.declaration_is_refinement,
            base: parser.declaration_type,
            source_span: span
        };
        parser.output.trait_count = parser.output.trait_count + 1;
        parser.output.roots[parser.output.root_count] = RootItem {
            kind: RootItemKind::Trait,
            item_index: trait_index,
            source_span: span
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state done() {}
}

// Append one parent's type row to `SyntaxTrees::trait_parents`.
machine Parser::append_trait_parent(parser: &mut Parser, input: &TokenStream, parent: u64 in Trapping)
crashes Trap
{
    transition parser.output.trait_parent_count < 512 {
        true -> append(parser, parent)
        _ -> full(parser, input)
    }

    state append(parser: &mut Parser, parent: u64 in Trapping) {
        parser.output.trait_parents[parser.output.trait_parent_count] = parent as u64 in Trapping;
        parser.output.trait_parent_count = parser.output.trait_parent_count + 1;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::TraitParentCapacityExceeded);
    }
}

// The head of a trait or conformance member machine, starting at its
// `machine` keyword: no visibility, target or `boundary` of its own.
machine Parser::member_machine_head(start: u64 in Trapping, container: MachineContainer) -> MachineHead {
    MachineHead {
        start: start,
        is_public: false,
        has_target: false,
        target_start: 0,
        target_end: 0,
        is_boundary: false,
        container: container
    }
}

// One member of a transparent refinement, entered at its `machine` keyword:
// `*` for every base requirement, or `[Base::]requirement` for one, then its
// narrowing clauses. It declares no signature or body.
machine Parser::parse_refinement_member(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    let token: Token = input.tokens[parser.current_index];
    parser.machine_start = token.start;
    transition parser.output.machine_count < 2048 {
        true -> keyword(parser, input)
        _ -> reject(parser, input, ParseDiagnosticCode::MachineCapacityExceeded)
    }

    state keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.machine_has_owner = false;
        parser.machine_owner_start = 0;
        parser.machine_owner_end = 0;
        parser.machine_first_expression = parser.output.expression_count as u64 in Trapping;
        let every: bool = Parser::at_punctuation(parser, input, PunctuationKind::Asterisk);
        transition every {
            true -> every_requirement(parser, input)
            _ -> requirement(parser, input)
        }
    }

    state every_requirement(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.machine_name_start = parser.token_start;
        parser.machine_name_end = parser.token_end;
        transition { _ -> clauses(parser, input, true) }
    }

    state requirement(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedRefinementRequirement);
        transition parser.output.accepted {
            true -> named(parser, input)
            _ -> done()
        }
    }

    state named(parser: &mut Parser, input: &TokenStream) {
        parser.machine_name_start = parser.name_start;
        parser.machine_name_end = parser.name_end;
        let qualified: bool = Parser::at_punctuation(parser, input, PunctuationKind::ColonColon);
        transition qualified {
            true -> qualified_requirement(parser, input)
            _ -> clauses(parser, input, false)
        }
    }

    state qualified_requirement(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.machine_has_owner = true;
        parser.machine_owner_start = parser.machine_name_start;
        parser.machine_owner_end = parser.machine_name_end;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedRefinementRequirement);
        transition parser.output.accepted {
            true -> qualified_named(parser, input)
            _ -> done()
        }
    }

    state qualified_named(parser: &mut Parser, input: &TokenStream) {
        parser.machine_name_start = parser.name_start;
        parser.machine_name_end = parser.name_end;
        transition { _ -> clauses(parser, input, false) }
    }

    state clauses(parser: &mut Parser, input: &TokenStream, every: bool) {
        let end: u64 in Trapping = parser.token_end;
        Parser::parse_clauses(parser, input, ClauseOwner::Refinement);
        transition parser.output.accepted {
            true -> capacity(parser, input, every, end)
            _ -> done()
        }
    }

    state capacity(parser: &mut Parser, input: &TokenStream, every: bool, end: u64 in Trapping) {
        transition parser.output.machine_count < 2048 {
            true -> retain(parser, input, every, end)
            _ -> reject(parser, input, ParseDiagnosticCode::MachineCapacityExceeded)
        }
    }

    state retain(parser: &mut Parser, input: &TokenStream, every: bool, name_end: u64 in Trapping) {
        let clause_count: u64 in Trapping = (parser.output.clause_count as u64 in Trapping) - parser.clause_first;
        let end: u64 in Trapping = Parser::refinement_end(parser, clause_count, name_end);
        parser.output.machines[parser.output.machine_count] = MachineItem {
            has_owner: parser.machine_has_owner,
            owner: Parser::identifier_span(parser, parser.machine_owner_start, parser.machine_owner_end),
            name: Parser::identifier_span(parser, parser.machine_name_start, parser.machine_name_end),
            first_generic_parameter: parser.output.generic_parameter_count as u64 in Trapping,
            generic_parameter_count: 0,
            first_parameter: parser.output.parameter_count as u64 in Trapping,
            parameter_count: 0,
            has_return_type: false,
            return_type: 0,
            first_clause: parser.clause_first,
            clause_count: clause_count,
            first_statement: parser.output.statement_count as u64 in Trapping,
            statement_count: 0,
            first_state: parser.output.state_count as u64 in Trapping,
            state_count: 0,
            has_body: false,
            first_expression: parser.machine_first_expression,
            expression_count: (parser.output.expression_count as u64 in Trapping) - parser.machine_first_expression,
            has_target: false,
            target: Parser::identifier_span(parser, 0, 0),
            is_boundary: false,
            container: MachineContainer::Refinement,
            is_public: false,
            operator: OperatorToken::None,
            token: Parser::identifier_span(parser, 0, 0),
            first_contract: parser.output.contract_count as u64 in Trapping,
            contract_count: 0,
            every_requirement: every,
            source_span: Parser::source_span(parser, parser.machine_start, end)
        };
        parser.output.machine_count = parser.output.machine_count + 1;
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state done() {}
}

// Where a refinement member ends: its last clause, or its name.
machine Parser::refinement_end(parser: &Parser, clause_count: u64 in Trapping, name_end: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition clause_count > 0 {
        true -> last_clause(parser)
        _ -> named(name_end)
    }

    state last_clause(parser: &Parser) -> u64 in Trapping {
        let handle: u64 in Trapping = (parser.output.clause_count as u64 in Trapping) - 1;
        let clause: Clause = SyntaxTrees::clause(&parser.output, handle);
        clause.source_span.span.end
    }

    state named(name_end: u64 in Trapping) -> u64 in Trapping {
        name_end
    }
}
