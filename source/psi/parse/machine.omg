use psi::parse::clause;
use psi::parse::input;
use psi::parse::parser;
use psi::parse::statement;
use psi::parse::types;
use psi::syntax::syntax;
use psi::tokens::tokens;

// Machine-declaration grammar attached to the parser owner:
// `[pub] machine [Owner::]name [(parameters)] [-> Type] clauses { statements
// state* }`. clause.omg owns the clauses and statement.omg the statements;
// the entry's statements precede the `state` members. Machine generics and
// bodyless declarations reject at their first token, with the diagnostic of
// the element expected there.
pub machine Parser::parse_machine(
    parser: &mut Parser,
    input: &TokenStream,
    item_start: u64 in Trapping,
    is_public: bool
)
crashes Trap
{
    parser.machine_start = item_start;
    parser.machine_is_public = is_public;
    transition parser.output.machine_count < 256 {
        true -> keyword(parser, input)
        _ -> machine_full(parser, input)
    }

    state machine_full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::MachineCapacityExceeded);
    }

    state keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedMachineName);
        transition parser.output.accepted {
            true -> first_name(parser, input)
            _ -> done()
        }
    }

    state first_name(parser: &mut Parser, input: &TokenStream) {
        parser.machine_has_owner = false;
        parser.machine_owner_start = 0;
        parser.machine_owner_end = 0;
        parser.machine_name_start = parser.name_start;
        parser.machine_name_end = parser.name_end;
        let owned: bool = Parser::at_punctuation(parser, input, PunctuationKind::ColonColon);
        transition owned {
            true -> owned_name(parser, input)
            _ -> signature(parser, input)
        }
    }

    state owned_name(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.machine_has_owner = true;
        parser.machine_owner_start = parser.machine_name_start;
        parser.machine_owner_end = parser.machine_name_end;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedMachineName);
        transition parser.output.accepted {
            true -> owned_named(parser, input)
            _ -> done()
        }
    }

    state owned_named(parser: &mut Parser, input: &TokenStream) {
        parser.machine_name_start = parser.name_start;
        parser.machine_name_end = parser.name_end;
        transition { _ -> signature(parser, input) }
    }

    state signature(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_signature(parser, input);
        transition parser.output.accepted {
            true -> clauses(parser, input)
            _ -> done()
        }
    }

    state clauses(parser: &mut Parser, input: &TokenStream) {
        parser.machine_first_parameter = parser.signature_first_parameter;
        parser.machine_parameter_count = parser.signature_parameter_count;
        parser.machine_has_return_type = parser.signature_has_return_type;
        parser.machine_return_type = parser.signature_return_type;
        Parser::parse_clauses(parser, input, ClauseOwner::Machine);
        transition parser.output.accepted {
            true -> body(parser, input)
            _ -> done()
        }
    }

    state body(parser: &mut Parser, input: &TokenStream) {
        parser.machine_first_clause = parser.clause_first;
        parser.machine_clause_count = (parser.output.clause_count as u64 in Trapping) - parser.clause_first;
        Parser::expect_punctuation(parser, input, PunctuationKind::LeftBrace,
            ParseDiagnosticCode::ExpectedMachineBody
        );
        transition parser.output.accepted {
            true -> entry_statements(parser, input)
            _ -> done()
        }
    }

    state entry_statements(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_statements(parser, input, ParseDiagnosticCode::ExpectedMachineBodyEnd);
        transition parser.output.accepted {
            true -> entry_statements_retained(parser, input)
            _ -> done()
        }
    }

    state entry_statements_retained(parser: &mut Parser, input: &TokenStream) {
        parser.machine_first_statement = parser.body_first_statement;
        parser.machine_statement_count =
            (parser.output.statement_count as u64 in Trapping) - parser.body_first_statement;
        parser.machine_first_state = parser.output.state_count as u64 in Trapping;
        transition { _ -> member(parser, input) }
    }

    state member(parser: &mut Parser, input: &TokenStream) {
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBrace);
        transition closing {
            true -> close(parser, input)
            _ -> state_member(parser, input)
        }
    }

    state state_member(parser: &mut Parser, input: &TokenStream) {
        let member: bool = Parser::at_keyword(parser, input, KeywordKind::State);
        transition member {
            true -> parse_state(parser, input)
            _ -> body_end_rejected(parser, input)
        }
    }

    state parse_state(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_state_member(parser, input);
        transition parser.output.accepted {
            true -> member(parser, input)
            _ -> done()
        }
    }

    state body_end_rejected(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::ExpectedMachineBodyEnd);
    }

    state close(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition parser.output.machine_count < 256 {
            true -> retain(parser, input)
            _ -> machine_full(parser, input)
        }
    }

    state retain(parser: &mut Parser, input: &TokenStream) {
        let machine_index: u64 in Trapping = parser.output.machine_count as u64 in Trapping;
        parser.output.machines[parser.output.machine_count] = MachineItem {
            has_owner: parser.machine_has_owner,
            owner: Parser::identifier_span(parser, parser.machine_owner_start, parser.machine_owner_end),
            name: Parser::identifier_span(parser, parser.machine_name_start, parser.machine_name_end),
            first_parameter: parser.machine_first_parameter,
            parameter_count: parser.machine_parameter_count,
            has_return_type: parser.machine_has_return_type,
            return_type: parser.machine_return_type,
            first_clause: parser.machine_first_clause,
            clause_count: parser.machine_clause_count,
            first_statement: parser.machine_first_statement,
            statement_count: parser.machine_statement_count,
            first_state: parser.machine_first_state,
            state_count: (parser.output.state_count as u64 in Trapping) - parser.machine_first_state,
            is_public: parser.machine_is_public,
            source_span: Parser::source_span(parser, parser.machine_start, parser.token_end)
        };
        parser.output.machine_count = parser.output.machine_count + 1;
        transition { _ -> root(parser, input, machine_index) }
    }

    state root(parser: &mut Parser, input: &TokenStream, machine_index: u64 in Trapping) {
        transition parser.output.root_count < 256 {
            true -> root_bounded(parser, machine_index)
            _ -> root_full(parser, input)
        }
    }

    state root_bounded(parser: &mut Parser, machine_index: u64 in Trapping) {
        parser.output.roots[parser.output.root_count] = RootItem {
            kind: RootItemKind::Machine,
            item_index: machine_index,
            source_span: Parser::source_span(parser, parser.machine_start, parser.token_end)
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    state root_full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::RootCapacityExceeded);
    }

    state done() {}
}

// `state name [(parameters)] [-> Type] [requires fact]* { statements }`,
// entered at the `state` keyword.
machine Parser::parse_state_member(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    transition parser.output.state_count < 2048 {
        true -> keyword(parser, input)
        _ -> state_full(parser, input)
    }

    state state_full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::StateCapacityExceeded);
    }

    state keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.state_start = parser.token_start;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedStateName);
        transition parser.output.accepted {
            true -> signature(parser, input)
            _ -> done()
        }
    }

    state signature(parser: &mut Parser, input: &TokenStream) {
        parser.state_name_start = parser.name_start;
        parser.state_name_end = parser.name_end;
        Parser::parse_signature(parser, input);
        transition parser.output.accepted {
            true -> clauses(parser, input)
            _ -> done()
        }
    }

    state clauses(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_clauses(parser, input, ClauseOwner::State);
        transition parser.output.accepted {
            true -> body(parser, input)
            _ -> done()
        }
    }

    state body(parser: &mut Parser, input: &TokenStream) {
        parser.state_first_clause = parser.clause_first;
        parser.state_clause_count = (parser.output.clause_count as u64 in Trapping) - parser.clause_first;
        Parser::expect_punctuation(parser, input, PunctuationKind::LeftBrace,
            ParseDiagnosticCode::ExpectedStateBody
        );
        transition parser.output.accepted {
            true -> body_end(parser, input)
            _ -> done()
        }
    }

    state body_end(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_statements(parser, input, ParseDiagnosticCode::ExpectedStateBodyEnd);
        transition parser.output.accepted {
            true -> body_close(parser, input)
            _ -> done()
        }
    }

    state body_close(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::RightBrace,
            ParseDiagnosticCode::ExpectedStateBodyEnd
        );
        transition parser.output.accepted {
            true -> retain_capacity(parser)
            _ -> done()
        }
    }

    state retain_capacity(parser: &mut Parser) {
        transition parser.output.state_count < 2048 {
            true -> retain(parser)
            _ -> done()
        }
    }

    state retain(parser: &mut Parser) {
        parser.output.states[parser.output.state_count] = StateItem {
            name: Parser::identifier_span(parser, parser.state_name_start, parser.state_name_end),
            first_parameter: parser.signature_first_parameter,
            parameter_count: parser.signature_parameter_count,
            has_return_type: parser.signature_has_return_type,
            return_type: parser.signature_return_type,
            first_clause: parser.state_first_clause,
            clause_count: parser.state_clause_count,
            first_statement: parser.body_first_statement,
            statement_count: (parser.output.statement_count as u64 in Trapping) - parser.body_first_statement,
            source_span: Parser::source_span(parser, parser.state_start, parser.token_end)
        };
        parser.output.state_count = parser.output.state_count + 1;
    }

    state done() {}
}

// `[(parameters)] [-> Type]`, shared by machine and state heads. The result
// lands in the `signature_*` scratch fields.
machine Parser::parse_signature(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    parser.signature_first_parameter = parser.output.parameter_count as u64 in Trapping;
    parser.signature_parameter_count = 0;
    parser.signature_has_return_type = false;
    parser.signature_return_type = 0;
    let listed: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftParen);
    transition listed {
        true -> parameters(parser, input)
        _ -> return_type(parser, input)
    }

    state parameters(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightParen);
        transition closing {
            true -> close(parser, input)
            _ -> parameter(parser, input, ParseDiagnosticCode::ExpectedMachineParameterOrEnd)
        }
    }

    state parameter(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        transition parser.output.parameter_count < 4096 {
            true -> parameter_name(parser, input, code)
            _ -> parameter_full(parser, input)
        }
    }

    state parameter_full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::ParameterCapacityExceeded);
    }

    state parameter_name(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::expect_name(parser, input, code);
        transition parser.output.accepted {
            true -> parameter_colon(parser, input)
            _ -> done()
        }
    }

    state parameter_colon(parser: &mut Parser, input: &TokenStream) {
        parser.parameter_name_start = parser.name_start;
        parser.parameter_name_end = parser.name_end;
        Parser::expect_punctuation(parser, input, PunctuationKind::Colon,
            ParseDiagnosticCode::ExpectedMachineParameterColon
        );
        transition parser.output.accepted {
            true -> parameter_type(parser, input)
            _ -> done()
        }
    }

    state parameter_type(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedMachineParameterType);
        transition parser.output.accepted {
            true -> retain_capacity(parser, input)
            _ -> done()
        }
    }

    state retain_capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.parameter_count < 4096 {
            true -> retain(parser, input)
            _ -> parameter_full(parser, input)
        }
    }

    state retain(parser: &mut Parser, input: &TokenStream) {
        parser.output.parameters[parser.output.parameter_count] = Parameter {
            name: Parser::identifier_span(parser, parser.parameter_name_start, parser.parameter_name_end),
            type_reference: parser.type_result,
            source_span: Parser::source_span(parser, parser.parameter_name_start, parser.type_end)
        };
        parser.output.parameter_count = parser.output.parameter_count + 1;
        let separator: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition separator {
            true -> separator_taken(parser, input)
            _ -> parameter_end(parser, input)
        }
    }

    // A comma always introduces another parameter: there is no trailing comma.
    state separator_taken(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> parameter(parser, input, ParseDiagnosticCode::ExpectedMachineParameter) }
    }

    state parameter_end(parser: &mut Parser, input: &TokenStream) {
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightParen);
        transition closing {
            true -> close(parser, input)
            _ -> parameter_end_rejected(parser, input)
        }
    }

    state parameter_end_rejected(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::ExpectedMachineParameterEnd);
    }

    state close(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.signature_parameter_count =
            (parser.output.parameter_count as u64 in Trapping) - parser.signature_first_parameter;
        transition { _ -> return_type(parser, input) }
    }

    state return_type(parser: &mut Parser, input: &TokenStream) {
        let arrow: bool = Parser::at_punctuation(parser, input, PunctuationKind::Arrow);
        transition arrow {
            true -> return_type_taken(parser, input)
            _ -> done()
        }
    }

    state return_type_taken(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedMachineReturnType);
        transition parser.output.accepted {
            true -> return_type_retained(parser)
            _ -> done()
        }
    }

    state return_type_retained(parser: &mut Parser) {
        parser.signature_has_return_type = true;
        parser.signature_return_type = parser.type_result;
    }

    state done() {}
}
