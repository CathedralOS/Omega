use psi::parse::clause;
use psi::parse::generics;
use psi::parse::input;
use psi::parse::parser;
use psi::parse::statement;
use psi::parse::types;
use psi::syntax::syntax;
use psi::tokens::tokens;

// What precedes a machine declaration's `machine` keyword: where the
// declaration starts, `pub`, a target name (`linux_arm64 machine ...`),
// `boundary`, and whether it stands at the root or inside a trait or a
// conformance.
pub data MachineHead [copy] {
    start: u64 in Trapping;
    is_public: bool;
    has_target: bool;
    target_start: u64 in Trapping;
    target_end: u64 in Trapping;
    is_boundary: bool;
    container: MachineContainer;
}

// Machine-declaration grammar attached to the parser owner:
// `[pub] [target] [boundary] machine [token] [Owner::]name [<generic
// parameters>] [(parameters)] [-> Type] contracts clauses ({ statements
// state* } | ;)`, entered at the `machine` keyword with its head. A fixed
// operator token (`+`, `==`, `[]`, `[..]`, ...) binds operator syntax to the
// declaration; a conformance member supplies an implementation and binds no
// token. The `where machine` contracts of its static machine binders precede
// its other clauses. generics.omg owns the generic parameters, shared with
// data declarations; clause.omg owns the clauses and statement.omg the
// statements; the entry's statements precede the `state` members. A bodyless
// declaration ends at `;`: whether its signature has a supply (a compiler
// primitive, a requirement, a boundary provider) is checking's question, not
// the grammar's. A trait or conformance member names no owner, and only a
// root declaration is retained as a root.
pub machine Parser::parse_machine(parser: &mut Parser, input: &TokenStream, head: MachineHead)
crashes Trap
{
    parser.machine_start = head.start;
    parser.machine_is_public = head.is_public;
    parser.machine_has_target = head.has_target;
    parser.machine_target_start = head.target_start;
    parser.machine_target_end = head.target_end;
    parser.machine_is_boundary = head.is_boundary;
    parser.machine_container = head.container;
    transition parser.output.machine_count < 2048 {
        true -> keyword(parser, input)
        _ -> machine_full(parser, input)
    }

    state machine_full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::MachineCapacityExceeded);
    }

    state keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.machine_first_generic = parser.output.generic_parameter_count as u64 in Trapping;
        parser.machine_generic_count = 0;
        parser.machine_first_expression = parser.output.expression_count as u64 in Trapping;
        parser.machine_operator = OperatorToken::None;
        parser.machine_token_start = 0;
        parser.machine_token_end = 0;
        parser.machine_first_component = 0;
        parser.machine_component_count = 0;
        Parser::parse_operator_token(parser, input);
        let tokened: bool = parser.machine_operator != OperatorToken::None;
        let member: bool = parser.machine_container == MachineContainer::Conformance;
        transition parser.output.accepted {
            true -> token_admitted(parser, input, tokened && member)
            _ -> done()
        }
    }

    // A conformance supplies its trait's requirements and binds no token.
    state token_admitted(parser: &mut Parser, input: &TokenStream, refused: bool) {
        transition refused {
            true -> token_refused(parser)
            _ -> name(parser, input)
        }
    }

    state token_refused(parser: &mut Parser) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::OperatorTokenNotAdmitted,
            parser.source, parser.machine_token_start, parser.machine_token_end);
    }

    state name(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedMachineName);
        transition parser.output.accepted {
            true -> first_name(parser, input)
            _ -> done()
        }
    }

    state first_name(parser: &mut Parser, input: &TokenStream) {
        parser.machine_has_owner = false;
        parser.machine_owner_start = 0;
        parser.machine_owner_end = 0;
        parser.machine_name_start = parser.name_start;
        parser.machine_name_end = parser.name_end;
        let separator: bool = Parser::at_punctuation(parser, input, PunctuationKind::ColonColon);
        let at_root: bool = Parser::machine_at_root(parser.machine_container);
        transition separator && at_root {
            true -> owned_name(parser, input)
            _ -> generic_list(parser, input)
        }
    }

    state owned_name(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.machine_has_owner = true;
        parser.machine_owner_start = parser.machine_name_start;
        parser.machine_owner_end = parser.machine_name_end;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedMachineName);
        transition parser.output.accepted {
            true -> owned_named(parser, input)
            _ -> done()
        }
    }

    state owned_named(parser: &mut Parser, input: &TokenStream) {
        parser.machine_name_start = parser.name_start;
        parser.machine_name_end = parser.name_end;
        transition { _ -> generic_list(parser, input) }
    }

    state generic_list(parser: &mut Parser, input: &TokenStream) {
        let generic: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        let ordered: bool = parser.machine_container == MachineContainer::Measure
            && Parser::at_word(parser, input, "lexicographic");
        transition generic {
            true -> generics(parser, input)
            _ -> lexicographic_word(parser, input, ordered)
        }
    }

    state lexicographic_word(parser: &mut Parser, input: &TokenStream, ordered: bool) {
        transition ordered {
            true -> components_open(parser, input)
            _ -> signature(parser, input)
        }
    }

    // `lexicographic { field, field }`: a bodyless measure ranking by the
    // tuple of its owner's named fields, kept as a member run.
    state components_open(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.machine_first_component = parser.output.member_count as u64 in Trapping;
        Parser::expect_punctuation(parser, input, PunctuationKind::LeftBrace, ParseDiagnosticCode::ExpectedMeasureComponent);
        transition parser.output.accepted {
            true -> component(parser, input)
            _ -> done()
        }
    }

    state component(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedMeasureComponent);
        transition parser.output.accepted && parser.output.member_count < 32000 {
            true -> component_retained(parser, input)
            _ -> component_full(parser, input)
        }
    }

    state component_full(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.accepted {
            true -> rejected(parser, input, ParseDiagnosticCode::PathMemberCapacityExceeded)
            _ -> done()
        }
    }

    state component_retained(parser: &mut Parser, input: &TokenStream) {
        parser.output.members[parser.output.member_count] = Parser::identifier_span(parser, parser.name_start, parser.name_end);
        parser.output.member_count = parser.output.member_count + 1;
        parser.machine_component_count = parser.machine_component_count + 1;
        let more: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition more {
            true -> component_separator(parser, input)
            _ -> components_close(parser, input)
        }
    }

    state component_separator(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> component(parser, input) }
    }

    // A lexicographic measure owns empty parameter, clause, statement, state
    // and contract ranges at the tables' ends.
    state components_close(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::RightBrace, ParseDiagnosticCode::ExpectedMeasureComponent);
        parser.machine_first_parameter = parser.output.parameter_count as u64 in Trapping;
        parser.machine_parameter_count = 0;
        parser.machine_has_return_type = false;
        parser.machine_return_type = 0;
        parser.machine_first_clause = parser.output.clause_count as u64 in Trapping;
        parser.machine_clause_count = 0;
        parser.machine_first_statement = parser.output.statement_count as u64 in Trapping;
        parser.machine_statement_count = 0;
        parser.machine_first_state = parser.output.state_count as u64 in Trapping;
        parser.machine_first_contract = parser.output.contract_count as u64 in Trapping;
        transition parser.output.accepted && parser.output.machine_count < 2048 {
            true -> retain(parser, input, false)
            _ -> components_rejected(parser, input)
        }
    }

    state components_rejected(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.accepted {
            true -> machine_full(parser, input)
            _ -> done()
        }
    }

    state rejected(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state generics(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_generic_parameters(parser, input);
        parser.machine_generic_count =
            (parser.output.generic_parameter_count as u64 in Trapping) - parser.machine_first_generic;
        transition parser.output.accepted {
            true -> signature(parser, input)
            _ -> done()
        }
    }

    state signature(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_signature(parser, input);
        transition parser.output.accepted {
            true -> clauses(parser, input)
            _ -> done()
        }
    }

    state clauses(parser: &mut Parser, input: &TokenStream) {
        parser.machine_first_parameter = parser.signature_first_parameter;
        parser.machine_parameter_count = parser.signature_parameter_count;
        parser.machine_has_return_type = parser.signature_has_return_type;
        parser.machine_return_type = parser.signature_return_type;
        let owner: ClauseOwner = Parser::machine_clause_owner(parser.machine_container);
        Parser::parse_machine_contracts(parser, input, owner);
        transition parser.output.accepted {
            true -> own_clauses(parser, input, owner)
            _ -> done()
        }
    }

    state own_clauses(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::parse_clauses(parser, input, owner);
        transition parser.output.accepted {
            true -> body(parser, input, owner)
            _ -> done()
        }
    }

    // The return type may follow clauses (`terminates by n; -> u64`), more
    // clauses after it continuing the same contiguous run.
    state body(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        parser.machine_first_clause = parser.clause_first;
        let late_return: bool = !parser.machine_has_return_type
            && Parser::at_punctuation(parser, input, PunctuationKind::Arrow);
        transition late_return {
            true -> late_return_type(parser, input, owner)
            _ -> header_end(parser, input)
        }
    }

    state late_return_type(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let first_clause: u64 in Trapping = parser.machine_first_clause;
        Parser::take_current(parser, input);
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedMachineReturnType);
        parser.machine_has_return_type = true;
        parser.machine_return_type = parser.type_result;
        transition parser.output.accepted {
            true -> late_clauses(parser, input, owner, first_clause)
            _ -> done()
        }
    }

    state late_clauses(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, first_clause: u64 in Trapping) {
        Parser::parse_clauses(parser, input, owner);
        parser.machine_first_clause = first_clause;
        transition parser.output.accepted {
            true -> header_end(parser, input)
            _ -> done()
        }
    }

    state header_end(parser: &mut Parser, input: &TokenStream) {
        parser.machine_clause_count = (parser.output.clause_count as u64 in Trapping) - parser.machine_first_clause;
        let bodyless: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition bodyless {
            true -> signature_end(parser, input)
            _ -> body_open(parser, input)
        }
    }

    state body_open(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::LeftBrace,
            ParseDiagnosticCode::ExpectedMachineBody
        );
        transition parser.output.accepted {
            true -> entry_statements(parser, input)
            _ -> done()
        }
    }

    // A bodyless declaration owns empty statement and state ranges at the
    // tables' ends.
    state signature_end(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.machine_first_statement = parser.output.statement_count as u64 in Trapping;
        parser.machine_statement_count = 0;
        parser.machine_first_state = parser.output.state_count as u64 in Trapping;
        transition parser.output.machine_count < 2048 {
            true -> retain(parser, input, false)
            _ -> machine_full(parser, input)
        }
    }

    state entry_statements(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_statements(parser, input, ParseDiagnosticCode::ExpectedMachineBodyEnd);
        transition parser.output.accepted {
            true -> entry_statements_retained(parser, input)
            _ -> done()
        }
    }

    state entry_statements_retained(parser: &mut Parser, input: &TokenStream) {
        parser.machine_first_statement = parser.body_first_statement;
        parser.machine_statement_count =
            (parser.output.statement_count as u64 in Trapping) - parser.body_first_statement;
        parser.machine_first_state = parser.output.state_count as u64 in Trapping;
        transition { _ -> member(parser, input) }
    }

    state member(parser: &mut Parser, input: &TokenStream) {
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBrace);
        transition closing {
            true -> close(parser, input)
            _ -> state_member(parser, input)
        }
    }

    state state_member(parser: &mut Parser, input: &TokenStream) {
        let member: bool = Parser::at_keyword(parser, input, KeywordKind::State);
        transition member {
            true -> parse_state(parser, input)
            _ -> body_end_rejected(parser, input)
        }
    }

    state parse_state(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_state_member(parser, input);
        transition parser.output.accepted {
            true -> member(parser, input)
            _ -> done()
        }
    }

    state body_end_rejected(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::ExpectedMachineBodyEnd);
    }

    state close(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition parser.output.machine_count < 2048 {
            true -> retain(parser, input, true)
            _ -> machine_full(parser, input)
        }
    }

    state retain(parser: &mut Parser, input: &TokenStream, has_body: bool) {
        let machine_index: u64 in Trapping = parser.output.machine_count as u64 in Trapping;
        parser.output.machines[parser.output.machine_count] = MachineItem {
            has_owner: parser.machine_has_owner,
            owner: Parser::identifier_span(parser, parser.machine_owner_start, parser.machine_owner_end),
            name: Parser::identifier_span(parser, parser.machine_name_start, parser.machine_name_end),
            first_generic_parameter: parser.machine_first_generic,
            generic_parameter_count: parser.machine_generic_count,
            first_parameter: parser.machine_first_parameter,
            parameter_count: parser.machine_parameter_count,
            has_return_type: parser.machine_has_return_type,
            return_type: parser.machine_return_type,
            first_clause: parser.machine_first_clause,
            clause_count: parser.machine_clause_count,
            first_statement: parser.machine_first_statement,
            statement_count: parser.machine_statement_count,
            first_state: parser.machine_first_state,
            state_count: (parser.output.state_count as u64 in Trapping) - parser.machine_first_state,
            has_body: has_body,
            first_expression: parser.machine_first_expression,
            expression_count: (parser.output.expression_count as u64 in Trapping) - parser.machine_first_expression,
            has_target: parser.machine_has_target,
            target: Parser::identifier_span(parser, parser.machine_target_start, parser.machine_target_end),
            is_boundary: parser.machine_is_boundary,
            container: parser.machine_container,
            is_public: parser.machine_is_public,
            operator: parser.machine_operator,
            token: Parser::identifier_span(parser, parser.machine_token_start, parser.machine_token_end),
            first_contract: parser.machine_first_contract,
            contract_count: (parser.output.contract_count as u64 in Trapping) - parser.machine_first_contract,
            every_requirement: false,
            first_component: parser.machine_first_component,
            component_count: parser.machine_component_count,
            source_span: Parser::source_span(parser, parser.machine_start, parser.token_end)
        };
        parser.output.machine_count = parser.output.machine_count + 1;
        let at_root: bool = Parser::machine_at_root(parser.machine_container);
        transition at_root {
            true -> root(parser, input, machine_index)
            _ -> done()
        }
    }

    state root(parser: &mut Parser, input: &TokenStream, machine_index: u64 in Trapping) {
        transition parser.output.root_count < 4096 {
            true -> root_bounded(parser, machine_index)
            _ -> root_full(parser, input)
        }
    }

    state root_bounded(parser: &mut Parser, machine_index: u64 in Trapping) {
        parser.output.roots[parser.output.root_count] = RootItem {
            kind: RootItemKind::Machine,
            item_index: machine_index,
            source_span: Parser::source_span(parser, parser.machine_start, parser.token_end)
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    state root_full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::RootCapacityExceeded);
    }

    state done() {}
}

// `state name [(parameters)] [-> Type] [requires fact]* { statements }`,
// entered at the `state` keyword.
machine Parser::parse_state_member(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    transition parser.output.state_count < 8192 {
        true -> keyword(parser, input)
        _ -> state_full(parser, input)
    }

    state state_full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::StateCapacityExceeded);
    }

    state keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.state_start = parser.token_start;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedStateName);
        transition parser.output.accepted {
            true -> signature(parser, input)
            _ -> done()
        }
    }

    state signature(parser: &mut Parser, input: &TokenStream) {
        parser.state_name_start = parser.name_start;
        parser.state_name_end = parser.name_end;
        Parser::parse_signature(parser, input);
        transition parser.output.accepted {
            true -> clauses(parser, input)
            _ -> done()
        }
    }

    state clauses(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_clauses(parser, input, ClauseOwner::State);
        transition parser.output.accepted {
            true -> body(parser, input)
            _ -> done()
        }
    }

    state body(parser: &mut Parser, input: &TokenStream) {
        parser.state_first_clause = parser.clause_first;
        parser.state_clause_count = (parser.output.clause_count as u64 in Trapping) - parser.clause_first;
        Parser::expect_punctuation(parser, input, PunctuationKind::LeftBrace,
            ParseDiagnosticCode::ExpectedStateBody
        );
        transition parser.output.accepted {
            true -> body_end(parser, input)
            _ -> done()
        }
    }

    state body_end(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_statements(parser, input, ParseDiagnosticCode::ExpectedStateBodyEnd);
        transition parser.output.accepted {
            true -> body_close(parser, input)
            _ -> done()
        }
    }

    state body_close(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::RightBrace,
            ParseDiagnosticCode::ExpectedStateBodyEnd
        );
        transition parser.output.accepted {
            true -> retain_capacity(parser)
            _ -> done()
        }
    }

    state retain_capacity(parser: &mut Parser) {
        transition parser.output.state_count < 8192 {
            true -> retain(parser)
            _ -> done()
        }
    }

    state retain(parser: &mut Parser) {
        parser.output.states[parser.output.state_count] = StateItem {
            name: Parser::identifier_span(parser, parser.state_name_start, parser.state_name_end),
            first_parameter: parser.signature_first_parameter,
            parameter_count: parser.signature_parameter_count,
            has_return_type: parser.signature_has_return_type,
            return_type: parser.signature_return_type,
            first_clause: parser.state_first_clause,
            clause_count: parser.state_clause_count,
            first_statement: parser.body_first_statement,
            statement_count: (parser.output.statement_count as u64 in Trapping) - parser.body_first_statement,
            source_span: Parser::source_span(parser, parser.state_start, parser.token_end)
        };
        parser.output.state_count = parser.output.state_count + 1;
    }

    state done() {}
}

// A trait member reads its clauses as a trait member: `requires` after its
// `;` is the trait's body parent.
machine Parser::machine_clause_owner(container: MachineContainer) -> ClauseOwner {
    transition container {
        MachineContainer::Trait -> member()
        _ -> declaration()
    }

    state member() {
        ClauseOwner::TraitMember
    }

    state declaration() {
        ClauseOwner::Machine
    }
}

// The optional fixed token after `machine`, from the closed vocabulary of
// wiki/spec/language/expressions.md: an arithmetic or comparison token,
// `[]` or `[..]`. Any other token leaves no token, and the name follows.
// The token lands in `machine_operator` and its span in `machine_token_*`.
machine Parser::parse_operator_token(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    Parser::load_current(parser, input);
    transition parser.current_present {
        true -> token(parser, input)
        _ -> done()
    }

    state token(parser: &mut Parser, input: &TokenStream) {
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Punctuation { punctuation: PunctuationKind::Plus } -> single(parser, input, OperatorToken::Add)
            Token::Punctuation { punctuation: PunctuationKind::Minus } -> single(parser, input, OperatorToken::Subtract)
            Token::Punctuation { punctuation: PunctuationKind::Asterisk } -> single(parser, input, OperatorToken::Multiply)
            Token::Punctuation { punctuation: PunctuationKind::Slash } -> single(parser, input, OperatorToken::Divide)
            Token::Punctuation { punctuation: PunctuationKind::Percent } -> single(parser, input, OperatorToken::Modulo)
            Token::Punctuation { punctuation: PunctuationKind::EqualEqual } -> single(parser, input, OperatorToken::Equal)
            Token::Punctuation { punctuation: PunctuationKind::ExclamationEqual } -> single(parser, input, OperatorToken::NotEqual)
            Token::Punctuation { punctuation: PunctuationKind::Less } -> single(parser, input, OperatorToken::Less)
            Token::Punctuation { punctuation: PunctuationKind::LessEqual } -> single(parser, input, OperatorToken::LessEqual)
            Token::Punctuation { punctuation: PunctuationKind::Greater } -> single(parser, input, OperatorToken::Greater)
            Token::Punctuation { punctuation: PunctuationKind::GreaterEqual } -> single(parser, input, OperatorToken::GreaterEqual)
            Token::Punctuation { punctuation: PunctuationKind::LeftBracket } -> bracket(parser, input)
            _ -> done()
        }
    }

    state single(parser: &mut Parser, input: &TokenStream, operator: OperatorToken) {
        Parser::take_current(parser, input);
        parser.machine_token_start = parser.token_start;
        transition { _ -> close(parser, operator) }
    }

    // `[]` indexes and `[..]` slices a range.
    state bracket(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.machine_token_start = parser.token_start;
        let ranged: bool = Parser::at_punctuation(parser, input, PunctuationKind::DotDot);
        transition ranged {
            true -> range(parser, input)
            _ -> bracket_close(parser, input, OperatorToken::Index)
        }
    }

    state range(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> bracket_close(parser, input, OperatorToken::Range) }
    }

    state bracket_close(parser: &mut Parser, input: &TokenStream, operator: OperatorToken) {
        Parser::expect_punctuation(parser, input, PunctuationKind::RightBracket, ParseDiagnosticCode::UnknownOperatorToken);
        transition parser.output.accepted {
            true -> close(parser, operator)
            _ -> done()
        }
    }

    state close(parser: &mut Parser, operator: OperatorToken) {
        parser.machine_operator = operator;
        parser.machine_token_end = parser.token_end;
    }

    state done() {}
}

// `where machine Name [<generic parameters>] [(parameters)] [-> Type]
// clauses`, the contracts of a machine head's static machine binders,
// entered after its signature. A contract ends at its `;` or at the next
// `where machine`; its clauses never read past that `;`, which belongs to
// the contract only while the declaration continues after it. A contract
// may name a binder of an earlier contract's own generic parameters, so
// contracts form one flat list whose binders resolution matches. The range
// lands in `machine_first_contract` and the table count.
pub machine Parser::parse_machine_contracts(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner)
crashes Trap
{
    parser.machine_first_contract = parser.output.contract_count as u64 in Trapping;
    transition { _ -> next(parser, input, owner) }

    state next(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let facts: bool = Parser::at_word(parser, input, "where");
        let contract: bool = Parser::next_is_keyword(parser, input, KeywordKind::Machine);
        transition facts && contract {
            true -> capacity(parser, input, owner)
            _ -> done()
        }
    }

    state capacity(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        transition parser.output.contract_count < 256 {
            true -> introduced(parser, input, owner)
            _ -> reject(parser, input, ParseDiagnosticCode::ContractCapacityExceeded)
        }
    }

    state introduced(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let token: Token = input.tokens[parser.current_index];
        parser.contract_start = token.start;
        Parser::take_current(parser, input);
        Parser::take_current(parser, input);
        parser.contract_first_generic = parser.output.generic_parameter_count as u64 in Trapping;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedContractName);
        transition parser.output.accepted {
            true -> named(parser, input, owner)
            _ -> done()
        }
    }

    state named(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        parser.contract_name_start = parser.name_start;
        parser.contract_name_end = parser.name_end;
        let generic: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        transition generic {
            true -> generics(parser, input, owner)
            _ -> signature(parser, input, owner)
        }
    }

    state generics(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::parse_generic_parameters(parser, input);
        transition parser.output.accepted {
            true -> signature(parser, input, owner)
            _ -> done()
        }
    }

    state signature(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::parse_signature(parser, input);
        transition parser.output.accepted {
            true -> clauses(parser, input, owner)
            _ -> done()
        }
    }

    state clauses(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::parse_clauses(parser, input, ClauseOwner::Contract);
        let semicolon: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition parser.output.accepted {
            true -> end(parser, input, owner, semicolon)
            _ -> done()
        }
    }

    state end(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, semicolon: bool) {
        let facts: bool = Parser::at_word(parser, input, "where");
        let contract: bool = Parser::next_is_keyword(parser, input, KeywordKind::Machine);
        transition semicolon {
            true -> semicolon_end(parser, input, owner)
            _ -> following(parser, input, owner, facts && contract)
        }
    }

    state following(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, contract: bool) {
        transition contract {
            true -> retain(parser, input, owner, parser.token_end)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedContractEnd)
        }
    }

    state semicolon_end(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let token: Token = input.tokens[parser.current_index];
        let continuation: ClauseContinuation = Parser::after_clause_semicolon(parser, input, owner);
        transition continuation {
            ClauseContinuation::Clause -> semicolon_taken(parser, input, owner, token.end)
            _ -> retain(parser, input, owner, token.end)
        }
    }

    state semicolon_taken(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, end: u64 in Trapping) {
        Parser::take_current(parser, input);
        transition { _ -> retain(parser, input, owner, end) }
    }

    state retain(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, end: u64 in Trapping) {
        let contract: Contract = Contract {
            kind: ContractKind::Machine,
            name: Parser::identifier_span(parser, parser.contract_name_start, parser.contract_name_end),
            first_generic_parameter: parser.contract_first_generic,
            generic_parameter_count: (parser.output.generic_parameter_count as u64 in Trapping) - parser.contract_first_generic,
            first_parameter: parser.signature_first_parameter,
            parameter_count: parser.signature_parameter_count,
            has_return_type: parser.signature_has_return_type,
            return_type: parser.signature_return_type,
            first_clause: parser.clause_first,
            clause_count: (parser.output.clause_count as u64 in Trapping) - parser.clause_first,
            source_span: Parser::source_span(parser, parser.contract_start, end)
        };
        Parser::retain_contract(parser, input, contract);
        transition parser.output.accepted {
            true -> next(parser, input, owner)
            _ -> done()
        }
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state done() {}
}

// Append one contract row.
pub machine Parser::retain_contract(parser: &mut Parser, input: &TokenStream, contract: Contract)
crashes Trap
{
    transition parser.output.contract_count < 256 {
        true -> append(parser, contract)
        _ -> full(parser, input)
    }

    state append(parser: &mut Parser, contract: Contract) {
        parser.output.contracts[parser.output.contract_count] = contract;
        parser.output.contract_count = parser.output.contract_count + 1;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::ContractCapacityExceeded);
    }
}

machine Parser::machine_at_root(container: MachineContainer) -> bool {
    transition container {
        MachineContainer::Root -> root()
        MachineContainer::Measure -> root()
        _ -> member()
    }

    state root() {
        true
    }

    state member() {
        false
    }
}

// `[(parameters)] [-> Type]`, shared by machine and state heads. The result
// lands in the `signature_*` scratch fields.
machine Parser::parse_signature(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    Parser::parse_parameters(parser, input);
    parser.signature_has_return_type = false;
    parser.signature_return_type = 0;
    transition parser.output.accepted {
        true -> return_type(parser, input)
        _ -> done()
    }

    state return_type(parser: &mut Parser, input: &TokenStream) {
        let arrow: bool = Parser::at_punctuation(parser, input, PunctuationKind::Arrow);
        transition arrow {
            true -> return_type_taken(parser, input)
            _ -> done()
        }
    }

    state return_type_taken(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedMachineReturnType);
        transition parser.output.accepted {
            true -> return_type_retained(parser)
            _ -> done()
        }
    }

    state return_type_retained(parser: &mut Parser) {
        parser.signature_has_return_type = true;
        parser.signature_return_type = parser.type_result;
    }

    state done() {}
}

// `[([mut] name: Type, ...)]`, the parameter list of a machine, state or
// proposition head; `mut` lets the body assign the parameter. The range lands in `signature_first_parameter` and
// `signature_parameter_count`.
machine Parser::parse_parameters(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    parser.signature_first_parameter = parser.output.parameter_count as u64 in Trapping;
    parser.signature_parameter_count = 0;
    let listed: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftParen);
    transition listed {
        true -> parameters(parser, input)
        _ -> done()
    }

    state parameters(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightParen);
        transition closing {
            true -> close(parser, input)
            _ -> parameter(parser, input, ParseDiagnosticCode::ExpectedMachineParameterOrEnd)
        }
    }

    state parameter(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        transition parser.output.parameter_count < 32768 {
            true -> parameter_name(parser, input, code)
            _ -> parameter_full(parser, input)
        }
    }

    state parameter_full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::ParameterCapacityExceeded);
    }

    // `mut` before a name marks the parameter mutable; a parameter named
    // `mut` is followed by its colon.
    state parameter_name(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        let marked: bool = Parser::at_word(parser, input, "mut");
        let named: bool = Parser::next_is_punctuation(parser, input, PunctuationKind::Colon);
        parser.parameter_mutable = marked && !named;
        transition marked && !named {
            true -> mutable_name(parser, input, code)
            _ -> parameter_named(parser, input, code)
        }
    }

    state mutable_name(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::take_current(parser, input);
        transition { _ -> parameter_named(parser, input, code) }
    }

    state parameter_named(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::expect_name(parser, input, code);
        transition parser.output.accepted {
            true -> parameter_marker(parser, input)
            _ -> done()
        }
    }

    state parameter_marker(parser: &mut Parser, input: &TokenStream) {
        parser.parameter_name_start = parser.name_start;
        parser.parameter_name_end = parser.name_end;
        Parser::parse_erased_marker(parser, input);
        transition parser.output.accepted {
            true -> parameter_colon(parser, input)
            _ -> done()
        }
    }

    state parameter_colon(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Colon,
            ParseDiagnosticCode::ExpectedMachineParameterColon
        );
        transition parser.output.accepted {
            true -> parameter_type(parser, input)
            _ -> done()
        }
    }

    state parameter_type(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedMachineParameterType);
        transition parser.output.accepted {
            true -> retain_capacity(parser, input)
            _ -> done()
        }
    }

    state retain_capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.parameter_count < 32768 {
            true -> retain(parser, input)
            _ -> parameter_full(parser, input)
        }
    }

    state retain(parser: &mut Parser, input: &TokenStream) {
        let parameter: u64 in Trapping = parser.output.parameter_count as u64 in Trapping;
        let type_end: u64 in Trapping = parser.type_end;
        Parser::record_erased(parser, ErasedBindingKind::Parameter, parameter, type_end);
        parser.output.parameters[parser.output.parameter_count] = Parameter {
            name: Parser::identifier_span(parser, parser.parameter_name_start, parser.parameter_name_end),
            type_reference: parser.type_result,
            is_mutable: parser.parameter_mutable,
            source_span: Parser::source_span(parser, parser.parameter_name_start, parser.type_end)
        };
        parser.output.parameter_count = parser.output.parameter_count + 1;
        let separator: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition separator {
            true -> separator_taken(parser, input)
            _ -> parameter_end(parser, input)
        }
    }

    // A comma always introduces another parameter: there is no trailing comma.
    state separator_taken(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> parameter(parser, input, ParseDiagnosticCode::ExpectedMachineParameter) }
    }

    state parameter_end(parser: &mut Parser, input: &TokenStream) {
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightParen);
        transition closing {
            true -> close(parser, input)
            _ -> parameter_end_rejected(parser, input)
        }
    }

    state parameter_end_rejected(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::ExpectedMachineParameterEnd);
    }

    state close(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.signature_parameter_count =
            (parser.output.parameter_count as u64 in Trapping) - parser.signature_first_parameter;
    }

    state done() {}
}
