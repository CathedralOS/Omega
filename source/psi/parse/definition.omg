use psi::parse::expression;
use psi::parse::generics;
use psi::parse::input;
use psi::parse::machine;
use psi::parse::parser;
use psi::parse::types;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

// `[public] [boundary] let Name [<generic parameters>] [(parameters)] : Type
// [= term];`, a named mathematical definition (wiki/spec/proofs/
// mathematical_bindings.md), entered at the `let` keyword. A checked
// definition gives its term after `=`; `boundary let` is the same signature
// without a term, an explicitly admitted assumption. The generic parameters
// and parameters share the machine grammars. The item and its root are
// retained at the closing `;`.
public machine Parser::parse_definition(
    parser: &mut Parser,
    input: &TokenStream,
    item_start: u64 in Trapping,
    is_public: bool,
    is_boundary: bool
)
crashes Trap
{
    parser.declaration_start = item_start;
    parser.declaration_is_public = is_public;
    parser.declaration_is_boundary = is_boundary;
    transition parser.output.definition_count < 256 {
        true -> keyword(parser, input)
        _ -> reject(parser, input, ParseDiagnosticCode::DefinitionCapacityExceeded)
    }

    machine keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.declaration_first_generic = parser.output.generic_parameter_count as u64 in Trapping;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedDefinitionName);
        transition parser.output.accepted {
            true -> named(parser, input)
            _ -> done()
        }
    }

    machine named(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_name_start = parser.name_start;
        parser.declaration_name_end = parser.name_end;
        let generic: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        transition generic {
            true -> generics(parser, input)
            _ -> parameters(parser, input)
        }
    }

    machine generics(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_generic_parameters(parser, input);
        transition parser.output.accepted {
            true -> parameters(parser, input)
            _ -> done()
        }
    }

    machine parameters(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_parameters(parser, input);
        transition parser.output.accepted {
            true -> colon(parser, input)
            _ -> done()
        }
    }

    machine colon(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_first_parameter = parser.signature_first_parameter;
        parser.declaration_parameter_count = parser.signature_parameter_count;
        Parser::expect_punctuation(parser, input, PunctuationKind::Colon, ParseDiagnosticCode::ExpectedDefinitionColon);
        transition parser.output.accepted {
            true -> result_type(parser, input)
            _ -> done()
        }
    }

    machine result_type(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedDefinitionType);
        transition parser.output.accepted {
            true -> body(parser, input, parser.type_result)
            _ -> done()
        }
    }

    // An assumption ends at its signature; a checked definition owes a term.
    machine body(parser: &mut Parser, input: &TokenStream, result: u64 in Trapping) {
        transition parser.declaration_is_boundary {
            true -> end(parser, input, result, false, 0)
            _ -> equals(parser, input, result)
        }
    }

    machine equals(parser: &mut Parser, input: &TokenStream, result: u64 in Trapping) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Equal, ParseDiagnosticCode::ExpectedDefinitionTerm);
        transition parser.output.accepted {
            true -> term(parser, input, result)
            _ -> done()
        }
    }

    machine term(parser: &mut Parser, input: &TokenStream, result: u64 in Trapping) {
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedDefinitionTerm, true, true);
        transition parser.output.accepted {
            true -> end(parser, input, result, true, parser.expression_result)
            _ -> done()
        }
    }

    machine end(parser: &mut Parser, input: &TokenStream, result: u64 in Trapping, has_term: bool, term: u64 in Trapping) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedDefinitionEnd);
        transition parser.output.accepted {
            true -> retain_capacity(parser, input, result, has_term, term)
            _ -> done()
        }
    }

    machine retain_capacity(parser: &mut Parser, input: &TokenStream, result: u64 in Trapping, has_term: bool, term: u64 in Trapping) {
        transition parser.output.definition_count < 256 {
            true -> root_capacity(parser, input, result, has_term, term)
            _ -> reject(parser, input, ParseDiagnosticCode::DefinitionCapacityExceeded)
        }
    }

    machine root_capacity(parser: &mut Parser, input: &TokenStream, result: u64 in Trapping, has_term: bool, term: u64 in Trapping) {
        transition parser.output.root_count < 4096 {
            true -> retain(parser, result, has_term, term)
            _ -> reject(parser, input, ParseDiagnosticCode::RootCapacityExceeded)
        }
    }

    machine retain(parser: &mut Parser, result: u64 in Trapping, has_term: bool, term: u64 in Trapping) {
        let definition: u64 in Trapping = parser.output.definition_count as u64 in Trapping;
        let span: SourceSpan = Parser::source_span(parser, parser.declaration_start, parser.token_end);
        parser.output.definitions[parser.output.definition_count] = DefinitionItem {
            name: Parser::identifier_span(parser, parser.declaration_name_start, parser.declaration_name_end),
            first_generic_parameter: parser.declaration_first_generic,
            generic_parameter_count: (parser.output.generic_parameter_count as u64 in Trapping) - parser.declaration_first_generic,
            first_parameter: parser.declaration_first_parameter,
            parameter_count: parser.declaration_parameter_count,
            result_type: result,
            has_term: has_term,
            term: term,
            is_boundary: parser.declaration_is_boundary,
            is_public: parser.declaration_is_public,
            source_span: span
        };
        parser.output.definition_count = parser.output.definition_count + 1;
        parser.output.roots[parser.output.root_count] = RootItem {
            kind: RootItemKind::Definition,
            item_index: definition,
            source_span: span
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    machine reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    machine done() {}
}
