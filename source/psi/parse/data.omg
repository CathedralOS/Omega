use psi::parse::clause;
use psi::parse::generics;
use psi::parse::input;
use psi::parse::parser;
use psi::parse::types;
use psi::syntax::syntax;
use psi::tokens::tokens;

// `[pub] data Name [<generic parameters>] [properties] [where facts]
// { members }`, entered at the `data` keyword. Members are fields
// `name: Type;` and cases `case Name [(payload fields)] [where facts];`, in
// any order; `case: Type;` is a field named `case`. Every completed member is
// retained at once, so a rejection keeps each member before it; the item and
// its root are retained at the closing `}`.
pub machine Parser::parse_data(
    parser: &mut Parser,
    input: &TokenStream,
    item_start: u64 in Trapping,
    is_public: bool
)
crashes Trap
{
    parser.data_item_start = item_start;
    parser.data_is_public = is_public;
    transition parser.output.root_count < 256 {
        true -> capacity(parser, input)
        _ -> reject(parser, input, ParseDiagnosticCode::RootCapacityExceeded)
    }

    state capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.data_count < 256 {
            true -> keyword(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::DataCapacityExceeded)
        }
    }

    state keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.data_first_member = parser.output.data_member_count as u64 in Trapping;
        parser.data_first_field = parser.output.field_count as u64 in Trapping;
        parser.data_first_case = parser.output.case_count as u64 in Trapping;
        parser.data_first_generic = parser.output.generic_parameter_count as u64 in Trapping;
        parser.data_multiplicity = DataMultiplicity::Affine;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedDataName);
        transition parser.output.accepted {
            true -> named(parser, input)
            _ -> done()
        }
    }

    state named(parser: &mut Parser, input: &TokenStream) {
        parser.data_name_start = parser.name_start;
        parser.data_name_end = parser.name_end;
        let generic: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        transition generic {
            true -> generics(parser, input)
            _ -> properties(parser, input)
        }
    }

    state generics(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_generic_parameters(parser, input);
        transition parser.output.accepted {
            true -> properties(parser, input)
            _ -> done()
        }
    }

    state properties(parser: &mut Parser, input: &TokenStream) {
        let bracket: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBracket);
        transition bracket {
            true -> property_list(parser, input)
            _ -> clauses(parser, input)
        }
    }

    state property_list(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_properties(parser, input);
        parser.data_multiplicity = parser.property_multiplicity;
        transition parser.output.accepted {
            true -> clauses(parser, input)
            _ -> done()
        }
    }

    state clauses(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_clauses(parser, input, ClauseOwner::Data);
        transition parser.output.accepted {
            true -> body(parser, input)
            _ -> done()
        }
    }

    state body(parser: &mut Parser, input: &TokenStream) {
        parser.data_first_clause = parser.clause_first;
        parser.data_clause_count = (parser.output.clause_count as u64 in Trapping) - parser.clause_first;
        Parser::expect_punctuation(parser, input, PunctuationKind::LeftBrace, ParseDiagnosticCode::ExpectedDataBody);
        transition parser.output.accepted {
            true -> member(parser, input)
            _ -> done()
        }
    }

    state member(parser: &mut Parser, input: &TokenStream) {
        let close: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBrace);
        let alternative: bool = Parser::at_keyword(parser, input, KeywordKind::Case);
        transition close {
            true -> close(parser, input)
            _ -> member_kind(parser, input, alternative)
        }
    }

    state member_kind(parser: &mut Parser, input: &TokenStream, alternative: bool) {
        transition alternative {
            true -> case_word(parser, input)
            _ -> field_capacity(parser, input)
        }
    }

    // `case` is contextual: `case: Type;` is a field named `case`.
    state case_word(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.member_start = parser.token_start;
        parser.member_name_start = parser.token_start;
        parser.member_name_end = parser.token_end;
        let field: bool = Parser::at_punctuation(parser, input, PunctuationKind::Colon);
        transition field {
            true -> case_field_capacity(parser, input)
            _ -> case_capacity(parser, input)
        }
    }

    state case_field_capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.field_count < 1024 && parser.output.data_member_count < 1024 {
            true -> field_colon(parser, input)
            _ -> field_full(parser, input)
        }
    }

    state field_capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.field_count < 1024 && parser.output.data_member_count < 1024 {
            true -> field_name(parser, input)
            _ -> field_full(parser, input)
        }
    }

    state field_full(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.field_count < 1024 {
            true -> reject(parser, input, ParseDiagnosticCode::DataMemberCapacityExceeded)
            _ -> reject(parser, input, ParseDiagnosticCode::DataFieldCapacityExceeded)
        }
    }

    state field_name(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedDataFieldColon);
        parser.member_start = parser.name_start;
        parser.member_name_start = parser.name_start;
        parser.member_name_end = parser.name_end;
        transition parser.output.accepted {
            true -> field_colon(parser, input)
            _ -> done()
        }
    }

    state field_colon(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Colon, ParseDiagnosticCode::ExpectedDataFieldColon);
        transition parser.output.accepted {
            true -> field_type(parser, input)
            _ -> done()
        }
    }

    state field_type(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedDataFieldType);
        transition parser.output.accepted {
            true -> field_end(parser, input, parser.type_result)
            _ -> done()
        }
    }

    state field_end(parser: &mut Parser, input: &TokenStream, type_reference: u64 in Trapping) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedDataFieldEnd);
        transition parser.output.accepted {
            true -> field_retained(parser, input, type_reference)
            _ -> done()
        }
    }

    state field_retained(parser: &mut Parser, input: &TokenStream, type_reference: u64 in Trapping) {
        transition parser.output.field_count < 1024 && parser.output.data_member_count < 1024 {
            true -> field_stored(parser, input, type_reference)
            _ -> field_full(parser, input)
        }
    }

    state field_stored(parser: &mut Parser, input: &TokenStream, type_reference: u64 in Trapping) {
        let field: u64 in Trapping = parser.output.field_count as u64 in Trapping;
        let span: SourceSpan = Parser::source_span(parser, parser.member_start, parser.token_end);
        parser.output.fields[parser.output.field_count] = DataField {
            name: Parser::identifier_span(parser, parser.member_name_start, parser.member_name_end),
            type_reference: type_reference,
            source_span: span
        };
        parser.output.field_count = parser.output.field_count + 1;
        parser.output.data_members[parser.output.data_member_count] = DataMember {
            kind: DataMemberKind::Field,
            item_index: field,
            source_span: span
        };
        parser.output.data_member_count = parser.output.data_member_count + 1;
        transition { _ -> member(parser, input) }
    }

    state case_capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.case_count < 512 && parser.output.data_member_count < 1024 {
            true -> case_name(parser, input)
            _ -> case_full(parser, input)
        }
    }

    state case_full(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.case_count < 512 {
            true -> reject(parser, input, ParseDiagnosticCode::DataMemberCapacityExceeded)
            _ -> reject(parser, input, ParseDiagnosticCode::DataCaseCapacityExceeded)
        }
    }

    state case_name(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedDataCaseName);
        parser.member_name_start = parser.name_start;
        parser.member_name_end = parser.name_end;
        parser.case_first_payload_field = parser.output.payload_field_count as u64 in Trapping;
        transition parser.output.accepted {
            true -> case_payload(parser, input)
            _ -> done()
        }
    }

    state case_payload(parser: &mut Parser, input: &TokenStream) {
        let payload: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftParen);
        transition payload {
            true -> payload_open(parser, input)
            _ -> case_clauses(parser, input)
        }
    }

    state payload_open(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> payload_field(parser, input) }
    }

    state payload_field(parser: &mut Parser, input: &TokenStream) {
        let close: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightParen);
        transition close {
            true -> payload_close(parser, input)
            _ -> payload_capacity(parser, input)
        }
    }

    state payload_capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.payload_field_count < 1024 {
            true -> payload_name(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::DataCasePayloadFieldCapacityExceeded)
        }
    }

    state payload_name(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedDataCasePayloadField);
        transition parser.output.accepted {
            true -> payload_colon(parser, input, parser.name_start, parser.name_end)
            _ -> done()
        }
    }

    state payload_colon(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping, end: u64 in Trapping) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Colon,
            ParseDiagnosticCode::ExpectedDataCasePayloadFieldColon
        );
        transition parser.output.accepted {
            true -> payload_type(parser, input, start, end)
            _ -> done()
        }
    }

    state payload_type(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping, end: u64 in Trapping) {
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedDataCasePayloadFieldType);
        transition parser.output.accepted {
            true -> payload_separator(parser, input, start, end, parser.type_result)
            _ -> done()
        }
    }

    // A field followed by `,` spans through the comma; the last field ends
    // with its type.
    state payload_separator(
        parser: &mut Parser,
        input: &TokenStream,
        start: u64 in Trapping,
        end: u64 in Trapping,
        type_reference: u64 in Trapping
    ) {
        let comma: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition comma {
            true -> payload_comma(parser, input, start, end, type_reference)
            _ -> payload_last(parser, input, start, end, type_reference)
        }
    }

    state payload_comma(
        parser: &mut Parser,
        input: &TokenStream,
        start: u64 in Trapping,
        end: u64 in Trapping,
        type_reference: u64 in Trapping
    ) {
        Parser::take_current(parser, input);
        transition { _ -> payload_stored(parser, input, start, end, type_reference, parser.token_end, true) }
    }

    state payload_last(
        parser: &mut Parser,
        input: &TokenStream,
        start: u64 in Trapping,
        end: u64 in Trapping,
        type_reference: u64 in Trapping
    ) {
        let close: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightParen);
        transition close {
            true -> payload_stored(parser, input, start, end, type_reference, parser.type_end, false)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedDataCasePayloadSeparatorOrEnd)
        }
    }

    state payload_stored(
        parser: &mut Parser,
        input: &TokenStream,
        start: u64 in Trapping,
        end: u64 in Trapping,
        type_reference: u64 in Trapping,
        field_end: u64 in Trapping,
        more: bool
    ) {
        transition parser.output.payload_field_count < 1024 {
            true -> payload_retained(parser, input, start, end, type_reference, field_end, more)
            _ -> reject(parser, input, ParseDiagnosticCode::DataCasePayloadFieldCapacityExceeded)
        }
    }

    state payload_retained(
        parser: &mut Parser,
        input: &TokenStream,
        start: u64 in Trapping,
        end: u64 in Trapping,
        type_reference: u64 in Trapping,
        field_end: u64 in Trapping,
        more: bool
    ) {
        parser.output.payload_fields[parser.output.payload_field_count] = DataField {
            name: Parser::identifier_span(parser, start, end),
            type_reference: type_reference,
            source_span: Parser::source_span(parser, start, field_end)
        };
        parser.output.payload_field_count = parser.output.payload_field_count + 1;
        transition more {
            true -> payload_field(parser, input)
            _ -> payload_close(parser, input)
        }
    }

    state payload_close(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> case_clauses(parser, input) }
    }

    state case_clauses(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_clauses(parser, input, ClauseOwner::DataCase);
        transition parser.output.accepted {
            true -> case_end(parser, input)
            _ -> done()
        }
    }

    state case_end(parser: &mut Parser, input: &TokenStream) {
        let first_clause: u64 in Trapping = parser.clause_first;
        let clause_count: u64 in Trapping = (parser.output.clause_count as u64 in Trapping) - parser.clause_first;
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedDataCaseEnd);
        transition parser.output.accepted {
            true -> case_retained(parser, input, first_clause, clause_count)
            _ -> done()
        }
    }

    state case_retained(
        parser: &mut Parser,
        input: &TokenStream,
        first_clause: u64 in Trapping,
        clause_count: u64 in Trapping
    ) {
        transition parser.output.case_count < 512 && parser.output.data_member_count < 1024 {
            true -> case_stored(parser, input, first_clause, clause_count)
            _ -> case_full(parser, input)
        }
    }

    state case_stored(
        parser: &mut Parser,
        input: &TokenStream,
        first_clause: u64 in Trapping,
        clause_count: u64 in Trapping
    ) {
        let data_case: u64 in Trapping = parser.output.case_count as u64 in Trapping;
        let span: SourceSpan = Parser::source_span(parser, parser.member_start, parser.token_end);
        parser.output.cases[parser.output.case_count] = DataCase {
            name: Parser::identifier_span(parser, parser.member_name_start, parser.member_name_end),
            first_payload_field: parser.case_first_payload_field,
            payload_field_count: (parser.output.payload_field_count as u64 in Trapping) - parser.case_first_payload_field,
            first_clause: first_clause,
            clause_count: clause_count,
            source_span: span
        };
        parser.output.case_count = parser.output.case_count + 1;
        parser.output.data_members[parser.output.data_member_count] = DataMember {
            kind: DataMemberKind::Case,
            item_index: data_case,
            source_span: span
        };
        parser.output.data_member_count = parser.output.data_member_count + 1;
        transition { _ -> member(parser, input) }
    }

    state close(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition parser.output.data_count < 256 && parser.output.root_count < 256 {
            true -> retain(parser)
            _ -> reject(parser, input, ParseDiagnosticCode::DataCapacityExceeded)
        }
    }

    state retain(parser: &mut Parser) {
        let data_index: u64 in Trapping = parser.output.data_count as u64 in Trapping;
        let span: SourceSpan = Parser::source_span(parser, parser.data_item_start, parser.token_end);
        parser.output.data_items[parser.output.data_count] = DataItem {
            name: Parser::identifier_span(parser, parser.data_name_start, parser.data_name_end),
            first_generic_parameter: parser.data_first_generic,
            generic_parameter_count: (parser.output.generic_parameter_count as u64 in Trapping) - parser.data_first_generic,
            first_member: parser.data_first_member,
            member_count: (parser.output.data_member_count as u64 in Trapping) - parser.data_first_member,
            first_field: parser.data_first_field,
            field_count: (parser.output.field_count as u64 in Trapping) - parser.data_first_field,
            first_case: parser.data_first_case,
            case_count: (parser.output.case_count as u64 in Trapping) - parser.data_first_case,
            first_clause: parser.data_first_clause,
            clause_count: parser.data_clause_count,
            multiplicity: parser.data_multiplicity,
            is_public: parser.data_is_public,
            source_span: span
        };
        parser.output.data_count = parser.output.data_count + 1;
        parser.output.roots[parser.output.root_count] = RootItem {
            kind: RootItemKind::Data,
            item_index: data_index,
            source_span: span
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state done() {}
}

// `[property {, property} [,]]`, entered at `[`: one multiplicity, `copy` or
// `linear`, lands in `property_multiplicity` (affine when the list names
// none). A repeated property rejects as a duplicate and the other one as a
// conflict, at the second property.
pub machine Parser::parse_properties(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    Parser::take_current(parser, input);
    parser.property_multiplicity = DataMultiplicity::Affine;
    transition { _ -> property(parser, input) }

    state property(parser: &mut Parser, input: &TokenStream) {
        let copy: bool = Parser::at_keyword(parser, input, KeywordKind::Copy);
        let linear: bool = Parser::at_keyword(parser, input, KeywordKind::Linear);
        transition copy {
            true -> named(parser, input, DataMultiplicity::Unrestricted)
            _ -> linear_property(parser, input, linear)
        }
    }

    state linear_property(parser: &mut Parser, input: &TokenStream, linear: bool) {
        transition linear {
            true -> named(parser, input, DataMultiplicity::Linear)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedDataProperty)
        }
    }

    state named(parser: &mut Parser, input: &TokenStream, multiplicity: DataMultiplicity) {
        transition parser.property_multiplicity {
            DataMultiplicity::Affine -> first(parser, input, multiplicity)
            _ -> second(parser, input, multiplicity)
        }
    }

    state first(parser: &mut Parser, input: &TokenStream, multiplicity: DataMultiplicity) {
        Parser::take_current(parser, input);
        parser.property_multiplicity = multiplicity;
        transition { _ -> separator(parser, input) }
    }

    state second(parser: &mut Parser, input: &TokenStream, multiplicity: DataMultiplicity) {
        transition multiplicity == parser.property_multiplicity {
            true -> reject(parser, input, ParseDiagnosticCode::DuplicateDataMultiplicity)
            _ -> reject(parser, input, ParseDiagnosticCode::ConflictingDataMultiplicity)
        }
    }

    state separator(parser: &mut Parser, input: &TokenStream) {
        let close: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBracket);
        let comma: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition close {
            true -> closed(parser, input)
            _ -> comma_separator(parser, input, comma)
        }
    }

    state comma_separator(parser: &mut Parser, input: &TokenStream, comma: bool) {
        transition comma {
            true -> after_comma(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedDataPropertyEnd)
        }
    }

    state after_comma(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        let close: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBracket);
        transition close {
            true -> closed(parser, input)
            _ -> property(parser, input)
        }
    }

    state closed(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }
}
