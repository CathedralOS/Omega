use psi::parse::parser;
use psi::syntax::syntax;
use psi::tokens::tokens;

machine Parser::initialize_cursor(parser: &mut Parser) {
    parser.cursor = 0;
    parser.current_index = 0;
    parser.current_present = false;
}

// One checked dynamic-selection boundary retains only a bounded index witness;
// callers read the canonical typed token directly from the borrowed stream.
machine Parser::load_current(parser: &mut Parser, input: &TokenStream) {
    parser.current_present = false;
    transition parser.cursor < input.token_count {
        true -> array_bound(parser, parser.cursor as u64)
        _ -> absent(parser)
    }

    state array_bound(parser: &mut Parser, candidate: u64) {
        transition candidate < 65536 {
            true -> present(parser, candidate)
            _ -> absent(parser)
        }
    }

    state present(parser: &mut Parser, retained: u64)
    requires retained <= 65535
    {
        parser.current_index = retained;
        parser.current_present = true;
    }

    state absent(parser: &mut Parser) {
        parser.current_present = false;
    }
}

machine Parser::advance(parser: &mut Parser, input: &TokenStream) {
    parser.cursor = parser.cursor + 1;
}

// Grammar-step helpers. Each consumes at most the current token: on a match
// it records the token's span in `token_start`/`token_end` and advances past
// to the next token; otherwise it rejects with `code` at the token, or at the
// source end when input is exhausted. Callers continue only while
// `output.accepted` holds.
machine Parser::expect_punctuation(
    parser: &mut Parser,
    input: &TokenStream,
    expected: PunctuationKind,
    code: ParseDiagnosticCode
)
crashes Trap
{
    let present: bool = Parser::at_punctuation(parser, input, expected);
    transition present {
        true -> take(parser, input)
        _ -> reject(parser, input, code)
    }

    state take(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }
}

// A name: an identifier or any keyword except `self`, matching the data
// grammar's name rule. The name's span lands in `name_start`/`name_end`.
machine Parser::expect_name(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode)
crashes Trap
{
    let present: bool = Parser::at_name(parser, input);
    transition present {
        true -> take(parser, input)
        _ -> reject(parser, input, code)
    }

    state take(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.name_start = parser.token_start;
        parser.name_end = parser.token_end;
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }
}

machine Parser::at_punctuation(parser: &mut Parser, input: &TokenStream, expected: PunctuationKind) -> bool
crashes Trap
{
    Parser::load_current(parser, input);
    transition parser.current_present {
        true -> loaded(parser, input, expected)
        _ -> absent()
    }

    state loaded(parser: &mut Parser, input: &TokenStream, expected: PunctuationKind) {
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Punctuation { punctuation, .. } -> compare(punctuation, expected)
            _ -> absent()
        }
    }

    state compare(punctuation: PunctuationKind, expected: PunctuationKind) {
        punctuation == expected
    }

    state absent() {
        false
    }
}

machine Parser::at_keyword(parser: &mut Parser, input: &TokenStream, expected: KeywordKind) -> bool
crashes Trap
{
    Parser::load_current(parser, input);
    transition parser.current_present {
        true -> loaded(parser, input, expected)
        _ -> absent()
    }

    state loaded(parser: &mut Parser, input: &TokenStream, expected: KeywordKind) {
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Keyword { keyword, .. } -> compare(keyword, expected)
            _ -> absent()
        }
    }

    state compare(keyword: KeywordKind, expected: KeywordKind) {
        keyword == expected
    }

    state absent() {
        false
    }
}

machine Parser::at_name(parser: &mut Parser, input: &TokenStream) -> bool
crashes Trap
{
    Parser::load_current(parser, input);
    transition parser.current_present {
        true -> loaded(parser, input)
        _ -> absent()
    }

    state loaded(parser: &mut Parser, input: &TokenStream) {
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Identifier -> present()
            Token::Keyword { keyword: KeywordKind::SelfValue, .. } -> absent()
            Token::Keyword { keyword, .. } -> present()
            _ -> absent()
        }
    }

    state present() {
        true
    }

    state absent() {
        false
    }
}

// Record the current token's span and advance past it.
// Callers have already established that a token is present.
machine Parser::take_current(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    let token: Token = input.tokens[parser.current_index];
    parser.token_start = token.start;
    parser.token_end = token.end;
    Parser::advance(parser, input);
}

machine Parser::reject_current(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode)
crashes Trap
{
    Parser::load_current(parser, input);
    transition parser.current_present {
        true -> at_token(parser, input, code)
        _ -> at_end(parser, code)
    }

    state at_token(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        let token: Token = input.tokens[parser.current_index];
        SyntaxTrees::reject(&mut parser.output, code, parser.source, token.start, token.end);
    }

    state at_end(parser: &mut Parser, code: ParseDiagnosticCode) {
        SyntaxTrees::reject(&mut parser.output, code, parser.source, parser.source_length, parser.source_length);
    }
}

// Whether the current token is an identifier spelling exactly `spelling`:
// the test for contextual words such as `in` and `mut`, compared against the
// decoded bytes the lexer copies for every identifier.
// An optional `[erased]` after a binding's name
// (wiki/spec/proofs/contracts.md#explicit-erased-bindings): `[` must open
// exactly that marker. Records whether it was spelled in
// `binding_erased`.
pub machine Parser::parse_erased_marker(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    parser.binding_erased = false;
    let opened: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBracket);
    transition opened {
        true -> marker(parser, input)
        _ -> done()
    }

    state marker(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.binding_erased_start = parser.token_start;
        let erased: bool = Parser::at_word(parser, input, "erased");
        transition erased {
            true -> word(parser, input)
            _ -> reject(parser, input)
        }
    }

    state word(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::expect_punctuation(parser, input, PunctuationKind::RightBracket, ParseDiagnosticCode::ExpectedErasedMarker);
        parser.binding_erased = parser.output.accepted;
    }

    state reject(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::ExpectedErasedMarker);
    }

    state done() {}
}

// Record binding `handle` of `kind` as erased when its marker was spelled.
pub machine Parser::record_erased(parser: &mut Parser, kind: ErasedBindingKind, handle: u64 in Trapping, end: u64 in Trapping)
crashes Trap
{
    transition parser.binding_erased {
        true -> bounded(parser, kind, handle, end)
        _ -> done()
    }

    state bounded(parser: &mut Parser, kind: ErasedBindingKind, handle: u64 in Trapping, end: u64 in Trapping) {
        transition parser.output.erased_binding_count < 1024 {
            true -> stored(parser, kind, handle, end)
            _ -> full(parser)
        }
    }

    state stored(parser: &mut Parser, kind: ErasedBindingKind, handle: u64 in Trapping, end: u64 in Trapping) {
        parser.output.erased_bindings[parser.output.erased_binding_count] = ErasedBinding {
            kind: kind,
            handle: handle,
            source_span: Parser::source_span(parser, parser.binding_erased_start, end)
        };
        parser.output.erased_binding_count = parser.output.erased_binding_count + 1;
        parser.binding_erased = false;
    }

    state full(parser: &mut Parser) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::ErasedBindingCapacityExceeded, parser.source, parser.binding_erased_start, parser.token_end);
    }

    state done() {}
}

machine Parser::at_word(parser: &mut Parser, input: &TokenStream, spelling: &[u8]) -> bool
crashes Trap
{
    Parser::load_current(parser, input);
    transition parser.current_present {
        true -> loaded(parser, input, spelling)
        _ -> absent()
    }

    state loaded(parser: &mut Parser, input: &TokenStream, spelling: &[u8]) {
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Identifier -> spelled(input, token.decoded_start, token.decoded_length, spelling)
            _ -> absent()
        }
    }

    state spelled(input: &TokenStream, start: u64 in Trapping, length: u64 in Trapping, spelling: &[u8]) {
        Parser::decoded_spells(input, start, length, spelling)
    }

    state absent() {
        false
    }
}

// Whether the current token is an integer literal.
machine Parser::at_integer(parser: &mut Parser, input: &TokenStream) -> bool
crashes Trap
{
    Parser::load_current(parser, input);
    transition parser.current_present {
        true -> loaded(parser, input)
        _ -> absent()
    }

    state loaded(parser: &mut Parser, input: &TokenStream) {
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Integer { base, empty_digits, has_suffix, .. } -> present()
            _ -> absent()
        }
    }

    state present() {
        true
    }

    state absent() {
        false
    }
}

// Whether the token after the current one is `expected`, leaving the cursor
// where it was: the one-token lookahead that tells a contextual word from an
// ordinary name, as `block f()` from `block(x)`.
machine Parser::next_is_punctuation(parser: &mut Parser, input: &TokenStream, expected: PunctuationKind) -> bool
crashes Trap
{
    let cursor: u64 in Trapping = parser.cursor;
    parser.cursor = parser.cursor + 1;
    let present: bool = Parser::at_punctuation(parser, input, expected);
    parser.cursor = cursor;
    Parser::load_current(parser, input);
    present
}

// Whether the token after the current one is the keyword `expected`, leaving
// the cursor where it was: a target name before `machine`.
machine Parser::next_is_keyword(parser: &mut Parser, input: &TokenStream, expected: KeywordKind) -> bool
crashes Trap
{
    let cursor: u64 in Trapping = parser.cursor;
    parser.cursor = parser.cursor + 1;
    let present: bool = Parser::at_keyword(parser, input, expected);
    parser.cursor = cursor;
    Parser::load_current(parser, input);
    present
}

// Whether the token after the current one is an identifier spelling exactly
// `spelling`, leaving the cursor where it was: a conformance's name before
// `satisfies`, or a target name before `boundary`.
machine Parser::next_is_word(parser: &mut Parser, input: &TokenStream, spelling: &[u8]) -> bool
crashes Trap
{
    let cursor: u64 in Trapping = parser.cursor;
    parser.cursor = parser.cursor + 1;
    let present: bool = Parser::at_word(parser, input, spelling);
    parser.cursor = cursor;
    Parser::load_current(parser, input);
    present
}

// Whether the token after the current one is `expected` and starts exactly at
// `end`, with no source between them.
machine Parser::next_is_adjacent_punctuation(
    parser: &mut Parser,
    input: &TokenStream,
    expected: PunctuationKind,
    end: u64 in Trapping
) -> bool
crashes Trap
{
    let cursor: u64 in Trapping = parser.cursor;
    parser.cursor = parser.cursor + 1;
    let present: bool = Parser::at_punctuation(parser, input, expected);
    transition present {
        true -> adjacent(parser, input, cursor, end)
        _ -> restore(parser, input, cursor, false)
    }

    state adjacent(parser: &mut Parser, input: &TokenStream, cursor: u64 in Trapping, end: u64 in Trapping) {
        let token: Token = input.tokens[parser.current_index];
        transition { _ -> restore(parser, input, cursor, token.start == end) }
    }

    state restore(parser: &mut Parser, input: &TokenStream, cursor: u64 in Trapping, result: bool) {
        parser.cursor = cursor;
        Parser::load_current(parser, input);
        result
    }
}

// Whether the current token begins a declaration rather than an expression:
// a declaration keyword (`use`, `data`, `machine`, `pub`), two adjacent
// names (`boundary trait`, `linux_arm64 machine`, `const N`), a domain
// family's `domain<` or a bracketed carrier's `domain [u8]::Path`, or a
// generic conformance `Name<...> satisfies`. No expression begins with two
// names except a cast `x as T`, a membership `x in D` and an acknowledged
// call `suspend f()`, `block f()`.
machine Parser::at_declaration_head(parser: &mut Parser, input: &TokenStream) -> bool
crashes Trap
{
    let uses: bool = Parser::at_keyword(parser, input, KeywordKind::Use);
    let declares_data: bool = Parser::at_keyword(parser, input, KeywordKind::Data);
    let declares_machine: bool = Parser::at_keyword(parser, input, KeywordKind::Machine);
    let public: bool = Parser::at_keyword(parser, input, KeywordKind::Pub);
    transition uses || declares_data || declares_machine || public {
        true -> head()
        _ -> first_name(parser, input)
    }

    state first_name(parser: &mut Parser, input: &TokenStream) {
        let named: bool = Parser::at_name(parser, input);
        let suspends: bool = Parser::at_word(parser, input, "suspend");
        let blocks: bool = Parser::at_word(parser, input, "block");
        transition named && !suspends && !blocks {
            true -> second_name(parser, input)
            _ -> expression()
        }
    }

    state second_name(parser: &mut Parser, input: &TokenStream) {
        let family: bool = Parser::at_word(parser, input, "domain");
        let cursor: u64 in Trapping = parser.cursor;
        parser.cursor = parser.cursor + 1;
        let named: bool = Parser::at_name(parser, input);
        let cast: bool = Parser::at_keyword(parser, input, KeywordKind::As);
        let membership: bool = Parser::at_word(parser, input, "in");
        let generic: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        let bracketed: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBracket);
        parser.cursor = cursor;
        Parser::load_current(parser, input);
        let conformance: bool = Parser::generic_conformance_ahead(parser, input);
        named && !cast && !membership || family && (generic || bracketed) || conformance
    }

    state head() {
        true
    }

    state expression() {
        false
    }
}

// Whether the name at the cursor opens a generic conformance head `Name<...>
// satisfies`: a `<` follows, its matching `>` closes a run of tokens a
// generic parameter list can spell, and `satisfies` follows that `>`. The
// scan reads tokens without moving the cursor.
machine Parser::generic_conformance_ahead(parser: &Parser, input: &TokenStream) -> bool
crashes Trap
{
    transition { _ -> next(input, parser.cursor + 1) }

    state next(input: &TokenStream, index: u64 in Trapping) {
        transition index < input.token_count {
            true -> opened(input, index)
            _ -> absent()
        }
    }

    state opened(input: &TokenStream, index: u64 in Trapping) {
        let token: Token = input.tokens[index];
        transition token {
            Token::Punctuation { punctuation: PunctuationKind::Less, .. } -> scan(input, index + 1, 1)
            _ -> absent()
        }
    }

    state scan(input: &TokenStream, index: u64 in Trapping, depth: u64 in Trapping) {
        transition index < input.token_count {
            true -> token(input, index, depth)
            _ -> absent()
        }
    }

    state token(input: &TokenStream, index: u64 in Trapping, depth: u64 in Trapping) {
        let token: Token = input.tokens[index];
        transition token {
            Token::Punctuation { punctuation: PunctuationKind::Less, .. } -> scan(input, index + 1, depth + 1)
            Token::Punctuation { punctuation: PunctuationKind::Greater, .. } -> close(input, index, depth)
            Token::Punctuation { punctuation: PunctuationKind::ColonColon, .. } -> scan(input, index + 1, depth)
            Token::Punctuation { punctuation: PunctuationKind::Colon, .. } -> scan(input, index + 1, depth)
            Token::Punctuation { punctuation: PunctuationKind::Comma, .. } -> scan(input, index + 1, depth)
            Token::Punctuation { punctuation: PunctuationKind::Apostrophe, .. } -> scan(input, index + 1, depth)
            Token::Punctuation { punctuation: PunctuationKind::Ampersand, .. } -> scan(input, index + 1, depth)
            Token::Punctuation { punctuation: PunctuationKind::LeftBracket, .. } -> scan(input, index + 1, depth)
            Token::Punctuation { punctuation: PunctuationKind::RightBracket, .. } -> scan(input, index + 1, depth)
            Token::Punctuation { punctuation: PunctuationKind::Semicolon, .. } -> scan(input, index + 1, depth)
            Token::Identifier -> scan(input, index + 1, depth)
            Token::Keyword { keyword, .. } -> scan(input, index + 1, depth)
            Token::Integer { base, empty_digits, has_suffix, .. } -> scan(input, index + 1, depth)
            _ -> absent()
        }
    }

    state close(input: &TokenStream, index: u64 in Trapping, depth: u64 in Trapping) {
        transition depth > 1 {
            true -> scan(input, index + 1, depth - 1)
            _ -> related(input, index + 1)
        }
    }

    state related(input: &TokenStream, index: u64 in Trapping) {
        transition index < input.token_count {
            true -> satisfies(input, index)
            _ -> absent()
        }
    }

    state satisfies(input: &TokenStream, index: u64 in Trapping) {
        let token: Token = input.tokens[index];
        transition token {
            Token::Identifier -> spelled(input, token.decoded_start, token.decoded_length)
            _ -> absent()
        }
    }

    state spelled(input: &TokenStream, start: u64 in Trapping, length: u64 in Trapping) {
        Parser::decoded_spells(input, start, length, "satisfies")
    }

    state absent() {
        false
    }
}

// Whether the decoded bytes `start..start + length` spell exactly `spelling`.
machine Parser::decoded_spells(input: &TokenStream, start: u64 in Trapping, length: u64 in Trapping, spelling: &[u8]) -> bool
crashes Trap
{
    transition length == spelling.len {
        true -> compare(input, start, spelling, 0)
        _ -> absent()
    }

    state compare(input: &TokenStream, cursor: u64 in Trapping, spelling: &[u8], index: u64 in Trapping) {
        transition index < spelling.len {
            true -> byte(input, cursor, spelling, index)
            _ -> present()
        }
    }

    state byte(input: &TokenStream, cursor: u64 in Trapping, spelling: &[u8], index: u64 in Trapping) {
        transition cursor < 131072 {
            true -> compare_byte(input, cursor, spelling, index)
            _ -> absent()
        }
    }

    state compare_byte(input: &TokenStream, cursor: u64 in Trapping, spelling: &[u8], index: u64 in Trapping) {
        let decoded: u8 = input.decoded[cursor] as u8;
        let expected: u8 = spelling[index];
        transition decoded == expected {
            true -> compare(input, cursor + 1, spelling, index + 1)
            _ -> absent()
        }
    }

    state present() {
        true
    }

    state absent() {
        false
    }
}
