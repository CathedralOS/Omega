use psi::parse::owner;
use psi::tokens::tokens;

machine Parser::initialize_cursor(&mut self) {
    self.cursor = 0;
    self.current_index = 0;
    self.current_present = false;
}

// One checked dynamic-selection boundary retains only a bounded index witness;
// callers read the canonical typed token directly from the borrowed stream.
machine Parser::load_current(&mut self) {
    self.current_present = false;
    transition self.cursor < self.input.token_count {
        true -> array_bound(self.cursor as u64)
        _ -> absent()
    }

    state array_bound(&mut self, candidate: u64) {
        transition candidate < 16384 {
            true -> present(candidate)
            _ -> absent()
        }
    }

    state present(&mut self, retained: u64 [0..=16383]) {
        self.current_index = retained;
        self.current_present = true;
    }

    state absent(&mut self) {
        self.current_present = false;
    }
}

machine Parser::skip_trivia(&mut self) {
    transition self.cursor < self.input.token_count {
        true -> classify()
        _ -> done()
    }

    state classify(&mut self) {
        self.load_current();
        transition { _ -> classify_loaded() }
    }

    state classify_loaded(&mut self) {
        transition self.current_present {
            true -> classify_present()
            _ -> done()
        }
    }

    state classify_present(&mut self) {
        let token: Token = self.input.tokens[self.current_index];
        transition token {
            Token::Whitespace -> advance()
            Token::LineComment -> advance()
            Token::BlockComment -> advance()
            _ -> done()
        }
    }

    state advance(&mut self) {
        self.cursor = self.cursor + 1;
        transition self.cursor < self.input.token_count {
            true -> classify()
            _ -> done()
        }
    }

    state done(&mut self) { }
}
