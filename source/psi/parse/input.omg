use psi::parse::parser;
use psi::tokens::tokens;

machine Parser::initialize_cursor(parser: &mut Parser) {
    parser.cursor = 0;
    parser.current_index = 0;
    parser.current_present = false;
}

// One checked dynamic-selection boundary retains only a bounded index witness;
// callers read the canonical typed token directly from the borrowed stream.
machine Parser::load_current(parser: &mut Parser, input: &TokenStream) {
    parser.current_present = false;
    transition parser.cursor < input.token_count {
        true -> array_bound(parser, parser.cursor as u64)
        _ -> absent(parser)
    }

    state array_bound(parser: &mut Parser, candidate: u64) {
        transition candidate < 16384 {
            true -> present(parser, candidate)
            _ -> absent(parser)
        }
    }

    state present(parser: &mut Parser, retained: u64 [0..=16383]) {
        parser.current_index = retained;
        parser.current_present = true;
    }

    state absent(parser: &mut Parser) {
        parser.current_present = false;
    }
}

machine Parser::skip_trivia(parser: &mut Parser, input: &TokenStream) {
    transition parser.cursor < input.token_count {
        true -> classify(parser, input)
        _ -> done()
    }

    state classify(parser: &mut Parser, input: &TokenStream) {
        Parser::load_current(parser, input);
        transition { _ -> classify_loaded(parser, input) }
    }

    state classify_loaded(parser: &mut Parser, input: &TokenStream) {
        transition parser.current_present {
            true -> classify_present(parser, input)
            _ -> done()
        }
    }

    state classify_present(parser: &mut Parser, input: &TokenStream) {
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Whitespace -> advance(parser, input)
            Token::LineComment -> advance(parser, input)
            Token::BlockComment -> advance(parser, input)
            _ -> done()
        }
    }

    state advance(parser: &mut Parser, input: &TokenStream) {
        parser.cursor = parser.cursor + 1;
        transition parser.cursor < input.token_count {
            true -> classify(parser, input)
            _ -> done()
        }
    }

    state done() { }
}
