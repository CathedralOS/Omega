use psi::parse::clause;
use psi::parse::generics;
use psi::parse::input;
use psi::parse::parser;
use psi::parse::path;
use psi::parse::types;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

// `[public] domain [<generic parameters>] Carrier::Name [<index arguments>]
// [(subject)] tail`, entered at the `domain` word. The carrier is a name or
// a bracketed array or slice type, retained as a type reference; the index
// arguments share the static argument grammar. The tail is a transparent
// alias `= Path {& Path};`, or `[requires facts] [established by Path {,
// Path}]` closed by `;` or by an empty body `{ }`. The item and its root are
// retained at its last token.
public machine Parser::parse_domain(
    parser: &mut Parser,
    input: &TokenStream,
    item_start: u64 in Trapping,
    is_public: bool
)
crashes Trap
{
    parser.declaration_start = item_start;
    parser.declaration_is_public = is_public;
    transition parser.output.domain_count < 256 {
        true -> keyword(parser, input)
        _ -> reject(parser, input, ParseDiagnosticCode::DomainCapacityExceeded)
    }

    state keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.declaration_first_generic = parser.output.generic_parameter_count as u64 in Trapping;
        parser.declaration_first_argument = parser.output.type_argument_count as u64 in Trapping;
        parser.declaration_argument_count = 0;
        parser.declaration_has_subject = false;
        parser.declaration_subject_start = 0;
        parser.declaration_subject_end = 0;
        let generic: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        transition generic {
            true -> generics(parser, input)
            _ -> carrier_form(parser, input)
        }
    }

    state generics(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_generic_parameters(parser, input);
        transition parser.output.accepted {
            true -> carrier_form(parser, input)
            _ -> done()
        }
    }

    // A bracketed carrier is a whole type; a named one is its name alone,
    // since the `::` after it begins the domain's own name.
    state carrier_form(parser: &mut Parser, input: &TokenStream) {
        let bracketed: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBracket);
        transition bracketed {
            true -> bracketed_carrier(parser, input)
            _ -> named_carrier(parser, input)
        }
    }

    state bracketed_carrier(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedDomainCarrier);
        transition parser.output.accepted {
            true -> separator(parser, input, parser.type_result)
            _ -> done()
        }
    }

    state named_carrier(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedDomainCarrier);
        transition parser.output.accepted {
            true -> carrier_capacity(parser, input)
            _ -> done()
        }
    }

    state carrier_capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.type_reference_count < 65536 {
            true -> carrier_row(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::TypeReferenceCapacityExceeded)
        }
    }

    state carrier_row(parser: &mut Parser, input: &TokenStream) {
        let carrier: u64 in Trapping = parser.output.type_reference_count as u64 in Trapping;
        let row: TypeReference = Parser::type_row(parser,
            TypeReferenceKind::Named, parser.name_start, parser.name_end, parser.name_start, parser.name_end);
        parser.output.type_references[parser.output.type_reference_count] = row;
        parser.output.type_reference_count = parser.output.type_reference_count + 1;
        transition { _ -> separator(parser, input, carrier) }
    }

    state separator(parser: &mut Parser, input: &TokenStream, carrier: u64 in Trapping) {
        parser.declaration_type = carrier;
        Parser::expect_punctuation(parser, input, PunctuationKind::ColonColon, ParseDiagnosticCode::ExpectedDomainSeparator);
        transition parser.output.accepted {
            true -> domain_name(parser, input)
            _ -> done()
        }
    }

    state domain_name(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedDomainName);
        transition parser.output.accepted {
            true -> named(parser, input)
            _ -> done()
        }
    }

    state named(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_name_start = parser.name_start;
        parser.declaration_name_end = parser.name_end;
        let indexed: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        transition indexed {
            true -> indices(parser, input)
            _ -> subject(parser, input)
        }
    }

    state indices(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_static_arguments(parser, input);
        parser.declaration_first_argument = parser.committed_type_first;
        parser.declaration_argument_count = parser.committed_type_count;
        transition parser.output.accepted {
            true -> subject(parser, input)
            _ -> done()
        }
    }

    state subject(parser: &mut Parser, input: &TokenStream) {
        let bound: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftParen);
        transition bound {
            true -> subject_open(parser, input)
            _ -> tail(parser, input)
        }
    }

    state subject_open(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedDomainSubject);
        transition parser.output.accepted {
            true -> subject_named(parser, input)
            _ -> done()
        }
    }

    state subject_named(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_has_subject = true;
        parser.declaration_subject_start = parser.name_start;
        parser.declaration_subject_end = parser.name_end;
        Parser::expect_punctuation(parser, input, PunctuationKind::RightParen,
            ParseDiagnosticCode::ExpectedDomainSubjectEnd
        );
        transition parser.output.accepted {
            true -> tail(parser, input)
            _ -> done()
        }
    }

    state tail(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_first_path = parser.output.name_path_count as u64 in Trapping;
        let alias: bool = Parser::at_punctuation(parser, input, PunctuationKind::Equal);
        transition alias {
            true -> alias_open(parser, input)
            _ -> predicates(parser, input)
        }
    }

    state alias_open(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.declaration_first_clause = parser.output.clause_count as u64 in Trapping;
        parser.declaration_clause_count = 0;
        transition { _ -> constituent(parser, input) }
    }

    state constituent(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_name_path(parser, input, ParseDiagnosticCode::ExpectedDomainConstituent);
        transition parser.output.accepted {
            true -> conjunction(parser, input)
            _ -> done()
        }
    }

    state conjunction(parser: &mut Parser, input: &TokenStream) {
        let more: bool = Parser::at_punctuation(parser, input, PunctuationKind::Ampersand);
        transition more {
            true -> next_constituent(parser, input)
            _ -> alias_end(parser, input)
        }
    }

    state next_constituent(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> constituent(parser, input) }
    }

    state alias_end(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedDomainEnd);
        transition parser.output.accepted {
            true -> retain_capacity(parser, input, true)
            _ -> done()
        }
    }

    state predicates(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_clauses(parser, input, ClauseOwner::Domain);
        parser.declaration_first_clause = parser.clause_first;
        parser.declaration_clause_count = (parser.output.clause_count as u64 in Trapping) - parser.clause_first;
        transition parser.output.accepted {
            true -> establishment(parser, input)
            _ -> done()
        }
    }

    state establishment(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_first_path = parser.output.name_path_count as u64 in Trapping;
        let routed: bool = Parser::at_word(parser, input, "established");
        transition routed {
            true -> established(parser, input)
            _ -> ending(parser, input)
        }
    }

    state established(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        let by: bool = Parser::at_word(parser, input, "by");
        transition by {
            true -> routes(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedEstablishedBy)
        }
    }

    state routes(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> route(parser, input) }
    }

    state route(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_name_path(parser, input, ParseDiagnosticCode::ExpectedDomainRoute);
        transition parser.output.accepted {
            true -> route_separator(parser, input)
            _ -> done()
        }
    }

    state route_separator(parser: &mut Parser, input: &TokenStream) {
        let more: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition more {
            true -> routes(parser, input)
            _ -> ending(parser, input)
        }
    }

    state ending(parser: &mut Parser, input: &TokenStream) {
        let semicolon: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition semicolon {
            true -> closed(parser, input)
            _ -> body(parser, input)
        }
    }

    state closed(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> retain_capacity(parser, input, false) }
    }

    state body(parser: &mut Parser, input: &TokenStream) {
        let braced: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBrace);
        transition braced {
            true -> body_open(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedDomainEnd)
        }
    }

    state body_open(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::expect_punctuation(parser, input, PunctuationKind::RightBrace, ParseDiagnosticCode::ExpectedDomainBodyEnd);
        transition parser.output.accepted {
            true -> retain_capacity(parser, input, false)
            _ -> done()
        }
    }

    state retain_capacity(parser: &mut Parser, input: &TokenStream, is_alias: bool) {
        transition parser.output.domain_count < 256 {
            true -> root_capacity(parser, input, is_alias)
            _ -> reject(parser, input, ParseDiagnosticCode::DomainCapacityExceeded)
        }
    }

    state root_capacity(parser: &mut Parser, input: &TokenStream, is_alias: bool) {
        transition parser.output.root_count < 4096 {
            true -> retain(parser, is_alias)
            _ -> reject(parser, input, ParseDiagnosticCode::RootCapacityExceeded)
        }
    }

    // An alias's paths are its constituents and a predicate domain's its
    // routes; the other range is empty at the table's end.
    state retain(parser: &mut Parser, is_alias: bool) {
        let path_end: u64 in Trapping = parser.output.name_path_count as u64 in Trapping;
        let path_count: u64 in Trapping = path_end - parser.declaration_first_path;
        transition is_alias {
            true -> retained(parser, true, path_end, 0, parser.declaration_first_path, path_count)
            _ -> retained(parser, false, parser.declaration_first_path, path_count, path_end, 0)
        }
    }

    state retained(
        parser: &mut Parser,
        is_alias: bool,
        first_route: u64 in Trapping,
        route_count: u64 in Trapping,
        first_constituent: u64 in Trapping,
        constituent_count: u64 in Trapping
    ) {
        let domain: u64 in Trapping = parser.output.domain_count as u64 in Trapping;
        let span: SourceSpan = Parser::source_span(parser, parser.declaration_start, parser.token_end);
        parser.output.domains[parser.output.domain_count] = DomainItem {
            carrier: parser.declaration_type,
            name: Parser::identifier_span(parser, parser.declaration_name_start, parser.declaration_name_end),
            first_argument: parser.declaration_first_argument,
            argument_count: parser.declaration_argument_count,
            first_generic_parameter: parser.declaration_first_generic,
            generic_parameter_count: (parser.output.generic_parameter_count as u64 in Trapping) - parser.declaration_first_generic,
            has_subject: parser.declaration_has_subject,
            subject: Parser::identifier_span(parser, parser.declaration_subject_start, parser.declaration_subject_end),
            first_clause: parser.declaration_first_clause,
            clause_count: parser.declaration_clause_count,
            first_route: first_route,
            route_count: route_count,
            is_alias: is_alias,
            first_constituent: first_constituent,
            constituent_count: constituent_count,
            is_public: parser.declaration_is_public,
            source_span: span
        };
        parser.output.domain_count = parser.output.domain_count + 1;
        parser.output.roots[parser.output.root_count] = RootItem {
            kind: RootItemKind::Domain,
            item_index: domain,
            source_span: span
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state done() {}
}
