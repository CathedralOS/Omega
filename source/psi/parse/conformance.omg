use psi::parse::generics;
use psi::parse::input;
use psi::parse::machine;
use psi::parse::parser;
use psi::parse::path;
use psi::parse::traits;
use psi::parse::types;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

// `[public] Name [<generic parameters>] satisfies Trait<arguments> { member* }`,
// entered at the implementation's name. The name identifies a closed map of
// machines, not a data subject: the satisfied trait application is one type
// reference, and a member is a checked machine with a body (machine.omg's
// grammar, contained by the conformance) or a reference row
// `Trait::requirement = Path;`. The item and its root are retained at the
// closing `}`.
public machine Parser::parse_conformance(
    parser: &mut Parser,
    input: &TokenStream,
    item_start: u64 in Trapping,
    is_public: bool
)
crashes Trap
{
    parser.declaration_start = item_start;
    parser.declaration_is_public = is_public;
    transition parser.output.conformance_count < 256 {
        true -> implementation_name(parser, input)
        _ -> reject(parser, input, ParseDiagnosticCode::ConformanceCapacityExceeded)
    }

    machine implementation_name(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_first_generic = parser.output.generic_parameter_count as u64 in Trapping;
        Parser::take_current(parser, input);
        parser.declaration_name_start = parser.token_start;
        parser.declaration_name_end = parser.token_end;
        let generic: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        transition generic {
            true -> generics(parser, input)
            _ -> satisfies_word(parser, input)
        }
    }

    machine generics(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_generic_parameters(parser, input);
        transition parser.output.accepted {
            true -> satisfies_word(parser, input)
            _ -> done()
        }
    }

    machine satisfies_word(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_generic_count = (parser.output.generic_parameter_count as u64 in Trapping) - parser.declaration_first_generic;
        let relation: bool = Parser::at_word(parser, input, "satisfies");
        transition relation {
            true -> trait_application(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedConformanceSatisfies)
        }
    }

    machine trait_application(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedConformanceTrait);
        parser.declaration_type = parser.type_result;
        transition parser.output.accepted {
            true -> body(parser, input)
            _ -> done()
        }
    }

    machine body(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::LeftBrace, ParseDiagnosticCode::ExpectedConformanceBody);
        parser.declaration_first_machine = parser.output.machine_count as u64 in Trapping;
        parser.declaration_first_row = parser.output.conformance_row_count as u64 in Trapping;
        transition parser.output.accepted {
            true -> member(parser, input)
            _ -> done()
        }
    }

    machine member(parser: &mut Parser, input: &TokenStream) {
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBrace);
        transition closing {
            true -> close(parser, input)
            _ -> machine_member(parser, input)
        }
    }

    machine machine_member(parser: &mut Parser, input: &TokenStream) {
        let checked: bool = Parser::at_keyword(parser, input, KeywordKind::Machine);
        transition checked {
            true -> checked_member(parser, input)
            _ -> row_member(parser, input)
        }
    }

    machine checked_member(parser: &mut Parser, input: &TokenStream) {
        let token: Token = input.tokens[parser.current_index];
        let head: MachineHead = Parser::member_machine_head(token.start, MachineContainer::Conformance);
        Parser::parse_machine(parser, input, head);
        transition parser.output.accepted {
            true -> checked_body(parser, input)
            _ -> done()
        }
    }

    // A member supplies its requirement's implementation, so it has a
    // checked body; a bodyless one rejects at the `;` that ended it.
    machine checked_body(parser: &mut Parser, input: &TokenStream) {
        let handle: u64 in Trapping = (parser.output.machine_count as u64 in Trapping) - 1;
        let checked: MachineItem = SyntaxTrees::machine_item(&parser.output, handle);
        transition checked.has_body {
            true -> member(parser, input)
            _ -> bodyless(parser)
        }
    }

    machine bodyless(parser: &mut Parser) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::ExpectedConformanceMachineBody,
            parser.source, parser.token_start, parser.token_end);
    }

    machine row_member(parser: &mut Parser, input: &TokenStream) {
        let row: bool = Parser::at_name(parser, input);
        transition row {
            true -> row_requirement(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedConformanceMember)
        }
    }

    machine row_requirement(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_name_path(parser, input, ParseDiagnosticCode::ExpectedConformanceMember);
        transition parser.output.accepted {
            true -> row_equals(parser, input, parser.name_path_result)
            _ -> done()
        }
    }

    machine row_equals(parser: &mut Parser, input: &TokenStream, requirement: u64 in Trapping) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Equal, ParseDiagnosticCode::ExpectedConformanceRowEquals);
        transition parser.output.accepted {
            true -> row_target(parser, input, requirement)
            _ -> done()
        }
    }

    machine row_target(parser: &mut Parser, input: &TokenStream, requirement: u64 in Trapping) {
        Parser::parse_name_path(parser, input, ParseDiagnosticCode::ExpectedConformanceRowTarget);
        transition parser.output.accepted {
            true -> row_end(parser, input, requirement, parser.name_path_result)
            _ -> done()
        }
    }

    machine row_end(parser: &mut Parser, input: &TokenStream, requirement: u64 in Trapping, target: u64 in Trapping) {
        let start: u64 in Trapping = Parser::name_path_start(parser, requirement);
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedConformanceRowEnd);
        transition parser.output.accepted {
            true -> row_capacity(parser, input, requirement, target, start)
            _ -> done()
        }
    }

    machine row_capacity(
        parser: &mut Parser,
        input: &TokenStream,
        requirement: u64 in Trapping,
        target: u64 in Trapping,
        start: u64 in Trapping
    ) {
        transition parser.output.conformance_row_count < 512 {
            true -> row_retained(parser, input, requirement, target, start)
            _ -> reject(parser, input, ParseDiagnosticCode::ConformanceRowCapacityExceeded)
        }
    }

    machine row_retained(
        parser: &mut Parser,
        input: &TokenStream,
        requirement: u64 in Trapping,
        target: u64 in Trapping,
        start: u64 in Trapping
    ) {
        parser.output.conformance_rows[parser.output.conformance_row_count] = ConformanceRow {
            requirement: requirement,
            target: target,
            source_span: Parser::source_span(parser, start, parser.token_end)
        };
        parser.output.conformance_row_count = parser.output.conformance_row_count + 1;
        transition { _ -> member(parser, input) }
    }

    machine close(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition parser.output.conformance_count < 256 {
            true -> root_capacity(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::ConformanceCapacityExceeded)
        }
    }

    machine root_capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.root_count < 4096 {
            true -> retain(parser)
            _ -> reject(parser, input, ParseDiagnosticCode::RootCapacityExceeded)
        }
    }

    machine retain(parser: &mut Parser) {
        let conformance: u64 in Trapping = parser.output.conformance_count as u64 in Trapping;
        let span: SourceSpan = Parser::source_span(parser, parser.declaration_start, parser.token_end);
        parser.output.conformances[parser.output.conformance_count] = ConformanceItem {
            name: Parser::identifier_span(parser, parser.declaration_name_start, parser.declaration_name_end),
            first_generic_parameter: parser.declaration_first_generic,
            generic_parameter_count: parser.declaration_generic_count,
            trait_type: parser.declaration_type,
            first_machine: parser.declaration_first_machine,
            machine_count: (parser.output.machine_count as u64 in Trapping) - parser.declaration_first_machine,
            first_row: parser.declaration_first_row,
            row_count: (parser.output.conformance_row_count as u64 in Trapping) - parser.declaration_first_row,
            is_public: parser.declaration_is_public,
            source_span: span
        };
        parser.output.conformance_count = parser.output.conformance_count + 1;
        parser.output.roots[parser.output.root_count] = RootItem {
            kind: RootItemKind::Conformance,
            item_index: conformance,
            source_span: span
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    machine reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    machine done() {}
}
