use psi::parse::input;
use psi::parse::parser;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

// One open type constructor. `start` is where its type begins; a
// `Reference` keeps its `access`; an `Arguments` frame keeps its applied
// name's end and the base of its staged arguments. `first_row` is the next
// row when the frame opened, so the finished type's run begins there.
pub data TypeFrameKind [copy] {
    case Reference;
    case Array;
    case Arguments;
}

pub data TypeFrame [copy] {
    kind: TypeFrameKind;
    access: ReferenceAccess;
    start: u64 in Trapping;
    name_end: u64 in Trapping;
    first_argument: u64 in Trapping;
    first_row: u64 in Trapping;
    has_lifetime: bool;
    lifetime: IdentifierSpan;
    first_lifetime: u64 in Trapping;
}

// The one type grammar every type position shares:
//
//     type     = `&` [`'` tag] [`mut`] type
//              | `[` type [`;` length] `]` [`in` Domain]
//              | Name [`<` argument {`,` argument} `>`] [`in` Domain]
//     argument = `'` tag | type | integer
//     length   = integer | Name
//     Domain   = Name {`::` Name}
//
// Types nest, so the grammar keeps an explicit frame stack instead of
// recursing: `&`, `[` and `Name<` each open a frame, and each completed type
// closes the frames above it until one still expects more input. Every row
// is appended after its children, so one type fills a contiguous run of
// `SyntaxTrees::type_references` that ends at its root, and every row records
// where its own run begins. The root's handle lands in `type_result` and its
// source end in `type_end`. `missing` is the caller's diagnostic for an absent
// type; nested positions use the array and static-argument diagnostics.
pub machine Parser::parse_type_reference(parser: &mut Parser, input: &TokenStream, missing: ParseDiagnosticCode)
crashes Trap
{
    parser.type_frame_depth = 0;
    transition { _ -> operand(parser, input, missing) }

    // The start of one type: open frames for its prefixes, then read its name.
    // Among a list's arguments, `'tag` is a lifetime argument, which is no
    // type and leaves no row.
    state operand(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        let reference: bool = Parser::at_punctuation(parser, input, PunctuationKind::Ampersand);
        let tick: bool = Parser::at_punctuation(parser, input, PunctuationKind::Apostrophe);
        let argument: bool = Parser::in_type_arguments(parser)
            || parser.type_static_argument && parser.type_frame_depth == 0;
        transition tick && argument {
            true -> lifetime_argument(parser, input)
            _ -> operand_type(parser, input, code, reference)
        }
    }

    state operand_type(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode, reference: bool) {
        transition reference {
            true -> reference_open(parser, input, code)
            _ -> array_word(parser, input, code)
        }
    }

    state lifetime_argument(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedLifetimeName);
        transition parser.output.accepted {
            true -> lifetime_staged(parser, input)
            _ -> done()
        }
    }

    state lifetime_staged(parser: &mut Parser, input: &TokenStream) {
        let tag: IdentifierSpan = Parser::identifier_span(parser, parser.name_start, parser.name_end);
        let listed: bool = Parser::in_type_arguments(parser);
        Parser::push_type_lifetime(parser, input, tag);
        transition parser.output.accepted && listed {
            true -> lifetime_listed(parser, input)
            _ -> lifetime_static(parser, input)
        }
    }

    // Lifetime arguments precede the other arguments of a list.
    state lifetime_listed(parser: &mut Parser, input: &TokenStream) {
        let frame: TypeFrame = Parser::top_type_frame(parser);
        let staged: u64 in Trapping = parser.pending_type_argument_count as u64 in Trapping;
        transition staged == frame.first_argument {
            true -> argument_separator(parser, input, frame)
            _ -> reject(parser, input, ParseDiagnosticCode::GenericLifetimeOrdering)
        }
    }

    // A static argument that is a lifetime: no row results.
    state lifetime_static(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.accepted {
            true -> lifetime_only(parser)
            _ -> done()
        }
    }

    state lifetime_only(parser: &mut Parser) {
        parser.type_result = 0;
        parser.type_lifetime_argument = true;
    }

    state array_word(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        let array: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBracket);
        transition array {
            true -> array_open(parser, input)
            _ -> literal_word(parser, input, code)
        }
    }

    // An integer is a static argument; it is a type only inside `<...>`.
    state literal_word(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        let integer: bool = Parser::at_integer(parser, input);
        let argument: bool = Parser::in_type_arguments(parser)
            || parser.type_static_argument && parser.type_frame_depth == 0;
        transition integer && argument {
            true -> literal(parser, input)
            _ -> name(parser, input, code)
        }
    }

    // `&`, then an optional lifetime tag `'tag` before the access modifier
    // (wiki/spec/language/lifetimes.md#binders-and-source-applications).
    state reference_open(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::take_current(parser, input);
        let start: u64 in Trapping = parser.token_start;
        let tick: bool = Parser::at_punctuation(parser, input, PunctuationKind::Apostrophe);
        let none: IdentifierSpan = Parser::identifier_span(parser, 0, 0);
        transition tick {
            true -> reference_lifetime(parser, input, start, code)
            _ -> reference_access(parser, input, start, code, false, none)
        }
    }

    state reference_lifetime(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping, code: ParseDiagnosticCode) {
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedLifetimeName);
        let tag: IdentifierSpan = Parser::identifier_span(parser, parser.name_start, parser.name_end);
        transition parser.output.accepted {
            true -> reference_access(parser, input, start, code, true, tag)
            _ -> done()
        }
    }

    state reference_access(
        parser: &mut Parser,
        input: &TokenStream,
        start: u64 in Trapping,
        code: ParseDiagnosticCode,
        has_lifetime: bool,
        lifetime: IdentifierSpan
    ) {
        let mutable: bool = Parser::at_word(parser, input, "mut");
        let opened: TypeFrame = Parser::type_frame(parser, TypeFrameKind::Reference, ReferenceAccess::Shared, start);
        let frame: TypeFrame = Parser::lifetime_frame(opened, has_lifetime, lifetime);
        transition mutable {
            true -> mutable_open(parser, input, frame, code)
            _ -> push(parser, input, frame, code)
        }
    }

    state mutable_open(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, code: ParseDiagnosticCode) {
        Parser::take_current(parser, input);
        let writable: TypeFrame = Parser::frame_access(frame, ReferenceAccess::Mutable);
        transition { _ -> push(parser, input, writable, code) }
    }

    state array_open(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        let start: u64 in Trapping = parser.token_start;
        transition {
            _ -> push(parser, input, Parser::type_frame(parser, TypeFrameKind::Array, ReferenceAccess::Shared, start),
                ParseDiagnosticCode::ExpectedArrayElementType
            )
        }
    }

    state push(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, code: ParseDiagnosticCode) {
        transition parser.type_frame_depth < 16 {
            true -> pushed(parser, input, frame, code)
            _ -> reject(parser, input, ParseDiagnosticCode::TypeNestingCapacityExceeded)
        }
    }

    state pushed(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, code: ParseDiagnosticCode) {
        parser.type_frames[parser.type_frame_depth] = frame;
        parser.type_frame_depth = parser.type_frame_depth + 1;
        transition { _ -> operand(parser, input, code) }
    }

    state literal(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        let row: TypeReference = Parser::type_row(parser, TypeReferenceKind::Literal,
            parser.token_start, parser.token_end, parser.token_start, parser.token_end);
        transition { _ -> append(parser, input, row) }
    }

    state name(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::expect_name(parser, input, code);
        transition parser.output.accepted {
            true -> path(parser, input, parser.name_start)
            _ -> done()
        }
    }

    // `a::b::Name` names one declaration through its path; the row's name
    // spans the whole path.
    state path(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping) {
        let qualified: bool = Parser::at_punctuation(parser, input, PunctuationKind::ColonColon);
        transition qualified {
            true -> path_member(parser, input, start)
            _ -> named(parser, input, start)
        }
    }

    state path_member(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping) {
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedPathMember);
        transition parser.output.accepted {
            true -> path(parser, input, start)
            _ -> done()
        }
    }

    state named(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping) {
        let end: u64 in Trapping = parser.name_end;
        let applied: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        transition applied {
            true -> arguments_open(parser, input, start, end)
            _ -> named_row(parser, input, start, end)
        }
    }

    state named_row(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping, end: u64 in Trapping) {
        let row: TypeReference = Parser::type_row(parser, TypeReferenceKind::Named, start, end, start, end);
        transition { _ -> domain(parser, input, row) }
    }

    state arguments_open(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping, end: u64 in Trapping) {
        Parser::take_current(parser, input);
        let frame: TypeFrame = Parser::type_frame(parser, TypeFrameKind::Arguments, ReferenceAccess::Shared, start);
        transition { _ -> push(parser, input, Parser::named_frame(frame, end), ParseDiagnosticCode::ExpectedStaticArgument) }
    }

    // `Named`, `Array` and `Slice` rows may close with `in Domain`, where
    // the domain may be a path such as a case's implied domain `Type::Case`:
    // its last member is the qualifier's own name and the members before it
    // its owner path.
    state domain(parser: &mut Parser, input: &TokenStream, row: TypeReference) {
        let qualified: bool = Parser::at_word(parser, input, "in");
        transition qualified {
            true -> domain_name(parser, input, row)
            _ -> append(parser, input, row)
        }
    }

    state domain_name(parser: &mut Parser, input: &TokenStream, row: TypeReference) {
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedTypeQualifierDomain);
        transition parser.output.accepted {
            true -> domain_path(parser, input, row, parser.name_start, parser.name_start)
            _ -> done()
        }
    }

    // The path so far runs from `start`; its members before the latest end
    // at `owner_end`, which is `start` while it has one member.
    state domain_path(parser: &mut Parser, input: &TokenStream, row: TypeReference, start: u64 in Trapping, owner_end: u64 in Trapping) {
        let separated: bool = Parser::at_punctuation(parser, input, PunctuationKind::ColonColon);
        transition separated {
            true -> domain_member(parser, input, row, start, parser.name_end)
            _ -> qualified(parser, input, row, start, owner_end)
        }
    }

    state domain_member(parser: &mut Parser, input: &TokenStream, row: TypeReference, start: u64 in Trapping, owner_end: u64 in Trapping) {
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedPathMember);
        transition parser.output.accepted {
            true -> domain_path(parser, input, row, start, owner_end)
            _ -> done()
        }
    }

    state qualified(parser: &mut Parser, input: &TokenStream, row: TypeReference, start: u64 in Trapping, owner_end: u64 in Trapping) {
        let domain: IdentifierSpan = Parser::identifier_span(parser, parser.name_start, parser.name_end);
        let owner: IdentifierSpan = Parser::identifier_span(parser, start, owner_end);
        let span: SourceSpan = Parser::source_span(parser, row.source_span.span.start, parser.name_end);
        transition { _ -> append(parser, input, Parser::with_domain(row, owner_end > start, owner, domain, span)) }
    }

    state append(parser: &mut Parser, input: &TokenStream, row: TypeReference) {
        transition parser.output.type_reference_count < 65536 {
            true -> appended(parser, input, row)
            _ -> reject(parser, input, ParseDiagnosticCode::TypeReferenceCapacityExceeded)
        }
    }

    state appended(parser: &mut Parser, input: &TokenStream, row: TypeReference) {
        parser.type_result = parser.output.type_reference_count as u64 in Trapping;
        parser.type_end = row.source_span.span.end;
        parser.output.type_references[parser.output.type_reference_count] = row;
        parser.output.type_reference_count = parser.output.type_reference_count + 1;
        transition { _ -> complete(parser, input) }
    }

    // A type just completed: hand it to the innermost open frame.
    state complete(parser: &mut Parser, input: &TokenStream) {
        transition parser.type_frame_depth > 0 {
            true -> innermost(parser, input)
            _ -> done()
        }
    }

    state innermost(parser: &mut Parser, input: &TokenStream) {
        let frame: TypeFrame = Parser::top_type_frame(parser);
        transition { _ -> close(parser, input, frame) }
    }

    state close(parser: &mut Parser, input: &TokenStream, frame: TypeFrame) {
        transition frame.kind {
            TypeFrameKind::Reference -> reference_close(parser, input, frame)
            TypeFrameKind::Array -> element_close(parser, input, frame)
            TypeFrameKind::Arguments -> argument_close(parser, input, frame)
        }
    }

    state reference_close(parser: &mut Parser, input: &TokenStream, frame: TypeFrame) {
        Parser::pop_type_frame(parser);
        let row: TypeReference = Parser::type_row(parser, TypeReferenceKind::Reference, frame.start, parser.type_end, 0, 0);
        let reference: TypeReference = Parser::with_children(row, frame.first_row, parser.type_result, 0);
        let accessed: TypeReference = Parser::with_access(reference, frame.access);
        let tagged: TypeReference = Parser::with_lifetime(accessed, frame.has_lifetime, frame.lifetime);
        transition { _ -> append(parser, input, tagged) }
    }

    // After an array's element: `;` and a length make a fixed array, `]` a
    // slice.
    state element_close(parser: &mut Parser, input: &TokenStream, frame: TypeFrame) {
        let element: u64 in Trapping = parser.type_result;
        let fixed: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition fixed {
            true -> length(parser, input, frame, element)
            _ -> slice_end(parser, input, frame, element)
        }
    }

    state slice_end(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, element: u64 in Trapping) {
        Parser::expect_punctuation(parser, input, PunctuationKind::RightBracket,
            ParseDiagnosticCode::ExpectedArraySeparatorOrEnd
        );
        transition parser.output.accepted {
            true -> slice(parser, input, frame, element)
            _ -> done()
        }
    }

    state slice(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, element: u64 in Trapping) {
        Parser::pop_type_frame(parser);
        let row: TypeReference = Parser::type_row(parser, TypeReferenceKind::Slice,
            frame.start, parser.token_end, 0, 0);
        transition { _ -> domain(parser, input, Parser::with_children(row, frame.first_row, element, 0)) }
    }

    // The length is its own `Literal` or `Named` row, appended before the
    // array row so the run stays contiguous.
    state length(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, element: u64 in Trapping) {
        Parser::take_current(parser, input);
        let integer: bool = Parser::at_integer(parser, input);
        transition integer {
            true -> length_literal(parser, input, frame, element)
            _ -> length_name(parser, input, frame, element)
        }
    }

    state length_literal(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, element: u64 in Trapping) {
        Parser::take_current(parser, input);
        transition { _ -> length_row(parser, input, frame, element, TypeReferenceKind::Literal) }
    }

    state length_name(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, element: u64 in Trapping) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedArrayLength);
        transition parser.output.accepted {
            true -> length_row(parser, input, frame, element, TypeReferenceKind::Named)
            _ -> done()
        }
    }

    state length_row(
        parser: &mut Parser,
        input: &TokenStream,
        frame: TypeFrame,
        element: u64 in Trapping,
        kind: TypeReferenceKind
    ) {
        transition parser.output.type_reference_count < 65536 {
            true -> length_appended(parser, input, frame, element,
                Parser::type_row(parser, kind, parser.token_start, parser.token_end, parser.token_start, parser.token_end))
            _ -> reject(parser, input, ParseDiagnosticCode::TypeReferenceCapacityExceeded)
        }
    }

    state length_appended(
        parser: &mut Parser,
        input: &TokenStream,
        frame: TypeFrame,
        element: u64 in Trapping,
        row: TypeReference
    ) {
        let length: u64 in Trapping = parser.output.type_reference_count as u64 in Trapping;
        parser.output.type_references[parser.output.type_reference_count] = row;
        parser.output.type_reference_count = parser.output.type_reference_count + 1;
        Parser::expect_punctuation(parser, input, PunctuationKind::RightBracket, ParseDiagnosticCode::ExpectedArrayEnd);
        transition parser.output.accepted {
            true -> array(parser, input, frame, element, length)
            _ -> done()
        }
    }

    state array(
        parser: &mut Parser,
        input: &TokenStream,
        frame: TypeFrame,
        element: u64 in Trapping,
        length: u64 in Trapping
    ) {
        Parser::pop_type_frame(parser);
        let row: TypeReference = Parser::type_row(parser, TypeReferenceKind::Array,
            frame.start, parser.token_end, 0, 0);
        transition { _ -> domain(parser, input, Parser::with_children(row, frame.first_row, element, length)) }
    }

    // After a static argument: `,` opens the next and `>` closes the list.
    state argument_close(parser: &mut Parser, input: &TokenStream, frame: TypeFrame) {
        let argument: u64 in Trapping = parser.type_result;
        Parser::push_type_argument(parser, input, argument);
        transition parser.output.accepted {
            true -> argument_separator(parser, input, frame)
            _ -> done()
        }
    }

    state argument_separator(parser: &mut Parser, input: &TokenStream, frame: TypeFrame) {
        let comma: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition comma {
            true -> next_argument(parser, input)
            _ -> arguments_end(parser, input, frame)
        }
    }

    state next_argument(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> operand(parser, input, ParseDiagnosticCode::ExpectedStaticArgument) }
    }

    state arguments_end(parser: &mut Parser, input: &TokenStream, frame: TypeFrame) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Greater,
            ParseDiagnosticCode::ExpectedStaticArgumentEnd
        );
        transition parser.output.accepted {
            true -> applied(parser, input, frame, parser.token_end)
            _ -> done()
        }
    }

    state applied(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, end: u64 in Trapping) {
        Parser::pop_type_frame(parser);
        Parser::commit_type_arguments(parser, input, frame.first_argument);
        transition parser.output.accepted {
            true -> applied_lifetimes(parser, input, frame, end)
            _ -> done()
        }
    }

    state applied_lifetimes(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, end: u64 in Trapping) {
        Parser::commit_type_lifetimes(parser, input, frame.first_lifetime);
        transition parser.output.accepted {
            true -> applied_row(parser, input, frame, end)
            _ -> done()
        }
    }

    state applied_row(parser: &mut Parser, input: &TokenStream, frame: TypeFrame, end: u64 in Trapping) {
        let row: TypeReference = Parser::type_row(parser, TypeReferenceKind::Named,
            frame.start, end, frame.start, frame.name_end);
        let applied: TypeReference = Parser::with_children(row, frame.first_row, 0, 0);
        let argued: TypeReference = Parser::with_arguments(applied, parser.committed_type_first, parser.committed_type_count);
        let tagged: TypeReference = Parser::with_lifetimes(argued, parser.committed_lifetime_first, parser.committed_lifetime_count);
        transition { _ -> domain(parser, input, tagged) }
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state done() {}
}

machine Parser::type_frame(
    parser: &Parser,
    kind: TypeFrameKind,
    access: ReferenceAccess,
    start: u64 in Trapping
) -> TypeFrame {
    TypeFrame {
        kind: kind,
        access: access,
        start: start,
        name_end: start,
        first_argument: parser.pending_type_argument_count as u64 in Trapping,
        first_row: parser.output.type_reference_count as u64 in Trapping,
        has_lifetime: false,
        lifetime: Parser::identifier_span(parser, 0, 0),
        first_lifetime: parser.pending_type_lifetime_count as u64 in Trapping
    }
}

machine Parser::named_frame(frame: TypeFrame, name_end: u64 in Trapping) -> TypeFrame {
    TypeFrame {
        kind: frame.kind,
        access: frame.access,
        start: frame.start,
        name_end: name_end,
        first_argument: frame.first_argument,
        first_row: frame.first_row,
        has_lifetime: frame.has_lifetime,
        lifetime: frame.lifetime,
        first_lifetime: frame.first_lifetime
    }
}

machine Parser::lifetime_frame(frame: TypeFrame, has_lifetime: bool, lifetime: IdentifierSpan) -> TypeFrame {
    TypeFrame {
        kind: frame.kind,
        access: frame.access,
        start: frame.start,
        name_end: frame.name_end,
        first_argument: frame.first_argument,
        first_row: frame.first_row,
        has_lifetime: has_lifetime,
        lifetime: lifetime,
        first_lifetime: frame.first_lifetime
    }
}

machine Parser::frame_access(frame: TypeFrame, access: ReferenceAccess) -> TypeFrame {
    TypeFrame {
        kind: frame.kind,
        access: access,
        start: frame.start,
        name_end: frame.name_end,
        first_argument: frame.first_argument,
        first_row: frame.first_row,
        has_lifetime: frame.has_lifetime,
        lifetime: frame.lifetime,
        first_lifetime: frame.first_lifetime
    }
}

// A childless row spanning `start..end` and named `name_start..name_end`,
// which begins its own run at the next row. The `with_` constructors below
// add what each composite form carries.
machine Parser::type_row(
    parser: &Parser,
    kind: TypeReferenceKind,
    start: u64 in Trapping,
    end: u64 in Trapping,
    name_start: u64 in Trapping,
    name_end: u64 in Trapping
) -> TypeReference {
    TypeReference {
        kind: kind,
        name: Parser::identifier_span(parser, name_start, name_end),
        has_domain: false,
        domain: Parser::identifier_span(parser, 0, 0),
        has_domain_owner: false,
        domain_owner: Parser::identifier_span(parser, 0, 0),
        access: ReferenceAccess::Shared,
        inner: 0,
        length: 0,
        first_argument: 0,
        argument_count: 0,
        has_lifetime: false,
        lifetime: Parser::identifier_span(parser, 0, 0),
        first_lifetime: 0,
        lifetime_count: 0,
        first_row: parser.output.type_reference_count as u64 in Trapping,
        source_span: Parser::source_span(parser, start, end)
    }
}

machine Parser::with_children(
    row: TypeReference,
    first_row: u64 in Trapping,
    inner: u64 in Trapping,
    length: u64 in Trapping
) -> TypeReference {
    TypeReference {
        kind: row.kind,
        name: row.name,
        has_domain: row.has_domain,
        domain: row.domain,
        has_domain_owner: row.has_domain_owner,
        domain_owner: row.domain_owner,
        access: row.access,
        inner: inner,
        length: length,
        first_argument: row.first_argument,
        argument_count: row.argument_count,
        has_lifetime: row.has_lifetime,
        lifetime: row.lifetime,
        first_lifetime: row.first_lifetime,
        lifetime_count: row.lifetime_count,
        first_row: first_row,
        source_span: row.source_span
    }
}

