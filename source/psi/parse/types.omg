        has_domain: row.has_domain,
        domain: row.domain,
        has_domain_owner: row.has_domain_owner,
        domain_owner: row.domain_owner,
        access: access,
        inner: row.inner,
        length: row.length,
        first_argument: row.first_argument,
        argument_count: row.argument_count,
        has_lifetime: row.has_lifetime,
        lifetime: row.lifetime,
        first_lifetime: row.first_lifetime,
        lifetime_count: row.lifetime_count,
        first_row: row.first_row,
        source_span: row.source_span
    }
}

