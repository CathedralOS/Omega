machine Parser::top_type_frame(parser: &Parser) -> TypeFrame
crashes Trap
{
    transition parser.type_frame_depth > 0 {
        true -> element(parser, parser.type_frame_depth - 1)
        _ -> invalid()
    }

    state element(parser: &Parser, top: u64)
    requires top <= 15
    {
        parser.type_frames[top]
    }

    state invalid() -> TypeFrame {
        crash Trap;
    }
}

machine Parser::pop_type_frame(parser: &mut Parser)
crashes Trap
{
    transition parser.type_frame_depth > 0 {
        true -> pop(parser)
        _ -> invalid()
    }

    state pop(parser: &mut Parser) {
        parser.type_frame_depth = parser.type_frame_depth - 1;
    }

    state invalid() {
        crash Trap;
    }
}

// Whether the innermost open frame is a static argument list, where an
// integer is an argument rather than a type error.
machine Parser::in_type_arguments(parser: &Parser) -> bool
crashes Trap
{
    transition parser.type_frame_depth > 0 {
        true -> innermost(parser)
        _ -> outside()
    }

    state innermost(parser: &Parser) {
        let frame: TypeFrame = Parser::top_type_frame(parser);
        transition frame.kind {
            TypeFrameKind::Arguments -> inside()
            _ -> outside()
        }
    }

    state inside() {
        true
    }

    state outside() {
        false
    }
}

// Stage one completed argument until its list closes.
machine Parser::push_type_argument(parser: &mut Parser, input: &TokenStream, argument: u64 in Trapping)
crashes Trap
{
    transition parser.pending_type_argument_count < 32 {
        true -> stage(parser, argument)
        _ -> full(parser, input)
    }

    state stage(parser: &mut Parser, argument: u64 in Trapping) {
        parser.pending_type_arguments[parser.pending_type_argument_count] = argument as u64 in Trapping;
        parser.pending_type_argument_count = parser.pending_type_argument_count + 1;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::TypeArgumentCapacityExceeded);
    }
}

// Move the innermost list's staged arguments, from `base` up, into
// `SyntaxTrees::type_arguments`; their range lands in
// `committed_type_first`/`committed_type_count`.
machine Parser::commit_type_arguments(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping)
crashes Trap
{
    parser.committed_type_first = parser.output.type_argument_count as u64 in Trapping;
    parser.committed_type_count = (parser.pending_type_argument_count as u64 in Trapping) - base;
    transition { _ -> next(parser, input, base, base) }

    state next(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, cursor: u64 in Trapping) {
        transition cursor < parser.pending_type_argument_count {
            true -> capacity(parser, input, base, cursor)
            _ -> close(parser, base)
        }
    }

    state capacity(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, cursor: u64 in Trapping) {
        transition parser.output.type_argument_count < 1024 {
            true -> copy(parser, input, base, cursor)
            _ -> full(parser, input)
        }
    }

    state copy(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, cursor: u64 in Trapping) {
        parser.output.type_arguments[parser.output.type_argument_count] = parser.pending_type_arguments[cursor] as u64 in Trapping;
        parser.output.type_argument_count = parser.output.type_argument_count + 1;
        transition { _ -> next(parser, input, base, cursor + 1) }
    }

    state close(parser: &mut Parser, base: u64 in Trapping) {
        let restored: u64 = base as u64;
        transition restored <= 32 {
            true -> truncate(parser, restored)
            _ -> invalid()
        }
    }

    state truncate(parser: &mut Parser, base: u64)
    requires base <= 32
    {
        parser.pending_type_argument_count = base;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::TypeArgumentCapacityExceeded);
    }

    state invalid() {
        crash Trap;
    }
}

// `<argument {, argument}>`, a static argument list, entered at `<`. Each
// argument is a type, or an integer static value, staged on the type
// argument stack until `>` commits the list to `type_arguments`; its range
// lands in `committed_type_first`/`committed_type_count`.
pub machine Parser::parse_static_arguments(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    let base: u64 in Trapping = parser.pending_type_argument_count as u64 in Trapping;
    let lifetime_base: u64 in Trapping = parser.pending_type_lifetime_count as u64 in Trapping;
    Parser::take_current(parser, input);
    transition { _ -> argument(parser, input, base, lifetime_base) }

    state argument(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        Parser::parse_static_argument(parser, input);
        transition parser.output.accepted {
            true -> staged(parser, input, base, lifetime_base)
            _ -> done()
        }
    }

    // A lifetime argument of an invocation names a region the call binds
    // afresh; it leaves no row and the list keeps only its types.
    state staged(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        transition parser.type_lifetime_argument {
            true -> separated(parser, input, base, lifetime_base)
            _ -> typed(parser, input, base, lifetime_base)
        }
    }

    state typed(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        let argument: u64 in Trapping = parser.type_result;
        Parser::push_type_argument(parser, input, argument);
        transition parser.output.accepted {
            true -> separated(parser, input, base, lifetime_base)
            _ -> done()
        }
    }

    state separated(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        let comma: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition comma {
            true -> comma(parser, input, base, lifetime_base)
            _ -> close(parser, input, base, lifetime_base)
        }
    }

    state comma(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        Parser::take_current(parser, input);
        transition { _ -> argument(parser, input, base, lifetime_base) }
    }

    state close(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        transition parser.output.accepted {
            true -> greater(parser, input, base, lifetime_base)
            _ -> done()
        }
    }

    state greater(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Greater,
            ParseDiagnosticCode::ExpectedStaticArgumentEnd
        );
        transition parser.output.accepted {
            true -> commit(parser, input, base, lifetime_base)
            _ -> done()
        }
    }

    state commit(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        Parser::commit_type_arguments(parser, input, base);
        Parser::drop_type_lifetimes(parser, lifetime_base);
    }

    state done() {}
}

// One static argument: a type, or at its root an integer static value
// (`AtMost<8>`, `Build::f<8>(x)`). Rows and diagnostics are the type
// grammar's.
pub machine Parser::parse_static_argument(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    parser.type_static_argument = true;
    parser.type_lifetime_argument = false;
    Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedStaticArgument);
    parser.type_static_argument = false;
}

// Forget the lifetimes staged from `base` up: an invocation's are not kept.
machine Parser::drop_type_lifetimes(parser: &mut Parser, base: u64 in Trapping)
crashes Trap
{
    let restored: u64 = base as u64;
    transition restored <= 32 {
        true -> truncate(parser, restored)
        _ -> invalid()
    }

    state truncate(parser: &mut Parser, base: u64)
    requires base <= 32
    {
        parser.pending_type_lifetime_count = base;
    }

    state invalid() {
        crash Trap;
    }
}

machine Parser::with_lifetime(row: TypeReference, has_lifetime: bool, lifetime: IdentifierSpan) -> TypeReference {
    TypeReference {
        kind: row.kind,
        name: row.name,
        has_domain: row.has_domain,
        domain: row.domain,
        has_domain_owner: row.has_domain_owner,
        domain_owner: row.domain_owner,
        access: row.access,
        inner: row.inner,
        length: row.length,
        first_argument: row.first_argument,
        argument_count: row.argument_count,
        has_lifetime: has_lifetime,
        lifetime: lifetime,
        first_lifetime: row.first_lifetime,
        lifetime_count: row.lifetime_count,
        first_row: row.first_row,
        source_span: row.source_span
    }
}

machine Parser::with_lifetimes(row: TypeReference, first_lifetime: u64 in Trapping, lifetime_count: u64 in Trapping) -> TypeReference {
    TypeReference {
        kind: row.kind,
        name: row.name,
        has_domain: row.has_domain,
        domain: row.domain,
        has_domain_owner: row.has_domain_owner,
        domain_owner: row.domain_owner,
        access: row.access,
        inner: row.inner,
        length: row.length,
        first_argument: row.first_argument,
        argument_count: row.argument_count,
        has_lifetime: row.has_lifetime,
        lifetime: row.lifetime,
        first_lifetime: first_lifetime,
        lifetime_count: lifetime_count,
        first_row: row.first_row,
        source_span: row.source_span
    }
}

// Stage one lifetime argument until its list closes.
machine Parser::push_type_lifetime(parser: &mut Parser, input: &TokenStream, tag: IdentifierSpan)
crashes Trap
{
    transition parser.pending_type_lifetime_count < 32 {
        true -> stage(parser, tag)
        _ -> full(parser, input)
    }

    state stage(parser: &mut Parser, tag: IdentifierSpan) {
        parser.pending_type_lifetimes[parser.pending_type_lifetime_count] = tag;
        parser.pending_type_lifetime_count = parser.pending_type_lifetime_count + 1;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::TypeArgumentCapacityExceeded);
    }
}

// Move the innermost list's staged lifetimes, from `base` up, into
// `SyntaxTrees::type_lifetimes`; their range lands in
// `committed_lifetime_first`/`committed_lifetime_count`.
machine Parser::commit_type_lifetimes(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping)
crashes Trap
{
    parser.committed_lifetime_first = parser.output.type_lifetime_count as u64 in Trapping;
    parser.committed_lifetime_count = (parser.pending_type_lifetime_count as u64 in Trapping) - base;
    transition { _ -> next(parser, input, base, base) }

    state next(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, cursor: u64 in Trapping) {
        transition cursor < parser.pending_type_lifetime_count && cursor < 32 {
            true -> capacity(parser, input, base, cursor)
            _ -> close(parser, base)
        }
    }

    state capacity(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 32
    {
        transition parser.output.type_lifetime_count < 1024 {
            true -> copy(parser, input, base, cursor)
            _ -> full(parser, input)
        }
    }

    state copy(parser: &mut Parser, input: &TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 32
    {
        let tag: IdentifierSpan = parser.pending_type_lifetimes[cursor];
        parser.output.type_lifetimes[parser.output.type_lifetime_count] = tag;
        parser.output.type_lifetime_count = parser.output.type_lifetime_count + 1;
        transition { _ -> next(parser, input, base, cursor + 1) }
    }

    state close(parser: &mut Parser, base: u64 in Trapping) {
        let restored: u64 = base as u64;
        transition restored <= 32 {
            true -> truncate(parser, restored)
            _ -> invalid()
        }
    }

    state truncate(parser: &mut Parser, base: u64)
    requires base <= 32
    {
        parser.pending_type_lifetime_count = base;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::TypeArgumentCapacityExceeded);
    }

    state invalid() {
        crash Trap;
    }
}
