use psi::parse::expression;
use psi::parse::input;
use psi::parse::parser;
use psi::parse::types;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

// Statement grammar for machine and state bodies: `let [mut] name: Type
// [= value];`, `crash Trap;` or `crash Abort;`, `place = value;`, the
// intentional discard `_ = value;` (wiki/spec/language/effects.md), `value;`,
// `transition [subject] { arms }`, and a final unterminated `value` before
// the body's `}`, its result; a value-position `match` is a value like any
// other. Statements end at the body's `}` or, in a machine body, at its
// first `state` member; the caller then reads that token. Statement forms of
// later slices (`if`, `loop`, `while`, `return`) reject with the caller's
// `unsupported` diagnostic, the body end the grammar expects instead. The
// range lands in `body_first_statement` and the table count.
pub machine Parser::parse_statements(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode)
crashes Trap
{
    parser.body_first_statement = parser.output.statement_count as u64 in Trapping;
    transition { _ -> next(parser, input, unsupported) }

    state next(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::load_current(parser, input);
        transition parser.current_present {
            true -> classify(parser, input, unsupported)
            _ -> done()
        }
    }

    state classify(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        let token: Token = input.tokens[parser.current_index];
        parser.statement_start = token.start;
        transition token {
            Token::Punctuation { punctuation: PunctuationKind::RightBrace } -> done()
            Token::Keyword { keyword: KeywordKind::State } -> done()
            Token::Keyword { keyword: KeywordKind::Let } -> let_statement(parser, input, unsupported)
            Token::Keyword { keyword: KeywordKind::Transition } -> transition_statement(parser, input, unsupported)
            Token::Keyword { keyword: KeywordKind::If } -> reject(parser, input, unsupported)
            Token::Keyword { keyword: KeywordKind::Loop } -> reject(parser, input, unsupported)
            Token::Keyword { keyword: KeywordKind::While } -> reject(parser, input, unsupported)
            Token::Keyword { keyword: KeywordKind::Return } -> reject(parser, input, unsupported)
            Token::Identifier -> word(parser, input, unsupported)
            _ -> expression_statement(parser, input, unsupported)
        }
    }

    // `crash` is a contextual word: it always opens a crash statement. `_`
    // before `=` opens an intentional discard.
    state word(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        let crash: bool = Parser::at_word(parser, input, "crash");
        let underscore: bool = Parser::at_word(parser, input, "_");
        let assigned: bool = Parser::next_is_punctuation(parser, input, PunctuationKind::Equal);
        transition crash {
            true -> crash_statement(parser, input, unsupported)
            _ -> discard_or_value(parser, input, unsupported, underscore && assigned)
        }
    }

    state discard_or_value(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, discard: bool) {
        transition discard {
            true -> discard_statement(parser, input, unsupported)
            _ -> expression_statement(parser, input, unsupported)
        }
    }

    state discard_statement(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::take_current(parser, input);
        Parser::take_current(parser, input);
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedAssignmentValue, true, true);
        transition parser.output.accepted {
            true -> discard_end(parser, input, unsupported, parser.expression_result)
            _ -> done()
        }
    }

    state discard_end(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, value: u64 in Trapping) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon,
            ParseDiagnosticCode::ExpectedAssignmentSemicolon
        );
        transition parser.output.accepted {
            true -> discard_retained(parser, input, unsupported, value)
            _ -> done()
        }
    }

    state discard_retained(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, value: u64 in Trapping) {
        let statement: Statement = Statement {
            kind: StatementKind::Discard,
            name: Parser::identifier_span(parser, 0, 0),
            is_mutable: false,
            type_reference: 0,
            has_value: true,
            value: value,
            target: 0,
            cause: CrashCause::Trap,
            first_arm: 0,
            arm_count: 0,
            source_span: Parser::source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    state crash_statement(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::take_current(parser, input);
        let trap: bool = Parser::at_word(parser, input, "Trap");
        transition trap {
            true -> crash_cause(parser, input, unsupported, CrashCause::Trap)
            _ -> crash_abort(parser, input, unsupported)
        }
    }

    state crash_abort(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        let abort: bool = Parser::at_word(parser, input, "Abort");
        transition abort {
            true -> crash_cause(parser, input, unsupported, CrashCause::Abort)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedCrashCause)
        }
    }

    state crash_cause(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, cause: CrashCause) {
        Parser::take_current(parser, input);
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedCrashEnd);
        transition parser.output.accepted {
            true -> crash_retained(parser, input, unsupported, cause)
            _ -> done()
        }
    }

    state crash_retained(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, cause: CrashCause) {
        let statement: Statement = Statement {
            kind: StatementKind::Crash,
            name: Parser::identifier_span(parser, 0, 0),
            is_mutable: false,
            type_reference: 0,
            has_value: false,
            value: 0,
            target: 0,
            cause: cause,
            first_arm: 0,
            arm_count: 0,
            source_span: Parser::source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    state let_statement(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::take_current(parser, input);
        let mutable: bool = Parser::at_word(parser, input, "mut");
        transition mutable {
            true -> let_mut(parser, input, unsupported)
            _ -> let_name(parser, input, unsupported, false)
        }
    }

    // `mut` marks mutability only before a name; `let mut: T` declares a
    // local named `mut`.
    state let_mut(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::take_current(parser, input);
        let named: bool = Parser::at_name(parser, input);
        transition named {
            true -> let_name(parser, input, unsupported, true)
            _ -> let_named_mut(parser, input, unsupported)
        }
    }

    state let_named_mut(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        parser.local_mutable = false;
        parser.local_name_start = parser.token_start;
        parser.local_name_end = parser.token_end;
        transition { _ -> let_colon(parser, input, unsupported) }
    }

    state let_name(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, mutable: bool) {
        parser.local_mutable = mutable;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedLocalDataName);
        transition parser.output.accepted {
            true -> let_named(parser, input, unsupported)
            _ -> done()
        }
    }

    state let_named(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        parser.local_name_start = parser.name_start;
        parser.local_name_end = parser.name_end;
        transition { _ -> let_colon(parser, input, unsupported) }
    }

    state let_colon(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Colon, ParseDiagnosticCode::ExpectedLocalDataColon);
        transition parser.output.accepted {
            true -> let_type(parser, input, unsupported)
            _ -> done()
        }
    }

    state let_type(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedLocalDataType);
        transition parser.output.accepted {
            true -> let_initializer(parser, input, unsupported)
            _ -> done()
        }
    }

    state let_initializer(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        parser.local_type = parser.type_result;
        let initialized: bool = Parser::at_punctuation(parser, input, PunctuationKind::Equal);
        transition initialized {
            true -> let_value(parser, input, unsupported)
            _ -> let_end(parser, input, unsupported, false, 0)
        }
    }

    state let_value(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::take_current(parser, input);
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedLocalDataInitialValue, true, true);
        transition parser.output.accepted {
            true -> let_end(parser, input, unsupported, true, parser.expression_result)
            _ -> done()
        }
    }

    state let_end(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_value: bool,
        value: u64 in Trapping
    ) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedLocalDataEnd);
        transition parser.output.accepted {
            true -> let_retained(parser, input, unsupported, has_value, value)
            _ -> done()
        }
    }

    state let_retained(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_value: bool,
        value: u64 in Trapping
    ) {
        let statement: Statement = Statement {
            kind: StatementKind::Let,
            name: Parser::identifier_span(parser, parser.local_name_start, parser.local_name_end),
            is_mutable: parser.local_mutable,
            type_reference: parser.local_type,
            has_value: has_value,
            value: value,
            target: 0,
            cause: CrashCause::Trap,
            first_arm: 0,
            arm_count: 0,
            source_span: Parser::source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    state expression_statement(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::parse_expression(parser, input, unsupported, true, true);
        transition parser.output.accepted {
            true -> after_expression(parser, input, unsupported, parser.expression_result)
            _ -> done()
        }
    }

    state after_expression(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, value: u64 in Trapping) {
        Parser::load_current(parser, input);
        transition parser.current_present {
            true -> statement_end(parser, input, unsupported, value)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedStatementEnd)
        }
    }

    state statement_end(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, value: u64 in Trapping) {
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Punctuation { punctuation: PunctuationKind::Equal } -> assignment(parser, input, unsupported, value)
            Token::Punctuation { punctuation: PunctuationKind::Semicolon } -> terminated(parser, input, unsupported, value)
            Token::Punctuation { punctuation: PunctuationKind::RightBrace } -> tail(parser, input, unsupported, value)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedStatementEnd)
        }
    }

    state assignment(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, target: u64 in Trapping) {
        Parser::take_current(parser, input);
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedAssignmentValue, true, true);
        transition parser.output.accepted {
            true -> assignment_end(parser, input, unsupported, target, parser.expression_result)
            _ -> done()
        }
    }

    state assignment_end(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        target: u64 in Trapping,
        value: u64 in Trapping
    ) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon,
            ParseDiagnosticCode::ExpectedAssignmentSemicolon
        );
        transition parser.output.accepted {
            true -> assignment_retained(parser, input, unsupported, target, value)
            _ -> done()
        }
    }

    state assignment_retained(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        target: u64 in Trapping,
        value: u64 in Trapping
    ) {
        let statement: Statement = Statement {
            kind: StatementKind::Assign,
            name: Parser::identifier_span(parser, 0, 0),
            is_mutable: false,
            type_reference: 0,
            has_value: true,
            value: value,
            target: target,
            cause: CrashCause::Trap,
            first_arm: 0,
            arm_count: 0,
            source_span: Parser::source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    state terminated(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, value: u64 in Trapping) {
        Parser::take_current(parser, input);
        let statement: Statement = Statement {
            kind: StatementKind::Expression,
            name: Parser::identifier_span(parser, 0, 0),
            is_mutable: false,
            type_reference: 0,
            has_value: true,
            value: value,
            target: 0,
            cause: CrashCause::Trap,
            first_arm: 0,
            arm_count: 0,
            source_span: Parser::source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    // The body's `}` stays for the caller; the tail ends at its expression.
    state tail(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, value: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(&parser.output, value);
        let statement: Statement = Statement {
            kind: StatementKind::Tail,
            name: Parser::identifier_span(parser, 0, 0),
            is_mutable: false,
            type_reference: 0,
            has_value: true,
            value: value,
            target: 0,
            cause: CrashCause::Trap,
            first_arm: 0,
            arm_count: 0,
            source_span: Parser::source_span(parser, parser.statement_start, expression.source_span.span.end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    state store(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, statement: Statement) {
        transition parser.output.statement_count < 16384 {
            true -> store_bounded(parser, input, unsupported, statement)
            _ -> reject(parser, input, ParseDiagnosticCode::StatementCapacityExceeded)
        }
    }

    state store_bounded(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, statement: Statement) {
        parser.output.statements[parser.output.statement_count] = statement;
        parser.output.statement_count = parser.output.statement_count + 1;
        transition { _ -> next(parser, input, unsupported) }
    }

    // `transition { guard -> target ... }` or `transition subject { pattern
    // -> target ... }`. The subject admits no construction: its `{` opens
    // the arms.
    state transition_statement(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::take_current(parser, input);
        let open: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBrace);
        transition open {
            true -> arms_open(parser, input, unsupported, false, 0)
            _ -> transition_subject(parser, input, unsupported)
        }
    }

    state transition_subject(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode) {
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedTransitionSubject, false, true);
        transition parser.output.accepted {
            true -> subject_open(parser, input, unsupported, parser.expression_result)
            _ -> done()
        }
    }

    state subject_open(parser: &mut Parser, input: &TokenStream, unsupported: ParseDiagnosticCode, subject: u64 in Trapping) {
        let open: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBrace);
        transition open {
            true -> arms_open(parser, input, unsupported, true, subject)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedTransitionArm)
        }
    }

    state arms_open(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        Parser::take_current(parser, input);
        parser.transition_first_arm = parser.output.arm_count as u64 in Trapping;
        transition { _ -> arm(parser, input, unsupported, has_subject, subject) }
    }

    state arm(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBrace);
        transition closing {
            true -> transition_close(parser, input, unsupported, has_subject, subject)
            _ -> arm_start(parser, input, unsupported, has_subject, subject)
        }
    }

    state arm_start(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        Parser::load_current(parser, input);
        transition parser.current_present {
            true -> arm_pattern(parser, input, unsupported, has_subject, subject)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedTransitionArm)
        }
    }

    state arm_pattern(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        let token: Token = input.tokens[parser.current_index];
        parser.arm_start = token.start;
        parser.arm_has_guard = false;
        parser.arm_guard = 0;
        let wildcard: bool = Parser::at_word(parser, input, "_");
        transition wildcard {
            true -> wildcard_arm(parser, input, unsupported, has_subject, subject)
            _ -> arm_expression(parser, input, unsupported, has_subject, subject)
        }
    }

    state wildcard_arm(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        Parser::take_current(parser, input);
        transition { _ -> arm_guard(parser, input, unsupported, has_subject, subject, ArmPatternKind::Wildcard, 0, 0, 0) }
    }

    state arm_expression(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedTransitionArm, false, true);
        transition parser.output.accepted {
            true -> arm_classify(parser, input, unsupported, has_subject, subject, parser.expression_result)
            _ -> done()
        }
    }

    // A subjectless block's arms are guards; a subject's arms are case paths
    // or literal patterns.
    state arm_classify(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        let expression: Expression = SyntaxTrees::expression(&parser.output, pattern);
        transition has_subject {
            true -> subject_pattern(parser, input, unsupported, subject, pattern, expression.kind)
            _ -> arm_guard(parser, input, unsupported, false, subject, ArmPatternKind::Guard, pattern, 0, 0)
        }
    }

    state subject_pattern(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        kind: ExpressionKind
    ) {
        transition kind {
            ExpressionKind::Name -> case_pattern(parser, input, unsupported, subject, pattern)
            ExpressionKind::Path -> case_pattern(parser, input, unsupported, subject, pattern)
            _ -> arm_guard(parser, input, unsupported, true, subject, ArmPatternKind::Literal, pattern, 0, 0)
        }
    }

    state case_pattern(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        parser.pattern_first_field = parser.output.pattern_field_count as u64 in Trapping;
        let braced: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBrace);
        transition braced {
            true -> pattern_fields_open(parser, input, unsupported, subject, pattern)
            _ -> arm_guard(parser, input, unsupported, true, subject, ArmPatternKind::Case, pattern,
                parser.pattern_first_field, 0)
        }
    }

    state pattern_fields_open(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        Parser::take_current(parser, input);
        transition { _ -> pattern_field_or_end(parser, input, unsupported, subject, pattern) }
    }

    state pattern_field_or_end(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBrace);
        transition closing {
            true -> pattern_fields_close(parser, input, unsupported, subject, pattern)
            _ -> pattern_field(parser, input, unsupported, subject, pattern)
        }
    }

    state pattern_field(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedPatternField);
        transition parser.output.accepted {
            true -> pattern_field_named(parser, input, unsupported, subject, pattern)
            _ -> done()
        }
    }

    state pattern_field_named(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        parser.pattern_field_start = parser.name_start;
        parser.pattern_field_end = parser.name_end;
        let valued: bool = Parser::at_punctuation(parser, input, PunctuationKind::Colon);
        let renamed: bool = Parser::at_keyword(parser, input, KeywordKind::As);
        let binder: PatternField = Parser::pattern_binder(parser);
        transition valued {
            true -> pattern_field_value(parser, input, unsupported, subject, pattern)
            _ -> pattern_field_binder(parser, input, unsupported, subject, pattern, binder, renamed)
        }
    }

    // `field as name` binds the field under another name; `field as _`
    // waives it.
    state pattern_field_binder(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        binder: PatternField,
        renamed: bool
    ) {
        transition renamed {
            true -> pattern_field_rename(parser, input, unsupported, subject, pattern, binder)
            _ -> pattern_field_store(parser, input, unsupported, subject, pattern, binder)
        }
    }

    state pattern_field_rename(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        binder: PatternField
    ) {
        Parser::take_current(parser, input);
        let waived: bool = Parser::at_word(parser, input, "_");
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedPatternRename);
        transition parser.output.accepted {
            true -> pattern_field_store(parser, input, unsupported, subject, pattern,
                Parser::renamed_binder(parser, binder, waived))
            _ -> done()
        }
    }

    state pattern_field_value(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        Parser::take_current(parser, input);
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedPatternField, false, true);
        transition parser.output.accepted {
            true -> pattern_field_valued(parser, input, unsupported, subject, pattern, parser.expression_result)
            _ -> done()
        }
    }

    state pattern_field_valued(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        value: u64 in Trapping
    ) {
        let expression: Expression = SyntaxTrees::expression(&parser.output, value);
        transition { _ -> pattern_field_store(parser, input, unsupported, subject, pattern,
            Parser::valued_pattern_field(parser, value, expression.source_span.span.end)) }
    }

    state pattern_field_store(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        field: PatternField
    ) {
        transition parser.output.pattern_field_count < 2048 {
            true -> pattern_field_stored(parser, input, unsupported, subject, pattern, field)
            _ -> reject(parser, input, ParseDiagnosticCode::PatternFieldCapacityExceeded)
        }
    }

    state pattern_field_stored(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        field: PatternField
    ) {
        parser.output.pattern_fields[parser.output.pattern_field_count] = field;
        parser.output.pattern_field_count = parser.output.pattern_field_count + 1;
        let separator: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition separator {
            true -> pattern_field_separator(parser, input, unsupported, subject, pattern)
            _ -> pattern_field_end(parser, input, unsupported, subject, pattern)
        }
    }

    state pattern_field_separator(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        Parser::take_current(parser, input);
        transition { _ -> pattern_field_or_end(parser, input, unsupported, subject, pattern) }
    }

    state pattern_field_end(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        let closing: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBrace);
        transition closing {
            true -> pattern_fields_close(parser, input, unsupported, subject, pattern)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedPatternFieldEnd)
        }
    }

    state pattern_fields_close(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        Parser::take_current(parser, input);
        let count: u64 in Trapping = (parser.output.pattern_field_count as u64 in Trapping) - parser.pattern_first_field;
        transition { _ -> arm_guard(parser, input, unsupported, true, subject, ArmPatternKind::Case, pattern,
            parser.pattern_first_field, count) }
    }

    // `if condition` after any pattern guards the arm: the condition is an
    // expression over the pattern's binders and the body's names, read
    // before the arrow.
    state arm_guard(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        let guarded: bool = Parser::at_keyword(parser, input, KeywordKind::If);
        transition guarded {
            true -> guard_condition(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count)
            _ -> arm_arrow(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count)
        }
    }

    state guard_condition(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        Parser::take_current(parser, input);
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedArmGuard, false, true);
        parser.arm_has_guard = true;
        parser.arm_guard = parser.expression_result;
        transition parser.output.accepted {
            true -> arm_arrow(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count)
            _ -> done()
        }
    }

    state arm_arrow(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Arrow, ParseDiagnosticCode::ExpectedTransitionArrow);
        transition parser.output.accepted {
            true -> arm_target(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count)
            _ -> done()
        }
    }

    // A target is `{}`, the explicit Unit completion, or an expression: a
    // call naming a declaration or any terminal value. A value may be a
    // construction, since no arm begins with `{`.
    state arm_target(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        let terminal: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBrace);
        transition terminal {
            true -> terminal_target(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count)
            _ -> call_target(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count)
        }
    }

    state terminal_target(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        Parser::take_current(parser, input);
        Parser::expect_punctuation(parser, input, PunctuationKind::RightBrace,
            ParseDiagnosticCode::ExpectedTransitionTargetClose
        );
        transition parser.output.accepted {
            true -> store_arm(parser, input, unsupported, has_subject, subject, TransitionArm {
                kind: kind,
                pattern: pattern,
                first_field: first_field,
                field_count: field_count,
                has_guard: parser.arm_has_guard,
                guard: parser.arm_guard,
                target_kind: ArmTargetKind::Unit,
                target: 0,
                source_span: Parser::source_span(parser, parser.arm_start, parser.token_end)
            })
            _ -> done()
        }
    }

    state call_target(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedTransitionTarget, true, true);
        transition parser.output.accepted {
            true -> call_target_shape(parser, input, unsupported, has_subject, subject, kind, pattern, first_field,
                field_count, parser.expression_result)
            _ -> done()
        }
    }

    // A call target names a state or machine: a bare name (a state first)
    // or an owned machine path such as `Owner::step`. Every other expression
    // but an acknowledgement is a terminal value.
    state call_target_shape(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping,
        target: u64 in Trapping
    ) {
        let call: Expression = SyntaxTrees::expression(&parser.output, target);
        let acknowledged: bool = Parser::acknowledges(call.operator);
        transition call.kind {
            ExpressionKind::Call -> call_target_callee(parser, input, unsupported, has_subject, subject, kind, pattern,
                first_field, field_count, target, call)
            ExpressionKind::Unary -> unary_target(parser, input, unsupported, has_subject, subject, kind,
                pattern, first_field, field_count, target, call, acknowledged)
            _ -> value_target(parser, input, unsupported, has_subject, subject, kind, pattern, first_field,
                field_count, target, call)
        }
    }

    state unary_target(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping,
        target: u64 in Trapping,
        unary: Expression,
        acknowledged: bool
    ) {
        transition acknowledged {
            true -> acknowledged_target(parser, input, unsupported, has_subject, subject, kind, pattern,
                first_field, field_count, target, unary)
            _ -> value_target(parser, input, unsupported, has_subject, subject, kind, pattern, first_field,
                field_count, target, unary)
        }
    }

    state value_target(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping,
        target: u64 in Trapping,
        value: Expression
    ) {
        transition {
            _ -> store_arm(parser, input, unsupported, has_subject, subject, TransitionArm {
                kind: kind,
                pattern: pattern,
                first_field: first_field,
                field_count: field_count,
                has_guard: parser.arm_has_guard,
                guard: parser.arm_guard,
                target_kind: ArmTargetKind::Value,
                target: target,
                source_span: Parser::source_span(parser, parser.arm_start, value.source_span.span.end)
            })
        }
    }

    // A target may acknowledge its call's operational effects
    // (`-> suspend block read(source)`); the arm keeps the acknowledged node,
    // whose operand must be a call.
    state acknowledged_target(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping,
        target: u64 in Trapping,
        acknowledgement: Expression
    ) {
        let call: Expression = SyntaxTrees::expression(&parser.output, acknowledgement.left);
        let acknowledged: bool = Parser::acknowledges(acknowledgement.operator);
        transition acknowledged && call.kind == ExpressionKind::Call {
            true -> call_target_callee(parser, input, unsupported, has_subject, subject, kind, pattern,
                first_field, field_count, target, call)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedTransitionTargetOpen)
        }
    }

    state call_target_callee(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping,
        target: u64 in Trapping,
        call: Expression
    ) {
        let callee: Expression = SyntaxTrees::expression(&parser.output, call.left);
        let arm: TransitionArm = TransitionArm {
            kind: kind,
            pattern: pattern,
            first_field: first_field,
            field_count: field_count,
            has_guard: parser.arm_has_guard,
            guard: parser.arm_guard,
            target_kind: ArmTargetKind::Call,
            target: target,
            source_span: Parser::source_span(parser, parser.arm_start, call.source_span.span.end)
        };
        let named: bool = Parser::names_declaration(callee.kind);
        transition named {
            true -> store_arm(parser, input, unsupported, has_subject, subject, arm)
            _ -> reject_at(parser, ParseDiagnosticCode::ExpectedTransitionTarget, callee.source_span)
        }
    }

    state store_arm(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        arm: TransitionArm
    ) {
        transition parser.output.arm_count < 8192 {
            true -> arm_stored(parser, input, unsupported, has_subject, subject, arm)
            _ -> reject(parser, input, ParseDiagnosticCode::ArmCapacityExceeded)
        }
    }

    state arm_stored(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        arm: TransitionArm
    ) {
        parser.output.arms[parser.output.arm_count] = arm;
        parser.output.arm_count = parser.output.arm_count + 1;
        transition { _ -> arm(parser, input, unsupported, has_subject, subject) }
    }

    state transition_close(
        parser: &mut Parser,
        input: &TokenStream,
        unsupported: ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        Parser::take_current(parser, input);
        let statement: Statement = Statement {
            kind: StatementKind::Transition,
            name: Parser::identifier_span(parser, 0, 0),
            is_mutable: false,
            type_reference: 0,
            has_value: has_subject,
            value: subject,
            target: 0,
            cause: CrashCause::Trap,
            first_arm: parser.transition_first_arm,
            arm_count: (parser.output.arm_count as u64 in Trapping) - parser.transition_first_arm,
            source_span: Parser::source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    state reject_at(parser: &mut Parser, code: ParseDiagnosticCode, source_span: SourceSpan) {
        SyntaxTrees::reject(&mut parser.output, code, source_span.source, source_span.span.start, source_span.span.end);
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state done() {}
}

// Whether `operator` is a call acknowledgement prefix.
machine Parser::acknowledges(operator: OperatorKind) -> bool {
    transition operator {
        OperatorKind::Suspend -> acknowledgement()
        OperatorKind::Block -> acknowledgement()
        OperatorKind::SuspendBlock -> acknowledgement()
        _ -> other()
    }

    state acknowledgement() {
        true
    }

    state other() {
        false
    }
}

// A pattern field binding its own name, spanning the name.
machine Parser::pattern_binder(parser: &Parser) -> PatternField {
    PatternField {
        name: Parser::identifier_span(parser, parser.pattern_field_start, parser.pattern_field_end),
        has_value: false,
        value: 0,
        has_rename: false,
        rename: Parser::identifier_span(parser, 0, 0),
        is_waived: false,
        source_span: Parser::source_span(parser, parser.pattern_field_start, parser.pattern_field_end)
    }
}

// The binder renamed by the last name step, through that name; `_` waives it.
machine Parser::renamed_binder(parser: &Parser, binder: PatternField, waived: bool) -> PatternField {
    PatternField {
        name: binder.name,
        has_value: false,
        value: 0,
        has_rename: true,
        rename: Parser::identifier_span(parser, parser.name_start, parser.name_end),
        is_waived: waived,
        source_span: Parser::source_span(parser, parser.pattern_field_start, parser.name_end)
    }
}

// A pattern field compared with `value`, through `end`.
machine Parser::valued_pattern_field(parser: &Parser, value: u64 in Trapping, end: u64 in Trapping) -> PatternField {
    PatternField {
        name: Parser::identifier_span(parser, parser.pattern_field_start, parser.pattern_field_end),
        has_value: true,
        value: value,
        has_rename: false,
        rename: Parser::identifier_span(parser, 0, 0),
        is_waived: false,
        source_span: Parser::source_span(parser, parser.pattern_field_start, end)
    }
}
