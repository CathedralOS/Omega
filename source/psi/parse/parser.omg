use psi::parse::clause;
use psi::parse::conformance;
use psi::parse::constant;
use psi::parse::data;
use psi::parse::definition;
use psi::parse::domain;
use psi::parse::expression;
use psi::parse::generics;
use psi::parse::input;
use psi::parse::machine;
use psi::parse::path;
use psi::parse::proposition;
use psi::parse::statement;
use psi::parse::traits;
use psi::parse::types;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

// One parser owns one output arena and parse-local scratch. The lexer keeps
// its TokenStream; `parse` observes it through one shared borrow forwarded
// along every state edge that reads a token, so no token or stream is copied
// and nothing is moved out of the owning lexer.
pub data Parser
where
    current_index <= 65535,
    expression_operand_depth <= 64,
    expression_operator_depth <= 64,
    expression_frame_depth <= 32,
    pending_argument_count <= 256,
    pending_field_count <= 64,
    type_frame_depth <= 16,
    pending_type_argument_count <= 32,
    pending_type_lifetime_count <= 32,
    pending_arm_count <= 64,
    ranked_subject_count <= 8,
{
    output: SyntaxTrees;
    source: SourceId;
    source_length: u64 in Trapping;
    cursor: u64 in Trapping;
    current_index: u64;
    current_present: bool;
    item_start: u64 in Trapping;
    use_first_member: u64 in Trapping;
    data_item_start: u64 in Trapping;
    data_first_member: u64 in Trapping;
    data_first_field: u64 in Trapping;
    data_first_case: u64 in Trapping;
    data_name_start: u64 in Trapping;
    data_name_end: u64 in Trapping;
    data_is_public: bool;
    data_is_boundary: bool;
    data_multiplicity: DataMultiplicity;
    data_first_generic: u64 in Trapping;
    data_first_clause: u64 in Trapping;
    data_clause_count: u64 in Trapping;
    // Data member scratch: the member under way, its name and its stable
    // identity, and where the payload field under way begins.
    member_start: u64 in Trapping;
    member_name_start: u64 in Trapping;
    member_name_end: u64 in Trapping;
    member_has_identity: bool;
    member_identity_start: u64 in Trapping;
    member_identity_end: u64 in Trapping;
    payload_field_start: u64 in Trapping;
    case_first_payload_field: u64 in Trapping;
    property_multiplicity: DataMultiplicity;
    generic_saw_runtime: bool;
    // Grammar-step results: the last taken token, the last expected name,
    // the last optional stable identity, and the last completed type
    // reference's handle, start and end.
    token_start: u64 in Trapping;
    token_end: u64 in Trapping;
    name_start: u64 in Trapping;
    name_end: u64 in Trapping;
    identity_present: bool;
    identity_start: u64 in Trapping;
    identity_end: u64 in Trapping;
    type_result: u64 in Trapping;
    type_end: u64 in Trapping;
    // Type stacks: open type constructors and the static arguments staged
    // until their list closes.
    type_frames: [TypeFrame; 16] in Trapping;
    type_frame_depth: u64;
    pending_type_arguments: [u64; 32] in Trapping;
    pending_type_argument_count: u64;
    // Lifetime arguments staged like the type arguments, and whether the
    // static argument just parsed was one (it leaves no row).
    pending_type_lifetimes: [IdentifierSpan; 32];
    pending_type_lifetime_count: u64;
    type_lifetime_argument: bool;
    type_static_argument: bool;
    committed_type_first: u64 in Trapping;
    committed_type_count: u64 in Trapping;
    committed_lifetime_first: u64 in Trapping;
    committed_lifetime_count: u64 in Trapping;
    machine_start: u64 in Trapping;
    machine_is_public: bool;
    machine_has_target: bool;
    machine_target_start: u64 in Trapping;
    machine_target_end: u64 in Trapping;
    machine_is_boundary: bool;
    machine_container: MachineContainer;
    machine_has_owner: bool;
    machine_owner_start: u64 in Trapping;
    machine_owner_end: u64 in Trapping;
    machine_name_start: u64 in Trapping;
    machine_name_end: u64 in Trapping;
    machine_first_generic: u64 in Trapping;
    machine_first_expression: u64 in Trapping;
    machine_first_parameter: u64 in Trapping;
    machine_parameter_count: u64 in Trapping;
    machine_has_return_type: bool;
    machine_return_type: u64 in Trapping;
    machine_first_clause: u64 in Trapping;
    machine_clause_count: u64 in Trapping;
    machine_first_statement: u64 in Trapping;
    machine_statement_count: u64 in Trapping;
    machine_first_state: u64 in Trapping;
    machine_generic_count: u64 in Trapping;
    machine_operator: OperatorToken;
    machine_token_start: u64 in Trapping;
    machine_token_end: u64 in Trapping;
    machine_first_contract: u64 in Trapping;
    machine_first_component: u64 in Trapping;
    machine_component_count: u64 in Trapping;
    // A `where machine` or `where proposition` contract under way.
    contract_start: u64 in Trapping;
    contract_name_start: u64 in Trapping;
    contract_name_end: u64 in Trapping;
    contract_first_generic: u64 in Trapping;
    state_start: u64 in Trapping;
    state_name_start: u64 in Trapping;
    state_name_end: u64 in Trapping;
    state_first_clause: u64 in Trapping;
    state_clause_count: u64 in Trapping;
    signature_first_parameter: u64 in Trapping;
    signature_parameter_count: u64 in Trapping;
    signature_has_return_type: bool;
    signature_return_type: u64 in Trapping;
    parameter_name_start: u64 in Trapping;
    parameter_name_end: u64 in Trapping;
    parameter_mutable: bool;
    // Expression stacks: operands, pending operators and open brackets, with
    // the arguments and construction fields staged until their bracket closes.
    expression_operands: [u64; 64] in Trapping;
    expression_operand_depth: u64;
    expression_operators: [PendingOperator; 64] in Trapping;
    expression_operator_depth: u64;
    expression_frames: [ExpressionFrame; 32] in Trapping;
    expression_frame_depth: u64;
    pending_arguments: [u64; 256] in Trapping;
    pending_argument_count: u64;
    pending_fields: [ConstructField; 64] in Trapping;
    pending_field_count: u64;
    // A value-position match's arms stage here until its `}`.
    pending_arms: [TransitionArm; 64] in Trapping;
    pending_arm_count: u64;
    expression_result: u64 in Trapping;
    expression_allow_construct: bool;
    expression_allow_membership: bool;
    path_first_member: u64 in Trapping;
    path_start: u64 in Trapping;
    committed_first: u64 in Trapping;
    committed_count: u64 in Trapping;
    // Statement scratch: the body's first statement and a `let` under way.
    body_first_statement: u64 in Trapping;
    statement_start: u64 in Trapping;
    local_mutable: bool;
    local_name_start: u64 in Trapping;
    local_name_end: u64 in Trapping;
    local_type: u64 in Trapping;
    transition_first_arm: u64 in Trapping;
    arm_start: u64 in Trapping;
    // The arm being parsed's `if` guard, read where its row is stored.
    arm_has_guard: bool;
    arm_guard: u64 in Trapping;
    pattern_first_field: u64 in Trapping;
    pattern_field_start: u64 in Trapping;
    pattern_field_end: u64 in Trapping;
    clause_first: u64 in Trapping;
    clause_start: u64 in Trapping;
    clause_first_member: u64 in Trapping;
    clause_first_argument: u64 in Trapping;
    clause_argument_count: u64 in Trapping;
    // A ranking witness's subjects stage here until its list closes.
    ranked_subjects: [u64; 8] in Trapping;
    ranked_subject_count: u64;
    // Declaration scratch for the trait, conformance, domain, constant and
    // proposition grammars; one root declaration is under way at a time, and
    // a member machine keeps its own `machine_*` scratch.
    declaration_start: u64 in Trapping;
    declaration_is_public: bool;
    declaration_is_boundary: bool;
    declaration_has_owner: bool;
    declaration_owner_start: u64 in Trapping;
    declaration_owner_end: u64 in Trapping;
    declaration_name_start: u64 in Trapping;
    declaration_name_end: u64 in Trapping;
    declaration_first_generic: u64 in Trapping;
    // A trait's or conformance's own generic parameters, counted where its
    // header ends: its member machines append their own after them.
    declaration_generic_count: u64 in Trapping;
    declaration_first_parent: u64 in Trapping;
    declaration_first_machine: u64 in Trapping;
    declaration_first_row: u64 in Trapping;
    declaration_type: u64 in Trapping;
    declaration_first_argument: u64 in Trapping;
    declaration_argument_count: u64 in Trapping;
    declaration_has_subject: bool;
    declaration_subject_start: u64 in Trapping;
    declaration_subject_end: u64 in Trapping;
    declaration_first_clause: u64 in Trapping;
    declaration_clause_count: u64 in Trapping;
    declaration_first_path: u64 in Trapping;
    declaration_first_parameter: u64 in Trapping;
    declaration_parameter_count: u64 in Trapping;
    declaration_first_contract: u64 in Trapping;
    declaration_is_refinement: bool;
    // The last completed name path's handle.
    name_path_result: u64 in Trapping;
}

// Empty syntax tables for a compilation's source units, which `parse` then
// appends one at a time. Every row keeps its unit in its source span, so the
// tables are shared and handles stay dense across units.
pub machine Parser::initialize(parser: &mut Parser) {
    SyntaxTrees::clear(&mut parser.output, SourceId { value: 0 });
}

// The unit `parse` appends next: its spans anchor to `source`, and its token
// cursor starts over.
machine Parser::begin_unit(parser: &mut Parser, source: SourceId, source_length: u64 in Trapping) {
    parser.source = source;
    parser.source_length = source_length;
    Parser::initialize_cursor(parser);
}

// Every stored span anchors to the parser's own source; the two constructors
// keep the three-level SourceSpan/IdentifierSpan literals out of grammar states.
machine Parser::source_span(
    parser: &Parser,
    start: u64 in Trapping,
    end: u64 in Trapping
) -> SourceSpan {
    SourceSpan {
        source: parser.source,
        span: Span { start: start, end: end }
    }
}

machine Parser::identifier_span(
    parser: &Parser,
    start: u64 in Trapping,
    end: u64 in Trapping
) -> IdentifierSpan {
    IdentifierSpan {
        source_span: Parser::source_span(parser, start, end)
    }
}

// Whole-file sequencing and use-item grammar. Every other declaration is
// delegated to its grammar machine (data.omg, machine.omg, traits.omg,
// conformance.omg, domain.omg, constant.omg, proposition.omg,
// definition.omg), the shared type grammar lives in types.omg, and input.omg
// remains the only token/cursor behavior owner. A root is `[pub]` and then a
// declaration: `use`, `data`, `machine` and `let` by keyword; `boundary`,
// `trait`, `domain`, `const` and `proposition` by contextual word; and, led
// by a name, a target-scoped `target [boundary] machine` or a named
// conformance `Name [<...>] satisfies`. The retired `boundary requirement` and `operator`
// introducers reject at their word. Bounded array reads carry their
// collection's Trapping policy, so parsing publishes the same crash route
// its callees do.
pub machine Parser::parse(
    parser: &mut Parser,
    source: SourceId,
    source_length: u64 in Trapping,
    input: &TokenStream
)
crashes Trap
{
    Parser::begin_unit(parser, source, source_length);
    transition { _ -> next_root(parser, input) }

    state next_root(parser: &mut Parser, input: &TokenStream) {
        transition parser.cursor < input.token_count {
            true -> classify_root(parser, input)
            _ -> done()
        }
    }

    state classify_root(parser: &mut Parser, input: &TokenStream) {
        Parser::load_current(parser, input);
        let token: Token = input.tokens[parser.current_index];
        parser.item_start = token.start;
        transition token {
            Token::Keyword { keyword } -> classify_root_keyword(parser, input,
                keyword,
                token.start,
                token.end
            )
            Token::Identifier -> named_root(parser, input, false)
            _ -> unsupported_root(parser, token.start,
                token.end
            )
        }
    }


    state classify_root_keyword(parser: &mut Parser, input: &TokenStream,
        keyword: KeywordKind,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        let head: MachineHead = Parser::root_machine_head(parser.item_start, false);
        transition keyword {
            KeywordKind::Use -> prepare_use(parser, input)
            KeywordKind::Data -> dispatch_data(parser, input, false, false)
            KeywordKind::Machine -> dispatch_machine(parser, input, head)
            KeywordKind::Let -> dispatch_definition(parser, input, false, false)
            KeywordKind::Pub -> public_item_root(parser, input)
            _ -> unsupported_root(parser, start, end)
        }
    }

    state public_item_root(parser: &mut Parser, input: &TokenStream) {
                Parser::advance(parser, input);
        transition parser.cursor < input.token_count {
            true -> public_item_keyword(parser, input)
            _ -> expected_item_after_public_at_end(parser)
        }
    }

    state public_item_keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::load_current(parser, input);
        let token: Token = input.tokens[parser.current_index];
        let head: MachineHead = Parser::root_machine_head(parser.item_start, true);
        transition token {
            Token::Keyword { keyword: KeywordKind::Data } -> dispatch_data(parser, input, true, false)
            Token::Keyword { keyword: KeywordKind::Machine } -> dispatch_machine(parser, input, head)
            Token::Keyword { keyword: KeywordKind::Let } -> dispatch_definition(parser, input, true, false)
            Token::Identifier -> named_root(parser, input, true)
            _ -> expected_item_after_public(parser, token.start,
                token.end
            )
        }
    }

    // A root led by a name: a contextual introducer, a target name before
    // `machine` or `boundary machine`, or a conformance's name.
    state named_root(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let crossing: bool = Parser::at_word(parser, input, "boundary");
        transition crossing {
            true -> boundary_root(parser, input, is_public)
            _ -> trait_word(parser, input, is_public)
        }
    }

    state trait_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let requirements: bool = Parser::at_word(parser, input, "trait");
        transition requirements {
            true -> dispatch_trait(parser, input, is_public, false)
            _ -> domain_word(parser, input, is_public)
        }
    }

    state domain_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let classification: bool = Parser::at_word(parser, input, "domain");
        transition classification {
            true -> dispatch_domain(parser, input, is_public)
            _ -> constant_word(parser, input, is_public)
        }
    }

    state constant_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let constant: bool = Parser::at_word(parser, input, "const");
        transition constant {
            true -> dispatch_constant(parser, input, is_public)
            _ -> proposition_word(parser, input, is_public)
        }
    }

    state proposition_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let proposition: bool = Parser::at_word(parser, input, "proposition");
        transition proposition {
            true -> dispatch_proposition(parser, input, is_public)
            _ -> measure_word(parser, input, is_public)
        }
    }

    // `measure Owner::Name ...` declares a ranking view, parsed as a root
    // machine in the `Measure` container; `pub measure` rejects, as declared
    // measures are package-private (wiki/spec/language/termination.md).
    state measure_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let ranking: bool = Parser::at_word(parser, input, "measure");
        transition ranking {
            true -> dispatch_measure(parser, input, is_public)
            _ -> operator_word(parser, input, is_public)
        }
    }

    state dispatch_measure(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let head: MachineHead = Parser::measure_head(parser.item_start);
        transition is_public {
            true -> reject_here(parser, input, ParseDiagnosticCode::MeasureNotPublic)
            _ -> dispatch_machine(parser, input, head)
        }
    }

    // A token binds to an ordinary `machine + Name(...)` declaration; there
    // is no separate `operator` introducer.
    state operator_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let retired: bool = Parser::at_word(parser, input, "operator");
        transition retired {
            true -> reject_here(parser, input, ParseDiagnosticCode::RetiredOperatorDeclaration)
            _ -> target_machine_word(parser, input, is_public)
        }
    }

    state target_machine_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let scoped: bool = Parser::next_is_keyword(parser, input, KeywordKind::Machine);
        transition scoped {
            true -> target_machine(parser, input, is_public)
            _ -> target_boundary_word(parser, input, is_public)
        }
    }

    state target_boundary_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let scoped: bool = Parser::next_is_word(parser, input, "boundary");
        transition scoped {
            true -> target_boundary(parser, input, is_public)
            _ -> conformance_word(parser, input, is_public)
        }
    }

    state conformance_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let satisfies: bool = Parser::next_is_word(parser, input, "satisfies");
        let generic: bool = Parser::next_is_punctuation(parser, input, PunctuationKind::Less);
        transition satisfies || generic {
            true -> dispatch_conformance(parser, input, is_public)
            _ -> unnamed_root(parser, input, is_public)
        }
    }

    state unnamed_root(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        transition is_public {
            true -> reject_here(parser, input, ParseDiagnosticCode::ExpectedItemAfterPub)
            _ -> reject_here(parser, input, ParseDiagnosticCode::UnsupportedRootItem)
        }
    }

    // `boundary data`, `boundary machine`, `boundary trait` and the
    // assumption `boundary let`. The carrier-owned `boundary requirement` and
    // the `boundary operator` introducer are retired; a boundary operation is
    // a requirement of a boundary trait.
    state boundary_root(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        Parser::take_current(parser, input);
        let opaque: bool = Parser::at_keyword(parser, input, KeywordKind::Data);
        let assumed: bool = Parser::at_keyword(parser, input, KeywordKind::Let);
        transition opaque {
            true -> dispatch_data(parser, input, is_public, true)
            _ -> boundary_let(parser, input, is_public, assumed)
        }
    }

    state boundary_let(parser: &mut Parser, input: &TokenStream, is_public: bool, assumed: bool) {
        transition assumed {
            true -> dispatch_definition(parser, input, is_public, true)
            _ -> boundary_machine_word(parser, input, is_public)
        }
    }

    state boundary_machine_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let crossing: bool = Parser::at_keyword(parser, input, KeywordKind::Machine);
        let root_head: MachineHead = Parser::root_machine_head(parser.item_start, is_public);
        let head: MachineHead = Parser::boundary_machine_head(root_head);
        transition crossing {
            true -> dispatch_machine(parser, input, head)
            _ -> boundary_trait_word(parser, input, is_public)
        }
    }

    state boundary_trait_word(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let requirements: bool = Parser::at_word(parser, input, "trait");
        transition requirements {
            true -> dispatch_trait(parser, input, is_public, true)
            _ -> boundary_requirement_word(parser, input)
        }
    }

    state boundary_requirement_word(parser: &mut Parser, input: &TokenStream) {
        let retired: bool = Parser::at_word(parser, input, "requirement");
        transition retired {
            true -> reject_here(parser, input, ParseDiagnosticCode::RetiredBoundaryRequirement)
            _ -> boundary_operator_word(parser, input)
        }
    }

    state boundary_operator_word(parser: &mut Parser, input: &TokenStream) {
        let retired: bool = Parser::at_word(parser, input, "operator");
        transition retired {
            true -> reject_here(parser, input, ParseDiagnosticCode::RetiredOperatorDeclaration)
            _ -> reject_here(parser, input, ParseDiagnosticCode::ExpectedBoundaryDeclaration)
        }
    }

    // `target machine ...`: the leading name is the family's target.
    state target_machine(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        Parser::take_current(parser, input);
        let root_head: MachineHead = Parser::root_machine_head(parser.item_start, is_public);
        let head: MachineHead = Parser::target_machine_head(root_head, parser.token_start, parser.token_end);
        transition { _ -> dispatch_machine(parser, input, head) }
    }

    state target_boundary(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        Parser::take_current(parser, input);
        let root_head: MachineHead = Parser::root_machine_head(parser.item_start, is_public);
        let target_head: MachineHead = Parser::target_machine_head(root_head, parser.token_start, parser.token_end);
        let head: MachineHead = Parser::boundary_machine_head(target_head);
        Parser::take_current(parser, input);
        let crossing: bool = Parser::at_keyword(parser, input, KeywordKind::Machine);
        transition crossing {
            true -> dispatch_machine(parser, input, head)
            _ -> reject_here(parser, input, ParseDiagnosticCode::ExpectedTargetScopedMachine)
        }
    }

    state dispatch_data(parser: &mut Parser, input: &TokenStream, is_public: bool, is_boundary: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        Parser::parse_data(parser, input, item_start, is_public, is_boundary);
        transition { _ -> declared(parser, input) }
    }

    state dispatch_machine(parser: &mut Parser, input: &TokenStream, head: MachineHead) {
        Parser::parse_machine(parser, input, head);
        transition { _ -> declared(parser, input) }
    }

    state dispatch_trait(parser: &mut Parser, input: &TokenStream, is_public: bool, is_boundary: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        Parser::parse_trait(parser, input, item_start, is_public, is_boundary);
        transition { _ -> declared(parser, input) }
    }

    state dispatch_conformance(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        Parser::parse_conformance(parser, input, item_start, is_public);
        transition { _ -> declared(parser, input) }
    }

    state dispatch_domain(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        Parser::parse_domain(parser, input, item_start, is_public);
        transition { _ -> declared(parser, input) }
    }

    state dispatch_constant(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        Parser::parse_constant(parser, input, item_start, is_public);
        transition { _ -> declared(parser, input) }
    }

    state dispatch_definition(parser: &mut Parser, input: &TokenStream, is_public: bool, is_boundary: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        Parser::parse_definition(parser, input, item_start, is_public, is_boundary);
        transition { _ -> declared(parser, input) }
    }

    state dispatch_proposition(parser: &mut Parser, input: &TokenStream, is_public: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        Parser::parse_proposition(parser, input, item_start, is_public);
        transition { _ -> declared(parser, input) }
    }

    state declared(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.accepted {
            true -> next_root(parser, input)
            _ -> done()
        }
    }

    state reject_here(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state unsupported_root(
        parser: &mut Parser,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::UnsupportedRootItem, parser.source, start, end);
    }

    state prepare_use(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.root_count < 4096 {
            true -> use_capacity(parser, input)
            _ -> root_full(parser, input)
        }
    }

    state root_full(parser: &mut Parser, input: &TokenStream) {
        let token: Token = input.tokens[parser.current_index];
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::RootCapacityExceeded,
            parser.source,
            token.start,
            token.end
        );
    }

    state use_capacity(parser: &mut Parser, input: &TokenStream) {
        transition parser.output.use_count < 1024 {
            true -> use_start(parser, input)
            _ -> use_full(parser, input)
        }
    }

    state use_full(parser: &mut Parser, input: &TokenStream) {
        let token: Token = input.tokens[parser.current_index];
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::UseCapacityExceeded,
            parser.source,
            token.start,
            token.end
        );
    }

    state use_start(parser: &mut Parser, input: &TokenStream) {
        parser.use_first_member = parser.output.member_count as u64 in Trapping;
                Parser::advance(parser, input);
        transition parser.cursor < input.token_count {
            true -> first_member(parser, input)
            _ -> expected_member_at_end(parser)
        }
    }

    state first_member(parser: &mut Parser, input: &TokenStream) {
        Parser::load_current(parser, input);
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Identifier -> retain_member(parser, input,
                token.start,
                token.end
            )
            Token::Keyword { keyword } -> member_keyword(parser, input,
                keyword,
                token.start,
                token.end
            )
            _ -> expected_member(parser, token.start, token.end)
        }
    }


    state member_keyword(parser: &mut Parser, input: &TokenStream,
        keyword: KeywordKind,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        transition keyword {
            KeywordKind::SelfValue -> expected_member(parser, start, end)
            _ -> retain_member(parser, input, start, end)
        }
    }

    state retain_member(
        parser: &mut Parser,
        input: &TokenStream,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        transition parser.output.member_count < 32000 {
            true -> retain_member_bounded(parser, input, start, end)
            _ -> member_full(parser, start, end)
        }
    }

    state retain_member_bounded(
        parser: &mut Parser,
        input: &TokenStream,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        parser.output.members[parser.output.member_count] = Parser::identifier_span(parser, start, end);
        parser.output.member_count = parser.output.member_count + 1;
                Parser::advance(parser, input);
        transition parser.cursor < input.token_count {
            true -> path_tail(parser, input)
            _ -> expected_separator_at_end(parser)
        }
    }

    state path_tail(parser: &mut Parser, input: &TokenStream) {
        Parser::load_current(parser, input);
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Punctuation { punctuation: PunctuationKind::ColonColon } -> separator(parser, input)
            Token::Punctuation { punctuation: PunctuationKind::Semicolon } -> retain_use(parser, input,
                token.end
            )
            _ -> expected_separator(parser, token.start,
                token.end
            )
        }
    }


    state separator(parser: &mut Parser, input: &TokenStream) {
                Parser::advance(parser, input);
        transition parser.cursor < input.token_count {
            true -> next_member(parser, input)
            _ -> expected_member_at_end(parser)
        }
    }

    state next_member(parser: &mut Parser, input: &TokenStream) {
        Parser::load_current(parser, input);
        let token: Token = input.tokens[parser.current_index];
        transition token {
            Token::Identifier -> retain_member(parser, input,
                token.start,
                token.end
            )
            Token::Keyword { keyword } -> member_keyword(parser, input,
                keyword,
                token.start,
                token.end
            )
            _ -> expected_member(parser, token.start, token.end)
        }
    }


    state retain_use(parser: &mut Parser, input: &TokenStream, item_end: u64 in Trapping) {
        transition parser.output.use_count < 1024 {
            true -> retain_use_bounded(parser, input, item_end)
            _ -> retained_capacity_lost(parser)
        }
    }

    state retain_use_bounded(parser: &mut Parser, input: &TokenStream, item_end: u64 in Trapping) {
        let use_index: u64 in Trapping = parser.output.use_count as u64 in Trapping;
        parser.output.uses[parser.output.use_count] = UseItem {
            first_member: parser.use_first_member,
            member_count: (parser.output.member_count as u64 in Trapping) - parser.use_first_member,
            source_span: Parser::source_span(parser, parser.item_start, item_end)
        };
        parser.output.use_count = parser.output.use_count + 1;
        transition { _ -> retain_root(parser, input, item_end, use_index) }
    }

    state retain_root(
        parser: &mut Parser,
        input: &TokenStream,
        item_end: u64 in Trapping,
        use_index: u64 in Trapping
    ) {
        transition parser.output.root_count < 4096 {
            true -> retain_root_bounded(parser, input, item_end, use_index)
            _ -> retained_capacity_lost(parser)
        }
    }

    state retain_root_bounded(
        parser: &mut Parser,
        input: &TokenStream,
        item_end: u64 in Trapping,
        use_index: u64 in Trapping
    ) {
        parser.output.roots[parser.output.root_count] = RootItem {
            kind: RootItemKind::Use,
            item_index: use_index,
            source_span: Parser::source_span(parser, parser.item_start, item_end)
        };
        parser.output.root_count = parser.output.root_count + 1;
        parser.cursor = parser.cursor + 1;
        transition { _ -> next_root(parser, input) }
    }

    state expected_item_after_public_at_end(parser: &mut Parser) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::ExpectedItemAfterPub, parser.source, parser.source_length, parser.source_length);
    }

    state expected_item_after_public(parser: &mut Parser, start: u64 in Trapping, end: u64 in Trapping) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::ExpectedItemAfterPub, parser.source, start, end);
    }

    state retained_capacity_lost(parser: &mut Parser) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::RootCapacityExceeded, parser.source, parser.item_start, parser.item_start);
    }

    state expected_member_at_end(parser: &mut Parser) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::ExpectedPathMember, parser.source, parser.source_length, parser.source_length);
    }

    state expected_member(parser: &mut Parser, start: u64 in Trapping, end: u64 in Trapping) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::ExpectedPathMember, parser.source, start, end);
    }

    state expected_separator_at_end(parser: &mut Parser) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon, parser.source, parser.source_length, parser.source_length);
    }

    state expected_separator(parser: &mut Parser, start: u64 in Trapping, end: u64 in Trapping) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon, parser.source, start, end);
    }

    state member_full(parser: &mut Parser, start: u64 in Trapping, end: u64 in Trapping) {
        SyntaxTrees::reject(&mut parser.output, ParseDiagnosticCode::PathMemberCapacityExceeded, parser.source, start, end);
    }

    state done() { }
}

// The head of a root `[pub] machine` declaration starting at `start`; the
// constructors below add a target name or `boundary`.
machine Parser::root_machine_head(start: u64 in Trapping, is_public: bool) -> MachineHead {
    MachineHead {
        start: start,
        is_public: is_public,
        has_target: false,
        target_start: 0,
        target_end: 0,
        is_boundary: false,
        container: MachineContainer::Root
    }
}

machine Parser::measure_head(start: u64 in Trapping) -> MachineHead {
    MachineHead {
        start: start,
        is_public: false,
        has_target: false,
        target_start: 0,
        target_end: 0,
        is_boundary: false,
        container: MachineContainer::Measure
    }
}

machine Parser::target_machine_head(head: MachineHead, start: u64 in Trapping, end: u64 in Trapping) -> MachineHead {
    MachineHead {
        start: head.start,
        is_public: head.is_public,
        has_target: true,
        target_start: start,
        target_end: end,
        is_boundary: head.is_boundary,
        container: head.container
    }
}

machine Parser::boundary_machine_head(head: MachineHead) -> MachineHead {
    MachineHead {
        start: head.start,
        is_public: head.is_public,
        has_target: head.has_target,
        target_start: head.target_start,
        target_end: head.target_end,
        is_boundary: true,
        container: head.container
    }
}
