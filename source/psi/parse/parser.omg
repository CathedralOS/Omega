use psi::parse::data;
use psi::parse::input;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

// One parser owns one output arena and parse-local scratch. The lexer keeps
// its TokenStream; `parse` observes it through one shared borrow forwarded
// along every state edge that reads a token, so no token or stream is copied
// and nothing is moved out of the owning lexer.
pub data Parser {
    output: SyntaxTrees;
    source: SourceId;
    source_length: u64 in Trapping;
    cursor: u64 in Trapping;
    current_index: u64 [0..=16383];
    current_present: bool;
    item_start: u64 in Trapping;
    use_first_member: u64 in Trapping;
    data_item_start: u64 in Trapping;
    data_first_member: u64 in Trapping;
    data_first_field: u64 in Trapping;
    data_first_case: u64 in Trapping;
    data_name_start: u64 in Trapping;
    data_name_end: u64 in Trapping;
    data_is_public: bool;
    data_multiplicity: DataMultiplicity;
    field_start: u64 in Trapping;
    field_name_start: u64 in Trapping;
    field_name_end: u64 in Trapping;
    type_name_start: u64 in Trapping;
    type_name_end: u64 in Trapping;
    type_qualified: bool;
    type_qualifier_payload: bool;
    type_domain_start: u64 in Trapping;
    type_domain_end: u64 in Trapping;
    case_start: u64 in Trapping;
    case_keyword_end: u64 in Trapping;
    case_name_start: u64 in Trapping;
    case_name_end: u64 in Trapping;
    case_first_payload_field: u64 in Trapping;
    payload_field_start: u64 in Trapping;
    payload_field_name_start: u64 in Trapping;
    payload_field_name_end: u64 in Trapping;
    payload_type_name_start: u64 in Trapping;
    payload_type_name_end: u64 in Trapping;
}

pub machine Parser::initialize(
    &mut self,
    source: SourceId,
    source_length: u64 in Trapping
) {
    self.output.clear(source);
    self.source = source;
    self.source_length = source_length;
}

// Whole-file sequencing and use-item grammar. Data declarations are delegated
// to data.omg; input.omg remains the only token/cursor behavior owner.
pub machine Parser::parse(&mut self, input: &TokenStream) {
    self.output.clear(self.source);
    self.initialize_cursor();
    transition { _ -> next_root(input) }

    state next_root(&mut self, input: &TokenStream) {
        self.skip_trivia(input);
        transition self.cursor < input.token_count {
            true -> classify_root(input)
            _ -> done()
        }
    }

    state classify_root(&mut self, input: &TokenStream) {
        self.load_current(input);
        transition { _ -> classify_root_loaded(input) }
    }

    state classify_root_loaded(&mut self, input: &TokenStream) {
        let token: Token = input.tokens[self.current_index];
        self.item_start = token.start;
        transition token {
            Token::Keyword { keyword } -> classify_root_keyword(
                input,
                keyword,
                token.start,
                token.end
            )
            _ -> unsupported_root(
                token.start,
                token.end
            )
        }
    }

    state classify_root_keyword(
        &mut self,
        input: &TokenStream,
        keyword: KeywordKind,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        transition keyword {
            KeywordKind::Use -> prepare_use(input)
            KeywordKind::Data -> dispatch_data(input, false)
            KeywordKind::Pub -> public_data_root(input)
            _ -> unsupported_root(start, end)
        }
    }

    state public_data_root(&mut self, input: &TokenStream) {
        self.cursor = self.cursor + 1;
        self.skip_trivia(input);
        transition self.cursor < input.token_count {
            true -> public_data_keyword(input)
            _ -> expected_data_after_public_at_end()
        }
    }

    state public_data_keyword(&mut self, input: &TokenStream) {
        self.load_current(input);
        transition { _ -> public_data_keyword_loaded(input) }
    }

    state public_data_keyword_loaded(&mut self, input: &TokenStream) {
        let token: Token = input.tokens[self.current_index];
        transition token {
            Token::Keyword { keyword: KeywordKind::Data } -> dispatch_data(input, true)
            _ -> expected_data_after_public(
                token.start,
                token.end
            )
        }
    }

    state dispatch_data(&mut self, input: &TokenStream, is_public: bool) {
        self.parse_data(input, self.item_start, is_public);
        transition self.output.accepted {
            true -> next_root(input)
            _ -> done()
        }
    }

    state unsupported_root(
        &mut self,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        self.output.reject(ParseDiagnosticCode::UnsupportedRootItem, self.source, start, end);
    }

    state prepare_use(&mut self, input: &TokenStream) {
        transition self.output.root_count < 256 {
            true -> use_capacity(input)
            _ -> root_full(input)
        }
    }

    state root_full(&mut self, input: &TokenStream) {
        let token: Token = input.tokens[self.current_index];
        self.output.reject(
            ParseDiagnosticCode::RootCapacityExceeded,
            self.source,
            token.start,
            token.end
        );
    }

    state use_capacity(&mut self, input: &TokenStream) {
        transition self.output.use_count < 256 {
            true -> use_start(input)
            _ -> use_full(input)
        }
    }

    state use_full(&mut self, input: &TokenStream) {
        let token: Token = input.tokens[self.current_index];
        self.output.reject(
            ParseDiagnosticCode::UseCapacityExceeded,
            self.source,
            token.start,
            token.end
        );
    }

    state use_start(&mut self, input: &TokenStream) {
        self.use_first_member = self.output.member_count;
        self.cursor = self.cursor + 1;
        self.skip_trivia(input);
        transition self.cursor < input.token_count {
            true -> first_member(input)
            _ -> expected_member_at_end()
        }
    }

    state first_member(&mut self, input: &TokenStream) {
        self.load_current(input);
        transition { _ -> first_member_loaded(input) }
    }

    state first_member_loaded(&mut self, input: &TokenStream) {
        let token: Token = input.tokens[self.current_index];
        transition token {
            Token::Identifier -> retain_member(
                input,
                token.start,
                token.end
            )
            Token::Keyword { keyword } -> first_member_keyword(
                input,
                keyword,
                token.start,
                token.end
            )
            _ -> expected_member(token.start, token.end)
        }
    }

    state first_member_keyword(
        &mut self,
        input: &TokenStream,
        keyword: KeywordKind,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        transition keyword {
            KeywordKind::SelfType -> expected_member(start, end)
            KeywordKind::SelfValue -> expected_member(start, end)
            _ -> retain_member(input, start, end)
        }
    }

    state retain_member(
        &mut self,
        input: &TokenStream,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        transition self.output.member_count < 1024 {
            true -> retain_member_bounded(input, start, end)
            _ -> member_full(start, end)
        }
    }

    state retain_member_bounded(
        &mut self,
        input: &TokenStream,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        self.output.members[self.output.member_count] = IdentifierSpan {
            source_span: SourceSpan {
                source: self.source,
                span: Span { start: start, end: end }
            }
        };
        self.output.member_count = self.output.member_count + 1;
        self.cursor = self.cursor + 1;
        self.skip_trivia(input);
        transition self.cursor < input.token_count {
            true -> path_tail(input)
            _ -> expected_separator_at_end()
        }
    }

    state path_tail(&mut self, input: &TokenStream) {
        self.load_current(input);
        transition { _ -> path_tail_loaded(input) }
    }

    state path_tail_loaded(&mut self, input: &TokenStream) {
        let token: Token = input.tokens[self.current_index];
        transition token {
            Token::Punctuation { punctuation: PunctuationKind::ColonColon } -> separator(input)
            Token::Punctuation { punctuation: PunctuationKind::Semicolon } -> retain_use(
                input,
                token.end
            )
            _ -> expected_separator(
                token.start,
                token.end
            )
        }
    }

    state separator(&mut self, input: &TokenStream) {
        self.cursor = self.cursor + 1;
        self.skip_trivia(input);
        transition self.cursor < input.token_count {
            true -> next_member(input)
            _ -> expected_member_at_end()
        }
    }

    state next_member(&mut self, input: &TokenStream) {
        self.load_current(input);
        transition { _ -> next_member_loaded(input) }
    }

    state next_member_loaded(&mut self, input: &TokenStream) {
        let token: Token = input.tokens[self.current_index];
        transition token {
            Token::Identifier -> retain_member(
                input,
                token.start,
                token.end
            )
            Token::Keyword { keyword } -> next_member_keyword(
                input,
                keyword,
                token.start,
                token.end
            )
            _ -> expected_member(token.start, token.end)
        }
    }

    state next_member_keyword(
        &mut self,
        input: &TokenStream,
        keyword: KeywordKind,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        transition keyword {
            KeywordKind::SelfType -> expected_member(start, end)
            KeywordKind::SelfValue -> expected_member(start, end)
            _ -> retain_member(input, start, end)
        }
    }

    state retain_use(&mut self, input: &TokenStream, item_end: u64 in Trapping) {
        transition self.output.use_count < 256 {
            true -> retain_use_bounded(input, item_end)
            _ -> retained_capacity_lost()
        }
    }

    state retain_use_bounded(&mut self, input: &TokenStream, item_end: u64 in Trapping) {
        let use_index: u64 in Trapping = self.output.use_count;
        self.output.uses[self.output.use_count] = UseItem {
            first_member: self.use_first_member,
            member_count: self.output.member_count - self.use_first_member,
            source_span: SourceSpan {
                source: self.source,
                span: Span { start: self.item_start, end: item_end }
            }
        };
        self.output.use_count = self.output.use_count + 1;
        transition { _ -> retain_root(input, item_end, use_index) }
    }

    state retain_root(
        &mut self,
        input: &TokenStream,
        item_end: u64 in Trapping,
        use_index: u64 in Trapping
    ) {
        transition self.output.root_count < 256 {
            true -> retain_root_bounded(input, item_end, use_index)
            _ -> retained_capacity_lost()
        }
    }

    state retain_root_bounded(
        &mut self,
        input: &TokenStream,
        item_end: u64 in Trapping,
        use_index: u64 in Trapping
    ) {
        self.output.roots[self.output.root_count] = RootItem {
            kind: RootItemKind::Use,
            item_index: use_index,
            source_span: SourceSpan {
                source: self.source,
                span: Span { start: self.item_start, end: item_end }
            }
        };
        self.output.root_count = self.output.root_count + 1;
        self.cursor = self.cursor + 1;
        transition { _ -> next_root(input) }
    }

    state expected_data_after_public_at_end(&mut self) {
        self.output.reject(ParseDiagnosticCode::ExpectedDataAfterPub, self.source, self.source_length, self.source_length);
    }

    state expected_data_after_public(&mut self, start: u64 in Trapping, end: u64 in Trapping) {
        self.output.reject(ParseDiagnosticCode::ExpectedDataAfterPub, self.source, start, end);
    }

    state retained_capacity_lost(&mut self) {
        self.output.reject(ParseDiagnosticCode::RootCapacityExceeded, self.source, self.item_start, self.item_start);
    }

    state expected_member_at_end(&mut self) {
        self.output.reject(ParseDiagnosticCode::ExpectedPathMember, self.source, self.source_length, self.source_length);
    }

    state expected_member(&mut self, start: u64 in Trapping, end: u64 in Trapping) {
        self.output.reject(ParseDiagnosticCode::ExpectedPathMember, self.source, start, end);
    }

    state expected_separator_at_end(&mut self) {
        self.output.reject(ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon, self.source, self.source_length, self.source_length);
    }

    state expected_separator(&mut self, start: u64 in Trapping, end: u64 in Trapping) {
        self.output.reject(ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon, self.source, start, end);
    }

    state member_full(&mut self, start: u64 in Trapping, end: u64 in Trapping) {
        self.output.reject(ParseDiagnosticCode::PathMemberCapacityExceeded, self.source, start, end);
    }

    state done(&mut self) { }
}
