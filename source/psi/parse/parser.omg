use psi::parse::input;
use psi::parse::owner;
use psi::parse::root;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

pub machine Parser::initialize(
    &mut self,
    source: SourceId,
    source_length: u64 in Trapping,
    input: TokenStream
) {
    self.output.clear(source);
    self.input = input;
    self.source = source;
    self.source_length = source_length;
}

pub machine Parser::parse(&mut self) {
    self.parse_roots();
}
