use psi::parse::expression;
use psi::parse::generics;
use psi::parse::input;
use psi::parse::machine;
use psi::parse::parser;
use psi::parse::types;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

// `[public] proposition Name [<generic parameters>] [(parameters)] body`,
// entered at the `proposition` word. The body is `;` for a primitive
// proposition, `evidence Type;` for a witness-bearing one, or `= fact;` for
// a transparent one. The generic parameters and parameters share the data
// and machine grammars; lifetime binders are a checking question.
public machine Parser::parse_proposition(
    parser: &mut Parser,
    input: &TokenStream,
    item_start: u64 in Trapping,
    is_public: bool
)
crashes Trap
{
    parser.declaration_start = item_start;
    parser.declaration_is_public = is_public;
    transition parser.output.proposition_count < 256 {
        true -> keyword(parser, input)
        _ -> reject(parser, input, ParseDiagnosticCode::PropositionCapacityExceeded)
    }

    machine keyword(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.declaration_first_generic = parser.output.generic_parameter_count as u64 in Trapping;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedPropositionName);
        transition parser.output.accepted {
            true -> named(parser, input)
            _ -> done()
        }
    }

    machine named(parser: &mut Parser, input: &TokenStream) {
        parser.declaration_name_start = parser.name_start;
        parser.declaration_name_end = parser.name_end;
        let generic: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        transition generic {
            true -> generics(parser, input)
            _ -> parameters(parser, input)
        }
    }

    machine generics(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_generic_parameters(parser, input);
        transition parser.output.accepted {
            true -> parameters(parser, input)
            _ -> done()
        }
    }

    machine parameters(parser: &mut Parser, input: &TokenStream) {
        Parser::parse_parameters(parser, input);
        parser.declaration_first_parameter = parser.signature_first_parameter;
        parser.declaration_parameter_count = parser.signature_parameter_count;
        transition parser.output.accepted {
            true -> declared_body(parser, input)
            _ -> done()
        }
    }

    machine declared_body(parser: &mut Parser, input: &TokenStream) {
        let ends: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition ends {
            true -> primitive_body(parser, input)
            _ -> evidence_word(parser, input)
        }
    }

    machine evidence_word(parser: &mut Parser, input: &TokenStream) {
        let witnessed: bool = Parser::at_word(parser, input, "evidence");
        transition witnessed {
            true -> evidence_body(parser, input)
            _ -> transparent_word(parser, input)
        }
    }

    machine transparent_word(parser: &mut Parser, input: &TokenStream) {
        let transparent: bool = Parser::at_punctuation(parser, input, PunctuationKind::Equal);
        transition transparent {
            true -> fact_body(parser, input)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedPropositionBody)
        }
    }

    machine primitive_body(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> retain_capacity(parser, input, PropositionBody::Primitive, 0, 0) }
    }

    machine evidence_body(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::parse_type_reference(parser, input, ParseDiagnosticCode::ExpectedPropositionEvidence);
        transition parser.output.accepted {
            true -> end(parser, input, PropositionBody::Evidence, parser.type_result, 0)
            _ -> done()
        }
    }

    machine fact_body(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedPropositionFact, false, true);
        transition parser.output.accepted {
            true -> end(parser, input, PropositionBody::Transparent, 0, parser.expression_result)
            _ -> done()
        }
    }

    machine end(
        parser: &mut Parser,
        input: &TokenStream,
        body: PropositionBody,
        evidence: u64 in Trapping,
        fact: u64 in Trapping
    ) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedPropositionEnd);
        transition parser.output.accepted {
            true -> retain_capacity(parser, input, body, evidence, fact)
            _ -> done()
        }
    }

    machine retain_capacity(
        parser: &mut Parser,
        input: &TokenStream,
        body: PropositionBody,
        evidence: u64 in Trapping,
        fact: u64 in Trapping
    ) {
        transition parser.output.proposition_count < 256 {
            true -> root_capacity(parser, input, body, evidence, fact)
            _ -> reject(parser, input, ParseDiagnosticCode::PropositionCapacityExceeded)
        }
    }

    machine root_capacity(
        parser: &mut Parser,
        input: &TokenStream,
        body: PropositionBody,
        evidence: u64 in Trapping,
        fact: u64 in Trapping
    ) {
        transition parser.output.root_count < 4096 {
            true -> retain(parser, body, evidence, fact)
            _ -> reject(parser, input, ParseDiagnosticCode::RootCapacityExceeded)
        }
    }

    machine retain(parser: &mut Parser, body: PropositionBody, evidence: u64 in Trapping, fact: u64 in Trapping) {
        let proposition: u64 in Trapping = parser.output.proposition_count as u64 in Trapping;
        let span: SourceSpan = Parser::source_span(parser, parser.declaration_start, parser.token_end);
        parser.output.propositions[parser.output.proposition_count] = PropositionItem {
            name: Parser::identifier_span(parser, parser.declaration_name_start, parser.declaration_name_end),
            first_generic_parameter: parser.declaration_first_generic,
            generic_parameter_count: (parser.output.generic_parameter_count as u64 in Trapping) - parser.declaration_first_generic,
            first_parameter: parser.declaration_first_parameter,
            parameter_count: parser.declaration_parameter_count,
            body: body,
            evidence: evidence,
            fact: fact,
            is_public: parser.declaration_is_public,
            source_span: span
        };
        parser.output.proposition_count = parser.output.proposition_count + 1;
        parser.output.roots[parser.output.root_count] = RootItem {
            kind: RootItemKind::Proposition,
            item_index: proposition,
            source_span: span
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    machine reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    machine done() {}
}
