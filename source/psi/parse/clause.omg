use psi::parse::expression;
use psi::parse::input;
use psi::parse::parser;
use psi::parse::types;
use psi::source::source;
use psi::syntax::syntax;
use psi::tokens::tokens;

// The clauses between a declaration's head and its body, in any order:
// `reaches Service [, Service | + Service]*`, `invokes Binding;`,
// `suspends;`, `blocks;`, `crashes Trap` or `crashes Abort`,
// `requires fact [(, | ;) fact]*`, `ensures fact [(, | ;) fact]*`,
// `where fact [, fact]* [,]`, `satisfies Trait[<arguments>]::requirement
// [as Label] [via value] [, ...]` and `terminates [by subjects [-> View]];`,
// whose subjects are one expression or a parenthesized list. Every clause
// word is contextual, and the clauses end at the first token that opens
// none, which the owner's grammar then reads. A `;` that ends an operational
// clause, a contract fact or a satisfaction is the clause's only while the
// declaration continues after it: with its body `{`, another clause, or,
// after a fact, another fact. Otherwise it ends the declaration itself, a
// bodyless one, and stays for the owner (`Parser::after_clause_semicolon`).
// One grammar serves every owner; which clauses an owner admits is
// `Parser::clause_admitted`, and an inadmissible clause rejects at its word.
// The range lands in `clause_first` and the table count.
pub machine Parser::parse_clauses(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner)
crashes Trap
{
    parser.clause_first = parser.output.clause_count as u64 in Trapping;
    transition { _ -> next(parser, input, owner) }

    state next(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let reaches: bool = Parser::at_word(parser, input, "reaches");
        transition reaches {
            true -> admit(parser, input, owner, ClauseKind::Reaches)
            _ -> invokes_word(parser, input, owner)
        }
    }

    state invokes_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let invokes: bool = Parser::at_word(parser, input, "invokes");
        transition invokes {
            true -> admit(parser, input, owner, ClauseKind::Invokes)
            _ -> suspends_word(parser, input, owner)
        }
    }

    state suspends_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let suspends: bool = Parser::at_word(parser, input, "suspends");
        transition suspends {
            true -> admit(parser, input, owner, ClauseKind::Suspends)
            _ -> blocks_word(parser, input, owner)
        }
    }

    state blocks_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let blocks: bool = Parser::at_word(parser, input, "blocks");
        transition blocks {
            true -> admit(parser, input, owner, ClauseKind::Blocks)
            _ -> crashes_word(parser, input, owner)
        }
    }

    state crashes_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let crashes: bool = Parser::at_word(parser, input, "crashes");
        transition crashes {
            true -> admit(parser, input, owner, ClauseKind::Crashes)
            _ -> requires_word(parser, input, owner)
        }
    }

    state requires_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let requires: bool = Parser::at_word(parser, input, "requires");
        transition requires {
            true -> admit(parser, input, owner, ClauseKind::Requires)
            _ -> ensures_word(parser, input, owner)
        }
    }

    state ensures_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let ensures: bool = Parser::at_word(parser, input, "ensures");
        transition ensures {
            true -> admit(parser, input, owner, ClauseKind::Ensures)
            _ -> satisfies_word(parser, input, owner)
        }
    }

    state satisfies_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let satisfies: bool = Parser::at_word(parser, input, "satisfies");
        transition satisfies {
            true -> admit(parser, input, owner, ClauseKind::Satisfies)
            _ -> terminates_word(parser, input, owner)
        }
    }

    state terminates_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let terminates: bool = Parser::at_word(parser, input, "terminates");
        transition terminates {
            true -> admit(parser, input, owner, ClauseKind::Terminates)
            _ -> where_word(parser, input, owner)
        }
    }

    // A contract's clauses also end at the next `where machine` contract,
    // which its owner reads.
    state where_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let facts: bool = Parser::at_word(parser, input, "where");
        let contract: bool = Parser::next_is_keyword(parser, input, KeywordKind::Machine);
        transition facts && !(contract && owner == ClauseOwner::Contract) {
            true -> admit(parser, input, owner, ClauseKind::Where)
            _ -> done()
        }
    }

    state admit(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        let admitted: bool = Parser::clause_admitted(owner, kind);
        transition admitted {
            true -> clause(parser, input, owner, kind)
            _ -> reject(parser, input, ParseDiagnosticCode::ClauseNotAdmitted)
        }
    }

    state clause(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        Parser::take_current(parser, input);
        parser.clause_start = parser.token_start;
        parser.clause_first_member = parser.output.member_count as u64 in Trapping;
        transition kind {
            ClauseKind::Reaches -> reached(parser, input, owner)
            ClauseKind::Invokes -> invokes_binding(parser, input, owner)
            ClauseKind::Suspends -> operational_axis(parser, input, owner, kind)
            ClauseKind::Blocks -> operational_axis(parser, input, owner, kind)
            ClauseKind::Crashes -> crashes_cause(parser, input, owner)
            ClauseKind::Requires -> fact(parser, input, owner, kind)
            ClauseKind::Ensures -> fact(parser, input, owner, kind)
            ClauseKind::Where -> fact(parser, input, owner, kind)
            ClauseKind::Satisfies -> satisfied_trait(parser, input, owner)
            ClauseKind::Terminates -> termination(parser, input, owner)
        }
    }

    // `Trait[<arguments>]::requirement`: the trait's path, its static
    // arguments after its last member, then the one requirement. A bare
    // trait names no requirement: whole-trait satisfaction belongs to a named
    // conformance.
    state satisfied_trait(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        parser.clause_first_argument = parser.output.type_argument_count as u64 in Trapping;
        parser.clause_argument_count = 0;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedSatisfiesTrait);
        transition parser.output.accepted {
            true -> satisfied_member(parser, input, owner)
            _ -> done()
        }
    }

    state satisfied_member(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let start: u64 in Trapping = parser.name_start;
        let end: u64 in Trapping = parser.name_end;
        Parser::append_member(parser, input, start, end);
        transition parser.output.accepted {
            true -> satisfied_separator(parser, input, owner)
            _ -> done()
        }
    }

    state satisfied_separator(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let applied: bool = Parser::at_punctuation(parser, input, PunctuationKind::Less);
        let qualified: bool = Parser::at_punctuation(parser, input, PunctuationKind::ColonColon);
        transition applied {
            true -> satisfied_arguments(parser, input, owner)
            _ -> satisfied_path(parser, input, owner, qualified)
        }
    }

    state satisfied_path(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, qualified: bool) {
        let members: u64 in Trapping = (parser.output.member_count as u64 in Trapping) - parser.clause_first_member;
        transition qualified {
            true -> satisfied_next(parser, input, owner)
            _ -> satisfied_complete(parser, input, owner, members >= 2)
        }
    }

    state satisfied_next(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedPathMember);
        transition parser.output.accepted {
            true -> satisfied_member(parser, input, owner)
            _ -> done()
        }
    }

    state satisfied_complete(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, named: bool) {
        transition named {
            true -> satisfied_requirement(parser, input, owner, parser.name_end)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedSatisfiedRequirement)
        }
    }

    state satisfied_arguments(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::parse_static_arguments(parser, input);
        parser.clause_first_argument = parser.committed_type_first;
        parser.clause_argument_count = parser.committed_type_count;
        transition parser.output.accepted {
            true -> requirement_separator(parser, input, owner)
            _ -> done()
        }
    }

    state requirement_separator(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::expect_punctuation(parser, input, PunctuationKind::ColonColon,
            ParseDiagnosticCode::ExpectedSatisfiedRequirement);
        transition parser.output.accepted {
            true -> requirement_name(parser, input, owner)
            _ -> done()
        }
    }

    state requirement_name(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedSatisfiedRequirement);
        transition parser.output.accepted {
            true -> requirement_member(parser, input, owner)
            _ -> done()
        }
    }

    state requirement_member(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let start: u64 in Trapping = parser.name_start;
        let end: u64 in Trapping = parser.name_end;
        Parser::append_member(parser, input, start, end);
        transition parser.output.accepted {
            true -> satisfied_requirement(parser, input, owner, end)
            _ -> done()
        }
    }

    // A contract's requirement is the binder's whole contract: it takes no
    // label and no binding payload, and its `;` is the contract's.
    state satisfied_requirement(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, end: u64 in Trapping) {
        let labelled: bool = Parser::at_keyword(parser, input, KeywordKind::As);
        transition owner == ClauseOwner::Contract {
            true -> satisfaction(parser, input, owner, Parser::satisfies_clause(parser, end))
            _ -> satisfied_label(parser, input, owner, end, labelled)
        }
    }

    state satisfied_label(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, end: u64 in Trapping, labelled: bool) {
        transition labelled {
            true -> label(parser, input, owner)
            _ -> via_word(parser, input, owner, Parser::satisfies_clause(parser, end))
        }
    }

    state label(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::take_current(parser, input);
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedSatisfiesLabel);
        transition parser.output.accepted {
            true -> labelled(parser, input, owner)
            _ -> done()
        }
    }

    state labelled(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let unlabelled: Clause = Parser::satisfies_clause(parser, parser.name_end);
        let label: IdentifierSpan = Parser::identifier_span(parser, parser.name_start, parser.name_end);
        transition { _ -> via_word(parser, input, owner, Parser::with_clause_label(unlabelled, label)) }
    }

    // `via value` supplies a bodyless leaf's binding payload, so a braced
    // value there is a construction, not a body.
    state via_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        let bound: bool = Parser::at_word(parser, input, "via");
        transition bound {
            true -> via(parser, input, owner, clause)
            _ -> satisfaction(parser, input, owner, clause)
        }
    }

    state via(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        Parser::take_current(parser, input);
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedSatisfiesBinding, true, true);
        transition parser.output.accepted {
            true -> via_bound(parser, input, owner, clause, parser.expression_result)
            _ -> done()
        }
    }

    state via_bound(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause, value: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(&parser.output, value);
        transition { _ -> satisfaction(parser, input, owner,
            Parser::with_clause_expression(parser, clause, value, expression.source_span.span.end)) }
    }

    state satisfaction(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        transition { _ -> store(parser, input, owner, clause) }
    }

    // `terminates;` promises termination; `by` adds the ranking witness,
    // which a refinement, narrowing only the promise, never carries.
    state termination(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        parser.clause_first_argument = parser.output.argument_count as u64 in Trapping;
        parser.clause_argument_count = 0;
        parser.ranked_subject_count = 0;
        let ranked: bool = Parser::at_word(parser, input, "by");
        transition ranked {
            true -> ranked_witness(parser, input, owner)
            _ -> bare_end(parser, input, owner, Parser::termination_clause(parser, false, 0))
        }
    }

    // A bare `terminates` may end at its body's `{`; a ranking witness keeps
    // its `;`, since a `{` after a subject would continue the subject.
    state bare_end(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        let body: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBrace);
        transition body {
            true -> store(parser, input, owner, clause)
            _ -> termination_end(parser, input, owner, clause)
        }
    }

    state ranked_witness(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        transition owner == ClauseOwner::Refinement {
            true -> reject(parser, input, ParseDiagnosticCode::ClauseNotAdmitted)
            _ -> ranked_subjects(parser, input, owner)
        }
    }

    state ranked_subjects(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::take_current(parser, input);
        let listed: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftParen);
        transition listed {
            true -> subject_list(parser, input, owner)
            _ -> subject(parser, input, owner)
        }
    }

    // One subject; its `in` would begin a rank range, never a membership.
    state subject(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedTerminationSubject, false, false);
        transition parser.output.accepted {
            true -> subject_retained(parser, input, owner, parser.expression_result)
            _ -> done()
        }
    }

    state subject_retained(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, subject: u64 in Trapping) {
        Parser::stage_subject(parser, input, subject);
        transition parser.output.accepted {
            true -> subjects_committed(parser, input, owner)
            _ -> done()
        }
    }

    // `(subject {, subject})`: the subjects stage until `)`, since each may
    // commit call arguments of its own.
    state subject_list(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::take_current(parser, input);
        transition { _ -> listed_subject(parser, input, owner) }
    }

    state listed_subject(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedTerminationSubject, false, false);
        transition parser.output.accepted {
            true -> listed_subject_staged(parser, input, owner, parser.expression_result)
            _ -> done()
        }
    }

    state listed_subject_staged(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, subject: u64 in Trapping) {
        Parser::stage_subject(parser, input, subject);
        let more: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition parser.output.accepted && more {
            true -> subject_list(parser, input, owner)
            _ -> subject_list_end(parser, input, owner)
        }
    }

    state subject_list_end(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        transition parser.output.accepted {
            true -> subject_list_close(parser, input, owner)
            _ -> done()
        }
    }

    state subject_list_close(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::expect_punctuation(parser, input, PunctuationKind::RightParen,
            ParseDiagnosticCode::ExpectedTerminationSubjectEnd);
        transition parser.output.accepted {
            true -> subjects_committed(parser, input, owner)
            _ -> done()
        }
    }

    state subjects_committed(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::commit_subjects(parser, input);
        let viewed: bool = Parser::at_punctuation(parser, input, PunctuationKind::Arrow);
        transition parser.output.accepted && viewed {
            true -> view(parser, input, owner)
            _ -> unviewed(parser, input, owner)
        }
    }

    state unviewed(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        transition parser.output.accepted {
            true -> termination_end(parser, input, owner, Parser::termination_clause(parser, false, 0))
            _ -> done()
        }
    }

    // `-> View` or an argumented view `-> View(arguments)`: a path, or a
    // call of one.
    state view(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::take_current(parser, input);
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedTerminationView, false, false);
        transition parser.output.accepted {
            true -> view_shape(parser, input, owner, parser.expression_result)
            _ -> done()
        }
    }

    state view_shape(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, view: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(&parser.output, view);
        let callee: Expression = SyntaxTrees::expression(&parser.output, expression.left);
        let named: bool = Parser::names_declaration(expression.kind);
        let called: bool = expression.kind == ExpressionKind::Call && Parser::names_declaration(callee.kind);
        transition named || called {
            true -> termination_end(parser, input, owner, Parser::termination_clause(parser, true, view))
            _ -> reject_at(parser, ParseDiagnosticCode::ExpectedTerminationView, expression.source_span)
        }
    }

    // The clause spans through its `;`, which it keeps only while the
    // declaration continues.
    state termination_end(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        let ranged: bool = Parser::at_word(parser, input, "in");
        transition ranged {
            true -> rank_range(parser, input, owner, clause)
            _ -> termination_close(parser, input, owner, clause)
        }
    }

    // `in lower..upper` or `in lower..=upper` after the subjects and view:
    // the rank range (wiki/spec/language/termination.md#ranking), kept on
    // the clause as a range expression over its two endpoints.
    state rank_range(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        Parser::take_current(parser, input);
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedRankRange, false, false);
        transition parser.output.accepted {
            true -> rank_range_dots(parser, input, owner, clause, parser.expression_result)
            _ -> done()
        }
    }

    state rank_range_dots(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause, lower: u64 in Trapping) {
        let open: bool = Parser::at_punctuation(parser, input, PunctuationKind::DotDot);
        let inclusive: bool = Parser::at_punctuation(parser, input, PunctuationKind::DotDotEqual);
        transition open || inclusive {
            true -> rank_range_upper(parser, input, owner, clause, lower, inclusive)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedRankRange)
        }
    }

    state rank_range_upper(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause, lower: u64 in Trapping, inclusive: bool) {
        Parser::take_current(parser, input);
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedRankRange, false, false);
        transition parser.output.accepted {
            true -> rank_range_node(parser, input, owner, clause, lower, inclusive, parser.expression_result)
            _ -> done()
        }
    }

    state rank_range_node(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause, lower: u64 in Trapping, inclusive: bool, upper: u64 in Trapping) {
        let start: Expression = SyntaxTrees::expression(&parser.output, lower);
        let handle: u64 in Trapping = parser.output.expression_count as u64 in Trapping;
        let name: IdentifierSpan = Parser::identifier_span(parser, 0, 0);
        let span: SourceSpan = Parser::source_span(parser, start.source_span.span.start, parser.token_end);
        let node: Expression = Expression {
            kind: ExpressionKind::Range,
            operator: OperatorKind::None,
            left: lower,
            right: upper,
            first: 1,
            count: 1,
            flag: inclusive,
            name: name,
            type_reference: 0,
            first_row: 0,
            source_span: span
        };
        Parser::emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> termination_close(parser, input, owner, Parser::with_clause_range(clause, handle))
            _ -> done()
        }
    }

    state termination_close(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        let semicolon: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition semicolon {
            true -> termination_semicolon(parser, input, owner, clause)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedClauseEnd)
        }
    }

    state termination_semicolon(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        let token: Token = input.tokens[parser.current_index];
        let continuation: ClauseContinuation = Parser::after_clause_semicolon(parser, input, owner);
        let ended: Clause = Parser::with_clause_end(parser, clause, token.end);
        transition continuation {
            ClauseContinuation::Clause -> termination_taken(parser, input, owner, ended)
            _ -> store(parser, input, owner, ended)
        }
    }

    state termination_taken(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        Parser::take_current(parser, input);
        transition { _ -> store(parser, input, owner, clause) }
    }

    // A refinement may narrow reach to no service at all (`reaches;`).
    state reached(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let empty: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition empty && owner == ClauseOwner::Refinement {
            true -> reaches_end(parser, input, owner)
            _ -> service(parser, input, owner)
        }
    }

    state service(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedReachService);
        transition parser.output.accepted {
            true -> service_member(parser, input, owner)
            _ -> done()
        }
    }

    state service_member(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let start: u64 in Trapping = parser.name_start;
        let end: u64 in Trapping = parser.name_end;
        Parser::append_member(parser, input, start, end);
        transition parser.output.accepted {
            true -> service_separator(parser, input, owner)
            _ -> done()
        }
    }

    state service_separator(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let comma: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        let plus: bool = Parser::at_punctuation(parser, input, PunctuationKind::Plus);
        transition comma || plus {
            true -> service_separator_taken(parser, input, owner)
            _ -> reaches_end(parser, input, owner)
        }
    }

    // A refinement's reach row ends at its own `;`.
    state reaches_end(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        transition owner == ClauseOwner::Refinement {
            true -> operational_end(parser, input, owner, ClauseKind::Reaches)
            _ -> member_clause(parser, input, owner, ClauseKind::Reaches, parser.token_end)
        }
    }

    // A refinement may state an operational axis outright: `suspends false;`.
    state operational_axis(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        let semicolon: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition owner == ClauseOwner::Refinement && !semicolon {
            true -> axis_value(parser, input, owner, kind)
            _ -> operational_end(parser, input, owner, kind)
        }
    }

    state axis_value(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        let affirmed: bool = Parser::at_keyword(parser, input, KeywordKind::True);
        let denied: bool = Parser::at_keyword(parser, input, KeywordKind::False);
        transition affirmed || denied {
            true -> axis_parsed(parser, input, owner, kind)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedRefinementAxis)
        }
    }

    state axis_parsed(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedRefinementAxis, false, false);
        transition parser.output.accepted {
            true -> axis_end(parser, input, owner, kind, parser.expression_result)
            _ -> done()
        }
    }

    state axis_end(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind, value: u64 in Trapping) {
        let semicolon: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition semicolon {
            true -> axis_semicolon(parser, input, owner, kind, value)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedClauseEnd)
        }
    }

    state axis_semicolon(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind, value: u64 in Trapping) {
        Parser::take_current(parser, input);
        let stated: Clause = Parser::clause_row(parser, kind, parser.token_end);
        transition { _ -> store(parser, input, owner,
            Parser::with_clause_expression(parser, stated, value, parser.token_end)) }
    }

    state service_separator_taken(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::take_current(parser, input);
        transition { _ -> service(parser, input, owner) }
    }

    state invokes_binding(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedInvokesBinding);
        transition parser.output.accepted {
            true -> invokes_member(parser, input, owner)
            _ -> done()
        }
    }

    state invokes_member(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let start: u64 in Trapping = parser.name_start;
        let end: u64 in Trapping = parser.name_end;
        Parser::append_member(parser, input, start, end);
        transition parser.output.accepted {
            true -> operational_end(parser, input, owner, ClauseKind::Invokes)
            _ -> done()
        }
    }

    // The clause spans through its `;` whether or not the declaration's end
    // shares it.
    state operational_end(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        let semicolon: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition semicolon {
            true -> operational_semicolon(parser, input, owner, kind)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedClauseEnd)
        }
    }

    state operational_semicolon(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        let token: Token = input.tokens[parser.current_index];
        let continuation: ClauseContinuation = Parser::after_clause_semicolon(parser, input, owner);
        transition continuation {
            ClauseContinuation::Clause -> operational_taken(parser, input, owner, kind)
            _ -> member_clause(parser, input, owner, kind, token.end)
        }
    }

    state operational_taken(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        Parser::take_current(parser, input);
        transition { _ -> member_clause(parser, input, owner, kind, parser.token_end) }
    }

    // Reaches, invokes and the operational clauses keep their members range.
    state member_clause(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind, end: u64 in Trapping) {
        let clause: Clause = Parser::clause_row(parser, kind, end);
        transition { _ -> store(parser, input, owner, clause) }
    }

    state crashes_cause(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let trap: bool = Parser::at_word(parser, input, "Trap");
        transition trap {
            true -> crash_clause(parser, input, owner, CrashCause::Trap)
            _ -> crashes_abort(parser, input, owner)
        }
    }

    state crashes_abort(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let abort: bool = Parser::at_word(parser, input, "Abort");
        transition abort {
            true -> crash_clause(parser, input, owner, CrashCause::Abort)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedCrashCause)
        }
    }

    state crash_clause(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, cause: CrashCause) {
        Parser::take_current(parser, input);
        let clause: Clause = Parser::crash_clause_row(parser, cause);
        transition { _ -> store(parser, input, owner, clause) }
    }

    // A fact ends where its expression does; the body's `{` admits no
    // construction there.
    state fact(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedClauseFact, false, true);
        transition parser.output.accepted {
            true -> fact_retained(parser, input, owner, kind, parser.expression_result)
            _ -> done()
        }
    }

    state fact_retained(
        parser: &mut Parser,
        input: &TokenStream,
        owner: ClauseOwner,
        kind: ClauseKind,
        fact: u64 in Trapping
    ) {
        let expression: Expression = SyntaxTrees::expression(&parser.output, fact);
        let clause: Clause = Parser::fact_clause_row(parser, kind, fact, expression.source_span.span.end);
        transition { _ -> store(parser, input, owner, clause) }
    }

    state store(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        transition parser.output.clause_count < 2048 {
            true -> stored(parser, input, owner, clause)
            _ -> reject(parser, input, ParseDiagnosticCode::ClauseCapacityExceeded)
        }
    }

    state stored(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        parser.output.clauses[parser.output.clause_count] = clause;
        parser.output.clause_count = parser.output.clause_count + 1;
        transition clause.kind {
            ClauseKind::Requires -> fact_separator(parser, input, owner, clause.kind)
            ClauseKind::Ensures -> fact_separator(parser, input, owner, clause.kind)
            ClauseKind::Where -> fact_separator(parser, input, owner, clause.kind)
            ClauseKind::Satisfies -> fact_separator(parser, input, owner, clause.kind)
            _ -> next(parser, input, owner)
        }
    }

    // `requires`, `ensures` and `where` facts continue after `,`, each its
    // own clause row of the same kind; a trailing comma ends them. Contract
    // facts also continue after `;`.
    state fact_separator(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        let comma: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        let semicolon: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition comma {
            true -> fact_continues(parser, input, owner, kind)
            _ -> contract_semicolon(parser, input, owner, kind, semicolon && kind != ClauseKind::Where)
        }
    }

    state contract_semicolon(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind, separated: bool) {
        transition separated {
            true -> semicolon_continuation(parser, input, owner, kind)
            _ -> next(parser, input, owner)
        }
    }

    // After a satisfaction, only another clause or the body continues past
    // its `;`.
    state semicolon_continuation(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        let continuation: ClauseContinuation = Parser::after_clause_semicolon(parser, input, owner);
        transition continuation {
            ClauseContinuation::Clause -> semicolon_taken(parser, input, owner)
            ClauseContinuation::Fact -> semicolon_fact_kind(parser, input, owner, kind)
            ClauseContinuation::End -> next(parser, input, owner)
        }
    }

    state semicolon_fact_kind(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        transition kind {
            ClauseKind::Satisfies -> next(parser, input, owner)
            _ -> semicolon_fact(parser, input, owner, kind)
        }
    }

    state semicolon_taken(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::take_current(parser, input);
        transition { _ -> next(parser, input, owner) }
    }

    state semicolon_fact(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        Parser::take_current(parser, input);
        transition { _ -> next_fact(parser, input, owner, kind) }
    }

    state fact_continues(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        Parser::take_current(parser, input);
        let body: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBrace);
        let end: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition body || end {
            true -> next(parser, input, owner)
            _ -> next_fact(parser, input, owner, kind)
        }
    }

    // A satisfaction list's next entry is another satisfaction.
    state next_fact(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        let token: Token = input.tokens[parser.current_index];
        parser.clause_start = token.start;
        parser.clause_first_member = parser.output.member_count as u64 in Trapping;
        transition kind {
            ClauseKind::Satisfies -> satisfied_trait(parser, input, owner)
            _ -> fact(parser, input, owner, kind)
        }
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state reject_at(parser: &mut Parser, code: ParseDiagnosticCode, source_span: SourceSpan) {
        SyntaxTrees::reject(&mut parser.output, code, source_span.source, source_span.span.start, source_span.span.end);
    }

    state done() {}
}

// What follows a `;` that ends a clause, read without moving the cursor,
// which stays at the `;`.
pub data ClauseContinuation [copy] {
    // The declaration's body `{` or another clause word.
    case Clause;
    // Any other start of an expression: the next fact of a contract list.
    case Fact;
    // The end of the input, a closing `}`, another `;`, or the head of a
    // following declaration (`Parser::at_declaration_head`): the `;` ends
    // the declaration.
    case End;
}

// A contract's `;` always ends its clauses, a refinement clause always keeps
// its own `;`, and a trait member's `;` before `requires` ends the member:
// `requires Parent;` there is the trait's body parent, not the member's
// precondition.
machine Parser::after_clause_semicolon(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) -> ClauseContinuation
crashes Trap
{
    let cursor: u64 in Trapping = parser.cursor;
    parser.cursor = parser.cursor + 1;
    Parser::load_current(parser, input);
    transition owner {
        ClauseOwner::Refinement -> restore(parser, input, cursor, ClauseContinuation::Clause)
        ClauseOwner::Contract -> restore(parser, input, cursor, ClauseContinuation::End)
        _ -> following(parser, input, cursor, owner)
    }

    state following(parser: &mut Parser, input: &TokenStream, cursor: u64 in Trapping, owner: ClauseOwner) {
        transition parser.current_present {
            true -> parent(parser, input, cursor, owner)
            _ -> restore(parser, input, cursor, ClauseContinuation::End)
        }
    }

    state parent(parser: &mut Parser, input: &TokenStream, cursor: u64 in Trapping, owner: ClauseOwner) {
        let composed: bool = Parser::at_word(parser, input, "requires");
        transition composed && owner == ClauseOwner::TraitMember {
            true -> restore(parser, input, cursor, ClauseContinuation::End)
            _ -> body(parser, input, cursor)
        }
    }

    // A body, another clause, or a machine's return type written after its
    // clauses continues the declaration.
    state body(parser: &mut Parser, input: &TokenStream, cursor: u64 in Trapping) {
        let open: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBrace);
        let clause: bool = Parser::at_clause_word(parser, input);
        let returned: bool = Parser::at_punctuation(parser, input, PunctuationKind::Arrow);
        transition open || clause || returned {
            true -> restore(parser, input, cursor, ClauseContinuation::Clause)
            _ -> closing(parser, input, cursor)
        }
    }

    state closing(parser: &mut Parser, input: &TokenStream, cursor: u64 in Trapping) {
        let close: bool = Parser::at_punctuation(parser, input, PunctuationKind::RightBrace);
        let semicolon: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        let head: bool = Parser::at_declaration_head(parser, input);
        transition close || semicolon || head {
            true -> restore(parser, input, cursor, ClauseContinuation::End)
            _ -> restore(parser, input, cursor, ClauseContinuation::Fact)
        }
    }

    state restore(parser: &mut Parser, input: &TokenStream, cursor: u64 in Trapping, continuation: ClauseContinuation) {
        parser.cursor = cursor;
        Parser::load_current(parser, input);
        continuation
    }
}

// Whether the current token is a clause word.
machine Parser::at_clause_word(parser: &mut Parser, input: &TokenStream) -> bool
crashes Trap
{
    let reaches: bool = Parser::at_word(parser, input, "reaches");
    let invokes: bool = Parser::at_word(parser, input, "invokes");
    let suspends: bool = Parser::at_word(parser, input, "suspends");
    let blocks: bool = Parser::at_word(parser, input, "blocks");
    let crashes: bool = Parser::at_word(parser, input, "crashes");
    let requires: bool = Parser::at_word(parser, input, "requires");
    let ensures: bool = Parser::at_word(parser, input, "ensures");
    let facts: bool = Parser::at_word(parser, input, "where");
    let satisfies: bool = Parser::at_word(parser, input, "satisfies");
    let terminates: bool = Parser::at_word(parser, input, "terminates");
    reaches || invokes || suspends || blocks || crashes || requires || ensures || facts || satisfies || terminates
}

// Which clauses each owner admits: a machine, trait member or contract every
// clause but `where`, a refinement member the operational axes it narrows
// (`reaches`, `suspends`, `blocks`, `terminates`), a state its arrival
// `requires` and a domain its predicate `requires`, and a data declaration
// or case only `where`.
machine Parser::clause_admitted(owner: ClauseOwner, kind: ClauseKind) -> bool {
    transition owner {
        ClauseOwner::Machine -> machine_clause(kind)
        ClauseOwner::TraitMember -> machine_clause(kind)
        ClauseOwner::Contract -> machine_clause(kind)
        ClauseOwner::Refinement -> narrowing(kind)
        ClauseOwner::State -> arrival(kind)
        ClauseOwner::Domain -> arrival(kind)
        _ -> declaration(kind)
    }

    state narrowing(kind: ClauseKind) {
        transition kind {
            ClauseKind::Reaches -> admitted()
            ClauseKind::Suspends -> admitted()
            ClauseKind::Blocks -> admitted()
            ClauseKind::Terminates -> admitted()
            _ -> refused()
        }
    }

    state machine_clause(kind: ClauseKind) {
        transition kind {
            ClauseKind::Where -> refused()
            _ -> admitted()
        }
    }

    state arrival(kind: ClauseKind) {
        transition kind {
            ClauseKind::Requires -> admitted()
            _ -> refused()
        }
    }

    state declaration(kind: ClauseKind) {
        transition kind {
            ClauseKind::Where -> admitted()
            _ -> refused()
        }
    }

    state admitted() {
        true
    }

    state refused() {
        false
    }
}

// Append one name to `SyntaxTrees::members`.
machine Parser::append_member(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping, end: u64 in Trapping)
crashes Trap
{
    transition parser.output.member_count < 32000 {
        true -> append(parser, start, end)
        _ -> full(parser, input)
    }

    state append(parser: &mut Parser, start: u64 in Trapping, end: u64 in Trapping) {
        parser.output.members[parser.output.member_count] = Parser::identifier_span(parser, start, end);
        parser.output.member_count = parser.output.member_count + 1;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::PathMemberCapacityExceeded);
    }
}

// Clause rows. Every row starts from `clause_row`, which spans from the
// clause's word to `end` and keeps the members appended since its word; the
// constructors below add what each kind carries.
machine Parser::clause_row(parser: &Parser, kind: ClauseKind, end: u64 in Trapping) -> Clause {
    Clause {
        kind: kind,
        first_member: parser.clause_first_member,
        member_count: (parser.output.member_count as u64 in Trapping) - parser.clause_first_member,
        cause: CrashCause::Trap,
        expression: 0,
        has_expression: false,
        first_argument: 0,
        argument_count: 0,
        has_label: false,
        label: Parser::identifier_span(parser, 0, 0),
        has_range: false,
        range: 0,
        source_span: Parser::source_span(parser, parser.clause_start, end)
    }
}

machine Parser::crash_clause_row(parser: &Parser, cause: CrashCause) -> Clause {
    Clause {
        kind: ClauseKind::Crashes,
        first_member: 0,
        member_count: 0,
        cause: cause,
        expression: 0,
        has_expression: false,
        first_argument: 0,
        argument_count: 0,
        has_label: false,
        label: Parser::identifier_span(parser, 0, 0),
        has_range: false,
        range: 0,
        source_span: Parser::source_span(parser, parser.clause_start, parser.token_end)
    }
}

machine Parser::fact_clause_row(parser: &Parser, kind: ClauseKind, fact: u64 in Trapping, end: u64 in Trapping) -> Clause {
    Clause {
        kind: kind,
        first_member: 0,
        member_count: 0,
        cause: CrashCause::Trap,
        expression: fact,
        has_expression: true,
        first_argument: 0,
        argument_count: 0,
        has_label: false,
        label: Parser::identifier_span(parser, 0, 0),
        has_range: false,
        range: 0,
        source_span: Parser::source_span(parser, parser.clause_start, end)
    }
}

// A satisfaction through `end`: its path members and the trait's static
// arguments.
machine Parser::satisfies_clause(parser: &Parser, end: u64 in Trapping) -> Clause {
    Clause {
        kind: ClauseKind::Satisfies,
        first_member: parser.clause_first_member,
        member_count: (parser.output.member_count as u64 in Trapping) - parser.clause_first_member,
        cause: CrashCause::Trap,
        expression: 0,
        has_expression: false,
        first_argument: parser.clause_first_argument,
        argument_count: parser.clause_argument_count,
        has_label: false,
        label: Parser::identifier_span(parser, 0, 0),
        has_range: false,
        range: 0,
        source_span: Parser::source_span(parser, parser.clause_start, end)
    }
}

// A termination promise: its committed ranked subjects and its view.
machine Parser::termination_clause(parser: &Parser, viewed: bool, view: u64 in Trapping) -> Clause {
    Clause {
        kind: ClauseKind::Terminates,
        first_member: 0,
        member_count: 0,
        cause: CrashCause::Trap,
        expression: view,
        has_expression: viewed,
        first_argument: parser.clause_first_argument,
        argument_count: parser.clause_argument_count,
        has_label: false,
        label: Parser::identifier_span(parser, 0, 0),
        has_range: false,
        range: 0,
        source_span: Parser::source_span(parser, parser.clause_start, parser.clause_start)
    }
}

machine Parser::with_clause_range(clause: Clause, range: u64 in Trapping) -> Clause {
    Clause {
        kind: clause.kind,
        first_member: clause.first_member,
        member_count: clause.member_count,
        cause: clause.cause,
        expression: clause.expression,
        has_expression: clause.has_expression,
        first_argument: clause.first_argument,
        argument_count: clause.argument_count,
        has_label: clause.has_label,
        label: clause.label,
        has_range: true,
        range: range,
        source_span: clause.source_span
    }
}

machine Parser::with_clause_label(clause: Clause, label: IdentifierSpan) -> Clause {
    Clause {
        kind: clause.kind,
        first_member: clause.first_member,
        member_count: clause.member_count,
        cause: clause.cause,
        expression: clause.expression,
        has_expression: clause.has_expression,
        first_argument: clause.first_argument,
        argument_count: clause.argument_count,
        has_label: true,
        label: label,
        has_range: clause.has_range,
        range: clause.range,
        source_span: clause.source_span
    }
}

machine Parser::with_clause_expression(parser: &Parser, clause: Clause, expression: u64 in Trapping, end: u64 in Trapping) -> Clause {
    Clause {
        kind: clause.kind,
        first_member: clause.first_member,
        member_count: clause.member_count,
        cause: clause.cause,
        expression: expression,
        has_expression: true,
        first_argument: clause.first_argument,
        argument_count: clause.argument_count,
        has_label: clause.has_label,
        label: clause.label,
        has_range: clause.has_range,
        range: clause.range,
        source_span: Parser::source_span(parser, clause.source_span.span.start, end)
    }
}

machine Parser::with_clause_end(parser: &Parser, clause: Clause, end: u64 in Trapping) -> Clause {
    Clause {
        kind: clause.kind,
        first_member: clause.first_member,
        member_count: clause.member_count,
        cause: clause.cause,
        expression: clause.expression,
        has_expression: clause.has_expression,
        first_argument: clause.first_argument,
        argument_count: clause.argument_count,
        has_label: clause.has_label,
        label: clause.label,
        has_range: clause.has_range,
        range: clause.range,
        source_span: Parser::source_span(parser, clause.source_span.span.start, end)
    }
}

// Stage one ranked subject until the subject list closes.
machine Parser::stage_subject(parser: &mut Parser, input: &TokenStream, subject: u64 in Trapping)
crashes Trap
{
    transition parser.ranked_subject_count < 8 {
        true -> stage(parser, subject)
        _ -> full(parser, input)
    }

    state stage(parser: &mut Parser, subject: u64 in Trapping) {
        parser.ranked_subjects[parser.ranked_subject_count] = subject as u64 in Trapping;
        parser.ranked_subject_count = parser.ranked_subject_count + 1;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::RankedSubjectCapacityExceeded);
    }
}

// Move the staged subjects into `SyntaxTrees::arguments`; their range lands
// in `clause_first_argument`/`clause_argument_count` and the stage empties.
machine Parser::commit_subjects(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    parser.clause_first_argument = parser.output.argument_count as u64 in Trapping;
    parser.clause_argument_count = parser.ranked_subject_count as u64 in Trapping;
    transition { _ -> next(parser, input, 0) }

    state next(parser: &mut Parser, input: &TokenStream, cursor: u64 in Trapping) {
        transition cursor < parser.ranked_subject_count {
            true -> capacity(parser, input, cursor)
            _ -> close(parser)
        }
    }

    state capacity(parser: &mut Parser, input: &TokenStream, cursor: u64 in Trapping) {
        transition parser.output.argument_count < 65536 {
            true -> copy(parser, input, cursor)
            _ -> full(parser, input)
        }
    }

    state copy(parser: &mut Parser, input: &TokenStream, cursor: u64 in Trapping) {
        parser.output.arguments[parser.output.argument_count] = parser.ranked_subjects[cursor] as u64 in Trapping;
        parser.output.argument_count = parser.output.argument_count + 1;
        transition { _ -> next(parser, input, cursor + 1) }
    }

    state close(parser: &mut Parser) {
        parser.ranked_subject_count = 0;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::ArgumentCapacityExceeded);
    }
}
