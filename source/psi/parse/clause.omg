use psi::parse::expression;
use psi::parse::input;
use psi::parse::parser;
use psi::syntax::syntax;
use psi::tokens::tokens;

// The clauses between a declaration's head and its body, in any order:
// `reaches Service [, Service | + Service]*`, `invokes Binding;`,
// `suspends;`, `blocks;`, `crashes Trap` or `crashes Abort`, `requires fact`,
// `ensures fact`, and `where fact [, fact]* [,]`. Every clause word is
// contextual, and the clauses end at the first token that opens none, which
// the owner's grammar then reads. One grammar serves every owner; which
// clauses an owner admits is `Parser::clause_admitted`, and an inadmissible
// clause rejects at its word. The range lands in `clause_first` and the table
// count.
pub machine Parser::parse_clauses(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner)
crashes Trap
{
    parser.clause_first = parser.output.clause_count as u64 in Trapping;
    transition { _ -> next(parser, input, owner) }

    state next(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let reaches: bool = Parser::at_word(parser, input, "reaches");
        transition reaches {
            true -> admit(parser, input, owner, ClauseKind::Reaches)
            _ -> invokes_word(parser, input, owner)
        }
    }

    state invokes_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let invokes: bool = Parser::at_word(parser, input, "invokes");
        transition invokes {
            true -> admit(parser, input, owner, ClauseKind::Invokes)
            _ -> suspends_word(parser, input, owner)
        }
    }

    state suspends_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let suspends: bool = Parser::at_word(parser, input, "suspends");
        transition suspends {
            true -> admit(parser, input, owner, ClauseKind::Suspends)
            _ -> blocks_word(parser, input, owner)
        }
    }

    state blocks_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let blocks: bool = Parser::at_word(parser, input, "blocks");
        transition blocks {
            true -> admit(parser, input, owner, ClauseKind::Blocks)
            _ -> crashes_word(parser, input, owner)
        }
    }

    state crashes_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let crashes: bool = Parser::at_word(parser, input, "crashes");
        transition crashes {
            true -> admit(parser, input, owner, ClauseKind::Crashes)
            _ -> requires_word(parser, input, owner)
        }
    }

    state requires_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let requires: bool = Parser::at_word(parser, input, "requires");
        transition requires {
            true -> admit(parser, input, owner, ClauseKind::Requires)
            _ -> ensures_word(parser, input, owner)
        }
    }

    state ensures_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let ensures: bool = Parser::at_word(parser, input, "ensures");
        transition ensures {
            true -> admit(parser, input, owner, ClauseKind::Ensures)
            _ -> where_word(parser, input, owner)
        }
    }

    state where_word(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let facts: bool = Parser::at_word(parser, input, "where");
        transition facts {
            true -> admit(parser, input, owner, ClauseKind::Where)
            _ -> done()
        }
    }

    state admit(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        let admitted: bool = Parser::clause_admitted(owner, kind);
        transition admitted {
            true -> clause(parser, input, owner, kind)
            _ -> reject(parser, input, ParseDiagnosticCode::ClauseNotAdmitted)
        }
    }

    state clause(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        Parser::take_current(parser, input);
        parser.clause_start = parser.token_start;
        parser.clause_first_member = parser.output.member_count as u64 in Trapping;
        transition kind {
            ClauseKind::Reaches -> service(parser, input, owner)
            ClauseKind::Invokes -> invokes_binding(parser, input, owner)
            ClauseKind::Suspends -> operational_end(parser, input, owner, kind)
            ClauseKind::Blocks -> operational_end(parser, input, owner, kind)
            ClauseKind::Crashes -> crashes_cause(parser, input, owner)
            ClauseKind::Requires -> fact(parser, input, owner, kind)
            ClauseKind::Ensures -> fact(parser, input, owner, kind)
            ClauseKind::Where -> fact(parser, input, owner, kind)
        }
    }

    state service(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedReachService);
        transition parser.output.accepted {
            true -> service_member(parser, input, owner)
            _ -> done()
        }
    }

    state service_member(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let start: u64 in Trapping = parser.name_start;
        let end: u64 in Trapping = parser.name_end;
        Parser::append_member(parser, input, start, end);
        transition parser.output.accepted {
            true -> service_separator(parser, input, owner)
            _ -> done()
        }
    }

    state service_separator(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let comma: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        let plus: bool = Parser::at_punctuation(parser, input, PunctuationKind::Plus);
        transition comma || plus {
            true -> service_separator_taken(parser, input, owner)
            _ -> member_clause(parser, input, owner, ClauseKind::Reaches)
        }
    }

    state service_separator_taken(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::take_current(parser, input);
        transition { _ -> service(parser, input, owner) }
    }

    state invokes_binding(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedInvokesBinding);
        transition parser.output.accepted {
            true -> invokes_member(parser, input, owner)
            _ -> done()
        }
    }

    state invokes_member(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let start: u64 in Trapping = parser.name_start;
        let end: u64 in Trapping = parser.name_end;
        Parser::append_member(parser, input, start, end);
        transition parser.output.accepted {
            true -> operational_end(parser, input, owner, ClauseKind::Invokes)
            _ -> done()
        }
    }

    state operational_end(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedClauseEnd);
        transition parser.output.accepted {
            true -> member_clause(parser, input, owner, kind)
            _ -> done()
        }
    }

    // Reaches, invokes and the operational clauses keep their members range.
    state member_clause(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        let clause: Clause = Clause {
            kind: kind,
            first_member: parser.clause_first_member,
            member_count: (parser.output.member_count as u64 in Trapping) - parser.clause_first_member,
            cause: CrashCause::Trap,
            expression: 0,
            source_span: Parser::source_span(parser, parser.clause_start, parser.token_end)
        };
        transition { _ -> store(parser, input, owner, clause) }
    }

    state crashes_cause(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let trap: bool = Parser::at_word(parser, input, "Trap");
        transition trap {
            true -> crash_clause(parser, input, owner, CrashCause::Trap)
            _ -> crashes_abort(parser, input, owner)
        }
    }

    state crashes_abort(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let abort: bool = Parser::at_word(parser, input, "Abort");
        transition abort {
            true -> crash_clause(parser, input, owner, CrashCause::Abort)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedCrashCause)
        }
    }

    state crash_clause(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, cause: CrashCause) {
        Parser::take_current(parser, input);
        let clause: Clause = Clause {
            kind: ClauseKind::Crashes,
            first_member: 0,
            member_count: 0,
            cause: cause,
            expression: 0,
            source_span: Parser::source_span(parser, parser.clause_start, parser.token_end)
        };
        transition { _ -> store(parser, input, owner, clause) }
    }

    // A fact ends where its expression does; the body's `{` admits no
    // construction there.
    state fact(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, kind: ClauseKind) {
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedClauseFact, false);
        transition parser.output.accepted {
            true -> fact_retained(parser, input, owner, kind, parser.expression_result)
            _ -> done()
        }
    }

    state fact_retained(
        parser: &mut Parser,
        input: &TokenStream,
        owner: ClauseOwner,
        kind: ClauseKind,
        fact: u64 in Trapping
    ) {
        let expression: Expression = SyntaxTrees::expression(&parser.output, fact);
        let clause: Clause = Clause {
            kind: kind,
            first_member: 0,
            member_count: 0,
            cause: CrashCause::Trap,
            expression: fact,
            source_span: Parser::source_span(parser, parser.clause_start, expression.source_span.span.end)
        };
        transition { _ -> store(parser, input, owner, clause) }
    }

    state store(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        transition parser.output.clause_count < 1024 {
            true -> stored(parser, input, owner, clause)
            _ -> reject(parser, input, ParseDiagnosticCode::ClauseCapacityExceeded)
        }
    }

    state stored(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner, clause: Clause) {
        parser.output.clauses[parser.output.clause_count] = clause;
        parser.output.clause_count = parser.output.clause_count + 1;
        transition clause.kind {
            ClauseKind::Where -> where_separator(parser, input, owner)
            _ -> next(parser, input, owner)
        }
    }

    // `where` facts continue after `,`; a trailing comma ends them.
    state where_separator(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let comma: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        transition comma {
            true -> where_continues(parser, input, owner)
            _ -> next(parser, input, owner)
        }
    }

    state where_continues(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        Parser::take_current(parser, input);
        let body: bool = Parser::at_punctuation(parser, input, PunctuationKind::LeftBrace);
        let end: bool = Parser::at_punctuation(parser, input, PunctuationKind::Semicolon);
        transition body || end {
            true -> next(parser, input, owner)
            _ -> where_fact(parser, input, owner)
        }
    }

    state where_fact(parser: &mut Parser, input: &TokenStream, owner: ClauseOwner) {
        let token: Token = input.tokens[parser.current_index];
        parser.clause_start = token.start;
        transition { _ -> fact(parser, input, owner, ClauseKind::Where) }
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state done() {}
}

// Which clauses each owner admits: a machine every clause but `where`, a
// state only its arrival `requires`, and a data declaration or case only
// `where`.
machine Parser::clause_admitted(owner: ClauseOwner, kind: ClauseKind) -> bool {
    transition owner {
        ClauseOwner::Machine -> machine_clause(kind)
        ClauseOwner::State -> arrival(kind)
        _ -> declaration(kind)
    }

    state machine_clause(kind: ClauseKind) {
        transition kind {
            ClauseKind::Where -> refused()
            _ -> admitted()
        }
    }

    state arrival(kind: ClauseKind) {
        transition kind {
            ClauseKind::Requires -> admitted()
            _ -> refused()
        }
    }

    state declaration(kind: ClauseKind) {
        transition kind {
            ClauseKind::Where -> admitted()
            _ -> refused()
        }
    }

    state admitted() {
        true
    }

    state refused() {
        false
    }
}

// Append one name to `SyntaxTrees::members`.
machine Parser::append_member(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping, end: u64 in Trapping)
crashes Trap
{
    transition parser.output.member_count < 8192 {
        true -> append(parser, start, end)
        _ -> full(parser, input)
    }

    state append(parser: &mut Parser, start: u64 in Trapping, end: u64 in Trapping) {
        parser.output.members[parser.output.member_count] = Parser::identifier_span(parser, start, end);
        parser.output.member_count = parser.output.member_count + 1;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::PathMemberCapacityExceeded);
    }
}
