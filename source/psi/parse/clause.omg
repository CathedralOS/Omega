use psi::parse::expression;
use psi::parse::input;
use psi::parse::parser;
use psi::syntax::syntax;
use psi::tokens::tokens;

// Machine clauses between the signature and the body, in any order:
// `reaches Service [, Service | + Service]*`, `invokes Binding;`,
// `suspends;`, `blocks;`, `crashes Trap` or `crashes Abort`, and
// `requires fact` or `ensures fact`. Every clause word is contextual. The
// clauses end at the first token that opens none, which the body grammar then
// reads. The range lands in `clause_first` and the table count.
pub machine Parser::parse_machine_clauses(parser: &mut Parser, input: &TokenStream)
crashes Trap
{
    parser.clause_first = parser.output.clause_count as u64 in Trapping;
    transition { _ -> next(parser, input) }

    state next(parser: &mut Parser, input: &TokenStream) {
        let reaches: bool = Parser::at_word(parser, input, "reaches");
        transition reaches {
            true -> reaches_clause(parser, input)
            _ -> invokes_word(parser, input)
        }
    }

    state invokes_word(parser: &mut Parser, input: &TokenStream) {
        let invokes: bool = Parser::at_word(parser, input, "invokes");
        transition invokes {
            true -> invokes_clause(parser, input)
            _ -> suspends_word(parser, input)
        }
    }

    state suspends_word(parser: &mut Parser, input: &TokenStream) {
        let suspends: bool = Parser::at_word(parser, input, "suspends");
        transition suspends {
            true -> operational_clause(parser, input, ClauseKind::Suspends)
            _ -> blocks_word(parser, input)
        }
    }

    state blocks_word(parser: &mut Parser, input: &TokenStream) {
        let blocks: bool = Parser::at_word(parser, input, "blocks");
        transition blocks {
            true -> operational_clause(parser, input, ClauseKind::Blocks)
            _ -> crashes_word(parser, input)
        }
    }

    state crashes_word(parser: &mut Parser, input: &TokenStream) {
        let crashes: bool = Parser::at_word(parser, input, "crashes");
        transition crashes {
            true -> crashes_clause(parser, input)
            _ -> requires_word(parser, input)
        }
    }

    state requires_word(parser: &mut Parser, input: &TokenStream) {
        let requires: bool = Parser::at_word(parser, input, "requires");
        transition requires {
            true -> fact_clause(parser, input, ClauseKind::Requires)
            _ -> ensures_word(parser, input)
        }
    }

    state ensures_word(parser: &mut Parser, input: &TokenStream) {
        let ensures: bool = Parser::at_word(parser, input, "ensures");
        transition ensures {
            true -> fact_clause(parser, input, ClauseKind::Ensures)
            _ -> done()
        }
    }

    state reaches_clause(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.clause_start = parser.token_start;
        parser.clause_first_member = parser.output.member_count as u64 in Trapping;
        transition { _ -> service(parser, input) }
    }

    state service(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedReachService);
        transition parser.output.accepted {
            true -> service_member(parser, input)
            _ -> done()
        }
    }

    state service_member(parser: &mut Parser, input: &TokenStream) {
        let start: u64 in Trapping = parser.name_start;
        let end: u64 in Trapping = parser.name_end;
        Parser::append_member(parser, input, start, end);
        transition parser.output.accepted {
            true -> service_separator(parser, input)
            _ -> done()
        }
    }

    state service_separator(parser: &mut Parser, input: &TokenStream) {
        let comma: bool = Parser::at_punctuation(parser, input, PunctuationKind::Comma);
        let plus: bool = Parser::at_punctuation(parser, input, PunctuationKind::Plus);
        transition comma || plus {
            true -> service_separator_taken(parser, input)
            _ -> member_clause(parser, input, ClauseKind::Reaches)
        }
    }

    state service_separator_taken(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        transition { _ -> service(parser, input) }
    }

    state invokes_clause(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.clause_start = parser.token_start;
        parser.clause_first_member = parser.output.member_count as u64 in Trapping;
        Parser::expect_name(parser, input, ParseDiagnosticCode::ExpectedInvokesBinding);
        transition parser.output.accepted {
            true -> invokes_member(parser, input)
            _ -> done()
        }
    }

    state invokes_member(parser: &mut Parser, input: &TokenStream) {
        let start: u64 in Trapping = parser.name_start;
        let end: u64 in Trapping = parser.name_end;
        Parser::append_member(parser, input, start, end);
        transition parser.output.accepted {
            true -> invokes_end(parser, input)
            _ -> done()
        }
    }

    state invokes_end(parser: &mut Parser, input: &TokenStream) {
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedClauseEnd);
        transition parser.output.accepted {
            true -> member_clause(parser, input, ClauseKind::Invokes)
            _ -> done()
        }
    }

    state operational_clause(parser: &mut Parser, input: &TokenStream, kind: ClauseKind) {
        Parser::take_current(parser, input);
        parser.clause_start = parser.token_start;
        parser.clause_first_member = parser.output.member_count as u64 in Trapping;
        Parser::expect_punctuation(parser, input, PunctuationKind::Semicolon, ParseDiagnosticCode::ExpectedClauseEnd);
        transition parser.output.accepted {
            true -> member_clause(parser, input, kind)
            _ -> done()
        }
    }

    // Reaches, invokes and the operational clauses keep their members range.
    state member_clause(parser: &mut Parser, input: &TokenStream, kind: ClauseKind) {
        let clause: MachineClause = MachineClause {
            kind: kind,
            first_member: parser.clause_first_member,
            member_count: (parser.output.member_count as u64 in Trapping) - parser.clause_first_member,
            cause: CrashCause::Trap,
            expression: 0,
            source_span: Parser::source_span(parser, parser.clause_start, parser.token_end)
        };
        transition { _ -> store(parser, input, clause) }
    }

    state crashes_clause(parser: &mut Parser, input: &TokenStream) {
        Parser::take_current(parser, input);
        parser.clause_start = parser.token_start;
        let trap: bool = Parser::at_word(parser, input, "Trap");
        transition trap {
            true -> crashes_cause(parser, input, CrashCause::Trap)
            _ -> crashes_abort(parser, input)
        }
    }

    state crashes_abort(parser: &mut Parser, input: &TokenStream) {
        let abort: bool = Parser::at_word(parser, input, "Abort");
        transition abort {
            true -> crashes_cause(parser, input, CrashCause::Abort)
            _ -> reject(parser, input, ParseDiagnosticCode::ExpectedCrashCause)
        }
    }

    state crashes_cause(parser: &mut Parser, input: &TokenStream, cause: CrashCause) {
        Parser::take_current(parser, input);
        let clause: MachineClause = MachineClause {
            kind: ClauseKind::Crashes,
            first_member: 0,
            member_count: 0,
            cause: cause,
            expression: 0,
            source_span: Parser::source_span(parser, parser.clause_start, parser.token_end)
        };
        transition { _ -> store(parser, input, clause) }
    }

    // A fact ends where its expression does; the body's `{` admits no
    // construction there.
    state fact_clause(parser: &mut Parser, input: &TokenStream, kind: ClauseKind) {
        Parser::take_current(parser, input);
        parser.clause_start = parser.token_start;
        Parser::parse_expression(parser, input, ParseDiagnosticCode::ExpectedClauseFact, false);
        transition parser.output.accepted {
            true -> fact_retained(parser, input, kind, parser.expression_result)
            _ -> done()
        }
    }

    state fact_retained(parser: &mut Parser, input: &TokenStream, kind: ClauseKind, fact: u64 in Trapping) {
        let expression: Expression = SyntaxTrees::expression(&parser.output, fact);
        let clause: MachineClause = MachineClause {
            kind: kind,
            first_member: 0,
            member_count: 0,
            cause: CrashCause::Trap,
            expression: fact,
            source_span: Parser::source_span(parser, parser.clause_start, expression.source_span.span.end)
        };
        transition { _ -> store(parser, input, clause) }
    }

    state store(parser: &mut Parser, input: &TokenStream, clause: MachineClause) {
        transition parser.output.clause_count < 512 {
            true -> stored(parser, input, clause)
            _ -> reject(parser, input, ParseDiagnosticCode::ClauseCapacityExceeded)
        }
    }

    state stored(parser: &mut Parser, input: &TokenStream, clause: MachineClause) {
        parser.output.clauses[parser.output.clause_count] = clause;
        parser.output.clause_count = parser.output.clause_count + 1;
        transition { _ -> next(parser, input) }
    }

    state reject(parser: &mut Parser, input: &TokenStream, code: ParseDiagnosticCode) {
        Parser::reject_current(parser, input, code);
    }

    state done() {}
}

// Append one name to `SyntaxTrees::members`.
machine Parser::append_member(parser: &mut Parser, input: &TokenStream, start: u64 in Trapping, end: u64 in Trapping)
crashes Trap
{
    transition parser.output.member_count < 1024 {
        true -> append(parser, start, end)
        _ -> full(parser, input)
    }

    state append(parser: &mut Parser, start: u64 in Trapping, end: u64 in Trapping) {
        parser.output.members[parser.output.member_count] = Parser::identifier_span(parser, start, end);
        parser.output.member_count = parser.output.member_count + 1;
    }

    state full(parser: &mut Parser, input: &TokenStream) {
        Parser::reject_current(parser, input, ParseDiagnosticCode::PathMemberCapacityExceeded);
    }
}
