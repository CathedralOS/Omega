; beta_compiler.beta - the Beta compiler, written in Beta. Reads Beta text
; on stdin, writes a bytecode tape on stdout. Two passes: pass 1 records label
; addresses, pass 2 emits, resolving label references. This is the self-hosting
; target: assembled to a tape, which the alpha seed then runs to reproduce that tape.
;
; The source language is human mnemonics: opcode names (imm/mov/add/.../ret), registers
; written `rH` or `rHH`, `0xH...` word immediates, and label names. Hex digits are
; lowercase. Commas are treated as whitespace.
; `;` starts a comment. No Rust/--num step - the direct Alpha tape reads .beta directly.
;
; r0-rb are caller-clobbered scratch. High registers preserve state across calls:
;   r80 source end  r81 cursor  r82 token start  r83 token length  r85 OUT
;   r86 label-row end cursor  r87 operand-width-list pointer
;   r8c NUM word scratch address
;   r91 source base  r92 source limit/label rows  r93 label-row limit
;   r95 output maximum.
; Label rows are 24 bytes: source pointer, length, output address.
; Preserved pass state: r96 operand counter, r97 mode,
;   r98 current operand width. Constants: r99 = 0 from Alpha initialization,
;   r9a = 1, r9b = 8-byte Alpha word width, r9c = 9 failure status,
;   r9d = ASCII '0'.
; Buffers: 0x100000..0x200000 source; 0x200000..0x380000 label rows.
; Mnemonic table: 21 Alpha instructions plus db at mnemonic_table.

; ---------------- main ----------------
        imm   r8c, 0x80060
        imm   r91, 0x100000
        imm   r92, 0x200000
        imm   r93, 0x380000
        imm   r95, 0xffffc
        imm   r9a, 0x1
        imm   r9b, 0x8
        imm   r9c, 0x9
        imm   r9d, 0x30

        ; read all of stdin into SRC
        mov   r0, r91       ; r0 = write pointer
read_loop:
        mov   r2, r92
        jeq   r0, r2, read_full
        read  r1
        mov   r3, r99
        jlt   r1, r3, read_done ; byte < 0  =>  EOF
        mov   r3, r9c
        jeq   r1, r3, read_store
        imm   r3, 0xa
        jeq   r1, r3, read_store
        imm   r3, 0xd
        jeq   r1, r3, read_store
        imm   r3, 0x20
        jlt   r1, r3, source_reject
        imm   r3, 0x7f
        jlt   r1, r3, read_store
        jmp   source_reject
read_store:
        storeb r0, r1
        mov   r3, r9a
        add   r0, r3
        jmp   read_loop
read_full:
        read  r1
        mov   r3, r99
        jlt   r1, r3, read_done
        jmp   source_reject
source_reject:
        mov   r0, r9c
        halt  r0
read_done:
        mov   r80, r0           ; source end pointer
        mov   r86, r92          ; empty label-row range

        ; Pass 1 counts output and builds the label table.
        mov   r81, r91          ; CUR = source start
        mov   r85, r99          ; OUT = 0
        mov   r97, r99          ; count mode
        call  scan_program

        ; Pass 2 emits with the complete label table.
        mov   r81, r91
        mov   r97, r9a          ; emit mode
        call  scan_program
        mov   r0, r99
        halt  r0

scan_program:
scan_loop:
        call  next_token
        mov   r1, r99
        jlt   r0, r1, scan_done
        jnz   r0, scan_label
        call  parse_op
        imm   r1, 0x15
        jeq   r0, r1, scan_db  ; db pseudo-opcode
        jnz   r97, scan_emit

        ; Count this instruction and consume its width list.
        add   r85, r9a
        jlt   r95, r85, source_reject
        mov   r96, r87
scan_count_operand:
        loadb r98, r96
        jz    r98, scan_loop
        sub   r98, r9d
        add   r85, r98
        jlt   r95, r85, source_reject
        call  next_token
        jnz   r0, operand_reject
        add   r96, r9a
        jmp   scan_count_operand

scan_emit:
        write r0
        mov   r96, r87
scan_emit_operand:
        loadb r98, r96
        jz    r98, scan_loop
        sub   r98, r9d
        call  emit_operand
        add   r96, r9a
        jmp   scan_emit_operand

scan_label:
        jnz   r97, scan_loop
        call  record_label
        jmp   scan_loop
scan_db:
        call  db_scan
        jmp   scan_loop
scan_done:
        ret

; ---------------- next_token ----------------
; skip exact whitespace (space/HT/LF/CR), commas, and `;` comments, then read a token;
; set TSTART/TLEN; return 0 token, 1 label definition, or -1 source end.
next_token:
        mov   r1, r81           ; r1 = CUR
        mov   r3, r80           ; r3 = source end
nt_skip:
        jlt   r1, r3, nt_have
        jmp   nt_none
nt_have:
        loadb r2, r1           ; c
        ; The validated envelope makes c < 0x21 exactly HT/LF/CR/space.
        imm   r6, 0x21
        jlt   r2, r6, nt_adv
        imm   r6, 0x2c
        jeq   r2, r6, nt_adv   ; ','     =>  separator
        imm   r6, 0x3b
        jeq   r2, r6, nt_comment
        jmp   nt_token
nt_adv:
        mov   r6, r9a
        add   r1, r6
        jmp   nt_skip
nt_comment:
        jlt   r1, r3, nt_comment_in
        jmp   nt_none
nt_comment_in:
        loadb r2, r1
        mov   r6, r9a
        add   r1, r6
        imm   r6, 0xa
        jeq   r2, r6, nt_skip  ; LF ends the comment
        imm   r6, 0xd
        jeq   r2, r6, nt_skip  ; CR ends the comment
        jmp   nt_comment
nt_token:
        mov   r82, r1           ; TSTART = CUR
nt_tloop:
        jlt   r1, r3, nt_tin
        jmp   nt_tend
nt_tin:
        loadb r2, r1
        imm   r6, 0x21
        jlt   r2, r6, nt_tend  ; validated whitespace ends token
        imm   r6, 0x2c
        jeq   r2, r6, nt_tend  ; ',' ends token
        imm   r6, 0x3b
        jeq   r2, r6, nt_tend  ; `;` ends token
        mov   r6, r9a
        add   r1, r6
        jmp   nt_tloop
nt_tend:
        mov   r8, r82           ; TSTART
        mov   r9, r1
        sub   r9, r8           ; TLEN = CUR - TSTART
        mov   r83, r9
        mov   r81, r1           ; CUR = r1
        mov   r7, r1
        sub   r7, r9a
        loadb r8, r7
        imm   r9, 0x3a           ; ':'
        jeq   r8, r9, nt_label
        mov   r0, r99           ; ordinary token
        ret
nt_label:
        mov   r0, r9a           ; label definition
        ret
nt_none:
        mov   r81, r1
        imm   r0, 0xffffffffffffffff
        ret

; ---------------- parse_hex_word ----------------
; NUM = 0x-prefixed lowercase hexadecimal value of the current token.
; One through sixteen digits cover the complete unsigned Alpha word domain.
parse_hex_word:
        mov   r4, r82           ; TSTART
        mov   r5, r83           ; TLEN
        imm   r8, 0x3
        jlt   r5, r8, operand_reject
        imm   r8, 0x12
        jlt   r8, r5, operand_reject
        mov   r8, r4
        mov   ra, r9a
        add   r8, ra
        loadb r9, r8
        imm   ra, 0x78          ; 'x'
        jeq   r9, ra, phw_digits
        jmp   operand_reject
phw_digits:
        imm   r7, 0x2            ; skip '0x'
        call  parse_hex_digits
        ret

; r4/r5 token span and r7 first digit -> NUM.
parse_hex_digits:
        mov   r6, r99            ; accumulator
phd_loop:
        jlt   r7, r5, phd_byte
        mov   r3, r8c
        store r3, r6
        ret
phd_byte:
        mov   r8, r4
        add   r8, r7
        loadb r9, r8
        call  hex_nibble
        imm   ra, 0x10
        mul   r6, ra
        add   r6, r9
        mov   ra, r9a
        add   r7, ra
        jmp   phd_loop

; Lowercase hexadecimal byte r9 -> nibble r9. Preserves r4-r8.
hex_nibble:
        mov   ra, r9d           ; '0'
        jlt   r9, ra, operand_reject
        imm   rb, 0x3a           ; ':'
        jlt   r9, rb, hn_digit
        imm   ra, 0x61           ; 'a'
        jlt   r9, ra, operand_reject
        imm   rb, 0x67          ; 'g'
        jlt   r9, rb, hn_lower
        jmp   operand_reject
hn_digit:
        sub   r9, ra
        ret
hn_lower:
        imm   ra, 0x57           ; 'a' - 10
        sub   r9, ra
        ret

; ---------------- parse_op ----------------
; Compare the current token directly with each padded mnemonic row.
; Return opcode in r0 and install its operand descriptor. Halt 8 if unknown.
parse_op:
        mov   r4, r82           ; TSTART
        mov   r5, r83           ; TLEN
        mov   rb, r9b
        jlt   rb, r5, unknown_mnemonic
        mov   r0, r99            ; op = 0
        imm   r1, mnemonic_table
po_mloop:
        loadb rb, r1
        jz    rb, unknown_mnemonic
        mov   r6, r99            ; byte index
po_compare:
        jlt   r6, r5, po_compare_byte
        loadb r7, r1
        jz    r7, po_found
        jmp   po_next
po_compare_byte:
        mov   r7, r4
        add   r7, r6
        loadb r8, r7
        loadb r9, r1
        jeq   r8, r9, po_same
        jmp   po_next
po_same:
        add   r1, r9a
        add   r6, r9a
        jmp   po_compare
po_next:
        loadb r7, r1
        jz    r7, po_skip_widths
        add   r1, r9a
        jmp   po_next
po_skip_widths:
        add   r1, r9a
po_skip_width:
        loadb r7, r1
        jz    r7, po_next_row
        add   r1, r9a
        jmp   po_skip_width
po_next_row:
        add   r1, r9a          ; past descriptor NUL
        add   r0, r9a
        jmp   po_mloop
po_found:
        add   r1, r9a          ; NUL-terminated ASCII width list follows name
        mov   r87, r1
        ret

unknown_mnemonic:
        mov   r0, r9b
        halt  r0

; ---------------- validate_ident ----------------
; Validate IDENT at source pointer r4 with length r5. Preserve r4/r5.
validate_ident:
        mov   r6, r9a
        jlt   r5, r6, operand_reject
        mov   r6, r99
vi_loop:
        jlt   r6, r5, vi_byte
        ret
vi_byte:
        mov   r7, r4
        add   r7, r6
        loadb r8, r7
        mov   r9, r99
        jeq   r6, r9, vi_lower
        ; Subsequent identifier bytes additionally admit decimal digits.
        mov   r9, r9d
        jlt   r8, r9, vi_lower
        imm   r9, 0x3a
        jlt   r8, r9, vi_valid
vi_lower:
        imm   r9, 0x5f           ; '_'
        jeq   r8, r9, vi_valid
        imm   r9, 0x61
        jlt   r8, r9, operand_reject
        imm   r9, 0x7b
        jlt   r8, r9, vi_valid ; a-z
        jmp   operand_reject
vi_valid:
        mov   r9, r9a
        add   r6, r9
        jmp   vi_loop

; ---------------- record_label ----------------
; Validate uniqueness, then append (TSTART, TLEN-1, OUT) to the label rows.
record_label:
        mov   r4, r82           ; TSTART
        mov   r5, r83           ; TLEN including ':'
        mov   r6, r9a
        sub   r5, r6
        call  validate_ident

        call  lookup_label
        jnz   r0, operand_reject

        jeq   r86, r93, source_reject
        mov   r4, r82           ; TSTART
        mov   r5, r86
        store r5, r4           ; source pointer
        mov   r4, r83           ; TLEN
        mov   r6, r9a
        sub   r4, r6           ; drop ':'
        mov   r6, r9b
        add   r5, r6
        store r5, r4           ; length
        mov   r4, r85           ; OUT
        add   r5, r6
        store r5, r4           ; output address
        add   r5, r9b
        mov   r86, r5           ; advance by one 24-byte row
        ret

; r4/r5 name span -> r0 label row, or zero when absent.
lookup_label:
        mov   r2, r92
ll_loop:
        jlt   r2, r86, ll_in
        mov   r0, r99
        ret
ll_in:
        mov   r3, r2
        add   r3, r9b
        load  r6, r3           ; stored length
        jeq   r6, r5, ll_lenok
        jmp   ll_next
ll_lenok:
        load  r6, r2           ; source pointer
        mov   r8, r99            ; j
ll_cmp:
        jlt   r8, r5, ll_byte
        mov   r0, r2
        ret
ll_byte:
        mov   r9, r6
        add   r9, r8
        loadb ra, r9          ; name byte
        mov   r9, r4
        add   r9, r8
        loadb rb, r9          ; token byte
        jeq   ra, rb, ll_same
        jmp   ll_next
ll_same:
        add   r8, r9a
        jmp   ll_cmp
ll_next:
        imm   r3, 0x18
        add   r2, r3
        jmp   ll_loop

; ---------------- find_label ----------------
; NUM = address of the label whose name equals the current token; halt 7 if none.
find_label:
        mov   r4, r82
        mov   r5, r83
        call  lookup_label
        jz    r0, fl_none
        imm   r3, 0x10
        add   r0, r3
        load  r9, r0           ; output address
        mov   r3, r8c
        store r3, r9           ; NUM = addr
        ret
fl_none:
        jmp   operand_reject

; ---------------- emit_operand ----------------
; Read and validate the next operand according to EMITW: width 1 is exactly
; REGISTER, width 8 is exactly HEXWORD or IDENT. Emit little-endian bytes.
emit_operand:
        call  next_token
        jnz   r0, operand_reject
        mov   r1, r98           ; width
        mov   r2, r9a
        jeq   r1, r2, eo_register
        mov   r2, r9b
        jeq   r1, r2, eo_word
        jmp   operand_reject

eo_register:
        mov   r4, r82           ; TSTART
        mov   r5, r83           ; TLEN
        imm   r6, 0x2
        jlt   r5, r6, operand_reject
        imm   r6, 0x3
        jlt   r6, r5, operand_reject
        mov   r6, r4
        loadb r6, r6
        imm   r7, 0x72          ; 'r'
        jeq   r6, r7, er_parse
        jmp   operand_reject
er_parse:
        mov   r7, r9a            ; skip 'r'
        call  parse_hex_digits
        write r6
        ret

eo_word:
        mov   r4, r82
        mov   r5, r83
        mov   r6, r4
        loadb r6, r6
        mov   r7, r9d            ; '0'
        jeq   r6, r7, eo_hex_word
        jmp   eo_identifier
eo_hex_word:
        call  parse_hex_word
        jmp   eo_emit
eo_identifier:
        call  find_label
eo_emit:
        mov   r3, r8c
        mov   r1, r8c
        add   r1, r9b          ; end of eight-byte NUM scratch
eo_bloop:
        jeq   r3, r1, eo_done
        loadb r0, r3
        write r0
        add   r3, r9a
        jmp   eo_bloop
eo_done:
        ret

operand_reject:
        imm   r0, 0x7
        halt  r0

; ---------------- db_scan ----------------
; Handle a `db "..."` data directive. Only whitespace may occur before the
; opening quote. Raw string bytes must be printable ASCII; escapes are exactly
; \0, \\, and \". r97 selects:
;   0 = pass 1, add each byte to OUT (so labels after the data get right addrs);
;   1 = pass 2, write each byte to the tape. Leaves CUR past the closing quote.
db_scan:
        mov   r1, r81           ; r1 = CUR
        mov   r3, r80           ; r3 = source end
ds_findq:
        jlt   r1, r3, ds_fq_in
        mov   r0, r9c
        halt  r0               ; malformed db: no opening quote
ds_fq_in:
        loadb r2, r1
        imm   r6, 0x22           ; '"'
        jeq   r2, r6, ds_open
        imm   r6, 0x21
        jlt   r2, r6, ds_fq_adv
        jmp   source_reject
ds_fq_adv:
        mov   r6, r9a
        add   r1, r6
        jmp   ds_findq
ds_open:
        mov   r6, r9a
        add   r1, r6           ; past the opening quote
ds_loop:
        jlt   r1, r3, ds_loop_in
        mov   r0, r9c
        halt  r0               ; unterminated db string
ds_loop_in:
        loadb r2, r1           ; c
        imm   r6, 0x22           ; '"'
        jeq   r2, r6, ds_close
        imm   r6, 0x5c           ; '\'
        jeq   r2, r6, ds_esc
        imm   r6, 0x20
        jlt   r2, r6, source_reject
        imm   r6, 0x7f
        jlt   r2, r6, ds_emit
        jmp   source_reject
ds_esc:
        mov   r6, r9a
        add   r1, r6           ; skip the backslash
        jlt   r1, r3, ds_esc_in
        jmp   source_reject
ds_esc_in:
        loadb r2, r1           ; escaped char
        mov   r6, r9d           ; '0'
        jeq   r2, r6, ds_e_0
        imm   r6, 0x5c           ; '\\'
        jeq   r2, r6, ds_emit
        imm   r6, 0x22           ; '\"'
        jeq   r2, r6, ds_emit
        jmp   source_reject
ds_e_0:
        mov   r2, r99
        jmp   ds_emit
ds_emit:
        jnz   r97, ds_write
        mov   r8, r85           ; OUT
        mov   r6, r95
        jeq   r8, r6, source_reject
        mov   r6, r9a
        add   r8, r6
        mov   r85, r8           ; OUT += 1
        jmp   ds_next
ds_write:
        write r2
ds_next:
        mov   r6, r9a
        add   r1, r6           ; past this source char
        mov   r3, r80           ; reload source end
        jmp   ds_loop
ds_close:
        mov   r6, r9a
        add   r1, r6           ; past the closing quote
        mov   r81, r1           ; CUR = r1
        ret

; NUL-terminated names in opcode order. Each name is followed by a
; NUL-terminated list of ASCII widths: 1 register byte or 8 word bytes.
mnemonic_table:
        db "halt\01\0"
        db "imm\018\0"
        db "mov\011\0"
        db "add\011\0"
        db "sub\011\0"
        db "mul\011\0"
        db "div\011\0"
        db "mod\011\0"
        db "loadb\011\0"
        db "storeb\011\0"
        db "load\011\0"
        db "store\011\0"
        db "jmp\08\0"
        db "jz\018\0"
        db "jnz\018\0"
        db "jlt\0118\0"
        db "jeq\0118\0"
        db "read\01\0"
        db "write\01\0"
        db "call\08\0"
        db "ret\0\0"
        db "db\0\0"
        db "\0"
