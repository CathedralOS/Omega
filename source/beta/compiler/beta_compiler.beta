; beta_compiler.beta - addressed Beta compiler, written in Beta.
; Address assertions are `0x...:` and
; every control target is a numeric word. One pass emits directly to stdout.
;
; The source language is human mnemonics: opcode names (imm/mov/add/.../ret), registers
; written `rH` or `rHH`, `0xH...` word immediates, and numeric targets. Hex digits are
; lowercase. Commas are treated as whitespace.
; `;` starts a comment. No Rust/--num step - the direct Alpha tape reads .beta directly.
;
; r0-rb are caller-clobbered scratch. High registers preserve state across calls:
;   r80 source end  r81 cursor  r82 token start  r83 token length  r85 OUT
;   r87 operand-width-list pointer
;   r8c NUM word scratch address
;   r91 source base  r92 source limit  r95 output maximum.
; Preserved pass state: r96 width-list cursor, r98 current operand width.
; Constants: r99 = 0 from Alpha initialization,
;   r9a = 1, r9b = 8-byte Alpha word width, r9c = 9 failure status,
;   r9d = ASCII '0'.
; Buffer: 0x100000..0x1100000 source.
; Mnemonic table: 21 Alpha instructions plus dw at mnemonic_table.

; ---------------- main ----------------
        imm   r8c, 0x80060
        imm   r91, 0x100000
        imm   r92, 0x1100000
        imm   r95, 0xffffc
        imm   r9a, 0x1
        imm   r9b, 0x8
        imm   r9c, 0x9
        imm   r9d, 0x30

        ; read all of stdin into SRC
        mov   r0, r91       ; r0 = write pointer
0x53: ; read_loop:
        mov   r2, r92
        jeq   r0, r2, 0xee ; -> read_full:
        read  r1
        mov   r3, r99
        jlt   r1, r3, 0x10c ; byte < 0  =>  EOF -> read_done:
        mov   r3, r9c
        jeq   r1, r3, 0xdc ; -> read_store:
        imm   r3, 0xa
        jeq   r1, r3, 0xdc ; -> read_store:
        imm   r3, 0xd
        jeq   r1, r3, 0xdc ; -> read_store:
        imm   r3, 0x20
        jlt   r1, r3, 0x107 ; -> source_reject:
        imm   r3, 0x7f
        jlt   r1, r3, 0xdc ; -> read_store:
        jmp   0x107 ; -> source_reject:
0xdc: ; read_store:
        storeb r0, r1
        mov   r3, r9a
        add   r0, r3
        jmp   0x53 ; -> read_loop:
0xee: ; read_full:
        read  r1
        mov   r3, r99
        jlt   r1, r3, 0x10c ; -> read_done:
        jmp   0x107 ; -> source_reject:
0x107: ; source_reject:
        mov   r0, r9c
        halt  r0
0x10c: ; read_done:
        mov   r80, r0           ; source end pointer
        mov   r81, r91          ; CUR = source start
        mov   r85, r99          ; OUT = 0
        call  0x123 ; -> scan_program:
        mov   r0, r99
        halt  r0

0x123: ; scan_program:
0x123: ; scan_loop:
        call  0x1e4 ; -> next_token:
        mov   r1, r99
        jlt   r0, r1, 0x1e3 ; -> scan_done:
        jnz   r0, 0x1a8 ; -> scan_address:
        call  0x46f ; -> parse_op:
        imm   r1, 0x15
        jeq   r0, r1, 0x1d1 ; dw pseudo-opcode -> scan_dw:
        write r0
        add   r85, r9a
        jlt   r95, r85, 0x107 ; -> source_reject:
        mov   r96, r87
0x175: ; scan_operand:
        loadb r98, r96
        jz    r98, 0x123 ; -> scan_loop:
        sub   r98, r9d
        add   r85, r98
        jlt   r95, r85, 0x107 ; -> source_reject:
        call  0x540 ; -> emit_operand:
        add   r96, r9a
        jmp   0x175 ; -> scan_operand:

0x1a8: ; scan_address:
        sub   r83, r9a         ; remove ':' from the asserted word
        call  0x353 ; -> parse_hex_word:
        add   r83, r9a
        mov   r3, r8c
        load  r0, r3
        jeq   r0, r85, 0x123 ; -> scan_loop:
        jmp   0x107 ; -> source_reject:

0x1d1: ; scan_dw:
        call  0x645 ; -> dw_scan:
        jmp   0x123 ; -> scan_loop:
0x1e3: ; scan_done:
        ret

; ---------------- next_token ----------------
; skip exact whitespace (space/HT/LF/CR), commas, and `;` comments, then read a token;
; set TSTART/TLEN; return 0 token, 1 address assertion, or -1 source end.
0x1e4: ; next_token:
        mov   r1, r81           ; r1 = CUR
        mov   r3, r80           ; r3 = source end
0x1ea: ; nt_skip:
        jlt   r1, r3, 0x1fe ; -> nt_have:
        jmp   0x345 ; -> nt_none:
0x1fe: ; nt_have:
        loadb r2, r1           ; c
        ; The validated envelope makes c < 0x21 exactly HT/LF/CR/space.
        imm   r6, 0x21
        jlt   r2, r6, 0x249 ; -> nt_adv:
        imm   r6, 0x2c
        jeq   r2, r6, 0x249 ; ','     =>  separator -> nt_adv:
        imm   r6, 0x3b
        jeq   r2, r6, 0x258 ; -> nt_comment:
        jmp   0x2a8 ; -> nt_token:
0x249: ; nt_adv:
        mov   r6, r9a
        add   r1, r6
        jmp   0x1ea ; -> nt_skip:
0x258: ; nt_comment:
        jlt   r1, r3, 0x26c ; -> nt_comment_in:
        jmp   0x345 ; -> nt_none:
0x26c: ; nt_comment_in:
        loadb r2, r1
        mov   r6, r9a
        add   r1, r6
        imm   r6, 0xa
        jeq   r2, r6, 0x1ea ; LF ends the comment -> nt_skip:
        imm   r6, 0xd
        jeq   r2, r6, 0x1ea ; CR ends the comment -> nt_skip:
        jmp   0x258 ; -> nt_comment:
0x2a8: ; nt_token:
        mov   r82, r1           ; TSTART = CUR
0x2ab: ; nt_tloop:
        jlt   r1, r3, 0x2bf ; -> nt_tin:
        jmp   0x310 ; -> nt_tend:
0x2bf: ; nt_tin:
        loadb r2, r1
        imm   r6, 0x21
        jlt   r2, r6, 0x310 ; validated whitespace ends token -> nt_tend:
        imm   r6, 0x2c
        jeq   r2, r6, 0x310 ; ',' ends token -> nt_tend:
        imm   r6, 0x3b
        jeq   r2, r6, 0x310 ; `;` ends token -> nt_tend:
        mov   r6, r9a
        add   r1, r6
        jmp   0x2ab ; -> nt_tloop:
0x310: ; nt_tend:
        mov   r8, r82           ; TSTART
        mov   r9, r1
        sub   r9, r8           ; TLEN = CUR - TSTART
        mov   r83, r9
        mov   r81, r1           ; CUR = r1
        mov   r7, r1
        sub   r7, r9a
        loadb r8, r7
        imm   r9, 0x3a           ; ':'
        jeq   r8, r9, 0x341 ; -> nt_label:
        mov   r0, r99           ; ordinary token
        ret
0x341: ; nt_label:
        mov   r0, r9a           ; address assertion
        ret
0x345: ; nt_none:
        mov   r81, r1
        imm   r0, 0xffffffffffffffff
        ret

; ---------------- parse_hex_word ----------------
; NUM = 0x-prefixed lowercase hexadecimal value of the current token.
; One through sixteen digits cover the complete unsigned Alpha word domain.
0x353: ; parse_hex_word:
        mov   r4, r82           ; TSTART
        mov   r5, r83           ; TLEN
        imm   r8, 0x3
        jlt   r5, r8, 0x639 ; -> operand_reject:
        imm   r8, 0x12
        jlt   r8, r5, 0x639 ; -> operand_reject:
        mov   r8, r4
        mov   ra, r9a
        add   r8, ra
        loadb r9, r8
        imm   ra, 0x78          ; 'x'
        jeq   r9, ra, 0x3ad ; -> phw_digits:
        jmp   0x639 ; -> operand_reject:
0x3ad: ; phw_digits:
        imm   r7, 0x2            ; skip '0x'
        call  0x3c1 ; -> parse_hex_digits:
        ret

; r4/r5 token span and r7 first digit -> NUM.
0x3c1: ; parse_hex_digits:
        mov   r6, r99            ; accumulator
0x3c4: ; phd_loop:
        jlt   r7, r5, 0x3d6 ; -> phd_byte:
        mov   r3, r8c
        store r3, r6
        ret
0x3d6: ; phd_byte:
        mov   r8, r4
        add   r8, r7
        loadb r9, r8
        call  0x407 ; -> hex_nibble:
        imm   ra, 0x10
        mul   r6, ra
        add   r6, r9
        mov   ra, r9a
        add   r7, ra
        jmp   0x3c4 ; -> phd_loop:

; Lowercase hexadecimal byte r9 -> nibble r9. Preserves r4-r8.
0x407: ; hex_nibble:
        mov   ra, r9d           ; '0'
        jlt   r9, ra, 0x639 ; -> operand_reject:
        imm   rb, 0x3a           ; ':'
        jlt   r9, rb, 0x45d ; -> hn_digit:
        imm   ra, 0x61           ; 'a'
        jlt   r9, ra, 0x639 ; -> operand_reject:
        imm   rb, 0x67          ; 'g'
        jlt   r9, rb, 0x461 ; -> hn_lower:
        jmp   0x639 ; -> operand_reject:
0x45d: ; hn_digit:
        sub   r9, ra
        ret
0x461: ; hn_lower:
        imm   ra, 0x57           ; 'a' - 10
        sub   r9, ra
        ret

; ---------------- parse_op ----------------
; Compare the current token directly with each mnemonic row.
; Return opcode in r0 and install its operand descriptor. Halt 8 if unknown.
0x46f: ; parse_op:
        mov   r4, r82           ; TSTART
        mov   r5, r83           ; TLEN
        mov   rb, r9b
        jlt   rb, r5, 0x53b ; -> unknown_mnemonic:
        mov   r0, r99            ; op = 0
        imm   r1, 0x660
0x490: ; po_mloop:
        loadb rb, r1
        jz    rb, 0x53b ; -> unknown_mnemonic:
        mov   r6, r99            ; byte index
0x4a0: ; po_compare:
        jlt   r6, r5, 0x4c1 ; -> po_compare_byte:
        loadb r7, r1
        jz    r7, 0x534 ; -> po_found:
        jmp   0x4f0 ; -> po_next:
0x4c1: ; po_compare_byte:
        mov   r7, r4
        add   r7, r6
        loadb r8, r7
        loadb r9, r1
        jeq   r8, r9, 0x4e1 ; -> po_same:
        jmp   0x4f0 ; -> po_next:
0x4e1: ; po_same:
        add   r1, r9a
        add   r6, r9a
        jmp   0x4a0 ; -> po_compare:
0x4f0: ; po_next:
        loadb r7, r1
        jz    r7, 0x509 ; -> po_skip_widths:
        add   r1, r9a
        jmp   0x4f0 ; -> po_next:
0x509: ; po_skip_widths:
        add   r1, r9a
0x50c: ; po_skip_width:
        loadb r7, r1
        jz    r7, 0x525 ; -> po_next_row:
        add   r1, r9a
        jmp   0x50c ; -> po_skip_width:
0x525: ; po_next_row:
        add   r1, r9a          ; past descriptor NUL
        add   r0, r9a
        jmp   0x490 ; -> po_mloop:
0x534: ; po_found:
        add   r1, r9a          ; NUL-terminated ASCII width list follows name
        mov   r87, r1
        ret

0x53b: ; unknown_mnemonic:
        mov   r0, r9b
        halt  r0

; ---------------- emit_operand ----------------
; Read and validate the next operand according to EMITW: width 1 is exactly
; REGISTER, width 8 is exactly HEXWORD. Emit little-endian bytes.
0x540: ; emit_operand:
        call  0x1e4 ; -> next_token:
        jnz   r0, 0x639 ; -> operand_reject:
        mov   r1, r98           ; width
        mov   r2, r9a
        jeq   r1, r2, 0x57b ; -> eo_register:
        mov   r2, r9b
        jeq   r1, r2, 0x5de ; -> eo_word:
        jmp   0x639 ; -> operand_reject:

0x57b: ; eo_register:
        mov   r4, r82           ; TSTART
        mov   r5, r83           ; TLEN
        imm   r6, 0x2
        jlt   r5, r6, 0x639 ; -> operand_reject:
        imm   r6, 0x3
        jlt   r6, r5, 0x639 ; -> operand_reject:
        mov   r6, r4
        loadb r6, r6
        imm   r7, 0x72          ; 'r'
        jeq   r6, r7, 0x5cf ; -> er_parse:
        jmp   0x639 ; -> operand_reject:
0x5cf: ; er_parse:
        mov   r7, r9a            ; skip 'r'
        call  0x3c1 ; -> parse_hex_digits:
        write r6
        ret

0x5de: ; eo_word:
        mov   r4, r82
        mov   r5, r83
        mov   r6, r4
        loadb r6, r6
        mov   r7, r9d            ; '0'
        jeq   r6, r7, 0x601 ; -> eo_hex_word:
        jmp   0x639 ; -> operand_reject:
0x601: ; eo_hex_word:
        call  0x353 ; -> parse_hex_word:
        jmp   0x613 ; -> eo_emit:
0x613: ; eo_emit:
        mov   r3, r8c
        mov   r1, r8c
        add   r1, r9b          ; end of eight-byte NUM scratch
0x61c: ; eo_bloop:
        jeq   r3, r1, 0x638 ; -> eo_done:
        loadb r0, r3
        write r0
        add   r3, r9a
        jmp   0x61c ; -> eo_bloop:
0x638: ; eo_done:
        ret

0x639: ; operand_reject:
        imm   r0, 0x7
        halt  r0

; ---------------- dw_scan ----------------
; Emit one parsed Alpha word through the ordinary operand path.
0x645: ; dw_scan:
        mov   r98, r9b
        add   r85, r98
        jlt   r95, r85, 0x107 ; -> source_reject:
        call  0x540 ; -> emit_operand:
        ret

; NUL-terminated names in opcode order. Each name is followed by a
; NUL-terminated list of ASCII widths: 1 register byte or 8 word bytes.
0x660: ; mnemonic_table:
        dw 0x69003100746c6168 ; halt.1.i
        dw 0x6f6d003831006d6d ; mm.18.mo
        dw 0x6464610031310076 ; v.11.add
        dw 0x0062757300313100 ; .11.sub.
        dw 0x31006c756d003131 ; 11.mul.1
        dw 0x3131007669640031 ; 1.div.11
        dw 0x00313100646f6d00 ; .mod.11.
        dw 0x3131006264616f6c ; loadb.11
        dw 0x006265726f747300 ; .storeb.
        dw 0x0064616f6c003131 ; 11.load.
        dw 0x65726f7473003131 ; 11.store
        dw 0x00706d6a00313100 ; .11.jmp.
        dw 0x003831007a6a0038 ; 8.jz.18.
        dw 0x6a003831007a6e6a ; jnz.18.j
        dw 0x6a0038313100746c ; lt.118.j
        dw 0x7200383131007165 ; eq.118.r
        dw 0x7277003100646165 ; ead.1.wr
        dw 0x6163003100657469 ; ite.1.ca
        dw 0x7465720038006c6c ; ll.8.ret
        dw 0x0000000077640000 ; ..dw....
