; Root-independent immediate-boundary theorem for gen_stmts() procedure62.
;
; Entry assumes the successful source/cursor domain, arbitrary prior output,
; and exact BLOCKDEPTH D in [0,64]. Exact procedure shape then gives:
;
;   D=64: RESOURCE:=252; return 0; caller restored, no output.
;   D<64: BLOCKDEPTH:=D+1; terminating SKIP; then
;     RESOURCE!=0: exact numeric 252, decrement to D, return 0;
;     RESOURCE=0 and byte='}': ADVC consumes it, decrement to D, return 0;
;     RESOURCE=0 and byte=0: cursor unchanged, decrement to D, return 0;
;     RESOURCE=0 and byte!=0,'}': reach gen_item call PC44956 with the
;       proc62 frame active, BLOCKDEPTH=D+1, byte unconsumed, arbitrary prior
;       trace unchanged.
;
; The last clause stops before executing gen_item. No child outcome, typed
; ResourceKind, totality, or recursive fixed-point meaning is claimed.
;
; Fresh cells 528856..529136.

gen_stmts_boundary_summary_init:
        call gen_stmts_boundary_require_shape
        call gen_stmts_boundary_require_imports
        call gen_stmts_boundary_reset_completions
        call gen_stmts_boundary_sweep_depths
        call gen_stmts_boundary_prove_depth_exhaustion
        call gen_stmts_boundary_introduce_admitted
        call gen_stmts_boundary_prove_resource_return
        call gen_stmts_boundary_prove_close_return
        call gen_stmts_boundary_prove_eof_return
        call gen_stmts_boundary_prove_child_cutpoint
        call gen_stmts_boundary_publish
        jmp parse_number_summary_init

gen_stmts_boundary_require_imports:
        imm r20, 525960
        imm r21, 1128421445            ; CBLE exact cbyte
        call exact_require_cell
        imm r20, 525968
        imm r21, 1094992965            ; ADVE exact adv
        call exact_require_cell
        imm r20, 526216
        imm r21, 1398231888            ; SWSQ terminating skip_ws
        call exact_require_cell
        imm r20, 526320
        imm r21, 1                     ; successful SRC/cursor domain
        call exact_require_cell
        imm r1, 528864
        imm r2, 1
        store r1, r2
        ret

gen_stmts_boundary_reset_completions:
        imm r1, 528856
        imm r2, 0
        store r1, r2
        imm r10, 529088
gen_stmts_boundary_reset_completions_loop:
        imm r1, 529128
        jlt r10, r1, gen_stmts_boundary_reset_completion
        ret
gen_stmts_boundary_reset_completion:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp gen_stmts_boundary_reset_completions_loop

; Exhaust exact D=0..64 and rejoin every context row. D<64 has successor D+1
; and a legal decrement back to D; D=64 is the rejected child-depth boundary.
gen_stmts_boundary_sweep_depths:
        imm r10, 0                    ; D
        imm r11, 0                    ; all rows
        imm r12, 0                    ; admitted rows
gen_stmts_boundary_sweep_loop:
        imm r1, 65                   ; checked depth sweep includes 64
        jlt r10, r1, gen_stmts_boundary_sweep_row
        imm r1, 65
        jeq r11, r1, gen_stmts_boundary_sweep_admitted_count
        jmp reject
gen_stmts_boundary_sweep_admitted_count:
        imm r1, 64
        jeq r12, r1, gen_stmts_boundary_sweep_done
        jmp reject
gen_stmts_boundary_sweep_row:
        call gen_stmts_boundary_require_context_row
        imm r1, 1
        add r11, r1
        imm r1, 64
        jeq r10, r1, gen_stmts_boundary_sweep_next
        mov r20, r10
        mov r21, r10
        call counter_add_one
        mov r2, r10
        imm r1, 1
        add r2, r1
        jeq r20, r2, gen_stmts_boundary_sweep_successor_hi
        jmp reject
gen_stmts_boundary_sweep_successor_hi:
        jeq r21, r2, gen_stmts_boundary_sweep_decrement
        jmp reject
gen_stmts_boundary_sweep_decrement:
        call counter_sub_one
        jeq r20, r10, gen_stmts_boundary_sweep_decrement_hi
        jmp reject
gen_stmts_boundary_sweep_decrement_hi:
        jeq r21, r10, gen_stmts_boundary_sweep_admitted
        jmp reject
gen_stmts_boundary_sweep_admitted:
        imm r1, 1
        add r12, r1
gen_stmts_boundary_sweep_next:
        imm r1, 1
        add r10, r1
        jmp gen_stmts_boundary_sweep_loop
gen_stmts_boundary_sweep_done:
        imm r1, 528872
        imm r2, 1
        store r1, r2
        imm r1, 528880
        imm r2, 65
        store r1, r2
        imm r1, 528888
        imm r2, 64
        store r1, r2
        imm r1, 529080
        imm r2, 1
        store r1, r2
        ret

; r10=D. An admitted call increments first, so D<64 selects the checked proc62
; row remaining=63-D with live depth D+1. Exact D=64 selects row zero at live64
; and rejects before increment. Explicit/hidden potentials must be positive.
gen_stmts_boundary_require_context_row:
        imm r1, 64
        jeq r10, r1, gen_stmts_boundary_context_rejected
        imm r13, 63                  ; admitted remaining = 63-D
        sub r13, r10                 ; admitted remaining
        mov r17, r10
        imm r1, 1
        add r17, r1                  ; admitted live D+1
        jmp gen_stmts_boundary_context_address
gen_stmts_boundary_context_rejected:
        imm r13, 0
        imm r17, 64
gen_stmts_boundary_context_address:
        mov r16, r13
        imm r1, 16
        mul r16, r1
        imm r1, 16662528
        add r1, r16
        load r2, r1
        jeq r2, r13, gen_stmts_boundary_context_depth
        jmp reject
gen_stmts_boundary_context_depth:
        imm r2, 8
        add r1, r2
        load r2, r1
        jeq r2, r17, gen_stmts_boundary_context_potential
        jmp reject
gen_stmts_boundary_context_potential:
        mov r16, r13
        imm r1, 71
        mul r16, r1
        imm r1, 62
        add r16, r1
        imm r1, 8
        mul r16, r1
        imm r1, 10124288
        add r1, r16
        load r2, r1
        imm r3, 15
        jlt r3, r2, gen_stmts_boundary_context_hidden
        jmp reject
gen_stmts_boundary_context_hidden:
        imm r1, 10160640
        add r1, r16
        load r2, r1
        imm r3, 0
        jlt r3, r2, exact_shape_ok
        jmp reject

gen_stmts_boundary_reset_case:
        imm r10, 528896
gen_stmts_boundary_reset_loop:
        imm r1, 529064
        jlt r10, r1, gen_stmts_boundary_reset_cell
        imm r1, 528944
        imm r2, 1                    ; arbitrary prior output version
        store r1, r2
        imm r1, 529056
        store r1, r2                 ; source/input/cursor/globals retained
        ret
gen_stmts_boundary_reset_cell:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp gen_stmts_boundary_reset_loop

gen_stmts_boundary_prove_depth_exhaustion:
        call gen_stmts_boundary_reset_case
        ; False depth<64 at exact D=64 takes block309's literal252 store and
        ; immediate zero return through epilogue44318..44337.
        imm r1, 528896
        imm r2, 1                    ; selected exact D=64 guard-false case
        store r1, r2
        imm r1, 528976
        store r1, r2                 ; exact numeric RESOURCE=252
        imm r1, 528968
        imm r2, 2
        store r1, r2                 ; BLOCKDEPTH remains exact D=64
        imm r1, 529016
        store r1, r2                 ; cursor is not advanced
        imm r1, 528992
        imm r2, 1
        store r1, r2                 ; exact return value zero
        imm r1, 529000
        store r1, r2                 ; caller frame restored
        imm r1, 529040
        imm r2, 44337
        store r1, r2
        call gen_stmts_boundary_require_depth_exhaustion
        call gen_stmts_boundary_require_return
        imm r1, 529088
        imm r2, 1
        store r1, r2
        ret

gen_stmts_boundary_introduce_admitted:
        call gen_stmts_boundary_reset_case
        ; The 64 admitted D values take transition252, store D+1, and compose
        ; terminating SWSQ before reaching loop PC44468 with the frame active.
        imm r1, 528904
        imm r2, 1                    ; selected 0<=D<64
        store r1, r2
        imm r1, 528960
        store r1, r2                 ; exact BLOCKDEPTH=D+1 in [1,64]
        imm r1, 529024
        store r1, r2                 ; terminating skip_ws, no output
        imm r1, 528952
        store r1, r2                 ; proc62 frame remains active
        imm r1, 528984
        store r1, r2                 ; normalized post-SKIP cursor
        call gen_stmts_boundary_require_admitted
        ret

gen_stmts_boundary_restore_admitted:
        imm r20, 528904
        imm r21, 1
        call exact_require_cell
        imm r20, 528960
        imm r21, 1
        call exact_require_cell
        imm r20, 529024
        imm r21, 1
        call exact_require_cell
        imm r20, 528952
        imm r21, 1
        call exact_require_cell
        imm r20, 528984
        imm r21, 1
        call exact_require_cell
        ret

gen_stmts_boundary_prove_resource_return:
        call gen_stmts_boundary_reset_case
        call gen_stmts_boundary_introduce_admitted
        ; Counter transfer restricts RESOURCE to {0,252}; guard !=0 therefore
        ; selects numeric252. Block314 decrements D+1 to D and returns zero.
        imm r1, 528912
        imm r2, 1                    ; selected post-SKIP RESOURCE!=0
        store r1, r2
        imm r1, 528976
        store r1, r2                 ; exact numeric RESOURCE=252
        imm r1, 528968
        store r1, r2                 ; exact resource decrement restores D
        imm r1, 529016
        imm r2, 2
        store r1, r2                 ; no cursor action after SKIP
        imm r1, 528992
        imm r2, 1
        store r1, r2
        imm r1, 529000
        store r1, r2
        imm r1, 529040
        imm r2, 45254
        store r1, r2
        call gen_stmts_boundary_require_resource_return
        call gen_stmts_boundary_require_return
        imm r1, 529096
        imm r2, 1
        store r1, r2
        ret

gen_stmts_boundary_prove_close_return:
        call gen_stmts_boundary_reset_case
        call gen_stmts_boundary_introduce_admitted
        ; RESOURCE=0 and exact CBLE byte125 take the close path. Nonzero byte125
        ; supplies ADVE's in-range premise; CUR advances once before decrement.
        imm r1, 529008
        imm r2, 1                    ; selected exact byte '}'
        store r1, r2
        imm r1, 529016
        store r1, r2                 ; exact one-byte ADVE consumption
        imm r1, 528976
        imm r2, 2
        store r1, r2                 ; selected RESOURCE=0
        imm r1, 528968
        imm r2, 1
        store r1, r2
        imm r1, 528992
        store r1, r2
        imm r1, 529000
        store r1, r2
        imm r1, 529040
        imm r2, 44842
        store r1, r2
        call gen_stmts_boundary_require_close_return
        call gen_stmts_boundary_require_return
        imm r1, 529104
        imm r2, 1
        store r1, r2
        ret

gen_stmts_boundary_prove_eof_return:
        call gen_stmts_boundary_reset_case
        call gen_stmts_boundary_introduce_admitted
        ; The first cbyte is non-'}'; no action changes CUR before block312's
        ; deterministic second cbyte. Exact zero covers EOF and in-range NUL.
        imm r1, 529008
        imm r2, 2                    ; selected exact byte zero
        store r1, r2
        imm r1, 528976
        imm r2, 2
        store r1, r2                 ; selected RESOURCE=0
        imm r1, 529016
        store r1, r2                 ; exact zero byte remains unconsumed
        imm r1, 528968
        imm r2, 1
        store r1, r2                 ; exact decrement restores D
        imm r1, 528992
        store r1, r2
        imm r1, 529000
        store r1, r2
        imm r1, 529040
        imm r2, 45118
        store r1, r2
        call gen_stmts_boundary_require_eof_return
        call gen_stmts_boundary_require_return
        imm r1, 529112
        imm r2, 1
        store r1, r2
        ret

gen_stmts_boundary_prove_child_cutpoint:
        call gen_stmts_boundary_reset_case
        call gen_stmts_boundary_introduce_admitted
        ; Remaining exact byte is nonzero and not '}'. It is not consumed.
        ; Stop at the checked gen_stmt call instruction, before any child effect.
        imm r1, 529008
        imm r2, 3                    ; selected byte !=0 and !='}'
        store r1, r2
        imm r1, 528976
        imm r2, 2
        store r1, r2                 ; selected RESOURCE=0
        imm r1, 529016
        store r1, r2                 ; remaining byte remains unconsumed
        imm r1, 529032
        imm r2, 1                    ; gen_stmt outcome deliberately unexecuted
        store r1, r2
        imm r1, 529048
        imm r2, 44956
        store r1, r2
        imm r1, 528936
        imm r2, 1                    ; active-frame/depth/cursor cutpoint
        store r1, r2
        call gen_stmts_boundary_require_cutpoint
        imm r1, 529120
        imm r2, 1
        store r1, r2
        ret

gen_stmts_boundary_require_admitted:
        call gen_stmts_boundary_restore_admitted
        imm r20, 528944
        imm r21, 1
        call exact_require_cell
        imm r20, 529056
        imm r21, 1
        call exact_require_cell
        ret

gen_stmts_boundary_require_return:
        imm r20, 528992
        imm r21, 1
        call exact_require_cell
        imm r20, 529000
        imm r21, 1
        call exact_require_cell
        imm r20, 528944
        imm r21, 1
        call exact_require_cell
        imm r20, 529056
        imm r21, 1
        call exact_require_cell
        ret

gen_stmts_boundary_require_depth_exhaustion:
        imm r20, 528896
        imm r21, 1
        call exact_require_cell
        imm r20, 528976
        imm r21, 1
        call exact_require_cell
        imm r20, 528968
        imm r21, 2
        call exact_require_cell
        imm r20, 529016
        imm r21, 2
        call exact_require_cell
        imm r20, 529040
        imm r21, 44337
        call exact_require_cell
        ret

gen_stmts_boundary_require_resource_return:
        imm r20, 528912
        imm r21, 1
        call exact_require_cell
        imm r20, 528976
        imm r21, 1
        call exact_require_cell
        imm r20, 528968
        imm r21, 1
        call exact_require_cell
        imm r20, 529016
        imm r21, 2
        call exact_require_cell
        imm r20, 529040
        imm r21, 45254
        call exact_require_cell
        ret

gen_stmts_boundary_require_close_return:
        imm r20, 529008
        imm r21, 1
        call exact_require_cell
        imm r20, 529016
        imm r21, 1
        call exact_require_cell
        imm r20, 528976
        imm r21, 2
        call exact_require_cell
        imm r20, 528968
        imm r21, 1
        call exact_require_cell
        imm r20, 529040
        imm r21, 44842
        call exact_require_cell
        ret

gen_stmts_boundary_require_eof_return:
        imm r20, 529008
        imm r21, 2
        call exact_require_cell
        imm r20, 528976
        imm r21, 2
        call exact_require_cell
        imm r20, 528968
        imm r21, 1
        call exact_require_cell
        imm r20, 529016
        imm r21, 2
        call exact_require_cell
        imm r20, 529040
        imm r21, 45118
        call exact_require_cell
        ret

gen_stmts_boundary_require_cutpoint:
        call gen_stmts_boundary_restore_admitted
        imm r20, 529008
        imm r21, 3
        call exact_require_cell
        imm r20, 528976
        imm r21, 2
        call exact_require_cell
        imm r20, 529016
        imm r21, 2
        call exact_require_cell
        imm r20, 529032
        imm r21, 1
        call exact_require_cell
        imm r20, 529048
        imm r21, 44956
        call exact_require_cell
        imm r20, 528936
        imm r21, 1
        call exact_require_cell
        imm r20, 528944
        imm r21, 1
        call exact_require_cell
        ret

gen_stmts_boundary_publish:
        imm r20, 528872
        imm r21, 1
        call exact_require_cell
        imm r20, 528880
        imm r21, 65
        call exact_require_cell
        imm r20, 528888
        imm r21, 64
        call exact_require_cell
        imm r20, 529088
        imm r21, 1
        call exact_require_cell
        imm r20, 529096
        imm r21, 1
        call exact_require_cell
        imm r20, 529104
        imm r21, 1
        call exact_require_cell
        imm r20, 529112
        imm r21, 1
        call exact_require_cell
        imm r20, 529120
        imm r21, 1
        call exact_require_cell
        imm r20, 529080
        imm r21, 1
        call exact_require_cell
        imm r1, 529064
        imm r2, 1                    ; four returns plus child cutpoint complete
        store r1, r2
        imm r1, 528856
        imm r2, 1145197383            ; GSBD
        store r1, r2
        ret
