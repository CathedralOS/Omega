expression_call_control_require_region:
        imm r20, 21670
        imm r21, 23672
        imm r22, 20
        imm r23, 7
        imm r24, 23
        call expression_call_control_scan_region
        ret

; Exact decoded census for [r20,r21). r22/r23/r24 are call/ret/store totals.
; No gen_call block may contain halt, div/mod, byte-memory, or direct I/O.
expression_call_control_scan_region:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r28, r23
        mov r29, r24
        imm r10, 0
        imm r11, 0
        imm r12, 0
expression_call_control_scan_loop:
        jlt r25, r26, expression_call_control_scan_pc
        jeq r10, r27, expression_call_control_scan_rets
        jmp reject
expression_call_control_scan_rets:
        jeq r11, r28, expression_call_control_scan_stores
        jmp reject
expression_call_control_scan_stores:
        jeq r12, r29, expression_call_control_scan_done
        jmp reject
expression_call_control_scan_pc:
        imm r1, 4194304
        add r1, r25
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, expression_call_control_scan_start
        jmp expression_call_control_scan_next
expression_call_control_scan_start:
        imm r1, 2097152
        add r1, r25
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, expression_call_control_scan_call
        imm r3, 20
        jeq r2, r3, expression_call_control_scan_ret
        imm r3, 11
        jeq r2, r3, expression_call_control_scan_store
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 6
        jeq r2, r3, reject
        imm r3, 7
        jeq r2, r3, reject
        imm r3, 8
        jeq r2, r3, reject
        imm r3, 9
        jeq r2, r3, reject
        imm r3, 17
        jeq r2, r3, reject
        imm r3, 18
        jeq r2, r3, reject
        jmp expression_call_control_scan_next
expression_call_control_scan_call:
        imm r1, 1
        add r10, r1
        jmp expression_call_control_scan_next
expression_call_control_scan_ret:
        imm r1, 1
        add r11, r1
        jmp expression_call_control_scan_next
expression_call_control_scan_store:
        imm r1, 1
        add r12, r1
expression_call_control_scan_next:
        imm r1, 1
        add r25, r1
        jmp expression_call_control_scan_loop
expression_call_control_scan_done:
        ret
