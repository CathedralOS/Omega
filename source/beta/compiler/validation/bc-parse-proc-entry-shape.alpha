; Exact p68 entry shape, from procedure entry48993 through the PLOP cutpoint
; at49368.  This binds every selected row and exhausts every effect family.

parse_proc_shape_init:
        call parse_proc_require_proc
        call parse_proc_require_entry_block
        call parse_proc_require_entry_calls
        call parse_proc_require_entry_locals
        call parse_proc_require_entry_memory
        call parse_proc_require_entry_primitives
        call parse_proc_require_entry_pushes
        call parse_proc_require_entry_censuses
        call parse_proc_require_entry_decoded
        imm r1, 606016
        imm r2, 1213416784             ; PESH
        store r1, r2
        jmp parse_proc_entry_semantics_init

parse_proc_require_proc:
        imm r20, 7151616
        imm r21, 68
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 68
        imm r22, 5
        call transfer_require_cell
        imm r20, 68
        call call_bounds_frame_bytes
        imm r1, 48
        jeq r0, r1, exact_shape_ok
        jmp reject

parse_proc_require_entry_block:
        imm r20, 338
        imm r21, 48993                 ; exact p68 entry PC
        call exact_require_block_pc
        ret

; r20=event,r21=pc,r22=target,r23=continuation,r24=arity.
parse_proc_require_entry_call:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r20, r30
        imm r21, 338
        mov r22, r31
        mov r23, r34
        imm r24, 0
        mov r25, r32
        mov r26, r33
        call summary_require_call_site
        ret

parse_proc_require_entry_calls:
        imm r20, 577
        imm r21, 49080
        imm r22, 4277                  ; skip_ws
        imm r23, 49089
        imm r24, 0
        call parse_proc_require_entry_call
        imm r20, 578
        imm r21, 49089
        imm r22, 5217                  ; read_ident
        imm r23, 49098                 ; first RIDS continuation
        imm r24, 0
        call parse_proc_require_entry_call
        imm r20, 579
        imm r21, 49098
        imm r22, 4277
        imm r23, 49107
        imm r24, 0
        call parse_proc_require_entry_call
        imm r20, 580
        imm r21, 49107
        imm r22, 5217
        imm r23, 49116
        imm r24, 0
        call parse_proc_require_entry_call
        imm r20, 581
        imm r21, 49350
        imm r22, 17441                 ; expect
        imm r23, 49359
        imm r24, 1                     ; expect arity1
        call parse_proc_require_entry_call
        imm r20, 582
        imm r21, 49359
        imm r22, 4277
        imm r23, 49368
        imm r24, 0
        call parse_proc_require_entry_call
        ret

parse_proc_require_entry_locals:
        imm r20, 223
        imm r21, 338
        imm r22, 2
        imm r23, 0
        imm r24, 49129
        call transfer_require_local
        imm r20, 224
        imm r21, 338
        imm r22, 2
        imm r23, 1
        imm r24, 49161
        call transfer_require_local
        imm r20, 225
        imm r21, 338
        imm r22, 1
        imm r23, 0
        imm r24, 49206
        call transfer_require_local
        imm r20, 226
        imm r21, 338
        imm r22, 1
        imm r23, 1
        imm r24, 49270
        call transfer_require_local
        ret

parse_proc_require_entry_memory:
        imm r20, 83
        imm r21, 338
        imm r22, 2
        imm r23, 8
        imm r24, 49077
        call transfer_require_memory
        imm r20, 84
        imm r21, 338
        imm r22, 1
        imm r23, 8
        imm r24, 49126
        call transfer_require_memory
        imm r20, 85
        imm r21, 338
        imm r22, 1
        imm r23, 8
        imm r24, 49158
        call transfer_require_memory
        imm r20, 86
        imm r21, 338
        imm r22, 2
        imm r23, 8
        imm r24, 49241
        call transfer_require_memory
        imm r20, 87
        imm r21, 338
        imm r22, 2
        imm r23, 8
        imm r24, 49305
        call transfer_require_memory
        ret

parse_proc_require_entry_primitives:
        imm r20, 772
        imm r21, 338
        imm r22, 1
        imm r23, 2097128
        imm r24, 49025
        call transfer_require_primitive
        imm r20, 773
        imm r21, 338
        imm r22, 1
        imm r23, 0
        imm r24, 49051
        call transfer_require_primitive
        imm r20, 774
        imm r21, 338
        imm r22, 1
        imm r23, 2097120
        imm r24, 49116
        call transfer_require_primitive
        imm r20, 775
        imm r21, 338
        imm r22, 1
        imm r23, 2097112
        imm r24, 49148
        call transfer_require_primitive
        imm r20, 776
        imm r21, 338
        imm r22, 1
        imm r23, 2097096
        imm r24, 49180
        call transfer_require_primitive
        imm r20, 777
        imm r21, 338
        imm r22, 1
        imm r23, 2097088
        imm r24, 49244
        call transfer_require_primitive
        imm r20, 778
        imm r21, 338
        imm r22, 1
        imm r23, 40
        imm r24, 49308
        call transfer_require_primitive
        ret

parse_proc_require_entry_pushes:
        imm r20, 365
        imm r21, 338
        imm r23, 49318
        call exact_require_argument_push
        imm r20, 400
        imm r21, 338
        imm r23, 49035
        call exact_require_store_push
        imm r20, 401
        imm r21, 338
        imm r23, 49190
        call exact_require_store_push
        imm r20, 402
        imm r21, 338
        imm r23, 49254
        call exact_require_store_push
        ret

parse_proc_require_entry_censuses:
        imm r20, 338
        imm r21, 338
        imm r22, 223
        imm r23, 227
        imm r24, 83
        imm r25, 88
        imm r26, 274
        imm r27, 274
        imm r28, 577
        imm r29, 583
        call exact_require_effect_census
        imm r20, 338
        imm r21, 338
        imm r22, 772
        imm r23, 779
        imm r24, 224
        imm r25, 224
        imm r26, 365
        imm r27, 366
        imm r28, 400
        imm r29, 403
        call summary_require_expr_census
        ret

parse_proc_require_entry_decoded:
        imm r20, 48993
        imm r21, 49368
        imm r22, 6
        imm r23, 0
        imm r24, 10
        call exact_quiet_scan_region
        ret
