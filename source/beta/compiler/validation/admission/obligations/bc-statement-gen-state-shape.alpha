; Exact source/artifact shape for gen_state (procedure65).
; The canonical procedure inventory owns its total block span and partition.

statement_gen_state_require_shape:
        call statement_gen_state_require_proc
        call statement_gen_state_require_events
        call statement_gen_state_require_data
        call statement_gen_state_require_censuses
        call statement_gen_state_require_decoded
        ret

statement_gen_state_require_proc:
        imm r20, 65
        imm r21, 0
        imm r22, 2
        imm r23, 24
        call exact_require_proc_frame_identity
        jmp exact_shape_ok

; r21=block,r22=arity,r23=target procedure identity.
statement_gen_state_require_call:
        mov r24, r23
        imm r23, 0
        imm r20, 65
        call summary_require_call_fallthrough_identity
        ret

; r21=block,r22=literal bytes,r23=decoded length.
statement_gen_state_require_emit:
        imm r20, 65
        call exact_unique_emit_event_identity
        mov r14, r0
        mov r10, r1
        call check_emit_at_call
        ret

statement_gen_state_require_events:
        imm r21, 317
        imm r22, 0
        imm r23, 10                   ; skip_ws
        call statement_gen_state_require_call
        imm r21, 317
        imm r22, 0
        imm r23, 12                   ; read_ident
        call statement_gen_state_require_call
        imm r21, 317
        imm r22, 2
        imm r23, 64                   ; emit_state_label
        call statement_gen_state_require_call
        imm r21, 317
        imm r22, statement_gen_state_literal_label_suffix
        imm r23, 2
        call statement_gen_state_require_emit
        imm r21, 317
        imm r22, 0
        imm r23, 63                   ; gen_block
        call statement_gen_state_require_call
        imm r21, 317
        imm r20, 65
        call exact_require_event_epilogue
        imm r20, 66                   ; gen_to identifies synthetic return
        call exact_require_preentry_epilogue
        ret

statement_gen_state_require_data:
        ; noff/nlen stores then argument loads.
        imm r20, 203
        imm r21, 317
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 204
        imm r21, 317
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 205
        imm r21, 317
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 206
        imm r21, 317
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 76
        imm r21, 317
        imm r22, 1
        imm r23, 8
        call exact_memory_identity_pc
        imm r20, 77
        imm r21, 317
        imm r22, 1
        imm r23, 8
        call exact_memory_identity_pc
        imm r20, 730
        imm r21, 317
        imm r22, 1
        imm r23, 2097120
        call exact_primitive_identity_pc
        imm r20, 731
        imm r21, 317
        imm r22, 1
        imm r23, 2097112
        call exact_primitive_identity_pc
        imm r20, 732
        imm r21, 317
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 351
        imm r21, 317
        call exact_require_argument_push_identity
        imm r20, 352
        imm r21, 317
        call exact_require_argument_push_identity
        ret

statement_gen_state_require_censuses:
        imm r20, 317
        imm r21, 317
        imm r22, 203
        imm r23, 207
        imm r24, 76
        imm r25, 78
        imm r26, 258
        imm r27, 258
        imm r28, 515
        imm r29, 521
        call exact_require_effect_census
        imm r20, 317
        imm r21, 317
        imm r22, 730
        imm r23, 733
        imm r24, 215
        imm r25, 215
        imm r26, 351
        imm r27, 353
        imm r28, 399
        imm r29, 399
        call summary_require_expr_census
        ret

statement_gen_state_require_decoded:
        imm r20, 65
        call exact_proc_entry_r20
        imm r21, 66
        call exact_proc_entry_r21
        imm r22, 5
        imm r23, 2
        imm r24, 5
        call exact_quiet_scan_region
        ret

statement_gen_state_literal_label_suffix:
        db ":\n"
