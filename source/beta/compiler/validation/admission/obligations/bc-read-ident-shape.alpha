; Exact source/artifact shape for read_ident.
;
; The canonical procedure inventory owns procedure 12's total block span and
; partition. This module owns only its three transitions, calls,
; return/epilogues, fixed-global word accesses, expression primitives, split
; push families, frame, and decoded-region census. The adjacent semantic module
; owns termination and the identifier-slice relation.

read_ident_require_shape:
        ; No parameters or locals: only the saved-frame word is live.
        imm r20, 12
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call exact_require_proc_frame_identity

        imm r20, 43
        imm r21, 46
        imm r22, 12
        call exact_require_proc_blocks
        call read_ident_require_transitions
        call read_ident_require_events
        call read_ident_require_memory
        call read_ident_require_primitives
        call read_ident_require_pushes
        call read_ident_require_censuses
        ret

read_ident_require_transitions:
        ; loop: alnum -> body, otherwise done; body returns to loop.
        imm r20, 33
        imm r21, 44
        imm r22, 1
        imm r23, 45
        call exact_transition_identity_pc ; checked alnum-true guard
        imm r20, 34
        imm r21, 44
        imm r22, 0
        imm r23, 46
        call exact_transition_identity_pc
        imm r20, 35
        imm r21, 45
        imm r22, 0
        imm r23, 44
        call exact_transition_identity_pc
        ret

; Source block/arity/target procedure in r21..r23.
read_ident_require_call:
        mov r24, r23
        imm r23, 0
        imm r20, 12                    ; read_ident owning procedure identity
        call summary_require_call_fallthrough_identity
        ret

read_ident_require_events:
        ; Lexical rows 33/34 are inverted in PC order: source nesting records
        ; is_alnum before its cbyte argument.
        imm r21, 44
        imm r22, 0
        imm r23, 4                     ; cbyte procedure identity
        call read_ident_require_call
        imm r21, 44
        imm r22, 1
        imm r23, 8                     ; is_alnum procedure identity
        call read_ident_require_call
        imm r21, 45
        imm r22, 0
        imm r23, 5                     ; adv procedure identity
        call read_ident_require_call

        imm r20, 12
        imm r21, 46
        call exact_require_event_epilogue
        imm r20, 13                    ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

read_ident_require_memory:
        ; IDOFF=CUR at entry; IDLEN=CUR-IDOFF on exit.  Row order follows
        ; lexical source ownership rather than emitted PC order.
        imm r20, 16
        imm r21, 43
        call exact_memory_store_pc    ; IDOFF = CUR
        imm r20, 17
        imm r21, 43
        imm r25, 87
        imm r26, 2097144             ; CUR
        call exact_memory_load_pc
        imm r20, 18
        imm r21, 46
        call exact_memory_store_pc    ; IDLEN = CUR - IDOFF
        imm r20, 19
        imm r21, 46
        imm r25, 91
        imm r26, 2097144             ; CUR
        call exact_memory_load_pc
        imm r20, 20
        imm r21, 46
        imm r25, 93
        imm r26, 2097120             ; IDOFF
        call exact_memory_load_pc
        ret

read_ident_require_primitives:
        ; Stable row/block/kind/value-or-opcode identities.
        imm r20, 86
        imm r21, 43
        imm r22, 1
        imm r23, 2097120             ; checked IDOFF address
        call exact_primitive_identity_pc
        imm r20, 87
        imm r21, 43
        imm r22, 1
        imm r23, 2097144             ; CUR address
        call exact_primitive_identity_pc
        imm r20, 88
        imm r21, 44
        imm r22, 3
        imm r23, 10                  ; alnum result == 1
        call exact_primitive_identity_pc
        imm r20, 89
        imm r21, 44
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 90
        imm r21, 46
        imm r22, 1
        imm r23, 2097112             ; checked IDLEN address
        call exact_primitive_identity_pc
        imm r20, 91
        imm r21, 46
        imm r22, 1
        imm r23, 2097144
        call exact_primitive_identity_pc
        imm r20, 92
        imm r21, 46
        imm r22, 2
        imm r23, 4                   ; checked CUR-IDOFF subtraction
        call exact_primitive_identity_pc
        imm r20, 93
        imm r21, 46
        imm r22, 1
        imm r23, 2097120
        call exact_primitive_identity_pc
        imm r20, 94
        imm r21, 46
        imm r22, 1
        imm r23, 0                   ; return zero
        call exact_primitive_identity_pc
        ret

read_ident_require_pushes:
        imm r20, 25
        imm r21, 44
        call exact_require_binary_push_identity
        imm r20, 26
        imm r21, 46
        call exact_require_binary_push_identity
        imm r20, 241
        imm r21, 44
        call exact_require_argument_push_identity               ; checked cbyte-to-alnum argument
        imm r20, 381
        imm r21, 43
        call exact_require_store_push_identity
        imm r20, 382
        imm r21, 46
        call exact_require_store_push_identity
        ret

read_ident_require_censuses:
        ; No local slots occur between the surrounding rows 32 and 33.
        imm r20, 43
        imm r21, 46
        imm r22, 33
        imm r23, 33
        imm r24, 16
        imm r25, 21                  ; checked exclusive read_ident memory row
        imm r26, 33
        imm r27, 36
        imm r28, 33
        imm r29, 37                  ; checked exclusive read_ident event row
        call exact_require_effect_census

        imm r20, 43
        imm r21, 46
        imm r22, 86
        imm r23, 95                  ; checked exclusive read_ident primitive row
        imm r24, 25
        imm r25, 27
        imm r26, 241
        imm r27, 242
        imm r28, 381
        imm r29, 383
        call summary_require_expr_census

        imm r20, 12                    ; read_ident procedure identity
        call exact_proc_entry_r20
        imm r21, 13                    ; id_char procedure identity / end
        call exact_proc_entry_r21
        imm r22, 3
        imm r23, 2
        call skip_scan_call_region
        ret
