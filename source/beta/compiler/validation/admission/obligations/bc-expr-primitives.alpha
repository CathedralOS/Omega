; Literal, arithmetic, and comparison primitive custody for the whole-bc BCT8
; checker. The common scanner records source-order literals and operators; the
; untrusted witness supplies only their Alpha locations.
;
; Source metadata: block 8388608, kind 8396800, value 8404992.
; Witness PCs: 8413184. Per-tape-byte owner map: 8421376. Independently
; classified compiler-synthetic literal sites: 8912896.

; r6 = kind (1 literal, 2 arithmetic), r7 = value/opcode.
add_expr_primitive:
        imm r1, 524696
        load r2, r1
        imm r3, 1024
        jlt r2, r3, add_expr_primitive_room
        jmp reject
add_expr_primitive_room:
        mov r4, r2
        imm r5, 8
        mul r4, r5
        imm r5, 524352
        load r9, r5
        imm r5, 8388608
        add r5, r4
        store r5, r9                    ; source block
        imm r5, 8396800
        add r5, r4
        store r5, r6                    ; primitive kind
        imm r5, 8404992
        add r5, r4
        store r5, r7                    ; literal value / Alpha opcode
        imm r3, 1
        add r2, r3
        imm r1, 524696
        store r1, r2
        imm r1, 1
        jeq r6, r1, count_expr_literal
        imm r1, 2
        jeq r6, r1, count_expr_arithmetic
        imm r1, 3
        jeq r6, r1, count_expr_comparison
        jmp reject
count_expr_literal:
        imm r1, 524704
        jmp increment_expr_kind
count_expr_arithmetic:
        imm r1, 524712
        jmp increment_expr_kind
count_expr_comparison:
        imm r1, 524744
increment_expr_kind:
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

; Cursor is at the first decimal digit. Parse with Beta's wrapping word
; arithmetic, leaving the cursor immediately after the literal.
record_decimal_primitive:
        imm r7, 0
record_decimal_loop:
        call current_byte
        mov r8, r0
        imm r1, 48
        jlt r8, r1, record_decimal_done
        imm r1, 58
        jlt r8, r1, record_decimal_digit
        jmp record_decimal_done
record_decimal_digit:
        imm r1, 10
        mul r7, r1
        imm r1, 48
        sub r8, r1
        add r7, r8
        call advance_one
        jmp record_decimal_loop
record_decimal_done:
        imm r6, 1
        call add_expr_primitive
        ret

; Cursor is at the opening quote. Decode exactly the seven Beta escapes.
record_char_primitive:
        call advance_one
        call current_byte
        imm r1, 0
        jlt r0, r1, reject
        imm r1, 92
        jeq r0, r1, record_char_escape
        mov r7, r0
        call advance_one
        jmp record_char_close
record_char_escape:
        call advance_one
        call current_byte
        imm r1, 110
        jeq r0, r1, record_char_escape_n
        imm r1, 116
        jeq r0, r1, record_char_escape_t
        imm r1, 114
        jeq r0, r1, record_char_escape_r
        imm r1, 48
        jeq r0, r1, record_char_escape_zero
        imm r1, 92
        jeq r0, r1, record_char_escape_backslash
        imm r1, 39
        jeq r0, r1, record_char_escape_quote
        imm r1, 34
        jeq r0, r1, record_char_escape_double_quote
        jmp reject
record_char_escape_n:
        imm r7, 10
        jmp record_char_escape_done
record_char_escape_t:
        imm r7, 9
        jmp record_char_escape_done
record_char_escape_r:
        imm r7, 13
        jmp record_char_escape_done
record_char_escape_zero:
        imm r7, 0
        jmp record_char_escape_done
record_char_escape_backslash:
        imm r7, 92
        jmp record_char_escape_done
record_char_escape_quote:
        imm r7, 39
        jmp record_char_escape_done
record_char_escape_double_quote:
        imm r7, 34
record_char_escape_done:
        call advance_one
record_char_close:
        call current_byte
        imm r1, 39
        jeq r0, r1, record_char_finish
        jmp reject
record_char_finish:
        call advance_one
        imm r6, 1
        call add_expr_primitive
        ret

; r7 is the exact Alpha opcode corresponding to the source operator.
record_arithmetic_primitive:
        call advance_one
        imm r6, 2
        call add_expr_primitive
        ret

; Comparison codes follow bc.beta's six semantic variants plus eight:
; 8 <, 9 >, 10 ==, 11 !=, 12 <=, 13 >=.
record_comparison_lt:
        call advance_one
        call current_byte
        imm r1, 61
        jeq r0, r1, record_comparison_le
        imm r7, 8
        jmp record_comparison_finish
record_comparison_le:
        call advance_one
        imm r7, 12
        jmp record_comparison_finish
record_comparison_gt:
        call advance_one
        call current_byte
        imm r1, 61
        jeq r0, r1, record_comparison_ge
        imm r7, 9
        jmp record_comparison_finish
record_comparison_ge:
        call advance_one
        imm r7, 13
        jmp record_comparison_finish
record_comparison_eq:
        call advance_one
        call current_byte
        imm r1, 61
        jeq r0, r1, record_comparison_eq_pair
        ; A single '=' is assignment, not an expression primitive.
        ret
record_comparison_eq_pair:
        call advance_one
        imm r7, 10
        jmp record_comparison_finish
record_comparison_ne:
        call advance_one
        call current_byte
        imm r1, 61
        jeq r0, r1, record_comparison_ne_pair
        jmp reject
record_comparison_ne_pair:
        call advance_one
        imm r7, 11
record_comparison_finish:
        imm r6, 3
        call add_expr_primitive
        ret

read_expr_primitive_pcs_init:
        imm r10, 0
read_expr_primitive_pc:
        imm r1, 829
        jlt r10, r1, read_expr_primitive_pc_one
        jmp read_stack_push_pcs_init
read_expr_primitive_pc_one:
        call read_u32
        mov r14, r0
        imm r1, 524296
        load r2, r1
        jlt r14, r2, expr_primitive_pc_covered
        jmp reject
expr_primitive_pc_covered:
        imm r1, 4194304
        add r1, r14
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, expr_primitive_pc_block
        jmp reject
expr_primitive_pc_block:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 8388608
        add r1, r12
        load r4, r1
        mov r5, r4
        imm r1, 8
        mul r5, r1
        imm r1, 3235840
        add r1, r5
        load r6, r1
        jlt r14, r6, reject
        imm r1, 1
        add r4, r1
        imm r1, 359
        jlt r4, r1, expr_primitive_pc_next_block
        imm r1, 524296
        load r7, r1
        jmp expr_primitive_pc_end_ready
expr_primitive_pc_next_block:
        mov r5, r4
        imm r1, 8
        mul r5, r1
        imm r1, 3235840
        add r1, r5
        load r7, r1
expr_primitive_pc_end_ready:
        jlt r14, r7, expr_primitive_pc_store
        jmp reject
expr_primitive_pc_store:
        imm r1, 8413184
        add r1, r12
        store r1, r14
        imm r1, 1
        add r10, r1
        jmp read_expr_primitive_pc

validate_expr_primitives_init:
        imm r10, 0
validate_expr_primitive_loop:
        imm r1, 829
        jlt r10, r1, validate_expr_primitive_one
        jmp scan_expr_artifact_init
validate_expr_primitive_one:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 8413184
        add r1, r12
        load r14, r1
        imm r1, 8421376
        add r1, r14
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, own_expr_primitive
        jmp reject
own_expr_primitive:
        imm r2, 1
        storeb r1, r2
        imm r1, 8396800
        add r1, r12
        load r8, r1
        imm r1, 8404992
        add r1, r12
        load r9, r1
        imm r1, 1
        jeq r8, r1, validate_literal_primitive
        imm r1, 2
        jeq r8, r1, validate_arithmetic_primitive
        imm r1, 3
        jeq r8, r1, validate_comparison_primitive
        jmp reject

validate_literal_primitive:
        mov r20, r14
        imm r21, 1
        call require_tape_byte
        mov r20, r14
        imm r1, 1
        add r20, r1
        imm r21, 0
        call require_tape_byte
        mov r20, r14
        imm r1, 2
        add r20, r1
        mov r21, r9
        call require_tape_word
        jmp validate_expr_primitive_next

validate_arithmetic_primitive:
        call classify_expr_binary_macro
        imm r1, 1
        jeq r0, r1, validate_arithmetic_opcode
        jmp reject
validate_arithmetic_opcode:
        mov r20, r14
        imm r1, 19
        add r20, r1
        mov r21, r9
        call require_tape_byte
        jmp validate_expr_primitive_next

validate_comparison_primitive:
        mov r11, r9                    ; preserve source comparison code
        call classify_expr_binary_macro
        imm r1, 2
        jeq r0, r1, select_comparison_shape
        jmp reject
select_comparison_shape:
        imm r1, 8
        jeq r11, r1, comparison_shape_lt
        imm r1, 9
        jeq r11, r1, comparison_shape_gt
        imm r1, 10
        jeq r11, r1, comparison_shape_eq
        imm r1, 11
        jeq r11, r1, comparison_shape_ne
        imm r1, 12
        jeq r11, r1, comparison_shape_le
        imm r1, 13
        jeq r11, r1, comparison_shape_ge
        jmp reject
comparison_shape_lt:
        imm r4, 15
        imm r5, 0
        imm r6, 1
        imm r7, 0
        imm r8, 1
        jmp validate_comparison_shape
comparison_shape_gt:
        imm r4, 15
        imm r5, 1
        imm r6, 0
        imm r7, 0
        imm r8, 1
        jmp validate_comparison_shape
comparison_shape_eq:
        imm r4, 16
        imm r5, 0
        imm r6, 1
        imm r7, 0
        imm r8, 1
        jmp validate_comparison_shape
comparison_shape_ne:
        imm r4, 16
        imm r5, 0
        imm r6, 1
        imm r7, 1
        imm r8, 0
        jmp validate_comparison_shape
comparison_shape_le:
        imm r4, 15
        imm r5, 1
        imm r6, 0
        imm r7, 1
        imm r8, 0
        jmp validate_comparison_shape
comparison_shape_ge:
        imm r4, 15
        imm r5, 0
        imm r6, 1
        imm r7, 1
        imm r8, 0
validate_comparison_shape:
        mov r20, r14
        imm r1, 19
        add r20, r1
        mov r21, r4
        call require_tape_byte
        mov r20, r14
        imm r1, 20
        add r20, r1
        mov r21, r5
        call require_tape_byte
        mov r20, r14
        imm r1, 21
        add r20, r1
        mov r21, r6
        call require_tape_byte
        mov r20, r14
        imm r1, 22
        add r20, r1
        mov r21, r14
        imm r1, 49
        add r21, r1
        call require_tape_word
        mov r20, r14
        imm r1, 30
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r14
        imm r1, 31
        add r20, r1
        imm r21, 0
        call require_tape_byte
        mov r20, r14
        imm r1, 32
        add r20, r1
        mov r21, r7
        call require_tape_word
        mov r20, r14
        imm r1, 40
        add r20, r1
        imm r21, 12
        call require_tape_byte
        mov r20, r14
        imm r1, 41
        add r20, r1
        mov r21, r14
        imm r1, 59
        add r21, r1
        call require_tape_word
        mov r20, r14
        imm r1, 49
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r14
        imm r1, 50
        add r20, r1
        imm r21, 0
        call require_tape_byte
        mov r20, r14
        imm r1, 51
        add r20, r1
        mov r21, r8
        call require_tape_word

validate_expr_primitive_next:
        imm r1, 1
        add r10, r1
        jmp validate_expr_primitive_loop

; Independently inventory every artifact instruction start after validating the
; suggested source sites. Comparison lowering creates two compiler-synthetic
; `imm r0,0/1` instructions; recognize their enclosing macro below and reserve
; those PCs. Every other `imm r0` must have a literal owner, and every exact
; arithmetic combine macro must have an arithmetic owner. This prevents a
; witness from substituting a same-valued synthetic immediate.
scan_expr_artifact_init:
        imm r10, 0
scan_expr_artifact_loop:
        imm r1, 524296
        load r2, r1
        jlt r10, r2, scan_expr_artifact_pc
        jmp scan_expr_artifact_counts
scan_expr_artifact_pc:
        imm r1, 4194304
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, scan_expr_artifact_start
        jmp scan_expr_artifact_next
scan_expr_artifact_start:
        imm r1, 2097152
        add r1, r10
        loadb r2, r1
        imm r3, 2
        jeq r2, r3, scan_expr_maybe_binary
        imm r3, 1
        jeq r2, r3, scan_expr_maybe_literal
        jmp scan_expr_artifact_next

scan_expr_maybe_binary:
        mov r14, r10
        call classify_expr_binary_macro
        imm r1, 1
        jeq r0, r1, scan_expr_arithmetic_macro
        imm r1, 2
        jeq r0, r1, scan_expr_comparison_macro
        jmp scan_expr_artifact_next
scan_expr_arithmetic_macro:
        imm r1, 8421376
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, count_artifact_arithmetic
        jmp reject
count_artifact_arithmetic:
        imm r1, 524736
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        jmp scan_expr_artifact_next
scan_expr_comparison_macro:
        imm r1, 8421376
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, reserve_comparison_results
        jmp reject
reserve_comparison_results:
        mov r2, r10
        imm r1, 30
        add r2, r1
        imm r1, 8912896
        add r1, r2
        imm r3, 1
        storeb r1, r3
        mov r2, r10
        imm r1, 49
        add r2, r1
        imm r1, 8912896
        add r1, r2
        storeb r1, r3
        imm r1, 524720
        load r2, r1
        add r2, r3
        store r1, r2
        jmp scan_expr_artifact_next

scan_expr_maybe_literal:
        ; An imm instruction is ten bytes, so its register byte is covered.
        imm r1, 2097153
        add r1, r10
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, scan_expr_literal_candidate
        jmp scan_expr_artifact_next
scan_expr_literal_candidate:
        imm r1, 8912896
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, scan_expr_artifact_next
        imm r1, 8421376
        add r1, r10
        loadb r2, r1
        jeq r2, r3, count_artifact_literal
        jmp reject
count_artifact_literal:
        imm r1, 524728
        load r2, r1
        add r2, r3
        store r1, r2

scan_expr_artifact_next:
        imm r1, 1
        add r10, r1
        jmp scan_expr_artifact_loop

scan_expr_artifact_counts:
        imm r1, 524720
        load r2, r1
        imm r3, 182
        jeq r2, r3, scan_expr_artifact_literal_count
        jmp reject
scan_expr_artifact_literal_count:
        imm r1, 524728
        load r2, r1
        imm r3, 592
        jeq r2, r3, scan_expr_artifact_arithmetic_count
        jmp reject
scan_expr_artifact_arithmetic_count:
        imm r1, 524736
        load r2, r1
        imm r3, 55
        jeq r2, r3, validate_stack_pushes_init
        jmp reject

; Input r14 is an instruction start. Return 1 for the exact common arithmetic
; combine prefix, 2 for the exact comparison-materialization layout, or 0.
classify_expr_binary_macro:
        mov r20, r14
        imm r1, 22
        add r20, r1
        imm r1, 524296
        load r2, r1
        jlt r2, r20, classify_expr_binary_none
        mov r20, r14
        imm r21, 2
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, classify_expr_binary_b1
        jmp classify_expr_binary_none
classify_expr_binary_b1:
        mov r20, r14
        imm r1, 1
        add r20, r1
        imm r21, 1
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, classify_expr_binary_b2
        jmp classify_expr_binary_none
classify_expr_binary_b2:
        mov r20, r14
        imm r1, 2
        add r20, r1
        imm r21, 0
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, classify_expr_binary_pop
        jmp classify_expr_binary_none
classify_expr_binary_pop:
        mov r20, r14
        imm r1, 3
        add r20, r1
        imm r21, 0
        call exact_match_pop
        imm r1, 1
        jeq r0, r1, classify_expr_binary_opcode
        jmp classify_expr_binary_none
classify_expr_binary_opcode:
        imm r1, 2097171
        add r1, r14
        loadb r8, r1
        imm r1, 3
        jeq r8, r1, classify_expr_binary_arithmetic_operands
        imm r1, 4
        jeq r8, r1, classify_expr_binary_arithmetic_operands
        imm r1, 5
        jeq r8, r1, classify_expr_binary_arithmetic_operands
        imm r1, 6
        jeq r8, r1, classify_expr_binary_arithmetic_operands
        imm r1, 7
        jeq r8, r1, classify_expr_binary_arithmetic_operands
        imm r1, 15
        jeq r8, r1, classify_expr_binary_comparison
        imm r1, 16
        jeq r8, r1, classify_expr_binary_comparison
        jmp classify_expr_binary_none
classify_expr_binary_arithmetic_operands:
        imm r20, 20
        imm r21, 0
        call expr_tape_byte_matches
        imm r1, 1
        jeq r0, r1, classify_expr_binary_arithmetic_rhs
        jmp classify_expr_binary_none
classify_expr_binary_arithmetic_rhs:
        imm r20, 21
        imm r21, 1
        call expr_tape_byte_matches
        imm r1, 1
        jeq r0, r1, classify_expr_binary_arithmetic
        jmp classify_expr_binary_none
classify_expr_binary_arithmetic:
        imm r0, 1
        ret

classify_expr_binary_comparison:
        mov r20, r14
        imm r1, 59
        add r20, r1
        imm r1, 524296
        load r2, r1
        jlt r2, r20, classify_expr_binary_none
        ; The branch operands are either r0,r1 or r1,r0.
        imm r1, 2097172
        add r1, r14
        loadb r8, r1
        imm r1, 2097173
        add r1, r14
        loadb r9, r1
        imm r1, 0
        jeq r8, r1, classify_expr_comparison_lhs_zero
        imm r1, 1
        jeq r8, r1, classify_expr_comparison_lhs_one
        jmp classify_expr_binary_none
classify_expr_comparison_lhs_zero:
        imm r1, 1
        jeq r9, r1, classify_expr_comparison_results
        jmp classify_expr_binary_none
classify_expr_comparison_lhs_one:
        imm r1, 0
        jeq r9, r1, classify_expr_comparison_results
        jmp classify_expr_binary_none
classify_expr_comparison_results:
        imm r20, 30
        imm r21, 1
        call expr_tape_byte_matches
        imm r1, 1
        jeq r0, r1, classify_expr_comparison_result_reg1
        jmp classify_expr_binary_none
classify_expr_comparison_result_reg1:
        imm r20, 31
        imm r21, 0
        call expr_tape_byte_matches
        imm r1, 1
        jeq r0, r1, classify_expr_comparison_jump
        jmp classify_expr_binary_none
classify_expr_comparison_jump:
        imm r20, 40
        imm r21, 12
        call expr_tape_byte_matches
        imm r1, 1
        jeq r0, r1, classify_expr_comparison_result2
        jmp classify_expr_binary_none
classify_expr_comparison_result2:
        imm r20, 49
        imm r21, 1
        call expr_tape_byte_matches
        imm r1, 1
        jeq r0, r1, classify_expr_comparison_result_reg2
        jmp classify_expr_binary_none
classify_expr_comparison_result_reg2:
        imm r20, 50
        imm r21, 0
        call expr_tape_byte_matches
        imm r1, 1
        jeq r0, r1, classify_expr_comparison_values
        jmp classify_expr_binary_none
classify_expr_comparison_values:
        imm r1, 2097184
        add r1, r14
        load r8, r1                    ; first result at base + 32
        imm r1, 2097203
        add r1, r14
        load r9, r1                    ; second result at base + 51
        imm r1, 0
        jeq r8, r1, classify_expr_comparison_first_zero
        imm r1, 1
        jeq r8, r1, classify_expr_comparison_first_one
        jmp classify_expr_binary_none
classify_expr_comparison_first_zero:
        imm r1, 1
        jeq r9, r1, classify_expr_binary_comparison_found
        jmp classify_expr_binary_none
classify_expr_comparison_first_one:
        imm r1, 0
        jeq r9, r1, classify_expr_binary_comparison_found
        jmp classify_expr_binary_none
classify_expr_binary_comparison_found:
        imm r0, 2
        ret
classify_expr_binary_none:
        imm r0, 0
        ret

; r14 = macro base, r20 = byte/word offset, r21 = expected; output r0 bool.
expr_tape_byte_matches:
        imm r1, 2097152
        add r1, r14
        add r1, r20
        loadb r2, r1
        jeq r2, r21, expr_tape_matches
        imm r0, 0
        ret
expr_tape_word_matches:
        imm r1, 2097152
        add r1, r14
        add r1, r20
        load r2, r1
        jeq r2, r21, expr_tape_matches
        imm r0, 0
        ret
expr_tape_matches:
        imm r0, 1
        ret

; r0 is an independently validated compiler-synthetic `imm r0` site.
mark_expr_synthetic_literal:
        imm r1, 8912896
        add r1, r0
        imm r2, 1
        storeb r1, r2
        ret
