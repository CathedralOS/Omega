; Relational summary for the synthesized __write_str helper.
;
; For any natural len and admitted, nonwrapping memory interval [p,p+len), a
; valid hidden-return entry with r0=p and r1=len executes the loop with invariant
;
;   0 <= k <= len
;   r0 = p+k, r1 = len-k
;   appended output = M_entry[p:p+k]
;   memory and input cursor unchanged
;
; and rank len-k.  The zero edge returns; the positive edge loads exactly
; M[p+k], writes it, advances p+k, decrements the rank by one, and closes the
; invariant by capture-avoiding k+1 -> k renaming.  Thus the helper terminates
; after 8*len+3 instructions, appends exactly M_entry[p:p+len], returns to the
; saved continuation with r0=p+len and r1=r3=0, and preserves r4..r15.
;
; This phase also scans all 613 exact source-event rows and instantiates the
; conditional summary at every kind-four emit macro.  Earlier effect custody
; already proves each row's decoded source literal equals its jump-skipped tape
; slice; this phase rejoins its p/len/call equations, proves the interval is in
; the exact tape, and requires exhaustive totals of 113 clauses / 791 bytes.
; It does not claim those events are reached or globally order their traces.
;
; Fresh symbolic cells:
;   k/pointer/remaining/output tags  525760/525768/525776/525784
;   loaded-byte kind/index           525792/525800
;   rank tag                         525808
;   public theorem token             525816
;   input/memory/range tokens        525824/525832/525840
;   zero/step clause tokens          525848/525856
;   branch tag                       525864 (1=zero,2=positive)
;   cost coefficient/intercept       525872/525880
;
; Index tag 1=K and 2=K+1. Pointer tags mean P+index; remaining tags mean
; LEN-index; output tags mean the exact M[P:P+index] suffix.

write_str_summary_init:
        call exact_require_write_str_extent
        call write_str_prove_schema
        call write_str_instantiate_emits
        jmp bc_post_write_str

; ---- Executable symbolic induction -----------------------------------

write_str_prove_schema:
        imm r1, 525816
        imm r2, 0
        store r1, r2                  ; theorem absent
        imm r1, 525848
        store r1, r2                  ; zero clause absent
        imm r1, 525856
        store r1, r2                  ; step clause absent
        call write_str_derive_costs

        ; Introduce arbitrary parameters satisfying the theorem premises:
        ; LEN is natural, [P,P+LEN) is nonwrapping/in-bounds, the hidden return
        ; is valid, and the preexisting trace/input/memory relation is shared.
        call write_str_set_entry_invariant
        imm r1, 525864
        imm r2, 1                    ; LEN-K=0 partition
        store r1, r2
        call write_str_prove_zero_exit

        call write_str_set_entry_invariant
        imm r1, 525864
        imm r2, 2                    ; LEN-K>0 partition
        store r1, r2
        call write_str_prove_positive_step
        call write_str_publish_theorem
        ret

write_str_set_entry_invariant:
        imm r1, 525760
        imm r2, 1                    ; K
        store r1, r2
        imm r1, 525768
        store r1, r2                  ; pointer=P+K
        imm r1, 525776
        store r1, r2                  ; remaining=LEN-K
        imm r1, 525784
        store r1, r2                  ; output=M[P:P+K]
        imm r1, 525792
        imm r2, 0
        store r1, r2                  ; no loaded byte
        imm r1, 525800
        store r1, r2
        imm r1, 525808
        imm r2, 1
        store r1, r2                  ; rank=LEN-K
        imm r1, 525824
        store r1, r2                  ; input cursor preserved
        imm r1, 525832
        store r1, r2                  ; memory preserved
        imm r1, 525840
        store r1, r2                  ; 0<=K<=LEN and range admitted
        call write_str_require_invariant
        ret

write_str_require_invariant:
        imm r20, 525760
        imm r21, 1
        call write_str_require_cell
        imm r20, 525768
        imm r21, 1
        call write_str_require_cell
        imm r20, 525776
        imm r21, 1
        call write_str_require_cell
        imm r20, 525784
        imm r21, 1
        call write_str_require_cell
        imm r20, 525808
        imm r21, 1
        call write_str_require_cell
        imm r20, 525824
        imm r21, 1
        call write_str_require_cell
        imm r20, 525832
        imm r21, 1
        call write_str_require_cell
        imm r20, 525840
        imm r21, 1
        call write_str_require_cell
        ret

; Base equation.  jeq takes the ret edge when LEN-K=0, so K=LEN and the
; carried output segment is already the full slice.  The loop-head imm makes
; r3=0; r0=P+LEN, r1=0, and the exact ret consumes the valid hidden token.
write_str_prove_zero_exit:
        call write_str_require_invariant
        imm r20, 525864
        imm r21, 1
        call write_str_require_cell
        imm r1, 525848
        imm r2, 1
        store r1, r2                  ; zero clause proved
        ret

; Count decoded starts along both exact helper paths.  The zero path executes
; imm/jeq/ret.  One positive cycle executes imm/jeq/loadb/write/imm/add/sub/jmp
; before returning to the checked helper entry. Earlier effect custody owns the
; exact operands establishing the fallthrough, taken target, and backedge.
write_str_derive_costs:
        call exact_require_write_str_extent
        mov r21, r0                  ; entry
        mov r22, r1                  ; zero-test branch
        mov r23, r2                  ; load
        mov r24, r3                  ; write
        mov r25, r4                  ; imm one
        mov r26, r5                  ; add
        mov r27, r6                  ; sub
        mov r28, r7                  ; backedge
        mov r29, r8                  ; return
        imm r10, 0
        mov r20, r21
        call write_str_cost_mark
        mov r20, r22
        call write_str_cost_mark
        mov r20, r29
        call write_str_cost_mark
        imm r1, 525880
        store r1, r10                 ; derived zero-path intercept

        imm r10, 0
        mov r20, r21
        call write_str_cost_mark
        mov r20, r22
        call write_str_cost_mark
        mov r20, r23
        call write_str_cost_mark
        mov r20, r24
        call write_str_cost_mark
        mov r20, r25
        call write_str_cost_mark
        mov r20, r26
        call write_str_cost_mark
        mov r20, r27                  ; checked positive cost step
        call write_str_cost_mark
        mov r20, r28
        call write_str_cost_mark
        imm r1, 525872
        store r1, r10                 ; derived positive-cycle coefficient
        ret

write_str_cost_mark:
        imm r1, 4194304
        add r1, r20
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, write_str_cost_mark_now
        jmp reject
write_str_cost_mark_now:
        imm r1, 1
        add r10, r1
        ret

write_str_prove_positive_step:
        call write_str_require_invariant
        imm r20, 525864
        imm r21, 2
        call write_str_require_cell
        call write_str_sv_load
        call write_str_sv_write
        call write_str_sv_increment_pointer
        call write_str_sv_decrement_remaining
        call write_str_rank_step
        call write_str_close_backedge
        imm r1, 525856
        imm r2, 2
        store r1, r2                  ; positive-step clause proved
        ret

; Exact loadb r2,r0 derives only M_entry[P+K].
write_str_sv_load:
        imm r20, 525768
        imm r21, 1
        call write_str_require_cell
        imm r20, 525832
        imm r21, 1
        call write_str_require_cell
        imm r20, 525840
        imm r21, 1
        call write_str_require_cell
        imm r1, 525792
        imm r2, 1                    ; memory-byte provenance
        store r1, r2
        imm r1, 525800
        imm r2, 1                    ; checked load endpoint K
        store r1, r2
        ret

; Exact write r2 extends the output token only with the byte loaded at its
; current endpoint.  It cannot mint a segment from an unrelated byte.
write_str_sv_write:
        imm r20, 525792
        imm r21, 1
        call write_str_require_cell
        imm r20, 525800
        imm r21, 1
        call write_str_require_cell
        imm r20, 525784
        imm r21, 1
        call write_str_require_cell
        imm r1, 525784
        imm r2, 2
        store r1, r2                  ; output=M[P:P+(K+1)]
        ret

; Exact imm-one/add updates r0 from P+K to P+(K+1).
write_str_sv_increment_pointer:
        imm r20, 525768
        imm r21, 1
        call write_str_require_cell
        imm r1, 525768
        imm r2, 2
        store r1, r2
        ret

; Exact imm-one/sub updates r1 from LEN-K to LEN-(K+1).  Positivity rules out
; underflow and preserves 0<=K+1<=LEN.
write_str_sv_decrement_remaining:
        imm r20, 525864
        imm r21, 2
        call write_str_require_cell
        imm r20, 525776
        imm r21, 1
        call write_str_require_cell
        imm r1, 525776
        imm r2, 2
        store r1, r2
        ret

; Rank LEN-K decreases by exactly one on the positive edge.  The same algebra
; proves C(LEN-K)=8+C(LEN-(K+1)) for C(n)=8*n+3.
write_str_rank_step:
        imm r20, 525808
        imm r21, 1
        call write_str_require_cell
        imm r20, 525776
        imm r21, 2
        call write_str_require_cell
        imm r3, 1                    ; checked rank delta
        imm r4, 1
        jeq r3, r4, write_str_rank_cost
        jmp reject
write_str_rank_cost:
        imm r1, 525872
        load r2, r1
        imm r3, 8
        jeq r2, r3, write_str_rank_intercept
        jmp reject
write_str_rank_intercept:
        imm r1, 525880
        load r2, r1
        imm r3, 3
        jeq r2, r3, write_str_rank_set
        jmp reject
write_str_rank_set:
        imm r1, 525808
        imm r2, 2
        store r1, r2                  ; rank=LEN-(K+1)
        ret

; The exact jump returns to the checked helper entry. Rename successor tags only
; after requiring pointer, remaining, output, and rank to agree on K+1.
write_str_close_backedge:
        imm r20, 525768
        imm r21, 2
        call write_str_require_cell
        imm r20, 525776
        imm r21, 2
        call write_str_require_cell
        imm r20, 525784
        imm r21, 2
        call write_str_require_cell
        imm r20, 525808
        imm r21, 2
        call write_str_require_cell
        imm r1, 525760
        imm r2, 1
        store r1, r2                  ; capture-avoiding K+1 -> K
        imm r1, 525768
        store r1, r2
        imm r1, 525776
        store r1, r2
        imm r1, 525784
        imm r2, 1                    ; checked renamed output segment
        store r1, r2                  ; checked renamed output segment
        imm r1, 525808
        store r1, r2
        call write_str_require_invariant
        ret

write_str_publish_theorem:
        imm r20, 525848
        imm r21, 1
        call write_str_require_cell
        imm r20, 525856
        imm r21, 2
        call write_str_require_cell
        imm r20, 525872
        imm r21, 8
        call write_str_require_cell
        imm r20, 525880
        imm r21, 3
        call write_str_require_cell
        imm r1, 525816
        imm r2, 1465074514            ; WSTR
        store r1, r2
        ret

; ---- Exhaustive fixed-emit instantiation ------------------------------

write_str_instantiate_emits:
        imm r20, 525816
        imm r21, 1465074514
        call write_str_require_cell
        imm r10, 0
        imm r11, 0                    ; kind-four rows
        imm r12, 0                    ; decoded bytes
write_str_emit_loop:
        imm r1, 613
        jlt r10, r1, write_str_emit_row
        imm r1, 113
        jeq r11, r1, write_str_emit_byte_count
        jmp reject
write_str_emit_byte_count:
        imm r1, 791
        jeq r12, r1, write_str_emit_done
        jmp reject
write_str_emit_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 7086080
        add r1, r2
        load r3, r1
        imm r1, 4
        jeq r3, r1, write_str_emit_selected
        jmp write_str_emit_next
write_str_emit_selected:
        mov r20, r10
        call write_str_require_emit_event
        mov r13, r1                   ; preserve exact decoded length
        imm r1, 1
        add r11, r1
        add r12, r13
write_str_emit_next:
        imm r1, 1
        add r10, r1
        jmp write_str_emit_loop
write_str_emit_done:
        ret
