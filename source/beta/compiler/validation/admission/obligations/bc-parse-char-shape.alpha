; Exact source/artifact shape for parse_char() procedure56.
;
; Owns the eleven blocks, complete finite escape partition, six cursor calls,
; explicit/synthetic returns, one local slot, exact comparisons/constants,
; binary pushes, and exhaustive decoded/table censuses. The adjacent meaning
; module owns ordinary/escape values and deliberately malformed tail behavior.

parse_char_require_shape:
        imm r20, 7151616
        imm r21, 56
        imm r22, 0                    ; no parameters
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 56
        imm r22, 1                    ; local v
        call transfer_require_cell
        imm r20, 56
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, parse_char_shape_blocks
        jmp reject

parse_char_shape_blocks:
        imm r20, 256
        imm r21, 56
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 257
        imm r21, 56
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 258
        imm r21, 56
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 259
        imm r21, 56
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 260
        imm r21, 56
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 261
        imm r21, 56
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 262
        imm r21, 56
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 263
        imm r21, 56
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 264
        imm r21, 56
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 265
        imm r21, 56
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 266
        imm r21, 56
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 256
        imm r21, 266
        imm r22, 56
        call exact_require_proc_blocks
        call parse_char_require_transitions
        call parse_char_require_events
        call parse_char_require_locals
        call parse_char_require_primitives
        call parse_char_require_pushes
        call parse_char_require_censuses
        ret

parse_char_require_transitions:
        imm r20, 197
        imm r21, 257
        imm r22, 1
        imm r23, 258
        call exact_transition_identity_pc              ; first byte is backslash
        imm r20, 198
        imm r21, 257
        imm r22, 0
        imm r23, 266
        call exact_transition_identity_pc              ; ordinary/default byte
        imm r20, 199
        imm r21, 258
        imm r22, 1
        imm r23, 259
        call exact_transition_identity_pc              ; escaped n
        imm r20, 200
        imm r21, 258
        imm r22, 0
        imm r23, 260
        call exact_transition_identity_pc
        imm r20, 201
        imm r21, 259
        imm r22, 0
        imm r23, 266
        call exact_transition_identity_pc
        imm r20, 202
        imm r21, 260
        imm r22, 1
        imm r23, 261
        call exact_transition_identity_pc              ; escaped t
        imm r20, 203
        imm r21, 260
        imm r22, 0
        imm r23, 262
        call exact_transition_identity_pc
        imm r20, 204
        imm r21, 261
        imm r22, 0
        imm r23, 266
        call exact_transition_identity_pc
        imm r20, 205
        imm r21, 262
        imm r22, 1
        imm r23, 263
        call exact_transition_identity_pc              ; escaped r
        imm r20, 206
        imm r21, 262
        imm r22, 0
        imm r23, 264
        call exact_transition_identity_pc
        imm r20, 207
        imm r21, 263
        imm r22, 0
        imm r23, 266
        call exact_transition_identity_pc
        imm r20, 208
        imm r21, 264
        imm r22, 1
        imm r23, 265
        call exact_transition_identity_pc              ; escaped zero
        imm r20, 209
        imm r21, 264
        imm r22, 0
        imm r23, 266
        call exact_transition_identity_pc              ; unrecognized escape
        imm r20, 210
        imm r21, 265
        imm r22, 0
        imm r23, 266
        call exact_transition_identity_pc
        ret

; Source block/arity/target procedure in r21..r23.
parse_char_require_call:
        mov r24, r23
        imm r23, 0
        imm r20, 56                    ; parse_char owning procedure identity
        call summary_require_call_fallthrough_identity
        ret

; As above, with occurrence/cardinality in r24/r25 for a repeated complete key.
parse_char_require_nth_call:
        mov r26, r25
        mov r25, r24
        mov r24, r23
        imm r23, 0
        imm r20, 56                    ; parse_char owning procedure identity
        call summary_require_nth_call_fallthrough_identity
        ret

parse_char_require_events:
        imm r21, 256
        imm r22, 0
        imm r23, 5                     ; opening adv
        call parse_char_require_call
        imm r21, 256
        imm r22, 0
        imm r23, 4                     ; first cbyte
        call parse_char_require_call
        imm r21, 258
        imm r22, 0
        imm r23, 5                     ; proven-backslash adv
        call parse_char_require_call
        imm r21, 258
        imm r22, 0
        imm r23, 4                     ; escaped cbyte
        call parse_char_require_call
        imm r21, 266
        imm r22, 0
        imm r23, 5                     ; unchecked tail adv one
        imm r24, 0
        imm r25, 2
        call parse_char_require_nth_call
        imm r21, 266
        imm r22, 0
        imm r23, 5                     ; unchecked tail adv two
        imm r24, 1
        imm r25, 2
        call parse_char_require_nth_call
        imm r20, 56
        imm r21, 266
        call exact_require_event_epilogue
        imm r20, 57                    ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

