; Exact source/artifact shape for gen_to (procedure66).
; The canonical procedure inventory owns its total block span and partition.

statement_gen_to_require_shape:
        call statement_gen_to_require_proc
        imm r20, 318
        imm r21, 321
        imm r22, 66
        call exact_require_proc_blocks
        call statement_gen_to_require_transitions
        call statement_gen_to_require_events
        call statement_gen_to_require_data
        call statement_gen_to_require_censuses
        call statement_gen_to_require_decoded
        ret

statement_gen_to_require_proc:
        imm r20, 66
        imm r21, 0
        imm r22, 4
        imm r23, 40
        call exact_require_proc_frame_identity
        jmp exact_shape_ok

statement_gen_to_require_transitions:
        imm r20, 258
        imm r21, 319
        imm r22, 1
        imm r23, 320
        call exact_transition_identity_pc
        imm r20, 259
        imm r21, 319
        imm r22, 0
        imm r23, 321
        call exact_transition_identity_pc
        ret

; r21=block,r22=arity,r23=target-procedure. The owning procedure and artifact
; call/fallthrough coordinates are reconstructed from the complete event key.
statement_gen_to_require_call:
        mov r24, r23
        imm r23, 0
        imm r20, 66
        call summary_require_call_fallthrough_identity
        ret

; r21=block,r22=arity,r23=target-procedure,r24=occurrence,r25=cardinality.
statement_gen_to_require_nth_call:
        mov r26, r25
        mov r25, r24
        mov r24, r23
        imm r23, 0
        imm r20, 66
        call summary_require_nth_call_fallthrough_identity
        ret

; r21=block,r22=literal bytes,r23=encoded length.
statement_gen_to_require_emit:
        imm r20, 66
        call exact_unique_emit_event_identity
        mov r14, r0
        mov r10, r1
        call check_emit_at_call
        ret

; r21=block,r22=literal bytes,r23=len,r24=occurrence,r25=cardinality.
statement_gen_to_require_nth_emit:
        imm r20, 66
        call exact_nth_emit_event_identity
        mov r14, r0
        mov r10, r1
        call check_emit_at_call
        ret

; r21=source block.
statement_gen_to_require_return:
        imm r20, 66
        call exact_require_event_epilogue
        ret

statement_gen_to_require_events:
        ; Entry/lookahead and classifier.
        imm r21, 318
        imm r22, 0
        imm r23, 10                  ; skip_ws
        imm r24, 0
        imm r25, 2
        call statement_gen_to_require_nth_call
        imm r21, 318
        imm r22, 0
        imm r23, 12                  ; read_ident
        imm r24, 0
        imm r25, 2
        call statement_gen_to_require_nth_call
        imm r21, 318
        imm r22, 0
        imm r23, 10                  ; skip_ws
        imm r24, 1
        imm r25, 2
        call statement_gen_to_require_nth_call
        imm r21, 318
        imm r22, 0
        imm r23, 12                  ; read_ident
        imm r24, 1
        imm r25, 2
        call statement_gen_to_require_nth_call
        imm r21, 319
        imm r22, 0
        imm r23, 18                  ; is_when
        call statement_gen_to_require_call
        call statement_gen_to_require_guarded_events
        call statement_gen_to_require_plain_events
        call statement_gen_to_require_epilogues
        ret

statement_gen_to_require_guarded_events:
        imm r21, 320
        imm r22, 0
        imm r23, 61                  ; gen_expr
        call statement_gen_to_require_call
        imm r21, 320
        imm r22, 0
        imm r23, 1                   ; new_label
        call statement_gen_to_require_call
        imm r21, 320
        imm r22, statement_gen_to_literal_jz_r0
        imm r23, 6
        call statement_gen_to_require_emit
        imm r21, 320
        imm r22, 1
        imm r23, 2                   ; emit_lref
        imm r24, 0
        imm r25, 2
        call statement_gen_to_require_nth_call
        imm r21, 320
        imm r22, statement_gen_to_literal_newline
        imm r23, 1
        imm r24, 0
        imm r25, 2
        call statement_gen_to_require_nth_emit
        imm r21, 320
        imm r22, statement_gen_to_literal_jmp
        imm r23, 4
        call statement_gen_to_require_emit
        imm r21, 320
        imm r22, 2
        imm r23, 64                  ; emit_state_label
        call statement_gen_to_require_call
        imm r21, 320
        imm r22, statement_gen_to_literal_newline
        imm r23, 1
        imm r24, 1
        imm r25, 2
        call statement_gen_to_require_nth_emit
        imm r21, 320
        imm r22, 1
        imm r23, 2                   ; emit_lref
        imm r24, 1
        imm r25, 2
        call statement_gen_to_require_nth_call
        imm r21, 320
        imm r22, statement_gen_to_literal_label_suffix
        imm r23, 2
        call statement_gen_to_require_emit
        imm r21, 320
        call statement_gen_to_require_return
        ret

statement_gen_to_require_plain_events:
        imm r21, 321
        imm r22, statement_gen_to_literal_jmp
        imm r23, 4
        call statement_gen_to_require_emit
        imm r21, 321
        imm r22, 2
        imm r23, 64                  ; emit_state_label
        call statement_gen_to_require_call
        imm r21, 321
        imm r22, statement_gen_to_literal_newline
        imm r23, 1
        call statement_gen_to_require_emit
        imm r21, 321
        call statement_gen_to_require_return
        ret

statement_gen_to_require_epilogues:
        ; Explicit returns are bound with their event identities above.
        imm r20, 67                  ; next procedure owns synthetic epilogue
        call exact_require_preentry_epilogue
        ret

statement_gen_to_require_data:
        call statement_gen_to_require_locals
        call statement_gen_to_require_memory
        call statement_gen_to_require_primitives
        call statement_gen_to_require_pushes
        ret

statement_gen_to_require_locals:
        imm r20, 207
        imm r21, 318
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 208
        imm r21, 318
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 209
        imm r21, 318
        imm r22, 2
        imm r23, 2
        call exact_local_identity_pc
        imm r20, 210
        imm r21, 320
        imm r22, 2
        imm r23, 3
        call exact_local_identity_pc
        imm r20, 211
        imm r21, 320
        imm r22, 1
        imm r23, 3
        call exact_local_identity_pc
        imm r20, 212
        imm r21, 320
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 213
        imm r21, 320
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 214
        imm r21, 320
        imm r22, 1
        imm r23, 3
        call exact_local_identity_pc
        imm r20, 215
        imm r21, 321
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc
        imm r20, 216
        imm r21, 321
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 217
        imm r21, 321
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        ret

statement_gen_to_require_memory:
        imm r20, 78
        imm r21, 318
        imm r25, 733
        imm r26, 2097120
        call exact_memory_load_pc
        imm r20, 79
        imm r21, 318
        imm r25, 734
        imm r26, 2097112
        call exact_memory_load_pc
        imm r20, 80
        imm r21, 318
        imm r25, 735
        imm r26, 2097144
        call exact_memory_load_pc
        imm r20, 81
        imm r21, 321
        call exact_memory_store_pc
        ret

statement_gen_to_require_primitives:
        ; Address literals 733..735 are rejoined to loads above.
        imm r20, 736
        imm r21, 319
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 737
        imm r21, 319
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 738
        imm r21, 320
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 739
        imm r21, 321
        imm r22, 1
        imm r23, 2097144
        call exact_primitive_identity_pc
        imm r20, 740
        imm r21, 321
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        ret

statement_gen_to_require_pushes:
        imm r20, 215
        imm r21, 319
        call exact_require_binary_push_identity
        imm r20, 353
        imm r21, 320
        call exact_require_argument_push_identity
        imm r20, 354
        imm r21, 320
        call exact_require_argument_push_identity
        imm r20, 355
        imm r21, 320
        call exact_require_argument_push_identity
        imm r20, 356
        imm r21, 320
        call exact_require_argument_push_identity
        imm r20, 357
        imm r21, 321
        call exact_require_argument_push_identity
        imm r20, 358
        imm r21, 321
        call exact_require_argument_push_identity
        imm r20, 399
        imm r21, 321
        call exact_require_store_push_identity
        ret

statement_gen_to_require_censuses:
        imm r20, 318
        imm r21, 321
        imm r22, 207
        imm r23, 218
        imm r24, 78
        imm r25, 82
        imm r26, 258
        imm r27, 260
        imm r28, 521
        imm r29, 541
        call exact_require_effect_census
        imm r20, 318
        imm r21, 321
        imm r22, 733
        imm r23, 741
        imm r24, 215
        imm r25, 216
        imm r26, 353
        imm r27, 359
        imm r28, 399
        imm r29, 400
        call summary_require_expr_census
        ret

statement_gen_to_require_decoded:
        imm r0, 66
        call exact_proc_entry_pc
        mov r30, r0
        imm r0, 67
        call exact_proc_entry_pc
        mov r21, r0
        mov r20, r30
        imm r22, 18
        imm r23, 3
        imm r24, 14
        call exact_quiet_scan_region
        ret

statement_gen_to_literal_jz_r0:
        db "jz r0,"
statement_gen_to_literal_jmp:
        db "jmp "
statement_gen_to_literal_newline:
        db "\n"
statement_gen_to_literal_label_suffix:
        db ":\n"
