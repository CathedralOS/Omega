; Exact-subject FOL ledger endpoint for bc.main.resource.
;
; Linked in place of the executable ROOT publication after the ordinary
; source/tape owners have reconstructed the canonical bundle.  Recheck the
; cleanup and its five typed-resource joins directly, then emit the checker
; declaration/goal prefix.  No ROOT/GFP success token becomes a proof premise;
; the emitted proposition is fixed here and the proof producer supplies only
; the final proof term.

root_observation_publication_init:
        call root_resource_join_require_cleanup
        call root_resource_join_require_rows
        call root_resource_join_require_domain
        call bc_fol_resource_emit_prefix
        imm r0, 0
        halt r0

bc_fol_resource_emit_prefix:
        imm r10, bc_fol_resource_prefix
        imm r11, bc_fol_resource_prefix_end
bc_fol_resource_emit_loop:
        jlt r10, r11, bc_fol_resource_emit_byte
        ret
bc_fol_resource_emit_byte:
        loadb r0, r10
        write r0
        imm r1, 1
        add r10, r1
        jmp bc_fol_resource_emit_loop

bc_fol_resource_prefix:
        db "(data 10 1 0 0) (data 11 1 0 0) (data 12 1 0 0) (data 13 1 0 0) (data 14 0 0 0) (data 15 1 0 0) (data 16 1 0 0) (data 17 1 0 0) (data 18 1 0 0) (data 19 1 0 0) (data 20 1 0 0) (data 21 0 0 0) (data 22 0 0 0) (data 30 2 0 0) (data 31 0 0 0) (data 32 0 0 0) (data 33 0 0 0) (data 34 0 0 0) (data 35 0 0 0) (data 36 0 0 0) (data 37 0 0 0) (data 38 0 0 0) (data 39 0 0 0) (data 40 0 0 0) (data 41 0 0 0) (data 42 0 0 0) (data 43 0 0 0) (data 44 0 0 0) (data 45 0 0 0) (data 46 0 0 0) (data 47 0 0 0) (data 48 0 0 0) (data 49 0 0 0) (fun 29 30 (v 1)) (fun 30 10 (f 31 (v 0))) (fun 30 11 (k 11 (v 0))) (fun 30 14 (k 14)) (fun 31 15 (k 11 (k 20 (f 29 (v 0))))) (fun 32 12 (f 33 (v 0))) (fun 32 13 (k 13 (v 0))) (fun 32 14 (k 14)) (fun 33 16 (k 12 (k 17 (v 0)))) (fun 33 17 (k 12 (k 18 (v 0)))) (fun 33 18 (k 12 (k 19 (v 0)))) (fun 33 19 (k 13 (k 20 (f 29 (v 0))))) (fun 34 10 (k 21)) (fun 34 11 (v 0)) (fun 34 14 (k 22)) (fun 35 12 (k 21)) (fun 35 13 (v 0)) (fun 35 14 (k 22)) (fun 36 12 (f 37 (v 0))) (fun 36 13 z) (fun 36 14 z) (fun 37 16 (s (s (s (s z))))) (fun 37 17 (s (s (s z)))) (fun 37 18 (s (s z))) (fun 37 19 (s z)) (def 0 (All (& (= (f 30 (k 10 (k 15 (v 0)))) (k 11 (k 20 (f 29 (v 0))))) (& (= (f 32 (f 32 (f 32 (f 32 (k 12 (k 16 (v 0))))))) (k 13 (k 20 (f 29 (v 0))))) (& (= (f 34 (k 10 (k 15 (v 0)))) (f 35 (k 12 (k 16 (v 0))))) (& (= (f 34 (f 30 (k 10 (k 15 (v 0))))) (f 35 (f 32 (f 32 (f 32 (f 32 (k 12 (k 16 (v 0))))))))) (& (= (f 35 (k 12 (k 16 (v 0)))) (f 35 (f 32 (k 12 (k 16 (v 0)))))) (& (= (f 35 (f 32 (k 12 (k 16 (v 0))))) (f 35 (f 32 (f 32 (k 12 (k 16 (v 0))))))) (& (= (f 35 (f 32 (f 32 (k 12 (k 16 (v 0)))))) (f 35 (f 32 (f 32 (f 32 (k 12 (k 16 (v 0)))))))) (& (= (p (f 36 (f 32 (k 12 (k 16 (v 0))))) (s z)) (f 36 (k 12 (k 16 (v 0))))) (& (= (p (f 36 (f 32 (f 32 (k 12 (k 16 (v 0)))))) (s z)) (f 36 (f 32 (k 12 (k 16 (v 0)))))) (& (= (p (f 36 (f 32 (f 32 (f 32 (k 12 (k 16 (v 0))))))) (s z)) (f 36 (f 32 (f 32 (k 12 (k 16 (v 0))))))) (& (= (p (f 36 (f 32 (f 32 (f 32 (f