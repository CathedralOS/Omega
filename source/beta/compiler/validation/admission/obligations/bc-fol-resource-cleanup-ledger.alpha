; Exact-subject FOL instruction ledger endpoint for bc.main.resource.
;
; Linked directly after exact main shape reconstruction. Build and recheck the
; cleanup and its five typed-resource joins, validate every raw instruction
; boundary, then emit the checker declaration/goal prefix. ROOT/GFP/maximal-
; observation execution is not in this program. The proof producer supplies
; only the final proof term.

root_observation_shape_successor_init:
        call root_observation_resource_join_init
        jmp root_observation_publication_init

root_observation_publication_init:
        call root_resource_join_require_cleanup
        call root_resource_join_require_rows
        call root_resource_join_require_domain
        call bc_fol_resource_require_raw_path
        call bc_fol_resource_emit_prefix
        imm r0, 0
        halt r0

; Reconstruct the seven executed instructions without a producer PC. Block354
; begins at the RESOURCE_FAIL literal; the memory owner rejoins its load; the
; epilogue owner returns mov/load/add/ret starts; the prelude owner fixes halt39.
; The ARet control includes the root-return-slot=39 cutpoint invariant. Full-run
; reachability of that invariant remains a later whole-refinement obligation.
bc_fol_resource_require_raw_path:
        imm r20, 354
        imm r21, 69
        imm r22, 1
        call exact_block_identity_pc
        mov r40, r0

        imm r20, 94
        imm r21, 354
        imm r25, 815
        imm r26, 2097072
        call exact_memory_load_pc
        mov r41, r0
        mov r1, r40
        imm r2, 10
        add r1, r2
        jeq r1, r41, bc_fol_resource_require_epilogue
        jmp reject

bc_fol_resource_require_epilogue:
        imm r20, 69
        imm r21, 354
        call exact_require_event_epilogue
        mov r1, r41
        imm r2, 3
        add r1, r2
        jeq r1, r0, bc_fol_resource_require_root_halt
        jmp reject

bc_fol_resource_require_root_halt:
        imm r20, 69
        call exact_require_program_prelude
        ; r3 is the exact halt at the root-call fallthrough. The resource-join
        ; cleanup constructor separately requires its root-continuation field.
        imm r1, 39
        jeq r3, r1, bc_fol_resource_raw_path_done
        jmp reject
bc_fol_resource_raw_path_done:
        ret

bc_fol_resource_emit_prefix:
        imm r10, bc_fol_resource_prefix
        imm r11, bc_fol_resource_prefix_end
bc_fol_resource_emit_loop:
        jlt r10, r11, bc_fol_resource_emit_byte
        ret
bc_fol_resource_emit_byte:
        loadb r0, r10
        write r0
        imm r1, 1
        add r10, r1
        jmp bc_fol_resource_emit_loop

bc_fol_resource_prefix:
        db "(data 10 1 0 0) (data 11 1 0 0) (data 12 1 0 0) (data 13 1 0 0) (data 14 0 0 0) (data 15 1 0 0) (data 16 1 0 0) (data 17 1 0 0) (data 18 1 0 0) (data 19 1 0 0) (data 20 1 0 0) (data 21 1 0 0) (data 22 1 0 0) (data 23 1 0 0) (data 24 0 0 0) (data 25 0 0 0) (data 30 2 0 0) (data 31 0 0 0) (data 32 0 0 0) (data 33 0 0 0) (data 34 0 0 0) (data 35 0 0 0) (data 36 0 0 0) (data 37 0 0 0) (data 38 0 0 0) (data 39 0 0 0) (data 40 0 0 0) (data 41 0 0 0) (data 42 0 0 0) (data 43 0 0 0) (data 44 0 0 0) (data 45 0 0 0) (data 46 0 0 0) (data 47 0 0 0) (data 48 0 0 0) (data 49 0 0 0) (fun 28 43 (y 0)) (fun 29 30 (v 1)) (fun 30 41 (f 31 (y 0))) (fun 31 10 (f 32 (v 0))) (fun 31 11 (k 11 (v 0))) (fun 31 12 (k 14)) (fun 31 13 (k 14)) (fun 31 14 (k 14)) (fun 32 15 (k 11 (k 23 (f 29 (v 0))))) (fun 32 16 (k 14)) (fun 32 17 (k 14)) (fun 32 18 (k 14)) (fun 32 19 (k 14)) (fun 32 20 (k 14)) (fun 32 21 (k 14)) (fun 32 22 (k 14)) (fun 33 42 (f 34 (y 0))) (fun 34 10 (k 14)) (fun 34 11 (k 14)) (fun 34 12 (f 35 (v 0))) (fun 34 13 (k 13 (v 0))) (fun 34 14 (k 14)) (fun 35 15 (k 14)) (fun 35 16 (k 12 (k 17 (v 0)))) (fun 35 17 (k 12 (k 18 (v 0)))) (fun 35 18 (k 12 (k 19 (v 0)))) (fun 35 19 (k 12 (k 20 (v 0)))) (fun 35 20 (k 12 (k 21 (v 0)))) (fun 35 21 (k 12 (k 22 (v 0)))) (fun 35 22 (k 13 (k 23 (f 29 (v 0))))) (fun 36 44 (f 37 (y 0))) (fun 37 10 (k 24)) (fun 37 11 (v 0)) (fun 37 12 (k 24)) (fun 37 13 (v 0)) (fun 37 14 (k 25)) (fun 38 42 (f 39 (y 0))) (fun 39 10 z) (fun 39 11 z) (fun 39 12 (f 40 (v 0))) (fun 39 13 z) (fun 39 14 z) (fun 40 15 z) (fun 40 16 (s (s (s (s (s (s (s z)))))))) (fun 40 17 (s (s (s (s (s (s z))))))) (fun 40 18 (s (s (s (s (s z)))))) (fun 40 19 (s (s (s (s z))))) (fun 40 20 (s (s (s z)))) (fun 40 21 (s (s z))) (fun 40 22 (s z)) (def 0 (All (& (= (f 30 (k 41) (k 10 (k 15 (f 28 (k 43) (v 0))))) (k 11 (k 23 (f 29 (f 28 (k 43) (v 0)))))) (& (= (f 33 (k 42) (f 33 (k 42) (f 33 (k 42) (f 33 (k 42) (f 33 (k 42) (f 33 (k 42) (f 33 (k 42) (k 12 (k 16 (f 28 (k 43) (v 0))))))))