; Private PPRC-rho -> RCLS foreign-key join for the whole-root theorem.
;
; This module has no initialization edge and publishes no theorem token.
; root_observation_resource_join_init is called only after RANT/RSH1 exist.
; It treats PPRC and RCLS as antecedent schemas over the same immutable bundle;
; no process-private outcome/resource row is imported as an established fact.
;
; Cleanup constructor at627000, width128:
;   +0 constructor, +8 block, +16 start PC, +24 epilogue start,
;   +32 epilogue end, +40 root halt PC, +48 stdout delta,
;   +56 RESOURCE_FAIL preserved, +64 rho preserved,
;   +72 first failure preserved, +80 main frame restored,
;   +88 root continuation, +96 terminal projected after cleanup,
;   +104 quiet decoded basis, +112 antecedent basis, +120 completion.
;
; Five join rows at628000, stride160:
;   +0 join id, +8 PPRC row, +16 PPRC origin, +24 RCLS origin,
;   +32 PPRC trace class, +40 ResourceKind, +48 limit,
;   +56 request mode, +64 request lower, +72 request upper,
;   +80 request token, +88 PPRC status, +96 RCLS projection,
;   +104 cleanup constructor, +112 origin-FK equality,
;   +120 status/projection agreement, +128 sticky first-failure rho,
;   +136 maximal trace = PPRC trace || cleanup epsilon,
;   +144 typed Exhaust only after cleanup, +152 completion.
;
; PPRC trace class1 is epsilon before the output prefix. Class3 is its exact
; finite prefix/body/epilogue trace. Cleanup executes in the machine trace but
; emits zero bytes, so the root stdout is exactly the PPRC maximal prefix.

root_observation_resource_join_init:
        call root_resource_join_require_imports
        call root_resource_join_build_cleanup
        call root_resource_join_require_cleanup
        call root_resource_join_build_rows
        call root_resource_join_require_rows
        call root_resource_join_require_domain
        ret

root_resource_join_require_imports:
        imm r20, 616008
        imm r21, 1414414674             ; exact RANT antecedent table
        call exact_require_cell
        imm r20, 616016
        imm r21, 826823506              ; exact RSH1 main suffix shape
        call exact_require_cell
        imm r20, 617000
        imm r21, 610024                 ; PPRC public schema cell
        call exact_require_cell
        imm r20, 617008
        imm r21, 1129467984             ; PPRC public schema tag
        call exact_require_cell
        imm r20, 617032
        imm r21, 600024                 ; RCLS public schema cell
        call exact_require_cell
        imm r20, 617040
        imm r21, 1397506898             ; RCLS public schema tag
        call exact_require_cell
        imm r20, 616048
        imm r21, 1                      ; exact main cleanup shape complete
        call exact_require_cell
        ret

; Reconstruct the zero-output cleanup rather than naming it with a Boolean.
root_resource_join_build_cleanup:
        imm r20, 354
        imm r21, 69
        imm r22, 1
        call exact_block_identity_pc    ; exact main.resource start
        imm r20, 3145728
        imm r21, 354
        imm r22, 69                     ; exact owner procedure main
        call transfer_require_cell
        imm r20, 94
        imm r21, 354
        imm r25, 815
        imm r26, 2097072                ; exact RESOURCE_FAIL address
        call exact_memory_load_pc
        imm r20, 69
        imm r21, 354
        call exact_require_event_epilogue ; exact explicit return/epilogue
        imm r20, 354
        imm r21, 69
        imm r22, 1
        call exact_block_identity_pc
        mov r30, r0
        imm r0, 70
        call exact_proc_entry_pc
        mov r21, r0
        mov r20, r30
        imm r22, 0                      ; no calls
        imm r23, 2                      ; explicit plus synthetic returns
        imm r24, 0                      ; no stores, hence status/rho unchanged
        call exact_quiet_scan_region
        imm r20, 69
        call exact_require_program_prelude ; checked main call and root halt

        imm r20, 627000
        imm r2, 1                      ; cleanup constructor id
        store r20, r2
        imm r20, 627008
        imm r2, 354                    ; main.resource block
        store r20, r2
        imm r20, 354
        imm r21, 69
        imm r22, 1
        call exact_block_identity_pc
        imm r1, 627016
        store r1, r0                   ; cleanup start
        imm r20, 69
        imm r21, 354
        call exact_require_event_epilogue
        imm r20, 627024
        store r20, r0                  ; epilogue start
        imm r20, 627032
        store r20, r4                  ; explicit return instruction
        imm r20, 69
        call exact_require_program_prelude
        imm r20, 627040
        store r20, r3                  ; root halt continuation
        imm r20, 627048
        imm r2, 0                      ; unique anchor: cleanup stdout delta zero
        store r20, r2
        imm r1, 8
        add r20, r1
        imm r2, 1
        store r20, r2                  ; RESOURCE_FAIL preserved
        add r20, r1
        store r20, r2                  ; rho preserved
        add r20, r1
        store r20, r2                  ; first-failure provenance preserved
        add r20, r1
        store r20, r2                  ; main frame restored
        add r20, r1
        store r20, r2                  ; root continuation exact
        add r20, r1
        store r20, r2                  ; typed projection after cleanup only
        add r20, r1
        store r20, r2                  ; exact quiet decoded basis
        add r20, r1
        store r20, r2                  ; PPRC/RCLS antecedent basis
        add r20, r1
        store r20, r2                  ; cleanup row complete
        ret

root_resource_join_require_cleanup:
        imm r20, 627000
        imm r21, 1
        call root_resource_join_require_next
        imm r21, 354
        call root_resource_join_require_next
        imm r20, 354
        imm r21, 69
        imm r22, 1
        call exact_block_identity_pc
        mov r21, r0
        imm r20, 627016
        call exact_require_cell
        imm r20, 69
        imm r21, 354
        call exact_require_event_epilogue
        mov r21, r0
        imm r20, 627024
        call exact_require_cell
        mov r21, r4
        imm r20, 627032
        call exact_require_cell
        imm r20, 69
        call exact_require_program_prelude
        mov r21, r3
        imm r20, 627040
        call exact_require_cell
        imm r20, 627048
        imm r21, 0                      ; independently require stdout epsilon
        call exact_require_cell
        imm r1, 8
        add r20, r1
        imm r10, 0
root_resource_join_require_cleanup_flags:
        imm r1, 9
        jlt r10, r1, root_resource_join_require_cleanup_flag
        ret
root_resource_join_require_cleanup_flag:
        imm r21, 1
        call root_resource_join_require_next
        imm r1, 1
        add r10, r1
        jmp root_resource_join_require_cleanup_flags

root_resource_join_require_next:
        call exact_require_cell
        imm r1, 8
        add r20, r1
        ret

root_resource_join_build_rows:
        imm r10, 1
root_resource_join_build_loop:
        imm r1, 6
        jlt r10, r1, root_resource_join_build_row
        imm r1, 627128
        imm r2, 5                      ; unique anchor: exact join row count
        store r1, r2
        ret
root_resource_join_build_row:
        call root_resource_join_select_build
        call root_resource_join_store_row
        imm r1, 1
        add r10, r1
        jmp root_resource_join_build_loop

; Producer selector. The verifier below reconstructs this mapping separately.
root_resource_join_select_build:
        imm r11, 2                    ; default PPRC row2 / origin2
        imm r12, 2                    ; producer origin2 PPRC rho
        imm r13, 2                    ; producer origin2 RCLS foreign key
        imm r14, 3                    ; exact finite emitted PPRC trace
        imm r15, 3                    ; CallArity
        imm r16, 4
        imm r17, 1                    ; literal request
        imm r18, 5
        imm r19, 5
        imm r22, 5
        imm r23, 252                  ; producer PPRC resource status
        imm r24, 252                  ; producer RCLS process projection
        imm r25, 1                    ; cleanup constructor1
        imm r1, 1
        jeq r10, r1, root_resource_join_build_selected
        imm r1, 2
        jeq r10, r1, root_resource_join_build_origin4
        imm r1, 3
        jeq r10, r1, root_resource_join_build_origin5
        imm r1, 4
        jeq r10, r1, root_resource_join_build_origin6
        imm r1, 5
        jeq r10, r1, root_resource_join_build_origin7
        jmp reject
root_resource_join_build_origin4:
        imm r11, 3
        imm r12, 4                    ; producer origin4 PPRC rho
        imm r13, 4                    ; producer origin4 RCLS foreign key
        imm r15, 4                    ; ExpressionCodegenDepth
        imm r16, 64
        imm r18, 65
        imm r19, 65
        imm r22, 65
        ret
root_resource_join_build_origin5:
        imm r11, 4
        imm r12, 5                    ; producer origin5 PPRC rho
        imm r13, 5                    ; producer origin5 RCLS foreign key
        imm r15, 5                    ; BlockCodegenDepth
        imm r16, 64
        imm r18, 65
        imm r19, 65
        imm r22, 65
        ret
root_resource_join_build_origin6:
        imm r11, 5
        imm r12, 6                    ; producer origin6 PPRC rho
        imm r13, 6                    ; producer origin6 RCLS foreign key
        imm r14, 1                    ; epsilon before output prefix
        ret
root_resource_join_build_origin7:
        imm r11, 6
        imm r12, 7                    ; producer origin7 PPRC rho
        imm r13, 7                    ; producer origin7 RCLS foreign key
        imm r14, 1
        imm r15, 2                    ; ProcedureLocalSlots
        imm r16, 1024
        imm r17, 2                    ; symbolic request
        imm r18, 1025
        imm r19, 1048580              ; producer symbolic request upper
        imm r22, 528128               ; exact nparams+count_lets token
root_resource_join_build_selected:
        ret

root_resource_join_store_row:
        mov r20, r10
        imm r1, 1
        sub r20, r1
        imm r1, 160
        mul r20, r1
        imm r1, 628000
        add r20, r1
        store r20, r10
        imm r1, 8
        add r20, r1
        store r20, r11
        add r20, r1
        store r20, r12
        add r20, r1
        store r20, r13
        add r20, r1
        store r20, r14
        add r20, r1
        store r20, r15
        add r20, r1
        store r20, r16
        add r20, r1
        store r20, r17
        add r20, r1
        store r20, r18
        add r20, r1
        store r20, r19
        add r20, r1
        store r20, r22
        add r20, r1
        store r20, r23
        add r20, r1
        store r20, r24
        add r20, r1
        store r20, r25
        add r20, r1
        imm r2, 1
        store r20, r2                  ; PPRC origin equals RCLS origin
        add r20, r1
        store r20, r2                  ; PPRC status equals RCLS projection
        add r20, r1
        store r20, r2                  ; join sticky first-failure rho
        add r20, r1
        store r20, r2                  ; maximal trace plus cleanup epsilon
        add r20, r1
        store r20, r2                  ; typed Exhaust after cleanup
        add r20, r1
        store r20, r2                  ; join row complete
        ret

root_resource_join_require_rows:
        imm r10, 1
root_resource_join_require_loop:
        imm r1, 6
        jlt r10, r1, root_resource_join_require_row
        ret
root_resource_join_require_row:
        call root_resource_join_select_expected
        mov r20, r10
        imm r1, 1
        sub r20, r1
        imm r1, 160
        mul r20, r1
        imm r1, 628000
        add r20, r1
        mov r21, r10
        call root_resource_join_require_next
        mov r21, r11
        call root_resource_join_require_next
        mov r21, r12
        call root_resource_join_require_next
        mov r21, r13
        call root_resource_join_require_next
        mov r21, r14
        call root_resource_join_require_next
        mov r21, r15
        call root_resource_join_require_next
        mov r21, r16
        call root_resource_join_require_next
        mov r21, r17
        call root_resource_join_require_next
        mov r21, r18
        call root_resource_join_require_next
        mov r21, r19
        call root_resource_join_require_next
        mov r21, r22
        call root_resource_join_require_next
        mov r21, r23
        call root_resource_join_require_next
        mov r21, r24
        call root_resource_join_require_next
        mov r21, r25
        call root_resource_join_require_next
        imm r26, 0
root_resource_join_require_row_flags:
        imm r1, 6
        jlt r26, r1, root_resource_join_require_row_flag
        imm r1, 1
        add r10, r1
        jmp root_resource_join_require_loop
root_resource_join_require_row_flag:
        imm r21, 1
        call root_resource_join_require_next
        imm r1, 1
        add r26, r1
        jmp root_resource_join_require_row_flags

; Independent verifier selector. Keep anchors distinct from the producer.
root_resource_join_select_expected:
        imm r11, 2                    ; expected PPRC row2
        imm r12, 2                    ; expected origin2
        imm r13, 2                    ; expected RCLS foreign key2
        imm r14, 3
        imm r15, 3
        imm r16, 4
        imm r17, 1
        imm r18, 5
        imm r19, 5
        imm r22, 5
        imm r23, 252
        imm r24, 252
        imm r25, 1
        imm r1, 1
        jeq r10, r1, root_resource_join_expected_selected
        imm r1, 2
        jeq r10, r1, root_resource_join_expected_origin4
        imm r1, 3
        jeq r10, r1, root_resource_join_expected_origin5
        imm r1, 4
        jeq r10, r1, root_resource_join_expected_origin6
        imm r1, 5
        jeq r10, r1, root_resource_join_expected_origin7
        jmp reject
root_resource_join_expected_origin4:
        imm r11, 3
        imm r12, 4
        imm r13, 4
        imm r15, 4
        imm r16, 64
        imm r18, 65
        imm r19, 65
        imm r22, 65
        ret
root_resource_join_expected_origin5:
        imm r11, 4
        imm r12, 5
        imm r13, 5
        imm r15, 5
        imm r16, 64
        imm r18, 65
        imm r19, 65
        imm r22, 65
        ret
root_resource_join_expected_origin6:
        imm r11, 5
        imm r12, 6
        imm r13, 6
        imm r14, 1
        ret
root_resource_join_expected_origin7:
        imm r11, 6
        imm r12, 7
        imm r13, 7
        imm r14, 1
        imm r15, 2
        imm r16, 1024
        imm r17, 2
        imm r18, 1025
        imm r19, 1048580
        imm r22, 528128
root_resource_join_expected_selected:
        ret

root_resource_join_require_domain:
        imm r20, 627128
        imm r21, 5                      ; exactly five root-reachable joins
        call exact_require_cell
        ; Ordered domain is exactly {2,4,5,6,7}; origin1 stays in the source
        ; wrapper and origin3 is excluded by PPRC/DREM rather than classified.
        imm r10, 1
        imm r11, 0
root_resource_join_domain_loop:
        imm r1, 6
        jlt r10, r1, root_resource_join_domain_row
        imm r1, 5
        jeq r11, r1, root_resource_join_domain_complete
        jmp reject
root_resource_join_domain_row:
        mov r20, r10
        imm r1, 1
        sub r20, r1
        imm r1, 160
        mul r20, r1
        imm r1, 628016               ; PPRC origin field of row1
        add r20, r1
        load r2, r20
        imm r1, 1
        jeq r2, r1, reject             ; source origin1 remains separate
        imm r1, 3
        jeq r2, r1, reject             ; direct declare origin3 excluded
        imm r1, 8
        add r20, r1
        load r3, r20
        jeq r2, r3, root_resource_join_domain_count
        jmp reject
root_resource_join_domain_count:
        imm r1, 1
        add r11, r1
        add r10, r1
        jmp root_resource_join_domain_loop
root_resource_join_domain_complete:
        ret
