; Exact source/artifact shape for skip_char_lit() and skip_str_lit().
;
; This module owns procedures 37..38: their ten blocks, nine transitions,
; thirteen ordinary calls, three source returns, all concrete and synthetic
; epilogues, comparison/literal rows, binary pushes, frames, and exhaustive
; effect/expression/decoded-region censuses.  Cursor and literal meaning is
; deliberately separated into the adjacent summary module.

literal_skip_require_shape:
        imm r20, 7151616
        imm r21, 37
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 37
        imm r22, 0
        call transfer_require_cell
        imm r20, 37
        call call_bounds_frame_bytes
        imm r1, 8
        jeq r0, r1, literal_skip_shape_string_frame
        jmp reject
literal_skip_shape_string_frame:
        imm r20, 7151616
        imm r21, 38
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 38
        imm r22, 0
        call transfer_require_cell
        imm r20, 38
        call call_bounds_frame_bytes
        imm r1, 8
        jeq r0, r1, literal_skip_shape_blocks
        jmp reject

literal_skip_shape_blocks:
        imm r20, 183
        imm r21, 37
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 184
        imm r21, 37
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 185
        imm r21, 37
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 186
        imm r21, 37
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 183
        imm r21, 186
        imm r22, 37
        call exact_require_proc_blocks

        imm r20, 187
        imm r21, 38
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 188
        imm r21, 38
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 189
        imm r21, 38
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 190
        imm r21, 38
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 191
        imm r21, 38
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 192
        imm r21, 38
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 187
        imm r21, 192
        imm r22, 38
        call exact_require_proc_blocks
        call literal_skip_require_transitions
        call literal_skip_require_events
        call literal_skip_require_data
        call literal_skip_require_censuses
        ret

literal_skip_require_transitions:
        imm r20, 137
        imm r21, 184
        imm r22, 1
        imm r23, 185
        call exact_transition_identity_pc ; checked char backslash guard
        imm r20, 138
        imm r21, 184
        imm r22, 0
        imm r23, 186
        call exact_transition_identity_pc
        imm r20, 139
        imm r21, 185
        imm r22, 0
        imm r23, 186
        call exact_transition_identity_pc

        imm r20, 140
        imm r21, 188
        imm r22, 1
        imm r23, 189
        call exact_transition_identity_pc ; checked string nonquote guard
        imm r20, 141
        imm r21, 188
        imm r22, 0
        imm r23, 192
        call exact_transition_identity_pc
        imm r20, 142
        imm r21, 189
        imm r22, 1
        imm r23, 190
        call exact_transition_identity_pc ; checked string zero guard
        imm r20, 143
        imm r21, 189
        imm r22, 1
        imm r23, 191
        call exact_transition_identity_pc ; checked string escape guard
        imm r20, 144
        imm r21, 189
        imm r22, 0
        imm r23, 188
        call exact_transition_identity_pc
        imm r20, 145
        imm r21, 191
        imm r22, 0
        imm r23, 188
        call exact_transition_identity_pc
        ret

; r20=procedure,r21=block,r22=target procedure; all calls are zero-arity with
; empty ambient expression state.
literal_skip_require_call:
        mov r24, r22
        imm r22, 0
        imm r23, 0
        call summary_require_call_fallthrough_identity
        ret

; As above, with occurrence/cardinality in r23/r24.
literal_skip_require_nth_call:
        mov r26, r24
        mov r25, r23
        mov r24, r22
        imm r22, 0
        imm r23, 0
        call summary_require_nth_call_fallthrough_identity
        ret

literal_skip_require_events:
        ; skip_char_lit: opening adv, test cbyte, optional escape adv, two
        ; unconditional character/closing advances, and one source return.
        imm r20, 37
        imm r21, 183
        imm r22, 5                    ; adv
        call literal_skip_require_call
        imm r20, 37
        imm r21, 184
        imm r22, 4                    ; cbyte
        call literal_skip_require_call
        imm r20, 37
        imm r21, 185
        imm r22, 5                    ; adv
        call literal_skip_require_call
        imm r20, 37
        imm r21, 186
        imm r22, 5                    ; first of two adv calls
        imm r23, 0
        imm r24, 2
        call literal_skip_require_nth_call
        imm r20, 37
        imm r21, 186
        imm r22, 5
        imm r23, 1
        imm r24, 2
        call literal_skip_require_nth_call
        imm r20, 37
        imm r21, 186
        call exact_require_event_epilogue
        imm r20, 38                   ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue

        ; skip_str_lit: opening adv, three cbyte sites, ordinary/escape/done
        ; advances, and the eof/done source returns.
        imm r20, 38
        imm r21, 187
        imm r22, 5                    ; adv
        call literal_skip_require_call
        imm r20, 38
        imm r21, 188
        imm r22, 4                    ; cbyte
        call literal_skip_require_call
        imm r20, 38
        imm r21, 189
        imm r22, 4                    ; first of two cbyte calls
        imm r23, 0
        imm r24, 2
        call literal_skip_require_nth_call
        imm r20, 38
        imm r21, 189
        imm r22, 4
        imm r23, 1
        imm r24, 2
        call literal_skip_require_nth_call
        imm r20, 38
        imm r21, 189
        imm r22, 5                    ; ordinary adv
        call literal_skip_require_call
        imm r20, 38
        imm r21, 190
        call exact_require_event_epilogue
        imm r20, 38
        imm r21, 191
        imm r22, 5                    ; first of two escape adv calls
        imm r23, 0
        imm r24, 2
        call literal_skip_require_nth_call
        imm r20, 38
        imm r21, 191
        imm r22, 5
        imm r23, 1
        imm r24, 2
        call literal_skip_require_nth_call
        imm r20, 38
        imm r21, 192
        imm r22, 5                    ; closing quote adv
        call literal_skip_require_call
        imm r20, 38
        imm r21, 192
        call exact_require_event_epilogue
        imm r20, 39                   ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

literal_skip_require_data:
        ; row/block/kind/value-or-comparison.
        imm r20, 485
        imm r21, 184
        imm r22, 3
        imm r23, 10                  ; cbyte == 92
        call exact_primitive_identity_pc
        imm r20, 486
        imm r21, 184
        imm r22, 1
        imm r23, 92                  ; checked char escape byte
        call exact_primitive_identity_pc
        imm r20, 487
        imm r21, 186
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc

        imm r20, 488
        imm r21, 188
        imm r22, 3
        imm r23, 11                  ; cbyte != 34
        call exact_primitive_identity_pc
        imm r20, 489
        imm r21, 188
        imm r22, 1
        imm r23, 34                  ; checked closing quote
        call exact_primitive_identity_pc
        imm r20, 490
        imm r21, 189
        imm r22, 3
        imm r23, 10                  ; cbyte == 0
        call exact_primitive_identity_pc
        imm r20, 491
        imm r21, 189
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 492
        imm r21, 189
        imm r22, 3
        imm r23, 10                  ; cbyte == 92
        call exact_primitive_identity_pc
        imm r20, 493
        imm r21, 189
        imm r22, 1
        imm r23, 92                  ; checked string escape byte
        call exact_primitive_identity_pc
        imm r20, 494
        imm r21, 190
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 495
        imm r21, 192
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc

        imm r20, 133
        imm r21, 184
        call exact_require_binary_push_identity
        imm r20, 134
        imm r21, 188
        call exact_require_binary_push_identity
        imm r20, 135
        imm r21, 189
        call exact_require_binary_push_identity
        imm r20, 136
        imm r21, 189
        call exact_require_binary_push_identity
        ret

literal_skip_require_censuses:
        imm r20, 183
        imm r21, 186
        imm r22, 98
        imm r23, 98                  ; no local rows
        imm r24, 52
        imm r25, 52                  ; no memory rows
        imm r26, 137
        imm r27, 140
        imm r28, 281
        imm r29, 287
        call exact_require_effect_census
        imm r20, 187
        imm r21, 192
        imm r22, 98
        imm r23, 98
        imm r24, 52
        imm r25, 52
        imm r26, 140
        imm r27, 146
        imm r28, 287
        imm r29, 297                 ; checked exclusive string event row
        call exact_require_effect_census
        imm r20, 183
        imm r21, 186
        imm r22, 485
        imm r23, 488
        imm r24, 133
        imm r25, 134
        imm r26, 0
        imm r27, 0
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census
        imm r20, 187
        imm r21, 192
        imm r22, 488
        imm r23, 496                 ; checked exclusive string primitive row
        imm r24, 134
        imm r25, 137
        imm r26, 0
        imm r27, 0
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census
        imm r20, 37                   ; skip_char_lit procedure identity
        call exact_proc_entry_r20
        imm r21, 38                   ; skip_str_lit procedure identity / end
        call exact_proc_entry_r21
        imm r22, 5
        imm r23, 2
        call skip_scan_call_region
        imm r20, 38                   ; skip_str_lit procedure identity
        call exact_proc_entry_r20
        imm r21, 39                   ; count_lets procedure identity / end
        call exact_proc_entry_r21
        imm r22, 8
        imm r23, 3
        call skip_scan_call_region
        ret
