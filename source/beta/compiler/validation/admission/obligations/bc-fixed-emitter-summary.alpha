; Exact trace summaries for bc.emit_prelude and bc.emit_write_str.
;
; The preceding phase gives each fixed emit event a conditional helper trace
; clause.  These two call-free source procedures contain only ordered emit
; statements, so this phase joins those clauses along the exact Alpha control
; chain instead of expanding 187 byte writes:
;
;   emit_prelude   five unique semantic emit keys -> 65 bytes
;   emit_write_str rows 221..232 -> 132 bytes
;
; Each inline-literal jump begins at the preceding call continuation; the final
; continuation begins the checked epilogue.  Direct region scans prove there
; are no other calls, input reads, direct writes, halts, or arithmetic traps.
; Source tables prove there are no local/raw-memory actions or transitions.
; Hence both procedures terminate, preserve the input cursor and compiler
; heap/raw state, restore r14/r15 and the caller frame, and append exactly their
; Beta emit literals in source order.  Caller-saved r0..r3 and reclaimed
; stack/hidden-return scratch are deliberately outside that preservation claim.
;
; Fresh cells:
;   next Alpha pc / output length     525888/525896
;   event count / legacy next row     525904/525912
;   legacy row token / source block   525920/525928
;   exclusive end pc                  525936
;   prelude/write-str theorem tokens  525944/525952

; Checker-A continuation.  The alias is deliberately source-only: the shared
; WSTR theorem can use a distinct checked continuation in another checker
; without adding one byte to Checker A.
bc_post_write_str:
fixed_emitter_summary_init:
        call fixed_emit_prove_write_str
        call fixed_emit_prove_prelude
        jmp cursor_leaf_summary_init

fixed_emit_prove_write_str:
        imm r20, 29                   ; procedure
        imm r21, 147                  ; entry block
        imm r22, 30                   ; next procedure / exclusive end
        imm r23, 221                  ; first event row
        imm r24, 12                   ; exact helper-call count
        call fixed_emit_begin

        imm r20, 221
        call fixed_emit_append
        imm r20, 222
        call fixed_emit_append
        imm r20, 223
        call fixed_emit_append
        imm r20, 224
        call fixed_emit_append
        imm r20, 225
        call fixed_emit_append
        imm r20, 226
        call fixed_emit_append
        imm r20, 227
        call fixed_emit_append
        imm r20, 228
        call fixed_emit_append
        imm r20, 229
        call fixed_emit_append
        imm r20, 230
        call fixed_emit_append
        imm r20, 231
        call fixed_emit_append
        imm r20, 232
        call fixed_emit_append

        imm r20, 233                  ; exclusive event row
        imm r21, 12                   ; event count
        imm r22, 132                  ; exact output bytes
        call fixed_emit_finish
        imm r1, 525952
        imm r2, 1465008983            ; WSTW
        store r1, r2
        ret

fixed_emit_prove_prelude:
        imm r20, 41                   ; procedure
        imm r21, 208                  ; entry block
        imm r22, 42                   ; next procedure / exclusive end
        imm r23, 0                    ; row token unused by identity consumer
        imm r24, 5                    ; exact helper-call count
        call fixed_emit_begin

        imm r20, 41
        imm r21, 208
        imm r22, fixed_emit_literal_comment
        imm r23, 5
        call fixed_emit_append_identity
        imm r20, 41
        imm r21, 208
        imm r22, fixed_emit_literal_sp
        imm r23, 16
        call fixed_emit_append_identity
        imm r20, 41
        imm r21, 208
        imm r22, fixed_emit_literal_fp
        imm r23, 26
        call fixed_emit_append_identity
        imm r20, 41
        imm r21, 208
        imm r22, fixed_emit_literal_call_main
        imm r23, 10
        call fixed_emit_append_identity
        imm r20, 41
        imm r21, 208
        imm r22, fixed_emit_literal_halt
        imm r23, 8
        call fixed_emit_append_identity

        imm r20, 5                    ; exact semantic event count
        imm r21, 65                   ; checked prelude byte total
        call fixed_emit_finish_identity
        imm r1, 525944
        imm r2, 1279607365            ; EMIP
        store r1, r2
        ret

; Begin procedure proc/block/next-proc/first-event/call-count in r20..r24.
; Procedure identities reconstruct the artifact region; callers do not supply
; either coordinate.
fixed_emit_begin:
        mov r25, r20
        mov r26, r21
        mov r30, r22
        mov r29, r23
        mov r31, r24

        mov r0, r25
        call exact_proc_entry_pc
        mov r27, r0                  ; checked entry
        mov r0, r30
        call exact_proc_entry_pc
        mov r28, r0                  ; checked exclusive end

        mov r20, r25
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call exact_require_proc_frame_identity
        jmp fixed_emit_begin_block_proc
fixed_emit_begin_block_proc:
        mov r20, r26
        mov r21, r25
        imm r22, 0                   ; unique procedure entry block
        call exact_block_identity_pc
        jeq r0, r27, fixed_emit_begin_unique_proc
        jmp reject
fixed_emit_begin_unique_proc:
        mov r20, r25
        mov r21, r26
        call fixed_emit_require_unique_block

        ; The zero-slot checked prologue is 9 bytes before the first inline
        ; literal jump. Initialize an empty ordered trace at that continuation.
        mov r2, r27
        imm r1, 9
        add r2, r1
        imm r1, 525888
        store r1, r2
        imm r1, 525896
        imm r2, 0
        store r1, r2
        imm r1, 525904
        store r1, r2
        imm r1, 525912
        store r1, r29
        imm r1, 525920
        store r1, r29                 ; empty Rows[first:first]
        imm r1, 525928
        store r1, r26
        imm r1, 525936
        store r1, r28

        mov r20, r26
        call fixed_emit_require_source_quiet
        mov r20, r27
        mov r21, r28
        mov r22, r31
        call fixed_emit_scan_region
        ret

; Procedure r20 must own exactly block r21 among all 355 parsed blocks.
fixed_emit_require_unique_block:
        mov r25, r20
        mov r26, r21
        imm r10, 0
        imm r11, 0
fixed_emit_unique_loop:
        imm r1, 355
        jlt r10, r1, fixed_emit_unique_row
        imm r3, 1                    ; exact procedure block count
        jeq r11, r3, fixed_emit_unique_done
        jmp reject
fixed_emit_unique_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 3145728
        add r1, r2
        load r3, r1
        jeq r3, r25, fixed_emit_unique_match
        jmp fixed_emit_unique_next
fixed_emit_unique_match:
        jeq r10, r26, fixed_emit_unique_count
        jmp reject
fixed_emit_unique_count:
        imm r1, 1
        add r11, r1
fixed_emit_unique_next:
        imm r1, 1
        add r10, r1
        jmp fixed_emit_unique_loop
fixed_emit_unique_done:
        ret

; Append exact event row r20 to the ordered output token.
fixed_emit_append:
        mov r25, r20
        imm r1, 525912
        load r2, r1
        jeq r2, r25, fixed_emit_append_block
        jmp reject
fixed_emit_append_block:
        mov r26, r25
        imm r1, 8
        mul r26, r1
        imm r1, 7077888
        add r1, r26
        load r2, r1
        imm r1, 525928
        load r3, r1
        jeq r2, r3, fixed_emit_append_clause
        jmp reject
fixed_emit_append_clause:
        mov r20, r25
        call write_str_require_emit_event
        mov r27, r0                  ; literal p
        mov r28, r1                  ; literal len

        ; The next executable pc must be this event's inline-data jump p-9.
        mov r2, r27
        imm r3, 9
        sub r2, r3
        imm r1, 525888
        load r3, r1
        jeq r2, r3, fixed_emit_append_length
        jmp reject
fixed_emit_append_length:
        imm r1, 525896
        load r2, r1
        add r2, r28
        store r1, r2
        imm r1, 525904
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2

        ; Advance the ordered Rows[first:row+1] token and exact continuation.
        mov r29, r25
        imm r3, 1
        add r29, r3
        imm r1, 525912
        store r1, r29
        imm r1, 525920
        store r1, r29
        imm r1, 7135232
        add r1, r26
        load r2, r1                  ; call pc
        imm r3, 9                    ; checked call continuation width
        add r2, r3
        imm r1, 525888
        store r1, r2
        ret

; Resolve one unique emit by complete semantic key, then reuse the ordered
; artifact/literal trace. Inputs are procedure/block/literal/length r20..r23.
fixed_emit_append_identity:
        call exact_unique_emit_event_identity
        mov r20, r1                  ; checker-selected row, never caller input
        imm r1, 525912
        store r1, r20                ; seed legacy append's local row token
        call fixed_emit_append
        ret

; Finish expected exclusive-row/count/length in r20..r22.
fixed_emit_finish:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        imm r1, 525912
        load r2, r1
        jeq r2, r25, fixed_emit_finish_token
        jmp reject
fixed_emit_finish_token:
        imm r1, 525920
        load r2, r1
        jeq r2, r25, fixed_emit_finish_count
        jmp reject
fixed_emit_finish_count:
        imm r1, 525904
        load r2, r1
        jeq r2, r26, fixed_emit_finish_length
        jmp reject
fixed_emit_finish_length:
        imm r1, 525896
        load r2, r1
        jeq r2, r27, fixed_emit_finish_epilogue
        jmp reject
fixed_emit_finish_epilogue:
        imm r1, 525936
        load r2, r1                  ; exclusive end
        mov r3, r2
        imm r4, 10
        sub r3, r4                   ; epilogue start
        imm r1, 525888
        load r4, r1
        jeq r4, r3, fixed_emit_finish_ret
        jmp reject
fixed_emit_finish_ret:
        mov r20, r3
        mov r21, r2
        imm r1, 1
        sub r21, r1                  ; exact ret pc
        call exact_require_epilogue
        ret

; Row-free finish for a semantic-key sequence. Inputs are exact count/length
; in r20/r21; artifact continuation and epilogue remain independently linked.
fixed_emit_finish_identity:
        imm r1, 525904
        load r2, r1
        jeq r2, r20, fixed_emit_finish_identity_length
        jmp reject
fixed_emit_finish_identity_length:
        imm r1, 525896
        load r2, r1
        jeq r2, r21, fixed_emit_finish_epilogue
        jmp reject

; No source transition, local access, or raw-memory action belongs to block r20.
fixed_emit_require_source_quiet:
        mov r25, r20
        imm r10, 0
fixed_emit_transition_loop:
        imm r1, 291
        jlt r10, r1, fixed_emit_transition_row
        imm r10, 0
        jmp fixed_emit_local_loop
fixed_emit_transition_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 3215360
        add r1, r2
        load r3, r1
        jeq r3, r25, reject
        imm r1, 1
        add r10, r1
        jmp fixed_emit_transition_loop
fixed_emit_local_loop:
        imm r1, 242
        jlt r10, r1, fixed_emit_local_row
        imm r10, 0
        jmp fixed_emit_memory_loop
fixed_emit_local_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 7168000
        add r1, r2
        load r3, r1
        jeq r3, r25, reject
        imm r1, 1
        add r10, r1
        jmp fixed_emit_local_loop
fixed_emit_memory_loop:
        imm r1, 95
        jlt r10, r1, fixed_emit_memory_row
        ret
fixed_emit_memory_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 7602176
        add r1, r2
        load r3, r1
        jeq r3, r25, reject
        imm r1, 1
        add r10, r1
        jmp fixed_emit_memory_loop

; Scan [r20,r21): only the selected helper calls plus one final ret may be
; effectful. Reject direct I/O, halt, division, remainder, or hidden extra call.
; Exact expected call count is r22.
fixed_emit_scan_region:
        mov r25, r20
        mov r26, r21
        mov r29, r22                 ; expected calls
        imm r27, 0                   ; calls
        imm r28, 0                   ; returns
fixed_emit_region_loop:
        jlt r25, r26, fixed_emit_region_pc
        imm r1, 1
        jeq r28, r1, fixed_emit_region_call_count
        jmp reject
fixed_emit_region_call_count:
        jeq r27, r29, fixed_emit_region_done
        jmp reject
fixed_emit_region_pc:
        imm r1, 4194304
        add r1, r25
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, fixed_emit_region_start
        jmp fixed_emit_region_next
fixed_emit_region_start:
        imm r1, 2097152
        add r1, r25
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, fixed_emit_region_call
        imm r3, 20
        jeq r2, r3, fixed_emit_region_ret
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 6
        jeq r2, r3, reject
        imm r3, 7
        jeq r2, r3, reject
        imm r3, 17
        jeq r2, r3, reject
        imm r3, 18
        jeq r2, r3, reject
        jmp fixed_emit_region_next
fixed_emit_region_call:
        imm r1, 1
        add r27, r1
        jmp fixed_emit_region_next
fixed_emit_region_ret:
        imm r1, 1
        add r28, r1
fixed_emit_region_next:
        imm r1, 1
        add r25, r1
        jmp fixed_emit_region_loop
fixed_emit_region_done:
        ret

fixed_emit_literal_comment:
        db "; bc\n"
fixed_emit_literal_sp:
        db "imm r15,1048576\n"
fixed_emit_literal_fp:
        db "imm r14,1048576\nimm r13,8\n"
fixed_emit_literal_call_main:
        db "call main\n"
fixed_emit_literal_halt:
        db "halt r0\n"
