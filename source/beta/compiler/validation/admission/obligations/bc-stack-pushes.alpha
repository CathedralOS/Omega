; Complete data-stack push custody for the whole-bc BCT8 checker.
;
; Source records are reconstructed from the already independent primitive,
; call-arity, and raw-memory tables: 235 binary-left pushes, 134 ordinary-call
; argument pushes, and 34 store-address pushes. Every lowering uses the same
; exact 16-byte macro, so this phase proves block-local multiset/shape custody.
;
; Source block: 9437184. Kind: 9445376. Witness PC: 9453568.
; Per-tape-byte owner map: 9461760.

build_stack_push_sources_init:
        imm r10, 0
build_binary_push_sources:
        imm r1, 829
        jlt r10, r1, build_binary_push_source_one
        jmp build_argument_push_sources_init
build_binary_push_source_one:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 8396800
        add r1, r12
        load r2, r1
        imm r3, 2
        jeq r2, r3, build_binary_push_source_add
        imm r3, 3
        jeq r2, r3, build_binary_push_source_add
        jmp build_binary_push_source_next
build_binary_push_source_add:
        imm r1, 8388608
        add r1, r12
        load r7, r1
        imm r6, 1
        call add_stack_push_source
build_binary_push_source_next:
        imm r1, 1
        add r10, r1
        jmp build_binary_push_sources

build_argument_push_sources_init:
        imm r10, 0
build_argument_push_sources:
        imm r1, 617
        jlt r10, r1, build_argument_push_source_event
        jmp build_store_push_sources_init
build_argument_push_source_event:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7086080
        add r1, r12
        load r2, r1
        imm r3, 1
        jeq r2, r3, build_argument_push_source_arity
        jmp build_argument_push_source_next
build_argument_push_source_arity:
        imm r1, 7143424
        add r1, r12
        load r11, r1
        imm r1, 7077888
        add r1, r12
        load r13, r1
build_argument_push_source_each:
        imm r1, 0
        jlt r1, r11, build_argument_push_source_add
        jmp build_argument_push_source_next
build_argument_push_source_add:
        imm r6, 2
        mov r7, r13
        call add_stack_push_source
        imm r1, 1
        sub r11, r1
        jmp build_argument_push_source_each
build_argument_push_source_next:
        imm r1, 1
        add r10, r1
        jmp build_argument_push_sources

build_store_push_sources_init:
        imm r10, 0
build_store_push_sources:
        imm r1, 101
        jlt r10, r1, build_store_push_source_one
        jmp check_stack_push_source_counts
build_store_push_source_one:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 7610368
        add r1, r12
        load r2, r1
        imm r3, 2
        jeq r2, r3, build_store_push_source_add
        jmp build_store_push_source_next
build_store_push_source_add:
        imm r1, 7602176
        add r1, r12
        load r7, r1
        imm r6, 3
        call add_stack_push_source
build_store_push_source_next:
        imm r1, 1
        add r10, r1
        jmp build_store_push_sources

; r6 kind: 1 binary-left, 2 call-argument, 3 store-address. r7 source block.
add_stack_push_source:
        imm r1, 524752
        load r2, r1
        imm r3, 512
        jlt r2, r3, add_stack_push_source_room
        jmp reject
add_stack_push_source_room:
        mov r4, r2
        imm r5, 8
        mul r4, r5
        imm r5, 9437184
        add r5, r4
        store r5, r7
        imm r5, 9445376
        add r5, r4
        store r5, r6
        imm r3, 1
        add r2, r3
        imm r1, 524752
        store r1, r2
        imm r1, 1
        jeq r6, r1, count_binary_push_source
        imm r1, 2
        jeq r6, r1, count_argument_push_source
        imm r1, 3
        jeq r6, r1, count_store_push_source
        jmp reject
count_binary_push_source:
        imm r1, 524760
        jmp exact_increment_cell
count_argument_push_source:
        imm r1, 524768
        jmp exact_increment_cell
count_store_push_source:
        imm r1, 524776
        jmp exact_increment_cell

check_stack_push_source_counts:
        imm r1, 524752
        load r2, r1
        imm r3, 407
        jeq r2, r3, check_binary_push_source_count
        jmp reject
check_binary_push_source_count:
        imm r1, 524760
        load r2, r1
        imm r3, 237
        jeq r2, r3, check_argument_push_source_count
        jmp reject
check_argument_push_source_count:
        imm r1, 524768
        load r2, r1
        imm r3, 134
        jeq r2, r3, check_store_push_source_count
        jmp reject
check_store_push_source_count:
        imm r1, 524776
        load r2, r1
        imm r3, 36
        jeq r2, r3, resolve_init
        jmp reject

read_stack_push_pcs_init:
        imm r20, 407                  ; exact push rows
        imm r21, 9437184              ; source block table
        imm r22, 9453568              ; selected PC table
        call exact_ingest_bounded_site_pcs
        jmp read_helper_pc

validate_stack_pushes_init:
        imm r10, 0
validate_stack_push_loop:
        imm r1, 407
        jlt r10, r1, validate_stack_push_one
        jmp scan_stack_push_artifact_init
validate_stack_push_one:
        mov r12, r10
        imm r1, 8
        mul r12, r1
        imm r1, 9453568
        add r1, r12
        load r14, r1
        imm r1, 9461760
        add r1, r14
        loadb r2, r1
        imm r3, 0
        jeq r2, r3, own_stack_push
        jmp reject
own_stack_push:
        imm r2, 1
        storeb r1, r2
        call exact_match_push
        imm r1, 1
        jeq r0, r1, validate_stack_push_next
        jmp reject
validate_stack_push_next:
        imm r1, 1
        add r10, r1
        jmp validate_stack_push_loop

scan_stack_push_artifact_init:
        imm r10, 0
scan_stack_push_artifact_loop:
        imm r1, 524296
        load r2, r1
        jlt r10, r2, scan_stack_push_artifact_pc
        jmp scan_stack_push_artifact_count
scan_stack_push_artifact_pc:
        imm r1, 4194304
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, scan_stack_push_artifact_start
        jmp scan_stack_push_artifact_next
scan_stack_push_artifact_start:
        mov r14, r10
        call exact_match_push
        imm r1, 1
        jeq r0, r1, scan_stack_push_artifact_owned
        jmp scan_stack_push_artifact_next
scan_stack_push_artifact_owned:
        imm r1, 9461760
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, count_stack_push_artifact
        jmp reject
count_stack_push_artifact:
        imm r1, 524784
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
scan_stack_push_artifact_next:
        imm r1, 1
        add r10, r1
        jmp scan_stack_push_artifact_loop
scan_stack_push_artifact_count:
        imm r1, 524784
        load r2, r1
        imm r3, 407
        jeq r2, r3, build_expr_census_prefix_init
        jmp reject

; Compact exact-shape adapters keep the push-kind proposition explicit while
; avoiding hundreds of repeated immediate loads at individual call sites.
exact_require_binary_push:
        imm r22, 1
        call transfer_require_push
        ret
exact_require_argument_push:
        imm r22, 2
        call transfer_require_push
        ret
exact_require_store_push:
        imm r22, 3
        call transfer_require_push
        ret

; Stable-identity adapters omit the artifact PC. The independently rebuilt
; push row supplies it only after its source block and semantic kind match.
exact_require_binary_push_identity:
        imm r22, 1
        call exact_push_identity_pc
        ret
exact_require_argument_push_identity:
        imm r22, 2
        call exact_push_identity_pc
        ret
exact_require_store_push_identity:
        imm r22, 3
        call exact_push_identity_pc
        ret
