; Exact source/artifact shape for expression leaves gen_load() and
; gen_write_byte() (procedures25 and31).
;
; This module has no initialization edge and publishes no semantic token.  Its
; single public entry rejoins procedure metadata, every block/transition/effect,
; explicit and synthetic epilogues, local/expression rows, exhaustive table
; censuses, and exact decoded-region totals.  Recursive child meaning belongs to
; the adjacent expression induction.

expression_leaf_require_shape:
        call expression_leaf_require_proc_meta
        call expression_leaf_require_blocks
        call expression_leaf_require_transitions
        call expression_leaf_require_events
        call expression_leaf_require_data
        call expression_leaf_require_censuses
        call expression_leaf_require_regions
        ret

; r20=procedure, r21=parameter count, r22=slot count, r23=frame bytes.
expression_leaf_require_one_proc:
        call exact_require_proc_frame_identity
        ret

expression_leaf_require_proc_meta:
        imm r20, 25
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call expression_leaf_require_one_proc
        imm r20, 31
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call expression_leaf_require_one_proc
        ret

expression_leaf_require_blocks:
        imm r20, 132
        imm r21, 25                    ; gen_load procedure identity
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 133
        imm r21, 25
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 134
        imm r21, 25
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 135
        imm r21, 25
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 132
        imm r21, 135
        imm r22, 25
        call exact_require_proc_blocks
        imm r20, 149
        imm r21, 31                    ; gen_write_byte procedure identity
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 149
        imm r21, 149
        imm r22, 31
        call exact_require_proc_blocks
        ret

expression_leaf_require_transitions:
        imm r20, 98
        imm r21, 133
        imm r22, 1
        imm r23, 134
        call exact_transition_identity_pc
        imm r20, 99
        imm r21, 133
        imm r22, 0
        imm r23, 135
        call exact_transition_identity_pc
        ret

; r20=procedure,r21=block,r22=verifier literal,r23=length.
expression_leaf_require_emit:
        call exact_unique_emit_event_identity
        mov r14, r0
        mov r10, r1
        call check_emit_at_call
        ret

; r20=owning procedure, r21=source block, r22=arity, r23=target procedure.
; The event owner reconstructs the unique call PC, target entry, and fallthrough.
expression_leaf_require_call:
        mov r24, r23
        imm r23, 0
        call summary_require_call_fallthrough_identity
        ret

; As above, with occurrence/cardinality in r24/r25 for a repeated complete key.
expression_leaf_require_nth_call:
        mov r26, r25
        mov r25, r24
        mov r24, r23
        imm r23, 0
        call summary_require_nth_call_fallthrough_identity
        ret

expression_leaf_require_events:
        ; gen_load entry: expect('['), recursive expression, expect(']').
        imm r20, 25                    ; gen_load owning procedure identity
        imm r21, 132
        imm r22, 1
        imm r23, 24                    ; expect procedure identity
        imm r24, 0                     ; first of two identical complete keys
        imm r25, 2                     ; exact cardinality
        call expression_leaf_require_nth_call
        imm r20, 25
        imm r21, 132
        imm r22, 0
        imm r23, 61                    ; gen_expr procedure identity
        call expression_leaf_require_call
        imm r20, 25
        imm r21, 132
        imm r22, 1
        imm r23, 24                    ; expect procedure identity
        imm r24, 1                     ; second of two identical complete keys
        imm r25, 2                     ; exact cardinality
        call expression_leaf_require_nth_call
        imm r20, 25
        imm r21, 134
        imm r22, expression_leaf_literal_loadb
        imm r23, 12
        call expression_leaf_require_emit
        imm r20, 25
        imm r21, 134
        call exact_require_event_epilogue
        imm r20, 25
        imm r21, 135
        imm r22, expression_leaf_literal_load
        imm r23, 11
        call expression_leaf_require_emit
        imm r20, 25
        imm r21, 135
        call exact_require_event_epilogue
        imm r20, 26                    ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue

        ; gen_write_byte entry and fixed output.
        imm r20, 31                    ; gen_write_byte owning procedure identity
        imm r21, 149
        imm r22, 1
        imm r23, 24                    ; expect procedure identity
        imm r24, 0                     ; first of two identical complete keys
        imm r25, 2                     ; exact cardinality
        call expression_leaf_require_nth_call
        imm r20, 31
        imm r21, 149
        imm r22, 0
        imm r23, 61                    ; gen_expr procedure identity
        call expression_leaf_require_call
        imm r20, 31
        imm r21, 149
        imm r22, 1
        imm r23, 24                    ; expect procedure identity
        imm r24, 1                     ; second of two identical complete keys
        imm r25, 2                     ; exact cardinality
        call expression_leaf_require_nth_call
        imm r20, 31
        imm r21, 149
        imm r22, expression_leaf_literal_write
        imm r23, 9
        call expression_leaf_require_emit
        imm r20, 31
        imm r21, 149
        call exact_require_event_epilogue
        imm r20, 32                    ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

expression_leaf_require_data:
        ; gen_load parameter w.
        imm r20, 35
        imm r21, 133
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc

        ; gen_load expression rows.
        imm r20, 356
        imm r21, 132
        imm r22, 1
        imm r23, 91
        call exact_primitive_identity_pc
        imm r20, 357
        imm r21, 132
        imm r22, 1
        imm r23, 93
        call exact_primitive_identity_pc
        imm r20, 358
        imm r21, 133
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 359
        imm r21, 133
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 360
        imm r21, 134
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 361
        imm r21, 135
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 91
        imm r21, 133
        call exact_require_binary_push_identity
        imm r20, 293
        imm r21, 132
        call exact_require_argument_push_identity
        imm r20, 294
        imm r21, 132
        call exact_require_argument_push_identity

        ; gen_write_byte expression rows.
        imm r20, 388
        imm r21, 149
        imm r22, 1
        imm r23, 40
        call exact_primitive_identity_pc
        imm r20, 389
        imm r21, 149
        imm r22, 1
        imm r23, 41
        call exact_primitive_identity_pc
        imm r20, 390
        imm r21, 149
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 308
        imm r21, 149
        call exact_require_argument_push_identity
        imm r20, 309
        imm r21, 149
        call exact_require_argument_push_identity
        ret

expression_leaf_require_censuses:
        ; gen_load owns no raw-memory rows or store-address pushes.
        imm r20, 132
        imm r21, 135
        imm r22, 35
        imm r23, 36
        imm r24, 33
        imm r25, 33
        imm r26, 98
        imm r27, 100
        imm r28, 165
        imm r29, 172
        call exact_require_effect_census
        imm r20, 132
        imm r21, 135
        imm r22, 356
        imm r23, 362
        imm r24, 91
        imm r25, 92
        imm r26, 293
        imm r27, 295
        imm r28, 383
        imm r29, 383
        call summary_require_expr_census

        ; gen_write_byte has only primitive and argument-push rows.
        imm r20, 149
        imm r21, 149
        imm r22, 52
        imm r23, 52
        imm r24, 33
        imm r25, 33
        imm r26, 108
        imm r27, 108
        imm r28, 237
        imm r29, 242
        call exact_require_effect_census
        imm r20, 149
        imm r21, 149
        imm r22, 388
        imm r23, 391
        imm r24, 98
        imm r25, 98
        imm r26, 308
        imm r27, 310
        imm r28, 383
        imm r29, 383
        call summary_require_expr_census
        ret

expression_leaf_require_regions:
        imm r20, 25                    ; gen_load procedure identity
        call exact_proc_entry_r20
        imm r21, 26                    ; gen_store procedure identity / end
        call exact_proc_entry_r21
        imm r22, 5
        imm r23, 3
        imm r24, 5
        call exact_quiet_scan_region
        imm r20, 31                    ; gen_write_byte procedure identity
        call exact_proc_entry_r20
        imm r21, 32                    ; gen_call procedure identity / end
        call exact_proc_entry_r21
        imm r22, 4
        imm r23, 2
        imm r24, 3
        call exact_quiet_scan_region
        ret

expression_leaf_literal_loadb:
        db "loadb r0,r0\n"
expression_leaf_literal_load:
        db "load r0,r0\n"
expression_leaf_literal_write:
        db "write r0\n"
