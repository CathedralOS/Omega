; Exact source/artifact shape for expression leaves gen_load() and
; gen_write_byte() (procedures25 and31).
;
; This module has no initialization edge and publishes no semantic token.  Its
; single public entry rejoins procedure metadata, every block/transition/effect,
; explicit and synthetic epilogues, local/expression rows, exhaustive table
; censuses, and exact decoded-region totals.  Recursive child meaning belongs to
; the adjacent expression induction.

expression_leaf_require_shape:
        call expression_leaf_require_proc_meta
        call expression_leaf_require_blocks
        call expression_leaf_require_transitions
        call expression_leaf_require_events
        call expression_leaf_require_data
        call expression_leaf_require_censuses
        call expression_leaf_require_regions
        ret

; r20=procedure, r21=parameter count, r22=slot count, r23=frame bytes.
expression_leaf_require_one_proc:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        imm r20, 7151616
        mov r21, r30
        mov r22, r31
        call transfer_require_cell
        imm r20, 7159808
        mov r21, r30
        mov r22, r32
        call transfer_require_cell
        mov r20, r30
        call call_bounds_frame_bytes
        jeq r0, r33, exact_shape_ok
        jmp reject

expression_leaf_require_proc_meta:
        imm r20, 25
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call expression_leaf_require_one_proc
        imm r20, 31
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call expression_leaf_require_one_proc
        ret

expression_leaf_require_blocks:
        imm r20, 132
        imm r21, 17712
        call exact_require_block_pc
        imm r20, 133
        imm r21, 17874
        call exact_require_block_pc
        imm r20, 134
        imm r21, 18006
        call exact_require_block_pc
        imm r20, 135
        imm r21, 18086
        call exact_require_block_pc
        imm r20, 132
        imm r21, 135
        imm r22, 25
        call exact_require_proc_blocks
        imm r20, 149
        imm r21, 21443
        call exact_require_block_pc
        imm r20, 149
        imm r21, 149
        imm r22, 31
        call exact_require_proc_blocks
        ret

expression_leaf_require_transitions:
        imm r20, 98
        imm r21, 133
        imm r22, 1
        imm r23, 134
        imm r24, 17978
        call exact_require_transition
        imm r20, 99
        imm r21, 133
        imm r22, 0
        imm r23, 135
        imm r24, 17997
        call exact_require_transition
        ret

; r20=row, r21=block, r22=event PC.
expression_leaf_require_emit:
        mov r23, r22
        imm r22, 4
        call exact_require_event
        ret

expression_leaf_require_events:
        ; gen_load entry: expect('['), recursive expression, expect(']').
        imm r20, 165
        imm r21, 132
        imm r22, 17805
        imm r23, 1
        imm r24, 0
        imm r25, 17441
        imm r26, 17814
        call summary_require_call_site
        imm r20, 166
        imm r21, 132
        imm r22, 17814
        imm r23, 0
        imm r24, 0
        imm r25, 61                    ; gen_expr procedure identity
        call exact_proc_entry_r25
        imm r26, 17823
        call summary_require_call_site
        imm r20, 167
        imm r21, 132
        imm r22, 17865
        imm r23, 1
        imm r24, 0
        imm r25, 17441
        imm r26, 17874
        call summary_require_call_site
        imm r20, 168
        imm r21, 134
        imm r22, 18047
        call expression_leaf_require_emit
        imm r20, 169
        imm r21, 134
        imm r22, 5
        imm r23, 18085
        call exact_require_event
        imm r20, 170
        imm r21, 135
        imm r22, 18126
        call expression_leaf_require_emit
        imm r20, 171
        imm r21, 135
        imm r22, 5
        imm r23, 18164
        call exact_require_event

        ; gen_write_byte entry and fixed output.
        imm r20, 237
        imm r21, 149
        imm r22, 21504
        imm r23, 1
        imm r24, 0
        imm r25, 17441
        imm r26, 21513
        call summary_require_call_site
        imm r20, 238
        imm r21, 149
        imm r22, 21513
        imm r23, 0
        imm r24, 0
        imm r25, 61                    ; gen_expr procedure identity
        call exact_proc_entry_r25
        imm r26, 21522
        call summary_require_call_site
        imm r20, 239
        imm r21, 149
        imm r22, 21564
        imm r23, 1
        imm r24, 0
        imm r25, 17441
        imm r26, 21573
        call summary_require_call_site
        imm r20, 240
        imm r21, 149
        imm r22, 21611
        call expression_leaf_require_emit
        imm r20, 241
        imm r21, 149
        imm r22, 5
        imm r23, 21649
        call exact_require_event

        ; Every explicit source return and each compiler-added fallthrough.
        imm r20, 18066
        imm r21, 18085
        call exact_require_epilogue
        imm r20, 18145
        imm r21, 18164
        call exact_require_epilogue
        imm r20, 18165
        imm r21, 18184
        call exact_require_epilogue
        imm r20, 21630
        imm r21, 21649
        call exact_require_epilogue
        imm r20, 21650
        imm r21, 21669
        call exact_require_epilogue
        ret

expression_leaf_require_data:
        ; gen_load parameter w.
        imm r20, 35
        imm r21, 133
        imm r22, 1
        imm r23, 0
        imm r24, 17874
        call transfer_require_local

        ; gen_load expression rows.
        imm r20, 356
        imm r21, 132
        imm r22, 1
        imm r23, 91
        imm r24, 17763
        call transfer_require_primitive
        imm r20, 357
        imm r21, 132
        imm r22, 1
        imm r23, 93
        imm r24, 17823
        call transfer_require_primitive
        imm r20, 358
        imm r21, 133
        imm r22, 3
        imm r23, 10
        imm r24, 17919
        call transfer_require_primitive
        imm r20, 359
        imm r21, 133
        imm r22, 1
        imm r23, 1
        imm r24, 17909
        call transfer_require_primitive
        imm r20, 360
        imm r21, 134
        imm r22, 1
        imm r23, 0
        imm r24, 18056
        call transfer_require_primitive
        imm r20, 361
        imm r21, 135
        imm r22, 1
        imm r23, 0
        imm r24, 18135
        call transfer_require_primitive
        imm r20, 91
        imm r21, 133
        imm r23, 17893
        call exact_require_binary_push
        imm r20, 293
        imm r21, 132
        imm r23, 17773
        call exact_require_argument_push
        imm r20, 294
        imm r21, 132
        imm r23, 17833
        call exact_require_argument_push

        ; gen_write_byte expression rows.
        imm r20, 388
        imm r21, 149
        imm r22, 1
        imm r23, 40
        imm r24, 21462
        call transfer_require_primitive
        imm r20, 389
        imm r21, 149
        imm r22, 1
        imm r23, 41
        imm r24, 21522
        call transfer_require_primitive
        imm r20, 390
        imm r21, 149
        imm r22, 1
        imm r23, 0
        imm r24, 21620
        call transfer_require_primitive
        imm r20, 308
        imm r21, 149
        imm r23, 21472
        call exact_require_argument_push
        imm r20, 309
        imm r21, 149
        imm r23, 21532
        call exact_require_argument_push
        ret

expression_leaf_require_censuses:
        ; gen_load owns no raw-memory rows or store-address pushes.
        imm r20, 132
        imm r21, 135
        imm r22, 35
        imm r23, 36
        imm r24, 33
        imm r25, 33
        imm r26, 98
        imm r27, 100
        imm r28, 165
        imm r29, 172
        call exact_require_effect_census
        imm r20, 132
        imm r21, 135
        imm r22, 356
        imm r23, 362
        imm r24, 91
        imm r25, 92
        imm r26, 293
        imm r27, 295
        imm r28, 383
        imm r29, 383
        call summary_require_expr_census

        ; gen_write_byte has only primitive and argument-push rows.
        imm r20, 149
        imm r21, 149
        imm r22, 52
        imm r23, 52
        imm r24, 33
        imm r25, 33
        imm r26, 108
        imm r27, 108
        imm r28, 237
        imm r29, 242
        call exact_require_effect_census
        imm r20, 149
        imm r21, 149
        imm r22, 388
        imm r23, 391
        imm r24, 98
        imm r25, 98
        imm r26, 308
        imm r27, 310
        imm r28, 383
        imm r29, 383
        call summary_require_expr_census
        ret

expression_leaf_require_regions:
        imm r20, 17712
        imm r21, 18185
        imm r22, 5
        imm r23, 3
        imm r24, 5
        call exact_quiet_scan_region
        imm r20, 21443
        imm r21, 21670
        imm r22, 4
        imm r23, 2
        imm r24, 3
        call exact_quiet_scan_region
        ret
