; Exact antecedent schema for the conditional statement theorem.
;
; Each row records (external process-local cell, public proposition tag, owner):
;   owner1 Checker A lexical/cursor/declaration/block-boundary package
;   owner2 Checker B lookup/name-domain package
;   owner3 Checker C bounded emitter package
;   owner4 Checker E label emitter package
;   owner5 Checker F expression semantic package
;   owner6 independent statement exact-shape package
;
; Recording a row does not claim its proposition is true in this process. The
; final publication is explicitly their implication. The gate establishes every
; antecedent by running its owner over the identical control.bundle.

statement_antecedent_init:
        imm r20, 546100
        imm r21, 1481787731             ; SIRX
        call exact_require_cell
        imm r1, 546240
        imm r2, 0
        store r1, r2

        ; Checker A: terminating cursor/identifier/declaration leaves and GSBD.
        imm r20, 526216
        imm r21, 1398231888             ; SWSQ
        imm r22, 1
        call statement_antecedent_record
        imm r20, 525960
        imm r21, 1128421445             ; CBLE
        imm r22, 1
        call statement_antecedent_record
        imm r20, 525968
        imm r21, 1094992965             ; ADVE
        imm r22, 1
        call statement_antecedent_record
        imm r20, 526960
        imm r21, 1397774405             ; EXPS
        imm r22, 1
        call statement_antecedent_record
        imm r20, 526792
        imm r21, 1396984146             ; RIDS
        imm r22, 1
        call statement_antecedent_record
        imm r20, 530456
        imm r21, 1398231878             ; FKWS
        imm r22, 1
        call statement_antecedent_record
        imm r20, 527064
        imm r21, 1397506884             ; DCLS
        imm r22, 1
        call statement_antecedent_record
        imm r20, 528192
        imm r21, 1396984133             ; EIDS
        imm r22, 1
        call statement_antecedent_record
        imm r20, 528856
        imm r21, 1145197383             ; GSBD
        imm r22, 1
        call statement_antecedent_record
        imm r20, 525816
        imm r21, 1465074514             ; WSTR
        imm r22, 1
        call statement_antecedent_record

        ; Independent semantic/shape processes.
        imm r20, 532144
        imm r21, 1263488844             ; LOOK
        imm r22, 2
        call statement_antecedent_record
        imm r20, 532120
        imm r21, 1397572930             ; BEMS
        imm r22, 3
        call statement_antecedent_record
        imm r20, 534880
        imm r21, 1263547717             ; E5PK
        imm r22, 4
        call statement_antecedent_record
        imm r20, 540088
        imm r21, 1112559704             ; XPUB
        imm r22, 5
        call statement_antecedent_record
        imm r20, 546016
        imm r21, 1279808339             ; SSHL
        imm r22, 6
        call statement_antecedent_record

        call statement_antecedent_require_rows
        call statement_antecedent_publish_packages
        jmp statement_emit_epilogue_rules_init

; Append one immutable 24-byte row. r20=external cell,r21=tag,r22=owner.
statement_antecedent_record:
        imm r1, 546240
        load r10, r1
        imm r2, 15
        jlt r10, r2, statement_antecedent_record_room
        jmp reject
statement_antecedent_record_room:
        mov r11, r10
        imm r2, 24
        mul r11, r2
        imm r2, 546400
        add r11, r2
        store r11, r20
        imm r2, 8
        add r11, r2
        store r11, r21
        imm r2, 8
        add r11, r2
        store r11, r22
        imm r2, 1
        add r10, r2
        imm r1, 546240
        store r1, r10
        ret

; Re-read the complete table so later publication cannot depend only on the
; counter. Require nonzero cells/tags and owner in the exact 1..6 partition.
statement_antecedent_require_rows:
        imm r1, 546240
        load r2, r1
        imm r3, 15
        jeq r2, r3, statement_antecedent_rows_init
        jmp reject
statement_antecedent_rows_init:
        imm r10, 0
statement_antecedent_rows_loop:
        imm r1, 15
        jlt r10, r1, statement_antecedent_rows_one
        ret
statement_antecedent_rows_one:
        mov r11, r10
        imm r1, 24
        mul r11, r1
        imm r1, 546400
        add r11, r1
        load r2, r11
        jz r2, reject
        imm r1, 8
        add r11, r1
        load r2, r11
        jz r2, reject
        imm r1, 8
        add r11, r1
        load r2, r11
        imm r3, 1
        jlt r2, r3, reject
        imm r3, 7
        jlt r2, r3, statement_antecedent_rows_next
        jmp reject
statement_antecedent_rows_next:
        imm r1, 1
        add r10, r1
        jmp statement_antecedent_rows_loop

statement_antecedent_publish_packages:
        imm r1, 546108
        imm r2, 1480936513             ; ALEX
        store r1, r2
        imm r1, 546116
        imm r2, 1296125505             ; ANAM
        store r1, r2
        imm r1, 546124
        imm r2, 1414350145             ; AEMT
        store r1, r2
        imm r1, 546132
        imm r2, 1279413313             ; ALBL
        store r1, r2
        imm r1, 546140
        imm r2, 1347962177             ; AEXP
        store r1, r2
        imm r1, 546148
        imm r2, 1346917185             ; ASHP
        store r1, r2
        imm r1, 546156
        imm r2, 1414414675             ; SANT
        store r1, r2
        ret
