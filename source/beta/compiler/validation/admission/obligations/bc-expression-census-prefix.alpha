; Canonical structural index for expression primitive/push ownership by block.
;
; The primitive and stack-push owners have already reconstructed and validated
; every source row before control reaches this phase.  Build four cumulative
; counts at block boundaries 0..359 once, so responsibility-specific summaries
; can bind their exact half-open row intervals without rescanning 1,236 rows.
; This owner indexes structural custody only; primitive meanings, push kinds,
; artifact shapes, and per-family semantic theorems remain with their owners.
;
; Prefix arrays (360 words each):
;   primitive       17039360
;   binary push     17043456
;   argument push   17047552  (global row base 237)
;   store push      17051648  (global row base 371)

build_expr_census_prefix_init:
        imm r10, 0
build_expr_census_prefix_zero_loop:
        imm r1, 360
        jlt r10, r1, build_expr_census_prefix_zero_one
        jmp build_expr_census_prefix_bases
build_expr_census_prefix_zero_one:
        mov r11, r10
        imm r1, 8
        mul r11, r1
        imm r2, 0
        imm r1, 17039360
        add r1, r11
        store r1, r2
        imm r1, 17043456
        add r1, r11
        store r1, r2
        imm r1, 17047552
        add r1, r11
        store r1, r2
        imm r1, 17051648
        add r1, r11
        store r1, r2
        imm r1, 1
        add r10, r1
        jmp build_expr_census_prefix_zero_loop

build_expr_census_prefix_bases:
        imm r1, 17047552
        imm r2, 237
        store r1, r2
        imm r1, 17051648
        imm r2, 371
        store r1, r2
        imm r10, 0
build_expr_primitive_prefix_rows:
        imm r1, 829
        jlt r10, r1, build_expr_primitive_prefix_one
        imm r10, 0
        jmp build_expr_push_prefix_rows
build_expr_primitive_prefix_one:
        mov r11, r10
        imm r1, 8
        mul r11, r1
        imm r1, 8388608
        add r1, r11
        load r12, r1                   ; checked source block
        call expr_census_prefix_boundary_offset
        imm r1, 17039360
        add r1, r12
        call exact_increment_cell
        imm r1, 1
        add r10, r1
        jmp build_expr_primitive_prefix_rows

build_expr_push_prefix_rows:
        imm r1, 407
        jlt r10, r1, build_expr_push_prefix_one
        imm r10, 1
        jmp build_expr_census_prefix_accumulate
build_expr_push_prefix_one:
        mov r11, r10
        imm r1, 8
        mul r11, r1
        imm r1, 9437184
        add r1, r11
        load r12, r1                   ; checked source block
        call expr_census_prefix_boundary_offset
        imm r1, 9445376
        add r1, r11
        load r13, r1                   ; checked push kind
        imm r1, 1
        jeq r13, r1, build_expr_binary_prefix_one
        imm r1, 2
        jeq r13, r1, build_expr_argument_prefix_one
        imm r1, 3
        jeq r13, r1, build_expr_store_prefix_one
        jmp reject
build_expr_binary_prefix_one:
        imm r1, 17043456
        jmp build_expr_push_prefix_increment
build_expr_argument_prefix_one:
        imm r1, 17047552
        jmp build_expr_push_prefix_increment
build_expr_store_prefix_one:
        imm r1, 17051648
build_expr_push_prefix_increment:
        add r1, r12
        call exact_increment_cell
        imm r1, 1
        add r10, r1
        jmp build_expr_push_prefix_rows

; Checked block in r12; return its successor-boundary byte offset in r12.
expr_census_prefix_boundary_offset:
        imm r1, 0
        jlt r12, r1, reject
        imm r1, 359
        jlt r12, r1, expr_census_prefix_boundary_valid
        jmp reject
expr_census_prefix_boundary_valid:
        imm r1, 1
        add r12, r1
        imm r1, 8
        mul r12, r1
        ret

build_expr_census_prefix_accumulate:
        imm r1, 360
        jlt r10, r1, build_expr_census_prefix_accumulate_one
        jmp check_expr_census_prefix_terminals
build_expr_census_prefix_accumulate_one:
        mov r11, r10
        imm r1, 8
        mul r11, r1
        mov r12, r11
        imm r1, 8
        sub r12, r1
        imm r13, 17039360
        call expr_census_prefix_accumulate_array
        imm r13, 17043456
        call expr_census_prefix_accumulate_array
        imm r13, 17047552
        call expr_census_prefix_accumulate_array
        imm r13, 17051648
        call expr_census_prefix_accumulate_array
        imm r1, 1
        add r10, r1
        jmp build_expr_census_prefix_accumulate

; Current byte offset in r11, preceding byte offset in r12, array base in r13.
expr_census_prefix_accumulate_array:
        mov r1, r13
        add r1, r12
        load r2, r1
        mov r1, r13
        add r1, r11
        load r3, r1
        add r3, r2
        store r1, r3
        ret

check_expr_census_prefix_terminals:
        imm r10, 2872                 ; boundary 359 * 8
        imm r1, 17039360
        add r1, r10
        load r2, r1
        imm r3, 829
        jeq r2, r3, check_binary_census_prefix_terminal
        jmp reject
check_binary_census_prefix_terminal:
        imm r1, 17043456
        add r1, r10
        load r2, r1
        imm r3, 237
        jeq r2, r3, check_argument_census_prefix_terminal
        jmp reject
check_argument_census_prefix_terminal:
        imm r1, 17047552
        add r1, r10
        load r2, r1
        imm r3, 371
        jeq r2, r3, check_store_census_prefix_terminal
        jmp reject
check_store_census_prefix_terminal:
        imm r1, 17051648
        add r1, r10
        load r2, r1
        imm r3, 407
        jeq r2, r3, expr_census_prefix_mutation_teeth
        jmp reject

; Four internal mutation teeth prove that every prefix family participates in
; the O(1) query without generating alternate checker-source permutations.
expr_census_prefix_mutation_teeth:
        imm r40, 17042232             ; primitive boundary 359
        call expr_census_prefix_mutation_tooth
        imm r40, 17046328             ; binary boundary 359
        call expr_census_prefix_mutation_tooth
        imm r40, 17050424             ; argument boundary 359
        call expr_census_prefix_mutation_tooth
        imm r40, 17054520             ; store boundary 359
        call expr_census_prefix_mutation_tooth
        jmp composition_scan_init

expr_census_prefix_mutation_tooth:
        load r41, r40
        mov r42, r41
        imm r1, 1
        add r42, r1
        store r40, r42
        call expr_census_prefix_full_range
        call exact_expr_census_prefix_matches
        store r40, r41                 ; restore canonical derived index
        imm r1, 0
        jeq r0, r1, expr_census_prefix_mutation_tooth_ok
        jmp reject
expr_census_prefix_mutation_tooth_ok:
        ret

expr_census_prefix_full_range:
        imm r20, 0
        imm r21, 358
        imm r22, 0
        imm r23, 829
        imm r24, 0
        imm r25, 237
        imm r26, 237
        imm r27, 371
        imm r28, 371
        imm r29, 407
        ret
