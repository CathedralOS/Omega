; Table-driven exact shape for fixed keyword recognizers. Private metadata
; 530360..530448 is proc,len,pc,block,transition,event,memory,primitive,
; binary,arg,literal,loop.

fixed_keyword_require_shape:
	imm r1, 530352
	imm r2, 15
	store r1, r2
fixed_keyword_shape_proc_loop:
	imm r1, 530352
	load r20, r1
	imm r2, 24
	jlt r20, r2, fixed_keyword_shape_proc
	ret
fixed_keyword_shape_proc:
	call fixed_keyword_select_proc
	call fixed_keyword_require_current_proc
	imm r1, 530352
	load r2, r1
	imm r3, 1
	add r2, r3
	store r1, r2
	jmp fixed_keyword_shape_proc_loop

fixed_keyword_require_current_proc:
	call fixed_keyword_require_frame
	call fixed_keyword_require_blocks
	call fixed_keyword_require_transitions
	call fixed_keyword_require_events
	call fixed_keyword_require_memory
	call fixed_keyword_require_primitives
	call fixed_keyword_require_pushes
	call fixed_keyword_require_censuses
	ret

fixed_keyword_require_frame:
	imm r1, 530360
	load r30, r1
	imm r20, 7151616
	mov r21, r30
	imm r22, 0
	call transfer_require_cell
	imm r20, 7159808
	mov r21, r30
	imm r22, 0
	call transfer_require_cell
	mov r20, r30
	call call_bounds_frame_bytes
	imm r1, 8
	jeq r0, r1, exact_shape_ok
	jmp reject

fixed_keyword_require_blocks:
	imm r1, 530384
	load r20, r1                  ; entry block
	imm r1, 530360
	load r21, r1                  ; procedure identity
	imm r22, 0
	call exact_block_identity_pc
	imm r1, 530384
	load r20, r1
	imm r2, 1
	add r20, r2                   ; c0 block
	imm r1, 530360
	load r21, r1
	imm r22, 1
	call exact_block_identity_pc
	imm r1, 530448
	imm r2, 0
	store r1, r2
fixed_keyword_block_loop:
	imm r1, 530448
	load r30, r1
	imm r1, 530368
	load r2, r1
	jlt r30, r2, fixed_keyword_block_char
	jeq r30, r2, fixed_keyword_block_yes
	jmp reject
fixed_keyword_block_char:
	imm r1, 530384
	load r20, r1
	imm r2, 2
	add r20, r2
	add r20, r30
	imm r1, 530360
	load r21, r1
	imm r22, 1
	call exact_block_identity_pc
	call fixed_keyword_increment_loop
	jmp fixed_keyword_block_loop
fixed_keyword_block_yes:
	imm r1, 530384
	load r20, r1
	imm r2, 2
	add r20, r2
	add r20, r30
	imm r1, 530360
	load r21, r1
	imm r22, 1
	call exact_block_identity_pc
	imm r1, 530384
	load r20, r1
	imm r1, 530368
	load r21, r1
	imm r2, 2
	add r21, r2
	imm r1, 530384
	load r2, r1
	add r21, r2                  ; inclusive final block
	imm r1, 530360
	load r22, r1
	call exact_require_proc_blocks
	ret

fixed_keyword_require_transitions:
	imm r1, 530448
	imm r2, 0
	store r1, r2
fixed_keyword_transition_loop:
	imm r1, 530448
	load r30, r1
	imm r1, 530368
	load r2, r1
	jlt r30, r2, fixed_keyword_transition_case
	jeq r30, r2, fixed_keyword_transition_case
	ret
fixed_keyword_transition_case:
	imm r1, 530392
	load r20, r1
	add r20, r30
	imm r1, 530384
	load r21, r1
	imm r2, 1
	add r21, r2
	add r21, r30
	imm r22, 1                    ; every edge is guarded
	mov r23, r21
	imm r2, 1
	add r23, r2
fixed_keyword_transition_require:
	call exact_transition_identity_pc
	call fixed_keyword_increment_loop
	jmp fixed_keyword_transition_loop

fixed_keyword_require_events:
	imm r1, 530360
	load r20, r1                  ; current procedure identity
	imm r1, 530384
	load r21, r1
	imm r2, 1
	add r21, r2
	call exact_require_event_epilogue
	imm r1, 530448
	imm r2, 0
	store r1, r2
fixed_keyword_event_loop:
	imm r1, 530448
	load r30, r1
	imm r1, 530368
	load r2, r1
	jlt r30, r2, fixed_keyword_event_char
	jeq r30, r2, fixed_keyword_event_yes
	jmp reject
fixed_keyword_event_char:
	imm r1, 530360
	load r20, r1                  ; current procedure identity
	imm r1, 530384
	load r21, r1
	imm r2, 2
	add r21, r2
	add r21, r30
	imm r22, 1
	imm r23, 0
	imm r24, 13                   ; id_char procedure identity
	call summary_require_call_fallthrough_identity
	imm r1, 530448
	load r30, r1                 ; call checker clobbers the loop index
	imm r1, 530360
	load r20, r1
	imm r1, 530384
	load r21, r1
	imm r2, 2
	add r21, r2
	add r21, r30
	call exact_require_event_epilogue
	call fixed_keyword_increment_loop
	jmp fixed_keyword_event_loop
fixed_keyword_event_yes:
	imm r1, 530360
	load r20, r1
	imm r1, 530384
	load r21, r1
	imm r2, 2
	add r21, r2
	add r21, r30
	call exact_require_event_epilogue
	imm r1, 530360
	load r20, r1
	imm r2, 1
	add r20, r2                  ; next procedure identifies synthetic return
	call exact_require_preentry_epilogue
	ret

fixed_keyword_require_memory:
	imm r1, 530408
	load r20, r1
	imm r1, 530384
	load r21, r1
	imm r2, 1
	add r21, r2
	imm r1, 530416
	load r25, r1
	imm r26, 2097112             ; exact IDLEN address
	call exact_memory_load_pc
	ret

fixed_keyword_require_primitives:
	imm r1, 530416
	load r20, r1
	imm r1, 530384
	load r21, r1
	imm r2, 1
	add r21, r2
	imm r22, 1
	imm r23, 2097112             ; exact IDLEN address
	call exact_primitive_identity_pc
	imm r2, 1
	add r20, r2
	imm r22, 3
	imm r23, 10                  ; length full-word equality
	call exact_primitive_identity_pc
	imm r2, 1
	add r20, r2
	imm r22, 1
	imm r1, 530368
	load r23, r1
	call exact_primitive_identity_pc
	imm r2, 1
	add r20, r2
	imm r22, 1
	imm r23, 0
	call exact_primitive_identity_pc
	imm r1, 530448
	imm r2, 0
	store r1, r2
fixed_keyword_primitive_loop:
	imm r1, 530448
	load r30, r1
	imm r1, 530368
	load r2, r1
	jlt r30, r2, fixed_keyword_primitive_char
	jeq r30, r2, fixed_keyword_primitive_yes
	jmp reject
fixed_keyword_primitive_char:
	imm r1, 530416
	load r20, r1
	mov r2, r30
	imm r3, 4
	mul r2, r3
	imm r3, 4
	add r2, r3
	add r20, r2
	imm r1, 530384
	load r21, r1
	imm r2, 2
	add r21, r2
	add r21, r30
	imm r22, 1
	mov r23, r30                 ; id_char index literal
	call exact_primitive_identity_pc
	imm r2, 1
	add r20, r2
	imm r22, 3
	imm r23, 10
	call exact_primitive_identity_pc
	imm r2, 1
	add r20, r2
	imm r22, 1
	imm r1, 530440
	load r23, r1
	add r23, r30
	loadb r23, r23                ; exact spelling byte
	call exact_primitive_identity_pc
	imm r2, 1
	add r20, r2
	imm r22, 1
	imm r23, 0
	call exact_primitive_identity_pc
	call fixed_keyword_increment_loop
	jmp fixed_keyword_primitive_loop
fixed_keyword_primitive_yes:
	imm r1, 530384
	load r21, r1
	imm r2, 2
	add r21, r2
	add r21, r30                 ; success block follows final character
	imm r1, 530416
	load r20, r1
	mov r2, r30
	imm r3, 4
	mul r2, r3
	imm r3, 4
	add r2, r3
	add r20, r2
	imm r22, 1
	imm r23, 1                   ; full-match one literal
	call exact_primitive_identity_pc
	ret

fixed_keyword_require_pushes:
	imm r1, 530424
	load r20, r1
	imm r1, 530384
	load r21, r1
	imm r2, 1
	add r21, r2
	call exact_require_binary_push_identity
	imm r1, 530448
	imm r2, 0
	store r1, r2
fixed_keyword_push_loop:
	imm r1, 530448
	load r30, r1
	imm r1, 530368
	load r2, r1
	jlt r30, r2, fixed_keyword_push_char
	ret
fixed_keyword_push_char:
	imm r1, 530384
	load r21, r1
	imm r2, 2
	add r21, r2
	add r21, r30
	imm r1, 530424
	load r20, r1
	imm r2, 1
	add r20, r2
	add r20, r30
	mov r31, r21
	call exact_require_binary_push_identity
	mov r21, r31
	imm r1, 530432
	load r20, r1
	add r20, r30
	call exact_require_argument_push_identity
	call fixed_keyword_increment_loop
	jmp fixed_keyword_push_loop

fixed_keyword_require_censuses:
	imm r1, 530384
	load r20, r1
	mov r21, r20
	imm r1, 530368
	load r2, r1
	imm r3, 2
	add r2, r3
	add r21, r2
	imm r22, 34
	imm r23, 34
	imm r1, 530408
	load r24, r1
	mov r25, r24
	imm r2, 1
	add r25, r2
	imm r1, 530392
	load r26, r1
	mov r27, r26
	imm r1, 530368
	load r2, r1
	imm r3, 1
	add r2, r3
	add r27, r2
	imm r1, 530400
	load r28, r1
	mov r29, r28
	imm r1, 530368
	load r2, r1
	imm r3, 2
	mul r2, r3
	imm r3, 2
	add r2, r3
	add r29, r2
	call exact_require_effect_census

	imm r1, 530384
	load r20, r1
	mov r21, r20
	imm r1, 530368
	load r2, r1
	imm r3, 2
	add r2, r3
	add r21, r2
	imm r1, 530416
	load r22, r1                 ; exact IDCH call count
	mov r23, r22
	imm r1, 530368
	load r2, r1
	imm r3, 4
	mul r2, r3
	imm r3, 5
	add r2, r3
	add r23, r2                  ; exact explicit+synthetic return count
	imm r1, 530424
	load r24, r1
	mov r25, r24
	imm r1, 530368
	load r2, r1
	imm r3, 1
	add r2, r3
	add r25, r2
	imm r1, 530432
	load r26, r1
	mov r27, r26
	imm r1, 530368
	load r2, r1
	add r27, r2
	imm r28, 383
	imm r29, 383                 ; exact empty store-push interval
	call summary_require_expr_census

	imm r1, 530360
	load r20, r1                  ; current procedure identity / region start
	call exact_proc_entry_r20
	imm r1, 530360
	load r21, r1
	imm r2, 1
	add r21, r2                  ; next procedure identity / region end
	call exact_proc_entry_r21
	imm r1, 530368
	load r22, r1
	mov r23, r22
	imm r2, 3
	add r23, r2
	mov r24, r22
	imm r2, 2
	mul r24, r2
	imm r2, 2
	add r24, r2                  ; exact decoded store count
	call exact_quiet_scan_region
	ret

fixed_keyword_increment_loop:
	imm r1, 530448
	load r2, r1
	imm r3, 1
	add r2, r3
	store r1, r2
	ret
