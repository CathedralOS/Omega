; Close the recursive expression family by descending remaining depth R=64-D.
; The exact-shape checker independently fixes every procedure and effect row;
; this semantic checker consumes the same canonical bundle and gives those rows
; their finite relational meaning.  First failure is ghost provenance
; {none,depth,arg}; numeric252 alone is deliberately insufficient to recover it.

expression_gen_expr_rules_init:
        call expression_gen_expr_reset
        call expression_gen_expr_require_imports
        call expression_gen_expr_require_sites
        call expression_gen_expr_require_counter_flow
        call expression_gen_expr_build_contexts
        call expression_gen_expr_require_root
        call expression_gen_expr_publish
        jmp expression_family_publication_init

expression_gen_expr_reset:
        imm r1, 542240
        imm r2, 0
expression_gen_expr_reset_loop:
        imm r3, 545520
        jlt r1, r3, expression_gen_expr_reset_one
        ret
expression_gen_expr_reset_one:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp expression_gen_expr_reset_loop

expression_gen_expr_require_imports:
        imm r20, 545600
        imm r21, 1129534036             ; XRSC: exhaustive protected writers
        call exact_require_cell
        imm r20, 540032
        imm r21, 1380207687             ; GLDR
        call exact_require_cell
        imm r20, 540040
        imm r21, 1414682439             ; GWRT
        call exact_require_cell
        imm r20, 540048
        imm r21, 1279347783             ; GCAL
        call exact_require_cell
        imm r20, 540056
        imm r21, 1128351303             ; GFAC
        call exact_require_cell
        imm r20, 540064
        imm r21, 1297237063             ; GTRM
        call exact_require_cell
        imm r20, 540072
        imm r21, 1297437511             ; GSUM
        call exact_require_cell
        imm r20, 531896
        imm r21, 1398100037             ; EPUS
        call exact_require_cell
        imm r20, 534864
        imm r21, 1347240773             ; ECMP
        call exact_require_cell
        imm r20, 529952
        imm r21, 1347374403             ; CMOP
        call exact_require_cell
        imm r20, 540024
        imm r21, 1279347796             ; XTAL
        call exact_require_cell
        ret

; r21=source block, r22=arity, r23=target procedure identity.
expression_gen_expr_require_site:
        mov r24, r23
        imm r23, 0
        imm r20, 61                    ; gen_expr owning procedure identity
        call summary_require_call_fallthrough_identity
        ret

expression_gen_expr_require_return:
        imm r20, 61                    ; gen_expr owning procedure identity
        call exact_require_event_epilogue
        ret

expression_gen_expr_require_sites:
        ; Early depth exit, no-comparison body, and comparison body.
        imm r21, 304
        call expression_gen_expr_require_return
        imm r21, 306
        imm r22, 0
        imm r23, 58                    ; gen_sum procedure identity
        call expression_gen_expr_require_site
        imm r21, 306
        imm r22, 0
        imm r23, 10                    ; skip_ws procedure identity
        call expression_gen_expr_require_site
        imm r21, 306
        imm r22, 0
        imm r23, 59                    ; cmp_op procedure identity
        call expression_gen_expr_require_site
        imm r21, 306
        call expression_gen_expr_require_return
        imm r21, 307
        imm r22, 0
        imm r23, 47                    ; emit_push procedure identity
        call expression_gen_expr_require_site
        imm r21, 307
        imm r22, 0
        imm r23, 58                    ; right gen_sum procedure identity
        call expression_gen_expr_require_site
        imm r21, 307
        imm r22, 1
        imm r23, 60                    ; emit_cmp procedure identity
        call expression_gen_expr_require_site
        imm r21, 307
        call expression_gen_expr_require_return
        ret

expression_gen_expr_require_counter_flow:
        ; Snapshot D and signed guard D<64.
        imm r20, 57
        imm r21, 303
        imm r25, 673
        imm r26, 2097080
        call exact_memory_load_pc
        imm r20, 192
        imm r21, 303
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 675
        imm r21, 304
        imm r22, 1
        imm r23, 64
        call exact_primitive_identity_pc
        imm r20, 674
        imm r21, 304
        imm r22, 3
        imm r23, 8
        call exact_primitive_identity_pc
        imm r20, 202
        imm r21, 304
        call exact_require_binary_push_identity

        ; Accepted entry stores D+1 exactly once.
        imm r20, 59
        imm r21, 305
        call exact_memory_store_pc
        imm r20, 681
        imm r21, 305
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 680
        imm r21, 305
        imm r22, 2
        imm r23, 3
        call exact_primitive_identity_pc
        imm r20, 203
        imm r21, 305
        call exact_require_binary_push_identity

        ; Both terminal branches subtract one and store D exactly once.
        imm r20, 60
        imm r21, 306
        call exact_memory_store_pc
        imm r20, 687
        imm r21, 306
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 686
        imm r21, 306
        imm r22, 2
        imm r23, 4
        call exact_primitive_identity_pc
        imm r20, 205
        imm r21, 306
        call exact_require_binary_push_identity
        imm r20, 62
        imm r21, 307
        call exact_memory_store_pc
        imm r20, 692
        imm r21, 307
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 691
        imm r21, 307
        imm r22, 2
        imm r23, 4
        call exact_primitive_identity_pc
        imm r20, 206
        imm r21, 307
        call exact_require_binary_push_identity
        ret

; Table row R, 48 bytes: R,D,child-R,complete,status cases,BCS9 live.
expression_gen_expr_build_contexts:
        imm r10, 0
expression_gen_expr_context_loop:
        imm r1, 65
        jlt r10, r1, expression_gen_expr_context_row
        ret
expression_gen_expr_context_row:
        mov r12, r10
        imm r1, 48
        mul r12, r1
        imm r1, 542400
        add r12, r1
        store r12, r10
        imm r13, 64
        sub r13, r10                  ; D=64-R
        imm r1, 8
        add r12, r1
        store r12, r13
        imm r1, 0
        jeq r10, r1, expression_gen_expr_context_base
        call expression_gen_expr_context_step
expression_gen_expr_context_next:
        imm r1, 1
        add r10, r1
        jmp expression_gen_expr_context_loop

expression_gen_expr_context_base:
        ; D=64 selects the unique depth writer. It returns zero without CUR,
        ; output, or EXPRDEPTH change. Entry0 creates depth provenance; an
        ; existing depth/arg provenance remains first. These are all 3 cases.
        imm r1, 8
        add r12, r1
        imm r2, 0
        imm r3, 1
        sub r2, r3                    ; all-ones rejected-child sentinel
        store r12, r2
        imm r1, 8
        add r12, r1
        imm r2, 1
        store r12, r2                 ; completion
        imm r1, 8
        add r12, r1
        imm r2, 3                     ; three base provenance cases
        store r12, r2
        imm r1, 8
        add r12, r1
        imm r2, 0
        store r12, r2                 ; rejected BCS9 probe
        imm r1, 545528
        imm r2, 1
        store r1, r2                   ; row58 writes252, output/CUR quiet
        jmp expression_gen_expr_context_next

expression_gen_expr_context_step:
        ; The child context R-1 was completed first and denotes live D+1.
        mov r14, r10
        imm r1, 1
        sub r14, r1
        imm r1, 8
        add r12, r1
        store r12, r14
        mov r15, r14
        imm r1, 48
        mul r15, r1
        imm r1, 542424
        add r15, r1
        load r2, r15
        imm r3, 1
        jeq r2, r3, expression_gen_expr_context_bcs
        jmp reject
expression_gen_expr_context_bcs:
        ; Rejoin the exact BCS9 proc61 potential at row R-1.
        imm r20, 1
        mov r21, r14
        imm r22, 61
        call call_bounds_load_pair
        imm r1, 23
        jlt r1, r0, expression_gen_expr_context_hidden
        jmp reject
expression_gen_expr_context_hidden:
        imm r1, 0
        jlt r1, r7, expression_gen_expr_context_cases
        jmp reject
expression_gen_expr_context_cases:
        ; entry {0,252-depth,252-arg} x body first-failure
        ; {none,depth,arg}: nine exhaustive sticky-provenance cases. Every case
        ; instantiates the same smaller GE relation in factor parentheses,
        ; up to four successful normal-call args, and both sum operands.
        imm r1, 8
        add r12, r1
        imm r2, 1
        store r12, r2                 ; completion
        imm r1, 8
        add r12, r1
        imm r2, 9                     ; nine step provenance products
        store r12, r2
        imm r1, 8
        add r12, r1
        store r12, r0                 ; exact explicit potential
        imm r1, 545536
        imm r2, 1
        store r1, r2                  ; GFAC/GTRM/GSUM child composition
        imm r1, 545544
        store r1, r2                  ; no status guard suppresses suffix
        imm r1, 545552
        store r1, r2                  ; normal-call rank 4-nargs
        imm r1, 545560
        store r1, r2                  ; malformed tail delta <=2
        imm r1, 545568
        store r1, r2                  ; no-cmp exact restore D
        imm r1, 545576
        store r1, r2                  ; cmp push/right/ECMP, LBL+2, restore D
        jmp expression_gen_expr_context_next

expression_gen_expr_require_root:
        ; Root D=0 accepts, stores one, and selects completed row63 (D=1).
        imm r20, 545472               ; row64 remaining
        imm r21, 64
        call exact_require_cell
        imm r20, 545480               ; row64 D
        imm r21, 0
        call exact_require_cell
        imm r20, 545448               ; row63 completion
        imm r21, 1                    ; exact completed child context
        call exact_require_cell
        imm r20, 545432               ; row63 D
        imm r21, 1
        call exact_require_cell
        imm r1, 545584
        imm r2, 1
        store r1, r2
        ret

expression_gen_expr_publish:
        imm r20, 542424               ; row0 completion
        imm r21, 1
        call exact_require_cell
        imm r20, 545496               ; row64 completion
        imm r21, 1
        call exact_require_cell
        imm r20, 545528
        imm r21, 1
        call exact_require_cell
        imm r20, 542432
        imm r21, 3                    ; base provenance cardinality
        call exact_require_cell
        imm r20, 545504
        imm r21, 9                    ; step provenance cardinality
        call exact_require_cell
        imm r20, 545536
        imm r21, 1
        call exact_require_cell
        imm r20, 545568
        imm r21, 1
        call exact_require_cell
        imm r20, 545576
        imm r21, 1
        call exact_require_cell
        imm r20, 545584
        imm r21, 1
        call exact_require_cell
        imm r1, 540080
        imm r2, 1347960903             ; GEXP
        store r1, r2
        ret
