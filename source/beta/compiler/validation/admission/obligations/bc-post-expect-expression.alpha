; Checker-F continuation from the independently rebuilt cursor/expect family.
; Re-execute the full-Word emit_dec proof without importing Checker D/E's
; process-private absolute-stack token.  BCS9 and exact frame shape have already
; been reconstructed in this process; the resulting DECW relation remains
; conditional on a valid call entry just like the expression SCC itself.

bc_post_expect:
        jmp expression_emit_dec_word_init

expression_emit_dec_word_init:
        call emit_dec_word_reset
        call emit_dec_require_shape
        call emit_dec_word_domain_init
        call emit_dec_word_prove_rows
        call expression_emit_dec_word_publish
        jmp cursor_tail_summary_init

expression_emit_dec_word_publish:
        imm r20, 540000
        imm r21, 1414677848             ; XPRX
        call exact_require_cell
        imm r20, 532512
        imm r21, 808535123              ; SD10
        call exact_require_cell
        imm r20, 532520
        imm r21, 1379479876             ; D19R
        call exact_require_cell
        imm r20, 532528
        imm r21, 1195724356             ; DNEG
        call exact_require_cell
        imm r20, 532536
        imm r21, 810373956              ; DSM0
        call exact_require_cell
        imm r20, 532544
        imm r21, 1397706820             ; DPOS
        call exact_require_cell
        imm r20, 532552
        imm r21, 1413694788             ; DECT
        call exact_require_cell
        imm r20, 532568
        imm r21, 1                     ; complete signed Word partition
        call exact_require_cell
        imm r20, 532576
        imm r21, 1                     ; divisor +10 excludes trap cases
        call exact_require_cell
        imm r20, 532584
        imm r21, 20
        call exact_require_cell
        imm r20, 534400
        imm r21, 20
        call exact_require_cell
        imm r20, 534408
        imm r21, 19
        call exact_require_cell
        imm r20, 534392
        imm r21, 1
        call exact_require_cell
        call emit_dec_word_require_all_completions
        imm r1, 532560
        imm r2, 1464026436             ; DECW
        store r1, r2
        ret
