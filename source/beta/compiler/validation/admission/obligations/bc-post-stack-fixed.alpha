; Checker-A continuation after the shared safety prefix.  SPFX is the stable
; public schema used by every post-stack continuation: the prefix has completed
; exact static memory/access custody, frame/store and ranged-transfer checks,
; recursive counter transfer, and the absolute explicit/hidden stack theorem.
; Dynamic SRC/name-table indices remain obligations of their caller relations.
bc_post_stack_potential:
        imm r1, 531840
        imm r2, 1481003091             ; SPFX
        store r1, r2
        jmp slurp_summary_init
