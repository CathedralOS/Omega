; Relational summaries for skip_ws_step and skip_ws.
;
; The preceding leaf phase supplies exact conditional meanings for cbyte, adv,
; and is_space.  This phase composes them without expanding their Alpha bodies:
;
;   skip_ws_step(i)
;     whitespace          -> (i+1, 1)
;     ordinary byte/zero  -> (i,   0)
;     ';' ... LF at j     -> (j,   1), LF unconsumed
;     ';' ... zero at j   -> (j,   0), after consuming at least the ';'
;
; In the comment loop, the two cbyte calls have the same cursor and therefore
; the same deterministic result.  Every continuation byte is nonzero and not
; LF, hence in range; adv decreases LEN-CUR by one.  The outer skip_ws loop
; repeats only result-one steps, all of which strictly increase CUR, so the same
; natural rank terminates it.  Input/output and source memory are unchanged;
; CUR is the only compiler global that may change.  Scratch registers and
; reclaimed private-frame bytes are outside preservation.
;
; Fresh cells:
;   step theorem / four clauses       526168 / 526176..526200
;   comment induction / skip theorem  526208 / 526216
;   case/cursor/byte/local/result      526224..526256
;   progress/first/second/same-cursor 526264..526288
;   rank/delta/rename/domain/in-range 526296..526328
;   outer rank/delta/step/exit/induct 526336..526368
;   four completion flags             526376..526400
;   is_space argument provenance      526408
;   opening-semicolon consumed        526416
;   outer cursor relation             526424
;   outer successor rename            526432
;
; Byte categories: 1=whitespace, 2=ordinary nonspace/nonsemicolon (including
; numeric zero), 3=';', 4=LF, 5=zero, 6=comment continuation.

skip_ws_summary_init:
        call skip_step_require_shape
        call skip_step_prove_summary
        call skip_require_shape
        call skip_prove_summary
        jmp bc_post_skip_ws

; ---- Exact skip_ws_step shape -----------------------------------------

skip_step_require_shape:
        imm r20, 11
        imm r21, 0
        imm r22, 1
        imm r23, 16
        call exact_require_proc_frame_identity

        imm r20, 35
        imm r21, 11
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 36
        imm r21, 11
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 37
        imm r21, 11
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 38
        imm r21, 11
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 39
        imm r21, 11
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 40
        imm r21, 11
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 41
        imm r21, 11
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 42
        imm r21, 11
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 43
        imm r21, 12                   ; read_ident procedure entry / end
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 35
        imm r21, 42
        imm r22, 11
        call exact_require_proc_blocks

        imm r20, 26
        imm r21, 36
        imm r22, 1
        imm r23, 37
        call exact_transition_identity_pc
        imm r20, 27
        imm r21, 36
        imm r22, 0
        imm r23, 38
        call exact_transition_identity_pc
        imm r20, 28
        imm r21, 38
        imm r22, 1
        imm r23, 39
        call exact_transition_identity_pc
        imm r20, 29
        imm r21, 39
        imm r22, 0
        imm r23, 40
        call exact_transition_identity_pc
        imm r20, 30
        imm r21, 40
        imm r22, 1
        imm r23, 42
        call exact_transition_identity_pc
        imm r20, 31
        imm r21, 40
        imm r22, 1
        imm r23, 41
        call exact_transition_identity_pc
        imm r20, 32
        imm r21, 40
        imm r22, 0
        imm r23, 40
        call exact_transition_identity_pc

        ; Exact calls and returns.
        imm r20, 11
        imm r21, 35
        imm r22, 0
        imm r23, 0
        imm r24, 4
        call summary_require_call_fallthrough_identity
        imm r20, 11
        imm r21, 36
        imm r22, 1
        imm r23, 0
        imm r24, 9
        call summary_require_call_fallthrough_identity
        imm r20, 11
        imm r21, 37
        imm r22, 0
        imm r23, 0
        imm r24, 5
        call summary_require_call_fallthrough_identity
        imm r20, 11
        imm r21, 40
        imm r22, 0
        imm r23, 0
        imm r24, 4
        imm r25, 0
        imm r26, 2
        call summary_require_nth_call_fallthrough_identity
        imm r20, 11
        imm r21, 40
        imm r22, 0
        imm r23, 0
        imm r24, 4
        imm r25, 1
        imm r26, 2
        call summary_require_nth_call_fallthrough_identity
        imm r20, 11
        imm r21, 40
        imm r22, 0
        imm r23, 0
        imm r24, 5
        call summary_require_call_fallthrough_identity
        imm r20, 11                   ; skip_ws_step procedure identity
        imm r21, 37
        call exact_require_event_epilogue
        imm r20, 11
        imm r21, 38
        call exact_require_event_epilogue
        imm r20, 11
        imm r21, 41
        call exact_require_event_epilogue
        imm r20, 11
        imm r21, 42
        call exact_require_event_epilogue
        ; c is stored once from cbyte's returned r0 and reloaded twice.
        imm r20, 30
        imm r21, 35
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 31
        imm r21, 36
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 32
        imm r21, 38
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc

        imm r20, 74
        imm r21, 36
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 75
        imm r21, 36
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 76
        imm r21, 37
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 77
        imm r21, 38
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 78
        imm r21, 38
        imm r22, 1
        imm r23, 59
        call exact_primitive_identity_pc
        imm r20, 79
        imm r21, 38
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 80
        imm r21, 40
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 81
        imm r21, 40
        imm r22, 1
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 82
        imm r21, 40
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 83
        imm r21, 40
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 84
        imm r21, 41
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 85
        imm r21, 42
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc

        imm r20, 21
        imm r21, 36
        call exact_require_binary_push_identity
        imm r20, 22
        imm r21, 38
        call exact_require_binary_push_identity
        imm r20, 23
        imm r21, 40
        call exact_require_binary_push_identity
        imm r20, 24
        imm r21, 40
        call exact_require_binary_push_identity
        imm r20, 240
        imm r21, 36
        call exact_require_argument_push_identity

        ; Explicit return epilogues are owned with their event identities.
        imm r20, 12                   ; read_ident identifies synthetic return
        call exact_require_preentry_epilogue

        imm r20, 11                   ; skip_ws_step identity / region start
        call exact_proc_entry_r20
        imm r21, 12                   ; read_ident identity / region end
        call exact_proc_entry_r21
        imm r22, 6
        imm r23, 5
        call skip_scan_call_region
        imm r20, 35
        imm r21, 42
        imm r22, 30
        imm r23, 33
        imm r24, 0
        imm r25, 0
        imm r26, 26
        imm r27, 33
        imm r28, 23
        imm r29, 33                   ; checked exclusive step event row
        call exact_require_effect_census
        ret

; ---- Exact skip_ws shape ----------------------------------------------

skip_require_shape:
        imm r20, 10
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call exact_require_proc_frame_identity
        imm r20, 33
        imm r21, 10
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 34
        imm r21, 10
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 35
        imm r21, 11                   ; skip_ws_step procedure entry / end
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 33
        imm r21, 34
        imm r22, 10
        call exact_require_proc_blocks
        imm r20, 25
        imm r21, 34
        imm r22, 1
        imm r23, 34
        call exact_transition_identity_pc
        imm r20, 10
        imm r21, 34
        imm r22, 0
        imm r23, 0
        imm r24, 11
        call summary_require_call_fallthrough_identity
        imm r20, 10                   ; skip_ws procedure identity
        imm r21, 34
        call exact_require_event_epilogue
        imm r20, 71
        imm r21, 34
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 72
        imm r21, 34
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 73
        imm r21, 34
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 20
        imm r21, 34
        call exact_require_binary_push_identity
        ; The explicit return is owned above; the fallthrough is relative.
        imm r20, 11                   ; skip_ws_step identifies synthetic return
        call exact_require_preentry_epilogue
        imm r20, 10                   ; skip_ws identity / region start
        call exact_proc_entry_r20
        imm r21, 11                   ; skip_ws_step identity / region end
        call exact_proc_entry_r21
        imm r22, 1
        imm r23, 2
        call skip_scan_call_region
        imm r20, 33
        imm r21, 34
        imm r22, 0
        imm r23, 0
        imm r24, 0
        imm r25, 0
        imm r26, 25
        imm r27, 26
        imm r28, 21
        imm r29, 23
        call exact_require_effect_census
        ret

; ---- skip_ws_step relational composition ------------------------------

skip_step_prove_summary:
        imm r1, 526168
        imm r2, 0
        store r1, r2
        imm r1, 526176
        store r1, r2
        imm r1, 526184
        store r1, r2
        imm r1, 526192
        store r1, r2
        imm r1, 526200
        store r1, r2
        call skip_require_leaf_theorems
        call skip_introduce_domain
        call skip_step_prove_space
        call skip_step_prove_ordinary
        call skip_step_prove_comment
        imm r20, 526176
        imm r21, 1
        call exact_require_cell
        imm r20, 526184
        imm r21, 1
        call exact_require_cell
        imm r20, 526192
        imm r21, 1
        call exact_require_cell
        imm r20, 526200
        imm r21, 1
        call exact_require_cell
        imm r1, 526168
        imm r2, 1398231892            ; SWST
        store r1, r2
        ret

skip_step_prove_space:
        call skip_step_reset_case
        imm r20, 1
        call skip_step_select_entry_byte
        call skip_step_store_c
        call skip_step_load_c
        imm r20, 1
        call skip_step_call_is_space
        imm r20, 1
        call skip_step_require_result
        imm r20, 1
        call skip_step_take_space_edge
        call skip_step_call_adv
        imm r20, 1
        call skip_step_set_result
        imm r20, 1
        imm r21, 2                    ; checked result-one cursor progress
        call skip_step_require_outcome
        imm r1, 526176
        imm r2, 1
        store r1, r2
        ret

skip_step_prove_ordinary:
        call skip_step_reset_case
        imm r20, 2
        call skip_step_select_entry_byte
        call skip_step_store_c
        call skip_step_load_c
        imm r20, 0
        call skip_step_call_is_space
        imm r20, 0
        call skip_step_require_result
        imm r20, 0
        call skip_step_take_space_edge
        call skip_step_load_c
        imm r20, 0
        call skip_step_take_semicolon_edge
        imm r20, 0
        call skip_step_set_result
        imm r20, 0
        imm r21, 1
        call skip_step_require_outcome
        imm r1, 526184
        imm r2, 1
        store r1, r2
        ret

skip_step_prove_comment:
        call skip_step_reset_case
        imm r20, 3
        call skip_step_select_entry_byte
        call skip_step_store_c
        call skip_step_load_c
        imm r20, 0
        call skip_step_call_is_space
        imm r20, 0
        call skip_step_require_result
        imm r20, 0
        call skip_step_take_space_edge
        call skip_step_load_c
        imm r20, 1
        call skip_step_take_semicolon_edge
        call skip_comment_prove_induction
        ret

; Finite comment suffix partitions at every cursor into LF, zero, or a nonzero
; non-LF continuation.  The continuation invokes adv only under CUR<LEN and
; decreases LEN-CUR by one; the first consumed byte is the entry semicolon.
skip_comment_prove_induction:
        imm r1, 526208
        imm r2, 0
        store r1, r2
        imm r1, 526296
        imm r2, 1                    ; checked inner rank premise LEN-CUR
        store r1, r2
        call skip_comment_require_invariant

        ; cloop is first entered at the opening semicolon.  Its two pure
        ; cbyte calls therefore both return ';', both terminal comparisons are
        ; false, and the first adv is mandatory.  This derives strict progress
        ; before the generic suffix induction, rather than assuming j>i.
        imm r20, 3
        call skip_comment_first_cbyte
        call skip_comment_require_opening_c
        imm r20, 0
        call skip_comment_take_lf_edge
        call skip_comment_same_cursor
        imm r20, 3
        call skip_comment_second_cbyte
        imm r20, 0
        call skip_comment_take_zero_edge
        call skip_step_call_adv
        call skip_comment_rank_step
        call skip_comment_close_backedge
        imm r1, 526264
        imm r2, 2                    ; strict progress past opening ';'
        store r1, r2
        imm r1, 526416
        imm r2, 1
        store r1, r2

        ; Terminal LF: first cbyte comparison takes cret, leaves LF pending,
        ; and returns one after strict progress from the entry semicolon.
        call skip_comment_require_invariant
        imm r20, 4
        call skip_comment_first_cbyte
        imm r20, 1
        call skip_comment_take_lf_edge
        imm r20, 1                    ; checked comment-newline result
        call skip_step_set_result
        imm r20, 1
        call skip_step_require_result
        imm r20, 526416
        imm r21, 1
        call exact_require_cell
        imm r20, 1
        imm r21, 2
        call skip_step_require_outcome
        imm r1, 526192
        imm r2, 1
        store r1, r2

        ; Terminal zero: the first LF comparison is false.  With no mutation
        ; before the second call, cbyte determinism gives the same zero, and
        ; ceof returns zero at that cursor after possible comment consumption.
        call skip_comment_require_invariant
        imm r20, 5
        call skip_comment_first_cbyte
        imm r20, 0
        call skip_comment_take_lf_edge
        call skip_comment_same_cursor
        imm r20, 5
        call skip_comment_second_cbyte
        imm r20, 1
        call skip_comment_take_zero_edge
        imm r20, 0                    ; checked comment-zero result
        call skip_step_set_result
        imm r20, 0
        call skip_step_require_result
        imm r20, 526416
        imm r21, 1
        call exact_require_cell
        imm r20, 0
        imm r21, 2
        call skip_step_require_outcome
        imm r1, 526200
        imm r2, 1
        store r1, r2

        ; Recursive step: both same-cursor calls yield a nonzero non-LF byte.
        ; adv is therefore in range, the exact backedge renames the successor,
        ; and the natural rank decreases by exactly one.
        call skip_comment_require_invariant
        imm r20, 6
        call skip_comment_first_cbyte
        imm r20, 0
        call skip_comment_take_lf_edge
        call skip_comment_same_cursor
        imm r20, 6
        call skip_comment_second_cbyte
        imm r20, 0
        call skip_comment_take_zero_edge
        imm r1, 526328
        imm r2, 1
        store r1, r2                  ; continuation byte proves CUR<LEN
        call skip_step_call_adv
        call skip_comment_rank_step
        call skip_comment_close_backedge

        imm r20, 526192
        imm r21, 1
        call exact_require_cell
        imm r20, 526200
        imm r21, 1
        call exact_require_cell
        imm r1, 526208
        imm r2, 1129270605            ; CMIN
        store r1, r2
        ret

; Inner loop invariant at the cloop cutpoint.  Tag one means the current
; versioned cursor i with natural rank LEN-i under the carried source domain.
skip_comment_require_invariant:
        call skip_require_domain
        imm r20, 526232
        imm r21, 1
        call exact_require_cell
        imm r20, 526296
        imm r21, 1
        call exact_require_cell
        ret

; On the only recursive edge the selected byte proves old CUR<LEN.  adv has
; already produced cursor successor tag two, so rank LEN-CUR becomes the
; corresponding positive predecessor rank minus one.
skip_comment_rank_step:
        call skip_require_domain
        imm r20, 526328
        imm r21, 1
        call exact_require_cell
        imm r20, 526232
        imm r21, 2
        call exact_require_cell
        imm r20, 526296
        imm r21, 1
        call exact_require_cell
        imm r1, 526304
        imm r2, 1                    ; checked comment rank delta
        store r1, r2
        imm r20, 526304
        imm r21, 1
        call exact_require_cell
        imm r1, 526296
        imm r2, 2                    ; rank=LEN-successor(CUR)
        store r1, r2
        ret

; The exact cloop backedge returns to PC4893.  Require the correlated successor
; cursor/rank pair before capture-avoiding successor->current renaming, then
; recheck the quantified invariant at the loop head.
skip_comment_close_backedge:
        call skip_require_domain
        imm r20, 526232
        imm r21, 2
        call exact_require_cell
        imm r20, 526296
        imm r21, 2
        call exact_require_cell
        imm r20, 526304
        imm r21, 1
        call exact_require_cell
        imm r1, 526312
        imm r2, 2                    ; checked comment successor renaming
        store r1, r2
        imm r20, 526312
        imm r21, 2
        call exact_require_cell
        imm r1, 526232
        imm r2, 1                    ; checked renamed comment cursor
        store r1, r2
        imm r1, 526296
        store r1, r2                  ; renamed successor rank is LEN-CUR
        imm r1, 526328
        imm r2, 0                    ; new current may equal LEN
        store r1, r2
        call skip_comment_require_invariant
        ret

skip_step_reset_case:
        imm r10, 526224
skip_step_reset_loop:
        imm r1, 526320                ; checked domain-preserving reset bound
        jlt r10, r1, skip_step_reset_cell
        imm r1, 526328
        imm r2, 0
        store r1, r2                  ; current in-range fact is case-local
        imm r1, 526416
        store r1, r2
        imm r1, 526232
        imm r2, 1                     ; entry cursor
        store r1, r2
        ret
skip_step_reset_cell:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp skip_step_reset_loop

skip_step_select_entry_byte:
        imm r1, 526224
        store r1, r20
        mov r25, r20
        call skip_require_domain
        call skip_require_cbyte_theorem
        imm r1, 526240
        store r1, r25
        imm r1, 1
        jeq r25, r1, skip_step_mark_in_range
        imm r1, 3
        jeq r25, r1, skip_step_mark_in_range
        ret
skip_step_mark_in_range:
        imm r1, 526328
        imm r2, 1
        store r1, r2
        ret

skip_step_store_c:
        imm r1, 526240
        load r2, r1
        imm r1, 526248
        store r1, r2
        ret

skip_step_load_c:
        imm r1, 526248
        load r2, r1
        imm r1, 526240
        load r3, r1
        jeq r2, r3, exact_shape_ok ; checked stored-c provenance
        jmp reject

; Expected is_space result is r20.  The exact argument push/pop carries the
; stored c into parameter slot zero; the leaf theorem supplies the classifier.
skip_step_call_is_space:
        mov r25, r20
        call skip_require_space_theorem
        call skip_step_load_c
        imm r1, 526248
        load r2, r1
        imm r1, 526408                ; checked is_space argument handoff
        store r1, r2
        imm r1, 526240
        load r3, r1
        jeq r2, r3, skip_step_space_argument_ready
        jmp reject
skip_step_space_argument_ready:
        imm r1, 526408
        load r2, r1
        imm r3, 1
        jeq r2, r3, skip_step_space_result_one
        imm r3, 2
        jeq r2, r3, skip_step_space_result_zero
        imm r3, 3
        jeq r2, r3, skip_step_space_result_zero
        jmp reject
skip_step_space_result_one:
        imm r2, 1
        jmp skip_step_space_store_result
skip_step_space_result_zero:
        imm r2, 0
skip_step_space_store_result:
        jeq r2, r25, skip_step_store_result_word
        jmp reject
skip_step_store_result_word:
        imm r1, 526256
        store r1, r2
        ret

skip_step_require_result:
        imm r1, 526256
        load r2, r1
        jeq r2, r20, exact_shape_ok
        jmp reject

skip_step_take_space_edge:
        imm r1, 1
        jeq r20, r1, skip_step_space_edge_true
        imm r1, 0
        jeq r20, r1, skip_step_space_edge_false
        jmp reject
skip_step_space_edge_true:
        imm r1, 526224
        imm r2, 37
        store r1, r2
        ret
skip_step_space_edge_false:
        imm r1, 526224
        imm r2, 38
        store r1, r2
        ret

skip_step_take_semicolon_edge:
        imm r1, 526240
        load r2, r1
        imm r3, 1
        jeq r20, r3, skip_step_semicolon_expect_true
        imm r3, 0
        jeq r20, r3, skip_step_semicolon_expect_false
        jmp reject
skip_step_semicolon_expect_true:
        imm r3, 3
        jeq r2, r3, skip_step_semicolon_true
        jmp reject
skip_step_semicolon_expect_false:
        imm r3, 3
        jeq r2, r3, reject
        ret
skip_step_semicolon_true:
        imm r1, 526224
        imm r2, 40
        store r1, r2
        ret

skip_step_call_adv:
        call skip_require_domain
        call skip_require_adv_theorem
        imm r20, 526328
        imm r21, 1
        call exact_require_cell
        imm r1, 526232
        imm r2, 2
        store r1, r2                  ; CUR successor, still <=LEN
        imm r1, 526264
        imm r2, 1
        store r1, r2
        ret

skip_step_set_result:
        imm r1, 526256
        store r1, r20
        ret

; r20=result, r21 cursor relation: 1=unchanged, 2=strict progress.
skip_step_require_outcome:
        mov r25, r20
        mov r26, r21
        imm r1, 526256
        load r2, r1
        jeq r2, r25, skip_step_outcome_cursor
        jmp reject
skip_step_outcome_cursor:
        imm r1, 1
        jeq r26, r1, skip_step_outcome_unchanged
        imm r1, 2
        jeq r26, r1, skip_step_outcome_progress
        jmp reject
skip_step_outcome_unchanged:
        imm r1, 526232
        load r2, r1
        imm r3, 1
        jeq r2, r3, exact_shape_ok
        jmp reject
skip_step_outcome_progress:
        imm r1, 526264
        load r2, r1
        imm r3, 1
        jeq r2, r3, exact_shape_ok
        imm r3, 2
        jeq r2, r3, exact_shape_ok
        jmp reject

skip_comment_first_cbyte:
        mov r25, r20
        call skip_require_domain
        call skip_require_cbyte_theorem
        imm r1, 526272
        store r1, r25
        imm r1, 526288
        imm r2, 0
        store r1, r2
        ret

skip_comment_take_lf_edge:
        imm r1, 526272
        load r2, r1
        imm r3, 1
        jeq r20, r3, skip_comment_expect_lf
        imm r3, 0
        jeq r20, r3, skip_comment_expect_not_lf
        jmp reject
skip_comment_expect_lf:
        imm r3, 4
        jeq r2, r3, exact_shape_ok
        jmp reject
skip_comment_expect_not_lf:
        imm r3, 4
        jeq r2, r3, reject
        ret

; Between call continuations 4902 and 5006 there is only the checked equality
; macro and guarded control.  The source census has no local/raw writer here,
; and global stack custody classifies its private expression-stack effects.
skip_comment_same_cursor:
        imm r1, 526288
        imm r2, 1                    ; checked same-cursor cbyte pair
        store r1, r2
        ret

skip_comment_second_cbyte:
        mov r25, r20
        call skip_require_domain
        call skip_require_cbyte_theorem
        imm r20, 526288
        imm r21, 1
        call exact_require_cell
        imm r1, 526272
        load r2, r1
        jeq r2, r25, skip_comment_second_store
        jmp reject
skip_comment_second_store:
        imm r1, 526280
        store r1, r25
        ret

; The first cloop call occurs before any adv and must replay the entry local c,
; which the exact semicolon edge already proved is ';'.
skip_comment_require_opening_c:
        imm r1, 526248                ; checked opening local c provenance
        load r2, r1
        imm r1, 526272
        load r3, r1
        jeq r2, r3, exact_shape_ok
        jmp reject

skip_comment_take_zero_edge:
        imm r1, 526280
        load r2, r1
        imm r3, 1
        jeq r20, r3, skip_comment_expect_zero
        imm r3, 0
        jeq r20, r3, skip_comment_expect_nonzero
        jmp reject
skip_comment_expect_zero:
        imm r3, 5
        jeq r2, r3, exact_shape_ok
        jmp reject
skip_comment_expect_nonzero:
        imm r3, 5
        jeq r2, r3, reject
        ret

; ---- Outer skip_ws fixed point ----------------------------------------

skip_prove_summary:
        imm r1, 526216
        imm r2, 0
        store r1, r2
        call skip_introduce_domain
        imm r1, 526424
        imm r2, 1                    ; current outer cursor version
        store r1, r2
        imm r1, 526336
        imm r2, 1                    ; checked outer rank premise LEN-CUR
        store r1, r2
        imm r1, 526368
        imm r2, 0
        store r1, r2
        imm r1, 526432
        store r1, r2
        call skip_outer_require_invariant

        ; The two result-one clauses both strictly progress and are exactly the
        ; backedge cases.  Whitespace advances one; comment-LF advances at least
        ; over its opening semicolon while leaving LF for the next iteration.
        imm r20, 1
        imm r21, 526176
        call skip_outer_take_clause
        call skip_outer_backedge
        imm r20, 2
        imm r21, 526192
        call skip_outer_take_clause
        call skip_outer_backedge

        ; Result-zero clauses exit. Ordinary may preserve CUR; a zero-ended
        ; comment may already have consumed bytes, but neither takes backedge.
        imm r20, 3
        imm r21, 526184
        call skip_outer_take_clause
        call skip_outer_exit          ; checked ordinary result-zero exit
        imm r20, 4
        imm r21, 526200
        call skip_outer_take_clause
        call skip_outer_exit

        imm r10, 1
skip_outer_flags_loop:
        imm r1, 5
        jlt r10, r1, skip_outer_flag
        imm r20, 526344
        imm r21, 1
        call exact_require_cell
        imm r20, 526432
        imm r21, 2
        call exact_require_cell
        imm r1, 526368
        imm r2, 1398229326            ; SWIN
        store r1, r2
        imm r1, 526216
        imm r2, 1398231888            ; SWSQ
        store r1, r2
        ret
skip_outer_flag:
        mov r2, r10
        imm r1, 1
        sub r2, r1
        imm r1, 8
        mul r2, r1
        imm r1, 526376
        add r1, r2
        load r2, r1
        imm r3, 1
        jeq r2, r3, skip_outer_flag_next
        jmp reject
skip_outer_flag_next:
        imm r1, 1
        add r10, r1
        jmp skip_outer_flags_loop

skip_outer_take_clause:
        mov r25, r20
        mov r26, r21
        call skip_outer_require_invariant
        imm r20, 526168
        imm r21, 1398231892
        call exact_require_cell
        mov r20, r26
        imm r21, 1
        call exact_require_cell
        imm r1, 526352
        store r1, r25
        ret

skip_outer_backedge:
        imm r1, 526352
        load r2, r1
        imm r3, 3
        jlt r2, r3, skip_outer_backedge_progress
        jmp reject
skip_outer_backedge_progress:
        call skip_outer_require_invariant
        imm r1, 526424
        imm r2, 2                    ; strict-progress successor cursor
        store r1, r2
        imm r1, 526336
        store r1, r2                  ; strictly smaller LEN-CUR rank
        imm r1, 526344
        imm r2, 1                    ; checked outer rank decrease
        store r1, r2
        call skip_outer_close_backedge
        call skip_outer_mark_complete
        ret

skip_outer_exit:
        call skip_outer_require_invariant
        imm r1, 526352
        load r2, r1
        imm r3, 3
        jlt r2, r3, reject            ; checked no backedge on result zero
        imm r1, 526360
        store r1, r2
        call skip_outer_mark_complete
        ret

; Outer cutpoint invariant.  The successful slurp segment supplies finite LEN,
; and cursor/rank tag one denotes the current version i with rank LEN-i.
skip_outer_require_invariant:
        call skip_require_domain
        imm r20, 526424
        imm r21, 1
        call exact_require_cell
        imm r20, 526336
        imm r21, 1
        call exact_require_cell
        ret

; Both result-one step clauses carry strict CUR progress.  Require the
; correlated successor cursor/smaller-rank state, then rename it back to the
; quantified loop-head variables before rechecking the invariant.
skip_outer_close_backedge:
        call skip_require_domain
        imm r20, 526424
        imm r21, 2
        call exact_require_cell
        imm r20, 526336
        imm r21, 2
        call exact_require_cell
        imm r20, 526344
        imm r21, 1
        call exact_require_cell
        imm r1, 526432
        imm r2, 2                    ; checked outer successor renaming
        store r1, r2
        imm r20, 526432
        imm r21, 2
        call exact_require_cell
        imm r1, 526424
        imm r2, 1                    ; checked renamed outer cursor
        store r1, r2
        imm r1, 526336
        store r1, r2                  ; renamed smaller rank is LEN-CUR
        call skip_outer_require_invariant
        ret

skip_outer_mark_complete:
        imm r1, 526352
        load r2, r1
        imm r1, 1
        sub r2, r1
        imm r1, 8
        mul r2, r1
        imm r1, 526376
        add r1, r2
        imm r2, 1
        store r1, r2
        ret

; ---- Shared imports and exact scans -----------------------------------

skip_require_leaf_theorems:
        call skip_require_cbyte_theorem
        call skip_require_adv_theorem
        call skip_require_space_theorem
        ret

skip_require_cbyte_theorem:
        imm r20, 525960
        imm r21, 1128421445
        jmp exact_require_cell

skip_require_adv_theorem:
        imm r20, 525968
        imm r21, 1094992965
        jmp exact_require_cell

skip_require_space_theorem:
        imm r20, 525976
        imm r21, 1397769539
        jmp exact_require_cell

skip_introduce_domain:
        imm r20, 525744
        imm r21, 1
        call exact_require_cell
        imm r1, 526320
        imm r2, 1                    ; SRC segment, 0<=CUR<=LEN<=CAP
        store r1, r2
        ret

skip_require_domain:
        imm r20, 526320
        imm r21, 1
        jmp exact_require_cell

; Region [r20,r21) has exactly r22 ordinary calls and r23 returns, and no
; direct input/output, halt, division, or remainder.  Event/transition/local/
; memory censuses above close the corresponding source-side inventory.
skip_scan_call_region:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r28, r23
        imm r10, 0
        imm r11, 0
skip_scan_call_loop:
        jlt r25, r26, skip_scan_call_pc
        jeq r10, r27, skip_scan_return_count
        jmp reject
skip_scan_return_count:
        jeq r11, r28, exact_shape_ok
        jmp reject
skip_scan_call_pc:
        imm r1, 4194304
        add r1, r25
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, skip_scan_call_start
        jmp skip_scan_call_next
skip_scan_call_start:
        imm r1, 2097152
        add r1, r25
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, skip_scan_count_call
        imm r3, 20
        jeq r2, r3, skip_scan_count_return
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 6
        jeq r2, r3, reject
        imm r3, 7
        jeq r2, r3, reject
        imm r3, 17
        jeq r2, r3, reject
        imm r3, 18
        jeq r2, r3, reject
        jmp skip_scan_call_next
skip_scan_count_call:
        imm r1, 1
        add r10, r1
        jmp skip_scan_call_next
skip_scan_count_return:
        imm r1, 1
        add r11, r1
skip_scan_call_next:
        imm r1, 1
        add r25, r1
        jmp skip_scan_call_loop
