; Source call row/block/arity/target-procedure in r20..r23. All artifact
; coordinates, including the canonical fallthrough, come from checked identity.
statement_gen_stmt_require_call:
        mov r24, r23
        imm r23, 0                   ; no ambient expression temporary
        call summary_require_call_fallthrough_identity
        ret

statement_gen_stmt_require_return:
