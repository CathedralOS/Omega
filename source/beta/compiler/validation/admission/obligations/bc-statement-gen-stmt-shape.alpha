; Exact control/effect shape for gen_stmt (procedure67).
; The public entry also calls the private data companion so the whole procedure
; closes through one callable shape theorem.

statement_gen_stmt_require_shape:
        call statement_gen_stmt_require_proc
        call statement_gen_stmt_require_blocks
        call statement_gen_stmt_require_transitions
        call statement_gen_stmt_require_events
        call statement_gen_stmt_require_data
        ret

statement_gen_stmt_require_proc:
        imm r20, 7151616
        imm r21, 67
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 67
        imm r22, 1
        call transfer_require_cell
        imm r20, 67
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, exact_shape_ok
        jmp reject

