; Semantic continuation for bc-bounded-emitters-summary.alpha.
; Owns total mnemonic/combine meaning, bounded slot-address composition, and
; load/store wrappers. The adjacent publication module owns the final join.
; Next fresh cell is 532504; cells 532240..<532504 are documented by the
; primary summary and carry parameter/child provenance.
bounded_prove_emit_mnemonic:
        call bounded_mnemonic_require_full_word_complement
        imm r10, 1
        imm r11, 0
bounded_mnemonic_loop:
        imm r1, 7                    ; six total mnemonic partitions endpoint
        jlt r10, r1, bounded_mnemonic_case
        imm r1, 6
        jeq r11, r1, bounded_mnemonic_publish
        jmp reject
bounded_mnemonic_case:
        call bounded_reset_case
        imm r1, 532248
        imm r2, 1297240143            ; OPRM: arbitrary actual slot-zero OP
        store r1, r2
        imm r1, 532256
        store r1, r10                  ; exact partition selected for OP
        call bounded_mnemonic_build_guard_chain
        imm r1, 532040
        store r1, r10
        imm r1, 6
        jeq r10, r1, bounded_mnemonic_complement
        call bounded_mnemonic_append_selected
        jmp bounded_mnemonic_finish
bounded_mnemonic_complement:
        imm r20, 532200
        imm r21, 1
        call exact_require_cell
        ; Exact transition shape makes the complement take event 357's return
        ; before event 358. Its output is precisely the arbitrary prior trace.
        imm r1, 531984
        imm r2, 1
        store r1, r2
bounded_mnemonic_finish:
        imm r1, 532264
        store r1, r10                  ; EMNE(OP) output class for same OP
        imm r1, 532008
        imm r2, 1
        store r1, r2                   ; every reachable source return is zero
        imm r1, 532000
        store r1, r2
        imm r20, 531992
        imm r21, 1
        call exact_require_cell
        imm r20, 532000
        imm r21, 1
        call exact_require_cell
        imm r20, 532008
        imm r21, 1
        call exact_require_cell
        imm r20, 532248
        imm r21, 1297240143
        call exact_require_cell
        imm r20, 532256
        mov r21, r10
        call exact_require_cell
        imm r20, 532264
        mov r21, r10
        call exact_require_cell
        call bounded_mnemonic_require_guard_chain
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp bounded_mnemonic_loop
bounded_mnemonic_publish:
        imm r1, 532176
        store r1, r11
        imm r1, 532056
        imm r2, 1
        store r1, r2
        imm r1, 531904
        imm r2, 1162759493            ; EMNE
        store r1, r2
        imm r1, 532392
        imm r2, 1347308869            ; EMNP, parameterized EMNE(OP)
        store r1, r2
        ret
; Cases 1..5 select add/sub/mul/div/mod event rows. Each is exactly 3 bytes.
bounded_mnemonic_append_selected:
        imm r1, 1
        jeq r10, r1, bounded_mnemonic_add
        imm r1, 2
        jeq r10, r1, bounded_mnemonic_sub
        imm r1, 3
        jeq r10, r1, bounded_mnemonic_mul
        imm r1, 4
        jeq r10, r1, bounded_mnemonic_div
        imm r20, 358
        jmp bounded_mnemonic_append
bounded_mnemonic_add:
        imm r20, 349
        jmp bounded_mnemonic_append
bounded_mnemonic_sub:
        imm r20, 351
        jmp bounded_mnemonic_append
bounded_mnemonic_mul:
        imm r20, 353
        jmp bounded_mnemonic_append
bounded_mnemonic_div:
        imm r20, 355
bounded_mnemonic_append:
        imm r21, 3
        imm r22, 0
        imm r23, 1
        call bounded_append_fixed
        ret

; Reconstruct the exact add/sub/mul/div/mod full-Word equality chain for the
; same arbitrary parameter OP. Recognized case j carries j-1 false guards then
; equality with its exact literal; complement carries all five false guards.
bounded_mnemonic_build_guard_chain:
        imm r1, 532480
        imm r2, 0
        store r1, r2                   ; false-prefix length
        imm r1, 532488
        store r1, r2                   ; terminal predicate
        imm r1, 532496
        store r1, r2                   ; recognized literal / complement witness
        imm r12, 1
bounded_mnemonic_guard_loop:
        imm r1, 6
        jeq r10, r1, bounded_mnemonic_guard_complement
        jeq r12, r10, bounded_mnemonic_guard_match
        jmp bounded_mnemonic_guard_false
bounded_mnemonic_guard_complement:
        imm r1, 6
        jeq r12, r1, bounded_mnemonic_guard_complement_done
bounded_mnemonic_guard_false:
        imm r20, 532248
        imm r21, 1297240143             ; same OPRM reaches every guard
        call exact_require_cell
        imm r1, 532480
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        add r12, r3
        jmp bounded_mnemonic_guard_loop
bounded_mnemonic_guard_match:
        call bounded_mnemonic_selected_literal
        imm r1, 532496
        store r1, r0                   ; exact literal equal to OP in this clause
        imm r1, 532488
        imm r2, 2
        store r1, r2                   ; selected guard true
        ret
bounded_mnemonic_guard_complement_done:
        imm r1, 532488
        imm r2, 1
        store r1, r2                   ; all five guards false for arbitrary OP
        imm r1, 532496
        store r1, r2                   ; complement provenance, not a sample Word
        ret

bounded_mnemonic_selected_literal:
        imm r1, 1
        jeq r10, r1, bounded_mnemonic_literal_add
        imm r1, 2
        jeq r10, r1, bounded_mnemonic_literal_sub
        imm r1, 3
        jeq r10, r1, bounded_mnemonic_literal_mul
        imm r1, 4
        jeq r10, r1, bounded_mnemonic_literal_div
        imm r0, 37
        ret
bounded_mnemonic_literal_add:
        imm r0, 43
        ret
bounded_mnemonic_literal_sub:
        imm r0, 45
        ret
bounded_mnemonic_literal_mul:
        imm r0, 42
        ret
bounded_mnemonic_literal_div:
        imm r0, 47
        ret

bounded_mnemonic_require_guard_chain:
        imm r1, 6
        jeq r10, r1, bounded_mnemonic_require_complement_chain
        mov r21, r10
        imm r1, 1
        sub r21, r1
        imm r20, 532480
        call exact_require_cell
        imm r20, 532488
        imm r21, 2
        call exact_require_cell
        call bounded_mnemonic_selected_literal
        imm r20, 532496
        mov r21, r0
        call exact_require_cell
        ret
bounded_mnemonic_require_complement_chain:
        imm r20, 532480
        imm r21, 5
        call exact_require_cell
        imm r20, 532488
        imm r21, 1
        call exact_require_cell
        imm r20, 532496
        imm r21, 1
        call exact_require_cell
        ret

; High-word aliases of all five operator bytes must remain in the complement;
; exact shape binds the source guards to full-Word equality rather than lowb.
bounded_mnemonic_require_full_word_complement:
        imm r10, 43
        call bounded_mnemonic_require_high_alias
        imm r10, 45
        call bounded_mnemonic_require_high_alias
        imm r10, 42
        call bounded_mnemonic_require_high_alias
        imm r10, 47
        call bounded_mnemonic_require_high_alias
        imm r10, 37
        call bounded_mnemonic_require_high_alias
        imm r1, 532200
        imm r2, 1
        store r1, r2                   ; full-Word mnemonic complement
        ret
bounded_mnemonic_require_high_alias:
        mov r1, r10
        imm r2, 256
        add r1, r2
        jeq r1, r10, reject
        ret

bounded_prove_emit_combine:
        imm r10, 1                    ; all five singleton branches + complement
        imm r11, 0
bounded_combine_loop:
        imm r1, 7
        jlt r10, r1, bounded_combine_case
        imm r1, 532088
        store r1, r11
        imm r1, 531912
        imm r2, 1112359749            ; ECMB
        store r1, r2
        ret
bounded_combine_case:
        call bounded_reset_case
        imm r1, 532272
        imm r2, 1297240143            ; same symbolic parameter identity OPRM
        store r1, r2
        imm r20, 360
        imm r21, 10
        imm r22, 0
        imm r23, 1
        call bounded_append_fixed
        imm r20, 361
        imm r21, 12
        imm r22, 1
        imm r23, 2
        call bounded_append_fixed
        imm r20, 362
        imm r21, 0
        imm r22, 2
        imm r23, 3
        call bounded_append_fixed
        imm r20, 363
        imm r21, 12
        imm r22, 3
        imm r23, 4
        call bounded_append_fixed
        imm r20, 531904
        imm r21, 1162759493            ; exact total mnemonic child
        call exact_require_cell
        imm r20, 532392
        imm r21, 1347308869            ; parameterized EMNE(OP)
        call exact_require_cell
        imm r20, 532272
        imm r21, 1297240143
        call exact_require_cell
        ; Shape row local138 and argument-push row320 bind event364 to slot-zero
        ; OP. Copy that exact caller cell; do not mint an independent child OP.
        imm r1, 532272
        load r2, r1
        imm r1, 532280
        store r1, r2                   ; event364 argument is the same OP
        imm r20, 532280
        imm r21, 1297240143
        call exact_require_cell
        imm r1, 532040
        store r1, r10                  ; caller-selected EMNE(OP) partition
        load r2, r1
        imm r1, 532288
        store r1, r2                   ; child output uses that same partition
        imm r20, 532040
        mov r21, r10
        call exact_require_cell
        imm r20, 532288
        mov r21, r10
        call exact_require_cell
        imm r1, 531976
        imm r2, 5
        store r1, r2                   ; child completed before suffix
        imm r1, 532024
        imm r2, 1
        store r1, r2
        imm r20, 365
        imm r21, 7
        imm r22, 5
        imm r23, 6
        call bounded_append_fixed
        call bounded_finish_restored
        imm r20, 532048
        imm r21, 41                   ; fixed bytes; child contributes 3 or 0
        call exact_require_cell
        imm r20, 532024
        imm r21, 1
        call exact_require_cell
        call bounded_require_dead_restored
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp bounded_combine_loop

; ---- emit_slot_addr / wrappers --------------------------------------

bounded_prove_emit_slot_addr:
        imm r10, 0                    ; selected reg
        imm r11, 0                    ; selected slot
        imm r12, 0                    ; exact pair count
bounded_slot_addr_reg_loop:
        imm r1, 2
        jlt r10, r1, bounded_slot_addr_slot_loop
        imm r1, 2048
        jeq r12, r1, bounded_slot_addr_publish
        jmp reject
bounded_slot_addr_slot_loop:
        imm r1, 1024
        jlt r11, r1, bounded_slot_addr_case
        imm r1, 0
        jeq r10, r1, bounded_slot_addr_publish_reg_zero
        imm r1, 532304
        imm r2, 1093751621            ; ES1A: forall slot, ESLA(1,slot)
        store r1, r2
        jmp bounded_slot_addr_next_reg
bounded_slot_addr_publish_reg_zero:
        imm r1, 532296
        imm r2, 1093686085            ; ES0A: forall slot, ESLA(0,slot)
        store r1, r2
bounded_slot_addr_next_reg:
        imm r1, 1
        add r10, r1
        imm r11, 0
        jmp bounded_slot_addr_reg_loop

bounded_slot_addr_case:
        call bounded_reset_case
        imm r1, 532136
        store r1, r10                  ; exact selected reg value
        imm r1, 532144
        store r1, r11                  ; exact selected slot s
        imm r1, 532312
        store r1, r11                  ; parameterized clause retains s
        mov r13, r11
        imm r1, 8
        mul r13, r1
        add r13, r1                   ; exact offset=8+8*s
        imm r1, 532152
        store r1, r13
        imm r1, 532320
        store r1, r13                  ; same offset passed to child
        imm r1, 8193
        jlt r13, r1, bounded_slot_addr_offset_in_range
        jmp reject
bounded_slot_addr_offset_in_range:
        imm r1, 532160
        imm r2, 1
        store r1, r2                   ; per-instance nonwrapping arithmetic
        imm r20, 532192
        imm r21, 1
        call exact_require_cell

        imm r20, 366
        imm r21, 5
        imm r22, 0
        imm r23, 1
        call bounded_append_fixed
        mov r20, r10                   ; first DECS receives exact reg
        imm r21, 1
        imm r22, 2
        call bounded_append_decimal
        imm r1, 532328
        store r1, r10                  ; first child reg
        imm r20, 532240
        mov r21, r10
        call exact_require_cell

        imm r20, 368
        imm r21, 5
        imm r22, 2
        imm r23, 3
        call bounded_append_fixed
        imm r20, 369
        imm r21, 7
        imm r22, 3
        imm r23, 4
        call bounded_append_fixed
        imm r1, 532320
        load r20, r1                   ; second DECS receives exact 8+8*s
        imm r21, 4
        imm r22, 5
        call bounded_append_decimal
        imm r1, 532320
        load r13, r1
        imm r1, 532336
        store r1, r13                  ; exact offset child
        imm r20, 532240
        mov r21, r13
        call exact_require_cell

        imm r20, 371
        imm r21, 1
        imm r22, 5
        imm r23, 6
        call bounded_append_fixed
        imm r20, 372
        imm r21, 5
        imm r22, 6
        imm r23, 7
        call bounded_append_fixed
        mov r20, r10                   ; third DECS receives same exact reg
        imm r21, 7
        imm r22, 8
        call bounded_append_decimal
        imm r1, 532344
        store r1, r10                  ; repeated child reg
        imm r20, 532240
        mov r21, r10
        call exact_require_cell
        imm r20, 374
        imm r21, 4
        imm r22, 8
        imm r23, 9
        call bounded_append_fixed

        imm r20, 532136
        mov r21, r10
        call exact_require_cell
        imm r20, 532144
        mov r21, r11
        call exact_require_cell
        imm r20, 532312
        mov r21, r11
        call exact_require_cell
        imm r20, 532152
        mov r21, r13
        call exact_require_cell
        imm r20, 532320
        mov r21, r13
        call exact_require_cell
        imm r20, 532328
        mov r21, r10
        call exact_require_cell
        imm r20, 532336
        mov r21, r13
        call exact_require_cell
        imm r20, 532344
        mov r21, r10
        call exact_require_cell
        imm r1, 532352
        imm r2, 1
        store r1, r2                   ; first and third child use same reg
        imm r1, 532360
        store r1, r2                   ; selected s determines the one offset
        call bounded_finish_restored
        imm r20, 532048
        imm r21, 27
        call exact_require_cell
        imm r20, 532024
        imm r21, 3
        call exact_require_cell
        imm r20, 532352
        imm r21, 1
        call exact_require_cell
        imm r20, 532360
        imm r21, 1
        call exact_require_cell
        call bounded_require_dead_restored
        imm r1, 1
        add r11, r1
        add r12, r1
        jmp bounded_slot_addr_slot_loop

bounded_slot_addr_publish:
        imm r20, 532296
        imm r21, 1093686085
        call exact_require_cell
        imm r20, 532304
        imm r21, 1093751621
        call exact_require_cell
        imm r1, 532096
        imm r2, 2048
        store r1, r2
        imm r1, 531920
        imm r2, 1095521093            ; ESLA
        store r1, r2
        ret

bounded_prove_emit_load_slot:
        imm r10, 0
        imm r11, 0
bounded_load_slot_loop:
        imm r1, 1024
        jlt r10, r1, bounded_load_slot_case
        imm r1, 532104
        store r1, r11
        imm r1, 531928
        imm r2, 1396984901            ; ELDS
        store r1, r2
        ret
bounded_load_slot_case:
        call bounded_reset_case
        imm r20, 532296
        imm r21, 1093686085            ; parameterized ESLA(0,s)
        call exact_require_cell
        imm r1, 532368
        store r1, r10                  ; wrapper slot s
        imm r1, 532376
        store r1, r10                  ; event375 child receives same s
        imm r1, 532384
        imm r2, 0
        store r1, r2                   ; event375 first argument is exact zero
        imm r20, 532368
        mov r21, r10
        call exact_require_cell
        imm r20, 532376
        mov r21, r10
        call exact_require_cell
        imm r20, 532384
        imm r21, 0
        call exact_require_cell
        imm r1, 531976
        imm r2, 1
        store r1, r2                   ; ESLA(0,s) child precedes suffix
        imm r1, 532024
        store r1, r2
        imm r20, 376
        imm r21, 11
        imm r22, 1
        imm r23, 2
        call bounded_append_fixed
        call bounded_finish_restored
        imm r20, 532048
        imm r21, 11
        call exact_require_cell
        imm r20, 532024
        imm r21, 1
        call exact_require_cell
        call bounded_require_dead_restored
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp bounded_load_slot_loop

bounded_prove_emit_store_slot:
        imm r10, 0
        imm r11, 0
bounded_store_slot_loop:
        imm r1, 1024
        jlt r10, r1, bounded_store_slot_case
        imm r1, 532112
        store r1, r11
        imm r1, 531936
        imm r2, 1398035269            ; ESTS
        store r1, r2
        ret
bounded_store_slot_case:
        call bounded_reset_case
        imm r20, 532304
        imm r21, 1093751621            ; parameterized ESLA(1,s)
        call exact_require_cell
        imm r1, 532368
        store r1, r10                  ; wrapper slot s
        imm r1, 532376
        store r1, r10                  ; event377 child receives same s
        imm r1, 532384
        imm r2, 1
        store r1, r2                   ; event377 first argument is exact one
        imm r20, 532368
        mov r21, r10
        call exact_require_cell
        imm r20, 532376
        mov r21, r10
        call exact_require_cell
        imm r20, 532384
        imm r21, 1
        call exact_require_cell
        imm r1, 531976
        imm r2, 1
        store r1, r2                   ; ESLA(1,s) child precedes suffix
        imm r1, 532024
        store r1, r2
        imm r20, 378
        imm r21, 12
        imm r22, 1
        imm r23, 2
        call bounded_append_fixed
        call bounded_finish_restored
        imm r20, 532048
        imm r21, 12
        call exact_require_cell
        imm r20, 532024
        imm r21, 1
        call exact_require_cell
        call bounded_require_dead_restored
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp bounded_store_slot_loop
