; Conditional maximal composition from PFXS's genbody cutpoint through p68.
;
; The local hypotheses are PFXS and the discharged statement relation SREL.
; The theorem is uniform in exact entry BLOCKDEPTH D:
;   D<64: Ret(status0), Ret(numeric252), or Div;
;   D=64: the immediate depth-exhaustion Ret(numeric252) base only.
; Every finite row appends the exact five-fragment/41-byte p46 trace, returns
; source zero, and restores exact entry D and the p68 caller. Every Div row
; retains the maximal child prefix and live resumptions, never reaches event601,
; and assumes neither cursor nor stdout productivity. Numeric252 retains its
; exact child-guard provenance and is never promoted to ResourceKind.

parse_body_rules_init:
        call parse_body_require_imports
        call parse_body_build_trace_terms
        call parse_body_build_outcomes
        call parse_body_require_headers
        call parse_body_require_trace_terms
        call parse_body_require_outcomes
        call parse_body_publish
        jmp scan_owned_effects_init

parse_body_require_imports:
        imm r20, 560416
        imm r21, 1481785936             ; PBRX
        call exact_require_cell
        imm r20, 560424
        imm r21, 1414414672             ; PANT
        call exact_require_cell
        imm r20, 560432
        imm r21, 1213416016             ; PBSH
        call exact_require_cell
        imm r20, 560448
        imm r21, 1397310547             ; hypothetical SREL/SDIS schema
        call exact_require_cell
        ret

; Five symbolic trace terms bind order without pretending to materialize an
; arbitrary or infinite stdout sequence in checker memory:
;   T1=PFXS prefix P; T2=SREL child C; T3=SEPI suffix E;
;   T4=P||C; T5=(P||C)||E.
parse_body_build_trace_terms:
        imm r20, 348
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        mov r24, r0
        imm r20, 1
        imm r21, 1                      ; imported PFXS constructor
        imm r22, 1398294096             ; PFXS
        mov r23, r24
        call parse_body_store_trace_term
        imm r20, 2
        imm r21, 2                      ; child trace constructor
        imm r22, 1279611475             ; complete discharged SREL
        imm r23, 65                     ; exact D context count
        call parse_body_store_trace_term
        imm r20, 3
        imm r21, 3                      ; fixed suffix constructor
        imm r22, 1229997395             ; SEPI
        imm r23, 41                     ; exact suffix bytes
        call parse_body_store_trace_term
        imm r20, 4
        imm r21, 4                      ; concatenation
        imm r22, 1                      ; P
        imm r23, 2                      ; C
        call parse_body_store_trace_term
        imm r20, 5
        imm r21, 4                      ; concatenation
        imm r22, 4                      ; P||C
        imm r23, 3                      ; E
        call parse_body_store_trace_term
        imm r1, 560456
        imm r2, 5                      ; exact trace-term count
        store r1, r2
        imm r1, 560504
        imm r2, 41                     ; exact SEPI suffix length
        store r1, r2
        imm r1, 560512
        imm r2, 5                      ; all finite rows root at P||C||E
        store r1, r2
        imm r1, 560520
        imm r2, 4                      ; all Div rows root at P||C
        store r1, r2
        imm r1, 560544
        imm r2, 1                      ; reachable explicit p68 return path
        store r1, r2
        imm r1, 560552
        imm r2, 1                      ; synthetic epilogue unreachable
        store r1, r2
        imm r1, 560560
        imm r2, 1                      ; opaque child provenance parameter rho
        store r1, r2
        imm r1, 560568
        imm r2, 1                      ; child state/cursor projection parameter
        store r1, r2
        ret

; r20=id in1..5,r21=constructor,r22=lhs/payload,r23=rhs/value.
parse_body_store_trace_term:
        mov r24, r20
        imm r1, 1
        sub r24, r1
        imm r1, 40
        mul r24, r1
        imm r1, 560600
        add r24, r1
        store r24, r20
        imm r1, 8
        add r24, r1
        store r24, r21
        imm r1, 8
        add r24, r1
        store r24, r22
        imm r1, 8
        add r24, r1
        store r24, r23
        imm r1, 8
        add r24, r1
        imm r1, 1
        store r24, r1
        ret

; Materialize the complete outcome family, rather than an informal product:
; 64 Ret0 + 65 Ret252 + 64 Div = 193 rows. For D<64 rows are ordered
; Ret0,Ret252,Div. The sole D64 row is Ret252.
parse_body_build_outcomes:
        imm r10, 0                     ; D
        imm r12, 0                     ; row index
        imm r13, 0                     ; Ret0 count
        imm r14, 0                     ; Ret252 count
        imm r15, 0                     ; Div count
parse_body_build_depth_loop:
        imm r1, 64
        jlt r10, r1, parse_body_build_depth_rows
        jeq r10, r1, parse_body_build_d64
        jmp parse_body_build_done
parse_body_build_depth_rows:
        imm r11, 1                     ; Ret0
        call parse_body_store_outcome
        imm r1, 1
        add r13, r1
        add r12, r1
        imm r11, 2                     ; Ret252, opaque exact child guard
        call parse_body_store_outcome
        imm r1, 1
        add r14, r1
        add r12, r1
        imm r11, 3                     ; Div
        call parse_body_store_outcome
        imm r1, 1
        add r15, r1
        add r12, r1
        add r10, r1
        jmp parse_body_build_depth_loop
parse_body_build_d64:
        imm r11, 2                     ; immediate depth exhaustion Ret252
        call parse_body_store_outcome
        imm r1, 1
        add r14, r1
        add r12, r1
        add r10, r1
        jmp parse_body_build_depth_loop
parse_body_build_done:
        imm r1, 560464
        imm r2, 65                     ; exact D=0..64 contexts
        store r1, r2
        imm r1, 560472
        store r1, r12                  ; exact outcome count193
        imm r1, 560480
        store r1, r13                  ; exact Ret0 count64
        imm r1, 560488
        store r1, r14                  ; exact Ret252 count65
        imm r1, 560496
        store r1, r15                  ; exact Div count64
        imm r1, 560528
        imm r2, 2                      ; D64 admits only kind2 Ret252
        store r1, r2
        imm r1, 560536
        imm r2, 1                      ; ResourceKind remains unclaimed
        store r1, r2
        ret

; r10=D,r11=kind(1 Ret0,2 Ret252,3 Div),r12=row index.
; Row fields are D, kind, child observation, terminal-status validity, numeric
; status, provenance, trace root, event601 reachability, parse-result validity,
; result, frame state, depth state, child-trace class, maximality,
; no-cursor-productivity, no-output-productivity, no-ResourceKind, completion,
; PFXS-D-to-SREL-D custody, finite-final/div-resumption state+cursor custody,
; and exact identity custody for the opaque child provenance parameter rho.
parse_body_store_outcome:
        mov r20, r12
        imm r1, 168
        mul r20, r1
        imm r1, 562000
        add r20, r1
        store r20, r10                 ; +0 exact entry D
        imm r1, 8
        add r20, r1
        store r20, r11                 ; +8 outcome kind

        imm r21, 1                     ; Ret child observation
        imm r22, 1                     ; terminal status present
        imm r23, 0                     ; Ret0 status
        imm r24, 1                     ; ordinary zero provenance
        imm r25, 5                     ; finite trace root T5
        imm r26, 1                     ; event601 reached
        imm r27, 1                     ; parse result present
        imm r28, 1                     ; caller frame restored
        imm r29, 1                     ; exact entry D restored
        imm r30, 2                     ; finite child trace
        imm r1, 2
        jeq r11, r1, parse_body_store_ret252
        imm r1, 3
        jeq r11, r1, parse_body_store_div
        jmp parse_body_store_common
parse_body_store_ret252:
        imm r23, 252                   ; exact numeric resource status
        imm r24, 3                     ; opaque exact child-guard provenance
        imm r25, 5                     ; numeric252 still appends outer E
        imm r1, 64
        jeq r10, r1, parse_body_store_d64
        jmp parse_body_store_common
parse_body_store_d64:
        imm r24, 2                     ; exact D64 depth-guard provenance
        imm r30, 1                     ; epsilon child/base trace
        jmp parse_body_store_common
parse_body_store_div:
        imm r21, 2                     ; divergent child observation
        imm r22, 2                     ; no terminal status
        imm r23, 0                     ; ignored when status absent
        imm r24, 4                     ; nonterminal/no status provenance
        imm r25, 4                     ; divergent trace root T4, no E
        imm r26, 2                     ; event601 unreachable
        imm r27, 2                     ; no parse result
        imm r28, 2                     ; p68 and child resumptions live
        imm r29, 2                     ; live child depth, no decrement
        imm r30, 3                     ; maximal divergent child trace
parse_body_store_common:
        imm r1, 8
        add r20, r1
        store r20, r21                 ; +16 child observation
        imm r1, 8
        add r20, r1
        store r20, r22                 ; +24 status validity
        imm r1, 8
        add r20, r1
        store r20, r23                 ; +32 actual status / ignored zero
        imm r1, 8
        add r20, r1
        store r20, r24                 ; +40 exact provenance class
        imm r1, 8
        add r20, r1
        store r20, r25                 ; +48 trace root
        imm r1, 8
        add r20, r1
        store r20, r26                 ; +56 event601
        imm r1, 8
        add r20, r1
        store r20, r27                 ; +64 parse-result validity
        imm r1, 8
        add r20, r1
        imm r1, 0
        store r20, r1                  ; +72 source result0 / ignored for Div
        imm r1, 8
        add r20, r1
        store r20, r28                 ; +80 frame state
        imm r1, 8
        add r20, r1
        store r20, r29                 ; +88 depth state
        imm r1, 8
        add r20, r1
        store r20, r30                 ; +96 child trace class
        imm r1, 8
        add r20, r1
        imm r1, 1
        store r20, r1                  ; +104 maximal/exact trace
        imm r2, 8
        add r20, r2
        store r20, r1                  ; +112 no cursor productivity premise
        imm r2, 8
        add r20, r2
        store r20, r1                  ; +120 no stdout productivity premise
        imm r2, 8
        add r20, r2
        store r20, r1                  ; +128 no ResourceKind inference
        imm r2, 8
        add r20, r2
        store r20, r1                  ; +136 complete row
        imm r2, 8
        add r20, r2
        store r20, r1                  ; +144 PFXS depth D = selected SREL_D
        imm r2, 8
        add r20, r2
        store r20, r27                 ; +152 finite final/Div state+cursor
        imm r2, 8
        add r20, r2
        store r20, r1                  ; +160 child rho = final rho exactly
        ret

parse_body_require_headers:
        imm r20, 560456
        imm r21, 5
        call exact_require_cell
        imm r20, 560464
        imm r21, 65
        call exact_require_cell
        imm r20, 560472
        imm r21, 193
        call exact_require_cell
        imm r20, 560480
        imm r21, 64
        call exact_require_cell
        imm r20, 560488
        imm r21, 65
        call exact_require_cell
        imm r20, 560496
        imm r21, 64
        call exact_require_cell
        imm r20, 560504
        imm r21, 41
        call exact_require_cell
        imm r20, 560512
        imm r21, 5
        call exact_require_cell
        imm r20, 560520
        imm r21, 4
        call exact_require_cell
        imm r20, 560528
        imm r21, 2
        call exact_require_cell
        imm r20, 560536
        imm r21, 1
        call exact_require_cell
        imm r20, 560544
        imm r21, 1
        call exact_require_cell
        imm r20, 560552
        imm r21, 1
        call exact_require_cell
        imm r20, 560560
        imm r21, 1
        call exact_require_cell
        imm r20, 560568
        imm r21, 1
        call exact_require_cell
        ret

parse_body_require_trace_terms:
        imm r20, 348
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        mov r25, r0
        imm r20, 560600
        imm r21, 1
        imm r22, 1
        imm r23, 1398294096
        mov r24, r25
        call parse_body_require_trace_term
        imm r20, 560640
        imm r21, 2
        imm r22, 2
        imm r23, 1279611475
        imm r24, 65
        call parse_body_require_trace_term
        imm r20, 560680
        imm r21, 3
        imm r22, 3
        imm r23, 1229997395
        imm r24, 41
        call parse_body_require_trace_term
        imm r20, 560720
        imm r21, 4
        imm r22, 4
        imm r23, 1
        imm r24, 2
        call parse_body_require_trace_term
        imm r20, 560760
        imm r21, 5
        imm r22, 4
        imm r23, 4
        imm r24, 3
        call parse_body_require_trace_term
        ret

; r20=base,r21=id,r22=ctor,r23=lhs/payload,r24=rhs/value.
parse_body_require_trace_term:
        mov r30, r20
        mov r29, r21
        call parse_body_require_next_cell
        mov r29, r22
        call parse_body_require_next_cell
        mov r29, r23
        call parse_body_require_next_cell
        mov r29, r24
        call parse_body_require_next_cell
        imm r29, 1
        call parse_body_require_next_cell
        ret

; Recompute every expected row independently of the construction branch.
parse_body_require_outcomes:
        imm r10, 0                     ; D
        imm r12, 0                     ; row index
parse_body_require_depth_loop:
        imm r1, 64
        jlt r10, r1, parse_body_require_depth_rows
        jeq r10, r1, parse_body_require_d64
        imm r1, 193
        jeq r12, r1, parse_body_require_outcomes_done
        jmp reject
parse_body_require_depth_rows:
        imm r11, 1
        call parse_body_require_outcome
        imm r1, 1
        add r12, r1
        imm r11, 2
        call parse_body_require_outcome
        imm r1, 1
        add r12, r1
        imm r11, 3
        call parse_body_require_outcome
        imm r1, 1
        add r12, r1
        add r10, r1
        jmp parse_body_require_depth_loop
parse_body_require_d64:
        imm r11, 2
        call parse_body_require_outcome
        imm r1, 1
        add r12, r1
        add r10, r1
        jmp parse_body_require_depth_loop
parse_body_require_outcomes_done:
        ret

parse_body_require_outcome:
        mov r30, r12
        imm r1, 168
        mul r30, r1
        imm r1, 562000
        add r30, r1
        mov r29, r10
        call parse_body_require_next_cell
        mov r29, r11
        call parse_body_require_next_cell

        imm r21, 1
        imm r22, 1
        imm r23, 0
        imm r24, 1
        imm r25, 5
        imm r26, 1
        imm r27, 1
        imm r28, 1
        imm r18, 1
        imm r19, 2
        imm r1, 2
        jeq r11, r1, parse_body_require_ret252
        imm r1, 3
        jeq r11, r1, parse_body_require_div
        jmp parse_body_require_common
parse_body_require_ret252:
        imm r23, 252                   ; required exact numeric252
        imm r24, 3
        imm r1, 64
        jeq r10, r1, parse_body_require_d64_values
        jmp parse_body_require_common
parse_body_require_d64_values:
        imm r24, 2
        imm r19, 1
        jmp parse_body_require_common
parse_body_require_div:
        imm r21, 2
        imm r22, 2
        imm r23, 0
        imm r24, 4
        imm r25, 4
        imm r26, 2
        imm r27, 2
        imm r28, 2
        imm r18, 2
        imm r19, 3
parse_body_require_common:
        mov r29, r21
        call parse_body_require_next_cell
        mov r29, r22
        call parse_body_require_next_cell
        mov r29, r23
        call parse_body_require_next_cell
        mov r29, r24
        call parse_body_require_next_cell
        mov r29, r25
        call parse_body_require_next_cell
        mov r29, r26
        call parse_body_require_next_cell
        mov r29, r27
        call parse_body_require_next_cell
        imm r29, 0
        call parse_body_require_next_cell
        mov r29, r28
        call parse_body_require_next_cell
        mov r29, r18
        call parse_body_require_next_cell
        mov r29, r19
        call parse_body_require_next_cell
        imm r29, 1
        call parse_body_require_next_cell
        imm r29, 1
        call parse_body_require_next_cell
        imm r29, 1
        call parse_body_require_next_cell
        imm r29, 1
        call parse_body_require_next_cell
        imm r29, 1
        call parse_body_require_next_cell
        imm r29, 1
        call parse_body_require_next_cell
        mov r29, r27
        call parse_body_require_next_cell
        imm r29, 1
        call parse_body_require_next_cell
        ret

; r30 points at next cell, r29 is exact expected value.
parse_body_require_next_cell:
        load r17, r30
        jeq r17, r29, parse_body_require_next_ok
        jmp reject
parse_body_require_next_ok:
        imm r17, 8
        add r30, r17
        ret

parse_body_publish:
        imm r20, 560528
        imm r21, 2
        call exact_require_cell
        imm r20, 560536
        imm r21, 1
        call exact_require_cell
        imm r1, 560440
        imm r2, 1146045008             ; PBOD conditional body theorem
        store r1, r2
        imm r20, 560440
        imm r21, 1146045008
        call exact_require_cell
        ret
