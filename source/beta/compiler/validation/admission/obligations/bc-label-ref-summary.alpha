; Relational summary for emit_lref(n).
;
; For every Word n and arbitrary prior output trace tau, the exact procedure
; appends "_L" || D(n), where D is the independent full-Word emit_dec theorem,
; then returns zero and restores its caller.  Therefore signed-nonnegative n
; has the familiar canonical label spelling, while a high-bit/signed-negative
; Word has the source's one-byte 48+srem(n,10) suffix.  LREF deliberately does
; not invent a minus sign, unsigned formatting, or a global freshness claim.
;
; Public cell:
;   534840 LREF
; Private executable provenance:
;   535400 root                    535408 WSTR import
;   535416 DECW import             535424 exact shape
;   535432 selected n              535440 exact "_L" event
;   535448 ordered trace phase     535456 local keeps n
;   535464 argument push keeps n   535472 call handoff keeps n
;   535480 signed-domain contract  535488 child terminal/result
;   535496 child-after-prefix order 535504 exact output relation
;   535512 compiler-state quiet    535520 restored frame
;   535528 final result zero       535536 explicit-stack potential
;   535544 hidden-return potential 535552 stack-scratch exclusion
;   535560 completed join

label_ref_summary_init:
        call label_ref_reset
        call label_core_require_shape
        call label_ref_require_imports
        call label_ref_bind_parameter
        call label_ref_append_prefix
        call label_ref_bind_child
        call label_ref_require_signed_domain
        call label_ref_compose_trace
        call label_ref_prove_terminal
        call label_ref_finalize
        imm r1, 534840
        imm r2, 1178948172            ; LREF
        store r1, r2
        imm r20, 534840
        imm r21, 1178948172
        call exact_require_cell
        jmp emit_str_body_summary_init

label_ref_reset:
        imm r1, 535400
        imm r2, 535568
        imm r3, 0
label_ref_reset_loop:
        jlt r1, r2, label_ref_reset_one
        ret
label_ref_reset_one:
        store r1, r3
        imm r4, 8
        add r1, r4
        jmp label_ref_reset_loop

label_ref_require_imports:
        imm r20, 534800
        imm r21, 1163022164            ; EROOT
        call exact_require_cell
        imm r1, 535400
        imm r2, 1
        store r1, r2
        imm r20, 525816
        imm r21, 1465074514            ; WSTR
        call exact_require_cell
        imm r1, 535408
        imm r2, 1
        store r1, r2
        imm r20, 532560
        imm r21, 1464026436            ; DECW
        call exact_require_cell
        imm r1, 535416
        imm r2, 1
        store r1, r2
        imm r1, 535424
        store r1, r2                  ; exact label_core shape already checked
        ret

; Pin the parameter-store lowering that carries arbitrary entry n into slot0.
; The whole-frame phase owns its source association; these bytes make the
; selected machine handoff explicit in this summary.
label_ref_bind_parameter:
        imm r20, 1398
        imm r21, 2                    ; mov r5,r14
        call require_tape_byte
        imm r20, 1399
        imm r21, 5
        call require_tape_byte
        imm r20, 1400
        imm r21, 14
        call require_tape_byte
        imm r20, 1401
        imm r21, 1                    ; imm r4,8
        call require_tape_byte
        imm r20, 1402
        imm r21, 4
        call require_tape_byte
        imm r20, 1403
        imm r21, 8
        call require_tape_word
        imm r20, 1411
        imm r21, 4                    ; sub r5,r4
        call require_tape_byte
        imm r20, 1412
        imm r21, 5
        call require_tape_byte
        imm r20, 1413
        imm r21, 4
        call require_tape_byte
        imm r20, 1414
        imm r21, 11                   ; store r5,r0
        call require_tape_byte
        imm r20, 1415
        imm r21, 5
        call require_tape_byte
        imm r20, 1416
        imm r21, 0
        call require_tape_byte
        imm r1, 535432
        imm r2, 1                    ; symbolic arbitrary full-Word n
        store r1, r2
        ret

; Consume row5's instantiated WSTR clause and require its exact pointer,
; length, bytes, helper target, and continuation before advancing the trace.
label_ref_append_prefix:
        imm r20, 5
        call write_str_require_emit_event
        imm r2, 1426
        jeq r0, r2, label_ref_prefix_length
        jmp reject
label_ref_prefix_length:
        imm r2, 2
        jeq r1, r2, label_ref_prefix_bytes
        jmp reject
label_ref_prefix_bytes:
        imm r20, 1426
        imm r21, 95                   ; '_'
        call require_tape_byte
        imm r20, 1427
        imm r21, 76                   ; 'L'
        call require_tape_byte
        imm r20, 1448
        imm r21, 31
        imm r22, 1457
        call exact_require_call
        imm r1, 535440
        imm r2, 2                    ; exact two-byte helper clause
        store r1, r2
        imm r1, 535448
        imm r2, 1                    ; tau -> tau || "_L"
        store r1, r2
        ret

; Rejoin the parameter load, sole argument push, and exact zero-ambient call.
; All three tags are copied only from the selected entry-n provenance.
label_ref_bind_child:
        imm r20, 13
        imm r21, 6
        imm r22, 1
        imm r23, 0
        imm r24, 1457
        call transfer_require_local
        imm r20, 535432
        imm r21, 1
        call exact_require_cell
        imm r1, 535456
        imm r2, 1                    ; local load is selected n
        store r1, r2
        imm r20, 237
        imm r21, 6
        imm r23, 1476
        call exact_require_argument_push
        imm r20, 535456
        imm r21, 1
        call exact_require_cell
        imm r1, 535464
        imm r2, 1                    ; staged argument is same n
        store r1, r2
        imm r20, 6
        imm r21, 6
        imm r22, 1508
        imm r23, 1
        imm r24, 0
        imm r25, 29152
        imm r26, 1517
        call summary_require_call_site
        imm r20, 535464
        imm r21, 1
        call exact_require_cell
        imm r1, 535472
        imm r2, 1                    ; DECW selects that exact same n
        store r1, r2
        ret

; DECW partitions all Words by signed meaning.  Executable negative probes
; retain the surprising one-byte source behavior instead of silently turning
; this into an unsigned or minus-prefixed label theorem.
label_ref_require_signed_domain:
        imm r20, 532560
        imm r21, 1464026436            ; DECW
        call exact_require_cell
        imm r20, 532528
        imm r21, 1195724356            ; DNEG
        call exact_require_cell
        imm r20, 532536
        imm r21, 810373956             ; DSM0
        call exact_require_cell
        imm r20, 532544
        imm r21, 1397706820            ; DPOS
        call exact_require_cell
        imm r20, 532552
        imm r21, 1413694788            ; DECT
        call exact_require_cell
        imm r20, 535472
        imm r21, 1
        call exact_require_cell

        ; signed(-1)<0 and 48+srem(-1,10) is byte 47 ('/').
        imm r10, 0
        imm r12, 1
        sub r10, r12                 ; -1 without a high unsigned literal
        imm r11, 0
        jlt r10, r11, label_ref_negative_one
        jmp reject
label_ref_negative_one:
        imm r12, 10
        mod r10, r12
        imm r13, 0
        imm r14, 1
        sub r13, r14                 ; signed remainder -1
        jeq r10, r13, label_ref_negative_one_byte
        jmp reject
label_ref_negative_one_byte:
        imm r13, 48
        add r10, r13
        imm r13, 47
        jeq r10, r13, label_ref_intmin_probe
        jmp reject

        ; INT64_MIN has signed remainder -8, hence exactly byte 40 ('(').
label_ref_intmin_probe:
        imm r10, 9223372036854775807
        imm r14, 1
        add r10, r14                 ; INT64_MIN = INT64_MAX+1
        imm r12, 10
        mod r10, r12
        imm r13, 0
        imm r14, 8
        sub r13, r14                 ; signed remainder -8
        jeq r10, r13, label_ref_intmin_byte
        jmp reject
label_ref_intmin_byte:
        imm r13, 48
        add r10, r13
        imm r13, 40
        jeq r10, r13, label_ref_signed_done
        jmp reject
label_ref_signed_done:
        imm r1, 535480
        imm r2, 3                    ; negative/base/positive exact partition
        store r1, r2
        imm r1, 535488
        imm r2, 1                    ; DECW terminates/restores/returns zero
        store r1, r2
        ret

label_ref_compose_trace:
        imm r20, 535448
        imm r21, 1                    ; fixed prefix already appended
        call exact_require_cell
        imm r20, 535472
        imm r21, 1                    ; child receives the same selected n
        call exact_require_cell
        imm r20, 535480
        imm r21, 3                    ; preserve signed full-Word D(n)
        call exact_require_cell
        imm r1, 535448
        imm r2, 2                    ; tau || "_L" || D(n)
        store r1, r2
        imm r1, 535496
        imm r2, 1                    ; helper completion precedes child output
        store r1, r2
        imm r1, 535504
        imm r2, 3                    ; exact relation, not canonical-for-all
        store r1, r2
        ret

label_ref_prove_terminal:
        ; Own region contains no direct I/O/raw-memory/division/remainder.  WSTR
        ; and DECW supply the two finite child summaries; the fallthrough
        ; epilogue preserves DECW's zero rather than materializing a new value.
        imm r20, 1366
        imm r21, 1537
        imm r22, 2
        imm r23, 1
        imm r24, 3
        call exact_quiet_scan_region
        imm r20, 1517
        imm r21, 1536
        call exact_require_epilogue
        imm r20, 535488
        imm r21, 1
        call exact_require_cell
        imm r1, 535512
        imm r2, 1                    ; persistent compiler state is quiet
        store r1, r2
        imm r1, 535520
        store r1, r2                  ; child and caller frame restored
        imm r1, 535528
        store r1, r2                  ; exact final r0 is child zero

        ; D19R gives 19*frame16 + deepest temp8 = 312 decimal bytes of
        ; explicit-stack potential.  Add emit_lref's frame16; hidden depth is
        ; the nineteen-child bound plus this activation.
        imm r20, 532520
        imm r21, 1379479876            ; D19R
        call exact_require_cell
        imm r20, 534408
        imm r21, 19
        call exact_require_cell
        imm r10, 19
        imm r11, 16
        mul r10, r11
        imm r12, 8
        add r10, r12
        add r10, r11
        imm r13, 328
        jeq r10, r13, label_ref_explicit_potential
        jmp reject
label_ref_explicit_potential:
        imm r1, 535536
        store r1, r10
        imm r10, 19
        imm r11, 1
        add r10, r11
        imm r13, 20
        jeq r10, r13, label_ref_hidden_potential
        jmp reject
label_ref_hidden_potential:
        imm r1, 535544
        store r1, r10
        imm r1, 535552
        imm r2, 1                    ; dead frame/argument/child scratch excluded
        store r1, r2
        ret

; Consume every private semantic cell before minting LREF.
label_ref_finalize:
        imm r20, 535400
        imm r21, 1
        call exact_require_cell
        imm r20, 535408
        call exact_require_cell
        imm r20, 535416
        call exact_require_cell
        imm r20, 535424
        call exact_require_cell
        imm r20, 535432
        call exact_require_cell
        imm r20, 535440
        imm r21, 2
        call exact_require_cell
        imm r20, 535448
        call label_ref_require_phase_two
        imm r20, 535456
        imm r21, 1
        call exact_require_cell
        imm r20, 535464
        call exact_require_cell
        imm r20, 535472
        call exact_require_cell
        imm r20, 535480
        imm r21, 3
        call exact_require_cell
        imm r20, 535488
        imm r21, 1
        call exact_require_cell
        imm r20, 535496
        call exact_require_cell
        imm r20, 535504
        imm r21, 3
        call exact_require_cell
        imm r20, 535512
        imm r21, 1
        call exact_require_cell
        imm r20, 535520
        call exact_require_cell
        imm r20, 535528
        call exact_require_cell
        imm r20, 535536
        imm r21, 328
        call exact_require_cell
        imm r20, 535544
        imm r21, 20
        call exact_require_cell
        imm r20, 535552
        imm r21, 1
        call exact_require_cell
        imm r1, 535560
        imm r2, 20                   ; twenty consumed provenance cells
        store r1, r2
        imm r20, 535560
        imm r21, 20
        call exact_require_cell
        ret

; Keep the phase-two requirement separately named so a tooth can mutate only
; ordered composition without changing the generic exact-cell helper.
label_ref_require_phase_two:
        imm r21, 2
        call exact_require_cell
        ret
