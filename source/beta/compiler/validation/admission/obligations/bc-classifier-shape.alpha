; Exact source/artifact shape for the byte classifier family.
;
; This module owns only the is_digit/is_alpha/is_alnum CFG, effect, frame,
; primitive, push, and decoded-region joins. The adjacent relational module
; owns the finite byte-domain meaning and public theorem tokens.

classifier_require_shape:
        ; One parameter/slot and a 16-byte frame in every selected procedure.
        imm r20, 6
        call classifier_require_proc_frame
        imm r20, 7
        call classifier_require_proc_frame
        imm r20, 8
        call classifier_require_proc_frame

        ; Exact blocks and exhaustive procedure ownership.
        imm r20, 12
        imm r21, 6
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 13
        imm r21, 6
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 14
        imm r21, 6
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 15
        imm r21, 6
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 12
        imm r21, 15
        imm r22, 6
        call exact_require_proc_blocks

        imm r20, 16
        imm r21, 7
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 17
        imm r21, 7
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 18
        imm r21, 7
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 19
        imm r21, 7
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 20
        imm r21, 7
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 21
        imm r21, 7
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 22
        imm r21, 7
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 23
        imm r21, 7
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 16
        imm r21, 23
        imm r22, 7
        call exact_require_proc_blocks

        imm r20, 24
        imm r21, 8
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 25
        imm r21, 8
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 26
        imm r21, 8
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 24
        imm r21, 26
        imm r22, 8
        call exact_require_proc_blocks

        call classifier_require_transitions
        call classifier_require_events
        call classifier_require_locals
        call classifier_require_primitives
        call classifier_require_pushes
        call classifier_require_censuses
        ret

classifier_require_proc_frame:
        mov r30, r20
        imm r20, 7151616
        mov r21, r30
        imm r22, 1
        call transfer_require_cell
        imm r20, 7159808
        mov r21, r30
        imm r22, 1
        call transfer_require_cell
        mov r20, r30
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, exact_shape_ok
        jmp reject

classifier_require_transitions:
        ; is_digit: c<48 -> no, otherwise c2; c>57 -> no.
        imm r20, 5
        imm r21, 13
        imm r22, 1
        imm r23, 15
        call exact_transition_identity_pc
        imm r20, 6
        imm r21, 13
        imm r22, 0
        imm r23, 14
        call exact_transition_identity_pc
        imm r20, 7
        imm r21, 14
        imm r22, 1
        imm r23, 15
        call exact_transition_identity_pc

        ; is_alpha: underscore, uppercase range, then lowercase range.
        imm r20, 8
        imm r21, 17
        imm r22, 1
        imm r23, 23
        call exact_transition_identity_pc
        imm r20, 9
        imm r21, 17
        imm r22, 0
        imm r23, 18
        call exact_transition_identity_pc
        imm r20, 10
        imm r21, 18
        imm r22, 1
        imm r23, 22
        call exact_transition_identity_pc
        imm r20, 11
        imm r21, 18
        imm r22, 0
        imm r23, 19
        call exact_transition_identity_pc
        imm r20, 12
        imm r21, 19
        imm r22, 1
        imm r23, 23
        call exact_transition_identity_pc
        imm r20, 13
        imm r21, 19
        imm r22, 0
        imm r23, 20
        call exact_transition_identity_pc
        imm r20, 14
        imm r21, 20
        imm r22, 1
        imm r23, 22
        call exact_transition_identity_pc
        imm r20, 15
        imm r21, 20
        imm r22, 0
        imm r23, 21
        call exact_transition_identity_pc
        imm r20, 16
        imm r21, 21
        imm r22, 1
        imm r23, 23
        call exact_transition_identity_pc

        ; is_alnum takes yes exactly when is_alpha returned one.
        imm r20, 17
        imm r21, 25
        imm r22, 1
        imm r23, 26
        call exact_transition_identity_pc
        ret

classifier_require_events:
        ; is_digit explicit returns and all three exact epilogues.
        imm r20, 6
        imm r21, 14
        call exact_require_event_epilogue
        imm r20, 6
        imm r21, 15
        call exact_require_event_epilogue
        imm r20, 7
        call exact_require_preentry_epilogue

        ; is_alpha explicit returns and synthetic fallthrough.
        imm r20, 7
        imm r21, 21
        call exact_require_event_epilogue
        imm r20, 7
        imm r21, 22
        call exact_require_event_epilogue
        imm r20, 7
        imm r21, 23
        call exact_require_event_epilogue
        imm r20, 8
        call exact_require_preentry_epilogue

        ; is_alnum calls alpha, returns digit directly on false, and returns
        ; literal one on true. Event rows16/17 are lexical, not PC ordered.
        imm r20, 8
        imm r21, 25
        imm r22, 1
        imm r23, 0
        imm r24, 7
        call summary_require_call_fallthrough_identity
        imm r20, 8
        imm r21, 25
        imm r22, 1
        imm r23, 0
        imm r24, 6
        call summary_require_call_fallthrough_identity
        imm r20, 8
        imm r21, 25
        call exact_require_event_epilogue
        imm r20, 8
        imm r21, 26
        call exact_require_event_epilogue
        imm r20, 9
        call exact_require_preentry_epilogue
        ret

classifier_require_locals:
        ; Every comparison/call argument reloads the sole parameter slot.
        imm r20, 17
        imm r21, 13
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 18
        imm r21, 14
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 19
        imm r21, 17
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 20
        imm r21, 18
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 21
        imm r21, 19
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 22
        imm r21, 20
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 23
        imm r21, 21
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 24
        imm r21, 25
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 25
        imm r21, 25
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        ret

classifier_require_primitives:
        ; row/block/kind/value-or-comparison-code/PC.
        imm r20, 39
        imm r21, 13
        imm r22, 3
        imm r23, 8                   ; <
        call exact_primitive_identity_pc
        imm r20, 40
        imm r21, 13
        imm r22, 1
        imm r23, 48                  ; checked digit lower bound
        call exact_primitive_identity_pc
        imm r20, 41
        imm r21, 14
        imm r22, 3
        imm r23, 9                   ; >
        call exact_primitive_identity_pc
        imm r20, 42
        imm r21, 14
        imm r22, 1
        imm r23, 57                  ; checked digit upper bound
        call exact_primitive_identity_pc
        imm r20, 43
        imm r21, 14
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 44
        imm r21, 15
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc

        imm r20, 45
        imm r21, 17
        imm r22, 3
        imm r23, 10                  ; ==
        call exact_primitive_identity_pc
        imm r20, 46
        imm r21, 17
        imm r22, 1
        imm r23, 95                  ; checked underscore
        call exact_primitive_identity_pc
        imm r20, 47
        imm r21, 18
        imm r22, 3
        imm r23, 8                   ; <
        call exact_primitive_identity_pc
        imm r20, 48
        imm r21, 18
        imm r22, 1
        imm r23, 65                  ; checked uppercase lower
        call exact_primitive_identity_pc
        imm r20, 49
        imm r21, 19
        imm r22, 3
        imm r23, 12                  ; checked uppercase <=
        call exact_primitive_identity_pc
        imm r20, 50
        imm r21, 19
        imm r22, 1
        imm r23, 90                  ; checked uppercase upper
        call exact_primitive_identity_pc
        imm r20, 51
        imm r21, 20
        imm r22, 3
        imm r23, 8                   ; <
        call exact_primitive_identity_pc
        imm r20, 52
        imm r21, 20
        imm r22, 1
        imm r23, 97                  ; checked lowercase lower
        call exact_primitive_identity_pc
        imm r20, 53
        imm r21, 21
        imm r22, 3
        imm r23, 12                  ; checked lowercase <=
        call exact_primitive_identity_pc
        imm r20, 54
        imm r21, 21
        imm r22, 1
        imm r23, 122                 ; checked lowercase upper
        call exact_primitive_identity_pc
        imm r20, 55
        imm r21, 21
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 56
        imm r21, 22
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 57
        imm r21, 23
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc

        imm r20, 58
        imm r21, 25
        imm r22, 3
        imm r23, 10                  ; alpha result == 1
        call exact_primitive_identity_pc
        imm r20, 59
        imm r21, 25
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 60
        imm r21, 26
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        ret

classifier_require_pushes:
        ; Binary-left pushes for every comparison.
        imm r20, 8
        imm r21, 13
        call exact_require_binary_push_identity
        imm r20, 9
        imm r21, 14
        call exact_require_binary_push_identity
        imm r20, 10
        imm r21, 17
        call exact_require_binary_push_identity
        imm r20, 11
        imm r21, 18
        call exact_require_binary_push_identity
        imm r20, 12
        imm r21, 19
        call exact_require_binary_push_identity
        imm r20, 13
        imm r21, 20
        call exact_require_binary_push_identity
        imm r20, 14
        imm r21, 21
        call exact_require_binary_push_identity
        imm r20, 15
        imm r21, 25
        call exact_require_binary_push_identity

        ; Same c parameter staged into both nested calls.
        imm r20, 238
        imm r21, 25
        call exact_require_argument_push_identity
        imm r20, 239
        imm r21, 25
        call exact_require_argument_push_identity
        ret

classifier_require_censuses:
        imm r20, 12
        imm r21, 15
        imm r22, 17
        imm r23, 19
        imm r24, 0
        imm r25, 0
        imm r26, 5
        imm r27, 8
        imm r28, 10
        imm r29, 12
        call exact_require_effect_census
        imm r20, 16
        imm r21, 23
        imm r22, 19
        imm r23, 24
        imm r24, 0
        imm r25, 0
        imm r26, 8
        imm r27, 17
        imm r28, 12
        imm r29, 15
        call exact_require_effect_census
        imm r20, 24
        imm r21, 26
        imm r22, 24
        imm r23, 26
        imm r24, 0
        imm r25, 0
        imm r26, 17
        imm r27, 18
        imm r28, 15
        imm r29, 19                  ; checked exclusive classifier event row
        call exact_require_effect_census

        imm r20, 12
        imm r21, 26
        imm r22, 39
        imm r23, 61                  ; checked exclusive classifier primitive row
        imm r24, 8
        imm r25, 16
        imm r26, 238
        imm r27, 240
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census

        imm r20, 6
        call exact_proc_entry_r20
        imm r21, 7
        call exact_proc_entry_r21
        imm r22, 0
        imm r23, 3
        call skip_scan_call_region
        imm r20, 7
        call exact_proc_entry_r20
        imm r21, 8
        call exact_proc_entry_r21
        imm r22, 0
        imm r23, 4
        call skip_scan_call_region
        imm r20, 8
        call exact_proc_entry_r20
        imm r21, 9
        call exact_proc_entry_r21
        imm r22, 2
        imm r23, 3
        call skip_scan_call_region
        ret
