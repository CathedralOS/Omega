; Exact source/artifact shape for parse_number() procedure33.
;
; This module owns the three blocks, digit-loop split, two cbyte calls,
; is_digit/adv calls, explicit/synthetic returns, one local slot, exact
; wrapping arithmetic lowering, stack pushes, and exhaustive decoded/table
; censuses. The adjacent meaning module owns the digit-slice induction.

parse_number_require_shape:
        imm r20, 33
        imm r21, 0                    ; no parameters
        imm r22, 1                    ; local v
        imm r23, 16
        call exact_require_proc_frame_identity

parse_number_shape_blocks:
        imm r20, 167
        imm r21, 33
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 168
        imm r21, 33
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 169
        imm r21, 33
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 167
        imm r21, 169
        imm r22, 33
        call exact_require_proc_blocks
        call parse_number_require_transitions
        call parse_number_require_events
        call parse_number_require_locals
        call parse_number_require_primitives
        call parse_number_require_pushes
        call parse_number_require_censuses
        ret

parse_number_require_transitions:
        imm r20, 126
        imm r21, 168
        imm r22, 1
        imm r23, 169
        call exact_transition_identity_pc ; checked digit-true guard
        imm r20, 127
        imm r21, 169
        imm r22, 0
        imm r23, 168
        call exact_transition_identity_pc ; checked body backedge
        ret

parse_number_require_events:
        ; Source nesting records is_digit before its cbyte argument.
        imm r20, 33
        imm r21, 168
        imm r22, 0
        imm r23, 0
        imm r24, 4                  ; cbyte procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 33
        imm r21, 168
        imm r22, 1
        imm r23, 0
        imm r24, 6                  ; is_digit procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 33
        imm r21, 168
        call exact_require_event_epilogue ; explicit return v
        imm r20, 33
        imm r21, 169
        imm r22, 0
        imm r23, 1                  ; outer addition left is live
        imm r24, 4                  ; cbyte procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 33
        imm r21, 169
        imm r22, 0
        imm r23, 0
        imm r24, 5                  ; adv procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 34                 ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

parse_number_require_locals:
        imm r20, 66
        imm r21, 167
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc ; v=0
        imm r20, 67
        imm r21, 168
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc ; returned v
        imm r20, 68
        imm r21, 169
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc ; updated v
        imm r20, 69
        imm r21, 169
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc ; prior v
        ret

parse_number_require_primitives:
        imm r20, 424
        imm r21, 167
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc ; initial v
        imm r20, 425
        imm r21, 168
        imm r22, 3
        imm r23, 10                 ; is_digit result == 1
        call exact_primitive_identity_pc
        imm r20, 426
        imm r21, 168
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 427
        imm r21, 169
        imm r22, 2
        imm r23, 5                  ; wrapping v*10
        call exact_primitive_identity_pc
        imm r20, 428
        imm r21, 169
        imm r22, 1
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 429
        imm r21, 169
        imm r22, 2
        imm r23, 3                  ; wrapping addition
        call exact_primitive_identity_pc
        imm r20, 430
        imm r21, 169
        imm r22, 2
        imm r23, 4                  ; byte-'0'
        call exact_primitive_identity_pc
        imm r20, 431
        imm r21, 169
        imm r22, 1
        imm r23, 48
        call exact_primitive_identity_pc
        ret

parse_number_require_pushes:
        imm r20, 108
        imm r21, 168
        call exact_require_binary_push_identity ; classifier result
        imm r20, 109
        imm r21, 169
        call exact_require_binary_push_identity ; prior v
        imm r20, 110
        imm r21, 169
        call exact_require_binary_push_identity ; second cbyte result
        imm r20, 111
        imm r21, 169
        call exact_require_binary_push_identity ; wrapped product
        imm r20, 314
        imm r21, 168
        call exact_require_argument_push_identity ; cbyte-to-is_digit argument
        ret

parse_number_require_censuses:
        imm r20, 167
        imm r21, 169
        imm r22, 66
        imm r23, 70                  ; exclusive local row
        imm r24, 37
        imm r25, 37                  ; no raw-memory rows
        imm r26, 126
        imm r27, 128                 ; exclusive transition row
        imm r28, 268
        imm r29, 273                 ; exclusive event row
        call exact_require_effect_census
        imm r20, 167
        imm r21, 169
        imm r22, 424
        imm r23, 432                 ; exclusive primitive row
        imm r24, 108
        imm r25, 112                 ; exclusive binary-push row
        imm r26, 314
        imm r27, 315                 ; exclusive argument-push row
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census
        imm r20, 33                  ; parse_number procedure identity
        call exact_proc_entry_r20
        imm r21, 34                  ; declare procedure identity / region end
        call exact_proc_entry_r21
        imm r22, 4                   ; cbyte/is_digit/cbyte/adv
        imm r23, 2                   ; parse_number explicit and synthetic return
        imm r24, 8                   ; prologue/local/argument/binary stores
        call exact_quiet_scan_region
        ret
