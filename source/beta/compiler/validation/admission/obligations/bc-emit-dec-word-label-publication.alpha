; Checker-E continuation publication for the independently rebuilt full-Word
; emit_dec theorem.  This is intentionally separate from Checker D's terminal
; publication so no process-private DECW cell is imported across checkers.

emit_dec_word_publication_init:
        imm r20, 534800
        imm r21, 1163022164             ; EROOT
        call exact_require_cell
        call emit_dec_word_require_stack_root
        call emit_dec_require_shape
        call emit_dec_word_publish_relation
        imm r20, 532560
        imm r21, 1464026436
        call exact_require_cell
        jmp cursor_tail_summary_init
