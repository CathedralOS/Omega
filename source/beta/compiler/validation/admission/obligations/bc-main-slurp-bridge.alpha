; Lower-rooted prelude/main/slurp composition for exact bc.
;
; The preceding slurp phase proves a cursor-zero procedure summary for both
; finite-input partitions.  This phase establishes that its entry premises are
; the actual program-root premises, then carries the selected return value
; through main's exact local slot and `storage_ok == 1` lowering:
;
;   prelude call main -> main call slurp -> local slot zero -> equality
;     result one  -> main.ready at PC 51226
;     result zero -> main return 253 -> prelude halt r0 at PC 29
;
; The root prefix contains no input/output effect.  The selected main suffix
; contains no input/output effect, ordinary call, division, or remainder.  The
; earlier frame/potential phases supply absolute stack and hidden-return safety;
; the slurp summary supplies termination, source-segment, cursor, reset, and
; empty-output facts.  Thus the success cutpoint inherits the complete slurp
; footprint, while source oversize has exact concrete projection Halt(253)
; with an empty trace.  The separate resource-classification checker combines
; this exact guard with B_bc1 to supply
; Exhaust(SourceBytes,1048576,1048577); it does not invert status253.
;
; Fresh relational cells:
;   current provenance/payload       525648/525656
;   local valid/provenance/payload   525664/525672/525680
;   stack valid/provenance/payload   525688/525696/525704
;   root cursor/output               525712/525720
;   outcome kind/payload             525728/525736
;   imported slurp clauses           525744/525752 (published by prior phase)
;   published ready/halt clauses      526440/526448 (consumed by later root phase)
;
; Provenance kinds: 1=slurp result, 2=storage_ok load, 3=literal one,
; 4=equality result, 5=literal 253. Outcome kinds: 1=ready, 2=halt.

main_slurp_bridge_init:
        imm r1, 526440
        imm r2, 0
        store r1, r2
        imm r1, 526448
        store r1, r2
        call main_slurp_require_shape
        call main_slurp_require_root_prefix
        call main_slurp_require_entry_frame
        call main_slurp_require_quiet_suffix
        call main_slurp_prove_success
        imm r1, 526440
        imm r2, 1                    ; publish main.ready success clause
        store r1, r2
        call main_slurp_prove_oversize
        imm r1, 526448
        imm r2, 2                    ; publish concrete halt(253) clause
        store r1, r2
        jmp write_str_summary_init

; ---- Exact source/artifact joins ---------------------------------------

main_slurp_require_shape:
        ; slurp is procedure zero (arity zero, two slots); main is procedure
        ; 69 (arity zero, one slot).  These cells were independently parsed
        ; from the exact source and their prologues were already checked.
        imm r20, 7151616
        imm r21, 0
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 0
        imm r22, 2
        call transfer_require_cell
        imm r20, 7151616
        imm r21, 69
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 69
        imm r22, 1
        call transfer_require_cell

        ; Exact main entry/storage/ready blocks and source ownership.
        imm r20, 349
        imm r21, 69
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 350
        imm r21, 69
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 351
        imm r21, 69
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 3145728
        imm r21, 349
        imm r22, 69
        call transfer_require_cell
        imm r20, 3178496
        imm r21, 349
        imm r22, 0
        call transfer_require_cell
        imm r20, 3145728
        imm r21, 350
        imm r22, 69
        call transfer_require_cell
        imm r20, 3178496
        imm r21, 350
        imm r22, 1
        call transfer_require_cell
        imm r20, 3145728
        imm r21, 351
        imm r22, 69
        call transfer_require_cell
        imm r20, 3178496
        imm r21, 351
        imm r22, 1
        call transfer_require_cell

        ; main's slurp call and failure return.
        imm r20, 69                   ; main owning procedure identity
        imm r21, 349
        imm r22, 0
        imm r23, 0
        imm r24, 0                    ; slurp procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 69
        imm r21, 350
        call exact_require_event_epilogue
        imm r20, 7143424
        imm r21, 603
        imm r22, 0
        call transfer_require_cell
        imm r20, 10035200
        imm r21, 603
        imm r22, 0
        call transfer_require_cell

        ; The returned r0 is stored to and reloaded from storage_ok slot zero.
        imm r20, 240
        imm r21, 349
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 241
        imm r21, 350
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc

        ; Exact left staging, literal one, equality macro, and failure value.
        imm r20, 232
        imm r21, 350
        call exact_require_binary_push_identity
        imm r20, 806
        imm r21, 350
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 807
        imm r21, 350
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 808
        imm r21, 350
        imm r22, 1
        imm r23, 253
        call exact_primitive_identity_pc

        ; The guarded source edge is represented by jz-to-failure followed by
        ; the true jump to ready.  Rejoin both the source edge and exact bytes.
        imm r20, 286
        imm r21, 350
        imm r22, 1
        imm r23, 351
        call exact_transition_identity_pc
        imm r20, 51177
        imm r21, 13                    ; jz
        call require_tape_byte
        imm r20, 51178
        imm r21, 0                     ; equality result r0
        call require_tape_byte
        imm r20, 51179
        imm r21, 51196                 ; false continuation
        call require_tape_word
        imm r20, 51187
        imm r21, 12                    ; jmp
        call require_tape_byte
        imm r20, 51188
        imm r21, 51226                 ; main.ready
        call require_tape_word

        ; The selected failure epilogue ends at its exact source return.
        imm r20, 69
        imm r21, 350
        call exact_require_event_epilogue
        ret

; The exact root is two stack immediates, call main, then halt r0.  main's
; straight-line prologue reaches the exact slurp call without an input/output
; effect.  The helper bytes at [31,83) are not on this dynamic prefix.
main_slurp_require_root_prefix:
        call stack_lift_require_prelude
        imm r20, 69                   ; canonical root call to main
        call exact_require_program_prelude
        imm r20, 69
        imm r21, 349
        imm r22, 0
        imm r23, 0
        imm r24, 0                    ; slurp procedure identity
        call summary_require_call_fallthrough_identity

        imm r10, 51013
        imm r11, 0
main_slurp_prefix_loop:
        imm r1, 51045
        jlt r10, r1, main_slurp_prefix_pc
        imm r1, 6
        jeq r11, r1, main_slurp_root_relation
        jmp reject
main_slurp_prefix_pc:
        imm r1, 4194304
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, main_slurp_prefix_start
        jmp main_slurp_prefix_next
main_slurp_prefix_start:
        imm r1, 1
        add r11, r1
        imm r1, 2097152
        add r1, r10
        loadb r2, r1
        imm r3, 0                     ; halt
        jeq r2, r3, reject
        imm r3, 6                     ; div
        jeq r2, r3, reject
        imm r3, 7                     ; mod
        jeq r2, r3, reject
        imm r3, 12                    ; jmp
        jeq r2, r3, reject
        imm r3, 13                    ; jz
        jeq r2, r3, reject
        imm r3, 14                    ; jnz
        jeq r2, r3, reject
        imm r3, 15                    ; jlt
        jeq r2, r3, reject
        imm r3, 16                    ; jeq
        jeq r2, r3, reject
        imm r3, 17                    ; read
        jeq r2, r3, reject
        imm r3, 18                    ; write
        jeq r2, r3, reject
        imm r3, 19                    ; call
        jeq r2, r3, reject
        imm r3, 20                    ; ret
        jeq r2, r3, reject
main_slurp_prefix_next:
        imm r1, 1
        add r10, r1
        jmp main_slurp_prefix_loop

main_slurp_root_relation:
        ; Canonical Beta and Alpha executions both begin at input cursor zero
        ; with epsilon output.  The exact dynamic prefix above preserves both.
        imm r1, 525712
        imm r2, 0
        store r1, r2
        imm r1, 525720
        store r1, r2
        ret

; Instantiate the already checked frame equations at the exact root.  main's
; 16-byte frame leaves S=1048560,F=1048568 at the zero-ambient slurp call;
; slurp's own checked frame demand is 24 bytes.
main_slurp_require_entry_frame:
        imm r20, 69
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, main_slurp_frame_slurp
        jmp reject
main_slurp_frame_slurp:
        imm r20, 0
        call call_bounds_frame_bytes
        imm r1, 24
        jeq r0, r1, main_slurp_frame_numbers
        jmp reject
main_slurp_frame_numbers:
        imm r2, 1048576
        imm r3, 8
        sub r2, r3
        imm r4, 1048568
        jeq r2, r4, main_slurp_frame_local
        jmp reject
main_slurp_frame_local:
        imm r3, 8
        sub r2, r3
        imm r4, 1048560
        jeq r2, r4, main_slurp_frame_safe
        jmp reject
main_slurp_frame_safe:
        imm r3, 24
        sub r2, r3
        imm r4, 524288
        jlt r2, r4, reject
        ret

; Every decoded start in the selected post-slurp main region is free of input,
; output, nested calls, halt, division, and remainder.  There is exactly one
; ret, the already checked failure return.  Local stack accesses and that ret
; inherit absolute safety from the frame/potential theorem.
main_slurp_require_quiet_suffix:
        imm r10, 51054
        imm r11, 0                    ; ret count
main_slurp_suffix_loop:
        imm r1, 51226
        jlt r10, r1, main_slurp_suffix_pc
        imm r1, 1
        jeq r11, r1, main_slurp_suffix_done
        jmp reject
main_slurp_suffix_pc:
        imm r1, 4194304
        add r1, r10
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, main_slurp_suffix_start
        jmp main_slurp_suffix_next
main_slurp_suffix_start:
        imm r1, 2097152
        add r1, r10
        loadb r2, r1
        imm r3, 0                     ; halt
        jeq r2, r3, reject
        imm r3, 6                     ; div
        jeq r2, r3, reject
        imm r3, 7                     ; mod
        jeq r2, r3, reject
        imm r3, 17                    ; read
        jeq r2, r3, reject
        imm r3, 18                    ; write
        jeq r2, r3, reject
        imm r3, 19                    ; call
        jeq r2, r3, reject
        imm r3, 20                    ; ret
        jeq r2, r3, main_slurp_suffix_ret
        jmp main_slurp_suffix_next
main_slurp_suffix_ret:
        imm r1, 1
        add r11, r1
main_slurp_suffix_next:
        imm r1, 1
        add r10, r1
        jmp main_slurp_suffix_loop
main_slurp_suffix_done:
        call main_slurp_require_empty_output
        imm r1, 525712
        load r2, r1
        imm r3, 0
        jeq r2, r3, main_slurp_suffix_cursor_zero
        jmp reject
main_slurp_suffix_cursor_zero:
        ; This is still the pre-slurp root relation.  The procedure summary,
        ; not this suffix scan, determines the final cursor partition.
        ret

; ---- Selected value and control flow ----------------------------------

main_slurp_prove_success:
        call main_slurp_reset_case
        call main_slurp_import_success
        call main_slurp_value_store_local
        call main_slurp_value_load_local             ; checked returned-r0 flow
        call main_slurp_value_push
        call main_slurp_value_one
        call main_slurp_value_equal_one
        call main_slurp_take_ready
        imm r20, 1
        imm r21, 1
        call main_slurp_require_outcome
        call main_slurp_require_success_clause
        call main_slurp_require_empty_output
        ret

main_slurp_prove_oversize:
        call main_slurp_reset_case
        call main_slurp_import_oversize
        call main_slurp_value_store_local
        call main_slurp_value_load_local             ; checked returned-r0 flow
        call main_slurp_value_push
        call main_slurp_value_one
        call main_slurp_value_equal_one
        call main_slurp_take_failure
        imm r20, 253                  ; checked concrete failure value
        call main_slurp_value_status
        call main_slurp_return_halt
        imm r20, 2
        imm r21, 253
        call main_slurp_require_outcome
        call main_slurp_require_oversize_clause
        call main_slurp_require_empty_output
        ret

main_slurp_reset_case:
        imm r1, 525648
        imm r2, 0
        store r1, r2
        imm r1, 525656
        store r1, r2
        imm r1, 525664
        store r1, r2
        imm r1, 525672
        store r1, r2
        imm r1, 525680
        store r1, r2
        imm r1, 525688
        store r1, r2
        imm r1, 525696
        store r1, r2
        imm r1, 525704
        store r1, r2
        imm r1, 525728
        store r1, r2
        imm r1, 525736
        store r1, r2
        call main_slurp_require_empty_output
        ret

; Import the successful theorem clause published only after the preceding
; induction rechecked len=cursor=segment=N over 0<=N<=CAP, all seven done
; stores, result one, and epsilon output.
main_slurp_import_success:
        call main_slurp_require_success_clause
        imm r20, 1
        imm r21, 1
        jmp main_slurp_value_set

; Import the separately keyed oversized theorem clause: len>CAP, cursor CAP+1,
; prefix CAP, no done resets, result zero, and epsilon output.
main_slurp_import_oversize:
        call main_slurp_require_oversize_clause
        imm r20, 1
        imm r21, 0
        jmp main_slurp_value_set

main_slurp_require_success_clause:
        imm r1, 525744                ; import success clause
        load r2, r1
        imm r3, 1
        jeq r2, r3, main_slurp_require_ok
        jmp reject

main_slurp_require_oversize_clause:
        imm r1, 525752                ; import oversize clause
        load r2, r1
        imm r3, 2
        jeq r2, r3, main_slurp_require_ok
        jmp reject

; Exact continuation store row240 consumes returned r0 and creates the local
; token.  No other provenance can be silently assigned to storage_ok.
main_slurp_value_store_local:
        imm r1, 525648
        load r2, r1
        imm r3, 1
        jeq r2, r3, main_slurp_store_payload
        jmp reject
main_slurp_store_payload:
        imm r1, 525656
        load r2, r1
        imm r1, 525664
        imm r3, 1
        store r1, r3
        imm r1, 525672
        store r1, r3
        imm r1, 525680
        store r1, r2
        ret

; Exact load row241 recovers only the token stored by row240.
main_slurp_value_load_local:
        imm r1, 525664
        load r2, r1
        imm r3, 1
        jeq r2, r3, main_slurp_load_origin
        jmp reject
main_slurp_load_origin:
        imm r1, 525672
        load r2, r1
        jeq r2, r3, main_slurp_load_payload
        jmp reject
main_slurp_load_payload:
        imm r1, 525680
        load r21, r1
        imm r20, 2
        jmp main_slurp_value_set

; Exact push row232 stages the loaded left operand.
main_slurp_value_push:
        imm r1, 525648
        load r2, r1
        imm r3, 2
        jeq r2, r3, main_slurp_push_empty
        jmp reject
main_slurp_push_empty:
        imm r1, 525688
        load r2, r1
        imm r3, 0
        jeq r2, r3, main_slurp_push_value
        jmp reject
main_slurp_push_value:
        imm r1, 525656
        load r2, r1
        imm r1, 525688
        imm r3, 1
        store r1, r3
        imm r1, 525696
        imm r3, 2
        store r1, r3
        imm r1, 525704
        store r1, r2
        ret

; Literal primitive807.
main_slurp_value_one:
        imm r20, 3
        imm r21, 1
        jmp main_slurp_value_set

; Equality primitive806 consumes exactly the staged storage_ok and literal one.
main_slurp_value_equal_one:
        imm r1, 525648
        load r2, r1
        imm r3, 3
        jeq r2, r3, main_slurp_equal_right
        jmp reject
main_slurp_equal_right:
        imm r1, 525656
        load r2, r1
        imm r3, 1
        jeq r2, r3, main_slurp_equal_stack
        jmp reject
main_slurp_equal_stack:
        imm r1, 525688
        load r2, r1
        imm r3, 1
        jeq r2, r3, main_slurp_equal_origin
        jmp reject
main_slurp_equal_origin:
        imm r1, 525696
        load r2, r1
        imm r3, 2
        jeq r2, r3, main_slurp_equal_payload
        jmp reject
main_slurp_equal_payload:
        imm r1, 525704
        load r2, r1
        imm r1, 525688
        imm r3, 0
        store r1, r3
        imm r3, 0
        jeq r2, r3, main_slurp_equal_false
        imm r3, 1
        jeq r2, r3, main_slurp_equal_true
        jmp reject
main_slurp_equal_false:
        imm r20, 4
        imm r21, 0                    ; checked zero != one result
        jmp main_slurp_value_set
main_slurp_equal_true:
        imm r20, 4
        imm r21, 1
        jmp main_slurp_value_set

; Exact guarded transition286: nonzero equality result takes the following
; jump to ready, while zero falls through to literal253.
main_slurp_take_ready:
        imm r1, 525648
        load r2, r1
        imm r3, 4
        jeq r2, r3, main_slurp_ready_payload
        jmp reject
main_slurp_ready_payload:
        imm r1, 525656
        load r2, r1
        imm r3, 1
        jeq r2, r3, main_slurp_ready_set
        jmp reject
main_slurp_ready_set:
        imm r1, 525728
        imm r2, 1
        store r1, r2
        imm r1, 525736
        store r1, r2
        ret

main_slurp_take_failure:
        imm r1, 525648
        load r2, r1
        imm r3, 4
        jeq r2, r3, main_slurp_failure_payload
        jmp reject
main_slurp_failure_payload:
        imm r1, 525656
        load r2, r1
        imm r3, 0
        jeq r2, r3, main_slurp_require_ok
        jmp reject

; Literal primitive808.  Requiring the selected payload here prevents a proof
; script from relabeling another resource code as source oversize.
main_slurp_value_status:
        imm r1, 253
        jeq r20, r1, main_slurp_status_set
        jmp reject
main_slurp_status_set:
        imm r20, 5
        imm r21, 253
        jmp main_slurp_value_set

; The exact main epilogue preserves r0=253, returns to prelude PC29, and the
; canonical halt observes its low 32 bits.  Since 253 is also in [0,255], both
; the canonical observation and its Unix process projection remain exactly 253.
main_slurp_return_halt:
        imm r1, 525648
        load r2, r1
        imm r3, 5
        jeq r2, r3, main_slurp_halt_payload
        jmp reject
main_slurp_halt_payload:
        imm r1, 525656
        load r2, r1
        imm r3, 253
        jeq r2, r3, main_slurp_halt_range
        jmp reject
main_slurp_halt_range:
        imm r1, 0
        jlt r3, r1, reject
        imm r1, 256
        jlt r3, r1, main_slurp_halt_set
        jmp reject
main_slurp_halt_set:
        imm r1, 525728
        imm r2, 2
        store r1, r2
        imm r1, 525736
        store r1, r3
        ret

; Store current provenance/payload r20/r21.
main_slurp_value_set:
        imm r1, 525648
        store r1, r20
        imm r1, 525656
        store r1, r21
        ret

; Require outcome kind/payload r20/r21.
main_slurp_require_outcome:
        imm r1, 525728
        load r2, r1
        jeq r2, r20, main_slurp_outcome_payload
        jmp reject
main_slurp_outcome_payload:
        imm r1, 525736
        load r2, r1
        jeq r2, r21, main_slurp_require_ok
        jmp reject

main_slurp_require_empty_output:
        imm r1, 525720
        load r2, r1
        imm r3, 0
        jeq r2, r3, main_slurp_require_ok
        jmp reject
main_slurp_require_ok:
        ret
