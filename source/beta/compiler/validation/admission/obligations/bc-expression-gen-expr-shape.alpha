; Exact source/artifact shape for gen_expr (procedure61).

expression_gen_expr_require_shape:
        call expression_gen_expr_require_proc_meta
        call expression_gen_expr_require_blocks
        call expression_gen_expr_require_transitions
        call expression_gen_expr_require_events
        call expression_gen_expr_require_data
        call expression_gen_expr_require_censuses
        call expression_gen_expr_require_region
        ret

expression_gen_expr_require_proc_meta:
        imm r20, 7151616
        imm r21, 61                    ; exact gen_expr procedure id
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 61
        imm r22, 2                    ; depth snapshot and comparison-code slots
        call transfer_require_cell
        imm r20, 61
        call call_bounds_frame_bytes
        imm r1, 24
        jeq r0, r1, exact_shape_ok
        jmp reject

expression_gen_expr_require_blocks:
        imm r20, 303
        imm r21, 61                    ; gen_expr procedure identity
        imm r22, 0                     ; procedure entry
        call exact_block_identity_pc
        imm r20, 304
        imm r21, 61
        imm r22, 1                     ; state block
        call exact_block_identity_pc
        imm r20, 305
        imm r21, 61
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 306
        imm r21, 61
        imm r22, 1
        call exact_block_identity_pc
