        imm r21, 61
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 303
        imm r21, 307
        imm r22, 61
        call exact_require_proc_blocks
        ret

expression_gen_expr_require_transitions:
        imm r20, 249
        imm r21, 304
        imm r22, 1
        imm r23, 305
        call exact_transition_identity_pc
        imm r20, 250
        imm r21, 305
        imm r22, 0
        imm r23, 306
        call exact_transition_identity_pc
        imm r20, 251
        imm r21, 306
        imm r22, 1
        imm r23, 307
        call exact_transition_identity_pc
        ret

; r21=source block, r22=arity, r23=target procedure identity. The event
; owner reconstructs the unique call PC, target entry, and fallthrough.
expression_gen_expr_require_call:
        mov r24, r23
        imm r23, 0
        imm r20, 61                    ; gen_expr owning procedure identity
        call summary_require_call_fallthrough_identity
        ret

; r21=source block. The event owner reconstructs the unique source return and
; validates its canonical epilogue.
expression_gen_expr_require_return:
        imm r20, 61                    ; gen_expr owning procedure identity
        call exact_require_event_epilogue
        ret

expression_gen_expr_require_events:
        imm r21, 304
        call expression_gen_expr_require_return
        imm r21, 306
        imm r22, 0
        imm r23, 58                    ; gen_sum procedure identity
        call expression_gen_expr_require_call
        imm r21, 306
        imm r22, 0
        imm r23, 10                    ; skip_ws procedure identity
        call expression_gen_expr_require_call
        imm r21, 306
        imm r22, 0
        imm r23, 59                    ; cmp_op procedure identity
        call expression_gen_expr_require_call
        imm r21, 306
        call expression_gen_expr_require_return
        imm r21, 307
        imm r22, 0
        imm r23, 47                    ; emit_push procedure identity
        call expression_gen_expr_require_call
        imm r21, 307
        imm r22, 0
        imm r23, 58                    ; gen_sum procedure identity
        call expression_gen_expr_require_call
        imm r21, 307
        imm r22, 1
        imm r23, 60                    ; emit_cmp procedure identity
        call expression_gen_expr_require_call
        imm r21, 307
        call expression_gen_expr_require_return
        imm r20, 62                    ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

