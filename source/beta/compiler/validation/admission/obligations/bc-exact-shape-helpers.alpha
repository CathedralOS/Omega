        mov r20, r25
        imm r1, 1
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 2
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 3
        add r20, r1
        imm r21, 10
        call require_tape_byte
        mov r20, r25
        imm r1, 4
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 5
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 6
        add r20, r1
        imm r21, 3
        call require_tape_byte
        mov r20, r25
        imm r1, 7
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 8
        add r20, r1
        imm r21, 13
        call require_tape_byte
        mov r20, r25
        imm r1, 9
        add r20, r1
        imm r21, 20
        call require_tape_byte
        mov r5, r26
        imm r6, 1
        add r5, r6
        mov r0, r25
        mov r1, r25
        imm r6, 3
        add r1, r6
        mov r2, r25
        imm r6, 6
        add r2, r6
        mov r3, r25
        imm r6, 6
        add r3, r6
        mov r4, r26
        ret

; Bind exact local/memory/transition/event intervals for blocks [r20,r21] to
; the canonical boundary-prefix index. Preserve the historical r20..r29 ABI.
exact_require_effect_census:
        call exact_effect_census_prefix_matches
        imm r1, 1
        jeq r0, r1, exact_shape_ok
        jmp reject

; Boolean form used both by the rejecting adapter and the owner's four private
; mutation teeth. It consumes no semantic row content.
exact_effect_census_prefix_matches:
        mov r34, r22
        mov r35, r23
        mov r36, r24
        mov r37, r25
        mov r38, r26
        mov r39, r27
        mov r42, r28
        mov r43, r29
        imm r1, 0
        jlt r20, r1, exact_effect_census_prefix_no
        jlt r21, r20, exact_effect_census_prefix_no
        imm r1, 359
        jlt r21, r1, exact_effect_census_prefix_offsets
        jmp exact_effect_census_prefix_no
exact_effect_census_prefix_offsets:
        mov r30, r20
        imm r1, 8
        mul r30, r1
        mov r31, r21
        imm r1, 1
        add r31, r1
        imm r1, 8
        mul r31, r1
        mov r32, r34
        mov r33, r35
        imm r1, 17055744
        call exact_effect_census_prefix_pair
        imm r1, 1
        jeq r0, r1, exact_effect_census_prefix_memory
        ret
exact_effect_census_prefix_memory:
        mov r32, r36
        mov r33, r37
        imm r1, 17059840
        call exact_effect_census_prefix_pair
        imm r1, 1
        jeq r0, r1, exact_effect_census_prefix_transition
        ret
exact_effect_census_prefix_transition:
        mov r32, r38
        mov r33, r39
        imm r1, 17063936
        call exact_effect_census_prefix_pair
        imm r1, 1
        jeq r0, r1, exact_effect_census_prefix_event
        ret
exact_effect_census_prefix_event:
        mov r32, r42
        mov r33, r43
        imm r1, 17068032
        call exact_effect_census_prefix_pair
        ret

; Array base in r1, byte offsets in r30/r31, expected pair in r32/r33.
; Preserve the established empty-family convention: when the canonical prefix
; endpoints are equal, any caller-supplied empty half-open interval is valid.
exact_effect_census_prefix_pair:
        mov r2, r1
        add r2, r30
        load r2, r2                  ; canonical start
        add r1, r31
        load r3, r1                  ; canonical end
        jeq r2, r32, exact_effect_census_prefix_pair_start
        jmp exact_effect_census_prefix_pair_empty
exact_effect_census_prefix_pair_start:
        jeq r3, r33, exact_effect_census_prefix_yes
exact_effect_census_prefix_pair_empty:
        jeq r2, r3, exact_effect_census_prefix_expected_empty
        jmp exact_effect_census_prefix_no
exact_effect_census_prefix_expected_empty:
        jeq r32, r33, exact_effect_census_prefix_yes
exact_effect_census_prefix_no:
        imm r0, 0
        ret
exact_effect_census_prefix_yes:
        imm r0, 1
        ret

