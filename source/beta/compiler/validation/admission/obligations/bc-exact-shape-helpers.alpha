        imm r1, 8
        mul r12, r1
        mov r1, r31
        add r1, r12
        load r4, r1
        mov r5, r4
        imm r1, 8
        mul r5, r1
        imm r1, 3235840
        add r1, r5
        load r6, r1
        jlt r14, r6, reject
        imm r1, 1
        add r4, r1
        imm r1, 359
        jlt r4, r1, exact_ingest_bounded_site_pc_next_block
        imm r1, 524296
        load r7, r1
        jmp exact_ingest_bounded_site_pc_end_ready
exact_ingest_bounded_site_pc_next_block:
        mov r5, r4
        imm r1, 8
        mul r5, r1
        imm r1, 3235840
        add r1, r5
        load r7, r1
exact_ingest_bounded_site_pc_end_ready:
