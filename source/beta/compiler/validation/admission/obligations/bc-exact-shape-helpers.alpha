; Compatibility entry for regions with no direct output or raw byte access.
; Inputs r20..r24 are start/end/call/ret/store totals.
exact_quiet_scan_region:
        mov r25, r24
        imm r24, 0                   ; no direct writes
        imm r26, 0                   ; reject loadb/storeb
        call exact_effect_scan_region
        ret

; Canonical decoded effect census for [r20,r21). Inputs r22..r25 are exact
; call/ret/write/store totals. r26 is zero to reject raw byte access or one to
; admit it; halt, division, remainder, and input are always rejected. The
; shared instruction-start and opcode tables keep this checker independent of
; responsibility-specific source-shape data.
exact_effect_scan_region:
        mov r27, r20
        mov r28, r21
        mov r29, r22
        mov r30, r23
        mov r31, r24
        mov r32, r25
        mov r33, r26
        imm r10, 0
        imm r11, 0
        imm r12, 0
        imm r13, 0
exact_effect_scan_loop:
        jlt r27, r28, exact_effect_scan_pc
        jeq r10, r29, exact_effect_scan_rets
        jmp reject
exact_effect_scan_rets:
        jeq r11, r30, exact_effect_scan_writes
        jmp reject
exact_effect_scan_writes:
        jeq r12, r31, exact_effect_scan_stores
        jmp reject
exact_effect_scan_stores:
        jeq r13, r32, exact_shape_ok
        jmp reject
exact_effect_scan_pc:
        imm r1, 4194304
        add r1, r27
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, exact_effect_scan_start
        jmp exact_effect_scan_next
exact_effect_scan_start:
        imm r1, 2097152
        add r1, r27
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, exact_effect_scan_call
        imm r3, 20
        jeq r2, r3, exact_effect_scan_ret
        imm r3, 18
        jeq r2, r3, exact_effect_scan_write
        imm r3, 11
        jeq r2, r3, exact_effect_scan_store
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 6
        jeq r2, r3, reject
        imm r3, 7
        jeq r2, r3, reject
        imm r3, 8
        jeq r2, r3, exact_effect_scan_raw
        imm r3, 9
        jeq r2, r3, exact_effect_scan_raw
        imm r3, 17
        jeq r2, r3, reject
        jmp exact_effect_scan_next
exact_effect_scan_raw:
        imm r3, 1
        jeq r33, r3, exact_effect_scan_next
        jmp reject
exact_effect_scan_call:
        imm r1, 1
        add r10, r1
        jmp exact_effect_scan_next
exact_effect_scan_ret:
        imm r1, 1
        add r11, r1
        jmp exact_effect_scan_next
exact_effect_scan_write:
        imm r1, 1
        add r12, r1
        jmp exact_effect_scan_next
exact_effect_scan_store:
        imm r1, 1
        add r13, r1
exact_effect_scan_next:
        imm r1, 1
        add r27, r1
        jmp exact_effect_scan_loop

; Require the call at r20 to target r21 and have exact fallthrough r22.
; This was originally private to the main/slurp bridge, but its contract and
; implementation are responsibility-neutral and are also needed by Checker C.
exact_require_call:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r2, r25
        imm r1, 9
        add r2, r1
        jeq r2, r27, exact_require_call_opcode
        jmp reject
exact_require_call_opcode:
        mov r20, r25
        imm r21, 19
        call require_tape_byte
        mov r20, r25
        imm r1, 1
        add r20, r1
        mov r21, r26
        call require_tape_word
        ret

; Exact event-row argument arity at r20 must equal r21.
exact_require_event_arity:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 7143424
        add r1, r2
        load r2, r1
        jeq r2, r21, exact_shape_ok
        jmp reject

; Exact expression-height table entry for event row r20 must equal r21.
exact_require_ambient_height:
        mov r2, r20
        imm r1, 8
        mul r2, r1
        imm r1, 10035200
        add r1, r2
        load r2, r1
        jeq r2, r21, exact_shape_ok
        jmp reject

; Rejoin one ordinary source call across the event, arity, expression-height,
; and decoded-call tables. Inputs are event/block/pc/arity/ambient/target/
; continuation in r20..r26.
summary_require_call_site:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        mov r36, r26
        mov r20, r30
        mov r21, r31
        imm r22, 1
        mov r23, r32
        call exact_require_event
        mov r20, r30
        mov r21, r33
        call exact_require_event_arity
        mov r20, r30
        mov r21, r34
        call exact_require_ambient_height
        mov r20, r32
        mov r21, r35
        mov r22, r36
        call exact_require_call
        ret

; Rejoin an ordinary source call without accepting artifact coordinates from
; the semantic consumer. Inputs are event row/block/arity/ambient/target-proc
; in r20..r24 and continuation transition row/source/guard/target in r25..r28.
; Event kind one and the target procedure entry are part of this fixed call
; identity; the checked event/transition tables supply call and continuation
; PCs only after all source identities match.
summary_require_call_identity:
        mov r30, r20
        mov r31, r21
        mov r33, r22
        mov r34, r23
        mov r35, r24
        mov r37, r25
        mov r38, r26
        mov r39, r27
        mov r40, r28
        mov r20, r30
        mov r21, r31
        imm r22, 1
        call exact_event_identity_pc
        mov r32, r0
        mov r20, r37
        mov r21, r38
        mov r22, r39
        mov r23, r40
        call exact_transition_identity_pc
        mov r36, r0
        mov r0, r35
        call exact_proc_entry_pc
        mov r35, r0
        mov r20, r30
        mov r21, r31
        mov r22, r32
        mov r23, r33
        mov r24, r34
        mov r25, r35
        mov r26, r36
        call summary_require_call_site
        ret

; Rejoin an ordinary call whose continuation is its canonical nine-byte
; fallthrough rather than a source transition. Inputs are event row/block/
; arity/ambient/target-procedure identity in r20..r24. The checked event table
; supplies the call PC only after source identity matches.
summary_require_call_fallthrough_identity:
        mov r30, r20
        mov r31, r21
        mov r33, r22
        mov r34, r23
        mov r35, r24
        mov r20, r30
        mov r21, r31
        imm r22, 1
        call exact_event_identity_pc
        mov r32, r0
        mov r36, r0
        imm r1, 9
        add r36, r1
        mov r0, r35
        call exact_proc_entry_pc
        mov r35, r0
        mov r20, r30
        mov r21, r31
        mov r22, r32
        mov r23, r33
        mov r24, r34
        mov r25, r35
        mov r26, r36
        call summary_require_call_site
        ret

; Canonical selected-row decoder family. These helpers rejoin values already
; reconstructed into the exact local, memory, primitive, and push tables; they
; do not accept a producer-selected subject or construct another witness.

; Require one checked table cell: base r20, row r21, expected r22.
transfer_require_cell:
        imm r1, 8
        mul r21, r1
        add r20, r21
        load r2, r20
        jeq r2, r22, transfer_require_cell_ok
        jmp reject
transfer_require_cell_ok:
        ret

