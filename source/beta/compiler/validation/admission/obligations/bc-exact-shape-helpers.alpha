        mov r21, r33
        call exact_require_event_arity
        mov r20, r30
        mov r21, r34
        call exact_require_ambient_height
        mov r20, r32
        mov r21, r35
        mov r22, r36
        call exact_require_call
        ret

; Canonical selected-row decoder family. These helpers rejoin values already
; reconstructed into the exact local, memory, primitive, and push tables; they
; do not accept a producer-selected subject or construct another witness.

; Ingest one complete family of untrusted witness PCs without letting the
; witness choose a source row or block. Inputs are the checker-owned exact row
; count, source-block table base, and destination-PC table base in r20..r22.
; Every selected PC must be in the exact tape, begin a decoded instruction,
; and lie inside the independently reconstructed source block interval. The
; exact bc subject has 359 source blocks. Clobbers r0..r7,r10,r12,r14,r30..r32.
