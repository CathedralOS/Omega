; Responsibility-neutral exact shape/table helpers shared by semantic tranches.
; Compiler-generated stack/frame macros are decoded here exactly once; semantic
; consumers pass only their independently reconstructed PC/register/slot facts.
; This file has no initialization edge and publishes no theorem token.

; Exact saved-fp prologue prefix at r20. The root prelude establishes r13=8.
; Preserve the historical five-result interface: r0/r1 both name the sub,
; r2/r3 name store/mov, and r4 is the exclusive successor.
; `sub r15,r13; store r15,r14; mov r14,r15`.
exact_require_prologue:
        mov r25, r20
        mov r20, r25
        imm r21, 4
        call require_tape_byte
        mov r20, r25
        imm r1, 1
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 2
        add r20, r1
        imm r21, 13
        call require_tape_byte
        mov r20, r25
        imm r1, 3
        add r20, r1
        imm r21, 11
        call require_tape_byte
        mov r20, r25
        imm r1, 4
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 5
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 6
        add r20, r1
        imm r21, 2
        call require_tape_byte
        mov r20, r25
        imm r1, 7
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 8
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r0, r25
        mov r1, r25
        mov r2, r25
        imm r4, 3
        add r2, r4
        mov r3, r25
        imm r4, 6
        add r3, r4
        mov r4, r25
        imm r5, 9
        add r4, r5
        ret

; Exact optional frame allocation at r20 for r21 bytes. Return imm/sub starts
; in r0/r1 and exclusive successor in r2:
; `imm r5,frame_bytes; sub r15,r5`.
exact_require_frame_allocation:
        mov r25, r20
        mov r26, r21
        mov r20, r25
        imm r21, 1
        call require_tape_byte
        mov r20, r25
        imm r1, 1
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r25
        imm r1, 2
        add r20, r1
        mov r21, r26
        call require_tape_word
        mov r20, r25
        imm r1, 10
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r25
        imm r1, 11
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 12
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r0, r25
        mov r1, r25
        imm r2, 10
        add r1, r2
        mov r2, r25
        imm r3, 13
        add r2, r3
        ret

; Exact parameter store at r20 for argument register r21. Return mov/imm/sub/
; store starts in r0..r3 and exclusive successor in r4:
; `mov r5,r14; imm r4,8+8*k; sub r5,r4; store r5,rK`.
exact_require_parameter_store:
        mov r25, r20
        mov r26, r21
        mov r20, r25
        imm r21, 2
        call require_tape_byte
        mov r20, r25
        imm r1, 1
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r25
        imm r1, 2
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 3
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r25
        imm r1, 4
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r25
        imm r1, 5
        add r20, r1
        mov r21, r26
        imm r1, 1
        add r21, r1
        imm r1, 8
        mul r21, r1
        call require_tape_word
        mov r20, r25
        imm r1, 13
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r25
        imm r1, 14
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r25
        imm r1, 15
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r25
        imm r1, 16
        add r20, r1
        imm r21, 11
        call require_tape_byte
        mov r20, r25
        imm r1, 17
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r25
        imm r1, 18
        add r20, r1
        mov r21, r26
        call require_tape_byte
        mov r0, r25
        mov r1, r25
        imm r4, 3
        add r1, r4
        mov r2, r25
        imm r4, 13
        add r2, r4
        mov r3, r25
        imm r4, 16
        add r3, r4
        mov r4, r25
        imm r5, 19
        add r4, r5
        ret

; Exact pop at r20 into register r21. Preserve the historical tuple: r0 is the
; load, r1/r2 both name the add, and r3 is the exclusive successor.
; `load rK,r15; add r15,r13`.
exact_require_pop:
        call exact_match_pop
        imm r1, 1
        jeq r0, r1, exact_pop_extent
        jmp reject
exact_pop_extent:
        mov r0, r25
        mov r1, r25
        imm r3, 3
        add r1, r3
        mov r2, r25
        imm r3, 3
        add r2, r3
        mov r3, r25
        imm r4, 6
        add r3, r4
        ret

; Require one pop ending exactly at successor r20, into register r21. Return
; the same instruction-start/successor tuple as exact_require_pop.
exact_require_pop_before:
        mov r30, r20
        mov r31, r21
        imm r1, 6
        jlt r30, r1, reject
        mov r20, r30
        sub r20, r1
        mov r21, r31
        call exact_require_pop
        jeq r3, r30, exact_pop_before_done
        jmp reject
exact_pop_before_done:
        ret

; Require count r21 contiguous pops immediately before successor r20, with
; destinations count-1 down through r0. Return first pop start in r0 and the
; checked common successor in r1. The macro extent is private to this owner.
exact_require_pop_sequence:
        mov r30, r20
        mov r31, r21
        mov r32, r31
        imm r1, 6
        mul r32, r1
        jlt r30, r32, reject
        mov r33, r30
        sub r33, r32                 ; first pop start
        mov r34, r33                 ; cursor
        mov r35, r31
        imm r1, 0
        jeq r35, r1, exact_pop_sequence_done
        imm r1, 1
        sub r35, r1                  ; first destination register
exact_pop_sequence_loop:
        mov r20, r34
        mov r21, r35
        call exact_require_pop
        mov r34, r3
        imm r1, 0
        jeq r35, r1, exact_pop_sequence_done
        imm r1, 1
        sub r35, r1
        jmp exact_pop_sequence_loop
exact_pop_sequence_done:
        jeq r34, r30, exact_pop_sequence_return
        jmp reject
exact_pop_sequence_return:
        mov r0, r33
        mov r1, r30
        ret

; Boolean form used by exhaustive artifact scanners. Inputs match the strict
; adapter above; output r0 is one exactly for the canonical pop macro.
exact_match_pop:
        mov r25, r20
        mov r26, r21
        mov r2, r25
        imm r1, 6
        add r2, r1
        imm r1, 524296
        load r3, r1
        jlt r3, r2, exact_match_pop_none
        mov r20, r25
        imm r21, 10
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_register
        jmp exact_match_pop_none
exact_match_pop_register:
        mov r20, r25
        imm r1, 1
        add r20, r1
        mov r21, r26
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_sp
        jmp exact_match_pop_none
exact_match_pop_sp:
        mov r20, r25
        imm r1, 2
        add r20, r1
        imm r21, 15
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_imm
        jmp exact_match_pop_none
exact_match_pop_imm:
        mov r20, r25
        imm r1, 3
        add r20, r1
        imm r21, 3
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_add_sp
        jmp exact_match_pop_none
exact_match_pop_add_sp:
        mov r20, r25
        imm r1, 4
        add r20, r1
        imm r21, 15
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_add_step
        jmp exact_match_pop_none
exact_match_pop_add_step:
        mov r20, r25
        imm r1, 5
        add r20, r1
        imm r21, 13
        call exact_tape_byte_matches
        ret
exact_match_pop_none:
        imm r0, 0
        ret

; Boolean classifier form with checked exclusive successor in r1 on success.
exact_match_pop_successor:
        call exact_match_pop
        imm r1, 1
        jeq r0, r1, exact_match_pop_successor_found
        ret
exact_match_pop_successor_found:
        mov r1, r25
        imm r2, 6
        add r1, r2
        ret

; Boolean byte/word equality at exact tape pc r20; output r0 is zero/one.
exact_tape_byte_matches:
        imm r1, 2097152
        add r1, r20
        loadb r2, r1
        jeq r2, r21, exact_tape_matches
        imm r0, 0
        ret
exact_tape_word_matches:
        imm r1, 2097152
        add r1, r20
        load r2, r1
        jeq r2, r21, exact_tape_matches
        imm r0, 0
        ret
exact_tape_matches:
        imm r0, 1
        ret

; Input r14 is a decoded start; output r0 is one iff the exact 6-byte push is
; `sub r15,r13; store r15,r0`.
exact_match_push:
        mov r20, r14
        imm r1, 6
        add r20, r1
        imm r1, 524296
        load r2, r1
        jlt r2, r20, exact_match_push_none
        mov r20, r14
        imm r21, 4
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_register
        jmp exact_match_push_none
exact_match_push_register:
        mov r20, r14
        imm r1, 1
        add r20, r1
        imm r21, 15
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_step
        jmp exact_match_push_none
exact_match_push_step:
        mov r20, r14
        imm r1, 2
        add r20, r1
        imm r21, 13
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_store
        jmp exact_match_push_none
exact_match_push_store:
        mov r20, r14
        imm r1, 3
        add r20, r1
        imm r21, 11
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_store_sp
        jmp exact_match_push_none
exact_match_push_store_sp:
        mov r20, r14
        imm r1, 4
        add r20, r1
        imm r21, 15
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_store_value
        jmp exact_match_push_none
exact_match_push_store_value:
        mov r20, r14
        imm r1, 5
        add r20, r1
        imm r21, 0
        call exact_tape_byte_matches
        ret
exact_match_push_none:
        imm r0, 0
        ret

; Strict push extent at r20. Preserve the historical tuple: r0/r1 both name
; the sub, r2 names the store, and r3 is the exclusive successor.
exact_require_push:
        mov r36, r14                 ; boolean scanner's input register
        mov r37, r20
        mov r14, r37
        call exact_match_push
        mov r14, r36
        imm r1, 1
        jeq r0, r1, exact_push_extent
        jmp reject
exact_push_extent:
        mov r0, r37
        mov r1, r37
        mov r2, r37
        imm r3, 3
        add r2, r3
        mov r3, r37
        imm r4, 6
        add r3, r4
        ret

; Bind the exact expression primitive/push intervals for blocks [r20,r21] to
; the canonical boundary-prefix index.  Preserve the historical r20..r29 ABI:
; block bounds, primitive rows, binary rows, argument rows, and store rows.
summary_require_expr_census:
        call exact_expr_census_prefix_matches
        imm r1, 1
        jeq r0, r1, exact_shape_ok
        jmp reject

; Boolean form used both by the rejecting adapter and the owner's four private
; mutation teeth.  It consumes no semantic row content.
exact_expr_census_prefix_matches:
        mov r34, r22
        mov r35, r23
        mov r36, r24
        mov r37, r25
        mov r38, r26
        mov r39, r27
        mov r42, r28
        mov r43, r29
        imm r1, 0
        jlt r20, r1, exact_expr_census_prefix_no
        jlt r21, r20, exact_expr_census_prefix_no
        imm r1, 359
        jlt r21, r1, exact_expr_census_prefix_offsets
        jmp exact_expr_census_prefix_no
exact_expr_census_prefix_offsets:
        mov r30, r20
        imm r1, 8
        mul r30, r1
        mov r31, r21
        imm r1, 1
        add r31, r1
        imm r1, 8
        mul r31, r1
        mov r32, r34
        mov r33, r35
        imm r1, 17039360
        call exact_expr_census_prefix_pair
        imm r1, 1
        jeq r0, r1, exact_expr_census_prefix_binary
        ret
exact_expr_census_prefix_binary:
        mov r32, r36
        mov r33, r37
        imm r1, 17043456
        call exact_expr_census_prefix_pair
        imm r1, 1
        jeq r0, r1, exact_expr_census_prefix_argument
        ret
exact_expr_census_prefix_argument:
        mov r32, r38
        mov r33, r39
        imm r1, 17047552
        call exact_expr_census_prefix_pair
        imm r1, 1
        jeq r0, r1, exact_expr_census_prefix_store
        ret
exact_expr_census_prefix_store:
        mov r32, r42
        mov r33, r43
        imm r1, 17051648
        call exact_expr_census_prefix_pair
        ret

; Array base in r1, byte offsets in r30/r31, expected pair in r32/r33.
; Preserve the established empty-family convention: when the canonical prefix
; endpoints are equal, any caller-supplied empty half-open interval is valid.
exact_expr_census_prefix_pair:
        mov r2, r1
        add r2, r30
        load r2, r2                  ; canonical start
        add r1, r31
        load r3, r1                  ; canonical end
        jeq r2, r32, exact_expr_census_prefix_pair_start
        jmp exact_expr_census_prefix_pair_empty
exact_expr_census_prefix_pair_start:
        jeq r3, r33, exact_expr_census_prefix_yes
exact_expr_census_prefix_pair_empty:
        jeq r2, r3, exact_expr_census_prefix_expected_empty
        jmp exact_expr_census_prefix_no
exact_expr_census_prefix_expected_empty:
        jeq r32, r33, exact_expr_census_prefix_yes
exact_expr_census_prefix_no:
        imm r0, 0
        ret
exact_expr_census_prefix_yes:
        imm r0, 1
        ret

; Block row/PC in r20/r21.
exact_require_block_pc:
        imm r1, 8
        mul r20, r1
        imm r1, 3235840
        add r1, r20
        load r2, r1
        jeq r2, r21, exact_shape_ok
        jmp reject

; Canonical source-row identity to checked artifact-PC resolvers. The caller
; supplies a source-owned row and every non-coordinate identity field; the
; untrusted witness contributes only the PC after the independently rebuilt
; tables agree on that identity. Each resolver rejects an out-of-range row and
; clobbers only r0..r5.

; Block row/procedure/kind in r20..r22; return artifact PC in r0.
exact_block_identity_pc:
        mov r5, r20
        imm r1, 524320                 ; independently scanned block count
        load r1, r1
        jlt r5, r1, exact_block_identity_proc
        jmp reject
exact_block_identity_proc:
        imm r1, 8
        mul r5, r1
        imm r1, 3145728
        add r1, r5
        load r2, r1
        jeq r2, r21, exact_block_identity_kind
        jmp reject
exact_block_identity_kind:
        imm r1, 3178496
        add r1, r5
        load r2, r1
        jeq r2, r22, exact_block_identity_load
        jmp reject
exact_block_identity_load:
        imm r1, 3235840
        add r1, r5
        load r0, r1
        ret

; Resolve independently scanned source procedure ID r0 through the canonical
; procedure-span inventory. The inventory has already required one total,
; ordered partition of the checked block tables. Clobbers only r0..r5.
exact_proc_entry_pc:
        mov r5, r0
        call exact_proc_span_identity_core
        mov r0, r2
        ret

; Destination adapters let semantic consumers replace an absolute entry PC
; with one extra call while leaving their other reconstructed arguments intact.
exact_proc_entry_r20:
        mov r0, r20
        call exact_proc_entry_pc
        mov r20, r0
        ret
exact_proc_entry_r21:
        mov r0, r21
        call exact_proc_entry_pc
        mov r21, r0
        ret
exact_proc_entry_r22:
        mov r0, r22
        call exact_proc_entry_pc
        mov r22, r0
        ret
exact_proc_entry_r23:
        mov r0, r23
        call exact_proc_entry_pc
        mov r23, r0
        ret
exact_proc_entry_r24:
        mov r0, r24
        call exact_proc_entry_pc
        mov r24, r0
        ret
exact_proc_entry_r25:
        mov r0, r25
        call exact_proc_entry_pc
        mov r25, r0
        ret

; Exact generated root prelude for independently reconstructed main procedure
; identity r20. It initializes the closed program's reserved r13 word-size
; constant. Return SP-init/FP-init/call/halt starts in r0..r3 and exclusive
; successor in r4. All layout arithmetic stays with this compiler-macro owner.
exact_require_program_prelude:
        mov r0, r20
        call exact_proc_entry_pc
        mov r30, r0                  ; checked main target
        imm r20, 0
        imm r21, 1
        call require_tape_byte
        imm r20, 1
        imm r21, 15
        call require_tape_byte
        imm r20, 2
        imm r21, 1048576
        call require_tape_word
        imm r20, 10
        imm r21, 1
        call require_tape_byte
        imm r20, 11
        imm r21, 14
        call require_tape_byte
        imm r20, 12
        imm r21, 1048576
        call require_tape_word
        imm r20, 20
        imm r21, 1
        call require_tape_byte
        imm r20, 21
        imm r21, 13
        call require_tape_byte
        imm r20, 22
        imm r21, 8
        call require_tape_word
        imm r20, 30
        mov r21, r30
        imm r22, 39
        call exact_require_call
        imm r20, 39
        imm r21, 0
        call require_tape_byte
        imm r20, 40
        imm r21, 0
        call require_tape_byte
        imm r0, 0
        imm r1, 10
        imm r2, 30
        imm r3, 39
        imm r4, 41
        ret

; Resolve the compiler-synthesized __write_str extent from the checked root
; prelude instead of treating its current artifact coordinates as semantic
; identities. The effect-site owner validates the exact 52-byte body once;
; consumers use this helper only after that initialization edge. Bind the
; mapper's helper cell to the checked prelude successor and return the exact
; instruction starts (entry/branch/load/write/one/add/sub/jump/return) in
; r0..r8 and the exclusive successor in r9. The nested prelude decoder clobbers
; r20..r27; preserve r30/r31 because semantic callers conventionally retain
; their arguments there. This resolver uses r28/r29 only as private saves.
exact_require_write_str_extent:
        mov r28, r30
        mov r29, r31
        imm r20, 69                  ; independently scanned main identity
        call exact_require_program_prelude
        mov r31, r4                  ; checked prelude successor / helper entry
        imm r1, 524512
        load r2, r1
        jeq r2, r31, exact_write_str_extent_bound
        jmp reject
exact_write_str_extent_bound:
        mov r0, r31
        mov r1, r31
        imm r30, 10
        add r1, r30
        mov r2, r31
        imm r30, 21
        add r2, r30
        mov r3, r31
        imm r30, 24
        add r3, r30
        mov r4, r31
        imm r30, 26
        add r4, r30
        mov r5, r31
        imm r30, 36
        add r5, r30
        mov r6, r31
        imm r30, 39
        add r6, r30
        mov r7, r31
        imm r30, 42
        add r7, r30
        mov r8, r31
        imm r30, 51
        add r8, r30
        mov r9, r31
        imm r30, 52
        add r9, r30
        mov r30, r28
        mov r31, r29
        ret

; Transition row/source-block/guarded/target/control-pc in r20..r24.
exact_require_transition:
        mov r25, r20
        imm r1, 8
        mul r25, r1
        imm r1, 3215360
        add r1, r25
        load r2, r1
        jeq r2, r21, exact_transition_guard
        jmp reject
exact_transition_guard:
        imm r1, 3227648
        add r1, r25
        load r2, r1
        jeq r2, r22, exact_transition_target
        jmp reject
exact_transition_target:
        imm r1, 3231744
        add r1, r25
        load r2, r1
        jeq r2, r23, exact_transition_pc
        jmp reject
exact_transition_pc:
        imm r1, 3239936
        add r1, r25
        load r2, r1
        jeq r2, r24, exact_shape_ok
        jmp reject

; Transition row/source-block/guarded/target-block in r20..r23; return the
; checked control-instruction PC in r0.
exact_transition_identity_pc:
        mov r5, r20
        imm r1, 524328                 ; independently scanned transition count
        load r1, r1
        jlt r5, r1, exact_transition_identity_source
        jmp reject
exact_transition_identity_source:
        imm r1, 8
        mul r5, r1
        imm r1, 3215360
        add r1, r5
        load r2, r1
        jeq r2, r21, exact_transition_identity_guard
        jmp reject
exact_transition_identity_guard:
        imm r1, 3227648
        add r1, r5
        load r2, r1
        jeq r2, r22, exact_transition_identity_target
        jmp reject
exact_transition_identity_target:
        imm r1, 3231744
        add r1, r5
        load r2, r1
        jeq r2, r23, exact_transition_identity_load
        jmp reject
exact_transition_identity_load:
        imm r1, 3239936
        add r1, r5
        load r0, r1
        ret

; Event row/block/kind/pc in r20..r23.
exact_require_event:
        mov r25, r20
        imm r1, 8
        mul r25, r1
        imm r1, 7077888
        add r1, r25
        load r2, r1
        jeq r2, r21, exact_event_kind
        jmp reject
exact_event_kind:
        imm r1, 7086080
        add r1, r25
        load r2, r1
        jeq r2, r22, exact_event_pc
        jmp reject
exact_event_pc:
        imm r1, 7135232
        add r1, r25
        load r2, r1
        jeq r2, r23, exact_shape_ok
        jmp reject

; The next source procedure identity in r20 identifies the byte after a
; synthetic return. Reconstruct that return and its epilogue relatively.
exact_require_preentry_epilogue:
        mov r0, r20
        call exact_proc_entry_pc
        mov r20, r0
        imm r1, 1
        sub r20, r1
        call exact_require_epilogue_at_ret
        ret

