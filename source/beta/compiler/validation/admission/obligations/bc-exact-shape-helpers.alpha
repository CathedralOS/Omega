; Responsibility-neutral exact shape/table helpers shared by semantic tranches.
; Compiler-generated stack/frame macros are decoded here exactly once; semantic
; consumers pass only their independently reconstructed PC/register/slot facts.
; This file has no initialization edge and publishes no theorem token.

; Exact saved-fp prologue prefix at r20:
; `imm r5,8; sub r15,r5; store r15,r14; mov r14,r15`.
exact_require_prologue:
        mov r25, r20
        mov r20, r25
        imm r21, 1
        call require_tape_byte
        mov r20, r25
        imm r1, 1
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r25
        imm r1, 2
        add r20, r1
        imm r21, 8
        call require_tape_word
        mov r20, r25
        imm r1, 10
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r25
        imm r1, 11
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 12
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r25
        imm r1, 13
        add r20, r1
        imm r21, 11
        call require_tape_byte
        mov r20, r25
        imm r1, 14
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 15
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 16
        add r20, r1
        imm r21, 2
        call require_tape_byte
        mov r20, r25
        imm r1, 17
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 18
        add r20, r1
        imm r21, 15
        call require_tape_byte
        ret

; Exact optional frame allocation at r20 for r21 bytes:
; `imm r5,frame_bytes; sub r15,r5`.
exact_require_frame_allocation:
        mov r25, r20
        mov r26, r21
        mov r20, r25
        imm r21, 1
        call require_tape_byte
        mov r20, r25
        imm r1, 1
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r25
        imm r1, 2
        add r20, r1
        mov r21, r26
        call require_tape_word
        mov r20, r25
        imm r1, 10
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r25
        imm r1, 11
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 12
        add r20, r1
        imm r21, 5
        call require_tape_byte
        ret

; Exact parameter store at r20 for argument register r21:
; `mov r5,r14; imm r4,8+8*k; sub r5,r4; store r5,rK`.
exact_require_parameter_store:
        mov r25, r20
        mov r26, r21
        mov r20, r25
        imm r21, 2
        call require_tape_byte
        mov r20, r25
        imm r1, 1
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r25
        imm r1, 2
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 3
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r25
        imm r1, 4
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r25
        imm r1, 5
        add r20, r1
        mov r21, r26
        imm r1, 1
        add r21, r1
        imm r1, 8
        mul r21, r1
        call require_tape_word
        mov r20, r25
        imm r1, 13
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r25
        imm r1, 14
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r25
        imm r1, 15
        add r20, r1
        imm r21, 4
        call require_tape_byte
        mov r20, r25
        imm r1, 16
        add r20, r1
        imm r21, 11
        call require_tape_byte
        mov r20, r25
        imm r1, 17
        add r20, r1
        imm r21, 5
        call require_tape_byte
        mov r20, r25
        imm r1, 18
        add r20, r1
        mov r21, r26
        call require_tape_byte
        ret

; Exact 16-byte pop at r20 into register r21:
; `load rK,r15; imm r5,8; add r15,r5`.
exact_require_pop:
        call exact_match_pop
        imm r1, 1
        jeq r0, r1, exact_shape_ok
        jmp reject

; Boolean form used by exhaustive artifact scanners. Inputs match the strict
; adapter above; output r0 is one exactly for the canonical pop macro.
exact_match_pop:
        mov r25, r20
        mov r26, r21
        mov r2, r25
        imm r1, 16
        add r2, r1
        imm r1, 524296
        load r3, r1
        jlt r3, r2, exact_match_pop_none
        mov r20, r25
        imm r21, 10
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_register
        jmp exact_match_pop_none
exact_match_pop_register:
        mov r20, r25
        imm r1, 1
        add r20, r1
        mov r21, r26
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_sp
        jmp exact_match_pop_none
exact_match_pop_sp:
        mov r20, r25
        imm r1, 2
        add r20, r1
        imm r21, 15
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_imm
        jmp exact_match_pop_none
exact_match_pop_imm:
        mov r20, r25
        imm r1, 3
        add r20, r1
        imm r21, 1
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_step_register
        jmp exact_match_pop_none
exact_match_pop_step_register:
        mov r20, r25
        imm r1, 4
        add r20, r1
        imm r21, 5
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_step
        jmp exact_match_pop_none
exact_match_pop_step:
        mov r20, r25
        imm r1, 5
        add r20, r1
        imm r21, 8
        call exact_tape_word_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_add
        jmp exact_match_pop_none
exact_match_pop_add:
        mov r20, r25
        imm r1, 13
        add r20, r1
        imm r21, 3
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_add_sp
        jmp exact_match_pop_none
exact_match_pop_add_sp:
        mov r20, r25
        imm r1, 14
        add r20, r1
        imm r21, 15
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_pop_add_step
        jmp exact_match_pop_none
exact_match_pop_add_step:
        mov r20, r25
        imm r1, 15
        add r20, r1
        imm r21, 5
        call exact_tape_byte_matches
        ret
exact_match_pop_none:
        imm r0, 0
        ret

; Boolean byte/word equality at exact tape pc r20; output r0 is zero/one.
exact_tape_byte_matches:
        imm r1, 2097152
        add r1, r20
        loadb r2, r1
        jeq r2, r21, exact_tape_matches
        imm r0, 0
        ret
exact_tape_word_matches:
        imm r1, 2097152
        add r1, r20
        load r2, r1
        jeq r2, r21, exact_tape_matches
        imm r0, 0
        ret
exact_tape_matches:
        imm r0, 1
        ret

; Input r14 is a decoded start; output r0 is one iff the exact 16-byte push is
; `imm r2,8; sub r15,r2; store r15,r0`.
exact_match_push:
        mov r20, r14
        imm r1, 16
        add r20, r1
        imm r1, 524296
        load r2, r1
        jlt r2, r20, exact_match_push_none
        mov r20, r14
        imm r21, 1
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_register
        jmp exact_match_push_none
exact_match_push_register:
        mov r20, r14
        imm r1, 1
        add r20, r1
        imm r21, 2
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_step
        jmp exact_match_push_none
exact_match_push_step:
        mov r20, r14
        imm r1, 2
        add r20, r1
        imm r21, 8
        call exact_tape_word_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_sub
        jmp exact_match_push_none
exact_match_push_sub:
        mov r20, r14
        imm r1, 10
        add r20, r1
        imm r21, 4
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_sub_sp
        jmp exact_match_push_none
exact_match_push_sub_sp:
        mov r20, r14
        imm r1, 11
        add r20, r1
        imm r21, 15
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_sub_step
        jmp exact_match_push_none
exact_match_push_sub_step:
        mov r20, r14
        imm r1, 12
        add r20, r1
        imm r21, 2
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_store
        jmp exact_match_push_none
exact_match_push_store:
        mov r20, r14
        imm r1, 13
        add r20, r1
        imm r21, 11
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_store_sp
        jmp exact_match_push_none
exact_match_push_store_sp:
        mov r20, r14
        imm r1, 14
        add r20, r1
        imm r21, 15
        call exact_tape_byte_matches
        imm r1, 1
        jeq r0, r1, exact_match_push_store_value
        jmp exact_match_push_none
exact_match_push_store_value:
        mov r20, r14
        imm r1, 15
        add r20, r1
        imm r21, 0
        call exact_tape_byte_matches
        ret
exact_match_push_none:
        imm r0, 0
        ret

; Exhaust all expression primitive/push rows for selected blocks [r20,r21].
; The four supplied half-open row intervals must contain every matching row
; and no row owned by another block.
summary_require_expr_census:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        mov r36, r26
        mov r37, r27
        mov r38, r28
        mov r39, r29
        imm r10, 0
        imm r11, 0
summary_primitive_census_loop:
        imm r1, 829                  ; exact expression primitive-row universe
        jlt r10, r1, summary_primitive_census_row
        mov r2, r33
        sub r2, r32
        jeq r11, r2, summary_push_census_init
        jmp reject
summary_primitive_census_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 8388608
        add r1, r2
        load r3, r1
        jlt r3, r30, summary_primitive_census_next
        jlt r31, r3, summary_primitive_census_next
        jlt r10, r32, reject
        jlt r10, r33, summary_primitive_census_count
        jmp reject
summary_primitive_census_count:
        imm r1, 1
        add r11, r1
summary_primitive_census_next:
        imm r1, 1
        add r10, r1
        jmp summary_primitive_census_loop

summary_push_census_init:
        imm r10, 0
        imm r11, 0
summary_push_census_loop:
        imm r1, 407                  ; exact expression push-row universe
        jlt r10, r1, summary_push_census_row
        mov r2, r35
        sub r2, r34
        mov r4, r37
        sub r4, r36
        add r2, r4
        mov r4, r39
        sub r4, r38
        add r2, r4
        jeq r11, r2, exact_shape_ok
        jmp reject
summary_push_census_row:
        mov r2, r10
        imm r1, 8
        mul r2, r1
        imm r1, 9437184
        add r1, r2
        load r3, r1
        jlt r3, r30, summary_push_census_next
        jlt r31, r3, summary_push_census_next
        jlt r10, r34, summary_push_census_argument
        jlt r10, r35, summary_push_census_count
summary_push_census_argument:
        jlt r10, r36, summary_push_census_store
        jlt r10, r37, summary_push_census_count
summary_push_census_store:
        jlt r10, r38, reject
        jlt r10, r39, summary_push_census_count
        jmp reject
summary_push_census_count:
        imm r1, 1
        add r11, r1
summary_push_census_next:
        imm r1, 1
        add r10, r1
        jmp summary_push_census_loop

; Block row/PC in r20/r21.
exact_require_block_pc:
        imm r1, 8
        mul r20, r1
        imm r1, 3235840
        add r1, r20
        load r2, r1
        jeq r2, r21, exact_shape_ok
        jmp reject

; Canonical source-row identity to checked artifact-PC resolvers. The caller
; supplies a source-owned row and every non-coordinate identity field; the
; untrusted witness contributes only the PC after the independently rebuilt
; tables agree on that identity. Each resolver rejects an out-of-range row and
; clobbers only r0..r5.

; Block row/procedure/kind in r20..r22; return artifact PC in r0.
exact_block_identity_pc:
        mov r5, r20
        imm r1, 524320                 ; independently scanned block count
        load r1, r1
        jlt r5, r1, exact_block_identity_proc
        jmp reject
exact_block_identity_proc:
        imm r1, 8
        mul r5, r1
        imm r1, 3145728
        add r1, r5
        load r2, r1
        jeq r2, r21, exact_block_identity_kind
        jmp reject
exact_block_identity_kind:
        imm r1, 3178496
        add r1, r5
        load r2, r1
        jeq r2, r22, exact_block_identity_load
        jmp reject
exact_block_identity_load:
        imm r1, 3235840
        add r1, r5
        load r0, r1
        ret

; Resolve independently scanned source procedure ID r0 to its unique entry-block
; artifact PC. The untrusted witness supplies block locations, but it cannot
; select this identity: source procedure ownership and entry kind are checked in
; the canonical block tables before the one matching PC is returned. Clobbers
; only r0..r5.
exact_proc_entry_pc:
        mov r5, r0
        imm r4, 0                      ; block row
        imm r3, 0                      ; matching entries
        imm r0, 0                      ; selected artifact PC
exact_proc_entry_loop:
        imm r1, 524320                 ; independently scanned block count
        load r1, r1
        jlt r4, r1, exact_proc_entry_row
        imm r1, 1
        jeq r3, r1, exact_proc_entry_done
        jmp reject
exact_proc_entry_row:
        mov r2, r4
        imm r1, 8
        mul r2, r1
        imm r1, 3145728
        add r1, r2
        load r1, r1
        jeq r1, r5, exact_proc_entry_kind
        jmp exact_proc_entry_next
exact_proc_entry_kind:
        imm r1, 3178496
        add r1, r2
        load r1, r1
        imm r2, 0
        jeq r1, r2, exact_proc_entry_match
        jmp exact_proc_entry_next
exact_proc_entry_match:
        imm r1, 1
        add r3, r1
        mov r2, r4
        imm r1, 8
        mul r2, r1
        imm r1, 3235840
        add r1, r2
        load r0, r1
exact_proc_entry_next:
        imm r1, 1
        add r4, r1
        jmp exact_proc_entry_loop
exact_proc_entry_done:
        ret

; Destination adapters let semantic consumers replace an absolute entry PC
; with one extra call while leaving their other reconstructed arguments intact.
exact_proc_entry_r20:
        mov r0, r20
        call exact_proc_entry_pc
        mov r20, r0
        ret
exact_proc_entry_r21:
        mov r0, r21
        call exact_proc_entry_pc
        mov r21, r0
        ret
exact_proc_entry_r22:
        mov r0, r22
        call exact_proc_entry_pc
        mov r22, r0
        ret
exact_proc_entry_r23:
        mov r0, r23
        call exact_proc_entry_pc
        mov r23, r0
        ret
exact_proc_entry_r24:
        mov r0, r24
        call exact_proc_entry_pc
        mov r24, r0
        ret
exact_proc_entry_r25:
        mov r0, r25
        call exact_proc_entry_pc
        mov r25, r0
        ret

; Transition row/source-block/guarded/target/control-pc in r20..r24.
exact_require_transition:
        mov r25, r20
        imm r1, 8
        mul r25, r1
        imm r1, 3215360
        add r1, r25
        load r2, r1
        jeq r2, r21, exact_transition_guard
        jmp reject
exact_transition_guard:
        imm r1, 3227648
        add r1, r25
        load r2, r1
        jeq r2, r22, exact_transition_target
        jmp reject
exact_transition_target:
        imm r1, 3231744
        add r1, r25
        load r2, r1
        jeq r2, r23, exact_transition_pc
        jmp reject
exact_transition_pc:
        imm r1, 3239936
        add r1, r25
        load r2, r1
        jeq r2, r24, exact_shape_ok
        jmp reject

; Transition row/source-block/guarded/target-block in r20..r23; return the
; checked control-instruction PC in r0.
exact_transition_identity_pc:
        mov r5, r20
        imm r1, 524328                 ; independently scanned transition count
        load r1, r1
        jlt r5, r1, exact_transition_identity_source
        jmp reject
exact_transition_identity_source:
        imm r1, 8
        mul r5, r1
        imm r1, 3215360
        add r1, r5
        load r2, r1
        jeq r2, r21, exact_transition_identity_guard
        jmp reject
exact_transition_identity_guard:
        imm r1, 3227648
        add r1, r5
        load r2, r1
        jeq r2, r22, exact_transition_identity_target
        jmp reject
exact_transition_identity_target:
        imm r1, 3231744
        add r1, r5
        load r2, r1
        jeq r2, r23, exact_transition_identity_load
        jmp reject
exact_transition_identity_load:
        imm r1, 3239936
        add r1, r5
        load r0, r1
        ret

; Event row/block/kind/pc in r20..r23.
exact_require_event:
        mov r25, r20
        imm r1, 8
        mul r25, r1
        imm r1, 7077888
        add r1, r25
        load r2, r1
        jeq r2, r21, exact_event_kind
        jmp reject
exact_event_kind:
        imm r1, 7086080
        add r1, r25
        load r2, r1
        jeq r2, r22, exact_event_pc
        jmp reject
exact_event_pc:
        imm r1, 7135232
        add r1, r25
        load r2, r1
        jeq r2, r23, exact_shape_ok
        jmp reject

; Event row/source-block/kind in r20..r22; return artifact PC in r0.
exact_event_identity_pc:
        mov r5, r20
        imm r1, 524456                 ; independently scanned event count
        load r1, r1
        jlt r5, r1, exact_event_identity_block
        jmp reject
exact_event_identity_block:
        imm r1, 8
        mul r5, r1
        imm r1, 7077888
        add r1, r5
        load r2, r1
        jeq r2, r21, exact_event_identity_kind
        jmp reject
exact_event_identity_kind:
        imm r1, 7086080
        add r1, r5
        load r2, r1
        jeq r2, r22, exact_event_identity_load
        jmp reject
exact_event_identity_load:
        imm r1, 7135232
        add r1, r5
        load r0, r1
        ret

; A source return event identifies the return instruction. Reconstruct its
; canonical epilogue start relative to that event instead of pinning either PC.
; Inputs are event row/block/kind in r20..r22.
exact_require_event_epilogue:
        call exact_event_identity_pc
        mov r21, r0
        mov r20, r0
        imm r1, 19
        sub r20, r1
        call exact_require_epilogue
        ret

; The next source procedure identity in r20 identifies the byte after a
; synthetic return. Reconstruct that return and its epilogue relatively.
exact_require_preentry_epilogue:
        mov r0, r20
        call exact_proc_entry_pc
        mov r21, r0
        imm r1, 1
        sub r21, r1
        mov r20, r21
        imm r1, 19
        sub r20, r1
        call exact_require_epilogue
        ret

; Exact 19-byte canonical epilogue at [r20,r21], with r21=r20+19.
exact_require_epilogue:
        mov r25, r20
        mov r26, r21
        mov r2, r25
        imm r1, 19
        add r2, r1
        jeq r2, r26, exact_epilogue_ret_linked
        jmp reject
exact_epilogue_ret_linked:
        mov r20, r25
        imm r21, 2
        call require_tape_byte
        mov r20, r25
        imm r1, 1
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 2
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 3
        add r20, r1
        imm r21, 10
        call require_tape_byte
        mov r20, r25
        imm r1, 4
        add r20, r1
        imm r21, 14
        call require_tape_byte
        mov r20, r25
        imm r1, 5
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 6
        add r20, r1
        imm r21, 1
        call require_tape_byte
        mov r20, r25
        imm r1, 7
        add r20, r1
        imm r21, 2
        call require_tape_byte
        mov r20, r25
        imm r1, 8
        add r20, r1
        imm r21, 8
        call require_tape_word
        mov r20, r25
        imm r1, 16
        add r20, r1
        imm r21, 3
        call require_tape_byte
        mov r20, r25
        imm r1, 17
        add r20, r1
        imm r21, 15
        call require_tape_byte
        mov r20, r25
        imm r1, 18
        add r20, r1
        imm r21, 2
        call require_tape_byte
        mov r20, r25
        imm r1, 19
        add r20, r1
        imm r21, 20
        call require_tape_byte
        ret

; Exhaust local/memory/transition/event rows for blocks [r20,r21].
exact_require_effect_census:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        mov r36, r26
        mov r37, r27
        mov r38, r28
        mov r39, r29
        imm r10, 0
        imm r11, 0
exact_effect_local_loop:
        imm r1, 242
        jlt r10, r1, exact_effect_local_row
        mov r2, r33
        sub r2, r32
