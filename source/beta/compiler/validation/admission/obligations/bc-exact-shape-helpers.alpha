; Push row/source-block/kind in r20..r22; return its checked artifact PC in r0.
exact_push_identity_pc:
        mov r5, r20
        imm r1, 524752
        load r1, r1
        jlt r5, r1, exact_push_identity_block
        jmp reject
exact_push_identity_block:
        imm r1, 8
        mul r5, r1
