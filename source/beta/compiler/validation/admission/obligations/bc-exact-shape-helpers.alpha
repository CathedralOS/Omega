; Primitive row/block/kind/value-or-opcode in r20..r23; return its checked
; artifact PC in r0.
exact_primitive_identity_pc:
        mov r5, r20
        imm r1, 524696
        load r1, r1
        jlt r5, r1, exact_primitive_identity_block
