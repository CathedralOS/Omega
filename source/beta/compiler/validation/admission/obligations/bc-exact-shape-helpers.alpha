        add r1, r5
        load r2, r1
        jeq r2, r23, exact_local_identity_load
        jmp reject
exact_local_identity_load:
        imm r1, 7192576
        add r1, r5
        load r0, r1
        ret

; memory row/block/kind/width/pc in r20..r24.
transfer_require_memory:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        mov r28, r23
        mov r29, r24
        imm r20, 7602176
        mov r21, r25
