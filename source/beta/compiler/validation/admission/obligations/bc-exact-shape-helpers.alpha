; Rejoin one ordinary source call across the event, arity, expression-height,
; and decoded-call tables. Inputs are event/block/pc/arity/ambient/target/
; continuation in r20..r26.
summary_require_call_site:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        mov r36, r26
        mov r20, r30
        mov r21, r31
        imm r22, 1
        mov r23, r32
