; Exact control/effect shape for count_lets().
;
; The canonical procedure inventory owns procedure 39's total block span and
; partition. This module owns its frame, seventeen transitions, ten ordinary
; calls, source and synthetic returns/epilogues, exhaustive effect row intervals,
; and decoded-region call/return census. Local, memory, primitive, and push row
; payloads are separated into bc-count-lets-data-shape.alpha.

count_lets_require_control_shape:
        imm r20, 39
        imm r21, 0
        imm r22, 4
        imm r23, 40
        call exact_require_proc_frame_identity

        call count_lets_require_transitions
        call count_lets_require_events
        call count_lets_require_control_census
        ret

count_lets_require_transitions:
