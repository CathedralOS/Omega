        imm r22, 0
        imm r23, 194
        call exact_transition_identity_pc
        imm r20, 157
        imm r21, 198
        imm r22, 0
        imm r23, 194
        call exact_transition_identity_pc
        imm r20, 158
        imm r21, 199
        imm r22, 0
        imm r23, 194
        call exact_transition_identity_pc
        imm r20, 159
        imm r21, 200
        imm r22, 0
        imm r23, 194
        call exact_transition_identity_pc
        imm r20, 160
        imm r21, 201
        imm r22, 1
        imm r23, 202
        call exact_transition_identity_pc ; checked exact is_let guard
        imm r20, 161
        imm r21, 201
        imm r22, 0
        imm r23, 194
        call exact_transition_identity_pc
        imm r20, 162
        imm r21, 202
        imm r22, 0
        imm r23, 194
        call exact_transition_identity_pc
        ret

