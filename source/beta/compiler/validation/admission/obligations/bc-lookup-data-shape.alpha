; Exact local/raw-memory/expression ownership for procedure36 lookup().

lookup_require_data_shape:
        call lookup_require_locals
        call lookup_require_memory
        call lookup_require_primitives
        call lookup_require_pushes
        call lookup_require_control_census
        ret

lookup_require_locals:
        imm r20, 90
        imm r21, 179
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc                ; n snapshot store
        imm r20, 91
        imm r21, 179
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc                ; i=0 store
        imm r20, 92
        imm r21, 180
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc                ; loop i load
        imm r20, 93
        imm r21, 180
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc                ; loop snapshot n load
        imm r20, 94
        imm r21, 181
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc                ; name_eq argument i
        imm r20, 95
        imm r21, 181
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc                ; i=i+1 store
        imm r20, 96
        imm r21, 181
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc                ; increment i load
        imm r20, 97
        imm r21, 182
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc                ; hit result i load
        ret

lookup_require_memory:
        imm r20, 51
        imm r21, 179
        imm r25, 477
        imm r26, 2097128             ; exact NLOC snapshot load
        call exact_memory_load_pc
        ret

; Stable row/block/kind/value-or-opcode identities.
lookup_require_primitives:
        imm r20, 477
        imm r21, 179
        imm r22, 1
        imm r23, 2097128
        call exact_primitive_identity_pc
        imm r20, 478
        imm r21, 179
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 479
        imm r21, 180
        imm r22, 3
        imm r23, 8                    ; signed i<n
        call exact_primitive_identity_pc
        imm r20, 480
        imm r21, 180
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 481
        imm r21, 181
        imm r22, 3
        imm r23, 10                   ; name_eq result == 1
        call exact_primitive_identity_pc
        imm r20, 482
        imm r21, 181
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 483
        imm r21, 181
        imm r22, 2
        imm r23, 3                    ; i+1
        call exact_primitive_identity_pc
        imm r20, 484
        imm r21, 181
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        ret

lookup_require_pushes:
        imm r20, 130
        imm r21, 180
        call exact_require_binary_push_identity
        imm r20, 131
        imm r21, 181
        call exact_require_binary_push_identity
        imm r20, 132
        imm r21, 181
        call exact_require_binary_push_identity
        imm r20, 315
        imm r21, 181
        call exact_require_argument_push_identity                ; exact name_eq argument push
        imm r20, 179
        imm r21, 182
        imm r22, 477
        imm r23, 485
        imm r24, 130
        imm r25, 133
        imm r26, 315
        imm r27, 316
        imm r28, 389                  ; exact empty store-address interval
        imm r29, 389
        call summary_require_expr_census
        ret
