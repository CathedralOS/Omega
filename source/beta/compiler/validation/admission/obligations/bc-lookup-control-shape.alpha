; Exact control/frame/call/effect shape for procedure36 lookup().

lookup_require_shape:
        imm r20, 36
        imm r21, 0                    ; no parameters
        imm r22, 2                    ; n,i
        imm r23, 24                   ; exact proc36 frame bytes
        call exact_require_proc_frame_identity

lookup_shape_graph:
        imm r20, 179
        imm r21, 182
        imm r22, 36
        call exact_require_proc_blocks
        ; The canonical procedure inventory owns proc36's total block span and
        ; entry/state partition. The identities below retain its semantic graph.
        call lookup_require_transitions
        call lookup_require_events
        ret

lookup_require_transitions:
        imm r20, 134
        imm r21, 180
        imm r22, 1
        imm r23, 181
        call exact_transition_identity_pc ; i<n branch root
        imm r20, 135
        imm r21, 181
        imm r22, 1
        imm r23, 182
        call exact_transition_identity_pc ; name_eq result-one branch root
        imm r20, 136
        imm r21, 181
        imm r22, 0
        imm r23, 180
        call exact_transition_identity_pc ; exact no-match backedge
        ret

lookup_require_events:
        imm r20, 36
        imm r21, 180
        call exact_require_event_epilogue ; exhausted return zero
        imm r20, 36
        imm r21, 181
        imm r22, 1
        imm r23, 0
        imm r24, 35                    ; name_eq procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 36
        imm r21, 182
        call exact_require_event_epilogue ; hit return i
        imm r20, 37                    ; skip_char_lit identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

lookup_require_control_census:
        imm r20, 179
        imm r21, 182
        imm r22, 90
        imm r23, 98                   ; exclusive local row
        imm r24, 51
        imm r25, 52                   ; exclusive memory row
        imm r26, 134
        imm r27, 137                  ; exclusive transition row
        imm r28, 278
        imm r29, 281                  ; exclusive event row
        call exact_require_effect_census
        imm r20, 36
        call exact_proc_entry_r20
        imm r21, 37
        call exact_proc_entry_r21
        imm r22, 1                    ; name_eq call
        imm r23, 3                    ; two source plus synthetic return
        imm r24, 8                    ; prologue/local/temporary stores
        call exact_quiet_scan_region
        ret
