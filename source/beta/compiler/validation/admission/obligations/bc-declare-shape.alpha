declare_require_censuses:
        imm r20, 170
        imm r21, 172
        imm r22, 70
        imm r23, 76
        imm r24, 37
        imm r25, 44                  ; checked exclusive declare memory row
        imm r26, 128
        imm r27, 129
        imm r28, 273
        imm r29, 275                 ; checked exclusive declare event row
        call exact_require_effect_census
        imm r20, 170
