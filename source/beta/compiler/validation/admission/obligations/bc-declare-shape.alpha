; Exact source/artifact shape for declare().
;
; This module owns procedure 34's three blocks, capacity guard, local snapshot,
; fixed/resource and ranged-name-table memory sites, arithmetic, push families,
; returns/epilogues, frame, and exhaustive row/decoded-region censuses.  The
; adjacent module owns the successful insertion and full-table meanings.

declare_require_shape:
        imm r20, 7151616
        imm r21, 34
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 34
        imm r22, 1
        call transfer_require_cell
        imm r20, 34
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, declare_shape_blocks
        jmp reject

declare_shape_blocks:
        imm r20, 170
        imm r21, 24145
        call exact_require_block_pc
        imm r20, 171
        imm r21, 24209
        call exact_require_block_pc
        imm r20, 172
        imm r21, 24417
        call exact_require_block_pc
        imm r20, 170
        imm r21, 172
        imm r22, 34
        call exact_require_proc_blocks
        imm r20, 128
        imm r21, 171
        imm r22, 1
        imm r23, 172
        imm r24, 24313               ; checked declare room guard
        call exact_require_transition
        call declare_require_events
        call declare_require_locals
        call declare_require_memory
        call declare_require_primitives
        call declare_require_pushes
        call declare_require_censuses
        ret

declare_require_events:
