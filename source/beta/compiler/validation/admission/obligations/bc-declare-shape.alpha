; Exact source/artifact shape for declare().
;
; The canonical procedure inventory owns procedure 34's total block span and
; entry/state partition. This module owns its capacity guard, local snapshot,
; fixed/resource and ranged-name-table memory sites, arithmetic, push families,
; returns/epilogues, frame, and exhaustive row/decoded-region censuses.  The
; adjacent module owns the successful insertion and full-table meanings.

declare_require_shape:
        imm r20, 34
        imm r21, 0
        imm r22, 1
        imm r23, 16
        call exact_require_proc_frame_identity

declare_shape_graph:
        imm r20, 128
        imm r21, 171
        imm r22, 1
        imm r23, 172
        call exact_transition_identity_pc ; checked declare room guard
        call declare_require_events
        call declare_require_locals
        call declare_require_memory
        call declare_require_primitives
        call declare_require_pushes
        call declare_require_censuses
        ret

declare_require_events:
        imm r20, 34
        imm r21, 171
        call exact_require_event_epilogue
        imm r20, 34
        imm r21, 172
        call exact_require_event_epilogue
        imm r20, 35                    ; name_eq identifies synthetic return
        call exact_require_preentry_epilogue
        ret

declare_require_locals:
        imm r20, 70
        imm r21, 170
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 71
        imm r21, 171
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 72
        imm r21, 172
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 73
        imm r21, 172
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 74
        imm r21, 172
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 75
        imm r21, 172
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        ret

declare_require_memory:
        imm r20, 37
        imm r21, 170
        imm r25, 432
        imm r26, 2097128            ; NLOC load
        call exact_memory_load_pc
        imm r20, 38
        imm r21, 171
        call exact_memory_store_pc  ; RESOURCE_FAIL store
        imm r20, 39
        imm r21, 172
        call exact_memory_store_pc  ; NAMEOFF[s] store
        imm r20, 40
        imm r21, 172
        imm r25, 442
        imm r26, 2097120            ; IDOFF load
        call exact_memory_load_pc
        imm r20, 41
        imm r21, 172
        call exact_memory_store_pc  ; NAMELEN[s] store
        imm r20, 42
        imm r21, 172
        imm r25, 447
        imm r26, 2097112            ; IDLEN load
        call exact_memory_load_pc
        imm r20, 43
        imm r21, 172
        call exact_memory_store_pc  ; NLOC store
        ret

declare_require_primitives:
        ; Stable row/block/kind/value-or-opcode identities.
        imm r20, 432
        imm r21, 170
        imm r22, 1
        imm r23, 2097128             ; NLOC
        call exact_primitive_identity_pc
        imm r20, 433
        imm r21, 171
        imm r22, 3
        imm r23, 8                   ; signed s<1024
        call exact_primitive_identity_pc
        imm r20, 434
        imm r21, 171
        imm r22, 1
        imm r23, 1024                ; checked declare capacity
        call exact_primitive_identity_pc
        imm r20, 435
        imm r21, 171
        imm r22, 1
        imm r23, 2097072             ; RESOURCE_FAIL
        call exact_primitive_identity_pc
        imm r20, 436
        imm r21, 171
        imm r22, 1
        imm r23, 252                 ; checked declare exhaustion status
        call exact_primitive_identity_pc
        imm r20, 437
        imm r21, 171
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc

        imm r20, 438
        imm r21, 172
        imm r22, 1
        imm r23, 3145728             ; NAMEOFF base
        call exact_primitive_identity_pc
        imm r20, 439
        imm r21, 172
        imm r22, 2
        imm r23, 3                   ; base + scaled index
        call exact_primitive_identity_pc
        imm r20, 440
        imm r21, 172
        imm r22, 2
        imm r23, 5                   ; s * 8
        call exact_primitive_identity_pc
        imm r20, 441
        imm r21, 172
        imm r22, 1
        imm r23, 8
        call exact_primitive_identity_pc
        imm r20, 442
        imm r21, 172
        imm r22, 1
        imm r23, 2097120             ; IDOFF payload
        call exact_primitive_identity_pc

        imm r20, 443
        imm r21, 172
        imm r22, 1
        imm r23, 3153920             ; NAMELEN base
        call exact_primitive_identity_pc
        imm r20, 444
        imm r21, 172
        imm r22, 2
        imm r23, 3
        call exact_primitive_identity_pc
        imm r20, 445
        imm r21, 172
        imm r22, 2
        imm r23, 5
        call exact_primitive_identity_pc
        imm r20, 446
        imm r21, 172
        imm r22, 1
        imm r23, 8
        call exact_primitive_identity_pc
        imm r20, 447
        imm r21, 172
        imm r22, 1
        imm r23, 2097112             ; IDLEN payload
        call exact_primitive_identity_pc

        imm r20, 448
        imm r21, 172
        imm r22, 1
        imm r23, 2097128
        call exact_primitive_identity_pc
        imm r20, 449
        imm r21, 172
        imm r22, 2
        imm r23, 3                   ; s+1
        call exact_primitive_identity_pc
        imm r20, 450
        imm r21, 172
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        ret

