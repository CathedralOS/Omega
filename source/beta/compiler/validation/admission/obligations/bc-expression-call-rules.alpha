; Parameterized semantic rule for gen_call().
;
; Builtins dispatch before the normal-call path.  A normal call snapshots the
; callee slice, then uses the finite rank 4-nargs.  Each successful argument is
; compiled left-to-right and staged; numeric252 after a child returns before
; that child's push. A non-')' byte at nargs=4 writes252 before parsing argument
; five. Successful close pops in reverse and emits the saved name.  Existing
; status252 is sticky and is not an entry guard. Work 540400..<541200.

expression_call_rules_init:
        call expression_call_reset
        call expression_call_require_imports
        call expression_call_prove_dispatch
        call expression_call_prove_saved_name
        call expression_call_prove_arg_domain
        call expression_call_prove_child_resource
        call expression_call_prove_arg_success
        call expression_call_prove_capacity_exit
        call expression_call_prove_success
        call expression_call_publish
        jmp expression_factor_rules_init

expression_call_reset:
        imm r1, 540400
        imm r2, 0
expression_call_reset_loop:
        imm r3, 541200
        jlt r1, r3, expression_call_reset_one
        ret
expression_call_reset_one:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp expression_call_reset_loop

expression_call_require_imports:
        imm r20, 540016
        imm r21, 1364349016             ; XPRQ
        call exact_require_cell
        imm r20, 545600
        imm r21, 1129534036             ; XRSC
        call exact_require_cell
        imm r20, 540040
        imm r21, 1414682439             ; GWRT
        call exact_require_cell
        imm r20, 531880
        imm r21, 1111773767             ; GRDB
        call exact_require_cell
        imm r20, 531896
        imm r21, 1398100037             ; EPUS
        call exact_require_cell
        imm r20, 531888
        imm r21, 1347375173             ; EPOP
        call exact_require_cell
        imm r20, 528192
        imm r21, 1396984133             ; EIDS
        call exact_require_cell
        imm r20, 534856
        imm r21, 1397572935             ; GEMS
        call exact_require_cell
        imm r20, 530456
        imm r21, 1398231878             ; FKWS
        call exact_require_cell
        imm r1, 540400
        imm r2, 1
        store r1, r2
        ret

; r21=source block, r22=arity, r23=target procedure. Reconstruct the unique
; call PC, target entry, and canonical nine-byte fallthrough locally because
; the semantic checker does not concatenate the control-shape helper labels.
expression_call_require_site:
        mov r24, r23
        imm r23, 0
        imm r20, 32                    ; gen_call owning procedure identity
        call summary_require_call_fallthrough_identity
        ret

expression_call_prove_dispatch:
        ; Exact predicate/delegate pairs in source priority order.
        imm r21, 151
        imm r22, 0
        imm r23, 21                    ; is_read_byte
        call expression_call_require_site
        imm r21, 152
        imm r22, 0
        imm r23, 30                    ; gen_read_byte
        call expression_call_require_site
        imm r21, 153
        imm r22, 0
        imm r23, 22                    ; is_write_byte
        call expression_call_require_site
        imm r21, 154
        imm r22, 0
        imm r23, 31                    ; gen_write_byte
        call expression_call_require_site
        imm r21, 155
        imm r22, 0
        imm r23, 23                    ; is_emit
        call expression_call_require_site
        imm r21, 156
        imm r22, 0
        imm r23, 28                    ; gen_emit
        call expression_call_require_site
        imm r1, 540408
        imm r2, 4                     ; read/write/emit/normal partition
        store r1, r2
        imm r1, 540416
        imm r2, 1                     ; read delegates GRDB
        store r1, r2
        imm r1, 540424
        store r1, r2                   ; write delegates GWRT incl resource
        imm r1, 540432
        store r1, r2                   ; emit delegates GEMS
        ret

expression_call_prove_saved_name:
        ; IDOFF/IDLEN fixed loads precede every argument child and are stored in
        ; distinct locals0/1. Later identifier parsing may clobber globals only.
        imm r20, 33
        imm r21, 157
        imm r25, 400
        imm r26, 2097120
        call exact_memory_load_pc
        imm r20, 34
        imm r21, 157
        imm r25, 401
        imm r26, 2097112
        call exact_memory_load_pc
        imm r20, 52
        imm r21, 157
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 53
        imm r21, 157
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc
        imm r1, 540440
        imm r2, 1                     ; stable saved slice provenance
        store r1, r2
        ret

; Exhaust exact local nargs values 0..4 and the small signed guard domain.
expression_call_prove_arg_domain:
        imm r10, 0
        imm r11, 0
expression_call_arg_domain_loop:
        imm r1, 5
        jlt r10, r1, expression_call_arg_domain_row
        imm r1, 5
        jeq r11, r1, expression_call_arg_domain_done
        jmp reject
expression_call_arg_domain_row:
        imm r1, 4
        jlt r10, r1, expression_call_arg_domain_room
        imm r1, 540456
        imm r2, 2                     ; nargs4 selects capacity failure
        store r1, r2
        jmp expression_call_arg_domain_next
expression_call_arg_domain_room:
        imm r1, 540456
        imm r2, 1                     ; nargs0..3 admit child
        store r1, r2
expression_call_arg_domain_next:
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp expression_call_arg_domain_loop
expression_call_arg_domain_done:
        imm r1, 540448
        imm r2, 5
        store r1, r2
        ret

expression_call_require_arg_child:
        imm r21, 160
        imm r22, 0
        imm r23, 61                    ; gen_expr procedure identity
        call expression_call_require_site
        ret

expression_call_prove_child_resource:
        call expression_call_require_arg_child
        ; Exact RESOURCE load/!=0 guard reaches argfailed. Counter custody
        ; restricts the compositional status to numeric0 or252.
        imm r20, 36
        imm r21, 160
        imm r25, 411
        imm r26, 2097072
        call exact_memory_load_pc
        imm r20, 118
        imm r21, 160
        imm r22, 1
        imm r23, 161
        call exact_transition_identity_pc
        imm r1, 540464
        imm r2, 1                     ; child trace retained
        store r1, r2
        imm r1, 540472
        store r1, r2                   ; no child push
        imm r1, 540480
        store r1, r2                   ; no pop/call suffix
        imm r1, 540488
        store r1, r2                   ; prior staged args retained
        ret

expression_call_prove_arg_success:
        call expression_call_require_arg_child
        imm r21, 160
        imm r22, 0
        imm r23, 47                    ; emit_push procedure identity
        call expression_call_require_site
        imm r20, 56
        imm r21, 160
        imm r22, 2
        imm r23, 2
        call exact_local_identity_pc
        ; Both comma and no-comma continuations rejoin argloop. Comma consumes
        ; exactly one byte before SWS; separators are otherwise optional.
        imm r20, 119
        imm r21, 160
        imm r22, 1
        imm r23, 162
        call exact_transition_identity_pc
        imm r20, 120
        imm r21, 160
        imm r22, 0
        imm r23, 158
        call exact_transition_identity_pc
        imm r20, 121
        imm r21, 162
        imm r22, 0
        imm r23, 158
        call exact_transition_identity_pc
        imm r1, 540496
        imm r2, 1                     ; 33-byte push after child success only
        store r1, r2
        imm r1, 540504
        store r1, r2                   ; nargs increments exactly once
        imm r1, 540512
        imm r2, 2                     ; separator partition rejoined
        store r1, r2
        ret

expression_call_prove_capacity_exit:
        ; At nargs=4 and byte!=')', row35 writes252 before any fifth child.
        imm r20, 35
        imm r21, 159
        call exact_memory_store_pc
        imm r20, 409
        imm r21, 159
        imm r22, 1
        imm r23, 252
        call exact_primitive_identity_pc
        imm r20, 383
        imm r21, 159
        call exact_require_store_push_identity
        imm r1, 540520
        imm r2, 1                     ; numeric252 exact writer
        store r1, r2
        imm r1, 540528
        store r1, r2                   ; fifth byte remains unconsumed
        imm r1, 540536
        store r1, r2                   ; no fifth GE call/output
        imm r1, 540544
        store r1, r2                   ; first-failure=arg iff entry status0
        ret

expression_call_prove_success:
        ; Close consumes ')' then the finite pop rank k=nargs reaches zero.
        imm r21, 163
        imm r22, 0
        imm r23, 5                     ; adv
        call expression_call_require_site
        imm r21, 165
        imm r22, 1
        imm r23, 44                    ; emit_pop_into procedure identity
        call expression_call_require_site
        imm r10, 0
        imm r11, 0
expression_call_pop_domain_loop:
        imm r1, 5
        jlt r10, r1, expression_call_pop_domain_row
        imm r1, 5
        jeq r11, r1, expression_call_emit_suffix
        jmp reject
expression_call_pop_domain_row:
        ; n pops target r(n-1)..r0; n=0 performs no pop.
        imm r1, 540552
        store r1, r10
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp expression_call_pop_domain_loop
expression_call_emit_suffix:
        imm r20, 264
        call write_str_require_emit_event
        imm r2, 5                     ; "call "
        jeq r1, r2, expression_call_ident_site
        jmp reject
expression_call_ident_site:
        imm r21, 166
        imm r22, 2
        imm r23, 45                    ; emit_ident_at procedure identity
        call expression_call_require_site
        imm r20, 266
        call write_str_require_emit_event
        imm r2, 1                     ; newline
        jeq r1, r2, expression_call_success_done
        jmp reject
expression_call_success_done:
        imm r20, 540440
        imm r21, 1                     ; emitted identity is saved callee slice
        call exact_require_cell
        imm r1, 540560
        imm r2, 1                     ; order: children,pushes,pops,call,name,LF
        store r1, r2
        imm r1, 540568
        store r1, r2                   ; exact overhead 65*n+6+namelen
        ret

expression_call_publish:
        imm r20, 540408
        imm r21, 4
        call exact_require_cell
        imm r20, 540448
        imm r21, 5
        call exact_require_cell
        imm r20, 540464
        imm r21, 1
        call exact_require_cell
        imm r20, 540496
        imm r21, 1
        call exact_require_cell
        imm r20, 540520
        imm r21, 1
        call exact_require_cell
        imm r20, 540560
        imm r21, 1
        call exact_require_cell
        imm r1, 540048
        imm r2, 1279347783             ; GCAL
        store r1, r2
        ret
