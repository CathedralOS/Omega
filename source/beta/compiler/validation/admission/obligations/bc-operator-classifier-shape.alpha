; Exact source/artifact shape for is_muldiv(c) and is_addsub(c), procedures
; 53..54. The canonical procedure inventory owns their total block spans and
; partitions. This module owns only edges, returns, parameter loads,
; equality/literal primitives, binary pushes, frames, and decoded quiet regions.

operator_classifier_require_shape:
        imm r20, 53
        call operator_classifier_require_proc_frame
        imm r20, 54
        call operator_classifier_require_proc_frame

        imm r20, 234
        imm r21, 238
        imm r22, 53
        call exact_require_proc_blocks
        imm r20, 239
        imm r21, 242
        imm r22, 54
        call exact_require_proc_blocks
        call operator_classifier_require_transitions
        call operator_classifier_require_events
        call operator_classifier_require_locals
        call operator_classifier_require_primitives
        call operator_classifier_require_pushes
        call operator_classifier_require_censuses
        ret

operator_classifier_require_proc_frame:
        imm r21, 1                    ; one parameter
        imm r22, 1                    ; one total frame slot
        imm r23, 16                   ; saved fp plus parameter slot
        call exact_require_proc_frame_identity
        ret

operator_classifier_require_transitions:
        ; is_muldiv: star, slash, percent, complement.
        imm r20, 178
        imm r21, 235
        imm r22, 1
        imm r23, 238
        call exact_transition_identity_pc ; checked star-true guard
        imm r20, 179
        imm r21, 235
        imm r22, 0
        imm r23, 236
        call exact_transition_identity_pc
        imm r20, 180
        imm r21, 236
        imm r22, 1
        imm r23, 238
        call exact_transition_identity_pc
        imm r20, 181
        imm r21, 236
        imm r22, 0
        imm r23, 237
        call exact_transition_identity_pc
        imm r20, 182
        imm r21, 237
        imm r22, 1
        imm r23, 238
        call exact_transition_identity_pc ; checked percent-true guard

        ; is_addsub: plus, minus, complement.
        imm r20, 183
        imm r21, 240
        imm r22, 1
        imm r23, 242
        call exact_transition_identity_pc ; checked plus-true guard
        imm r20, 184
        imm r21, 240
        imm r22, 0
        imm r23, 241
        call exact_transition_identity_pc
        imm r20, 185
        imm r21, 241
        imm r22, 1
        imm r23, 242
        call exact_transition_identity_pc ; checked minus-true guard
        ret

operator_classifier_require_events:
        imm r20, 53
        imm r21, 237
        call exact_require_event_epilogue ; is_muldiv false return
        imm r20, 53
        imm r21, 238
        call exact_require_event_epilogue ; is_muldiv true return
        imm r20, 54                    ; is_addsub identifies synthetic return
        call exact_require_preentry_epilogue

        imm r20, 54
        imm r21, 241
        call exact_require_event_epilogue ; is_addsub false return
        imm r20, 54
        imm r21, 242
        call exact_require_event_epilogue ; is_addsub true return
        imm r20, 55                    ; gen_factor identifies synthetic return
        call exact_require_preentry_epilogue
        ret

operator_classifier_require_locals:
        imm r20, 144
        imm r21, 235
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc  ; c for star
        imm r20, 145
        imm r21, 236
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc  ; c for slash
        imm r20, 146
        imm r21, 237
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc  ; c for percent
        imm r20, 147
        imm r21, 240
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc  ; c for plus
        imm r20, 148
        imm r21, 241
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc  ; c for minus
        ret

operator_classifier_require_primitives:
        ; row/block/kind/value-or-comparison-code/PC.
        imm r20, 572
        imm r21, 235
        imm r22, 3
        imm r23, 10                   ; full-word ==
        call exact_primitive_identity_pc
        imm r20, 573
        imm r21, 235
        imm r22, 1
        imm r23, 42                   ; '*'
        call exact_primitive_identity_pc
        imm r20, 574
        imm r21, 236
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 575
        imm r21, 236
        imm r22, 1
        imm r23, 47                   ; '/'
        call exact_primitive_identity_pc
        imm r20, 576
        imm r21, 237
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 577
        imm r21, 237
        imm r22, 1
        imm r23, 37                   ; '%'
        call exact_primitive_identity_pc
        imm r20, 578
        imm r21, 237
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 579
        imm r21, 238
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc

        imm r20, 580
        imm r21, 240
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 581
        imm r21, 240
        imm r22, 1
        imm r23, 43                   ; '+'
        call exact_primitive_identity_pc
        imm r20, 582
        imm r21, 241
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 583
        imm r21, 241
        imm r22, 1
        imm r23, 45                   ; '-'
        call exact_primitive_identity_pc
        imm r20, 584
        imm r21, 241
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 585
        imm r21, 242
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        ret

operator_classifier_require_pushes:
        imm r20, 167
        imm r21, 235
        call exact_require_binary_push_identity
        imm r20, 168
        imm r21, 236
        call exact_require_binary_push_identity
        imm r20, 169
        imm r21, 237
        call exact_require_binary_push_identity
        imm r20, 170
        imm r21, 240
        call exact_require_binary_push_identity
        imm r20, 171
        imm r21, 241
        call exact_require_binary_push_identity
        ret

operator_classifier_require_censuses:
        imm r20, 234
        imm r21, 242
        imm r22, 144
        imm r23, 149                 ; checked exclusive local row
        imm r24, 55
        imm r25, 55                  ; no raw-memory rows
        imm r26, 178
        imm r27, 186                 ; checked exclusive transition row
        imm r28, 379
        imm r29, 383                 ; checked exclusive event row
        call exact_require_effect_census
        imm r20, 234
        imm r21, 242
        imm r22, 572
        imm r23, 586                 ; checked exclusive primitive row
        imm r24, 167
        imm r25, 172                 ; checked exclusive binary-push row
        imm r26, 337
        imm r27, 337                 ; no argument pushes
        imm r28, 389
        imm r29, 389                 ; no store-address pushes
        call summary_require_expr_census
        imm r20, 53
        call exact_proc_entry_r20
        imm r21, 55
        call exact_proc_entry_r21
        imm r22, 0                   ; no calls
        imm r23, 6                   ; four explicit plus two synthetic returns
        imm r24, 9                   ; prologue/parameter/binary stores
        call exact_quiet_scan_region
        ret
