; Conditional semantic tranche for the statement family. The common decoded
; table prefix has already tied this process to the canonical source, artifact,
; witness, and call-bound schemas. External theorem cells are never copied into
; this address space: the adjacent antecedent module records their exact public
; proposition schemas, and the shell accepts only the conjunction of every
; producing checker with the implication published by this process.

stack_register_custody_init:
        imm r1, 546100
        imm r2, 1481787731             ; SIRX
        store r1, r2
        jmp statement_antecedent_init
