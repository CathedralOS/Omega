; Conjunction of the exact CFG, event, frame, local, memory, primitive, push,
; epilogue, decoded-region, and exclusive-census checks for p25/p31/p32 and
; p55/p57/p58/p61.  Every component consumes the same independently decoded
; source/artifact tables in this process.

expression_family_shape_init:
        imm r20, 540000
        imm r21, 1213420099              ; XSRT
        call exact_require_cell
        call expression_leaf_require_shape
        call expression_call_require_shape
        call expression_factor_control_require_shape
        call expression_factor_data_require_shape
        call expression_levels_require_shape
        call expression_gen_expr_require_shape
        imm r1, 540008
        imm r2, 7                       ; exact procedure family cardinality
        store r1, r2
        imm r20, 540008
        imm r21, 7
        call exact_require_cell
        imm r1, 540024
        imm r2, 1213417541              ; XSHL
        store r1, r2
        imm r20, 540024
        imm r21, 1213417541
        call exact_require_cell
        jmp scan_owned_effects_init
