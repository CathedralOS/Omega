        ; STRB consumes the normalized cursor, appends B, and returns m.
        imm r22, 0
        imm r23, 27                   ; emit_str_body procedure identity
        call gen_emit_require_call
        imm r20, 534848
        imm r21, 1112691795
        call exact_require_cell
        imm r20, 536720
        imm r21, 1
        call exact_require_cell
        imm r1, 536824
