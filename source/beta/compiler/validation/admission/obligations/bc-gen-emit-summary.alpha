; Exact gen_emit summary. NLBL assigns slbl=ell and albl=ell+1, leaving
; LBL=ell+2 modulo 2^64. For STRB trace B and logical length m, append:
;   "jmp " || R(albl) || "\n" || R(slbl) || ":\n" || "db \"" || B
;   || "\"\n" || R(albl) || ":\n" || "imm r0," || R(slbl) || "\n"
;   || "imm r1," || D(m) || "\n" || "call __write_str\n"
; R=LREF, D=full-Word DECW, and the eleven fixed fragments total 48 bytes.
; Expect remains permissive; STRB's exact LEN+1 tail consumes EXPX.
; Every case returns zero and preserves all state except LBL, CUR, and output.
; GEMS=534856; work=536688..<537704.

gen_emit_summary_init:
        imm r1, 534856
        imm r2, 0
        store r1, r2
        call gen_emit_summary_clear
        call gen_emit_require_shape
        call gen_emit_require_imports
        call gen_emit_compose_opening
        call gen_emit_compose_labels
        call gen_emit_compose_output
        call gen_emit_compose_final_expect
        call gen_emit_prove_terminal
        call gen_emit_finalize
        imm r1, 534856
        imm r2, 1397572935
        store r1, r2
        imm r20, 534856
        imm r21, 1397572935
        call exact_require_cell
        jmp emit_cmp_summary_init

gen_emit_summary_clear:
        imm r1, 536688
        imm r2, 0
gen_emit_summary_clear_loop:
        imm r3, 537704
        jlt r1, r3, gen_emit_summary_clear_one
        ret
gen_emit_summary_clear_one:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp gen_emit_summary_clear_loop

gen_emit_require_imports:
        imm r20, 534800
        imm r21, 1163022164
        call exact_require_cell
        imm r20, 525744
        imm r21, 1
        call exact_require_cell
        imm r20, 526216
        imm r21, 1398231888
        call exact_require_cell
        imm r20, 526960
        imm r21, 1397774405
        call exact_require_cell
        imm r20, 534824
        imm r21, 1481660485
        call exact_require_cell
        imm r20, 525816
        imm r21, 1465074514
        call exact_require_cell
        imm r20, 534832
        imm r21, 1279413326
        call exact_require_cell
        imm r20, 534840
        imm r21, 1178948172
        call exact_require_cell
        imm r20, 534848
        imm r21, 1112691795
        call exact_require_cell
        imm r20, 532560
        imm r21, 1464026436
        call exact_require_cell
        imm r20, 536680
        imm r21, 1213416775
        call exact_require_cell
        imm r1, 536688
        imm r2, 1
        store r1, r2
        imm r1, 536696
        imm r2, 9
        store r1, r2
        imm r1, 537080
        imm r2, 1
        store r1, r2
        ret

; The ordinary EXPS theorem covers both match and mismatch for nonzero '('.
; Its normalized cursor remains <=LEN, so the explicit following SWSQ call is
; also total and leaves a valid STRB entry.  Neither call validates syntax.
gen_emit_compose_opening:
        imm r20, 382
        imm r21, 146
        imm r22, 1
        imm r23, 40
        call exact_primitive_identity_pc
        imm r20, 299
        imm r21, 146
        call exact_require_argument_push_identity
        imm r22, 1
        imm r23, 24                   ; expect procedure identity
        imm r24, 0
        imm r25, 2
        call gen_emit_require_nth_call
        imm r20, 526960
        imm r21, 1397774405
        call exact_require_cell
        imm r1, 536704
        imm r2, 1
        store r1, r2
        imm r1, 536712
        store r1, r2

        imm r22, 0
        imm r23, 10                   ; skip_ws procedure identity
        call gen_emit_require_call
        imm r20, 526216
        imm r21, 1398231888
        call exact_require_cell
        imm r20, 536712
        imm r21, 1
        call exact_require_cell
        imm r1, 536720
        imm r2, 1
        store r1, r2
        imm r1, 536960
        store r1, r2
        ret

; NLBL is a modular Word relation, not a natural freshness theorem.  The two
; symbolic custody tags below denote source roles, not unequal numeric values.
gen_emit_compose_labels:
        imm r20, 536720
        imm r21, 1
        call exact_require_cell
        imm r20, 534832
        imm r21, 1279413326
        call exact_require_cell
        imm r1, 536728
        imm r2, 1
        store r1, r2

        imm r22, 0
        imm r23, 1                    ; first new_label occurrence
        imm r24, 0
        imm r25, 2
        call gen_emit_require_nth_call
        imm r20, 44
        imm r21, 146
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r1, 536736
        imm r2, 1
        store r1, r2
        imm r1, 536744
        store r1, r2
        imm r1, 536752
        store r1, r2

        imm r22, 0
        imm r23, 1                    ; second new_label occurrence
        imm r24, 1
        imm r25, 2
        call gen_emit_require_nth_call
        imm r20, 45
        imm r21, 146
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc
        imm r1, 536760
        imm r2, 2
        store r1, r2
        imm r1, 536768
        store r1, r2
        imm r1, 536776
        imm r2, 1
        store r1, r2
        imm r1, 537040
        imm r2, 2
        store r1, r2
        imm r1, 537120
        imm r2, 1
        store r1, r2
        ret

; r20=event row, r21=literal length, r22=expected phase, r23=next phase.
gen_emit_append_fixed:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r20, r30
        call write_str_require_emit_event
        jeq r1, r31, gen_emit_fixed_phase
        jmp reject
gen_emit_fixed_phase:
        imm r1, 536784
        load r2, r1
        jeq r2, r32, gen_emit_fixed_advance
        jmp reject
gen_emit_fixed_advance:
        store r1, r33
        imm r1, 536792
        imm r2, 2
        store r1, r2
        imm r1, 536800
        load r2, r1
        add r2, r31
        store r1, r2
        imm r1, 537072
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        ret

; Rejoin one exact local->argument-push->LREF call. r20..r25 are local row,
; slot, push row, semantic call occurrence, role tag, and phase. The successor
; phase is the current phase plus one.
gen_emit_append_lref:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r50, r24                 ; exact event selection uses r30..r46
        mov r51, r25
        mov r20, r30
        imm r21, 146
        imm r22, 1
        mov r23, r31
        call exact_local_identity_pc
        mov r20, r32
        imm r21, 146
        call exact_require_argument_push_identity
        imm r20, 28
        imm r21, 146
        imm r22, 1
        imm r23, 0
        imm r24, 2                    ; emit_lref procedure identity
        mov r25, r33
        imm r26, 4
        call summary_require_nth_call_fallthrough_identity
        mov r37, r50
        mov r38, r51
        imm r20, 534840
        imm r21, 1178948172
        call exact_require_cell
        imm r1, 536784
        load r2, r1
        jeq r2, r38, gen_emit_lref_role
        jmp reject
gen_emit_lref_role:
        imm r1, 536736
        imm r2, 1
        jeq r37, r2, gen_emit_lref_require_role
        imm r1, 536760
        imm r2, 2
        jeq r37, r2, gen_emit_lref_require_role
        jmp reject
gen_emit_lref_require_role:
        load r2, r1
        jeq r2, r37, gen_emit_lref_advance
        jmp reject
gen_emit_lref_advance:
        imm r1, 536784
        imm r2, 1
        add r38, r2
        store r1, r38
        imm r1, 536808
        load r3, r1
        add r3, r2
        store r1, r3
        imm r1, 536792
        imm r2, 2
        store r1, r2
        ret

gen_emit_compose_output:
        imm r20, 536776
        imm r21, 1
        call exact_require_cell
        imm r1, 536784
        imm r2, 0
        store r1, r2
        imm r1, 536792
        imm r2, 1
        store r1, r2
        imm r1, 536800
        imm r2, 0
        store r1, r2
        imm r1, 536808
        store r1, r2
        imm r1, 537072
        store r1, r2

        imm r20, 202
        imm r21, 4
        imm r22, 0
        imm r23, 1
        call gen_emit_append_fixed

        ; R(albl), first occurrence.
        imm r20, 46
        imm r21, 1
        imm r22, 300
        imm r23, 0
        imm r24, 2
        imm r25, 1
        call gen_emit_append_lref
        imm r1, 537008
        imm r2, 2
        store r1, r2

        imm r20, 204
        imm r21, 1
        imm r22, 2
        imm r23, 3
        call gen_emit_append_fixed

        ; R(slbl), first occurrence.
        imm r20, 47
        imm r21, 0
        imm r22, 301
        imm r23, 1
        imm r24, 1
        imm r25, 3
        call gen_emit_append_lref
        imm r1, 537016
