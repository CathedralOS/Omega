        ; The exact body return m is loaded, staged, and consumed by DECW.
        imm r20, 51
        imm r21, 146
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc
        imm r20, 304
        imm r21, 146
        call exact_require_argument_push_identity
        imm r22, 1
        imm r23, 40                   ; emit_dec procedure identity
        call gen_emit_require_call
        imm r20, 536824
        imm r21, 1
        call exact_require_cell
        imm r20, 532560
        imm r21, 1464026436
        call exact_require_cell
        imm r1, 536864
        imm r2, 1
        store r1, r2
        imm r1, 536872
        store r1, r2
        imm r1, 536984
        store r1, r2
        imm r1, 536784
        imm r2, 15
        store r1, r2
        imm r1, 537056
        imm r2, 1
