; Exact source/artifact shape for emit_state_label (procedure64).
; The canonical procedure inventory owns its total block span and partition.

statement_emit_state_label_require_shape:
        call statement_emit_state_label_require_proc
        imm r20, 316
        imm r21, 316
        imm r22, 64
        call exact_require_proc_blocks
        call statement_emit_state_label_require_events
        call statement_emit_state_label_require_data
        call statement_emit_state_label_require_censuses
        call statement_emit_state_label_require_decoded
        ret

statement_emit_state_label_require_proc:
        imm r20, 64
        imm r21, 2
        imm r22, 2
        imm r23, 24
        call exact_require_proc_frame_identity
        jmp exact_shape_ok

; r24=occurrence,r25=cardinality. Both calls share block/arity/target.
statement_emit_state_label_require_ident_call:
        mov r26, r25
        mov r25, r24
        imm r20, 64                  ; emit_state_label owner
        imm r21, 316
        imm r22, 2
        imm r23, 0
        imm r24, 45                  ; emit_ident_at target
        call summary_require_nth_call_fallthrough_identity
        ret

statement_emit_state_label_require_emit:
        imm r20, 64
        imm r21, 316
        imm r22, statement_emit_state_label_literal_separator
        imm r23, 2
        call exact_unique_emit_event_identity
        mov r14, r0
        mov r10, r1
        call check_emit_at_call
        ret

statement_emit_state_label_require_events:
        imm r24, 0
        imm r25, 2
        call statement_emit_state_label_require_ident_call
        call statement_emit_state_label_require_emit
        imm r24, 1
        imm r25, 2
        call statement_emit_state_label_require_ident_call
        imm r20, 64
        imm r21, 316
        call exact_require_event_epilogue
        imm r20, 65                  ; next procedure owns synthetic epilogue
        call exact_require_preentry_epilogue
        ret

statement_emit_state_label_require_data:
        ; Parameter loads.
        imm r20, 201
        imm r21, 316
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 202
        imm r21, 316
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        ; Current-procedure name offset and length.
        imm r20, 74
        imm r21, 316
        imm r25, 727
        imm r26, 2097096
        call exact_memory_load_pc
        imm r20, 75
        imm r21, 316
        imm r25, 728
        imm r26, 2097088
        call exact_memory_load_pc
        ; Address literal rows727/728 are rejoined to the loads above.
        imm r20, 729
        imm r21, 316
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        ; Two arguments for each emit_ident_at call.
        imm r20, 347
        imm r21, 316
        call exact_require_argument_push_identity
        imm r20, 348
        imm r21, 316
        call exact_require_argument_push_identity
        imm r20, 349
        imm r21, 316
        call exact_require_argument_push_identity
        imm r20, 350
        imm r21, 316
        call exact_require_argument_push_identity
        ret

statement_emit_state_label_require_censuses:
        imm r20, 316
        imm r21, 316
        imm r22, 201
        imm r23, 203
        imm r24, 74
        imm r25, 76
        imm r26, 258
        imm r27, 258
        imm r28, 511
        imm r29, 515
        call exact_require_effect_census
        imm r20, 316
        imm r21, 316
        imm r22, 727
        imm r23, 730
        imm r24, 215
        imm r25, 215
        imm r26, 347
        imm r27, 351
        imm r28, 399
        imm r29, 399
        call summary_require_expr_census
        ret

statement_emit_state_label_require_decoded:
        imm r0, 64
        call exact_proc_entry_pc
        mov r30, r0
        imm r0, 65
        call exact_proc_entry_pc
        mov r21, r0
        mov r20, r30
        imm r22, 3
        imm r23, 2
        imm r24, 7
        call exact_quiet_scan_region
