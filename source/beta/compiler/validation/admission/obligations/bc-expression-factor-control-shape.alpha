; Exact control/effect shape for gen_factor (procedure55).

expression_factor_control_require_shape:
        call expression_factor_require_proc_meta
        call expression_factor_require_blocks
        call expression_factor_require_transitions
        call expression_factor_require_events
        ret

expression_factor_require_proc_meta:
        imm r20, 7151616
        imm r21, 55
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 55
        imm r22, 2
        call transfer_require_cell
        imm r20, 55
        call call_bounds_frame_bytes
        imm r1, 24
        jeq r0, r1, exact_shape_ok
        jmp reject

expression_factor_require_blocks:
        imm r20, 243
        imm r21, 55
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 244
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 245
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 246
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 247
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 248
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 249
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 250
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 251
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 252
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 253
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 254
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 255
        imm r21, 55
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 243
        imm r21, 255
        imm r22, 55
        call exact_require_proc_blocks
        ret

; r20=row,r21=source,r22=guarded,r23=target.
expression_factor_require_transitions:
        imm r20, 186
        imm r21, 244
        imm r22, 1
        imm r23, 245
        call exact_transition_identity_pc
        imm r20, 187
        imm r21, 244
        imm r22, 0
        imm r23, 246
        call exact_transition_identity_pc
        imm r20, 188
        imm r21, 246
        imm r22, 1
        imm r23, 247
        call exact_transition_identity_pc
        imm r20, 189
        imm r21, 246
        imm r22, 0
        imm r23, 253
        call exact_transition_identity_pc
        imm r20, 190
        imm r21, 247
        imm r22, 1
        imm r23, 248
        call exact_transition_identity_pc
        imm r20, 191
        imm r21, 247
        imm r22, 0
        imm r23, 249
        call exact_transition_identity_pc
        imm r20, 192
        imm r21, 249
        imm r22, 1
        imm r23, 250
        call exact_transition_identity_pc
        imm r20, 193
        imm r21, 249
        imm r22, 0
        imm r23, 251
        call exact_transition_identity_pc
        imm r20, 194
        imm r21, 251
        imm r22, 1
        imm r23, 252
        call exact_transition_identity_pc
        imm r20, 195
        imm r21, 253
        imm r22, 1
        imm r23, 254
        call exact_transition_identity_pc
        imm r20, 196
        imm r21, 253
        imm r22, 0
        imm r23, 255
        call exact_transition_identity_pc
        ret

; r21=block,r22=arity,r23=target procedure identity.
expression_factor_require_call:
        mov r24, r23
        imm r23, 0
        imm r20, 55
        call summary_require_call_fallthrough_identity
        ret

; r21=block,r22=literal bytes,r23=decoded length.
expression_factor_require_emit:
        imm r20, 55
        call exact_unique_emit_event_identity
        mov r14, r0
        mov r10, r1
        call check_emit_at_call
        ret

expression_factor_require_return:
        imm r20, 55
        call exact_require_event_epilogue
        ret

expression_factor_require_events:
        ; Entry/parens and identifier classifiers.
        imm r21, 243
        imm r22, 0
        imm r23, 10                   ; skip_ws
        call expression_factor_require_call
        imm r21, 243
        imm r22, 0
        imm r23, 4                    ; cbyte
        call expression_factor_require_call
        imm r21, 245
        imm r22, 0
        imm r23, 5                    ; adv
        call expression_factor_require_call
        imm r21, 245
        imm r22, 0
        imm r23, 61                   ; gen_expr
        call expression_factor_require_call
        imm r21, 245
        imm r22, 1
        imm r23, 24                   ; expect
        call expression_factor_require_call
        imm r21, 245
        call expression_factor_require_return
        imm r21, 246
        imm r22, 1
        imm r23, 7                    ; is_alpha
        call expression_factor_require_call
        imm r21, 247
        imm r22, 0
        imm r23, 12                   ; read_ident
        call expression_factor_require_call
        imm r21, 247
        imm r22, 0
        imm r23, 19                   ; is_byte
        call expression_factor_require_call
        imm r21, 248
        imm r22, 1
        imm r23, 25                   ; gen_load
        call expression_factor_require_call
        imm r21, 248
        call expression_factor_require_return
        imm r21, 249
        imm r22, 0
        imm r23, 20                   ; is_word
        call expression_factor_require_call
        imm r21, 250
        imm r22, 1
        imm r23, 25                   ; gen_load
        call expression_factor_require_call
        imm r21, 250
        call expression_factor_require_return
        call expression_factor_require_tail_events
        ret

expression_factor_require_tail_events:
        imm r21, 251
        imm r22, 0
        imm r23, 10                   ; skip_ws
        call expression_factor_require_call
        imm r21, 251
        imm r22, 0
        imm r23, 4                    ; cbyte
        call expression_factor_require_call
        imm r21, 251
        imm r22, 1
        imm r23, 51                   ; emit_load_slot
        call expression_factor_require_call
        imm r21, 251
        imm r22, 0
        imm r23, 36                   ; lookup
        call expression_factor_require_call
        imm r21, 251
        call expression_factor_require_return
        imm r21, 252
        imm r22, 0
        imm r23, 32                   ; gen_call
        call expression_factor_require_call
        imm r21, 252
        call expression_factor_require_return
        imm r21, 254
        imm r22, expression_factor_control_literal_imm_r0_prefix
        imm r23, 7
        call expression_factor_require_emit
        imm r21, 254
        imm r22, 1
        imm r23, 40                   ; emit_dec
        call expression_factor_require_call
        imm r21, 254
        imm r22, 0
        imm r23, 56                   ; parse_char
        call expression_factor_require_call
        imm r21, 254
        imm r22, expression_factor_control_literal_newline
        imm r23, 1
        call expression_factor_require_emit
        imm r21, 254
        call expression_factor_require_return
        imm r21, 255
        imm r22, 0
        imm r23, 33                   ; parse_number
        call expression_factor_require_call
        imm r21, 255
        imm r22, expression_factor_control_literal_imm_r0_prefix
        imm r23, 7
        call expression_factor_require_emit
        imm r21, 255
        imm r22, 1
        imm r23, 40                   ; emit_dec
        call expression_factor_require_call
        imm r21, 255
        imm r22, expression_factor_control_literal_newline
        imm r23, 1
        call expression_factor_require_emit
        imm r21, 255
        call expression_factor_require_return
        call expression_factor_require_epilogues
        ret

expression_factor_require_epilogues:
        ; Explicit epilogues are owned with return identities above.
        imm r20, 56                   ; parse_char identifies synthetic return
        call exact_require_preentry_epilogue
        ret

expression_factor_control_literal_imm_r0_prefix:
        db "imm r0,"
expression_factor_control_literal_newline:
        db "\n"
