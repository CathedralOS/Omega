; Exact shape for the structurally identical gen_term/gen_sum loops (p57/p58).
; The canonical procedure inventory owns both total block spans and partitions.

expression_levels_require_shape:
        call expression_levels_require_proc_meta
        imm r20, 267
        imm r21, 269
        imm r22, 57
        call exact_require_proc_blocks
        imm r20, 270
        imm r21, 272
        imm r22, 58
        call exact_require_proc_blocks
        call expression_levels_require_transitions
        call expression_levels_require_events
        call expression_levels_require_data
        call expression_levels_require_censuses
        call expression_levels_require_regions
        ret

; r20=procedure,r21=frame bytes.
expression_levels_require_one_proc:
        mov r23, r21
        imm r21, 0
        imm r22, 1                    ; one local operator slot
        call exact_require_proc_frame_identity
        ret

expression_levels_require_proc_meta:
        imm r20, 57
        imm r21, 16
        call expression_levels_require_one_proc
        imm r20, 58
        imm r21, 16
        call expression_levels_require_one_proc
        ret

expression_levels_require_transitions:
        imm r20, 211
        imm r21, 268
        imm r22, 1
        imm r23, 269
        call exact_transition_identity_pc
        imm r20, 212
        imm r21, 269
        imm r22, 0
        imm r23, 268
        call exact_transition_identity_pc
        imm r20, 213
        imm r21, 271
        imm r22, 1
        imm r23, 272
        call exact_transition_identity_pc
        imm r20, 214
        imm r21, 272
        imm r22, 0
        imm r23, 271
        call exact_transition_identity_pc
        ret

; r20=procedure,r21=block,r22=arity,r23=target procedure identity.
expression_levels_require_call:
        mov r24, r23
        imm r23, 0
        call summary_require_call_fallthrough_identity
        ret

expression_levels_require_return:
        call exact_require_event_epilogue
        ret

expression_levels_require_events:
        ; gen_term.
        imm r20, 57
        imm r21, 267
        imm r22, 0
        imm r23, 55
        call expression_levels_require_call
        imm r20, 57
        imm r21, 267
        imm r22, 0
        imm r23, 10
        call expression_levels_require_call
        imm r20, 57
        imm r21, 268
        imm r22, 1
        imm r23, 53
        call expression_levels_require_call
        imm r20, 57
        imm r21, 268
        imm r22, 0
        imm r23, 4
        call expression_levels_require_call
        imm r20, 57
        imm r21, 268
        call expression_levels_require_return
        imm r20, 57
        imm r21, 269
        imm r22, 0
        imm r23, 4
        call expression_levels_require_call
        imm r20, 57
        imm r21, 269
        imm r22, 0
        imm r23, 5
        call expression_levels_require_call
        imm r20, 57
        imm r21, 269
        imm r22, 0
        imm r23, 47
        call expression_levels_require_call
        imm r20, 57
        imm r21, 269
        imm r22, 0
        imm r23, 55
        call expression_levels_require_call
        imm r20, 57
        imm r21, 269
        imm r22, 1
        imm r23, 49
        call expression_levels_require_call
        imm r20, 57
        imm r21, 269
        imm r22, 0
        imm r23, 10
        call expression_levels_require_call
        call expression_levels_require_sum_events
        ret

expression_levels_require_sum_events:
        imm r20, 58
        imm r21, 270
        imm r22, 0
        imm r23, 57
        call expression_levels_require_call
        imm r20, 58
        imm r21, 270
        imm r22, 0
        imm r23, 10
        call expression_levels_require_call
        imm r20, 58
        imm r21, 271
        imm r22, 1
        imm r23, 54
        call expression_levels_require_call
        imm r20, 58
        imm r21, 271
        imm r22, 0
        imm r23, 4
        call expression_levels_require_call
        imm r20, 58
        imm r21, 271
        call expression_levels_require_return
        imm r20, 58
        imm r21, 272
        imm r22, 0
        imm r23, 4
        call expression_levels_require_call
        imm r20, 58
        imm r21, 272
        imm r22, 0
        imm r23, 5
        call expression_levels_require_call
        imm r20, 58
        imm r21, 272
        imm r22, 0
        imm r23, 47
        call expression_levels_require_call
        imm r20, 58
        imm r21, 272
        imm r22, 0
        imm r23, 57
        call expression_levels_require_call
        imm r20, 58
        imm r21, 272
        imm r22, 1
        imm r23, 49
        call expression_levels_require_call
        imm r20, 58
        imm r21, 272
        imm r22, 0
        imm r23, 10
        call expression_levels_require_call
        ; Explicit loop exits and compiler-added fallthroughs.
        imm r20, 58
        call exact_require_preentry_epilogue
        imm r20, 59
        call exact_require_preentry_epilogue
        ret

expression_levels_require_data:
        ; Loop operator slots.
        imm r20, 167
        imm r21, 269
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 168
        imm r21, 269
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 169
        imm r21, 272
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 170
        imm r21, 272
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        ; Guard results and explicit zero returns.
        imm r20, 622
        imm r21, 268
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 623
        imm r21, 268
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 624
        imm r21, 268
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 625
        imm r21, 271
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 626
        imm r21, 271
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 627
        imm r21, 271
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        ; One classifier operand and two ordinary arguments per loop.
        imm r20, 183
        imm r21, 268
        call exact_require_binary_push_identity
        imm r20, 184
        imm r21, 271
        call exact_require_binary_push_identity
        imm r20, 337
        imm r21, 268
        call exact_require_argument_push_identity
        imm r20, 338
        imm r21, 269
        call exact_require_argument_push_identity
        imm r20, 339
        imm r21, 271
        call exact_require_argument_push_identity
        imm r20, 340
        imm r21, 272
        call exact_require_argument_push_identity
        ret

expression_levels_require_censuses:
        imm r20, 267
        imm r21, 269
        imm r22, 167
        imm r23, 169
        imm r24, 55
        imm r25, 55
        imm r26, 211
        imm r27, 213
        imm r28, 421
        imm r29, 432
        call exact_require_effect_census
        imm r20, 267
        imm r21, 269
        imm r22, 622
        imm r23, 625
        imm r24, 183
        imm r25, 184
        imm r26, 337
        imm r27, 339
        imm r28, 389
        imm r29, 389
        call summary_require_expr_census
        imm r20, 270
        imm r21, 272
        imm r22, 169
        imm r23, 171
        imm r24, 55
        imm r25, 55
        imm r26, 213
        imm r27, 215
        imm r28, 432
        imm r29, 443
        call exact_require_effect_census
        imm r20, 270
        imm r21, 272
        imm r22, 625
        imm r23, 628
        imm r24, 184
        imm r25, 185
        imm r26, 339
        imm r27, 341
        imm r28, 389
        imm r29, 389
        call summary_require_expr_census
        ret

expression_levels_require_regions:
        imm r20, 57                    ; gen_term procedure identity
        call exact_proc_entry_r20
        imm r21, 58                    ; gen_sum procedure identity / end
        call exact_proc_entry_r21
        imm r22, 10
        imm r23, 2
        imm r24, 5
        call exact_quiet_scan_region
        imm r20, 58                    ; gen_sum procedure identity
        call exact_proc_entry_r20
        imm r21, 59                    ; cmp_op procedure identity / end
        call exact_proc_entry_r21
        imm r22, 10
        imm r23, 2
        imm r24, 5
        call exact_quiet_scan_region
        ret
