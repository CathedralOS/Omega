; Exact effect/data shape and decoded census for emit_cmp(code), procedure60.

emit_cmp_require_data_shape:
        call emit_cmp_require_events
        call emit_cmp_require_locals
        call emit_cmp_require_primitives
        call emit_cmp_require_pushes
        call emit_cmp_require_censuses
        call emit_cmp_require_epilogues
        call emit_cmp_require_decoded
        ret

; r20=semantic row, r21=block, r22=literal bytes, r23=decoded length.
emit_cmp_require_fixed_event:
        mov r50, r20
        imm r20, 60                    ; emit_cmp owning procedure
        call exact_unique_emit_event_identity
        jeq r1, r50, emit_cmp_fixed_event_row_ok
        jmp reject
emit_cmp_fixed_event_row_ok:
        mov r14, r0
        mov r10, r1
        call check_emit_at_call
        ret

; r21=block, r22=arity, r23=target procedure identity.
emit_cmp_require_call_event:
        mov r24, r23
        imm r23, 0                    ; no ambient staged word at call
        imm r20, 60
        call summary_require_call_fallthrough_identity
        ret

; As above, with occurrence/cardinality in r24/r25 for repeated complete keys.
emit_cmp_require_nth_call_event:
        mov r26, r25
        mov r25, r24
        mov r24, r23
        imm r23, 0
        imm r20, 60
        call summary_require_nth_call_fallthrough_identity
        ret

emit_cmp_require_events:
        ; Fixed stack-pop text and the two label allocations.
        imm r20, 463
        imm r21, 285
        imm r22, emit_cmp_literal_mov_right
        imm r23, 10
        call emit_cmp_require_fixed_event
        imm r20, 464
        imm r21, 285
        imm r22, emit_cmp_literal_load_left
        imm r23, 12
        call emit_cmp_require_fixed_event
        imm r20, 465
        imm r21, 285
        imm r22, emit_cmp_literal_empty
        imm r23, 0
        call emit_cmp_require_fixed_event
        imm r20, 466
        imm r21, 285
        imm r22, emit_cmp_literal_pop_left
        imm r23, 12
        call emit_cmp_require_fixed_event
        imm r21, 285
        imm r22, 0
        imm r23, 1                    ; new_label procedure
        imm r24, 0
        imm r25, 2
        call emit_cmp_require_nth_call_event
        imm r21, 285
        imm r22, 0
        imm r23, 1
        imm r24, 1
        imm r25, 2
        call emit_cmp_require_nth_call_event

        ; The six exact comparison-opcode spellings.
        imm r20, 469
        imm r21, 287
        imm r22, emit_cmp_literal_jlt_r0_r1
        imm r23, 10
        call emit_cmp_require_fixed_event
        imm r20, 470
        imm r21, 289
        imm r22, emit_cmp_literal_jlt_r1_r0
        imm r23, 10
        call emit_cmp_require_fixed_event
        imm r20, 471
        imm r21, 291
        imm r22, emit_cmp_literal_jeq_r0_r1
        imm r23, 10
        call emit_cmp_require_fixed_event
        imm r20, 472
        imm r21, 293
        imm r22, emit_cmp_literal_jeq_r0_r1
        imm r23, 10
        call emit_cmp_require_fixed_event
        imm r20, 473
        imm r21, 295
        imm r22, emit_cmp_literal_jlt_r1_r0
        imm r23, 10
        call emit_cmp_require_fixed_event
        imm r20, 474
        imm r21, 297
        imm r22, emit_cmp_literal_jlt_r0_r1
        imm r23, 10
        call emit_cmp_require_fixed_event

        ; set label, newline, and fall-through materialization.
        imm r21, 298
        imm r22, 1
        imm r23, 2                    ; emit_lref procedure
        call emit_cmp_require_call_event
        imm r20, 476
        imm r21, 298
        imm r22, emit_cmp_literal_newline
        imm r23, 1
        call emit_cmp_require_fixed_event
        imm r20, 477
        imm r21, 298
        imm r22, emit_cmp_literal_one
        imm r23, 9
        call emit_cmp_require_fixed_event
        imm r20, 478
        imm r21, 299
        imm r22, emit_cmp_literal_zero
        imm r23, 9
        call emit_cmp_require_fixed_event

        ; Jump, done/set labels, and branch-taken materialization.
        imm r20, 479
        imm r21, 300
        imm r22, emit_cmp_literal_jump
        imm r23, 4
        call emit_cmp_require_fixed_event
        imm r21, 300
        imm r22, 1
        imm r23, 2
        imm r24, 0
        imm r25, 2
        call emit_cmp_require_nth_call_event
        imm r20, 481
        imm r21, 300
        imm r22, emit_cmp_literal_newline
        imm r23, 1
        call emit_cmp_require_fixed_event
        imm r21, 300
        imm r22, 1
        imm r23, 2
        imm r24, 1
        imm r25, 2
        call emit_cmp_require_nth_call_event
        imm r20, 483
        imm r21, 300
        imm r22, emit_cmp_literal_colon_newline
        imm r23, 2
        call emit_cmp_require_fixed_event
        imm r20, 484
        imm r21, 300
        imm r22, emit_cmp_literal_zero
        imm r23, 9
        call emit_cmp_require_fixed_event
        imm r20, 485
        imm r21, 301
        imm r22, emit_cmp_literal_one
        imm r23, 9
        call emit_cmp_require_fixed_event

        ; Final repeated done label and explicit return.
        imm r21, 302
        imm r22, 1
        imm r23, 2
        call emit_cmp_require_call_event
        imm r20, 487
        imm r21, 302
        imm r22, emit_cmp_literal_colon_newline
        imm r23, 2
        call emit_cmp_require_fixed_event
        imm r20, 60
        imm r21, 302
        call exact_require_event_epilogue
        ret

emit_cmp_require_locals:
        ; set/done stores, six code tests, and the two repeated signed splits.
        imm r20, 178
        imm r21, 285
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 179
        imm r21, 285
        imm r22, 2
        imm r23, 2
        call exact_local_identity_pc
        imm r20, 180
        imm r21, 286
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 181
        imm r21, 288
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 182
        imm r21, 290
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 183
        imm r21, 292
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 184
        imm r21, 294
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 185
        imm r21, 296
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 186
        imm r21, 298
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 187
        imm r21, 298
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 188
        imm r21, 300
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc
        imm r20, 189
        imm r21, 300
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 190
        imm r21, 300
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 191
        imm r21, 302
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc
        ret

; Exact comparison/literal rows. Comparison opcode10 is ==; opcode8 is signed <.
emit_cmp_require_primitives:
        imm r20, 656
        imm r21, 286
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 657
        imm r21, 286
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 658
        imm r21, 288
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 659
        imm r21, 288
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 660
        imm r21, 290
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 661
        imm r21, 290
        imm r22, 1
        imm r23, 2
        call exact_primitive_identity_pc
        imm r20, 662
        imm r21, 292
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 663
        imm r21, 292
        imm r22, 1
        imm r23, 3
        call exact_primitive_identity_pc
        imm r20, 664
        imm r21, 294
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 665
        imm r21, 294
        imm r22, 1
        imm r23, 4
        call exact_primitive_identity_pc
        imm r20, 666
        imm r21, 296
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 667
        imm r21, 296
        imm r22, 1
        imm r23, 5
        call exact_primitive_identity_pc
        imm r20, 668
        imm r21, 298
        imm r22, 3
        imm r23, 8
        call exact_primitive_identity_pc
        imm r20, 669
        imm r21, 298
        imm r22, 1
        imm r23, 3
        call exact_primitive_identity_pc
        imm r20, 670
        imm r21, 300
        imm r22, 3
        imm r23, 8
        call exact_primitive_identity_pc
        imm r20, 671
        imm r21, 300
        imm r22, 1
        imm r23, 3
        call exact_primitive_identity_pc
        imm r20, 672
        imm r21, 302
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        ret

emit_cmp_require_pushes:
        ; Eight binary-left pushes: six equality tests and two signed tests.
        imm r20, 194
        imm r21, 286
        call exact_require_binary_push_identity
        imm r20, 195
        imm r21, 288
        call exact_require_binary_push_identity
        imm r20, 196
        imm r21, 290
        call exact_require_binary_push_identity
        imm r20, 197
        imm r21, 292
        call exact_require_binary_push_identity
        imm r20, 198
        imm r21, 294
        call exact_require_binary_push_identity
        imm r20, 199
        imm r21, 296
        call exact_require_binary_push_identity
        imm r20, 200
        imm r21, 298
        call exact_require_binary_push_identity
        imm r20, 201
        imm r21, 300
        call exact_require_binary_push_identity

        ; Four exact one-argument emit_lref handoffs.
        imm r20, 341
        imm r21, 298
        call exact_require_argument_push_identity
        imm r20, 342
        imm r21, 300
        call exact_require_argument_push_identity
        imm r20, 343
        imm r21, 300
        call exact_require_argument_push_identity
        imm r20, 344
        imm r21, 302
        call exact_require_argument_push_identity
        ret

emit_cmp_require_censuses:
        imm r20, 285
        imm r21, 302
        imm r22, 178
        imm r23, 192
        imm r24, 57
        imm r25, 57                  ; no raw-memory source rows
        imm r26, 225
        imm r27, 249
        imm r28, 463
        imm r29, 489
        call exact_require_effect_census
        imm r20, 285
        imm r21, 302
        imm r22, 656
        imm r23, 673
        imm r24, 194
        imm r25, 202
        imm r26, 341
        imm r27, 345
        imm r28, 389
        imm r29, 389                 ; no store-address pushes
        call summary_require_expr_census
        ret

emit_cmp_require_epilogues:
        ; The explicit block302 return is owned alongside its event above.
        imm r20, 61                    ; next procedure owns synthetic return
        call exact_require_preentry_epilogue
        ret

emit_cmp_require_decoded:
        imm r20, 60                    ; emit_cmp procedure identity
        call exact_proc_entry_r20
        imm r21, 61                    ; gen_expr procedure identity
        call exact_proc_entry_r21
        imm r22, 25                   ; 19 fixed emits + 2 new_label + 4 lref
        imm r23, 2                    ; explicit and synthetic returns
        imm r24, 16                   ; exact owned-stack/local stores
        call exact_quiet_scan_region
        ret

emit_cmp_literal_mov_right:
        db "mov r1,r0\n"
emit_cmp_literal_load_left:
        db "load r0,r15\n"
emit_cmp_literal_empty:
emit_cmp_literal_pop_left:
        db "add r15,r13\n"
emit_cmp_literal_jlt_r0_r1:
        db "jlt r0,r1,"
emit_cmp_literal_jlt_r1_r0:
        db "jlt r1,r0,"
emit_cmp_literal_jeq_r0_r1:
        db "jeq r0,r1,"
emit_cmp_literal_newline:
        db "\n"
emit_cmp_literal_one:
        db "imm r0,1\n"
emit_cmp_literal_zero:
        db "imm r0,0\n"
emit_cmp_literal_jump:
        db "jmp "
emit_cmp_literal_colon_newline:
        db ":\n"
