; Exact p68 entry shape through the entry of its parameter-loop block. This
; binds every selected row and exhausts every effect family in that prefix.

parse_proc_shape_init:
        call parse_proc_require_proc
        call parse_proc_require_entry_block
        call parse_proc_require_entry_calls
        call parse_proc_require_entry_locals
        call parse_proc_require_entry_memory
        call parse_proc_require_entry_primitives
        call parse_proc_require_entry_pushes
        call parse_proc_require_entry_censuses
        call parse_proc_require_entry_decoded
        imm r1, 606016
        imm r2, 1213416784             ; PESH
        store r1, r2
        jmp parse_proc_entry_semantics_init

parse_proc_require_proc:
        imm r20, 68
        imm r21, 0
        imm r22, 5
        imm r23, 48
        call exact_require_proc_frame_identity
        jmp exact_shape_ok

parse_proc_require_entry_block:
        imm r20, 338
        imm r21, 68                    ; parse_proc procedure identity
        imm r22, 0
        call exact_block_identity_pc
        ret

; Source block/arity/target procedure in r21..r23.
parse_proc_require_entry_call:
        mov r24, r23
        imm r23, 0
        imm r20, 68                    ; parse_proc owning procedure identity
        call summary_require_call_fallthrough_identity
        ret

; As above, with occurrence/cardinality in r24/r25 for a repeated complete key.
parse_proc_require_entry_nth_call:
        mov r26, r25
        mov r25, r24
        mov r24, r23
        imm r23, 0
        imm r20, 68                    ; parse_proc owning procedure identity
        call summary_require_nth_call_fallthrough_identity
        ret

parse_proc_require_entry_calls:
        imm r21, 338
        imm r22, 0
        imm r23, 10                    ; first skip_ws
        imm r24, 0
        imm r25, 3
        call parse_proc_require_entry_nth_call
        imm r21, 338
        imm r22, 0
        imm r23, 12                    ; first read_ident
        imm r24, 0
        imm r25, 2
        call parse_proc_require_entry_nth_call
        imm r21, 338
        imm r22, 0
        imm r23, 10                    ; second skip_ws
        imm r24, 1
        imm r25, 3
        call parse_proc_require_entry_nth_call
        imm r21, 338
        imm r22, 0
        imm r23, 12                    ; second read_ident
        imm r24, 1
        imm r25, 2
        call parse_proc_require_entry_nth_call
        imm r21, 338
        imm r22, 1
        imm r23, 24                    ; expect
        call parse_proc_require_entry_call
        imm r21, 338
        imm r22, 0
        imm r23, 10                    ; third skip_ws
        imm r24, 2
        imm r25, 3
        call parse_proc_require_entry_nth_call
        ret

parse_proc_require_entry_locals:
        imm r20, 223
        imm r21, 338
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 224
        imm r21, 338
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 225
        imm r21, 338
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 226
        imm r21, 338
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        ret

parse_proc_require_entry_memory:
        imm r20, 83
        imm r21, 338
        call exact_memory_store_pc    ; NLOC = 0
        imm r20, 84
        imm r21, 338
        imm r25, 774
        imm r26, 2097120             ; IDOFF snapshot
        call exact_memory_load_pc
        imm r20, 85
        imm r21, 338
        imm r25, 775
        imm r26, 2097112             ; IDLEN snapshot
        call exact_memory_load_pc
        imm r20, 86
        imm r21, 338
        call exact_memory_store_pc    ; CURPROC name offset
        imm r20, 87
        imm r21, 338
        call exact_memory_store_pc    ; CURPROC name length
        ret

parse_proc_require_entry_primitives:
        imm r20, 772
        imm r21, 338
        imm r22, 1
        imm r23, 2097128
        call exact_primitive_identity_pc
        imm r20, 773
        imm r21, 338
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 774
        imm r21, 338
        imm r22, 1
        imm r23, 2097120
        call exact_primitive_identity_pc
        imm r20, 775
        imm r21, 338
        imm r22, 1
        imm r23, 2097112
        call exact_primitive_identity_pc
        imm r20, 776
        imm r21, 338
        imm r22, 1
        imm r23, 2097096
        call exact_primitive_identity_pc
        imm r20, 777
        imm r21, 338
        imm r22, 1
        imm r23, 2097088
        call exact_primitive_identity_pc
        imm r20, 778
        imm r21, 338
        imm r22, 1
        imm r23, 40
        call exact_primitive_identity_pc
        ret

parse_proc_require_entry_pushes:
        imm r20, 365
        imm r21, 338
        call exact_require_argument_push_identity
        imm r20, 400
        imm r21, 338
        call exact_require_store_push_identity
        imm r20, 401
        imm r21, 338
        call exact_require_store_push_identity
        imm r20, 402
        imm r21, 338
        call exact_require_store_push_identity
        ret

parse_proc_require_entry_censuses:
        imm r20, 338
        imm r21, 338
        imm r22, 223
        imm r23, 227
        imm r24, 83
        imm r25, 88
        imm r26, 274
        imm r27, 274
        imm r28, 577
        imm r29, 583
        call exact_require_effect_census
        imm r20, 338
        imm r21, 338
        imm r22, 772
        imm r23, 779
        imm r24, 224
        imm r25, 224
        imm r26, 365
        imm r27, 366
        imm r28, 400
        imm r29, 403
        call summary_require_expr_census
        ret

parse_proc_require_entry_decoded:
        imm r20, 339
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        mov r21, r0                    ; p68 parameter-slice cutpoint
        imm r20, 68                    ; parse_proc procedure identity
        call exact_proc_entry_r20
        imm r22, 6
        imm r23, 0
        imm r24, 10
        call exact_quiet_scan_region
        ret
