; Conditional exact-output summaries for the eight bounded emitter leaves.
;
; GRDB composes permissive EXPS('(') then EXPS(')') and appends "read r0\n".
; EPOP covers 0<=k<4. EPUS is the fixed data-stack push fragment. EMNE is
; total over Word: the five operator Words append their three-byte mnemonic and
; the full-Word complement appends nothing. ECMB places EMNE between its fixed
; prefix and suffix. ESLA covers reg in {0,1}, 0<=slot<1024, and the exact
; nonwrapping offset 8+8*slot<=8192. ELDS/ESTS instantiate ESLA at reg zero/one.
;
; Every clause extends an arbitrary prior trace, preserves source/input and all
; persistent compiler state (GRDB carries EXPS's exact CUR outcome), and
; restores the caller r15/r14 pair. Only GRDB and EMNE claim result zero. The
; six source-fallthrough emitters deliberately leave their artifact result
; unclaimed; their callers must prove it dead. No full-word emit_dec fact is
; imported: every decimal child is inside DECS's 0..8192 domain.
;
; Checker-C private cells (continuations end at 531872):
;   public GRDB/EPOP/EPUS/EMNE/ECMB/ESLA/ELDS/ESTS 531880..531936
;   imports/domain/k-count/pair-count                    531944..531968
;   phase/trace/quiet/frame/result/child/order/cursor    531976..532032
;   branch/fixed bytes and case completions              532040..532112
;   family/selected k,reg,slot,offset/arithmetic          532120..532160
;   delimiter/mnemonic counts, saved child, domain        532168..532192
;   complement/dead-result/final-cursor/max-bound         532200..532224
;   decimal argument / op and call-handoff provenance    532240..532288
;   ESLA reg clauses and per-instance provenance         532296..532360
;   wrapper same-slot provenance / parameterized EMNE    532368..532392
;   ordered GRDB calls/cursors and EMNE guard provenance  532400..532496
; Next fresh cell: 532504.

bounded_emitters_summary_init:
        call bounded_emitters_require_shape
        call bounded_emitters_reset_public
        call bounded_emitters_require_imports
        call bounded_emitters_sweep_domains
        call bounded_prove_gen_read_byte
        call bounded_prove_emit_pop_into
        call bounded_prove_emit_push
        call bounded_prove_emit_mnemonic
        call bounded_prove_emit_combine
        call bounded_prove_emit_slot_addr
        call bounded_prove_emit_load_slot
        call bounded_prove_emit_store_slot
        call bounded_emitters_publish_family
        jmp scan_owned_effects_init

bounded_emitters_require_imports:
        imm r20, 531872
        imm r21, 1161966148            ; D2BE
        call exact_require_cell
        imm r20, 525816
        imm r21, 1465074514            ; WSTR
        call exact_require_cell
        imm r20, 526960
        imm r21, 1397774405            ; EXPS
        call exact_require_cell
        imm r20, 528320
        imm r21, 1396917572            ; DECS
        call exact_require_cell
        imm r1, 531944
        imm r2, 1
        store r1, r2
        ret

bounded_emitters_reset_public:
        imm r1, 531880
        imm r2, 0
bounded_emitters_reset_public_loop:
        imm r3, 532504
        jlt r1, r3, bounded_emitters_reset_public_cell
        ret
bounded_emitters_reset_public_cell:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp bounded_emitters_reset_public_loop

; Exhaust exactly k=0..3 and both reg values paired with slot=0..1023. Besides
; proving every DECS child in range, the final endpoint check pins 8192 itself.
bounded_emitters_sweep_domains:
        imm r10, 0
        imm r11, 0
bounded_emitters_k_loop:
        imm r1, 4                    ; exact k-domain endpoint
        jlt r10, r1, bounded_emitters_k_row
        imm r1, 4
        jeq r11, r1, bounded_emitters_pair_init
        jmp reject
bounded_emitters_k_row:
        imm r1, 0
        jlt r10, r1, reject
        imm r1, 8193
        jlt r10, r1, bounded_emitters_k_next
        jmp reject
bounded_emitters_k_next:
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp bounded_emitters_k_loop

bounded_emitters_pair_init:
        imm r1, 531960
        store r1, r11                  ; exact four k rows
        imm r10, 0                     ; reg
        imm r11, 0                     ; slot
        imm r12, 0                     ; pair count
bounded_emitters_reg_loop:
        imm r1, 2
        jlt r10, r1, bounded_emitters_slot_loop
        imm r1, 2048                 ; exact reg/slot pair count
        jeq r12, r1, bounded_emitters_domain_endpoint
        jmp reject
bounded_emitters_slot_loop:
        imm r1, 1024
        jlt r11, r1, bounded_emitters_slot_row
        imm r1, 1
        add r10, r1
        imm r11, 0
        jmp bounded_emitters_reg_loop
bounded_emitters_slot_row:
        mov r13, r11
        imm r1, 8
        mul r13, r1
        add r13, r1                   ; exact bounded slot offset
        imm r1, 8193
        jlt r13, r1, bounded_emitters_slot_next
        jmp reject
bounded_emitters_slot_next:
        imm r1, 1
        add r11, r1
        add r12, r1
        jmp bounded_emitters_slot_loop
bounded_emitters_domain_endpoint:
        imm r1, 531968
        store r1, r12                  ; exact 2*1024 pairs
        imm r10, 1023
        imm r1, 8
        mul r10, r1
        add r10, r1
        imm r1, 8192                 ; exact maximum bounded offset
        jeq r10, r1, bounded_emitters_domain_publish
        jmp reject
bounded_emitters_domain_publish:
        imm r1, 532224
        store r1, r10                  ; exact maximum decimal child
        imm r1, 532160
        imm r2, 1
        store r1, r2                   ; nonwrapping offset arithmetic
        imm r1, 532192
        store r1, r2                   ; bounded premise
        imm r1, 531952
        store r1, r2
        ret

bounded_reset_case:
        imm r1, 531976
        imm r2, 0
        store r1, r2                   ; phase
        imm r1, 531984
        imm r2, 1
        store r1, r2                   ; arbitrary prior trace
        imm r1, 531992
        store r1, r2                   ; persistent state quiet
        imm r1, 532000
        imm r2, 0
        store r1, r2                   ; caller frame not yet discharged
        imm r1, 532008
        store r1, r2                   ; result not yet classified
        imm r1, 532016
        store r1, r2                   ; decimal/semantic child
        imm r1, 532024
        store r1, r2                   ; child ordering
        imm r1, 532032
        store r1, r2                   ; cursor chain
        imm r1, 532040
        store r1, r2                   ; branch
        imm r1, 532048
        store r1, r2                   ; accumulated fixed bytes
        imm r1, 532208
        store r1, r2                   ; dead-result fact
        imm r1, 532216
        store r1, r2                   ; final cursor relation
        imm r1, 532240
bounded_reset_provenance_loop:
        imm r3, 532296                 ; leave universal publications separate
        jlt r1, r3, bounded_reset_provenance_cell
        imm r1, 532312
bounded_reset_esla_instance_loop:
        imm r3, 532392
        jlt r1, r3, bounded_reset_esla_instance_cell
        imm r1, 532400
bounded_reset_late_provenance_loop:
        imm r3, 532504
        jlt r1, r3, bounded_reset_late_provenance_cell
        ret
bounded_reset_provenance_cell:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp bounded_reset_provenance_loop
bounded_reset_esla_instance_cell:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp bounded_reset_esla_instance_loop
bounded_reset_late_provenance_cell:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp bounded_reset_late_provenance_loop

; Append exact fixed event r20/length r21 at phase r22, advancing to r23.
bounded_append_fixed:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r20, r30
        call write_str_require_emit_event
        jeq r1, r31, bounded_append_fixed_phase
        jmp reject
bounded_append_fixed_phase:
        imm r1, 531976
        load r2, r1
        jeq r2, r32, bounded_append_fixed_trace
        jmp reject
bounded_append_fixed_trace:
        store r1, r33
        imm r1, 531984
        imm r2, 2
        store r1, r2                   ; prior trace || selected output
        imm r1, 532048
        load r2, r1
        add r2, r31
        store r1, r2
        ret

; Consume bounded DECS at the exact selected numeric argument r20 and phase
; r21, advancing to r22. Both the call handoff and child theorem retain that
; value; the local range check prevents widening DECS to arbitrary Word.
bounded_append_decimal:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        imm r20, 531952
        imm r21, 1
        call exact_require_cell
        imm r20, 532192
        imm r21, 1
        call exact_require_cell
        imm r20, 528320
        imm r21, 1396917572
        call exact_require_cell
        imm r1, 0
        jlt r30, r1, reject
        imm r1, 8193
        jlt r30, r1, bounded_append_decimal_value
        jmp reject
bounded_append_decimal_value:
        imm r1, 532240
        store r1, r30                  ; exact caller argument
        imm r20, 532240
        mov r21, r30
        call exact_require_cell
        imm r1, 531976
        load r2, r1
        jeq r2, r31, bounded_append_decimal_phase
        jmp reject
bounded_append_decimal_phase:
        store r1, r32
        imm r1, 532016
        store r1, r30                  ; same value consumed by DECS
        imm r1, 531984
        imm r2, 2
        store r1, r2
        imm r1, 532024
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2                   ; child-before-following-output order
        ret

bounded_finish_restored:
        imm r1, 532000
        imm r2, 1
        store r1, r2
        imm r1, 532208
        store r1, r2                   ; synthetic result is dead/unclaimed
        ret

bounded_require_restored:
        imm r20, 531984
        imm r21, 2
        call exact_require_cell
        imm r20, 531992
        imm r21, 1
        call exact_require_cell
        imm r20, 532000
        imm r21, 1
        call exact_require_cell
        ret

bounded_require_dead_restored:
        call bounded_require_restored
        imm r20, 532208
        imm r21, 1
        call exact_require_cell
        ret

; ---- gen_read_byte ---------------------------------------------------

bounded_prove_gen_read_byte:
        imm r10, 0
        imm r11, 0
bounded_gen_read_case_loop:
        imm r1, 4                    ; first/second expect match bits
        jlt r10, r1, bounded_gen_read_case
        imm r1, 4
        jeq r11, r1, bounded_gen_read_publish
        jmp reject
bounded_gen_read_case:
        call bounded_reset_case
        imm r1, 532040
        store r1, r10                  ; selected pair of exact EXPS outcomes
        imm r1, 532400
        imm r2, 1
        store r1, r2                   ; arbitrary valid entry cursor C0
        imm r1, 532408
        imm r2, 40
        store r1, r2                   ; event233 exact '(' argument
        imm r20, 526960
        imm r21, 1397774405           ; EXPS supplies both match clauses
        call exact_require_cell
        imm r1, 532464
        imm r2, 1
        store r1, r2                   ; first EXPS(C0,'(') instantiated
        mov r12, r10
        imm r2, 2
        mod r12, r2
        imm r2, 1
        add r12, r2                    ; 1=mismatch, 2=match
        imm r1, 532416
        store r1, r12                  ; exact first branch
        imm r1, 532424
        store r1, r12                  ; exact first successor cursor relation
        imm r1, 531976
        store r1, r2                   ; phase one: first call completed

        imm r20, 532424
        mov r21, r12
        call exact_require_cell
        imm r1, 532432
        store r1, r12                  ; second call consumes first successor
        imm r20, 532432
        mov r21, r12
        call exact_require_cell
        imm r1, 532440
        imm r2, 41
        store r1, r2                   ; event234 exact ')' argument
        imm r20, 526960
        imm r21, 1397774405
        call exact_require_cell
        imm r1, 532472
        imm r2, 1
        store r1, r2                   ; second EXPS(C1,')') instantiated
        mov r12, r10
        imm r2, 2
        div r12, r2
        imm r2, 2
        mod r12, r2
        imm r2, 1
        add r12, r2                    ; 1=mismatch, 2=match
        imm r1, 532448
        store r1, r12                  ; exact second branch
        imm r1, 532456
        store r1, r12                  ; exact final cursor relation
        imm r1, 532032
        imm r2, 1
        store r1, r2                   ; checked C0 -> C1 -> C2 chain
        imm r1, 532216
        store r1, r2                   ; exact twice-normalized final CUR
        imm r1, 531976
        imm r2, 2
        store r1, r2                   ; phase two: second call completed
        imm r20, 235
        imm r21, 8                    ; exact read-r0 literal length
        imm r22, 2
        imm r23, 3
        call bounded_append_fixed
        imm r1, 532008
        imm r2, 1
        store r1, r2                   ; explicit return zero
        imm r1, 532000
        store r1, r2                   ; frame restored
        call bounded_require_gen_read
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp bounded_gen_read_case_loop
bounded_gen_read_publish:
        imm r1, 532168
        store r1, r11
        imm r1, 532064
        imm r2, 1
        store r1, r2
        imm r1, 531880
        imm r2, 1111773767            ; GRDB
        store r1, r2
        ret

bounded_require_gen_read:
        imm r20, 532040
        mov r21, r10
        call exact_require_cell
        mov r12, r10
        imm r1, 2
        mod r12, r1
        imm r1, 1
        add r12, r1
        imm r20, 532416
        mov r21, r12
        call exact_require_cell
        imm r20, 532424
        mov r21, r12
        call exact_require_cell
        imm r20, 532432
        mov r21, r12
        call exact_require_cell
        mov r12, r10
        imm r1, 2
        div r12, r1
        mod r12, r1
        imm r1, 1
        add r12, r1
        imm r20, 532448
        mov r21, r12
        call exact_require_cell
        imm r20, 532456
        mov r21, r12
        call exact_require_cell
        imm r20, 532400
        imm r21, 1
        call exact_require_cell
        imm r20, 532408
        imm r21, 40
        call exact_require_cell
        imm r20, 532464
        imm r21, 1
        call exact_require_cell
        imm r20, 532440
        imm r21, 41
        call exact_require_cell
        imm r20, 532472
        imm r21, 1
        call exact_require_cell
        imm r20, 532032
        imm r21, 1
        call exact_require_cell
        imm r20, 532216
        imm r21, 1
        call exact_require_cell
        imm r20, 531976
        imm r21, 3
        call exact_require_cell
        imm r20, 532048
        imm r21, 8
        call exact_require_cell
        imm r20, 532008
        imm r21, 1
        call exact_require_cell
        call bounded_require_restored
        ret

; ---- emit_pop_into / emit_push --------------------------------------

bounded_prove_emit_pop_into:
        imm r10, 0
        imm r11, 0
bounded_pop_loop:
        imm r1, 4
        jlt r10, r1, bounded_pop_case
        imm r1, 4
        jeq r11, r1, bounded_pop_publish
        jmp reject
bounded_pop_case:
        call bounded_reset_case
        imm r1, 532128
        store r1, r10                  ; selected exact k
        imm r20, 334
        imm r21, 6
        imm r22, 0
        imm r23, 1
        call bounded_append_fixed
        imm r1, 532128
        load r20, r1                   ; DECS argument consumes selected-k cell
        imm r21, 1
        imm r22, 2
        call bounded_append_decimal
        imm r20, 532128
        mov r21, r10
        call exact_require_cell         ; consumed exact selected k
        imm r20, 532240
        mov r21, r10
        call exact_require_cell
        imm r20, 532016
        mov r21, r10
        call exact_require_cell
        imm r20, 336
        imm r21, 5
        imm r22, 2
        imm r23, 3
        call bounded_append_fixed
        imm r20, 337
        imm r21, 0
        imm r22, 3
        imm r23, 4
        call bounded_append_fixed
        imm r20, 338
        imm r21, 12
        imm r22, 4
        imm r23, 5
        call bounded_append_fixed
        call bounded_finish_restored
        imm r20, 532048
        imm r21, 23                   ; fixed bytes excluding dec(k)
        call exact_require_cell
        imm r20, 532024
        imm r21, 1
        call exact_require_cell
        call bounded_require_dead_restored
        imm r1, 1
        add r10, r1
        add r11, r1
        jmp bounded_pop_loop
bounded_pop_publish:
        imm r1, 532072
        store r1, r11
        imm r1, 531888
        imm r2, 1347375173            ; EPOP
        store r1, r2
        ret

bounded_prove_emit_push:
        call bounded_reset_case
        imm r20, 346
        imm r21, 0
        imm r22, 0
        imm r23, 1
        call bounded_append_fixed
        imm r20, 347
        imm r21, 12
        imm r22, 1
        imm r23, 2
        call bounded_append_fixed
        imm r20, 348
        imm r21, 13
        imm r22, 2
        imm r23, 3
        call bounded_append_fixed
        call bounded_finish_restored
        imm r20, 532048
        imm r21, 25
        call exact_require_cell
        call bounded_require_dead_restored
        imm r1, 532080
        imm r2, 1
        store r1, r2
        imm r1, 531896
        imm r2, 1398100037            ; EPUS
        store r1, r2
        ret

; ---- emit_mnemonic / emit_combine -----------------------------------
