; Exact source/artifact shape for emit_ident_at(off,len).
;
; This module owns procedure 45's three blocks, two transitions, direct output,
; return/epilogues, three-slot frame, local and indexed-source accesses,
; expression primitives/pushes, and exhaustive decoded/table censuses. The
; adjacent semantic module owns the bounded loop and exact source-slice trace.

emit_ident_require_shape:
        imm r20, 7151616
        imm r21, 45
        imm r22, 2                    ; off,len parameters
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 45
        imm r22, 3                    ; off,len,k slots
        call transfer_require_cell
        imm r20, 45
        call call_bounds_frame_bytes
        imm r1, 32
        jeq r0, r1, emit_ident_shape_blocks
        jmp reject

emit_ident_shape_blocks:
        imm r20, 214
        imm r21, 45
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 215
        imm r21, 45
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 216
        imm r21, 45
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 214
        imm r21, 216
        imm r22, 45
        call exact_require_proc_blocks
        call emit_ident_require_transitions
        call emit_ident_require_events
        call emit_ident_require_locals
        call emit_ident_require_memory
        call emit_ident_require_primitives
        call emit_ident_require_pushes
        call emit_ident_require_censuses
        ret

emit_ident_require_transitions:
        imm r20, 167
        imm r21, 215
        imm r22, 1
        imm r23, 216
        call exact_transition_identity_pc
        imm r20, 168
        imm r21, 216
        imm r22, 0
        imm r23, 215
        call exact_transition_identity_pc
        ret

emit_ident_require_events:
        imm r20, 45                   ; emit_ident_at procedure identity
        imm r21, 215
        call exact_require_event_epilogue
        imm r20, 45
        imm r21, 216
        call exact_unique_write_event_identity
        mov r20, r0
        imm r21, 18                   ; exact direct write opcode
        call require_tape_byte
        imm r20, 46                   ; emit_epilogue identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

emit_ident_require_locals:
        ; Stable rows retain lexical source order while the owner supplies PCs.
        imm r20, 126
        imm r21, 214
        imm r22, 2
        imm r23, 2
        call exact_local_identity_pc
        imm r20, 127
        imm r21, 215
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc
        imm r20, 128
        imm r21, 215
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 129
        imm r21, 216
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 130
        imm r21, 216
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc
        imm r20, 131
        imm r21, 216
        imm r22, 2
        imm r23, 2
        call exact_local_identity_pc
        imm r20, 132
        imm r21, 216
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc
        ret

emit_ident_require_memory:
        imm r20, 54
        imm r21, 216
        imm r22, 1
        imm r23, 1
        call exact_memory_identity_pc
        mov r39, r0                 ; byte[SRC+off+k]
        imm r20, 547                ; final address addition
        imm r21, 216
        imm r22, 2
        imm r23, 3
        call exact_primitive_identity_pc
        mov r38, r0
        imm r20, 547
        call exact_expr_primitive_extent
        jeq r0, r38, emit_ident_memory_start_rejoined
        jmp reject
emit_ident_memory_start_rejoined:
        jeq r1, r39, emit_ident_memory_rejoined
        jmp reject
emit_ident_memory_rejoined:
        ret

emit_ident_require_primitives:
        imm r20, 542
        imm r21, 214
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 543
        imm r21, 215
        imm r22, 3
        imm r23, 8                   ; k<len
        call exact_primitive_identity_pc
        imm r20, 544
        imm r21, 215
        imm r22, 1
        imm r23, 0                   ; return zero
        call exact_primitive_identity_pc
        imm r20, 545
        imm r21, 216
        imm r22, 1
        imm r23, 2097152             ; source arena base
        call exact_primitive_identity_pc
        imm r20, 546
        imm r21, 216
        imm r22, 2
        imm r23, 3                   ; base+off
        call exact_primitive_identity_pc
        imm r20, 547
        imm r21, 216
        imm r22, 2
        imm r23, 3                   ; base+off+k
        call exact_primitive_identity_pc
        imm r20, 548
        imm r21, 216
        imm r22, 2
        imm r23, 3                   ; k+1
        call exact_primitive_identity_pc
        imm r20, 549
        imm r21, 216
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        ret

emit_ident_require_pushes:
        imm r20, 156
        imm r21, 215
        call exact_require_binary_push_identity
        imm r20, 157
        imm r21, 216
        call exact_require_binary_push_identity
        imm r20, 158
        imm r21, 216
        call exact_require_binary_push_identity
        imm r20, 159
        imm r21, 216
        call exact_require_binary_push_identity
        ret

emit_ident_require_censuses:
        imm r20, 214
        imm r21, 216
        imm r22, 126
        imm r23, 133                 ; exclusive local row
        imm r24, 54
        imm r25, 55                  ; exclusive memory row
        imm r26, 167
        imm r27, 169                 ; exclusive transition row
        imm r28, 339
        imm r29, 341                 ; exclusive event row
        call exact_require_effect_census

        imm r20, 214
        imm r21, 216
        imm r22, 542
        imm r23, 550                 ; exclusive primitive row
        imm r24, 156
        imm r25, 160                 ; exclusive binary-push row
        imm r26, 0
        imm r27, 0
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census

        imm r20, 45
        call exact_proc_entry_r20
        imm r21, 46
        call exact_proc_entry_r21
        imm r22, 0                   ; no ordinary calls
        imm r23, 2                   ; explicit and synthetic returns
        imm r24, 1                   ; one direct output
        imm r25, 9                   ; saved-fp/local/push stores
        imm r26, 1                   ; source-byte loadb is intentional
        call exact_effect_scan_region
        ret
