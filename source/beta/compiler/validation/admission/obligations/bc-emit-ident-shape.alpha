; Exact source/artifact shape for emit_ident_at(off,len).
;
; This module owns procedure 45's three blocks, two transitions, direct output,
; return/epilogues, three-slot frame, local and indexed-source accesses,
; expression primitives/pushes, and exhaustive decoded/table censuses. The
; adjacent semantic module owns the bounded loop and exact source-slice trace.

emit_ident_require_shape:
        imm r20, 7151616
        imm r21, 45
        imm r22, 2                    ; off,len parameters
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 45
        imm r22, 3                    ; off,len,k slots
        call transfer_require_cell
        imm r20, 45
        call call_bounds_frame_bytes
        imm r1, 32
        jeq r0, r1, emit_ident_shape_blocks
        jmp reject

emit_ident_shape_blocks:
        imm r20, 214
        imm r21, 31465
        call exact_require_block_pc
        imm r20, 215
        imm r21, 31564
        call exact_require_block_pc
        imm r20, 216
        imm r21, 31726
        call exact_require_block_pc
        imm r20, 214
        imm r21, 216
        imm r22, 45
        call exact_require_proc_blocks
        call emit_ident_require_transitions
        call emit_ident_require_events
        call emit_ident_require_locals
        call emit_ident_require_memory
        call emit_ident_require_primitives
        call emit_ident_require_pushes
        call emit_ident_require_censuses
        ret

emit_ident_require_transitions:
        imm r20, 167
        imm r21, 215
        imm r22, 1
        imm r23, 216
        imm r24, 31677              ; checked k<len guard
        call exact_require_transition
        imm r20, 168
        imm r21, 216
        imm r22, 0
        imm r23, 215
        imm r24, 31941              ; checked strict-successor backedge
        call exact_require_transition
        ret

emit_ident_require_events:
        imm r20, 339
        imm r21, 215
        imm r22, 5
        imm r23, 31725              ; checked explicit return zero
        call exact_require_event
        imm r20, 340
        imm r21, 216
        imm r22, 3
        imm r23, 31853              ; checked direct write_byte lowering
        call exact_require_event
        imm r20, 31706
        imm r21, 31725
        call exact_require_epilogue
        imm r20, 31950
        imm r21, 31969
        call exact_require_epilogue
        ret

emit_ident_require_locals:
        ; Row order is lexical source order; PCs expose lowering order.
        imm r20, 126
        imm r21, 214
        imm r22, 2
        imm r23, 2
        imm r24, 31545              ; k=0
        call transfer_require_local
        imm r20, 127
        imm r21, 215
        imm r22, 1
        imm r23, 2
        imm r24, 31564              ; guard k
        call transfer_require_local
        imm r20, 128
        imm r21, 215
        imm r22, 1
        imm r23, 1
        imm r24, 31599              ; guard len
        call transfer_require_local
        imm r20, 129
        imm r21, 216
        imm r22, 1
        imm r23, 0
        imm r24, 31752              ; source off
        call transfer_require_local
        imm r20, 130
        imm r21, 216
        imm r22, 1
        imm r23, 2
        imm r24, 31809              ; source index k
        call transfer_require_local
        imm r20, 131
        imm r21, 216
        imm r22, 2
        imm r23, 2
        imm r24, 31922              ; k successor store
        call transfer_require_local
        imm r20, 132
        imm r21, 216
        imm r22, 1
        imm r23, 2
        imm r24, 31855              ; increment k load
        call transfer_require_local
        ret

emit_ident_require_memory:
        imm r20, 54
        imm r21, 216
        imm r22, 1
        imm r23, 1
        imm r24, 31850              ; byte[SRC+off+k]
        call transfer_require_memory
        ret

emit_ident_require_primitives:
        imm r20, 542
        imm r21, 214
        imm r22, 1
        imm r23, 0
        imm r24, 31535
        call transfer_require_primitive
        imm r20, 543
        imm r21, 215
        imm r22, 3
        imm r23, 8                   ; k<len
        imm r24, 31618
        call transfer_require_primitive
        imm r20, 544
        imm r21, 215
        imm r22, 1
        imm r23, 0                   ; return zero
        imm r24, 31696
        call transfer_require_primitive
        imm r20, 545
        imm r21, 216
        imm r22, 1
        imm r23, 2097152             ; source arena base
        imm r24, 31726
        call transfer_require_primitive
        imm r20, 546
        imm r21, 216
        imm r22, 2
        imm r23, 3                   ; base+off
        imm r24, 31771
        call transfer_require_primitive
        imm r20, 547
        imm r21, 216
        imm r22, 2
        imm r23, 3                   ; base+off+k
        imm r24, 31828
        call transfer_require_primitive
        imm r20, 548
        imm r21, 216
        imm r22, 2
        imm r23, 3                   ; k+1
        imm r24, 31900
        call transfer_require_primitive
        imm r20, 549
        imm r21, 216
        imm r22, 1
        imm r23, 1
        imm r24, 31890
        call transfer_require_primitive
        ret

emit_ident_require_pushes:
        imm r20, 156
        imm r21, 215
        imm r23, 31583              ; guard-left k
        call exact_require_binary_push
        imm r20, 157
        imm r21, 216
        imm r23, 31736              ; source-base left
        call exact_require_binary_push
        imm r20, 158
        imm r21, 216
        imm r23, 31793              ; base+off left
        call exact_require_binary_push
        imm r20, 159
        imm r21, 216
        imm r23, 31874              ; increment-left k
        call exact_require_binary_push
        ret

emit_ident_require_censuses:
        imm r20, 214
        imm r21, 216
        imm r22, 126
        imm r23, 133                 ; exclusive local row
        imm r24, 54
        imm r25, 55                  ; exclusive memory row
        imm r26, 167
        imm r27, 169                 ; exclusive transition row
        imm r28, 339
        imm r29, 341                 ; exclusive event row
        call exact_require_effect_census

        imm r20, 214
        imm r21, 216
        imm r22, 542
        imm r23, 550                 ; exclusive primitive row
        imm r24, 156
        imm r25, 160                 ; exclusive binary-push row
        imm r26, 0
        imm r27, 0
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census

        imm r20, 31465
        imm r21, 31970
        imm r22, 0                   ; no ordinary calls
        imm r23, 2                   ; explicit and synthetic returns
        imm r24, 1                   ; one direct output
        imm r25, 9                   ; saved-fp/local/push stores
        imm r26, 1                   ; source-byte loadb is intentional
        call exact_effect_scan_region
        ret
