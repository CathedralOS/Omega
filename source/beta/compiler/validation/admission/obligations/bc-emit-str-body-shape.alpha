; Exact source/artifact shape for emit_str_body().
; The canonical procedure inventory owns its total block span and partition.
;
; Procedure 27 blindly advances over one byte, then owns a six-block string
; scan with quote, zero, ordinary, and escape outcomes.  This module binds all
; calls and direct writes in lowering order (including the nested cbyte calls
; which precede their lexical write_byte rows), both explicit returns, the
; synthetic epilogue, the one-slot frame, and exhaustive table/decoded-region
; censuses.  Cursor/output meaning is proved by the adjacent case and summary
; modules.
;
; Private publication cell: 535656 = SBSH.

emit_str_body_require_shape:
        imm r20, 27
        imm r21, 0                    ; no parameters
        imm r22, 1                    ; local len only
        imm r23, 16
        call exact_require_proc_frame_identity
        imm r20, 140
        imm r21, 145
        imm r22, 27
        call exact_require_proc_blocks

        call emit_str_body_require_transitions
        call emit_str_body_require_events
        call emit_str_body_require_locals
        call emit_str_body_require_primitives
        call emit_str_body_require_pushes
        call emit_str_body_require_censuses
        imm r1, 535656
        imm r2, 1213416019            ; SBSH
        store r1, r2
        imm r20, 535656
        imm r21, 1213416019
        call exact_require_cell
        ret

emit_str_body_require_transitions:
        imm r20, 102
        imm r21, 141
        imm r22, 1
        imm r23, 142
        call exact_transition_identity_pc ; cbyte()!=34 -> body
        imm r20, 103
        imm r21, 141
        imm r22, 0
        imm r23, 145
        call exact_transition_identity_pc ; quote -> done
        imm r20, 104
        imm r21, 142
        imm r22, 1
        imm r23, 143
        call exact_transition_identity_pc ; unescaped zero -> eof
        imm r20, 105
        imm r21, 142
        imm r22, 1
        imm r23, 144
        call exact_transition_identity_pc ; backslash -> esc
        imm r20, 106
        imm r21, 142
        imm r22, 0
        imm r23, 141
        call exact_transition_identity_pc ; ordinary successor -> loop
        imm r20, 107
        imm r21, 144
        imm r22, 0
        imm r23, 141
        call exact_transition_identity_pc ; escape successor -> loop
        ret

; r20=block,r21=target procedure. All calls belong to emit_str_body, with zero
; arity and empty ambient expression state.
emit_str_body_require_call:
        mov r24, r21
        mov r21, r20
        imm r20, 27
        imm r22, 0
        imm r23, 0
        call summary_require_call_fallthrough_identity
        ret

; r20=block,r21=target,r22=occurrence,r23=cardinality.
emit_str_body_require_nth_call:
        mov r26, r23
        mov r25, r22
        mov r24, r21
        mov r21, r20
        imm r20, 27
        imm r22, 0
        imm r23, 0
        call summary_require_nth_call_fallthrough_identity
        ret

emit_str_body_require_events:
        ; Opening and loop observations.
        imm r20, 140
        imm r21, 5                    ; adv
        call emit_str_body_require_call
        imm r20, 141
        imm r21, 4                    ; cbyte
        call emit_str_body_require_call
        imm r20, 142
        imm r21, 4                    ; first of three cbyte calls
        imm r22, 0
        imm r23, 3
        call emit_str_body_require_nth_call
        imm r20, 142
        imm r21, 4
        imm r22, 1
        imm r23, 3
        call emit_str_body_require_nth_call

        ; Lexical write row187 lowers after its cbyte argument row188.
        imm r20, 142
        imm r21, 4
        imm r22, 2
        imm r23, 3
        call emit_str_body_require_nth_call
        imm r20, 27
        imm r21, 142
        call exact_unique_write_event_identity
        imm r20, 142
        imm r21, 5                    ; ordinary adv
        call emit_str_body_require_call
        imm r20, 27
        imm r21, 143
        call exact_require_event_epilogue

        ; Escape writes a literal backslash, advances, then writes cbyte().
        imm r20, 27
        imm r21, 144
        imm r22, 0
        imm r23, 2
        call exact_nth_write_event_identity
        imm r20, 144
        imm r21, 5                    ; first of two adv calls
        imm r22, 0
        imm r23, 2
        call emit_str_body_require_nth_call
        imm r20, 144
        imm r21, 4                    ; cbyte
        call emit_str_body_require_call
        imm r20, 27
        imm r21, 144
        imm r22, 1
        imm r23, 2
        call exact_nth_write_event_identity
        imm r20, 144
        imm r21, 5
        imm r22, 1
        imm r23, 2
        call emit_str_body_require_nth_call

        imm r20, 145
        imm r21, 5                    ; closing quote adv
        call emit_str_body_require_call
        imm r20, 27
        imm r21, 145
        call exact_require_event_epilogue
        imm r20, 28                   ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

emit_str_body_require_locals:
        imm r20, 37
        imm r21, 140
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc  ; len=0
        imm r20, 38
        imm r21, 142
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc  ; ordinary len successor
        imm r20, 39
        imm r21, 142
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 40
        imm r21, 143
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc  ; eof result
        imm r20, 41
        imm r21, 144
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc  ; escape len successor
        imm r20, 42
        imm r21, 144
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 43
        imm r21, 145
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc  ; quote result
        ret

emit_str_body_require_primitives:
        imm r20, 370
        imm r21, 140
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 371
        imm r21, 141
        imm r22, 3
        imm r23, 11                  ; cbyte != 34
        call exact_primitive_identity_pc
        imm r20, 372
        imm r21, 141
        imm r22, 1
        imm r23, 34
        call exact_primitive_identity_pc
        imm r20, 373
        imm r21, 142
        imm r22, 3
        imm r23, 10                  ; cbyte == 0
        call exact_primitive_identity_pc
        imm r20, 374
        imm r21, 142
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 375
        imm r21, 142
        imm r22, 3
        imm r23, 10                  ; cbyte == 92
        call exact_primitive_identity_pc
        imm r20, 376
        imm r21, 142
        imm r22, 1
        imm r23, 92
        call exact_primitive_identity_pc
        imm r20, 377
        imm r21, 142
        imm r22, 2
        imm r23, 3                   ; len+1
        call exact_primitive_identity_pc
        imm r20, 378
        imm r21, 142
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 379
        imm r21, 144
        imm r22, 1
        imm r23, 92                  ; literal first escape byte
        call exact_primitive_identity_pc
        imm r20, 380
        imm r21, 144
        imm r22, 2
        imm r23, 3                   ; len+1, not len+2
        call exact_primitive_identity_pc
        imm r20, 381
        imm r21, 144
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        ret

emit_str_body_require_pushes:
        imm r20, 93
        imm r21, 141
        call exact_require_binary_push_identity
        imm r20, 94
        imm r21, 142
        call exact_require_binary_push_identity
        imm r20, 95
        imm r21, 142
        call exact_require_binary_push_identity
        imm r20, 96
        imm r21, 142
        call exact_require_binary_push_identity
        imm r20, 97
        imm r21, 144
        call exact_require_binary_push_identity
        ret

emit_str_body_require_censuses:
        imm r20, 140
        imm r21, 145
        imm r22, 37
        imm r23, 44                  ; exclusive local row
        imm r24, 33
        imm r25, 33                  ; no raw-memory rows
        imm r26, 102
        imm r27, 108                 ; exclusive transition row
        imm r28, 183
        imm r29, 198                 ; exclusive event row
        call exact_require_effect_census

        imm r20, 140
        imm r21, 145
        imm r22, 370
        imm r23, 382                 ; exclusive primitive row
        imm r24, 93
        imm r25, 98                  ; binary pushes
        imm r26, 299
        imm r27, 299                 ; no ordinary argument pushes
        imm r28, 383
        imm r29, 383                 ; no store-address pushes
        call summary_require_expr_census

        imm r20, 27                   ; emit_str_body procedure identity
        call exact_proc_entry_r20
        imm r21, 28                   ; gen_emit procedure identity / end
        call exact_proc_entry_r21
        imm r22, 10                  ; adv/cbyte calls
        imm r23, 3                   ; two explicit + synthetic returns
        imm r24, 3                   ; direct writes
        imm r25, 9                   ; saved-fp/local/push stores
        imm r26, 0                   ; no raw-byte memory
        call exact_effect_scan_region
        ret
