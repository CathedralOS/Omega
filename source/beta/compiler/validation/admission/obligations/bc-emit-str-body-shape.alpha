; Exact source/artifact shape for emit_str_body().
;
; Procedure 27 blindly advances over one byte, then owns a six-block string
; scan with quote, zero, ordinary, and escape outcomes.  This module binds all
; calls and direct writes in lowering order (including the nested cbyte calls
; which precede their lexical write_byte rows), both explicit returns, the
; synthetic epilogue, the one-slot frame, and exhaustive table/decoded-region
; censuses.  Cursor/output meaning is proved by the adjacent case and summary
; modules.
;
; Private publication cell: 535656 = SBSH.

emit_str_body_require_shape:
        imm r20, 7151616
        imm r21, 27
        imm r22, 0                    ; no parameters
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 27
        imm r22, 1                    ; local len only
        call transfer_require_cell
        imm r20, 27
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, emit_str_body_shape_blocks
        jmp reject

emit_str_body_shape_blocks:
        imm r20, 140
        imm r21, 18780
        call exact_require_block_pc
        imm r20, 141
        imm r21, 18850
        call exact_require_block_pc
        imm r20, 142
        imm r21, 18972
        call exact_require_block_pc
        imm r20, 143
        imm r21, 19313
        call exact_require_block_pc
        imm r20, 144
        imm r21, 19352
        call exact_require_block_pc
        imm r20, 145
        imm r21, 19488
        call exact_require_block_pc
        imm r20, 140
        imm r21, 145
        imm r22, 27
        call exact_require_proc_blocks
        call emit_str_body_require_transitions
        call emit_str_body_require_events
        call emit_str_body_require_locals
        call emit_str_body_require_primitives
        call emit_str_body_require_pushes
        call emit_str_body_require_censuses
        imm r1, 535656
        imm r2, 1213416019            ; SBSH
        store r1, r2
        imm r20, 535656
        imm r21, 1213416019
        call exact_require_cell
        ret

emit_str_body_require_transitions:
        imm r20, 102
        imm r21, 141
        imm r22, 1
        imm r23, 142
        imm r24, 18944                ; cbyte()!=34 -> body
        call exact_require_transition
        imm r20, 103
        imm r21, 141
        imm r22, 0
        imm r23, 145
        imm r24, 18963                ; quote -> done
        call exact_require_transition
        imm r20, 104
        imm r21, 142
        imm r22, 1
        imm r23, 143
        imm r24, 19066                ; unescaped zero -> eof
        call exact_require_transition
        imm r20, 105
        imm r21, 142
        imm r22, 1
        imm r23, 144
        imm r24, 19179                ; backslash -> esc
        call exact_require_transition
        imm r20, 106
        imm r21, 142
        imm r22, 0
        imm r23, 141
        imm r24, 19304                ; ordinary successor -> loop
        call exact_require_transition
        imm r20, 107
        imm r21, 144
        imm r22, 0
        imm r23, 141
        imm r24, 19479                ; escape successor -> loop
        call exact_require_transition
        ret

emit_str_body_require_events:
        ; Opening and loop observations.
        imm r20, 183
        imm r21, 140
        imm r22, 18812
        imm r23, 0
        imm r24, 0
        imm r25, 1939                 ; adv
        imm r26, 18821
        call summary_require_call_site
        imm r20, 184
        imm r21, 141
        imm r22, 18850
        imm r23, 0
        imm r24, 0
        imm r25, 1609                 ; cbyte
        imm r26, 18859
        call summary_require_call_site
        imm r20, 185
        imm r21, 142
        imm r22, 18972
        imm r23, 0
        imm r24, 0
        imm r25, 1609
        imm r26, 18981
        call summary_require_call_site
        imm r20, 186
        imm r21, 142
        imm r22, 19085
        imm r23, 0
        imm r24, 0
        imm r25, 1609
        imm r26, 19094
        call summary_require_call_site

        ; Lexical row 187 is the write, but its cbyte argument at row 188
        ; lowers first and continues directly at that write instruction.
        imm r20, 188
        imm r21, 142
        imm r22, 19198
        imm r23, 0
        imm r24, 0
        imm r25, 1609
        imm r26, 19207
        call summary_require_call_site
        imm r20, 187
        imm r21, 142
        imm r22, 3
        imm r23, 19207
        call exact_require_event
        imm r20, 187
        imm r21, 1
        call exact_require_event_arity
        imm r20, 189
        imm r21, 142
        imm r22, 19209
        imm r23, 0
        imm r24, 0
        imm r25, 1939
        imm r26, 19218
        call summary_require_call_site

        imm r20, 190
        imm r21, 143
        imm r22, 5
        imm r23, 19351
        call exact_require_event

        ; Escape writes the literal backslash before observing/writing its
        ; second byte.  Again the nested cbyte row lowers before write row 193.
        imm r20, 191
        imm r21, 144
        imm r22, 3
        imm r23, 19362
        call exact_require_event
        imm r20, 191
        imm r21, 1
        call exact_require_event_arity
        imm r20, 192
        imm r21, 144
        imm r22, 19364
        imm r23, 0
        imm r24, 0
        imm r25, 1939
        imm r26, 19373
        call summary_require_call_site
        imm r20, 194
        imm r21, 144
        imm r22, 19373
        imm r23, 0
        imm r24, 0
        imm r25, 1609
        imm r26, 19382
        call summary_require_call_site
        imm r20, 193
        imm r21, 144
        imm r22, 3
        imm r23, 19382
        call exact_require_event
        imm r20, 193
        imm r21, 1
        call exact_require_event_arity
        imm r20, 195
        imm r21, 144
        imm r22, 19384
        imm r23, 0
        imm r24, 0
        imm r25, 1939
        imm r26, 19393
        call summary_require_call_site

        imm r20, 196
        imm r21, 145
        imm r22, 19488
        imm r23, 0
        imm r24, 0
        imm r25, 1939
        imm r26, 19497
        call summary_require_call_site
        imm r20, 197
        imm r21, 145
        imm r22, 5
        imm r23, 19535
        call exact_require_event

        imm r20, 19332
        imm r21, 19351
        call exact_require_epilogue
        imm r20, 19516
        imm r21, 19535
        call exact_require_epilogue
        imm r20, 19536
        imm r21, 19555
        call exact_require_epilogue
        ret

