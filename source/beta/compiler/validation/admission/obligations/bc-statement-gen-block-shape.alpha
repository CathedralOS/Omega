; Exact source/artifact shape for gen_block (procedure63).
; The canonical procedure inventory owns its total block span and partition.

statement_gen_block_require_shape:
        call statement_gen_block_require_proc
        call statement_gen_block_require_events
        call statement_gen_block_require_data
        call statement_gen_block_require_censuses
        call statement_gen_block_require_decoded
        ret

statement_gen_block_require_proc:
        imm r20, 63
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call exact_require_proc_frame_identity
        jmp exact_shape_ok

; r22=arity,r23=target procedure identity.
statement_gen_block_require_call:
        mov r24, r23
        imm r20, 63
        imm r21, 315
        imm r23, 0
        call summary_require_call_fallthrough_identity
        ret

statement_gen_block_require_events:
        imm r20, 508
        imm r22, 1
        imm r23, 24                    ; expect procedure identity
        call statement_gen_block_require_call
        imm r20, 509
        imm r22, 0
        imm r23, 62                    ; gen_stmts procedure identity
        call statement_gen_block_require_call
        imm r20, 63                    ; gen_block procedure identity
        imm r21, 315
        call exact_require_event_epilogue
        imm r20, 64                    ; emit_state_label identifies synthetic
        call exact_require_preentry_epilogue
        ret

statement_gen_block_require_data:
        imm r20, 725
        imm r21, 315
        imm r22, 1
        imm r23, 123
        call exact_primitive_identity_pc
        imm r20, 726
        imm r21, 315
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 346
        imm r21, 315
        call exact_require_argument_push_identity
        ret

statement_gen_block_require_censuses:
        imm r20, 315
        imm r21, 315
        imm r22, 201
        imm r23, 201
        imm r24, 74
        imm r25, 74
        imm r26, 258
        imm r27, 258
        imm r28, 508
        imm r29, 511
        call exact_require_effect_census
        imm r20, 315
        imm r21, 315
        imm r22, 725
        imm r23, 727
        imm r24, 215
        imm r25, 215
        imm r26, 346
        imm r27, 347
        imm r28, 399
        imm r29, 399
        call summary_require_expr_census
        ret

statement_gen_block_require_decoded:
        imm r20, 63
        call exact_proc_entry_r20
        imm r21, 64
        call exact_proc_entry_r21
        imm r22, 2
        imm r23, 2
        imm r24, 2
        call exact_quiet_scan_region
        ret
