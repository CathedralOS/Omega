; Exact data/table and decoded-region shape for procedures30,44,47..52.
;
; All eight procedures have no raw-memory source rows.  This module pins every
; local read, literal/comparison/arithmetic primitive, and stack push, then
; exhausts the corresponding source tables.  Per-procedure decoded scans and
; a second three-region partition establish exact calls/returns/stores while
; rejecting direct input/output, halt, division, and remainder opcodes.

bounded_emitters_require_data_shape:
        call bounded_emitters_require_locals
        call bounded_emitters_require_primitives
        call bounded_emitters_require_pushes
        call bounded_emitters_require_source_censuses
        call bounded_emitters_require_decoded_censuses
        ret

bounded_emitters_require_locals:
        ; emit_pop_into(k).
        imm r20, 125
        imm r21, 213
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc

        ; emit_mnemonic(op), one reload at each comparison state.
        imm r20, 133
        imm r21, 220
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 134
        imm r21, 222
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 135
        imm r21, 224
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 136
        imm r21, 226
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 137
        imm r21, 228
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc

        ; emit_combine(op).
        imm r20, 138
        imm r21, 230
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc

        ; emit_slot_addr(reg,slot): reg, slot, reg in lowering order.
        imm r20, 139
        imm r21, 231
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 140
        imm r21, 231
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 141
        imm r21, 231
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc

        ; emit_load_slot / emit_store_slot.
        imm r20, 142
        imm r21, 232
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 143
        imm r21, 233
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        ret

; row/block/kind/value-or-opcode/PC.
bounded_emitters_require_primitives:
        ; gen_read_byte delimiters and explicit return zero.
        imm r20, 385
        imm r21, 148
        imm r22, 1
        imm r23, 40                  ; gen_read_byte open delimiter
        call exact_primitive_identity_pc
        imm r20, 386
        imm r21, 148
        imm r22, 1
        imm r23, 41
        call exact_primitive_identity_pc
        imm r20, 387
        imm r21, 148
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        call bounded_emitters_require_mnemonic_primitives
        call bounded_emitters_require_slot_primitives
        ret

bounded_emitters_require_mnemonic_primitives:
        ; Lexical rows put each comparison before its literal even though the
        ; exact lowering PC evaluates the literal first.
        imm r20, 550
        imm r21, 220
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 551
        imm r21, 220
        imm r22, 1
        imm r23, 43                  ; plus Word
        call exact_primitive_identity_pc
        imm r20, 552
        imm r21, 221
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 553
        imm r21, 222
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 554
        imm r21, 222
        imm r22, 1
        imm r23, 45
        call exact_primitive_identity_pc
        imm r20, 555
        imm r21, 223
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 556
        imm r21, 224
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 557
        imm r21, 224
        imm r22, 1
        imm r23, 42
        call exact_primitive_identity_pc
        imm r20, 558
        imm r21, 225
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 559
        imm r21, 226
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 560
        imm r21, 226
        imm r22, 1
        imm r23, 47
        call exact_primitive_identity_pc
        imm r20, 561
        imm r21, 227
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 562
        imm r21, 228
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 563
        imm r21, 228
        imm r22, 1
        imm r23, 37
        call exact_primitive_identity_pc
        imm r20, 564
        imm r21, 228
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 565
        imm r21, 229
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        ret

bounded_emitters_require_slot_primitives:
        ; emit_slot_addr: source 8 + 8 * slot.
        imm r20, 566
        imm r21, 231
        imm r22, 1
        imm r23, 8
        call exact_primitive_identity_pc
        imm r20, 567
        imm r21, 231
        imm r22, 2
        imm r23, 3                   ; exact offset add opcode
        call exact_primitive_identity_pc
        imm r20, 568
        imm r21, 231
        imm r22, 1
        imm r23, 8
        call exact_primitive_identity_pc
        imm r20, 569
        imm r21, 231
        imm r22, 2
        imm r23, 5                   ; exact offset multiply opcode
        call exact_primitive_identity_pc
        imm r20, 570
        imm r21, 232
        imm r22, 1
        imm r23, 0                   ; emit_load_slot selector
        call exact_primitive_identity_pc
        imm r20, 571
        imm r21, 233
        imm r22, 1
        imm r23, 1                   ; emit_store_slot selector
        call exact_primitive_identity_pc
        ret

; row/block/kind/PC.
bounded_emitters_require_pushes:
        imm r20, 306
        imm r21, 148
        call exact_require_argument_push_identity
        imm r20, 307
        imm r21, 148
        call exact_require_argument_push_identity
        imm r20, 321
        imm r21, 213
        call exact_require_argument_push_identity

        imm r20, 160
        imm r21, 220
        call exact_require_binary_push_identity
        imm r20, 161
        imm r21, 222
        call exact_require_binary_push_identity
        imm r20, 162
        imm r21, 224
        call exact_require_binary_push_identity
        imm r20, 163
        imm r21, 226
        call exact_require_binary_push_identity
        imm r20, 164
        imm r21, 228
        call exact_require_binary_push_identity
        imm r20, 322
        imm r21, 230
        call exact_require_argument_push_identity

        imm r20, 165
        imm r21, 231
        call exact_require_binary_push_identity
        imm r20, 166
        imm r21, 231
        call exact_require_binary_push_identity
        imm r20, 323
        imm r21, 231
        call exact_require_argument_push_identity
        imm r20, 324
        imm r21, 231
        call exact_require_argument_push_identity
        imm r20, 325
        imm r21, 231
        call exact_require_argument_push_identity

        imm r20, 326
        imm r21, 232
        call exact_require_argument_push_identity
        imm r20, 327
        imm r21, 232
        call exact_require_argument_push_identity
        imm r20, 328
        imm r21, 233
        call exact_require_argument_push_identity
        imm r20, 329
        imm r21, 233
        call exact_require_argument_push_identity
        ret

; effect census: inclusive block interval followed by half-open local, memory,
; transition, and event row intervals.
bounded_emitters_effect_census:
        call exact_require_effect_census
        ret

; expression census: inclusive block interval followed by half-open primitive,
; binary-push, argument-push, and empty store-push intervals.
bounded_emitters_expr_census:
        call summary_require_expr_census
        ret

bounded_emitters_require_source_censuses:
        ; gen_read_byte.
        imm r20, 148
        imm r21, 148
        imm r22, 0
        imm r23, 0
        imm r24, 54
        imm r25, 54
        imm r26, 0
        imm r27, 0
        imm r28, 233
        imm r29, 237
        call bounded_emitters_effect_census
        imm r20, 148
        imm r21, 148
        imm r22, 385
        imm r23, 388
        imm r24, 0
        imm r25, 0
        imm r26, 306
        imm r27, 308
        imm r28, 389
        imm r29, 389
        call bounded_emitters_expr_census

        ; emit_pop_into.
        imm r20, 213
        imm r21, 213
        imm r22, 125
        imm r23, 126
        imm r24, 54
        imm r25, 54
        imm r26, 0
        imm r27, 0
        imm r28, 334
        imm r29, 339
        call bounded_emitters_effect_census
        imm r20, 213
        imm r21, 213
        imm r22, 0
        imm r23, 0
        imm r24, 0
        imm r25, 0
        imm r26, 321
        imm r27, 322
        imm r28, 389
        imm r29, 389
        call bounded_emitters_expr_census

        ; emit_push.
        imm r20, 218
        imm r21, 218
        imm r22, 0
        imm r23, 0
        imm r24, 54
        imm r25, 54
        imm r26, 0
        imm r27, 0
        imm r28, 346
        imm r29, 349
        call bounded_emitters_effect_census
        imm r20, 218
        imm r21, 218
        imm r22, 0
        imm r23, 0
        imm r24, 0
        imm r25, 0
        imm r26, 0
        imm r27, 0
        imm r28, 389
        imm r29, 389
        call bounded_emitters_expr_census

        call bounded_emitters_require_source_censuses_tail
        ret

bounded_emitters_require_source_censuses_tail:
        ; emit_mnemonic.
        imm r20, 219
        imm r21, 229
        imm r22, 133
        imm r23, 138
        imm r24, 54
        imm r25, 54
        imm r26, 169
        imm r27, 178
        imm r28, 349
        imm r29, 360
        call bounded_emitters_effect_census
        imm r20, 219
        imm r21, 229
        imm r22, 550
        imm r23, 566
        imm r24, 160
        imm r25, 165
        imm r26, 0
        imm r27, 0
        imm r28, 389
        imm r29, 389
        call bounded_emitters_expr_census

        ; emit_combine.
        imm r20, 230
        imm r21, 230
        imm r22, 138
        imm r23, 139
        imm r24, 54
        imm r25, 54
        imm r26, 0
        imm r27, 0
        imm r28, 360
        imm r29, 366
        call bounded_emitters_effect_census
        imm r20, 230
        imm r21, 230
        imm r22, 0
        imm r23, 0
        imm r24, 0
        imm r25, 0
        imm r26, 322
        imm r27, 323
        imm r28, 389
        imm r29, 389
        call bounded_emitters_expr_census

        ; emit_slot_addr.
        imm r20, 231
        imm r21, 231
        imm r22, 139
        imm r23, 142
        imm r24, 54
        imm r25, 54
        imm r26, 0
        imm r27, 0
        imm r28, 366
        imm r29, 375
        call bounded_emitters_effect_census
        imm r20, 231
        imm r21, 231
        imm r22, 566
        imm r23, 570
        imm r24, 165
        imm r25, 167
        imm r26, 323
        imm r27, 326
        imm r28, 389
        imm r29, 389
        call bounded_emitters_expr_census

        ; emit_load_slot.
        imm r20, 232
        imm r21, 232
        imm r22, 142
        imm r23, 143
        imm r24, 54
        imm r25, 54
        imm r26, 0
        imm r27, 0
        imm r28, 375
        imm r29, 377
        call bounded_emitters_effect_census
        imm r20, 232
        imm r21, 232
        imm r22, 570
        imm r23, 571
        imm r24, 0
        imm r25, 0
        imm r26, 326
        imm r27, 328
        imm r28, 389
        imm r29, 389
        call bounded_emitters_expr_census

        ; emit_store_slot.
        imm r20, 233
        imm r21, 233
        imm r22, 143
        imm r23, 144
        imm r24, 54
        imm r25, 54
        imm r26, 0
        imm r27, 0
        imm r28, 377
        imm r29, 379
        call bounded_emitters_effect_census
        imm r20, 233
        imm r21, 233
        imm r22, 571
        imm r23, 572
        imm r24, 0
        imm r25, 0
        imm r26, 328
        imm r27, 330
        imm r28, 389
        imm r29, 389
