        ret

; Per-procedure exact decoded counts.  exact_quiet_scan_region also rejects
; direct read/write, halt, division, and remainder; emitted opcode spellings
; are inline data and are not decoded instruction starts.
bounded_emitters_require_decoded_censuses:
        imm r20, 30                  ; gen_read_byte procedure identity
        call exact_proc_entry_r20
        imm r21, 31                  ; gen_write_byte procedure identity / end
        call exact_proc_entry_r21
        imm r22, 3
        imm r23, 2
        imm r24, 3
        call exact_quiet_scan_region
        imm r20, 44                    ; emit_pop_into procedure identity
        call exact_proc_entry_r20
        imm r21, 45                  ; emit_ident_at procedure identity / end
        call exact_proc_entry_r21
        imm r22, 5
        imm r23, 1
        imm r24, 3
        call exact_quiet_scan_region
        imm r20, 47                    ; emit_push procedure identity
        call exact_proc_entry_r20
        imm r21, 48                  ; emit_mnemonic procedure identity / end
        call exact_proc_entry_r21
        imm r22, 3
        imm r23, 1
        imm r24, 1
        call exact_quiet_scan_region
        imm r20, 48                  ; emit_mnemonic procedure identity
        call exact_proc_entry_r20
        imm r21, 49                  ; emit_combine procedure identity / end
        call exact_proc_entry_r21
        imm r22, 5
        imm r23, 7                   ; emit_mnemonic returns
        imm r24, 7
        call exact_quiet_scan_region
        imm r20, 49                  ; emit_combine procedure identity
        call exact_proc_entry_r20
        imm r21, 50                  ; emit_slot_addr procedure identity / end
        call exact_proc_entry_r21
        imm r22, 6
        imm r23, 1
        imm r24, 3
        call exact_quiet_scan_region
        imm r20, 50                  ; emit_slot_addr procedure identity
        call exact_proc_entry_r20
        imm r21, 51                  ; emit_load_slot procedure identity / end
        call exact_proc_entry_r21
        imm r22, 9                   ; emit_slot_addr calls
        imm r23, 1
        imm r24, 8                   ; emit_slot_addr stores
        call exact_quiet_scan_region
        imm r20, 51                  ; emit_load_slot procedure identity
        call exact_proc_entry_r20
        imm r21, 52                  ; emit_store_slot procedure identity / end
        call exact_proc_entry_r21
        imm r22, 2
        imm r23, 1
        imm r24, 4
        call exact_quiet_scan_region
        imm r20, 52                  ; emit_store_slot procedure identity
        call exact_proc_entry_r20
        imm r21, 53                  ; is_muldiv procedure identity / end
        call exact_proc_entry_r21
        imm r22, 2
        imm r23, 1
        imm r24, 4
        call exact_quiet_scan_region

        ; Independent disjoint-region partition: 3+5+27 calls,
        ; 2+1+12 returns, and 3+3+27 stores = exact family 35/15/33.
        imm r20, 30                  ; gen_read_byte procedure identity
        call exact_proc_entry_r20
        imm r21, 31                  ; gen_write_byte procedure identity / end
        call exact_proc_entry_r21
        imm r22, 3
        imm r23, 2
        imm r24, 3
        call exact_quiet_scan_region
        imm r20, 44                    ; emit_pop_into procedure identity
        call exact_proc_entry_r20
        imm r21, 45                  ; emit_ident_at procedure identity / end
        call exact_proc_entry_r21
        imm r22, 5
        imm r23, 1
        imm r24, 3
        call exact_quiet_scan_region
        imm r20, 47                    ; emit_push procedure identity
        call exact_proc_entry_r20
        imm r21, 53                  ; is_muldiv procedure identity / end
        call exact_proc_entry_r21
        imm r22, 27
        imm r23, 12
        imm r24, 27
        call exact_quiet_scan_region
        ret
