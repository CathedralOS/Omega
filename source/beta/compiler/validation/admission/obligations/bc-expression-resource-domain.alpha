; Independently reconstruct the protected-writer domain needed by the
; expression semantics. The common grammar pass classifies every raw-store
; address, so this scan does not trust procedure-local comments or numeric exit
; status to recover which resource changed.

expression_semantic_rules_init:
        call expression_resource_count_protected
        call expression_resource_require_writers
        call expression_resource_require_depth_writers
        imm r1, 545600
        imm r2, 1129534036             ; XRSC
        store r1, r2
        jmp expression_tail_rules_init

expression_resource_count_protected:
        imm r10, 0                     ; memory row
        imm r11, 0                     ; EXPRDEPTH writer count
        imm r12, 0                     ; RESOURCE writer count
expression_resource_count_loop:
        imm r1, 101
        jlt r10, r1, expression_resource_count_row
        imm r1, 4
        jeq r11, r1, expression_resource_count_status
        jmp reject
expression_resource_count_status:
        imm r1, 8
        jeq r12, r1, expression_resource_count_done
        jmp reject
expression_resource_count_row:
        mov r13, r10
        imm r1, 8
        mul r13, r1
        imm r1, 7610368               ; memory kind table
        add r1, r13
        load r2, r1
        imm r3, 2
        jeq r2, r3, expression_resource_count_fixed
        jmp expression_resource_count_next
expression_resource_count_fixed:
        imm r1, 10616832              ; address class: literal fixed
        add r1, r13
        load r2, r1
        imm r3, 1
        jeq r2, r3, expression_resource_count_address
        jmp expression_resource_count_next
expression_resource_count_address:
        imm r1, 10618880
        add r1, r13
        load r2, r1
        imm r3, 2097080
        jeq r2, r3, expression_resource_count_depth
        imm r3, 2097072
        jeq r2, r3, expression_resource_count_resource
        jmp expression_resource_count_next
expression_resource_count_depth:
        imm r1, 1
        add r11, r1
        jmp expression_resource_count_next
expression_resource_count_resource:
        imm r1, 1
        add r12, r1
expression_resource_count_next:
        imm r1, 1
        add r10, r1
        jmp expression_resource_count_loop
expression_resource_count_done:
        ret

; r20 memory row; r21 block; r22 address primitive row; r23 value primitive
; row; r24 value; r25 store-address push row. Recompose the entire checked
; literal-address/push/literal-value/pop/store chain without artifact PCs.
expression_resource_require_writer:
        mov r42, r20
        mov r43, r21
        mov r44, r22
        mov r45, r23
        mov r46, r24
        mov r47, r25

        mov r20, r42
        mov r21, r43
        call exact_memory_store_pc
        mov r48, r0                 ; checked pop start

        mov r20, r44
        mov r21, r43
        imm r22, 1
        imm r23, 2097072
        call exact_primitive_identity_pc
        mov r49, r0
        mov r20, r44
        call exact_expr_primitive_extent
        jeq r0, r49, expression_resource_address_extent
        jmp reject
expression_resource_address_extent:
        mov r50, r1

        mov r20, r47
        mov r21, r43
        call exact_require_store_push_identity
        jeq r0, r50, expression_resource_push_start
        jmp reject
expression_resource_push_start:
        mov r20, r0
        call exact_require_push
        mov r51, r3

        mov r20, r45
        mov r21, r43
        imm r22, 1
        mov r23, r46
        call exact_primitive_identity_pc
        jeq r0, r51, expression_resource_value_start
        jmp reject
expression_resource_value_start:
        mov r52, r0
        mov r20, r45
        call exact_expr_primitive_extent
        jeq r0, r52, expression_resource_value_extent
        jmp reject
expression_resource_value_extent:
        jeq r1, r48, exact_shape_ok
        jmp reject

expression_resource_require_writers:
        ; slurp initialization is the unique zero writer.
        imm r20, 6
        imm r21, 4
        imm r22, 19
        imm r23, 20
        imm r24, 0
        imm r25, 377
        call expression_resource_require_writer
        ; Every remaining protected writer stores literal252.
        imm r20, 35
        imm r21, 159
        imm r22, 408
        imm r23, 409
        imm r24, 252
        imm r25, 383
        call expression_resource_require_writer
        imm r20, 38
        imm r21, 171
        imm r22, 435
        imm r23, 436
        imm r24, 252
        imm r25, 384
        call expression_resource_require_writer
        imm r20, 58
        imm r21, 304
        imm r22, 676
        imm r23, 677
        imm r24, 252
        imm r25, 390
        call expression_resource_require_writer
        imm r20, 65
        imm r21, 309
        imm r22, 697
        imm r23, 698
        imm r24, 252
        imm r25, 394
        call expression_resource_require_writer
        imm r20, 89
        imm r21, 340
        imm r22, 784
        imm r23, 785
        imm r24, 252
        imm r25, 403
        call expression_resource_require_writer
        imm r20, 92
        imm r21, 344
        imm r22, 798
        imm r23, 799
        imm r24, 252
        imm r25, 404
        call expression_resource_require_writer
        ; gen_item malformed-input no-progress writer stores literal251.
        imm r20, 98
        imm r21, 358
        imm r22, 824
        imm r23, 825
        imm r24, 251
        imm r25, 405
        call expression_resource_require_writer
        imm r1, 545608
        imm r2, 8                     ; zero, literal251, and six literal252
        store r1, r2
        ret

expression_resource_require_depth_writers:
        ; Exact zero root plus the three p61 increment/decrement stores. Value
        ; flow for the latter is closed by the descending induction module.
        imm r20, 5
        call expression_resource_require_depth_class
        imm r20, 5
        imm r21, 4
        call exact_memory_store_pc
        imm r20, 17
        imm r21, 4
        imm r22, 1
        imm r23, 2097080
        call exact_primitive_identity_pc
        imm r20, 18
        imm r21, 4
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc

        imm r20, 59
        call expression_resource_require_depth_class
        imm r20, 59
        imm r21, 305
        call exact_memory_store_pc
        imm r20, 60
        call expression_resource_require_depth_class
        imm r20, 60
        imm r21, 306
        call exact_memory_store_pc
        imm r20, 62
        call expression_resource_require_depth_class
        imm r20, 62
        imm r21, 307
        call exact_memory_store_pc
        imm r1, 545616
        imm r2, 4
        store r1, r2
        imm r20, 545608
        imm r21, 8
        call exact_require_cell
        imm r20, 545616
        imm r21, 4
        call exact_require_cell
        ret

; Selected row must be one of the globally counted literal fixed stores and
; its independently parsed address must be EXPRDEPTH exactly.
expression_resource_require_depth_class:
        mov r10, r20
        imm r1, 8
        mul r10, r1
        imm r1, 10616832
        add r1, r10
        load r2, r1
        imm r3, 1
        jeq r2, r3, expression_resource_depth_address
        jmp reject
expression_resource_depth_address:
        imm r1, 10618880
        add r1, r10
        load r2, r1
        imm r3, 2097080
        jeq r2, r3, exact_shape_ok
        jmp reject
