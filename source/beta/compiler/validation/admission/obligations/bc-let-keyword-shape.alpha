; Exact source/artifact shape for id_char(k) and is_let().
;
; This module owns only the identifier byte-load leaf and the four-stage `let`
; keyword recognizer: CFG, calls/arguments, locals, memory, primitives, pushes,
; frames, epilogues, and exhaustive row/decoded-region censuses. Relational
; identifier-slice and keyword meaning lives in the adjacent module.

let_keyword_require_shape:
        ; id_char has one parameter; is_let has none.
        imm r20, 7151616
        imm r21, 13
        imm r22, 1
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 13
        imm r22, 1
        call transfer_require_cell
        imm r20, 13
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, let_keyword_shape_is_let_frame
        jmp reject
let_keyword_shape_is_let_frame:
        imm r20, 7151616
        imm r21, 14
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 14
        imm r22, 0
        call transfer_require_cell
        imm r20, 14
        call call_bounds_frame_bytes
        imm r1, 8
        jeq r0, r1, let_keyword_shape_blocks
        jmp reject

let_keyword_shape_blocks:
        imm r20, 47
        imm r21, 13
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 47
        imm r21, 47
        imm r22, 13
        call exact_require_proc_blocks

        imm r20, 48
        imm r21, 14
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 49
        imm r21, 14
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 50
        imm r21, 14
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 51
        imm r21, 14
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 52
        imm r21, 14
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 53
        imm r21, 14
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 48
        imm r21, 53
        imm r22, 14
        call exact_require_proc_blocks
        call let_keyword_require_transitions
        call let_keyword_require_events
        call let_keyword_require_data
        call let_keyword_require_censuses
        ret

let_keyword_require_transitions:
        imm r20, 36
        imm r21, 49
        imm r22, 1
        imm r23, 50
        call exact_transition_identity_pc ; checked is_let length guard
        imm r20, 37
        imm r21, 50
        imm r22, 1
        imm r23, 51
        call exact_transition_identity_pc
        imm r20, 38
        imm r21, 51
        imm r22, 1
        imm r23, 52
        call exact_transition_identity_pc
        imm r20, 39
        imm r21, 52
        imm r22, 1
        imm r23, 53
        call exact_transition_identity_pc
        ret

; Source block/arity/target procedure in r21..r23.
let_keyword_require_call:
        mov r24, r23
        imm r23, 0
        imm r20, 14                    ; is_let owning procedure identity
        call summary_require_call_fallthrough_identity
        ret

let_keyword_require_events:
        imm r20, 13
        imm r21, 47
        call exact_require_event_epilogue
        imm r20, 14                    ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue

        imm r21, 50
        imm r22, 1
        imm r23, 13                    ; id_char procedure identity
        call let_keyword_require_call
        imm r21, 51
        imm r22, 1
        imm r23, 13                    ; id_char procedure identity
        call let_keyword_require_call
        imm r21, 52
        imm r22, 1
        imm r23, 13                    ; id_char procedure identity
        call let_keyword_require_call

        imm r20, 14
        imm r21, 49
        call exact_require_event_epilogue
        imm r20, 14
        imm r21, 50
        call exact_require_event_epilogue
        imm r20, 14
        imm r21, 51
        call exact_require_event_epilogue
        imm r20, 14
        imm r21, 52
        call exact_require_event_epilogue
        imm r20, 14
        imm r21, 53
        call exact_require_event_epilogue
        imm r20, 15                    ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

let_keyword_require_data:
        ; id_char slot-zero k and IDOFF/source-byte loads.
        imm r20, 33
        imm r21, 47
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 21
        imm r21, 47
        imm r22, 1
        imm r23, 1
        call exact_memory_identity_pc
        mov r39, r0                    ; byte[SRC+IDOFF+k]
        imm r20, 98                    ; final address addition
        imm r21, 47
        imm r22, 2
        imm r23, 3
        call exact_primitive_identity_pc
        mov r38, r0
        imm r20, 98
        call exact_expr_primitive_extent
        jeq r0, r38, let_keyword_memory_start_rejoined
        jmp reject
let_keyword_memory_start_rejoined:
        jeq r1, r39, let_keyword_memory_rejoined
        jmp reject
let_keyword_memory_rejoined:
        imm r20, 22
        imm r21, 47
        imm r25, 97
        imm r26, 2097120             ; checked id_char IDOFF
        call exact_memory_load_pc
        imm r20, 23
        imm r21, 49
        imm r25, 99
        imm r26, 2097112             ; checked is_let IDLEN
        call exact_memory_load_pc

        imm r20, 95
        imm r21, 47
        imm r22, 1
        imm r23, 2097152             ; SRC base
        call exact_primitive_identity_pc
        imm r20, 96
        imm r21, 47
        imm r22, 2
        imm r23, 3                   ; base+IDOFF
        call exact_primitive_identity_pc
        imm r20, 97
        imm r21, 47
        imm r22, 1
        imm r23, 2097120             ; checked id_char IDOFF
        call exact_primitive_identity_pc
        imm r20, 98
        imm r21, 47
        imm r22, 2
        imm r23, 3                   ; +k
        call exact_primitive_identity_pc

        ; is_let length and byte comparisons, including every return literal.
        imm r20, 99
        imm r21, 49
        imm r22, 1
        imm r23, 2097112             ; checked is_let IDLEN
        call exact_primitive_identity_pc
        imm r20, 100
        imm r21, 49
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 101
        imm r21, 49
        imm r22, 1
        imm r23, 3
        call exact_primitive_identity_pc
        imm r20, 102
        imm r21, 49
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 103
        imm r21, 50
        imm r22, 1
        imm r23, 0                   ; checked let index zero
        call exact_primitive_identity_pc
        imm r20, 104
        imm r21, 50
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 105
        imm r21, 50
        imm r22, 1
        imm r23, 108                 ; 'l'
        call exact_primitive_identity_pc
        imm r20, 106
        imm r21, 50
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 107
        imm r21, 51
        imm r22, 1
        imm r23, 1                   ; checked let index one
        call exact_primitive_identity_pc
        imm r20, 108
        imm r21, 51
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 109
        imm r21, 51
        imm r22, 1
        imm r23, 101                 ; 'e'
        call exact_primitive_identity_pc
        imm r20, 110
        imm r21, 51
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 111
        imm r21, 52
        imm r22, 1
        imm r23, 2                   ; checked let index two
        call exact_primitive_identity_pc
        imm r20, 112
        imm r21, 52
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 113
        imm r21, 52
        imm r22, 1
        imm r23, 116                 ; 't'
        call exact_primitive_identity_pc
        imm r20, 114
        imm r21, 52
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 115
        imm r21, 53
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc

        imm r20, 27
        imm r21, 47
        call exact_require_binary_push_identity
        imm r20, 28
        imm r21, 47
        call exact_require_binary_push_identity
        imm r20, 29
        imm r21, 49
        call exact_require_binary_push_identity
        imm r20, 30
        imm r21, 50
        call exact_require_binary_push_identity
        imm r20, 31
        imm r21, 51
        call exact_require_binary_push_identity
        imm r20, 32
        imm r21, 52
        call exact_require_binary_push_identity
        imm r20, 242
        imm r21, 50
        call exact_require_argument_push_identity               ; checked let[0] argument
        imm r20, 243
        imm r21, 51
        call exact_require_argument_push_identity               ; checked let[1] argument
        imm r20, 244
        imm r21, 52
        call exact_require_argument_push_identity               ; checked let[2] argument
        ret

let_keyword_require_censuses:
        imm r20, 47
        imm r21, 47
        imm r22, 33
        imm r23, 34
        imm r24, 21
        imm r25, 23
        imm r26, 36
        imm r27, 36
        imm r28, 37
        imm r29, 38
        call exact_require_effect_census
        imm r20, 48
        imm r21, 53
        imm r22, 34
        imm r23, 34
        imm r24, 23
        imm r25, 24
        imm r26, 36
        imm r27, 40
        imm r28, 38
        imm r29, 46                  ; checked exclusive is_let event row
        call exact_require_effect_census
        imm r20, 47
        imm r21, 53
        imm r22, 95
        imm r23, 116                 ; checked exclusive let primitive row
        imm r24, 27
        imm r25, 33
        imm r26, 242
        imm r27, 245
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census
        imm r20, 13                    ; id_char procedure identity
        call exact_proc_entry_r20
        imm r21, 14                    ; is_let procedure identity / end
        call exact_proc_entry_r21
        imm r22, 0
        imm r23, 2
        call skip_scan_call_region
        imm r20, 14                    ; is_let procedure identity
        call exact_proc_entry_r20
        imm r21, 15                    ; is_return procedure identity / end
        call exact_proc_entry_r21
        imm r22, 3
        imm r23, 6
        call skip_scan_call_region
        ret
