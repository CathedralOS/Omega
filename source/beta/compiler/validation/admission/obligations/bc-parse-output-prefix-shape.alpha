; Exact shape for parse_proc slotsready/sloop/sbody (blocks 345..347).
;
; This region calls EIDS, one fixed WSTR event, EPRO, and EPAR, initializes k,
; tests k<nparams, increments k, and exits at genbody. The adjacent summary
; owns the carried values, output concatenation, and bounded-loop induction.

parse_output_prefix_require_shape:
        imm r20, 68
        call call_bounds_frame_bytes
        imm r1, 48
        jeq r0, r1, parse_output_prefix_blocks
        jmp reject

parse_output_prefix_blocks:
        imm r20, 345
        imm r21, 50400
        call exact_require_block_pc
        imm r20, 346
        imm r21, 50649
        call exact_require_block_pc
        imm r20, 347
        imm r21, 50790
        call exact_require_block_pc
        imm r20, 348
        imm r21, 50945
        call exact_require_block_pc
        call parse_output_prefix_transitions
        call parse_output_prefix_events
        call parse_output_prefix_locals
        call parse_output_prefix_primitives
        call parse_output_prefix_pushes
        call parse_output_prefix_censuses
        ret

parse_output_prefix_transitions:
        imm r20, 282
        imm r21, 345
        imm r22, 0
        imm r23, 346
        imm r24, 50640
        call exact_require_transition
        imm r20, 283
        imm r21, 346
        imm r22, 1
        imm r23, 347
        imm r24, 50762              ; checked k<nparams guard
        call exact_require_transition
        imm r20, 284
        imm r21, 346
        imm r22, 0
        imm r23, 348
        imm r24, 50781              ; checked loop exit
        call exact_require_transition
        imm r20, 285
        imm r21, 347
        imm r22, 0
        imm r23, 346
        imm r24, 50936              ; checked increment backedge
        call exact_require_transition
        ret

parse_output_prefix_events:
        imm r20, 596
        imm r21, 345
        imm r22, 50502
        imm r23, 2
        imm r24, 0
        imm r25, 31465
        imm r26, 50511              ; checked EIDS continuation
        call summary_require_call_site
        imm r20, 597
        imm r21, 345
        imm r22, 4
        imm r23, 50542              ; exact colon/newline emit
        call exact_require_event
        imm r20, 598
        imm r21, 345
        imm r22, 50602
        imm r23, 1
        imm r24, 0
        imm r25, 29903
        imm r26, 50611              ; checked EPRO continuation
        call summary_require_call_site
        imm r20, 599
        imm r21, 347
        imm r22, 50841
        imm r23, 1
        imm r24, 0
        imm r25, 30596
        imm r26, 50850              ; checked EPAR continuation
        call summary_require_call_site
        ret

parse_output_prefix_locals:
        imm r20, 231
        imm r21, 345
        imm r22, 1
        imm r23, 0
        imm r24, 50400              ; saved nameoff
        call transfer_require_local
        imm r20, 232
        imm r21, 345
        imm r22, 1
        imm r23, 1
        imm r24, 50435              ; saved namelen
        call transfer_require_local
        imm r20, 233
        imm r21, 345
        imm r22, 1
        imm r23, 3
        imm r24, 50551              ; saved nslots
        call transfer_require_local
        imm r20, 234
        imm r21, 345
        imm r22, 2
        imm r23, 4
        imm r24, 50621              ; k := 0
        call transfer_require_local
        imm r20, 235
        imm r21, 346
        imm r22, 1
        imm r23, 4
        imm r24, 50649              ; guard k
        call transfer_require_local
        imm r20, 236
        imm r21, 346
        imm r22, 1
        imm r23, 2
        imm r24, 50684              ; guard nparams
        call transfer_require_local
        imm r20, 237
        imm r21, 347
        imm r22, 1
        imm r23, 4
        imm r24, 50790              ; EPAR argument k
        call transfer_require_local
        imm r20, 238
        imm r21, 347
        imm r22, 2
        imm r23, 4
        imm r24, 50917              ; store successor k
        call transfer_require_local
        imm r20, 239
        imm r21, 347
        imm r22, 1
        imm r23, 4
        imm r24, 50850              ; RHS k after dead EPAR result
        call transfer_require_local
        ret

parse_output_prefix_primitives:
        imm r20, 801
        imm r21, 345
        imm r22, 1
        imm r23, 0
        imm r24, 50611
        call transfer_require_primitive
        imm r20, 802
        imm r21, 346
        imm r22, 3
        imm r23, 8                   ; k<nparams
        imm r24, 50703
        call transfer_require_primitive
        imm r20, 803
        imm r21, 347
        imm r22, 2
        imm r23, 3                   ; k+1
        imm r24, 50895
        call transfer_require_primitive
        imm r20, 804
        imm r21, 347
        imm r22, 1
        imm r23, 1
        imm r24, 50885
        call transfer_require_primitive
        ret

parse_output_prefix_pushes:
        imm r20, 230
        imm r21, 346
        imm r23, 50668
        call exact_require_binary_push
        imm r20, 231
        imm r21, 347
        imm r23, 50869
        call exact_require_binary_push
        imm r20, 367
        imm r21, 345
        imm r23, 50419
        call exact_require_argument_push
        imm r20, 368
        imm r21, 345
        imm r23, 50454
        call exact_require_argument_push
        imm r20, 369
        imm r21, 345
        imm r23, 50570
        call exact_require_argument_push
        imm r20, 370
        imm r21, 347
        imm r23, 50809
        call exact_require_argument_push
        ret

parse_output_prefix_censuses:
        imm r20, 345
        imm r21, 347
        imm r22, 231
        imm r23, 240                 ; exclusive local row
        imm r24, 95
        imm r25, 95                  ; no raw memory
        imm r26, 282
        imm r27, 286
        imm r28, 596
        imm r29, 600                 ; exclusive event row
        call exact_require_effect_census
        imm r20, 345
        imm r21, 347
        imm r22, 801
        imm r23, 805                 ; exclusive primitive row
        imm r24, 230
        imm r25, 232
        imm r26, 367
        imm r27, 371
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census
        imm r20, 50400
        imm r21, 50945
        imm r22, 4                   ; EIDS/WSTR/EPRO/EPAR calls
        imm r23, 0                   ; this source interval contains no returns
        imm r24, 8                   ; argument/binary/local stores
        call exact_quiet_scan_region
        ret
