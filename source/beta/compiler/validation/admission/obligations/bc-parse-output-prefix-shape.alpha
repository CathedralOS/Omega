; Exact shape for parse_proc slotsready/sloop/sbody (blocks 345..347).
;
; This region calls EIDS, one fixed WSTR event, EPRO, and EPAR, initializes k,
; tests k<nparams, increments k, and exits at genbody. The adjacent summary
; owns the carried values, output concatenation, and bounded-loop induction.

parse_output_prefix_require_shape:
        imm r20, 68
        call call_bounds_frame_bytes
        imm r1, 48
        jeq r0, r1, parse_output_prefix_blocks
        jmp reject

parse_output_prefix_blocks:
        imm r20, 345
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 346
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 347
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 348
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        call parse_output_prefix_transitions
        call parse_output_prefix_events
        call parse_output_prefix_locals
        call parse_output_prefix_primitives
        call parse_output_prefix_pushes
        call parse_output_prefix_censuses
        ret

parse_output_prefix_transitions:
        imm r20, 282
        imm r21, 345
        imm r22, 0
        imm r23, 346
        call exact_transition_identity_pc
        imm r20, 283
        imm r21, 346
        imm r22, 1
        imm r23, 347
        call exact_transition_identity_pc ; checked k<nparams guard
        imm r20, 284
        imm r21, 346
        imm r22, 0
        imm r23, 348
        call exact_transition_identity_pc ; checked loop exit
        imm r20, 285
        imm r21, 347
        imm r22, 0
        imm r23, 346
        call exact_transition_identity_pc ; checked increment backedge
        ret

parse_output_prefix_events:
        imm r20, 68
        imm r21, 345
        imm r23, 2
        mov r22, r23
        imm r23, 0
        imm r24, 45                 ; emit_ident_at procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 345
        imm r22, parse_output_prefix_colon_newline
        imm r23, 2
        call exact_unique_emit_event_identity
        imm r2, 597                 ; preserve the semantic source event row
        jeq r1, r2, parse_output_prefix_emit_identity_ok
        jmp reject
parse_output_prefix_emit_identity_ok:
        imm r20, 68
        imm r21, 345
        imm r22, 1
        imm r23, 0
        imm r24, 42                 ; emit_proc_prologue procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 347
        imm r22, 1
        imm r23, 0
        imm r24, 43                 ; emit_param_store procedure identity
        call summary_require_call_fallthrough_identity
        ret

parse_output_prefix_locals:
        imm r20, 231
        imm r21, 345
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc ; saved nameoff
        imm r20, 232
        imm r21, 345
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc ; saved namelen
        imm r20, 233
        imm r21, 345
        imm r22, 1
        imm r23, 3
        call exact_local_identity_pc ; saved nslots
        imm r20, 234
        imm r21, 345
        imm r22, 2
        imm r23, 4
        call exact_local_identity_pc ; k := 0
        imm r20, 235
        imm r21, 346
        imm r22, 1
        imm r23, 4
        call exact_local_identity_pc ; guard k
        imm r20, 236
        imm r21, 346
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc ; guard nparams
        imm r20, 237
        imm r21, 347
        imm r22, 1
        imm r23, 4
        call exact_local_identity_pc ; EPAR argument k
        imm r20, 238
        imm r21, 347
        imm r22, 2
        imm r23, 4
        call exact_local_identity_pc ; store successor k
        imm r20, 239
        imm r21, 347
        imm r22, 1
        imm r23, 4
        call exact_local_identity_pc ; RHS k after dead EPAR result
        ret

parse_output_prefix_primitives:
        imm r20, 801
        imm r21, 345
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 802
        imm r21, 346
        imm r22, 3
        imm r23, 8                   ; k<nparams
        call exact_primitive_identity_pc
        imm r20, 803
        imm r21, 347
        imm r22, 2
        imm r23, 3                   ; k+1
        call exact_primitive_identity_pc
        imm r20, 804
        imm r21, 347
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        ret

parse_output_prefix_pushes:
        imm r20, 230
        imm r21, 346
        call exact_require_binary_push_identity
        imm r20, 231
        imm r21, 347
        call exact_require_binary_push_identity
        imm r20, 367
        imm r21, 345
        call exact_require_argument_push_identity
        imm r20, 368
        imm r21, 345
        call exact_require_argument_push_identity
        imm r20, 369
        imm r21, 345
        call exact_require_argument_push_identity
        imm r20, 370
        imm r21, 347
        call exact_require_argument_push_identity
        ret

parse_output_prefix_censuses:
        imm r20, 345
        imm r21, 347
        imm r22, 231
        imm r23, 240                 ; exclusive local row
        imm r24, 95
        imm r25, 95                  ; no raw memory
        imm r26, 282
        imm r27, 286
        imm r28, 596
        imm r29, 600                 ; exclusive event row
        call exact_require_effect_census
        imm r20, 345
        imm r21, 347
        imm r22, 801
        imm r23, 805                 ; exclusive primitive row
        imm r24, 230
        imm r25, 232
        imm r26, 367
        imm r27, 371
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census
        imm r20, 345
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        mov r30, r0                 ; checked scan start
        imm r20, 348
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        mov r21, r0                 ; checked exclusive scan end
        mov r20, r30
        imm r22, 4                   ; EIDS/WSTR/EPRO/EPAR calls
        imm r23, 0                   ; this source interval contains no returns
        imm r24, 8                   ; argument/binary/local stores
        call exact_quiet_scan_region
        ret

parse_output_prefix_colon_newline:
        db ":\n"
