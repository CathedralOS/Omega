        imm r22, 1
        imm r23, 3
        call exact_local_identity_pc
        imm r20, 108
        imm r21, 195
        imm r22, 1
        imm r23, 3
        call exact_local_identity_pc
        imm r20, 109
        imm r21, 196
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 110
        imm r21, 199
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 111
        imm r21, 199
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 112
        imm r21, 200
        imm r22, 2
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 113
        imm r21, 200
        imm r22, 1
        imm r23, 1
        call exact_local_identity_pc
        imm r20, 114
        imm r21, 202
        imm r22, 2
        imm r23, 2
