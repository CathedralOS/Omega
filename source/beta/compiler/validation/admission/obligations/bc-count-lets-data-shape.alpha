        imm r20, 514
        imm r21, 199
        imm r22, 2
        imm r23, 3                   ; depth + 1
        call exact_primitive_identity_pc
        imm r20, 515
        imm r21, 199
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 516
        imm r21, 200
        imm r22, 2
        imm r23, 4                   ; depth - 1
        call exact_primitive_identity_pc
        imm r20, 517
        imm r21, 200
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 518
        imm r21, 201
        imm r22, 3
        imm r23, 10                  ; is_let() == 1
        call exact_primitive_identity_pc
        imm r20, 519
        imm r21, 201
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 520
        imm r21, 202
        imm r22, 2
        imm r23, 3                   ; count + 1
        call exact_primitive_identity_pc
        imm r20, 521
        imm r21, 202
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 522
        imm r21, 203
        imm r22, 1
        imm r23, 2097144             ; checked restored CUR address
        call exact_primitive_identity_pc
        ret

