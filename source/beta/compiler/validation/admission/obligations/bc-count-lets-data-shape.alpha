        imm r20, 115
        imm r21, 202
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc
        imm r20, 116
        imm r21, 203
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 117
        imm r21, 203
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc
        ret

count_lets_require_memory:
        imm r20, 52
        imm r21, 193
        imm r25, 496
        imm r26, 2097144            ; entry CUR load
        call exact_memory_load_pc
        imm r20, 53
        imm r21, 203
        call exact_memory_store_pc  ; checked final CUR restoration
        ret

count_lets_require_primitives:
        ; Stable row/block/kind/value-or-opcode identities.
        imm r20, 496
        imm r21, 193
        imm r22, 1
        imm r23, 2097144             ; CUR
        call exact_primitive_identity_pc
        imm r20, 497
        imm r21, 193
        imm r22, 1
