        imm r23, 125                 ; checked close brace
        call exact_primitive_identity_pc
        imm r20, 511
        imm r21, 195
        imm r22, 3
        imm r23, 10                  ; is_alpha(c) == 1
        call exact_primitive_identity_pc
        imm r20, 512
        imm r21, 195
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 513
