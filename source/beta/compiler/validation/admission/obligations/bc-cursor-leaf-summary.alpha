; Selected relational summaries for cbyte, adv, and is_space.
;
; Shared cursor premise: LEN=L with 0<=L<=1048576, SRC[0:L] equal to the
; successful slurp segment, and CUR=i a nonnegative signed word below 2^63.
;
;   cbyte:   i<L  -> zext8(SRC[i]); i>=L -> 0, with no global/I/O mutation
;   adv:      under i<L, store CUR=i+1<=L
;   is_space: return 1 iff c is one of {32,9,10,13}, else zero
;
; An in-range NUL therefore makes cbyte return zero without being physical EOF.
; The signed/nonnegative cursor premise prevents a high-bit index from taking
; cbyte's signed `< LEN` hit edge.  These are reusable conditional clauses; the
; following skip_ws_step phase supplies their selected call-site premises.
; Scratch registers and reclaimed private-frame bytes are outside preservation.
; The canonical procedure inventory owns each leaf's total block span and
; entry/state partition; these summaries retain their semantic edges/effects.
;
; Fresh cells:
;   public cbyte/adv/space tokens      525960/525968/525976
;   cbyte relation/local/value        525984/525992/526000/526008
;   cbyte hit/miss clauses            526016/526024
;   adv relation/value/delta/clause   526032/526040/526048/526056
;   space case/completion flags       526064/526072..526104
;   space result / comparison flags   526112/526120..526144
;   cursor-domain / source-segment    526152/526160
;
; cbyte relation: 1=CUR<LEN, 2=LEN<=CUR. Selected value kinds:
; 1=SRC[CUR], 2=zero. Space cases: 1=32,2=9,3=10,4=13,5=other.

cursor_leaf_summary_init:
        call cursor_require_cbyte_shape
        call cursor_prove_cbyte
        call cursor_require_adv_shape
        call cursor_prove_adv
        call cursor_require_space_shape
        call cursor_prove_space
        jmp skip_ws_summary_init

; ---- cbyte -------------------------------------------------------------

cursor_require_cbyte_shape:
        imm r20, 4
        imm r21, 0
        imm r22, 1
        imm r23, 16
        call exact_require_proc_frame_identity
        imm r20, 8
        imm r21, 10
        imm r22, 4
        call exact_require_proc_blocks

        imm r20, 4
        imm r21, 9
        imm r22, 1
        imm r23, 10
        call exact_transition_identity_pc

        imm r20, 14
        imm r21, 8
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 15
        imm r21, 9
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 16
        imm r21, 10
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc

        imm r20, 11
        imm r21, 8
        imm r25, 29
        imm r26, 2097144
        call exact_memory_load_pc
        imm r20, 12
        imm r21, 9
        imm r25, 31
        imm r26, 2097136
        call exact_memory_load_pc
        imm r20, 13
        imm r21, 10
        imm r22, 1
        imm r23, 1
        call exact_memory_identity_pc
        mov r39, r0                   ; checked byte-load successor target

        imm r20, 30
        imm r21, 9
        imm r22, 3
        imm r23, 8
        call exact_primitive_identity_pc
        imm r20, 32
        imm r21, 9
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 33
        imm r21, 10
        imm r22, 1
        imm r23, 2097152
        call exact_primitive_identity_pc
        imm r20, 34
        imm r21, 10
        imm r22, 2
        imm r23, 3
        call exact_primitive_identity_pc
        mov r38, r0
        imm r20, 34
        call exact_expr_primitive_extent
        jeq r0, r38, cursor_cbyte_byte_load_start
        jmp reject
cursor_cbyte_byte_load_start:
        jeq r1, r39, cursor_cbyte_byte_load_rejoined
        jmp reject
cursor_cbyte_byte_load_rejoined:
        imm r20, 5
        imm r21, 9
        call exact_require_binary_push_identity
        imm r20, 6
        imm r21, 10
        call exact_require_binary_push_identity

        imm r20, 4                    ; cbyte procedure identity
        imm r21, 9
        call exact_require_event_epilogue
        imm r20, 4
        imm r21, 10
        call exact_require_event_epilogue
        imm r20, 5                    ; adv identifies synthetic return
        call exact_require_preentry_epilogue
        imm r20, 4                    ; cbyte procedure identity / region start
        call exact_proc_entry_r20
        imm r21, 5                    ; adv procedure identity / region end
        call exact_proc_entry_r21
        imm r22, 3
        call cursor_scan_quiet_region
        imm r20, 8
        imm r21, 10
        imm r22, 14
        imm r23, 17                   ; checked exclusive local row
        imm r24, 11
        imm r25, 14
        imm r26, 4
        imm r27, 5
        imm r28, 8
        imm r29, 10
        call exact_require_effect_census
        ret

cursor_prove_cbyte:
        imm r1, 525960
        imm r2, 0
        store r1, r2
        imm r1, 526016
        store r1, r2
        imm r1, 526024
        store r1, r2

        ; Import the exact successful slurp segment, then introduce the shared
        ; conditional cursor premise used by both partitions.  Later callers
        ; must carry this domain token while adv changes CUR.
        call cursor_require_success_segment
        call cursor_introduce_domain

        ; Hit partition: 0<=CUR<LEN<=CAP. Exact CUR load/store-to-local,
        ; comparison, SRC+local address, and byte load derive SRC[CUR].
        imm r1, 525984
        imm r2, 1                    ; checked hit relation CUR<LEN
        store r1, r2
        call cursor_cbyte_load_cur
        call cursor_cbyte_take_hit
        call cursor_cbyte_load_source
        imm r20, 1
        imm r21, 1
        call cursor_cbyte_require_value
        imm r1, 526016
        imm r2, 1
        store r1, r2

        ; Miss partition includes CUR=LEN and every larger nonnegative signed
        ; cursor. The false edge returns literal zero and never executes row13.
        imm r1, 525984
        imm r2, 2                    ; checked miss relation LEN<=CUR
        store r1, r2
        call cursor_cbyte_load_cur
        call cursor_cbyte_take_miss
        imm r20, 2
        imm r21, 0
        call cursor_cbyte_set_value
        imm r1, 526024
        imm r2, 1
        store r1, r2

        imm r20, 526016
        imm r21, 1
        call exact_require_cell
        imm r20, 526024
        imm r21, 1
        call exact_require_cell
        imm r1, 525960
        imm r2, 1128421445            ; CBLE
        store r1, r2
        ret

cursor_cbyte_load_cur:
        imm r1, 525992
        imm r2, 1                    ; local i derives current CUR
        store r1, r2
        ret

cursor_cbyte_take_hit:
        call cursor_require_domain
        imm r20, 525984
        imm r21, 1
        call exact_require_cell
        imm r20, 525992
        imm r21, 1
        call exact_require_cell
        ret

cursor_cbyte_take_miss:
        call cursor_require_domain
        imm r20, 525984
        imm r21, 2
        call exact_require_cell
        imm r20, 525992
        imm r21, 1
        call exact_require_cell
        ret

cursor_cbyte_load_source:
        call cursor_require_segment
        imm r20, 525984
        imm r21, 1
        call exact_require_cell
        imm r20, 525992
        imm r21, 1                    ; checked SRC index from local i
        call exact_require_cell
        ; CUR<LEN<=CAP proves SRC+CUR in [2097152,3145728), nonwrapping and
        ; disjoint from stack/global regions. The successful slurp token gives
        ; exact byte provenance, including the possibility that the byte is 0.
        imm r20, 1
        imm r21, 1
        jmp cursor_cbyte_set_value

cursor_cbyte_set_value:
        imm r1, 526000
        store r1, r20
        imm r1, 526008
        store r1, r21
        ret

cursor_cbyte_require_value:
        imm r1, 526000
        load r2, r1
        jeq r2, r20, cursor_cbyte_value_payload
        jmp reject
cursor_cbyte_value_payload:
        imm r1, 526008
        load r2, r1
        jeq r2, r21, exact_shape_ok
        jmp reject

; ---- adv ---------------------------------------------------------------

cursor_require_adv_shape:
        imm r20, 5
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call exact_require_proc_frame_identity
        imm r20, 11
        imm r21, 11
        imm r22, 5
        call exact_require_proc_blocks

        imm r20, 14
        imm r21, 11
        call exact_memory_store_pc
        imm r20, 15
        imm r21, 11
        imm r25, 36
        imm r26, 2097144
        call exact_memory_load_pc
        imm r20, 35
        imm r21, 11
        imm r22, 1
        imm r23, 2097144
        call exact_primitive_identity_pc
        imm r20, 36
        imm r21, 11
        imm r22, 1
        imm r23, 2097144
        call exact_primitive_identity_pc
        imm r20, 37
        imm r21, 11
        imm r22, 2
        imm r23, 3
        call exact_primitive_identity_pc
        imm r20, 38
        imm r21, 11
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 7
        imm r21, 11
        call exact_require_binary_push_identity
        imm r20, 380
        imm r21, 11
        call exact_require_store_push_identity
        imm r20, 6                    ; is_digit identifies synthetic return
        call exact_require_preentry_epilogue
        imm r20, 5                    ; adv procedure identity / region start
        call exact_proc_entry_r20
        imm r21, 6                    ; is_digit procedure identity / region end
        call exact_proc_entry_r21
        imm r22, 1
        call cursor_scan_quiet_region
        imm r20, 11
        imm r21, 11
        imm r22, 0
        imm r23, 0                    ; no local rows
        imm r24, 14
        imm r25, 16
        imm r26, 0
        imm r27, 0                    ; no source transitions
        imm r28, 0
        imm r29, 0                    ; no explicit source events
        call exact_require_effect_census
        ret

cursor_prove_adv:
        imm r1, 525968
        imm r2, 0
        store r1, r2
        call cursor_require_success_segment
        call cursor_introduce_domain
        imm r1, 526032
        imm r2, 1                    ; 0<=CUR<LEN<=CAP
        store r1, r2
        imm r1, 526040
        imm r2, 1                    ; selected old CUR
        store r1, r2
        imm r1, 526048
        imm r2, 1                    ; checked CUR increment delta
        store r1, r2
        call cursor_adv_store_successor
        imm r20, 526040
        imm r21, 2                    ; checked CUR successor
        call exact_require_cell
        imm r1, 526056
        imm r2, 1
        store r1, r2
        imm r20, 526056
        imm r21, 1
        call exact_require_cell
        imm r1, 525968
        imm r2, 1094992965            ; ADVE
        store r1, r2
        ret

cursor_adv_store_successor:
        call cursor_require_domain
        imm r20, 526032
        imm r21, 1
        call exact_require_cell
        imm r20, 526040
        imm r21, 1
        call exact_require_cell
        imm r20, 526048
        imm r21, 1
        call exact_require_cell
        ; Exact wrapping addition is nonwrapping under CUR<LEN<=CAP; the sole
        ; raw store writes CUR+1<=LEN back to fixed address 2097144.
        imm r1, 526040
        imm r2, 2                    ; selected CUR successor
        store r1, r2
        ret

; ---- is_space ----------------------------------------------------------

cursor_require_space_shape:
        imm r20, 9
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call exact_require_proc_frame_identity
        imm r20, 27
        imm r21, 32
        imm r22, 9
        call exact_require_proc_blocks

        imm r20, 18
        imm r21, 28
        imm r22, 1
        imm r23, 32
        call exact_transition_identity_pc
        imm r20, 19
        imm r21, 28
        imm r22, 0
        imm r23, 29
        call exact_transition_identity_pc
        imm r20, 20
        imm r21, 29
        imm r22, 1
        imm r23, 32
        call exact_transition_identity_pc
        imm r20, 21
        imm r21, 29
        imm r22, 0
        imm r23, 30
        call exact_transition_identity_pc
        imm r20, 22
        imm r21, 30
        imm r22, 1
        imm r23, 32
        call exact_transition_identity_pc
        imm r20, 23
        imm r21, 30
        imm r22, 0
        imm r23, 31
        call exact_transition_identity_pc
        imm r20, 24
        imm r21, 31
        imm r22, 1
        imm r23, 32
        call exact_transition_identity_pc

        imm r20, 26
        imm r21, 28
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 27
        imm r21, 29
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 28
        imm r21, 30
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 29
        imm r21, 31
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc

        imm r20, 61
        imm r21, 28
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 62
        imm r21, 28
        imm r22, 1
        imm r23, 32
        call exact_primitive_identity_pc
        imm r20, 63
        imm r21, 29
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 64
        imm r21, 29
        imm r22, 1
        imm r23, 9
        call exact_primitive_identity_pc
        imm r20, 65
        imm r21, 30
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 66
        imm r21, 30
        imm r22, 1
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 67
        imm r21, 31
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 68
        imm r21, 31
        imm r22, 1
        imm r23, 13
        call exact_primitive_identity_pc
        imm r20, 69
        imm r21, 31
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 70
        imm r21, 32
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc

        imm r20, 16
        imm r21, 28
        call exact_require_binary_push_identity
        imm r20, 17
        imm r21, 29
        call exact_require_binary_push_identity
        imm r20, 18
        imm r21, 30
        call exact_require_binary_push_identity
        imm r20, 19
        imm r21, 31
        call exact_require_binary_push_identity

        imm r20, 9                    ; is_space procedure identity
        imm r21, 31
        call exact_require_event_epilogue
        imm r20, 9
        imm r21, 32
        call exact_require_event_epilogue
        imm r20, 10                   ; skip_ws identifies synthetic return
        call exact_require_preentry_epilogue
        imm r20, 9                    ; is_space identity / region start
        call exact_proc_entry_r20
        imm r21, 10                   ; skip_ws identity / region end
        call exact_proc_entry_r21
        imm r22, 3
        call cursor_scan_quiet_region
        imm r20, 27
        imm r21, 32
        imm r22, 26
        imm r23, 30
        imm r24, 0
        imm r25, 0                    ; no raw-memory rows
        imm r26, 18
        imm r27, 25
        imm r28, 19
        imm r29, 21
        call exact_require_effect_census
        ret

cursor_prove_space:
        imm r1, 525976
        imm r2, 0
        store r1, r2
        imm r10, 1
cursor_space_case_loop:
        imm r1, 6
        jlt r10, r1, cursor_space_case
        imm r10, 1
cursor_space_flags_loop:
        imm r1, 6
        jlt r10, r1, cursor_space_flag
        imm r1, 525976
        imm r2, 1397769539            ; SPAC
        store r1, r2
        ret
cursor_space_case:
        imm r1, 526064
        store r1, r10
        mov r20, r10
        call cursor_space_set_comparison_pattern
        mov r20, r10
        call cursor_space_run_case
        mov r2, r10
        imm r1, 1
        sub r2, r1
        imm r1, 8
        mul r2, r1
        imm r1, 526072
        add r1, r2
        imm r2, 1
        store r1, r2
        imm r1, 1
        add r10, r1
        jmp cursor_space_case_loop
cursor_space_flag:
        mov r2, r10
        imm r1, 1
        sub r2, r1
        imm r1, 8
        mul r2, r1
        imm r1, 526072
        add r1, r2
        load r3, r1
        imm r1, 1
        jeq r3, r1, cursor_space_flag_next
        jmp reject
cursor_space_flag_next:
        imm r1, 1
        add r10, r1
        jmp cursor_space_flags_loop

cursor_space_run_case:
        ; Parameter-store custody makes all four local loads the same c.
        imm r1, 1
        jeq r20, r1, cursor_space_case_32
        imm r1, 2
        jeq r20, r1, cursor_space_case_9
        imm r1, 3
        jeq r20, r1, cursor_space_case_10
        imm r1, 4
        jeq r20, r1, cursor_space_case_13
        imm r1, 5
        jeq r20, r1, cursor_space_case_other
        jmp reject
cursor_space_case_32:
        imm r20, 1
        imm r21, 1
        call cursor_space_require_comparison
        imm r20, 1
        imm r21, 1
        jmp cursor_space_set_result
cursor_space_case_9:
        imm r20, 1
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 2
        imm r21, 1
        call cursor_space_require_comparison
        imm r20, 1
        imm r21, 1
        jmp cursor_space_set_result
cursor_space_case_10:
        imm r20, 1
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 2
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 3
        imm r21, 1
        call cursor_space_require_comparison
        imm r20, 1
        imm r21, 1
        jmp cursor_space_set_result
cursor_space_case_13:
        imm r20, 1
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 2
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 3
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 4
        imm r21, 1
        call cursor_space_require_comparison
        imm r20, 1
        imm r21, 1                    ; checked CR is whitespace
        jmp cursor_space_set_result
cursor_space_case_other:
        imm r20, 1
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 2
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 3
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 4
        imm r21, 0
        call cursor_space_require_comparison
        imm r20, 2                    ; checked other-result kind
        imm r21, 0                    ; all other words, including zero
        jmp cursor_space_set_result

; The five mutually exclusive partitions of four equalities are encoded as
; 1000, 0100, 0010, 0001, and 0000.  Because all four checked local loads use
; parameter slot zero, these are exactly c=32, c=9, c=10, c=13, and other.
cursor_space_set_comparison_pattern:
        mov r25, r20
        imm r11, 1
cursor_space_clear_comparisons:
        imm r1, 5
        jlt r11, r1, cursor_space_clear_comparison
        imm r1, 5
        jeq r25, r1, exact_shape_ok
        mov r20, r25
        imm r21, 1
        jmp cursor_space_store_comparison
cursor_space_clear_comparison:
        mov r20, r11
        imm r21, 0
        call cursor_space_store_comparison
        imm r1, 1
        add r11, r1
        jmp cursor_space_clear_comparisons

cursor_space_store_comparison:
        mov r2, r20
        imm r1, 1
        sub r2, r1
        imm r1, 8
        mul r2, r1
        imm r1, 526120
        add r1, r2
        store r1, r21
        ret

cursor_space_require_comparison:
        mov r2, r20
        imm r1, 1
        sub r2, r1
        imm r1, 8
        mul r2, r1
        imm r1, 526120
        add r1, r2
        load r2, r1
        jeq r2, r21, exact_shape_ok
        jmp reject

cursor_space_set_result:
        imm r1, 526112
        store r1, r20                 ; 1=one,2=zero
        imm r1, 526064
        load r2, r1
        imm r3, 5
        jeq r2, r3, cursor_space_expect_zero
        imm r3, 1
        jeq r20, r3, cursor_space_expect_one_payload
        jmp reject
cursor_space_expect_one_payload:
        imm r3, 1
        jeq r21, r3, exact_shape_ok
        jmp reject
cursor_space_expect_zero:
        imm r3, 2
        jeq r20, r3, cursor_space_expect_zero_payload
        jmp reject
cursor_space_expect_zero_payload:
        imm r3, 0
        jeq r21, r3, exact_shape_ok
        jmp reject

; The successful slurp theorem supplies LEN=L in [0,CAP] and exact
; SRC[0:L]=input[0:L].  The leaf clauses are conditional on a caller-carried
; nonnegative signed CUR; relation 1 further selects CUR<LEN and relation 2
; selects LEN<=CUR.  Keeping these two premises distinct prevents a checked
; source address from being manufactured from the numeric range alone.
cursor_require_success_segment:
        imm r20, 525744
        imm r21, 1
        call exact_require_cell
        imm r1, 526160
        imm r2, 1
        store r1, r2
        ret

cursor_introduce_domain:
        call cursor_require_segment
        imm r1, 526152
        imm r2, 1                    ; checked 0<=CUR<2^63, LEN<=CAP
        store r1, r2
        ret

cursor_require_domain:
        imm r20, 526152
        imm r21, 1
        jmp exact_require_cell

cursor_require_segment:
        imm r20, 526160
        imm r21, 1
        jmp exact_require_cell

; Region [r20,r21) has exactly r22 returns and no direct input/output, nested
; call, halt, division, or remainder. Stack/local/raw accesses were already
; partitioned by prior phases and the selected rows above.
cursor_scan_quiet_region:
        mov r25, r20
        mov r26, r21
        mov r27, r22
        imm r28, 0
cursor_quiet_loop:
        jlt r25, r26, cursor_quiet_pc
        jeq r28, r27, exact_shape_ok
        jmp reject
cursor_quiet_pc:
        imm r1, 4194304
        add r1, r25
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, cursor_quiet_start
        jmp cursor_quiet_next
cursor_quiet_start:
        imm r1, 2097152
        add r1, r25
        loadb r2, r1
        imm r3, 20
        jeq r2, r3, cursor_quiet_ret
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 6
        jeq r2, r3, reject
        imm r3, 7
        jeq r2, r3, reject
        imm r3, 17
        jeq r2, r3, reject
        imm r3, 18
        jeq r2, r3, reject
        imm r3, 19
        jeq r2, r3, reject
        jmp cursor_quiet_next
cursor_quiet_ret:
        imm r1, 1
        add r28, r1
cursor_quiet_next:
        imm r1, 1
        add r25, r1
        jmp cursor_quiet_loop
