; Exact control/effect shape for parse_proc's parameter and capacity slice.
;
; This module owns blocks 339..344 semantically while rejoining all procedure-68
; block PCs to bind their ownership. It closes transitions 274..281, ten calls,
; three pre-output returns/epilogues, the 48-byte frame, exhaustive effect rows,
; and the decoded region from block339 through the entry of block345.
; Local/memory/expression payloads are kept in bc-parse-params-data-shape.alpha.

parse_params_require_control_shape:
        imm r20, 7151616
        imm r21, 68
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 68
        imm r22, 5
        call transfer_require_cell
        imm r20, 68
        call call_bounds_frame_bytes
        imm r1, 48
        jeq r0, r1, parse_params_shape_blocks
        jmp reject

parse_params_shape_blocks:
        imm r20, 338
        imm r21, 68                    ; parse_proc procedure identity
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 339
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 340
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 341
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 342
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 343
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 344
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 345
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 346
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 347
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 348
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 338
        imm r21, 348
        imm r22, 68
        call exact_require_proc_blocks
        call parse_params_require_transitions
        call parse_params_require_events
        call parse_params_require_control_census
        ret

parse_params_require_transitions:
        imm r20, 274
        imm r21, 339
        imm r22, 1
        imm r23, 340
        call exact_transition_identity_pc ; checked non-close parameter guard
        imm r20, 275
        imm r21, 339
        imm r22, 0
        imm r23, 344
        call exact_transition_identity_pc
        imm r20, 276
        imm r21, 340
        imm r22, 1
        imm r23, 341
        call exact_transition_identity_pc ; checked NLOC<4 guard
        imm r20, 277
        imm r21, 341
        imm r22, 1
        imm r23, 342
        call exact_transition_identity_pc ; checked declaration-status guard
        imm r20, 278
        imm r21, 341
        imm r22, 1
        imm r23, 343
        call exact_transition_identity_pc ; checked comma guard
        imm r20, 279
        imm r21, 341
        imm r22, 0
        imm r23, 339
        call exact_transition_identity_pc
        imm r20, 280
        imm r21, 343
        imm r22, 0
        imm r23, 339
        call exact_transition_identity_pc
        imm r20, 281
        imm r21, 344
        imm r22, 1
        imm r23, 345
        call exact_transition_identity_pc ; checked nslots<=1024 guard
        ret

parse_params_require_events:
        imm r20, 68
        imm r21, 339
        imm r22, 0
        imm r23, 0
        imm r24, 4                  ; cbyte procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 340
        call exact_require_event_epilogue

        imm r20, 68
        imm r21, 341
        imm r22, 0
        imm r23, 0
        imm r24, 12                 ; read_ident procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 341
        imm r22, 0
        imm r23, 0
        imm r24, 34                 ; declare procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 341
        imm r22, 0
        imm r23, 0
        imm r24, 10                 ; skip_ws procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 341
        imm r22, 0
        imm r23, 0
        imm r24, 4                  ; cbyte procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 342
        call exact_require_event_epilogue
        imm r20, 68
        imm r21, 343
        imm r22, 0
        imm r23, 0
        imm r24, 5                  ; adv procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 343
        imm r22, 0
        imm r23, 0
        imm r24, 10                 ; skip_ws procedure identity
        call summary_require_call_fallthrough_identity

        imm r20, 68
        imm r21, 344
        imm r22, 0
        imm r23, 0
        imm r24, 5                  ; adv procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 344
        imm r22, 1
        imm r23, 0
        imm r24, 24                 ; expect procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 344
        imm r22, 0
        imm r23, 0
        imm r23, 1                  ; checked nparams ambient local
        imm r24, 39                 ; count_lets procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 68
        imm r21, 344
        call exact_require_event_epilogue
        ret

parse_params_require_control_census:
        imm r20, 339
        imm r21, 344
        imm r22, 227
        imm r23, 231
        imm r24, 88
        imm r25, 93
        imm r26, 274
        imm r27, 282                 ; checked exclusive params transition row
        imm r28, 583
        imm r29, 596                 ; checked exclusive params event row
        call exact_require_effect_census
        imm r20, 339
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        mov r30, r0                 ; checked scan start
        imm r20, 345
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        mov r21, r0                 ; checked exclusive scan end
        mov r20, r30
        imm r22, 10
        imm r23, 3
        call skip_scan_call_region
        ret
