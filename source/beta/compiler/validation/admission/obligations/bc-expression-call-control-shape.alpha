; Exact control/effect shape for gen_call() procedure32.
;
; This module has no initialization edge and publishes no semantic token.  Its
; single public entry fixes procedure metadata, all eighteen transitions, all
; twenty-six source effects and call handoffs, every explicit/synthetic
; epilogue, and the complete decoded region. The canonical procedure inventory
; owns the total block span and partition. The adjacent data-shape module owns
; local/raw-memory/expression rows and table censuses.

expression_call_require_shape:
        call expression_call_require_control_shape
        call expression_call_require_data_shape
        ret

expression_call_require_control_shape:
        call expression_call_control_require_proc
        call expression_call_control_require_transitions
        call expression_call_control_require_events
        call expression_call_control_require_region
        ret

expression_call_control_require_proc:
        imm r20, 32
        imm r21, 0
        imm r22, 4
        imm r23, 40
        call exact_require_proc_frame_identity
        imm r20, 150
        imm r21, 166
        imm r22, 32
        call exact_require_proc_blocks
        jmp exact_shape_ok

; Transition row/source block/guarded/target in r20..r23.
expression_call_control_require_transitions:
        imm r20, 108
        imm r21, 151
        imm r22, 1
        imm r23, 152
        call exact_transition_identity_pc
        imm r20, 109
        imm r21, 151
        imm r22, 0
        imm r23, 153
        call exact_transition_identity_pc
        imm r20, 110
        imm r21, 153
        imm r22, 1
        imm r23, 154
        call exact_transition_identity_pc
        imm r20, 111
        imm r21, 153
        imm r22, 0
        imm r23, 155
        call exact_transition_identity_pc
        imm r20, 112
        imm r21, 155
        imm r22, 1
        imm r23, 156
        call exact_transition_identity_pc
        imm r20, 113
        imm r21, 155
        imm r22, 0
        imm r23, 157
        call exact_transition_identity_pc
        imm r20, 114
        imm r21, 157
        imm r22, 0
        imm r23, 158
        call exact_transition_identity_pc
        imm r20, 115
        imm r21, 158
        imm r22, 1
        imm r23, 159
        call exact_transition_identity_pc
        imm r20, 116
        imm r21, 158
        imm r22, 0
        imm r23, 163
        call exact_transition_identity_pc
        imm r20, 117
        imm r21, 159
        imm r22, 1
        imm r23, 160
        call exact_transition_identity_pc
        imm r20, 118
        imm r21, 160
        imm r22, 1
        imm r23, 161
        call exact_transition_identity_pc
        imm r20, 119
        imm r21, 160
        imm r22, 1
        imm r23, 162
        call exact_transition_identity_pc
        imm r20, 120
        imm r21, 160
        imm r22, 0
        imm r23, 158
        call exact_transition_identity_pc
        imm r20, 121
        imm r21, 162
        imm r22, 0
        imm r23, 158
        call exact_transition_identity_pc
        imm r20, 122
        imm r21, 163
        imm r22, 0
        imm r23, 164
        call exact_transition_identity_pc
        imm r20, 123
        imm r21, 164
        imm r22, 1
        imm r23, 165
        call exact_transition_identity_pc
        imm r20, 124
        imm r21, 164
        imm r22, 0
        imm r23, 166
        call exact_transition_identity_pc
        imm r20, 125
        imm r21, 165
        imm r22, 0
        imm r23, 164
        call exact_transition_identity_pc
        ret

; r20=semantic event row, r21=block, r22=literal, r23=length.
expression_call_control_require_emit:
        mov r50, r20
        imm r20, 32                    ; gen_call owning procedure identity
        call exact_unique_emit_event_identity
        jeq r1, r50, expression_call_control_emit_ok
        jmp reject
expression_call_control_emit_ok:
        ret

; r21=source block, r22=arity, r23=target procedure identity. The event owner
; reconstructs the unique call PC, target entry, and fallthrough.
expression_call_control_require_call:
        mov r24, r23
        imm r23, 0
        imm r20, 32                    ; gen_call owning procedure identity
        call summary_require_call_fallthrough_identity
        ret

; r21=source block. The event owner reconstructs the unique source return and
; validates its canonical epilogue.
expression_call_control_require_return:
        imm r20, 32                    ; gen_call owning procedure identity
        call exact_require_event_epilogue
        ret

expression_call_control_require_events:
        ; Builtin-dispatch calls and returns.
        imm r21, 151
        imm r22, 0
        imm r23, 21                    ; is_read_byte procedure identity
        call expression_call_control_require_call
        imm r21, 152
        imm r22, 0
        imm r23, 30                    ; gen_read_byte procedure identity
        call expression_call_control_require_call
        imm r21, 152
        call expression_call_control_require_return
        imm r21, 153
        imm r22, 0
        imm r23, 22                    ; is_write_byte procedure identity
        call expression_call_control_require_call
        imm r21, 154
        imm r22, 0
        imm r23, 31                    ; gen_write_byte procedure identity
        call expression_call_control_require_call
        imm r21, 154
        call expression_call_control_require_return
        imm r21, 155
        imm r22, 0
        imm r23, 23                    ; is_emit procedure identity
        call expression_call_control_require_call
        imm r21, 156
        imm r22, 0
        imm r23, 28                    ; gen_emit procedure identity
        call expression_call_control_require_call
        imm r21, 156
        call expression_call_control_require_return

        ; Normal-call argument loop.
        imm r21, 157
        imm r22, 1
        imm r23, 24                    ; expect procedure identity
        call expression_call_control_require_call
        imm r21, 157
        imm r22, 0
        imm r23, 10                    ; skip_ws procedure identity
        call expression_call_control_require_call
        imm r21, 158
        imm r22, 0
        imm r23, 4                     ; cbyte procedure identity
        call expression_call_control_require_call
        imm r21, 159
        call expression_call_control_require_return
        imm r21, 160
        imm r22, 0
        imm r23, 61                    ; gen_expr procedure identity
        call expression_call_control_require_call
        imm r21, 160
        imm r22, 0
        imm r23, 47                    ; emit_push procedure identity
        call expression_call_control_require_call
        imm r21, 160
        imm r22, 0
        imm r23, 10                    ; skip_ws procedure identity
        call expression_call_control_require_call
        imm r21, 160
        imm r22, 0
        imm r23, 4                     ; cbyte procedure identity
        call expression_call_control_require_call
        imm r21, 161
        call expression_call_control_require_return
        imm r21, 162
        imm r22, 0
        imm r23, 5                     ; adv procedure identity
        call expression_call_control_require_call
        imm r21, 162
        imm r22, 0
        imm r23, 10                    ; skip_ws procedure identity
        call expression_call_control_require_call
        imm r21, 163
        imm r22, 0
        imm r23, 5                     ; adv procedure identity
        call expression_call_control_require_call
        imm r21, 165
        imm r22, 1
        imm r23, 44                    ; emit_pop_into procedure identity
        call expression_call_control_require_call

        ; Dynamic call spelling and final return.
        imm r20, 264
        imm r21, 166
        imm r22, expression_call_literal_call
        imm r23, 5
        call expression_call_control_require_emit
        imm r21, 166
        imm r22, 2
        imm r23, 45                    ; emit_ident_at procedure identity
        call expression_call_control_require_call
        imm r20, 266
        imm r21, 166
        imm r22, expression_call_literal_newline
        imm r23, 1
        call expression_call_control_require_emit
        imm r20, 32
        imm r21, 166
        call exact_require_event_epilogue
        imm r20, 33                    ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

expression_call_control_require_region:
        imm r20, 32                    ; gen_call procedure identity
        call exact_proc_entry_r20
        imm r21, 33                    ; parse_number procedure identity / end
        call exact_proc_entry_r21
        imm r22, 20
        imm r23, 7
        imm r24, 23
        call exact_quiet_scan_region
        ret

expression_call_literal_call:
        db "call "
expression_call_literal_newline:
        db "\n"
