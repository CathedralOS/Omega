; Exact control/effect shape for gen_call() procedure32.
;
; This module has no initialization edge and publishes no semantic token.  Its
; single public entry fixes procedure metadata, all seventeen blocks, all
; eighteen transitions, all twenty-six source effects and call handoffs, every
; explicit/synthetic epilogue, and the complete decoded region.  The adjacent
; data-shape module owns local/raw-memory/expression rows and table censuses.

expression_call_require_shape:
        call expression_call_require_control_shape
        call expression_call_require_data_shape
        ret

expression_call_require_control_shape:
        call expression_call_control_require_proc
        call expression_call_control_require_blocks
        call expression_call_control_require_transitions
        call expression_call_control_require_events
        call expression_call_control_require_region
        ret

expression_call_control_require_proc:
        imm r20, 7151616
        imm r21, 32
        imm r22, 0
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 32
        imm r22, 4
        call transfer_require_cell
        imm r20, 32
        call call_bounds_frame_bytes
        imm r1, 40
        jeq r0, r1, exact_shape_ok
        jmp reject

expression_call_control_require_blocks:
        imm r20, 150
        imm r21, 32                    ; gen_call procedure identity
        call exact_proc_entry_r21
        call exact_require_block_pc
        imm r20, 151
        imm r21, 21702
        call exact_require_block_pc
        imm r20, 152
        imm r21, 21824
        call exact_require_block_pc
        imm r20, 153
        imm r21, 21863
        call exact_require_block_pc
        imm r20, 154
        imm r21, 21985
        call exact_require_block_pc
        imm r20, 155
        imm r21, 22024
        call exact_require_block_pc
        imm r20, 156
        imm r21, 22146
        call exact_require_block_pc
        imm r20, 157
        imm r21, 22185
        call exact_require_block_pc
        imm r20, 158
        imm r21, 22347
        call exact_require_block_pc
        imm r20, 159
        imm r21, 22469
        call exact_require_block_pc
        imm r20, 160
        imm r21, 22677
        call exact_require_block_pc
        imm r20, 161
        imm r21, 23029
        call exact_require_block_pc
        imm r20, 162
        imm r21, 23059
        call exact_require_block_pc
        imm r20, 163
        imm r21, 23086
        call exact_require_block_pc
        imm r20, 164
        imm r21, 23142
        call exact_require_block_pc
        imm r20, 165
        imm r21, 23274
        call exact_require_block_pc
        imm r20, 166
        imm r21, 23429
        call exact_require_block_pc
        imm r20, 150
        imm r21, 166
        imm r22, 32
        call exact_require_proc_blocks
        ret

; Transition row/source block/guarded/target/control PC in r20..r24.
expression_call_control_require_transitions:
        imm r20, 108
        imm r21, 151
        imm r22, 1
        imm r23, 152
        imm r24, 21796
        call exact_require_transition
        imm r20, 109
        imm r21, 151
        imm r22, 0
        imm r23, 153
        imm r24, 21815
        call exact_require_transition
        imm r20, 110
        imm r21, 153
        imm r22, 1
        imm r23, 154
        imm r24, 21957
        call exact_require_transition
        imm r20, 111
        imm r21, 153
        imm r22, 0
        imm r23, 155
        imm r24, 21976
        call exact_require_transition
        imm r20, 112
        imm r21, 155
        imm r22, 1
        imm r23, 156
        imm r24, 22118
        call exact_require_transition
        imm r20, 113
        imm r21, 155
        imm r22, 0
        imm r23, 157
        imm r24, 22137
        call exact_require_transition
        imm r20, 114
        imm r21, 157
        imm r22, 0
        imm r23, 158
        imm r24, 22338
        call exact_require_transition
        imm r20, 115
        imm r21, 158
        imm r22, 1
        imm r23, 159
        imm r24, 22441
        call exact_require_transition
        imm r20, 116
        imm r21, 158
        imm r22, 0
        imm r23, 163
        imm r24, 22460
        call exact_require_transition
        imm r20, 117
        imm r21, 159
        imm r22, 1
        imm r23, 160
        imm r24, 22573
        call exact_require_transition
        imm r20, 118
        imm r21, 160
        imm r22, 1
        imm r23, 161
        imm r24, 22784
        call exact_require_transition
        imm r20, 119
        imm r21, 160
        imm r22, 1
        imm r23, 162
        imm r24, 23001
        call exact_require_transition
        imm r20, 120
        imm r21, 160
        imm r22, 0
        imm r23, 158
        imm r24, 23020
        call exact_require_transition
        imm r20, 121
        imm r21, 162
        imm r22, 0
        imm r23, 158
        imm r24, 23077
        call exact_require_transition
        imm r20, 122
        imm r21, 163
        imm r22, 0
        imm r23, 164
        imm r24, 23133
        call exact_require_transition
        imm r20, 123
        imm r21, 164
        imm r22, 1
        imm r23, 165
        imm r24, 23246
        call exact_require_transition
        imm r20, 124
        imm r21, 164
        imm r22, 0
        imm r23, 166
        imm r24, 23265
        call exact_require_transition
        imm r20, 125
        imm r21, 165
        imm r22, 0
        imm r23, 164
        imm r24, 23420
        call exact_require_transition
        ret

; r20=row, r21=block, r22=event PC.
expression_call_control_require_emit:
        mov r23, r22
        imm r22, 4
        call exact_require_event
        ret

; r21=source block, r22=arity, r23=target procedure identity. The event owner
; reconstructs the unique call PC, target entry, and fallthrough.
expression_call_control_require_call:
        mov r24, r23
        imm r23, 0
        imm r20, 32                    ; gen_call owning procedure identity
        call summary_require_call_fallthrough_identity
        ret

; r21=source block. The event owner reconstructs the unique source return and
; validates its canonical epilogue.
expression_call_control_require_return:
        imm r20, 32                    ; gen_call owning procedure identity
        call exact_require_event_epilogue
        ret

expression_call_control_require_events:
        ; Builtin-dispatch calls and returns.
        imm r21, 151
        imm r22, 0
        imm r23, 21                    ; is_read_byte procedure identity
        call expression_call_control_require_call
        imm r21, 152
        imm r22, 0
        imm r23, 30                    ; gen_read_byte procedure identity
        call expression_call_control_require_call
        imm r21, 152
        call expression_call_control_require_return
        imm r21, 153
        imm r22, 0
        imm r23, 22                    ; is_write_byte procedure identity
        call expression_call_control_require_call
        imm r21, 154
        imm r22, 0
        imm r23, 31                    ; gen_write_byte procedure identity
        call expression_call_control_require_call
        imm r21, 154
        call expression_call_control_require_return
        imm r21, 155
        imm r22, 0
        imm r23, 23                    ; is_emit procedure identity
        call expression_call_control_require_call
        imm r21, 156
        imm r22, 0
        imm r23, 28                    ; gen_emit procedure identity
        call expression_call_control_require_call
        imm r21, 156
        call expression_call_control_require_return

        ; Normal-call argument loop.
        imm r21, 157
        imm r22, 1
        imm r23, 24                    ; expect procedure identity
        call expression_call_control_require_call
        imm r21, 157
        imm r22, 0
        imm r23, 10                    ; skip_ws procedure identity
        call expression_call_control_require_call
        imm r21, 158
        imm r22, 0
        imm r23, 4                     ; cbyte procedure identity
        call expression_call_control_require_call
        imm r21, 159
        call expression_call_control_require_return
        imm r21, 160
        imm r22, 0
        imm r23, 61                    ; gen_expr procedure identity
        call expression_call_control_require_call
        imm r21, 160
        imm r22, 0
        imm r23, 47                    ; emit_push procedure identity
        call expression_call_control_require_call
        imm r21, 160
        imm r22, 0
        imm r23, 10                    ; skip_ws procedure identity
        call expression_call_control_require_call
        imm r21, 160
        imm r22, 0
        imm r23, 4                     ; cbyte procedure identity
        call expression_call_control_require_call
        imm r21, 161
        call expression_call_control_require_return
        imm r21, 162
        imm r22, 0
        imm r23, 5                     ; adv procedure identity
        call expression_call_control_require_call
        imm r21, 162
        imm r22, 0
        imm r23, 10                    ; skip_ws procedure identity
        call expression_call_control_require_call
        imm r21, 163
        imm r22, 0
        imm r23, 5                     ; adv procedure identity
        call expression_call_control_require_call
        imm r21, 165
        imm r22, 1
        imm r23, 44                    ; emit_pop_into procedure identity
        call expression_call_control_require_call

        ; Dynamic call spelling and final return.
        imm r20, 264
        imm r21, 166
        imm r22, 23463
        call expression_call_control_require_emit
        imm r21, 166
        imm r22, 2
        imm r23, 45                    ; emit_ident_at procedure identity
        call expression_call_control_require_call
        imm r20, 266
        imm r21, 166
        imm r22, 23613
        call expression_call_control_require_emit
        imm r20, 32
        imm r21, 166
        call exact_require_event_epilogue
        imm r20, 33                    ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

expression_call_control_require_region:
        imm r20, 32                    ; gen_call procedure identity
        call exact_proc_entry_r20
        imm r21, 33                    ; parse_number procedure identity / end
        call exact_proc_entry_r21
        imm r22, 20
        imm r23, 7
        imm r24, 23
        call exact_quiet_scan_region
        ret
