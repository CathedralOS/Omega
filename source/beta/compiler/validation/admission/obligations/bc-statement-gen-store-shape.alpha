; Exact source/artifact shape for gen_store (procedure26).
; Callable only: this module publishes no token and has no init edge.
; The canonical procedure inventory owns its total block span and partition.

statement_gen_store_require_shape:
        call statement_gen_store_require_proc
        call statement_gen_store_require_transitions
        call statement_gen_store_require_events
        call statement_gen_store_require_data
        call statement_gen_store_require_censuses
        call statement_gen_store_require_decoded
        ret

statement_gen_store_require_proc:
        imm r20, 26
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call exact_require_proc_frame_identity
        jmp exact_shape_ok

statement_gen_store_require_transitions:
        imm r20, 100
        imm r21, 137
        imm r22, 1
        imm r23, 138
        call exact_transition_identity_pc
        imm r20, 101
        imm r21, 137
        imm r22, 0
        imm r23, 139
        call exact_transition_identity_pc
        ret

; r21=block,r22=arity,r23=target procedure identity.
statement_gen_store_require_call:
        mov r24, r23
        imm r23, 0
        imm r20, 26
        call summary_require_call_fallthrough_identity
        ret

; r21=block,r22=arity,r23=target,r24=occurrence,r25=exact cardinality.
statement_gen_store_require_nth_call:
        mov r26, r25
        mov r25, r24
        mov r24, r23
        imm r23, 0
        imm r20, 26
        call summary_require_nth_call_fallthrough_identity
        ret

; r21=block,r22=literal bytes,r23=decoded length.
statement_gen_store_require_emit:
        imm r20, 26
        call exact_unique_emit_event_identity
        mov r14, r0
        mov r10, r1
        call check_emit_at_call
        ret

statement_gen_store_require_return:
        imm r20, 26
        call exact_require_event_epilogue
        ret

statement_gen_store_require_events:
        imm r21, 136
        imm r22, 1
        imm r23, 24                   ; expect
        imm r24, 0
        imm r25, 3
        call statement_gen_store_require_nth_call
        imm r21, 136
        imm r22, 0
        imm r23, 61                   ; gen_expr
        imm r24, 0
        imm r25, 2
        call statement_gen_store_require_nth_call
        imm r21, 136
        imm r22, 1
        imm r23, 24                   ; expect
        imm r24, 1
        imm r25, 3
        call statement_gen_store_require_nth_call
        imm r21, 136
        imm r22, 0
        imm r23, 47                   ; emit_push
        call statement_gen_store_require_call
        imm r21, 136
        imm r22, 1
        imm r23, 24                   ; expect
        imm r24, 2
        imm r25, 3
        call statement_gen_store_require_nth_call
        imm r21, 136
        imm r22, 0
        imm r23, 61                   ; gen_expr
        imm r24, 1
        imm r25, 2
        call statement_gen_store_require_nth_call
        imm r21, 136
        imm r22, 1
        imm r23, 44                   ; emit_pop_into
        call statement_gen_store_require_call
        imm r21, 138
        imm r22, statement_gen_store_literal_storeb
        imm r23, 13
        call statement_gen_store_require_emit
        imm r21, 138
        call statement_gen_store_require_return
        imm r21, 139
        imm r22, statement_gen_store_literal_store
        imm r23, 12
        call statement_gen_store_require_emit
        imm r21, 139
        call statement_gen_store_require_return
        call statement_gen_store_require_epilogues
        ret

statement_gen_store_require_epilogues:
        ; Explicit epilogues are owned with return identities above.
        imm r20, 27                   ; emit_str_body identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

statement_gen_store_require_data:
        imm r20, 36
        imm r21, 137
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        ; Exact literal/comparison rows.
        imm r20, 362
        imm r21, 136
        imm r22, 1
        imm r23, 91
        call exact_primitive_identity_pc
        imm r20, 363
        imm r21, 136
        imm r22, 1
        imm r23, 93
        call exact_primitive_identity_pc
        imm r20, 364
        imm r21, 136
        imm r22, 1
        imm r23, 61
        call exact_primitive_identity_pc
        imm r20, 365
        imm r21, 136
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 366
        imm r21, 137
        imm r22, 3
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 367
        imm r21, 137
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 368
        imm r21, 138
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 369
        imm r21, 139
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        ; Binary-left and call-argument pushes.
        imm r20, 92
        imm r21, 137
        call exact_require_binary_push_identity
        imm r20, 295
        imm r21, 136
        call exact_require_argument_push_identity
        imm r20, 296
        imm r21, 136
        call exact_require_argument_push_identity
        imm r20, 297
        imm r21, 136
        call exact_require_argument_push_identity
        imm r20, 298
        imm r21, 136
        call exact_require_argument_push_identity
        ret

statement_gen_store_require_censuses:
        imm r20, 136
        imm r21, 139
        imm r22, 36
        imm r23, 37
        imm r24, 33
        imm r25, 33
        imm r26, 100
        imm r27, 102
        imm r28, 172
        imm r29, 183
        call exact_require_effect_census
        imm r20, 136
        imm r21, 139
        imm r22, 362
        imm r23, 370
        imm r24, 92
        imm r25, 93
        imm r26, 295
        imm r27, 299
        imm r28, 383
        imm r29, 383
        call summary_require_expr_census
        ret

statement_gen_store_require_decoded:
        imm r20, 26
        call exact_proc_entry_r20
        imm r21, 27
        call exact_proc_entry_r21
        imm r22, 9
        imm r23, 3
        imm r24, 7
        call exact_quiet_scan_region
        ret

statement_gen_store_literal_storeb:
        db "storeb r1,r0\n"
statement_gen_store_literal_store:
        db "store r1,r0\n"
