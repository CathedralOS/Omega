; Exact source/artifact shape for emit_dec(n).
;
; Procedure 40 owns four blocks, the n>=10 split, one recursive call, one
; direct digit write, explicit/synthetic returns, one parameter slot, exact
; arithmetic/comparison primitives and pushes, and exhaustive table/decoded
; censuses. The adjacent meaning module owns bounded quotient/remainder and
; canonical decimal-output induction.

emit_dec_require_shape:
        imm r20, 40
        imm r21, 1                    ; n parameter
        imm r22, 1                    ; n parameter slot
        imm r23, 16
        call exact_require_proc_frame_identity

emit_dec_shape_blocks:
        imm r20, 204
        imm r21, 40                  ; emit_dec procedure identity
        imm r22, 0                   ; procedure entry
        call exact_block_identity_pc
        imm r20, 205
        imm r21, 40
        imm r22, 1                   ; state big
        call exact_block_identity_pc
        imm r20, 206
        imm r21, 40
        imm r22, 1                   ; state rec
        call exact_block_identity_pc
        imm r20, 207
        imm r21, 40
        imm r22, 1                   ; state digit
        call exact_block_identity_pc
        imm r20, 204
        imm r21, 207
        imm r22, 40
        call exact_require_proc_blocks
        call emit_dec_require_transitions
        call emit_dec_require_events
        call emit_dec_require_locals
        call emit_dec_require_primitives
        call emit_dec_require_pushes
        call emit_dec_require_censuses
        ret

emit_dec_require_transitions:
        imm r20, 163
        imm r21, 205
        imm r22, 1
        imm r23, 206
        call exact_transition_identity_pc ; checked n>=10 recursive guard
        imm r20, 164
        imm r21, 205
        imm r22, 0
        imm r23, 207
        call exact_transition_identity_pc ; checked direct digit edge
        imm r20, 165
        imm r21, 206
        imm r22, 0
        imm r23, 207
        call exact_transition_identity_pc ; checked post-recursion digit edge
        ret

emit_dec_require_events:
        imm r20, 40                  ; owning procedure identity
        imm r21, 206                 ; rec source block identity
        imm r22, 1                   ; q argument
        imm r23, 0                   ; no ambient temporary
        imm r24, 40                  ; recursive emit_dec target identity
        imm r25, 165                 ; continuation transition identity
        imm r26, 206
        imm r27, 0
        imm r28, 207
        call summary_require_call_identity
        imm r20, 40
        imm r21, 207
        call exact_unique_write_event_identity ; checked direct digit write
        imm r20, 40
        imm r21, 207
        call exact_require_event_epilogue ; explicit return zero
        imm r20, 41                  ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

emit_dec_require_locals:
        imm r20, 118
        imm r21, 205
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc ; guard n
        imm r20, 119
        imm r21, 206
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc ; quotient n
        imm r20, 120
        imm r21, 207
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc ; remainder n
        ret

emit_dec_require_primitives:
        imm r20, 523
        imm r21, 205
        imm r22, 3
        imm r23, 13                  ; n>=10
        call exact_primitive_identity_pc
        imm r20, 524
        imm r21, 205
        imm r22, 1
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 525
        imm r21, 206
        imm r22, 2
        imm r23, 6                   ; n/10
        call exact_primitive_identity_pc
        imm r20, 526
        imm r21, 206
        imm r22, 1
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 527
        imm r21, 207
        imm r22, 2
        imm r23, 7                   ; n%10
        call exact_primitive_identity_pc
        imm r20, 528
        imm r21, 207
        imm r22, 1
        imm r23, 10
        call exact_primitive_identity_pc
        imm r20, 529
        imm r21, 207
        imm r22, 2
        imm r23, 3                   ; remainder+'0'
        call exact_primitive_identity_pc
        imm r20, 530
        imm r21, 207
        imm r22, 1
        imm r23, 48                  ; decimal digit zero
        call exact_primitive_identity_pc
        imm r20, 531
        imm r21, 207
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        ret

emit_dec_require_pushes:
        imm r20, 148
        imm r21, 205
        call exact_require_binary_push_identity ; comparison-left n
        imm r20, 149
        imm r21, 206
        call exact_require_binary_push_identity ; division-left n
        imm r20, 150
        imm r21, 207
        call exact_require_binary_push_identity ; remainder-left n
        imm r20, 151
        imm r21, 207
        call exact_require_binary_push_identity ; addition-left remainder
        imm r20, 317
        imm r21, 206
        call exact_require_argument_push_identity ; recursive q argument
        ret

emit_dec_require_censuses:
        imm r20, 204
        imm r21, 207
        imm r22, 118
        imm r23, 121                 ; exclusive local row
        imm r24, 54
        imm r25, 54                  ; no raw-memory rows
        imm r26, 163
        imm r27, 166                 ; exclusive transition row
        imm r28, 308
        imm r29, 311                 ; exclusive event row
        call exact_require_effect_census

        imm r20, 204
        imm r21, 207
        imm r22, 523
        imm r23, 532                 ; exclusive primitive row
        imm r24, 148
        imm r25, 152                 ; exclusive binary-push row
        imm r26, 317
        imm r27, 318                 ; exclusive argument-push row
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census

        imm r20, 40                    ; emit_dec procedure identity
        call exact_proc_entry_r20
        imm r21, 41                    ; next procedure identity
        call exact_proc_entry_r21
        imm r22, 1                   ; recursive call count
        imm r23, 2                   ; explicit and synthetic returns
        imm r24, 1                   ; direct write count
        imm r25, 1                   ; division count
        imm r26, 1                   ; remainder count
        call emit_dec_scan_region
        ret

; Full decoded census for the arithmetic/output leaf. Besides exact counts for
; its intentional call, returns, write, division and remainder, direct input or
; halt is forbidden. Source/table censuses above close all remaining effects.
emit_dec_scan_region:
        mov r27, r20                 ; cursor
        mov r28, r21                 ; exclusive end
        mov r29, r22                 ; expected calls
        imm r10, 0                   ; calls
        imm r11, 0                   ; returns
        imm r12, 0                   ; writes
        imm r13, 0                   ; divisions
        imm r14, 0                   ; remainders
        imm r15, 0                   ; frame/parameter/push stores
emit_dec_scan_loop:
        jlt r27, r28, emit_dec_scan_pc
        jeq r10, r29, emit_dec_scan_returns
        jmp reject
emit_dec_scan_returns:
        jeq r11, r23, emit_dec_scan_writes
        jmp reject
emit_dec_scan_writes:
        jeq r12, r24, emit_dec_scan_divisions
        jmp reject
emit_dec_scan_divisions:
        jeq r13, r25, emit_dec_scan_remainders
        jmp reject
emit_dec_scan_remainders:
        jeq r14, r26, emit_dec_scan_stores
        jmp reject
emit_dec_scan_stores:
        imm r1, 7                    ; checked exact target store count
        jeq r15, r1, emit_dec_scan_done
        jmp reject
emit_dec_scan_pc:
        imm r1, 4194304
        add r1, r27
        loadb r2, r1
        imm r3, 1
        jeq r2, r3, emit_dec_scan_start
        jmp emit_dec_scan_next
emit_dec_scan_start:
        imm r1, 2097152
        add r1, r27
        loadb r2, r1
        imm r3, 19
        jeq r2, r3, emit_dec_scan_call
        imm r3, 20
        jeq r2, r3, emit_dec_scan_return
        imm r3, 18
        jeq r2, r3, emit_dec_scan_write
        imm r3, 6
        jeq r2, r3, emit_dec_scan_div
        imm r3, 7
        jeq r2, r3, emit_dec_scan_mod
        imm r3, 11
        jeq r2, r3, emit_dec_scan_store
        imm r3, 0
        jeq r2, r3, reject
        imm r3, 8
        jeq r2, r3, reject
        imm r3, 9
        jeq r2, r3, reject
        imm r3, 17
        jeq r2, r3, reject
        jmp emit_dec_scan_next
emit_dec_scan_call:
        imm r1, 1
        add r10, r1
        jmp emit_dec_scan_next
emit_dec_scan_return:
        imm r1, 1
        add r11, r1
        jmp emit_dec_scan_next
emit_dec_scan_write:
        imm r1, 1
        add r12, r1
        jmp emit_dec_scan_next
emit_dec_scan_div:
        imm r1, 1
        add r13, r1
        jmp emit_dec_scan_next
emit_dec_scan_mod:
        imm r1, 1
        add r14, r1
        jmp emit_dec_scan_next
emit_dec_scan_store:
        imm r1, 1
        add r15, r1
emit_dec_scan_next:
        imm r1, 1
        add r27, r1
        jmp emit_dec_scan_loop
emit_dec_scan_done:
        ret
