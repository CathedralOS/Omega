; Absolute explicit/hidden stack lift for exact bc.
;
; The preceding phases establish the local premises of this final numerical
; induction:
;
;   * the BCS9 checker reconstructs every call edge, exact frame weight,
;     call-site temporary height, local peak, and the finite counter/rank
;     recurrence, then checks every supplied potential equation;
;   * the resource phase transfers the two depth counters and machine NLOC
;     through their exact roots, guards, updates, exits, and protected-writer
;     inventories;
;   * the frame phase gives every procedure a call-cut ABI summary, checks all
;     stores exhaustively, and proves that a callee restores its caller's
;     explicit stack/frame pair without overwriting the saved-fp word.
;
; Consequently the already checked potential equation
;
;   frame(caller) + 8*ambient(call) + potential(callee)
;       <= potential(caller)
;
; is an induction rule over dynamic calls.  The counter tables discharge the
; only recursive cutpoints, and emit_dec's positive /10 rank discharges the
; remaining one.  This phase checks the theorem's numerical side for every
; finite context and instantiates it at the exact prelude/main root.  It does
; not claim general local/raw-load value correspondence or termination.

stack_potential_lift_init:
        call stack_lift_require_prelude
        call stack_lift_check_expr_contexts
        call stack_lift_check_block_contexts
        call stack_lift_check_root_contexts
        call stack_lift_instantiate_main
        jmp bc_post_stack_potential

; The emitted program starts its explicit stack/frame pair at one MiB, calls
; the independently resolved main procedure, then halts with main's r0.
stack_lift_require_prelude:
        imm r3, 524984
        load r20, r3                   ; resolved main procedure identity
        call exact_require_program_prelude
        ret

; Check all 64*70 expression-context pairs.  Zero/zero is the canonical dead
; cell already required by BCS9.  Each live potential is aligned, contains at
; least one frame/hidden return, and fits the reserved B_bc1 extents.
stack_lift_check_expr_contexts:
        imm r20, 10051584              ; explicit table
        imm r21, 10087936              ; hidden table
        imm r22, 4544
        call stack_lift_check_context_table
        ret

stack_lift_check_block_contexts:
        imm r20, 10124288
        imm r21, 10160640
        imm r22, 4544
        call stack_lift_check_context_table
        ret

stack_lift_check_root_contexts:
        imm r20, 10196992
        imm r21, 10197560
        imm r22, 71
        call stack_lift_check_context_table
        ret

stack_lift_check_context_table:
        imm r10, 0
stack_lift_context_loop:
        jlt r10, r22, stack_lift_context_cell
        ret
stack_lift_context_cell:
        mov r11, r10
        imm r1, 8
        mul r11, r1
        mov r1, r20
        add r1, r11
        load r2, r1                    ; explicit bytes
        mov r1, r21
        add r1, r11
        load r3, r1                    ; hidden returns
        imm r4, 0
        jeq r2, r4, stack_lift_context_dead_hidden
        jeq r3, r4, reject
        mov r4, r2
        imm r5, 8
        mod r4, r5
        imm r5, 0
        jeq r4, r5, stack_lift_context_explicit_floor
        jmp reject
stack_lift_context_explicit_floor:
        imm r4, 8
        jlt r2, r4, reject
        imm r4, 524289
        jlt r2, r4, stack_lift_context_hidden_bound
        jmp reject
stack_lift_context_hidden_bound:
        imm r4, 8193
        jlt r3, r4, stack_lift_context_next
        jmp reject
stack_lift_context_dead_hidden:
        imm r4, 0
        jeq r3, r4, stack_lift_context_next
        jmp reject
stack_lift_context_next:
        imm r1, 1
        add r10, r1
        jmp stack_lift_context_loop

; Instantiate the induction at main.  Exact values keep the documented margin
; auditable; their validity is still derived by the preceding Alpha recurrence,
; not trusted from the Python witness.
stack_lift_instantiate_main:
        imm r1, 524984
        load r22, r1
        imm r20, 3
        imm r21, 0
        call call_bounds_load_pair
        imm r1, 13744
        jeq r0, r1, stack_lift_main_hidden
        jmp reject
stack_lift_main_hidden:
        imm r1, 726
        jeq r7, r1, stack_lift_main_explicit_low
        jmp reject

; r15/r14 begin at 1048576.  The whole checked potential therefore leaves the
; explicit low-water mark at 1035856, strictly inside [524288,1048576].
stack_lift_main_explicit_low:
        imm r2, 1048576
        sub r2, r0
        imm r3, 1034832
        jeq r2, r3, stack_lift_main_explicit_reserved
        jmp reject
stack_lift_main_explicit_reserved:
        imm r3, 524288
        jlt r2, r3, reject
        imm r3, 1048577
        jlt r2, r3, stack_lift_main_hidden_low
        jmp reject

; Alpha's hidden return stack starts at 64 MiB and grows down by eight bytes.
; 662 live returns leave 67103568, far above every compiler raw-memory region
; (whose checked upper endpoint is 3162112) and the explicit stack.
stack_lift_main_hidden_low:
        mov r2, r7
        imm r3, 8
        mul r2, r3
        imm r3, 67108864
        sub r3, r2
        imm r4, 67103056
        jeq r3, r4, stack_lift_main_hidden_disjoint
        jmp reject
stack_lift_main_hidden_disjoint:
        imm r4, 3162111
        jlt r4, r3, stack_lift_main_done
        jmp reject
stack_lift_main_done:
        ret
