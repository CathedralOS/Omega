; Root of the independent complete parse_proc implication checker.
;
; The process starts after the canonical expression-table loader has established
; register custody.  It does not import process-local cells from another
; executable: the named lower publications are proposition-schema hypotheses,
; recorded and rechecked locally by the antecedent module.

stack_register_custody_init:
        imm r1, 606000
        imm r2, 1481789520             ; PPRX
        store r1, r2
        jmp parse_proc_antecedent_init

; Family-local sequential table cursors. Callers retain ownership of the table
; address and expected/stored word in r20/r21.
parse_proc_require_next:
        call exact_require_cell
        imm r1, 8
        add r20, r1
        ret

parse_proc_store_next:
        store r20, r21
        imm r1, 8
        add r20, r1
        ret
