; Relational summary for new_label().
;
; For an arbitrary entry Word ell in fixed compiler global LBL, the exact
; procedure returns ell and stores ell+1 modulo 2^64 back to LBL.  It emits no
; bytes, preserves input/CUR/source and every other persistent compiler global,
; and restores the caller frame.  Reclaimed stack scratch is explicitly outside
; the raw-memory equality claim.  In particular, NLBL is not a freshness or
; nonwrapping-natural theorem: WORD_MAX advances to zero.
;
; Public cell:
;   534832 NLBL
; Private executable provenance:
;   535144 root                    535152 exact shape
;   535160 LBL load identity       535168 local-old custody
;   535176 same store address      535184 modular successor
;   535192 wrap endpoint probes    535200 LBL update
;   535208 returned old Word       535216 epsilon trace
;   535224 persistent-state delta  535232 restored frame
;   535240 fixed-address safety    535248 terminal/trap-free
;   535256 stack-scratch exclusion 535264 completed join
;   535272 explicit-stack potential 535280 hidden-return potential

label_counter_summary_init:
        call label_counter_reset
        call label_core_require_shape
        call label_counter_require_root
        call label_counter_prove_load
        call label_counter_prove_successor
        call label_counter_prove_update
        call label_counter_prove_return
        call label_counter_prove_terminal
        call label_counter_finalize
        imm r1, 534832
        imm r2, 1279413326            ; NLBL
        store r1, r2
        imm r20, 534832
        imm r21, 1279413326
        call exact_require_cell
        jmp label_ref_summary_init

label_counter_reset:
        imm r1, 535144
        imm r2, 535288
        imm r3, 0
label_counter_reset_loop:
        jlt r1, r2, label_counter_reset_one
        ret
label_counter_reset_one:
        store r1, r3
        imm r4, 8
        add r1, r4
        jmp label_counter_reset_loop

label_counter_require_root:
        imm r20, 534800
        imm r21, 1163022164            ; EROOT
        call exact_require_cell
        imm r1, 535144
        imm r2, 1
        store r1, r2
        ; Shape was checked before any semantic token is minted.
        imm r1, 535152
        store r1, r2
        ret

; Bind the exact fixed-global load to the value deposited in local slot zero.
label_counter_prove_load:
        imm r20, 8
        imm r21, 5
        imm r25, 24
        imm r26, 2097104
        call exact_memory_load_pc
        imm r20, 24
        imm r21, 5
        imm r22, 1
        imm r23, 2097104
        call exact_primitive_identity_pc
        imm r1, 535160
        imm r2, 1                    ; symbolic entry ell
        store r1, r2
        imm r20, 10
        imm r21, 5
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 535160
        imm r21, 1
        call exact_require_cell
        imm r1, 535168
        imm r2, 1                    ; slot0 receives that same ell
        store r1, r2

        ; The aligned word is wholly inside B_bc1's 64 MiB memory.
        imm r10, 2097104
        imm r11, 8
        add r10, r11
        imm r12, 2097104
        jlt r12, r10, label_counter_address_nonwrap
        jmp reject
label_counter_address_nonwrap:
        imm r12, 67108865
        jlt r10, r12, label_counter_address_safe
        jmp reject
label_counter_address_safe:
        imm r1, 535240
        imm r2, 1
        store r1, r2
        ret

; Rejoin slot0, the exact left push, literal one, and wrapping add.  The two
; executable endpoints forbid silently strengthening this to natural addition.
label_counter_prove_successor:
        imm r20, 11
        imm r21, 5
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 4
        imm r21, 5
        call exact_require_binary_push_identity
        imm r20, 27
        imm r21, 5
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        imm r20, 26
        imm r21, 5
        imm r22, 2
        imm r23, 3                    ; Word add
        call exact_primitive_identity_pc
        imm r20, 535168
        imm r21, 1
        call exact_require_cell
        imm r1, 535184
        imm r2, 1                    ; symbolic succ64(ell)
        store r1, r2

        imm r10, 0
        imm r11, 1
        add r10, r11
        jeq r10, r11, label_counter_probe_wrap
        jmp reject
label_counter_probe_wrap:
        imm r10, 0
        sub r10, r11                 ; WORD_MAX = 0-1
        add r10, r11
        imm r12, 0
        jeq r10, r12, label_counter_probes_done
        jmp reject
label_counter_probes_done:
        imm r1, 535192
        imm r2, 2                    ; zero and WORD_MAX endpoints checked
        store r1, r2
        ret

; The exact address expression is evaluated before the value.  Store-address
; row377 retains 2097104 while the n+1 expression uses its own two temporaries.
label_counter_prove_update:
        imm r20, 25
        imm r21, 5
        imm r22, 1
        imm r23, 2097104
        call exact_primitive_identity_pc
        imm r20, 379
        imm r21, 5
        call exact_require_store_push_identity
        imm r1, 535176
        imm r2, 1                    ; load/store select identical LBL word
        store r1, r2
        imm r20, 535184
        imm r21, 1
        call exact_require_cell
        imm r20, 9
        imm r21, 5
        call exact_memory_store_pc
        imm r1, 535200
        imm r2, 1                    ; post LBL is succ64(ell)
        store r1, r2
        ret

label_counter_prove_return:
        imm r20, 12
        imm r21, 5
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 1                    ; new_label procedure identity
        imm r21, 5
        call exact_require_event_epilogue
        imm r20, 535168
        imm r21, 1
        call exact_require_cell
        imm r1, 535208
        imm r2, 1                    ; returned r0 is entry ell, not successor
        store r1, r2
        ret

label_counter_prove_terminal:
        ; The exact region has no call, I/O, division, remainder, byte memory,
        ; or halt.  Its explicit path takes the first checked epilogue.
        imm r20, 1                    ; new_label procedure identity
        call exact_proc_entry_r20
        imm r21, 2                    ; emit_lref procedure identity / end
        call exact_proc_entry_r21
        imm r22, 0
        imm r23, 2
        imm r24, 5
        call exact_quiet_scan_region
        imm r1, 535216
        imm r2, 1                    ; arbitrary prior output remains unchanged
        store r1, r2
        imm r1, 535224
        store r1, r2                  ; only persistent LBL differs
        imm r1, 535232
        store r1, r2                  ; explicit epilogue restores r14/r15
        imm r1, 535248
        store r1, r2                  ; finite, trap-free return
        imm r1, 535256
        store r1, r2                  ; reclaimed stack cells are excluded
        ; Exact frame16 plus the two-word store/binary temporary peak is 32.
        ; This call-free procedure contributes only its own hidden return.
        imm r10, 2
        imm r11, 8
        mul r10, r11
        imm r12, 16
        add r10, r12
        imm r13, 32
        jeq r10, r13, label_counter_explicit_potential
        jmp reject
label_counter_explicit_potential:
        imm r1, 535272
        store r1, r10
        imm r1, 535280
        imm r2, 1
        store r1, r2
        ret

; Consume every private semantic cell before completion/publication.  This is
; intentionally verbose: deleting a provenance edge must leave a live failure.
label_counter_finalize:
        imm r20, 535144
        imm r21, 1
        call exact_require_cell
        imm r20, 535152
        call exact_require_cell
        imm r20, 535160
        call exact_require_cell
        imm r20, 535168
        call exact_require_cell
        imm r20, 535176
        call exact_require_cell
        imm r20, 535184
        call exact_require_cell
        imm r20, 535192
        imm r21, 2
        call exact_require_cell
        imm r20, 535200
        imm r21, 1
        call exact_require_cell
        imm r20, 535208
        call exact_require_cell
        imm r20, 535216
        call exact_require_cell
        imm r20, 535224
        call exact_require_cell
        imm r20, 535232
        call exact_require_cell
        imm r20, 535240
        call exact_require_cell
        imm r20, 535248
        call exact_require_cell
        imm r20, 535256
        call exact_require_cell
        imm r20, 535272
        imm r21, 32
        call exact_require_cell
        imm r20, 535280
        imm r21, 1
        call exact_require_cell
        imm r1, 535264
        imm r2, 17                   ; seventeen consumed provenance cells
        store r1, r2
        imm r20, 535264
        imm r21, 17
        call exact_require_cell
        ret
