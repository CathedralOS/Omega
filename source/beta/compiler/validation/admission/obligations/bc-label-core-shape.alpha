; Exact source/artifact shape for new_label() and emit_lref(n).
;
; These are procedures 1 and 2, each with one entry block and no source
; transitions.  new_label owns the fixed LBL load/update and explicit return;
; emit_lref owns one exact "_L" helper event followed by one full-Word
; emit_dec call.  This module establishes only shape/custody.  The adjacent
; summaries own modular counter meaning and ordered output meaning.

label_core_require_shape:
        call label_core_require_proc_meta
        call label_core_require_blocks
        call label_core_require_events
        call label_core_require_locals
        call label_core_require_memory
        call label_core_require_primitives
        call label_core_require_pushes
        call label_core_require_censuses
        call label_core_require_decoded
        ret

; r20=procedure, r21=arity, r22=slots.  Both exact frames are sixteen bytes:
; one saved caller fp word and one parameter/local word.
label_core_require_one_proc:
        imm r23, 16
        call exact_require_proc_frame_identity
        jmp label_core_shape_ok

label_core_require_proc_meta:
        imm r20, 1                    ; new_label()
        imm r21, 0
        imm r22, 1
        call label_core_require_one_proc
        imm r20, 2                    ; emit_lref(n)
        imm r21, 1
        imm r22, 1
        call label_core_require_one_proc
        ret

label_core_require_blocks:
        imm r20, 5
        imm r21, 1
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 5
        imm r21, 5
        imm r22, 1
        call exact_require_proc_blocks
        imm r20, 6
        imm r21, 2
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 6
        imm r21, 6
        imm r22, 2
        call exact_require_proc_blocks
        ret

label_core_require_events:
        ; new_label's only source effect is its explicit return.
        imm r20, 1
        imm r21, 5
        call exact_require_event_epilogue
        ; The compiler also emits the unreachable canonical fallthrough return.
        imm r20, 2
        call exact_require_preentry_epilogue

        ; Resolve emit_lref's inline literal and helper call from its source
        ; emit row. The WSTR owner supplies the relative lowering layout.
        imm r20, 5
        call write_str_require_emit_event_core
        mov r30, r0                   ; checked literal pointer
        imm r2, 2
        jeq r1, r2, label_core_emit_lref_literal
        jmp reject
label_core_emit_lref_literal:
        mov r20, r30
        imm r21, 95                   ; '_'
        call require_tape_byte
        mov r20, r30
        imm r1, 1
        add r20, r1
        imm r21, 76                   ; 'L'
        call require_tape_byte

        ; emit_dec is selected from the complete call identity.
        imm r20, 2                    ; emit_lref owner
        imm r21, 6
        imm r22, 1
        imm r23, 0
        imm r24, 40                   ; emit_dec procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 3                    ; next procedure owns synthetic epilogue
        call exact_require_preentry_epilogue
        ret

label_core_require_locals:
        ; new_label: let n, n in n+1, and returned n.
        imm r20, 10
        imm r21, 5
        imm r22, 2
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 11
        imm r21, 5
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 12
        imm r21, 5
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        ; emit_lref's n is loaded unchanged for its sole ordinary argument.
        imm r20, 13
        imm r21, 6
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        ret

label_core_require_memory:
        imm r20, 8
        imm r21, 5
        imm r25, 24
        imm r26, 2097104              ; word load LBL address
        call exact_memory_load_pc
        imm r20, 9
        imm r21, 5
        call exact_memory_store_pc    ; word store LBL
        ret

label_core_require_primitives:
        ; Load-address row24 is rejoined to memory row8 above.
        imm r20, 25
        imm r21, 5
        imm r22, 1
        imm r23, 2097104              ; store address
        call exact_primitive_identity_pc
        ; Lexical rows put the operator before its right literal; PCs expose
        ; the exact lowering order n, push, 1, add.
        imm r20, 26
        imm r21, 5
        imm r22, 2
        imm r23, 3                    ; wrapping add
        call exact_primitive_identity_pc
        imm r20, 27
        imm r21, 5
        imm r22, 1
        imm r23, 1
        call exact_primitive_identity_pc
        ret

label_core_require_pushes:
        imm r20, 4
        imm r21, 5
        call exact_require_binary_push_identity ; n binary-left push
        imm r20, 379
        imm r21, 5
        call exact_require_store_push_identity  ; fixed LBL store-address push
        imm r20, 237
        imm r21, 6
        call exact_require_argument_push_identity ; emit_dec argument push
        ret

label_core_require_censuses:
        ; new_label exact local/memory/transition/event ownership.
        imm r20, 5
        imm r21, 5
        imm r22, 10
        imm r23, 13
        imm r24, 8
        imm r25, 10
        imm r26, 4
        imm r27, 4
        imm r28, 4
        imm r29, 5
        call exact_require_effect_census
        ; new_label exact primitive/binary/argument/store-push ownership.
        imm r20, 5
        imm r21, 5
        imm r22, 24
        imm r23, 28
        imm r24, 4
        imm r25, 5
        imm r26, 0
        imm r27, 0
        imm r28, 379
        imm r29, 380
        call summary_require_expr_census

        ; emit_lref exact local/memory/transition/event ownership.
        imm r20, 6
        imm r21, 6
        imm r22, 13
        imm r23, 14
        imm r24, 10
        imm r25, 10
        imm r26, 4
        imm r27, 4
        imm r28, 5
        imm r29, 7
        call exact_require_effect_census
        ; No primitive/binary/store rows; only argument-push row 237.
        imm r20, 6
        imm r21, 6
        imm r22, 0
        imm r23, 0
        imm r24, 0
        imm r25, 0
        imm r26, 237
        imm r27, 238
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census
        ret

label_core_require_decoded:
        ; The five stores are saved-fp/local/two temporaries/LBL.  Both returns
        ; are real decoded instructions even though the second is unreachable.
        imm r0, 1
        call exact_proc_entry_pc
        mov r30, r0
        imm r0, 2
        call exact_proc_entry_pc
        mov r21, r0
        mov r20, r30
        imm r22, 0                    ; ordinary/helper calls
        imm r23, 2                    ; explicit + synthetic returns
        imm r24, 5                    ; all decoded word stores
        call exact_quiet_scan_region
        ; The three stores are saved-fp/parameter/argument staging.  Output is
        ; inside the checked helper, not a direct write in this region.
        imm r0, 2
        call exact_proc_entry_pc
        mov r30, r0
        imm r0, 3
        call exact_proc_entry_pc
        mov r21, r0
        mov r20, r30
        imm r22, 2                    ; helper + emit_dec
        imm r23, 1                    ; fallthrough return
        imm r24, 3
        call exact_quiet_scan_region
        ret

label_core_shape_ok:
        ret
