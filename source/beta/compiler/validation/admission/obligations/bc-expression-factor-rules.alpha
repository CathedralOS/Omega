; Parameterized gen_factor relation.  Every recursive gen_expr call is supplied
; by the smaller remaining-depth context in the adjacent induction; this module
; fixes the exact dispatch/call order and proves that numeric resource status is
; carried rather than treated as an implicit early return.

expression_factor_rules_init:
        call expression_factor_reset
        call expression_factor_require_imports
        call expression_factor_prove_paren
        call expression_factor_prove_identifier
        call expression_factor_prove_literals
        call expression_factor_publish
        jmp expression_levels_rules_init

expression_factor_reset:
        imm r1, 541200
        imm r2, 0
expression_factor_reset_loop:
        imm r3, 541800
        jlt r1, r3, expression_factor_reset_one
        ret
expression_factor_reset_one:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp expression_factor_reset_loop

expression_factor_require_imports:
        imm r20, 540016
        imm r21, 1364349016             ; XPRQ
        call exact_require_cell
        imm r20, 540024
        imm r21, 1279347796             ; XTAL
        call exact_require_cell
        imm r20, 540032
        imm r21, 1380207687             ; GLDR
        call exact_require_cell
        imm r20, 540048
        imm r21, 1279347783             ; GCAL
        call exact_require_cell
        imm r20, 540008
        imm r21, 1263488844             ; exported LOOK
        call exact_require_cell
        imm r20, 531928
        imm r21, 1396984901             ; ELDS
        call exact_require_cell
        imm r20, 526680
        imm r21, 1413631041             ; ALBT
        call exact_require_cell
        imm r20, 526792
        imm r21, 1396984146             ; RIDS
        call exact_require_cell
        imm r20, 529144
        imm r21, 1297436240             ; PNUM
        call exact_require_cell
        imm r20, 529416
        imm r21, 1380467536             ; PCHR
        call exact_require_cell
        imm r20, 530456
        imm r21, 1398231878             ; FKWS
        call exact_require_cell
        imm r20, 532560
        imm r21, 1464026436             ; DECW
        call exact_require_cell
        imm r1, 541200
        imm r2, 1
        store r1, r2
        ret

; r20=event,r21=block,r22=pc,r23=arity,r24=target,r25=continuation.
expression_factor_require_site:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        mov r20, r30
        mov r21, r31
        mov r22, r32
        mov r23, r33
        imm r24, 0
        mov r25, r34
        mov r26, r35
        call summary_require_call_site
        ret

expression_factor_prove_paren:
        ; Leading SWS/cbyte select the exact '(' versus complement partition.
        imm r20, 383
        imm r21, 243
        imm r22, 35913
        imm r23, 0
        imm r24, 4277
        imm r25, 35922
        call expression_factor_require_site
        imm r20, 384
        imm r21, 243
        imm r22, 35922
        imm r23, 0
        imm r24, 1609
        imm r25, 35931
        call expression_factor_require_site
        imm r20, 385
        imm r21, 245
        imm r22, 36082
        imm r23, 0
        imm r24, 1939
        imm r25, 36091
        call expression_factor_require_site
        imm r20, 386
        imm r21, 245
        imm r22, 36091
        imm r23, 0
        imm r24, 61                    ; gen_expr procedure identity
        call exact_proc_entry_r24
        imm r25, 36100
        call expression_factor_require_site
        imm r20, 387
        imm r21, 245
        imm r22, 36142
        imm r23, 1
        imm r24, 17441
        imm r25, 36151
        call expression_factor_require_site
        ; Both child status outcomes still execute permissive expect(')').
        imm r10, 0
expression_factor_paren_status_loop:
        imm r1, 2
        jlt r10, r1, expression_factor_paren_status_case
        imm r1, 541216
        imm r2, 2
        store r1, r2
        ret
expression_factor_paren_status_case:
        imm r1, 541208
        store r1, r10                  ; child 0 / numeric252
        imm r1, 541224
        imm r2, 1
        store r1, r2                   ; EXPS/XTAL closing expect always executes
        imm r1, 1
        add r10, r1
        jmp expression_factor_paren_status_loop

expression_factor_prove_identifier:
        ; Alpha branch: maximal identifier, byte/word special forms, then
        ; call-versus-variable. FKWS supplies all three exact predicates.
        imm r20, 389
        imm r21, 246
        imm r22, 36232
        imm r23, 1
        imm r24, 2470
        imm r25, 36241
        call expression_factor_require_site
        imm r20, 390
        imm r21, 247
        imm r22, 36354
        imm r23, 0
        imm r24, 5217
        imm r25, 36363
        call expression_factor_require_site
        imm r20, 391
        imm r21, 247
        imm r22, 36363
        imm r23, 0
        imm r24, 10626
        imm r25, 36372
        call expression_factor_require_site
        imm r20, 392
        imm r21, 248
        imm r22, 36527
        imm r23, 1
        imm r24, 17712
        imm r25, 36536
        call expression_factor_require_site
        imm r20, 394
        imm r21, 249
        imm r22, 36566
        imm r23, 0
        imm r24, 11582
        imm r25, 36575
        call expression_factor_require_site
        imm r20, 395
        imm r21, 250
        imm r22, 36730
        imm r23, 1
        imm r24, 17712
        imm r25, 36739
        call expression_factor_require_site
        imm r20, 397
        imm r21, 251
        imm r22, 36769
        imm r23, 0
        imm r24, 4277
        imm r25, 36778
        call expression_factor_require_site
        imm r20, 398
        imm r21, 251
        imm r22, 36778
        imm r23, 0
        imm r24, 1609
        imm r25, 36787
        call expression_factor_require_site
        ; Artifact order is lookup first, then parameterized emit_load_slot.
        imm r20, 400
        imm r21, 251
        imm r22, 36891
        imm r23, 0
        imm r24, 26114
        imm r25, 36900
        call expression_factor_require_site
        imm r20, 399
        imm r21, 251
        imm r22, 36932
        imm r23, 1
        imm r24, 34532
        imm r25, 36941
        call expression_factor_require_site
        imm r20, 402
        imm r21, 252
        imm r22, 36971
        imm r23, 0
        imm r24, 21670
        imm r25, 36980
        call expression_factor_require_site
        imm r1, 541232
        imm r2, 5                     ; byte/word/call/variable/fallback cases
        store r1, r2
        imm r1, 541240
        imm r2, 1                     ; lookup slot is ELDS slot unchanged
        store r1, r2
        imm r1, 541248
        store r1, r2                   ; delegated resource status retained
        ret

expression_factor_require_fixed:
        ; r20=event,r21=literal length.
        mov r30, r20
        mov r31, r21
        mov r20, r30
        call write_str_require_emit_event
        jeq r1, r31, exact_shape_ok
        jmp reject

expression_factor_prove_literals:
        ; Character: parse first, then prefix/DECW/newline.
        imm r20, 406
        imm r21, 254
        imm r22, 37187
        imm r23, 0
        imm r24, 37528
        imm r25, 37196
        call expression_factor_require_site
        imm r20, 404
        imm r21, 7
        call expression_factor_require_fixed
        imm r20, 405
        imm r21, 254
        imm r22, 37228
        imm r23, 1
        imm r24, 40                    ; emit_dec procedure identity
        call exact_proc_entry_r24
        imm r25, 37237
        call expression_factor_require_site
        imm r20, 407
        imm r21, 1
        call expression_factor_require_fixed

        ; Number: maximal modulo-Word fold feeds the same full-Word emitter.
        imm r20, 409
        imm r21, 255
        imm r22, 37306
        imm r23, 0
        imm r24, 23672
        imm r25, 37315
        call expression_factor_require_site
        imm r20, 410
        imm r21, 7
        call expression_factor_require_fixed
        imm r20, 411
        imm r21, 255
        imm r22, 37430
        imm r23, 1
        imm r24, 40                    ; emit_dec procedure identity
        call exact_proc_entry_r24
        imm r25, 37439
        call expression_factor_require_site
        imm r20, 412
        imm r21, 1
        call expression_factor_require_fixed
        imm r1, 541256
        imm r2, 2                     ; char and number complete
        store r1, r2
        imm r1, 541264
        imm r2, 1                     ; exact prefix,value,newline custody
        store r1, r2
        imm r1, 541272
        store r1, r2                   ; fallback zero-digit parse is admitted
        ret

expression_factor_publish:
        imm r20, 541200
        imm r21, 1
        call exact_require_cell
        imm r20, 541216
        imm r21, 2
        call exact_require_cell
        imm r20, 541232
        imm r21, 5
        call exact_require_cell
        imm r20, 541256
        imm r21, 2
        call exact_require_cell
        imm r1, 540056
        imm r2, 1128351303             ; GFAC
        store r1, r2
        ret
