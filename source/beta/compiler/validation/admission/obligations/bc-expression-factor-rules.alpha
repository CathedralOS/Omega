; Parameterized gen_factor relation.  Every recursive gen_expr call is supplied
; by the smaller remaining-depth context in the adjacent induction; this module
; fixes the exact dispatch/call order and proves that numeric resource status is
; carried rather than treated as an implicit early return.

expression_factor_rules_init:
        call expression_factor_reset
        call expression_factor_require_imports
        call expression_factor_prove_paren
        call expression_factor_prove_identifier
        call expression_factor_prove_literals
        call expression_factor_publish
        jmp expression_levels_rules_init

expression_factor_reset:
        imm r1, 541200
        imm r2, 0
expression_factor_reset_loop:
        imm r3, 541800
        jlt r1, r3, expression_factor_reset_one
        ret
expression_factor_reset_one:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp expression_factor_reset_loop

expression_factor_require_imports:
        imm r20, 540016
        imm r21, 1364349016             ; XPRQ
        call exact_require_cell
        imm r20, 540024
        imm r21, 1279347796             ; XTAL
        call exact_require_cell
        imm r20, 540032
        imm r21, 1380207687             ; GLDR
        call exact_require_cell
        imm r20, 540048
        imm r21, 1279347783             ; GCAL
        call exact_require_cell
        imm r20, 540008
        imm r21, 1263488844             ; exported LOOK
        call exact_require_cell
        imm r20, 531928
        imm r21, 1396984901             ; ELDS
        call exact_require_cell
        imm r20, 526680
        imm r21, 1413631041             ; ALBT
        call exact_require_cell
        imm r20, 526792
        imm r21, 1396984146             ; RIDS
        call exact_require_cell
        imm r20, 529144
        imm r21, 1297436240             ; PNUM
        call exact_require_cell
        imm r20, 529416
        imm r21, 1380467536             ; PCHR
        call exact_require_cell
        imm r20, 530456
        imm r21, 1398231878             ; FKWS
        call exact_require_cell
        imm r20, 532560
        imm r21, 1464026436             ; DECW
        call exact_require_cell
        imm r1, 541200
        imm r2, 1
        store r1, r2
        ret

; r21=source block, r22=arity, r23=target procedure identity. The canonical
; event owner reconstructs the unique call and its nine-byte fallthrough.
expression_factor_require_site:
        mov r24, r23
        imm r23, 0                  ; no ambient expression temporary
        imm r20, 55                 ; gen_factor owning procedure identity
        call summary_require_call_fallthrough_identity
        ret

expression_factor_prove_paren:
        ; Leading SWS/cbyte select the exact '(' versus complement partition.
        imm r21, 243
        imm r22, 0
        imm r23, 10                 ; skip_ws procedure identity
        call expression_factor_require_site
        imm r21, 243
        imm r22, 0
        imm r23, 4                  ; cbyte procedure identity
        call expression_factor_require_site
        imm r21, 245
        imm r22, 0
        imm r23, 5                  ; adv procedure identity
        call expression_factor_require_site
        imm r21, 245
        imm r22, 0
        imm r23, 61                 ; gen_expr procedure identity
        call expression_factor_require_site
        imm r21, 245
        imm r22, 1
        imm r23, 24                 ; expect procedure identity
        call expression_factor_require_site
        ; Both child status outcomes still execute permissive expect(')').
        imm r10, 0
expression_factor_paren_status_loop:
        imm r1, 2
        jlt r10, r1, expression_factor_paren_status_case
        imm r1, 541216
        imm r2, 2
        store r1, r2
        ret
expression_factor_paren_status_case:
        imm r1, 541208
        store r1, r10                  ; child 0 / numeric252
        imm r1, 541224
        imm r2, 1
        store r1, r2                   ; EXPS/XTAL closing expect always executes
        imm r1, 1
        add r10, r1
        jmp expression_factor_paren_status_loop

expression_factor_prove_identifier:
        ; Alpha branch: maximal identifier, byte/word special forms, then
        ; call-versus-variable. FKWS supplies all three exact predicates.
        imm r21, 246
        imm r22, 1
        imm r23, 7                  ; is_alpha procedure identity
        call expression_factor_require_site
        imm r21, 247
        imm r22, 0
        imm r23, 12                 ; read_ident procedure identity
        call expression_factor_require_site
        imm r21, 247
        imm r22, 0
        imm r23, 19                 ; is_byte procedure identity
        call expression_factor_require_site
        imm r21, 248
        imm r22, 1
        imm r23, 25                 ; gen_load procedure identity
        call expression_factor_require_site
        imm r21, 249
        imm r22, 0
        imm r23, 20                 ; is_word procedure identity
        call expression_factor_require_site
        imm r21, 250
        imm r22, 1
        imm r23, 25                 ; gen_load procedure identity
        call expression_factor_require_site
        imm r21, 251
        imm r22, 0
        imm r23, 10                 ; skip_ws procedure identity
        call expression_factor_require_site
        imm r21, 251
        imm r22, 0
        imm r23, 4                  ; cbyte procedure identity
        call expression_factor_require_site
        ; Artifact order is lookup first, then parameterized emit_load_slot.
        imm r21, 251
        imm r22, 0
        imm r23, 36                 ; lookup procedure identity
        call expression_factor_require_site
        imm r21, 251
        imm r22, 1
        imm r23, 51                 ; emit_load_slot procedure identity
        call expression_factor_require_site
        imm r21, 252
        imm r22, 0
        imm r23, 32                 ; gen_call procedure identity
        call expression_factor_require_site
        imm r1, 541232
        imm r2, 5                     ; byte/word/call/variable/fallback cases
        store r1, r2
        imm r1, 541240
        imm r2, 1                     ; lookup slot is ELDS slot unchanged
        store r1, r2
        imm r1, 541248
        store r1, r2                   ; delegated resource status retained
        ret

expression_factor_require_fixed:
        ; r21=source block, r22=literal pointer, r23=literal length.
        mov r50, r23
        imm r20, 55                 ; gen_factor owning procedure identity
        call exact_unique_emit_event_identity
        mov r20, r1                 ; checked source event row for WSTR theorem
        call write_str_require_emit_event
        jeq r1, r50, exact_shape_ok
        jmp reject

expression_factor_prove_literals:
        ; Character: parse first, then prefix/DECW/newline.
        imm r21, 254
        imm r22, 0
        imm r23, 56                 ; parse_char procedure identity
        call expression_factor_require_site
        imm r21, 254
        imm r22, expression_factor_literal_imm_r0_prefix
        imm r23, 7
        call expression_factor_require_fixed
        imm r21, 254
        imm r22, 1
        imm r23, 40                 ; emit_dec procedure identity
        call expression_factor_require_site
        imm r21, 254
        imm r22, expression_factor_literal_newline
        imm r23, 1
        call expression_factor_require_fixed

        ; Number: maximal modulo-Word fold feeds the same full-Word emitter.
        imm r21, 255
        imm r22, 0
        imm r23, 33                 ; parse_number procedure identity
        call expression_factor_require_site
        imm r21, 255
        imm r22, expression_factor_literal_imm_r0_prefix
        imm r23, 7
        call expression_factor_require_fixed
        imm r21, 255
        imm r22, 1
        imm r23, 40                 ; emit_dec procedure identity
        call expression_factor_require_site
        imm r21, 255
        imm r22, expression_factor_literal_newline
        imm r23, 1
        call expression_factor_require_fixed
        imm r1, 541256
        imm r2, 2                     ; char and number complete
        store r1, r2
        imm r1, 541264
        imm r2, 1                     ; exact prefix,value,newline custody
        store r1, r2
        imm r1, 541272
        store r1, r2                   ; fallback zero-digit parse is admitted
        ret

expression_factor_publish:
        imm r20, 541200
        imm r21, 1
        call exact_require_cell
        imm r20, 541216
        imm r21, 2
        call exact_require_cell
        imm r20, 541232
        imm r21, 5
        call exact_require_cell
        imm r20, 541256
        imm r21, 2
        call exact_require_cell
        imm r1, 540056
        imm r2, 1128351303             ; GFAC
        store r1, r2
        ret

expression_factor_literal_imm_r0_prefix:
        db "imm r0,"
expression_factor_literal_newline:
        db "\n"
