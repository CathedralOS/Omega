; Exact selected shape for parse_proc.genbody (procedure68, block348).
; Earlier blocks are owned by Checker A's PCAP/PFXS relation. This module binds
; the two unconditional child calls, literal source return, both epilogues,
; exhaustive empty data families, and the decoded quiet region.
; The decoded scan's PC-producing block identity binds block348; the canonical
; procedure inventory owns its procedure/state partition.

parse_body_shape_init:
        call parse_body_require_proc
        call parse_body_require_events
        call parse_body_require_data
        call parse_body_require_censuses
        call parse_body_require_decoded
        imm r1, 560432
        imm r2, 1213416016             ; PBSH
        store r1, r2
        jmp parse_body_rules_init

parse_body_require_proc:
        imm r20, 68
        imm r21, 0
        imm r22, 5
        imm r23, 48
        call exact_require_proc_frame_identity
        jmp exact_shape_ok

; r22=target procedure identity.
parse_body_require_call:
        mov r24, r22
        imm r20, 68
        imm r21, 348
        imm r22, 0
        imm r23, 0
        call summary_require_call_fallthrough_identity
        ret

parse_body_require_events:
        imm r20, 600
        imm r22, 62                    ; gen_stmts procedure identity
        call parse_body_require_call
        imm r20, 601
        imm r22, 46                    ; emit_epilogue procedure identity
        call parse_body_require_call
        imm r20, 68                    ; parse_proc procedure identity
        imm r21, 348
        call exact_require_event_epilogue
        imm r20, 69                    ; main identifies synthetic return
        call exact_require_preentry_epilogue
        ret

parse_body_require_data:
        imm r20, 805
        imm r21, 348
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        ret

parse_body_require_censuses:
        imm r20, 348
        imm r21, 348
        imm r22, 240
        imm r23, 240                  ; no locals
        imm r24, 95
        imm r25, 95                   ; no raw memory
        imm r26, 286
        imm r27, 286                  ; no transitions
        imm r28, 600
        imm r29, 603
        call exact_require_effect_census
        imm r20, 348
        imm r21, 348
        imm r22, 805
        imm r23, 806
        imm r24, 232
        imm r25, 232                  ; no binary pushes
        imm r26, 371
        imm r27, 371                  ; no argument pushes
        imm r28, 0
        imm r29, 0                    ; no store-address pushes
        call summary_require_expr_census
        ret

parse_body_require_decoded:
        imm r20, 348
        imm r21, 68
        imm r22, 1
        call exact_block_identity_pc
        mov r30, r0
        imm r0, 69
        call exact_proc_entry_pc
        mov r21, r0
        mov r20, r30
        imm r22, 2                    ; calls
        imm r23, 2                    ; returns
        imm r24, 0                    ; target stores
        call exact_quiet_scan_region
        ret
