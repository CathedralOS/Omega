; Exact control/effect shape for the bounded emitter leaf family.
;
; Procedures 30,44,47..52 are deliberately noncontiguous in the artifact.
; The canonical procedure inventory owns their total block spans and partitions.
; This module pins their procedure metadata, emit_mnemonic branch graph, every
; source effect, ordinary call handoff/target/continuation, and explicit plus
; synthetic epilogues. The adjacent data-shape module owns local/expression rows
; and exhaustive source/decoded censuses.

bounded_emitters_require_shape:
        call bounded_emitters_require_control_shape
        call bounded_emitters_require_data_shape
        ret

bounded_emitters_require_control_shape:
        call bounded_emitters_require_proc_meta
        call bounded_emitters_require_proc_spans
        call bounded_emitters_require_transitions
        call bounded_emitters_require_events
        ret

; r20=procedure, r21=parameter count, r22=slot count, r23=frame bytes.
bounded_emitters_require_one_proc:
        call exact_require_proc_frame_identity
        ret

bounded_emitters_require_proc_meta:
        imm r20, 30
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call bounded_emitters_require_one_proc
        imm r20, 44
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call bounded_emitters_require_one_proc
        imm r20, 47
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call bounded_emitters_require_one_proc
        imm r20, 48
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call bounded_emitters_require_one_proc
        imm r20, 49
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call bounded_emitters_require_one_proc
        imm r20, 50
        imm r21, 2
        imm r22, 2
        imm r23, 24                   ; emit_slot_addr frame
        call bounded_emitters_require_one_proc
        imm r20, 51
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call bounded_emitters_require_one_proc
        imm r20, 52
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call bounded_emitters_require_one_proc
        ret

; r20=the sole block, r21=procedure.
bounded_emitters_require_single_block_span:
        mov r22, r21
        mov r21, r20
        call exact_require_proc_blocks
        ret

bounded_emitters_require_proc_spans:
        imm r20, 148
        imm r21, 30
        call bounded_emitters_require_single_block_span
        imm r20, 213
        imm r21, 44
        call bounded_emitters_require_single_block_span
        imm r20, 218
        imm r21, 47
        call bounded_emitters_require_single_block_span
        imm r20, 219
        imm r21, 229
        imm r22, 48
        call exact_require_proc_blocks
        imm r20, 230
        imm r21, 49
        call bounded_emitters_require_single_block_span
        imm r20, 231
        imm r21, 50
        call bounded_emitters_require_single_block_span
        imm r20, 232
        imm r21, 51
        call bounded_emitters_require_single_block_span
        imm r20, 233
        imm r21, 52
        call bounded_emitters_require_single_block_span
        ret

; row/source block/guarded/target in r20..r23.
bounded_emitters_require_transitions:
        imm r20, 169
        imm r21, 220
        imm r22, 1
        imm r23, 221
        call exact_transition_identity_pc
        imm r20, 170
        imm r21, 220
        imm r22, 0
        imm r23, 222
        call exact_transition_identity_pc
        imm r20, 171
        imm r21, 222
        imm r22, 1
        imm r23, 223
        call exact_transition_identity_pc
        imm r20, 172
        imm r21, 222
        imm r22, 0
        imm r23, 224
        call exact_transition_identity_pc
        imm r20, 173
        imm r21, 224
        imm r22, 1
        imm r23, 225
        call exact_transition_identity_pc
        imm r20, 174
        imm r21, 224
        imm r22, 0
        imm r23, 226
        call exact_transition_identity_pc
        imm r20, 175
        imm r21, 226
        imm r22, 1
        imm r23, 227
        call exact_transition_identity_pc
        imm r20, 176
        imm r21, 226
        imm r22, 0
        imm r23, 228
        call exact_transition_identity_pc
        imm r20, 177
        imm r21, 228
        imm r22, 1
        imm r23, 229
        call exact_transition_identity_pc
        ret

; r20=semantic row, r21=procedure, r22=block, r23=literal, r24=length.
bounded_emitters_require_fixed_event:
        mov r50, r20
        mov r20, r21
        mov r21, r22
        mov r22, r23
        mov r23, r24
        call exact_unique_emit_event_identity
        jeq r1, r50, bounded_emitters_fixed_event_ok
        jmp reject
bounded_emitters_fixed_event_ok:
        ret

; r20=semantic row, r21=procedure, r22=block, r23=arity, r24=target.
bounded_emitters_require_ordinary_call:
        mov r50, r20
        mov r20, r21
        mov r21, r22
        mov r22, r23
        imm r23, 0
        call exact_unique_call_event_identity
        jeq r1, r50, bounded_emitters_call_ok
        jmp reject
bounded_emitters_call_ok:
        call summary_require_selected_call_fallthrough
        ret

; As above, with occurrence/cardinality in r25/r26.
bounded_emitters_require_nth_call:
        mov r50, r20
        mov r20, r21
        mov r21, r22
        mov r22, r23
        imm r23, 0
        call exact_nth_call_event_identity
        jeq r1, r50, bounded_emitters_nth_call_ok
        jmp reject
bounded_emitters_nth_call_ok:
        call summary_require_selected_call_fallthrough
        ret

bounded_emitters_require_return:
        call exact_require_event_epilogue
        ret

bounded_emitters_require_events:
        ; gen_read_byte: two expect children, one fixed output, return zero.
        imm r20, 233
        imm r21, 30
        imm r22, 148
        imm r23, 1
        imm r24, 24                 ; expect procedure identity
        imm r25, 0
        imm r26, 2
        call bounded_emitters_require_nth_call
        imm r20, 234
        imm r21, 30
        imm r22, 148
        imm r23, 1
        imm r24, 24                 ; expect procedure identity
        imm r25, 1
        imm r26, 2
        call bounded_emitters_require_nth_call
        imm r20, 235
        imm r21, 30
        imm r22, 148
        imm r23, bounded_emitters_literal_read_r0
        imm r24, 8
        call bounded_emitters_require_fixed_event
        imm r20, 30
        imm r21, 148
        call bounded_emitters_require_return

        ; emit_pop_into.
        imm r20, 334
        imm r21, 44
        imm r22, 213
        imm r23, bounded_emitters_literal_load_r
        imm r24, 6
        call bounded_emitters_require_fixed_event
        imm r20, 335
        imm r21, 44
        imm r22, 213
        imm r23, 1
        imm r24, 40                 ; emit_dec procedure identity
        call bounded_emitters_require_ordinary_call
        imm r20, 336
        imm r21, 44
        imm r22, 213
        imm r23, bounded_emitters_literal_comma_r15
        imm r24, 5
        call bounded_emitters_require_fixed_event
        imm r20, 337
        imm r21, 44
        imm r22, 213
        imm r23, bounded_emitters_literal_empty
        imm r24, 0
        call bounded_emitters_require_fixed_event
        imm r20, 338
        imm r21, 44
        imm r22, 213
        imm r23, bounded_emitters_literal_add_r15_r13
        imm r24, 12
        call bounded_emitters_require_fixed_event

        ; emit_push.
        imm r20, 346
        imm r21, 47
        imm r22, 218
        imm r23, bounded_emitters_literal_empty
        imm r24, 0
        call bounded_emitters_require_fixed_event
        imm r20, 347
        imm r21, 47
        imm r22, 218
        imm r23, bounded_emitters_literal_sub_r15_r13
        imm r24, 12
        call bounded_emitters_require_fixed_event
        imm r20, 348
        imm r21, 47
        imm r22, 218
        imm r23, bounded_emitters_literal_store_r15_r0
        imm r24, 13
        call bounded_emitters_require_fixed_event

        call bounded_emitters_require_mnemonic_events
        call bounded_emitters_require_combine_events
        call bounded_emitters_require_slot_events
        call bounded_emitters_require_slot_leaf_events
        call bounded_emitters_require_epilogues
        ret

bounded_emitters_require_mnemonic_events:
        imm r20, 349
        imm r21, 48
        imm r22, 221
        imm r23, bounded_emitters_literal_add
        imm r24, 3
        call bounded_emitters_require_fixed_event
        imm r20, 48
        imm r21, 221
        call bounded_emitters_require_return
        imm r20, 351
        imm r21, 48
        imm r22, 223
        imm r23, bounded_emitters_literal_sub
        imm r24, 3
        call bounded_emitters_require_fixed_event
        imm r20, 48
        imm r21, 223
        call bounded_emitters_require_return
        imm r20, 353
        imm r21, 48
        imm r22, 225
        imm r23, bounded_emitters_literal_mul
        imm r24, 3
        call bounded_emitters_require_fixed_event
        imm r20, 48
        imm r21, 225
        call bounded_emitters_require_return
        imm r20, 355
        imm r21, 48
        imm r22, 227
        imm r23, bounded_emitters_literal_div
        imm r24, 3
        call bounded_emitters_require_fixed_event
        imm r20, 48
        imm r21, 227
        call bounded_emitters_require_return
        imm r20, 48
        imm r21, 228
        call bounded_emitters_require_return
        imm r20, 358
        imm r21, 48
        imm r22, 229
        imm r23, bounded_emitters_literal_mod
        imm r24, 3
        call bounded_emitters_require_fixed_event
        imm r20, 48
        imm r21, 229
        call bounded_emitters_require_return
        ret

bounded_emitters_require_combine_events:
        imm r20, 360
        imm r21, 49
        imm r22, 230
        imm r23, bounded_emitters_literal_mov_r1_r0
        imm r24, 10
        call bounded_emitters_require_fixed_event
        imm r20, 361
        imm r21, 49
        imm r22, 230
        imm r23, bounded_emitters_literal_load_r0_r15
        imm r24, 12
        call bounded_emitters_require_fixed_event
        imm r20, 362
        imm r21, 49
        imm r22, 230
        imm r23, bounded_emitters_literal_empty
        imm r24, 0
        call bounded_emitters_require_fixed_event
        imm r20, 363
        imm r21, 49
        imm r22, 230
        imm r23, bounded_emitters_literal_add_r15_r13
        imm r24, 12
        call bounded_emitters_require_fixed_event
        imm r20, 364
        imm r21, 49
        imm r22, 230
        imm r23, 1
        imm r24, 48                 ; emit_mnemonic procedure identity
        call bounded_emitters_require_ordinary_call
        imm r20, 365
        imm r21, 49
        imm r22, 230
        imm r23, bounded_emitters_literal_space_r0_r1
        imm r24, 7
        call bounded_emitters_require_fixed_event
        ret

bounded_emitters_require_slot_events:
        imm r20, 366
        imm r21, 50
        imm r22, 231
        imm r23, bounded_emitters_literal_mov_r
        imm r24, 5
        call bounded_emitters_require_fixed_event
        imm r20, 367
        imm r21, 50
        imm r22, 231
        imm r23, 1
        imm r24, 40                 ; emit_dec procedure identity
        imm r25, 0
        imm r26, 3
        call bounded_emitters_require_nth_call
        imm r20, 368
        imm r21, 50
        imm r22, 231
        imm r23, bounded_emitters_literal_comma_r14
        imm r24, 5
        call bounded_emitters_require_fixed_event
        imm r20, 369
        imm r21, 50
        imm r22, 231
        imm r23, bounded_emitters_literal_imm_r2
        imm r24, 7
        call bounded_emitters_require_fixed_event
        imm r20, 370
        imm r21, 50
        imm r22, 231
        imm r23, 1
        imm r24, 40                 ; emit_dec procedure identity
        imm r25, 1
        imm r26, 3
        call bounded_emitters_require_nth_call
        imm r20, 371
        imm r21, 50
        imm r22, 231
        imm r23, bounded_emitters_literal_newline
        imm r24, 1
        call bounded_emitters_require_fixed_event
        imm r20, 372
        imm r21, 50
        imm r22, 231
        imm r23, bounded_emitters_literal_sub_r
        imm r24, 5
        call bounded_emitters_require_fixed_event
        imm r20, 373
        imm r21, 50
        imm r22, 231
        imm r23, 1
        imm r24, 40                 ; emit_dec procedure identity
        imm r25, 2
        imm r26, 3
        call bounded_emitters_require_nth_call
        imm r20, 374
        imm r21, 50
        imm r22, 231
        imm r23, bounded_emitters_literal_comma_r2
        imm r24, 4
        call bounded_emitters_require_fixed_event
        ret

bounded_emitters_require_slot_leaf_events:
        imm r20, 375
        imm r21, 51
        imm r22, 232
        imm r23, 2
        imm r24, 50                 ; emit_slot_addr procedure identity
        call bounded_emitters_require_ordinary_call
        imm r20, 376
        imm r21, 51
        imm r22, 232
        imm r23, bounded_emitters_literal_load_r0_r0
        imm r24, 11
        call bounded_emitters_require_fixed_event
        imm r20, 377
        imm r21, 52
        imm r22, 233
        imm r23, 2
        imm r24, 50                 ; emit_slot_addr procedure identity
        call bounded_emitters_require_ordinary_call
        imm r20, 378
        imm r21, 52
        imm r22, 233
        imm r23, bounded_emitters_literal_store_r1_r0
        imm r24, 12
        call bounded_emitters_require_fixed_event
        ret

bounded_emitters_require_epilogues:
        imm r20, 31                  ; after gen_read_byte
        call exact_require_preentry_epilogue
        imm r20, 45                  ; after emit_pop_into
        call exact_require_preentry_epilogue
        imm r20, 48                  ; after emit_push
        call exact_require_preentry_epilogue
        imm r20, 49                  ; after emit_mnemonic
        call exact_require_preentry_epilogue
        imm r20, 50                  ; after emit_combine
        call exact_require_preentry_epilogue
        imm r20, 51                  ; after emit_slot_addr
        call exact_require_preentry_epilogue
        imm r20, 52                  ; after emit_load_slot
        call exact_require_preentry_epilogue
        imm r20, 53                  ; after emit_store_slot
        call exact_require_preentry_epilogue
        ret

bounded_emitters_literal_read_r0:
        db "read r0\n"
bounded_emitters_literal_load_r:
        db "load r"
bounded_emitters_literal_comma_r15:
        db ",r15\n"
bounded_emitters_literal_empty:
bounded_emitters_literal_add_r15_r13:
        db "add r15,r13\n"
bounded_emitters_literal_sub_r15_r13:
        db "sub r15,r13\n"
bounded_emitters_literal_store_r15_r0:
        db "store r15,r0\n"
bounded_emitters_literal_add:
        db "add"
bounded_emitters_literal_sub:
        db "sub"
bounded_emitters_literal_mul:
        db "mul"
bounded_emitters_literal_div:
        db "div"
bounded_emitters_literal_mod:
        db "mod"
bounded_emitters_literal_mov_r1_r0:
        db "mov r1,r0\n"
bounded_emitters_literal_load_r0_r15:
        db "load r0,r15\n"
bounded_emitters_literal_space_r0_r1:
        db " r0,r1\n"
bounded_emitters_literal_mov_r:
        db "mov r"
bounded_emitters_literal_comma_r14:
        db ",r14\n"
bounded_emitters_literal_imm_r2:
        db "imm r2,"
bounded_emitters_literal_newline:
        db "\n"
bounded_emitters_literal_sub_r:
        db "sub r"
bounded_emitters_literal_comma_r2:
        db ",r2\n"
bounded_emitters_literal_load_r0_r0:
        db "load r0,r0\n"
bounded_emitters_literal_store_r1_r0:
        db "store r1,r0\n"
