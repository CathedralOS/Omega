; Exact control/effect shape for the bounded emitter leaf family.
;
; Procedures 30,44,47..52 are deliberately noncontiguous in the artifact.
; This module pins their procedure metadata, blocks, emit_mnemonic branch
; graph, every source effect, ordinary call handoff/target/continuation, and
; explicit plus synthetic epilogues.  The adjacent data-shape module owns
; local/expression rows and exhaustive source/decoded censuses.

bounded_emitters_require_shape:
        call bounded_emitters_require_control_shape
        call bounded_emitters_require_data_shape
        ret

bounded_emitters_require_control_shape:
        call bounded_emitters_require_proc_meta
        call bounded_emitters_require_blocks
        call bounded_emitters_require_transitions
        call bounded_emitters_require_events
        ret

; r20=procedure, r21=parameter count, r22=slot count, r23=frame bytes.
bounded_emitters_require_one_proc:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        imm r20, 7151616
        mov r21, r30
        mov r22, r31
        call transfer_require_cell
        imm r20, 7159808
        mov r21, r30
        mov r22, r32
        call transfer_require_cell
        mov r20, r30
        call call_bounds_frame_bytes
        jeq r0, r33, exact_shape_ok
        jmp reject

bounded_emitters_require_proc_meta:
        imm r20, 30
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call bounded_emitters_require_one_proc
        imm r20, 44
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call bounded_emitters_require_one_proc
        imm r20, 47
        imm r21, 0
        imm r22, 0
        imm r23, 8
        call bounded_emitters_require_one_proc
        imm r20, 48
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call bounded_emitters_require_one_proc
        imm r20, 49
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call bounded_emitters_require_one_proc
        imm r20, 50
        imm r21, 2
        imm r22, 2
        imm r23, 24                   ; emit_slot_addr frame
        call bounded_emitters_require_one_proc
        imm r20, 51
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call bounded_emitters_require_one_proc
        imm r20, 52
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call bounded_emitters_require_one_proc
        ret

; r20=row, r21=PC, r22=procedure.  These procedures have one entry block.
bounded_emitters_require_single_block:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r20, r30
        mov r21, r31
        call exact_require_block_pc
        mov r20, r30
        mov r21, r30
        mov r22, r32
        call exact_require_proc_blocks
        ret

bounded_emitters_require_blocks:
        imm r20, 148
        imm r21, 21226
        imm r22, 30
        call bounded_emitters_require_single_block
        imm r20, 213
        imm r21, 44                    ; emit_pop_into procedure identity
        call exact_proc_entry_r21
        imm r22, 44
        call bounded_emitters_require_single_block
        imm r20, 218
        imm r21, 47                    ; emit_push procedure identity
        call exact_proc_entry_r21
        imm r22, 47
        call bounded_emitters_require_single_block

        imm r20, 219
        imm r21, 32434
        call exact_require_block_pc
        imm r20, 220
        imm r21, 32485
        call exact_require_block_pc
        imm r20, 221
        imm r21, 32617
        call exact_require_block_pc
        imm r20, 222
        imm r21, 32688
        call exact_require_block_pc
        imm r20, 223
        imm r21, 32820
        call exact_require_block_pc
        imm r20, 224
        imm r21, 32891
        call exact_require_block_pc
        imm r20, 225
        imm r21, 33023
        call exact_require_block_pc
        imm r20, 226
        imm r21, 33094
        call exact_require_block_pc
        imm r20, 227
        imm r21, 33226
        call exact_require_block_pc
        imm r20, 228
        imm r21, 33297
        call exact_require_block_pc
        imm r20, 229
        imm r21, 33450
        call exact_require_block_pc
        imm r20, 219
        imm r21, 229
        imm r22, 48
        call exact_require_proc_blocks

        imm r20, 230
        imm r21, 33541
        imm r22, 49
        call bounded_emitters_require_single_block
        imm r20, 231
        imm r21, 33911
        imm r22, 50
        call bounded_emitters_require_single_block
        imm r20, 232
        imm r21, 34532
        imm r22, 51
        call bounded_emitters_require_single_block
        imm r20, 233
        imm r21, 34754
        imm r22, 52
        call bounded_emitters_require_single_block
        ret

; row/source block/guarded/target/control PC in r20..r24.
bounded_emitters_require_transitions:
        imm r20, 169
        imm r21, 220
        imm r22, 1
        imm r23, 221
        imm r24, 32589               ; add-guard control PC
        call exact_require_transition
        imm r20, 170
        imm r21, 220
        imm r22, 0
        imm r23, 222
        imm r24, 32608
        call exact_require_transition
        imm r20, 171
        imm r21, 222
        imm r22, 1
        imm r23, 223
        imm r24, 32792
        call exact_require_transition
        imm r20, 172
        imm r21, 222
        imm r22, 0
        imm r23, 224
        imm r24, 32811
        call exact_require_transition
        imm r20, 173
        imm r21, 224
        imm r22, 1
        imm r23, 225
        imm r24, 32995
        call exact_require_transition
        imm r20, 174
        imm r21, 224
        imm r22, 0
        imm r23, 226
        imm r24, 33014
        call exact_require_transition
        imm r20, 175
        imm r21, 226
        imm r22, 1
        imm r23, 227
        imm r24, 33198
        call exact_require_transition
        imm r20, 176
        imm r21, 226
        imm r22, 0
        imm r23, 228
        imm r24, 33217
        call exact_require_transition
        imm r20, 177
        imm r21, 228
        imm r22, 1
        imm r23, 229
        imm r24, 33401
        call exact_require_transition
        ret

; r20=row, r21=block, r22=PC for one fixed-string event.
bounded_emitters_require_fixed_event:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r20, r30
        mov r21, r31
        imm r22, 4
        mov r23, r32
        call exact_require_event
        ret

; r20=row, r21=block, r22=call PC, r23=arity, r24=target,
; r25=exact continuation.
; All selected ordinary calls have zero ambient words and a nine-byte call.
bounded_emitters_require_ordinary_call:
        mov r30, r20
        mov r31, r21
        mov r32, r22
        mov r33, r23
        mov r34, r24
        mov r35, r25
        mov r20, r30
        mov r21, r31
        imm r22, 1
        mov r23, r32
        call exact_require_event
        mov r2, r30
        imm r1, 8
        mul r2, r1
        imm r1, 7143424
        add r1, r2
        load r2, r1
        jeq r2, r33, bounded_emitters_call_ambient
        jmp reject
bounded_emitters_call_ambient:
        mov r2, r30
        imm r1, 8
        mul r2, r1
        imm r1, 10035200
        add r1, r2
        load r2, r1
        imm r1, 0
        jeq r2, r1, bounded_emitters_call_continuation
        jmp reject
bounded_emitters_call_continuation:
        mov r20, r32
        mov r21, r34
        mov r22, r35
        call exact_require_call
        ret

bounded_emitters_require_events:
        ; gen_read_byte: two expect children, one fixed output, return zero.
        imm r20, 233
        imm r21, 148
        imm r22, 21287
        imm r23, 1
        imm r24, 17441               ; first expect target
        imm r25, 21296               ; exact first call continuation
        call bounded_emitters_require_ordinary_call
        imm r20, 234
        imm r21, 148
        imm r22, 21338
        imm r23, 1
        imm r24, 17441               ; second expect target
        imm r25, 21347               ; exact second call continuation
        call bounded_emitters_require_ordinary_call
        imm r20, 235
        imm r21, 148
        imm r22, 21384
        call bounded_emitters_require_fixed_event
        imm r20, 236
        imm r21, 148
        imm r22, 5
        imm r23, 21422
        call exact_require_event

        ; emit_pop_into.
        imm r20, 334
        imm r21, 213
        imm r22, 31237
        call bounded_emitters_require_fixed_event
        imm r20, 335
        imm r21, 213
        imm r22, 31297
        imm r23, 1
        imm r24, 40                    ; emit_dec procedure identity
        call exact_proc_entry_r24
        imm r25, 31306
        call bounded_emitters_require_ordinary_call
        imm r20, 336
        imm r21, 213
        imm r22, 31340
        call bounded_emitters_require_fixed_event
        imm r20, 337
        imm r21, 213
        imm r22, 31387
        call bounded_emitters_require_fixed_event
        imm r20, 338
        imm r21, 213
        imm r22, 31436
        call bounded_emitters_require_fixed_event

        ; emit_push.
        imm r20, 346
        imm r21, 218
        imm r22, 32305
        call bounded_emitters_require_fixed_event
        imm r20, 347
        imm r21, 218
        imm r22, 32354
        call bounded_emitters_require_fixed_event
        imm r20, 348
        imm r21, 218
        imm r22, 32405
        call bounded_emitters_require_fixed_event

        call bounded_emitters_require_mnemonic_events
        call bounded_emitters_require_combine_events
        call bounded_emitters_require_slot_events
        call bounded_emitters_require_slot_leaf_events
        call bounded_emitters_require_epilogues
        ret

bounded_emitters_require_mnemonic_events:
        imm r20, 349
        imm r21, 221
        imm r22, 32649
        call bounded_emitters_require_fixed_event
        imm r20, 350
        imm r21, 221
        imm r22, 5
        imm r23, 32687
        call exact_require_event
        imm r20, 351
        imm r21, 223
        imm r22, 32852
        call bounded_emitters_require_fixed_event
        imm r20, 352
        imm r21, 223
        imm r22, 5
        imm r23, 32890
        call exact_require_event
        imm r20, 353
        imm r21, 225
        imm r22, 33055
        call bounded_emitters_require_fixed_event
        imm r20, 354
        imm r21, 225
        imm r22, 5
        imm r23, 33093
        call exact_require_event
        imm r20, 355
        imm r21, 227
        imm r22, 33258
        call bounded_emitters_require_fixed_event
        imm r20, 356
        imm r21, 227
        imm r22, 5
        imm r23, 33296
        call exact_require_event
        imm r20, 357
        imm r21, 228
        imm r22, 5
        imm r23, 33449
        call exact_require_event
        imm r20, 358
        imm r21, 229
        imm r22, 33482               ; mod mnemonic event PC
        call bounded_emitters_require_fixed_event
        imm r20, 359
        imm r21, 229
        imm r22, 5
        imm r23, 33520
        call exact_require_event
        ret

