; Exact source/artifact shape for gen_emit().
;
; The canonical procedure inventory owns procedure 28's one-block span and
; entry partition. It composes permissive expect and whitespace normalization,
; two new_label calls, eleven exact fixed-string helpers, four label references,
; emit_str_body, full-Word emit_dec, a final permissive expect, and an explicit
; zero return. This module binds ordinary calls and the remaining distinct fixed
; emits to exact artifact sites. The three same-key standalone newlines instead
; use checker-owned cardinality,
; lexical occurrence, centralized helper extent, and relative artifact order.
; It also owns the three-slot frame, every local/literal/push row, both
; epilogues, and the whole decoded-region footprint.  The adjacent summary owns
; values and trace order.
;
; Private publication cell: 536680 = GESH.

gen_emit_require_shape:
        call gen_emit_require_proc
        call gen_emit_require_events
        call gen_emit_require_locals
        call gen_emit_require_primitives
        call gen_emit_require_pushes
        call gen_emit_require_censuses
        call gen_emit_require_decoded
        imm r1, 536680
        imm r2, 1213416775            ; GESH
        store r1, r2
        imm r20, 536680
        imm r21, 1213416775
        call exact_require_cell
        ret

gen_emit_require_proc:
        imm r20, 28
        imm r21, 0                    ; no parameters
        imm r22, 3                    ; slbl, albl, len
        imm r23, 32
        call exact_require_proc_frame_identity
        jmp gen_emit_shape_ok

; r22=arity,r23=target procedure. All ordinary calls are in block146 with no
; ambient expression words; event identity reconstructs PC and fallthrough.
gen_emit_require_call:
        imm r21, 146
        mov r24, r23
        imm r23, 0
        imm r20, 28
        call summary_require_call_fallthrough_identity
        ret

; r22=arity,r23=target,r24=occurrence,r25=exact cardinality.
gen_emit_require_nth_call:
        mov r26, r25
        mov r25, r24
        mov r24, r23
        imm r23, 0
        imm r21, 146
        imm r20, 28
        call summary_require_nth_call_fallthrough_identity
        ret

; r20=row. Distinct source emits retain their source-row identity while the
; common owner reconstructs literal, helper target, and fallthrough layout.
gen_emit_require_fixed:
        call write_str_require_emit_event_core
        ret

; The three standalone newlines have one complete semantic key. Select them by
; checker-owned lexical occurrence at exact cardinality three, validate each
; selected helper call against the centralized synthesized-helper extent, and
; require that the selected artifact sites retain lexical order. r20 is the
; occurrence; return its checked event PC in r0.
gen_emit_resolve_newline_occurrence:
        mov r47, r20
        imm r20, 28                   ; gen_emit procedure identity
        imm r21, 146                  ; sole source block
        imm r22, gen_emit_literal_newline
        imm r23, 1
        mov r24, r47
        imm r25, 3                    ; exact same-key cardinality
        call exact_nth_emit_event_identity
        mov r31, r0
        call exact_require_write_str_extent
        mov r20, r31
        mov r21, r0
        mov r22, r31
        imm r1, 9
        add r22, r1
        call exact_require_call
        mov r0, r31
        ret

gen_emit_require_newline_occurrences:
        imm r20, 0
        call gen_emit_resolve_newline_occurrence
        mov r50, r0
        imm r20, 1
        call gen_emit_resolve_newline_occurrence
        jlt r50, r0, gen_emit_newline_occurrence_one_ordered
        jmp reject
gen_emit_newline_occurrence_one_ordered:
        mov r50, r0
        imm r20, 2
        call gen_emit_resolve_newline_occurrence
        jlt r50, r0, gen_emit_newline_occurrences_ordered
        jmp reject
gen_emit_newline_occurrences_ordered:
        ret

gen_emit_require_events:
        call gen_emit_require_newline_occurrences

        ; Opening delimiter and normalization.
        imm r22, 1
        imm r23, 24                   ; expect
        imm r24, 0
        imm r25, 2
        call gen_emit_require_nth_call
        imm r22, 0
        imm r23, 10                   ; skip_ws
        call gen_emit_require_call

        ; Exact consecutive label allocation.
        imm r22, 0
        imm r23, 1                    ; new_label
        imm r24, 0
        imm r25, 2
        call gen_emit_require_nth_call
        imm r22, 0
        imm r23, 1                    ; new_label
        imm r24, 1
        imm r25, 2
        call gen_emit_require_nth_call

        imm r20, 202
        call gen_emit_require_fixed
        imm r22, 1
        imm r23, 2                    ; emit_lref
        imm r24, 0
        imm r25, 4
        call gen_emit_require_nth_call
        imm r22, 1
        imm r23, 2                    ; emit_lref
        imm r24, 1
        imm r25, 4
        call gen_emit_require_nth_call
        imm r20, 206
        call gen_emit_require_fixed
        imm r20, 207
        call gen_emit_require_fixed
        imm r22, 0
        imm r23, 27                   ; emit_str_body
        call gen_emit_require_call
        imm r20, 209
        call gen_emit_require_fixed
        imm r22, 1
        imm r23, 2                    ; emit_lref
        imm r24, 2
        imm r25, 4
        call gen_emit_require_nth_call
        imm r20, 211
        call gen_emit_require_fixed
        imm r20, 212
        call gen_emit_require_fixed
        imm r22, 1
        imm r23, 2                    ; emit_lref
        imm r24, 3
        imm r25, 4
        call gen_emit_require_nth_call
        imm r20, 215
        call gen_emit_require_fixed
        imm r22, 1
        imm r23, 40                   ; emit_dec
        call gen_emit_require_call
        imm r20, 218
        call gen_emit_require_fixed
        imm r22, 1
        imm r23, 24                   ; expect
        imm r24, 1
        imm r25, 2
        call gen_emit_require_nth_call
        imm r21, 146
        imm r20, 28
        call exact_require_event_epilogue
        imm r20, 29                   ; emit_write_str identifies synthetic ret
        call exact_require_preentry_epilogue
        ret

; r20=row,r21=kind,r22=slot.
gen_emit_require_local:
        mov r23, r22
        mov r22, r21
        imm r21, 146
        call exact_local_identity_pc
        ret

gen_emit_require_locals:
        imm r20, 44
        imm r21, 2                    ; store slbl
        imm r22, 0
        call gen_emit_require_local
        imm r20, 45
        imm r21, 2                    ; store albl
        imm r22, 1
        call gen_emit_require_local
        imm r20, 46
        imm r21, 1                    ; load albl #1
        imm r22, 1
        call gen_emit_require_local
        imm r20, 47
        imm r21, 1                    ; load slbl #1
        imm r22, 0
        call gen_emit_require_local
        imm r20, 48
        imm r21, 2                    ; store body len
        imm r22, 2
        call gen_emit_require_local
        imm r20, 49
        imm r21, 1                    ; load albl #2
        imm r22, 1
        call gen_emit_require_local
        imm r20, 50
        imm r21, 1                    ; load slbl #2
        imm r22, 0
        call gen_emit_require_local
        imm r20, 51
        imm r21, 1                    ; load body len
        imm r22, 2
        call gen_emit_require_local
        ret

; r20=row,r21=value. All three are exact Word literals.
gen_emit_require_literal:
        mov r23, r21
        imm r21, 146
        imm r22, 1
        call exact_primitive_identity_pc
        ret

gen_emit_require_primitives:
        imm r20, 382
        imm r21, 40                   ; '('
        call gen_emit_require_literal
        imm r20, 383
        imm r21, 41                   ; ')'
        call gen_emit_require_literal
        imm r20, 384
        imm r21, 0                    ; explicit result
        call gen_emit_require_literal
        ret

; r20=row. Every push is ordinal-zero call-argument staging.
gen_emit_require_argument_push:
        imm r21, 146
        call exact_require_argument_push_identity
        ret

gen_emit_require_pushes:
        imm r20, 299                  ; expect('(')
        call gen_emit_require_argument_push
        imm r20, 300                  ; lref(albl) #1
        call gen_emit_require_argument_push
        imm r20, 301                  ; lref(slbl) #1
        call gen_emit_require_argument_push
        imm r20, 302                  ; lref(albl) #2
        call gen_emit_require_argument_push
        imm r20, 303                  ; lref(slbl) #2
        call gen_emit_require_argument_push
        imm r20, 304                  ; emit_dec(len)
        call gen_emit_require_argument_push
        imm r20, 305                  ; expect(')')
        call gen_emit_require_argument_push
        ret

gen_emit_require_censuses:
        imm r20, 146
        imm r21, 146
        imm r22, 44
        imm r23, 52                   ; exclusive local row
        imm r24, 33
        imm r25, 33                   ; no raw-memory rows
        imm r26, 108
        imm r27, 108                  ; no transition rows
        imm r28, 198
        imm r29, 221                  ; exclusive event row
        call exact_require_effect_census

        imm r20, 146
        imm r21, 146
        imm r22, 382
        imm r23, 385                  ; exclusive primitive row
        imm r24, 98
        imm r25, 98                   ; no binary pushes
        imm r26, 299
        imm r27, 306                  ; seven argument pushes
        imm r28, 383
        imm r29, 383                  ; no store-address pushes
        call summary_require_expr_census
        ret

gen_emit_require_decoded:
        ; Calls comprise eleven fixed helpers plus eleven ordinary children.
        ; Stores are saved-fp, three locals, and seven argument pushes.  There
        ; is no direct I/O, raw-memory access, branch, arithmetic, or trap site.
        imm r20, 28
        call exact_proc_entry_r20
        imm r21, 29
        call exact_proc_entry_r21
        imm r22, 22
        imm r23, 2                    ; explicit + synthetic returns
        imm r24, 11
        call exact_quiet_scan_region
        ret

gen_emit_shape_ok:
        ret

gen_emit_literal_newline:
        db "\n"
