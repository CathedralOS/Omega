; Exact source/artifact shape for expect(ch).
;
; This module owns procedure 24's three blocks, its guarded match transition,
; skip_ws/cbyte/adv calls, parameter load, comparison/literals, binary push,
; returns/epilogues, frame, and exhaustive effect/expression/decoded censuses.
; The adjacent module owns the nonzero-delimiter relational meaning.

expect_require_shape:
        imm r20, 7151616
        imm r21, 24
        imm r22, 1
        call transfer_require_cell
        imm r20, 7159808
        imm r21, 24
        imm r22, 1
        call transfer_require_cell
        imm r20, 24
        call call_bounds_frame_bytes
        imm r1, 16
        jeq r0, r1, expect_shape_blocks
        jmp reject

expect_shape_blocks:
        imm r20, 129
        imm r21, 24
        imm r22, 0
        call exact_block_identity_pc
        imm r20, 130
        imm r21, 24
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 131
        imm r21, 24
        imm r22, 1
        call exact_block_identity_pc
        imm r20, 129
        imm r21, 131
        imm r22, 24
        call exact_require_proc_blocks

        imm r20, 97
        imm r21, 130
        imm r22, 1
        imm r23, 131
        call exact_transition_identity_pc ; checked expect match guard
        call expect_require_events
        call expect_require_locals_primitives
        call expect_require_censuses
        ret

expect_require_events:
        imm r20, 24
        imm r21, 129
        imm r22, 0
        imm r23, 0
        imm r24, 10                    ; skip_ws procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 24
        imm r21, 130
        imm r22, 0
        imm r23, 0
        imm r24, 4                     ; cbyte procedure identity
        call summary_require_call_fallthrough_identity
        imm r20, 24
        imm r21, 131
        imm r22, 0
        imm r23, 0
        imm r24, 5                     ; adv procedure identity
        call summary_require_call_fallthrough_identity

        imm r20, 24
        imm r21, 130
        call exact_require_event_epilogue
        imm r20, 24
        imm r21, 131
        call exact_require_event_epilogue
        imm r20, 25                    ; gen_load identifies synthetic return
        call exact_require_preentry_epilogue
        ret

expect_require_locals_primitives:
        imm r20, 34
        imm r21, 130
        imm r22, 1
        imm r23, 0                   ; checked expect ch slot
        call exact_local_identity_pc

        imm r20, 353
        imm r21, 130
        imm r22, 3
        imm r23, 10                  ; checked expect equality
        call exact_primitive_identity_pc
        imm r20, 354
        imm r21, 130
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 355
        imm r21, 131
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc

        imm r20, 90
        imm r21, 130
        call exact_require_binary_push_identity
        ret

expect_require_censuses:
        imm r20, 129
        imm r21, 131
        imm r22, 34
        imm r23, 35
        imm r24, 33
        imm r25, 33
        imm r26, 97
        imm r27, 98
        imm r28, 160
        imm r29, 165                 ; checked exclusive expect event row
        call exact_require_effect_census

        imm r20, 129
        imm r21, 131
        imm r22, 353
        imm r23, 356                 ; checked exclusive expect primitive row
        imm r24, 90
        imm r25, 91
        imm r26, 0
        imm r27, 0
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census

        imm r20, 24
        call exact_proc_entry_r20
        imm r21, 25
        call exact_proc_entry_r21
        imm r22, 3
        imm r23, 3
        call skip_scan_call_region
        ret
