; Compact exact-shape and relation bridge for id_char(k), needed by the fixed
; keyword family in the expression semantic checker.  The historical ILET
; proof carries a second procedure that this tranche does not consume; keeping
; only p13 here avoids spending audited tape capacity on an unrelated theorem.
; The canonical procedure inventory owns p13's total block span and partition.

expression_id_char_require_shape:
        imm r20, 13
        imm r21, 1
        imm r22, 1
        imm r23, 16
        call exact_require_proc_frame_identity

        imm r20, 47
        imm r21, 47
        imm r22, 13
        call exact_require_proc_blocks

        imm r20, 13
        imm r21, 47
        call exact_require_event_epilogue
        imm r20, 14                  ; next procedure identifies synthetic ret
        call exact_require_preentry_epilogue

        imm r20, 33
        imm r21, 47
        imm r22, 1
        imm r23, 0
        call exact_local_identity_pc
        imm r20, 21
        imm r21, 47
        imm r22, 1
        imm r23, 1
        call exact_memory_identity_pc
        mov r39, r0
        imm r20, 98
        imm r21, 47
        imm r22, 2
        imm r23, 3
        call exact_primitive_identity_pc
        mov r38, r0
        imm r20, 98
        call exact_expr_primitive_extent
        jeq r0, r38, expression_id_char_memory_start
        jmp reject
expression_id_char_memory_start:
        jeq r1, r39, expression_id_char_memory_done
        jmp reject
expression_id_char_memory_done:
        imm r20, 22
        imm r21, 47
        imm r25, 97
        imm r26, 2097120
        call exact_memory_load_pc

        imm r20, 95
        imm r21, 47
        imm r22, 1
        imm r23, 2097152
        call exact_primitive_identity_pc
        imm r20, 96
        imm r21, 47
        imm r22, 2
        imm r23, 3
        call exact_primitive_identity_pc
        imm r20, 97
        imm r21, 47
        imm r22, 1
        imm r23, 2097120
        call exact_primitive_identity_pc
        imm r20, 98
        imm r21, 47
        imm r22, 2
        imm r23, 3
        call exact_primitive_identity_pc

        imm r20, 27
        imm r21, 47
        call exact_require_binary_push_identity
        imm r20, 28
        imm r21, 47
        call exact_require_binary_push_identity

        imm r20, 47
        imm r21, 47
        imm r22, 33
        imm r23, 34
        imm r24, 21
        imm r25, 23
        imm r26, 36
        imm r27, 36
        imm r28, 37
        imm r29, 38
        call exact_require_effect_census
        imm r20, 47
        imm r21, 47
        imm r22, 95
        imm r23, 99
        imm r24, 27
        imm r25, 29
        imm r26, 0
        imm r27, 0
        imm r28, 0
        imm r29, 0
        call summary_require_expr_census
        imm r20, 13                  ; id_char procedure identity
        call exact_proc_entry_r20
        imm r21, 14                  ; is_let procedure identity / end
        call exact_proc_entry_r21
        imm r22, 0
        imm r23, 2
        call skip_scan_call_region
        ret

; Conditional on read_ident's exact source slice and 0<=k<IDLEN, bind the
; selected zero-extended byte, quiet state, and restored frame.  This is the
; IDCH interface consumed by all nine fixed keyword predicates.
expression_id_char_prove_summary:
        imm r20, 526792
        imm r21, 1396984146             ; RIDS
        call exact_require_cell
        imm r1, 527200
        imm r2, 1                       ; identifier slice premise
        store r1, r2
        imm r1, 527208
        store r1, r2                    ; 0<=k<IDLEN premise
        imm r1, 527216
        store r1, r2                    ; exact SRC[IDOFF+k] byte
        imm r1, 527224
        store r1, r2                    ; quiet compiler state
        imm r1, 527312
        store r1, r2                    ; caller frame restored
        call expression_id_char_require_relation
        imm r1, 527184
        imm r2, 1212367945              ; IDCH
        store r1, r2
        ret

expression_id_char_require_relation:
        imm r20, 527200
        imm r21, 1
        call exact_require_cell
        imm r20, 527208
        imm r21, 1
        call exact_require_cell
        imm r20, 527216
        imm r21, 1
        call exact_require_cell
        imm r20, 527224
        imm r21, 1
        call exact_require_cell
        imm r20, 527312
        imm r21, 1
        call exact_require_cell
        ret
