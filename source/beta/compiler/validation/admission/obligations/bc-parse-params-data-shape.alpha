; Exact local/memory/expression shape for parse_proc blocks 339..344.
;
; The adjacent control module owns CFG, calls, returns, and frame. This module
; rejoins four local rows, five fixed memory sites, primitive rows 779..800,
; six binary pushes, the expect argument, two store-address pushes, and the
; exhaustive expression census for the parameter/capacity slice.

parse_params_shape_init:
        call parse_params_require_control_shape
        call parse_params_require_data_shape
        jmp parse_parameter_summary_init

parse_params_require_data_shape:
        call parse_params_require_locals
        call parse_params_require_memory
        call parse_params_require_primitives
        call parse_params_require_pushes
        call parse_params_require_expr_census
        ret

parse_params_require_locals:
        imm r20, 227
        imm r21, 344
        imm r22, 2
        imm r23, 2
        call exact_local_identity_pc              ; nparams = NLOC
        imm r20, 228
        imm r21, 344
        imm r22, 2
        imm r23, 3
        call exact_local_identity_pc              ; nslots = nparams+count
        imm r20, 229
        imm r21, 344
        imm r22, 1
        imm r23, 2
        call exact_local_identity_pc              ; checked nparams payload
        imm r20, 230
        imm r21, 344
        imm r22, 1
        imm r23, 3
        call exact_local_identity_pc              ; checked nslots guard payload
        ret

parse_params_require_memory:
        imm r20, 88
        imm r21, 340
        imm r25, 781
        imm r26, 2097128             ; parameter-room NLOC
        call exact_memory_load_pc
        imm r20, 89
        imm r21, 340
        call exact_memory_store_pc    ; fifth-parameter status 252
        imm r20, 90
        imm r21, 341
        imm r25, 787
        imm r26, 2097072             ; declare status test
        call exact_memory_load_pc
        imm r20, 91
        imm r21, 344
        imm r25, 793
        imm r26, 2097128             ; nparams NLOC snapshot
        call exact_memory_load_pc
        imm r20, 92
        imm r21, 344
        call exact_memory_store_pc    ; slot-capacity status 252
        ret

parse_params_require_primitives:
        ; Stable row/block/kind/value-or-opcode identities.
        imm r20, 779
        imm r21, 339
        imm r22, 3
        imm r23, 11                  ; cbyte != ')'
        call exact_primitive_identity_pc
        imm r20, 780
        imm r21, 339
        imm r22, 1
        imm r23, 41                  ; checked close parenthesis
        call exact_primitive_identity_pc
        imm r20, 781
        imm r21, 340
        imm r22, 1
        imm r23, 2097128             ; NLOC
        call exact_primitive_identity_pc
        imm r20, 782
        imm r21, 340
        imm r22, 3
        imm r23, 8                   ; signed NLOC<4
        call exact_primitive_identity_pc
        imm r20, 783
        imm r21, 340
        imm r22, 1
        imm r23, 4                   ; checked parameter limit
        call exact_primitive_identity_pc
        imm r20, 784
        imm r21, 340
        imm r22, 1
        imm r23, 2097072             ; RESOURCE_FAIL
        call exact_primitive_identity_pc
        imm r20, 785
        imm r21, 340
        imm r22, 1
        imm r23, 252                 ; checked fifth-parameter status
        call exact_primitive_identity_pc
        imm r20, 786
        imm r21, 340
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc

        imm r20, 787
        imm r21, 341
        imm r22, 1
        imm r23, 2097072
        call exact_primitive_identity_pc
        imm r20, 788
        imm r21, 341
        imm r22, 3
        imm r23, 11                  ; status != 0
        call exact_primitive_identity_pc
        imm r20, 789
        imm r21, 341
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        imm r20, 790
        imm r21, 341
        imm r22, 3
        imm r23, 10                  ; cbyte == ','
        call exact_primitive_identity_pc
        imm r20, 791
        imm r21, 341
        imm r22, 1
        imm r23, 44                  ; checked comma byte
        call exact_primitive_identity_pc
        imm r20, 792
        imm r21, 342
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc

        imm r20, 793
        imm r21, 344
        imm r22, 1
        imm r23, 2097128
        call exact_primitive_identity_pc
        imm r20, 794
        imm r21, 344
        imm r22, 1
        imm r23, 123                 ; checked expect-open argument
        call exact_primitive_identity_pc
        imm r20, 795
        imm r21, 344
        imm r22, 2
        imm r23, 3                   ; nparams + count_lets
        call exact_primitive_identity_pc
        imm r20, 796
        imm r21, 344
        imm r22, 3
        imm r23, 12                  ; nslots <= 1024
        call exact_primitive_identity_pc
        imm r20, 797
        imm r21, 344
        imm r22, 1
        imm r23, 1024                ; checked total slot limit
        call exact_primitive_identity_pc
        imm r20, 798
        imm r21, 344
        imm r22, 1
        imm r23, 2097072
        call exact_primitive_identity_pc
        imm r20, 799
        imm r21, 344
        imm r22, 1
        imm r23, 252                 ; checked slot-capacity status
        call exact_primitive_identity_pc
        imm r20, 800
        imm r21, 344
        imm r22, 1
        imm r23, 0
        call exact_primitive_identity_pc
        ret

parse_params_require_pushes:
        imm r20, 224
        imm r21, 339
        call exact_require_binary_push_identity
        imm r20, 225
        imm r21, 340
        call exact_require_binary_push_identity
        imm r20, 226
        imm r21, 341
        call exact_require_binary_push_identity
        imm r20, 227
        imm r21, 341
        call exact_require_binary_push_identity
        imm r20, 228
        imm r21, 344
        call exact_require_binary_push_identity              ; nparams held across count_lets call
        imm r20, 229
        imm r21, 344
        call exact_require_binary_push_identity
        imm r20, 366
        imm r21, 344
        call exact_require_argument_push_identity              ; checked '{' argument push
        imm r20, 403
        imm r21, 340
        call exact_require_store_push_identity
        imm r20, 404
        imm r21, 344
        call exact_require_store_push_identity
        ret

parse_params_require_expr_census:
        imm r20, 339
        imm r21, 344
        imm r22, 779
        imm r23, 801                 ; checked exclusive params primitive row
        imm r24, 224
        imm r25, 230
        imm r26, 366
        imm r27, 367
        imm r28, 403
        imm r29, 405
        call summary_require_expr_census
        ret
