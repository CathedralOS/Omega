; Final publication of the conditional statement-family theorem.  SPUB means:
; if the fifteen external propositions recorded by SANT all hold over this
; exact canonical bundle, then SREL names the complete p26/p46/p62..p67 finite
; helper and maximal guarded Return-or-Diverge relation published below.  No external
; process-local theorem cell is copied or treated as established here.

statement_family_publication_init:
        imm r20, 546100
        imm r21, 1481787731             ; SIRX identical-bundle root
        call exact_require_cell
        imm r20, 546156
        imm r21, 1414414675             ; SANT antecedent schema
        call exact_require_cell
        imm r20, 546240
        imm r21, 15                     ; exact external antecedent count
        call exact_require_cell
        imm r20, 546164
        imm r21, 1229997395             ; SEPI p46 (local conditional rule)
        call exact_require_cell
        imm r20, 546172
        imm r21, 1381258067             ; SSTR p26
        call exact_require_cell
        imm r20, 546180
        imm r21, 1112298323             ; SSLB p64
        call exact_require_cell
        imm r20, 546188
        imm r21, 1330922579             ; SDTO p66
        call exact_require_cell
        imm r20, 546196
        imm r21, 1380078675             ; STBR p67 finite branches
        call exact_require_cell
        imm r20, 546204
        imm r21, 1347573587             ; SWRP p63/p65 wrappers
        call exact_require_cell
        imm r20, 546212
        imm r21, 1346783059             ; SGFP p62..p67 greatest FP
        call exact_require_cell
        imm r20, 552120
        imm r21, 1                      ; D0/root completion
        call exact_require_cell
        imm r20, 560312
        imm r21, 1                      ; D64/base completion
        call exact_require_cell
        imm r20, 560360
        imm r21, 1                      ; maximal trace, no truncation
        call exact_require_cell
        imm r20, 560368
        imm r21, 1                      ; no cursor productivity assumption
        call exact_require_cell
        imm r20, 560376
        imm r21, 1                      ; no stdout productivity assumption
        call exact_require_cell
        imm r1, 546228
        imm r2, 1279611475             ; SREL full p26/p46/p62..p67 consequent
        store r1, r2
        imm r20, 546228
        imm r21, 1279611475
        call exact_require_cell
        imm r1, 546220
        imm r2, 1112887379             ; SPUB conditional statement theorem
        store r1, r2
        imm r20, 546220
        imm r21, 1112887379
        call exact_require_cell
        jmp scan_owned_effects_init
