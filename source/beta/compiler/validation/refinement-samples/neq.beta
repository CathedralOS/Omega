; !=-GUARDED LOOP: over ℕ with a unit-stride counter, (i != n) IS (i < n) — from 0 stepping +1 the counter
; hits n exactly (never skips), so trip = n and total = n*a. Both engines normalize != to < before
; recognition; a stride that could skip the bound (i += 2, machine diverges when n is odd) is refused by the
; unit-stride requirement, which is what makes the normalization sound.
proc main() {
    let n = read_byte()
    let a = read_byte()
    let total = 0
    let i = 0
    state loop { to body when (i != n)  to done }
    state body { total = (total + a)  i = (i + 1)  to loop }
    state done { return total }
}
