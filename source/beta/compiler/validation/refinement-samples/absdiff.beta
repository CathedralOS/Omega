; BRANCH ON DATA (the conditional-terms slice opens): |a - b| via an if-diamond. Both engines FORK at the
; symbolic guard — each path runs to completion on copied state, no join detection — and the meaning is the
; conditional term (k 9 (k 10 a b) (k 5 b a) (k 5 a b)): if a<b then b-a else a-b, ℤ pairs in both arms.
; Booleans compare over ℤ, sound because the machine compares the 2^64-wrapped value SIGNED (agrees with ℤ
; for |x| < 2^63). Kernel: arity-3 constructor (data 9 3 0 0), certs by refl, three-checker diamond.
proc main() {
    let a = read_byte()
    let b = read_byte()
    let r = 0
    state s0 { to lo when (a < b)  to hi }
    state lo { r = (b - a)  to done }
    state hi { r = (a - b)  to done }
    state done { return r }
}
