; BUFFER COPY LOOP (the conditional-terms mountain's final slice): read n bytes into byte[6000..6000+n),
; then use elements. The fill summarizes to a SEGMENT (base, trip, rdbase) — byte[base+j] = input[rdbase+j]
; for j < trip — and a post-loop read at a concrete offset becomes the conditional term
; (k 9 (k 10 j n) (v rdbase+j) z): in-range reads the copied stream element, out-of-range the prior memory.
; This is what conditional terms were the prerequisite for: the segment bound j < trip is UNDECIDABLE
; symbolically, so the meaning carries the decision as a term instead of needing to make it.
proc main() {
    let n = read_byte()
    let a = read_byte()
    let i = 0
    state loop { to body when (i < n)  to done }
    state body { byte[(6000 + i)] = read_byte()  i = (i + 1)  to loop }
    state done { return ((byte[6000] * a) + byte[6001]) }
}
