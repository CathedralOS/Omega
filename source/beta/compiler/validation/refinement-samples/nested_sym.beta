; NESTED LOOP, SYMBOLIC inner bound: the inner loop (j < m) is summarized RECURSIVELY during the outer body's
; single placeholder run — its closed form, expressed over the outer run's slot markers, becomes the outer
; per-iteration delta m*a. Closed form n*(m*a). The recursion is the same summarizer at depth+1; markers of
; outer-invariant slots pass through the inner decompose as opaque constants and resolve at the outer level.
proc main() {
    let n = read_byte()
    let m = read_byte()
    let a = read_byte()
    let total = 0
    let i = 0
    state outer { to obody when (i < n)  to done }
    state obody { let j = 0  to inner }
    state inner { to ibody when (j < m)  to onext }
    state ibody { total = (total + a)  j = (j + 1)  to inner }
    state onext { i = (i + 1)  to outer }
    state done { return total }
}
