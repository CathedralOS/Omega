// Read one sealed OCREQ V1 request and publish its OCOUT frame and exit tag.
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
use {compiler_request}/request.omg;
use {compiler_request}/outcome.omg;
use {compiler_request}/protocol.omg;

machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap blocks {
    let mutable request: |request|::Request;
    |request|::clear(@mutable request);
    transition { _ -> block read(@mutable request) }

    machine read(request: @mutable |request|::Request) {
        let input: |console|::ByteRead = block |console|::Console::read_byte();
        transition input {
            |console|::ByteRead::Error -> |process_exit|::ProcessExit::exit_process(74),
            |console|::ByteRead::Byte { value } -> block stage(request, value),
            |console|::ByteRead::Eof -> publish(request)
        }
    }

    machine stage(request: @mutable |request|::Request, value: i32)
    requires value >= 0 && value <= 255
    {
        |request|::request_stage(request, value as u8);
        transition { _ -> block read(request) }
    }

    machine publish(request: @|request|::Request) {
        let outcome: |outcome|::Outcome = |protocol|::compile_request(request);
        write_frame(outcome);
        let tag: u8 = |outcome|::outcome_tag_value(outcome.tag);
        |process_exit|::ProcessExit::exit_process(tag as i32);
    }
}

machine write_frame(outcome: |outcome|::Outcome) reaches |process_authority|::StandardOutput crashes Trap {
    transition { _ -> next(outcome, 0 as +Trapping) }

    machine next(outcome: |outcome|::Outcome, index: u64 in Trapping) {
        let length: u64 in Trapping = |outcome|::frame_length(outcome);
        transition index < length {
            true -> write(outcome, index),
            _ -> done()
        }
    }

    machine write(outcome: |outcome|::Outcome, index: u64 in Trapping) {
        let value: u8 = |outcome|::frame_byte(outcome, index);
        |console|::Console::write_byte(value as i32);
        transition { _ -> next(outcome, index + 1) }
    }

    machine done() {}
}
