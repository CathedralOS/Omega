// The invocation supplies one exact target; these are root bindings rather
// than a source-declared support set.

machine build(builder: @mut Build) {
    Build::application(builder, "omega_compiler_request");
    Build::select_provider::<omega_language_std::Console, omega_language_std::LinuxArm64Console>(builder, linux_arm64);
    Build::select_provider::<omega_language_std::Console, omega_language_std::LinuxX86Console>(builder, linux_x86_64);
    Build::select_provider::<omega_language_std::Console, omega_language_std::DarwinArm64Console>(builder, macos_arm64);
    Build::select_provider::<omega_language_std::Console, omega_language_std::DarwinX86Console>(builder, macos_x86_64);
    Build::select_provider::<omega_language_std::Console, omega_language_std::WindowsConsole>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, alpha_bootstrap::ProgramEntry, entry_start);
    let request_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../subsystems/compiler/request"
    }));
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../../library/std"
    }));
}
