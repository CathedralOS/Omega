// input_reader.py runs this Build from a temporary project under the repository build directory.
use {omega}/build/dependency.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use main.omg as program;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "construction_input" };
    Build::bind(builder, macos_arm64::ProgramEntry, |program|::start);
    Build::bind(builder, linux_arm64::ProgramEntry, |program|::start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |program|::start);
    Build::bind(builder, windows_x86_64::ProgramEntry, |program|::start);
    let streams: [BoundaryServiceReference; 3] = [
        Build::service::<|process_authority|::StandardInput>(builder),
        Build::service::<|process_authority|::StandardOutput>(builder),
        Build::service::<|process_exit|::ProcessExit>(builder)
    ];
    let system: DependencyDescription = |dependency|::from_source(Source::Path { location: "../../source/library/system" });
    _ = |dependency|::add(builder, system, @streams[..]);
    let wire: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path {
        location: "../../source/foundation/wire"
    }));
}
