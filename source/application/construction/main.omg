use input.omg as input_packet;
use input_reader.omg;
use build_sources.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {omega_compiler}/compiler.omg as driver;
use {system}/console.omg;
use {psi}/pipeline/source_files_to_tokens/lexer.omg;
use {psi}/representations/source_files/source.omg as source_files;

// Metadata access never substitutes zero for an invalid coordinate. A bad
// row, span, package index or role terminates before any tape is published.
machine copy_name(input: @|input_packet|::ConstructionInput, name: @mutable |source_files|::ModulePath, start: u32, end: u32)
reaches |process_exit|::ProcessExit crashes Trap
{
    |source_files|::module_path_clear(name);
    transition start <= end && end <= input.buffer_length && end - start <= 256 {
        true -> next(input, name, start as u64, end as u64),
        _ -> |input_packet|::malformed()
    }
    machine next(input: @|input_packet|::ConstructionInput, name: @mutable |source_files|::ModulePath, index: u64, end: u64) {
        transition index < end && index < 8388608 {
            true -> append(input, name, index, end),
            _ -> done()
        }
    }
    machine append(input: @|input_packet|::ConstructionInput, name: @mutable |source_files|::ModulePath, index: u64, end: u64)
    requires index < 8388608
    {
        let retained: bool = |source_files|::module_path_append(name, input.bytes[index]);
        transition retained {
            true -> next(input, name, index + 1, end),
            _ -> |input_packet|::malformed()
        }
    }
    machine done() {}
}

machine add_packages(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation)
reaches |process_exit|::ProcessExit crashes Trap
{
    transition { _ -> next(input, compilation, 0) }
    machine next(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, index: u64) {
        transition input.package_count <= 64 && index < input.package_count as u64 {
            true -> package(input, compilation, index),
            _ -> done()
        }
    }
    machine package(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, index: u64)
    requires index < 64
    {
        let start: u32 = |input_packet|::row_word(input, index * 3);
        let end: u32 = |input_packet|::row_word(input, index * 3 + 1);
        let role: u32 = |input_packet|::row_word(input, index * 3 + 2);
        transition role <= 2 {
            true -> retain(input, compilation, index, start, end, role),
            _ -> |input_packet|::malformed()
        }
    }
    machine retain(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, index: u64, start: u32, end: u32, role: u32)
    requires index < 64
    {
        let mutable name: |source_files|::ModulePath;
        copy_name(input, @mutable name, start, end);
        let retained: bool = |source_files|::add_package(@mutable compilation.sources, @name, role == 1);
        transition retained {
            true -> next(input, compilation, index + 1),
            _ -> full()
        }
    }
    machine full() { |process_exit|::ProcessExit::exit_process(252); }
    machine done() {}
}

machine add_edges(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation)
reaches |process_exit|::ProcessExit crashes Trap
{
    transition { _ -> next(input, compilation, 0) }
    machine next(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, index: u64) {
        transition input.package_count <= 64 && input.edge_count <= 256 && index < input.edge_count as u64 {
            true -> edge(input, compilation, index, input.package_count as u64 * 3 + index * 4),
            _ -> done()
        }
    }
    machine edge(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, index: u64, row: u64)
    requires index < 256, row <= 3772
    {
        let requester: u32 = |input_packet|::row_word(input, row);
        let target: u32 = |input_packet|::row_word(input, row + 1);
        let start: u32 = |input_packet|::row_word(input, row + 2);
        let end: u32 = |input_packet|::row_word(input, row + 3);
        transition requester < input.package_count && target < input.package_count {
            true -> retain(input, compilation, index, requester, target, start, end),
            _ -> |input_packet|::malformed()
        }
    }
    machine retain(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, index: u64, requester: u32, target: u32, start: u32, end: u32)
    requires index < 256
    {
        let mutable alias: |source_files|::ModulePath;
        copy_name(input, @mutable alias, start, end);
        let retained: bool = |source_files|::add_dependency(@mutable compilation.sources,
            (requester as u64) as +Trapping, |source_files|::DependencyScope::Product,
            @alias, (target as u64) as +Trapping);
        transition retained {
            true -> next(input, compilation, index + 1),
            _ -> full()
        }
    }
    machine full() { |process_exit|::ProcessExit::exit_process(252); }
    machine done() {}
}

// Directory custody follows the source-rust source-files reader. Directory
// components must be ASCII identifiers and cannot shadow the receiver or a
// builtin type. A basename only identifies a file.
machine identifier_letter(byte: u8) -> bool {
    let uppercase: bool = byte >= 65 && byte <= 90;   // A through Z
    let lowercase: bool = byte >= 97 && byte <= 122;  // a through z
    uppercase || lowercase || byte == 95              // underscore
}

machine directory_name(name: @[u8]) -> bool crashes Trap {
    transition name.length > 0 {
        true -> first(name),
        _ -> no()
    }
    machine first(name: @[u8]) -> bool
    requires name.length > 0
    {
        let byte: u8 = name[0];
        let letter: bool = identifier_letter(byte);
        let integer_prefix: bool = byte == 105 || byte == 117;  // i or u
        transition letter {
            true -> next(name, 1, integer_prefix),
            _ -> no()
        }
    }
    machine next(name: @[u8], index: u64, integer_family: bool) -> bool {
        transition index < name.length {
            true -> character(name, index, integer_family),
            _ -> spelling(name, integer_family)
        }
    }
    machine character(name: @[u8], index: u64, integer_family: bool) -> bool
    requires index < name.length
    {
        let byte: u8 = name[index];
        let digit: bool = byte >= 48 && byte <= 57;  // 0 through 9
        let letter: bool = identifier_letter(byte);
        transition digit || letter {
            true -> next(name, index + 1, integer_family && digit),
            _ -> no()
        }
    }
    machine spelling(name: @[u8], integer_family: bool) -> bool {
        !integer_family && name != "self" && name != "bool" && name != "addr"
            && name != "f32" && name != "f64" && name != "Slice"
            && name != "SyscallResult" && name != "Terminal" && name != "UInt"
            && name != "Int" && name != "AtomicBool" && name != "AtomicU32"
            && name != "AtomicU64"
    }
    machine no() -> bool { false }
}

machine package_namespace(path: @[u8], name: @mutable |source_files|::ModulePath)
reaches |process_exit|::ProcessExit crashes Trap
{
    |source_files|::module_path_clear(name);
    transition { _ -> scan(path, name, 0, 0) }
    machine scan(path: @[u8], name: @mutable |source_files|::ModulePath, start: u64, index: u64)
    requires start <= index, index <= path.length
    {
        transition index < path.length {
            true -> byte(path, name, start, index),
            _ -> basename(@path[start..index])
        }
    }
    machine byte(path: @[u8], name: @mutable |source_files|::ModulePath, start: u64, index: u64)
    requires start <= index, index < path.length
    {
        let value: u8 = path[index];
        transition value {
            0 -> |input_packet|::malformed(),  // NUL
            92 -> |input_packet|::malformed(), // Backslash is outside the POSIX wire spelling.
            47 -> directory(path, name, start, index), // Forward slash ends a directory.
            _ -> scan(path, name, start, index + 1)
        }
    }
    machine directory(path: @[u8], name: @mutable |source_files|::ModulePath, start: u64, end: u64)
    requires start <= end, end < path.length
    {
        let accepted: bool = directory_name(@path[start..end]);
        transition accepted && end <= 256 {
            true -> separator(path, name, start, end),
            _ -> |input_packet|::malformed()
        }
    }
    machine separator(path: @[u8], name: @mutable |source_files|::ModulePath, start: u64, end: u64)
    requires start <= end, end < path.length
    {
        transition start > 0 {
            true -> append_separator(path, name, start, end),
            _ -> copy(path, name, start, end)
        }
    }
    machine append_separator(path: @[u8], name: @mutable |source_files|::ModulePath, start: u64, end: u64)
    requires start <= end, end < path.length
    {
        // ModulePath joins components with a backslash.
        let retained: bool = |source_files|::module_path_append(name, 92);
        transition retained {
            true -> copy(path, name, start, end),
            _ -> |input_packet|::malformed()
        }
    }
    machine copy(path: @[u8], name: @mutable |source_files|::ModulePath, index: u64, end: u64)
    requires index <= end, end < path.length
    {
        transition index < end {
            true -> append(path, name, index, end),
            _ -> scan(path, name, end + 1, end + 1)
        }
    }
    machine append(path: @[u8], name: @mutable |source_files|::ModulePath, index: u64, end: u64)
    requires index < end, end < path.length
    {
        let retained: bool = |source_files|::module_path_append(name, path[index]);
        transition retained {
            true -> copy(path, name, index + 1, end),
            _ -> |input_packet|::malformed()
        }
    }
    machine basename(name: @[u8]) {
        transition name.length > 0 && name != "." && name != ".." {
            true -> done(),
            _ -> |input_packet|::malformed()
        }
    }
    machine done() {}
}

machine unit_namespace(input: @|input_packet|::ConstructionInput, row: u64, name: @mutable |source_files|::ModulePath)
requires row <= 3771
reaches |process_exit|::ProcessExit crashes Trap
{
    transition input.unit_row_words {
        5 -> path(input, row, name),
        _ -> root(name)
    }
    machine path(input: @|input_packet|::ConstructionInput, row: u64, name: @mutable |source_files|::ModulePath)
    requires row <= 3771
    {
        let start: u32 = |input_packet|::row_word(input, row + 3);
        let end: u32 = |input_packet|::row_word(input, row + 4);
        transition start < end && end <= input.buffer_length && end <= 8388608 {
            true -> namespace(input, name, start as u64, end as u64),
            _ -> |input_packet|::malformed()
        }
    }
    machine namespace(input: @|input_packet|::ConstructionInput, name: @mutable |source_files|::ModulePath, start: u64, end: u64)
    requires start < end, end <= 8388608
    { package_namespace(@input.bytes[start..end], name); }
    machine root(name: @mutable |source_files|::ModulePath) { |source_files|::module_path_clear(name); }
}

machine load_unit_source(input: @|input_packet|::ConstructionInput, lexer: @mutable |lexer|::Lexer, unit: u32, start: u32, end: u32)
requires start <= end, end <= 8388608
crashes Trap
{
    |lexer|::lexer_initialize(lexer, unit as +Trapping);
    transition { _ -> bytes(input, lexer, start as u64, end as u64) }
    machine bytes(input: @|input_packet|::ConstructionInput, lexer: @mutable |lexer|::Lexer, offset: u64, end: u64)
    requires end <= 8388608
    {
        transition offset < end {
            true -> byte(input, lexer, offset, end),
            _ -> done()
        }
    }
    machine byte(input: @|input_packet|::ConstructionInput, lexer: @mutable |lexer|::Lexer, offset: u64, end: u64)
    requires offset < end, end <= 8388608
    {
        |lexer|::append_source_byte(lexer, input.bytes[offset]);
        transition { _ -> bytes(input, lexer, offset + 1, end) }
    }
    machine done() {}
}

machine add_units(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, lexer: @mutable |lexer|::Lexer)
reaches |process_exit|::ProcessExit crashes Trap
{
    transition { _ -> next(input, compilation, lexer, 0) }
    machine next(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, lexer: @mutable |lexer|::Lexer, index: u64) {
        transition compilation.status {
            |driver|::CompilationStatus::Collecting -> remaining(input, compilation, lexer, index),
            _ -> done()
        }
    }
    machine remaining(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, lexer: @mutable |lexer|::Lexer, index: u64) {
        transition input.package_count <= 64 && input.edge_count <= 256
            && input.unit_count <= 512 && index < input.unit_count as u64 && input.unit_row_words <= 5 {
            true -> unit(input, compilation, lexer, index,
                input.package_count as u64 * 3 + input.edge_count as u64 * 4 + index * input.unit_row_words as u64),
            _ -> done()
        }
    }
    machine unit(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, lexer: @mutable |lexer|::Lexer, index: u64, row: u64)
    requires index < 512, row <= 3771
    {
        let package: u32 = |input_packet|::row_word(input, row);
        let start: u32 = |input_packet|::row_word(input, row + 1);
        let end: u32 = |input_packet|::row_word(input, row + 2);
        transition package < input.package_count && start <= end && end <= input.buffer_length && end <= 8388608 {
            true -> size(input, compilation, lexer, index, row, package, start, end),
            _ -> |input_packet|::malformed()
        }
    }
    machine size(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, lexer: @mutable |lexer|::Lexer, index: u64, row: u64, package: u32, start: u32, end: u32)
    requires index < 512, row <= 3771, start <= end, end <= 8388608
    {
        transition end - start <= 131072 {
            true -> retain(input, compilation, lexer, index, row, package, start, end),
            _ -> full()
        }
    }
    machine retain(input: @|input_packet|::ConstructionInput, compilation: @mutable |driver|::Compilation, lexer: @mutable |lexer|::Lexer, index: u64, row: u64, package: u32, start: u32, end: u32)
    requires index < 512, row <= 3771, start <= end, end <= 8388608
    {
        let mutable module_path: |source_files|::ModulePath;
        unit_namespace(input, row, @mutable module_path);
        load_unit_source(input, lexer, index as u32, start, end);
        |driver|::compilation_add_unit(compilation, lexer, (package as u64) as +Trapping, @module_path);
        transition { _ -> next(input, compilation, lexer, index + 1) }
    }
    machine full() { |process_exit|::ProcessExit::exit_process(252); }
    machine done() {}
}

machine exit_status(status: |driver|::CompilationStatus) -> i32 {
    transition status {
        |driver|::CompilationStatus::Complete -> code(0),
        |driver|::CompilationStatus::Capacity -> code(252),
        |driver|::CompilationStatus::Lexical -> code(251),
        |driver|::CompilationStatus::Parsing -> code(250),
        |driver|::CompilationStatus::Resolution -> code(248),
        |driver|::CompilationStatus::Typing -> code(249),
        |driver|::CompilationStatus::Checking -> code(247),
        _ -> code(246)
    }
    machine code(value: i32) -> i32 { value }
}

machine publish(compilation: @|driver|::Compilation) reaches |process_exit|::ProcessExit + |process_authority|::StandardOutput crashes Trap {
    let status: i32 = exit_status(compilation.status);
    transition status == 0 {
        true -> bounded(compilation),
        _ -> refused(status)
    }
    machine bounded(compilation: @|driver|::Compilation) {
        transition compilation.output.length <= 2097152 {
            true -> next(compilation, 0),
            _ -> refused(252)
        }
    }
    machine next(compilation: @|driver|::Compilation, index: u64) {
        transition index < compilation.output.length && index < 2097152 {
            true -> byte(compilation, index),
            _ -> complete()
        }
    }
    machine byte(compilation: @|driver|::Compilation, index: u64)
    requires index < 2097152
    {
        |console|::Console::write_byte(compilation.output.bytes[index] as i32);
        transition { _ -> next(compilation, index + 1) }
    }
    machine complete() { |process_exit|::ProcessExit::exit_process(0); }
    machine refused(status: i32) { |process_exit|::ProcessExit::exit_process(status); }
}

machine entry_start() reaches |process_exit|::ProcessExit + |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap blocks {
    let mutable input: |input_packet|::ConstructionInput;
    block |input_reader|::read_input(@mutable input);
    |build_sources|::check_build_input(@input);
    let mutable compilation: |driver|::Compilation;
    |driver|::compilation_clear(@mutable compilation);
    add_packages(@input, @mutable compilation);
    add_edges(@input, @mutable compilation);
    let mutable lexer: |lexer|::Lexer;
    add_units(@input, @mutable compilation, @mutable lexer);
    let mutable entry_name: |source_files|::ModulePath;
    copy_name(@input, @mutable entry_name, input.entry_name_start, input.entry_name_end);
    |driver|::compilation_finish(@mutable compilation, input.entry_unit,
        @entry_name.bytes[0..entry_name.length]);
    publish(@compilation);
}
