use {omega}/build/dependency.omg;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use main.omg as construction;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "omega_compiler_construction" };
    Build::bind(builder, linux_x86_64::ProgramEntry, |construction|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |construction|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |construction|::entry_start);
    Build::bind(builder, windows_x86_64::ProgramEntry, |construction|::entry_start);
    Build::bind(builder, alpha_bootstrap::ProgramEntry, |construction|::entry_start);
    let compiler: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path {
        location: "../../subsystems/compiler/driver"
    }));
    let psi: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path {
        location: "../../subsystems/compiler/source_to_psi"
    }));
    let wire: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path {
        location: "../../foundation/wire"
    }));
    let streams: [BoundaryServiceReference; 3] = [
        Build::service::<|process_authority|::StandardInput>(builder),
        Build::service::<|process_authority|::StandardOutput>(builder),
        Build::service::<|process_exit|::ProcessExit>(builder)
    ];
    let system: DependencyDescription = |dependency|::from_source(Source::Path { location: "../../library/system" });
    _ = |dependency|::add(builder, system, @streams[..]);
}
