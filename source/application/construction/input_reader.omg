use input.omg as input_packet;
use {omega}/language/core/process_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/console.omg;
use {wire}/codec.omg;

machine read_byte() -> u8 reaches |process_exit|::ProcessExit + |process_authority|::StandardInput crashes Trap blocks {
    let input: |console|::ByteRead = block |console|::Console::read_byte();
    transition input {
        |console|::ByteRead::Byte { value } -> byte(value),
        _ -> truncated()
    }
    machine byte(value: i32) -> u8
    requires value >= 0 && value <= 255
    { value as u8 }
    machine truncated() -> u8 {
        |process_exit|::ProcessExit::exit_process(253);
    }
}

machine read_word() -> u32 reaches |process_exit|::ProcessExit + |process_authority|::StandardInput crashes Trap blocks {
    let b0: u8 = block read_byte();
    let b1: u8 = block read_byte();
    let b2: u8 = block read_byte();
    let b3: u8 = block read_byte();
    |codec|::u32_from_le_bytes(b0, b1, b2, b3)
}

machine read_input(input: @mutable |input_packet|::ConstructionInput)
reaches |process_exit|::ProcessExit + |process_authority|::StandardInput crashes Trap blocks
{
    input.has_build_sources = false;
    input.build_unit_count = 0;
    let first: u32 = block read_word();
    transition first {
        0 -> block version(input),
        _ -> block header(input, first, 3)
    }
    machine version(input: @mutable |input_packet|::ConstructionInput) {
        let version_word: u32 = block read_word();
        transition version_word {
            1 -> block version_one(input),
            2 -> block version_two(input),
            _ -> |input_packet|::malformed()
        }
    }
    machine version_one(input: @mutable |input_packet|::ConstructionInput) {
        let packages_word: u32 = block read_word();
        transition { _ -> block header(input, packages_word, 5) }
    }
    machine version_two(input: @mutable |input_packet|::ConstructionInput) {
        input.has_build_sources = true;
        transition { _ -> block version_one(input) }
    }
    machine header(input: @mutable |input_packet|::ConstructionInput, packages_word: u32, unit_words: u32)
    requires unit_words <= 5
    {
        input.package_count = packages_word;
        input.unit_row_words = unit_words;
        input.edge_count = block read_word();
        input.unit_count = block read_word();
        input.entry_unit = block read_word();
        input.entry_name_start = block read_word();
        input.entry_name_end = block read_word();
        input.buffer_length = block read_word();
        transition input.has_build_sources {
            true -> block build_count(input, unit_words),
            _ -> block layout(input, unit_words, 0)
        }
    }
    machine build_count(input: @mutable |input_packet|::ConstructionInput, unit_words: u32)
    requires unit_words <= 5
    {
        input.build_unit_count = block read_word();
        transition input.package_count <= 64 && input.build_unit_count > 0 && input.build_unit_count <= 512 {
            true -> block build_layout(input, unit_words),
            _ -> |input_packet|::malformed()
        }
    }
    machine build_layout(input: @mutable |input_packet|::ConstructionInput, unit_words: u32)
    requires unit_words <= 5, input.package_count <= 64, input.build_unit_count <= 512
    {
        let extra: u64 = input.package_count as u64 * 2 + input.build_unit_count as u64 * 5;
        transition { _ -> block layout(input, unit_words, extra) }
    }
    machine layout(input: @mutable |input_packet|::ConstructionInput, unit_words: u32, extra: u64)
    requires unit_words <= 5, extra <= 2688
    {
        let packages: u64 = input.package_count as u64;
        let edges: u64 = input.edge_count as u64;
        let units: u64 = input.unit_count as u64;
        let row_count: u64 = packages * 3 + edges * 4 + units * (unit_words as u64) + extra;
        transition input.package_count > 0 && input.package_count <= 64
            && input.edge_count <= 256
            && row_count <= 6464
            && input.unit_count > 0 && input.unit_count <= 512
            && input.entry_unit < input.unit_count
            && input.buffer_length <= 8388608
            && input.entry_name_start < input.entry_name_end
            && input.entry_name_end <= input.buffer_length
            && input.entry_name_end - input.entry_name_start <= 256 {
            true -> block rows(input, 0, row_count),
            _ -> |input_packet|::malformed()
        }
    }
    machine rows(input: @mutable |input_packet|::ConstructionInput, index: u64, count: u64) {
        transition index < count && index < 6464 {
            true -> block row(input, index, count),
            _ -> block bytes(input, 0)
        }
    }
    machine row(input: @mutable |input_packet|::ConstructionInput, index: u64, count: u64)
    requires index < 6464
    {
        input.rows[index] = block read_word();
        transition { _ -> block rows(input, index + 1, count) }
    }
    machine bytes(input: @mutable |input_packet|::ConstructionInput, index: u64) {
        transition index < input.buffer_length as u64 && index < 8388608 {
            true -> block byte(input, index),
            _ -> block end()
        }
    }
    machine byte(input: @mutable |input_packet|::ConstructionInput, index: u64)
    requires index < 8388608
    {
        input.bytes[index] = block read_byte();
        transition { _ -> block bytes(input, index + 1) }
    }
    machine end() {
        let trailing: |console|::ByteRead = block |console|::Console::read_byte();
        transition trailing {
            |console|::ByteRead::Eof -> done(),
            _ -> |input_packet|::malformed()
        }
    }
    machine done() {}
}
