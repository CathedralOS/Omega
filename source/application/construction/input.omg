use {omega}/language/core/process_exit.omg;

// The construction stream supplies package, dependency and source rows.
// Each source row carries its package-relative filename in the byte arena.
data ConstructionInput {
    package_count: u32;
    edge_count: u32;
    unit_count: u32;
    entry_unit: u32;
    entry_name_start: u32;
    entry_name_end: u32;
    buffer_length: u32;
    has_build_sources: bool;
    build_unit_count: u32;
    // Three Product tables (3776), up to 64 two-word Build entry selections,
    // and up to 512 five-word Build source rows.
    rows: [u32; 6464];
    bytes: [u8; 8388608];
}

machine malformed() reaches |process_exit|::ProcessExit crashes none {
    |process_exit|::ProcessExit::exit_process(253);
}

machine row_word(input: @ConstructionInput, index: u64) -> u32
reaches |process_exit|::ProcessExit crashes Trap
{
    transition index < 6464 {
        true -> word(input, index),
        _ -> invalid()
    }
    machine word(input: @ConstructionInput, index: u64) -> u32
    requires index < 6464
    { input.rows[index] }
    machine invalid() -> u32 {
        |process_exit|::ProcessExit::exit_process(253);
    }
}
