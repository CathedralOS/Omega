; memory-safety VC for slice/subarray indexing: (a+len <= N) -> (i < len) -> (a+i < N)
; element i of subslice [a, a+len) of a length-N array stays in the parent's bounds (a<b encoded as exists q. a+Sq=b). Composes lt-add-left (i<len -> a+i<a+len) with lt-le-trans (a+i<a+len<=N -> a+i<N).
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 2 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 3 (all x1 (all x2 (all x3 (-> (ex x4 (= (+ x1 (s x4)) x2)) (ex x5 (= (+ (+ x3 x1) (s x5)) (+ x3 x2))))))) (gen x6 (gen x7 (gen x8 (lam h9 (ex x10 (= (+ x6 (s x10)) x7)) (unpack h9 (gen x11 (lam h12 (= (+ x6 (s x11)) x7) (wit x13 (= (+ (+ x8 x6) (s x13)) (+ x8 x7)) x11 (app (app (inst (inst (inst (use 1) (+ (+ x8 x6) (s x11))) (+ x8 (+ x6 (s x11)))) (+ x8 x7)) (inst (inst (inst (use 2) x6) (s x11)) x8)) (eqelim x14 (= (+ x8 (+ x6 (s x11))) (+ x8 x14)) h12 (refl (+ x8 (+ x6 (s x11)))))))))))))))
(def 4 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 5 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 6 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 7 (all x1 (all x2 (all x3 (-> (ex x4 (= (+ x1 (s x4)) x2)) (-> (ex x5 (= (+ x2 x5) x3)) (ex x6 (= (+ x1 (s x6)) x3))))))) (gen x7 (gen x8 (gen x9 (lam h10 (ex x11 (= (+ x7 (s x11)) x8)) (lam h12 (ex x13 (= (+ x8 x13) x9)) (unpack h10 (gen x14 (lam h15 (= (+ x7 (s x14)) x8) (unpack h12 (gen x16 (lam h17 (= (+ x8 x16) x9) (wit x18 (= (+ x7 (s x18)) x9) (+ x14 x16) (app (app (inst (inst (inst (use 6) (+ x7 (+ (s x14) x16))) (+ (+ x7 (s x14)) x16)) x9) (app (inst (inst (use 5) (+ (+ x7 (s x14)) x16)) (+ x7 (+ (s x14) x16))) (inst (inst (inst (use 4) (s x14)) x16) x7))) (app (app (inst (inst (inst (use 6) (+ (+ x7 (s x14)) x16)) (+ x8 x16)) x9) (eqelim x19 (= (+ (+ x7 (s x14)) x16) (+ x19 x16)) h15 (refl (+ (+ x7 (s x14)) x16)))) h17)))))))))))))))
(all x1 (all x2 (all x3 (all x4 (-> (ex x5 (= (+ (+ x1 x2) x5) x3)) (-> (ex x6 (= (+ x4 (s x6)) x2)) (ex x7 (= (+ (+ x1 x4) (s x7)) x3))))))))
(gen x1 (gen x2 (gen x3 (gen x4 (lam h5 (ex x6 (= (+ (+ x1 x2) x6) x3)) (lam h7 (ex x8 (= (+ x4 (s x8)) x2)) (app (app (inst (inst (inst (use 7) (+ x1 x4)) (+ x1 x2)) x3) (app (inst (inst (inst (use 3) x4) x2) x1) h7)) h5)))))))
