; Publish the complete p68 root implication only after every local layer and
; the complete seven-row outcome relation have been rechecked.

parse_proc_publication_init:
        imm r20, 606000
        imm r21, 1481789520             ; PPRX
        call exact_require_cell
        imm r20, 606008
        imm r21, 1312903248             ; PPAN
        call exact_require_cell
        imm r20, 606016
        imm r21, 1213416784             ; PESH
        call exact_require_cell
        imm r20, 606024
        imm r21, 1414415696             ; PENT
        call exact_require_cell
        imm r20, 606032
        imm r21, 1414877008             ; POUT
        call exact_require_cell
        imm r20, 606040
        imm r21, 1296388676             ; hypothetical DREM strengthening
        call exact_require_cell
        imm r1, 610024
        imm r2, 1129467984             ; PPRC
        store r1, r2
        imm r20, 610024
        imm r21, 1129467984
        call exact_require_cell
        imm r0, 0
        halt r0
