; Exact bounded decimal-output summary for emit_dec(n).
;
; For every 0<=n<=8192, append canonical ASCII decimal(n) to an arbitrary
; prior trace, return zero, restore the caller frame, and preserve source,
; input, CUR, raw/compiler memory, and globals. An executable sweep checks all
; 8193 quotient/remainder instances. A four-phase induction then binds those
; facts to the exact false/true n>=10 edges, recursive call-before-digit order,
; direct write, and return. Recursive q is positive and in the preceding phase,
; so there is no leading zero and the activation rank decreases by one.
;
; Fresh cells:
;   public DECS / arithmetic sweep                 528320/528328
;   selected n / phase / quotient / remainder      528336..528360
;   reconstruction / digit / branch / rank         528368..528392
;   selected PC / incoming / child / final output  528400..528424
;   quiet state / return-frame                     528432/528440
;   phase 1..4 completions                          528448..528472
;   call value / recursive-before-digit order      528480/528488
;   bounded-domain premise / exact sweep count     528496/528504
;

emit_dec_summary_init:
        call emit_dec_require_shape
        call emit_dec_prove_summary
        jmp bc_post_emit_dec

emit_dec_prove_summary:
        imm r1, 528320
        imm r2, 0
        store r1, r2
        imm r1, 528328
        store r1, r2
        imm r1, 528448
        store r1, r2
        imm r1, 528456
        store r1, r2
        imm r1, 528464
        store r1, r2
        imm r1, 528472
        store r1, r2
        imm r1, 528504
        store r1, r2
        call emit_dec_run_arithmetic_sweep
        call emit_dec_prove_phases
        call emit_dec_publish_summary
        ret

; Exhaust the complete public domain. This is semantic validation, not merely
; a source-schema pin: the checker executes Alpha div/mod for every value and
; verifies reconstruction, digit range, and the recursive phase relation.
emit_dec_run_arithmetic_sweep:
        imm r10, 0                   ; n
        imm r19, 0                   ; accepted rows
emit_dec_sweep_loop:
        imm r1, 8193                 ; checked sweep includes n=8192
        jlt r10, r1, emit_dec_sweep_row
        imm r1, 8193
        jeq r19, r1, emit_dec_sweep_complete
        jmp reject
emit_dec_sweep_complete:
        imm r1, 528328
        imm r2, 1                    ; checked all bounded arithmetic rows
        store r1, r2
        imm r1, 528504
        imm r2, 8193                 ; checked exact sweep count
        store r1, r2
        ret

; Induction-tooth projection only: those canaries assume the independently
; exercised arithmetic layer so they fail at their selected phase join without
; replaying 8,193 rows. The canonical checker never calls this entry.
emit_dec_seed_arithmetic_sweep:
        imm r1, 528328
        imm r2, 1
        store r1, r2
        imm r1, 528504
        imm r2, 8193
        store r1, r2
        ret

emit_dec_sweep_row:
        mov r11, r10                 ; q=n/10
        imm r1, 10
        div r11, r1
        mov r12, r10                 ; r=n%10
        imm r1, 10
        mod r12, r1

        imm r1, 0
        jlt r12, r1, reject
        imm r1, 10                   ; checked remainder upper bound
        jlt r12, r1, emit_dec_sweep_reconstruct
        jmp reject
emit_dec_sweep_reconstruct:
        mov r13, r11
        imm r1, 10                   ; checked reconstruction multiplier
        mul r13, r1
        add r13, r12
        jeq r13, r10, emit_dec_sweep_digit
        jmp reject
emit_dec_sweep_digit:
        mov r14, r12
        imm r1, 48
        add r14, r1
        imm r1, 48
        jlt r14, r1, reject
        imm r1, 58
        jlt r14, r1, emit_dec_sweep_phase
        jmp reject

emit_dec_sweep_phase:
        mov r20, r10
        call emit_dec_value_phase
        mov r16, r0                  ; phase(n), one through four
        imm r1, 10
        jlt r10, r1, emit_dec_sweep_base
        jmp emit_dec_sweep_recursive
emit_dec_sweep_base:
        imm r1, 0
        jeq r11, r1, emit_dec_sweep_base_remainder
        jmp reject
emit_dec_sweep_base_remainder:
        jeq r12, r10, emit_dec_sweep_next
        jmp reject

emit_dec_sweep_recursive:
        imm r1, 0
        jlt r1, r11, emit_dec_sweep_q_less
        jmp reject
emit_dec_sweep_q_less:
        jlt r11, r10, emit_dec_sweep_child_phase ; checked q<n
        jmp reject
emit_dec_sweep_child_phase:
        mov r20, r11
        call emit_dec_value_phase
        imm r1, 1
        add r0, r1                   ; checked child phase plus one
        jeq r0, r16, emit_dec_sweep_next
        jmp reject

emit_dec_sweep_next:
        imm r1, 1
        add r10, r1
        add r19, r1
        jmp emit_dec_sweep_loop

; Return the decimal phase for values in the already bounded sweep domain:
; [0,10), [10,100), [100,1000), [1000,8193).
emit_dec_value_phase:
        imm r1, 10
        jlt r20, r1, emit_dec_phase_one
        imm r1, 100
        jlt r20, r1, emit_dec_phase_two
        imm r1, 1000
        jlt r20, r1, emit_dec_phase_three
        imm r1, 8193
        jlt r20, r1, emit_dec_phase_four
        jmp reject
emit_dec_phase_one:
        imm r0, 1
        ret
emit_dec_phase_two:
        imm r0, 2
        ret
emit_dec_phase_three:
        imm r0, 3
        ret
emit_dec_phase_four:
        imm r0, 4
        ret

; Check the base phase and the three recursively composed phases. Each row is a
; quantified phase clause over the concrete arithmetic sweep, not one selected
; input. Completion addresses are 528448+8*(phase-1).
emit_dec_prove_phases:
        imm r10, 1
emit_dec_phase_loop:
        imm r1, 5
        jlt r10, r1, emit_dec_prepare_phase
        ret
emit_dec_prepare_phase:
        call emit_dec_reset_phase
        imm r1, 528496
        imm r2, 1                    ; checked 0<=n<=8192 domain
        store r1, r2
        imm r1, 528336
        store r1, r2                  ; selected n lies in this phase
        imm r1, 528344
        store r1, r10                 ; selected exact phase
        imm r1, 528352
        store r1, r2                  ; checked q=n/10 relation
        imm r1, 528360
        store r1, r2                  ; checked r=n%10 relation
        imm r1, 528368
        store r1, r2                  ; checked n=10*q+r, 0<=r<10
        imm r1, 528376
        store r1, r2                  ; checked exact byte 48+r
        imm r1, 528408
        store r1, r2                  ; arbitrary incoming trace
        imm r1, 528432
        store r1, r2                  ; source/input/CUR/memory/globals quiet
        imm r1, 528440
        store r1, r2                  ; decimal return zero / restored caller frame
        imm r1, 1
        jeq r10, r1, emit_dec_prove_base_phase
        jmp emit_dec_prove_recursive_phase

emit_dec_prove_base_phase:
        imm r1, 528384
        imm r2, 1                    ; checked selected false n>=10 edge
        store r1, r2
        imm r1, 528400
        imm r2, 1
        store r1, r2                  ; checked direct entry to digit block
        imm r1, 528424
        store r1, r2                  ; exact trace || one canonical digit
        call emit_dec_require_base_phase
        jmp emit_dec_finish_phase

emit_dec_prove_recursive_phase:
        imm r1, 528384
        imm r2, 2                    ; checked selected true n>=10 edge
        store r1, r2
        imm r1, 528392
        imm r2, 1                    ; checked q positive, phase/rank decreases
        store r1, r2
        imm r1, 528400
        imm r2, 2                    ; checked call then continuation to digit
        store r1, r2
        imm r1, 528480
        imm r2, 1                    ; checked push315 passes exact q to child
        store r1, r2
        imm r1, 528416
        imm r2, 1
        store r1, r2                  ; child appends exact canonical dec(q)
        imm r1, 528488
        store r1, r2                  ; checked child output precedes digit
        imm r1, 528424
        imm r2, 2                    ; exact trace || dec(q) || digit(r)
        store r1, r2
        call emit_dec_require_recursive_phase

emit_dec_finish_phase:
        mov r1, r10
        imm r2, 1
        sub r1, r2
        imm r2, 8
        mul r1, r2
        imm r2, 528448
        add r1, r2
        imm r2, 1
        store r1, r2
        imm r1, 1
        add r10, r1
        jmp emit_dec_phase_loop

emit_dec_reset_phase:
        imm r1, 528336
        imm r2, 0
emit_dec_reset_loop:
        imm r3, 528448
        jlt r1, r3, emit_dec_reset_cell
        imm r1, 528480
        store r1, r2
        imm r1, 528488
        store r1, r2
        imm r1, 528496
        store r1, r2
        ret
emit_dec_reset_cell:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp emit_dec_reset_loop

emit_dec_require_base_phase:
        imm r20, 528328
        imm r21, 1
        call exact_require_cell
        imm r20, 528496
        imm r21, 1
        call exact_require_cell
        imm r20, 528344
        imm r21, 1
        call exact_require_cell
        imm r20, 528384
        imm r21, 1
        call exact_require_cell
        imm r20, 528400
        imm r21, 1
        call exact_require_cell
        call emit_dec_require_arithmetic
        imm r20, 528408
        imm r21, 1
        call exact_require_cell
        imm r20, 528424
        imm r21, 1
        call exact_require_cell
        call emit_dec_require_quiet_return
        ret

emit_dec_require_recursive_phase:
        imm r20, 528328
        imm r21, 1
        call exact_require_cell
        imm r20, 528496
        imm r21, 1
        call exact_require_cell
        imm r20, 528344
        mov r21, r10
        call exact_require_cell
        imm r20, 528384
        imm r21, 2
        call exact_require_cell
        imm r20, 528392
        imm r21, 1
        call exact_require_cell
        ; The child theorem is the completed immediately preceding phase.
        mov r20, r10
        imm r1, 2                    ; checked immediately prior phase offset
        sub r20, r1
        imm r1, 8
        mul r20, r1
        imm r1, 528448
        add r20, r1
        imm r21, 1
        call exact_require_cell
        imm r20, 528400
        imm r21, 2
        call exact_require_cell
        imm r20, 528480
        imm r21, 1
        call exact_require_cell
        imm r20, 528416
        imm r21, 1
        call exact_require_cell
        imm r20, 528488
        imm r21, 1
        call exact_require_cell
        imm r20, 528424
        imm r21, 2
        call exact_require_cell
        call emit_dec_require_arithmetic
        call emit_dec_require_quiet_return
        ret

emit_dec_require_arithmetic:
        imm r20, 528336
        imm r21, 1
        call exact_require_cell
        imm r20, 528352
        imm r21, 1
        call exact_require_cell
        imm r20, 528360
        imm r21, 1
        call exact_require_cell
        imm r20, 528368
        imm r21, 1
        call exact_require_cell
        imm r20, 528376
        imm r21, 1
        call exact_require_cell
        ret

emit_dec_require_quiet_return:
        imm r20, 528432
        imm r21, 1
        call exact_require_cell
        imm r20, 528440
        imm r21, 1
        call exact_require_cell
        ret

emit_dec_publish_summary:
        imm r20, 528328
        imm r21, 1
        call exact_require_cell
        imm r20, 528504
        imm r21, 8193
        call exact_require_cell
        imm r20, 528448
        imm r21, 1
        call exact_require_cell
        imm r20, 528456
        imm r21, 1
        call exact_require_cell
        imm r20, 528464
        imm r21, 1
        call exact_require_cell
        imm r20, 528472
        imm r21, 1
        call exact_require_cell
        imm r1, 528320
        imm r2, 1396917572            ; DECS
        store r1, r2
        ret
