; Conditional finite branch relation for gen_stmt (procedure67), part one.
;
; The antecedent process does not import theorem cells from the producing
; checkers.  SANT names the complete bundle-fingerprinted implication premise;
; ALEX/ANAM/AEMT/AEXP/ASHP name its lexical, name, emitter, expression, and
; exact-shape conjuncts.  SEPI, SSTR, and SDTO are the locally preceding
; conditional contracts for emit_epilogue, gen_store, and gen_to.  This module derives only p67's finite
; dispatch rows.  The recursive state child remains an explicit Ret-or-Div
; premise for the wrapper/greatest-fixed-point phase.
;
; Public completion: STBR at 546196.  Private cells: 547200..547704.

statement_gen_stmt_rules_init:
        call statement_gen_stmt_require_antecedents
        call statement_gen_stmt_reset
        call statement_gen_stmt_prove_common_prefix
        call statement_gen_stmt_prove_dispatch_priority
        call statement_gen_stmt_prove_let
        call statement_gen_stmt_prove_return
        call statement_gen_stmt_prove_state
        call statement_gen_stmt_prove_to
        call statement_gen_stmt_prove_store_widths
        jmp statement_gen_stmt_fallback_rules_init

statement_gen_stmt_require_antecedents:
        imm r20, 546156
        imm r21, 1414414675             ; SANT
        call exact_require_cell
        imm r20, 546108
        imm r21, 1480936513             ; ALEX
        call exact_require_cell
        imm r20, 546116
        imm r21, 1296125505             ; ANAM
        call exact_require_cell
        imm r20, 546124
        imm r21, 1414350145             ; AEMT
        call exact_require_cell
        imm r20, 546140
        imm r21, 1347962177             ; AEXP
        call exact_require_cell
        imm r20, 546148
        imm r21, 1346917185             ; ASHP
        call exact_require_cell
        imm r20, 546164
        imm r21, 1229997395             ; SEPI
        call exact_require_cell
        imm r20, 546172
        imm r21, 1381258067             ; SSTR
        call exact_require_cell
        imm r20, 546188
        imm r21, 1330922579             ; SDTO
        call exact_require_cell
        imm r1, 547200
        imm r2, 9                        ; exact antecedent/package count
        store r1, r2
        ret

statement_gen_stmt_reset:
        imm r10, 547208
statement_gen_stmt_reset_loop:
        imm r1, 547712
        jlt r10, r1, statement_gen_stmt_reset_one
        ret
statement_gen_stmt_reset_one:
        imm r2, 0
        store r10, r2
        imm r1, 8
        add r10, r1
        jmp statement_gen_stmt_reset_loop

; Every p67 call first performs terminating SWSQ and maximal, possibly-empty
; RIDS.  No output or resource/depth change occurs in this prefix.  If the
; identifier is empty, CUR is permitted to remain unchanged.  The exact read
; slice remains the call name / assignment query unless a selected branch reads
; another identifier.
statement_gen_stmt_prove_common_prefix:
        imm r20, 547200
        imm r21, 9
        call exact_require_cell
        imm r1, 547208
        imm r2, 1                        ; SWSQ then RIDS, exact source order
        store r1, r2
        imm r1, 547216
        imm r2, 1                        ; possibly-empty identifier admitted
        store r1, r2
        imm r1, 547224
        imm r2, 1                        ; prefix output epsilon
        store r1, r2
        imm r1, 547232
        imm r2, 1                        ; RESOURCE/ED/BD preserved
        store r1, r2
        ret

; Source priority is exact and exhaustive:
;   let -> return -> state -> to -> byte -> word -> fallback.
; ILET owns let; FKWS owns the other five fixed keywords.  The fallback is
; reached only after all six false clauses, not by a set-like reordering.
statement_gen_stmt_prove_dispatch_priority:
        call statement_gen_stmt_require_common
        imm r10, 0
statement_gen_stmt_dispatch_loop:
        imm r1, 7
        jlt r10, r1, statement_gen_stmt_dispatch_row
        imm r1, 547240
        imm r2, 7                        ; all seven ordered destinations
        store r1, r2
        ret
statement_gen_stmt_dispatch_row:
        mov r11, r10
        imm r1, 8
        mul r11, r1
        imm r1, 547456
        add r11, r1
        mov r2, r10
        imm r1, 1
        add r2, r1
        store r11, r2                   ; row i records priority i+1
        imm r1, 1
        add r10, r1
        jmp statement_gen_stmt_dispatch_loop

; LET-FULL: after a second SWSQ/RIDS, DCLS at NLOC=1024 writes numeric252,
; preserves NLOC/table, and p67 takes its only immediate resource guard.  It
; returns zero with no EXPS/GEXP/ESTS call and no statement output suffix.
;
; LET-ROOM: at n<1024 DCLS appends the exact new identifier slice at slot n,
; advances NLOC to n+1, then composes EXPS('='), GEXP, and ESTS(n).  ESTS is
; unconditional for both GEXP status outcomes {0,252}; GEXP restores ED and
; p67 returns zero/restores its frame in both rows.
statement_gen_stmt_prove_let:
        call statement_gen_stmt_require_dispatch
        imm r1, 547248
        imm r2, 1                        ; selected ILET true at priority zero
        store r1, r2
        imm r1, 547256
        imm r2, 1                        ; second SWSQ/RIDS exact declaration name
        store r1, r2
        imm r1, 547264
        imm r2, 1                        ; full: exact numeric252 writer
        store r1, r2
        imm r1, 547272
        imm r2, 1                        ; full: table/NLOC unchanged
        store r1, r2
        imm r1, 547280
        imm r2, 1                        ; full: immediate epsilon return0
        store r1, r2
        imm r1, 547288
        imm r2, 1                        ; room: append slice at old n
        store r1, r2
        imm r1, 547296
        imm r2, 1                        ; room: NLOC n -> n+1, NameInv extended
        store r1, r2
        imm r1, 547304
        imm r2, 2                        ; exact GEXP status product 0/252
        store r1, r2
        imm r1, 547312
        imm r2, 2                        ; ESTS(n) executed in both products
        store r1, r2
        imm r1, 547320
        imm r2, 2                        ; both finite rows return0/frame restore
        store r1, r2
        ret

; RETURN composes GEXP followed by p46's exact five fixed fragments:
;   mov r15,r14\n load r14,r15\n imm r2,8\n add r15,r2\n ret\n
; The epilogue is unconditional for both status outcomes and does not clear or
; reclassify numeric252.  Every finite row returns source zero and restores p67.
statement_gen_stmt_prove_return:
        call statement_gen_stmt_require_dispatch
        imm r20, 546164
        imm r21, 1229997395             ; SEPI exact p46 fragment relation
        call exact_require_cell
        imm r1, 547328
        imm r2, 1                        ; exact second-priority return branch
        store r1, r2
        imm r1, 547336
        imm r2, 2                        ; GEXP status outcomes 0/252
        store r1, r2
        imm r1, 547344
        imm r2, 5                        ; exact p46 ordered fragment count
        store r1, r2
        imm r1, 547352
        imm r2, 2                        ; epilogue after both outcomes
        store r1, r2
        imm r1, 547360
        imm r2, 2                        ; finite return0/frame restoration
        store r1, r2
        ret

; STATE deliberately does not assume its recursive child terminates.  The row
; exposes two abstract outcomes to the wrapper phase: child Ret yields p67
; return0/frame restoration; child Div lifts the exact maximal trace and leaves
; p67 active.  No Ret token is manufactured for the divergent alternative.
statement_gen_stmt_prove_state:
        call statement_gen_stmt_require_dispatch
        imm r1, 547368
        imm r2, 1                        ; exact third-priority state branch
        store r1, r2
        imm r1, 547376
        imm r2, 1                        ; abstract state-child Ret premise
        store r1, r2
        imm r1, 547384
        imm r2, 1                        ; Ret lifts return0/frame restore
        store r1, r2
        imm r1, 547392
        imm r2, 1                        ; abstract state-child Div premise
        store r1, r2
        imm r1, 547400
        imm r2, 1                        ; Div trace/frame lifted, no return
        store r1, r2
        ret

; TO is the fourth priority branch and instantiates SDTO.  SDTO owns plain
; lookahead restoration and guarded GEXP/resource suffix behavior; p67 merely
; returns zero after every finite SDTO result.
statement_gen_stmt_prove_to:
        call statement_gen_stmt_require_dispatch
        imm r20, 546188
        imm r21, 1330922579             ; SDTO
        call exact_require_cell
        imm r1, 547408
        imm r2, 1                        ; exact fourth-priority to branch
        store r1, r2
        imm r1, 547416
        imm r2, 2                        ; SDTO plain/guarded partition
        store r1, r2
        imm r1, 547424
        imm r2, 1                        ; every finite result returns0/restores
        store r1, r2
        ret

; BYTE and WORD are distinct priority rows.  They pass literal widths 1 and 8
; respectively to SSTR; neither inverts or recomputes SSTR's width guard.  SSTR
; already includes both-expression resource products and their unconditional
; pop/store suffix.
statement_gen_stmt_prove_store_widths:
        call statement_gen_stmt_require_dispatch
        imm r20, 546172
        imm r21, 1381258067             ; SSTR
        call exact_require_cell
        imm r1, 547432
        imm r2, 1                        ; byte branch exact width one
        store r1, r2
        imm r1, 547440
        imm r2, 8                        ; word branch exact width eight
        store r1, r2
        imm r1, 547448
        imm r2, 2                        ; both finite rows return0/frame restore
        store r1, r2
        ret

statement_gen_stmt_require_common:
        imm r20, 547208
        imm r21, 1
        call exact_require_cell
        imm r20, 547216
        imm r21, 1
        call exact_require_cell
        imm r20, 547224
        imm r21, 1
        call exact_require_cell
        imm r20, 547232
        imm r21, 1
        call exact_require_cell
        ret

statement_gen_stmt_require_dispatch:
        call statement_gen_stmt_require_common
        imm r20, 547240
        imm r21, 7
        call exact_require_cell
        ret
