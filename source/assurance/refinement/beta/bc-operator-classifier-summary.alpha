; Total Word meaning for is_muldiv(c) and is_addsub(c).
;
; The checker first exhausts the reusable byte domain 0..255, evaluating the
; source branch order and an independently ordered membership specification.
; Exact counts are 3/253 and 2/254.  The exact shape fixes every comparison as
; full-word equality against a literal below 256, so every remaining Word is in
; the mechanically checked complement and returns zero.  Both procedures are
; quiet and restore their one-slot caller frame.
;
; Fresh cells 529816..529944:
;   public OMUL/OADD                    529816/529824
;   byte premise/current                529832/529840
;   mul source/spec; add source/spec    529848..529872
;   exact yes/no counts                 529880..529904
;   byte complete/nonbyte complement    529912/529920
;   parameter/quiet/full-Word relation  529928/529936/529944

operator_classifier_summary_init:
        call operator_classifier_require_shape
        call operator_classifier_prove_summary
        jmp cmp_op_summary_init

operator_classifier_prove_summary:
        call operator_classifier_reset
        call operator_classifier_require_byte_domain
        call operator_classifier_introduce_frame
        call operator_classifier_sweep_bytes
        call operator_classifier_prove_nonbyte_complement
        call operator_classifier_publish
        ret

operator_classifier_reset:
        imm r1, 529816
        imm r2, 0
operator_classifier_reset_loop:
        imm r3, 529952
        jlt r1, r3, operator_classifier_reset_cell
        ret
operator_classifier_reset_cell:
        store r1, r2
        imm r3, 8
        add r1, r3
        jmp operator_classifier_reset_loop

operator_classifier_require_byte_domain:
        imm r20, 526696
        imm r21, 1                    ; reusable 0<=c<=255 domain theorem
        call exact_require_cell
        imm r1, 529832
        imm r2, 1
        store r1, r2
        ret

operator_classifier_introduce_frame:
        ; Exact parameter stores and all five local-load rows carry the same c.
        imm r1, 529928
        imm r2, 1                    ; checked parameter-slot provenance
        store r1, r2
        ; No calls, I/O, raw memory, cursor access, or trapping arithmetic occur;
        ; the six exact epilogues reclaim both private frames.
        imm r1, 529936
        store r1, r2                  ; checked quiet/restored relation
        ret

operator_classifier_sweep_bytes:
        imm r1, 529840
        imm r2, 0
        store r1, r2
operator_classifier_byte_loop:
        imm r1, 529840
        load r2, r1
        imm r3, 256
        jlt r2, r3, operator_classifier_byte_case
        jeq r2, r3, operator_classifier_finish_bytes
        jmp reject
operator_classifier_byte_case:
        call operator_classifier_require_case
        call operator_classifier_eval_mul_source
        call operator_classifier_eval_mul_spec
        imm r20, 529848
        imm r21, 529856
        call classifier_require_equal_cells
        imm r20, 529848
        imm r21, 529880
        imm r22, 529888
        call operator_classifier_count_result

        call operator_classifier_eval_add_source
        call operator_classifier_eval_add_spec
        imm r20, 529864
        imm r21, 529872
        call classifier_require_equal_cells
        imm r20, 529864
        imm r21, 529896
        imm r22, 529904
        call operator_classifier_count_result

        imm r1, 529840
        load r2, r1
        imm r3, 1
        add r2, r3
        store r1, r2
        jmp operator_classifier_byte_loop

operator_classifier_require_case:
        imm r20, 529832
        imm r21, 1
        call exact_require_cell
        imm r20, 529928
        imm r21, 1                   ; every comparison reloads entry c
        call exact_require_cell
        imm r20, 529936
        imm r21, 1
        call exact_require_cell
        ret

; Exact source order: '*', '/', '%', complement.
operator_classifier_eval_mul_source:
        imm r1, 529840
        load r2, r1
        imm r3, 42                   ; checked source star discriminator
        jeq r2, r3, operator_classifier_mul_source_one
        imm r3, 47                   ; checked source slash discriminator
        jeq r2, r3, operator_classifier_mul_source_one
        imm r3, 37                   ; checked source percent discriminator
        jeq r2, r3, operator_classifier_mul_source_one
        imm r2, 0                    ; checked source complement result
        jmp operator_classifier_mul_source_store
operator_classifier_mul_source_one:
        imm r2, 1                    ; checked source accepted result
operator_classifier_mul_source_store:
        imm r1, 529848
        store r1, r2
        ret

; Independent membership order: '%', '*', '/'.
operator_classifier_eval_mul_spec:
        imm r1, 529840
        load r2, r1
        imm r3, 37                   ; checked spec percent member
        jeq r2, r3, operator_classifier_mul_spec_one
        imm r3, 42                   ; checked spec star member
        jeq r2, r3, operator_classifier_mul_spec_one
        imm r3, 47                   ; checked spec slash member
        jeq r2, r3, operator_classifier_mul_spec_one
        imm r2, 0
        jmp operator_classifier_mul_spec_store
operator_classifier_mul_spec_one:
        imm r2, 1
operator_classifier_mul_spec_store:
        imm r1, 529856
        store r1, r2
        ret

; Exact source order: '+', '-', complement.
operator_classifier_eval_add_source:
        imm r1, 529840
        load r2, r1
        imm r3, 43                   ; checked source plus discriminator
        jeq r2, r3, operator_classifier_add_source_one
        imm r3, 45                   ; checked source minus discriminator
        jeq r2, r3, operator_classifier_add_source_one
        imm r2, 0                    ; checked source complement result
        jmp operator_classifier_add_source_store
operator_classifier_add_source_one:
        imm r2, 1                    ; checked source accepted result
operator_classifier_add_source_store:
        imm r1, 529864
        store r1, r2
        ret

; Independent membership order: '-', '+'.
operator_classifier_eval_add_spec:
        imm r1, 529840
        load r2, r1
        imm r3, 45                   ; checked spec minus member
        jeq r2, r3, operator_classifier_add_spec_one
        imm r3, 43                   ; checked spec plus member
        jeq r2, r3, operator_classifier_add_spec_one
        imm r2, 0
        jmp operator_classifier_add_spec_store
operator_classifier_add_spec_one:
        imm r2, 1
operator_classifier_add_spec_store:
        imm r1, 529872
        store r1, r2
        ret

operator_classifier_count_result:
        load r23, r20
        imm r1, 1
        jeq r23, r1, operator_classifier_count_yes
        imm r1, 0
        jeq r23, r1, operator_classifier_count_no
        jmp reject
operator_classifier_count_yes:
        load r1, r21
        imm r2, 1
        add r1, r2
        store r21, r1
        ret
operator_classifier_count_no:
        load r1, r22
        imm r2, 1
        add r1, r2
        store r22, r1
        ret

operator_classifier_finish_bytes:
        imm r20, 529880
        imm r21, 3                    ; exactly '*', '/', '%'
        call exact_require_cell
        imm r20, 529888
        imm r21, 253                  ; exact byte complement
        call exact_require_cell
        imm r20, 529896
        imm r21, 2                    ; exactly '+', '-'
        call exact_require_cell
        imm r20, 529904
        imm r21, 254                  ; exact byte complement
        call exact_require_cell
        imm r1, 529912
        imm r2, 1                    ; checked complete 256-byte sweep
        store r1, r2
        ret

; Every exact classifier literal is below 256. Because shape rows572/574/576
; and 580/582 are full-word equality (code10), any Word outside 0..255 differs
; from every accepted literal and follows the exact zero-return complement.
operator_classifier_prove_nonbyte_complement:
        imm r1, 42
        call operator_classifier_require_byte_literal
        imm r1, 47
        call operator_classifier_require_byte_literal
        imm r1, 37
        call operator_classifier_require_byte_literal
        imm r1, 43
        call operator_classifier_require_byte_literal
        imm r1, 45
        call operator_classifier_require_byte_literal
        imm r20, 529912
        imm r21, 1
        call exact_require_cell
        imm r1, 529920
        imm r2, 1                    ; checked non-byte Word complement is zero
        store r1, r2
        ret

operator_classifier_require_byte_literal:
        imm r2, 0
        jlt r1, r2, reject
        imm r2, 256
        jlt r1, r2, exact_shape_ok
        jmp reject

operator_classifier_publish:
        imm r20, 529912
        imm r21, 1
        call exact_require_cell
        imm r20, 529920
        imm r21, 1                   ; non-byte complement required
        call exact_require_cell
        imm r20, 529928
        imm r21, 1
        call exact_require_cell
        imm r20, 529936
        imm r21, 1
        call exact_require_cell
        imm r1, 529944
        imm r2, 1                    ; exhaustive Word partition complete
        store r1, r2
        imm r20, 529944
        imm r21, 1
        call exact_require_cell
        imm r1, 529816
        imm r2, 1280658767           ; OMUL
        store r1, r2
        imm r1, 529824
        imm r2, 1145323855           ; OADD
        store r1, r2
        ret
