; Lower-rooted exact CKIR1 -> limited Linux x86-64 ELF checker.
; Concatenate after ckir-refinement-envelope.beta and
; ckir-refinement-artifact.beta with both earlier main procedures removed.
;
; The preceding artifact checker owns raw CKIR validation and selected-result
; evaluation.  This suffix independently assigns the selected frame, sizes and
; reconstructs every canonical instruction, reconstructs both ELF program
; headers and all padding, compares exact envelope ELF bytes and EOF, and binds
; the low-eight-bit exit observation.  It emits no bytes.
;
; Globals: output cursor 525240, text cursor 525248, compare mode 525256,
; RX size 525264, trap offset 525272, frame size 525280, scratch base 525288.
; Block offsets start at 9800000, value slots at 9850000, place slots at 10200000.

proc elf_align(value, alignment) {
    return ((value + alignment - 1) / alignment) * alignment
}

proc elf_expect_byte(value) {
    let cursor = word[525240]
    state bounds { to bad when (cursor >= word[524352])  to compare }
    state compare { to bad when (refinement_elf_byte(cursor) != value)  word[525240] = cursor + 1  return 0 }
    state bad { return 251 }
}

proc elf_expect_u16(value) {
    state first { to bad when (elf_expect_byte(value % 256) != 0)  to second }
    state second { to bad when (elf_expect_byte((value / 256) % 256) != 0)  return 0 }
    state bad { return 251 }
}

proc elf_expect_u32(value) {
    state b0 { to bad when (elf_expect_byte(value % 256) != 0)  to b1 }
    state b1 { to bad when (elf_expect_byte((value / 256) % 256) != 0)  to b2 }
    state b2 { to bad when (elf_expect_byte((value / 65536) % 256) != 0)  to b3 }
    state b3 { to bad when (elf_expect_byte((value / 16777216) % 256) != 0)  return 0 }
    state bad { return 251 }
}

proc elf_expect_u64(low, high) {
    state low { to bad when (elf_expect_u32(low) != 0)  to high }
    state high { to bad when (elf_expect_u32(high) != 0)  return 0 }
    state bad { return 251 }
}

proc elf_code_byte(value) {
    let cursor = word[525248]
    state limit { to exhausted when (cursor >= 1048576)  to compare }
    state compare { to advance when (word[525256] == 0)  to exact }
    state exact { to bad when (elf_expect_byte(value) != 0)  to advance }
    state advance { word[525248] = cursor + 1  return 0 }
    state exhausted { return 252 }
    state bad { return 251 }
}

proc elf_code2(a, b) {
    let status = elf_code_byte(a)
    state a { to done when (status != 0)  status = elf_code_byte(b)  to done }
    state done { return status }
}

proc elf_code3(a, b, c) {
    let status = elf_code_byte(a)
    state a { to done when (status != 0)  status = elf_code_byte(b)  to b }
    state b { to done when (status != 0)  status = elf_code_byte(c)  to done }
    state done { return status }
}

proc elf_code4(a, b, c, d) {
    let status = elf_code_byte(a)
    state a { to done when (status != 0)  status = elf_code_byte(b)  to b }
    state b { to done when (status != 0)  status = elf_code_byte(c)  to c }
    state c { to done when (status != 0)  status = elf_code_byte(d)  to done }
    state done { return status }
}

proc elf_code_u32(value) {
    let status = elf_code_byte(value % 256)
    state b0 { to done when (status != 0)  status = elf_code_byte((value / 256) % 256)  to b1 }
    state b1 { to done when (status != 0)  status = elf_code_byte((value / 65536) % 256)  to b2 }
    state b2 { to done when (status != 0)  status = elf_code_byte((value / 16777216) % 256)  to done }
    state done { return status }
}

proc elf_code_s32(value) {
    state negative { to positive when (value >= 0)  return elf_code_u32(value + 4294967296) }
    state positive { return elf_code_u32(value) }
}

proc elf_code_rel32(target) {
    return elf_code_s32(target - (word[525248] + 4))
}

proc elf_value_slot(value_id) { return word[9850000 + value_id * 8] }
proc elf_place_slot(place_id) { return word[10200000 + place_id * 8] }

proc elf_load_value(value_id) {
    let status = elf_code2(139, 133)
    state code { to done when (status != 0)  status = elf_code_s32(0 - elf_value_slot(value_id))  to done }
    state done { return status }
}

proc elf_store_value(value_id) {
    let status = elf_code2(137, 133)
    state code { to done when (status != 0)  status = elf_code_s32(0 - elf_value_slot(value_id))  to done }
    state done { return status }
}

proc elf_load_place(place_id) {
    let status = elf_code3(72, 139, 133)
    state code { to done when (status != 0)  status = elf_code_s32(0 - elf_place_slot(place_id))  to done }
    state done { return status }
}

proc elf_store_place(place_id) {
    let status = elf_code3(72, 137, 133)
    state code { to done when (status != 0)  status = elf_code_s32(0 - elf_place_slot(place_id))  to done }
    state done { return status }
}

proc elf_trap_jump(opcode) {
    let status = elf_code2(15, opcode)
    state code { to done when (status != 0)  status = elf_code_rel32(word[525272])  to done }
    state done { return status }
}

proc elf_range_check(type_id) {
    let status = elf_code_byte(61)
    state low_opcode { to done when (status != 0)  status = elf_code_u32(ckir_type_word(type_id, 16))  to low }
    state low { to done when (status != 0)  status = elf_trap_jump(130)  to high_opcode }
    state high_opcode { to done when (status != 0)  status = elf_code_byte(61)  to high }
    state high { to done when (status != 0)  status = elf_code_u32(ckir_type_word(type_id, 20))  to high_jump }
    state high_jump { to done when (status != 0)  status = elf_trap_jump(135)  to done }
    state done { return status }
}

proc elf_assign_frame() {
    let entry = word[525000]
    let cursor = 8
    let i = 0
    let width = 0
    let block = 0
    let block_end = 0
    let scratch = 0
    let count0 = 0
    let count1 = 0
    state values { to value_one when (i < word[525208])  i = 0  to places }
    state value_one {
        to value_next when (ckir_value_machine(i) != entry)
        width = 4
        to value_structural when (ckir_type_byte(ckir_value_type(i), 4) > 3)
        to value_slot
    }
    state value_structural { width = 8  to value_slot }
    state value_slot {
        cursor = elf_align(cursor, width) + width
        to exhausted when (cursor > 262144)
        word[9850000 + i * 8] = cursor
        to value_next
    }
    state value_next { i = i + 1  to values }
    state places { to place_one when (i < word[525216])  to scratch_begin }
    state place_one {
        block = ckir_place_block(i)
        to place_next when (ckir_block_word(block, 4) != entry)
        cursor = elf_align(cursor, 8) + 8
        to exhausted when (cursor > 262144)
        word[10200000 + i * 8] = cursor
        to place_next
    }
    state place_next { i = i + 1  to places }
    state scratch_begin {
        block = ckir_machine_word(entry, 24)
        block_end = block + ckir_machine_word(entry, 28)
        scratch = 0
        to scratch_loop
    }
    state scratch_loop { to scratch_one when (block < block_end)  to finish }
    state scratch_one {
        count0 = ckir_term_word(block, 28)
        count1 = ckir_term_word(block, 40)
        to keep0 when (scratch >= count0)
        scratch = count0
        to keep0
    }
    state keep0 { to keep1 when (scratch >= count1)  scratch = count1  to keep1 }
    state keep1 { block = block + 1  to scratch_loop }
    state finish {
        cursor = elf_align(cursor, 8)
        word[525288] = cursor
        cursor = cursor + scratch * 8
        cursor = elf_align(cursor, 16)
        to exhausted when (cursor > 262144)
        word[525280] = cursor
        return 0
    }
    state exhausted { return 252 }
}

proc elf_emit_copy_leaves(type_id, base) {
    let kind = ckir_type_byte(type_id, 4)
    let record = 0
    let field = 0
    let end = 0
    let element = 0
    let index = 0
    let length = 0
    let stride = 0
    let status = 0
    state kind { to scalar when (kind < 4)  to array when (kind == 5)  to record }
    state scalar {
        to scalar_word when (kind == 2)
        status = elf_code4(65, 15, 182, 131)
        to done when (status != 0)
        status = elf_code_u32(base)
        to done when (status != 0)
        status = elf_code3(65, 136, 130)
        to done when (status != 0)
        status = elf_code_u32(base)
        to done
    }
    state scalar_word {
        status = elf_code3(65, 139, 131)
        to done when (status != 0)
        status = elf_code_u32(base)
        to done when (status != 0)
        status = elf_code3(65, 137, 130)
        to done when (status != 0)
        status = elf_code_u32(base)
        to done
    }
    state record {
        record = ckir_type_word(type_id, 8)
        field = ckir_record_word(record, 8)
        end = field + ckir_record_word(record, 12)
        to fields
    }
    state fields { to field_one when (field < end)  return 0 }
    state field_one {
        status = elf_emit_copy_leaves(ckir_field_word(field, 12), base + word[6200000 + field * 8])
        to done when (status != 0)
        field = field + 1
        to fields
    }
    state array {
        element = ckir_type_word(type_id, 8)
        length = ckir_type_word(type_id, 12)
        stride = word[6000000 + element * 8]
        to elements
    }
    state elements { to element_one when (index < length)  return 0 }
    state element_one {
        status = elf_emit_copy_leaves(element, base + index * stride)
        to done when (status != 0)
        index = index + 1
        to elements
    }
    state done { return status }
}

proc elf_emit_operation(operation) {
    let opcode = ckir_op_byte(operation, 12)
    let result = ckir_op_word(operation, 16)
    let result_type = ckir_op_word(operation, 20)
    let start = ckir_op_word(operation, 24)
    let imm0 = ckir_op_word(operation, 32)
    let a = 0
    let b = 0
    let type_id = 0
    let status = 0
    state dispatch {
        to constant when (opcode == 1)
        to self_place when (opcode == 2)
        to field_place when (opcode == 3)
        to index_place when (opcode == 4)
        to load when (opcode == 5)
        to store when (opcode == 6)
        to copy when (opcode == 7)
        to add when (opcode == 8)
        to less
    }
    state constant {
        status = elf_code_byte(184)
        to done when (status != 0)
        status = elf_code_u32(imm0)
        to done when (status != 0)
        status = elf_store_value(result)
        to done
    }
    state self_place {
        status = elf_code3(72, 139, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - 8)
        to done when (status != 0)
        status = elf_store_place(result)
        to done
    }
    state field_place {
        a = ckir_operand(start)
        status = elf_load_place(a)
        to done when (status != 0)
        status = elf_code2(72, 5)
        to done when (status != 0)
        status = elf_code_u32(word[6200000 + imm0 * 8])
        to done when (status != 0)
        status = elf_store_place(result)
        to done
    }
    state index_place {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        type_id = ckir_place_type(a)
        status = elf_load_place(a)
        to done when (status != 0)
        status = elf_code3(73, 137, 194)
        to done when (status != 0)
        status = elf_load_value(b)
        to done when (status != 0)
        status = elf_code4(137, 193, 129, 249)
        to done when (status != 0)
        status = elf_code_u32(ckir_type_word(type_id, 12))
        to done when (status != 0)
        status = elf_trap_jump(131)
        to done when (status != 0)
        status = elf_code3(72, 105, 201)
        to done when (status != 0)
        status = elf_code_u32(word[6000000 + ckir_type_word(type_id, 8) * 8])
        to done when (status != 0)
        status = elf_code3(73, 1, 202)
        to done when (status != 0)
        status = elf_code3(76, 137, 208)
        to done when (status != 0)
        status = elf_store_place(result)
        to done
    }
    state load {
        a = ckir_operand(start)
        status = elf_load_place(a)
        to done when (status != 0)
        to load_word when (ckir_type_byte(result_type, 4) == 2)
        status = elf_code3(15, 182, 0)
        to load_store
    }
    state load_word { status = elf_code2(139, 0)  to load_store }
    state load_store {
        to done when (status != 0)
        status = elf_store_value(result)
        to done
    }
    state store {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        type_id = ckir_place_type(a)
        status = elf_load_place(a)
        to done when (status != 0)
        status = elf_code3(73, 137, 194)
        to done when (status != 0)
        status = elf_load_value(b)
        to done when (status != 0)
        status = elf_range_check(type_id)
        to done when (status != 0)
        to store_word when (ckir_type_byte(type_id, 4) == 2)
        status = elf_code3(65, 136, 2)
        to done
    }
    state store_word { status = elf_code3(65, 137, 2)  to done }
    state copy {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        status = elf_load_place(a)
        to done when (status != 0)
        status = elf_code3(73, 137, 194)
        to done when (status != 0)
        status = elf_code3(76, 139, 157)
        to done when (status != 0)
        to copy_value when (imm0 == 1)
        status = elf_code_s32(0 - elf_place_slot(b))
        type_id = ckir_place_type(b)
        to copy_leaves
    }
    state copy_value {
        status = elf_code_s32(0 - elf_value_slot(b))
        type_id = ckir_value_type(b)
        to copy_leaves
    }
    state copy_leaves {
        to done when (status != 0)
        status = elf_emit_copy_leaves(type_id, 0)
        to done
    }
    state add {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        status = elf_load_value(a)
        to done when (status != 0)
        status = elf_code2(3, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - elf_value_slot(b))
        to done when (status != 0)
        status = elf_trap_jump(130)
        to done when (status != 0)
        status = elf_range_check(result_type)
        to done when (status != 0)
        status = elf_store_value(result)
        to done
    }
    state less {
        a = ckir_operand(start)
        b = ckir_operand(start + 1)
        status = elf_load_value(a)
        to done when (status != 0)
        status = elf_code2(59, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - elf_value_slot(b))
        to done when (status != 0)
        status = elf_code4(15, 146, 192, 15)
        to done when (status != 0)
        status = elf_code2(182, 192)
        to done when (status != 0)
        status = elf_store_value(result)
        to done
    }
    state done { return status }
}

proc elf_edge_size(start, count) {
    let i = 0
    let value_id = 0
    let size = 5
    state loop { to one when (i < count)  return size }
    state one {
        value_id = ckir_operand(start + i)
        to structural when (ckir_type_byte(ckir_value_type(value_id), 4) > 3)
        size = size + 46
        to next
    }
    state structural { size = size + 28  to next }
    state next { i = i + 1  to loop }
}

proc elf_emit_edge(target, start, count) {
    let i = 0
    let value_id = 0
    let parameter = 0
    let scratch = 0
    let status = 0
    state stage { to stage_one when (i < count)  i = 0  to commit }
    state stage_one {
        value_id = ckir_operand(start + i)
        scratch = word[525288] + (i + 1) * 8
        to stage_structural when (ckir_type_byte(ckir_value_type(value_id), 4) > 3)
        status = elf_load_value(value_id)
        to done when (status != 0)
        status = elf_code2(137, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - scratch)
        to stage_next
    }
    state stage_structural {
        status = elf_code3(72, 139, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - elf_value_slot(value_id))
        to done when (status != 0)
        status = elf_code3(72, 137, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - scratch)
        to stage_next
    }
    state stage_next { to done when (status != 0)  i = i + 1  to stage }
    state commit { to commit_one when (i < count)  to jump }
    state commit_one {
        parameter = ckir_block_word(target, 12) + i
        value_id = ckir_bparam_word(parameter, 16)
        scratch = word[525288] + (i + 1) * 8
        to commit_structural when (ckir_type_byte(ckir_value_type(value_id), 4) > 3)
        status = elf_code2(139, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - scratch)
        to done when (status != 0)
        status = elf_range_check(ckir_value_type(value_id))
        to done when (status != 0)
        status = elf_store_value(value_id)
        to commit_next
    }
    state commit_structural {
        status = elf_code3(72, 139, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - scratch)
        to done when (status != 0)
        status = elf_code3(72, 137, 133)
        to done when (status != 0)
        status = elf_code_s32(0 - elf_value_slot(value_id))
        to commit_next
    }
    state commit_next { to done when (status != 0)  i = i + 1  to commit }
    state jump {
        status = elf_code_byte(233)
        to done when (status != 0)
        status = elf_code_rel32(word[9800000 + target * 8])
        to done
    }
    state done { return status }
}

proc elf_emit_terminator(block) {
    let kind = ckir_term_byte(block, 12)
    let status = 0
    let skip = 0
    state dispatch {
        to jump when (kind == 1)
        to branch when (kind == 2)
        to unit when (kind == 3)
        to value_return
    }
    state jump {
        status = elf_emit_edge(ckir_term_word(block, 20), ckir_term_word(block, 24), ckir_term_word(block, 28))
        to done
    }
    state branch {
        status = elf_load_value(ckir_term_word(block, 16))
        to done when (status != 0)
        status = elf_code4(133, 192, 15, 132)
        to done when (status != 0)
        skip = word[525248] + 4 + elf_edge_size(ckir_term_word(block, 24), ckir_term_word(block, 28))
        status = elf_code_rel32(skip)
        to done when (status != 0)
        status = elf_emit_edge(ckir_term_word(block, 20), ckir_term_word(block, 24), ckir_term_word(block, 28))
        to done when (status != 0)
        status = elf_emit_edge(ckir_term_word(block, 32), ckir_term_word(block, 36), ckir_term_word(block, 40))
        to done
    }
    state unit { status = elf_code2(201, 195)  to done }
    state value_return {
        status = elf_load_value(ckir_term_word(block, 16))
        to done when (status != 0)
        status = elf_range_check(ckir_machine_word(word[525000], 12))
        to done when (status != 0)
        status = elf_code2(201, 195)
        to done
    }
    state done { return status }
}

proc elf_emit_block(block) {
    let operation = ckir_block_word(block, 20)
    let end = operation + ckir_block_word(block, 24)
    let status = 0
    state prolog {
        to operations when (block != ckir_machine_word(word[525000], 32))
        status = elf_code4(85, 72, 137, 229)
        to done when (status != 0)
        status = elf_code3(72, 129, 236)
        to done when (status != 0)
        status = elf_code_u32(word[525280])
        to done when (status != 0)
        status = elf_code3(72, 137, 189)
        to done when (status != 0)
        status = elf_code_s32(0 - 8)
        to done when (status != 0)
        to operations
    }
    state operations { to operation_one when (operation < end)  to terminator }
    state operation_one {
        status = elf_emit_operation(operation)
        to done when (status != 0)
        operation = operation + 1
        to operations
    }
    state terminator { status = elf_emit_terminator(block)  to done }
    state done { return status }
}

proc elf_emit_text() {
    let entry = word[525000]
    let block = ckir_machine_word(entry, 24)
    let end = block + ckir_machine_word(entry, 28)
    let status = 0
    state shim {
        status = elf_code3(72, 141, 61)
        to done when (status != 0)
        status = elf_code_rel32(word[525264] - 4096)
        to done when (status != 0)
        status = elf_code_byte(232)
        to done when (status != 0)
        status = elf_code_rel32(word[9800000 + ckir_machine_word(entry, 32) * 8])
        to done when (status != 0)
        status = elf_code4(15, 182, 248, 184)
        to done when (status != 0)
        status = elf_code_u32(231)
        to done when (status != 0)
        status = elf_code4(15, 5, 15, 11)
        to done when (status != 0)
        word[525272] = word[525248]
        status = elf_code2(15, 11)
        to done when (status != 0)
        to blocks
    }
    state blocks { to block_one when (block < end)  return 0 }
    state block_one {
        to record when (word[525256] == 0)
        to bad when (word[9800000 + block * 8] != word[525248])
        to emit
    }
    state record { word[9800000 + block * 8] = word[525248]  to emit }
    state emit {
        status = elf_emit_block(block)
        to done when (status != 0)
        block = block + 1
        to blocks
    }
    state bad { return 251 }
    state done { return status }
}

proc elf_expect_header(rx_size, bss_size) {
    let i = 0
    let status = 0
    state ident {
        status = elf_expect_byte(127)
        to done when (status != 0)
        status = elf_expect_byte('E')
        to done when (status != 0)
        status = elf_expect_byte('L')
        to done when (status != 0)
        status = elf_expect_byte('F')
        to done when (status != 0)
        status = elf_expect_byte(2)
        to done when (status != 0)
        status = elf_expect_byte(1)
        to done when (status != 0)
        status = elf_expect_byte(1)
        to done when (status != 0)
        i = 7
        to ident_zero
    }
    state ident_zero { to elf_header when (i == 16)  status = elf_expect_byte(0)  to done when (status != 0)  i = i + 1  to ident_zero }
    state elf_header {
        status = elf_expect_u16(2)
        to done when (status != 0)
        status = elf_expect_u16(62)
        to done when (status != 0)
        status = elf_expect_u32(1)
        to done when (status != 0)
        status = elf_expect_u64(4198400, 0)
        to done when (status != 0)
        status = elf_expect_u64(64, 0)
        to done when (status != 0)
        status = elf_expect_u64(0, 0)
        to done when (status != 0)
        status = elf_expect_u32(0)
        to done when (status != 0)
        status = elf_expect_u16(64)
        to done when (status != 0)
        status = elf_expect_u16(56)
        to done when (status != 0)
        status = elf_expect_u16(2)
        to done when (status != 0)
        status = elf_expect_u16(0)
        to done when (status != 0)
        status = elf_expect_u16(0)
        to done when (status != 0)
        status = elf_expect_u16(0)
        to done when (status != 0)
        to rx
    }
    state rx {
        status = elf_expect_u32(1)
        to done when (status != 0)
        status = elf_expect_u32(5)
        to done when (status != 0)
        status = elf_expect_u64(0, 0)
        to done when (status != 0)
        status = elf_expect_u64(4194304, 0)
        to done when (status != 0)
        status = elf_expect_u64(4194304, 0)
        to done when (status != 0)
        status = elf_expect_u64(rx_size, 0)
        to done when (status != 0)
        status = elf_expect_u64(rx_size, 0)
        to done when (status != 0)
        status = elf_expect_u64(4096, 0)
        to done when (status != 0)
        to rw
    }
    state rw {
        status = elf_expect_u32(1)
        to done when (status != 0)
        status = elf_expect_u32(6)
        to done when (status != 0)
        status = elf_expect_u64(rx_size, 0)
        to done when (status != 0)
        status = elf_expect_u64(4194304 + rx_size, 0)
        to done when (status != 0)
        status = elf_expect_u64(4194304 + rx_size, 0)
        to done when (status != 0)
        status = elf_expect_u64(0, 0)
        to done when (status != 0)
        status = elf_expect_u64(bss_size, 0)
        to done when (status != 0)
        status = elf_expect_u64(4096, 0)
        to done
    }
    state done { return status }
}

proc elf_expect_zero_until(limit) {
    state loop { to done when (word[525240] >= limit)  to one }
    state one { to bad when (elf_expect_byte(0) != 0)  to loop }
    state done { return 0 }
    state bad { return 251 }
}

proc ckir_refinement_elf_check() {
    let entry = word[525000]
    let status = 0
    let text_size = 0
    let rx_size = 0
    let owner_type = 0
    let owner_size = 0
    let bss_size = 0
    state library { to entry when (entry != 4294967295)  to library_checks }
    state library_checks {
        to bad when (word[524352] != 0)
        to bad when (word[524368] != 4294967295)
        return 0
    }
    state entry {
        status = elf_assign_frame()
        to done when (status != 0)
        word[525256] = 0
        word[525248] = 0
        word[525264] = 0
        status = elf_emit_text()
        to done when (status != 0)
        text_size = word[525248]
        rx_size = elf_align(4096 + text_size, 4096)
        word[525264] = rx_size
        to bad when (word[524352] != rx_size)
        owner_type = ckir_record_word(ckir_machine_word(entry, 4), 4)
        owner_size = word[6000000 + owner_type * 8]
        bss_size = elf_align(owner_size, 4096)
        to bss_nonzero when (owner_size == 0)
        to header
    }
    state bss_nonzero { bss_size = 4096  to header }
    state header {
        word[525240] = 0
        status = elf_expect_header(rx_size, bss_size)
        to done when (status != 0)
        to bad when (word[525240] != 176)
        status = elf_expect_zero_until(4096)
        to done when (status != 0)
        word[525256] = 1
        word[525248] = 0
        status = elf_emit_text()
        to done when (status != 0)
        to bad when (word[525248] != text_size)
        status = elf_expect_zero_until(rx_size)
        to done when (status != 0)
        to bad when (word[525240] != word[524352])
        to bad when ((word[525232] % 256) != word[524368])
        return 0
    }
    state bad { return 251 }
    state done { return status }
}

proc main() {
    let status = refinement_envelope_read()
    state envelope { to done when (status != 0)  to artifact }
    state artifact { status = ckir_refinement_artifact_check()  to done when (status != 0)  to elf }
    state elf { status = ckir_refinement_elf_check()  to done }
    state done { return status }
}
