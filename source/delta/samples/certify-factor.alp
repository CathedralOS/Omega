// CERTIFYING COMPUTATION — proof-carrying FACTORIZATION, the computational shadow of the
// FTA's existence half. certify-product ASSERTS a fixed 3-element list and proves its
// product; this READS a single number n and COMPUTES a factor list by trial division, then
// emits a proof certificate that the COMPUTED factors multiply back to n:
//   proposition  (Rel 778 (cons f0 (cons f1 ... nil)) N)     -- ProdIs(factors, n), N literal
//   proof        (pcons f0 (pcons f1 ... (pnil)))
// pnil proves ProdIs(nil, 1); pcons h pf grows it: ProdIs(t, m) -> ProdIs(cons h t, h*m). The
// trust anchor accepts only because the pcons chain matches the computed list AND it normalizes
// the product (m f0 (m f1 ... (s z))) and finds it convertible to the literal N — so the program
// proves the correctness of its OWN factorization, machine-checked end to end. Trial division
// yields the prime factorization (nondecreasing), but ProdIs needs only product = n, so any
// factor list would do. n = 1 emits the empty product: (Rel 778 nil (s z)) / (pnil).
//   printf '30' | certify-factor | check.exe  ->  accept   (30 = 2*3*5)
//   printf '12' | certify-factor | check.exe  ->  accept   (12 = 2*2*3)
// A wrong factor (product != n) emits a certificate proof kernel REJECTS — the anchor checks the
// computation, not the compiler. Naturals are the checker's unary form (s (s ... z)).
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    nv: i32; m: i32; d: i32; r: i32; uv: i32;
    facts: [i32; 16]; fn: i32; ei: i32; cp: i32;
}
// emit a checker-unary nat  (s (s ... z))  for v
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
machine Main::main(&mut self) {
    self.n = 0; self.nv = 0; self.fn = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    // parse the first decimal in buf into nv (digits only; bound-checked over [0,n))
    state go()    { self.pos = 0; transition 0 { _ -> pa() } }
    state pa()    { transition self.pos < self.n { true -> paC()  false -> compute() } }
    state paC()   { transition self.buf[self.pos] < 48 { true -> paSkip()  false -> paHi() } }
    state paHi()  { transition self.buf[self.pos] > 57 { true -> paSkip()  false -> paD() } }
    state paD()   { self.nv = self.nv * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pa() } }
    state paSkip(){ self.pos = self.pos + 1; transition 0 { _ -> pa() } }
    // trial-divide m (= nv) by d = 2,3,4,...; each hit appends d to facts[] and divides m
    state compute(){ self.m = self.nv; self.d = 2; transition 0 { _ -> fscan() } }
    state fscan() { transition self.m > 1 { true -> ftry()  false -> emitP() } }
    state ftry()  { self.r = self.m % self.d; transition self.r == 0 { true -> fdiv()  false -> finc() } }
    state fdiv()  { self.facts[self.fn] = self.d; self.fn = self.fn + 1; self.m = self.m / self.d; transition 0 { _ -> fscan() } }
    state finc()  { self.d = self.d + 1; transition 0 { _ -> fscan() } }
    // proposition: (Rel 778 (cons f0 (cons f1 ... nil)) N)
    state emitP() { write_line("(Rel 778"); self.ei = 0; transition 0 { _ -> lloop() } }
    state lloop() { transition self.ei < self.fn { true -> lw()  false -> lnil() } }
    state lw()    { write_line("(cons"); self.emit_nat(self.facts[self.ei]); self.ei = self.ei + 1; transition 0 { _ -> lloop() } }
    state lnil()  { write_line("nil"); self.cp = 0; transition 0 { _ -> lclose() } }
    state lclose(){ transition self.cp < self.fn { true -> lcw()  false -> lprod() } }
    state lcw()   { write_byte(41); self.cp = self.cp + 1; transition 0 { _ -> lclose() } }
    state lprod() { write_byte(32); self.emit_nat(self.nv); write_byte(41); transition 0 { _ -> proof() } }
    // proof: (pcons f0 (pcons f1 ... (pnil)))
    state proof() { self.ei = 0; transition 0 { _ -> ploop() } }
    state ploop() { transition self.ei < self.fn { true -> pw()  false -> ppnil() } }
    state pw()    { write_line("(pcons"); self.emit_nat(self.facts[self.ei]); self.ei = self.ei + 1; transition 0 { _ -> ploop() } }
    state ppnil() { write_line("(pnil)"); self.cp = 0; transition 0 { _ -> pclose() } }
    state pclose(){ transition self.cp < self.fn { true -> pcw()  false -> pdone() } }
    state pcw()   { write_byte(41); self.cp = self.cp + 1; transition 0 { _ -> pclose() } }
    state pdone() { self.console.exit_process(0) }
}
