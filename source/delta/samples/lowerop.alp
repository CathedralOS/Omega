// SELF-HOSTING / CODEGEN (expression arc): lower a binary OPERATOR to its ARM64 snippet,
// exactly as the backend's Binary lowering (src/aarch64.rs). Every binary op pops rhs into
// x1 and lhs into x0, applies the op, and pushes the result; the op-specific middle is:
//   +  adds w0,w0,w1 / b.vs Ltrap        -  subs w0,w0,w1 / b.vs Ltrap
//   *  smull x0,w0,w1 / sxtw x2,w0 / cmp x0,x2 / b.ne Ltrap
//   /  cbz w1,Ltrap / sdiv w0,w0,w1
//   < <= == > >= !=   cmp w0,w1 / cset w0,<cond>
// These snippets carry NO symbol table (operands do), so this is the fully-static half of
// expression lowering. Static lines -> emitted with write_line (which appends the newline).
//   printf '+'  | lowerop  -> the add snippet     printf '<=' | lowerop -> the le compare snippet
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    n: i32; c: i32;
    buf: [u8; 16];
}
machine Main::pops(&mut self) {
    self.console.write_line("    ldr x1, [sp], #16");
    self.console.write_line("    ldr x0, [sp], #16")
}
machine Main::push(&mut self) {
    self.console.write_line("    str x0, [sp, #-16]!")
}
machine Main::main(&mut self) {
    self.n = 0;
    transition 0 { _ -> rd() }
    state rd()   { self.c = read_byte(); transition self.c < 0 { true -> cls()  false -> st() } }
    state st()   { transition self.n < 16 { true -> st2()  false -> rd() } }
    state st2()  { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    // classify buf[0] (and buf[1] for the 2-char compares)
    state cls()  { transition self.buf[0] == 42 { true -> mul()  false -> c1() } }   // '*'
    state c1()   { transition self.buf[0] == 47 { true -> divi()  false -> c2() } }  // '/'
    state c2()   { transition self.buf[0] == 43 { true -> add()  false -> c3() } }   // '+'
    state c3()   { transition self.buf[0] == 45 { true -> sub()  false -> c4() } }   // '-'
    state c4()   { transition self.buf[0] == 60 { true -> lt0()  false -> c5() } }   // '<'
    state c5()   { transition self.buf[0] == 62 { true -> gt0()  false -> c6() } }   // '>'
    state c6()   { transition self.buf[0] == 61 { true -> eq()  false -> c7() } }    // '=' (==)
    state c7()   { transition self.buf[0] == 33 { true -> ne()  false -> c8() } }   // '!' (!=)
    state c8()   { transition self.buf[0] == 37 { true -> rem()  false -> c9() } }   // '%'
    state c9()   { transition self.buf[0] == 38 { true -> band()  false -> c10() } } // '&'
    state c10()  { transition self.buf[0] == 124 { true -> bor()  false -> c11() } } // '|'
    state c11()  { transition self.buf[0] == 94 { true -> bxor()  false -> done() } } // '^'
    state lt0()  { transition self.buf[1] == 61 { true -> le()  false -> lt0b() } }
    state lt0b() { transition self.buf[1] == 60 { true -> shl()  false -> lt() } }   // '<<'
    state gt0()  { transition self.buf[1] == 61 { true -> ge()  false -> gt0b() } }
    state gt0b() { transition self.buf[1] == 62 { true -> shr()  false -> gt() } }   // '>>'
    // arithmetic
    state add()  { self.pops(); self.console.write_line("    adds w0, w0, w1"); self.console.write_line("    b.vs Ltrap"); self.push(); transition 0 { _ -> done() } }
    state sub()  { self.pops(); self.console.write_line("    subs w0, w0, w1"); self.console.write_line("    b.vs Ltrap"); self.push(); transition 0 { _ -> done() } }
    state mul()  { self.pops(); self.console.write_line("    smull x0, w0, w1"); self.console.write_line("    sxtw x2, w0"); self.console.write_line("    cmp x0, x2"); self.console.write_line("    b.ne Ltrap"); self.push(); transition 0 { _ -> done() } }
    state divi() { self.pops(); self.console.write_line("    cbz w1, Ltrap"); self.console.write_line("    sdiv w0, w0, w1"); self.push(); transition 0 { _ -> done() } }
    // comparisons: cmp + cset <cond>
    state lt()   { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, lt"); self.push(); transition 0 { _ -> done() } }
    state le()   { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, le"); self.push(); transition 0 { _ -> done() } }
    state gt()   { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, gt"); self.push(); transition 0 { _ -> done() } }
    state ge()   { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, ge"); self.push(); transition 0 { _ -> done() } }
    state eq()   { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, eq"); self.push(); transition 0 { _ -> done() } }
    state ne()   { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, ne"); self.push(); transition 0 { _ -> done() } }
    // bitwise / shift / modulo (match src/aarch64.rs; bitwise + shift carry no overflow, no trap)
    state rem()  { self.pops(); self.console.write_line("    cbz w1, Ltrap"); self.console.write_line("    sdiv w2, w0, w1"); self.console.write_line("    msub w0, w2, w1, w0"); self.push(); transition 0 { _ -> done() } }
    state band() { self.pops(); self.console.write_line("    and w0, w0, w1"); self.push(); transition 0 { _ -> done() } }
    state bor()  { self.pops(); self.console.write_line("    orr w0, w0, w1"); self.push(); transition 0 { _ -> done() } }
    state bxor() { self.pops(); self.console.write_line("    eor w0, w0, w1"); self.push(); transition 0 { _ -> done() } }
    state shl()  { self.pops(); self.console.write_line("    lsl w0, w0, w1"); self.push(); transition 0 { _ -> done() } }
    state shr()  { self.pops(); self.console.write_line("    asr w0, w0, w1"); self.push(); transition 0 { _ -> done() } }
    state done() { self.console.exit_process(0) }
}
