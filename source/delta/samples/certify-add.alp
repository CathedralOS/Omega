// CERTIFYING COMPUTATION — the Omega convergence in miniature. This Delta program
// reads two decimal numbers a and b, computes s = a + b, and EMITS A PROOF
// CERTIFICATE that a + b = s, which the trust anchor (the proof kernel) then
// independently verifies. The program does not ask to be trusted; it ships a proof.
//   printf '2 3' | certify-add            ->  (= (p (s (s z)) (s (s (s z)))) (s (s (s (s (s z)))))) (refl (s (s (s (s (s z))))))
//   printf '2 3' | certify-add | check.exe ->  accept   (proof kernel confirms 2+3 = 5)
// If the program ever computed s wrong, the emitted certificate would be REJECTED
// by the proof kernel -- so the trust anchor checks the computation, not the compiler.
// Naturals are emitted in the checker's unary form (s (s ... z)); + is the raw `p`.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    a: i32; b: i32; s: i32; uv: i32;
}
// emit a natural as the checker's unary literal: v copies of "(s ", then "z", then
// v copies of ")".
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
machine Main::main(&mut self) {
    self.n = 0; self.a = 0; self.b = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> pa() } }
    // parse a (digits 48..57)
    state pa()    { transition self.buf[self.pos] < 48 { true -> skipnd()  false -> paHi() } }
    state paHi()  { transition self.buf[self.pos] > 57 { true -> skipnd()  false -> paD() } }
    state paD()   { self.a = self.a * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pa() } }
    // skip non-digits to the next number (or end)
    state skipnd(){ transition self.pos < self.n { true -> snd()  false -> compute() } }
    state snd()   { transition self.buf[self.pos] < 48 { true -> snda()  false -> sndHi() } }
    state sndHi() { transition self.buf[self.pos] > 57 { true -> snda()  false -> pb() } }
    state snda()  { self.pos = self.pos + 1; transition 0 { _ -> skipnd() } }
    // parse b
    state pb()    { transition self.buf[self.pos] < 48 { true -> compute()  false -> pbHi() } }
    state pbHi()  { transition self.buf[self.pos] > 57 { true -> compute()  false -> pbD() } }
    state pbD()   { self.b = self.b * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pb() } }
    state compute(){ self.s = self.a + self.b; transition 0 { _ -> emit() } }
    // emit  (= (p A B) S) (refl S)
    state emit() {
        write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32); // "(= (p "
        self.emit_nat(self.a);
        write_byte(32);                                                                                   // " "
        self.emit_nat(self.b);
        write_byte(41); write_byte(32);                                                                   // ") "
        self.emit_nat(self.s);
        write_byte(41); write_byte(32); write_byte(40); write_byte(114); write_byte(101);
        write_byte(102); write_byte(108); write_byte(32);                                                 // ") (refl "
        self.emit_nat(self.s);
        write_byte(41);                                                                                   // ")"
        self.console.exit_process(0)
    }
}
