// CERTIFYING COMPUTATION over the PERMUTATION predicate -- extends the convergence keystone to Perm
// (Rel 779), the inductive predicate added to all three checkers for the Fundamental Theorem of
// Arithmetic. This Delta program reads two numbers a, b and EMITS A PROOF CERTIFICATE that the
// two-element list [a,b] is a permutation of [b,a], proved by the single adjacent transposition rule
// (permswap), which the trust anchor independently verifies.
//   printf '3 7' | certify-perm  ->  (Rel 779 (cons (s(s(s z))) (cons (s..7..z) nil)) (cons (s..7..z) (cons (s(s(s z))) nil))) (permswap (s(s(s z))) (s..7..z) nil)
//   printf '3 7' | certify-perm | check.exe  ->  accept   (proof kernel confirms [3,7] ~ [7,3])
// A wrong permutation claim (e.g. asserting [a,b] ~ [a,b] from this swap) is REJECTED. The self-hosted
// compiler builds this program, so the new Perm rules are exercised through the full compute+prove loop.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    a: i32; b: i32; uv: i32;
}
// emit a natural as the checker's unary literal: v copies of "(s ", then "z", then v copies of ")".
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
machine Main::next_num(&mut self) -> i32 {
    let v: i32 = 0;
    transition 0 { _ -> sk() }
    state sk()   { transition self.pos < self.n { true -> sk2()  false -> done() } }
    state sk2()  { transition self.buf[self.pos] < 48 { true -> adv()  false -> sk3() } }
    state sk3()  { transition self.buf[self.pos] > 57 { true -> adv()  false -> rdn() } }
    state adv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state rdn()  { transition self.pos < self.n { true -> rdn2()  false -> done() } }
    state rdn2() { transition self.buf[self.pos] < 48 { true -> done()  false -> rdn3() } }
    state rdn3() { transition self.buf[self.pos] > 57 { true -> done()  false -> acc() } }
    state acc()  { v = v * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> rdn() } }
    state done() { return v; }
}
// write the token "(cons " (open + cons + space)
machine Main::emit_cons(&mut self) {
    transition 0 { _ -> w() }
    state w() { write_byte(40); write_byte(99); write_byte(111); write_byte(110); write_byte(115); write_byte(32); }
}
// write the list  (cons X (cons Y nil))  given two already-known nats via the field h1,h2 selection
machine Main::emit_pair(&mut self, x: i32, y: i32) {
    transition 0 { _ -> e() }
    state e() {
        self.emit_cons();  self.emit_nat(x);  write_byte(32);
        self.emit_cons();  self.emit_nat(y);
        write_byte(32); write_byte(110); write_byte(105); write_byte(108);   // " nil"
        write_byte(41); write_byte(41);                                       // "))"
    }
}
machine Main::main(&mut self) {
    self.n = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; self.a = self.next_num(); self.b = self.next_num(); transition 0 { _ -> emit() } }
    state emit() {
        // goal:  (Rel 779 (cons a (cons b nil)) (cons b (cons a nil)))
        write_byte(40); write_byte(82); write_byte(101); write_byte(108); write_byte(32);   // "(Rel "
        write_byte(55); write_byte(55); write_byte(57); write_byte(32);                      // "779 "
        self.emit_pair(self.a, self.b); write_byte(32); self.emit_pair(self.b, self.a);
        write_byte(41); write_byte(32);                                                       // ") "
        // proof:  (permswap a b nil)
        write_byte(40); write_byte(112); write_byte(101); write_byte(114); write_byte(109);   // "(perm"
        write_byte(115); write_byte(119); write_byte(97); write_byte(112); write_byte(32);    // "swap "
        self.emit_nat(self.a); write_byte(32); self.emit_nat(self.b);
        write_byte(32); write_byte(110); write_byte(105); write_byte(108); write_byte(41);    // " nil)"
        self.console.exit_process(0)
    }
}
