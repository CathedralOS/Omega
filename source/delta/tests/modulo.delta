// The `%` (remainder) operator. delta previously had no `%` — programs hand-rolled
// it as `x - (x/10)*10` (see square.delta). Now `%` is a first-class binary operator at
// the same precedence as `*` and `/`, left-associative, and (like `/`) it TRAPS on a
// zero divisor. Each value is checked against its hand-computed result:
//   17 % 5 = 2   (17 = 3*5 + 2)
//   100 % 7 = 2  (100 = 14*7 + 2)
//   3 * 10 % 4   parses as (3*10) % 4 = 30 % 4 = 2   (precedence + left-assoc)
//   => 2*100 + 2*10 + 2 = 222
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: i32 = 17 % 5;
    let b: i32 = 100 % 7;
    let c: i32 = 3 * 10 % 4;
    self.console.exit_process(a * 100 + b * 10 + c)
}
