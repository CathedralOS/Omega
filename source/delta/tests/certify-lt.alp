// CERTIFYING COMPUTATION, second form — a NON-TRIVIAL proof. Where certify-add ships
// an equality proved by refl, this program ships an EXISTENTIAL WITNESS. It reads two
// numbers a < b, computes the witness w = b - a - 1, and emits a proof certificate of
//   a < b   ==   exists k. a + (k+1) = b
// namely  (Exists (= (p A (s (v 0))) B)) (wit (= (p A (s (v 0))) B) W (refl B)).
// The trust anchor checks that a + (w+1) really reduces to b -- so the program proves
// an ORDERING fact, the shape every array-bounds / safety VC reduces to, not just an
// arithmetic identity.
//   printf '2 5' | certify-lt | check.exe   ->  accept    (proof kernel confirms 2 < 5, witness 2)
// Contract: a < b. Naturals are the checker's unary form; + is raw `p`; (v 0) is the
// bound variable k under the existential.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    a: i32; b: i32; w: i32; uv: i32;
}
// a natural in the checker's unary literal form: v copies of "(s ", "z", v copies ")".
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// the proposition body  (= (p X (s (v 0))) Y)  -- shared by the Exists and the wit.
machine Main::emit_body(&mut self, x: i32, y: i32) {
    write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32); // "(= (p "
    self.emit_nat(x);
    write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40);                 // " (s (v
    write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(41); write_byte(32); // " 0))) "
    self.emit_nat(y);
    write_byte(41);                                                                                   // ")"
}
machine Main::main(&mut self) {
    self.n = 0; self.a = 0; self.b = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> pa() } }
    state pa()    { transition self.buf[self.pos] < 48 { true -> skipnd()  false -> paHi() } }
    state paHi()  { transition self.buf[self.pos] > 57 { true -> skipnd()  false -> paD() } }
    state paD()   { self.a = self.a * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pa() } }
    state skipnd(){ transition self.pos < self.n { true -> snd()  false -> compute() } }
    state snd()   { transition self.buf[self.pos] < 48 { true -> snda()  false -> sndHi() } }
    state sndHi() { transition self.buf[self.pos] > 57 { true -> snda()  false -> pb() } }
    state snda()  { self.pos = self.pos + 1; transition 0 { _ -> skipnd() } }
    state pb()    { transition self.buf[self.pos] < 48 { true -> compute()  false -> pbHi() } }
    state pbHi()  { transition self.buf[self.pos] > 57 { true -> compute()  false -> pbD() } }
    state pbD()   { self.b = self.b * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pb() } }
    // witness for a < b : w = b - a - 1, so a + (w+1) = b.
    state compute(){ self.w = self.b - self.a - 1; transition 0 { _ -> emit() } }
    // emit  (Exists BODY) (wit BODY W (refl B))
    state emit() {
        write_byte(40); write_byte(69); write_byte(120); write_byte(105); write_byte(115);
        write_byte(116); write_byte(115); write_byte(32);                         // "(Exists "
        self.emit_body(self.a, self.b);
        write_byte(41); write_byte(32);                                           // ") "
        write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32); // "(wit "
        self.emit_body(self.a, self.b);
        write_byte(32);                                                           // " "
        self.emit_nat(self.w);
        write_byte(32); write_byte(40); write_byte(114); write_byte(101);
        write_byte(102); write_byte(108); write_byte(32);                         // " (refl "
        self.emit_nat(self.b);
        write_byte(41); write_byte(41);                                           // "))"
        self.console.exit_process(0)
    }
}
