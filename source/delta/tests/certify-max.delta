// CERTIFYING COMPUTATION, a CORRECTNESS proof (not a safety one). Every prior certifier
// proves an access/operation is SAFE; this proves a computed RESULT meets its SPEC. The
// program reads a and b, computes m = max(a,b), and emits a proof certificate that m is
// genuinely the maximum:
//   a <= m   AND   b <= m   AND   (m = a OR m = b)
// i.e. (& (& (exists k. a+k=m) (exists k. b+k=m)) (or (= m a) (= m b))) proved by
// (pair (pair <a<=m> <b<=m>> <which one m equals>). The disjunct is inl when a>=b (m=a)
// and inr when a<b (m=b). The trust anchor checks the program's output satisfies the
// max specification -- certifying computation extended from safety to functional
// correctness.
//   printf '5 3' | certify-max | check.exe   ->  accept   (5 is max(5,3))
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    nums: [i32; 2]; ni: i32; cur: i32; m: i32; wa: i32; wb: i32; uv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// a <= m witness:  (wit (= (p av (v 0)) mv) wv (refl mv))
machine Main::emit_le(&mut self, av: i32, mv: i32, wv: i32) {
    write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32);                // "(wit "
    write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);  // "(= (p "
    self.emit_nat(av);
    write_byte(32); write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(32); // " (v 0)) "
    self.emit_nat(mv);
    write_byte(41); write_byte(32);                                                                   // ") "
    self.emit_nat(wv);
    write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32); // " (refl "
    self.emit_nat(mv);
    write_byte(41); write_byte(41);                                                                   // "))"
}
machine Main::main(&mut self) {
    self.n = 0; self.ni = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> nxt() } }
    state nxt()   { transition self.ni < 2 { true -> sk()  false -> compute() } }
    state sk()    { transition self.pos < self.n { true -> skc()  false -> compute() } }
    state skc()   { transition self.buf[self.pos] < 48 { true -> ad()  false -> skh() } }
    state skh()   { transition self.buf[self.pos] > 57 { true -> ad()  false -> pn() } }
    state ad()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state pn()    { self.cur = 0; transition 0 { _ -> pd() } }
    state pd()    { transition self.buf[self.pos] < 48 { true -> pv()  false -> pdh() } }
    state pdh()   { transition self.buf[self.pos] > 57 { true -> pv()  false -> pa() } }
    state pa()    { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pd() } }
    state pv()    { self.nums[self.ni] = self.cur; self.ni = self.ni + 1; transition 0 { _ -> nxt() } }
    // m = max(a,b)
    state compute(){ transition self.nums[0] < self.nums[1] { true -> mb()  false -> ma() } }
    state ma()     { self.m = self.nums[0]; self.wa = 0; self.wb = self.m - self.nums[1]; transition 0 { _ -> emit() } }
    state mb()     { self.m = self.nums[1]; self.wa = self.m - self.nums[0]; self.wb = 0; transition 0 { _ -> emit() } }
    state emit() {
        // goal:  (& (& (Exists a<=m) (Exists b<=m)) (or (= m a) (= m b)))
        write_byte(40); write_byte(38); write_byte(32); write_byte(40); write_byte(38); write_byte(32);
        write_byte(40); write_byte(69); write_byte(120); write_byte(105); write_byte(115); write_byte(116); write_byte(115); write_byte(32);
        write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);   // "(& (& (Exists (= (p "
        self.emit_nat(self.nums[0]);
        write_byte(32); write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(32); // " (v 0)) "
        self.emit_nat(self.m);
        write_byte(41); write_byte(41); write_byte(32);
        write_byte(40); write_byte(69); write_byte(120); write_byte(105); write_byte(115); write_byte(116); write_byte(115); write_byte(32);
        write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);   // ")) (Exists (= (p "
        self.emit_nat(self.nums[1]);
        write_byte(32); write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(32); // " (v 0)) "
        self.emit_nat(self.m);
        write_byte(41); write_byte(41); write_byte(41); write_byte(32);
        write_byte(40); write_byte(43); write_byte(32); write_byte(40); write_byte(61); write_byte(32);    // "))) (+ (= "
        self.emit_nat(self.m);
        write_byte(32);
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(61); write_byte(32);                   // ") (= "
        self.emit_nat(self.m);
        write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(41); write_byte(41); write_byte(32);                                   // "))) "
        // proof:  (pair (pair <a<=m> <b<=m>) <disj>)
        write_byte(40); write_byte(112); write_byte(97); write_byte(105); write_byte(114); write_byte(32);
        write_byte(40); write_byte(112); write_byte(97); write_byte(105); write_byte(114); write_byte(32); // "(pair (pair "
        self.emit_le(self.nums[0], self.m, self.wa);
        write_byte(32);
        self.emit_le(self.nums[1], self.m, self.wb);
        write_byte(41); write_byte(32);                                                                   // ") "
        transition self.nums[0] < self.nums[1] { true -> dInr()  false -> dInl() }
    }
    // m = a (a>=b): left disjunct, inl annotates the right type (= m b)
    state dInl() {
        write_byte(40); write_byte(105); write_byte(110); write_byte(108); write_byte(32); write_byte(40); write_byte(61); write_byte(32); // "(inl (= "
        self.emit_nat(self.m);
        write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32); // ") (refl "
        self.emit_nat(self.m);
        write_byte(41); write_byte(41); write_byte(41);                                                   // "))" + final ")"
        self.console.exit_process(0)
    }
    // m = b (a<b): right disjunct, inr annotates the left type (= m a)
    state dInr() {
        write_byte(40); write_byte(105); write_byte(110); write_byte(114); write_byte(32); write_byte(40); write_byte(61); write_byte(32); // "(inr (= "
        self.emit_nat(self.m);
        write_byte(32);
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32); // ") (refl "
        self.emit_nat(self.m);
        write_byte(41); write_byte(41); write_byte(41);
        self.console.exit_process(0)
    }
}
