// Bitwise operators: `&` (and), `|` (or), `^` (xor). They share ONE precedence level,
// looser than comparison and arithmetic, left-associative — use parens when mixing
// `&`/`|`/`^`. (`&` is unambiguous here: `&mut self` / `&[u8]` only appear in
// declaration position, never inside an expression.) Bitwise ops cannot overflow, so —
// unlike +/-/* and / % — they never trap. Each result is hand-checked:
//   12 & 10 = 8    (1100 & 1010 = 1000)
//   12 | 10 = 14   (1100 | 1010 = 1110)
//   12 ^ 10 = 6    (1100 ^ 1010 = 0110)
//   1 + 2 & 3 = 3  (parses as (1+2) & 3 = 3 & 3 — bitwise looser than `+`)
//   => 8 + 14*3 + 6*7 + 3*11 = 125
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: i32 = 12 & 10;
    let b: i32 = 12 | 10;
    let c: i32 = 12 ^ 10;
    let d: i32 = 1 + 2 & 3;
    self.console.exit_process(a + b * 3 + c * 7 + d * 11)
}
