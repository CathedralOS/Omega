// Slice 7a: data structs + mutable self fields. The entry machine's `self` is a
// frame-resident, zero-initialized Main instance; field reads/writes go through a
// self-pointer. Sums 1..=5 into a self field, then exits with the total (15).
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_line(text: &[u8] in Utf8);
}
data Main {
    console: Console; // a capability (zero runtime storage)
    i: i32;
    total: i32;
}

machine Main::main(&mut self) {
    self.i = 1;
    self.total = 0;
    transition 0 { _ -> step() }

    state step() {
        transition self.i <= 5 {
            true  -> accumulate()
            false -> done()
        }
    }
    state accumulate() {
        self.total = self.total + self.i;
        self.i = self.i + 1;
        transition 0 { _ -> step() }
    }
    state done() {
        self.console.exit_process(self.total)
    }
}
