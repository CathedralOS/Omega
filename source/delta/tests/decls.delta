// Lists the names declared in .delta source — the first parser-flavored tool
// (keyword recognition + structure extraction), written in delta. Scans tokens
// (skipping whitespace and // comments), recognizes the `machine` and `data`
// keywords by direct byte comparison, and emits the next identifier (the declared
// name), one per line. .delta has no general string constants, so each keyword is
// matched byte-by-byte rather than against a string-table entry -- the same
// recognition a parser does at each grammar decision point.
//   printf 'data Pt{x:i32;} machine max(a,b){}' | decls   -> Pt / max
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 1024]; n: i32; pos: i32; c: i32; start: i32; w: i32; expect: i32; ei: i32;
}
machine Main::is_word(&mut self, c: i32) -> i32 {
    transition c == 95 { true -> yes()  false -> w1() }
    state w1() { transition c < 48  { true -> no()  false -> w2() } }
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }
    state w3() { transition c < 65  { true -> no()  false -> w4() } }
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }
    state w5() { transition c < 97  { true -> no()  false -> w6() } }
    state w6() { transition c <= 122 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
// is buf[s..e] the keyword "machine"? (m a c h i n e = 109 97 99 104 105 110 101)
machine Main::is_machine(&mut self, s: i32, e: i32) -> i32 {
    transition e - s == 7 { true -> k0()  false -> kno() }
    state k0() { transition self.buf[s]     == 109 { true -> k1()  false -> kno() } }
    state k1() { transition self.buf[s + 1] == 97  { true -> k2()  false -> kno() } }
    state k2() { transition self.buf[s + 2] == 99  { true -> k3()  false -> kno() } }
    state k3() { transition self.buf[s + 3] == 104 { true -> k4()  false -> kno() } }
    state k4() { transition self.buf[s + 4] == 105 { true -> k5()  false -> kno() } }
    state k5() { transition self.buf[s + 5] == 110 { true -> k6()  false -> kno() } }
    state k6() { transition self.buf[s + 6] == 101 { true -> kyes() false -> kno() } }
    state kyes() { return 1; }
    state kno()  { return 0; }
}
// is buf[s..e] the keyword "data"? (d a t a = 100 97 116 97)
machine Main::is_data(&mut self, s: i32, e: i32) -> i32 {
    transition e - s == 4 { true -> j0()  false -> jno() }
    state j0() { transition self.buf[s]     == 100 { true -> j1()  false -> jno() } }
    state j1() { transition self.buf[s + 1] == 97  { true -> j2()  false -> jno() } }
    state j2() { transition self.buf[s + 2] == 116 { true -> j3()  false -> jno() } }
    state j3() { transition self.buf[s + 3] == 97  { true -> jyes() false -> jno() } }
    state jyes() { return 1; }
    state jno()  { return 0; }
}
machine Main::emit_range(&mut self, a: i32, b: i32) {
    self.ei = a;
    transition 0 { _ -> eloop() }
    state eloop() { transition self.ei < b { true -> ew()  false -> enl() } }
    state ew()    { write_byte(self.buf[self.ei]); self.ei = self.ei + 1; transition 0 { _ -> eloop() } }
    state enl()   { write_byte(10); }
}
machine Main::main(&mut self) {
    self.n = 0; self.expect = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }

    state scan()     { self.pos = 0; transition 0 { _ -> skipws() } }
    state skipws()   { transition self.pos < self.n { true -> wsck()  false -> fin() } }
    state wsck()     { transition self.buf[self.pos] <= 32 { true -> wsadv()  false -> commck() } }
    state wsadv()    { self.pos = self.pos + 1; transition 0 { _ -> skipws() } }
    state commck()   { transition self.buf[self.pos] == 47 { true -> commck2() false -> begin() } }
    state commck2()  { transition self.buf[self.pos + 1] == 47 { true -> skipcomm() false -> begin() } }
    state skipcomm() { transition self.pos < self.n { true -> commnl()  false -> fin() } }
    state commnl()   { transition self.buf[self.pos] == 10 { true -> wsadv()  false -> commadv() } }
    state commadv()  { self.pos = self.pos + 1; transition 0 { _ -> skipcomm() } }
    state begin() {
        self.start = self.pos;
        self.w = self.is_word(self.buf[self.pos]);
        transition self.w == 1 { true -> wordrun()  false -> punct() }
    }
    state wordrun()  { transition self.pos < self.n { true -> wrck()  false -> classify() } }
    state wrck() {
        self.w = self.is_word(self.buf[self.pos]);
        transition self.w == 1 { true -> wradv()  false -> classify() }
    }
    state wradv()    { self.pos = self.pos + 1; transition 0 { _ -> wordrun() } }
    state punct()    { self.pos = self.pos + 1; transition 0 { _ -> skipws() } }
    // a word token at buf[start..pos]: is it `machine`, or (if expected) a name?
    state classify() {
        self.w = self.is_machine(self.start, self.pos);
        transition self.w == 1 { true -> setexp()  false -> chkdata() }
    }
    state chkdata() {
        self.w = self.is_data(self.start, self.pos);
        transition self.w == 1 { true -> setexp()  false -> maybename() }
    }
    state setexp()    { self.expect = 1; transition 0 { _ -> skipws() } }
    state maybename() { transition self.expect == 1 { true -> emitname()  false -> skipws() } }
    state emitname()  { self.emit_range(self.start, self.pos); self.expect = 0; transition 0 { _ -> skipws() } }
    state fin()       { self.console.exit_process(0) }
}
