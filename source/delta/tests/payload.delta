// Payload variants — Omega's `case` with data. A `case Circle(r: i32)` carries one i32
// payload, laid out at the enum value's offset + 8 (the tag is at + 0). Construction
// `self.sh = Shape::Square(36)` desugars to writing the tag then the payload; a match arm
// `Shape::Square { s } -> got(s + 6)` binds `s` to that payload (a read of the subject
// field + 8) and passes it as a state argument — reusing state parameters. Dispatch is by
// tag, with exhaustiveness already enforced. (Multi-field payloads and mixed field+case
// data are later slices.) Here Square(36) -> got(36 + 6) -> exit 42.
boundary trait Console { machine exit_process(return_code: i32); }
data Shape { case Circle(r: i32); case Square(s: i32); }
data Main { console: Console; sh: Shape; }
machine Main::main(&mut self) {
    self.sh = Shape::Square(36);
    transition self.sh {
        Shape::Circle { r } -> got(r)
        Shape::Square { s } -> got(s + 6)
    }
    state got(v: i32) {
        self.console.exit_process(v)
    }
}
