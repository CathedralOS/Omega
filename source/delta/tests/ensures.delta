// `ensures <cond>` — Omega's postcondition contract, declared on a machine signature.
// It is checked at EVERY return site, with the special local `result` bound to the value
// being returned; a false postcondition TRAPS (like assert / requires / overflow). The
// compiler rewrites each `return e` into `{ result = e; assert <cond>...; return result }`,
// so even a recursive machine re-checks its contract on every call. Combined with `requires`
// (preconditions), this is the declarative, dynamic half of contracts — the obligation lives
// on the signature, not in the body. (The static, proof-carrying half is certify-*.delta.)
// Here abs_inc(41) returns 42, and the postcondition result > n holds.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine abs_inc(n: i32) -> i32 requires n >= 0 ensures result > n {
    return n + 1;
}
machine Main::main(&mut self) {
    let r: i32 = abs_inc(41);
    self.console.exit_process(r)
}
