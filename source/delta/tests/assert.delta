// `assert <cond>;` — a runtime contract. The condition is evaluated and, like overflow /
// divide-by-zero / out-of-bounds indexing, a FALSE assertion TRAPS (SIGILL). This is the
// program enforces at runtime, in keeping with Delta's checked-execution rule. Here every
// assertion holds, so the machine runs to exit 42.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: i32 = 6;
    let b: i32 = 7;
    assert a > 0;
    assert b > 0;
    let p: i32 = a * b;
    assert p == 42;
    assert p > a;
    self.console.exit_process(p)
}
