// CERTIFYING COMPUTATION: a COMPUTED RESULT over a VARIABLE-LENGTH input. certify-max proves max(a,b) for
// two numbers; this reads a list of ANY length, COMPUTES its maximum M, and certifies M is THE maximum --
// both that M bounds every element AND that M actually occurs in the list (so it is achieved, not merely an
// upper bound). It composes the two variable-length proof shapes: a Mem chain (M is a member) and a
// conjunction of order witnesses (M >= each element):
//   goal   (& (Rel 777 M list) (& (Exists a0<=M) (& (Exists a1<=M) ... )))
//   proof  (pair <memtail..memhead M> (pair <a0<=M wit> (pair <a1<=M wit> ... )))
// So the trust anchor confirms a value the program COMPUTED is correct against its full specification, over
// an arbitrarily long input -- functional correctness of an algorithm whose proof scales with the data.
//   printf '9 4 5 1' | certify-max-any | check.exe  ->  accept   (max [9 4 5 1] = 9, bounds all + is present)
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    vals: [i32; 16]; vn: i32; cur: i32; inb: i32; uv: i32;
    m: i32; mp: i32; gi: i32; cp: i32; mi: i32; ci: i32; li: i32; lc: i32;  // m=max, mp=its index
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// emit the cons-list of vals[lo .. hi-1]
machine Main::emit_clist(&mut self, lo: i32, hi: i32) {
    self.li = lo;
    transition 0 { _ -> clw() }
    state clw()    { transition self.li < hi { true -> clc()  false -> clnil() } }
    state clc()    { write_line("(cons"); self.emit_nat(self.vals[self.li]); self.li = self.li + 1; transition 0 { _ -> clw() } }
    state clnil()  { write_line("nil"); self.lc = lo; transition 0 { _ -> clcl() } }
    state clcl()   { transition self.lc < hi { true -> clcw()  false -> cldone() } }
    state clcw()   { write_byte(41); self.lc = self.lc + 1; transition 0 { _ -> clcl() } }
    state cldone() {}
}
// the i-th upper-bound prop: (Exists (= (p vals[i] (v 0)) M))   -- vals[i] <= M
machine Main::emit_le(&mut self, i: i32) {
    write_line("(Exists (= (p"); self.emit_nat(self.vals[i]); write_line("(v 0))"); self.emit_nat(self.m); write_line("))");
}
// the i-th upper-bound witness: (wit (= (p vals[i] (v 0)) M) <M-vals[i]> (refl M))
machine Main::emit_lewit(&mut self, i: i32) {
    write_line("(wit (= (p"); self.emit_nat(self.vals[i]); write_line("(v 0))"); self.emit_nat(self.m);
    write_line(")"); self.emit_nat(self.m - self.vals[i]); write_line("(refl"); self.emit_nat(self.m); write_line("))");
}
machine Main::main(&mut self) {
    self.n = 0; self.vn = 0; self.cur = 0; self.inb = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> pp()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state pp()    { self.pos = 0; transition 0 { _ -> pscan() } }
    state pscan() { transition self.pos < self.n { true -> pc()  false -> pend() } }
    state pc()    { transition self.buf[self.pos] < 48 { true -> psep()  false -> pcHi() } }
    state pcHi()  { transition self.buf[self.pos] > 57 { true -> psep()  false -> pdig() } }
    state pdig()  { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.inb = 1; self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state psep()  { transition self.inb == 1 { true -> pstore()  false -> padv() } }
    state pstore(){ self.vals[self.vn] = self.cur; self.vn = self.vn + 1; self.cur = 0; self.inb = 0; transition 0 { _ -> padv() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state pend()  { transition self.inb == 1 { true -> pendS()  false -> cmax() } }
    state pendS() { self.vals[self.vn] = self.cur; self.vn = self.vn + 1; transition 0 { _ -> cmax() } }
    // compute m = max, mp = its first index
    state cmax()  { self.m = self.vals[0]; self.mp = 0; self.gi = 1; transition 0 { _ -> cml() } }
    state cml()   { transition self.gi < self.vn { true -> cmc()  false -> emit() } }
    state cmc()   { transition self.vals[self.gi] > self.m { true -> cms()  false -> cma() } }
    state cms()   { self.m = self.vals[self.gi]; self.mp = self.gi; transition 0 { _ -> cma() } }
    state cma()   { self.gi = self.gi + 1; transition 0 { _ -> cml() } }
    // GOAL: (& (Rel 777 M list) (& le0 (& le1 ... le_{vn-1})))
    state emit()  {
        write_byte(40); write_byte(38); write_byte(32);                                  // "(& "
        write_line("(Rel 777"); self.emit_nat(self.m); self.emit_clist(0, self.vn); write_line(")");
        self.gi = 0; transition 0 { _ -> gloop() }
    }
    state gloop() { transition self.gi < self.vn - 1 { true -> gw()  false -> glast() } }
    state gw()    { write_byte(40); write_byte(38); write_byte(32); self.emit_le(self.gi); write_byte(32); self.gi = self.gi + 1; transition 0 { _ -> gloop() } }
    state glast() { self.emit_le(self.vn - 1); transition 0 { _ -> gclose() } }
    state gclose(){ self.cp = 0; transition 0 { _ -> gcloop() } }
    state gcloop(){ transition self.cp < self.vn - 1 { true -> gcw()  false -> gdone() } }
    state gcw()   { write_byte(41); self.cp = self.cp + 1; transition 0 { _ -> gcloop() } }
    state gdone() { write_byte(41); write_byte(32); transition 0 { _ -> proof() } }       // close outer & + space
    // PROOF: (pair <Mem proof> (pair w0 (pair w1 ... w_{vn-1})))
    state proof() { write_byte(40); write_byte(112); write_byte(97); write_byte(105); write_byte(114); write_byte(32); self.mi = 0; transition 0 { _ -> mloop() } }
    state mloop() { transition self.mi < self.mp { true -> mw()  false -> mhead() } }
    state mw()    { write_line("(memtail"); self.emit_nat(self.vals[self.mi]); self.mi = self.mi + 1; transition 0 { _ -> mloop() } }
    state mhead() { write_line("(memhead"); self.emit_nat(self.m); self.emit_clist(self.mp + 1, self.vn); write_line(")"); self.ci = 0; transition 0 { _ -> mclose() } }
    state mclose(){ transition self.ci < self.mp { true -> mcw()  false -> pinner() } }
    state mcw()   { write_byte(41); self.ci = self.ci + 1; transition 0 { _ -> mclose() } }
    state pinner(){ write_byte(32); self.gi = 0; transition 0 { _ -> ploop() } }
    state ploop() { transition self.gi < self.vn - 1 { true -> pw()  false -> plast() } }
    state pw()    { write_byte(40); write_byte(112); write_byte(97); write_byte(105); write_byte(114); write_byte(32); self.emit_lewit(self.gi); write_byte(32); self.gi = self.gi + 1; transition 0 { _ -> ploop() } }
    state plast() { self.emit_lewit(self.vn - 1); transition 0 { _ -> pclose() } }
    state pclose(){ self.cp = 0; transition 0 { _ -> pcloop() } }
    state pcloop(){ transition self.cp < self.vn - 1 { true -> pcw()  false -> pdone() } }
    state pcw()   { write_byte(41); self.cp = self.cp + 1; transition 0 { _ -> pcloop() } }
    state pdone() { write_byte(41); self.console.exit_process(0) }                         // close outer pair
}
