// Compiler-host regression: checked decimal scanning must admit both signed
// i32 endpoints without overflowing on the ASCII byte before subtracting '0'.
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
    maximum: i32;
    minimum: i32;
}

machine Main::main(&mut self) {
    self.maximum = 2147483647;
    self.minimum = 0 - 2147483647 - 1;
    transition self.maximum + self.minimum == 0 - 1 {
        true -> passed()
        _ -> failed()
    }
    state passed() { self.console.exit_process(0) }
    state failed() { self.console.exit_process(1) }
}
