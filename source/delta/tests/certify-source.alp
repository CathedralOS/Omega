// CERTIFYING COMPILER FRONTEND — source in, safety proof out. The prior certifiers
// take obligations spelled out; this one reads a tiny SOURCE language, RECOGNISES its
// keywords, RESOLVES each access against the declared array, GENERATES the safety
// verification conditions, and emits a single proof certificate of them all:
//   arr M N    -- declare the current array as M-by-N
//   get I J    -- read arr[I][J];  generates the bounds VC  I*N + J < M*N
//   div D      -- divide by D;      generates the nonzero VC  0 < D
//   band K J   -- a bounded loop "for i in 0..K { arr[i][J] }"; UNROLLS to K bounds
//                 VCs (one per iteration) -- the usual source of array accesses
// The access `get I J` does NOT carry the array size -- the frontend binds it from the
// preceding `arr` (context resolution), then computes the VC. So a compiler turns code
// into a machine-checked proof that the code is memory- and arithmetic-safe.
//   printf 'arr 4 5  get 2 3  div 7  get 1 ... ' | certify-source | check.exe -> accept
// The frontend ANALYSES safety itself: a get out of range or a div by zero is REJECTED
// with an "unsafe" diagnostic and a nonzero exit -- only code it accepts gets a proof
// (which the trust anchor then independently re-checks). Obligations held 5-wide
// [type,a,b,c,d]: type 0 bounds (i n j m), type 1 nonzero (x).
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 200]; n: i32; pos: i32; c: i32; start: i32; kw: i32;
    obs: [i32; 80]; K: i32; need: i32; rc: i32; cur: i32; si: i32; rd: [i32; 2];
    curM: i32; curN: i32; bad: i32; lhs: i32; rhs: i32; ii: i32;
    gi: i32; cp: i32; w: i32; uv: i32; base: i32;
}
// ---- keyword recognisers (byte-by-byte, like a real lexer's decision points) ----
machine Main::is_arr(&mut self, s: i32, e: i32) -> i32 {       // "arr" = 97 114 114
    transition e - s == 3 { true -> a0()  false -> ano() }
    state a0() { transition self.buf[s]     == 97  { true -> a1()  false -> ano() } }
    state a1() { transition self.buf[s + 1] == 114 { true -> a2()  false -> ano() } }
    state a2() { transition self.buf[s + 2] == 114 { true -> ay()  false -> ano() } }
    state ay() { return 1; }  state ano() { return 0; }
}
machine Main::is_get(&mut self, s: i32, e: i32) -> i32 {       // "get" = 103 101 116
    transition e - s == 3 { true -> g0()  false -> gno() }
    state g0() { transition self.buf[s]     == 103 { true -> g1()  false -> gno() } }
    state g1() { transition self.buf[s + 1] == 101 { true -> g2()  false -> gno() } }
    state g2() { transition self.buf[s + 2] == 116 { true -> gy()  false -> gno() } }
    state gy() { return 1; }  state gno() { return 0; }
}
machine Main::is_div(&mut self, s: i32, e: i32) -> i32 {       // "div" = 100 105 118
    transition e - s == 3 { true -> d0()  false -> dno() }
    state d0() { transition self.buf[s]     == 100 { true -> d1()  false -> dno() } }
    state d1() { transition self.buf[s + 1] == 105 { true -> d2()  false -> dno() } }
    state d2() { transition self.buf[s + 2] == 118 { true -> dy()  false -> dno() } }
    state dy() { return 1; }  state dno() { return 0; }
}
machine Main::is_band(&mut self, s: i32, e: i32) -> i32 {      // "band" = 98 97 110 100
    transition e - s == 4 { true -> b0()  false -> bno() }
    state b0() { transition self.buf[s]     == 98  { true -> b1()  false -> bno() } }
    state b1() { transition self.buf[s + 1] == 97  { true -> b2()  false -> bno() } }
    state b2() { transition self.buf[s + 2] == 110 { true -> b3()  false -> bno() } }
    state b3() { transition self.buf[s + 3] == 100 { true -> by()  false -> bno() } }
    state by() { return 1; }  state bno() { return 0; }
}
// ---- emit machinery (a conjunction of mixed safety conjuncts) ----
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
machine Main::emit_eqbody(&mut self, base: i32) {     // (= (p (p (m I N) J) (s (v 0))) (m M N))
    write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);
    write_byte(40); write_byte(112); write_byte(32); write_byte(40); write_byte(109); write_byte(32);
    self.emit_nat(self.obs[base + 1]);
    write_byte(32);
    self.emit_nat(self.obs[base + 2]);
    write_byte(41); write_byte(32);
    self.emit_nat(self.obs[base + 3]);
    write_byte(41); write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40);
    write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(41);
    write_byte(32); write_byte(40); write_byte(109); write_byte(32);
    self.emit_nat(self.obs[base + 4]);
    write_byte(32);
    self.emit_nat(self.obs[base + 2]);
    write_byte(41); write_byte(41);
}
machine Main::emit_nzbody(&mut self, base: i32) {     // (= (p z (s (v 0))) X)
    write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);
    write_byte(122); write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40);
    write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(41); write_byte(32);
    self.emit_nat(self.obs[base + 1]);
    write_byte(41);
}
machine Main::emit_bound(&mut self, base: i32) {
    write_byte(40); write_byte(69); write_byte(120); write_byte(105); write_byte(115);
    write_byte(116); write_byte(115); write_byte(32);
    self.emit_eqbody(base);
    write_byte(41);
}
machine Main::emit_nonzero(&mut self, base: i32) {
    write_byte(40); write_byte(69); write_byte(120); write_byte(105); write_byte(115);
    write_byte(116); write_byte(115); write_byte(32);
    self.emit_nzbody(base);
    write_byte(41);
}
machine Main::emit_bound_pf(&mut self, base: i32) {
    write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32);
    self.emit_eqbody(base);
    write_byte(32);
    self.w = self.obs[base + 4] * self.obs[base + 2] - (self.obs[base + 1] * self.obs[base + 2] + self.obs[base + 3]) - 1;
    self.emit_nat(self.w);
    write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102);
    write_byte(108); write_byte(32); write_byte(40); write_byte(109); write_byte(32);
    self.emit_nat(self.obs[base + 4]);
    write_byte(32);
    self.emit_nat(self.obs[base + 2]);
    write_byte(41); write_byte(41); write_byte(41);
}
machine Main::emit_nonzero_pf(&mut self, base: i32) {
    write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32);
    self.emit_nzbody(base);
    write_byte(32);
    self.w = self.obs[base + 1] - 1;
    self.emit_nat(self.w);
    write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102);
    write_byte(108); write_byte(32);
    self.emit_nat(self.obs[base + 1]);
    write_byte(41); write_byte(41);
}
machine Main::main(&mut self) {
    self.n = 0; self.K = 0; self.curM = 0; self.curN = 0; self.bad = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> setpos()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    // ---- FRONTEND: scan keywords, read operands, GENERATE obligations ----
    state setpos(){ self.pos = 0; transition 0 { _ -> tscan() } }
    state tscan() { transition self.pos < self.n { true -> tws()  false -> compute() } }
    state tws()   { transition self.buf[self.pos] <= 32 { true -> twadv()  false -> word() } }
    state twadv() { self.pos = self.pos + 1; transition 0 { _ -> tscan() } }
    state word()  { self.start = self.pos; transition 0 { _ -> wrun() } }
    state wrun()  { transition self.pos < self.n { true -> wrck()  false -> wclass() } }
    state wrck()  { transition self.buf[self.pos] < 97 { true -> wclass()  false -> wrck2() } }
    state wrck2() { transition self.buf[self.pos] > 122 { true -> wclass()  false -> wadv() } }
    state wadv()  { self.pos = self.pos + 1; transition 0 { _ -> wrun() } }
    state wclass(){ self.w = self.is_arr(self.start, self.pos); transition self.w == 1 { true -> kwArr()  false -> ckGet() } }
    state ckGet() { self.w = self.is_get(self.start, self.pos); transition self.w == 1 { true -> kwGet()  false -> ckDiv() } }
    state ckDiv() { self.w = self.is_div(self.start, self.pos); transition self.w == 1 { true -> kwDiv()  false -> ckBand() } }
    state ckBand(){ self.w = self.is_band(self.start, self.pos); transition self.w == 1 { true -> kwBand()  false -> tscan() } } // unknown word -> skip
    state kwArr() { self.kw = 0; self.need = 2; self.rc = 0; transition 0 { _ -> rloop() } }
    state kwGet() { self.kw = 1; self.need = 2; self.rc = 0; transition 0 { _ -> rloop() } }
    state kwDiv() { self.kw = 2; self.need = 1; self.rc = 0; transition 0 { _ -> rloop() } }
    state kwBand(){ self.kw = 3; self.need = 2; self.rc = 0; transition 0 { _ -> rloop() } }
    // read `need` operands into rd[]
    state rloop() { transition self.rc < self.need { true -> rsk()  false -> assemble() } }
    state rsk()   { transition self.pos < self.n { true -> rsk2()  false -> rzero() } }
    state rsk2()  { transition self.buf[self.pos] < 48 { true -> radv()  false -> rsk3() } }
    state rsk3()  { transition self.buf[self.pos] > 57 { true -> radv()  false -> rp() } }
    state radv()  { self.pos = self.pos + 1; transition 0 { _ -> rsk() } }
    state rzero() { self.rd[self.rc] = 0; self.rc = self.rc + 1; transition 0 { _ -> rloop() } }
    state rp()    { self.cur = 0; transition 0 { _ -> rdd() } }
    state rdd()   { transition self.buf[self.pos] < 48 { true -> rsv()  false -> rdHi() } }
    state rdHi()  { transition self.buf[self.pos] > 57 { true -> rsv()  false -> racc() } }
    state racc()  { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> rdd() } }
    state rsv()   { self.rd[self.rc] = self.cur; self.rc = self.rc + 1; transition 0 { _ -> rloop() } }
    // assemble the obligation (or update context) from the operands
    state assemble(){ transition self.kw == 0 { true -> asArr()  false -> asGD() } }
    state asArr() { self.curM = self.rd[0]; self.curN = self.rd[1]; transition 0 { _ -> tscan() } }
    state asGD()  { self.si = 5 * self.K; transition self.kw == 1 { true -> asGet()  false -> asGD2() } }
    state asGD2() { transition self.kw == 2 { true -> asDiv()  false -> asBand() } }
    state asGet() {
        self.obs[self.si] = 0;
        self.obs[self.si + 1] = self.rd[0];     // i = I
        self.obs[self.si + 2] = self.curN;      // n = declared N   (context binding)
        self.obs[self.si + 3] = self.rd[1];     // j = J
        self.obs[self.si + 4] = self.curM;      // m = declared M
        self.K = self.K + 1;
        // SAFETY ANALYSIS: the access is in range iff i*n + j < m*n
        self.lhs = self.rd[0] * self.curN + self.rd[1];
        self.rhs = self.curM * self.curN;
        transition self.lhs < self.rhs { true -> tscan()  false -> mark() }
    }
    state asDiv() {
        self.obs[self.si] = 1; self.obs[self.si + 1] = self.rd[0]; self.K = self.K + 1;
        // SAFETY ANALYSIS: the division is defined iff the divisor is nonzero
        transition self.rd[0] < 1 { true -> mark()  false -> tscan() }
    }
    state mark() { self.bad = 1; transition 0 { _ -> tscan() } }
    // UNROLL a bounded loop "for i in 0..K { arr[i][J] }" into K bounds obligations
    state asBand(){ self.ii = 0; transition 0 { _ -> bLoop() } }   // rd[0]=K, rd[1]=J
    state bLoop() { transition self.ii < self.rd[0] { true -> bGen()  false -> tscan() } }
    state bGen()  {
        self.si = 5 * self.K;
        self.obs[self.si] = 0;
        self.obs[self.si + 1] = self.ii;        // i = loop index
        self.obs[self.si + 2] = self.curN;
        self.obs[self.si + 3] = self.rd[1];     // j = J
        self.obs[self.si + 4] = self.curM;
        self.K = self.K + 1;
        self.lhs = self.ii * self.curN + self.rd[1];
        self.rhs = self.curM * self.curN;
        transition self.lhs < self.rhs { true -> bNext()  false -> bMark() }
    }
    state bMark() { self.bad = 1; transition 0 { _ -> bNext() } }
    state bNext() { self.ii = self.ii + 1; transition 0 { _ -> bLoop() } }
    // ---- emit: nested (& ...) goal, (pair ...) proof, conjuncts switch on tag ----
    // unsafe code is REJECTED with a diagnostic; only safe code gets a proof
    state compute(){ transition self.bad == 1 { true -> reject()  false -> emit0() } }
    state reject() {
        write_byte(117); write_byte(110); write_byte(115); write_byte(97);
        write_byte(102); write_byte(101); write_byte(10);                 // "unsafe\n"
        self.console.exit_process(1)
    }
    state emit0()  { self.gi = 0; transition 0 { _ -> gloop() } }
    state gloop()  { transition self.gi < self.K - 1 { true -> gw()  false -> glast() } }
    state gw()     { write_byte(40); write_byte(38); write_byte(32); self.base = 5 * self.gi; transition self.obs[self.base] == 0 { true -> gwB()  false -> gwN() } }
    state gwB()    { self.emit_bound(self.base); transition 0 { _ -> gwa() } }
    state gwN()    { self.emit_nonzero(self.base); transition 0 { _ -> gwa() } }
    state gwa()    { write_byte(32); self.gi = self.gi + 1; transition 0 { _ -> gloop() } }
    state glast()  { self.base = 5 * (self.K - 1); transition self.obs[self.base] == 0 { true -> glB()  false -> glN() } }
    state glB()    { self.emit_bound(self.base); transition 0 { _ -> gclose() } }
    state glN()    { self.emit_nonzero(self.base); transition 0 { _ -> gclose() } }
    state gclose() { self.cp = 0; transition 0 { _ -> gcl() } }
    state gcl()    { transition self.cp < self.K - 1 { true -> gcw()  false -> gdone() } }
    state gcw()    { write_byte(41); self.cp = self.cp + 1; transition 0 { _ -> gcl() } }
    state gdone()  { write_byte(32); transition 0 { _ -> proof() } }
    state proof()  { self.gi = 0; transition 0 { _ -> ploop() } }
    state ploop()  { transition self.gi < self.K - 1 { true -> pw()  false -> plast() } }
    state pw()     { write_byte(40); write_byte(112); write_byte(97); write_byte(105); write_byte(114); write_byte(32); self.base = 5 * self.gi; transition self.obs[self.base] == 0 { true -> pwB()  false -> pwN() } }
    state pwB()    { self.emit_bound_pf(self.base); transition 0 { _ -> pwa() } }
    state pwN()    { self.emit_nonzero_pf(self.base); transition 0 { _ -> pwa() } }
    state pwa()    { write_byte(32); self.gi = self.gi + 1; transition 0 { _ -> ploop() } }
    state plast()  { self.base = 5 * (self.K - 1); transition self.obs[self.base] == 0 { true -> plB()  false -> plN() } }
    state plB()    { self.emit_bound_pf(self.base); transition 0 { _ -> pclose() } }
    state plN()    { self.emit_nonzero_pf(self.base); transition 0 { _ -> pclose() } }
    state pclose() { self.cp = 0; transition 0 { _ -> pcl() } }
    state pcl()    { transition self.cp < self.K - 1 { true -> pcw()  false -> fin() } }
    state pcw()    { write_byte(41); self.cp = self.cp + 1; transition 0 { _ -> pcl() } }
    state fin()    { self.console.exit_process(0) }
}
