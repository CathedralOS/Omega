// An expression COMPILER written in delta — the interpreter->compiler step.
// Reads an arithmetic expression from stdin and emits ARM64 assembly (to stdout)
// that computes it on a stack and exits with the result. Same recursive-descent
// grammar as calc.alp, but each rule EMITS code instead of evaluating it:
//   factor -> load the number ; push        (or '(' expr ')', which recurses)
//   term   -> factor ; per * or / : factor ; pop;pop ; mul/sdiv ; push
//   expr   -> term   ; per + or - : term   ; pop;pop ; add/sub  ; push
// The epilogue pops the result into w0 and ret's, so the exit code is the result.
// Pipe its output through clang to get a runnable native program:
//   printf '2+3*4' | exprc | clang -arch arm64 -x assembler - -o p && ./p; echo $?  -> 14
// The emitted code is OVERFLOW-SAFE: +/- use adds/subs+b.vs, * checks smull vs its
// sign-extended low word, / guards the divisor with cbz — all branch to Ltrap: brk,
// the same trap-everything codegen the real aarch64 backend emits. So delta emits
// SAFE native code. This is the core of a self-hosting compiler.
//
// Full i32 literals: a number is parsed to an int, then loaded with movz/movk
// (#lo then #hi<<16, since ARM64 immediates are 16-bit and delta has no bit-ops,
// so lo = n - (n/65536)*65536 and hi = n/65536).
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_line(text: &[u8] in Utf8);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 256]; pos: i32; c: i32;
    num: i32; lo: i32; hi: i32;
    ev: i32; eq: i32; elen: i32; ei: i32; ebuf: [u8; 16];
}

// emit v as decimal digits, no surrounding whitespace/newline.
machine Main::emitnum(&mut self, v: i32) {
    self.ev = v;
    self.elen = 0;
    transition self.ev == 0 { true -> ezero()  false -> eext() }
    state ezero() { write_byte(48); transition 0 { _ -> edone() } }
    state eext() {
        self.eq = self.ev / 10;
        self.ebuf[self.elen] = 48 + (self.ev - self.eq * 10);
        self.ev = self.eq; self.elen = self.elen + 1;
        transition self.ev == 0 { true -> eout()  false -> eext() }
    }
    state eout() { self.ei = self.elen - 1; transition 0 { _ -> eem() } }
    state eem()  { transition self.ei < 0 { true -> edone()  false -> ee1() } }
    state ee1()  { write_byte(self.ebuf[self.ei]); self.ei = self.ei - 1; transition 0 { _ -> eem() } }
    state edone() {}
}
machine Main::emit_movz_pfx(&mut self) { // "movz w0, #"
    write_byte(109); write_byte(111); write_byte(118); write_byte(122);
    write_byte(32);  write_byte(119); write_byte(48);  write_byte(44);
    write_byte(32);  write_byte(35);
}
machine Main::emit_movk_pfx(&mut self) { // "movk w0, #"
    write_byte(109); write_byte(111); write_byte(118); write_byte(107);
    write_byte(32);  write_byte(119); write_byte(48);  write_byte(44);
    write_byte(32);  write_byte(35);
}
machine Main::emit_lsl16(&mut self) { // ", lsl #16"
    write_byte(44); write_byte(32); write_byte(108); write_byte(115);
    write_byte(108); write_byte(32); write_byte(35); write_byte(49); write_byte(54);
}

// factor = number | '(' expr ')'  -> emits code pushing its value on the stack
machine Main::factor(&mut self) {
    transition self.buf[self.pos] == 40 { true -> fparen()  false -> fnum() }
    state fparen() {
        self.pos = self.pos + 1; self.bitexpr(); self.pos = self.pos + 1;
        transition 0 { _ -> fend() }
    }
    state fnum() { self.num = 0; transition 0 { _ -> nloop() } }
    // a digit is 48..57; stop at anything below ('+' '-' '*' '/' '%' '&' '(' all < 48) OR above
    // ('|' '^' '<' '>' are > 57 -- without the upper bound they'd be absorbed into the number).
    state nloop() { transition self.buf[self.pos] < 48 { true -> nemit()  false -> nloop2() } }
    state nloop2() { transition self.buf[self.pos] > 57 { true -> nemit()  false -> ndig() } }
    state ndig() {
        self.num = self.num * 10 + (self.buf[self.pos] - 48);
        self.pos = self.pos + 1;
        transition 0 { _ -> nloop() }
    }
    state nemit() { // load the full i32 with movz #lo [/ movk #hi, lsl #16]
        self.hi = self.num / 65536;
        self.lo = self.num - self.hi * 65536;
        self.emit_movz_pfx(); self.emitnum(self.lo); write_byte(10);
        transition self.hi == 0 { true -> fpush()  false -> nhi() }
    }
    state nhi() {
        self.emit_movk_pfx(); self.emitnum(self.hi); self.emit_lsl16(); write_byte(10);
        transition 0 { _ -> fpush() }
    }
    state fpush() {
        self.console.write_line("str x0, [sp, #-16]!");
        transition 0 { _ -> fend() }
    }
    state fend()  {}
}
// term = factor (('*'|'/') factor)*
machine Main::term(&mut self) {
    self.factor();
    transition 0 { _ -> tloop() }
    state tloop() { transition self.buf[self.pos] == 42 { true -> tmul()  false -> tdivc() } }
    state tdivc() { transition self.buf[self.pos] == 47 { true -> tdiv()  false -> tmodc() } }
    state tmodc() { transition self.buf[self.pos] == 37 { true -> tmod()  false -> tend() } } // '%'
    state tmul()  {
        self.pos = self.pos + 1; self.factor();
        self.console.write_line("ldr x1, [sp], #16");
        self.console.write_line("ldr x0, [sp], #16");
        self.console.write_line("smull x0, w0, w1");
        self.console.write_line("sxtw x2, w0");
        self.console.write_line("cmp x0, x2");
        self.console.write_line("b.ne Ltrap");
        self.console.write_line("str x0, [sp, #-16]!");
        transition 0 { _ -> tloop() }
    }
    state tdiv()  {
        self.pos = self.pos + 1; self.factor();
        self.console.write_line("ldr x1, [sp], #16");
        self.console.write_line("ldr x0, [sp], #16");
        self.console.write_line("cbz w1, Ltrap");
        self.console.write_line("sdiv w0, w0, w1");
        self.console.write_line("str x0, [sp, #-16]!");
        transition 0 { _ -> tloop() }
    }
    state tmod()  {
        self.pos = self.pos + 1; self.factor();
        self.console.write_line("ldr x1, [sp], #16");
        self.console.write_line("ldr x0, [sp], #16");
        self.console.write_line("cbz w1, Ltrap");
        self.console.write_line("sdiv w2, w0, w1");
        self.console.write_line("msub w0, w2, w1, w0");
        self.console.write_line("str x0, [sp, #-16]!");
        transition 0 { _ -> tloop() }
    }
    state tend()  {}
}
// expr = term (('+'|'-') term)*
machine Main::expr(&mut self) {
    self.term();
    transition 0 { _ -> eloop() }
    state eloop() { transition self.buf[self.pos] == 43 { true -> eadd()  false -> esubc() } }
    state esubc() { transition self.buf[self.pos] == 45 { true -> esub()  false -> eend() } }
    state eadd()  {
        self.pos = self.pos + 1; self.term();
        self.console.write_line("ldr x1, [sp], #16");
        self.console.write_line("ldr x0, [sp], #16");
        self.console.write_line("adds w0, w0, w1");
        self.console.write_line("b.vs Ltrap");
        self.console.write_line("str x0, [sp, #-16]!");
        transition 0 { _ -> eloop() }
    }
    state esub()  {
        self.pos = self.pos + 1; self.term();
        self.console.write_line("ldr x1, [sp], #16");
        self.console.write_line("ldr x0, [sp], #16");
        self.console.write_line("subs w0, w0, w1");
        self.console.write_line("b.vs Ltrap");
        self.console.write_line("str x0, [sp, #-16]!");
        transition 0 { _ -> eloop() }
    }
    state eend()  {}
}
// bitexpr = expr (('&'|'|'|'^'|'<<'|'>>') expr)*  -- the lowest-precedence (outermost) level,
// matching delta's bit-op level 0. Single-char & | ^ advance pos by 1; two-char << >> by 2.
machine Main::bitexpr(&mut self) {
    self.expr();
    transition 0 { _ -> bloop() }
    state bloop() { transition self.buf[self.pos] == 38  { true -> band()  false -> b1() } }   // '&'
    state b1()    { transition self.buf[self.pos] == 124 { true -> bor()   false -> b2() } }   // '|'
    state b2()    { transition self.buf[self.pos] == 94  { true -> bxor()  false -> b3() } }   // '^'
    state b3()    { transition self.buf[self.pos] == 60  { true -> bshlc() false -> b4() } }   // '<'
    state b4()    { transition self.buf[self.pos] == 62  { true -> bshrc() false -> bend() } } // '>'
    state bshlc() { transition self.buf[self.pos + 1] == 60 { true -> bshl() false -> bend() } }
    state bshrc() { transition self.buf[self.pos + 1] == 62 { true -> bshr() false -> bend() } }
    state band()  { self.pos = self.pos + 1; self.expr(); self.console.write_line("ldr x1, [sp], #16"); self.console.write_line("ldr x0, [sp], #16"); self.console.write_line("and w0, w0, w1"); self.console.write_line("str x0, [sp, #-16]!"); transition 0 { _ -> bloop() } }
    state bor()   { self.pos = self.pos + 1; self.expr(); self.console.write_line("ldr x1, [sp], #16"); self.console.write_line("ldr x0, [sp], #16"); self.console.write_line("orr w0, w0, w1"); self.console.write_line("str x0, [sp, #-16]!"); transition 0 { _ -> bloop() } }
    state bxor()  { self.pos = self.pos + 1; self.expr(); self.console.write_line("ldr x1, [sp], #16"); self.console.write_line("ldr x0, [sp], #16"); self.console.write_line("eor w0, w0, w1"); self.console.write_line("str x0, [sp, #-16]!"); transition 0 { _ -> bloop() } }
    state bshl()  { self.pos = self.pos + 2; self.expr(); self.console.write_line("ldr x1, [sp], #16"); self.console.write_line("ldr x0, [sp], #16"); self.console.write_line("lsl w0, w0, w1"); self.console.write_line("str x0, [sp, #-16]!"); transition 0 { _ -> bloop() } }
    state bshr()  { self.pos = self.pos + 2; self.expr(); self.console.write_line("ldr x1, [sp], #16"); self.console.write_line("ldr x0, [sp], #16"); self.console.write_line("asr w0, w0, w1"); self.console.write_line("str x0, [sp, #-16]!"); transition 0 { _ -> bloop() } }
    state bend()  {}
}
machine Main::main(&mut self) {
    self.pos = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> pro()  false -> store() } }
    state store() { self.buf[self.pos] = self.c; self.pos = self.pos + 1; transition 0 { _ -> rd() } }
    state pro() {
        self.console.write_line(".global _main");
        self.console.write_line(".align 2");
        self.console.write_line("_main:");
        self.pos = 0;
        self.bitexpr();
        transition 0 { _ -> epi() }
    }
    state epi() {
        self.console.write_line("ldr x0, [sp], #16");
        self.console.write_line("ret");
        self.console.write_line("Ltrap:");
        self.console.write_line("brk #0x1");
        self.console.exit_process(0)
    }
}
