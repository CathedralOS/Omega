// CERTIFYING COMPUTATION — the division algorithm. Earlier certifiers prove a single
// witness (n | a = exists w. w*n = a); this one proves a CONJUNCTION — the defining
// property of integer division with remainder. It reads a and m (m > 0), computes the
// quotient q = a / m and remainder r = a % m (using the `/` and `%` operators), and emits
// a proof certificate of
//   a = q*m + r   AND   r < m
// namely (in the checker's raw form, where plus is `p`, mult is `m`, succ is `s`):
//   (& (= (p (m Q M) R) A) (Exists (= (p R (s (v 0))) M)))
//   (pair (refl A) (wit (= (p R (s (v 0))) M) C (refl M)))
// where C = m - r - 1 witnesses r < m  (r + (s C) = m). The trust anchor checks that
// q*m + r really reduces to a and that r + (m-r) reduces to m -- so the program proves
// the correctness of its OWN modular reduction, machine-checked end to end.
//   printf '17 5' | certify-mod | check.exe  ->  accept   (17 = 3*5 + 2, 2 < 5)
// A wrong q/r emits a certificate proof kernel REJECTS (verified: claiming 3*5+3=17 -> reject).
// Naturals are the checker's unary form; (v 0) is the bound variable under the existential.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    da: i32; dm: i32; dq: i32; dr: i32; dc: i32; uv: i32;
}
// emit a checker-unary nat  (s (s ... z))  for v
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
machine Main::main(&mut self) {
    self.n = 0; self.da = 0; self.dm = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> pa() } }
    // first number -> a
    state pa()    { transition self.buf[self.pos] < 48 { true -> skipnd()  false -> paHi() } }
    state paHi()  { transition self.buf[self.pos] > 57 { true -> skipnd()  false -> paD() } }
    state paD()   { self.da = self.da * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pa() } }
    state skipnd(){ transition self.pos < self.n { true -> snd()  false -> compute() } }
    state snd()   { transition self.buf[self.pos] < 48 { true -> snda()  false -> sndHi() } }
    state sndHi() { transition self.buf[self.pos] > 57 { true -> snda()  false -> pb() } }
    state snda()  { self.pos = self.pos + 1; transition 0 { _ -> skipnd() } }
    // second number -> m
    state pb()    { transition self.buf[self.pos] < 48 { true -> compute()  false -> pbHi() } }
    state pbHi()  { transition self.buf[self.pos] > 57 { true -> compute()  false -> pbD() } }
    state pbD()   { self.dm = self.dm * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pb() } }
    // q = a / m, r = a % m, c = m - r - 1  (witness of r < m: r + (s c) = m)
    state compute(){ self.dq = self.da / self.dm; self.dr = self.da % self.dm; self.dc = self.dm - self.dr - 1; transition 0 { _ -> emit() } }
    state emit() {
        // proposition: (& (= (+ (m Q M) R) A) (Exists (= (+ R (s (v 0))) M)))
        write_line("(& (= (p (m");
        self.emit_nat(self.dq); write_byte(32); self.emit_nat(self.dm);
        write_line(")");
        self.emit_nat(self.dr);
        write_line(")");
        self.emit_nat(self.da);
        write_line(") (Exists (= (p");
        self.emit_nat(self.dr);
        write_line("(s (v 0)))");
        self.emit_nat(self.dm);
        write_line(")))");
        // proof: (pair (refl A) (wit (= (+ R (s (v 0))) M) C (refl M)))
        write_line("(pair (refl");
        self.emit_nat(self.da);
        write_line(") (wit (= (p");
        self.emit_nat(self.dr);
        write_line("(s (v 0)))");
        self.emit_nat(self.dm);
        write_line(")");
        self.emit_nat(self.dc);
        write_line("(refl");
        self.emit_nat(self.dm);
        write_line(")))");
        self.console.exit_process(0)
    }
}
