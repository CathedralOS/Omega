// CERTIFYING COMPUTATION, a verified SORT (in miniature). The full correctness of a
// sort is two claims: the output is ORDERED, and it is a PERMUTATION of the input. This
// program reads a and b, outputs (x, y) = (min, max), and emits a proof certificate of
// BOTH halves:
//   x <= y                              -- ordered
//   (x=a & y=b) OR (x=b & y=a)          -- a permutation of {a, b}
// = (& (exists k. x+k=y) (or (& (= x a)(= y b)) (& (= x b)(= y a)))) proved by
//   (pair <x<=y> <which permutation>).  The disjunct is inl when a<=b (no swap) and inr
// when a>b (swapped). So the trust anchor confirms the program SORTED its input
// correctly -- functional correctness of an algorithm, not just an arithmetic result.
//   printf '5 3' | certify-sort2 | check.exe   ->  accept   ((3,5) is sorted(5,3))
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    nums: [i32; 2]; ni: i32; cur: i32; mn: i32; mx: i32; yx: i32; uv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
machine Main::main(&mut self) {
    self.n = 0; self.ni = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> nxt() } }
    state nxt()   { transition self.ni < 2 { true -> sk()  false -> compute() } }
    state sk()    { transition self.pos < self.n { true -> skc()  false -> compute() } }
    state skc()   { transition self.buf[self.pos] < 48 { true -> ad()  false -> skh() } }
    state skh()   { transition self.buf[self.pos] > 57 { true -> ad()  false -> pn() } }
    state ad()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state pn()    { self.cur = 0; transition 0 { _ -> pd() } }
    state pd()    { transition self.buf[self.pos] < 48 { true -> pv()  false -> pdh() } }
    state pdh()   { transition self.buf[self.pos] > 57 { true -> pv()  false -> pa() } }
    state pa()    { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pd() } }
    state pv()    { self.nums[self.ni] = self.cur; self.ni = self.ni + 1; transition 0 { _ -> nxt() } }
    // (x,y) = (min,max) of (a,b)
    state compute(){ transition self.nums[0] < self.nums[1] { true -> noswap()  false -> chkeq() } }
    state chkeq()  { transition self.nums[0] == self.nums[1] { true -> noswap()  false -> doswap() } } // a==b counts as no-swap (a<=b)
    state noswap() { self.mn = self.nums[0]; self.mx = self.nums[1]; self.yx = self.mx - self.mn; transition 0 { _ -> emit() } }
    state doswap() { self.mn = self.nums[1]; self.mx = self.nums[0]; self.yx = self.mx - self.mn; transition 0 { _ -> emit() } }
    state emit() {
        // goal:  (& (Exists (= (p x (v 0)) y)) (or (& (= x a)(= y b)) (& (= x b)(= y a))))
        write_byte(40); write_byte(38); write_byte(32); write_byte(40); write_byte(69); write_byte(120);
        write_byte(105); write_byte(115); write_byte(116); write_byte(115); write_byte(32); write_byte(40);
        write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);   // "(& (Exists (= (p "
        self.emit_nat(self.mn);
        write_byte(32); write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(32); // " (v 0)) "
        self.emit_nat(self.mx);
        write_byte(41); write_byte(41); write_byte(32); write_byte(40); write_byte(43); write_byte(32);
        write_byte(40); write_byte(38); write_byte(32); write_byte(40); write_byte(61); write_byte(32);   // ")) (+ (& (= "
        self.emit_nat(self.mn);
        write_byte(32);
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(61); write_byte(32);                  // ") (= "
        self.emit_nat(self.mx);
        write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(41); write_byte(32); write_byte(40); write_byte(38); write_byte(32); write_byte(40); write_byte(61); write_byte(32); // ")) (& (= "
        self.emit_nat(self.mn);
        write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(61); write_byte(32);                  // ") (= "
        self.emit_nat(self.mx);
        write_byte(32);
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(41); write_byte(41); write_byte(41); write_byte(32);                  // ")))) "
        // proof:  (pair <x<=y> <perm>)
        write_byte(40); write_byte(112); write_byte(97); write_byte(105); write_byte(114); write_byte(32);
        write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32); write_byte(40);
        write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);   // "(pair (wit (= (p "
        self.emit_nat(self.mn);
        write_byte(32); write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(32); // " (v 0)) "
        self.emit_nat(self.mx);
        write_byte(41); write_byte(32);                                                                  // ") "
        self.emit_nat(self.yx);
        write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32); // " (refl "
        self.emit_nat(self.mx);
        write_byte(41); write_byte(41); write_byte(32);                                                  // ")) "
        transition self.nums[0] < self.nums[1] { true -> dInl()  false -> dEq() }
    }
    state dEq() { transition self.nums[0] == self.nums[1] { true -> dInl()  false -> dInr() } }
    // a<=b (no swap): left permutation holds -> inl, annotates right type (& (= x b)(= y a))
    state dInl() {
        write_byte(40); write_byte(105); write_byte(110); write_byte(108); write_byte(32);   // "(inl "
        write_byte(40); write_byte(38); write_byte(32); write_byte(40); write_byte(61); write_byte(32);  // "(& (= "
        self.emit_nat(self.mn);
        write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(61); write_byte(32);                  // ") (= "
        self.emit_nat(self.mx);
        write_byte(32);
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(41); write_byte(32);                                                  // ")) "
        transition 0 { _ -> wit() }
    }
    // a>b (swapped): right permutation holds -> inr, annotates left type (& (= x a)(= y b))
    state dInr() {
        write_byte(40); write_byte(105); write_byte(110); write_byte(114); write_byte(32);   // "(inr "
        write_byte(40); write_byte(38); write_byte(32); write_byte(40); write_byte(61); write_byte(32);
        self.emit_nat(self.mn);
        write_byte(32);
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(61); write_byte(32);
        self.emit_nat(self.mx);
        write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(41); write_byte(32);
        transition 0 { _ -> wit() }
    }
    // (pair (refl x) (refl y))  then close inl/inr and the outer pair
    state wit() {
        write_byte(40); write_byte(112); write_byte(97); write_byte(105); write_byte(114); write_byte(32);
        write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32); // "(pair (refl "
        self.emit_nat(self.mn);
        write_byte(41); write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32); // ") (refl "
        self.emit_nat(self.mx);
        write_byte(41); write_byte(41); write_byte(41); write_byte(41);                                  // "))))"  close refl-pair, inl/inr, outer pair
        self.console.exit_process(0)
    }
}
