      (DeltaParameterListParseRejected UnexpectedEnd start)
      (DeltaParameterListParseRejected UnexpectedToken start))))

(def delta_statement_reject_at ((source Bytes) (cursor Int)) DeltaStatementParseOutcome
  (let start (delta_token_start source cursor)
