; First selected Gamma-authored Delta stage.
; Lowers finite nullary algebraic data and declaration-order exhaustive matches
; into ordinary scalar Gamma. Generated match binders use the reserved __m prefix.

(def fail () Int
  (read (input)))

(def is_space ((byte Int)) Int
  (lt byte 33))

(def skip_comment ((index Int)) Int
  (if (eq index (input))
    index
    (let byte Int (read index)
      (if (eq byte 10)
        (+ index 1)
        (if (eq byte 13)
          (+ index 1)
          (skip_comment (+ index 1)))))))

(def skip ((index Int)) Int
  (if (eq index (input))
    index
    (let byte Int (read index)
      (if (is_space byte)
        (skip (+ index 1))
        (if (eq byte 59)
          (skip (skip_comment (+ index 1)))
          index)))))

(def token_end ((index Int)) Int
  (if (eq index (input))
    index
    (let byte Int (read index)
      (if (eq byte 40)
        (+ index 1)
        (if (eq byte 41)
          (+ index 1)
          (token_word_end index))))))

(def token_word_end ((index Int)) Int
  (if (eq index (input))
    index
    (let byte Int (read index)
      (if (is_space byte)
        index
        (if (eq byte 40)
          index
          (if (eq byte 41)
            index
            (if (eq byte 59)
              index
              (token_word_end (+ index 1)))))))))

(def same_span ((left Int) (left_end Int) (right Int) (right_end Int)) Int
  (if (eq (- left_end left) (- right_end right))
    (same_span_bytes left right (- left_end left))
    0))

(def same_span_bytes ((left Int) (right Int) (remaining Int)) Int
  (if (eq remaining 0)
    1
    (if (eq (read left) (read right))
      (same_span_bytes (+ left 1) (+ right 1) (- remaining 1))
      0)))

(def token_data ((start Int) (end Int)) Int
  (if (eq (- end start) 4)
    (if (eq (read start) 100)
      (if (eq (read (+ start 1)) 97)
        (if (eq (read (+ start 2)) 116)
          (eq (read (+ start 3)) 97)
          0)
        0)
      0)
    0))

(def token_def ((start Int) (end Int)) Int
  (if (eq (- end start) 3)
    (if (eq (read start) 100)
      (if (eq (read (+ start 1)) 101)
        (eq (read (+ start 2)) 102)
        0)
      0)
    0))

(def token_main ((start Int) (end Int)) Int
  (if (eq (- end start) 4)
    (if (eq (read start) 109)
      (if (eq (read (+ start 1)) 97)
        (if (eq (read (+ start 2)) 105)
          (eq (read (+ start 3)) 110)
          0)
        0)
      0)
    0))

(def token_match ((start Int) (end Int)) Int
  (if (eq (- end start) 5)
    (if (eq (read start) 109)
      (if (eq (read (+ start 1)) 97)
        (if (eq (read (+ start 2)) 116)
          (if (eq (read (+ start 3)) 99)
            (eq (read (+ start 4)) 104)
            0)
          0)
        0)
      0)
    0))

(def token_let ((start Int) (end Int)) Int
  (if (eq (- end start) 3)
    (if (eq (read start) 108)
      (if (eq (read (+ start 1)) 101)
        (eq (read (+ start 2)) 116)
        0)
      0)
    0))

(def token_int ((start Int) (end Int)) Int
  (if (eq (- end start) 3)
    (if (eq (read start) 73)
      (if (eq (read (+ start 1)) 110)
        (eq (read (+ start 2)) 116)
        0)
      0)
    0))

(def is_upper ((byte Int)) Int
  (if (lt byte 65)
    0
    (lt byte 91)))

(def is_digit ((byte Int)) Int
  (if (lt byte 48)
    0
    (lt byte 58)))

(def skip_expression ((index Int)) Int
  (let start Int (skip index)
    (if (eq (read start) 40)
      (skip_list (token_end start))
      (token_end start))))

(def skip_list ((index Int)) Int
  (let start Int (skip index)
    (if (eq (read start) 41)
      (token_end start)
      (skip_list (skip_expression start)))))

(def form_head ((form Int)) Int
  (skip (token_end form)))

(def form_head_end ((form Int)) Int
  (token_end (form_head form)))

(def find_type_owner ((name Int) (name_end Int)) Int
  (find_type_owner_forms 0 name name_end))

(def find_type_owner_forms ((index Int) (name Int) (name_end Int)) Int
  (let form Int (skip index)
    (if (eq form (input))
      0
      (let head Int (form_head form)
        (let head_end Int (token_end head)
          (if (token_data head head_end)
            (let type_name Int (skip head_end)
              (let type_end Int (token_end type_name)
                (if (same_span type_name type_end name name_end)
                  (+ form 1)
                  (find_type_owner_forms
                    (skip_expression form) name name_end))))
            (find_type_owner_forms
              (skip_expression form) name name_end)))))))

(def constructor_arity_at ((constructor_end Int)) Int
  (count_constructor_fields (skip constructor_end) 0))

(def count_constructor_fields ((index Int) (count Int)) Int
  (let next Int (skip index)
    (if (eq (read next) 41)
      count
      (let type_end Int (token_end next)
        (if (field_type_valid next type_end)
          (count_constructor_fields type_end (+ count 1))
          (fail))))))

(def field_type_valid ((start Int) (end Int)) Int
  (if (token_int start end)
    1
    (if (is_upper (read start))
      (if (eq (find_type_owner start end) 0) 0 1)
      0)))

(def constructor_after ((constructor_end Int)) Int
  (constructor_fields_after (skip constructor_end)))

(def constructor_fields_after ((index Int)) Int
  (let next Int (skip index)
    (if (eq (read next) 41)
      (token_end next)
      (let type_end Int (token_end next)
        (if (field_type_valid next type_end)
          (constructor_fields_after type_end)
          (fail))))))

(def data_has_payload ((owner Int)) Int
  (let form Int (- owner 1)
    (let head Int (form_head form)
      (data_items_have_payload
        (skip (token_end (skip (token_end head)))) 0))))

(def data_items_have_payload ((index Int) (seen Int)) Int
  (let item Int (skip index)
    (if (eq (read item) 41)
      seen
      (let constructor Int (skip (token_end item))
        (let constructor_end Int (token_end constructor)
          (let arity Int (constructor_arity_at constructor_end)
            (data_items_have_payload
              (constructor_after constructor_end) (+ seen arity))))))))

(def find_constructor_arity ((name Int) (name_end Int)) Int
  (let owner Int (find_constructor_owner name name_end)
    (if (eq owner 0)
      (fail)
      (let form Int (- owner 1)
        (let head Int (form_head form)
          (let result Int
            (find_constructor_arity_in_data
              (skip (token_end (skip (token_end head)))) name name_end)
            (if (eq result 0)
              (fail)
              (- result 1))))))))

(def find_constructor_arity_in_data
  ((index Int) (name Int) (name_end Int)) Int
  (let item Int (skip index)
    (if (eq (read item) 41)
      0
      (let constructor Int (skip (token_end item))
        (let constructor_end Int (token_end constructor)
          (if (same_span constructor constructor_end name name_end)
            (+ (constructor_arity_at constructor_end) 1)
            (find_constructor_arity_in_data
              (constructor_after constructor_end) name name_end)))))))

(def find_constructor_tag ((name Int) (name_end Int)) Int
  (find_constructor_tag_forms 0 name name_end))

(def find_constructor_tag_forms ((index Int) (name Int) (name_end Int)) Int
  (let form Int (skip index)
    (if (eq form (input))
      0
      (let head Int (form_head form)
        (let head_end Int (token_end head)
          (if (token_data head head_end)
            (let result Int (find_constructor_in_data
                              (skip (token_end (skip head_end)))
                              name name_end 0)
              (if (eq result 0)
                (find_constructor_tag_forms (skip_expression form) name name_end)
                result))
            (find_constructor_tag_forms (skip_expression form) name name_end)))))))

(def find_constructor_in_data
  ((index Int) (name Int) (name_end Int) (tag Int)) Int
  (let item Int (skip index)
    (if (eq (read item) 41)
      0
      (let constructor Int (skip (token_end item))
        (let constructor_end Int (token_end constructor)
          (if (same_span constructor constructor_end name name_end)
            (+ tag 1)
            (find_constructor_in_data
              (constructor_after constructor_end) name name_end (+ tag 1))))))))

(def find_constructor_owner ((name Int) (name_end Int)) Int
  (find_constructor_owner_forms 0 name name_end))

(def find_constructor_owner_forms ((index Int) (name Int) (name_end Int)) Int
  (let form Int (skip index)
    (if (eq form (input))
      0
      (let head Int (form_head form)
        (let head_end Int (token_end head)
          (if (token_data head head_end)
            (if (constructor_in_data
                  (skip (token_end (skip head_end))) name name_end)
              (+ form 1)
              (find_constructor_owner_forms
                (skip_expression form) name name_end))
            (find_constructor_owner_forms
              (skip_expression form) name name_end)))))))

(def constructor_in_data ((index Int) (name Int) (name_end Int)) Int
  (let item Int (skip index)
    (if (eq (read item) 41)
      0
      (let constructor Int (skip (token_end item))
        (let constructor_end Int (token_end constructor)
          (if (same_span constructor constructor_end name name_end)
            1
            (constructor_in_data
              (constructor_after constructor_end) name name_end)))))))

(def constructor_count ((owner Int)) Int
  (let form Int (- owner 1)
    (let head Int (form_head form)
      (count_constructor_items (skip (token_end (skip (token_end head)))) 0))))

(def count_constructor_items ((index Int) (count Int)) Int
  (let item Int (skip index)
    (if (eq (read item) 41)
      count
      (let constructor Int (skip (token_end item))
        (count_constructor_items
          (constructor_after (token_end constructor)) (+ count 1))))))

(def emit_span ((index Int) (end Int)) Int
  (if (eq index end)
    0
    (let ignored Int (write (read index))
      (emit_span (+ index 1) end))))

(def emit_int_word () Int
  (let ignored0 Int (write 'I')
    (let ignored1 Int (write 'n')
      (write 't'))))

(def emit_decimal ((value Int)) Int
  (if (lt value 10)
    (write (+ 48 value))
    (let ignored Int (emit_decimal (/ value 10))
      (write (+ 48 (% value 10))))))

(def emit_match_name ((match_start Int)) Int
  (let ignored0 Int (write '_')
    (let ignored1 Int (write '_')
      (let ignored2 Int (write 'm')
        (emit_decimal match_start)))))

(def emit_match_payload_name ((match_start Int)) Int
  (let ignored0 Int (write '_')
    (let ignored1 Int (write '_')
      (let ignored2 Int (write 'p')
        (emit_decimal match_start)))))

(def emit_match_value_name ((match_start Int)) Int
  (let ignored0 Int (write '_')
    (let ignored1 Int (write '_')
      (let ignored2 Int (write 'v')
        (emit_decimal match_start)))))

(def emit_pair_prefix () Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (write 'p')
      (let ignored2 Int (write 'a')
        (let ignored3 Int (write 'i')
          (let ignored4 Int (write 'r')
            (write '\s')))))))

(def emit_first_prefix () Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (write 'f')
      (let ignored2 Int (write 'i')
        (let ignored3 Int (write 'r')
          (let ignored4 Int (write 's')
            (let ignored5 Int (write 't')
              (write '\s'))))))))

(def emit_second_prefix () Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (write 's')
      (let ignored2 Int (write 'e')
        (let ignored3 Int (write 'c')
          (let ignored4 Int (write 'o')
            (let ignored5 Int (write 'n')
              (let ignored6 Int (write 'd')
                (write '\s')))))))))

(def emit_tag_name ((name Int) (name_end Int)) Int
  (let ignored0 Int (emit_span name name_end)
    (let ignored1 Int (write '_')
      (let ignored2 Int (write '_')
        (let ignored3 Int (write 't')
          (let ignored4 Int (write 'a')
            (write 'g')))))))

(def emit_field_name ((name Int) (name_end Int)) Int
  (let ignored0 Int (emit_span name name_end)
    (let ignored1 Int (write '_')
      (let ignored2 Int (write '_')
        (let ignored3 Int (write 'f')
          (let ignored4 Int (write 'i')
            (let ignored5 Int (write 'e')
              (let ignored6 Int (write 'l')
                (let ignored7 Int (write 'd')
                  (write '0'))))))))))

(def emit_parameter ((name Int) (name_end Int)) Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (emit_span name name_end)
      (let ignored2 Int (write '\s')
        (let ignored3 Int (emit_int_word)
          (write ')'))))))

(def emit_payload_parameters ((name Int) (name_end Int)) Int
  (let ignored0 Int (write '(')
    (let ignored1 Int (emit_tag_name name name_end)
      (let ignored2 Int (write '\s')
        (let ignored3 Int (emit_int_word)
          (let ignored4 Int (write ')')
            (let ignored5 Int (write '\s')
              (let ignored6 Int (write '(')
                (let ignored7 Int (emit_field_name name name_end)
                  (let ignored8 Int (write '\s')
                    (let ignored9 Int (emit_int_word)
                      (write ')'))))))))))))

(def validate_data ((form Int)) Int
  (let head Int (form_head form)
    (let type_name Int (skip (token_end head))
      (validate_constructor_items (skip (token_end type_name)) 0))))

(def validate_constructor_items ((index Int) (count Int)) Int
  (let item Int (skip index)
    (if (eq (read item) 41)
      (if (eq count 0)
        (fail)
        (token_end item))
      (let constructor Int (skip (token_end item))
        (let constructor_end Int (token_end constructor)
          (validate_constructor_items
            (constructor_after constructor_end) (+ count 1)))))))

; A name trie option is (pair present node). Each node is
; (pair terminal children). Children form an eight-level immutable bit tree
; indexed by one complete source byte, so duplicate detection has no hash
; collision and name recursion advances once per byte.
(def empty_name_trie () Int
  (pair 0 0))

(def empty_name_children () Int
  (let empty Int (empty_name_trie)
    (let level1 Int (pair empty empty)
      (let level2 Int (pair level1 level1)
        (let level3 Int (pair level2 level2)
          (let level4 Int (pair level3 level3)
            (let level5 Int (pair level4 level4)
              (let level6 Int (pair level5 level5)
                (let level7 Int (pair level6 level6)
                  (pair level7 level7))))))))))

(def name_child ((children Int) (byte Int) (power Int)) Int
  (let bit Int (% (/ byte power) 2)
    (if (eq power 128)
      (if (eq bit 0) (first children) (second children))
      (if (eq bit 0)
        (name_child (first children) byte (* power 2))
        (name_child (second children) byte (* power 2))))))

(def name_children_replace
  ((children Int) (byte Int) (power Int) (child Int)) Int
  (let bit Int (% (/ byte power) 2)
    (if (eq power 128)
      (if (eq bit 0)
        (pair child (second children))
        (pair (first children) child))
      (if (eq bit 0)
        (pair
          (name_children_replace
            (first children) byte (* power 2) child)
          (second children))
        (pair
          (first children)
          (name_children_replace
            (second children) byte (* power 2) child))))))

(def name_trie_new_path ((end Int) (index Int)) Int
  (if (eq index end)
    (pair 1 (pair 1 (empty_name_children)))
    (let child Int (name_trie_new_path end (+ index 1))
      (let children Int
        (name_children_replace
          (empty_name_children) (read index) 1 child)
        (pair 1 (pair 0 children))))))

(def name_trie_insert ((trie Int) (end Int) (index Int)) Int
  (if (eq (first trie) 0)
    (name_trie_new_path end index)
    (let node Int (second trie)
      (let terminal Int (first node)
        (let children Int (second node)
          (if (eq index end)
            (if terminal
              (fail)
              (pair 1 (pair 1 children)))
            (let byte Int (read index)
              (let child Int (name_child children byte 1)
                (let next_child Int
                  (name_trie_insert child end (+ index 1))
                  (let next_children Int
                    (name_children_replace children byte 1 next_child)
                    (pair 1 (pair terminal next_children))))))))))))

(def validate_global_data
  ((form Int) (type_rows Int) (constructor_rows Int)) Int
  (let head Int (form_head form)
    (let type_name Int (skip (token_end head))
      (let type_end Int (token_end type_name)
        (let next_type_rows Int
          (name_trie_insert type_rows type_end type_name)
          (let result Int
            (validate_global_constructors
              (skip type_end) constructor_rows 0)
            (pair (first result)
              (pair next_type_rows (second result)))))))))

(def validate_global_constructors
  ((index Int) (constructor_rows Int) (count Int)) Int
  (let item Int (skip index)
    (if (eq (read item) 41)
      (if (eq count 0)
        (fail)
        (pair (token_end item) constructor_rows))
      (let constructor Int (skip (token_end item))
        (let constructor_end Int (token_end constructor)
          (validate_global_constructors
            (constructor_after constructor_end)
            (name_trie_insert
              constructor_rows constructor_end constructor)
            (+ count 1)))))))

(def validate_global_program
  ((index Int) (saw_function Int) (function_count Int) (main_count Int)
   (type_rows Int) (constructor_rows Int) (function_rows Int)) Int
  (let form Int (skip index)
    (if (eq form (input))
      (if (eq function_count 0)
        (fail)
        (if (eq main_count 1)
          0
          (fail)))
      (if (eq (read form) 40)
        (let head Int (form_head form)
          (let head_end Int (token_end head)
            (if (token_data head head_end)
              (if saw_function
                (fail)
                (let result Int
                  (validate_global_data form type_rows constructor_rows)
                  (let rows Int (second result)
                    (validate_global_program
                      (first result) 0 function_count main_count
                      (first rows) (second rows) function_rows))))
              (if (token_def head head_end)
                (let name Int (skip head_end)
                  (let name_end Int (token_end name)
                    (validate_global_program
                      (skip_expression form) 1 (+ function_count 1)
                      (+ main_count (token_main name name_end))
                      type_rows constructor_rows
                      (name_trie_insert
                        function_rows name_end name))))
                (fail)))))
        (fail)))))

(def emit_program ((index Int)) Int
  (let form Int (skip index)
    (if (eq form (input))
      10
      (let head Int (form_head form)
        (let head_end Int (token_end head)
          (if (token_data head head_end)
