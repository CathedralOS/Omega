      (DeltaMachineBodyParseRejected UnexpectedEnd start)
      (DeltaMachineBodyParseRejected UnexpectedToken start))))

(def delta_parse_explicit_terminal ((source Bytes) (cursor Int)) DeltaTerminalParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 18)
        (delta_parse_return_terminal source start)
        (if (eq code 16)
          (let transitionOutcome (delta_parse_transition source start)
            (match transitionOutcome
              ((DeltaTransitionParseRejected reasonValue errorOffset)
                (DeltaTerminalParseRejected reasonValue errorOffset))
              ((DeltaTransitionParsed terminalValue)
                (DeltaTerminalParsed terminalValue))))
          (delta_terminal_reject_at source cursor))))))

(def delta_finish_state_terminal ((source Bytes) (bodyStart Int)
  (statements DeltaStatementList) (terminalValue DeltaTerminal)) DeltaStateBodyParseOutcome
  (let closeStart (delta_token_start source (delta_terminal_end terminalValue))
    (if (eq (delta_token_code source closeStart) 31)
      (let bodyEnd (delta_token_end source closeStart)
        (DeltaStateBodyParsed
          (DeltaStateBodySyntax bodyStart bodyEnd
            (delta_reverse_statements statements NoDeltaStatements)
            (SomeDeltaTerminal terminalValue))))
      (delta_state_body_reject_at source (delta_terminal_end terminalValue)))))

(def delta_parse_state_body_items ((source Bytes) (bodyStart Int) (cursor Int)
  (statements DeltaStatementList)) DeltaStateBodyParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaStateBodyParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (let bodyEnd (delta_token_end source start)
            (DeltaStateBodyParsed
              (DeltaStateBodySyntax bodyStart bodyEnd
                (delta_reverse_statements statements NoDeltaStatements)
                NoDeltaTerminal)))
          (if (eq code 18)
            (let terminalOutcome (delta_parse_explicit_terminal source start)
              (match terminalOutcome
                ((DeltaTerminalParseRejected reasonValue errorOffset)
                  (DeltaStateBodyParseRejected reasonValue errorOffset))
                ((DeltaTerminalParsed terminalValue)
                  (delta_finish_state_terminal source bodyStart statements terminalValue))))
            (if (eq code 16)
              (let terminalOutcome (delta_parse_explicit_terminal source start)
                (match terminalOutcome
                  ((DeltaTerminalParseRejected reasonValue errorOffset)
                    (DeltaStateBodyParseRejected reasonValue errorOffset))
                  ((DeltaTerminalParsed terminalValue)
                    (delta_finish_state_terminal source bodyStart statements terminalValue))))
              (if (eq code 15)
                (DeltaStateBodyParseRejected UnexpectedToken start)
                (let statementOutcome (delta_parse_statement source start)
                  (match statementOutcome
                    ((DeltaStatementParseRejected reasonValue errorOffset)
                      (DeltaStateBodyParseRejected reasonValue errorOffset))
                    ((DeltaStatementParsed statementValue)
                      (delta_parse_state_body_items source bodyStart
                        (delta_statement_end statementValue)
                        (MoreDeltaStatements statementValue statements)))))))))))))

(def delta_parse_state_body ((source Bytes) (cursor Int)) DeltaStateBodyParseOutcome
  (let bodyStart (delta_token_start source cursor)
    (if (eq (delta_token_code source bodyStart) 30)
      (delta_parse_state_body_items source bodyStart
        (delta_token_end source bodyStart) NoDeltaStatements)
      (delta_state_body_reject_at source cursor))))

(def delta_finish_state ((source Bytes) (stateStart Int) (nameStart Int)
  (nameEnd Int) (parameters DeltaParameterList) (cursor Int)) DeltaStateParseOutcome
  (let bodyOutcome (delta_parse_state_body source cursor)
    (match bodyOutcome
      ((DeltaStateBodyParseRejected reasonValue errorOffset)
        (DeltaStateParseRejected reasonValue errorOffset))
      ((DeltaStateBodyParsed bodyValue)
        (DeltaStateParsed
          (DeltaStateSyntax stateStart (delta_state_body_end bodyValue)
            (DeltaNameSpan nameStart nameEnd) parameters bodyValue))))))

(def delta_parse_state ((source Bytes) (cursor Int)) DeltaStateParseOutcome
  (let stateStart (delta_token_start source cursor)
    (if (eq (delta_token_code source stateStart) 15)
      (let nameStart (delta_token_start source (delta_token_end source stateStart))
        (if (eq (delta_token_code source nameStart) 1)
          (let nameEnd (delta_token_end source nameStart)
            (let openStart (delta_token_start source nameEnd)
              (if (eq (delta_token_code source openStart) 32)
                (let parametersOutcome
                  (delta_parse_parameters_acc source (delta_token_end source openStart)
                    33 NoDeltaParameters)
