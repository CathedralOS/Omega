                        (DeltaDeclarationParseRejected reasonValue errorOffset))
                      ((DeltaBoundaryMachineListParsed machines closeStart)
                        (let declarationEnd (delta_token_end source closeStart)
                          (DeltaDeclarationParsed
                            (DeltaBoundaryDeclaration declarationStart declarationEnd
                              (DeltaNameSpan nameStart nameEnd) machines))))))
                  (delta_declaration_reject_at source nameEnd))))
            (delta_declaration_reject_at source (delta_token_end source traitStart))))
        (delta_declaration_reject_at source
          (delta_token_end source declarationStart))))))

(def delta_finish_field_member ((source Bytes) (nameStart Int) (nameEnd Int)
  (cursor Int)) DeltaDataMemberParseOutcome
  (let typeOutcome (delta_parse_type source cursor)
    (match typeOutcome
      ((DeltaTypeParseRejected reasonValue errorOffset)
        (DeltaDataMemberParseRejected reasonValue errorOffset))
