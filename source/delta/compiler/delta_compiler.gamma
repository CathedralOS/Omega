  (DeltaResolvedDataMachineCallable DeltaDeclaration DeltaDeclaration)
  (DeltaResolvedUnqualifiedMachineCallable DeltaDeclaration)
  (DeltaResolvedBoundaryMachineCallable DeltaDeclaration
    DeltaBoundaryMachine))

