                  (delta_token_end source scopeStart))))
            (DeltaQualifiedNameParsed
              (DeltaUnqualifiedName firstStart firstEnd
                (DeltaNameSpan firstStart firstEnd))))))
      (delta_qualified_name_reject_at source cursor))))

(def delta_parse_receiver_parameters ((source Bytes) (openStart Int)
