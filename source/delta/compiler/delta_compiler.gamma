          (delta_parse_receiver_parameters source openStart receiverStart
            receiverEnd (delta_token_end source followingStart))
          (delta_machine_inputs_reject_at source cursor))))))

(def delta_parse_receiver_inputs ((source Bytes) (openStart Int)
  (cursor Int)) DeltaMachineInputsParseOutcome
  (let receiverStart (delta_token_start source cursor)
    (let mutStart (delta_token_start source (delta_token_end source receiverStart))
      (if (eq (delta_token_code source mutStart) 23)
        (let selfStart (delta_token_start source (delta_token_end source mutStart))
          (if (eq (delta_token_code source selfStart) 22)
