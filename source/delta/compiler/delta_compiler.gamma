      (let parametersOutcome
        (delta_parse_parameters_acc source parameterStart 33 NoDeltaParameters)
        (match parametersOutcome
          ((DeltaParameterListParseRejected reasonValue errorOffset)
            (DeltaMachineInputsParseRejected reasonValue errorOffset))
          ((DeltaParameterListParsed parameters closeStart)
            (DeltaMachineInputsParsed
              (DeltaReceiverMachineInputs openStart
                (delta_token_end source closeStart) receiverStart receiverEnd parameters)
              closeStart)))))))

(def delta_finish_receiver_inputs ((source Bytes) (openStart Int)
  (receiverStart Int) (receiverEnd Int) (cursor Int)) DeltaMachineInputsParseOutcome
  (let followingStart (delta_token_start source cursor)
    (let followingCode (delta_token_code source followingStart)
      (if (eq followingCode 33)
