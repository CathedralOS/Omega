      (DeltaStatementParseRejected UnexpectedToken start))))

(def delta_terminal_reject_at ((source Bytes) (cursor Int)) DeltaTerminalParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaTerminalParseRejected UnexpectedEnd start)
      (DeltaTerminalParseRejected UnexpectedToken start))))

(def delta_parse_parameter ((source Bytes) (cursor Int)) DeltaParameterParseOutcome
  (let nameStart (delta_token_start source cursor)
    (if (eq (delta_token_code source nameStart) 1)
      (let nameEnd (delta_token_end source nameStart)
        (let colonStart (delta_token_start source nameEnd)
          (if (eq (delta_token_code source colonStart) 37)
            (let typeOutcome
              (delta_parse_type source (delta_token_end source colonStart))
              (match typeOutcome
                ((DeltaTypeParseRejected reasonValue errorOffset)
                  (DeltaParameterParseRejected reasonValue errorOffset))
                ((DeltaTypeParsed typeValue)
                  (let parameterEnd (delta_type_end typeValue)
                    (DeltaParameterParsed
                      (DeltaParameterSyntax nameStart parameterEnd
                        (DeltaNameSpan nameStart nameEnd) typeValue))))))
            (delta_parameter_reject_at source nameEnd))))
      (delta_parameter_reject_at source cursor))))

(def delta_parse_parameters_acc ((source Bytes) (cursor Int) (closeCode Int)
  (accumulator DeltaParameterList)) DeltaParameterListParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq (delta_token_code source start) closeCode)
      (DeltaParameterListParsed
        (delta_reverse_parameters accumulator NoDeltaParameters) start)
      (let parameterOutcome (delta_parse_parameter source start)
        (match parameterOutcome
          ((DeltaParameterParseRejected reasonValue errorOffset)
            (DeltaParameterListParseRejected reasonValue errorOffset))
          ((DeltaParameterParsed parameterValue)
            (let followingStart (delta_token_start source
              (delta_parameter_end parameterValue))
              (let followingCode (delta_token_code source followingStart)
                (if (eq followingCode closeCode)
                  (DeltaParameterListParsed
                    (delta_reverse_parameters
                      (MoreDeltaParameters parameterValue accumulator)
                      NoDeltaParameters) followingStart)
                  (if (eq followingCode 38)
                    (let afterComma (delta_token_end source followingStart)
                      (let nextStart (delta_token_start source afterComma)
                        (if (eq (delta_token_code source nextStart) closeCode)
                          (DeltaParameterListParseRejected UnexpectedToken nextStart)
                          (delta_parse_parameters_acc source afterComma closeCode
                            (MoreDeltaParameters parameterValue accumulator)))))
                    (delta_parameter_list_reject_at source followingStart)))))))))))

(def delta_finish_let_statement ((source Bytes) (statementStart Int)
  (nameStart Int) (nameEnd Int) (typeValue DeltaType) (cursor Int)) DeltaStatementParseOutcome
  (let assignStart (delta_token_start source cursor)
    (if (eq (delta_token_code source assignStart) 41)
      (let expressionOutcome
        (delta_parse_expression source (delta_token_end source assignStart))
        (match expressionOutcome
          ((DeltaExpressionParseRejected reasonValue errorOffset)
            (DeltaStatementParseRejected reasonValue errorOffset))
          ((DeltaExpressionParsed expressionValue)
            (let semiStart (delta_token_start source
              (delta_expression_end expressionValue))
              (if (eq (delta_token_code source semiStart) 36)
                (let statementEnd (delta_token_end source semiStart)
                  (DeltaStatementParsed
                    (DeltaLetStatement statementStart statementEnd
                      (DeltaNameSpan nameStart nameEnd) typeValue expressionValue)))
                (delta_statement_reject_at source
                  (delta_expression_end expressionValue)))))))
      (delta_statement_reject_at source cursor))))

(def delta_parse_let_statement ((source Bytes) (cursor Int)) DeltaStatementParseOutcome
  (let statementStart (delta_token_start source cursor)
    (let nameStart (delta_token_start source
      (delta_token_end source statementStart))
      (if (eq (delta_token_code source nameStart) 1)
        (let nameEnd (delta_token_end source nameStart)
          (let colonStart (delta_token_start source nameEnd)
            (if (eq (delta_token_code source colonStart) 37)
              (let typeOutcome
                (delta_parse_type source (delta_token_end source colonStart))
                (match typeOutcome
                  ((DeltaTypeParseRejected reasonValue errorOffset)
                    (DeltaStatementParseRejected reasonValue errorOffset))
                  ((DeltaTypeParsed typeValue)
                    (delta_finish_let_statement source statementStart nameStart nameEnd
                      typeValue (delta_type_end typeValue)))))
              (delta_statement_reject_at source nameEnd))))
        (delta_statement_reject_at source
          (delta_token_end source statementStart))))))

(def delta_parse_assert_statement ((source Bytes) (cursor Int)) DeltaStatementParseOutcome
  (let statementStart (delta_token_start source cursor)
    (let expressionOutcome
      (delta_parse_expression source (delta_token_end source statementStart))
      (match expressionOutcome
        ((DeltaExpressionParseRejected reasonValue errorOffset)
          (DeltaStatementParseRejected reasonValue errorOffset))
        ((DeltaExpressionParsed expressionValue)
          (let semiStart (delta_token_start source (delta_expression_end expressionValue))
            (if (eq (delta_token_code source semiStart) 36)
              (let statementEnd (delta_token_end source semiStart)
                (DeltaStatementParsed
                  (DeltaAssertStatement statementStart statementEnd expressionValue)))
              (delta_statement_reject_at source
                (delta_expression_end expressionValue)))))))))

(def delta_finish_assignment ((source Bytes) (left DeltaExpression)
  (cursor Int)) DeltaStatementParseOutcome
  (let rightOutcome (delta_parse_expression source cursor)
    (match rightOutcome
      ((DeltaExpressionParseRejected reasonValue errorOffset)
        (DeltaStatementParseRejected reasonValue errorOffset))
      ((DeltaExpressionParsed right)
        (let semiStart (delta_token_start source (delta_expression_end right))
          (if (eq (delta_token_code source semiStart) 36)
            (let statementEnd (delta_token_end source semiStart)
              (DeltaStatementParsed
                (DeltaAssignmentStatement (delta_expression_start left)
                  statementEnd left right)))
            (delta_statement_reject_at source (delta_expression_end right))))))))

(def delta_parse_postfix_statement ((source Bytes) (cursor Int)) DeltaStatementParseOutcome
  (let leftOutcome (delta_parse_postfix source cursor)
    (match leftOutcome
      ((DeltaExpressionParseRejected reasonValue errorOffset)
        (DeltaStatementParseRejected reasonValue errorOffset))
      ((DeltaExpressionParsed left)
        (let followingStart (delta_token_start source (delta_expression_end left))
          (let followingCode (delta_token_code source followingStart)
            (if (eq followingCode 41)
              (delta_finish_assignment source left
                (delta_token_end source followingStart))
              (if (eq followingCode 36)
                (let statementEnd (delta_token_end source followingStart)
                  (DeltaStatementParsed
                    (DeltaPostfixStatement (delta_expression_start left)
                      statementEnd left)))
                (delta_statement_reject_at source followingStart)))))))))

(def delta_parse_statement ((source Bytes) (cursor Int)) DeltaStatementParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 17)
        (delta_parse_let_statement source start)
        (if (eq code 19)
          (delta_parse_assert_statement source start)
          (delta_parse_postfix_statement source start))))))

(def delta_parse_return_terminal ((source Bytes) (cursor Int)) DeltaTerminalParseOutcome
  (let returnStart (delta_token_start source cursor)
    (if (eq (delta_token_code source returnStart) 18)
      (let afterReturn (delta_token_end source returnStart)
        (let followingStart (delta_token_start source afterReturn)
          (if (eq (delta_token_code source followingStart) 36)
            (let terminalEnd (delta_token_end source followingStart)
              (DeltaTerminalParsed
                (DeltaReturnTerminal returnStart terminalEnd NoDeltaExpression)))
            (let expressionOutcome (delta_parse_expression source followingStart)
              (match expressionOutcome
                ((DeltaExpressionParseRejected reasonValue errorOffset)
                  (DeltaTerminalParseRejected reasonValue errorOffset))
                ((DeltaExpressionParsed expressionValue)
                  (let semiStart (delta_token_start source
                    (delta_expression_end expressionValue))
                    (if (eq (delta_token_code source semiStart) 36)
                      (let terminalEnd (delta_token_end source semiStart)
                        (DeltaTerminalParsed
                          (DeltaReturnTerminal returnStart terminalEnd
                            (SomeDeltaExpression expressionValue))))
                      (delta_terminal_reject_at source
                        (delta_expression_end expressionValue))))))))))
      (delta_terminal_reject_at source cursor))))

; ---- state and machine bodies ------------------------------------------

(def delta_statement_end ((statementValue DeltaStatement)) Int
  (match statementValue
    ((DeltaLetStatement start end name typeValue expressionValue) end)
    ((DeltaAssignmentStatement start end left right) end)
    ((DeltaPostfixStatement start end expressionValue) end)
    ((DeltaAssertStatement start end expressionValue) end)))

(def delta_terminal_end ((terminalValue DeltaTerminal)) Int
  (match terminalValue
    ((DeltaTransitionTerminal start end expressionValue arms) end)
    ((DeltaReturnTerminal start end expressionValue) end)))

(def delta_state_body_end ((bodyValue DeltaStateBody)) Int
  (match bodyValue
    ((DeltaStateBodySyntax start end statements terminalValue) end)))

(def delta_state_end ((stateValue DeltaState)) Int
  (match stateValue
    ((DeltaStateSyntax start end name parameters bodyValue) end)))

(def delta_reverse_statements ((input DeltaStatementList)
  (output DeltaStatementList)) DeltaStatementList
  (match input
    (NoDeltaStatements output)
    ((MoreDeltaStatements item rest)
      (delta_reverse_statements rest (MoreDeltaStatements item output)))))

(def delta_reverse_states ((input DeltaStateList) (output DeltaStateList)) DeltaStateList
  (match input
    (NoDeltaStates output)
    ((MoreDeltaStates item rest)
      (delta_reverse_states rest (MoreDeltaStates item output)))))

(def delta_state_body_reject_at ((source Bytes) (cursor Int)) DeltaStateBodyParseOutcome
  (let start (delta_token_start source cursor)
