; delta_compiler.gamma - Gamma-written direct Delta compiler (in progress).
;
; This retained first phase belongs to the final compiler. It validates the
; complete D15 source envelope before it validates any Delta token or literal,
; preserving D17's phase priority. It intentionally exposes no `main` and emits
; no placeholder artifact until every later checking and direct-lowering phase
; exists.

(data DeltaRejectReason
  (InvalidSourceByte)
  (InvalidToken)
  (InvalidCharacterLiteral)
  (UnterminatedString)
  (InvalidEscape)
  (IntegerLiteralOutOfRange)
  (UnexpectedToken)
  (UnexpectedEnd)
  (DuplicateName)
  (MissingEntry)
  (InvalidEntry)
  (InvalidBoundary)
  (UnknownType)
  (RecursiveValueType)
  (InvalidDataShape)
  (InvalidArrayLength)
  (UnknownName)
  (TypeMismatch)
  (ArityMismatch)
  (InvalidPlace)
  (UseBeforeInitialization)
  (EscapingView)
  (InvalidControlTarget)
  (InvalidTerminal)
  (DuplicatePattern)
  (NonexhaustiveSum))

(data DeltaCompileOutcome
  (Complete Bytes)
  (Reject DeltaRejectReason Int))

(data DeltaLexicalOutcome
  (LexicallyValid)
  (LexicallyRejected DeltaRejectReason Int))

; Native syntax values retain packed-source coordinates directly. Lists and
; optionals are recursive Gamma values; no syntax node is a Bytes record or a
; numeric arena reference.
(data DeltaName
  (DeltaNameSpan Int Int))

(data DeltaIntegerLiteral
  (DeltaIntegerSpan Int Int Int))

(data DeltaCharacterLiteral
  (DeltaCharacterSpan Int Int Int))

(data DeltaStringLiteral
  (DeltaStringSpan Int Int))

(data DeltaDeclarationList
  (NoDeltaDeclarations)
  (MoreDeltaDeclarations DeltaDeclaration DeltaDeclarationList))

(data DeltaBoundaryMachineList
  (NoDeltaBoundaryMachines)
  (MoreDeltaBoundaryMachines DeltaBoundaryMachine DeltaBoundaryMachineList))

(data DeltaDataMemberList
  (NoDeltaDataMembers)
  (MoreDeltaDataMembers DeltaDataMember DeltaDataMemberList))

(data DeltaParameterList
  (NoDeltaParameters)
  (MoreDeltaParameters DeltaParameter DeltaParameterList))

(data DeltaStatementList
  (NoDeltaStatements)
  (MoreDeltaStatements DeltaStatement DeltaStatementList))

(data DeltaStateList
  (NoDeltaStates)
  (MoreDeltaStates DeltaState DeltaStateList))

(data DeltaArmList
  (NoDeltaArms)
  (MoreDeltaArms DeltaArm DeltaArmList))

(data DeltaNameList
  (NoDeltaNames)
  (MoreDeltaNames DeltaName DeltaNameList))

(data DeltaExpressionList
  (NoDeltaExpressions)
  (MoreDeltaExpressions DeltaExpression DeltaExpressionList))

(data DeltaOptionalType
  (NoDeltaType)
  (SomeDeltaType DeltaType))

(data DeltaOptionalExpression
  (NoDeltaExpression)
  (SomeDeltaExpression DeltaExpression))

(data DeltaOptionalTerminal
  (NoDeltaTerminal)
  (SomeDeltaTerminal DeltaTerminal))

(data DeltaOptionalBinder
  (NoDeltaBinder)
  (SomeDeltaBinder Int Int DeltaNameList))

(data DeltaOptionalPayload
  (NoDeltaPayload)
  (SomeDeltaPayload Int Int DeltaParameterList))

; This optional preserves the syntactic distinction between a qualified name
; and the same name followed by an empty argument list.
(data DeltaOptionalArguments
  (NoDeltaArguments)
  (SomeDeltaArguments Int Int DeltaExpressionList))

(data DeltaProgram
  (DeltaSyntaxProgram Int Int DeltaDeclarationList))

(data DeltaDeclaration
  (DeltaBoundaryDeclaration Int Int DeltaName DeltaBoundaryMachineList)
  (DeltaDataDeclaration Int Int DeltaName DeltaDataMemberList)
  (DeltaMachineDeclaration Int Int DeltaQualifiedName DeltaMachineInputs DeltaOptionalType DeltaMachineBody))

(data DeltaBoundaryMachine
  (DeltaBoundaryMachineSyntax Int Int DeltaName DeltaParameterList DeltaOptionalType))

(data DeltaDataMember
  (DeltaFieldMember Int Int DeltaName DeltaType)
  (DeltaCaseMember Int Int DeltaName DeltaOptionalPayload))

(data DeltaQualifiedName
  (DeltaUnqualifiedName Int Int DeltaName)
  (DeltaQualifiedNameSyntax Int Int DeltaName DeltaName))

(data DeltaMachineInputs
  (NoDeltaMachineInputs)
  (DeltaPlainMachineInputs DeltaParameterList)
  (DeltaReceiverMachineInputs Int Int DeltaParameterList))

(data DeltaParameter
  (DeltaParameterSyntax Int Int DeltaName DeltaType))

(data DeltaType
  (DeltaI32Type Int Int)
  (DeltaU8Type Int Int)
  (DeltaNeverType Int Int)
  (DeltaNamedType Int Int DeltaName)
  (DeltaArrayType Int Int DeltaType DeltaIntegerLiteral)
  (DeltaViewType Int Int DeltaType))

(data DeltaMachineBody
  (DeltaMachineBodySyntax Int Int DeltaStatementList DeltaOptionalTerminal DeltaStateList))

(data DeltaStateBody
  (DeltaStateBodySyntax Int Int DeltaStatementList DeltaOptionalTerminal))

(data DeltaState
  (DeltaStateSyntax Int Int DeltaName DeltaParameterList DeltaStateBody))

(data DeltaStatement
  (DeltaLetStatement Int Int DeltaName DeltaType DeltaExpression)
  (DeltaAssignmentStatement Int Int DeltaExpression DeltaExpression)
  ; Resolution later classifies a semicolon-terminated postfix form as an
  ; ordinary call statement or, only in final body position, a never terminal.
  (DeltaPostfixStatement Int Int DeltaExpression)
  (DeltaAssertStatement Int Int DeltaExpression))

(data DeltaTerminal
  (DeltaTransitionTerminal Int Int DeltaExpression DeltaArmList)
  (DeltaReturnTerminal Int Int DeltaOptionalExpression))

(data DeltaArm
  (DeltaArmSyntax Int Int DeltaPattern DeltaContinuation))

(data DeltaPattern
  (DeltaIntegerPattern Int Int DeltaIntegerLiteral)
  (DeltaTruePattern Int Int)
  (DeltaFalsePattern Int Int)
  (DeltaWildcardPattern Int Int)
  (DeltaCasePattern Int Int DeltaName DeltaName DeltaOptionalBinder))

(data DeltaContinuation
  (DeltaExpressionContinuation Int Int DeltaExpression)
  (DeltaReturnContinuation Int Int DeltaOptionalExpression))

(data DeltaBinaryOperator
  (DeltaLogicalOr)
  (DeltaLogicalAnd)
  (DeltaBitOr)
  (DeltaBitXor)
  (DeltaBitAnd)
  (DeltaEqual)
  (DeltaNotEqual)
  (DeltaLess)
  (DeltaLessEqual)
  (DeltaGreater)
  (DeltaGreaterEqual)
  (DeltaShiftLeft)
  (DeltaShiftRight)
  (DeltaAdd)
  (DeltaSubtract)
  (DeltaMultiply)
  (DeltaDivide)
  (DeltaRemainder))

(data DeltaExpression
  (DeltaIntegerExpression Int Int DeltaIntegerLiteral)
  (DeltaCharacterExpression Int Int DeltaCharacterLiteral)
  (DeltaStringExpression Int Int DeltaStringLiteral)
  (DeltaTrueExpression Int Int)
  (DeltaFalseExpression Int Int)
  (DeltaSelfExpression Int Int)
  (DeltaNameExpression Int Int DeltaName)
  (DeltaQualifiedExpression Int Int DeltaName DeltaName DeltaOptionalArguments)
  (DeltaGroupedExpression Int Int DeltaExpression)
  (DeltaFieldExpression Int Int DeltaExpression DeltaName)
  (DeltaCallExpression Int Int DeltaExpression DeltaExpressionList)
  (DeltaIndexExpression Int Int DeltaExpression DeltaExpression)
  (DeltaSliceExpression Int Int DeltaExpression DeltaOptionalExpression DeltaOptionalExpression)
  (DeltaNegateExpression Int Int DeltaExpression)
  (DeltaBinaryExpression Int Int DeltaBinaryOperator Int Int DeltaExpression DeltaExpression))

(data DeltaTypeParseOutcome
  (DeltaTypeParsed DeltaType)
  (DeltaTypeParseRejected DeltaRejectReason Int))

(data DeltaExpressionParseOutcome
  (DeltaExpressionParsed DeltaExpression)
  (DeltaExpressionParseRejected DeltaRejectReason Int))

(data DeltaArgumentsParseOutcome
  (DeltaArgumentsParsed DeltaExpressionList Int)
  (DeltaArgumentsParseRejected DeltaRejectReason Int))

(def ascii_between ((c Int) (low Int) (high Int)) Int
  (if (lt c low) 0 (if (lt high c) 0 1)))

(def source_byte_allowed ((c Int)) Int
  (if (eq c 9) 1
    (if (eq c 10) 1
      (if (eq c 13) 1
        (ascii_between c 32 126)))))

(def is_space ((c Int)) Int
  (if (eq c 32) 1
    (if (eq c 9) 1
      (if (eq c 10) 1 (eq c 13)))))

(def is_digit ((c Int)) Int
  (ascii_between c 48 57))

(def is_upper ((c Int)) Int
  (ascii_between c 65 90))

(def is_lower ((c Int)) Int
  (ascii_between c 97 122))

(def is_ident_start ((c Int)) Int
  (if (is_upper c) 1
    (if (is_lower c) 1 (eq c 95))))

(def is_ident_continue ((c Int)) Int
  (if (is_ident_start c) 1 (is_digit c)))

(def is_hex_digit ((c Int)) Int
  (if (is_digit c) 1
    (if (ascii_between c 65 70) 1
      (ascii_between c 97 102))))

(def is_printable ((c Int)) Int
  (ascii_between c 32 126))

(def is_simple_escape ((c Int)) Int
  (if (eq c 110) 1
    (if (eq c 114) 1
      (if (eq c 116) 1
        (if (eq c 34) 1 (eq c 92))))))

(def next_is ((source Bytes) (index Int) (length Int) (expected Int)) Int
  (if (lt (+ index 1) length)
    (eq (bytes_get source (+ index 1)) expected)
    0))

(def scan_identifier ((source Bytes) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    (scan_tokens source index length)
    (if (is_ident_continue (bytes_get source index))
      (scan_identifier source (+ index 1) length)
      (scan_tokens source index length))))

(def scan_number ((source Bytes) (start Int) (index Int) (length Int) (value Int)) DeltaLexicalOutcome
  (if (eq index length)
    (scan_tokens source index length)
    (let c (bytes_get source index)
      (if (is_digit c)
        (let digit (- c 48)
          (if (lt value 214748364)
            (scan_number source start (+ index 1) length (+ (* value 10) digit))
            (if (eq value 214748364)
              (if (lt digit 9)
                (scan_number source start (+ index 1) length (+ (* value 10) digit))
                (LexicallyRejected IntegerLiteralOutOfRange start))
              (LexicallyRejected IntegerLiteralOutOfRange start))))
        (scan_tokens source index length)))))

(def scan_line_comment ((source Bytes) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    LexicallyValid
    (let c (bytes_get source index)
      (if (eq c 10)
        (scan_tokens source index length)
        (if (eq c 13)
          (scan_tokens source index length)
          (scan_line_comment source (+ index 1) length))))))

(def scan_string_escape ((source Bytes) (opening Int) (slash Int) (length Int)) DeltaLexicalOutcome
  (if (eq (+ slash 1) length)
    (LexicallyRejected InvalidEscape slash)
    (let c (bytes_get source (+ slash 1))
      (if (is_simple_escape c)
        (scan_string source opening (+ slash 2) length)
        (if (eq c 120)
          (if (lt (+ slash 3) length)
            (if (is_hex_digit (bytes_get source (+ slash 2)))
              (if (is_hex_digit (bytes_get source (+ slash 3)))
                (scan_string source opening (+ slash 4) length)
                (LexicallyRejected InvalidEscape slash))
              (LexicallyRejected InvalidEscape slash))
            (LexicallyRejected InvalidEscape slash))
          (LexicallyRejected InvalidEscape slash))))))

(def scan_string ((source Bytes) (opening Int) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    (LexicallyRejected UnterminatedString opening)
    (let c (bytes_get source index)
      (if (eq c 34)
        (scan_tokens source (+ index 1) length)
        (if (eq c 92)
          (scan_string_escape source opening index length)
          (if (is_printable c)
            (scan_string source opening (+ index 1) length)
            (LexicallyRejected UnterminatedString opening)))))))

(def finish_character ((source Bytes) (opening Int) (close_index Int) (length Int)) DeltaLexicalOutcome
  (if (lt close_index length)
    (if (eq (bytes_get source close_index) 39)
      (scan_tokens source (+ close_index 1) length)
      (LexicallyRejected InvalidCharacterLiteral opening))
    (LexicallyRejected InvalidCharacterLiteral opening)))

(def scan_character_escape ((source Bytes) (opening Int) (slash Int) (length Int)) DeltaLexicalOutcome
  (if (eq (+ slash 1) length)
    (LexicallyRejected InvalidEscape slash)
    (let c (bytes_get source (+ slash 1))
      (if (is_simple_escape c)
        (finish_character source opening (+ slash 2) length)
        (if (eq c 120)
          (if (lt (+ slash 3) length)
            (if (is_hex_digit (bytes_get source (+ slash 2)))
              (if (is_hex_digit (bytes_get source (+ slash 3)))
                (finish_character source opening (+ slash 4) length)
                (LexicallyRejected InvalidEscape slash))
              (LexicallyRejected InvalidEscape slash))
            (LexicallyRejected InvalidEscape slash))
          (LexicallyRejected InvalidEscape slash))))))

(def scan_character ((source Bytes) (opening Int) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    (LexicallyRejected InvalidCharacterLiteral opening)
    (let c (bytes_get source index)
      (if (eq c 92)
        (scan_character_escape source opening index length)
        (if (eq c 39)
          (LexicallyRejected InvalidCharacterLiteral opening)
          (if (is_printable c)
            (finish_character source opening (+ index 1) length)
            (LexicallyRejected InvalidCharacterLiteral opening)))))))

(def is_plain_punctuation ((c Int)) Int
  (if (eq c 123) 1
    (if (eq c 125) 1
      (if (eq c 40) 1
        (if (eq c 41) 1
          (if (eq c 91) 1
            (if (eq c 93) 1
              (if (eq c 59) 1
                (if (eq c 44) 1
                  (if (eq c 43) 1
                    (if (eq c 42) 1
                      (if (eq c 37) 1 (eq c 94)))))))))))))

(def scan_operator ((source Bytes) (index Int) (length Int) (c Int)) DeltaLexicalOutcome
  (if (is_plain_punctuation c)
    (scan_tokens source (+ index 1) length)
    (if (eq c 58)
      (if (next_is source index length 58)
        (scan_tokens source (+ index 2) length)
        (scan_tokens source (+ index 1) length))
      (if (eq c 45)
        (if (next_is source index length 62)
          (scan_tokens source (+ index 2) length)
          (scan_tokens source (+ index 1) length))
        (if (eq c 38)
          (if (next_is source index length 38)
            (scan_tokens source (+ index 2) length)
            (scan_tokens source (+ index 1) length))
          (if (eq c 124)
            (if (next_is source index length 124)
              (scan_tokens source (+ index 2) length)
              (scan_tokens source (+ index 1) length))
            (if (eq c 61)
              (if (next_is source index length 61)
                (scan_tokens source (+ index 2) length)
                (scan_tokens source (+ index 1) length))
              (if (eq c 33)
                (if (next_is source index length 61)
                  (scan_tokens source (+ index 2) length)
                  (LexicallyRejected InvalidToken index))
                (if (eq c 60)
                  (if (next_is source index length 61)
                    (scan_tokens source (+ index 2) length)
                    (if (next_is source index length 60)
                      (scan_tokens source (+ index 2) length)
                      (scan_tokens source (+ index 1) length)))
                  (if (eq c 62)
                    (if (next_is source index length 61)
                      (scan_tokens source (+ index 2) length)
                      (if (next_is source index length 62)
                        (scan_tokens source (+ index 2) length)
                        (scan_tokens source (+ index 1) length)))
                    (if (eq c 46)
                      (if (next_is source index length 46)
                        (scan_tokens source (+ index 2) length)
                        (scan_tokens source (+ index 1) length))
                      (if (eq c 47)
                        (if (next_is source index length 47)
                          (scan_line_comment source (+ index 2) length)
                          (scan_tokens source (+ index 1) length))
                        (LexicallyRejected InvalidToken index)))))))))))))

(def scan_tokens ((source Bytes) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    LexicallyValid
    (let c (bytes_get source index)
      (if (is_space c)
        (scan_tokens source (+ index 1) length)
        (if (is_ident_start c)
          (scan_identifier source (+ index 1) length)
          (if (is_digit c)
            (scan_number source index index length 0)
            (if (eq c 34)
              (scan_string source index (+ index 1) length)
              (if (eq c 39)
                (scan_character source index (+ index 1) length)
                (scan_operator source index length c)))))))))

(def check_source_bytes ((source Bytes) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    (scan_tokens source 0 length)
    (if (source_byte_allowed (bytes_get source index))
      (check_source_bytes source (+ index 1) length)
      (LexicallyRejected InvalidSourceByte index))))

(def check_lexical ((source Bytes)) DeltaLexicalOutcome
  (check_source_bytes source 0 (bytes_length source)))

; ---- allocation-free syntax-token rescan -------------------------------
;
; These scalar helpers are called only after LexicallyValid. A parser keeps a
; source cursor, skips trivia to the next start (or source extent at EOF), and
; rescans code, end, or literal value as needed. No token fact enters the
; immutable Gamma heap and no coordinate is packed into a narrower integer.

(def delta_span_is_2 ((source Bytes) (start Int) (end Int) (a Int) (b Int)) Int
  (if (eq (- end start) 2)
    (if (eq (bytes_get source start) a) (eq (bytes_get source (+ start 1)) b) 0)
    0))

(def delta_span_is_3 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int)) Int
  (if (eq (- end start) 3)
    (if (delta_span_is_2 source start (+ start 2) a b) (eq (bytes_get source (+ start 2)) c) 0)
    0))

(def delta_span_is_4 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int)) Int
  (if (eq (- end start) 4)
    (if (delta_span_is_3 source start (+ start 3) a b c) (eq (bytes_get source (+ start 3)) d) 0)
    0))

(def delta_span_is_5 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int)) Int
  (if (eq (- end start) 5)
    (if (delta_span_is_4 source start (+ start 4) a b c d) (eq (bytes_get source (+ start 4)) e) 0)
    0))

(def delta_span_is_6 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int)) Int
  (if (eq (- end start) 6)
    (if (delta_span_is_5 source start (+ start 5) a b c d e) (eq (bytes_get source (+ start 5)) f) 0)
    0))

(def delta_span_is_7 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int)) Int
  (if (eq (- end start) 7)
    (if (delta_span_is_6 source start (+ start 6) a b c d e f) (eq (bytes_get source (+ start 6)) g) 0)
    0))

(def delta_span_is_8 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int)) Int
  (if (eq (- end start) 8)
    (if (delta_span_is_7 source start (+ start 7) a b c d e f g) (eq (bytes_get source (+ start 7)) h) 0)
    0))

(def delta_span_is_10 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int) (i Int) (j Int)) Int
  (if (eq (- end start) 10)
    (if (delta_span_is_8 source start (+ start 8) a b c d e f g h)
      (if (eq (bytes_get source (+ start 8)) i) (eq (bytes_get source (+ start 9)) j) 0)
      0)
    0))

(def delta_keyword_code ((source Bytes) (start Int) (end Int)) Int
  (if (delta_span_is_8 source start end 98 111 117 110 100 97 114 121) 10
    (if (delta_span_is_5 source start end 116 114 97 105 116) 11
      (if (delta_span_is_4 source start end 100 97 116 97) 12
        (if (delta_span_is_4 source start end 99 97 115 101) 13
          (if (delta_span_is_7 source start end 109 97 99 104 105 110 101) 14
            (if (delta_span_is_5 source start end 115 116 97 116 101) 15
              (if (delta_span_is_10 source start end 116 114 97 110 115 105 116 105 111 110) 16
                (if (delta_span_is_3 source start end 108 101 116) 17
                  (if (delta_span_is_6 source start end 114 101 116 117 114 110) 18
                    (if (delta_span_is_6 source start end 97 115 115 101 114 116) 19
                      (if (delta_span_is_4 source start end 116 114 117 101) 20
                        (if (delta_span_is_5 source start end 102 97 108 115 101) 21
                          (if (delta_span_is_4 source start end 115 101 108 102) 22
                            (if (delta_span_is_3 source start end 109 117 116) 23
                              (if (delta_span_is_3 source start end 105 51 50) 24
                                (if (delta_span_is_2 source start end 117 56) 25
                                  (if (delta_span_is_5 source start end 110 101 118 101 114) 26 1))))))))))))))))))

(def delta_skip_comment ((source Bytes) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (let commentByte (bytes_get source index)
      (if (eq commentByte 10)
        (delta_token_start source index)
        (if (eq commentByte 13)
          (delta_token_start source index)
          (delta_skip_comment source (+ index 1) length))))))

(def delta_token_start ((source Bytes) (index Int)) Int
  (let length (bytes_length source)
    (if (eq index length)
      length
      (let startByte (bytes_get source index)
        (if (is_space startByte)
          (delta_token_start source (+ index 1))
          (if (eq startByte 47)
            (if (next_is source index length 47)
              (delta_skip_comment source (+ index 2) length)
              index)
            index))))))

(def delta_identifier_end ((source Bytes) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (if (is_ident_continue (bytes_get source index))
      (delta_identifier_end source (+ index 1) length)
      index)))

(def delta_number_end ((source Bytes) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (if (is_digit (bytes_get source index))
      (delta_number_end source (+ index 1) length)
      index)))

(def delta_string_end ((source Bytes) (index Int)) Int
  (let stringByte (bytes_get source index)
    (if (eq stringByte 34)
      (+ index 1)
      (if (eq stringByte 92)
        (if (eq (bytes_get source (+ index 1)) 120)
          (delta_string_end source (+ index 4))
          (delta_string_end source (+ index 2)))
        (delta_string_end source (+ index 1))))))

(def delta_character_end ((source Bytes) (start Int)) Int
  (if (eq (bytes_get source (+ start 1)) 92)
    (if (eq (bytes_get source (+ start 2)) 120) (+ start 6) (+ start 4))
    (+ start 3)))

(def delta_operator_end ((source Bytes) (start Int) (length Int) (operatorByte Int)) Int
  (if (eq operatorByte 58)
    (if (next_is source start length 58) (+ start 2) (+ start 1))
    (if (eq operatorByte 45)
      (if (next_is source start length 62) (+ start 2) (+ start 1))
      (if (eq operatorByte 38)
        (if (next_is source start length 38) (+ start 2) (+ start 1))
        (if (eq operatorByte 124)
          (if (next_is source start length 124) (+ start 2) (+ start 1))
          (if (eq operatorByte 61)
            (if (next_is source start length 61) (+ start 2) (+ start 1))
            (if (eq operatorByte 33) (+ start 2)
              (if (eq operatorByte 60)
                (if (next_is source start length 61) (+ start 2)
                  (if (next_is source start length 60) (+ start 2) (+ start 1)))
                (if (eq operatorByte 62)
                  (if (next_is source start length 61) (+ start 2)
                    (if (next_is source start length 62) (+ start 2) (+ start 1)))
                  (if (eq operatorByte 46)
                    (if (next_is source start length 46) (+ start 2) (+ start 1))
                    (+ start 1)))))))))))

(def delta_token_end ((source Bytes) (start Int)) Int
  (let length (bytes_length source)
    (if (eq start length)
      length
      (let tokenByte (bytes_get source start)
        (if (is_ident_start tokenByte)
          (delta_identifier_end source (+ start 1) length)
          (if (is_digit tokenByte)
            (delta_number_end source (+ start 1) length)
            (if (eq tokenByte 34)
              (delta_string_end source (+ start 1))
              (if (eq tokenByte 39)
                (delta_character_end source start)
                (delta_operator_end source start length tokenByte)))))))))

(def delta_operator_code ((source Bytes) (start Int) (length Int) (operatorByte Int)) Int
  (if (eq operatorByte 123) 30 (if (eq operatorByte 125) 31
    (if (eq operatorByte 40) 32 (if (eq operatorByte 41) 33
      (if (eq operatorByte 91) 34 (if (eq operatorByte 93) 35
        (if (eq operatorByte 59) 36
          (if (eq operatorByte 58) (if (next_is source start length 58) 43 37)
            (if (eq operatorByte 44) 38
              (if (eq operatorByte 46) (if (next_is source start length 46) 44 39)
                (if (eq operatorByte 38) (if (next_is source start length 38) 46 40)
                  (if (eq operatorByte 61) (if (next_is source start length 61) 49 41)
                    (if (eq operatorByte 45) (if (next_is source start length 62) 42 58)
                      (if (eq operatorByte 124) (if (next_is source start length 124) 45 47)
                        (if (eq operatorByte 94) 48 (if (eq operatorByte 33) 50
                          (if (eq operatorByte 60)
                            (if (next_is source start length 61) 52
                              (if (next_is source start length 60) 55 51))
                            (if (eq operatorByte 62)
                              (if (next_is source start length 61) 54
                                (if (next_is source start length 62) 56 53))
                              (if (eq operatorByte 43) 57
                                (if (eq operatorByte 42) 59
                                  (if (eq operatorByte 47) 60 61))))))))))))))))))))))

(def delta_token_code ((source Bytes) (start Int)) Int
  (let length (bytes_length source)
    (if (eq start length)
      0
      (let tokenByte (bytes_get source start)
        (if (is_ident_start tokenByte)
          (delta_keyword_code source start (delta_identifier_end source (+ start 1) length))
          (if (is_digit tokenByte) 2
            (if (eq tokenByte 39) 3
              (if (eq tokenByte 34) 4
                (delta_operator_code source start length tokenByte)))))))))

(def delta_hex_value ((c Int)) Int
  (if (is_digit c) (- c 48)
    (if (ascii_between c 65 70) (+ (- c 65) 10) (+ (- c 97) 10))))

(def delta_escape_value ((c Int)) Int
  (if (eq c 110) 10 (if (eq c 114) 13 (if (eq c 116) 9 c))))

(def delta_character_value ((source Bytes) (opening Int)) Int
  (let characterByte (bytes_get source (+ opening 1))
    (if (eq characterByte 92)
      (let escapeByte (bytes_get source (+ opening 2))
        (if (eq escapeByte 120)
          (+ (* (delta_hex_value (bytes_get source (+ opening 3))) 16)
             (delta_hex_value (bytes_get source (+ opening 4))))
          (delta_escape_value escapeByte)))
      characterByte)))

(def delta_number_value ((source Bytes) (index Int) (end Int) (value Int)) Int
  (if (eq index end)
    value
    (delta_number_value source (+ index 1) end
      (+ (* value 10) (- (bytes_get source index) 48)))))

(def delta_token_value ((source Bytes) (start Int)) Int
  (let length (bytes_length source)
    (if (eq start length)
      0
      (let tokenByte (bytes_get source start)
        (if (is_digit tokenByte)
          (delta_number_value source start (delta_number_end source (+ start 1) length) 0)
          (if (eq tokenByte 39) (delta_character_value source start) 0))))))

; ---- type and expression parsing ---------------------------------------

(def delta_type_start ((typeValue DeltaType)) Int
  (match typeValue
    ((DeltaI32Type start end) start)
    ((DeltaU8Type start end) start)
    ((DeltaNeverType start end) start)
    ((DeltaNamedType start end name) start)
    ((DeltaArrayType start end element lengthValue) start)
    ((DeltaViewType start end element) start)))

(def delta_type_end ((typeValue DeltaType)) Int
  (match typeValue
    ((DeltaI32Type start end) end)
    ((DeltaU8Type start end) end)
    ((DeltaNeverType start end) end)
    ((DeltaNamedType start end name) end)
    ((DeltaArrayType start end element lengthValue) end)
    ((DeltaViewType start end element) end)))

(def delta_expression_start ((expressionValue DeltaExpression)) Int
  (match expressionValue
    ((DeltaIntegerExpression start end literal) start)
    ((DeltaCharacterExpression start end literal) start)
    ((DeltaStringExpression start end literal) start)
    ((DeltaTrueExpression start end) start)
    ((DeltaFalseExpression start end) start)
    ((DeltaSelfExpression start end) start)
    ((DeltaNameExpression start end name) start)
    ((DeltaQualifiedExpression start end owner name arguments) start)
    ((DeltaGroupedExpression start end inner) start)
    ((DeltaFieldExpression start end base field) start)
    ((DeltaCallExpression start end base arguments) start)
    ((DeltaIndexExpression start end base indexValue) start)
    ((DeltaSliceExpression start end base low high) start)
    ((DeltaNegateExpression start end operand) start)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd left right) start)))

(def delta_expression_end ((expressionValue DeltaExpression)) Int
  (match expressionValue
    ((DeltaIntegerExpression start end literal) end)
    ((DeltaCharacterExpression start end literal) end)
    ((DeltaStringExpression start end literal) end)
    ((DeltaTrueExpression start end) end)
    ((DeltaFalseExpression start end) end)
    ((DeltaSelfExpression start end) end)
    ((DeltaNameExpression start end name) end)
    ((DeltaQualifiedExpression start end owner name arguments) end)
    ((DeltaGroupedExpression start end inner) end)
    ((DeltaFieldExpression start end base field) end)
    ((DeltaCallExpression start end base arguments) end)
    ((DeltaIndexExpression start end base indexValue) end)
    ((DeltaSliceExpression start end base low high) end)
    ((DeltaNegateExpression start end operand) end)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd left right) end)))

(def delta_type_reject_at ((source Bytes) (cursor Int)) DeltaTypeParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaTypeParseRejected UnexpectedEnd start)
      (DeltaTypeParseRejected UnexpectedToken start))))

(def delta_expression_reject_at ((source Bytes) (cursor Int)) DeltaExpressionParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaExpressionParseRejected UnexpectedEnd start)
      (DeltaExpressionParseRejected UnexpectedToken start))))

(def delta_arguments_reject_at ((source Bytes) (cursor Int)) DeltaArgumentsParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaArgumentsParseRejected UnexpectedEnd start)
      (DeltaArgumentsParseRejected UnexpectedToken start))))

(def delta_reverse_expression_list ((input DeltaExpressionList)
  (output DeltaExpressionList)) DeltaExpressionList
  (match input
    (NoDeltaExpressions output)
    ((MoreDeltaExpressions item rest)
      (delta_reverse_expression_list rest (MoreDeltaExpressions item output)))))

(def delta_parse_array_length ((source Bytes) (arrayStart Int)
  (elementType DeltaType) (cursor Int)) DeltaTypeParseOutcome
  (let lengthStart (delta_token_start source cursor)
    (if (eq (delta_token_code source lengthStart) 2)
      (if (eq (delta_token_value source lengthStart) 2147483648)
        (DeltaTypeParseRejected IntegerLiteralOutOfRange lengthStart)
        (let lengthEnd (delta_token_end source lengthStart)
          (let closeStart (delta_token_start source lengthEnd)
            (if (eq (delta_token_code source closeStart) 35)
              (let closeEnd (delta_token_end source closeStart)
                (DeltaTypeParsed
                  (DeltaArrayType arrayStart closeEnd elementType
                    (DeltaIntegerSpan lengthStart lengthEnd
                      (delta_token_value source lengthStart)))))
              (delta_type_reject_at source lengthEnd)))))
      (delta_type_reject_at source cursor))))

(def delta_parse_array_type ((source Bytes) (arrayStart Int) (cursor Int)) DeltaTypeParseOutcome
  (let elementOutcome (delta_parse_type source cursor)
    (match elementOutcome
      ((DeltaTypeParseRejected reasonValue errorOffset) elementOutcome)
      ((DeltaTypeParsed elementType)
        (let semiStart (delta_token_start source (delta_type_end elementType))
          (if (eq (delta_token_code source semiStart) 36)
            (delta_parse_array_length source arrayStart elementType
              (delta_token_end source semiStart))
            (delta_type_reject_at source (delta_type_end elementType))))))))

(def delta_parse_view_element ((source Bytes) (viewStart Int) (cursor Int)) DeltaTypeParseOutcome
  (let elementOutcome (delta_parse_type source cursor)
    (match elementOutcome
      ((DeltaTypeParseRejected reasonValue errorOffset) elementOutcome)
      ((DeltaTypeParsed elementType)
        (let closeStart (delta_token_start source (delta_type_end elementType))
          (if (eq (delta_token_code source closeStart) 35)
            (let closeEnd (delta_token_end source closeStart)
              (DeltaTypeParsed (DeltaViewType viewStart closeEnd elementType)))
            (delta_type_reject_at source (delta_type_end elementType))))))))

(def delta_parse_type ((source Bytes) (cursor Int)) DeltaTypeParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaTypeParseRejected UnexpectedEnd start)
        (let end (delta_token_end source start)
          (if (eq code 24) (DeltaTypeParsed (DeltaI32Type start end))
            (if (eq code 25) (DeltaTypeParsed (DeltaU8Type start end))
              (if (eq code 26) (DeltaTypeParsed (DeltaNeverType start end))
                (if (eq code 1)
                  (DeltaTypeParsed (DeltaNamedType start end (DeltaNameSpan start end)))
                  (if (eq code 34)
                    (delta_parse_array_type source start end)
                    (if (eq code 40)
                      (let openStart (delta_token_start source end)
                        (if (eq (delta_token_code source openStart) 34)
                          (delta_parse_view_element source start
                            (delta_token_end source openStart))
                          (delta_type_reject_at source end)))
                      (DeltaTypeParseRejected UnexpectedToken start))))))))))))

(def delta_parse_arguments_acc ((source Bytes) (cursor Int)
  (accumulator DeltaExpressionList)) DeltaArgumentsParseOutcome
  (let nextStart (delta_token_start source cursor)
    (if (eq (delta_token_code source nextStart) 33)
      (let closeEnd (delta_token_end source nextStart)
        (DeltaArgumentsParsed
          (delta_reverse_expression_list accumulator NoDeltaExpressions) closeEnd))
      (let expressionOutcome (delta_parse_expression source nextStart)
        (match expressionOutcome
          ((DeltaExpressionParseRejected reasonValue errorOffset)
            (DeltaArgumentsParseRejected reasonValue errorOffset))
          ((DeltaExpressionParsed expressionValue)
            (let afterExpression (delta_token_start source
              (delta_expression_end expressionValue))
              (let afterCode (delta_token_code source afterExpression)
                (if (eq afterCode 38)
                  (let afterComma (delta_token_end source afterExpression)
                    (let followingStart (delta_token_start source afterComma)
                      (if (eq (delta_token_code source followingStart) 33)
                        (DeltaArgumentsParseRejected UnexpectedToken followingStart)
                        (delta_parse_arguments_acc source afterComma
                          (MoreDeltaExpressions expressionValue accumulator)))))
                  (if (eq afterCode 33)
                    (let closeEnd (delta_token_end source afterExpression)
                      (DeltaArgumentsParsed
                        (delta_reverse_expression_list
                          (MoreDeltaExpressions expressionValue accumulator)
                          NoDeltaExpressions) closeEnd))
                    (delta_arguments_reject_at source afterExpression)))))))))))

(def delta_parse_qualified_primary ((source Bytes) (firstStart Int)
  (firstEnd Int) (cursor Int)) DeltaExpressionParseOutcome
  (let secondStart (delta_token_start source cursor)
    (if (eq (delta_token_code source secondStart) 1)
      (let secondEnd (delta_token_end source secondStart)
        (let openStart (delta_token_start source secondEnd)
          (if (eq (delta_token_code source openStart) 32)
            (let argumentsOutcome
              (delta_parse_arguments_acc source
                (delta_token_end source openStart) NoDeltaExpressions)
              (match argumentsOutcome
                ((DeltaArgumentsParseRejected reasonValue errorOffset)
                  (DeltaExpressionParseRejected reasonValue errorOffset))
                ((DeltaArgumentsParsed arguments closeEnd)
                  (DeltaExpressionParsed
                    (DeltaQualifiedExpression firstStart closeEnd
                      (DeltaNameSpan firstStart firstEnd)
                      (DeltaNameSpan secondStart secondEnd)
                      (SomeDeltaArguments openStart closeEnd arguments))))))
            (DeltaExpressionParsed
              (DeltaQualifiedExpression firstStart secondEnd
                (DeltaNameSpan firstStart firstEnd)
                (DeltaNameSpan secondStart secondEnd) NoDeltaArguments)))))
      (delta_expression_reject_at source cursor))))

(def delta_parse_primary ((source Bytes) (cursor Int)) DeltaExpressionParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaExpressionParseRejected UnexpectedEnd start)
        (let end (delta_token_end source start)
          (if (eq code 2)
            (if (eq (delta_token_value source start) 2147483648)
              (DeltaExpressionParseRejected IntegerLiteralOutOfRange start)
              (DeltaExpressionParsed
                (DeltaIntegerExpression start end
                  (DeltaIntegerSpan start end (delta_token_value source start)))))
            (if (eq code 3)
              (DeltaExpressionParsed
                (DeltaCharacterExpression start end
                  (DeltaCharacterSpan start end (delta_token_value source start))))
              (if (eq code 4)
                (DeltaExpressionParsed
                  (DeltaStringExpression start end (DeltaStringSpan start end)))
                (if (eq code 20) (DeltaExpressionParsed (DeltaTrueExpression start end))
                  (if (eq code 21) (DeltaExpressionParsed (DeltaFalseExpression start end))
                    (if (eq code 22) (DeltaExpressionParsed (DeltaSelfExpression start end))
                      (if (eq code 1)
                        (let scopeStart (delta_token_start source end)
                          (if (eq (delta_token_code source scopeStart) 43)
                            (delta_parse_qualified_primary source start end
                              (delta_token_end source scopeStart))
                            (DeltaExpressionParsed
                              (DeltaNameExpression start end (DeltaNameSpan start end)))))
                        (if (eq code 32)
                          (let innerOutcome (delta_parse_expression source end)
                            (match innerOutcome
                              ((DeltaExpressionParseRejected reasonValue errorOffset) innerOutcome)
                              ((DeltaExpressionParsed innerExpression)
                                (let closeStart (delta_token_start source
                                  (delta_expression_end innerExpression))
                                  (if (eq (delta_token_code source closeStart) 33)
                                    (let closeEnd (delta_token_end source closeStart)
                                      (DeltaExpressionParsed
                                        (DeltaGroupedExpression start closeEnd innerExpression)))
                                    (delta_expression_reject_at source
                                      (delta_expression_end innerExpression)))))))
                          (DeltaExpressionParseRejected UnexpectedToken start))))))))))))))

(def delta_parse_slice_high ((source Bytes) (base DeltaExpression)
  (rangeCursor Int) (low DeltaOptionalExpression)) DeltaExpressionParseOutcome
  (let highStart (delta_token_start source rangeCursor)
    (if (eq (delta_token_code source highStart) 35)
      (let closeEnd (delta_token_end source highStart)
        (delta_parse_postfix_tail source
          (DeltaExpressionParsed
            (DeltaSliceExpression (delta_expression_start base) closeEnd base low NoDeltaExpression))))
      (let highOutcome (delta_parse_expression source highStart)
        (match highOutcome
          ((DeltaExpressionParseRejected reasonValue errorOffset) highOutcome)
          ((DeltaExpressionParsed highExpression)
            (let closeStart (delta_token_start source (delta_expression_end highExpression))
              (if (eq (delta_token_code source closeStart) 35)
                (let closeEnd (delta_token_end source closeStart)
                  (delta_parse_postfix_tail source
                    (DeltaExpressionParsed
                      (DeltaSliceExpression (delta_expression_start base) closeEnd base low
                        (SomeDeltaExpression highExpression)))))
                (delta_expression_reject_at source
                  (delta_expression_end highExpression))))))))))

(def delta_parse_bracket_suffix ((source Bytes) (base DeltaExpression)
  (openStart Int)) DeltaExpressionParseOutcome
  (let afterOpen (delta_token_end source openStart)
    (let firstStart (delta_token_start source afterOpen)
      (if (eq (delta_token_code source firstStart) 44)
        (delta_parse_slice_high source base (delta_token_end source firstStart) NoDeltaExpression)
        (let indexOutcome (delta_parse_expression source firstStart)
          (match indexOutcome
            ((DeltaExpressionParseRejected reasonValue errorOffset) indexOutcome)
            ((DeltaExpressionParsed indexExpression)
              (let followingStart (delta_token_start source
                (delta_expression_end indexExpression))
                (if (eq (delta_token_code source followingStart) 44)
                  (delta_parse_slice_high source base
                    (delta_token_end source followingStart)
                    (SomeDeltaExpression indexExpression))
                  (if (eq (delta_token_code source followingStart) 35)
                    (let closeEnd (delta_token_end source followingStart)
                      (delta_parse_postfix_tail source
                        (DeltaExpressionParsed
                          (DeltaIndexExpression (delta_expression_start base) closeEnd
                            base indexExpression))))
                    (delta_expression_reject_at source
                      (delta_expression_end indexExpression))))))))))))

(def delta_parse_call_suffix ((source Bytes) (base DeltaExpression)
  (openStart Int)) DeltaExpressionParseOutcome
  (let argumentsOutcome
    (delta_parse_arguments_acc source
      (delta_token_end source openStart) NoDeltaExpressions)
    (match argumentsOutcome
      ((DeltaArgumentsParseRejected reasonValue errorOffset)
        (DeltaExpressionParseRejected reasonValue errorOffset))
      ((DeltaArgumentsParsed arguments callEnd)
        (delta_parse_postfix_tail source
          (DeltaExpressionParsed
            (DeltaCallExpression (delta_expression_start base) callEnd base arguments)))))))

(def delta_parse_postfix_tail ((source Bytes)
  (current DeltaExpressionParseOutcome)) DeltaExpressionParseOutcome
  (match current
    ((DeltaExpressionParseRejected reasonValue errorOffset) current)
    ((DeltaExpressionParsed base)
      (let suffixStart (delta_token_start source (delta_expression_end base))
        (let suffixCode (delta_token_code source suffixStart)
          (if (eq suffixCode 39)
            (let fieldStart (delta_token_start source (delta_token_end source suffixStart))
              (if (eq (delta_token_code source fieldStart) 1)
                (let fieldEnd (delta_token_end source fieldStart)
                  (delta_parse_postfix_tail source
                    (DeltaExpressionParsed
                      (DeltaFieldExpression (delta_expression_start base) fieldEnd base
                        (DeltaNameSpan fieldStart fieldEnd)))))
                (delta_expression_reject_at source (delta_token_end source suffixStart))))
            (if (eq suffixCode 32)
              (delta_parse_call_suffix source base suffixStart)
              (if (eq suffixCode 34)
                (delta_parse_bracket_suffix source base suffixStart)
                current))))))))

(def delta_parse_postfix ((source Bytes) (cursor Int)) DeltaExpressionParseOutcome
  (delta_parse_postfix_tail source (delta_parse_primary source cursor)))

(def delta_is_postfix_code ((code Int)) Int
  (if (eq code 39) 1 (if (eq code 32) 1 (eq code 34))))

(def delta_parse_unary ((source Bytes) (cursor Int)) DeltaExpressionParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq (delta_token_code source start) 58)
      (let afterMinus (delta_token_end source start)
        (let operandStart (delta_token_start source afterMinus)
          (if (eq (delta_token_code source operandStart) 2)
            (if (eq (delta_token_value source operandStart) 2147483648)
              (let literalEnd (delta_token_end source operandStart)
                (let followingStart (delta_token_start source literalEnd)
                  (if (delta_is_postfix_code (delta_token_code source followingStart))
                    (DeltaExpressionParseRejected IntegerLiteralOutOfRange operandStart)
                    (DeltaExpressionParsed
                      (DeltaNegateExpression start literalEnd
                        (DeltaIntegerExpression operandStart literalEnd
                          (DeltaIntegerSpan operandStart literalEnd 2147483648)))))))
              (let operandOutcome (delta_parse_unary source afterMinus)
                (match operandOutcome
                  ((DeltaExpressionParseRejected reasonValue errorOffset) operandOutcome)
                  ((DeltaExpressionParsed operand)
                    (DeltaExpressionParsed
                      (DeltaNegateExpression start (delta_expression_end operand) operand))))))
            (let operandOutcome (delta_parse_unary source afterMinus)
              (match operandOutcome
                ((DeltaExpressionParseRejected reasonValue errorOffset) operandOutcome)
                ((DeltaExpressionParsed operand)
                  (DeltaExpressionParsed
                    (DeltaNegateExpression start (delta_expression_end operand) operand))))))))
      (delta_parse_postfix source start))))

(def delta_binary_precedence ((operatorCode Int)) Int
  (if (eq operatorCode 45) 1 (if (eq operatorCode 46) 2
    (if (eq operatorCode 47) 3 (if (eq operatorCode 48) 4
      (if (eq operatorCode 40) 5 (if (eq operatorCode 49) 6
        (if (eq operatorCode 50) 6 (if (eq operatorCode 51) 7
          (if (eq operatorCode 52) 7 (if (eq operatorCode 53) 7
            (if (eq operatorCode 54) 7 (if (eq operatorCode 55) 8
              (if (eq operatorCode 56) 8 (if (eq operatorCode 57) 9
                (if (eq operatorCode 58) 9 (if (eq operatorCode 59) 10
                  (if (eq operatorCode 60) 10 (if (eq operatorCode 61) 10 0)))))))))))))))))))

(def delta_binary_operator ((operatorCode Int)) DeltaBinaryOperator
  (if (eq operatorCode 45) DeltaLogicalOr (if (eq operatorCode 46) DeltaLogicalAnd
    (if (eq operatorCode 47) DeltaBitOr (if (eq operatorCode 48) DeltaBitXor
      (if (eq operatorCode 40) DeltaBitAnd (if (eq operatorCode 49) DeltaEqual
        (if (eq operatorCode 50) DeltaNotEqual (if (eq operatorCode 51) DeltaLess
          (if (eq operatorCode 52) DeltaLessEqual (if (eq operatorCode 53) DeltaGreater
            (if (eq operatorCode 54) DeltaGreaterEqual (if (eq operatorCode 55) DeltaShiftLeft
              (if (eq operatorCode 56) DeltaShiftRight (if (eq operatorCode 57) DeltaAdd
                (if (eq operatorCode 58) DeltaSubtract (if (eq operatorCode 59) DeltaMultiply
                  (if (eq operatorCode 60) DeltaDivide DeltaRemainder))))))))))))))))))

(def delta_finish_binary ((source Bytes) (minimum Int) (left DeltaExpression)
  (operatorStart Int) (operatorCode Int) (rightOutcome DeltaExpressionParseOutcome)) DeltaExpressionParseOutcome
  (match rightOutcome
    ((DeltaExpressionParseRejected reasonValue errorOffset) rightOutcome)
    ((DeltaExpressionParsed right)
      (delta_parse_binary_tail source minimum
        (DeltaExpressionParsed
          (DeltaBinaryExpression (delta_expression_start left)
            (delta_expression_end right) (delta_binary_operator operatorCode)
            operatorStart (delta_token_end source operatorStart) left right))))))

(def delta_parse_binary_tail ((source Bytes) (minimum Int)
  (current DeltaExpressionParseOutcome)) DeltaExpressionParseOutcome
  (match current
    ((DeltaExpressionParseRejected reasonValue errorOffset) current)
    ((DeltaExpressionParsed left)
      (let operatorStart (delta_token_start source (delta_expression_end left))
        (let operatorCode (delta_token_code source operatorStart)
          (let precedenceValue (delta_binary_precedence operatorCode)
            (if (lt precedenceValue minimum)
              current
              (delta_finish_binary source minimum left operatorStart operatorCode
                (delta_parse_binary_min source (delta_token_end source operatorStart)
                  (+ precedenceValue 1))))))))))

(def delta_parse_binary_min ((source Bytes) (cursor Int)
  (minimum Int)) DeltaExpressionParseOutcome
  (delta_parse_binary_tail source minimum (delta_parse_unary source cursor)))

(def delta_parse_expression ((source Bytes) (cursor Int)) DeltaExpressionParseOutcome
  (delta_parse_binary_min source cursor 1))
