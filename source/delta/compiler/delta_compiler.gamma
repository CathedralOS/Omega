            (DeltaAlphaTrieInserted
              (DeltaAlphaTrieBranch
                (SomeDeltaAlphaTrieValue insertedValue)
                EmptyDeltaAlphaTrie EmptyDeltaAlphaTrie))
            DeltaAlphaTrieInsertInvalid)
          (if (eq (% key 2) 0)
            (match (delta_alpha_trie_insert_depth EmptyDeltaAlphaTrie
              (/ key 2) (- depth 1) insertedValue)
              ((DeltaAlphaTrieInserted low)
                (DeltaAlphaTrieInserted
                  (DeltaAlphaTrieBranch NoDeltaAlphaTrieValue low
                    EmptyDeltaAlphaTrie)))
              (DeltaAlphaTrieInsertDuplicate DeltaAlphaTrieInsertDuplicate)
              (DeltaAlphaTrieInsertInvalid DeltaAlphaTrieInsertInvalid))
            (match (delta_alpha_trie_insert_depth EmptyDeltaAlphaTrie
              (/ key 2) (- depth 1) insertedValue)
              ((DeltaAlphaTrieInserted high)
                (DeltaAlphaTrieInserted
                  (DeltaAlphaTrieBranch NoDeltaAlphaTrieValue
