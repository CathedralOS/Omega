    ((DeltaDataDeclaration start end name members) end)
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue) end)))

(def delta_reverse_declarations ((input DeltaDeclarationList)
  (output DeltaDeclarationList)) DeltaDeclarationList
  (match input
