                                  references
                                  NoDeltaResolvedLocalReferences)
                                (delta_reverse_resolved_field_references fields
                                  NoDeltaResolvedFieldReferences)
                                (delta_reverse_resolved_callable_references
                                  callables NoDeltaResolvedCallableReferences)
                                (delta_reverse_control_references
                                  stateApplications)
                                (delta_reverse_typed_expressions types
                                  NoDeltaTypedExpressions)
                                finalCandidate))))))))))))))))

