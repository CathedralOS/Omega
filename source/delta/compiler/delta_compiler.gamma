  (DeltaCensusAccepted DeltaCollectedProgram)
  (DeltaCensusRejected DeltaRejectReason Int))

(data DeltaCensusLocalScan
  (DeltaCensusLocalScanResult DeltaCensusCandidate DeltaNameList))

; Type-name validation begins D17's type-formation phase without claiming the
; later data-shape, recursive-value, placement, entry, or body judgments.  It
; accumulates candidates because declaration traversal order cannot override
; the earliest authored unknown-type coordinate.
(data DeltaTypeNameCandidate
  (NoDeltaTypeNameCandidate)
  (DeltaUnknownTypeCandidate Int))

(data DeltaTypeNameScan
  (DeltaTypeNameScanResult DeltaCollectedProgram DeltaTypeNameCandidate))

(data DeltaOwnerIdentity
  (NoDeltaOwnerIdentity)
  (OneDeltaBoundaryOwner)
  (OneDeltaDataOwner)
  (AmbiguousDeltaOwnerIdentity))

; The direct backend keeps Alpha construction symbolic until every label has an
; exact payload offset.  Label ids are dense in `0 .. label_count`; the private
; 20-level trie covers the complete 1,048,572-byte AlphaBootstrapV2 payload
; profile without
; linear lookup or a mutable patch table.
(data DeltaAlphaItem
  (DeltaAlphaLabel Int)
  (DeltaAlphaHalt Int)
  (DeltaAlphaImm Int Int)
  (DeltaAlphaMov Int Int)
  (DeltaAlphaAdd Int Int)
  (DeltaAlphaSub Int Int)
  (DeltaAlphaMul Int Int)
  (DeltaAlphaDiv Int Int)
  (DeltaAlphaMod Int Int)
  (DeltaAlphaLoadByte Int Int)
  (DeltaAlphaStoreByte Int Int)
  (DeltaAlphaLoadWord Int Int)
  (DeltaAlphaStoreWord Int Int)
  (DeltaAlphaJump Int)
  (DeltaAlphaJumpZero Int Int)
  (DeltaAlphaJumpNonzero Int Int)
  (DeltaAlphaJumpLess Int Int Int)
  (DeltaAlphaJumpEqual Int Int Int)
  (DeltaAlphaRead Int)
  (DeltaAlphaWrite Int)
  (DeltaAlphaCall Int)
  (DeltaAlphaReturn))

(data DeltaAlphaItemList
  (NoDeltaAlphaItems)
  (MoreDeltaAlphaItems DeltaAlphaItem DeltaAlphaItemList))

(data DeltaAlphaProgram
  (DeltaAlphaProgramItems Int DeltaAlphaItemList))

(data DeltaAlphaTrieValue
  (NoDeltaAlphaTrieValue)
  (SomeDeltaAlphaTrieValue Int))

(data DeltaAlphaTrie
  (EmptyDeltaAlphaTrie)
  (DeltaAlphaTrieBranch DeltaAlphaTrieValue DeltaAlphaTrie DeltaAlphaTrie))

(data DeltaAlphaTrieInsertOutcome
  (DeltaAlphaTrieInserted DeltaAlphaTrie)
  (DeltaAlphaTrieInsertDuplicate)
  (DeltaAlphaTrieInsertInvalid))

(data DeltaAlphaLayoutOutcome
  (DeltaAlphaLayoutReady Int Int DeltaAlphaTrie)
  (DeltaAlphaLayoutOversized Int)
  (DeltaAlphaLayoutInternal Int))

(data DeltaAlphaInstructionBytesOutcome
  (DeltaAlphaInstructionEncoded Bytes)
  (DeltaAlphaInstructionInternal Int))

(data DeltaAlphaBalancedBytesOutcome
  (DeltaAlphaBalancedBytes Bytes DeltaAlphaItemList)
  (DeltaAlphaBalancedInternal Int))

(data DeltaAlphaReplayTargetSetOutcome
  (DeltaAlphaReplayTargetSet DeltaAlphaTrie Int)
  (DeltaAlphaReplayTargetSetInternal Int))

(data DeltaAlphaReplayOutcome
  (DeltaAlphaReplayValid)
  (DeltaAlphaReplayInternal Int))

; These are private compiler outcomes, not DeltaCompileOutcome cases.  The
; eventual pure compiler may hand an oversized candidate to Complete; the
; adapter's mandatory output-length preflight then reports outer Incomplete
; before validating or publishing it.  A compiler contradiction maps to
; InternalFailure.  Neither private case becomes a Delta reject.
(data DeltaAlphaEncodeOutcome
  (DeltaAlphaEncoded Bytes)
  (DeltaAlphaOversizedCandidate Bytes Int)
  (DeltaAlphaEncodingInternal Int))

(def ascii_between ((c Int) (low Int) (high Int)) Int
  (if (lt c low) 0 (if (lt high c) 0 1)))

(def source_byte_allowed ((c Int)) Int
  (if (eq c 9) 1
    (if (eq c 10) 1
      (if (eq c 13) 1
        (ascii_between c 32 126)))))

(def is_space ((c Int)) Int
  (if (eq c 32) 1
    (if (eq c 9) 1
      (if (eq c 10) 1 (eq c 13)))))

(def is_digit ((c Int)) Int
  (ascii_between c 48 57))

(def is_upper ((c Int)) Int
  (ascii_between c 65 90))

(def is_lower ((c Int)) Int
  (ascii_between c 97 122))

(def is_ident_start ((c Int)) Int
  (if (is_upper c) 1
    (if (is_lower c) 1 (eq c 95))))

(def is_ident_continue ((c Int)) Int
  (if (is_ident_start c) 1 (is_digit c)))

(def is_hex_digit ((c Int)) Int
  (if (is_digit c) 1
    (if (ascii_between c 65 70) 1
      (ascii_between c 97 102))))

(def is_printable ((c Int)) Int
  (ascii_between c 32 126))

(def is_simple_escape ((c Int)) Int
  (if (eq c 110) 1
    (if (eq c 114) 1
      (if (eq c 116) 1
        (if (eq c 34) 1 (eq c 92))))))

(def next_is ((source Bytes) (index Int) (length Int) (expected Int)) Int
  (if (lt (+ index 1) length)
    (eq (bytes_get source (+ index 1)) expected)
    0))

(def scan_identifier ((source Bytes) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    (scan_tokens source index length)
    (if (is_ident_continue (bytes_get source index))
      (scan_identifier source (+ index 1) length)
      (scan_tokens source index length))))

(def scan_number ((source Bytes) (start Int) (index Int) (length Int) (value Int)) DeltaLexicalOutcome
  (if (eq index length)
    (scan_tokens source index length)
    (let c (bytes_get source index)
      (if (is_digit c)
        (let digit (- c 48)
          (if (lt value 214748364)
            (scan_number source start (+ index 1) length (+ (* value 10) digit))
            (if (eq value 214748364)
              (if (lt digit 9)
                (scan_number source start (+ index 1) length (+ (* value 10) digit))
                (LexicallyRejected IntegerLiteralOutOfRange start))
              (LexicallyRejected IntegerLiteralOutOfRange start))))
        (scan_tokens source index length)))))

(def scan_line_comment ((source Bytes) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    LexicallyValid
    (let c (bytes_get source index)
      (if (eq c 10)
        (scan_tokens source index length)
        (if (eq c 13)
          (scan_tokens source index length)
          (scan_line_comment source (+ index 1) length))))))

(def scan_string_escape ((source Bytes) (opening Int) (slash Int) (length Int)) DeltaLexicalOutcome
  (if (eq (+ slash 1) length)
    (LexicallyRejected InvalidEscape slash)
    (let c (bytes_get source (+ slash 1))
      (if (is_simple_escape c)
        (scan_string source opening (+ slash 2) length)
        (if (eq c 120)
          (if (lt (+ slash 3) length)
            (if (is_hex_digit (bytes_get source (+ slash 2)))
              (if (is_hex_digit (bytes_get source (+ slash 3)))
                (scan_string source opening (+ slash 4) length)
                (LexicallyRejected InvalidEscape slash))
              (LexicallyRejected InvalidEscape slash))
            (LexicallyRejected InvalidEscape slash))
          (LexicallyRejected InvalidEscape slash))))))

(def scan_string ((source Bytes) (opening Int) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    (LexicallyRejected UnterminatedString opening)
    (let c (bytes_get source index)
      (if (eq c 34)
        (scan_tokens source (+ index 1) length)
        (if (eq c 92)
          (scan_string_escape source opening index length)
          (if (is_printable c)
            (scan_string source opening (+ index 1) length)
            (LexicallyRejected UnterminatedString opening)))))))

(def finish_character ((source Bytes) (opening Int) (close_index Int) (length Int)) DeltaLexicalOutcome
  (if (lt close_index length)
    (if (eq (bytes_get source close_index) 39)
      (scan_tokens source (+ close_index 1) length)
      (LexicallyRejected InvalidCharacterLiteral opening))
    (LexicallyRejected InvalidCharacterLiteral opening)))

(def scan_character_escape ((source Bytes) (opening Int) (slash Int) (length Int)) DeltaLexicalOutcome
  (if (eq (+ slash 1) length)
    (LexicallyRejected InvalidEscape slash)
    (let c (bytes_get source (+ slash 1))
      (if (is_simple_escape c)
        (finish_character source opening (+ slash 2) length)
        (if (eq c 120)
          (if (lt (+ slash 3) length)
            (if (is_hex_digit (bytes_get source (+ slash 2)))
              (if (is_hex_digit (bytes_get source (+ slash 3)))
                (finish_character source opening (+ slash 4) length)
                (LexicallyRejected InvalidEscape slash))
              (LexicallyRejected InvalidEscape slash))
            (LexicallyRejected InvalidEscape slash))
          (LexicallyRejected InvalidEscape slash))))))

(def scan_character ((source Bytes) (opening Int) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    (LexicallyRejected InvalidCharacterLiteral opening)
    (let c (bytes_get source index)
      (if (eq c 92)
        (scan_character_escape source opening index length)
        (if (eq c 39)
          (LexicallyRejected InvalidCharacterLiteral opening)
          (if (is_printable c)
            (finish_character source opening (+ index 1) length)
            (LexicallyRejected InvalidCharacterLiteral opening)))))))

(def is_plain_punctuation ((c Int)) Int
  (if (eq c 123) 1
    (if (eq c 125) 1
      (if (eq c 40) 1
        (if (eq c 41) 1
          (if (eq c 91) 1
            (if (eq c 93) 1
              (if (eq c 59) 1
                (if (eq c 44) 1
                  (if (eq c 43) 1
                    (if (eq c 42) 1
                      (if (eq c 37) 1 (eq c 94)))))))))))))

(def scan_operator ((source Bytes) (index Int) (length Int) (c Int)) DeltaLexicalOutcome
  (if (is_plain_punctuation c)
    (scan_tokens source (+ index 1) length)
    (if (eq c 58)
      (if (next_is source index length 58)
        (scan_tokens source (+ index 2) length)
        (scan_tokens source (+ index 1) length))
      (if (eq c 45)
        (if (next_is source index length 62)
          (scan_tokens source (+ index 2) length)
          (scan_tokens source (+ index 1) length))
        (if (eq c 38)
          (if (next_is source index length 38)
            (scan_tokens source (+ index 2) length)
            (scan_tokens source (+ index 1) length))
          (if (eq c 124)
            (if (next_is source index length 124)
              (scan_tokens source (+ index 2) length)
              (scan_tokens source (+ index 1) length))
            (if (eq c 61)
              (if (next_is source index length 61)
                (scan_tokens source (+ index 2) length)
                (scan_tokens source (+ index 1) length))
              (if (eq c 33)
                (if (next_is source index length 61)
                  (scan_tokens source (+ index 2) length)
                  (LexicallyRejected InvalidToken index))
                (if (eq c 60)
                  (if (next_is source index length 61)
                    (scan_tokens source (+ index 2) length)
                    (if (next_is source index length 60)
                      (scan_tokens source (+ index 2) length)
                      (scan_tokens source (+ index 1) length)))
                  (if (eq c 62)
                    (if (next_is source index length 61)
                      (scan_tokens source (+ index 2) length)
                      (if (next_is source index length 62)
                        (scan_tokens source (+ index 2) length)
                        (scan_tokens source (+ index 1) length)))
                    (if (eq c 46)
                      (if (next_is source index length 46)
                        (scan_tokens source (+ index 2) length)
                        (scan_tokens source (+ index 1) length))
                      (if (eq c 47)
                        (if (next_is source index length 47)
                          (scan_line_comment source (+ index 2) length)
                          (scan_tokens source (+ index 1) length))
                        (LexicallyRejected InvalidToken index)))))))))))))

(def scan_tokens ((source Bytes) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    LexicallyValid
    (let c (bytes_get source index)
      (if (is_space c)
        (scan_tokens source (+ index 1) length)
        (if (is_ident_start c)
          (scan_identifier source (+ index 1) length)
          (if (is_digit c)
            (scan_number source index index length 0)
            (if (eq c 34)
              (scan_string source index (+ index 1) length)
              (if (eq c 39)
                (scan_character source index (+ index 1) length)
                (scan_operator source index length c)))))))))

(def check_source_bytes ((source Bytes) (index Int) (length Int)) DeltaLexicalOutcome
  (if (eq index length)
    (scan_tokens source 0 length)
    (if (source_byte_allowed (bytes_get source index))
      (check_source_bytes source (+ index 1) length)
      (LexicallyRejected InvalidSourceByte index))))

(def check_lexical ((source Bytes)) DeltaLexicalOutcome
  (check_source_bytes source 0 (bytes_length source)))

; ---- allocation-free syntax-token rescan -------------------------------
;
; These scalar helpers are called only after LexicallyValid. A parser keeps a
; source cursor, skips trivia to the next start (or source extent at EOF), and
; rescans code, end, or literal value as needed. No token fact enters the
; immutable Gamma heap and no coordinate is packed into a narrower integer.

(def delta_span_is_1 ((source Bytes) (start Int) (end Int) (a Int)) Int
  (if (eq (- end start) 1) (eq (bytes_get source start) a) 0))

(def delta_span_is_2 ((source Bytes) (start Int) (end Int) (a Int) (b Int)) Int
  (if (eq (- end start) 2)
    (if (eq (bytes_get source start) a) (eq (bytes_get source (+ start 1)) b) 0)
    0))

(def delta_span_is_3 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int)) Int
  (if (eq (- end start) 3)
    (if (delta_span_is_2 source start (+ start 2) a b) (eq (bytes_get source (+ start 2)) c) 0)
    0))

(def delta_span_is_4 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int)) Int
  (if (eq (- end start) 4)
    (if (delta_span_is_3 source start (+ start 3) a b c) (eq (bytes_get source (+ start 3)) d) 0)
    0))

(def delta_span_is_5 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int)) Int
  (if (eq (- end start) 5)
    (if (delta_span_is_4 source start (+ start 4) a b c d) (eq (bytes_get source (+ start 4)) e) 0)
    0))

(def delta_span_is_6 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int)) Int
  (if (eq (- end start) 6)
    (if (delta_span_is_5 source start (+ start 5) a b c d e) (eq (bytes_get source (+ start 5)) f) 0)
    0))

(def delta_span_is_7 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int)) Int
  (if (eq (- end start) 7)
    (if (delta_span_is_6 source start (+ start 6) a b c d e f) (eq (bytes_get source (+ start 6)) g) 0)
    0))

(def delta_span_is_8 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int)) Int
  (if (eq (- end start) 8)
    (if (delta_span_is_7 source start (+ start 7) a b c d e f g) (eq (bytes_get source (+ start 7)) h) 0)
    0))

(def delta_span_is_10 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int) (i Int) (j Int)) Int
  (if (eq (- end start) 10)
    (if (delta_span_is_8 source start (+ start 8) a b c d e f g h)
      (if (eq (bytes_get source (+ start 8)) i) (eq (bytes_get source (+ start 9)) j) 0)
      0)
    0))

(def delta_keyword_code ((source Bytes) (start Int) (end Int)) Int
  (if (delta_span_is_8 source start end 98 111 117 110 100 97 114 121) 10
    (if (delta_span_is_5 source start end 116 114 97 105 116) 11
      (if (delta_span_is_4 source start end 100 97 116 97) 12
        (if (delta_span_is_4 source start end 99 97 115 101) 13
          (if (delta_span_is_7 source start end 109 97 99 104 105 110 101) 14
            (if (delta_span_is_5 source start end 115 116 97 116 101) 15
              (if (delta_span_is_10 source start end 116 114 97 110 115 105 116 105 111 110) 16
                (if (delta_span_is_3 source start end 108 101 116) 17
                  (if (delta_span_is_6 source start end 114 101 116 117 114 110) 18
                    (if (delta_span_is_6 source start end 97 115 115 101 114 116) 19
                      (if (delta_span_is_4 source start end 116 114 117 101) 20
                        (if (delta_span_is_5 source start end 102 97 108 115 101) 21
                          (if (delta_span_is_4 source start end 115 101 108 102) 22
                            (if (delta_span_is_3 source start end 109 117 116) 23
                              (if (delta_span_is_3 source start end 105 51 50) 24
                                (if (delta_span_is_2 source start end 117 56) 25
                                  (if (delta_span_is_5 source start end 110 101 118 101 114) 26 1))))))))))))))))))

(def delta_skip_comment ((source Bytes) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (let commentByte (bytes_get source index)
      (if (eq commentByte 10)
        (delta_token_start source index)
        (if (eq commentByte 13)
          (delta_token_start source index)
          (delta_skip_comment source (+ index 1) length))))))

(def delta_token_start ((source Bytes) (index Int)) Int
  (let length (bytes_length source)
    (if (eq index length)
      length
      (let startByte (bytes_get source index)
        (if (is_space startByte)
          (delta_token_start source (+ index 1))
          (if (eq startByte 47)
            (if (next_is source index length 47)
              (delta_skip_comment source (+ index 2) length)
              index)
            index))))))

(def delta_identifier_end ((source Bytes) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (if (is_ident_continue (bytes_get source index))
      (delta_identifier_end source (+ index 1) length)
      index)))

(def delta_number_end ((source Bytes) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (if (is_digit (bytes_get source index))
      (delta_number_end source (+ index 1) length)
      index)))

(def delta_string_end ((source Bytes) (index Int)) Int
  (let stringByte (bytes_get source index)
    (if (eq stringByte 34)
      (+ index 1)
      (if (eq stringByte 92)
        (if (eq (bytes_get source (+ index 1)) 120)
          (delta_string_end source (+ index 4))
          (delta_string_end source (+ index 2)))
        (delta_string_end source (+ index 1))))))

(def delta_character_end ((source Bytes) (start Int)) Int
  (if (eq (bytes_get source (+ start 1)) 92)
    (if (eq (bytes_get source (+ start 2)) 120) (+ start 6) (+ start 4))
    (+ start 3)))

(def delta_operator_end ((source Bytes) (start Int) (length Int) (operatorByte Int)) Int
  (if (eq operatorByte 58)
    (if (next_is source start length 58) (+ start 2) (+ start 1))
    (if (eq operatorByte 45)
      (if (next_is source start length 62) (+ start 2) (+ start 1))
      (if (eq operatorByte 38)
        (if (next_is source start length 38) (+ start 2) (+ start 1))
        (if (eq operatorByte 124)
          (if (next_is source start length 124) (+ start 2) (+ start 1))
          (if (eq operatorByte 61)
            (if (next_is source start length 61) (+ start 2) (+ start 1))
            (if (eq operatorByte 33) (+ start 2)
              (if (eq operatorByte 60)
                (if (next_is source start length 61) (+ start 2)
                  (if (next_is source start length 60) (+ start 2) (+ start 1)))
                (if (eq operatorByte 62)
                  (if (next_is source start length 61) (+ start 2)
                    (if (next_is source start length 62) (+ start 2) (+ start 1)))
                  (if (eq operatorByte 46)
                    (if (next_is source start length 46) (+ start 2) (+ start 1))
                    (+ start 1)))))))))))

(def delta_token_end ((source Bytes) (start Int)) Int
  (let length (bytes_length source)
    (if (eq start length)
      length
      (let tokenByte (bytes_get source start)
        (if (is_ident_start tokenByte)
          (delta_identifier_end source (+ start 1) length)
          (if (is_digit tokenByte)
            (delta_number_end source (+ start 1) length)
            (if (eq tokenByte 34)
              (delta_string_end source (+ start 1))
              (if (eq tokenByte 39)
                (delta_character_end source start)
                (delta_operator_end source start length tokenByte)))))))))

(def delta_operator_code ((source Bytes) (start Int) (length Int) (operatorByte Int)) Int
  (if (eq operatorByte 123) 30 (if (eq operatorByte 125) 31
    (if (eq operatorByte 40) 32 (if (eq operatorByte 41) 33
      (if (eq operatorByte 91) 34 (if (eq operatorByte 93) 35
        (if (eq operatorByte 59) 36
          (if (eq operatorByte 58) (if (next_is source start length 58) 43 37)
            (if (eq operatorByte 44) 38
              (if (eq operatorByte 46) (if (next_is source start length 46) 44 39)
                (if (eq operatorByte 38) (if (next_is source start length 38) 46 40)
                  (if (eq operatorByte 61) (if (next_is source start length 61) 49 41)
                    (if (eq operatorByte 45) (if (next_is source start length 62) 42 58)
                      (if (eq operatorByte 124) (if (next_is source start length 124) 45 47)
                        (if (eq operatorByte 94) 48 (if (eq operatorByte 33) 50
                          (if (eq operatorByte 60)
                            (if (next_is source start length 61) 52
                              (if (next_is source start length 60) 55 51))
                            (if (eq operatorByte 62)
                              (if (next_is source start length 61) 54
                                (if (next_is source start length 62) 56 53))
                              (if (eq operatorByte 43) 57
                                (if (eq operatorByte 42) 59
                                  (if (eq operatorByte 47) 60 61))))))))))))))))))))))

(def delta_token_code ((source Bytes) (start Int)) Int
  (let length (bytes_length source)
    (if (eq start length)
      0
      (let tokenByte (bytes_get source start)
        (if (is_ident_start tokenByte)
          (delta_keyword_code source start (delta_identifier_end source (+ start 1) length))
          (if (is_digit tokenByte) 2
            (if (eq tokenByte 39) 3
              (if (eq tokenByte 34) 4
                (delta_operator_code source start length tokenByte)))))))))

(def delta_hex_value ((c Int)) Int
  (if (is_digit c) (- c 48)
    (if (ascii_between c 65 70) (+ (- c 65) 10) (+ (- c 97) 10))))

(def delta_escape_value ((c Int)) Int
  (if (eq c 110) 10 (if (eq c 114) 13 (if (eq c 116) 9 c))))

(def delta_character_value ((source Bytes) (opening Int)) Int
  (let characterByte (bytes_get source (+ opening 1))
    (if (eq characterByte 92)
      (let escapeByte (bytes_get source (+ opening 2))
        (if (eq escapeByte 120)
          (+ (* (delta_hex_value (bytes_get source (+ opening 3))) 16)
             (delta_hex_value (bytes_get source (+ opening 4))))
          (delta_escape_value escapeByte)))
      characterByte)))

(def delta_number_value ((source Bytes) (index Int) (end Int) (value Int)) Int
  (if (eq index end)
    value
    (delta_number_value source (+ index 1) end
      (+ (* value 10) (- (bytes_get source index) 48)))))

(def delta_token_value ((source Bytes) (start Int)) Int
  (let length (bytes_length source)
    (if (eq start length)
      0
      (let tokenByte (bytes_get source start)
        (if (is_digit tokenByte)
          (delta_number_value source start (delta_number_end source (+ start 1) length) 0)
          (if (eq tokenByte 39) (delta_character_value source start) 0))))))

; ---- type and expression parsing ---------------------------------------

(def delta_type_start ((typeValue DeltaType)) Int
  (match typeValue
    ((DeltaI32Type start end) start)
    ((DeltaU8Type start end) start)
    ((DeltaNeverType start end) start)
    ((DeltaNamedType start end name) start)
    ((DeltaArrayType start end element lengthValue) start)
    ((DeltaViewType start end element) start)))

(def delta_type_end ((typeValue DeltaType)) Int
  (match typeValue
    ((DeltaI32Type start end) end)
    ((DeltaU8Type start end) end)
    ((DeltaNeverType start end) end)
    ((DeltaNamedType start end name) end)
    ((DeltaArrayType start end element lengthValue) end)
    ((DeltaViewType start end element) end)))

(def delta_expression_start ((expressionValue DeltaExpression)) Int
  (match expressionValue
    ((DeltaIntegerExpression start end literal) start)
    ((DeltaCharacterExpression start end literal) start)
    ((DeltaStringExpression start end literal) start)
    ((DeltaTrueExpression start end) start)
    ((DeltaFalseExpression start end) start)
    ((DeltaSelfExpression start end) start)
    ((DeltaNameExpression start end name) start)
    ((DeltaQualifiedExpression start end owner name arguments) start)
    ((DeltaGroupedExpression start end inner) start)
    ((DeltaFieldExpression start end base field) start)
    ((DeltaCallExpression start end base arguments) start)
    ((DeltaIndexExpression start end base indexValue) start)
    ((DeltaSliceExpression start end base low high) start)
    ((DeltaNegateExpression start end operand) start)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd left right) start)))

(def delta_expression_end ((expressionValue DeltaExpression)) Int
  (match expressionValue
    ((DeltaIntegerExpression start end literal) end)
    ((DeltaCharacterExpression start end literal) end)
    ((DeltaStringExpression start end literal) end)
    ((DeltaTrueExpression start end) end)
    ((DeltaFalseExpression start end) end)
    ((DeltaSelfExpression start end) end)
    ((DeltaNameExpression start end name) end)
    ((DeltaQualifiedExpression start end owner name arguments) end)
    ((DeltaGroupedExpression start end inner) end)
    ((DeltaFieldExpression start end base field) end)
    ((DeltaCallExpression start end base arguments) end)
    ((DeltaIndexExpression start end base indexValue) end)
    ((DeltaSliceExpression start end base low high) end)
    ((DeltaNegateExpression start end operand) end)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd left right) end)))

(def delta_type_reject_at ((source Bytes) (cursor Int)) DeltaTypeParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaTypeParseRejected UnexpectedEnd start)
      (DeltaTypeParseRejected UnexpectedToken start))))

(def delta_expression_reject_at ((source Bytes) (cursor Int)) DeltaExpressionParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaExpressionParseRejected UnexpectedEnd start)
      (DeltaExpressionParseRejected UnexpectedToken start))))

(def delta_arguments_reject_at ((source Bytes) (cursor Int)) DeltaArgumentsParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaArgumentsParseRejected UnexpectedEnd start)
      (DeltaArgumentsParseRejected UnexpectedToken start))))

(def delta_reverse_expression_list ((input DeltaExpressionList)
  (output DeltaExpressionList)) DeltaExpressionList
  (match input
    (NoDeltaExpressions output)
    ((MoreDeltaExpressions item rest)
      (delta_reverse_expression_list rest (MoreDeltaExpressions item output)))))

(def delta_parse_array_length ((source Bytes) (arrayStart Int)
  (elementType DeltaType) (cursor Int)) DeltaTypeParseOutcome
  (let lengthStart (delta_token_start source cursor)
    (if (eq (delta_token_code source lengthStart) 2)
      (if (eq (delta_token_value source lengthStart) 2147483648)
        (DeltaTypeParseRejected IntegerLiteralOutOfRange lengthStart)
        (let lengthEnd (delta_token_end source lengthStart)
          (let closeStart (delta_token_start source lengthEnd)
            (if (eq (delta_token_code source closeStart) 35)
              (let closeEnd (delta_token_end source closeStart)
                (DeltaTypeParsed
                  (DeltaArrayType arrayStart closeEnd elementType
                    (DeltaIntegerSpan lengthStart lengthEnd
                      (delta_token_value source lengthStart)))))
              (delta_type_reject_at source lengthEnd)))))
      (delta_type_reject_at source cursor))))

(def delta_parse_array_type ((source Bytes) (arrayStart Int) (cursor Int)) DeltaTypeParseOutcome
  (let elementOutcome (delta_parse_type source cursor)
    (match elementOutcome
      ((DeltaTypeParseRejected reasonValue errorOffset) elementOutcome)
      ((DeltaTypeParsed elementType)
        (let semiStart (delta_token_start source (delta_type_end elementType))
          (if (eq (delta_token_code source semiStart) 36)
            (delta_parse_array_length source arrayStart elementType
              (delta_token_end source semiStart))
            (delta_type_reject_at source (delta_type_end elementType))))))))

(def delta_parse_view_element ((source Bytes) (viewStart Int) (cursor Int)) DeltaTypeParseOutcome
  (let elementOutcome (delta_parse_type source cursor)
    (match elementOutcome
      ((DeltaTypeParseRejected reasonValue errorOffset) elementOutcome)
      ((DeltaTypeParsed elementType)
        (let closeStart (delta_token_start source (delta_type_end elementType))
          (if (eq (delta_token_code source closeStart) 35)
            (let closeEnd (delta_token_end source closeStart)
              (DeltaTypeParsed (DeltaViewType viewStart closeEnd elementType)))
            (delta_type_reject_at source (delta_type_end elementType))))))))

(def delta_parse_type ((source Bytes) (cursor Int)) DeltaTypeParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaTypeParseRejected UnexpectedEnd start)
        (let end (delta_token_end source start)
          (if (eq code 24) (DeltaTypeParsed (DeltaI32Type start end))
            (if (eq code 25) (DeltaTypeParsed (DeltaU8Type start end))
              (if (eq code 26) (DeltaTypeParsed (DeltaNeverType start end))
                (if (eq code 1)
                  (DeltaTypeParsed (DeltaNamedType start end (DeltaNameSpan start end)))
                  (if (eq code 34)
                    (delta_parse_array_type source start end)
                    (if (eq code 40)
                      (let openStart (delta_token_start source end)
                        (if (eq (delta_token_code source openStart) 34)
                          (delta_parse_view_element source start
                            (delta_token_end source openStart))
                          (delta_type_reject_at source end)))
                      (DeltaTypeParseRejected UnexpectedToken start))))))))))))

(def delta_parse_arguments_acc ((source Bytes) (cursor Int)
  (accumulator DeltaExpressionList)) DeltaArgumentsParseOutcome
  (let nextStart (delta_token_start source cursor)
    (if (eq (delta_token_code source nextStart) 33)
      (let closeEnd (delta_token_end source nextStart)
        (DeltaArgumentsParsed
          (delta_reverse_expression_list accumulator NoDeltaExpressions) closeEnd))
      (let expressionOutcome (delta_parse_expression source nextStart)
        (match expressionOutcome
          ((DeltaExpressionParseRejected reasonValue errorOffset)
            (DeltaArgumentsParseRejected reasonValue errorOffset))
          ((DeltaExpressionParsed expressionValue)
            (let afterExpression (delta_token_start source
              (delta_expression_end expressionValue))
              (let afterCode (delta_token_code source afterExpression)
                (if (eq afterCode 38)
                  (let afterComma (delta_token_end source afterExpression)
                    (let followingStart (delta_token_start source afterComma)
                      (if (eq (delta_token_code source followingStart) 33)
                        (DeltaArgumentsParseRejected UnexpectedToken followingStart)
                        (delta_parse_arguments_acc source afterComma
                          (MoreDeltaExpressions expressionValue accumulator)))))
                  (if (eq afterCode 33)
                    (let closeEnd (delta_token_end source afterExpression)
                      (DeltaArgumentsParsed
                        (delta_reverse_expression_list
                          (MoreDeltaExpressions expressionValue accumulator)
                          NoDeltaExpressions) closeEnd))
                    (delta_arguments_reject_at source afterExpression)))))))))))

(def delta_parse_qualified_primary ((source Bytes) (firstStart Int)
  (firstEnd Int) (cursor Int)) DeltaExpressionParseOutcome
  (let secondStart (delta_token_start source cursor)
    (if (eq (delta_token_code source secondStart) 1)
      (let secondEnd (delta_token_end source secondStart)
        (let openStart (delta_token_start source secondEnd)
          (if (eq (delta_token_code source openStart) 32)
            (let argumentsOutcome
              (delta_parse_arguments_acc source
                (delta_token_end source openStart) NoDeltaExpressions)
              (match argumentsOutcome
                ((DeltaArgumentsParseRejected reasonValue errorOffset)
                  (DeltaExpressionParseRejected reasonValue errorOffset))
                ((DeltaArgumentsParsed arguments closeEnd)
                  (DeltaExpressionParsed
                    (DeltaQualifiedExpression firstStart closeEnd
                      (DeltaNameSpan firstStart firstEnd)
                      (DeltaNameSpan secondStart secondEnd)
                      (SomeDeltaArguments openStart closeEnd arguments))))))
            (DeltaExpressionParsed
              (DeltaQualifiedExpression firstStart secondEnd
                (DeltaNameSpan firstStart firstEnd)
                (DeltaNameSpan secondStart secondEnd) NoDeltaArguments)))))
      (delta_expression_reject_at source cursor))))

(def delta_parse_primary ((source Bytes) (cursor Int)) DeltaExpressionParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaExpressionParseRejected UnexpectedEnd start)
        (let end (delta_token_end source start)
          (if (eq code 2)
            (if (eq (delta_token_value source start) 2147483648)
              (DeltaExpressionParseRejected IntegerLiteralOutOfRange start)
              (DeltaExpressionParsed
                (DeltaIntegerExpression start end
                  (DeltaIntegerSpan start end (delta_token_value source start)))))
            (if (eq code 3)
              (DeltaExpressionParsed
                (DeltaCharacterExpression start end
                  (DeltaCharacterSpan start end (delta_token_value source start))))
              (if (eq code 4)
                (DeltaExpressionParsed
                  (DeltaStringExpression start end (DeltaStringSpan start end)))
                (if (eq code 20) (DeltaExpressionParsed (DeltaTrueExpression start end))
                  (if (eq code 21) (DeltaExpressionParsed (DeltaFalseExpression start end))
                    (if (eq code 22) (DeltaExpressionParsed (DeltaSelfExpression start end))
                      (if (eq code 1)
                        (let scopeStart (delta_token_start source end)
                          (if (eq (delta_token_code source scopeStart) 43)
                            (delta_parse_qualified_primary source start end
                              (delta_token_end source scopeStart))
                            (DeltaExpressionParsed
                              (DeltaNameExpression start end (DeltaNameSpan start end)))))
                        (if (eq code 32)
                          (let innerOutcome (delta_parse_expression source end)
                            (match innerOutcome
                              ((DeltaExpressionParseRejected reasonValue errorOffset) innerOutcome)
                              ((DeltaExpressionParsed innerExpression)
                                (let closeStart (delta_token_start source
                                  (delta_expression_end innerExpression))
                                  (if (eq (delta_token_code source closeStart) 33)
                                    (let closeEnd (delta_token_end source closeStart)
                                      (DeltaExpressionParsed
                                        (DeltaGroupedExpression start closeEnd innerExpression)))
                                    (delta_expression_reject_at source
                                      (delta_expression_end innerExpression)))))))
                          (DeltaExpressionParseRejected UnexpectedToken start))))))))))))))

(def delta_parse_slice_high ((source Bytes) (base DeltaExpression)
  (rangeCursor Int) (low DeltaOptionalExpression)) DeltaExpressionParseOutcome
  (let highStart (delta_token_start source rangeCursor)
    (if (eq (delta_token_code source highStart) 35)
      (let closeEnd (delta_token_end source highStart)
        (delta_parse_postfix_tail source
          (DeltaExpressionParsed
            (DeltaSliceExpression (delta_expression_start base) closeEnd base low NoDeltaExpression))))
      (let highOutcome (delta_parse_expression source highStart)
        (match highOutcome
          ((DeltaExpressionParseRejected reasonValue errorOffset) highOutcome)
          ((DeltaExpressionParsed highExpression)
            (let closeStart (delta_token_start source (delta_expression_end highExpression))
              (if (eq (delta_token_code source closeStart) 35)
                (let closeEnd (delta_token_end source closeStart)
                  (delta_parse_postfix_tail source
                    (DeltaExpressionParsed
                      (DeltaSliceExpression (delta_expression_start base) closeEnd base low
                        (SomeDeltaExpression highExpression)))))
                (delta_expression_reject_at source
                  (delta_expression_end highExpression))))))))))

(def delta_parse_bracket_suffix ((source Bytes) (base DeltaExpression)
  (openStart Int)) DeltaExpressionParseOutcome
  (let afterOpen (delta_token_end source openStart)
    (let firstStart (delta_token_start source afterOpen)
      (if (eq (delta_token_code source firstStart) 44)
        (delta_parse_slice_high source base (delta_token_end source firstStart) NoDeltaExpression)
        (let indexOutcome (delta_parse_expression source firstStart)
          (match indexOutcome
            ((DeltaExpressionParseRejected reasonValue errorOffset) indexOutcome)
            ((DeltaExpressionParsed indexExpression)
              (let followingStart (delta_token_start source
                (delta_expression_end indexExpression))
                (if (eq (delta_token_code source followingStart) 44)
                  (delta_parse_slice_high source base
                    (delta_token_end source followingStart)
                    (SomeDeltaExpression indexExpression))
                  (if (eq (delta_token_code source followingStart) 35)
                    (let closeEnd (delta_token_end source followingStart)
                      (delta_parse_postfix_tail source
                        (DeltaExpressionParsed
                          (DeltaIndexExpression (delta_expression_start base) closeEnd
                            base indexExpression))))
                    (delta_expression_reject_at source
                      (delta_expression_end indexExpression))))))))))))

(def delta_parse_call_suffix ((source Bytes) (base DeltaExpression)
  (openStart Int)) DeltaExpressionParseOutcome
  (let argumentsOutcome
    (delta_parse_arguments_acc source
      (delta_token_end source openStart) NoDeltaExpressions)
    (match argumentsOutcome
      ((DeltaArgumentsParseRejected reasonValue errorOffset)
        (DeltaExpressionParseRejected reasonValue errorOffset))
      ((DeltaArgumentsParsed arguments callEnd)
        (delta_parse_postfix_tail source
          (DeltaExpressionParsed
            (DeltaCallExpression (delta_expression_start base) callEnd base arguments)))))))

(def delta_parse_postfix_tail ((source Bytes)
  (current DeltaExpressionParseOutcome)) DeltaExpressionParseOutcome
  (match current
    ((DeltaExpressionParseRejected reasonValue errorOffset) current)
    ((DeltaExpressionParsed base)
      (let suffixStart (delta_token_start source (delta_expression_end base))
        (let suffixCode (delta_token_code source suffixStart)
          (if (eq suffixCode 39)
            (let fieldStart (delta_token_start source (delta_token_end source suffixStart))
              (if (eq (delta_token_code source fieldStart) 1)
                (let fieldEnd (delta_token_end source fieldStart)
                  (delta_parse_postfix_tail source
                    (DeltaExpressionParsed
                      (DeltaFieldExpression (delta_expression_start base) fieldEnd base
                        (DeltaNameSpan fieldStart fieldEnd)))))
                (delta_expression_reject_at source (delta_token_end source suffixStart))))
            (if (eq suffixCode 32)
              (delta_parse_call_suffix source base suffixStart)
              (if (eq suffixCode 34)
                (delta_parse_bracket_suffix source base suffixStart)
                current))))))))

(def delta_parse_postfix ((source Bytes) (cursor Int)) DeltaExpressionParseOutcome
  (delta_parse_postfix_tail source (delta_parse_primary source cursor)))

(def delta_is_postfix_code ((code Int)) Int
  (if (eq code 39) 1 (if (eq code 32) 1 (eq code 34))))

(def delta_parse_unary ((source Bytes) (cursor Int)) DeltaExpressionParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq (delta_token_code source start) 58)
      (let afterMinus (delta_token_end source start)
        (let operandStart (delta_token_start source afterMinus)
          (if (eq (delta_token_code source operandStart) 2)
            (if (eq (delta_token_value source operandStart) 2147483648)
              (let literalEnd (delta_token_end source operandStart)
                (let followingStart (delta_token_start source literalEnd)
                  (if (delta_is_postfix_code (delta_token_code source followingStart))
                    (DeltaExpressionParseRejected IntegerLiteralOutOfRange operandStart)
                    (DeltaExpressionParsed
                      (DeltaNegateExpression start literalEnd
                        (DeltaIntegerExpression operandStart literalEnd
                          (DeltaIntegerSpan operandStart literalEnd 2147483648)))))))
              (let operandOutcome (delta_parse_unary source afterMinus)
                (match operandOutcome
                  ((DeltaExpressionParseRejected reasonValue errorOffset) operandOutcome)
                  ((DeltaExpressionParsed operand)
                    (DeltaExpressionParsed
                      (DeltaNegateExpression start (delta_expression_end operand) operand))))))
            (let operandOutcome (delta_parse_unary source afterMinus)
              (match operandOutcome
                ((DeltaExpressionParseRejected reasonValue errorOffset) operandOutcome)
                ((DeltaExpressionParsed operand)
                  (DeltaExpressionParsed
                    (DeltaNegateExpression start (delta_expression_end operand) operand))))))))
      (delta_parse_postfix source start))))

(def delta_binary_precedence ((operatorCode Int)) Int
  (if (eq operatorCode 45) 1 (if (eq operatorCode 46) 2
    (if (eq operatorCode 47) 3 (if (eq operatorCode 48) 4
      (if (eq operatorCode 40) 5 (if (eq operatorCode 49) 6
        (if (eq operatorCode 50) 6 (if (eq operatorCode 51) 7
          (if (eq operatorCode 52) 7 (if (eq operatorCode 53) 7
            (if (eq operatorCode 54) 7 (if (eq operatorCode 55) 8
              (if (eq operatorCode 56) 8 (if (eq operatorCode 57) 9
                (if (eq operatorCode 58) 9 (if (eq operatorCode 59) 10
                  (if (eq operatorCode 60) 10 (if (eq operatorCode 61) 10 0)))))))))))))))))))

(def delta_binary_operator ((operatorCode Int)) DeltaBinaryOperator
  (if (eq operatorCode 45) DeltaLogicalOr (if (eq operatorCode 46) DeltaLogicalAnd
    (if (eq operatorCode 47) DeltaBitOr (if (eq operatorCode 48) DeltaBitXor
      (if (eq operatorCode 40) DeltaBitAnd (if (eq operatorCode 49) DeltaEqual
        (if (eq operatorCode 50) DeltaNotEqual (if (eq operatorCode 51) DeltaLess
          (if (eq operatorCode 52) DeltaLessEqual (if (eq operatorCode 53) DeltaGreater
            (if (eq operatorCode 54) DeltaGreaterEqual (if (eq operatorCode 55) DeltaShiftLeft
              (if (eq operatorCode 56) DeltaShiftRight (if (eq operatorCode 57) DeltaAdd
                (if (eq operatorCode 58) DeltaSubtract (if (eq operatorCode 59) DeltaMultiply
                  (if (eq operatorCode 60) DeltaDivide DeltaRemainder))))))))))))))))))

(def delta_finish_binary ((source Bytes) (minimum Int) (left DeltaExpression)
  (operatorStart Int) (operatorCode Int) (rightOutcome DeltaExpressionParseOutcome)) DeltaExpressionParseOutcome
  (match rightOutcome
    ((DeltaExpressionParseRejected reasonValue errorOffset) rightOutcome)
    ((DeltaExpressionParsed right)
      (delta_parse_binary_tail source minimum
        (DeltaExpressionParsed
          (DeltaBinaryExpression (delta_expression_start left)
            (delta_expression_end right) (delta_binary_operator operatorCode)
            operatorStart (delta_token_end source operatorStart) left right))))))

(def delta_parse_binary_tail ((source Bytes) (minimum Int)
  (current DeltaExpressionParseOutcome)) DeltaExpressionParseOutcome
  (match current
    ((DeltaExpressionParseRejected reasonValue errorOffset) current)
    ((DeltaExpressionParsed left)
      (let operatorStart (delta_token_start source (delta_expression_end left))
        (let operatorCode (delta_token_code source operatorStart)
          (let precedenceValue (delta_binary_precedence operatorCode)
            (if (lt precedenceValue minimum)
              current
              (delta_finish_binary source minimum left operatorStart operatorCode
                (delta_parse_binary_min source (delta_token_end source operatorStart)
                  (+ precedenceValue 1))))))))))

(def delta_parse_binary_min ((source Bytes) (cursor Int)
  (minimum Int)) DeltaExpressionParseOutcome
  (delta_parse_binary_tail source minimum (delta_parse_unary source cursor)))

(def delta_parse_expression ((source Bytes) (cursor Int)) DeltaExpressionParseOutcome
  (delta_parse_binary_min source cursor 1))

; ---- transition patterns and arms --------------------------------------

(def delta_pattern_start ((patternValue DeltaPattern)) Int
  (match patternValue
    ((DeltaIntegerPattern start end literal) start)
    ((DeltaTruePattern start end) start)
    ((DeltaFalsePattern start end) start)
    ((DeltaWildcardPattern start end) start)
    ((DeltaCasePattern start end owner name binder) start)))

(def delta_pattern_end ((patternValue DeltaPattern)) Int
  (match patternValue
    ((DeltaIntegerPattern start end literal) end)
    ((DeltaTruePattern start end) end)
    ((DeltaFalsePattern start end) end)
    ((DeltaWildcardPattern start end) end)
    ((DeltaCasePattern start end owner name binder) end)))

(def delta_continuation_start ((continuationValue DeltaContinuation)) Int
  (match continuationValue
    ((DeltaExpressionContinuation start end expressionValue) start)
    ((DeltaReturnContinuation start end expressionValue) start)))

(def delta_continuation_end ((continuationValue DeltaContinuation)) Int
  (match continuationValue
    ((DeltaExpressionContinuation start end expressionValue) end)
    ((DeltaReturnContinuation start end expressionValue) end)))

(def delta_arm_start ((armValue DeltaArm)) Int
  (match armValue ((DeltaArmSyntax start end patternValue continuationValue) start)))

(def delta_arm_end ((armValue DeltaArm)) Int
  (match armValue ((DeltaArmSyntax start end patternValue continuationValue) end)))

(def delta_reverse_names ((input DeltaNameList) (output DeltaNameList)) DeltaNameList
  (match input
    (NoDeltaNames output)
    ((MoreDeltaNames item rest)
      (delta_reverse_names rest (MoreDeltaNames item output)))))

(def delta_reverse_arms ((input DeltaArmList) (output DeltaArmList)) DeltaArmList
  (match input
    (NoDeltaArms output)
    ((MoreDeltaArms item rest)
      (delta_reverse_arms rest (MoreDeltaArms item output)))))

(def delta_binder_reject_at ((source Bytes) (cursor Int)) DeltaBinderParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaBinderParseRejected UnexpectedEnd start)
      (DeltaBinderParseRejected UnexpectedToken start))))

(def delta_pattern_reject_at ((source Bytes) (cursor Int)) DeltaPatternParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaPatternParseRejected UnexpectedEnd start)
      (DeltaPatternParseRejected UnexpectedToken start))))

(def delta_continuation_reject_at ((source Bytes) (cursor Int)) DeltaContinuationParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaContinuationParseRejected UnexpectedEnd start)
      (DeltaContinuationParseRejected UnexpectedToken start))))

(def delta_arm_reject_at ((source Bytes) (cursor Int)) DeltaArmParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaArmParseRejected UnexpectedEnd start)
      (DeltaArmParseRejected UnexpectedToken start))))

(def delta_probe_binder_names ((source Bytes) (cursor Int)) Int
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 31)
        (delta_token_end source start)
        (if (eq code 1)
          (let afterName (delta_token_end source start)
            (let followingStart (delta_token_start source afterName)
              (let followingCode (delta_token_code source followingStart)
                (if (eq followingCode 31)
                  (delta_token_end source followingStart)
                  (if (eq followingCode 38)
                    (let afterComma (delta_token_end source followingStart)
                      (let nextStart (delta_token_start source afterComma)
                        (if (eq (delta_token_code source nextStart) 1)
                          (delta_probe_binder_names source afterComma)
                          -1)))
                    -1)))))
          -1)))))

(def delta_probe_pattern_end ((source Bytes) (cursor Int)) Int
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 2) (delta_token_end source start)
        (if (eq code 20) (delta_token_end source start)
          (if (eq code 21) (delta_token_end source start)
            (if (eq code 1)
              (let firstEnd (delta_token_end source start)
                (if (delta_span_is_1 source start firstEnd 95)
                  firstEnd
                  (let scopeStart (delta_token_start source firstEnd)
                    (if (eq (delta_token_code source scopeStart) 43)
                      (let secondStart (delta_token_start source
                        (delta_token_end source scopeStart))
                        (if (eq (delta_token_code source secondStart) 1)
                          (let secondEnd (delta_token_end source secondStart)
                            (let binderStart (delta_token_start source secondEnd)
                              (if (eq (delta_token_code source binderStart) 30)
                                (delta_probe_binder_names source
                                  (delta_token_end source binderStart))
                                secondEnd)))
                          -1))
                      -1))))
              -1)))))))

(def delta_probe_pattern_arrow ((source Bytes) (cursor Int)) Int
  (let patternEnd (delta_probe_pattern_end source cursor)
    (if (lt patternEnd 0)
      -1
      (let arrowStart (delta_token_start source patternEnd)
        (if (eq (delta_token_code source arrowStart) 42)
          (delta_token_end source arrowStart)
          -1)))))

(def delta_parse_binder_names ((source Bytes) (binderStart Int) (cursor Int)
  (accumulator DeltaNameList)) DeltaBinderParseOutcome
  (let nameStart (delta_token_start source cursor)
    (let nameCode (delta_token_code source nameStart)
      (if (eq nameCode 31)
        (let binderEnd (delta_token_end source nameStart)
          (DeltaBinderParsed
            (SomeDeltaBinder binderStart binderEnd
              (delta_reverse_names accumulator NoDeltaNames))))
        (if (eq nameCode 1)
          (let nameEnd (delta_token_end source nameStart)
            (let nextAccumulator
              (MoreDeltaNames (DeltaNameSpan nameStart nameEnd) accumulator)
              (let followingStart (delta_token_start source nameEnd)
                (let followingCode (delta_token_code source followingStart)
                  (if (eq followingCode 31)
                    (let binderEnd (delta_token_end source followingStart)
                      (DeltaBinderParsed
                        (SomeDeltaBinder binderStart binderEnd
                          (delta_reverse_names nextAccumulator NoDeltaNames))))
                    (if (eq followingCode 38)
                      (let afterComma (delta_token_end source followingStart)
                        (let nextStart (delta_token_start source afterComma)
                          (if (eq (delta_token_code source nextStart) 31)
                            (DeltaBinderParseRejected UnexpectedToken nextStart)
                            (delta_parse_binder_names source binderStart afterComma
                              nextAccumulator))))
                      (delta_binder_reject_at source nameEnd)))))))
          (delta_binder_reject_at source cursor))))))

(def delta_parse_case_pattern ((source Bytes) (firstStart Int) (firstEnd Int)
  (cursor Int)) DeltaPatternParseOutcome
  (let secondStart (delta_token_start source cursor)
    (if (eq (delta_token_code source secondStart) 1)
      (let secondEnd (delta_token_end source secondStart)
        (let binderStart (delta_token_start source secondEnd)
          (if (eq (delta_token_code source binderStart) 30)
            (let binderOutcome
              (delta_parse_binder_names source binderStart
                (delta_token_end source binderStart) NoDeltaNames)
              (match binderOutcome
                ((DeltaBinderParseRejected reasonValue errorOffset)
                  (DeltaPatternParseRejected reasonValue errorOffset))
                ((DeltaBinderParsed binderValue)
                  (match binderValue
                    (NoDeltaBinder (DeltaPatternParseRejected UnexpectedToken binderStart))
                    ((SomeDeltaBinder start end names)
                      (DeltaPatternParsed
                        (DeltaCasePattern firstStart end
                          (DeltaNameSpan firstStart firstEnd)
                          (DeltaNameSpan secondStart secondEnd) binderValue)))))))
            (DeltaPatternParsed
              (DeltaCasePattern firstStart secondEnd
                (DeltaNameSpan firstStart firstEnd)
                (DeltaNameSpan secondStart secondEnd) NoDeltaBinder)))))
      (delta_pattern_reject_at source cursor))))

(def delta_parse_pattern ((source Bytes) (cursor Int)) DeltaPatternParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (let end (delta_token_end source start)
        (if (eq code 0) (DeltaPatternParseRejected UnexpectedEnd start)
          (if (eq code 2)
            (if (eq (delta_token_value source start) 2147483648)
              (DeltaPatternParseRejected IntegerLiteralOutOfRange start)
              (DeltaPatternParsed
                (DeltaIntegerPattern start end
                  (DeltaIntegerSpan start end (delta_token_value source start)))))
            (if (eq code 20) (DeltaPatternParsed (DeltaTruePattern start end))
              (if (eq code 21) (DeltaPatternParsed (DeltaFalsePattern start end))
                (if (eq code 1)
                  (if (delta_span_is_1 source start end 95)
                    (DeltaPatternParsed (DeltaWildcardPattern start end))
                    (let scopeStart (delta_token_start source end)
                      (if (eq (delta_token_code source scopeStart) 43)
                        (delta_parse_case_pattern source start end
                          (delta_token_end source scopeStart))
                        (DeltaPatternParseRejected UnexpectedToken start))))
                  (DeltaPatternParseRejected UnexpectedToken start))))))))))

(def delta_parse_continuation ((source Bytes) (cursor Int)) DeltaContinuationParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq (delta_token_code source start) 18)
      (let returnEnd (delta_token_end source start)
        (let followingStart (delta_token_start source returnEnd)
          (let followingCode (delta_token_code source followingStart)
            (if (eq followingCode 31)
              (DeltaContinuationParsed
                (DeltaReturnContinuation start returnEnd NoDeltaExpression))
              (if (eq followingCode 0)
                (DeltaContinuationParsed
                  (DeltaReturnContinuation start returnEnd NoDeltaExpression))
                (if (lt (delta_probe_pattern_arrow source followingStart) 0)
                  (let expressionOutcome (delta_parse_expression source followingStart)
                    (match expressionOutcome
                      ((DeltaExpressionParseRejected reasonValue errorOffset)
                        (DeltaContinuationParseRejected reasonValue errorOffset))
                      ((DeltaExpressionParsed expressionValue)
                        (DeltaContinuationParsed
                          (DeltaReturnContinuation start
                            (delta_expression_end expressionValue)
                            (SomeDeltaExpression expressionValue))))))
                  (DeltaContinuationParsed
                    (DeltaReturnContinuation start returnEnd NoDeltaExpression))))))))
      (let expressionOutcome (delta_parse_postfix source start)
        (match expressionOutcome
          ((DeltaExpressionParseRejected reasonValue errorOffset)
            (DeltaContinuationParseRejected reasonValue errorOffset))
          ((DeltaExpressionParsed expressionValue)
            (DeltaContinuationParsed
              (DeltaExpressionContinuation (delta_expression_start expressionValue)
                (delta_expression_end expressionValue) expressionValue))))))))

(def delta_parse_arm ((source Bytes) (cursor Int)) DeltaArmParseOutcome
  (let patternOutcome (delta_parse_pattern source cursor)
    (match patternOutcome
      ((DeltaPatternParseRejected reasonValue errorOffset)
        (DeltaArmParseRejected reasonValue errorOffset))
      ((DeltaPatternParsed patternValue)
        (let arrowStart (delta_token_start source (delta_pattern_end patternValue))
          (if (eq (delta_token_code source arrowStart) 42)
            (let continuationOutcome
              (delta_parse_continuation source (delta_token_end source arrowStart))
              (match continuationOutcome
                ((DeltaContinuationParseRejected reasonValue errorOffset)
                  (DeltaArmParseRejected reasonValue errorOffset))
                ((DeltaContinuationParsed continuationValue)
                  (DeltaArmParsed
                    (DeltaArmSyntax (delta_pattern_start patternValue)
                      (delta_continuation_end continuationValue)
                      patternValue continuationValue)))))
            (delta_arm_reject_at source (delta_pattern_end patternValue))))))))

(def delta_parse_arms_acc ((source Bytes) (cursor Int) (count Int)
  (accumulator DeltaArmList)) DeltaArmListParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaArmListParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (if (eq count 0)
            (DeltaArmListParseRejected UnexpectedToken start)
            (DeltaArmListParsed
              (delta_reverse_arms accumulator NoDeltaArms) start))
          (let armOutcome (delta_parse_arm source start)
            (match armOutcome
              ((DeltaArmParseRejected reasonValue errorOffset)
                (DeltaArmListParseRejected reasonValue errorOffset))
              ((DeltaArmParsed armValue)
                (delta_parse_arms_acc source (delta_arm_end armValue) (+ count 1)
                  (MoreDeltaArms armValue accumulator))))))))))

(def delta_parse_transition ((source Bytes) (cursor Int)) DeltaTransitionParseOutcome
  (let transitionStart (delta_token_start source cursor)
    (if (eq (delta_token_code source transitionStart) 16)
      (let expressionOutcome
        (delta_parse_expression source (delta_token_end source transitionStart))
        (match expressionOutcome
          ((DeltaExpressionParseRejected reasonValue errorOffset)
            (DeltaTransitionParseRejected reasonValue errorOffset))
          ((DeltaExpressionParsed expressionValue)
            (let openStart (delta_token_start source (delta_expression_end expressionValue))
              (if (eq (delta_token_code source openStart) 30)
                (let armsOutcome
                  (delta_parse_arms_acc source (delta_token_end source openStart)
                    0 NoDeltaArms)
                  (match armsOutcome
                    ((DeltaArmListParseRejected reasonValue errorOffset)
                      (DeltaTransitionParseRejected reasonValue errorOffset))
                    ((DeltaArmListParsed arms closeStart)
                      (let transitionEnd (delta_token_end source closeStart)
                        (DeltaTransitionParsed
                          (DeltaTransitionTerminal transitionStart transitionEnd
                            expressionValue arms))))))
                (let errorStart (delta_token_start source
                  (delta_expression_end expressionValue))
                  (if (eq errorStart (bytes_length source))
                    (DeltaTransitionParseRejected UnexpectedEnd errorStart)
                    (DeltaTransitionParseRejected UnexpectedToken errorStart))))))))
      (let errorStart (delta_token_start source cursor)
        (if (eq errorStart (bytes_length source))
          (DeltaTransitionParseRejected UnexpectedEnd errorStart)
          (DeltaTransitionParseRejected UnexpectedToken errorStart))))))

; ---- parameters, statements, and explicit return -----------------------

(def delta_parameter_end ((parameterValue DeltaParameter)) Int
  (match parameterValue
    ((DeltaParameterSyntax start end name typeValue) end)))

(def delta_reverse_parameters ((input DeltaParameterList)
  (output DeltaParameterList)) DeltaParameterList
  (match input
    (NoDeltaParameters output)
    ((MoreDeltaParameters item rest)
      (delta_reverse_parameters rest (MoreDeltaParameters item output)))))

(def delta_parameter_reject_at ((source Bytes) (cursor Int)) DeltaParameterParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaParameterParseRejected UnexpectedEnd start)
      (DeltaParameterParseRejected UnexpectedToken start))))

(def delta_parameter_list_reject_at ((source Bytes) (cursor Int)) DeltaParameterListParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaParameterListParseRejected UnexpectedEnd start)
      (DeltaParameterListParseRejected UnexpectedToken start))))

(def delta_statement_reject_at ((source Bytes) (cursor Int)) DeltaStatementParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaStatementParseRejected UnexpectedEnd start)
      (DeltaStatementParseRejected UnexpectedToken start))))

(def delta_terminal_reject_at ((source Bytes) (cursor Int)) DeltaTerminalParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaTerminalParseRejected UnexpectedEnd start)
      (DeltaTerminalParseRejected UnexpectedToken start))))

(def delta_parse_parameter ((source Bytes) (cursor Int)) DeltaParameterParseOutcome
  (let nameStart (delta_token_start source cursor)
    (if (eq (delta_token_code source nameStart) 1)
      (let nameEnd (delta_token_end source nameStart)
        (let colonStart (delta_token_start source nameEnd)
          (if (eq (delta_token_code source colonStart) 37)
            (let typeOutcome
              (delta_parse_type source (delta_token_end source colonStart))
              (match typeOutcome
                ((DeltaTypeParseRejected reasonValue errorOffset)
                  (DeltaParameterParseRejected reasonValue errorOffset))
                ((DeltaTypeParsed typeValue)
                  (let parameterEnd (delta_type_end typeValue)
                    (DeltaParameterParsed
                      (DeltaParameterSyntax nameStart parameterEnd
                        (DeltaNameSpan nameStart nameEnd) typeValue))))))
            (delta_parameter_reject_at source nameEnd))))
      (delta_parameter_reject_at source cursor))))

(def delta_parse_parameters_acc ((source Bytes) (cursor Int) (closeCode Int)
  (accumulator DeltaParameterList)) DeltaParameterListParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq (delta_token_code source start) closeCode)
      (DeltaParameterListParsed
        (delta_reverse_parameters accumulator NoDeltaParameters) start)
      (let parameterOutcome (delta_parse_parameter source start)
        (match parameterOutcome
          ((DeltaParameterParseRejected reasonValue errorOffset)
            (DeltaParameterListParseRejected reasonValue errorOffset))
          ((DeltaParameterParsed parameterValue)
            (let followingStart (delta_token_start source
              (delta_parameter_end parameterValue))
              (let followingCode (delta_token_code source followingStart)
                (if (eq followingCode closeCode)
                  (DeltaParameterListParsed
                    (delta_reverse_parameters
                      (MoreDeltaParameters parameterValue accumulator)
                      NoDeltaParameters) followingStart)
                  (if (eq followingCode 38)
                    (let afterComma (delta_token_end source followingStart)
                      (let nextStart (delta_token_start source afterComma)
                        (if (eq (delta_token_code source nextStart) closeCode)
                          (DeltaParameterListParseRejected UnexpectedToken nextStart)
                          (delta_parse_parameters_acc source afterComma closeCode
                            (MoreDeltaParameters parameterValue accumulator)))))
                    (delta_parameter_list_reject_at source followingStart)))))))))))

(def delta_finish_let_statement ((source Bytes) (statementStart Int)
  (nameStart Int) (nameEnd Int) (typeValue DeltaType) (cursor Int)) DeltaStatementParseOutcome
  (let assignStart (delta_token_start source cursor)
    (if (eq (delta_token_code source assignStart) 41)
      (let expressionOutcome
        (delta_parse_expression source (delta_token_end source assignStart))
        (match expressionOutcome
          ((DeltaExpressionParseRejected reasonValue errorOffset)
            (DeltaStatementParseRejected reasonValue errorOffset))
          ((DeltaExpressionParsed expressionValue)
            (let semiStart (delta_token_start source
              (delta_expression_end expressionValue))
              (if (eq (delta_token_code source semiStart) 36)
                (let statementEnd (delta_token_end source semiStart)
                  (DeltaStatementParsed
                    (DeltaLetStatement statementStart statementEnd
                      (DeltaNameSpan nameStart nameEnd) typeValue expressionValue)))
                (delta_statement_reject_at source
                  (delta_expression_end expressionValue)))))))
      (delta_statement_reject_at source cursor))))

(def delta_parse_let_statement ((source Bytes) (cursor Int)) DeltaStatementParseOutcome
  (let statementStart (delta_token_start source cursor)
    (let nameStart (delta_token_start source
      (delta_token_end source statementStart))
      (if (eq (delta_token_code source nameStart) 1)
        (let nameEnd (delta_token_end source nameStart)
          (let colonStart (delta_token_start source nameEnd)
            (if (eq (delta_token_code source colonStart) 37)
              (let typeOutcome
                (delta_parse_type source (delta_token_end source colonStart))
                (match typeOutcome
                  ((DeltaTypeParseRejected reasonValue errorOffset)
                    (DeltaStatementParseRejected reasonValue errorOffset))
                  ((DeltaTypeParsed typeValue)
                    (delta_finish_let_statement source statementStart nameStart nameEnd
                      typeValue (delta_type_end typeValue)))))
              (delta_statement_reject_at source nameEnd))))
        (delta_statement_reject_at source
          (delta_token_end source statementStart))))))

(def delta_parse_assert_statement ((source Bytes) (cursor Int)) DeltaStatementParseOutcome
  (let statementStart (delta_token_start source cursor)
    (let expressionOutcome
      (delta_parse_expression source (delta_token_end source statementStart))
      (match expressionOutcome
        ((DeltaExpressionParseRejected reasonValue errorOffset)
          (DeltaStatementParseRejected reasonValue errorOffset))
        ((DeltaExpressionParsed expressionValue)
          (let semiStart (delta_token_start source (delta_expression_end expressionValue))
            (if (eq (delta_token_code source semiStart) 36)
              (let statementEnd (delta_token_end source semiStart)
                (DeltaStatementParsed
                  (DeltaAssertStatement statementStart statementEnd expressionValue)))
              (delta_statement_reject_at source
                (delta_expression_end expressionValue)))))))))

(def delta_finish_assignment ((source Bytes) (left DeltaExpression)
  (cursor Int)) DeltaStatementParseOutcome
  (let rightOutcome (delta_parse_expression source cursor)
    (match rightOutcome
      ((DeltaExpressionParseRejected reasonValue errorOffset)
        (DeltaStatementParseRejected reasonValue errorOffset))
      ((DeltaExpressionParsed right)
        (let semiStart (delta_token_start source (delta_expression_end right))
          (if (eq (delta_token_code source semiStart) 36)
            (let statementEnd (delta_token_end source semiStart)
              (DeltaStatementParsed
                (DeltaAssignmentStatement (delta_expression_start left)
                  statementEnd left right)))
            (delta_statement_reject_at source (delta_expression_end right))))))))

(def delta_parse_postfix_statement ((source Bytes) (cursor Int)) DeltaStatementParseOutcome
  (let leftOutcome (delta_parse_postfix source cursor)
    (match leftOutcome
      ((DeltaExpressionParseRejected reasonValue errorOffset)
        (DeltaStatementParseRejected reasonValue errorOffset))
      ((DeltaExpressionParsed left)
        (let followingStart (delta_token_start source (delta_expression_end left))
          (let followingCode (delta_token_code source followingStart)
            (if (eq followingCode 41)
              (delta_finish_assignment source left
                (delta_token_end source followingStart))
              (if (eq followingCode 36)
                (let statementEnd (delta_token_end source followingStart)
                  (DeltaStatementParsed
                    (DeltaPostfixStatement (delta_expression_start left)
                      statementEnd left)))
                (delta_statement_reject_at source followingStart)))))))))

(def delta_parse_statement ((source Bytes) (cursor Int)) DeltaStatementParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 17)
        (delta_parse_let_statement source start)
        (if (eq code 19)
          (delta_parse_assert_statement source start)
          (delta_parse_postfix_statement source start))))))

(def delta_parse_return_terminal ((source Bytes) (cursor Int)) DeltaTerminalParseOutcome
  (let returnStart (delta_token_start source cursor)
    (if (eq (delta_token_code source returnStart) 18)
      (let afterReturn (delta_token_end source returnStart)
        (let followingStart (delta_token_start source afterReturn)
          (if (eq (delta_token_code source followingStart) 36)
            (let terminalEnd (delta_token_end source followingStart)
              (DeltaTerminalParsed
                (DeltaReturnTerminal returnStart terminalEnd NoDeltaExpression)))
            (let expressionOutcome (delta_parse_expression source followingStart)
              (match expressionOutcome
                ((DeltaExpressionParseRejected reasonValue errorOffset)
                  (DeltaTerminalParseRejected reasonValue errorOffset))
                ((DeltaExpressionParsed expressionValue)
                  (let semiStart (delta_token_start source
                    (delta_expression_end expressionValue))
                    (if (eq (delta_token_code source semiStart) 36)
                      (let terminalEnd (delta_token_end source semiStart)
                        (DeltaTerminalParsed
                          (DeltaReturnTerminal returnStart terminalEnd
                            (SomeDeltaExpression expressionValue))))
                      (delta_terminal_reject_at source
                        (delta_expression_end expressionValue))))))))))
      (delta_terminal_reject_at source cursor))))

; ---- state and machine bodies ------------------------------------------

(def delta_statement_end ((statementValue DeltaStatement)) Int
  (match statementValue
    ((DeltaLetStatement start end name typeValue expressionValue) end)
    ((DeltaAssignmentStatement start end left right) end)
    ((DeltaPostfixStatement start end expressionValue) end)
    ((DeltaAssertStatement start end expressionValue) end)))

(def delta_terminal_end ((terminalValue DeltaTerminal)) Int
  (match terminalValue
    ((DeltaTransitionTerminal start end expressionValue arms) end)
    ((DeltaReturnTerminal start end expressionValue) end)))

(def delta_state_body_end ((bodyValue DeltaStateBody)) Int
  (match bodyValue
    ((DeltaStateBodySyntax start end statements terminalValue) end)))

(def delta_state_end ((stateValue DeltaState)) Int
  (match stateValue
    ((DeltaStateSyntax start end name parameters bodyValue) end)))

(def delta_reverse_statements ((input DeltaStatementList)
  (output DeltaStatementList)) DeltaStatementList
  (match input
    (NoDeltaStatements output)
    ((MoreDeltaStatements item rest)
      (delta_reverse_statements rest (MoreDeltaStatements item output)))))

(def delta_reverse_states ((input DeltaStateList) (output DeltaStateList)) DeltaStateList
  (match input
    (NoDeltaStates output)
    ((MoreDeltaStates item rest)
      (delta_reverse_states rest (MoreDeltaStates item output)))))

(def delta_state_body_reject_at ((source Bytes) (cursor Int)) DeltaStateBodyParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaStateBodyParseRejected UnexpectedEnd start)
      (DeltaStateBodyParseRejected UnexpectedToken start))))

(def delta_state_reject_at ((source Bytes) (cursor Int)) DeltaStateParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaStateParseRejected UnexpectedEnd start)
      (DeltaStateParseRejected UnexpectedToken start))))

(def delta_machine_body_reject_at ((source Bytes) (cursor Int)) DeltaMachineBodyParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaMachineBodyParseRejected UnexpectedEnd start)
      (DeltaMachineBodyParseRejected UnexpectedToken start))))

(def delta_parse_explicit_terminal ((source Bytes) (cursor Int)) DeltaTerminalParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 18)
        (delta_parse_return_terminal source start)
        (if (eq code 16)
          (let transitionOutcome (delta_parse_transition source start)
            (match transitionOutcome
              ((DeltaTransitionParseRejected reasonValue errorOffset)
                (DeltaTerminalParseRejected reasonValue errorOffset))
              ((DeltaTransitionParsed terminalValue)
                (DeltaTerminalParsed terminalValue))))
          (delta_terminal_reject_at source cursor))))))

(def delta_finish_state_terminal ((source Bytes) (bodyStart Int)
  (statements DeltaStatementList) (terminalValue DeltaTerminal)) DeltaStateBodyParseOutcome
  (let closeStart (delta_token_start source (delta_terminal_end terminalValue))
    (if (eq (delta_token_code source closeStart) 31)
      (let bodyEnd (delta_token_end source closeStart)
        (DeltaStateBodyParsed
          (DeltaStateBodySyntax bodyStart bodyEnd
            (delta_reverse_statements statements NoDeltaStatements)
            (SomeDeltaTerminal terminalValue))))
      (delta_state_body_reject_at source (delta_terminal_end terminalValue)))))

(def delta_parse_state_body_items ((source Bytes) (bodyStart Int) (cursor Int)
  (statements DeltaStatementList)) DeltaStateBodyParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaStateBodyParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (let bodyEnd (delta_token_end source start)
            (DeltaStateBodyParsed
              (DeltaStateBodySyntax bodyStart bodyEnd
                (delta_reverse_statements statements NoDeltaStatements)
                NoDeltaTerminal)))
          (if (eq code 18)
            (let terminalOutcome (delta_parse_explicit_terminal source start)
              (match terminalOutcome
                ((DeltaTerminalParseRejected reasonValue errorOffset)
                  (DeltaStateBodyParseRejected reasonValue errorOffset))
                ((DeltaTerminalParsed terminalValue)
                  (delta_finish_state_terminal source bodyStart statements terminalValue))))
            (if (eq code 16)
              (let terminalOutcome (delta_parse_explicit_terminal source start)
                (match terminalOutcome
                  ((DeltaTerminalParseRejected reasonValue errorOffset)
                    (DeltaStateBodyParseRejected reasonValue errorOffset))
                  ((DeltaTerminalParsed terminalValue)
                    (delta_finish_state_terminal source bodyStart statements terminalValue))))
              (if (eq code 15)
                (DeltaStateBodyParseRejected UnexpectedToken start)
                (let statementOutcome (delta_parse_statement source start)
                  (match statementOutcome
                    ((DeltaStatementParseRejected reasonValue errorOffset)
                      (DeltaStateBodyParseRejected reasonValue errorOffset))
                    ((DeltaStatementParsed statementValue)
                      (delta_parse_state_body_items source bodyStart
                        (delta_statement_end statementValue)
                        (MoreDeltaStatements statementValue statements)))))))))))))

(def delta_parse_state_body ((source Bytes) (cursor Int)) DeltaStateBodyParseOutcome
  (let bodyStart (delta_token_start source cursor)
    (if (eq (delta_token_code source bodyStart) 30)
      (delta_parse_state_body_items source bodyStart
        (delta_token_end source bodyStart) NoDeltaStatements)
      (delta_state_body_reject_at source cursor))))

(def delta_finish_state ((source Bytes) (stateStart Int) (nameStart Int)
  (nameEnd Int) (parameters DeltaParameterList) (cursor Int)) DeltaStateParseOutcome
  (let bodyOutcome (delta_parse_state_body source cursor)
    (match bodyOutcome
      ((DeltaStateBodyParseRejected reasonValue errorOffset)
        (DeltaStateParseRejected reasonValue errorOffset))
      ((DeltaStateBodyParsed bodyValue)
        (DeltaStateParsed
          (DeltaStateSyntax stateStart (delta_state_body_end bodyValue)
            (DeltaNameSpan nameStart nameEnd) parameters bodyValue))))))

(def delta_parse_state ((source Bytes) (cursor Int)) DeltaStateParseOutcome
  (let stateStart (delta_token_start source cursor)
    (if (eq (delta_token_code source stateStart) 15)
      (let nameStart (delta_token_start source (delta_token_end source stateStart))
        (if (eq (delta_token_code source nameStart) 1)
          (let nameEnd (delta_token_end source nameStart)
            (let openStart (delta_token_start source nameEnd)
              (if (eq (delta_token_code source openStart) 32)
                (let parametersOutcome
                  (delta_parse_parameters_acc source (delta_token_end source openStart)
                    33 NoDeltaParameters)
                  (match parametersOutcome
                    ((DeltaParameterListParseRejected reasonValue errorOffset)
                      (DeltaStateParseRejected reasonValue errorOffset))
                    ((DeltaParameterListParsed parameters closeStart)
                      (delta_finish_state source stateStart nameStart nameEnd parameters
                        (delta_token_end source closeStart)))))
                (delta_state_reject_at source nameEnd))))
          (delta_state_reject_at source (delta_token_end source stateStart))))
      (delta_state_reject_at source cursor))))

(def delta_finish_machine_body ((source Bytes) (bodyStart Int) (cursor Int)
  (statements DeltaStatementList) (terminalValue DeltaOptionalTerminal)
  (states DeltaStateList)) DeltaMachineBodyParseOutcome
  (let closeStart (delta_token_start source cursor)
    (if (eq (delta_token_code source closeStart) 31)
      (let bodyEnd (delta_token_end source closeStart)
        (DeltaMachineBodyParsed
          (DeltaMachineBodySyntax bodyStart bodyEnd
            (delta_reverse_statements statements NoDeltaStatements)
            terminalValue (delta_reverse_states states NoDeltaStates))))
      (delta_machine_body_reject_at source cursor))))

(def delta_parse_machine_states ((source Bytes) (bodyStart Int) (cursor Int)
  (statements DeltaStatementList) (terminalValue DeltaOptionalTerminal)
  (states DeltaStateList)) DeltaMachineBodyParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaMachineBodyParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (delta_finish_machine_body source bodyStart start statements terminalValue states)
          (if (eq code 15)
            (let stateOutcome (delta_parse_state source start)
              (match stateOutcome
                ((DeltaStateParseRejected reasonValue errorOffset)
                  (DeltaMachineBodyParseRejected reasonValue errorOffset))
                ((DeltaStateParsed stateValue)
                  (delta_parse_machine_states source bodyStart (delta_state_end stateValue)
                    statements terminalValue (MoreDeltaStates stateValue states)))))
            (DeltaMachineBodyParseRejected UnexpectedToken start)))))))

(def delta_parse_machine_terminal ((source Bytes) (bodyStart Int) (cursor Int)
  (statements DeltaStatementList)) DeltaMachineBodyParseOutcome
  (let terminalOutcome (delta_parse_explicit_terminal source cursor)
    (match terminalOutcome
      ((DeltaTerminalParseRejected reasonValue errorOffset)
        (DeltaMachineBodyParseRejected reasonValue errorOffset))
      ((DeltaTerminalParsed terminalValue)
        (delta_parse_machine_states source bodyStart (delta_terminal_end terminalValue)
          statements (SomeDeltaTerminal terminalValue) NoDeltaStates)))))

(def delta_parse_machine_body_items ((source Bytes) (bodyStart Int) (cursor Int)
  (statements DeltaStatementList)) DeltaMachineBodyParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaMachineBodyParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (delta_finish_machine_body source bodyStart start statements
            NoDeltaTerminal NoDeltaStates)
          (if (eq code 15)
            (delta_parse_machine_states source bodyStart start statements
              NoDeltaTerminal NoDeltaStates)
            (if (eq code 18)
              (delta_parse_machine_terminal source bodyStart start statements)
              (if (eq code 16)
                (delta_parse_machine_terminal source bodyStart start statements)
                (let statementOutcome (delta_parse_statement source start)
                  (match statementOutcome
                    ((DeltaStatementParseRejected reasonValue errorOffset)
                      (DeltaMachineBodyParseRejected reasonValue errorOffset))
                    ((DeltaStatementParsed statementValue)
                      (delta_parse_machine_body_items source bodyStart
                        (delta_statement_end statementValue)
                        (MoreDeltaStatements statementValue statements)))))))))))))

(def delta_parse_machine_body ((source Bytes) (cursor Int)) DeltaMachineBodyParseOutcome
  (let bodyStart (delta_token_start source cursor)
    (if (eq (delta_token_code source bodyStart) 30)
      (delta_parse_machine_body_items source bodyStart
        (delta_token_end source bodyStart) NoDeltaStatements)
      (delta_machine_body_reject_at source cursor))))

