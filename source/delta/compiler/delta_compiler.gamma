    (match returnOutcome
      ((DeltaReturnTypeParseRejected reasonValue errorOffset)
        (DeltaBoundaryMachineParseRejected reasonValue errorOffset))
      ((DeltaReturnTypeParsed returnType afterReturn)
        (let semiStart (delta_token_start source afterReturn)
          (if (eq (delta_token_code source semiStart) 36)
            (let machineEnd (delta_token_end source semiStart)
              (DeltaBoundaryMachineParsed
                (DeltaBoundaryMachineSyntax machineStart machineEnd
                  (DeltaNameSpan nameStart nameEnd) parameters returnType)))
            (delta_boundary_machine_reject_at source afterReturn)))))))

(def delta_parse_boundary_machine ((source Bytes)
  (cursor Int)) DeltaBoundaryMachineParseOutcome
  (let machineStart (delta_token_start source cursor)
    (if (eq (delta_token_code source machineStart) 14)
      (let nameStart (delta_token_start source (delta_token_end source machineStart))
        (if (eq (delta_token_code source nameStart) 1)
          (let nameEnd (delta_token_end source nameStart)
            (let openStart (delta_token_start source nameEnd)
              (if (eq (delta_token_code source openStart) 32)
