                (let ignored Int (write '\n')
                  (emit_program next)))
              (fail))))))))

(def emit_definition ((form Int)) Int
  (let head Int (form_head form)
    (let name Int (skip (token_end head))
      (let name_end Int (token_end name)
        (let ignored0 Int (write '(')
          (let ignored1 Int (emit_span head (token_end head))
            (let ignored2 Int (write '\s')
              (let ignored3 Int (emit_span name name_end)
