                    (+ instructionCount 1) bindingCount labels))))))))))

(def delta_alpha_layout ((program DeltaAlphaProgram)) DeltaAlphaLayoutOutcome
  (match program
    ((DeltaAlphaProgramItems labelCount items)
      (if (lt labelCount 0)
        (DeltaAlphaLayoutInternal 9)
        (if (lt 1048572 labelCount)
          (DeltaAlphaLayoutInternal 10)
          (delta_alpha_layout_items items labelCount 0 0 0
            EmptyDeltaAlphaTrie))))))

(def delta_alpha_safe_byte ((value Int)) Bytes
  (if (lt value 0)
    (bytes_empty)
    (if (lt 255 value) (bytes_empty) (bytes_single value))))

(def delta_alpha_word_bytes ((value Int) (remaining Int)) Bytes
  (if (if (lt remaining 0) 1 (lt 8 remaining))
    (bytes_empty)
    (if (eq remaining 0)
      (bytes_empty)
      (let remainder (% value 256)
        (let encodedByte
          (if (lt remainder 0) (+ remainder 256) remainder)
          (let quotient (/ value 256)
            (let nextValue
              (if (lt remainder 0) (- quotient 1) quotient)
              (bytes_concat (delta_alpha_safe_byte encodedByte)
                (delta_alpha_word_bytes nextValue (- remaining 1))))))))))

; Exponentiation-by-doubling keeps an over-limit raw-payload sentinel
; logarithmic in heap rows and rope depth.  The bytes are never eligible for
; publication: their exact length reaches the adapter's mandatory preflight.
(def delta_alpha_repeat_byte ((value Int) (count Int)) Bytes
  (if (if (lt count 0) 1 (lt 1048583 count))
    (bytes_empty)
    (if (lt count 1)
      (bytes_empty)
      (if (eq count 1)
        (delta_alpha_safe_byte value)
        (let halfCount (/ count 2)
          (let half (delta_alpha_repeat_byte value halfCount)
            (let doubled (bytes_concat half half)
              (if (eq (% count 2) 0)
                doubled
                (bytes_concat doubled
                  (delta_alpha_safe_byte value))))))))))

(def delta_alpha_make_oversized_candidate ((requested Int)) Bytes
  (if (lt requested 1048573)
    (bytes_empty)
    (if (lt 1048583 requested)
      (bytes_empty)
      (delta_alpha_repeat_byte 0 requested))))

(def delta_alpha_encode_resolved_target ((target Int)
  (payloadLength Int)) DeltaAlphaInstructionBytesOutcome
  (if (if (lt payloadLength 1) 1 (lt 1048572 payloadLength))
    (DeltaAlphaInstructionInternal 63)
    (if (lt target 0)
    (DeltaAlphaInstructionInternal 21)
    (if (lt target payloadLength)
      (DeltaAlphaInstructionEncoded (delta_alpha_word_bytes target 8))
      (DeltaAlphaInstructionInternal 21)))))

(def delta_alpha_resolve_target ((label Int) (labels DeltaAlphaTrie)
  (payloadLength Int)) DeltaAlphaInstructionBytesOutcome
  (match (delta_alpha_trie_lookup labels label)
    (NoDeltaAlphaTrieValue (DeltaAlphaInstructionInternal 20))
    ((SomeDeltaAlphaTrieValue target)
      (delta_alpha_encode_resolved_target target payloadLength))))

(def delta_alpha_encode_target_1 ((opcode Int) (label Int)
  (labels DeltaAlphaTrie) (payloadLength Int)) DeltaAlphaInstructionBytesOutcome
  (if (if (eq opcode 12) 1 (eq opcode 19))
