; ---- state and machine bodies ------------------------------------------

(def delta_statement_end ((statementValue DeltaStatement)) Int
  (match statementValue
    ((DeltaLetStatement start end name typeValue expressionValue) end)
    ((DeltaAssignmentStatement start end left right) end)
    ((DeltaPostfixStatement start end expressionValue) end)
    ((DeltaAssertStatement start end expressionValue) end)))

(def delta_terminal_end ((terminalValue DeltaTerminal)) Int
  (match terminalValue
    ((DeltaTransitionTerminal start end expressionValue arms) end)
    ((DeltaReturnTerminal start end expressionValue) end)))

(def delta_state_body_end ((bodyValue DeltaStateBody)) Int
  (match bodyValue
    ((DeltaStateBodySyntax start end statements terminalValue) end)))

(def delta_state_end ((stateValue DeltaState)) Int
  (match stateValue
    ((DeltaStateSyntax start end name parameters bodyValue) end)))

(def delta_reverse_statements ((input DeltaStatementList)
  (output DeltaStatementList)) DeltaStatementList
  (match input
    (NoDeltaStatements output)
    ((MoreDeltaStatements item rest)
      (delta_reverse_statements rest (MoreDeltaStatements item output)))))

(def delta_reverse_states ((input DeltaStateList) (output DeltaStateList)) DeltaStateList
