            (emit_generic_list open head head_end (skip head_end))))))))

(def emit_constructor ((open Int) (name Int) (name_end Int)) Int
  (let tag Int (find_constructor_tag name name_end)
    (let owner Int (find_constructor_owner name name_end)
      (let arity Int (find_constructor_arity name name_end)
