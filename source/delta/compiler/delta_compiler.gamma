(def delta_finish_field_member ((source Bytes) (nameStart Int) (nameEnd Int)
  (cursor Int)) DeltaDataMemberParseOutcome
  (let typeOutcome (delta_parse_type source cursor)
    (match typeOutcome
      ((DeltaTypeParseRejected reasonValue errorOffset)
        (DeltaDataMemberParseRejected reasonValue errorOffset))
      ((DeltaTypeParsed typeValue)
        (let semiStart (delta_token_start source (delta_type_end typeValue))
          (if (eq (delta_token_code source semiStart) 36)
            (let memberEnd (delta_token_end source semiStart)
              (DeltaDataMemberParsed
                (DeltaFieldMember nameStart memberEnd
                  (DeltaNameSpan nameStart nameEnd) typeValue)))
            (delta_data_member_reject_at source (delta_type_end typeValue))))))))

(def delta_parse_field_member ((source Bytes) (cursor Int)) DeltaDataMemberParseOutcome
  (let nameStart (delta_token_start source cursor)
    (let nameEnd (delta_token_end source nameStart)
      (let colonStart (delta_token_start source nameEnd)
        (if (eq (delta_token_code source colonStart) 37)
          (delta_finish_field_member source nameStart nameEnd
            (delta_token_end source colonStart))
          (delta_data_member_reject_at source nameEnd))))))

(def delta_finish_case_member ((source Bytes) (caseStart Int)
  (nameStart Int) (nameEnd Int) (payload DeltaOptionalPayload)
  (cursor Int)) DeltaDataMemberParseOutcome
  (let semiStart (delta_token_start source cursor)
    (if (eq (delta_token_code source semiStart) 36)
      (let memberEnd (delta_token_end source semiStart)
        (DeltaDataMemberParsed
          (DeltaCaseMember caseStart memberEnd
            (DeltaNameSpan nameStart nameEnd) payload)))
      (delta_data_member_reject_at source cursor))))

(def delta_parse_case_payload ((source Bytes) (caseStart Int)
  (nameStart Int) (nameEnd Int) (openStart Int)) DeltaDataMemberParseOutcome
  (let parametersOutcome
    (delta_parse_parameters_acc source (delta_token_end source openStart)
      33 NoDeltaParameters)
    (match parametersOutcome
      ((DeltaParameterListParseRejected reasonValue errorOffset)
        (DeltaDataMemberParseRejected reasonValue errorOffset))
      ((DeltaParameterListParsed parameters closeStart)
        (let closeEnd (delta_token_end source closeStart)
          (delta_finish_case_member source caseStart nameStart nameEnd
            (SomeDeltaPayload openStart closeEnd parameters) closeEnd))))))

(def delta_parse_case_member ((source Bytes) (cursor Int)) DeltaDataMemberParseOutcome
  (let caseStart (delta_token_start source cursor)
    (let nameStart (delta_token_start source (delta_token_end source caseStart))
      (if (eq (delta_token_code source nameStart) 1)
        (let nameEnd (delta_token_end source nameStart)
          (let followingStart (delta_token_start source nameEnd)
            (if (eq (delta_token_code source followingStart) 32)
              (delta_parse_case_payload source caseStart nameStart nameEnd
                followingStart)
              (delta_finish_case_member source caseStart nameStart nameEnd
                NoDeltaPayload followingStart))))
        (delta_data_member_reject_at source
          (delta_token_end source caseStart))))))

(def delta_parse_data_member ((source Bytes) (cursor Int)) DeltaDataMemberParseOutcome
  (let memberStart (delta_token_start source cursor)
    (let code (delta_token_code source memberStart)
      (if (eq code 1)
        (delta_parse_field_member source memberStart)
        (if (eq code 13)
          (delta_parse_case_member source memberStart)
          (delta_data_member_reject_at source cursor))))))

(def delta_parse_data_members ((source Bytes) (cursor Int)
  (accumulator DeltaDataMemberList)) DeltaDataMemberListParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaDataMemberListParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (DeltaDataMemberListParsed
            (delta_reverse_data_members accumulator NoDeltaDataMembers) start)
          (if (eq code 1)
            (let memberOutcome (delta_parse_data_member source start)
              (match memberOutcome
                ((DeltaDataMemberParseRejected reasonValue errorOffset)
                  (DeltaDataMemberListParseRejected reasonValue errorOffset))
                ((DeltaDataMemberParsed memberValue)
                  (delta_parse_data_members source (delta_data_member_end memberValue)
                    (MoreDeltaDataMembers memberValue accumulator)))))
            (if (eq code 13)
              (let memberOutcome (delta_parse_data_member source start)
                (match memberOutcome
                  ((DeltaDataMemberParseRejected reasonValue errorOffset)
                    (DeltaDataMemberListParseRejected reasonValue errorOffset))
                  ((DeltaDataMemberParsed memberValue)
                    (delta_parse_data_members source (delta_data_member_end memberValue)
                      (MoreDeltaDataMembers memberValue accumulator)))))
              (delta_data_member_list_reject_at source start))))))))

(def delta_parse_data_declaration ((source Bytes)
  (cursor Int)) DeltaDeclarationParseOutcome
  (let declarationStart (delta_token_start source cursor)
    (let nameStart (delta_token_start source
      (delta_token_end source declarationStart))
      (if (eq (delta_token_code source nameStart) 1)
        (let nameEnd (delta_token_end source nameStart)
          (let openStart (delta_token_start source nameEnd)
            (if (eq (delta_token_code source openStart) 30)
              (let membersOutcome
                (delta_parse_data_members source (delta_token_end source openStart)
                  NoDeltaDataMembers)
                (match membersOutcome
                  ((DeltaDataMemberListParseRejected reasonValue errorOffset)
                    (DeltaDeclarationParseRejected reasonValue errorOffset))
                  ((DeltaDataMemberListParsed members closeStart)
                    (let declarationEnd (delta_token_end source closeStart)
                      (DeltaDeclarationParsed
                        (DeltaDataDeclaration declarationStart declarationEnd
                          (DeltaNameSpan nameStart nameEnd) members))))))
              (delta_declaration_reject_at source nameEnd))))
        (delta_declaration_reject_at source
          (delta_token_end source declarationStart))))))

; ---- machine declarations and whole-program syntax --------------------

(def delta_qualified_name_end ((nameValue DeltaQualifiedName)) Int
  (match nameValue
    ((DeltaUnqualifiedName start end name) end)
    ((DeltaQualifiedNameSyntax start end owner name) end)))

(def delta_machine_body_end ((bodyValue DeltaMachineBody)) Int
  (match bodyValue
    ((DeltaMachineBodySyntax start end statements terminalValue states) end)))

(def delta_declaration_end ((declarationValue DeltaDeclaration)) Int
  (match declarationValue
    ((DeltaBoundaryDeclaration start end name machines) end)
    ((DeltaDataDeclaration start end name members) end)
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue) end)))

(def delta_reverse_declarations ((input DeltaDeclarationList)
  (output DeltaDeclarationList)) DeltaDeclarationList
  (match input
    (NoDeltaDeclarations output)
    ((MoreDeltaDeclarations item rest)
      (delta_reverse_declarations rest (MoreDeltaDeclarations item output)))))

(def delta_qualified_name_reject_at ((source Bytes)
  (cursor Int)) DeltaQualifiedNameParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaQualifiedNameParseRejected UnexpectedEnd start)
      (DeltaQualifiedNameParseRejected UnexpectedToken start))))

(def delta_machine_inputs_reject_at ((source Bytes)
  (cursor Int)) DeltaMachineInputsParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq start (bytes_length source))
      (DeltaMachineInputsParseRejected UnexpectedEnd start)
      (DeltaMachineInputsParseRejected UnexpectedToken start))))

(def delta_parse_qualified_name ((source Bytes)
  (cursor Int)) DeltaQualifiedNameParseOutcome
  (let firstStart (delta_token_start source cursor)
    (if (eq (delta_token_code source firstStart) 1)
      (let firstEnd (delta_token_end source firstStart)
        (let scopeStart (delta_token_start source firstEnd)
          (if (eq (delta_token_code source scopeStart) 43)
            (let secondStart (delta_token_start source
              (delta_token_end source scopeStart))
              (if (eq (delta_token_code source secondStart) 1)
                (let secondEnd (delta_token_end source secondStart)
                  (DeltaQualifiedNameParsed
                    (DeltaQualifiedNameSyntax firstStart secondEnd
                      (DeltaNameSpan firstStart firstEnd)
                      (DeltaNameSpan secondStart secondEnd))))
                (delta_qualified_name_reject_at source
                  (delta_token_end source scopeStart))))
            (DeltaQualifiedNameParsed
              (DeltaUnqualifiedName firstStart firstEnd
                (DeltaNameSpan firstStart firstEnd))))))
      (delta_qualified_name_reject_at source cursor))))

(def delta_parse_receiver_parameters ((source Bytes) (openStart Int)
  (receiverStart Int) (receiverEnd Int) (cursor Int)) DeltaMachineInputsParseOutcome
  (let parameterStart (delta_token_start source cursor)
    (if (eq (delta_token_code source parameterStart) 33)
      (DeltaMachineInputsParseRejected UnexpectedToken parameterStart)
      (let parametersOutcome
        (delta_parse_parameters_acc source parameterStart 33 NoDeltaParameters)
        (match parametersOutcome
          ((DeltaParameterListParseRejected reasonValue errorOffset)
            (DeltaMachineInputsParseRejected reasonValue errorOffset))
          ((DeltaParameterListParsed parameters closeStart)
            (DeltaMachineInputsParsed
              (DeltaReceiverMachineInputs openStart
                (delta_token_end source closeStart) receiverStart receiverEnd parameters)
              closeStart)))))))

(def delta_finish_receiver_inputs ((source Bytes) (openStart Int)
  (receiverStart Int) (receiverEnd Int) (cursor Int)) DeltaMachineInputsParseOutcome
  (let followingStart (delta_token_start source cursor)
    (let followingCode (delta_token_code source followingStart)
      (if (eq followingCode 33)
        (DeltaMachineInputsParsed
          (DeltaReceiverMachineInputs openStart
            (delta_token_end source followingStart) receiverStart receiverEnd
            NoDeltaParameters)
          followingStart)
        (if (eq followingCode 38)
          (delta_parse_receiver_parameters source openStart receiverStart
            receiverEnd (delta_token_end source followingStart))
          (delta_machine_inputs_reject_at source cursor))))))

(def delta_parse_receiver_inputs ((source Bytes) (openStart Int)
  (cursor Int)) DeltaMachineInputsParseOutcome
  (let receiverStart (delta_token_start source cursor)
    (let mutStart (delta_token_start source (delta_token_end source receiverStart))
      (if (eq (delta_token_code source mutStart) 23)
        (let selfStart (delta_token_start source (delta_token_end source mutStart))
          (if (eq (delta_token_code source selfStart) 22)
            (let receiverEnd (delta_token_end source selfStart)
              (delta_finish_receiver_inputs source openStart receiverStart
                receiverEnd receiverEnd))
            (delta_machine_inputs_reject_at source
              (delta_token_end source mutStart))))
        (delta_machine_inputs_reject_at source
          (delta_token_end source receiverStart))))))

(def delta_parse_plain_machine_inputs ((source Bytes) (openStart Int)
  (cursor Int)) DeltaMachineInputsParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 33)
        (DeltaMachineInputsParsed
          (NoDeltaMachineInputs openStart (delta_token_end source start)) start)
        (if (eq code 40)
          (DeltaMachineInputsParseRejected UnexpectedToken start)
          (let parametersOutcome
            (delta_parse_parameters_acc source start 33 NoDeltaParameters)
            (match parametersOutcome
              ((DeltaParameterListParseRejected reasonValue errorOffset)
                (DeltaMachineInputsParseRejected reasonValue errorOffset))
              ((DeltaParameterListParsed parameters closeStart)
                (DeltaMachineInputsParsed
                  (DeltaPlainMachineInputs openStart
                    (delta_token_end source closeStart) parameters)
                  closeStart)))))))))

(def delta_parse_qualified_machine_inputs ((source Bytes) (openStart Int)
  (cursor Int)) DeltaMachineInputsParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq (delta_token_code source start) 40)
      (delta_parse_receiver_inputs source openStart start)
      (delta_parse_plain_machine_inputs source openStart start))))

(def delta_parse_machine_inputs_for_name ((source Bytes)
  (nameValue DeltaQualifiedName) (openStart Int)
  (cursor Int)) DeltaMachineInputsParseOutcome
  (match nameValue
    ((DeltaUnqualifiedName start end name)
      (delta_parse_plain_machine_inputs source openStart cursor))
    ((DeltaQualifiedNameSyntax start end owner name)
      (delta_parse_qualified_machine_inputs source openStart cursor))))

(def delta_finish_machine_declaration ((source Bytes) (machineStart Int)
  (nameValue DeltaQualifiedName) (inputs DeltaMachineInputs)
  (cursor Int)) DeltaDeclarationParseOutcome
  (let returnOutcome (delta_parse_optional_return_type source cursor)
    (match returnOutcome
      ((DeltaReturnTypeParseRejected reasonValue errorOffset)
        (DeltaDeclarationParseRejected reasonValue errorOffset))
      ((DeltaReturnTypeParsed returnType afterReturn)
        (let bodyOutcome (delta_parse_machine_body source afterReturn)
          (match bodyOutcome
            ((DeltaMachineBodyParseRejected reasonValue errorOffset)
              (DeltaDeclarationParseRejected reasonValue errorOffset))
            ((DeltaMachineBodyParsed bodyValue)
              (DeltaDeclarationParsed
                (DeltaMachineDeclaration machineStart
                  (delta_machine_body_end bodyValue) nameValue inputs
                  returnType bodyValue)))))))))

(def delta_parse_machine_declaration ((source Bytes)
  (cursor Int)) DeltaDeclarationParseOutcome
  (let machineStart (delta_token_start source cursor)
    (let nameOutcome (delta_parse_qualified_name source
      (delta_token_end source machineStart))
      (match nameOutcome
        ((DeltaQualifiedNameParseRejected reasonValue errorOffset)
          (DeltaDeclarationParseRejected reasonValue errorOffset))
        ((DeltaQualifiedNameParsed nameValue)
          (let openStart (delta_token_start source
            (delta_qualified_name_end nameValue))
            (if (eq (delta_token_code source openStart) 32)
              (let inputsOutcome (delta_parse_machine_inputs_for_name source
                nameValue openStart (delta_token_end source openStart))
                (match inputsOutcome
                  ((DeltaMachineInputsParseRejected reasonValue errorOffset)
                    (DeltaDeclarationParseRejected reasonValue errorOffset))
                  ((DeltaMachineInputsParsed inputs closeStart)
                    (delta_finish_machine_declaration source machineStart nameValue
                      inputs (delta_token_end source closeStart)))))
              (delta_declaration_reject_at source
                (delta_qualified_name_end nameValue)))))))))

(def delta_parse_declaration ((source Bytes)
  (cursor Int)) DeltaDeclarationParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 10)
        (delta_parse_boundary_declaration source start)
        (if (eq code 12)
          (delta_parse_data_declaration source start)
          (if (eq code 14)
            (delta_parse_machine_declaration source start)
            (delta_declaration_reject_at source cursor)))))))

(def delta_parse_program_declarations ((source Bytes) (programStart Int)
  (cursor Int) (lastEnd Int) (accumulator DeltaDeclarationList)) DeltaProgramParseOutcome
  (let start (delta_token_start source cursor)
    (if (eq (delta_token_code source start) 0)
      (DeltaProgramParsed
        (DeltaSyntaxProgram programStart lastEnd
          (delta_reverse_declarations accumulator NoDeltaDeclarations)))
      (let declarationOutcome (delta_parse_declaration source start)
        (match declarationOutcome
          ((DeltaDeclarationParseRejected reasonValue errorOffset)
            (DeltaProgramParseRejected reasonValue errorOffset))
          ((DeltaDeclarationParsed declarationValue)
            (let declarationEnd (delta_declaration_end declarationValue)
              (delta_parse_program_declarations source programStart declarationEnd
                declarationEnd
                (MoreDeltaDeclarations declarationValue accumulator)))))))))

(def delta_parse_program_syntax ((source Bytes)) DeltaProgramParseOutcome
  (let lexicalOutcome (check_lexical source)
    (match lexicalOutcome
      (LexicallyValid
        (let programStart (delta_token_start source 0)
          (if (eq programStart (bytes_length source))
            (DeltaProgramParseRejected UnexpectedEnd programStart)
            (delta_parse_program_declarations source programStart programStart
              programStart NoDeltaDeclarations))))
      ((LexicallyRejected reasonValue errorOffset)
        (DeltaProgramParseRejected reasonValue errorOffset)))))

; ---- D22/D24 declaration census ---------------------------------------

(def delta_census_min_present ((leftReason DeltaRejectReason)
  (leftOffset Int) (right DeltaCensusCandidate)) DeltaCensusCandidate
  (match right
    (NoDeltaCensusCandidate
      (DeltaCensusCandidateAt leftReason leftOffset))
    ((DeltaCensusCandidateAt rightReason rightOffset)
      (if (lt rightOffset leftOffset)
        (DeltaCensusCandidateAt rightReason rightOffset)
        (DeltaCensusCandidateAt leftReason leftOffset)))))

(def delta_census_min ((left DeltaCensusCandidate)
  (right DeltaCensusCandidate)) DeltaCensusCandidate
  (match left
    (NoDeltaCensusCandidate right)
    ((DeltaCensusCandidateAt leftReason leftOffset)
      (delta_census_min_present leftReason leftOffset right))))

(def delta_census_duplicate ((offset Int)) DeltaCensusCandidate
  (DeltaCensusCandidateAt DuplicateName offset))

(def delta_name_start ((nameValue DeltaName)) Int
  (match nameValue ((DeltaNameSpan start end) start)))

(def delta_name_end ((nameValue DeltaName)) Int
  (match nameValue ((DeltaNameSpan start end) end)))

(def delta_name_bytes_equal ((source Bytes) (left Int) (right Int)
  (remaining Int)) Int
  (if (eq remaining 0)
    1
    (if (eq (bytes_get source left) (bytes_get source right))
      (delta_name_bytes_equal source (+ left 1) (+ right 1)
        (- remaining 1))
      0)))

(def delta_names_equal ((source Bytes) (left DeltaName)
  (right DeltaName)) Int
  (let leftStart (delta_name_start left)
    (let rightStart (delta_name_start right)
      (let leftLength (- (delta_name_end left) leftStart)
        (let rightLength (- (delta_name_end right) rightStart)
          (if (eq leftLength rightLength)
            (delta_name_bytes_equal source leftStart rightStart leftLength)
            0))))))

(def delta_census_name_in_list ((source Bytes) (nameValue DeltaName)
  (names DeltaNameList)) Int
  (match names
    (NoDeltaNames 0)
    ((MoreDeltaNames item rest)
      (if (delta_names_equal source nameValue item)
        1
        (delta_census_name_in_list source nameValue rest)))))

(def delta_census_name_against_names ((source Bytes)
  (nameValue DeltaName) (names DeltaNameList)) DeltaCensusCandidate
  (match names
    (NoDeltaNames NoDeltaCensusCandidate)
    ((MoreDeltaNames item rest)
      (let current
        (if (delta_names_equal source nameValue item)
          (delta_census_duplicate (delta_name_start item))
          NoDeltaCensusCandidate)
        (delta_census_min current
          (delta_census_name_against_names source nameValue rest))))))

(def delta_census_name_list_duplicates ((source Bytes)
  (names DeltaNameList)) DeltaCensusCandidate
  (match names
    (NoDeltaNames NoDeltaCensusCandidate)
    ((MoreDeltaNames item rest)
      (delta_census_min
        (delta_census_name_against_names source item rest)
        (delta_census_name_list_duplicates source rest)))))

(def delta_parameter_start ((parameterValue DeltaParameter)) Int
  (match parameterValue
    ((DeltaParameterSyntax start end name typeValue) start)))

(def delta_parameter_name ((parameterValue DeltaParameter)) DeltaName
  (match parameterValue
    ((DeltaParameterSyntax start end name typeValue) name)))

(def delta_census_parameter_against ((source Bytes) (nameValue DeltaName)
  (parameters DeltaParameterList)) DeltaCensusCandidate
  (match parameters
    (NoDeltaParameters NoDeltaCensusCandidate)
    ((MoreDeltaParameters item rest)
      (let current
        (if (delta_names_equal source nameValue (delta_parameter_name item))
          (delta_census_duplicate (delta_parameter_start item))
          NoDeltaCensusCandidate)
        (delta_census_min current
          (delta_census_parameter_against source nameValue rest))))))

(def delta_census_parameter_duplicates ((source Bytes)
  (parameters DeltaParameterList)) DeltaCensusCandidate
  (match parameters
    (NoDeltaParameters NoDeltaCensusCandidate)
    ((MoreDeltaParameters item rest)
      (delta_census_min
        (delta_census_parameter_against source (delta_parameter_name item) rest)
        (delta_census_parameter_duplicates source rest)))))

(def delta_census_parameter_outer_collisions ((source Bytes)
  (parameters DeltaParameterList)
  (environment DeltaNameList)) DeltaCensusCandidate
  (match parameters
    (NoDeltaParameters NoDeltaCensusCandidate)
    ((MoreDeltaParameters item rest)
      (let current
        (if (delta_census_name_in_list source (delta_parameter_name item)
          environment)
          (delta_census_duplicate (delta_parameter_start item))
          NoDeltaCensusCandidate)
        (delta_census_min current
          (delta_census_parameter_outer_collisions source rest environment))))))

(def delta_census_prepend_parameters ((parameters DeltaParameterList)
  (environment DeltaNameList)) DeltaNameList
  (match parameters
    (NoDeltaParameters environment)
    ((MoreDeltaParameters item rest)
      (MoreDeltaNames (delta_parameter_name item)
        (delta_census_prepend_parameters rest environment)))))

(def delta_census_inputs_parameters ((inputs DeltaMachineInputs)) DeltaParameterList
  (match inputs
    ((NoDeltaMachineInputs start end) NoDeltaParameters)
    ((DeltaPlainMachineInputs start end parameters) parameters)
    ((DeltaReceiverMachineInputs start end receiverStart receiverEnd parameters)
      parameters)))

(def delta_census_scan_statements ((source Bytes)
  (statements DeltaStatementList)
  (environment DeltaNameList)) DeltaCensusLocalScan
  (match statements
    (NoDeltaStatements
      (DeltaCensusLocalScanResult NoDeltaCensusCandidate environment))
    ((MoreDeltaStatements item rest)
      (match item
        ((DeltaLetStatement start end name typeValue expressionValue)
          (let current
            (if (delta_census_name_in_list source name environment)
              (delta_census_duplicate start)
              NoDeltaCensusCandidate)
            (let tailScan
              (delta_census_scan_statements source rest
                (MoreDeltaNames name environment))
              (match tailScan
                ((DeltaCensusLocalScanResult tailCandidate tailEnvironment)
                  (DeltaCensusLocalScanResult
                    (delta_census_min current tailCandidate)
                    tailEnvironment))))))
        ((DeltaAssignmentStatement start end placeValue expressionValue)
          (delta_census_scan_statements source rest environment))
        ((DeltaPostfixStatement start end expressionValue)
          (delta_census_scan_statements source rest environment))
        ((DeltaAssertStatement start end expressionValue)
          (delta_census_scan_statements source rest environment))))))

(def delta_census_binder_outer_collisions ((source Bytes)
  (names DeltaNameList) (environment DeltaNameList)) DeltaCensusCandidate
  (match names
    (NoDeltaNames NoDeltaCensusCandidate)
    ((MoreDeltaNames item rest)
      (let current
        (if (delta_census_name_in_list source item environment)
          (delta_census_duplicate (delta_name_start item))
          NoDeltaCensusCandidate)
        (delta_census_min current
          (delta_census_binder_outer_collisions source rest environment))))))

(def delta_census_optional_binder ((source Bytes)
  (binder DeltaOptionalBinder)
  (environment DeltaNameList)) DeltaCensusCandidate
  (match binder
    (NoDeltaBinder NoDeltaCensusCandidate)
    ((SomeDeltaBinder start end names)
      (delta_census_min
        (delta_census_name_list_duplicates source names)
        (delta_census_binder_outer_collisions source names environment)))))

(def delta_census_pattern_binder ((source Bytes) (patternValue DeltaPattern)
  (environment DeltaNameList)) DeltaCensusCandidate
  (match patternValue
    ((DeltaIntegerPattern start end literal) NoDeltaCensusCandidate)
    ((DeltaTruePattern start end) NoDeltaCensusCandidate)
    ((DeltaFalsePattern start end) NoDeltaCensusCandidate)
    ((DeltaWildcardPattern start end) NoDeltaCensusCandidate)
    ((DeltaCasePattern start end owner name binder)
      (delta_census_optional_binder source binder environment))))

(def delta_census_arms ((source Bytes) (arms DeltaArmList)
  (environment DeltaNameList)) DeltaCensusCandidate
  (match arms
    (NoDeltaArms NoDeltaCensusCandidate)
    ((MoreDeltaArms item rest)
      (match item
        ((DeltaArmSyntax start end patternValue continuationValue)
          (delta_census_min
            (delta_census_pattern_binder source patternValue environment)
            (delta_census_arms source rest environment)))))))

(def delta_census_optional_terminal ((source Bytes)
  (terminalValue DeltaOptionalTerminal)
  (environment DeltaNameList)) DeltaCensusCandidate
  (match terminalValue
    (NoDeltaTerminal NoDeltaCensusCandidate)
    ((SomeDeltaTerminal terminal)
      (match terminal
        ((DeltaTransitionTerminal start end subject arms)
          (delta_census_arms source arms environment))
        ((DeltaReturnTerminal start end expressionValue)
          NoDeltaCensusCandidate)))))

(def delta_census_block ((source Bytes) (statements DeltaStatementList)
  (terminalValue DeltaOptionalTerminal)
  (environment DeltaNameList)) DeltaCensusCandidate
  (let localScan (delta_census_scan_statements source statements environment)
    (match localScan
      ((DeltaCensusLocalScanResult localCandidate finalEnvironment)
        (delta_census_min localCandidate
          (delta_census_optional_terminal source terminalValue
            finalEnvironment))))))

(def delta_state_start ((stateValue DeltaState)) Int
  (match stateValue
    ((DeltaStateSyntax start end name parameters bodyValue) start)))

(def delta_state_name ((stateValue DeltaState)) DeltaName
  (match stateValue
    ((DeltaStateSyntax start end name parameters bodyValue) name)))

(def delta_census_state_against ((source Bytes) (nameValue DeltaName)
  (states DeltaStateList)) DeltaCensusCandidate
  (match states
    (NoDeltaStates NoDeltaCensusCandidate)
    ((MoreDeltaStates item rest)
      (let current
        (if (delta_names_equal source nameValue (delta_state_name item))
          (delta_census_duplicate (delta_state_start item))
          NoDeltaCensusCandidate)
        (delta_census_min current
          (delta_census_state_against source nameValue rest))))))

(def delta_census_state_duplicates ((source Bytes)
  (states DeltaStateList)) DeltaCensusCandidate
  (match states
    (NoDeltaStates NoDeltaCensusCandidate)
    ((MoreDeltaStates item rest)
      (delta_census_min
        (delta_census_state_against source (delta_state_name item) rest)
        (delta_census_state_duplicates source rest)))))

(def delta_census_state_scope ((source Bytes) (stateValue DeltaState)
  (machineEnvironment DeltaNameList)) DeltaCensusCandidate
  (match stateValue
    ((DeltaStateSyntax start end name parameters bodyValue)
      (let parameterCandidates
        (delta_census_min
          (delta_census_parameter_duplicates source parameters)
          (delta_census_parameter_outer_collisions source parameters
            machineEnvironment))
        (let stateEnvironment
          (delta_census_prepend_parameters parameters machineEnvironment)
          (match bodyValue
            ((DeltaStateBodySyntax bodyStart bodyEnd statements terminalValue)
              (delta_census_min parameterCandidates
                (delta_census_block source statements terminalValue
                  stateEnvironment)))))))))

(def delta_census_state_scopes ((source Bytes) (states DeltaStateList)
  (machineEnvironment DeltaNameList)) DeltaCensusCandidate
  (match states
    (NoDeltaStates NoDeltaCensusCandidate)
    ((MoreDeltaStates item rest)
      (delta_census_min
        (delta_census_state_scope source item machineEnvironment)
        (delta_census_state_scopes source rest machineEnvironment)))))

(def delta_census_machine_scope ((source Bytes) (inputs DeltaMachineInputs)
  (bodyValue DeltaMachineBody)) DeltaCensusCandidate
  (let parameters (delta_census_inputs_parameters inputs)
    (let parameterCandidates
      (delta_census_parameter_duplicates source parameters)
      (let machineEnvironment
        (delta_census_prepend_parameters parameters NoDeltaNames)
        (match bodyValue
          ((DeltaMachineBodySyntax start end statements terminalValue states)
            (delta_census_min parameterCandidates
              (delta_census_min
                (delta_census_block source statements terminalValue
                  machineEnvironment)
                (delta_census_min
                  (delta_census_state_duplicates source states)
                  (delta_census_state_scopes source states
                    machineEnvironment))))))))))

(def delta_boundary_machine_start ((machineValue DeltaBoundaryMachine)) Int
  (match machineValue
    ((DeltaBoundaryMachineSyntax start end name parameters returnType) start)))

(def delta_boundary_machine_name ((machineValue DeltaBoundaryMachine)) DeltaName
  (match machineValue
    ((DeltaBoundaryMachineSyntax start end name parameters returnType) name)))

(def delta_census_boundary_machine_against ((source Bytes)
  (nameValue DeltaName)
  (machines DeltaBoundaryMachineList)) DeltaCensusCandidate
  (match machines
    (NoDeltaBoundaryMachines NoDeltaCensusCandidate)
    ((MoreDeltaBoundaryMachines item rest)
      (let current
        (if (delta_names_equal source nameValue
          (delta_boundary_machine_name item))
          (delta_census_duplicate (delta_boundary_machine_start item))
          NoDeltaCensusCandidate)
        (delta_census_min current
          (delta_census_boundary_machine_against source nameValue rest))))))

(def delta_census_boundary_machine_duplicates ((source Bytes)
  (machines DeltaBoundaryMachineList)) DeltaCensusCandidate
  (match machines
    (NoDeltaBoundaryMachines NoDeltaCensusCandidate)
    ((MoreDeltaBoundaryMachines item rest)
      (delta_census_min
        (delta_census_boundary_machine_against source
          (delta_boundary_machine_name item) rest)
        (delta_census_boundary_machine_duplicates source rest)))))

(def delta_census_boundary_machine_parameters ((source Bytes)
  (machines DeltaBoundaryMachineList)) DeltaCensusCandidate
  (match machines
    (NoDeltaBoundaryMachines NoDeltaCensusCandidate)
    ((MoreDeltaBoundaryMachines item rest)
      (match item
        ((DeltaBoundaryMachineSyntax start end name parameters returnType)
          (delta_census_min
            (delta_census_parameter_duplicates source parameters)
            (delta_census_boundary_machine_parameters source rest)))))))

(def delta_data_member_start ((memberValue DeltaDataMember)) Int
  (match memberValue
    ((DeltaFieldMember start end name typeValue) start)
    ((DeltaCaseMember start end name payload) start)))

(def delta_data_member_name ((memberValue DeltaDataMember)) DeltaName
  (match memberValue
    ((DeltaFieldMember start end name typeValue) name)
    ((DeltaCaseMember start end name payload) name)))

(def delta_census_data_member_against ((source Bytes) (nameValue DeltaName)
  (members DeltaDataMemberList)) DeltaCensusCandidate
  (match members
    (NoDeltaDataMembers NoDeltaCensusCandidate)
    ((MoreDeltaDataMembers item rest)
      (let current
        (if (delta_names_equal source nameValue (delta_data_member_name item))
          (delta_census_duplicate (delta_data_member_start item))
          NoDeltaCensusCandidate)
        (delta_census_min current
          (delta_census_data_member_against source nameValue rest))))))

(def delta_census_data_member_duplicates ((source Bytes)
  (members DeltaDataMemberList)) DeltaCensusCandidate
  (match members
    (NoDeltaDataMembers NoDeltaCensusCandidate)
    ((MoreDeltaDataMembers item rest)
      (delta_census_min
        (delta_census_data_member_against source
          (delta_data_member_name item) rest)
        (delta_census_data_member_duplicates source rest)))))

(def delta_census_data_payload_parameters ((source Bytes)
  (members DeltaDataMemberList)) DeltaCensusCandidate
  (match members
    (NoDeltaDataMembers NoDeltaCensusCandidate)
    ((MoreDeltaDataMembers item rest)
      (match item
        ((DeltaFieldMember start end name typeValue)
          (delta_census_data_payload_parameters source rest))
        ((DeltaCaseMember start end name payload)
          (let current
            (match payload
              (NoDeltaPayload NoDeltaCensusCandidate)
              ((SomeDeltaPayload payloadStart payloadEnd parameters)
                (delta_census_parameter_duplicates source parameters)))
            (delta_census_min current
              (delta_census_data_payload_parameters source rest))))))))

(def delta_unqualified_name_equal_right ((source Bytes) (leftName DeltaName)
  (right DeltaQualifiedName)) Int
  (match right
    ((DeltaUnqualifiedName rightStart rightEnd rightName)
      (delta_names_equal source leftName rightName))
    ((DeltaQualifiedNameSyntax rightStart rightEnd rightOwner rightName) 0)))

(def delta_qualified_name_equal_right ((source Bytes) (leftOwner DeltaName)
  (leftName DeltaName) (right DeltaQualifiedName)) Int
  (match right
    ((DeltaUnqualifiedName rightStart rightEnd rightName) 0)
    ((DeltaQualifiedNameSyntax rightStart rightEnd rightOwner rightName)
      (if (delta_names_equal source leftOwner rightOwner)
        (delta_names_equal source leftName rightName)
        0))))

(def delta_qualified_names_equal ((source Bytes)
  (left DeltaQualifiedName) (right DeltaQualifiedName)) Int
  (match left
    ((DeltaUnqualifiedName leftStart leftEnd leftName)
      (delta_unqualified_name_equal_right source leftName right))
    ((DeltaQualifiedNameSyntax leftStart leftEnd leftOwner leftName)
      (delta_qualified_name_equal_right source leftOwner leftName right))))

(def delta_owner_identity_merge_present ((left DeltaOwnerIdentity)
  (right DeltaOwnerIdentity)) DeltaOwnerIdentity
  (match right
    (NoDeltaOwnerIdentity left)
    (OneDeltaBoundaryOwner AmbiguousDeltaOwnerIdentity)
    (OneDeltaDataOwner AmbiguousDeltaOwnerIdentity)
    (AmbiguousDeltaOwnerIdentity AmbiguousDeltaOwnerIdentity)))

(def delta_owner_identity_merge ((left DeltaOwnerIdentity)
  (right DeltaOwnerIdentity)) DeltaOwnerIdentity
  (match left
    (NoDeltaOwnerIdentity right)
    (OneDeltaBoundaryOwner
      (delta_owner_identity_merge_present OneDeltaBoundaryOwner right))
    (OneDeltaDataOwner
      (delta_owner_identity_merge_present OneDeltaDataOwner right))
    (AmbiguousDeltaOwnerIdentity AmbiguousDeltaOwnerIdentity)))

(def delta_owner_identity_for_rows ((source Bytes) (owner DeltaName)
  (rows DeltaOwnerRowList)) DeltaOwnerIdentity
  (match rows
    (NoDeltaOwnerRows NoDeltaOwnerIdentity)
    ((MoreDeltaOwnerRows item rest)
      (match item
        ((DeltaOwnerRowSyntax declarationStart rowName kind)
          (let current
            (if (delta_names_equal source owner rowName)
              (match kind
                (DeltaBoundaryOwnerKind OneDeltaBoundaryOwner)
                (DeltaDataOwnerKind OneDeltaDataOwner))
              NoDeltaOwnerIdentity)
            (delta_owner_identity_merge current
              (delta_owner_identity_for_rows source owner rest))))))))

(def delta_reverse_owner_rows ((input DeltaOwnerRowList)
  (output DeltaOwnerRowList)) DeltaOwnerRowList
  (match input
    (NoDeltaOwnerRows output)
    ((MoreDeltaOwnerRows item rest)
      (delta_reverse_owner_rows rest (MoreDeltaOwnerRows item output)))))

(def delta_collect_owner_rows_acc ((declarations DeltaDeclarationList)
  (accumulator DeltaOwnerRowList)) DeltaOwnerRowList
  (match declarations
    (NoDeltaDeclarations
      (delta_reverse_owner_rows accumulator NoDeltaOwnerRows))
    ((MoreDeltaDeclarations item rest)
      (match item
        ((DeltaBoundaryDeclaration start end name machines)
          (delta_collect_owner_rows_acc rest
            (MoreDeltaOwnerRows
              (DeltaOwnerRowSyntax start name DeltaBoundaryOwnerKind)
              accumulator)))
        ((DeltaDataDeclaration start end name members)
          (delta_collect_owner_rows_acc rest
            (MoreDeltaOwnerRows
              (DeltaOwnerRowSyntax start name DeltaDataOwnerKind)
              accumulator)))
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          (delta_collect_owner_rows_acc rest accumulator))))))

(def delta_reverse_machine_rows ((input DeltaMachineRowList)
  (output DeltaMachineRowList)) DeltaMachineRowList
  (match input
    (NoDeltaMachineRows output)
    ((MoreDeltaMachineRows item rest)
      (delta_reverse_machine_rows rest (MoreDeltaMachineRows item output)))))

(def delta_collect_machine_rows_acc ((declarations DeltaDeclarationList)
  (accumulator DeltaMachineRowList)) DeltaMachineRowList
  (match declarations
    (NoDeltaDeclarations
      (delta_reverse_machine_rows accumulator NoDeltaMachineRows))
    ((MoreDeltaDeclarations item rest)
      (match item
        ((DeltaBoundaryDeclaration start end name machines)
          (delta_collect_machine_rows_acc rest accumulator))
        ((DeltaDataDeclaration start end name members)
          (delta_collect_machine_rows_acc rest accumulator))
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          (delta_collect_machine_rows_acc rest
            (MoreDeltaMachineRows (DeltaMachineRowSyntax start name)
              accumulator)))))))

; D36 adds one narrow cross-kind callable registry without flattening the
; accepted catalog. A case collides only with a qualified machine whose owner
; resolves uniquely to that data declaration. Unknown, boundary, and ambiguous
; owners therefore remain in their existing later resolution/classification
; judgments rather than acquiring an inferred data-owner kind here.
(def delta_census_later_callable_start ((leftStart Int)
  (rightStart Int)) Int
  (if (lt leftStart rightStart) rightStart leftStart))

(def delta_census_case_against_machine_rows ((source Bytes)
  (owner DeltaName) (caseStart Int) (caseName DeltaName)
  (machines DeltaMachineRowList)) DeltaCensusCandidate
  (match machines
    (NoDeltaMachineRows NoDeltaCensusCandidate)
    ((MoreDeltaMachineRows item rest)
      (match item
        ((DeltaMachineRowSyntax machineStart qualifiedName)
          (let current
            (match qualifiedName
              ((DeltaUnqualifiedName nameStart nameEnd machineName)
                NoDeltaCensusCandidate)
              ((DeltaQualifiedNameSyntax nameStart nameEnd machineOwner
                machineName)
                (if (if (delta_names_equal source owner machineOwner)
                      (delta_names_equal source caseName machineName)
                      0)
                  (delta_census_duplicate
                    (delta_census_later_callable_start caseStart machineStart))
                  NoDeltaCensusCandidate)))
            (delta_census_min current
              (delta_census_case_against_machine_rows source owner caseStart
                caseName rest))))))))

(def delta_census_data_callable_members ((source Bytes) (owner DeltaName)
  (members DeltaDataMemberList)
  (machines DeltaMachineRowList)) DeltaCensusCandidate
  (match members
    (NoDeltaDataMembers NoDeltaCensusCandidate)
    ((MoreDeltaDataMembers item rest)
      (match item
        ((DeltaFieldMember start end name typeValue)
          (delta_census_data_callable_members source owner rest machines))
        ((DeltaCaseMember start end name payload)
          (delta_census_min
            (delta_census_case_against_machine_rows source owner start name
              machines)
            (delta_census_data_callable_members source owner rest machines)))))))

(def delta_census_callable_collisions ((source Bytes)
  (declarations DeltaDeclarationList) (owners DeltaOwnerRowList)
  (machines DeltaMachineRowList)) DeltaCensusCandidate
  (match declarations
    (NoDeltaDeclarations NoDeltaCensusCandidate)
    ((MoreDeltaDeclarations item rest)
      (let current
        (match item
          ((DeltaBoundaryDeclaration start end name boundaryMachines)
            NoDeltaCensusCandidate)
          ((DeltaDataDeclaration start end name members)
            (match (delta_owner_identity_for_rows source name owners)
              (OneDeltaDataOwner
                (delta_census_data_callable_members source name members
                  machines))
              (NoDeltaOwnerIdentity NoDeltaCensusCandidate)
              (OneDeltaBoundaryOwner NoDeltaCensusCandidate)
              (AmbiguousDeltaOwnerIdentity NoDeltaCensusCandidate)))
          ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
            NoDeltaCensusCandidate))
        (delta_census_min current
          (delta_census_callable_collisions source rest owners machines))))))

(def delta_census_owner_name_against ((source Bytes) (nameValue DeltaName)
  (declarations DeltaDeclarationList)) DeltaCensusCandidate
  (match declarations
    (NoDeltaDeclarations NoDeltaCensusCandidate)
    ((MoreDeltaDeclarations item rest)
      (match item
        ((DeltaBoundaryDeclaration start end name machines)
          (let current
            (if (delta_names_equal source nameValue name)
              (delta_census_duplicate start)
              NoDeltaCensusCandidate)
            (delta_census_min current
              (delta_census_owner_name_against source nameValue rest))))
        ((DeltaDataDeclaration start end name members)
          (let current
            (if (delta_names_equal source nameValue name)
              (delta_census_duplicate start)
              NoDeltaCensusCandidate)
            (delta_census_min current
              (delta_census_owner_name_against source nameValue rest))))
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          (delta_census_owner_name_against source nameValue rest))))))

(def delta_census_owner_against ((source Bytes)
  (declarationValue DeltaDeclaration)
  (rest DeltaDeclarationList)) DeltaCensusCandidate
  (match declarationValue
    ((DeltaBoundaryDeclaration start end name machines)
      (delta_census_owner_name_against source name rest))
    ((DeltaDataDeclaration start end name members)
      (delta_census_owner_name_against source name rest))
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
      NoDeltaCensusCandidate)))

(def delta_census_machine_name_against ((source Bytes)
  (nameValue DeltaQualifiedName)
  (declarations DeltaDeclarationList)) DeltaCensusCandidate
  (match declarations
    (NoDeltaDeclarations NoDeltaCensusCandidate)
    ((MoreDeltaDeclarations item rest)
      (match item
        ((DeltaBoundaryDeclaration start end name machines)
          (delta_census_machine_name_against source nameValue rest))
        ((DeltaDataDeclaration start end name members)
          (delta_census_machine_name_against source nameValue rest))
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          (let current
            (if (delta_qualified_names_equal source nameValue name)
              (delta_census_duplicate start)
              NoDeltaCensusCandidate)
            (delta_census_min current
              (delta_census_machine_name_against source nameValue rest))))))))

(def delta_census_machine_against ((source Bytes)
  (declarationValue DeltaDeclaration)
  (rest DeltaDeclarationList)) DeltaCensusCandidate
  (match declarationValue
    ((DeltaBoundaryDeclaration start end name machines)
      NoDeltaCensusCandidate)
    ((DeltaDataDeclaration start end name members)
      NoDeltaCensusCandidate)
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
      (delta_census_machine_name_against source name rest))))

(def delta_census_invalid_boundary ((source Bytes)
  (declarationValue DeltaDeclaration)
  (owners DeltaOwnerRowList)) DeltaCensusCandidate
  (match declarationValue
    ((DeltaBoundaryDeclaration start end name machines)
      NoDeltaCensusCandidate)
    ((DeltaDataDeclaration start end name members)
      NoDeltaCensusCandidate)
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
      (match name
        ((DeltaUnqualifiedName nameStart nameEnd machineName)
          NoDeltaCensusCandidate)
        ((DeltaQualifiedNameSyntax nameStart nameEnd owner machineName)
          (match (delta_owner_identity_for_rows source owner owners)
            (NoDeltaOwnerIdentity NoDeltaCensusCandidate)
            (OneDeltaBoundaryOwner
              (DeltaCensusCandidateAt InvalidBoundary start))
            (OneDeltaDataOwner NoDeltaCensusCandidate)
            (AmbiguousDeltaOwnerIdentity NoDeltaCensusCandidate)))))))

(def delta_census_declaration_contents ((source Bytes)
  (declarationValue DeltaDeclaration)) DeltaCensusCandidate
  (match declarationValue
    ((DeltaBoundaryDeclaration start end name machines)
      (delta_census_min
        (delta_census_boundary_machine_duplicates source machines)
        (delta_census_boundary_machine_parameters source machines)))
    ((DeltaDataDeclaration start end name members)
      (delta_census_min
        (delta_census_data_member_duplicates source members)
        (delta_census_data_payload_parameters source members)))
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
      (delta_census_machine_scope source inputs bodyValue))))

(def delta_census_declarations ((source Bytes)
  (declarations DeltaDeclarationList)
  (owners DeltaOwnerRowList)) DeltaCensusCandidate
  (match declarations
    (NoDeltaDeclarations NoDeltaCensusCandidate)
    ((MoreDeltaDeclarations item rest)
      (delta_census_min
        (delta_census_owner_against source item rest)
        (delta_census_min
          (delta_census_machine_against source item rest)
          (delta_census_min
            (delta_census_invalid_boundary source item owners)
            (delta_census_min
              (delta_census_declaration_contents source item)
              (delta_census_declarations source rest owners))))))))

(def delta_collect_program_identities ((source Bytes)
  (program DeltaProgram)) DeltaCensusOutcome
  (match program
    ((DeltaSyntaxProgram start end declarations)
      ; Owner rows are complete before any authored qualified body is
      ; classified. Duplicate owners of either kind therefore yield Ambiguous,
      ; never a first-row boundary decision.
      (let owners (delta_collect_owner_rows_acc declarations NoDeltaOwnerRows)
        (let machines
          (delta_collect_machine_rows_acc declarations NoDeltaMachineRows)
          (let candidate
            (delta_census_min
              (delta_census_declarations source declarations owners)
              (delta_census_callable_collisions source declarations owners
                machines))
            (match candidate
              (NoDeltaCensusCandidate
                (DeltaCensusAccepted
                  (DeltaCollectedProgramSyntax program owners machines)))
              ((DeltaCensusCandidateAt reasonValue errorOffset)
                (DeltaCensusRejected reasonValue errorOffset)))))))))

(def delta_parse_and_collect_program ((source Bytes)) DeltaCensusOutcome
  (match (delta_parse_program_syntax source)
    ((DeltaProgramParseRejected reasonValue errorOffset)
      (DeltaCensusRejected reasonValue errorOffset))
    ((DeltaProgramParsed program)
      (delta_collect_program_identities source program))))

; ---- D31 structural type formation ---------------------------------------

(def delta_type_formation_candidate_min_present ((leftKind Int)
  (leftReason DeltaRejectReason) (leftOffset Int)
  (right DeltaTypeFormationCandidate)) DeltaTypeFormationCandidate
  (match right
    (NoDeltaTypeFormationCandidate
      (DeltaTypeFormationCandidateAt leftKind leftReason leftOffset))
    ((DeltaTypeFormationCandidateAt rightKind rightReason rightOffset)
      (if (lt rightOffset leftOffset)
        right
        (if (lt leftOffset rightOffset)
          (DeltaTypeFormationCandidateAt leftKind leftReason leftOffset)
          (if (eq leftKind rightKind)
            (DeltaTypeFormationCandidateAt leftKind leftReason leftOffset)
            (DeltaTypeFormationConflict leftOffset)))))
    ((DeltaTypeFormationConflict rightOffset) right)))

(def delta_type_formation_candidate_min ((left DeltaTypeFormationCandidate)
  (right DeltaTypeFormationCandidate)) DeltaTypeFormationCandidate
  (match left
    (NoDeltaTypeFormationCandidate right)
    ((DeltaTypeFormationCandidateAt leftKind leftReason leftOffset)
      (delta_type_formation_candidate_min_present leftKind leftReason
        leftOffset right))
    ((DeltaTypeFormationConflict leftOffset) left)))

(def delta_owner_name_exists ((source Bytes) (nameValue DeltaName)
  (owners DeltaOwnerRowList)) Int
  (match owners
    (NoDeltaOwnerRows 0)
    ((MoreDeltaOwnerRows item rest)
      (match item
        ((DeltaOwnerRowSyntax declarationStart rowName kind)
          (if (delta_names_equal source nameValue rowName)
            1
            (delta_owner_name_exists source nameValue rest)))))))

(def delta_name_is_main ((source Bytes) (nameValue DeltaName)) Int
  (match nameValue
    ((DeltaNameSpan start end)
      (delta_span_is_4 source start end 77 97 105 110))))

(def delta_name_is_console_field ((source Bytes)
  (nameValue DeltaName)) Int
  (match nameValue
    ((DeltaNameSpan start end)
      (delta_span_is_7 source start end 99 111 110 115 111 108 101))))

(def delta_name_is_console_type ((source Bytes)
  (nameValue DeltaName)) Int
  (match nameValue
    ((DeltaNameSpan start end)
      (delta_span_is_7 source start end 67 111 110 115 111 108 101))))

(def delta_is_main_console_field ((source Bytes) (owner DeltaName)
  (field DeltaName)) Int
  (if (delta_name_is_main source owner)
    (delta_name_is_console_field source field)
    0))

(def delta_never_placement_candidate ((start Int)
  (placement DeltaTypePlacement)) DeltaTypeFormationCandidate
  (match placement
    (DeltaStoredTypePlacement
      (DeltaTypeFormationCandidateAt 6 TypeMismatch start))
    (DeltaParameterTypePlacement
      (DeltaTypeFormationCandidateAt 6 TypeMismatch start))
    (DeltaLocalTypePlacement
      (DeltaTypeFormationCandidateAt 6 TypeMismatch start))
    (DeltaReturnTypePlacement NoDeltaTypeFormationCandidate)
    (DeltaMainConsoleTypePlacement
      (DeltaTypeFormationCandidateAt 6 TypeMismatch start))
    (DeltaNestedTypePlacement
      (DeltaTypeFormationCandidateAt 6 TypeMismatch start))))

; `u8` is a storage element rather than an ordinary standalone value type.
; Stored fields and nested array/view elements admit it; authored scalar
; parameters, locals, and returns do not. Arrays containing `u8` remain valid
; in value positions because their element is checked at nested placement.
(def delta_u8_placement_candidate ((start Int)
  (placement DeltaTypePlacement)) DeltaTypeFormationCandidate
  (match placement
    (DeltaStoredTypePlacement NoDeltaTypeFormationCandidate)
    (DeltaParameterTypePlacement
      (DeltaTypeFormationCandidateAt 6 TypeMismatch start))
    (DeltaLocalTypePlacement
      (DeltaTypeFormationCandidateAt 6 TypeMismatch start))
    (DeltaReturnTypePlacement
      (DeltaTypeFormationCandidateAt 6 TypeMismatch start))
    ; This placement is structurally stored. The later entry-shape judgment
    ; owns a `Main.console` field whose type is not the sealed capability.
    (DeltaMainConsoleTypePlacement NoDeltaTypeFormationCandidate)
    (DeltaNestedTypePlacement NoDeltaTypeFormationCandidate)))

(def delta_named_type_formation_candidate ((source Bytes) (start Int)
  (nameValue DeltaName) (owners DeltaOwnerRowList)
  (placement DeltaTypePlacement)) DeltaTypeFormationCandidate
  (if (delta_name_is_console_type source nameValue)
    (match placement
      (DeltaStoredTypePlacement
        (DeltaTypeFormationCandidateAt 5 InvalidEntry start))
      (DeltaParameterTypePlacement
        (DeltaTypeFormationCandidateAt 5 InvalidEntry start))
      (DeltaLocalTypePlacement
        (DeltaTypeFormationCandidateAt 5 InvalidEntry start))
      (DeltaReturnTypePlacement
        (DeltaTypeFormationCandidateAt 5 InvalidEntry start))
      (DeltaMainConsoleTypePlacement NoDeltaTypeFormationCandidate)
      (DeltaNestedTypePlacement
        (DeltaTypeFormationCandidateAt 5 InvalidEntry start)))
    (if (delta_owner_name_exists source nameValue owners)
      NoDeltaTypeFormationCandidate
      (DeltaTypeFormationCandidateAt 1 UnknownType start))))

(def delta_array_length_candidate ((literal DeltaIntegerLiteral))
  DeltaTypeFormationCandidate
  (match literal
    ((DeltaIntegerSpan start end value)
      (if (eq value 0)
        (DeltaTypeFormationCandidateAt 4 InvalidArrayLength start)
        NoDeltaTypeFormationCandidate))))

(def delta_validate_formed_type ((source Bytes) (typeValue DeltaType)
  (owners DeltaOwnerRowList) (placement DeltaTypePlacement))
  DeltaTypeFormationCandidate
  (match typeValue
    ((DeltaI32Type start end) NoDeltaTypeFormationCandidate)
    ((DeltaU8Type start end)
      (delta_u8_placement_candidate start placement))
    ((DeltaNeverType start end)
      (delta_never_placement_candidate start placement))
    ((DeltaNamedType start end name)
      (delta_named_type_formation_candidate source start name owners
        placement))
    ((DeltaArrayType start end elementType lengthValue)
      (delta_type_formation_candidate_min
        (delta_validate_formed_type source elementType owners
          DeltaNestedTypePlacement)
        (delta_array_length_candidate lengthValue)))
    ((DeltaViewType start end elementType)
      (match placement
        (DeltaStoredTypePlacement
          (DeltaTypeFormationCandidateAt 7 EscapingView start))
        (DeltaParameterTypePlacement
          (delta_validate_formed_type source elementType owners
            DeltaNestedTypePlacement))
        (DeltaLocalTypePlacement
          (delta_validate_formed_type source elementType owners
            DeltaNestedTypePlacement))
        (DeltaReturnTypePlacement
          (DeltaTypeFormationCandidateAt 7 EscapingView start))
        (DeltaMainConsoleTypePlacement
          (DeltaTypeFormationCandidateAt 7 EscapingView start))
        (DeltaNestedTypePlacement
          (DeltaTypeFormationCandidateAt 7 EscapingView start))))))

(def delta_validate_optional_formed_type ((source Bytes)
  (typeValue DeltaOptionalType) (owners DeltaOwnerRowList)
  (placement DeltaTypePlacement)) DeltaTypeFormationCandidate
  (match typeValue
    (NoDeltaType NoDeltaTypeFormationCandidate)
    ((SomeDeltaType start end item)
      (delta_validate_formed_type source item owners placement))))

(def delta_validate_parameter_formed_types ((source Bytes)
  (parameters DeltaParameterList) (owners DeltaOwnerRowList)
  (placement DeltaTypePlacement)) DeltaTypeFormationCandidate
  (match parameters
    (NoDeltaParameters NoDeltaTypeFormationCandidate)
    ((MoreDeltaParameters item rest)
      (match item
        ((DeltaParameterSyntax start end name typeValue)
          (delta_type_formation_candidate_min
            (delta_validate_formed_type source typeValue owners placement)
            (delta_validate_parameter_formed_types source rest owners
              placement)))))))

(def delta_validate_payload_formed_types ((source Bytes)
  (payload DeltaOptionalPayload) (owners DeltaOwnerRowList))
  DeltaTypeFormationCandidate
  (match payload
    (NoDeltaPayload NoDeltaTypeFormationCandidate)
    ((SomeDeltaPayload start end parameters)
      (delta_validate_parameter_formed_types source parameters owners
        DeltaStoredTypePlacement))))

(def delta_validate_data_member_formed_types ((source Bytes)
  (owner DeltaName) (members DeltaDataMemberList)
  (owners DeltaOwnerRowList)) DeltaTypeFormationCandidate
  (match members
    (NoDeltaDataMembers NoDeltaTypeFormationCandidate)
    ((MoreDeltaDataMembers item rest)
      (let current
        (match item
          ((DeltaFieldMember start end name typeValue)
            (if (delta_is_main_console_field source owner name)
              (delta_validate_formed_type source typeValue owners
                DeltaMainConsoleTypePlacement)
              (delta_validate_formed_type source typeValue owners
                DeltaStoredTypePlacement)))
          ((DeltaCaseMember start end name payload)
            (delta_validate_payload_formed_types source payload owners)))
        (delta_type_formation_candidate_min current
          (delta_validate_data_member_formed_types source owner rest
            owners))))))

(def delta_validate_boundary_machine_formed_types ((source Bytes)
  (machines DeltaBoundaryMachineList) (owners DeltaOwnerRowList))
  DeltaTypeFormationCandidate
  (match machines
    (NoDeltaBoundaryMachines NoDeltaTypeFormationCandidate)
    ((MoreDeltaBoundaryMachines item rest)
      (match item
        ((DeltaBoundaryMachineSyntax start end name parameters returnType)
          (delta_type_formation_candidate_min
            (delta_validate_parameter_formed_types source parameters owners
              DeltaParameterTypePlacement)
            (delta_type_formation_candidate_min
              (delta_validate_optional_formed_type source returnType owners
                DeltaReturnTypePlacement)
              (delta_validate_boundary_machine_formed_types source rest
                owners))))))))

(def delta_validate_statement_formed_types ((source Bytes)
  (statements DeltaStatementList) (owners DeltaOwnerRowList))
  DeltaTypeFormationCandidate
  (match statements
    (NoDeltaStatements NoDeltaTypeFormationCandidate)
    ((MoreDeltaStatements item rest)
      (let current
        (match item
          ((DeltaLetStatement start end name typeValue expressionValue)
            (delta_validate_formed_type source typeValue owners
              DeltaLocalTypePlacement))
          ((DeltaAssignmentStatement start end placeValue expressionValue)
            NoDeltaTypeFormationCandidate)
          ((DeltaPostfixStatement start end expressionValue)
            NoDeltaTypeFormationCandidate)
          ((DeltaAssertStatement start end expressionValue)
            NoDeltaTypeFormationCandidate))
        (delta_type_formation_candidate_min current
          (delta_validate_statement_formed_types source rest owners))))))

(def delta_validate_state_body_formed_types ((source Bytes)
  (bodyValue DeltaStateBody) (owners DeltaOwnerRowList))
  DeltaTypeFormationCandidate
  (match bodyValue
    ((DeltaStateBodySyntax start end statements terminalValue)
      (delta_validate_statement_formed_types source statements owners))))

(def delta_validate_state_formed_types ((source Bytes)
  (states DeltaStateList) (owners DeltaOwnerRowList))
  DeltaTypeFormationCandidate
  (match states
    (NoDeltaStates NoDeltaTypeFormationCandidate)
    ((MoreDeltaStates item rest)
      (match item
        ((DeltaStateSyntax start end name parameters bodyValue)
          (delta_type_formation_candidate_min
            (delta_validate_parameter_formed_types source parameters owners
              DeltaParameterTypePlacement)
            (delta_type_formation_candidate_min
              (delta_validate_state_body_formed_types source bodyValue owners)
              (delta_validate_state_formed_types source rest owners))))))))

(def delta_validate_machine_body_formed_types ((source Bytes)
  (bodyValue DeltaMachineBody) (owners DeltaOwnerRowList))
  DeltaTypeFormationCandidate
  (match bodyValue
    ((DeltaMachineBodySyntax start end statements terminalValue states)
      (delta_type_formation_candidate_min
        (delta_validate_statement_formed_types source statements owners)
        (delta_validate_state_formed_types source states owners)))))

(def delta_validate_machine_input_formed_types ((source Bytes)
  (inputs DeltaMachineInputs) (owners DeltaOwnerRowList))
  DeltaTypeFormationCandidate
  (match inputs
    ((NoDeltaMachineInputs start end) NoDeltaTypeFormationCandidate)
    ((DeltaPlainMachineInputs start end parameters)
      (delta_validate_parameter_formed_types source parameters owners
        DeltaParameterTypePlacement))
    ((DeltaReceiverMachineInputs start end receiverStart receiverEnd parameters)
      (delta_validate_parameter_formed_types source parameters owners
        DeltaParameterTypePlacement))))

(def delta_validate_declaration_formed_types ((source Bytes)
  (declarations DeltaDeclarationList) (owners DeltaOwnerRowList))
  DeltaTypeFormationCandidate
  (match declarations
    (NoDeltaDeclarations NoDeltaTypeFormationCandidate)
    ((MoreDeltaDeclarations item rest)
      (let current
        (match item
          ((DeltaBoundaryDeclaration start end name machines)
            (delta_validate_boundary_machine_formed_types source machines
              owners))
          ((DeltaDataDeclaration start end name members)
            (delta_validate_data_member_formed_types source name members
              owners))
          ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
            (delta_type_formation_candidate_min
              (delta_validate_machine_input_formed_types source inputs owners)
              (delta_type_formation_candidate_min
                (delta_validate_optional_formed_type source returnType owners
                  DeltaReturnTypePlacement)
                (delta_validate_machine_body_formed_types source bodyValue
                  owners)))))
        (delta_type_formation_candidate_min current
          (delta_validate_declaration_formed_types source rest owners))))))

(def delta_data_members_have_field ((members DeltaDataMemberList)) Int
  (match members
    (NoDeltaDataMembers 0)
    ((MoreDeltaDataMembers item rest)
      (match item
        ((DeltaFieldMember start end name typeValue) 1)
        ((DeltaCaseMember start end name payload)
          (delta_data_members_have_field rest))))))

(def delta_data_members_have_case ((members DeltaDataMemberList)) Int
  (match members
    (NoDeltaDataMembers 0)
    ((MoreDeltaDataMembers item rest)
      (match item
        ((DeltaFieldMember start end name typeValue)
          (delta_data_members_have_case rest))
        ((DeltaCaseMember start end name payload) 1)))))

(def delta_data_shape_candidate ((nameValue DeltaName)
  (members DeltaDataMemberList)) DeltaTypeFormationCandidate
  (if (delta_data_members_have_field members)
    (if (delta_data_members_have_case members)
      (DeltaTypeFormationCandidateAt 3 InvalidDataShape
        (delta_name_start nameValue))
      NoDeltaTypeFormationCandidate)
    NoDeltaTypeFormationCandidate))

(def delta_validate_data_shapes ((declarations DeltaDeclarationList))
  DeltaTypeFormationCandidate
  (match declarations
    (NoDeltaDeclarations NoDeltaTypeFormationCandidate)
    ((MoreDeltaDeclarations item rest)
      (let current
        (match item
          ((DeltaBoundaryDeclaration start end name machines)
            NoDeltaTypeFormationCandidate)
          ((DeltaDataDeclaration start end name members)
            (delta_data_shape_candidate name members))
          ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
            NoDeltaTypeFormationCandidate))
        (delta_type_formation_candidate_min current
          (delta_validate_data_shapes rest))))))

(def delta_data_shape_kind ((members DeltaDataMemberList)) DeltaDataShapeKind
  (if (delta_data_members_have_case members)
    DeltaSumShape
    DeltaRecordShape))

(def delta_reverse_data_shape_rows ((input DeltaDataShapeRowList)
  (output DeltaDataShapeRowList)) DeltaDataShapeRowList
  (match input
    (NoDeltaDataShapeRows output)
    ((MoreDeltaDataShapeRows item rest)
      (delta_reverse_data_shape_rows rest
        (MoreDeltaDataShapeRows item output)))))

(def delta_collect_data_shape_rows_acc ((declarations DeltaDeclarationList)
  (accumulator DeltaDataShapeRowList)) DeltaDataShapeRowList
  (match declarations
    (NoDeltaDeclarations
      (delta_reverse_data_shape_rows accumulator NoDeltaDataShapeRows))
    ((MoreDeltaDeclarations item rest)
      (match item
        ((DeltaBoundaryDeclaration start end name machines)
          (delta_collect_data_shape_rows_acc rest accumulator))
        ((DeltaDataDeclaration start end name members)
          (delta_collect_data_shape_rows_acc rest
            (MoreDeltaDataShapeRows
              (DeltaDataShapeRowSyntax start name
                (delta_data_shape_kind members))
              accumulator)))
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          (delta_collect_data_shape_rows_acc rest accumulator))))))

; Only value-owning data edges participate in recursion.  A forbidden view in
; stored data suppresses its child defects in the placement pass and likewise
; contributes no by-value graph edge here.  The complete immutable edge list
; is retained for later layout; cycle classification performs one visited-set
; graph walk per edge, avoiding path-exponential expansion through diamonds.
(def delta_name_is_data_owner ((source Bytes) (target DeltaName)
  (declarations DeltaDeclarationList)) Int
  (match declarations
    (NoDeltaDeclarations 0)
    ((MoreDeltaDeclarations item rest)
      (match item
        ((DeltaBoundaryDeclaration start end name machines)
          (delta_name_is_data_owner source target rest))
        ((DeltaDataDeclaration start end name members)
          (if (delta_names_equal source target name)
            1
            (delta_name_is_data_owner source target rest)))
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          (delta_name_is_data_owner source target rest))))))

(def delta_collect_type_value_edges ((source Bytes) (ownerStart Int)
  (owner DeltaName) (typeValue DeltaType)
  (declarations DeltaDeclarationList) (accumulator DeltaValueEdgeList))
  DeltaValueEdgeList
  (match typeValue
    ((DeltaI32Type start end) accumulator)
    ((DeltaU8Type start end) accumulator)
    ((DeltaNeverType start end) accumulator)
    ((DeltaNamedType start end name)
      (if (delta_name_is_console_type source name)
        accumulator
        (if (delta_name_is_data_owner source name declarations)
          (MoreDeltaValueEdges
            (DeltaValueEdgeSyntax ownerStart owner name start) accumulator)
          accumulator)))
    ((DeltaArrayType start end elementType lengthValue)
      (delta_collect_type_value_edges source ownerStart owner elementType
        declarations accumulator))
    ((DeltaViewType start end elementType) accumulator)))

(def delta_collect_parameter_value_edges ((source Bytes) (ownerStart Int)
  (owner DeltaName) (parameters DeltaParameterList)
  (declarations DeltaDeclarationList) (accumulator DeltaValueEdgeList))
  DeltaValueEdgeList
  (match parameters
    (NoDeltaParameters accumulator)
    ((MoreDeltaParameters item rest)
      (match item
        ((DeltaParameterSyntax start end name typeValue)
          (delta_collect_parameter_value_edges source ownerStart owner rest
            declarations
            (delta_collect_type_value_edges source ownerStart owner typeValue
              declarations accumulator)))))))

(def delta_collect_payload_value_edges ((source Bytes) (ownerStart Int)
  (owner DeltaName) (payload DeltaOptionalPayload)
  (declarations DeltaDeclarationList) (accumulator DeltaValueEdgeList))
  DeltaValueEdgeList
  (match payload
    (NoDeltaPayload accumulator)
    ((SomeDeltaPayload start end parameters)
      (delta_collect_parameter_value_edges source ownerStart owner parameters
        declarations accumulator))))

(def delta_collect_member_value_edges ((source Bytes) (ownerStart Int)
  (owner DeltaName) (members DeltaDataMemberList)
  (declarations DeltaDeclarationList) (accumulator DeltaValueEdgeList))
  DeltaValueEdgeList
  (match members
    (NoDeltaDataMembers accumulator)
    ((MoreDeltaDataMembers item rest)
      (let next
        (match item
          ((DeltaFieldMember start end name typeValue)
            (delta_collect_type_value_edges source ownerStart owner typeValue
              declarations accumulator))
          ((DeltaCaseMember start end name payload)
            (delta_collect_payload_value_edges source ownerStart owner payload
              declarations accumulator)))
        (delta_collect_member_value_edges source ownerStart owner rest
          declarations next)))))

(def delta_reverse_value_edges ((input DeltaValueEdgeList)
  (output DeltaValueEdgeList)) DeltaValueEdgeList
  (match input
    (NoDeltaValueEdges output)
    ((MoreDeltaValueEdges item rest)
      (delta_reverse_value_edges rest (MoreDeltaValueEdges item output)))))

(def delta_collect_value_edges_acc ((source Bytes)
  (declarations DeltaDeclarationList)
  (allDeclarations DeltaDeclarationList)
  (accumulator DeltaValueEdgeList)) DeltaValueEdgeList
  (match declarations
    (NoDeltaDeclarations
      (delta_reverse_value_edges accumulator NoDeltaValueEdges))
    ((MoreDeltaDeclarations item rest)
      (match item
        ((DeltaBoundaryDeclaration start end name machines)
          (delta_collect_value_edges_acc source rest allDeclarations
            accumulator))
        ((DeltaDataDeclaration start end name members)
          (delta_collect_value_edges_acc source rest allDeclarations
            (delta_collect_member_value_edges source start name members
              allDeclarations accumulator)))
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          (delta_collect_value_edges_acc source rest allDeclarations
            accumulator))))))

(def delta_value_graph_scan_edges ((source Bytes) (current DeltaName)
  (goal DeltaName) (search DeltaValueEdgeList) (allEdges DeltaValueEdgeList)
  (visited DeltaNameList)) DeltaReachabilityScan
  (match search
    (NoDeltaValueEdges (DeltaReachabilityScanResult 0 visited))
    ((MoreDeltaValueEdges item rest)
      (match item
        ((DeltaValueEdgeSyntax ownerStart edgeSource edgeTarget typeOffset)
          (if (delta_names_equal source current edgeSource)
            (match (delta_value_graph_reaches source edgeTarget goal allEdges
              visited)
              ((DeltaReachabilityScanResult reached nextVisited)
                (if reached
                  (DeltaReachabilityScanResult 1 nextVisited)
                  (delta_value_graph_scan_edges source current goal rest
                    allEdges nextVisited))))
            (delta_value_graph_scan_edges source current goal rest allEdges
              visited)))))))

(def delta_value_graph_reaches ((source Bytes) (current DeltaName)
  (goal DeltaName) (edges DeltaValueEdgeList) (visited DeltaNameList))
  DeltaReachabilityScan
  (if (delta_names_equal source current goal)
    (DeltaReachabilityScanResult 1 visited)
    (if (delta_census_name_in_list source current visited)
      (DeltaReachabilityScanResult 0 visited)
      (delta_value_graph_scan_edges source current goal edges edges
        (MoreDeltaNames current visited)))))

(def delta_recursive_edge_candidate ((source Bytes) (edge DeltaValueEdge)
  (edges DeltaValueEdgeList)) DeltaTypeFormationCandidate
  (match edge
    ((DeltaValueEdgeSyntax ownerStart edgeSource edgeTarget typeOffset)
      (match (delta_value_graph_reaches source edgeTarget edgeSource edges
        NoDeltaNames)
        ((DeltaReachabilityScanResult reached visited)
          (if reached
            (DeltaTypeFormationCandidateAt 2 RecursiveValueType typeOffset)
            NoDeltaTypeFormationCandidate))))))

(def delta_validate_recursive_edges ((source Bytes)
  (search DeltaValueEdgeList) (allEdges DeltaValueEdgeList))
  DeltaTypeFormationCandidate
  (match search
    (NoDeltaValueEdges NoDeltaTypeFormationCandidate)
    ((MoreDeltaValueEdges item rest)
      (delta_type_formation_candidate_min
        (delta_recursive_edge_candidate source item allEdges)
        (delta_validate_recursive_edges source rest allEdges)))))

(def delta_form_collected_types ((source Bytes)
  (collected DeltaCollectedProgram)) DeltaTypeFormationOutcome
  (match collected
    ((DeltaCollectedProgramSyntax program owners machines)
      (match program
        ((DeltaSyntaxProgram start end declarations)
          (let valueEdges
            (delta_collect_value_edges_acc source declarations declarations
              NoDeltaValueEdges)
            (let candidate
              (delta_type_formation_candidate_min
                (delta_validate_data_shapes declarations)
                (delta_type_formation_candidate_min
                  (delta_validate_declaration_formed_types source declarations
                    owners)
                  (delta_validate_recursive_edges source valueEdges
                    valueEdges)))
              (match candidate
                (NoDeltaTypeFormationCandidate
                  (DeltaTypeFormationAccepted
                    (DeltaFormedProgramSyntax collected
                      (delta_collect_data_shape_rows_acc declarations
                        NoDeltaDataShapeRows)
                      valueEdges)))
                ((DeltaTypeFormationCandidateAt kind reasonValue errorOffset)
                  (DeltaTypeFormationRejected reasonValue errorOffset))
                ((DeltaTypeFormationConflict errorOffset)
                  (DeltaTypeFormationInternal errorOffset))))))))))

(def delta_parse_collect_and_form_types ((source Bytes))
  DeltaTypeFormationOutcome
  (match (delta_parse_and_collect_program source)
    ((DeltaCensusRejected reasonValue errorOffset)
      (DeltaTypeFormationRejected reasonValue errorOffset))
    ((DeltaCensusAccepted collected)
      (delta_form_collected_types source collected))))

; ---- body-resolution catalog foundation ----------------------------------

(def delta_integer_literal_value ((literal DeltaIntegerLiteral)) Int
  (match literal
    ((DeltaIntegerSpan start end value) value)))

(def delta_types_equal ((source Bytes) (left DeltaType)
  (right DeltaType)) Int
  (match left
    ((DeltaI32Type leftStart leftEnd)
      (match right
        ((DeltaI32Type rightStart rightEnd) 1)
        ((DeltaU8Type rightStart rightEnd) 0)
        ((DeltaNeverType rightStart rightEnd) 0)
        ((DeltaNamedType rightStart rightEnd rightName) 0)
        ((DeltaArrayType rightStart rightEnd rightElement rightLength) 0)
        ((DeltaViewType rightStart rightEnd rightElement) 0)))
    ((DeltaU8Type leftStart leftEnd)
      (match right
        ((DeltaI32Type rightStart rightEnd) 0)
        ((DeltaU8Type rightStart rightEnd) 1)
        ((DeltaNeverType rightStart rightEnd) 0)
        ((DeltaNamedType rightStart rightEnd rightName) 0)
        ((DeltaArrayType rightStart rightEnd rightElement rightLength) 0)
        ((DeltaViewType rightStart rightEnd rightElement) 0)))
    ((DeltaNeverType leftStart leftEnd)
      (match right
        ((DeltaI32Type rightStart rightEnd) 0)
        ((DeltaU8Type rightStart rightEnd) 0)
        ((DeltaNeverType rightStart rightEnd) 1)
        ((DeltaNamedType rightStart rightEnd rightName) 0)
        ((DeltaArrayType rightStart rightEnd rightElement rightLength) 0)
        ((DeltaViewType rightStart rightEnd rightElement) 0)))
    ((DeltaNamedType leftStart leftEnd leftName)
      (match right
        ((DeltaI32Type rightStart rightEnd) 0)
        ((DeltaU8Type rightStart rightEnd) 0)
        ((DeltaNeverType rightStart rightEnd) 0)
        ((DeltaNamedType rightStart rightEnd rightName)
          (delta_names_equal source leftName rightName))
        ((DeltaArrayType rightStart rightEnd rightElement rightLength) 0)
        ((DeltaViewType rightStart rightEnd rightElement) 0)))
    ((DeltaArrayType leftStart leftEnd leftElement leftLength)
      (match right
        ((DeltaI32Type rightStart rightEnd) 0)
        ((DeltaU8Type rightStart rightEnd) 0)
        ((DeltaNeverType rightStart rightEnd) 0)
        ((DeltaNamedType rightStart rightEnd rightName) 0)
        ((DeltaArrayType rightStart rightEnd rightElement rightLength)
          (if (eq (delta_integer_literal_value leftLength)
                  (delta_integer_literal_value rightLength))
            (delta_types_equal source leftElement rightElement)
            0))
        ((DeltaViewType rightStart rightEnd rightElement) 0)))
    ((DeltaViewType leftStart leftEnd leftElement)
      (match right
        ((DeltaI32Type rightStart rightEnd) 0)
        ((DeltaU8Type rightStart rightEnd) 0)
        ((DeltaNeverType rightStart rightEnd) 0)
        ((DeltaNamedType rightStart rightEnd rightName) 0)
        ((DeltaArrayType rightStart rightEnd rightElement rightLength) 0)
        ((DeltaViewType rightStart rightEnd rightElement)
          (delta_types_equal source leftElement rightElement))))))

(def delta_optional_types_equal ((source Bytes) (left DeltaOptionalType)
  (right DeltaOptionalType)) Int
  (match left
    (NoDeltaType
      (match right
        (NoDeltaType 1)
        ((SomeDeltaType rightStart rightEnd rightType) 0)))
    ((SomeDeltaType leftStart leftEnd leftType)
      (match right
        (NoDeltaType 0)
        ((SomeDeltaType rightStart rightEnd rightType)
          (delta_types_equal source leftType rightType))))))

(def delta_parameter_types_equal ((source Bytes)
  (left DeltaParameterList) (right DeltaParameterList)) Int
  (match left
    (NoDeltaParameters
      (match right
        (NoDeltaParameters 1)
        ((MoreDeltaParameters rightItem rightRest) 0)))
    ((MoreDeltaParameters leftItem leftRest)
      (match right
        (NoDeltaParameters 0)
        ((MoreDeltaParameters rightItem rightRest)
          (match leftItem
            ((DeltaParameterSyntax leftStart leftEnd leftName leftType)
              (match rightItem
                ((DeltaParameterSyntax rightStart rightEnd rightName rightType)
                  (if (delta_types_equal source leftType rightType)
                    (delta_parameter_types_equal source leftRest rightRest)
                    0))))))))))

(def delta_reject_reason_identity ((reasonValue DeltaRejectReason)) Int
  (match reasonValue
    (InvalidSourceByte 1)
    (InvalidToken 2)
    (InvalidCharacterLiteral 3)
    (UnterminatedString 4)
    (InvalidEscape 5)
    (IntegerLiteralOutOfRange 6)
    (UnexpectedToken 7)
    (UnexpectedEnd 8)
    (DuplicateName 9)
    (MissingEntry 10)
    (InvalidEntry 11)
    (InvalidBoundary 12)
    (UnknownType 13)
    (RecursiveValueType 14)
    (InvalidDataShape 15)
    (InvalidArrayLength 16)
    (UnknownName 17)
    (TypeMismatch 18)
    (ArityMismatch 19)
    (InvalidPlace 20)
    (UseBeforeInitialization 21)
    (EscapingView 22)
    (InvalidControlTarget 23)
    (InvalidTerminal 24)
    (DuplicatePattern 25)
    (NonexhaustiveSum 26)))

(def delta_reject_reasons_equal ((left DeltaRejectReason)
  (right DeltaRejectReason)) Int
  (eq (delta_reject_reason_identity left)
    (delta_reject_reason_identity right)))

(def delta_final_reason_list_contains ((target DeltaRejectReason)
  (reasons DeltaFinalReasonList)) Int
  (match reasons
    (NoDeltaFinalReasons 0)
    ((MoreDeltaFinalReasons item rest)
      (if (delta_reject_reasons_equal target item)
        1
        (delta_final_reason_list_contains target rest)))))

(def delta_final_reason_list_add ((reasonValue DeltaRejectReason)
  (reasons DeltaFinalReasonList)) DeltaFinalReasonList
  (if (delta_final_reason_list_contains reasonValue reasons)
    reasons
    (MoreDeltaFinalReasons reasonValue reasons)))

(def delta_final_reason_lists_union ((input DeltaFinalReasonList)
  (output DeltaFinalReasonList)) DeltaFinalReasonList
  (match input
    (NoDeltaFinalReasons output)
    ((MoreDeltaFinalReasons reasonValue rest)
      (delta_final_reason_lists_union rest
        (delta_final_reason_list_add reasonValue output)))))

(def delta_final_candidate_add ((reasonValue DeltaRejectReason)
  (offset Int) (current DeltaFinalCandidate)) DeltaFinalCandidate
  (match current
    (NoDeltaFinalCandidate
      (DeltaFinalCandidateAt offset
        (MoreDeltaFinalReasons reasonValue NoDeltaFinalReasons)))
    ((DeltaFinalCandidateAt currentOffset reasons)
      (if (lt offset currentOffset)
        (DeltaFinalCandidateAt offset
          (MoreDeltaFinalReasons reasonValue NoDeltaFinalReasons))
        (if (lt currentOffset offset)
          current
          (DeltaFinalCandidateAt offset
            (delta_final_reason_list_add reasonValue reasons)))))))

(def delta_final_candidate_merge ((left DeltaFinalCandidate)
  (right DeltaFinalCandidate)) DeltaFinalCandidate
  (match left
    (NoDeltaFinalCandidate right)
    ((DeltaFinalCandidateAt leftOffset leftReasons)
      (match right
        (NoDeltaFinalCandidate left)
        ((DeltaFinalCandidateAt rightOffset rightReasons)
          (if (lt leftOffset rightOffset)
            left
            (if (lt rightOffset leftOffset)
              right
              (DeltaFinalCandidateAt leftOffset
                (delta_final_reason_lists_union leftReasons
                  rightReasons)))))))))

(def delta_find_data_declaration ((source Bytes) (owner DeltaName)
  (declarations DeltaDeclarationList)) DeltaDataDeclarationLookup
  (match declarations
    (NoDeltaDeclarations NoDeltaDataDeclaration)
    ((MoreDeltaDeclarations item rest)
      (match item
        ((DeltaBoundaryDeclaration start end name machines)
          (delta_find_data_declaration source owner rest))
        ((DeltaDataDeclaration start end name members)
          (if (delta_names_equal source owner name)
            (OneDeltaDataDeclaration item)
            (delta_find_data_declaration source owner rest)))
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          (delta_find_data_declaration source owner rest))))))

(def delta_catalog_machine_owner ((source Bytes)
  (nameValue DeltaQualifiedName) (declarations DeltaDeclarationList))
  DeltaCatalogMachineOwner
  (match nameValue
    ((DeltaUnqualifiedName start end name)
      DeltaCatalogUnqualifiedMachine)
    ((DeltaQualifiedNameSyntax start end owner name)
      (match (delta_find_data_declaration source owner declarations)
        (NoDeltaDataDeclaration (DeltaCatalogUnknownMachineOwner owner))
        ((OneDeltaDataDeclaration declarationValue)
          (DeltaCatalogDataMachineOwner declarationValue))))))

(def delta_reverse_catalog_declarations
  ((input DeltaCatalogDeclarationList)
   (output DeltaCatalogDeclarationList)) DeltaCatalogDeclarationList
  (match input
    (NoDeltaCatalogDeclarations output)
    ((MoreDeltaCatalogDeclarations item rest)
      (delta_reverse_catalog_declarations rest
        (MoreDeltaCatalogDeclarations item output)))))

(def delta_catalog_declarations_acc ((source Bytes)
  (declarations DeltaDeclarationList)
  (allDeclarations DeltaDeclarationList)
  (accumulator DeltaCatalogDeclarationList)) DeltaCatalogDeclarationList
  (match declarations
    (NoDeltaDeclarations
      (delta_reverse_catalog_declarations accumulator
        NoDeltaCatalogDeclarations))
    ((MoreDeltaDeclarations item rest)
      (let row
        (match item
          ((DeltaBoundaryDeclaration start end name machines)
            (DeltaCatalogBoundaryDeclaration item))
          ((DeltaDataDeclaration start end name members)
            (DeltaCatalogDataDeclaration item
              (delta_data_shape_kind members)))
          ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
            (DeltaCatalogMachineDeclaration item
              (delta_catalog_machine_owner source name allDeclarations))))
        (delta_catalog_declarations_acc source rest allDeclarations
          (MoreDeltaCatalogDeclarations row accumulator))))))

(def delta_catalog_unknown_machine_owner_candidate
  ((rows DeltaCatalogDeclarationList)) DeltaFinalCandidate
  (match rows
    (NoDeltaCatalogDeclarations NoDeltaFinalCandidate)
    ((MoreDeltaCatalogDeclarations row rest)
      (let current
        (match row
          ((DeltaCatalogBoundaryDeclaration declarationValue)
            NoDeltaFinalCandidate)
          ((DeltaCatalogDataDeclaration declarationValue shape)
            NoDeltaFinalCandidate)
          ((DeltaCatalogMachineDeclaration declarationValue owner)
            (match owner
              (DeltaCatalogUnqualifiedMachine NoDeltaFinalCandidate)
              ((DeltaCatalogDataMachineOwner ownerDeclaration)
                NoDeltaFinalCandidate)
              ((DeltaCatalogUnknownMachineOwner unknownOwner)
                (delta_final_candidate_add UnknownName
                  (delta_name_start unknownOwner) NoDeltaFinalCandidate)))))
        (delta_final_candidate_merge current
          (delta_catalog_unknown_machine_owner_candidate rest))))))

(def delta_catalog_find_owner ((source Bytes) (target DeltaName)
  (rows DeltaCatalogDeclarationList)) DeltaCatalogOwnerLookup
  (match rows
    (NoDeltaCatalogDeclarations NoDeltaCatalogOwner)
    ((MoreDeltaCatalogDeclarations row rest)
      (match row
        ((DeltaCatalogBoundaryDeclaration declarationValue)
          (match declarationValue
            ((DeltaBoundaryDeclaration start end name machines)
              (if (delta_names_equal source target name)
                (OneDeltaCatalogBoundaryOwner declarationValue)
                (delta_catalog_find_owner source target rest)))
            ((DeltaDataDeclaration start end name members)
              (delta_catalog_find_owner source target rest))
            ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
              (delta_catalog_find_owner source target rest))))
        ((DeltaCatalogDataDeclaration declarationValue shape)
          (match declarationValue
            ((DeltaBoundaryDeclaration start end name machines)
              (delta_catalog_find_owner source target rest))
            ((DeltaDataDeclaration start end name members)
              (if (delta_names_equal source target name)
                (OneDeltaCatalogDataOwner declarationValue shape)
                (delta_catalog_find_owner source target rest)))
            ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
              (delta_catalog_find_owner source target rest))))
        ((DeltaCatalogMachineDeclaration declarationValue owner)
          (delta_catalog_find_owner source target rest))))))

(def delta_catalog_find_unqualified_machine ((source Bytes)
  (target DeltaName) (rows DeltaCatalogDeclarationList))
  DeltaCatalogMachineLookup
  (match rows
    (NoDeltaCatalogDeclarations NoDeltaCatalogMachine)
    ((MoreDeltaCatalogDeclarations row rest)
      (match row
        ((DeltaCatalogBoundaryDeclaration declarationValue)
          (delta_catalog_find_unqualified_machine source target rest))
        ((DeltaCatalogDataDeclaration declarationValue shape)
          (delta_catalog_find_unqualified_machine source target rest))
        ((DeltaCatalogMachineDeclaration declarationValue owner)
          (match declarationValue
            ((DeltaBoundaryDeclaration start end name machines)
              (delta_catalog_find_unqualified_machine source target rest))
            ((DeltaDataDeclaration start end name members)
              (delta_catalog_find_unqualified_machine source target rest))
            ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
              (match name
                ((DeltaUnqualifiedName nameStart nameEnd machineName)
                  (if (delta_names_equal source target machineName)
                    (OneDeltaCatalogMachine declarationValue)
                    (delta_catalog_find_unqualified_machine source target
                      rest)))
                ((DeltaQualifiedNameSyntax nameStart nameEnd machineOwner
                  machineName)
                  (delta_catalog_find_unqualified_machine source target
                    rest))))))))))

; Semantic qualified application lookup excludes unresolved owner spellings.
; D36 application identity requires the exact resolved data owner as custody,
; so there is one qualified-machine walk rather than a raw spelling-only twin.
(def delta_catalog_find_qualified_data_machine ((source Bytes)
  (targetOwner DeltaName) (targetName DeltaName)
  (rows DeltaCatalogDeclarationList)) DeltaCatalogDataMachineLookup
  (match rows
    (NoDeltaCatalogDeclarations NoDeltaCatalogDataMachine)
    ((MoreDeltaCatalogDeclarations row rest)
      (match row
        ((DeltaCatalogBoundaryDeclaration declarationValue)
          (delta_catalog_find_qualified_data_machine source targetOwner
            targetName rest))
        ((DeltaCatalogDataDeclaration declarationValue shape)
          (delta_catalog_find_qualified_data_machine source targetOwner
            targetName rest))
        ((DeltaCatalogMachineDeclaration declarationValue owner)
          (match owner
            (DeltaCatalogUnqualifiedMachine
              (delta_catalog_find_qualified_data_machine source targetOwner
                targetName rest))
            ((DeltaCatalogUnknownMachineOwner unknownOwner)
              (delta_catalog_find_qualified_data_machine source targetOwner
                targetName rest))
            ((DeltaCatalogDataMachineOwner ownerDeclaration)
              (match declarationValue
                ((DeltaBoundaryDeclaration start end name machines)
                  (delta_catalog_find_qualified_data_machine source targetOwner
                    targetName rest))
                ((DeltaDataDeclaration start end name members)
                  (delta_catalog_find_qualified_data_machine source targetOwner
                    targetName rest))
                ((DeltaMachineDeclaration start end name inputs returnType
                  bodyValue)
                  (match name
                    ((DeltaUnqualifiedName nameStart nameEnd machineName)
                      (delta_catalog_find_qualified_data_machine source
                        targetOwner targetName rest))
                    ((DeltaQualifiedNameSyntax nameStart nameEnd machineOwner
                      machineName)
                      (if (delta_names_equal source targetOwner machineOwner)
                        (if (delta_names_equal source targetName machineName)
                          (OneDeltaCatalogDataMachine ownerDeclaration
                            declarationValue)
                          (delta_catalog_find_qualified_data_machine source
                            targetOwner targetName rest))
                        (delta_catalog_find_qualified_data_machine source
                          targetOwner targetName rest)))))))))))))

(def delta_catalog_find_boundary_machine ((source Bytes)
  (target DeltaName) (machines DeltaBoundaryMachineList))
  DeltaCatalogBoundaryMemberLookup
  (match machines
    (NoDeltaBoundaryMachines NoDeltaCatalogBoundaryMember)
    ((MoreDeltaBoundaryMachines item rest)
      (match item
        ((DeltaBoundaryMachineSyntax start end name parameters returnType)
          (if (delta_names_equal source target name)
            (OneDeltaCatalogBoundaryMember item)
            (delta_catalog_find_boundary_machine source target rest)))))))

(def delta_catalog_find_boundary_member ((source Bytes)
  (owner DeltaName) (member DeltaName)
  (rows DeltaCatalogDeclarationList)) DeltaCatalogBoundaryMemberLookup
  (match (delta_catalog_find_owner source owner rows)
    (NoDeltaCatalogOwner NoDeltaCatalogBoundaryMember)
    ((OneDeltaCatalogDataOwner declarationValue shape)
      NoDeltaCatalogBoundaryMember)
    ((OneDeltaCatalogBoundaryOwner declarationValue)
      (match declarationValue
        ((DeltaBoundaryDeclaration start end name machines)
          (delta_catalog_find_boundary_machine source member machines))
        ((DeltaDataDeclaration start end name members)
          NoDeltaCatalogBoundaryMember)
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          NoDeltaCatalogBoundaryMember)))))

(def delta_catalog_find_member_in_data ((source Bytes)
  (target DeltaName) (ownerValue DeltaDeclaration)
  (members DeltaDataMemberList))
  DeltaCatalogDataMemberLookup
  (match members
    (NoDeltaDataMembers NoDeltaCatalogDataMember)
    ((MoreDeltaDataMembers item rest)
      (match item
        ((DeltaFieldMember start end name typeValue)
          (if (delta_names_equal source target name)
            (OneDeltaCatalogField ownerValue item)
            (delta_catalog_find_member_in_data source target ownerValue
              rest)))
        ((DeltaCaseMember start end name payload)
          (if (delta_names_equal source target name)
            (OneDeltaCatalogCase ownerValue item)
            (delta_catalog_find_member_in_data source target ownerValue
              rest)))))))

(def delta_catalog_find_data_member ((source Bytes) (owner DeltaName)
  (member DeltaName) (rows DeltaCatalogDeclarationList))
  DeltaCatalogDataMemberLookup
  (match (delta_catalog_find_owner source owner rows)
    (NoDeltaCatalogOwner NoDeltaCatalogDataMember)
    ((OneDeltaCatalogBoundaryOwner declarationValue)
      NoDeltaCatalogDataMember)
    ((OneDeltaCatalogDataOwner declarationValue shape)
      (match declarationValue
        ((DeltaBoundaryDeclaration start end name machines)
          NoDeltaCatalogDataMember)
        ((DeltaDataDeclaration start end name members)
          (delta_catalog_find_member_in_data source member declarationValue
            members))
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          NoDeltaCatalogDataMember)))))

(def delta_catalog_find_state_in_list ((source Bytes) (target DeltaName)
  (states DeltaStateList)) DeltaCatalogStateLookup
  (match states
    (NoDeltaStates NoDeltaCatalogState)
    ((MoreDeltaStates item rest)
      (match item
        ((DeltaStateSyntax start end name parameters bodyValue)
          (if (delta_names_equal source target name)
            (OneDeltaCatalogState item)
            (delta_catalog_find_state_in_list source target rest)))))))

(def delta_catalog_find_state ((source Bytes)
  (machineValue DeltaDeclaration) (target DeltaName)) DeltaCatalogStateLookup
  (match machineValue
    ((DeltaBoundaryDeclaration start end name machines)
      NoDeltaCatalogState)
    ((DeltaDataDeclaration start end name members)
      NoDeltaCatalogState)
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
      (match bodyValue
        ((DeltaMachineBodySyntax bodyStart bodyEnd statements terminalValue
          states)
          (delta_catalog_find_state_in_list source target states))))))

(def delta_machine_input_parameters ((inputs DeltaMachineInputs))
  DeltaParameterList
  (match inputs
    ((NoDeltaMachineInputs start end) NoDeltaParameters)
    ((DeltaPlainMachineInputs start end parameters) parameters)
    ((DeltaReceiverMachineInputs start end receiverStart receiverEnd parameters)
      parameters)))

(def delta_machine_inputs_have_receiver ((inputs DeltaMachineInputs)) Int
  (match inputs
    ((NoDeltaMachineInputs start end) 0)
    ((DeltaPlainMachineInputs start end parameters) 0)
    ((DeltaReceiverMachineInputs start end receiverStart receiverEnd parameters)
      1)))

(def delta_constructor_parameters ((memberValue DeltaDataMember))
  DeltaParameterList
  (match memberValue
    ((DeltaFieldMember start end name typeValue) NoDeltaParameters)
    ((DeltaCaseMember start end name payload)
      (match payload
        (NoDeltaPayload NoDeltaParameters)
        ((SomeDeltaPayload payloadStart payloadEnd parameters) parameters)))))

(def delta_catalog_formed_program ((source Bytes)
  (formed DeltaFormedProgram))
  DeltaCatalogedProgram
  (match formed
    ((DeltaFormedProgramSyntax collected shapes valueEdges)
      (match collected
        ((DeltaCollectedProgramSyntax program owners machines)
          (match program
            ((DeltaSyntaxProgram start end declarations)
              (let rows
                (delta_catalog_declarations_acc source declarations
                  declarations NoDeltaCatalogDeclarations)
                (DeltaCatalogedProgramSyntax formed
                  (DeltaCatalogStateSyntax
                    (DeltaResolutionCatalogSyntax rows)
                    (delta_catalog_unknown_machine_owner_candidate
                      rows)))))))))))

(def delta_parse_collect_form_and_catalog ((source Bytes))
  DeltaCatalogOutcome
  (match (delta_parse_collect_and_form_types source)
    ((DeltaTypeFormationRejected reasonValue errorOffset)
      (DeltaCatalogRejected reasonValue errorOffset))
    ((DeltaTypeFormationInternal errorOffset)
      (DeltaCatalogInternal errorOffset))
    ((DeltaTypeFormationAccepted formed)
      (DeltaCatalogAccepted (delta_catalog_formed_program source formed)))))

; ---- ordered local and expression-fact resolution ------------------------

(def delta_local_binding_name ((bindingValue DeltaLocalBinding))
  DeltaLocalBindingNameLookup
  (match bindingValue
    ((DeltaSelfLocal ownerDeclaration) NoDeltaLocalBindingName)
    ((DeltaMachineParameterLocal parameterValue)
      (match parameterValue
        ((DeltaParameterSyntax start end name typeValue)
          (OneDeltaLocalBindingName name))))
    ((DeltaStateParameterLocal parameterValue)
      (match parameterValue
        ((DeltaParameterSyntax start end name typeValue)
          (OneDeltaLocalBindingName name))))
    ((DeltaLetLocal name typeValue statementValue)
      (OneDeltaLocalBindingName name))
    ((DeltaTransitionBinderLocal patternValue name)
      (OneDeltaLocalBindingName name))))

(def delta_local_find_binding ((source Bytes) (target DeltaName)
  (bindings DeltaLocalBindingList)) DeltaLocalBindingLookup
  (match bindings
    (NoDeltaLocalBindings NoDeltaLocalBinding)
    ((MoreDeltaLocalBindings item rest)
      (match (delta_local_binding_name item)
        (NoDeltaLocalBindingName
          (delta_local_find_binding source target rest))
        ((OneDeltaLocalBindingName name)
          (if (delta_names_equal source target name)
            (OneDeltaLocalBinding item)
            (delta_local_find_binding source target rest)))))))

(def delta_local_find_self_binding ((bindings DeltaLocalBindingList))
  DeltaSelfBindingLookup
  (match bindings
    (NoDeltaLocalBindings NoDeltaSelfBinding)
    ((MoreDeltaLocalBindings item rest)
      (match item
        ((DeltaSelfLocal ownerDeclaration)
          (OneDeltaSelfBinding item ownerDeclaration))
        ((DeltaMachineParameterLocal parameterValue)
          (delta_local_find_self_binding rest))
        ((DeltaStateParameterLocal parameterValue)
          (delta_local_find_self_binding rest))
        ((DeltaLetLocal name typeValue statementValue)
          (delta_local_find_self_binding rest))
        ((DeltaTransitionBinderLocal patternValue name)
          (delta_local_find_self_binding rest))))))

(def delta_add_machine_parameter_bindings
  ((parameters DeltaParameterList) (bindings DeltaLocalBindingList))
  DeltaLocalBindingList
  (match parameters
    (NoDeltaParameters bindings)
    ((MoreDeltaParameters item rest)
      (delta_add_machine_parameter_bindings rest
        (MoreDeltaLocalBindings
          (DeltaMachineParameterLocal item) bindings)))))

(def delta_add_catalog_machine_self_binding
  ((machineDeclaration DeltaDeclaration) (owner DeltaCatalogMachineOwner)
  (bindings DeltaLocalBindingList)) DeltaLocalBindingList
  (match machineDeclaration
    ((DeltaBoundaryDeclaration start end name machines) bindings)
    ((DeltaDataDeclaration start end name members) bindings)
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
      (if (delta_machine_inputs_have_receiver inputs)
        (match owner
          (DeltaCatalogUnqualifiedMachine bindings)
          ((DeltaCatalogUnknownMachineOwner unknownOwner) bindings)
          ((DeltaCatalogDataMachineOwner ownerDeclaration)
            (MoreDeltaLocalBindings
              (DeltaSelfLocal ownerDeclaration) bindings)))
        bindings))))

(def delta_add_state_parameter_bindings
  ((parameters DeltaParameterList) (bindings DeltaLocalBindingList))
  DeltaLocalBindingList
  (match parameters
    (NoDeltaParameters bindings)
    ((MoreDeltaParameters item rest)
      (delta_add_state_parameter_bindings rest
        (MoreDeltaLocalBindings
          (DeltaStateParameterLocal item) bindings)))))

(def delta_add_transition_binder_names ((patternValue DeltaPattern)
  (names DeltaNameList) (bindings DeltaLocalBindingList))
  DeltaLocalBindingList
  (match names
    (NoDeltaNames bindings)
    ((MoreDeltaNames item rest)
      (delta_add_transition_binder_names patternValue rest
        (MoreDeltaLocalBindings
          (DeltaTransitionBinderLocal patternValue item) bindings)))))

(def delta_add_transition_pattern_bindings ((patternValue DeltaPattern)
  (bindings DeltaLocalBindingList)) DeltaLocalBindingList
  (match patternValue
    ((DeltaIntegerPattern start end literal) bindings)
    ((DeltaTruePattern start end) bindings)
    ((DeltaFalsePattern start end) bindings)
    ((DeltaWildcardPattern start end) bindings)
    ((DeltaCasePattern start end owner name binder)
      (match binder
        (NoDeltaBinder bindings)
        ((SomeDeltaBinder binderStart binderEnd names)
          (delta_add_transition_binder_names patternValue names bindings))))))

(def delta_collect_pending_lets ((statements DeltaStatementList)
  (pending DeltaLocalBindingList)) DeltaLocalBindingList
  (match statements
    (NoDeltaStatements pending)
    ((MoreDeltaStatements item rest)
      (match item
        ((DeltaLetStatement start end name typeValue initializer)
          (delta_collect_pending_lets rest
            (MoreDeltaLocalBindings
              (DeltaLetLocal name typeValue item) pending)))
        ((DeltaAssignmentStatement start end placeValue assignedValue)
          (delta_collect_pending_lets rest pending))
        ((DeltaPostfixStatement start end expressionValue)
          (delta_collect_pending_lets rest pending))
        ((DeltaAssertStatement start end expressionValue)
          (delta_collect_pending_lets rest pending))))))

(def delta_remove_pending_binding ((source Bytes) (target DeltaName)
  (pending DeltaLocalBindingList)) DeltaLocalBindingList
  (match pending
    (NoDeltaLocalBindings NoDeltaLocalBindings)
    ((MoreDeltaLocalBindings item rest)
      (match (delta_local_binding_name item)
        (NoDeltaLocalBindingName
          (MoreDeltaLocalBindings item
            (delta_remove_pending_binding source target rest)))
        ((OneDeltaLocalBindingName name)
          (if (delta_names_equal source target name)
            rest
            (MoreDeltaLocalBindings item
              (delta_remove_pending_binding source target rest))))))))

(def delta_reverse_resolved_local_references
  ((input DeltaResolvedLocalReferenceList)
   (output DeltaResolvedLocalReferenceList)) DeltaResolvedLocalReferenceList
  (match input
    (NoDeltaResolvedLocalReferences output)
    ((MoreDeltaResolvedLocalReferences item rest)
      (delta_reverse_resolved_local_references rest
        (MoreDeltaResolvedLocalReferences item output)))))

(def delta_expression_kind ((expressionValue DeltaExpression)) Int
  (match expressionValue
    ((DeltaIntegerExpression start end literal) 0)
    ((DeltaCharacterExpression start end literal) 1)
    ((DeltaStringExpression start end literal) 2)
    ((DeltaTrueExpression start end) 3)
    ((DeltaFalseExpression start end) 4)
    ((DeltaSelfExpression start end) 5)
    ((DeltaNameExpression start end name) 6)
    ((DeltaQualifiedExpression start end owner name arguments) 7)
    ((DeltaGroupedExpression start end inner) 8)
    ((DeltaFieldExpression start end base field) 9)
    ((DeltaCallExpression start end base arguments) 10)
    ((DeltaIndexExpression start end base indexValue) 11)
    ((DeltaSliceExpression start end base low high) 12)
    ((DeltaNegateExpression start end operand) 13)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd
      left right) 14)))

; Postfix nodes inherit their base's start coordinate, so a source offset alone
; is not an expression identity. Constructor plus exact span is sufficient for
; the parser's tree-shaped AST and prevents a base fact from answering for its
; enclosing field, call, index, or slice.
(def delta_expressions_same_identity ((left DeltaExpression)
  (right DeltaExpression)) Int
  (if (eq (delta_expression_kind left) (delta_expression_kind right))
    (if (eq (delta_expression_start left) (delta_expression_start right))
      (eq (delta_expression_end left) (delta_expression_end right))
      0)
    0))

(def delta_find_resolved_local_reference ((target DeltaExpression)
  (references DeltaResolvedLocalReferenceList))
  DeltaResolvedLocalReferenceLookup
  (match references
    (NoDeltaResolvedLocalReferences NoDeltaResolvedLocalReference)
    ((MoreDeltaResolvedLocalReferences item rest)
      (match item
        ((DeltaResolvedLocalReferenceSyntax expressionValue bindingValue)
          (if (delta_expressions_same_identity target expressionValue)
            (OneDeltaResolvedLocalReference bindingValue)
            (delta_find_resolved_local_reference target rest)))))))

(def delta_reverse_resolved_field_references
  ((input DeltaResolvedFieldReferenceList)
   (output DeltaResolvedFieldReferenceList)) DeltaResolvedFieldReferenceList
  (match input
    (NoDeltaResolvedFieldReferences output)
    ((MoreDeltaResolvedFieldReferences item rest)
      (delta_reverse_resolved_field_references rest
        (MoreDeltaResolvedFieldReferences item output)))))

(def delta_find_resolved_field_reference ((target DeltaExpression)
  (references DeltaResolvedFieldReferenceList))
  DeltaResolvedFieldReferenceLookup
  (match references
    (NoDeltaResolvedFieldReferences NoDeltaResolvedFieldReference)
    ((MoreDeltaResolvedFieldReferences item rest)
      (match item
        ((DeltaResolvedFieldReferenceSyntax expressionValue owner member)
          (if (delta_expressions_same_identity target expressionValue)
            (OneDeltaResolvedFieldReference owner member)
            (delta_find_resolved_field_reference target rest)))))))

(def delta_reverse_resolved_callable_references
  ((input DeltaResolvedCallableReferenceList)
   (output DeltaResolvedCallableReferenceList))
  DeltaResolvedCallableReferenceList
  (match input
    (NoDeltaResolvedCallableReferences output)
    ((MoreDeltaResolvedCallableReferences item rest)
      (delta_reverse_resolved_callable_references rest
        (MoreDeltaResolvedCallableReferences item output)))))

(def delta_find_resolved_callable_reference
  ((target DeltaExpression)
   (references DeltaResolvedCallableReferenceList))
  DeltaResolvedCallableReferenceLookup
  (match references
    (NoDeltaResolvedCallableReferences NoDeltaResolvedCallableReference)
    ((MoreDeltaResolvedCallableReferences item rest)
      (match item
        ((DeltaResolvedCallableReferenceSyntax expressionValue callable)
          (if (delta_expressions_same_identity target expressionValue)
            (OneDeltaResolvedCallableReference callable)
            (delta_find_resolved_callable_reference target rest)))))))

(def delta_reverse_state_application_references
  ((input DeltaStateApplicationReferenceList)
   (output DeltaStateApplicationReferenceList))
  DeltaStateApplicationReferenceList
  (match input
    (NoDeltaStateApplicationReferences output)
    ((MoreDeltaStateApplicationReferences item rest)
      (delta_reverse_state_application_references rest
        (MoreDeltaStateApplicationReferences item output)))))

(def delta_find_state_application_reference
  ((target DeltaExpression) (references DeltaStateApplicationReferenceList))
  DeltaStateApplicationReferenceLookup
  (match references
    (NoDeltaStateApplicationReferences NoDeltaStateApplicationReference)
    ((MoreDeltaStateApplicationReferences item rest)
      (match item
        ((DeltaStateApplicationReferenceSyntax expressionValue machineValue
          stateValue progress)
          (if (delta_expressions_same_identity target expressionValue)
            (match progress
              (DeltaStateApplicationComplete
                (OneDeltaStateApplicationReference machineValue stateValue
                  progress))
              (DeltaStateApplicationResolved
                (match (delta_find_state_application_reference target rest)
                  (NoDeltaStateApplicationReference
                    (OneDeltaStateApplicationReference machineValue stateValue
                      progress))
                  ((OneDeltaStateApplicationReference laterMachine laterState
                    laterProgress)
                    (OneDeltaStateApplicationReference laterMachine laterState
                      laterProgress)))))
            (delta_find_state_application_reference target rest)))))))

(def delta_patterns_same_identity ((left DeltaPattern) (right DeltaPattern)) Int
  (match left
    ((DeltaIntegerPattern leftStart leftEnd leftLiteral)
      (match right
        ((DeltaIntegerPattern rightStart rightEnd rightLiteral)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))
        ((DeltaTruePattern rightStart rightEnd) 0)
        ((DeltaFalsePattern rightStart rightEnd) 0)
        ((DeltaWildcardPattern rightStart rightEnd) 0)
        ((DeltaCasePattern rightStart rightEnd rightOwner rightName rightBinder)
          0)))
    ((DeltaTruePattern leftStart leftEnd)
      (match right
        ((DeltaIntegerPattern rightStart rightEnd rightLiteral) 0)
        ((DeltaTruePattern rightStart rightEnd)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))
        ((DeltaFalsePattern rightStart rightEnd) 0)
        ((DeltaWildcardPattern rightStart rightEnd) 0)
        ((DeltaCasePattern rightStart rightEnd rightOwner rightName rightBinder)
          0)))
    ((DeltaFalsePattern leftStart leftEnd)
      (match right
        ((DeltaIntegerPattern rightStart rightEnd rightLiteral) 0)
        ((DeltaTruePattern rightStart rightEnd) 0)
        ((DeltaFalsePattern rightStart rightEnd)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))
        ((DeltaWildcardPattern rightStart rightEnd) 0)
        ((DeltaCasePattern rightStart rightEnd rightOwner rightName rightBinder)
          0)))
    ((DeltaWildcardPattern leftStart leftEnd)
      (match right
        ((DeltaIntegerPattern rightStart rightEnd rightLiteral) 0)
        ((DeltaTruePattern rightStart rightEnd) 0)
        ((DeltaFalsePattern rightStart rightEnd) 0)
        ((DeltaWildcardPattern rightStart rightEnd)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))
        ((DeltaCasePattern rightStart rightEnd rightOwner rightName rightBinder)
          0)))
    ((DeltaCasePattern leftStart leftEnd leftOwner leftName leftBinder)
      (match right
        ((DeltaIntegerPattern rightStart rightEnd rightLiteral) 0)
        ((DeltaTruePattern rightStart rightEnd) 0)
        ((DeltaFalsePattern rightStart rightEnd) 0)
        ((DeltaWildcardPattern rightStart rightEnd) 0)
        ((DeltaCasePattern rightStart rightEnd rightOwner rightName rightBinder)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))))))

(def delta_terminals_same_identity ((left DeltaTerminal)
  (right DeltaTerminal)) Int
  (match left
    ((DeltaTransitionTerminal leftStart leftEnd leftSubject leftArms)
      (match right
        ((DeltaTransitionTerminal rightStart rightEnd rightSubject rightArms)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))
        ((DeltaReturnTerminal rightStart rightEnd rightExpression) 0)))
    ((DeltaReturnTerminal leftStart leftEnd leftExpression)
      (match right
        ((DeltaTransitionTerminal rightStart rightEnd rightSubject rightArms) 0)
        ((DeltaReturnTerminal rightStart rightEnd rightExpression)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))))))

(def delta_reverse_transition_subject_references
  ((input DeltaTransitionSubjectReferenceList)
   (output DeltaTransitionSubjectReferenceList))
  DeltaTransitionSubjectReferenceList
  (match input
    (NoDeltaTransitionSubjectReferences output)
    ((MoreDeltaTransitionSubjectReferences item rest)
      (delta_reverse_transition_subject_references rest
        (MoreDeltaTransitionSubjectReferences item output)))))

(def delta_find_transition_subject_reference ((target DeltaTerminal)
  (references DeltaTransitionSubjectReferenceList))
  DeltaTransitionSubjectReferenceLookup
  (match references
    (NoDeltaTransitionSubjectReferences NoDeltaTransitionSubjectReference)
    ((MoreDeltaTransitionSubjectReferences item rest)
      (match item
        ((DeltaTransitionSubjectReferenceSyntax terminalValue kind)
          (if (delta_terminals_same_identity target terminalValue)
            (OneDeltaTransitionSubjectReference kind)
            (delta_find_transition_subject_reference target rest)))))))

(def delta_reverse_transition_pattern_references
  ((input DeltaTransitionPatternReferenceList)
   (output DeltaTransitionPatternReferenceList))
  DeltaTransitionPatternReferenceList
  (match input
    (NoDeltaTransitionPatternReferences output)
    ((MoreDeltaTransitionPatternReferences item rest)
      (delta_reverse_transition_pattern_references rest
        (MoreDeltaTransitionPatternReferences item output)))))

(def delta_reverse_transition_coverage_references
  ((input DeltaTransitionCoverageReferenceList)
   (output DeltaTransitionCoverageReferenceList))
  DeltaTransitionCoverageReferenceList
  (match input
    (NoDeltaTransitionCoverageReferences output)
    ((MoreDeltaTransitionCoverageReferences item rest)
      (delta_reverse_transition_coverage_references rest
        (MoreDeltaTransitionCoverageReferences item output)))))

(def delta_find_transition_pattern_reference ((target DeltaPattern)
  (references DeltaTransitionPatternReferenceList))
  DeltaTransitionPatternReferenceLookup
  (match references
    (NoDeltaTransitionPatternReferences NoDeltaTransitionPatternReference)
    ((MoreDeltaTransitionPatternReferences item rest)
      (match item
        ((DeltaTransitionPatternReferenceSyntax terminalValue patternValue kind
          progress)
          (if (delta_patterns_same_identity target patternValue)
            (OneDeltaTransitionPatternReference kind progress)
            (delta_find_transition_pattern_reference target rest)))))))

(def delta_data_members_same_identity ((left DeltaDataMember)
  (right DeltaDataMember)) Int
  (match left
    ((DeltaFieldMember leftStart leftEnd leftName leftType)
      (match right
        ((DeltaFieldMember rightStart rightEnd rightName rightType)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))
        ((DeltaCaseMember rightStart rightEnd rightName rightPayload) 0)))
    ((DeltaCaseMember leftStart leftEnd leftName leftPayload)
      (match right
        ((DeltaFieldMember rightStart rightEnd rightName rightType) 0)
        ((DeltaCaseMember rightStart rightEnd rightName rightPayload)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))))))

(def delta_control_find_state_application ((target DeltaExpression)
  (control DeltaControlReferenceLedger)) DeltaStateApplicationReferenceLookup
  (match control
    ((DeltaControlReferenceLedgerSyntax stateApplications subjects cases
      coverages)
      (delta_find_state_application_reference target stateApplications))))

(def delta_control_find_transition_subject ((target DeltaTerminal)
  (control DeltaControlReferenceLedger))
  DeltaTransitionSubjectReferenceLookup
  (match control
    ((DeltaControlReferenceLedgerSyntax stateApplications subjects patterns
      coverages)
      (delta_find_transition_subject_reference target subjects))))

(def delta_control_find_transition_pattern ((target DeltaPattern)
  (control DeltaControlReferenceLedger))
  DeltaTransitionPatternReferenceLookup
  (match control
    ((DeltaControlReferenceLedgerSyntax stateApplications subjects patterns
      coverages)
      (delta_find_transition_pattern_reference target patterns))))

(def delta_reverse_control_references ((control DeltaControlReferenceLedger))
  DeltaControlReferenceLedger
  (match control
    ((DeltaControlReferenceLedgerSyntax stateApplications subjects cases
      coverages)
      (DeltaControlReferenceLedgerSyntax
        (delta_reverse_state_application_references stateApplications
          NoDeltaStateApplicationReferences)
        (delta_reverse_transition_subject_references subjects
          NoDeltaTransitionSubjectReferences)
        (delta_reverse_transition_pattern_references cases
          NoDeltaTransitionPatternReferences)
        (delta_reverse_transition_coverage_references coverages
          NoDeltaTransitionCoverageReferences)))))

(def delta_reverse_typed_expressions ((input DeltaTypedExpressionList)
  (output DeltaTypedExpressionList)) DeltaTypedExpressionList
  (match input
    (NoDeltaTypedExpressions output)
    ((MoreDeltaTypedExpressions item rest)
      (delta_reverse_typed_expressions rest
        (MoreDeltaTypedExpressions item output)))))

(def delta_find_expression_result ((target DeltaExpression)
  (expressions DeltaTypedExpressionList)) DeltaExpressionResultLookup
  (match expressions
    (NoDeltaTypedExpressions NoDeltaExpressionResult)
    ((MoreDeltaTypedExpressions item rest)
      (match item
        ((DeltaTypedExpressionSyntax expressionValue resultValue)
          (if (delta_expressions_same_identity target expressionValue)
            (OneDeltaExpressionResult resultValue)
            (delta_find_expression_result target rest)))))))

(def delta_binder_parameter_type ((source Bytes) (target DeltaName)
  (names DeltaNameList) (parameters DeltaParameterList))
  DeltaLocalBindingTypeLookup
  (match names
    (NoDeltaNames NoDeltaLocalBindingType)
    ((MoreDeltaNames name restNames)
      (match parameters
        (NoDeltaParameters NoDeltaLocalBindingType)
        ((MoreDeltaParameters parameterValue restParameters)
          (if (delta_names_equal source target name)
            (match parameterValue
              ((DeltaParameterSyntax start end parameterName typeValue)
                (OneDeltaLocalBindingType typeValue)))
            (delta_binder_parameter_type source target restNames
              restParameters)))))))

(def delta_transition_binder_type ((source Bytes) (patternValue DeltaPattern)
  (target DeltaName) (control DeltaControlReferenceLedger))
  DeltaLocalBindingTypeLookup
  (match (delta_control_find_transition_pattern patternValue control)
    (NoDeltaTransitionPatternReference NoDeltaLocalBindingType)
    ((OneDeltaTransitionPatternReference kind progress)
      (match progress
        (DeltaTransitionPatternResolved NoDeltaLocalBindingType)
        (DeltaTransitionPatternComplete
          (match kind
            ((DeltaScalarPatternSelector value) NoDeltaLocalBindingType)
            (DeltaTransitionWildcard NoDeltaLocalBindingType)
            ((DeltaSumCasePattern ownerValue caseValue)
              (match patternValue
                ((DeltaIntegerPattern start end literal)
                  NoDeltaLocalBindingType)
                ((DeltaTruePattern start end) NoDeltaLocalBindingType)
                ((DeltaFalsePattern start end) NoDeltaLocalBindingType)
                ((DeltaWildcardPattern start end) NoDeltaLocalBindingType)
                ((DeltaCasePattern start end owner name binder)
                  (match binder
                    (NoDeltaBinder NoDeltaLocalBindingType)
                    ((SomeDeltaBinder binderStart binderEnd names)
                      (delta_binder_parameter_type source target names
                        (delta_constructor_parameters caseValue)))))))))))))

(def delta_local_binding_type ((source Bytes)
  (bindingValue DeltaLocalBinding) (control DeltaControlReferenceLedger))
  DeltaLocalBindingTypeLookup
  (match bindingValue
    ((DeltaSelfLocal ownerDeclaration) NoDeltaLocalBindingType)
    ((DeltaMachineParameterLocal parameterValue)
      (match parameterValue
        ((DeltaParameterSyntax start end name typeValue)
          (OneDeltaLocalBindingType typeValue))))
    ((DeltaStateParameterLocal parameterValue)
      (match parameterValue
        ((DeltaParameterSyntax start end name typeValue)
          (OneDeltaLocalBindingType typeValue))))
    ((DeltaLetLocal name typeValue statementValue)
      (OneDeltaLocalBindingType typeValue))
    ((DeltaTransitionBinderLocal patternValue name)
      (delta_transition_binder_type source patternValue name control))))

(def delta_local_scan_binding_type ((source Bytes)
  (bindingValue DeltaLocalBinding) (scan DeltaLocalResolutionScan))
  DeltaLocalBindingTypeLookup
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (delta_local_binding_type source bindingValue control))))

; `u8` names storage, not an arithmetic value type. Reading one storage slot
; yields a zero-extended `i32`; every other complete value keeps its type.
(def delta_storage_read_type ((expressionValue DeltaExpression)
  (typeValue DeltaType)) DeltaType
  (match typeValue
    ((DeltaU8Type start end)
      (DeltaI32Type (delta_expression_start expressionValue)
        (delta_expression_end expressionValue)))
    ((DeltaI32Type start end) typeValue)
    ((DeltaNeverType start end) typeValue)
    ((DeltaNamedType start end name) typeValue)
    ((DeltaArrayType start end element lengthValue) typeValue)
    ((DeltaViewType start end element) typeValue)))

(def delta_type_is_i32 ((typeValue DeltaType)) Int
  (match typeValue
    ((DeltaI32Type start end) 1)
    ((DeltaU8Type start end) 0)
    ((DeltaNeverType start end) 0)
    ((DeltaNamedType start end name) 0)
    ((DeltaArrayType start end element lengthValue) 0)
    ((DeltaViewType start end element) 0)))

(def delta_local_scan_add_result ((expressionValue DeltaExpression)
  (resultValue DeltaExpressionResult) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (DeltaLocalResolutionScanSyntax catalog references fields callables
        stateApplications
        (MoreDeltaTypedExpressions
          (DeltaTypedExpressionSyntax expressionValue resultValue) types)
        candidate))))

(def delta_local_scan_add_value ((expressionValue DeltaExpression)
  (typeValue DeltaType) (placeType DeltaOptionalPlaceType)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (delta_local_scan_add_result expressionValue
    (DeltaValueExpressionResult typeValue placeType) scan))

(def delta_local_scan_add_reference ((expressionValue DeltaExpression)
  (bindingValue DeltaLocalBinding) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (DeltaLocalResolutionScanSyntax catalog
        (MoreDeltaResolvedLocalReferences
          (DeltaResolvedLocalReferenceSyntax expressionValue bindingValue)
          references)
        fields callables stateApplications types candidate))))

(def delta_local_scan_add_field_reference ((expressionValue DeltaExpression)
  (owner DeltaDeclaration) (member DeltaDataMember)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (DeltaLocalResolutionScanSyntax catalog references
        (MoreDeltaResolvedFieldReferences
          (DeltaResolvedFieldReferenceSyntax expressionValue owner member)
          fields)
        callables stateApplications types candidate))))

(def delta_local_scan_add_callable_reference
  ((expressionValue DeltaExpression)
   (callable DeltaResolvedCallable)
   (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (DeltaLocalResolutionScanSyntax catalog references fields
        (MoreDeltaResolvedCallableReferences
          (DeltaResolvedCallableReferenceSyntax expressionValue callable)
          callables)
        stateApplications types candidate))))

(def delta_local_scan_add_state_application
  ((expressionValue DeltaExpression) (machineValue DeltaDeclaration)
   (stateValue DeltaState) (progress DeltaStateApplicationProgress)
   (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      stateApplications types candidate)
      (match stateApplications
        ((DeltaControlReferenceLedgerSyntax states subjects patterns coverages)
          (DeltaLocalResolutionScanSyntax catalog references fields callables
            (DeltaControlReferenceLedgerSyntax
              (MoreDeltaStateApplicationReferences
                (DeltaStateApplicationReferenceSyntax expressionValue
                  machineValue stateValue progress)
                states)
              subjects patterns coverages)
            types candidate))))))

(def delta_local_scan_add_transition_subject ((terminalValue DeltaTerminal)
  (kind DeltaTransitionSubjectKind) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match control
        ((DeltaControlReferenceLedgerSyntax states subjects patterns coverages)
          (DeltaLocalResolutionScanSyntax catalog references fields callables
            (DeltaControlReferenceLedgerSyntax states
              (MoreDeltaTransitionSubjectReferences
                (DeltaTransitionSubjectReferenceSyntax terminalValue kind)
                subjects)
              patterns coverages)
            types candidate))))))

(def delta_local_scan_add_transition_pattern ((terminalValue DeltaTerminal)
  (patternValue DeltaPattern) (kind DeltaTransitionPatternKind)
  (progress DeltaTransitionPatternProgress)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match control
        ((DeltaControlReferenceLedgerSyntax states subjects patterns coverages)
          (DeltaLocalResolutionScanSyntax catalog references fields callables
            (DeltaControlReferenceLedgerSyntax states subjects
              (MoreDeltaTransitionPatternReferences
                (DeltaTransitionPatternReferenceSyntax terminalValue
                  patternValue kind progress)
                patterns)
              coverages)
            types candidate))))))

(def delta_local_scan_add_transition_coverage ((terminalValue DeltaTerminal)
  (ownerValue DeltaDeclaration) (state DeltaTransitionCoverageState)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match control
        ((DeltaControlReferenceLedgerSyntax states subjects patterns coverages)
          (DeltaLocalResolutionScanSyntax catalog references fields callables
            (DeltaControlReferenceLedgerSyntax states subjects patterns
              (MoreDeltaTransitionCoverageReferences
                (DeltaTransitionCoverageReferenceSyntax terminalValue
                  ownerValue state)
                coverages))
            types candidate))))))

(def delta_local_scan_add_candidate ((reasonValue DeltaRejectReason)
  (offset Int) (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
        (delta_final_candidate_add reasonValue offset candidate)))))

(def delta_expression_list_count ((expressions DeltaExpressionList)) Int
  (match expressions
    (NoDeltaExpressions 0)
    ((MoreDeltaExpressions item rest)
      (+ 1 (delta_expression_list_count rest)))))

(def delta_parameter_list_count ((parameters DeltaParameterList)) Int
  (match parameters
    (NoDeltaParameters 0)
    ((MoreDeltaParameters item rest)
      (+ 1 (delta_parameter_list_count rest)))))

(def delta_name_list_count ((names DeltaNameList)) Int
  (match names
    (NoDeltaNames 0)
    ((MoreDeltaNames item rest) (+ 1 (delta_name_list_count rest)))))

(def delta_optional_binder_count ((binder DeltaOptionalBinder)) Int
  (match binder
    (NoDeltaBinder 0)
    ((SomeDeltaBinder start end names) (delta_name_list_count names))))

(def delta_data_declarations_same_identity ((left DeltaDeclaration)
  (right DeltaDeclaration)) Int
  (match left
    ((DeltaBoundaryDeclaration leftStart leftEnd leftName leftMachines) 0)
    ((DeltaMachineDeclaration leftStart leftEnd leftName leftInputs
      leftReturn leftBody) 0)
    ((DeltaDataDeclaration leftStart leftEnd leftName leftMembers)
      (match right
        ((DeltaBoundaryDeclaration rightStart rightEnd rightName rightMachines)
          0)
        ((DeltaMachineDeclaration rightStart rightEnd rightName rightInputs
          rightReturn rightBody) 0)
        ((DeltaDataDeclaration rightStart rightEnd rightName rightMembers)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))))))

(def delta_optional_arguments_count ((arguments DeltaOptionalArguments)) Int
  (match arguments
    (NoDeltaArguments 0)
    ((SomeDeltaArguments openStart closeEnd values)
      (delta_expression_list_count values))))

(def delta_argument_value_type_compatible ((source Bytes)
  (actual DeltaType) (expected DeltaType) (storedEstablishment Int)) Int
  (if storedEstablishment
    (match expected
      ((DeltaU8Type start end) (delta_type_is_i32 actual))
      ((DeltaI32Type start end) (delta_types_equal source actual expected))
      ((DeltaNeverType start end) (delta_types_equal source actual expected))
      ((DeltaNamedType start end name)
        (delta_types_equal source actual expected))
      ((DeltaArrayType start end element lengthValue)
        (delta_types_equal source actual expected))
      ((DeltaViewType start end element)
        (delta_types_equal source actual expected)))
    (delta_types_equal source actual expected)))

(def delta_argument_type_join_merge ((left DeltaArgumentTypeJoin)
  (right DeltaArgumentTypeJoin)) DeltaArgumentTypeJoin
  (match left
    (DeltaArgumentsIncomplete DeltaArgumentsIncomplete)
    (DeltaArgumentsTypeMismatch
      (match right
        (DeltaArgumentsIncomplete DeltaArgumentsIncomplete)
        (DeltaArgumentsCompatible DeltaArgumentsTypeMismatch)
        (DeltaArgumentsTypeMismatch DeltaArgumentsTypeMismatch)))
    (DeltaArgumentsCompatible right)))

(def delta_argument_types_join ((source Bytes)
  (arguments DeltaExpressionList) (parameters DeltaParameterList)
  (types DeltaTypedExpressionList) (storedEstablishment Int))
  DeltaArgumentTypeJoin
  (match arguments
    (NoDeltaExpressions
      (match parameters
        (NoDeltaParameters DeltaArgumentsCompatible)
        ((MoreDeltaParameters parameter rest)
          DeltaArgumentsIncomplete)))
    ((MoreDeltaExpressions argument argumentRest)
      (match parameters
        (NoDeltaParameters DeltaArgumentsIncomplete)
        ((MoreDeltaParameters parameter parameterRest)
          (match parameter
            ((DeltaParameterSyntax start end name expectedType)
              (let current
                (match (delta_find_expression_result argument types)
                  (NoDeltaExpressionResult DeltaArgumentsIncomplete)
                  ((OneDeltaExpressionResult resultValue)
                    (match resultValue
                      ((DeltaValueExpressionResult actualType placeType)
                        (if (delta_argument_value_type_compatible source
                          actualType expectedType storedEstablishment)
                          DeltaArgumentsCompatible
                          DeltaArgumentsTypeMismatch))
                      (DeltaResultlessExpressionResult
                        DeltaArgumentsIncomplete)
                      (DeltaNeverExpressionResult
                        DeltaArgumentsIncomplete))))
                (delta_argument_type_join_merge current
                  (delta_argument_types_join source argumentRest parameterRest
                    types storedEstablishment))))))))))

(def delta_optional_argument_types_join ((source Bytes)
  (arguments DeltaOptionalArguments) (parameters DeltaParameterList)
  (types DeltaTypedExpressionList) (storedEstablishment Int))
  DeltaArgumentTypeJoin
  (match arguments
    (NoDeltaArguments
      (match parameters
        (NoDeltaParameters DeltaArgumentsCompatible)
        ((MoreDeltaParameters item rest) DeltaArgumentsIncomplete)))
    ((SomeDeltaArguments openStart closeEnd values)
      (delta_argument_types_join source values parameters types
        storedEstablishment))))

(def delta_local_scan_add_machine_result ((expressionValue DeltaExpression)
  (returnType DeltaOptionalType) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match returnType
    (NoDeltaType
      (delta_local_scan_add_result expressionValue
        DeltaResultlessExpressionResult scan))
    ((SomeDeltaType start end typeValue)
      (match typeValue
        ((DeltaNeverType typeStart typeEnd)
          (delta_local_scan_add_result expressionValue
            DeltaNeverExpressionResult scan))
        ((DeltaI32Type typeStart typeEnd)
          (delta_local_scan_add_value expressionValue typeValue
            NoDeltaPlaceType scan))
        ((DeltaU8Type typeStart typeEnd)
          (delta_local_scan_add_value expressionValue typeValue
            NoDeltaPlaceType scan))
        ((DeltaNamedType typeStart typeEnd name)
          (delta_local_scan_add_value expressionValue typeValue
            NoDeltaPlaceType scan))
        ((DeltaArrayType typeStart typeEnd element lengthValue)
          (delta_local_scan_add_value expressionValue typeValue
            NoDeltaPlaceType scan))
        ((DeltaViewType typeStart typeEnd element)
          (delta_local_scan_add_value expressionValue typeValue
            NoDeltaPlaceType scan))))))

; An argument's explicitly anchored `never` category is a sibling of callable
; admission and arity, so retain it for every authored application before
; lookup. D37 does not yet assign an anchor to a resultless argument's required
; TypeMismatch; leave that owner-blocked category factless rather than guessing.
; The later all-value type join owns application-anchored type mismatch.
(def delta_local_scan_argument_terminal_candidates
  ((arguments DeltaExpressionList) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match arguments
    (NoDeltaExpressions scan)
    ((MoreDeltaExpressions item rest)
      (let nextScan
        (match scan
          ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications
            types candidate)
            (match (delta_find_expression_result item types)
              (NoDeltaExpressionResult scan)
              ((OneDeltaExpressionResult resultValue)
                (match resultValue
                  ((DeltaValueExpressionResult typeValue placeType) scan)
                  (DeltaResultlessExpressionResult scan)
                  (DeltaNeverExpressionResult
                    (delta_local_scan_add_candidate InvalidTerminal
                      (delta_expression_start (delta_call_head_core item))
                      scan)))))))
        (delta_local_scan_argument_terminal_candidates rest nextScan)))))

; Every admitted callable spelling converges here after identity and category
; resolution. Arity depends on the signature plus authored argument count; the
; sibling argument-type join additionally waits for every complete value fact.
; A receiver is implicit and therefore never appears in either list.
(def delta_local_scan_admitted_signature_application ((source Bytes)
  (expressionValue DeltaExpression) (arguments DeltaExpressionList)
  (parameters DeltaParameterList) (returnType DeltaOptionalType)
  (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (if (eq (delta_expression_list_count arguments)
    (delta_parameter_list_count parameters))
    (match scan
      ((DeltaLocalResolutionScanSyntax catalog references fields
        callables stateApplications types candidate)
        (match (delta_argument_types_join source arguments parameters
          types 0)
          (DeltaArgumentsCompatible
            (delta_local_scan_add_machine_result expressionValue
              returnType scan))
          (DeltaArgumentsIncomplete scan)
          (DeltaArgumentsTypeMismatch
            (delta_local_scan_add_candidate TypeMismatch
              (delta_expression_start expressionValue) scan)))))
    (delta_local_scan_add_candidate ArityMismatch
      (delta_expression_start expressionValue) scan)))

(def delta_local_scan_admitted_machine_application ((source Bytes)
  (expressionValue DeltaExpression) (arguments DeltaExpressionList)
  (machineDeclaration DeltaDeclaration) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match machineDeclaration
    ((DeltaBoundaryDeclaration start end name machines) scan)
    ((DeltaDataDeclaration start end name members) scan)
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
      (delta_local_scan_admitted_signature_application source expressionValue
        arguments (delta_machine_input_parameters inputs) returnType scan))))

(def delta_state_parameters ((stateValue DeltaState)) DeltaParameterList
  (match stateValue
    ((DeltaStateSyntax start end name parameters bodyValue) parameters)))

; State identity is retained before arity and argument typing, but only the
; stronger complete row authorizes lowering a transfer. A state is not an
; expression result and never enters the callable ledger.
(def delta_local_scan_admitted_state_application ((source Bytes)
  (expressionValue DeltaExpression) (arguments DeltaExpressionList)
  (machineValue DeltaDeclaration) (stateValue DeltaState)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (let parameters (delta_state_parameters stateValue)
    (if (eq (delta_expression_list_count arguments)
      (delta_parameter_list_count parameters))
      (match scan
        ((DeltaLocalResolutionScanSyntax catalog references fields callables
          stateApplications types candidate)
          (match (delta_argument_types_join source arguments parameters
            types 0)
            (DeltaArgumentsCompatible
              (delta_local_scan_add_state_application expressionValue
                machineValue stateValue DeltaStateApplicationComplete scan))
            (DeltaArgumentsIncomplete
              (delta_local_scan_add_state_application expressionValue
                machineValue stateValue DeltaStateApplicationResolved scan))
            (DeltaArgumentsTypeMismatch
              (delta_local_scan_add_candidate TypeMismatch
                (delta_expression_start expressionValue)
                (delta_local_scan_add_state_application expressionValue
                  machineValue stateValue DeltaStateApplicationResolved
                  scan))))))
      (delta_local_scan_add_candidate ArityMismatch
        (delta_expression_start expressionValue)
        (delta_local_scan_add_state_application expressionValue machineValue
          stateValue DeltaStateApplicationResolved scan)))))

(def delta_expression_use_qualified_failure_anchor
  ((expressionValue DeltaExpression) (useValue DeltaExpressionUse)) Int
  (match useValue
    (DeltaOrdinaryExpressionUse (delta_expression_start expressionValue))
    (DeltaCallHeadExpressionUse (delta_expression_start expressionValue))
    ((DeltaPostfixStatementExpressionUse statementStart) statementStart)
    ((DeltaTransitionContinuationExpressionUse machineValue continuationStart)
      continuationStart)))

(def delta_local_scan_constructor_value_application ((source Bytes)
  (expressionValue DeltaExpression) (ownerName DeltaName)
  (arguments DeltaOptionalArguments) (caseValue DeltaDataMember)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (let parameters (delta_constructor_parameters caseValue)
    (if (eq (delta_optional_arguments_count arguments)
      (delta_parameter_list_count parameters))
      (match scan
        ((DeltaLocalResolutionScanSyntax catalog references fields
          callables stateApplications types candidate)
          (match (delta_optional_argument_types_join source arguments
            parameters types 1)
            (DeltaArgumentsCompatible
              (delta_local_scan_add_value expressionValue
                (DeltaNamedType (delta_expression_start expressionValue)
                  (delta_expression_end expressionValue) ownerName)
                NoDeltaPlaceType scan))
            (DeltaArgumentsIncomplete scan)
            (DeltaArgumentsTypeMismatch
              (delta_local_scan_add_candidate TypeMismatch
                (delta_expression_start expressionValue) scan)))))
      (delta_local_scan_add_candidate ArityMismatch
        (delta_expression_start expressionValue) scan))))

(def delta_local_scan_constructor_application ((source Bytes)
  (expressionValue DeltaExpression) (ownerName DeltaName)
  (arguments DeltaOptionalArguments) (ownerDeclaration DeltaDeclaration)
  (caseValue DeltaDataMember) (useValue DeltaExpressionUse)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (let identityScan
    (delta_local_scan_add_callable_reference expressionValue
      (DeltaResolvedConstructorCallable ownerDeclaration caseValue) scan)
    (match useValue
      (DeltaOrdinaryExpressionUse
        (delta_local_scan_constructor_value_application source expressionValue
          ownerName arguments caseValue identityScan))
      (DeltaCallHeadExpressionUse
        (delta_local_scan_constructor_value_application source expressionValue
          ownerName arguments caseValue identityScan))
      ((DeltaPostfixStatementExpressionUse statementStart)
        (delta_local_scan_add_candidate TypeMismatch
          statementStart identityScan))
      ((DeltaTransitionContinuationExpressionUse machineValue continuationStart)
        (delta_local_scan_add_candidate InvalidControlTarget
          continuationStart identityScan)))))

(def delta_local_scan_data_machine_application ((source Bytes)
  (expressionValue DeltaExpression) (arguments DeltaOptionalArguments)
  (ownerDeclaration DeltaDeclaration) (machineDeclaration DeltaDeclaration)
  (useValue DeltaExpressionUse) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (let identityScan
    (delta_local_scan_add_callable_reference expressionValue
      (DeltaResolvedDataMachineCallable ownerDeclaration machineDeclaration)
      scan)
    (match machineDeclaration
      ((DeltaBoundaryDeclaration start end name machines) identityScan)
      ((DeltaDataDeclaration start end name members) identityScan)
      ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
        (match arguments
          (NoDeltaArguments
            (match useValue
              (DeltaOrdinaryExpressionUse
                (delta_local_scan_add_candidate TypeMismatch
                  (delta_expression_start expressionValue) identityScan))
              ; A bare qualified machine can be the grammar-selected head of
              ; a following call suffix. That outer application owns custody.
              (DeltaCallHeadExpressionUse identityScan)
              ((DeltaPostfixStatementExpressionUse statementStart)
                (delta_local_scan_add_candidate TypeMismatch
                  statementStart identityScan))
              ((DeltaTransitionContinuationExpressionUse machineValue
                continuationStart) identityScan)))
          ((SomeDeltaArguments openStart closeEnd values)
            (if (delta_machine_inputs_have_receiver inputs)
              ; Static qualified syntax never supplies or infers a receiver,
              ; regardless of expression, statement, or continuation context.
              (delta_local_scan_wrong_qualified_callable_kind expressionValue
                useValue identityScan)
              (delta_local_scan_admitted_machine_application source
                expressionValue values machineDeclaration identityScan))))))))

(def delta_local_scan_wrong_qualified_callable_kind
  ((expressionValue DeltaExpression) (useValue DeltaExpressionUse)
   (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match useValue
    (DeltaOrdinaryExpressionUse
      (delta_local_scan_add_candidate TypeMismatch
        (delta_expression_start expressionValue) scan))
    (DeltaCallHeadExpressionUse
      (delta_local_scan_add_candidate TypeMismatch
        (delta_expression_start expressionValue) scan))
    ((DeltaPostfixStatementExpressionUse statementStart)
      (delta_local_scan_add_candidate TypeMismatch
        statementStart scan))
    ((DeltaTransitionContinuationExpressionUse machineValue continuationStart)
      (delta_local_scan_add_candidate InvalidControlTarget continuationStart
        scan))))

(def delta_local_scan_qualified_callable_fact ((source Bytes)
  (expressionValue DeltaExpression) (ownerName DeltaName) (memberName DeltaName)
  (arguments DeltaOptionalArguments) (useValue DeltaExpressionUse)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match catalog
        ((DeltaResolutionCatalogSyntax rows)
          (match (delta_catalog_find_owner source ownerName rows)
            (NoDeltaCatalogOwner
              (delta_local_scan_add_candidate UnknownName
                (delta_name_start ownerName) scan))
            ((OneDeltaCatalogBoundaryOwner ownerDeclaration)
              (match (delta_catalog_find_boundary_member source ownerName
                memberName rows)
                (NoDeltaCatalogBoundaryMember
                  (delta_local_scan_add_candidate UnknownName
                    (delta_name_start memberName) scan))
                ((OneDeltaCatalogBoundaryMember memberValue)
                  (delta_local_scan_wrong_qualified_callable_kind
                    expressionValue useValue scan))))
            ((OneDeltaCatalogDataOwner ownerDeclaration shape)
              (let memberLookup
                (delta_catalog_find_data_member source ownerName memberName rows)
                (let machineLookup
                  (delta_catalog_find_qualified_data_machine source ownerName
                    memberName rows)
                  (match machineLookup
                    ((OneDeltaCatalogDataMachine machineOwner
                      machineDeclaration)
                      (match memberLookup
                        ((OneDeltaCatalogCase caseOwner caseValue)
                          ; Accepted D36 census makes this dual success
                          ; unreachable. Never choose a callable by lookup order.
                          scan)
                        (NoDeltaCatalogDataMember
                          (delta_local_scan_data_machine_application source
                            expressionValue arguments machineOwner
                            machineDeclaration useValue scan))
                        ((OneDeltaCatalogField fieldOwner fieldValue)
                          (delta_local_scan_data_machine_application source
                            expressionValue arguments machineOwner
                            machineDeclaration useValue scan))))
                    (NoDeltaCatalogDataMachine
                      (match memberLookup
                        ((OneDeltaCatalogCase caseOwner caseValue)
                          (delta_local_scan_constructor_application source
                            expressionValue ownerName arguments caseOwner
                            caseValue useValue scan))
                        ((OneDeltaCatalogField fieldOwner fieldValue)
                          (delta_local_scan_wrong_qualified_callable_kind
                            expressionValue useValue scan))
                        (NoDeltaCatalogDataMember
                          (delta_local_scan_add_candidate UnknownName
                            (delta_name_start memberName) scan))))))))))))))

; Parentheses do not create a distinct callable identity. The outer
; application remains the custody/result key while this allocation-free view
; exposes only the grammar-selected core head.
(def delta_call_head_core ((expressionValue DeltaExpression)) DeltaExpression
  (match expressionValue
    ((DeltaGroupedExpression start end inner) (delta_call_head_core inner))
    ((DeltaIntegerExpression start end literal) expressionValue)
    ((DeltaCharacterExpression start end literal) expressionValue)
    ((DeltaStringExpression start end literal) expressionValue)
    ((DeltaTrueExpression start end) expressionValue)
    ((DeltaFalseExpression start end) expressionValue)
    ((DeltaSelfExpression start end) expressionValue)
    ((DeltaNameExpression start end name) expressionValue)
    ((DeltaQualifiedExpression start end owner name arguments) expressionValue)
    ((DeltaFieldExpression start end base field) expressionValue)
    ((DeltaCallExpression start end base arguments) expressionValue)
    ((DeltaIndexExpression start end base indexValue) expressionValue)
    ((DeltaSliceExpression start end base low high) expressionValue)
    ((DeltaNegateExpression start end operand) expressionValue)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd
      left right) expressionValue)))

; If a call-head selector resolves to an authored field rather than a receiver
; machine, materialize the ordinary field result on the exact selector and
; carry it through authored parentheses. The general value-call rule then owns
; the outer TypeMismatch. This preserves field custody and never chooses a
; callable merely because a field shares its spelling.
(def delta_local_scan_propagate_grouped_call_head_result
  ((callBase DeltaExpression) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match callBase
    ((DeltaGroupedExpression start end inner)
      (match scan
        ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications
          types candidate)
          (match (delta_find_expression_result callBase types)
            ((OneDeltaExpressionResult resultValue) scan)
            (NoDeltaExpressionResult
              (let nextScan
                (delta_local_scan_propagate_grouped_call_head_result inner scan)
                (delta_local_scan_propagate_result callBase inner
                  nextScan)))))))
    ((DeltaIntegerExpression start end literal) scan)
    ((DeltaCharacterExpression start end literal) scan)
    ((DeltaStringExpression start end literal) scan)
    ((DeltaTrueExpression start end) scan)
    ((DeltaFalseExpression start end) scan)
    ((DeltaSelfExpression start end) scan)
    ((DeltaNameExpression start end name) scan)
    ((DeltaQualifiedExpression start end owner name argumentsValue) scan)
    ((DeltaFieldExpression start end base member) scan)
    ((DeltaCallExpression start end base callArguments) scan)
    ((DeltaIndexExpression start end base indexValue) scan)
    ((DeltaSliceExpression start end base low high) scan)
    ((DeltaNegateExpression start end operand) scan)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd
      left right) scan)))

(def delta_local_scan_boundary_receiver_application ((source Bytes)
  (expressionValue DeltaExpression) (callBase DeltaExpression)
  (receiver DeltaExpression)
  (memberName DeltaName) (arguments DeltaExpressionList)
  (receiverPlace DeltaOptionalPlaceType) (ownerDeclaration DeltaDeclaration)
  (useValue DeltaExpressionUse) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match ownerDeclaration
    ((DeltaBoundaryDeclaration start end name machines)
      (match (delta_catalog_find_boundary_machine source memberName machines)
        (NoDeltaCatalogBoundaryMember
          (delta_local_scan_propagate_grouped_call_head_result callBase
            (delta_local_scan_field_fact source
              (delta_call_head_core callBase) receiver memberName useValue
              scan)))
        ((OneDeltaCatalogBoundaryMember memberValue)
          (let identityScan
            (delta_local_scan_add_callable_reference expressionValue
              (DeltaResolvedBoundaryMachineCallable ownerDeclaration
                memberValue)
              scan)
            (match receiverPlace
              (NoDeltaPlaceType
                (delta_local_scan_add_candidate InvalidPlace
                  (delta_expression_start receiver) identityScan))
              ((SomeDeltaPlaceType storageType)
                (match memberValue
                  ((DeltaBoundaryMachineSyntax memberStart memberEnd memberNameValue
                    parameters returnType)
                    (delta_local_scan_admitted_signature_application source
                      expressionValue arguments parameters returnType
                      identityScan)))))))))
    ((DeltaDataDeclaration start end name members) scan)
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
      scan)))

(def delta_local_scan_data_receiver_application ((source Bytes)
  (expressionValue DeltaExpression) (callBase DeltaExpression)
  (receiver DeltaExpression) (ownerName DeltaName) (memberName DeltaName)
  (arguments DeltaExpressionList)
  (receiverPlace DeltaOptionalPlaceType) (rows DeltaCatalogDeclarationList)
  (useValue DeltaExpressionUse) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (let memberLookup
    (delta_catalog_find_data_member source ownerName memberName rows)
    (let machineLookup
      (delta_catalog_find_qualified_data_machine source ownerName memberName
        rows)
      (match machineLookup
        ((OneDeltaCatalogDataMachine machineOwner machineDeclaration)
          (let caseCollision
            (match memberLookup
              ((OneDeltaCatalogCase caseOwner caseValue) 1)
              ((OneDeltaCatalogField fieldOwner fieldValue) 0)
              (NoDeltaCatalogDataMember 0))
            ; The census already rejects a case/machine collision. Preserve
            ; that candidate without selecting either callable in later facts.
            (if caseCollision
              scan
              (let identityScan
                (delta_local_scan_add_callable_reference expressionValue
                  (DeltaResolvedDataMachineCallable machineOwner
                    machineDeclaration)
                  scan)
                (match machineDeclaration
                  ((DeltaBoundaryDeclaration start end name machines)
                    identityScan)
                  ((DeltaDataDeclaration start end name members) identityScan)
                  ((DeltaMachineDeclaration start end name inputs returnType
                    bodyValue)
                    (if (delta_machine_inputs_have_receiver inputs)
                      (match receiverPlace
                        (NoDeltaPlaceType
                          (delta_local_scan_add_candidate InvalidPlace
                            (delta_expression_start receiver) identityScan))
                        ((SomeDeltaPlaceType storageType)
                          (delta_local_scan_admitted_signature_application
                            source expressionValue arguments
                            (delta_machine_input_parameters inputs) returnType
                            identityScan)))
                      (delta_local_scan_wrong_qualified_callable_kind
                        expressionValue useValue identityScan))))))))
        (NoDeltaCatalogDataMachine
          (delta_local_scan_propagate_grouped_call_head_result callBase
            (delta_local_scan_field_fact source
              (delta_call_head_core callBase) receiver memberName useValue
              scan)))))))

(def delta_local_scan_receiver_application ((source Bytes)
  (expressionValue DeltaExpression) (callBase DeltaExpression)
  (arguments DeltaExpressionList) (useValue DeltaExpressionUse)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match (delta_call_head_core callBase)
    ((DeltaFieldExpression start end receiver member)
      (match scan
        ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications
          types candidate)
          (match (delta_find_expression_result receiver types)
            (NoDeltaExpressionResult scan)
            ((OneDeltaExpressionResult receiverResult)
              (match receiverResult
                ((DeltaValueExpressionResult receiverType receiverPlace)
                  (match receiverType
                    ((DeltaNamedType typeStart typeEnd ownerName)
                      (match catalog
                        ((DeltaResolutionCatalogSyntax rows)
                          (match (delta_catalog_find_owner source ownerName rows)
                            (NoDeltaCatalogOwner
                              (delta_local_scan_propagate_grouped_call_head_result
                                callBase
                                (delta_local_scan_field_fact source
                                  (delta_call_head_core callBase) receiver member
                                  useValue scan)))
                            ((OneDeltaCatalogBoundaryOwner ownerDeclaration)
                              (delta_local_scan_boundary_receiver_application
                                source expressionValue callBase receiver member
                                arguments receiverPlace ownerDeclaration
                                useValue scan))
                            ((OneDeltaCatalogDataOwner ownerDeclaration shape)
                              (delta_local_scan_data_receiver_application source
                                expressionValue callBase receiver ownerName
                                member arguments receiverPlace rows useValue
                                scan))))))
                    ((DeltaI32Type typeStart typeEnd) scan)
                    ((DeltaU8Type typeStart typeEnd) scan)
                    ((DeltaNeverType typeStart typeEnd) scan)
                    ((DeltaArrayType typeStart typeEnd element lengthValue)
                      scan)
                    ((DeltaViewType typeStart typeEnd element) scan)))
                (DeltaResultlessExpressionResult scan)
                (DeltaNeverExpressionResult scan)))))))
    ((DeltaIntegerExpression start end literal) scan)
    ((DeltaCharacterExpression start end literal) scan)
    ((DeltaStringExpression start end literal) scan)
    ((DeltaTrueExpression start end) scan)
    ((DeltaFalseExpression start end) scan)
    ((DeltaSelfExpression start end) scan)
    ((DeltaNameExpression start end name) scan)
    ((DeltaQualifiedExpression start end owner name argumentsValue) scan)
    ((DeltaGroupedExpression start end inner) scan)
    ((DeltaCallExpression start end base callArguments) scan)
    ((DeltaIndexExpression start end base indexValue) scan)
    ((DeltaSliceExpression start end base low high) scan)
    ((DeltaNegateExpression start end operand) scan)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd
      left right) scan)))

; Statement and continuation syntax may group a complete application. Callable
; custody stays on that exact application rather than being copied onto every
; group wrapper; category consumers normalize through the same group view.
(def delta_find_resolved_callable_reference_normalized
  ((target DeltaExpression) (references DeltaResolvedCallableReferenceList))
  DeltaResolvedCallableReferenceLookup
  (delta_find_resolved_callable_reference (delta_call_head_core target)
    references))

; `(Owner::machine)(args)` and its grouped forms use the authored outer call
; suffix as the machine application. The inner bare qualified spelling retains
; identity only in call-head use; this join moves custody to the exact outer
; application before receiver/static, arity, or argument typing.
(def delta_local_scan_qualified_head_application ((source Bytes)
  (expressionValue DeltaExpression) (callBase DeltaExpression)
  (arguments DeltaExpressionList) (useValue DeltaExpressionUse)
  (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match (delta_call_head_core callBase)
    ((DeltaQualifiedExpression start end owner name argumentsValue)
      (match argumentsValue
        ((SomeDeltaArguments openStart closeEnd innerArguments) scan)
        (NoDeltaArguments
          (match scan
            ((DeltaLocalResolutionScanSyntax catalog references fields
              callables stateApplications types candidate)
              (match (delta_find_resolved_callable_reference
                (delta_call_head_core callBase) callables)
                (NoDeltaResolvedCallableReference scan)
                ((OneDeltaResolvedCallableReference callable)
                  (match callable
                    ((DeltaResolvedDataMachineCallable ownerDeclaration
                      machineDeclaration)
                      (let identityScan
                        (delta_local_scan_add_callable_reference expressionValue
                          callable scan)
                        (match machineDeclaration
                          ((DeltaBoundaryDeclaration machineStart machineEnd
                            machineName machines) identityScan)
                          ((DeltaDataDeclaration machineStart machineEnd
                            machineName members) identityScan)
                          ((DeltaMachineDeclaration machineStart machineEnd
                            machineName inputs returnType bodyValue)
                            (if (delta_machine_inputs_have_receiver inputs)
                              (delta_local_scan_wrong_qualified_callable_kind
                                expressionValue useValue identityScan)
                              (delta_local_scan_admitted_machine_application
                                source expressionValue arguments
                                machineDeclaration identityScan))))))
                    ((DeltaResolvedConstructorCallable constructorOwner
                      caseValue) scan)
                    ((DeltaResolvedUnqualifiedMachineCallable
                      machineDeclaration) scan)
                    ((DeltaResolvedBoundaryMachineCallable boundaryOwner
                      memberValue) scan)))))))))
    ((DeltaIntegerExpression start end literal) scan)
    ((DeltaCharacterExpression start end literal) scan)
    ((DeltaStringExpression start end literal) scan)
    ((DeltaTrueExpression start end) scan)
    ((DeltaFalseExpression start end) scan)
    ((DeltaSelfExpression start end) scan)
    ((DeltaNameExpression start end name) scan)
    ((DeltaGroupedExpression start end inner) scan)
    ((DeltaFieldExpression start end base field) scan)
    ((DeltaCallExpression start end base innerArguments) scan)
    ((DeltaIndexExpression start end base indexValue) scan)
    ((DeltaSliceExpression start end base low high) scan)
    ((DeltaNegateExpression start end operand) scan)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd
      left right) scan)))

(def delta_expression_use_admits_unqualified_machine
  ((useValue DeltaExpressionUse)) Int
  (match useValue
    (DeltaOrdinaryExpressionUse 1)
    (DeltaCallHeadExpressionUse 1)
    ((DeltaPostfixStatementExpressionUse statementStart) 1)
    ; State and unqualified-machine lookup must be joined before either is
    ; admitted for a continuation.
    ((DeltaTransitionContinuationExpressionUse machineValue continuationStart)
      0)))

(def delta_local_scan_unqualified_machine_application ((source Bytes)
  (expressionValue DeltaExpression) (callBase DeltaExpression)
  (arguments DeltaExpressionList) (active DeltaLocalBindingList)
  (pending DeltaLocalBindingList) (useValue DeltaExpressionUse)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (if (delta_expression_use_admits_unqualified_machine useValue)
    (match (delta_call_head_core callBase)
      ((DeltaNameExpression start end name)
        (match scan
          ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications
            types candidate)
            (match catalog
              ((DeltaResolutionCatalogSyntax rows)
                (match (delta_catalog_find_unqualified_machine source name rows)
                  ((OneDeltaCatalogMachine machineDeclaration)
                    (delta_local_scan_admitted_machine_application source
                      expressionValue arguments machineDeclaration
                      (delta_local_scan_add_callable_reference expressionValue
                        (DeltaResolvedUnqualifiedMachineCallable
                          machineDeclaration)
                        scan)))
                  (NoDeltaCatalogMachine
                    (let localScan
                      (delta_resolve_local_value_name source
                        (DeltaNameExpression start end name) name active pending
                        scan)
                      (match localScan
                        ((DeltaLocalResolutionScanSyntax nextCatalog
                          nextReferences nextFields nextCallables
                          nextStateApplications nextTypes nextCandidate)
                          (match (delta_find_expression_result
                            (DeltaNameExpression start end name) nextTypes)
                            (NoDeltaExpressionResult localScan)
                            ((OneDeltaExpressionResult resultValue)
                              (match resultValue
                                ((DeltaValueExpressionResult typeValue
                                  placeType)
                                  (delta_local_scan_add_candidate TypeMismatch
                                    (delta_expression_start expressionValue)
                                    localScan))
                                (DeltaResultlessExpressionResult localScan)
                                (DeltaNeverExpressionResult
                                  localScan))))))))))))))
      ((DeltaGroupedExpression start end inner) scan)
      ((DeltaIntegerExpression start end literal) scan)
      ((DeltaCharacterExpression start end literal) scan)
      ((DeltaStringExpression start end literal) scan)
      ((DeltaTrueExpression start end) scan)
      ((DeltaFalseExpression start end) scan)
      ((DeltaSelfExpression start end) scan)
      ((DeltaQualifiedExpression start end owner name argumentsValue) scan)
      ((DeltaFieldExpression start end base field) scan)
      ((DeltaCallExpression start end base innerArguments) scan)
      ((DeltaIndexExpression start end base indexValue) scan)
      ((DeltaSliceExpression start end base low high) scan)
      ((DeltaNegateExpression start end operand) scan)
      ((DeltaBinaryExpression start end operator operatorStart operatorEnd
        left right) scan))
    scan))

; Explicit transition applications join the current machine's state namespace
; with the global unqualified-machine namespace before either identity is
; admitted. Arity and expected result never disambiguate the collision.
(def delta_local_scan_transition_unqualified_application ((source Bytes)
  (expressionValue DeltaExpression) (callBase DeltaExpression)
  (arguments DeltaExpressionList) (active DeltaLocalBindingList)
  (pending DeltaLocalBindingList) (machineValue DeltaDeclaration)
  (continuationStart Int) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match (delta_call_head_core callBase)
    ((DeltaNameExpression start end name)
      (match scan
        ((DeltaLocalResolutionScanSyntax catalog references fields callables
          stateApplications types candidate)
          (match catalog
            ((DeltaResolutionCatalogSyntax rows)
              (let stateLookup
                (delta_catalog_find_state source machineValue name)
                (let machineLookup
                  (delta_catalog_find_unqualified_machine source name rows)
                  (match stateLookup
                    ((OneDeltaCatalogState stateValue)
                      (match machineLookup
                        ((OneDeltaCatalogMachine targetMachine)
                          (delta_local_scan_add_candidate InvalidControlTarget
                            continuationStart scan))
                        (NoDeltaCatalogMachine
                          (delta_local_scan_admitted_state_application source
                            expressionValue arguments machineValue stateValue
                            scan))))
                    (NoDeltaCatalogState
                      (match machineLookup
                        ((OneDeltaCatalogMachine targetMachine)
                          (delta_local_scan_admitted_machine_application source
                            expressionValue arguments targetMachine
                            (delta_local_scan_add_callable_reference
                              expressionValue
                              (DeltaResolvedUnqualifiedMachineCallable
                                targetMachine)
                              scan)))
                        (NoDeltaCatalogMachine
                          (delta_local_scan_propagate_grouped_call_head_result
                            callBase
                            (delta_resolve_local_value_name source
                              (DeltaNameExpression start end name) name active
                              pending scan)))))))))))))
    ((DeltaIntegerExpression start end literal) scan)
    ((DeltaCharacterExpression start end literal) scan)
    ((DeltaStringExpression start end literal) scan)
    ((DeltaTrueExpression start end) scan)
    ((DeltaFalseExpression start end) scan)
    ((DeltaSelfExpression start end) scan)
    ((DeltaQualifiedExpression start end owner name argumentsValue) scan)
    ((DeltaGroupedExpression start end inner) scan)
    ((DeltaFieldExpression start end base field) scan)
    ((DeltaCallExpression start end base innerArguments) scan)
    ((DeltaIndexExpression start end base indexValue) scan)
    ((DeltaSliceExpression start end base low high) scan)
    ((DeltaNegateExpression start end operand) scan)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd
      left right) scan)))

; The owner queue leaves only a state-only bare spelling undecided. A state/machine
; collision is already invalid, a machine-only spelling is a known but
; unapplied control target, and genuine namespace absence may fall back to a
; local value judgment without inventing a target.
(def delta_local_scan_transition_bare_name ((source Bytes)
  (expressionValue DeltaExpression) (name DeltaName)
  (active DeltaLocalBindingList) (pending DeltaLocalBindingList)
  (machineValue DeltaDeclaration) (continuationStart Int)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      stateApplications types candidate)
      (match catalog
        ((DeltaResolutionCatalogSyntax rows)
          (let stateLookup (delta_catalog_find_state source machineValue name)
            (let machineLookup
              (delta_catalog_find_unqualified_machine source name rows)
              (match stateLookup
                ((OneDeltaCatalogState stateValue)
                  (match machineLookup
                    ((OneDeltaCatalogMachine targetMachine)
                      (delta_local_scan_add_candidate InvalidControlTarget
                        continuationStart scan))
                    ; The pending bare-state ruling decides whether this is a
                    ; zero-argument application.
                    (NoDeltaCatalogMachine scan)))
                (NoDeltaCatalogState
                  (match machineLookup
                    ((OneDeltaCatalogMachine targetMachine)
                      (delta_local_scan_add_candidate InvalidControlTarget
                        continuationStart
                        (delta_local_scan_add_callable_reference expressionValue
                          (DeltaResolvedUnqualifiedMachineCallable targetMachine)
                          scan)))
                    (NoDeltaCatalogMachine
                      (delta_resolve_local_value_name source expressionValue
                        name active pending scan))))))))))))

(def delta_local_scan_transition_result_candidate
  ((expressionValue DeltaExpression) (continuationStart Int)
   (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      stateApplications types candidate)
      (match (delta_find_expression_result expressionValue types)
        ((OneDeltaExpressionResult resultValue)
          (match resultValue
            ((DeltaValueExpressionResult typeValue placeType)
              (delta_local_scan_add_candidate InvalidControlTarget
                continuationStart scan))
            (DeltaResultlessExpressionResult
              (delta_local_scan_add_candidate InvalidControlTarget
                continuationStart scan))
            (DeltaNeverExpressionResult
              (delta_local_scan_add_candidate InvalidTerminal
                (delta_expression_start
                  (delta_call_head_core expressionValue))
                scan))))
        (NoDeltaExpressionResult
          (match expressionValue
            ((DeltaCallExpression start end base arguments)
              (match (delta_find_expression_result base types)
                (NoDeltaExpressionResult scan)
                ((OneDeltaExpressionResult baseResult)
                  (match baseResult
                    ((DeltaValueExpressionResult typeValue placeType)
                      (delta_local_scan_add_candidate InvalidControlTarget
                        continuationStart scan))
                    (DeltaResultlessExpressionResult
                      (delta_local_scan_add_candidate InvalidControlTarget
                        continuationStart scan))
                    (DeltaNeverExpressionResult
                      (delta_local_scan_add_candidate InvalidTerminal
                        (delta_expression_start (delta_call_head_core base))
                        scan))))))
            ((DeltaIntegerExpression start end literal) scan)
            ((DeltaCharacterExpression start end literal) scan)
            ((DeltaStringExpression start end literal) scan)
            ((DeltaTrueExpression start end) scan)
            ((DeltaFalseExpression start end) scan)
            ((DeltaSelfExpression start end) scan)
            ((DeltaNameExpression start end name) scan)
            ((DeltaQualifiedExpression start end owner name argumentsValue)
              scan)
            ((DeltaGroupedExpression start end inner) scan)
            ((DeltaFieldExpression start end base field) scan)
            ((DeltaIndexExpression start end base indexValue) scan)
            ((DeltaSliceExpression start end base low high) scan)
            ((DeltaNegateExpression start end operand) scan)
            ((DeltaBinaryExpression start end operator operatorStart operatorEnd
              left right) scan)))))))

; Identity/category admission is a postpass over the exact continuation. A
; resolved state or applied machine remains admitted even when later premises
; are incomplete; constructors and completed non-control values are rejected
; before any dependent arity/type guess.
(def delta_local_scan_transition_admission
  ((expressionValue DeltaExpression) (continuationStart Int)
   (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      stateApplications types candidate)
      (match (delta_control_find_state_application
        (delta_call_head_core expressionValue) stateApplications)
        ((OneDeltaStateApplicationReference machineValue stateValue progress)
          scan)
        (NoDeltaStateApplicationReference
          (match (delta_find_resolved_callable_reference_normalized
            expressionValue callables)
            ((OneDeltaResolvedCallableReference callable)
              (match callable
                ((DeltaResolvedConstructorCallable ownerDeclaration caseValue)
                  (delta_local_scan_add_candidate InvalidControlTarget
                    continuationStart scan))
                ((DeltaResolvedDataMachineCallable ownerDeclaration
                  machineDeclaration)
                  (if (delta_expression_has_authored_application expressionValue)
                    scan
                    (delta_local_scan_add_candidate InvalidControlTarget
                      continuationStart scan)))
                ((DeltaResolvedUnqualifiedMachineCallable machineDeclaration)
                  (if (delta_expression_has_authored_application expressionValue)
                    scan
                    (delta_local_scan_add_candidate InvalidControlTarget
                      continuationStart scan)))
                ((DeltaResolvedBoundaryMachineCallable ownerDeclaration
                  memberValue)
                  (if (delta_expression_has_authored_application expressionValue)
                    scan
                    (delta_local_scan_add_candidate InvalidControlTarget
                      continuationStart scan)))))
            (NoDeltaResolvedCallableReference
              (delta_local_scan_transition_result_candidate expressionValue
                continuationStart scan))))))))

; A discarded-call statement selects the unqualified machine namespace before
; local fallback even when its authored argument list is missing. Retain the
; known identity and reject the bare spelling at the carried outer statement
; anchor; only genuine machine absence permits ordinary local resolution.
(def delta_resolve_local_postfix_statement_name ((source Bytes)
  (expressionValue DeltaExpression) (name DeltaName)
  (statementStart Int) (active DeltaLocalBindingList)
  (pending DeltaLocalBindingList) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match catalog
        ((DeltaResolutionCatalogSyntax rows)
          (match (delta_catalog_find_unqualified_machine source name rows)
            ((OneDeltaCatalogMachine machineDeclaration)
              (delta_local_scan_add_candidate TypeMismatch
                statementStart
                (delta_local_scan_add_callable_reference expressionValue
                  (DeltaResolvedUnqualifiedMachineCallable machineDeclaration)
                  scan)))
            (NoDeltaCatalogMachine
              (delta_resolve_local_value_name source expressionValue name active
                pending scan))))))))

(def delta_resolve_local_value_name ((source Bytes)
  (expressionValue DeltaExpression) (name DeltaName)
  (active DeltaLocalBindingList) (pending DeltaLocalBindingList)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match (delta_local_find_binding source name active)
    ((OneDeltaLocalBinding bindingValue)
      (let nextScan
        (delta_local_scan_add_reference expressionValue bindingValue scan)
        (match (delta_local_scan_binding_type source bindingValue nextScan)
          (NoDeltaLocalBindingType nextScan)
          ((OneDeltaLocalBindingType typeValue)
            (delta_local_scan_add_value expressionValue
              (delta_storage_read_type expressionValue typeValue)
              (SomeDeltaPlaceType typeValue)
              nextScan)))))
    (NoDeltaLocalBinding
      (match (delta_local_find_binding source name pending)
        ((OneDeltaLocalBinding bindingValue)
          (delta_local_scan_add_candidate UseBeforeInitialization
            (delta_expression_start expressionValue) scan))
        (NoDeltaLocalBinding
          (delta_local_scan_add_candidate UnknownName
            (delta_expression_start expressionValue) scan))))))

(def delta_local_scan_self_fact ((expressionValue DeltaExpression)
  (active DeltaLocalBindingList) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match (delta_local_find_self_binding active)
    (NoDeltaSelfBinding scan)
    ((OneDeltaSelfBinding bindingValue ownerDeclaration)
      (match ownerDeclaration
        ((DeltaBoundaryDeclaration start end name machines) scan)
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          scan)
        ((DeltaDataDeclaration start end ownerName members)
          (let selfType
            (DeltaNamedType (delta_expression_start expressionValue)
              (delta_expression_end expressionValue) ownerName)
            (delta_local_scan_add_value expressionValue selfType
              (SomeDeltaPlaceType selfType)
              (delta_local_scan_add_reference expressionValue bindingValue
                scan))))))))

(def delta_resolve_local_expression_list ((source Bytes)
  (expressions DeltaExpressionList) (active DeltaLocalBindingList)
  (pending DeltaLocalBindingList) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match expressions
    (NoDeltaExpressions scan)
    ((MoreDeltaExpressions item rest)
      (delta_resolve_local_expression_list source rest active pending
        (delta_resolve_local_expression source item active pending scan)))))

(def delta_resolve_local_optional_expression ((source Bytes)
  (expressionValue DeltaOptionalExpression)
  (active DeltaLocalBindingList) (pending DeltaLocalBindingList)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match expressionValue
    (NoDeltaExpression scan)
    ((SomeDeltaExpression item)
      (delta_resolve_local_expression source item active pending scan))))

(def delta_expression_i32_type ((expressionValue DeltaExpression)) DeltaType
  (DeltaI32Type (delta_expression_start expressionValue)
    (delta_expression_end expressionValue)))

(def delta_expression_string_type ((expressionValue DeltaExpression))
  DeltaType
  (DeltaViewType (delta_expression_start expressionValue)
    (delta_expression_end expressionValue)
    (DeltaU8Type (delta_expression_start expressionValue)
      (delta_expression_end expressionValue))))

(def delta_expression_view_type ((expressionValue DeltaExpression)
  (elementType DeltaType)) DeltaType
  (DeltaViewType (delta_expression_start expressionValue)
    (delta_expression_end expressionValue) elementType))

(def delta_name_is_len ((source Bytes) (nameValue DeltaName)) Int
  (match nameValue
    ((DeltaNameSpan start end)
      (delta_span_is_3 source start end 108 101 110))))

(def delta_name_is_as_slice ((source Bytes) (nameValue DeltaName)) Int
  (match nameValue
    ((DeltaNameSpan start end)
      (delta_span_is_8 source start end 97 115 95 115 108 105 99 101))))

(def delta_name_is_contextual_field ((source Bytes) (nameValue DeltaName)) Int
  (if (delta_name_is_len source nameValue)
    1
    (delta_name_is_as_slice source nameValue)))

(def delta_projected_place_type ((basePlace DeltaOptionalPlaceType)
  (storageType DeltaType)) DeltaOptionalPlaceType
  (match basePlace
    (NoDeltaPlaceType NoDeltaPlaceType)
    ((SomeDeltaPlaceType baseStorage)
      (SomeDeltaPlaceType storageType))))

(def delta_local_scan_absent_field_candidate ((source Bytes)
  (expressionValue DeltaExpression) (member DeltaName)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (if (delta_name_is_contextual_field source member)
    (delta_local_scan_add_candidate TypeMismatch
      (delta_expression_start expressionValue) scan)
    (delta_local_scan_add_candidate UnknownName
      (delta_name_start member) scan)))

(def delta_local_scan_known_machine_field_candidate
  ((expressionValue DeltaExpression) (useValue DeltaExpressionUse)
   (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match useValue
    ((DeltaTransitionContinuationExpressionUse machineValue continuationStart)
      (delta_local_scan_add_candidate InvalidControlTarget continuationStart
        scan))
    (DeltaOrdinaryExpressionUse
      (delta_local_scan_add_candidate TypeMismatch
        (delta_expression_start expressionValue) scan))
    (DeltaCallHeadExpressionUse
      (delta_local_scan_add_candidate TypeMismatch
        (delta_expression_start expressionValue) scan))
    ((DeltaPostfixStatementExpressionUse statementStart)
      (delta_local_scan_add_candidate TypeMismatch
        statementStart scan))))

(def delta_local_scan_field_fact ((source Bytes)
  (expressionValue DeltaExpression) (base DeltaExpression)
  (member DeltaName) (useValue DeltaExpressionUse)
  (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (delta_find_expression_result base types)
        (NoDeltaExpressionResult scan)
        ((OneDeltaExpressionResult baseResult)
          (match baseResult
            ((DeltaValueExpressionResult baseType basePlace)
              (match baseType
                ((DeltaI32Type start end)
                  (delta_local_scan_absent_field_candidate source
                    expressionValue member scan))
                ((DeltaU8Type start end)
                  (delta_local_scan_absent_field_candidate source
                    expressionValue member scan))
                ((DeltaNeverType start end)
                  (delta_local_scan_absent_field_candidate source
                    expressionValue member scan))
                ((DeltaNamedType start end ownerName)
                  (match catalog
                    ((DeltaResolutionCatalogSyntax rows)
                      (match (delta_catalog_find_owner source ownerName rows)
                        (NoDeltaCatalogOwner
                          (delta_local_scan_absent_field_candidate source
                            expressionValue member scan))
                        ((OneDeltaCatalogBoundaryOwner ownerDeclaration)
                          (match ownerDeclaration
                            ((DeltaBoundaryDeclaration ownerStart ownerEnd
                              ownerNameValue machines)
                              (match (delta_catalog_find_boundary_machine source
                                member machines)
                                (NoDeltaCatalogBoundaryMember
                                  (delta_local_scan_absent_field_candidate
                                    source expressionValue member scan))
                                ((OneDeltaCatalogBoundaryMember memberValue)
                                  (delta_local_scan_known_machine_field_candidate
                                    expressionValue useValue scan))))
                            ((DeltaDataDeclaration ownerStart ownerEnd
                              ownerNameValue members) scan)
                            ((DeltaMachineDeclaration ownerStart ownerEnd
                              machineName inputs returnType bodyValue) scan)))
                        ((OneDeltaCatalogDataOwner ownerDeclaration shape)
                          (match ownerDeclaration
                            ((DeltaBoundaryDeclaration ownerStart ownerEnd
                              ownerNameValue machines) scan)
                            ((DeltaDataDeclaration ownerStart ownerEnd
                              ownerNameValue members)
                              (let memberLookup
                                (delta_catalog_find_member_in_data source member
                                  ownerDeclaration members)
                                (match memberLookup
                                  ((OneDeltaCatalogField ownerValue fieldValue)
                                    (match fieldValue
                                      ((DeltaFieldMember fieldStart fieldEnd
                                        fieldName fieldType)
                                        (delta_local_scan_add_value
                                          expressionValue
                                          (delta_storage_read_type
                                            expressionValue fieldType)
                                          (delta_projected_place_type basePlace
                                            fieldType)
                                          (delta_local_scan_add_field_reference
                                            expressionValue ownerValue
                                            fieldValue scan)))
                                      ((DeltaCaseMember fieldStart fieldEnd
                                        fieldName payload) scan)))
                                  ((OneDeltaCatalogCase caseOwner caseValue)
                                    (delta_local_scan_add_candidate TypeMismatch
                                      (delta_expression_start expressionValue)
                                      scan))
                                  (NoDeltaCatalogDataMember
                                    (match
                                      (delta_catalog_find_qualified_data_machine
                                        source ownerName member rows)
                                      ((OneDeltaCatalogDataMachine machineOwner
                                        machineDeclaration)
                                        (delta_local_scan_known_machine_field_candidate
                                          expressionValue useValue scan))
                                      (NoDeltaCatalogDataMachine
                                        (delta_local_scan_absent_field_candidate
                                          source expressionValue member
                                          scan)))))))
                            ((DeltaMachineDeclaration ownerStart ownerEnd
                              machineName inputs returnType bodyValue)
                              scan)))))))
                ((DeltaArrayType start end element lengthValue)
                  (if (delta_name_is_len source member)
                    (delta_local_scan_add_value expressionValue
                      (delta_expression_i32_type expressionValue)
                      NoDeltaPlaceType scan)
                    (if (delta_name_is_as_slice source member)
                      (match basePlace
                        (NoDeltaPlaceType
                          (delta_local_scan_add_candidate InvalidPlace
                            (delta_expression_start base) scan))
                        ((SomeDeltaPlaceType storageType)
                          (delta_local_scan_add_value expressionValue
                            (delta_expression_view_type expressionValue element)
                            NoDeltaPlaceType scan)))
                      (delta_local_scan_absent_field_candidate source
                        expressionValue member scan))))
                ((DeltaViewType start end element)
                  (if (delta_name_is_len source member)
                    (delta_local_scan_add_value expressionValue
                      (delta_expression_i32_type expressionValue)
                      NoDeltaPlaceType scan)
                    (if (delta_name_is_as_slice source member)
                      (delta_local_scan_add_candidate TypeMismatch
                        (delta_expression_start expressionValue) scan)
                      (delta_local_scan_absent_field_candidate source
                        expressionValue member scan))))))
            (DeltaResultlessExpressionResult
              (delta_local_scan_add_candidate TypeMismatch
                (delta_expression_start expressionValue) scan))
            (DeltaNeverExpressionResult
              (delta_local_scan_add_candidate InvalidTerminal
                (delta_expression_start (delta_call_head_core base))
                scan))))))))

; Named field-shaped call heads first belong to D36 receiver-machine
; resolution. Every non-named receiver and every complete category failure can
; use the one ordinary field classifier immediately; a positive field result
; is carried through authored groups so the following `()` remains a separate
; call suffix. Named no-machine branches fall back through the same classifier.
(def delta_local_scan_non_named_call_head_field_fact ((source Bytes)
  (callBase DeltaExpression) (useValue DeltaExpressionUse)
  (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match callBase
    ((DeltaGroupedExpression start end inner)
      (match scan
        ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications
          types candidate)
          (match (delta_find_expression_result callBase types)
            ((OneDeltaExpressionResult resultValue) scan)
            (NoDeltaExpressionResult
              (delta_local_scan_propagate_result callBase inner
                (delta_local_scan_non_named_call_head_field_fact source inner
                  useValue scan)))))))
    ((DeltaFieldExpression start end receiver member)
      (match scan
        ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications
          types candidate)
          (match (delta_find_expression_result receiver types)
            (NoDeltaExpressionResult scan)
            ((OneDeltaExpressionResult receiverResult)
              (match receiverResult
                ((DeltaValueExpressionResult receiverType receiverPlace)
                  (match receiverType
                    ((DeltaI32Type typeStart typeEnd)
                      (delta_local_scan_field_fact source callBase receiver
                        member useValue scan))
                    ((DeltaU8Type typeStart typeEnd)
                      (delta_local_scan_field_fact source callBase receiver
                        member useValue scan))
                    ((DeltaNeverType typeStart typeEnd)
                      (delta_local_scan_field_fact source callBase receiver
                        member useValue scan))
                    ((DeltaNamedType typeStart typeEnd name) scan)
                    ((DeltaArrayType typeStart typeEnd element lengthValue)
                      (delta_local_scan_field_fact source callBase receiver
                        member useValue scan))
                    ((DeltaViewType typeStart typeEnd element)
                      (delta_local_scan_field_fact source callBase receiver
                        member useValue scan))))
                (DeltaResultlessExpressionResult
                  (delta_local_scan_field_fact source callBase receiver member
                    useValue scan))
                (DeltaNeverExpressionResult
                  (delta_local_scan_field_fact source callBase receiver member
                    useValue scan))))))))
    ((DeltaIntegerExpression start end literal) scan)
    ((DeltaCharacterExpression start end literal) scan)
    ((DeltaStringExpression start end literal) scan)
    ((DeltaTrueExpression start end) scan)
    ((DeltaFalseExpression start end) scan)
    ((DeltaSelfExpression start end) scan)
    ((DeltaNameExpression start end name) scan)
    ((DeltaQualifiedExpression start end owner name arguments) scan)
    ((DeltaCallExpression start end base arguments) scan)
    ((DeltaIndexExpression start end base indexValue) scan)
    ((DeltaSliceExpression start end base low high) scan)
    ((DeltaNegateExpression start end operand) scan)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd
      left right) scan)))

(def delta_local_scan_reject_value_call ((expressionValue DeltaExpression)
  (base DeltaExpression) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (delta_find_expression_result base types)
        (NoDeltaExpressionResult scan)
        ((OneDeltaExpressionResult resultValue)
          (match resultValue
            ((DeltaValueExpressionResult typeValue placeType)
              (delta_local_scan_add_candidate TypeMismatch
                (delta_expression_start expressionValue) scan))
            (DeltaResultlessExpressionResult
              (delta_local_scan_add_candidate TypeMismatch
                (delta_expression_start expressionValue) scan))
            (DeltaNeverExpressionResult
              (delta_local_scan_add_candidate InvalidTerminal
                (delta_expression_start (delta_call_head_core base))
                scan))))))))

; Resultless and `never` are complete expression categories whose invalid use
; is independent of sibling premises. The relation anchor owns a resultless
; value-use mismatch, while a mispositioned `never` result remains anchored at
; the exact call beneath any grouping. Value-type and place relations stay in
; their enclosing joins and therefore wait for every fact they consume.
(def delta_local_scan_value_use_candidate
  ((expressionValue DeltaExpression) (child DeltaExpression)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (delta_find_expression_result child types)
        (NoDeltaExpressionResult scan)
        ((OneDeltaExpressionResult resultValue)
          (match resultValue
            ((DeltaValueExpressionResult typeValue placeType) scan)
            (DeltaResultlessExpressionResult
              (delta_local_scan_add_candidate TypeMismatch
                (delta_expression_start expressionValue) scan))
            (DeltaNeverExpressionResult
              (delta_local_scan_add_candidate InvalidTerminal
                (delta_expression_start (delta_call_head_core child))
                scan))))))))

(def delta_local_scan_index_fact ((expressionValue DeltaExpression)
  (base DeltaExpression) (indexValue DeltaExpression)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (let categoryScan
    (delta_local_scan_value_use_candidate expressionValue indexValue
      (delta_local_scan_value_use_candidate expressionValue base
        scan))
    (match categoryScan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (delta_find_expression_result base types)
        (NoDeltaExpressionResult categoryScan)
        ((OneDeltaExpressionResult baseResult)
          (match (delta_find_expression_result indexValue types)
            (NoDeltaExpressionResult categoryScan)
            ((OneDeltaExpressionResult indexResult)
              (match baseResult
                ((DeltaValueExpressionResult baseType basePlace)
                  (match indexResult
                    ((DeltaValueExpressionResult indexType indexPlace)
                      (if (delta_type_is_i32 indexType)
                        (match baseType
                          ((DeltaI32Type start end)
                            (delta_local_scan_add_candidate TypeMismatch
                              (delta_expression_start expressionValue)
                              categoryScan))
                          ((DeltaU8Type start end)
                            (delta_local_scan_add_candidate TypeMismatch
                              (delta_expression_start expressionValue)
                              categoryScan))
                          ((DeltaNeverType start end)
                            (delta_local_scan_add_candidate TypeMismatch
                              (delta_expression_start expressionValue)
                              categoryScan))
                          ((DeltaNamedType start end name)
                            (delta_local_scan_add_candidate TypeMismatch
                              (delta_expression_start expressionValue)
                              categoryScan))
                          ((DeltaArrayType start end element lengthValue)
                            (delta_local_scan_add_value expressionValue
                              (delta_storage_read_type expressionValue element)
                              (delta_projected_place_type basePlace element)
                              categoryScan))
                          ((DeltaViewType start end element)
                            (delta_local_scan_add_value expressionValue
                              (delta_storage_read_type expressionValue element)
                              NoDeltaPlaceType categoryScan)))
                        (delta_local_scan_add_candidate TypeMismatch
                          (delta_expression_start expressionValue)
                          categoryScan)))
                    (DeltaResultlessExpressionResult categoryScan)
                    (DeltaNeverExpressionResult categoryScan)))
                (DeltaResultlessExpressionResult categoryScan)
                (DeltaNeverExpressionResult categoryScan))))))))))

(def delta_optional_bound_is_i32 ((bound DeltaOptionalExpression)
  (types DeltaTypedExpressionList)) Int
  (match bound
    (NoDeltaExpression 1)
    ((SomeDeltaExpression expressionValue)
      (match (delta_find_expression_result expressionValue types)
        (NoDeltaExpressionResult 0)
        ((OneDeltaExpressionResult resultValue)
          (match resultValue
            ((DeltaValueExpressionResult typeValue placeType)
              (delta_type_is_i32 typeValue))
            (DeltaResultlessExpressionResult 0)
            (DeltaNeverExpressionResult 0)))))))

(def delta_optional_bound_has_value ((bound DeltaOptionalExpression)
  (types DeltaTypedExpressionList)) Int
  (match bound
    (NoDeltaExpression 1)
    ((SomeDeltaExpression expressionValue)
      (match (delta_find_expression_result expressionValue types)
        (NoDeltaExpressionResult 0)
        ((OneDeltaExpressionResult resultValue)
          (match resultValue
            ((DeltaValueExpressionResult typeValue placeType) 1)
            (DeltaResultlessExpressionResult 0)
            (DeltaNeverExpressionResult 0)))))))

(def delta_local_scan_optional_value_use_candidate
  ((expressionValue DeltaExpression) (bound DeltaOptionalExpression)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match bound
    (NoDeltaExpression scan)
    ((SomeDeltaExpression child)
      (delta_local_scan_value_use_candidate expressionValue child
        scan))))

(def delta_local_scan_slice_fact ((expressionValue DeltaExpression)
  (base DeltaExpression) (low DeltaOptionalExpression)
  (high DeltaOptionalExpression) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (let categoryScan
    (delta_local_scan_optional_value_use_candidate expressionValue
      high
      (delta_local_scan_optional_value_use_candidate
        expressionValue low
        (delta_local_scan_value_use_candidate expressionValue base
          scan)))
    (match categoryScan
      ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
        candidate)
        (match (delta_find_expression_result base types)
          (NoDeltaExpressionResult categoryScan)
          ((OneDeltaExpressionResult baseResult)
            (match baseResult
              ((DeltaValueExpressionResult baseType basePlace)
                (if (delta_optional_bound_has_value low types)
                  (if (delta_optional_bound_has_value high types)
                    (if (delta_optional_bound_is_i32 low types)
                      (if (delta_optional_bound_is_i32 high types)
                        (match baseType
                          ((DeltaI32Type start end)
                            (delta_local_scan_add_candidate TypeMismatch
                              (delta_expression_start expressionValue)
                              categoryScan))
                          ((DeltaU8Type start end)
                            (delta_local_scan_add_candidate TypeMismatch
                              (delta_expression_start expressionValue)
                              categoryScan))
                          ((DeltaNeverType start end)
                            (delta_local_scan_add_candidate TypeMismatch
                              (delta_expression_start expressionValue)
                              categoryScan))
                          ((DeltaNamedType start end name)
                            (delta_local_scan_add_candidate TypeMismatch
                              (delta_expression_start expressionValue)
                              categoryScan))
                          ((DeltaArrayType start end element lengthValue)
                            (delta_local_scan_add_value expressionValue
                              (delta_expression_view_type expressionValue
                                element)
                              NoDeltaPlaceType categoryScan))
                          ((DeltaViewType start end element)
                            (delta_local_scan_add_value expressionValue
                              (delta_expression_view_type expressionValue
                                element)
                              NoDeltaPlaceType categoryScan)))
                        (delta_local_scan_add_candidate TypeMismatch
                          (delta_expression_start expressionValue)
                          categoryScan))
                      (delta_local_scan_add_candidate TypeMismatch
                        (delta_expression_start expressionValue) categoryScan))
                    categoryScan)
                  categoryScan))
              (DeltaResultlessExpressionResult categoryScan)
              (DeltaNeverExpressionResult categoryScan))))))))

(def delta_local_scan_propagate_result ((expressionValue DeltaExpression)
  (child DeltaExpression) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (delta_find_expression_result child types)
        (NoDeltaExpressionResult scan)
        ((OneDeltaExpressionResult resultValue)
          (delta_local_scan_add_result expressionValue resultValue scan))))))

(def delta_local_scan_require_i32 ((expressionValue DeltaExpression)
  (child DeltaExpression) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (let categoryScan
    (delta_local_scan_value_use_candidate expressionValue child scan)
    (match categoryScan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (delta_find_expression_result child types)
        (NoDeltaExpressionResult categoryScan)
        ((OneDeltaExpressionResult resultValue)
          (match resultValue
            ((DeltaValueExpressionResult typeValue placeType)
              (if (delta_type_is_i32 typeValue)
                (delta_local_scan_add_value expressionValue
                  (delta_expression_i32_type expressionValue)
                  NoDeltaPlaceType categoryScan)
                (delta_local_scan_add_candidate TypeMismatch
                  (delta_expression_start expressionValue) categoryScan)))
            (DeltaResultlessExpressionResult categoryScan)
            (DeltaNeverExpressionResult categoryScan))))))))

(def delta_local_scan_binary_i32 ((expressionValue DeltaExpression)
  (left DeltaExpression) (right DeltaExpression)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (let categoryScan
    (delta_local_scan_value_use_candidate expressionValue right
      (delta_local_scan_value_use_candidate expressionValue left scan))
    (match categoryScan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (delta_find_expression_result left types)
        (NoDeltaExpressionResult categoryScan)
        ((OneDeltaExpressionResult leftResult)
          (match (delta_find_expression_result right types)
            (NoDeltaExpressionResult categoryScan)
            ((OneDeltaExpressionResult rightResult)
              (match leftResult
                ((DeltaValueExpressionResult leftType leftPlace)
                  (match rightResult
                    ((DeltaValueExpressionResult rightType rightPlace)
                      (if (delta_type_is_i32 leftType)
                        (if (delta_type_is_i32 rightType)
                          (delta_local_scan_add_value expressionValue
                            (delta_expression_i32_type expressionValue)
                            NoDeltaPlaceType categoryScan)
                          (delta_local_scan_add_candidate TypeMismatch
                            (delta_expression_start expressionValue)
                            categoryScan))
                        (delta_local_scan_add_candidate TypeMismatch
                          (delta_expression_start expressionValue)
                          categoryScan)))
                    (DeltaResultlessExpressionResult categoryScan)
                    (DeltaNeverExpressionResult categoryScan)))
                (DeltaResultlessExpressionResult categoryScan)
                (DeltaNeverExpressionResult categoryScan))))))))))

(def delta_expression_use_resolves_local_value ((useValue DeltaExpressionUse))
  Int
  (match useValue
    (DeltaOrdinaryExpressionUse 1)
    (DeltaCallHeadExpressionUse 0)
    ((DeltaPostfixStatementExpressionUse statementStart) 1)
    ((DeltaTransitionContinuationExpressionUse machineValue continuationStart)
      1)))

; Every nested operand, argument, receiver, index, and bound is an ordinary
; value position. Only the exact outer name/selector retains the grammar-
; selected call, statement, or continuation namespace.
(def delta_resolve_local_expression_context ((source Bytes)
  (expressionValue DeltaExpression) (active DeltaLocalBindingList)
  (pending DeltaLocalBindingList) (scan DeltaLocalResolutionScan)
  (useValue DeltaExpressionUse))
  DeltaLocalResolutionScan
  (match expressionValue
    ((DeltaIntegerExpression start end literal)
      (delta_local_scan_add_value expressionValue
        (delta_expression_i32_type expressionValue) NoDeltaPlaceType scan))
    ((DeltaCharacterExpression start end literal)
      (delta_local_scan_add_value expressionValue
        (delta_expression_i32_type expressionValue) NoDeltaPlaceType scan))
    ((DeltaStringExpression start end literal)
      (delta_local_scan_add_value expressionValue
        (delta_expression_string_type expressionValue) NoDeltaPlaceType scan))
    ((DeltaTrueExpression start end)
      (delta_local_scan_add_value expressionValue
        (delta_expression_i32_type expressionValue) NoDeltaPlaceType scan))
    ((DeltaFalseExpression start end)
      (delta_local_scan_add_value expressionValue
        (delta_expression_i32_type expressionValue) NoDeltaPlaceType scan))
    ((DeltaSelfExpression start end)
      (delta_local_scan_self_fact expressionValue active scan))
    ((DeltaNameExpression start end name)
      (match useValue
        ((DeltaPostfixStatementExpressionUse statementStart)
          (delta_resolve_local_postfix_statement_name source expressionValue
            name statementStart active pending scan))
        (DeltaOrdinaryExpressionUse
          (delta_resolve_local_value_name source expressionValue name active
            pending scan))
        (DeltaCallHeadExpressionUse scan)
        ((DeltaTransitionContinuationExpressionUse machineValue
          continuationStart)
          (delta_local_scan_transition_bare_name source expressionValue name
            active pending machineValue continuationStart scan))))
    ((DeltaQualifiedExpression start end owner name arguments)
      (match arguments
        (NoDeltaArguments
          (delta_local_scan_qualified_callable_fact source expressionValue
            owner name arguments useValue scan))
        ((SomeDeltaArguments openStart closeEnd values)
          (let argumentScan
            (delta_local_scan_argument_terminal_candidates values
              (delta_resolve_local_expression_list source values active pending
                scan))
            (delta_local_scan_qualified_callable_fact source expressionValue
              owner name arguments useValue argumentScan)))))
    ((DeltaGroupedExpression start end inner)
      (delta_local_scan_propagate_result expressionValue inner
        (delta_resolve_local_expression_context source inner active pending
          scan useValue)))
    ((DeltaFieldExpression start end base member)
      (let nextScan
        (delta_resolve_local_expression source base active pending scan)
        (if (delta_expression_use_resolves_local_value useValue)
          (delta_local_scan_field_fact source expressionValue base member
            useValue nextScan)
          nextScan)))
    ((DeltaCallExpression start end base arguments)
      (let childScan
        (delta_resolve_local_expression_list source arguments active pending
          (delta_resolve_local_expression_context source base active pending
            scan DeltaCallHeadExpressionUse))
        (let argumentScan
          (delta_local_scan_argument_terminal_candidates arguments childScan)
          (let contextualScan
            (delta_local_scan_non_named_call_head_field_fact source base
              useValue argumentScan)
          (let receiverScan
            (delta_local_scan_receiver_application source expressionValue base
              arguments useValue contextualScan)
            (let qualifiedScan
              (delta_local_scan_qualified_head_application source
                expressionValue base arguments useValue receiverScan)
              (match useValue
                ((DeltaTransitionContinuationExpressionUse machineValue
                  continuationStart)
                  (delta_local_scan_transition_unqualified_application source
                    expressionValue base arguments active pending machineValue
                    continuationStart qualifiedScan))
                (DeltaOrdinaryExpressionUse
                  (delta_local_scan_unqualified_machine_application source
                    expressionValue base arguments active pending useValue
                    (delta_local_scan_reject_value_call expressionValue base
                      qualifiedScan)))
                (DeltaCallHeadExpressionUse
                  (delta_local_scan_unqualified_machine_application source
                    expressionValue base arguments active pending useValue
                    (delta_local_scan_reject_value_call expressionValue base
                      qualifiedScan)))
                ((DeltaPostfixStatementExpressionUse statementStart)
                  (delta_local_scan_unqualified_machine_application source
                    expressionValue base arguments active pending useValue
                    (delta_local_scan_reject_value_call expressionValue base
                      qualifiedScan))))))))))
    ((DeltaIndexExpression start end base indexValue)
      (delta_local_scan_index_fact expressionValue base indexValue
        (delta_resolve_local_expression source indexValue active pending
          (delta_resolve_local_expression source base active pending scan))))
    ((DeltaSliceExpression start end base low high)
      (delta_local_scan_slice_fact expressionValue base low high
        (delta_resolve_local_optional_expression source high active pending
          (delta_resolve_local_optional_expression source low active pending
            (delta_resolve_local_expression source base active pending
              scan)))))
    ((DeltaNegateExpression start end operand)
      (delta_local_scan_require_i32 expressionValue operand
        (delta_resolve_local_expression source operand active pending scan)))
    ((DeltaBinaryExpression start end operatorValue operatorStart operatorEnd
      left right)
      (delta_local_scan_binary_i32 expressionValue left right
        (delta_resolve_local_expression source right active pending
          (delta_resolve_local_expression source left active pending scan))))))

(def delta_resolve_local_expression ((source Bytes)
  (expressionValue DeltaExpression) (active DeltaLocalBindingList)
  (pending DeltaLocalBindingList) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (delta_resolve_local_expression_context source expressionValue active
    pending scan DeltaOrdinaryExpressionUse))

(def delta_expression_has_authored_application
  ((expressionValue DeltaExpression)) Int
  (match (delta_call_head_core expressionValue)
    ((DeltaQualifiedExpression start end owner name argumentsValue)
      (match argumentsValue
        (NoDeltaArguments 0)
        ((SomeDeltaArguments openStart closeEnd values) 1)))
    ((DeltaCallExpression start end base arguments) 1)
    ((DeltaIntegerExpression start end literal) 0)
    ((DeltaCharacterExpression start end literal) 0)
    ((DeltaStringExpression start end literal) 0)
    ((DeltaTrueExpression start end) 0)
    ((DeltaFalseExpression start end) 0)
    ((DeltaSelfExpression start end) 0)
    ((DeltaNameExpression start end name) 0)
    ((DeltaGroupedExpression start end inner) 0)
    ((DeltaFieldExpression start end base field) 0)
    ((DeltaIndexExpression start end base indexValue) 0)
    ((DeltaSliceExpression start end base low high) 0)
    ((DeltaNegateExpression start end operand) 0)
    ((DeltaBinaryExpression start end operator operatorStart operatorEnd
      left right) 0)))

; A discarded postfix statement admits only an exact resolved machine
; application. Custody plus authored application shape establishes category
; before arity/type completion: a failed admitted machine therefore receives no
; dependent statement mismatch. Successful value/resultless results are
; discardable, and a successful `never` result is retained for later block flow.
(def delta_local_scan_postfix_statement_admission
  ((expressionValue DeltaExpression) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (delta_find_resolved_callable_reference_normalized expressionValue
        callables)
        ((OneDeltaResolvedCallableReference callable)
          (match callable
            ((DeltaResolvedConstructorCallable ownerDeclaration caseValue)
              (delta_local_scan_add_candidate TypeMismatch
                (delta_expression_start expressionValue) scan))
            ((DeltaResolvedDataMachineCallable ownerDeclaration
              machineDeclaration)
              (if (delta_expression_has_authored_application expressionValue)
                scan
                (delta_local_scan_add_candidate TypeMismatch
                  (delta_expression_start expressionValue) scan)))
            ((DeltaResolvedUnqualifiedMachineCallable machineDeclaration)
              (if (delta_expression_has_authored_application expressionValue)
                scan
                (delta_local_scan_add_candidate TypeMismatch
                  (delta_expression_start expressionValue) scan)))
            ((DeltaResolvedBoundaryMachineCallable ownerDeclaration memberValue)
              (if (delta_expression_has_authored_application expressionValue)
                scan
                (delta_local_scan_add_candidate TypeMismatch
                  (delta_expression_start expressionValue) scan)))))
        (NoDeltaResolvedCallableReference
          (match (delta_find_expression_result expressionValue types)
            (NoDeltaExpressionResult scan)
            ((OneDeltaExpressionResult resultValue)
              (match resultValue
                ((DeltaValueExpressionResult typeValue placeType)
                  (delta_local_scan_add_candidate TypeMismatch
                    (delta_expression_start expressionValue) scan))
                (DeltaResultlessExpressionResult scan)
                (DeltaNeverExpressionResult scan)))))))))

(def delta_resolve_local_postfix_statement_expression ((source Bytes)
  (expressionValue DeltaExpression) (active DeltaLocalBindingList)
  (pending DeltaLocalBindingList) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (delta_local_scan_postfix_statement_admission expressionValue
    (delta_resolve_local_expression_context source expressionValue active
      pending scan
        (DeltaPostfixStatementExpressionUse
          (delta_expression_start expressionValue)))))

(def delta_resolve_local_transition_continuation_expression ((source Bytes)
  (expressionValue DeltaExpression) (active DeltaLocalBindingList)
  (machineValue DeltaDeclaration) (continuationStart Int)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (delta_local_scan_transition_admission expressionValue continuationStart
    (delta_resolve_local_expression_context source expressionValue active
      NoDeltaLocalBindings scan
      (DeltaTransitionContinuationExpressionUse machineValue
        continuationStart))))

; A statement value relation first consumes a complete value category, then
; compares its type. Category failures remain independent of the comparison;
; an unresolved child manufactures neither a mismatch nor an error type.
(def delta_local_scan_statement_value_type_relation ((source Bytes)
  (expressionValue DeltaExpression) (expectedType DeltaType)
  (storedEstablishment Int) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (let categoryScan
    (delta_local_scan_value_use_candidate expressionValue expressionValue scan)
    (match categoryScan
      ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
        candidate)
        (match (delta_find_expression_result expressionValue types)
          (NoDeltaExpressionResult categoryScan)
          ((OneDeltaExpressionResult resultValue)
            (match resultValue
              ((DeltaValueExpressionResult actualType placeType)
                (if (delta_argument_value_type_compatible source actualType
                  expectedType storedEstablishment)
                  categoryScan
                  (delta_local_scan_add_candidate TypeMismatch
                    (delta_expression_start expressionValue) categoryScan)))
              (DeltaResultlessExpressionResult categoryScan)
              (DeltaNeverExpressionResult categoryScan))))))))

; Assignment place admission consumes only a complete value result. The
; retained place type is the storage type (not the zero-extended read type),
; which is required for the later assignment value join and `u8` establishment.
(def delta_local_scan_statement_place_relation
  ((placeValue DeltaExpression) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (let categoryScan
    (delta_local_scan_value_use_candidate placeValue placeValue scan)
    (match categoryScan
      ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
        candidate)
        (match (delta_find_expression_result placeValue types)
          (NoDeltaExpressionResult categoryScan)
          ((OneDeltaExpressionResult resultValue)
            (match resultValue
              ((DeltaValueExpressionResult valueType placeType)
                (match placeType
                  (NoDeltaPlaceType
                    (delta_local_scan_add_candidate InvalidPlace
                      (delta_expression_start placeValue) categoryScan))
                  ((SomeDeltaPlaceType storageType) categoryScan)))
              (DeltaResultlessExpressionResult categoryScan)
              (DeltaNeverExpressionResult categoryScan))))))))

; The assignment type relation consumes both a valid left place and a complete
; right value. It therefore cannot derive a second failure from a missing or
; non-place left premise, while the right-side category branch is still kept.
(def delta_local_scan_assignment_relation ((source Bytes)
  (placeValue DeltaExpression) (assignedValue DeltaExpression)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (let categoryScan
    (delta_local_scan_value_use_candidate assignedValue assignedValue
      (delta_local_scan_statement_place_relation placeValue scan))
    (match categoryScan
      ((DeltaLocalResolutionScanSyntax catalog references fields callables stateApplications types
        candidate)
        (match (delta_find_expression_result placeValue types)
          (NoDeltaExpressionResult categoryScan)
          ((OneDeltaExpressionResult placeResult)
            (match placeResult
              ((DeltaValueExpressionResult readType placeType)
                (match placeType
                  (NoDeltaPlaceType categoryScan)
                  ((SomeDeltaPlaceType storageType)
                    (match (delta_find_expression_result assignedValue types)
                      (NoDeltaExpressionResult categoryScan)
                      ((OneDeltaExpressionResult assignedResult)
                        (match assignedResult
                          ((DeltaValueExpressionResult assignedType
                            assignedPlace)
                            (if (delta_argument_value_type_compatible source
                              assignedType storageType 1)
                              categoryScan
                              (delta_local_scan_add_candidate TypeMismatch
                                (delta_expression_start assignedValue)
                                categoryScan)))
                          (DeltaResultlessExpressionResult categoryScan)
                          (DeltaNeverExpressionResult categoryScan)))))))
              (DeltaResultlessExpressionResult categoryScan)
              (DeltaNeverExpressionResult categoryScan))))))))

(def delta_resolve_local_statement_expressions ((source Bytes)
  (statementValue DeltaStatement) (active DeltaLocalBindingList)
  (pending DeltaLocalBindingList) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match statementValue
    ((DeltaLetStatement start end name typeValue initializer)
      (delta_local_scan_statement_value_type_relation source initializer
        typeValue 0
        (delta_resolve_local_expression source initializer active pending
          scan)))
    ((DeltaAssignmentStatement start end placeValue assignedValue)
      (delta_local_scan_assignment_relation source placeValue assignedValue
        (delta_resolve_local_expression source assignedValue active pending
          (delta_resolve_local_expression source placeValue active pending
            scan))))
    ((DeltaPostfixStatement start end expressionValue)
      (delta_resolve_local_postfix_statement_expression source expressionValue
        active pending scan))
    ((DeltaAssertStatement start end expressionValue)
      (delta_local_scan_statement_value_type_relation source expressionValue
        (delta_expression_i32_type expressionValue) 0
        (delta_resolve_local_expression source expressionValue active pending
          scan)))))

(def delta_local_activate_statement ((statementValue DeltaStatement)
  (active DeltaLocalBindingList)) DeltaLocalBindingList
  (match statementValue
    ((DeltaLetStatement start end name typeValue initializer)
      (MoreDeltaLocalBindings
        (DeltaLetLocal name typeValue statementValue) active))
    ((DeltaAssignmentStatement start end placeValue assignedValue) active)
    ((DeltaPostfixStatement start end expressionValue) active)
    ((DeltaAssertStatement start end expressionValue) active)))

(def delta_local_pending_after_statement ((source Bytes)
  (statementValue DeltaStatement) (pending DeltaLocalBindingList))
  DeltaLocalBindingList
  (match statementValue
    ((DeltaLetStatement start end name typeValue initializer)
      (delta_remove_pending_binding source name pending))
    ((DeltaAssignmentStatement start end placeValue assignedValue) pending)
    ((DeltaPostfixStatement start end expressionValue) pending)
    ((DeltaAssertStatement start end expressionValue) pending)))

(def delta_statement_start ((statementValue DeltaStatement)) Int
  (match statementValue
    ((DeltaLetStatement start end name typeValue initializer) start)
    ((DeltaAssignmentStatement start end placeValue assignedValue) start)
    ((DeltaPostfixStatement start end expressionValue) start)
    ((DeltaAssertStatement start end expressionValue) start)))

; Once a successful standalone `never` call ends the ordinary statement
; stream, D37 diagnoses only the first following statement. The stream remains
; traversed so every authored child keeps its independent static candidates.
(def delta_local_scan_statement_after_never
  ((statementValue DeltaStatement) (flow DeltaStatementFlow)
   (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match flow
    (DeltaStatementFlowOpen scan)
    (DeltaStatementFlowEndedByNever
      (delta_local_scan_add_candidate InvalidTerminal
        (delta_statement_start statementValue) scan))
    (DeltaStatementFlowInvalidAfterNever scan)))

(def delta_statement_flow_after ((statementValue DeltaStatement)
  (flow DeltaStatementFlow) (scan DeltaLocalResolutionScan))
  DeltaStatementFlow
  (match flow
    (DeltaStatementFlowEndedByNever DeltaStatementFlowInvalidAfterNever)
    (DeltaStatementFlowInvalidAfterNever DeltaStatementFlowInvalidAfterNever)
    (DeltaStatementFlowOpen
      (match statementValue
        ((DeltaLetStatement start end name typeValue initializer)
          DeltaStatementFlowOpen)
        ((DeltaAssignmentStatement start end placeValue assignedValue)
          DeltaStatementFlowOpen)
        ((DeltaAssertStatement start end expressionValue)
          DeltaStatementFlowOpen)
        ((DeltaPostfixStatement start end expressionValue)
          (match scan
            ((DeltaLocalResolutionScanSyntax catalog references fields
              callables stateApplications types candidate)
              (match (delta_find_expression_result expressionValue types)
                (NoDeltaExpressionResult DeltaStatementFlowOpen)
                ((OneDeltaExpressionResult resultValue)
                  (match resultValue
                    ((DeltaValueExpressionResult typeValue placeType)
                      DeltaStatementFlowOpen)
                    (DeltaResultlessExpressionResult DeltaStatementFlowOpen)
                    (DeltaNeverExpressionResult
                      DeltaStatementFlowEndedByNever)))))))))))

(def delta_resolve_local_statements_with_flow ((source Bytes)
  (statements DeltaStatementList) (active DeltaLocalBindingList)
  (pending DeltaLocalBindingList) (flow DeltaStatementFlow)
  (scan DeltaLocalResolutionScan)) DeltaLocalBlockScan
  (match statements
    (NoDeltaStatements
      (DeltaLocalBlockScanSyntax active pending scan))
    ((MoreDeltaStatements item rest)
      (let candidateScan
        (delta_local_scan_statement_after_never item flow scan)
        (let expressionScan
          (delta_resolve_local_statement_expressions source item active pending
            candidateScan)
          (delta_resolve_local_statements_with_flow source rest
            (delta_local_activate_statement item active)
            (delta_local_pending_after_statement source item pending)
            (delta_statement_flow_after item flow expressionScan)
            expressionScan))))))

(def delta_resolve_local_statements ((source Bytes)
  (statements DeltaStatementList) (active DeltaLocalBindingList)
  (pending DeltaLocalBindingList) (scan DeltaLocalResolutionScan))
  DeltaLocalBlockScan
  (delta_resolve_local_statements_with_flow source statements active pending
    DeltaStatementFlowOpen scan))

; An explicit return is a relation against the enclosing machine signature.
; A resultless machine admits only `return;`. A value-returning machine
; requires an authored value, while a `never` machine admits no normal return;
; either kind's absent value is anchored at `return`. When a value is present,
; the ordinary D37 value-use branch retains resultless/never category failures
; independently before the type join.
(def delta_local_scan_return_relation ((source Bytes) (returnStart Int)
  (expressionValue DeltaOptionalExpression) (returnType DeltaOptionalType)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match returnType
    (NoDeltaType
      (match expressionValue
        (NoDeltaExpression scan)
        ((SomeDeltaExpression item)
          (let categoryScan
            (delta_local_scan_value_use_candidate item item scan)
            (match categoryScan
              ((DeltaLocalResolutionScanSyntax catalog references fields
                callables stateApplications types candidate)
                (match (delta_find_expression_result item types)
                  (NoDeltaExpressionResult categoryScan)
                  ((OneDeltaExpressionResult resultValue)
                    (match resultValue
                      ((DeltaValueExpressionResult actualType placeType)
                        (delta_local_scan_add_candidate TypeMismatch
                          (delta_expression_start item) categoryScan))
                      (DeltaResultlessExpressionResult categoryScan)
                      (DeltaNeverExpressionResult categoryScan))))))))))
    ((SomeDeltaType typeStart typeEnd expectedType)
      (match expressionValue
        (NoDeltaExpression
          (delta_local_scan_add_candidate TypeMismatch returnStart scan))
        ((SomeDeltaExpression item)
          (delta_local_scan_statement_value_type_relation source item
            expectedType 0 scan))))))

(def delta_local_scan_named_transition_subject ((source Bytes)
  (terminalValue DeltaTerminal) (subject DeltaExpression) (name DeltaName)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match catalog
        ((DeltaResolutionCatalogSyntax rows)
          (match (delta_catalog_find_owner source name rows)
            (NoDeltaCatalogOwner scan)
            ((OneDeltaCatalogBoundaryOwner ownerValue)
              (delta_local_scan_add_candidate TypeMismatch
                (delta_expression_start subject) scan))
            ((OneDeltaCatalogDataOwner ownerValue shape)
              (match shape
                (DeltaRecordShape
                  (delta_local_scan_add_candidate TypeMismatch
                    (delta_expression_start subject) scan))
                (DeltaSumShape
                  (delta_local_scan_add_transition_subject terminalValue
                    (DeltaSumTransitionSubject ownerValue) scan))))))))))

(def delta_local_scan_transition_subject ((source Bytes)
  (terminalValue DeltaTerminal) (subject DeltaExpression)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (let categoryScan
    (delta_local_scan_value_use_candidate subject subject scan)
    (match categoryScan
      ((DeltaLocalResolutionScanSyntax catalog references fields callables
        control types candidate)
        (match (delta_find_expression_result subject types)
          (NoDeltaExpressionResult categoryScan)
          ((OneDeltaExpressionResult resultValue)
            (match resultValue
              (DeltaResultlessExpressionResult categoryScan)
              (DeltaNeverExpressionResult categoryScan)
              ((DeltaValueExpressionResult typeValue placeType)
                (match typeValue
                  ((DeltaI32Type start end)
                    (delta_local_scan_add_transition_subject terminalValue
                      DeltaScalarTransitionSubject categoryScan))
                  ((DeltaNamedType start end name)
                    (delta_local_scan_named_transition_subject source
                      terminalValue subject name categoryScan))
                  ((DeltaU8Type start end)
                    (delta_local_scan_add_candidate TypeMismatch
                      (delta_expression_start subject) categoryScan))
                  ((DeltaNeverType start end)
                    (delta_local_scan_add_candidate TypeMismatch
                      (delta_expression_start subject) categoryScan))
                  ((DeltaArrayType start end element lengthValue)
                    (delta_local_scan_add_candidate TypeMismatch
                      (delta_expression_start subject) categoryScan))
                  ((DeltaViewType start end element)
                    (delta_local_scan_add_candidate TypeMismatch
                      (delta_expression_start subject) categoryScan)))))))))))

(def delta_local_scan_scalar_transition_pattern ((terminalValue DeltaTerminal)
  (patternValue DeltaPattern) (selector Int)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match (delta_control_find_transition_subject terminalValue control)
        (NoDeltaTransitionSubjectReference
          (delta_local_scan_add_transition_pattern terminalValue patternValue
            (DeltaScalarPatternSelector selector)
            DeltaTransitionPatternResolved scan))
        ((OneDeltaTransitionSubjectReference subjectKind)
          (match subjectKind
            (DeltaScalarTransitionSubject
              (delta_local_scan_add_transition_pattern terminalValue patternValue
                (DeltaScalarPatternSelector selector)
                DeltaTransitionPatternComplete scan))
            ((DeltaSumTransitionSubject ownerValue)
              (delta_local_scan_add_transition_pattern terminalValue patternValue
                (DeltaScalarPatternSelector selector)
                DeltaTransitionPatternResolved scan))))))))

(def delta_local_scan_wildcard_transition_pattern
  ((terminalValue DeltaTerminal) (patternValue DeltaPattern)
   (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match (delta_control_find_transition_subject terminalValue control)
        (NoDeltaTransitionSubjectReference
          (delta_local_scan_add_transition_pattern terminalValue patternValue
            DeltaTransitionWildcard DeltaTransitionPatternResolved scan))
        ((OneDeltaTransitionSubjectReference subjectKind)
          (delta_local_scan_add_transition_pattern terminalValue patternValue
            DeltaTransitionWildcard DeltaTransitionPatternComplete scan))))))

(def delta_local_scan_resolved_case_transition_pattern ((source Bytes)
  (terminalValue DeltaTerminal) (patternValue DeltaPattern)
  (binder DeltaOptionalBinder) (ownerValue DeltaDeclaration)
  (caseValue DeltaDataMember) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (let kind (DeltaSumCasePattern ownerValue caseValue)
    (if (eq (delta_optional_binder_count binder)
      (delta_parameter_list_count (delta_constructor_parameters caseValue)))
      (match scan
        ((DeltaLocalResolutionScanSyntax catalog references fields callables
          control types candidate)
          (match (delta_control_find_transition_subject terminalValue control)
            (NoDeltaTransitionSubjectReference
              (delta_local_scan_add_transition_pattern terminalValue patternValue kind
                DeltaTransitionPatternResolved scan))
            ((OneDeltaTransitionSubjectReference subjectKind)
              (match subjectKind
                (DeltaScalarTransitionSubject
                  (delta_local_scan_add_transition_pattern terminalValue patternValue kind
                    DeltaTransitionPatternResolved scan))
                ((DeltaSumTransitionSubject subjectOwner)
                  (if (delta_data_declarations_same_identity subjectOwner
                    ownerValue)
                    (delta_local_scan_add_transition_pattern terminalValue patternValue kind
                      DeltaTransitionPatternComplete scan)
                    (delta_local_scan_add_transition_pattern terminalValue patternValue kind
                      DeltaTransitionPatternResolved scan))))))))
      (delta_local_scan_add_transition_pattern terminalValue patternValue kind
        DeltaTransitionPatternResolved scan))))

(def delta_local_scan_case_transition_pattern ((source Bytes)
  (terminalValue DeltaTerminal) (patternValue DeltaPattern)
  (owner DeltaName) (name DeltaName) (binder DeltaOptionalBinder)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match catalog
        ((DeltaResolutionCatalogSyntax rows)
          (match (delta_catalog_find_owner source owner rows)
            (NoDeltaCatalogOwner
              (delta_local_scan_add_candidate UnknownName
                (delta_name_start owner) scan))
            ((OneDeltaCatalogBoundaryOwner ownerValue)
              scan)
            ((OneDeltaCatalogDataOwner ownerValue shape)
              (match shape
                (DeltaRecordShape
                  scan)
                (DeltaSumShape
                  (match (delta_catalog_find_data_member source owner name rows)
                    (NoDeltaCatalogDataMember
                      (delta_local_scan_add_candidate UnknownName
                        (delta_name_start name) scan))
                    ((OneDeltaCatalogField fieldOwner fieldValue)
                      scan)
                    ((OneDeltaCatalogCase caseOwner caseValue)
                      (delta_local_scan_resolved_case_transition_pattern source
                        terminalValue patternValue binder caseOwner caseValue
                        scan))))))))))))

(def delta_local_scan_transition_pattern ((source Bytes)
  (terminalValue DeltaTerminal) (patternValue DeltaPattern)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match patternValue
    ((DeltaIntegerPattern start end literal)
      (delta_local_scan_scalar_transition_pattern terminalValue patternValue
        (delta_integer_literal_value literal) scan))
    ((DeltaTruePattern start end)
      (delta_local_scan_scalar_transition_pattern terminalValue patternValue 1
        scan))
    ((DeltaFalsePattern start end)
      (delta_local_scan_scalar_transition_pattern terminalValue patternValue 0
        scan))
    ((DeltaWildcardPattern start end)
      (delta_local_scan_wildcard_transition_pattern terminalValue patternValue
        scan))
    ((DeltaCasePattern start end owner name binder)
      (delta_local_scan_case_transition_pattern source terminalValue
        patternValue owner name binder scan))))

(def delta_pattern_is_wildcard ((patternValue DeltaPattern)) Int
  (match patternValue
    ((DeltaIntegerPattern start end literal) 0)
    ((DeltaTruePattern start end) 0)
    ((DeltaFalsePattern start end) 0)
    ((DeltaWildcardPattern start end) 1)
    ((DeltaCasePattern start end owner name binder) 0)))

(def delta_arms_have_nonfinal_wildcard ((arms DeltaArmList)) Int
  (match arms
    (NoDeltaArms 0)
    ((MoreDeltaArms item rest)
      (match item
        ((DeltaArmSyntax start end patternValue continuation)
          (if (delta_pattern_is_wildcard patternValue)
            (match rest
              (NoDeltaArms 0)
              ((MoreDeltaArms nextItem nextRest) 1))
            (delta_arms_have_nonfinal_wildcard rest)))))))

(def delta_arms_have_final_wildcard ((arms DeltaArmList)) Int
  (match arms
    (NoDeltaArms 0)
    ((MoreDeltaArms item rest)
      (match rest
        (NoDeltaArms
          (match item
            ((DeltaArmSyntax start end patternValue continuation)
              (delta_pattern_is_wildcard patternValue))))
        ((MoreDeltaArms nextItem nextRest)
          (delta_arms_have_final_wildcard rest))))))

(def delta_arms_have_complete_patterns ((arms DeltaArmList)
  (control DeltaControlReferenceLedger)) Int
  (match arms
    (NoDeltaArms 1)
    ((MoreDeltaArms item rest)
      (match item
        ((DeltaArmSyntax start end patternValue continuation)
          (match (delta_control_find_transition_pattern patternValue control)
            (NoDeltaTransitionPatternReference 0)
            ((OneDeltaTransitionPatternReference kind progress)
              (match progress
                (DeltaTransitionPatternResolved 0)
                (DeltaTransitionPatternComplete
                  (delta_arms_have_complete_patterns rest control))))))))))

(def delta_transition_case_is_covered ((terminalValue DeltaTerminal)
  (ownerValue DeltaDeclaration) (caseValue DeltaDataMember)
  (references DeltaTransitionPatternReferenceList)) Int
  (match references
    (NoDeltaTransitionPatternReferences 0)
    ((MoreDeltaTransitionPatternReferences item rest)
      (match item
        ((DeltaTransitionPatternReferenceSyntax priorTerminal priorPattern
          priorKind priorProgress)
          (if (delta_terminals_same_identity terminalValue priorTerminal)
            (match priorProgress
              (DeltaTransitionPatternResolved
                (delta_transition_case_is_covered terminalValue ownerValue
                  caseValue rest))
              (DeltaTransitionPatternComplete
                (match priorKind
                  ((DeltaScalarPatternSelector value)
                    (delta_transition_case_is_covered terminalValue ownerValue
                      caseValue rest))
                  (DeltaTransitionWildcard
                    (delta_transition_case_is_covered terminalValue ownerValue
                      caseValue rest))
                  ((DeltaSumCasePattern priorOwner priorCase)
                    (if (delta_data_declarations_same_identity ownerValue
                      priorOwner)
                      (if (delta_data_members_same_identity caseValue priorCase)
                        1
                        (delta_transition_case_is_covered terminalValue
                          ownerValue caseValue rest))
                      (delta_transition_case_is_covered terminalValue
                        ownerValue caseValue rest))))))
            (delta_transition_case_is_covered terminalValue ownerValue caseValue
              rest)))))))

(def delta_sum_members_are_covered ((terminalValue DeltaTerminal)
  (ownerValue DeltaDeclaration) (members DeltaDataMemberList)
  (references DeltaTransitionPatternReferenceList)) Int
  (match members
    (NoDeltaDataMembers 1)
    ((MoreDeltaDataMembers item rest)
      (match item
        ((DeltaFieldMember start end name typeValue) 0)
        ((DeltaCaseMember start end name payload)
          (if (delta_transition_case_is_covered terminalValue ownerValue item
            references)
            (delta_sum_members_are_covered terminalValue ownerValue rest
              references)
            0))))))

(def delta_sum_owner_is_covered ((terminalValue DeltaTerminal)
  (ownerValue DeltaDeclaration)
  (references DeltaTransitionPatternReferenceList)) Int
  (match ownerValue
    ((DeltaBoundaryDeclaration start end name machines) 0)
    ((DeltaMachineDeclaration start end name inputs returnType bodyValue) 0)
    ((DeltaDataDeclaration start end name members)
      (delta_sum_members_are_covered terminalValue ownerValue members
        references))))

(def delta_local_scan_transition_coverage ((terminalValue DeltaTerminal)
  (arms DeltaArmList) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match scan
    ((DeltaLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match control
        ((DeltaControlReferenceLedgerSyntax states subjects patterns coverages)
          (match (delta_find_transition_subject_reference terminalValue subjects)
            (NoDeltaTransitionSubjectReference scan)
            ((OneDeltaTransitionSubjectReference subjectKind)
              (match subjectKind
                (DeltaScalarTransitionSubject scan)
                ((DeltaSumTransitionSubject ownerValue)
                  (if (delta_arms_have_complete_patterns arms control)
                    (if (delta_arms_have_nonfinal_wildcard arms)
                      (delta_local_scan_add_transition_coverage terminalValue
                        ownerValue DeltaTransitionCoverageUnresolved scan)
                      (if (delta_arms_have_final_wildcard arms)
                        (delta_local_scan_add_transition_coverage terminalValue
                          ownerValue DeltaTransitionCoverageComplete scan)
                        (if (delta_sum_owner_is_covered terminalValue ownerValue
                          patterns)
                          (delta_local_scan_add_transition_coverage terminalValue
                            ownerValue DeltaTransitionCoverageComplete scan)
                          (delta_local_scan_add_transition_coverage terminalValue
                            ownerValue DeltaTransitionCoverageMissing scan))))
                    (delta_local_scan_add_transition_coverage terminalValue
                      ownerValue DeltaTransitionCoverageUnresolved scan)))))))))))

(def delta_resolve_local_continuation ((source Bytes)
  (continuation DeltaContinuation) (active DeltaLocalBindingList)
  (machineValue DeltaDeclaration) (returnType DeltaOptionalType)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match continuation
    ((DeltaExpressionContinuation start end expressionValue)
      (delta_resolve_local_transition_continuation_expression source
        expressionValue active machineValue start scan))
    ((DeltaReturnContinuation start end expressionValue)
      (delta_local_scan_return_relation source start expressionValue returnType
        (delta_resolve_local_optional_expression source expressionValue active
          NoDeltaLocalBindings scan)))))

(def delta_resolve_local_arms ((source Bytes) (terminalValue DeltaTerminal)
  (arms DeltaArmList) (active DeltaLocalBindingList)
  (machineValue DeltaDeclaration) (returnType DeltaOptionalType)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match arms
    (NoDeltaArms scan)
    ((MoreDeltaArms item rest)
      (match item
        ((DeltaArmSyntax start end patternValue continuation)
          (let patternScan
            (delta_local_scan_transition_pattern source terminalValue
              patternValue scan)
            (delta_resolve_local_arms source terminalValue rest active
              machineValue returnType
              (delta_resolve_local_continuation source continuation
                (delta_add_transition_pattern_bindings patternValue active)
                machineValue returnType patternScan))))))))

(def delta_resolve_local_terminal ((source Bytes)
  (terminalValue DeltaOptionalTerminal) (active DeltaLocalBindingList)
  (machineValue DeltaDeclaration) (returnType DeltaOptionalType)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match terminalValue
    (NoDeltaTerminal scan)
    ((SomeDeltaTerminal terminal)
      (match terminal
        ((DeltaTransitionTerminal start end subject arms)
          (let subjectScan
            (delta_resolve_local_expression source subject active
              NoDeltaLocalBindings scan)
            (let classifiedScan
              (delta_local_scan_transition_subject source terminal subject
                subjectScan)
              (delta_local_scan_transition_coverage terminal arms
                (delta_resolve_local_arms source terminal arms active
                  machineValue returnType classifiedScan)))))
        ((DeltaReturnTerminal start end expressionValue)
          (delta_local_scan_return_relation source start expressionValue
            returnType
            (delta_resolve_local_optional_expression source expressionValue
              active NoDeltaLocalBindings scan)))))))

(def delta_resolve_state_body_locals ((source Bytes)
  (bodyValue DeltaStateBody) (active DeltaLocalBindingList)
  (machineValue DeltaDeclaration) (returnType DeltaOptionalType)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match bodyValue
    ((DeltaStateBodySyntax start end statements terminalValue)
      (match (delta_resolve_local_statements source statements active
        (delta_collect_pending_lets statements NoDeltaLocalBindings) scan)
        ((DeltaLocalBlockScanSyntax finalActive finalPending nextScan)
          (delta_resolve_local_terminal source terminalValue finalActive
            machineValue returnType nextScan))))))

(def delta_resolve_state_locals ((source Bytes) (stateValue DeltaState)
  (machineValue DeltaDeclaration) (machineBindings DeltaLocalBindingList)
  (returnType DeltaOptionalType) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match stateValue
    ((DeltaStateSyntax start end name parameters bodyValue)
      (delta_resolve_state_body_locals source bodyValue
        (delta_add_state_parameter_bindings parameters machineBindings)
        machineValue returnType scan))))

(def delta_resolve_states_locals ((source Bytes) (states DeltaStateList)
  (machineValue DeltaDeclaration) (machineBindings DeltaLocalBindingList)
  (returnType DeltaOptionalType) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match states
    (NoDeltaStates scan)
    ((MoreDeltaStates item rest)
      (delta_resolve_states_locals source rest machineValue machineBindings
        returnType
        (delta_resolve_state_locals source item machineValue machineBindings
          returnType scan)))))

(def delta_resolve_machine_body_locals ((source Bytes)
  (bodyValue DeltaMachineBody) (machineValue DeltaDeclaration)
  (machineBindings DeltaLocalBindingList) (returnType DeltaOptionalType)
  (scan DeltaLocalResolutionScan)) DeltaLocalResolutionScan
  (match bodyValue
    ((DeltaMachineBodySyntax start end statements terminalValue states)
      (match (delta_resolve_local_statements source statements machineBindings
        (delta_collect_pending_lets statements NoDeltaLocalBindings) scan)
        ((DeltaLocalBlockScanSyntax finalActive finalPending nextScan)
          (delta_resolve_states_locals source states machineValue
            machineBindings returnType
            (delta_resolve_local_terminal source terminalValue finalActive
              machineValue returnType nextScan)))))))

(def delta_resolve_catalog_declaration_locals ((source Bytes)
  (row DeltaCatalogDeclaration) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match row
    ((DeltaCatalogBoundaryDeclaration declarationValue) scan)
    ((DeltaCatalogDataDeclaration declarationValue shape) scan)
    ((DeltaCatalogMachineDeclaration declarationValue owner)
      (match declarationValue
        ((DeltaBoundaryDeclaration start end name machines) scan)
        ((DeltaDataDeclaration start end name members) scan)
        ((DeltaMachineDeclaration start end name inputs returnType bodyValue)
          (delta_resolve_machine_body_locals source bodyValue declarationValue
            (delta_add_catalog_machine_self_binding declarationValue owner
              (delta_add_machine_parameter_bindings
                (delta_machine_input_parameters inputs)
                NoDeltaLocalBindings))
            returnType scan))))))

(def delta_resolve_catalog_declarations_locals ((source Bytes)
  (rows DeltaCatalogDeclarationList) (scan DeltaLocalResolutionScan))
  DeltaLocalResolutionScan
  (match rows
    (NoDeltaCatalogDeclarations scan)
    ((MoreDeltaCatalogDeclarations item rest)
      (delta_resolve_catalog_declarations_locals source rest
        (delta_resolve_catalog_declaration_locals source item scan)))))

(def delta_resolve_cataloged_locals ((source Bytes)
  (cataloged DeltaCatalogedProgram)) DeltaLocallyResolvedProgram
  (match cataloged
    ((DeltaCatalogedProgramSyntax formed catalogState)
      (match catalogState
        ((DeltaCatalogStateSyntax catalog candidate)
          (match formed
            ((DeltaFormedProgramSyntax collected shapes valueEdges)
              (match collected
                ((DeltaCollectedProgramSyntax program owners machines)
                  (match program
                    ((DeltaSyntaxProgram start end declarations)
                      (match catalog
                        ((DeltaResolutionCatalogSyntax rows)
                          (match
                            (delta_resolve_catalog_declarations_locals source
                              rows
                              (DeltaLocalResolutionScanSyntax
                                catalog
                                NoDeltaResolvedLocalReferences
                                NoDeltaResolvedFieldReferences
                                NoDeltaResolvedCallableReferences
                                (DeltaControlReferenceLedgerSyntax
                                  NoDeltaStateApplicationReferences
                                  NoDeltaTransitionSubjectReferences
                                  NoDeltaTransitionPatternReferences
                                  NoDeltaTransitionCoverageReferences)
                                NoDeltaTypedExpressions candidate))
                            ((DeltaLocalResolutionScanSyntax finalCatalog
                              references fields callables stateApplications
                              types finalCandidate)
