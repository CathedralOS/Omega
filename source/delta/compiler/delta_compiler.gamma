    DeltaResolvedCallableReferenceList))

(data DeltaResolvedCallableReferenceLookup
  (NoDeltaResolvedCallableReference)
  (OneDeltaResolvedCallableReference DeltaResolvedCallable))

; A state transfer is control identity, not a callable or expression result.
