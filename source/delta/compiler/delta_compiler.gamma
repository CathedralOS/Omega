  (DeltaAlphaJump Int)
  (DeltaAlphaJumpZero Int Int)
  (DeltaAlphaJumpNonzero Int Int)
  (DeltaAlphaJumpLess Int Int Int)
  (DeltaAlphaJumpEqual Int Int Int)
  (DeltaAlphaRead Int)
  (DeltaAlphaWrite Int)
  (DeltaAlphaCall Int)
  (DeltaAlphaReturn))

