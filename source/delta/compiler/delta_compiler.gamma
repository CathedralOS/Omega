                  (DeltaBoundaryMachineListParseRejected reasonValue errorOffset))
                ((DeltaBoundaryMachineParsed machineValue)
                  (delta_parse_boundary_machines source
                    (delta_boundary_machine_end machineValue)
                    (MoreDeltaBoundaryMachines machineValue accumulator)))))
            (delta_boundary_machine_list_reject_at source start)))))))

(def delta_parse_boundary_declaration ((source Bytes)
  (cursor Int)) DeltaDeclarationParseOutcome
  (let declarationStart (delta_token_start source cursor)
    (let traitStart (delta_token_start source
      (delta_token_end source declarationStart))
      (if (eq (delta_token_code source traitStart) 11)
        (let nameStart (delta_token_start source (delta_token_end source traitStart))
          (if (eq (delta_token_code source nameStart) 1)
