(def delta_parse_field_member ((source Bytes) (cursor Int)) DeltaDataMemberParseOutcome
  (let nameStart (delta_token_start source cursor)
    (let nameEnd (delta_token_end source nameStart)
      (let colonStart (delta_token_start source nameEnd)
        (if (eq (delta_token_code source colonStart) 37)
          (delta_finish_field_member source nameStart nameEnd
            (delta_token_end source colonStart))
          (delta_data_member_reject_at source nameEnd))))))

(def delta_finish_case_member ((source Bytes) (caseStart Int)
  (nameStart Int) (nameEnd Int) (payload DeltaOptionalPayload)
  (cursor Int)) DeltaDataMemberParseOutcome
  (let semiStart (delta_token_start source cursor)
    (if (eq (delta_token_code source semiStart) 36)
      (let memberEnd (delta_token_end source semiStart)
        (DeltaDataMemberParsed
          (DeltaCaseMember caseStart memberEnd
            (DeltaNameSpan nameStart nameEnd) payload)))
      (delta_data_member_reject_at source cursor))))

(def delta_parse_case_payload ((source Bytes) (caseStart Int)
  (nameStart Int) (nameEnd Int) (openStart Int)) DeltaDataMemberParseOutcome
  (let parametersOutcome
    (delta_parse_parameters_acc source (delta_token_end source openStart)
      33 NoDeltaParameters)
    (match parametersOutcome
      ((DeltaParameterListParseRejected reasonValue errorOffset)
        (DeltaDataMemberParseRejected reasonValue errorOffset))
      ((DeltaParameterListParsed parameters closeStart)
        (let closeEnd (delta_token_end source closeStart)
          (delta_finish_case_member source caseStart nameStart nameEnd
            (SomeDeltaPayload openStart closeEnd parameters) closeEnd))))))

(def delta_parse_case_member ((source Bytes) (cursor Int)) DeltaDataMemberParseOutcome
  (let caseStart (delta_token_start source cursor)
    (let nameStart (delta_token_start source (delta_token_end source caseStart))
      (if (eq (delta_token_code source nameStart) 1)
        (let nameEnd (delta_token_end source nameStart)
          (let followingStart (delta_token_start source nameEnd)
            (if (eq (delta_token_code source followingStart) 32)
              (delta_parse_case_payload source caseStart nameStart nameEnd
                followingStart)
              (delta_finish_case_member source caseStart nameStart nameEnd
                NoDeltaPayload followingStart))))
        (delta_data_member_reject_at source
          (delta_token_end source caseStart))))))

(def delta_parse_data_member ((source Bytes) (cursor Int)) DeltaDataMemberParseOutcome
  (let memberStart (delta_token_start source cursor)
    (let code (delta_token_code source memberStart)
      (if (eq code 1)
        (delta_parse_field_member source memberStart)
        (if (eq code 13)
          (delta_parse_case_member source memberStart)
          (delta_data_member_reject_at source cursor))))))

(def delta_parse_data_members ((source Bytes) (cursor Int)
  (accumulator DeltaDataMemberList)) DeltaDataMemberListParseOutcome
  (let start (delta_token_start source cursor)
    (let code (delta_token_code source start)
      (if (eq code 0)
        (DeltaDataMemberListParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (DeltaDataMemberListParsed
            (delta_reverse_data_members accumulator NoDeltaDataMembers) start)
          (if (eq code 1)
            (let memberOutcome (delta_parse_data_member source start)
              (match memberOutcome
                ((DeltaDataMemberParseRejected reasonValue errorOffset)
                  (DeltaDataMemberListParseRejected reasonValue errorOffset))
                ((DeltaDataMemberParsed memberValue)
                  (delta_parse_data_members source (delta_data_member_end memberValue)
                    (MoreDeltaDataMembers memberValue accumulator)))))
            (if (eq code 13)
              (let memberOutcome (delta_parse_data_member source start)
