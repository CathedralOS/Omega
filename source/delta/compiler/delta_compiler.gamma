      ((DeltaAlphaInstructionEncoded targetBytes)
        (DeltaAlphaInstructionEncoded
          (bytes_concat (delta_alpha_safe_byte opcode) targetBytes)))
      ((DeltaAlphaInstructionInternal detail)
        (DeltaAlphaInstructionInternal detail)))
    (DeltaAlphaInstructionInternal 58)))

(def delta_alpha_encode_target_2 ((opcode Int) (register Int) (label Int)
  (labels DeltaAlphaTrie) (payloadLength Int)) DeltaAlphaInstructionBytesOutcome
  (if (if (eq opcode 13) 1 (eq opcode 14))
    (if (delta_alpha_register_valid register)
      (match (delta_alpha_resolve_target label labels payloadLength)
        ((DeltaAlphaInstructionEncoded targetBytes)
          (DeltaAlphaInstructionEncoded
            (bytes_concat
              (bytes_concat (delta_alpha_safe_byte opcode)
                (delta_alpha_safe_byte register)) targetBytes)))
        ((DeltaAlphaInstructionInternal detail)
          (DeltaAlphaInstructionInternal detail)))
      (DeltaAlphaInstructionInternal 22))
    (DeltaAlphaInstructionInternal 59)))

(def delta_alpha_encode_target_3 ((opcode Int) (left Int) (right Int)
  (label Int) (labels DeltaAlphaTrie)
  (payloadLength Int)) DeltaAlphaInstructionBytesOutcome
  (if (if (eq opcode 15) 1 (eq opcode 16))
