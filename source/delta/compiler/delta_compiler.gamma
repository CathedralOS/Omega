(def emit_parameters ((open Int)) Int
  (if (eq (read open) 40)
    (let ignored Int (write '(')
      (emit_parameter_items (token_end open)))
    (fail)))

(def emit_parameter_items ((index Int)) Int
  (let item Int (skip index)
    (if (eq (read item) 41)
