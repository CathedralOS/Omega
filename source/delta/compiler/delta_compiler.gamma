; Declaration collection returns the original native syntax value after one
; complete D22/D24 census. Candidates are accumulated rather than returned at
; first traversal sight so source order of the collector cannot choose between
; scoped DuplicateName and InvalidBoundary failures.
(data DeltaCensusCandidate
  (NoDeltaCensusCandidate)
  (DeltaCensusCandidateAt DeltaRejectReason Int))

(data DeltaOwnerKind
  (DeltaBoundaryOwnerKind)
  (DeltaDataOwnerKind))

(data DeltaOwnerRow
  (DeltaOwnerRowSyntax Int DeltaName DeltaOwnerKind))

