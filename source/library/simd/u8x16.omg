use simd.omg as simd;
use {omega}/language/core/packed_integer/packed_integer.omg as packed_integer;

public machine load(source: @[u8; 16]) -> |simd|::Lanes<u8, 16> {
    |simd|::Lanes { values: $source }
}

public machine store(destination: @mutable [u8; 16], value: @|simd|::Lanes<u8, 16>) {
    $destination = value.values;
}

public machine wrapping_add(left: @|simd|::Lanes<u8, 16>, right: @|simd|::Lanes<u8, 16>) -> |simd|::Lanes<u8, 16> {
    let values: [u8; 16] = |packed_integer|::wrapping_add_u8x16(@left.values, @right.values);
    |simd|::Lanes { values: values }
}
