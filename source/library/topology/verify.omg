    machine bind_loop(verify: &mut Verify) {
        transition verify.i < verify.n_bind && verify.i < 16 && verify.ok {
            true -> b_ii(verify)
            _ -> pols(verify)
        }
    }
    machine b_ii(verify: &mut Verify) {
        Verify::ru32(verify);
        transition verify.i < 16 && verify.ok {
            true -> b_ii_w(verify)
            _ -> bad(verify)
        }
    }
    machine b_ii_w(verify: &mut Verify) {
        verify.b_ii[verify.i] = verify.w32 as u64 in Wrapping;
        transition { _ -> b_is(verify) }
    }
    machine b_is(verify: &mut Verify) {
        Verify::ru32(verify);
        transition verify.i < 16 && verify.ok {
            true -> b_is_w(verify)
            _ -> bad(verify)
        }
    }
    machine b_is_w(verify: &mut Verify) {
        verify.b_is[verify.i] = verify.w32 as u64 in Wrapping;
        transition { _ -> b_ei(verify) }
    }
    machine b_ei(verify: &mut Verify) {
        Verify::ru32(verify);
        transition verify.i < 16 && verify.ok {
            true -> b_ei_w(verify)
            _ -> bad(verify)
        }
    }
    machine b_ei_w(verify: &mut Verify) {
        verify.b_ei[verify.i] = verify.w32 as u64 in Wrapping;
        transition { _ -> b_es(verify) }
    }
    machine b_es(verify: &mut Verify) {
        Verify::ru32(verify);
        transition verify.i < 16 && verify.ok {
            true -> b_es_w(verify)
            _ -> bad(verify)
        }
    }
    machine b_es_w(verify: &mut Verify) {
        verify.b_es[verify.i] = verify.w32 as u64 in Wrapping;
        transition { _ -> b_tr(verify) }
    }
    machine b_tr(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> b_tr_cp(verify) }
    }
    machine b_tr_cp(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> b_tr_p(verify)
            _ -> b_ord(verify)
        }
    }
    machine b_tr_p(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 512 && verify.h2 < 32 {
            true -> b_tr_w(verify)
            _ -> bad(verify)
        }
    }
    machine b_tr_w(verify: &mut Verify) {
        verify.b_tr[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> b_tr_cp(verify) }
    }
    // Canonical binding order: the packed (import,export) key must
    // strictly increase — packing is injective at this scale
    // (ii,ei<8; is,es<4096 after the endpoint bound).
    machine b_ord(verify: &mut Verify) {
        transition verify.i < 16 {
            true -> b_ord_rd(verify)
            _ -> bad(verify)
        }
    }
    machine b_ord_rd(verify: &mut Verify) {
        verify.je = ((verify.b_ii[verify.i] * 65536 + verify.b_is[verify.i]) * 65536 + verify.b_ei[verify.i]) * 65536 + verify.b_es[verify.i];
        transition verify.i == 0 || verify.je > verify.jd {
            true -> b_ord_w(verify)
            _ -> bad(verify)
        }
    }
    machine b_ord_w(verify: &mut Verify) {
        verify.jd = verify.je;
        transition { _ -> bind_next(verify) }
    }
    machine bind_next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> bind_loop(verify) }
    }
    machine pols(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.p_npol = verify.w32 as u64 in Wrapping;
        transition verify.p_npol <= 8 && verify.ok {
            true -> pol_init(verify)
            _ -> bad(verify)
        }
    }
    machine pol_init(verify: &mut Verify) {
        verify.cp = 0;
        transition { _ -> pol_loop(verify) }
    }
    machine pol_loop(verify: &mut Verify) {
        transition verify.cp < verify.p_npol && verify.cp < 8 && verify.ok {
            true -> q_ver_r(verify)
            _ -> fin(verify)
        }
    }
    machine q_ver_r(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> q_ver_cp(verify) }
