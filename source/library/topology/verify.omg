    machine q_ver_cp(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> q_ver_p(verify)
            _ -> q_tag_r(verify)
        }
    }
    machine q_ver_p(verify: &mut Verify) {
        verify.h1 = verify.cp * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 256 && verify.h2 < 32 {
            true -> q_ver_w(verify)
            _ -> bad(verify)
        }
    }
    machine q_ver_w(verify: &mut Verify) {
        verify.q_ver[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> q_ver_cp(verify) }
    }
    machine q_tag_r(verify: &mut Verify) {
        Verify::rd(verify);
        transition verify.ok && verify.cp < 8 {
            true -> q_tag_set(verify)
            _ -> bad(verify)
        }
    }
    machine q_tag_set(verify: &mut Verify) {
        transition verify.b8 == 1 || verify.b8 == 2 {
            true -> q_tag_w(verify)
            _ -> bad(verify)
        }
    }
    machine q_tag_w(verify: &mut Verify) {
        verify.q_tag[verify.cp] = verify.b8;
        transition { _ -> q_s_r(verify) }
    }
    machine q_s_r(verify: &mut Verify) {
        Verify::rd_pselector(verify);
        transition verify.ok && verify.cp < 8 {
            true -> q_s_set(verify)
            _ -> bad(verify)
        }
    }
    machine q_s_set(verify: &mut Verify) {
        verify.q_s[verify.cp] = verify.sel_mask;
        verify.q_sn[verify.cp] = verify.sel_n;
        verify.k = 0;
        transition { _ -> q_s_cp(verify) }
    }
    machine q_s_cp(verify: &mut Verify) {
        transition verify.k < verify.sel_n && verify.k < 8 {
            true -> q_s_cp_one(verify)
            _ -> q_t_r(verify)
        }
    }
    machine q_s_cp_one(verify: &mut Verify) {
        verify.h0 = verify.cp * 8 + verify.k;
        verify.h1 = verify.k;
        transition verify.h0 < 64 && verify.h1 < 8 {
            true -> q_s_cp_w(verify)
            _ -> bad(verify)
        }
    }
    machine q_s_cp_w(verify: &mut Verify) {
        verify.q_slist[verify.h0] = verify.sel_list[verify.h1];
        verify.k = verify.k + 1;
        transition { _ -> q_s_cp(verify) }
    }
    machine q_t_r(verify: &mut Verify) {
        Verify::rd_pselector(verify);
        transition verify.ok && verify.cp < 8 {
            true -> q_t_set(verify)
            _ -> bad(verify)
        }
    }
    machine q_t_set(verify: &mut Verify) {
        verify.q_t[verify.cp] = verify.sel_mask;
        verify.q_tn[verify.cp] = verify.sel_n;
        verify.k = 0;
        transition { _ -> q_t_cp(verify) }
    }
    machine q_t_cp(verify: &mut Verify) {
        transition verify.k < verify.sel_n && verify.k < 8 {
            true -> q_t_cp_one(verify)
            _ -> q_v_r(verify)
        }
    }
    machine q_t_cp_one(verify: &mut Verify) {
        verify.h0 = verify.cp * 8 + verify.k;
        verify.h1 = verify.k;
        transition verify.h0 < 64 && verify.h1 < 8 {
            true -> q_t_cp_w(verify)
            _ -> bad(verify)
        }
    }
    machine q_t_cp_w(verify: &mut Verify) {
        verify.q_tlist[verify.h0] = verify.sel_list[verify.h1];
        verify.k = verify.k + 1;
        transition { _ -> q_t_cp(verify) }
    }
    machine q_v_r(verify: &mut Verify) {
        Verify::rd_pselector(verify);
        transition verify.ok && verify.cp < 8 {
            true -> q_v_set(verify)
            _ -> bad(verify)
        }
    }
    machine q_v_set(verify: &mut Verify) {
        verify.q_v[verify.cp] = verify.sel_mask;
        verify.q_vn[verify.cp] = verify.sel_n;
        verify.k = 0;
        transition { _ -> q_v_cp(verify) }
    }
    machine q_v_cp(verify: &mut Verify) {
        transition verify.k < verify.sel_n && verify.k < 8 {
            true -> q_v_cp_one(verify)
            _ -> q_out_r(verify)
        }
    }
    machine q_v_cp_one(verify: &mut Verify) {
        verify.h0 = verify.cp * 8 + verify.k;
        verify.h1 = verify.k;
        transition verify.h0 < 64 && verify.h1 < 8 {
            true -> q_v_cp_w(verify)
            _ -> bad(verify)
        }
    }
    machine q_v_cp_w(verify: &mut Verify) {
        verify.q_vlist[verify.h0] = verify.sel_list[verify.h1];
        verify.k = verify.k + 1;
        transition { _ -> q_v_cp(verify) }
    }
    // outcome: 1 Satisfied {certificate} / 2 Violated {violation}.
    // Satisfied: NoRoute → {u32 n, sorted u32 reachable}; OnlyVia →
    // {u32 path_n, ordered path} then {u32 n, sorted reachable}.
    // Violated: 1 Bypass{u32 n, ordered path} / 2 Disconnected{}.
    machine q_out_r(verify: &mut Verify) {
        Verify::rd(verify);
        transition verify.ok && verify.cp < 8 && (verify.b8 == 1 || verify.b8 == 2) {
            true -> q_out_set(verify)
            _ -> bad(verify)
        }
    }
    machine q_out_set(verify: &mut Verify) {
        verify.q_out[verify.cp] = verify.b8;
        transition verify.b8 == 1 {
            true -> q_sat(verify)
            _ -> q_vio(verify)
        }
    }
    machine q_sat(verify: &mut Verify) {
        transition verify.q_tag[verify.cp] == 1 {
            true -> q_reach_r(verify)
            _ -> q_path_r(verify)
        }
    }
    // OnlyVia certificate: path first, then reachable.
    machine q_path_r(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.t64 = verify.w32 as u64 in Wrapping;
        verify.q_path_n[verify.cp] = verify.t64;
        transition verify.t64 > 0 && verify.t64 <= 8 && verify.cp < 8 && verify.ok {
            true -> q_path_init(verify)
            _ -> bad(verify)
        }
    }
    machine q_path_init(verify: &mut Verify) {
        verify.k = 0;
        transition { _ -> q_path_loop(verify) }
    }
    machine q_path_loop(verify: &mut Verify) {
        transition verify.k < verify.t64 && verify.k < 8 && verify.ok {
            true -> q_path_one(verify)
            _ -> q_reach_r(verify)
        }
    }
    machine q_path_one(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.h0 = verify.cp * 8 + verify.k;
        verify.d0 = verify.w32 as u64 in Wrapping;
        transition verify.h0 < 64 && verify.d0 < 8 && verify.ok {
            true -> q_path_w(verify)
            _ -> bad(verify)
        }
    }
    machine q_path_w(verify: &mut Verify) {
        verify.q_path[verify.h0] = verify.d0;
        verify.k = verify.k + 1;
        transition { _ -> q_path_loop(verify) }
    }
    machine q_reach_r(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.t64 = verify.w32 as u64 in Wrapping;
        transition verify.t64 <= 8 && verify.cp < 8 && verify.ok {
            true -> q_reach_w0(verify)
            _ -> bad(verify)
        }
    }
    machine q_reach_w0(verify: &mut Verify) {
        verify.q_reach[verify.cp] = 0;
        transition { _ -> q_reach_init(verify) }
    }
    machine q_reach_init(verify: &mut Verify) {
        verify.k = 0;
        verify.sel_prev = 0;
        transition { _ -> q_reach_loop(verify) }
    }
    machine q_reach_loop(verify: &mut Verify) {
        transition verify.k < verify.t64 && verify.k < 8 && verify.ok {
            true -> q_reach_one(verify)
            _ -> q_next(verify)
        }
    }
    machine q_reach_one(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.d0 = verify.w32 as u64 in Wrapping;
        transition verify.d0 < 8 && verify.ok {
            true -> q_reach_ord(verify)
            _ -> bad(verify)
        }
    }
    // Certificate sets arrive sorted (canonical) — strictly increasing.
    machine q_reach_ord(verify: &mut Verify) {
        transition verify.k == 0 || verify.d0 > verify.sel_prev {
            true -> q_reach_w(verify)
            _ -> bad(verify)
        }
    }
    machine q_reach_w(verify: &mut Verify) {
        transition verify.cp < 8 {
            true -> q_reach_w2(verify)
            _ -> bad(verify)
        }
    }
    machine q_reach_w2(verify: &mut Verify) {
        verify.sel_prev = verify.d0;
        verify.q_reach[verify.cp] = verify.q_reach[verify.cp] | ((1 as u64 in Wrapping) << verify.d0);
        verify.k = verify.k + 1;
        transition { _ -> q_reach_loop(verify) }
    }
    machine q_vio(verify: &mut Verify) {
        Verify::rd(verify);
        transition verify.ok && (verify.b8 == 1 || verify.b8 == 2) {
            true -> q_vio_tag(verify)
            _ -> bad(verify)
        }
    }
    machine q_vio_tag(verify: &mut Verify) {
        transition verify.b8 == 1 {
            true -> q_byp_r(verify)
            _ -> q_next(verify)
        }
    }
    // Bypass witness: ordered vertex list — bounded decode, kept so the
    // row stays well-formed input.
    machine q_byp_r(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.t64 = verify.w32 as u64 in Wrapping;
        transition verify.t64 <= 8 && verify.ok {
            true -> q_byp_init(verify)
            _ -> bad(verify)
        }
    }
    machine q_byp_init(verify: &mut Verify) {
        verify.k = 0;
        transition { _ -> q_byp_loop(verify) }
    }
    machine q_byp_loop(verify: &mut Verify) {
        transition verify.k < verify.t64 && verify.k < 8 && verify.ok {
            true -> q_byp_one(verify)
            _ -> q_next(verify)
        }
    }
    machine q_byp_one(verify: &mut Verify) {
        Verify::ru32(verify);
        transition verify.ok {
            true -> q_byp_next(verify)
            _ -> bad(verify)
        }
    }
    machine q_byp_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> q_byp_loop(verify) }
    }
    machine q_next(verify: &mut Verify) {
        verify.cp = verify.cp + 1;
        transition { _ -> pol_loop(verify) }
    }
    machine fin(verify: &mut Verify) {
        transition verify.pq == verify.plan_n && verify.ok {
            true -> done(verify)
            _ -> bad(verify)
        }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- compare helpers ----------------------------------------------------------

// 32-byte equality between stored array `cb` at index `a` and `ident` —
// `d0` = 1 equal / 0 different. (cmp_ident compares two stored rows;
// this compares a stored row against the just-read `ident`.)
machine Verify::id_eq(verify: &mut Verify, a: u64 in Wrapping) {
    verify.j = 0;
    verify.d0 = 1;
    verify.ja = a;
    transition { _ -> loop_s(verify) }

    machine loop_s(verify: &mut Verify) {
        transition verify.j < 32 && verify.d0 == 1 {
            true -> offs(verify)
            _ -> done(verify)
        }
    }
    machine offs(verify: &mut Verify) {
        verify.h0 = verify.ja * 32 + verify.j;
        verify.h1 = verify.j;
        transition verify.h0 < 2048 && verify.h1 < 32 {
            true -> load(verify)
            _ -> bad(verify)
        }
    }
    machine load(verify: &mut Verify) {
        transition verify.cb == 0 {
            true -> s0(verify)
            _ -> c1(verify)
        }
    }
    machine s0(verify: &mut Verify) {
        verify.w8 = verify.subjects[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine c1(verify: &mut Verify) {
        transition verify.cb == 1 {
            true -> s1(verify)
            _ -> c2(verify)
        }
    }
    machine s1(verify: &mut Verify) {
        verify.w8 = verify.p_subjects[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine c2(verify: &mut Verify) {
        transition verify.cb == 2 {
            true -> s2(verify)
            _ -> c3(verify)
        }
    }
    machine s2(verify: &mut Verify) {
        verify.w8 = verify.p_profile[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine c3(verify: &mut Verify) {
        transition verify.cb == 3 {
            true -> s3(verify)
            _ -> c4(verify)
        }
    }
    machine s3(verify: &mut Verify) {
        verify.w8 = verify.p_closure[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine c4(verify: &mut Verify) {
        transition verify.cb == 4 {
            true -> s4(verify)
            _ -> c5(verify)
        }
    }
    machine s4(verify: &mut Verify) {
        verify.w8 = verify.p_asm[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine c5(verify: &mut Verify) {
        transition verify.cb == 5 {
            true -> s5(verify)
            _ -> c6(verify)
        }
    }
    machine s5(verify: &mut Verify) {
        verify.w8 = verify.c_subj[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine c6(verify: &mut Verify) {
        transition verify.cb == 9 {
            true -> s9(verify)
            _ -> c7(verify)
        }
    }
    machine s9(verify: &mut Verify) {
        verify.w8 = verify.transports[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine c7(verify: &mut Verify) {
        transition verify.cb == 10 {
            true -> s10(verify)
            _ -> c8(verify)
        }
    }
    machine s10(verify: &mut Verify) {
        verify.w8 = verify.accepted[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine c8(verify: &mut Verify) {
        transition verify.cb == 11 {
            true -> s11(verify)
            _ -> c9(verify)
        }
    }
    machine s11(verify: &mut Verify) {
        verify.w8 = verify.verifier[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine c9(verify: &mut Verify) {
        transition verify.cb == 13 {
            true -> s13(verify)
            _ -> c10(verify)
        }
    }
    machine s13(verify: &mut Verify) {
        verify.w8 = verify.q_ver[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine c10(verify: &mut Verify) {
        transition verify.cb == 14 {
            true -> s14(verify)
            _ -> bad(verify)
        }
    }
    machine s14(verify: &mut Verify) {
        verify.w8 = verify.b_tr[verify.h0];
        verify.b8 = verify.ident[verify.h1];
        transition { _ -> cmp(verify) }
    }
    machine cmp(verify: &mut Verify) {
        transition verify.w8 == verify.b8 {
            true -> eq(verify)
            _ -> ne(verify)
        }
    }
    machine eq(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> loop_s(verify) }
    }
    machine ne(verify: &mut Verify) {
        verify.d0 = 0;
        transition { _ -> done(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Membership: does stored array `cb` (n entries of 32 bytes starting at
// field offset `base`... no — the stored arrays are per-record blocks)
// contain `ident`? Scans `verify.m` entries of the selected table;
// `d0` = 1 found / 0 absent, `d1` = the matching index when found.
machine Verify::id_member(verify: &mut Verify, n: u64 in Wrapping) {
    verify.m = 0;
    verify.d0 = 0;
    verify.d1 = 255;
    verify.jb = n;
    transition { _ -> loop_s(verify) }

    machine loop_s(verify: &mut Verify) {
        transition verify.m < verify.jb && verify.m < 32 && verify.d0 == 0 {
            true -> one(verify)
            _ -> done(verify)
        }
    }
    machine one(verify: &mut Verify) {
        Verify::id_eq(verify, verify.m);
        transition verify.d0 == 1 {
            true -> hit(verify)
            _ -> next(verify)
        }
    }
    machine hit(verify: &mut Verify) {
        verify.d1 = verify.m;
        transition { _ -> done(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.m = verify.m + 1;
        transition { _ -> loop_s(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- request commitment ------------------------------------------------------
// SHA-256 over the staged request bytes, compared against the plan's
// recorded request_commitment — a stale or correctly-formed-but-superseded
// request rejects (verdict 4).
machine Verify::check_commitment(verify: &mut Verify) {
    verify.i = 0;
    transition { _ -> copy_loop(verify) }

    machine copy_loop(verify: &mut Verify) {
        transition verify.i < verify.req_n && verify.i < 8192 {
            true -> copy_one(verify)
            _ -> hash(verify)
        }
    }
    machine copy_one(verify: &mut Verify) {
        verify.h0 = verify.i;
        transition verify.h0 < 8192 {
            true -> copy_w(verify)
            _ -> bad(verify)
        }
    }
    machine copy_w(verify: &mut Verify) {
        verify.dig.msg[verify.h0] = verify.req[verify.h0];
        verify.i = verify.i + 1;
        transition { _ -> copy_loop(verify) }
    }
    machine hash(verify: &mut Verify) {
        verify.dig.msg_n = verify.req_n;
        verify.dig.digest();
        transition { _ -> compare(verify) }
    }
    machine compare(verify: &mut Verify) {
        verify.j = 0;
        transition { _ -> cmp_loop(verify) }
    }
    machine cmp_loop(verify: &mut Verify) {
        transition verify.j < 32 && verify.ok {
            true -> cmp_one(verify)
            _ -> done(verify)
        }
    }
    machine cmp_one(verify: &mut Verify) {
        verify.h0 = verify.j;
        transition verify.h0 < 32 {
            true -> cmp_w(verify)
            _ -> bad(verify)
        }
    }
    machine cmp_w(verify: &mut Verify) {
        transition verify.dig.out32[verify.h0] == verify.p_commit[verify.h0] {
            true -> cmp_next(verify)
            _ -> stale(verify)
        }
    }
    machine cmp_next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> cmp_loop(verify) }
    }
    machine stale(verify: &mut Verify) {
        verify.verdict = 4;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- roster exact match --------------------------------------------------------
// Same count, same names, same subjects — an added, renamed, removed, or
// code-swapped instance mismatches here (verdict 5).
machine Verify::check_roster(verify: &mut Verify) {
    transition verify.p_n == verify.n_inst {
        true -> init(verify)
        _ -> bad(verify)
    }
    machine init(verify: &mut Verify) {
        verify.i = 0;
        transition { _ -> loop_s(verify) }
    }
    machine loop_s(verify: &mut Verify) {
        transition verify.i < verify.n_inst && verify.i < 8 && verify.ok {
            true -> one(verify)
            _ -> done(verify)
        }
    }
    machine one(verify: &mut Verify) {
        transition verify.name_len[verify.i] == verify.p_name_len[verify.i] {
            true -> name_init(verify)
            _ -> bad(verify)
        }
    }
    machine name_init(verify: &mut Verify) {
        verify.j = 0;
        transition { _ -> name_loop(verify) }
    }
    machine name_loop(verify: &mut Verify) {
        transition verify.i < 8 {
            true -> name_bound(verify)
            _ -> bad(verify)
        }
    }
    machine name_bound(verify: &mut Verify) {
        transition verify.j < verify.name_len[verify.i] && verify.j < 128 && verify.ok {
            true -> name_one(verify)
            _ -> subj_init(verify)
        }
    }
    machine name_one(verify: &mut Verify) {
        verify.h0 = verify.i * 128 + verify.j;
        transition verify.h0 < 1024 {
            true -> name_cmp(verify)
            _ -> bad(verify)
        }
    }
    machine name_cmp(verify: &mut Verify) {
        transition verify.names[verify.h0] == verify.p_names[verify.h0] {
            true -> name_next(verify)
            _ -> bad(verify)
        }
    }
    machine name_next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> name_loop(verify) }
    }
    machine subj_init(verify: &mut Verify) {
        verify.j = 0;
        transition { _ -> subj_loop(verify) }
    }
    machine subj_loop(verify: &mut Verify) {
        transition verify.j < 32 && verify.ok {
            true -> subj_one(verify)
            _ -> next(verify)
        }
    }
    machine subj_one(verify: &mut Verify) {
        verify.h0 = verify.i * 32 + verify.j;
        transition verify.h0 < 256 {
            true -> subj_cmp(verify)
            _ -> bad(verify)
        }
    }
    machine subj_cmp(verify: &mut Verify) {
        transition verify.subjects[verify.h0] == verify.p_subjects[verify.h0] {
            true -> subj_next(verify)
            _ -> bad(verify)
        }
    }
    machine subj_next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> subj_loop(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> loop_s(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        verify.verdict = 5;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}


// ---- component admission binding ----------------------------------------------
// Stage plan-subject[i] into `ident` and scan the admitted component
// table — `d1` = matching component index or 255.
machine Verify::find_component(verify: &mut Verify) {
    verify.j = 0;
    transition { _ -> cp_loop(verify) }
    machine cp_loop(verify: &mut Verify) {
        transition verify.j < 32 {
            true -> cp_one(verify)
            _ -> scan(verify)
        }
    }
    machine cp_one(verify: &mut Verify) {
        verify.h0 = verify.i * 32 + verify.j;
        verify.h1 = verify.j;
        transition verify.h0 < 256 && verify.h1 < 32 {
            true -> cp_w(verify)
            _ -> bad(verify)
        }
    }
    machine cp_w(verify: &mut Verify) {
        verify.ident[verify.h1] = verify.p_subjects[verify.h0];
        verify.j = verify.j + 1;
        transition { _ -> cp_loop(verify) }
    }
    machine scan(verify: &mut Verify) {
        verify.cb = 5;
        Verify::id_member(verify, verify.n_comp);
        transition { _ -> done(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Per-instance binding: a Component instance must bind an admitted
// component with identical profile, closure, assumptions and endpoints
// (a forged or mismatched record rejects); an External instance must
// NOT alias an admitted subject (substitution rejects).
machine Verify::check_admissions(verify: &mut Verify) {
    verify.i = 0;
    transition { _ -> loop_s(verify) }
    machine loop_s(verify: &mut Verify) {
        transition verify.i < verify.p_n && verify.i < 8 && verify.ok {
            true -> role_ck(verify)
            _ -> done(verify)
        }
    }
    machine role_ck(verify: &mut Verify) {
        transition verify.p_role[verify.i] == 1 {
            true -> ext(verify)
            _ -> comp(verify)
        }
    }
    // External subject must not appear among admitted components.
    machine ext(verify: &mut Verify) {
        Verify::find_component(verify);
        transition verify.d1 == 255 && verify.ok {
            true -> next(verify)
            _ -> ext_bad(verify)
        }
    }
    machine ext_bad(verify: &mut Verify) {
        verify.verdict = 8;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine comp(verify: &mut Verify) {
        Verify::find_component(verify);
        transition verify.d1 != 255 && verify.ok {
            true -> prof_ck(verify)
            _ -> miss(verify)
        }
    }
    machine miss(verify: &mut Verify) {
        verify.verdict = 7;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    // The bound component's facts must equal the plan's record.
    machine prof_ck(verify: &mut Verify) {
        verify.cb = 2;
        verify.cb2 = 6;
        Verify::cmp_ident(verify, verify.i, verify.d1);
        transition verify.d0 == 0 && verify.ok {
            true -> clo_ck(verify)
            _ -> prof_bad(verify)
        }
    }
    machine prof_bad(verify: &mut Verify) {
        verify.verdict = 9;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine clo_ck(verify: &mut Verify) {
        verify.cb = 3;
        verify.cb2 = 7;
        Verify::cmp_ident(verify, verify.i, verify.d1);
        transition verify.d0 == 0 && verify.ok {
            true -> asm_ck(verify)
            _ -> clo_bad(verify)
        }
    }
    machine clo_bad(verify: &mut Verify) {
        verify.verdict = 10;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    // Assumption sets: same count, then membership both directions
    // (identical sets in either order). asm_member does each direction.
    machine asm_ck(verify: &mut Verify) {
        verify.j = verify.d1;
        transition verify.i < 8 && verify.j < 8 {
            true -> asm_ck_rd(verify)
            _ -> asm_bad(verify)
        }
    }
    machine asm_ck_rd(verify: &mut Verify) {
        transition verify.p_asm_n[verify.i] == verify.c_asm_n[verify.j] {
            true -> asm_scan(verify)
            _ -> asm_bad(verify)
        }
    }
    machine asm_bad(verify: &mut Verify) {
        verify.verdict = 11;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine asm_scan(verify: &mut Verify) {
        verify.k = 0;
        transition { _ -> asm_loop(verify) }
    }
    machine asm_loop(verify: &mut Verify) {
        transition verify.i < 8 {
            true -> asm_loop_rd(verify)
            _ -> asm_bad(verify)
        }
    }
    machine asm_loop_rd(verify: &mut Verify) {
        transition verify.k < verify.p_asm_n[verify.i] && verify.k < 4 && verify.ok {
            true -> asm_member_f(verify)
            _ -> ep_ck(verify)
        }
    }
    // Row (i*4+k) of p_asm must appear among component j's rows.
    machine asm_member_f(verify: &mut Verify) {
        verify.cb = 4;
        verify.cb2 = 8;
        verify.ja = verify.i * 4 + verify.k;
        verify.m = 0;
        verify.d0 = 1;
        transition { _ -> asm_m_loop(verify) }
    }
    machine asm_m_loop(verify: &mut Verify) {
        transition verify.j < 8 {
            true -> asm_m_loop_rd(verify)
            _ -> asm_bad(verify)
        }
    }
    machine asm_m_loop_rd(verify: &mut Verify) {
        transition verify.m < verify.c_asm_n[verify.j] && verify.m < 4 && verify.d0 == 1 {
            true -> asm_m_one(verify)
            _ -> asm_m_done(verify)
        }
    }
    machine asm_m_one(verify: &mut Verify) {
        verify.jb = verify.j * 4 + verify.m;
        Verify::cmp_ident(verify, verify.ja, verify.jb);
        transition verify.d0 == 0 {
            true -> asm_found(verify)
            _ -> asm_m_next(verify)
        }
    }
    machine asm_m_next(verify: &mut Verify) {
        verify.d0 = 1;
        verify.m = verify.m + 1;
        transition { _ -> asm_m_loop(verify) }
    }
    machine asm_found(verify: &mut Verify) {
        transition { _ -> asm_m_done(verify) }
    }
    machine asm_m_done(verify: &mut Verify) {
        transition verify.d0 == 0 {
            true -> asm_next(verify)
            _ -> asm_bad(verify)
        }
    }
    machine asm_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> asm_loop(verify) }
    }
    // Endpoint sets: canonical order on both sides, so same count +
    // pairwise (slot,dir,contract) equality at the same index.
    machine ep_ck(verify: &mut Verify) {
        transition verify.i < 8 && verify.j < 8 {
            true -> ep_ck_rd(verify)
            _ -> ep_bad(verify)
        }
    }
    machine ep_ck_rd(verify: &mut Verify) {
        transition verify.p_ep_n[verify.i] == verify.c_ep_n[verify.j] {
            true -> ep_scan(verify)
            _ -> ep_bad(verify)
        }
    }
    machine ep_bad(verify: &mut Verify) {
        verify.verdict = 12;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine ep_scan(verify: &mut Verify) {
        verify.k = 0;
        transition { _ -> ep_loop(verify) }
    }
    machine ep_loop(verify: &mut Verify) {
        transition verify.i < 8 {
            true -> ep_loop_rd(verify)
            _ -> ep_bad(verify)
        }
    }
    machine ep_loop_rd(verify: &mut Verify) {
        transition verify.k < verify.p_ep_n[verify.i] && verify.k < 8 && verify.ok {
            true -> ep_one(verify)
            _ -> next(verify)
        }
    }
    machine ep_one(verify: &mut Verify) {
        verify.h0 = verify.i * 8 + verify.k;
        verify.h1 = verify.j * 8 + verify.k;
        transition verify.h0 < 64 && verify.h1 < 64 {
            true -> ep_sd(verify)
            _ -> bad(verify)
        }
    }
    machine ep_sd(verify: &mut Verify) {
        transition verify.p_ep_slot[verify.h0] == verify.c_ep_slot[verify.h1] && verify.p_ep_dir[verify.h0] == verify.c_ep_dir[verify.h1] {
            true -> ep_ctr(verify)
            _ -> ep_bad(verify)
        }
    }
    machine ep_ctr(verify: &mut Verify) {
        verify.cb = 16;
        verify.cb2 = 17;
        Verify::cmp_ident(verify, verify.h0, verify.h1);
        transition verify.d0 == 0 && verify.ok {
            true -> ep_next(verify)
            _ -> ep_bad(verify)
        }
    }
    machine ep_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> ep_loop(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> loop_s(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- accepted assumptions ------------------------------------------------------
// Every declared assumption on every bound instance must be a member
// of the request's accepted-assumptions digest list (verdict 6).
machine Verify::check_assumptions(verify: &mut Verify) {
    verify.i = 0;
    transition { _ -> loop_s(verify) }
    machine loop_s(verify: &mut Verify) {
        transition verify.i < verify.p_n && verify.i < 8 && verify.ok {
            true -> inst(verify)
            _ -> done(verify)
        }
    }
    machine inst(verify: &mut Verify) {
        verify.k = 0;
        transition { _ -> asm_loop(verify) }
    }
    machine asm_loop(verify: &mut Verify) {
        transition verify.i < 8 {
            true -> asm_loop_rd(verify)
            _ -> bad(verify)
        }
    }
    machine asm_loop_rd(verify: &mut Verify) {
        transition verify.k < verify.p_asm_n[verify.i] && verify.k < 4 && verify.ok {
            true -> stage(verify)
            _ -> next(verify)
        }
    }
    machine stage(verify: &mut Verify) {
        verify.h0 = (verify.i * 4 + verify.k) * 32;
        verify.j = 0;
        transition { _ -> cp_loop(verify) }
    }
    machine cp_loop(verify: &mut Verify) {
        transition verify.j < 32 {
            true -> cp_one(verify)
            _ -> member(verify)
        }
    }
    machine cp_one(verify: &mut Verify) {
        verify.h1 = verify.h0 + verify.j;
        verify.h2 = verify.j;
        transition verify.h1 < 1024 && verify.h2 < 32 {
            true -> cp_w(verify)
            _ -> bad(verify)
        }
    }
    machine cp_w(verify: &mut Verify) {
        verify.ident[verify.h2] = verify.p_asm[verify.h1];
        verify.j = verify.j + 1;
        transition { _ -> cp_loop(verify) }
    }
    machine member(verify: &mut Verify) {
        verify.cb = 10;
        Verify::id_member(verify, verify.n_acp);
        transition verify.d0 == 1 && verify.ok {
            true -> asm_next(verify)
            _ -> unacc(verify)
        }
    }
    machine unacc(verify: &mut Verify) {
        verify.verdict = 6;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine asm_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> asm_loop(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> loop_s(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- bindings + normalized graph ------------------------------------------------
// Each row must name in-range instance indices, resolve its import
// endpoint slot (direction Consumer on instance ii) and export endpoint
// slot (direction Producer on instance ei), point at a non-null
// admitted transport, and not duplicate an import endpoint. Accepted
// rows then populate `adj` — the normalized edge structure every
// policy replays against.
machine Verify::check_bindings(verify: &mut Verify) {
    verify.i = 0;
    transition { _ -> zloop(verify) }
    // Clear bound_import and adjacency.
    machine zloop(verify: &mut Verify) {
        transition verify.i < 64 {
            true -> ztwo(verify)
            _ -> zseen(verify)
        }
    }
    machine ztwo(verify: &mut Verify) {
        verify.bound_imp[verify.i] = 0;
        verify.adj[verify.i] = 0;
        verify.i = verify.i + 1;
        transition { _ -> zloop(verify) }
    }
    machine zseen(verify: &mut Verify) {
        verify.i = 0;
        transition { _ -> loop_s(verify) }
    }
    machine loop_s(verify: &mut Verify) {
        transition verify.i < verify.n_bind && verify.i < 16 && verify.ok {
            true -> range(verify)
            _ -> unbound(verify)
        }
    }
    machine range(verify: &mut Verify) {
        transition verify.b_ii[verify.i] < verify.p_n && verify.b_ei[verify.i] < verify.p_n {
            true -> imp_find(verify)
            _ -> out_of_range(verify)
        }
    }
    machine out_of_range(verify: &mut Verify) {
        verify.verdict = 24;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    // Locate endpoint index `b_is` on instance `b_ii` with direction 0.
    machine imp_find(verify: &mut Verify) {
        verify.k = 0;
        verify.d0 = 0;
        transition { _ -> imp_loop(verify) }
    }
    machine imp_loop(verify: &mut Verify) {
        transition verify.i < 16 && verify.k < 8 && verify.d0 == 0 && verify.ok {
            true -> imp_scan(verify)
            _ -> imp_after(verify)
        }
    }
    machine imp_scan(verify: &mut Verify) {
        verify.jb = verify.b_ii[verify.i];
        transition verify.jb < 8 {
            true -> imp_ck(verify)
            _ -> bad(verify)
        }
    }
    machine imp_ck(verify: &mut Verify) {
        verify.h0 = verify.jb * 8 + verify.k;
        transition verify.k < verify.p_ep_n[verify.jb] && verify.h0 < 64 {
            true -> imp_cmp(verify)
            _ -> imp_after(verify)
        }
    }
    machine imp_cmp(verify: &mut Verify) {
        transition verify.h0 < 64 && verify.i < 16 {
            true -> imp_cmp_rd(verify)
            _ -> bad(verify)
        }
    }
    machine imp_cmp_rd(verify: &mut Verify) {
        transition verify.p_ep_slot[verify.h0] == verify.b_is[verify.i] && verify.p_ep_dir[verify.h0] == 0 {
            true -> imp_hit(verify)
            _ -> imp_next(verify)
        }
    }
    machine imp_hit(verify: &mut Verify) {
        verify.d0 = 1;
        verify.jf = verify.jb * 8 + verify.k;
        transition { _ -> imp_loop(verify) }
    }
    machine imp_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> imp_loop(verify) }
    }
    machine imp_after(verify: &mut Verify) {
        transition verify.d0 == 1 {
            true -> exp_find(verify)
            _ -> imp_bad(verify)
        }
    }
    machine imp_bad(verify: &mut Verify) {
        verify.verdict = 25;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    // Locate endpoint index `b_es` on instance `b_ei` with direction 1.
    machine exp_find(verify: &mut Verify) {
        verify.k = 0;
        verify.d0 = 0;
        transition { _ -> exp_loop(verify) }
    }
    machine exp_loop(verify: &mut Verify) {
        transition verify.i < 16 && verify.k < 8 && verify.d0 == 0 && verify.ok {
            true -> exp_scan(verify)
            _ -> exp_after(verify)
        }
    }
    machine exp_scan(verify: &mut Verify) {
        verify.jb = verify.b_ei[verify.i];
        transition verify.jb < 8 {
            true -> exp_ck(verify)
            _ -> bad(verify)
        }
    }
    machine exp_ck(verify: &mut Verify) {
        verify.h0 = verify.jb * 8 + verify.k;
        transition verify.k < verify.p_ep_n[verify.jb] && verify.h0 < 64 {
            true -> exp_cmp(verify)
            _ -> exp_after(verify)
        }
    }
    machine exp_cmp(verify: &mut Verify) {
        transition verify.h0 < 64 && verify.i < 16 {
            true -> exp_cmp_rd(verify)
            _ -> bad(verify)
        }
    }
    machine exp_cmp_rd(verify: &mut Verify) {
        transition verify.p_ep_slot[verify.h0] == verify.b_es[verify.i] && verify.p_ep_dir[verify.h0] == 1 {
            true -> exp_hit(verify)
            _ -> exp_next(verify)
        }
    }
    machine exp_hit(verify: &mut Verify) {
        verify.d0 = 1;
        transition { _ -> exp_loop(verify) }
    }
    machine exp_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> exp_loop(verify) }
    }
    machine exp_after(verify: &mut Verify) {
        transition verify.d0 == 1 {
            true -> tr_stage(verify)
            _ -> exp_bad(verify)
        }
    }
    machine exp_bad(verify: &mut Verify) {
        verify.verdict = 26;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    // Transport: stage the row's identity, require it non-null and a
    // member of the request's admitted transports.
    machine tr_stage(verify: &mut Verify) {
        verify.k = 0;
        verify.h0 = verify.i * 32;
        transition verify.h0 < 512 {
            true -> tr_cp(verify)
            _ -> bad(verify)
        }
    }
    machine tr_cp(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> tr_one(verify)
            _ -> tr_null(verify)
        }
    }
    machine tr_one(verify: &mut Verify) {
        verify.h1 = verify.h0 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 512 && verify.h2 < 32 {
            true -> tr_w(verify)
            _ -> bad(verify)
        }
    }
    machine tr_w(verify: &mut Verify) {
        verify.ident[verify.h2] = verify.b_tr[verify.h1];
        verify.k = verify.k + 1;
        transition { _ -> tr_cp(verify) }
    }
    machine tr_null(verify: &mut Verify) {
        verify.k = 0;
        verify.d1 = 0;
        transition { _ -> tr_null_loop(verify) }
    }
    machine tr_null_loop(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> tr_null_one(verify)
            _ -> tr_null_ck(verify)
        }
    }
    machine tr_null_one(verify: &mut Verify) {
        verify.h2 = verify.k;
        transition verify.h2 < 32 {
            true -> tr_null_w(verify)
            _ -> bad(verify)
        }
    }
    machine tr_null_w(verify: &mut Verify) {
        transition verify.ident[verify.h2] == 0 {
            true -> tr_null_acc(verify)
            _ -> tr_nonnull(verify)
        }
    }
    machine tr_null_acc(verify: &mut Verify) {
        verify.d1 = verify.d1 + 1;
        transition { _ -> tr_null_next(verify) }
    }
    machine tr_nonnull(verify: &mut Verify) {
        transition { _ -> tr_member(verify) }
    }
    machine tr_null_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> tr_null_loop(verify) }
    }
    machine tr_null_ck(verify: &mut Verify) {
        transition verify.d1 == 32 {
            true -> tr_zero(verify)
            _ -> tr_member(verify)
        }
    }
    machine tr_zero(verify: &mut Verify) {
        verify.verdict = 29;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine tr_member(verify: &mut Verify) {
        verify.cb = 9;
        Verify::id_member(verify, verify.n_tr);
        transition verify.d0 == 1 && verify.ok {
            true -> dup_ck(verify)
            _ -> tr_bad(verify)
        }
    }
    machine tr_bad(verify: &mut Verify) {
        verify.verdict = 13;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    // Duplicate import endpoints are malformed — each (ii, slot) admits
    // at most one binding row.
    machine dup_ck(verify: &mut Verify) {
        verify.h0 = verify.jf;
        transition verify.h0 < 64 {
            true -> dup_w(verify)
            _ -> bad(verify)
        }
    }
    machine dup_w(verify: &mut Verify) {
        transition verify.bound_imp[verify.h0] == 0 {
            true -> dup_set(verify)
            _ -> dup_bad(verify)
        }
    }
    machine dup_set(verify: &mut Verify) {
        verify.bound_imp[verify.h0] = 1;
        transition { _ -> adj_w(verify) }
    }
    machine dup_bad(verify: &mut Verify) {
        verify.verdict = 27;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    // Accepted row → normalized edge ii → ei.
    machine adj_w(verify: &mut Verify) {
        transition verify.i < 16 {
            true -> adj_w_rd(verify)
            _ -> bad(verify)
        }
    }
    machine adj_w_rd(verify: &mut Verify) {
        verify.h1 = verify.b_ii[verify.i] * 8 + verify.b_ei[verify.i];
        transition verify.h1 < 64 {
            true -> adj_set(verify)
            _ -> bad(verify)
        }
    }
    machine adj_set(verify: &mut Verify) {
        verify.adj[verify.h1] = 1;
        transition { _ -> next(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> loop_s(verify) }
    }
    // Every declared import endpoint must be bound — an unbound import
    // leaks a capability request the composition never satisfied.
    machine unbound(verify: &mut Verify) {
        verify.i = 0;
        transition { _ -> ub_inst(verify) }
    }
    machine ub_inst(verify: &mut Verify) {
        transition verify.i < verify.p_n && verify.i < 8 && verify.ok {
            true -> ub_eps(verify)
            _ -> done(verify)
        }
    }
    machine ub_eps(verify: &mut Verify) {
        verify.k = 0;
        transition { _ -> ub_loop(verify) }
    }
    machine ub_loop(verify: &mut Verify) {
        transition verify.i < 8 {
            true -> ub_loop_rd(verify)
            _ -> bad(verify)
        }
    }
    machine ub_loop_rd(verify: &mut Verify) {
        transition verify.k < verify.p_ep_n[verify.i] && verify.k < 8 && verify.ok {
            true -> ub_one(verify)
            _ -> ub_next(verify)
        }
    }
    machine ub_one(verify: &mut Verify) {
        verify.h0 = verify.i * 8 + verify.k;
        transition verify.h0 < 64 {
            true -> ub_dir(verify)
            _ -> bad(verify)
        }
    }
    machine ub_dir(verify: &mut Verify) {
        transition verify.p_ep_dir[verify.h0] == 0 {
            true -> ub_bound(verify)
            _ -> ub_skip(verify)
        }
    }
    machine ub_bound(verify: &mut Verify) {
        verify.h1 = verify.h0;
        transition verify.h1 < 64 {
            true -> ub_ck(verify)
            _ -> bad(verify)
        }
    }
    machine ub_ck(verify: &mut Verify) {
        transition verify.bound_imp[verify.h1] == 1 {
            true -> ub_skip(verify)
            _ -> ub_bad(verify)
        }
    }
    machine ub_bad(verify: &mut Verify) {
        verify.verdict = 28;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine ub_skip(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> ub_loop(verify) }
    }
    machine ub_next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> ub_inst(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- policy coverage -----------------------------------------------------------
// Set equality between the request's required policy rows and the plan's
// verified rows — same count, and every request row has an identical
// plan row (tag + all three selector sets). An absent required row
// rejects as MissingRequiredPolicy (15); a plan row without a request
// counterpart rejects as UnexpectedPolicy (16). Each plan row must also
// carry the request's declared verifier identity (17).
machine Verify::check_coverage(verify: &mut Verify) {
    transition verify.p_npol == verify.n_pol {
        true -> fwd_init(verify)
        _ -> cov_bad(verify)
    }
    machine cov_bad(verify: &mut Verify) {
        verify.verdict = 15;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine fwd_init(verify: &mut Verify) {
        verify.i = 0;
        transition { _ -> fwd_loop(verify) }
    }
    machine fwd_loop(verify: &mut Verify) {
        transition verify.i < verify.n_pol && verify.i < 8 && verify.ok {
            true -> fwd_scan(verify)
            _ -> bwd_init(verify)
        }
    }
    machine fwd_scan(verify: &mut Verify) {
        verify.j = 0;
        verify.d0 = 1;
        transition { _ -> fwd_m(verify) }
    }
    machine fwd_m(verify: &mut Verify) {
        transition verify.j < verify.p_npol && verify.j < 8 && verify.d0 == 1 {
            true -> fwd_one(verify)
            _ -> fwd_done(verify)
        }
    }
    machine fwd_one(verify: &mut Verify) {
        transition verify.i < 8 && verify.j < 8 {
            true -> fwd_one_rd(verify)
            _ -> bad(verify)
        }
    }
    machine fwd_one_rd(verify: &mut Verify) {
        transition verify.pol_tag[verify.i] == verify.q_tag[verify.j] && verify.pol_s[verify.i] == verify.q_s[verify.j] && verify.pol_t[verify.i] == verify.q_t[verify.j] && verify.pol_v[verify.i] == verify.q_v[verify.j] {
            true -> fwd_hit(verify)
            _ -> fwd_next(verify)
        }
    }
    machine fwd_hit(verify: &mut Verify) {
        verify.d0 = 0;
        transition { _ -> fwd_m(verify) }
    }
    machine fwd_next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> fwd_m(verify) }
    }
    machine fwd_done(verify: &mut Verify) {
        transition verify.d0 == 0 {
            true -> fwd_next_i(verify)
            _ -> miss_bad(verify)
        }
    }
    machine miss_bad(verify: &mut Verify) {
        verify.verdict = 15;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine fwd_next_i(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> fwd_loop(verify) }
    }
    machine bwd_init(verify: &mut Verify) {
        verify.i = 0;
        transition { _ -> bwd_loop(verify) }
    }
    machine bwd_loop(verify: &mut Verify) {
        transition verify.i < verify.p_npol && verify.i < 8 && verify.ok {
            true -> bwd_scan(verify)
            _ -> ver_init(verify)
        }
    }
    machine bwd_scan(verify: &mut Verify) {
        verify.j = 0;
        verify.d0 = 1;
        transition { _ -> bwd_m(verify) }
    }
    machine bwd_m(verify: &mut Verify) {
        transition verify.j < verify.n_pol && verify.j < 8 && verify.d0 == 1 {
            true -> bwd_one(verify)
            _ -> bwd_done(verify)
        }
    }
    machine bwd_one(verify: &mut Verify) {
        transition verify.i < 8 && verify.j < 8 {
            true -> bwd_one_rd(verify)
            _ -> bad(verify)
        }
    }
    machine bwd_one_rd(verify: &mut Verify) {
        transition verify.pol_tag[verify.j] == verify.q_tag[verify.i] && verify.pol_s[verify.j] == verify.q_s[verify.i] && verify.pol_t[verify.j] == verify.q_t[verify.i] && verify.pol_v[verify.j] == verify.q_v[verify.i] {
            true -> bwd_hit(verify)
            _ -> bwd_next(verify)
        }
    }
    machine bwd_hit(verify: &mut Verify) {
        verify.d0 = 0;
        transition { _ -> bwd_m(verify) }
    }
    machine bwd_next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> bwd_m(verify) }
    }
    machine bwd_done(verify: &mut Verify) {
        transition verify.d0 == 0 {
            true -> bwd_next_i(verify)
            _ -> extra_bad(verify)
        }
    }
    machine extra_bad(verify: &mut Verify) {
        verify.verdict = 16;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine bwd_next_i(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> bwd_loop(verify) }
    }
    // Each row must name the request's declared verifier — a row issued
    // by any other engine is evidence out of scope.
    machine ver_init(verify: &mut Verify) {
        verify.i = 0;
        transition { _ -> ver_loop(verify) }
    }
    machine ver_loop(verify: &mut Verify) {
        transition verify.i < verify.p_npol && verify.i < 8 && verify.ok {
            true -> ver_one(verify)
            _ -> done(verify)
        }
    }
    machine ver_one(verify: &mut Verify) {
        verify.cb = 13;
        verify.cb2 = 11;
        Verify::cmp_ident(verify, verify.i, 0);
        transition verify.d0 == 0 && verify.ok {
            true -> ver_next(verify)
            _ -> ver_bad(verify)
        }
    }
    machine ver_bad(verify: &mut Verify) {
        verify.verdict = 17;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine ver_next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> ver_loop(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- reachability ---------------------------------------------------------------
// BFS over `adj` from the sources in `src` (bitmask), excluding vertices
// in `excl` (bitmask) — `verify.reach` collects the reached mask.
machine Verify::reachable(verify: &mut Verify, src: u64 in Wrapping, excl: u64 in Wrapping) {
    verify.ja = src;
    verify.jb = excl;
    verify.reach = src;
    verify.cur = src & ~excl;
    transition { _ -> loop_s(verify) }
    machine loop_s(verify: &mut Verify) {
        transition verify.cur != 0 {
            true -> pop(verify)
            _ -> done(verify)
        }
    }
    // Lowest set bit of `cur` → `w8` reused as vertex index `verify.m`.
    machine pop(verify: &mut Verify) {
        verify.m = 0;
        verify.d0 = 0;
        transition { _ -> pop_scan(verify) }
    }
    machine pop_scan(verify: &mut Verify) {
        transition verify.m < 8 && verify.d0 == 0 {
            true -> pop_bit(verify)
            _ -> exp_init(verify)
        }
    }
    machine pop_bit(verify: &mut Verify) {
        transition (verify.cur >> verify.m) & 1 == 1 {
            true -> pop_hit(verify)
            _ -> pop_next(verify)
        }
    }
    machine pop_hit(verify: &mut Verify) {
        verify.d0 = 1;
        verify.cur = verify.cur & ~((1 as u64 in Wrapping) << verify.m);
        transition { _ -> exp_init(verify) }
    }
    machine pop_next(verify: &mut Verify) {
        verify.m = verify.m + 1;
        transition { _ -> pop_scan(verify) }
    }
    // Expand vertex `verify.m` over successors j.
    machine exp_init(verify: &mut Verify) {
        verify.j = 0;
        transition { _ -> exp_loop(verify) }
    }
    machine exp_loop(verify: &mut Verify) {
        transition verify.j < 8 {
            true -> exp_one(verify)
            _ -> loop_s(verify)
        }
    }
    machine exp_one(verify: &mut Verify) {
        verify.h0 = verify.m * 8 + verify.j;
        transition verify.h0 < 64 && verify.adj[verify.h0] == 1 {
            true -> exp_eligible(verify)
            _ -> exp_next(verify)
        }
    }
    machine exp_eligible(verify: &mut Verify) {
        transition (verify.reach >> verify.j) & 1 == 0 && (verify.jb >> verify.j) & 1 == 0 {
            true -> exp_add(verify)
            _ -> exp_next(verify)
        }
    }
    machine exp_add(verify: &mut Verify) {
        verify.reach = verify.reach | ((1 as u64 in Wrapping) << verify.j);
        verify.cur = verify.cur | ((1 as u64 in Wrapping) << verify.j);
        transition { _ -> exp_next(verify) }
    }
    machine exp_next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> exp_loop(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- predicate replay -----------------------------------------------------------
// Re-evaluate every plan policy row against `adj` and validate its
// certificate. A satisfied row must hold in the normalized graph; a
// violated row is inadmissible input (a plan proving a broken request
// is itself broken). Certificate failures reject as verdict 20;
// predicate failures as 19; a non-satisfied outcome as 18.
machine Verify::check_policies(verify: &mut Verify) {
    verify.cp = 0;
    transition { _ -> loop_s(verify) }
    machine loop_s(verify: &mut Verify) {
        transition verify.cp < verify.p_npol && verify.cp < 8 && verify.ok {
            true -> out_ck(verify)
            _ -> done(verify)
        }
    }
    machine out_ck(verify: &mut Verify) {
        transition verify.q_out[verify.cp] == 1 {
            true -> tag_ck(verify)
            _ -> out_bad(verify)
        }
    }
    machine out_bad(verify: &mut Verify) {
        verify.verdict = 18;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine tag_ck(verify: &mut Verify) {
        transition verify.q_tag[verify.cp] == 1 {
            true -> nr_eval(verify)
            _ -> ov_eval(verify)
        }
    }
    // NoRoute: no source vertex may reach a target vertex at all.
    machine nr_eval(verify: &mut Verify) {
        Verify::reachable(verify, verify.q_s[verify.cp], 0);
        transition (verify.reach & verify.q_t[verify.cp]) == 0 {
            true -> nr_cert_sup(verify)
            _ -> pred_bad(verify)
        }
    }
    machine pred_bad(verify: &mut Verify) {
        verify.verdict = 19;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    // Certificate: superset of sources, edge-closed, disjoint targets.
    machine nr_cert_sup(verify: &mut Verify) {
        transition verify.cp < 8 {
            true -> nr_cert_sup_rd(verify)
            _ -> bad(verify)
        }
    }
    machine nr_cert_sup_rd(verify: &mut Verify) {
        transition (verify.q_s[verify.cp] & ~verify.q_reach[verify.cp]) == 0 {
            true -> nr_closed(verify)
            _ -> cert_bad(verify)
        }
    }
    machine nr_closed(verify: &mut Verify) {
        transition verify.cp < 8 {
            true -> nr_closed_rd(verify)
            _ -> bad(verify)
        }
    }
    machine nr_closed_rd(verify: &mut Verify) {
        verify.ja = verify.q_reach[verify.cp];
        verify.jb = 0;
        Verify::closed_ck(verify);
        transition verify.d0 == 1 && verify.ok {
            true -> nr_disj(verify)
            _ -> cert_bad(verify)
        }
    }
    machine nr_disj(verify: &mut Verify) {
        transition verify.cp < 8 {
            true -> nr_disj_rd(verify)
            _ -> bad(verify)
        }
    }
    machine nr_disj_rd(verify: &mut Verify) {
        transition (verify.q_reach[verify.cp] & verify.q_t[verify.cp]) == 0 {
            true -> next(verify)
            _ -> cert_bad(verify)
        }
    }
    // OnlyVia: a direct source→target path exists, and no source
    // reaches a target while avoiding the via set.
    machine ov_eval(verify: &mut Verify) {
        Verify::reachable(verify, verify.q_s[verify.cp], 0);
        transition (verify.reach & verify.q_t[verify.cp]) != 0 {
            true -> ov_indirect(verify)
            _ -> pred_bad(verify)
        }
    }
    machine ov_indirect(verify: &mut Verify) {
        Verify::reachable(verify, verify.q_s[verify.cp], verify.q_v[verify.cp]);
        transition (verify.reach & verify.q_t[verify.cp]) == 0 {
            true -> ov_path_ck(verify)
            _ -> pred_bad(verify)
        }
    }
    // Path witness: every hop is a real edge, first hop in sources,
    // last vertex in targets.
    machine ov_path_ck(verify: &mut Verify) {
        verify.k = 0;
        transition { _ -> ov_path_loop(verify) }
    }
    machine ov_path_loop(verify: &mut Verify) {
        transition verify.cp < 8 && verify.k < 8 && verify.ok {
            true -> ov_path_one(verify)
            _ -> ov_cert_sup(verify)
        }
    }
    machine ov_path_one(verify: &mut Verify) {
        transition verify.k + 1 < verify.q_path_n[verify.cp] {
            true -> ov_hop(verify)
            _ -> ov_endpoints(verify)
        }
    }
    machine ov_hop(verify: &mut Verify) {
        verify.h0 = verify.cp * 8 + verify.k;
        verify.h1 = verify.cp * 8 + verify.k + 1;
        transition verify.h0 < 64 && verify.h1 < 64 {
            true -> ov_hop_ck(verify)
            _ -> bad(verify)
        }
    }
    machine ov_hop_ck(verify: &mut Verify) {
        verify.h2 = verify.q_path[verify.h0] * 8 + verify.q_path[verify.h1];
        transition verify.h2 < 64 && verify.adj[verify.h2] == 1 {
            true -> ov_hop_next(verify)
            _ -> cert_bad(verify)
        }
    }
    machine ov_hop_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> ov_path_loop(verify) }
    }
    machine ov_endpoints(verify: &mut Verify) {
        verify.h0 = verify.cp * 8;
        transition verify.h0 < 64 {
            true -> ov_first(verify)
            _ -> bad(verify)
        }
    }
    machine ov_first(verify: &mut Verify) {
        transition (verify.q_s[verify.cp] >> verify.q_path[verify.h0]) & 1 == 1 {
            true -> ov_last(verify)
            _ -> cert_bad(verify)
        }
    }
    machine ov_last(verify: &mut Verify) {
        verify.h0 = verify.cp * 8 + (verify.q_path_n[verify.cp] - 1);
        transition verify.h0 < 64 {
            true -> ov_last_ck(verify)
            _ -> bad(verify)
        }
    }
    machine ov_last_ck(verify: &mut Verify) {
        transition (verify.q_t[verify.cp] >> verify.q_path[verify.h0]) & 1 == 1 {
            true -> ov_cert_sup(verify)
            _ -> cert_bad(verify)
        }
    }
    // Reachable set: superset of sources, closed under edges whose
    // destination is outside `via`, disjoint from targets.
    machine ov_cert_sup(verify: &mut Verify) {
        transition verify.cp < 8 {
            true -> ov_cert_sup_rd(verify)
            _ -> bad(verify)
        }
    }
    machine ov_cert_sup_rd(verify: &mut Verify) {
        transition (verify.q_s[verify.cp] & ~verify.q_reach[verify.cp]) == 0 {
            true -> ov_closed(verify)
            _ -> cert_bad(verify)
        }
    }
    machine ov_closed(verify: &mut Verify) {
        transition verify.cp < 8 {
            true -> ov_closed_rd(verify)
            _ -> bad(verify)
        }
    }
    machine ov_closed_rd(verify: &mut Verify) {
        verify.ja = verify.q_reach[verify.cp];
        verify.jb = verify.q_v[verify.cp];
        Verify::closed_ck(verify);
        transition verify.d0 == 1 && verify.ok {
            true -> ov_disj(verify)
            _ -> cert_bad(verify)
        }
    }
    machine ov_disj(verify: &mut Verify) {
        transition verify.cp < 8 {
            true -> ov_disj_rd(verify)
            _ -> bad(verify)
        }
    }
    machine ov_disj_rd(verify: &mut Verify) {
        transition (verify.q_reach[verify.cp] & verify.q_t[verify.cp]) == 0 {
            true -> next(verify)
            _ -> cert_bad(verify)
        }
    }
    machine cert_bad(verify: &mut Verify) {
        verify.verdict = 20;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.cp = verify.cp + 1;
        transition { _ -> loop_s(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Edge-closure check for a certificate set `ja` (bitmask) under edges
// whose destination is outside `jb` (bitmask): every edge a→b with
// a ∈ set and b ∉ excl must have b ∈ set. `d0` = 1 closed / 0 violated.
machine Verify::closed_ck(verify: &mut Verify) {
    verify.d0 = 1;
    verify.i = 0;
    transition { _ -> a_loop(verify) }
    machine a_loop(verify: &mut Verify) {
        transition verify.i < 8 && verify.d0 == 1 {
            true -> a_in(verify)
            _ -> done(verify)
        }
    }
    machine a_in(verify: &mut Verify) {
        transition (verify.ja >> verify.i) & 1 == 1 {
            true -> b_init(verify)
            _ -> a_next(verify)
        }
    }
    machine b_init(verify: &mut Verify) {
        verify.j = 0;
        transition { _ -> b_loop(verify) }
    }
    machine b_loop(verify: &mut Verify) {
        transition verify.j < 8 && verify.d0 == 1 {
            true -> b_one(verify)
            _ -> a_next(verify)
        }
    }
    machine b_one(verify: &mut Verify) {
        verify.h0 = verify.i * 8 + verify.j;
        transition verify.h0 < 64 && verify.adj[verify.h0] == 1 {
            true -> b_excl(verify)
            _ -> b_next(verify)
        }
    }
    machine b_excl(verify: &mut Verify) {
        transition (verify.jb >> verify.j) & 1 == 0 {
            true -> b_req(verify)
            _ -> b_next(verify)
        }
    }
    machine b_req(verify: &mut Verify) {
        transition (verify.ja >> verify.j) & 1 == 1 {
            true -> b_next(verify)
            _ -> b_bad(verify)
        }
    }
    machine b_bad(verify: &mut Verify) {
        verify.d0 = 0;
        transition { _ -> done(verify) }
    }
    machine b_next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> b_loop(verify) }
    }
    machine a_next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> a_loop(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- driver ----------------------------------------------------------------------
// `verify` runs the full pipeline in the reference order: request
// decode → plan decode → components decode → request commitment →
// roster match → component binding + completeness admission →
// unaccepted-assumption check → binding validation + graph
// normalization → policy coverage + verifier identity → predicate
// replay + certificate checks. Any stage short-circuits into `fin`,
// which maps a bare decode failure to verdict 2 when the stage itself
// did not name a code.
public machine Verify::verify(verify: &mut Verify) {
    verify.ok = true;
    verify.verdict = 0;
    transition { _ -> req(verify) }

    machine req(verify: &mut Verify) {
        Verify::decode_req(verify);
        transition verify.ok {
            true -> plan(verify)
            _ -> fin(verify)
        }
    }
    machine plan(verify: &mut Verify) {
        Verify::decode_plan(verify);
        transition verify.ok {
            true -> meta(verify)
            _ -> fin(verify)
        }
    }
    machine meta(verify: &mut Verify) {
        Verify::decode_meta(verify);
        transition verify.ok {
            true -> commit(verify)
            _ -> fin(verify)
        }
    }
    machine commit(verify: &mut Verify) {
        Verify::check_commitment(verify);
        transition verify.ok {
            true -> roster(verify)
            _ -> fin(verify)
        }
    }
    machine roster(verify: &mut Verify) {
        Verify::check_roster(verify);
        transition verify.ok {
            true -> adm(verify)
            _ -> fin(verify)
        }
    }
    machine adm(verify: &mut Verify) {
        Verify::check_admissions(verify);
        transition verify.ok {
            true -> asum(verify)
            _ -> fin(verify)
        }
    }
    machine asum(verify: &mut Verify) {
        Verify::check_assumptions(verify);
        transition verify.ok {
            true -> bind(verify)
            _ -> fin(verify)
        }
    }
    machine bind(verify: &mut Verify) {
        verify.check_bindings();
        transition verify.ok {
            true -> cov(verify)
            _ -> fin(verify)
        }
    }
    machine cov(verify: &mut Verify) {
        verify.check_coverage();
        transition verify.ok {
            true -> replay(verify)
            _ -> fin(verify)
        }
    }
    machine replay(verify: &mut Verify) {
        verify.check_policies();
        transition verify.ok {
            true -> pass(verify)
            _ -> fin(verify)
        }
    }
    machine pass(verify: &mut Verify) {
        verify.verdict = 1;
        transition { _ -> fin(verify) }
    }
    machine fin(verify: &mut Verify) {
        transition verify.verdict == 0 {
            true -> malformed(verify)
            _ -> done(verify)
        }
    }
    machine malformed(verify: &mut Verify) {
        verify.verdict = 2;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// The verdict code the caller publishes: 0 = malformed input (should
// not survive `verify` — a defensive default), 1 = verified, 2 = plan
// or request malformed, 3 = unverified completeness, 4 = stale
// request, 5 = roster mismatch, 6 = unaccepted assumption, 7 = missing
// verified component, 8 = external subject verified, 9–12 = component
// binding substitution, 13 = transport not admitted, 14/15/16 = policy
// coverage, 17 = verifier identity, 18 = inadmissible outcome,
// 19 = predicate does not hold, 20 = invalid certificate,
// 24–29 = malformed bindings.
public machine Verify::result(verify: &mut Verify) -> u64 in Wrapping {
    transition { _ -> done(verify) }
    machine done(verify: &mut Verify) -> u64 in Wrapping {
        verify.verdict
    }
}
