// verify — the independent source-free plan consumer
// (wiki/spec/packages/topology.md).
//
// `Verify::verify` is given the candidate plan bytes, the *current* owner
// request bytes, and the admitted-component facts the consumer actually
// verified — staged as package-owned canonical byte streams through the
// `open_*`/`feed_*` machines, never the plan's own claim about any of
// them. It decodes both artifacts under the wire's canonical-order and
// tag-table rules, reconstructs the graph from the plan's records,
// compares the request exactly, replays every required predicate itself,
// and checks the recorded certificates against the real edges. Nothing is
// trusted: a stored success flag, a stale request commitment, a roster
// that merely names the right subjects, a policy executable the owner did
// not select, and a component record or endpoint inventory substituted
// for what the admission establishes all reject by comparison or replay —
// never by loading code.
//
// Streams (all `open_stream`-staged):
//   stream 0 — request.bin:   canonical TopologyRequest bytes.
//   stream 1 — plan.bin:      canonical DeploymentPlan bytes.
//   stream 2 — components.bin: {u32 n} + n x canonical admitted-facts
//             records — subject[32] | profile[32] | closure[32] |
//             {u32 n_asm, n_asm x [32]} | {u32 n_ep, n_ep x
//             (u32 slot, u8 dir, [32] contract)} — the package-defined
//             admitted-facts encoding the caller's component verifier
//             publishes (the AdmittedComponent artifact's complete
//             facts, re-encoded; the artifact codec itself lives with
//             component-description under COMPONENT-SUBSTRATE).
//
// `verify.ok` is the parse/dispatch latch; `verify.verdict` reports the
// outcome: 0 = CheckedPlan ("composition checked" — not installation
// admission), otherwise the PlanRejection category:
//   1 MalformedRequest      2 MalformedPlan          3 UnverifiedCompleteness
//   4 StaleRequest          5 RosterMismatch         6 UnacceptedAssumption
//   7 MissingVerifiedComponent   8 ExternalSubjectVerified
//   9 Substituted(profile) 10 Substituted(completeness)
//  11 Substituted(assumptions) 12 Substituted(endpoints)
//  13 UnselectedTransport  14 UnselectedPolicyExecutable
//  15 MissingRequiredPolicy   16 UnexpectedPolicy
//  17 InvalidPolicy(selectors)  18 PolicyNotSatisfied  19 ReplayMismatch
//  20 InvalidCertificate   21 InvalidGraph(generic)
//  22 DuplicateInstance    23 DuplicateEndpoint      24 UnknownInstance
//  25 UnknownEndpoint      26 WrongDirection         27 DuplicateBinding
//  28 UnboundImport        29 NullIdentity           30 LimitExceeded

module verify;

use digest;
use omega::language::core::numeric_conversion;

public data Verify {
    // ---- verdict + latch -------------------------------------------------
    ok: bool;
    verdict: u64 in Wrapping;
    errtag: [u8; 8];

    // ---- staged input streams --------------------------------------------
    req: [u8; 8192];
    req_n: u64 in Wrapping;
    plan: [u8; 16384];
    plan_n: u64 in Wrapping;
    meta: [u8; 8192];
    meta_n: u64 in Wrapping;

    // ---- reader state ------------------------------------------------------
    // `src` selects the stream rd() consumes (0=req, 1=plan, 2=meta).
    src: u64 in Wrapping;
    rq: u64 in Wrapping;
    pq: u64 in Wrapping;
    mq: u64 in Wrapping;
    pos: u64 in Wrapping;
    sn: u64 in Wrapping;

    b8: u8;
    w8: u8;
    w32: u32;
    acc: u64 in Wrapping;
    t64: u64 in Wrapping;
    cur: u64 in Wrapping;
    cp: u64 in Wrapping;
    cb: u64 in Wrapping;
    cb2: u64 in Wrapping;
    dig: digest::Sha256;

    i: u64 in Wrapping;
    j: u64 in Wrapping;
    k: u64 in Wrapping;
    m: u64 in Wrapping;
    h0: u64 in Wrapping;
    h1: u64 in Wrapping;
    h2: u64 in Wrapping;
    h3: u64 in Wrapping;
    d0: u64 in Wrapping;
    d1: u64 in Wrapping;
    ja: u64 in Wrapping;
    jb: u64 in Wrapping;
    jc: u64 in Wrapping;
    jd: u64 in Wrapping;
    je: u64 in Wrapping;
    jf: u64 in Wrapping;
    jg: u64 in Wrapping;

    strbuf: [u8; 256];
    str_n: u64 in Wrapping;
    ident: [u8; 2048];

    // ---- decoded request ---------------------------------------------------
    n_inst: u64 in Wrapping;
    n_pol: u64 in Wrapping;
    n_tr: u64 in Wrapping;
    n_acp: u64 in Wrapping;
    // Instance roster: names 8 x 128 bytes, lengths, subjects 8 x 32.
    names: [u8; 1024];
    name_len: [u64 in Wrapping; 8];
    subjects: [u8; 2048];
    // Request policies: tag + three selector index lists + member masks.
    pol_tag: [u8; 8];
    pol_s: [u64 in Wrapping; 8];
    pol_t: [u64 in Wrapping; 8];
    pol_v: [u64 in Wrapping; 8];
    pol_sn: [u64 in Wrapping; 8];
    pol_tn: [u64 in Wrapping; 8];
    pol_vn: [u64 in Wrapping; 8];
    pol_slist: [u64 in Wrapping; 64];
    pol_tlist: [u64 in Wrapping; 64];
    pol_vlist: [u64 in Wrapping; 64];
    pol_off: [u64 in Wrapping; 8];
    pol_len: [u64 in Wrapping; 8];
    // Selector scratch: member mask + index list + count.
    sel_mask: u64 in Wrapping;
    sel_n: u64 in Wrapping;
    sel_prev: u64 in Wrapping;
    sel_list: [u64 in Wrapping; 8];
    verifier: [u8; 2048];
    transports: [u8; 2048];
    accepted: [u8; 2048];

    // ---- decoded plan --------------------------------------------------------
    p_commit: [u8; 2048];
    p_n: u64 in Wrapping;
    p_names: [u8; 1024];
    p_name_len: [u64 in Wrapping; 8];
    p_subjects: [u8; 2048];
    p_role: [u8; 8];
    p_profile: [u8; 2048];
    p_closure: [u8; 2048];
    p_asm_n: [u64 in Wrapping; 8];
    p_asm: [u8; 2048];
    p_ep_n: [u64 in Wrapping; 8];
    p_ep_slot: [u64 in Wrapping; 64];
    p_ep_dir: [u8; 64];
    p_ep_contract: [u8; 2048];
    n_bind: u64 in Wrapping;
    b_ii: [u64 in Wrapping; 16];
    b_is: [u64 in Wrapping; 16];
    b_ei: [u64 in Wrapping; 16];
    b_es: [u64 in Wrapping; 16];
    b_tr: [u8; 2048];
    p_npol: u64 in Wrapping;
    q_ver: [u8; 2048];
    q_tag: [u8; 8];
    q_s: [u64 in Wrapping; 8];
    q_t: [u64 in Wrapping; 8];
    q_v: [u64 in Wrapping; 8];
    q_sn: [u64 in Wrapping; 8];
    q_tn: [u64 in Wrapping; 8];
    q_vn: [u64 in Wrapping; 8];
    q_slist: [u64 in Wrapping; 64];
    q_tlist: [u64 in Wrapping; 64];
    q_vlist: [u64 in Wrapping; 64];
    q_out: [u8; 8];
    q_path_n: [u64 in Wrapping; 8];
    q_path: [u64 in Wrapping; 64];
    q_reach: [u64 in Wrapping; 8];

    // ---- admitted component facts -------------------------------------------
    n_comp: u64 in Wrapping;
    c_subj: [u8; 2048];
    c_prof: [u8; 2048];
    c_clo: [u8; 2048];
    c_asm_n: [u64 in Wrapping; 8];
    c_asm: [u8; 2048];
    c_ep_n: [u64 in Wrapping; 8];
    c_ep_slot: [u64 in Wrapping; 64];
    c_ep_dir: [u8; 64];
    c_ep_contract: [u8; 2048];

    // ---- graph + replay scratch ----------------------------------------------
    adj: [u8; 64];
    bound_imp: [u8; 64];
    seen: [u8; 8];
    reach: u64 in Wrapping;
    work: [u64 in Wrapping; 8];
    work_n: u64 in Wrapping;
    matched: [u8; 8];
}

// ---- staging ---------------------------------------------------------------
// The caller opens a stream with its byte length, then feeds bytes in
// order. A feed outside the opened extent or capacity latches `ok` false;
// nothing reads un-staged bytes (decoders bound by `*_n`, not capacity).

public machine Verify::open_stream(verify: &mut Verify, stream: u64 in Wrapping, n: u64 in Wrapping) {
    verify.cur = stream;
    verify.sn = n;
    verify.pos = 0;
    transition stream == 0 {
        true -> open_req(verify, n)
        _ -> open_plan_g(verify, stream, n)
    }

    machine open_req(verify: &mut Verify, n: u64 in Wrapping) {
        transition n <= 8192 {
            true -> apply_req(verify, n)
            _ -> bad(verify)
        }
    }
    machine apply_req(verify: &mut Verify, n: u64 in Wrapping) {
        verify.req_n = n;
        transition { _ -> done(verify) }
    }
    machine open_plan_g(verify: &mut Verify, stream: u64 in Wrapping, n: u64 in Wrapping) {
        transition stream == 1 {
            true -> open_plan(verify, n)
            _ -> open_meta_g(verify, stream, n)
        }
    }
    machine open_plan(verify: &mut Verify, n: u64 in Wrapping) {
        transition n <= 16384 {
            true -> apply_plan(verify, n)
            _ -> bad(verify)
        }
    }
    machine apply_plan(verify: &mut Verify, n: u64 in Wrapping) {
        verify.plan_n = n;
        transition { _ -> done(verify) }
    }
    machine open_meta_g(verify: &mut Verify, stream: u64 in Wrapping, n: u64 in Wrapping) {
        transition stream == 2 {
            true -> open_meta(verify, n)
            _ -> bad(verify)
        }
    }
    machine open_meta(verify: &mut Verify, n: u64 in Wrapping) {
        transition n <= 8192 {
            true -> apply_meta(verify, n)
            _ -> bad(verify)
        }
    }
    machine apply_meta(verify: &mut Verify, n: u64 in Wrapping) {
        verify.meta_n = n;
        transition { _ -> done(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Feed one byte into the opened stream at `pos`. Over-extent or
// over-capacity feeds latch `ok` false and leave the stream short-read,
// which the decoder's end checks reject as truncation.
public machine Verify::feed(verify: &mut Verify, b: u8) {
    transition verify.cur == 0 && verify.pos < verify.req_n && verify.pos < 8192 {
        true -> put_req(verify, b)
        _ -> feed_plan_g(verify, b)
    }

    machine put_req(verify: &mut Verify, b: u8) {
        verify.h0 = verify.pos;
        transition verify.h0 < 8192 {
            true -> wr_req(verify, b)
            _ -> bad(verify)
        }
    }
    machine wr_req(verify: &mut Verify, b: u8) {
        verify.req[verify.h0] = b;
        verify.pos = verify.pos + 1;
        transition { _ -> done(verify) }
    }
    machine feed_plan_g(verify: &mut Verify, b: u8) {
        transition verify.cur == 1 && verify.pos < verify.plan_n && verify.pos < 16384 {
            true -> put_plan(verify, b)
            _ -> feed_meta_g(verify, b)
        }
    }
    machine put_plan(verify: &mut Verify, b: u8) {
        verify.h0 = verify.pos;
        transition verify.h0 < 16384 {
            true -> wr_plan(verify, b)
            _ -> bad(verify)
        }
    }
    machine wr_plan(verify: &mut Verify, b: u8) {
        verify.plan[verify.h0] = b;
        verify.pos = verify.pos + 1;
        transition { _ -> done(verify) }
    }
    machine feed_meta_g(verify: &mut Verify, b: u8) {
        transition verify.cur == 2 && verify.pos < verify.meta_n && verify.pos < 8192 {
            true -> put_meta(verify, b)
            _ -> bad(verify)
        }
    }
    machine put_meta(verify: &mut Verify, b: u8) {
        verify.h0 = verify.pos;
        transition verify.h0 < 8192 {
            true -> wr_meta(verify, b)
            _ -> bad(verify)
        }
    }
    machine wr_meta(verify: &mut Verify, b: u8) {
        verify.meta[verify.h0] = b;
        verify.pos = verify.pos + 1;
        transition { _ -> done(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- byte readers ------------------------------------------------------------
// rd() consumes one byte of the `src`-selected stream into `b8`; out of
// bytes is a hard `ok` failure (truncation rejects at the outer check, not
// here — rd_bad only fires when a decoder overruns the declared extent).

machine Verify::rd(verify: &mut Verify) {
    transition verify.src == 0 && verify.rq < 8192 && verify.rq < verify.req_n {
        true -> rd_req(verify)
        _ -> rd_plan_g(verify)
    }

    machine rd_plan_g(verify: &mut Verify) {
        transition verify.src == 1 && verify.pq < 16384 && verify.pq < verify.plan_n {
            true -> rd_plan(verify)
            _ -> rd_meta_g(verify)
        }
    }
    machine rd_meta_g(verify: &mut Verify) {
        transition verify.src == 2 && verify.mq < 8192 && verify.mq < verify.meta_n {
            true -> rd_meta(verify)
            _ -> rd_bad(verify)
        }
    }
    machine rd_req(verify: &mut Verify) {
        verify.b8 = verify.req[verify.rq];
        verify.rq = verify.rq + 1;
        transition { _ -> rd_done(verify) }
    }
    machine rd_plan(verify: &mut Verify) {
        verify.b8 = verify.plan[verify.pq];
        verify.pq = verify.pq + 1;
        transition { _ -> rd_done(verify) }
    }
    machine rd_meta(verify: &mut Verify) {
        verify.b8 = verify.meta[verify.mq];
        verify.mq = verify.mq + 1;
        transition { _ -> rd_done(verify) }
    }
    machine rd_bad(verify: &mut Verify) {
        verify.ok = false;
        verify.errtag[0] = 114;
        verify.errtag[1] = 100;
        verify.errtag[2] = 88;
        verify.errtag[3] = 88;
        transition { _ -> rd_done(verify) }
    }
    machine rd_done(verify: &mut Verify) {
    }
}

// Little-endian u32 -> `w32`.
machine Verify::ru32(verify: &mut Verify) {
    verify.acc = 0;
    Verify::rd(verify);
    verify.acc = verify.acc + (verify.b8 as u64 in Wrapping);
    Verify::rd(verify);
    verify.acc = verify.acc + ((verify.b8 as u64 in Wrapping) << 8);
    Verify::rd(verify);
    verify.acc = verify.acc + ((verify.b8 as u64 in Wrapping) << 16);
    Verify::rd(verify);
    verify.acc = verify.acc + ((verify.b8 as u64 in Wrapping) << 24);
    verify.w32 = narrow_u64_to_u32_wrapping(verify.acc as u64);
}

// 32 identity bytes -> `ident`.
machine Verify::rdident(verify: &mut Verify) {
    verify.j = 0;
    transition { _ -> loop_s(verify) }
    machine loop_s(verify: &mut Verify) {
        transition verify.j < 32 && verify.ok {
            true -> apply(verify)
            _ -> done(verify)
        }
    }
    machine apply(verify: &mut Verify) {
        verify.h0 = verify.j;
        transition verify.h0 < 32 {
            true -> wr(verify)
            _ -> bad(verify)
        }
    }
    machine wr(verify: &mut Verify) {
        Verify::rd(verify);
        verify.ident[verify.h0] = verify.b8;
        verify.j = verify.j + 1;
        transition { _ -> loop_s(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// u32-length-prefixed name -> `strbuf`/`str_n` (bounded at 256).
machine Verify::rdname(verify: &mut Verify) {
    Verify::ru32(verify);
    verify.t64 = verify.w32 as u64 in Wrapping;
    transition verify.t64 > 0 && verify.t64 <= 256 && verify.ok {
        true -> init(verify)
        _ -> bad(verify)
    }
    machine init(verify: &mut Verify) {
        verify.str_n = verify.t64;
        verify.j = 0;
        transition { _ -> loop_s(verify) }
    }
    machine loop_s(verify: &mut Verify) {
        transition verify.j < verify.str_n && verify.j < 256 && verify.ok {
            true -> apply(verify)
            _ -> done(verify)
        }
    }
    machine apply(verify: &mut Verify) {
        verify.h0 = verify.j;
        transition verify.h0 < 256 {
            true -> wr(verify)
            _ -> bad(verify)
        }
    }
    machine wr(verify: &mut Verify) {
        Verify::rd(verify);
        verify.strbuf[verify.h0] = verify.b8;
        verify.j = verify.j + 1;
        transition { _ -> loop_s(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Resolve `strbuf`/`str_n` against the request roster into `sel`-style
// index — `d0` receives the member index or 255 when unknown. Names are
// canonical so roster index order is name order.
machine Verify::resolve_name(verify: &mut Verify) {
    verify.d0 = 255;
    verify.i = 0;
    transition { _ -> loop_s(verify) }
    machine loop_s(verify: &mut Verify) {
        transition verify.i < verify.n_inst && verify.i < 8 && verify.ok {
            true -> len_ck(verify)
            _ -> done(verify)
        }
    }
    machine len_ck(verify: &mut Verify) {
        transition verify.name_len[verify.i] == verify.str_n {
            true -> cmp_init(verify)
            _ -> next(verify)
        }
    }
    machine cmp_init(verify: &mut Verify) {
        verify.j = 0;
        verify.jg = 1;
        transition { _ -> cmp_loop(verify) }
    }
    machine cmp_loop(verify: &mut Verify) {
        transition verify.j < verify.str_n && verify.j < 128 && verify.jg == 1 {
            true -> prep_c(verify)
            _ -> cmp_done(verify)
        }
    }
    machine prep_c(verify: &mut Verify) {
        verify.h0 = verify.i * 128 + verify.j;
        verify.h1 = verify.j;
        transition verify.h0 < 1024 && verify.h1 < 256 {
            true -> do_c(verify)
            _ -> bad(verify)
        }
    }
    machine do_c(verify: &mut Verify) {
        verify.w8 = verify.names[verify.h0];
        transition verify.w8 == verify.strbuf[verify.h1] {
            true -> c_next(verify)
            _ -> c_diff(verify)
        }
    }
    machine c_diff(verify: &mut Verify) {
        verify.jg = 0;
        transition { _ -> cmp_loop(verify) }
    }
    machine c_next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> cmp_loop(verify) }
    }
    machine cmp_done(verify: &mut Verify) {
        transition verify.jg == 1 {
            true -> hit(verify)
            _ -> next(verify)
        }
    }
    machine hit(verify: &mut Verify) {
        verify.d0 = verify.i;
        transition { _ -> done(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> loop_s(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Compare stored roster names `a` (names[a*128..]) and `b` —
// `d0` = 0 equal, 1 a<b, 2 a>b. Byte-lexicographic, prefix-shorter first.
machine Verify::cmp_names(verify: &mut Verify, a: u64 in Wrapping, b: u64 in Wrapping) {
    verify.j = 0;
    verify.d0 = 0;
    verify.ja = a;
    verify.jb = b;
    transition verify.ja < 8 && verify.jb < 8 {
        true -> min_len(verify)
        _ -> bad(verify)
    }

    machine min_len(verify: &mut Verify) {
        transition verify.name_len[verify.ja] < verify.name_len[verify.jb] {
            true -> a_shorter(verify)
            _ -> b_shorter(verify)
        }
    }
    machine a_shorter(verify: &mut Verify) {
        verify.d1 = verify.name_len[verify.ja];
        transition { _ -> loop_s(verify) }
    }
    machine b_shorter(verify: &mut Verify) {
        verify.d1 = verify.name_len[verify.jb];
        transition { _ -> loop_s(verify) }
    }
    machine loop_s(verify: &mut Verify) {
        transition verify.j < verify.d1 && verify.j < 128 && verify.d0 == 0 {
            true -> prep(verify)
            _ -> tail(verify)
        }
    }
    machine prep(verify: &mut Verify) {
        verify.h0 = verify.ja * 128 + verify.j;
        verify.h1 = verify.jb * 128 + verify.j;
        transition verify.h0 < 1024 && verify.h1 < 1024 {
            true -> apply(verify)
            _ -> bad(verify)
        }
    }
    machine apply(verify: &mut Verify) {
        verify.w8 = verify.names[verify.h0];
        transition verify.w8 == verify.names[verify.h1] {
            true -> next(verify)
            _ -> diff(verify)
        }
    }
    machine diff(verify: &mut Verify) {
        transition verify.names[verify.h0] < verify.names[verify.h1] {
            true -> lt(verify)
            _ -> gt(verify)
        }
    }
    machine lt(verify: &mut Verify) {
        verify.d0 = 1;
        transition { _ -> done(verify) }
    }
    machine gt(verify: &mut Verify) {
        verify.d0 = 2;
        transition { _ -> done(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> loop_s(verify) }
    }
    machine tail(verify: &mut Verify) {
        transition verify.d0 != 0 {
            true -> done(verify)
            _ -> len_cmp(verify)
        }
    }
    machine len_cmp(verify: &mut Verify) {
        transition verify.ja < 8 && verify.jb < 8 {
            true -> len_cmp_rd(verify)
            _ -> bad(verify)
        }
    }
    machine len_cmp_rd(verify: &mut Verify) {
        transition verify.name_len[verify.ja] == verify.name_len[verify.jb] {
            true -> done(verify)
            _ -> len_ne(verify)
        }
    }
    machine len_ne(verify: &mut Verify) {
        transition verify.ja < 8 && verify.jb < 8 {
            true -> len_ne_rd(verify)
            _ -> bad(verify)
        }
    }
    machine len_ne_rd(verify: &mut Verify) {
        transition verify.name_len[verify.ja] < verify.name_len[verify.jb] {
            true -> lt(verify)
            _ -> gt(verify)
        }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Read one selector (u32 count + names) into `sel_mask` (index bitmask),
// `sel_list` (member indices in wire order) and `sel_n`. Wire canonical
// order is enforced as strictly increasing member indices — the roster is
// name-sorted, so increasing index order is exactly the codec's
// canonical-order and no-duplicate rule.
machine Verify::rd_selector(verify: &mut Verify) {
    Verify::ru32(verify);
    verify.sel_n = verify.w32 as u64 in Wrapping;
    verify.sel_mask = 0;
    verify.sel_prev = 0;
    transition verify.sel_n <= 8 && verify.ok {
        true -> init(verify)
        _ -> bad(verify)
    }
    machine init(verify: &mut Verify) {
        verify.j = 0;
        transition { _ -> loop_s(verify) }
    }
    machine loop_s(verify: &mut Verify) {
        transition verify.j < verify.sel_n && verify.j < 8 && verify.ok {
            true -> one(verify)
            _ -> done(verify)
        }
    }
    machine one(verify: &mut Verify) {
        Verify::rdname(verify);
        Verify::resolve_name(verify);
        transition verify.d0 < 8 && verify.ok {
            true -> order_ck(verify)
            _ -> bad(verify)
        }
    }
    machine order_ck(verify: &mut Verify) {
        transition verify.j == 0 || verify.d0 > verify.sel_prev {
            true -> record(verify)
            _ -> bad(verify)
        }
    }
    machine record(verify: &mut Verify) {
        verify.h0 = verify.j;
        transition verify.h0 < 8 {
            true -> record_w(verify)
            _ -> bad(verify)
        }
    }
    machine record_w(verify: &mut Verify) {
        verify.sel_list[verify.h0] = verify.d0;
        verify.sel_prev = verify.d0;
        verify.sel_mask = verify.sel_mask | ((1 as u64 in Wrapping) << verify.d0);
        verify.j = verify.j + 1;
        transition { _ -> loop_s(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- request decode ---------------------------------------------------------
// Layout (canonical TopologyRequest, v1): magic "OTQL" u32 | ver u32 |
// n_inst u32 | {name, subject[32]} x n_inst — names strictly increasing |
// n_pol u32 | {tag u8, 3 selectors} x n_pol — canonical-key order, pairwise
// disjoint selector sets | verifier[32] | n_tr u32 | tr[32] x n_tr —
// strictly increasing | n_acp u32 | asm[32] x n_acp — strictly increasing |
// end. Counts bound to this realization's roster scale; over-limit is a
// LimitExceeded failure, never a satisfied verdict.

machine Verify::decode_req(verify: &mut Verify) {
    verify.src = 0;
    verify.rq = 0;
    Verify::ru32(verify);
    transition verify.w32 == 1280332881 && verify.ok {
        true -> ver(verify)
        _ -> bad(verify)
    }
    machine ver(verify: &mut Verify) {
        Verify::ru32(verify);
        transition verify.w32 == 1 && verify.ok {
            true -> insts(verify)
            _ -> bad(verify)
        }
    }
    machine insts(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.n_inst = verify.w32 as u64 in Wrapping;
        transition verify.n_inst > 0 && verify.n_inst <= 8 && verify.ok {
            true -> inst_init(verify)
            _ -> bad(verify)
        }
    }
    machine inst_init(verify: &mut Verify) {
        verify.i = 0;
        verify.jg = 1;
        transition { _ -> inst_loop(verify) }
    }
    machine inst_loop(verify: &mut Verify) {
        transition verify.i < verify.n_inst && verify.i < 8 && verify.ok {
            true -> inst_name(verify)
            _ -> pols(verify)
        }
    }
    machine inst_name(verify: &mut Verify) {
        Verify::rdname(verify);
        verify.h0 = verify.i;
        transition verify.h0 < 8 && verify.ok {
            true -> set_len(verify)
            _ -> bad(verify)
        }
    }
    machine set_len(verify: &mut Verify) {
        verify.name_len[verify.h0] = verify.str_n;
        verify.k = 0;
        transition { _ -> name_copy(verify) }
    }
    machine name_copy(verify: &mut Verify) {
        transition verify.k < verify.str_n && verify.k < 128 {
            true -> prep_nc(verify)
            _ -> order_ck(verify)
        }
    }
    machine prep_nc(verify: &mut Verify) {
        verify.h1 = verify.i * 128 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 1024 && verify.h2 < 256 {
            true -> do_nc(verify)
            _ -> bad(verify)
        }
    }
    machine do_nc(verify: &mut Verify) {
        verify.names[verify.h1] = verify.strbuf[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> name_copy(verify) }
    }
    // Canonical roster: each stored name strictly greater than its
    // predecessor — duplicates and out-of-order both reject.
    machine order_ck(verify: &mut Verify) {
        transition verify.i == 0 {
            true -> inst_subj(verify)
            _ -> ord_run(verify)
        }
    }
    machine ord_run(verify: &mut Verify) {
        verify.d0 = 0;
        Verify::cmp_names(verify, verify.i - 1, verify.i);
        transition verify.d0 == 2 {
            true -> inst_subj(verify)
            _ -> bad(verify)
        }
    }
    machine inst_subj(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> subj_copy(verify) }
    }
    machine subj_copy(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> prep_sc(verify)
            _ -> subj_zero_ck(verify)
        }
    }
    machine prep_sc(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 256 && verify.h2 < 32 {
            true -> do_sc(verify)
            _ -> bad(verify)
        }
    }
    machine do_sc(verify: &mut Verify) {
        verify.subjects[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> subj_copy(verify) }
    }
    // The reserved zero identity is never a valid subject.
    machine subj_zero_ck(verify: &mut Verify) {
        verify.k = 0;
        verify.jg = 1;
        transition { _ -> szc_loop(verify) }
    }
    machine szc_loop(verify: &mut Verify) {
        transition verify.k < 32 && verify.jg == 1 {
            true -> szc_one(verify)
            _ -> szc_done(verify)
        }
    }
    machine szc_one(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        transition verify.h1 < 256 {
            true -> szc_rd(verify)
            _ -> bad(verify)
        }
    }
    machine szc_rd(verify: &mut Verify) {
        transition verify.subjects[verify.h1] != 0 {
            true -> szc_done(verify)
            _ -> szc_next(verify)
        }
    }
    machine szc_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> szc_loop(verify) }
    }
    machine szc_done(verify: &mut Verify) {
        transition verify.jg == 1 {
            true -> inst_next(verify)
            _ -> bad(verify)
        }
    }
    machine inst_next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> inst_loop(verify) }
    }
    machine pols(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.n_pol = verify.w32 as u64 in Wrapping;
        transition verify.n_pol <= 8 && verify.ok {
            true -> pol_init(verify)
            _ -> bad(verify)
        }
    }
    machine pol_init(verify: &mut Verify) {
        verify.cp = 0;
        transition { _ -> pol_loop(verify) }
    }
    machine pol_loop(verify: &mut Verify) {
        transition verify.cp < verify.n_pol && verify.cp < 8 && verify.ok {
            true -> pol_tag_r(verify)
            _ -> verifier_r(verify)
        }
    }
    machine pol_tag_r(verify: &mut Verify) {
        Verify::rd(verify);
        transition verify.ok && verify.cp < 8 {
            true -> pol_tag_set(verify)
            _ -> bad(verify)
        }
    }
    machine pol_tag_set(verify: &mut Verify) {
        verify.pol_tag[verify.cp] = verify.b8;
        transition verify.b8 == 1 || verify.b8 == 2 {
            true -> pol_s_r(verify)
            _ -> bad(verify)
        }
    }
    machine pol_s_r(verify: &mut Verify) {
        Verify::rd_selector(verify);
        transition verify.ok && verify.cp < 8 {
            true -> pol_s_set(verify)
            _ -> bad(verify)
        }
    }
    machine pol_s_set(verify: &mut Verify) {
        transition verify.sel_n > 0 {
            true -> pol_s_ok(verify)
            _ -> bad(verify)
        }
    }
    machine pol_s_ok(verify: &mut Verify) {
        verify.pol_s[verify.cp] = verify.sel_mask;
        verify.pol_sn[verify.cp] = verify.sel_n;
        verify.k = 0;
        transition { _ -> pol_s_cp(verify) }
    }
    machine pol_s_cp(verify: &mut Verify) {
        transition verify.k < verify.sel_n && verify.k < 8 {
            true -> pol_s_cp_one(verify)
            _ -> pol_t_r(verify)
        }
    }
    machine pol_s_cp_one(verify: &mut Verify) {
        verify.h0 = verify.cp * 8 + verify.k;
        verify.h1 = verify.k;
        transition verify.h0 < 64 && verify.h1 < 8 {
            true -> pol_s_cp_w(verify)
            _ -> bad(verify)
        }
    }
    machine pol_s_cp_w(verify: &mut Verify) {
        verify.pol_slist[verify.h0] = verify.sel_list[verify.h1];
        verify.k = verify.k + 1;
        transition { _ -> pol_s_cp(verify) }
    }
    machine pol_t_r(verify: &mut Verify) {
        Verify::rd_selector(verify);
        transition verify.ok && verify.cp < 8 {
            true -> pol_t_set(verify)
            _ -> bad(verify)
        }
    }
    machine pol_t_set(verify: &mut Verify) {
        transition verify.sel_n > 0 {
            true -> pol_t_ok(verify)
            _ -> bad(verify)
        }
    }
    machine pol_t_ok(verify: &mut Verify) {
        verify.pol_t[verify.cp] = verify.sel_mask;
        verify.pol_tn[verify.cp] = verify.sel_n;
        verify.k = 0;
        transition { _ -> pol_t_cp(verify) }
    }
    machine pol_t_cp(verify: &mut Verify) {
        transition verify.k < verify.sel_n && verify.k < 8 {
            true -> pol_t_cp_one(verify)
            _ -> pol_v_r(verify)
        }
    }
    machine pol_t_cp_one(verify: &mut Verify) {
        verify.h0 = verify.cp * 8 + verify.k;
        verify.h1 = verify.k;
        transition verify.h0 < 64 && verify.h1 < 8 {
            true -> pol_t_cp_w(verify)
            _ -> bad(verify)
        }
    }
    machine pol_t_cp_w(verify: &mut Verify) {
        verify.pol_tlist[verify.h0] = verify.sel_list[verify.h1];
        verify.k = verify.k + 1;
        transition { _ -> pol_t_cp(verify) }
    }
    machine pol_v_r(verify: &mut Verify) {
        Verify::rd_selector(verify);
        transition verify.ok && verify.cp < 8 {
            true -> pol_v_set(verify)
            _ -> bad(verify)
        }
    }
    machine pol_v_set(verify: &mut Verify) {
        verify.pol_v[verify.cp] = verify.sel_mask;
        verify.pol_vn[verify.cp] = verify.sel_n;
        verify.k = 0;
        transition { _ -> pol_v_cp(verify) }
    }
    machine pol_v_cp(verify: &mut Verify) {
        transition verify.k < verify.sel_n && verify.k < 8 {
            true -> pol_v_cp_one(verify)
            _ -> pol_arity_ck(verify)
        }
    }
    machine pol_v_cp_one(verify: &mut Verify) {
        verify.h0 = verify.cp * 8 + verify.k;
        verify.h1 = verify.k;
        transition verify.h0 < 64 && verify.h1 < 8 {
            true -> pol_v_cp_w(verify)
            _ -> bad(verify)
        }
    }
    machine pol_v_cp_w(verify: &mut Verify) {
        verify.pol_vlist[verify.h0] = verify.sel_list[verify.h1];
        verify.k = verify.k + 1;
        transition { _ -> pol_v_cp(verify) }
    }
    // via arity: empty for no_route, non-empty for only_via.
    machine pol_arity_ck(verify: &mut Verify) {
        transition verify.cp < 8 {
            true -> pol_arity_rd(verify)
            _ -> bad(verify)
        }
    }
    machine pol_arity_rd(verify: &mut Verify) {
        transition (verify.pol_tag[verify.cp] == 1 && verify.sel_n == 0) || (verify.pol_tag[verify.cp] == 2 && verify.sel_n > 0) {
            true -> pol_disj(verify)
            _ -> bad(verify)
        }
    }
    // sources/targets/via are pairwise disjoint.
    machine pol_disj(verify: &mut Verify) {
        transition verify.cp < 8 {
            true -> pol_disj_rd(verify)
            _ -> bad(verify)
        }
    }
    machine pol_disj_rd(verify: &mut Verify) {
        verify.t64 = (verify.pol_s[verify.cp] & verify.pol_t[verify.cp]) | (verify.pol_s[verify.cp] & verify.pol_v[verify.cp]) | (verify.pol_t[verify.cp] & verify.pol_v[verify.cp]);
        transition verify.t64 == 0 {
            true -> pol_next(verify)
            _ -> bad(verify)
        }
    }
    machine pol_next(verify: &mut Verify) {
        verify.cp = verify.cp + 1;
        transition { _ -> pol_loop(verify) }
    }
    machine verifier_r(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> ver_copy(verify) }
    }
    machine ver_copy(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> prep_vc(verify)
            _ -> transports_r(verify)
        }
    }
    machine prep_vc(verify: &mut Verify) {
        verify.h2 = verify.k;
        transition verify.h2 < 32 {
            true -> do_vc(verify)
            _ -> bad(verify)
        }
    }
    machine do_vc(verify: &mut Verify) {
        verify.verifier[verify.h2] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> ver_copy(verify) }
    }
    machine transports_r(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.n_tr = verify.w32 as u64 in Wrapping;
        transition verify.n_tr > 0 && verify.n_tr <= 8 && verify.ok {
            true -> tr_init(verify)
            _ -> bad(verify)
        }
    }
    machine tr_init(verify: &mut Verify) {
        verify.i = 0;
        transition { _ -> tr_loop(verify) }
    }
    machine tr_loop(verify: &mut Verify) {
        transition verify.i < verify.n_tr && verify.i < 8 && verify.ok {
            true -> tr_one(verify)
            _ -> acp_r(verify)
        }
    }
    machine tr_one(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> tr_copy(verify) }
    }
    machine tr_copy(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> prep_tc(verify)
            _ -> tr_next(verify)
        }
    }
    machine prep_tc(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 256 && verify.h2 < 32 {
            true -> do_tc(verify)
            _ -> bad(verify)
        }
    }
    machine do_tc(verify: &mut Verify) {
        verify.transports[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> tr_copy(verify) }
    }
    machine tr_next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> tr_loop(verify) }
    }
    machine acp_r(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.n_acp = verify.w32 as u64 in Wrapping;
        transition verify.n_acp <= 32 && verify.ok {
            true -> acp_init(verify)
            _ -> bad(verify)
        }
    }
    machine acp_init(verify: &mut Verify) {
        verify.i = 0;
        transition { _ -> acp_loop(verify) }
    }
    machine acp_loop(verify: &mut Verify) {
        transition verify.i < verify.n_acp && verify.i < 32 && verify.ok {
            true -> acp_one(verify)
            _ -> fin(verify)
        }
    }
    machine acp_one(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> acp_copy(verify) }
    }
    machine acp_copy(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> prep_ac(verify)
            _ -> acp_next(verify)
        }
    }
    machine prep_ac(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 1024 && verify.h2 < 32 {
            true -> do_ac(verify)
            _ -> bad(verify)
        }
    }
    machine do_ac(verify: &mut Verify) {
        verify.accepted[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> acp_copy(verify) }
    }
    machine acp_next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> acp_loop(verify) }
    }
    machine fin(verify: &mut Verify) {
        transition verify.rq == verify.req_n && verify.ok {
            true -> done(verify)
            _ -> bad(verify)
        }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Compare two stored plan-roster names `a`/`b` (p_names) — same protocol
// as cmp_names: `d0` = 0 equal, 1 a<b, 2 a>b.
machine Verify::cmp_pnames(verify: &mut Verify, a: u64 in Wrapping, b: u64 in Wrapping) {
    verify.j = 0;
    verify.d0 = 0;
    verify.ja = a;
    verify.jb = b;
    transition verify.ja < 8 && verify.jb < 8 {
        true -> min_len(verify)
        _ -> bad(verify)
    }

    machine min_len(verify: &mut Verify) {
        transition verify.p_name_len[verify.ja] < verify.p_name_len[verify.jb] {
            true -> a_shorter(verify)
            _ -> b_shorter(verify)
        }
    }
    machine a_shorter(verify: &mut Verify) {
        verify.d1 = verify.p_name_len[verify.ja];
        transition { _ -> loop_s(verify) }
    }
    machine b_shorter(verify: &mut Verify) {
        verify.d1 = verify.p_name_len[verify.jb];
        transition { _ -> loop_s(verify) }
    }
    machine loop_s(verify: &mut Verify) {
        transition verify.j < verify.d1 && verify.j < 128 && verify.d0 == 0 {
            true -> prep(verify)
            _ -> tail(verify)
        }
    }
    machine prep(verify: &mut Verify) {
        verify.h0 = verify.ja * 128 + verify.j;
        verify.h1 = verify.jb * 128 + verify.j;
        transition verify.h0 < 1024 && verify.h1 < 1024 {
            true -> apply(verify)
            _ -> bad(verify)
        }
    }
    machine apply(verify: &mut Verify) {
        verify.w8 = verify.p_names[verify.h0];
        transition verify.w8 == verify.p_names[verify.h1] {
            true -> next(verify)
            _ -> diff(verify)
        }
    }
    machine diff(verify: &mut Verify) {
        transition verify.p_names[verify.h0] < verify.p_names[verify.h1] {
            true -> lt(verify)
            _ -> gt(verify)
        }
    }
    machine lt(verify: &mut Verify) {
        verify.d0 = 1;
        transition { _ -> done(verify) }
    }
    machine gt(verify: &mut Verify) {
        verify.d0 = 2;
        transition { _ -> done(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> loop_s(verify) }
    }
    machine tail(verify: &mut Verify) {
        transition verify.d0 != 0 {
            true -> done(verify)
            _ -> len_cmp(verify)
        }
    }
    machine len_cmp(verify: &mut Verify) {
        transition verify.ja < 8 && verify.jb < 8 {
            true -> len_cmp_rd(verify)
            _ -> bad(verify)
        }
    }
    machine len_cmp_rd(verify: &mut Verify) {
        transition verify.p_name_len[verify.ja] == verify.p_name_len[verify.jb] {
            true -> done(verify)
            _ -> len_ne(verify)
        }
    }
    machine len_ne(verify: &mut Verify) {
        transition verify.ja < 8 && verify.jb < 8 {
            true -> len_ne_rd(verify)
            _ -> bad(verify)
        }
    }
    machine len_ne_rd(verify: &mut Verify) {
        transition verify.p_name_len[verify.ja] < verify.p_name_len[verify.jb] {
            true -> lt(verify)
            _ -> gt(verify)
        }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Compare 32-byte identities across tables: left = table `cb` at index
// `a`, right = table `cb2` at index `b` — `d0` = 0 equal, 1 a<b, 2 a>b.
// Table codes (both selectors): 0=subjects(request) 1=p_subjects
// 2=p_profile 3=p_closure 4=p_asm 5=c_subj 6=c_prof 7=c_clo 8=c_asm
// 9=transports 10=accepted 11=verifier 12=p_commit 13=q_ver 14=b_tr
// 15=ident 16=p_ep_contract 17=c_ep_contract. For the per-record blocks
// (p_asm, c_asm, p_ep_contract, c_ep_contract) `a`/`b` are flat 32-byte
// row indices.
machine Verify::cmp_ident(verify: &mut Verify, a: u64 in Wrapping, b: u64 in Wrapping) {
    verify.j = 0;
    verify.d0 = 0;
    verify.ja = a;
    verify.jb = b;
    transition { _ -> loop_s(verify) }

    machine loop_s(verify: &mut Verify) {
        transition verify.j < 32 && verify.d0 == 0 {
            true -> offs(verify)
            _ -> done(verify)
        }
    }
    machine offs(verify: &mut Verify) {
        verify.h0 = verify.ja * 32 + verify.j;
        verify.h1 = verify.jb * 32 + verify.j;
        transition verify.h0 < 2048 && verify.h1 < 2048 {
            true -> lload(verify)
            _ -> bad(verify)
        }
    }
    machine lload(verify: &mut Verify) {
        Verify::load_l(verify);
        Verify::load_r(verify);
        transition { _ -> cmp(verify) }
    }
    machine cmp(verify: &mut Verify) {
        transition verify.w8 == verify.b8 {
            true -> eq(verify)
            _ -> ne(verify)
        }
    }
    machine eq(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> loop_s(verify) }
    }
    machine ne(verify: &mut Verify) {
        transition verify.w8 < verify.b8 {
            true -> lt(verify)
            _ -> gt(verify)
        }
    }
    machine lt(verify: &mut Verify) {
        verify.d0 = 1;
        transition { _ -> done(verify) }
    }
    machine gt(verify: &mut Verify) {
        verify.d0 = 2;
        transition { _ -> done(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Read table `cb` at `h0` into `w8`.
machine Verify::load_l(verify: &mut Verify) {
    transition verify.h0 < 2048 {
        true -> dispatch(verify)
        _ -> bad(verify)
    }
    machine dispatch(verify: &mut Verify) {
        transition verify.cb == 0 {
            true -> t0(verify)
            _ -> g1(verify)
        }
    }
    machine t0(verify: &mut Verify) { verify.w8 = verify.subjects[verify.h0]; }
    machine g1(verify: &mut Verify) {
        transition verify.cb == 1 { true -> t1(verify) _ -> g2(verify) }
    }
    machine t1(verify: &mut Verify) { verify.w8 = verify.p_subjects[verify.h0]; }
    machine g2(verify: &mut Verify) {
        transition verify.cb == 2 { true -> t2(verify) _ -> g3(verify) }
    }
    machine t2(verify: &mut Verify) { verify.w8 = verify.p_profile[verify.h0]; }
    machine g3(verify: &mut Verify) {
        transition verify.cb == 3 { true -> t3(verify) _ -> g4(verify) }
    }
    machine t3(verify: &mut Verify) { verify.w8 = verify.p_closure[verify.h0]; }
    machine g4(verify: &mut Verify) {
        transition verify.cb == 4 { true -> t4(verify) _ -> g5(verify) }
    }
    machine t4(verify: &mut Verify) { verify.w8 = verify.p_asm[verify.h0]; }
    machine g5(verify: &mut Verify) {
        transition verify.cb == 5 { true -> t5(verify) _ -> g6(verify) }
    }
    machine t5(verify: &mut Verify) { verify.w8 = verify.c_subj[verify.h0]; }
    machine g6(verify: &mut Verify) {
        transition verify.cb == 6 { true -> t6(verify) _ -> g7(verify) }
    }
    machine t6(verify: &mut Verify) { verify.w8 = verify.c_prof[verify.h0]; }
    machine g7(verify: &mut Verify) {
        transition verify.cb == 7 { true -> t7(verify) _ -> g8(verify) }
    }
    machine t7(verify: &mut Verify) { verify.w8 = verify.c_clo[verify.h0]; }
    machine g8(verify: &mut Verify) {
        transition verify.cb == 8 { true -> t8(verify) _ -> g9(verify) }
    }
    machine t8(verify: &mut Verify) { verify.w8 = verify.c_asm[verify.h0]; }
    machine g9(verify: &mut Verify) {
        transition verify.cb == 9 { true -> t9(verify) _ -> g10(verify) }
    }
    machine t9(verify: &mut Verify) { verify.w8 = verify.transports[verify.h0]; }
    machine g10(verify: &mut Verify) {
        transition verify.cb == 10 { true -> t10(verify) _ -> g11(verify) }
    }
    machine t10(verify: &mut Verify) { verify.w8 = verify.accepted[verify.h0]; }
    machine g11(verify: &mut Verify) {
        transition verify.cb == 11 { true -> t11(verify) _ -> g12(verify) }
    }
    machine t11(verify: &mut Verify) { verify.w8 = verify.verifier[verify.h0]; }
    machine g12(verify: &mut Verify) {
        transition verify.cb == 12 { true -> t12(verify) _ -> g13(verify) }
    }
    machine t12(verify: &mut Verify) { verify.w8 = verify.p_commit[verify.h0]; }
    machine g13(verify: &mut Verify) {
        transition verify.cb == 13 { true -> t13(verify) _ -> g14(verify) }
    }
    machine t13(verify: &mut Verify) { verify.w8 = verify.q_ver[verify.h0]; }
    machine g14(verify: &mut Verify) {
        transition verify.cb == 14 { true -> t14(verify) _ -> g15(verify) }
    }
    machine t14(verify: &mut Verify) { verify.w8 = verify.b_tr[verify.h0]; }
    machine g15(verify: &mut Verify) {
        transition verify.cb == 15 { true -> t15(verify) _ -> g16(verify) }
    }
    machine t15(verify: &mut Verify) { verify.w8 = verify.ident[verify.h0]; }
    machine g16(verify: &mut Verify) {
        transition verify.cb == 16 { true -> t16(verify) _ -> g17(verify) }
    }
    machine t16(verify: &mut Verify) { verify.w8 = verify.p_ep_contract[verify.h0]; }
    machine g17(verify: &mut Verify) {
        transition verify.cb == 17 { true -> t17(verify) _ -> bad(verify) }
    }
    machine t17(verify: &mut Verify) { verify.w8 = verify.c_ep_contract[verify.h0]; }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
    }
}

// Read table `cb2` at `h1` into `b8`.
machine Verify::load_r(verify: &mut Verify) {
    transition verify.h1 < 2048 {
        true -> dispatch(verify)
        _ -> bad(verify)
    }
    machine dispatch(verify: &mut Verify) {
        transition verify.cb2 == 0 {
            true -> t0(verify)
            _ -> g1(verify)
        }
    }
    machine t0(verify: &mut Verify) { verify.b8 = verify.subjects[verify.h1]; }
    machine g1(verify: &mut Verify) {
        transition verify.cb2 == 1 { true -> t1(verify) _ -> g2(verify) }
    }
    machine t1(verify: &mut Verify) { verify.b8 = verify.p_subjects[verify.h1]; }
    machine g2(verify: &mut Verify) {
        transition verify.cb2 == 2 { true -> t2(verify) _ -> g3(verify) }
    }
    machine t2(verify: &mut Verify) { verify.b8 = verify.p_profile[verify.h1]; }
    machine g3(verify: &mut Verify) {
        transition verify.cb2 == 3 { true -> t3(verify) _ -> g4(verify) }
    }
    machine t3(verify: &mut Verify) { verify.b8 = verify.p_closure[verify.h1]; }
    machine g4(verify: &mut Verify) {
        transition verify.cb2 == 4 { true -> t4(verify) _ -> g5(verify) }
    }
    machine t4(verify: &mut Verify) { verify.b8 = verify.p_asm[verify.h1]; }
    machine g5(verify: &mut Verify) {
        transition verify.cb2 == 5 { true -> t5(verify) _ -> g6(verify) }
    }
    machine t5(verify: &mut Verify) { verify.b8 = verify.c_subj[verify.h1]; }
    machine g6(verify: &mut Verify) {
        transition verify.cb2 == 6 { true -> t6(verify) _ -> g7(verify) }
    }
    machine t6(verify: &mut Verify) { verify.b8 = verify.c_prof[verify.h1]; }
    machine g7(verify: &mut Verify) {
        transition verify.cb2 == 7 { true -> t7(verify) _ -> g8(verify) }
    }
    machine t7(verify: &mut Verify) { verify.b8 = verify.c_clo[verify.h1]; }
    machine g8(verify: &mut Verify) {
        transition verify.cb2 == 8 { true -> t8(verify) _ -> g9(verify) }
    }
    machine t8(verify: &mut Verify) { verify.b8 = verify.c_asm[verify.h1]; }
    machine g9(verify: &mut Verify) {
        transition verify.cb2 == 9 { true -> t9(verify) _ -> g10(verify) }
    }
    machine t9(verify: &mut Verify) { verify.b8 = verify.transports[verify.h1]; }
    machine g10(verify: &mut Verify) {
        transition verify.cb2 == 10 { true -> t10(verify) _ -> g11(verify) }
    }
    machine t10(verify: &mut Verify) { verify.b8 = verify.accepted[verify.h1]; }
    machine g11(verify: &mut Verify) {
        transition verify.cb2 == 11 { true -> t11(verify) _ -> g12(verify) }
    }
    machine t11(verify: &mut Verify) { verify.b8 = verify.verifier[verify.h1]; }
    machine g12(verify: &mut Verify) {
        transition verify.cb2 == 12 { true -> t12(verify) _ -> g13(verify) }
    }
    machine t12(verify: &mut Verify) { verify.b8 = verify.p_commit[verify.h1]; }
    machine g13(verify: &mut Verify) {
        transition verify.cb2 == 13 { true -> t13(verify) _ -> g14(verify) }
    }
    machine t13(verify: &mut Verify) { verify.b8 = verify.q_ver[verify.h1]; }
    machine g14(verify: &mut Verify) {
        transition verify.cb2 == 14 { true -> t14(verify) _ -> g15(verify) }
    }
    machine t14(verify: &mut Verify) { verify.b8 = verify.b_tr[verify.h1]; }
    machine g15(verify: &mut Verify) {
        transition verify.cb2 == 15 { true -> t15(verify) _ -> g16(verify) }
    }
    machine t15(verify: &mut Verify) { verify.b8 = verify.ident[verify.h1]; }
    machine g16(verify: &mut Verify) {
        transition verify.cb2 == 16 { true -> t16(verify) _ -> g17(verify) }
    }
    machine t16(verify: &mut Verify) { verify.b8 = verify.p_ep_contract[verify.h1]; }
    machine g17(verify: &mut Verify) {
        transition verify.cb2 == 17 { true -> t17(verify) _ -> bad(verify) }
    }
    machine t17(verify: &mut Verify) { verify.b8 = verify.c_ep_contract[verify.h1]; }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
    }
}

// ---- components.bin decode ---------------------------------------------------
// {u32 n} + n admitted-facts records, each:
//   subject[32] | profile[32] | closure[32] |
//   u32 n_asm + asm[32] x n_asm (n_asm <= 4) |
//   u32 n_ep + (u32 slot, u8 dir, contract[32]) x n_ep (n_ep <= 8,
//   (slot,dir) strictly increasing).
// The caller publishes what its component verifier established; the plan's
// component record must equal it field-for-field.
machine Verify::decode_meta(verify: &mut Verify) {
    verify.src = 2;
    verify.mq = 0;
    Verify::ru32(verify);
    verify.n_comp = verify.w32 as u64 in Wrapping;
    transition verify.n_comp <= 8 && verify.ok {
        true -> init(verify)
        _ -> bad(verify)
    }
    machine init(verify: &mut Verify) {
        verify.i = 0;
        transition { _ -> loop_s(verify) }
    }
    machine loop_s(verify: &mut Verify) {
        transition verify.i < verify.n_comp && verify.i < 8 && verify.ok {
            true -> subj(verify)
            _ -> fin(verify)
        }
    }
    machine subj(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> subj_cp(verify) }
    }
    machine subj_cp(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> subj_p(verify)
            _ -> prof(verify)
        }
    }
    machine subj_p(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 256 && verify.h2 < 32 {
            true -> subj_w(verify)
            _ -> bad(verify)
        }
    }
    machine subj_w(verify: &mut Verify) {
        verify.c_subj[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> subj_cp(verify) }
    }
    machine prof(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> prof_cp(verify) }
    }
    machine prof_cp(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> prof_p(verify)
            _ -> clo(verify)
        }
    }
    machine prof_p(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 256 && verify.h2 < 32 {
            true -> prof_w(verify)
            _ -> bad(verify)
        }
    }
    machine prof_w(verify: &mut Verify) {
        verify.c_prof[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> prof_cp(verify) }
    }
    machine clo(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> clo_cp(verify) }
    }
    machine clo_cp(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> clo_p(verify)
            _ -> asm_n(verify)
        }
    }
    machine clo_p(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 256 && verify.h2 < 32 {
            true -> clo_w(verify)
            _ -> bad(verify)
        }
    }
    machine clo_w(verify: &mut Verify) {
        verify.c_clo[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> clo_cp(verify) }
    }
    machine asm_n(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.t64 = verify.w32 as u64 in Wrapping;
        verify.h0 = verify.i;
        transition verify.t64 <= 4 && verify.h0 < 8 && verify.ok {
            true -> asm_set(verify)
            _ -> bad(verify)
        }
    }
    machine asm_set(verify: &mut Verify) {
        verify.c_asm_n[verify.h0] = verify.t64;
        verify.k = 0;
        transition { _ -> asm_loop(verify) }
    }
    machine asm_loop(verify: &mut Verify) {
        transition verify.k < verify.t64 && verify.k < 4 && verify.ok {
            true -> asm_one(verify)
            _ -> ep_n(verify)
        }
    }
    machine asm_one(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.j = 0;
        transition { _ -> asm_cp(verify) }
    }
    machine asm_cp(verify: &mut Verify) {
        transition verify.j < 32 {
            true -> asm_p(verify)
            _ -> asm_next(verify)
        }
    }
    machine asm_p(verify: &mut Verify) {
        verify.h1 = (verify.i * 4 + verify.k) * 32 + verify.j;
        verify.h2 = verify.j;
        transition verify.h1 < 1024 && verify.h2 < 32 {
            true -> asm_w(verify)
            _ -> bad(verify)
        }
    }
    machine asm_w(verify: &mut Verify) {
        verify.c_asm[verify.h1] = verify.ident[verify.h2];
        verify.j = verify.j + 1;
        transition { _ -> asm_cp(verify) }
    }
    machine asm_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> asm_loop(verify) }
    }
    machine ep_n(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.t64 = verify.w32 as u64 in Wrapping;
        verify.h0 = verify.i;
        transition verify.t64 <= 8 && verify.h0 < 8 && verify.ok {
            true -> ep_set(verify)
            _ -> bad(verify)
        }
    }
    machine ep_set(verify: &mut Verify) {
        verify.c_ep_n[verify.h0] = verify.t64;
        verify.k = 0;
        verify.jd = 0;
        transition { _ -> ep_loop(verify) }
    }
    machine ep_loop(verify: &mut Verify) {
        transition verify.k < verify.t64 && verify.k < 8 && verify.ok {
            true -> ep_slot(verify)
            _ -> next(verify)
        }
    }
    machine ep_slot(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.h1 = verify.i * 8 + verify.k;
        transition verify.h1 < 64 && verify.ok {
            true -> ep_slot_w(verify)
            _ -> bad(verify)
        }
    }
    machine ep_slot_w(verify: &mut Verify) {
        verify.c_ep_slot[verify.h1] = verify.w32 as u64 in Wrapping;
        transition { _ -> ep_dir(verify) }
    }
    machine ep_dir(verify: &mut Verify) {
        Verify::rd(verify);
        transition verify.ok && verify.h1 < 64 {
            true -> ep_dir_ck(verify)
            _ -> bad(verify)
        }
    }
    machine ep_dir_ck(verify: &mut Verify) {
        transition verify.b8 == 0 || verify.b8 == 1 {
            true -> ep_dir_w(verify)
            _ -> bad(verify)
        }
    }
    machine ep_dir_w(verify: &mut Verify) {
        verify.c_ep_dir[verify.h1] = verify.b8;
        // Canonical (slot,direction) order: packed key must strictly increase.
        verify.je = verify.c_ep_slot[verify.h1] * 2 + (verify.b8 as u64 in Wrapping);
        transition verify.k == 0 || verify.je > verify.jd {
            true -> ep_ord(verify)
            _ -> bad(verify)
        }
    }
    machine ep_ord(verify: &mut Verify) {
        verify.jd = verify.je;
        transition { _ -> ep_contract(verify) }
    }
    machine ep_contract(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.j = 0;
        transition { _ -> ep_cp(verify) }
    }
    machine ep_cp(verify: &mut Verify) {
        transition verify.j < 32 {
            true -> ep_p(verify)
            _ -> ep_next(verify)
        }
    }
    machine ep_p(verify: &mut Verify) {
        verify.h2 = verify.j;
        transition verify.h1 < 64 && verify.h2 < 32 {
            true -> ep_p2(verify)
            _ -> bad(verify)
        }
    }
    machine ep_p2(verify: &mut Verify) {
        verify.h3 = verify.h1 * 32 + verify.h2;
        transition verify.h3 < 2048 {
            true -> ep_w(verify)
            _ -> bad(verify)
        }
    }
    machine ep_w(verify: &mut Verify) {
        verify.c_ep_contract[verify.h3] = verify.ident[verify.h2];
        verify.j = verify.j + 1;
        transition { _ -> ep_cp(verify) }
    }
    machine ep_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> ep_loop(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> loop_s(verify) }
    }
    machine fin(verify: &mut Verify) {
        transition verify.mq == verify.meta_n && verify.ok {
            true -> done(verify)
            _ -> bad(verify)
        }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Resolve `strbuf`/`str_n` against the PLAN roster — `d0` = member index
// or 255 when unknown.
machine Verify::resolve_pname(verify: &mut Verify) {
    verify.d0 = 255;
    verify.i = 0;
    transition { _ -> loop_s(verify) }
    machine loop_s(verify: &mut Verify) {
        transition verify.i < verify.p_n && verify.i < 8 && verify.ok {
            true -> len_ck(verify)
            _ -> done(verify)
        }
    }
    machine len_ck(verify: &mut Verify) {
        transition verify.p_name_len[verify.i] == verify.str_n {
            true -> cmp_init(verify)
            _ -> next(verify)
        }
    }
    machine cmp_init(verify: &mut Verify) {
        verify.j = 0;
        verify.jg = 1;
        transition { _ -> cmp_loop(verify) }
    }
    machine cmp_loop(verify: &mut Verify) {
        transition verify.j < verify.str_n && verify.j < 128 && verify.jg == 1 {
            true -> prep_c(verify)
            _ -> cmp_done(verify)
        }
    }
    machine prep_c(verify: &mut Verify) {
        verify.h0 = verify.i * 128 + verify.j;
        verify.h1 = verify.j;
        transition verify.h0 < 1024 && verify.h1 < 256 {
            true -> do_c(verify)
            _ -> bad(verify)
        }
    }
    machine do_c(verify: &mut Verify) {
        verify.w8 = verify.p_names[verify.h0];
        transition verify.w8 == verify.strbuf[verify.h1] {
            true -> c_next(verify)
            _ -> c_diff(verify)
        }
    }
    machine c_diff(verify: &mut Verify) {
        verify.jg = 0;
        transition { _ -> cmp_loop(verify) }
    }
    machine c_next(verify: &mut Verify) {
        verify.j = verify.j + 1;
        transition { _ -> cmp_loop(verify) }
    }
    machine cmp_done(verify: &mut Verify) {
        transition verify.jg == 1 {
            true -> hit(verify)
            _ -> next(verify)
        }
    }
    machine hit(verify: &mut Verify) {
        verify.d0 = verify.i;
        transition { _ -> done(verify) }
    }
    machine next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> loop_s(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// Plan-side selector read — same canonical rule as rd_selector but
// resolves against the plan roster.
machine Verify::rd_pselector(verify: &mut Verify) {
    Verify::ru32(verify);
    verify.sel_n = verify.w32 as u64 in Wrapping;
    verify.sel_mask = 0;
    verify.sel_prev = 0;
    transition verify.sel_n <= 8 && verify.ok {
        true -> init(verify)
        _ -> bad(verify)
    }
    machine init(verify: &mut Verify) {
        verify.j = 0;
        transition { _ -> loop_s(verify) }
    }
    machine loop_s(verify: &mut Verify) {
        transition verify.j < verify.sel_n && verify.j < 8 && verify.ok {
            true -> one(verify)
            _ -> done(verify)
        }
    }
    machine one(verify: &mut Verify) {
        Verify::rdname(verify);
        Verify::resolve_pname(verify);
        transition verify.d0 < 8 && verify.ok {
            true -> order_ck(verify)
            _ -> bad(verify)
        }
    }
    machine order_ck(verify: &mut Verify) {
        transition verify.j == 0 || verify.d0 > verify.sel_prev {
            true -> record(verify)
            _ -> bad(verify)
        }
    }
    machine record(verify: &mut Verify) {
        verify.h0 = verify.j;
        transition verify.h0 < 8 {
            true -> record_w(verify)
            _ -> bad(verify)
        }
    }
    machine record_w(verify: &mut Verify) {
        verify.sel_list[verify.h0] = verify.d0;
        verify.sel_prev = verify.d0;
        verify.sel_mask = verify.sel_mask | ((1 as u64 in Wrapping) << verify.d0);
        verify.j = verify.j + 1;
        transition { _ -> loop_s(verify) }
    }
    machine bad(verify: &mut Verify) {
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine done(verify: &mut Verify) {
    }
}

// ---- plan decode --------------------------------------------------------------
// Layout (canonical DeploymentPlan, v1): magic "OTPL" u32 (0x4C505450 =
// 1280332880) | ver u32 | request_commitment[32] | n_inst u32 |
// per-instance {name, role u8 (0 component / 1 external), subject[32],
// profile[32], completeness u8, [closure[32]], n_asm u32 + asm[32]x,
// n_ep u32 + (slot u32, dir u8, contract[32]) x n_ep} | n_bind u32 |
// {ii,is,ei,es u32 + transport[32]} x n_bind — canonical packed order |
// n_pol u32 | {verifier[32], tag u8, 3 selectors, outcome} x n_pol |
// end. Completeness tag 1 = VerifiedComplete carries the closure;
// producer-declared (0) and early-frontier (2) are the named
// UnverifiedCompleteness rejections; any other tag is malformed.

machine Verify::decode_plan(verify: &mut Verify) {
    verify.src = 1;
    verify.pq = 0;
    Verify::ru32(verify);
    transition verify.w32 == 1280332880 && verify.ok {
        true -> ver(verify)
        _ -> bad(verify)
    }
    machine ver(verify: &mut Verify) {
        Verify::ru32(verify);
        transition verify.w32 == 1 && verify.ok {
            true -> commit(verify)
            _ -> bad(verify)
        }
    }
    machine commit(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> commit_cp(verify) }
    }
    machine commit_cp(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> commit_p(verify)
            _ -> insts(verify)
        }
    }
    machine commit_p(verify: &mut Verify) {
        verify.h2 = verify.k;
        transition verify.h2 < 32 {
            true -> commit_w(verify)
            _ -> bad(verify)
        }
    }
    machine commit_w(verify: &mut Verify) {
        verify.p_commit[verify.h2] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> commit_cp(verify) }
    }
    machine insts(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.p_n = verify.w32 as u64 in Wrapping;
        transition verify.p_n > 0 && verify.p_n <= 8 && verify.ok {
            true -> inst_init(verify)
            _ -> bad(verify)
        }
    }
    machine inst_init(verify: &mut Verify) {
        verify.i = 0;
        transition { _ -> inst_loop(verify) }
    }
    machine inst_loop(verify: &mut Verify) {
        transition verify.i < verify.p_n && verify.i < 8 && verify.ok {
            true -> inst_name(verify)
            _ -> binds(verify)
        }
    }
    machine inst_name(verify: &mut Verify) {
        Verify::rdname(verify);
        verify.h0 = verify.i;
        transition verify.h0 < 8 && verify.ok {
            true -> set_len(verify)
            _ -> bad(verify)
        }
    }
    machine set_len(verify: &mut Verify) {
        verify.p_name_len[verify.h0] = verify.str_n;
        verify.k = 0;
        transition { _ -> name_copy(verify) }
    }
    machine name_copy(verify: &mut Verify) {
        transition verify.k < verify.str_n && verify.k < 128 {
            true -> prep_nc(verify)
            _ -> order_ck(verify)
        }
    }
    machine prep_nc(verify: &mut Verify) {
        verify.h1 = verify.i * 128 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 1024 && verify.h2 < 256 {
            true -> do_nc(verify)
            _ -> bad(verify)
        }
    }
    machine do_nc(verify: &mut Verify) {
        verify.p_names[verify.h1] = verify.strbuf[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> name_copy(verify) }
    }
    machine order_ck(verify: &mut Verify) {
        transition verify.i == 0 {
            true -> role(verify)
            _ -> ord_run(verify)
        }
    }
    machine ord_run(verify: &mut Verify) {
        verify.d0 = 0;
        Verify::cmp_pnames(verify, verify.i - 1, verify.i);
        transition verify.d0 == 2 {
            true -> role(verify)
            _ -> bad(verify)
        }
    }
    machine role(verify: &mut Verify) {
        Verify::rd(verify);
        transition verify.ok && verify.i < 8 {
            true -> role_set(verify)
            _ -> bad(verify)
        }
    }
    machine role_set(verify: &mut Verify) {
        transition verify.b8 == 0 || verify.b8 == 1 {
            true -> role_w(verify)
            _ -> bad(verify)
        }
    }
    machine role_w(verify: &mut Verify) {
        verify.p_role[verify.i] = verify.b8;
        transition { _ -> psubj(verify) }
    }
    machine psubj(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> psubj_cp(verify) }
    }
    machine psubj_cp(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> psubj_p(verify)
            _ -> pprof(verify)
        }
    }
    machine psubj_p(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 256 && verify.h2 < 32 {
            true -> psubj_w(verify)
            _ -> bad(verify)
        }
    }
    machine psubj_w(verify: &mut Verify) {
        verify.p_subjects[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> psubj_cp(verify) }
    }
    machine pprof(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> pprof_cp(verify) }
    }
    machine pprof_cp(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> pprof_p(verify)
            _ -> comp_tag(verify)
        }
    }
    machine pprof_p(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 256 && verify.h2 < 32 {
            true -> pprof_w(verify)
            _ -> bad(verify)
        }
    }
    machine pprof_w(verify: &mut Verify) {
        verify.p_profile[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> pprof_cp(verify) }
    }
    // Completeness tag: 1 = VerifiedComplete{closure} admitted; 0 or 2 are
    // the contract's named UnverifiedCompleteness rejections (verdict 3);
    // anything else is a malformed plan (verdict 2).
    machine comp_tag(verify: &mut Verify) {
        Verify::rd(verify);
        transition verify.b8 == 1 && verify.ok {
            true -> clo(verify)
            _ -> comp_other(verify)
        }
    }
    machine comp_other(verify: &mut Verify) {
        transition verify.b8 == 0 || verify.b8 == 2 {
            true -> comp_unv(verify)
            _ -> bad(verify)
        }
    }
    machine comp_unv(verify: &mut Verify) {
        verify.verdict = 3;
        verify.ok = false;
        transition { _ -> done(verify) }
    }
    machine clo(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.k = 0;
        transition { _ -> clo_cp(verify) }
    }
    machine clo_cp(verify: &mut Verify) {
        transition verify.k < 32 {
            true -> clo_p(verify)
            _ -> asm_n(verify)
        }
    }
    machine clo_p(verify: &mut Verify) {
        verify.h1 = verify.i * 32 + verify.k;
        verify.h2 = verify.k;
        transition verify.h1 < 256 && verify.h2 < 32 {
            true -> clo_w(verify)
            _ -> bad(verify)
        }
    }
    machine clo_w(verify: &mut Verify) {
        verify.p_closure[verify.h1] = verify.ident[verify.h2];
        verify.k = verify.k + 1;
        transition { _ -> clo_cp(verify) }
    }
    machine asm_n(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.t64 = verify.w32 as u64 in Wrapping;
        transition verify.t64 <= 4 && verify.i < 8 && verify.ok {
            true -> asm_set(verify)
            _ -> bad(verify)
        }
    }
    machine asm_set(verify: &mut Verify) {
        verify.p_asm_n[verify.i] = verify.t64;
        verify.k = 0;
        transition { _ -> asm_loop(verify) }
    }
    machine asm_loop(verify: &mut Verify) {
        transition verify.k < verify.t64 && verify.k < 4 && verify.ok {
            true -> asm_one(verify)
            _ -> ep_n(verify)
        }
    }
    machine asm_one(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.j = 0;
        transition { _ -> asm_cp(verify) }
    }
    machine asm_cp(verify: &mut Verify) {
        transition verify.j < 32 {
            true -> asm_p(verify)
            _ -> asm_next(verify)
        }
    }
    machine asm_p(verify: &mut Verify) {
        verify.h1 = (verify.i * 4 + verify.k) * 32 + verify.j;
        verify.h2 = verify.j;
        transition verify.h1 < 1024 && verify.h2 < 32 {
            true -> asm_w(verify)
            _ -> bad(verify)
        }
    }
    machine asm_w(verify: &mut Verify) {
        verify.p_asm[verify.h1] = verify.ident[verify.h2];
        verify.j = verify.j + 1;
        transition { _ -> asm_cp(verify) }
    }
    machine asm_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> asm_loop(verify) }
    }
    machine ep_n(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.t64 = verify.w32 as u64 in Wrapping;
        transition verify.t64 <= 8 && verify.i < 8 && verify.ok {
            true -> ep_set(verify)
            _ -> bad(verify)
        }
    }
    machine ep_set(verify: &mut Verify) {
        verify.p_ep_n[verify.i] = verify.t64;
        verify.k = 0;
        verify.jd = 0;
        transition { _ -> ep_loop(verify) }
    }
    machine ep_loop(verify: &mut Verify) {
        transition verify.k < verify.t64 && verify.k < 8 && verify.ok {
            true -> ep_slot(verify)
            _ -> inst_next(verify)
        }
    }
    machine ep_slot(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.h1 = verify.i * 8 + verify.k;
        transition verify.h1 < 64 && verify.ok {
            true -> ep_slot_w(verify)
            _ -> bad(verify)
        }
    }
    machine ep_slot_w(verify: &mut Verify) {
        verify.p_ep_slot[verify.h1] = verify.w32 as u64 in Wrapping;
        transition { _ -> ep_dir(verify) }
    }
    machine ep_dir(verify: &mut Verify) {
        Verify::rd(verify);
        transition verify.ok && verify.h1 < 64 {
            true -> ep_dir_ck(verify)
            _ -> bad(verify)
        }
    }
    machine ep_dir_ck(verify: &mut Verify) {
        transition verify.b8 == 0 || verify.b8 == 1 {
            true -> ep_dir_w(verify)
            _ -> bad(verify)
        }
    }
    machine ep_dir_w(verify: &mut Verify) {
        verify.p_ep_dir[verify.h1] = verify.b8;
        verify.je = verify.p_ep_slot[verify.h1] * 2 + (verify.b8 as u64 in Wrapping);
        transition verify.k == 0 || verify.je > verify.jd {
            true -> ep_ord(verify)
            _ -> bad(verify)
        }
    }
    machine ep_ord(verify: &mut Verify) {
        verify.jd = verify.je;
        transition { _ -> ep_contract(verify) }
    }
    machine ep_contract(verify: &mut Verify) {
        Verify::rdident(verify);
        verify.j = 0;
        transition { _ -> ep_cp(verify) }
    }
    machine ep_cp(verify: &mut Verify) {
        transition verify.j < 32 {
            true -> ep_p(verify)
            _ -> ep_next(verify)
        }
    }
    machine ep_p(verify: &mut Verify) {
        verify.h2 = verify.j;
        transition verify.h1 < 64 && verify.h2 < 32 {
            true -> ep_p2(verify)
            _ -> bad(verify)
        }
    }
    machine ep_p2(verify: &mut Verify) {
        verify.h3 = verify.h1 * 32 + verify.h2;
        transition verify.h3 < 2048 {
            true -> ep_w(verify)
            _ -> bad(verify)
        }
    }
    machine ep_w(verify: &mut Verify) {
        verify.p_ep_contract[verify.h3] = verify.ident[verify.h2];
        verify.j = verify.j + 1;
        transition { _ -> ep_cp(verify) }
    }
    machine ep_next(verify: &mut Verify) {
        verify.k = verify.k + 1;
        transition { _ -> ep_loop(verify) }
    }
    machine inst_next(verify: &mut Verify) {
        verify.i = verify.i + 1;
        transition { _ -> inst_loop(verify) }
    }
    machine binds(verify: &mut Verify) {
        Verify::ru32(verify);
        verify.n_bind = verify.w32 as u64 in Wrapping;
