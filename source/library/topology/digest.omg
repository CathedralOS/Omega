// SHA-256 over staged bytes — the plan's `request_commitment`, the export
// endpoint contract digests, and the per-component completeness closure all
// reduce to this one compression function (FIPS 180-4). Written against the
// language's `u32 in Wrapping` surface: every addition wraps, rotates are
// shift-or pairs, and `ch` avoids a bitwise-not by rewriting
// `(e & f) ^ (~e & g)` as `g ^ (e & (f ^ g))`.
//
// Checker conventions: computed index expressions are staged into plain
// `u64 in Wrapping` fields (index operands must be simple names), and every
// index op sits in a parameterless state entered by a transition that
// restates the bounds (`field < extent`). `bad` is set on guard violation so
// callers can detect an impossible path. Callers stage input bytes into
// `msg[..msg_n]`; the 32-byte digest lands in `out32`.

module digest;

pub data Sha256 {
    bad: bool;
    h: [u32 in Wrapping; 8];
    w: [u32 in Wrapping; 64];
    block: [u8; 64];
    msg: [u8; 8192];
    tail: [u8; 128];
    out32: [u8; 32];
    i: u64 in Wrapping;
    j0: u64 in Wrapping;
    j1: u64 in Wrapping;
    j2: u64 in Wrapping;
    j3: u64 in Wrapping;
    e0: u64 in Wrapping;
    e1: u64 in Wrapping;
    e2: u64 in Wrapping;
    e3: u64 in Wrapping;
    o0: u64 in Wrapping;
    o1: u64 in Wrapping;
    o2: u64 in Wrapping;
    o3: u64 in Wrapping;
    q0: u64 in Wrapping;
    q2: u64 in Wrapping;
    w0: u64 in Wrapping;
    p0: u64 in Wrapping;
    base: u64 in Wrapping;
    msg_n: u64 in Wrapping;
    tail_n: u64 in Wrapping;
    block_i: u64 in Wrapping;
    bit_len: u64 in Wrapping;
    a: u32 in Wrapping;
    b: u32 in Wrapping;
    c: u32 in Wrapping;
    d: u32 in Wrapping;
    e: u32 in Wrapping;
    f: u32 in Wrapping;
    g: u32 in Wrapping;
    hh: u32 in Wrapping;
}

machine sha256_round_k(i: u64 in Wrapping) -> u32 in Wrapping {
    transition i < 64 {
        true -> ok(i)
        _ -> bad()
    }

    state ok(i: u64 in Wrapping) -> u32 in Wrapping {
        // First 32 bits of the fractional parts of the cube roots of the
        // first 64 primes — the SHA-256 round constants.
        let table: [u32 in Wrapping; 64] = [
            1116352408, 1899447441, 3049323471, 3921009573,
            961987163, 1508970993, 2453635748, 2870763221,
            3624381080, 310598401, 607225278, 1426881987,
            1925078388, 2162078206, 2614888103, 3248222580,
            3835390401, 4022224774, 264347078, 604807628,
            770255983, 1249150122, 1555081692, 1996064986,
            2554220882, 2821834349, 2952996808, 3210313671,
            3336571891, 3584528711, 113926993, 338241895,
            666307205, 773529912, 1294757372, 1396182291,
            1695183700, 1986661051, 2177026350, 2456956037,
            2730485921, 2820302411, 3259730800, 3345764771,
            3516065817, 3600352804, 4094571909, 275423344,
            430227734, 506948616, 659060556, 883997877,
            958139571, 1322822218, 1537002063, 1747873779,
            1955562222, 2024104815, 2227730452, 2361852424,
            2428436474, 2756734187, 3204031479, 3329325298
        ];
        table[i]
    }
    state bad() -> u32 in Wrapping {
        0
    }
}

machine Sha256::reset(sha256: &mut Sha256) {
    sha256.h[0] = 1779033703;
    sha256.h[1] = 3144134277;
    sha256.h[2] = 1013904242;
    sha256.h[3] = 2773480762;
    sha256.h[4] = 1359893119;
    sha256.h[5] = 2600822924;
    sha256.h[6] = 528734635;
    sha256.h[7] = 1541459225;
}

// Fill `block` from `msg[base .. base+64]`; the chunk_check guard has already
// established `base + 64 <= msg_n`.
machine Sha256::stage_block(sha256: &mut Sha256) {
    sha256.i = 0;
    transition { _ -> copy(sha256) }

    state copy(sha256: &mut Sha256) {
        transition sha256.i < 64 {
            true -> prep(sha256)
            _ -> done(sha256)
        }
    }
    state prep(sha256: &mut Sha256) {
        sha256.p0 = sha256.base + sha256.i;
        sha256.q0 = sha256.i;
        transition sha256.p0 < 8192 && sha256.q0 < 64 {
            true -> apply(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply(sha256: &mut Sha256) {
        sha256.block[sha256.q0] = sha256.msg[sha256.p0];
        sha256.i = sha256.i + 1;
        transition { _ -> copy(sha256) }
    }
    state done(sha256: &mut Sha256) {
    }
    state stuck(sha256: &mut Sha256) {
        sha256.bad = true;
    }
}

// Compress the staged `block`.
machine Sha256::compress(sha256: &mut Sha256) {
    sha256.i = 0;
    transition { _ -> load_w(sha256) }

    state load_w(sha256: &mut Sha256) {
        transition sha256.i < 16 {
            true -> prep_w(sha256)
            _ -> extend(sha256)
        }
    }
    state prep_w(sha256: &mut Sha256) {
        sha256.j0 = sha256.i * 4;
        sha256.j1 = sha256.j0 + 1;
        sha256.j2 = sha256.j1 + 1;
        sha256.j3 = sha256.j2 + 1;
        sha256.w0 = sha256.i;
        transition sha256.j0 < 64 && sha256.j1 < 64 && sha256.j2 < 64 && sha256.j3 < 64 && sha256.w0 < 64 {
            true -> apply_w(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply_w(sha256: &mut Sha256) {
        sha256.w[sha256.w0] = ((sha256.block[sha256.j0] as u32 in Wrapping) << 24)
            | ((sha256.block[sha256.j1] as u32 in Wrapping) << 16)
            | ((sha256.block[sha256.j2] as u32 in Wrapping) << 8)
            | (sha256.block[sha256.j3] as u32 in Wrapping);
        sha256.i = sha256.i + 1;
        transition { _ -> load_w(sha256) }
    }
    state extend(sha256: &mut Sha256) {
        sha256.i = 16;
        transition { _ -> extend_loop(sha256) }
    }
    state extend_loop(sha256: &mut Sha256) {
        transition sha256.i >= 16 && sha256.i < 64 {
            true -> prep_e(sha256)
            _ -> rounds(sha256)
        }
    }
    state prep_e(sha256: &mut Sha256) {
        sha256.e0 = sha256.i - 16;
        sha256.e1 = sha256.i - 7;
        sha256.e2 = sha256.i - 15;
        sha256.e3 = sha256.i - 2;
        sha256.w0 = sha256.i;
        transition sha256.e0 < 64 && sha256.e1 < 64 && sha256.e2 < 64 && sha256.e3 < 64 && sha256.w0 < 64 {
            true -> apply_e(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply_e(sha256: &mut Sha256) {
        let x: u32 in Wrapping = sha256.w[sha256.e2];
        let y: u32 in Wrapping = sha256.w[sha256.e3];
        let s0: u32 in Wrapping = ((x >> 7) | (x << 25)) ^ ((x >> 18) | (x << 14)) ^ (x >> 3);
        let s1: u32 in Wrapping = ((y >> 17) | (y << 15)) ^ ((y >> 19) | (y << 13)) ^ (y >> 10);
        sha256.w[sha256.w0] = sha256.w[sha256.e0] + s0 + sha256.w[sha256.e1] + s1;
        sha256.i = sha256.i + 1;
        transition { _ -> extend_loop(sha256) }
    }
    state rounds(sha256: &mut Sha256) {
        sha256.a = sha256.h[0];
        sha256.b = sha256.h[1];
        sha256.c = sha256.h[2];
        sha256.d = sha256.h[3];
        sha256.e = sha256.h[4];
        sha256.f = sha256.h[5];
        sha256.g = sha256.h[6];
        sha256.hh = sha256.h[7];
        sha256.i = 0;
        transition { _ -> round_loop(sha256) }
    }
    state round_loop(sha256: &mut Sha256) {
        transition sha256.i < 64 {
            true -> prep_r(sha256)
            _ -> absorb(sha256)
        }
    }
    state prep_r(sha256: &mut Sha256) {
        sha256.w0 = sha256.i;
        transition sha256.w0 < 64 {
            true -> apply_r(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply_r(sha256: &mut Sha256) {
        let s1: u32 in Wrapping = ((sha256.e >> 6) | (sha256.e << 26))
            ^ ((sha256.e >> 11) | (sha256.e << 21)) ^ ((sha256.e >> 25) | (sha256.e << 7));
        let ch: u32 in Wrapping = sha256.g ^ (sha256.e & (sha256.f ^ sha256.g));
        let t1: u32 in Wrapping = sha256.hh + s1 + ch + sha256_round_k(sha256.w0) + sha256.w[sha256.w0];
        let s0: u32 in Wrapping = ((sha256.a >> 2) | (sha256.a << 30))
            ^ ((sha256.a >> 13) | (sha256.a << 19)) ^ ((sha256.a >> 22) | (sha256.a << 10));
        let maj: u32 in Wrapping = (sha256.a & sha256.b) ^ (sha256.a & sha256.c) ^ (sha256.b & sha256.c);
        let t2: u32 in Wrapping = s0 + maj;
        sha256.hh = sha256.g;
        sha256.g = sha256.f;
        sha256.f = sha256.e;
        sha256.e = sha256.d + t1;
        sha256.d = sha256.c;
        sha256.c = sha256.b;
        sha256.b = sha256.a;
        sha256.a = t1 + t2;
        sha256.i = sha256.i + 1;
        transition { _ -> round_loop(sha256) }
    }
    state absorb(sha256: &mut Sha256) {
        sha256.h[0] = sha256.h[0] + sha256.a;
        sha256.h[1] = sha256.h[1] + sha256.b;
        sha256.h[2] = sha256.h[2] + sha256.c;
        sha256.h[3] = sha256.h[3] + sha256.d;
        sha256.h[4] = sha256.h[4] + sha256.e;
        sha256.h[5] = sha256.h[5] + sha256.f;
        sha256.h[6] = sha256.h[6] + sha256.g;
        sha256.h[7] = sha256.h[7] + sha256.hh;
    }
    state stuck(sha256: &mut Sha256) {
        sha256.bad = true;
    }
}

// Digest the staged `msg[..msg_n]` into `out32`.
machine Sha256::digest(sha256: &mut Sha256) {
    sha256.bad = false;
    Sha256::reset(sha256);
    sha256.base = 0;
    transition { _ -> chunk_check(sha256) }

    state chunk_check(sha256: &mut Sha256) {
        transition sha256.base + 64 <= sha256.msg_n {
            true -> run_chunk(sha256)
            _ -> tail_begin(sha256)
        }
    }
    state run_chunk(sha256: &mut Sha256) {
        Sha256::stage_block(sha256);
        Sha256::compress(sha256);
        sha256.base = sha256.base + 64;
        transition { _ -> chunk_check(sha256) }
    }
    state tail_begin(sha256: &mut Sha256) {
        sha256.i = 0;
        transition { _ -> tail_copy(sha256) }
    }
    state tail_copy(sha256: &mut Sha256) {
        transition sha256.base + sha256.i < sha256.msg_n && sha256.i < 64 {
            true -> prep_t(sha256)
            _ -> tail_gate(sha256)
        }
    }
    state prep_t(sha256: &mut Sha256) {
        sha256.q2 = sha256.i;
        sha256.p0 = sha256.base + sha256.i;
        transition sha256.q2 < 128 && sha256.p0 < 8192 {
            true -> apply_t(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply_t(sha256: &mut Sha256) {
        sha256.tail[sha256.q2] = sha256.msg[sha256.p0];
        sha256.i = sha256.i + 1;
        transition { _ -> tail_copy(sha256) }
    }
    state tail_gate(sha256: &mut Sha256) {
        transition sha256.i <= 64 {
            true -> tail_mark(sha256)
            _ -> stuck(sha256)
        }
    }
    state tail_mark(sha256: &mut Sha256) {
        sha256.tail_n = sha256.i;
        sha256.q2 = sha256.i;
        transition sha256.q2 < 128 {
            true -> apply_mark(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply_mark(sha256: &mut Sha256) {
        sha256.tail[sha256.q2] = 128;
        sha256.i = sha256.i + 1;
        transition { _ -> tail_zero(sha256) }
    }
    state tail_zero(sha256: &mut Sha256) {
        transition sha256.i < 128 {
            true -> prep_z(sha256)
            _ -> tail_len(sha256)
        }
    }
    state prep_z(sha256: &mut Sha256) {
        sha256.q2 = sha256.i;
        transition sha256.q2 < 128 {
            true -> apply_z(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply_z(sha256: &mut Sha256) {
        sha256.tail[sha256.q2] = 0;
        sha256.i = sha256.i + 1;
        transition { _ -> tail_zero(sha256) }
    }
    state tail_len(sha256: &mut Sha256) {
        sha256.bit_len = sha256.msg_n * 8;
        transition sha256.tail_n < 56 {
            true -> len_at_56(sha256)
            _ -> len_at_120(sha256)
        }
    }
    state len_at_56(sha256: &mut Sha256) {
        sha256.block_i = 56;
        transition { _ -> write_len(sha256) }
    }
    state len_at_120(sha256: &mut Sha256) {
        sha256.block_i = 120;
        transition { _ -> write_len(sha256) }
    }
    state write_len(sha256: &mut Sha256) {
        sha256.i = 0;
        transition { _ -> write_len_loop(sha256) }
    }
    state write_len_loop(sha256: &mut Sha256) {
        transition sha256.i < 8 {
            true -> prep_l(sha256)
            _ -> tail_blocks(sha256)
        }
    }
    state prep_l(sha256: &mut Sha256) {
        sha256.q0 = sha256.block_i + sha256.i;
        sha256.q2 = (7 - sha256.i) * 8;
        transition sha256.q0 < 128 && sha256.q2 <= 56 {
            true -> apply_l(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply_l(sha256: &mut Sha256) {
        sha256.tail[sha256.q0] = ((sha256.bit_len >> sha256.q2) as u8 in Wrapping) as u8;
        sha256.i = sha256.i + 1;
        transition { _ -> write_len_loop(sha256) }
    }
    state tail_blocks(sha256: &mut Sha256) {
        sha256.i = 0;
        transition { _ -> stage_first(sha256) }
    }
    state stage_first(sha256: &mut Sha256) {
        transition sha256.i < 64 {
            true -> prep_f(sha256)
            _ -> run_first(sha256)
        }
    }
    state prep_f(sha256: &mut Sha256) {
        sha256.q0 = sha256.i;
        sha256.q2 = sha256.i;
        transition sha256.q0 < 64 && sha256.q2 < 128 {
            true -> apply_f(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply_f(sha256: &mut Sha256) {
        sha256.block[sha256.q0] = sha256.tail[sha256.q2];
        sha256.i = sha256.i + 1;
        transition { _ -> stage_first(sha256) }
    }
    state run_first(sha256: &mut Sha256) {
        Sha256::compress(sha256);
        transition sha256.tail_n < 56 {
            true -> done(sha256)
            _ -> stage_second(sha256)
        }
    }
    state stage_second(sha256: &mut Sha256) {
        sha256.i = 0;
        transition { _ -> stage_second_loop(sha256) }
    }
    state stage_second_loop(sha256: &mut Sha256) {
        transition sha256.i < 64 {
            true -> prep_s(sha256)
            _ -> run_second(sha256)
        }
    }
    state prep_s(sha256: &mut Sha256) {
        sha256.q0 = sha256.i;
        sha256.q2 = 64 + sha256.i;
        transition sha256.q0 < 64 && sha256.q2 < 128 {
            true -> apply_s(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply_s(sha256: &mut Sha256) {
        sha256.block[sha256.q0] = sha256.tail[sha256.q2];
        sha256.i = sha256.i + 1;
        transition { _ -> stage_second_loop(sha256) }
    }
    state run_second(sha256: &mut Sha256) {
        Sha256::compress(sha256);
        transition { _ -> done(sha256) }
    }
    state done(sha256: &mut Sha256) {
        sha256.i = 0;
        transition { _ -> write_loop(sha256) }
    }
    state write_loop(sha256: &mut Sha256) {
        transition sha256.i < 8 {
            true -> prep_o(sha256)
            _ -> finish(sha256)
        }
    }
    state prep_o(sha256: &mut Sha256) {
        sha256.o0 = sha256.i * 4;
        sha256.o1 = sha256.o0 + 1;
        sha256.o2 = sha256.o1 + 1;
        sha256.o3 = sha256.o2 + 1;
        sha256.w0 = sha256.i;
        transition sha256.o0 < 32 && sha256.o1 < 32 && sha256.o2 < 32 && sha256.o3 < 32 && sha256.w0 < 8 {
            true -> apply_o(sha256)
            _ -> stuck(sha256)
        }
    }
    state apply_o(sha256: &mut Sha256) {
        let word: u32 in Wrapping = sha256.h[sha256.w0];
        sha256.out32[sha256.o0] = ((word >> 24) as u8 in Wrapping) as u8;
        sha256.out32[sha256.o1] = ((word >> 16) as u8 in Wrapping) as u8;
        sha256.out32[sha256.o2] = ((word >> 8) as u8 in Wrapping) as u8;
        sha256.out32[sha256.o3] = (word as u8 in Wrapping) as u8;
        sha256.i = sha256.i + 1;
        transition { _ -> write_loop(sha256) }
    }
    state finish(sha256: &mut Sha256) {
    }
    state stuck(sha256: &mut Sha256) {
        sha256.bad = true;
    }
}
