// Install handlers while keeping their table, stacks and shared context alive.
// Build selects the registrar and callback slot; the compiler checks their
// exact contracts before publishing the interrupt table.

// The selected provider defines the opaque acknowledgement's bytes. The fields
// report its exact installed occurrence and live debt; constructing this plain
// record never constructs an InterruptAcknowledgement or grants Pending.
public data StaticInterruptAcknowledgementCarrier {
    installed_root: u64;
    provider_execution: u64;
    invocation: u64;
    completion_policy: u64;
    debt: u64;
}
public StaticInterruptAcknowledgementRepresentation satisfies
    OpaqueRepresentation<InterruptAcknowledgement, StaticInterruptAcknowledgementCarrier> {}

// The caller supplies an ordinary Boolean function for table policy. Its exact
// invocation must be admitted as a logical denotation; a pure-looking signature
// alone is insufficient. A true result establishes that exact policy
// on the current table; publication separately checks materialization and roots.
public boundary trait StaticInterruptTableValidation<Table, machine Valid>
requires machine Valid(accepted: bool, table: &Table) -> bool reaches none terminates;
{
    machine validate(table: &Table) -> bool
    reaches none
    ensures Valid(result, table);
}

// Ordinary work runs inside the installation's retained backing loans.
public boundary trait StaticInterruptWork<Context> {
    machine run(context: &Context)
    reaches MachineControl + PortIo
    ensures false;
}

// A stack view includes only usable words. Guards stay outside this exclusive
// loan. The installed scope retains both the view and its original backing.
public data StaticInterruptStack<'stack> {
    words: &'stack mut [u64];
    ist: u8;
}

// Physical CPU arrival is independent of the semantic acknowledgement. Every
// present gate has one row. The x86 provider verifies the declared shape for
// the admitted delivery profile before making any gate reachable.
public data StaticInterruptFrame [copy] {
    case NoErrorCode;
    case ErrorCode;
    // A fatal entry never returns or interprets the interrupted CPU frame.
    // This does not assert whether the CPU supplied an error word.
    case OpaqueFatal;
}
public data StaticInterruptArrival {
    vector: u16;
    frame: StaticInterruptFrame;
}

// The runtime provider owns physical arrival failures before semantic entry.
// Exhaustion refuses here before a new Pending occurrence is introduced. This
// requirement supplies no second Calling policy: installation consumes the
// exact slot's selected plan for its adapter and semantic continuation.
public boundary trait X86StaticInterruptArrival {
    machine enter() reaches <= MachineControl + PortIo crashes Trap;
}

// This namespace names the x86-64 implementation, not an owned context value.
public data X86StaticInterruptScope {}

// The first two authored static operands are sealed metadata: the complete
// registrar requirement application and the timer's exact PrivateCallbackSlot.
// They are not executable machine parameters of this declaration. The registrar
// application retains all callback binders, including fatal roots. Its table
// parameter and this table argument must denote the same occurrence.
//
// False means no table was published. After successful publication, Work never
// returns, so all backing loans remain live until shutdown. Exhausting the
// provider's fresh invocation sequence traps before an identity could repeat.
public boundary machine X86StaticInterruptScope::run<
    Table, Context, machine Valid, machine Validate, machine Work,
    machine Completion, const GdtEntries: u64
>(
    table: &mut Table,
    gdt: &mut [u64; GdtEntries],
    task_state: &[u8; 104],
    stacks: &mut [StaticInterruptStack],
    arrivals: &[StaticInterruptArrival],
    context: &Context
) -> bool
requires GdtEntries >= 2 && GdtEntries <= 8192
requires machine Valid(accepted: bool, table: &Table) -> bool reaches none terminates;
requires machine Validate satisfies StaticInterruptTableValidation<Table, Valid>::validate;
requires machine Work satisfies StaticInterruptWork<Context>::run;
requires machine Completion satisfies InterruptAcknowledgementCompletion::complete;
reaches MachineControl + PortIo
invokes StaticInterruptTableValidation invokes StaticInterruptWork
crashes Trap
ensures result == false;

// This explicit provider view borrows the context kept by the acknowledgement's
// installation. The complete applied contract establishes its backing; lifetime
// spelling alone does not. Installation rejects incompatible Context, root or
// completion uses before publication. Pending plus the retained exact installed
// occurrence establishes the live invocation; these helpers add no reachable
// runtime failure to the semantic handler.
public boundary machine view_static_interrupt_context<'arrival, Context>(
    acknowledgement: &'arrival InterruptAcknowledgement
) -> &'arrival Context
requires acknowledgement in InterruptAcknowledgement::Pending
reaches none;

// This private permit keeps completion tied to one active invocation across the
// ordinary controller body. Neither it nor its opaque acknowledgement is a
// source-level constructor for Pending.
public boundary data StaticInterruptCompletionPermit [linear];
public data StaticInterruptCompletionPermitCarrier {
    installed_root: u64;
    invocation: u64;
    debt: u64;
}
public StaticInterruptCompletionPermitRepresentation satisfies
    OpaqueRepresentation<StaticInterruptCompletionPermit, StaticInterruptCompletionPermitCarrier> {}

boundary machine begin_static_interrupt_completion<machine Completion>(
    acknowledgement: &InterruptAcknowledgement
) -> StaticInterruptCompletionPermit
requires acknowledgement in InterruptAcknowledgement::Pending
requires machine Completion satisfies InterruptAcknowledgementCompletion::complete;
reaches none;

boundary machine finish_static_interrupt_completion(
    permit: StaticInterruptCompletionPermit
) reaches none;

// Authenticate the selected controller operation, run it, then commit this debt
// as complete. A failed or nonreturning controller body cannot authorize IRET.
public machine complete_installed_interrupt<machine Completion>(
    acknowledgement: InterruptAcknowledgement in Pending
)
requires machine Completion satisfies InterruptAcknowledgementCompletion::complete;
reaches MachineControl + PortIo
{
    let permit: StaticInterruptCompletionPermit =
        begin_static_interrupt_completion<Completion>(&acknowledgement);
    Completion(acknowledgement);
    finish_static_interrupt_completion(permit);
}
