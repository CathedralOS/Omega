// Core slice surface.
//
// The public requirements own bounds and returned-extent contracts. Their
// checked provider delegates descriptor operations to a private helper module,
// where the range and index syntax selects the builtin collection operations.
// The helper does not import these requirements, so provider execution cannot
// recursively select the requirement it is realizing. Target layout and native
// descriptor construction remain below the source layer.
//
// Selection belongs to the ordinary boundary provider planner. The authored
// portable defaults below choose the checked slice-view implementation; the
// exact `satisfies` declarations retain its original requirement coordinates.
// An admitted Build choice may override these defaults under ordinary policy.

use omega::language::core::slice_views;

// index returns the element by value: copying it out of a shared borrow
// requires a copyable element type. The view-returning requirements below
// carry no such bound.
pub boundary machine [] Slice::index<T [copy]>(items: &[T], index: u64) -> T
requires
    index < items.len;

pub boundary machine [..] Slice::range<T>(items: &[T], start: u64, end: u64) -> &[T]
requires
    start <= end && end <= items.len
ensures
    result.len == end - start;

data SliceViewProvider {}

machine SliceViewProvider::index<T [copy]>(items: &[T], index: u64) -> T
    satisfies Slice::index
requires
    index < items.len {
    core::slice_views::element<T>(items, index)
}

machine SliceViewProvider::range<T>(items: &[T], start: u64, end: u64) -> &[T]
    satisfies Slice::range
requires
    start <= end && end <= items.len
ensures
    result.len == end - start {
    core::slice_views::subslice<T>(items, start, end)
}

// These source-declared defaults apply to every target. They choose the whole
// original generic requirement families, leaving each actual element tuple
// with ordinary checked specialization and its retained source application.
machine SliceViewProvider::provider_defaults(defaults: &mut SliceViewProvider) {
    SliceViewProvider::select_provider<Slice::index, SliceViewProvider>(defaults);
    SliceViewProvider::select_provider<Slice::range, SliceViewProvider>(defaults);
}

// The named slice views. One runtime realization supplies every view, so the
// rows share one boundary trait; the slice is an ordinary explicit argument.
boundary trait SliceAccess {
    machine Length<T>(items: &[T]) -> u64;

    machine index_mut<T>(items: &mut [T], index: u64) -> &mut T
    requires
        index < items.len;

    machine tail<T>(items: &[T]) -> &[T]
    requires
        items.len > 0;

    machine tail_mut<T>(items: &mut [T]) -> &mut [T]
    requires
        items.len > 0;

    machine from<T>(items: &[T], start: u64) -> &[T]
    requires
        start <= items.len;

    machine from_mut<T>(items: &mut [T], start: u64) -> &mut [T]
    requires
        start <= items.len;

    machine to<T>(items: &[T], end: u64) -> &[T]
    requires
        end <= items.len;

    machine to_mut<T>(items: &mut [T], end: u64) -> &mut [T]
    requires
        end <= items.len;

    machine range_mut<T>(items: &mut [T], start: u64, end: u64) -> &mut [T]
    requires
        start <= end && end <= items.len;
}
