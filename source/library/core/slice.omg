// Core slice surface.
//
// Slices are compiler-managed views over contiguous storage. The public core
// surface owns the semantic contracts; the concrete pointer/length carrier and
// boundary implementation live below this layer.
//
// Planned public surface:
// - Slice::Length ranks a slice by its current length for termination proofs.
// - index and subslice operators require bounds proofs before lowering to the
//   boundary descriptor layer.
// - mutable views carry the same overlap and borrow obligations as their
//   source owner.
//
// Fixed operator tokens are written directly after `boundary machine`: the
// token identifies the required operator slot of that signature.

boundary operator Slice::Length<T>(items: &[T]) -> u64;

// index returns the element by value: copying it out of a shared borrow
// requires a copyable element type. The view-returning operators below carry
// no such bound.
boundary machine [] Slice::index<T [copy]>(items: &[T], index: u64) -> T
requires
    index < items.len;

boundary operator Slice::index_mut<T>(items: &mut [T], index: u64) -> &mut T
requires
    index < items.len;

boundary operator Slice::tail<T>(items: &[T]) -> &[T]
requires
    items.len > 0;

boundary operator Slice::tail_mut<T>(items: &mut [T]) -> &mut [T]
requires
    items.len > 0;

boundary operator Slice::from<T>(items: &[T], start: u64) -> &[T]
requires
    start <= items.len;

boundary operator Slice::from_mut<T>(items: &mut [T], start: u64) -> &mut [T]
requires
    start <= items.len;

boundary operator Slice::to<T>(items: &[T], end: u64) -> &[T]
requires
    end <= items.len;

boundary operator Slice::to_mut<T>(items: &mut [T], end: u64) -> &mut [T]
requires
    end <= items.len;

boundary machine [..] Slice::range<T>(items: &[T], start: u64, end: u64) -> &[T]
requires
    start <= end && end <= items.len;

boundary operator Slice::range_mut<T>(items: &mut [T], start: u64, end: u64) -> &mut [T]
requires
    start <= end && end <= items.len;
