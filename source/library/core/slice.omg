// Core slice surface.
//
// Slices are compiler-managed views over contiguous storage. The public core
// surface owns the semantic contracts; the concrete pointer/length carrier and
// boundary implementation live below this layer.
//
// Planned public surface:
// - Slice::Length ranks a slice by its current length for termination proofs.
// - index and subslice operators require bounds proofs before lowering to the
//   boundary descriptor layer.
// - mutable views carry the same overlap and borrow obligations as their
//   source owner.
//
// Fixed operator tokens are written directly after `boundary machine`: the
// token identifies the required operator slot of that signature.

// index returns the element by value: copying it out of a shared borrow
// requires a copyable element type. The view-returning requirements below
// carry no such bound.
boundary machine [] Slice::index<T [copy]>(items: &[T], index: u64) -> T
requires
    index < items.len;

boundary machine [..] Slice::range<T>(items: &[T], start: u64, end: u64) -> &[T]
requires
    start <= end && end <= items.len
ensures
    result.len == end - start;

// The named slice views. One runtime realization supplies every view, so the
// rows share one boundary trait; the slice is an ordinary explicit argument.
boundary trait SliceAccess {
    machine Length<T>(items: &[T]) -> u64;

    machine index_mut<T>(items: &mut [T], index: u64) -> &mut T
    requires
        index < items.len;

    machine tail<T>(items: &[T]) -> &[T]
    requires
        items.len > 0;

    machine tail_mut<T>(items: &mut [T]) -> &mut [T]
    requires
        items.len > 0;

    machine from<T>(items: &[T], start: u64) -> &[T]
    requires
        start <= items.len;

    machine from_mut<T>(items: &mut [T], start: u64) -> &mut [T]
    requires
        start <= items.len;

    machine to<T>(items: &[T], end: u64) -> &[T]
    requires
        end <= items.len;

    machine to_mut<T>(items: &mut [T], end: u64) -> &mut [T]
    requires
        end <= items.len;

    machine range_mut<T>(items: &mut [T], start: u64, end: u64) -> &mut [T]
    requires
        start <= end && end <= items.len;
}
