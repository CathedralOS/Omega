// Checked slice helpers retain bounds, extent and the original backing loan.
// Index and range syntax uses the compiler catalog's collection operations;
// importing this module neither replaces those operations nor selects a provider.
use omega::language::core::slice_views;

public machine slice_index<Element [copy]>(items: &[Element], index: u64) -> Element
requires index < items.len {
    core::slice_views::element<Element>(items, index)
}

public machine slice_range<'backing, Element>(
    items: &'backing [Element], start: u64, end: u64
) -> &'backing [Element]
requires start <= end && end <= items.len
ensures result.len == end - start {
    core::slice_views::subslice<Element>(items, start, end)
}

// The remaining named views share one boundary trait. A selected implementation
// must supply its complete row set; the slice stays an ordinary explicit argument.
boundary trait SliceAccess {
    machine Length<T>(items: &[T]) -> u64 reaches;

    machine index_mut<T>(items: &mut [T], index: u64) -> &mut T
    reaches
    requires
        index < items.len;

    machine tail<T>(items: &[T]) -> &[T]
    reaches
    requires
        items.len > 0;

    machine tail_mut<T>(items: &mut [T]) -> &mut [T]
    reaches
    requires
        items.len > 0;

    machine from<T>(items: &[T], start: u64) -> &[T]
    reaches
    requires
        start <= items.len;

    machine from_mut<T>(items: &mut [T], start: u64) -> &mut [T]
    reaches
    requires
        start <= items.len;

    machine to<T>(items: &[T], end: u64) -> &[T]
    reaches
    requires
        end <= items.len;

    machine to_mut<T>(items: &mut [T], end: u64) -> &mut [T]
    reaches
    requires
        end <= items.len;

    machine range_mut<T>(items: &mut [T], start: u64, end: u64) -> &mut [T]
    reaches
    requires
        start <= end && end <= items.len;
}
