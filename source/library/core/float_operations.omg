// Destination-owned float-to-integer conversion. Unqualified results require
// proof that the finite toward-zero result fits; Trapping and Saturating are
// exact result-domain overloads. Wrapping deliberately has no declaration.
// Trap guards are the complements of the finite toward-zero admission ranges.
// Use minimum minus one only when representable: wider signed carriers have
// no floating value between their minimum and the next lower integer.

public boundary machine I8::from_f32(value: f32) -> i8
requires
    value == value && value > -129.0f32 && value < 128.0f32
ensures
    result == FloatSemantics::to_i8(Float::meaning32(value));

public boundary machine I8::from_f32(value: f32) -> i8 in Trapping
ensures
    result == FloatSemantics::to_i8(Float::meaning32(value))
crashes Trap
    value != value || value <= -129.0f32 || value >= 128.0f32;

public boundary machine I8::from_f32(value: f32) -> i8 in Saturating
ensures
    result == FloatSemantics::to_i8_saturating(Float::meaning32(value));

public boundary machine I8::from_f64(value: f64) -> i8
requires
    value == value && value > -129.0 && value < 128.0
ensures
    result == FloatSemantics::to_i8(Float::meaning64(value));

public boundary machine I8::from_f64(value: f64) -> i8 in Trapping
ensures
    result == FloatSemantics::to_i8(Float::meaning64(value))
crashes Trap
    value != value || value <= -129.0 || value >= 128.0;

public boundary machine I8::from_f64(value: f64) -> i8 in Saturating
ensures
    result == FloatSemantics::to_i8_saturating(Float::meaning64(value));

