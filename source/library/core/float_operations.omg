// Source-visible floating-point contracts. Each independent operation family
// is an ordinary boundary trait. The Core Build selects named implementations
// per target; these declarations carry no target or provider preference.

use omega::language::core::float_format;
use omega::language::core::float_meaning;

public data FloatClass [copy] {
    case NaN;
    case Infinity(negative: bool);
    case Normal(negative: bool);
    case Subnormal(negative: bool);
    case Zero(negative: bool);
}

// Runtime-carrier to proof-meaning projections. NaN payloads intentionally
// disappear here; a raw-bit consumer needs the stronger refinement described
// in chapter 5. These are exact compiler primitives: bare bodyless machine
// signatures supplied by the closed catalog because this sealed toolchain
// source declares them with exactly this path and shape. Merely naming a
// declaration `Float::meaning32` elsewhere grants no primitive.
machine Float::meaning32(value: f32) -> FloatMeaning;
machine Float::meaning64(value: f64) -> FloatMeaning;

// Public proof views are ordinary machines. The sealed projections remain
// private and keep their exact artifact contract; clients receive their
// meaning through these checked library result guarantees.
public machine F32::meaning(value: f32) -> FloatMeaning
ensures result == Float::meaning32(value)
{
    Float::meaning32(value)
}

public machine F64::meaning(value: f64) -> FloatMeaning
ensures result == Float::meaning64(value)
{
    Float::meaning64(value)
}

// The executable, representation-free semantic definitions. These are exact
// compiler primitives from the closed float-semantics catalog: bare bodyless
// machine signatures supplied because this sealed toolchain source declares
// them with exactly this path and complete signature (the `from_integer`
// carriers are distinct catalog rows). The compiler's core implementation is
// the current checked provider for these proof-only operations; target
// realizations cite the same identities. Merely naming a declaration
// `FloatSemantics::add` elsewhere grants no primitive.
public machine FloatSemantics::add(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

public machine FloatSemantics::subtract(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

public machine FloatSemantics::multiply(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

public machine FloatSemantics::divide(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

public machine FloatSemantics::negate(
    format: FloatFormat,
    value: FloatMeaning
) -> FloatMeaning;

public machine FloatSemantics::square_root(
    format: FloatFormat,
    value: FloatMeaning
) -> FloatMeaning;

public machine FloatSemantics::convert(
    format: FloatFormat,
    value: FloatMeaning
) -> FloatMeaning;

// Primitive integer carriers project to one mathematical integer before the
// destination format performs its nearest-even landing.
public machine FloatSemantics::from_integer(format: FloatFormat, value: i8) -> FloatMeaning;
public machine FloatSemantics::from_integer(format: FloatFormat, value: i16) -> FloatMeaning;
public machine FloatSemantics::from_integer(format: FloatFormat, value: i32) -> FloatMeaning;
public machine FloatSemantics::from_integer(format: FloatFormat, value: i64) -> FloatMeaning;
public machine FloatSemantics::from_integer(format: FloatFormat, value: u8) -> FloatMeaning;
public machine FloatSemantics::from_integer(format: FloatFormat, value: u16) -> FloatMeaning;
public machine FloatSemantics::from_integer(format: FloatFormat, value: u32) -> FloatMeaning;
public machine FloatSemantics::from_integer(format: FloatFormat, value: u64) -> FloatMeaning;

// Normal-return meanings for toward-zero float-to-integer conversion. The
