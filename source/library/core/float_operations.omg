public boundary trait I8FromF32 {
    machine from_f32(value: f32) -> i8
    reaches
    requires
        value == value && value > -129.0f32 && value < 128.0f32
    ensures
        result == FloatSemantics::to_i8(Float::meaning32(value));

    machine from_f32(value: f32) -> i8 in Trapping
    reaches
    ensures
        result == FloatSemantics::to_i8(Float::meaning32(value))
    crashes Trap
        value != value || value <= -129.0f32 || value >= 128.0f32;

    machine from_f32(value: f32) -> i8 in Saturating
    reaches
    ensures
        result == FloatSemantics::to_i8_saturating(Float::meaning32(value));
}

public boundary trait I8FromF64 {
    machine from_f64(value: f64) -> i8
    reaches
    requires
        value == value && value > -129.0 && value < 128.0
    ensures
        result == FloatSemantics::to_i8(Float::meaning64(value));

    machine from_f64(value: f64) -> i8 in Trapping
    reaches
    ensures
        result == FloatSemantics::to_i8(Float::meaning64(value))
    crashes Trap
        value != value || value <= -129.0 || value >= 128.0;

    machine from_f64(value: f64) -> i8 in Saturating
    reaches
    ensures
        result == FloatSemantics::to_i8_saturating(Float::meaning64(value));
}

