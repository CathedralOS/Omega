        Float::meaning64(left),
        Float::meaning64(right)
    );

pub boundary operator > Float::greater(left: f32, right: f32) -> bool
ensures
    result == FloatSemantics::greater(
        Float::meaning32(left),
        Float::meaning32(right)
    );

pub boundary operator > Float::greater(left: f64, right: f64) -> bool
ensures
    result == FloatSemantics::greater(
        Float::meaning64(left),
        Float::meaning64(right)
    );

pub boundary operator >= Float::greater_or_equal(left: f32, right: f32) -> bool
ensures
