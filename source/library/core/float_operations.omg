// Destination-owned ordinary format conversions. These are total (including
// infinities) and round nearest-even; same-format qualification remains `as`.
public boundary machine F32::from_f64(value: f64) -> f32
ensures
    |proof|::Identity::<|float_meaning|::FloatMeaning>(
        Float::meaning32(result),
        FloatSemantics::convert(
            |float_format|::FloatFormat::BINARY32,
            Float::meaning64(value)
        )
    );
public boundary machine F64::from_f32(value: f32) -> f64
ensures
    |proof|::Identity::<|float_meaning|::FloatMeaning>(
        Float::meaning64(result),
        FloatSemantics::convert(
            |float_format|::FloatFormat::BINARY64,
            Float::meaning32(value)
        )
    );

// Integer-to-float conversion is total and rounds nearest-even. The source
