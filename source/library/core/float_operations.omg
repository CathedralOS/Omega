// Primitive tokens and named operations retain the exact arithmetic contract.
public boundary trait FloatAdd {
    machine + add(left: f32, right: f32) -> f32
    reaches
    ensures
        Float::meaning32(result) == FloatSemantics::add(
            FloatFormat::BINARY32,
            Float::meaning32(left),
            Float::meaning32(right)
        );

    machine + add(left: f64, right: f64) -> f64
    reaches
    ensures
        Float::meaning64(result) == FloatSemantics::add(
            FloatFormat::BINARY64,
            Float::meaning64(left),
            Float::meaning64(right)
        );
}

public boundary trait FloatSubtract {
    machine - subtract(left: f32, right: f32) -> f32
    reaches
    ensures
        Float::meaning32(result) == FloatSemantics::subtract(
            FloatFormat::BINARY32,
            Float::meaning32(left),
            Float::meaning32(right)
        );

    machine - subtract(left: f64, right: f64) -> f64
    reaches
    ensures
        Float::meaning64(result) == FloatSemantics::subtract(
            FloatFormat::BINARY64,
            Float::meaning64(left),
            Float::meaning64(right)
        );
}

