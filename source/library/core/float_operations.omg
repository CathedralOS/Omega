// Source-visible floating-point operation identities.
//
// Primitive spellings resolve to the root Float operators below. All f32/f64
// arithmetic and comparison overloads now have explicit native-target
// satisfiers and selected-ProviderPlan realizations. The migrated named cohort
// includes min/max, square root, negate, bool and enum classification,
// multiply-then-add, the cross-target directed
// add/subtract/multiply/divide/square-root families, and the AArch64
// nearest/directed fused-multiply-add families; remaining named requirements
// retain bootstrap compiler lowering while their semantic identities and
// contracts no longer live only in Rust match arms.
//
// Unspelled operations use format-qualified F32/F64 names. This keeps named
// call resolution exact while the operator-call resolver is arity-based:
// `F32::fused_multiply_add` and `F64::fused_multiply_add` are distinct
// requirements, never return-type overloads.

use omega::language::core::float_format;
use omega::language::core::float_meaning;
use omega::language::core::targets::macos_arm64::float_impl;
use omega::language::core::targets::linux_arm64::float_impl;
use omega::language::core::targets::linux_x86_64::float_impl;
use omega::language::core::targets::windows_x86_64::float_impl;

// Nominal owner of the selected native float-operation provider closure.
// Target-scoped leaves below satisfy exact overloaded boundary-operator
// requirements; the carrier has no runtime state.
data FloatNativeProvider { }

pub data FloatClass [copy] {
    case NaN;
    case Infinity(negative: bool);
    case Normal(negative: bool);
    case Subnormal(negative: bool);
    case Zero(negative: bool);
}

// Runtime-carrier to proof-meaning projections. NaN payloads intentionally
// disappear here; a raw-bit consumer needs the stronger refinement described
// in chapter 5.
operator Float::meaning32(value: f32) -> FloatMeaning;
operator Float::meaning64(value: f64) -> FloatMeaning;

// The executable, representation-free semantic definitions. The compiler's
// omega-core implementation is the current checked provider for these
// proof-only operations; target realizations cite the same identities.
pub operator FloatSemantics::add(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

pub operator FloatSemantics::subtract(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

pub operator FloatSemantics::multiply(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

pub operator FloatSemantics::divide(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning
) -> FloatMeaning;

pub operator FloatSemantics::negate(
    format: FloatFormat,
    value: FloatMeaning
) -> FloatMeaning;

pub operator FloatSemantics::square_root(
    format: FloatFormat,
    value: FloatMeaning
) -> FloatMeaning;

pub operator FloatSemantics::convert(
    format: FloatFormat,
    value: FloatMeaning
) -> FloatMeaning;

// Primitive integer carriers project to one mathematical integer before the
// destination format performs its nearest-even landing.
pub operator FloatSemantics::from_integer(format: FloatFormat, value: i8) -> FloatMeaning;
pub operator FloatSemantics::from_integer(format: FloatFormat, value: i16) -> FloatMeaning;
pub operator FloatSemantics::from_integer(format: FloatFormat, value: i32) -> FloatMeaning;
pub operator FloatSemantics::from_integer(format: FloatFormat, value: i64) -> FloatMeaning;
pub operator FloatSemantics::from_integer(format: FloatFormat, value: u8) -> FloatMeaning;
pub operator FloatSemantics::from_integer(format: FloatFormat, value: u16) -> FloatMeaning;
pub operator FloatSemantics::from_integer(format: FloatFormat, value: u32) -> FloatMeaning;
pub operator FloatSemantics::from_integer(format: FloatFormat, value: u64) -> FloatMeaning;

// Normal-return meanings for toward-zero float-to-integer conversion. The
// unqualified and Trapping requirements share the exact semantic value on
// successful return; Saturating owns its total clamp/NaN-to-zero meaning.
pub operator FloatSemantics::to_i8(value: FloatMeaning) -> i8;
pub operator FloatSemantics::to_i16(value: FloatMeaning) -> i16;
pub operator FloatSemantics::to_i32(value: FloatMeaning) -> i32;
pub operator FloatSemantics::to_i64(value: FloatMeaning) -> i64;
pub operator FloatSemantics::to_u8(value: FloatMeaning) -> u8;
pub operator FloatSemantics::to_u16(value: FloatMeaning) -> u16;
pub operator FloatSemantics::to_u32(value: FloatMeaning) -> u32;
pub operator FloatSemantics::to_u64(value: FloatMeaning) -> u64;
pub operator FloatSemantics::to_i8_saturating(value: FloatMeaning) -> i8;
pub operator FloatSemantics::to_i16_saturating(value: FloatMeaning) -> i16;
pub operator FloatSemantics::to_i32_saturating(value: FloatMeaning) -> i32;
pub operator FloatSemantics::to_i64_saturating(value: FloatMeaning) -> i64;
pub operator FloatSemantics::to_u8_saturating(value: FloatMeaning) -> u8;
pub operator FloatSemantics::to_u16_saturating(value: FloatMeaning) -> u16;
pub operator FloatSemantics::to_u32_saturating(value: FloatMeaning) -> u32;
pub operator FloatSemantics::to_u64_saturating(value: FloatMeaning) -> u64;

pub operator FloatSemantics::multiply_then_add(
    format: FloatFormat,
    left: FloatMeaning,
    right: FloatMeaning,
    addend: FloatMeaning
