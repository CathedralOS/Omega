        Float::meaning32(left),
        Float::meaning32(right)
    );

pub boundary operator >= Float::greater_or_equal(left: f64, right: f64) -> bool
ensures
    result == FloatSemantics::greater_or_equal(
        Float::meaning64(left),
        Float::meaning64(right)
    );

// Distinct named carrier requirements. Multiply-then-add and FMA are never
// alternative providers for one requirement, and directed modes are never an
// ambient control-state parameter.
pub boundary operator F32::negate(value: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::negate(
        FloatFormat::BINARY32,
        Float::meaning32(value)
    );
pub boundary operator F64::negate(value: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::negate(
        FloatFormat::BINARY64,
        Float::meaning64(value)
    );
pub boundary operator F32::multiply_then_add(left: f32, right: f32, addend: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::multiply_then_add(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right),
        Float::meaning32(addend)
    );
pub boundary operator F64::multiply_then_add(left: f64, right: f64, addend: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::multiply_then_add(
        FloatFormat::BINARY64,
        Float::meaning64(left),
        Float::meaning64(right),
        Float::meaning64(addend)
    );
pub boundary operator F32::fused_multiply_add(left: f32, right: f32, addend: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::fused_multiply_add(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right),
        Float::meaning32(addend)
    );
pub boundary operator F64::fused_multiply_add(left: f64, right: f64, addend: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::fused_multiply_add(
        FloatFormat::BINARY64,
        Float::meaning64(left),
        Float::meaning64(right),
        Float::meaning64(addend)
    );
pub boundary operator F32::square_root(value: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::square_root(
        FloatFormat::BINARY32,
        Float::meaning32(value)
    );
pub boundary operator F64::square_root(value: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::square_root(
        FloatFormat::BINARY64,
        Float::meaning64(value)
    );
pub boundary operator F32::minimum(left: f32, right: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::minimum(
        Float::meaning32(left),
        Float::meaning32(right)
    );
pub boundary operator F64::minimum(left: f64, right: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::minimum(
        Float::meaning64(left),
        Float::meaning64(right)
    );
pub boundary operator F32::maximum(left: f32, right: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::maximum(
        Float::meaning32(left),
        Float::meaning32(right)
    );
pub boundary operator F64::maximum(left: f64, right: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::maximum(
        Float::meaning64(left),
        Float::meaning64(right)
    );

// Destination-owned ordinary format conversions. These are total (including
// infinities) and round nearest-even; same-format qualification remains `as`.
pub boundary operator F32::from_f64(value: f64) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::convert(
        FloatFormat::BINARY32,
        Float::meaning64(value)
    );
pub boundary operator F64::from_f32(value: f32) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::convert(
        FloatFormat::BINARY64,
        Float::meaning32(value)
    );

// Integer-to-float conversion is total and rounds nearest-even. The source
// spelling is part of the destination-owned requirement identity.
pub boundary operator F32::from_i8(value: i8) -> f32
ensures Float::meaning32(result) == FloatSemantics::from_integer(FloatFormat::BINARY32, value);
pub boundary operator F32::from_i16(value: i16) -> f32
ensures Float::meaning32(result) == FloatSemantics::from_integer(FloatFormat::BINARY32, value);
pub boundary operator F32::from_i32(value: i32) -> f32
ensures Float::meaning32(result) == FloatSemantics::from_integer(FloatFormat::BINARY32, value);
pub boundary operator F32::from_i64(value: i64) -> f32
ensures Float::meaning32(result) == FloatSemantics::from_integer(FloatFormat::BINARY32, value);
pub boundary operator F32::from_u8(value: u8) -> f32
ensures Float::meaning32(result) == FloatSemantics::from_integer(FloatFormat::BINARY32, value);
pub boundary operator F32::from_u16(value: u16) -> f32
ensures Float::meaning32(result) == FloatSemantics::from_integer(FloatFormat::BINARY32, value);
pub boundary operator F32::from_u32(value: u32) -> f32
ensures Float::meaning32(result) == FloatSemantics::from_integer(FloatFormat::BINARY32, value);
pub boundary operator F32::from_u64(value: u64) -> f32
ensures Float::meaning32(result) == FloatSemantics::from_integer(FloatFormat::BINARY32, value);

pub boundary operator F64::from_i8(value: i8) -> f64
ensures Float::meaning64(result) == FloatSemantics::from_integer(FloatFormat::BINARY64, value);
pub boundary operator F64::from_i16(value: i16) -> f64
ensures Float::meaning64(result) == FloatSemantics::from_integer(FloatFormat::BINARY64, value);
pub boundary operator F64::from_i32(value: i32) -> f64
ensures Float::meaning64(result) == FloatSemantics::from_integer(FloatFormat::BINARY64, value);
pub boundary operator F64::from_i64(value: i64) -> f64
ensures Float::meaning64(result) == FloatSemantics::from_integer(FloatFormat::BINARY64, value);
pub boundary operator F64::from_u8(value: u8) -> f64
ensures Float::meaning64(result) == FloatSemantics::from_integer(FloatFormat::BINARY64, value);
pub boundary operator F64::from_u16(value: u16) -> f64
ensures Float::meaning64(result) == FloatSemantics::from_integer(FloatFormat::BINARY64, value);
pub boundary operator F64::from_u32(value: u32) -> f64
ensures Float::meaning64(result) == FloatSemantics::from_integer(FloatFormat::BINARY64, value);
pub boundary operator F64::from_u64(value: u64) -> f64
ensures Float::meaning64(result) == FloatSemantics::from_integer(FloatFormat::BINARY64, value);

// Destination-owned float-to-integer conversion. Unqualified results require
// proof that the finite toward-zero result fits; Trapping and Saturating are
// exact result-domain overloads. Wrapping deliberately has no declaration.

pub boundary operator I8::from_f32(value: f32) -> i8
requires
    value == value && value > -129.0f32 && value < 128.0f32
ensures
    result == FloatSemantics::to_i8(Float::meaning32(value));

pub boundary operator I8::from_f32(value: f32) -> i8 in Trapping
ensures
    result == FloatSemantics::to_i8(Float::meaning32(value));

pub boundary operator I8::from_f32(value: f32) -> i8 in Saturating
ensures
    result == FloatSemantics::to_i8_saturating(Float::meaning32(value));

pub boundary operator I8::from_f64(value: f64) -> i8
requires
    value == value && value > -129.0 && value < 128.0
ensures
    result == FloatSemantics::to_i8(Float::meaning64(value));

pub boundary operator I8::from_f64(value: f64) -> i8 in Trapping
ensures
    result == FloatSemantics::to_i8(Float::meaning64(value));

pub boundary operator I8::from_f64(value: f64) -> i8 in Saturating
ensures
    result == FloatSemantics::to_i8_saturating(Float::meaning64(value));

pub boundary operator I16::from_f32(value: f32) -> i16
requires
    value == value && value > -32769.0f32 && value < 32768.0f32
ensures
    result == FloatSemantics::to_i16(Float::meaning32(value));

pub boundary operator I16::from_f32(value: f32) -> i16 in Trapping
ensures
    result == FloatSemantics::to_i16(Float::meaning32(value));

pub boundary operator I16::from_f32(value: f32) -> i16 in Saturating
ensures
    result == FloatSemantics::to_i16_saturating(Float::meaning32(value));

pub boundary operator I16::from_f64(value: f64) -> i16
requires
    value == value && value > -32769.0 && value < 32768.0
ensures
    result == FloatSemantics::to_i16(Float::meaning64(value));

pub boundary operator I16::from_f64(value: f64) -> i16 in Trapping
ensures
    result == FloatSemantics::to_i16(Float::meaning64(value));

pub boundary operator I16::from_f64(value: f64) -> i16 in Saturating
ensures
    result == FloatSemantics::to_i16_saturating(Float::meaning64(value));

pub boundary operator I32::from_f32(value: f32) -> i32
requires
    value == value && value >= -2147483648.0f32 && value < 2147483648.0f32
ensures
    result == FloatSemantics::to_i32(Float::meaning32(value));

pub boundary operator I32::from_f32(value: f32) -> i32 in Trapping
ensures
    result == FloatSemantics::to_i32(Float::meaning32(value));

pub boundary operator I32::from_f32(value: f32) -> i32 in Saturating
ensures
    result == FloatSemantics::to_i32_saturating(Float::meaning32(value));

pub boundary operator I32::from_f64(value: f64) -> i32
requires
    value == value && value > -2147483649.0 && value < 2147483648.0
ensures
    result == FloatSemantics::to_i32(Float::meaning64(value));

pub boundary operator I32::from_f64(value: f64) -> i32 in Trapping
ensures
    result == FloatSemantics::to_i32(Float::meaning64(value));

pub boundary operator I32::from_f64(value: f64) -> i32 in Saturating
ensures
    result == FloatSemantics::to_i32_saturating(Float::meaning64(value));

pub boundary operator I64::from_f32(value: f32) -> i64
requires
    value == value && value >= -9223372036854775808.0f32 && value < 9223372036854775808.0f32
ensures
    result == FloatSemantics::to_i64(Float::meaning32(value));

pub boundary operator I64::from_f32(value: f32) -> i64 in Trapping
ensures
    result == FloatSemantics::to_i64(Float::meaning32(value));

pub boundary operator I64::from_f32(value: f32) -> i64 in Saturating
ensures
    result == FloatSemantics::to_i64_saturating(Float::meaning32(value));

pub boundary operator I64::from_f64(value: f64) -> i64
requires
    value == value && value >= -9223372036854775808.0 && value < 9223372036854775808.0
ensures
    result == FloatSemantics::to_i64(Float::meaning64(value));

pub boundary operator I64::from_f64(value: f64) -> i64 in Trapping
ensures
    result == FloatSemantics::to_i64(Float::meaning64(value));

pub boundary operator I64::from_f64(value: f64) -> i64 in Saturating
ensures
    result == FloatSemantics::to_i64_saturating(Float::meaning64(value));

pub boundary operator U8::from_f32(value: f32) -> u8
requires
    value == value && value > -1.0f32 && value < 256.0f32
ensures
    result == FloatSemantics::to_u8(Float::meaning32(value));

pub boundary operator U8::from_f32(value: f32) -> u8 in Trapping
ensures
    result == FloatSemantics::to_u8(Float::meaning32(value));

pub boundary operator U8::from_f32(value: f32) -> u8 in Saturating
ensures
