// Primitive fixed-token identities. Selection is operand-driven and recorded
// in checked operator evidence; the result contract is equality with the one
// executable semantic definition above. Each is a top-level token-bearing
// boundary signature: the fixed token after `boundary machine` identifies
// the required operator slot, and a realizing boundary machine reaches it
// through the ordinary exact `satisfies` relationship without redeclaring
// the token.
public boundary machine + Float::add(left: f32, right: f32) -> f32
ensures
    |proof|::Identity::<|float_meaning|::FloatMeaning>(
        Float::meaning32(result),
        FloatSemantics::add(
            |float_format|::FloatFormat::BINARY32,
            Float::meaning32(left),
            Float::meaning32(right)
        )
    );

public boundary machine + Float::add(left: f64, right: f64) -> f64
ensures
    |proof|::Identity::<|float_meaning|::FloatMeaning>(
        Float::meaning64(result),
        FloatSemantics::add(
            |float_format|::FloatFormat::BINARY64,
            Float::meaning64(left),
            Float::meaning64(right)
        )
    );

public boundary machine - Float::subtract(left: f32, right: f32) -> f32
