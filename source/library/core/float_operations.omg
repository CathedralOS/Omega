// Primitive fixed-token identities. Selection is operand-driven and recorded
// in checked operator evidence; the result contract is equality with the one
// executable semantic definition above. The fixed token is written directly
// in each declaration head.
pub boundary operator + Float::add(left: f32, right: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::add(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right)
    );

pub boundary operator + Float::add(left: f64, right: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::add(
        FloatFormat::BINARY64,
        Float::meaning64(left),
        Float::meaning64(right)
    );

pub boundary operator - Float::subtract(left: f32, right: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::subtract(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right)
    );

pub boundary operator - Float::subtract(left: f64, right: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::subtract(
        FloatFormat::BINARY64,
        Float::meaning64(left),
        Float::meaning64(right)
    );

pub boundary operator * Float::multiply(left: f32, right: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::multiply(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right)
    );

pub boundary operator * Float::multiply(left: f64, right: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::multiply(
        FloatFormat::BINARY64,
        Float::meaning64(left),
        Float::meaning64(right)
    );

pub boundary operator / Float::divide(left: f32, right: f32) -> f32
ensures
    Float::meaning32(result) == FloatSemantics::divide(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right)
    );

pub boundary operator / Float::divide(left: f64, right: f64) -> f64
ensures
    Float::meaning64(result) == FloatSemantics::divide(
        FloatFormat::BINARY64,
        Float::meaning64(left),
        Float::meaning64(right)
    );

pub boundary operator == Float::equal(left: f32, right: f32) -> bool
ensures
    result == FloatSemantics::equal(
        Float::meaning32(left),
        Float::meaning32(right)
    );

pub boundary operator == Float::equal(left: f64, right: f64) -> bool
ensures
    result == FloatSemantics::equal(
        Float::meaning64(left),
        Float::meaning64(right)
    );

pub boundary operator != Float::not_equal(left: f32, right: f32) -> bool
ensures
    result == FloatSemantics::not_equal(
        Float::meaning32(left),
        Float::meaning32(right)
    );

pub boundary operator != Float::not_equal(left: f64, right: f64) -> bool
ensures
    result == FloatSemantics::not_equal(
        Float::meaning64(left),
        Float::meaning64(right)
    );

pub boundary operator < Float::less(left: f32, right: f32) -> bool
ensures
    result == FloatSemantics::less(
        Float::meaning32(left),
        Float::meaning32(right)
    );

pub boundary operator < Float::less(left: f64, right: f64) -> bool
ensures
    result == FloatSemantics::less(
        Float::meaning64(left),
        Float::meaning64(right)
    );

pub boundary operator <= Float::less_or_equal(left: f32, right: f32) -> bool
ensures
