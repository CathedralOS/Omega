use {omega}/language/core/fixed_vec.omg;
use {omega}/language/core/numeric_conversion.omg;
use {omega}/language/core/reflect/reflect.omg;
use {omega}/language/core/wire.omg;

// The compact binary grammar is implemented by ordinary checked library
// machines. Reflection supplies typed member calls; these machines own byte
// framing and canonical unsigned LEB128, independently of the compiler.

public machine write_unsigned(out: @mutable [u8], start: u64, value: u64) -> |wire|::EncodeResult {
    group(out, start, value, 10u64)

    machine group(out: @mutable [u8], cursor: u64, value: u64, remaining_steps: u64) -> |wire|::EncodeResult
    terminates by remaining_steps
    requires remaining_steps > 0u64
    {
        transition cursor < out.length {
            true -> emit(out, cursor, value, remaining_steps),
            false -> |wire|::EncodeResult::Exhausted
        }
    }
    machine emit(out: @mutable [u8], cursor: u64, value: u64, remaining_steps: u64) -> |wire|::EncodeResult
    requires cursor < out.length && remaining_steps > 0u64
    {
        let low: u8 = (value & 127u64) as u8;
        transition value < 128u64 {
            true -> last(out, cursor, low),
            false -> more(out, cursor, value, remaining_steps, low)
        }
    }
    machine last(out: @mutable [u8], cursor: u64, low: u8) -> |wire|::EncodeResult
    requires cursor < out.length
    {
        out[cursor] = low;
        |wire|::EncodeResult::Encoded { next: cursor + 1u64 }
    }
    machine more(out: @mutable [u8], cursor: u64, value: u64, remaining_steps: u64, low: u8) -> |wire|::EncodeResult
    requires cursor < out.length && remaining_steps > 0u64
    {
        out[cursor] = low | 128u8;
        transition remaining_steps > 1u64 {
            true -> group(out, cursor + 1u64, value >> 7u64, remaining_steps - 1u64),
            false -> |wire|::EncodeResult::Exhausted
        }
    }
}

public machine read_unsigned(bytes: @[u8], start: u64) -> |wire|::UnsignedRead {
    group(bytes, start, 0u64, 0u64, 10u64)

    machine group(bytes: @[u8], cursor: u64, value: u64, shift: u64, remaining_steps: u64) -> |wire|::UnsignedRead
    terminates by remaining_steps
    requires remaining_steps > 0u64 && shift <= 63u64
    {
        transition cursor < bytes.length {
            true -> read(bytes, cursor, value, shift, remaining_steps),
            false -> |wire|::UnsignedRead::Invalid
        }
    }
    machine read(bytes: @[u8], cursor: u64, value: u64, shift: u64, remaining_steps: u64) -> |wire|::UnsignedRead
    requires cursor < bytes.length && remaining_steps > 0u64 && shift <= 63u64
    {
        let byte: u8 = bytes[cursor];
        let payload: u64 = (byte & 127u8) as u64;
        transition shift == 63u64 && payload > 1u64 {
            true -> |wire|::UnsignedRead::Invalid,
            false -> accept(bytes, cursor, value, shift, remaining_steps, byte, payload)
        }
    }
    machine accept(bytes: @[u8], cursor: u64, value: u64, shift: u64, remaining_steps: u64, byte: u8, payload: u64) -> |wire|::UnsignedRead
    requires cursor < bytes.length && remaining_steps > 0u64 && shift <= 63u64
    {
        let combined: u64 = ((value as +Wrapping) | ((payload as +Wrapping) << shift)) as -Wrapping;
        transition {
            byte < 128u8 && (shift == 0u64 || payload != 0u64) -> |wire|::UnsignedRead::Read { value: combined, next: cursor + 1u64 },
            byte < 128u8 -> |wire|::UnsignedRead::Invalid,
            remaining_steps > 1u64 && shift <= 56u64 -> group(bytes, cursor + 1u64, combined, shift + 7u64, remaining_steps - 1u64),
            _ -> |wire|::UnsignedRead::Invalid
        }
    }
}

// The owner supplies traversal explicitly. This library cannot enumerate T
// merely because T is carried through this generic entry.
public machine encode<T, machine Visit>(
    value: @T, out: @mutable [u8], scratch: @mutable [u8], fields: @mutable [|wire|::EncodedField], remaining_steps: u64
) -> |wire|::EncodeResult
requires machine Visit(value: @T, context: @mutable |wire|::EncodeContext);
{
    let mutable context: |wire|::EncodeContext = |wire|::EncodeContext {
        storage: scratch, fields: fields, used: 0u64, count: 0u64, valid: true, remaining_steps: remaining_steps
    };
    Visit(value, @mutable context);
    transition context.valid && context.count <= context.fields.length && context.used <= context.storage.length && context.remaining_steps > 0u64 {
        true -> frame_fields(@context, out, context.remaining_steps),
        false -> |wire|::EncodeResult::Exhausted
    }
 }
// Framing consumes the staged document only; it carries no value-type or
// visitor telescope, and runs after the owner's traversal has completed.
machine frame_fields(context: @|wire|::EncodeContext, out: @mutable [u8], remaining_steps: u64) -> |wire|::EncodeResult
    requires context.count <= context.fields.length && context.used <= context.storage.length && remaining_steps > 0u64
    {
        transition write_unsigned(out, 0u64, 0u64) {
            |wire|::EncodeResult::Encoded { next } -> flush_fields(@context.storage[..], @context.fields[..], context.count, out, next, remaining_steps),
            _ -> |wire|::EncodeResult::Exhausted
        }
    }

// Pure byte-word conversion on the exact admitted unsigned scalar types.
// The Boolean branch has its own checked parameter; no layout-based cast or
// metadata key supplies a type or a read permission.
machine compact_scalar_word<Kind>(value: @Kind) -> u64
requires Kind == u8 || Kind == u16 || Kind == u32 || Kind == u64 || Kind == bool
    || Kind == i8 || Kind == i16 || Kind == i32 || Kind == i64
{
    transition {
        Kind == bool -> boolean(value),
        Kind == i8 || Kind == i16 || Kind == i32 || Kind == i64 -> signed(value),
        _ -> ($value as u64)
    }
    machine boolean(value: @bool) -> u64 {
        transition $value { true -> 1u64, false -> 0u64 }
    }
    machine signed(value: @Kind) -> u64
    requires Kind == i8 || Kind == i16 || Kind == i32 || Kind == i64
    {
        compact_signed_word($value as i64)
    }
}

public machine scalar_field<Kind>(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, value: @Kind)
requires Kind == u8 || Kind == u16 || Kind == u32 || Kind == u64 || Kind == bool
    || Kind == i8 || Kind == i16 || Kind == i32 || Kind == i64
{
    transition context.valid && info.has_stable_number && context.count < context.fields.length {
        true -> tag(context, info, value),
        false -> invalid(context)
    }
    machine tag(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, value: @Kind)
    requires context.count < context.fields.length && (Kind == u8 || Kind == u16 || Kind == u32 || Kind == u64 || Kind == bool
        || Kind == i8 || Kind == i16 || Kind == i32 || Kind == i64)
    {
        let start: u64 = context.used;
        let word: u64 = compact_scalar_word::<Kind>(value);
        transition write_unsigned(@mutable context.storage[..], start, info.stable_number) {
            |wire|::EncodeResult::Encoded { next } -> content(context, info, start, word, next),
            _ -> invalid(context)
        }
    }
    machine content(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, start: u64, word: u64, next: u64)
    requires context.count < context.fields.length
    {
        transition write_unsigned(@mutable context.storage[..], next, word) {
            |wire|::EncodeResult::Encoded { next as end } -> remember(context, info, start, end),
            _ -> invalid(context)
        }
    }
    machine remember(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, start: u64, end: u64)
    requires context.count < context.fields.length
    {
        context.fields[context.count] = |wire|::EncodedField { number: info.stable_number, start: start, end: end };
        context.count = context.count + 1u64;
        context.used = end;
    }
    machine invalid(context: @mutable |wire|::EncodeContext) { context.valid = false; }
}

data CompactCopy {
    case Exhausted;
    case Copied(next: u64, remaining_steps: u64);
}

machine compact_copy(bytes: @[u8], start: u64, end: u64, out: @mutable [u8], cursor: u64, remaining_steps: u64) -> CompactCopy
terminates by remaining_steps
requires remaining_steps > 0u64
{
    transition {
        start == end -> CompactCopy::Copied { next: cursor, remaining_steps: remaining_steps },
        start < end && start < bytes.length && cursor < out.length && remaining_steps > 1u64 -> byte(bytes, start, end, out, cursor, remaining_steps),
        _ -> CompactCopy::Exhausted
    }
    machine byte(bytes: @[u8], start: u64, end: u64, out: @mutable [u8], cursor: u64, remaining_steps: u64) -> CompactCopy
    requires start < bytes.length && cursor < out.length && remaining_steps > 1u64
    {
        out[cursor] = bytes[start];
        compact_copy(bytes, start + 1u64, end, out, cursor + 1u64, remaining_steps - 1u64)
    }
}

// Stable-number order is library policy. The bounded search rejects duplicate
// numbers and malformed frame ranges, and reports sponsorship exhaustion.
machine flush_fields(bytes: @[u8], fields: @[|wire|::EncodedField], count: u64, out: @mutable [u8], cursor: u64, remaining_steps: u64) -> |wire|::EncodeResult
terminates by remaining_steps
requires count <= fields.length && remaining_steps > 0u64
{
    emit(bytes, fields, count, out, cursor, count, 0u64, false, remaining_steps)

    machine emit(bytes: @[u8], fields: @[|wire|::EncodedField], count: u64, out: @mutable [u8], cursor: u64, remaining: u64, previous: u64, has_previous: bool, remaining_steps: u64) -> |wire|::EncodeResult
    terminates by remaining_steps
    requires count <= fields.length && remaining_steps > 0u64
    {
        transition remaining == 0u64 {
            true -> |wire|::EncodeResult::Encoded { next: cursor },
            false -> scan(bytes, fields, count, out, cursor, remaining, previous, has_previous, 0u64, 0u64, false, 0u64, remaining_steps)
        }
    }
    machine scan(bytes: @[u8], fields: @[|wire|::EncodedField], count: u64, out: @mutable [u8], cursor: u64, remaining: u64, previous: u64, has_previous: bool, slot: u64, best: u64, found: bool, number: u64, remaining_steps: u64) -> |wire|::EncodeResult
    terminates by remaining_steps
    requires count <= fields.length && remaining_steps > 0u64
    {
        transition {
            slot < count && slot < fields.length && remaining_steps > 1u64 -> examine(bytes, fields, count, out, cursor, remaining, previous, has_previous, slot, best, found, number, remaining_steps),
            slot == count && found && best < count && best < fields.length && remaining > 0u64 && remaining_steps > 1u64 -> copy(bytes, fields, count, out, cursor, remaining, best, number, remaining_steps),
            _ -> |wire|::EncodeResult::Exhausted
        }
    }
    machine examine(bytes: @[u8], fields: @[|wire|::EncodedField], count: u64, out: @mutable [u8], cursor: u64, remaining: u64, previous: u64, has_previous: bool, slot: u64, best: u64, found: bool, number: u64, remaining_steps: u64) -> |wire|::EncodeResult
    requires count <= fields.length && slot < fields.length && remaining_steps > 1u64
    {
        let candidate: |wire|::EncodedField = fields[slot];
        transition (!has_previous || candidate.number > previous) && (!found || candidate.number < number) {
            true -> scan(bytes, fields, count, out, cursor, remaining, previous, has_previous, slot + 1u64, slot, true, candidate.number, remaining_steps - 1u64),
            false -> scan(bytes, fields, count, out, cursor, remaining, previous, has_previous, slot + 1u64, best, found, number, remaining_steps - 1u64)
        }
    }
    machine copy(bytes: @[u8], fields: @[|wire|::EncodedField], count: u64, out: @mutable [u8], cursor: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64) -> |wire|::EncodeResult
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        let frame: |wire|::EncodedField = fields[best];
        transition frame.start <= frame.end && frame.end <= bytes.length {
            true -> copy_frame(bytes, fields, count, out, cursor, remaining, number, remaining_steps, frame.start, frame.end),
            false -> |wire|::EncodeResult::Exhausted
        }
    }
    machine copy_frame(bytes: @[u8], fields: @[|wire|::EncodedField], count: u64, out: @mutable [u8], cursor: u64, remaining: u64, number: u64, remaining_steps: u64, start: u64, end: u64) -> |wire|::EncodeResult
    requires count <= fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        transition compact_copy(bytes, start, end, out, cursor, remaining_steps - 1u64) {
            CompactCopy::Copied { next, remaining_steps as left } -> continue_fields(bytes, fields, count, out, next, remaining, number, remaining_steps, left),
            _ -> |wire|::EncodeResult::Exhausted
        }
    }
    machine continue_fields(bytes: @[u8], fields: @[|wire|::EncodedField], count: u64, out: @mutable [u8], cursor: u64, remaining: u64, number: u64, remaining_steps: u64, left: u64) -> |wire|::EncodeResult
    requires count <= fields.length && remaining > 0u64 && remaining_steps > 0u64
    {
        transition left > 0u64 && left < remaining_steps {
            true -> emit(bytes, fields, count, out, cursor, remaining - 1u64, number, true, left),
            false -> |wire|::EncodeResult::Exhausted
        }
    }
}

machine compact_signed_word(value: i64) -> u64 {
    let bits: u64 = |numeric_conversion|::narrow_i64_to_u64_wrapping(value);
    let sign: u64 = |numeric_conversion|::narrow_i64_to_u64_wrapping(value >> 63u64);
    let zigzag: u64 = (((bits as +Wrapping) << 1u64) ^ (sign as +Wrapping)) as -Wrapping;
    zigzag
}

public machine write_signed(out: @mutable [u8], start: u64, value: i64) -> |wire|::EncodeResult {
    write_unsigned(out, start, compact_signed_word(value))
}

public machine read_signed(bytes: @[u8], start: u64) -> |wire|::SignedRead {
    transition read_unsigned(bytes, start) {
        |wire|::UnsignedRead::Read { value, next } -> restore(value, next),
        _ -> |wire|::SignedRead::Invalid
    }
    machine restore(word: u64, next: u64) -> |wire|::SignedRead {
        |wire|::SignedRead::Read { value: signed_from_word(word), next: next }
    }
}

public machine write_blob(out: @mutable [u8], start: u64, bytes: @[u8], remaining_steps: u64) -> |wire|::EncodeResult
requires remaining_steps > 0u64
{
    transition write_unsigned(out, start, bytes.length) {
        |wire|::EncodeResult::Encoded { next } -> copy(out, next, bytes, remaining_steps),
        _ -> |wire|::EncodeResult::Exhausted
    }
    machine copy(out: @mutable [u8], next: u64, bytes: @[u8], remaining_steps: u64) -> |wire|::EncodeResult
    requires remaining_steps > 0u64
    {
        transition compact_copy(bytes, 0u64, bytes.length, out, next, remaining_steps) {
            CompactCopy::Copied { next as end, remaining_steps as left } -> |wire|::EncodeResult::Encoded { next: end },
            _ -> |wire|::EncodeResult::Exhausted
        }
    }
}

public machine read_blob<'input>(bytes: @'input [u8], start: u64) -> |wire|::BlobRead<'input> {
    transition read_unsigned(bytes, start) {
        |wire|::UnsignedRead::Read { value as length, next } -> slice(bytes, length, next),
        _ -> |wire|::BlobRead::Invalid
    }
    machine slice(bytes: @'input [u8], length: u64, next: u64) -> |wire|::BlobRead<'input> {
        transition length <= bytes.length && next <= bytes.length - length {
            true -> |wire|::BlobRead::Read { value: bytes[next..next + length], next: next + length },
            false -> |wire|::BlobRead::Invalid
        }
    }
}

// A caller selects the schema's exact identity. Reading a tag only checks
// grammar correspondence; it cannot establish a destination field's domain.
public machine read_scalar_field(bytes: @[u8], start: u64, number: u64) -> |wire|::UnsignedRead {
    transition read_unsigned(bytes, start) {
        |wire|::UnsignedRead::Read { value, next } -> tag(bytes, number, value, next),
        _ -> |wire|::UnsignedRead::Invalid
    }
    machine tag(bytes: @[u8], expected: u64, observed: u64, next: u64) -> |wire|::UnsignedRead {
        transition observed == expected {
            true -> read_unsigned(bytes, next),
            false -> |wire|::UnsignedRead::Invalid
        }
    }
}

public machine read_signed_field(bytes: @[u8], start: u64, number: u64) -> |wire|::SignedRead {
    transition read_unsigned(bytes, start) {
        |wire|::UnsignedRead::Read { value, next } -> tag(bytes, number, value, next),
        _ -> |wire|::SignedRead::Invalid
    }
    machine tag(bytes: @[u8], expected: u64, observed: u64, next: u64) -> |wire|::SignedRead {
        transition observed == expected {
            true -> read_signed(bytes, next),
            false -> |wire|::SignedRead::Invalid
        }
    }
}

public machine read_blob_field<'input>(bytes: @'input [u8], start: u64, number: u64) -> |wire|::BlobRead<'input> {
    transition read_unsigned(bytes, start) {
        |wire|::UnsignedRead::Read { value, next } -> tag(bytes, number, value, next),
        _ -> |wire|::BlobRead::Invalid
    }
    machine tag(bytes: @'input [u8], expected: u64, observed: u64, next: u64) -> |wire|::BlobRead<'input> {
        transition observed == expected {
            true -> read_blob(bytes, next),
            false -> |wire|::BlobRead::Invalid
        }
    }
}

// UTF-8 is validated over the actual borrowed bytes by ordinary source code.
// Successful validation describes text; it supplies no owned authority.
public machine valid_utf8(bytes: @[u8]) -> bool {
    transition bytes.length == 0u64 {
        true -> true,
        false -> scan(bytes, 0u64, bytes.length)
    }
    machine scan(bytes: @[u8], cursor: u64, remaining_steps: u64) -> bool
    terminates by remaining_steps
    requires remaining_steps > 0u64
    {
        transition {
            cursor == bytes.length -> true,
            cursor < bytes.length -> head(bytes, cursor, remaining_steps),
            _ -> false
        }
    }
    machine head(bytes: @[u8], cursor: u64, remaining_steps: u64) -> bool
    requires cursor < bytes.length && remaining_steps > 0u64
    {
        let byte: u8 = bytes[cursor];
        let remaining: u64 = bytes.length - cursor;
        transition {
            byte <= 127u8 -> advance(bytes, cursor + 1u64, remaining_steps),
            byte >= 194u8 && byte <= 223u8 && remaining >= 2u64 -> two(bytes, cursor, remaining_steps),
            byte >= 224u8 && byte <= 239u8 && remaining >= 3u64 -> three(bytes, cursor, remaining_steps, byte),
            byte >= 240u8 && byte <= 244u8 && remaining >= 4u64 -> four(bytes, cursor, remaining_steps, byte),
            _ -> false
        }
    }
    machine continuation(byte: u8) -> bool { byte >= 128u8 && byte <= 191u8 }
    machine two(bytes: @[u8], cursor: u64, remaining_steps: u64) -> bool
    requires bytes.length >= 2u64 && cursor <= bytes.length - 2u64 && remaining_steps > 0u64
    {
        transition continuation(bytes[cursor + 1u64]) {
            true -> advance(bytes, cursor + 2u64, remaining_steps),
            false -> false
        }
    }
    machine three(bytes: @[u8], cursor: u64, remaining_steps: u64, byte: u8) -> bool
    requires bytes.length >= 3u64 && cursor <= bytes.length - 3u64 && remaining_steps > 0u64
    {
        let second: u8 = bytes[cursor + 1u64];
        transition continuation(second) && continuation(bytes[cursor + 2u64])
            && (byte != 224u8 || second >= 160u8)
            && (byte != 237u8 || second <= 159u8) {
            true -> advance(bytes, cursor + 3u64, remaining_steps),
            false -> false
        }
    }
    machine four(bytes: @[u8], cursor: u64, remaining_steps: u64, byte: u8) -> bool
    requires bytes.length >= 4u64 && cursor <= bytes.length - 4u64 && remaining_steps > 0u64
    {
        let second: u8 = bytes[cursor + 1u64];
        transition continuation(second) && continuation(bytes[cursor + 2u64]) && continuation(bytes[cursor + 3u64])
            && (byte != 240u8 || second >= 144u8)
            && (byte != 244u8 || second <= 143u8) {
            true -> advance(bytes, cursor + 4u64, remaining_steps),
            false -> false
        }
    }
    machine advance(bytes: @[u8], next: u64, remaining_steps: u64) -> bool
    requires next <= bytes.length && remaining_steps > 0u64
    {
        transition {
            next == bytes.length -> true,
            remaining_steps > 1u64 -> scan(bytes, next, remaining_steps - 1u64),
            _ -> false
        }
    }
}

machine compact_signed_minimum<Kind>() -> i64 {
    transition {
        Kind == i8 -> -128i64,
        Kind == i16 -> -32768i64,
        Kind == i32 -> -2147483648i64,
        _ -> -9223372036854775808i64
    }
}
machine compact_signed_maximum<Kind>() -> i64 {
    transition {
        Kind == i8 -> 127i64,
        Kind == i16 -> 32767i64,
        Kind == i32 -> 2147483647i64,
        _ -> 9223372036854775807i64
    }
}
machine compact_unsigned_maximum<Kind>() -> u64 {
    transition {
        Kind == bool -> 1u64,
        Kind == u8 -> 255u64,
        Kind == u16 -> 65535u64,
        Kind == u32 -> 4294967295u64,
        _ -> 18446744073709551615u64
    }
}

// Only the owner invokes this callback through its authorized declaration
// query. No future value, field reference or constructor authority is supplied.
public machine plan_scalar<Kind>(context: @mutable |wire|::ScalarPlanContext, field: @|reflect|::FieldInfo)
requires Kind == u8 || Kind == u16 || Kind == u32 || Kind == u64 || Kind == bool
    || Kind == i8 || Kind == i16 || Kind == i32 || Kind == i64
{
    let slot: |wire|::ScalarSlot = |wire|::ScalarSlot {
        number: field.stable_number,
        is_signed: Kind == i8 || Kind == i16 || Kind == i32 || Kind == i64,
        is_payload: false, start: 0u64, end: 0u64,
        minimum: compact_signed_minimum::<Kind>(),
        maximum: compact_signed_maximum::<Kind>(),
        unsigned_maximum: compact_unsigned_maximum::<Kind>(),
        signed: 0i64,
        unsigned: 0u64
    };
    transition context.valid && context.count < context.slots.length
        && field.has_stable_number && !field.is_erased {
        true -> append(context, slot),
        false -> invalid(context)
    }
    machine append(context: @mutable |wire|::ScalarPlanContext, slot: |wire|::ScalarSlot)
    requires context.count < context.slots.length
    {
        context.slots[context.count] = slot;
        context.count = context.count + 1u64;
    }
    machine invalid(context: @mutable |wire|::ScalarPlanContext) { context.valid = false; }
}

// Decode canonical era-zero scalar fields in stable-number order. Caller
// storage and remaining_steps bound all work. Duplicate tags, unknown tags, malformed
// words, carrier overflow and exhausted sponsorship fail before construction.
public machine read_scalar_fields(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, start: u64, remaining_steps: u64) -> |wire|::FrameRead
requires count <= fields.length && remaining_steps > 0u64
{
    transition read_unsigned(bytes, start) {
        |wire|::UnsignedRead::Read { value, next } -> era(bytes, fields, count, value, next, remaining_steps),
        _ -> |wire|::FrameRead::Invalid
    }
    machine era(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, value: u64, cursor: u64, remaining_steps: u64) -> |wire|::FrameRead
    requires count <= fields.length && remaining_steps > 0u64
    {
        transition value == 0u64 {
            true -> read_payload_fields(bytes, fields, count, cursor, remaining_steps),
            false -> |wire|::FrameRead::Invalid
        }
    }
}
// Nested record payloads contain the same sorted tagged fields, with no
// second era discriminator. They still require their exact enclosing bound.
public machine read_payload_fields(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, cursor: u64, remaining_steps: u64) -> |wire|::FrameRead
requires count <= fields.length && remaining_steps > 0u64
{
    emit(bytes, fields, count, cursor, count, 0u64, false, remaining_steps)
    machine emit(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, cursor: u64, remaining: u64, previous: u64, has_previous: bool, remaining_steps: u64) -> |wire|::FrameRead
    terminates by remaining_steps
    requires count <= fields.length && remaining_steps > 0u64
    {
        transition remaining == 0u64 {
            true -> |wire|::FrameRead::Read { next: cursor },
            false -> scan(bytes, fields, count, cursor, remaining, previous, has_previous, 0u64, 0u64, false, 0u64, remaining_steps)
        }
    }
    machine scan(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, cursor: u64, remaining: u64, previous: u64, has_previous: bool, slot: u64, best: u64, found: bool, number: u64, remaining_steps: u64) -> |wire|::FrameRead
    terminates by remaining_steps
    requires count <= fields.length && remaining_steps > 0u64
    {
        transition {
            slot < count && slot < fields.length && remaining_steps > 1u64 -> examine(bytes, fields, count, cursor, remaining, previous, has_previous, slot, best, found, number, remaining_steps),
            slot == count && found && best < count && best < fields.length && remaining > 0u64 && remaining_steps > 1u64 -> read(bytes, fields, count, cursor, remaining, best, number, remaining_steps),
            _ -> |wire|::FrameRead::Invalid
        }
    }
    machine examine(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, cursor: u64, remaining: u64, previous: u64, has_previous: bool, slot: u64, best: u64, found: bool, number: u64, remaining_steps: u64) -> |wire|::FrameRead
    requires count <= fields.length && slot < fields.length && remaining_steps > 1u64
    {
        let candidate: |wire|::ScalarSlot = fields[slot];
        transition (!has_previous || candidate.number > previous) && (!found || candidate.number < number) {
            true -> scan(bytes, fields, count, cursor, remaining, previous, has_previous, slot + 1u64, slot, true, candidate.number, remaining_steps - 1u64),
            false -> scan(bytes, fields, count, cursor, remaining, previous, has_previous, slot + 1u64, best, found, number, remaining_steps - 1u64)
        }
    }
    machine read(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, cursor: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64) -> |wire|::FrameRead
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        transition {
            fields[best].is_payload -> read_payload(bytes, fields, count, cursor, remaining, best, number, remaining_steps),
            fields[best].is_signed -> read_signed(bytes, fields, count, cursor, remaining, best, number, remaining_steps),
            _ -> read_unsigned(bytes, fields, count, cursor, remaining, best, number, remaining_steps)
        }
    }
    machine read_payload(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, cursor: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64) -> |wire|::FrameRead
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        transition read_blob_field(bytes, cursor, number) {
            |wire|::BlobRead::Read { value, next } -> payload(bytes, fields, count, remaining, best, number, remaining_steps, value.length, next),
            _ -> |wire|::FrameRead::Invalid
        }
    }
    machine payload(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64, length: u64, next: u64) -> |wire|::FrameRead
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        transition length <= next && next <= bytes.length {
            true -> store_payload(bytes, fields, count, remaining, best, number, remaining_steps, length, next),
            false -> |wire|::FrameRead::Invalid
        }
    }
    machine store_payload(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64, length: u64, next: u64) -> |wire|::FrameRead
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64 && length <= next
    {
        fields[best].start = next - length;
        fields[best].end = next;
        emit(bytes, fields, count, next, remaining - 1u64, number, true, remaining_steps - 1u64)
    }
    machine read_signed(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, cursor: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64) -> |wire|::FrameRead
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        transition read_signed_field(bytes, cursor, number) {
            |wire|::SignedRead::Read { value, next } -> signed(bytes, fields, count, remaining, best, number, remaining_steps, value, next),
            _ -> |wire|::FrameRead::Invalid
        }
    }
    machine signed(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64, value: i64, next: u64) -> |wire|::FrameRead
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        transition value >= fields[best].minimum && value <= fields[best].maximum {
            true -> store_signed(bytes, fields, count, remaining, best, number, remaining_steps, value, next),
            false -> |wire|::FrameRead::Invalid
        }
    }
    machine store_signed(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64, value: i64, next: u64) -> |wire|::FrameRead
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        fields[best].signed = value;
        emit(bytes, fields, count, next, remaining - 1u64, number, true, remaining_steps - 1u64)
    }
    machine read_unsigned(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, cursor: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64) -> |wire|::FrameRead
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        transition read_scalar_field(bytes, cursor, number) {
            |wire|::UnsignedRead::Read { value, next } -> unsigned(bytes, fields, count, remaining, best, number, remaining_steps, value, next),
            _ -> |wire|::FrameRead::Invalid
        }
    }
    machine unsigned(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64, value: u64, next: u64) -> |wire|::FrameRead
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        transition value <= fields[best].unsigned_maximum {
            true -> store_unsigned(bytes, fields, count, remaining, best, number, remaining_steps, value, next),
            false -> |wire|::FrameRead::Invalid
        }
    }
    machine store_unsigned(bytes: @[u8], fields: @mutable [|wire|::ScalarSlot], count: u64, remaining: u64, best: u64, number: u64, remaining_steps: u64, value: u64, next: u64) -> |wire|::FrameRead
    requires count <= fields.length && best < fields.length && remaining > 0u64 && remaining_steps > 1u64
    {
        fields[best].unsigned = value;
        emit(bytes, fields, count, next, remaining - 1u64, number, true, remaining_steps - 1u64)
    }
}

// Staged decoding exposes a descriptive document without constructing T.
// Owners with input-borrowing values can establish them directly in their own
// scope after validating these regions, retaining the original input loan.
public machine read_record<machine Plan>(bytes: @[u8], slots: @mutable [|wire|::ScalarSlot], remaining_steps: u64) -> |wire|::FrameRead
requires machine Plan(context: @mutable |wire|::ScalarPlanContext);
requires remaining_steps > 0u64
{
    let mutable context: |wire|::ScalarPlanContext = |wire|::ScalarPlanContext { slots: slots, count: 0u64, valid: true };
    Plan(@mutable context);
    transition context.valid && context.count <= context.slots.length {
        true -> parse(bytes, @mutable context, remaining_steps),
        false -> |wire|::FrameRead::Invalid
    }
    machine parse(bytes: @[u8], context: @mutable |wire|::ScalarPlanContext, remaining_steps: u64) -> |wire|::FrameRead
    requires context.count <= context.slots.length && remaining_steps > 0u64
    { read_scalar_fields(bytes, @mutable context.slots[..], context.count, 0u64, remaining_steps) }
}

// The constructor is an explicitly supplied owner operation. Parsing produces
// a scalar document; only that checked operation establishes the semantic T.
// A rejected constructor leaves the caller's committed cursor unchanged.
public machine decode_record<'input, T, machine Plan, machine Construct>(bytes: @'input [u8], slots: @mutable [|wire|::ScalarSlot], next: @mutable u64, remaining_steps: u64) -> |wire|::DecodeResult<T>
requires machine Plan(context: @mutable |wire|::ScalarPlanContext);
requires machine Construct(bytes: @'input [u8], fields: @[|wire|::ScalarSlot]) -> |wire|::DecodeResult<T>;
requires remaining_steps > 0u64
{
    let mutable context: |wire|::ScalarPlanContext = |wire|::ScalarPlanContext { slots: slots, count: 0u64, valid: true };
    Plan(@mutable context);
    transition context.valid && context.count <= context.slots.length {
        true -> parse(bytes, @mutable context, next, remaining_steps),
        false -> |wire|::DecodeResult::Invalid
    }
    machine parse(bytes: @'input [u8], context: @mutable |wire|::ScalarPlanContext, next: @mutable u64, remaining_steps: u64) -> |wire|::DecodeResult<T>
    requires context.count <= context.slots.length && remaining_steps > 0u64
    {
        transition read_scalar_fields(bytes, @mutable context.slots[..], context.count, 0u64, remaining_steps) {
            |wire|::FrameRead::Read { next as cursor } -> construct(bytes, context, next, cursor),
            _ -> |wire|::DecodeResult::Invalid
        }
    }
    machine construct(bytes: @'input [u8], context: @|wire|::ScalarPlanContext, next: @mutable u64, cursor: u64) -> |wire|::DecodeResult<T>
    requires context.count <= context.slots.length
    {
        transition Construct(bytes, @context.slots[0u64..context.count]) {
            |wire|::DecodeResult::Sound { value } -> commit(value, next, cursor),
            _ -> |wire|::DecodeResult::Invalid
        }
    }
    machine commit(value: T, next: @mutable u64, cursor: u64) -> |wire|::DecodeResult<T> {
        $next = cursor;
        |wire|::DecodeResult::Sound { value: value }
    }
}

// Array and borrowed-slice adapters share the same two-pass packed grammar.
// The complete reflected Kind remains an explicit equality obligation; element
// and capacity matching never discard a qualification from the field type.
public machine packed_field<Kind, Element, const N: u64>(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, value: @[Element; N])
requires Kind == [Element; N]
    && (Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
        || Element == i8 || Element == i16 || Element == i32 || Element == i64)
{
    compact_packed_field::<Element>(context, info, @value[..]);
}
public machine packed_slice_field<Kind, Element>(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, value: @ @[Element])
requires Kind == @[Element]
    && (Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
        || Element == i8 || Element == i16 || Element == i32 || Element == i64)
{
    compact_packed_field::<Element>(context, info, @value[..]);
}
public machine bytes_field<Kind>(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, value: @ @[u8])
requires Kind == @[u8]
{
    blob_field(context, info, @value[..]);
}

data CompactMeasure {
    case Exhausted;
    case Measured(bytes: u64, remaining_steps: u64);
}
machine compact_word_width(value: u64) -> u64 {
    group(value, 1u64, 10u64)
    machine group(value: u64, size: u64, remaining_steps: u64) -> u64
    terminates by remaining_steps
    requires remaining_steps > 0u64 && size <= 10u64
    {
        transition {
            value < 128u64 -> size,
            remaining_steps > 1u64 && size < 10u64 -> group(value >> 7u64, size + 1u64, remaining_steps - 1u64),
            _ -> 10u64
        }
    }
}
machine compact_measure_words<Element>(items: @[Element], index: u64, total: u64, remaining_steps: u64) -> CompactMeasure
terminates by remaining_steps
requires remaining_steps > 0u64
    && (Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
        || Element == i8 || Element == i16 || Element == i32 || Element == i64)
{
    transition {
        index == items.length -> CompactMeasure::Measured { bytes: total, remaining_steps: remaining_steps },
        index < items.length && remaining_steps > 1u64 -> measure(items, index, total, remaining_steps),
        _ -> CompactMeasure::Exhausted
    }
    machine measure(items: @[Element], index: u64, total: u64, remaining_steps: u64) -> CompactMeasure
    requires index < items.length && remaining_steps > 1u64
        && (Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
            || Element == i8 || Element == i16 || Element == i32 || Element == i64)
    {
        let size: u64 = compact_word_width(compact_scalar_word::<Element>(@items[index]));
        transition size <= 18446744073709551615u64 - total {
            true -> compact_measure_words::<Element>(items, index + 1u64, total + size, remaining_steps - 1u64),
            false -> CompactMeasure::Exhausted
        }
    }
}
machine compact_write_words<Element>(items: @[Element], index: u64, out: @mutable [u8], cursor: u64, remaining_steps: u64) -> CompactCopy
terminates by remaining_steps
requires remaining_steps > 0u64
    && (Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
        || Element == i8 || Element == i16 || Element == i32 || Element == i64)
{
    transition {
        index == items.length -> CompactCopy::Copied { next: cursor, remaining_steps: remaining_steps },
        index < items.length && remaining_steps > 1u64 -> write(items, index, out, cursor, remaining_steps),
        _ -> CompactCopy::Exhausted
    }
    machine write(items: @[Element], index: u64, out: @mutable [u8], cursor: u64, remaining_steps: u64) -> CompactCopy
    requires index < items.length && remaining_steps > 1u64
        && (Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
            || Element == i8 || Element == i16 || Element == i32 || Element == i64)
    {
        let word: u64 = compact_scalar_word::<Element>(@items[index]);
        transition write_unsigned(out, cursor, word) {
            |wire|::EncodeResult::Encoded { next } -> compact_write_words::<Element>(items, index + 1u64, out, next, remaining_steps - 1u64),
            _ -> CompactCopy::Exhausted
        }
    }
}
machine compact_encode_invalid(context: @mutable |wire|::EncodeContext) { context.valid = false; }

machine compact_length_field<machine Measure, machine Write, Payload>(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, items: @Payload)
requires machine Measure(value: @Payload, remaining_steps: u64) -> CompactMeasure;
requires machine Write(value: @Payload, out: @mutable [u8], cursor: u64, remaining_steps: u64) -> CompactCopy;
{
    transition context.valid && info.has_stable_number && context.count < context.fields.length && context.remaining_steps > 0u64 {
        true -> measure(context, info, items),
        false -> compact_encode_invalid(context)
    }
    machine measure(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, items: @Payload)
    requires context.count < context.fields.length && context.remaining_steps > 0u64
    {
        transition Measure(items, context.remaining_steps) {
            CompactMeasure::Measured { bytes, remaining_steps } -> begin(context, info, items, bytes, remaining_steps),
            _ -> compact_encode_invalid(context)
        }
    }
    machine begin(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, items: @Payload, bytes: u64, remaining_steps: u64)
    requires context.count < context.fields.length
    {
        transition remaining_steps > 0u64 {
            true -> tag(context, info, items, bytes, remaining_steps),
            false -> compact_encode_invalid(context)
        }
    }
    machine tag(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, items: @Payload, bytes: u64, remaining_steps: u64)
    requires context.count < context.fields.length && remaining_steps > 0u64
    {
        transition write_unsigned(@mutable context.storage[..], context.used, info.stable_number) {
            |wire|::EncodeResult::Encoded { next } -> length(context, info, items, bytes, remaining_steps, next),
            _ -> compact_encode_invalid(context)
        }
    }
    machine length(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, items: @Payload, bytes: u64, remaining_steps: u64, start: u64)
    requires context.count < context.fields.length && remaining_steps > 0u64
    {
        transition write_unsigned(@mutable context.storage[..], start, bytes) {
            |wire|::EncodeResult::Encoded { next } -> payload(context, info, items, remaining_steps, next),
            _ -> compact_encode_invalid(context)
        }
    }
    machine payload(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, items: @Payload, remaining_steps: u64, start: u64)
    requires context.count < context.fields.length && remaining_steps > 0u64
    {
        transition Write(items, @mutable context.storage[..], start, remaining_steps) {
            CompactCopy::Copied { next, remaining_steps as left } -> remember(context, info, next, left),
            _ -> compact_encode_invalid(context)
        }
    }
    machine remember(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, end: u64, left: u64)
    requires context.count < context.fields.length
    {
        context.fields[context.count] = |wire|::EncodedField { number: info.stable_number, start: context.used, end: end };
        context.count = context.count + 1u64;
        context.used = end;
        context.remaining_steps = left;
    }
}

machine compact_packed_field<Element>(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, items: @[Element])
requires Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
    || Element == i8 || Element == i16 || Element == i32 || Element == i64
{
    compact_length_field::<compact_measure_packed<Element>, compact_write_packed<Element>>(context, info, items);
}
machine compact_measure_packed<Element>(value: @[Element], remaining_steps: u64) -> CompactMeasure
requires Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
    || Element == i8 || Element == i16 || Element == i32 || Element == i64
{
    transition remaining_steps > 0u64 {
        true -> compact_measure_words::<Element>(value, 0u64, 0u64, remaining_steps),
        false -> CompactMeasure::Exhausted
    }
}
machine compact_write_packed<Element>(value: @[Element], out: @mutable [u8], cursor: u64, remaining_steps: u64) -> CompactCopy
requires Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
    || Element == i8 || Element == i16 || Element == i32 || Element == i64
{
    transition remaining_steps > 0u64 {
        true -> compact_write_words::<Element>(value, 0u64, out, cursor, remaining_steps),
        false -> CompactCopy::Exhausted
    }
}
public machine blob_field(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, value: @[u8]) {
    compact_length_field::<compact_measure_blob, compact_write_blob>(context, info, value);
}
machine compact_measure_blob(value: @[u8], remaining_steps: u64) -> CompactMeasure {
    CompactMeasure::Measured { bytes: value.length, remaining_steps: remaining_steps }
}
machine compact_write_blob(value: @[u8], out: @mutable [u8], cursor: u64, remaining_steps: u64) -> CompactCopy {
    transition remaining_steps > 0u64 {
        true -> compact_copy(value, 0u64, value.length, out, cursor, remaining_steps),
        false -> CompactCopy::Exhausted
    }
}
public machine scalar_bound<machine Inspect>() -> |wire|::ScalarBound
requires machine Inspect(bound: @mutable |wire|::ScalarBound);
{
    let mutable bound: |wire|::ScalarBound = |wire|::ScalarBound { bytes: 1u64, valid: true };
    Inspect(@mutable bound);
    bound
}
machine compact_scalar_width<Kind>() -> u64
requires Kind == u8 || Kind == u16 || Kind == u32 || Kind == u64 || Kind == bool
    || Kind == i8 || Kind == i16 || Kind == i32 || Kind == i64
{
    transition {
        Kind == bool -> 1u64,
        Kind == u8 || Kind == i8 -> 2u64,
        Kind == u16 || Kind == i16 -> 3u64,
        Kind == u32 || Kind == i32 -> 5u64,
        _ -> 10u64
    }
}
public machine max_scalar_field<Kind>(bound: @mutable |wire|::ScalarBound, field: @|reflect|::FieldInfo)
requires Kind == u8 || Kind == u16 || Kind == u32 || Kind == u64 || Kind == bool
    || Kind == i8 || Kind == i16 || Kind == i32 || Kind == i64
{
    let tag: u64 = compact_word_width(field.stable_number);
    let value: u64 = compact_scalar_width::<Kind>();
    transition bound.valid && field.has_stable_number && !field.is_erased
        && tag <= 18446744073709551615u64 - bound.bytes {
        true -> tag_size(bound, tag, value),
        false -> invalid(bound)
    }
    machine tag_size(bound: @mutable |wire|::ScalarBound, tag: u64, value: u64)
    requires tag <= 18446744073709551615u64 - bound.bytes
    {
        let header: u64 = bound.bytes + tag;
        transition value <= 18446744073709551615u64 - header {
            true -> commit(bound, header, value),
            false -> invalid(bound)
        }
    }
    machine commit(bound: @mutable |wire|::ScalarBound, header: u64, value: u64)
    requires value <= 18446744073709551615u64 - header
    { bound.bytes = header + value; }
    machine invalid(bound: @mutable |wire|::ScalarBound) { bound.valid = false; }
}

// A payload plan describes a bounded wire region. Its contents establish no
// semantic type: the explicitly supplied owner constructor selects recursive
// decoding, packed values, text validation, or a raw input-buffer view.
public machine plan_payload<Kind>(context: @mutable |wire|::ScalarPlanContext, field: @|reflect|::FieldInfo) {
    let slot: |wire|::ScalarSlot = |wire|::ScalarSlot {
        number: field.stable_number, is_signed: false, is_payload: true,
        start: 0u64, end: 0u64, minimum: 0i64, maximum: 0i64,
        unsigned_maximum: 0u64, signed: 0i64, unsigned: 0u64
    };
    transition context.valid && context.count < context.slots.length
        && field.has_stable_number && !field.is_erased {
        true -> append(context, slot),
        false -> invalid(context)
    }
    machine append(context: @mutable |wire|::ScalarPlanContext, slot: |wire|::ScalarSlot)
    requires context.count < context.slots.length
    {
        context.slots[context.count] = slot;
        context.count = context.count + 1u64;
    }
    machine invalid(context: @mutable |wire|::ScalarPlanContext) { context.valid = false; }
}
// Parsing into explicit caller storage neither constructs T nor trusts a
// descriptive region. The owner supplies the exact bounded payload view.
public machine read_packed(bytes: @[u8], words: @mutable [u64], remaining_steps: u64) -> |wire|::PackedRead
requires remaining_steps > 0u64
{
    scan(bytes, words, 0u64, 0u64, remaining_steps)
    machine scan(bytes: @[u8], words: @mutable [u64], cursor: u64, count: u64, remaining_steps: u64) -> |wire|::PackedRead
    terminates by remaining_steps
    requires remaining_steps > 0u64
    {
        transition {
            cursor == bytes.length -> |wire|::PackedRead::Read { count: count },
            cursor < bytes.length && count < words.length && remaining_steps > 1u64 -> read(bytes, words, cursor, count, remaining_steps),
            _ -> |wire|::PackedRead::Invalid
        }
    }
    machine read(bytes: @[u8], words: @mutable [u64], cursor: u64, count: u64, remaining_steps: u64) -> |wire|::PackedRead
    requires count < words.length && remaining_steps > 1u64
    {
        transition read_unsigned(bytes, cursor) {
            |wire|::UnsignedRead::Read { value, next } -> check(bytes, words, cursor, count, remaining_steps, value, next),
            _ -> |wire|::PackedRead::Invalid
        }
    }
    machine check(bytes: @[u8], words: @mutable [u64], cursor: u64, count: u64, remaining_steps: u64, value: u64, next: u64) -> |wire|::PackedRead
    requires count < words.length && remaining_steps > 1u64
    {
        transition cursor < next && next <= bytes.length {
            true -> store(bytes, words, count, remaining_steps, value, next),
            false -> |wire|::PackedRead::Invalid
        }
    }
    machine store(bytes: @[u8], words: @mutable [u64], count: u64, remaining_steps: u64, value: u64, next: u64) -> |wire|::PackedRead
    requires count < words.length && remaining_steps > 1u64
    {
        words[count] = value;
        scan(bytes, words, next, count + 1u64, remaining_steps - 1u64)
    }
}

// Signed interpretation consumes an already validated unsigned wire word.
public machine signed_from_word(word: u64) -> i64 {
    let sign: u64 = ((0u64 as +Wrapping) - ((word & 1u64) as +Wrapping)) as -Wrapping;
    let bits: u64 = (word >> 1u64) ^ sign;
    |numeric_conversion|::narrow_u64_to_i64_wrapping(bits)
}

// Fixed-capacity sequences expose only their live prefix. Capacity is an
// ordinary generic extent, and an invalid live length fails closed.
public machine fixed_vec_field<Kind, Element, const N: u64>(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, value: @|fixed_vec|::FixedVec<Element, N>)
requires Kind == |fixed_vec|::FixedVec<Element, N>
    && (Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
        || Element == i8 || Element == i16 || Element == i32 || Element == i64)
{
    transition value.length <= value.items.length {
        true -> live(context, info, value),
        false -> invalid(context)
    }
    machine live(context: @mutable |wire|::EncodeContext, info: @|reflect|::FieldInfo, value: @|fixed_vec|::FixedVec<Element, N>)
    requires value.length <= value.items.length
        && (Element == u8 || Element == u16 || Element == u32 || Element == u64 || Element == bool
            || Element == i8 || Element == i16 || Element == i32 || Element == i64)
    { compact_packed_field::<Element>(context, info, @value.items[0u64..value.length]); }
    machine invalid(context: @mutable |wire|::EncodeContext) { context.valid = false; }
}
