// Core task-lifecycle vocabulary (task runtime TR2).
//
// `Task<T>` is the owned lifecycle CLAIM for one provider-held activation. It
// is deliberately not a stack, continuation frame, pool slot, or scheduler
// object. The runtime/provider layers establish values of this type; this core
// module only gives the claim a source home.
//
// The integer fields are the bootstrap carrier for provider and activation
// identity. They are not public proof that a provider accepted custody: TR4's
// boundary requirement and admission path own establishment of real claims.
public data Task<T> [linear] {
    provider: u64;
    activation: u64;
}

// Provider/lifecycle failures are ordinary affine records. Concrete providers
// may wrap richer diagnostics; the core outcomes keep the runtime boundary
// surface's payloads stable while provider admission is implemented.
public data TaskFailureReceipt {
    provider: u64;
    code: i32;
}

public data StartRejection {
    code: i32;
}

// These sums remain affine as nominal containers while their active payload
// carries any substituted linear debt. `Returned(LinearT)` and
// `Rejected(LinearArguments)` therefore participate in the same conditional
// permission accounting as a non-generic `Empty | Live(Token)` sum.
public data TaskOutcome<T> {
    case Cancelled;
    case Returned(value: T);
    case Failed(receipt: TaskFailureReceipt);
}

public data StartOutcome<T, Arguments> {
    case Started(task: Task<T>);
    case Rejected(arguments: Arguments, reason: StartRejection);
}

// Cancellation requests retain the linear claim. `finish` is the terminal
// operation: it may park while the provider reaches a lifecycle outcome and
// consumes the claim exactly once. The claim is an ordinary explicit argument
// of both rows.
public boundary trait TaskLifecycle {
    machine request_cancel<T>(task: @Task<T>) reaches none crashes Trap crashes Abort;

    machine finish<T>(task: Task<T>) -> TaskOutcome<T> reaches none suspends blocks crashes Trap crashes Abort;
}

// A start chooses the backing contract for this activation at compile time.
public data ActivationStorage [copy] {
    case Fixed;
    case Split;
}

// The selected worker accepts the job and returns its outcome. Its caller
// acknowledges the suspension and blocking permitted by this contract.
public data TaskWorker<Arguments, T> = machine(arguments: Arguments) -> T suspends blocks;

// Provider selection chooses the implementation. Activation admission must
// still establish caller authority, backing and execution custody.
public boundary trait TaskRuntime {
    machine start<T, Arguments, const Target: TaskWorker<Arguments, T>, const Plan: ActivationStorage>(
        arguments: Arguments
    ) -> Task<T>
    ensures true reaches none
    crashes Trap crashes Abort;

    machine try_start<T, Arguments, const Target: TaskWorker<Arguments, T>, const Plan: ActivationStorage>(
        arguments: Arguments
    ) -> StartOutcome<T, Arguments>
    ensures true reaches none
    crashes Trap crashes Abort;
}
