// Core task-lifecycle vocabulary (task runtime TR2).
//
// `Task<T>` is the owned lifecycle CLAIM for one provider-held activation. It
// is deliberately not a stack, continuation frame, pool slot, or scheduler
// object. The runtime/provider layers establish values of this type; this core
// module only gives the claim a source home.
//
// The integer fields are the bootstrap carrier for provider and activation
// identity. They are not public proof that a provider accepted custody: TR4's
// boundary requirement and admission path own establishment of real claims.
pub data Task<T> [linear] {
    provider: u64;
    activation: u64;
}

// Provider/lifecycle failures are ordinary affine records. Concrete providers
// may wrap richer diagnostics; the core outcomes keep the runtime boundary
// surface's payloads stable while provider admission is implemented.
pub data TaskFailureReceipt {
    provider: u64;
    code: i32;
}

data StartRejection {
    code: i32;
}

// These sums remain affine as nominal containers while their active payload
// carries any substituted linear debt. `Returned(LinearT)` and
// `Rejected(LinearArguments)` therefore participate in the same conditional
// permission accounting as a non-generic `Empty | Live(Token)` sum.
pub data TaskOutcome<T> {
    case Cancelled;
    case Returned(value: T);
    case Failed(receipt: TaskFailureReceipt);
}

data StartOutcome<T, Arguments> {
    case Started(task: Task<T>);
    case Rejected(arguments: Arguments, reason: StartRejection);
}

// Cancellation requests retain the linear claim. `finish` is the terminal
// operation: it may park while the provider reaches a lifecycle outcome and
// consumes the claim exactly once.
pub boundary requirement Task::request_cancel<T>(&self);

pub boundary requirement Task::finish<T>(self) -> TaskOutcome<T>
suspends; blocks;

// Runtime authority is an ordinary selected boundary capability. These
// generic boundary requirements give
// `start<M>` a nominal, machine-contract-checked surface for activation-plan
// elaboration; provider admission/dispatch remains the next runtime layer.
boundary trait TaskRuntime {
    machine start<T, Arguments, machine Target>(
        &self,
        arguments: Arguments
    ) -> Task<T>
    where machine Target(arguments: Arguments) -> T suspends; blocks;
    ensures true;

    machine try_start<T, Arguments, machine Target>(
        &self,
        arguments: Arguments
    ) -> StartOutcome<T, Arguments>
    where machine Target(arguments: Arguments) -> T suspends; blocks;
    ensures true;
}
