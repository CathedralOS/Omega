module core::float;

// Ordinary IEEE format and representation operations. Reads through checked
// scalar views preserve presented bits; classification never performs float
// arithmetic. Explicit quieting/canonicalization do not change arithmetic NaN
// guarantees. The static carrier equations admit only unqualified f32/f64.

public data Sign [copy] {
    case Positive;
    case Negative;
}
public data NaNKind [copy] {
    case Quiet;
    case Signaling;
}
public data Classification<Payload [copy]> [copy] {
    case Zero(sign: Sign);
    case Subnormal(sign: Sign);
    case Normal(sign: Sign);
    case Infinity(sign: Sign);
    case NaN(sign: Sign, kind: NaNKind, payload: Payload);
}

public machine from_bits(bits: u32) -> f32
ensures to_bits(result) == bits
{
    let view: &f32 = &bits as &f32;
    let value: f32 = view;
    value
}
public machine from_bits(bits: u64) -> f64
ensures to_bits(result) == bits
{
    let view: &f64 = &bits as &f64;
    let value: f64 = view;
    value
}
public machine to_bits(value: f32) -> u32
{
    let view: &u32 = &value as &u32;
    let bits: u32 = view;
    bits
}
public machine to_bits(value: f64) -> u64
{
    let view: &u64 = &value as &u64;
    let bits: u64 = view;
    bits
}

public machine min<T>() -> T
requires T == f32 || T == f64
ensures (T == f32 && to_bits(result) == 0xFF7FFFFFu32) || (T == f64 && to_bits(result) == 0xFFEFFFFFFFFFFFFFu64)
{
    transition T == f32 {
        true -> from_bits(0xFF7FFFFFu32)
        _ -> from_bits(0xFFEFFFFFFFFFFFFFu64)
    }
}

public machine max<T>() -> T
requires T == f32 || T == f64
ensures (T == f32 && to_bits(result) == 0x7F7FFFFFu32) || (T == f64 && to_bits(result) == 0x7FEFFFFFFFFFFFFFu64)
{
    transition T == f32 {
        true -> from_bits(0x7F7FFFFFu32)
        _ -> from_bits(0x7FEFFFFFFFFFFFFFu64)
    }
}

public machine min_positive_normal<T>() -> T
requires T == f32 || T == f64
ensures (T == f32 && to_bits(result) == 0x00800000u32) || (T == f64 && to_bits(result) == 0x0010000000000000u64)
{
    transition T == f32 {
        true -> from_bits(0x00800000u32)
        _ -> from_bits(0x0010000000000000u64)
    }
}

public machine min_positive_subnormal<T>() -> T
requires T == f32 || T == f64
ensures (T == f32 && to_bits(result) == 0x00000001u32) || (T == f64 && to_bits(result) == 0x0000000000000001u64)
{
    transition T == f32 {
        true -> from_bits(0x00000001u32)
        _ -> from_bits(0x0000000000000001u64)
    }
}

public machine max_subnormal<T>() -> T
requires T == f32 || T == f64
ensures (T == f32 && to_bits(result) == 0x007FFFFFu32) || (T == f64 && to_bits(result) == 0x000FFFFFFFFFFFFFu64)
{
    transition T == f32 {
        true -> from_bits(0x007FFFFFu32)
        _ -> from_bits(0x000FFFFFFFFFFFFFu64)
    }
}

public machine epsilon<T>() -> T
requires T == f32 || T == f64
ensures (T == f32 && to_bits(result) == 0x34000000u32) || (T == f64 && to_bits(result) == 0x3CB0000000000000u64)
{
    transition T == f32 {
        true -> from_bits(0x34000000u32)
        _ -> from_bits(0x3CB0000000000000u64)
    }
}

public machine infinity<T>() -> T
requires T == f32 || T == f64
ensures (T == f32 && to_bits(result) == 0x7F800000u32) || (T == f64 && to_bits(result) == 0x7FF0000000000000u64)
{
    transition T == f32 {
        true -> from_bits(0x7F800000u32)
        _ -> from_bits(0x7FF0000000000000u64)
    }
}

public machine negative_infinity<T>() -> T
requires T == f32 || T == f64
ensures (T == f32 && to_bits(result) == 0xFF800000u32) || (T == f64 && to_bits(result) == 0xFFF0000000000000u64)
{
    transition T == f32 {
        true -> from_bits(0xFF800000u32)
        _ -> from_bits(0xFFF0000000000000u64)
    }
}

public machine quiet_nan<T>() -> T
requires T == f32 || T == f64
ensures (T == f32 && to_bits(result) == 0x7FC00000u32) || (T == f64 && to_bits(result) == 0x7FF8000000000000u64)
{
    transition T == f32 {
        true -> from_bits(0x7FC00000u32)
        _ -> from_bits(0x7FF8000000000000u64)
    }
}

public machine radix<T>() -> u64
requires T == f32 || T == f64
ensures (T == f32 && result == 2u64) || (T == f64 && result == 2u64)
{
    transition T == f32 { true -> (2u64) _ -> (2u64) }
}

public machine precision_bits<T>() -> u64
requires T == f32 || T == f64
ensures (T == f32 && result == 24u64) || (T == f64 && result == 53u64)
{
    transition T == f32 { true -> (24u64) _ -> (53u64) }
}

public machine fraction_bits<T>() -> u64
requires T == f32 || T == f64
ensures (T == f32 && result == 23u64) || (T == f64 && result == 52u64)
{
    transition T == f32 { true -> (23u64) _ -> (52u64) }
}

public machine exponent_bits<T>() -> u64
requires T == f32 || T == f64
ensures (T == f32 && result == 8u64) || (T == f64 && result == 11u64)
{
    transition T == f32 { true -> (8u64) _ -> (11u64) }
}

public machine min_normal_exponent<T>() -> i64
requires T == f32 || T == f64
ensures (T == f32 && result == -126i64) || (T == f64 && result == -1022i64)
{
    transition T == f32 { true -> (-126i64) _ -> (-1022i64) }
}

public machine max_normal_exponent<T>() -> i64
requires T == f32 || T == f64
ensures (T == f32 && result == 127i64) || (T == f64 && result == 1023i64)
{
    transition T == f32 { true -> (127i64) _ -> (1023i64) }
}

public machine min_subnormal_exponent<T>() -> i64
requires T == f32 || T == f64
ensures (T == f32 && result == -149i64) || (T == f64 && result == -1074i64)
{
    transition T == f32 { true -> (-149i64) _ -> (-1074i64) }
}

public machine decimal_digits<T>() -> u64
requires T == f32 || T == f64
ensures (T == f32 && result == 6u64) || (T == f64 && result == 15u64)
{
    transition T == f32 { true -> (6u64) _ -> (15u64) }
}

public machine roundtrip_decimal_digits<T>() -> u64
requires T == f32 || T == f64
ensures (T == f32 && result == 9u64) || (T == f64 && result == 17u64)
{
    transition T == f32 { true -> (9u64) _ -> (17u64) }
}

public machine sign<T>(value: f32) -> Sign
requires T == f32
{ match (to_bits(value) & 0x8000_0000u32) != 0u32 { true -> Sign::Negative {}, false -> Sign::Positive {} } }

public machine is_nan<T>(value: f32) -> bool
requires T == f32
ensures result == (value != value)
{ value != value }

public machine is_finite<T>(value: f32) -> bool
requires T == f32
ensures result == (value > negative_infinity<T>() && value < infinity<T>())
{ value > negative_infinity<T>() && value < infinity<T>() }

public machine is_signaling_nan<T>(value: f32) -> bool
requires T == f32
ensures result == (is_nan<T>(value) && (to_bits(value) & 0x0040_0000u32) == 0u32)
{ is_nan<T>(value) && (to_bits(value) & 0x0040_0000u32) == 0u32 }

public machine classify<T>(value: f32) -> Classification<u32>
requires T == f32
{
    let bits: u32 = to_bits(value);
    let value_sign: Sign = sign<T>(value);
    let exponent: u32 = bits & 0x7F80_0000u32;
    let fraction: u32 = bits & 0x007F_FFFFu32;
    let kind: NaNKind = match (fraction & 0x0040_0000u32) == 0u32 {
        true -> NaNKind::Signaling {},
        false -> NaNKind::Quiet {}
    };
    transition {
        exponent == 0u32 && fraction == 0u32 -> (Classification::Zero { sign: value_sign })
        exponent == 0u32 -> (Classification::Subnormal { sign: value_sign })
        exponent != 0x7F80_0000u32 -> (Classification::Normal { sign: value_sign })
        fraction == 0u32 -> (Classification::Infinity { sign: value_sign })
        _ -> (Classification::NaN { sign: value_sign, kind: kind, payload: fraction & 0x003F_FFFFu32 })
    }
}

public machine quiet_nan<T>(value_sign: Sign, payload: u32) -> f32
requires T == f32
requires payload <= 0x003F_FFFFu32
ensures to_bits(result) == ((match value_sign { Sign::Positive -> 0u32, Sign::Negative -> 0x8000_0000u32 }) | 0x7F80_0000u32 | 0x0040_0000u32 | payload)
{
    let sign_bits: u32 = match value_sign { Sign::Positive -> 0u32, Sign::Negative -> 0x8000_0000u32 };
    from_bits(sign_bits | 0x7F80_0000u32 | 0x0040_0000u32 | payload)
}

public machine signaling_nan<T>(value_sign: Sign, payload: u32) -> f32
requires T == f32
requires payload <= 0x003F_FFFFu32 && payload != 0u32
ensures to_bits(result) == ((match value_sign { Sign::Positive -> 0u32, Sign::Negative -> 0x8000_0000u32 }) | 0x7F80_0000u32 | 0u32 | payload)
{
    let sign_bits: u32 = match value_sign { Sign::Positive -> 0u32, Sign::Negative -> 0x8000_0000u32 };
    from_bits(sign_bits | 0x7F80_0000u32 | 0u32 | payload)
}

public machine quiet<T>(value: f32) -> f32
requires T == f32
{
    transition is_nan<T>(value) {
        true -> from_bits(to_bits(value) | 0x0040_0000u32)
        _ -> (value)
    }
}
public machine canonicalize_nan<T>(value: f32) -> f32
requires T == f32
{
    transition value != value {
        true -> quiet_nan<T>()
        _ -> (value)
    }
}

public machine sign<T>(value: f64) -> Sign
requires T == f64
{ match (to_bits(value) & 0x8000_0000_0000_0000u64) != 0u64 { true -> Sign::Negative {}, false -> Sign::Positive {} } }

public machine is_nan<T>(value: f64) -> bool
requires T == f64
ensures result == (value != value)
{ value != value }

public machine is_finite<T>(value: f64) -> bool
requires T == f64
ensures result == (value > negative_infinity<T>() && value < infinity<T>())
{ value > negative_infinity<T>() && value < infinity<T>() }

public machine is_signaling_nan<T>(value: f64) -> bool
requires T == f64
ensures result == (is_nan<T>(value) && (to_bits(value) & 0x0008_0000_0000_0000u64) == 0u64)
{ is_nan<T>(value) && (to_bits(value) & 0x0008_0000_0000_0000u64) == 0u64 }

public machine classify<T>(value: f64) -> Classification<u64>
requires T == f64
{
    let bits: u64 = to_bits(value);
    let value_sign: Sign = sign<T>(value);
    let exponent: u64 = bits & 0x7FF0_0000_0000_0000u64;
    let fraction: u64 = bits & 0x000F_FFFF_FFFF_FFFFu64;
    let kind: NaNKind = match (fraction & 0x0008_0000_0000_0000u64) == 0u64 {
        true -> NaNKind::Signaling {},
        false -> NaNKind::Quiet {}
    };
    transition {
        exponent == 0u64 && fraction == 0u64 -> (Classification::Zero { sign: value_sign })
        exponent == 0u64 -> (Classification::Subnormal { sign: value_sign })
        exponent != 0x7FF0_0000_0000_0000u64 -> (Classification::Normal { sign: value_sign })
        fraction == 0u64 -> (Classification::Infinity { sign: value_sign })
        _ -> (Classification::NaN { sign: value_sign, kind: kind, payload: fraction & 0x0007_FFFF_FFFF_FFFFu64 })
    }
}

public machine quiet_nan<T>(value_sign: Sign, payload: u64) -> f64
requires T == f64
requires payload <= 0x0007_FFFF_FFFF_FFFFu64
ensures to_bits(result) == ((match value_sign { Sign::Positive -> 0u64, Sign::Negative -> 0x8000_0000_0000_0000u64 }) | 0x7FF0_0000_0000_0000u64 | 0x0008_0000_0000_0000u64 | payload)
{
    let sign_bits: u64 = match value_sign { Sign::Positive -> 0u64, Sign::Negative -> 0x8000_0000_0000_0000u64 };
    from_bits(sign_bits | 0x7FF0_0000_0000_0000u64 | 0x0008_0000_0000_0000u64 | payload)
}

public machine signaling_nan<T>(value_sign: Sign, payload: u64) -> f64
requires T == f64
requires payload <= 0x0007_FFFF_FFFF_FFFFu64 && payload != 0u64
ensures to_bits(result) == ((match value_sign { Sign::Positive -> 0u64, Sign::Negative -> 0x8000_0000_0000_0000u64 }) | 0x7FF0_0000_0000_0000u64 | 0u64 | payload)
{
    let sign_bits: u64 = match value_sign { Sign::Positive -> 0u64, Sign::Negative -> 0x8000_0000_0000_0000u64 };
    from_bits(sign_bits | 0x7FF0_0000_0000_0000u64 | 0u64 | payload)
}

public machine quiet<T>(value: f64) -> f64
requires T == f64
{
    transition is_nan<T>(value) {
        true -> from_bits(to_bits(value) | 0x0008_0000_0000_0000u64)
        _ -> (value)
    }
}
public machine canonicalize_nan<T>(value: f64) -> f64
requires T == f64
{
    transition value != value {
        true -> quiet_nan<T>()
        _ -> (value)
    }
}
