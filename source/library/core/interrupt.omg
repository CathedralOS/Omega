// Core interrupt obligations (IDT3).
//
// Masking and acknowledgement are distinct authority/debt relationships.
// A mask guard remembers the provider's exact prior mask state; restoring it
// consumes the guard, so nested save/restore composes without an unsafe
// unconditional `enable` operation. An acknowledgement is minted by an inbound
// interrupt provider and must be completed exactly once.
//
// Both obligations are public opaque linear data. Their runtime identities are
// owned by the selected provider and are not source-level representation.
// Active guards use an exact routed result; acknowledgement entry occurrence
// evidence is bound at runtime. Pending names one stable core-owned entry
// requirement through `established by`; installation makes its matching
// parameter inbound. No package can reconstruct either obligation from fields.

use omega::language::core::assembly;

pub boundary data InterruptMaskGuard [linear];
pub boundary data InterruptAcknowledgement [linear];

pub domain InterruptMaskGuard::Active
established by InterruptMaskControl::save_and_mask;

// The capability that may change the current activation's interrupt mask.
// Saving returns the only authority that can restore that exact prior state.
pub boundary trait InterruptMaskControl {
    machine save_and_mask(&mut self) -> InterruptMaskGuard in Active
    reaches MachineControl
    ensures
        result in InterruptMaskGuard::Active;
}

// One stable semantic requirement owns inbound acknowledgement establishment.
// Platform interrupt roots inherit this requirement. Installation—not an
// ordinary call—turns the exact non-self parameter route into an introduction.
// Entry and completion own distinct installation-selected reach rows beneath
// the same conservative hardware-access ceiling. Installation resolves this
// entry row to the selected provider's exact reach; provider/token lineage,
// never equality of the two rows, binds completion to the same execution.
pub domain InterruptAcknowledgement::Pending
established by InterruptEntry::enter;

pub boundary trait InterruptEntry {
    machine enter(acknowledgement: InterruptAcknowledgement in Pending)
    reaches <= MachineControl + PortIo;
}

boundary machine InterruptMaskGuard::restore(self)
reaches MachineControl
requires
    self in InterruptMaskGuard::Active
ensures true;

boundary machine InterruptAcknowledgement::complete(self)
reaches PortIo
requires
    self in InterruptAcknowledgement::Pending
ensures true;
