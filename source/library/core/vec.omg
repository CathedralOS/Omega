// Core Vec surface.
//
// Vec is the eventual arena-backed owner for contiguous storage. It owns an
// allocation with a fixed capacity (`capacity`, always >= `len`) and is the
// owned counterpart to the borrowed `Slice` view: `Vec::as_slice` lends the
// elements as a `&[T]` window without giving up ownership.
//
// This module is the source-visible SURFACE: the length/capacity measures and
// the push / as_slice / as_mut_slice requirement contracts with
// their `requires`/`ensures`, including byte vectors refined by text domains
// and how `Slice`/`Array` surface their length and view contracts. The actual
// runtime storage mechanics are OUT OF SCOPE here; only the proof-facing
// contracts and provider-agnostic boundary requirements live in this layer.
// The concrete u32 construction path lives in `alloc::vec`: a runtime-sized
// owner of caller-supplied qualified extents that returns every buffer
// explicitly. It is not this generic proof-facing carrier. An allocator's
// temporary loan ends when it issues an extent; the vector owns that extent,
// rather than borrowing the allocator for its lifetime.

// Source-visible owned vector type. The compiler/runtime own its concrete
// buffer descriptor; core exposes the nominal type so user code, contracts, and
// IDEs can name `Vec<T>` instead of treating it as unreachable magic.
data Vec<T> {
}

// Call surface used by borrow/lifetime analysis. Runtime lowering may still
// choose the `VecAccess` requirement below; this state-shaped declaration
// lets `Vec::push(items, value)` participate in ordinary mutation checks. The
// parameter is named as the `VecAccess` requirements below name it, so the
// two spellings of one operation agree.
machine Vec::as_slice<T>(items: &Vec<T>) -> &[T] {
}

machine Vec::push<T>(items: &mut Vec<T>, value: T) {
}

// The vector's runtime boundary operations. One runtime realization supplies
// every row, so they share one boundary trait; the vector is an ordinary
// explicit argument.
boundary trait VecAccess {
    // Length in elements. Cheap O(1) measure used by `requires`/`ensures`.
    machine Length<T>(items: &Vec<T>) -> u64 reaches none crashes none;

    // Capacity in elements; always at least the current length. Cheap O(1)
    // measure.
    machine Capacity<T>(items: &Vec<T>) -> u64
    reaches none
    ensures
        result >= items.len
    crashes none;

    machine index<T>(items: &Vec<T>, index: u64) -> T
    reaches none
    requires
        index < items.len
    crashes none;

    machine index_mut<T>(items: &mut Vec<T>, index: u64) -> &mut T
    reaches none
    requires
        index < items.len
    crashes none;

    // Borrow the elements as a slice view; the view length matches the
    // vector.
    machine as_slice<T>(items: &Vec<T>) -> &[T]
    reaches none
    ensures
        result.len == items.len
    crashes none;

    machine as_mut_slice<T>(items: &mut Vec<T>) -> &mut [T]
    reaches none
    ensures
        result.len == items.len
    crashes none;

    // Append a value using already-owned capacity. Reallocation is never
    // ambient; a future growing owner must use an explicit allocator
    // package/capability.
    machine push<T>(items: &mut Vec<T>, value: T)
    reaches none
    requires
        items.len < items.capacity
    crashes none;

    // Infallible under its proof obligation, matching
    // `FixedVecAccess::pop`. A future dynamic-failure `try_pop` may return
    // `Optional<T>` from std.
    machine pop<T>(items: &mut Vec<T>) -> T
    reaches none
    requires
        items.len > 0
    crashes none;
}
