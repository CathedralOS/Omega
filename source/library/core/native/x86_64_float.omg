boundary machine from_f32_to_i8_exact(value: f32) -> i8
    satisfies I8FromF32::from_f32
reaches
requires
    value == value && value > -129.0f32 && value < 128.0f32
ensures
    result == FloatSemantics::to_i8(Float::meaning32(value));

boundary machine from_f32_to_i8_trapping(value: f32) -> i8 in Trapping
    satisfies I8FromF32::from_f32
reaches
ensures
    result == FloatSemantics::to_i8(Float::meaning32(value))
crashes Trap
    value != value || value <= -129.0f32 || value >= 128.0f32;

boundary machine from_f32_to_i8_saturating(value: f32) -> i8 in Saturating
    satisfies I8FromF32::from_f32
reaches
ensures
    result == FloatSemantics::to_i8_saturating(Float::meaning32(value));

