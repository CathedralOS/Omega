module core::native::x86_64_float;

use omega::language::core::float_operations;

// Exact immutable Toolchain catalogue leaves. Catalogue membership authenticates
// numeric meaning and ISA availability; the Core Build owns provider choice.

boundary machine add32(left: f32, right: f32) -> f32
    satisfies FloatAdd::add
reaches
ensures
    Float::meaning32(result) == FloatSemantics::add(
        FloatFormat::BINARY32,
        Float::meaning32(left),
        Float::meaning32(right)
    );

boundary machine add64(left: f64, right: f64) -> f64
    satisfies FloatAdd::add
reaches
ensures
    Float::meaning64(result) == FloatSemantics::add(
        FloatFormat::BINARY64,
        Float::meaning64(left),
        Float::meaning64(right)
    );

