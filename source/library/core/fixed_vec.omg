// We store a fixed-capacity vector as an inline array `[T; N]` and a `u64`
// length. The array moves with the value and needs no allocator. Capacity
// is part of the type, so a caller proves spare room before calling `push`.
// A growable vector uses a separate allocation contract.
//
// The boundary trait below declares the generic operations. The historical
// `runtime_fixed_vec_round_trip_exit` fixture at 71f9c8fe859 exercised
// concrete implementations for `i32` with capacity four.
//
// Contract vocabulary notes (why the obligations are spelled as they are):
//
//   * `push` requires provable spare room (`length < items.length`, where
//     `items.length` folds to the static `N` at concrete instantiations).
//   * `pop` requires a provably non-empty vector. In the concrete machine
//     pattern it additionally spells the predecessor-index bound
//     (`length - 1 < items.length`): with `length <= N` as a maintained data
//     invariant that bound would be derivable from `length > 0`, but stage 1
//     has no data-invariant vocabulary, so the obligation surfaces at the
//     boundary and is discharged by `push`'s guarantees.
//   * `get` requires the index be within the LIVE length, not merely within
//     capacity.
//   * `as_slice` lends the first `length` elements — the view length is the
//     vector length, not the capacity — so it carries the window obligation
//     `length <= items.length`.

public data FixedVec<T, const N: u64> {
    items: [T; N];
    length: u64;
}

// Each operation takes the vector explicitly and states the facts the caller
// must establish at the call site.
boundary trait FixedVecAccess {
    // Length in LIVE elements (`length`, not the static capacity `N`).
    // Cheap O(1) measure for `requires`/`ensures`.
    machine Length<T, const N: u64>(items: @FixedVec<T, N>) -> u64 reaches none crashes none;

    // Append a value. Requires provable spare room — there is no growth
    // path and no trap; a call without a discharged capacity fact is a
    // compile error.
    machine push<T, const N: u64>(items: @mutable FixedVec<T, N>, value: T)
    reaches none
    requires
        items.length < items.items.length
    crashes none;

    // Remove and return the last element of a provably non-empty vector. The
    // zero-case is a proof failure at the call site, not a runtime Option:
    // stage 1 is an obligation, not a fallback — a
    // `try_pop -> Optional<T>` belongs to the dynamic-failure stage-2
    // vocabulary.
    machine pop<T, const N: u64>(items: @mutable FixedVec<T, N>) -> T
    reaches none
    requires
        items.length > 0
    crashes none;

    // Read the element at `index`, which must be provably within the live
    // length.
    machine get<T, const N: u64>(items: @FixedVec<T, N>, index: u64) -> T
    reaches none
    requires
        index < items.length
    crashes none;

    // Borrow the LIVE elements as a slice view; the view length matches the
    // vector length, not the capacity.
    machine as_slice<T, const N: u64>(items: @FixedVec<T, N>) -> @[T]
    reaches none
    requires
        items.length <= items.items.length
    ensures
        result.length == items.length
    crashes none;
}
