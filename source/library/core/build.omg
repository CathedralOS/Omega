// Configure the bundled providers on this activation's original Build value.
// Target keys are ordinary data. Public requirement identities stay unchanged.
machine build(builder: &mut Build) {
    Build::package(builder, "omega_float_defaults");
    configure_float_defaults(builder, windows_x86_64);
    configure_float_defaults(builder, linux_x86_64);
    configure_float_defaults(builder, macos_arm64);
    configure_float_defaults(builder, macos_x86_64);
    configure_float_defaults(builder, linux_arm64);
    configure_directed_fma_defaults(builder, macos_arm64);
    configure_directed_fma_defaults(builder, linux_arm64);
}

machine configure_float_defaults(builder: &mut Build, target: BuildTarget) {
    Build::select_provider<Float::add, NativeFloats>(builder, target);
    Build::select_provider<Float::subtract, NativeFloats>(builder, target);
    Build::select_provider<Float::multiply, NativeFloats>(builder, target);
    Build::select_provider<Float::divide, NativeFloats>(builder, target);
    Build::select_provider<Float::equal, NativeFloats>(builder, target);
    Build::select_provider<Float::not_equal, NativeFloats>(builder, target);
    Build::select_provider<Float::less, NativeFloats>(builder, target);
    Build::select_provider<Float::less_or_equal, NativeFloats>(builder, target);
    Build::select_provider<Float::greater, NativeFloats>(builder, target);
    Build::select_provider<Float::greater_or_equal, NativeFloats>(builder, target);
    Build::select_provider<F32::negate, NativeFloats>(builder, target);
    Build::select_provider<F64::negate, NativeFloats>(builder, target);
    Build::select_provider<F32::multiply_then_add, NativeFloats>(builder, target);
    Build::select_provider<F64::multiply_then_add, NativeFloats>(builder, target);
    Build::select_provider<F32::fused_multiply_add, NativeFloats>(builder, target);
    Build::select_provider<F64::fused_multiply_add, NativeFloats>(builder, target);
    Build::select_provider<F32::square_root, NativeFloats>(builder, target);
    Build::select_provider<F64::square_root, NativeFloats>(builder, target);
    Build::select_provider<F32::minimum, NativeFloats>(builder, target);
    Build::select_provider<F64::minimum, NativeFloats>(builder, target);
    Build::select_provider<F32::maximum, NativeFloats>(builder, target);
    Build::select_provider<F64::maximum, NativeFloats>(builder, target);
    Build::select_provider<F32::from_f64, NativeFloats>(builder, target);
    Build::select_provider<F64::from_f32, NativeFloats>(builder, target);
    Build::select_provider<F32::from_i8, NativeFloats>(builder, target);
    Build::select_provider<F32::from_i16, NativeFloats>(builder, target);
    Build::select_provider<F32::from_i32, NativeFloats>(builder, target);
    Build::select_provider<F32::from_i64, NativeFloats>(builder, target);
    Build::select_provider<F32::from_u8, NativeFloats>(builder, target);
    Build::select_provider<F32::from_u16, NativeFloats>(builder, target);
    Build::select_provider<F32::from_u32, NativeFloats>(builder, target);
    Build::select_provider<F32::from_u64, NativeFloats>(builder, target);
    Build::select_provider<F64::from_i8, NativeFloats>(builder, target);
    Build::select_provider<F64::from_i16, NativeFloats>(builder, target);
    Build::select_provider<F64::from_i32, NativeFloats>(builder, target);
    Build::select_provider<F64::from_i64, NativeFloats>(builder, target);
    Build::select_provider<F64::from_u8, NativeFloats>(builder, target);
    Build::select_provider<F64::from_u16, NativeFloats>(builder, target);
    Build::select_provider<F64::from_u32, NativeFloats>(builder, target);
    Build::select_provider<F64::from_u64, NativeFloats>(builder, target);
    Build::select_provider<I8::from_f32, NativeFloats>(builder, target);
    Build::select_provider<I8::from_f64, NativeFloats>(builder, target);
    Build::select_provider<I16::from_f32, NativeFloats>(builder, target);
    Build::select_provider<I16::from_f64, NativeFloats>(builder, target);
    Build::select_provider<I32::from_f32, NativeFloats>(builder, target);
    Build::select_provider<I32::from_f64, NativeFloats>(builder, target);
    Build::select_provider<I64::from_f32, NativeFloats>(builder, target);
    Build::select_provider<I64::from_f64, NativeFloats>(builder, target);
    Build::select_provider<U8::from_f32, NativeFloats>(builder, target);
    Build::select_provider<U8::from_f64, NativeFloats>(builder, target);
    Build::select_provider<U16::from_f32, NativeFloats>(builder, target);
    Build::select_provider<U16::from_f64, NativeFloats>(builder, target);
    Build::select_provider<U32::from_f32, NativeFloats>(builder, target);
    Build::select_provider<U32::from_f64, NativeFloats>(builder, target);
    Build::select_provider<U64::from_f32, NativeFloats>(builder, target);
    Build::select_provider<U64::from_f64, NativeFloats>(builder, target);
    Build::select_provider<F32::classify, NativeFloats>(builder, target);
    Build::select_provider<F64::classify, NativeFloats>(builder, target);
    Build::select_provider<F32::is_finite, NativeFloats>(builder, target);
    Build::select_provider<F64::is_finite, NativeFloats>(builder, target);
    Build::select_provider<F32::is_nan, NativeFloats>(builder, target);
    Build::select_provider<F64::is_nan, NativeFloats>(builder, target);
    Build::select_provider<F32::is_infinite, NativeFloats>(builder, target);
    Build::select_provider<F64::is_infinite, NativeFloats>(builder, target);
    Build::select_provider<F32::is_normal, NativeFloats>(builder, target);
    Build::select_provider<F64::is_normal, NativeFloats>(builder, target);
    Build::select_provider<F32::is_subnormal, NativeFloats>(builder, target);
    Build::select_provider<F64::is_subnormal, NativeFloats>(builder, target);
    Build::select_provider<F32::add_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F64::add_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F32::add_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F64::add_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F32::add_toward_negative, NativeFloats>(builder, target);
    Build::select_provider<F64::add_toward_negative, NativeFloats>(builder, target);
    Build::select_provider<F32::subtract_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F64::subtract_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F32::subtract_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F64::subtract_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F32::subtract_toward_negative, NativeFloats>(builder, target);
    Build::select_provider<F64::subtract_toward_negative, NativeFloats>(builder, target);
    Build::select_provider<F32::multiply_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F64::multiply_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F32::multiply_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F64::multiply_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F32::multiply_toward_negative, NativeFloats>(builder, target);
    Build::select_provider<F64::multiply_toward_negative, NativeFloats>(builder, target);
    Build::select_provider<F32::divide_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F64::divide_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F32::divide_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F64::divide_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F32::divide_toward_negative, NativeFloats>(builder, target);
    Build::select_provider<F64::divide_toward_negative, NativeFloats>(builder, target);
    Build::select_provider<F32::square_root_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F64::square_root_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F32::square_root_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F64::square_root_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F32::square_root_toward_negative, NativeFloats>(builder, target);
    Build::select_provider<F64::square_root_toward_negative, NativeFloats>(builder, target);
}

machine configure_directed_fma_defaults(builder: &mut Build, target: BuildTarget) {
    Build::select_provider<F32::fused_multiply_add_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F64::fused_multiply_add_toward_zero, NativeFloats>(builder, target);
    Build::select_provider<F32::fused_multiply_add_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F64::fused_multiply_add_toward_positive, NativeFloats>(builder, target);
    Build::select_provider<F32::fused_multiply_add_toward_negative, NativeFloats>(builder, target);
    Build::select_provider<F64::fused_multiply_add_toward_negative, NativeFloats>(builder, target);
}
