// Binary64 kernels over contiguous slices: dot product, scaled Euclidean norm,
// and axpy (y = alpha*x + y). Products and left-to-right sums stay in binary64,
// with no fused multiply-add, compensated sum, widening, allocation or copying.
// Dot computes left[i]*right[i] then adds in increasing index order; axpy
// computes alpha*x[i] then adds y[i]; self-axpy uses alpha*old + old.
//
// false means unequal lengths or a nonfinite input, intermediate or result,
// and leaves the scalar output or every destination element unchanged. axpy
// validates every element before its write pass. Empty dot and norm, and a zero
// norm, publish +0.0; empty axpy succeeds for finite alpha and rejects for
// nonfinite alpha. The norm tracks a scale and a sum of squared ratios no
// greater than one; its final scale*sqrt(sum) can still overflow and rejects.
//
// Dot may share its inputs but its output must be disjoint; ordinary axpy
// needs disjoint x and an exclusive y loan, and x == y uses try_axpy_self_f64
// with one exclusive loan.
module linear_algebra;

use omega::language::core::F64::negate;
use omega::language::core::F64::square_root;
use omega::language::core::F64::maximum;

machine is_finite_f64(value: f64) -> bool {
    let difference: f64 = value - value;
    difference == 0.0
}

public machine try_dot_f64(left: &[f64], right: &[f64], output: &mut f64) -> bool {
    transition left.len == right.len {
        true -> step(left, right, output, 0, 0.0)
        _ -> (false)
    }
    machine step(left: &[f64], right: &[f64], output: &mut f64,
        index: u64 in Wrapping, total: f64) -> bool {
        transition index < left.len && index < right.len {
            true -> add(left, right, output, index, total)
            _ -> finish(output, total)
        }
    }
    machine add(left: &[f64], right: &[f64], output: &mut f64,
        index: u64 in Wrapping, total: f64) -> bool
    requires index < left.len && index < right.len {
        let product: f64 = left[index as u64] * right[index as u64];
        let next: f64 = total + product;
        let valid: bool = is_finite_f64(left[index as u64]) && is_finite_f64(right[index as u64])
            && is_finite_f64(product) && is_finite_f64(next);
        transition valid {
            true -> step(left, right, output, index + 1, next)
            _ -> (false)
        }
    }
    machine finish(output: &mut f64, total: f64) -> bool {
        output = total;
        true
    }
}

// LAPACK-style scale/ssq recurrence. No original element is squared:
// the ratio is at most one, so representable large/small norms survive.
// The final scale * sqrt(ssq) can still overflow; that is a try failure.
public machine try_scaled_norm_f64(values: &[f64], output: &mut f64) -> bool {
    transition { _ -> step(values, output, 0, 0.0, 1.0) }
    machine step(values: &[f64], output: &mut f64, index: u64 in Wrapping,
        scale: f64, squares: f64) -> bool {
        transition index < values.len {
            true -> inspect(values, output, index, scale, squares)
            _ -> finish(output, scale, squares)
        }
    }
    machine inspect(values: &[f64], output: &mut f64, index: u64 in Wrapping,
        scale: f64, squares: f64) -> bool
    requires index < values.len {
        let value: f64 = F64::maximum(values[index as u64], F64::negate(values[index as u64]));
        let valid: bool = is_finite_f64(values[index as u64]);
        transition valid {
            false -> (false)
            _ -> update(values, output, index, scale, squares, value)
        }
    }
    machine update(values: &[f64], output: &mut f64, index: u64 in Wrapping,
        scale: f64, squares: f64, value: f64) -> bool {
        transition {
            value == 0.0 -> step(values, output, index + 1, scale, squares)
            scale < value -> rescale(values, output, index, scale, squares, value)
            _ -> accumulate(values, output, index, scale, squares, value)
        }
    }
    machine rescale(values: &[f64], output: &mut f64, index: u64 in Wrapping,
        scale: f64, squares: f64, value: f64) -> bool {
        let ratio: f64 = scale / value;
        let next: f64 = 1.0 + squares * (ratio * ratio);
        transition { _ -> step(values, output, index + 1, value, next) }
    }
    machine accumulate(values: &[f64], output: &mut f64, index: u64 in Wrapping,
        scale: f64, squares: f64, value: f64) -> bool {
        let ratio: f64 = value / scale;
        let next: f64 = squares + ratio * ratio;
        transition { _ -> step(values, output, index + 1, scale, next) }
    }
    machine finish(output: &mut f64, scale: f64, squares: f64) -> bool {
        let result: f64 = scale * F64::square_root(squares);
        let valid: bool = is_finite_f64(result);
        transition valid {
            true -> publish(output, result)
            _ -> (false)
        }
    }
    machine publish(output: &mut f64, result: f64) -> bool {
        output = result;
        true
    }
}

// Two passes: validate every multiply then add before mutating any element.
// The input is shared and the output exclusive for the whole operation, so
// successful validation cannot be invalidated by another writer.
public machine try_axpy_f64(alpha: f64, input: &[f64], output: &mut [f64]) -> bool {
    let valid: bool = is_finite_f64(alpha) && input.len == output.len;
    transition valid {
        true -> validate(alpha, input, output, 0)
        _ -> (false)
    }
    machine validate(alpha: f64, input: &[f64], output: &mut [f64],
        index: u64 in Wrapping) -> bool {
        transition index < input.len && index < output.len {
            true -> inspect(alpha, input, output, index)
            _ -> write(alpha, input, output, 0)
        }
    }
    machine inspect(alpha: f64, input: &[f64], output: &mut [f64],
        index: u64 in Wrapping) -> bool
    requires index < input.len && index < output.len {
        let product: f64 = alpha * input[index as u64];
        let result: f64 = product + output[index as u64];
        let valid: bool = is_finite_f64(input[index as u64]) && is_finite_f64(output[index as u64])
            && is_finite_f64(product) && is_finite_f64(result);
        transition valid {
            true -> validate(alpha, input, output, index + 1)
            _ -> (false)
        }
    }
    machine write(alpha: f64, input: &[f64], output: &mut [f64],
        index: u64 in Wrapping) -> bool {
        transition index < input.len && index < output.len {
            true -> store(alpha, input, output, index)
            _ -> (true)
        }
    }
    machine store(alpha: f64, input: &[f64], output: &mut [f64],
        index: u64 in Wrapping) -> bool
    requires index < input.len && index < output.len {
        let product: f64 = alpha * input[index as u64];
        let result: f64 = product + output[index as u64];
        output[index as u64] = result;
        transition { _ -> write(alpha, input, output, index + 1) }
    }
}

// x == y is permitted only through this one-loan entrypoint. Evaluate
// alpha*old + old rather than (alpha+1)*old, preserving rounding order.
public machine try_axpy_self_f64(alpha: f64, values: &mut [f64]) -> bool {
    let valid: bool = is_finite_f64(alpha);
    transition valid {
        true -> validate(alpha, values, 0)
        _ -> (false)
    }
    machine validate(alpha: f64, values: &mut [f64], index: u64 in Wrapping) -> bool {
        transition index < values.len {
            true -> inspect(alpha, values, index)
            _ -> write(alpha, values, 0)
        }
    }
    machine inspect(alpha: f64, values: &mut [f64], index: u64 in Wrapping) -> bool
    requires index < values.len {
        let product: f64 = alpha * values[index as u64];
        let result: f64 = product + values[index as u64];
        let valid: bool = is_finite_f64(values[index as u64])
            && is_finite_f64(product) && is_finite_f64(result);
        transition valid {
            true -> validate(alpha, values, index + 1)
            _ -> (false)
        }
    }
    machine write(alpha: f64, values: &mut [f64], index: u64 in Wrapping) -> bool {
        transition index < values.len {
            true -> store(alpha, values, index)
            _ -> (true)
        }
    }
    machine store(alpha: f64, values: &mut [f64], index: u64 in Wrapping) -> bool
    requires index < values.len {
        let product: f64 = alpha * values[index as u64];
        let result: f64 = product + values[index as u64];
        values[index as u64] = result;
        transition { _ -> write(alpha, values, index + 1) }
    }
}
