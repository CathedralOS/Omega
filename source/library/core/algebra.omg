// Algebra traits pair total mathematical operations with checked identity laws.
// A CommutativeSemiring<T> conformance supplies each operation and proves each
// law for every operand admitted by the requirement's signature and premises.
//
// Commutativity and associativity allow the checker to reorder applications
// of the same selected operation. With those laws for addition and
// multiplication, plus distributivity, it can normalize bounded polynomials
// with natural coefficients. The license comes from the checked law structure
// and its bound operations; naming a law or using a familiar trait name does
// not supply evidence.
//
// Identity laws use the slot applications themselves. Carrier satisfiers may
// bridge those nullary applications to their constructor constants by ordinary
// compute-mode unfolding and explicit lemma citation; the checker has no
// compiler-known zero/one form.
//
// Law requirements are resultless theorem slots. Their parameters state the
// universally quantified operands; satisfiers prove the `ensures` without
// manufacturing a dummy carrier value.
public trait CommutativeSemiring<T> {
    // Algebra operations are total mathematical functions. Publishing that
    // promise is what permits a selected implementation to denote a value in
    // Prop; each satisfier still owes the ordinary termination proof.
    machine zero() -> T terminates;
    machine one() -> T terminates;
    machine add(a: T, b: T) -> T terminates;
    machine mul(a: T, b: T) -> T terminates;
    machine add_comm(a: T, b: T)
    ensures core::Identity<T>(add(a, b), add(b, a));
    machine add_assoc(a: T, b: T, c: T)
    ensures core::Identity<T>(add(add(a, b), c), add(a, add(b, c)));
    machine add_identity(a: T)
    ensures core::Identity<T>(add(a, zero()), a);
    machine mul_comm(a: T, b: T)
    ensures core::Identity<T>(mul(a, b), mul(b, a));
    machine mul_assoc(a: T, b: T, c: T)
    ensures core::Identity<T>(mul(mul(a, b), c), mul(a, mul(b, c)));
    machine mul_identity(a: T)
    ensures core::Identity<T>(mul(a, one()), a);
    machine mul_distributes(a: T, b: T, c: T)
    ensures core::Identity<T>(mul(a, add(b, c)), add(mul(a, b), mul(a, c)));
}
