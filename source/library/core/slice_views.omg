module core::slice_views;

machine element<T [copy]>(items: &[T], index: u64) -> T
requires index < items.len {
    items[index]
}

// Descriptor construction stays in its own module: this body does not import
// the public range requirement it realizes. The ordinary builtin range carries
// checked bounds and the source's backing loan into the returned view.
machine subslice<T>(items: &[T], start: u64, end: u64) -> &[T]
requires
    start <= end && end <= items.len
ensures
    result.len == end - start {
    &items[start..end]
}
