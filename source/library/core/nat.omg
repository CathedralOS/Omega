use {omega}/language/core/foundation.omg as proof;
use algebra.omg;

// Core natural-number ranking surface.
//
// `Nat::Descending` is the default well-founded ranking for unsigned natural
// values in termination proofs. It is an exact compiler primitive: a bare
// bodyless machine signature supplied by the closed ranking-view catalog
// because this sealed toolchain source declares it with exactly this path and
// shape, and the termination checker consults the declaration at this path
// rather than the spelling alone. Merely naming a declaration
// `Nat::Descending` elsewhere grants no primitive or ranking authority.
//
// Public surface:
// - plain `terminates by value` resolves here when the value has an unambiguous
//   natural-number ranking
// - `terminates by value -> |nat|::Nat::Descending` spells the ranking explicitly
// - custom numeric-like domains define their own named `measure` rankings
//   instead of pretending every ordering belongs directly to the data type

public machine Nat::Descending(value: u64) -> u64;

// The distance is zero at or beyond the limit.
public machine Nat::BoundedDistance(lower: u64, upper: u64) -> u64;

// The cursor approaches the same bound on every recursive transfer.
public machine Nat::IncreasingTo(cursor: u64, limit: u64) -> u64;

// The core algebraic conformance surface: Nat EARNS ring canonicalization
// (rearrange-mode) by conforming `CommutativeSemiring` machine-by-machine
// below -- ops via `satisfies |algebra|::CommutativeSemiring<Nat>::<op>`, laws via the lemma
// machines binding the law slots (each proof machine-checked against the
// declared law, forall-to-forall).

// Nat is ordinary recursive data, proof-only by the computed classification:
// recursive data has no layout, and every runtime consumption refuses with the
// classification named. The exact engine evaluates Nat facts, and a proof
// machine may induct over guarded unsigned `n - 1` while its recursive result
// and contract stay in this structural Nat world.
public data Nat {
    case Zero;
    case Succ(prev: Nat);
}

// Natural order and exact subtraction are free operator machines: each
// token-bound machine binds its operator and owns its body, with no separate
// `satisfies` provider pair. Both are public, so a program outside core may
// import them and select them by their `Nat` operands. `<=` is true exactly
// when `saturating_sub(left, right)` is zero. Subtraction is partial: its
// `requires` makes every `a - b` prove `b <= a` first. Its body is the same
// recursion as `saturating_sub`, which stays the separate clamping operation.
public machine <= less_or_equal(left: Nat, right: Nat) -> bool
{
    transition (saturating_sub(left, right)) {
        Nat::Zero -> true,
        Nat::Succ { prev } -> false
    }
}

public machine - subtract(left: Nat, right: Nat) -> Nat
requires
    right <= left
{
    transition { _ -> (saturating_sub(left, right)) }
}

// The Peano ring surface as ordinary
// PROOF MACHINES -- free machines over proof-only data (machine-stratum
// contagion), structurally recursive, every self-call descending by the
// arm-bound case-payload subterm. `mul` composes `add` by an ordinary
// cross-machine call (no cycle; only self-calls need the measure).
// The extraction lemmas (add_zero, add_succ, commutativity) are discharged
// by ensures extraction.
public machine add(a: Nat, b: Nat) -> Nat
satisfies |algebra|::CommutativeSemiring<Nat>::add
terminates by a
{
    transition a {
        Nat::Zero -> (b),
        Nat::Succ { prev } -> Nat::Succ { prev: add(prev, b) }
    }
}

public machine mul(a: Nat, b: Nat) -> Nat
satisfies |algebra|::CommutativeSemiring<Nat>::mul
terminates by a
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> (add(b, mul(prev, b)))
    }
}

// The semiring constants -- trivial one-transition machines (the settle's
// zero/one rule: no constructor-binding surface).
machine zero() -> Nat
satisfies |algebra|::CommutativeSemiring<Nat>::zero
{
    transition { _ -> Nat::Zero }
}

machine one() -> Nat
satisfies |algebra|::CommutativeSemiring<Nat>::one
{
    transition { _ -> Nat::Succ { prev: Nat::Zero } }
}

// Extraction lemmas: proven library lemmas -- the structural entailment
// judge discharges each ensures at
// compile time, so every program importing this module carries machine-
// checked Peano facts. add_zero_left unfolds add's Zero arm
// (compute-mode); add_zero_right is STRUCTURAL INDUCTION on `a` (its step
// arm cites the smaller theorem application and consumes that checked
// `ensures` as the inductive hypothesis, licensed by exact-edge descent).
machine add_zero_left(b: Nat) -> Nat
ensures
    |proof|::Identity::<Nat>(result, b)
{
    transition { _ -> (add(Nat::Zero, b)) }
}

// Right identity by resultless structural induction. The step-state citation
// is the induction edge: exact recursion checking proves `prev` descends from
// `a`, then the citation contributes `add(prev, Zero) == prev` to that arm.
// Consumers cite the theorem as a statement; it never computes a dummy Nat.
public machine add_zero_right(a: Nat)
satisfies |algebra|::CommutativeSemiring<Nat>::add_identity
terminates by a
ensures
    |proof|::Identity::<Nat>(add(a, Nat::Zero), a)
{
    transition a {
        Nat::Zero -> zero_case(),
        Nat::Succ { prev } -> succ_case(prev)
    }

    machine zero_case() {
    }

    machine succ_case(prev: Nat) {
        add_zero_right(prev);
    }
}

// add's one-step successor: add(a, Succ(Zero)) == Succ(a) -- structural
// induction on `a`, the add_zero_right pattern shifted by one (the Zero
// arm computes; each Succ arm's ensures is the inductive hypothesis).
// Bridges length_append's trailing `add(length(s), Succ(Zero))` to
// `Succ(length(s))` in seq.omg's length_snoc. Lean analog: `Nat.add_one`.
machine add_one_right(a: Nat) -> Nat
terminates by a
ensures
    |proof|::Identity::<Nat>(add(a, Nat::Succ { prev: Nat::Zero }), Nat::Succ { prev: a })
{
    transition a {
        Nat::Zero -> Nat::Succ { prev: Nat::Zero },
        Nat::Succ { prev } -> Nat::Succ { prev: add_one_right(prev) }
    }
}

// mul's left annihilator: mul(Zero, b) == Zero (compute-mode, unfolds the
// Zero arm).
machine mul_zero_left(b: Nat) -> Nat
ensures
    |proof|::Identity::<Nat>(result, Nat::Zero)
{
    transition { _ -> (mul(Nat::Zero, b)) }
}

// The successor-shift LAW: add(a, Succ(b)) == Succ(add(a, b)), by
// induction on `a` -- an ensures that is an EQUATION BETWEEN
// APPLICATIONS (not `result == term`), each arm discharged by unfolding
// add plus this machine's own ensures as the inductive hypothesis. This
// and add_zero_right are the rewrite material COMMUTATIVITY needs; the
// missing rung is a global PATTERN-MATCHING rewrite theory (each proven
// `lhs == rhs` law rewriting matching applications everywhere), not the
// laws themselves.
machine add_succ_law(a: Nat, b: Nat) -> Nat
terminates by a
ensures
    |proof|::Identity::<Nat>(add(a, Nat::Succ { prev: b }), Nat::Succ { prev: add(a, b) })
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> Nat::Succ { prev: add_succ_law(prev, b) }
    }
}

// COMMUTATIVITY: induction on `a` with PER-ARM
// SUB-STATE proofs -- each case arm transitions to its own state carrying
// exactly the citations that case needs (ch10 "Citing Proofs", explicit
// fact injection). The base case cites add_zero_right's law at `b`; the
// step case cites add_succ_law AT THE CASE PAYLOAD (a frame only the
// sub-state sees) and cites the smaller theorem application as its
// inductive hypothesis, whose descent flows through the sub-state parameter
// (provenance: every transition into comm_step binds it from `a`'s Succ
// payload).
public machine add_comm(a: Nat, b: Nat)
satisfies |algebra|::CommutativeSemiring<Nat>::add_comm
terminates by a
ensures
    |proof|::Identity::<Nat>(add(a, b), add(b, a))
{
    transition a {
        Nat::Zero -> comm_base(b),
        Nat::Succ { prev } -> comm_step(prev, b)
    }

    machine comm_base(b: Nat) {
        add_zero_right(b);
    }

    machine comm_step(prev: Nat, b: Nat) {
        _ = add_succ_law(b, prev);
        add_comm(prev, b);
    }
}

// ASSOCIATIVITY: pure induction on `a`, no citations -- both sides
// normalize by unfolding plus the inductive hypothesis.
public machine add_assoc(a: Nat, b: Nat, c: Nat)
satisfies |algebra|::CommutativeSemiring<Nat>::add_assoc
terminates by a
ensures
    |proof|::Identity::<Nat>(add(add(a, b), c), add(a, add(b, c)))
{
    transition a {
        Nat::Zero -> aa_base(),
        Nat::Succ { prev } -> aa_step(prev, b, c)
    }

    machine aa_base() {
    }

    machine aa_step(prev: Nat, b: Nat, c: Nat) {
        add_assoc(prev, b, c);
    }
}

// mul's RIGHT annihilator (the left one is compute-mode; this one is the
// induction).
machine mul_zero_right(a: Nat) -> Nat
terminates by a
ensures
    |proof|::Identity::<Nat>(mul(a, Nat::Zero), Nat::Zero)
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> Nat::Succ { prev: mul_zero_right(prev) }
    }
}

// mul's right-successor law. The step cites the checked addition laws to
// align b + (prev + mul(prev, b)) with prev + (b + mul(prev, b)).
machine mul_succ_right(a: Nat, b: Nat) -> Nat
terminates by a
ensures
    |proof|::Identity::<Nat>(mul(a, Nat::Succ { prev: b }), add(a, mul(a, b)))
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> msr_step(prev, b)
    }

    machine msr_step(prev: Nat, b: Nat) -> Nat {
        add_comm(b, prev);
        add_assoc(b, prev, mul(prev, b));
        add_assoc(prev, b, mul(prev, b));
        transition { _ -> Nat::Succ { prev: mul_succ_right(prev, b) } }
    }
}

// Multiplicative identity in SLOT vocabulary. `one()` computes to Succ Zero;
// the three cited constructor-form laws reduce mul(a, one()) through
// add(a, mul(a, Zero)) to a.
machine mul_identity(a: Nat)
satisfies |algebra|::CommutativeSemiring<Nat>::mul_identity
ensures
    |proof|::Identity::<Nat>(mul(a, one()), a)
{
    _ = mul_succ_right(a, Nat::Zero);
    _ = mul_zero_right(a);
    add_zero_right(a);
}

// DISTRIBUTIVITY -- citation-free: induction on `a`, no sub-states, no cited instances. The
// step case unfolds mul/add and applies the inductive hypothesis, leaving a
// four-addend shuffle (`add(b, add(c, X))` against `add(add(b, X'), ...)`)
// that the engine's REARRANGE tier discharges: Nat's explicit
// `CommutativeSemiring` conformance (add_comm + add_assoc proven above)
// licenses flattening both sides into addend multisets and comparing --
// exactly Lean's `ring` discipline, license by declared instance, never by
// imports in scope.
machine mul_distributes(a: Nat, b: Nat, c: Nat)
satisfies |algebra|::CommutativeSemiring<Nat>::mul_distributes
terminates by a
ensures
    |proof|::Identity::<Nat>(mul(a, add(b, c)), add(mul(a, b), mul(a, c)))
{
    transition a {
        Nat::Zero -> md_base(),
        Nat::Succ { prev } -> md_step(prev, b, c)
    }

    machine md_base() {
    }

    machine md_step(prev: Nat, b: Nat, c: Nat) {
        mul_distributes(prev, b, c);
    }
}

// RIGHT distributivity -- CITATION-FREE like its left twin: induction on
// `a`; the step case unfolds mul/add and applies the inductive
// hypothesis, leaving a three-addend shuffle (`add(c, add(X, Y))` against
// `add(add(c, X), Y)`) the rearrange tier discharges under the
// CommutativeSemiring conformance.
machine mul_distributes_right(a: Nat, b: Nat, c: Nat) -> Nat
terminates by a
ensures
    |proof|::Identity::<Nat>(mul(add(a, b), c), add(mul(a, c), mul(b, c)))
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> Nat::Succ { prev: mul_distributes_right(prev, b, c) }
    }
}

// MULTIPLICATION ASSOCIATES -- the last CommutativeSemiring law slot for
// Nat. Induction on `a`; the base case is compute-mode (both sides
// unfold to Zero); the step case cites RIGHT distributivity at
// (b, mul(prev, b), c) -- rewriting the unfolded left side
// `mul(add(b, mul(prev, b)), c)` into `add(mul(b, c), mul(mul(prev, b), c))`
// -- and takes the inductive hypothesis from its smaller citation, after
// which both sides meet at `add(mul(b, c), mul(prev, mul(b, c)))`.
machine mul_assoc(a: Nat, b: Nat, c: Nat)
satisfies |algebra|::CommutativeSemiring<Nat>::mul_assoc
terminates by a
ensures
    |proof|::Identity::<Nat>(mul(mul(a, b), c), mul(a, mul(b, c)))
{
    transition a {
        Nat::Zero -> ma_base(),
        Nat::Succ { prev } -> ma_step(prev, b, c)
    }

    machine ma_base() {
    }

    machine ma_step(prev: Nat, b: Nat, c: Nat) {
        _ = mul_distributes_right(b, mul(prev, b), c);
        mul_assoc(prev, b, c);
    }
}

// mul's left identity: mul(Succ(Zero), b) == b -- compute unfolds the
// Succ arm to add(b, mul(Zero, b)), the Zero arm annihilates, and ONE
// citation of add_zero_right collapses the trailing add. Lean analog:
// `Nat.one_mul`.
machine mul_one_left(b: Nat) -> Nat
ensures
    |proof|::Identity::<Nat>(mul(Nat::Succ { prev: Nat::Zero }, b), b)
{
    add_zero_right(b);
    transition { _ -> (b) }
}

// mul's right identity: mul(a, Succ(Zero)) == a -- structural induction:
// the Zero arm computes; each Succ arm unfolds to
// add(Succ(Zero), mul(prev, Succ(Zero))), the head add computes one Succ,
// and the machine's own ensures is the inductive hypothesis. Lean analog:
// `Nat.mul_one`.
machine mul_one_right(a: Nat) -> Nat
terminates by a
ensures
    |proof|::Identity::<Nat>(mul(a, Nat::Succ { prev: Nat::Zero }), a)
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> Nat::Succ { prev: mul_one_right(prev) }
    }
}

// MULTIPLICATION COMMUTES: base cites mul_zero_right; step cites
// mul_succ_right at (b, prev) plus the inductive hypothesis.
public machine mul_comm(a: Nat, b: Nat)
satisfies |algebra|::CommutativeSemiring<Nat>::mul_comm
terminates by a
ensures
    |proof|::Identity::<Nat>(mul(a, b), mul(b, a))
{
    transition a {
        Nat::Zero -> mc_base(b),
        Nat::Succ { prev } -> mc_step(prev, b)
    }

    machine mc_base(b: Nat) {
        _ = mul_zero_right(b);
    }

    machine mc_step(prev: Nat, b: Nat) {
        _ = mul_succ_right(b, prev);
        mul_comm(prev, b);
    }
}

// CANCELLATION (requires-bearing induction): add is left-
// cancellative. Induction on c: the Zero arm's requires unfolds to a == b
// outright; the Succ arm's requires unfolds to Succ-wrapped sides whose
// injectivity yields the prev-level equation -- exactly the inductive
// hypothesis's PREMISE, so the IH discharges and closes the arm. This is
// the lemma quotient transitivity stands on (comm+assoc alone cannot
// cancel).
machine add_cancel(c: Nat, a: Nat, b: Nat) -> Nat
terminates by c
requires
    |proof|::Identity::<Nat>(add(c, a), add(c, b))
ensures
    |proof|::Identity::<Nat>(a, b)
{
    transition c {
        Nat::Zero -> ac_base(a, b),
        Nat::Succ { prev } -> ac_step(prev, a, b)
    }

    machine ac_base(a: Nat, b: Nat) -> Nat {
        transition { _ -> (a) }
    }

    machine ac_step(prev: Nat, a: Nat, b: Nat) -> Nat {
        transition { _ -> (add_cancel(prev, a, b)) }
    }
}


// PREDECESSOR: pred(Zero) = Zero,
// pred(Succ a') = a' -- the single-transition shape the structural judge
// unfolds. Lean analog: Nat.pred.
machine pred(a: Nat) -> Nat
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> (prev)
    }
}

// TRANSITIONAL TRUNCATED SUBTRACTION: saturating_sub(a, Zero) = a; saturating_sub(a, Succ b') =
// pred(saturating_sub(a, b')) -- Lean's Nat.sub spelling, recursion on `b` composing
// `pred` cross-machine (the mul-over-add pattern; every machine here stays
// single-transition so lemma facts unfold). `saturating_sub(a, b) == Zero` is the
// roster's spelling of `a <= b`, which the laws below keep using. Ordinary
// `Nat - Nat` is the exact `subtract` above and requires `b <= a` at each
// use. This named monus and its proof corpus remain distinct from that
// operator rather than silently routing bare `-` to clamping.
public machine saturating_sub(a: Nat, b: Nat) -> Nat
terminates by b
{
    transition b {
        Nat::Zero -> (a),
        Nat::Succ { prev } -> (pred(saturating_sub(a, prev)))
    }
}

// saturating_sub's right identity: saturating_sub(a, Zero) == a (compute-mode -- the Zero arm
// returns `a` outright). Lean analog: Nat.sub_zero.
machine sub_zero_right(a: Nat) -> Nat
ensures
    |proof|::Identity::<Nat>(result, a),
    |proof|::Identity::<Nat>(saturating_sub(a, Nat::Zero), a)
{
    transition { _ -> (saturating_sub(a, Nat::Zero)) }
}

// The Succ-stripping law: saturating_sub(Succ(a), Succ(b)) == saturating_sub(a, b) -- structural
// induction on `b`. The Zero arm computes (pred(Succ(a)) = a = saturating_sub(a, Zero));
// each Succ arm rewrites under pred with the inductive hypothesis. Lean
// analog: Nat.succ_sub_succ.
machine succ_sub_succ(a: Nat, b: Nat) -> Nat
terminates by b
ensures
    |proof|::Identity::<Nat>(
        saturating_sub(Nat::Succ { prev: a }, Nat::Succ { prev: b }),
        saturating_sub(a, b)
    )
{
    transition b {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> sss_step(a, prev)
    }

    machine sss_step(a: Nat, prev: Nat) -> Nat {
        transition { _ -> (succ_sub_succ(a, prev)) }
    }
}

// Left-zero annihilation: saturating_sub(Zero, b) == Zero -- structural induction on
// `b` (the Zero arm computes; each Succ arm is pred of the inductive
// hypothesis's Zero). Lean analog: Nat.zero_sub.
machine sub_zero_left(b: Nat) -> Nat
terminates by b
ensures
    |proof|::Identity::<Nat>(saturating_sub(Nat::Zero, b), Nat::Zero)
{
    transition b {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> szl_step(prev)
    }

    machine szl_step(prev: Nat) -> Nat {
        transition { _ -> (sub_zero_left(prev)) }
    }
}

// Self-annihilation: saturating_sub(a, a) == Zero -- structural induction on `a`; each
// Succ arm strips one Succ from both sides by citing succ_sub_succ at
// (prev, prev), then the ensures is the inductive hypothesis. Lean analog:
// Nat.sub_self.
machine sub_self(a: Nat) -> Nat
terminates by a
ensures
    |proof|::Identity::<Nat>(saturating_sub(a, a), Nat::Zero)
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> ss_step(prev)
    }

    machine ss_step(prev: Nat) -> Nat {
        _ = succ_sub_succ(prev, prev);
        transition { _ -> (sub_self(prev)) }
    }
}

// Left-addition cancels under monus: saturating_sub(add(b, a), b) == a -- structural
// induction on `b`. The Zero arm computes through add's and saturating_sub's Zero
// arms; each Succ arm strips the added Succ against the subtracted one by
// citing succ_sub_succ at (add(prev, a), prev), then the ensures is the
// inductive hypothesis. This is the Rat ladder's normalization workhorse.
// Lean analog: Nat.add_sub_cancel_left.
machine add_sub_cancel(b: Nat, a: Nat) -> Nat
terminates by b
ensures
    |proof|::Identity::<Nat>(saturating_sub((add(b, a)), b), a)
{
    transition b {
        Nat::Zero -> (a),
        Nat::Succ { prev } -> asc_step(prev, a)
    }

    machine asc_step(prev: Nat, a: Nat) -> Nat {
        _ = succ_sub_succ((add(prev, a)), prev);
        transition { _ -> (add_sub_cancel(prev, a)) }
    }
}


// ORDER AS MONUS: the spelling is `a <= b` := saturating_sub(a, b) == Zero and
// `a < b` := saturating_sub(Succ a, b) == Zero -- no new predicate, the monus IS the
// order carrier until an order surface lands.

// Stripping a Succ from the LEFT preserves <=: saturating_sub(Succ r, a) == Zero
// entails saturating_sub(r, a) == Zero. Case on `a`: the Zero arm's premise unfolds
// to Succ r == Zero, a constructor clash (vacuous); the Succ arm strips
// the pair with succ_sub_succ, so the premise becomes saturating_sub(r, s) == Zero
// and the goal saturating_sub(r, Succ s) unfolds to pred of exactly that. Lean
// analog: Nat.le_of_succ_le.
machine le_of_succ_le(r: Nat, a: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: r }, a), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(saturating_sub(r, a), Nat::Zero)
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> losl_step(r, prev)
    }

    machine losl_step(r: Nat, prev: Nat) -> Nat {
        _ = succ_sub_succ(r, prev);
        transition { _ -> Nat::Zero }
    }
}

// pred preserves <= on the left: saturating_sub(x, a) == Zero entails
// saturating_sub(pred(x), a) == Zero. Case on `x`: the Zero arm computes (pred(Zero)
// = Zero, the goal is the premise); the Succ arm is le_of_succ_le.
machine pred_le_left(x: Nat, a: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(saturating_sub(x, a), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(saturating_sub((pred(x)), a), Nat::Zero)
{
    transition x {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> pll_step(prev, a)
    }

    machine pll_step(prev: Nat, a: Nat) -> Nat {
        _ = le_of_succ_le(prev, a);
        transition { _ -> Nat::Zero }
    }
}

// Monus never exceeds its left argument: saturating_sub(a, b) <= a, premise-free --
// induction on `b` (following saturating_sub's own recursion). The Zero arm computes
// through saturating_sub's Zero arm to sub_self's fact; each Succ arm unfolds
// saturating_sub(a, Succ q) to pred(saturating_sub(a, q)), takes the inductive hypothesis
// saturating_sub(saturating_sub(a, q), a) == Zero, and closes with pred_le_left. Lean analog:
// Nat.sub_le.
machine sub_le(a: Nat, b: Nat) -> Nat
terminates by b
ensures
    |proof|::Identity::<Nat>(saturating_sub((saturating_sub(a, b)), a), Nat::Zero)
{
    transition b {
        Nat::Zero -> sle_zero(a),
        Nat::Succ { prev as q } -> sle_step(a, q)
    }

    machine sle_zero(a: Nat) -> Nat {
        _ = sub_self(a);
        transition { _ -> Nat::Zero }
    }

    machine sle_step(a: Nat, q: Nat) -> Nat {
        _ = pred_le_left((saturating_sub(a, q)), a);
        transition { _ -> (sub_le(a, q)) }
    }
}

// Subtracting two successors yields a result below the first successor.
// The contract states exact Nat identity with Zero after subtracting that
// first successor from Succ(result). Two succ_sub_succ citations reduce the
// goal to sub_le. A recursive call on this computed result can cite the law
// to establish strict descent without a structural-subterm argument.
machine sub_lt_succ(a: Nat, b: Nat) -> Nat
ensures
    |proof|::Identity::<Nat>(
        saturating_sub(Nat::Succ { prev: (saturating_sub(Nat::Succ { prev: a }, Nat::Succ { prev: b })) }, Nat::Succ { prev: a }),
        Nat::Zero
    )
{
    transition {
        _ -> slt_body(a, b)
    }

    machine slt_body(a: Nat, b: Nat) -> Nat {
        _ = succ_sub_succ(a, b);
        _ = succ_sub_succ((saturating_sub(a, b)), a);
        _ = sub_le(a, b);
        transition { _ -> Nat::Zero }
    }
}

// The SYMBOLIC strict fact, positivity via a premise instead of Succ
// shape: Succ pb <= a entails saturating_sub(a, Succ pb) < a. The Zero arm is
// vacuous (Succ pb <= Zero clashes); the Succ arm strips the pair twice
// with succ_sub_succ and closes on sub_le -- no induction, the premise
// only serves the vacuity.
machine sub_lt_of_le(pb: Nat, a: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: pb }, a), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(
        saturating_sub(Nat::Succ { prev: (saturating_sub(a, Nat::Succ { prev: pb })) }, a),
        Nat::Zero
    )
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev as pa } -> slol_step(pa, pb)
    }

    machine slol_step(pa: Nat, pb: Nat) -> Nat {
        _ = succ_sub_succ(pa, pb);
        _ = succ_sub_succ((saturating_sub(pa, pb)), pa);
        _ = sub_le(pa, pb);
        transition { _ -> Nat::Zero }
    }
}

// A positive subtrahend no greater than a gives strict descent:
// saturating_sub(a, b) < a. The contract expresses that order as exact Nat
// identity of saturating_sub(Succ(saturating_sub(a, b)), a) with Zero.
// A recursive call at a computed natural, such as `mod(saturating_sub(a, b),
// b)` by repeated subtraction, cites this law at its actual operands to
// establish the required decrease. The Zero arm contradicts the positive-b premise;
// the Succ arm uses sub_lt_of_le with the exposed predecessor.
public machine sub_lt(a: Nat, b: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: Nat::Zero }, b), Nat::Zero),
    |proof|::Identity::<Nat>(saturating_sub(b, a), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: (saturating_sub(a, b)) }, a), Nat::Zero)
{
    transition b {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev as pb } -> slt_of(pb, a)
    }

    machine slt_of(pb: Nat, a: Nat) -> Nat {
        _ = sub_lt_of_le(pb, a);
        transition { _ -> Nat::Zero }
    }
}

// pred is injective off zero: pred(x) == Succ w entails x == Succ (Succ w).
// Case on x: the Zero arm is vacuous (pred(Zero) computes to Zero, which
// clashes with Succ w); the Succ arm's premise rewrites the payload.
machine pred_eq_succ(x: Nat, w: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(pred(x), Nat::Succ { prev: w })
ensures
    |proof|::Identity::<Nat>(x, Nat::Succ { prev: Nat::Succ { prev: w } })
{
    transition x {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> Nat::Zero
    }
}

// A positive monus reconstructs the addition: saturating_sub(b, a) == Succ w entails
// b == add(a, Succ w). Induction on `a`: the Zero arm's premise computes
// to b == Succ w and the goal's add computes to Succ w; the Succ arm
// unfolds the premise to pred(saturating_sub(b, pa)) == Succ w, cites pred_eq_succ
// to recover saturating_sub(b, pa) == Succ (Succ w), takes the inductive hypothesis
// at (pa, b, Succ w), and closes through add_succ_law.
machine sub_eq_add(a: Nat, b: Nat, w: Nat) -> Nat
terminates by a
requires
    |proof|::Identity::<Nat>(saturating_sub(b, a), Nat::Succ { prev: w })
ensures
    |proof|::Identity::<Nat>(b, add(a, Nat::Succ { prev: w }))
{
    transition a {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev as pa } -> sea_step(pa, b, w)
    }

    machine sea_step(pa: Nat, b: Nat, w: Nat) -> Nat {
        _ = pred_eq_succ((saturating_sub(b, pa)), w);
        _ = add_succ_law(pa, Nat::Succ { prev: w });
        transition { _ -> (sub_eq_add(pa, b, Nat::Succ { prev: w })) }
    }
}

// Succ a never exceeds a + (w + 1): saturating_sub(Succ a, add(a, Succ w)) == Zero --
// premise-free, induction on `a`. The Zero arm computes both sides down to
// sub_zero_left's fact; the Succ arm strips one Succ from each side with
// succ_sub_succ and is the inductive hypothesis.
machine le_add(a: Nat, w: Nat) -> Nat
terminates by a
ensures
    |proof|::Identity::<Nat>(
        saturating_sub(Nat::Succ { prev: a }, (add(a, Nat::Succ { prev: w }))),
        Nat::Zero
    )
{
    transition a {
        Nat::Zero -> la_zero(w),
        Nat::Succ { prev as pa } -> la_step(pa, w)
    }

    machine la_zero(w: Nat) -> Nat {
        _ = succ_sub_succ(Nat::Zero, w);
        _ = sub_zero_left(w);
        transition { _ -> Nat::Zero }
    }

    machine la_step(pa: Nat, w: Nat) -> Nat {
        _ = succ_sub_succ(Nat::Succ { prev: pa }, (add(pa, Nat::Succ { prev: w })));
        transition { _ -> (le_add(pa, w)) }
    }
}

// THE MONUS CONVERSION (repeated-subtraction modulo's ensures workhorse): a positive difference
// the other way entails strict order -- saturating_sub(b, a) == Succ w entails
// saturating_sub(Succ a, b) == Zero (`a < b`). Flat: sub_eq_add reconstructs
// b == add(a, Succ w), le_add bounds Succ a by exactly that sum, and the
// goal rewrites through the reconstruction.
public machine lt_of_sub_pos(a: Nat, b: Nat, w: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(saturating_sub(b, a), Nat::Succ { prev: w })
ensures
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: a }, b), Nat::Zero)
{
    transition {
        _ -> lsp_body(a, b, w)
    }

    machine lsp_body(a: Nat, b: Nat, w: Nat) -> Nat {
        _ = sub_eq_add(a, b, w);
        _ = le_add(a, w);
        transition { _ -> Nat::Zero }
    }
}

// One is at most any successor: saturating_sub(Succ Zero, Succ pb) == Zero --
// premise-free, flat (strip the pair, annihilate on the left). The site
// fact a positive divisor `Succ pb` gives for `mod`'s and `div`'s premise.
public machine le_one_succ(pb: Nat) -> Nat
ensures
    |proof|::Identity::<Nat>(
        saturating_sub(Nat::Succ { prev: Nat::Zero }, Nat::Succ { prev: pb }),
        Nat::Zero
    )
{
    transition {
        _ -> los_body(pb)
    }

    machine los_body(pb: Nat) -> Nat {
        _ = succ_sub_succ(Nat::Zero, pb);
        _ = sub_zero_left(pb);
        transition { _ -> Nat::Zero }
    }
}

// TRUNCATED SUBTRACTION BELOW A SUCCESSOR: for r < k, subtracting r leaves
// one more than subtracting Succ(r) -- saturating_sub(k, r) ==
// Succ(saturating_sub(k, Succ r)). Division's countdown takes one step
// with it. `sub_succ_left` is the same fact with the successor on the left
// of the subtraction, by induction on `r`.
machine sub_succ_left(j: Nat, r: Nat) -> Nat
terminates by r
requires
    |proof|::Identity::<Nat>(saturating_sub(r, j), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: j }, r), Nat::Succ { prev: saturating_sub(j, r) })
{
    transition r {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev as pr } -> ssl_step(j, pr)
    }

    machine ssl_step(j: Nat, pr: Nat) -> Nat {
        transition j {
            Nat::Zero -> Nat::Zero,
            Nat::Succ { prev as pj } -> ssl_both(pj, pr)
        }
    }

    machine ssl_both(pj: Nat, pr: Nat) -> Nat {
        _ = succ_sub_succ(pr, pj);
        _ = succ_sub_succ(Nat::Succ { prev: pj }, pr);
        _ = succ_sub_succ(pj, pr);
        transition { _ -> (sub_succ_left(pj, pr)) }
    }
}

machine sub_succ_right(r: Nat, k: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: r }, k), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(saturating_sub(k, r), Nat::Succ { prev: saturating_sub(k, Nat::Succ { prev: r }) })
{
    transition k {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev as j } -> ssr_step(r, j)
    }

    machine ssr_step(r: Nat, j: Nat) -> Nat {
        _ = succ_sub_succ(r, j);
        _ = succ_sub_succ(j, r);
        _ = sub_succ_left(j, r);
        transition { _ -> Nat::Zero }
    }
}

// CORE UNARY NATURAL DIVISION (numeric_values.md, "Core unary natural
// division"): one structural helper computes both results. For the divisor
// Succ(k), `divide_step(n, k, q, c)` consumes the `n` successors still left
// of the dividend with the quotient `q` accumulated so far and the countdown
// `c`. Each successor either counts the countdown down or, at zero, adds one
// to the quotient and resets the countdown to `k`. With the dividend
// exhausted, the quotient is `q` and the remainder `k - c`. The recursion is
// on `n` alone, so no fuel and no descent proof is needed.
public data Division {
    quotient: Nat;
    remainder: Nat;
}

machine divide_step(n: Nat, k: Nat, q: Nat, c: Nat) -> Division
terminates by n
{
    transition n {
        Nat::Zero -> (Division { quotient: q, remainder: saturating_sub(k, c) }),
        Nat::Succ { prev } -> divide_next(prev, k, q, c)
    }

    machine divide_next(prev: Nat, k: Nat, q: Nat, c: Nat) -> Division {
        transition c {
            Nat::Zero -> (divide_step(prev, k, Nat::Succ { prev: q }, k)),
            Nat::Succ { prev as rest } -> (divide_step(prev, k, q, rest))
        }
    }
}

// The helper's invariant, for a countdown no greater than `k`: what it
// returns reconstructs the successors it consumed plus what it was given,
// quotient * Succ(k) + remainder == n + (q * Succ(k) + (k - c)). Induction
// on `n`; a reset cites `sub_self(k)` for its new countdown and a count down
// steps `k - c` with `sub_succ_right`.
machine divide_reconstructs(n: Nat, k: Nat, q: Nat, c: Nat) -> Nat
terminates by n
requires
    |proof|::Identity::<Nat>(saturating_sub(c, k), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(
        add(mul(divide_step(n, k, q, c).quotient, Nat::Succ { prev: k }), divide_step(n, k, q, c).remainder),
        add(n, add(mul(q, Nat::Succ { prev: k }), saturating_sub(k, c)))
    )
{
    transition n {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev } -> dr_step(prev, k, q, c)
    }

    machine dr_step(prev: Nat, k: Nat, q: Nat, c: Nat) -> Nat {
        transition c {
            Nat::Zero -> dr_reset(prev, k, q),
            Nat::Succ { prev as rest } -> dr_count(prev, k, q, rest)
        }
    }

    machine dr_reset(prev: Nat, k: Nat, q: Nat) -> Nat {
        _ = sub_self(k);
        _ = add_zero_right(add(Nat::Succ { prev: k }, mul(q, Nat::Succ { prev: k })));
        _ = add_succ_law(prev, add(k, mul(q, Nat::Succ { prev: k })));
        transition { _ -> (divide_reconstructs(prev, k, Nat::Succ { prev: q }, k)) }
    }

    machine dr_count(prev: Nat, k: Nat, q: Nat, rest: Nat) -> Nat {
        _ = le_of_succ_le(rest, k);
        _ = sub_succ_right(rest, k);
        _ = add_succ_law(mul(q, Nat::Succ { prev: k }), saturating_sub(k, Nat::Succ { prev: rest }));
        _ = add_succ_law(prev, add(mul(q, Nat::Succ { prev: k }), saturating_sub(k, Nat::Succ { prev: rest })));
        transition { _ -> (divide_reconstructs(prev, k, q, rest)) }
    }
}

// The helper's remainder never exceeds `k` while the countdown does not:
// saturating_sub(remainder, k) == Zero. Induction on `n`.
machine divide_bounds(n: Nat, k: Nat, q: Nat, c: Nat) -> Nat
terminates by n
requires
    |proof|::Identity::<Nat>(saturating_sub(c, k), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(saturating_sub(divide_step(n, k, q, c).remainder, k), Nat::Zero)
{
    transition n {
        Nat::Zero -> db_done(k, c),
        Nat::Succ { prev } -> db_step(prev, k, q, c)
    }

    machine db_done(k: Nat, c: Nat) -> Nat {
        _ = sub_le(k, c);
        transition { _ -> Nat::Zero }
    }

    machine db_step(prev: Nat, k: Nat, q: Nat, c: Nat) -> Nat {
        transition c {
            Nat::Zero -> db_reset(prev, k, q),
            Nat::Succ { prev as rest } -> db_count(prev, k, q, rest)
        }
    }

    machine db_reset(prev: Nat, k: Nat, q: Nat) -> Nat {
        _ = sub_self(k);
        transition { _ -> (divide_bounds(prev, k, Nat::Succ { prev: q }, k)) }
    }

    machine db_count(prev: Nat, k: Nat, q: Nat, rest: Nat) -> Nat {
        _ = le_of_succ_le(rest, k);
        transition { _ -> (divide_bounds(prev, k, q, rest)) }
    }
}

// QUOTIENT and REMAINDER for a positive divisor: the two projections of
// one `divide_step` that starts with quotient zero and countdown `k` for
// b = Succ(k). The divisor-zero arm is excluded by the premise. `mod`
// states its strict bound, mod(a, b) < b; `div_mod_reconstruction` states
// div(a, b) * b + mod(a, b) == a. Lean analog: Nat.div, Nat.mod.
public machine div(a: Nat, b: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: Nat::Zero }, b), Nat::Zero)
{
    transition b {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev as k } -> (divide_step(a, k, Nat::Zero, k).quotient)
    }
}

public machine mod(a: Nat, b: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: Nat::Zero }, b), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: result }, b), Nat::Zero)
{
    transition b {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev as k } -> mod_of(a, k)
    }

    machine mod_of(a: Nat, k: Nat) -> Nat {
        _ = sub_self(k);
        _ = divide_bounds(a, k, Nat::Zero, k);
        _ = succ_sub_succ(divide_step(a, k, Nat::Zero, k).remainder, k);
        transition { _ -> (divide_step(a, k, Nat::Zero, k).remainder) }
    }
}

public machine div_mod_reconstruction(a: Nat, b: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: Nat::Zero }, b), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(add(mul(div(a, b), b), mod(a, b)), a)
{
    transition b {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev as k } -> dmr_of(a, k)
    }

    machine dmr_of(a: Nat, k: Nat) -> Nat {
        _ = sub_self(k);
        _ = divide_reconstructs(a, k, Nat::Zero, k);
        _ = add_zero_right(a);
        transition { _ -> Nat::Zero }
    }
}

// Order is transitive: x <= y and y <= z entail x <= z, in core's spelling
// saturating_sub(x, z) == Zero. Induction on `x`; a successor on the left
// forces successors on the right (each premise would otherwise equate a
// successor with zero), and succ_sub_succ strips the three pairs. Lean
// analog: Nat.le_trans.
machine le_trans(x: Nat, y: Nat, z: Nat) -> Nat
terminates by x
requires
    |proof|::Identity::<Nat>(saturating_sub(x, y), Nat::Zero),
    |proof|::Identity::<Nat>(saturating_sub(y, z), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(saturating_sub(x, z), Nat::Zero)
{
    transition x {
        Nat::Zero -> lt_zero(z),
        Nat::Succ { prev } -> lt_left(prev, y, z)
    }

    machine lt_zero(z: Nat) -> Nat {
        _ = sub_zero_left(z);
        transition { _ -> Nat::Zero }
    }

    machine lt_left(prev: Nat, y: Nat, z: Nat) -> Nat {
        transition y {
            Nat::Zero -> Nat::Zero,
            Nat::Succ { prev as py } -> lt_middle(prev, py, z)
        }
    }

    machine lt_middle(prev: Nat, py: Nat, z: Nat) -> Nat {
        transition z {
            Nat::Zero -> Nat::Zero,
            Nat::Succ { prev as pz } -> lt_all(prev, py, pz)
        }
    }

    machine lt_all(px: Nat, py: Nat, pz: Nat) -> Nat {
        _ = succ_sub_succ(px, py);
        _ = succ_sub_succ(py, pz);
        _ = succ_sub_succ(px, pz);
        transition { _ -> (le_trans(px, py, pz)) }
    }
}

// EUCLID: gcd(a, Zero) == a and gcd(a, Succ pb) == gcd(Succ pb, mod(a,
// Succ pb)). The remainder is strictly below the divisor, so a divisor `b`
// bounds the number of steps. `gcd_within(n, a, b)` takes at most `n`
// steps and recurses on `n` alone, so no fuel is needed; `gcd(a, b)` is
// gcd_within(b, a, b). With no steps left it answers `a`, which is right
// only for b == Zero; `gcd_within_agrees` shows that any bound `n` with
// b <= n gives the same answer, so the bound always suffices. Lean analog:
// Nat.gcd.
machine gcd_within(n: Nat, a: Nat, b: Nat) -> Nat
terminates by n
{
    transition n {
        Nat::Zero -> (a),
        Nat::Succ { prev } -> gcd_within_step(prev, a, b)
    }

    machine gcd_within_step(prev: Nat, a: Nat, b: Nat) -> Nat {
        transition b {
            Nat::Zero -> (a),
            Nat::Succ { prev as pb } -> gcd_within_next(prev, a, pb)
        }
    }

    machine gcd_within_next(prev: Nat, a: Nat, pb: Nat) -> Nat {
        transition { _ -> (gcd_within(prev, Nat::Succ { prev: pb }, divide_step(a, pb, Nat::Zero, pb).remainder)) }
    }
}

public machine gcd(a: Nat, b: Nat) -> Nat {
    transition { _ -> (gcd_within(b, a, b)) }
}

// Every sufficient bound gives the same greatest common divisor: for
// b <= n and b <= m, gcd_within(n, a, b) == gcd_within(m, a, b). Induction
// on `n`. A bound of zero forces b == Zero, where both sides are `a`; with
// two successor bounds and a successor divisor both sides take one step
// to the remainder, which is below the divisor and so within both smaller
// bounds (`divide_bounds`, then `le_trans`).
machine gcd_within_agrees(n: Nat, m: Nat, a: Nat, b: Nat) -> Nat
terminates by n
requires
    |proof|::Identity::<Nat>(saturating_sub(b, n), Nat::Zero),
    |proof|::Identity::<Nat>(saturating_sub(b, m), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(gcd_within(n, a, b), gcd_within(m, a, b))
{
    transition n {
        Nat::Zero -> gwa_none(m, a, b),
        Nat::Succ { prev } -> gwa_some(prev, m, a, b)
    }

    machine gwa_none(m: Nat, a: Nat, b: Nat) -> Nat {
        transition b {
            Nat::Zero -> gwa_divisor_zero(m, a),
            Nat::Succ { prev as pb } -> Nat::Zero
        }
    }

    machine gwa_divisor_zero(m: Nat, a: Nat) -> Nat {
        transition m {
            Nat::Zero -> Nat::Zero,
            Nat::Succ { prev as pm } -> Nat::Zero
        }
    }

    machine gwa_some(pn: Nat, m: Nat, a: Nat, b: Nat) -> Nat {
        transition m {
            Nat::Zero -> gwa_other_none(pn, a, b),
            Nat::Succ { prev as pm } -> gwa_both(pn, pm, a, b)
        }
    }

    machine gwa_other_none(pn: Nat, a: Nat, b: Nat) -> Nat {
        transition b {
            Nat::Zero -> Nat::Zero,
            Nat::Succ { prev as pb } -> Nat::Zero
        }
    }

    machine gwa_both(pn: Nat, pm: Nat, a: Nat, b: Nat) -> Nat {
        transition b {
            Nat::Zero -> Nat::Zero,
            Nat::Succ { prev as pb } -> gwa_step(pn, pm, a, pb)
        }
    }

    machine gwa_step(pn: Nat, pm: Nat, a: Nat, pb: Nat) -> Nat {
        _ = sub_self(pb);
        _ = divide_bounds(a, pb, Nat::Zero, pb);
        _ = succ_sub_succ(pb, pn);
        _ = succ_sub_succ(pb, pm);
        _ = le_trans(divide_step(a, pb, Nat::Zero, pb).remainder, pb, pn);
        _ = le_trans(divide_step(a, pb, Nat::Zero, pb).remainder, pb, pm);
        transition { _ -> (gcd_within_agrees(pn, pm, Nat::Succ { prev: pb }, divide_step(a, pb, Nat::Zero, pb).remainder)) }
    }
}

// Euclid's step as a law of `gcd`, on every input with a positive
// divisor: gcd(a, b) == gcd(b, mod(a, b)). Both sides are `gcd_within` at
// different bounds, which agree.
public machine gcd_step(a: Nat, b: Nat) -> Nat
requires
    |proof|::Identity::<Nat>(saturating_sub(Nat::Succ { prev: Nat::Zero }, b), Nat::Zero)
ensures
    |proof|::Identity::<Nat>(gcd(a, b), gcd(b, mod(a, b)))
{
    transition b {
        Nat::Zero -> Nat::Zero,
        Nat::Succ { prev as pb } -> gs_of(a, pb)
    }

    machine gs_of(a: Nat, pb: Nat) -> Nat {
        _ = sub_self(pb);
        _ = divide_bounds(a, pb, Nat::Zero, pb);
        _ = sub_self(divide_step(a, pb, Nat::Zero, pb).remainder);
        _ = gcd_within_agrees(pb, divide_step(a, pb, Nat::Zero, pb).remainder, Nat::Succ { prev: pb }, divide_step(a, pb, Nat::Zero, pb).remainder);
        transition { _ -> Nat::Zero }
    }
}
