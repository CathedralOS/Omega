// Native binding descriptions identify coordinates, not calling authority.
// Build supplies these ordinary values to the checked binding owner. Import
// bytes retain their declared widths; a table selection retains its exact
// formal and field descriptions. Neither supplies an independent calling plan.

use omega::language::core::reflect::ParameterInfo;
use omega::language::core::reflect::FieldInfo;

public data DllImport<
    const ObjectLength: u64,
    const SymbolLength: u64,
    const VersionLength: u64
> {
    case PeByName(
        library: [u8; ObjectLength],
        export: [u8; SymbolLength]
    );
    case PeByOrdinal(
        library: [u8; ObjectLength],
        ordinal: u16
    );
    case ElfVersioned(
        object: [u8; ObjectLength],
        symbol: [u8; SymbolLength],
        version: [u8; VersionLength]
    );
    case MachODylibSymbol(
        install_name: [u8; ObjectLength],
        symbol: [u8; SymbolLength]
    );
}

// Syscall numbers are ordinary target-scoped values. Table bindings use typed
// selectors rather than an integer slot or an import-coordinate string.
public data ForeignBinding<
    const ObjectLength: u64,
    const SymbolLength: u64,
    const VersionLength: u64
> {
    case DllImport(
        import: DllImport<ObjectLength, SymbolLength, VersionLength>
    );
    case Syscall(number: u64);
}

public data FunctionFieldBinding<'text> {
    table: ParameterInfo<'text>;
    field: FieldInfo<'text>;
}
