module access;

// Access operations are ordinary static machines in this module. A data
// declaration is not a code namespace (machines.md, "Static declarations and
// explicit state"), so neither the view operations nor the `AccessPlan`
// constructors are qualified by a data type; their explicit parameters carry
// every input.

use omega::language::core::Extent;
use omega::language::core::Extent::Granted;
use omega::language::core::Extent::Vacant;
use omega::language::core::AccessPlan;
use omega::language::core::AccessFieldEntry;
use omega::language::core::AccessCallerRule;
use omega::language::core::AccessRegion;
use omega::language::core::BoundaryReach;
use omega::language::core::FieldAccess;
use omega::language::core::Issuance;
use omega::language::core::ResourceProfile;
use omega::language::core::ResourceProfileSupply;
use omega::language::core::AccessOutcome;
use omega::language::core::AccessReturn;
use omega::language::core::AccessBorrowReturn;
use omega::language::core::AccessInitializationFailure;
use omega::language::core::AccessExtraction;
use omega::language::core::AccessLifecycle;
use omega::language::core::reflect::TypeSchema;
use omega::language::core::reflect::CallableInfo;
use omega::language::core::reflect::FieldInfo;

// A new plan adds no reader/writer restriction, observation demand or reach.
// Its explicit issuance choice is independent of those empty axes.
public machine new_plan<'text>(schema: &TypeSchema<'text>, issuance: Issuance<'text>) -> AccessPlan<'text>
reaches none
crashes none
terminates
ensures result.field_count == 0, result.reader_count == 0,
    result.writer_count == 0, result.reach.service_count == 0
{
    let fields: [AccessFieldEntry; 32];
    let readers: [AccessCallerRule; 32];
    let writers: [AccessCallerRule; 32];
    let reach: BoundaryReach;
    AccessPlan {
        schema: TypeSchema { storage: schema.storage },
        issuance: issuance,
        fields: fields, field_count: 0,
        readers: readers, reader_count: 0,
        writers: writers, writer_count: 0,
        reach: reach
    }
}

// Each call appends an independent restriction. Empty callers deny that
// region, while no row adds no restriction. Parent and repeated rules remain
// separate so normalization must intersect them rather than replace a row.
public machine allow_readers<'text>(plan: &mut AccessPlan<'text>, region: AccessRegion<'text>, callers: [CallableInfo<'text>])
reaches none
crashes none
terminates
requires plan.reader_count < 32
ensures embed(plan.reader_count) == embed(old(plan.reader_count)) + 1
{
    let index: u64 = plan.reader_count;
    plan.readers[index] = AccessCallerRule { region: region, callers: callers };
    plan.reader_count = index + 1;
}

public machine allow_readers<'text>(plan: &mut AccessPlan<'text>, field: FieldInfo<'text>, callers: [CallableInfo<'text>])
reaches none
crashes none
terminates
requires plan.reader_count < 32
ensures embed(plan.reader_count) == embed(old(plan.reader_count)) + 1
{
    allow_readers(plan, AccessRegion::Field { field: field }, callers);
}

public machine allow_writers<'text>(plan: &mut AccessPlan<'text>, region: AccessRegion<'text>, callers: [CallableInfo<'text>])
reaches none
crashes none
terminates
requires plan.writer_count < 32
ensures embed(plan.writer_count) == embed(old(plan.writer_count)) + 1
{
    let index: u64 = plan.writer_count;
    plan.writers[index] = AccessCallerRule { region: region, callers: callers };
    plan.writer_count = index + 1;
}

public machine allow_writers<'text>(plan: &mut AccessPlan<'text>, field: FieldInfo<'text>, callers: [CallableInfo<'text>])
reaches none
crashes none
terminates
requires plan.writer_count < 32
ensures embed(plan.writer_count) == embed(old(plan.writer_count)) + 1
{
    allow_writers(plan, AccessRegion::Field { field: field }, callers);
}

// Appending preserves repeated demands for the same field. Normalization must
// satisfy every row; construction does not replace an inherited restriction.
public machine observe<'text>(plan: &mut AccessPlan<'text>, field: FieldInfo<'text>, access: FieldAccess)
reaches none
crashes none
terminates
requires plan.field_count < 32
ensures embed(plan.field_count) == embed(old(plan.field_count)) + 1
{
    let index: u64 = plan.field_count;
    plan.fields[index] = AccessFieldEntry { field: field, access: access };
    plan.field_count = index + 1;
}

public machine with_reach(plan: AccessPlan, reach: BoundaryReach) -> AccessPlan
reaches none
crashes none
terminates
{
    let mut updated: AccessPlan = plan;
    updated.reach = reach;
    updated
}

// View operations name the complete qualified result type as an ordinary
// type argument; they are not a source wrapper around that type. Realization
// must join its exact domain policy, independent selected layout, live content,
// backing and source loan before returning it.
// Ordinary RAM retains its actual source type and loan. A different View
// argument is a request to check that correspondence, never a coercion or an
// authority grant from these declarations alone.
public boundary machine view<Source, View>(source: &Source) -> &View
reaches none crashes none;
public boundary machine view_mut<Source, View>(source: &mut Source) -> &mut View
reaches none crashes none;

// Resident interpretation retains the exact content claim as well as the
// complete qualified View. Retiring the result loan cannot retire that claim.
public boundary machine view_resident_mut<const P: AccessPolicy, Source, View>(
    storage: &mut Extent in Granted & Resident<P, Source>
) -> &mut View reaches none crashes none;

// View already-established external content without manufacturing Resident or
// Vacant. The selected call supplies compatibility for this exact qualified
// range, while the result retains the original storage loan. A numeric address
// or a constructed ResourceProfile is not a substitute for either input.
public machine view_extent<'storage, View, Role>(
    storage: &'storage Extent in Granted
) -> AccessOutcome<
    &'storage View, AccessBorrowReturn, AccessInitializationFailure
>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
{
    let profile: ResourceProfile = ResourceProfileSupply<Role>::profile(storage);
    view_from_profile<View, Role>(storage, &profile)
}

boundary machine view_from_profile<'storage, View, Role>(
    storage: &'storage Extent in Granted,
    profile: &ResourceProfile
) -> AccessOutcome<
    &'storage View, AccessBorrowReturn, AccessInitializationFailure
>;

// The exclusive counterpart carries the same interpretation and original
// profile occurrence. Its reference ceiling, not a second lifecycle or a
// geometry-based permission, allows the placement's admitted writes.
public machine view_extent_mut<'storage, View, Role>(
    storage: &'storage mut Extent in Granted
) -> AccessOutcome<
    &'storage mut View, AccessBorrowReturn, AccessInitializationFailure
>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
{
    let profile: ResourceProfile = ResourceProfileSupply<Role>::profile(storage);
    view_mut_from_profile<View, Role>(storage, &profile)
}

boundary machine view_mut_from_profile<'storage, View, Role>(
    storage: &'storage mut Extent in Granted,
    profile: &ResourceProfile
) -> AccessOutcome<
    &'storage mut View, AccessBorrowReturn, AccessInitializationFailure
>;

// These exact private machines are explicit content-establishment routes.
// Privacy supplies no profile or backing authority: compiler realization still
// requires the exact admitted call, live claim and actual allocation. They
// cannot interpret a constructed profile or an Extent's descriptor as bytes.
boundary machine initialize_from_profile<const P: AccessPolicy, T, Storage, Role>(
    storage: Extent in Granted & Vacant,
    value: T,
    profile: &ResourceProfile
) -> AccessOutcome<
    Extent in Granted & Resident<P, T>,
    AccessReturn<Extent in Granted & Vacant, T>,
    AccessInitializationFailure
>;

boundary machine extract_resident<const P: AccessPolicy, T, Storage, Role>(
    storage: Extent in Granted & Resident<P, T>,
    profile: &ResourceProfile
) -> AccessExtraction<Extent in Granted & Vacant, T>;

// The owned operation captures both inputs before its ordinary selected supply
// call. Ready retains the original range and the complete value's custody;
// rejection returns both unchanged. Only an executed complete encoding write
// can establish resident content. The compiler's lifecycle operation, not a
// caller-provided profile or the return annotation, discharges that obligation.
public machine initialize_owned<const P: AccessPolicy, T>(
    storage: Extent in Granted & Vacant,
    value: T
) -> AccessOutcome<
    Extent in Granted & Resident<P, T>,
    AccessReturn<Extent in Granted & Vacant, T>,
    AccessInitializationFailure
>
reaches AccessLifecycle + ResourceProfileSupply
invokes AccessLifecycle
{
    AccessLifecycle<P, T>::initialize(storage, value)
}

// Whole-value extraction ends this exact resident occurrence. Active loans or
// unresolved partial moves forbid it; success returns the owned value and the
// original storage with vacancy restored, rather than a new numeric root.
public machine move_out_owned<const P: AccessPolicy, T>(
    storage: Extent in Granted & Resident<P, T>
)
    -> AccessReturn<Extent in Granted & Vacant, T>
reaches AccessLifecycle + ResourceProfileSupply
invokes AccessLifecycle
{
    transition AccessLifecycle<P, T>::move_out(storage) {
        AccessExtraction::Moved { storage as vacant, value } ->
            AccessReturn { source: vacant, custody: value }
    }
}
