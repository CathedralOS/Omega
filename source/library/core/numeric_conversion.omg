// Ordinary numeric conversion operations.
//
// Proof-directed exact integer `as` is the compiler-derived surface for a
// representation change that preserves the mathematical value. It invokes no
// machine. This module supplies named library conveniences for exact conversion
// and the required visible operations for loss, saturation, or trapping. The
// policy-qualified casts inside those operations are compiler intrinsics that
// implement the named contract; they are not a hidden public conversion path.
//
// A widening name is used only when the complete source range fits the target.
// Narrowing names the conversion behavior explicitly. The policy applies to
// this conversion only; each result is an ordinary Exact integer. Callers that
// want later arithmetic to wrap, saturate, or trap qualify the returned value
// separately.

machine numeric_conversion_trap_if(invalid: bool) {
    let invalid_value: u32 in Wrapping = invalid as u32 in Wrapping;
    let count: u32 in Wrapping = invalid_value * 8;
    let probe: u8 in Trapping =
        (1 as u8 in Trapping) << (count as u32 in Trapping);
}

// --- Unsigned 16 -> 8 ------------------------------------------------------

pub machine narrow_u16_to_u8_exact(value: u16 [0..=255]) -> u8
requires
    value <= 255;
{
    value as u8
}

pub machine narrow_u16_to_u8_wrapping(value: u16) -> u8 {
    (value as u8 in Wrapping) as u8
}

pub machine narrow_u16_to_u8_saturating(value: u16) -> u8 {
    transition value > 255 {
        true -> (255)
        _ -> (value as u8)
    }
}

pub machine narrow_u16_to_u8_trapping(value: u16) -> u8 {
    let invalid: bool = value > 255;
    numeric_conversion_trap_if(invalid);
    (value as u8 in Trapping) as u8
}

pub machine widen_u8_to_u16(value: u8) -> u16 {
    value as u16
}

pub machine widen_u8_to_u32(value: u8) -> u32 {
    value as u32
}

pub machine widen_u8_to_u64(value: u8) -> u64 {
    value as u64
}

