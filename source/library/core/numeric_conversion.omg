pub machine narrow_u64_to_i64_exact(value: u64) -> i64
requires
    value <= 9223372036854775807;
{
    value as i64
}

pub machine narrow_u64_to_i64_wrapping(value: u64) -> i64 {
    (value as i64 in Wrapping) as i64
}

pub machine narrow_u64_to_i64_saturating(value: u64) -> i64 {
    // Select i64::MAX from the source high bit. This stays unsigned until the
    // representable result is selected, so no host signed comparison can
    // misclassify u64 values above i64::MAX.
    let modular_value: u64 in Wrapping = value as u64 in Wrapping;
    let high_bit: u64 in Wrapping = modular_value >> 63;
    let zero: u64 in Wrapping = 0;
    let high_mask: u64 in Wrapping = zero - high_bit;
    let all_bits: u64 in Wrapping = 18446744073709551615;
    let low_mask: u64 in Wrapping = high_mask ^ all_bits;
    let signed_max_bits: u64 in Wrapping = 9223372036854775807;
    let selected: u64 in Wrapping =
        (modular_value & low_mask) | (signed_max_bits & high_mask);
    selected as i64
}

pub machine narrow_u64_to_i64_trapping(value: u64) -> i64 {
    let first_invalid: u64 = 9223372036854775808;
    let invalid: bool = value >= first_invalid;
    numeric_conversion_trap_if(invalid);
    (value as i64 in Trapping) as i64
}

