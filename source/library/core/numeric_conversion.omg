requires
    value <= 127;
{
    value as i8
}

public machine narrow_u8_to_i8_wrapping(value: u8) -> i8 {
    let bits: u64 = value as u64;
    let narrowed: u8 = (bits & 255) as u8;
    numeric_conversion_signed_8(narrowed)
}

