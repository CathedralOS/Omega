// Ordinary numeric conversion operations.
//
// Every numeric `as` preserves the mathematical value. Arithmetic-policy
// qualification changes future operations; it cannot narrow a value by loss,
// saturation, or trapping. These named machines implement those contracts
// visibly before their final exact carrier conversions.
//
// Wrapping selects the low destination-width bits. A signed source first
// widens exactly to i64, preserving its sign, before a shared same-width view
// reads the two's-complement representation. Unsigned bit patterns become
// signed results through the corresponding total shared representation view.
// All fixed-width signed and unsigned carriers admit every bit pattern, so
// these views satisfy ordinary recast geometry and validity obligations.
//
// Saturating machines select a representable endpoint or retain an in-range
// value. Trapping machines have explicit `crash Trap` states; the successful
// path proves representability before its exact conversion. Every public
// result is Exact, so callers explicitly choose any policy for later work.
//
// Widening publishes the source carrier's bounds where later Exact arithmetic
// needs them. A widening name is used only when the complete source range fits
// the target; changing signedness can narrow a range despite increasing width.

machine numeric_conversion_signed_bits(value: i64) -> u64 {
    let bits: &u64 = &value as &u64;
    bits
}

machine numeric_conversion_signed_8(bits: u8) -> i8 {
    let value: &i8 = &bits as &i8;
    value
}

machine numeric_conversion_signed_16(bits: u16) -> i16 {
    let value: &i16 = &bits as &i16;
    value
}

machine numeric_conversion_signed_32(bits: u32) -> i32 {
    let value: &i32 = &bits as &i32;
    value
}

machine numeric_conversion_signed_64(bits: u64) -> i64 {
    let value: &i64 = &bits as &i64;
    value
}

// --- Unsigned 16 -> 8 ------------------------------------------------------

public machine narrow_u16_to_u8_exact(value: u16) -> u8
requires
    value <= 255;
{
    value as u8
}

public machine narrow_u16_to_u8_wrapping(value: u16) -> u8 {
    let bits: u64 = value as u64;
    let narrowed: u8 = (bits & 255) as u8;
    narrowed
}

public machine narrow_u16_to_u8_saturating(value: u16) -> u8 {
    transition value > 255 {
        true -> (255)
        _ -> (value as u8)
    }
}

public machine narrow_u16_to_u8_trapping(value: u16) -> u8
crashes Trap
{
    transition value > 255 {
        true -> invalid()
        _ -> (value as u8)
    }

    machine invalid() -> u8 { crash Trap; }
}

public machine widen_u8_to_u16(value: u8) -> u16
ensures result >= 0 && result <= 255
{
    value as u16
}

public machine widen_u8_to_u32(value: u8) -> u32
ensures result >= 0 && result <= 255
{
    value as u32
}

public machine widen_u8_to_u64(value: u8) -> u64
ensures result >= 0 && result <= 255
{
    value as u64
}

