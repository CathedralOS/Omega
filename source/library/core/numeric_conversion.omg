// --- Signed 16 -> 8 -------------------------------------------------------

public machine narrow_i16_to_i8_exact(value: i16) -> i8
requires
    value >= -128 && value <= 127;
{
    value as i8
}

public machine narrow_i16_to_i8_wrapping(value: i16) -> i8 {
    let bits: u64 = numeric_conversion_signed_bits(value as i64);
    let narrowed: u8 = (bits & 255) as u8;
    numeric_conversion_signed_8(narrowed)
}

public machine narrow_i16_to_i8_saturating(value: i16) -> i8 {
    transition {
        value < -128 -> (-128)
        value > 127 -> (127)
        _ -> (value as i8)
    }
}

public machine narrow_i16_to_i8_trapping(value: i16) -> i8
crashes Trap
{
    transition {
        value < -128 -> invalid()
        value > 127 -> invalid()
        _ -> (value as i8)
    }

    machine invalid() -> i8 { crash Trap; }
}

public machine widen_i8_to_i16(value: i8) -> i16 {
    value as i16
}

public machine widen_i8_to_i32(value: i8) -> i32 {
    value as i32
}

public machine widen_i8_to_i64(value: i8) -> i64 {
    value as i64
}

