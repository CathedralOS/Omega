// === Cross-signed integer conversion ======================================
//
// `widen` means the complete source range is representable by the target.
// Every other cross-signed pair is range-narrowing even when the target has
// more bits: changing signedness can still exclude negative values or the
// unsigned source's upper half.

// --- Unsigned -> signed ---------------------------------------------------

pub machine narrow_u8_to_i8_exact(value: u8 [0..=127]) -> i8
requires
    value <= 127;
{
    value as i8
}

pub machine narrow_u8_to_i8_wrapping(value: u8) -> i8 {
    (value as i8 in Wrapping) as i8
}

pub machine narrow_u8_to_i8_saturating(value: u8) -> i8 {
    let capped: u8 = clamp(value, 0, 127);
    capped as i8
}

pub machine narrow_u8_to_i8_trapping(value: u8) -> i8 {
    let invalid: bool = value > 127;
    numeric_conversion_trap_if(invalid);
    (value as i8 in Trapping) as i8
}

pub machine widen_u8_to_i16(value: u8) -> i16 {
    value as i16
}

pub machine widen_u8_to_i32(value: u8) -> i32 {
    value as i32
}

pub machine widen_u8_to_i64(value: u8) -> i64 {
    value as i64
