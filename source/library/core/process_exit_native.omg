use {omega}/language/core/never.omg;
use {omega}/language/core/process_exit.omg;

// The compiler realizes only this primitive. Ordinary ProcessExit providers
// retain checked bodies and call it under the canonical process-domain authority.
public boundary machine ProcessExitPrimitive(return_code: i32) -> |never|::Never
    satisfies |process_exit|::ProcessExit::exit_process
    reaches |process_exit|::ProcessExit
    crashes none
    terminates;
