// Core concrete-range authority.
//
// An `addr` is only a number. `Extent` is linear data carrying runtime base and
// `u64` length. Domain evidence states its grant, address space, rights,
// provenance, and lifetime/era. Reconstructing the geometry does not establish
// those facts.
//
// The value is linear because losing an owned range may lose reclamation
// debt or another exclusive authority. Zero-filled storage does not establish
// an `Extent`; APIs that need an honest zero/empty state use `ExtentSlot`.
//

public data Extent [linear] {
    base: addr;
    length: u64;
}

// These qualifications protect content custody independently of Granted.
// Linearity and sibling domains are not issuer restrictions. A provider crossing
// must establish the declared content state for this exact existing range;
// the routes alone supply neither actual backing nor a Stable access profile.
public domain Extent::Vacant
established by VacantContentTransfer::transfer, AccessLifecycle::move_out,
    Access::extract_resident, Run::extract_from_profile, Run::retire_empty,
    Run::relocate_from_profiles;
public domain<P, T> Extent::Resident<P, T>
established by ResidentContentTransfer::transfer, AccessLifecycle::initialize,
    Access::initialize_from_profile;

// Transfer an existing grant after an admitted provider establishes that its
// exact range contains no live resident. This does not zero bytes, release the
// range to an allocator, or permit reclassification by an ordinary checked call.
public boundary trait VacantContentTransfer {
    machine transfer(storage: Extent in Granted) -> Extent
    reaches none
    ensures
        result in Granted & Vacant,
        core::Identity<IntervalSet<Nat>>(Granted::content(old(&storage)), Granted::content(&result));
}

// Vacancy is absence of live content over an exact range, independently of
// the backing grant. Its own content equation transfers that existing absence
// across a partition; conservation of Granted alone cannot introduce vacancy.
public machine Vacant::content(extent: &Extent) -> IntervalSet<Nat>
satisfies Content<Extent, IntervalSet<Nat>>::project
{
    IntervalSet {
        start: embed(extent.base) as Nat,
        end: (embed(extent.base) + embed(extent.length)) as Nat
    }
}

// Both independently conserved claims follow the exact disjoint partition.
// This checked transformation is not another issuance or backing provider.
public data VacantExtentParts {
    taken: Extent in Granted & Vacant;
    rest: Extent in Granted & Vacant;
}

// Keep the prefix base explicit in the contract: an empty interval has no
// location, so content equality alone cannot recover its representable base.
// A zero-byte cut also leaves the suffix at the original base.
public machine split_vacant_extent(whole: Extent in Granted & Vacant, requested: u64)
    -> VacantExtentParts
requires requested <= whole.length
ensures
    result.taken.base == whole.base,
    result.taken.length == requested,
    result.rest.length == whole.length - requested,
    requested != 0 || result.rest.base == whole.base,
    result.rest.length == 0 || embed(result.rest.base) == embed(whole.base) + embed(requested),
    core::Identity<IntervalSet<Nat>>(
        Granted::content(old(&whole)),
        separate(
            Granted::content(&result.taken), Granted::content(&result.rest))
    ),
    core::Identity<IntervalSet<Nat>>(
        Vacant::content(old(&whole)),
        separate(
            Vacant::content(&result.taken), Vacant::content(&result.rest))
    )
{
    let { base, length } = whole;
    // An exhausted range has no one-past address: that endpoint may equal
    // addr::Bound. Keep an existing representable base for the empty tail.
    let rest_base: addr = match requested < length {
        true -> base + requested,
        false -> base,
    };
    VacantExtentParts {
        taken: Extent { base: base, length: requested },
        rest: Extent { base: rest_base, length: length - requested },
    }
}

// Recompose existing authority, without calling an issuer. Empty intervals
// carry no bytes, so their stored base need not be adjacent: split deliberately
// retains a representable base when the one-past endpoint is addr::Bound.
// Nonempty intervals must be ordered and adjacent, and the combined count must
// fit u64 independently of the target's address width. Both content equations
// are required: conservation of Granted does not establish Vacant.
public machine merge_vacant_extents(left: Extent in Granted & Vacant, right: Extent in Granted & Vacant)
    -> Extent in Granted & Vacant
requires
    embed(left.length) + embed(right.length) <= 18446744073709551615,
    left.length == 0 || right.length == 0 || embed(right.base) == embed(left.base) + embed(left.length)
ensures
    embed(result.length) == embed(left.length) + embed(right.length),
    left.length == 0 || result.base == left.base,
    left.length != 0 || result.base == right.base,
    core::Identity<IntervalSet<Nat>>(
        separate(Granted::content(old(&left)), Granted::content(old(&right))),
        Granted::content(&result)
    ),
    core::Identity<IntervalSet<Nat>>(
        separate(Vacant::content(old(&left)), Vacant::content(old(&right))),
        Vacant::content(&result)
    )
{
    transition left.length == 0 {
        true -> empty_left(left, right)
        false -> nonempty_left(left, right)
    }

    machine empty_left(left: Extent in Granted & Vacant, right: Extent in Granted & Vacant) -> Extent in Granted & Vacant
    requires left.length == 0
    ensures
        result.base == right.base,
        embed(result.length) == embed(left.length) + embed(right.length),
        core::Identity<IntervalSet<Nat>>(
            separate(Granted::content(old(&left)), Granted::content(old(&right))),
            Granted::content(&result)
        ),
        core::Identity<IntervalSet<Nat>>(
            separate(Vacant::content(old(&left)), Vacant::content(old(&right))),
            Vacant::content(&result)
        )
    {
        let { base as left_base, length as left_length } = left;
        let { base as right_base, length as right_length } = right;
        Extent { base: right_base, length: right_length }
    }

    machine nonempty_left(left: Extent in Granted & Vacant, right: Extent in Granted & Vacant) -> Extent in Granted & Vacant
    requires
        embed(left.length) + embed(right.length) <= 18446744073709551615,
        right.length == 0 || embed(right.base) == embed(left.base) + embed(left.length)
    ensures
        result.base == left.base,
        embed(result.length) == embed(left.length) + embed(right.length),
        core::Identity<IntervalSet<Nat>>(
            separate(Granted::content(old(&left)), Granted::content(old(&right))),
            Granted::content(&result)
        ),
        core::Identity<IntervalSet<Nat>>(
            separate(Vacant::content(old(&left)), Vacant::content(old(&right))),
            Vacant::content(&result)
        )
    {
        transition right.length == 0 {
            true -> empty_right(left, right)
            false -> adjacent(left, right)
        }
    }

    machine empty_right(left: Extent in Granted & Vacant, right: Extent in Granted & Vacant) -> Extent in Granted & Vacant
    requires right.length == 0
    ensures
        result.base == left.base,
        embed(result.length) == embed(left.length) + embed(right.length),
        core::Identity<IntervalSet<Nat>>(
            separate(Granted::content(old(&left)), Granted::content(old(&right))),
            Granted::content(&result)
        ),
        core::Identity<IntervalSet<Nat>>(
            separate(Vacant::content(old(&left)), Vacant::content(old(&right))),
            Vacant::content(&result)
        )
    {
        let { base as left_base, length as left_length } = left;
        let { base as right_base, length as right_length } = right;
        Extent { base: left_base, length: left_length }
    }

    machine adjacent(left: Extent in Granted & Vacant, right: Extent in Granted & Vacant) -> Extent in Granted & Vacant
    requires
        embed(left.length) + embed(right.length) <= 18446744073709551615,
        embed(right.base) == embed(left.base) + embed(left.length)
    ensures
        result.base == left.base,
        embed(result.length) == embed(left.length) + embed(right.length),
        core::Identity<IntervalSet<Nat>>(
            separate(Granted::content(old(&left)), Granted::content(old(&right))),
            Granted::content(&result)
        ),
        core::Identity<IntervalSet<Nat>>(
            separate(Vacant::content(old(&left)), Vacant::content(old(&right))),
            Vacant::content(&result)
        )
    {
        let { base as left_base, length as left_length } = left;
        let { base as right_base, length as right_length } = right;
        Extent { base: left_base, length: left_length + right_length }
    }
}

// Import already-established resident content from an admitted provider.
// Every closed P/T application shares this exact route. The provider must bind
// complete value custody, access-plan identity and backing; equal addresses or a
// result annotation cannot supply them. This is not Initialize or a byte cast.
public boundary trait ResidentContentTransfer<P, T> {
    machine transfer(storage: Extent in Granted) -> Extent
    reaches none
    ensures
        result in Granted & Resident<P, T>,
        core::Identity<IntervalSet<Nat>>(Granted::content(old(&storage)), Granted::content(&result));
}

// Geometry is a transparent mathematical predicate. The endpoint lives in
// unbounded proof Int, so a one-past endpoint may equal the exclusive bound
// without becoming an address or narrowing the independent u64 count.
// A bodyless boundary machine cannot substitute for this predicate: it would
// turn every Granted fact into a runtime observation, not a proof formula.
public let no_wrap(base: addr, length: u64): core::Strict<0> =
    embed(base) + embed(length) <= addr::Bound;

// `Granted` is authority evidence, not a structural invariant. Constructing
// the geometry above does not establish it; checked transformations must
// conserve an existing claim and admitted roots must inherit the exact
// owner-authored boundary requirement.
public domain Extent::Granted
requires
    no_wrap(self.base, self.length)
established by
    ExtentRootProvider::grant,
    ProgramStorageEntry::enter,
    DeviceLoanProvider::reserve,
    DeviceLoanProvider::acquire;

// One stable semantic entry requirement owns the loader-provisioned image and
// initial-storage roots. The active physical entry stack remains a separate
// execution resource. A target profile composes its separate physical
// arrival contract with this exact semantic requirement; target ABI inputs do
// not extend or refine this parameter list. Installation introduces these
// parameter occurrences. An ordinary call merely supplies their Granted
// preconditions and cannot mint either fact.
public boundary trait ProgramStorageEntry {
    machine enter(
        image: Extent in Granted,
        initial_storage: Extent in Granted
    ) reaches none;
}

// Explicitly selected transport to this artifact's Build-bound continuation.
// This call forwards two existing grants; it cannot introduce either root or
// choose a continuation by spelling. The native bridge retains Build custody.
public data ProgramStorageEntryNativeProvider {}
public uefi_x86_64 boundary machine ProgramStorageEntryNativeProvider::enter(
    image: Extent in Granted,
    initial_storage: Extent in Granted
) satisfies ProgramStorageEntry::enter;

// `Granted` owns one canonical half-open address interval. Runtime address
// arithmetic must not define the one-past end: fixed-width values first embed
// into proof Int, and their derived nonnegativity permits exact conversion to
// these proof-Nat coordinates. Nat retains an end equal to the address-space
// bound even when `addr` cannot represent it. Both conversions remain visible:
// embedding selects the uniform proof-Int meaning, while `as Nat` consumes its
// derived nonnegative range fact at the content-algebra boundary.
public machine Granted::content(extent: &Extent) -> IntervalSet<Nat>
satisfies Content<Extent, IntervalSet<Nat>>::project
{
    IntervalSet {
        start: embed(extent.base) as Nat,
        end: (embed(extent.base) + embed(extent.length)) as Nat
    }
}

// The domain owner authorizes exactly this admitted root crossing. The caller
// supplies ordinary geometry; the selected provider plan and its admission
// receipt are what establish `Granted` on the returned carrier. One call
// yields one root claim. Backing containment and richer space/rights facts join
// the same receipt as the resource-frontier implementation lands.
public boundary trait ExtentRootProvider {
    machine grant(root: Extent) -> Extent
    reaches none
    ensures
        result in Extent::Granted;
}

data ExtentSlot {
    case Empty;
    case Live(extent: Extent);
}
