// Core concrete-range authority.
//
// An `addr` is only a number. `Extent` is linear data carrying runtime base and
// `u64` length. Domain evidence states its grant, address space, rights,
// provenance, and lifetime/era. Reconstructing the geometry does not establish
// those facts.
//
// The value is linear because losing an owned range may lose reclamation
// debt or another exclusive authority. Zero-filled storage does not establish
// an `Extent`; APIs that need an honest zero/empty state use `ExtentSlot`.
//
use omega::language::core::content;
use omega::language::core::device;
use omega::language::core::nat;

pub data Extent [linear] {
    base: addr;
    length: u64;
}

// Settled dormant-content state vocabulary. These qualifications carry no
// runtime payload: `Vacant` names an exact range with no live resident value,
// while `Resident<P, T>` retains the invariant normalized placement-policy and
// semantic-value identities for one complete live value. Placement operations
// and custody checking are intentionally not declared in this milestone.
pub domain Extent::Vacant;
pub domain<P, T> Extent::Resident<P, T>;

// Geometry is a transparent mathematical predicate. The endpoint lives in
// unbounded proof Int, so a one-past endpoint may equal the exclusive bound
// without becoming an address or narrowing the independent u64 count.
// A bodyless boundary machine cannot substitute for this predicate: it would
// turn every Granted fact into a runtime observation, not a proof formula.
pub let no_wrap(base: addr, length: u64): core::Strict<0> =
    embed(base) + embed(length) <= addr::Bound;

// `Granted` is authority evidence, not a structural invariant. Constructing
// the geometry above does not establish it; checked transformations must
// conserve an existing claim and admitted roots must inherit the exact
// owner-authored boundary requirement.
pub domain Extent::Granted(extent)
requires
    no_wrap(extent.base, extent.length)
established by
    ExtentRootProvider::grant,
    ProgramStorageEntry::enter,
    DeviceLoanProvider::reserve,
    DeviceLoanProvider::acquire;

// One stable semantic entry requirement owns the loader-provisioned image and
// initial-storage roots. The active physical entry stack remains a separate
// execution resource. A target profile composes its separate physical
// arrival contract with this exact semantic requirement; target ABI inputs do
// not extend or refine this parameter list. Installation introduces these
// parameter occurrences. An ordinary call merely supplies their Granted
// preconditions and cannot mint either fact.
pub boundary trait ProgramStorageEntry {
    machine enter(
        image: Extent in Granted,
        initial_storage: Extent in Granted
    );
}

// Explicitly selected transport to this artifact's Build-bound continuation.
// This call forwards two existing grants; it cannot introduce either root or
// choose a continuation by spelling. The native bridge retains Build custody.
pub data ProgramStorageEntryNativeProvider {}
pub uefi_x86_64 boundary machine ProgramStorageEntryNativeProvider::enter(
    image: Extent in Granted,
    initial_storage: Extent in Granted
) satisfies ProgramStorageEntry::enter;

// `Granted` owns one canonical half-open address interval. Runtime address
// arithmetic must not define the one-past end: fixed-width values first embed
// into proof Int, and their derived nonnegativity permits exact conversion to
// these proof-Nat coordinates. Nat retains an end equal to the address-space
// bound even when `addr` cannot represent it. Both conversions remain visible:
// embedding selects the uniform proof-Int meaning, while `as Nat` consumes its
// derived nonnegative range fact at the content-algebra boundary.
pub machine Granted::content(extent: &Extent) -> IntervalSet<Nat>
satisfies Content<Extent, IntervalSet<Nat>>::project
{
    IntervalSet {
        start: embed(extent.base) as Nat,
        end: (embed(extent.base) + embed(extent.length)) as Nat
    }
}

// The domain owner authorizes exactly this admitted root crossing. The caller
// supplies ordinary geometry; the selected provider plan and its admission
// receipt are what establish `Granted` on the returned carrier. One call
// yields one root claim. Backing containment and richer space/rights facts join
// the same receipt as the resource-frontier implementation lands.
pub boundary trait ExtentRootProvider {
    machine grant(root: Extent) -> Extent
    ensures
        result in Extent::Granted;
}

data ExtentSlot {
    case Empty;
    case Live(extent: Extent);
}
