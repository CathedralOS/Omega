// LAYOUT POLICIES (wiki/spec/layouts/plans.md):
// Layout is a library, not a language axiom. A policy is an ordinary named
// implementation of `FixedLayout<T>`. Its exact `plan(schema, target)` call
// runs through semantic-evaluation admission with no effects and a termination
// guarantee. The compiler supplies the exact `Schema` and immutable target,
// validates the returned `LayoutPlan` (a bad plan is a compile error, never
// unsafety), and derives codecs / projections / value types from it.
//
// v1 SHAPES: plan entries carry compiler-issued field keys rather than using
// array position as identity. Repeating a key permits fragmented placement of
// one logical source. Keys are opaque handles copied from SchemaField; the
// compiler normalizes them back to field names before identity/reporting.
//
// COUNT CARRIERS: nonnegative byte sizes, alignments, offsets, widths, counts,
// indices, tags, and opaque compiler keys use u64, distinct from addr. Signed
// carriers remain only where a value is genuinely signed or an explicitly
// retained sentinel requires one.

use omega::language::core::option;
use omega::language::core::extent;

// One field of a schema, target-resolved by the compiler: byte size,
// alignment, shape, and declared identity (-1 in the numeric mirror when
// unnumbered). Recursively nested fixed arrays composed of supported primitive
// elements are one Repeated field. Byte sizes retain their full u64 range;
// allocation and placement consumers check their own geometry. The compiler
// supplies established fields by value, including valid inactive-tail placeholders; zeroed storage
// alone does not establish a SchemaField.
public data SchemaField where align >= 1, align <= 16 {
    key: u64;
    size: u64;
    align: u64;
    identity: Optional<u64>;
    // Transitional compatibility mirror; -1 means unnumbered. New policies
    // consume `identity`.
    number: i64;
    kind: FieldKind;
}

// A schema: numbered fields follow stable identity order; unnumbered fields
// follow declaration order. At most
// 32 fields in the pilot slice (plan validation rejects more).
// A schema field's SHAPE fact -- what a grammar policy needs to choose a
// placement (a scalar varint-encodes; text/nested/repeated payloads are
// length-prefixed). ZII: the zero case is Scalar.
public data FieldKind {
    case Scalar;
    case Text;
    case Nested;
    case Repeated;
}

// One reflected sum case. Stable identity is schema metadata; declaration
// position remains the independent home-layout discriminant. Payload fields
// have their own numbered scope and tombstones.
public data SchemaCase where payload_field_count <= 32, retired_payload_identity_count <= 32 {
    key: u64;
    identity: Optional<u64>;
    payload_fields: [SchemaField; 32];
    payload_field_count: u64;
    retired_payload_identities: [u64; 32];
    retired_payload_identity_count: u64;
}

public data Schema where field_count <= 32, retired_field_identity_count <= 32,
    case_count <= 32, retired_case_identity_count <= 32 {
    fields: [SchemaField; 32];
    field_count: u64;
    retired_field_identities: [u64; 32];
    retired_field_identity_count: u64;
    cases: [SchemaCase; 32];
    case_count: u64;
    retired_case_identities: [u64; 32];
    retired_case_identity_count: u64;
}

// One field's REPRESENTATION -- the closed vocabulary the compiler knows how to
// read and lower (wiki/spec/layouts/plans.md). Policies CHOOSE representations from
// this sum; a new representation KIND is a compiler release, never user-invented.
// The validator walks `At`, `Bits`, and `IntegerAt`. `stored_width` is a bit
// width; `offset` remains byte-denominated. `At` or a complete repeated `Bits`
// tiling has live direct plan-laid projection. A fixed primitive array admits
// one whole-extent `At`, not scalar `Bits` or `IntegerAt`. `IntegerAt` is normalized for
// consumers and is the only fixed-layout spelling for a foreign integer whose
// stored width differs from its semantic carrier. Direct owned/reference-backed
// and runtime-indexed projection widen according to `interpretation`. Direct
// stable-owned mutation is live when the compiler derives total-write evidence;
// read-only interpreter record views use the same decode. Concrete proved-fit
// mutation remains fail-closed. Tagged/wire placements remain consumers of the
// wire-plan path today.
public data IntegerInterpretation {
    case Signed;
    case Unsigned;
}

public data FieldPlan {
    case At(offset: u64);
    case IntegerAt(
        offset: u64,
        stored_width: u64,
        interpretation: IntegerInterpretation
    );
    case Bits(
        container: u64,
        container_width: u64,
        destination_lsb: u64,
        source_lsb: u64,
        width: u64
    );
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}

public data FieldEntry {
    key: u64;
    representation: FieldPlan;
}

// A validated layout plan. Entries may appear in any order; `key` names
// the schema field and may repeat only for `Bits` fragments. Positions past
// `entry_count` are meaningless. The compiler checks field coverage, exact
// source tiling for fragments, destination bounds/overlap, and fixed-plan
// size/alignment before anything trusts the plan. Native layout evaluation
// retains a compiler-private demand catalog beside this semantic value; each
// entry comes from an executed `LayoutPlan::place_private` call citing one exact
// named `PrivateCallbackSlot<T, Layout, Requirement>` implementation. Neither raw
// slot identities nor callback addresses enter this record.
public data LayoutPlan {
    entries: [FieldEntry; 64];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}

// Compiler-known relationship for one semantic-field-free native slot.
// `Layout` is the selected fixed-layout implementation whose plan may place the slot;
// the machine argument is an exact signature-free callback requirement. A
// named implementation such as
// `CallbackSlot satisfies PrivateCallbackSlot<Record, Spread, Callback::call> { }` is
// inert until that layout policy explicitly cites it through
// `LayoutPlan::place_private<Implementation>`; another policy cannot place it. A
// callback occupying a whole foreign ABI parameter is instead declared once in
// its registrar requirement's native telescope; it is not a layout slot and
// does not use this relationship.
public trait PrivateCallbackSlot<T, Layout satisfies FixedLayout<T>, machine Requirement> {
}

// The ordinary value signature is an identity operation so helpers can compose
// plans without exposing a private field in `LayoutPlan`. The one authored static
// argument is sealed compiler metadata, not a generic parameter of this
// machine: typed lowering records the exact conformance separately and build-
// time evaluation emits a private-placement receipt while returning `plan`
// unchanged. Runtime code receives no slot identity or callback address.
public machine LayoutPlan::place_private(plan: LayoutPlan, offset: u64) -> LayoutPlan {
    plan
}

// Access-policy vocabulary (wiki/spec/resources/access.md). `LayoutPlan` owns
// representation and geometry with no access rights; `AccessPlan` contains one
// `LayoutPlan`, per-field operation decisions and required boundary reach.
// These records are ordinary library data: the compiler evaluates policy
// machines and independently validates their returned values, but source code
// cannot construct lowering authority from the records alone.

public data Exposure {
    case Exported;
    case BindingPrivate;
}

public data Observation {
    case Stable;
    case External;
    case Atomic;
}

public data ExternalRead {
    case None;
    case Read;
    case Take;
}

// Closed runtime results for the atomic compare/exchange permission family.
// These are ordinary flat core data, not requirements: T alone determines
// their runtime shape.  Comparison keys and selected encoding laws remain
// checked call evidence and therefore never parameterize these carriers.
// Declaration order is the canonical wire/runtime tag order: expected
// failure first, committed success second, and an uncommitted single attempt
// third only where that state exists.
public data AtomicCompareExchangeOutcome<T> {
    case Mismatched(observed: T);
    case Exchanged;
}

public data AtomicCompareExchangeOnceOutcome<T [copy]> [copy] {
    case Mismatched(observed: T);
    case Exchanged;
    case Uncommitted(observed: T);
}

public data AtomicTryExchangeOutcome<T> {
    case Mismatched(proposed: T);
    case Exchanged(displaced: T);
}

public data AtomicTryExchangeOnceOutcome<T> {
    case Mismatched(proposed: T);
    case Exchanged(displaced: T);
    case Uncommitted(proposed: T);
}

public data AtomicOperations [copy] {
    load: bool;
    store: bool;
    fetch_add: bool;
    fetch_sub: bool;
    fetch_xor: bool;
    fetch_or: bool;
    fetch_and: bool;
    swap: bool;
    compare_exchange: bool;
    compare_exchange_once: bool;
    try_exchange: bool;
    try_exchange_once: bool;
}

// Transfer width and alignment are byte-count facts. Access authors do not
// choose offsets; validated layout geometry supplies those.
public data TransferRule [copy] {
    width_bits: u64;
    alignment_bytes: u64;
}

// Invalid observation/operation cross-products are unrepresentable. The
// effective transfer rule comes from the validated layout/resource join.
public data FieldAccess {
    case Inaccessible;
    case Stable(
        read: bool,
        write: bool,
        exposure: Exposure
    );
    case External(
        read: ExternalRead,
        write: bool,
        exposure: Exposure
    );
    case Atomic(
        operations: AtomicOperations,
        exposure: Exposure
    );
}

public data AccessFieldEntry {
    key: u64;
    access: FieldAccess;
}

// A normalized static set of boundary-service keys. Suspension and blocking
// are independent contract axes and never enter this record.
public data BoundaryReach where service_count <= 32 {
    services: [u64; 32];
    service_count: u64;
}

// One access plan contains its layout plan, exactly one decision per
// runtime-relevant schema field, and the static boundary reach its admitted
// operations require. Fixed capacity is a bootstrap carrier only: the compiler
// requires exactly `field_count` canonical schema decisions and ignores the
// zero tail. Constructing this record grants no reach, backing or authority.
public data AccessPlan where field_count <= 32 {
    layout: LayoutPlan;
    fields: [AccessFieldEntry; 32];
    field_count: u64;
    reach: BoundaryReach;
}

// The inaccessible seed is the only source constructor for a fresh access
// decision set. It retains the supplied layout, starts with empty required
// reach, and seeds one inaccessible decision for each distinct schema-field
// key appearing in the layout's entries, so several fragments of one field
// seed one decision and erased bindings (which have no entries) seed none.
// The seed observes keys only; the compiler's final validator independently
// requires complete schema coverage, so a field omitted by both the layout
// and this seed is rejected rather than silently absent.
public machine AccessPlan::inaccessible(layout: LayoutPlan) -> AccessPlan {
    let mut fields: [AccessFieldEntry; 32];
    let mut reach: BoundaryReach;
    AccessPlan::seed_bounded(
        AccessPlan { layout: layout, fields: fields, field_count: 0, reach: reach },
        0,
        4096
    )
}

// The helper makes the finite entry walk's ordinary termination witness
// explicit. Fuel is library policy, not part of the public access-plan
// surface; 64 entries times a 32-slot duplicate search never exhausts it, and
// an exhausted walk returns the partial seed for final validation to reject.
machine AccessPlan::seed_bounded(plan: AccessPlan, index: u64, fuel: u64) -> AccessPlan
terminates by fuel;
requires index <= 64 && fuel >= 1 && fuel <= 4096
{
    transition { _ -> seed(plan, index, fuel) }

    machine seed(plan: AccessPlan, index: u64, fuel: u64) -> AccessPlan
    requires index <= 64 && fuel >= 1 && fuel <= 4096
    {
        transition fuel > 1 && index < plan.layout.entry_count && index < 64 {
            true -> examine(plan, index, fuel - 1)
            _ -> (plan)
        }
    }

    machine examine(plan: AccessPlan, index: u64, fuel: u64) -> AccessPlan
    requires index <= 63 && fuel >= 1 && fuel <= 4096
    {
        let key: u64 = plan.layout.entries[index].key;
        transition { _ -> search(plan, index, key, 0, fuel) }
    }

    machine search(
        plan: AccessPlan,
        index: u64,
        key: u64,
        slot: u64,
        fuel: u64
    ) -> AccessPlan
    requires index <= 63 && slot <= 32 && fuel >= 1 && fuel <= 4096
    {
        let field_count: u64 = plan.field_count;
        transition {
            fuel > 1 && slot < field_count && slot < 32 -> compare(plan, index, key, slot, fuel - 1)
            fuel > 1 && field_count < 32 -> append(plan, index, key, field_count, fuel - 1)
            _ -> (plan)
        }
    }

    machine compare(
        plan: AccessPlan,
        index: u64,
        key: u64,
        slot: u64,
        fuel: u64
    ) -> AccessPlan
    requires index <= 63 && slot <= 31 && fuel >= 1 && fuel <= 4096
    {
        transition {
            fuel > 1 && plan.fields[slot].key == key -> seed(plan, index + 1, fuel - 1)
            fuel > 1 -> search(plan, index, key, slot + 1, fuel - 1)
            _ -> (plan)
        }
    }

    machine append(
        plan: AccessPlan,
        index: u64,
        key: u64,
        field_count: u64,
        fuel: u64
    ) -> AccessPlan
    requires index <= 63 && field_count <= 31 && fuel >= 1 && fuel <= 4096
    {
        let mut updated: AccessPlan = plan;
        updated.fields[field_count] = AccessFieldEntry { key: key, access: FieldAccess::Inaccessible };
        updated.field_count = field_count + 1;
        transition { _ -> seed(updated, index + 1, fuel) }
    }
}

// Functional replacement keeps policy construction expression-oriented. It
// changes the decision for an existing key; it does not authorize an unknown
// field. A key outside the seed is deliberately retained as an extra entry so
// compiler validation rejects it rather than silently ignoring an authored
// mistake.
public machine AccessPlan::with(plan: AccessPlan, key: u64, access: FieldAccess) -> AccessPlan {
    AccessPlan::with_bounded(plan, key, access, 128)
}

// Required static boundary reach for the plan's admitted operations. Naming a
// service here demands it; it never grants reach or edits a machine's reach row.
public machine AccessPlan::with_reach(plan: AccessPlan, reach: BoundaryReach) -> AccessPlan {
    let mut updated: AccessPlan = plan;
    updated.reach = reach;
    updated
}

// The helper makes the finite search's ordinary termination witness explicit.
// Fuel is compiler/library policy, not part of the public access-plan surface.
machine AccessPlan::with_bounded(
    plan: AccessPlan,
    key: u64,
    access: FieldAccess,
    fuel: u64
) -> AccessPlan
terminates by fuel;
requires fuel >= 1 && fuel <= 128
{
    transition { _ -> seek(plan, key, access, 0, fuel) }

    machine seek(
        plan: AccessPlan,
        key: u64,
        access: FieldAccess,
        index: u64,
        fuel: u64
    ) -> AccessPlan
    requires index <= 32 && fuel >= 1 && fuel <= 128
    {
        transition fuel > 1 && index < plan.field_count && index < 32 {
            true -> inspect(plan, key, access, index, fuel - 1)
            _ -> invalid(plan, key, access)
        }
    }

    machine inspect(
        plan: AccessPlan,
        key: u64,
        access: FieldAccess,
        index: u64,
        fuel: u64
    ) -> AccessPlan
    requires index <= 31 && fuel >= 1 && fuel <= 128
    {
        transition {
            fuel > 1 && plan.fields[index].key == key -> replace(plan, key, access, index)
            fuel > 1 -> advance(plan, key, access, index, fuel - 1)
            _ -> invalid(plan, key, access)
        }
    }

    machine replace(
        plan: AccessPlan,
        key: u64,
        access: FieldAccess,
        index: u64
    ) -> AccessPlan
    requires index <= 31
    {
        let mut updated: AccessPlan = plan;
        updated.fields[index] = AccessFieldEntry { key: key, access: access };
        updated
    }

    machine advance(
        plan: AccessPlan,
        key: u64,
        access: FieldAccess,
        index: u64,
        fuel: u64
    ) -> AccessPlan
    requires index <= 31 && fuel >= 1 && fuel <= 128
    {
        transition fuel > 1 {
            true -> seek(plan, key, access, index + 1, fuel - 1)
            _ -> invalid(plan, key, access)
        }
    }

    machine invalid(
        plan: AccessPlan,
        key: u64,
        access: FieldAccess
    ) -> AccessPlan {
        let mut rejected: AccessPlan = plan;
        rejected.fields[0] = AccessFieldEntry { key: key, access: access };
        let field_count: u64 = rejected.field_count;
        transition field_count < 32 {
            true -> grow_invalid(rejected, field_count)
            _ -> (rejected)
        }
    }

    machine grow_invalid(
        plan: AccessPlan,
        field_count: u64
    ) -> AccessPlan
    requires field_count <= 31
    {
        let mut rejected: AccessPlan = plan;
        rejected.field_count = field_count + 1;
        rejected
    }
}

public data RelativeRange [copy] {
    offset: u64;
    length: u64;
}

public data StableCapability {
    case None;
    case Read;
    case Write;
    case ReadWrite;
}

public data ExternalReadBehavior {
    case None;
    case Repeatable;
    case Destructive;
}

public data TransferRules where rule_count <= 16 {
    entries: [TransferRule; 16];
    rule_count: u64;
}

public data ExternalCapability {
    case None;
    case Access(
        read: ExternalReadBehavior,
        write: bool,
        transfers: TransferRules
    );
}

public data AtomicTransferRule {
    transfer: TransferRule;
    operations: AtomicOperations;
}

public data AtomicTransferRules where rule_count <= 16 {
    entries: [AtomicTransferRule; 16];
    rule_count: u64;
}

public data AtomicCapability {
    case None;
    case Access(transfers: AtomicTransferRules);
}

// This is an admitted backing property, not a claim that borrowing a value
// excludes a device or another process. A hostile writable peer forbids Stable
// supply even when the caller holds an exclusive Omega borrow. Revocation and
// cross-core invalidation belong to the provider before it offers Exclusive.
public data PeerWritability {
    case Exclusive;
    case HostileShared;
}

public data ResourceRegion {
    range: RelativeRange;
    peer: PeerWritability;
    stable: StableCapability;
    external: ExternalCapability;
    atomic: AtomicCapability;
    reach: BoundaryReach;
}

public data ResourceProfile where region_count <= 32 {
    regions: [ResourceRegion; 32];
    region_count: u64;
}

// A selected provider describes supply for this existing grant through an
// ordinary boundary call. The returned data alone is not placement authority:
// an establishing consumer must bind the successful invocation and its complete
// normalized result to the original qualified range. Copying or changing a
// profile, or calling an implementation directly, establishes nothing. This
// requirement supplies neither vacancy nor already initialized content. Role
// distinguishes independently selected backing policies in one artifact. It is
// a static selector, not evidence of that backing or permission to access it.
public boundary trait ResourceProfileSupply<Role> {
    machine profile(storage: &Extent in Granted) -> ResourceProfile reaches;
}

// Settled access-view identity and recovery vocabulary. `Access<P, T>` is an
// opaque compiler-derived view of `T` under access policy `P`; it narrows and
// never grants. These ordinary result carriers add no access, storage,
// provider, or domain authority. Declaration order is the canonical runtime
// tag and payload order. Resident content remains owned by its exact qualified
// Extent; a borrowed access view retains only a loan of that owner.
public boundary data Access<P, T>;

// Borrowed View over already initialized ordinary RAM. The compiler checks the
// exact applied P/T geometry and content relation and retains the original
// source loan. Neither declaration supplies an extent, device capability,
// resource profile or stronger access than the source borrow.
public boundary machine Access::view<P, T>(source: &T) -> &Access<P, T>;
public boundary machine Access::view_mut<P, T>(source: &mut T) -> &mut Access<P, T>;

// This view interprets existing resident content rather than the Extent's two
// geometry fields. It retains the exact P/T claim, backing and profile receipt;
// ending the view releases its loan, not the resident or its storage grant.
public boundary machine Access::view_resident_mut<P, T>(
    storage: &mut Extent in Granted & Resident<P, T>
) -> &mut Access<P, T>;

public data AccessOutcome<View, Returned, Reason> {
    case Ready(view: View);
    case Rejected(returned: Returned, reason: Reason);
}

public data AccessReturn<Source, Custody> {
    source: Source;
    custody: Custody;
}

// A borrowed view moves no storage into the operation. Rejection releases its
// loan; this ordinary empty record carries no grant or content qualification.
public data AccessBorrowReturn {}

// View already-established external content without manufacturing Resident or
// Vacant. The selected call supplies compatibility for this exact qualified
// range, while the result retains the original storage loan. A numeric address
// or a constructed ResourceProfile is not a substitute for either input.
public machine Access::view_extent<'storage, P, T, Role>(
    storage: &'storage Extent in Granted
) -> AccessOutcome<
    &'storage Access<P, T>, AccessBorrowReturn, AccessInitializationFailure
>
reaches ResourceProfileSupply
invokes ResourceProfileSupply;
{
    let profile: ResourceProfile = ResourceProfileSupply<Role>::profile(storage);
    Access::view_from_profile<P, T, Role>(storage, &profile)
}

boundary machine Access::view_from_profile<'storage, P, T, Role>(
    storage: &'storage Extent in Granted,
    profile: &ResourceProfile
) -> AccessOutcome<
    &'storage Access<P, T>, AccessBorrowReturn, AccessInitializationFailure
>;

// The exclusive counterpart carries the same interpretation and original
// profile occurrence. Its reference ceiling, not a second lifecycle or a
// geometry-based permission, allows the placement's admitted writes.
public machine Access::view_extent_mut<'storage, P, T, Role>(
    storage: &'storage mut Extent in Granted
) -> AccessOutcome<
    &'storage mut Access<P, T>, AccessBorrowReturn, AccessInitializationFailure
>
reaches ResourceProfileSupply
invokes ResourceProfileSupply;
{
    let profile: ResourceProfile = ResourceProfileSupply<Role>::profile(storage);
    Access::view_mut_from_profile<P, T, Role>(storage, &profile)
}

boundary machine Access::view_mut_from_profile<'storage, P, T, Role>(
    storage: &'storage mut Extent in Granted,
    profile: &ResourceProfile
) -> AccessOutcome<
    &'storage mut Access<P, T>, AccessBorrowReturn, AccessInitializationFailure
>;

// Dynamic incompatibility is ordinary data. Malformed admitted assertions,
// physical faults and missing static custody are not recoverable cases here.
public data AccessInitializationFailure {
    case RangeTooSmall(required: u64, available: u64);
    case Misaligned(modulus: u64, residue: u64);
    case IncompatibleSupply;
}

// A successful extraction has a selected owned case, so the boundary's exact
// storage payload is the vacancy issuance subject. The public wrapper below
// forwards that evidence into AccessReturn; it is not another issuer.
public data AccessExtraction<Storage, Value> {
    case Moved(storage: Storage, value: Value);
}

// These requirements describe actual execution, not a source-level cast or
// permission granted by a result annotation. The selected implementation must
// retain the original backing/profile occurrence and complete every write or
// move before publishing the corresponding case. An ordinary call to a provider
// implementation is not the admitted requirement occurrence named by Extent's
// protected establishment routes.
public boundary trait AccessLifecycle<P, T> {
    machine initialize(
        storage: Extent in Granted & Vacant,
        value: T
    ) -> AccessOutcome<
        Extent in Granted & Resident<P, T>,
        AccessReturn<Extent in Granted & Vacant, T>,
        AccessInitializationFailure
    >
    reaches ResourceProfileSupply;

    machine move_out(storage: Extent in Granted & Resident<P, T>)
        -> AccessExtraction<Extent in Granted & Vacant, T>
    reaches ResourceProfileSupply;
}

// Ordinary provider orchestration keeps profile selection, call ordering and
// ownership transport in the language. The private primitives are the memory
// operations, not substitutes for the selected profile invocation. Their
// realization must join the completed call to this exact storage and complete
// result before treating the profile as admitted supply. The private operation
// borrows that result: passing plain profile data by value would make an
// independent copy, which carries no selected-call origin.
public NativeAccess<P, T, Role> satisfies AccessLifecycle<P, T> {
    machine initialize(
        storage: Extent in Granted & Vacant,
        value: T
    ) -> AccessOutcome<
        Extent in Granted & Resident<P, T>,
        AccessReturn<Extent in Granted & Vacant, T>,
        AccessInitializationFailure
    >
    reaches ResourceProfileSupply
    {
        let profile: ResourceProfile = ResourceProfileSupply<Role>::profile(
            &storage as &Extent in Granted
        );
        Access::initialize_from_profile<P, T, Role>(storage, value, &profile)
    }

    machine move_out(storage: Extent in Granted & Resident<P, T>)
        -> AccessExtraction<Extent in Granted & Vacant, T>
    reaches ResourceProfileSupply
    {
        // Resident preserves the value and backing, not permission to read
        // every byte. Reobserve the same grant's admitted supply before decode.
        let profile: ResourceProfile = ResourceProfileSupply<Role>::profile(
            &storage as &Extent in Granted
        );
        Access::extract_resident<P, T, Role>(storage, &profile)
    }
}

// These exact private machines are explicit content-establishment routes.
// Privacy supplies no profile or backing authority: compiler realization still
// requires the exact admitted call, live claim and actual allocation. They
// cannot interpret a constructed profile or an Extent's descriptor as bytes.
boundary machine Access::initialize_from_profile<P, T, Role>(
    storage: Extent in Granted & Vacant,
    value: T,
    profile: &ResourceProfile
) -> AccessOutcome<
    Extent in Granted & Resident<P, T>,
    AccessReturn<Extent in Granted & Vacant, T>,
    AccessInitializationFailure
>;

boundary machine Access::extract_resident<P, T, Role>(
    storage: Extent in Granted & Resident<P, T>,
    profile: &ResourceProfile
) -> AccessExtraction<Extent in Granted & Vacant, T>;

// The owned operation captures both inputs before its ordinary selected supply
// call. Ready retains the original range and the complete value's custody;
// rejection returns both unchanged. Only an executed complete encoding write
// can establish resident content. The compiler's lifecycle operation, not a
// caller-provided profile or the return annotation, discharges that obligation.
public machine Access::initialize_owned<P, T>(
    storage: Extent in Granted & Vacant,
    value: T
) -> AccessOutcome<
    Extent in Granted & Resident<P, T>,
    AccessReturn<Extent in Granted & Vacant, T>,
    AccessInitializationFailure
>
reaches AccessLifecycle + ResourceProfileSupply
invokes AccessLifecycle;
{
    AccessLifecycle<P, T>::initialize(storage, value)
}

// Whole-value extraction ends this exact resident occurrence. Active loans or
// unresolved partial moves forbid it; success returns the owned value and the
// original storage with vacancy restored, rather than a new numeric root.
public machine Access::move_out_owned<P, T>(
    storage: Extent in Granted & Resident<P, T>
)
    -> AccessReturn<Extent in Granted & Vacant, T>
reaches AccessLifecycle + ResourceProfileSupply
invokes AccessLifecycle;
{
    transition AccessLifecycle<P, T>::move_out(storage) {
        AccessExtraction::Moved { storage, value } ->
            AccessReturn { source: storage, custody: value }
    }
}

// `C` is the authored custody record for the non-runtime fields of `T` under
// access policy `P`; a named implementation of this exact application is the
// agreement the compiler checks. The custody record is an ordinary argument,
// never a subject that owns the implementation.
public trait AccessCustody<C, P, T> {
}

// Granular accessor requirements. These are ordinary generic contracts so
// helpers can accept one accessor without receiving the whole access view.
// The compiler derives conforming accessor types from a normalized access plan;
// source cannot construct the opaque template or use it as access evidence.
public trait Readable<Field, T> {
    machine read(accessor: &Field) -> T;
}

public trait DestructiveRead<Field, T> {
    machine take(accessor: &mut Field) -> T;
}

public trait Writable<Field, T> {
    machine write(accessor: &mut Field, value: T);
}

// Exact compiler-supplied primitives, not blanket conformance evidence. The
// compiler closes these applications only for a field accessor issued by the
// selected access plan, with its exact value type and operation permission.
// Ordinary generic helpers must declare an explicit operation requirement;
// an unconstrained type parameter cannot acquire field access by forwarding.
public boundary machine read<Accessor, Value>(field: &Accessor) -> Value
satisfies Readable<Accessor, Value>::read;
public boundary machine write<Accessor, Value>(field: &mut Accessor, value: Value)
satisfies Writable<Accessor, Value>::write;

public boundary data Accessor<T>;

boundary machine Accessor::read<T>(accessor: &Accessor<T>) -> T
satisfies Readable<Accessor<T>, T>::read;

boundary machine Accessor::take<T>(accessor: &mut Accessor<T>) -> T
satisfies DestructiveRead<Accessor<T>, T>::take;

boundary machine Accessor::write<T>(accessor: &mut Accessor<T>, value: T)
satisfies Writable<Accessor<T>, T>::write;

// The policy interface. plan() declares no effects, so implementations HAVE
// none -- that absence is what makes them build-time-evaluable.
// Compiler-issued immutable representation facts for this exact target.
// Authored code cannot construct this opaque compile-time input or gain
// host services, private source access, storage backing or execution authority.
public boundary data LayoutTarget;

// An immutable borrowed snapshot of the compiler-issued policy context.
// The context has no authored constructor or executable storage representation.
public data LayoutTargetFacts<'target> [copy] {
    profile: &'target [u8];
    pointer_size: u64;
    pointer_alignment: u64;
    little_endian: bool;
}

// Semantic evaluation supplies the exact issuer's snapshot. This ordinary
// primitive declaration exposes its checked result shape; it grants no target,
// storage or Build authority to an authored value.
public boundary machine layout_target_facts<'target>(target: &'target LayoutTarget)
    -> LayoutTargetFacts<'target>
reaches
terminates;

// The compiler retains and validates the exact semantic type, policy,
// target and returned geometry; this adds no wrapper or independent T header.
public boundary data LayoutStorage<T, Policy satisfies FixedLayout<T>>;

public trait FixedLayout<T> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan
    reaches
    terminates;
}

// An access policy evaluates one complete `AccessPlan` from the reflected
// schema. It may call ordinary layout policies and helpers; such a call returns
// plan data, not a validation certificate. The compiler independently validates
// layout, field coverage, operations and reach of the returned plan.
public trait AccessPolicy {
    machine plan(schema: Schema) -> AccessPlan;
}
