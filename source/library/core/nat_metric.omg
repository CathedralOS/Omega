use {omega}/language/core/foundation.omg as proof;
use nat.omg;

// Absolute difference and order lemmas over core Nat. This is the metric
// substrate used by Rat's denominator-scaled triangle proof: all order facts
// retain Nat's settled monus spelling (`a <= b` iff `saturating_sub(a, b) == Zero`).

machine nat_gap(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat {
    let forward: |nat|::Nat = |nat|::saturating_sub(a, b);
    let backward: |nat|::Nat = |nat|::saturating_sub(b, a);
    let gap: |nat|::Nat = |nat|::add(forward, backward);
    transition { _ -> (gap) }
}

machine nat_gap_reflexive(a: |nat|::Nat)
ensures
    |proof|::Identity::<|nat|::Nat>(nat_gap(a, a), |nat|::Nat::Zero)
{
    _ = |nat|::sub_self(a);
    _ = |nat|::add_zero_left(|nat|::Nat::Zero);
}

machine nat_gap_symmetric(a: |nat|::Nat, b: |nat|::Nat)
ensures
    |proof|::Identity::<|nat|::Nat>(nat_gap(a, b), nat_gap(b, a))
{
    |nat|::add_comm(|nat|::saturating_sub(a, b), |nat|::saturating_sub(b, a));
}

machine nat_gap_zero_left(b: |nat|::Nat)
ensures
    |proof|::Identity::<|nat|::Nat>(nat_gap(|nat|::Nat::Zero, b), b)
{
    _ = |nat|::sub_zero_left(b);
    _ = |nat|::sub_zero_right(b);
    _ = |nat|::add_zero_left(b);
}

machine nat_gap_zero_right(a: |nat|::Nat)
ensures
    |proof|::Identity::<|nat|::Nat>(nat_gap(a, |nat|::Nat::Zero), a)
{
    _ = |nat|::sub_zero_right(a);
    _ = |nat|::sub_zero_left(a);
    |nat|::add_zero_right(a);
}

machine nat_gap_succ(a: |nat|::Nat, b: |nat|::Nat)
ensures
    |proof|::Identity::<|nat|::Nat>(nat_gap(|nat|::Nat::Succ { prev: a }, |nat|::Nat::Succ { prev: b }), nat_gap(a, b))
{
    _ = |nat|::succ_sub_succ(a, b);
    _ = |nat|::succ_sub_succ(b, a);
}

machine add_le_add_right(a: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat
terminates by c
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(a, b), |nat|::Nat::Zero)
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::add(a, c), |nat|::add(b, c)), |nat|::Nat::Zero)
{
    transition c {
        |nat|::Nat::Zero -> alar_zero(a, b),
        |nat|::Nat::Succ { prev } -> alar_succ(a, b, prev)
    }

    machine alar_zero(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat {
        |nat|::add_zero_right(a);
        |nat|::add_zero_right(b);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine alar_succ(a: |nat|::Nat, b: |nat|::Nat, prev: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::add_succ_law(a, prev);
        _ = |nat|::add_succ_law(b, prev);
        _ = |nat|::succ_sub_succ(|nat|::add(a, prev), |nat|::add(b, prev));
        transition { _ -> (add_le_add_right(a, b, prev)) }
    }
}

machine le_trans(a: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat
terminates by a
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(a, b), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(b, c), |nat|::Nat::Zero)
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(a, c), |nat|::Nat::Zero)
{
    transition a {
        |nat|::Nat::Zero -> le_trans_zero(c),
        |nat|::Nat::Succ { prev as pa } -> le_trans_a_succ(pa, b, c)
    }

    machine le_trans_zero(c: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::sub_zero_left(c);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine le_trans_a_succ(pa: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat {
        transition b {
            |nat|::Nat::Zero -> le_trans_vacuous(),
            |nat|::Nat::Succ { prev as pb } -> le_trans_b_succ(pa, pb, c)
        }
    }

    machine le_trans_b_succ(pa: |nat|::Nat, pb: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat {
        transition c {
            |nat|::Nat::Zero -> le_trans_vacuous(),
            |nat|::Nat::Succ { prev as pc } -> le_trans_step(pa, pb, pc)
        }
    }

    machine le_trans_step(pa: |nat|::Nat, pb: |nat|::Nat, pc: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::succ_sub_succ(pa, pb);
        _ = |nat|::succ_sub_succ(pb, pc);
        _ = |nat|::succ_sub_succ(pa, pc);
        transition { _ -> (le_trans(pa, pb, pc)) }
    }

    machine le_trans_vacuous() -> |nat|::Nat {
        transition { _ -> |nat|::Nat::Zero }
    }
}

machine add_le_add(a: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat, d: |nat|::Nat)
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(a, b), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(c, d), |nat|::Nat::Zero)
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::add(a, c), |nat|::add(b, d)), |nat|::Nat::Zero)
{
    _ = add_le_add_right(a, b, c);
    |nat|::add_comm(c, b);
    |nat|::add_comm(d, b);
    _ = add_le_add_right(c, d, b);
    _ = le_trans(|nat|::add(a, c), |nat|::add(b, c), |nat|::add(b, d));
}

// Multiplication preserves monus order on the right.  The successor step
// combines the standing a <= b premise with the conditional induction
// hypothesis at the smaller multiplier, then transports both through add.
machine mul_le_mul_right(a: |nat|::Nat, b: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat
terminates by factor
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(a, b), |nat|::Nat::Zero)
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::mul(a, factor), |nat|::mul(b, factor)), |nat|::Nat::Zero)
{
    transition factor {
        |nat|::Nat::Zero -> mlmr_zero(a, b),
        |nat|::Nat::Succ { prev } -> mlmr_step(a, b, prev)
    }

    machine mlmr_zero(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::mul_zero_right(a);
        _ = |nat|::mul_zero_right(b);
        _ = |nat|::sub_self(|nat|::Nat::Zero);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine mlmr_step(a: |nat|::Nat, b: |nat|::Nat, prev: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::mul_succ_right(a, prev);
        _ = |nat|::mul_succ_right(b, prev);
        add_le_add(a, b, |nat|::mul(a, prev), |nat|::mul(b, prev));
        transition { _ -> (mul_le_mul_right(a, b, prev)) }
    }
}

// A positive common right factor reflects monus order.  The double-successor
// branch cancels the common additive prefix exposed by mul's recursion and
// applies the conditional induction hypothesis to the predecessor pair.
machine mul_le_cancel_right(a: |nat|::Nat, b: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat
terminates by a
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::Nat::Succ { prev: |nat|::Nat::Zero }, factor), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::mul(a, factor), |nat|::mul(b, factor)), |nat|::Nat::Zero)
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(a, b), |nat|::Nat::Zero)
{
    transition a {
        |nat|::Nat::Zero -> mlcr_a_zero(b, factor),
        |nat|::Nat::Succ { prev as pa } -> mlcr_a_succ(pa, b, factor)
    }

    machine mlcr_a_zero(b: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::sub_zero_left(b);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine mlcr_a_succ(pa: |nat|::Nat, b: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat {
        transition b {
            |nat|::Nat::Zero -> mlcr_b_zero(pa, factor),
            |nat|::Nat::Succ { prev as pb } -> mlcr_step(pa, pb, factor)
        }
    }

    machine mlcr_b_zero(pa: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat {
        transition factor {
            |nat|::Nat::Zero -> mlcr_vacuous(),
            |nat|::Nat::Succ { prev } -> mlcr_vacuous()
        }
    }

    machine mlcr_step(pa: |nat|::Nat, pb: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat {
        _ = sub_add_cancel_left(factor, |nat|::mul(pa, factor), |nat|::mul(pb, factor));
        _ = |nat|::succ_sub_succ(pa, pb);
        transition { _ -> (mul_le_cancel_right(pa, pb, factor)) }
    }

    machine mlcr_vacuous() -> |nat|::Nat {
        transition { _ -> |nat|::Nat::Zero }
    }
}

// Every b lies below a plus their absolute gap.
machine le_add_gap(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat
terminates by a
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(b, |nat|::add(a, nat_gap(a, b))), |nat|::Nat::Zero)
{
    transition a {
        |nat|::Nat::Zero -> lag_zero(b),
        |nat|::Nat::Succ { prev as pa } -> lag_a_succ(pa, b)
    }

    machine lag_zero(b: |nat|::Nat) -> |nat|::Nat {
        nat_gap_zero_left(b);
        _ = |nat|::sub_self(b);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine lag_a_succ(pa: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat {
        transition b {
            |nat|::Nat::Zero -> lag_b_zero(pa),
            |nat|::Nat::Succ { prev as pb } -> lag_step(pa, pb)
        }
    }

    machine lag_b_zero(pa: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::sub_zero_left(|nat|::add(|nat|::Nat::Succ { prev: pa }, nat_gap(|nat|::Nat::Succ { prev: pa }, |nat|::Nat::Zero)));
        transition { _ -> |nat|::Nat::Zero }
    }

    machine lag_step(pa: |nat|::Nat, pb: |nat|::Nat) -> |nat|::Nat {
        nat_gap_succ(pa, pb);
        _ = |nat|::succ_sub_succ(pb, |nat|::add(pa, nat_gap(pa, pb)));
        transition { _ -> (le_add_gap(pa, pb)) }
    }
}

// Absolute difference never exceeds the sum of its endpoints.
machine nat_gap_le_add(a: |nat|::Nat, b: |nat|::Nat)
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(nat_gap(a, b), |nat|::add(a, b)), |nat|::Nat::Zero)
{
    _ = |nat|::sub_le(a, b);
    _ = |nat|::sub_le(b, a);
    add_le_add(|nat|::saturating_sub(a, b), a, |nat|::saturating_sub(b, a), b);
}

machine nat_gap_triangle(a: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat
terminates by a
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(nat_gap(a, c), |nat|::add(nat_gap(a, b), nat_gap(b, c))), |nat|::Nat::Zero)
{
    transition a {
        |nat|::Nat::Zero -> ngt_a_zero(b, c),
        |nat|::Nat::Succ { prev as pa } -> ngt_a_succ(pa, b, c)
    }

    machine ngt_a_zero(b: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat {
        nat_gap_zero_left(c);
        nat_gap_zero_left(b);
        _ = le_add_gap(b, c);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine ngt_a_succ(pa: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat {
        transition b {
            |nat|::Nat::Zero -> ngt_b_zero(pa, c),
            |nat|::Nat::Succ { prev as pb } -> ngt_b_succ(pa, pb, c)
        }
    }

    machine ngt_b_zero(pa: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat {
        nat_gap_zero_right(|nat|::Nat::Succ { prev: pa });
        nat_gap_zero_left(c);
        nat_gap_le_add(|nat|::Nat::Succ { prev: pa }, c);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine ngt_b_succ(pa: |nat|::Nat, pb: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat {
        transition c {
            |nat|::Nat::Zero -> ngt_c_zero(pa, pb),
            |nat|::Nat::Succ { prev as pc } -> ngt_step(pa, pb, pc)
        }
    }

    machine ngt_c_zero(pa: |nat|::Nat, pb: |nat|::Nat) -> |nat|::Nat {
        nat_gap_zero_right(|nat|::Nat::Succ { prev: pa });
        nat_gap_zero_right(|nat|::Nat::Succ { prev: pb });
        nat_gap_symmetric(|nat|::Nat::Succ { prev: pa }, |nat|::Nat::Succ { prev: pb });
        _ = le_add_gap(|nat|::Nat::Succ { prev: pb }, |nat|::Nat::Succ { prev: pa });
        |nat|::add_comm(
            |nat|::Nat::Succ { prev: pb },
            nat_gap(|nat|::Nat::Succ { prev: pb }, |nat|::Nat::Succ { prev: pa })
        );
        transition { _ -> |nat|::Nat::Zero }
    }

    machine ngt_step(pa: |nat|::Nat, pb: |nat|::Nat, pc: |nat|::Nat) -> |nat|::Nat {
        nat_gap_succ(pa, pc);
        nat_gap_succ(pa, pb);
        nat_gap_succ(pb, pc);
        transition { _ -> (nat_gap_triangle(pa, pb, pc)) }
    }
}

// Adding the same prefix to both operands does not change monus. This is the
// cancellation step needed to scale absolute differences by multiplication.
machine sub_add_cancel_left(prefix: |nat|::Nat, a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat
terminates by prefix
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::add(prefix, a), |nat|::add(prefix, b)), |nat|::saturating_sub(a, b))
{
    transition prefix {
        |nat|::Nat::Zero -> sacl_zero(a, b),
        |nat|::Nat::Succ { prev } -> sacl_step(prev, a, b)
    }

    machine sacl_zero(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat {
        transition { _ -> |nat|::Nat::Zero }
    }

    machine sacl_step(prev: |nat|::Nat, a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::succ_sub_succ(|nat|::add(prev, a), |nat|::add(prev, b));
        transition { _ -> (sub_add_cancel_left(prev, a, b)) }
    }
}

// Translating both endpoints by the same Nat preserves their absolute gap.
// This bridges IntPair's nonnegative coordinates to Rat's public Nat metric.
machine nat_gap_add_common(prefix: |nat|::Nat, a: |nat|::Nat, b: |nat|::Nat)
ensures
    |proof|::Identity::<|nat|::Nat>(nat_gap(|nat|::add(prefix, a), |nat|::add(prefix, b)), nat_gap(a, b))
{
    _ = sub_add_cancel_left(prefix, a, b);
    _ = sub_add_cancel_left(prefix, b, a);
}

// Absolute difference is homogeneous under a shared Nat factor.
machine nat_gap_mul_right(a: |nat|::Nat, b: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat
terminates by a
ensures
    |proof|::Identity::<|nat|::Nat>(nat_gap(|nat|::mul(a, factor), |nat|::mul(b, factor)), |nat|::mul(nat_gap(a, b), factor))
{
    transition a {
        |nat|::Nat::Zero -> ngmr_a_zero(b, factor),
        |nat|::Nat::Succ { prev as pa } -> ngmr_a_succ(pa, b, factor)
    }

    machine ngmr_a_zero(b: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::mul_zero_left(factor);
        nat_gap_zero_left(|nat|::mul(b, factor));
        nat_gap_zero_left(b);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine ngmr_a_succ(pa: |nat|::Nat, b: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat {
        transition b {
            |nat|::Nat::Zero -> ngmr_b_zero(pa, factor),
            |nat|::Nat::Succ { prev as pb } -> ngmr_step(pa, pb, factor)
        }
    }

    machine ngmr_b_zero(pa: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::mul_zero_left(factor);
        nat_gap_zero_right(|nat|::mul(|nat|::Nat::Succ { prev: pa }, factor));
        nat_gap_zero_right(|nat|::Nat::Succ { prev: pa });
        transition { _ -> |nat|::Nat::Zero }
    }

    machine ngmr_step(pa: |nat|::Nat, pb: |nat|::Nat, factor: |nat|::Nat) -> |nat|::Nat {
        _ = sub_add_cancel_left(factor, |nat|::mul(pa, factor), |nat|::mul(pb, factor));
        _ = sub_add_cancel_left(factor, |nat|::mul(pb, factor), |nat|::mul(pa, factor));
        nat_gap_succ(pa, pb);
        transition { _ -> (nat_gap_mul_right(pa, pb, factor)) }
    }
}

// A three-factor commutative-semiring rearrangement used to align rational
// cross-products at one common denominator.
machine mul_swap_trailing(a: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat)
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::mul(|nat|::mul(a, b), c), |nat|::mul(|nat|::mul(a, c), b))
{
}

// LEAST UPPER BOUND: `nat_max(a, b)` is the larger endpoint, spelled
// `a + (b -∸ a)` so no case analysis is needed to define it. A single
// transition keeps facts unfolding through it exactly as they do through
// `nat_gap`. The Cauchy quotient's composed modulus is
// `nat_max(M1(2e), M2(2e))`, where two convergence witnesses each cover half the
// doubled precision.
machine nat_max(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat {
    let residual: |nat|::Nat = |nat|::saturating_sub(b, a);
    transition { _ -> (|nat|::add(a, residual)) }
}

// `a <= a + b`, premise-free -- induction on `b`. The Zero arm computes
// through add's right identity and self-annihilation; the Succ arm rewrites
// `add(a, Succ pb)` to `Succ(add(a, pb))` so the goal unfolds through
// saturating_sub's Succ arm to `pred` of the inductive hypothesis.
machine le_add_right_self(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat
terminates by b
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(a, (|nat|::add(a, b))), |nat|::Nat::Zero)
{
    transition b {
        |nat|::Nat::Zero -> lars_zero(a),
        |nat|::Nat::Succ { prev as pb } -> lars_step(a, pb)
    }

    machine lars_zero(a: |nat|::Nat) -> |nat|::Nat {
        |nat|::add_zero_right(a);
        _ = |nat|::sub_self(a);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine lars_step(a: |nat|::Nat, pb: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::add_succ_law(a, pb);
        transition { _ -> (le_add_right_self(a, pb)) }
    }
}

// Left argument bound: `a <= nat_max(a, b)` -- the unfolding makes this
// le_add_right_self at the residual.
machine le_max_left(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(a, (nat_max(a, b))), |nat|::Nat::Zero)
{
    _ = le_add_right_self(a, (|nat|::saturating_sub(b, a)));
    transition { _ -> |nat|::Nat::Zero }
}

// Right argument bound: `b <= nat_max(a, b)` -- induction on `a` with `b` free.
// The Zero arm computes through sub_zero_right/add_zero_left; the Succ arms
// case-split `b`, where the Succ x Succ arm strips both pairs and hands the
// inductive hypothesis `b' <= nat_max(a', b')` back.
machine le_max_right(a: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat
terminates by a
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(b, (nat_max(a, b))), |nat|::Nat::Zero)
{
    transition a {
        |nat|::Nat::Zero -> lmr_zero(b),
        |nat|::Nat::Succ { prev as pa } -> lmr_succ(pa, b)
    }

    machine lmr_zero(b: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::sub_zero_right(b);
        _ = |nat|::add_zero_left(b);
        _ = |nat|::sub_self(b);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine lmr_succ(pa: |nat|::Nat, b: |nat|::Nat) -> |nat|::Nat {
        transition b {
            |nat|::Nat::Zero -> lmr_succ_zero(pa),
            |nat|::Nat::Succ { prev as pb } -> lmr_succ_succ(pa, pb)
        }
    }

    machine lmr_succ_zero(pa: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::sub_zero_left((|nat|::add(|nat|::Nat::Succ { prev: pa }, (|nat|::saturating_sub(|nat|::Nat::Zero, (|nat|::Nat::Succ { prev: pa }))))));
        transition { _ -> |nat|::Nat::Zero }
    }

    machine lmr_succ_succ(pa: |nat|::Nat, pb: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::succ_sub_succ(pb, pa);
        _ = |nat|::succ_sub_succ(pb, (|nat|::add(pa, (|nat|::saturating_sub(pb, pa)))));
        transition { _ -> (le_max_right(pa, pb)) }
    }
}

// Universal property: `a <= c` and `b <= c` entail `nat_max(a, b) <= c` --
// induction on `a`. The a=Zero arm computes nat_max(0, b) = b and discharges on
// the second premise; Succ arms case-split `b` then `c`, where the c=Zero
// arm is vacuous (the first premise becomes `Succ pa <= Zero`, a constructor
// clash) and the Succ x Succ x Succ arm strips all three pairs and recurses.
// This is the discharge step callers of `doubled_nat_max_modulus` use to turn
// per-modulus thresholds into the composed threshold.
machine nat_max_le(a: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat
terminates by a
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(a, c), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(b, c), |nat|::Nat::Zero)
ensures
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub((nat_max(a, b)), c), |nat|::Nat::Zero)
{
    transition a {
        |nat|::Nat::Zero -> ml_zero(b, c),
        |nat|::Nat::Succ { prev as pa } -> ml_succ(pa, b, c)
    }

    machine ml_zero(b: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::sub_zero_right(b);
        _ = |nat|::add_zero_left(b);
        transition { _ -> |nat|::Nat::Zero }
    }

    machine ml_succ(pa: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat {
        transition b {
            |nat|::Nat::Zero -> ml_succ_zero(pa, c),
            |nat|::Nat::Succ { prev as pb } -> ml_succ_succ(pa, pb, c)
        }
    }

    machine ml_succ_zero(pa: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::sub_zero_left((|nat|::Nat::Succ { prev: pa }));
        |nat|::add_zero_right((|nat|::Nat::Succ { prev: pa }));
        transition { _ -> |nat|::Nat::Zero }
    }

    machine ml_succ_succ(pa: |nat|::Nat, pb: |nat|::Nat, c: |nat|::Nat) -> |nat|::Nat {
        transition c {
            |nat|::Nat::Zero -> ml_ss_zero(pa, pb),
            |nat|::Nat::Succ { prev as pc } -> ml_ss_step(pa, pb, pc)
        }
    }

    machine ml_ss_zero(pa: |nat|::Nat, pb: |nat|::Nat) -> |nat|::Nat {
        transition { _ -> |nat|::Nat::Zero }
    }

    machine ml_ss_step(pa: |nat|::Nat, pb: |nat|::Nat, pc: |nat|::Nat) -> |nat|::Nat {
        _ = |nat|::succ_sub_succ(pa, pc);
        _ = |nat|::succ_sub_succ(pb, pc);
        _ = |nat|::succ_sub_succ(pb, pa);
        _ = |nat|::succ_sub_succ((|nat|::add(pa, (|nat|::saturating_sub(pb, pa)))), pc);
        transition { _ -> (nat_max_le(pa, pb, pc)) }
    }
}

// `nat_max(a, a) == a` -- the residual is self-annihilating. Callers instantiating
// a composed modulus against a single witness use this to align the equality
// premise.
machine nat_max_self(a: |nat|::Nat) -> |nat|::Nat
ensures
    |proof|::Identity::<|nat|::Nat>(nat_max(a, a), a)
{
    _ = |nat|::sub_self(a);
    |nat|::add_zero_right(a);
    transition { _ -> |nat|::Nat::Zero }
}
