// Absolute difference and order lemmas over core Nat. This is the metric
// substrate used by Rat's denominator-scaled triangle proof: all order facts
// retain Nat's settled monus spelling (`a <= b` iff `saturating_sub(a, b) == Zero`).
use omega::language::core::nat;

machine nat_gap(a: Nat, b: Nat) -> Nat {
    let forward: Nat = saturating_sub(a, b);
    let backward: Nat = saturating_sub(b, a);
    let gap: Nat = add(forward, backward);
    transition { _ -> (gap) }
}

machine nat_gap_reflexive(a: Nat)
ensures
    (nat_gap(a, a)) == Nat::Zero
{
    sub_self(a);
    add_zero_left(Nat::Zero);
}

machine nat_gap_symmetric(a: Nat, b: Nat)
ensures
    (nat_gap(a, b)) == (nat_gap(b, a))
{
    add_comm(saturating_sub(a, b), saturating_sub(b, a));
}

machine nat_gap_zero_left(b: Nat)
ensures
    (nat_gap(Nat::Zero, b)) == b
{
    sub_zero_left(b);
    sub_zero_right(b);
    add_zero_left(b);
}

machine nat_gap_zero_right(a: Nat)
ensures
    (nat_gap(a, Nat::Zero)) == a
{
    sub_zero_right(a);
    sub_zero_left(a);
    add_zero_right(a);
}

machine nat_gap_succ(a: Nat, b: Nat)
ensures
    (nat_gap(Nat::Succ { prev: a }, Nat::Succ { prev: b })) == (nat_gap(a, b))
{
    succ_sub_succ(a, b);
    succ_sub_succ(b, a);
}

machine add_le_add_right(a: Nat, b: Nat, c: Nat) -> Nat
terminates by c;
requires
    (saturating_sub(a, b)) == Nat::Zero
ensures
    (saturating_sub(add(a, c), add(b, c))) == Nat::Zero
{
    transition c {
        Nat::Zero -> alar_zero(a, b)
        Nat::Succ { prev } -> alar_succ(a, b, prev)
    }

    state alar_zero(a: Nat, b: Nat) -> Nat {
        add_zero_right(a);
        add_zero_right(b);
        transition { _ -> Nat::Zero }
    }

    state alar_succ(a: Nat, b: Nat, prev: Nat) -> Nat {
        add_succ_law(a, prev);
        add_succ_law(b, prev);
        succ_sub_succ(add(a, prev), add(b, prev));
        transition { _ -> (add_le_add_right(a, b, prev)) }
    }
}

machine le_trans(a: Nat, b: Nat, c: Nat) -> Nat
terminates by a;
requires
    (saturating_sub(a, b)) == Nat::Zero;
    (saturating_sub(b, c)) == Nat::Zero
ensures
    (saturating_sub(a, c)) == Nat::Zero
{
    transition a {
        Nat::Zero -> le_trans_zero(c)
        Nat::Succ { prev as pa } -> le_trans_a_succ(pa, b, c)
    }

    state le_trans_zero(c: Nat) -> Nat {
        sub_zero_left(c);
        transition { _ -> Nat::Zero }
    }

    state le_trans_a_succ(pa: Nat, b: Nat, c: Nat) -> Nat {
        transition b {
            Nat::Zero -> le_trans_vacuous()
            Nat::Succ { prev as pb } -> le_trans_b_succ(pa, pb, c)
        }
    }

    state le_trans_b_succ(pa: Nat, pb: Nat, c: Nat) -> Nat {
        transition c {
            Nat::Zero -> le_trans_vacuous()
            Nat::Succ { prev as pc } -> le_trans_step(pa, pb, pc)
        }
    }

    state le_trans_step(pa: Nat, pb: Nat, pc: Nat) -> Nat {
        succ_sub_succ(pa, pb);
        succ_sub_succ(pb, pc);
        succ_sub_succ(pa, pc);
        transition { _ -> (le_trans(pa, pb, pc)) }
    }

    state le_trans_vacuous() -> Nat {
        transition { _ -> Nat::Zero }
    }
}

machine add_le_add(a: Nat, b: Nat, c: Nat, d: Nat)
requires
    (saturating_sub(a, b)) == Nat::Zero;
    (saturating_sub(c, d)) == Nat::Zero
ensures
    (saturating_sub(add(a, c), add(b, d))) == Nat::Zero
{
    add_le_add_right(a, b, c);
    add_comm(c, b);
    add_comm(d, b);
    add_le_add_right(c, d, b);
    le_trans(add(a, c), add(b, c), add(b, d));
}

// Multiplication preserves monus order on the right.  The successor step
// combines the standing a <= b premise with the conditional induction
// hypothesis at the smaller multiplier, then transports both through add.
machine mul_le_mul_right(a: Nat, b: Nat, factor: Nat) -> Nat
terminates by factor;
requires
    (saturating_sub(a, b)) == Nat::Zero
ensures
    (saturating_sub(mul(a, factor), mul(b, factor))) == Nat::Zero
{
    transition factor {
        Nat::Zero -> mlmr_zero(a, b)
        Nat::Succ { prev } -> mlmr_step(a, b, prev)
    }

    state mlmr_zero(a: Nat, b: Nat) -> Nat {
        mul_zero_right(a);
        mul_zero_right(b);
        sub_self(Nat::Zero);
        transition { _ -> Nat::Zero }
    }

    state mlmr_step(a: Nat, b: Nat, prev: Nat) -> Nat {
        mul_succ_right(a, prev);
        mul_succ_right(b, prev);
        add_le_add(a, b, mul(a, prev), mul(b, prev));
        transition { _ -> (mul_le_mul_right(a, b, prev)) }
    }
}

// A positive common right factor reflects monus order.  The double-successor
// branch cancels the common additive prefix exposed by mul's recursion and
// applies the conditional induction hypothesis to the predecessor pair.
machine mul_le_cancel_right(a: Nat, b: Nat, factor: Nat) -> Nat
terminates by a;
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, factor)) == Nat::Zero;
    (saturating_sub(mul(a, factor), mul(b, factor))) == Nat::Zero
ensures
    (saturating_sub(a, b)) == Nat::Zero
{
    transition a {
        Nat::Zero -> mlcr_a_zero(b, factor)
        Nat::Succ { prev as pa } -> mlcr_a_succ(pa, b, factor)
    }

    state mlcr_a_zero(b: Nat, factor: Nat) -> Nat {
        sub_zero_left(b);
        transition { _ -> Nat::Zero }
    }

    state mlcr_a_succ(pa: Nat, b: Nat, factor: Nat) -> Nat {
        transition b {
            Nat::Zero -> mlcr_b_zero(pa, factor)
            Nat::Succ { prev as pb } -> mlcr_step(pa, pb, factor)
        }
    }

    state mlcr_b_zero(pa: Nat, factor: Nat) -> Nat {
        transition factor {
            Nat::Zero -> mlcr_vacuous()
            Nat::Succ { prev } -> mlcr_vacuous()
        }
    }

    state mlcr_step(pa: Nat, pb: Nat, factor: Nat) -> Nat {
        sub_add_cancel_left(factor, mul(pa, factor), mul(pb, factor));
        succ_sub_succ(pa, pb);
        transition { _ -> (mul_le_cancel_right(pa, pb, factor)) }
    }

    state mlcr_vacuous() -> Nat {
        transition { _ -> Nat::Zero }
    }
}

// Every b lies below a plus their absolute gap.
machine le_add_gap(a: Nat, b: Nat) -> Nat
terminates by a;
ensures
    (saturating_sub(b, add(a, nat_gap(a, b)))) == Nat::Zero
{
    transition a {
        Nat::Zero -> lag_zero(b)
        Nat::Succ { prev as pa } -> lag_a_succ(pa, b)
    }

    state lag_zero(b: Nat) -> Nat {
        nat_gap_zero_left(b);
        sub_self(b);
        transition { _ -> Nat::Zero }
    }

    state lag_a_succ(pa: Nat, b: Nat) -> Nat {
        transition b {
            Nat::Zero -> lag_b_zero(pa)
            Nat::Succ { prev as pb } -> lag_step(pa, pb)
        }
    }

    state lag_b_zero(pa: Nat) -> Nat {
        sub_zero_left(add(Nat::Succ { prev: pa }, nat_gap(Nat::Succ { prev: pa }, Nat::Zero)));
        transition { _ -> Nat::Zero }
    }

    state lag_step(pa: Nat, pb: Nat) -> Nat {
        nat_gap_succ(pa, pb);
        succ_sub_succ(pb, add(pa, nat_gap(pa, pb)));
        transition { _ -> (le_add_gap(pa, pb)) }
    }
}

// Absolute difference never exceeds the sum of its endpoints.
machine nat_gap_le_add(a: Nat, b: Nat)
ensures
    (saturating_sub(nat_gap(a, b), add(a, b))) == Nat::Zero
{
    sub_le(a, b);
    sub_le(b, a);
    add_le_add(saturating_sub(a, b), a, saturating_sub(b, a), b);
}

machine nat_gap_triangle(a: Nat, b: Nat, c: Nat) -> Nat
terminates by a;
ensures
    (saturating_sub(nat_gap(a, c), add(nat_gap(a, b), nat_gap(b, c)))) == Nat::Zero
{
    transition a {
        Nat::Zero -> ngt_a_zero(b, c)
        Nat::Succ { prev as pa } -> ngt_a_succ(pa, b, c)
    }

    state ngt_a_zero(b: Nat, c: Nat) -> Nat {
        nat_gap_zero_left(c);
        nat_gap_zero_left(b);
        le_add_gap(b, c);
        transition { _ -> Nat::Zero }
    }

    state ngt_a_succ(pa: Nat, b: Nat, c: Nat) -> Nat {
        transition b {
            Nat::Zero -> ngt_b_zero(pa, c)
            Nat::Succ { prev as pb } -> ngt_b_succ(pa, pb, c)
        }
    }

    state ngt_b_zero(pa: Nat, c: Nat) -> Nat {
        nat_gap_zero_right(Nat::Succ { prev: pa });
        nat_gap_zero_left(c);
        nat_gap_le_add(Nat::Succ { prev: pa }, c);
        transition { _ -> Nat::Zero }
    }

    state ngt_b_succ(pa: Nat, pb: Nat, c: Nat) -> Nat {
        transition c {
            Nat::Zero -> ngt_c_zero(pa, pb)
            Nat::Succ { prev as pc } -> ngt_step(pa, pb, pc)
        }
    }

    state ngt_c_zero(pa: Nat, pb: Nat) -> Nat {
        nat_gap_zero_right(Nat::Succ { prev: pa });
        nat_gap_zero_right(Nat::Succ { prev: pb });
        nat_gap_symmetric(Nat::Succ { prev: pa }, Nat::Succ { prev: pb });
        le_add_gap(Nat::Succ { prev: pb }, Nat::Succ { prev: pa });
        add_comm(
            Nat::Succ { prev: pb },
            nat_gap(Nat::Succ { prev: pb }, Nat::Succ { prev: pa })
        );
        transition { _ -> Nat::Zero }
    }

    state ngt_step(pa: Nat, pb: Nat, pc: Nat) -> Nat {
        nat_gap_succ(pa, pc);
        nat_gap_succ(pa, pb);
        nat_gap_succ(pb, pc);
        transition { _ -> (nat_gap_triangle(pa, pb, pc)) }
    }
}

// Adding the same prefix to both operands does not change monus. This is the
// cancellation step needed to scale absolute differences by multiplication.
machine sub_add_cancel_left(prefix: Nat, a: Nat, b: Nat) -> Nat
terminates by prefix;
ensures
    (saturating_sub(add(prefix, a), add(prefix, b))) == (saturating_sub(a, b))
{
    transition prefix {
        Nat::Zero -> sacl_zero(a, b)
        Nat::Succ { prev } -> sacl_step(prev, a, b)
    }

    state sacl_zero(a: Nat, b: Nat) -> Nat {
        transition { _ -> Nat::Zero }
    }

    state sacl_step(prev: Nat, a: Nat, b: Nat) -> Nat {
        succ_sub_succ(add(prev, a), add(prev, b));
        transition { _ -> (sub_add_cancel_left(prev, a, b)) }
    }
}

// Translating both endpoints by the same Nat preserves their absolute gap.
// This bridges IntPair's nonnegative coordinates to Rat's public Nat metric.
machine nat_gap_add_common(prefix: Nat, a: Nat, b: Nat)
ensures
    (nat_gap(add(prefix, a), add(prefix, b))) == (nat_gap(a, b))
{
    sub_add_cancel_left(prefix, a, b);
    sub_add_cancel_left(prefix, b, a);
}

// Absolute difference is homogeneous under a shared Nat factor.
machine nat_gap_mul_right(a: Nat, b: Nat, factor: Nat) -> Nat
terminates by a;
ensures
    (nat_gap(mul(a, factor), mul(b, factor))) == (mul(nat_gap(a, b), factor))
{
    transition a {
        Nat::Zero -> ngmr_a_zero(b, factor)
        Nat::Succ { prev as pa } -> ngmr_a_succ(pa, b, factor)
    }

    state ngmr_a_zero(b: Nat, factor: Nat) -> Nat {
        mul_zero_left(factor);
        nat_gap_zero_left(mul(b, factor));
        nat_gap_zero_left(b);
        transition { _ -> Nat::Zero }
    }

    state ngmr_a_succ(pa: Nat, b: Nat, factor: Nat) -> Nat {
        transition b {
            Nat::Zero -> ngmr_b_zero(pa, factor)
            Nat::Succ { prev as pb } -> ngmr_step(pa, pb, factor)
        }
    }

    state ngmr_b_zero(pa: Nat, factor: Nat) -> Nat {
        mul_zero_left(factor);
        nat_gap_zero_right(mul(Nat::Succ { prev: pa }, factor));
        nat_gap_zero_right(Nat::Succ { prev: pa });
        transition { _ -> Nat::Zero }
    }

    state ngmr_step(pa: Nat, pb: Nat, factor: Nat) -> Nat {
        sub_add_cancel_left(factor, mul(pa, factor), mul(pb, factor));
        sub_add_cancel_left(factor, mul(pb, factor), mul(pa, factor));
        nat_gap_succ(pa, pb);
        transition { _ -> (nat_gap_mul_right(pa, pb, factor)) }
    }
}

// A three-factor commutative-semiring rearrangement used to align rational
// cross-products at one common denominator.
machine mul_swap_trailing(a: Nat, b: Nat, c: Nat)
ensures
    (mul(mul(a, b), c)) == (mul(mul(a, c), b))
{
}

// LEAST UPPER BOUND: `nat_max(a, b)` is the larger endpoint, spelled
// `a + (b -∸ a)` so no case analysis is needed to define it. A single
// transition keeps facts unfolding through it exactly as they do through
// `nat_gap`. The Cauchy quotient's composed modulus is
// `nat_max(M1(2e), M2(2e))`, where two convergence witnesses each cover half the
// doubled precision.
machine nat_max(a: Nat, b: Nat) -> Nat {
    let residual: Nat = saturating_sub(b, a);
    transition { _ -> (add(a, residual)) }
}

// `a <= a + b`, premise-free -- induction on `b`. The Zero arm computes
// through add's right identity and self-annihilation; the Succ arm rewrites
// `add(a, Succ pb)` to `Succ(add(a, pb))` so the goal unfolds through
// saturating_sub's Succ arm to `pred` of the inductive hypothesis.
machine le_add_right_self(a: Nat, b: Nat) -> Nat
terminates by b;
ensures
    (saturating_sub(a, (add(a, b)))) == Nat::Zero
{
    transition b {
        Nat::Zero -> lars_zero(a)
        Nat::Succ { prev as pb } -> lars_step(a, pb)
    }

    state lars_zero(a: Nat) -> Nat {
        add_zero_right(a);
        sub_self(a);
        transition { _ -> Nat::Zero }
    }

    state lars_step(a: Nat, pb: Nat) -> Nat {
        add_succ_law(a, pb);
        transition { _ -> (le_add_right_self(a, pb)) }
    }
}

// Left argument bound: `a <= nat_max(a, b)` -- the unfolding makes this
// le_add_right_self at the residual.
machine le_max_left(a: Nat, b: Nat) -> Nat
ensures
    (saturating_sub(a, (nat_max(a, b)))) == Nat::Zero
{
    le_add_right_self(a, (saturating_sub(b, a)));
}

// Right argument bound: `b <= nat_max(a, b)` -- induction on `a` with `b` free.
// The Zero arm computes through sub_zero_right/add_zero_left; the Succ arms
// case-split `b`, where the Succ x Succ arm strips both pairs and hands the
// inductive hypothesis `b' <= nat_max(a', b')` back.
machine le_max_right(a: Nat, b: Nat) -> Nat
terminates by a;
ensures
    (saturating_sub(b, (nat_max(a, b)))) == Nat::Zero
{
    transition a {
        Nat::Zero -> lmr_zero(b)
        Nat::Succ { prev as pa } -> lmr_succ(pa, b)
    }

    state lmr_zero(b: Nat) -> Nat {
        sub_zero_right(b);
        add_zero_left(b);
        sub_self(b);
        transition { _ -> Nat::Zero }
    }

    state lmr_succ(pa: Nat, b: Nat) -> Nat {
        transition b {
            Nat::Zero -> lmr_succ_zero(pa)
            Nat::Succ { prev as pb } -> lmr_succ_succ(pa, pb)
        }
    }

    state lmr_succ_zero(pa: Nat) -> Nat {
        sub_zero_left((add(Nat::Succ { prev: pa }, (saturating_sub(Nat::Zero, (Nat::Succ { prev: pa }))))));
        transition { _ -> Nat::Zero }
    }

    state lmr_succ_succ(pa: Nat, pb: Nat) -> Nat {
        succ_sub_succ(pb, pa);
        succ_sub_succ(pb, (add(pa, (saturating_sub(pb, pa)))));
        transition { _ -> (le_max_right(pa, pb)) }
    }
}

// Universal property: `a <= c` and `b <= c` entail `nat_max(a, b) <= c` --
// induction on `a`. The a=Zero arm computes nat_max(0, b) = b and discharges on
// the second premise; Succ arms case-split `b` then `c`, where the c=Zero
// arm is vacuous (the first premise becomes `Succ pa <= Zero`, a constructor
// clash) and the Succ x Succ x Succ arm strips all three pairs and recurses.
// This is the discharge step callers of `doubled_nat_max_modulus` use to turn
// per-modulus thresholds into the composed threshold.
machine nat_max_le(a: Nat, b: Nat, c: Nat) -> Nat
terminates by a;
requires
    (saturating_sub(a, c)) == Nat::Zero;
    (saturating_sub(b, c)) == Nat::Zero
ensures
    (saturating_sub((nat_max(a, b)), c)) == Nat::Zero
{
    transition a {
        Nat::Zero -> ml_zero(b, c)
        Nat::Succ { prev as pa } -> ml_succ(pa, b, c)
    }

    state ml_zero(b: Nat, c: Nat) -> Nat {
        sub_zero_right(b);
        add_zero_left(b);
        transition { _ -> Nat::Zero }
    }

    state ml_succ(pa: Nat, b: Nat, c: Nat) -> Nat {
        transition b {
            Nat::Zero -> ml_succ_zero(pa, c)
            Nat::Succ { prev as pb } -> ml_succ_succ(pa, pb, c)
        }
    }

    state ml_succ_zero(pa: Nat, c: Nat) -> Nat {
        sub_zero_left((Nat::Succ { prev: pa }));
        add_zero_right((Nat::Succ { prev: pa }));
        transition { _ -> Nat::Zero }
    }

    state ml_succ_succ(pa: Nat, pb: Nat, c: Nat) -> Nat {
        transition c {
            Nat::Zero -> ml_ss_zero(pa, pb)
            Nat::Succ { prev as pc } -> ml_ss_step(pa, pb, pc)
        }
    }

    state ml_ss_zero(pa: Nat, pb: Nat) -> Nat {
        transition { _ -> Nat::Zero }
    }

    state ml_ss_step(pa: Nat, pb: Nat, pc: Nat) -> Nat {
        succ_sub_succ(pa, pc);
        succ_sub_succ(pb, pc);
        succ_sub_succ(pb, pa);
        succ_sub_succ((add(pa, (saturating_sub(pb, pa)))), pc);
        transition { _ -> (nat_max_le(pa, pb, pc)) }
    }
}

// `nat_max(a, a) == a` -- the residual is self-annihilating. Callers instantiating
// a composed modulus against a single witness use this to align the equality
// premise.
machine nat_max_self(a: Nat) -> Nat
ensures
    (nat_max(a, a)) == a
{
    sub_self(a);
    add_zero_right(a);
}
