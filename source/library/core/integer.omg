module integer;

// Ordinary exact carrier queries. Static type equations select semantic
// integer meanings; layouts, providers and arithmetic policies do not choose
// these endpoints. Qualified and unsupported types do not satisfy the domain.
// Results are unqualified: callers explicitly apply arithmetic policy with
// `as`, for example `integer::max<u32>() as u32 in Wrapping`.

public machine min<T>() -> T
requires
    T == u8 || T == u16 || T == u32 || T == u64 || T == i8 || T == i16 || T == i32 || T == i64
ensures
    (T == u8 && result == 0u8) ||
    (T == u16 && result == 0u16) ||
    (T == u32 && result == 0u32) ||
    (T == u64 && result == 0u64) ||
    (T == i8 && result == -0x80i8) ||
    (T == i16 && result == -0x8000i16) ||
    (T == i32 && result == -0x8000_0000i32) ||
    (T == i64 && result == -0x8000_0000_0000_0000i64)
{
    transition {
        T == u8 -> (0u8)
        T == u16 -> (0u16)
        T == u32 -> (0u32)
        T == u64 -> (0u64)
        T == i8 -> (-0x80i8)
        T == i16 -> (-0x8000i16)
        T == i32 -> (-0x8000_0000i32)
        _ -> (-0x8000_0000_0000_0000i64)
    }
}

public machine max<T>() -> T
requires
    T == u8 || T == u16 || T == u32 || T == u64 || T == i8 || T == i16 || T == i32 || T == i64
ensures
    (T == u8 && result == 0xFFu8) ||
    (T == u16 && result == 0xFFFFu16) ||
    (T == u32 && result == 0xFFFFFFFFu32) ||
    (T == u64 && result == 0xFFFFFFFFFFFFFFFFu64) ||
    (T == i8 && result == 0x7Fi8) ||
    (T == i16 && result == 0x7FFFi16) ||
    (T == i32 && result == 0x7FFFFFFFi32) ||
    (T == i64 && result == 0x7FFFFFFFFFFFFFFFi64)
{
    transition {
        T == u8 -> (0xFFu8)
        T == u16 -> (0xFFFFu16)
        T == u32 -> (0xFFFFFFFFu32)
        T == u64 -> (0xFFFFFFFFFFFFFFFFu64)
        T == i8 -> (0x7Fi8)
        T == i16 -> (0x7FFFi16)
        T == i32 -> (0x7FFFFFFFi32)
        _ -> (0x7FFFFFFFFFFFFFFFi64)
    }
}

public machine width_bits<T>() -> u64
requires
    T == u8 || T == u16 || T == u32 || T == u64 || T == i8 || T == i16 || T == i32 || T == i64
ensures
    (T == u8 && result == 8u64) ||
    (T == u16 && result == 16u64) ||
    (T == u32 && result == 32u64) ||
    (T == u64 && result == 64u64) ||
    (T == i8 && result == 8u64) ||
    (T == i16 && result == 16u64) ||
    (T == i32 && result == 32u64) ||
    (T == i64 && result == 64u64)
{
    transition {
        T == u8 -> (8u64)
        T == u16 -> (16u64)
        T == u32 -> (32u64)
        T == u64 -> (64u64)
        T == i8 -> (8u64)
        T == i16 -> (16u64)
        T == i32 -> (32u64)
        _ -> (64u64)
    }
}

public machine is_signed<T>() -> bool
requires
    T == u8 || T == u16 || T == u32 || T == u64 || T == i8 || T == i16 || T == i32 || T == i64
ensures
    (T == u8 && result == false) ||
    (T == u16 && result == false) ||
    (T == u32 && result == false) ||
    (T == u64 && result == false) ||
    (T == i8 && result == true) ||
    (T == i16 && result == true) ||
    (T == i32 && result == true) ||
    (T == i64 && result == true)
{
    transition {
        T == u8 -> (false)
        T == u16 -> (false)
        T == u32 -> (false)
        T == u64 -> (false)
        T == i8 -> (true)
        T == i16 -> (true)
        T == i32 -> (true)
        _ -> (true)
    }
}

// What kind of computational integer a type is, read from the compiler's one
// integer identity: its sign, and whether its width is fixed (closed, or a
// generic width parameter) or unbounded (`i`, `u`). Every other type is no
// integer: `bool`, addresses, floats, proof-only `Int`/`Nat` and nominal data
// with an integer representation. An alias is its underlying carrier, and a
// qualified carrier is classified by its carrier without losing its domains.
public data Carrier [copy] {
    integer: bool;
    signed: bool;
    fixed_width: bool;
}

// Only this exact toolchain declaration is elaborated by Psi, from the type
// argument's carrier identity, and only through its fields in a static
// condition. This body is never its answer.
public machine carrier<T>() -> Carrier {
    Carrier { integer: false, signed: false, fixed_width: false }
}

// The total carrier-family queries (numeric_values.md, "Integer carrier
// families"). Each is an ordinary checked machine: its contract states the
// answer from `carrier<T>()`, and only that contract gives a caller a fact.
// A machine that merely returns `true` establishes no carrier family.
public machine is_integer<T>() -> bool
ensures result == carrier<T>().integer
{
    carrier<T>().integer
}

public machine is_signed_integer<T>() -> bool
ensures result == (carrier<T>().integer && carrier<T>().signed)
{
    carrier<T>().integer && carrier<T>().signed
}

public machine is_unsigned_integer<T>() -> bool
ensures result == (carrier<T>().integer && !carrier<T>().signed)
{
    carrier<T>().integer && !carrier<T>().signed
}

public machine is_fixed_width_integer<T>() -> bool
ensures result == (carrier<T>().integer && carrier<T>().fixed_width)
{
    carrier<T>().integer && carrier<T>().fixed_width
}
