    machine i64_from_f32_f32_trapping(value: f32) -> i64 in Trapping
    crashes Trap
        value != value || value < -9223372036854775808.0f32 || value >= 9223372036854775808.0f32;
    machine i64_from_f32_f32_saturating(value: f32) -> i64 in Saturating;
    machine i64_from_f64_f64(value: f64) -> i64
    requires
        value == value && value >= -9223372036854775808.0 && value < 9223372036854775808.0;
    machine i64_from_f64_f64_trapping(value: f64) -> i64 in Trapping
    crashes Trap
        value != value || value < -9223372036854775808.0 || value >= 9223372036854775808.0;
    machine i64_from_f64_f64_saturating(value: f64) -> i64 in Saturating;
    machine u8_from_f32_f32(value: f32) -> u8
    requires
        value == value && value > -1.0f32 && value < 256.0f32;
    machine u8_from_f32_f32_trapping(value: f32) -> u8 in Trapping
    crashes Trap
        value != value || value <= -1.0f32 || value >= 256.0f32;
    machine u8_from_f32_f32_saturating(value: f32) -> u8 in Saturating;
    machine u8_from_f64_f64(value: f64) -> u8
    requires
        value == value && value > -1.0 && value < 256.0;
    machine u8_from_f64_f64_trapping(value: f64) -> u8 in Trapping
    crashes Trap
        value != value || value <= -1.0 || value >= 256.0;
    machine u8_from_f64_f64_saturating(value: f64) -> u8 in Saturating;
    machine u16_from_f32_f32(value: f32) -> u16
    requires
        value == value && value > -1.0f32 && value < 65536.0f32;
    machine u16_from_f32_f32_trapping(value: f32) -> u16 in Trapping
    crashes Trap
        value != value || value <= -1.0f32 || value >= 65536.0f32;
    machine u16_from_f32_f32_saturating(value: f32) -> u16 in Saturating;
    machine u16_from_f64_f64(value: f64) -> u16
    requires
        value == value && value > -1.0 && value < 65536.0;
    machine u16_from_f64_f64_trapping(value: f64) -> u16 in Trapping
    crashes Trap
        value != value || value <= -1.0 || value >= 65536.0;
    machine u16_from_f64_f64_saturating(value: f64) -> u16 in Saturating;
    machine u32_from_f32_f32(value: f32) -> u32
    requires
        value == value && value > -1.0f32 && value < 4294967296.0f32;
    machine u32_from_f32_f32_trapping(value: f32) -> u32 in Trapping
    crashes Trap
        value != value || value <= -1.0f32 || value >= 4294967296.0f32;
    machine u32_from_f32_f32_saturating(value: f32) -> u32 in Saturating;
    machine u32_from_f64_f64(value: f64) -> u32
    requires
        value == value && value > -1.0 && value < 4294967296.0;
    machine u32_from_f64_f64_trapping(value: f64) -> u32 in Trapping
    crashes Trap
        value != value || value <= -1.0 || value >= 4294967296.0;
    machine u32_from_f64_f64_saturating(value: f64) -> u32 in Saturating;
    machine u64_from_f32_f32(value: f32) -> u64
    requires
        value == value && value > -1.0f32 && value < 18446744073709551616.0f32;
    machine u64_from_f32_f32_trapping(value: f32) -> u64 in Trapping
    crashes Trap
        value != value || value <= -1.0f32 || value >= 18446744073709551616.0f32;
    machine u64_from_f32_f32_saturating(value: f32) -> u64 in Saturating;
    machine u64_from_f64_f64(value: f64) -> u64
    requires
