    machine u64_from_f64_f64_trapping(value: f64) -> u64 in Trapping
    crashes Trap
        value != value || value <= -1.0 || value >= 18446744073709551616.0;
    machine u64_from_f64_f64_saturating(value: f64) -> u64 in Saturating;
