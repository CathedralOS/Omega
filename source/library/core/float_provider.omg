    machine f64_minimum_f64_f64(left: f64, right: f64) -> f64;
    machine f32_maximum_f32_f32(left: f32, right: f32) -> f32;
    machine f64_maximum_f64_f64(left: f64, right: f64) -> f64;
    machine f32_from_f64_f64(value: f64) -> f32;
    machine f64_from_f32_f32(value: f32) -> f64;
    machine f32_from_i8_i8(value: i8) -> f32;
    machine f32_from_i16_i16(value: i16) -> f32;
    machine f32_from_i32_i32(value: i32) -> f32;
    machine f32_from_i64_i64(value: i64) -> f32;
    machine f32_from_u8_u8(value: u8) -> f32;
    machine f32_from_u16_u16(value: u16) -> f32;
    machine f32_from_u32_u32(value: u32) -> f32;
    machine f32_from_u64_u64(value: u64) -> f32;
    machine f64_from_i8_i8(value: i8) -> f64;
    machine f64_from_i16_i16(value: i16) -> f64;
    machine f64_from_i32_i32(value: i32) -> f64;
    machine f64_from_i64_i64(value: i64) -> f64;
    machine f64_from_u8_u8(value: u8) -> f64;
    machine f64_from_u16_u16(value: u16) -> f64;
    machine f64_from_u32_u32(value: u32) -> f64;
    machine f64_from_u64_u64(value: u64) -> f64;
    machine i8_from_f32_f32(value: f32) -> i8
    requires
        value == value && value > -129.0f32 && value < 128.0f32;
    machine i8_from_f32_f32_trapping(value: f32) -> i8 in Trapping
    crashes Trap
        value != value || value <= -129.0f32 || value >= 128.0f32;
    machine i8_from_f32_f32_saturating(value: f32) -> i8 in Saturating;
    machine i8_from_f64_f64(value: f64) -> i8
    requires
        value == value && value > -129.0 && value < 128.0;
    machine i8_from_f64_f64_trapping(value: f64) -> i8 in Trapping
    crashes Trap
        value != value || value <= -129.0 || value >= 128.0;
    machine i8_from_f64_f64_saturating(value: f64) -> i8 in Saturating;
    machine i16_from_f32_f32(value: f32) -> i16
    requires
        value == value && value > -32769.0f32 && value < 32768.0f32;
    machine i16_from_f32_f32_trapping(value: f32) -> i16 in Trapping
    crashes Trap
        value != value || value <= -32769.0f32 || value >= 32768.0f32;
    machine i16_from_f32_f32_saturating(value: f32) -> i16 in Saturating;
    machine i16_from_f64_f64(value: f64) -> i16
