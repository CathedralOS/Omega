NativeFloats satisfies FloatNativeOperations {
    boundary machine float_add_f32_f32(left: f32, right: f32) -> f32
    satisfies Float::add
    ;
    boundary machine float_add_f64_f64(left: f64, right: f64) -> f64
    satisfies Float::add
    ;
    boundary machine float_subtract_f32_f32(left: f32, right: f32) -> f32
    satisfies Float::subtract
    ;
    boundary machine float_subtract_f64_f64(left: f64, right: f64) -> f64
