// The ordinary map owns these machine members. Each member also records its
// exact public arithmetic requirement; the selected target's realization
// table binds that recorded relation, and Build never selects it. The
// compiler catalog supplies intrinsic execution only for this sealed map.
use omega::language::core::float_format;
use omega::language::core::float_meaning;

trait FloatNativeOperations {
    machine float_add_f32_f32(left: f32, right: f32) -> f32;
    machine float_add_f64_f64(left: f64, right: f64) -> f64;
    machine float_subtract_f32_f32(left: f32, right: f32) -> f32;
    machine float_subtract_f64_f64(left: f64, right: f64) -> f64;
    machine float_multiply_f32_f32(left: f32, right: f32) -> f32;
