    boundary machine float_multiply_f32_f32(left: f32, right: f32) -> f32
    satisfies Float::multiply
    ;
    boundary machine float_multiply_f64_f64(left: f64, right: f64) -> f64
    satisfies Float::multiply
    ;
    boundary machine float_divide_f32_f32(left: f32, right: f32) -> f32
    satisfies Float::divide
    ;
    boundary machine float_divide_f64_f64(left: f64, right: f64) -> f64
