    machine f32_subtract_toward_positive_f32_f32(left: f32, right: f32) -> f32;
    machine f64_subtract_toward_positive_f64_f64(left: f64, right: f64) -> f64;
    machine f32_subtract_toward_negative_f32_f32(left: f32, right: f32) -> f32;
    machine f64_subtract_toward_negative_f64_f64(left: f64, right: f64) -> f64;
    machine f32_multiply_toward_zero_f32_f32(left: f32, right: f32) -> f32;
    machine f64_multiply_toward_zero_f64_f64(left: f64, right: f64) -> f64;
    machine f32_multiply_toward_positive_f32_f32(left: f32, right: f32) -> f32;
