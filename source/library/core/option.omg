// Standard optional-value carrier. Presence is ordinary cased data; the
// stable identities belong to schema reflection and do not choose runtime
// discriminants. The home-representation obligation below pins None as the
// meaning of all-zero storage.

pub data Optional<T> {
    case #0 None;
    case #1 Some(value: T);
}

machine zero_is_none<T>()
ensures
    zero_value<Optional<T>>() == Optional::None
{
}
