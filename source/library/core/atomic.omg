// Portable atomic ordering events. The compiler supplies this exact sealed
// declaration; an authored lookalike has no primitive implementation.
pub data Atomic {}
pub data FenceOrdering [copy] {
    case Receive;
    case Publish;
    case ReceivePublish;
}

// The argument must name one proved case at the evaluated call. A fence alone
// does not establish a publication or a reads-from synchronization relation.
pub machine Atomic::fence(ordering: FenceOrdering);
