use activation.omg;
use option.omg;
use reply.omg;

public data Decision [copy] {
    case Continue;
    case Stop;
}

// A transport stores one item until its receiver takes it. Taking from an
// empty transport returns None. Both operations use the same endpoint.
public data Publish<Endpoint, Item> = machine(endpoint: @Endpoint, item: Item)
    reaches none crashes none;
public data Take<Endpoint, Item> = machine(endpoint: @Endpoint) -> |option|::Optional<Item>
    reaches none crashes none;
public data Transport<Endpoint, Item> {
    endpoint: Endpoint;
    publish: Publish<Endpoint, Item>;
    take: Take<Endpoint, Item>;
}

public data Slot<Endpoint, Item> {
    reply: |reply|::ReplySlot;
    transport: Transport<Endpoint, Item>;
}

public data Emitter<'slot, Endpoint, Item> {
    transport: @'slot Transport<Endpoint, Item>;
    request: |reply|::Publication<'slot> in |reply|::Issued<|reply|::RequestRole, Decision>;
}
public data Receiver<'slot, Endpoint, Item> {
    transport: @'slot Transport<Endpoint, Item>;
    permit: |reply|::Publication<'slot> in |reply|::Issued<|reply|::AnswerRole, Decision>;
}
public data Pair<'slot, Endpoint, Item> {
    emitter: Emitter<'slot, Endpoint, Item>;
    receiver: Receiver<'slot, Endpoint, Item>;
}

// An exclusive borrow of the slot covers a single publication. The producer
// and consumer share the transport and each owns its own half of the reply.
public machine open<'slot, Endpoint, Item>(slot: @'slot mutable Slot<Endpoint, Item>)
    -> Pair<'slot, Endpoint, Item> reaches none crashes none {
    let halves: |reply|::ReplyPair<'slot, Decision> = |reply|::new_reply_pair(@mutable slot.reply);
    Pair {
        emitter: Emitter { transport: @slot.transport, request: move halves.request },
        receiver: Receiver { transport: @slot.transport, permit: move halves.permit }
    }
}

public machine emit<'slot, Endpoint, Item>(emitter: Emitter<'slot, Endpoint, Item>, item: Item)
    -> Decision reaches none crashes none suspends {
    (emitter.transport.publish)(@emitter.transport.endpoint, move item);
    suspend |activation|::park(move emitter.request)
}

public data Reception<'slot, Endpoint, Item> {
    case Pending(receiver: Receiver<'slot, Endpoint, Item>);
    case Received(item: Item, permit: |reply|::Publication<'slot> in |reply|::Issued<|reply|::AnswerRole, Decision>);
}

// A worker can park for another reason before it emits. Its receiver keeps
// the answer permit until this endpoint has actually supplied an item.
public machine try_receive<'slot, Endpoint, Item>(receiver: Receiver<'slot, Endpoint, Item>)
    -> Reception<'slot, Endpoint, Item> reaches none crashes none {
    let taken: |option|::Optional<Item> = (receiver.transport.take)(@receiver.transport.endpoint);
    match taken {
        |option|::Optional::None -> Reception::Pending { receiver: move receiver },
        |option|::Optional::Some { value } -> Reception::Received { item: move value, permit: move receiver.permit }
    }
}
