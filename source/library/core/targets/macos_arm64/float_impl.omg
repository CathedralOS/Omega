// macOS/AArch64 realizations for F7's primitive spelling provider-plan slice.
// String intrinsic names are bootstrap syntax; the destination payload-free
// binding keys the sealed catalog by realization symbol, signature, and target.
macos_arm64 machine FloatNativeProvider::add32(left: f32, right: f32) -> f32
    satisfies Float::add
    via Binding::CompilerIntrinsic;

macos_arm64 machine FloatNativeProvider::add64(left: f64, right: f64) -> f64
    satisfies Float::add
    via Binding::CompilerIntrinsic;

