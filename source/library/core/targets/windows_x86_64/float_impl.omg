module FloatNativeProvider;

use omega::language::core::float_operations;

// Windows/x86-64 realizations for F7's primitive spelling provider-plan slice.
// String intrinsic names are bootstrap syntax; the destination payload-free
// binding keys the sealed catalog by realization symbol, signature, and target.
windows_x86_64 boundary machine add32(left: f32, right: f32) -> f32
    satisfies Float::add
    ;

windows_x86_64 boundary machine add64(left: f64, right: f64) -> f64
    satisfies Float::add
    ;

