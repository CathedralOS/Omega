public trait ElementStep<Element> {
    machine apply(element: @mutable Element)
    terminates;
}

public machine for_each<Element, const Step: ElementStep<Element>::apply>(items: @mutable [Element])
terminates
terminates by items -> Slice::Length
{
    transition items.length > 0 {
        true -> head(items),
        _ -> done()
    }
    machine head(items: @mutable [Element]) requires items.length > 0 {
        Step(@mutable items[0]);
        for_each::<Element, Step>(@mutable items[1..])
    }
    machine done() {}
}