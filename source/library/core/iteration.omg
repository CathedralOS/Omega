public trait ElementStep<Element> {
    machine apply(element: @mut Element)
    terminates;
}

public machine for_each<Element, const Step: ElementStep<Element>::apply>(items: @mut [Element])
terminates
terminates by items -> Slice::Length
{
    transition items.length > 0 {
        true -> head(items),
        _ -> done()
    }
    machine head(items: @mut [Element]) requires items.length > 0 {
        Step(@mut items[0]);
        for_each::<Element, Step>(@mut items[1..])
    }
    machine done() {}
}