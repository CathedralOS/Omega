// Each input names its own shared loan. Each result lane wraps independently.
public machine wrapping_add_i16x8<'left, 'right>(left: @'left [i16; 8], right: @'right [i16; 8]) -> [i16; 8]
reaches none
crashes none
terminates;

public machine wrapping_sub_i16x8<'left, 'right>(left: @'left [i16; 8], right: @'right [i16; 8]) -> [i16; 8]
reaches none
crashes none
terminates;

public machine shuffle_i16x8<'left, 'right, const A: u64, const B: u64, const C: u64, const D: u64, const E: u64, const F: u64, const G: u64, const H: u64>(left: @'left [i16; 8], right: @'right [i16; 8]) -> [i16; 8]
reaches none
requires A < 16u64
requires B < 16u64
requires C < 16u64
requires D < 16u64
requires E < 16u64
requires F < 16u64
requires G < 16u64
requires H < 16u64
crashes none
terminates;

public machine shift_right_i16x8<'input, const Count: u64>(source: @'input [i16; 8]) -> [i16; 8]
reaches none
requires Count < 16u64
crashes none
terminates;

public machine widen_u8x8_to_i16x8<'input>(source: @'input [u8; 8]) -> [i16; 8]
reaches none
crashes none
terminates;

public machine narrow_i16x8_to_u8x8_saturating<'input>(source: @'input [i16; 8]) -> [u8; 8]
reaches none
crashes none
terminates;

public machine load_i16x4_zero_extend<'input>(source: @'input [i16; 4]) -> [i16; 8]
reaches none
crashes none
terminates;

public machine widen_u8x4_to_i16x8<'input>(source: @'input [u8; 4]) -> [i16; 8]
reaches none
crashes none
terminates;

public machine narrow_i16x8_to_u8x4_saturating<'input>(source: @'input [i16; 8]) -> [u8; 4]
reaches none
crashes none
terminates;
