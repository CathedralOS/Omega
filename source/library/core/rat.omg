// Core Rat -- the signed CANONICAL-REPRESENTATIVE construction. A rational is
// an IntPair numerator over a positive Nat denominator. The signed constructor
// normalizes the difference pair to one nonzero coordinate and divides the
// resulting magnitude and denominator by their gcd.
//
// Equality and distance remain division-free cross products. The signed
// numerator never escapes into a Nat ordering judgment: `rat_gap` computes the
// absolute gap between positive/negative cross-product coordinates and keeps
// the existing Nat-valued metric API.
//
// Proof-only: Rat rides Nat, so the runtime-consumption fence and the
// layout skip apply exactly as they do for Nat and IntPair.
//
// The constructors establish canonical representatives, but the carrier does
// not yet enforce that discipline structurally. Until quotient-backed Rat
// lands, proof-static index admission rechecks a positive denominator,
// cancelled signed coordinates, and gcd-reduced magnitude/denominator.

use omega::language::core::nat;
use omega::language::core::nat_metric;
use omega::language::core::int;

pub data Rat {
    num: IntPair;
    den: Nat;
}

// Compatibility constructor for a nonnegative numerator.
machine mk_rat(n: Nat, d: Nat, g: Nat) -> Rat
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, d)) == Nat::Zero;
    (gcd(n, d)) == (g);
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, g)) == Nat::Zero
{
    transition {
        _ -> build(n, d, g)
    }

    state build(n: Nat, d: Nat, g: Nat) -> Rat {
        let rn: Nat = div(n, g);
        let rd: Nat = div(d, g);
        transition { _ -> Rat {
            num: IntPair { neg: Nat::Zero, pos: rn },
            den: rd
        } }
    }
}

// Signed constructor. The magnitude is the sum of the two directed monus
// coordinates after cancelling the difference pair's shared offset.
machine mk_signed_rat(n: IntPair, d: Nat, g: Nat) -> Rat
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, d)) == Nat::Zero;
    (gcd(add(saturating_sub(n.neg, n.pos), saturating_sub(n.pos, n.neg)), d)) == (g);
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, g)) == Nat::Zero
{
    let negative: Nat = saturating_sub(n.neg, n.pos);
    let positive: Nat = saturating_sub(n.pos, n.neg);
    let reduced_negative: Nat = div(negative, g);
    let reduced_positive: Nat = div(positive, g);
    let reduced_denominator: Nat = div(d, g);
    transition { _ -> Rat {
        num: IntPair { neg: reduced_negative, pos: reduced_positive },
        den: reduced_denominator
    } }
}

// The positive and negative coordinates of p-q over a common denominator.
machine rat_cross_positive(p: Rat, q: Rat) -> Nat {
    let left: Nat = mul(p.num.pos, q.den);
    let right: Nat = mul(q.num.neg, p.den);
    let result: Nat = add(left, right);
    transition { _ -> (result) }
}

machine rat_cross_negative(p: Rat, q: Rat) -> Nat {
    let left: Nat = mul(p.num.neg, q.den);
    let right: Nat = mul(q.num.pos, p.den);
    let result: Nat = add(left, right);
    transition { _ -> (result) }
}

// Cross-multiplication equality over the signed coordinates.
machine rat_eq(p: Rat, q: Rat) -> Nat
{
    let positive: Nat = rat_cross_positive(p, q);
    let negative: Nat = rat_cross_negative(p, q);
    transition (saturating_sub(positive, negative)) {
        Nat::Zero -> check_other(p, q)
        Nat::Succ { prev as w } -> Nat::Succ { prev: Nat::Zero }
    }

    state check_other(p: Rat, q: Rat) -> Nat {
        let negative: Nat = rat_cross_negative(p, q);
        let positive: Nat = rat_cross_positive(p, q);
        transition (saturating_sub(negative, positive)) {
            Nat::Zero -> Nat::Zero
            Nat::Succ { prev as w } -> Nat::Succ { prev: Nat::Zero }
        }
    }
}

// N8 metric kernel. Cross-multiplication puts both signed numerators over the
// common denominator p.den * q.den. The public result remains the nonnegative
// absolute numerator gap.
//
// This is deliberately unreduced. Cauchy bounds compare it against the common
// denominator, so normalization does not change the proposition.
machine rat_gap(p: Rat, q: Rat) -> Nat
{
    let p_positive: Nat = mul(p.num.pos, q.den);
    let q_negative: Nat = mul(q.num.neg, p.den);
    let p_negative: Nat = mul(p.num.neg, q.den);
    let q_positive: Nat = mul(q.num.pos, p.den);
    let positive: Nat = add(p_positive, q_negative);
    let negative: Nat = add(p_negative, q_positive);
    let forward: Nat = saturating_sub(positive, negative);
    let backward: Nat = saturating_sub(negative, positive);
    let gap: Nat = add(forward, backward);
    transition { _ -> (gap) }
}

machine rat_gap_reflexive(p: Rat) -> Nat
ensures
    result == Nat::Zero;
    (rat_gap(p, p)) == Nat::Zero
{
    let p_positive: Nat = mul(p.num.pos, p.den);
    let p_negative: Nat = mul(p.num.neg, p.den);
    add_comm(p_positive, p_negative);
    let positive: Nat = add(p_positive, p_negative);
    sub_self(positive);
    transition { _ -> (rat_gap(p, p)) }
}

machine rat_gap_symmetric(p: Rat, q: Rat) -> Nat
ensures
    (rat_gap(p, q)) == (rat_gap(q, p))
{
    let p_positive: Nat = mul(p.num.pos, q.den);
    let q_negative: Nat = mul(q.num.neg, p.den);
    let p_negative: Nat = mul(p.num.neg, q.den);
    let q_positive: Nat = mul(q.num.pos, p.den);
    add_comm(p_positive, q_negative);
    add_comm(p_negative, q_positive);
    let positive: Nat = add(p_positive, q_negative);
    let negative: Nat = add(p_negative, q_positive);
    add_comm(saturating_sub(positive, negative), saturating_sub(negative, positive));
    transition { _ -> (rat_gap(p, q)) }
}

// `rat_close(p, q, precision) == Zero` means |p-q| <= 1/precision, written
// without division as precision * gap <= p.den * q.den. Nat's settled monus
// spelling encodes `a <= b` as saturating_sub(a, b) == Zero. Precision zero is harmless
// (the bound is vacuous); Cauchy consumers use positive precisions.
machine rat_close(p: Rat, q: Rat, precision: Nat) -> Nat
{
    let gap: Nat = rat_gap(p, q);
    let scaled_gap: Nat = mul(precision, gap);
    let common_denominator: Nat = mul(p.den, q.den);
    let residual: Nat = saturating_sub(scaled_gap, common_denominator);
    transition { _ -> (residual) }
}

machine rat_close_reflexive(p: Rat, precision: Nat)
ensures
    (rat_close(p, p, precision)) == Nat::Zero
{
    rat_gap_reflexive(p);
    mul_zero_right(precision);
    let common_denominator: Nat = mul(p.den, p.den);
    sub_zero_left(common_denominator);
}

machine rat_close_symmetric(p: Rat, q: Rat, precision: Nat)
requires
    (rat_close(p, q, precision)) == Nat::Zero
ensures
    (rat_close(q, p, precision)) == Nat::Zero
{
    rat_gap_symmetric(q, p);
    mul_comm(q.den, p.den);
}

// Scale a signed cross-product gap and optionally translate both Nat
// coordinates by a shared prefix. The prefix disappears from the metric while
// the scale becomes an ordinary factor of the public gap.
machine rat_gap_scaled_with_common(
    p: Rat,
    q: Rat,
    factor: Nat,
    prefix: Nat
)
ensures
    (nat_gap(
        add(prefix, mul(add(
            mul(p.num.pos, q.den),
            mul(q.num.neg, p.den)
        ), factor)),
        add(prefix, mul(add(
            mul(p.num.neg, q.den),
            mul(q.num.pos, p.den)
        ), factor))
    )) == (mul(rat_gap(p, q), factor))
{
    let p_positive: Nat = mul(p.num.pos, q.den);
    let q_negative: Nat = mul(q.num.neg, p.den);
    let p_negative: Nat = mul(p.num.neg, q.den);
    let q_positive: Nat = mul(q.num.pos, p.den);
    let positive: Nat = add(p_positive, q_negative);
    let negative: Nat = add(p_negative, q_positive);
    let scaled_positive: Nat = mul(positive, factor);
    let scaled_negative: Nat = mul(negative, factor);
    nat_gap_add_common(
        prefix,
        scaled_positive,
        scaled_negative
    );
    nat_gap_mul_right(positive, negative, factor);
}

// Align the three translated/scaled signed-coordinate pairs at one common
// denominator. Each equality is a plain Nat semiring rearrangement; naming
// them explicitly gives the structural proof engine exact rewrite endpoints
// for the metric triangle.
machine rat_gap_triangle_coordinate_alignment(p: Rat, q: Rat, r: Rat)
ensures
    (add(
        mul(mul(q.num.neg, p.den), r.den),
        mul(add(
            mul(p.num.pos, r.den),
            mul(r.num.neg, p.den)
        ), q.den)
    )) == (add(
        add(
            mul(mul(p.num.pos, q.den), r.den),
            mul(mul(q.num.neg, p.den), r.den)
        ),
        mul(mul(r.num.neg, p.den), q.den)
    ));
    (add(
        mul(mul(q.num.neg, p.den), r.den),
        mul(add(
            mul(p.num.neg, r.den),
            mul(r.num.pos, p.den)
        ), q.den)
    )) == (add(
        add(
            mul(mul(r.num.pos, p.den), q.den),
            mul(mul(p.num.neg, q.den), r.den)
        ),
        mul(mul(q.num.neg, p.den), r.den)
    ));
    (add(
        mul(mul(r.num.neg, p.den), q.den),
        mul(add(
            mul(p.num.pos, q.den),
            mul(q.num.neg, p.den)
        ), r.den)
    )) == (add(
        add(
            mul(mul(p.num.pos, q.den), r.den),
            mul(mul(q.num.neg, p.den), r.den)
        ),
        mul(mul(r.num.neg, p.den), q.den)
    ));
    (add(
        mul(mul(r.num.neg, p.den), q.den),
        mul(add(
            mul(p.num.neg, q.den),
            mul(q.num.pos, p.den)
        ), r.den)
    )) == (add(
        add(
            mul(mul(q.num.pos, p.den), r.den),
            mul(mul(p.num.neg, q.den), r.den)
        ),
        mul(mul(r.num.neg, p.den), q.den)
    ));
    (add(
        mul(mul(p.num.neg, q.den), r.den),
        mul(add(
            mul(q.num.pos, r.den),
            mul(r.num.neg, q.den)
        ), p.den)
    )) == (add(
        add(
            mul(mul(q.num.pos, p.den), r.den),
            mul(mul(p.num.neg, q.den), r.den)
        ),
        mul(mul(r.num.neg, p.den), q.den)
    ));
    (add(
        mul(mul(p.num.neg, q.den), r.den),
        mul(add(
            mul(q.num.neg, r.den),
            mul(r.num.pos, q.den)
        ), p.den)
    )) == (add(
        add(
            mul(mul(r.num.pos, p.den), q.den),
            mul(mul(p.num.neg, q.den), r.den)
        ),
        mul(mul(q.num.neg, p.den), r.den)
    ))
{
}

// Triangle inequality after lifting all three cross-product gaps to the
// shared denominator p.den * q.den * r.den:
//
//   q.den * gap(p,r) <= r.den * gap(p,q) + p.den * gap(q,r)
//
// The proof is Nat's checked triangle at the common numerators x,y,z. The
// only Rat-specific work is rearranging factors and applying homogeneity.
machine rat_gap_triangle_scaled(p: Rat, q: Rat, r: Rat)
ensures
    (saturating_sub(
        mul(q.den, rat_gap(p, r)),
        add(mul(r.den, rat_gap(p, q)), mul(p.den, rat_gap(q, r)))
    )) == Nat::Zero
{
    let p_positive_q: Nat = mul(p.num.pos, q.den);
    let p_negative_q: Nat = mul(p.num.neg, q.den);
    let q_positive_p: Nat = mul(q.num.pos, p.den);
    let q_negative_p: Nat = mul(q.num.neg, p.den);
    let r_positive_p: Nat = mul(r.num.pos, p.den);
    let r_negative_p: Nat = mul(r.num.neg, p.den);
    let p_positive: Nat = mul(p_positive_q, r.den);
    let p_negative: Nat = mul(p_negative_q, r.den);
    let q_positive: Nat = mul(q_positive_p, r.den);
    let q_negative: Nat = mul(q_negative_p, r.den);
    let r_positive: Nat = mul(r_positive_p, q.den);
    let r_negative: Nat = mul(r_negative_p, q.den);
    let x_left: Nat = add(p_positive, q_negative);
    let y_left: Nat = add(q_positive, p_negative);
    let z_left: Nat = add(r_positive, p_negative);
    let x: Nat = add(x_left, r_negative);
    let y: Nat = add(y_left, r_negative);
    let z: Nat = add(z_left, q_negative);

    rat_gap_triangle_coordinate_alignment(p, q, r);
    rat_gap_scaled_with_common(p, r, q.den, q_negative);
    rat_gap_scaled_with_common(p, q, r.den, r_negative);
    rat_gap_scaled_with_common(q, r, p.den, p_negative);

    mul_comm(q.den, rat_gap(p, r));
    mul_comm(r.den, rat_gap(p, q));
    mul_comm(p.den, rat_gap(q, r));
    nat_gap_triangle(x, y, z);
}

// Pure semiring factorization for the reciprocal-bound triangle.  Equation
// orientation is deliberate: the first rewrite expands the scaled triangle's
// upper bound before order transport, while the remaining rewrites map the
// common-factor forms used by cancellation back to the established bounds.
machine rat_close_triangle_factorization(
    p: Rat,
    q: Rat,
    r: Rat,
    precision: Nat
)
ensures
    (mul(
        add(
            mul(r.den, rat_gap(p, q)),
            mul(p.den, rat_gap(q, r))
        ),
        add(precision, precision)
    )) == (add(
        mul(mul(add(precision, precision), rat_gap(p, q)), r.den),
        mul(mul(add(precision, precision), rat_gap(q, r)), p.den)
    ));
    (mul(
        mul(add(precision, precision), rat_gap(p, r)),
        q.den
    )) == (mul(
        mul(q.den, rat_gap(p, r)),
        add(precision, precision)
    ));
    (mul(
        add(
            mul(p.den, r.den),
            mul(p.den, r.den)
        ),
        q.den
    )) == (add(
        mul(mul(p.den, q.den), r.den),
        mul(mul(q.den, r.den), p.den)
    ));
    (add(
        mul(precision, rat_gap(p, r)),
        mul(precision, rat_gap(p, r))
    )) == (mul(add(precision, precision), rat_gap(p, r)))
{
}

// If p and q, and q and r, are close at twice the requested precision, then
// p and r are close at that precision.  The middle denominator is the common
// positive factor: scale the gap triangle, add the two doubled-precision
// bounds, cancel q.den, then cancel the concrete factor two.
machine rat_close_triangle_split(
    p: Rat,
    q: Rat,
    r: Rat,
    precision: Nat
)
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, q.den)) == Nat::Zero;
    (rat_close(p, q, add(precision, precision))) == Nat::Zero;
    (rat_close(q, r, add(precision, precision))) == Nat::Zero
ensures
    (rat_close(p, r, precision)) == Nat::Zero
{
    let double_precision: Nat = add(precision, precision);
    let pq_gap: Nat = rat_gap(p, q);
    let qr_gap: Nat = rat_gap(q, r);
    let pr_gap: Nat = rat_gap(p, r);
    let triangle_lower: Nat = mul(q.den, pr_gap);
    let pq_triangle_upper: Nat = mul(r.den, pq_gap);
    let qr_triangle_upper: Nat = mul(p.den, qr_gap);
    let triangle_upper: Nat = add(pq_triangle_upper, qr_triangle_upper);
    let scaled_triangle_lower: Nat = mul(triangle_lower, double_precision);
    let pq_close_lower: Nat = mul(double_precision, pq_gap);
    let qr_close_lower: Nat = mul(double_precision, qr_gap);
    let pq_scaled_lower: Nat = mul(pq_close_lower, r.den);
    let qr_scaled_lower: Nat = mul(qr_close_lower, p.den);
    let summed_lower: Nat = add(pq_scaled_lower, qr_scaled_lower);
    let pq_close_upper: Nat = mul(p.den, q.den);
    let qr_close_upper: Nat = mul(q.den, r.den);
    let pq_scaled_upper: Nat = mul(pq_close_upper, r.den);
    let qr_scaled_upper: Nat = mul(qr_close_upper, p.den);
    let summed_upper: Nat = add(pq_scaled_upper, qr_scaled_upper);
    let pr_denominator: Nat = mul(p.den, r.den);
    let doubled_pr_denominator: Nat = add(pr_denominator, pr_denominator);
    let doubled_pr_gap: Nat = mul(double_precision, pr_gap);
    let precision_pr_gap: Nat = mul(precision, pr_gap);
    let two: Nat = Nat::Succ { prev: (Nat::Succ { prev: Nat::Zero }) };

    rat_close_triangle_factorization(p, q, r, precision);
    rat_gap_triangle_scaled(p, q, r);
    mul_le_mul_right(triangle_lower, triangle_upper, double_precision);
    mul_le_mul_right(
        pq_close_lower,
        pq_close_upper,
        r.den
    );
    mul_le_mul_right(
        qr_close_lower,
        qr_close_upper,
        p.den
    );
    add_le_add(
        pq_scaled_lower,
        pq_scaled_upper,
        qr_scaled_lower,
        qr_scaled_upper
    );
    le_trans(
        scaled_triangle_lower,
        summed_lower,
        summed_upper
    );
    mul_le_cancel_right(
        doubled_pr_gap,
        doubled_pr_denominator,
        q.den
    );
    mul_one_right(precision_pr_gap);
    mul_succ_right(precision_pr_gap, Nat::Succ { prev: Nat::Zero });
    mul_one_right(pr_denominator);
    mul_succ_right(pr_denominator, Nat::Succ { prev: Nat::Zero });
    le_one_succ(Nat::Succ { prev: Nat::Zero });
    mul_le_cancel_right(
        precision_pr_gap,
        pr_denominator,
        two
    );
}
