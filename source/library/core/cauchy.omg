use {omega}/language/core/foundation.omg as proof;
use nat.omg;
use nat_metric.omg;
use rat.omg;

// Constructive Cauchy obligations over core Rat's division-free metric.
//
// Quantification uses Omega's ordinary theorem-machine rule: `precision`,
// `left_index`, and `right_index` are arbitrary symbolic inputs. A modulus is
// a static machine, so no callable value or proof object exists at runtime.
// Each selected generator and modulus must publish unconditional termination;
// a predicate cannot assign a mathematical value to a partial invocation.
// `cauchy_at == Zero` is the point obligation after both indices have reached
// that modulus. `converges_together_at == Zero` is the heterogeneous twin for
// two generators and is the atom from which the Real quotient relation will
// be built.

machine cauchy_at<machine Sequence, machine Modulus>(
    precision: |nat|::Nat,
    left_index: |nat|::Nat,
    right_index: |nat|::Nat
) -> |nat|::Nat
requires machine Sequence(index: |nat|::Nat) -> |rat|::Rat terminates;
requires machine Modulus(precision: |nat|::Nat) -> |nat|::Nat terminates;
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::Nat::Succ { prev: |nat|::Nat::Zero }, precision), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(precision), left_index), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(precision), right_index), |nat|::Nat::Zero)
{
    let left: |rat|::Rat = Sequence(left_index);
    let right: |rat|::Rat = Sequence(right_index);
    transition { _ -> (|rat|::rat_close(left, right, precision)) }
}

machine converges_together_at<machine Left, machine Right, machine Modulus>(
    precision: |nat|::Nat,
    left_index: |nat|::Nat,
    right_index: |nat|::Nat
) -> |nat|::Nat
requires machine Left(index: |nat|::Nat) -> |rat|::Rat terminates;
requires machine Right(index: |nat|::Nat) -> |rat|::Rat terminates;
requires machine Modulus(precision: |nat|::Nat) -> |nat|::Nat terminates;
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::Nat::Succ { prev: |nat|::Nat::Zero }, precision), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(precision), left_index), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(precision), right_index), |nat|::Nat::Zero)
{
    let left: |rat|::Rat = Left(left_index);
    let right: |rat|::Rat = Right(right_index);
    transition { _ -> (|rat|::rat_close(left, right, precision)) }
}

machine cauchy_at_reflexive<machine Sequence, machine Modulus>(
    precision: |nat|::Nat,
    index: |nat|::Nat
)
requires machine Sequence(index: |nat|::Nat) -> |rat|::Rat terminates;
requires machine Modulus(precision: |nat|::Nat) -> |nat|::Nat terminates;
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::Nat::Succ { prev: |nat|::Nat::Zero }, precision), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(precision), index), |nat|::Nat::Zero)
ensures
    |proof|::Identity::<|nat|::Nat>(cauchy_at::<Sequence, Modulus>(precision, index, index), |nat|::Nat::Zero)
{
    let value: |rat|::Rat = Sequence(index);
    |rat|::rat_close_reflexive(value, precision);
}

machine converges_together_at_symmetric<
    machine Left,
    machine Right,
    machine Modulus
>(
    precision: |nat|::Nat,
    left_index: |nat|::Nat,
    right_index: |nat|::Nat
)
requires machine Left(index: |nat|::Nat) -> |rat|::Rat terminates;
requires machine Right(index: |nat|::Nat) -> |rat|::Rat terminates;
requires machine Modulus(precision: |nat|::Nat) -> |nat|::Nat terminates;
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::Nat::Succ { prev: |nat|::Nat::Zero }, precision), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(precision), left_index), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(precision), right_index), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(
        converges_together_at::<Left, Right, Modulus>(
            precision,
            left_index,
            right_index
        ),
        |nat|::Nat::Zero
    )
ensures
    |proof|::Identity::<|nat|::Nat>(
        converges_together_at::<Right, Left, Modulus>(
            precision,
            right_index,
            left_index
        ),
        |nat|::Nat::Zero
    )
{
    let left: |rat|::Rat = Left(left_index);
    let right: |rat|::Rat = Right(right_index);
    |rat|::rat_close_symmetric(left, right, precision);
}

// Pointwise transitivity consumes the doubled-precision Left~Middle and
// Middle~Right obligations at one shared middle index.  All quantifier-side
// admissibility remains explicit: both precision levels, every modulus
// threshold used by either premise or conclusion, and positivity of the
// actual middle sample's denominator are ordinary requires facts.
machine converges_together_at_triangle_split<
    machine Left,
    machine Middle,
    machine Right,
    machine Modulus
>(
    precision: |nat|::Nat,
    left_index: |nat|::Nat,
    middle_index: |nat|::Nat,
    right_index: |nat|::Nat
)
requires machine Left(index: |nat|::Nat) -> |rat|::Rat terminates;
requires machine Middle(index: |nat|::Nat) -> |rat|::Rat terminates;
requires machine Right(index: |nat|::Nat) -> |rat|::Rat terminates;
requires machine Modulus(precision: |nat|::Nat) -> |nat|::Nat terminates;
requires
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(|nat|::Nat::Succ { prev: |nat|::Nat::Zero }, precision), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(
        |nat|::saturating_sub(
            |nat|::Nat::Succ { prev: |nat|::Nat::Zero },
            |nat|::add(precision, precision)
        ),
        |nat|::Nat::Zero
    ),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(precision), left_index), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(precision), right_index), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(|nat|::add(precision, precision)), left_index), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(|nat|::add(precision, precision)), middle_index), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(|nat|::saturating_sub(Modulus(|nat|::add(precision, precision)), right_index), |nat|::Nat::Zero),
    |proof|::Identity::<|nat|::Nat>(
        |nat|::saturating_sub(
            |nat|::Nat::Succ { prev: |nat|::Nat::Zero },
            (Middle(middle_index)).den
        ),
        |nat|::Nat::Zero
    ),
    |proof|::Identity::<|nat|::Nat>(
        converges_together_at::<Left, Middle, Modulus>(
            |nat|::add(precision, precision),
            left_index,
            middle_index
        ),
        |nat|::Nat::Zero
    ),
    |proof|::Identity::<|nat|::Nat>(
        converges_together_at::<Middle, Right, Modulus>(
            |nat|::add(precision, precision),
            middle_index,
            right_index
        ),
        |nat|::Nat::Zero
    )
ensures
    |proof|::Identity::<|nat|::Nat>(
        converges_together_at::<Left, Right, Modulus>(
            precision,
            left_index,
            right_index
        ),
        |nat|::Nat::Zero
    )
{
    let left: |rat|::Rat = Left(left_index);
    let middle: |rat|::Rat = Middle(middle_index);
    let right: |rat|::Rat = Right(right_index);
    |rat|::rat_close_triangle_split(left, middle, right, precision);
}

// HETEROGENEOUS MODULUS COMPOSITION.  `converges_together_at_triangle_split`
// transports closeness across one shared modulus; the quotient relation's
// transitivity instead has to compose two independent witnesses: Left~Middle
// certified by LeftModulus and Middle~Right by RightModulus.  The composed
// modulus for a requested precision is the doubled-precision maximum
// `nat_max(LeftModulus(2e), RightModulus(2e))` -- beyond it, both premises hold
// at 2e and the rational triangle law closes the gap at e.  A machine-level
// combinator keeps the composed modulus a static machine, so it occupies a
// `requires machine` binder exactly like an atomic modulus.
machine doubled_nat_max_modulus<machine FirstModulus, machine SecondModulus>(
    precision: |nat|::Nat
) -> |nat|::Nat
requires machine FirstModulus(precision: |nat|::Nat) -> |nat|::Nat terminates;
requires machine SecondModulus(precision: |nat|::Nat) -> |nat|::Nat terminates;
{
    // Each selected invocation consumes its own affine proof-number value.
    let first_threshold: |nat|::Nat = FirstModulus(|nat|::add(precision, precision));
    let second_threshold: |nat|::Nat = SecondModulus(|nat|::add(precision, precision));
    transition { _ -> (|nat_metric|::nat_max(first_threshold, second_threshold)) }
}

// Threshold transfer for the composed modulus: an index that has crossed both
// doubled-precision thresholds has crossed their nat_max.  This discharges the
// composed-modulus admissibility facts of the heterogeneous transitivity
// theorem from the per-modulus premises' thresholds: the caller supplies both
// premise thresholds at 2e and receives the composed threshold at e.
machine doubled_nat_max_threshold<
    machine FirstModulus,
    machine SecondModulus
>(
    precision: |nat|::Nat,
    index: |nat|::Nat
)
requires machine FirstModulus(precision: |nat|::Nat) -> |nat|::Nat terminates;
requires machine SecondModulus(precision: |nat|::Nat) -> |nat|::Nat terminates;
requires
    |proof|::Identity::<|nat|::Nat>(
        |nat|::saturating_sub(
            FirstModulus(|nat|::add(precision, precision)),
            index
        ),
        |nat|::Nat::Zero
    ),
    |proof|::Identity::<|nat|::Nat>(
        |nat|::saturating_sub(
            SecondModulus(|nat|::add(precision, precision)),
            index
        ),
        |nat|::Nat::Zero
    )
ensures
    |proof|::Identity::<|nat|::Nat>(
        |nat|::saturating_sub(
            doubled_nat_max_modulus::<FirstModulus, SecondModulus>(precision),
            index
        ),
        |nat|::Nat::Zero
    )
{
    _ = |nat_metric|::nat_max_le(
        FirstModulus(|nat|::add(precision, precision)),
        SecondModulus(|nat|::add(precision, precision)),
        index
    );
}

// Heterogeneous transitivity, `converges_together_at_composed`, is not yet
// provided here. The threshold lemma above supplies its composed-modulus
// admissibility; a future theorem must still cite the rational triangle law
// with both independent doubled-precision premises.
