// Constructive Cauchy obligations over core Rat's division-free metric.
//
// Quantification uses Omega's ordinary theorem-machine rule: `precision`,
// `left_index`, and `right_index` are arbitrary symbolic inputs. A modulus is
// a static machine, so no callable value or proof object exists at runtime.
// `cauchy_at == Zero` is the point obligation after both indices have reached
// that modulus. `converges_together_at == Zero` is the heterogeneous twin for
// two generators and is the atom from which the Real quotient relation will
// be built.
use omega::language::core::rat;

machine cauchy_at<machine Sequence, machine Modulus>(
    precision: Nat,
    left_index: Nat,
    right_index: Nat
) -> Nat
where machine Sequence(index: Nat) -> Rat;
where machine Modulus(precision: Nat) -> Nat;
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, precision)) == Nat::Zero;
    (saturating_sub(Modulus(precision), left_index)) == Nat::Zero;
    (saturating_sub(Modulus(precision), right_index)) == Nat::Zero
{
    let left: Rat = Sequence(left_index);
    let right: Rat = Sequence(right_index);
    transition { _ -> (rat_close(left, right, precision)) }
}

machine converges_together_at<machine Left, machine Right, machine Modulus>(
    precision: Nat,
    left_index: Nat,
    right_index: Nat
) -> Nat
where machine Left(index: Nat) -> Rat;
where machine Right(index: Nat) -> Rat;
where machine Modulus(precision: Nat) -> Nat;
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, precision)) == Nat::Zero;
    (saturating_sub(Modulus(precision), left_index)) == Nat::Zero;
    (saturating_sub(Modulus(precision), right_index)) == Nat::Zero
{
    let left: Rat = Left(left_index);
    let right: Rat = Right(right_index);
    transition { _ -> (rat_close(left, right, precision)) }
}

machine cauchy_at_reflexive<machine Sequence, machine Modulus>(
    precision: Nat,
    index: Nat
)
where machine Sequence(index: Nat) -> Rat;
where machine Modulus(precision: Nat) -> Nat;
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, precision)) == Nat::Zero;
    (saturating_sub(Modulus(precision), index)) == Nat::Zero
ensures
    (cauchy_at<Sequence, Modulus>(precision, index, index)) == Nat::Zero
{
    let value: Rat = Sequence(index);
    rat_close_reflexive(value, precision);
}

machine converges_together_at_symmetric<
    machine Left,
    machine Right,
    machine Modulus
>(
    precision: Nat,
    left_index: Nat,
    right_index: Nat
)
where machine Left(index: Nat) -> Rat;
where machine Right(index: Nat) -> Rat;
where machine Modulus(precision: Nat) -> Nat;
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, precision)) == Nat::Zero;
    (saturating_sub(Modulus(precision), left_index)) == Nat::Zero;
    (saturating_sub(Modulus(precision), right_index)) == Nat::Zero;
    (converges_together_at<Left, Right, Modulus>(
        precision,
        left_index,
        right_index
    )) == Nat::Zero
ensures
    (converges_together_at<Right, Left, Modulus>(
        precision,
        right_index,
        left_index
    )) == Nat::Zero
{
    let left: Rat = Left(left_index);
    let right: Rat = Right(right_index);
    rat_close_symmetric(left, right, precision);
}

// Pointwise transitivity consumes the doubled-precision Left~Middle and
// Middle~Right obligations at one shared middle index.  All quantifier-side
// admissibility remains explicit: both precision levels, every modulus
// threshold used by either premise or conclusion, and positivity of the
// actual middle sample's denominator are ordinary requires facts.
machine converges_together_at_triangle_split<
    machine Left,
    machine Middle,
    machine Right,
    machine Modulus
>(
    precision: Nat,
    left_index: Nat,
    middle_index: Nat,
    right_index: Nat
)
where machine Left(index: Nat) -> Rat;
where machine Middle(index: Nat) -> Rat;
where machine Right(index: Nat) -> Rat;
where machine Modulus(precision: Nat) -> Nat;
requires
    (saturating_sub(Nat::Succ { prev: Nat::Zero }, precision)) == Nat::Zero;
    (saturating_sub(
        Nat::Succ { prev: Nat::Zero },
        add(precision, precision)
    )) == Nat::Zero;
    (saturating_sub(Modulus(precision), left_index)) == Nat::Zero;
    (saturating_sub(Modulus(precision), right_index)) == Nat::Zero;
    (saturating_sub(Modulus(add(precision, precision)), left_index)) == Nat::Zero;
    (saturating_sub(Modulus(add(precision, precision)), middle_index)) == Nat::Zero;
    (saturating_sub(Modulus(add(precision, precision)), right_index)) == Nat::Zero;
    (saturating_sub(
        Nat::Succ { prev: Nat::Zero },
        (Middle(middle_index)).den
    )) == Nat::Zero;
    (converges_together_at<Left, Middle, Modulus>(
        add(precision, precision),
        left_index,
        middle_index
    )) == Nat::Zero;
    (converges_together_at<Middle, Right, Modulus>(
        add(precision, precision),
        middle_index,
        right_index
    )) == Nat::Zero
ensures
    (converges_together_at<Left, Right, Modulus>(
        precision,
        left_index,
        right_index
    )) == Nat::Zero
{
    let left: Rat = Left(left_index);
    let middle: Rat = Middle(middle_index);
    let right: Rat = Right(right_index);
    rat_close_triangle_split(left, middle, right, precision);
}
