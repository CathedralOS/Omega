// Compiler-owned resource-content projection surface.
//
// Ordinary linear claims remain whole claims. An exact semantic
// qualification becomes content-bearing only when its owner publishes one
// checked machine satisfying `Content<A>::project`; `A` is one of the closed
// compiler-normalized content algebras below. The conformance body is proof
// material and adds no runtime metadata to the qualified carrier.
use omega::language::core::nat;

// A struct literal introduces one half-open member. Compiler normalization
// lifts it into the canonical finite interval-set term used by `separate` and
// residual difference; this proof-only carrier never acquires runtime layout.
data IntervalSet<CoordinateSpace> {
    start: Nat;
    end: Nat;
}

data CountedQuantity<Unit> {
    magnitude: Nat;
}

pub trait Content<A> {
    machine project(subject: &Self) -> A;
}

// Conservation contracts call the exact owner projection above around the
// proof-only `old(&place)` and `separate(a, b, ...)` term formers. `old`
// selects the same callable-entry revision used by scoped-fact and borrow
// certificates; it is not a runtime snapshot. Neither term may be implemented,
// overridden, stored, or executed. The retired `entry(&place)` spelling is
// rejected rather than treated as an alias for `old(&place)`.

// Uniform specification-number injection. Every fixed-width integer and
// address embeds into proof Int with its complete carrier range; a consumer
// that needs a nonnegative algebra must perform an explicit exact `as Nat`
// conversion and discharge nonnegativity from that derived range. The content-
// fragment validator admits this surface only for u8/u16/u32/u64/addr subject
// fields; arbitrary calls and non-scalar arguments remain outside the fragment.
boundary machine embed<T>(value: T) -> Int;
