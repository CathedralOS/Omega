public boundary trait FilesystemContentWrite { }
public boundary trait FilesystemMetadataQuery { }
public boundary trait FilesystemMetadataMutation { }
public boundary trait DirectoryEnumeration { }
public boundary trait FilesystemNamespaceMutation { }
