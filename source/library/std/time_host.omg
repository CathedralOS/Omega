use targets/linux_x86_64/time_host_impl.omg as linux_x86_64_time_read;
use targets/linux_arm64/time_host_impl.omg as linux_arm64_time_read;
use targets/macos_arm64/time_host_impl.omg as macos_arm64_time_read;
use targets/windows_x86_64/time_host_impl.omg as windows_x86_64_time_read;

// Each hosted target implements TimeHost with scalar clock readings and a
// millisecond wait. A wall clock read returns one raw u64 value. The target supplies its
// units per second and its epoch offset so the checked Time wrapper in
// time.omg can convert the reading to Unix time.
//
//
//   unix_seconds          = raw / units - epoch_offset
//   subsecond_nanoseconds = (raw % units) * 1_000_000_000 / units
//     (fits u64 for every real clock: units <= 18_446_744_073, guarded once
//      at calibration)
//
// A scalar trait surface does not mean every kernel hands back a scalar. Where
// one does not, its provider owns exactly the irreducible assembly and nothing
// more: the Linux providers turn `clock_gettime`'s two 64-bit timespec fields
// into one tick count with a single multiply-and-add, and Windows reads
// FILETIME's two DWORDs as the one little-endian u64 that ULARGE_INTEGER
// names. Neither touches `units` or `epoch_offset`.
//
// Per-target reference — every hosted target has a provider:
//   windows: QueryPerformanceCounter/-Frequency (out-param),
//            GetSystemTimePreciseAsFileTime raw=FILETIME u64,
//            units 10_000_000, epoch offset 11_644_473_600 (1601 -> 1970)
//   darwin:  clock_gettime_nsec_np(CLOCK_UPTIME_RAW / CLOCK_REALTIME),
//            units 1_000_000_000, epoch offset 0; arm64 and x86_64 share
//            the checked implementation with separate target-keyed bindings
//   linux:   clock_gettime(CLOCK_MONOTONIC / CLOCK_REALTIME) through a
//            borrowed timespec, units 1_000_000_000, epoch offset 0. The
//            syscall number is per-architecture, NOT per-OS: 228 on x86-64's
//            own table, 113 on arm64's asm-generic table.
//   uefi_x86_64 has no Console or ProcessExit provider either and keeps its
//            settlement gap; it is not a hosted target.
//
// Psi runs the selected target's time provider. The CLI supplies the host
// clock for raw reads and waits. An embedding can instead supply a clock
// snapshot whose stored time advances only on waits.

// Package Build selects each ordinary checked implementation. The two Darwin
// targets share one implementation and raw requirement schema; their Build
// rows still derive distinct target calling plans and native backing.
public boundary trait TimeHost {
    // Monotonic, never-decreasing tick counter since an unspecified epoch.
    // Only differences are meaningful. Each hosted read may enter its raw
    // time trait; the trait name is a synchronous invocation, not extra reach.
    machine monotonic_ticks() -> u64
    reaches TimeHost
    invokes |linux_x86_64_time_read|::LinuxX64TimeRead
    invokes |linux_arm64_time_read|::LinuxArm64TimeRead
    invokes |macos_arm64_time_read|::DarwinTimeRead
    invokes |windows_x86_64_time_read|::WindowsTimeRead
    crashes none;
    // Ticks per second for monotonic_ticks. Stable for the process lifetime.
    // Windows reads the frequency through the same raw trait; other hosts
    // return a constant.
    machine monotonic_ticks_per_second() -> u64
    reaches TimeHost
    invokes |windows_x86_64_time_read|::WindowsTimeRead
    crashes none;
    // Wall clock: ONE non-tearing read, raw platform units since the
    // platform epoch.
    machine wall_clock_raw() -> u64
    reaches TimeHost
    invokes |linux_x86_64_time_read|::LinuxX64TimeRead
    invokes |linux_arm64_time_read|::LinuxArm64TimeRead
    invokes |macos_arm64_time_read|::DarwinTimeRead
    invokes |windows_x86_64_time_read|::WindowsTimeRead
    crashes none;
    // Units per second for wall_clock_raw (constant per target).
    machine wall_clock_units_per_second() -> u64 reaches TimeHost crashes none;
    // Platform-epoch -> Unix-epoch shift, in seconds (constant per target).
    machine wall_clock_epoch_offset_seconds() -> u64 reaches TimeHost crashes none;
    // Millisecond sleep. The Darwin and Linux x86-64 providers wait with
    // poll, Linux arm64 with nanosleep (the asm-generic table publishes no
    // poll), and Windows with kernel32 `Sleep` bound as `WindowsTimeRead::sleep`.
    machine sleep(milliseconds: u32)
    reaches TimeHost
    invokes |linux_x86_64_time_read|::LinuxX64TimeRead
    invokes |linux_arm64_time_read|::LinuxArm64TimeRead
    invokes |macos_arm64_time_read|::DarwinTimeRead
    invokes |windows_x86_64_time_read|::WindowsTimeRead
    blocks
    crashes none;
}
