use targets::macos_arm64::DarwinTimeRead;
use targets::macos_arm64::darwin_time_host_wait_part;
use omega::language::core::narrow_u32_to_i32_wrapping;

public DarwinTimeHost satisfies TimeHost {
    machine monotonic_ticks() -> u64
    reaches TimeHost
    invokes DarwinTimeRead
    {
        DarwinTimeRead::clock_nanoseconds(8)
    }

    machine monotonic_ticks_per_second() -> u64
    {
        1000000000
    }

    machine wall_clock_raw() -> u64
    reaches TimeHost
    invokes DarwinTimeRead
    {
        DarwinTimeRead::clock_nanoseconds(0)
    }

    machine wall_clock_units_per_second() -> u64
    {
        1000000000
    }

    machine wall_clock_epoch_offset_seconds() -> u64
    {
        0
    }

    // Split large waits into signed-representable poll timeouts.
    machine sleep(milliseconds: u32)
    reaches TimeHost
    invokes DarwinTimeRead
    blocks
    {
        transition milliseconds > 2147483647 {
            true -> block in_parts(milliseconds),
            _ -> block at_once(milliseconds)
        }

        machine at_once(milliseconds: u32) {
            block darwin_time_host_wait_part(narrow_u32_to_i32_wrapping(milliseconds));
        }

        machine in_parts(milliseconds: u32) {
            let third: i32 = narrow_u32_to_i32_wrapping(milliseconds / 3);
            block darwin_time_host_wait_part(third);
            block darwin_time_host_wait_part(third);
            block darwin_time_host_wait_part(third);
            block darwin_time_host_wait_part(narrow_u32_to_i32_wrapping(milliseconds % 3));
        }
    }
}
