// macos_x86_64 `Filesystem` DIRECTORY-WALK implementations (fs portable-contract
// settle 2026-07-18; bodies moved VERBATIM from filesystem.omg the same day).
// The paradigm-split ops -- dirent-record walking and the dirfd-relative
// removal recursion -- live PER TARGET behind the portable contract declared
// beside the wrapper (filesystem.omg's directory-walk contract block). This
// file is darwin's paradigm: a single `read_dir` fill of packed
// `___getdirentries64` records (d_reclen@16, d_namlen@18, d_type@20, name@21),
// and `open_at`/`unlink_at` dirfd recursion for `remove_dir_all`. Every
// machine is target-scoped (`macos_x86_64 machine ...`): selected only when
// compiling for this target and inert otherwise.
//
// Darwin open flags are a foreign bitfield format, encoded by checked target
// package code rather than smuggled through provider-plan VALUE rows. The
// semantic `OpenOptions` value is portable; only this encoder owns Darwin's bit
// positions. Access mode 0/1/2 is the POSIX O_RDONLY/O_WRONLY/O_RDWR field.
// macOS arm64 Darwin `struct stat` layout. The policy is ordinary checked
// build-time Omega code; offsets and physical integer widths are foreign-format
// facts owned by this target package, not provider-plan scalar values.
macos_x86_64 machine StatLayout::plan(&mut self, schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::IntegerAt { offset: 0, stored_width: 32, interpretation: IntegerInterpretation::Unsigned } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::IntegerAt { offset: 4, stored_width: 16, interpretation: IntegerInterpretation::Unsigned } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::IntegerAt { offset: 6, stored_width: 16, interpretation: IntegerInterpretation::Unsigned } };
    entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 8 } };
    entries[4] = FieldEntry { key: schema.fields[4].key, placement: FieldPlan::At { offset: 16 } };
    entries[5] = FieldEntry { key: schema.fields[5].key, placement: FieldPlan::At { offset: 20 } };
    entries[6] = FieldEntry { key: schema.fields[6].key, placement: FieldPlan::IntegerAt { offset: 24, stored_width: 32, interpretation: IntegerInterpretation::Unsigned } };
    entries[7] = FieldEntry { key: schema.fields[7].key, placement: FieldPlan::At { offset: 32 } };
    entries[8] = FieldEntry { key: schema.fields[8].key, placement: FieldPlan::At { offset: 48 } };
    entries[9] = FieldEntry { key: schema.fields[9].key, placement: FieldPlan::At { offset: 64 } };
    entries[10] = FieldEntry { key: schema.fields[10].key, placement: FieldPlan::At { offset: 80 } };
    entries[11] = FieldEntry { key: schema.fields[11].key, placement: FieldPlan::At { offset: 96 } };
    entries[12] = FieldEntry { key: schema.fields[12].key, placement: FieldPlan::At { offset: 104 } };
    entries[13] = FieldEntry { key: schema.fields[13].key, placement: FieldPlan::IntegerAt { offset: 112, stored_width: 32, interpretation: IntegerInterpretation::Unsigned } };
    Plan { entries: entries, entry_count: 14, size_fixed: 144, size_is_dynamic: false, align: 8 }
}

macos_x86_64 machine Filesystem::encode_open_options(filesystem: &mut Filesystem) {
    filesystem.open_writable = (filesystem.open_options.write as i32) | (filesystem.open_options.append as i32);
    filesystem.open_readable = filesystem.open_options.read as i32;
    filesystem.open_creating = (filesystem.open_options.create as i32) | (filesystem.open_options.create_new as i32);
    filesystem.open_flags = ((filesystem.open_writable & (filesystem.open_readable ^ 1))
        | ((filesystem.open_writable & filesystem.open_readable) << 1)
        | ((filesystem.open_options.append as i32) << 3)
        | (filesystem.open_creating << 9)
        | ((filesystem.open_options.truncate as i32) << 10)
        | ((filesystem.open_options.create_new as i32) << 11));
}

// Darwin libc operations report -1 and retain detail in thread-local errno.
// The explicit result parameter keeps the portable wrapper shape aligned with
// Linux's direct-syscall path; it is intentionally not interpreted here.
macos_x86_64 machine Filesystem::native_error_code_i32(filesystem: &mut Filesystem, result: i32) -> i32
reaches FilesystemHost
{
    let code: i32 = filesystem.host.errno();
    code
}

macos_x86_64 machine Filesystem::native_error_code_i64(filesystem: &mut Filesystem, result: i64) -> i32
reaches FilesystemHost
{
    let code: i32 = filesystem.host.errno();
    code
}

pub macos_x86_64 machine Filesystem::open_with(filesystem: &mut Filesystem, path: &[u8] in Path, options: OpenOptions) -> OpenResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.open_options = options;
    Filesystem::encode_open_options(filesystem);
    let fd: i32 = filesystem.host.open_create(path, filesystem.open_flags, 438);
    transition fd >= 0 { true -> ok(fd) _ -> err(filesystem) }
    state ok(fd: i32) -> OpenResult { OpenResult::Ok { file: File { fd: fd } } }
    state err(filesystem: &mut Filesystem) -> OpenResult { let kind: ErrorKind = Filesystem::last_error(filesystem); OpenResult::Error { kind: kind } }
}

// List a directory and return its entry COUNT (Rust `fs::read_dir(path)?.count()`,
// excluding "." and ".."). Opens the directory, repeatedly fills a buffer of packed
// Darwin `dirent` records via the raw `read_dir` op, then walks them with a
// runtime-indexed cursor over the little-endian `d_reclen` at record offset +16
// (the same record layout as `___getdirentries64`, identical on both engines),
// advancing until the filled byte count. The descriptor cursor is retained across
// fills until EOF and the descriptor is closed exactly once on the terminal or
// error path. A malformed record fails as `Other` instead of making the state loop
// stall. "." and ".." are the first two records of every real directory, so the
// child count is `records - 2` after the complete drain.
pub macos_x86_64 machine Filesystem::read_dir_count(filesystem: &mut Filesystem, path: &[u8] in Path) -> IoResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.read_flags = 0;
    filesystem.rd_position = 0;
    filesystem.rd_off = 0;
    filesystem.rd_count = 0;
    let dfd: i32 = filesystem.host.open(path, filesystem.read_flags);
    transition dfd >= 0 { true -> rd_read(filesystem, dfd) _ -> rd_err(filesystem) }
    state rd_read(filesystem: &mut Filesystem, dfd: i32) -> IoResult {
        filesystem.rd_off = 0;
        let total: i64 = filesystem.host.read_dir(dfd, &mut filesystem.dir_buf, 512, &mut filesystem.rd_position);
        filesystem.rd_total = narrow_i64_to_u64_wrapping(total) as u64 in Wrapping;
        transition total > 0 { true -> rd_walk(filesystem, dfd) _ -> rd_nonpositive(filesystem, dfd, total) }
    }
    state rd_nonpositive(filesystem: &mut Filesystem, dfd: i32, total: i64) -> IoResult {
        transition total == 0 { true -> rd_finish(filesystem, dfd) _ -> rd_read_error(filesystem, dfd, total) }
    }
    state rd_walk(filesystem: &mut Filesystem, dfd: i32) -> IoResult {
        transition filesystem.rd_off < filesystem.rd_total { true -> rd_header(filesystem, dfd) _ -> rd_read(filesystem, dfd) }
    }
    state rd_header(filesystem: &mut Filesystem, dfd: i32) -> IoResult {
        transition filesystem.rd_off < 495 { true -> rd_body(filesystem, dfd) _ -> rd_malformed(filesystem, dfd) }
    }
    state rd_body(filesystem: &mut Filesystem, dfd: i32) -> IoResult {
        // d_reclen: little-endian u16 at record offset + 16 (RUNTIME-indexed reads).
        filesystem.rd_idx = filesystem.rd_off + 16;
        filesystem.rd_lo = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_idx = filesystem.rd_off + 17;
        filesystem.rd_hi = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_lou = widen_u8_to_u64(filesystem.rd_lo) as u64 in Wrapping;
        filesystem.rd_hiu = widen_u8_to_u64(filesystem.rd_hi) as u64 in Wrapping;
        filesystem.rd_reclen = (filesystem.rd_hiu << 8) | filesystem.rd_lou;
        transition filesystem.rd_reclen > 0 && filesystem.rd_off + filesystem.rd_reclen <= filesystem.rd_total { true -> rd_accept(filesystem, dfd) _ -> rd_malformed(filesystem, dfd) }
    }
    state rd_accept(filesystem: &mut Filesystem, dfd: i32) -> IoResult {
        filesystem.rd_count = filesystem.rd_count + 1;
        filesystem.rd_off = filesystem.rd_off + filesystem.rd_reclen;
        transition { _ -> rd_walk(filesystem, dfd) }
    }
    state rd_finish(filesystem: &mut Filesystem, dfd: i32) -> IoResult {
        let closed: i32 = filesystem.host.close(dfd);
        // Every real directory yields "." and ".." first, so children = records - 2.
        transition filesystem.rd_count > 2 { true -> rd_ok(filesystem) _ -> rd_empty() }
    }
    state rd_empty() -> IoResult { IoResult::Ok { count: 0 } }
    state rd_ok(filesystem: &mut Filesystem) -> IoResult {
        filesystem.rd_lou = narrow_i32_to_u64_wrapping((filesystem.rd_count - 2) as i32) as u64 in Wrapping;
        let count: u64 = filesystem.rd_lou as u64;
        IoResult::Ok { count: count }
    }
    state rd_err(filesystem: &mut Filesystem) -> IoResult {
        let kind: ErrorKind = Filesystem::last_error(filesystem);
        IoResult::Error { kind: kind }
    }
    state rd_read_error(filesystem: &mut Filesystem, dfd: i32, total: i64) -> IoResult {
        filesystem.err_kind = Filesystem::last_error_i64(filesystem, total);
        let closed: i32 = filesystem.host.close(dfd);
        let kind: ErrorKind = ErrorKind::reconstruct(&filesystem.err_kind);
        IoResult::Error { kind: kind }
    }
    state rd_malformed(filesystem: &mut Filesystem, dfd: i32) -> IoResult {
        let closed: i32 = filesystem.host.close(dfd);
        filesystem.err_kind = ErrorKind::Other;
        IoResult::Error { kind: ErrorKind::Other }
    }
}

// Summarize a directory's composition (`DirStats { entries, subdirs, files }`) --
// the type-aware companion to `read_dir_count`. The same complete multi-fill
// walk reads each record's `d_type` byte at offset +20 (within the `off < 492`
// bound) and tallies DT_DIR (4) vs DT_REG (8). "." and ".." are DT_DIR, so the
// child counts subtract 2 from both `entries` and `subdirs`. DT_UNKNOWN remains
// included in entries but in neither type-specific tally.
macos_x86_64 machine Filesystem::read_dir_stats(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirStatsResult
reaches FilesystemHost
{
    filesystem.read_flags = 0;
    filesystem.rd_position = 0;
    filesystem.rd_off = 0;
    filesystem.rd_count = 0;
    filesystem.rd_dirs = 0;
    filesystem.rd_files = 0;
    let dfd: i32 = filesystem.host.open(path, filesystem.read_flags);
    transition dfd >= 0 { true -> rds_read(filesystem, dfd) _ -> rds_err(filesystem) }
    state rds_read(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        filesystem.rd_off = 0;
        let total: i64 = filesystem.host.read_dir(dfd, &mut filesystem.dir_buf, 512, &mut filesystem.rd_position);
        filesystem.rd_total = narrow_i64_to_u64_wrapping(total) as u64 in Wrapping;
        transition total > 0 { true -> rds_walk(filesystem, dfd) _ -> rds_nonpositive(filesystem, dfd, total) }
    }
    state rds_nonpositive(filesystem: &mut Filesystem, dfd: i32, total: i64) -> DirStatsResult {
        transition total == 0 { true -> rds_finish(filesystem, dfd) _ -> rds_read_error(filesystem, dfd, total) }
    }
    state rds_walk(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        transition filesystem.rd_off < filesystem.rd_total { true -> rds_header(filesystem, dfd) _ -> rds_read(filesystem, dfd) }
    }
    state rds_header(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        transition filesystem.rd_off < 492 { true -> rds_body(filesystem, dfd) _ -> rds_malformed(filesystem, dfd) }
    }
    state rds_body(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        filesystem.rd_idx = filesystem.rd_off + 16;
        filesystem.rd_lo = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_idx = filesystem.rd_off + 17;
        filesystem.rd_hi = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_lou = widen_u8_to_u64(filesystem.rd_lo) as u64 in Wrapping;
        filesystem.rd_hiu = widen_u8_to_u64(filesystem.rd_hi) as u64 in Wrapping;
        filesystem.rd_reclen = (filesystem.rd_hiu << 8) | filesystem.rd_lou;
        filesystem.rd_idx = filesystem.rd_off + 20;
        filesystem.rd_dtype = filesystem.dir_buf[filesystem.rd_idx];
        transition filesystem.rd_reclen > 0 && filesystem.rd_off + filesystem.rd_reclen <= filesystem.rd_total { true -> rds_accept(filesystem, dfd) _ -> rds_malformed(filesystem, dfd) }
    }
    state rds_accept(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        filesystem.rd_count = filesystem.rd_count + 1;
        filesystem.rd_off = filesystem.rd_off + filesystem.rd_reclen;
        transition filesystem.rd_dtype == 4 { true -> rds_dir(filesystem, dfd) _ -> rds_maybe_file(filesystem, dfd) }
    }
    state rds_dir(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        filesystem.rd_dirs = filesystem.rd_dirs + 1;
        transition { _ -> rds_walk(filesystem, dfd) }
    }
    state rds_maybe_file(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        transition filesystem.rd_dtype == 8 { true -> rds_file(filesystem, dfd) _ -> rds_cont(filesystem, dfd) }
    }
    state rds_file(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        filesystem.rd_files = filesystem.rd_files + 1;
        transition { _ -> rds_walk(filesystem, dfd) }
    }
    state rds_cont(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        transition { _ -> rds_walk(filesystem, dfd) }
    }
    state rds_finish(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        let closed: i32 = filesystem.host.close(dfd);
        transition filesystem.rd_count > 2 { true -> rds_ok(filesystem) _ -> rds_empty() }
    }
    state rds_ok(filesystem: &mut Filesystem) -> DirStatsResult {
        let converted_entries: u64 = narrow_i32_to_u64_wrapping((filesystem.rd_count - 2) as i32);
        let converted_subdirs: u64 = narrow_i32_to_u64_wrapping((filesystem.rd_dirs - 2) as i32);
        let converted_files: u64 = narrow_i32_to_u64_wrapping(filesystem.rd_files as i32);
        DirStatsResult::Ok { stats: DirStats {
            entries: converted_entries,
            subdirs: converted_subdirs,
            files: converted_files,
        } }
    }
    state rds_empty() -> DirStatsResult {
        DirStatsResult::Ok { stats: DirStats { entries: 0, subdirs: 0, files: 0 } }
    }
    state rds_err(filesystem: &mut Filesystem) -> DirStatsResult {
        let kind: ErrorKind = Filesystem::last_error(filesystem);
        DirStatsResult::Error { kind: kind }
    }
    state rds_read_error(filesystem: &mut Filesystem, dfd: i32, total: i64) -> DirStatsResult {
        filesystem.err_kind = Filesystem::last_error_i64(filesystem, total);
        let closed: i32 = filesystem.host.close(dfd);
        let kind: ErrorKind = ErrorKind::reconstruct(&filesystem.err_kind);
        DirStatsResult::Error { kind: kind }
    }
    state rds_malformed(filesystem: &mut Filesystem, dfd: i32) -> DirStatsResult {
        let closed: i32 = filesystem.host.close(dfd);
        filesystem.err_kind = ErrorKind::Other;
        DirStatsResult::Error { kind: ErrorKind::Other }
    }
}

// Fetch the N-th CHILD directory entry as a `DirEntry` (Rust's `ReadDir` iterator,
// indexed): `read_dir_nth(path, 0)` is the first child, `1` the second, … . The
// caller loops n = 0, 1, 2, … until `End`. Walks complete dirent fills to record
// index `n + 2` (skipping "." and ".."), then EXTRACTS the name by copying
// `dir_buf[off+21+j]` into the entry's `[u8; 256]` name field with a field-cursor
// loop (the `ridx < 512` guard keeps each read in the buffer; `j < 255` keeps each
// write in the name field), and reads the `d_type` for `is_dir`/`is_file`.
//
// A name longer than 255 bytes is truncated (`name_len` is the copied length).
// The descriptor cursor remains open across fills and closes at the found, EOF,
// malformed-record, or syscall-error terminal.
pub macos_x86_64 machine Filesystem::read_dir_nth(filesystem: &mut Filesystem, path: &[u8] in Path, n: u64) -> DirEntryResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.read_flags = 0;
    filesystem.rd_position = 0;
    filesystem.rd_off = 0;
    filesystem.rd_recno = 0;
    filesystem.rd_target = (n as u64 in Wrapping) + 2;
    let dfd: i32 = filesystem.host.open(path, filesystem.read_flags);
    transition dfd >= 0 { true -> rdn_read(filesystem, dfd) _ -> rdn_err(filesystem) }
    state rdn_read(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        filesystem.rd_off = 0;
        let total: i64 = filesystem.host.read_dir(dfd, &mut filesystem.dir_buf, 512, &mut filesystem.rd_position);
        filesystem.rd_total = narrow_i64_to_u64_wrapping(total) as u64 in Wrapping;
        transition total > 0 { true -> rdn_walk(filesystem, dfd) _ -> rdn_nonpositive(filesystem, dfd, total) }
    }
    state rdn_nonpositive(filesystem: &mut Filesystem, dfd: i32, total: i64) -> DirEntryResult {
        transition total == 0 { true -> rdn_finish(filesystem, dfd) _ -> rdn_read_error(filesystem, dfd, total) }
    }
    state rdn_walk(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        transition filesystem.rd_off < filesystem.rd_total { true -> rdn_header(filesystem, dfd) _ -> rdn_read(filesystem, dfd) }
    }
    state rdn_header(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        transition filesystem.rd_off < 492 { true -> rdn_at(filesystem, dfd) _ -> rdn_malformed(filesystem, dfd) }
    }
    state rdn_at(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        transition filesystem.rd_recno == filesystem.rd_target { true -> rdn_found(filesystem, dfd) _ -> rdn_advance(filesystem, dfd) }
    }
    state rdn_advance(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        filesystem.rd_idx = filesystem.rd_off + 16;
        filesystem.rd_lo = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_idx = filesystem.rd_off + 17;
        filesystem.rd_hi = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_lou = widen_u8_to_u64(filesystem.rd_lo) as u64 in Wrapping;
        filesystem.rd_hiu = widen_u8_to_u64(filesystem.rd_hi) as u64 in Wrapping;
        filesystem.rd_reclen = (filesystem.rd_hiu << 8) | filesystem.rd_lou;
        transition filesystem.rd_reclen > 0 && filesystem.rd_off + filesystem.rd_reclen <= filesystem.rd_total { true -> rdn_accept(filesystem, dfd) _ -> rdn_malformed(filesystem, dfd) }
    }
    state rdn_accept(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        filesystem.rd_recno = filesystem.rd_recno + 1;
        filesystem.rd_off = filesystem.rd_off + filesystem.rd_reclen;
        transition { _ -> rdn_walk(filesystem, dfd) }
    }
    state rdn_found(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        let closed: i32 = filesystem.host.close(dfd);
        transition { _ -> rdn_extract(filesystem) }
    }
    state rdn_extract(filesystem: &mut Filesystem) -> DirEntryResult {
        filesystem.rd_idx = filesystem.rd_off + 18;
        filesystem.rd_lo = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_idx = filesystem.rd_off + 19;
        filesystem.rd_hi = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_lou = widen_u8_to_u64(filesystem.rd_lo) as u64 in Wrapping;
        filesystem.rd_hiu = widen_u8_to_u64(filesystem.rd_hi) as u64 in Wrapping;
        filesystem.rd_namlen = (filesystem.rd_hiu << 8) | filesystem.rd_lou;
        filesystem.rd_idx = filesystem.rd_off + 20;
        filesystem.rd_dtype = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_j = 0;
        transition { _ -> rdn_copy(filesystem) }
    }
    state rdn_copy(filesystem: &mut Filesystem) -> DirEntryResult {
        transition filesystem.rd_j < filesystem.rd_namlen { true -> rdn_cap(filesystem) _ -> rdn_build(filesystem) }
    }
    state rdn_cap(filesystem: &mut Filesystem) -> DirEntryResult {
        transition filesystem.rd_j < 255 { true -> rdn_cbyte(filesystem) _ -> rdn_build(filesystem) }
    }
    state rdn_cbyte(filesystem: &mut Filesystem) -> DirEntryResult {
        filesystem.rd_ridx = filesystem.rd_off + 21 + filesystem.rd_j;
        transition filesystem.rd_ridx < 512 && filesystem.rd_ridx < filesystem.rd_total { true -> rdn_cdo(filesystem) _ -> rdn_build(filesystem) }
    }
    state rdn_cdo(filesystem: &mut Filesystem) -> DirEntryResult {
        filesystem.rd_nb = filesystem.dir_buf[filesystem.rd_ridx];
        filesystem.entry_name[filesystem.rd_j] = filesystem.rd_nb;
        filesystem.rd_j = filesystem.rd_j + 1;
        transition { _ -> rdn_copy(filesystem) }
    }
    state rdn_build(filesystem: &mut Filesystem) -> DirEntryResult {
        transition filesystem.rd_dtype == 4 { true -> rdn_ok_dir(filesystem) _ -> rdn_maybe_file(filesystem) }
    }
    state rdn_ok_dir(filesystem: &mut Filesystem) -> DirEntryResult {
        let name_len: u64 = filesystem.rd_j as u64;
        DirEntryResult::Ok { entry: DirEntry {
            name: filesystem.entry_name,
            name_len: name_len,
            is_dir: true,
            is_file: false,
        } }
    }
    state rdn_maybe_file(filesystem: &mut Filesystem) -> DirEntryResult {
        transition filesystem.rd_dtype == 8 { true -> rdn_ok_file(filesystem) _ -> rdn_ok_other(filesystem) }
    }
    state rdn_ok_file(filesystem: &mut Filesystem) -> DirEntryResult {
        let name_len: u64 = filesystem.rd_j as u64;
        DirEntryResult::Ok { entry: DirEntry {
            name: filesystem.entry_name,
            name_len: name_len,
            is_dir: false,
            is_file: true,
        } }
    }
    state rdn_ok_other(filesystem: &mut Filesystem) -> DirEntryResult {
        let name_len: u64 = filesystem.rd_j as u64;
        DirEntryResult::Ok { entry: DirEntry {
            name: filesystem.entry_name,
            name_len: name_len,
            is_dir: false,
            is_file: false,
        } }
    }
    state rdn_finish(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        let closed: i32 = filesystem.host.close(dfd);
        DirEntryResult::End
    }
    state rdn_err(filesystem: &mut Filesystem) -> DirEntryResult {
        let kind: ErrorKind = Filesystem::last_error(filesystem);
        DirEntryResult::Error { kind: kind }
    }
    state rdn_read_error(filesystem: &mut Filesystem, dfd: i32, total: i64) -> DirEntryResult {
        filesystem.err_kind = Filesystem::last_error_i64(filesystem, total);
        let closed: i32 = filesystem.host.close(dfd);
        let kind: ErrorKind = ErrorKind::reconstruct(&filesystem.err_kind);
        DirEntryResult::Error { kind: kind }
    }
    state rdn_malformed(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        let closed: i32 = filesystem.host.close(dfd);
        filesystem.err_kind = ErrorKind::Other;
        DirEntryResult::Error { kind: ErrorKind::Other }
    }
}

// Fetch the N-th CHILD entry as a `DirEntry`, reading an ALREADY-OPEN directory fd
// (the caller OWNS `dfd`; it is not closed here). Skips "." and ".." (records 0,1)
// to record n+2 across as many fills as needed and copies the name into the
// entry's field. This is the fd-based core `remove_dir_all` drains through (it
// rewinds and re-reads the same fd after each removal).
// NOTE: the dirent walk here duplicates `read_dir_nth`'s (which opens+closes a
// path); a future refactor should route `read_dir_nth` through this fd core.
macos_x86_64 machine Filesystem::read_dir_entry_fd(filesystem: &mut Filesystem, dfd: i32, n: u64) -> DirEntryResult
reaches FilesystemHost
{
    filesystem.rd_position = 0;
    filesystem.rd_off = 0;
    filesystem.rd_recno = 0;
    filesystem.rd_target = (n as u64 in Wrapping) + 2;
    // REWIND the directory fd before reading (2026-07-09j): the native
    // getdirentries cursor is the FD OFFSET -- zeroing the basep out-param
    // does not rewind it, so a second "first entry" read on the same fd
    // returned End natively while the hermetic interpreter (which reads at
    // the passed position) returned the entry. The drain's per-iteration
    // first-entry re-reads depend on this. lseek(dfd, 0, SEEK_SET) is a
    // no-op for the interpreter's model and rewinds the native cursor.
    filesystem.rd_seek_rc = filesystem.host.seek(dfd, 0, 0);
    let seek_rc: i64 = filesystem.rd_seek_rc;
    transition seek_rc >= 0 { true -> rdef_read(filesystem, dfd) _ -> rdef_err(filesystem, seek_rc) }
    state rdef_read(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        filesystem.rd_off = 0;
        let total: i64 = filesystem.host.read_dir(dfd, &mut filesystem.dir_buf, 512, &mut filesystem.rd_position);
        filesystem.rd_total = narrow_i64_to_u64_wrapping(total) as u64 in Wrapping;
        transition total > 0 { true -> rdef_walk(filesystem, dfd) _ -> rdef_nonpositive(filesystem, total) }
    }
    state rdef_nonpositive(filesystem: &mut Filesystem, total: i64) -> DirEntryResult {
        transition total == 0 { true -> rdef_end() _ -> rdef_err(filesystem, total) }
    }
    state rdef_err(filesystem: &mut Filesystem, total: i64) -> DirEntryResult {
        filesystem.rda_rc = narrow_i64_to_i32_wrapping(total);
        filesystem.err_kind = Filesystem::last_error_i64(filesystem, total);
        let kind: ErrorKind = ErrorKind::reconstruct(&filesystem.err_kind);
        DirEntryResult::Error { kind: kind }
    }
    state rdef_walk(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        transition filesystem.rd_off < filesystem.rd_total { true -> rdef_header(filesystem, dfd) _ -> rdef_read(filesystem, dfd) }
    }
    state rdef_header(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        transition filesystem.rd_off < 492 { true -> rdef_at(filesystem, dfd) _ -> rdef_malformed(filesystem) }
    }
    state rdef_at(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        transition filesystem.rd_recno == filesystem.rd_target { true -> rdef_extract(filesystem) _ -> rdef_advance(filesystem, dfd) }
    }
    state rdef_advance(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        filesystem.rd_idx = filesystem.rd_off + 16;
        filesystem.rd_lo = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_idx = filesystem.rd_off + 17;
        filesystem.rd_hi = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_lou = widen_u8_to_u64(filesystem.rd_lo) as u64 in Wrapping;
        filesystem.rd_hiu = widen_u8_to_u64(filesystem.rd_hi) as u64 in Wrapping;
        filesystem.rd_reclen = (filesystem.rd_hiu << 8) | filesystem.rd_lou;
        transition filesystem.rd_reclen > 0 && filesystem.rd_off + filesystem.rd_reclen <= filesystem.rd_total { true -> rdef_accept(filesystem, dfd) _ -> rdef_malformed(filesystem) }
    }
    state rdef_accept(filesystem: &mut Filesystem, dfd: i32) -> DirEntryResult {
        filesystem.rd_recno = filesystem.rd_recno + 1;
        filesystem.rd_off = filesystem.rd_off + filesystem.rd_reclen;
        transition { _ -> rdef_walk(filesystem, dfd) }
    }
    state rdef_extract(filesystem: &mut Filesystem) -> DirEntryResult {
        filesystem.rd_idx = filesystem.rd_off + 18;
        filesystem.rd_lo = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_idx = filesystem.rd_off + 19;
        filesystem.rd_hi = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_lou = widen_u8_to_u64(filesystem.rd_lo) as u64 in Wrapping;
        filesystem.rd_hiu = widen_u8_to_u64(filesystem.rd_hi) as u64 in Wrapping;
        filesystem.rd_namlen = (filesystem.rd_hiu << 8) | filesystem.rd_lou;
        filesystem.rd_idx = filesystem.rd_off + 20;
        filesystem.rd_dtype = filesystem.dir_buf[filesystem.rd_idx];
        filesystem.rd_j = 0;
        transition { _ -> rdef_copy(filesystem) }
    }
    state rdef_copy(filesystem: &mut Filesystem) -> DirEntryResult {
        transition filesystem.rd_j < filesystem.rd_namlen { true -> rdef_cap(filesystem) _ -> rdef_nul(filesystem) }
    }
    // NUL-terminate the copied name (2026-07-09k): `entry_name` is a REUSED
    // machine buffer, so a shorter name over a longer one left the previous
    // tail ("b" over "f1.txt" read back as "b1.txt") -- unlink_at/open_at
    // take the subslice's POINTER and read to the NUL, so the stale tail was
    // passed to the kernel (ENOENT; the drain's parent-remove step failed).
    // The interpreter slices by LENGTH, which is why only native diverged.
    state rdef_nul(filesystem: &mut Filesystem) -> DirEntryResult {
        transition filesystem.rd_j < 256 { true -> rdef_nul_go(filesystem) _ -> rdef_build(filesystem) }
    }
    state rdef_nul_go(filesystem: &mut Filesystem) -> DirEntryResult {
        filesystem.entry_name[filesystem.rd_j] = 0;
        transition { _ -> rdef_build(filesystem) }
    }
    state rdef_cap(filesystem: &mut Filesystem) -> DirEntryResult {
        transition filesystem.rd_j < 255 { true -> rdef_cbyte(filesystem) _ -> rdef_nul(filesystem) }
    }
    state rdef_cbyte(filesystem: &mut Filesystem) -> DirEntryResult {
        filesystem.rd_ridx = filesystem.rd_off + 21 + filesystem.rd_j;
        transition filesystem.rd_ridx < 512 && filesystem.rd_ridx < filesystem.rd_total { true -> rdef_cdo(filesystem) _ -> rdef_nul(filesystem) }
    }
    state rdef_cdo(filesystem: &mut Filesystem) -> DirEntryResult {
        filesystem.rd_nb = filesystem.dir_buf[filesystem.rd_ridx];
        filesystem.entry_name[filesystem.rd_j] = filesystem.rd_nb;
        filesystem.rd_j = filesystem.rd_j + 1;
        transition { _ -> rdef_copy(filesystem) }
    }
    state rdef_build(filesystem: &mut Filesystem) -> DirEntryResult {
        transition filesystem.rd_dtype == 4 { true -> rdef_ok_dir(filesystem) _ -> rdef_maybe_file(filesystem) }
    }
    state rdef_ok_dir(filesystem: &mut Filesystem) -> DirEntryResult {
        let name_len: u64 = filesystem.rd_j as u64;
        DirEntryResult::Ok { entry: DirEntry { name: filesystem.entry_name, name_len: name_len, is_dir: true, is_file: false } }
    }
    state rdef_maybe_file(filesystem: &mut Filesystem) -> DirEntryResult {
        transition filesystem.rd_dtype == 8 { true -> rdef_ok_file(filesystem) _ -> rdef_ok_other(filesystem) }
    }
    state rdef_ok_file(filesystem: &mut Filesystem) -> DirEntryResult {
        let name_len: u64 = filesystem.rd_j as u64;
        DirEntryResult::Ok { entry: DirEntry { name: filesystem.entry_name, name_len: name_len, is_dir: false, is_file: true } }
    }
    state rdef_ok_other(filesystem: &mut Filesystem) -> DirEntryResult {
        let name_len: u64 = filesystem.rd_j as u64;
        DirEntryResult::Ok { entry: DirEntry { name: filesystem.entry_name, name_len: name_len, is_dir: false, is_file: false } }
    }
    state rdef_end() -> DirEntryResult { DirEntryResult::End }
    state rdef_malformed(filesystem: &mut Filesystem) -> DirEntryResult {
        filesystem.rda_rc = 0 - 5;
        filesystem.err_kind = ErrorKind::Other;
        DirEntryResult::Error { kind: ErrorKind::Other }
    }
}

// Recursively remove a directory and ALL of its contents (Rust
// `std::fs::remove_dir_all`). The `*at` route: never build a child path in Omega.
// Open the dir, DRAIN it (repeatedly remove the first child until empty), then
// `remove_dir` the now-empty dir. Draining recurses into subdirectories via
// `open_at` (fd-relative), so no path construction and no name-domain proof.
//
// JUDGEMENT CALL (D-rda): a single `fuel` budget (4096) bounds TOTAL operations
// (every removal + every descent costs 1) since a filesystem tree has no static
// depth/breadth bound — a tree needing > 4096 ops returns an Error rather than
// looping forever (Rust trusts finiteness; Omega must prove termination). The
// re-read-first-child drain dodges the shared `dir_buf`-vs-recursion clobber: each
// step re-reads the fd fresh, and the entry NAME rides a by-value `DirEntry` param
// so a nested drain cannot overwrite it.
pub macos_x86_64 machine Filesystem::remove_dir_all(&mut self, path: &[u8] in Path) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    self.read_flags = 0;
    let dfd: i32 = self.host.open(path, self.read_flags);
    transition dfd >= 0 { true -> rda_run(dfd, path) _ -> rda_err(path) }
    state rda_run(&mut self, dfd: i32, path: &[u8] in Path) -> UnitResult {
        // Seed the drain stack with the root fd; the loop closes every fd it
        // pops (including this one), so no close here.
        self.rda_depth = 1;
        self.rda_stack[0] = dfd;
        self.rda_rc = self.rda_drain(4096);
        transition self.rda_rc == 0 { true -> rda_rmdir(path) _ -> rda_err(path) }
    }
    state rda_rmdir(&mut self, path: &[u8] in Path) -> UnitResult {
        let rc: i32 = self.host.remove_dir(path);
        transition rc == 0 { true -> rda_ok() _ -> rda_err(path) }
    }
    state rda_ok() -> UnitResult { UnitResult::Ok }
    // `path` is threaded in (unused) so the shared-param domain grant re-establishes
    // `path in Path` here after the drain value-call's conservative invalidation.
    state rda_err(&mut self, path: &[u8] in Path) -> UnitResult {
        let kind: ErrorKind = Filesystem::last_error(&mut self);
        UnitResult::Error { kind: kind }
    }
}

// Drain every child of the stacked directories (files unlinked, subdirs
// emptied + removed), ITERATIVELY: an explicit dirfd stack replaces the old
// call recursion, which no native route can lower (the clone dispatch
// refuses cycles; the splice runs effects once). The loop is ENTRY-recursion
// (`rda_drain(fuel - 1)` from the entry's own transition -- the only shape
// the ranking prover accepts, the mkall precedent); each iteration's WORK
// is one `rda_step` STATEMENT call (the fence doctrine's prescribed shape:
// a statement call from a dispatched state, verdict read from a field).
// Returns 0 on success, -1 on error/fuel-exhaustion/depth overflow (> 16).
macos_x86_64 machine Filesystem::rda_drain(&mut self, fuel: u64)
terminates by fuel;
-> i32
{
    self.rda_step(0);
    // The re-entry is the ENTRY's OWN single-comparison transition -- the only
    // shape the ranking prover accepts (the mkall precedent; an arm-state
    // re-entry or a conjunct guard is unprovable to it). The loop therefore
    // runs its FULL fuel unconditionally; once the stack drains, rda_step
    // no-ops (depth == 0 -> verdict 0) and the tail settles on the verdict.
    // Cost: 4096 cheap no-op iterations after completion -- the provable
    // trade, documented here deliberately.
    transition fuel > 0 { true -> rda_drain(fuel - 1) false -> rdd_settle() }
    state rdd_settle(&mut self) -> i32 {
        transition self.rda_verdict == 0 { true -> rdd_done() _ -> rdd_fail() }
    }
    state rdd_done() -> i32 { 0 }
    state rdd_fail() -> i32 { 0 - 1 }
}

// ONE drain step: unlink the top directory's first file, or descend into its
// first subdir (push), or close+pop a drained directory and remove it from
// its parent. Sets `rda_verdict` (1 continue / 0 done / -1 error). Statement-
// called from rda_drain, so its states are real dispatch cases and the host
// calls in arm states are legal. Every array index is guarded by a SINGLE
// dominating conjunct in its OWN incoming transition (facts do not travel).
// The `step` param exists so the machine has entry arguments (uniform call
// shape); it is unused.
macos_x86_64 machine Filesystem::rda_step(&mut self, step: u64)
reaches FilesystemHost
{
    transition self.rda_depth == 0 { true -> rds_alldone() _ -> rds_read() }

    state rds_alldone(&mut self) { self.rda_verdict = 0; }

    state rds_read(&mut self) {
        // The guard expression matches the INDEX expression exactly (the
        // prover threads same-shape facts only; `depth <= 16` does not imply
        // `depth - 1 < 16` to it). The left conjunct discharges the
        // subtraction's own underflow proof.
        transition self.rda_depth >= 1 && self.rda_depth - 1 < 16 {
            true -> rds_read_go()
            _ -> rds_fail()
        }
    }
    state rds_read_go(&mut self) {
        self.rda_fd = self.rda_stack[self.rda_depth - 1];
        // Copy the descriptor before `&mut self` lends the whole receiver.
        let fd: i32 = self.rda_fd;
        self.rdn_result = Filesystem::read_dir_entry_fd(&mut self, fd, 0);
        transition self.rdn_result {
            DirEntryResult::End -> rds_pop()
            DirEntryResult::Ok { entry } -> rds_entry(entry)
            DirEntryResult::Error { kind } -> rds_fail()
        }
    }

    // TOP is empty: close + pop. If a parent remains, the drained child is
    // (still) the parent's FIRST entry -- re-read its name fresh and remove
    // it (AT_REMOVEDIR = 128). The ROOT (depth hits 0) is the caller's.
    state rds_pop(&mut self) {
        self.rda_close_rc = self.host.close(self.rda_fd);
        transition self.rda_depth >= 1 { true -> rds_pop_go() _ -> rds_fail() }
    }
    state rds_pop_go(&mut self) {
        self.rda_depth = self.rda_depth - 1;
        transition self.rda_depth == 0 { true -> rds_continue() _ -> rds_parent() }
    }
    state rds_parent(&mut self) {
        transition self.rda_depth >= 1 && self.rda_depth - 1 < 16 {
            true -> rds_parent_go()
            _ -> rds_fail()
        }
    }
    state rds_parent_go(&mut self) {
        self.rda_fd = self.rda_stack[self.rda_depth - 1];
        // Copy the descriptor before `&mut self` lends the whole receiver.
        let fd: i32 = self.rda_fd;
        self.rdn_result = Filesystem::read_dir_entry_fd(&mut self, fd, 0);
        transition self.rdn_result {
            DirEntryResult::Ok { entry } -> rds_rm_child(entry)
            DirEntryResult::End -> rds_continue()
            DirEntryResult::Error { kind } -> rds_fail()
        }
    }
    state rds_rm_child(entry: DirEntry) {
        transition entry.name_len < 256 { true -> rds_rm_child_go(entry, entry.name_len) _ -> rds_fail() }
    }
    state rds_rm_child_go(&mut self, entry: DirEntry, name_len: u64[0..=255]) {
        self.rda_rc = self.host.unlink_at(self.rda_fd, entry.name[0..name_len], 128);
        transition self.rda_rc == 0 { true -> rds_continue() _ -> rds_fail() }
    }

    // A live first entry: files unlink; subdirs open + PUSH (descend).
    state rds_entry(entry: DirEntry) {
        transition entry.name_len < 256 { true -> rds_kind(entry, entry.name_len) _ -> rds_fail() }
    }
    state rds_kind(entry: DirEntry, name_len: u64[0..=255]) {
        transition entry.is_dir {
            true -> rds_descend(entry, name_len)
            false -> rds_unlink(entry, name_len)
        }
    }
    state rds_unlink(&mut self, entry: DirEntry, name_len: u64[0..=255]) {
        self.rda_rc = self.host.unlink_at(self.rda_fd, entry.name[0..name_len], 0);
        transition self.rda_rc == 0 { true -> rds_continue() _ -> rds_fail() }
    }
    state rds_descend(&mut self, entry: DirEntry, name_len: u64[0..=255]) {
        self.rda_sub = self.host.open_at(self.rda_fd, entry.name[0..name_len], self.read_flags);
        transition self.rda_sub >= 0 { true -> rds_push() _ -> rds_fail() }
    }
    state rds_push(&mut self) {
        transition self.rda_depth < 16 { true -> rds_push_go() _ -> rds_fail() }
    }
    state rds_push_go(&mut self) {
        self.rda_stack[self.rda_depth] = self.rda_sub;
        self.rda_depth = self.rda_depth + 1;
        transition true { true -> rds_continue() _ -> rds_fail() }
    }

    state rds_continue(&mut self) { self.rda_verdict = 1; }
    state rds_fail(&mut self) { self.rda_verdict = 0 - 1; }
}

// POSITIONED IO (the portable positioned-io contract, windows session
// slice 2): posix binds the ATOMIC pread/pwrite raw ops directly -- the
// kernel reads/writes at the offset without touching the fd's cursor.
// (The windows twin composes seek/op/restore; see its impl file.)
pub macos_x86_64 machine Filesystem::read_at(&mut self, file: File, buffer: &mut [u8], count: u64, offset: i64) -> IoResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    self.file_fd = file.fd;
    let n: i64 = self.host.read_at(self.file_fd, buffer, count, offset);
    transition n >= 0 { true -> ok(n) _ -> err() }
    state ok(n: i64) -> IoResult {
        let converted_count: u64 = narrow_i64_to_u64_exact(n);
        IoResult::Ok { count: converted_count }
    }
    state err(&mut self) -> IoResult { let kind: ErrorKind = Filesystem::last_error(&mut self); IoResult::Error { kind: kind } }
}

pub macos_x86_64 machine Filesystem::write_at(filesystem: &mut Filesystem, file: File, bytes: &[u8], offset: i64) -> IoResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.file_fd = file.fd;
    let n: i64 = filesystem.host.write_at(filesystem.file_fd, bytes, offset);
    transition n >= 0 { true -> ok(n) _ -> err(filesystem) }
    state ok(n: i64) -> IoResult {
        let converted_count: u64 = narrow_i64_to_u64_exact(n);
        IoResult::Ok { count: converted_count }
    }
    state err(filesystem: &mut Filesystem) -> IoResult { let kind: ErrorKind = Filesystem::last_error(filesystem); IoResult::Error { kind: kind } }
}

// HARD LINK (the portable hard-link contract, windows session slice 3):
// posix binds link(2) directly -- errno carries the failure kind
// (AlreadyExists / NotFound). (The windows twin rides the designed
// create_hard_link seam op; see its impl file.)
pub macos_x86_64 machine Filesystem::hard_link(&mut self, original: &[u8] in Path, link: &[u8] in Path) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    let rc: i32 = self.host.hard_link(original, link);
    transition rc == 0 { true -> ok() _ -> err() }
    state ok() -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = Filesystem::last_error(&mut self); UnitResult::Error { kind: kind } }
}

// Set an open file's access + modification times. Compose two native timespec
// records (atime @0, mtime @16; each {tv_sec i64, tv_nsec i64}) and futimens.
pub macos_x86_64 machine Filesystem::set_times(filesystem: &mut Filesystem, file: File, accessed: i64, modified: i64) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.times_buf[0] = narrow_i64_to_u8_wrapping(accessed);
    filesystem.times_buf[1] = narrow_i64_to_u8_wrapping(accessed >> 8);
    filesystem.times_buf[2] = narrow_i64_to_u8_wrapping(accessed >> 16);
    filesystem.times_buf[3] = narrow_i64_to_u8_wrapping(accessed >> 24);
    filesystem.times_buf[4] = narrow_i64_to_u8_wrapping(accessed >> 32);
    filesystem.times_buf[5] = narrow_i64_to_u8_wrapping(accessed >> 40);
    filesystem.times_buf[6] = narrow_i64_to_u8_wrapping(accessed >> 48);
    filesystem.times_buf[7] = narrow_i64_to_u8_wrapping(accessed >> 56);
    filesystem.times_buf[16] = narrow_i64_to_u8_wrapping(modified);
    filesystem.times_buf[17] = narrow_i64_to_u8_wrapping(modified >> 8);
    filesystem.times_buf[18] = narrow_i64_to_u8_wrapping(modified >> 16);
    filesystem.times_buf[19] = narrow_i64_to_u8_wrapping(modified >> 24);
    filesystem.times_buf[20] = narrow_i64_to_u8_wrapping(modified >> 32);
    filesystem.times_buf[21] = narrow_i64_to_u8_wrapping(modified >> 40);
    filesystem.times_buf[22] = narrow_i64_to_u8_wrapping(modified >> 48);
    filesystem.times_buf[23] = narrow_i64_to_u8_wrapping(modified >> 56);
    filesystem.file_fd = file.fd;
    let rc: i32 = filesystem.host.set_file_times(filesystem.file_fd, &mut filesystem.times_buf);
    transition rc == 0 { true -> ok() _ -> err(filesystem) }
    state ok() -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut Filesystem) -> UnitResult { let kind: ErrorKind = Filesystem::last_error(filesystem); UnitResult::Error { kind: kind } }
}

// CANONICALIZE (the portable canonicalize contract, windows session slice
// 4a): posix binds realpath(3) directly -- symlink-resolving,
// existence-checked, writes the NUL-terminated absolute path into the
// caller's >= 1024-byte buffer. (The windows twin composes the handle
// bridge; see its impl file.)
pub macos_x86_64 machine Filesystem::canonicalize(&mut self, path: &[u8] in Path, buffer: &mut [u8]) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    let rc: i64 = self.host.canonicalize(path, buffer);
    transition rc != 0 { true -> ok() _ -> err() }
    state ok() -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = Filesystem::last_error(&mut self); UnitResult::Error { kind: kind } }
}

pub macos_x86_64 machine Filesystem::lock(&mut self, file: File) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    self.file_fd = file.fd;
    let rc: i32 = self.host.lock_file(self.file_fd, 2);
    transition rc == 0 { true -> ok() _ -> err() }
    state ok() -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = Filesystem::last_error(&mut self); UnitResult::Error { kind: kind } }
}

pub macos_x86_64 machine Filesystem::lock_shared(filesystem: &mut Filesystem, file: File) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.file_fd = file.fd;
    let rc: i32 = filesystem.host.lock_file(filesystem.file_fd, 1);
    transition rc == 0 { true -> ok() _ -> err(filesystem) }
    state ok() -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut Filesystem) -> UnitResult { let kind: ErrorKind = Filesystem::last_error(filesystem); UnitResult::Error { kind: kind } }
}

pub macos_x86_64 machine Filesystem::try_lock(filesystem: &mut Filesystem, file: File) -> TryLockResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.file_fd = file.fd;
    let rc: i32 = filesystem.host.lock_file(filesystem.file_fd, 6);
    filesystem.lock_errno = filesystem.host.errno();
    transition rc == 0 { true -> acquired() _ -> contended(filesystem) }
    state acquired() -> TryLockResult { TryLockResult::Acquired }
    state contended(filesystem: &mut Filesystem) -> TryLockResult { transition filesystem.lock_errno == 35 { true -> would_block() _ -> failed(filesystem) } }
    state would_block() -> TryLockResult { TryLockResult::WouldBlock }
    state failed(filesystem: &mut Filesystem) -> TryLockResult { let kind: ErrorKind = Filesystem::last_error(filesystem); TryLockResult::Error { kind: kind } }
}

pub macos_x86_64 machine Filesystem::try_lock_shared(filesystem: &mut Filesystem, file: File) -> TryLockResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.file_fd = file.fd;
    let rc: i32 = filesystem.host.lock_file(filesystem.file_fd, 5);
    filesystem.lock_errno = filesystem.host.errno();
    transition rc == 0 { true -> acquired() _ -> contended(filesystem) }
    state acquired() -> TryLockResult { TryLockResult::Acquired }
    state contended(filesystem: &mut Filesystem) -> TryLockResult { transition filesystem.lock_errno == 35 { true -> would_block() _ -> failed(filesystem) } }
    state would_block() -> TryLockResult { TryLockResult::WouldBlock }
    state failed(filesystem: &mut Filesystem) -> TryLockResult { let kind: ErrorKind = Filesystem::last_error(filesystem); TryLockResult::Error { kind: kind } }
}

pub macos_x86_64 machine Filesystem::unlock(filesystem: &mut Filesystem, file: File) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.file_fd = file.fd;
    let rc: i32 = filesystem.host.lock_file(filesystem.file_fd, 8);
    transition rc == 0 { true -> ok() _ -> err(filesystem) }
    state ok() -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut Filesystem) -> UnitResult { let kind: ErrorKind = Filesystem::last_error(filesystem); UnitResult::Error { kind: kind } }
}
