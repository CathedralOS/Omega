// ---- libSystem clock (DarwinClock) ----------------------------------------

pub macos_arm64 machine darwin_clock_ns_binding() -> ForeignBinding<26, 22, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_clock_gettime_nsec_np",
        },
    }
}
pub macos_arm64 machine darwin_mach_absolute_time_binding() -> ForeignBinding<26, 19, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_mach_absolute_time",
        },
    }
}
pub macos_arm64 machine darwin_poll_binding() -> ForeignBinding<26, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib",
            symbol: "_poll",
        },
    }
}

pub macos_arm64 machine darwin_clock_ns(clock_id: u32) -> u64
    satisfies DarwinClock::clock_ns via darwin_clock_ns_binding();
pub macos_arm64 machine darwin_mach_absolute_time() -> u64
    satisfies DarwinClock::mach_absolute_time via darwin_mach_absolute_time_binding();
pub macos_arm64 machine darwin_poll(fds: u64, nfds: u64, timeout_ms: i32) -> i32
    satisfies DarwinClock::poll via darwin_poll_binding();
