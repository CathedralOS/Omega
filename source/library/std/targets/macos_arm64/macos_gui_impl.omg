// macos_arm64 foreign leaves for the macos_gui module's raw seams.
// Generic whole-array string requirements are bound by the SDK Build; the
// remaining seams retain their existing bodyless realizations.

use omega::language::core::external_binding;
use macos_gui;

// AppKit supplies Cocoa classes; libobjc alone does not load them.
public macos_arm64 machine appkit_load_binding() -> ForeignBinding<50, 18, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/AppKit.framework/AppKit",
            symbol: "_NSApplicationLoad",
        },
    }
}

// NSApplicationLoad returns Objective-C BOOL, a C bool on macOS ARM64.
public macos_arm64 machine appkit_load() -> bool
    satisfies AppKit::load via appkit_load_binding();

// ---- libobjc (ObjectiveC) --------------------------------------------------
// Text requirements borrow their complete NUL-terminated fixed arrays. Their
// static extents add no native argument: each reference is one C pointer.

public macos_arm64 machine objc_msg_send_binding() -> ForeignBinding<24, 13, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib",
            symbol: "_objc_msgSend",
        },
    }
}
public macos_arm64 machine objc_pool_push_binding() -> ForeignBinding<24, 25, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib",
            symbol: "_objc_autoreleasePoolPush",
        },
    }
}
public macos_arm64 machine objc_pool_pop_binding() -> ForeignBinding<24, 24, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib",
            symbol: "_objc_autoreleasePoolPop",
        },
    }
}

public macos_arm64 machine objc_send(recv: u64, sel: u64) -> u64
    satisfies ObjectiveC::send via objc_msg_send_binding();
public macos_arm64 machine objc_send_scalar(recv: u64, sel: u64, arg: u64) -> u64
    satisfies ObjectiveC::send_scalar via objc_msg_send_binding();
public macos_arm64 machine objc_send_delayed(recv: u64, sel: u64, action: u64, object: u64, delay: f64)
    satisfies ObjectiveC::send_delayed via objc_msg_send_binding();
public macos_arm64 machine objc_send_rect(recv: u64, sel: u64, x: f64, y: f64, w: f64, h: f64, a: u64, b: u64, c: u64) -> u64
    satisfies ObjectiveC::send_rect via objc_msg_send_binding();
public macos_arm64 machine objc_send_image_size(recv: u64, sel: u64, image: u64, w: f64, h: f64) -> u64
    satisfies ObjectiveC::send_image_size via objc_msg_send_binding();
public macos_arm64 machine objc_send_scalar4(recv: u64, sel: u64, a: u64, b: u64, c: u64, d: u64) -> u64
    satisfies ObjectiveC::send_scalar4 via objc_msg_send_binding();
public macos_arm64 machine objc_pool_push() -> u64
    satisfies ObjectiveC::pool_push via objc_pool_push_binding();
public macos_arm64 machine objc_pool_pop(pool: u64) -> u64
    satisfies ObjectiveC::pool_pop via objc_pool_pop_binding();

