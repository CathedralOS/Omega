// macos_arm64 foreign leaves for the macos_gui module's raw seams: one
// bodyless `via` leaf per boundary machine — the leaf's signature IS the
// boundary signature; the MachODylibSymbol locator is the foreign
// realization. `MacosGui`/`MacosInput`/`MacosClock` call these as ordinary
// free machines; the satisfies edges keep each leaf named by its boundary
// requirement.

use omega::language::core::external_binding;

// ---- libobjc (ObjectiveC) --------------------------------------------------
// Every text argument is the raw `const char*` shape: callers stage a
// NUL-terminated buffer and pass `&buf[0]` (`&u8` lowers to the pointer word).

pub macos_arm64 machine objc_get_class_binding() -> ForeignBinding<24, 14, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib",
            symbol: "_objc_getClass",
        },
    }
}
pub macos_arm64 machine objc_register_selector_binding() -> ForeignBinding<24, 17, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib",
            symbol: "_sel_registerName",
        },
    }
}
pub macos_arm64 machine objc_msg_send_binding() -> ForeignBinding<24, 13, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib",
            symbol: "_objc_msgSend",
        },
    }
}
pub macos_arm64 machine objc_pool_push_binding() -> ForeignBinding<24, 25, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib",
            symbol: "_objc_autoreleasePoolPush",
        },
    }
}
pub macos_arm64 machine objc_pool_pop_binding() -> ForeignBinding<24, 24, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib",
            symbol: "_objc_autoreleasePoolPop",
        },
    }
}

pub macos_arm64 machine objc_get_class(name: &u8) -> u64
    satisfies ObjectiveC::get_class via objc_get_class_binding();
pub macos_arm64 machine objc_register_selector(name: &u8) -> u64
    satisfies ObjectiveC::register_selector via objc_register_selector_binding();
pub macos_arm64 machine objc_send(recv: u64, sel: u64) -> u64
    satisfies ObjectiveC::send via objc_msg_send_binding();
pub macos_arm64 machine objc_send_scalar(recv: u64, sel: u64, arg: u64) -> u64
    satisfies ObjectiveC::send_scalar via objc_msg_send_binding();
pub macos_arm64 machine objc_send_rect(recv: u64, sel: u64, x: f64, y: f64, w: f64, h: f64, a: u64, b: u64, c: u64) -> u64
    satisfies ObjectiveC::send_rect via objc_msg_send_binding();
pub macos_arm64 machine objc_send_image_size(recv: u64, sel: u64, image: u64, w: f64, h: f64) -> u64
    satisfies ObjectiveC::send_image_size via objc_msg_send_binding();
pub macos_arm64 machine objc_send_string(recv: u64, sel: u64, text: &u8) -> u64
    satisfies ObjectiveC::send_string via objc_msg_send_binding();
pub macos_arm64 machine objc_send_byte_string(recv: u64, sel: u64, text: &u8) -> u64
    satisfies ObjectiveC::send_byte_string via objc_msg_send_binding();
pub macos_arm64 machine objc_send_scalar4(recv: u64, sel: u64, a: u64, b: u64, c: u64, d: u64) -> u64
    satisfies ObjectiveC::send_scalar4 via objc_msg_send_binding();
pub macos_arm64 machine objc_pool_push() -> u64
    satisfies ObjectiveC::pool_push via objc_pool_push_binding();
pub macos_arm64 machine objc_pool_pop(pool: u64) -> u64
    satisfies ObjectiveC::pool_pop via objc_pool_pop_binding();

