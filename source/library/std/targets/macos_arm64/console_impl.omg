// Exact macos_arm64 Console byte/runtime leaves. The named NativeConsole
// implementation in std/console.omg forwards to these target declarations.
// Each leaf's compiler supply is inferred from its exact realization symbol,
// normalized signature, package custody, and selected target.
macos_arm64 boundary machine ConsoleNativeProvider::read_byte() -> ByteRead
    satisfies Console::read_byte
    crashes Trap
    blocks;
macos_arm64 boundary machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
macos_arm64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;

macos_arm64 machine ConsoleNativeProvider::provider_defaults(defaults: &mut ConsoleNativeProvider) {
    ConsoleNativeProvider::select_provider<Console, NativeConsole>(defaults);
}
