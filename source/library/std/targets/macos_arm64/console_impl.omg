// Complete macos_arm64 Console provider closure over compiler-known native
// byte/runtime leaves. Friendly write adapters live in std/console.omg on the
// same nominal provider type.
// Unmigrated sibling leaves retain transitional payload-free `via` syntax.
// Byte output and process exit are inferred from their exact realization
// symbols, normalized signatures, package custody, and selected target.
macos_arm64 machine ConsoleNativeProvider::read_line(out_line: &mut [u8])
    satisfies Console::read_line
    via Binding::CompilerIntrinsic;
macos_arm64 machine ConsoleNativeProvider::read_byte() -> ByteRead
    satisfies Console::read_byte
    via Binding::CompilerIntrinsic;
macos_arm64 boundary machine ConsoleNativeProvider::write_byte(byte: i32)
    satisfies Console::write_byte;
macos_arm64 boundary machine ConsoleNativeProvider::exit_process(return_code: i32)
    satisfies Console::exit_process;

macos_arm64 machine ConsoleNativeProvider::provider_defaults(defaults: &mut ConsoleNativeProvider) {
    defaults.select_provider<Console, ConsoleNativeProvider>();
}
