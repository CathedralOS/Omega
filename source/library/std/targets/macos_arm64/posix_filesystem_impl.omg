use omega::language::core::filesystem_authority;
// Complete macos_arm64 `PosixFilesystemHost` provider over libSystem.
// Each operation is an ordinary checked adapter: it terminates paths into
// local buffers, lends caller backing for ordinary read/write transfers,
// calls libSystem, and turns libc's `-1` plus thread-local `errno` into the
// trait's negated `errno`. The imports state libSystem's own parameters
// through std-private requirements, each satisfied by one Mach-O symbol.
//
// `open_create` imports `___open`, the fixed-arity entry behind libc's
// variadic `open`: Apple arm64 passes variadic arguments on the stack, and an
// authored import cannot request that placement yet, so the creation mode
// would otherwise arrive in the wrong place. `open`, `openat` and
// `unlinkat` take no variadic argument without `O_CREAT`, so their ordinary
// entries are called with their fixed arguments only.
//
// `errno` lives in libc's thread-local storage, reachable only as the address
// `___error()` returns. The adapter copies the complete four-byte `int`
// through `_memcpy`; Darwin's `errno` values stop at `ELAST` (106), so its
// low byte is the whole value.
use omega::language::core::external_binding;
use posix_filesystem_host;
use filesystem_host;
use omega::language::core::layout;
use omega::language::core::numeric_conversion;
use math;
use calling;
use posix_byte_view_calling;

// The explicit policy exports the borrowed view as pointer/count, not one byte.
boundary trait PosixFilesystemDarwinByteViews: Calling<DarwinArm64ByteViewCalling> {
    machine c_read(fd: i32, buffer: &mut [u8]) -> i64 reaches FilesystemContentRead;
    machine c_write(fd: i32, bytes: &[u8]) -> i64 reaches FilesystemContentWrite;
    machine c_read_at(fd: i32, buffer: &mut [u8], offset: i64) -> i64 reaches FilesystemContentRead;
    machine c_write_at(fd: i32, bytes: &[u8], offset: i64) -> i64 reaches FilesystemContentWrite;
    machine c_read_link(path: &[u8; 4096], buffer: &mut [u8]) -> i64 reaches FilesystemMetadataQuery;
    machine c_read_dir(fd: i32, buffer: &mut [u8], position: &mut i64) -> i64 reaches DirectoryEnumeration;
}

// Unlike the raw Linux syscall, libc consumes an aligned timespec[2] object.
// Caller byte views need not have that alignment. Materialize only this native
// 32-byte record, keeping required ABI marshaling separate from payload staging.
data DarwinTimestampRecord {
    accessed_seconds: i64;
    accessed_nanoseconds: i64;
    modified_seconds: i64;
    modified_nanoseconds: i64;
}
DarwinTimestampAlignment satisfies FixedLayout<DarwinTimestampRecord> {
    machine plan(schema: Schema, target: LayoutTarget) -> Plan
    reaches
    terminates; {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
        entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 8 } };
        entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 16 } };
        entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 24 } };
        Plan { entries: entries, entry_count: 4, size_fixed: 32, size_is_dynamic: false, align: 8 }
    }
}


// Decode the caller's packed little-endian bytes without forming an aligned
// native reference to them. All signed bit patterns, including UTIME sentinels,
// survive unchanged; semantic timestamp validation remains the OS's operation.
machine darwin_timestamp_word(bytes: &[u8]) -> i64
requires bytes.len == 8;
{
    let word: u64 in Wrapping = (widen_u8_to_u64(bytes[0]) as u64 in Wrapping)
        | ((widen_u8_to_u64(bytes[1]) as u64 in Wrapping) << 8)
        | ((widen_u8_to_u64(bytes[2]) as u64 in Wrapping) << 16)
        | ((widen_u8_to_u64(bytes[3]) as u64 in Wrapping) << 24)
        | ((widen_u8_to_u64(bytes[4]) as u64 in Wrapping) << 32)
        | ((widen_u8_to_u64(bytes[5]) as u64 in Wrapping) << 40)
        | ((widen_u8_to_u64(bytes[6]) as u64 in Wrapping) << 48)
        | ((widen_u8_to_u64(bytes[7]) as u64 in Wrapping) << 56);
    narrow_u64_to_i64_wrapping(word as u64)
}

boundary trait PosixFilesystemDarwin {
    machine c_open(path: &[u8; 4096], flags: i32) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;

    machine c_open_create(path: &[u8; 4096], flags: i32, mode: u16) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;

    machine c_create(path: &[u8; 4096], mode: u16) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;

    machine c_close(fd: i32) -> i32 reaches;

    machine c_remove(path: &[u8; 4096]) -> i32
reaches FilesystemNamespaceMutation;

    machine c_seek(fd: i32, offset: i64, whence: i32) -> i64 reaches;

    machine c_create_dir(path: &[u8; 4096], mode: u16) -> i32
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation;

    machine c_remove_dir(path: &[u8; 4096]) -> i32
reaches FilesystemNamespaceMutation;

    machine c_create_dir_name(name: &[u8; 4096], mode: u16) -> i32
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation;

    machine c_open_at(dirfd: i32, name: &[u8; 4096], flags: i32) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;

    machine c_unlink_at(dirfd: i32, name: &[u8; 4096], flags: i32) -> i32
reaches FilesystemNamespaceMutation;

    machine c_set_permissions(path: &[u8; 4096], mode: u16) -> i32
reaches FilesystemMetadataMutation;

    machine c_set_file_permissions(fd: i32, mode: u16) -> i32
reaches FilesystemMetadataMutation;

    machine c_rename(from: &[u8; 4096], to: &[u8; 4096]) -> i32
reaches FilesystemNamespaceMutation;

    machine c_hard_link(original: &[u8; 4096], link: &[u8; 4096]) -> i32
reaches FilesystemNamespaceMutation;

    machine c_symlink(target: &[u8; 4096], link: &[u8; 4096]) -> i32
reaches FilesystemNamespaceMutation;

    machine c_remove_name(path: &[u8; 4096]) -> i32
reaches FilesystemNamespaceMutation;

    machine c_remove_dir_name(path: &[u8; 4096]) -> i32
reaches FilesystemNamespaceMutation;

    machine c_read_file_metadata(fd: i32, buffer: &mut [u8; 144]) -> i32
reaches FilesystemMetadataQuery;

    machine c_read_metadata_at(directory_descriptor: i32, name: &[u8; 4096], buffer: &mut [u8; 144], flags: i32) -> i32
reaches FilesystemMetadataQuery;

    machine c_set_len(fd: i32, length: i64) -> i32
reaches FilesystemContentWrite + FilesystemMetadataMutation;

    machine c_set_file_times(fd: i32, times: &DarwinTimestampAlignment<DarwinTimestampRecord>) -> i32
reaches FilesystemMetadataMutation;

    machine c_sync(fd: i32) -> i32;

    machine c_sync_data(fd: i32) -> i32;

    machine c_duplicate(fd: i32) -> i32 reaches;

    machine c_lock_file(fd: i32, operation: i32) -> i32 reaches;

    machine c_change_owner(path: &[u8; 4096], uid: u32, gid: u32) -> i32
reaches FilesystemMetadataMutation;

    machine c_change_owner_no_follow(path: &[u8; 4096], uid: u32, gid: u32) -> i32
reaches FilesystemMetadataMutation;

    machine c_change_file_owner(fd: i32, uid: u32, gid: u32) -> i32
reaches FilesystemMetadataMutation;

    machine c_error_location() -> u64 reaches;

    machine c_copy_from_address(destination: &mut [u8; 4], source: u64, count: u64) -> u64
requires count <= 4;
}

// requirement namespace for the libSystem imports

// The negated `errno` of the call that just failed.
machine darwin_filesystem_failure_i32() -> i32

{
    let location: u64 = PosixFilesystemDarwin::c_error_location();
    let mut code: [u8; 4];
    let copied: u64 = PosixFilesystemDarwin::c_copy_from_address(&mut code[0], location, 4);
    let low: u8 = code[0];
    0 - (low as i32)
}

machine darwin_filesystem_failure_i64() -> i64

{
    let location: u64 = PosixFilesystemDarwin::c_error_location();
    let mut code: [u8; 4];
    let copied: u64 = PosixFilesystemDarwin::c_copy_from_address(&mut code[0], location, 4);
    let low: u8 = code[0];
    0 - (low as i64)
}

// Capture libc errno before restoring caller storage after a native write.
machine darwin_filesystem_normalize_i64(outcome: i64) -> i64 {
    transition outcome < 0 { true -> darwin_filesystem_failure_i64() _ -> outcome }
}

// Darwin `ENAMETOOLONG`, answered without a call when a path does not fit.
machine darwin_filesystem_name_too_long_i32() -> i32 { -63 }
machine darwin_filesystem_name_too_long_i64() -> i64 { -63 }























































// The kernel writes one complete native record into caller-owned storage.
// Only path termination needs scratch; undersized output never reaches libc.






















DarwinArm64PosixFilesystem satisfies PosixFilesystemHost {
    machine open(path: &[u8] in Path, flags: i32) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemDarwin::c_open(&terminated, flags);
    transition fits {
        true -> settle(outcome)
        _ -> (PosixFilesystemDarwin::name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (PosixFilesystemDarwin::failure_i32())
            _ -> (outcome)
        }
    }
}

    machine open_create(path: &[u8] in Path, flags: i32, mode: i32) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemDarwin::c_open_create(&terminated, flags, narrow_i32_to_u16_wrapping(mode));
    transition fits {
        true -> settle(outcome)
        _ -> (PosixFilesystemDarwin::name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (PosixFilesystemDarwin::failure_i32())
            _ -> (outcome)
        }
    }
}

    machine create(path: &[u8] in Path, mode: i32) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemDarwin::c_create(&terminated, narrow_i32_to_u16_wrapping(mode));
    transition fits {
        true -> settle(outcome)
        _ -> (PosixFilesystemDarwin::name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (PosixFilesystemDarwin::failure_i32())
            _ -> (outcome)
        }
    }
}

    machine read(fd: i32, buffer: &mut [u8], count: u64) -> i64
reaches FilesystemContentRead
{
    let capacity: u64 = min_u64(count, buffer.len);
    let outcome: i64 = PosixFilesystemDarwinImports::c_read(fd, &mut buffer[0..capacity]);
    PosixFilesystemDarwin::normalize_i64(outcome)
}

    machine write(fd: i32, bytes: &[u8]) -> i64
reaches FilesystemContentWrite
{
    let outcome: i64 = PosixFilesystemDarwinImports::c_write(fd, bytes);
    PosixFilesystemDarwin::normalize_i64(outcome)
}

    machine read_at(fd: i32, buffer: &mut [u8], count: u64, offset: i64) -> i64
reaches FilesystemContentRead
{
    let capacity: u64 = min_u64(count, buffer.len);
    let outcome: i64 = PosixFilesystemDarwinImports::c_read_at(fd, &mut buffer[0..capacity], offset);
    PosixFilesystemDarwin::normalize_i64(outcome)
}

    machine write_at(fd: i32, bytes: &[u8], offset: i64) -> i64
reaches FilesystemContentWrite
{
    let outcome: i64 = PosixFilesystemDarwinImports::c_write_at(fd, bytes, offset);
    PosixFilesystemDarwin::normalize_i64(outcome)
}

    machine close(fd: i32) -> i32
{
    let outcome: i32 = PosixFilesystemDarwin::c_close(fd);
    transition outcome < 0 {
        true -> (PosixFilesystemDarwin::failure_i32())
        _ -> (outcome)
    }
}

    machine remove(path: &[u8] in Path) -> i32
reaches FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemDarwin::c_remove(&terminated);
    transition fits {
        true -> settle(outcome)
        _ -> (PosixFilesystemDarwin::name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (PosixFilesystemDarwin::failure_i32())
            _ -> (outcome)
        }
    }
}

    machine seek(fd: i32, offset: i64, whence: i32) -> i64
{
    let outcome: i64 = PosixFilesystemDarwin::c_seek(fd, offset, whence);
    transition outcome < 0 {
        true -> (PosixFilesystemDarwin::failure_i64())
        _ -> (outcome)
    }
}

