    }
}

    machine change_owner(path: &[u8] in Path, uid: i32, gid: i32) -> i32
reaches FilesystemMetadataMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemDarwin::c_change_owner(&terminated, narrow_i32_to_u32_wrapping(uid), narrow_i32_to_u32_wrapping(gid));
    transition fits {
        true -> settle(outcome)
        _ -> (PosixFilesystemDarwin::name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (PosixFilesystemDarwin::failure_i32())
            _ -> (outcome)
        }
    }
}

    machine change_owner_no_follow(path: &[u8] in Path, uid: i32, gid: i32) -> i32
reaches FilesystemMetadataMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemDarwin::c_change_owner_no_follow(&terminated, narrow_i32_to_u32_wrapping(uid), narrow_i32_to_u32_wrapping(gid));
    transition fits {
        true -> settle(outcome)
        _ -> (PosixFilesystemDarwin::name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (PosixFilesystemDarwin::failure_i32())
            _ -> (outcome)
        }
    }
}

    machine change_file_owner(fd: i32, uid: i32, gid: i32) -> i32
reaches FilesystemMetadataMutation
{
    let outcome: i32 = PosixFilesystemDarwin::c_change_file_owner(fd, narrow_i32_to_u32_wrapping(uid), narrow_i32_to_u32_wrapping(gid));
    transition outcome < 0 {
        true -> (PosixFilesystemDarwin::failure_i32())
        _ -> (outcome)
    }
}
}

// Exact ordinary helper retained from main Darwin ABI repair.
machine DarwinTimestampAlignment::plan(schema: Schema) -> Plan
{
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 8 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 16 } };
    entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 24 } };
    Plan { entries: entries, entry_count: 4, size_fixed: 32, size_is_dynamic: false, align: 8 }
}

// Exact ordinary helper retained from main Darwin ABI repair.
machine PosixFilesystemDarwin::failure_i32() -> i32
{
    let location: u64 = PosixFilesystemDarwin::c_error_location();
    let mut code: [u8; 4];
    let copied: u64 = PosixFilesystemDarwin::c_copy_from_address(&mut code, location, 4);
    let low: u8 = code[0];
    0 - (low as i32)
}

// Exact ordinary helper retained from main Darwin ABI repair.
machine PosixFilesystemDarwin::failure_i64() -> i64
{
    let location: u64 = PosixFilesystemDarwin::c_error_location();
    let mut code: [u8; 4];
    let copied: u64 = PosixFilesystemDarwin::c_copy_from_address(&mut code, location, 4);
    let low: u8 = code[0];
    0 - (low as i64)
}

// Exact ordinary helper retained from main Darwin ABI repair.
machine PosixFilesystemDarwin::normalize_i64(outcome: i64) -> i64
{
    transition outcome < 0 { true -> PosixFilesystemDarwin::failure_i64() _ -> outcome }
}

// Exact ordinary helper retained from main Darwin ABI repair.
machine PosixFilesystemDarwin::name_too_long_i32() -> i32
{ -63 }

// Exact ordinary helper retained from main Darwin ABI repair.
machine PosixFilesystemDarwin::name_too_long_i64() -> i64
{ -63 }

