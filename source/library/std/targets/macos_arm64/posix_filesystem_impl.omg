    }
}

    machine read_link(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> i64
reaches FilesystemMetadataQuery
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    transition fits { true -> transfer(terminated, buffer, count) _ -> -63 }
    machine transfer(terminated: [u8; 4096], buffer: &mut [u8], count: u64) -> i64 {
        let capacity: u64 = min_u64(count, buffer.len);
        let outcome: i64 = PosixFilesystemDarwinImports::c_read_link(&terminated, &mut buffer[0..capacity]);
        PosixFilesystemDarwin::normalize_i64(outcome)
    }
}

    machine read_dir(fd: i32, buffer: &mut [u8], count: u64, position: &mut i64) -> i64
reaches DirectoryEnumeration
{
    let capacity: u64 = min_u64(count, buffer.len);
    transition { _ -> transfer(fd, &mut buffer[0..capacity], position) }
    machine transfer(fd: i32, buffer: &mut [u8], position: &mut i64) -> i64 {
        transition {
            buffer.len >= 1024 -> extended(fd, buffer, position)
            _ -> ordinary(fd, buffer, position)
        }
    }
    machine ordinary(fd: i32, buffer: &mut [u8], position: &mut i64) -> i64
    {
        let outcome: i64 = PosixFilesystemDarwinImports::c_read_dir(fd, buffer, position);
        PosixFilesystemDarwin::normalize_i64(outcome)
    }
    machine extended(fd: i32, buffer: &mut [u8], position: &mut i64) -> i64
    requires buffer.len >= 1024;
    {
        // ___getdirentries64 reserves four suffix bytes for private EOF flags
        // at this threshold. Records occupy at most capacity - 4. Preserve the
        // caller's suffix rather than exposing that auxiliary kernel write.
        let first_index: u64 = buffer.len - 4;
        let second_index: u64 = buffer.len - 3;
        let third_index: u64 = buffer.len - 2;
        let fourth_index: u64 = buffer.len - 1;
        let first: u8 = buffer[first_index];
        let second: u8 = buffer[second_index];
        let third: u8 = buffer[third_index];
        let fourth: u8 = buffer[fourth_index];
        let outcome: i64 = PosixFilesystemDarwinImports::c_read_dir(fd, buffer, position);
        // Capture errno before restoring bytes, including on a failed read.
        let normalized: i64 = PosixFilesystemDarwin::normalize_i64(outcome);
        buffer[first_index] = first;
        buffer[second_index] = second;
        buffer[third_index] = third;
        buffer[fourth_index] = fourth;
        normalized
    }
}

    machine remove_name(path: &[u8]) -> i32
reaches FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemDarwin::c_remove_name(&terminated);
    transition fits {
        true -> settle(outcome)
        _ -> (PosixFilesystemDarwin::name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (PosixFilesystemDarwin::failure_i32())
            _ -> (outcome)
        }
    }
}

