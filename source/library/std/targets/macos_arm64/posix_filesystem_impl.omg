    machine rename(from: &[u8] in Path, to: &[u8] in Path) -> i32
reaches FilesystemNamespaceMutation
{
    let mut first: [u8; 4096];
    let mut second: [u8; 4096];
    let first_fits: bool = posix_terminated_path(from, &mut first);
    let second_fits: bool = posix_terminated_path(to, &mut second);
    let outcome: i32 = PosixFilesystemDarwin::c_rename(&first, &second);
    transition first_fits && second_fits {
        true -> settle(outcome)
        _ -> (PosixFilesystemDarwin::name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (PosixFilesystemDarwin::failure_i32())
            _ -> (outcome)
        }
    }
}

