use clock.omg as clock;

// Complete macos_arm64 `Clock` provider closure. Darwin's kernel ABI has no
// millisecond sleep with the requirement's shape; its timed wait is POSIX
// `poll(fds, nfds, timeout)`, which waits out the timeout when it is given no
// descriptors. The leaf states poll's own parameters through the one-member
// `DarwinClockWait` trait, and `MacosArm64Clock::sleep` is an ordinary
// checked adapter over it.

// The darwin timed wait. It is the `Clock` service's own wait, so the
// one-member `DarwinClockWait` trait reaches `Clock` and the adapter calling
// it stays inside `Clock::sleep`'s ceiling. Only this target satisfies the
// trait. The readiness count is not published: with no descriptors poll
// reports only a completed or an interrupted wait, which `sleep` has no
// result to carry, and the calling plan still clobbers the result register.
boundary trait DarwinClockWait {
    machine poll(descriptors: u64, descriptor_count: u64, timeout_milliseconds: i32)
    reaches
        |clock|::Clock
    blocks
    crashes none;
}
