// Darwin clock reads return nanoseconds directly; the portable Time wrapper
// owns conversion into Instant and SystemTime. Clock selectors and calibration
// are ordinary checked code, not hidden arguments or constant provider rows.
// Apple documents/implements the selected clocks in Libc/gen/clock_gettime.c:
// https://github.com/apple-oss-distributions/Libc/blob/main/gen/clock_gettime.c
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;
use time_host;


data TimeHostDarwinImports { }


// poll's timeout is signed. Preserve the full u32 millisecond request by
// splitting large waits into signed-representable pieces, as Clock does.


// No descriptors means zero reports a completed timeout. Retry failed waits
// instead of reporting sleep complete early. Repeating the full piece can
// oversleep; this boundary promises neither an upper duration nor termination.
machine macos_arm64_time_host_wait_part(timeout_milliseconds: i32)
reaches TimeHost
blocks;
{
    transition { _ -> block wait(timeout_milliseconds) }

    machine wait(timeout_milliseconds: i32) {
        let outcome: i32 = block DarwinArm64TimeRead::poll(0, 0, timeout_milliseconds);
        transition outcome == 0 {
            true -> done()
            _ -> block wait(timeout_milliseconds)
        }
    }

    machine done() { }
}


DarwinArm64TimeHost satisfies TimeHost {
    machine monotonic_ticks() -> u64
    reaches TimeHost
    {
        DarwinArm64TimeRead::clock_nanoseconds(8)
    }

    machine monotonic_ticks_per_second() -> u64
    {
        1000000000
    }

    machine wall_clock_raw() -> u64
    reaches TimeHost
    {
        DarwinArm64TimeRead::clock_nanoseconds(0)
    }

    machine wall_clock_units_per_second() -> u64
    {
        1000000000
    }

    machine wall_clock_epoch_offset_seconds() -> u64
    {
        0
    }

    machine sleep(milliseconds: u32)
    reaches TimeHost
    blocks;
    {
        transition milliseconds > 2147483647 {
            true -> block in_parts(milliseconds)
            _ -> block at_once(milliseconds)
        }

        machine at_once(milliseconds: u32) {
            block macos_arm64_time_host_wait_part(narrow_u32_to_i32_wrapping(milliseconds));
        }

        machine in_parts(milliseconds: u32) {
            let third: i32 = narrow_u32_to_i32_wrapping(milliseconds / 3);
            block macos_arm64_time_host_wait_part(third);
            block macos_arm64_time_host_wait_part(third);
            block macos_arm64_time_host_wait_part(third);
            block macos_arm64_time_host_wait_part(narrow_u32_to_i32_wrapping(milliseconds % 3));
        }
    }
}

boundary trait DarwinArm64TimeRead {
    machine clock_nanoseconds(clock_id: u32) -> u64
    reaches TimeHost;
    machine poll(descriptors: u64, descriptor_count: u32, timeout_milliseconds: i32) -> i32
    reaches TimeHost
    blocks;
}
