use calling.omg as abi;
use entry_shapes.omg as shapes;
use {omega}/language/core/extent.omg as storage;

// The Linux kernel enters a static ELF executable on AArch64 with the
// machine stack pointer at the initial process-stack image
// ([argc][argv...][NULL][envp...][NULL][auxv...]) and no return
// continuation; it delivers no argument registers, so the first image
// word (the argument count) is the only environment-supplied value this
// surface can name. A process completes through the exit_group
// supervisor call (svc #0, number 94 in x8) with its status in w0. The
// authored argument count introduces neither storage roots nor access
// authority, and the bridge observes the incoming stack pointer itself
// before switching to its private stack; the register vocabulary cannot
// name it as a value location. ProgramStorageEntry remains the separate
// semantic root crossing; its two Extents are internal bridge inputs,
// not hosted application arguments. This calling contract supplies no
// bridge, loader admission, receiver, or numeric stack guarantee.
// ProviderSelected requires independent backing.
// See :HostedArgumentAuthority in entry_shapes.omg for the handoff to source.
boundary trait LinuxArm64PhysicalEntry {
    machine enter(argc: u64) -> i32 reaches none crashes Trap crashes Abort;
}

LinuxArm64CallingPolicy satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        linux_arm64_entry_plan(signature)
    }
}

machine linux_arm64_entry_plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult
    satisfies |abi|::CallingPolicy::plan
{
    transition signature.parameter_count {
        1 -> physical(signature),
        2 -> semantic(signature),
        _ -> reject()
    }

    machine physical(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        transition signature.has_result {
            true -> physical_indices(signature, signature.parameters[0],
                signature.result),
            _ -> reject()
        }
    }

    machine physical_indices(signature: |abi|::BoundarySignature, argc: u64,
        result: u64) -> |abi|::BoundaryPlanResult
    {
        transition argc < 256 && result < 256
            && argc < signature.shape_count && result < signature.shape_count
        {
            true -> physical_shapes(signature.shapes[argc],
                signature.shapes[result]),
            _ -> reject()
        }
    }

    machine physical_shapes(argc: |abi|::ValueShape, result: |abi|::ValueShape)
        -> |abi|::BoundaryPlanResult
    {
        transition |shapes|::hosted_entry_integer_shape(@argc, 8)
            && |shapes|::hosted_entry_integer_shape(@result, 4)
        {
            true -> build_physical(),
            _ -> reject()
        }
    }

    machine build_physical() -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan;
        output.call.parameter_count = 1;
        // The kernel arrival places the argument count as the first word of
        // the initial process-stack image; it is an input observation, not a
        // writable argument object. The image's base arrives in the machine
        // stack pointer, which the register vocabulary cannot name as a value
        // location; the generated bridge observes it before switching stacks.
        output.call.parameters[0] = linux_arm64_entry_stack_word(8);
        output.call.has_result = true;
        // Process completion status leaves in w0 under exit_group.
        output.call.result = linux_arm64_entry_named_word(4, 0);
        transition { _ -> finish(output, true) }
    }

    machine semantic(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        transition signature.has_result {
            false -> semantic_indices(signature, signature.parameters[0],
                signature.parameters[1]),
            _ -> reject()
        }
    }

    machine semantic_indices(signature: |abi|::BoundarySignature, image: u64,
        storage: u64) -> |abi|::BoundaryPlanResult
    {
        transition image < 256 && storage < 256
            && image < signature.shape_count && storage < signature.shape_count
        {
            true -> semantic_shapes(signature.shapes[image],
                signature.shapes[storage], signature),
            _ -> reject()
        }
    }

    machine semantic_shapes(image: |abi|::ValueShape, storage: |abi|::ValueShape,
        signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult
    {
        transition |shapes|::hosted_entry_extent_shape(image, @signature)
            && |shapes|::hosted_entry_extent_shape(storage, @signature)
        {
            true -> build_semantic(),
            _ -> reject()
        }
    }

    machine build_semantic() -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan;
        output.call.parameter_count = 2;
        // The generated bridge passes the image and initial-storage roots in
        // the first four AAPCS64 integer registers.
        output.call.parameters[0] = |shapes|::hosted_entry_arm_extent_value(0, 1);
        output.call.parameters[1] = |shapes|::hosted_entry_arm_extent_value(2, 3);
        transition { _ -> finish(output, false) }
    }

    machine finish(output: |abi|::BoundaryEntryPlan, supervisor: bool)
        -> |abi|::BoundaryPlanResult
    {
        let mutable plan: |abi|::BoundaryEntryPlan = output;
        plan.call.convention = |abi|::CallingConvention::Aapcs64;
        plan.call.stack_alignment = 16;
        transition supervisor {
            true -> finish_supervisor(plan),
            _ -> finish_call(plan)
        }
    }

    machine finish_supervisor(plan: |abi|::BoundaryEntryPlan) -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan = plan;
        // The kernel supplies no return continuation; the physical contract
        // completes through exit_group (x8 = 94) with status in w0.
        output.call.entry_control = |abi|::EntryControl::SupervisorCall {
            number_register: |abi|::MachineRegister::Aarch64X { index: 8 },
            immediate: 94,
        };
        transition { _ -> seal(output) }
    }

    machine finish_call(plan: |abi|::BoundaryEntryPlan) -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan = plan;
        output.call.entry_control = |abi|::EntryControl::CallReturn;
        transition { _ -> seal(output) }
    }

    machine seal(plan: |abi|::BoundaryEntryPlan) -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan = plan;
        // Standard AAPCS64 volatile banks; x18 is platform-reserved. The
        // bridge may also observe the incoming stack pointer before switching
        // to its private stack.
        output.call.ordinary_clobbers.register_count = 42;
        output.call.ordinary_clobbers.registers[0] = |abi|::MachineRegister::Aarch64X { index: 0 };
        output.call.ordinary_clobbers.registers[1] = |abi|::MachineRegister::Aarch64X { index: 1 };
        output.call.ordinary_clobbers.registers[2] = |abi|::MachineRegister::Aarch64X { index: 2 };
        output.call.ordinary_clobbers.registers[3] = |abi|::MachineRegister::Aarch64X { index: 3 };
        output.call.ordinary_clobbers.registers[4] = |abi|::MachineRegister::Aarch64X { index: 4 };
        output.call.ordinary_clobbers.registers[5] = |abi|::MachineRegister::Aarch64X { index: 5 };
        output.call.ordinary_clobbers.registers[6] = |abi|::MachineRegister::Aarch64X { index: 6 };
        output.call.ordinary_clobbers.registers[7] = |abi|::MachineRegister::Aarch64X { index: 7 };
        output.call.ordinary_clobbers.registers[8] = |abi|::MachineRegister::Aarch64X { index: 8 };
        output.call.ordinary_clobbers.registers[9] = |abi|::MachineRegister::Aarch64X { index: 9 };
        output.call.ordinary_clobbers.registers[10] = |abi|::MachineRegister::Aarch64X { index: 10 };
        output.call.ordinary_clobbers.registers[11] = |abi|::MachineRegister::Aarch64X { index: 11 };
        output.call.ordinary_clobbers.registers[12] = |abi|::MachineRegister::Aarch64X { index: 12 };
        output.call.ordinary_clobbers.registers[13] = |abi|::MachineRegister::Aarch64X { index: 13 };
        output.call.ordinary_clobbers.registers[14] = |abi|::MachineRegister::Aarch64X { index: 14 };
        output.call.ordinary_clobbers.registers[15] = |abi|::MachineRegister::Aarch64X { index: 15 };
        output.call.ordinary_clobbers.registers[16] = |abi|::MachineRegister::Aarch64X { index: 16 };
        output.call.ordinary_clobbers.registers[17] = |abi|::MachineRegister::Aarch64X { index: 17 };
        output.call.ordinary_clobbers.registers[18] = |abi|::MachineRegister::Aarch64V { index: 0 };
        output.call.ordinary_clobbers.registers[19] = |abi|::MachineRegister::Aarch64V { index: 1 };
        output.call.ordinary_clobbers.registers[20] = |abi|::MachineRegister::Aarch64V { index: 2 };
        output.call.ordinary_clobbers.registers[21] = |abi|::MachineRegister::Aarch64V { index: 3 };
        output.call.ordinary_clobbers.registers[22] = |abi|::MachineRegister::Aarch64V { index: 4 };
        output.call.ordinary_clobbers.registers[23] = |abi|::MachineRegister::Aarch64V { index: 5 };
        output.call.ordinary_clobbers.registers[24] = |abi|::MachineRegister::Aarch64V { index: 6 };
        output.call.ordinary_clobbers.registers[25] = |abi|::MachineRegister::Aarch64V { index: 7 };
        output.call.ordinary_clobbers.registers[26] = |abi|::MachineRegister::Aarch64V { index: 16 };
        output.call.ordinary_clobbers.registers[27] = |abi|::MachineRegister::Aarch64V { index: 17 };
        output.call.ordinary_clobbers.registers[28] = |abi|::MachineRegister::Aarch64V { index: 18 };
        output.call.ordinary_clobbers.registers[29] = |abi|::MachineRegister::Aarch64V { index: 19 };
        output.call.ordinary_clobbers.registers[30] = |abi|::MachineRegister::Aarch64V { index: 20 };
        output.call.ordinary_clobbers.registers[31] = |abi|::MachineRegister::Aarch64V { index: 21 };
        output.call.ordinary_clobbers.registers[32] = |abi|::MachineRegister::Aarch64V { index: 22 };
        output.call.ordinary_clobbers.registers[33] = |abi|::MachineRegister::Aarch64V { index: 23 };
        output.call.ordinary_clobbers.registers[34] = |abi|::MachineRegister::Aarch64V { index: 24 };
        output.call.ordinary_clobbers.registers[35] = |abi|::MachineRegister::Aarch64V { index: 25 };
        output.call.ordinary_clobbers.registers[36] = |abi|::MachineRegister::Aarch64V { index: 26 };
        output.call.ordinary_clobbers.registers[37] = |abi|::MachineRegister::Aarch64V { index: 27 };
        output.call.ordinary_clobbers.registers[38] = |abi|::MachineRegister::Aarch64V { index: 28 };
        output.call.ordinary_clobbers.registers[39] = |abi|::MachineRegister::Aarch64V { index: 29 };
        output.call.ordinary_clobbers.registers[40] = |abi|::MachineRegister::Aarch64V { index: 30 };
        output.call.ordinary_clobbers.registers[41] = |abi|::MachineRegister::Aarch64V { index: 31 };
        output.state.initial_regime = |abi|::MachineRegime::Aarch64A64 {
            exception_level: 0
        };
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.vector_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.permitted_transitive_use.instruction_pointer = true;
        output.state.permitted_transitive_use.stack_pointer = true;
        // A returning import's floating-control envelope restores MXCSR/FPCR,
        // which the hosted ABI makes callee-preserved.
        output.state.permitted_transitive_use.control_state = true;
        output.state.stack = |abi|::EntryStack::ProviderSelected;
        output.state.preemption = |abi|::Preemption::NotApplicable;
        |abi|::BoundaryPlanResult::Accepted { plan: output }
    }

    machine reject() -> |abi|::BoundaryPlanResult {
        |abi|::BoundaryPlanResult::Rejected {
            reason: |abi|::CallingPolicyRejection {
                reason: "LinuxArm64Application requires exact physical or program-storage entry shapes" as + |abi|::Utf8,
            },
        }
    }
}

machine linux_arm64_entry_named_word(bytes: u64, register: u64) -> |abi|::ValuePlacement {
    let mutable value: |abi|::ValuePlacement;
    value.shape.class = |abi|::AbiValueClass::Integer;
    value.shape.byte_size = bytes;
    value.shape.alignment = bytes;
    value.location_count = 1;
    value.locations[0] = |abi|::ValueLocation::Register {
        register: |abi|::MachineRegister::Aarch64X { index: register },
        value_byte_offset: 0, byte_size: bytes,
    };
    value
}

machine linux_arm64_entry_stack_word(bytes: u64) -> |abi|::ValuePlacement {
    // The kernel places the argument count at the base of the incoming
    // process-stack image; a stack location names that delivery without a
    // stack-pointer register the value vocabulary does not carry.
    let mutable value: |abi|::ValuePlacement;
    value.shape.class = |abi|::AbiValueClass::Integer;
    value.shape.byte_size = bytes;
    value.shape.alignment = bytes;
    value.location_count = 1;
    value.locations[0] = |abi|::ValueLocation::Stack {
        stack_byte_offset: 0,
        value_byte_offset: 0, byte_size: bytes,
        alignment: bytes,
    };
    value
}

boundary trait LinuxArm64Application: |storage|::ProgramStorageEntry + LinuxArm64PhysicalEntry + |abi|::Calling<LinuxArm64CallingPolicy> {}
