use omega::language::core::FilesystemContentRead;
use omega::language::core::FilesystemContentWrite;
use omega::language::core::FilesystemMetadataQuery;
use omega::language::core::FilesystemMetadataMutation;
use omega::language::core::DirectoryEnumeration;
use omega::language::core::FilesystemNamespaceMutation;
// Linux arm64 POSIX filesystem service: the same kernel-shaped
// requirements and adapters as linux_x86_64 (`targets/linux_x86_64/
// posix_filesystem_impl.omg`), satisfied with arm64 system call numbers.
use omega::language::core::min_u64;

// This native requirement application fixes its kernel calling convention.
boundary trait PosixFilesystemLinuxArm64ByteViews: Calling<LinuxArm64ByteViewCalling> {
    machine read(fd: i32, buffer: &mut [u8]) -> i64 reaches FilesystemContentRead crashes none;
    machine write(fd: i32, bytes: &[u8]) -> i64 reaches FilesystemContentWrite crashes none;
    machine pread64(fd: i32, buffer: &mut [u8], offset: i64) -> i64 reaches FilesystemContentRead crashes none;
    machine pwrite64(fd: i32, bytes: &[u8], offset: i64) -> i64 reaches FilesystemContentWrite crashes none;
    machine readlinkat(dirfd: i32, path: &[u8; 4096], buffer: &mut [u8]) -> i64 reaches FilesystemMetadataQuery crashes none;
    machine getdents64(fd: i32, buffer: &mut [u8]) -> i64 reaches DirectoryEnumeration crashes none;
}

// Linux arm64 writes its 128-byte kernel stat record. The caller lends that
// complete checked window rather than the first byte of a larger view.
boundary trait PosixFilesystemLinuxArm64Metadata {
    machine newfstatat(dirfd: i32, path: &[u8; 4096], buffer: &mut [u8; 128], flags: i32) -> i32
    reaches FilesystemMetadataQuery
    crashes none;
    machine fstat(fd: i32, buffer: &mut [u8; 128]) -> i32
    reaches FilesystemMetadataQuery
    crashes none;
}

machine linux_arm64_posix_open(path: &[u8] in Path, flags: i32) -> i32
    satisfies PosixFilesystemHost::open
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemLinux::openat(-100, &terminated, flags, 0);
    transition fits {
        true -> settle(outcome)
        _ -> (-36)
    }

    machine settle(outcome: i32) -> i32 {
        outcome
    }
}

machine linux_arm64_posix_open_create(path: &[u8] in Path, flags: i32, mode: i32) -> i32
    satisfies PosixFilesystemHost::open_create
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemLinux::openat(-100, &terminated, flags, mode);
    transition fits {
        true -> settle(outcome)
        _ -> (-36)
    }

    machine settle(outcome: i32) -> i32 {
        outcome
    }
}

machine linux_arm64_posix_create(path: &[u8] in Path, mode: i32) -> i32
    satisfies PosixFilesystemHost::create
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemLinux::openat(-100, &terminated, 577, mode);
    transition fits {
        true -> settle(outcome)
        _ -> (-36)
    }

    machine settle(outcome: i32) -> i32 {
