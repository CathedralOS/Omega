linux_arm64 machine PosixFilesystemNativeProvider::read_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32
    satisfies PosixFilesystemHost::read_metadata
reaches FilesystemMetadataQuery
{
    PosixFilesystemNativeProvider::read_metadata_at(-100, path, buffer, 0)
}

linux_arm64 machine PosixFilesystemNativeProvider::read_file_metadata(fd: i32, buffer: &mut [u8]) -> i32
    satisfies PosixFilesystemHost::read_file_metadata
reaches FilesystemMetadataQuery
{
    transition buffer.len >= 128 { true -> query(fd, buffer) _ -> -22 }
    machine query(fd: i32, buffer: &mut [u8]) -> i32 requires buffer.len >= 128; {
        PosixFilesystemLinux::fstat(fd, &mut buffer[0])
    }
}

linux_arm64 machine PosixFilesystemNativeProvider::read_symlink_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32
    satisfies PosixFilesystemHost::read_symlink_metadata
reaches FilesystemMetadataQuery
{
    PosixFilesystemNativeProvider::read_metadata_at(-100, path, buffer, 256)
}

linux_arm64 machine PosixFilesystemNativeProvider::read_metadata_at(directory_descriptor: i32, name: &[u8], buffer: &mut [u8], flags: i32) -> i32
    satisfies PosixFilesystemHost::read_metadata_at
reaches FilesystemMetadataQuery
{
    transition buffer.len >= 128 { true -> prepare(directory_descriptor, name, buffer, flags) _ -> -22 }
    machine prepare(directory_descriptor: i32, name: &[u8], buffer: &mut [u8], flags: i32) -> i32
    requires buffer.len >= 128;
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(name, &mut terminated);
        transition fits { true -> query(directory_descriptor, terminated, buffer, flags) _ -> -36 }
    }
    machine query(directory_descriptor: i32, terminated: [u8; 4096], buffer: &mut [u8], flags: i32) -> i32
    requires buffer.len >= 128;
    {
        PosixFilesystemLinux::newfstatat(directory_descriptor, &terminated[0], &mut buffer[0], flags)
    }
}

linux_arm64 machine PosixFilesystemNativeProvider::set_len(fd: i32, length: i64) -> i32
    satisfies PosixFilesystemHost::set_len
reaches FilesystemContentWrite + FilesystemMetadataMutation
{
    let outcome: i32 = PosixFilesystemLinux::ftruncate(fd, length);
    outcome
}

linux_arm64 machine PosixFilesystemNativeProvider::set_file_times(fd: i32, times: &[u8]) -> i32
    satisfies PosixFilesystemHost::set_file_times
reaches FilesystemMetadataMutation
{
    transition times.len >= 32 { true -> update(fd, times) _ -> -22 }
    machine update(fd: i32, times: &[u8]) -> i32 requires times.len >= 32; {
        // The raw syscall copies bytes from user storage, without a libc object.
        PosixFilesystemLinux::utimensat(fd, 0, &times[0], 0)
    }
}

linux_arm64 machine PosixFilesystemNativeProvider::sync(fd: i32) -> i32
