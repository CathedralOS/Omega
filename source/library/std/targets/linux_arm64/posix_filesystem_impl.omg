    satisfies PosixFilesystemHost::remove_dir_name
reaches FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemLinux::unlinkat(-100, &terminated, 512);
    transition fits {
