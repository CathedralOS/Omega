machine linux_arm64_posix_change_file_owner(fd: i32, uid: i32, gid: i32) -> i32
    satisfies PosixFilesystemHost::change_file_owner
reaches FilesystemMetadataMutation
{
    let outcome: i32 = PosixFilesystemLinux::fchown(fd, uid, gid);
    outcome
}

// The linux_arm64 raw POSIX service. std's Build selects it for linux_arm64.
public LinuxArm64PosixFilesystem satisfies PosixFilesystemHost {
    PosixFilesystemHost::open = linux_arm64_posix_open;
    PosixFilesystemHost::open_create = linux_arm64_posix_open_create;
    PosixFilesystemHost::create = linux_arm64_posix_create;
    PosixFilesystemHost::read = linux_arm64_posix_read;
    PosixFilesystemHost::write = linux_arm64_posix_write;
    PosixFilesystemHost::read_at = linux_arm64_posix_read_at;
    PosixFilesystemHost::write_at = linux_arm64_posix_write_at;
    PosixFilesystemHost::close = linux_arm64_posix_close;
    PosixFilesystemHost::remove = linux_arm64_posix_remove;
    PosixFilesystemHost::seek = linux_arm64_posix_seek;
    PosixFilesystemHost::create_dir = linux_arm64_posix_create_dir;
    PosixFilesystemHost::remove_dir = linux_arm64_posix_remove_dir;
    PosixFilesystemHost::create_dir_name = linux_arm64_posix_create_dir_name;
    PosixFilesystemHost::open_at = linux_arm64_posix_open_at;
    PosixFilesystemHost::unlink_at = linux_arm64_posix_unlink_at;
    PosixFilesystemHost::set_permissions = linux_arm64_posix_set_permissions;
    PosixFilesystemHost::set_file_permissions = linux_arm64_posix_set_file_permissions;
    PosixFilesystemHost::rename = linux_arm64_posix_rename;
    PosixFilesystemHost::hard_link = linux_arm64_posix_hard_link;
    PosixFilesystemHost::symlink = linux_arm64_posix_symlink;
    PosixFilesystemHost::read_link = linux_arm64_posix_read_link;
    PosixFilesystemHost::read_dir = linux_arm64_posix_read_dir;
    PosixFilesystemHost::remove_name = linux_arm64_posix_remove_name;
    PosixFilesystemHost::remove_dir_name = linux_arm64_posix_remove_dir_name;
    PosixFilesystemHost::read_metadata = linux_arm64_posix_read_metadata;
    PosixFilesystemHost::read_file_metadata = linux_arm64_posix_read_file_metadata;
    PosixFilesystemHost::read_symlink_metadata = linux_arm64_posix_read_symlink_metadata;
    PosixFilesystemHost::read_metadata_at = linux_arm64_posix_read_metadata_at;
    PosixFilesystemHost::set_len = linux_arm64_posix_set_len;
    PosixFilesystemHost::set_file_times = linux_arm64_posix_set_file_times;
    PosixFilesystemHost::sync = linux_arm64_posix_sync;
    PosixFilesystemHost::sync_data = linux_arm64_posix_sync_data;
    PosixFilesystemHost::duplicate = linux_arm64_posix_duplicate;
    PosixFilesystemHost::lock_file = linux_arm64_posix_lock_file;
    PosixFilesystemHost::change_owner = linux_arm64_posix_change_owner;
    PosixFilesystemHost::change_owner_no_follow = linux_arm64_posix_change_owner_no_follow;
    PosixFilesystemHost::change_file_owner = linux_arm64_posix_change_file_owner;
}
