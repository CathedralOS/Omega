}

linux_arm64 machine PosixFilesystemNativeProvider::read(fd: i32, buffer: &mut [u8], count: u64) -> i64
    satisfies PosixFilesystemHost::read
reaches FilesystemContentRead
{
    let capacity: u64 = min_u64(count, buffer.len);
    PosixFilesystemLinuxArm64ByteViews::read(fd, &mut buffer[0..capacity])
}

linux_arm64 machine PosixFilesystemNativeProvider::write(fd: i32, bytes: &[u8]) -> i64
    satisfies PosixFilesystemHost::write
reaches FilesystemContentWrite
{
    PosixFilesystemLinuxArm64ByteViews::write(fd, bytes)
}

linux_arm64 machine PosixFilesystemNativeProvider::read_at(fd: i32, buffer: &mut [u8], count: u64, offset: i64) -> i64
    satisfies PosixFilesystemHost::read_at
reaches FilesystemContentRead
{
    let capacity: u64 = min_u64(count, buffer.len);
    PosixFilesystemLinuxArm64ByteViews::pread64(fd, &mut buffer[0..capacity], offset)
}

linux_arm64 machine PosixFilesystemNativeProvider::write_at(fd: i32, bytes: &[u8], offset: i64) -> i64
    satisfies PosixFilesystemHost::write_at
reaches FilesystemContentWrite
{
    PosixFilesystemLinuxArm64ByteViews::pwrite64(fd, bytes, offset)
}

linux_arm64 machine PosixFilesystemNativeProvider::close(fd: i32) -> i32
    satisfies PosixFilesystemHost::close

{
    let outcome: i32 = PosixFilesystemLinux::close(fd);
    outcome
}

