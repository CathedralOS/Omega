use omega::language::core::filesystem_authority;
// Linux arm64 POSIX filesystem service: the same kernel-shaped
// requirements and adapters as linux_x86_64 (`targets/linux_x86_64/
// posix_filesystem_impl.omg`), satisfied with arm64 system call numbers.
use omega::language::core::external_binding;
use posix_filesystem_host;
use math;
use posix_byte_view_calling;
use calling;

// This native requirement application fixes its kernel calling convention.
boundary trait PosixFilesystemLinuxArm64ByteViews: Calling<LinuxArm64ByteViewCalling> {
    machine read(fd: i32, buffer: &mut [u8]) -> i64 reaches FilesystemContentRead;
    machine write(fd: i32, bytes: &[u8]) -> i64 reaches FilesystemContentWrite;
    machine pread64(fd: i32, buffer: &mut [u8], offset: i64) -> i64 reaches FilesystemContentRead;
    machine pwrite64(fd: i32, bytes: &[u8], offset: i64) -> i64 reaches FilesystemContentWrite;
    machine readlinkat(dirfd: i32, path: &[u8; 4096], buffer: &mut [u8]) -> i64 reaches FilesystemMetadataQuery;
    machine getdents64(fd: i32, buffer: &mut [u8]) -> i64 reaches DirectoryEnumeration;
}

use filesystem_host;
use targets::linux_x86_64::posix_filesystem_impl;


linux_arm64 machine PosixFilesystemNativeProvider::open(path: &[u8] in Path, flags: i32) -> i32
    satisfies PosixFilesystemHost::open
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemLinux::openat(-100, &terminated[0], flags, 0);
    transition fits {
        true -> settle(outcome)
        _ -> (-36)
    }

    machine settle(outcome: i32) -> i32 {
        outcome
    }
}

linux_arm64 machine PosixFilesystemNativeProvider::open_create(path: &[u8] in Path, flags: i32, mode: i32) -> i32
    satisfies PosixFilesystemHost::open_create
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemLinux::openat(-100, &terminated[0], flags, mode);
    transition fits {
        true -> settle(outcome)
        _ -> (-36)
    }

    machine settle(outcome: i32) -> i32 {
        outcome
    }
}

linux_arm64 machine PosixFilesystemNativeProvider::create(path: &[u8] in Path, mode: i32) -> i32
    satisfies PosixFilesystemHost::create
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemLinux::openat(-100, &terminated[0], 577, mode);
    transition fits {
        true -> settle(outcome)
        _ -> (-36)
    }

