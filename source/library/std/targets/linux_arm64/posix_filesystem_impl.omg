    satisfies PosixFilesystemHost::sync_data

{
    let outcome: i32 = PosixFilesystemLinux::fdatasync(fd);
    outcome
}

machine linux_arm64_posix_duplicate(fd: i32) -> i32
    satisfies PosixFilesystemHost::duplicate

{
