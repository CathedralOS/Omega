    }
}

machine linux_arm64_posix_change_owner_no_follow(path: &[u8] in Path, uid: i32, gid: i32) -> i32
    satisfies PosixFilesystemHost::change_owner_no_follow
reaches FilesystemMetadataMutation
{
    let mut terminated: [u8; 4096];
    let fits: bool = posix_terminated_path(path, &mut terminated);
    let outcome: i32 = PosixFilesystemLinux::fchownat(-100, &terminated, uid, gid, 256);
    transition fits {
        true -> settle(outcome)
        _ -> (-36)
    }

