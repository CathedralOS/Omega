// A valid request may complete with a shorter native transfer. Check the
// original request against its backing before limiting one call to DWORD_MAX;
// a native prefix must not make an out-of-bounds request admissible.
use omega::language::core::min_u64;
use omega::language::core::widen_i32_to_i64;

machine windows_transfer_count(requested: u64, available: u64) -> u64
requires requested <= available
ensures result <= requested && result <= available && result <= 4294967295 &&
    ((requested <= 4294967295 && result == requested) ||
     (requested > 4294967295 && result == 4294967295))
{
    min_u64(requested, 4294967295)
}

// Capture the transfer's error before cleanup. A successful transfer still
// reports a failed release; cleanup must never overwrite an earlier failure.
machine windows_transfer_completion(result: i64, closed: i32) -> i64 {
    transition result < 0 { true -> (result) _ -> release(result, closed) }
    machine release(result: i64, closed: i32) -> i64 {
        transition closed < 0 { true -> (widen_i32_to_i64(closed)) _ -> (result) }
    }
}
