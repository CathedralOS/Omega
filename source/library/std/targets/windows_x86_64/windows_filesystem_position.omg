use targets/windows_x86_64/windows_filesystem_control.omg as control;
use targets/windows_x86_64/windows_filesystem_transfer.omg as transfer;
use targets/windows_x86_64/windows_filesystem_position_native.omg as position_io;
use targets/windows_x86_64/windows_filesystem_position_pins.omg as pins;
// Offset operations never seek a caller's shared file object. Reopen a pinned
// original into an independent synchronous object, after checking its existing
// data and SYNCHRONIZE rights. In particular an append-only handle cannot gain
// FILE_WRITE_DATA merely because the current ACL would allow ReOpenFile to do so.
use omega\language\core\FilesystemContentRead;
use omega\language\core\FilesystemContentWrite;
use omega\language\core\narrow_u64_to_i64_wrapping;

machine windows_filesystem_native_read_at(handle: u64, buffer: @mutable [u8], count: u64, offset: i64) -> i64
reaches FilesystemContentRead {
    transition offset >= 0 && count <= buffer.length && count <= 4294967295 {
        true -> block pin(handle, buffer, count, offset),
        false -> (-87)
    }
    machine pin(handle: u64, buffer: @mutable [u8], count: u64, offset: i64) -> i64 {
        let pinned: |pins|::WindowsPinnedAccessResult = block |pins|::windows_positioned_pin(handle);
        transition pinned {
            |pins|::WindowsPinnedAccessResult::Error { code } -> (|pins|::windows_positioned_error(code)),
            |pins|::WindowsPinnedAccessResult::Value { handle as reopened, access } -> block check_access(reopened, access, buffer, count, offset)
        }
    }
    machine check_access(handle: u64, granted: u32, buffer: @mutable [u8], count: u64, offset: i64) -> i64 {
        transition (granted & 1048577) == 1048577 {
            true -> block reopen(handle, buffer, count, offset),
            false -> block denied(handle)
        }
    }
    machine denied(handle: u64) -> i64 {
        let released: i32 = block |control|::windows_filesystem_native_close_handle(handle);
        -5
    }
    machine reopen(handle: u64, buffer: @mutable [u8], count: u64, offset: i64) -> i64 {
        let raw: i64 = block |position_io|::WindowsFilesystemPositionIo::reopen_read(narrow_u64_to_i64_wrapping(handle), 1048577, 7, 0);
        let opened: |pins|::WindowsPositionedFile = block |pins|::windows_positioned_reopened(handle, raw);
        transition opened {
            |pins|::WindowsPositionedFile::Error { code } -> (|pins|::windows_positioned_error(code)),
            |pins|::WindowsPositionedFile::Handle { value } -> block position(value, buffer, count, offset)
        }
    }
    machine position(handle: u64, buffer: @mutable [u8], count: u64, offset: i64) -> i64 {
        let positioned: i64 = block |control|::windows_filesystem_native_set_file_pointer(handle, offset, 0);
        transition positioned == offset {
            true -> block transfer(handle, buffer, count),
            false -> (block |pins|::windows_positioned_seek_failed(handle, positioned))
        }
    }
    machine transfer(handle: u64, buffer: @mutable [u8], count: u64) -> i64 {
        let result: i64 = block |transfer|::windows_filesystem_native_read_file(handle, buffer, count);
        let released: i32 = block |control|::windows_filesystem_native_close_handle(handle);
        |transfer|::windows_transfer_completion(result, released)
    }
}

machine windows_filesystem_native_write_at(handle: u64, bytes: @[u8], offset: i64) -> i64
reaches FilesystemContentWrite {
    transition offset >= 0 && bytes.length <= 4294967295 {
        true -> block pin(handle, bytes, offset),
        false -> (-87)
    }
    machine pin(handle: u64, bytes: @[u8], offset: i64) -> i64 {
        let pinned: |pins|::WindowsPinnedAccessResult = block |pins|::windows_positioned_pin(handle);
        transition pinned {
            |pins|::WindowsPinnedAccessResult::Error { code } -> (|pins|::windows_positioned_error(code)),
            |pins|::WindowsPinnedAccessResult::Value { handle as reopened, access } -> block check_access(reopened, access, bytes, offset)
        }
    }
    machine check_access(handle: u64, granted: u32, bytes: @[u8], offset: i64) -> i64 {
        transition (granted & 1048578) == 1048578 {
            true -> block reopen(handle, bytes, offset),
            false -> block denied(handle)
        }
    }
    machine denied(handle: u64) -> i64 {
        let released: i32 = block |control|::windows_filesystem_native_close_handle(handle);
        -5
    }
    machine reopen(handle: u64, bytes: @[u8], offset: i64) -> i64 {
        let raw: i64 = block |position_io|::WindowsFilesystemPositionIo::reopen_write(narrow_u64_to_i64_wrapping(handle), 1048578, 7, 0);
        let opened: |pins|::WindowsPositionedFile = block |pins|::windows_positioned_reopened(handle, raw);
        transition opened {
            |pins|::WindowsPositionedFile::Error { code } -> (|pins|::windows_positioned_error(code)),
            |pins|::WindowsPositionedFile::Handle { value } -> block position(value, bytes, offset)
        }
    }
    machine position(handle: u64, bytes: @[u8], offset: i64) -> i64 {
        let positioned: i64 = block |control|::windows_filesystem_native_set_file_pointer(handle, offset, 0);
        transition positioned == offset {
            true -> block transfer(handle, bytes),
            false -> (block |pins|::windows_positioned_seek_failed(handle, positioned))
        }
    }
    machine transfer(handle: u64, bytes: @[u8]) -> i64 {
        let result: i64 = block |transfer|::windows_filesystem_native_write_file(handle, bytes);
        let released: i32 = block |control|::windows_filesystem_native_close_handle(handle);
        |transfer|::windows_transfer_completion(result, released)
    }
}
