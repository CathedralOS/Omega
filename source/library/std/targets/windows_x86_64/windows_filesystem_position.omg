// Offset operations never seek a caller's shared file object. Reopen a pinned
// original into an independent synchronous object, after checking its existing
// data and SYNCHRONIZE rights. In particular an append-only handle cannot gain
// FILE_WRITE_DATA merely because the current ACL would allow ReOpenFile to do so.
use windows_filesystem_host;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::windows_filesystem_impl;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_position_native;
use targets::windows_x86_64::windows_filesystem_position_pins;
use targets::windows_x86_64::windows_filesystem_transfer;

windows_x86_64 machine WindowsFilesystemNativeProvider::read_at(handle: u64, buffer: &mut [u8], count: u64, offset: i64) -> i64
satisfies WindowsFilesystemHost::read_at
reaches FilesystemContentRead {
    transition offset >= 0 && count <= buffer.len && count <= 4294967295 {
        true -> pin(handle, buffer, count, offset)
        false -> (-87)
    }
    machine pin(handle: u64, buffer: &mut [u8], count: u64, offset: i64) -> i64 {
        let pinned: WindowsPinnedAccessResult = block windows_positioned_pin(handle);
        transition pinned {
            WindowsPinnedAccessResult::Error { code } -> (windows_positioned_error(code))
            WindowsPinnedAccessResult::Value { handle, access } -> access(handle, access, buffer, count, offset)
        }
    }
    machine access(handle: u64, granted: u32, buffer: &mut [u8], count: u64, offset: i64) -> i64 {
        transition (granted & 1048577) == 1048577 {
            true -> reopen(handle, buffer, count, offset)
            false -> denied(handle)
        }
    }
    machine denied(handle: u64) -> i64 {
        let released: i32 = block WindowsFilesystemNativeProvider::close_handle(handle);
        -5
    }
    machine reopen(handle: u64, buffer: &mut [u8], count: u64, offset: i64) -> i64 {
        let raw: i64 = block WindowsFilesystemPositionIo::reopen_read(narrow_u64_to_i64_wrapping(handle), 1048577, 7, 0);
        let opened: WindowsPositionedFile = block windows_positioned_reopened(handle, raw);
        transition opened {
            WindowsPositionedFile::Error { code } -> (windows_positioned_error(code))
            WindowsPositionedFile::Handle { value } -> position(value, buffer, count, offset)
        }
    }
    machine position(handle: u64, buffer: &mut [u8], count: u64, offset: i64) -> i64 {
        let positioned: i64 = block WindowsFilesystemNativeProvider::set_file_pointer(handle, offset, 0);
        transition positioned == offset {
            true -> transfer(handle, buffer, count)
            false -> (block windows_positioned_seek_failed(handle, positioned))
        }
    }
    machine transfer(handle: u64, buffer: &mut [u8], count: u64) -> i64 {
        let result: i64 = block WindowsFilesystemNativeProvider::read_file(handle, buffer, count);
        let released: i32 = block WindowsFilesystemNativeProvider::close_handle(handle);
        windows_transfer_completion(result, released)
    }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::write_at(handle: u64, bytes: &[u8], offset: i64) -> i64
satisfies WindowsFilesystemHost::write_at
reaches FilesystemContentWrite {
    transition offset >= 0 && bytes.len <= 4294967295 {
        true -> pin(handle, bytes, offset)
        false -> (-87)
    }
    machine pin(handle: u64, bytes: &[u8], offset: i64) -> i64 {
        let pinned: WindowsPinnedAccessResult = block windows_positioned_pin(handle);
        transition pinned {
            WindowsPinnedAccessResult::Error { code } -> (windows_positioned_error(code))
            WindowsPinnedAccessResult::Value { handle, access } -> access(handle, access, bytes, offset)
        }
    }
    machine access(handle: u64, granted: u32, bytes: &[u8], offset: i64) -> i64 {
        transition (granted & 1048578) == 1048578 {
            true -> reopen(handle, bytes, offset)
            false -> denied(handle)
        }
    }
    machine denied(handle: u64) -> i64 {
        let released: i32 = block WindowsFilesystemNativeProvider::close_handle(handle);
        -5
    }
    machine reopen(handle: u64, bytes: &[u8], offset: i64) -> i64 {
        let raw: i64 = block WindowsFilesystemPositionIo::reopen_write(narrow_u64_to_i64_wrapping(handle), 1048578, 7, 0);
        let opened: WindowsPositionedFile = block windows_positioned_reopened(handle, raw);
        transition opened {
            WindowsPositionedFile::Error { code } -> (windows_positioned_error(code))
            WindowsPositionedFile::Handle { value } -> position(value, bytes, offset)
        }
    }
    machine position(handle: u64, bytes: &[u8], offset: i64) -> i64 {
        let positioned: i64 = block WindowsFilesystemNativeProvider::set_file_pointer(handle, offset, 0);
        transition positioned == offset {
            true -> transfer(handle, bytes)
            false -> (block windows_positioned_seek_failed(handle, positioned))
        }
    }
    machine transfer(handle: u64, bytes: &[u8]) -> i64 {
        let result: i64 = block WindowsFilesystemNativeProvider::write_file(handle, bytes);
        let released: i32 = block WindowsFilesystemNativeProvider::close_handle(handle);
        windows_transfer_completion(result, released)
    }
}
