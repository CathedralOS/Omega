windows_x86_64 machine windows_filesystem_create_dir_existing(path: &[u8] in Path) -> UnitResult
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    let result: UnitResult = block windows_filesystem_create_dir(path);
    transition result {
        UnitResult::Ok -> UnitResult::Ok
        UnitResult::Error { kind } -> failed(path, kind)
    }
    state failed(path: &[u8] in Path, kind: ErrorKind) -> UnitResult {
        transition kind {
            ErrorKind::AlreadyExists -> block windows_filesystem_existing_directory(path, kind)
            _ -> (UnitResult::Error { kind: kind })
        }
    }
}

windows_x86_64 machine windows_filesystem_create_dir_all(path: &[u8] in Path) -> UnitResult
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    let root: u64 = windows_filesystem_root_length(path);
    transition root < path.len {
        true -> walk(path, root)
        false -> root(path)
    }
    state root(path: &[u8] in Path) -> UnitResult {
        let result: MetadataResult = block windows_filesystem_metadata_path(path, false);
        transition result {
            MetadataResult::Error { kind } -> (UnitResult::Error { kind: kind })
            MetadataResult::Ok { meta } -> root_kind(meta)
        }
    }
    state root_kind(metadata: Metadata) -> UnitResult {
        transition metadata.kind {
            FileKind::Directory -> UnitResult::Ok
            _ -> (UnitResult::Error { kind: ErrorKind::AlreadyExists })
        }
    }
    state walk(path: &[u8] in Path, position: u64) -> UnitResult {
        block windows_filesystem_create_components(path, position)
    }
}

// Advance within one activation. Native filesystem waits have no eventual-
// return promise, so a finite component scan must not publish `terminates` for
// the whole operation. Internal state edges need neither recursive frames nor
// a fabricated progress promise about the OS.
windows_x86_64 machine windows_filesystem_create_components(path: &[u8] in Path, start: u64) -> UnitResult
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    transition { _ -> walk(path, start) }
    state walk(path: &[u8] in Path, position: u64) -> UnitResult {
        transition position < path.len {
            true -> inspect(path, position)
            false -> complete(path)
        }
    }
    state complete(path: &[u8] in Path) -> UnitResult {
        block windows_filesystem_create_dir_existing(path)
    }
    state inspect(path: &[u8] in Path, position: u64) -> UnitResult
    requires position < path.len {
        transition position > 0 && windows_filesystem_separator(path, path[position]) {
            true -> create(path, position)
            false -> walk(path, position + 1)
        }
    }
    state create(path: &[u8] in Path, position: u64) -> UnitResult
    requires position < path.len {
        let result: UnitResult = block windows_filesystem_create_dir_existing(path[0..position]);
        transition result {
            UnitResult::Error { kind } -> (UnitResult::Error { kind: kind })
            UnitResult::Ok -> walk(path, position + 1)
        }
    }
}
