windows_x86_64 machine windows_filesystem_existing_directory(path: &[u8] in Path, original: ErrorKind) -> UnitResult
reaches FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    let result: MetadataResult = block windows_filesystem_metadata_path(path, false);
    transition result {
        MetadataResult::Ok { meta } -> kind(meta, original)
        MetadataResult::Error { kind } -> (UnitResult::Error { kind: original })
    }
    state kind(metadata: Metadata, original: ErrorKind) -> UnitResult {
        transition metadata.kind {
            FileKind::Directory -> UnitResult::Ok
            _ -> (UnitResult::Error { kind: original })
        }
    }
}

windows_x86_64 machine windows_filesystem_hard_link(original: &[u8] in Path, link: &[u8] in Path) -> UnitResult
reaches FilesystemNamespaceMutation
invokes WindowsFilesystemHost;
{
    let status: i32 = block WindowsFilesystemHost::hard_link(original, link);
    windows_filesystem_unit(status)
}

windows_x86_64 machine windows_filesystem_canonicalize(path: &[u8] in Path, output: &mut [u8]) -> UnitResult
reaches FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    let status: i32 = block WindowsFilesystemHost::canonicalize(path, output);
    windows_filesystem_unit(status)
