// Namespace operations use non-copying rename. Recursive creation treats drive,
// UNC and extended UNC roots as existing namespaces, not components to create.
// An already-existing prefix succeeds only after a followed directory query;
// ordinary files and dangling links must not turn mkdir failure into success.
use filesystem;
use filesystem_host;
use windows_filesystem_host;
use omega::language::core::filesystem_authority;
use targets::windows_x86_64::filesystem::errors;

windows_x86_64 machine windows_filesystem_remove_dir_all(path: &[u8] in Path) -> UnitResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration + FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    let status: i32 = block WindowsFilesystemHost::remove_tree(path);
    windows_filesystem_unit(status)
}

windows_x86_64 machine windows_filesystem_read_link(path: &[u8] in Path, output: &mut [u8], count: u64) -> IoResult
reaches FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    let transferred: i64 = block WindowsFilesystemHost::read_link(path, output, count);
    windows_filesystem_transferred(transferred, count)
}
use targets::windows_x86_64::filesystem::metadata;

machine windows_filesystem_extended_path(path: &[u8]) -> bool {
    transition path.len >= 4 { true -> prefix(path) false -> false }
    state prefix(path: &[u8]) -> bool requires path.len >= 4 {
        path[0] == 92 && path[1] == 92 && path[2] == 63 && path[3] == 92
    }
}

// Extended paths disable Win32 slash normalization. Treating their '/' as a
// separator could create a prefix which the authored path never requested.
// https://learn.microsoft.com/windows/win32/fileio/maximum-file-path-limitation
machine windows_filesystem_separator(path: &[u8], character: u8) -> bool {
    character == 92 || (character == 47 && !windows_filesystem_extended_path(path))
}

// Return the end of the root spelling. Callers check the returned bound before
// slicing; malformed roots are left to Windows, never normalized into another
// path. Ordinary paths accept both separators; extended paths only backslash.
machine windows_filesystem_root_length(path: &[u8]) -> u64 {
    transition path.len >= 2 { true -> prefix(path) false -> short(path) }
    state short(path: &[u8]) -> u64 {
        transition path.len == 1 { true -> single(path) false -> 0 }
    }
    state single(path: &[u8]) -> u64 requires path.len == 1 {
        transition windows_filesystem_separator(path, path[0]) { true -> 1 false -> 0 }
    }
    state prefix(path: &[u8]) -> u64 requires path.len >= 2 {
        let drive: bool = (path[0] >= 65 && path[0] <= 90) || (path[0] >= 97 && path[0] <= 122);
        transition drive && path[1] == 58 {
            true -> drive(path)
            false -> network(path)
        }
    }
    state drive(path: &[u8]) -> u64 requires path.len >= 2 {
        transition path.len >= 3 { true -> drive_separator(path) false -> 2 }
    }
    state drive_separator(path: &[u8]) -> u64 requires path.len >= 3 {
        transition windows_filesystem_separator(path, path[2]) { true -> 3 false -> 2 }
    }
    state network(path: &[u8]) -> u64 requires path.len >= 2 {
        transition windows_filesystem_separator(path, path[0]) && windows_filesystem_separator(path, path[1]) {
            true -> extended(path)
            false -> rooted(path)
        }
    }
    state rooted(path: &[u8]) -> u64 requires path.len >= 2 {
        transition windows_filesystem_separator(path, path[0]) { true -> 1 false -> 0 }
    }
    state extended(path: &[u8]) -> u64 {
        transition path.len >= 8 { true -> extended_prefix(path) false -> components(path, 2, 2) }
    }
    state extended_prefix(path: &[u8]) -> u64 requires path.len >= 8 {
        transition path[2] == 63 && windows_filesystem_separator(path, path[3])
            && (path[4] == 85 || path[4] == 117)
            && (path[5] == 78 || path[5] == 110)
            && (path[6] == 67 || path[6] == 99)
            && windows_filesystem_separator(path, path[7]) {
            true -> components(path, 8, 2)
            false -> components(path, 2, 2)
        }
    }
    state components(path: &[u8], start: u64, count: u64) -> u64 {
        windows_filesystem_root_components(path, start, count, path.len)
    }
}

// Only this edge advances through root components. A byte-length budget also
// closes malformed/repeated-separator cases without an unbounded search.
machine windows_filesystem_root_components(path: &[u8], position: u64, remaining: u64, budget: u64) -> u64
terminates by budget;
{
    transition position < path.len && budget > 0 {
        true -> inspect(path, position, remaining, budget)
        false -> (path.len)
    }
    state inspect(path: &[u8], position: u64, remaining: u64, budget: u64) -> u64
    requires position < path.len && budget > 0 {
        transition windows_filesystem_separator(path, path[position]) {
            true -> separator(path, position, remaining, budget)
            false -> windows_filesystem_root_components(path, position + 1, remaining, budget - 1)
        }
    }
    state separator(path: &[u8], position: u64, remaining: u64, budget: u64) -> u64
    requires position < path.len && budget > 0 {
        transition remaining > 1 {
            true -> windows_filesystem_root_components(path, position + 1, remaining - 1, budget - 1)
            false -> (position + 1)
        }
    }
}

windows_x86_64 machine windows_filesystem_create_dir(path: &[u8] in Path) -> UnitResult
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes WindowsFilesystemHost;
{
    let status: i32 = block WindowsFilesystemHost::create_directory(path);
    windows_filesystem_unit(status)
}

