// Portable locking is ordinary same-object Windows range locking. Only a
// try-acquisition's ERROR_LOCK_VIOLATION denotes contention; invalid handles,
// denied access and unmatched unlocks remain errors. No service reach is added.
use filesystem;
use windows_filesystem_host;
use targets::windows_x86_64::filesystem::errors;

machine windows_filesystem_lock(file: File) -> UnitResult
invokes WindowsFilesystemHost;
{ windows_filesystem_unit(block WindowsFilesystemHost::lock_file(file.handle, true, false)) }

machine windows_filesystem_lock_shared(file: File) -> UnitResult
invokes WindowsFilesystemHost;
{ windows_filesystem_unit(block WindowsFilesystemHost::lock_file(file.handle, false, false)) }

machine windows_filesystem_try_lock(file: File) -> TryLockResult
invokes WindowsFilesystemHost;
{ windows_filesystem_try_lock_result(block WindowsFilesystemHost::lock_file(file.handle, true, true)) }

machine windows_filesystem_try_lock_shared(file: File) -> TryLockResult
invokes WindowsFilesystemHost;
{ windows_filesystem_try_lock_result(block WindowsFilesystemHost::lock_file(file.handle, false, true)) }

machine windows_filesystem_unlock(file: File) -> UnitResult
invokes WindowsFilesystemHost;
{ windows_filesystem_unit(block WindowsFilesystemHost::unlock_file(file.handle)) }

machine windows_filesystem_try_lock_result(status: i32) -> TryLockResult {
    transition status {
        0 -> TryLockResult::Acquired
        -33 -> TryLockResult::WouldBlock
        _ -> (TryLockResult::Error { kind: windows_filesystem_status_error(status as i64) })
    }
}
