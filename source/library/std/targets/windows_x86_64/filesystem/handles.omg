// File handles remain native HANDLE values; zero is absent. Opens preserve
// read/write/delete sharing. Append requests omit FILE_WRITE_DATA, so every
// ordinary write uses the OS's append placement rather than a racy seek to EOF.
// Positioned I/O has its own independent-object path, never seek/restore here.
// Owned opens add SECURITY_SQOS_PRESENT with the zero Anonymous level: a
// file-like endpoint must not inherit permission to impersonate the caller.
// The raw create_file API still preserves its caller's explicit native flags.
use filesystem;
use filesystem_host;
use windows_filesystem_host;
use omega::language::core::filesystem_authority;
use targets::windows_x86_64::filesystem::errors;

windows_x86_64 machine windows_filesystem_opened(handle: u64) -> OpenResult
invokes WindowsFilesystemHost;
{
    transition handle != 0 {
        true -> (OpenResult::Ok { file: File { handle: handle } })
        false -> failed()
    }
    machine failed() -> OpenResult {
        let code: u32 = WindowsFilesystemHost::last_error();
        OpenResult::Error { kind: windows_filesystem_error(code) }
    }
}

windows_x86_64 machine windows_filesystem_open_with(path: &[u8] in Path, options: OpenOptions) -> OpenResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes WindowsFilesystemHost;
{
    // Truncation requires random-write access. Append-only access cannot
    // satisfy it, and must not be upgraded just to make a flag combination fit.
    transition options.truncate && (!options.write || options.append) && !options.create_new {
        true -> (OpenResult::Error { kind: ErrorKind::InvalidInput })
        false -> block access(path, options)
    }
    machine access(path: &[u8] in Path, options: OpenOptions) -> OpenResult {
        transition options.read || (!options.write && !options.append) {
            true -> block writable(path, options, 2147483648)
            false -> block writable(path, options, 0)
        }
    }
    machine writable(path: &[u8] in Path, options: OpenOptions, desired: u32) -> OpenResult {
        transition options.append {
            true -> block disposition(path, options, desired | 1179924)
            false -> block ordinary_write(path, options, desired)
        }
    }
    machine ordinary_write(path: &[u8] in Path, options: OpenOptions, desired: u32) -> OpenResult {
        transition options.write {
            true -> block disposition(path, options, desired | 1073741824)
            false -> block disposition(path, options, desired)
        }
    }
    machine disposition(path: &[u8] in Path, options: OpenOptions, desired: u32) -> OpenResult {
        transition options.create_new {
            true -> block acquire(path, desired, 1)
            false -> block creating(path, options, desired)
        }
    }
    machine creating(path: &[u8] in Path, options: OpenOptions, desired: u32) -> OpenResult {
        transition options.create {
            true -> block create_mode(path, options.truncate, desired)
            false -> block existing_mode(path, options.truncate, desired)
        }
    }
    machine create_mode(path: &[u8] in Path, truncate: bool, desired: u32) -> OpenResult {
        transition truncate { true -> block acquire(path, desired, 2) false -> block acquire(path, desired, 4) }
    }
    machine existing_mode(path: &[u8] in Path, truncate: bool, desired: u32) -> OpenResult {
        transition truncate { true -> block acquire(path, desired, 5) false -> block acquire(path, desired, 3) }
    }
    machine acquire(path: &[u8] in Path, desired: u32, disposition: u32) -> OpenResult {
        let handle: u64 = block WindowsFilesystemHost::create_file(path, desired, 7, disposition, 1048704);
        windows_filesystem_opened(handle)
    }
}

windows_x86_64 machine windows_filesystem_open(path: &[u8] in Path) -> OpenResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes WindowsFilesystemHost;
{
    let options: OpenOptions;
    block windows_filesystem_open_with(path, options)
}

windows_x86_64 machine windows_filesystem_create(path: &[u8] in Path) -> OpenResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes WindowsFilesystemHost;
{
    block windows_filesystem_open_with(path, OpenOptions {
        read: false, write: true, append: false, truncate: true, create: true, create_new: false
    })
}

windows_x86_64 machine windows_filesystem_create_new(path: &[u8] in Path) -> OpenResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes WindowsFilesystemHost;
{
    block windows_filesystem_open_with(path, OpenOptions {
        read: true, write: true, append: false, truncate: false, create: false, create_new: true
    })
}

windows_x86_64 machine windows_filesystem_append(path: &[u8] in Path) -> OpenResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes WindowsFilesystemHost;
{
    block windows_filesystem_open_with(path, OpenOptions {
        read: false, write: false, append: true, truncate: false, create: false, create_new: false
    })
}

windows_x86_64 machine windows_filesystem_read(file: File, buffer: &mut [u8], count: u64) -> IoResult
reaches FilesystemContentRead
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 && count <= buffer.len {
        true -> block transfer(file, buffer, count)
        false -> invalid(file)
    }
    machine transfer(file: File, buffer: &mut [u8], count: u64) -> IoResult {
        let result: i64 = block WindowsFilesystemHost::read_file(file.handle, buffer, count);
        windows_filesystem_transferred(result, count)
    }
    machine invalid(file: File) -> IoResult {
        transition file.handle == 0 {
            true -> (IoResult::Error { kind: ErrorKind::BadDescriptor })
            false -> (IoResult::Error { kind: ErrorKind::InvalidInput })
        }
    }
}

windows_x86_64 machine windows_filesystem_write(file: File, bytes: &[u8]) -> IoResult
reaches FilesystemContentWrite
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 {
        true -> block transfer(file, bytes)
        false -> (IoResult::Error { kind: ErrorKind::BadDescriptor })
    }
    machine transfer(file: File, bytes: &[u8]) -> IoResult {
        let result: i64 = block WindowsFilesystemHost::write_file(file.handle, bytes);
        windows_filesystem_transferred(result, bytes.len)
    }
}

// The raw positioned operations preserve the original object's cursor and
// cannot upgrade its granted data rights. Validate portable arguments before
// acquiring their temporary independent object; retain the actual short count.
windows_x86_64 machine windows_filesystem_read_at(file: File, buffer: &mut [u8], count: u64, offset: i64) -> IoResult
reaches FilesystemContentRead
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 {
        true -> block validate(file, buffer, count, offset)
        false -> (IoResult::Error { kind: ErrorKind::BadDescriptor })
    }
    machine validate(file: File, buffer: &mut [u8], count: u64, offset: i64) -> IoResult {
        transition offset >= 0 && count <= buffer.len && count <= 4294967295 {
            true -> block transfer(file, buffer, count, offset)
            false -> (IoResult::Error { kind: ErrorKind::InvalidInput })
        }
    }
    machine transfer(file: File, buffer: &mut [u8], count: u64, offset: i64) -> IoResult {
        let result: i64 = block WindowsFilesystemHost::read_at(file.handle, buffer, count, offset);
        windows_filesystem_transferred(result, count)
    }
}

windows_x86_64 machine windows_filesystem_write_at(file: File, bytes: &[u8], offset: i64) -> IoResult
reaches FilesystemContentWrite
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 {
        true -> block validate(file, bytes, offset)
        false -> (IoResult::Error { kind: ErrorKind::BadDescriptor })
    }
    machine validate(file: File, bytes: &[u8], offset: i64) -> IoResult {
        transition offset >= 0 && bytes.len <= 4294967295 {
            true -> block transfer(file, bytes, offset)
            false -> (IoResult::Error { kind: ErrorKind::InvalidInput })
        }
    }
    machine transfer(file: File, bytes: &[u8], offset: i64) -> IoResult {
        let result: i64 = block WindowsFilesystemHost::write_at(file.handle, bytes, offset);
        windows_filesystem_transferred(result, bytes.len)
    }
}

windows_x86_64 machine windows_filesystem_close(file: File) -> UnitResult
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 {
        true -> block release(file)
        false -> (UnitResult::Error { kind: ErrorKind::BadDescriptor })
    }
    machine release(file: File) -> UnitResult {
        let status: i32 = block WindowsFilesystemHost::close_handle(file.handle);
        windows_filesystem_unit(status)
    }
}

windows_x86_64 machine windows_filesystem_sync(file: File) -> UnitResult
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 {
        true -> block flush(file)
        false -> (UnitResult::Error { kind: ErrorKind::BadDescriptor })
    }
    machine flush(file: File) -> UnitResult {
        let status: i32 = block WindowsFilesystemHost::flush_file_buffers(file.handle);
        windows_filesystem_unit(status)
    }
}

windows_x86_64 machine windows_filesystem_clone(file: File) -> OpenResult
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 {
        true -> duplicate(file)
        false -> (OpenResult::Error { kind: ErrorKind::BadDescriptor })
    }
    machine duplicate(file: File) -> OpenResult {
        let handle: u64 = WindowsFilesystemHost::duplicate_handle(file.handle);
        windows_filesystem_opened(handle)
    }
}

windows_x86_64 machine windows_filesystem_set_length(file: File, length: i64) -> UnitResult
reaches FilesystemContentWrite + FilesystemMetadataMutation
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 {
        true -> block validate(file, length)
        false -> (UnitResult::Error { kind: ErrorKind::BadDescriptor })
    }
    machine validate(file: File, length: i64) -> UnitResult {
        transition length >= 0 {
            true -> block update(file, length)
            false -> (UnitResult::Error { kind: ErrorKind::InvalidInput })
        }
    }
    machine update(file: File, length: i64) -> UnitResult {
        let status: i32 = block WindowsFilesystemHost::set_file_length(file.handle, length);
        windows_filesystem_unit(status)
    }
}
