// Portable sequencing stays above the raw family. Successful acquisition owns
// one close on every returning path; an earlier error wins over close failure.
// Writes advance the original view and reject zero or oversized progress.
use filesystem;
use filesystem_host;
use windows_filesystem_host;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::filesystem::errors;
use targets::windows_x86_64::filesystem::handles;
use targets::windows_x86_64::filesystem::metadata;

machine windows_filesystem_finish_unit(outcome: UnitResult, released: UnitResult) -> UnitResult {
    transition outcome {
        UnitResult::Error { kind } -> (UnitResult::Error { kind: kind })
        UnitResult::Ok -> (released)
    }
}

machine windows_filesystem_finish_read(outcome: IoResult, released: UnitResult) -> IoResult {
    transition outcome {
        IoResult::Error { kind } -> (IoResult::Error { kind: kind })
        IoResult::Ok { count } -> release(count, released)
    }
    machine release(count: u64, released: UnitResult) -> IoResult {
        transition released {
            UnitResult::Error { kind } -> (IoResult::Error { kind: kind })
            UnitResult::Ok -> (IoResult::Ok { count: count })
        }
    }
}

windows_x86_64 machine windows_filesystem_write_complete(file: File, bytes: &[u8]) -> UnitResult
reaches FilesystemContentWrite
invokes WindowsFilesystemHost;
{
    transition { _ -> block remaining(file, bytes, 0) }
    machine remaining(file: File, bytes: &[u8], position: u64) -> UnitResult
    requires position <= bytes.len {
        transition position < bytes.len { true -> block window(file, bytes, position) false -> UnitResult::Ok }
    }
    machine window(file: File, bytes: &[u8], position: u64) -> UnitResult
    requires position < bytes.len {
        transition bytes.len - position > 4294967295 {
            true -> block write(file, bytes, position, position + 4294967295)
            false -> block write(file, bytes, position, bytes.len)
        }
    }
    machine write(file: File, bytes: &[u8], position: u64, end: u64) -> UnitResult
    requires position < end && end <= bytes.len {
        let count: i64 = block WindowsFilesystemHost::write_file(file.handle, bytes[position..end]);
        transition count > 0 {
            true -> block progressed(file, bytes, position, end, count)
            false -> stopped(count)
        }
    }
    machine progressed(file: File, bytes: &[u8], position: u64, end: u64, count: i64) -> UnitResult
    requires position < end && end <= bytes.len && count > 0 {
        let written: u64 = narrow_i64_to_u64_exact(count);
        transition written <= end - position {
            true -> block remaining(file, bytes, position + written)
            false -> (UnitResult::Error { kind: ErrorKind::Other })
        }
    }
    machine stopped(count: i64) -> UnitResult {
        transition count == 0 {
            true -> (UnitResult::Error { kind: ErrorKind::WriteZero })
            false -> (UnitResult::Error { kind: windows_filesystem_status_error(count) })
        }
    }
}

windows_x86_64 machine windows_filesystem_write_all(path: &[u8] in Path, bytes: &[u8]) -> UnitResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes WindowsFilesystemHost;
{
    let acquired: OpenResult = block windows_filesystem_create(path);
    transition acquired {
        OpenResult::Error { kind } -> (UnitResult::Error { kind: kind })
        OpenResult::Ok { file } -> block write(file, bytes)
    }
    machine write(file: File, bytes: &[u8]) -> UnitResult {
        let outcome: UnitResult = block windows_filesystem_write_complete(file, bytes);
        let released: UnitResult = block windows_filesystem_close(file);
        windows_filesystem_finish_unit(outcome, released)
    }
}

// Match the portable bounded-read contract: a short read is a successful
// initialized prefix, not a promise to fill the caller's entire buffer.
windows_x86_64 machine windows_filesystem_read_all(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> IoResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
invokes WindowsFilesystemHost;
{
    transition count <= buffer.len {
        true -> block acquire(path, buffer, count)
        false -> (IoResult::Error { kind: ErrorKind::InvalidInput })
    }
    machine acquire(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> IoResult {
        let acquired: OpenResult = block windows_filesystem_open(path);
        transition acquired {
            OpenResult::Error { kind } -> (IoResult::Error { kind: kind })
            OpenResult::Ok { file } -> block read(file, buffer, count)
        }
    }
    machine read(file: File, buffer: &mut [u8], count: u64) -> IoResult {
        let outcome: IoResult = block windows_filesystem_read(file, buffer, count);
        let released: UnitResult = block windows_filesystem_close(file);
        windows_filesystem_finish_read(outcome, released)
    }
}
