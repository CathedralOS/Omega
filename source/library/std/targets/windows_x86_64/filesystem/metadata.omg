// Decode native Windows facts, never invented POSIX identities. FILETIME uses
// 100-ns ticks from 1601; portable timestamps use signed Unix seconds. A real
// zero timestamp is distinct from unavailable POSIX metadata. Only the known
// symlink/junction tags become Symlink; an unknown reparse tag stays Other.
use filesystem;
use filesystem_host;
use windows_filesystem_host;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::filesystem::errors;

machine windows_filesystem_seconds(ticks: u64) -> i64 {
    narrow_u64_to_i64_exact(ticks / 10000000) - 11644473600
}

machine windows_filesystem_kind(attributes: u32, reparse_tag: u32) -> FileKind {
    transition (attributes & 1024) != 0 {
        true -> reparse(reparse_tag)
        false -> ordinary(attributes)
    }
    state reparse(tag: u32) -> FileKind {
        transition tag == 2684354572 || tag == 2684354563 {
            true -> FileKind::Symlink
            false -> FileKind::Other
        }
    }
    state ordinary(attributes: u32) -> FileKind {
        transition (attributes & 16) != 0 { true -> FileKind::Directory false -> FileKind::File }
    }
}

machine windows_filesystem_metadata_result(outcome: WindowsMetadataResult) -> MetadataResult {
    transition outcome {
        WindowsMetadataResult::Error { code } -> (MetadataResult::Error { kind: windows_filesystem_error(code) })
        WindowsMetadataResult::Value { metadata } -> value(metadata)
    }
    state value(metadata: WindowsFileMetadata) -> MetadataResult {
        transition metadata.length >= 0 {
            true -> valid(metadata)
            false -> (MetadataResult::Error { kind: ErrorKind::Other })
        }
    }
    state valid(metadata: WindowsFileMetadata) -> MetadataResult {
        MetadataResult::Ok { meta: Metadata {
            len: metadata.length,
            kind: windows_filesystem_kind(metadata.attributes, metadata.reparse_tag),
            permissions: Permissions::Readonly { value: (metadata.attributes & 1) != 0 },
            nlink: widen_u32_to_u64(metadata.links),
            posix: PosixMetadataResult::Error { kind: ErrorKind::Unsupported },
            modified_secs: windows_filesystem_seconds(metadata.write_ticks),
            accessed_secs: windows_filesystem_seconds(metadata.access_ticks),
            creation_time: TimestampResult::Ok { seconds: windows_filesystem_seconds(metadata.creation_ticks) },
            changed_secs: windows_filesystem_seconds(metadata.change_ticks)
        } }
    }
}

windows_x86_64 machine windows_filesystem_metadata(file: File) -> MetadataResult
reaches FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 {
        true -> query(file)
        false -> (MetadataResult::Error { kind: ErrorKind::BadDescriptor })
    }
    state query(file: File) -> MetadataResult {
        let outcome: WindowsMetadataResult = block WindowsFilesystemHost::metadata(file.handle);
        windows_filesystem_metadata_result(outcome)
    }
}

windows_x86_64 machine windows_filesystem_metadata_path(path: &[u8] in Path, no_follow: bool) -> MetadataResult
reaches FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    let outcome: WindowsMetadataResult = block WindowsFilesystemHost::read_metadata(path, no_follow);
    windows_filesystem_metadata_result(outcome)
}

windows_x86_64 machine windows_filesystem_exists(path: &[u8] in Path) -> bool
reaches FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    let outcome: MetadataResult = block windows_filesystem_metadata_path(path, false);
    transition outcome { MetadataResult::Ok { meta } -> true _ -> false }
}

windows_x86_64 machine windows_filesystem_try_exists(path: &[u8] in Path) -> ExistsResult
reaches FilesystemMetadataQuery
invokes WindowsFilesystemHost;
{
    let outcome: MetadataResult = block windows_filesystem_metadata_path(path, false);
    transition outcome {
        MetadataResult::Ok { meta } -> ExistsResult::Yes
        MetadataResult::Error { kind } -> failed(kind)
    }
    state failed(kind: ErrorKind) -> ExistsResult {
        transition kind {
            ErrorKind::NotFound -> ExistsResult::No
            _ -> (ExistsResult::Error { kind: kind })
        }
    }
}

data WindowsTimestampEncoding {
    case Error(kind: ErrorKind);
    case Ticks(value: u64);
}

// SetFileTime treats FILETIME zero as "leave unchanged", not the 1601 epoch.
// Refuse that unrepresentable requested update instead of reporting a no-op as
// success. Whole-second encodings can never equal the all-ones suppression key.
// https://learn.microsoft.com/windows/win32/api/fileapi/nf-fileapi-setfiletime
machine windows_filesystem_encode_timestamp(seconds: i64) -> WindowsTimestampEncoding {
    transition seconds == -11644473600 {
        true -> (WindowsTimestampEncoding::Error { kind: ErrorKind::Unsupported })
        false -> range(seconds)
    }
    state range(seconds: i64) -> WindowsTimestampEncoding {
        transition seconds > -11644473600 && seconds <= 1833029933770 {
            true -> encode(seconds)
            false -> (WindowsTimestampEncoding::Error { kind: ErrorKind::InvalidInput })
        }
    }
    state encode(seconds: i64) -> WindowsTimestampEncoding
    requires seconds > -11644473600 && seconds <= 1833029933770 {
        let shifted: i64 = seconds + 11644473600;
        let ticks: u64 = narrow_i64_to_u64_exact(shifted) * 10000000;
        WindowsTimestampEncoding::Ticks { value: ticks }
    }
}

windows_x86_64 machine windows_filesystem_set_times(file: File, accessed: i64, modified: i64) -> UnitResult
reaches FilesystemMetadataMutation
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 {
        true -> access_time(file, accessed, modified)
        false -> (UnitResult::Error { kind: ErrorKind::BadDescriptor })
    }
    state access_time(file: File, accessed: i64, modified: i64) -> UnitResult {
        let encoded: WindowsTimestampEncoding = windows_filesystem_encode_timestamp(accessed);
        transition encoded {
            WindowsTimestampEncoding::Error { kind } -> (UnitResult::Error { kind: kind })
            WindowsTimestampEncoding::Ticks { value } -> write_time(file, value, modified)
        }
    }
    state write_time(file: File, accessed: u64, modified: i64) -> UnitResult {
        let encoded: WindowsTimestampEncoding = windows_filesystem_encode_timestamp(modified);
        transition encoded {
            WindowsTimestampEncoding::Error { kind } -> (UnitResult::Error { kind: kind })
            WindowsTimestampEncoding::Ticks { value } -> update(file, accessed, value)
        }
    }
    state update(file: File, accessed: u64, modified: u64) -> UnitResult {
        let status: i32 = block WindowsFilesystemHost::set_file_time(file.handle, accessed, modified);
        windows_filesystem_unit(status)
    }
}

// A numeric POSIX mode does not encode a Windows ACL. Only the portable
// read-only request is translated; Default restores the ordinary writable bit.
windows_x86_64 machine windows_filesystem_set_permissions(path: &[u8] in Path, permissions: Permissions) -> UnitResult
reaches FilesystemMetadataQuery + FilesystemMetadataMutation
invokes WindowsFilesystemHost;
{
    transition permissions {
        Permissions::Default -> update(path, false)
        Permissions::Readonly { value } -> update(path, value)
        Permissions::Posix { mode } -> (UnitResult::Error { kind: ErrorKind::Unsupported })
    }
    state update(path: &[u8] in Path, readonly: bool) -> UnitResult {
        let status: i32 = block WindowsFilesystemHost::set_path_readonly(path, readonly);
        windows_filesystem_unit(status)
    }
}

windows_x86_64 machine windows_filesystem_set_file_permissions(file: File, permissions: Permissions) -> UnitResult
reaches FilesystemMetadataQuery + FilesystemMetadataMutation
invokes WindowsFilesystemHost;
{
    transition file.handle != 0 {
        true -> select(file, permissions)
        false -> (UnitResult::Error { kind: ErrorKind::BadDescriptor })
    }
    state select(file: File, permissions: Permissions) -> UnitResult {
        transition permissions {
            Permissions::Default -> update(file, false)
            Permissions::Readonly { value } -> update(file, value)
            Permissions::Posix { mode } -> (UnitResult::Error { kind: ErrorKind::Unsupported })
        }
    }
    state update(file: File, readonly: bool) -> UnitResult {
        let status: i32 = block WindowsFilesystemHost::set_handle_readonly(file.handle, readonly);
        windows_filesystem_unit(status)
    }
}
