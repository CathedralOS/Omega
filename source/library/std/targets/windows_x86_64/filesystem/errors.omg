// Portable translation of real Win32 failures. Unknown codes remain Other;
// neither a zero last-error nor a malformed raw status can manufacture success.
// Numeric identities: Microsoft WinError.h, system-error-codes--0-499-.
use filesystem;
use omega::language::core::numeric_conversion;

machine windows_filesystem_error(code: u32) -> ErrorKind {
    transition code {
        1 -> ErrorKind::Unsupported
        2 -> ErrorKind::NotFound
        3 -> ErrorKind::NotFound
        5 -> ErrorKind::PermissionDenied
        6 -> ErrorKind::BadDescriptor
        15 -> ErrorKind::NotFound
        19 -> ErrorKind::PermissionDenied
        32 -> ErrorKind::PermissionDenied
        33 -> ErrorKind::WouldBlock
        50 -> ErrorKind::Unsupported
        53 -> ErrorKind::NotFound
        65 -> ErrorKind::PermissionDenied
        67 -> ErrorKind::NotFound
        80 -> ErrorKind::AlreadyExists
        87 -> ErrorKind::InvalidInput
        111 -> ErrorKind::InvalidInput
        120 -> ErrorKind::Unsupported
        123 -> ErrorKind::InvalidInput
        161 -> ErrorKind::InvalidInput
        183 -> ErrorKind::AlreadyExists
        206 -> ErrorKind::InvalidInput
        267 -> ErrorKind::InvalidInput
        _ -> ErrorKind::Other
    }
}

machine windows_filesystem_status_error(status: i64) -> ErrorKind {
    transition status < 0 && status >= -4294967295 {
        true -> native(status)
        false -> ErrorKind::Other
    }
    state native(status: i64) -> ErrorKind
    requires status < 0 && status >= -4294967295 {
        windows_filesystem_error(narrow_i64_to_u32_exact(0 - status))
    }
}

machine windows_filesystem_unit(status: i32) -> UnitResult {
    transition status == 0 {
        true -> UnitResult::Ok
        false -> (UnitResult::Error { kind: windows_filesystem_status_error(widen_i32_to_i64(status)) })
    }
}

machine windows_filesystem_transferred(status: i64, requested: u64) -> IoResult {
    transition status >= 0 {
        true -> nonnegative(status, requested)
        false -> (IoResult::Error { kind: windows_filesystem_status_error(status) })
    }
    state nonnegative(status: i64, requested: u64) -> IoResult requires status >= 0 {
        let count: u64 = narrow_i64_to_u64_exact(status);
        transition count <= requested {
            true -> (IoResult::Ok { count: count })
            false -> (IoResult::Error { kind: ErrorKind::Other })
        }
    }
}
