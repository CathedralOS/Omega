use targets/windows_x86_64/windows_filesystem_control.omg as control;
use filesystem_host.omg as paths;
use targets/windows_x86_64/windows_filesystem_directory_native.omg as directory_io;
use targets/windows_x86_64/windows_filesystem_native.omg as win_io;
use omega_language_std;
// The raw names iterator owns one fresh private file object until completion.
// Private nonalert synchronous mode makes null-event NT directory queries finish
// before their borrowed outputs expire. Do not substitute an external handle,
// shared alias or asynchronous query and then close/wait as if that completed it.
// Directory changes may be observed during enumeration; no snapshot is promised.
use omega\language\core\FilesystemContentRead;
use omega\language\core\FilesystemContentWrite;
use omega\language\core\FilesystemMetadataMutation;
use omega\language\core\DirectoryEnumeration;
use omega\language\core\FilesystemNamespaceMutation;
use omega\language\core\widen_u32_to_u64;
use omega\language\core\widen_u32_to_i64;
use omega\language\core\narrow_u64_to_i64_wrapping;
use omega\language\core\narrow_i64_to_u64_wrapping;

data WindowsDirectoryStep {
    case Error(code: u32);
    case End;
    case Name(length: u64);
}

machine windows_directory_error(code: u32) -> i64 {
    transition code == 0 { true -> (-31), false -> (0 - widen_u32_to_i64(code)) }
}

machine windows_directory_open(path: @[u8] in |paths|::Path) -> i64 in WindowsPrivateNonalertFileOrAbsent
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let handle: i64 = block windows_directory_acquire(path);
    handle as +WindowsPrivateNonalertFileOrAbsent
}

machine windows_directory_acquire(path: @[u8] in |paths|::Path) -> i64
ensures result != -1
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    // SYNCHRONIZE | FILE_LIST_DIRECTORY, OPEN_EXISTING, shared read/write/delete.
    // Anonymous SQOS; no inheritance, overlap, callbacks or public aliases.
    let handle: u64 = block |control|::windows_filesystem_native_create_file(path, 1048577, 7, 3, 34603008);
    transition handle != 0 { true -> block mode(handle), false -> 0 }
    machine mode(handle: u64) -> i64
    ensures result != -1
    {
        let raw: i64 = narrow_u64_to_i64_wrapping(handle);
        let mutable completion: |win_io|::WindowsFilesystemIoStatus;
        let mutable mode: u32 = 0;
        let status: i32 = block |win_io|::WindowsFilesystemIo::c_file_mode(raw, @mutable completion, @mutable mode, 4, 16);
        transition status == 0 {
            true -> block checked(handle, mode, completion.information),
            false -> block failed_query(handle, status)
        }
    }
    machine checked(handle: u64, mode: u32, returned: u64) -> i64
    ensures result != -1
    {
        let raw: i64 = narrow_u64_to_i64_wrapping(handle);
        transition (mode & 32) != 0 && returned == 4 && raw != 0 && raw != -1 {
            true -> (raw),
            false -> block refuse(handle, 87)
        }
    }
    machine failed_query(handle: u64, status: i32) -> i64
    ensures result != -1
    {
        let code: u32 = |win_io|::WindowsFilesystemIo::c_status_to_error(status);
        transition { _ -> block refuse(handle, code) }
    }
    machine refuse(handle: u64, code: u32) -> i64
    ensures result != -1
    {
        let released: i32 = block |control|::windows_filesystem_native_close_handle(handle);
        |win_io|::WindowsFilesystemIo::c_set_last_error(code);
        0
    }
}

machine windows_directory_next(handle: i64 in WindowsPrivateNonalertFileOrAbsent,
    output: @mutable |directory_io|::WindowsNativeDirectoryNameInfo) -> WindowsDirectoryStep
requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0
reaches DirectoryEnumeration {
    let mutable completion: |win_io|::WindowsFilesystemIoStatus;
    let status: i32 = block |directory_io|::WindowsFilesystemDirectoryIo::next_name(handle, 0, 0, 0, @mutable completion, output, 8208, 12, 1, 0, 0);
    transition status == 0 {
        true -> (windows_directory_decode(output, completion.information)),
        false -> other(status)
    }
    machine other(status: i32) -> WindowsDirectoryStep {
        // STATUS_NO_MORE_FILES, or STATUS_NO_SUCH_FILE for an empty volume
        // root. This is only the query on an already-acquired directory;
        // a missing pathname still fails acquisition, never becomes empty.
        // .NET 10's FileSystemEnumerator.Windows.cs documents the root case.
        // https://github.com/dotnet/runtime/blob/v10.0.0/src/libraries/System.Private.CoreLib/src/System/IO/Enumeration/FileSystemEnumerator.Windows.cs
        transition status == -2147483642 || status == -1073741809 {
            true -> WindowsDirectoryStep::End,
            false -> failed(status)
        }
    }
    machine failed(status: i32) -> WindowsDirectoryStep {
        let code: u32 = |win_io|::WindowsFilesystemIo::c_status_to_error(status);
        WindowsDirectoryStep::Error { code: code }
    }
}

machine windows_directory_decode(output: @|directory_io|::WindowsNativeDirectoryNameInfo, returned: u64) -> WindowsDirectoryStep {
    transition returned >= 12 && returned <= 8208 {
        true -> record(output, returned),
        false -> (WindowsDirectoryStep::Error { code: 122 })
    }
    machine record(output: @|directory_io|::WindowsNativeDirectoryNameInfo, returned: u64) -> WindowsDirectoryStep
    requires returned >= 12 && returned <= 8208 {
        let bytes: u64 = widen_u32_to_u64(output.name_bytes);
        transition (output.control & 4294967295) == 0 && bytes > 0 && bytes <= 8192
            && bytes % 2 == 0 && bytes <= returned - 12 {
            true -> (WindowsDirectoryStep::Name { length: bytes / 2 }),
            false -> (WindowsDirectoryStep::Error { code: 31 })
        }
    }
}

machine windows_directory_dot(output: @|directory_io|::WindowsNativeDirectoryNameInfo, length: u64) -> bool {
    transition length == 1 || length == 2 { true -> first(output, length), false -> false }
    machine first(output: @|directory_io|::WindowsNativeDirectoryNameInfo, length: u64) -> bool {
        transition output.characters[0] == 46 { true -> second(output, length), false -> false }
    }
    machine second(output: @|directory_io|::WindowsNativeDirectoryNameInfo, length: u64) -> bool {
        length == 1 || output.characters[1] == 46
    }
}

machine windows_directory_count_names(path: @[u8] in |paths|::Path, first_only: bool) -> i64
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration {
    let handle: i64 in WindowsPrivateNonalertFileOrAbsent = block windows_directory_open(path);
    transition (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 { true -> block start(handle, first_only), false -> (|control|::windows_filesystem_native_failure_i64()) }
    machine start(handle: i64 in WindowsPrivateNonalertFileOrAbsent, first_only: bool) -> i64 requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 {
        let mutable output: |directory_io|::WindowsNativeDirectoryNameInfo;
        let result: i64 = block windows_directory_scan_names(handle, @mutable output, 0, first_only);
        let released: i32 = block |control|::windows_filesystem_native_close_handle(narrow_i64_to_u64_wrapping(handle as -WindowsPrivateNonalertFileOrAbsent));
        transition result < 0 || released == 0 {
            true -> (result),
            false -> (|control|::windows_filesystem_native_failure_i64())
        }
    }
}

machine windows_directory_scan_names(handle: i64 in WindowsPrivateNonalertFileOrAbsent, output: @mutable |directory_io|::WindowsNativeDirectoryNameInfo, count: i64, first_only: bool) -> i64
requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0
reaches DirectoryEnumeration {
    let step: WindowsDirectoryStep = block windows_directory_next(handle, output);
    transition step {
        WindowsDirectoryStep::Error { code } -> (windows_directory_error(code)),
        WindowsDirectoryStep::End -> (count),
        WindowsDirectoryStep::Name { length } -> block entry(handle, output, count, length, first_only)
    }
    machine entry(handle: i64 in WindowsPrivateNonalertFileOrAbsent, output: @mutable |directory_io|::WindowsNativeDirectoryNameInfo, count: i64, length: u64, first_only: bool) -> i64
    requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 {
        transition windows_directory_dot(output, length) {
            true -> block windows_directory_scan_names(handle, output, count, first_only),
            false -> block ordinary(handle, output, count, first_only)
        }
    }
    machine ordinary(handle: i64 in WindowsPrivateNonalertFileOrAbsent, output: @mutable |directory_io|::WindowsNativeDirectoryNameInfo, count: i64, first_only: bool) -> i64
    requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 {
        transition first_only { true -> (1), false -> block increment(handle, output, count) }
    }
    machine increment(handle: i64 in WindowsPrivateNonalertFileOrAbsent, output: @mutable |directory_io|::WindowsNativeDirectoryNameInfo, count: i64) -> i64
    requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 {
        transition count < 9223372036854775807 {
            true -> block windows_directory_scan_names(handle, output, count + 1, false),
            false -> (-534)
        }
    }
}
