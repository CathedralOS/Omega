// Borrowed buffers must never outlive these synchronous raw operations. An
// external HANDLE need not have passed through our create_file flag check.
// Duplicate first with the same access and no inheritance: the query and
// transfer then use the same live file object even if the original is closed
// and its numerical handle reused. Duplicates preserve the OS-managed cursor;
// reopening, offset-zero OVERLAPPED I/O and seek/restore do not substitute.
//
// The private class-16 query follows Microsoft's shipped .NET 10 implementation:
// dotnet/runtime v10.0.0 SafeFileHandle.Windows.cs, GetFileOptions, lines182-206.
// That code queries FileModeInformation into call-local storage for externally
// supplied handles. This is a narrow native non-retention premise, not a claim
// that generic NtQueryInformationFile requests cannot pend. A generic pending
// fallback may neither free output storage nor wait on an unrelated operation's
// shared file-handle signal. Do not widen the class/length contract silently.
use windows_filesystem_host;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_impl;
use targets::windows_x86_64::windows_filesystem_transfer_native;

// This query-and-pin operation is the exact private issuer. No separate
// constructor can classify a number from caller-supplied mode bits. The OS
// meaning of FILE_SYNCHRONOUS_IO_* is a reviewed native premise, not an
// arithmetic theorem; the qualified result is never returned by the raw API.
machine windows_synchronous_duplicate(handle: u64) -> i64 in WindowsSynchronousFileOrAbsent {
    let pinned: i64 = block windows_query_synchronous_duplicate(handle);
    pinned
}

windows_x86_64 machine windows_query_synchronous_duplicate(handle: u64) -> i64
ensures result != -1 {
    let duplicate: u64 = WindowsFilesystemNativeProvider::duplicate_handle(handle);
    transition duplicate != 0 {
        true -> block query(duplicate)
        _ -> (0)
    }
    machine query(duplicate: u64) -> i64 {
        let raw_handle: i64 = narrow_u64_to_i64_wrapping(duplicate);
        let mut status: WindowsFilesystemIoStatus;
        let mut mode: u32 = 0;
        let result: i32 = block WindowsFilesystemIo::c_file_mode(raw_handle, &mut status, &mut mode, 4, 16);
        transition result == 0 {
            true -> block checked(duplicate, mode)
            _ -> block query_failed(duplicate, result)
        }
    }
    machine checked(duplicate: u64, mode: u32) -> i64 {
        // FILE_SYNCHRONOUS_IO_ALERT | FILE_SYNCHRONOUS_IO_NONALERT.
        // An unknown/unsupported zero record is not synchronous evidence.
        let raw_handle: i64 = narrow_u64_to_i64_wrapping(duplicate);
        transition (mode & 48) != 0 && raw_handle != 0 && raw_handle != -1 {
            true -> (raw_handle)
            _ -> block refused(duplicate, 87)
        }
    }
    machine query_failed(duplicate: u64, status: i32) -> i64 {
        let code: u32 = WindowsFilesystemIo::c_status_to_error(status);
        transition code != 0 { true -> block refused(duplicate, code) _ -> block refused(duplicate, 87) }
    }
    machine refused(duplicate: u64, code: u32) -> i64 {
        let closed: i32 = block WindowsFilesystemNativeProvider::close_handle(duplicate);
        WindowsFilesystemIo::c_set_last_error(code);
        0
    }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::write_file(handle: u64, bytes: &[u8]) -> i64
satisfies WindowsFilesystemHost::write_file
reaches FilesystemContentWrite {
    transition bytes.len <= 4294967295 { true -> block pin(handle, bytes) _ -> (-87) }
    machine pin(handle: u64, bytes: &[u8]) -> i64 {
        let duplicate: i64 in WindowsSynchronousFileOrAbsent = block windows_synchronous_duplicate(handle);
        transition duplicate != 0 {
            true -> block transfer(duplicate, bytes)
            _ -> (WindowsFilesystemNativeProvider::failure_i64())
        }
    }
    machine transfer(duplicate: i64 in WindowsSynchronousFileOrAbsent, bytes: &[u8]) -> i64
    requires duplicate != 0 {
        let result: i64 = block windows_write_pinned(duplicate, bytes);
        let closed: i32 = block WindowsFilesystemNativeProvider::close_handle(narrow_i64_to_u64_wrapping(duplicate as i64));
        windows_transfer_completion(result, closed)
    }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::read_file(handle: u64, buffer: &mut [u8], count: u64) -> i64
satisfies WindowsFilesystemHost::read_file
reaches FilesystemContentRead {
    transition count <= buffer.len && count <= 4294967295 {
        true -> block pin(handle, buffer, count)
        _ -> (-87)
    }
    machine pin(handle: u64, buffer: &mut [u8], count: u64) -> i64 {
        let duplicate: i64 in WindowsSynchronousFileOrAbsent = block windows_synchronous_duplicate(handle);
        transition duplicate != 0 {
            true -> block transfer(duplicate, buffer, count)
            _ -> (WindowsFilesystemNativeProvider::failure_i64())
        }
    }
    machine transfer(duplicate: i64 in WindowsSynchronousFileOrAbsent, buffer: &mut [u8], count: u64) -> i64
    requires duplicate != 0 {
        let result: i64 = block windows_read_pinned(duplicate, buffer, count);
        let closed: i32 = block WindowsFilesystemNativeProvider::close_handle(narrow_i64_to_u64_wrapping(duplicate as i64));
        windows_transfer_completion(result, closed)
    }
}

// Capture the transfer's error before cleanup. A successful transfer still
// reports a failed release; cleanup must never overwrite an earlier failure.
machine windows_transfer_completion(result: i64, closed: i32) -> i64 {
    transition result < 0 { true -> (result) _ -> release(result, closed) }
    machine release(result: i64, closed: i32) -> i64 {
        transition closed < 0 { true -> (widen_i32_to_i64(closed)) _ -> (result) }
    }
}

windows_x86_64 machine windows_write_pinned(handle: i64 in WindowsSynchronousFileOrAbsent, bytes: &[u8]) -> i64
requires handle != 0
reaches FilesystemContentWrite
{
    transition bytes.len <= 4294967295 {
        true -> block sized(handle, bytes)
        _ -> (-87)
    }
    machine sized(handle: i64 in WindowsSynchronousFileOrAbsent, bytes: &[u8]) -> i64
    requires handle != 0 && bytes.len <= 4294967295 {
        let mut written: u32 = 0;
        let ok: i32 = block WindowsFilesystemTransferIo::write_file(handle, bytes, &mut written, 0);
        transition ok == 0 {
            true -> failed()
            _ -> wrote(written)
        }
    }
    machine wrote(written: u32) -> i64 {
        transition { _ -> (widen_u32_to_i64(written)) }
    }
    machine failed() -> i64 {
        transition { _ -> (WindowsFilesystemNativeProvider::failure_i64()) }
    }
}

windows_x86_64 machine windows_read_pinned(handle: i64 in WindowsSynchronousFileOrAbsent, buffer: &mut [u8], count: u64) -> i64
requires handle != 0
reaches FilesystemContentRead {
    transition count <= buffer.len && count <= 4294967295 {
        true -> block bounded(handle, buffer, count)
        _ -> (-87)
    }
    machine bounded(handle: i64 in WindowsSynchronousFileOrAbsent, buffer: &mut [u8], count: u64) -> i64
    requires handle != 0 && count <= buffer.len && count <= 4294967295 {
        block windows_read_window(handle, &mut buffer[0..count])
    }
}

windows_x86_64 machine windows_read_window(handle: i64 in WindowsSynchronousFileOrAbsent, bytes: &mut [u8]) -> i64
requires handle != 0 && bytes.len <= 4294967295
reaches FilesystemContentRead {
        let mut read_count: u32 = 0;
        let succeeded: i32 = block WindowsFilesystemTransferIo::read_file(handle, bytes, &mut read_count, 0);
        transition succeeded == 0 { true -> failed() _ -> read(read_count) }
    machine read(count: u32) -> i64 { widen_u32_to_i64(count) }
    machine failed() -> i64 { WindowsFilesystemNativeProvider::failure_i64() }
}
