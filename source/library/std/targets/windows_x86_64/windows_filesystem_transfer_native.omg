// Exact whole-window imports. Their policy, not a first-byte reference plus
// unrelated count, associates the native pointer/count with one borrowed view.
// The handle classification is issued only after the exact pinned object's
// mode query. It never escapes the private transfer/close flow. This records
// the native completion premise; it is not numeric ownership or a promise
// that an arbitrary copied HANDLE remains valid after release.
use calling;
use omega::language::core::external_binding;
use omega::language::core::filesystem_authority;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_calling;
use targets::windows_x86_64::windows_filesystem_transfer;

// Zero is the failed acquisition. Only nonzero classified values may enter I/O.
domain i64::WindowsSynchronousFileOrAbsent
requires self != -1
established by windows_synchronous_duplicate;

boundary trait WindowsFilesystemTransferIo: Calling<WindowsFilesystemTransferCalling> {
    machine write_file(handle: i64 in WindowsSynchronousFileOrAbsent, bytes: &[u8], transferred: &mut u32, overlapped: u64) -> i32
    reaches
    requires handle != 0 && bytes.len <= 4294967295 && overlapped == 0
    reaches FilesystemContentWrite
    blocks;
    machine read_file(handle: i64 in WindowsSynchronousFileOrAbsent, bytes: &mut [u8], transferred: &mut u32, overlapped: u64) -> i32
    reaches
    requires handle != 0 && bytes.len <= 4294967295 && overlapped == 0
    reaches FilesystemContentRead
    blocks;
}
