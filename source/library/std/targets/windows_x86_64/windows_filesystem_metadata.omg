// A same-access duplicate pins one file object across the three metadata
// queries. Reopening by path could mix different objects after a rename; using
// the original number could mix objects after concurrent close/reuse. Pinning
// does not freeze concurrent writes to that object or grant new access rights.
// Capture each query error before releasing the pin. Cleanup cannot replace
// that primary failure, but a failed close cannot become a successful query.
use windows_filesystem_host;
use filesystem_host;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::windows_filesystem_impl;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_metadata_native;
use targets::windows_x86_64::windows_filesystem_paths;

machine windows_metadata_error() -> WindowsMetadataResult {
    let code: u32 = WindowsFilesystemNativeProvider::last_error();
    transition code != 0 {
        true -> (WindowsMetadataResult::Error { code: code })
        false -> (WindowsMetadataResult::Error { code: 31 })
    }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::metadata(handle: u64) -> WindowsMetadataResult
satisfies WindowsFilesystemHost::metadata
reaches FilesystemMetadataQuery {
    let duplicate: u64 = WindowsFilesystemNativeProvider::duplicate_handle(handle);
    transition duplicate != 0 {
        true -> query(duplicate)
        false -> (windows_metadata_error())
    }
    state query(duplicate: u64) -> WindowsMetadataResult {
        block windows_metadata_owned_handle(duplicate)
    }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::read_metadata(path: &[u8] in Path, no_follow: bool) -> WindowsMetadataResult
satisfies WindowsFilesystemHost::read_metadata
reaches FilesystemMetadataQuery {
    let mut wide: [u16; 4096];
    let count: i64 = windows_wide_path(path, &mut wide);
    wide[4095] = 0;
    transition count > 0 {
        true -> select(wide, no_follow)
        false -> (WindowsMetadataResult::Error { code: 87 })
    }
    state select(wide: [u16; 4096] in WindowsNativePath, no_follow: bool) -> WindowsMetadataResult {
        transition no_follow {
            true -> open(wide, 36700160)
            false -> open(wide, 34603008)
        }
    }
    state open(wide: [u16; 4096] in WindowsNativePath, flags: u32) -> WindowsMetadataResult
    requires flags == 34603008 || flags == 36700160 {
        let raw: i64 = block WindowsFilesystemMetadataIo::open_attributes(&wide, 128, 7, 0, 3, flags, 0);
        let handle: u64 = WindowsFilesystemNativeProvider::normalize_handle(raw);
        transition handle != 0 {
            true -> query(handle)
            false -> (windows_metadata_error())
        }
    }
    state query(handle: u64) -> WindowsMetadataResult { block windows_metadata_owned_handle(handle) }
}

// The only callers supply either a successful same-access duplicate or a
// successful private metadata open. No borrowed caller handle is released.
windows_x86_64 machine windows_metadata_owned_handle(handle: u64) -> WindowsMetadataResult
reaches FilesystemMetadataQuery {
    let outcome: WindowsMetadataResult = block windows_query_metadata(handle);
    let released: i32 = block WindowsFilesystemNativeProvider::close_handle(handle);
    windows_metadata_completion(outcome, released)
}

machine windows_metadata_completion(outcome: WindowsMetadataResult, released: i32) -> WindowsMetadataResult {
    transition outcome {
        WindowsMetadataResult::Error { code } -> (WindowsMetadataResult::Error { code: code })
        WindowsMetadataResult::Value { metadata } -> checked(metadata, released)
    }
    state checked(metadata: WindowsFileMetadata, released: i32) -> WindowsMetadataResult {
        transition released == 0 {
            true -> (WindowsMetadataResult::Value { metadata: metadata })
            false -> (windows_metadata_error())
        }
    }
}

// GetFileInformationByHandleEx explicitly excludes pipes. Identity/liveness
// alone does not establish this premise. Clear the native error before the
// type query so a valid FILE_TYPE_UNKNOWN cannot inherit an unrelated error.
// https://learn.microsoft.com/windows/win32/api/fileapi/nf-fileapi-getfiletype
windows_x86_64 machine windows_classify_metadata_disk_file(handle: u64) -> i64 in WindowsDiskFileOrAbsent
reaches FilesystemMetadataQuery {
    let classified: i64 = block windows_metadata_disk_file(handle);
    classified
}

// Keep the raw predicate obligation independent of the qualification the
// authorized result boundary introduces. No internal state assumes issuance.
windows_x86_64 machine windows_metadata_disk_file(handle: u64) -> i64
ensures result != -1
reaches FilesystemMetadataQuery {
    let raw: i64 = narrow_u64_to_i64_wrapping(handle);
    transition raw != 0 && raw != -1 {
        true -> classify(raw)
        false -> refused(6)
    }
    state classify(handle: i64) -> i64 requires handle != 0 && handle != -1 {
        WindowsFilesystemIo::c_set_last_error(0);
        let kind: u32 = block WindowsFilesystemMetadataIo::file_type(handle);
        transition kind == 1 {
            true -> (handle)
            false -> other(kind)
        }
    }
    state other(kind: u32) -> i64 {
        transition kind == 0 {
            true -> unknown()
            false -> refused(50)
        }
    }
    state unknown() -> i64 {
        let code: u32 = WindowsFilesystemIo::c_get_last_error();
        transition code != 0 {
            true -> refused(code)
            false -> refused(50)
        }
    }
    state refused(code: u32) -> i64 {
        WindowsFilesystemIo::c_set_last_error(code);
        0
    }
}

windows_x86_64 machine windows_query_metadata(handle: u64) -> WindowsMetadataResult
reaches FilesystemMetadataQuery {
    let classified: i64 in WindowsDiskFileOrAbsent = block windows_classify_metadata_disk_file(handle);
    transition classified != 0 {
        true -> basic(classified)
        false -> (windows_metadata_error())
    }
    state basic(handle: i64 in WindowsDiskFileOrAbsent) -> WindowsMetadataResult requires handle != 0 {
        let mut basic: WindowsNativeFileBasicInfo;
        let succeeded: i32 = block WindowsFilesystemMetadataIo::basic(handle, 0, &mut basic, 40);
        transition succeeded != 0 {
            true -> standard(handle, basic)
            false -> (windows_metadata_error())
        }
    }
    state standard(handle: i64 in WindowsDiskFileOrAbsent, basic: WindowsNativeFileBasicInfo) -> WindowsMetadataResult requires handle != 0 {
        let mut standard: WindowsNativeFileStandardInfo;
        let succeeded: i32 = block WindowsFilesystemMetadataIo::standard(handle, 1, &mut standard, 24);
        transition succeeded != 0 {
            true -> attributes(handle, basic, standard)
            false -> (windows_metadata_error())
        }
    }
    state attributes(handle: i64 in WindowsDiskFileOrAbsent, basic: WindowsNativeFileBasicInfo, standard: WindowsNativeFileStandardInfo) -> WindowsMetadataResult requires handle != 0 {
        let mut tag: WindowsNativeFileAttributeTagInfo;
        let succeeded: i32 = block WindowsFilesystemMetadataIo::attribute_tag(handle, 9, &mut tag, 8);
        transition succeeded != 0 {
            true -> value(basic, standard, tag)
            false -> (windows_metadata_error())
        }
    }
    state value(basic: WindowsNativeFileBasicInfo, standard: WindowsNativeFileStandardInfo, tag: WindowsNativeFileAttributeTagInfo) -> WindowsMetadataResult {
        WindowsMetadataResult::Value { metadata: WindowsFileMetadata {
            length: standard.length, links: standard.links,
            attributes: tag.attributes, reparse_tag: tag.reparse_tag,
            creation_ticks: basic.creation_ticks, access_ticks: basic.access_ticks,
            write_ticks: basic.write_ticks, change_ticks: basic.change_ticks
        } }
    }
}
