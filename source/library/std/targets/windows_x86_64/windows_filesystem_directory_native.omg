// Names-only enumeration has no metadata-query reach. Its fixed native record
// starts WCHAR data at byte 12; the leading QWORD supplies native alignment
// without inserting padding before that data. Only complete single records are
// consumed. An undersized buffer is an error, never a successful truncated scan.
// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntifs/nf-ntifs-ntquerydirectoryfile
// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntifs/ns-ntifs-_file_names_information
use omega::language::core::external_binding;
use omega::language::core::filesystem_authority;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_private_handles;

// Acquisition creates a fresh noninheritable synchronous nonalert object. The
// issuer and iterator keep it private through final completion and close: no
// external alias can switch ALERT/NONALERT between qualification and submission.
// A duplicate or mode query on an arbitrary external handle cannot establish
// that stability. The public raw family returns counts, never this handle.
data WindowsNativeDirectoryNameInfo {
    control: u64;
    name_bytes: u32;
    characters: [u16; 4096];
}
// FILE_DIRECTORY_INFORMATION: the WCHAR name starts at byte 64. All native
// timestamps and sizes retain their eight-byte slots, even though this adapter
// consumes only attributes and the name. Single-entry results have no next row.
// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntifs/ns-ntifs-_file_directory_information
data WindowsNativeDirectoryEntryInfo {
    control: u64;
    creation: u64;
    access: u64;
    write: u64;
    change: u64;
    length: i64;
    allocation: i64;
    attributes: u32;
    name_bytes: u32;
    characters: [u16; 4096];
}
data WindowsFilesystemDirectoryImports {}

boundary trait WindowsFilesystemDirectoryIo {
    machine next_entry(handle: i64 in WindowsPrivateNonalertFileOrAbsent, event: u64, callback: u64, context: u64,
        status: &mut WindowsFilesystemIoStatus, output: &mut WindowsNativeDirectoryEntryInfo, capacity: u32,
        information_class: u32, single_entry: u8, name_filter: u64, restart: u8) -> i32
    reaches
    requires handle != 0 && event == 0 && callback == 0 && context == 0 && capacity == 8256
        && information_class == 1 && single_entry == 1 && name_filter == 0 && restart <= 1
    reaches DirectoryEnumeration + FilesystemMetadataQuery blocks;
    machine next_name(handle: i64 in WindowsPrivateNonalertFileOrAbsent, event: u64, callback: u64, context: u64,
        status: &mut WindowsFilesystemIoStatus, output: &mut WindowsNativeDirectoryNameInfo, capacity: u32,
        information_class: u32, single_entry: u8, name_filter: u64, restart: u8) -> i32
    requires handle != 0 && event == 0 && callback == 0 && context == 0 && capacity == 8208
        && information_class == 12 && single_entry == 1 && name_filter == 0 && restart == 0
    reaches DirectoryEnumeration blocks;
}

windows_x86_64 machine windows_directory_query_binding() -> ForeignBinding<9, 20, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "ntdll.dll", export: "NtQueryDirectoryFile"
    } }
}

