// Canonicalization opens once for read-attributes, follows the final reparse
// point, queries that private object, then closes it on every returning path.
// Keep the normalized DOS spelling (including \\?\) without lossy conversion.
// Neither a missing path nor an undersized caller buffer becomes success.
use filesystem_host;
use windows_filesystem_host;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::windows_filesystem_impl;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_metadata_native;
use targets::windows_x86_64::windows_filesystem_paths;
use targets::windows_x86_64::windows_filesystem_path_query_native;

windows_x86_64 machine WindowsFilesystemNativeProvider::canonicalize(path: &[u8] in Path, output: &mut [u8]) -> i32
satisfies WindowsFilesystemHost::canonicalize
reaches FilesystemMetadataQuery {
    let mut wide: [u16; 4096];
    let count: i64 = windows_wide_path(path, &mut wide);
    wide[4095] = 0;
    transition count > 0 { true -> block open(wide, output) false -> (-87) }
    machine open(path: [u16; 4096] in WindowsNativePath, output: &mut [u8]) -> i32 {
        let handle: i64 = block WindowsFilesystemMetadataIo::open_attributes(&path, 128, 7, 0, 3, 34603008, 0);
        transition handle != 0 && handle != -1 {
            true -> block query(handle, output)
            false -> (WindowsFilesystemNativeProvider::failure_i32())
        }
    }
    machine query(handle: i64, output: &mut [u8]) -> i32 requires handle != 0 && handle != -1 {
        let result: i32 = block windows_canonical_query(handle, output);
        let released: i32 = block WindowsFilesystemNativeProvider::close_handle(narrow_i64_to_u64_wrapping(handle));
        transition result != 0 { true -> (result) false -> (released) }
    }
}

windows_x86_64 machine windows_canonical_query(handle: i64, output: &mut [u8]) -> i32
requires handle != 0 && handle != -1
reaches FilesystemMetadataQuery {
    let mut resolved: [u16; 4096];
    let characters: u32 = block WindowsFilesystemPathIo::final_path(handle, &mut resolved, 4096, 0);
    transition characters > 0 {
        true -> extent(resolved, characters, output)
        false -> (WindowsFilesystemNativeProvider::failure_i32())
    }
    machine extent(resolved: [u16; 4096], characters: u32, output: &mut [u8]) -> i32 {
        // A too-small native buffer reports required size INCLUDING the NUL;
        // a successful result excludes it. Only the latter authorizes reading.
        transition characters < 4096 {
            true -> encode(resolved, characters, output)
            false -> (-122)
        }
    }
    machine encode(resolved: [u16; 4096], characters: u32, output: &mut [u8]) -> i32
    requires characters < 4096 {
        let count: u64 = widen_u32_to_u64(characters) + 1;
        let mut encoded: [u8; 12288];
        let native_count: i32 = narrow_u64_to_i32_exact(count);
        let written: i32 = WindowsFilesystemUtf8Io::utf8<4096, 12288>(65001, 128, &resolved,
            native_count, &mut encoded, 12288, 0, 0);
        transition written > 0 {
            true -> copy(encoded, written, output)
            false -> (WindowsFilesystemNativeProvider::failure_i32())
        }
    }
    machine copy(encoded: [u8; 12288], written: i32, output: &mut [u8]) -> i32 requires written > 0 {
        let count: u64 = narrow_i32_to_u64_exact(written);
        transition count <= 12288 && count <= output.len {
            true -> (windows_copy_canonical_bytes(&encoded, output, count))
            false -> (-122)
        }
    }
}

// Validate the terminator before modifying caller storage. The returned
// extent includes it, so success never relies on the caller's prior zeroes.
machine windows_copy_canonical_bytes(source: &[u8; 12288], output: &mut [u8], count: u64) -> i32 {
    transition count > 0 && count <= 12288 && count <= output.len {
        true -> terminated(source, output, count)
        false -> (-122)
    }
    machine terminated(source: &[u8; 12288], output: &mut [u8], count: u64) -> i32
    requires count > 0 && count <= 12288 && count <= output.len {
        transition source[count - 1] == 0 { true -> copy(source, output, count, 0) false -> (-31) }
    }
    machine copy(source: &[u8; 12288], output: &mut [u8], count: u64, position: u64) -> i32
    requires count <= 12288 && count <= output.len {
        transition position < count { true -> store(source, output, count, position) false -> 0 }
    }
    machine store(source: &[u8; 12288], output: &mut [u8], count: u64, position: u64) -> i32
    requires count <= 12288 && count <= output.len && position < count {
        output[position] = source[position];
        transition { _ -> copy(source, output, count, position + 1) }
    }
}
