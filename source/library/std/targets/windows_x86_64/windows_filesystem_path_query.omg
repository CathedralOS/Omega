use targets/windows_x86_64/windows_filesystem_control.omg as control;
use targets/windows_x86_64/windows_filesystem_paths.omg as windows_filesystem_paths;
use filesystem_host.omg as paths;
use targets/windows_x86_64/windows_filesystem_metadata_native.omg as metadata_io;
use targets/windows_x86_64/windows_filesystem_path_query_native.omg as path_io;
use omega_language_std;
// Canonicalization opens once for read-attributes, follows the final reparse
// point, queries that private object, then closes it on every returning path.
// Keep the normalized DOS spelling (including \\?\) without lossy conversion.
// Neither a missing path nor an undersized caller buffer becomes success.
use omega\language\core\FilesystemMetadataQuery;
use omega\language\core\widen_u32_to_u64;
use omega\language\core\narrow_u64_to_i32_exact;
use omega\language\core\narrow_i32_to_u64_exact;
use omega\language\core\narrow_i64_to_u64_wrapping;

machine windows_filesystem_native_canonicalize(path: @[u8] in |paths|::Path, output: @mutable [u8]) -> i32
reaches FilesystemMetadataQuery {
    let mutable wide: [u16; 4096];
    let count: i64 = |windows_filesystem_paths|::windows_wide_path(path as - |paths|::Path, @mutable wide);
    wide[4095] = 0;
    transition count > 0 { true -> block open(wide as +WindowsNativePath, output), false -> (-87) }
    machine open(path: [u16; 4096] in WindowsNativePath, output: @mutable [u8]) -> i32 {
        let handle: i64 = block |metadata_io|::WindowsFilesystemMetadataIo::open_attributes(@path, 128, 7, 0, 3, 34603008, 0);
        transition handle != 0 && handle != -1 {
            true -> block query(handle, output),
            false -> (|control|::windows_filesystem_native_failure_i32())
        }
    }
    machine query(handle: i64, output: @mutable [u8]) -> i32 requires handle != 0 && handle != -1 {
        let result: i32 = block windows_canonical_query(handle, output);
        let released: i32 = block |control|::windows_filesystem_native_close_handle(narrow_i64_to_u64_wrapping(handle));
        transition result != 0 { true -> (result), false -> (released) }
    }
}

machine windows_canonical_query(handle: i64, output: @mutable [u8]) -> i32
requires handle != 0 && handle != -1
reaches FilesystemMetadataQuery {
    // An extended-length Win32 path permits up to 32,767 UTF-16 units plus its terminator.
    let mutable resolved: [u16; 32768];
    let characters: u32 = block |path_io|::WindowsFilesystemPathIo::final_path(handle, @mutable resolved, 32768, 0);
    transition characters > 0 {
        true -> extent(@resolved, characters, output),
        false -> (|control|::windows_filesystem_native_failure_i32())
    }
    machine extent(resolved: @[u16; 32768], characters: u32, output: @mutable [u8]) -> i32 {
        // A too-small native buffer reports required size INCLUDING the NUL;
        // a successful result excludes it. Only the latter authorizes reading.
        transition characters < 32768 {
            true -> encode(resolved, characters, output),
            false -> (-122)
        }
    }
    machine encode(resolved: @[u16; 32768], characters: u32, output: @mutable [u8]) -> i32
    requires characters < 32768 {
        let count: u64 = widen_u32_to_u64(characters) + 1;
        let mutable encoded: [u8; 98304];
        let native_count: i32 = narrow_u64_to_i32_exact(count);
        let written: i32 = |path_io|::WindowsFilesystemUtf8Io::utf8::<32768, 98304>(65001, 128, resolved,
            native_count, @mutable encoded, 98304, 0, 0);
        transition written > 0 {
            true -> copy(@encoded, written, output),
            false -> (|control|::windows_filesystem_native_failure_i32())
        }
    }
    machine copy(encoded: @[u8; 98304], written: i32, output: @mutable [u8]) -> i32 requires written > 0 {
        let count: u64 = narrow_i32_to_u64_exact(written);
        windows_copy_canonical_bytes(@encoded[..], output, count)
    }
}

// Validate the terminator before modifying caller storage. The returned
// extent includes it, so success never relies on the caller's prior zeroes.
machine windows_copy_canonical_bytes(source: @[u8], output: @mutable [u8], count: u64) -> i32 {
    transition count > 0 && count <= source.length && count <= output.length {
        true -> terminated(source, output, count),
        false -> (-122)
    }
    machine terminated(source: @[u8], output: @mutable [u8], count: u64) -> i32
    requires count > 0 && count <= source.length && count <= output.length {
        transition source[count - 1] == 0 { true -> copy(source, output, count, 0), false -> (-31) }
    }
    machine copy(source: @[u8], output: @mutable [u8], count: u64, position: u64) -> i32
    requires count <= source.length && count <= output.length {
        transition position < count { true -> store(source, output, count, position), false -> 0 }
    }
    machine store(source: @[u8], output: @mutable [u8], count: u64, position: u64) -> i32
    requires count <= source.length && count <= output.length && position < count {
        output[position] = source[position];
        transition { _ -> copy(source, output, count, position + 1) }
    }
}
