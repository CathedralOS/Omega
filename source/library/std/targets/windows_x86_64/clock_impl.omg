// Complete windows_x86_64 `Clock` provider closure over kernel32 `Sleep`.
// Windows has no stable syscall ABI, so the leaf realizes through DLL linkage
// like every other Windows boundary leaf; `Sleep` takes the millisecond count
// as its single argument, so the leaf signature IS the requirement signature.
use omega::language::core::external_binding;
use clock;


boundary trait WindowsClockSleep {
    machine sleep(milliseconds: u32) reaches Clock;
}

WindowsClock satisfies Clock {
    machine sleep(milliseconds: u32) reaches Clock {
        WindowsClockSleep::sleep(milliseconds);
    }
}
