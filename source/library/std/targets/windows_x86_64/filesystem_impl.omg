// windows_x86_64 `Filesystem` DIRECTORY-WALK implementations (fs
// portable-contract settle 2026-07-18; REAL bodies rung 3b, same day). The
// paradigm-split ops live PER TARGET behind the portable contract declared in
// filesystem.omg's directory-walk contract block; every machine here is
// target-scoped (`windows_x86_64 machine ...`), selected only for this target.
//
// MSVCRT open flags are a foreign bitfield format, encoded by checked target
// package code rather than smuggled through provider-plan VALUE rows. The
// semantic `OpenOptions` value is portable; only this encoder owns MSVCRT's bit
// positions and its mandatory binary-mode bit. Access mode 0/1/2 is the CRT
// O_RDONLY/O_WRONLY/O_RDWR field.
// MSVCRT `_stat64` layout. Real fields occupy bytes 0..55; fields absent from
// that carrier retain the interpreter's synthetic tail positions so native
// Windows honestly observes zero while the hermetic model can expose them.
windows_x86_64 machine StatLayout::plan(&mut self, schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::IntegerAt { offset: 0, stored_width: 32, interpretation: IntegerInterpretation::Unsigned } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::IntegerAt { offset: 6, stored_width: 16, interpretation: IntegerInterpretation::Unsigned } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::IntegerAt { offset: 8, stored_width: 16, interpretation: IntegerInterpretation::Unsigned } };
    entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 64 } };
    entries[4] = FieldEntry { key: schema.fields[4].key, placement: FieldPlan::At { offset: 72 } };
    entries[5] = FieldEntry { key: schema.fields[5].key, placement: FieldPlan::At { offset: 76 } };
    entries[6] = FieldEntry { key: schema.fields[6].key, placement: FieldPlan::IntegerAt { offset: 16, stored_width: 32, interpretation: IntegerInterpretation::Unsigned } };
    entries[7] = FieldEntry { key: schema.fields[7].key, placement: FieldPlan::At { offset: 32 } };
    entries[8] = FieldEntry { key: schema.fields[8].key, placement: FieldPlan::At { offset: 40 } };
    entries[9] = FieldEntry { key: schema.fields[9].key, placement: FieldPlan::At { offset: 80 } };
    entries[10] = FieldEntry { key: schema.fields[10].key, placement: FieldPlan::At { offset: 48 } };
    entries[11] = FieldEntry { key: schema.fields[11].key, placement: FieldPlan::At { offset: 24 } };
    entries[12] = FieldEntry { key: schema.fields[12].key, placement: FieldPlan::At { offset: 88 } };
    entries[13] = FieldEntry { key: schema.fields[13].key, placement: FieldPlan::IntegerAt { offset: 96, stored_width: 32, interpretation: IntegerInterpretation::Unsigned } };
    Plan { entries: entries, entry_count: 14, size_fixed: 144, size_is_dynamic: false, align: 8 }
}

windows_x86_64 machine Filesystem::encode_open_options(filesystem: &mut Filesystem) {
    filesystem.open_writable = (filesystem.open_options.write as i32) | (filesystem.open_options.append as i32);
    filesystem.open_readable = filesystem.open_options.read as i32;
    filesystem.open_creating = (filesystem.open_options.create as i32) | (filesystem.open_options.create_new as i32);
    filesystem.open_flags = ((filesystem.open_writable & (filesystem.open_readable ^ 1))
        | ((filesystem.open_writable & filesystem.open_readable) << 1)
        | ((filesystem.open_options.append as i32) << 3)
        | (filesystem.open_creating << 8)
        | ((filesystem.open_options.truncate as i32) << 9)
        | ((filesystem.open_options.create_new as i32) << 10)
        | 32768);
}

// MSVCRT operations report -1 and retain detail in thread-local errno. Map its
// EWOULDBLOCK value (140) onto the common portable classifier's canonical 35.
windows_x86_64 machine Filesystem::native_error_code_i32(filesystem: &mut Filesystem, result: i32) -> i32
reaches FilesystemHost
{
    filesystem.err_code = filesystem.host.errno();
    transition filesystem.err_code == 140 { true -> would_block(filesystem) _ -> other(filesystem) }
    state would_block(filesystem: &mut Filesystem) -> i32 { 35 }
    state other(filesystem: &mut Filesystem) -> i32 { filesystem.err_code }
}

windows_x86_64 machine Filesystem::native_error_code_i64(filesystem: &mut Filesystem, result: i64) -> i32
reaches FilesystemHost
{
    filesystem.err_code = filesystem.host.errno();
    transition filesystem.err_code == 140 { true -> would_block(filesystem) _ -> other(filesystem) }
    state would_block(filesystem: &mut Filesystem) -> i32 { 35 }
    state other(filesystem: &mut Filesystem) -> i32 { filesystem.err_code }
}

pub windows_x86_64 machine Filesystem::open_with(filesystem: &mut Filesystem, path: &[u8] in Path, options: OpenOptions) -> OpenResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.open_options = options;
    Filesystem::encode_open_options(filesystem);
    let fd: i32 = filesystem.host.open_create(path, filesystem.open_flags, 438);
    transition fd >= 0 { true -> ok(filesystem, fd) _ -> err(filesystem) }
    state ok(filesystem: &mut Filesystem, fd: i32) -> OpenResult { OpenResult::Ok { file: File { fd: fd } } }
    state err(filesystem: &mut Filesystem) -> OpenResult { let kind: ErrorKind = Filesystem::last_error(filesystem); OpenResult::Error { kind: kind } }
}
//
// THE WINDOWS PARADIGM: no dirfd exists -- directory listing is HANDLE
// ENUMERATION over a pattern (`dir/*`) via the find trio (find_first /
// find_next / find_close, kernel32 FindFirstFileA family; rung 3a), and
// removal inside the walk goes by JOINED FULL PATH (remove_name /
// remove_dir_name, the trusted plain-path twins) -- path joining below the
// contract IS the windows paradigm, exactly Rust's split (its Windows
// remove_dir_all also resolves the paradigm beneath the portable surface).
// Patterns and joins use `/`, which Win32 accepts natively and which matches
// the hermetic interpreter's path keys byte-exactly.
//
// Shared assumptions with the posix walk (documented there as D-readdir):
// "." and ".." are the FIRST TWO entries of every real directory in both
// engines (NTFS returns dots first; the hermetic model packs them first), so
// the walk skips at most two leading dot records by NAME. A find record is
// WIN32_FIND_DATAA: attributes u32 @0 (directory bit 0x10), NUL-terminated
// name @44 (record 320 bytes). Names longer than 255 bytes truncate at
// capture, so their removal fails CLEANLY (Error, never a wrong-path
// removal). One find_first failure kind is reported as NotFound (the
// dominant cause; kernel32 sets last-error, not errno, so errno-classifying
// it would read a STALE code -- deterministic honesty over noise).

// List a directory and return its entry COUNT (Rust
// `fs::read_dir(path)?.count()`, excluding "." and ".."). Opens a `path/*`
// enumeration and drains it through the shared scan core (w_scan_drain /
// w_scan_step), which tallies every non-dot record. Unlike the posix walk's
// single 512-byte fill (which undercounts a large directory), the fueled
// enumeration counts up to 4096 records -- the fuel budget is the only cap.
pub windows_x86_64 machine Filesystem::read_dir_count(filesystem: &mut Filesystem, path: &[u8] in Path) -> IoResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.w_scan_count = 0;
    filesystem.w_scan_dirs = 0;
    filesystem.w_scan_files = 0;
    filesystem.w_scan_target = 4294967295;
    filesystem.w_scan_hit = 0;
    filesystem.w_scan_done = 0;
    filesystem.w_scan_pending = 0;
    Filesystem::w_path_copy(filesystem, path, 0);
    transition path.len < 509 { true -> rd_seal(filesystem, path) _ -> rd_err(filesystem, path) }
    // `path` is threaded through every state (mostly unused) so the
    // shared-param domain grant re-establishes `path in Path` after the copy
    // value-call's conservative invalidation -- the posix impl's exact note.
    // (`w_path_len = path.len` lives in the ENTRY: a slice-length write into
    // a field does not lower from a dispatched arm state.)
    state rd_seal(filesystem: &mut Filesystem, path: &[u8] in Path) -> IoResult {
        Filesystem::w_seal_pattern(filesystem, 0);
        transition filesystem.w_help_rc == 0 { true -> rd_open(filesystem, path) _ -> rd_err(filesystem, path) }
    }
    state rd_open(filesystem: &mut Filesystem, path: &[u8] in Path) -> IoResult {
        Filesystem::w_find_open(filesystem, filesystem.w_pat_len);
        transition filesystem.w_find >= 0 { true -> rd_scan(filesystem, path) _ -> rd_nf(filesystem, path) }
    }
    state rd_scan(filesystem: &mut Filesystem, path: &[u8] in Path) -> IoResult {
        filesystem.w_scan_pending = 1;
        filesystem.rda_rc = Filesystem::w_scan_drain(filesystem, 4096);
        filesystem.rda_close_rc = filesystem.host.find_close(filesystem.w_find);
        transition filesystem.rda_rc == 0 { true -> rd_ok(filesystem, path) _ -> rd_err(filesystem, path) }
    }
    state rd_ok(filesystem: &mut Filesystem, path: &[u8] in Path) -> IoResult {
        let count: u64 = filesystem.w_scan_count as u64;
        IoResult::Ok { count: count }
    }
    state rd_nf(filesystem: &mut Filesystem, path: &[u8] in Path) -> IoResult {
        let kind: ErrorKind = ErrorKind::NotFound;
        IoResult::Error { kind: kind }
    }
    state rd_err(filesystem: &mut Filesystem, path: &[u8] in Path) -> IoResult {
        let kind: ErrorKind = Filesystem::last_error(filesystem);
        IoResult::Error { kind: kind }
    }
}

// Summarize a directory's composition in ONE walk (`DirStats { entries,
// subdirs, files }`). The same scan core tallies dirs (attribute bit 0x10)
// vs files (everything else) while it counts; dots are skipped by NAME, so
// no posix-style "subtract the two dot records" correction exists here.
windows_x86_64 machine Filesystem::read_dir_stats(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirStatsResult
reaches FilesystemHost
{
    filesystem.w_scan_count = 0;
    filesystem.w_scan_dirs = 0;
    filesystem.w_scan_files = 0;
    filesystem.w_scan_target = 4294967295;
    filesystem.w_scan_hit = 0;
    filesystem.w_scan_done = 0;
    filesystem.w_scan_pending = 0;
    Filesystem::w_path_copy(filesystem, path, 0);
    transition path.len < 509 { true -> rds_seal(filesystem, path) _ -> rds_err(filesystem, path) }
    // `path` threading: the posix impl's shared-param domain-grant note.
    state rds_seal(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirStatsResult {
        Filesystem::w_seal_pattern(filesystem, 0);
        transition filesystem.w_help_rc == 0 { true -> rds_open(filesystem, path) _ -> rds_err(filesystem, path) }
    }
    state rds_open(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirStatsResult {
        Filesystem::w_find_open(filesystem, filesystem.w_pat_len);
        transition filesystem.w_find >= 0 { true -> rds_scan(filesystem, path) _ -> rds_nf(filesystem, path) }
    }
    state rds_scan(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirStatsResult {
        filesystem.w_scan_pending = 1;
        filesystem.rda_rc = Filesystem::w_scan_drain(filesystem, 4096);
        filesystem.rda_close_rc = filesystem.host.find_close(filesystem.w_find);
        transition filesystem.rda_rc == 0 { true -> rds_ok(filesystem, path) _ -> rds_err(filesystem, path) }
    }
    state rds_ok(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirStatsResult {
        DirStatsResult::Ok { stats: DirStats {
            entries: filesystem.w_scan_count as u64,
            subdirs: filesystem.w_scan_dirs as u64,
            files: filesystem.w_scan_files as u64,
        } }
    }
    state rds_nf(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirStatsResult {
        let kind: ErrorKind = ErrorKind::NotFound;
        DirStatsResult::Error { kind: kind }
    }
    state rds_err(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirStatsResult {
        let kind: ErrorKind = Filesystem::last_error(filesystem);
        DirStatsResult::Error { kind: kind }
    }
}

// Fetch the N-th CHILD entry as a `DirEntry` (Rust's `ReadDir` iterator,
// indexed; dots skipped by NAME so n counts real children). The scan core
// captures the n-th non-dot record's name (NUL-truncated copy into
// entry_name) and kind while the drain runs; no capture => End.
pub windows_x86_64 machine Filesystem::read_dir_nth(filesystem: &mut Filesystem, path: &[u8] in Path, n: u64) -> DirEntryResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.w_scan_count = 0;
    filesystem.w_scan_dirs = 0;
    filesystem.w_scan_files = 0;
    filesystem.w_scan_target = n as u64 in Wrapping;
    filesystem.w_scan_hit = 0;
    filesystem.w_hit_kind = 0;
    filesystem.w_scan_done = 0;
    filesystem.w_scan_pending = 0;
    Filesystem::w_path_copy(filesystem, path, 0);
    transition path.len < 509 { true -> rdn_seal(filesystem, path) _ -> rdn_err(filesystem, path) }
    // `path` threading: the posix impl's shared-param domain-grant note.
    state rdn_seal(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirEntryResult {
        Filesystem::w_seal_pattern(filesystem, 0);
        transition filesystem.w_help_rc == 0 { true -> rdn_open(filesystem, path) _ -> rdn_err(filesystem, path) }
    }
    state rdn_open(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirEntryResult {
        Filesystem::w_find_open(filesystem, filesystem.w_pat_len);
        transition filesystem.w_find >= 0 { true -> rdn_scan(filesystem, path) _ -> rdn_nf(filesystem, path) }
    }
    state rdn_scan(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirEntryResult {
        filesystem.w_scan_pending = 1;
        filesystem.rda_rc = Filesystem::w_scan_drain(filesystem, 4096);
        filesystem.rda_close_rc = filesystem.host.find_close(filesystem.w_find);
        transition filesystem.rda_rc == 0 { true -> rdn_check(filesystem, path) _ -> rdn_err(filesystem, path) }
    }
    state rdn_check(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirEntryResult {
        transition filesystem.w_scan_hit == 1 { true -> rdn_kind(filesystem, path) _ -> rdn_end(filesystem, path) }
    }
    state rdn_kind(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirEntryResult {
        // The LATCHED kind, not the running w_scan_kind: the drain kept
        // classifying records after the hit, so the running field holds the
        // LAST record's kind (a trailing dir made every file child report
        // is_dir here).
        transition filesystem.w_hit_kind == 1 { true -> rdn_ok_dir(filesystem, path) _ -> rdn_ok_file(filesystem, path) }
    }
    state rdn_ok_dir(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirEntryResult {
        let name_len: u64 = filesystem.w_entry_len as u64;
        DirEntryResult::Ok { entry: DirEntry {
            name: filesystem.entry_name,
            name_len: name_len,
            is_dir: true,
            is_file: false,
        } }
    }
    state rdn_ok_file(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirEntryResult {
        let name_len: u64 = filesystem.w_entry_len as u64;
        DirEntryResult::Ok { entry: DirEntry {
            name: filesystem.entry_name,
            name_len: name_len,
            is_dir: false,
            is_file: true,
        } }
    }
    state rdn_end(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirEntryResult { DirEntryResult::End }
    state rdn_nf(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirEntryResult {
        let kind: ErrorKind = ErrorKind::NotFound;
        DirEntryResult::Error { kind: kind }
    }
    state rdn_err(filesystem: &mut Filesystem, path: &[u8] in Path) -> DirEntryResult {
        let kind: ErrorKind = Filesystem::last_error(filesystem);
        DirEntryResult::Error { kind: kind }
    }
}

// Fetch the N-th child of an ALREADY-OPEN directory fd -- a POSIX-paradigm op
// (fd-relative dirent reads) with NO windows equivalent: msvcrt descriptors
// have no directory-enumeration surface, and the find paradigm keys on
// PATTERNS, not descriptors. Honest clean Error (never UB, never a guess);
// nothing in the windows walk calls this -- it exists because the posix
// targets share the name (the contract's shared-name rule) and a portable
// caller reaching it on windows deserves a result, not a resolution hole.
windows_x86_64 machine Filesystem::read_dir_entry_fd(filesystem: &mut Filesystem, dfd: i32, n: u64) -> DirEntryResult {
    transition { _ -> rdef_no(filesystem) }
    state rdef_no(filesystem: &mut Filesystem) -> DirEntryResult {
        let kind: ErrorKind = ErrorKind::Other;
        DirEntryResult::Error { kind: kind }
    }
}

// Recursively remove a directory and ALL of its contents (Rust
// `std::fs::remove_dir_all`), the windows paradigm: the posix dirfd stack
// becomes a PATH-PREFIX stack -- `w_path` holds the CURRENT directory's full
// path (always NUL-terminated at `w_path_len`), `w_len_stack` holds each
// ancestor's path LENGTH (descend = append `/name` + push the new length;
// ascend = pop + truncate). Same drain discipline as posix (D-rda): a single
// fuel budget (4096) bounds TOTAL operations; each step re-enumerates the
// current directory fresh, so removal never races an open enumeration.
pub windows_x86_64 machine Filesystem::remove_dir_all(&mut self, path: &[u8] in Path) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    Filesystem::w_path_copy(&mut self, path, 0);
    transition path.len < 509 { true -> rda_init(path) _ -> rda_err(path) }
    state rda_init(&mut self, path: &[u8] in Path) -> UnitResult {
        Filesystem::w_restore_nul(&mut self, 0);
        self.rda_depth = 1;
        transition self.w_help_rc == 0 { true -> rda_seed(path) _ -> rda_err(path) }
    }
    state rda_seed(&mut self, path: &[u8] in Path) -> UnitResult {
        self.w_len_stack[0] = self.w_path_len;
        self.rda_rc = self.rda_drain(4096);
        transition self.rda_rc == 0 { true -> rda_rmdir(path) _ -> rda_err(path) }
    }
    // The drained ROOT is removed by the caller-visible `in Path` param,
    // exactly like the posix impl (the drain leaves the root to its caller).
    state rda_rmdir(&mut self, path: &[u8] in Path) -> UnitResult {
        let rc: i32 = self.host.remove_dir(path);
        transition rc == 0 { true -> rda_ok() _ -> rda_err(path) }
    }
    state rda_ok(&mut self) -> UnitResult { UnitResult::Ok }
    // `path` is threaded in (unused) so the shared-param domain grant
    // re-establishes `path in Path` here after the drain value-call's
    // conservative invalidation (the posix impl's exact note).
    state rda_err(&mut self, path: &[u8] in Path) -> UnitResult {
        let kind: ErrorKind = Filesystem::last_error(&mut self);
        UnitResult::Error { kind: kind }
    }
}

// Drain every child of the stacked directories (files removed, subdirs
// emptied + removed), ITERATIVELY -- the posix drain's exact fuel shape (the
// entry's own single-comparison re-entry is the only recursion the decreases
// prover accepts; the loop runs its full fuel and no-ops once drained, the
// documented provable trade). Returns 0 on success, -1 on
// error/fuel-exhaustion/depth overflow (> 16).
windows_x86_64 machine Filesystem::rda_drain(&mut self, fuel: u64)
terminates by fuel;
-> i32
{
    self.rda_step(0);
    transition fuel > 0 { true -> rda_drain(fuel - 1) false -> rdd_settle() }
    state rdd_settle(&mut self) -> i32 {
        transition self.rda_verdict == 0 { true -> rdd_done() _ -> rdd_fail() }
    }
    state rdd_done(&mut self) -> i32 { 0 }
    state rdd_fail(&mut self) -> i32 { 0 - 1 }
}

// ONE drain step, the windows paradigm: enumerate the CURRENT directory
// (`w_path/*`), find its first NON-DOT entry (dots are the first two records
// in both engines -- at most two skips), then either remove a file child /
// descend into a subdir child (both by JOINED full path), or -- when only
// dots remain -- close, remove the now-empty directory (unless it is the
// root, which the caller removes), and ascend. Sets `rda_verdict`
// (1 continue / 0 done / -1 error). Every array index is guarded by a
// dominating conjunct in its own incoming transition whose shape MATCHES the
// index expression (the posix impl's prover note). The `step` param is the
// uniform call shape; unused.
windows_x86_64 machine Filesystem::rda_step(&mut self, step: u64)
reaches FilesystemHost
{
    transition self.rda_depth == 0 { true -> rds_alldone() _ -> rds_seal() }

    state rds_alldone(&mut self) { self.rda_verdict = 0; }

    // Open a fresh enumeration of the current directory. The pattern seal
    // overwrites w_path's NUL with "/*"; restore the invariant right after
    // the open (the pattern bytes are consumed by the call itself).
    state rds_seal(&mut self) {
        Filesystem::w_seal_pattern(&mut self, 0);
        transition self.w_help_rc == 0 { true -> rds_open() _ -> rds_fail() }
    }
    state rds_open(&mut self) {
        Filesystem::w_find_open(&mut self, self.w_pat_len);
        Filesystem::w_restore_nul(&mut self, 0);
        transition self.w_find >= 0 { true -> rds_c1() _ -> rds_fail() }
    }

    // find_first already filled find_buf: skip up to TWO leading dot records
    // by NAME ("." = 46,0; ".." = 46,46,0 at the name offset 44).
    state rds_c1(&mut self) {
        self.rd_lo = self.find_buf[44];
        self.rd_hi = self.find_buf[45];
        self.rd_nb = self.find_buf[46];
        transition self.rd_lo == 46 { true -> rds_c1_dot() _ -> rds_entry() }
    }
    state rds_c1_dot(&mut self) {
        transition self.rd_hi == 0 { true -> rds_n1() _ -> rds_c1_dot2() }
    }
    state rds_c1_dot2(&mut self) {
        transition self.rd_hi == 46 { true -> rds_c1_dot3() _ -> rds_entry() }
    }
    state rds_c1_dot3(&mut self) {
        transition self.rd_nb == 0 { true -> rds_n1() _ -> rds_entry() }
    }
    state rds_n1(&mut self) {
        self.w_next_rc = self.host.find_next(self.w_find, &mut self.find_buf);
        transition self.w_next_rc == 1 { true -> rds_c2() _ -> rds_empty() }
    }
    state rds_c2(&mut self) {
        self.rd_lo = self.find_buf[44];
        self.rd_hi = self.find_buf[45];
        self.rd_nb = self.find_buf[46];
        transition self.rd_lo == 46 { true -> rds_c2_dot() _ -> rds_entry() }
    }
    state rds_c2_dot(&mut self) {
        transition self.rd_hi == 0 { true -> rds_n2() _ -> rds_c2_dot2() }
    }
    state rds_c2_dot2(&mut self) {
        transition self.rd_hi == 46 { true -> rds_c2_dot3() _ -> rds_entry() }
    }
    state rds_c2_dot3(&mut self) {
        transition self.rd_nb == 0 { true -> rds_n2() _ -> rds_entry() }
    }
    state rds_n2(&mut self) {
        self.w_next_rc = self.host.find_next(self.w_find, &mut self.find_buf);
        transition self.w_next_rc == 1 { true -> rds_entry() _ -> rds_empty() }
    }

    // ONLY DOTS: the current directory is drained. Close the enumeration;
    // the ROOT (depth 1) is the caller's to remove -- everything deeper is
    // removed here by its full path, then the walk ascends to the parent.
    state rds_empty(&mut self) {
        self.rda_close_rc = self.host.find_close(self.w_find);
        transition self.rda_depth == 1 { true -> rds_rootdone() _ -> rds_rmcur() }
    }
    // Zero the depth so the drain's remaining fuel iterations no-op (the
    // `depth == 0 -> alldone` head) instead of RE-OPENING a find enumeration
    // on the drained root every iteration -- that redundant re-open leaked
    // ~4096 find handles per call (single calls survived; a second dir-walk
    // in the same process hit the handle cap and its find_first returned
    // INVALID_HANDLE_VALUE). w_scan_step idles the same way after `done`.
    state rds_rootdone(&mut self) {
        self.rda_depth = 0;
        self.rda_verdict = 0;
    }
    state rds_rmcur(&mut self) {
        Filesystem::w_remove_dir_at(&mut self, self.w_path_len);
        transition self.rda_rc == 0 { true -> rds_ascend() _ -> rds_fail() }
    }
    state rds_ascend(&mut self) {
        // The parent's length is stacked at depth - 2 (the guard shape
        // matches the index expression exactly; read BEFORE the decrement).
        transition self.rda_depth >= 2 && self.rda_depth - 2 < 16 {
            true -> rds_ascend_go()
            _ -> rds_fail()
        }
    }
    state rds_ascend_go(&mut self) {
        self.w_path_len = self.w_len_stack[self.rda_depth - 2];
        self.rda_depth = self.rda_depth - 1;
        transition self.w_path_len < 512 { true -> rds_ascend_nul() _ -> rds_fail() }
    }
    state rds_ascend_nul(&mut self) {
        self.w_path[self.w_path_len] = 0;
        self.rda_verdict = 1;
    }

    // A REAL entry: capture its name (NUL-truncated into entry_name) and
    // kind, close the enumeration BEFORE mutating the tree, then join the
    // child's full path and remove-or-descend.
    state rds_entry(&mut self) {
        Filesystem::w_capture_name(&mut self, 0);
        self.w_attr = self.find_buf[0];
        transition { _ -> rds_close() }
    }
    state rds_close(&mut self) {
        self.rda_close_rc = self.host.find_close(self.w_find);
        self.rd_lou = widen_u8_to_u64(self.w_attr) as u64 in Wrapping;
        self.rd_hiu = self.rd_lou & 16;
        transition self.rd_hiu == 16 { true -> rds_mark_dir() _ -> rds_mark_file() }
    }
    state rds_mark_dir(&mut self) {
        self.w_scan_kind = 1;
        transition { _ -> rds_join() }
    }
    state rds_mark_file(&mut self) {
        self.w_scan_kind = 2;
        transition { _ -> rds_join() }
    }

    // JOIN: w_path[w_path_len] = '/', the captured name after it, NUL at
    // w_child_len = w_path_len + 1 + w_entry_len.
    state rds_join(&mut self) {
        self.w_child_len = self.w_path_len + 1 + self.w_entry_len;
        transition self.w_child_len < 512 { true -> rds_join_slash() _ -> rds_fail() }
    }
    state rds_join_slash(&mut self) {
        transition self.w_path_len < 512 { true -> rds_join_slash_go() _ -> rds_fail() }
    }
    state rds_join_slash_go(&mut self) {
        self.w_path[self.w_path_len] = 47;
        self.rd_j = 0;
        transition { _ -> rds_jloop() }
    }
    state rds_jloop(&mut self) {
        transition self.rd_j < self.w_entry_len { true -> rds_jcap() _ -> rds_jnul() }
    }
    state rds_jcap(&mut self) {
        transition self.rd_j < 256 { true -> rds_jbyte() _ -> rds_fail() }
    }
    state rds_jbyte(&mut self) {
        self.mkall_byte = self.entry_name[self.rd_j];
        self.rd_ridx = self.w_path_len + 1 + self.rd_j;
        transition self.rd_ridx < 512 { true -> rds_jput() _ -> rds_fail() }
    }
    state rds_jput(&mut self) {
        self.w_path[self.rd_ridx] = self.mkall_byte;
        self.rd_j = self.rd_j + 1;
        transition { _ -> rds_jloop() }
    }
    state rds_jnul(&mut self) {
        transition self.w_child_len < 512 { true -> rds_jnul_go() _ -> rds_fail() }
    }
    state rds_jnul_go(&mut self) {
        self.w_path[self.w_child_len] = 0;
        transition self.w_scan_kind == 1 { true -> rds_descend() _ -> rds_unlink() }
    }

    // FILE child: remove by full joined path, then truncate back to the
    // current directory (restore the NUL at w_path_len).
    state rds_unlink(&mut self) {
        Filesystem::w_remove_file_at(&mut self, self.w_child_len);
        transition self.rda_rc == 0 { true -> rds_untrunc() _ -> rds_fail() }
    }
    state rds_untrunc(&mut self) {
        transition self.w_path_len < 512 { true -> rds_untrunc_go() _ -> rds_fail() }
    }
    state rds_untrunc_go(&mut self) {
        self.w_path[self.w_path_len] = 0;
        self.rda_verdict = 1;
    }

    // DIRECTORY child: descend -- the joined path BECOMES the current path
    // (already NUL-terminated at w_child_len); push its length.
    state rds_descend(&mut self) {
        transition self.rda_depth < 16 { true -> rds_descend_go() _ -> rds_fail() }
    }
    state rds_descend_go(&mut self) {
        self.w_len_stack[self.rda_depth] = self.w_child_len;
        self.rda_depth = self.rda_depth + 1;
        self.w_path_len = self.w_child_len;
        self.rda_verdict = 1;
    }

    state rds_fail(&mut self) { self.rda_verdict = 0 - 1; }
}

// ---------------------------------------------------------------------------
// WINDOWS-INTERNAL helpers (single-target names -- paradigm internals, not
// contract machines; the filter's shared-name rule leaves them silent on
// posix targets).
// ---------------------------------------------------------------------------

// Copy the `in Path` param into w_path, byte by byte -- the mkall_walk /
// mkall_step forward-recursion shape (`terminates by` BoundedDistance). Bytes past
// index 508 are skipped (the caller's `path.len < 509` gate rejects such
// paths before any use). STATEMENT-CALLED, like every helper below: their
// effects live in guarded arm states, which the value-call fence rejects --
// the fence's own prescription is statement call + field result.
windows_x86_64 machine Filesystem::w_path_copy(filesystem: &mut Filesystem, path: &[u8] in Path, i: u64)
terminates by (i, path.len) -> Nat::BoundedDistance;
{
    Filesystem::w_path_put(filesystem, path, i);
    transition i < path.len {
        true -> w_path_copy(filesystem, path, i + 1)
        false -> wpc_done(filesystem, i)
    }
    // At termination `i == path.len`: store it as w_path_len. `i` is a u64
    // PARAMETER (a param->field write lowers), NOT the slice's `.len` (a
    // slice-length->field write has no runtime lowering) -- and there is NO
    // field RMW accumulator, which on re-invocation read a stale
    // static-folded zero and undercounted (the chained-RMW-static-fold face;
    // it silently corrupted every SECOND dir-walk in a process).
    state wpc_done(filesystem: &mut Filesystem, i: u64) { filesystem.w_path_len = i as u64 in Wrapping; }
}

// One byte of the path copy. Both facts (in the slice, in the buffer) ride
// ONE incoming conjunct so the reads/writes are dominated in their own
// transition (facts do not travel across hops).
windows_x86_64 machine Filesystem::w_path_put(filesystem: &mut Filesystem, path: &[u8] in Path, i: u64) {
    transition i < path.len && i < 509 {
        true -> wpp_go(filesystem, path, i)
        _ -> wpp_skip(filesystem)
    }
    state wpp_go(filesystem: &mut Filesystem, path: &[u8] in Path, i: u64) {
        filesystem.mkall_byte = path[i];
        filesystem.w_path[i] = filesystem.mkall_byte;
    }
    state wpp_skip(filesystem: &mut Filesystem) { filesystem.copy_rc = 0; }
}

// Overwrite w_path's terminator with the find pattern tail: '/' at
// w_path_len, '*' after it, NUL after that; w_pat_len = w_path_len + 2.
// w_help_rc = 0, or -1 when the path leaves no room (>= 509).
windows_x86_64 machine Filesystem::w_seal_pattern(filesystem: &mut Filesystem, step: u64) {
    transition filesystem.w_path_len < 509 { true -> wsp_slash(filesystem) _ -> wsp_bad(filesystem) }
    state wsp_slash(filesystem: &mut Filesystem) {
        transition filesystem.w_path_len < 512 { true -> wsp_slash_go(filesystem) _ -> wsp_bad(filesystem) }
    }
    state wsp_slash_go(filesystem: &mut Filesystem) {
        filesystem.w_path[filesystem.w_path_len] = 47;
        filesystem.rd_ridx = filesystem.w_path_len + 1;
        transition filesystem.rd_ridx < 512 { true -> wsp_star_go(filesystem) _ -> wsp_bad(filesystem) }
    }
    state wsp_star_go(filesystem: &mut Filesystem) {
        filesystem.w_path[filesystem.rd_ridx] = 42;
        filesystem.rd_ridx = filesystem.w_path_len + 2;
        transition filesystem.rd_ridx < 512 { true -> wsp_nul_go(filesystem) _ -> wsp_bad(filesystem) }
    }
    state wsp_nul_go(filesystem: &mut Filesystem) {
        filesystem.w_path[filesystem.rd_ridx] = 0;
        filesystem.w_pat_len = filesystem.w_path_len + 2;
        filesystem.w_help_rc = 0;
    }
    state wsp_bad(filesystem: &mut Filesystem) { filesystem.w_help_rc = 0 - 1; }
}

// Restore the NUL terminator at w_path_len (after a pattern seal or a
// child-path truncation). w_help_rc = 0, or -1 out of bounds.
windows_x86_64 machine Filesystem::w_restore_nul(filesystem: &mut Filesystem, step: u64) {
    transition filesystem.w_path_len < 512 { true -> wrn_go(filesystem) _ -> wrn_bad(filesystem) }
    state wrn_go(filesystem: &mut Filesystem) {
        filesystem.w_path[filesystem.w_path_len] = 0;
        filesystem.w_help_rc = 0;
    }
    state wrn_bad(filesystem: &mut Filesystem) { filesystem.w_help_rc = 0 - 1; }
}

// The guarded find_first on w_path[0..k] -- the host call lives in a guarded
// chain of THIS machine's states, so the subslice is provably in bounds; the
// base pointer is a valid C string because the seal NUL-terminated the
// pattern. Result rides `w_find` (-1 on out-of-bounds, matching
// INVALID_HANDLE_VALUE).
windows_x86_64 machine Filesystem::w_find_open(filesystem: &mut Filesystem, k: u64 in Wrapping)
reaches FilesystemHost
{
    transition k < 512 { true -> wfo_go(filesystem, k) _ -> wfo_bad(filesystem) }
    state wfo_go(filesystem: &mut Filesystem, k: u64 in Wrapping) {
        filesystem.w_find = filesystem.host.find_first(filesystem.w_path[0..k], &mut filesystem.find_buf);
    }
    state wfo_bad(filesystem: &mut Filesystem) { filesystem.w_find = 0 - 1; }
}

// Guarded remove of the FILE at w_path[0..k] (the joined child path;
// NUL-terminated at k). Result rides `rda_rc`.
windows_x86_64 machine Filesystem::w_remove_file_at(filesystem: &mut Filesystem, k: u64 in Wrapping)
reaches FilesystemHost
{
    transition k < 512 { true -> wrf_go(filesystem, k) _ -> wrf_bad(filesystem) }
    state wrf_go(filesystem: &mut Filesystem, k: u64 in Wrapping) {
        filesystem.rda_rc = filesystem.host.remove_name(filesystem.w_path[0..k]);
    }
    state wrf_bad(filesystem: &mut Filesystem) { filesystem.rda_rc = 0 - 1; }
}

// Guarded remove of the empty DIRECTORY at w_path[0..k]. Result rides
// `rda_rc`.
windows_x86_64 machine Filesystem::w_remove_dir_at(filesystem: &mut Filesystem, k: u64 in Wrapping)
reaches FilesystemHost
{
    transition k < 512 { true -> wrd_go(filesystem, k) _ -> wrd_bad(filesystem) }
    state wrd_go(filesystem: &mut Filesystem, k: u64 in Wrapping) {
        filesystem.rda_rc = filesystem.host.remove_dir_name(filesystem.w_path[0..k]);
    }
    state wrd_bad(filesystem: &mut Filesystem) { filesystem.rda_rc = 0 - 1; }
}

// Copy the current find record's name (NUL-terminated at find_buf[44..])
// into entry_name, NUL-truncating at 255 bytes; seals entry_name with its
// own NUL and records w_entry_len. The rdef_copy/rdef_nul state-cycle shape.
windows_x86_64 machine Filesystem::w_capture_name(filesystem: &mut Filesystem, step: u64) {
    filesystem.rd_j = 0;
    transition { _ -> wcn_loop(filesystem) }
    state wcn_loop(filesystem: &mut Filesystem) {
        filesystem.rd_ridx = 44 + filesystem.rd_j;
        transition filesystem.rd_ridx < 320 { true -> wcn_read(filesystem) _ -> wcn_seal(filesystem) }
    }
    state wcn_read(filesystem: &mut Filesystem) {
        filesystem.rd_nb = filesystem.find_buf[filesystem.rd_ridx];
        transition filesystem.rd_nb == 0 { true -> wcn_seal(filesystem) _ -> wcn_put(filesystem) }
    }
    state wcn_put(filesystem: &mut Filesystem) {
        transition filesystem.rd_j < 255 { true -> wcn_put_go(filesystem) _ -> wcn_seal(filesystem) }
    }
    state wcn_put_go(filesystem: &mut Filesystem) {
        filesystem.entry_name[filesystem.rd_j] = filesystem.rd_nb;
        filesystem.rd_j = filesystem.rd_j + 1;
        transition { _ -> wcn_loop(filesystem) }
    }
    state wcn_seal(filesystem: &mut Filesystem) {
        transition filesystem.rd_j < 256 { true -> wcn_seal_go(filesystem) _ -> wcn_done(filesystem) }
    }
    state wcn_seal_go(filesystem: &mut Filesystem) {
        filesystem.entry_name[filesystem.rd_j] = 0;
        filesystem.w_entry_len = filesystem.rd_j;
        transition { _ -> wcn_done(filesystem) }
    }
    state wcn_done(filesystem: &mut Filesystem) { filesystem.copy_rc = 0; }
}

// The fueled scan loop -- rda_drain's exact shape over w_scan_step (full
// fuel, no-op once done; verdict protocol). Returns 0 clean / -1 error.
windows_x86_64 machine Filesystem::w_scan_drain(filesystem: &mut Filesystem, fuel: u64)
terminates by fuel;
-> i32
{
    Filesystem::w_scan_step(filesystem, 0);
    transition fuel > 0 { true -> w_scan_drain(filesystem, fuel - 1) false -> wsd_settle(filesystem) }
    state wsd_settle(filesystem: &mut Filesystem) -> i32 {
        transition filesystem.w_scan_verdict == 0 { true -> wsd_done(filesystem) _ -> wsd_fail(filesystem) }
    }
    state wsd_done(filesystem: &mut Filesystem) -> i32 { 0 }
    state wsd_fail(filesystem: &mut Filesystem) -> i32 { 0 - 1 }
}

// ONE scan step: consume the pending find_first record or pull the next one;
// skip dots by NAME; tally non-dot records (dirs by the attribute bit 0x10);
// capture the target-indexed record's name + kind. Sets `w_scan_verdict`
// (1 continue / 0 done). The `step` param is the uniform call shape; unused.
windows_x86_64 machine Filesystem::w_scan_step(filesystem: &mut Filesystem, step: u64)
reaches FilesystemHost
{
    transition filesystem.w_scan_done == 1 { true -> ws_idle(filesystem) _ -> ws_fetch(filesystem) }
    state ws_idle(filesystem: &mut Filesystem) { filesystem.w_scan_verdict = 0; }

    state ws_fetch(filesystem: &mut Filesystem) {
        transition filesystem.w_scan_pending == 1 { true -> ws_first(filesystem) _ -> ws_next(filesystem) }
    }
    state ws_first(filesystem: &mut Filesystem) {
        filesystem.w_scan_pending = 0;
        transition { _ -> ws_classify(filesystem) }
    }
    state ws_next(filesystem: &mut Filesystem) {
        filesystem.w_next_rc = filesystem.host.find_next(filesystem.w_find, &mut filesystem.find_buf);
        transition filesystem.w_next_rc == 1 { true -> ws_classify(filesystem) _ -> ws_end(filesystem) }
    }
    state ws_end(filesystem: &mut Filesystem) {
        filesystem.w_scan_done = 1;
        filesystem.w_scan_verdict = 0;
    }

    state ws_classify(filesystem: &mut Filesystem) {
        filesystem.rd_lo = filesystem.find_buf[44];
        filesystem.rd_hi = filesystem.find_buf[45];
        filesystem.rd_nb = filesystem.find_buf[46];
        transition filesystem.rd_lo == 46 { true -> ws_dot1(filesystem) _ -> ws_real(filesystem) }
    }
    state ws_dot1(filesystem: &mut Filesystem) {
        transition filesystem.rd_hi == 0 { true -> ws_skip(filesystem) _ -> ws_dot2(filesystem) }
    }
    state ws_dot2(filesystem: &mut Filesystem) {
        transition filesystem.rd_hi == 46 { true -> ws_dot3(filesystem) _ -> ws_real(filesystem) }
    }
    state ws_dot3(filesystem: &mut Filesystem) {
        transition filesystem.rd_nb == 0 { true -> ws_skip(filesystem) _ -> ws_real(filesystem) }
    }
    state ws_skip(filesystem: &mut Filesystem) { filesystem.w_scan_verdict = 1; }

    state ws_real(filesystem: &mut Filesystem) {
        filesystem.w_scan_count = filesystem.w_scan_count + 1;
        filesystem.w_attr = filesystem.find_buf[0];
        filesystem.rd_lou = widen_u8_to_u64(filesystem.w_attr) as u64 in Wrapping;
        filesystem.rd_hiu = filesystem.rd_lou & 16;
        transition filesystem.rd_hiu == 16 { true -> ws_dir(filesystem) _ -> ws_file(filesystem) }
    }
    state ws_dir(filesystem: &mut Filesystem) {
        filesystem.w_scan_dirs = filesystem.w_scan_dirs + 1;
        filesystem.w_scan_kind = 1;
        transition filesystem.w_scan_count - 1 == filesystem.w_scan_target { true -> ws_hit(filesystem) _ -> ws_cont(filesystem) }
    }
    state ws_file(filesystem: &mut Filesystem) {
        filesystem.w_scan_files = filesystem.w_scan_files + 1;
        filesystem.w_scan_kind = 2;
        transition filesystem.w_scan_count - 1 == filesystem.w_scan_target { true -> ws_hit(filesystem) _ -> ws_cont(filesystem) }
    }
    state ws_hit(filesystem: &mut Filesystem) {
        Filesystem::w_capture_name(filesystem, 0);
        filesystem.w_scan_hit = 1;
        // Latch the kind with the name: the drain keeps classifying the
        // remaining records, so w_scan_kind moves on after this hit.
        filesystem.w_hit_kind = filesystem.w_scan_kind;
        transition { _ -> ws_cont(filesystem) }
    }
    state ws_cont(filesystem: &mut Filesystem) { filesystem.w_scan_verdict = 1; }
}

// POSITIONED IO (the portable positioned-io contract, windows session
// slice 2): msvcrt fds have NO pread/pwrite, so windows COMPOSES
// save-cursor / seek(SET) / op / restore-cursor over the wired
// _lseeki64/_read/_write rows. All four host calls run in the ENTRY body
// (the value-call fence: side-effecting ARM states re-emit per arm), each
// let-bound, with ONE verdict conjunction at the end -- the restore runs
// UNCONDITIONALLY, so a failed op never leaves the cursor moved; on a bad
// fd every leg fails and errno reads the last EBADF, same class the posix
// raw op reports. A failed positioning leg routes Error even when the
// misplaced op "succeeded", so the caller never trusts the buffer.
// HONEST CAVEAT (recorded in the contract block): unlike posix pread, the
// composition is not atomic against concurrent access to the same fd --
// single-threaded programs (all of Omega today) never observe the
// difference.
pub windows_x86_64 machine Filesystem::read_at(&mut self, file: File, buffer: &mut [u8], count: u64, offset: i64) -> IoResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    self.file_fd = file.fd;
    // SEEK_CUR (1) at 0 = report the cursor; SEEK_SET (0) = position.
    let saved: i64 = self.host.seek(self.file_fd, 0, 1);
    let moved: i64 = self.host.seek(self.file_fd, offset, 0);
    let n: i64 = self.host.read(self.file_fd, buffer, count);
    let back: i64 = self.host.seek(self.file_fd, saved, 0);
    // Verdict legs are PURE chained states (value-call arm bodies re-emit,
    // so only the entry may effect); each check threads the rest through
    // state params.
    transition saved >= 0 { true -> ra_moved(moved, n, back) _ -> err() }
    state ra_moved(&mut self, moved: i64, n: i64, back: i64) -> IoResult {
        transition moved >= 0 { true -> ra_n(n, back) _ -> err() }
    }
    state ra_n(&mut self, n: i64, back: i64) -> IoResult {
        transition n >= 0 { true -> ra_back(n, back) _ -> err() }
    }
    state ra_back(&mut self, n: i64, back: i64) -> IoResult {
        transition back >= 0 { true -> ok(n) _ -> err() }
    }
    state ok(&mut self, n: i64) -> IoResult {
        let converted_count: u64 = narrow_i64_to_u64_exact(n);
        IoResult::Ok { count: converted_count }
    }
    state err(&mut self) -> IoResult { let kind: ErrorKind = Filesystem::last_error(&mut self); IoResult::Error { kind: kind } }
}

// CANONICALIZE (the portable canonicalize contract, windows session slice
// 4a/4d): msvcrt has no realpath, so windows opens a kernel HANDLE directly
// with CreateFileA (access 0, share read/write/delete, OPEN_EXISTING,
// FILE_FLAG_BACKUP_SEMANTICS), then resolves it to its final DOS path
// (GetFinalPathNameByHandleA, flags 0 =
// VOLUME_NAME_DOS, the \\?\-prefixed spelling Rust's windows canonicalize
// returns), and closes it with CloseHandle. Only a successful acquisition
// enters the query/close state. Capacity is the contract's 1024 floor
// (the posix realpath writes up to PATH_MAX=1024 with no cap arg at all).
// A too-small buffer returns the REQUIRED size (>= 1024 fails the fit
// check). Failed acquisition preserves its open error; the query error is
// captured before close can overwrite it.
// FILE_FLAG_BACKUP_SEMANTICS makes files and directories equally valid inputs.
pub windows_x86_64 machine Filesystem::canonicalize(&mut self, path: &[u8] in Path, buffer: &mut [u8]) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    let handle: i64 = self.host.open_path_handle(path, 0, 7, 0, 3, 33554432, 0);
    // Capture the OPEN leg's GetLastError IMMEDIATELY: any trailing Win32
    // call may overwrite the thread-local value.
    let open_error: i32 = self.host.get_last_error();
    self.err_kind = match open_error {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    // CreateFileA fails with INVALID_HANDLE_VALUE, not with every signed
    // negative value. Do not query or close that failed-acquisition sentinel.
    transition handle != -1 { true -> resolve(handle, buffer) _ -> err_open() }
    state resolve(&mut self, handle: i64, buffer: &mut [u8]) -> UnitResult {
        let length: i64 = self.host.final_path_name_by_handle(handle, buffer, 1024, 0);
        let resolve_error: i32 = self.host.get_last_error();
        let closed: i32 = self.host.close_handle(handle);
        // Capture the query error before close can change GetLastError.
        self.win32_error_kind = match resolve_error {
            2 -> ErrorKind::NotFound,
            3 -> ErrorKind::NotFound,
            5 -> ErrorKind::PermissionDenied,
            6 -> ErrorKind::BadDescriptor,
            32 -> ErrorKind::WouldBlock,
            33 -> ErrorKind::WouldBlock,
            80 -> ErrorKind::AlreadyExists,
            183 -> ErrorKind::AlreadyExists,
            _ -> ErrorKind::Other
        };
        transition length > 0 { true -> wc_fit(length) _ -> err_resolve() }
    }
    state wc_fit(&mut self, len: i64) -> UnitResult {
        transition len < 1024 { true -> ok() _ -> err_resolve() }
    }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err_open(&mut self) -> UnitResult {
        // The entry-mapped kind from the open leg's captured GetLastError.
        let kind: ErrorKind = ErrorKind::reconstruct(&self.err_kind);
        UnitResult::Error { kind: kind }
    }
    state err_resolve(&mut self) -> UnitResult {
        let kind: ErrorKind = ErrorKind::reconstruct(&self.win32_error_kind);
        UnitResult::Error { kind: kind }
    }
}

// HARD LINK (the portable hard-link contract, windows session slice 3):
// kernel32 CreateHardLinkA via the designed create_hard_link seam op --
// the Win32 arg order is (NEW link, existing), REVERSED from the portable
// (original, link), with the security-attributes arg the API requires as
// NULL (0). BOOL result: non-zero success. GetLastError is captured before
// branching, so common failure kinds remain portable.
pub windows_x86_64 machine Filesystem::hard_link(&mut self, original: &[u8] in Path, link: &[u8] in Path) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    let rc: i32 = self.host.create_hard_link(link, original, 0);
    let code: i32 = self.host.get_last_error();
    self.win32_error_kind = match code {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = ErrorKind::reconstruct(&self.win32_error_kind); UnitResult::Error { kind: kind } }
}

// FILE TIMES (windows session slice 4b wrapper): convert Unix whole seconds
// to the Win32 FILETIME epoch/tick representation, then stamp the open CRT
// descriptor through its OS-handle bridge. The two 8-byte FILETIMEs use
// independent scratch arrays because host-call pointers must be simple places.
// Arithmetic is explicitly wrapping because the public carrier is the full
// i64 Unix-seconds domain;
// SetFileTime remains the authority on whether a resulting timestamp is valid.
pub windows_x86_64 machine Filesystem::set_times(filesystem: &mut Filesystem, file: File, accessed: i64, modified: i64) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    let accessed_epoch: u64 in Wrapping =
        (narrow_i64_to_u64_wrapping(accessed) as u64 in Wrapping) + 11644473600;
    let accessed_ticks: u64 in Wrapping = accessed_epoch * 10000000;
    let modified_epoch: u64 in Wrapping =
        (narrow_i64_to_u64_wrapping(modified) as u64 in Wrapping) + 11644473600;
    let modified_ticks: u64 in Wrapping = modified_epoch * 10000000;
    let accessed_bits: u64 = accessed_ticks as u64;
    let modified_bits: u64 = modified_ticks as u64;
    filesystem.access_filetime[0] = narrow_u64_to_u8_wrapping(accessed_bits);
    filesystem.access_filetime[1] = narrow_u64_to_u8_wrapping(accessed_bits >> 8);
    filesystem.access_filetime[2] = narrow_u64_to_u8_wrapping(accessed_bits >> 16);
    filesystem.access_filetime[3] = narrow_u64_to_u8_wrapping(accessed_bits >> 24);
    filesystem.access_filetime[4] = narrow_u64_to_u8_wrapping(accessed_bits >> 32);
    filesystem.access_filetime[5] = narrow_u64_to_u8_wrapping(accessed_bits >> 40);
    filesystem.access_filetime[6] = narrow_u64_to_u8_wrapping(accessed_bits >> 48);
    filesystem.access_filetime[7] = narrow_u64_to_u8_wrapping(accessed_bits >> 56);
    filesystem.modified_filetime[0] = narrow_u64_to_u8_wrapping(modified_bits);
    filesystem.modified_filetime[1] = narrow_u64_to_u8_wrapping(modified_bits >> 8);
    filesystem.modified_filetime[2] = narrow_u64_to_u8_wrapping(modified_bits >> 16);
    filesystem.modified_filetime[3] = narrow_u64_to_u8_wrapping(modified_bits >> 24);
    filesystem.modified_filetime[4] = narrow_u64_to_u8_wrapping(modified_bits >> 32);
    filesystem.modified_filetime[5] = narrow_u64_to_u8_wrapping(modified_bits >> 40);
    filesystem.modified_filetime[6] = narrow_u64_to_u8_wrapping(modified_bits >> 48);
    filesystem.modified_filetime[7] = narrow_u64_to_u8_wrapping(modified_bits >> 56);
    filesystem.file_fd = file.fd;
    let handle: i64 = filesystem.host.get_osfhandle(filesystem.file_fd);
    let rc: i32 = filesystem.host.set_file_time(handle, 0, &filesystem.access_filetime, &filesystem.modified_filetime);
    let code: i32 = filesystem.host.get_last_error();
    filesystem.win32_error_kind = match code {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> ok(filesystem) _ -> err(filesystem) }
    state ok(filesystem: &mut Filesystem) -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut Filesystem) -> UnitResult {
        let kind: ErrorKind = ErrorKind::reconstruct(&filesystem.win32_error_kind);
        UnitResult::Error { kind: kind }
    }
}

pub windows_x86_64 machine Filesystem::write_at(filesystem: &mut Filesystem, file: File, bytes: &[u8], offset: i64) -> IoResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.file_fd = file.fd;
    let saved: i64 = filesystem.host.seek(filesystem.file_fd, 0, 1);
    let moved: i64 = filesystem.host.seek(filesystem.file_fd, offset, 0);
    let n: i64 = filesystem.host.write(filesystem.file_fd, bytes);
    let back: i64 = filesystem.host.seek(filesystem.file_fd, saved, 0);
    transition saved >= 0 { true -> wa_moved(filesystem, moved, n, back) _ -> err(filesystem) }
    state wa_moved(filesystem: &mut Filesystem, moved: i64, n: i64, back: i64) -> IoResult {
        transition moved >= 0 { true -> wa_n(filesystem, n, back) _ -> err(filesystem) }
    }
    state wa_n(filesystem: &mut Filesystem, n: i64, back: i64) -> IoResult {
        transition n >= 0 { true -> wa_back(filesystem, n, back) _ -> err(filesystem) }
    }
    state wa_back(filesystem: &mut Filesystem, n: i64, back: i64) -> IoResult {
        transition back >= 0 { true -> ok(filesystem, n) _ -> err(filesystem) }
    }
    state ok(filesystem: &mut Filesystem, n: i64) -> IoResult {
        let converted_count: u64 = narrow_i64_to_u64_exact(n);
        IoResult::Ok { count: converted_count }
    }
    state err(filesystem: &mut Filesystem) -> IoResult { let kind: ErrorKind = Filesystem::last_error(filesystem); IoResult::Error { kind: kind } }
}

// Whole-file advisory locks over the CRT-fd -> HANDLE bridge. LockFileEx sees
// offset 0 in the zeroed OVERLAPPED and length 2^64-1. `_open` creates
// synchronous handles, so blocking acquisitions complete before the call
// returns; providers with overlapped handles owe their own wait composition.
pub windows_x86_64 machine Filesystem::lock(&mut self, file: File) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    self.file_fd = file.fd;
    let handle: i64 = self.host.get_osfhandle(self.file_fd);
    let rc: i32 = self.host.lock_file_ex(handle, 2, 0, 4294967295, 4294967295, &mut self.lock_overlapped);
    let code: i32 = self.host.get_last_error();
    self.win32_error_kind = match code {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = ErrorKind::reconstruct(&self.win32_error_kind); UnitResult::Error { kind: kind } }
}

pub windows_x86_64 machine Filesystem::lock_shared(filesystem: &mut Filesystem, file: File) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.file_fd = file.fd;
    let handle: i64 = filesystem.host.get_osfhandle(filesystem.file_fd);
    let rc: i32 = filesystem.host.lock_file_ex(handle, 0, 0, 4294967295, 4294967295, &mut filesystem.lock_overlapped);
    let code: i32 = filesystem.host.get_last_error();
    filesystem.win32_error_kind = match code {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> ok(filesystem) _ -> err(filesystem) }
    state ok(filesystem: &mut Filesystem) -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut Filesystem) -> UnitResult { let kind: ErrorKind = ErrorKind::reconstruct(&filesystem.win32_error_kind); UnitResult::Error { kind: kind } }
}

pub windows_x86_64 machine Filesystem::try_lock(filesystem: &mut Filesystem, file: File) -> TryLockResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.file_fd = file.fd;
    let handle: i64 = filesystem.host.get_osfhandle(filesystem.file_fd);
    let rc: i32 = filesystem.host.lock_file_ex(handle, 3, 0, 4294967295, 4294967295, &mut filesystem.lock_overlapped);
    filesystem.lock_errno = filesystem.host.get_last_error();
    filesystem.win32_error_kind = match filesystem.lock_errno {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> acquired(filesystem) _ -> contended(filesystem) }
    state acquired(filesystem: &mut Filesystem) -> TryLockResult { TryLockResult::Acquired }
    state contended(filesystem: &mut Filesystem) -> TryLockResult { transition filesystem.lock_errno == 33 { true -> would_block(filesystem) _ -> failed(filesystem) } }
    state would_block(filesystem: &mut Filesystem) -> TryLockResult { TryLockResult::WouldBlock }
    state failed(filesystem: &mut Filesystem) -> TryLockResult { let kind: ErrorKind = ErrorKind::reconstruct(&filesystem.win32_error_kind); TryLockResult::Error { kind: kind } }
}

pub windows_x86_64 machine Filesystem::try_lock_shared(filesystem: &mut Filesystem, file: File) -> TryLockResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.file_fd = file.fd;
    let handle: i64 = filesystem.host.get_osfhandle(filesystem.file_fd);
    let rc: i32 = filesystem.host.lock_file_ex(handle, 1, 0, 4294967295, 4294967295, &mut filesystem.lock_overlapped);
    filesystem.lock_errno = filesystem.host.get_last_error();
    filesystem.win32_error_kind = match filesystem.lock_errno {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> acquired(filesystem) _ -> contended(filesystem) }
    state acquired(filesystem: &mut Filesystem) -> TryLockResult { TryLockResult::Acquired }
    state contended(filesystem: &mut Filesystem) -> TryLockResult { transition filesystem.lock_errno == 33 { true -> would_block(filesystem) _ -> failed(filesystem) } }
    state would_block(filesystem: &mut Filesystem) -> TryLockResult { TryLockResult::WouldBlock }
    state failed(filesystem: &mut Filesystem) -> TryLockResult { let kind: ErrorKind = ErrorKind::reconstruct(&filesystem.win32_error_kind); TryLockResult::Error { kind: kind } }
}

pub windows_x86_64 machine Filesystem::unlock(filesystem: &mut Filesystem, file: File) -> UnitResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    filesystem.file_fd = file.fd;
    let handle: i64 = filesystem.host.get_osfhandle(filesystem.file_fd);
    let first: i32 = filesystem.host.unlock_file(handle, 0, 0, 4294967295, 4294967295);
    let second: i32 = filesystem.host.unlock_file(handle, 0, 0, 4294967295, 4294967295);
    filesystem.lock_errno = filesystem.host.get_last_error();
    transition first != 0 { true -> second_result(filesystem, second) _ -> err(filesystem) }
    state second_result(filesystem: &mut Filesystem, second: i32) -> UnitResult {
        transition second != 0 { true -> ok(filesystem) _ -> second_failed(filesystem) }
    }
    state second_failed(filesystem: &mut Filesystem) -> UnitResult {
        transition filesystem.lock_errno == 158 { true -> ok(filesystem) _ -> err(filesystem) }
    }
    state ok(filesystem: &mut Filesystem) -> UnitResult { UnitResult::Ok }
    state err(filesystem: &mut Filesystem) -> UnitResult { let kind: ErrorKind = ErrorKind::Other; UnitResult::Error { kind: kind } }
}
