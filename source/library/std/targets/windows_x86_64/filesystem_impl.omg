// Portable Windows filesystem entrance. Target-neutral callers retain one
// FilesystemService slot; ordinary operation owners compose the real Windows
// raw family below that slot, never call the portable boundary recursively.

windows_x86_64 machine FilesystemProviderDefaults::provider_defaults(defaults: &mut FilesystemProviderDefaults) {
    FilesystemProviderDefaults::select_provider<FilesystemService, FilesystemWindowsProvider>(defaults);
}
