// windows_x86_64 `Filesystem` DIRECTORY-WALK implementations (fs
// portable-contract settle 2026-07-18; REAL bodies rung 3b, same day). The
// paradigm-split ops live PER TARGET behind the portable contract declared in
// filesystem.omg's directory-walk contract block; every machine here is
// target-scoped (`windows_x86_64 machine ...`), selected only for this target.
//
// MSVCRT open flags are a foreign bitfield format, encoded by checked target
// package code rather than smuggled through provider-plan VALUE rows. The
// semantic `OpenOptions` value is portable; only this encoder owns MSVCRT's bit
// positions and its mandatory binary-mode bit. Access mode 0/1/2 is the CRT
// O_RDONLY/O_WRONLY/O_RDWR field.
// MSVCRT `_stat64` layout. Real fields occupy bytes 0..55; fields absent from
// that carrier retain the interpreter's synthetic tail positions so native
// Windows honestly observes zero while the hermetic model can expose them.
windows_x86_64 machine StatLayout::plan(&mut self, schema: Schema) -> Plan {
    self.entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::IntegerAt { offset: 0, stored_width: 32, interpretation: IntegerInterpretation::Unsigned } };
    self.entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::IntegerAt { offset: 6, stored_width: 16, interpretation: IntegerInterpretation::Unsigned } };
    self.entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::IntegerAt { offset: 8, stored_width: 16, interpretation: IntegerInterpretation::Unsigned } };
    self.entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 64 } };
    self.entries[4] = FieldEntry { key: schema.fields[4].key, placement: FieldPlan::At { offset: 72 } };
    self.entries[5] = FieldEntry { key: schema.fields[5].key, placement: FieldPlan::At { offset: 76 } };
    self.entries[6] = FieldEntry { key: schema.fields[6].key, placement: FieldPlan::IntegerAt { offset: 16, stored_width: 32, interpretation: IntegerInterpretation::Unsigned } };
    self.entries[7] = FieldEntry { key: schema.fields[7].key, placement: FieldPlan::At { offset: 32 } };
    self.entries[8] = FieldEntry { key: schema.fields[8].key, placement: FieldPlan::At { offset: 40 } };
    self.entries[9] = FieldEntry { key: schema.fields[9].key, placement: FieldPlan::At { offset: 80 } };
    self.entries[10] = FieldEntry { key: schema.fields[10].key, placement: FieldPlan::At { offset: 48 } };
    self.entries[11] = FieldEntry { key: schema.fields[11].key, placement: FieldPlan::At { offset: 24 } };
    self.entries[12] = FieldEntry { key: schema.fields[12].key, placement: FieldPlan::At { offset: 88 } };
    self.entries[13] = FieldEntry { key: schema.fields[13].key, placement: FieldPlan::IntegerAt { offset: 96, stored_width: 32, interpretation: IntegerInterpretation::Unsigned } };
    Plan { entries: self.entries, entry_count: 14, size_fixed: 144, size_is_dynamic: false, align: 8 }
}

windows_x86_64 machine Filesystem::encode_open_options(&mut self) {
    self.open_writable = (self.open_options.write as i32) | (self.open_options.append as i32);
    self.open_readable = self.open_options.read as i32;
    self.open_creating = (self.open_options.create as i32) | (self.open_options.create_new as i32);
    self.open_flags = ((self.open_writable & (self.open_readable ^ 1))
        | ((self.open_writable & self.open_readable) << 1)
        | ((self.open_options.append as i32) << 3)
        | (self.open_creating << 8)
        | ((self.open_options.truncate as i32) << 9)
        | ((self.open_options.create_new as i32) << 10)
        | 32768);
}

// MSVCRT operations report -1 and retain detail in thread-local errno. Map its
// EWOULDBLOCK value (140) onto the common portable classifier's canonical 35.
windows_x86_64 machine Filesystem::native_error_code_i32(&mut self, result: i32) -> i32 {
    self.err_code = self.host.errno();
    transition self.err_code == 140 { true -> would_block() _ -> other() }
    state would_block(&mut self) -> i32 { 35 }
    state other(&mut self) -> i32 { self.err_code }
}

windows_x86_64 machine Filesystem::native_error_code_i64(&mut self, result: i64) -> i32 {
    self.err_code = self.host.errno();
    transition self.err_code == 140 { true -> would_block() _ -> other() }
    state would_block(&mut self) -> i32 { 35 }
    state other(&mut self) -> i32 { self.err_code }
}

windows_x86_64 machine Filesystem::open_with(&mut self, path: &[u8] in Path, options: OpenOptions) -> OpenResult {
    self.open_options = options;
    self.encode_open_options();
    let fd: i32 = self.host.open_create(path, self.open_flags, 438);
    transition fd >= 0 { true -> ok(fd) _ -> err() }
    state ok(&mut self, fd: i32) -> OpenResult { OpenResult::Ok { file: File { fd: fd } } }
    state err(&mut self) -> OpenResult { let kind: ErrorKind = self.last_error(); OpenResult::Error { kind: kind } }
}
//
// THE WINDOWS PARADIGM: no dirfd exists -- directory listing is HANDLE
// ENUMERATION over a pattern (`dir/*`) via the find trio (find_first /
// find_next / find_close, kernel32 FindFirstFileA family; rung 3a), and
// removal inside the walk goes by JOINED FULL PATH (remove_name /
// remove_dir_name, the trusted plain-path twins) -- path joining below the
// contract IS the windows paradigm, exactly Rust's split (its Windows
// remove_dir_all also resolves the paradigm beneath the portable surface).
// Patterns and joins use `/`, which Win32 accepts natively and which matches
// the hermetic interpreter's path keys byte-exactly.
//
// Shared assumptions with the posix walk (documented there as D-readdir):
// "." and ".." are the FIRST TWO entries of every real directory in both
// engines (NTFS returns dots first; the hermetic model packs them first), so
// the walk skips at most two leading dot records by NAME. A find record is
// WIN32_FIND_DATAA: attributes u32 @0 (directory bit 0x10), NUL-terminated
// name @44 (record 320 bytes). Names longer than 255 bytes truncate at
// capture, so their removal fails CLEANLY (Error, never a wrong-path
// removal). One find_first failure kind is reported as NotFound (the
// dominant cause; kernel32 sets last-error, not errno, so errno-classifying
// it would read a STALE code -- deterministic honesty over noise).

// List a directory and return its entry COUNT (Rust
// `fs::read_dir(path)?.count()`, excluding "." and ".."). Opens a `path/*`
// enumeration and drains it through the shared scan core (w_scan_drain /
// w_scan_step), which tallies every non-dot record. Unlike the posix walk's
// single 512-byte fill (which undercounts a large directory), the fueled
// enumeration counts up to 4096 records -- the fuel budget is the only cap.
windows_x86_64 machine Filesystem::read_dir_count(&mut self, path: &[u8] in Path) -> IoResult {
    self.w_scan_count = 0;
    self.w_scan_dirs = 0;
    self.w_scan_files = 0;
    self.w_scan_target = 4294967295;
    self.w_scan_hit = 0;
    self.w_scan_done = 0;
    self.w_scan_pending = 0;
    self.w_path_copy(path, 0);
    transition path.len < 509 { true -> rd_seal(path) _ -> rd_err(path) }
    // `path` is threaded through every state (mostly unused) so the
    // shared-param domain grant re-establishes `path in Path` after the copy
    // value-call's conservative invalidation -- the posix impl's exact note.
    // (`w_path_len = path.len` lives in the ENTRY: a slice-length write into
    // a field does not lower from a dispatched arm state.)
    state rd_seal(&mut self, path: &[u8] in Path) -> IoResult {
        self.w_seal_pattern(0);
        transition self.w_help_rc == 0 { true -> rd_open(path) _ -> rd_err(path) }
    }
    state rd_open(&mut self, path: &[u8] in Path) -> IoResult {
        self.w_find_open(self.w_pat_len);
        transition self.w_find >= 0 { true -> rd_scan(path) _ -> rd_nf(path) }
    }
    state rd_scan(&mut self, path: &[u8] in Path) -> IoResult {
        self.w_scan_pending = 1;
        self.rda_rc = self.w_scan_drain(4096);
        self.rda_close_rc = self.host.find_close(self.w_find);
        transition self.rda_rc == 0 { true -> rd_ok(path) _ -> rd_err(path) }
    }
    state rd_ok(&mut self, path: &[u8] in Path) -> IoResult {
        let count: u64 = self.w_scan_count as u64;
        IoResult::Ok { count: count }
    }
    state rd_nf(&mut self, path: &[u8] in Path) -> IoResult {
        let kind: ErrorKind = ErrorKind::NotFound;
        IoResult::Error { kind: kind }
    }
    state rd_err(&mut self, path: &[u8] in Path) -> IoResult {
        let kind: ErrorKind = self.last_error();
        IoResult::Error { kind: kind }
    }
}

// Summarize a directory's composition in ONE walk (`DirStats { entries,
// subdirs, files }`). The same scan core tallies dirs (attribute bit 0x10)
// vs files (everything else) while it counts; dots are skipped by NAME, so
// no posix-style "subtract the two dot records" correction exists here.
windows_x86_64 machine Filesystem::read_dir_stats(&mut self, path: &[u8] in Path) -> DirStatsResult {
    self.w_scan_count = 0;
    self.w_scan_dirs = 0;
    self.w_scan_files = 0;
    self.w_scan_target = 4294967295;
    self.w_scan_hit = 0;
    self.w_scan_done = 0;
    self.w_scan_pending = 0;
    self.w_path_copy(path, 0);
    transition path.len < 509 { true -> rds_seal(path) _ -> rds_err(path) }
    // `path` threading: the posix impl's shared-param domain-grant note.
    state rds_seal(&mut self, path: &[u8] in Path) -> DirStatsResult {
        self.w_seal_pattern(0);
        transition self.w_help_rc == 0 { true -> rds_open(path) _ -> rds_err(path) }
    }
    state rds_open(&mut self, path: &[u8] in Path) -> DirStatsResult {
        self.w_find_open(self.w_pat_len);
        transition self.w_find >= 0 { true -> rds_scan(path) _ -> rds_nf(path) }
    }
    state rds_scan(&mut self, path: &[u8] in Path) -> DirStatsResult {
        self.w_scan_pending = 1;
        self.rda_rc = self.w_scan_drain(4096);
        self.rda_close_rc = self.host.find_close(self.w_find);
        transition self.rda_rc == 0 { true -> rds_ok(path) _ -> rds_err(path) }
    }
    state rds_ok(&mut self, path: &[u8] in Path) -> DirStatsResult {
        DirStatsResult::Ok { stats: DirStats {
            entries: self.w_scan_count as u64,
            subdirs: self.w_scan_dirs as u64,
            files: self.w_scan_files as u64,
        } }
    }
    state rds_nf(&mut self, path: &[u8] in Path) -> DirStatsResult {
        let kind: ErrorKind = ErrorKind::NotFound;
        DirStatsResult::Error { kind: kind }
    }
    state rds_err(&mut self, path: &[u8] in Path) -> DirStatsResult {
        let kind: ErrorKind = self.last_error();
        DirStatsResult::Error { kind: kind }
    }
}

// Fetch the N-th CHILD entry as a `DirEntry` (Rust's `ReadDir` iterator,
// indexed; dots skipped by NAME so n counts real children). The scan core
// captures the n-th non-dot record's name (NUL-truncated copy into
// entry_name) and kind while the drain runs; no capture => End.
windows_x86_64 machine Filesystem::read_dir_nth(&mut self, path: &[u8] in Path, n: u64) -> DirEntryResult {
    self.w_scan_count = 0;
    self.w_scan_dirs = 0;
    self.w_scan_files = 0;
    self.w_scan_target = n as u64 in Wrapping;
    self.w_scan_hit = 0;
    self.w_hit_kind = 0;
    self.w_scan_done = 0;
    self.w_scan_pending = 0;
    self.w_path_copy(path, 0);
    transition path.len < 509 { true -> rdn_seal(path) _ -> rdn_err(path) }
    // `path` threading: the posix impl's shared-param domain-grant note.
    state rdn_seal(&mut self, path: &[u8] in Path) -> DirEntryResult {
        self.w_seal_pattern(0);
        transition self.w_help_rc == 0 { true -> rdn_open(path) _ -> rdn_err(path) }
    }
    state rdn_open(&mut self, path: &[u8] in Path) -> DirEntryResult {
        self.w_find_open(self.w_pat_len);
        transition self.w_find >= 0 { true -> rdn_scan(path) _ -> rdn_nf(path) }
    }
    state rdn_scan(&mut self, path: &[u8] in Path) -> DirEntryResult {
        self.w_scan_pending = 1;
        self.rda_rc = self.w_scan_drain(4096);
        self.rda_close_rc = self.host.find_close(self.w_find);
        transition self.rda_rc == 0 { true -> rdn_check(path) _ -> rdn_err(path) }
    }
    state rdn_check(&mut self, path: &[u8] in Path) -> DirEntryResult {
        transition self.w_scan_hit == 1 { true -> rdn_kind(path) _ -> rdn_end(path) }
    }
    state rdn_kind(&mut self, path: &[u8] in Path) -> DirEntryResult {
        // The LATCHED kind, not the running w_scan_kind: the drain kept
        // classifying records after the hit, so the running field holds the
        // LAST record's kind (a trailing dir made every file child report
        // is_dir here).
        transition self.w_hit_kind == 1 { true -> rdn_ok_dir(path) _ -> rdn_ok_file(path) }
    }
    state rdn_ok_dir(&mut self, path: &[u8] in Path) -> DirEntryResult {
        let name_len: u64 = self.w_entry_len as u64;
        DirEntryResult::Ok { entry: DirEntry {
            name: self.entry_name,
            name_len: name_len,
            is_dir: true,
            is_file: false,
        } }
    }
    state rdn_ok_file(&mut self, path: &[u8] in Path) -> DirEntryResult {
        let name_len: u64 = self.w_entry_len as u64;
        DirEntryResult::Ok { entry: DirEntry {
            name: self.entry_name,
            name_len: name_len,
            is_dir: false,
            is_file: true,
        } }
    }
    state rdn_end(&mut self, path: &[u8] in Path) -> DirEntryResult { DirEntryResult::End }
    state rdn_nf(&mut self, path: &[u8] in Path) -> DirEntryResult {
        let kind: ErrorKind = ErrorKind::NotFound;
        DirEntryResult::Error { kind: kind }
    }
    state rdn_err(&mut self, path: &[u8] in Path) -> DirEntryResult {
        let kind: ErrorKind = self.last_error();
        DirEntryResult::Error { kind: kind }
    }
}

// Fetch the N-th child of an ALREADY-OPEN directory fd -- a POSIX-paradigm op
// (fd-relative dirent reads) with NO windows equivalent: msvcrt descriptors
// have no directory-enumeration surface, and the find paradigm keys on
// PATTERNS, not descriptors. Honest clean Error (never UB, never a guess);
// nothing in the windows walk calls this -- it exists because the posix
// targets share the name (the contract's shared-name rule) and a portable
// caller reaching it on windows deserves a result, not a resolution hole.
windows_x86_64 machine Filesystem::read_dir_entry_fd(&mut self, dfd: i32, n: u64) -> DirEntryResult {
    transition { _ -> rdef_no() }
    state rdef_no(&mut self) -> DirEntryResult {
        let kind: ErrorKind = ErrorKind::Other;
        DirEntryResult::Error { kind: kind }
    }
}

// Recursively remove a directory and ALL of its contents (Rust
// `std::fs::remove_dir_all`), the windows paradigm: the posix dirfd stack
// becomes a PATH-PREFIX stack -- `w_path` holds the CURRENT directory's full
// path (always NUL-terminated at `w_path_len`), `w_len_stack` holds each
// ancestor's path LENGTH (descend = append `/name` + push the new length;
// ascend = pop + truncate). Same drain discipline as posix (D-rda): a single
// fuel budget (4096) bounds TOTAL operations; each step re-enumerates the
// current directory fresh, so removal never races an open enumeration.
windows_x86_64 machine Filesystem::remove_dir_all(&mut self, path: &[u8] in Path) -> UnitResult {
    self.w_path_copy(path, 0);
    transition path.len < 509 { true -> rda_init(path) _ -> rda_err(path) }
    state rda_init(&mut self, path: &[u8] in Path) -> UnitResult {
        self.w_restore_nul(0);
        self.rda_depth = 1;
        transition self.w_help_rc == 0 { true -> rda_seed(path) _ -> rda_err(path) }
    }
    state rda_seed(&mut self, path: &[u8] in Path) -> UnitResult {
        self.w_len_stack[0] = self.w_path_len;
        self.rda_rc = self.rda_drain(4096);
        transition self.rda_rc == 0 { true -> rda_rmdir(path) _ -> rda_err(path) }
    }
    // The drained ROOT is removed by the caller-visible `in Path` param,
    // exactly like the posix impl (the drain leaves the root to its caller).
    state rda_rmdir(&mut self, path: &[u8] in Path) -> UnitResult {
        let rc: i32 = self.host.remove_dir(path);
        transition rc == 0 { true -> rda_ok() _ -> rda_err(path) }
    }
    state rda_ok(&mut self) -> UnitResult { UnitResult::Ok }
    // `path` is threaded in (unused) so the shared-param domain grant
    // re-establishes `path in Path` here after the drain value-call's
    // conservative invalidation (the posix impl's exact note).
    state rda_err(&mut self, path: &[u8] in Path) -> UnitResult {
        let kind: ErrorKind = self.last_error();
        UnitResult::Error { kind: kind }
    }
}

// Drain every child of the stacked directories (files removed, subdirs
// emptied + removed), ITERATIVELY -- the posix drain's exact fuel shape (the
// entry's own single-comparison re-entry is the only recursion the decreases
// prover accepts; the loop runs its full fuel and no-ops once drained, the
// documented provable trade). Returns 0 on success, -1 on
// error/fuel-exhaustion/depth overflow (> 16).
windows_x86_64 machine Filesystem::rda_drain(&mut self, fuel: u64)
terminates by fuel;
-> i32
{
    self.rda_step(0);
    transition fuel > 0 { true -> rda_drain(fuel - 1) false -> rdd_settle() }
    state rdd_settle(&mut self) -> i32 {
        transition self.rda_verdict == 0 { true -> rdd_done() _ -> rdd_fail() }
    }
    state rdd_done(&mut self) -> i32 { 0 }
    state rdd_fail(&mut self) -> i32 { 0 - 1 }
}

// ONE drain step, the windows paradigm: enumerate the CURRENT directory
// (`w_path/*`), find its first NON-DOT entry (dots are the first two records
// in both engines -- at most two skips), then either remove a file child /
// descend into a subdir child (both by JOINED full path), or -- when only
// dots remain -- close, remove the now-empty directory (unless it is the
// root, which the caller removes), and ascend. Sets `rda_verdict`
// (1 continue / 0 done / -1 error). Every array index is guarded by a
// dominating conjunct in its own incoming transition whose shape MATCHES the
// index expression (the posix impl's prover note). The `step` param is the
// uniform call shape; unused.
windows_x86_64 machine Filesystem::rda_step(&mut self, step: u64) {
    transition self.rda_depth == 0 { true -> rds_alldone() _ -> rds_seal() }

    state rds_alldone(&mut self) { self.rda_verdict = 0; }

    // Open a fresh enumeration of the current directory. The pattern seal
    // overwrites w_path's NUL with "/*"; restore the invariant right after
    // the open (the pattern bytes are consumed by the call itself).
    state rds_seal(&mut self) {
        self.w_seal_pattern(0);
        transition self.w_help_rc == 0 { true -> rds_open() _ -> rds_fail() }
    }
    state rds_open(&mut self) {
        self.w_find_open(self.w_pat_len);
        self.w_restore_nul(0);
        transition self.w_find >= 0 { true -> rds_c1() _ -> rds_fail() }
    }

    // find_first already filled find_buf: skip up to TWO leading dot records
    // by NAME ("." = 46,0; ".." = 46,46,0 at the name offset 44).
    state rds_c1(&mut self) {
        self.rd_lo = self.find_buf[44];
        self.rd_hi = self.find_buf[45];
        self.rd_nb = self.find_buf[46];
        transition self.rd_lo == 46 { true -> rds_c1_dot() _ -> rds_entry() }
    }
    state rds_c1_dot(&mut self) {
        transition self.rd_hi == 0 { true -> rds_n1() _ -> rds_c1_dot2() }
    }
    state rds_c1_dot2(&mut self) {
        transition self.rd_hi == 46 { true -> rds_c1_dot3() _ -> rds_entry() }
    }
    state rds_c1_dot3(&mut self) {
        transition self.rd_nb == 0 { true -> rds_n1() _ -> rds_entry() }
    }
    state rds_n1(&mut self) {
        self.w_next_rc = self.host.find_next(self.w_find, &mut self.find_buf);
        transition self.w_next_rc == 1 { true -> rds_c2() _ -> rds_empty() }
    }
    state rds_c2(&mut self) {
        self.rd_lo = self.find_buf[44];
        self.rd_hi = self.find_buf[45];
        self.rd_nb = self.find_buf[46];
        transition self.rd_lo == 46 { true -> rds_c2_dot() _ -> rds_entry() }
    }
    state rds_c2_dot(&mut self) {
        transition self.rd_hi == 0 { true -> rds_n2() _ -> rds_c2_dot2() }
    }
    state rds_c2_dot2(&mut self) {
        transition self.rd_hi == 46 { true -> rds_c2_dot3() _ -> rds_entry() }
    }
    state rds_c2_dot3(&mut self) {
        transition self.rd_nb == 0 { true -> rds_n2() _ -> rds_entry() }
    }
    state rds_n2(&mut self) {
        self.w_next_rc = self.host.find_next(self.w_find, &mut self.find_buf);
        transition self.w_next_rc == 1 { true -> rds_entry() _ -> rds_empty() }
    }

    // ONLY DOTS: the current directory is drained. Close the enumeration;
    // the ROOT (depth 1) is the caller's to remove -- everything deeper is
    // removed here by its full path, then the walk ascends to the parent.
    state rds_empty(&mut self) {
        self.rda_close_rc = self.host.find_close(self.w_find);
        transition self.rda_depth == 1 { true -> rds_rootdone() _ -> rds_rmcur() }
    }
    // Zero the depth so the drain's remaining fuel iterations no-op (the
    // `depth == 0 -> alldone` head) instead of RE-OPENING a find enumeration
    // on the drained root every iteration -- that redundant re-open leaked
    // ~4096 find handles per call (single calls survived; a second dir-walk
    // in the same process hit the handle cap and its find_first returned
    // INVALID_HANDLE_VALUE). w_scan_step idles the same way after `done`.
    state rds_rootdone(&mut self) {
        self.rda_depth = 0;
        self.rda_verdict = 0;
    }
    state rds_rmcur(&mut self) {
        self.w_remove_dir_at(self.w_path_len);
        transition self.rda_rc == 0 { true -> rds_ascend() _ -> rds_fail() }
    }
    state rds_ascend(&mut self) {
        // The parent's length is stacked at depth - 2 (the guard shape
        // matches the index expression exactly; read BEFORE the decrement).
        transition self.rda_depth >= 2 && self.rda_depth - 2 < 16 {
            true -> rds_ascend_go()
            _ -> rds_fail()
        }
    }
    state rds_ascend_go(&mut self) {
        self.w_path_len = self.w_len_stack[self.rda_depth - 2];
        self.rda_depth = self.rda_depth - 1;
        transition self.w_path_len < 512 { true -> rds_ascend_nul() _ -> rds_fail() }
    }
    state rds_ascend_nul(&mut self) {
        self.w_path[self.w_path_len] = 0;
        self.rda_verdict = 1;
    }

    // A REAL entry: capture its name (NUL-truncated into entry_name) and
    // kind, close the enumeration BEFORE mutating the tree, then join the
    // child's full path and remove-or-descend.
    state rds_entry(&mut self) {
        self.w_capture_name(0);
        self.w_attr = self.find_buf[0];
        transition { _ -> rds_close() }
    }
    state rds_close(&mut self) {
        self.rda_close_rc = self.host.find_close(self.w_find);
        self.rd_lou = widen_u8_to_u64(self.w_attr) as u64 in Wrapping;
        self.rd_hiu = self.rd_lou & 16;
        transition self.rd_hiu == 16 { true -> rds_mark_dir() _ -> rds_mark_file() }
    }
    state rds_mark_dir(&mut self) {
        self.w_scan_kind = 1;
        transition { _ -> rds_join() }
    }
    state rds_mark_file(&mut self) {
        self.w_scan_kind = 2;
        transition { _ -> rds_join() }
    }

    // JOIN: w_path[w_path_len] = '/', the captured name after it, NUL at
    // w_child_len = w_path_len + 1 + w_entry_len.
    state rds_join(&mut self) {
        self.w_child_len = self.w_path_len + 1 + self.w_entry_len;
        transition self.w_child_len < 512 { true -> rds_join_slash() _ -> rds_fail() }
    }
    state rds_join_slash(&mut self) {
        transition self.w_path_len < 512 { true -> rds_join_slash_go() _ -> rds_fail() }
    }
    state rds_join_slash_go(&mut self) {
        self.w_path[self.w_path_len] = 47;
        self.rd_j = 0;
        transition { _ -> rds_jloop() }
    }
    state rds_jloop(&mut self) {
        transition self.rd_j < self.w_entry_len { true -> rds_jcap() _ -> rds_jnul() }
    }
    state rds_jcap(&mut self) {
        transition self.rd_j < 256 { true -> rds_jbyte() _ -> rds_fail() }
    }
    state rds_jbyte(&mut self) {
        self.mkall_byte = self.entry_name[self.rd_j];
        self.rd_ridx = self.w_path_len + 1 + self.rd_j;
        transition self.rd_ridx < 512 { true -> rds_jput() _ -> rds_fail() }
    }
    state rds_jput(&mut self) {
        self.w_path[self.rd_ridx] = self.mkall_byte;
        self.rd_j = self.rd_j + 1;
        transition { _ -> rds_jloop() }
    }
    state rds_jnul(&mut self) {
        transition self.w_child_len < 512 { true -> rds_jnul_go() _ -> rds_fail() }
    }
    state rds_jnul_go(&mut self) {
        self.w_path[self.w_child_len] = 0;
        transition self.w_scan_kind == 1 { true -> rds_descend() _ -> rds_unlink() }
    }

    // FILE child: remove by full joined path, then truncate back to the
    // current directory (restore the NUL at w_path_len).
    state rds_unlink(&mut self) {
        self.w_remove_file_at(self.w_child_len);
        transition self.rda_rc == 0 { true -> rds_untrunc() _ -> rds_fail() }
    }
    state rds_untrunc(&mut self) {
        transition self.w_path_len < 512 { true -> rds_untrunc_go() _ -> rds_fail() }
    }
    state rds_untrunc_go(&mut self) {
        self.w_path[self.w_path_len] = 0;
        self.rda_verdict = 1;
    }

    // DIRECTORY child: descend -- the joined path BECOMES the current path
    // (already NUL-terminated at w_child_len); push its length.
    state rds_descend(&mut self) {
        transition self.rda_depth < 16 { true -> rds_descend_go() _ -> rds_fail() }
    }
    state rds_descend_go(&mut self) {
        self.w_len_stack[self.rda_depth] = self.w_child_len;
        self.rda_depth = self.rda_depth + 1;
        self.w_path_len = self.w_child_len;
        self.rda_verdict = 1;
    }

    state rds_fail(&mut self) { self.rda_verdict = 0 - 1; }
}

// ---------------------------------------------------------------------------
// WINDOWS-INTERNAL helpers (single-target names -- paradigm internals, not
// contract machines; the filter's shared-name rule leaves them silent on
// posix targets).
// ---------------------------------------------------------------------------

// Copy the `in Path` param into w_path, byte by byte -- the mkall_walk /
// mkall_step forward-recursion shape (`terminates by` BoundedDistance). Bytes past
// index 508 are skipped (the caller's `path.len < 509` gate rejects such
// paths before any use). STATEMENT-CALLED, like every helper below: their
// effects live in guarded arm states, which the value-call fence rejects --
// the fence's own prescription is statement call + field result.
windows_x86_64 machine Filesystem::w_path_copy(&mut self, path: &[u8] in Path, i: u64)
terminates by (i, path.len) -> Nat::BoundedDistance;
{
    self.w_path_put(path, i);
    transition i < path.len {
        true -> w_path_copy(path, i + 1)
        false -> wpc_done(i)
    }
    // At termination `i == path.len`: store it as w_path_len. `i` is a u64
    // PARAMETER (a param->field write lowers), NOT the slice's `.len` (a
    // slice-length->field write has no runtime lowering) -- and there is NO
    // field RMW accumulator, which on re-invocation read a stale
    // static-folded zero and undercounted (the chained-RMW-static-fold face;
    // it silently corrupted every SECOND dir-walk in a process).
    state wpc_done(&mut self, i: u64) { self.w_path_len = i; }
}

// One byte of the path copy. Both facts (in the slice, in the buffer) ride
// ONE incoming conjunct so the reads/writes are dominated in their own
// transition (facts do not travel across hops).
windows_x86_64 machine Filesystem::w_path_put(&mut self, path: &[u8] in Path, i: u64) {
    transition i < path.len && i < 509 {
        true -> wpp_go(path, i)
        _ -> wpp_skip()
    }
    state wpp_go(&mut self, path: &[u8] in Path, i: u64) {
        self.mkall_byte = path[i];
        self.w_path[i] = self.mkall_byte;
    }
    state wpp_skip(&mut self) { self.copy_rc = 0; }
}

// Overwrite w_path's terminator with the find pattern tail: '/' at
// w_path_len, '*' after it, NUL after that; w_pat_len = w_path_len + 2.
// w_help_rc = 0, or -1 when the path leaves no room (>= 509).
windows_x86_64 machine Filesystem::w_seal_pattern(&mut self, step: u64) {
    transition self.w_path_len < 509 { true -> wsp_slash() _ -> wsp_bad() }
    state wsp_slash(&mut self) {
        transition self.w_path_len < 512 { true -> wsp_slash_go() _ -> wsp_bad() }
    }
    state wsp_slash_go(&mut self) {
        self.w_path[self.w_path_len] = 47;
        self.rd_ridx = self.w_path_len + 1;
        transition self.rd_ridx < 512 { true -> wsp_star_go() _ -> wsp_bad() }
    }
    state wsp_star_go(&mut self) {
        self.w_path[self.rd_ridx] = 42;
        self.rd_ridx = self.w_path_len + 2;
        transition self.rd_ridx < 512 { true -> wsp_nul_go() _ -> wsp_bad() }
    }
    state wsp_nul_go(&mut self) {
        self.w_path[self.rd_ridx] = 0;
        self.w_pat_len = self.w_path_len + 2;
        self.w_help_rc = 0;
    }
    state wsp_bad(&mut self) { self.w_help_rc = 0 - 1; }
}

// Restore the NUL terminator at w_path_len (after a pattern seal or a
// child-path truncation). w_help_rc = 0, or -1 out of bounds.
windows_x86_64 machine Filesystem::w_restore_nul(&mut self, step: u64) {
    transition self.w_path_len < 512 { true -> wrn_go() _ -> wrn_bad() }
    state wrn_go(&mut self) {
        self.w_path[self.w_path_len] = 0;
        self.w_help_rc = 0;
    }
    state wrn_bad(&mut self) { self.w_help_rc = 0 - 1; }
}

// The guarded find_first on w_path[0..k] -- the host call lives in a guarded
// chain of THIS machine's states, so the subslice is provably in bounds; the
// base pointer is a valid C string because the seal NUL-terminated the
// pattern. Result rides `w_find` (-1 on out-of-bounds, matching
// INVALID_HANDLE_VALUE).
windows_x86_64 machine Filesystem::w_find_open(&mut self, k: u64 in Wrapping) {
    transition k < 512 { true -> wfo_go(k) _ -> wfo_bad() }
    state wfo_go(&mut self, k: u64 in Wrapping) {
        self.w_find = self.host.find_first(self.w_path[0..k], &mut self.find_buf);
    }
    state wfo_bad(&mut self) { self.w_find = 0 - 1; }
}

// Guarded remove of the FILE at w_path[0..k] (the joined child path;
// NUL-terminated at k). Result rides `rda_rc`.
windows_x86_64 machine Filesystem::w_remove_file_at(&mut self, k: u64 in Wrapping) {
    transition k < 512 { true -> wrf_go(k) _ -> wrf_bad() }
    state wrf_go(&mut self, k: u64 in Wrapping) {
        self.rda_rc = self.host.remove_name(self.w_path[0..k]);
    }
    state wrf_bad(&mut self) { self.rda_rc = 0 - 1; }
}

// Guarded remove of the empty DIRECTORY at w_path[0..k]. Result rides
// `rda_rc`.
windows_x86_64 machine Filesystem::w_remove_dir_at(&mut self, k: u64 in Wrapping) {
    transition k < 512 { true -> wrd_go(k) _ -> wrd_bad() }
    state wrd_go(&mut self, k: u64 in Wrapping) {
        self.rda_rc = self.host.remove_dir_name(self.w_path[0..k]);
    }
    state wrd_bad(&mut self) { self.rda_rc = 0 - 1; }
}

// Copy the current find record's name (NUL-terminated at find_buf[44..])
// into entry_name, NUL-truncating at 255 bytes; seals entry_name with its
// own NUL and records w_entry_len. The rdef_copy/rdef_nul state-cycle shape.
windows_x86_64 machine Filesystem::w_capture_name(&mut self, step: u64) {
    self.rd_j = 0;
    transition { _ -> wcn_loop() }
    state wcn_loop(&mut self) {
        self.rd_ridx = 44 + self.rd_j;
        transition self.rd_ridx < 320 { true -> wcn_read() _ -> wcn_seal() }
    }
    state wcn_read(&mut self) {
        self.rd_nb = self.find_buf[self.rd_ridx];
        transition self.rd_nb == 0 { true -> wcn_seal() _ -> wcn_put() }
    }
    state wcn_put(&mut self) {
        transition self.rd_j < 255 { true -> wcn_put_go() _ -> wcn_seal() }
    }
    state wcn_put_go(&mut self) {
        self.entry_name[self.rd_j] = self.rd_nb;
        self.rd_j = self.rd_j + 1;
        transition { _ -> wcn_loop() }
    }
    state wcn_seal(&mut self) {
        transition self.rd_j < 256 { true -> wcn_seal_go() _ -> wcn_done() }
    }
    state wcn_seal_go(&mut self) {
        self.entry_name[self.rd_j] = 0;
        self.w_entry_len = self.rd_j;
        transition { _ -> wcn_done() }
    }
    state wcn_done(&mut self) { self.copy_rc = 0; }
}

// The fueled scan loop -- rda_drain's exact shape over w_scan_step (full
// fuel, no-op once done; verdict protocol). Returns 0 clean / -1 error.
windows_x86_64 machine Filesystem::w_scan_drain(&mut self, fuel: u64)
terminates by fuel;
-> i32
{
    self.w_scan_step(0);
    transition fuel > 0 { true -> w_scan_drain(fuel - 1) false -> wsd_settle() }
    state wsd_settle(&mut self) -> i32 {
        transition self.w_scan_verdict == 0 { true -> wsd_done() _ -> wsd_fail() }
    }
    state wsd_done(&mut self) -> i32 { 0 }
    state wsd_fail(&mut self) -> i32 { 0 - 1 }
}

// ONE scan step: consume the pending find_first record or pull the next one;
// skip dots by NAME; tally non-dot records (dirs by the attribute bit 0x10);
// capture the target-indexed record's name + kind. Sets `w_scan_verdict`
// (1 continue / 0 done). The `step` param is the uniform call shape; unused.
windows_x86_64 machine Filesystem::w_scan_step(&mut self, step: u64) {
    transition self.w_scan_done == 1 { true -> ws_idle() _ -> ws_fetch() }
    state ws_idle(&mut self) { self.w_scan_verdict = 0; }

    state ws_fetch(&mut self) {
        transition self.w_scan_pending == 1 { true -> ws_first() _ -> ws_next() }
    }
    state ws_first(&mut self) {
        self.w_scan_pending = 0;
        transition { _ -> ws_classify() }
    }
    state ws_next(&mut self) {
        self.w_next_rc = self.host.find_next(self.w_find, &mut self.find_buf);
        transition self.w_next_rc == 1 { true -> ws_classify() _ -> ws_end() }
    }
    state ws_end(&mut self) {
        self.w_scan_done = 1;
        self.w_scan_verdict = 0;
    }

    state ws_classify(&mut self) {
        self.rd_lo = self.find_buf[44];
        self.rd_hi = self.find_buf[45];
        self.rd_nb = self.find_buf[46];
        transition self.rd_lo == 46 { true -> ws_dot1() _ -> ws_real() }
    }
    state ws_dot1(&mut self) {
        transition self.rd_hi == 0 { true -> ws_skip() _ -> ws_dot2() }
    }
    state ws_dot2(&mut self) {
        transition self.rd_hi == 46 { true -> ws_dot3() _ -> ws_real() }
    }
    state ws_dot3(&mut self) {
        transition self.rd_nb == 0 { true -> ws_skip() _ -> ws_real() }
    }
    state ws_skip(&mut self) { self.w_scan_verdict = 1; }

    state ws_real(&mut self) {
        self.w_scan_count = self.w_scan_count + 1;
        self.w_attr = self.find_buf[0];
        self.rd_lou = widen_u8_to_u64(self.w_attr) as u64 in Wrapping;
        self.rd_hiu = self.rd_lou & 16;
        transition self.rd_hiu == 16 { true -> ws_dir() _ -> ws_file() }
    }
    state ws_dir(&mut self) {
        self.w_scan_dirs = self.w_scan_dirs + 1;
        self.w_scan_kind = 1;
        transition self.w_scan_count - 1 == self.w_scan_target { true -> ws_hit() _ -> ws_cont() }
    }
    state ws_file(&mut self) {
        self.w_scan_files = self.w_scan_files + 1;
        self.w_scan_kind = 2;
        transition self.w_scan_count - 1 == self.w_scan_target { true -> ws_hit() _ -> ws_cont() }
    }
    state ws_hit(&mut self) {
        self.w_capture_name(0);
        self.w_scan_hit = 1;
        // Latch the kind with the name: the drain keeps classifying the
        // remaining records, so w_scan_kind moves on after this hit.
        self.w_hit_kind = self.w_scan_kind;
        transition { _ -> ws_cont() }
    }
    state ws_cont(&mut self) { self.w_scan_verdict = 1; }
}

// POSITIONED IO (the portable positioned-io contract, windows session
// slice 2): msvcrt fds have NO pread/pwrite, so windows COMPOSES
// save-cursor / seek(SET) / op / restore-cursor over the wired
// _lseeki64/_read/_write rows. All four host calls run in the ENTRY body
// (the value-call fence: side-effecting ARM states re-emit per arm), each
// let-bound, with ONE verdict conjunction at the end -- the restore runs
// UNCONDITIONALLY, so a failed op never leaves the cursor moved; on a bad
// fd every leg fails and errno reads the last EBADF, same class the posix
// raw op reports. A failed positioning leg routes Error even when the
// misplaced op "succeeded", so the caller never trusts the buffer.
// HONEST CAVEAT (recorded in the contract block): unlike posix pread, the
// composition is not atomic against concurrent access to the same fd --
// single-threaded programs (all of Omega today) never observe the
// difference.
windows_x86_64 machine Filesystem::read_at(&mut self, file: File, buffer: &mut [u8], count: u64, offset: i64) -> IoResult {
    self.file_fd = file.fd;
    // SEEK_CUR (1) at 0 = report the cursor; SEEK_SET (0) = position.
    let saved: i64 = self.host.seek(self.file_fd, 0, 1);
    let moved: i64 = self.host.seek(self.file_fd, offset, 0);
    let n: i64 = self.host.read(self.file_fd, buffer, count);
    let back: i64 = self.host.seek(self.file_fd, saved, 0);
    // Verdict legs are PURE chained states (value-call arm bodies re-emit,
    // so only the entry may effect); each check threads the rest through
    // state params.
    transition saved >= 0 { true -> ra_moved(moved, n, back) _ -> err() }
    state ra_moved(&mut self, moved: i64, n: i64, back: i64) -> IoResult {
        transition moved >= 0 { true -> ra_n(n, back) _ -> err() }
    }
    state ra_n(&mut self, n: i64, back: i64) -> IoResult {
        transition n >= 0 { true -> ra_back(n, back) _ -> err() }
    }
    state ra_back(&mut self, n: i64, back: i64) -> IoResult {
        transition back >= 0 { true -> ok(n) _ -> err() }
    }
    state ok(&mut self, n: i64) -> IoResult {
        let converted_count: u64 = narrow_i64_to_u64_exact(n);
        IoResult::Ok { count: converted_count }
    }
    state err(&mut self) -> IoResult { let kind: ErrorKind = self.last_error(); IoResult::Error { kind: kind } }
}

// CANONICALIZE (the portable canonicalize contract, windows session slice
// 4a/4d): msvcrt has no realpath, so windows opens a kernel HANDLE directly
// with CreateFileA (access 0, share read/write/delete, OPEN_EXISTING,
// FILE_FLAG_BACKUP_SEMANTICS), then resolves it to its final DOS path
// (GetFinalPathNameByHandleA, flags 0 =
// VOLUME_NAME_DOS, the \\?\-prefixed spelling Rust's windows canonicalize
// returns), and closes it with CloseHandle. All host calls live in the ENTRY
// (the value-call fence), followed by chained pure verdicts; capacity is the
// contract's 1024 floor
// (the posix realpath writes up to PATH_MAX=1024 with no cap arg at all).
// A too-small buffer returns the REQUIRED size (>= 1024 fails the fit
// check). Both failure legs capture and classify GetLastError before close.
// FILE_FLAG_BACKUP_SEMANTICS makes files and directories equally valid inputs.
windows_x86_64 machine Filesystem::canonicalize(&mut self, path: &[u8] in Path, buffer: &mut [u8]) -> UnitResult {
    let handle: i64 = self.host.open_path_handle(path, 0, 7, 0, 3, 33554432, 0);
    // Capture the OPEN leg's GetLastError IMMEDIATELY: any trailing Win32
    // call may overwrite the thread-local value.
    let open_error: i32 = self.host.get_last_error();
    let len: i64 = self.host.final_path_name_by_handle(handle, buffer, 1024, 0);
    let resolve_error: i32 = self.host.get_last_error();
    let closed: i32 = self.host.close_handle(handle);
    // Map both captured Win32 values in the ENTRY (the value-call fence bans
    // arm-state mutations, and field-store-then-match is the required desugar
    // idiom) -- harmless on the success path.
    self.err_kind = match open_error {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    self.win32_error_kind = match resolve_error {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition handle >= 0 { true -> wc_len(len) _ -> err_open() }
    state wc_len(&mut self, len: i64) -> UnitResult {
        transition len > 0 { true -> wc_fit(len) _ -> err_resolve() }
    }
    state wc_fit(&mut self, len: i64) -> UnitResult {
        transition len < 1024 { true -> ok() _ -> err_resolve() }
    }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err_open(&mut self) -> UnitResult {
        // The entry-mapped kind from the open leg's captured GetLastError.
        UnitResult::Error { kind: self.err_kind }
    }
    state err_resolve(&mut self) -> UnitResult {
        UnitResult::Error { kind: self.win32_error_kind }
    }
}

// HARD LINK (the portable hard-link contract, windows session slice 3):
// kernel32 CreateHardLinkA via the designed create_hard_link seam op --
// the Win32 arg order is (NEW link, existing), REVERSED from the portable
// (original, link), with the security-attributes arg the API requires as
// NULL (0). BOOL result: non-zero success. GetLastError is captured before
// branching, so common failure kinds remain portable.
windows_x86_64 machine Filesystem::hard_link(&mut self, original: &[u8] in Path, link: &[u8] in Path) -> UnitResult {
    let rc: i32 = self.host.create_hard_link(link, original, 0);
    let code: i32 = self.host.get_last_error();
    self.win32_error_kind = match code {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { UnitResult::Error { kind: self.win32_error_kind } }
}

// FILE TIMES (windows session slice 4b wrapper): convert Unix whole seconds
// to the Win32 FILETIME epoch/tick representation, then stamp the open CRT
// descriptor through its OS-handle bridge. The two 8-byte FILETIMEs use
// independent scratch arrays because host-call pointers must be simple places.
// Arithmetic is explicitly wrapping because the public carrier is the full
// i64 Unix-seconds domain;
// SetFileTime remains the authority on whether a resulting timestamp is valid.
windows_x86_64 machine Filesystem::set_times(&mut self, file: File, accessed: i64, modified: i64) -> UnitResult {
    let accessed_epoch: u64 in Wrapping =
        (narrow_i64_to_u64_wrapping(accessed) as u64 in Wrapping) + 11644473600;
    let accessed_ticks: u64 in Wrapping = accessed_epoch * 10000000;
    let modified_epoch: u64 in Wrapping =
        (narrow_i64_to_u64_wrapping(modified) as u64 in Wrapping) + 11644473600;
    let modified_ticks: u64 in Wrapping = modified_epoch * 10000000;
    let accessed_bits: u64 = accessed_ticks as u64;
    let modified_bits: u64 = modified_ticks as u64;
    self.access_filetime[0] = narrow_u64_to_u8_wrapping(accessed_bits);
    self.access_filetime[1] = narrow_u64_to_u8_wrapping(accessed_bits >> 8);
    self.access_filetime[2] = narrow_u64_to_u8_wrapping(accessed_bits >> 16);
    self.access_filetime[3] = narrow_u64_to_u8_wrapping(accessed_bits >> 24);
    self.access_filetime[4] = narrow_u64_to_u8_wrapping(accessed_bits >> 32);
    self.access_filetime[5] = narrow_u64_to_u8_wrapping(accessed_bits >> 40);
    self.access_filetime[6] = narrow_u64_to_u8_wrapping(accessed_bits >> 48);
    self.access_filetime[7] = narrow_u64_to_u8_wrapping(accessed_bits >> 56);
    self.modified_filetime[0] = narrow_u64_to_u8_wrapping(modified_bits);
    self.modified_filetime[1] = narrow_u64_to_u8_wrapping(modified_bits >> 8);
    self.modified_filetime[2] = narrow_u64_to_u8_wrapping(modified_bits >> 16);
    self.modified_filetime[3] = narrow_u64_to_u8_wrapping(modified_bits >> 24);
    self.modified_filetime[4] = narrow_u64_to_u8_wrapping(modified_bits >> 32);
    self.modified_filetime[5] = narrow_u64_to_u8_wrapping(modified_bits >> 40);
    self.modified_filetime[6] = narrow_u64_to_u8_wrapping(modified_bits >> 48);
    self.modified_filetime[7] = narrow_u64_to_u8_wrapping(modified_bits >> 56);
    self.file_fd = file.fd;
    let handle: i64 = self.host.get_osfhandle(self.file_fd);
    let rc: i32 = self.host.set_file_time(handle, 0, &self.access_filetime, &self.modified_filetime);
    let code: i32 = self.host.get_last_error();
    self.win32_error_kind = match code {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult {
        UnitResult::Error { kind: self.win32_error_kind }
    }
}

windows_x86_64 machine Filesystem::write_at(&mut self, file: File, bytes: &[u8], offset: i64) -> IoResult {
    self.file_fd = file.fd;
    let saved: i64 = self.host.seek(self.file_fd, 0, 1);
    let moved: i64 = self.host.seek(self.file_fd, offset, 0);
    let n: i64 = self.host.write(self.file_fd, bytes);
    let back: i64 = self.host.seek(self.file_fd, saved, 0);
    transition saved >= 0 { true -> wa_moved(moved, n, back) _ -> err() }
    state wa_moved(&mut self, moved: i64, n: i64, back: i64) -> IoResult {
        transition moved >= 0 { true -> wa_n(n, back) _ -> err() }
    }
    state wa_n(&mut self, n: i64, back: i64) -> IoResult {
        transition n >= 0 { true -> wa_back(n, back) _ -> err() }
    }
    state wa_back(&mut self, n: i64, back: i64) -> IoResult {
        transition back >= 0 { true -> ok(n) _ -> err() }
    }
    state ok(&mut self, n: i64) -> IoResult {
        let converted_count: u64 = narrow_i64_to_u64_exact(n);
        IoResult::Ok { count: converted_count }
    }
    state err(&mut self) -> IoResult { let kind: ErrorKind = self.last_error(); IoResult::Error { kind: kind } }
}

// Whole-file advisory locks over the CRT-fd -> HANDLE bridge. LockFileEx sees
// offset 0 in the zeroed OVERLAPPED and length 2^64-1. `_open` creates
// synchronous handles, so blocking acquisitions complete before the call
// returns; providers with overlapped handles owe their own wait composition.
windows_x86_64 machine Filesystem::lock(&mut self, file: File) -> UnitResult {
    self.file_fd = file.fd;
    let handle: i64 = self.host.get_osfhandle(self.file_fd);
    let rc: i32 = self.host.lock_file_ex(handle, 2, 0, 4294967295, 4294967295, &mut self.lock_overlapped);
    let code: i32 = self.host.get_last_error();
    self.win32_error_kind = match code {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { UnitResult::Error { kind: self.win32_error_kind } }
}

windows_x86_64 machine Filesystem::lock_shared(&mut self, file: File) -> UnitResult {
    self.file_fd = file.fd;
    let handle: i64 = self.host.get_osfhandle(self.file_fd);
    let rc: i32 = self.host.lock_file_ex(handle, 0, 0, 4294967295, 4294967295, &mut self.lock_overlapped);
    let code: i32 = self.host.get_last_error();
    self.win32_error_kind = match code {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> ok() _ -> err() }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { UnitResult::Error { kind: self.win32_error_kind } }
}

windows_x86_64 machine Filesystem::try_lock(&mut self, file: File) -> TryLockResult {
    self.file_fd = file.fd;
    let handle: i64 = self.host.get_osfhandle(self.file_fd);
    let rc: i32 = self.host.lock_file_ex(handle, 3, 0, 4294967295, 4294967295, &mut self.lock_overlapped);
    self.lock_errno = self.host.get_last_error();
    self.win32_error_kind = match self.lock_errno {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> acquired() _ -> contended() }
    state acquired(&mut self) -> TryLockResult { TryLockResult::Acquired }
    state contended(&mut self) -> TryLockResult { transition self.lock_errno == 33 { true -> would_block() _ -> failed() } }
    state would_block(&mut self) -> TryLockResult { TryLockResult::WouldBlock }
    state failed(&mut self) -> TryLockResult { TryLockResult::Error { kind: self.win32_error_kind } }
}

windows_x86_64 machine Filesystem::try_lock_shared(&mut self, file: File) -> TryLockResult {
    self.file_fd = file.fd;
    let handle: i64 = self.host.get_osfhandle(self.file_fd);
    let rc: i32 = self.host.lock_file_ex(handle, 1, 0, 4294967295, 4294967295, &mut self.lock_overlapped);
    self.lock_errno = self.host.get_last_error();
    self.win32_error_kind = match self.lock_errno {
        2 -> ErrorKind::NotFound,
        3 -> ErrorKind::NotFound,
        5 -> ErrorKind::PermissionDenied,
        6 -> ErrorKind::BadDescriptor,
        32 -> ErrorKind::WouldBlock,
        33 -> ErrorKind::WouldBlock,
        80 -> ErrorKind::AlreadyExists,
        183 -> ErrorKind::AlreadyExists,
        _ -> ErrorKind::Other
    };
    transition rc != 0 { true -> acquired() _ -> contended() }
    state acquired(&mut self) -> TryLockResult { TryLockResult::Acquired }
    state contended(&mut self) -> TryLockResult { transition self.lock_errno == 33 { true -> would_block() _ -> failed() } }
    state would_block(&mut self) -> TryLockResult { TryLockResult::WouldBlock }
    state failed(&mut self) -> TryLockResult { TryLockResult::Error { kind: self.win32_error_kind } }
}

windows_x86_64 machine Filesystem::unlock(&mut self, file: File) -> UnitResult {
    self.file_fd = file.fd;
    let handle: i64 = self.host.get_osfhandle(self.file_fd);
    let first: i32 = self.host.unlock_file(handle, 0, 0, 4294967295, 4294967295);
    let second: i32 = self.host.unlock_file(handle, 0, 0, 4294967295, 4294967295);
    self.lock_errno = self.host.get_last_error();
    transition first != 0 { true -> second_result(second) _ -> err() }
    state second_result(&mut self, second: i32) -> UnitResult {
        transition second != 0 { true -> ok() _ -> second_failed() }
    }
    state second_failed(&mut self) -> UnitResult {
        transition self.lock_errno == 158 { true -> ok() _ -> err() }
    }
    state ok(&mut self) -> UnitResult { UnitResult::Ok }
    state err(&mut self) -> UnitResult { let kind: ErrorKind = ErrorKind::Other; UnitResult::Error { kind: kind } }
}
