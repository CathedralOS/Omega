// Decode the actual SubstituteName, never the optional display PrintName.
// Native offsets/lengths are bytes relative to the kind-specific PathBuffer;
// returned bytes and ReparseDataLength both bound every observed target unit.
// Relative links retain their spelling. Absolute NT \??\ paths become the
// equivalent Win32 \\?\ spelling; unsupported namespaces never become a
// plausible but unrelated path. Embedded NUL and malformed records refuse.
// https://learn.microsoft.com/windows-hardware/drivers/ddi/ntifs/ns-ntifs-_reparse_data_buffer
// https://learn.microsoft.com/openspecs/windows_protocols/ms-fscc/b41f1cbf-10df-4a47-98d4-1c52a833d913
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::windows_filesystem_reparse_native;

machine windows_reparse_target(data: &WindowsNativeReparseData, returned: u32, output: &mut [u16; 8192]) -> i64 {
    let extent: u64 = widen_u16_to_u64(data.data_length);
    transition returned >= 8 && returned <= 16384 && extent + 8 <= widen_u32_to_u64(returned) {
        true -> kind(data, extent, output)
        false -> (-31)
    }
    machine kind(data: &WindowsNativeReparseData, extent: u64, output: &mut [u16; 8192]) -> i64 {
        transition data.tag {
            2684354572 -> symbolic(data, extent, output)
            2684354563 -> mount(data, extent, output)
            _ -> (-50)
        }
    }
    machine mount(data: &WindowsNativeReparseData, extent: u64, output: &mut [u16; 8192]) -> i64 {
        transition extent >= 8 { true -> span(data, extent, 8, 0, false, output) false -> (-31) }
    }
    machine symbolic(data: &WindowsNativeReparseData, extent: u64, output: &mut [u16; 8192]) -> i64 {
        transition extent >= 12 {
            true -> flags(data, extent, output)
            false -> (-31)
        }
    }
    machine flags(data: &WindowsNativeReparseData, extent: u64, output: &mut [u16; 8192]) -> i64 {
        let flags: u32 = widen_u16_to_u32(data.rest[0]) | (widen_u16_to_u32(data.rest[1]) << 16);
        transition flags <= 1 {
            true -> span(data, extent, 12, 2, flags == 1, output)
            false -> (-50)
        }
    }
    machine span(data: &WindowsNativeReparseData, extent: u64, header: u64, base: u64, relative: bool, output: &mut [u16; 8192]) -> i64
    requires base <= 2 {
        let offset: u64 = widen_u16_to_u64(data.substitute_offset);
        let length: u64 = widen_u16_to_u64(data.substitute_length);
        transition extent >= header && header <= 12 && offset % 2 == 0
            && length > 0 && length % 2 == 0 && offset + length <= extent - header {
            true -> units(data, base, offset, length, relative, output)
            false -> (-31)
        }
    }
    machine units(data: &WindowsNativeReparseData, base: u64, offset: u64, length: u64, relative: bool, output: &mut [u16; 8192]) -> i64
    requires base <= 2 && offset <= 65535 && length <= 65535 {
        let start: u64 = base + offset / 2;
        let count: u64 = length / 2;
        transition start <= 8184 && count > 0 && count < 8192 && count <= 8184 - start {
            true -> (windows_reparse_copy_target(data, output, start, count, relative))
            false -> (-31)
        }
    }
}

machine windows_reparse_copy_target(data: &WindowsNativeReparseData, output: &mut [u16; 8192], start: u64, count: u64, relative: bool) -> i64
requires start <= 8184 && count > 0 && count < 8192 && count <= 8184 - start {
    transition { _ -> copy(data, output, start, count, relative, 0) }
    machine copy(data: &WindowsNativeReparseData, output: &mut [u16; 8192], start: u64, count: u64, relative: bool, position: u64) -> i64
    requires start <= 8184 && count > 0 && count < 8192 && count <= 8184 - start {
        transition position < count {
            true -> character(data, output, start, count, relative, position)
            false -> complete(output, count, relative)
        }
    }
    machine character(data: &WindowsNativeReparseData, output: &mut [u16; 8192], start: u64, count: u64, relative: bool, position: u64) -> i64
    requires start <= 8184 && count > 0 && count < 8192 && count <= 8184 - start && position < count {
        let character: u16 = data.rest[start + position];
        transition character != 0 {
            true -> store(data, output, start, count, relative, position, character)
            false -> (-31)
        }
    }
    machine store(data: &WindowsNativeReparseData, output: &mut [u16; 8192], start: u64, count: u64, relative: bool, position: u64, character: u16) -> i64
    requires start <= 8184 && count > 0 && count < 8192 && count <= 8184 - start && position < count {
        output[position] = character;
        transition { _ -> copy(data, output, start, count, relative, position + 1) }
    }
    machine complete(output: &mut [u16; 8192], count: u64, relative: bool) -> i64
    requires count > 0 && count < 8192 {
        output[count] = 0;
        transition relative { true -> (narrow_u64_to_i64_exact(count)) false -> absolute(output, count) }
    }
    machine absolute(output: &mut [u16; 8192], count: u64) -> i64
    requires count > 0 && count < 8192 {
        transition count > 4 && output[0] == 92 && output[1] == 63 && output[2] == 63 && output[3] == 92 {
            true -> translate(output, count)
            false -> (-50)
        }
    }
    machine translate(output: &mut [u16; 8192], count: u64) -> i64
    requires count > 0 && count < 8192 {
        output[1] = 92;
        narrow_u64_to_i64_exact(count)
    }
}
