// Pin the exact object for every handle operation. Length changes use the
// native end-of-file information class and never seek the shared cursor.
// Attribute updates resolve a path once, retain unrelated observed attributes,
// and leave all timestamps unchanged; this is not atomic against another
// writer changing those same attributes. Capture failure before releasing.
use filesystem_host;
use windows_filesystem_host;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::windows_filesystem_impl;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_paths;
use targets::windows_x86_64::windows_filesystem_metadata;
use targets::windows_x86_64::windows_filesystem_metadata_native;
use targets::windows_x86_64::windows_filesystem_file_control_native;

machine windows_file_control_completion(status: i32, released: i32) -> i32 {
    transition status != 0 { true -> (status) false -> (released) }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::set_file_length(handle: u64, length: i64) -> i32
satisfies WindowsFilesystemHost::set_file_length
reaches FilesystemContentWrite + FilesystemMetadataMutation {
    transition length >= 0 {
        true -> pin(handle, length)
        false -> (-87)
    }
    state pin(handle: u64, length: i64) -> i32 {
        let duplicate: u64 = WindowsFilesystemNativeProvider::duplicate_handle(handle);
        transition duplicate != 0 { true -> update(duplicate, length) false -> failed() }
    }
    state failed() -> i32 { WindowsFilesystemNativeProvider::failure_i32() }
    state update(duplicate: u64, length: i64) -> i32 {
        let input: WindowsNativeFileEndOfFileInfo = WindowsNativeFileEndOfFileInfo { length: length };
        let raw: i64 = narrow_u64_to_i64_wrapping(duplicate);
        let succeeded: i32 = block WindowsFilesystemFileControlIo::end_of_file(raw, 6, &input, 8);
        let status: i32 = WindowsFilesystemNativeProvider::completion_status(succeeded);
        let released: i32 = block WindowsFilesystemNativeProvider::close_handle(duplicate);
        windows_file_control_completion(status, released)
    }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::set_handle_readonly(handle: u64, readonly: bool) -> i32
satisfies WindowsFilesystemHost::set_handle_readonly
reaches FilesystemMetadataQuery + FilesystemMetadataMutation {
    let duplicate: u64 = WindowsFilesystemNativeProvider::duplicate_handle(handle);
    transition duplicate != 0 { true -> update(duplicate, readonly) false -> failed() }
    state failed() -> i32 { WindowsFilesystemNativeProvider::failure_i32() }
    state update(duplicate: u64, readonly: bool) -> i32 {
        block windows_set_readonly_owned(duplicate, readonly)
    }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::set_path_readonly(path: &[u8] in Path, readonly: bool) -> i32
satisfies WindowsFilesystemHost::set_path_readonly
reaches FilesystemMetadataQuery + FilesystemMetadataMutation {
    let mut wide: [u16; 4096];
    let count: i64 = windows_wide_path(path, &mut wide);
    wide[4095] = 0;
    transition count > 0 { true -> acquire(wide, readonly) false -> (-87) }
    state acquire(wide: [u16; 4096] in WindowsNativePath, readonly: bool) -> i32 {
        let raw: i64 = block WindowsFilesystemFileControlIo::open_attributes(&wide, 384, 7, 0, 3, 34603008, 0);
        let handle: u64 = WindowsFilesystemNativeProvider::normalize_handle(raw);
        transition handle != 0 { true -> update(handle, readonly) false -> failed() }
    }
    state failed() -> i32 { WindowsFilesystemNativeProvider::failure_i32() }
    state update(handle: u64, readonly: bool) -> i32 { block windows_set_readonly_owned(handle, readonly) }
}

windows_x86_64 machine windows_set_readonly_owned(handle: u64, readonly: bool) -> i32
reaches FilesystemMetadataQuery + FilesystemMetadataMutation {
    let status: i32 = block windows_update_readonly(handle, readonly);
    let released: i32 = block WindowsFilesystemNativeProvider::close_handle(handle);
    windows_file_control_completion(status, released)
}

windows_x86_64 machine windows_update_readonly(handle: u64, readonly: bool) -> i32
reaches FilesystemMetadataQuery + FilesystemMetadataMutation {
    let classified: i64 in WindowsDiskFileOrAbsent = block windows_classify_metadata_disk_file(handle);
    transition classified != 0 { true -> query(classified, readonly) false -> failed() }
    state failed() -> i32 { WindowsFilesystemNativeProvider::failure_i32() }
    state query(handle: i64 in WindowsDiskFileOrAbsent, readonly: bool) -> i32 requires handle != 0 {
        let mut current: WindowsNativeFileBasicInfo;
        let succeeded: i32 = block WindowsFilesystemMetadataIo::basic(handle, 0, &mut current, 40);
        // The classifier authorizes the typed query. The setter accepts the
        // ordinary HANDLE contract and reports incompatible objects as errors.
        transition succeeded != 0 { true -> select(handle as i64, current.attributes, readonly) false -> failed() }
    }
    state select(handle: i64, attributes: u32, readonly: bool) -> i32 {
        transition readonly {
            true -> update(handle, (attributes & 4294967167) | 1)
            false -> writable(handle, attributes & 4294967294)
        }
    }
    state writable(handle: i64, attributes: u32) -> i32 {
        transition attributes == 0 { true -> update(handle, 128) false -> update(handle, attributes) }
    }
    state update(handle: i64, attributes: u32) -> i32 {
        let input: WindowsNativeFileBasicInfo = WindowsNativeFileBasicInfo {
            creation_ticks: 0, access_ticks: 0, write_ticks: 0, change_ticks: 0,
            attributes: attributes, padding: 0
        };
        let succeeded: i32 = block WindowsFilesystemFileControlIo::basic(handle, 0, &input, 40);
        WindowsFilesystemNativeProvider::completion_status(succeeded)
    }
}
