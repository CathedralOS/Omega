// ReadFile/WriteFile split one borrowed view into pointer and DWORD count.
// Place all sixteen descriptor bytes: pointer in RDX, length in R8. The
// requirement proves length <= DWORD_MAX, so the callee's right-justified
// low DWORD equals the complete semantic extent, without a truncating ABI.
// Handle, count-output pointer and null OVERLAPPED retain their ordered slots.
// This plan supplies representation, never storage authority or completion.
use calling;

public WindowsFilesystemTransferCalling satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        let accepted: bool = windows_filesystem_transfer_signature(&signature);
        transition accepted {
            true -> BoundaryPlanResult::Accepted { plan: windows_filesystem_transfer_entry() }
            _ -> BoundaryPlanResult::Rejected { reason: CallingPolicyRejection {
                reason: "expected handle, whole byte view, count reference and overlapped"
            } }
        }
    }
}

machine windows_filesystem_transfer_signature(signature: &BoundarySignature) -> bool {
    transition signature.parameter_count == 4 && signature.native_parameter_count == 4
        && signature.has_result && signature.callback_binder_count == 0
        && signature.callback_demand_count == 0 {
        true -> indices(signature)
        _ -> false
    }
    machine indices(signature: &BoundarySignature) -> bool {
        transition signature.parameters[0] < 256 && signature.parameters[0] < signature.shape_count
            && signature.parameters[1] < 256 && signature.parameters[1] < signature.shape_count
            && signature.parameters[2] < 256 && signature.parameters[2] < signature.shape_count
            && signature.parameters[3] < 256 && signature.parameters[3] < signature.shape_count
            && signature.result < 256 && signature.result < signature.shape_count {
            true -> shapes(&signature.shapes[signature.parameters[0]],
                &signature.shapes[signature.parameters[1]],
                &signature.shapes[signature.parameters[2]],
                &signature.shapes[signature.parameters[3]],
                &signature.shapes[signature.result])
            _ -> false
        }
    }
    machine shapes(handle: &ValueShape, bytes: &ValueShape, transferred: &ValueShape,
        overlapped: &ValueShape, result: &ValueShape) -> bool {
        transition windows_transfer_integer_shape(handle, 8)
            && windows_transfer_reference_shape(bytes, 16)
            && windows_transfer_reference_shape(transferred, 8)
            && windows_transfer_integer_shape(overlapped, 8)
            && windows_transfer_integer_shape(result, 4) {
            true -> true
            _ -> false
        }
    }
}

machine windows_filesystem_transfer_entry() -> BoundaryEntryPlan {
        let mut plan: BoundaryEntryPlan;
        plan.call.convention = CallingConvention::MicrosoftX64;
        plan.call.parameter_count = 4;
        plan.call.parameters[0] = windows_transfer_register(8, MachineRegister::X86Rcx);
        plan.call.parameters[1].shape = AbiValueShape {
            class: AbiValueClass::Integer, byte_size: 16, alignment: 8
        };
        plan.call.parameters[1].location_count = 2;
        plan.call.parameters[1].locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rdx, value_byte_offset: 0, byte_size: 8
        };
        plan.call.parameters[1].locations[1] = ValueLocation::Register {
            register: MachineRegister::X86R8, value_byte_offset: 8, byte_size: 8
        };
        plan.call.parameters[2] = windows_transfer_register(8, MachineRegister::X86R9);
        plan.call.parameters[3].shape = AbiValueShape {
            class: AbiValueClass::Integer, byte_size: 8, alignment: 8
        };
        plan.call.parameters[3].location_count = 1;
        plan.call.parameters[3].locations[0] = ValueLocation::Stack {
            stack_byte_offset: 32, value_byte_offset: 0, byte_size: 8, alignment: 8
        };
        plan.call.has_result = true;
        plan.call.result = windows_transfer_register(4, MachineRegister::X86Rax);
        plan.call.stack_alignment = 16;
        plan.call.shadow_bytes = 32;
        plan.call.entry_control = EntryControl::CallReturn;
        plan.call.ordinary_clobbers.registers[0] = MachineRegister::X86Rax;
        plan.call.ordinary_clobbers.registers[1] = MachineRegister::X86Rcx;
        plan.call.ordinary_clobbers.registers[2] = MachineRegister::X86Rdx;
        plan.call.ordinary_clobbers.registers[3] = MachineRegister::X86R8;
        plan.call.ordinary_clobbers.registers[4] = MachineRegister::X86R9;
        plan.call.ordinary_clobbers.registers[5] = MachineRegister::X86R10;
        plan.call.ordinary_clobbers.registers[6] = MachineRegister::X86R11;
        plan.call.ordinary_clobbers.registers[7] = MachineRegister::X86Xmm { index: 0 };
        plan.call.ordinary_clobbers.registers[8] = MachineRegister::X86Xmm { index: 1 };
        plan.call.ordinary_clobbers.registers[9] = MachineRegister::X86Xmm { index: 2 };
        plan.call.ordinary_clobbers.registers[10] = MachineRegister::X86Xmm { index: 3 };
        plan.call.ordinary_clobbers.registers[11] = MachineRegister::X86Xmm { index: 4 };
        plan.call.ordinary_clobbers.registers[12] = MachineRegister::X86Xmm { index: 5 };
        plan.call.ordinary_clobbers.register_count = 13;
        plan.state.initial_regime = MachineRegime::X86Long64;
        plan.state.permitted_transitive_use.general_registers = true;
        plan.state.permitted_transitive_use.vector_registers = true;
        plan.state.permitted_transitive_use.flags = true;
        plan.state.stack = EntryStack::ProviderSelected;
        plan.state.preemption = Preemption::NotApplicable;
        plan
    }

machine windows_transfer_integer_shape(shape: &ValueShape, bytes: u64) -> bool {
    transition shape.class {
        ValueClass::Integer -> (shape.byte_size == bytes && shape.alignment == bytes)
        _ -> false
    }
}
machine windows_transfer_reference_shape(shape: &ValueShape, bytes: u64) -> bool {
    transition shape.class {
        ValueClass::Reference -> (shape.byte_size == bytes && shape.alignment == 8)
        _ -> false
    }
}
machine windows_transfer_register(bytes: u64, register: MachineRegister) -> ValuePlacement {
    let mut place: ValuePlacement;
    place.shape = AbiValueShape { class: AbiValueClass::Integer, byte_size: bytes, alignment: bytes };
    place.location_count = 1;
    place.locations[0] = ValueLocation::Register {
        register: register, value_byte_offset: 0, byte_size: bytes
    };
    place
}
