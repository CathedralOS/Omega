// windows_x86_64 ProcessExit provider declaration. Windows has no stable
// syscall ABI, so the exact canonical requirement realizes through kernel32's
// `ExitProcess` by DLL linkage, like every other Windows boundary leaf.
// This leaf keeps its `via` realization rather than a `Build::bind` row:
// `ProcessExit::exit_process` is owned by `omega::language::core`, which no
// package's build program can name as a product dependency, so the
// package-owned locator model cannot reach it.
use omega::language::core::DllImport;
use omega::language::core::ForeignBinding;
use omega::language::core::ProcessExit;
windows_x86_64 machine process_exit_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "ExitProcess",
        },
    }
}
windows_x86_64 machine ProcessExitNativeProvider::exit_process(return_code: i32)
    satisfies ProcessExit::exit_process
    via process_exit_binding();

windows_x86_64 machine ProcessExitNativeProvider::provider_defaults(defaults: &mut ProcessExitNativeProvider) {
    ProcessExitNativeProvider::select_provider<ProcessExit, NativeProcessExit>(defaults);
}
