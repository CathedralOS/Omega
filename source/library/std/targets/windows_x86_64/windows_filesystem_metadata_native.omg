// GetFileInformationByHandleEx owns synchronous output completion. Its class
// selects the complete record, not an untyped byte-count promise. The x64 SDK
// records are FILE_BASIC_INFO (40 bytes), FILE_STANDARD_INFO (24 bytes), and
// FILE_ATTRIBUTE_TAG_INFO (8 bytes). BOOLEAN fields are bytes, not Win32 BOOLs.
// Private path opens require anonymous SQOS even before disk classification;
// a rejected non-disk endpoint must not acquire the caller's identity first.
//
// https://learn.microsoft.com/windows/win32/api/winbase/nf-winbase-getfileinformationbyhandleex
// https://learn.microsoft.com/windows/win32/api/winbase/ns-winbase-file_basic_info
// https://learn.microsoft.com/windows/win32/api/winbase/ns-winbase-file_standard_info
// https://learn.microsoft.com/windows/win32/api/winbase/ns-winbase-file_attribute_tag_info
use omega::language::core::external_binding;
use omega::language::core::filesystem_authority;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_metadata;

// A pinned disk-file classification, not ownership of arbitrary integers.
// Zero is the failed classifier result; queries also require nonzero.
domain i64::WindowsDiskFileOrAbsent
requires self != -1
established by windows_classify_metadata_disk_file;

data WindowsNativeFileBasicInfo {
    creation_ticks: u64;
    access_ticks: u64;
    write_ticks: u64;
    change_ticks: u64;
    attributes: u32;
    padding: u32;
}
data WindowsNativeFileStandardInfo {
    allocation_size: i64;
    length: i64;
    links: u32;
    delete_pending: u8;
    directory: u8;
    padding: [u8; 2];
}
data WindowsNativeFileAttributeTagInfo { attributes: u32; reparse_tag: u32; }
data WindowsFilesystemMetadataImports {}

boundary trait WindowsFilesystemMetadataIo {
    machine file_type(handle: i64) -> u32 reaches FilesystemMetadataQuery blocks;
    machine open_attributes(path: &[u16; 4096] in WindowsNativePath, desired_access: u32, sharing: u32, security: u64, disposition: u32, flags: u32, template: u64) -> i64
    requires desired_access == 128 && sharing == 7 && security == 0 && disposition == 3
        && (flags == 34603008 || flags == 36700160) && template == 0
    reaches FilesystemMetadataQuery blocks;
    machine basic(handle: i64 in WindowsDiskFileOrAbsent, information_class: u32, output: &mut WindowsNativeFileBasicInfo, size: u32) -> i32
    requires handle != 0 && information_class == 0 && size == 40
    reaches FilesystemMetadataQuery blocks;
    machine standard(handle: i64 in WindowsDiskFileOrAbsent, information_class: u32, output: &mut WindowsNativeFileStandardInfo, size: u32) -> i32
    requires handle != 0 && information_class == 1 && size == 24
    reaches FilesystemMetadataQuery blocks;
    machine attribute_tag(handle: i64 in WindowsDiskFileOrAbsent, information_class: u32, output: &mut WindowsNativeFileAttributeTagInfo, size: u32) -> i32
    requires handle != 0 && information_class == 9 && size == 8
    reaches FilesystemMetadataQuery blocks;
}


// A separate applied contract for the same CreateFileW mechanism: exact
// read-attributes access, OPEN_EXISTING, shared delete, synchronous directory
// support, anonymous SQOS, and optional final-component reparse inspection.
// General create retains its conservative mutation row; a portable query
// cannot call it.
