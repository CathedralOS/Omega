// Windows raw filesystem entrance. Select one complete public family map and
// its exact native dependencies: control/query imports plus whole-view I/O.
// Control/path operations live below windows_filesystem_control; borrowed-buffer
// mode, pinning and completion flow lives below windows_filesystem_transfer.
// The calling policy describes representation, never custody or authority.
use omega::language::core::filesystem_authority;
use windows_filesystem_host;
use filesystem_host;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_transfer_native;
use targets::windows_x86_64::windows_filesystem_control;
use targets::windows_x86_64::windows_filesystem_transfer;
use targets::windows_x86_64::windows_filesystem_metadata;
use targets::windows_x86_64::windows_filesystem_metadata_native;

data WindowsFilesystemNativeProvider { }

windows_x86_64 machine WindowsFilesystemNativeProvider::provider_defaults(defaults: &mut WindowsFilesystemNativeProvider) {
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemHost, NativeWindowsFilesystem>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemIo, NativeWindowsFilesystemImports>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemTransferIo, NativeWindowsFilesystemTransfers>(defaults);
    WindowsFilesystemNativeProvider::select_provider<WindowsFilesystemMetadataIo, NativeWindowsFilesystemMetadataImports>(defaults);
}

// Inline members bind the complete implementation to its existing target-owned
// bodies and foreign bindings. Forwarding preserves operation capability rows;
// the raw family's selection identity contributes no additional service reach.
NativeWindowsFilesystem satisfies WindowsFilesystemHost {
    machine metadata(handle: u64) -> WindowsMetadataResult reaches FilesystemMetadataQuery {
        block WindowsFilesystemNativeProvider::metadata(handle)
    }
    machine read_metadata(path: &[u8] in Path, no_follow: bool) -> WindowsMetadataResult reaches FilesystemMetadataQuery {
        block WindowsFilesystemNativeProvider::read_metadata(path, no_follow)
    }
    machine create_file(path: &[u8] in Path, desired_access: u32, share_mode: u32, creation_disposition: u32, flags_and_attributes: u32) -> u64
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        block WindowsFilesystemNativeProvider::create_file(path, desired_access, share_mode, creation_disposition, flags_and_attributes)
    }
    machine write_file(handle: u64, bytes: &[u8]) -> i64 reaches FilesystemContentWrite {
        block WindowsFilesystemNativeProvider::write_file(handle, bytes)
    }
    machine close_handle(handle: u64) -> i32 { block WindowsFilesystemNativeProvider::close_handle(handle) }
    machine last_error() -> u32 { WindowsFilesystemNativeProvider::last_error() }
    machine read_file(handle: u64, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemContentRead {
        block WindowsFilesystemNativeProvider::read_file(handle, buffer, count)
    }
    machine flush_file_buffers(handle: u64) -> i32 { block WindowsFilesystemNativeProvider::flush_file_buffers(handle) }
    machine set_file_pointer(handle: u64, distance: i64, method: u32) -> i64 {
        block WindowsFilesystemNativeProvider::set_file_pointer(handle, distance, method)
    }
    machine duplicate_handle(handle: u64) -> u64 { WindowsFilesystemNativeProvider::duplicate_handle(handle) }
    machine move_file(from: &[u8] in Path, to: &[u8] in Path, flags: u32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
        block WindowsFilesystemNativeProvider::move_file(from, to, flags)
    }
    machine rename_file(from: &[u8] in Path, to: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        block WindowsFilesystemNativeProvider::rename_file(from, to)
    }
    machine set_file_time(handle: u64, access_time: u64, write_time: u64) -> i32 reaches FilesystemMetadataMutation {
        block WindowsFilesystemNativeProvider::set_file_time(handle, access_time, write_time)
    }
    machine get_file_time(handle: u64) -> WindowsFileTimeResult reaches FilesystemMetadataQuery {
        block WindowsFilesystemNativeProvider::get_file_time(handle)
    }
    machine set_file_attributes(path: &[u8] in Path, attributes: u32) -> i32 reaches FilesystemMetadataMutation {
        block WindowsFilesystemNativeProvider::set_file_attributes(path, attributes)
    }
    machine create_directory(path: &[u8] in Path) -> i32 reaches FilesystemMetadataMutation + FilesystemNamespaceMutation {
        block WindowsFilesystemNativeProvider::create_directory(path)
    }
    machine remove_directory(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        block WindowsFilesystemNativeProvider::remove_directory(path)
    }
    machine delete_file(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation {
        block WindowsFilesystemNativeProvider::delete_file(path)
    }
}
