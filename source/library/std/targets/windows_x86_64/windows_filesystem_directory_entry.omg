// Ordinal selection owns one private directory object and skips only dot rows.
// Metadata comes from that enumeration record, not a second pathname lookup
// which could select a replacement child. No ordering or snapshot is promised.
use filesystem_host;
use windows_filesystem_host;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::windows_filesystem_impl;
use targets::windows_x86_64::windows_filesystem_directory;
use targets::windows_x86_64::windows_filesystem_directory_native;
use targets::windows_x86_64::windows_filesystem_private_handles;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_path_query_native;

windows_x86_64 machine WindowsFilesystemNativeProvider::directory_nth(path: &[u8] in Path, ordinal: u64) -> WindowsDirectoryEntryResult
satisfies WindowsFilesystemHost::directory_nth
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration + FilesystemMetadataQuery {
    let handle: i64 in WindowsPrivateNonalertFileOrAbsent = block windows_directory_open(path);
    transition handle != 0 { true -> query(handle, ordinal) false -> (windows_directory_entry_error()) }
    machine query(handle: i64 in WindowsPrivateNonalertFileOrAbsent, ordinal: u64) -> WindowsDirectoryEntryResult
    requires handle != 0 {
        let result: WindowsDirectoryEntryResult = block windows_directory_select(handle, ordinal);
        let released: i32 = block WindowsFilesystemNativeProvider::close_handle(narrow_i64_to_u64_wrapping(handle as i64));
        transition released == 0 { true -> (result) false -> failed_close(result) }
    }
    machine failed_close(result: WindowsDirectoryEntryResult) -> WindowsDirectoryEntryResult {
        transition result {
            WindowsDirectoryEntryResult::Error { code } -> (WindowsDirectoryEntryResult::Error { code: code })
            _ -> (windows_directory_entry_error())
        }
    }
}

machine windows_directory_entry_error() -> WindowsDirectoryEntryResult {
    let code: u32 = WindowsFilesystemIo::c_get_last_error();
    transition code != 0 {
        true -> (WindowsDirectoryEntryResult::Error { code: code })
        false -> (WindowsDirectoryEntryResult::Error { code: 31 })
    }
}

windows_x86_64 machine windows_directory_select(handle: i64 in WindowsPrivateNonalertFileOrAbsent, ordinal: u64) -> WindowsDirectoryEntryResult
requires handle != 0
reaches DirectoryEnumeration + FilesystemMetadataQuery {
    let mut output: WindowsNativeDirectoryEntryInfo;
    transition { _ -> next(handle, ordinal, &mut output, 0) }
    machine next(handle: i64 in WindowsPrivateNonalertFileOrAbsent, ordinal: u64,
        output: &mut WindowsNativeDirectoryEntryInfo, position: u64) -> WindowsDirectoryEntryResult
    requires handle != 0 && position <= ordinal {
        let step: WindowsDirectoryStep = block windows_directory_next_entry(handle, output, 0);
        transition step {
            WindowsDirectoryStep::Error { code } -> (WindowsDirectoryEntryResult::Error { code: code })
            WindowsDirectoryStep::End -> WindowsDirectoryEntryResult::End
            WindowsDirectoryStep::Name { length } -> name(handle, ordinal, output, position, length)
        }
    }
    machine name(handle: i64 in WindowsPrivateNonalertFileOrAbsent, ordinal: u64,
        output: &mut WindowsNativeDirectoryEntryInfo, position: u64, length: u64) -> WindowsDirectoryEntryResult
    requires handle != 0 && position <= ordinal {
        transition windows_directory_entry_dot(output, length) {
            true -> next(handle, ordinal, output, position)
            false -> selected(handle, ordinal, output, position, length)
        }
    }
    machine selected(handle: i64 in WindowsPrivateNonalertFileOrAbsent, ordinal: u64,
        output: &mut WindowsNativeDirectoryEntryInfo, position: u64, length: u64) -> WindowsDirectoryEntryResult
    requires handle != 0 && position <= ordinal {
        transition position < ordinal {
            true -> next(handle, ordinal, output, position + 1)
            false -> (windows_directory_encode_entry(output, length))
        }
    }
}

windows_x86_64 machine windows_directory_next_entry(handle: i64 in WindowsPrivateNonalertFileOrAbsent,
    output: &mut WindowsNativeDirectoryEntryInfo, restart: u8) -> WindowsDirectoryStep
requires handle != 0 && restart <= 1
reaches DirectoryEnumeration + FilesystemMetadataQuery {
    let mut completion: WindowsFilesystemIoStatus;
    let status: i32 = block WindowsFilesystemDirectoryIo::next_entry(handle, 0, 0, 0, &mut completion, output, 8256, 1, 1, 0, restart);
    transition status == 0 {
        true -> (windows_directory_decode_entry(output, completion.information))
        false -> other(status)
    }
    machine other(status: i32) -> WindowsDirectoryStep {
        transition status == -2147483642 || status == -1073741809 {
            true -> WindowsDirectoryStep::End
            false -> failed(status)
        }
    }
    machine failed(status: i32) -> WindowsDirectoryStep {
        WindowsDirectoryStep::Error { code: WindowsFilesystemIo::c_status_to_error(status) }
    }
}

machine windows_directory_decode_entry(output: &WindowsNativeDirectoryEntryInfo, returned: u64) -> WindowsDirectoryStep {
    transition returned >= 64 && returned <= 8256 {
        true -> record(output, returned)
        false -> (WindowsDirectoryStep::Error { code: 122 })
    }
    machine record(output: &WindowsNativeDirectoryEntryInfo, returned: u64) -> WindowsDirectoryStep
    requires returned >= 64 && returned <= 8256 {
        let bytes: u64 = widen_u32_to_u64(output.name_bytes);
        transition (output.control & 4294967295) == 0 && bytes > 0 && bytes <= 8192
            && bytes % 2 == 0 && bytes <= returned - 64 {
            true -> (WindowsDirectoryStep::Name { length: bytes / 2 })
            false -> (WindowsDirectoryStep::Error { code: 31 })
        }
    }
}

machine windows_directory_entry_dot(output: &WindowsNativeDirectoryEntryInfo, length: u64) -> bool {
    transition length == 1 || length == 2 { true -> first(output, length) false -> false }
    machine first(output: &WindowsNativeDirectoryEntryInfo, length: u64) -> bool {
        transition output.characters[0] == 46 { true -> second(output, length) false -> false }
    }
    machine second(output: &WindowsNativeDirectoryEntryInfo, length: u64) -> bool {
        length == 1 || output.characters[1] == 46
    }
}

windows_x86_64 machine windows_directory_encode_entry(source: &WindowsNativeDirectoryEntryInfo, characters: u64) -> WindowsDirectoryEntryResult {
    transition characters > 0 && characters <= 4096 {
        true -> encode(source, characters)
        false -> (WindowsDirectoryEntryResult::Error { code: 31 })
    }
    machine encode(source: &WindowsNativeDirectoryEntryInfo, characters: u64) -> WindowsDirectoryEntryResult
    requires characters > 0 && characters <= 4096 {
        let mut encoded: [u8; 12288];
        let native_count: i32 = narrow_u64_to_i32_exact(characters);
        let written: i32 = WindowsFilesystemUtf8Io::utf8<4096, 12288>(65001, 128, &source.characters,
            native_count, &mut encoded, 12288, 0, 0);
        transition written > 0 {
            true -> extent(&encoded, written, source.attributes)
            false -> (windows_directory_entry_error())
        }
    }
    machine extent(encoded: &[u8; 12288], written: i32, attributes: u32) -> WindowsDirectoryEntryResult
    requires written > 0 {
        let count: u64 = narrow_i32_to_u64_exact(written);
        transition count <= 256 {
            true -> (windows_directory_copy_entry(encoded, count, attributes))
            false -> (WindowsDirectoryEntryResult::Error { code: 122 })
        }
    }
}

machine windows_directory_copy_entry(source: &[u8; 12288], count: u64, attributes: u32) -> WindowsDirectoryEntryResult
requires count <= 256 {
    let mut selected: WindowsDirectoryEntry;
    selected.name_len = count;
    selected.attributes = attributes;
    windows_directory_copy_name(source, count, &mut selected.name);
    WindowsDirectoryEntryResult::Entry { entry: selected }
}

machine windows_directory_copy_name(source: &[u8; 12288], count: u64, name: &mut [u8; 256])
requires count <= 256 {
    transition { _ -> copy(source, count, name, 0) }
    machine copy(source: &[u8; 12288], count: u64, name: &mut [u8; 256], position: u64)
    requires count <= 256 {
        transition position < count { true -> store(source, count, name, position) false -> complete() }
    }
    machine store(source: &[u8; 12288], count: u64, name: &mut [u8; 256], position: u64)
    requires count <= 256 && position < count {
        name[position] = source[position];
        transition { _ -> copy(source, count, name, position + 1) }
    }
    machine complete() {}
}
