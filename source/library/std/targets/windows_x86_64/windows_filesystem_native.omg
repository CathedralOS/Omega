// Exact Windows filesystem native contracts and DLL locators. The public raw
// service owns operations; this private, complete native map owns their ABI.
use omega::language::core::external_binding;
use omega::language::core::filesystem_authority;

// The exact fixed buffer is classified before foreign scanning can observe it.
// Boundary contracts carry this structural identity, not an array read disguised
// as a declaration-local scalar precondition. The last WCHAR bounds the scan.
domain [u16; 4096]::WindowsNativePath(path) requires path[4095] == 0;

data WindowsFilesystemImports { }
data WindowsFilesystemIoStatus { status: i64; information: u64; }

// Exact native contracts belong to one trait. In particular, the mode query is
// not a generic metadata escape: its only admitted class is the four-byte
// FileModeInformation record describing this open file object's I/O mode.
boundary trait WindowsFilesystemIo {
    machine c_create_file(path: &[u16; 4096] in WindowsNativePath, desired_access: u32, share_mode: u32, security_attributes: u64, creation_disposition: u32, flags_and_attributes: u32, template: u64) -> i64
    requires security_attributes == 0 && template == 0
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation blocks;
    machine c_close_handle(handle: i64) -> i32 reaches blocks;
    machine c_get_last_error() -> u32 reaches;
    machine c_flush_file_buffers(handle: i64) -> i32 reaches blocks;
    machine c_set_file_pointer(handle: i64, distance: i64, position: &mut i64, method: u32) -> i32 reaches blocks;
    machine c_get_current_process() -> i64 reaches;
    machine c_duplicate_handle(source_process: i64, source: i64, target_process: i64, target: &mut i64, desired_access: u32, inherit: i32, options: u32) -> i32 reaches;
    machine c_set_file_attributes(path: &[u16; 4096] in WindowsNativePath, attributes: u32) -> i32

    reaches FilesystemMetadataMutation blocks;
    machine c_move_file(from: &[u16; 4096] in WindowsNativePath, to: &[u16; 4096] in WindowsNativePath, flags: u32) -> i32

    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation blocks;
    // MOVEFILE_REPLACE_EXISTING alone excludes cross-volume copying and
    // delayed-until-reboot mutation. The constraint is part of this contract.
    machine c_rename_file(from: &[u16; 4096] in WindowsNativePath, to: &[u16; 4096] in WindowsNativePath, flags: u32) -> i32
    requires flags == 1
    reaches FilesystemNamespaceMutation blocks;
    machine c_hard_link(link: &[u16; 4096] in WindowsNativePath, original: &[u16; 4096] in WindowsNativePath, security_attributes: u64) -> i32
    requires security_attributes == 0
    reaches FilesystemNamespaceMutation blocks;
    machine c_create_directory(path: &[u16; 4096] in WindowsNativePath, security_attributes: u64) -> i32
    requires security_attributes == 0
    reaches FilesystemMetadataMutation + FilesystemNamespaceMutation blocks;
    machine c_remove_directory(path: &[u16; 4096] in WindowsNativePath) -> i32

    reaches FilesystemNamespaceMutation blocks;
    machine c_delete_file(path: &[u16; 4096] in WindowsNativePath) -> i32

    reaches FilesystemNamespaceMutation blocks;
    machine c_set_file_time(handle: i64, creation_time: u64, access_time: &[u32; 2], write_time: &[u32; 2]) -> i32
    requires creation_time == 0
    reaches FilesystemMetadataMutation blocks;
    machine c_get_file_time(handle: i64, creation_time: u64, access_time: &mut u64, write_time: &mut u64) -> i32
    requires creation_time == 0
    reaches FilesystemMetadataQuery blocks;
    machine c_set_last_error(code: u32) reaches;
    machine c_file_mode(handle: i64, status: &mut WindowsFilesystemIoStatus, mode: &mut u32, length: u32, information_class: u32) -> i32
    reaches
    requires length == 4 && information_class == 16
    blocks;
    machine c_status_to_error(status: i32) -> u32 reaches;
}

windows_x86_64 machine windows_file_mode_binding() -> ForeignBinding<9, 22, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "ntdll.dll", export: "NtQueryInformationFile"
    } }
}
windows_x86_64 machine WindowsFilesystemImports::c_file_mode(handle: i64, status: &mut WindowsFilesystemIoStatus, mode: &mut u32, length: u32, information_class: u32) -> i32
satisfies WindowsFilesystemIo::c_file_mode
via windows_file_mode_binding()
requires length == 4 && information_class == 16
blocks;

windows_x86_64 machine windows_status_to_error_binding() -> ForeignBinding<9, 21, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName {
        library: "ntdll.dll", export: "RtlNtStatusToDosError"
    } }
}
windows_x86_64 machine WindowsFilesystemImports::c_status_to_error(status: i32) -> u32
satisfies WindowsFilesystemIo::c_status_to_error
via windows_status_to_error_binding();

windows_x86_64 machine windows_create_file_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "CreateFileW",
        },
    }
}
windows_x86_64 machine windows_close_handle_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "CloseHandle",
        },
    }
}
windows_x86_64 machine windows_get_last_error_binding() -> ForeignBinding<12, 12, 0> {
    ForeignBinding::DllImport {
        import: DllImport::PeByName {
            library: "kernel32.dll",
            export: "GetLastError",
        },
    }
}

windows_x86_64 machine WindowsFilesystemImports::c_create_file(path: &[u16; 4096] in WindowsNativePath, desired_access: u32, share_mode: u32, security_attributes: u64, creation_disposition: u32, flags_and_attributes: u32, template: u64) -> i64
    satisfies WindowsFilesystemIo::c_create_file
    via windows_create_file_binding()
    requires security_attributes == 0 && template == 0
blocks;
windows_x86_64 machine WindowsFilesystemImports::c_close_handle(handle: i64) -> i32
    satisfies WindowsFilesystemIo::c_close_handle
    via windows_close_handle_binding()
blocks;
windows_x86_64 machine WindowsFilesystemImports::c_get_last_error() -> u32
    satisfies WindowsFilesystemIo::c_get_last_error
    via windows_get_last_error_binding();

windows_x86_64 machine windows_c_flush_file_buffers_binding() -> ForeignBinding<12, 16, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName { library: "kernel32.dll", export: "FlushFileBuffers" } }
}
windows_x86_64 machine WindowsFilesystemImports::c_flush_file_buffers(handle: i64) -> i32
satisfies WindowsFilesystemIo::c_flush_file_buffers
via windows_c_flush_file_buffers_binding()
blocks;

windows_x86_64 machine windows_c_set_file_pointer_binding() -> ForeignBinding<12, 16, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName { library: "kernel32.dll", export: "SetFilePointerEx" } }
}
windows_x86_64 machine WindowsFilesystemImports::c_set_file_pointer(handle: i64, distance: i64, position: &mut i64, method: u32) -> i32
satisfies WindowsFilesystemIo::c_set_file_pointer
via windows_c_set_file_pointer_binding()
blocks;

windows_x86_64 machine windows_c_get_current_process_binding() -> ForeignBinding<12, 17, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName { library: "kernel32.dll", export: "GetCurrentProcess" } }
}
windows_x86_64 machine WindowsFilesystemImports::c_get_current_process() -> i64
satisfies WindowsFilesystemIo::c_get_current_process
via windows_c_get_current_process_binding();

windows_x86_64 machine windows_c_duplicate_handle_binding() -> ForeignBinding<12, 15, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName { library: "kernel32.dll", export: "DuplicateHandle" } }
}
windows_x86_64 machine WindowsFilesystemImports::c_duplicate_handle(source_process: i64, source: i64, target_process: i64, target: &mut i64, desired_access: u32, inherit: i32, options: u32) -> i32
satisfies WindowsFilesystemIo::c_duplicate_handle
via windows_c_duplicate_handle_binding();

windows_x86_64 machine windows_c_set_file_attributes_binding() -> ForeignBinding<12, 18, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName { library: "kernel32.dll", export: "SetFileAttributesW" } }
}
windows_x86_64 machine WindowsFilesystemImports::c_set_file_attributes(path: &[u16; 4096] in WindowsNativePath, attributes: u32) -> i32
satisfies WindowsFilesystemIo::c_set_file_attributes
via windows_c_set_file_attributes_binding()

blocks;

windows_x86_64 machine windows_c_move_file_binding() -> ForeignBinding<12, 11, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName { library: "kernel32.dll", export: "MoveFileExW" } }
}
windows_x86_64 machine WindowsFilesystemImports::c_move_file(from: &[u16; 4096] in WindowsNativePath, to: &[u16; 4096] in WindowsNativePath, flags: u32) -> i32
satisfies WindowsFilesystemIo::c_move_file
via windows_c_move_file_binding()

blocks;

// Same foreign locator, distinct checked contract. Do not select the broad
// c_move_file requirement and infer narrower authority from its caller.
// https://learn.microsoft.com/windows/win32/api/winbase/nf-winbase-movefileexw
windows_x86_64 machine WindowsFilesystemImports::c_rename_file(from: &[u16; 4096] in WindowsNativePath, to: &[u16; 4096] in WindowsNativePath, flags: u32) -> i32
satisfies WindowsFilesystemIo::c_rename_file
via windows_c_move_file_binding()
requires flags == 1
blocks;

windows_x86_64 machine windows_c_create_directory_binding() -> ForeignBinding<12, 16, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName { library: "kernel32.dll", export: "CreateDirectoryW" } }
}

// The destination comes first in the native ABI. No metadata lookup, copy,
// security descriptor change or cross-volume fallback is performed here.
// https://learn.microsoft.com/windows/win32/api/winbase/nf-winbase-createhardlinkw
windows_x86_64 machine windows_c_hard_link_binding() -> ForeignBinding<12, 15, 0> {
    ForeignBinding::DllImport { import: DllImport::PeByName { library: "kernel32.dll", export: "CreateHardLinkW" } }
}
windows_x86_64 machine WindowsFilesystemImports::c_hard_link(link: &[u16; 4096] in WindowsNativePath, original: &[u16; 4096] in WindowsNativePath, security_attributes: u64) -> i32
satisfies WindowsFilesystemIo::c_hard_link
via windows_c_hard_link_binding()
requires security_attributes == 0
blocks;
windows_x86_64 machine WindowsFilesystemImports::c_create_directory(path: &[u16; 4096] in WindowsNativePath, security_attributes: u64) -> i32
satisfies WindowsFilesystemIo::c_create_directory
via windows_c_create_directory_binding()
    requires security_attributes == 0
blocks;

