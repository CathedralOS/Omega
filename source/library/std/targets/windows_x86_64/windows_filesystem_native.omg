// Exact Windows filesystem native contracts and DLL locators. The public raw
// service owns operations; this private, complete native map owns their ABI.
use omega::language::core::external_binding;
use omega::language::core::filesystem_authority;

// The exact fixed buffer is classified before foreign scanning can observe it.
// Boundary contracts carry this structural identity, not an array read disguised
// as a declaration-local scalar precondition. The last WCHAR bounds the scan.
domain [u16; 4096]::WindowsNativePath requires self[4095] == 0;

data WindowsFilesystemImports { }
data WindowsFilesystemIoStatus { status: i64; information: u64; }

// Exact native contracts belong to one trait. In particular, the mode query is
// not a generic metadata escape: its only admitted class is the four-byte
// FileModeInformation record describing this open file object's I/O mode.
boundary trait WindowsFilesystemIo {
    machine c_create_file(path: &[u16; 4096] in WindowsNativePath, desired_access: u32, share_mode: u32, security_attributes: u64, creation_disposition: u32, flags_and_attributes: u32, template: u64) -> i64
    requires security_attributes == 0 && template == 0
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation blocks;
    machine c_close_handle(handle: i64) -> i32 reaches blocks;
    machine c_get_last_error() -> u32 reaches;
    machine c_flush_file_buffers(handle: i64) -> i32 reaches blocks;
    machine c_set_file_pointer(handle: i64, distance: i64, position: &mut i64, method: u32) -> i32 reaches blocks;
    machine c_get_current_process() -> i64 reaches;
    machine c_duplicate_handle(source_process: i64, source: i64, target_process: i64, target: &mut i64, desired_access: u32, inherit: i32, options: u32) -> i32 reaches;
    machine c_set_file_attributes(path: &[u16; 4096] in WindowsNativePath, attributes: u32) -> i32

    reaches FilesystemMetadataMutation blocks;
    machine c_move_file(from: &[u16; 4096] in WindowsNativePath, to: &[u16; 4096] in WindowsNativePath, flags: u32) -> i32

    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation blocks;
    // MOVEFILE_REPLACE_EXISTING alone excludes cross-volume copying and
    // delayed-until-reboot mutation. The constraint is part of this contract.
    machine c_rename_file(from: &[u16; 4096] in WindowsNativePath, to: &[u16; 4096] in WindowsNativePath, flags: u32) -> i32
    requires flags == 1
    reaches FilesystemNamespaceMutation blocks;
    machine c_hard_link(link: &[u16; 4096] in WindowsNativePath, original: &[u16; 4096] in WindowsNativePath, security_attributes: u64) -> i32
    requires security_attributes == 0
    reaches FilesystemNamespaceMutation blocks;
    machine c_create_directory(path: &[u16; 4096] in WindowsNativePath, security_attributes: u64) -> i32
    requires security_attributes == 0
    reaches FilesystemMetadataMutation + FilesystemNamespaceMutation blocks;
    machine c_remove_directory(path: &[u16; 4096] in WindowsNativePath) -> i32

    reaches FilesystemNamespaceMutation blocks;
    machine c_delete_file(path: &[u16; 4096] in WindowsNativePath) -> i32

    reaches FilesystemNamespaceMutation blocks;
    machine c_set_file_time(handle: i64, creation_time: u64, access_time: &[u32; 2], write_time: &[u32; 2]) -> i32
    requires creation_time == 0
    reaches FilesystemMetadataMutation blocks;
    machine c_get_file_time(handle: i64, creation_time: u64, access_time: &mut u64, write_time: &mut u64) -> i32
    requires creation_time == 0
    reaches FilesystemMetadataQuery blocks;
    machine c_set_last_error(code: u32) reaches;
    machine c_file_mode(handle: i64, status: &mut WindowsFilesystemIoStatus, mode: &mut u32, length: u32, information_class: u32) -> i32
    reaches
    requires length == 4 && information_class == 16
    blocks;
    machine c_status_to_error(status: i32) -> u32 reaches;
}


// Same foreign locator, distinct checked contract. Do not select the broad
// c_move_file requirement and infer narrower authority from its caller.
// https://learn.microsoft.com/windows/win32/api/winbase/nf-winbase-movefileexw


// The destination comes first in the native ABI. No metadata lookup, copy,
// security descriptor change or cross-volume fallback is performed here.
// https://learn.microsoft.com/windows/win32/api/winbase/nf-winbase-createhardlinkw


// One closed native implementation map, selected as a whole below the raw family.
