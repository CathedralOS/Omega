}
windows_x86_64 machine WindowsFilesystemImports::c_set_file_time(handle: i64, creation_time: u64, access_time: &[u32; 2], write_time: &[u32; 2]) -> i32
satisfies WindowsFilesystemIo::c_set_file_time
via windows_c_set_file_time_binding()
requires creation_time == 0
blocks;

