// Synchronous handle, path, timestamp and namespace operations. Errors are
// captured immediately after their native call; no provider error cache exists.
use windows_filesystem_host;
use filesystem_host;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::windows_filesystem_impl;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_paths;

// Read GetLastError before any other native operation. Status-only methods
// retain their i32 carrier: zero/oversized codes become ERROR_GEN_FAILURE,
// rather than wrapping a failure into a success. last_error still exposes the
// untouched full native code. Byte-count methods can negate every u32 exactly.
windows_x86_64 machine WindowsFilesystemNativeProvider::failure_i32() -> i32
{
    let code: u32 = WindowsFilesystemIo::c_get_last_error();
    transition code > 0 && code <= 2147483647 {
        true -> (narrow_i64_to_i32_wrapping(0 - widen_u32_to_i64(code)))
        _ -> (-31)
    }
}
windows_x86_64 machine WindowsFilesystemNativeProvider::failure_i64() -> i64
{
    let code: u32 = WindowsFilesystemIo::c_get_last_error();
    transition code != 0 { true -> (0 - widen_u32_to_i64(code)) _ -> (-31) }
}

// A HANDLE is opaque: reject only NULL and INVALID_HANDLE_VALUE, not every
// high-bit value. Synchronous transfers do not accept FILE_FLAG_OVERLAPPED.
windows_x86_64 machine WindowsFilesystemNativeProvider::normalize_handle(handle: i64) -> u64 {
    transition handle != 0 && handle != -1 {
        true -> (narrow_i64_to_u64_wrapping(handle))
        _ -> (0)
    }
}
windows_x86_64 machine WindowsFilesystemNativeProvider::invalid_handle() -> u64
{
    WindowsFilesystemIo::c_set_last_error(87);
    0
}
windows_x86_64 machine WindowsFilesystemNativeProvider::completion_status(succeeded: i32) -> i32
{
    transition succeeded == 0 {
        true -> (WindowsFilesystemNativeProvider::failure_i32())
        _ -> (0)
    }
}
windows_x86_64 machine WindowsFilesystemNativeProvider::create_file(path: &[u8] in Path, desired_access: u32, share_mode: u32, creation_disposition: u32, flags_and_attributes: u32) -> u64
satisfies WindowsFilesystemHost::create_file
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mut wide: [u16; 4096];
    let count: i64 = windows_wide_path(path, &mut wide);
    wide[4095] = 0;
    transition count > 0 && (flags_and_attributes & 1073741824) == 0 {
        true -> (WindowsFilesystemNativeProvider::normalize_handle(block WindowsFilesystemIo::c_create_file(&wide, desired_access, share_mode, 0, creation_disposition, flags_and_attributes, 0)))
        _ -> (WindowsFilesystemNativeProvider::invalid_handle())
    }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::close_handle(handle: u64) -> i32
    satisfies WindowsFilesystemHost::close_handle
{
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    let ok: i32 = block WindowsFilesystemIo::c_close_handle(raw_handle);
    transition ok == 0 {
        true -> failed()
        _ -> (0)
    }

    state failed() -> i32 {
        transition { _ -> (WindowsFilesystemNativeProvider::failure_i32()) }
    }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::last_error() -> u32
    satisfies WindowsFilesystemHost::last_error
{
    WindowsFilesystemIo::c_get_last_error()
}

windows_x86_64 machine WindowsFilesystemNativeProvider::flush_file_buffers(handle: u64) -> i32
satisfies WindowsFilesystemHost::flush_file_buffers
{
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    WindowsFilesystemNativeProvider::completion_status(block WindowsFilesystemIo::c_flush_file_buffers(raw_handle))
}
windows_x86_64 machine WindowsFilesystemNativeProvider::set_file_pointer(handle: u64, distance: i64, method: u32) -> i64
satisfies WindowsFilesystemHost::set_file_pointer
{
    let mut position: i64 = 0;
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    let succeeded: i32 = block WindowsFilesystemIo::c_set_file_pointer(raw_handle, distance, &mut position, method);
    transition succeeded == 0 { true -> (WindowsFilesystemNativeProvider::failure_i64()) _ -> (position) }
}
windows_x86_64 machine WindowsFilesystemNativeProvider::duplicate_handle(handle: u64) -> u64
satisfies WindowsFilesystemHost::duplicate_handle
{
    let process: i64 = WindowsFilesystemIo::c_get_current_process();
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    let mut duplicate: i64 = 0;
    let succeeded: i32 = WindowsFilesystemIo::c_duplicate_handle(process, raw_handle, process, &mut duplicate, 0, 0, 2);
    transition succeeded == 0 { true -> (0) _ -> (WindowsFilesystemNativeProvider::normalize_handle(duplicate)) }
}
windows_x86_64 machine WindowsFilesystemNativeProvider::move_file(from: &[u8] in Path, to: &[u8] in Path, flags: u32) -> i32
satisfies WindowsFilesystemHost::move_file
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mut wide_from: [u16; 4096];
    let mut wide_to: [u16; 4096];
    let from_count: i64 = windows_wide_path(from, &mut wide_from);
    wide_from[4095] = 0;
    let to_count: i64 = windows_wide_path(to, &mut wide_to);
    wide_to[4095] = 0;
    transition from_count > 0 && to_count > 0 {
        true -> (WindowsFilesystemNativeProvider::completion_status(block WindowsFilesystemIo::c_move_file(&wide_from, &wide_to, flags)))
        _ -> (-87)
    }
}

windows_x86_64 machine WindowsFilesystemNativeProvider::rename_file(from: &[u8] in Path, to: &[u8] in Path) -> i32
satisfies WindowsFilesystemHost::rename_file
reaches FilesystemNamespaceMutation {
    let mut wide_from: [u16; 4096];
    let mut wide_to: [u16; 4096];
    let from_count: i64 = windows_wide_path(from, &mut wide_from);
    wide_from[4095] = 0;
    let to_count: i64 = windows_wide_path(to, &mut wide_to);
    wide_to[4095] = 0;
    transition from_count > 0 && to_count > 0 {
        true -> (WindowsFilesystemNativeProvider::completion_status(block WindowsFilesystemIo::c_rename_file(&wide_from, &wide_to, 1)))
        _ -> (-87)
    }
}
windows_x86_64 machine WindowsFilesystemNativeProvider::hard_link(original: &[u8] in Path, link: &[u8] in Path) -> i32
satisfies WindowsFilesystemHost::hard_link
reaches FilesystemNamespaceMutation {
    let mut wide_original: [u16; 4096];
    let mut wide_link: [u16; 4096];
    let original_count: i64 = windows_wide_path(original, &mut wide_original);
    wide_original[4095] = 0;
    let link_count: i64 = windows_wide_path(link, &mut wide_link);
    wide_link[4095] = 0;
    transition original_count > 0 && link_count > 0 {
        true -> (WindowsFilesystemNativeProvider::completion_status(block WindowsFilesystemIo::c_hard_link(&wide_link, &wide_original, 0)))
        false -> (-87)
    }
}

// FILETIME is two little-endian DWORDs, not an arbitrary borrowed Omega u64.
// Encode the public by-value timestamps into their native records before
// lending them. A forwarded shared scalar loan may describe narrower storage;
// its logical u64 type alone cannot authorize an eight-byte foreign read.
windows_x86_64 machine WindowsFilesystemNativeProvider::set_file_time(handle: u64, access_time: u64, write_time: u64) -> i32
satisfies WindowsFilesystemHost::set_file_time
reaches FilesystemMetadataMutation {
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    let mut access_record: [u32; 2];
    access_record[0] = narrow_u64_to_u32_wrapping(access_time);
    access_record[1] = narrow_u64_to_u32_wrapping(access_time >> 32);
    let mut write_record: [u32; 2];
    write_record[0] = narrow_u64_to_u32_wrapping(write_time);
    write_record[1] = narrow_u64_to_u32_wrapping(write_time >> 32);
    WindowsFilesystemNativeProvider::completion_status(block WindowsFilesystemIo::c_set_file_time(raw_handle, 0, &access_record, &write_record))
}
windows_x86_64 machine WindowsFilesystemNativeProvider::get_file_time(handle: u64) -> WindowsFileTimeResult
satisfies WindowsFilesystemHost::get_file_time
reaches FilesystemMetadataQuery {
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    let mut access_time: u64 = 0;
    let mut write_time: u64 = 0;
    let succeeded: i32 = block WindowsFilesystemIo::c_get_file_time(raw_handle, 0, &mut access_time, &mut write_time);
    transition succeeded == 0 { true -> failed() _ -> value(access_time, write_time) }
    state failed() -> WindowsFileTimeResult {
        let code: u32 = WindowsFilesystemIo::c_get_last_error();
        WindowsFileTimeResult::Error { code: code }
    }
    state value(access_time: u64, write_time: u64) -> WindowsFileTimeResult {
        WindowsFileTimeResult::Value { access_time: access_time, write_time: write_time }
    }
}
windows_x86_64 machine WindowsFilesystemNativeProvider::set_file_attributes(path: &[u8] in Path, attributes: u32) -> i32
satisfies WindowsFilesystemHost::set_file_attributes
reaches FilesystemMetadataMutation {
    let mut wide: [u16; 4096];
    let count: i64 = windows_wide_path(path, &mut wide);
    wide[4095] = 0;
    transition count > 0 {
        true -> (WindowsFilesystemNativeProvider::completion_status(block WindowsFilesystemIo::c_set_file_attributes(&wide, attributes)))
        _ -> (-87)
    }
}
windows_x86_64 machine WindowsFilesystemNativeProvider::create_directory(path: &[u8] in Path) -> i32
satisfies WindowsFilesystemHost::create_directory
reaches FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mut wide: [u16; 4096];
    let count: i64 = windows_wide_path(path, &mut wide);
    wide[4095] = 0;
    transition count > 0 {
        true -> (WindowsFilesystemNativeProvider::completion_status(block WindowsFilesystemIo::c_create_directory(&wide, 0)))
        _ -> (-87)
    }
}
windows_x86_64 machine WindowsFilesystemNativeProvider::remove_directory(path: &[u8] in Path) -> i32
satisfies WindowsFilesystemHost::remove_directory
reaches FilesystemNamespaceMutation {
    let mut wide: [u16; 4096];
    let count: i64 = windows_wide_path(path, &mut wide);
    wide[4095] = 0;
    transition count > 0 {
        true -> (WindowsFilesystemNativeProvider::completion_status(block WindowsFilesystemIo::c_remove_directory(&wide)))
        _ -> (-87)
    }
}
windows_x86_64 machine WindowsFilesystemNativeProvider::delete_file(path: &[u8] in Path) -> i32
satisfies WindowsFilesystemHost::delete_file
reaches FilesystemNamespaceMutation {
    let mut wide: [u16; 4096];
    let count: i64 = windows_wide_path(path, &mut wide);
    wide[4095] = 0;
    transition count > 0 {
        true -> (WindowsFilesystemNativeProvider::completion_status(block WindowsFilesystemIo::c_delete_file(&wide)))
        _ -> (-87)
    }
}

