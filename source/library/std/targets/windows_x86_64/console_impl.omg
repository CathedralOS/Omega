// Windows byte I/O uses MSVCRT descriptor calls. Binary mode preserves every
// authored byte, including CR/LF and Ctrl+Z. Build supplies each DLL locator.
use omega::language::core::narrow_i32_to_u8_wrapping;
use omega::language::core::widen_u8_to_i32;

// The leaf requirements below carry no source realization: each one is a
// package-owned boundary row whose DLL locator lives in `std/build.omg`
// (`Build::bind<WindowsConsoleIo::...>`). Providers invoke the trait members
// directly; their raw host dependencies belong to the realization inventory.
boundary trait WindowsConsoleIo: Calling<WindowsX64ScalarCalling> {
    machine write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    requires count <= 4
    reaches Console
    crashes none;

    // A console read waits for host input, so the import publishes `blocks`.
    machine read(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    requires count <= 4
    reaches Console
    blocks
    crashes none;

    // MSVCRT descriptors open in text mode, which translates CR LF pairs to a
    // single LF on reads, maps LF to CR LF on writes, and ends input at Ctrl+Z.
    // The console contract moves the authored bytes themselves, so read_byte and
    // write_byte put their descriptor in binary mode (`_O_BINARY`, 0x8000) before
    // moving data. `_setmode` is idempotent; calling it per operation keeps the
    // guarantee local to this provider with no separate descriptor-init hook.
    //   `int _setmode(int fd, int mode)`
    machine set_mode(descriptor: i32, mode: i32) -> i32
    reaches Console
    crashes none;
}

// Descriptor 0 is stdin. One byte is a Byte, zero bytes is end of input, and
// -1 is a failed host read. Every other count traps under the published
// `crashes Trap` contract.
machine windows_console_read_byte() -> ByteRead
reaches Console
invokes WindowsConsoleIo
blocks
crashes Trap
{
    let mut cell: i32 = 0;
    let mode: i32 = WindowsConsoleIo::set_mode(0, 32768);
    let count: i32 = block WindowsConsoleIo::read(0, &mut cell, 1);
    transition count {
        1 -> byte(cell)
        0 -> end()
        _ -> failed()
    }

    machine byte(cell: i32) -> ByteRead {
        let value: u8 = narrow_i32_to_u8_wrapping(cell);
        ByteRead::Byte { value: widen_u8_to_i32(value) }
    }

    machine end() -> ByteRead { ByteRead::Eof }

    machine failed() -> ByteRead { crash Trap; }
}

// Descriptor 1 is stdout.
machine windows_console_write_byte(byte: i32)
reaches Console
invokes WindowsConsoleIo
{
    let mut cell: i32 = byte;
    let mode: i32 = WindowsConsoleIo::set_mode(1, 32768);
    let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
}

WindowsConsoleBytes satisfies ConsoleByteOperations {
    ConsoleByteOperations::read_byte = windows_console_read_byte;
    ConsoleByteOperations::write_byte = windows_console_write_byte;
    machine exit_process(return_code: i32) reaches Console {
        WindowsConsoleExit::exit_process(return_code);
    }
}
