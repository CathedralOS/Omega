use console;
use native::hosted;

// Checked Windows Console adapters over the package's explicit DLL bindings.
// Exit uses the canonical Console semantic leaf and its public requirement's
// native backing, preserving completion rather than inventing a private promise.
//
// Windows has no stable syscall ABI, so every leaf realizes through DLL
// linkage. Byte I/O uses the MSVCRT descriptor calls, which are unbuffered:
//   `int _write(int fd, const void *buffer, unsigned int count)`
//   `int _read(int fd, void *buffer, unsigned int count)`
// Both return the byte count moved, `_read` returns 0 at end of input, and both
// return -1 on failure. Each call moves one byte through the low byte of an
// i32 cell (x86-64 is little-endian), so the cell's upper bytes stay zero.
// Process termination is kernel32's `ExitProcess`; nothing is buffered above
// it, so no output is lost at exit.
use omega::language::core::external_binding;
use omega::language::core::numeric_conversion;


// A console read waits for host input, so the import publishes `blocks`.


// MSVCRT descriptors open in text mode, which translates CR LF pairs to a
// single LF on reads, maps LF to CR LF on writes, and ends input at Ctrl+Z.
// The console contract moves the authored bytes themselves, so read_byte and
// write_byte put their descriptor in binary mode (`_O_BINARY`, 0x8000) before
// moving data. `_setmode` is idempotent; calling it per operation keeps the
// guarantee local to this provider with no separate descriptor-init hook.
//   `int _setmode(int fd, int mode)`


// Descriptor 0 is stdin. One byte is a Byte, zero bytes is end of input, and
// -1 is a failed host read. The named trapping conversion rejects that
// negative status under the published `crashes Trap` contract.


// Descriptor 1 is stdout.


boundary trait WindowsConsoleIo {
    machine write(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    reaches Console;
    machine read(descriptor: i32, buffer: &mut i32, count: u32) -> i32
    reaches Console
    blocks;
    machine set_mode(descriptor: i32, mode: i32) -> i32
    reaches Console;
}

WindowsConsole satisfies Console {
    machine write_line(text: &[u8]) reaches Console {
        console_write_bytes<WindowsConsole::write_byte>(text, true);
    }

    machine write(text: &[u8]) reaches Console {
        console_write_bytes<WindowsConsole::write_byte>(text, false);
    }

    machine read_line(out_line: &mut [u8]) -> LineReadResult
    reaches Console blocks; crashes Trap {
        block console_read_line<WindowsConsole::read_byte>(out_line)
    }

    machine read_byte() -> ByteRead
    reaches Console
    blocks;
    crashes Trap
    {
        let mut cell: i32 = 0;
        let mode: i32 = WindowsConsoleIo::set_mode(0, 32768);
        let count: i32 = block WindowsConsoleIo::read(0, &mut cell, 1);
        transition count {
            1 -> byte(cell)
            0 -> end()
            _ -> failed(count)
        }

        machine byte(cell: i32) -> ByteRead {
            let value: u8 = narrow_i32_to_u8_wrapping(cell);
            ByteRead::Byte { value: value as i32 }
        }

        machine end() -> ByteRead { ByteRead::Eof }

        machine failed(count: i32) -> ByteRead {
            let trapped: u8 = narrow_i32_to_u8_trapping(count);
            ByteRead::Eof
        }
    }

    machine write_byte(byte: i32)
    reaches Console
    {
        let mut cell: i32 = byte;
        let mode: i32 = WindowsConsoleIo::set_mode(1, 32768);
        let written: i32 = WindowsConsoleIo::write(1, &mut cell, 1);
    }

    machine exit_process(return_code: i32) reaches Console {
        native::hosted::console_exit_process(return_code);
    }
}
