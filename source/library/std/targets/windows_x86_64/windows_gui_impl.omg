windows_x86_64 machine WindowsGuiNativeProvider::pump_message(message: &mut WindowsMessage) -> bool
satisfies WindowsGuiHost::pump_message
reaches WindowsGuiHost {
    let answer: i32 = WindowsGuiIo::peek_message(message, 0, 0, 0, 1);
    transition answer != 0 { true -> dispatch(message) _ -> (false) }
    state dispatch(message: &WindowsMessage) -> bool {
        let translated: i32 = WindowsGuiIo::translate_message(message);
        let result: i64 = WindowsGuiIo::dispatch_message(message);
        true
    }
}
windows_x86_64 machine WindowsGuiNativeProvider::provider_defaults(defaults: &mut WindowsGuiNativeProvider) {
    WindowsGuiNativeProvider::select_provider<WindowsGuiHost, WindowsGuiNativeProvider>(defaults);
    WindowsGuiNativeProvider::select_provider<WindowsGuiIo::create_window, WindowsGuiImports>(defaults);
    WindowsGuiNativeProvider::select_provider<WindowsGuiIo::foreground_window, WindowsGuiImports>(defaults);
    WindowsGuiNativeProvider::select_provider<WindowsGuiIo::is_window, WindowsGuiImports>(defaults);
    WindowsGuiNativeProvider::select_provider<WindowsGuiIo::destroy_window, WindowsGuiImports>(defaults);
    WindowsGuiNativeProvider::select_provider<WindowsGuiIo::peek_message, WindowsGuiImports>(defaults);
    WindowsGuiNativeProvider::select_provider<WindowsGuiIo::translate_message, WindowsGuiImports>(defaults);
    WindowsGuiNativeProvider::select_provider<WindowsGuiIo::dispatch_message, WindowsGuiImports>(defaults);
    WindowsGuiNativeProvider::select_provider<WindowsGuiIo::adjust_rectangle, WindowsGuiImports>(defaults);
}

