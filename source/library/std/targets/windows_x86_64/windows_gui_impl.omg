// Stateless Win64 user32 adapters. CreateWindowExA receives the caller's
// NUL-terminated class/title and ordinary geometry; optional owner, menu,
// instance and creation-data pointers are NULL for these standalone windows.
// The source caller retains the native HWND and the aligned MSG allocation.
// Client sizing uses the same native frame metrics as CreateWindowExA.
// Drawing lends live bitmap storage synchronously; its caller releases the HDC
// on the acquiring thread before destroying its window.

// The leaf requirements below carry no source realization: each one is a
// package-owned boundary row whose DLL locator lives in `std/build.omg`
// (`Build::bind<WindowsGuiIo::...>` / `Build::bind<WindowsGuiHost::...>`).
// Providers invoke the trait members directly and publish that synchronous
// edge through `invokes`, which the portable `WindowsGuiHost` requirements
// echo in their own ceilings.
boundary trait WindowsGuiIo {
    machine create_window(extended_style: u32, class_name: &u8, title: &u8, style: u32, x: i32, y: i32, width: i32, height: i32, parent: u64, menu: u64, instance: u64, creation_data: u64) -> u64
    reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit;
    machine foreground_window() -> u64
    reaches WindowManagement;
    machine is_window(window: u64) -> i32
    reaches WindowManagement;
    machine destroy_window(window: u64) -> i32
    reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit;
    machine peek_message(message: &mut WindowsMessage, window: u64, minimum: u32, maximum: u32, remove: u32) -> i32
    reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit;
    machine translate_message(message: &WindowsMessage) -> i32
    reaches WindowEventDispatch;
    machine dispatch_message(message: &WindowsMessage) -> i64
    reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit;
    machine key_state(virtual_key: u32) -> i32
    reaches GlobalInputObservation;
    machine adjust_rectangle(rectangle: &mut WindowsRectangle, style: u32, menu: i32, extended_style: u32) -> i32
    reaches WindowManagement;
}
public data WindowsGuiNativeProvider { }

windows_x86_64 machine WindowsGuiNativeProvider::key_state(virtual_key: u32) -> u64
satisfies WindowsGuiHost::key_state
reaches GlobalInputObservation
invokes WindowsGuiIo {
    // SHORT's high bit marks the key down; the low-bit pressed-latch is noise
    // for a live-state query and is dropped by the mask.
    let raw: i32 = WindowsGuiIo::key_state(virtual_key);
    transition (raw & 32768) != 0 { true -> (1) _ -> (0) }
}

windows_x86_64 machine WindowsGuiNativeProvider::window_create(class_name: &[u8], title: &[u8], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64
satisfies WindowsGuiHost::window_create
reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit
invokes WindowsGuiIo {
    transition class_name.len > 0 && title.len > 0 {
        true -> terminated(class_name, title, style, x, y, width, height)
        _ -> (0)
    }
    machine terminated(class_name: &[u8], title: &[u8], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64
    requires class_name.len > 0 && title.len > 0 {
        transition class_name[class_name.len - 1] == 0 && title[title.len - 1] == 0 {
            true -> (WindowsGuiIo::create_window(0, &class_name[0], &title[0], style, x, y, width, height, 0, 0, 0, 0))
            _ -> (0)
        }
    }
}
windows_x86_64 machine WindowsGuiNativeProvider::foreground_window() -> u64
satisfies WindowsGuiHost::foreground_window
reaches WindowManagement
invokes WindowsGuiIo {
    WindowsGuiIo::foreground_window()
}
windows_x86_64 machine WindowsGuiNativeProvider::is_window(window: u64) -> bool
satisfies WindowsGuiHost::is_window
reaches WindowManagement
invokes WindowsGuiIo {
    let answer: i32 = WindowsGuiIo::is_window(window);
    answer != 0
}
windows_x86_64 machine WindowsGuiNativeProvider::window_destroy(window: u64) -> bool
satisfies WindowsGuiHost::window_destroy
reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit
invokes WindowsGuiIo {
    let answer: i32 = WindowsGuiIo::destroy_window(window);
    answer != 0
}
windows_x86_64 machine WindowsGuiNativeProvider::pump_message(message: &mut WindowsMessage) -> bool
satisfies WindowsGuiHost::pump_message
reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit
invokes WindowsGuiIo {
    let answer: i32 = WindowsGuiIo::peek_message(message, 0, 0, 0, 1);
    transition answer != 0 { true -> dispatch(message) _ -> (false) }
    machine dispatch(message: &WindowsMessage) -> bool {
        let translated: i32 = WindowsGuiIo::translate_message(message);
        let result: i64 = WindowsGuiIo::dispatch_message(message);
        true
    }
}
windows_x86_64 machine WindowsGuiNativeProvider::provider_defaults(defaults: &mut WindowsGuiNativeProvider) {
    WindowsGuiNativeProvider::select_provider<WindowsGuiHost, NativeWindowsGui>(defaults);
}

// The four device-context requirements carry their own `Build::bind` rows in
// `std/build.omg`; the boundary declarations below are the provider rows the
// `NativeWindowsGui` map forwards to.
windows_x86_64 boundary machine WindowsGuiNativeProvider::get_dc(window: u64) -> u64
satisfies WindowsGuiHost::get_dc;

windows_x86_64 boundary machine WindowsGuiNativeProvider::release_dc(window: u64, device: u64) -> i32
satisfies WindowsGuiHost::release_dc;

windows_x86_64 boundary machine WindowsGuiNativeProvider::client_rectangle(window: u64, rectangle: &mut WindowsRectangle) -> i32
satisfies WindowsGuiHost::client_rectangle;

windows_x86_64 boundary machine WindowsGuiNativeProvider::stretch_dibits(device: u64, destination_x: i32, destination_y: i32, destination_width: i32, destination_height: i32, source_x: i32, source_y: i32, source_width: i32, source_height: i32, pixels: &i32, info: &i32, usage: u32, raster_operation: u32) -> i32
satisfies WindowsGuiHost::stretch_dibits;

windows_x86_64 machine WindowsGuiNativeProvider::window_create_client(class_name: &[u8], title: &[u8], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64
satisfies WindowsGuiHost::window_create_client
reaches
    NativeCodeExecution + WindowManagement + SurfacePresentation +
    WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
    ClockObservation + ExecutionDelay + FilesystemContentRead +
    FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
    DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
    ProcessOutput + ProcessExit
invokes WindowsGuiIo {
    let mut rectangle: WindowsRectangle = WindowsRectangle { left: 0, top: 0, right: width, bottom: height };
    let adjusted: i32 = WindowsGuiIo::adjust_rectangle(&mut rectangle, style, 0, 0);
    let outer_width: i64 = (rectangle.right as i64) - (rectangle.left as i64);
    let outer_height: i64 = (rectangle.bottom as i64) - (rectangle.top as i64);
    transition adjusted != 0 && width > 0 && height > 0
        && outer_width > 0 && outer_width <= 0x7fff_ffff
        && outer_height > 0 && outer_height <= 0x7fff_ffff {
        true -> create(class_name, title, style, x, y, outer_width, outer_height)
        _ -> (0)
    }
    machine create(class_name: &[u8], title: &[u8], style: u32, x: i32, y: i32, width: i64, height: i64) -> u64
    requires width > 0 && width <= 0x7fff_ffff && height > 0 && height <= 0x7fff_ffff {
        WindowsGuiNativeProvider::window_create(class_name, title, style, x, y, width as i32, height as i32)
    }
}

// Complete explicit provider map; members forward to the existing native adapters.
NativeWindowsGui satisfies WindowsGuiHost {
    machine window_create(class_name: &[u8], title: &[u8], style: u32,
        x: i32, y: i32, width: i32, height: i32) -> u64 reaches
            NativeCodeExecution + WindowManagement + SurfacePresentation +
            WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
            ClockObservation + ExecutionDelay + FilesystemContentRead +
            FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
            DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
            ProcessOutput + ProcessExit {
        WindowsGuiNativeProvider::window_create(class_name, title, style, x, y, width, height)
    }
    machine foreground_window() -> u64 reaches WindowManagement {
        WindowsGuiNativeProvider::foreground_window()
    }
    machine is_window(window: u64) -> bool reaches WindowManagement {
        WindowsGuiNativeProvider::is_window(window)
    }
    machine window_destroy(window: u64) -> bool reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit {
        WindowsGuiNativeProvider::window_destroy(window)
    }
    machine pump_message(message: &mut WindowsMessage) -> bool reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit {
        WindowsGuiNativeProvider::pump_message(message)
    }
    machine get_dc(window: u64) -> u64 reaches
        SurfacePresentation + FilesystemContentRead + FilesystemContentWrite +
        FilesystemMetadataQuery + FilesystemMetadataMutation + DirectoryEnumeration +
        FilesystemNamespaceMutation {
        WindowsGuiNativeProvider::get_dc(window)
    }
    machine release_dc(window: u64, device: u64) -> i32 reaches
        SurfacePresentation + FilesystemContentRead + FilesystemContentWrite +
        FilesystemMetadataQuery + FilesystemMetadataMutation + DirectoryEnumeration +
        FilesystemNamespaceMutation {
        WindowsGuiNativeProvider::release_dc(window, device)
    }
    machine client_rectangle(window: u64, rectangle: &mut WindowsRectangle) -> i32 reaches WindowManagement {
        WindowsGuiNativeProvider::client_rectangle(window, rectangle)
    }
    machine stretch_dibits(device: u64, destination_x: i32, destination_y: i32,
        destination_width: i32, destination_height: i32, source_x: i32, source_y: i32,
        source_width: i32, source_height: i32, pixels: &i32, info: &i32,
        usage: u32, raster_operation: u32) -> i32 reaches
            SurfacePresentation + FilesystemContentRead + FilesystemContentWrite +
            FilesystemMetadataQuery + FilesystemMetadataMutation + DirectoryEnumeration +
            FilesystemNamespaceMutation {
        WindowsGuiNativeProvider::stretch_dibits(device, destination_x, destination_y, destination_width, destination_height, source_x, source_y, source_width, source_height, pixels, info, usage, raster_operation)
    }
    machine window_create_client(class_name: &[u8], title: &[u8], style: u32,
        x: i32, y: i32, width: i32, height: i32) -> u64 reaches
            NativeCodeExecution + WindowManagement + SurfacePresentation +
            WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
            ClockObservation + ExecutionDelay + FilesystemContentRead +
            FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
            DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
            ProcessOutput + ProcessExit {
        WindowsGuiNativeProvider::window_create_client(class_name, title, style, x, y, width, height)
    }
    machine key_state(virtual_key: u32) -> u64 reaches GlobalInputObservation {
        WindowsGuiNativeProvider::key_state(virtual_key)
    }
}
