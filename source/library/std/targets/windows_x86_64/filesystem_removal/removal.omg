// Recursive removal entrance: acquire one no-follow root, inspect that exact
// object, then walk retained parent handles. A reparse root is refused; child
// reparse objects are deleted as leaves, never traversed. Success includes
// disposing and closing every owned handle, including the root. Failures keep
// the first native error while releasing the remaining private handles once.
use filesystem_host;
use omega::language::core::filesystem_authority;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_private_handles;
use targets::windows_x86_64::filesystem_removal::acquisition;
use targets::windows_x86_64::filesystem_removal::attributes;
use targets::windows_x86_64::filesystem_removal::completion;
use targets::windows_x86_64::filesystem_removal::traversal;

windows_x86_64 machine windows_remove_tree(path: &[u8] in Path) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery + DirectoryEnumeration {
    let root: i64 in WindowsPrivateNonalertFileOrAbsent = block windows_removal_open_root(path);
    transition root != 0 { true -> inspect(root) false -> failed() }
    machine failed() -> i32 {
        windows_removal_status(windows_removal_error(WindowsFilesystemIo::c_get_last_error()))
    }
    machine inspect(root: i64 in WindowsPrivateNonalertFileOrAbsent) -> i32
    requires root != 0 {
        let information: WindowsRemovalAttributes = block windows_removal_attributes(root);
        transition information {
            WindowsRemovalAttributes::Error { code } -> refuse(root, code)
            WindowsRemovalAttributes::Value { attributes } -> kind(root, attributes)
        }
    }
    machine kind(root: i64 in WindowsPrivateNonalertFileOrAbsent, attributes: u32) -> i32
    requires root != 0 {
        transition (attributes & 16) != 0 && (attributes & 1024) == 0 {
            true -> walk(root)
            false -> refuse(root, 267)
        }
    }
    machine refuse(root: i64 in WindowsPrivateNonalertFileOrAbsent, code: u32) -> i32
    requires root != 0 {
        let failure: u32 = block windows_removal_close(root, windows_removal_error(code));
        windows_removal_status(failure)
    }
    machine walk(root: i64 in WindowsPrivateNonalertFileOrAbsent) -> i32
    requires root != 0 {
        let code: u32 = block windows_removal_walk(root);
        windows_removal_status(code)
    }
}
