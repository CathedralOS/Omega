// Dispose the exact opened object, then release that handle once. Namespace
// mutation includes the close which commits a pending disposition; ordinary
// empty-release authority is neither assumed nor manufactured here. The first
// error wins over later unwind errors, and CloseHandle is never retried.
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_private_handles;
use targets::windows_x86_64::filesystem_removal::native;

machine windows_removal_error(code: u32) -> u32 {
    transition code != 0 { true -> (code) false -> 31 }
}

machine windows_removal_status(code: u32) -> i32 {
    transition code == 0 { true -> 0 false -> failed(code) }
    machine failed(code: u32) -> i32 {
        transition code <= 2147483647 {
            true -> (narrow_i64_to_i32_wrapping(0 - widen_u32_to_i64(code)))
            false -> (-31)
        }
    }
}

windows_x86_64 machine windows_removal_close(handle: i64 in WindowsPrivateNonalertFileOrAbsent,
    original: u32) -> u32
requires handle != 0
reaches FilesystemNamespaceMutation {
    let closed: i32 = block WindowsFilesystemRemovalIo::close(handle);
    transition original != 0 {
        true -> (original)
        false -> completion(closed)
    }
    machine completion(closed: i32) -> u32 {
        transition closed != 0 {
            true -> 0
            false -> (windows_removal_error(WindowsFilesystemIo::c_get_last_error()))
        }
    }
}

windows_x86_64 machine windows_removal_dispose(handle: i64 in WindowsPrivateNonalertFileOrAbsent) -> u32
requires handle != 0
reaches FilesystemNamespaceMutation {
    let disposition: WindowsNativeFileDisposition = WindowsNativeFileDisposition { delete: 1 };
    let succeeded: i32 = block WindowsFilesystemRemovalIo::dispose(handle, 4, &disposition, 1);
    transition succeeded != 0 {
        true -> block windows_removal_close(handle, 0)
        false -> failed(handle)
    }
    machine failed(handle: i64 in WindowsPrivateNonalertFileOrAbsent) -> u32 requires handle != 0 {
        let code: u32 = windows_removal_error(WindowsFilesystemIo::c_get_last_error());
        block windows_removal_close(handle, code)
    }
}
