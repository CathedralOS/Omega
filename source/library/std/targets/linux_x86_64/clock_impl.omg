// linux_x86_64 `Clock` provider closure over the kernel `nanosleep` leaf
// (linux_x86_64 `nanosleep` is 35). This leg does not sleep yet: normalized
// syscall plans place each leaf parameter straight into a syscall register
// (`evaluate_syscall` in `calling-conventions/src/plans/call_plan_evaluation.rs`),
// so the millisecond count reaches `nanosleep` as its `timespec*` request
// pointer and the call fails instead of blocking. No compiler-owned timespec
// marshalling exists; see the marshalled-syscall question in
// OWNER_QUESTIONS.md.
linux_x86_64 machine ClockNativeProvider::sleep(milliseconds: u32)
    satisfies Clock::sleep
    via ForeignBinding::Syscall(35);

linux_x86_64 machine ClockNativeProvider::provider_defaults(defaults: &mut ClockNativeProvider) {
    defaults.select_provider<Clock, ClockNativeProvider>();
}
