use omega::language::core::filesystem_authority;
// Linux POSIX filesystem service over direct system calls. The kernel
// already returns the negated `errno` on failure, which is the trait's own
// convention, so adapters pass results through. Paths are terminated into
// local buffers; ordinary transfers lend caller byte-view backing directly.
// The kernel-shaped requirements are declared once here; linux_arm64
// satisfies the same requirements with its own system call numbers.
use omega::language::core::external_binding;
use posix_filesystem_host;
use math;
use calling;
use posix_byte_view_calling;

// This native requirement application fixes its kernel calling convention.
boundary trait PosixFilesystemLinuxX86ByteViews: Calling<LinuxX86ByteViewCalling> {
    machine read(fd: i32, buffer: &mut [u8]) -> i64 reaches FilesystemContentRead;
    machine write(fd: i32, bytes: &[u8]) -> i64 reaches FilesystemContentWrite;
    machine pread64(fd: i32, buffer: &mut [u8], offset: i64) -> i64 reaches FilesystemContentRead;
    machine pwrite64(fd: i32, bytes: &[u8], offset: i64) -> i64 reaches FilesystemContentWrite;
    machine readlinkat(dirfd: i32, path: &[u8; 4096], buffer: &mut [u8]) -> i64 reaches FilesystemMetadataQuery;
    machine getdents64(fd: i32, buffer: &mut [u8]) -> i64 reaches DirectoryEnumeration;
}

use filesystem_host;

// requirement namespace for the system calls
data PosixFilesystemLinuxSyscalls { }

boundary trait PosixFilesystemLinux {
    machine openat(dirfd: i32, path: &u8, flags: i32, mode: i32) -> i32
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation;

    machine close(fd: i32) -> i32 reaches;

    machine lseek(fd: i32, offset: i64, whence: i32) -> i64 reaches;

    machine mkdirat(dirfd: i32, path: &u8, mode: i32) -> i32
    reaches FilesystemMetadataMutation + FilesystemNamespaceMutation;

    machine unlinkat(dirfd: i32, path: &u8, flags: i32) -> i32
    reaches FilesystemNamespaceMutation;

    machine fchmodat(dirfd: i32, path: &u8, mode: u32) -> i32
    reaches FilesystemMetadataMutation;

    machine fchmod(fd: i32, mode: u32) -> i32
    reaches FilesystemMetadataMutation;

    machine renameat(from_dirfd: i32, from: &u8, to_dirfd: i32, to: &u8) -> i32
    reaches FilesystemNamespaceMutation;

    machine linkat(from_dirfd: i32, from: &u8, to_dirfd: i32, to: &u8, flags: i32) -> i32
    reaches FilesystemNamespaceMutation;

    machine symlinkat(target: &u8, link_dirfd: i32, link: &u8) -> i32
    reaches FilesystemNamespaceMutation;

    machine newfstatat(dirfd: i32, path: &u8, buffer: &mut u8, flags: i32) -> i32
    reaches FilesystemMetadataQuery;

    machine fstat(fd: i32, buffer: &mut u8) -> i32
    reaches FilesystemMetadataQuery;

    machine ftruncate(fd: i32, length: i64) -> i32
    reaches FilesystemContentWrite + FilesystemMetadataMutation;

    machine utimensat(dirfd: i32, path: u64, times: &u8, flags: i32) -> i32
    reaches FilesystemMetadataMutation;

    machine fsync(fd: i32) -> i32 reaches;

    machine fdatasync(fd: i32) -> i32 reaches;

    machine dup(fd: i32) -> i32 reaches;

    machine flock(fd: i32, operation: i32) -> i32 reaches;

    machine fchownat(dirfd: i32, path: &u8, uid: i32, gid: i32, flags: i32) -> i32
    reaches FilesystemMetadataMutation;

    machine fchown(fd: i32, uid: i32, gid: i32) -> i32
    reaches FilesystemMetadataMutation;
}

LinuxX86PosixFilesystem satisfies PosixFilesystemHost {
    machine open(path: &[u8] in Path, flags: i32) -> i32
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::openat(-100, &terminated[0], flags, 0);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine open_create(path: &[u8] in Path, flags: i32, mode: i32) -> i32
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::openat(-100, &terminated[0], flags, mode);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine create(path: &[u8] in Path, mode: i32) -> i32
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::openat(-100, &terminated[0], 577, mode);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine read(fd: i32, buffer: &mut [u8], count: u64) -> i64
    reaches FilesystemContentRead
    {
        let capacity: u64 = min_u64(count, buffer.len);
        PosixFilesystemLinuxX86ByteViews::read(fd, &mut buffer[0..capacity])
    }

    machine write(fd: i32, bytes: &[u8]) -> i64
    reaches FilesystemContentWrite
    {
        PosixFilesystemLinuxX86ByteViews::write(fd, bytes)
    }

    machine read_at(fd: i32, buffer: &mut [u8], count: u64, offset: i64) -> i64
    reaches FilesystemContentRead
    {
        let capacity: u64 = min_u64(count, buffer.len);
        PosixFilesystemLinuxX86ByteViews::pread64(fd, &mut buffer[0..capacity], offset)
    }

    machine write_at(fd: i32, bytes: &[u8], offset: i64) -> i64
    reaches FilesystemContentWrite
    {
        PosixFilesystemLinuxX86ByteViews::pwrite64(fd, bytes, offset)
    }

    machine close(fd: i32) -> i32
    {
        let outcome: i32 = PosixFilesystemLinux::close(fd);
        outcome
    }

    machine remove(path: &[u8] in Path) -> i32
    reaches FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::unlinkat(-100, &terminated[0], 0);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine seek(fd: i32, offset: i64, whence: i32) -> i64
    {
        let outcome: i64 = PosixFilesystemLinux::lseek(fd, offset, whence);
        outcome
    }

    machine create_dir(path: &[u8] in Path, mode: i32) -> i32
    reaches FilesystemMetadataMutation + FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::mkdirat(-100, &terminated[0], mode);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine remove_dir(path: &[u8] in Path) -> i32
    reaches FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::unlinkat(-100, &terminated[0], 512);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine create_dir_name(name: &[u8], mode: i32) -> i32
    reaches FilesystemMetadataMutation + FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(name, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::mkdirat(-100, &terminated[0], mode);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine open_at(dirfd: i32, name: &[u8], flags: i32) -> i32
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(name, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::openat(dirfd, &terminated[0], flags, 0);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine unlink_at(dirfd: i32, name: &[u8], flags: i32) -> i32
    reaches FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(name, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::unlinkat(dirfd, &terminated[0], flags);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine set_permissions(path: &[u8] in Path, mode: u32) -> i32
    reaches FilesystemMetadataMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::fchmodat(-100, &terminated[0], mode);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine set_file_permissions(fd: i32, mode: u32) -> i32
    reaches FilesystemMetadataMutation
    {
        let outcome: i32 = PosixFilesystemLinux::fchmod(fd, mode);
        outcome
    }

    machine rename(from: &[u8] in Path, to: &[u8] in Path) -> i32
    reaches FilesystemNamespaceMutation
    {
        let mut first: [u8; 4096];
        let mut second: [u8; 4096];
        let first_fits: bool = posix_terminated_path(from, &mut first);
        let second_fits: bool = posix_terminated_path(to, &mut second);
        let outcome: i32 = PosixFilesystemLinux::renameat(-100, &first[0], -100, &second[0]);
        transition first_fits && second_fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine hard_link(original: &[u8] in Path, link: &[u8] in Path) -> i32
    reaches FilesystemNamespaceMutation
    {
        let mut first: [u8; 4096];
        let mut second: [u8; 4096];
        let first_fits: bool = posix_terminated_path(original, &mut first);
        let second_fits: bool = posix_terminated_path(link, &mut second);
        let outcome: i32 = PosixFilesystemLinux::linkat(-100, &first[0], -100, &second[0], 0);
        transition first_fits && second_fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine symlink(target: &[u8] in Path, link: &[u8] in Path) -> i32
    reaches FilesystemNamespaceMutation
    {
        let mut first: [u8; 4096];
        let mut second: [u8; 4096];
        let first_fits: bool = posix_terminated_path(target, &mut first);
        let second_fits: bool = posix_terminated_path(link, &mut second);
        let outcome: i32 = PosixFilesystemLinux::symlinkat(&first[0], -100, &second[0]);
        transition first_fits && second_fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine read_link(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> i64
    reaches FilesystemMetadataQuery
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        transition fits { true -> transfer(terminated, buffer, count) _ -> -36 }
        machine transfer(terminated: [u8; 4096], buffer: &mut [u8], count: u64) -> i64 {
            // readlinkat's bufsiz is a signed int, not an arbitrary staging limit.
            let capacity: u64 = min_u64(min_u64(count, buffer.len), 2147483647);
            PosixFilesystemLinuxX86ByteViews::readlinkat(-100, &terminated, &mut buffer[0..capacity])
        }
    }

    machine read_dir(fd: i32, buffer: &mut [u8], count: u64, position: &mut i64) -> i64
    reaches DirectoryEnumeration
    {
        // The directory callback's remaining-count field is a signed int.
        let capacity: u64 = min_u64(min_u64(count, buffer.len), 2147483647);
        PosixFilesystemLinuxX86ByteViews::getdents64(fd, &mut buffer[0..capacity])
    }

    machine remove_name(path: &[u8]) -> i32
    reaches FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::unlinkat(-100, &terminated[0], 0);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine remove_dir_name(path: &[u8]) -> i32
    reaches FilesystemNamespaceMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::unlinkat(-100, &terminated[0], 512);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine read_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32
    reaches FilesystemMetadataQuery
    {
        LinuxX86PosixFilesystem::read_metadata_at(-100, path, buffer, 0)
    }

    machine read_file_metadata(fd: i32, buffer: &mut [u8]) -> i32
    reaches FilesystemMetadataQuery
    {
        transition buffer.len >= 144 { true -> query(fd, buffer) _ -> -22 }
        machine query(fd: i32, buffer: &mut [u8]) -> i32 requires buffer.len >= 144; {
            PosixFilesystemLinux::fstat(fd, &mut buffer[0])
        }
    }

    machine read_symlink_metadata(path: &[u8] in Path, buffer: &mut [u8]) -> i32
    reaches FilesystemMetadataQuery
    {
        LinuxX86PosixFilesystem::read_metadata_at(-100, path, buffer, 256)
    }

    machine read_metadata_at(directory_descriptor: i32, name: &[u8], buffer: &mut [u8], flags: i32) -> i32
    reaches FilesystemMetadataQuery
    {
        transition buffer.len >= 144 { true -> prepare(directory_descriptor, name, buffer, flags) _ -> -22 }
        machine prepare(directory_descriptor: i32, name: &[u8], buffer: &mut [u8], flags: i32) -> i32
        requires buffer.len >= 144;
        {
            let mut terminated: [u8; 4096];
            let fits: bool = posix_terminated_path(name, &mut terminated);
            transition fits { true -> query(directory_descriptor, terminated, buffer, flags) _ -> -36 }
        }
        machine query(directory_descriptor: i32, terminated: [u8; 4096], buffer: &mut [u8], flags: i32) -> i32
        requires buffer.len >= 144;
        {
            PosixFilesystemLinux::newfstatat(directory_descriptor, &terminated[0], &mut buffer[0], flags)
        }
    }

    machine set_len(fd: i32, length: i64) -> i32
    reaches FilesystemContentWrite + FilesystemMetadataMutation
    {
        let outcome: i32 = PosixFilesystemLinux::ftruncate(fd, length);
        outcome
    }

    machine set_file_times(fd: i32, times: &[u8]) -> i32
    reaches FilesystemMetadataMutation
    {
        transition times.len >= 32 { true -> update(fd, times) _ -> -22 }
        machine update(fd: i32, times: &[u8]) -> i32 requires times.len >= 32; {
            // The raw syscall copies bytes from user storage, without a libc object.
            PosixFilesystemLinux::utimensat(fd, 0, &times[0], 0)
        }
    }

    machine sync(fd: i32) -> i32
    {
        let outcome: i32 = PosixFilesystemLinux::fsync(fd);
        outcome
    }

    machine sync_data(fd: i32) -> i32
    {
        let outcome: i32 = PosixFilesystemLinux::fdatasync(fd);
        outcome
    }

    machine duplicate(fd: i32) -> i32
    {
        let outcome: i32 = PosixFilesystemLinux::dup(fd);
        outcome
    }

    machine lock_file(fd: i32, operation: i32) -> i32
    {
        let outcome: i32 = PosixFilesystemLinux::flock(fd, operation);
        outcome
    }

    machine change_owner(path: &[u8] in Path, uid: i32, gid: i32) -> i32
    reaches FilesystemMetadataMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::fchownat(-100, &terminated[0], uid, gid, 0);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine change_owner_no_follow(path: &[u8] in Path, uid: i32, gid: i32) -> i32
    reaches FilesystemMetadataMutation
    {
        let mut terminated: [u8; 4096];
        let fits: bool = posix_terminated_path(path, &mut terminated);
        let outcome: i32 = PosixFilesystemLinux::fchownat(-100, &terminated[0], uid, gid, 256);
        transition fits {
            true -> settle(outcome)
            _ -> (-36)
        }

        machine settle(outcome: i32) -> i32 {
            outcome
        }
    }

    machine change_file_owner(fd: i32, uid: i32, gid: i32) -> i32
    reaches FilesystemMetadataMutation
    {
        let outcome: i32 = PosixFilesystemLinux::fchown(fd, uid, gid);
        outcome
    }
}
