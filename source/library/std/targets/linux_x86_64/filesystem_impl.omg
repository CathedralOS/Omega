// Linux x86-64 ABI facts; the POSIX algorithms live in the shared adapter.
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::LayoutTarget;
use omega::language::core::LayoutStorage;
use omega::language::core::FixedLayout;
use omega::language::core::narrow_i64_to_u64_exact;

StatLayout satisfies FixedLayout<StatRecord> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan
    reaches none
    terminates {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, representation: FieldPlan::At { offset: 24 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, representation: FieldPlan::At { offset: 16 } };
    entries[3] = FieldEntry { key: schema.fields[3].key, representation: FieldPlan::At { offset: 8 } };
    entries[4] = FieldEntry { key: schema.fields[4].key, representation: FieldPlan::At { offset: 28 } };
    entries[5] = FieldEntry { key: schema.fields[5].key, representation: FieldPlan::At { offset: 32 } };
    entries[6] = FieldEntry { key: schema.fields[6].key, representation: FieldPlan::At { offset: 40 } };
    entries[7] = FieldEntry { key: schema.fields[7].key, representation: FieldPlan::At { offset: 72 } };
    entries[8] = FieldEntry { key: schema.fields[8].key, representation: FieldPlan::At { offset: 88 } };
    entries[9] = FieldEntry { key: schema.fields[9].key, representation: FieldPlan::At { offset: 104 } };
    entries[10] = FieldEntry { key: schema.fields[10].key, representation: FieldPlan::At { offset: 48 } };
    entries[11] = FieldEntry { key: schema.fields[11].key, representation: FieldPlan::At { offset: 64 } };
    entries[12] = FieldEntry { key: schema.fields[12].key, representation: FieldPlan::At { offset: 56 } };
    LayoutPlan { entries: entries, entry_count: 13, size_fixed: 144, size_is_dynamic: false, align: 8 }
}
}

machine linux_x86_64_posix_encode_open_options(filesystem: &mut PosixFilesystem)
    satisfies PosixFilesystemTarget::encode_open_options {
    filesystem.open_writable = (filesystem.open_options.write as i32) | (filesystem.open_options.append as i32);
    filesystem.open_readable = filesystem.open_options.read as i32;
    filesystem.open_creating = (filesystem.open_options.create as i32) | (filesystem.open_options.create_new as i32);
    filesystem.open_flags = ((filesystem.open_writable & (filesystem.open_readable ^ 1))
        | ((filesystem.open_writable & filesystem.open_readable) << 1)
        | ((filesystem.open_options.append as i32) << 10)
        | (filesystem.open_creating << 6)
        | ((filesystem.open_options.truncate as i32) << 9)
        | ((filesystem.open_options.create_new as i32) << 7));
}

data StatRecord {
    dev: u64;
    mode: u32;
    nlink: u64;
    ino: u64;
    uid: u32;
    gid: u32;
    rdev: u64;
    atime: i64;
    mtime: i64;
    ctime: i64;
    size: i64;
    blocks: i64;
    blksize: i64;
}

data StatView {
    value: LayoutStorage<StatRecord, StatLayout>;
}

machine linux_x86_64_posix_decode_metadata(filesystem: &mut PosixFilesystem) -> MetadataResult
    satisfies PosixFilesystemTarget::decode_metadata {
    let stat: &StatView = &filesystem.stat_buf[0] as &StatView;
    let blocks: i64 = stat.value.blocks;
    let blksize: i64 = stat.value.blksize;
    transition blocks >= 0 && blksize >= 0 {
        true -> decode(stat, blocks, blksize)
        _ -> MetadataResult::Error { kind: ErrorKind::InvalidInput }
    }
    machine decode(stat: &StatView, block_count: i64, block_size: i64) -> MetadataResult
    requires block_count >= 0 && block_size >= 0
    {
        let mode: u32 = stat.value.mode;
        let nlink: u64 = stat.value.nlink;
        let ino: u64 = stat.value.ino;
        let uid: u32 = stat.value.uid;
        let gid: u32 = stat.value.gid;
        let dev: u64 = stat.value.dev;
        let rdev: u64 = stat.value.rdev;
        let ctime: i64 = stat.value.ctime;
        let blocks: u64 = narrow_i64_to_u64_exact(block_count);
        let blksize: u64 = narrow_i64_to_u64_exact(block_size);
        let len: i64 = stat.value.size;
        let mtime: i64 = stat.value.mtime;
        let atime: i64 = stat.value.atime;
        // Linux stat has reserved words here, not a birth timestamp.
        let details: PosixMetadata = PosixMetadata { mode: mode, ino: ino, dev: dev, uid: uid, gid: gid, rdev: rdev, blocks: blocks, blksize: blksize };
        let metadata: Metadata = Metadata { len: len, kind: posix_metadata_kind(mode), permissions: Permissions::Posix { mode: mode & 4095 }, nlink: nlink, posix: PosixMetadataResult::Ok { details: details }, modified_secs: mtime, accessed_secs: atime, creation_time: TimestampResult::Error { kind: ErrorKind::Unsupported }, changed_secs: ctime };
        MetadataResult::Ok { meta: metadata }
    }
}

machine linux_x86_64_posix_permission_bits(filesystem: &PosixFilesystem) -> u32
    satisfies PosixFilesystemTarget::permission_bits {
    let stat: &StatView = &filesystem.stat_buf[0] as &StatView;
    stat.value.mode & 4095
}

// Resolve an absent directory hint from the native mode without decoding
// unrelated size/timestamp fields or following a final symlink.
machine linux_x86_64_posix_decode_directory_kind(filesystem: &mut PosixFilesystem) -> PosixDirectoryKind
    satisfies PosixFilesystemTarget::decode_directory_kind {
    let stat: &StatView = &filesystem.stat_buf[0] as &StatView;
    let kind: u32 = stat.value.mode & 61440;
    transition kind {
        16384 -> PosixDirectoryKind::Directory
        32768 -> PosixDirectoryKind::Regular
        _ -> PosixDirectoryKind::Other
    }
}
machine linux_x86_64_posix_metadata_no_follow_flag() -> i32
    satisfies PosixFilesystemTarget::metadata_no_follow_flag { 256 }

machine linux_x86_64_posix_directory_type_offset() -> u64
    satisfies PosixFilesystemTarget::directory_type_offset
    ensures result >= 18 && result <= 20
{ 18 }
machine linux_x86_64_posix_directory_name_offset() -> u64
    satisfies PosixFilesystemTarget::directory_name_offset
    ensures result >= 19 && result <= 21
{ 19 }
machine linux_x86_64_posix_remove_directory_flag() -> i32
    satisfies PosixFilesystemTarget::remove_directory_flag { 512 }
machine linux_x86_64_posix_directory_descent_flags() -> i32
    satisfies PosixFilesystemTarget::directory_descent_flags { 196608 }

// The PosixCanonicalLibc requirements are bound in std's Build machine.

// Error numbers belong to this OS, not to a synthetic shared POSIX catalog.
machine linux_x86_64_posix_kind_of_stored_error_code(filesystem: &mut PosixFilesystem) -> ErrorKind
    satisfies PosixFilesystemTarget::kind_of_stored_error_code {
    filesystem.err_kind = match filesystem.err_code {
        2 -> ErrorKind::NotFound,
        13 -> ErrorKind::PermissionDenied,
        1 -> ErrorKind::PermissionDenied,
        17 -> ErrorKind::AlreadyExists,
        9 -> ErrorKind::BadDescriptor,
        21 -> ErrorKind::IsADirectory,
        11 -> ErrorKind::WouldBlock,
        22 -> ErrorKind::InvalidInput,
        34 -> ErrorKind::InvalidInput,
        36 -> ErrorKind::InvalidInput,
        38 -> ErrorKind::Unsupported,
        95 -> ErrorKind::Unsupported,
        _ -> ErrorKind::Other
    };
    error_kind_reconstruct(&filesystem.err_kind)
}

machine linux_x86_64_posix_would_block_error() -> i32
    satisfies PosixFilesystemTarget::would_block_error { 11 }

// The linux_x86_64 record layouts and constants. std's Build selects them for linux_x86_64.
LinuxX8664PosixFilesystemTarget satisfies PosixFilesystemTarget {
    PosixFilesystemTarget::encode_open_options = linux_x86_64_posix_encode_open_options;
    PosixFilesystemTarget::decode_metadata = linux_x86_64_posix_decode_metadata;
    PosixFilesystemTarget::permission_bits = linux_x86_64_posix_permission_bits;
    PosixFilesystemTarget::decode_directory_kind = linux_x86_64_posix_decode_directory_kind;
    PosixFilesystemTarget::metadata_no_follow_flag = linux_x86_64_posix_metadata_no_follow_flag;
    PosixFilesystemTarget::directory_type_offset = linux_x86_64_posix_directory_type_offset;
    PosixFilesystemTarget::directory_name_offset = linux_x86_64_posix_directory_name_offset;
    PosixFilesystemTarget::remove_directory_flag = linux_x86_64_posix_remove_directory_flag;
    PosixFilesystemTarget::directory_descent_flags = linux_x86_64_posix_directory_descent_flags;
    PosixFilesystemTarget::kind_of_stored_error_code = linux_x86_64_posix_kind_of_stored_error_code;
    PosixFilesystemTarget::would_block_error = linux_x86_64_posix_would_block_error;
}
