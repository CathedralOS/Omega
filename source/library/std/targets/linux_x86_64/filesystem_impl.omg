use omega::language::core::external_binding;
// Linux x86-64 ABI facts; the POSIX algorithms live in the shared adapter.
use omega::language::core::filesystem_authority;

use filesystem;
use posix_filesystem_adapter;
use posix_filesystem_host;
use filesystem_host;

linux_x86_64 machine StatLayout::plan(schema: Schema) -> Plan {
    let mut entries: [FieldEntry; 64];
    entries[0] = FieldEntry { key: schema.fields[0].key, placement: FieldPlan::At { offset: 0 } };
    entries[1] = FieldEntry { key: schema.fields[1].key, placement: FieldPlan::At { offset: 24 } };
    entries[2] = FieldEntry { key: schema.fields[2].key, placement: FieldPlan::At { offset: 16 } };
    entries[3] = FieldEntry { key: schema.fields[3].key, placement: FieldPlan::At { offset: 8 } };
    entries[4] = FieldEntry { key: schema.fields[4].key, placement: FieldPlan::At { offset: 28 } };
    entries[5] = FieldEntry { key: schema.fields[5].key, placement: FieldPlan::At { offset: 32 } };
    entries[6] = FieldEntry { key: schema.fields[6].key, placement: FieldPlan::At { offset: 40 } };
    entries[7] = FieldEntry { key: schema.fields[7].key, placement: FieldPlan::At { offset: 72 } };
    entries[8] = FieldEntry { key: schema.fields[8].key, placement: FieldPlan::At { offset: 88 } };
    entries[9] = FieldEntry { key: schema.fields[9].key, placement: FieldPlan::At { offset: 104 } };
    entries[10] = FieldEntry { key: schema.fields[10].key, placement: FieldPlan::At { offset: 120 } };
    entries[11] = FieldEntry { key: schema.fields[11].key, placement: FieldPlan::At { offset: 48 } };
    entries[12] = FieldEntry { key: schema.fields[12].key, placement: FieldPlan::At { offset: 64 } };
    entries[13] = FieldEntry { key: schema.fields[13].key, placement: FieldPlan::At { offset: 56 } };
    Plan { entries: entries, entry_count: 14, size_fixed: 144, size_is_dynamic: false, align: 8 }
}

linux_x86_64 machine PosixFilesystem::encode_open_options(filesystem: &mut PosixFilesystem) {
    filesystem.open_writable = (filesystem.open_options.write as i32) | (filesystem.open_options.append as i32);
    filesystem.open_readable = filesystem.open_options.read as i32;
    filesystem.open_creating = (filesystem.open_options.create as i32) | (filesystem.open_options.create_new as i32);
    filesystem.open_flags = ((filesystem.open_writable & (filesystem.open_readable ^ 1))
        | ((filesystem.open_writable & filesystem.open_readable) << 1)
        | ((filesystem.open_options.append as i32) << 10)
        | (filesystem.open_creating << 6)
        | ((filesystem.open_options.truncate as i32) << 9)
        | ((filesystem.open_options.create_new as i32) << 7));
}



data StatRecord {
    dev: u64;
    mode: u32;
    nlink: u64;
    ino: u64;
    uid: u32;
    gid: u32;
    rdev: u64;
    atime: i64;
    mtime: i64;
    ctime: i64;
    btime: i64;
    size: i64;
    blocks: u64;
    blksize: u64;
}

data StatLayout {}

data StatView {
    value: StatLayout<StatRecord>;
}

linux_x86_64 machine PosixFilesystem::decode_metadata(filesystem: &mut PosixFilesystem) -> Metadata {
    let stat: &StatView = &filesystem.stat_buf[0] as &StatView;
    let mode: u32 = stat.value.mode;
    let nlink: u64 = stat.value.nlink;
    let ino: u64 = stat.value.ino;
    let uid: u32 = stat.value.uid;
    let gid: u32 = stat.value.gid;
    let dev: u64 = stat.value.dev;
    let rdev: u64 = stat.value.rdev;
    let ctime: i64 = stat.value.ctime;
    let blocks: u64 = stat.value.blocks;
    let blksize: u64 = stat.value.blksize;
    let len: i64 = stat.value.size;
    let is_dir: bool = (mode & 61440) == 16384;
    let is_symlink: bool = (mode & 61440) == 40960;
    let mtime: i64 = stat.value.mtime;
    let atime: i64 = stat.value.atime;
    let btime: i64 = stat.value.btime;
    Metadata { len: len, is_dir: is_dir, is_symlink: is_symlink, mode: mode, nlink: nlink, ino: ino, dev: dev, uid: uid, gid: gid, rdev: rdev, blocks: blocks, blksize: blksize, modified_secs: mtime, accessed_secs: atime, created_secs: btime, changed_secs: ctime }
}

linux_x86_64 machine PosixFilesystem::directory_type_offset() -> u64[18..=20] { 18 }
linux_x86_64 machine PosixFilesystem::directory_name_offset() -> u64[19..=21] { 19 }
linux_x86_64 machine PosixFilesystem::remove_directory_flag() -> i32 { 512 }

linux_x86_64 machine FilesystemProviderDefaults::provider_defaults(defaults: &mut FilesystemProviderDefaults) {
    FilesystemProviderDefaults::select_provider<FilesystemService, FilesystemPosixProvider>(defaults);
}

linux_x86_64 machine posix_realpath_binding() -> ForeignBinding<9, 8, 9> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "realpath", version: "GLIBC_2.3",
    } }
}

linux_x86_64 machine PosixCanonicalImports::provider_defaults(defaults: &mut PosixCanonicalImports) {
    PosixCanonicalImports::select_provider<PosixCanonicalLibc::resolve, PosixCanonicalImports>(defaults);
    PosixCanonicalImports::select_provider<PosixCanonicalLibc::error_location, PosixCanonicalImports>(defaults);
    PosixCanonicalImports::select_provider<PosixCanonicalLibc::copy_error, PosixCanonicalImports>(defaults);
}

linux_x86_64 machine posix_errno_location_binding() -> ForeignBinding<9, 16, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "__errno_location", version: "GLIBC_2.2.5",
    } }
}

linux_x86_64 machine posix_errno_copy_binding() -> ForeignBinding<9, 6, 11> {
    ForeignBinding::DllImport { import: DllImport::ElfVersioned {
        object: "libc.so.6", symbol: "memcpy", version: "GLIBC_2.2.5",
    } }
}

linux_x86_64 machine PosixCanonicalImports::resolve(path: &[u8; 4096], output: &mut [u8; 4096]) -> u64
satisfies PosixCanonicalLibc::resolve via posix_realpath_binding();

linux_x86_64 machine PosixCanonicalImports::error_location() -> u64
satisfies PosixCanonicalLibc::error_location via posix_errno_location_binding();

linux_x86_64 machine PosixCanonicalImports::copy_error(destination: &mut [u8; 4], source: u64, count: u64) -> u64
satisfies PosixCanonicalLibc::copy_error via posix_errno_copy_binding();

// Error numbers belong to this OS, not to a synthetic shared POSIX catalog.
linux_x86_64 machine PosixFilesystem::kind_of_stored_error_code(filesystem: &mut PosixFilesystem) -> ErrorKind {
    filesystem.err_kind = match filesystem.err_code {
        2 -> ErrorKind::NotFound,
        13 -> ErrorKind::PermissionDenied,
        1 -> ErrorKind::PermissionDenied,
        17 -> ErrorKind::AlreadyExists,
        9 -> ErrorKind::BadDescriptor,
        21 -> ErrorKind::IsADirectory,
        11 -> ErrorKind::WouldBlock,
        22 -> ErrorKind::InvalidInput,
        34 -> ErrorKind::InvalidInput,
        36 -> ErrorKind::InvalidInput,
        38 -> ErrorKind::Unsupported,
        95 -> ErrorKind::Unsupported,
        _ -> ErrorKind::Other
    };
    ErrorKind::reconstruct(&filesystem.err_kind)
}

linux_x86_64 machine PosixFilesystem::would_block_error() -> i32 { 11 }
