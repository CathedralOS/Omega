use targets::windows_x86_64::WindowsClockWait;
// Every count below `u32 maximum` is a finite `Sleep`. The maximum itself is
// `INFINITE`, so it waits in two halves, each finite, for the same total.
public WindowsX8664Clock satisfies Clock {
    machine sleep(milliseconds: u32)
    reaches Clock
    invokes WindowsClockWait
    blocks
    {
        transition milliseconds == 4294967295 {
            true -> block in_halves(),
            _ -> block at_once(milliseconds)
        }

        machine at_once(milliseconds: u32) {
            block WindowsClockWait::sleep(milliseconds);
        }

        // 2147483647 + 2147483648 == 4294967295.
        machine in_halves() {
            block WindowsClockWait::sleep(2147483647);
            block WindowsClockWait::sleep(2147483648);
        }
    }
}
