use clock.omg as clock;
use targets/macos_arm64/clock_impl.omg as wait;
use {omega}/language/core/numeric_conversion.omg as numeric;

// Each wait is one poll with no descriptors, a bounded wait of its timeout.
// poll reads its timeout as a signed `int`, where -1 waits without bound and
// any other negative count is invalid, so a count above `i32 maximum` waits in
// three equal parts and the remainder; every part fits the signed range.
public MacosArm64Clock satisfies |clock|::Clock {
    machine sleep(milliseconds: u32)
    reaches |clock|::Clock
    invokes |wait|::DarwinClockWait
    blocks
    {
        transition milliseconds > 2147483647 {
            true -> block in_parts(milliseconds),
            _ -> block at_once(milliseconds)
        }

        machine at_once(milliseconds: u32) {
            block |wait|::DarwinClockWait::poll(0, 0, |numeric|::narrow_u32_to_i32_wrapping(milliseconds));
        }

        machine in_parts(milliseconds: u32) {
            let third: i32 = |numeric|::narrow_u32_to_i32_wrapping(milliseconds / 3);
            block |wait|::DarwinClockWait::poll(0, 0, third);
            block |wait|::DarwinClockWait::poll(0, 0, third);
            block |wait|::DarwinClockWait::poll(0, 0, third);
            block |wait|::DarwinClockWait::poll(0, 0, |numeric|::narrow_u32_to_i32_wrapping(milliseconds % 3));
        }
    }
}
