use calling.omg as abi;
use posix_byte_view_calling.omg as byte_views;
use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use targets\alpha_bootstrap\AlphaConsoleBytes;
use targets\windows_x86_64\WindowsConsoleBytes;
use omega\language\core\narrow_i32_to_u8_wrapping;
use omega\language\core\widen_u8_to_i32;

// Portable console operations. Build selects a complete ordinary implementation;
// shared checked adapters perform text I/O through its explicit byte operations.
// Physical target directories share this package's logical namespace.

// Eof is the zero-initialized value. Error reports a failed read; Byte carries 0 through 255.
public data ByteRead
    requires (self in ByteRead::Eof) || (self in ByteRead::Error) || ((self in ByteRead::Byte) && (self.value >= 0 && self.value <= 255))
{
    case Eof;
    case Byte(value: i32);
    case Error;
}

// Counts describe only the prefix written during this invocation. Invalid is
// the zero-initialized value, never a normal reader completion or an I/O error.
public data LineReadResult {
    case Invalid;
    case LineComplete(count: u64);
    case EndOfInput(count: u64);
    case Full(count: u64);
    case Error(count: u64);
}

public boundary trait Console {
    machine write_line(text: @[u8])
    reaches
        StandardOutput
    crashes none;
    machine write(text: @[u8])
    reaches
        StandardOutput
    crashes none;
    // Fill the existing writable extent without resizing it. Preserve every
    // byte, including CR and the terminating LF; callers interpret the prefix.
    // A failed read returns Error with the length of the prefix already stored.
    // Callers acknowledge the wait for hosted input with `block`.
    machine read_line(out_line: @mutable [u8]) -> LineReadResult
    reaches
        StandardInput
    blocks
    crashes none;
    // read_byte yields a byte, Eof at end of input, or Error on a failed read.
    // write_byte appends one byte to standard output.
    machine read_byte() -> ByteRead
    reaches
        StandardInput
    blocks
    crashes none;
    machine write_byte(byte: i32)
    reaches
        StandardOutput
    crashes none;
}

// Text adapters take an exact ordinary implementation of these byte operations.
trait ConsoleByteOperations {
    machine read_byte() -> ByteRead
    reaches StandardInput blocks crashes none;
    machine write_byte(byte: i32)
    reaches StandardOutput crashes none;
}

// Shared checked POSIX adaptation depends on an explicit ordinary raw map.
trait PosixConsoleRawOperations {
    machine read(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    requires descriptor == 0 && count <= 4
    reaches StandardInput blocks crashes none;
    machine write(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    requires descriptor == 1 && count <= 4
    reaches StandardOutput crashes none;
}

// Raw count/status ABI for linux_x86_64; read/write move one byte through a cell.
boundary trait LinuxX86ConsoleIo: |abi|::Calling<|byte_views|::LinuxX86ByteViewCalling> {
    machine read(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    requires descriptor == 0 && count <= 4
    reaches StandardInput blocks crashes none;
    machine write(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    requires descriptor == 1 && count <= 4
    reaches StandardOutput crashes none;
}

// Raw count/status ABI for linux_arm64; read/write move one byte through a cell.
boundary trait LinuxArm64ConsoleIo: |abi|::Calling<|byte_views|::LinuxArm64ByteViewCalling> {
    machine read(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    requires descriptor == 0 && count <= 4
    reaches StandardInput blocks crashes none;
    machine write(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    requires descriptor == 1 && count <= 4
    reaches StandardOutput crashes none;
}

// Raw count/status ABI for macos_arm64; read/write move one byte through a cell.
boundary trait DarwinArm64ConsoleIo: |abi|::Calling<|byte_views|::DarwinArm64ByteViewCalling> {
    machine read(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    requires descriptor == 0 && count <= 4
    reaches StandardInput blocks crashes none;
    machine write(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    requires descriptor == 1 && count <= 4
    reaches StandardOutput crashes none;
}

// Raw count/status ABI for macos_x86_64; read/write move one byte through a cell.
boundary trait DarwinX86ConsoleIo: |abi|::Calling<|byte_views|::SystemVByteViewCalling> {
    machine read(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    requires descriptor == 0 && count <= 4
    reaches StandardInput blocks crashes none;
    machine write(descriptor: i32, buffer: @mutable i32, count: u64) -> i64
    requires descriptor == 1 && count <= 4
    reaches StandardOutput crashes none;
}

public WindowsConsole satisfies Console {
    machine write_line(text: @[u8]) reaches StandardOutput {
        console_write_bytes::<WindowsConsoleBytes>(text, true);
    }
    machine write(text: @[u8]) reaches StandardOutput {
        console_write_bytes::<WindowsConsoleBytes>(text, false);
    }
    machine read_line(out_line: @mutable [u8]) -> LineReadResult
    reaches StandardInput blocks crashes none {
        block console_read_line::<WindowsConsoleBytes>(out_line)
    }
    machine read_byte() -> ByteRead
    reaches StandardInput blocks crashes none {
        block WindowsConsoleBytes::read_byte()
    }
    machine write_byte(byte: i32) reaches StandardOutput {
        WindowsConsoleBytes::write_byte(byte);
    }

}

