// Interpret the actual signed read result once for all POSIX byte providers.
// A one-byte read can yield one byte, EOF, or an error. An invalid transfer
// count also leaves this operation without a valid byte.
machine posix_console_read_byte<const Raw: PosixConsoleRawOperations>() -> ByteRead
reaches StandardInput blocks crashes none {
    let mutable cell: i32 = 0;
    let count: i64 = block Raw::read(0, @mutable cell, 1);
    transition count {
        1 -> byte(cell),
        0 -> end(),
        _ -> failed()
    }
    machine byte(cell: i32) -> ByteRead {
        let value: u8 = narrow_i32_to_u8_wrapping(cell);
        ByteRead::Byte { value: widen_u8_to_i32(value) }
    }
    machine end() -> ByteRead { ByteRead::Eof }
    machine failed() -> ByteRead { ByteRead::Error }
}

machine posix_console_write_byte<const Raw: PosixConsoleRawOperations>(byte: i32)
reaches StandardOutput {
    let mutable cell: i32 = byte;
    let written: i64 = Raw::write(1, @mutable cell, 1);
}

// Shared bounded input uses this exact provider's byte leaf, not recursive
// service redispatch. Check capacity before reading: Full consumes no lookahead
// and an empty destination returns Full(0). LF in the last slot still completes
// the line. Finite storage does not promise a bound on waiting for host input.
machine console_read_line<const Bytes: ConsoleByteOperations>(out_line: @mutable [u8]) -> LineReadResult
reaches StandardInput blocks crashes none {
    transition { _ -> block scan(out_line, 0) }
    machine scan(out_line: @mutable [u8], position: u64) -> LineReadResult {
        transition position < out_line.length {
            true -> block read(out_line, position, position + 1),
            false -> full(position)
        }
    }
    machine read(out_line: @mutable [u8], position: u64, next: u64) -> LineReadResult
    requires position < out_line.length {
        let observed: ByteRead = block Bytes::read_byte();
        transition observed {
            ByteRead::Byte { value } -> block store(out_line, position, next, value),
            ByteRead::Eof -> end(position),
            ByteRead::Error -> failed(position)
        }
    }
    machine store(out_line: @mutable [u8], position: u64, next: u64, value: i32) -> LineReadResult
    requires position < out_line.length && value >= 0 && value <= 255
    {
        out_line[position] = value as u8;
        transition value == 10 {
            true -> complete(next),
            false -> block scan(out_line, next)
        }
    }
    machine failed(count: u64) -> LineReadResult { LineReadResult::Error { count: count } }
    machine full(count: u64) -> LineReadResult { LineReadResult::Full { count: count } }
    machine end(count: u64) -> LineReadResult { LineReadResult::EndOfInput { count: count } }
    machine complete(count: u64) -> LineReadResult { LineReadResult::LineComplete { count: count } }
}

// Friendly output is checked Omega code over the byte-level boundary leaf.
// The writer belongs to this concrete provider closure and calls its byte leaf
// directly; it does not receive or manufacture a separate service authority.
// The private writer walks a borrowed byte view as one measured machine
// cycle. Each guarded edge stages the head byte and tail slice; the helper's
// body performs the byte effect only after that edge was selected.
machine console_write_bytes<const Bytes: ConsoleByteOperations>(bytes: @[u8], newline: bool)
terminates by bytes -> Slice::Length
reaches
    StandardOutput
{
    transition bytes.length > 0 {
        true -> emit(bytes[0], bytes[1..], newline),
        false -> finish(newline)
    }

    machine emit(byte: u8, bytes: @[u8], newline: bool)
    terminates by bytes -> Slice::Length {
        let mutable output: u8 = byte;
        Bytes::write_byte(output as i32);
        transition bytes.length > 0 {
            true -> emit(bytes[0], bytes[1..], newline),
            false -> finish(newline)
        }
    }

    machine finish(newline: bool) {
        transition newline {
            true -> emit_newline(10),
            false -> done()
        }
    }

    machine emit_newline(byte: u8) {
        let mutable output: u8 = byte;
        Bytes::write_byte(output as i32);
    }

    machine done() { }
}
