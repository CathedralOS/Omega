use omega::language::core::narrow_i32_to_u8_wrapping;
use omega::language::core::narrow_i64_to_u8_trapping;
use omega::language::core::widen_u8_to_i32;

// Portable console surface exposed by the Omega standard library.
//
// The text adapters and byte conversions are checked Omega code. Build binds
// only the raw host operations used by the selected byte provider.
//
// Console and its implementation declarations share the package-root logical
// module. Physical target directories do not introduce import namespaces.

// The result of a byte-level stdin read. `Eof` is ORDINAL 0: a
// zero-initialized ByteRead IS end-of-input -- ZII, no magic sentinel
// (the byte result has no sentinel).
public data ByteRead 
    requires (self in ByteRead::Eof) || ((self in ByteRead::Byte) && (self.value >= 0 && self.value <= 255))
{
    case Eof;
    case Byte(value: i32);
}

// Counts describe only the prefix written during this invocation. Invalid is
// the zero-initialized value, never a normal reader completion or an I/O error.
public data LineReadResult {
    case Invalid;
    case LineComplete(count: u64);
    case EndOfInput(count: u64);
    case Full(count: u64);
}

public boundary trait Console {
    machine write_line(text: &[u8])
    reaches
        Console
    crashes none;
    machine write(text: &[u8])
    reaches
        Console
    crashes none;
    // Fill the existing writable extent without resizing it. Preserve every
    // byte, including CR and the terminating LF; callers interpret the prefix.
    // Hosted input may occupy the worker while waiting and traps on a failed
    // host read, so callers acknowledge `block` and cover the `Trap` route.
    machine read_line(out_line: &mut [u8]) -> LineReadResult
    reaches
        Console
    blocks
    crashes Trap;
    // Byte-level stdin/stdout (the settled universal console surface):
    // `read_byte` yields the next stdin byte as `ByteRead::Byte`, or
    // `ByteRead::Eof` at end-of-input; `write_byte` appends one byte to
    // stdout. Both interpreter and native providers implement these leaves;
    // the friendly text adapters below are shared checked Omega code.
    // `read_byte` honestly publishes the hosted wait/failure envelope.
    machine read_byte() -> ByteRead
    reaches
        Console
    blocks
    crashes Trap;
    machine write_byte(byte: i32)
    reaches
        Console
    crashes none;
}

// Host byte I/O is a separate private boundary. The public provider calls
// these requirements; it never calls a boundary conformer's name or selects
// Console again while implementing Console.
boundary trait ConsoleHost {
    machine read_byte() -> ByteRead
    reaches Console
    blocks
    crashes Trap;
    machine write_byte(byte: i32)
    reaches Console
    crashes none;
}

// Raw POSIX calls move one byte through an initialized i32 cell. All hosted
// targets here are little-endian; the checked adapter keeps only that byte.
// Build owns the actual read/write locator for each target.
boundary trait PosixConsoleIo {
    machine read(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    reaches Console
    blocks
    crashes none;
    machine write(descriptor: i32, buffer: &mut i32, count: u64) -> i64
    reaches Console
    crashes none;
}

PosixConsoleHost satisfies ConsoleHost {
    machine read_byte() -> ByteRead
    reaches Console
    blocks
    crashes Trap {
        let mut cell: i32 = 0;
        let count: i64 = block PosixConsoleIo::read(0, &mut cell, 1);
        transition count {
            1 -> byte(cell)
            0 -> end()
            _ -> failed(count)
        }
        machine byte(cell: i32) -> ByteRead {
            let value: u8 = narrow_i32_to_u8_wrapping(cell);
            ByteRead::Byte { value: widen_u8_to_i32(value) }
        }
        machine end() -> ByteRead { ByteRead::Eof }
        machine failed(count: i64) -> ByteRead {
            let trapped: u8 = narrow_i64_to_u8_trapping(count);
            ByteRead::Eof
        }
    }
    machine write_byte(byte: i32) reaches Console {
        let mut cell: i32 = byte;
        let written: i64 = PosixConsoleIo::write(1, &mut cell, 1);
    }
}

// Build selects this complete Console map. Both text adapters use the same
// private byte operations selected for that target.
public NativeConsole satisfies Console {
    machine write_line(text: &[u8]) reaches Console {
        console_write_bytes(text, true);
    }
    machine write(text: &[u8]) reaches Console {
        console_write_bytes(text, false);
    }
    machine read_line(out_line: &mut [u8]) -> LineReadResult
    reaches Console blocks crashes Trap {
        block console_read_line(out_line)
    }
    machine read_byte() -> ByteRead
    reaches Console blocks crashes Trap {
        block ConsoleHost::read_byte()
    }
    machine write_byte(byte: i32) reaches Console {
        ConsoleHost::write_byte(byte);
    }
}

// Shared bounded input uses this exact provider's byte leaf, not recursive
// service redispatch. Check capacity before reading: Full consumes no lookahead
// and an empty destination returns Full(0). LF in the last slot still completes
// the line. Finite storage does not promise a bound on waiting for host input.
machine console_read_line(out_line: &mut [u8]) -> LineReadResult
reaches Console
blocks
crashes Trap {
    transition { _ -> block scan(out_line, 0) }
    machine scan(out_line: &mut [u8], position: u64) -> LineReadResult {
        transition position < out_line.len {
            true -> block read(out_line, position, position + 1)
            false -> full(position)
        }
    }
    machine read(out_line: &mut [u8], position: u64, next: u64) -> LineReadResult
    requires position < out_line.len {
        let observed: ByteRead = block ConsoleHost::read_byte();
        transition observed {
            ByteRead::Byte { value } -> block store(out_line, position, next, value)
            ByteRead::Eof -> end(position)
        }
    }
    machine store(out_line: &mut [u8], position: u64, next: u64, value: i32) -> LineReadResult
    requires position < out_line.len && value >= 0 && value <= 255
    {
        out_line[position] = value as u8;
        transition value == 10 {
            true -> complete(next)
            false -> block scan(out_line, next)
        }
    }
    machine full(count: u64) -> LineReadResult { LineReadResult::Full { count: count } }
    machine end(count: u64) -> LineReadResult { LineReadResult::EndOfInput { count: count } }
    machine complete(count: u64) -> LineReadResult { LineReadResult::LineComplete { count: count } }
}

// Friendly output is checked Omega code over the byte-level boundary leaf.
// The writer belongs to this concrete provider closure and calls its byte leaf
// directly; it does not receive or manufacture a separate service authority.
// The private writer walks a borrowed byte view as one measured machine
// cycle. Each guarded edge stages the head byte and tail slice; the helper's
// body performs the byte effect only after that edge was selected.
machine console_write_bytes(bytes: &[u8], newline: bool)
terminates by bytes -> Slice::Length
reaches
    Console
{
    transition bytes.len > 0 {
        true -> emit(bytes[0], bytes[1..], newline)
        false -> finish(newline)
    }

    machine emit(byte: u8, bytes: &[u8], newline: bool)
    terminates by bytes -> Slice::Length {
        let mut output: u8 = byte;
        ConsoleHost::write_byte(output as i32);
        transition bytes.len > 0 {
            true -> emit(bytes[0], bytes[1..], newline)
            false -> finish(newline)
        }
    }

    machine finish(newline: bool) {
        transition newline {
            true -> emit_newline(10)
            false -> done()
        }
    }

    machine emit_newline(byte: u8) {
        let mut output: u8 = byte;
        ConsoleHost::write_byte(output as i32);
    }

    machine done() { }
}
