// The macOS Gui backend — an ordinary Omega WRAPPER that implements the samples'
// Win32-shaped `Gui` trait by composing the proven Objective-C / Core Graphics
// boundary primitives (`objc_getClass`/`objc_msgSend`/`CGBitmapContextCreate`/…).
// Mirrors `omega::language::std::filesystem`'s pattern: a `data` type holding the
// boundary handles + scratch FIELDS, its ops consumed via terminal-value
// completion (never a transition guard on the raw host result). No C shim — Omega
// calls Cocoa directly, the same way the fs seam calls libc.
//
// The samples call `self.gui.window_create(cls, title, style, x, y, w, h)` etc.
// through a `boundary trait Gui` field; on darwin that field is provided by this
// `MacosGui`. Its ordinary value-call signatures exactly match the samples'
// `Gui` trait, making target-selected substitution transparent to source callers.
//
// D-macgui-style: the Win32 `class_name`/`style` args are IGNORED — macOS always
// builds a standard titled/closable/resizable window (styleMask 15). The samples
// want a visible titled window; the Win32 class/style bits do not translate.
// The args that DO translate are translated faithfully: `title` is set on the
// window (`initWithUTF8String:` over the sample's NUL-terminated bytes);
// `width`/`height` arrive as the Win32 OUTER size and are shaved by the
// standard overlapped fudge (+16, +39) so the CONTENT area matches the Win32
// client area; the window is centered, focused (`activateIgnoringOtherApps:`),
// and its image view STRETCHES the framebuffer to fill the content area
// (StretchDIBits parity — NSImageScaleAxesIndependently). Per-frame objects
// (CGContext/CGImage/NSImage) are released each blit and the event pump cycles
// a rolling autorelease pool, so a long-running app's memory stays flat.

use omega::language::core::numeric_conversion;
use omega::language::core::float_operations;
use omega::language::core::service;
use targets::macos_arm64::macos_gui_impl;

pub domain [u8]::CString
requires
    no_nul(self);
// The Objective-C runtime seam (libobjc). Human method names; the `_objc_*`/`_sel_*`
// symbols live only in the darwin binding table.
pub boundary trait ObjectiveC {
    machine get_class(name: &u8) -> u64;
    machine register_selector(name: &u8) -> u64;
    machine send(recv: u64, sel: u64) -> u64;
    machine send_scalar(recv: u64, sel: u64, arg: u64) -> u64;
    machine send_rect(recv: u64, sel: u64, x: f64, y: f64, w: f64, h: f64, a: u64, b: u64, c: u64) -> u64;
    machine send_image_size(recv: u64, sel: u64, image: u64, w: f64, h: f64) -> u64;
    machine send_string(recv: u64, sel: u64, text: &u8) -> u64;
    // RUNTIME byte-buffer string arg (`initWithUTF8String:` over the samples'
    // title bytes). The callee reads to the first NUL, so the buffer must be
    // NUL-terminated by construction; tighten to a proven CString domain once
    // the reference-domain mint lands.
    machine send_byte_string(recv: u64, sel: u64, text: &u8) -> u64;
    machine send_scalar4(recv: u64, sel: u64, a: u64, b: u64, c: u64, d: u64) -> u64;
    // Autorelease-pool scope (objc_autoreleasePoolPush/Pop). The event pump runs
    // outside any Cocoa-managed pool, so dequeued autoreleased NSEvents would
    // leak every frame without one. `pool_pop` is a void C call; the u64 result
    // is scratch.
    machine pool_push() -> u64;
    machine pool_pop(pool: u64) -> u64;
}

// The Core Graphics seam (CoreGraphics framework) for the framebuffer blit.
pub boundary trait CoreGraphics {
    machine color_space_rgb() -> u64;
    // `data` is READ-ONLY here: the framebuffer is snapshotted into the CGImage
    // (`bitmap_context_image`), never drawn into, so an immutable ref suffices —
    // and a by-value `pixels` PARAM cannot be borrowed `&mut`. The ABI passes a
    // plain pointer either way.
    machine bitmap_context(data: &i32, w: i64, h: i64, bpc: i64, stride: i64, space: u64, info: i64) -> u64;
    machine bitmap_context_image(ctx: u64) -> u64;
    // Create-rule drops for the per-frame context + CGImage snapshot (void C
    // calls; the u64 results are scratch). Without them every blit leaks both.
    machine context_release(ctx: u64) -> u64;
    machine image_release(image: u64) -> u64;
    // `CGEventSourceKeyState(state_id, keycode) -> bool` — is a physical key down?
    // The macOS backing for `Input.key_state` (see MacosInput below).
    machine event_source_key_state(state_id: u64, keycode: u64) -> u64;
}

pub data MacosGui {
    // The current window + its image-view content (single-window apps).
    window: u64;
    view: u64;
    app: u64;
    // A device-RGB colorspace, created once at window_create and reused per blit.
    space: u64;
    // Staged blit dimensions (a host-call arg must be a storage place / literal,
    // not a live conversion expression, so the i64/f64 results land in fields).
    fbw: i64;
    fbh: i64;
    stride: i64;
    fbwf: f64;
    fbhf: f64;
    // Pump scratch, built ONCE at window_create (msg_peek used to rebuild the
    // date/mode/selector EVERY call, leaking an NSString per peek): the
    // distantPast date, the run-loop-mode NSString, the nextEvent selector,
    // the event mask, and the last dequeued NSEvent.
    date: u64;
    mode: u64;
    psel: u64;
    mask: u64;
    evt: u64;
    // Cached per-frame selectors (registered once at window_create): release,
    // sendEvent:, isVisible, keyWindow.
    relsel: u64;
    dsel: u64;
    vsel: u64;
    ksel: u64;
    // The rolling autorelease pool: opened at window_create, cycled by every
    // msg_peek (pop drains the previous peek's autoreleased NSEvent after its
    // dispatch; push opens the scope for the next one).
    pool: u64;
    // Scratch for the objc call sequences.
    cls: u64;
    sel: u64;
    tmp: u64;
    ctx: u64;
    cgimg: u64;
    nsimg: u64;
    rx: f64;
    ry: f64;
    rw: f64;
    rh: f64;
    rc: u64;
    r32: u32;
}

// `Gui::window_create` — open a titled window whose content view is an NSImageView
// (the blit target). Returns the NSWindow pointer (the samples check `> 0`).
//
// Win32→macOS translations (D-macgui-style):
// - `width`/`height` are the Win32 OUTER size; the samples bake in the standard
//   overlapped-window fudge (+16, +39) so the Win32 CLIENT area lands at the
//   render size. macOS's `initWithContentRect:` takes the client size directly,
//   so shave that fudge (f64 math — no overflow obligations) or the fudge
//   becomes visible content padding.
// - The image view's `imageScaling` is set to NSImageScaleAxesIndependently (1):
//   the blit contract is StretchDIBits (fill the dest rect), but NSImageView's
//   DEFAULT only ever scales DOWN, which floats a small framebuffer in the
//   middle of the window instead of stretching it.
// - The title bytes ARE honored (`initWithUTF8String:` over the sample's
//   NUL-terminated array; setTitle: copies, so our +1 NSString is released).
// - The window is centered and the app activated (`activateIgnoringOtherApps:`):
//   a bare mach-o CAN show a window, but without activation it opens unfocused
//   behind other windows and the samples' keyWindow focus gate never passes.
pub macos_arm64 machine MacosGui::window_create(&mut self, class_name: [u8; 7], title: [u8; 11], style: u32, x: i32, y: i32, width: i32, height: i32) -> u64
reaches CoreGraphics + ObjectiveC
{
    self.rx = F64::from_i32(x);
    self.ry = F64::from_i32(y);
    self.rw = F64::from_i32(width);
    self.rh = F64::from_i32(height);
    self.rw = self.rw - 16.0;
    self.rh = self.rh - 39.0;
    let cbuf1: [u8; 14] = "NSApplication\0";
    self.cls = objc_get_class(&cbuf1[0]);
    let cbuf2: [u8; 18] = "sharedApplication\0";
    self.sel = objc_register_selector(&cbuf2[0]);
    self.app = objc_send(self.cls, self.sel);
    let cbuf3: [u8; 21] = "setActivationPolicy:\0";
    self.sel = objc_register_selector(&cbuf3[0]);
    self.rc = objc_send_scalar(self.app, self.sel, 0);
    let cbuf4: [u8; 9] = "NSWindow\0";
    self.cls = objc_get_class(&cbuf4[0]);
    let cbuf5: [u8; 6] = "alloc\0";
    self.sel = objc_register_selector(&cbuf5[0]);
    self.tmp = objc_send(self.cls, self.sel);
    let cbuf6: [u8; 45] = "initWithContentRect:styleMask:backing:defer:\0";
    self.sel = objc_register_selector(&cbuf6[0]);
    self.window = objc_send_rect(self.tmp, self.sel, self.rx, self.ry, self.rw, self.rh, 15, 2, 0);
    let cbuf7: [u8; 12] = "NSImageView\0";
    self.cls = objc_get_class(&cbuf7[0]);
    let cbuf8: [u8; 6] = "alloc\0";
    self.sel = objc_register_selector(&cbuf8[0]);
    self.tmp = objc_send(self.cls, self.sel);
    let cbuf9: [u8; 15] = "initWithFrame:\0";
    self.sel = objc_register_selector(&cbuf9[0]);
    self.view = objc_send_rect(self.tmp, self.sel, self.rx, self.ry, self.rw, self.rh, 0, 0, 0);
    let cbuf10: [u8; 17] = "setImageScaling:\0";
    self.sel = objc_register_selector(&cbuf10[0]);
    self.rc = objc_send_scalar(self.view, self.sel, 1);
    let cbuf11: [u8; 16] = "setContentView:\0";
    self.sel = objc_register_selector(&cbuf11[0]);
    self.rc = objc_send_scalar(self.window, self.sel, self.view);
    let cbuf12: [u8; 8] = "release\0";
    self.relsel = objc_register_selector(&cbuf12[0]);
    let cbuf13: [u8; 9] = "NSString\0";
    self.cls = objc_get_class(&cbuf13[0]);
    let cbuf14: [u8; 6] = "alloc\0";
    self.sel = objc_register_selector(&cbuf14[0]);
    self.tmp = objc_send(self.cls, self.sel);
    let cbuf15: [u8; 20] = "initWithUTF8String:\0";
    self.sel = objc_register_selector(&cbuf15[0]);
    self.tmp = objc_send_byte_string(self.tmp, self.sel, &title[0]);
    let cbuf16: [u8; 10] = "setTitle:\0";
    self.sel = objc_register_selector(&cbuf16[0]);
    self.rc = objc_send_scalar(self.window, self.sel, self.tmp);
    self.rc = objc_send(self.tmp, self.relsel);
    let cbuf17: [u8; 7] = "center\0";
    self.sel = objc_register_selector(&cbuf17[0]);
    self.rc = objc_send(self.window, self.sel);
    let cbuf18: [u8; 22] = "makeKeyAndOrderFront:\0";
    self.sel = objc_register_selector(&cbuf18[0]);
    self.rc = objc_send_scalar(self.window, self.sel, 0);
    let cbuf19: [u8; 27] = "activateIgnoringOtherApps:\0";
    self.sel = objc_register_selector(&cbuf19[0]);
    self.rc = objc_send_scalar(self.app, self.sel, 1);
    self.space = cg_color_space_rgb();
    // Pump scratch, once: the distantPast date, the run-loop-mode NSString, the
    // nextEvent/sendEvent:/isVisible/keyWindow selectors, and the event mask.
    let cbuf20: [u8; 7] = "NSDate\0";
    self.cls = objc_get_class(&cbuf20[0]);
    let cbuf21: [u8; 12] = "distantPast\0";
    self.sel = objc_register_selector(&cbuf21[0]);
    self.date = objc_send(self.cls, self.sel);
    let cbuf22: [u8; 9] = "NSString\0";
    self.cls = objc_get_class(&cbuf22[0]);
    let cbuf23: [u8; 6] = "alloc\0";
    self.sel = objc_register_selector(&cbuf23[0]);
    self.tmp = objc_send(self.cls, self.sel);
    let cbuf24: [u8; 20] = "initWithUTF8String:\0";
    self.sel = objc_register_selector(&cbuf24[0]);
    let cbuf25: [u8; 22] = "kCFRunLoopDefaultMode\0";
    self.mode = objc_send_string(self.tmp, self.sel, &cbuf25[0]);
    let cbuf26: [u8; 48] = "nextEventMatchingMask:untilDate:inMode:dequeue:\0";
    self.psel = objc_register_selector(&cbuf26[0]);
    self.mask = 4294967295;
    let cbuf27: [u8; 11] = "sendEvent:\0";
    self.dsel = objc_register_selector(&cbuf27[0]);
    let cbuf28: [u8; 10] = "isVisible\0";
    self.vsel = objc_register_selector(&cbuf28[0]);
    let cbuf29: [u8; 10] = "keyWindow\0";
    self.ksel = objc_register_selector(&cbuf29[0]);
    // Open the rolling autorelease pool msg_peek cycles (never popped at exit
    // on purpose: a later peek after a final pop would pop a dead token, and
    // process exit reclaims everything anyway).
    self.pool = objc_pool_push();
    transition { _ -> ret() }
    state ret(&mut self) -> u64 { self.window }
}

// `Gui::blit` — copy a top-down 32bpp BGRA framebuffer into the window's image
// view: `CGBitmapContextCreate(&pixels)` → snapshot to a CGImage → `NSImage
// initWithCGImage:size:` → `[imageView setImage:]`. `dest_*` and `device`/`info`
// are ignored (the image view auto-scales; macOS is top-down like the source, so
// NO row flip). `stride = source_width * 4` via an Exact widening then `<< 2`;
// the full u32 source range shifted by two is representable in i64.
pub macos_arm64 machine MacosGui::blit(&mut self, device: u64, dest_width: u32, dest_height: u32, source_width: u32, source_height: u32, pixels: [i32; 4096], info: [i32; 11]) -> u32
reaches CoreGraphics + ObjectiveC
{
    let source_width_wide: i64 = source_width as i64;
    let source_height_wide: i64 = source_height as i64;
    self.fbw = source_width_wide;
    self.fbh = source_height_wide;
    self.stride = source_width_wide << 2;
    self.fbwf = F64::from_u32(source_width);
    self.fbhf = F64::from_u32(source_height);
    self.ctx = cg_bitmap_context(&pixels[0], self.fbw, self.fbh, 8, self.stride, self.space, 8198);
    self.cgimg = cg_bitmap_context_image(self.ctx);
    let cbuf30: [u8; 8] = "NSImage\0";
    self.cls = objc_get_class(&cbuf30[0]);
    let cbuf31: [u8; 6] = "alloc\0";
    self.sel = objc_register_selector(&cbuf31[0]);
    self.tmp = objc_send(self.cls, self.sel);
    let cbuf32: [u8; 22] = "initWithCGImage:size:\0";
    self.sel = objc_register_selector(&cbuf32[0]);
    self.nsimg = objc_send_image_size(self.tmp, self.sel, self.cgimg, self.fbwf, self.fbhf);
    let cbuf33: [u8; 10] = "setImage:\0";
    self.sel = objc_register_selector(&cbuf33[0]);
    self.rc = objc_send_scalar(self.view, self.sel, self.nsimg);
    // Per-frame lifecycle: the context and CGImage are Create-rule owned, and
    // setImage: retains the NSImage, so drop our +1 on all three — without
    // these releases every presented frame leaked ~3 objects at ~60fps.
    self.rc = cg_context_release(self.ctx);
    self.rc = cg_image_release(self.cgimg);
    self.rc = objc_send(self.nsimg, self.relsel);
    // The samples assert `blit == source_height` (every source scanline copied).
    self.r32 = source_height;
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}

// `Gui::get_dc` — the samples pass the returned "device context" to `blit`; on
// macOS the drawing target is the window's image view, reached from the window, so
// `get_dc` just echoes the window handle back (the sample only checks `> 0`).
pub macos_arm64 machine MacosGui::get_dc(&mut self, window: u64) -> u64 {
    transition { _ -> ret(window) }
    state ret(&mut self, window: u64) -> u64 { window }
}

// `Gui::msg_peek` — non-blocking event dequeue. `[NSApp nextEventMatchingMask:0xffffffff
// untilDate:[NSDate distantPast] inMode:kCFRunLoopDefaultMode dequeue:YES]`. Stashes
// the NSEvent in `self.evt` for `msg_dispatch`; returns 1 if an event was dequeued
// (the sample's `have`), 0 otherwise. The Win32 `message: [u64;6]` buffer is unused
// on macOS (the event is an NSEvent object, not a copied-out MSG struct).
pub macos_arm64 machine MacosGui::msg_peek(&mut self, message: [u64; 6]) -> u32
reaches ObjectiveC
{
    // Cycle the rolling autorelease pool opened at window_create: the pop
    // drains the PREVIOUS peek's autoreleased NSEvent (already dispatched by
    // then), the push opens the scope this peek's event lands in. The date,
    // mode string, selector, and mask are window_create-cached — this machine
    // used to rebuild all four (and leak the NSString) on every single peek.
    self.rc = objc_pool_pop(self.pool);
    self.pool = objc_pool_push();
    self.evt = objc_send_scalar4(self.app, self.psel, self.mask, self.date, self.mode, 1);
    // Arm states must stay side-effect-free (the value-call effect fence):
    // both arms complete with a pure terminal value instead of mutating r32.
    transition self.evt != 0 { true -> got() _ -> ret() }
    state got(&mut self) -> u32 { 1 }
    state ret(&mut self) -> u32 { 0 }
}

// `Gui::msg_translate` — a Win32 keyboard pre-pass (WM_KEYDOWN → WM_CHAR). macOS
// has no equivalent step; Cocoa delivers characters directly via `sendEvent:`. A
// no-op that reports success (the sample only checks the count advances).
pub macos_arm64 machine MacosGui::msg_translate(&mut self, message: [u64; 6]) -> u32 {
    self.r32 = 1;
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}

// `Gui::msg_dispatch` — route the dequeued event back to the app: `[NSApp sendEvent:
// self.evt]` (drives window dragging, the close button, key handling). Returns 0
// (Win32 DispatchMessage's LRESULT; the sample ignores it).
pub macos_arm64 machine MacosGui::msg_dispatch(&mut self, message: [u64; 6]) -> u64
reaches ObjectiveC
{
    self.rc = objc_send_scalar(self.app, self.dsel, self.evt);
    transition { _ -> ret() }
    state ret(&mut self) -> u64 { self.rc }
}

// `Gui::is_window` — liveness. `[window isVisible]` is a live, on-screen window.
pub macos_arm64 machine MacosGui::is_window(&mut self, window: u64) -> u32
reaches ObjectiveC
{
    self.rc = objc_send(window, self.vsel);
    self.r32 = narrow_u64_to_u32_wrapping(self.rc);
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}

// `Gui::window_destroy` — `[window close]`. (Not in the samples' hot path, but part
// of the Win32 Gui trait; kept for completeness.)
pub macos_arm64 machine MacosGui::window_destroy(&mut self, window: u64) -> u32
reaches ObjectiveC
{
    let cbuf34: [u8; 6] = "close\0";
    self.sel = objc_register_selector(&cbuf34[0]);
    self.rc = objc_send_scalar(window, self.sel, 0);
    self.r32 = 1;
    transition { _ -> ret() }
    state ret(&mut self) -> u32 { self.r32 }
}

// `Gui::foreground_window` — the focus gate for the samples' GLOBAL key polling
// (Win32 `GetForegroundWindow`; on macOS `CGEventSourceKeyState` is just as
// global). `[NSApp keyWindow]` is THIS app's focused window — the NSWindow
// pointer `window_create` returned when the app is frontmost and the window is
// key, 0 otherwise — so the samples' `fw == hwnd` gate works unchanged.
pub macos_arm64 machine MacosGui::foreground_window(&mut self) -> u64
reaches ObjectiveC
{
    self.rc = objc_send(self.app, self.ksel);
    transition { _ -> ret() }
    state ret(&mut self) -> u64 { self.rc }
}

// The macOS `Input` backend — implements the samples' Win32-shaped `Input` trait
// (`key_state(virtual_key) -> u64`) by mapping a Win32 virtual-key to the macOS
// keycode and asking Core Graphics whether that physical key is currently down
// (`CGEventSourceKeyState`, HID system state = 1). On darwin the samples' `input:
// Input` boundary field is provided by this `MacosInput` (the boundary→provider
// substitution), so `self.input.key_state(27)` (ESC) dispatches here as an ordinary
// value-call. Unmapped virtual-keys report "not down" (0) rather than querying a
// wrong keycode.
pub data MacosInput {
    keycode: u64;
    rc: u64;
}

// Win32 VK -> macOS keycode (ANSI layout), everything the gui samples poll:
// ESC/arrows (window_app), plus Backspace, Enter, top-row digits 0-9, C/M/R/S,
// the numpad operators, and OEM_PLUS `=` (windowed_calculator). Unmapped VKs
// return the 65535 sentinel (no macOS keycode is that large), which key_state
// gates to "not down". PURE machine: every arm state completes with a terminal
// value, so it is legal inside a value-called callee (the effect fence).
pub macos_arm64 machine MacosInput::map_keycode(&mut self, virtual_key: u32) -> u64 {
    transition virtual_key == 8 { true -> k51() _ -> t13(virtual_key) }
    state t13(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 13 { true -> k36() _ -> t27(virtual_key) } }
    state t27(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 27 { true -> k53() _ -> t37(virtual_key) } }
    state t37(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 37 { true -> k123() _ -> t38(virtual_key) } }
    state t38(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 38 { true -> k126() _ -> t39(virtual_key) } }
    state t39(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 39 { true -> k124() _ -> t40(virtual_key) } }
    state t40(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 40 { true -> k125() _ -> t48(virtual_key) } }
    state t48(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 48 { true -> k29() _ -> t49(virtual_key) } }
    state t49(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 49 { true -> k18() _ -> t50(virtual_key) } }
    state t50(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 50 { true -> k19() _ -> t51(virtual_key) } }
    state t51(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 51 { true -> k20() _ -> t52(virtual_key) } }
    state t52(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 52 { true -> k21() _ -> t53(virtual_key) } }
    state t53(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 53 { true -> k23() _ -> t54(virtual_key) } }
    state t54(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 54 { true -> k22() _ -> t55(virtual_key) } }
    state t55(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 55 { true -> k26() _ -> t56(virtual_key) } }
    state t56(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 56 { true -> k28() _ -> t57(virtual_key) } }
    state t57(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 57 { true -> k25() _ -> t67(virtual_key) } }
    state t67(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 67 { true -> k8() _ -> t77(virtual_key) } }
    state t77(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 77 { true -> k46() _ -> t82(virtual_key) } }
    state t82(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 82 { true -> k15() _ -> t83(virtual_key) } }
    state t83(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 83 { true -> k1() _ -> t106(virtual_key) } }
    state t106(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 106 { true -> k67() _ -> t107(virtual_key) } }
    state t107(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 107 { true -> k69() _ -> t109(virtual_key) } }
    state t109(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 109 { true -> k78() _ -> t111(virtual_key) } }
    state t111(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 111 { true -> k75() _ -> t187(virtual_key) } }
    state t187(&mut self, virtual_key: u32) -> u64 { transition virtual_key == 187 { true -> k24() _ -> unmapped() } }
    state k1(&mut self) -> u64 { 1 }
    state k8(&mut self) -> u64 { 8 }
    state k15(&mut self) -> u64 { 15 }
    state k18(&mut self) -> u64 { 18 }
    state k19(&mut self) -> u64 { 19 }
    state k20(&mut self) -> u64 { 20 }
    state k21(&mut self) -> u64 { 21 }
    state k22(&mut self) -> u64 { 22 }
    state k23(&mut self) -> u64 { 23 }
    state k24(&mut self) -> u64 { 24 }
    state k25(&mut self) -> u64 { 25 }
    state k26(&mut self) -> u64 { 26 }
    state k28(&mut self) -> u64 { 28 }
    state k29(&mut self) -> u64 { 29 }
    state k36(&mut self) -> u64 { 36 }
    state k46(&mut self) -> u64 { 46 }
    state k51(&mut self) -> u64 { 51 }
    state k53(&mut self) -> u64 { 53 }
    state k67(&mut self) -> u64 { 67 }
    state k69(&mut self) -> u64 { 69 }
    state k75(&mut self) -> u64 { 75 }
    state k78(&mut self) -> u64 { 78 }
    state k123(&mut self) -> u64 { 123 }
    state k124(&mut self) -> u64 { 124 }
    state k125(&mut self) -> u64 { 125 }
    state k126(&mut self) -> u64 { 126 }
    state unmapped(&mut self) -> u64 { 65535 }
}

// The effect fence requires every side effect of a value-called machine in its
// ENTRY body: map the VK (pure value call), query CGEventSourceKeyState, then
// pick the result through pure arms. The query fires even for an unmapped VK
// (65535 is no real keycode; the read-only query reports "not down" and the
// sentinel arm discards it) because a host call may not live in an arm state.
pub macos_arm64 machine MacosInput::key_state(&mut self, virtual_key: u32) -> u64
reaches CoreGraphics
{
    self.keycode = self.map_keycode(virtual_key);
    self.rc = cg_event_source_key_state(1, self.keycode);
    transition self.keycode == 65535 { true -> not_down() _ -> ret() }
    state not_down(&mut self) -> u64 { 0 }
    state ret(&mut self) -> u64 { self.rc }
}

// ---------------------------------------------------------------------------
// The darwin CLOCK seam (libSystem) and the `MacosClock` wrapper implementing
// the gui samples' Win32-shaped `Clock` boundary (`sleep` / `get_tick_count`
// / `perf_counter` / `perf_frequency`). Raw value-returning leaves only: every
// unit conversion lives in the wrapper, none in the binding layer.
//   - `clock_ns(clock_id)` binds `clock_gettime_nsec_np` — a direct nanosecond
//     read on Apple Silicon (the mach timebase is identity).
//   - `mach_absolute_time()` binds `mach_absolute_time` — the raw tick read.
//   - `poll(fds, nfds, timeout_ms)` binds `poll` — the canonical darwin ms
//     sleep: a nil fd set whose only work is the timeout.
pub boundary trait DarwinClock {
    machine clock_ns(clock_id: u32) -> u64;
    machine mach_absolute_time() -> u64;
    machine poll(fds: u64, nfds: u64, timeout_ms: i32) -> i32;
}

// CLOCK_MONOTONIC (6) counts from boot and keeps ticking through system sleep
// — the Win32 GetTickCount / QueryPerformanceCounter analogue. `MacosClock`
// hard-selects it for every op.
pub data MacosClock {
    rc: i32;
    ns: u64;
    scaled: u64;
    timeout: i32;
}

// `Clock::sleep(ms)` — `poll(NULL, 0, ms)`: fds=0, nfds=0, timeout in
// milliseconds. The narrow is WRAPPING because Win32 `Sleep` takes a DWORD and
// the samples only ever pass small pacing values; the field-local staging
// keeps the host call's argument a plain storage place.
pub macos_arm64 machine MacosClock::sleep(&mut self, milliseconds: u32) {
    self.timeout = narrow_u32_to_i32_wrapping(milliseconds);
    self.rc = darwin_poll(0, 0, self.timeout);
}

// `Clock::get_tick_count()` — milliseconds since boot, low 32 bits (the Win32
// GetTickCount wrap contract: u32 rolls over at ~49.7 days).
pub macos_arm64 machine MacosClock::get_tick_count(&mut self) -> u32 {
    self.ns = darwin_clock_ns(6);
    self.scaled = self.ns / 1000000;
    narrow_u64_to_u32_wrapping(self.scaled)
}

// `Clock::perf_counter()` — the raw nanosecond read (Win32
// QueryPerformanceCounter analogue): MONOTONIC uptime, ns units.
pub macos_arm64 machine MacosClock::perf_counter(&mut self) -> u64 {
    darwin_clock_ns(6)
}

// `Clock::perf_frequency()` — ticks per second for perf_counter. The darwin
// seam reads nanoseconds directly, so the frequency is the constant 10^9.
pub macos_arm64 machine MacosClock::perf_frequency(&mut self) -> u64 {
    transition { _ -> ret() }
    state ret(&mut self) -> u64 { 1000000000 }
}
