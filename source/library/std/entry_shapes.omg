use calling.omg as abi;

// :HostedArgumentAuthority
// A calling policy tells the entry bridge where the OS puts each value.
// These helpers check value shapes and describe placement. To see what the application
// receives, start at samples/cli/arithmetic/bit_shift/build.omg. It binds
// macos_arm64\ProgramEntry to entry_start. dyld supplies argc and argv to
// the physical entry in targets/macos_arm64/entry.omg, yet entry_start()
// in the sample takes zero arguments. Build selects that machine. The
// installed entry contract determines what the bridge must supply to it.
//
// Suppose we wanted to pass the 51st argument to Omega code. Proving
// 50 < argc settles the index. Reading slot 50 also needs a live, readable
// range covering that slot. The slot holds the address of a string. To
// read the string we need evidence covering its bytes, including
// any terminator we scan for. Read access to either range gives us no
// permission to write it.
//
// A target exposing arguments would need an admitted contract for that
// storage. Its adapter could then copy the bytes it can read into owned
// data, or lend them for as long as the backing stays live and readable.
// ProgramStorageEntry in source/library/core/extent.omg currently receives
// grants for the image and initial storage. Neither grant identifies the
// argv table or its strings. Putting an addr and a length in a record
// describes a range and leaves the same access obligations to prove.

machine hosted_entry_integer_shape(shape: @|abi|::ValueShape, bytes: u64) -> bool {
    transition shape.class {
        |abi|::ValueClass::Integer -> integer(shape, bytes),
        _ -> no()
    }
    machine integer(shape: @|abi|::ValueShape, bytes: u64) -> bool {
        shape.byte_size == bytes && shape.alignment == bytes
    }
    machine no() -> bool { false }
}

machine hosted_entry_extent_shape(shape: |abi|::ValueShape, signature: @|abi|::BoundarySignature) -> bool {
    transition shape.class {
        |abi|::ValueClass::Record { first_field, field_count } -> record(shape, first_field, field_count, signature),
        _ -> no()
    }
    machine record(shape: |abi|::ValueShape, first_field: u64, field_count: u64, signature: @|abi|::BoundarySignature) -> bool {
        transition shape.byte_size == 16 && shape.alignment == 8
            && field_count == 2
        {
            true -> record_bounded(signature, first_field),
            _ -> no()
        }
    }
    machine record_bounded(signature: @|abi|::BoundarySignature, first_field: u64) -> bool {
        transition first_field < 255 {
            true -> field_range(signature, first_field),
            _ -> no()
        }
    }
    machine field_range(signature: @|abi|::BoundarySignature, first_field: u64) -> bool
    requires first_field <= 254
    {
        let second_field: u64 = first_field + 1;
        transition second_field < signature.field_count {
            true -> fields(signature, @signature.fields[first_field], @signature.fields[second_field]),
            _ -> no()
        }
    }
    machine fields(signature: @|abi|::BoundarySignature, base: @|abi|::ValueField, length: @|abi|::ValueField) -> bool {
        transition base.byte_offset == 0 && length.byte_offset == 8
            && base.shape < 256 && length.shape < 256
            && base.shape < signature.shape_count && length.shape < signature.shape_count
        {
            true -> words(@signature.shapes[base.shape], @signature.shapes[length.shape]),
            _ -> no()
        }
    }
    machine words(base: @|abi|::ValueShape, length: @|abi|::ValueShape) -> bool {
        hosted_entry_integer_shape(base, 8) && hosted_entry_integer_shape(length, 8)
    }
    machine no() -> bool { false }
}

machine hosted_entry_named_word(bytes: u64, register: |abi|::MachineRegister) -> |abi|::ValuePlacement {
    let mutable value: |abi|::ValuePlacement;
    value.shape.class = |abi|::AbiValueClass::Integer;
    value.shape.byte_size = bytes;
    value.shape.alignment = bytes;
    value.location_count = 1;
    value.locations[0] = |abi|::ValueLocation::Register {
        register: register,
        value_byte_offset: 0, byte_size: bytes,
    };
    value
}

machine hosted_entry_arm_extent_value(first: u64, second: u64) -> |abi|::ValuePlacement {
    // Integer fragments describe ABI placement only. The source application
    // retains the core Extent record, qualifications, and requirement identity.
    let mutable value: |abi|::ValuePlacement;
    value.shape.class = |abi|::AbiValueClass::Integer;
    value.shape.byte_size = 16;
    value.shape.alignment = 8;
    value.location_count = 2;
    value.locations[0] = |abi|::ValueLocation::Register {
        register: |abi|::MachineRegister::Aarch64X { index: first },
        value_byte_offset: 0, byte_size: 8,
    };
    value.locations[1] = |abi|::ValueLocation::Register {
        register: |abi|::MachineRegister::Aarch64X { index: second },
        value_byte_offset: 8, byte_size: 8,
    };
    value
}

machine hosted_entry_register_extent_value(first: |abi|::MachineRegister, second: |abi|::MachineRegister) -> |abi|::ValuePlacement {
    // Integer fragments describe ABI placement only. The source application
    // retains the core Extent record, qualifications, and requirement identity.
    let mutable value: |abi|::ValuePlacement;
    value.shape.class = |abi|::AbiValueClass::Integer;
    value.shape.byte_size = 16;
    value.shape.alignment = 8;
    value.location_count = 2;
    value.locations[0] = |abi|::ValueLocation::Register {
        register: first,
        value_byte_offset: 0, byte_size: 8,
    };
    value.locations[1] = |abi|::ValueLocation::Register {
        register: second,
        value_byte_offset: 8, byte_size: 8,
    };
    value
}

// The AAPCS64 caller-saved banks on platforms that reserve x18 (Apple and
// Windows): x0-x17, v0-v7 and v16-v31. Callee-saved x19-x29 and v8-v15 and
// the platform register stay out of the set.
machine hosted_entry_aarch64_platform_clobbers() -> |abi|::RegisterSet {
    let mutable set: |abi|::RegisterSet;
    set.register_count = 42;
    set.registers[0] = |abi|::MachineRegister::Aarch64X { index: 0 };
    set.registers[1] = |abi|::MachineRegister::Aarch64X { index: 1 };
    set.registers[2] = |abi|::MachineRegister::Aarch64X { index: 2 };
    set.registers[3] = |abi|::MachineRegister::Aarch64X { index: 3 };
    set.registers[4] = |abi|::MachineRegister::Aarch64X { index: 4 };
    set.registers[5] = |abi|::MachineRegister::Aarch64X { index: 5 };
    set.registers[6] = |abi|::MachineRegister::Aarch64X { index: 6 };
    set.registers[7] = |abi|::MachineRegister::Aarch64X { index: 7 };
    set.registers[8] = |abi|::MachineRegister::Aarch64X { index: 8 };
    set.registers[9] = |abi|::MachineRegister::Aarch64X { index: 9 };
    set.registers[10] = |abi|::MachineRegister::Aarch64X { index: 10 };
    set.registers[11] = |abi|::MachineRegister::Aarch64X { index: 11 };
    set.registers[12] = |abi|::MachineRegister::Aarch64X { index: 12 };
    set.registers[13] = |abi|::MachineRegister::Aarch64X { index: 13 };
    set.registers[14] = |abi|::MachineRegister::Aarch64X { index: 14 };
    set.registers[15] = |abi|::MachineRegister::Aarch64X { index: 15 };
    set.registers[16] = |abi|::MachineRegister::Aarch64X { index: 16 };
    set.registers[17] = |abi|::MachineRegister::Aarch64X { index: 17 };
    set.registers[18] = |abi|::MachineRegister::Aarch64V { index: 0 };
    set.registers[19] = |abi|::MachineRegister::Aarch64V { index: 1 };
    set.registers[20] = |abi|::MachineRegister::Aarch64V { index: 2 };
    set.registers[21] = |abi|::MachineRegister::Aarch64V { index: 3 };
    set.registers[22] = |abi|::MachineRegister::Aarch64V { index: 4 };
    set.registers[23] = |abi|::MachineRegister::Aarch64V { index: 5 };
    set.registers[24] = |abi|::MachineRegister::Aarch64V { index: 6 };
    set.registers[25] = |abi|::MachineRegister::Aarch64V { index: 7 };
    set.registers[26] = |abi|::MachineRegister::Aarch64V { index: 16 };
    set.registers[27] = |abi|::MachineRegister::Aarch64V { index: 17 };
    set.registers[28] = |abi|::MachineRegister::Aarch64V { index: 18 };
    set.registers[29] = |abi|::MachineRegister::Aarch64V { index: 19 };
    set.registers[30] = |abi|::MachineRegister::Aarch64V { index: 20 };
    set.registers[31] = |abi|::MachineRegister::Aarch64V { index: 21 };
    set.registers[32] = |abi|::MachineRegister::Aarch64V { index: 22 };
    set.registers[33] = |abi|::MachineRegister::Aarch64V { index: 23 };
    set.registers[34] = |abi|::MachineRegister::Aarch64V { index: 24 };
    set.registers[35] = |abi|::MachineRegister::Aarch64V { index: 25 };
    set.registers[36] = |abi|::MachineRegister::Aarch64V { index: 26 };
    set.registers[37] = |abi|::MachineRegister::Aarch64V { index: 27 };
    set.registers[38] = |abi|::MachineRegister::Aarch64V { index: 28 };
    set.registers[39] = |abi|::MachineRegister::Aarch64V { index: 29 };
    set.registers[40] = |abi|::MachineRegister::Aarch64V { index: 30 };
    set.registers[41] = |abi|::MachineRegister::Aarch64V { index: 31 };
    set
}
