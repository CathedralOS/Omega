use calling.omg as abi;

// Fixed, nonvariadic Darwin ARM64 C calls with scalar arguments only.
// Apple packs stack arguments at their natural alignment, without an eight-byte
// minimum slot. The complete outgoing stack still has sixteen-byte alignment.
// Registers and results admit 32/64-bit integers; narrow stack lanes remain
// exact. Narrow register scalars need separate caller-extension evidence.
// https://developer.apple.com/documentation/xcode/writing-arm64-code-for-apple-platforms

public DarwinArm64ScalarCalling satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        let mutable plan: |abi|::BoundaryEntryPlan = darwin_arm64_entry();
        let accepted: bool = darwin_arm64_scalar_signature(@signature, @mutable plan);
        transition accepted {
            true -> |abi|::BoundaryPlanResult::Accepted { plan: plan },
            _ -> |abi|::BoundaryPlanResult::Rejected { reason: |abi|::CallingPolicyRejection {
                reason: "expected at most 32 fixed integer or sized-reference parameters, Unit or 32/64-bit integer result, at least 32-bit register scalars, and no callbacks" as + |abi|::Utf8
            } }
        }
    }
}

machine darwin_arm64_scalar_signature(signature: @|abi|::BoundarySignature,
    plan: @mutable |abi|::BoundaryEntryPlan) -> bool {
    transition signature.parameter_count == signature.native_parameter_count
        && signature.parameter_count <= 32 && signature.callback_binder_count == 0
        && signature.callback_demand_count == 0 {
        true -> result(signature, plan),
        _ -> false
    }
    machine result(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan) -> bool {
        plan.call.parameter_count = signature.parameter_count;
        transition signature.has_result {
            true -> result_index(signature, plan),
            _ -> darwin_arm64_scalar_parameters(signature, plan, 0, 0, 32)
        }
    }
    machine result_index(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan) -> bool {
        transition signature.result < signature.shape_count && signature.result < 256 {
            true -> result_shape(signature, plan, @signature.shapes[signature.result]),
            _ -> false
        }
    }
    machine result_shape(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        shape: @|abi|::ValueShape) -> bool {
        transition shape.class {
            |abi|::ValueClass::Integer -> result_integer(signature, plan, shape),
            _ -> false
        }
    }
    machine result_integer(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        shape: @|abi|::ValueShape) -> bool {
        transition (shape.byte_size == 4 || shape.byte_size == 8) && shape.alignment == shape.byte_size {
            true -> result_place(signature, plan, shape),
            _ -> false
        }
    }
    machine result_place(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        shape: @|abi|::ValueShape) -> bool {
        plan.call.has_result = true;
        plan.call.result.shape = |abi|::AbiValueShape {
            class: |abi|::AbiValueClass::Integer, byte_size: shape.byte_size, alignment: shape.alignment
        };
        plan.call.result.location_count = 1;
        plan.call.result.locations[0] = |abi|::ValueLocation::Register {
            register: |abi|::MachineRegister::Aarch64X { index: 0 }, value_byte_offset: 0, byte_size: shape.byte_size
        };
        darwin_arm64_scalar_parameters(signature, plan, 0, 0, 32)
    }
}

machine darwin_arm64_integer_shape(shape: @|abi|::ValueShape) -> bool {
    (shape.byte_size == 1 || shape.byte_size == 2 || shape.byte_size == 4
        || shape.byte_size == 8) && shape.alignment == shape.byte_size
}

machine darwin_arm64_scalar_parameters(signature: @|abi|::BoundarySignature,
    plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, stack: u64, remaining: u64) -> bool
requires stack <= 256
terminates by remaining
{
    let next_stack: u64 = darwin_arm64_scalar_parameter(signature, plan, ordinal, stack);
    transition {
        ordinal == signature.parameter_count -> (next_stack <= 256),
        ordinal < 32 && remaining > 0 && next_stack <= 256 ->
            darwin_arm64_scalar_parameters(signature, plan, ordinal + 1, next_stack, remaining - 1),
        _ -> false
    }
}

// 257 is a rejected-shape sentinel; accepted stack extents stay bounded by
// 32 * 8 bytes. No rejected partial plan escapes the policy's result.
machine darwin_arm64_scalar_parameter(signature: @|abi|::BoundarySignature,
    plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, stack: u64) -> u64
requires stack <= 256
{
    transition {
        ordinal == signature.parameter_count -> stack,
        ordinal < signature.parameter_count && ordinal < 32 ->
            root(signature, plan, ordinal, stack, signature.parameters[ordinal]),
        _ -> 257
    }
    machine root(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        ordinal: u64, stack: u64, root: u64) -> u64
    requires ordinal < 32, stack <= 256
    {
        transition root < signature.shape_count && root < 256 {
            true -> shape(plan, ordinal, stack, @signature.shapes[root]),
            _ -> 257
        }
    }
    machine shape(plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64,
        stack: u64, shape: @|abi|::ValueShape) -> u64
    requires ordinal < 32, stack <= 256
    {
        transition shape.class {
            |abi|::ValueClass::Integer -> integer(plan, ordinal, stack, shape),
            |abi|::ValueClass::Reference -> reference(plan, ordinal, stack, shape),
            _ -> 257
        }
    }
    machine integer(plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64,
        stack: u64, shape: @|abi|::ValueShape) -> u64
    requires ordinal < 32, stack <= 256
    {
        transition darwin_arm64_integer_shape(shape) {
            true -> place(plan, ordinal, stack, shape),
            _ -> 257
        }
    }
    machine reference(plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64,
        stack: u64, shape: @|abi|::ValueShape) -> u64
    requires ordinal < 32, stack <= 256
    {
        transition shape.byte_size == 8 && shape.alignment == 8 {
            true -> place(plan, ordinal, stack, shape),
            _ -> 257
        }
    }
    machine place(plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64,
        stack: u64, shape: @|abi|::ValueShape) -> u64
    requires ordinal < 32, stack <= 256
    {
        plan.call.parameters[ordinal].shape = |abi|::AbiValueShape {
            class: |abi|::AbiValueClass::Integer, byte_size: shape.byte_size, alignment: shape.alignment
        };
        plan.call.parameters[ordinal].location_count = 1;
        transition ordinal < 8 {
            true -> register_shape(plan, ordinal, stack, shape),
            _ -> stack_shape(plan, ordinal, stack, shape)
        }
    }
    machine register_shape(plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64,
        stack: u64, shape: @|abi|::ValueShape) -> u64
    requires ordinal < 8
    {
        transition shape.byte_size == 4 || shape.byte_size == 8 {
            true -> register(plan, ordinal, stack, shape.byte_size),
            _ -> 257
        }
    }
    machine register(plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64,
        stack: u64, size: u64) -> u64
    requires ordinal < 8
    {
        plan.call.parameters[ordinal].locations[0] = |abi|::ValueLocation::Register {
            register: |abi|::MachineRegister::Aarch64X { index: ordinal }, value_byte_offset: 0, byte_size: size
        };
        stack
    }
    machine stack_shape(plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64,
        stack: u64, shape: @|abi|::ValueShape) -> u64
    requires ordinal < 32, stack <= 256
    {
        transition shape.alignment > 0 && shape.alignment <= 8 && shape.byte_size <= 8 {
            true -> stack_place(plan, ordinal, stack, shape.byte_size, shape.alignment),
            _ -> 257
        }
    }
    machine stack_place(plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64,
        stack: u64, size: u64, alignment: u64) -> u64
    requires ordinal < 32, stack <= 256, alignment > 0 && alignment <= 8, size <= 8
    {
        let offset: u64 = ((stack + alignment - 1) / alignment) * alignment;
        plan.call.parameters[ordinal].locations[0] = |abi|::ValueLocation::Stack {
            stack_byte_offset: offset, value_byte_offset: 0, byte_size: size, alignment: alignment
        };
        offset + size
    }
}

// Shared ordinary Darwin entry and clobber promise, unchanged from the byte-view
// policy. Each policy fills only its own parameter and result placements.
public machine darwin_arm64_entry() -> |abi|::BoundaryEntryPlan
{
    let mutable plan: |abi|::BoundaryEntryPlan;
    plan.call.convention = |abi|::CallingConvention::DarwinAapcs64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = |abi|::EntryControl::CallReturn;
    plan.state.initial_regime = |abi|::MachineRegime::Aarch64A64 { exception_level: 0 };
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = |abi|::EntryStack::ProviderSelected;
    plan.state.preemption = |abi|::Preemption::NotApplicable;
    plan.call.ordinary_clobbers.registers[0] = |abi|::MachineRegister::Aarch64X { index: 0 };
    plan.call.ordinary_clobbers.registers[1] = |abi|::MachineRegister::Aarch64X { index: 1 };
    plan.call.ordinary_clobbers.registers[2] = |abi|::MachineRegister::Aarch64X { index: 2 };
    plan.call.ordinary_clobbers.registers[3] = |abi|::MachineRegister::Aarch64X { index: 3 };
    plan.call.ordinary_clobbers.registers[4] = |abi|::MachineRegister::Aarch64X { index: 4 };
    plan.call.ordinary_clobbers.registers[5] = |abi|::MachineRegister::Aarch64X { index: 5 };
    plan.call.ordinary_clobbers.registers[6] = |abi|::MachineRegister::Aarch64X { index: 6 };
    plan.call.ordinary_clobbers.registers[7] = |abi|::MachineRegister::Aarch64X { index: 7 };
    plan.call.ordinary_clobbers.registers[8] = |abi|::MachineRegister::Aarch64X { index: 8 };
    plan.call.ordinary_clobbers.registers[9] = |abi|::MachineRegister::Aarch64X { index: 9 };
    plan.call.ordinary_clobbers.registers[10] = |abi|::MachineRegister::Aarch64X { index: 10 };
    plan.call.ordinary_clobbers.registers[11] = |abi|::MachineRegister::Aarch64X { index: 11 };
    plan.call.ordinary_clobbers.registers[12] = |abi|::MachineRegister::Aarch64X { index: 12 };
    plan.call.ordinary_clobbers.registers[13] = |abi|::MachineRegister::Aarch64X { index: 13 };
    plan.call.ordinary_clobbers.registers[14] = |abi|::MachineRegister::Aarch64X { index: 14 };
    plan.call.ordinary_clobbers.registers[15] = |abi|::MachineRegister::Aarch64X { index: 15 };
    plan.call.ordinary_clobbers.registers[16] = |abi|::MachineRegister::Aarch64X { index: 16 };
    plan.call.ordinary_clobbers.registers[17] = |abi|::MachineRegister::Aarch64X { index: 17 };
    plan.call.ordinary_clobbers.registers[18] = |abi|::MachineRegister::Aarch64V { index: 0 };
    plan.call.ordinary_clobbers.registers[19] = |abi|::MachineRegister::Aarch64V { index: 1 };
    plan.call.ordinary_clobbers.registers[20] = |abi|::MachineRegister::Aarch64V { index: 2 };
    plan.call.ordinary_clobbers.registers[21] = |abi|::MachineRegister::Aarch64V { index: 3 };
    plan.call.ordinary_clobbers.registers[22] = |abi|::MachineRegister::Aarch64V { index: 4 };
    plan.call.ordinary_clobbers.registers[23] = |abi|::MachineRegister::Aarch64V { index: 5 };
    plan.call.ordinary_clobbers.registers[24] = |abi|::MachineRegister::Aarch64V { index: 6 };
    plan.call.ordinary_clobbers.registers[25] = |abi|::MachineRegister::Aarch64V { index: 7 };
    plan.call.ordinary_clobbers.registers[26] = |abi|::MachineRegister::Aarch64V { index: 16 };
    plan.call.ordinary_clobbers.registers[27] = |abi|::MachineRegister::Aarch64V { index: 17 };
    plan.call.ordinary_clobbers.registers[28] = |abi|::MachineRegister::Aarch64V { index: 18 };
    plan.call.ordinary_clobbers.registers[29] = |abi|::MachineRegister::Aarch64V { index: 19 };
    plan.call.ordinary_clobbers.registers[30] = |abi|::MachineRegister::Aarch64V { index: 20 };
    plan.call.ordinary_clobbers.registers[31] = |abi|::MachineRegister::Aarch64V { index: 21 };
    plan.call.ordinary_clobbers.registers[32] = |abi|::MachineRegister::Aarch64V { index: 22 };
    plan.call.ordinary_clobbers.registers[33] = |abi|::MachineRegister::Aarch64V { index: 23 };
    plan.call.ordinary_clobbers.registers[34] = |abi|::MachineRegister::Aarch64V { index: 24 };
    plan.call.ordinary_clobbers.registers[35] = |abi|::MachineRegister::Aarch64V { index: 25 };
    plan.call.ordinary_clobbers.registers[36] = |abi|::MachineRegister::Aarch64V { index: 26 };
    plan.call.ordinary_clobbers.registers[37] = |abi|::MachineRegister::Aarch64V { index: 27 };
    plan.call.ordinary_clobbers.registers[38] = |abi|::MachineRegister::Aarch64V { index: 28 };
    plan.call.ordinary_clobbers.registers[39] = |abi|::MachineRegister::Aarch64V { index: 29 };
    plan.call.ordinary_clobbers.registers[40] = |abi|::MachineRegister::Aarch64V { index: 30 };
    plan.call.ordinary_clobbers.registers[41] = |abi|::MachineRegister::Aarch64V { index: 31 };
    plan.call.ordinary_clobbers.register_count = 42;
    plan
}
