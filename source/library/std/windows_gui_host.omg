use omega::language::core::WindowManagement;
use omega::language::core::SurfacePresentation;
use omega::language::core::WindowEventObservation;
use omega::language::core::WindowEventDispatch;
use omega::language::core::GlobalInputObservation;
use omega::language::core::ClockObservation;
use omega::language::core::ExecutionDelay;
use omega::language::core::NativeCodeExecution;
use omega::language::core::FilesystemContentRead;
use omega::language::core::FilesystemContentWrite;
use omega::language::core::FilesystemMetadataQuery;
use omega::language::core::FilesystemMetadataMutation;
use omega::language::core::DirectoryEnumeration;
use omega::language::core::FilesystemNamespaceMutation;
use omega::language::core::ProcessInput;
use omega::language::core::ProcessOutput;
use omega::language::core::ProcessExit;
// The Windows window and thread-message service. Handles and message storage
// belong to the caller; the provider keeps no virtual desktop or hidden state.
// Class and title use the Windows ANSI API encoding and include a terminating
// NUL byte. Empty or unterminated views refuse creation before entering user32.

// Win64 MSG has 48 bytes with pointer alignment. The exact native layout stays
// opaque to callers; PeekMessage fills it and Translate/Dispatch consume it.
public data WindowsMessage { words: [u64; 6]; }
public data WindowsRectangle { left: i32; top: i32; right: i32; bottom: i32; }

// Win64 MSG stores HWND at byte 0, UINT message at byte 8 (followed by
// padding), and WPARAM at byte 16. Inspect only after a successful pump.
public machine WindowsMessage::window(message: &WindowsMessage) -> u64 {
    message.words[0]
}
public machine WindowsMessage::kind(message: &WindowsMessage) -> u64 {
    message.words[1] & 0xFFFF_FFFF
}
public machine WindowsMessage::word_parameter(message: &WindowsMessage) -> u64 {
    message.words[2]
}

public boundary trait WindowsGuiHost {
    machine window_create(class_name: &[u8], title: &[u8], style: u32,
        x: i32, y: i32, width: i32, height: i32) -> u64 reaches
            NativeCodeExecution + WindowManagement + SurfacePresentation +
            WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
            ClockObservation + ExecutionDelay + FilesystemContentRead +
            FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
            DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
            ProcessOutput + ProcessExit
    invokes WindowsGuiIo
    crashes none;
    machine foreground_window() -> u64 reaches WindowManagement
    invokes WindowsGuiIo
    crashes none;
    machine is_window(window: u64) -> bool reaches WindowManagement
    invokes WindowsGuiIo
    crashes none;
    machine window_destroy(window: u64) -> bool reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit
    invokes WindowsGuiIo
    crashes none;
    // Remove at most one message from this thread, translate and dispatch it.
    // A false result means the queue had no message; this operation never waits.
    machine pump_message(message: &mut WindowsMessage) -> bool reaches
        NativeCodeExecution + WindowManagement + SurfacePresentation +
        WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
        ClockObservation + ExecutionDelay + FilesystemContentRead +
        FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
        DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
        ProcessOutput + ProcessExit
    invokes WindowsGuiIo
    crashes none;
    // Add native frame metrics to the requested client size. Windows may
    // enforce its own minimum window size during creation.
    machine window_create_client(class_name: &[u8], title: &[u8], style: u32,
        x: i32, y: i32, width: i32, height: i32) -> u64 reaches
            NativeCodeExecution + WindowManagement + SurfacePresentation +
            WindowEventObservation + WindowEventDispatch + GlobalInputObservation +
            ClockObservation + ExecutionDelay + FilesystemContentRead +
            FilesystemContentWrite + FilesystemMetadataQuery + FilesystemMetadataMutation +
            DirectoryEnumeration + FilesystemNamespaceMutation + ProcessInput +
            ProcessOutput + ProcessExit
    invokes WindowsGuiIo
    crashes none;
    machine get_dc(window: u64) -> u64 reaches
        SurfacePresentation + FilesystemContentRead + FilesystemContentWrite +
        FilesystemMetadataQuery + FilesystemMetadataMutation + DirectoryEnumeration +
        FilesystemNamespaceMutation
        crashes none;
    machine release_dc(window: u64, device: u64) -> i32 reaches
        SurfacePresentation + FilesystemContentRead + FilesystemContentWrite +
        FilesystemMetadataQuery + FilesystemMetadataMutation + DirectoryEnumeration +
        FilesystemNamespaceMutation
        crashes none;
    machine client_rectangle(window: u64, rectangle: &mut WindowsRectangle) -> i32 reaches WindowManagement crashes none;
    // The caller lends live BITMAPINFO and pixel storage for this synchronous call.
    machine stretch_dibits(device: u64, destination_x: i32, destination_y: i32,
        destination_width: i32, destination_height: i32, source_x: i32, source_y: i32,
        source_width: i32, source_height: i32, pixels: &i32, info: &i32,
        usage: u32, raster_operation: u32) -> i32 reaches
            SurfacePresentation + FilesystemContentRead + FilesystemContentWrite +
            FilesystemMetadataQuery + FilesystemMetadataMutation + DirectoryEnumeration +
            FilesystemNamespaceMutation
        crashes none;
    // Asynchronous virtual-key state. One means the key was down at call time;
    // the raw pressed-since-last-call latch of GetAsyncKeyState is discarded.
    machine key_state(virtual_key: u32) -> u64 reaches GlobalInputObservation
    invokes WindowsGuiIo
    crashes none;
}
