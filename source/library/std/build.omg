    Build::bind<PosixFilesystemDarwin::c_remove_dir>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_rmdir"
        } });
    Build::bind<PosixFilesystemDarwin::c_create_dir_name>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_mkdir"
        } });
    Build::bind<PosixFilesystemDarwin::c_open_at>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_openat"
        } });
    Build::bind<PosixFilesystemDarwin::c_unlink_at>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_unlinkat"
