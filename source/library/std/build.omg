use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::package(builder, "omega_language_std");
    configure_clock(builder);
    configure_macos_image(builder);
    // Bind the complete ObjectiveC family once. String extents stay static.
    Build::bind<ObjectiveC::get_class>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_getClass"
        }
    });
    Build::bind<ObjectiveC::register_selector>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_sel_registerName"
        }
    });
    Build::bind<ObjectiveC::send_string>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_byte_string>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_scalar>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_delayed>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_rect>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_image_size>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_scalar4>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::pool_push>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_autoreleasePoolPush"
        }
    });
    Build::bind<ObjectiveC::pool_pop>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_autoreleasePoolPop"
        }
    });
}

// Package-local raw supply follows the checked provider closure. Applications
// use Clock without repeating imports or naming the dependency's private seams.
// Forward the activation's original Build value through this ordinary helper.
machine configure_clock(builder: &mut Build) {
    Build::bind<Clock::sleep>(builder, windows_x86_64,
        ForeignBinding::DllImport { import: DllImport::PeByName {
            library: "kernel32.dll", export: "Sleep"
        } });

    Build::select_provider<Clock, DarwinClock>(builder, macos_arm64);
    Build::bind<DarwinClockWait::poll>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_poll"
        } });

    Build::select_provider<Clock, LinuxX8664Clock>(builder, linux_x86_64);
    Build::bind<LinuxClockWait::poll>(builder, linux_x86_64,
        ForeignBinding::Syscall { number: 7 });

    Build::select_provider<Clock, LinuxArm64Clock>(builder, linux_arm64);
    Build::bind<LinuxArmClockWait::nanosleep>(builder, linux_arm64,
        ForeignBinding::Syscall { number: 101 });
}

// Native object storage belongs to the image module; the original Build value
// records its exact requirements and locators for the macOS deployment target.
machine configure_macos_image(builder: &mut Build) {
    Build::bind<MacosImageData::copy>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation",
            symbol: "_CFDataCreate"
        } });
    Build::bind<MacosImageObjects::provider>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics",
            symbol: "_CGDataProviderCreateWithCFData"
        } });
    Build::bind<MacosImageObjects::release_data>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation",
            symbol: "_CFRelease"
        } });
    Build::bind<MacosImageObjects::release_provider>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics",
            symbol: "_CGDataProviderRelease"
        } });
    Build::bind<MacosImageObjects::create>(builder, macos_arm64,
        ForeignBinding::DllImport { import: DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics",
            symbol: "_CGImageCreate"
        } });
}
