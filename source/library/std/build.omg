use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::package(builder, "omega_language_std");
    // Bind each generic string family once; Count is not a native argument.
    Build::bind<macos_gui::ObjectiveC::get_class>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_getClass"
        }
    });
    Build::bind<macos_gui::ObjectiveC::register_selector>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_sel_registerName"
        }
    });
    Build::bind<macos_gui::ObjectiveC::send_string>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<macos_gui::ObjectiveC::send_byte_string>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
}
