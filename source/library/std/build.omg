use omega::language::core::external_binding;
machine build(builder: &mut Build) {
    Build::package(builder, "omega_language_std");
    // Bind the complete ObjectiveC family once. String extents stay static.
    Build::bind<ObjectiveC::get_class>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_getClass"
        }
    });
    Build::bind<ObjectiveC::register_selector>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_sel_registerName"
        }
    });
    Build::bind<ObjectiveC::send_string>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_byte_string>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_scalar>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_delayed>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_rect>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_image_size>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::send_scalar4>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind<ObjectiveC::pool_push>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_autoreleasePoolPush"
        }
    });
    Build::bind<ObjectiveC::pool_pop>(builder, macos_arm64, ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_autoreleasePoolPop"
        }
    });
}
