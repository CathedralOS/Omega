// Portable filesystem values and one routed service slot. Target adapters own
// raw descriptors, flags, foreign record layouts and operation scratch.
// The complete portable provider covers both Linux architectures and macos_arm64. Other hosts
// retain their independent raw services and have no portable default yet.

use filesystem_host;
use windows_filesystem_host;
use omega::language::core::filesystem_authority;
use omega::language::core::numeric_conversion;


pub data File [copy] {
    handle: u64;
}

pub data ErrorKind [copy] {
    case Other;
    case NotFound;
    case PermissionDenied;
    case AlreadyExists;
    case BadDescriptor;
    case IsADirectory;
    case WouldBlock;
    case Unsupported;
    case InvalidInput;
    case WriteZero;
}

machine ErrorKind::reconstruct(error_kind: &ErrorKind) -> ErrorKind {
    transition error_kind {
        ErrorKind::Other -> ErrorKind::Other
        ErrorKind::NotFound -> ErrorKind::NotFound
        ErrorKind::PermissionDenied -> ErrorKind::PermissionDenied
        ErrorKind::AlreadyExists -> ErrorKind::AlreadyExists
        ErrorKind::BadDescriptor -> ErrorKind::BadDescriptor
        ErrorKind::IsADirectory -> ErrorKind::IsADirectory
        ErrorKind::WouldBlock -> ErrorKind::WouldBlock
        ErrorKind::Unsupported -> ErrorKind::Unsupported
        ErrorKind::InvalidInput -> ErrorKind::InvalidInput
        ErrorKind::WriteZero -> ErrorKind::WriteZero
    }
}

pub data OpenResult {
    case Error(kind: ErrorKind);
    case Ok(file: File);
}
pub data IoResult {
    case Error(kind: ErrorKind);
    case Ok(count: u64);
}

pub data DirStats [copy] {
    entries: u64;
    subdirs: u64;
    files: u64;
}
pub data DirStatsResult {
    case Error(kind: ErrorKind);
    case Ok(stats: DirStats);
}

pub data DirEntry [copy] {
    name: [u8; 256];
    name_len: u64;
    is_dir: bool;
    is_file: bool;
}

pub data DirEntryResult {
    case Error(kind: ErrorKind);
    case End;
    case Ok(entry: DirEntry);
}

pub data EmptyResult {
    case Error(kind: ErrorKind);
    case Empty;
    case NonEmpty;
}
pub data UnitResult {
    case Error(kind: ErrorKind);
    case Ok;
}

pub data ExistsResult {
    case Error(kind: ErrorKind);
    case No;
    case Yes;
}

pub data TryLockResult {
    case Error(kind: ErrorKind);
    case WouldBlock;
    case Unsupported;
    case InvalidInput;
    case WriteZero;
    case Acquired;
}

pub data OpenOptions [copy] {
    read: bool;
    write: bool;
    append: bool;
    truncate: bool;

    create: bool;
    create_new: bool;
}

// Zero requests the target's default writable-file permissions. Readonly is a
// portable request; a numeric POSIX mode is explicitly an OS-family extension,
// not a fictional Windows ACL or an encoding of its read-only attribute.
pub data Permissions [copy] {
    case Default;
    case Readonly(value: bool);
    case Posix(mode: u32);
}

pub machine Permissions::readonly(permissions: &Permissions) -> bool {
    transition permissions {
        Permissions::Default -> false
        Permissions::Readonly { value } -> (value)
        Permissions::Posix { mode } -> ((mode & 146) == 0)
    }
}

pub machine Permissions::set_readonly(permissions: &mut Permissions, readonly: bool) {
    transition permissions {
        Permissions::Posix { mode } -> posix(permissions, mode, readonly)
        _ -> portable(permissions, readonly)
    }
    state posix(permissions: &mut Permissions, mode: u32, readonly: bool) {
        let updated: u32 = posix_mode_with_readonly(mode, readonly);
        permissions = Permissions::Posix { mode: updated };
    }
    state portable(permissions: &mut Permissions, readonly: bool) {
        permissions = Permissions::Readonly { value: readonly };
    }
}

// Change only write bits, retaining sticky/set-ID and other mode bits. The
// POSIX adapter uses the same operation for a portable read-only request.
machine posix_mode_with_readonly(mode: u32, readonly: bool) -> u32 {
    transition readonly { true -> (mode & 4294967149) false -> (mode | 146) }
}

// Not every native metadata record contains a creation timestamp. Keep that
// absence distinct from the Unix epoch and from a failed metadata query.
pub data TimestampResult [copy] {
    case Error(kind: ErrorKind);
    case Ok(seconds: i64);
}

pub data FileKind [copy] {
    case Other;
    case File;
    case Directory;
    case Symlink;
    case CharacterDevice;
    case BlockDevice;
    case Fifo;
    case Socket;
}

// POSIX identities and allocation geometry are not universal file properties.
// Keep genuine zero values (including UID/GID 0 and inline allocation) distinct
// from unavailable information. Windows cannot manufacture these as zero or
// truncate a native 128-bit file identifier into the POSIX inode field.
pub data PosixMetadata [copy] {
    mode: u32;
    ino: u64;
    dev: u64;
    uid: u32;
    gid: u32;
    rdev: u64;
    blocks: u64;
    blksize: u64;
}
pub data PosixMetadataResult [copy] {
    case Error(kind: ErrorKind);
    case Ok(details: PosixMetadata);
}

pub data Metadata [copy] {
    len: i64;
    kind: FileKind;
    permissions: Permissions;
    nlink: u64;
    posix: PosixMetadataResult;
    modified_secs: i64;
    accessed_secs: i64;
    creation_time: TimestampResult;
    changed_secs: i64;
}

pub machine Metadata::is_file(metadata: &Metadata) -> bool {
    transition metadata.kind { FileKind::File -> true _ -> false }
}
pub machine Metadata::is_dir(metadata: &Metadata) -> bool {
    transition metadata.kind { FileKind::Directory -> true _ -> false }
}
pub machine Metadata::is_symlink(metadata: &Metadata) -> bool {
    transition metadata.kind { FileKind::Symlink -> true _ -> false }
}

pub machine Metadata::is_char_device(metadata: &Metadata) -> bool {
    transition metadata.kind { FileKind::CharacterDevice -> true _ -> false }
}
pub machine Metadata::is_block_device(metadata: &Metadata) -> bool {
    transition metadata.kind { FileKind::BlockDevice -> true _ -> false }
}
pub machine Metadata::is_fifo(metadata: &Metadata) -> bool {
    transition metadata.kind { FileKind::Fifo -> true _ -> false }
}
pub machine Metadata::is_socket(metadata: &Metadata) -> bool {
    transition metadata.kind { FileKind::Socket -> true _ -> false }
}

pub machine Metadata::readonly(metadata: &Metadata) -> bool {
    Permissions::readonly(&metadata.permissions)
}

pub machine Metadata::permissions(metadata: &Metadata) -> Permissions {
    metadata.permissions
}

pub machine Metadata::nlink(metadata: &Metadata) -> u64 {
    metadata.nlink
}

pub machine Metadata::posix(metadata: &Metadata) -> PosixMetadataResult {
    metadata.posix
}

pub machine Metadata::changed(metadata: &Metadata) -> i64 {
    metadata.changed_secs
}

pub machine Metadata::modified(metadata: &Metadata) -> i64 {
    metadata.modified_secs
}

pub machine Metadata::accessed(metadata: &Metadata) -> i64 {
    metadata.accessed_secs
}

pub machine Metadata::created(metadata: &Metadata) -> TimestampResult {
    metadata.creation_time
}
pub data MetadataResult {
    case Error(kind: ErrorKind);
    case Ok(meta: Metadata);
}

use posix_filesystem_adapter;

pub data Filesystem {}

pub boundary trait FilesystemService {
    machine create(path: &[u8] in Path) -> OpenResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine create_new(path: &[u8] in Path) -> OpenResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine open(path: &[u8] in Path) -> OpenResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine append(path: &[u8] in Path) -> OpenResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine read(file: File, buffer: &mut [u8], count: u64) -> IoResult
    reaches FilesystemContentRead
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine write(file: File, bytes: &[u8]) -> IoResult
    reaches FilesystemContentWrite
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine close(file: File) -> UnitResult

    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine write_all(path: &[u8] in Path, bytes: &[u8]) -> UnitResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine read_all(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> IoResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine copy(from: &[u8] in Path, to: &[u8] in Path, buffer: &mut [u8], cap: u64) -> IoResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine exists(path: &[u8] in Path) -> bool
    reaches FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine try_exists(path: &[u8] in Path) -> ExistsResult
    reaches FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine metadata_path(path: &[u8] in Path) -> MetadataResult
    reaches FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine symlink_metadata(path: &[u8] in Path) -> MetadataResult
    reaches FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine remove(path: &[u8] in Path) -> UnitResult
    reaches FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine create_dir(path: &[u8] in Path) -> UnitResult
    reaches FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine remove_dir(path: &[u8] in Path) -> UnitResult
    reaches FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine create_dir_all(path: &[u8] in Path) -> UnitResult
    reaches FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine read_dir_is_empty(path: &[u8] in Path) -> EmptyResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration + FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine set_permissions(path: &[u8] in Path, perms: Permissions) -> UnitResult
        reaches FilesystemMetadataQuery + FilesystemMetadataMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine symlink(target: &[u8] in Path, link: &[u8] in Path) -> UnitResult
    reaches FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine read_link(path: &[u8] in Path, buffer: &mut [u8], count: u64) -> IoResult
    reaches FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine set_file_permissions(file: File, perms: Permissions) -> UnitResult
        reaches FilesystemMetadataQuery + FilesystemMetadataMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine rename(from: &[u8] in Path, to: &[u8] in Path) -> UnitResult
    reaches FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine set_len(file: File, length: i64) -> UnitResult
    reaches FilesystemContentWrite + FilesystemMetadataMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine sync(file: File) -> UnitResult

    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine sync_data(file: File) -> UnitResult

    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine try_clone(file: File) -> OpenResult

    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine set_owner(path: &[u8] in Path, uid: i32, gid: i32) -> UnitResult
    reaches FilesystemMetadataMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine set_owner_no_follow(path: &[u8] in Path, uid: i32, gid: i32) -> UnitResult
    reaches FilesystemMetadataMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine set_file_owner(file: File, uid: i32, gid: i32) -> UnitResult
    reaches FilesystemMetadataMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine metadata(file: File) -> MetadataResult
    reaches FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine open_with(path: &[u8] in Path, options: OpenOptions) -> OpenResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine read_dir_count(path: &[u8] in Path) -> IoResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine read_dir_nth(path: &[u8] in Path, n: u64) -> DirEntryResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration + FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine remove_dir_all(path: &[u8] in Path) -> UnitResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration + FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine read_at(file: File, buffer: &mut [u8], count: u64, offset: i64) -> IoResult
    reaches FilesystemContentRead
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine write_at(file: File, bytes: &[u8], offset: i64) -> IoResult
    reaches FilesystemContentWrite
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine hard_link(original: &[u8] in Path, link: &[u8] in Path) -> UnitResult
    reaches FilesystemNamespaceMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine set_times(file: File, accessed: i64, modified: i64) -> UnitResult
    reaches FilesystemMetadataMutation
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine canonicalize(path: &[u8] in Path, buffer: &mut [u8]) -> UnitResult
    reaches FilesystemMetadataQuery
    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine lock(file: File) -> UnitResult

    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine lock_shared(file: File) -> UnitResult

    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine try_lock(file: File) -> TryLockResult

    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine try_lock_shared(file: File) -> TryLockResult

    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
    machine unlock(file: File) -> UnitResult

    invokes PosixFilesystemHost;
    invokes WindowsFilesystemHost;
}

