// Read up to `count` bytes into `buffer`; returns the number read (0 = EOF).
pub machine Filesystem::read(&mut self, file: File, buffer: &mut [u8], count: u64) -> IoResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    self.file_fd = file.fd;
    let n: i64 = self.host.read(self.file_fd, buffer, count);
    transition n >= 0 { true -> ok(n) _ -> err(n) }
    state ok(&mut self, n: i64) -> IoResult {
        let converted_count: u64 = narrow_i64_to_u64_exact(n);
        IoResult::Ok { count: converted_count }
    }
    state err(&mut self, n: i64) -> IoResult { let kind: ErrorKind = self.last_error_i64(n); IoResult::Error { kind: kind } }
}

// Write `bytes`; returns the number written.
pub machine Filesystem::write(&mut self, file: File, bytes: &[u8]) -> IoResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    self.file_fd = file.fd;
    let n: i64 = self.host.write(self.file_fd, bytes);
    transition n >= 0 { true -> ok(n) _ -> err(n) }
    state ok(&mut self, n: i64) -> IoResult {
