// The Omega standard filesystem surface — a serious, ergonomic `std::fs` with
// parity to Rust's `std::fs`, but Omega idioms rather than Rust ones:
//   - paths are a BYTE DOMAIN (`&[u8] in Path`), not a language `String`;
//   - results are bespoke `data` case enums, not `Result<T, E>` (an Err in Rust
//     is usually a bespoke enum anyway — we skip the wrapper);
//   - the open-file handle `File` is ZII: a zero-initialized handle is Closed;
//   - HUMAN method names only — no legacy C abbreviations (creat/unlink/stat).
//
// TWO LAYERS (= Rust's `std::fs` over `std::sys`):
//   - `Filesystem` — the ergonomic capability users hold. Its machines hide
//     flags/mode/fd behind `File` + the result enums.
//   - `FilesystemHost` — the raw, VALUE-RETURNING per-OS boundary (each op
//     returns its syscall result: fd / byte count / rc, negative on error). Its
//     per-target lowering (libSystem imports on darwin, syscalls on linux,
//     kernel32 on windows) lives in the calling-convention tables. The wrapper
//     is written ONCE and portable; each OS supplies only the raw seam.

// The RAW BOUNDARY (`FilesystemHost`) and the `Path` byte-domain are the single
// canonical declaration in the sibling std module; this ergonomic layer imports
// them (rather than re-declaring the trait) and builds `File`/result enums on top.
use filesystem_host;
use omega::language::core::layout;
use omega::language::core::numeric_conversion;

// The per-target DIRECTORY-WALK implementations (fs portable-contract settle
// 2026-07-18): target-scoped `<target> machine` items implementing this
// wrapper's directory-walk contract (see the contract block below). Imported
// HERE -- not from the target defs -- because the impl machines are part of
// THIS wrapper (they attach to `data Filesystem` and return its result enums);
// importing them from the target defs dragged wrapper machines into raw-seam
// programs that have no `Filesystem` at all (file_journal broke). The
// pre-resolution target filter keeps exactly one target's copies live.
use targets::windows_x86_64::filesystem_impl;
use targets::macos_arm64::filesystem_impl;
use targets::linux_x86_64::filesystem_impl;
use targets::linux_arm64::filesystem_impl;

// An open file handle. ZII: a zero-initialized `File` is Closed. `[copy]` lets
// it pass by value into read/write/close.
pub data File [copy] {
    fd: i32;
}

// The category of an I/O failure (Rust `std::io::ErrorKind`). First case is the
// ZII zero case = `Other` (an unclassified/unknown errno). Grown as more errno
// values get mapped; today covers the common file-op failures. Defined before
// the result enums because their `Error` case carries an `ErrorKind`.
pub data ErrorKind {
    case Other;
    case NotFound;         // ENOENT (2)
    case PermissionDenied; // EACCES (13)
    case AlreadyExists;    // EEXIST (17)
    case BadDescriptor;    // EBADF  (9)
    case IsADirectory;     // EISDIR (21)
    case WouldBlock;       // canonicalized EWOULDBLOCK/EAGAIN — a non-blocking op is contended
}

// Bespoke result enums (Rust's `io::Result<T>`, whose Err is `io::Error` — here
// its `ErrorKind`). First case = the ZII zero case = the error, so an untouched
// result reads as failure (`Error { kind: Other }`), never spurious success. The
// wrapper machines fill `kind` at the point of failure from either libc errno
// or an explicitly carried direct-syscall result, so a failed result
// self-describes — no separate call.
pub data OpenResult {
    case Error(kind: ErrorKind);
    case Ok(file: File);
}
pub data IoResult {
    case Error(kind: ErrorKind);
    case Ok(count: u64);
}
// A directory's composition summary (`read_dir_stats`). `entries` is the total
// child count (excluding "." and ".."); `subdirs` counts children with dirent
// type DT_DIR, `files` those with DT_REG. `entries - subdirs - files` are the
// other types (symlinks, fifos, …). On a filesystem that reports DT_UNKNOWN,
// `subdirs`/`files` undercount (see D-readdir).
pub data DirStats [copy] {
    entries: u64;
    subdirs: u64;
    files: u64;
}
pub data DirStatsResult {
    case Error(kind: ErrorKind);
    case Ok(stats: DirStats);
}
// A single directory entry (Rust `std::fs::DirEntry`). `name` is the NUL-padded
// file name copied out of the dirent record (max 255 bytes; `name_len` is the
// true length); `is_dir`/`is_file` come from the dirent `d_type` (DT_DIR/DT_REG).
// Self-contained (`[copy]`, the name embedded) so it outlives the read buffer.
pub data DirEntry [copy] {
    name: [u8; 256];
    name_len: u64;
    is_dir: bool;
    is_file: bool;
}
// The three-way result of `read_dir_nth` (Rust's `ReadDir` iterator yields
// `Optional<io::Result<DirEntry>>`): `Ok` an entry, `End` past the last entry, or a
// read `Error`.
pub data DirEntryResult {
    case Error(kind: ErrorKind);
    case End;
    case Ok(entry: DirEntry);
}
// The three-way answer of `read_dir_is_empty` (Rust `read_dir(path)?.next().is_none()`
// -> `io::Result<bool>`): `Empty` (no children), `NonEmpty` (has at least one), or a
// read `Error`.
pub data EmptyResult {
    case Error(kind: ErrorKind);
    case Empty;
    case NonEmpty;
}
pub data UnitResult {
    case Error(kind: ErrorKind);
    case Ok;
}

// The three-way answer of `try_exists` (Rust `Path::try_exists` ->
// `io::Result<bool>`): unlike `exists() -> bool`, a genuine I/O error (e.g. a
// permission-denied ancestor) is `Error`, distinct from a definite `No`
// (NotFound). ZII zero = `Error { kind: Other }`.
pub data ExistsResult {
    case Error(kind: ErrorKind);
    case No;
    case Yes;
}

// The answer of a non-blocking lock attempt (Rust `File::try_lock` ->
// `io::Result<bool>`): `Acquired` (got the lock), `WouldBlock` (another holder
// has it — Rust's `Ok(false)`), or a genuine `Error`. ZII zero = `Error`.
pub data TryLockResult {
    case Error(kind: ErrorKind);
    case WouldBlock;
    case Acquired;
}

// How to open an existing file (Rust `std::fs::OpenOptions`). A ZII-default
// `OpenOptions` (all false) opens read-only. These flags cover EXISTING-file
// opens (read / write / read+write / append / truncate); the creating flags
// (`create`/`create_new` = O_CREAT/O_EXCL) need `open`'s variadic `mode`
// argument, which is not yet marshalled on arm64 — use `create` for the common
// create-and-truncate case until that lands (see TASKS_FS.md step 7-open).
pub data OpenOptions [copy] {
    read: bool;
    write: bool;
    append: bool;
    truncate: bool;
    // `create` = create the file if it does not exist (O_CREAT); `create_new` =
    // create it and FAIL if it already exists (O_CREAT|O_EXCL, atomic). Both go
    // through the creating `open_create` seam with a default mode (0o666, minus
    // the process umask on native). `create_new` implies `create`.
    create: bool;
    create_new: bool;
}

// A file's permission bits (Rust `std::fs::Permissions`). `mode` is the POSIX
// octal mode (e.g. 0o644 = 420 = rw-r--r--, 0o444 = 292 = read-only).
pub data Permissions [copy] {
    mode: u32;
}

// Rust `Permissions::readonly()` — true when the owner-write bit (0o200 = 128)
// is clear.
pub machine Permissions::readonly(&self) -> bool {
    (self.mode & 128) == 0
}

// Rust `Permissions::set_readonly(bool)` — clear the write bits (owner/group/
// other, 0o222 = 146) to make read-only, or set them to make writable. The
// masks stay within the 9 permission bits (0o777 = 511; 511 ^ 146 = 365 keeps
// read+execute while clearing write).
pub machine Permissions::set_readonly(&mut self, readonly: bool) {
    transition readonly { true -> lock() _ -> unlock() }
    state lock(&mut self) { self.mode = self.mode & 365; }
    state unlock(&mut self) { self.mode = self.mode | 146; }
}

// File metadata (Rust `std::fs::Metadata`). `len` is the size in bytes; `is_dir`
// distinguishes a directory from a regular file; `mode` is the raw `st_mode`
// (format bits + permission bits); `modified_secs` is the last-modification time
// as whole seconds since the Unix epoch (`st_mtime`). The selected target's
// `StatLayout` policy supplies the foreign record's checked field positions.
pub data Metadata [copy] {
    len: i64;
    is_dir: bool;
    is_symlink: bool;
    mode: u32;
    nlink: u64;
    ino: u64;
    dev: u64;
    uid: u32;
    gid: u32;
    rdev: u64;
    blocks: u64;
    blksize: u64;
    modified_secs: i64;
    accessed_secs: i64;
    created_secs: i64;
    changed_secs: i64;
}

// The semantic scalar fields the portable wrapper consumes from a foreign
// `struct stat` record. These are portable semantic carriers, not one target's
// physical typedef widths. A target-authored `StatLayout::plan` chooses byte
// positions and uses `IntegerAt` wherever its ABI stores a narrower integer,
// without leaking offsets or widths into the boundary/provider surface.
data StatRecord {
    dev: u64;
    mode: u32;
    nlink: u64;
    ino: u64;
    uid: u32;
    gid: u32;
    rdev: u64;
    atime: i64;
    mtime: i64;
    ctime: i64;
    btime: i64;
    size: i64;
    blocks: u64;
    blksize: u64;
}

// The four selected-target implementations live beside the target filesystem
// code. `entries` is policy-owned build-time scratch; the compiler validates
// each returned fixed plan before any runtime view can consume it.
data StatLayout {
    entries: [FieldEntry; 64];
}

// Recasting the byte buffer to this wrapper preserves the ordinary reference
// surface while the inner record follows the selected programmable layout.
data StatView {
    value: StatLayout<StatRecord>;
}

// Rust `Metadata::is_file` — a REGULAR file specifically (S_IFREG). Checks the
// st_mode format bits directly (mode & S_IFMT == S_IFREG) rather than `!is_dir &&
// !is_symlink`, so a special file (char/block device, fifo, socket) is correctly
// NOT a regular file. `S_IFMT = 0o170000 = 61440`, `S_IFREG = 0o100000 = 32768`.
pub machine Metadata::is_file(&self) -> bool {
    (self.mode & 61440) == 32768
}

// Rust `os::unix::fs::FileTypeExt` — the special (non-regular, non-dir, non-link)
// file types, decoded from the same st_mode format bits (mode & S_IFMT).
// S_IFCHR = 0o020000 = 8192, S_IFBLK = 0o060000 = 24576, S_IFIFO = 0o010000 =
// 4096, S_IFSOCK = 0o140000 = 49152.
pub machine Metadata::is_char_device(&self) -> bool {
    (self.mode & 61440) == 8192
}
pub machine Metadata::is_block_device(&self) -> bool {
    (self.mode & 61440) == 24576
}
pub machine Metadata::is_fifo(&self) -> bool {
    (self.mode & 61440) == 4096
}
pub machine Metadata::is_socket(&self) -> bool {
    (self.mode & 61440) == 49152
}

// Rust `Metadata::permissions().readonly()` — true when the owner-write bit
// (0o200 = 128) is clear in the permission bits.
pub machine Metadata::readonly(&self) -> bool {
    (self.mode & 128) == 0
}

// Rust `Metadata::permissions()` — the permission bits (low 9 of `st_mode`,
// masked with 0o777 = 511) as a `Permissions`.
pub machine Metadata::permissions(&self) -> Permissions {
    Permissions { mode: self.mode & 511 }
}

// Rust `os::unix::fs::MetadataExt::nlink()` — the hard-link count (`st_nlink`). A
// fresh regular file is 1; each additional `hard_link` to the same inode adds one.
pub machine Metadata::nlink(&self) -> u64 {
    self.nlink
}

// Rust `os::unix::fs::MetadataExt::ino()` — the inode number (`st_ino`). Two hard
// links to the same file share it (the identity of the underlying inode).
pub machine Metadata::ino(&self) -> u64 {
    self.ino
}

// Rust `os::unix::fs::MetadataExt::dev()` — the device id (`st_dev`). The `(dev,
// ino)` pair is a file's identity: two paths name the same file iff both match.
pub machine Metadata::dev(&self) -> u64 {
    self.dev
}

// Rust `os::unix::fs::MetadataExt::ctime()` — the last status-change time
// (`st_ctime`): when the inode metadata last changed (chmod, rename, link, …).
// Distinct from `modified()` (content) and `created()` (birth).
pub machine Metadata::changed(&self) -> i64 {
    self.changed_secs
}

// Rust `os::unix::fs::MetadataExt::uid()` — the owning user id (`st_uid`).
pub machine Metadata::uid(&self) -> u32 {
    self.uid
}

// Rust `os::unix::fs::MetadataExt::gid()` — the owning group id (`st_gid`).
pub machine Metadata::gid(&self) -> u32 {
    self.gid
}

// Rust `os::unix::fs::MetadataExt::rdev()` — the device id THIS file represents
// (`st_rdev`), nonzero only for a device special file; 0 for a regular file/dir.
pub machine Metadata::rdev(&self) -> u64 {
    self.rdev
}

// Rust `os::unix::fs::MetadataExt::blocks()` — the number of 512-byte blocks
// allocated to the file (`st_blocks`); may be less than `len`/512 for a sparse file.
pub machine Metadata::blocks(&self) -> u64 {
    self.blocks
}

// Rust `os::unix::fs::MetadataExt::blksize()` — the filesystem's preferred I/O
// block size (`st_blksize`), e.g. 4096.
pub machine Metadata::blksize(&self) -> u64 {
    self.blksize
}

// Rust `Metadata::modified()` — the last-modification time. Rust returns a
// `SystemTime`; Omega returns whole seconds since the Unix epoch (`st_mtime`).
pub machine Metadata::modified(&self) -> i64 {
    self.modified_secs
}

// Rust `Metadata::accessed()` — the last-access time (`st_atime`).
pub machine Metadata::accessed(&self) -> i64 {
    self.accessed_secs
}

// Rust `Metadata::created()` — the creation (birth) time (`st_birthtime`, which
// darwin records; on platforms without it this field is unavailable).
pub machine Metadata::created(&self) -> i64 {
    self.created_secs
}
pub data MetadataResult {
    case Error(kind: ErrorKind);
    case Ok(meta: Metadata);
}

// `FilesystemHost` (the RAW, VALUE-RETURNING per-OS boundary) is declared once in
// `omega::language::std::filesystem_host`, imported at the top of this file.

// The ergonomic capability. Holds the raw host plus the portable flag/mode
// constants it applies (staged in fields). `stat_buf` is scratch sized for the
// largest selected `struct stat` carrier; the target `StatLayout` supplies the
// live extent and field encodings.
pub data Filesystem {
    host: FilesystemHost;
    create_mode: i32;
    dir_mode: i32;
    read_flags: i32;
    // Composed open() / open_create() flag word: a host-call scalar arg must be
    // a simple storage place, and a COMPUTED flag expression (or a `let` local
    // in a value-called machine) is not one -- create_new/open_with compose the
    // per-target flags into this field, then pass the field (the read_flags
    // idiom).
    open_flags: i32;
    // Semantic input to the selected target's checked foreign-flag encoder.
    // Keeping it in machine storage also satisfies the current native
    // value-call receiver rule; no foreign bit position escapes this package.
    open_options: OpenOptions;
    open_writable: i32;
    open_readable: i32;
    open_creating: i32;
    // Scratch for a by-value File param's fd: a host-call arg must be a
    // simple storage place, and a param MEMBER (`file.fd`) is not one (a let
    // folds back to the member) -- the field capture is (try_exists' idiom).
    file_fd: i32;
    // Same idiom for a by-value Permissions param's mode: `perms.mode` passed
    // DIRECTLY as a chmod/fchmod arg fails to resolve under some dispatch
    // contexts (member of a by-value struct param), so set_permissions /
    // set_file_permissions capture it here in the entry first.
    perm_mode: u32;
    stat_buf: [u8; 144];
    // Scratch for the two `struct timespec` (atime then mtime) that `set_times`
    // builds and hands to `futimens`.
    times_buf: [u8; 32];
    // Win32 twin of times_buf: SetFileTime takes two independent FILETIME
    // pointers, and boundary arguments deliberately cannot be computed
    // subslices. Kept as explicit 8-byte arrays for simple-address lowering.
    access_filetime: [u8; 8];
    modified_filetime: [u8; 8];
    // Zeroed OVERLAPPED record for Win32 whole-file LockFileEx. CRT-created
    // handles are synchronous, so the offset fields remain zero and no event
    // handle is required. The exact 32-byte Win64 record still crosses the raw
    // seam explicitly rather than being synthesized by the compiler.
    lock_overlapped: [u8; 32];
    // Scratch for `create_dir_all`'s per-position best-effort mkdir result
    // (`walk` ignores it -- an already-present ancestor is fine).
    walk_rc: i32;
    // Best-effort result scratch for the prefix copy walk (mirrors walk_rc).
    copy_rc: i32;
    // NUL-terminated scratch for `create_dir_all`'s ancestor prefixes: a
    // runtime SUBSLICE of the path param has no NUL for the native C call,
    // so each prefix is copied here with a trailing NUL and passed as a
    // literal-start subslice of this fixed array (the open_at/unlink_at
    // name idiom -- the base pointer is a valid C string; the interpreter
    // sees the same exact bytes). Prefixes of 255+ bytes skip their
    // best-effort mkdir (D-cda).
    mkall_scratch: [u8; 256];
    // Scratch for the STAT-based query host-call result. Held in a FIELD + consumed
    // by TERMINAL VALUE COMPLETION (`self.stat_rc == 0` as the machine's final value),
    // NOT a `transition` guard: an inlined value-call's transition GUARD is scheduled
    // before the callee's entry body (the read_metadata store), so the guard reads
    // the pre-store ZII value (confirmed at the instruction level, TASKS_FS.md). A
    // terminal expression has no such guard and is evaluated after the entry, so the
    // STAT queries observe the result.
    stat_rc: i32;
    // `try_exists` captures errno into a FIELD in the entry (right after the stat,
    // before any transition) so the No-vs-Error split guards on a stored field, not
    // a nested host-call-in-guard (`let code = errno(); transition code == 2` inside
    // a leaf state) — which the value-call deep fix does not reach at that nesting.
    stat_errno: i32;
    // `try_lock`/`try_lock_shared` capture errno the same way (entry, before the
    // transition) so the WouldBlock-vs-Error split guards on a stored field --
    // an errno() host call in the contended ARM trips the effectful-arm fence
    // for every value-position caller.
    lock_errno: i32;
    // `last_error`: the captured errno and its classified ErrorKind. Produced by a
    // `match` TERMINAL (errno -> nullary ErrorKind), NOT a transition-guard chain,
    // for the same value-call guard-ordering reason as the STAT queries. This is
    // within the workaround's ceiling: all ErrorKind cases are payload-free, so the
    // match desugars to branchless tag arithmetic. (A payload-CARRYING result enum --
    // e.g. UnitResult::Error{kind} -- cannot use this: the arithmetic desugar would
    // need `Add` on the data type, which is undeclared. Those await the deep fix.)
    err_code: i32;
    err_kind: ErrorKind;
    // Windows twin of err_kind. Kernel32 reports through GetLastError rather
    // than msvcrt errno, so target-specific wrappers capture and classify it
    // immediately before any later boundary call can overwrite the thread slot.
    win32_error_kind: ErrorKind;
    // Scratch for directory walking: one buffer of packed target `dirent`
    // records plus the runtime-indexed cursor that walks them by `d_reclen`.
    dir_buf: [u8; 512];
    rd_off: u64 in Wrapping;
    rd_total: u64 in Wrapping;
    rd_count: i32 in Wrapping;
    rd_position: i64;
    rd_idx: u64 in Wrapping;
    rd_lo: u8;
    rd_hi: u8;
    rd_lou: u64 in Wrapping;
    rd_hiu: u64 in Wrapping;
    rd_reclen: u64 in Wrapping;
    // `read_dir_stats`: the record's `d_type` byte + the per-type tallies.
    rd_dtype: u8;
    rd_dirs: i32 in Wrapping;
    rd_files: i32 in Wrapping;
    // `read_dir_nth`: record cursor, the target record index (n + 2, skipping
    // "." and ".."), the extracted name buffer + its copy cursor.
    rd_recno: u64 in Wrapping;
    rd_target: u64 in Wrapping;
    rd_namlen: u64 in Wrapping;
    rd_j: u64 in Wrapping;
    rd_ridx: u64 in Wrapping;
    rd_nb: u8;
    entry_name: [u8; 256];
    // `read_dir_nth` holds the fd-walk result across the descriptor close;
    // `remove_dir_all` (`rda`) threads the child fd + per-op rc.
    rdn_result: DirEntryResult;
    rda_sub: i32;
    rda_rc: i32;
    rda_n: i64;
    // Iterative remove_dir_all drain (2026-07-09g): an explicit dirfd STACK
    // replaces rda's call recursion (which neither the splice nor the clone
    // dispatch can lower). Depth-bounded at 16 nested directories (deeper
    // trees error cleanly); `rda_depth` counts stacked fds (0 = drained).
    rda_stack: [i32; 16];
    rda_depth: u64;
    rda_fd: i32;
    // rda_step's verdict, read by rda_drain's entry transition: 1 = step done,
    // keep draining; 0 = all drained; -1 = error/overflow.
    rda_verdict: i32;
    // Host-result scratch for the drain's closes (the canonical field
    // discipline: a raw i32 rc, no cast -- a cast-valued MachineOwned write
    // does not lower in a dispatched arm).
    rda_close_rc: i32;
    // read_dir_entry_fd's rewind rc (field discipline; an i64 seek result).
    rd_seek_rc: i64;
    // mkall_put's byte carrier (the let-local dispatch face: a machine-indexed
    // write's LOCAL source does not resolve under a dispatched arm; a FIELD
    // source always does -- the canonical discipline).
    mkall_byte: u8;
    // Windows dir-walk scratch (rung 3b): the find-enumeration walk keeps a
    // path-prefix stack (no dirfd exists on windows -- `w_path` holds the
    // current directory's full path, `w_len_stack` each ancestor's length)
    // plus the shared scan-core tallies. Unused on posix targets
    // (ZII-harmless).
    find_buf: [u8; 320];
    w_find: i64;
    w_next_rc: i32;
    w_help_rc: i32;
    w_scan_verdict: i32;
    w_attr: u8;
    w_scan_count: u64 in Wrapping;
    w_scan_dirs: u64 in Wrapping;
    w_scan_files: u64 in Wrapping;
    w_scan_target: u64 in Wrapping;
    w_scan_hit: u64 in Wrapping;
    w_scan_done: u64 in Wrapping;
    w_scan_pending: u64 in Wrapping;
    w_scan_kind: u64 in Wrapping;
    // The kind LATCHED at the target hit (1 dir / 2 file): w_scan_kind keeps
    // running as the drain classifies the REMAINING records, so a consumer
    // reading it after the drain would see the LAST record's kind, not the
    // captured entry's (read_dir_nth reported file children as directories
    // whenever the directory's last record was a dir).
    w_hit_kind: u64 in Wrapping;
    w_entry_len: u64 in Wrapping;
    w_path_len: u64 in Wrapping;
    w_child_len: u64 in Wrapping;
    w_pat_len: u64 in Wrapping;
    w_len_stack: [u64 in Wrapping; 16];
    w_path: [u8; 512];
}

// Create (or truncate) a file for writing, returning an open `File`. Composed
// as the target format's write/create/truncate word (including binary mode on
// windows) via `open_create` -- the raw `create`
// (`_creat`) row stays for raw-seam callers, but the wrapper composes flags so
// windows writes are byte-exact (Rust File::create is binary; msvcrt `_creat`
// is TEXT mode).
pub machine Filesystem::create(&mut self, path: &[u8] in Path) -> OpenResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    self.open_options = OpenOptions {
        read: false,
        write: true,
        append: false,
        truncate: true,
        create: true,
        create_new: false,
    };
    self.encode_open_options();
    // Mode is a LITERAL (438 = 0o666, Rust's create mode; the umask trims it):
    // the darwin arm64 variadic encoder marshals the trailing mode on the
    // STACK and requires a compile-time immediate -- a field-held mode
    // resolves to a runtime place and does not compile there (win64 takes
    // either; the field idiom is only for COMPOSED words like open_flags).
    let fd: i32 = self.host.open_create(path, self.open_flags, 438);
    transition fd >= 0 { true -> ok(fd) _ -> err(fd) }
    state ok(&mut self, fd: i32) -> OpenResult { OpenResult::Ok { file: File { fd: fd } } }
    state err(&mut self, fd: i32) -> OpenResult { let kind: ErrorKind = self.last_error_i32(fd); OpenResult::Error { kind: kind } }
}

// Atomically create a NEW file, failing if it already exists (Rust
// `File::create_new`). O_RDWR|O_CREAT|O_EXCL (2|512|2048 = 2562), mode 0o666
// (438). An existing path yields `Error { kind: AlreadyExists }`.
pub machine Filesystem::create_new(&mut self, path: &[u8] in Path) -> OpenResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    self.open_options = OpenOptions {
        read: true,
        write: true,
        append: false,
        truncate: false,
        create: false,
        create_new: true,
    };
    self.encode_open_options();
    let fd: i32 = self.host.open_create(path, self.open_flags, 438);
    transition fd >= 0 { true -> ok(fd) _ -> err(fd) }
    state ok(&mut self, fd: i32) -> OpenResult { OpenResult::Ok { file: File { fd: fd } } }
    state err(&mut self, fd: i32) -> OpenResult { let kind: ErrorKind = self.last_error_i32(fd); OpenResult::Error { kind: kind } }
}

// Open an existing file for reading. The selected target format supplies its
// read-only encoding and any binary-mode requirement.
pub machine Filesystem::open(&mut self, path: &[u8] in Path) -> OpenResult
reaches
    FilesystemHost
invokes
    FilesystemHost;
{
    self.open_options = OpenOptions {
        read: false,
        write: false,
        append: false,
        truncate: false,
        create: false,
        create_new: false,
    };
    self.encode_open_options();
    self.read_flags = self.open_flags;
    let fd: i32 = self.host.open(path, self.read_flags);
