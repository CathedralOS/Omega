use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::LayoutTarget;
use omega::language::core::LayoutStorage;
use omega::language::core::FixedLayout;
use omega::language::core::PrivateCallbackSlot;
use omega::language::core::LayoutPlan::place_private;

public boundary trait WindowProcedure {
    machine call(message: u64) -> u64 reaches none crashes none;
}

public boundary trait UnusedProcedure {
    machine call(message: u64) -> u64 reaches none crashes none;
}


WndClassWindowProcedureSlot satisfies PrivateCallbackSlot<ForeignRecord, Spread, WindowProcedure::call> { }

SecondaryWndClassWindowProcedureSlot satisfies PrivateCallbackSlot<ForeignRecord, Spread, WindowProcedure::call> { }

UnusedWindowProcedureSlot satisfies PrivateCallbackSlot<ForeignRecord, Spread, UnusedProcedure::call> { }

// Callback slots and the registrar name this same selected layout.
public Spread satisfies FixedLayout<ForeignRecord> {
    machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan
    reaches none terminates {
        let mut owned_entries: [FieldEntry; 64];
        owned_entries[0] = FieldEntry {
            key: schema.fields[0].key,
            representation: FieldPlan::At { offset: 0 },
        };
        let plan: LayoutPlan = LayoutPlan {
            entries: owned_entries,
            entry_count: 1,
            size_fixed: 24,
            size_is_dynamic: false,
            align: 8,
        };
        let placed: LayoutPlan =
            LayoutPlan::place_private<WndClassWindowProcedureSlot>(plan, 8);
        LayoutPlan::place_private<SecondaryWndClassWindowProcedureSlot>(placed, 16)
    }
}

public data ForeignRecord {
    payload: u64;
}

public RegistrarPolicyCallingPolicy satisfies CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult {
        make_registrar_plan(signature)
    }
}

machine make_registrar_plan(signature: BoundarySignature) -> BoundaryPlanResult {
    transition signature.parameter_count == 1 {
        true -> select_catalog(signature)
        _ -> reject()
    }

    machine select_catalog(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.callback_demand_count == 0 {
            true -> check_root(signature, signature.parameters[0])
            _ -> select_two_demands(signature)
        }
    }

    machine select_two_demands(signature: BoundarySignature) -> BoundaryPlanResult {
        transition signature.callback_demand_count == 2 {
            true -> check_root(signature, signature.parameters[0])
            _ -> reject()
        }
    }

    machine check_root(signature: BoundarySignature, root: u64) -> BoundaryPlanResult {
        transition root < 256 {
            true -> build(signature, root)
            _ -> reject()
        }
    }

    machine build(signature: BoundarySignature, root: u64) -> BoundaryPlanResult {
        let mut output: BoundaryEntryPlan;
        output.call.convention = CallingConvention::MicrosoftX64;
        output.call.parameter_count = 1;
        output.call.parameters[0].shape.class = AbiValueClass::Integer;
        output.call.parameters[0].shape.byte_size = signature.shapes[root].byte_size;
        output.call.parameters[0].shape.alignment = signature.shapes[root].alignment;
        output.call.parameters[0].location_count = 1;
        output.call.parameters[0].locations[0] = ValueLocation::Register {
            register: MachineRegister::X86Rcx,
            value_byte_offset: 0,
            byte_size: signature.shapes[root].byte_size,
        };
        output.call.stack_alignment = 16;
        output.call.shadow_bytes = 32;
        output.call.entry_control = EntryControl::CallReturn;
        output.state.initial_regime = MachineRegime::X86Long64;
        output.state.stack = EntryStack::ProviderSelected;
        output.state.preemption = Preemption::NotApplicable;
        output.call.callback_materialization_count = signature.callback_demand_count;
        transition signature.callback_demand_count == 2 {
            true -> bind_callback(signature, output)
            _ -> accept(output)
        }
    }

    machine bind_callback(
        signature: BoundarySignature,
        output: BoundaryEntryPlan
    ) -> BoundaryPlanResult {
        let mut bound: BoundaryEntryPlan = output;
        bound.call.callback_materializations[0].binder = signature.callback_binders[0].binder;
        bound.call.callback_materializations[0].destination =
            signature.callback_demands[0].destination;
        bound.call.callback_materializations[1].binder = signature.callback_binders[1].binder;
        bound.call.callback_materializations[1].destination =
            signature.callback_demands[1].destination;
        BoundaryPlanResult::Accepted { plan: bound }
    }

    machine accept(output: BoundaryEntryPlan) -> BoundaryPlanResult {
        BoundaryPlanResult::Accepted { plan: output }
    }

    machine reject() -> BoundaryPlanResult {
        BoundaryPlanResult::Rejected {
            reason: CallingPolicyRejection { reason: "invalid callback catalog" as +Utf8 },
        }
    }
}

public boundary trait WindowRegistrar: Calling<RegistrarPolicyCallingPolicy> {
    machine register<machine Selected, machine SecondarySelected>(
        specification: &LayoutStorage<ForeignRecord, Spread>
    )
    requires machine Selected satisfies WindowProcedure::call;
    requires machine SecondarySelected satisfies WindowProcedure::call;
    reaches none
    crashes none;
}

data Main { }
machine Main::main(main: &mut Main) { }
