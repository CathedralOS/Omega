// The raw Windows filesystem service: the Windows family of the
// platform-services filesystem split (TASKS.md FILESYSTEM-PLATFORM-SERVICES,
// wiki/spec/build/platform_services.md). Where PosixFilesystemHost speaks in
// descriptors and negated errno, this family speaks in HANDLEs and negated
// Win32 error codes (`GetLastError`). The trait covers synchronous Windows
// file handles and their native namespace and timestamp operations. Operations
// that exist only on POSIX stay on PosixFilesystemHost.
//
// Conventions:
// - Paths are NUL-free bytes (`Path`, shared with the POSIX family); the
//   provider decodes UTF-8 to NUL-terminated UTF-16 for the `W` imports.
// - `create_file` returns the HANDLE; 0 means failure (the provider maps the
//   sentinel INVALID_HANDLE_VALUE to 0, so 0 is the only failure value).
// - `create_file` rejects FILE_FLAG_OVERLAPPED: these transfers complete before
//   returning and never leave the caller's buffer with an asynchronous request.
// - Unrepresentable extents and paths that cannot be encoded refuse with
//   ERROR_INVALID_PARAMETER; a handle refusal also sets GetLastError.
// - Read/write operations return byte counts or negated Win32 errors.
// - `close_handle` returns 0, or the negated Win32 error.
// - Status-only i32 results use -ERROR_GEN_FAILURE if the native error is zero
//   or cannot be negated in i32; last_error retains the original u32 code.
// - `last_error` reads the thread's `GetLastError` for callers that need the
//   code behind a failed `create_file` or `duplicate_handle`.
use filesystem_host;
use omega::language::core::filesystem_authority;
use targets::windows_x86_64::windows_filesystem_impl;
use targets::windows_x86_64::windows_filesystem_native;
use targets::windows_x86_64::windows_filesystem_transfer_native;
use targets::windows_x86_64::windows_filesystem_metadata_native;
use targets::windows_x86_64::windows_filesystem_file_control_native;
use targets::windows_x86_64::windows_filesystem_position_native;
use targets::windows_x86_64::windows_filesystem_directory_native;
use targets::windows_x86_64::windows_filesystem_path_query_native;
use targets::windows_x86_64::windows_filesystem_lock_native;
use targets::windows_x86_64::windows_filesystem_reparse_native;
use targets::windows_x86_64::filesystem_removal::native;

// An untouched result is an error. Timestamp zero remains a valid FILETIME.
public data WindowsFileTimeResult {
    case Error(code: u32);
    case Value(access_time: u64, write_time: u64);
}

// Native Windows facts, not fabricated POSIX identities. Timestamps retain
// their FILETIME bit pattern; the portable adapter owns epoch conversion.
// This is one pinned object observed by several queries, not an atomic snapshot
// against another writer changing that object's size or attributes.
public data WindowsFileMetadata [copy] {
    length: i64;
    links: u32;
    attributes: u32;
    reparse_tag: u32;
    creation_ticks: u64;
    access_ticks: u64;
    write_ticks: u64;
    change_ticks: u64;
}
public data WindowsMetadataResult {
    case Error(code: u32);
    case Value(metadata: WindowsFileMetadata);
}

// The raw directory entry retains native attributes. Bounded UTF-8 spelling
// failure is explicit; a long or unrepresentable name is never truncated.
public data WindowsDirectoryEntry [copy] {
    name: [u8; 256];
    name_len: u64;
    attributes: u32;
}
public data WindowsDirectoryEntryResult {
    case Error(code: u32);
    case End;
    case Entry(entry: WindowsDirectoryEntry);
}

// Operation capabilities are independent of the raw family's selection identity.
// Cursor, durability, handle custody and last-error access have no content,
// metadata or namespace reach; physical authority is still admitted separately.
// In particular, empty source reach on CloseHandle proves no ordinary-release
// classification for an arbitrary HANDLE or its close-triggered behavior.
public boundary trait WindowsFilesystemHost {
    // Traverse exact retained directory objects. Never follow a reparse child;
    // refuse a reparse root. A failed native operation stops removal and
    // releases each private handle once, preserving the original failure.
    machine remove_tree(path: &[u8] in Path) -> i32
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + FilesystemMetadataQuery + DirectoryEnumeration blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemMetadataIo;
    invokes WindowsFilesystemDirectoryIo;
    invokes WindowsFilesystemRemovalIo;
    // Stored target bytes, not the display PrintName. Writes at most count,
    // excludes NUL, and returns that byte count; a full buffer may be a prefix.
    // Zero or out-of-buffer count refuses before opening the path.
    machine read_link(path: &[u8] in Path, output: &mut [u8], count: u64) -> i64
    reaches FilesystemMetadataQuery blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemMetadataIo;
    invokes WindowsFilesystemReparseIo;
    invokes WindowsFilesystemUtf8Io;
    // Same-object synchronous whole-file range locking, including future
    // growth. Try conflicts return -33; repeated locks/unmatched unlocks keep
    // native semantics. No cursor movement, access upgrade or reopening.
    machine lock_file(handle: u64, exclusive: bool, nonblocking: bool) -> i32 blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemLockIo;
    machine unlock_file(handle: u64) -> i32 blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemLockIo;
    machine directory_nth(path: &[u8] in Path, ordinal: u64) -> WindowsDirectoryEntryResult
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration + FilesystemMetadataQuery blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemDirectoryIo;
    invokes WindowsFilesystemUtf8Io;
    machine canonicalize(path: &[u8] in Path, output: &mut [u8]) -> i32
    reaches FilesystemMetadataQuery blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemMetadataIo;
    invokes WindowsFilesystemPathIo;
    invokes WindowsFilesystemUtf8Io;
    // Counts every non-dot native name without UTF-8 decoding or metadata
    // queries. A private synchronous directory object owns the complete scan.
    machine directory_count(path: &[u8] in Path) -> i64
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemDirectoryIo;
    // Reopen an independent synchronous file object without increasing the
    // pinned original's granted data rights. The original cursor is untouched.
    machine read_at(handle: u64, buffer: &mut [u8], count: u64, offset: i64) -> i64
    reaches FilesystemContentRead blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemTransferIo;
    invokes WindowsFilesystemPositionIo;
    machine write_at(handle: u64, bytes: &[u8], offset: i64) -> i64
    reaches FilesystemContentWrite blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemTransferIo;
    invokes WindowsFilesystemPositionIo;
    machine set_file_length(handle: u64, length: i64) -> i32
    reaches FilesystemContentWrite + FilesystemMetadataMutation blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemFileControlIo;
    machine set_handle_readonly(handle: u64, readonly: bool) -> i32
    reaches FilesystemMetadataQuery + FilesystemMetadataMutation blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemMetadataIo;
    invokes WindowsFilesystemFileControlIo;
    machine set_path_readonly(path: &[u8] in Path, readonly: bool) -> i32
    reaches FilesystemMetadataQuery + FilesystemMetadataMutation blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemMetadataIo;
    invokes WindowsFilesystemFileControlIo;
    machine metadata(handle: u64) -> WindowsMetadataResult
    reaches FilesystemMetadataQuery
    blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemMetadataIo;
    // OPEN_EXISTING with FILE_READ_ATTRIBUTES only. Unlike a general creating
    // open, this operation has no content or namespace mutation reach.
    machine read_metadata(path: &[u8] in Path, no_follow: bool) -> WindowsMetadataResult
    reaches FilesystemMetadataQuery
    blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemMetadataIo;
    machine create_file(
        path: &[u8] in Path,
        desired_access: u32,
        share_mode: u32,
        creation_disposition: u32,
        flags_and_attributes: u32
    ) -> u64 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    blocks;
    invokes WindowsFilesystemIo;
    machine write_file(handle: u64, bytes: &[u8]) -> i64 reaches FilesystemContentWrite
    blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemTransferIo;
    // Byte counts must fit DWORD and the caller's live buffer. Invalid extents
    // refuse with -ERROR_INVALID_PARAMETER before entering the OS.
    machine read_file(handle: u64, buffer: &mut [u8], count: u64) -> i64 reaches FilesystemContentRead
    blocks;
    invokes WindowsFilesystemIo;
    invokes WindowsFilesystemTransferIo;
    machine flush_file_buffers(handle: u64) -> i32 blocks;
    invokes WindowsFilesystemIo;
    machine set_file_pointer(handle: u64, distance: i64, method: u32) -> i64 blocks;
    invokes WindowsFilesystemIo;
    machine duplicate_handle(handle: u64) -> u64 invokes WindowsFilesystemIo;
    machine set_file_attributes(path: &[u8] in Path, attributes: u32) -> i32 reaches FilesystemMetadataMutation
    blocks;
    invokes WindowsFilesystemIo;
    // Flags include MOVEFILE_COPY_ALLOWED: cross-volume moves can copy data
    // and attributes before deleting, so this raw ceiling is not rename-only.
    machine move_file(from: &[u8] in Path, to: &[u8] in Path, flags: u32) -> i32 reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    blocks;
    invokes WindowsFilesystemIo;
    // Same-volume replacement only: no copy fallback or delayed deletion.
    // A constant at a call of move_file cannot narrow its declared reach.
    machine rename_file(from: &[u8] in Path, to: &[u8] in Path) -> i32
    reaches FilesystemNamespaceMutation
    blocks;
    invokes WindowsFilesystemIo;
    machine hard_link(original: &[u8] in Path, link: &[u8] in Path) -> i32
    reaches FilesystemNamespaceMutation
    blocks;
    invokes WindowsFilesystemIo;
    machine create_directory(path: &[u8] in Path) -> i32 reaches FilesystemMetadataMutation + FilesystemNamespaceMutation
    blocks;
    invokes WindowsFilesystemIo;
    machine remove_directory(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation
    blocks;
    invokes WindowsFilesystemIo;
    machine delete_file(path: &[u8] in Path) -> i32 reaches FilesystemNamespaceMutation
    blocks;
    invokes WindowsFilesystemIo;
    // FILETIME values are unsigned 100-ns ticks since 1601. Creation time stays
    // unchanged; access/write retain Win32's zero (unchanged) and all-ones
    // (suppress automatic updates through this handle) special values.
    machine set_file_time(handle: u64, access_time: u64, write_time: u64) -> i32 reaches FilesystemMetadataMutation
    blocks;
    invokes WindowsFilesystemIo;
    machine get_file_time(handle: u64) -> WindowsFileTimeResult reaches FilesystemMetadataQuery
    blocks;
    invokes WindowsFilesystemIo;
    machine close_handle(handle: u64) -> i32 blocks;
    invokes WindowsFilesystemIo;
    machine last_error() -> u32 invokes WindowsFilesystemIo;
}
