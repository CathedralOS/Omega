machine PosixFilesystem::read_link(filesystem: &mut PosixFilesystem, path: &[u8] in Path, buffer: &mut [u8], count: u64) -> IoResult
reaches FilesystemMetadataQuery

invokes
    PosixFilesystemHost;
{
    let n: i64 = PosixFilesystemHost::read_link(path, buffer, count);
