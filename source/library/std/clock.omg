// Portable pacing requirement. The owning package Build selects ordinary
// checked adapters where the native protocol differs, and binds the exact
// requirement directly where the native signature already matches. Source
// checking sees every supplied implementation; target choice stays in Build.
use targets::linux_x86_64::clock_impl;
use targets::linux_arm64::clock_impl;
use targets::macos_arm64::clock_impl;

public boundary trait Clock {
    // Block the caller for `milliseconds`. Each hosted adapter may enter its
    // one-member raw wait trait; Windows enters none of them. The trait names
    // are synchronous invocation edges, not extra reach members.
    machine sleep(milliseconds: u32)
    reaches Clock
    invokes LinuxClockWait;
    invokes LinuxArmClockWait;
    invokes DarwinClockWait;
}
