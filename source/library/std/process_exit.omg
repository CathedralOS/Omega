// Canonical process-exit provider surface exposed by the Omega standard
// library.
//
// The `ProcessExit` boundary trait itself is owned by core
// (`omega::language::core::process_exit`); this module contributes only the
// ordinary implementations. The package Build selects the shared hosted
// catalog or the Windows native requirement for each deployment target.
use omega::language::core::process_exit;
use targets::windows_x86_64::process_exit_impl;


use native::hosted;
