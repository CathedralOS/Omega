// Canonical process-exit provider surface exposed by the Omega standard
// library.
//
// The `ProcessExit` boundary trait itself is owned by core
// (`omega::language::core::process_exit`); this module contributes the named
// implementation each target selects by default. Its checked body delegates
// to the exact compiler-owned core primitive; std claims no compiler backing.
use omega::language::core::Never;
use omega::language::core::ProcessExit;
use omega::language::core::ProcessExitPrimitive;

// Target defaults use this ordinary namespace value to select the checked
// implementation below. It is neither a provider nor a native realization.
public data ProcessExitNativeProvider { }

// The selected implementation owns the complete ProcessExit map. Its one
// member calls the core primitive directly. Its distinct declaration keeps
// the canonical requirement's terminal outcome and exact i32 status; neither
// the wrapper nor provider selection grants caller exit authority.
public NativeProcessExit satisfies ProcessExit {
    machine exit_process(return_code: i32) -> Never
    reaches ProcessExit
    crashes none
    terminates {
        ProcessExitPrimitive::exit_process(return_code);
    }
}
