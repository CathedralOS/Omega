// Canonical process-exit provider surface exposed by the Omega standard
// library.
//
// The `ProcessExit` boundary trait itself is owned by core
// (`omega::language::core::process_exit`); this module contributes only the
// nominal provider closure. Each selected target contributes its irreducible
// native exit leaf and its provider default. Target filtering keeps exactly
// one implementation closure.

// Nominal owner of the complete selected ProcessExit provider closure.
// Compiler-known native exit leaves attach to this type so provider selection
// never assembles the row from unrelated implementations. Realizing the exact
// canonical requirement preserves the terminal outcome and the exact i32
// status; it does not grant the caller exit authority.
public data ProcessExitNativeProvider { }

// The selected implementation owns the complete ProcessExit map, as
// `NativeConsole` does for Console: provider selection names a named
// implementation, never a data type. The native leaf keeps its exact target
// identity and the implementation forwards to it with an ordinary call.
public NativeProcessExit satisfies ProcessExit {
    machine exit_process(return_code: i32) reaches ProcessExit {
        ProcessExitNativeProvider::exit_process(return_code);
    }
}
