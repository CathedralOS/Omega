module native::hosted;

use console;
use omega::language::core::process_exit;

// Immutable compiler catalog. Exact source, module, signature and requirement
// custody authorize the fixed leaf meaning; Build selects ordinary maps.
boundary machine console_read_byte() -> ByteRead
    satisfies Console::read_byte
    crashes Trap
    blocks;
boundary machine console_write_byte(byte: i32)
    satisfies Console::write_byte;
boundary machine console_exit_process(return_code: i32)
    satisfies Console::exit_process;
boundary machine hosted_process_exit(return_code: i32)
    satisfies ProcessExit::exit_process;

HostedConsole satisfies Console {
    machine write_line(text: &[u8]) reaches Console {
        console_write_bytes<console_write_byte>(text, true);
    }
    machine write(text: &[u8]) reaches Console {
        console_write_bytes<console_write_byte>(text, false);
    }
    machine read_line(out_line: &mut [u8]) -> LineReadResult
    reaches Console blocks; crashes Trap {
        block console_read_line<console_read_byte>(out_line)
    }
    machine read_byte() -> ByteRead reaches Console blocks; crashes Trap {
        block console_read_byte()
    }
    machine write_byte(byte: i32) reaches Console {
        console_write_byte(byte);
    }
    machine exit_process(return_code: i32) reaches Console {
        console_exit_process(return_code);
    }
}

HostedProcessExit satisfies ProcessExit {
    machine exit_process(return_code: i32) reaches ProcessExit {
        hosted_process_exit(return_code);
    }
}
