use calling.omg as abi;
use darwin_calling.omg as darwin;

// Explicit native ABI for POSIX byte-view leaves. A slice is one semantic
// borrowed formal: pointer then extent occupy two consecutive native words.
// Scalar and sized-reference formals occupy one word. This policy is opt-in;
// it neither changes the default slice ABI nor grants access beyond the view.

public LinuxArm64ByteViewCalling satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        let mutable plan: |abi|::BoundaryEntryPlan = posix_byte_view_linux_arm64_entry();
        let accepted: bool = posix_byte_view_parameters(@signature, @mutable plan);
        transition accepted {
            true -> |abi|::BoundaryPlanResult::Accepted { plan: plan },
            _ -> |abi|::BoundaryPlanResult::Rejected {
                reason: |abi|::CallingPolicyRejection { reason: "expected bounded byte views, integer or sized-reference formals, and Unit or integer result" as + |abi|::Utf8 }
            }
        }
    }
}

public LinuxX86ByteViewCalling satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        let mutable plan: |abi|::BoundaryEntryPlan = posix_byte_view_linux_x86_entry();
        let accepted: bool = posix_byte_view_parameters(@signature, @mutable plan);
        transition accepted {
            true -> |abi|::BoundaryPlanResult::Accepted { plan: plan },
            _ -> |abi|::BoundaryPlanResult::Rejected {
                reason: |abi|::CallingPolicyRejection { reason: "expected bounded byte views, integer or sized-reference formals, and Unit or integer result" as + |abi|::Utf8 }
            }
        }
    }
}

// The C ABI borrows the same pointer/count value but has ordinary call-return
// control and the full caller-saved register promise.
public SystemVByteViewCalling satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        let mutable plan: |abi|::BoundaryEntryPlan = posix_byte_view_system_v_entry();
        let accepted: bool = posix_byte_view_parameters(@signature, @mutable plan);
        transition accepted {
            true -> |abi|::BoundaryPlanResult::Accepted { plan: plan },
            _ -> |abi|::BoundaryPlanResult::Rejected {
                reason: |abi|::CallingPolicyRejection { reason: "expected bounded byte views, integer or sized-reference formals, and Unit or integer result" as + |abi|::Utf8 }
            }
        }
    }
}

public DarwinArm64ByteViewCalling satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        let mutable plan: |abi|::BoundaryEntryPlan = |darwin|::darwin_arm64_entry();
        let accepted: bool = posix_byte_view_parameters(@signature, @mutable plan);
        transition accepted {
            true -> |abi|::BoundaryPlanResult::Accepted { plan: plan },
            _ -> |abi|::BoundaryPlanResult::Rejected {
                reason: |abi|::CallingPolicyRejection { reason: "expected bounded byte views, integer or sized-reference formals, and Unit or integer result" as + |abi|::Utf8 }
            }
        }
    }
}
machine posix_byte_view_parameters(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan) -> bool
{
    transition signature.parameter_count == signature.native_parameter_count
        && signature.parameter_count <= 6
        && signature.callback_binder_count == 0 && signature.callback_demand_count == 0
        {
        true -> completion(signature, plan),
        _ -> false
    }
    machine completion(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan) -> bool
    requires signature.parameter_count <= 6 {
        transition signature.has_result {
            true -> result_index(signature, plan),
            _ -> unit(signature, plan)
        }
    }
    machine unit(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan) -> bool
    requires signature.parameter_count <= 6 {
        plan.call.parameter_count = signature.parameter_count;
        plan.call.callback_materialization_count = 0;
        plan.call.has_result = false;
        posix_byte_view_parameters_from(signature, plan, 0, 0, 6)
    }
    machine result_index(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan) -> bool {
        transition signature.result < signature.shape_count && signature.result < 256 {
            true -> result(signature, plan, @signature.shapes[signature.result]),
            _ -> false
        }
    }
    machine result(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, shape: @|abi|::ValueShape) -> bool
    requires signature.parameter_count <= 32
    {
        transition shape.class {
            |abi|::ValueClass::Integer -> result_size(signature, plan, shape),
            _ -> false
        }
    }
    machine result_size(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, shape: @|abi|::ValueShape) -> bool
    requires signature.parameter_count <= 32
    {
        transition (shape.byte_size == 4 && shape.alignment == 4)
            || (shape.byte_size == 8 && shape.alignment == 8) {
            true -> result_place(signature, plan, shape),
            _ -> false
        }
    }
    machine result_place(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, shape: @|abi|::ValueShape) -> bool
    requires signature.parameter_count <= 32
    {
        // Restate both CallPlan bounds before any other field write. The
        // parameter count is the signature's proved count, and this policy
        // materializes no callbacks. Later writes then keep that domain.
        plan.call.parameter_count = signature.parameter_count;
        plan.call.callback_materialization_count = 0;
        plan.call.has_result = true;
        plan.call.result.shape = |abi|::AbiValueShape { class: |abi|::AbiValueClass::Integer, byte_size: shape.byte_size, alignment: shape.alignment };
        plan.call.result.location_count = 1;
        plan.call.result.locations[0] = |abi|::ValueLocation::Register {
            register: posix_byte_view_result_register(@plan.call.convention), value_byte_offset: 0, byte_size: shape.byte_size
        };
        posix_byte_view_parameters_from(signature, plan, 0, 0, 6)
    }
}

machine posix_byte_view_parameters_from(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, word: u64, remaining: u64) -> bool
terminates by remaining
{
    let next_word: u64 = posix_byte_view_parameter(signature, plan, ordinal, word);
    transition {
        ordinal == signature.parameter_count -> (next_word <= 6),
        ordinal < 6 && remaining > 0 && next_word <= 6 ->
            posix_byte_view_parameters_from(signature, plan, ordinal + 1, next_word, remaining - 1),
        _ -> false
    }
}

machine posix_byte_view_parameter(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, word: u64) -> u64
{
        transition {
            ordinal == signature.parameter_count -> word,
            ordinal < signature.parameter_count && ordinal < 6 && ordinal < 32 -> root(signature, plan, ordinal, word, signature.parameters[ordinal]),
            _ -> 7
        }
    machine root(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, word: u64, root: u64) -> u64
    requires ordinal < 6
    {
        transition root < signature.shape_count && root < 256 {
            true -> shape(signature, plan, ordinal, word, @signature.shapes[root]),
            _ -> 7
        }
    }
    machine shape(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, word: u64, shape: @|abi|::ValueShape) -> u64
    requires ordinal < 6
    {
        transition shape.class {
            |abi|::ValueClass::Reference -> reference(signature, plan, ordinal, word, shape),
            |abi|::ValueClass::Integer -> scalar(signature, plan, ordinal, word, shape),
            _ -> 7
        }
    }
    machine reference(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, word: u64, shape: @|abi|::ValueShape) -> u64
    requires ordinal < 6
    {
        transition {
            shape.byte_size == 16 && shape.alignment == 8 && word <= 4 -> place(signature, plan, ordinal, word, shape, true),
            shape.byte_size == 8 && shape.alignment == 8 && word < 6 -> place(signature, plan, ordinal, word, shape, false),
            _ -> 7
        }
    }
    machine scalar(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, word: u64, shape: @|abi|::ValueShape) -> u64
    requires ordinal < 6
    {
        transition word < 6 && ((shape.byte_size == 4 && shape.alignment == 4)
            || (shape.byte_size == 8 && shape.alignment == 8)) {
            true -> place(signature, plan, ordinal, word, shape, false),
            _ -> 7
        }
    }
    machine place(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, word: u64, shape: @|abi|::ValueShape, needs_two_words: bool) -> u64
    requires ordinal < 6, word < 6
    {
        plan.call.parameters[ordinal].shape = |abi|::AbiValueShape {
            class: |abi|::AbiValueClass::Integer, byte_size: shape.byte_size, alignment: shape.alignment
        };
        transition needs_two_words {
            true -> pair(signature, plan, ordinal, word),
            _ -> single(signature, plan, ordinal, word, shape.byte_size)
        }
    }
    machine pair(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, word: u64) -> u64
    requires ordinal < 6, word < 6
    {
        transition word <= 4 {
            true -> pair_place(signature, plan, ordinal, word),
            _ -> 7
        }
    }
    machine pair_place(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, word: u64) -> u64
    requires ordinal < 6, word <= 4
    {
        plan.call.parameters[ordinal].location_count = 2;
        plan.call.parameters[ordinal].locations[0] = |abi|::ValueLocation::Register {
            register: posix_byte_view_argument_register(word, @plan.call.convention), value_byte_offset: 0, byte_size: 8
        };
        plan.call.parameters[ordinal].locations[1] = |abi|::ValueLocation::Register {
            register: posix_byte_view_argument_register(word + 1, @plan.call.convention), value_byte_offset: 8, byte_size: 8
        };
        word + 2
    }
    machine single(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, word: u64, size: u64) -> u64
    requires ordinal < 6, word < 6
    {
        plan.call.parameters[ordinal].location_count = 1;
        plan.call.parameters[ordinal].locations[0] = |abi|::ValueLocation::Register {
            register: posix_byte_view_argument_register(word, @plan.call.convention), value_byte_offset: 0, byte_size: size
        };
        word + 1
    }
}

machine posix_byte_view_argument_register(word: u64, convention: @|abi|::CallingConvention) -> |abi|::MachineRegister {
    transition convention {
        |abi|::CallingConvention::LinuxSyscallX86_64 -> x86(word, |abi|::MachineRegister::X86R10),
        |abi|::CallingConvention::SystemVAMD64 -> x86(word, |abi|::MachineRegister::X86Rcx),
        _ -> |abi|::MachineRegister::Aarch64X { index: word }
    }
    machine x86(word: u64, fourth: |abi|::MachineRegister) -> |abi|::MachineRegister {
        transition word {
            0 -> |abi|::MachineRegister::X86Rdi,
            1 -> |abi|::MachineRegister::X86Rsi,
            2 -> |abi|::MachineRegister::X86Rdx,
            3 -> fourth,
            4 -> |abi|::MachineRegister::X86R8,
            _ -> |abi|::MachineRegister::X86R9
        }
    }
}
machine posix_byte_view_result_register(convention: @|abi|::CallingConvention) -> |abi|::MachineRegister {
    transition convention {
        |abi|::CallingConvention::LinuxSyscallX86_64 -> |abi|::MachineRegister::X86Rax,
        |abi|::CallingConvention::SystemVAMD64 -> |abi|::MachineRegister::X86Rax,
        _ -> |abi|::MachineRegister::Aarch64X { index: 0 }
    }
}

machine posix_byte_view_linux_arm64_entry() -> |abi|::BoundaryEntryPlan {
    let mutable plan: |abi|::BoundaryEntryPlan;
    plan.call.convention = |abi|::CallingConvention::LinuxSyscallAarch64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = |abi|::EntryControl::SupervisorCall { number_register: |abi|::MachineRegister::Aarch64X { index: 8 }, immediate: 0 };
    plan.call.ordinary_clobbers.registers[0] = |abi|::MachineRegister::Aarch64X { index: 0 };
    plan.call.ordinary_clobbers.registers[1] = |abi|::MachineRegister::Aarch64X { index: 1 };
    plan.call.ordinary_clobbers.registers[2] = |abi|::MachineRegister::Aarch64X { index: 2 };
    plan.call.ordinary_clobbers.registers[3] = |abi|::MachineRegister::Aarch64X { index: 3 };
    plan.call.ordinary_clobbers.registers[4] = |abi|::MachineRegister::Aarch64X { index: 4 };
    plan.call.ordinary_clobbers.registers[5] = |abi|::MachineRegister::Aarch64X { index: 5 };
    plan.call.ordinary_clobbers.registers[6] = |abi|::MachineRegister::Aarch64X { index: 8 };
    plan.call.ordinary_clobbers.register_count = 7;
    plan.state.initial_regime = |abi|::MachineRegime::Aarch64A64 { exception_level: 0 };
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = |abi|::EntryStack::ProviderSelected;
    plan.state.preemption = |abi|::Preemption::NotApplicable;
    plan
}
machine posix_byte_view_linux_x86_entry() -> |abi|::BoundaryEntryPlan {
    let mutable plan: |abi|::BoundaryEntryPlan;
    plan.call.convention = |abi|::CallingConvention::LinuxSyscallX86_64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = |abi|::EntryControl::SupervisorCall { number_register: |abi|::MachineRegister::X86Rax, immediate: 0 };
    plan.call.ordinary_clobbers.registers[0] = |abi|::MachineRegister::X86Rax;
    plan.call.ordinary_clobbers.registers[1] = |abi|::MachineRegister::X86Rcx;
    plan.call.ordinary_clobbers.registers[2] = |abi|::MachineRegister::X86R11;
    plan.call.ordinary_clobbers.register_count = 3;
    plan.state.initial_regime = |abi|::MachineRegime::X86Long64;
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = |abi|::EntryStack::ProviderSelected;
    plan.state.preemption = |abi|::Preemption::NotApplicable;
    plan
}

machine posix_byte_view_system_v_entry() -> |abi|::BoundaryEntryPlan {
    let mutable plan: |abi|::BoundaryEntryPlan;
    plan.call.convention = |abi|::CallingConvention::SystemVAMD64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = |abi|::EntryControl::CallReturn;
    plan.state.initial_regime = |abi|::MachineRegime::X86Long64;
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = |abi|::EntryStack::ProviderSelected;
    plan.state.preemption = |abi|::Preemption::NotApplicable;
    plan.call.ordinary_clobbers.registers[0] = |abi|::MachineRegister::X86Rax;
    plan.call.ordinary_clobbers.registers[1] = |abi|::MachineRegister::X86Rcx;
    plan.call.ordinary_clobbers.registers[2] = |abi|::MachineRegister::X86Rdx;
    plan.call.ordinary_clobbers.registers[3] = |abi|::MachineRegister::X86Rsi;
    plan.call.ordinary_clobbers.registers[4] = |abi|::MachineRegister::X86Rdi;
    plan.call.ordinary_clobbers.registers[5] = |abi|::MachineRegister::X86R8;
    plan.call.ordinary_clobbers.registers[6] = |abi|::MachineRegister::X86R9;
    plan.call.ordinary_clobbers.registers[7] = |abi|::MachineRegister::X86R10;
    plan.call.ordinary_clobbers.registers[8] = |abi|::MachineRegister::X86R11;
    plan.call.ordinary_clobbers.registers[9] = |abi|::MachineRegister::X86Xmm { index: 0 };
    plan.call.ordinary_clobbers.registers[10] = |abi|::MachineRegister::X86Xmm { index: 1 };
    plan.call.ordinary_clobbers.registers[11] = |abi|::MachineRegister::X86Xmm { index: 2 };
    plan.call.ordinary_clobbers.registers[12] = |abi|::MachineRegister::X86Xmm { index: 3 };
    plan.call.ordinary_clobbers.registers[13] = |abi|::MachineRegister::X86Xmm { index: 4 };
    plan.call.ordinary_clobbers.registers[14] = |abi|::MachineRegister::X86Xmm { index: 5 };
    plan.call.ordinary_clobbers.registers[15] = |abi|::MachineRegister::X86Xmm { index: 6 };
    plan.call.ordinary_clobbers.registers[16] = |abi|::MachineRegister::X86Xmm { index: 7 };
    plan.call.ordinary_clobbers.registers[17] = |abi|::MachineRegister::X86Xmm { index: 8 };
    plan.call.ordinary_clobbers.registers[18] = |abi|::MachineRegister::X86Xmm { index: 9 };
    plan.call.ordinary_clobbers.registers[19] = |abi|::MachineRegister::X86Xmm { index: 10 };
    plan.call.ordinary_clobbers.registers[20] = |abi|::MachineRegister::X86Xmm { index: 11 };
    plan.call.ordinary_clobbers.registers[21] = |abi|::MachineRegister::X86Xmm { index: 12 };
    plan.call.ordinary_clobbers.registers[22] = |abi|::MachineRegister::X86Xmm { index: 13 };
    plan.call.ordinary_clobbers.registers[23] = |abi|::MachineRegister::X86Xmm { index: 14 };
    plan.call.ordinary_clobbers.registers[24] = |abi|::MachineRegister::X86Xmm { index: 15 };
    plan.call.ordinary_clobbers.register_count = 25;
    plan
}
