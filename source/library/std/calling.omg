// CALLING POLICIES (design_briefs/calling_plans.md): ordinary packages may
// author a policy machine, but the values it receives and returns come from
// this compiler-owned, closed vocabulary. Array tails beyond each explicit
// count are ignored and exist only because Omega arrays have fixed length.
// BoundarySignature carries a bounded flat graph. ValueShape cases refer to
// child-shape or field-table indices, so fixed arrays and records retain their
// recursive public structure without requiring an infinitely sized recursive
// data declaration. ValuePlacement uses the separate classified ABI shape the
// policy chooses after inspecting that graph.
//
// COUNT CARRIERS: byte sizes, alignments, counts, indices, register ordinals,
// immediates, and nonnegative stack offsets use u64, never addr.

domain [u8; 256]::Utf8
requires
    valid_utf8(self);

data SystemVEightbyteClass {
    case Integer;
    case Sse;
}

data ValueClass {
    case Integer;
    case Float;
    case Reference;
    case FixedArray(element: u64, length: u64);
    case Record(first_field: u64, field_count: u64);
}

data ValueShape {
    class: ValueClass;
    byte_size: u64;
    alignment: u64;
}

data ValueField {
    shape: u64;
    byte_offset: u64;
}

data CallbackBinderIdentity {
    binder: u64;
    requirement: u64;
}

data AbiValueClass {
    case Integer;
    case Float;
    case HomogeneousFloatAggregate(members: u64);
    case SystemVAggregate(
        first: SystemVEightbyteClass,
        second: SystemVEightbyteClass
    );
}

data AbiValueShape {
    class: AbiValueClass;
    byte_size: u64;
    alignment: u64;
}

// These fields carry compiler-issued nominal identities. Publishing the
// binder/signature and validated layout-demand catalogs that supply them is a
// separate compiler step. `Parameter` names one interleaved native-only
// callback parameter declared by the registrar requirement; it has no Omega
// runtime value or source-call argument. `Field.parameter` names an entry in
// the same native-parameter identity space whose source is an ordinary semantic
// formal. Parameter names establish nominal identity, while authored native-
// telescope order separately establishes ABI position. A private layout demand
// originates only from one
// explicitly cited named `PrivateCallbackSlot<Requirement>` conformance in the
// authoritative layout plan; its physical offset is not repeated here. A
// policy cannot establish an identity by inventing an integer, and unknown
// values reject during plan validation. Calling policy may place declared
// native entries but cannot create, reorder, or retarget them.
data NativePlace {
    case Parameter(parameter: u64);
    case Field(
        parameter: u64,
        layout: u64,
        field_path: [u64; 16],
        field_path_count: u64 [1..=16]
    );
}

data NativeCallbackDemandIdentity {
    destination: NativePlace;
    requirement: u64;
}

data BoundarySignature {
    shapes: [ValueShape; 256];
    shape_count: u64 [0..=256];
    fields: [ValueField; 256];
    field_count: u64 [0..=256];
    parameters: [u64; 32];
    parameter_count: u64 [0..=32];
    callback_binders: [CallbackBinderIdentity; 32];
    callback_binder_count: u64 [0..=32];
    callback_demands: [NativeCallbackDemandIdentity; 32];
    callback_demand_count: u64 [0..=32];
    has_result: bool;
    result: u64;
}

data MachineRegister {
    case X86Rax;
    case X86Rcx;
    case X86Rdx;
    case X86Rbx;
    case X86Rsp;
    case X86Rbp;
    case X86Rsi;
    case X86Rdi;
    case X86R8;
    case X86R9;
    case X86R10;
    case X86R11;
    case X86R12;
    case X86R13;
    case X86R14;
    case X86R15;
    case X86Xmm(index: u64);
    case Aarch64X(index: u64);
    case Aarch64V(index: u64);
}

data IndirectPointerLocation {
    case Register(register: MachineRegister);
    case Stack(stack_byte_offset: u64, alignment: u64);
}

data ValueLocation {
    case Register(
        register: MachineRegister,
        value_byte_offset: u64,
        byte_size: u64
    );
    case Stack(
        stack_byte_offset: u64,
        value_byte_offset: u64,
        byte_size: u64,
        alignment: u64
    );
    case Indirect(
        pointer: IndirectPointerLocation,
        has_copy: bool,
        copy_stack_byte_offset: u64,
        byte_size: u64,
        alignment: u64
    );
}

data ValuePlacement {
    shape: AbiValueShape;
    locations: [ValueLocation; 16];
    location_count: u64 [0..=16];
}

data CallingConvention {
    case MicrosoftX64;
    case SystemVAMD64;
    case Aapcs64;
    case LinuxSyscallX86_64;
    case LinuxSyscallAarch64;
}

data RegisterSet {
    registers: [MachineRegister; 64];
    register_count: u64 [0..=64];
}

data EntryControl {
    case CallReturn;
    case SupervisorCall(
        number_register: MachineRegister,
        immediate: u64
    );
    case InterruptReturn;
}

data CallbackMaterialization {
    binder: u64;
    destination: NativePlace;
}

data CallPlan {
    convention: CallingConvention;
    parameters: [ValuePlacement; 32];
    parameter_count: u64 [0..=32];
    has_result: bool;
    result: ValuePlacement;
    callback_materializations: [CallbackMaterialization; 32];
    callback_materialization_count: u64 [0..=32];
    ordinary_clobbers: RegisterSet;
    stack_alignment: u64;
    shadow_bytes: u64;
    entry_control: EntryControl;
}

data MachineRegime {
    case X86Long64;
    case Aarch64A64(exception_level: u64);
}

data MachineStateSet {
    general_registers: bool;
    vector_registers: bool;
    flags: bool;
    instruction_pointer: bool;
    stack_pointer: bool;
    segment_state: bool;
    control_state: bool;
    debug_state: bool;
    extended_state: bool;
}

data EntryStack {
    case Interrupted;
    case Dedicated(class: u64);
    case ProviderSelected;
}

data Preemption {
    case NotApplicable;
    case Masked;
    case Nestable(maximum_depth: u64);
    case ProviderDefined;
}

data StatePlan {
    initial_regime: MachineRegime;
    interrupted_state: MachineStateSet;
    saved_state: MachineStateSet;
    restored_state: MachineStateSet;
    permitted_transitive_use: MachineStateSet;
    stack: EntryStack;
    preemption: Preemption;
}

data BoundaryEntryPlan {
    call: CallPlan;
    state: StatePlan;
}

data CallingPolicyRejection {
    reason: [u8; 256] in Utf8;
}

data BoundaryPlanResult {
    case Accepted(plan: BoundaryEntryPlan);
    case Rejected(reason: CallingPolicyRejection);
}

trait CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult;
}

// Every Calling<C> relationship first proves the policy type's nominal
// CallingPolicy conformance. The compiler can then evaluate that selected
// conformance's plan machine and validate its canonical result.
trait Calling<C>
where C satisfies CallingPolicy
{ }
