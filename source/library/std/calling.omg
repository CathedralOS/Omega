// CALLING POLICIES (design_briefs/calling_plans.md): ordinary packages may
// author a policy machine, but the values it receives and returns come from
// this compiler-owned, closed vocabulary. Array tails beyond each explicit
// count are ignored and exist only because Omega arrays have fixed length.
// BoundarySignature carries a bounded flat graph. ValueShape cases refer to
// child-shape or field-table indices, so fixed arrays and records retain their
// recursive public structure without requiring an infinitely sized recursive
// data declaration. ValuePlacement uses the separate classified ABI shape the
// policy chooses after inspecting that graph.
//
// COUNT CARRIERS: byte sizes, alignments, counts, indices, register ordinals,
// immediates, and nonnegative stack offsets use u64, never addr.

public domain [u8]::Utf8
requires
    valid_utf8(self);

public data SystemVEightbyteClass {
    case Integer;
    case Sse;
}

// ABI descriptions are reusable pure data, not ownership of described storage.
// Policies inspect and pass them repeatedly while assembling a plan.
public data ValueClass [copy] {
    case Integer;
    case Float;
    case Reference;
    case FixedArray(element: u64, length: u64);
    case Record(first_field: u64, field_count: u64);
}

public data ValueShape [copy] {
    class: ValueClass;
    byte_size: u64;
    alignment: u64;
}

public data ValueField [copy] {
    shape: u64;
    byte_offset: u64;
}

public data CallbackBinderIdentity [copy] {
    binder: u64;
    requirement: u64;
}

public data AbiValueClass {
    case Integer;
    case Float;
    case HomogeneousFloatAggregate(members: u64);
    case SystemVAggregate(
        first: SystemVEightbyteClass,
        second: SystemVEightbyteClass
    );
}

public data AbiValueShape {
    class: AbiValueClass;
    byte_size: u64;
    alignment: u64;
}

// These fields carry compiler-issued nominal identities. Publishing the
// binder/signature and validated layout-demand catalogs that supply them is a
// separate compiler step. `Parameter` names one interleaved native-only
// callback parameter declared by the registrar requirement; it has no Omega
// runtime value or source-call argument. `Field.parameter` names an entry in
// the same native-parameter identity space whose source is an ordinary semantic
// formal. Parameter names establish nominal identity, while authored native-
// telescope order separately establishes ABI position. A private layout demand
// originates only from one explicitly cited named
// `PrivateCallbackSlot<Layout, Requirement>` implementation in the
// authoritative layout plan; its physical offset is not repeated here. A
// policy cannot establish an identity by inventing an integer, and unknown
// values reject during plan validation. Calling policy may place declared
// native entries but cannot create, reorder, or retarget them.
// A native destination names a compiler-issued plan coordinate; copying the
// coordinate grants no authority over the storage it describes.
public data NativePlace [copy] 
    requires (self in NativePlace::Parameter) || ((self in NativePlace::Field) && (self.field_path_count >= 1) && (self.field_path_count <= 16))
{
    case Parameter(parameter: u64);
    case Field(
        parameter: u64,
        layout: u64,
        field_path: [u64; 16],
        field_path_count: u64
    );
}

public data NativeCallbackDemandIdentity [copy] {
    destination: NativePlace;
    requirement: u64;
}

public data NativeParameterOrigin [copy] {
    case SemanticFormal(formal_ordinal: u64);
    case PrivateCallback(binder: u64, requirement: u64);
}

public data NativeParameterShape [copy] {
    case Semantic(root: u64);
    case TargetFunctionPointer(byte_size: u64, alignment: u64);
}

// Policies receive the complete declaration roster. The table role fixes
// which semantic formals reach the callee before final native placement;
// callbacks keep their authored destinations through that normalization.
public data NativeParameterIdentity [copy] {
    identity: u64;
    native_ordinal: u64;
    origin: NativeParameterOrigin;
    shape: NativeParameterShape;
}

public data BoundarySignature [copy] requires shape_count <= 256, field_count <= 256,
    parameter_count <= 32, native_parameter_count <= 32,
    callback_binder_count <= 64, callback_demand_count <= 64 {
    shapes: [ValueShape; 256];
    shape_count: u64;
    fields: [ValueField; 256];
    field_count: u64;
    parameters: [u64; 32];
    parameter_count: u64;
    native_parameters: [NativeParameterIdentity; 32];
    native_parameter_count: u64;
    callback_binders: [CallbackBinderIdentity; 64];
    callback_binder_count: u64;
    callback_demands: [NativeCallbackDemandIdentity; 64];
    callback_demand_count: u64;
    has_result: bool;
    result: u64;
}

// Register names are plan values, not ownership of live hardware registers.
// A policy may copy a name while assembling placements and clobber sets.
public data MachineRegister [copy] {
    case X86Rax;
    case X86Rcx;
    case X86Rdx;
    case X86Rbx;
    case X86Rsp;
    case X86Rbp;
    case X86Rsi;
    case X86Rdi;
    case X86R8;
    case X86R9;
    case X86R10;
    case X86R11;
    case X86R12;
    case X86R13;
    case X86R14;
    case X86R15;
    case X86Xmm(index: u64);
    case Aarch64X(index: u64);
    case Aarch64V(index: u64);
}

public data IndirectPointerLocation {
    case Register(register: MachineRegister);
    case Stack(stack_byte_offset: u64, alignment: u64);
}

public data ValueLocation {
    case Register(
        register: MachineRegister,
        value_byte_offset: u64,
        byte_size: u64
    );
    case Stack(
        stack_byte_offset: u64,
        value_byte_offset: u64,
        byte_size: u64,
        alignment: u64
    );
    case Indirect(
        pointer: IndirectPointerLocation,
        has_copy: bool,
        copy_stack_byte_offset: u64,
        byte_size: u64,
        alignment: u64
    );
}

public data ValuePlacement requires location_count <= 16 {
    shape: AbiValueShape;
    locations: [ValueLocation; 16];
    location_count: u64;
}

public data CallingConvention {
    case MicrosoftX64;
    case SystemVAMD64;
    case Aapcs64;
    case LinuxSyscallX86_64;
    case LinuxSyscallAarch64;
}

public data RegisterSet requires register_count <= 64 {
    registers: [MachineRegister; 64];
    register_count: u64;
}

public data EntryControl {
    case CallReturn;
    case SupervisorCall(
        number_register: MachineRegister,
        immediate: u64
    );
    case InterruptReturn;
}

public data CallbackMaterialization {
    binder: u64;
    destination: NativePlace;
}

// The identity names an original semantic formal, before native positions.
// The compiler checks the identity and ordinal together against that requirement.
public data TableParameter [copy] {
    case None;
    case Passed(formal: u64, formal_ordinal: u64);
    case DispatchOnly(formal: u64, formal_ordinal: u64);
}

public data CallPlan requires parameter_count <= 32, callback_materialization_count <= 64 {
    convention: CallingConvention;
    table_parameter: TableParameter;
    parameters: [ValuePlacement; 32];
    parameter_count: u64;
    has_result: bool;
    result: ValuePlacement;
    callback_materializations: [CallbackMaterialization; 64];
    callback_materialization_count: u64;
    ordinary_clobbers: RegisterSet;
    stack_alignment: u64;
    shadow_bytes: u64;
    entry_control: EntryControl;
}

public data MachineRegime {
    case X86Long64;
    case Aarch64A64(exception_level: u64);
}

public data MachineStateSet {
    general_registers: bool;
    vector_registers: bool;
    flags: bool;
    instruction_pointer: bool;
    stack_pointer: bool;
    segment_state: bool;
    control_state: bool;
    debug_state: bool;
    extended_state: bool;
}

public data EntryStack {
    case Interrupted;
    case Dedicated(class: u64);
    case ProviderSelected;
}

public data Preemption {
    case NotApplicable;
    case Masked;
    case Nestable(maximum_depth: u64);
    case ProviderDefined;
}

public data StatePlan {
    initial_regime: MachineRegime;
    interrupted_state: MachineStateSet;
    saved_state: MachineStateSet;
    restored_state: MachineStateSet;
    permitted_transitive_use: MachineStateSet;
    stack: EntryStack;
    preemption: Preemption;
}

public data BoundaryEntryPlan {
    call: CallPlan;
    state: StatePlan;
}

public data CallingPolicyRejection<'reason> {
    // Rejections borrow their diagnostic literal; qualification adds no storage.
    reason: &'reason [u8] in Utf8;
}

public data BoundaryPlanResult<'reason> {
    case Accepted(plan: BoundaryEntryPlan);
    case Rejected(reason: CallingPolicyRejection<'reason>);
}

public trait CallingPolicy {
    machine plan(signature: BoundarySignature) -> BoundaryPlanResult;
}

// The selected named implementation supplies the exact plan requirement row.
// Data names and attached machines cannot select a policy implicitly.
public trait Calling<Policy satisfies CallingPolicy>
{ }

// Table roles name compiler-issued semantic formals, never native positions.
// This helper searches the original declaration roster even when a table is
// not the first formal. Unknown or callback-only coordinates remain unselected.
public machine table_parameter_for_formal(signature: &BoundarySignature,
    formal_ordinal: u64, dispatch_only: bool) -> TableParameter {
    seek(signature, formal_ordinal, dispatch_only, 0, 32)
    machine seek(signature: &BoundarySignature, formal_ordinal: u64,
        dispatch_only: bool, index: u64, remaining: u64) -> TableParameter
    terminates by remaining {
        transition index < signature.native_parameter_count && index < 32 && remaining > 0 {
            true -> inspect(signature, formal_ordinal, dispatch_only, index, remaining)
            _ -> TableParameter::None
        }
    }
    machine inspect(signature: &BoundarySignature, formal_ordinal: u64,
        dispatch_only: bool, index: u64, remaining: u64) -> TableParameter
    requires index < 32, remaining > 0 {
        transition signature.native_parameters[index].origin {
            NativeParameterOrigin::SemanticFormal { formal_ordinal as actual } ->
                compare(signature, formal_ordinal, dispatch_only, index, remaining, actual)
            _ -> seek(signature, formal_ordinal, dispatch_only, index + 1, remaining - 1)
        }
    }
    machine compare(signature: &BoundarySignature, formal_ordinal: u64,
        dispatch_only: bool, index: u64, remaining: u64, actual: u64) -> TableParameter
    requires index < 32, remaining > 0 {
        transition actual == formal_ordinal {
            true -> selected(signature.native_parameters[index].identity, formal_ordinal, dispatch_only)
            _ -> seek(signature, formal_ordinal, dispatch_only, index + 1, remaining - 1)
        }
    }
    machine selected(formal: u64, formal_ordinal: u64, dispatch_only: bool) -> TableParameter {
        transition dispatch_only {
            true -> TableParameter::DispatchOnly { formal: formal, formal_ordinal: formal_ordinal }
            _ -> TableParameter::Passed { formal: formal, formal_ordinal: formal_ordinal }
        }
    }
}

// Removing a dispatch formal affects only the roots used for native placement.
// The immutable declaration identities remain available to the compiler's join.
// Callback-bearing signatures need a policy that handles their declared slots.
public machine normalize_table_parameters(signature: &mut BoundarySignature,
    role: TableParameter) -> bool {
    transition role {
        TableParameter::None -> true
        TableParameter::Passed { formal, formal_ordinal as ordinal } ->
            valid(signature, formal, ordinal, false)
        TableParameter::DispatchOnly { formal, formal_ordinal as ordinal } ->
            valid(signature, formal, ordinal, true)
        _ -> false
    }
    machine valid(signature: &mut BoundarySignature, formal: u64, ordinal: u64,
        dispatch: bool) -> bool {
        transition ordinal < signature.parameter_count && ordinal < 32
            && signature.callback_binder_count == 0 && signature.callback_demand_count == 0
            && signature.parameter_count == signature.native_parameter_count {
            true -> identify(signature, formal, ordinal, dispatch)
            _ -> false
        }
    }
    machine identify(signature: &mut BoundarySignature, formal: u64, ordinal: u64,
        dispatch: bool) -> bool
    requires ordinal < signature.parameter_count, ordinal < 32,
        signature.parameter_count == signature.native_parameter_count {
        let selected: TableParameter = table_parameter_for_formal(signature, ordinal, dispatch);
        identified(signature, formal, ordinal, selected)
    }
    machine identified(signature: &mut BoundarySignature, formal: u64, ordinal: u64,
        selected: TableParameter) -> bool
    requires ordinal < signature.parameter_count, ordinal < 32,
        signature.parameter_count == signature.native_parameter_count {
        transition selected {
            TableParameter::Passed { formal as actual, formal_ordinal as found } -> (actual == formal && found == ordinal)
            TableParameter::DispatchOnly { formal as actual, formal_ordinal as found } ->
                remove_if_exact(signature, formal, ordinal, actual, found)
            _ -> false
        }
    }
    machine remove_if_exact(signature: &mut BoundarySignature, formal: u64,
        ordinal: u64, actual: u64, found: u64) -> bool
    requires ordinal < signature.parameter_count, ordinal < 32,
        signature.parameter_count == signature.native_parameter_count {
        transition actual == formal && found == ordinal {
            true -> shift(signature, ordinal, 32)
            _ -> false
        }
    }
    machine shift(signature: &mut BoundarySignature, index: u64, remaining: u64) -> bool
    requires index < signature.parameter_count,
        signature.parameter_count == signature.native_parameter_count
    terminates by remaining {
        transition index + 1 < signature.parameter_count && index + 1 < 32 && remaining > 0 {
            true -> next(signature, index, remaining)
            index + 1 >= signature.parameter_count -> finish(signature)
            _ -> false
        }
    }
    machine next(signature: &mut BoundarySignature, index: u64, remaining: u64) -> bool
    requires index < 32, index + 1 < signature.parameter_count, index + 1 < 32, remaining > 0,
        signature.parameter_count == signature.native_parameter_count {
        signature.parameters[index] = signature.parameters[index + 1];
        signature.native_parameters[index] = signature.native_parameters[index + 1];
        signature.native_parameters[index].native_ordinal = index;
        shift(signature, index + 1, remaining - 1)
    }
    machine finish(signature: &mut BoundarySignature) -> bool
    requires signature.parameter_count > 0,
        signature.parameter_count == signature.native_parameter_count {
        let count: u64 = signature.parameter_count - 1;
        signature.parameter_count = count;
        signature.native_parameter_count = count;
        true
    }
}
