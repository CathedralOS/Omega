// One carrier, two explicit floating formats. Arithmetic never allocates.
// Destination loans must be disjoint from borrowed inputs; copy explicitly
// before an in-place update. See complex_carrier_ops.api.txt for rounding,
// overflow and magnitude policy. No matrix shape or backing storage is owned here.
module complex::complex_carrier_ops;

use omega::language::core::float_operations;
use numeric::numeric_accuracy_policy::NumericClass;
use numeric::numeric_accuracy_policy::classify_f32;
use numeric::numeric_accuracy_policy::classify_f64;

// NF02 supplies the format-specific classification. This operation's input
// admission includes both signed zeros and finite nonzero values; its result
// carrier continues to distinguish rejected inputs from magnitude overflow.
machine admitted_finite(classification: NumericClass) -> bool {
    transition classification {
        NumericClass::Finite -> true
        NumericClass::PositiveZero -> true
        NumericClass::NegativeZero -> true
        _ -> false
    }
}

// Empty operation namespaces; values remain in the single Complex<T> carrier.
public data ComplexF32 { }
public data ComplexF64 { }

public data Complex<T [copy]> [copy] {
    real: T;
    imaginary: T;
}

// These errors belong to magnitude, while NF02 owns scalar classification.
// Nonfinite component classes reject as inputs; a nonfinite final magnitude
// after finite admission reports Overflow rather than changing the input class.
public data ComplexMagnitude<T [copy]> [copy] {
    case Value(value: T);
    case NonFiniteInput;
    case Overflow;
}

public machine ComplexF32::add(destination: &mut Complex<f32>, left: &Complex<f32>, right: &Complex<f32>) {
    destination.real = left.real + right.real;
    destination.imaginary = left.imaginary + right.imaginary;
}

public machine ComplexF32::multiply(destination: &mut Complex<f32>, left: &Complex<f32>, right: &Complex<f32>) {
    let real_real: f32 = left.real * right.real;
    let imaginary_imaginary: f32 = left.imaginary * right.imaginary;
    let real_imaginary: f32 = left.real * right.imaginary;
    let imaginary_real: f32 = left.imaginary * right.real;
    destination.real = real_real - imaginary_imaginary;
    destination.imaginary = real_imaginary + imaginary_real;
}

public machine ComplexF32::conjugate(destination: &mut Complex<f32>, input: &Complex<f32>) {
    destination.real = input.real;
    destination.imaginary = F32::negate(input.imaginary);
}

// Norm means squared Euclidean norm; magnitude has a separate name.
public machine ComplexF32::norm_squared(input: &Complex<f32>) -> f32 {
    let real_squared: f32 = input.real * input.real;
    let imaginary_squared: f32 = input.imaginary * input.imaginary;
    transition { _ -> (real_squared + imaginary_squared) }
}

// Scaling before squaring avoids avoidable intermediate overflow/underflow.
// It cannot represent a true magnitude beyond the destination format.
public machine ComplexF32::try_magnitude(input: &Complex<f32>) -> ComplexMagnitude<f32> {
    let real_finite: bool = admitted_finite(classify_f32(input.real));
    let imaginary_finite: bool = admitted_finite(classify_f32(input.imaginary));
    transition real_finite && imaginary_finite {
        true -> absolute(input.real, input.imaginary)
        _ -> (ComplexMagnitude::NonFiniteInput)
    }
    machine absolute(real: f32, imaginary: f32) -> ComplexMagnitude<f32> {
        transition real < 0.0 { true -> negative_real(real, imaginary) _ -> absolute_imaginary(real, imaginary) }
    }
    machine negative_real(real: f32, imaginary: f32) -> ComplexMagnitude<f32> {
        transition { _ -> absolute_imaginary(F32::negate(real), imaginary) }
    }
    machine absolute_imaginary(real: f32, imaginary: f32) -> ComplexMagnitude<f32> {
        transition imaginary < 0.0 { true -> scale(real, F32::negate(imaginary)) _ -> scale(real, imaginary) }
    }
    machine scale(real: f32, imaginary: f32) -> ComplexMagnitude<f32> {
        transition real >= imaginary { true -> ordered(real, imaginary) _ -> ordered(imaginary, real) }
    }
    machine ordered(high: f32, low: f32) -> ComplexMagnitude<f32> {
        transition high == 0.0 { true -> (ComplexMagnitude::Value { value: 0.0 }) _ -> ratio(high, low) }
    }
    machine ratio(high: f32, low: f32) -> ComplexMagnitude<f32> {
        let ratio: f32 = low / high;
        let square: f32 = ratio * ratio;
        let factor: f32 = F32::square_root(1.0 + square);
        let magnitude: f32 = high * factor;
        let finite: bool = admitted_finite(classify_f32(magnitude));
        transition finite { true -> (ComplexMagnitude::Value { value: magnitude }) _ -> (ComplexMagnitude::Overflow) }
    }
}

public machine ComplexF64::add(destination: &mut Complex<f64>, left: &Complex<f64>, right: &Complex<f64>) {
    destination.real = left.real + right.real;
    destination.imaginary = left.imaginary + right.imaginary;
}

public machine ComplexF64::multiply(destination: &mut Complex<f64>, left: &Complex<f64>, right: &Complex<f64>) {
    let real_real: f64 = left.real * right.real;
    let imaginary_imaginary: f64 = left.imaginary * right.imaginary;
    let real_imaginary: f64 = left.real * right.imaginary;
    let imaginary_real: f64 = left.imaginary * right.real;
    destination.real = real_real - imaginary_imaginary;
    destination.imaginary = real_imaginary + imaginary_real;
}

public machine ComplexF64::conjugate(destination: &mut Complex<f64>, input: &Complex<f64>) {
    destination.real = input.real;
    destination.imaginary = F64::negate(input.imaginary);
}

// Norm means squared Euclidean norm; magnitude has a separate name.
public machine ComplexF64::norm_squared(input: &Complex<f64>) -> f64 {
    let real_squared: f64 = input.real * input.real;
    let imaginary_squared: f64 = input.imaginary * input.imaginary;
    transition { _ -> (real_squared + imaginary_squared) }
}

// Scaling before squaring avoids avoidable intermediate overflow/underflow.
// It cannot represent a true magnitude beyond the destination format.
public machine ComplexF64::try_magnitude(input: &Complex<f64>) -> ComplexMagnitude<f64> {
    let real_finite: bool = admitted_finite(classify_f64(input.real));
    let imaginary_finite: bool = admitted_finite(classify_f64(input.imaginary));
    transition real_finite && imaginary_finite {
        true -> absolute(input.real, input.imaginary)
        _ -> (ComplexMagnitude::NonFiniteInput)
    }
    machine absolute(real: f64, imaginary: f64) -> ComplexMagnitude<f64> {
        transition real < 0.0 { true -> negative_real(real, imaginary) _ -> absolute_imaginary(real, imaginary) }
    }
    machine negative_real(real: f64, imaginary: f64) -> ComplexMagnitude<f64> {
        transition { _ -> absolute_imaginary(F64::negate(real), imaginary) }
    }
    machine absolute_imaginary(real: f64, imaginary: f64) -> ComplexMagnitude<f64> {
        transition imaginary < 0.0 { true -> scale(real, F64::negate(imaginary)) _ -> scale(real, imaginary) }
    }
    machine scale(real: f64, imaginary: f64) -> ComplexMagnitude<f64> {
        transition real >= imaginary { true -> ordered(real, imaginary) _ -> ordered(imaginary, real) }
    }
    machine ordered(high: f64, low: f64) -> ComplexMagnitude<f64> {
        transition high == 0.0 { true -> (ComplexMagnitude::Value { value: 0.0 }) _ -> ratio(high, low) }
    }
    machine ratio(high: f64, low: f64) -> ComplexMagnitude<f64> {
        let ratio: f64 = low / high;
        let square: f64 = ratio * ratio;
        let factor: f64 = F64::square_root(1.0 + square);
        let magnitude: f64 = high * factor;
        let finite: bool = admitted_finite(classify_f64(magnitude));
        transition finite { true -> (ComplexMagnitude::Value { value: magnitude }) _ -> (ComplexMagnitude::Overflow) }
    }
}
