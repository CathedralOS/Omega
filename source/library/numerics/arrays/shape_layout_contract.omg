// Rank-two descriptors describe caller-owned storage, never own or allocate it.
// Bounds use division against remaining capacity before multiplication; wrapping
// arithmetic is used only after those guards establish mathematical exactness.
// Mutable injectivity follows the minimal integer solution of dr*sr = dc*sc.

public data Layout2 [copy] {
    rows: u64; columns: u64; origin: u64;
    row_stride: u64; column_stride: u64;
}
public data IndexResult [copy] { case Invalid; case Ok(index: u64); }
public data ReadResult [copy] { case Invalid; case Ok(value: i32); }

public machine try_offset(layout: &Layout2, backing_length: u64, row: u64, column: u64) -> IndexResult {
    transition row < layout.rows && column < layout.columns && layout.origin < backing_length {
        true -> row_capacity(layout, backing_length, row, column)
        false -> IndexResult::Invalid
    }
    machine row_capacity(layout: &Layout2, backing_length: u64, row: u64, column: u64) -> IndexResult {
        let available: u64 in Wrapping = (backing_length as u64 in Wrapping) - 1 - (layout.origin as u64 in Wrapping);
        transition layout.row_stride > 0 {
            true -> row_limit(layout, row, column, available as u64)
            false -> column_capacity(layout, column, layout.origin, available as u64)
        }
    }
    machine row_limit(layout: &Layout2, row: u64, column: u64, available: u64) -> IndexResult
    requires layout.row_stride > 0 {
        let limit: u64 = available / layout.row_stride;
        transition row <= limit {
            true -> row_exact(layout, row, column, available)
            false -> IndexResult::Invalid
        }
    }
    machine row_exact(layout: &Layout2, row: u64, column: u64, available: u64) -> IndexResult {
        let displacement: u64 in Wrapping = (row as u64 in Wrapping) * (layout.row_stride as u64 in Wrapping);
        let start: u64 in Wrapping = (layout.origin as u64 in Wrapping) + displacement;
        let remaining: u64 in Wrapping = (available as u64 in Wrapping) - displacement;
        transition { _ -> column_capacity(layout, column, start as u64, remaining as u64) }
    }
    machine column_capacity(layout: &Layout2, column: u64, start: u64, available: u64) -> IndexResult {
        transition layout.column_stride > 0 {
            true -> column_limit(layout, column, start, available)
            false -> IndexResult::Ok { index: start }
        }
    }
    machine column_limit(layout: &Layout2, column: u64, start: u64, available: u64) -> IndexResult
    requires layout.column_stride > 0 {
        let limit: u64 = available / layout.column_stride;
        transition column <= limit {
            true -> emit(layout, column, start)
            false -> IndexResult::Invalid
        }
    }
    machine emit(layout: &Layout2, column: u64, start: u64) -> IndexResult {
        let index: u64 in Wrapping = (start as u64 in Wrapping) + (column as u64 in Wrapping) * (layout.column_stride as u64 in Wrapping);
        IndexResult::Ok { index: index as u64 }
    }
}

public machine valid_readonly(layout: &Layout2, backing_length: u64) -> bool {
    transition layout.rows == 0 || layout.columns == 0 {
        true -> (layout.origin <= backing_length)
        false -> nonempty(layout, backing_length)
    }
    machine nonempty(layout: &Layout2, backing_length: u64) -> bool {
        let row: u64 in Wrapping = (layout.rows as u64 in Wrapping) - 1;
        let column: u64 in Wrapping = (layout.columns as u64 in Wrapping) - 1;
        let selected: IndexResult = try_offset(layout, backing_length, row as u64, column as u64);
        transition selected { IndexResult::Ok { index } -> true IndexResult::Invalid -> false }
    }
}

machine greatest_common_divisor(left: u64, right: u64) -> u64
terminates by right -> Nat::Descending;
{
    transition right > 0 {
        true -> greatest_common_divisor(right, left % right)
        false -> left
    }
}

public machine valid_mutable(layout: &Layout2, backing_length: u64) -> bool {
    let bounded: bool = valid_readonly(layout, backing_length);
    transition bounded {
        true -> injective(layout)
        false -> false
    }
    machine injective(layout: &Layout2) -> bool {
        transition layout.rows == 0 || layout.columns == 0 {
            true -> true
            false -> strides(layout)
        }
    }
    machine strides(layout: &Layout2) -> bool {
        transition (layout.rows > 1 && layout.row_stride == 0) || (layout.columns > 1 && layout.column_stride == 0) {
            true -> false
            false -> axes(layout)
        }
    }
    machine axes(layout: &Layout2) -> bool {
        transition layout.rows <= 1 || layout.columns <= 1 {
            true -> true
            false -> collision(layout)
        }
    }
    machine collision(layout: &Layout2) -> bool {
        let divisor: u64 = greatest_common_divisor(layout.row_stride, layout.column_stride);
        transition divisor > 0 {
            true -> compare(layout, divisor)
            false -> false
        }
    }
    machine compare(layout: &Layout2, divisor: u64) -> bool requires divisor > 0 {
        let row_delta: u64 = layout.column_stride / divisor;
        let column_delta: u64 = layout.row_stride / divisor;
        layout.rows <= row_delta || layout.columns <= column_delta
    }
}

public machine transpose(layout: &Layout2) -> Layout2 {
    Layout2 { rows: layout.columns, columns: layout.rows, origin: layout.origin,
        row_stride: layout.column_stride, column_stride: layout.row_stride }
}

public machine read_checked(backing: &[i32], index: u64) -> i32
requires index < backing.len {
    backing[index]
}

public machine try_read(backing: &[i32], layout: &Layout2, row: u64, column: u64) -> ReadResult {
    let admitted: bool = valid_readonly(layout, backing.len);
    transition admitted {
        true -> locate(backing, layout, row, column)
        false -> ReadResult::Invalid
    }
    machine locate(backing: &[i32], layout: &Layout2, row: u64, column: u64) -> ReadResult {
        let selected: IndexResult = try_offset(layout, backing.len, row, column);
        transition selected { IndexResult::Ok { index } -> bounded(backing, index) IndexResult::Invalid -> ReadResult::Invalid }
    }
    machine bounded(backing: &[i32], index: u64) -> ReadResult {
        transition index < backing.len {
            true -> read(backing, index)
            false -> ReadResult::Invalid
        }
    }
    machine read(backing: &[i32], index: u64) -> ReadResult requires index < backing.len {
        ReadResult::Ok { value: read_checked(backing, index) }
    }
}

public machine try_write(backing: &mut [i32], layout: &Layout2, row: u64, column: u64, value: i32) -> bool {
    let admitted: bool = valid_mutable(layout, backing.len);
    transition admitted {
        true -> locate(backing, layout, row, column, value)
        false -> false
    }
    machine locate(backing: &mut [i32], layout: &Layout2, row: u64, column: u64, value: i32) -> bool {
        let selected: IndexResult = try_offset(layout, backing.len, row, column);
        transition selected { IndexResult::Ok { index } -> bounded(backing, index, value) IndexResult::Invalid -> false }
    }
    machine bounded(backing: &mut [i32], index: u64, value: i32) -> bool {
        transition index < backing.len { true -> store(backing, index, value) false -> false }
    }
    machine store(backing: &mut [i32], index: u64, value: i32) -> bool requires index < backing.len {
        backing[index] = value;
        true
    }
}
