// NF02 scalar accuracy policy. Existing Float providers own IEEE arithmetic
// and conversions; this module owns caller-visible validation and error policy.
// compare_symmetric_any means absolute OR relative using max-magnitude scaling.
// compare_reference_additive separately implements the wave acceptance formula.
// It admits finite operands only and halves an overflowed subtraction before
// comparing, so infinity <= infinity cannot stand in for an error budget.
// Scaled relative comparison avoids overflowing a-b or tolerance*scale.
// It is a rounded format computation, not a proof of exact real error.
module numeric::numeric_accuracy_policy;

use omega::language::core::float_operations;
use omega::language::core::float_order;

public data NumericClass [copy] {
    case Finite;
    case PositiveZero;
    case NegativeZero;
    case PositiveInfinity;
    case NegativeInfinity;
    case NaN;
}
public data AccuracyComparison [copy] {
    case Close;
    case Different;
    case InvalidTolerance;
}
public data SymmetricAnyTolerance32 [copy] { absolute: f32; relative: f32; }
public data SymmetricAnyTolerance64 [copy] { absolute: f64; relative: f64; }
public data ReferenceAdditiveTolerance32 [copy] { atol: f32; rtol: f32; }
public data ReferenceAdditiveTolerance64 [copy] { atol: f64; rtol: f64; }

public machine widen_f32_to_f64(value: f32) -> f64 { F64::from_f32(value) }
public machine round_f64_to_f32(value: f64) -> f32 { F32::from_f64(value) }
public machine round_i32_to_f32(value: i32) -> f32 { F32::from_i32(value) }
public machine round_i32_to_f64(value: i32) -> f64 { F64::from_i32(value) }

public machine classify_f32(value: f32) -> NumericClass {
    transition {
        F32::is_nan(value) -> (NumericClass::NaN)
        F32::is_infinite(value) -> infinity(value)
        value == 0.0f32 -> zero(value)
        _ -> (NumericClass::Finite)
    }
    machine infinity(value: f32) -> NumericClass {
        transition value < 0.0f32 {
            true -> (NumericClass::NegativeInfinity)
            _ -> (NumericClass::PositiveInfinity)
        }
    }
    machine zero(value: f32) -> NumericClass {
        transition F32::TotalOrder(value, 0.0f32) {
            true -> (NumericClass::NegativeZero)
            _ -> (NumericClass::PositiveZero)
        }
    }
}

machine magnitude_f32(value: f32) -> f32 {
    transition value < 0.0f32 {
        true -> (F32::negate(value))
        _ -> (value)
    }
}

public machine compare_symmetric_any_f32(left: f32, right: f32, tolerance: SymmetricAnyTolerance32) -> AccuracyComparison {
    // Validate first: even equal values must not hide a malformed policy.
    transition {
        !F32::is_finite(tolerance.absolute) || !F32::is_finite(tolerance.relative)
            || tolerance.absolute < 0.0f32 || tolerance.relative < 0.0f32
            -> (AccuracyComparison::InvalidTolerance)
        F32::is_nan(left) || F32::is_nan(right) -> (AccuracyComparison::Different)
        left == right -> (AccuracyComparison::Close)
        !F32::is_finite(left) || !F32::is_finite(right) -> (AccuracyComparison::Different)
        _ -> finite(left, right, tolerance)
    }
    machine finite(left: f32, right: f32, tolerance: SymmetricAnyTolerance32) -> AccuracyComparison {
        let difference: f32 = magnitude_f32(left - right);
        transition F32::is_finite(difference) && difference <= tolerance.absolute {
            true -> (AccuracyComparison::Close)
            _ -> relative(left, right, tolerance)
        }
    }
    machine relative(left: f32, right: f32, tolerance: SymmetricAnyTolerance32) -> AccuracyComparison {
        let scale: f32 = F32::maximum(magnitude_f32(left), magnitude_f32(right));
        // Equal zeros have already returned. The remaining finite pair has a
        // positive scale, and each quotient has magnitude at most one.
        let normalized_difference: f32 = magnitude_f32(left / scale - right / scale);
        transition normalized_difference <= tolerance.relative {
            true -> (AccuracyComparison::Close)
            _ -> (AccuracyComparison::Different)
        }
    }
}

public machine classify_f64(value: f64) -> NumericClass {
    transition {
        F64::is_nan(value) -> (NumericClass::NaN)
        F64::is_infinite(value) -> infinity(value)
        value == 0.0f64 -> zero(value)
        _ -> (NumericClass::Finite)
    }
    machine infinity(value: f64) -> NumericClass {
        transition value < 0.0f64 {
            true -> (NumericClass::NegativeInfinity)
            _ -> (NumericClass::PositiveInfinity)
        }
    }
    machine zero(value: f64) -> NumericClass {
        transition F64::TotalOrder(value, 0.0f64) {
            true -> (NumericClass::NegativeZero)
            _ -> (NumericClass::PositiveZero)
        }
    }
}

machine magnitude_f64(value: f64) -> f64 {
    transition value < 0.0f64 {
        true -> (F64::negate(value))
        _ -> (value)
    }
}

public machine compare_symmetric_any_f64(left: f64, right: f64, tolerance: SymmetricAnyTolerance64) -> AccuracyComparison {
    // Validate first: even equal values must not hide a malformed policy.
    transition {
        !F64::is_finite(tolerance.absolute) || !F64::is_finite(tolerance.relative)
            || tolerance.absolute < 0.0f64 || tolerance.relative < 0.0f64
            -> (AccuracyComparison::InvalidTolerance)
        F64::is_nan(left) || F64::is_nan(right) -> (AccuracyComparison::Different)
        left == right -> (AccuracyComparison::Close)
        !F64::is_finite(left) || !F64::is_finite(right) -> (AccuracyComparison::Different)
        _ -> finite(left, right, tolerance)
    }
    machine finite(left: f64, right: f64, tolerance: SymmetricAnyTolerance64) -> AccuracyComparison {
        let difference: f64 = magnitude_f64(left - right);
        transition F64::is_finite(difference) && difference <= tolerance.absolute {
            true -> (AccuracyComparison::Close)
            _ -> relative(left, right, tolerance)
        }
    }
    machine relative(left: f64, right: f64, tolerance: SymmetricAnyTolerance64) -> AccuracyComparison {
        let scale: f64 = F64::maximum(magnitude_f64(left), magnitude_f64(right));
        // Equal zeros have already returned. The remaining finite pair has a
        // positive scale, and each quotient has magnitude at most one.
        let normalized_difference: f64 = magnitude_f64(left / scale - right / scale);
        transition normalized_difference <= tolerance.relative {
            true -> (AccuracyComparison::Close)
            _ -> (AccuracyComparison::Different)
        }
    }
}

// Reference-oriented additive accuracy. Ordinary finite differences use the
// authored formula, with one format rounding per arithmetic operation. When
// actual-reference overflows, halve before subtracting and building the bound.
// The halved difference is always finite; a positive infinite bound then really
// exceeds it. This is a rounded error policy, not exact-real certification.
public machine compare_reference_additive_f32(
    actual: f32,
    reference: f32,
    tolerance: ReferenceAdditiveTolerance32
) -> AccuracyComparison {
    transition {
        !F32::is_finite(tolerance.atol) || !F32::is_finite(tolerance.rtol)
            || tolerance.atol < 0.0f32 || tolerance.rtol < 0.0f32
            -> (AccuracyComparison::InvalidTolerance)
        !F32::is_finite(actual) || !F32::is_finite(reference)
            -> (AccuracyComparison::Different)
        _ -> finite(actual, reference, tolerance)
    }
    machine finite(actual: f32, reference: f32, tolerance: ReferenceAdditiveTolerance32) -> AccuracyComparison {
        let difference: f32 = magnitude_f32(actual - reference);
        transition F32::is_finite(difference) {
            true -> direct(difference, reference, tolerance)
            _ -> halved(actual, reference, tolerance)
        }
    }
    machine direct(difference: f32, reference: f32, tolerance: ReferenceAdditiveTolerance32) -> AccuracyComparison {
        let relative_budget: f32 = tolerance.rtol * magnitude_f32(reference);
        let bound: f32 = tolerance.atol + relative_budget;
        transition difference <= bound {
            true -> (AccuracyComparison::Close)
            _ -> (AccuracyComparison::Different)
        }
    }
    machine halved(actual: f32, reference: f32, tolerance: ReferenceAdditiveTolerance32) -> AccuracyComparison {
        let half_actual: f32 = actual * 0.5f32;
        let half_reference: f32 = reference * 0.5f32;
        let difference: f32 = magnitude_f32(half_actual - half_reference);
        let half_absolute_budget: f32 = tolerance.atol * 0.5f32;
        let half_relative_budget: f32 = tolerance.rtol * magnitude_f32(half_reference);
        let bound: f32 = half_absolute_budget + half_relative_budget;
        transition difference <= bound {
            true -> (AccuracyComparison::Close)
            _ -> (AccuracyComparison::Different)
        }
    }
}

// Reference-oriented additive accuracy. Ordinary finite differences use the
// authored formula, with one format rounding per arithmetic operation. When
// actual-reference overflows, halve before subtracting and building the bound.
// The halved difference is always finite; a positive infinite bound then really
// exceeds it. This is a rounded error policy, not exact-real certification.
public machine compare_reference_additive_f64(
    actual: f64,
    reference: f64,
    tolerance: ReferenceAdditiveTolerance64
) -> AccuracyComparison {
    transition {
        !F64::is_finite(tolerance.atol) || !F64::is_finite(tolerance.rtol)
            || tolerance.atol < 0.0f64 || tolerance.rtol < 0.0f64
            -> (AccuracyComparison::InvalidTolerance)
        !F64::is_finite(actual) || !F64::is_finite(reference)
            -> (AccuracyComparison::Different)
        _ -> finite(actual, reference, tolerance)
    }
    machine finite(actual: f64, reference: f64, tolerance: ReferenceAdditiveTolerance64) -> AccuracyComparison {
        let difference: f64 = magnitude_f64(actual - reference);
        transition F64::is_finite(difference) {
            true -> direct(difference, reference, tolerance)
            _ -> halved(actual, reference, tolerance)
        }
    }
    machine direct(difference: f64, reference: f64, tolerance: ReferenceAdditiveTolerance64) -> AccuracyComparison {
        let relative_budget: f64 = tolerance.rtol * magnitude_f64(reference);
        let bound: f64 = tolerance.atol + relative_budget;
        transition difference <= bound {
            true -> (AccuracyComparison::Close)
            _ -> (AccuracyComparison::Different)
        }
    }
    machine halved(actual: f64, reference: f64, tolerance: ReferenceAdditiveTolerance64) -> AccuracyComparison {
        let half_actual: f64 = actual * 0.5f64;
        let half_reference: f64 = reference * 0.5f64;
        let difference: f64 = magnitude_f64(half_actual - half_reference);
        let half_absolute_budget: f64 = tolerance.atol * 0.5f64;
        let half_relative_budget: f64 = tolerance.rtol * magnitude_f64(half_reference);
        let bound: f64 = half_absolute_budget + half_relative_budget;
        transition difference <= bound {
            true -> (AccuracyComparison::Close)
            _ -> (AccuracyComparison::Different)
        }
    }
}
