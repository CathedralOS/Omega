use main.omg as backing;
use {omega}/language/core/extent.omg as range;
use {omega}/language/core/access/access.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/reflect/reflect.omg as reflection;

// Runtime-sized u32 vector over caller-supplied, qualified backing.
// The owner supplies storage; growth returns the old extent for release by
// that same allocator. No capacity ladder, ambient allocator or hidden free.
//
// These copy scalars have no resident cleanup debt: the buffer remains Vacant
// and a checked stable-RAM access view reads/writes each four-byte cell. This
// does not represent arbitrary T custody; non-copy elements must retain their
// initialized values and discharge their cleanup before returning vacant bytes.
//
// Role selects the already-admitted backing profile, never creates authority.
// All access operations retain the original extent loan and checked geometry.

public data VecCell { value: u32; }
// The cell's representation remains four bytes at alignment four. Access
// requests keep that independent selection rather than embedding it in a policy.
public data VecCellStorage = |layout|::LayoutStorage<VecCell, VecCellLayout>;
public domain VecCellStorage::Controlled
    access VecCellPolicy;
public VecCellLayout satisfies |layout|::FixedLayout<VecCell> {
    public machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan reaches none crashes none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
        |layout|::LayoutPlan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 }
    }
}

public VecCellPolicy satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflection|::TypeSchema) -> |layout|::AccessPlan reaches none crashes none terminates {
        let mutable plan: |layout|::AccessPlan = |access|::new_plan(@schema, |layout|::Issuance::Unrestricted);
        |access|::observe(@mutable plan, |reflection|::field(VecCell::value),
            |layout|::FieldAccess::Stable { read: true, take: false, write: true, swap: false, exposure: |layout|::Exposure::Exported });
        plan
    }
}

data Observed { storage: |backing|::VacantStorage; value: u32; }

machine store_cell<Role>(storage: @mutable |backing|::VacantStorage, value: u32)
crashes Trap
{
    transition |access|::view_extent_mut::<VecCellStorage in VecCellStorage::Controlled, Role>(storage as @mutable |range|::Extent in |range|::Extent::Granted) {
        |layout|::AccessOutcome::Ready { view } -> change(view, value),
        |layout|::AccessOutcome::Rejected { returned, reason } -> bad()
    }
    machine change(view: @mutable VecCellStorage in VecCellStorage::Controlled, value: u32) {
        |layout|::write(@mutable view.value, value);
    }
    machine bad() { crash Trap; }
}

machine store<Role>(storage: |backing|::VacantStorage, offset: u64, value: u32) -> |backing|::VacantStorage
requires storage.length >= 4, offset <= storage.length - 4
ensures result.base == storage.base, result.length == storage.length
crashes Trap
{
    let prefix: |range|::VacantExtentParts = |range|::split_vacant_extent(storage, offset);
    let element: |range|::VacantExtentParts = |range|::split_vacant_extent(prefix.rest, 4);
    let mutable cell: |backing|::VacantStorage = element.taken;
    store_cell::<Role>(@mutable cell, value);
    let suffix: |backing|::VacantStorage = |range|::merge_vacant_extents(cell, element.rest);
    let whole: |backing|::VacantStorage = |range|::merge_vacant_extents(prefix.taken, suffix);
    whole
}


public data Vec
requires self.length <= self.capacity, self.capacity <= 4611686018427387903,
    self.storage.length == self.capacity * 4
{
    storage: |backing|::VacantStorage;
    length: u64;
    capacity: u64;
}

public machine open(storage: |backing|::VacantStorage, capacity: u64) -> Vec
requires capacity <= 4611686018427387903, storage.length == capacity * 4
ensures result.length == 0, result.capacity == capacity,
    result.storage.base == storage.base, result.storage.length == storage.length
{ Vec { storage: storage, length: 0, capacity: capacity } }

public machine push<Role>(vec: Vec, value: u32) -> Vec
requires vec.length < vec.capacity
ensures result.length == vec.length + 1, result.capacity == vec.capacity,
    result.storage.base == vec.storage.base, result.storage.length == vec.storage.length
crashes Trap
{
    let length: u64 = vec.length;
    let capacity: u64 = vec.capacity;
    let storage: |backing|::VacantStorage = vec.storage;
    let changed: |backing|::VacantStorage = store::<Role>(storage, length * 4, value);
    Vec { storage: changed, length: length + 1, capacity: capacity }
}

machine inspect_cell<Role>(storage: @|backing|::VacantStorage) -> u32 crashes Trap {
    transition |access|::view_extent::<VecCellStorage in VecCellStorage::Controlled, Role>(storage as @|range|::Extent in |range|::Extent::Granted) {
        |layout|::AccessOutcome::Ready { view } -> |layout|::read(@view.value),
        |layout|::AccessOutcome::Rejected { returned, reason } -> bad()
    }
    machine bad() -> u32 { crash Trap; }
}

machine inspect<Role>(storage: |backing|::VacantStorage, offset: u64) -> Observed
requires storage.length >= 4, offset <= storage.length - 4
ensures result.storage.base == storage.base, result.storage.length == storage.length
crashes Trap
{
    let prefix: |range|::VacantExtentParts = |range|::split_vacant_extent(storage, offset);
    let element: |range|::VacantExtentParts = |range|::split_vacant_extent(prefix.rest, 4);
    let cell: |backing|::VacantStorage = element.taken;
    let value: u32 = inspect_cell::<Role>(@cell);
    let suffix: |backing|::VacantStorage = |range|::merge_vacant_extents(cell, element.rest);
    let whole: |backing|::VacantStorage = |range|::merge_vacant_extents(prefix.taken, suffix);
    Observed { storage: whole, value: value }
}

public data Read { vec: Vec; value: u32; }
public machine get<Role>(vec: Vec, index: u64) -> Read
requires index < vec.length
ensures result.vec.length == vec.length, result.vec.capacity == vec.capacity,
    result.vec.storage.base == vec.storage.base, result.vec.storage.length == vec.storage.length
crashes Trap
{
    let length: u64 = vec.length;
    let capacity: u64 = vec.capacity;
    let storage: |backing|::VacantStorage = vec.storage;
    let observed: Observed = inspect::<Role>(storage, index * 4);
    Read { vec: Vec { storage: observed.storage, length: length, capacity: capacity }, value: observed.value }
}

data Copied {
    original: |backing|::VacantStorage;
    replacement: |backing|::VacantStorage;
}

machine copy_prefix<Role>(original: |backing|::VacantStorage, replacement: |backing|::VacantStorage,
    count: u64, remaining: u64) -> Copied
requires count <= 4611686018427387903, remaining <= count,
    original.length >= count * 4, replacement.length >= count * 4
ensures result.original.base == original.base, result.original.length == original.length,
    result.replacement.base == replacement.base, result.replacement.length == replacement.length
terminates by remaining
crashes Trap
{
    transition remaining > 0 {
        true -> step::<Role>(original, replacement, count, remaining),
        false -> Copied { original: original, replacement: replacement }
    }
    machine step<Role>(original: |backing|::VacantStorage, replacement: |backing|::VacantStorage,
        count: u64, remaining: u64) -> Copied
    requires remaining > 0, count <= 4611686018427387903, remaining <= count,
        original.length >= count * 4, replacement.length >= count * 4
    ensures result.original.base == original.base, result.original.length == original.length,
        result.replacement.base == replacement.base, result.replacement.length == replacement.length
    {
        let offset: u64 = (count - remaining) * 4;
        let observed: Observed = inspect::<Role>(original, offset);
        let changed: |backing|::VacantStorage = store::<Role>(replacement, offset, observed.value);
        transition { _ -> copy_prefix::<Role>(observed.storage, changed, count, remaining - 1) }
    }
}

public data Growth { vec: Vec; retired_storage: |backing|::VacantStorage; }
machine verify_vector(storage: @|backing|::VacantStorage, length: u64, capacity: u64)
requires length <= capacity, capacity <= 4611686018427387903, storage.length == capacity * 4 {}
public machine grow<Role>(vec: Vec, replacement: |backing|::VacantStorage, capacity: u64)
    -> Growth
requires capacity <= 4611686018427387903, capacity >= vec.length,
    replacement.length == capacity * 4
ensures result.vec.length == vec.length, result.vec.capacity == capacity,
    result.vec.storage.base == replacement.base, result.vec.storage.length == replacement.length,
    result.retired_storage.base == vec.storage.base, result.retired_storage.length == vec.storage.length
crashes Trap
{
    let length: u64 = vec.length;
    let original: |backing|::VacantStorage = vec.storage;
    let copied: Copied = copy_prefix::<Role>(original, replacement, length, length);
    verify_vector(@copied.replacement, length, capacity);
    let grown: Vec = Vec { storage: copied.replacement, length: length, capacity: capacity };
    Growth { vec: grown, retired_storage: copied.original }
}

public machine close(vec: Vec) -> |backing|::VacantStorage
ensures result.base == vec.storage.base, result.length == vec.storage.length
{ vec.storage }
