public machine from_source<'storage>(source: Source<'storage>) -> DependencyDescription<'storage> {
    DependencyDescription { source: source, explicit_alias: false, alias: "" }
}

public machine with_alias<'storage>(description: @mutable DependencyDescription<'storage>, alias: @'storage [u8]) {
    description.explicit_alias = true;
    description.alias = alias;
}

public machine input(builder: @BuildPlan, alias: @[u8]) -> PackageBinding reaches BuildRequestOperations {
    BuildRequestOperations::input_binding(builder, alias)
}

public machine add(builder: @mutable BuildPlan, binding: PackageBinding) -> DependencyRegistration reaches BuildRequestOperations {
    BuildRequestOperations::add_binding(builder, binding, PackageReach {})
}

public machine add(builder: @mutable BuildPlan, binding: PackageBinding, max_reach: @[BoundaryServiceRef]) -> DependencyRegistration reaches BuildRequestOperations {
    BuildRequestOperations::add_binding(builder, binding, ceiling(builder, max_reach))
}

public machine add(builder: @mutable BuildPlan, description: DependencyDescription) -> DependencyRegistration reaches BuildRequestOperations {
    Build::dependency(builder, description)
}

public machine add(builder: @mutable BuildPlan, description: DependencyDescription, max_reach: @[BoundaryServiceRef]) -> DependencyRegistration reaches BuildRequestOperations {
    Build::request_dependency(builder, false, description.explicit_alias, description.alias, description.source, ceiling(builder, max_reach))
}

machine ceiling(builder: @BuildPlan, services: @[BoundaryServiceRef]) -> PackageReach reaches BuildRequestOperations {
    collect(builder, services, 0u64, PackageReach {})

    machine collect(builder: @BuildPlan, services: @[BoundaryServiceRef], index: u64, so_far: PackageReach) -> PackageReach
    reaches BuildRequestOperations
    {
        transition index < services.length {
            false -> so_far,
            true -> add_one(builder, services, index, so_far)
        }
    }

    machine add_one(builder: @BuildPlan, services: @[BoundaryServiceRef], index: u64, so_far: PackageReach) -> PackageReach
    reaches BuildRequestOperations
    requires index < services.length
    {
        collect(builder, services, index +% 1u64, BuildRequestOperations::extend_reach(builder, so_far, services[index]))
    }
}
