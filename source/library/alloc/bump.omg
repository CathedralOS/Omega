use omega::language::core::extent;
use omega::language::core::content;

// Exact partition of one qualified vacant range into two adjacent qualified
// vacant ranges.
public data Split {
    taken: Extent in Granted & Vacant;
    rest: Extent in Granted & Vacant;
}

public boundary trait ExtentPartition {
    machine merge(parts: Split) -> Extent
    reaches
    ensures
        embed(result.length) == embed(parts.taken.length) + embed(parts.rest.length),
        result in Granted & Vacant,
        separate(
            Granted::content(old(&parts.taken)),
            Granted::content(old(&parts.rest)),
        )
        == Granted::content(&result),
        separate(
            Vacant::content(old(&parts.taken)),
            Vacant::content(old(&parts.rest)),
        )
        == Vacant::content(&result);
}

// Bump policy: the allocation is the low end of the tail; the rest is the new
// tail. Nothing about the allocation's later cleanup moves the tail.
// `remaining` is the counted byte residual summarizing the tail's capacity;
// it is a separate premise from the tail's placement authority. Retain their
// exact relationship in the strategy itself: a caller-supplied counter must
// never authorize a request larger than the concrete allocatable tail.
public data Bump where remaining == tail.length {
    tail: Extent in Granted & Vacant;
    remaining: u64;
}

public data Attempt {
    case Allocated(allocation: Extent in Granted & Vacant);
    case Exhausted;
}

// The strategy stays at its caller-owned place. Exhaustion changes nothing;
// success transfers only the issued child, ending the strategy loan on return.
public machine try_allocate(strategy: &mut Bump, length: u64) -> Attempt
{
    let available: u64 = strategy.remaining;
    transition length <= available {
        true -> Attempt::Allocated { allocation: allocate(strategy, length, available) }
        _ -> Attempt::Exhausted
    }
}

// Infallible request: the caller proves the exact capacity requirement.
// `available` captures the entry count explicitly so the caller can consume
// the exact decrement after mutation. It must equal the concrete strategy's
// residual; it cannot enlarge the backing or supply a content claim.
// Publish the concrete tail decrement as well as the counter decrement so
// subsequent partition/recomposition contracts retain the backing geometry.
public machine allocate(strategy: &mut Bump, length: u64, available: u64) -> Extent in Granted & Vacant
requires
    available == strategy.remaining;
    length <= available
ensures
    strategy.remaining == available - length;
    strategy.tail.length == available - length;
    result.length == length
{
    let tail: Extent in Granted & Vacant = strategy.tail;
    let parts: VacantExtentParts = split_vacant_extent(tail, length);
    check_extent_length(&parts.taken, length);
    strategy.tail = parts.rest;
    strategy.remaining = available - length;
    parts.taken
}

// Exercise the published count at an ordinary caller obligation, independently
// of the extent's custody. This check must use the exact allocation invocation;
// the source constructor or a second allocation cannot stand in for its result.
public machine check_remaining(remaining: u64, previous: u64, length: u64)
requires
    length <= previous;
    remaining == previous - length
{}

// The split's exact returned extent carries the requested length. This scalar
// fact grants no storage authority; the separate content law carries custody.
public machine check_extent_length(extent: &Extent in Granted & Vacant, expected: u64)
requires extent.length == expected
{}

// Reset after full return. `lower` was issued before `upper`, so the original
// range is `lower ++ upper ++ tail`. Both returned regions are consumed, and
// both must still be vacant: a region whose resident has not been retired
// does not type as `Vacant` and cannot reach recomposition.
public machine reset(
    strategy: Bump,
    lower: Extent in Granted & Vacant,
    upper: Extent in Granted & Vacant
) -> Bump
ensures
    embed(result.remaining) == embed(lower.length) + embed(upper.length) + embed(strategy.tail.length)
reaches ExtentPartition
    invokes ExtentPartition;
{
    let tail: Extent in Granted & Vacant = strategy.tail;
    let upper_and_tail: Extent in Granted & Vacant = ExtentPartition::merge(Split {
        taken: upper,
        rest: tail,
    });
    let whole: Extent in Granted & Vacant = ExtentPartition::merge(Split {
        taken: lower,
        rest: upper_and_tail,
    });
    let restored_residual: u64 = whole.length;
    Bump { tail: whole, remaining: restored_residual }
}

// Release performs ordinary value cleanup and transfers the exact extent back
// as retired content. It does not rewind the cursor: the strategy keeps its
// tail and residual, and the retired claim stays unavailable until `reset`
// recomposes it. Merging the claim into the tail here would let a later request
// spend storage the monotonic cursor already issued and would erase the
// distinction between the allocatable tail and retired content
// (wiki/spec/resources/allocation.md#monotonic-allocation-and-return).
// `returned` must still be `Vacant` — a region holding a live resident does not
// satisfy the parameter, so value cleanup precedes the transfer.
public data Released {
    strategy: Bump;
    retired_storage: Extent in Granted & Vacant;
}

public machine release(strategy: Bump, returned: Extent in Granted & Vacant) -> Released
ensures
    result.strategy.tail.length == strategy.tail.length;
    result.strategy.remaining == strategy.remaining;
    result.retired_storage.length == returned.length
{
    Released { strategy: strategy, retired_storage: returned }
}

// The reservation half of a `Vec<T>`-style owner over the bump chain: one live
// buffer, the strategy it was issued from, and two retired carriers — the older
// allocation a growth replaced, below the live buffer, and the suffix a
// truncation freed, above it. `buffer.length` is the capacity measure.
// Elements and general retained storage still need the placed-access route
// described in the header.
public data BumpVec {
    strategy: Bump;
    buffer: Extent in Granted & Vacant;
    retained_buffer: RetiredSlot;
    freed_suffix: RetiredSlot;
}

// Open a reservation of `capacity` bytes. `residual` is the caller's stated
// capacity premise for the backing, tied to its geometry by the second
// requires clause. Later allocations consume `allocate`'s returned residual.
public machine open(whole: Extent in Granted & Vacant, capacity: u64, residual: u64) -> BumpVec
requires
    capacity <= residual;
    residual == whole.length
ensures
    result.buffer.length == capacity
reaches ExtentPartition
    invokes ExtentPartition;
{
    let mut strategy: Bump = Bump { tail: whole, remaining: residual };
    let buffer: Extent in Granted & Vacant = allocate(&mut strategy, capacity, residual);
    BumpVec {
        strategy: strategy,
        buffer: buffer,
        retained_buffer: RetiredSlot::Empty,
        freed_suffix: RetiredSlot::Empty,
    }
}

// The recomposition receipt: one qualified extent standing for the range
// `close` folded back. A record, not a bare extent, because the caller-side
// claim mapping is only published by a construction transfer — a bare
// `whole`/`as` return leaves the caller's bound result without a conserved
// claim mapping (the same reason `reset` returns `Bump`).
public data Recomposed {
    backing: Extent in Granted & Vacant;
}

// Close the container: recompose the live buffer, any truncation suffix, the
// tail, and the retired older buffer in address order. The buffer must still be
// `Vacant` — closing a container whose elements were never retired does not
// type. Both carriers must return the entire held backing; the container is
// finishing, so no live allocation remains in the strategy and recomposition is
// the sanctioned return of the backing, not a cursor rewind.
public machine close(vec: BumpVec) -> Recomposed
reaches ExtentPartition
    invokes ExtentPartition;
{
    let strategy: Bump = vec.strategy;
    let buffer: Extent in Granted & Vacant = vec.buffer;
    let retained: RetiredSlot = vec.retained_buffer;
    transition vec.freed_suffix {
        RetiredSlot::Empty -> direct(strategy, buffer, retained)
        RetiredSlot::Held { storage } -> truncated(strategy, buffer, storage, retained)
    }

    machine direct(strategy: Bump, buffer: Extent in Granted & Vacant, retained: RetiredSlot) -> Recomposed {
        let whole: Extent in Granted & Vacant = ExtentPartition::merge(Split {
            taken: buffer,
            rest: strategy.tail,
        });
        let remaining: u64 = whole.length;
        let restored: Bump = reset_retired(Bump { tail: whole, remaining: remaining }, retained);
        Recomposed { backing: restored.tail }
    }

    // A held suffix sits directly above the live buffer, so it folds first; the
    // retired older allocation sits below the buffer and folds last.
    machine truncated(strategy: Bump, buffer: Extent in Granted & Vacant, freed: Extent in Granted & Vacant, retained: RetiredSlot) -> Recomposed {
        let joined: Bump = reset(strategy, buffer, freed);
        let restored: Bump = reset_retired(joined, retained);
        Recomposed { backing: restored.tail }
    }
}

// Reserve a new buffer from the tail without returning the old buffer to it.
// The finite retained slot makes a second growth reject without losing any
// claim; a truncation suffix still held for the old buffer is coalesced back
// into that buffer before it is retired, so the container keeps at most one
// retired range below the live buffer. Capacity exhaustion likewise preserves
// the existing container.
public data Growth {
    case Grown(vec: BumpVec);
    case Rejected(vec: BumpVec);
}

public machine grow(vec: BumpVec, capacity: u64) -> Growth
reaches ExtentPartition
    invokes ExtentPartition;
{
    let strategy: Bump = vec.strategy;
    let buffer: Extent in Granted & Vacant = vec.buffer;
    let freed: RetiredSlot = vec.freed_suffix;
    transition vec.retained_buffer {
        RetiredSlot::Empty -> reserve(strategy, buffer, capacity, freed)
        RetiredSlot::Held { storage } -> Growth::Rejected {
            vec: BumpVec {
                strategy: strategy,
                buffer: buffer,
                retained_buffer: RetiredSlot::Held { storage: storage },
                freed_suffix: freed,
            },
        }
    }

    machine reserve(strategy: Bump, buffer: Extent in Granted & Vacant, capacity: u64, freed: RetiredSlot) -> Growth {
        let mut active: Bump = strategy;
        let attempt: Attempt = try_allocate(&mut active, capacity);
        transition attempt {
            Attempt::Allocated { allocation } -> retire(active, buffer, allocation, freed)
            Attempt::Exhausted -> Growth::Rejected {
                vec: BumpVec {
                    strategy: active,
                    buffer: buffer,
                    retained_buffer: RetiredSlot::Empty,
                    freed_suffix: freed,
                },
            }
        }
    }

    // The old buffer leaves the container only once its own truncation suffix is
    // folded back into it: buffer ++ freed is the allocation the growth
    // replaces, and that coalesced range stays retired below the new buffer.
    machine retire(active: Bump, buffer: Extent in Granted & Vacant, allocation: Extent in Granted & Vacant, freed: RetiredSlot) -> Growth {
        transition freed {
            RetiredSlot::Empty -> Growth::Grown {
                vec: BumpVec {
                    strategy: active,
                    buffer: allocation,
                    retained_buffer: RetiredSlot::Held { storage: buffer },
                    freed_suffix: RetiredSlot::Empty,
                },
            }
            RetiredSlot::Held { storage } -> coalesce(active, buffer, allocation, storage)
        }
    }

    machine coalesce(active: Bump, buffer: Extent in Granted & Vacant, allocation: Extent in Granted & Vacant, storage: Extent in Granted & Vacant) -> Growth {
        let merged: Extent in Granted & Vacant = ExtentPartition::merge(Split {
            taken: buffer,
            rest: storage,
        });
        Growth::Grown {
            vec: BumpVec {
                strategy: active,
                buffer: allocation,
                retained_buffer: RetiredSlot::Held { storage: merged },
                freed_suffix: RetiredSlot::Empty,
            },
        }
    }
}

// The truncate edge's outcome. The rejected arm returns the container exactly
// as it arrived: one freed carrier holds one contiguous retired range.
public data Truncation {
    case Truncated(vec: BumpVec);
    case Rejected(vec: BumpVec);
}

// In-place truncation of the live buffer — the `Vec<T>` truncate edge. The
// freed suffix was issued by the monotonic cursor, so it becomes retired
// content in the container's freed carrier instead of folding back into the
// allocatable tail: the strategy passes through unchanged, and a suffix already
// held coalesces with the newly freed range. `grow` folds the carrier back into
// the buffer it was cut from, and `close` folds it in address order once the
// container finishes.
public machine shrink(vec: BumpVec, kept: u64) -> Truncation
requires
    kept <= vec.buffer.length
reaches ExtentPartition
    invokes ExtentPartition;
{
    let strategy: Bump = vec.strategy;
    let buffer: Extent in Granted & Vacant = vec.buffer;
    let retained: RetiredSlot = vec.retained_buffer;
    transition vec.freed_suffix {
        RetiredSlot::Empty -> truncate(strategy, buffer, kept, retained)
        RetiredSlot::Held { storage } -> Truncation::Rejected {
            vec: BumpVec {
                strategy: strategy,
                buffer: buffer,
                retained_buffer: retained,
                freed_suffix: RetiredSlot::Held { storage: storage },
            },
        }
    }

    machine truncate(strategy: Bump, buffer: Extent in Granted & Vacant, kept: u64, retained: RetiredSlot) -> Truncation {
        let parts: VacantExtentParts = split_vacant_extent(buffer, kept);
        let shrunk: Extent in Granted & Vacant = parts.taken;
        let freed: Extent in Granted & Vacant = parts.rest;
        Truncation::Truncated {
            vec: BumpVec {
                strategy: strategy,
                buffer: shrunk,
                retained_buffer: retained,
                freed_suffix: RetiredSlot::Held { storage: freed },
            },
        }
    }
}

// Two coexisting allocations, cleanup of each, then reset to the whole range,
// chained through the package machines `allocate` and `reset`. The caller
// proves the exact capacity requirement at the entry — `capacity` covers the
// whole 16 + 32 plan and equals the backing's geometry — then threads the
// actual returned residual into the second request. Reset then proves the
// original capacity available for a third request, without a runtime guard.
// Each returned record's
// qualified fields are restated
// through exactly typed locals in the custody order described in the header.
public data RetiredSlot {
    case Empty;
    case Held(storage: Extent in Granted & Vacant);
}

public machine retain_buffer(storage: Extent in Granted & Vacant) -> RetiredSlot {
    RetiredSlot::Held { storage: storage }
}

public machine reset_retired(strategy: Bump, retired: RetiredSlot) -> Bump
reaches ExtentPartition
    invokes ExtentPartition;
{
    transition retired {
        RetiredSlot::Empty -> strategy
        RetiredSlot::Held { storage } -> restore(strategy, storage)
    }

    machine restore(strategy: Bump, storage: Extent in Granted & Vacant) -> Bump {
        let whole: Extent in Granted & Vacant = ExtentPartition::merge(Split {
            taken: storage,
            rest: strategy.tail,
        });
        let remaining: u64 = whole.length;
        Bump { tail: whole, remaining: remaining }
    }
}
