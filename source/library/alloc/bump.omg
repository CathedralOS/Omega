module bump;

use omega::language::core::Extent;
use omega::language::core::Extent::Granted;
use omega::language::core::Extent::Vacant;
use omega::language::core::VacantExtentParts;
use omega::language::core::split_vacant_extent;
use omega::language::core::merge_vacant_extents;
use omega::language::core::no_wrap;

// Only the tail is allocatable. Original geometry is a reset obligation,
// not authority: every byte belongs to the tail or an issued linear extent.
// Empty tails retain a representable base rather than a one-past address.
public data Bump
requires
    self.remaining == self.tail.length,
    self.remaining <= self.capacity,
    no_wrap(self.base, self.capacity),
    self.tail.length == 0 || embed(self.tail.base) + embed(self.tail.length) == embed(self.base) + embed(self.capacity)
{
    tail: Extent in Granted & Vacant;
    remaining: u64;
    base: addr;
    capacity: u64;
}

public machine Bump::open(whole: Extent in Granted & Vacant) -> Bump
ensures
    result.base == whole.base,
    result.capacity == whole.length,
    result.remaining == whole.length
{
    let base: addr = whole.base;
    let capacity: u64 = whole.length;
    Bump { tail: whole, remaining: capacity, base: base, capacity: capacity }
}
public data Attempt {
    case Allocated(allocation: Extent in Granted & Vacant);
    case Exhausted;
}

// The exclusive strategy loan ends on return, so issued allocations coexist.
// Exhaustion leaves both the tail and the original reset obligation unchanged.
public machine try_allocate(strategy: &mut Bump, length: u64) -> Attempt {
    let available: u64 = strategy.remaining;
    transition length <= available {
        true -> Attempt::Allocated { allocation: allocate(strategy, length, available) }
        _ -> Attempt::Exhausted
    }
}

// Publish the position needed to rejoin issued neighbors at release. An empty
// tail has no one-past address obligation, so its base supplies no such equation.
public machine allocate(strategy: &mut Bump, length: u64, available: u64) -> Extent in Granted & Vacant
requires
    available == strategy.remaining,
    length <= available
ensures
    strategy.remaining == available - length,
    strategy.tail.length == available - length,
    result.length == length,
    available == 0 || embed(result.base) + embed(available) == embed(strategy.base) + embed(strategy.capacity)
{
    let tail: Extent in Granted & Vacant = strategy.tail;
    let parts: VacantExtentParts = split_vacant_extent(tail, length);
    strategy.tail = parts.rest;
    strategy.remaining = available - length;
    parts.taken
}

public machine check_remaining(remaining: u64, previous: u64, length: u64)
requires length <= previous, remaining == previous - length
{}

public machine check_extent_length(extent: &Extent in Granted & Vacant, expected: u64)
requires extent.length == expected
{}

// Release never rewinds the cursor. The caller retains the cleaned extent
// and combines returned neighbors using merge_vacant_extents. Neither a
// scalar count nor release can replace an outstanding resident.
public data Released {
    strategy: Bump;
    retired_storage: Extent in Granted & Vacant;
}

public machine release(strategy: Bump, returned: Extent in Granted & Vacant) -> Released
ensures
    result.strategy.tail.length == strategy.tail.length,
    result.strategy.remaining == strategy.remaining,
    result.strategy.base == strategy.base,
    result.strategy.capacity == strategy.capacity,
    result.retired_storage.base == returned.base,
    result.retired_storage.length == returned.length
{
    Released { strategy: strategy, retired_storage: returned }
}

// The returned prefix represents every issued extent, regardless of count.
// Checked content conservation forbids holes, overlap, lost claims and live
// residents. Original geometry prevents treating a returned suffix as a full
// reset. No boundary, allocation, or new grant occurs here.
public machine reset(strategy: Bump, retired: Extent in Granted & Vacant) -> Bump
requires
    retired.base == strategy.base,
    embed(retired.length) + embed(strategy.remaining) == embed(strategy.capacity)
ensures
    result.remaining == strategy.capacity,
    result.capacity == strategy.capacity,
    result.base == strategy.base
{
    let base: addr = strategy.base;
    let capacity: u64 = strategy.capacity;
    let whole: Extent in Granted & Vacant = merge_vacant_extents(retired, strategy.tail);
    Bump { tail: whole, remaining: capacity, base: base, capacity: capacity }
}
