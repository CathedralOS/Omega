// Ordinary `Vec<T>` — the growable vector for Squalr's scan results,
// allocator-backed under the allocation contract (wiki/spec/resources/
// allocation.md).
//
// `Vec` is a handle record: it names live storage it does not contain.
// Storage lives in caller-minted `Backing*` records — explicit
// caller-supplied backing under the contract. The handle's `rung` field
// records which backing class the live elements occupy (4, 8, or 16),
// `len` counts live elements, and `live` marks whether the handle names
// storage at all. The handle is `linear`: `close` consumes it, so a
// duplicate cleanup is a transfer-twice rejection at check time, not a
// silent re-drop.
//
// Allocation is a real request/grant protocol against `Pool`, the
// caller-supplied strategy ledger. `requestN` is fallible: an exhausted
// rung answers `Denied` and leaves every counter untouched, so the
// caller's fresh backing stays unheld and the vector's contents and
// custody are preserved. A granted request mints `Request::Granted`
// carrying the issued rung — the only way to reach the adopt arm of
// `open4`/`grow*`, which consume the request by matching it. There is
// no spelling of growth that bypasses the request: the caller has to
// hand the pool's own answer to the vector's growth machine.
//
// Custody crosses by the `held` flag on each backing record: `open4`
// marks the first store held, `grow` clears it on the retired store and
// sets it on the adopted one after copying the live prefix exactly once,
// and `drain` clears it when the caller reads the elements back out.
// Each adopt edge verifies the granted rung names that edge — a grant
// for the wrong rung behaves as a denial and moves nothing.
// `releaseN` returns the rung's slot to the strategy so the free count
// reconciles; a release beyond the declared supply sets `overN`, the
// conservation violation the contract forbids.
//
// The rung chain is a finite instantiation, not a special case: generic
// machine instantiation is not wired yet (a machine attached to generic
// data fails layout on `[T; N]`), so `Backing4`, `Backing8`, and
// `Backing16` are spelled concretely and each growth edge is its own
// ordinary machine.
pub data Vec [linear] {
    live: u64;
    rung: u64;
    len: u64;
}

// Caller-owned backing stores, one per rung. `held` is the custody flag:
// 0 while the caller owns the store outright, 1 while the vector names it.
pub data Backing4 {
    e: [u32; 4];
    held: u64;
}

pub data Backing8 {
    e: [u32; 8];
    held: u64;
}

pub data Backing16 {
    e: [u32; 16];
    held: u64;
}

// The allocation strategy's ledger over caller-supplied stores: `freeN`
// counts unissued slots of rung N and `overN` records a release that
// would exceed the caller's declared supply.
pub data Pool {
    free4: u64;
    free8: u64;
    free16: u64;
    supply4: u64;
    supply8: u64;
    supply16: u64;
    over4: u64;
    over8: u64;
    over16: u64;
}

// Declare the supply the caller minted: how many stores of each rung
// exist for the strategy to issue grants against.
pub machine Pool::open(&mut self, supply4: u64, supply8: u64, supply16: u64) {
    self.free4 = supply4;
    self.free8 = supply8;
    self.free16 = supply16;
    self.supply4 = supply4;
    self.supply8 = supply8;
    self.supply16 = supply16;
    self.over4 = 0;
    self.over8 = 0;
    self.over16 = 0;
}

// The fallible request's outcome: `rung` on a grant is the backing class
// the pool issued — the vector adopts it as its new rung, so the granted
// value literally becomes the vector's storage size.
pub data Request {
    case Granted(rung: u64);
    case Denied;
}

// Seed a fresh backing with zero elements — the caller's minting step:
// the store starts unheld and empty.
pub machine Backing4::seed(&mut self) {
    self.e[0] = 0;
    self.e[1] = 0;
    self.e[2] = 0;
    self.e[3] = 0;
    self.held = 0;
}

pub machine Backing8::seed(&mut self) {
    self.e[0] = 0;
    self.e[1] = 0;
    self.e[2] = 0;
    self.e[3] = 0;
    self.e[4] = 0;
    self.e[5] = 0;
    self.e[6] = 0;
    self.e[7] = 0;
    self.held = 0;
}

pub machine Backing16::seed(&mut self) {
    self.e[0] = 0;
    self.e[1] = 0;
    self.e[2] = 0;
    self.e[3] = 0;
    self.e[4] = 0;
    self.e[5] = 0;
    self.e[6] = 0;
    self.e[7] = 0;
    self.e[8] = 0;
    self.e[9] = 0;
    self.e[10] = 0;
    self.e[11] = 0;
    self.e[12] = 0;
    self.e[13] = 0;
    self.e[14] = 0;
    self.e[15] = 0;
    self.held = 0;
}

// Fallible requests: a free slot decrements the ledger and mints the
// rung's grant; an exhausted rung answers Denied and leaves every
// counter untouched.
pub machine Pool::request4(pool: &mut Pool) -> Request {
    transition pool.free4 > 0 {
        true -> minted(pool)
        _ -> denied(pool)
    }

    state minted(pool: &mut Pool) -> Request {
        pool.free4 = pool.free4 - 1;
        Request::Granted { rung: 4 }
    }

    state denied(pool: &mut Pool) -> Request {
        Request::Denied
    }
}

pub machine Pool::request8(pool: &mut Pool) -> Request {
    transition pool.free8 > 0 {
        true -> minted(pool)
        _ -> denied(pool)
    }

    state minted(pool: &mut Pool) -> Request {
        pool.free8 = pool.free8 - 1;
        Request::Granted { rung: 8 }
    }

    state denied(pool: &mut Pool) -> Request {
        Request::Denied
    }
}

pub machine Pool::request16(pool: &mut Pool) -> Request {
    transition pool.free16 > 0 {
        true -> minted(pool)
        _ -> denied(pool)
    }

    state minted(pool: &mut Pool) -> Request {
        pool.free16 = pool.free16 - 1;
        Request::Granted { rung: 16 }
    }

    state denied(pool: &mut Pool) -> Request {
        Request::Denied
    }
}

// Return the slot for the rung the vector vacated — retired content
// under the contract. A release beyond the caller's declared supply
// records the conservation violation instead of silently wrapping.
pub machine Pool::release4(pool: &mut Pool) {
    transition pool.free4 < pool.supply4 {
        true -> freed(pool)
        _ -> over(pool)
    }

    state freed(pool: &mut Pool) {
        pool.free4 = pool.free4 + 1;
    }

    state over(pool: &mut Pool) {
        pool.over4 = 1;
    }
}

pub machine Pool::release8(pool: &mut Pool) {
    transition pool.free8 < pool.supply8 {
        true -> freed(pool)
        _ -> over(pool)
    }

    state freed(pool: &mut Pool) {
        pool.free8 = pool.free8 + 1;
    }

    state over(pool: &mut Pool) {
        pool.over8 = 1;
    }
}

pub machine Pool::release16(pool: &mut Pool) {
    transition pool.free16 < pool.supply16 {
        true -> freed(pool)
        _ -> over(pool)
    }

    state freed(pool: &mut Pool) {
        pool.free16 = pool.free16 + 1;
    }

    state over(pool: &mut Pool) {
        pool.over16 = 1;
    }
}

// Open a vector over the caller's first-rung store: the request supplies
// the allocation — `Granted` binds the store (held) and establishes the
// ledger at the granted rung, `Denied` leaves the vector closed and the
// store untouched.
pub machine Vec::open4(vec: &mut Vec, request: Request, store: &mut Backing4) -> u64
{
    transition request {
        Request::Granted { rung } -> verify(vec, store, rung)
        Request::Denied -> closed(vec)
    }

    // A grant for a different rung cannot open this edge: the pool's
    // answer must name rung 4, or the handle stays closed.
    state verify(vec: &mut Vec, store: &mut Backing4, rung: u64) -> u64 {
        transition rung == 4 {
            true -> opened(vec, store)
            _ -> closed(vec)
        }
    }

    state opened(vec: &mut Vec, store: &mut Backing4) -> u64 {
        store.held = 1;
        vec.live = 1;
        vec.rung = 4;
        vec.len = 0;
        1
    }

    state closed(vec: &mut Vec) -> u64 {
        0
    }
}

// Append within the resident rung: the caller's in-range index is the
// bounds proof, so `len` follows it exactly.
pub machine Vec::push4(vec: &mut Vec, store: &mut Backing4, index: u64, value: u32)
requires index <= 3
{
    store.e[index] = value;
    vec.len = index + 1;
}

pub machine Vec::push8(vec: &mut Vec, store: &mut Backing8, index: u64, value: u32)
requires index <= 7
{
    store.e[index] = value;
    vec.len = index + 1;
}

pub machine Vec::push16(vec: &mut Vec, store: &mut Backing16, index: u64, value: u32)
requires index <= 15
{
    store.e[index] = value;
    vec.len = index + 1;
}

// Growth: the caller hands the pool's answer to `request8`/`request16`
// along with the fresh store it minted. Granted, the live prefix copies
// exactly once into the fresh store, element custody crosses by value
// (the retired store is zeroed and unheld), the adopted store is held,
// and `rung` adopts the granted value. Denied, nothing moves — the
// vector keeps contents and custody and the caller's supply stays
// unheld. The returned count is the live elements that crossed.
pub machine Vec::grow4to8(vec: &mut Vec, old: &mut Backing4, fresh: &mut Backing8, request: Request) -> u64 {
    transition request {
        Request::Granted { rung } -> verify(vec, old, fresh, rung)
        Request::Denied -> denied(vec)
    }

    // The grant must name rung 8; a mismatched answer leaves the vector
    // and both stores untouched.
    state verify(vec: &mut Vec, old: &mut Backing4, fresh: &mut Backing8, rung: u64) -> u64 {
        transition rung == 8 {
            true -> adopt(vec, old, fresh)
            _ -> denied(vec)
        }
    }

    state adopt(vec: &mut Vec, old: &mut Backing4, fresh: &mut Backing8) -> u64 {
        fresh.e[0] = old.e[0];
        fresh.e[1] = old.e[1];
        fresh.e[2] = old.e[2];
        fresh.e[3] = old.e[3];
        old.e[0] = 0;
        old.e[1] = 0;
        old.e[2] = 0;
        old.e[3] = 0;
        old.held = 0;
        fresh.held = 1;
        vec.rung = 8;
        vec.len
    }

    state denied(vec: &mut Vec) -> u64 {
        0
    }
}

pub machine Vec::grow8to16(vec: &mut Vec, old: &mut Backing8, fresh: &mut Backing16, request: Request) -> u64 {
    transition request {
        Request::Granted { rung } -> verify(vec, old, fresh, rung)
        Request::Denied -> denied(vec)
    }

    // The grant must name rung 16; a mismatched answer leaves the vector
    // and both stores untouched.
    state verify(vec: &mut Vec, old: &mut Backing8, fresh: &mut Backing16, rung: u64) -> u64 {
        transition rung == 16 {
            true -> adopt(vec, old, fresh)
            _ -> denied(vec)
        }
    }

    state adopt(vec: &mut Vec, old: &mut Backing8, fresh: &mut Backing16) -> u64 {
        fresh.e[0] = old.e[0];
        fresh.e[1] = old.e[1];
        fresh.e[2] = old.e[2];
        fresh.e[3] = old.e[3];
        fresh.e[4] = old.e[4];
        fresh.e[5] = old.e[5];
        fresh.e[6] = old.e[6];
        fresh.e[7] = old.e[7];
        old.e[0] = 0;
        old.e[1] = 0;
        old.e[2] = 0;
        old.e[3] = 0;
        old.e[4] = 0;
        old.e[5] = 0;
        old.e[6] = 0;
        old.e[7] = 0;
        old.held = 0;
        fresh.held = 1;
        vec.rung = 16;
        vec.len
    }

    state denied(vec: &mut Vec) -> u64 {
        0
    }
}

// Read one element out of the resident store — the caller's index proof
// bounds the access to the live prefix.
pub machine Vec::read4(store: &Backing4, index: u64) -> u32
requires index <= 3
{
    store.e[index]
}

pub machine Vec::read8(store: &Backing8, index: u64) -> u32
requires index <= 7
{
    store.e[index]
}

pub machine Vec::read16(store: &Backing16, index: u64) -> u32
requires index <= 15
{
    store.e[index]
}

pub machine Vec::tag(vec: &mut Vec) -> u64 {
    vec.rung
}

pub machine Vec::len(vec: &mut Vec) -> u64 {
    vec.len
}

// Explicit backing return: the live store's elements are read back into
// the caller's `out` record and the store is unheld — under the contract
// this is the caller draining the resident extent before `close`.
pub machine Vec::drain4(live: &mut Backing4, out: &mut Backing4) {
    out.e[0] = live.e[0];
    out.e[1] = live.e[1];
    out.e[2] = live.e[2];
    out.e[3] = live.e[3];
    live.e[0] = 0;
    live.e[1] = 0;
    live.e[2] = 0;
    live.e[3] = 0;
    live.held = 0;
}

pub machine Vec::drain8(live: &mut Backing8, out: &mut Backing8) {
    out.e[0] = live.e[0];
    out.e[1] = live.e[1];
    out.e[2] = live.e[2];
    out.e[3] = live.e[3];
    out.e[4] = live.e[4];
    out.e[5] = live.e[5];
    out.e[6] = live.e[6];
    out.e[7] = live.e[7];
    live.e[0] = 0;
    live.e[1] = 0;
    live.e[2] = 0;
    live.e[3] = 0;
    live.e[4] = 0;
    live.e[5] = 0;
    live.e[6] = 0;
    live.e[7] = 0;
    live.held = 0;
}

pub machine Vec::drain16(live: &mut Backing16, out: &mut Backing16) {
    out.e[0] = live.e[0];
    out.e[1] = live.e[1];
    out.e[2] = live.e[2];
    out.e[3] = live.e[3];
    out.e[4] = live.e[4];
    out.e[5] = live.e[5];
    out.e[6] = live.e[6];
    out.e[7] = live.e[7];
    out.e[8] = live.e[8];
    out.e[9] = live.e[9];
    out.e[10] = live.e[10];
    out.e[11] = live.e[11];
    out.e[12] = live.e[12];
    out.e[13] = live.e[13];
    out.e[14] = live.e[14];
    out.e[15] = live.e[15];
    live.e[0] = 0;
    live.e[1] = 0;
    live.e[2] = 0;
    live.e[3] = 0;
    live.e[4] = 0;
    live.e[5] = 0;
    live.e[6] = 0;
    live.e[7] = 0;
    live.e[8] = 0;
    live.e[9] = 0;
    live.e[10] = 0;
    live.e[11] = 0;
    live.e[12] = 0;
    live.e[13] = 0;
    live.e[14] = 0;
    live.e[15] = 0;
    live.held = 0;
}

// Terminal consumption of the handle: `close` is the declared consumer —
// it takes the linear vec by value, so a second close on the same place is
// a transfer-twice rejection at check time. All executable cleanup already
// happened in `drain`: every element returned to caller-owned backing and
// every store unheld. The empty handle itself has no runtime residue, so
// the consumer is a contract the checker enforces, not a runtime action —
// the same shape `vec_duplicate_cleanup` exercises.
pub boundary requirement Vec::close(self);
