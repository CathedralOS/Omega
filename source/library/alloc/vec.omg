module vec;

use omega::language::core::Extent;
use omega::language::core::Extent::Granted;
use omega::language::core::Extent::Vacant;
use omega::language::core::VacantExtentParts;
use omega::language::core::split_vacant_extent;
use omega::language::core::merge_vacant_extents;
use omega::language::core::Schema;
use omega::language::core::FieldPlan;
use omega::language::core::FieldEntry;
use omega::language::core::LayoutPlan;
use omega::language::core::Exposure;
use omega::language::core::FieldAccess;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPolicy;
use omega::language::core::Issuance;
use omega::language::core::FixedLayout;
use omega::language::core::LayoutStorage;
use omega::language::core::LayoutTarget;
use omega::language::core::reflect::TypeSchema;
use omega::language::core::reflect::field;
use omega::language::core::AccessPlan::new;
use omega::language::core::AccessPlan::observe;
use omega::language::core::ResourceProfileSupply;
use omega::language::core::Access;
use omega::language::core::Access::view_extent;
use omega::language::core::Access::view_extent_mut;
use omega::language::core::AccessOutcome;
use omega::language::core::read;
use omega::language::core::write;
// Runtime-sized u32 vector over caller-supplied, qualified backing.
// The owner supplies storage; growth returns the old extent for release by
// that same allocator. No capacity ladder, ambient allocator or hidden free.
//
// These copy scalars have no resident cleanup debt: the buffer remains Vacant
// and a checked stable-RAM access view reads/writes each four-byte cell. This
// does not represent arbitrary T custody; non-copy elements must retain their
// initialized values and discharge their cleanup before returning vacant bytes.
//
// Role selects the already-admitted backing profile, never creates authority.
// All access operations retain the original extent loan and checked geometry.

public data VecCell { value: u32; }
// The cell's representation remains four bytes at alignment four. Access
// requests keep that independent selection rather than embedding it in a policy.
public data VecCellStorage = LayoutStorage<VecCell, VecCellLayout>;
public domain VecCell::Controlled
    access VecCellPolicy;
public VecCellLayout satisfies FixedLayout<VecCell> {
    public machine plan(schema: Schema, target: LayoutTarget) -> LayoutPlan reaches none crashes none terminates {
        let mut entries: [FieldEntry; 64];
        entries[0] = FieldEntry { key: schema.fields[0].key, representation: FieldPlan::At { offset: 0 } };
        LayoutPlan { entries: entries, entry_count: 1, size_fixed: 4, size_is_dynamic: false, align: 4 }
    }
}

public VecCellPolicy satisfies AccessPolicy {
    machine plan(schema: TypeSchema) -> AccessPlan reaches none crashes none terminates {
        let mut plan: AccessPlan = AccessPlan::new(&schema, Issuance::Unrestricted);
        AccessPlan::observe(&mut plan, field(VecCell::value),
            FieldAccess::Stable { read: true, write: true, exposure: Exposure::Exported });
        plan
    }
}

data Observed { storage: Extent in Granted & Vacant; value: u32; }

machine store_cell<Role>(storage: &mut Extent in Granted & Vacant, value: u32)
crashes Trap
{
    transition Access::view_extent_mut<VecCellStorage in VecCell::Controlled, Role>(storage as &mut Extent in Granted) {
        AccessOutcome::Ready { view } -> change(view, value)
        AccessOutcome::Rejected { returned, reason } -> bad()
    }
    machine change(view: &mut VecCellStorage in VecCell::Controlled, value: u32) {
        write(&mut view.value, value);
    }
    machine bad() { crash Trap; }
}

machine store<Role>(storage: Extent in Granted & Vacant, offset: u64, value: u32) -> Extent in Granted & Vacant
requires storage.length >= 4, offset <= storage.length - 4
ensures result.base == storage.base, result.length == storage.length
crashes Trap
{
    let prefix: VacantExtentParts = split_vacant_extent(storage, offset);
    let element: VacantExtentParts = split_vacant_extent(prefix.rest, 4);
    let mut cell: Extent in Granted & Vacant = element.taken;
    store_cell<Role>(&mut cell, value);
    let suffix: Extent in Granted & Vacant = merge_vacant_extents(cell, element.rest);
    let whole: Extent in Granted & Vacant = merge_vacant_extents(prefix.taken, suffix);
    whole
}


public data Vec
requires self.len <= self.capacity, self.capacity <= 4611686018427387903,
    self.storage.length == self.capacity * 4
{
    storage: Extent in Granted & Vacant;
    len: u64;
    capacity: u64;
}

public machine Vec::open(storage: Extent in Granted & Vacant, capacity: u64) -> Vec
requires capacity <= 4611686018427387903, storage.length == capacity * 4
ensures result.len == 0, result.capacity == capacity,
    result.storage.base == storage.base, result.storage.length == storage.length
{ Vec { storage: storage, len: 0, capacity: capacity } }

public machine Vec::push<Role>(vec: Vec, value: u32) -> Vec
reaches ResourceProfileSupply
invokes ResourceProfileSupply
requires vec.len < vec.capacity
ensures result.len == vec.len + 1, result.capacity == vec.capacity,
    result.storage.base == vec.storage.base, result.storage.length == vec.storage.length
crashes Trap
{
    let length: u64 = vec.len;
    let capacity: u64 = vec.capacity;
    let storage: Extent in Granted & Vacant = vec.storage;
    let changed: Extent in Granted & Vacant = store<Role>(storage, length * 4, value);
    Vec { storage: changed, len: length + 1, capacity: capacity }
}

machine inspect_cell<Role>(storage: &Extent in Granted & Vacant) -> u32 crashes Trap {
    transition Access::view_extent<VecCellStorage in VecCell::Controlled, Role>(storage as &Extent in Granted) {
        AccessOutcome::Ready { view } -> read(&view.value)
        AccessOutcome::Rejected { returned, reason } -> bad()
    }
    machine bad() -> u32 { crash Trap; }
}

machine inspect<Role>(storage: Extent in Granted & Vacant, offset: u64) -> Observed
requires storage.length >= 4, offset <= storage.length - 4
ensures result.storage.base == storage.base, result.storage.length == storage.length
crashes Trap
{
    let prefix: VacantExtentParts = split_vacant_extent(storage, offset);
    let element: VacantExtentParts = split_vacant_extent(prefix.rest, 4);
    let cell: Extent in Granted & Vacant = element.taken;
    let value: u32 = inspect_cell<Role>(&cell);
    let suffix: Extent in Granted & Vacant = merge_vacant_extents(cell, element.rest);
    let whole: Extent in Granted & Vacant = merge_vacant_extents(prefix.taken, suffix);
    Observed { storage: whole, value: value }
}

public data Read { vec: Vec; value: u32; }
public machine Vec::get<Role>(vec: Vec, index: u64) -> Read
reaches ResourceProfileSupply
invokes ResourceProfileSupply
requires index < vec.len
ensures result.vec.len == vec.len, result.vec.capacity == vec.capacity,
    result.vec.storage.base == vec.storage.base, result.vec.storage.length == vec.storage.length
crashes Trap
{
    let length: u64 = vec.len;
    let capacity: u64 = vec.capacity;
    let storage: Extent in Granted & Vacant = vec.storage;
    let observed: Observed = inspect<Role>(storage, index * 4);
    Read { vec: Vec { storage: observed.storage, len: length, capacity: capacity }, value: observed.value }
}

data Copied {
    original: Extent in Granted & Vacant;
    replacement: Extent in Granted & Vacant;
}

machine copy_prefix<Role>(original: Extent in Granted & Vacant, replacement: Extent in Granted & Vacant,
    count: u64, remaining: u64) -> Copied
requires count <= 4611686018427387903, remaining <= count,
    original.length >= count * 4, replacement.length >= count * 4
ensures result.original.base == original.base, result.original.length == original.length,
    result.replacement.base == replacement.base, result.replacement.length == replacement.length
terminates by remaining
crashes Trap
{
    transition remaining > 0 {
        true -> step<Role>(original, replacement, count, remaining)
        false -> Copied { original: original, replacement: replacement }
    }
    machine step<Role>(original: Extent in Granted & Vacant, replacement: Extent in Granted & Vacant,
        count: u64, remaining: u64) -> Copied
    requires remaining > 0, count <= 4611686018427387903, remaining <= count,
        original.length >= count * 4, replacement.length >= count * 4
    ensures result.original.base == original.base, result.original.length == original.length,
        result.replacement.base == replacement.base, result.replacement.length == replacement.length
    {
        let offset: u64 = (count - remaining) * 4;
        let observed: Observed = inspect<Role>(original, offset);
        let changed: Extent in Granted & Vacant = store<Role>(replacement, offset, observed.value);
        transition { _ -> copy_prefix<Role>(observed.storage, changed, count, remaining - 1) }
    }
}

public data Growth { vec: Vec; retired_storage: Extent in Granted & Vacant; }
machine verify_vector(storage: &Extent in Granted & Vacant, length: u64, capacity: u64)
requires length <= capacity, capacity <= 4611686018427387903, storage.length == capacity * 4 {}
public machine Vec::grow<Role>(vec: Vec, replacement: Extent in Granted & Vacant, capacity: u64)
    -> Growth
reaches ResourceProfileSupply
invokes ResourceProfileSupply
requires capacity <= 4611686018427387903, capacity >= vec.len,
    replacement.length == capacity * 4
ensures result.vec.len == vec.len, result.vec.capacity == capacity,
    result.vec.storage.base == replacement.base, result.vec.storage.length == replacement.length,
    result.retired_storage.base == vec.storage.base, result.retired_storage.length == vec.storage.length
crashes Trap
{
    let length: u64 = vec.len;
    let original: Extent in Granted & Vacant = vec.storage;
    let copied: Copied = copy_prefix<Role>(original, replacement, length, length);
    verify_vector(&copied.replacement, length, capacity);
    let grown: Vec = Vec { storage: copied.replacement, len: length, capacity: capacity };
    Growth { vec: grown, retired_storage: copied.original }
}

public machine Vec::close(vec: Vec) -> Extent in Granted & Vacant
ensures result.base == vec.storage.base, result.length == vec.storage.length
{ vec.storage }
