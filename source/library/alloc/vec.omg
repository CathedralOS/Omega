module vec;

use omega::language::core::Extent;
use omega::language::core::Extent::Granted;
use omega::language::core::Extent::Vacant;
use omega::language::core::Run;
use omega::language::core::RunParts;
use omega::language::core::Live;
use omega::language::core::AccessOutcome;
use omega::language::core::AccessReturn;
use omega::language::core::AccessBorrowReturn;
use omega::language::core::AccessExtraction;
use omega::language::core::AccessInitializationFailure;
use omega::language::core::ResourceProfileSupply;
use omega::language::core::AccessPolicy;
use omega::language::core::AccessPlan;
use omega::language::core::Issuance;
use omega::language::core::reflect::TypeSchema;
use omega::language::core::access;
use omega::language::core::split_vacant_extent;
use omega::language::core::merge_vacant_extents;

// This policy adds no restrictions or grants. Each Run operation must still
// establish the selected layout, actual backing, access and transferred custody.
// In particular, a writable allocation does not thereby become readable RAM.
public Elements satisfies AccessPolicy {
    machine plan(schema: TypeSchema) -> AccessPlan reaches none crashes none terminates {
        access::new_plan(&schema, Issuance::Unrestricted)
    }
}

// The live prefix owns established T values; spare owns no resident values.
// Count is stored only by Run. Capacity remains explicit for zero-sized T,
// whose logical cells still carry ownership and cleanup obligations.
public data Vec<T> [linear]
requires
    self.live.count <= self.capacity,
    self.cell_size == size_of<T>(),
    embed(self.live.count) * embed(self.cell_size) == embed(self.live.storage.length),
    embed(self.capacity - self.live.count) * embed(self.cell_size) == embed(self.spare.length),
    embed(self.live.storage.length) + embed(self.spare.length) <= 18446744073709551615,
    self.live.storage.length != 0 || self.live.storage.base == self.spare.base,
    self.live.storage.length == 0 || self.spare.length == 0 ||
        embed(self.spare.base) == embed(self.live.storage.base) + embed(self.live.storage.length)
{
    live: Run<Elements, T> in Live<Elements, T>;
    spare: Extent in Granted & Vacant;
    capacity: u64;
    cell_size: u64;
}

// Geometry is the exact selected default storage of T, not new authority.
// Profile-dependent initialization may still reject this backing or alignment.
public machine open<T>(storage: Extent in Granted & Vacant, capacity: u64) -> Vec<T>
requires embed(capacity) * embed(size_of<T>()) == embed(storage.length)
ensures result.live.count == 0, result.capacity == capacity,
    result.live.storage.base == storage.base,
    result.spare.base == storage.base, result.spare.length == storage.length
{
    let cell_size: u64 = size_of<T>();
    let parts = split_vacant_extent(move storage, 0);
    let live: Run<Elements, T> in Live<Elements, T> = Run::empty<Elements, T>(move parts.taken);
    Vec { live: move live, spare: move parts.rest, capacity: capacity, cell_size: cell_size }
}

public machine length<T>(vector: &Vec<T>) -> u64
reaches none crashes none terminates
ensures result == vector.live.count
{ vector.live.count }

public machine capacity<T>(vector: &Vec<T>) -> u64
reaches none crashes none terminates
ensures result == vector.capacity
{ vector.capacity }

// A view borrows the actual live cells. It does not reinterpret the Vec or
// Run descriptor as T storage, and an incompatible supply returns no view.
public machine as_slice<'vector, T, Role>(vector: &'vector Vec<T>)
    -> AccessOutcome<&'vector [T], AccessBorrowReturn, AccessInitializationFailure>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
ensures (match result {
    AccessOutcome::Ready { view } -> view.len == vector.live.count,
    AccessOutcome::Rejected { returned, reason } -> true,
})
{
    Run::as_slice<Elements, T, Role>(&vector.live)
}

public machine as_mut_slice<'vector, T, Role>(vector: &'vector mut Vec<T>)
    -> AccessOutcome<&'vector mut [T], AccessBorrowReturn, AccessInitializationFailure>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
ensures (match result {
    AccessOutcome::Ready { view } -> view.len == vector.live.count,
    AccessOutcome::Rejected { returned, reason } -> true,
})
{
    Run::as_mut_slice<Elements, T, Role>(&mut vector.live)
}

public data PushOutcome<T> {
    case Inserted(vector: Vec<T>);
    case Full(vector: Vec<T>, value: T);
    case Rejected(vector: Vec<T>, value: T, reason: AccessInitializationFailure);
}

// Rejection returns the original value and recomposes the exact spare tail.
// A zero-sized value is still initialized as a real cell; length arithmetic
// alone never establishes it or discharges it.
public machine try_push<T, Role>(vector: Vec<T>, value: T) -> PushOutcome<T>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
ensures (match result {
    PushOutcome::Inserted { vector as changed } ->
        embed(changed.live.count) == embed(vector.live.count) + 1 && changed.capacity == vector.capacity &&
        changed.live.storage.base == vector.live.storage.base,
    PushOutcome::Full { vector as unchanged, value } ->
        unchanged.live.count == vector.live.count && unchanged.capacity == vector.capacity &&
        unchanged.live.storage.base == vector.live.storage.base &&
        unchanged.spare.base == vector.spare.base && unchanged.spare.length == vector.spare.length,
    PushOutcome::Rejected { vector as unchanged, value, reason } ->
        unchanged.live.count == vector.live.count && unchanged.capacity == vector.capacity &&
        unchanged.live.storage.base == vector.live.storage.base &&
        unchanged.spare.base == vector.spare.base && unchanged.spare.length == vector.spare.length,
})
{
    transition vector.live.count < vector.capacity {
        true -> insert<T, Role>(move vector, move value)
        false -> PushOutcome::Full { vector: move vector, value: move value }
    }
}

machine insert<T, Role>(vector: Vec<T>, value: T) -> PushOutcome<T>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
requires vector.live.count < vector.capacity
ensures (match result {
    PushOutcome::Inserted { vector as changed } ->
        embed(changed.live.count) == embed(vector.live.count) + 1 && changed.capacity == vector.capacity &&
        changed.live.storage.base == vector.live.storage.base,
    PushOutcome::Full { vector as unchanged, value } -> false,
    PushOutcome::Rejected { vector as unchanged, value, reason } ->
        unchanged.live.count == vector.live.count && unchanged.capacity == vector.capacity &&
        unchanged.live.storage.base == vector.live.storage.base &&
        unchanged.spare.base == vector.spare.base && unchanged.spare.length == vector.spare.length,
})
{
    let { live, spare, capacity, cell_size } = move vector;
    let parts = split_vacant_extent(move spare, cell_size);
    transition Run::initialize_cell<Elements, T, Role>(move parts.taken, move value) {
        AccessOutcome::Ready { view } -> PushOutcome::Inserted {
            vector: Vec {
                live: Run::merge<Elements, T>(move live, move view),
                spare: move parts.rest, capacity: capacity, cell_size: cell_size,
            }
        }
        AccessOutcome::Rejected { returned, reason } -> PushOutcome::Rejected {
            vector: Vec {
                live: move live,
                spare: merge_vacant_extents(move returned.source, move parts.rest),
                capacity: capacity, cell_size: cell_size,
            },
            value: move returned.custody, reason: reason,
        }
    }
}

public data Popped<T> { vector: Vec<T>; value: T; }

public machine pop<T, Role>(vector: Vec<T>) -> Popped<T>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
requires vector.live.count > 0
ensures result.vector.live.count == vector.live.count - 1,
    result.vector.capacity == vector.capacity,
    result.vector.live.storage.base == vector.live.storage.base,
    result.vector.cell_size == vector.cell_size
{
    let { live, spare, capacity, cell_size } = move vector;
    let cut: u64 = live.count - 1;
    let parts: RunParts<Elements, T> = Run::split<Elements, T>(move live, cut);
    transition Run::extract_cell<Elements, T, Role>(move parts.right) {
        AccessExtraction::Moved { storage, value } -> Popped {
            vector: Vec {
                live: move parts.left,
                spare: merge_vacant_extents(move storage, move spare),
                capacity: capacity, cell_size: cell_size,
            },
            value: move value,
        }
    }
}

// The caller's chosen allocator acquires backing. Exhausted carries no grant;
// an Available alternative must preserve the exact extent it actually acquired.
public data CapacityAllocation {
    case Available(storage: Extent in Granted & Vacant, capacity: u64);
    case Exhausted;
}

public data GrowthFailure {
    case Capacity(required: u64, available: u64);
    case Placement(reason: AccessInitializationFailure);
}

public data GrowthOutcome<T> {
    case Grown(vector: Vec<T>, retired_storage: Extent in Granted & Vacant);
    case Exhausted(vector: Vec<T>);
    case Rejected(vector: Vec<T>, replacement: Extent in Granted & Vacant,
        capacity: u64, reason: GrowthFailure);
}

// Growth consumes no allocator loan. Compatible relocation moves real cells;
// success returns the entire retired allocation, and failure returns both owners.
public machine try_grow<T, SourceRole, DestinationRole>(
    vector: Vec<T>, allocation: CapacityAllocation
) -> GrowthOutcome<T>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
requires (match allocation {
    CapacityAllocation::Available { storage, capacity } ->
        embed(capacity) * embed(vector.cell_size) == embed(storage.length),
    CapacityAllocation::Exhausted -> true,
})
ensures (match result {
    GrowthOutcome::Grown { vector as changed, retired_storage } ->
        changed.live.count == vector.live.count && changed.capacity >= vector.capacity &&
        retired_storage.base == vector.live.storage.base &&
        embed(retired_storage.length) == embed(vector.live.storage.length) + embed(vector.spare.length) &&
        (match allocation {
            CapacityAllocation::Available { storage, capacity } ->
                changed.capacity == capacity && changed.live.storage.base == storage.base,
            CapacityAllocation::Exhausted -> false,
        }),
    GrowthOutcome::Exhausted { vector as unchanged } ->
        unchanged.live.count == vector.live.count && unchanged.capacity == vector.capacity &&
        unchanged.live.storage.base == vector.live.storage.base && unchanged.live.storage.length == vector.live.storage.length &&
        unchanged.spare.base == vector.spare.base && unchanged.spare.length == vector.spare.length,
    GrowthOutcome::Rejected { vector as unchanged, replacement, capacity, reason } ->
        unchanged.live.count == vector.live.count && unchanged.capacity == vector.capacity &&
        unchanged.live.storage.base == vector.live.storage.base && unchanged.live.storage.length == vector.live.storage.length &&
        unchanged.spare.base == vector.spare.base && unchanged.spare.length == vector.spare.length,
})
{
    transition allocation {
        CapacityAllocation::Exhausted -> GrowthOutcome::Exhausted { vector: move vector }
        CapacityAllocation::Available { storage, capacity } ->
            grow_available<T, SourceRole, DestinationRole>(move vector, move storage, capacity)
    }
}

machine grow_available<T, SourceRole, DestinationRole>(
    vector: Vec<T>, replacement: Extent in Granted & Vacant, capacity: u64
) -> GrowthOutcome<T>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
requires embed(capacity) * embed(vector.cell_size) == embed(replacement.length)
ensures (match result {
    GrowthOutcome::Grown { vector as changed, retired_storage } ->
        changed.live.count == vector.live.count && changed.capacity == capacity &&
        changed.live.storage.base == replacement.base &&
        retired_storage.base == vector.live.storage.base &&
        embed(retired_storage.length) == embed(vector.live.storage.length) + embed(vector.spare.length),
    GrowthOutcome::Exhausted { vector as unchanged } -> false,
    GrowthOutcome::Rejected { vector as unchanged, replacement as returned, capacity as returned_capacity, reason } ->
        unchanged.live.count == vector.live.count && unchanged.capacity == vector.capacity &&
        returned.base == replacement.base && returned.length == replacement.length && returned_capacity == capacity,
})
{
    transition capacity >= vector.capacity {
        true -> relocate<T, SourceRole, DestinationRole>(move vector, move replacement, capacity)
        false -> GrowthOutcome::Rejected {
            reason: GrowthFailure::Capacity { required: vector.capacity, available: capacity },
            vector: move vector, replacement: move replacement, capacity: capacity,
        }
    }
}

machine relocate<T, SourceRole, DestinationRole>(
    vector: Vec<T>, replacement: Extent in Granted & Vacant, capacity: u64
) -> GrowthOutcome<T>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
requires capacity >= vector.capacity,
    embed(capacity) * embed(vector.cell_size) == embed(replacement.length)
ensures (match result {
    GrowthOutcome::Grown { vector as changed, retired_storage } ->
        changed.live.count == vector.live.count && changed.capacity == capacity &&
        changed.live.storage.base == replacement.base &&
        retired_storage.base == vector.live.storage.base &&
        embed(retired_storage.length) == embed(vector.live.storage.length) + embed(vector.spare.length),
    GrowthOutcome::Exhausted { vector as unchanged } -> false,
    GrowthOutcome::Rejected { vector as unchanged, replacement as returned, capacity as returned_capacity, reason } ->
        unchanged.live.count == vector.live.count && unchanged.capacity == vector.capacity &&
        returned.base == replacement.base && returned.length == replacement.length && returned_capacity == capacity,
})
{
    let { live, spare, capacity as old_capacity, cell_size } = move vector;
    let occupied_bytes: u64 = live.storage.length;
    let destination = split_vacant_extent(move replacement, occupied_bytes);
    transition Run::relocate<Elements, T, SourceRole, DestinationRole>(move live, move destination.taken) {
        AccessOutcome::Ready { view } -> GrowthOutcome::Grown {
            vector: Vec {
                live: move view.run, spare: move destination.rest,
                capacity: capacity, cell_size: cell_size,
            },
            retired_storage: merge_vacant_extents(move view.vacated, move spare),
        }
        AccessOutcome::Rejected { returned, reason } -> GrowthOutcome::Rejected {
            vector: Vec {
                live: move returned.source, spare: move spare,
                capacity: old_capacity, cell_size: cell_size,
            },
            replacement: merge_vacant_extents(move returned.custody, move destination.rest),
            capacity: capacity, reason: GrowthFailure::Placement { reason: reason },
        }
    }
}

// Empty means zero established values, including when every T has size zero.
// Return is not reclamation: the caller still owes its allocation contract.
public machine close_empty<T>(vector: Vec<T>) -> Extent in Granted & Vacant
reaches none crashes none terminates
requires vector.live.count == 0
ensures result.base == vector.live.storage.base,
    embed(result.length) == embed(vector.live.storage.length) + embed(vector.spare.length)
{
    let { live, spare, capacity, cell_size } = move vector;
    let vacant = Run::release_empty<Elements, T>(move live);
    merge_vacant_extents(move vacant, move spare)
}

public data Drained<Context> {
    storage: Extent in Granted & Vacant;
    context: Context;
}

// Explicit disposal visits each actual value exactly once. The ordinary
// consumer receives and returns its own context; no runtime capture or hidden
// allocator state is introduced. Each split performs constant descriptor work.
public machine drain<T, Role, Context,
    const Dispose: machine(value: T, context: Context) -> Context reaches none crashes none terminates
>(vector: Vec<T>, context: Context) -> Drained<Context>
reaches ResourceProfileSupply
invokes ResourceProfileSupply
ensures result.storage.base == vector.live.storage.base,
    embed(result.storage.length) == embed(vector.live.storage.length) + embed(vector.spare.length)
terminates by vector.live.count
{
    transition vector.live.count > 0 {
        true -> step(move vector, move context)
        false -> Drained { storage: close_empty<T>(move vector), context: move context }
    }
    machine step(vector: Vec<T>, context: Context) -> Drained<Context>
    requires vector.live.count > 0
    ensures result.storage.base == vector.live.storage.base,
        embed(result.storage.length) == embed(vector.live.storage.length) + embed(vector.spare.length)
    {
        let last: Popped<T> = pop<T, Role>(move vector);
        let updated: Context = Dispose(move last.value, move context);
        transition { _ -> drain<T, Role, Context, Dispose>(move last.vector, move updated) }
    }
}
