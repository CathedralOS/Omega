use time_host.omg as time_host;
use targets/linux_x86_64/time_host_impl.omg as raw_time;
use {omega}/language/core/numeric_conversion.omg as numeric;

// The kernel's 64-bit timespec, in declaration order. Both fields are SIGNED;
// a CLOCK_MONOTONIC read or a post-1970 CLOCK_REALTIME read is nonnegative,
// and the saturating conversions below keep a negative or absurd field from
// becoming an enormous unsigned tick count.
public data LinuxX64TimeHostInstant { seconds: i64; nanoseconds: i64; }
// `seconds * 1_000_000_000 + nanoseconds` in the Wrapping spelling
// `instant_now` already uses for the same reason: the interval fold cannot
// multiply variable bounds, so a proven-in-range multiply is not expressible
// here. The product cannot wrap for any real clock — u64 holds 18_446_744_073
// seconds of nanoseconds, past year 2554 for CLOCK_REALTIME and 584 years of
// uptime for CLOCK_MONOTONIC — and a kernel reporting more reads as a
// degraded tick count instead of faulting.
public machine linux_x86_64_time_host_ticks(seconds: i64, nanoseconds: i64) -> u64 {
    let seconds_unsigned: u64 = |numeric|::narrow_i64_to_u64_saturating(seconds);
    let nanoseconds_unsigned: u64 = |numeric|::narrow_i64_to_u64_saturating(nanoseconds);
    let scaled: u64 in Wrapping = (seconds_unsigned as +Wrapping) * 1000000000;
    let total: u64 in Wrapping = scaled + (nanoseconds_unsigned as +Wrapping);
    total as u64
}
public LinuxX8664TimeHost satisfies |time_host|::TimeHost {
    // Failed reads return zero; the system clock reads own degraded-clock handling.
    machine monotonic_ticks() -> u64
    reaches |time_host|::TimeHost
    invokes |raw_time|::LinuxX64TimeRead
    {
        let mutable instant: LinuxX64TimeHostInstant = LinuxX64TimeHostInstant { seconds: 0, nanoseconds: 0 };
        let status: i64 = |raw_time|::LinuxX64TimeRead::clock_gettime(1, @mutable instant);
        transition status == 0 {
            true -> measured(instant.seconds, instant.nanoseconds),
            _ -> degraded()
        }

        machine measured(seconds: i64, nanoseconds: i64) -> u64 {
            linux_x86_64_time_host_ticks(seconds, nanoseconds)
        }

        machine degraded() -> u64 { 0 }
    }

    machine monotonic_ticks_per_second() -> u64
    {
        1000000000
    }

    machine wall_clock_raw() -> u64
    reaches |time_host|::TimeHost
    invokes |raw_time|::LinuxX64TimeRead
    {
        let mutable instant: LinuxX64TimeHostInstant = LinuxX64TimeHostInstant { seconds: 0, nanoseconds: 0 };
        let status: i64 = |raw_time|::LinuxX64TimeRead::clock_gettime(0, @mutable instant);
        transition status == 0 {
            true -> measured(instant.seconds, instant.nanoseconds),
            _ -> degraded()
        }

        machine measured(seconds: i64, nanoseconds: i64) -> u64 {
            linux_x86_64_time_host_ticks(seconds, nanoseconds)
        }

        machine degraded() -> u64 { 0 }
    }

    machine wall_clock_units_per_second() -> u64
    {
        1000000000
    }

    machine wall_clock_epoch_offset_seconds() -> u64
    {
        0
    }

    machine sleep(milliseconds: u32)
    reaches |time_host|::TimeHost
    invokes |raw_time|::LinuxX64TimeRead
    blocks
    {
        transition milliseconds > 2147483647 {
            true -> block in_parts(milliseconds),
            _ -> block at_once(milliseconds)
        }

        machine at_once(milliseconds: u32) {
            block |raw_time|::linux_x86_64_time_host_wait_part(|numeric|::narrow_u32_to_i32_wrapping(milliseconds));
        }

        machine in_parts(milliseconds: u32) {
            let third: i32 = |numeric|::narrow_u32_to_i32_wrapping(milliseconds / 3);
            block |raw_time|::linux_x86_64_time_host_wait_part(third);
            block |raw_time|::linux_x86_64_time_host_wait_part(third);
            block |raw_time|::linux_x86_64_time_host_wait_part(third);
            block |raw_time|::linux_x86_64_time_host_wait_part(|numeric|::narrow_u32_to_i32_wrapping(milliseconds % 3));
        }
    }
}
