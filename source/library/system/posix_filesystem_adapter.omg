use filesystem.omg as filesystem;
use filesystem_host.omg as paths;
use posix_filesystem_host.omg as raw;
use posix_directory_records.omg as records;
use {omega}/language/core/filesystem_authority.omg as authority;
use {omega}/language/core/numeric_conversion.omg as numeric;

// POSIX implementation state is local to an entered portable operation. Raw
// calls are static provider dependencies; no raw binding enters app data.
// Free helpers receive operation scratch explicitly; PosixFilesystem is data only.
// Portable operations and directory traversal are shared. Target files own
// stat layouts, directory-record geometry, flags, errno translation and libc
// imports; only a target with that complete implementation installs defaults.

// Native mode bits are decoded only inside the POSIX family. The portable
// metadata kind is not an alias for a POSIX permission or file-type bitfield.
machine posix_metadata_kind(mode: u32) -> |filesystem|::FileKind {
    transition mode & 61440 {
        32768 -> |filesystem|::FileKind::File,
        16384 -> |filesystem|::FileKind::Directory,
        40960 -> |filesystem|::FileKind::Symlink,
        8192 -> |filesystem|::FileKind::CharacterDevice,
        24576 -> |filesystem|::FileKind::BlockDevice,
        4096 -> |filesystem|::FileKind::Fifo,
        49152 -> |filesystem|::FileKind::Socket,
        _ -> |filesystem|::FileKind::Other
    }
}

FilesystemPosixProvider satisfies |filesystem|::FilesystemService {
    machine create(path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
    reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
    {
        let mutable context: PosixFilesystem;
        posix_filesystem_create(@mutable context, path)
    }

    machine create_new(path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
    reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
    {
        let mutable context: PosixFilesystem;
        posix_filesystem_create_new(@mutable context, path)
    }

    machine open(path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
    reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
    {
        let mutable context: PosixFilesystem;
        posix_filesystem_open(@mutable context, path)
    }

    machine append(path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
    reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
    {
        let mutable context: PosixFilesystem;
        posix_filesystem_append(@mutable context, path)
    }

    machine read(file: |filesystem|::File, buffer: @mutable [u8], count: u64) -> |filesystem|::IoResult
    reaches |authority|::FilesystemContentRead
    {
        let mutable context: PosixFilesystem;
        posix_filesystem_read(@mutable context, file, buffer, count)
    }

    machine write(file: |filesystem|::File, bytes: @[u8]) -> |filesystem|::IoResult
    reaches |authority|::FilesystemContentWrite
    {
        let mutable context: PosixFilesystem;
        posix_filesystem_write(@mutable context, file, bytes)
    }

    machine close(file: |filesystem|::File) -> |filesystem|::UnitResult
    {
        let mutable context: PosixFilesystem;
        let result: i32 = posix_filesystem_close(@mutable context, file);
        transition result == 0 { true -> closed(), false -> failed(result) }
        machine closed() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
        machine failed(result: i32) -> |filesystem|::UnitResult {
            let mutable context: PosixFilesystem;
            let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(@mutable context, result);
            |filesystem|::UnitResult::Error { kind: kind }
        }
    }

    machine write_all(path: @[u8] in |paths|::Path, bytes: @[u8]) -> |filesystem|::UnitResult
    reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
    {
        let mutable context: PosixFilesystem;
        posix_filesystem_write_all(@mutable context, path, bytes)
