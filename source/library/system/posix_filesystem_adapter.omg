}
data PosixDirectoryKind [copy] {
    case Other;
    case Directory;
    case Regular;
}

data PosixFilesystem
requires open_writable >= 0 && open_writable <= 1,
    open_readable >= 0 && open_readable <= 1,
    open_creating >= 0 && open_creating <= 1
{
    // Typed stat views need the complete buffer at an eight-byte boundary.
    // The record's u64 scratch fields supply that alignment at its base.
    stat_buf: [u8; 144];

    dir_mode: i32;
    read_flags: i32;

    open_flags: i32;

    open_options: |filesystem|::OpenOptions;

    open_writable: i32;
    open_readable: i32;
    open_creating: i32;

    file_fd: i32;

    times_buf: [u8; 32];

    stat_rc: i32;

    stat_errno: i32;

    lock_errno: i32;

    err_code: i32;
    err_kind: |filesystem|::ErrorKind;

    dir_buf: [u8; 512];
    directory_descriptor: i32;
    rd_position: i64;
    record_offset: u64;
    batch_length: u64;
    rd_dtype: u8;
    rd_j: u64;
    entry_name: [u8; 765];

    rda_sub: i32;
    rda_rc: i32;

    rda_depth: u64;
    rda_fd: i32;

    rda_verdict: i32;

    rda_close_rc: i32;


}


// One open-option flag as its native bit value. Omega has no `bool as i32`
// conversion, so each target's flag encoding reads the bit through this.
public machine posix_flag_bit(flag: bool) -> i32
ensures result == 0 || result == 1
{
    match flag { true -> 1, false -> 0 }
}

machine posix_filesystem_creation_open_options() -> |filesystem|::OpenOptions {
    (|filesystem|::OpenOptions { read: false, write: true, append: false, truncate: true, create: true, create_new: false })
}

machine posix_filesystem_empty_open_options() -> |filesystem|::OpenOptions {
    (|filesystem|::OpenOptions { read: false, write: false, append: false, truncate: false, create: false, create_new: false })
}

machine posix_filesystem_create(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    filesystem.open_options = posix_filesystem_creation_open_options();
    |raw|::PosixFilesystemTarget::encode_open_options(filesystem);

    let fd: i32 = |raw|::PosixFilesystemHost::open_create(path, filesystem.open_flags, 438);
    transition fd >= 0 { true -> ok(fd), _ -> err(filesystem, fd) }
    machine ok(fd: i32) -> |filesystem|::OpenResult
    requires fd >= 0
    {
        |filesystem|::OpenResult::Ok { file: posix_filesystem_file(fd) }
    }
    machine err(filesystem: @mutable PosixFilesystem, fd: i32) -> |filesystem|::OpenResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, fd); |filesystem|::OpenResult::Error { kind: kind } }
}

machine posix_filesystem_create_new(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    filesystem.open_options = |filesystem|::OpenOptions {
        read: true,
        write: true,
        append: false,
        truncate: false,
        create: false,
        create_new: true,
    };
    |raw|::PosixFilesystemTarget::encode_open_options(filesystem);
    let fd: i32 = |raw|::PosixFilesystemHost::open_create(path, filesystem.open_flags, 438);
    transition fd >= 0 { true -> ok(filesystem, fd), _ -> err(filesystem, fd) }
    machine ok(filesystem: @mutable PosixFilesystem, fd: i32) -> |filesystem|::OpenResult
    requires fd >= 0
    {
        |filesystem|::OpenResult::Ok { file: posix_filesystem_file(fd) }
    }
    machine err(filesystem: @mutable PosixFilesystem, fd: i32) -> |filesystem|::OpenResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, fd); |filesystem|::OpenResult::Error { kind: kind } }
}

machine posix_filesystem_open(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    filesystem.open_options = posix_filesystem_empty_open_options();
    |raw|::PosixFilesystemTarget::encode_open_options(filesystem);
    filesystem.read_flags = filesystem.open_flags;
    let fd: i32 = |raw|::PosixFilesystemHost::open(path, filesystem.read_flags);
    transition fd >= 0 { true -> ok(fd), _ -> err(filesystem, fd) }
    machine ok(fd: i32) -> |filesystem|::OpenResult
    requires fd >= 0
    {
        |filesystem|::OpenResult::Ok { file: posix_filesystem_file(fd) }
    }
    machine err(filesystem: @mutable PosixFilesystem, fd: i32) -> |filesystem|::OpenResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, fd); |filesystem|::OpenResult::Error { kind: kind } }
}

machine posix_filesystem_append(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    filesystem.open_options = |filesystem|::OpenOptions {
        read: false,
        write: false,
        append: true,
        truncate: false,
        create: false,
        create_new: false,
    };
    |raw|::PosixFilesystemTarget::encode_open_options(filesystem);
    let fd: i32 = |raw|::PosixFilesystemHost::open(path, filesystem.open_flags);
    transition fd >= 0 { true -> ok(filesystem, fd), _ -> err(filesystem, fd) }
    machine ok(filesystem: @mutable PosixFilesystem, fd: i32) -> |filesystem|::OpenResult
    requires fd >= 0
    {
        |filesystem|::OpenResult::Ok { file: posix_filesystem_file(fd) }
    }
    machine err(filesystem: @mutable PosixFilesystem, fd: i32) -> |filesystem|::OpenResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, fd); |filesystem|::OpenResult::Error { kind: kind } }
}

// A count larger than the buffer is the caller's error on every target; the
// raw read would otherwise clamp it silently.
machine posix_filesystem_read(filesystem: @mutable PosixFilesystem, file: |filesystem|::File, buffer: @mutable [u8], count: u64) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentRead
{
    transition count <= buffer.length {
        true -> transfer(filesystem, file, buffer, count),
        false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::InvalidInput })
    }
    machine transfer(filesystem: @mutable PosixFilesystem, file: |filesystem|::File, buffer: @mutable [u8], count: u64) -> |filesystem|::IoResult {
        filesystem.file_fd = posix_filesystem_descriptor(file);
        let n: i64 = |raw|::PosixFilesystemHost::read(filesystem.file_fd, buffer, count);
        transition n >= 0 { true -> ok(n), _ -> err(filesystem, n) }
    }
    machine ok(n: i64) -> |filesystem|::IoResult
    requires n >= 0
    {
        let converted_count: u64 = n as u64;
        |filesystem|::IoResult::Ok { count: converted_count }
    }
    machine err(filesystem: @mutable PosixFilesystem, n: i64) -> |filesystem|::IoResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, n); |filesystem|::IoResult::Error { kind: kind } }
}

machine posix_filesystem_write(filesystem: @mutable PosixFilesystem, file: |filesystem|::File, bytes: @[u8]) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentWrite
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let n: i64 = |raw|::PosixFilesystemHost::write(filesystem.file_fd, bytes);
    transition n >= 0 { true -> ok(n), _ -> err(filesystem, n) }
    machine ok(n: i64) -> |filesystem|::IoResult
    requires n >= 0
    {
        let converted_count: u64 = n as u64;
        |filesystem|::IoResult::Ok { count: converted_count }
    }
    machine err(filesystem: @mutable PosixFilesystem, n: i64) -> |filesystem|::IoResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, n); |filesystem|::IoResult::Error { kind: kind } }
}

machine posix_filesystem_close(filesystem: @mutable PosixFilesystem, file: |filesystem|::File) -> i32
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::close(filesystem.file_fd);
    rc
}

// Complete a checked byte view, preserving the OS error and refusing zero
// progress. A short successful write advances the same original backing.
machine posix_filesystem_write_descriptor(filesystem: @mutable PosixFilesystem, descriptor: i32, bytes: @[u8]) -> |filesystem|::UnitResult
reaches |authority|::FilesystemContentWrite
{
    transition { _ -> remaining(filesystem, descriptor, bytes, 0) }
    machine remaining(filesystem: @mutable PosixFilesystem, descriptor: i32, bytes: @[u8], position: u64) -> |filesystem|::UnitResult
    requires position <= bytes.length
    {
        transition position < bytes.length {
            true -> write(filesystem, descriptor, bytes, position),
            false -> complete()
        }
    }
    machine write(filesystem: @mutable PosixFilesystem, descriptor: i32, bytes: @[u8], position: u64) -> |filesystem|::UnitResult
    requires position < bytes.length
    {
        let count: i64 = |raw|::PosixFilesystemHost::write(descriptor, @bytes[position..bytes.length]);
        transition count > 0 {
            true -> progressed(filesystem, descriptor, bytes, position, count),
            false -> stalled(filesystem, descriptor, bytes, position, count)
        }
    }
    machine progressed(filesystem: @mutable PosixFilesystem, descriptor: i32, bytes: @[u8], position: u64, count: i64) -> |filesystem|::UnitResult
    requires position <= bytes.length, count > 0
    {
        let written: u64 = |numeric|::narrow_i64_to_u64_exact(count);
        transition written <= bytes.length - position {
            true -> remaining(filesystem, descriptor, bytes, position + written),
            false -> invalid()
        }
    }
    machine stalled(filesystem: @mutable PosixFilesystem, descriptor: i32, bytes: @[u8], position: u64, count: i64) -> |filesystem|::UnitResult
    requires position <= bytes.length
    {
        transition count == -4 {
            true -> remaining(filesystem, descriptor, bytes, position),
            false -> failure(filesystem, count)
        }
    }
    machine failure(filesystem: @mutable PosixFilesystem, count: i64) -> |filesystem|::UnitResult {
        transition count == 0 { true -> zero_progress(), false -> failed(filesystem, count) }
    }
    machine failed(filesystem: @mutable PosixFilesystem, count: i64) -> |filesystem|::UnitResult {
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, count);
        |filesystem|::UnitResult::Error { kind: kind }
    }
    machine zero_progress() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::WriteZero } }
    machine invalid() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::Other } }
    machine complete() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
}

machine posix_filesystem_write_all(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, bytes: @[u8]) -> |filesystem|::UnitResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    filesystem.open_options = posix_filesystem_creation_open_options();
    |raw|::PosixFilesystemTarget::encode_open_options(filesystem);
    let descriptor: i32 = |raw|::PosixFilesystemHost::open_create(path, filesystem.open_flags, 438);
    transition descriptor >= 0 { true -> opened(filesystem, descriptor, bytes), false -> open_failed(filesystem, descriptor) }
    machine opened(filesystem: @mutable PosixFilesystem, descriptor: i32, bytes: @[u8]) -> |filesystem|::UnitResult {
        let outcome: |filesystem|::UnitResult = posix_filesystem_write_descriptor(filesystem, descriptor, bytes);
        let closed: i32 = |raw|::PosixFilesystemHost::close(descriptor);
        transition outcome {
            |filesystem|::UnitResult::Ok -> close_result(filesystem, closed),
            |filesystem|::UnitResult::Error { kind } -> failed(kind)
        }
    }
    machine close_result(filesystem: @mutable PosixFilesystem, result: i32) -> |filesystem|::UnitResult {
        transition result == 0 { true -> complete(), false -> open_failed(filesystem, result) }
    }
    machine open_failed(filesystem: @mutable PosixFilesystem, result: i32) -> |filesystem|::UnitResult {
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, result);
        |filesystem|::UnitResult::Error { kind: kind }
    }
    machine failed(kind: |filesystem|::ErrorKind) -> |filesystem|::UnitResult { |filesystem|::UnitResult::Error { kind: kind } }
    machine complete() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
}

machine posix_filesystem_read_all(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, buffer: @mutable [u8], count: u64) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    transition count <= buffer.length {
        true -> acquire(filesystem, path, buffer, count),
        false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::InvalidInput })
    }
    machine acquire(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, buffer: @mutable [u8], count: u64) -> |filesystem|::IoResult {
        filesystem.open_options = posix_filesystem_empty_open_options();
        |raw|::PosixFilesystemTarget::encode_open_options(filesystem);
        let descriptor: i32 = |raw|::PosixFilesystemHost::open(path, filesystem.open_flags);
        transition descriptor >= 0 { true -> opened(filesystem, descriptor, buffer, count), false -> failed_open(filesystem, descriptor) }
    }
    machine opened(filesystem: @mutable PosixFilesystem, descriptor: i32, buffer: @mutable [u8], count: u64) -> |filesystem|::IoResult {
        let received: i64 = |raw|::PosixFilesystemHost::read(descriptor, buffer, count);
        let closed: i32 = |raw|::PosixFilesystemHost::close(descriptor);
        transition received >= 0 { true -> read_result(filesystem, received, closed), false -> read_failed(filesystem, received) }
    }
    machine read_result(filesystem: @mutable PosixFilesystem, received: i64, closed: i32) -> |filesystem|::IoResult
    requires received >= 0
    {
        transition closed == 0 { true -> complete(received), false -> failed_open(filesystem, closed) }
    }
    machine complete(received: i64) -> |filesystem|::IoResult requires received >= 0 {
        let count: u64 = |numeric|::narrow_i64_to_u64_exact(received);
        |filesystem|::IoResult::Ok { count: count }
    }
    machine failed_open(filesystem: @mutable PosixFilesystem, result: i32) -> |filesystem|::IoResult {
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, result);
        |filesystem|::IoResult::Error { kind: kind }
    }
    machine read_failed(filesystem: @mutable PosixFilesystem, result: i64) -> |filesystem|::IoResult {
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, result);
        |filesystem|::IoResult::Error { kind: kind }
    }
}

// Preserve the existing bounded-copy contract: cap is the maximum prefix.
// Only initialized bytes cross the destination seam. Opening, metadata,
// writing, permission restoration and release each retain their own failure.
machine posix_filesystem_copy(filesystem: @mutable PosixFilesystem, from: @[u8] in |paths|::Path, to: @[u8] in |paths|::Path, buffer: @mutable [u8], cap: u64) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::FilesystemMetadataQuery
{
    transition cap <= buffer.length {
        true -> acquire(filesystem, from, to, buffer, cap),
        false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::InvalidInput })
    }
    machine acquire(filesystem: @mutable PosixFilesystem, from: @[u8] in |paths|::Path, to: @[u8] in |paths|::Path, buffer: @mutable [u8], cap: u64) -> |filesystem|::IoResult {
        filesystem.open_options = posix_filesystem_empty_open_options();
        |raw|::PosixFilesystemTarget::encode_open_options(filesystem);
        let source: i32 = |raw|::PosixFilesystemHost::open(from, filesystem.open_flags);
        transition source >= 0 { true -> metadata(filesystem, source, to, buffer, cap), false -> failed_open(filesystem, source) }
    }
    machine metadata(filesystem: @mutable PosixFilesystem, source: i32, to: @[u8] in |paths|::Path, buffer: @mutable [u8], cap: u64) -> |filesystem|::IoResult {
        let result: i32 = |raw|::PosixFilesystemHost::read_file_metadata(source, @mutable filesystem.stat_buf);
        transition result == 0 { true -> read(filesystem, source, to, buffer, cap), false -> metadata_failed(filesystem, source, result) }
    }
    machine metadata_failed(filesystem: @mutable PosixFilesystem, source: i32, result: i32) -> |filesystem|::IoResult {
        let closed: i32 = |raw|::PosixFilesystemHost::close(source);
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, result);
        |filesystem|::IoResult::Error { kind: kind }
    }
    machine read(filesystem: @mutable PosixFilesystem, source: i32, to: @[u8] in |paths|::Path, buffer: @mutable [u8], cap: u64) -> |filesystem|::IoResult {
        let result: |filesystem|::MetadataResult = |raw|::PosixFilesystemTarget::decode_metadata(filesystem);
        transition result {
            |filesystem|::MetadataResult::Ok { meta } -> read_contents(filesystem, source, to, buffer, cap, meta),
            |filesystem|::MetadataResult::Error { kind } -> invalid_metadata(source, kind)
        }
    }
    machine invalid_metadata(source: i32, kind: |filesystem|::ErrorKind) -> |filesystem|::IoResult {
        let closed: i32 = |raw|::PosixFilesystemHost::close(source);
        |filesystem|::IoResult::Error { kind: kind }
    }
    machine read_contents(filesystem: @mutable PosixFilesystem, source: i32, to: @[u8] in |paths|::Path, buffer: @mutable [u8], cap: u64, metadata: |filesystem|::Metadata) -> |filesystem|::IoResult {
        transition metadata.posix {
            |filesystem|::PosixMetadataResult::Ok { details } -> read_permissioned(filesystem, source, to, buffer, cap, details.mode & 511),
            |filesystem|::PosixMetadataResult::Error { kind } -> invalid_metadata(source, kind)
        }
    }
    machine read_permissioned(filesystem: @mutable PosixFilesystem, source: i32, to: @[u8] in |paths|::Path, buffer: @mutable [u8], cap: u64, mode: u32) -> |filesystem|::IoResult {
        let count: i64 = |raw|::PosixFilesystemHost::read(source, buffer, cap);
        let closed: i32 = |raw|::PosixFilesystemHost::close(source);
        transition count >= 0 { true -> read_result(filesystem, to, buffer, count, mode, closed), false -> read_failed(filesystem, count) }
    }
    machine read_result(filesystem: @mutable PosixFilesystem, to: @[u8] in |paths|::Path, buffer: @mutable [u8], count: i64, mode: u32, closed: i32) -> |filesystem|::IoResult
    requires count >= 0
    {
        transition closed == 0 { true -> bounded(filesystem, to, buffer, count, mode), false -> failed_open(filesystem, closed) }
    }
    machine bounded(filesystem: @mutable PosixFilesystem, to: @[u8] in |paths|::Path, buffer: @mutable [u8], count: i64, mode: u32) -> |filesystem|::IoResult
    requires count >= 0
    {
        let received: u64 = |numeric|::narrow_i64_to_u64_exact(count);
        transition received <= buffer.length { true -> destination(filesystem, to, buffer, received, mode), false -> invalid() }
    }
    machine destination(filesystem: @mutable PosixFilesystem, to: @[u8] in |paths|::Path, buffer: @mutable [u8], count: u64, mode: u32) -> |filesystem|::IoResult
    requires count <= buffer.length
    {
        filesystem.open_options = posix_filesystem_creation_open_options();
        |raw|::PosixFilesystemTarget::encode_open_options(filesystem);
        let descriptor: i32 = |raw|::PosixFilesystemHost::open_create(to, filesystem.open_flags, 438);
        transition descriptor >= 0 { true -> write(filesystem, descriptor, buffer, count, mode), false -> failed_open(filesystem, descriptor) }
    }
    machine write(filesystem: @mutable PosixFilesystem, descriptor: i32, buffer: @mutable [u8], count: u64, mode: u32) -> |filesystem|::IoResult
    requires count <= buffer.length
    {
        let bytes: @[u8] = @buffer[0..count];
        let outcome: |filesystem|::UnitResult = posix_filesystem_write_descriptor(filesystem, descriptor, bytes);
        transition outcome { |filesystem|::UnitResult::Ok -> permissions(filesystem, descriptor, count, mode), |filesystem|::UnitResult::Error { kind } -> write_failed(descriptor, kind) }
    }
    machine permissions(filesystem: @mutable PosixFilesystem, descriptor: i32, count: u64, mode: u32) -> |filesystem|::IoResult {
        let changed: i32 = |raw|::PosixFilesystemHost::set_file_permissions(descriptor, mode);
        let closed: i32 = |raw|::PosixFilesystemHost::close(descriptor);
        transition changed == 0 { true -> close_result(filesystem, count, closed), false -> failed_open(filesystem, changed) }
    }
    machine close_result(filesystem: @mutable PosixFilesystem, count: u64, closed: i32) -> |filesystem|::IoResult {
        transition closed == 0 { true -> complete(count), false -> failed_open(filesystem, closed) }
    }
    machine write_failed(descriptor: i32, kind: |filesystem|::ErrorKind) -> |filesystem|::IoResult {
        let closed: i32 = |raw|::PosixFilesystemHost::close(descriptor);
        |filesystem|::IoResult::Error { kind: kind }
    }
    machine failed_open(filesystem: @mutable PosixFilesystem, result: i32) -> |filesystem|::IoResult {
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, result);
        |filesystem|::IoResult::Error { kind: kind }
    }
    machine read_failed(filesystem: @mutable PosixFilesystem, result: i64) -> |filesystem|::IoResult {
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, result);
        |filesystem|::IoResult::Error { kind: kind }
    }
    machine invalid() -> |filesystem|::IoResult { |filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::Other } }
    machine complete(count: u64) -> |filesystem|::IoResult { |filesystem|::IoResult::Ok { count: count } }
}

machine posix_filesystem_exists(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> bool
reaches |authority|::FilesystemMetadataQuery
{
    filesystem.stat_rc = |raw|::PosixFilesystemHost::read_metadata(path, @mutable filesystem.stat_buf);
    filesystem.stat_rc == 0
}

machine posix_filesystem_try_exists(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::ExistsResult
reaches |authority|::FilesystemMetadataQuery
{

    filesystem.stat_rc = |raw|::PosixFilesystemHost::read_metadata(path, @mutable filesystem.stat_buf);
    let metadata_rc: i32 = filesystem.stat_rc;
    filesystem.stat_errno = posix_filesystem_native_error_code_i32(filesystem, metadata_rc);
    transition filesystem.stat_rc == 0 { true -> present(filesystem), _ -> absent(filesystem) }
    machine present(filesystem: @mutable PosixFilesystem) -> |filesystem|::ExistsResult { |filesystem|::ExistsResult::Yes }
    machine absent(filesystem: @mutable PosixFilesystem) -> |filesystem|::ExistsResult {
        transition filesystem.stat_errno == 2 { true -> no(filesystem), _ -> other(filesystem) }
    }
    machine no(filesystem: @mutable PosixFilesystem) -> |filesystem|::ExistsResult { |filesystem|::ExistsResult::No }
    machine other(filesystem: @mutable PosixFilesystem) -> |filesystem|::ExistsResult { let metadata_rc: i32 = filesystem.stat_rc; let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, metadata_rc); |filesystem|::ExistsResult::Error { kind: kind } }
}

machine posix_filesystem_metadata_path(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::MetadataResult
reaches |authority|::FilesystemMetadataQuery
{
    let rc: i32 = |raw|::PosixFilesystemHost::read_metadata(path, @mutable filesystem.stat_buf);
    transition rc == 0 { true -> decode(filesystem), _ -> err(filesystem, rc) }
    machine decode(filesystem: @mutable PosixFilesystem) -> |filesystem|::MetadataResult { |raw|::PosixFilesystemTarget::decode_metadata(filesystem) }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::MetadataResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::MetadataResult::Error { kind: kind } }
}

machine posix_filesystem_symlink_metadata(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::MetadataResult
reaches |authority|::FilesystemMetadataQuery
{
    let rc: i32 = |raw|::PosixFilesystemHost::read_symlink_metadata(path, @mutable filesystem.stat_buf);
    transition rc == 0 { true -> decode(filesystem), _ -> err(filesystem, rc) }
    machine decode(filesystem: @mutable PosixFilesystem) -> |filesystem|::MetadataResult { |raw|::PosixFilesystemTarget::decode_metadata(filesystem) }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::MetadataResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::MetadataResult::Error { kind: kind } }
}

machine posix_filesystem_remove(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemNamespaceMutation
{
    let rc: i32 = |raw|::PosixFilesystemHost::remove(path);
    transition rc == 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

// Raw POSIX providers return negative errno on every supported target.
// Preserve that code; each target maps its own errno catalog to portable kinds.
machine posix_filesystem_native_error_code_i32(filesystem: @mutable PosixFilesystem, result: i32) -> i32 {
    let code: i32 in Wrapping = (0 as i32 +Wrapping) - (result as i32 +Wrapping);
    filesystem.err_code = code as i32;
    filesystem.err_code
}
machine posix_filesystem_native_error_code_i64(filesystem: @mutable PosixFilesystem, result: i64) -> i32 {
    let code: i64 in Wrapping = (0 as i64 +Wrapping) - (result as i64 +Wrapping);
    filesystem.err_code = |numeric|::narrow_i64_to_i32_wrapping(code as i64);
    filesystem.err_code
}

machine posix_filesystem_last_error_i32(filesystem: @mutable PosixFilesystem, result: i32) -> |filesystem|::ErrorKind {
    filesystem.err_code = posix_filesystem_native_error_code_i32(filesystem, result);
    |raw|::PosixFilesystemTarget::kind_of_stored_error_code(filesystem)
}

machine posix_filesystem_last_error_i64(filesystem: @mutable PosixFilesystem, result: i64) -> |filesystem|::ErrorKind {
    filesystem.err_code = posix_filesystem_native_error_code_i64(filesystem, result);
    |raw|::PosixFilesystemTarget::kind_of_stored_error_code(filesystem)
}

machine posix_filesystem_create_dir(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    filesystem.dir_mode = 493;
    let rc: i32 = |raw|::PosixFilesystemHost::create_dir(path, filesystem.dir_mode);
    transition rc == 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_remove_dir(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemNamespaceMutation
{
    let rc: i32 = |raw|::PosixFilesystemHost::remove_dir(path);
    transition rc == 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_create_dir_all(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::FilesystemMetadataQuery
{
    filesystem.dir_mode = 493;
    transition { _ -> posix_filesystem_mkall_walk(filesystem, path, 1, path.length) }
}

// Create every parent prefix in order, then the whole path, as Windows does. A
// prefix that already exists as a directory is fine; any other failure stops
// the walk and returns that error. No prefix is skipped for its length.
// `remaining` counts the bytes left to scan; each step descends it.
machine posix_filesystem_mkall_walk(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, i: u64, remaining: u64) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::FilesystemMetadataQuery
terminates by remaining
{
    transition i < path.length && remaining > 0 {
        true -> inspect(filesystem, path, i, remaining),
        false -> posix_filesystem_create_dir_existing(filesystem, path)
    }
    machine inspect(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, i: u64, remaining: u64) -> |filesystem|::UnitResult
    requires i < path.length && remaining > 0
    terminates by remaining
    {
        // A builtin index takes an unqualified view (domains.md, "Operands").
        transition (path as - |paths|::Path)[i] == 47 {
            true -> create(filesystem, path, i, remaining),
            false -> posix_filesystem_mkall_walk(filesystem, path, i + 1, remaining - 1)
        }
    }
    machine create(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, i: u64, remaining: u64) -> |filesystem|::UnitResult
    requires i < path.length && remaining > 0
    terminates by remaining
    {
        // A builtin range takes an unqualified view (domains.md, "Operands"): remove
        // `Path` before the prefix and add it back to the prefix.
        let prefix: @[u8] = @(path as - |paths|::Path)[0..i];
        let result: |filesystem|::UnitResult = posix_filesystem_create_dir_existing(filesystem, prefix as + |paths|::Path);
        transition result {
            |filesystem|::UnitResult::Error { kind } -> (|filesystem|::UnitResult::Error { kind: kind }),
            |filesystem|::UnitResult::Ok -> posix_filesystem_mkall_walk(filesystem, path, i + 1, remaining - 1)
        }
    }
}

// `mkdir`, treating an existing directory as success. EEXIST also names
// ordinary files, so only a followed directory satisfies the request; a failed
// query preserves the original mkdir error.
machine posix_filesystem_create_dir_existing(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::FilesystemMetadataQuery
{
    let rc: i32 = |raw|::PosixFilesystemHost::create_dir(path, filesystem.dir_mode);
    transition rc == 0 { true -> ok(), _ -> exists_ok(filesystem, path, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine exists_ok(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, rc: i32) -> |filesystem|::UnitResult {
        let code: i32 = posix_filesystem_native_error_code_i32(filesystem, rc);
        transition code == 17 { true -> existing_kind(filesystem, path, rc), _ -> failed(filesystem, rc) }
    }
    machine existing_kind(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, rc: i32) -> |filesystem|::UnitResult {
        let result: |filesystem|::MetadataResult = posix_filesystem_metadata_path(filesystem, path);
        transition result {
            |filesystem|::MetadataResult::Ok { meta } -> existing_metadata(filesystem, rc, meta),
            _ -> failed(filesystem, rc)
        }
    }
    machine existing_metadata(filesystem: @mutable PosixFilesystem, rc: i32, metadata: |filesystem|::Metadata) -> |filesystem|::UnitResult {
        transition metadata.kind { |filesystem|::FileKind::Directory -> ok(), _ -> failed(filesystem, rc) }
    }
    machine failed(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult {
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc);
        |filesystem|::UnitResult::Error { kind: kind }
    }
}

machine posix_filesystem_read_dir_is_empty(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::EmptyResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::DirectoryEnumeration + |authority|::FilesystemMetadataQuery
{
    let first: |filesystem|::IoResult = posix_filesystem_scan_names(filesystem, path, true);
    transition first {
        |filesystem|::IoResult::Ok { count } -> found(count),
        |filesystem|::IoResult::Error { kind } -> (|filesystem|::EmptyResult::Error { kind: kind })
    }
    machine found(count: u64) -> |filesystem|::EmptyResult {
        transition count == 0 { true -> |filesystem|::EmptyResult::Empty, false -> |filesystem|::EmptyResult::NonEmpty }
    }
}

machine posix_filesystem_set_permissions(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, perms: |filesystem|::Permissions) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataQuery + |authority|::FilesystemMetadataMutation
{
    transition perms {
        |filesystem|::Permissions::Default -> inspect(filesystem, path, false),
        |filesystem|::Permissions::Posix { mode } -> apply(filesystem, path, mode),
        |filesystem|::Permissions::Readonly { value } -> inspect(filesystem, path, value)
    }
    // A portable read-only request changes only write bits of the live mode;
    // an exact POSIX request needs no preliminary query. The path-based query
    // and update are not atomic against concurrent replacement or mode changes.
    machine inspect(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, readonly: bool) -> |filesystem|::UnitResult {
        let result: i32 = |raw|::PosixFilesystemHost::read_metadata(path, @mutable filesystem.stat_buf);
        transition result == 0 { true -> derive(filesystem, path, readonly), false -> err(filesystem, result) }
    }
    machine derive(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, readonly: bool) -> |filesystem|::UnitResult {
        let existing: u32 = |raw|::PosixFilesystemTarget::permission_bits(filesystem);
        let requested: u32 = |filesystem|::posix_mode_with_readonly(existing, readonly);
        transition { _ -> apply(filesystem, path, requested) }
    }
    machine apply(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, mode: u32) -> |filesystem|::UnitResult {
        let result: i32 = |raw|::PosixFilesystemHost::set_permissions(path, mode);
        transition result == 0 { true -> ok(), false -> err(filesystem, result) }
    }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_symlink(filesystem: @mutable PosixFilesystem, target: @[u8] in |paths|::Path, link: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemNamespaceMutation
{
    let rc: i32 = |raw|::PosixFilesystemHost::symlink(target, link);
    transition rc == 0 { true -> ok(filesystem), _ -> err(filesystem, rc) }
    machine ok(filesystem: @mutable PosixFilesystem) -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_read_link(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, buffer: @mutable [u8], count: u64) -> |filesystem|::IoResult
reaches |authority|::FilesystemMetadataQuery
{
    let n: i64 = |raw|::PosixFilesystemHost::read_link(path, buffer, count);
    transition n >= 0 { true -> ok(filesystem, n), _ -> err(filesystem, n) }
    machine ok(filesystem: @mutable PosixFilesystem, n: i64) -> |filesystem|::IoResult
    requires n >= 0
    {
        let converted_count: u64 = n as u64;
        |filesystem|::IoResult::Ok { count: converted_count }
    }
    machine err(filesystem: @mutable PosixFilesystem, n: i64) -> |filesystem|::IoResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, n); |filesystem|::IoResult::Error { kind: kind } }
}

machine posix_filesystem_set_file_permissions(filesystem: @mutable PosixFilesystem, file: |filesystem|::File, perms: |filesystem|::Permissions) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataQuery + |authority|::FilesystemMetadataMutation
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    transition perms {
        |filesystem|::Permissions::Default -> inspect(filesystem, false),
        |filesystem|::Permissions::Posix { mode } -> apply(filesystem, mode),
        |filesystem|::Permissions::Readonly { value } -> inspect(filesystem, value)
    }
    machine inspect(filesystem: @mutable PosixFilesystem, readonly: bool) -> |filesystem|::UnitResult {
        let result: i32 = |raw|::PosixFilesystemHost::read_file_metadata(filesystem.file_fd, @mutable filesystem.stat_buf);
        transition result == 0 { true -> derive(filesystem, readonly), false -> err(filesystem, result) }
    }
    machine derive(filesystem: @mutable PosixFilesystem, readonly: bool) -> |filesystem|::UnitResult {
        let existing: u32 = |raw|::PosixFilesystemTarget::permission_bits(filesystem);
        let requested: u32 = |filesystem|::posix_mode_with_readonly(existing, readonly);
        transition { _ -> apply(filesystem, requested) }
    }
    machine apply(filesystem: @mutable PosixFilesystem, mode: u32) -> |filesystem|::UnitResult {
        let result: i32 = |raw|::PosixFilesystemHost::set_file_permissions(filesystem.file_fd, mode);
        transition result == 0 { true -> ok(filesystem), false -> err(filesystem, result) }
    }
    machine ok(filesystem: @mutable PosixFilesystem) -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_rename(filesystem: @mutable PosixFilesystem, from: @[u8] in |paths|::Path, to: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemNamespaceMutation
{
    let rc: i32 = |raw|::PosixFilesystemHost::rename(from, to);
    transition rc == 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_set_len(filesystem: @mutable PosixFilesystem, file: |filesystem|::File, length: i64) -> |filesystem|::UnitResult
reaches |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::set_len(filesystem.file_fd, length);
    transition rc == 0 { true -> ok(filesystem), _ -> err(filesystem, rc) }
    machine ok(filesystem: @mutable PosixFilesystem) -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_sync(filesystem: @mutable PosixFilesystem, file: |filesystem|::File) -> |filesystem|::UnitResult
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::sync(filesystem.file_fd);
    transition rc == 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_sync_data(filesystem: @mutable PosixFilesystem, file: |filesystem|::File) -> |filesystem|::UnitResult
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::sync_data(filesystem.file_fd);
    transition rc == 0 { true -> ok(filesystem), _ -> err(filesystem, rc) }
    machine ok(filesystem: @mutable PosixFilesystem) -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_try_clone(filesystem: @mutable PosixFilesystem, file: |filesystem|::File) -> |filesystem|::OpenResult
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let fd: i32 = |raw|::PosixFilesystemHost::duplicate(filesystem.file_fd);
    transition fd >= 0 { true -> ok(filesystem, fd), _ -> err(filesystem, fd) }
    machine ok(filesystem: @mutable PosixFilesystem, fd: i32) -> |filesystem|::OpenResult
    requires fd >= 0
    {
        |filesystem|::OpenResult::Ok { file: posix_filesystem_file(fd) }
    }
    machine err(filesystem: @mutable PosixFilesystem, fd: i32) -> |filesystem|::OpenResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, fd); |filesystem|::OpenResult::Error { kind: kind } }
}

machine posix_filesystem_set_owner(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, uid: i32, gid: i32) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation
{
    let rc: i32 = |raw|::PosixFilesystemHost::change_owner(path, uid, gid);
    transition rc == 0 { true -> ok(filesystem), _ -> err(filesystem, rc) }
    machine ok(filesystem: @mutable PosixFilesystem) -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_set_owner_no_follow(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, uid: i32, gid: i32) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation
{
    let rc: i32 = |raw|::PosixFilesystemHost::change_owner_no_follow(path, uid, gid);
    transition rc == 0 { true -> ok(filesystem), _ -> err(filesystem, rc) }
    machine ok(filesystem: @mutable PosixFilesystem) -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_set_file_owner(filesystem: @mutable PosixFilesystem, file: |filesystem|::File, uid: i32, gid: i32) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::change_file_owner(filesystem.file_fd, uid, gid);
    transition rc == 0 { true -> ok(filesystem), _ -> err(filesystem, rc) }
    machine ok(filesystem: @mutable PosixFilesystem) -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_metadata(filesystem: @mutable PosixFilesystem, file: |filesystem|::File) -> |filesystem|::MetadataResult
reaches |authority|::FilesystemMetadataQuery
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::read_file_metadata(filesystem.file_fd, @mutable filesystem.stat_buf);
    transition rc == 0 { true -> decode(filesystem), _ -> err(filesystem, rc) }
    machine decode(filesystem: @mutable PosixFilesystem) -> |filesystem|::MetadataResult { |raw|::PosixFilesystemTarget::decode_metadata(filesystem) }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::MetadataResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::MetadataResult::Error { kind: kind } }
}

machine posix_filesystem_file(descriptor: i32) -> |filesystem|::File
requires descriptor >= 0
{
    let widened: u64 = descriptor as u64;
    |filesystem|::File { handle: widened + 1 }
}

machine posix_filesystem_descriptor(file: |filesystem|::File) -> i32 {
    transition file.handle > 0 && file.handle <= 2147483648 {
        true -> present(file),
        false -> absent()
    }
    machine present(file: |filesystem|::File) -> i32
    requires file.handle > 0 && file.handle <= 2147483648
    {
        (file.handle - 1) as i32
    }
    machine absent() -> i32 { -1 }
}

// Shared POSIX algorithms consume target-specific geometry and flag values.
machine posix_filesystem_open_with(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, options: |filesystem|::OpenOptions) -> |filesystem|::OpenResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    // O_RDONLY|O_TRUNC would empty the file; refuse before encoding any flag.
    transition |filesystem|::open_options_truncate_conflict(options) {
        true -> (|filesystem|::OpenResult::Error { kind: |filesystem|::ErrorKind::InvalidInput }),
        false -> open(filesystem, path, options)
    }
    machine open(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, options: |filesystem|::OpenOptions) -> |filesystem|::OpenResult {
        filesystem.open_options = options;
        |raw|::PosixFilesystemTarget::encode_open_options(filesystem);
        let fd: i32 = |raw|::PosixFilesystemHost::open_create(path, filesystem.open_flags, 438);
        transition fd >= 0 { true -> ok(fd), _ -> err(filesystem, fd) }
    }
    machine ok(fd: i32) -> |filesystem|::OpenResult
    requires fd >= 0
    {
        |filesystem|::OpenResult::Ok { file: posix_filesystem_file(fd) }
    }
    machine err(filesystem: @mutable PosixFilesystem, fd: i32) -> |filesystem|::OpenResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, fd); |filesystem|::OpenResult::Error { kind: kind } }
}

machine posix_filesystem_directory_record(filesystem: @PosixFilesystem, offset: u64, total: u64) -> |records|::DirectoryRecord {
    transition total <= 512 { true -> decode(filesystem, offset, total), false -> |records|::DirectoryRecord::Malformed }
    machine decode(filesystem: @PosixFilesystem, offset: u64, total: u64) -> |records|::DirectoryRecord
    requires total <= 512
    {
        |records|::directory_record(@filesystem.dir_buf[0..total], offset,
            |raw|::PosixFilesystemTarget::directory_type_offset(), |raw|::PosixFilesystemTarget::directory_name_offset())
    }
}

data PosixDirectoryItem {
    case Error(kind: |filesystem|::ErrorKind);
    case End;
    case Child(name_start: u64, name_length: u64, dtype: u8);
}

machine posix_filesystem_start_directory(filesystem: @mutable PosixFilesystem) {
    filesystem.rd_position = 0;
    filesystem.record_offset = 0;
    filesystem.batch_length = 0;
}

// An ordinary name stays in dir_buf until the next read. Counting and checking
// emptiness need only its presence. Indexed lookup also consumes its bytes.
machine posix_filesystem_next_child(filesystem: @mutable PosixFilesystem, fd: i32) -> PosixDirectoryItem
reaches |authority|::DirectoryEnumeration
{
    transition { _ -> walk(filesystem, fd) }
    machine walk(filesystem: @mutable PosixFilesystem, fd: i32) -> PosixDirectoryItem {
        transition filesystem.record_offset < filesystem.batch_length {
            true -> record(filesystem, fd), false -> read(filesystem, fd)
        }
    }
    machine read(filesystem: @mutable PosixFilesystem, fd: i32) -> PosixDirectoryItem {
        let total: i64 = |raw|::PosixFilesystemHost::read_dir(fd, @mutable filesystem.dir_buf[..], 512, @mutable filesystem.rd_position);
        transition total > 0 { true -> batch(filesystem, fd, total), false -> end(filesystem, total) }
    }
    machine batch(filesystem: @mutable PosixFilesystem, fd: i32, total: i64) -> PosixDirectoryItem
    requires total > 0
    {
        filesystem.record_offset = 0;
        filesystem.batch_length = total as u64;
        transition { _ -> record(filesystem, fd) }
    }
    machine end(filesystem: @mutable PosixFilesystem, total: i64) -> PosixDirectoryItem {
        transition total == 0 { true -> PosixDirectoryItem::End, false -> failed(filesystem, total) }
    }
    machine failed(filesystem: @mutable PosixFilesystem, total: i64) -> PosixDirectoryItem {
        filesystem.rda_rc = |numeric|::narrow_i64_to_i32_wrapping(total);
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, total);
        PosixDirectoryItem::Error { kind: kind }
    }
    machine record(filesystem: @mutable PosixFilesystem, fd: i32) -> PosixDirectoryItem {
        let offset: u64 = filesystem.record_offset;
        let total: u64 = filesystem.batch_length;
        let entry: |records|::DirectoryRecord = posix_filesystem_directory_record(filesystem, offset, total);
        transition entry {
            |records|::DirectoryRecord::Malformed -> malformed(filesystem),
            |records|::DirectoryRecord::Dot { next } -> skip(filesystem, fd, next),
            |records|::DirectoryRecord::Child { next, name_start, name_length, dtype } -> found(filesystem, next, name_start, name_length, dtype)
        }
    }
    machine skip(filesystem: @mutable PosixFilesystem, fd: i32, next: u64) -> PosixDirectoryItem {
        filesystem.record_offset = next;
        transition { _ -> walk(filesystem, fd) }
    }
    machine found(filesystem: @mutable PosixFilesystem, next: u64, start: u64, length: u64, dtype: u8) -> PosixDirectoryItem {
        filesystem.record_offset = next;
        PosixDirectoryItem::Child { name_start: start, name_length: length, dtype: dtype }
    }
    machine malformed(filesystem: @mutable PosixFilesystem) -> PosixDirectoryItem {
        filesystem.rda_rc = -5;
        filesystem.err_kind = |filesystem|::ErrorKind::Other;
        PosixDirectoryItem::Error { kind: |filesystem|::ErrorKind::Other }
    }
}

machine posix_filesystem_read_dir_count(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::DirectoryEnumeration
{
    posix_filesystem_scan_names(filesystem, path, false)
}

machine posix_filesystem_scan_names(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, first_only: bool) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::DirectoryEnumeration
{
    posix_filesystem_start_directory(filesystem);
    let fd: i32 = |raw|::PosixFilesystemHost::open(path, 0);
    transition fd >= 0 { true -> scan(filesystem, fd, first_only), false -> failed(filesystem, fd) }
    machine failed(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::IoResult {
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc);
        |filesystem|::IoResult::Error { kind: kind }
    }
    machine scan(filesystem: @mutable PosixFilesystem, fd: i32, first_only: bool) -> |filesystem|::IoResult {
        let outcome: |filesystem|::IoResult = names(filesystem, fd, first_only, 0);
        let closed: i32 = |raw|::PosixFilesystemHost::close(fd);
        transition outcome {
            |filesystem|::IoResult::Error { kind } -> (|filesystem|::IoResult::Error { kind: kind }),
            |filesystem|::IoResult::Ok { count } -> finish(filesystem, closed, count)
        }
    }
    machine finish(filesystem: @mutable PosixFilesystem, closed: i32, count: u64) -> |filesystem|::IoResult {
        transition closed == 0 { true -> (|filesystem|::IoResult::Ok { count: count }), false -> failed(filesystem, closed) }
    }
    machine names(filesystem: @mutable PosixFilesystem, fd: i32, first_only: bool, count: u64) -> |filesystem|::IoResult {
        let entry: PosixDirectoryItem = posix_filesystem_next_child(filesystem, fd);
        transition entry {
            PosixDirectoryItem::Error { kind } -> (|filesystem|::IoResult::Error { kind: kind }),
            PosixDirectoryItem::End -> (|filesystem|::IoResult::Ok { count: count }),
            PosixDirectoryItem::Child { name_start, name_length, dtype } -> child(filesystem, fd, first_only, count)
        }
    }
    machine child(filesystem: @mutable PosixFilesystem, fd: i32, first_only: bool, count: u64) -> |filesystem|::IoResult {
        transition first_only { true -> (|filesystem|::IoResult::Ok { count: 1 }), false -> increment(filesystem, fd, count) }
    }
    machine increment(filesystem: @mutable PosixFilesystem, fd: i32, count: u64) -> |filesystem|::IoResult {
        transition count < 18446744073709551615 {
            true -> names(filesystem, fd, false, count + 1),
            false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::Other })
        }
    }
}

// Both public enumeration and recursive deletion use the same name-filtering
// record reader. POSIX does not promise that dot entries precede ordinary names.
machine posix_filesystem_read_dir_nth(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, n: u64) -> |filesystem|::DirEntryResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::DirectoryEnumeration + |authority|::FilesystemMetadataQuery
{
    let descriptor: i32 = |raw|::PosixFilesystemHost::open(path, 0);
    transition descriptor >= 0 { true -> read(filesystem, descriptor, n), _ -> failed(filesystem, descriptor) }
    machine read(filesystem: @mutable PosixFilesystem, descriptor: i32, n: u64) -> |filesystem|::DirEntryResult {
        let result: |filesystem|::DirEntryResult = posix_filesystem_read_dir_entry_fd(filesystem, descriptor, n);
        let closed: i32 = |raw|::PosixFilesystemHost::close(descriptor);
        transition closed == 0 { true -> result, _ -> failed(filesystem, closed) }
    }
    machine failed(filesystem: @mutable PosixFilesystem, result: i32) -> |filesystem|::DirEntryResult {
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, result);
        |filesystem|::DirEntryResult::Error { kind: kind }
    }
}

machine posix_filesystem_read_dir_entry_fd(filesystem: @mutable PosixFilesystem, dfd: i32, n: u64) -> |filesystem|::DirEntryResult
reaches |authority|::DirectoryEnumeration + |authority|::FilesystemMetadataQuery

{
    filesystem.directory_descriptor = dfd;
    posix_filesystem_start_directory(filesystem);
    let seek_rc: i64 = |raw|::PosixFilesystemHost::seek(dfd, 0, 0);
    transition seek_rc >= 0 { true -> read(filesystem, dfd, n), false -> rdef_err(filesystem, seek_rc) }
    machine read(filesystem: @mutable PosixFilesystem, dfd: i32, remaining: u64) -> |filesystem|::DirEntryResult {
        let entry: PosixDirectoryItem = posix_filesystem_next_child(filesystem, dfd);
        transition entry {
            PosixDirectoryItem::Error { kind } -> (|filesystem|::DirEntryResult::Error { kind: kind }),
            PosixDirectoryItem::End -> |filesystem|::DirEntryResult::End,
            PosixDirectoryItem::Child { name_start, name_length, dtype } -> child(filesystem, dfd, remaining, name_start, name_length, dtype)
        }
    }
    machine rdef_err(filesystem: @mutable PosixFilesystem, total: i64) -> |filesystem|::DirEntryResult {
        filesystem.rda_rc = |numeric|::narrow_i64_to_i32_wrapping(total);
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, total);
        |filesystem|::DirEntryResult::Error { kind: kind }
    }
    machine child(filesystem: @mutable PosixFilesystem, dfd: i32, remaining: u64, start: u64, length: u64, dtype: u8) -> |filesystem|::DirEntryResult {
        transition remaining > 0 { true -> read(filesystem, dfd, remaining - 1), false -> take(filesystem, start, length, dtype) }
    }
    machine take(filesystem: @mutable PosixFilesystem, start: u64, length: u64, dtype: u8) -> |filesystem|::DirEntryResult {
        filesystem.rd_dtype = dtype;
        filesystem.rd_j = length;
        transition start < 512 && length <= 255 { true -> copy(filesystem, start, length, 0), false -> rdef_malformed(filesystem) }
    }
    machine copy(filesystem: @mutable PosixFilesystem, start: u64, length: u64, at: u64) -> |filesystem|::DirEntryResult
    requires start < 512 && length <= 255
    {
        transition at < length { true -> byte(filesystem, start, length, at), false -> finish(filesystem, length) }
    }
    machine byte(filesystem: @mutable PosixFilesystem, start: u64, length: u64, at: u64) -> |filesystem|::DirEntryResult
    requires start < 512 && length <= 255 && at < length
    {
        let index: u64 = start + at;
        transition index < 512 { true -> store(filesystem, start, length, at, index), false -> rdef_malformed(filesystem) }
    }
    machine store(filesystem: @mutable PosixFilesystem, start: u64, length: u64, at: u64, index: u64) -> |filesystem|::DirEntryResult
    requires start < 512 && length <= 255 && at < length && index < 512
    {
        filesystem.entry_name[at] = filesystem.dir_buf[index];
        transition { _ -> copy(filesystem, start, length, at + 1) }
    }
    machine finish(filesystem: @mutable PosixFilesystem, length: u64) -> |filesystem|::DirEntryResult
    requires length <= 255
    {
        filesystem.entry_name[length] = 0;
        rdef_build(filesystem)
    }
    machine rdef_build(filesystem: @mutable PosixFilesystem) -> |filesystem|::DirEntryResult {
        // DT_UNKNOWN is an absent optimization hint, never a file kind. Query
        // relative to the same open directory and inspect the symlink itself.
        transition filesystem.rd_dtype == 0 { true -> rdef_unknown(filesystem), _ -> rdef_known(filesystem) }
    }
    machine rdef_unknown(filesystem: @mutable PosixFilesystem) -> |filesystem|::DirEntryResult {
        let name_length: u64 = filesystem.rd_j;
        transition name_length < 256 { true -> rdef_metadata(filesystem, name_length), _ -> rdef_malformed(filesystem) }
    }
    machine rdef_metadata(filesystem: @mutable PosixFilesystem, name_length: u64) -> |filesystem|::DirEntryResult
        requires name_length <= 255
    {
        let outcome: i32 = |raw|::PosixFilesystemHost::read_metadata_at(filesystem.directory_descriptor,
            @filesystem.entry_name[0..name_length], @mutable filesystem.stat_buf,
            |raw|::PosixFilesystemTarget::metadata_no_follow_flag());
        transition outcome == 0 { true -> rdef_classify(filesystem), _ -> rdef_err(filesystem, outcome as i64) }
    }
    machine rdef_classify(filesystem: @mutable PosixFilesystem) -> |filesystem|::DirEntryResult {
        let kind: PosixDirectoryKind = |raw|::PosixFilesystemTarget::decode_directory_kind(filesystem);
        transition kind {
            PosixDirectoryKind::Directory -> rdef_ok_dir(filesystem),
            PosixDirectoryKind::Regular -> rdef_ok_file(filesystem),
            PosixDirectoryKind::Other -> rdef_ok_other(filesystem)
        }
    }
    machine rdef_known(filesystem: @mutable PosixFilesystem) -> |filesystem|::DirEntryResult {
        transition filesystem.rd_dtype == 4 { true -> rdef_ok_dir(filesystem), _ -> rdef_maybe_file(filesystem) }
    }
    machine rdef_ok_dir(filesystem: @mutable PosixFilesystem) -> |filesystem|::DirEntryResult {
        let name_len: u64 = filesystem.rd_j;
        |filesystem|::DirEntryResult::Ok { entry: |filesystem|::DirEntry { name: filesystem.entry_name, name_len: name_len, is_dir: true, is_file: false } }
    }
    machine rdef_maybe_file(filesystem: @mutable PosixFilesystem) -> |filesystem|::DirEntryResult {
        transition filesystem.rd_dtype == 8 { true -> rdef_ok_file(filesystem), _ -> rdef_ok_other(filesystem) }
    }
    machine rdef_ok_file(filesystem: @mutable PosixFilesystem) -> |filesystem|::DirEntryResult {
        let name_len: u64 = filesystem.rd_j;
        |filesystem|::DirEntryResult::Ok { entry: |filesystem|::DirEntry { name: filesystem.entry_name, name_len: name_len, is_dir: false, is_file: true } }
    }
    machine rdef_ok_other(filesystem: @mutable PosixFilesystem) -> |filesystem|::DirEntryResult {
        let name_len: u64 = filesystem.rd_j;
        |filesystem|::DirEntryResult::Ok { entry: |filesystem|::DirEntry { name: filesystem.entry_name, name_len: name_len, is_dir: false, is_file: false } }
    }
    machine rdef_malformed(filesystem: @mutable PosixFilesystem) -> |filesystem|::DirEntryResult {
        filesystem.rda_rc = 0 - 5;
        filesystem.err_kind = |filesystem|::ErrorKind::Other;
        |filesystem|::DirEntryResult::Error { kind: |filesystem|::ErrorKind::Other }
    }
}

machine posix_filesystem_remove_dir_all(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::DirectoryEnumeration + |authority|::FilesystemMetadataQuery
{
    // Never follow a final symlink, including a child replaced between its
    // directory record and openat. A rejected root must not drain its target.
    // The open-directory stack belongs to this call, like Windows' handle
    // frames: both families allow 4096 nested levels and no step budget, so a
    // wide tree is never cut off part-way.
    let mutable stack: [i32; 4096];
    filesystem.read_flags = |raw|::PosixFilesystemTarget::directory_descent_flags();
    let dfd: i32 = |raw|::PosixFilesystemHost::open(path, filesystem.read_flags);
    transition dfd >= 0 { true -> rda_run(filesystem, @mutable stack, dfd, path), _ -> rda_err(filesystem, @mutable stack, path, dfd) }
    machine rda_run(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], dfd: i32, path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult {

        filesystem.rda_depth = 1;
        stack[0] = dfd;
        let drained: i32 = posix_filesystem_rda_drain(filesystem, stack);
        filesystem.rda_rc = drained;
        transition drained == 0 { true -> rda_rmdir(filesystem, stack, path), _ -> rda_err(filesystem, stack, path, drained) }
    }
    machine rda_rmdir(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult {
        let rc: i32 = |raw|::PosixFilesystemHost::remove_dir(path);
        transition rc == 0 { true -> rda_ok(), _ -> rda_err(filesystem, stack, path, rc) }
    }
    machine rda_ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }

    machine rda_err(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], path: @[u8] in |paths|::Path, result: i32) -> |filesystem|::UnitResult {
        // A failed walk owns every directory still on the stack. Stop on the
        // first failure and close them, rather than retrying and leaking opens.
        posix_filesystem_release_directory_stack(filesystem, stack, 4096);
        let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, result);
        |filesystem|::UnitResult::Error { kind: kind }
    }
}

// Each step removes one entry, descends, ascends or fails. The walk runs until
// the tree is empty or a step fails; it promises no termination of its own,
// since another process may keep adding entries.
machine posix_filesystem_rda_drain(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096]) -> i32
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::DirectoryEnumeration + |authority|::FilesystemMetadataQuery
{
    posix_filesystem_rda_step(filesystem, stack, 0);
    transition filesystem.rda_verdict == 1 { true -> posix_filesystem_rda_drain(filesystem, stack), _ -> rdd_settle(filesystem) }
    machine rdd_settle(filesystem: @mutable PosixFilesystem) -> i32 {
        transition filesystem.rda_verdict == 0 { true -> rdd_done(), _ -> rdd_fail(filesystem) }
    }
    machine rdd_done() -> i32 { 0 }
    machine rdd_fail(filesystem: @mutable PosixFilesystem) -> i32 { filesystem.rda_verdict }
}

machine posix_filesystem_rda_step(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], step: u64)
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::DirectoryEnumeration + |authority|::FilesystemMetadataQuery

{
    filesystem.rda_rc = 0 - 5;
    transition filesystem.rda_depth == 0 { true -> rds_alldone(filesystem), _ -> rds_read(filesystem, stack) }

    machine rds_alldone(filesystem: @mutable PosixFilesystem) { filesystem.rda_verdict = 0; }

    machine rds_read(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096]) {

        transition filesystem.rda_depth >= 1 && filesystem.rda_depth - 1 >= 0 && filesystem.rda_depth - 1 < 4096 {
            true -> rds_read_go(filesystem, stack),
            _ -> rds_fail(filesystem)
        }
    }
    machine rds_read_go(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096])
    requires
        filesystem.rda_depth >= 1
    requires
        filesystem.rda_depth - 1 >= 0
    requires
        filesystem.rda_depth - 1 < 4096
    {
        filesystem.rda_fd = stack[filesystem.rda_depth - 1];

        let fd: i32 = filesystem.rda_fd;
        let result: |filesystem|::DirEntryResult = posix_filesystem_read_dir_entry_fd(filesystem, fd, 0);
        transition result {
            |filesystem|::DirEntryResult::End -> rds_pop(filesystem, stack),
            |filesystem|::DirEntryResult::Ok { entry } -> rds_entry(filesystem, stack, entry),
            |filesystem|::DirEntryResult::Error { kind } -> rds_fail(filesystem)
        }
    }

    machine rds_pop(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096]) {
        filesystem.rda_close_rc = |raw|::PosixFilesystemHost::close(filesystem.rda_fd);
        transition filesystem.rda_depth >= 1 { true -> rds_pop_go(filesystem, stack), _ -> rds_fail(filesystem) }
    }
    machine rds_pop_go(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096])
    requires filesystem.rda_depth >= 1
    {
        filesystem.rda_depth = filesystem.rda_depth - 1;
        transition filesystem.rda_close_rc == 0 { true -> rds_popped(filesystem, stack), _ -> rds_close_failed(filesystem, stack) }
    }
    machine rds_close_failed(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096]) {
        // The descriptor has already been released from our stack. Do not
        // retry close: the OS may have reused it even when close reports error.
        filesystem.rda_rc = filesystem.rda_close_rc;
        transition { _ -> rds_fail(filesystem) }
    }
    machine rds_popped(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096]) {
        transition filesystem.rda_depth == 0 { true -> rds_continue(filesystem), _ -> rds_parent(filesystem, stack) }
    }
    machine rds_parent(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096]) {
        transition filesystem.rda_depth >= 1 && filesystem.rda_depth - 1 >= 0 && filesystem.rda_depth - 1 < 4096 {
            true -> rds_parent_go(filesystem, stack),
            _ -> rds_fail(filesystem)
        }
    }
    machine rds_parent_go(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096])
    requires
        filesystem.rda_depth >= 1
    requires
        filesystem.rda_depth - 1 >= 0
    requires
        filesystem.rda_depth - 1 < 4096
    {
        filesystem.rda_fd = stack[filesystem.rda_depth - 1];

        let fd: i32 = filesystem.rda_fd;
        let result: |filesystem|::DirEntryResult = posix_filesystem_read_dir_entry_fd(filesystem, fd, 0);
        transition result {
            |filesystem|::DirEntryResult::Ok { entry } -> rds_rm_child(filesystem, stack, entry),
            |filesystem|::DirEntryResult::End -> rds_continue(filesystem),
            |filesystem|::DirEntryResult::Error { kind } -> rds_fail(filesystem)
        }
    }
    machine rds_rm_child(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], entry: |filesystem|::DirEntry) {
        transition entry.name_len < 256 { true -> rds_rm_child_go(filesystem, stack, entry, entry.name_len), _ -> rds_fail(filesystem) }
    }
    machine rds_rm_child_go(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], entry: |filesystem|::DirEntry, name_len: u64)
        requires name_len <= 255
    {
        filesystem.rda_rc = |raw|::PosixFilesystemHost::unlink_at(filesystem.rda_fd, @entry.name[0..name_len], |raw|::PosixFilesystemTarget::remove_directory_flag());
        transition filesystem.rda_rc == 0 { true -> rds_continue(filesystem), _ -> rds_fail(filesystem) }
    }

    machine rds_entry(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], entry: |filesystem|::DirEntry) {
        transition entry.name_len < 256 { true -> rds_kind(filesystem, stack, entry, entry.name_len), _ -> rds_fail(filesystem) }
    }
    machine rds_kind(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], entry: |filesystem|::DirEntry, name_len: u64)
        requires name_len <= 255
    {
        transition entry.is_dir {
            true -> rds_descend(filesystem, stack, entry, name_len),
            false -> rds_unlink(filesystem, stack, entry, name_len)
        }
    }
    machine rds_unlink(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], entry: |filesystem|::DirEntry, name_len: u64)
        requires name_len <= 255
    {
        filesystem.rda_rc = |raw|::PosixFilesystemHost::unlink_at(filesystem.rda_fd, @entry.name[0..name_len], 0);
        transition filesystem.rda_rc == 0 { true -> rds_continue(filesystem), _ -> rds_fail(filesystem) }
    }
    machine rds_descend(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], entry: |filesystem|::DirEntry, name_len: u64)
        requires name_len <= 255
    {
        filesystem.rda_sub = |raw|::PosixFilesystemHost::open_at(filesystem.rda_fd, @entry.name[0..name_len], filesystem.read_flags);
        filesystem.rda_rc = filesystem.rda_sub;
        transition filesystem.rda_sub >= 0 { true -> rds_push(filesystem, stack), _ -> rds_fail(filesystem) }
    }
    machine rds_push(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096]) {
        transition filesystem.rda_depth < 4096 { true -> rds_push_go(filesystem, stack), _ -> rds_full(filesystem, stack) }
    }
    machine rds_full(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096]) {
        let closed: i32 = |raw|::PosixFilesystemHost::close(filesystem.rda_sub);
        filesystem.rda_rc = -24;
        transition { _ -> rds_fail(filesystem) }
    }
    machine rds_push_go(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096])
    requires filesystem.rda_depth < 4096
    {
        stack[filesystem.rda_depth] = filesystem.rda_sub;
        filesystem.rda_depth = filesystem.rda_depth + 1;
        transition true { true -> rds_continue(filesystem), _ -> rds_fail(filesystem) }
    }

    machine rds_continue(filesystem: @mutable PosixFilesystem) { filesystem.rda_verdict = 1; }
    machine rds_fail(filesystem: @mutable PosixFilesystem) { filesystem.rda_verdict = filesystem.rda_rc; }
}

machine posix_filesystem_release_directory_stack(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], remaining: u64)
requires remaining <= 4096
terminates by remaining
{
    transition remaining > 0 { true -> entry(filesystem, stack, remaining), _ -> done(filesystem) }
    machine entry(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], remaining: u64)
        requires remaining >= 1 && remaining <= 4096
    terminates by remaining
    {
        let index: u64 = remaining - 1;
        transition index < 4096 { true -> present(filesystem, stack, index), _ -> done(filesystem) }
    }
    machine present(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], index: u64)
        requires index <= 4095
    terminates by index
    {
        transition index < filesystem.rda_depth { true -> close(filesystem, stack, index), _ -> next(filesystem, stack, index) }
    }
    machine close(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], index: u64)
        requires index <= 4095
    terminates by index
    {
        let descriptor: i32 = stack[index];
        let closed: i32 = |raw|::PosixFilesystemHost::close(descriptor);
        transition { _ -> next(filesystem, stack, index) }
    }
    machine next(filesystem: @mutable PosixFilesystem, stack: @mutable [i32; 4096], remaining: u64)
        requires remaining <= 4095
    terminates by remaining
    {
        transition { _ -> posix_filesystem_release_directory_stack(filesystem, stack, remaining) }
    }
    machine done(filesystem: @mutable PosixFilesystem) { filesystem.rda_depth = 0; }
}

machine posix_filesystem_read_at(filesystem: @mutable PosixFilesystem, file: |filesystem|::File, buffer: @mutable [u8], count: u64, offset: i64) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentRead
{
    transition count <= buffer.length {
        true -> transfer(filesystem, file, buffer, count, offset),
        false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::InvalidInput })
    }
    machine transfer(filesystem: @mutable PosixFilesystem, file: |filesystem|::File, buffer: @mutable [u8], count: u64, offset: i64) -> |filesystem|::IoResult {
        filesystem.file_fd = posix_filesystem_descriptor(file);
        let n: i64 = |raw|::PosixFilesystemHost::read_at(filesystem.file_fd, buffer, count, offset);
        transition n >= 0 { true -> ok(n), _ -> err(filesystem, n) }
    }
    machine ok(n: i64) -> |filesystem|::IoResult
    requires n >= 0
    {
        let converted_count: u64 = n as u64;
        |filesystem|::IoResult::Ok { count: converted_count }
    }
    machine err(filesystem: @mutable PosixFilesystem, n: i64) -> |filesystem|::IoResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, n); |filesystem|::IoResult::Error { kind: kind } }
}

machine posix_filesystem_write_at(filesystem: @mutable PosixFilesystem, file: |filesystem|::File, bytes: @[u8], offset: i64) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentWrite
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let n: i64 = |raw|::PosixFilesystemHost::write_at(filesystem.file_fd, bytes, offset);
    transition n >= 0 { true -> ok(n), _ -> err(filesystem, n) }
    machine ok(n: i64) -> |filesystem|::IoResult
    requires n >= 0
    {
        let converted_count: u64 = n as u64;
        |filesystem|::IoResult::Ok { count: converted_count }
    }
    machine err(filesystem: @mutable PosixFilesystem, n: i64) -> |filesystem|::IoResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, n); |filesystem|::IoResult::Error { kind: kind } }
}

machine posix_filesystem_hard_link(filesystem: @mutable PosixFilesystem, original: @[u8] in |paths|::Path, link: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemNamespaceMutation
{
    let rc: i32 = |raw|::PosixFilesystemHost::hard_link(original, link);
    transition rc == 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_set_times(filesystem: @mutable PosixFilesystem, file: |filesystem|::File, accessed: i64, modified: i64) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation
{
    filesystem.times_buf[0] = |numeric|::narrow_i64_to_u8_wrapping(accessed);
    filesystem.times_buf[1] = |numeric|::narrow_i64_to_u8_wrapping(accessed >> 8);
    filesystem.times_buf[2] = |numeric|::narrow_i64_to_u8_wrapping(accessed >> 16);
    filesystem.times_buf[3] = |numeric|::narrow_i64_to_u8_wrapping(accessed >> 24);
    filesystem.times_buf[4] = |numeric|::narrow_i64_to_u8_wrapping(accessed >> 32);
    filesystem.times_buf[5] = |numeric|::narrow_i64_to_u8_wrapping(accessed >> 40);
    filesystem.times_buf[6] = |numeric|::narrow_i64_to_u8_wrapping(accessed >> 48);
    filesystem.times_buf[7] = |numeric|::narrow_i64_to_u8_wrapping(accessed >> 56);
    filesystem.times_buf[16] = |numeric|::narrow_i64_to_u8_wrapping(modified);
    filesystem.times_buf[17] = |numeric|::narrow_i64_to_u8_wrapping(modified >> 8);
    filesystem.times_buf[18] = |numeric|::narrow_i64_to_u8_wrapping(modified >> 16);
    filesystem.times_buf[19] = |numeric|::narrow_i64_to_u8_wrapping(modified >> 24);
    filesystem.times_buf[20] = |numeric|::narrow_i64_to_u8_wrapping(modified >> 32);
    filesystem.times_buf[21] = |numeric|::narrow_i64_to_u8_wrapping(modified >> 40);
    filesystem.times_buf[22] = |numeric|::narrow_i64_to_u8_wrapping(modified >> 48);
    filesystem.times_buf[23] = |numeric|::narrow_i64_to_u8_wrapping(modified >> 56);
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::set_file_times(filesystem.file_fd, @filesystem.times_buf);
    transition rc == 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_canonicalize(filesystem: @mutable PosixFilesystem, path: @[u8] in |paths|::Path, buffer: @mutable [u8]) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataQuery
{
    let rc: i64 = posix_canonicalize(path, buffer);
    transition rc > 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i64) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i64(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_lock(filesystem: @mutable PosixFilesystem, file: |filesystem|::File) -> |filesystem|::UnitResult
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::lock_file(filesystem.file_fd, 2);
    transition rc == 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_lock_shared(filesystem: @mutable PosixFilesystem, file: |filesystem|::File) -> |filesystem|::UnitResult
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::lock_file(filesystem.file_fd, 1);
    transition rc == 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

machine posix_filesystem_try_lock(filesystem: @mutable PosixFilesystem, file: |filesystem|::File) -> |filesystem|::TryLockResult
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::lock_file(filesystem.file_fd, 6);
    filesystem.lock_errno = posix_filesystem_native_error_code_i32(filesystem, rc);
    transition rc == 0 { true -> acquired(), _ -> contended(filesystem, rc) }
    machine acquired() -> |filesystem|::TryLockResult { |filesystem|::TryLockResult::Acquired }
    machine contended(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::TryLockResult { transition filesystem.lock_errno == |raw|::PosixFilesystemTarget::would_block_error() { true -> would_block(), _ -> failed(filesystem, rc) } }
    machine would_block() -> |filesystem|::TryLockResult { |filesystem|::TryLockResult::WouldBlock }
    machine failed(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::TryLockResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::TryLockResult::Error { kind: kind } }
}

machine posix_filesystem_try_lock_shared(filesystem: @mutable PosixFilesystem, file: |filesystem|::File) -> |filesystem|::TryLockResult
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::lock_file(filesystem.file_fd, 5);
    filesystem.lock_errno = posix_filesystem_native_error_code_i32(filesystem, rc);
    transition rc == 0 { true -> acquired(), _ -> contended(filesystem, rc) }
    machine acquired() -> |filesystem|::TryLockResult { |filesystem|::TryLockResult::Acquired }
    machine contended(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::TryLockResult { transition filesystem.lock_errno == |raw|::PosixFilesystemTarget::would_block_error() { true -> would_block(), _ -> failed(filesystem, rc) } }
    machine would_block() -> |filesystem|::TryLockResult { |filesystem|::TryLockResult::WouldBlock }
    machine failed(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::TryLockResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::TryLockResult::Error { kind: kind } }
}

machine posix_filesystem_unlock(filesystem: @mutable PosixFilesystem, file: |filesystem|::File) -> |filesystem|::UnitResult
{
    filesystem.file_fd = posix_filesystem_descriptor(file);
    let rc: i32 = |raw|::PosixFilesystemHost::lock_file(filesystem.file_fd, 8);
    transition rc == 0 { true -> ok(), _ -> err(filesystem, rc) }
    machine ok() -> |filesystem|::UnitResult { |filesystem|::UnitResult::Ok }
    machine err(filesystem: @mutable PosixFilesystem, rc: i32) -> |filesystem|::UnitResult { let kind: |filesystem|::ErrorKind = posix_filesystem_last_error_i32(filesystem, rc); |filesystem|::UnitResult::Error { kind: kind } }
}

// realpath resolves all components into private PATH_MAX storage. The portable
// caller's view is copied only after the resulting extent is checked.
boundary trait PosixCanonicalLibc {
    machine resolve(path: @[u8; 4096], output: @mutable [u8; 4096]) -> u64
    reaches |authority|::FilesystemMetadataQuery
    crashes none;
}

// libc keeps `errno` in the calling thread's storage and exposes it only as
// the address `__errno_location` (glibc) or `___error` (libSystem) returns.
// The requirement admits that address as a shared view of the thread's `int`
// slot, so system reads it as a checked reference instead of handing a bare
// address to a copy routine. Any later libc call may overwrite the slot, so
// `posix_errno` copies the value out before the view's loan ends and keeps no
// view across another call.
boundary trait PosixErrno {
    machine slot() -> @i32
    reaches none
    crashes none;
}

// The `errno` of the libc call that just failed, read through the admitted view.
machine posix_errno() -> i32 {
    posix_errno_value(PosixErrno::slot())
}

machine posix_errno_value(slot: @i32) -> i32 { $slot }
// `PosixCanonicalLibc` requirements are bound by Build rows in the system package
// (`system/build.omg`); no provider machine forwards them.
machine posix_canonicalize(path: @[u8] in |paths|::Path, output: @mutable [u8]) -> i64
reaches |authority|::FilesystemMetadataQuery

{
    let mutable terminated: [u8; 4096];
    let mutable resolved: [u8; 4096];
    let fits: bool = |raw|::posix_terminated_path(path as - |paths|::Path, @mutable terminated[..]);
    transition fits { true -> resolve(terminated, resolved, output), false -> failed() }
    machine resolve(terminated: [u8; 4096], resolved: [u8; 4096], output: @mutable [u8]) -> i64 {
        let mutable source: [u8; 4096] = terminated;
        let mutable destination: [u8; 4096] = resolved;
        let result: u64 = PosixCanonicalLibc::resolve(@source, @mutable destination);
        transition result != 0 { true -> count(destination, output, 0), false -> os_error() }
    }
    machine count(resolved: [u8; 4096], output: @mutable [u8], index: u64) -> i64 {
        transition index < 4096 {
            true -> inspect(resolved, output, index),
            false -> failed()
        }
    }
    machine inspect(resolved: [u8; 4096], output: @mutable [u8], index: u64) -> i64
    requires index < 4096
    {
        transition resolved[index] == 0 {
            true -> capacity(resolved, output, index),
            false -> count(resolved, output, index + 1)
        }
    }
    machine capacity(resolved: [u8; 4096], output: @mutable [u8], length: u64) -> i64 {
        transition length < output.length {
            true -> copy(resolved, output, length, 0),
            false -> small_output()
        }
    }
    machine copy(resolved: [u8; 4096], output: @mutable [u8], length: u64, index: u64) -> i64 {
        transition index <= length && index < 4096 && index < output.length {
            true -> store(resolved, output, length, index),
            false -> (1)
        }
    }
    machine store(resolved: [u8; 4096], output: @mutable [u8], length: u64, index: u64) -> i64
    requires index < 4096, index < output.length
    {
        output[index] = resolved[index];
        transition { _ -> copy(resolved, output, length, index + 1) }
    }
    machine small_output() -> i64 { -34 }
    machine os_error() -> i64 { posix_canonical_error() }
    // This is our storage bound, not the target's ENAMETOOLONG value.
    // ERANGE is 34 on both supported POSIX targets.
    machine failed() -> i64 { -34 }
}

// The negated `errno` of a failed realpath. No ambient error slot survives
// the portable call.
machine posix_canonical_error() -> i64 {
    let code: i64 = |numeric|::widen_i32_to_i64(posix_errno());
    0 - code
}
