use time_host.omg as time_host;
use targets/macos_arm64/time_host_impl.omg as raw_time;
use {omega}/language/core/numeric_conversion.omg as numeric;

public DarwinTimeHost satisfies |time_host|::TimeHost {
    machine monotonic_ticks() -> u64
    reaches |time_host|::TimeHost
    invokes |raw_time|::DarwinTimeRead
    {
        |raw_time|::DarwinTimeRead::clock_nanoseconds(8)
    }

    machine monotonic_ticks_per_second() -> u64
    {
        1000000000
    }

    machine wall_clock_raw() -> u64
    reaches |time_host|::TimeHost
    invokes |raw_time|::DarwinTimeRead
    {
        |raw_time|::DarwinTimeRead::clock_nanoseconds(0)
    }

    machine wall_clock_units_per_second() -> u64
    {
        1000000000
    }

    machine wall_clock_epoch_offset_seconds() -> u64
    {
        0
    }

    // Split large waits into signed-representable poll timeouts.
    machine sleep(milliseconds: u32)
    reaches |time_host|::TimeHost
    invokes |raw_time|::DarwinTimeRead
    blocks
    {
        transition milliseconds > 2147483647 {
            true -> block in_parts(milliseconds),
            _ -> block at_once(milliseconds)
        }

        machine at_once(milliseconds: u32) {
            block |raw_time|::darwin_time_host_wait_part(|numeric|::narrow_u32_to_i32_wrapping(milliseconds));
        }

        machine in_parts(milliseconds: u32) {
            let third: i32 = |numeric|::narrow_u32_to_i32_wrapping(milliseconds / 3);
            block |raw_time|::darwin_time_host_wait_part(third);
            block |raw_time|::darwin_time_host_wait_part(third);
            block |raw_time|::darwin_time_host_wait_part(third);
            block |raw_time|::darwin_time_host_wait_part(|numeric|::narrow_u32_to_i32_wrapping(milliseconds % 3));
        }
    }
}
