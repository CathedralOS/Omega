use filesystem.omg;
use posix_filesystem_adapter.omg as adapter;
use posix_filesystem_host.omg as raw_fs;
use {omega}/language/core/layout.omg;
use {omega}/language/core/numeric_conversion.omg as numeric;

// Linux AArch64 ABI facts for the shared POSIX portable service. The kernel's
// asm-generic/stat.h record is 128 bytes, aligned to 8: nlink and blksize are
// 32-bit fields, unlike x86-64. Its reserved tail is not a birth timestamp.
// Source: Linux v6.12 include/uapi/asm-generic/{stat,fcntl,errno-base,errno}.h;
// glibc's AArch64 libc.abilist assigns these three imports GLIBC_2.17.

data LinuxArm64StatRecord {
    dev: u64;
    mode: u32;
    nlink: u32;
    ino: u64;
    uid: u32;
    gid: u32;
    rdev: u64;
    atime: i64;
    mtime: i64;
    ctime: i64;
    size: i64;
    blocks: i64;
    blksize: i32;
}
// The portable scratch slot is 144 bytes; only its first 128 bytes are the
// native stat record. Retain the remaining bytes in this private whole-slot
// view without changing the native record's selected layout.
data LinuxArm64StatView {
    value: |layout|::LayoutStorage<LinuxArm64StatRecord, LinuxArm64StatLayout>;
    scratch_tail: [u8; 16];
}

LinuxArm64StatLayout satisfies |layout|::FixedLayout<LinuxArm64StatRecord> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan
    reaches none
    terminates {
    let mutable entries: [|layout|::FieldEntry; 64];
    entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
    entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 16 } };
    entries[2] = |layout|::FieldEntry { key: schema.fields[2].key, representation: |layout|::FieldPlan::At { offset: 20 } };
    entries[3] = |layout|::FieldEntry { key: schema.fields[3].key, representation: |layout|::FieldPlan::At { offset: 8 } };
    entries[4] = |layout|::FieldEntry { key: schema.fields[4].key, representation: |layout|::FieldPlan::At { offset: 24 } };
    entries[5] = |layout|::FieldEntry { key: schema.fields[5].key, representation: |layout|::FieldPlan::At { offset: 28 } };
    entries[6] = |layout|::FieldEntry { key: schema.fields[6].key, representation: |layout|::FieldPlan::At { offset: 32 } };
    entries[7] = |layout|::FieldEntry { key: schema.fields[7].key, representation: |layout|::FieldPlan::At { offset: 72 } };
    entries[8] = |layout|::FieldEntry { key: schema.fields[8].key, representation: |layout|::FieldPlan::At { offset: 88 } };
    entries[9] = |layout|::FieldEntry { key: schema.fields[9].key, representation: |layout|::FieldPlan::At { offset: 104 } };
    entries[10] = |layout|::FieldEntry { key: schema.fields[10].key, representation: |layout|::FieldPlan::At { offset: 48 } };
    entries[11] = |layout|::FieldEntry { key: schema.fields[11].key, representation: |layout|::FieldPlan::At { offset: 64 } };
    entries[12] = |layout|::FieldEntry { key: schema.fields[12].key, representation: |layout|::FieldPlan::At { offset: 56 } };
    |layout|::LayoutPlan { entries: entries, entry_count: 13, size_fixed: 128, size_is_dynamic: false, align: 8 }
}
}

machine linux_arm64_posix_decode_metadata(filesystem: @mutable |adapter|::PosixFilesystem) -> |filesystem|::MetadataResult
    satisfies |raw_fs|::PosixFilesystemTarget::decode_metadata {
    let stat: @LinuxArm64StatView = @filesystem.stat_buf as @LinuxArm64StatView;
    let blocks: i64 = stat.value.blocks;
    let blksize: i64 = stat.value.blksize as i64;
    transition blocks >= 0 && blksize >= 0 {
        true -> decode(stat, blocks, blksize),
        _ -> |filesystem|::MetadataResult::Error { kind: |filesystem|::ErrorKind::InvalidInput }
    }
    machine decode(stat: @LinuxArm64StatView, blocks: i64, blksize: i64) -> |filesystem|::MetadataResult
    requires blocks >= 0 && blksize >= 0
    {
        let mode: u32 = stat.value.mode;
        let details: |filesystem|::PosixMetadata = |filesystem|::PosixMetadata {
            mode: mode,
            ino: stat.value.ino,
            dev: stat.value.dev,
            uid: stat.value.uid,
            gid: stat.value.gid,
            rdev: stat.value.rdev,
            blocks: |numeric|::narrow_i64_to_u64_exact(blocks),
            blksize: |numeric|::narrow_i64_to_u64_exact(blksize),
        };
        let metadata: |filesystem|::Metadata = |filesystem|::Metadata {
            length: stat.value.size,
            kind: |adapter|::posix_metadata_kind(mode),
            permissions: |filesystem|::Permissions::Posix { mode: mode & 4095 },
            nlink: stat.value.nlink as u64,
            posix: |filesystem|::PosixMetadataResult::Ok { details: details },
            modified_secs: stat.value.mtime,
            accessed_secs: stat.value.atime,
            creation_time: |filesystem|::TimestampResult::Error { kind: |filesystem|::ErrorKind::Unsupported },
            changed_secs: stat.value.ctime,
        };
        |filesystem|::MetadataResult::Ok { meta: metadata }
    }
}

machine linux_arm64_posix_permission_bits(filesystem: @|adapter|::PosixFilesystem) -> u32
    satisfies |raw_fs|::PosixFilesystemTarget::permission_bits {
    let stat: @LinuxArm64StatView = @filesystem.stat_buf as @LinuxArm64StatView;
    stat.value.mode & 4095
}

machine linux_arm64_posix_encode_open_options(filesystem: @mutable |adapter|::PosixFilesystem)
    satisfies |raw_fs|::PosixFilesystemTarget::encode_open_options {
    filesystem.open_writable = |adapter|::posix_flag_bit(filesystem.open_options.write) | |adapter|::posix_flag_bit(filesystem.open_options.append);
    filesystem.open_readable = |adapter|::posix_flag_bit(filesystem.open_options.read);
    filesystem.open_creating = |adapter|::posix_flag_bit(filesystem.open_options.create) | |adapter|::posix_flag_bit(filesystem.open_options.create_new);
    filesystem.open_flags = ((filesystem.open_writable & (filesystem.open_readable ^ 1))
        | ((filesystem.open_writable & filesystem.open_readable) << 1)
        | (|adapter|::posix_flag_bit(filesystem.open_options.append) << 10)
        | (filesystem.open_creating << 6)
        | (|adapter|::posix_flag_bit(filesystem.open_options.truncate) << 9)
        | (|adapter|::posix_flag_bit(filesystem.open_options.create_new) << 7));
}

// Resolve an absent directory hint from the native mode without decoding
// unrelated size/timestamp fields or following a final symlink.
machine linux_arm64_posix_decode_directory_kind(filesystem: @mutable |adapter|::PosixFilesystem) -> |adapter|::PosixDirectoryKind
    satisfies |raw_fs|::PosixFilesystemTarget::decode_directory_kind {
    let stat: @LinuxArm64StatView = @filesystem.stat_buf as @LinuxArm64StatView;
    let kind: u32 = stat.value.mode & 61440;
    transition kind {
        16384 -> |adapter|::PosixDirectoryKind::Directory,
        32768 -> |adapter|::PosixDirectoryKind::Regular,
        _ -> |adapter|::PosixDirectoryKind::Other
    }
}
machine linux_arm64_posix_metadata_no_follow_flag() -> i32
    satisfies |raw_fs|::PosixFilesystemTarget::metadata_no_follow_flag { 256 }

machine linux_arm64_posix_directory_type_offset() -> u64
    satisfies |raw_fs|::PosixFilesystemTarget::directory_type_offset
    ensures result >= 18 && result <= 20
{ 18 }
machine linux_arm64_posix_directory_name_offset() -> u64
    satisfies |raw_fs|::PosixFilesystemTarget::directory_name_offset
    ensures result >= 19 && result <= 21
{ 19 }
machine linux_arm64_posix_remove_directory_flag() -> i32
    satisfies |raw_fs|::PosixFilesystemTarget::remove_directory_flag { 512 }
machine linux_arm64_posix_directory_descent_flags() -> i32
    satisfies |raw_fs|::PosixFilesystemTarget::directory_descent_flags { 49152 }
machine linux_arm64_posix_would_block_error() -> i32
    satisfies |raw_fs|::PosixFilesystemTarget::would_block_error { 11 }

// The PosixCanonicalLibc requirements are bound in system's Build machine.

machine linux_arm64_posix_kind_of_stored_error_code(filesystem: @mutable |adapter|::PosixFilesystem) -> |filesystem|::ErrorKind
    satisfies |raw_fs|::PosixFilesystemTarget::kind_of_stored_error_code {
    filesystem.err_kind = match filesystem.err_code {
        2 -> |filesystem|::ErrorKind::NotFound,
        13 -> |filesystem|::ErrorKind::PermissionDenied,
        1 -> |filesystem|::ErrorKind::PermissionDenied,
        17 -> |filesystem|::ErrorKind::AlreadyExists,
        9 -> |filesystem|::ErrorKind::BadDescriptor,
        20 -> |filesystem|::ErrorKind::InvalidInput,
        21 -> |filesystem|::ErrorKind::IsADirectory,
        11 -> |filesystem|::ErrorKind::WouldBlock,
        22 -> |filesystem|::ErrorKind::InvalidInput,
        34 -> |filesystem|::ErrorKind::InvalidInput,
        36 -> |filesystem|::ErrorKind::InvalidInput,
        38 -> |filesystem|::ErrorKind::Unsupported,
        95 -> |filesystem|::ErrorKind::Unsupported,
        _ -> |filesystem|::ErrorKind::Other
    };
    |filesystem|::error_kind_reconstruct(@filesystem.err_kind)
}

// The linux_arm64 record layouts and constants. system's Build selects them for linux_arm64.
LinuxArm64PosixFilesystemTarget satisfies |raw_fs|::PosixFilesystemTarget {
    |raw_fs|::PosixFilesystemTarget::decode_metadata = linux_arm64_posix_decode_metadata;
    |raw_fs|::PosixFilesystemTarget::permission_bits = linux_arm64_posix_permission_bits;
    |raw_fs|::PosixFilesystemTarget::encode_open_options = linux_arm64_posix_encode_open_options;
    |raw_fs|::PosixFilesystemTarget::decode_directory_kind = linux_arm64_posix_decode_directory_kind;
    |raw_fs|::PosixFilesystemTarget::metadata_no_follow_flag = linux_arm64_posix_metadata_no_follow_flag;
    |raw_fs|::PosixFilesystemTarget::directory_type_offset = linux_arm64_posix_directory_type_offset;
    |raw_fs|::PosixFilesystemTarget::directory_name_offset = linux_arm64_posix_directory_name_offset;
    |raw_fs|::PosixFilesystemTarget::remove_directory_flag = linux_arm64_posix_remove_directory_flag;
    |raw_fs|::PosixFilesystemTarget::directory_descent_flags = linux_arm64_posix_directory_descent_flags;
    |raw_fs|::PosixFilesystemTarget::would_block_error = linux_arm64_posix_would_block_error;
    |raw_fs|::PosixFilesystemTarget::kind_of_stored_error_code = linux_arm64_posix_kind_of_stored_error_code;
}
