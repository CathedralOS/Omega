reaches FilesystemNamespaceMutation
{
    let mutable first: [u8; 4096];
    let mutable second: [u8; 4096];
    let first_fits: bool = |raw_fs|::posix_terminated_path(original as - |paths|::Path, @mutable first[..]);
    let second_fits: bool = |raw_fs|::posix_terminated_path(link as - |paths|::Path, @mutable second[..]);
    let outcome: i32 = PosixFilesystemLinux::linkat(-100, @first, -100, @second, 0);
    transition first_fits && second_fits {
        true -> settle(outcome),
        _ -> (-36)
    }

    machine settle(outcome: i32) -> i32 {
        outcome
    }
}

machine linux_arm64_posix_symlink(target: @[u8] in |paths|::Path, link: @[u8] in |paths|::Path) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::symlink
reaches FilesystemNamespaceMutation
{
    let mutable first: [u8; 4096];
    let mutable second: [u8; 4096];
    let first_fits: bool = |raw_fs|::posix_terminated_path(target as - |paths|::Path, @mutable first[..]);
    let second_fits: bool = |raw_fs|::posix_terminated_path(link as - |paths|::Path, @mutable second[..]);
    let outcome: i32 = PosixFilesystemLinux::symlinkat(@first, -100, @second);
    transition first_fits && second_fits {
        true -> settle(outcome),
        _ -> (-36)
    }

    machine settle(outcome: i32) -> i32 {
        outcome
    }
}

machine linux_arm64_posix_read_link(path: @[u8] in |paths|::Path, buffer: @mutable [u8], count: u64) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::read_link
reaches FilesystemMetadataQuery
{
    let mutable terminated: [u8; 4096];
    let fits: bool = |raw_fs|::posix_terminated_path(path as - |paths|::Path, @mutable terminated[..]);
    transition fits { true -> transfer(terminated, buffer, count), _ -> -36 }
    machine transfer(terminated: [u8; 4096], buffer: @mutable [u8], count: u64) -> i64 {
        // readlinkat's bufsiz is a signed int, not an arbitrary staging limit.
        let capacity: u64 = min_u64(min_u64(count, buffer.length), 2147483647);
        PosixFilesystemLinuxArm64ByteViews::readlinkat(-100, @terminated, @mutable buffer[0..capacity])
    }
}

machine linux_arm64_posix_read_dir(fd: i32, buffer: @mutable [u8], count: u64, position: @mutable i64) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::read_dir
reaches DirectoryEnumeration
{
    // The directory callback's remaining-count field is a signed int.
    let capacity: u64 = min_u64(min_u64(count, buffer.length), 2147483647);
    PosixFilesystemLinuxArm64ByteViews::getdents64(fd, @mutable buffer[0..capacity])
}

