    let fits: bool = |raw_fs|::posix_terminated_path(path as - |paths|::Path, @mutable terminated[..]);
    let outcome: i32 = PosixFilesystemLinux::openat(-100, @terminated, flags, mode);
    transition fits {
        true -> settle(outcome),
