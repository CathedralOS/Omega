machine linux_arm64_posix_read(fd: i32, buffer: @mutable [u8], count: u64) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::read
reaches FilesystemContentRead
{
    let capacity: u64 = min_u64(count, buffer.length);
    PosixFilesystemLinuxArm64ByteViews::read(fd, @mutable buffer[0..capacity])
}

machine linux_arm64_posix_write(fd: i32, bytes: @[u8]) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::write
reaches FilesystemContentWrite
{
    PosixFilesystemLinuxArm64ByteViews::write(fd, bytes)
}

machine linux_arm64_posix_read_at(fd: i32, buffer: @mutable [u8], count: u64, offset: i64) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::read_at
reaches FilesystemContentRead
{
    let capacity: u64 = min_u64(count, buffer.length);
    PosixFilesystemLinuxArm64ByteViews::pread64(fd, @mutable buffer[0..capacity], offset)
}

machine linux_arm64_posix_write_at(fd: i32, bytes: @[u8], offset: i64) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::write_at
reaches FilesystemContentWrite
{
    PosixFilesystemLinuxArm64ByteViews::pwrite64(fd, bytes, offset)
}

