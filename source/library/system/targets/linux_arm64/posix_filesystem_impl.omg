use posix_filesystem_host.omg as raw_fs;
use filesystem_host.omg as paths;
use calling.omg as abi;
use posix_byte_view_calling.omg as byte_views;
use targets\linux_x86_64\PosixFilesystemLinux;
use omega\language\core\FilesystemContentRead;
use omega\language\core\FilesystemContentWrite;
use omega\language\core\FilesystemMetadataQuery;
use omega\language\core\FilesystemMetadataMutation;
use omega\language\core\DirectoryEnumeration;
use omega\language\core\FilesystemNamespaceMutation;
// Linux arm64 POSIX filesystem service: the same kernel-shaped
// requirements and adapters as linux_x86_64 (`targets/linux_x86_64/
// posix_filesystem_impl.omg`), satisfied with arm64 system call numbers.
use omega\language\core\min_u64;

// This native requirement application fixes its kernel calling convention.
boundary trait PosixFilesystemLinuxArm64ByteViews: |abi|::Calling<|byte_views|::LinuxArm64ByteViewCalling> {
    machine read(fd: i32, buffer: @mutable [u8]) -> i64 reaches FilesystemContentRead crashes none;
    machine write(fd: i32, bytes: @[u8]) -> i64 reaches FilesystemContentWrite crashes none;
    machine pread64(fd: i32, buffer: @mutable [u8], offset: i64) -> i64 reaches FilesystemContentRead crashes none;
    machine pwrite64(fd: i32, bytes: @[u8], offset: i64) -> i64 reaches FilesystemContentWrite crashes none;
    machine readlinkat(dirfd: i32, path: @[u8; 4096], buffer: @mutable [u8]) -> i64 reaches FilesystemMetadataQuery crashes none;
    machine getdents64(fd: i32, buffer: @mutable [u8]) -> i64 reaches DirectoryEnumeration crashes none;
}

// Linux arm64 writes its 128-byte kernel stat record. The caller lends that
// complete checked window rather than the first byte of a larger view.
boundary trait PosixFilesystemLinuxArm64Metadata {
    // The kernel writes its 128-byte record into the front of system's shared
    // 144-byte stat buffer (`PosixFilesystem::stat_buf`).
    machine newfstatat(dirfd: i32, path: @[u8; 4096], buffer: @mutable [u8; 144], flags: i32) -> i32
    reaches FilesystemMetadataQuery
    crashes none;
    machine fstat(fd: i32, buffer: @mutable [u8; 144]) -> i32
    reaches FilesystemMetadataQuery
    crashes none;
}

machine linux_arm64_posix_open(path: @[u8] in |paths|::Path, flags: i32) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::open
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mutable terminated: [u8; 4096];
    let fits: bool = |raw_fs|::posix_terminated_path(path as - |paths|::Path, @mutable terminated[..]);
    let outcome: i32 = PosixFilesystemLinux::openat(-100, @terminated, flags, 0);
    transition fits {
        true -> settle(outcome),
        _ -> (-36)
    }

    machine settle(outcome: i32) -> i32 {
        outcome
    }
}

machine linux_arm64_posix_open_create(path: @[u8] in |paths|::Path, flags: i32, mode: i32) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::open_create
