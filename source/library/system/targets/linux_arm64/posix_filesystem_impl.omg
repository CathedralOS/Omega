machine linux_arm64_posix_read_metadata(path: @[u8] in |paths|::Path, buffer: @mutable [u8; 144]) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::read_metadata
reaches FilesystemMetadataQuery
{
    linux_arm64_posix_query_metadata_at(-100, path as - |paths|::Path, buffer, 0)
}

machine linux_arm64_posix_read_file_metadata(fd: i32, buffer: @mutable [u8; 144]) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::read_file_metadata
reaches FilesystemMetadataQuery
{
    query(fd, buffer)
    machine query(fd: i32, buffer: @mutable [u8; 144]) -> i32 {
        PosixFilesystemLinuxArm64Metadata::fstat(fd, buffer)
    }
}

machine linux_arm64_posix_read_symlink_metadata(path: @[u8] in |paths|::Path, buffer: @mutable [u8; 144]) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::read_symlink_metadata
reaches FilesystemMetadataQuery
{
    linux_arm64_posix_query_metadata_at(-100, path as - |paths|::Path, buffer, 256)
}

machine linux_arm64_posix_read_metadata_at(directory_descriptor: i32, name: @[u8], buffer: @mutable [u8; 144], flags: i32) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::read_metadata_at
reaches FilesystemMetadataQuery
{
    linux_arm64_posix_query_metadata_at(directory_descriptor, name, buffer, flags)
}

machine linux_arm64_posix_query_metadata_at(directory_descriptor: i32, name: @[u8], buffer: @mutable [u8; 144], flags: i32) -> i32
reaches FilesystemMetadataQuery
{
    prepare(directory_descriptor, name, buffer, flags)
    machine prepare(directory_descriptor: i32, name: @[u8], buffer: @mutable [u8; 144], flags: i32) -> i32
    {
        let mutable terminated: [u8; 4096];
        let fits: bool = |raw_fs|::posix_terminated_path(name, @mutable terminated[..]);
        transition fits { true -> query(directory_descriptor, terminated, buffer, flags), _ -> -36 }
    }
    machine query(directory_descriptor: i32, terminated: [u8; 4096], buffer: @mutable [u8; 144], flags: i32) -> i32
    {
        PosixFilesystemLinuxArm64Metadata::newfstatat(directory_descriptor, @terminated, buffer, flags)
    }
}

machine linux_arm64_posix_set_len(fd: i32, length: i64) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::set_len
reaches FilesystemContentWrite + FilesystemMetadataMutation
{
    let outcome: i32 = PosixFilesystemLinux::ftruncate(fd, length);
    outcome
}

machine linux_arm64_posix_set_file_times(fd: i32, times: @[u8; 32]) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::set_file_times
reaches FilesystemMetadataMutation
{
    update(fd, times)
    machine update(fd: i32, times: @[u8; 32]) -> i32 {
        // The raw syscall copies bytes from user storage, without a libc object.
        PosixFilesystemLinux::utimensat(fd, 0, times, 0)
    }
}

