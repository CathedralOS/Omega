use posix_filesystem_adapter.omg as adapter;
use posix_filesystem_host.omg as raw_fs;
use filesystem_host.omg as paths;
use calling.omg as abi;
use posix_byte_view_calling.omg as byte_views;
use DarwinFileTimes;
use posix_errno;
use omega\language\core\FilesystemContentRead;
use omega\language\core\FilesystemContentWrite;
use omega\language\core\FilesystemMetadataQuery;
use omega\language\core\FilesystemMetadataMutation;
use omega\language\core\DirectoryEnumeration;
use omega\language\core\FilesystemNamespaceMutation;
// Complete macos_arm64 `PosixFilesystemHost` provider over libSystem.
// Each operation is an ordinary checked adapter: it terminates paths into
// local buffers, lends caller backing for ordinary read/write transfers,
// calls libSystem, and turns libc's `-1` plus thread-local `errno` into the
// trait's negated `errno`. The imports state libSystem's own parameters
// through system-private requirements, each satisfied by one Mach-O symbol.
//
// `open_create` imports `___open`, the fixed-arity entry behind libc's
// variadic `open`: Apple arm64 passes variadic arguments on the stack, and an
// authored import cannot request that placement yet, so the creation mode
// would otherwise arrive in the wrong place. `open`, `openat` and
// `unlinkat` take no variadic argument without `O_CREAT`, so their ordinary
// entries are called with their fixed arguments only.
//
// `errno` lives in libc's thread-local storage; system reads it through the
// shared `PosixErrno` view that `___error` provides.
use omega\language\core\widen_u8_to_u64;
use omega\language\core\narrow_u32_to_u16_wrapping;
use omega\language\core\narrow_u64_to_i64_wrapping;
use omega\language\core\narrow_i32_to_u16_wrapping;
use omega\language\core\narrow_i32_to_u32_wrapping;
use omega\language\core\narrow_i64_to_i32_wrapping;
use omega\language\core\widen_i32_to_i64;
use omega\language\core\min_u64;

// The explicit policy exports the borrowed view as pointer/count, not one byte.
boundary trait PosixFilesystemDarwinByteViews: |abi|::Calling<|byte_views|::DarwinArm64ByteViewCalling> {
    machine c_read(fd: i32, buffer: @mutable [u8]) -> i64 reaches FilesystemContentRead crashes none;
    machine c_write(fd: i32, bytes: @[u8]) -> i64 reaches FilesystemContentWrite crashes none;
    machine c_read_at(fd: i32, buffer: @mutable [u8], offset: i64) -> i64 reaches FilesystemContentRead crashes none;
    machine c_write_at(fd: i32, bytes: @[u8], offset: i64) -> i64 reaches FilesystemContentWrite crashes none;
    machine c_read_link(path: @[u8; 4096], buffer: @mutable [u8]) -> i64 reaches FilesystemMetadataQuery crashes none;
    machine c_read_dir(fd: i32, buffer: @mutable [u8], position: @mutable i64) -> i64 reaches DirectoryEnumeration crashes none;
}

// Unlike raw Linux byte views, libc consumes an aligned timespec[2]. The
// shared target ABI selects C storage for both complete timestamp elements.
// Decode the caller's packed little-endian bytes without forming an aligned
// native reference to them. All signed bit patterns, including UTIME sentinels,
// survive unchanged; semantic timestamp validation remains the OS's operation.
machine darwin_timestamp_word(bytes: @[u8]) -> i64
requires bytes.length == 8
{
    // Each byte lands in its own eight bits, so `+` assembles the word exactly
    // as `|` would; the Wrapping policy declares `+` and no bitwise operator.
    let word: u64 in Wrapping = (widen_u8_to_u64(bytes[0]) as u64 +Wrapping)
        + ((widen_u8_to_u64(bytes[1]) as u64 +Wrapping) << 8)
        + ((widen_u8_to_u64(bytes[2]) as u64 +Wrapping) << 16)
        + ((widen_u8_to_u64(bytes[3]) as u64 +Wrapping) << 24)
        + ((widen_u8_to_u64(bytes[4]) as u64 +Wrapping) << 32)
        + ((widen_u8_to_u64(bytes[5]) as u64 +Wrapping) << 40)
        + ((widen_u8_to_u64(bytes[6]) as u64 +Wrapping) << 48)
        + ((widen_u8_to_u64(bytes[7]) as u64 +Wrapping) << 56);
    narrow_u64_to_i64_wrapping(word as u64)
}

// Providers call the exact `PosixFilesystemDarwin` leaves; each
// `PosixFilesystemHost` requirement publishes this trait through `invokes`.
boundary trait PosixFilesystemDarwin {
    machine c_open(path: @[u8; 4096], flags: i32) -> i32
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    crashes none;
    machine c_open_create(path: @[u8; 4096], flags: i32, mode: u16) -> i32
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    crashes none;
    machine c_create(path: @[u8; 4096], mode: u16) -> i32
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    crashes none;
    machine c_close(fd: i32) -> i32
    reaches none
    crashes none;
    machine c_remove(path: @[u8; 4096]) -> i32
    reaches FilesystemNamespaceMutation
    crashes none;
    machine c_seek(fd: i32, offset: i64, whence: i32) -> i64
    reaches none
    crashes none;
    machine c_create_dir(path: @[u8; 4096], mode: u16) -> i32
    reaches FilesystemMetadataMutation + FilesystemNamespaceMutation
    crashes none;
    machine c_remove_dir(path: @[u8; 4096]) -> i32
    reaches FilesystemNamespaceMutation
    crashes none;
    machine c_create_dir_name(name: @[u8; 4096], mode: u16) -> i32
    reaches FilesystemMetadataMutation + FilesystemNamespaceMutation
    crashes none;
    machine c_open_at(dirfd: i32, name: @[u8; 4096], flags: i32) -> i32
    reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
    crashes none;
    machine c_unlink_at(dirfd: i32, name: @[u8; 4096], flags: i32) -> i32
    reaches FilesystemNamespaceMutation
    crashes none;
    machine c_set_permissions(path: @[u8; 4096], mode: u16) -> i32
    reaches FilesystemMetadataMutation
    crashes none;
    machine c_set_file_permissions(fd: i32, mode: u16) -> i32
    reaches FilesystemMetadataMutation
    crashes none;
    machine c_rename(from: @[u8; 4096], to: @[u8; 4096]) -> i32
    reaches FilesystemNamespaceMutation
    crashes none;
    machine c_hard_link(original: @[u8; 4096], link: @[u8; 4096]) -> i32
    reaches FilesystemNamespaceMutation
    crashes none;
    machine c_symlink(target: @[u8; 4096], link: @[u8; 4096]) -> i32
    reaches FilesystemNamespaceMutation
    crashes none;
    machine c_remove_name(path: @[u8; 4096]) -> i32
    reaches FilesystemNamespaceMutation
    crashes none;
    machine c_remove_dir_name(path: @[u8; 4096]) -> i32
    reaches FilesystemNamespaceMutation
    crashes none;
    machine c_read_file_metadata(fd: i32, buffer: @mutable [u8; 144]) -> i32
    reaches FilesystemMetadataQuery
    crashes none;
    machine c_read_metadata_at(directory_descriptor: i32, name: @[u8; 4096], buffer: @mutable [u8; 144], flags: i32) -> i32
    reaches FilesystemMetadataQuery
    crashes none;
    machine c_set_len(fd: i32, length: i64) -> i32
    reaches FilesystemContentWrite + FilesystemMetadataMutation
    crashes none;
    machine c_set_file_times(fd: i32, times: @DarwinFileTimes) -> i32
    reaches FilesystemMetadataMutation
    crashes none;
    machine c_sync(fd: i32) -> i32
    reaches none
    crashes none;
    machine c_sync_data(fd: i32) -> i32
    reaches none
    crashes none;
    machine c_duplicate(fd: i32) -> i32
    reaches none
    crashes none;
    machine c_lock_file(fd: i32, operation: i32) -> i32
    reaches none
    crashes none;
    machine c_change_owner(path: @[u8; 4096], uid: u32, gid: u32) -> i32
    reaches FilesystemMetadataMutation
    crashes none;
    machine c_change_owner_no_follow(path: @[u8; 4096], uid: u32, gid: u32) -> i32
    reaches FilesystemMetadataMutation
    crashes none;
    machine c_change_file_owner(fd: i32, uid: u32, gid: u32) -> i32
    reaches FilesystemMetadataMutation
    crashes none;
}
// The negated `errno` of the call that just failed, read through system's
// shared `PosixErrno` view of the thread's slot.
machine darwin_failure_i32() -> i32
{
    let code: i64 = widen_i32_to_i64(|adapter|::posix_errno());
    narrow_i64_to_i32_wrapping(0 - code)
}

machine darwin_failure_i64() -> i64
{
    let code: i64 = widen_i32_to_i64(|adapter|::posix_errno());
    0 - code
}

// Capture libc errno before restoring caller storage after a native write.
machine darwin_normalize_i64(outcome: i64) -> i64
{
    transition outcome < 0 { true -> darwin_failure_i64(), _ -> outcome }
}

// Darwin `ENAMETOOLONG`, answered without a call when a path does not fit.
machine darwin_name_too_long_i32() -> i32 { -63 }
machine darwin_name_too_long_i64() -> i64 { -63 }

machine macos_arm64_posix_open(path: @[u8] in |paths|::Path, flags: i32) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::open
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mutable terminated: [u8; 4096];
    let fits: bool = |raw_fs|::posix_terminated_path(path as - |paths|::Path, @mutable terminated[..]);
    let outcome: i32 = PosixFilesystemDarwin::c_open(@terminated, flags);
    transition fits {
        true -> settle(outcome),
        _ -> (darwin_name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (darwin_failure_i32()),
            _ -> (outcome)
        }
    }
}

machine macos_arm64_posix_open_create(path: @[u8] in |paths|::Path, flags: i32, mode: i32) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::open_create
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mutable terminated: [u8; 4096];
    let fits: bool = |raw_fs|::posix_terminated_path(path as - |paths|::Path, @mutable terminated[..]);
    let outcome: i32 = PosixFilesystemDarwin::c_open_create(@terminated, flags, narrow_i32_to_u16_wrapping(mode));
    transition fits {
        true -> settle(outcome),
        _ -> (darwin_name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (darwin_failure_i32()),
            _ -> (outcome)
        }
    }
}

machine macos_arm64_posix_create(path: @[u8] in |paths|::Path, mode: i32) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::create
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation
{
    let mutable terminated: [u8; 4096];
    let fits: bool = |raw_fs|::posix_terminated_path(path as - |paths|::Path, @mutable terminated[..]);
    let outcome: i32 = PosixFilesystemDarwin::c_create(@terminated, narrow_i32_to_u16_wrapping(mode));
    transition fits {
