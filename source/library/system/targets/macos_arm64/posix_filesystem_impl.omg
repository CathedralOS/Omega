}

machine macos_arm64_posix_write_at(fd: i32, bytes: @[u8], offset: i64) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::write_at
reaches FilesystemContentWrite
{
    let outcome: i64 = PosixFilesystemDarwinByteViews::c_write_at(fd, bytes, offset);
