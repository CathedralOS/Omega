}

machine macos_arm64_posix_read_metadata(path: @[u8] in |paths|::Path, buffer: @mutable [u8; 144]) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::read_metadata
reaches FilesystemMetadataQuery
{
    macos_arm64_posix_query_metadata_at(-2, path as - |paths|::Path, buffer, 0)
}

machine macos_arm64_posix_read_file_metadata(fd: i32, buffer: @mutable [u8; 144]) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::read_file_metadata
reaches FilesystemMetadataQuery
{
    query(fd, buffer)
    machine query(fd: i32, buffer: @mutable [u8; 144]) -> i32 {
        let outcome: i32 = PosixFilesystemDarwin::c_read_file_metadata(fd, buffer);
        transition outcome < 0 { true -> darwin_failure_i32(), _ -> outcome }
    }
}

machine macos_arm64_posix_read_symlink_metadata(path: @[u8] in |paths|::Path, buffer: @mutable [u8; 144]) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::read_symlink_metadata
reaches FilesystemMetadataQuery
{
    macos_arm64_posix_query_metadata_at(-2, path as - |paths|::Path, buffer, 32)
}

// The kernel writes one complete native record into caller-owned storage.
// Only path termination needs scratch; undersized output never reaches libc.
machine macos_arm64_posix_read_metadata_at(directory_descriptor: i32, name: @[u8], buffer: @mutable [u8; 144], flags: i32) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::read_metadata_at
reaches FilesystemMetadataQuery
{
    macos_arm64_posix_query_metadata_at(directory_descriptor, name, buffer, flags)
}

machine macos_arm64_posix_query_metadata_at(directory_descriptor: i32, name: @[u8], buffer: @mutable [u8; 144], flags: i32) -> i32
reaches FilesystemMetadataQuery
{
    prepare(directory_descriptor, name, buffer, flags)
    machine prepare(directory_descriptor: i32, name: @[u8], buffer: @mutable [u8; 144], flags: i32) -> i32
    {
        let mutable terminated: [u8; 4096];
        let fits: bool = |raw_fs|::posix_terminated_path(name, @mutable terminated[..]);
        transition fits { true -> query(directory_descriptor, terminated, buffer, flags), _ -> -63 }
    }
    machine query(directory_descriptor: i32, terminated: [u8; 4096], buffer: @mutable [u8; 144], flags: i32) -> i32
    {
        let outcome: i32 = PosixFilesystemDarwin::c_read_metadata_at(directory_descriptor, @terminated, buffer, flags);
        transition outcome < 0 { true -> darwin_failure_i32(), _ -> outcome }
    }
}

machine macos_arm64_posix_set_len(fd: i32, length: i64) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::set_len
reaches FilesystemContentWrite + FilesystemMetadataMutation
{
    let outcome: i32 = PosixFilesystemDarwin::c_set_len(fd, length);
    transition outcome < 0 {
        true -> (darwin_failure_i32()),
        _ -> (outcome)
    }
}

machine macos_arm64_posix_set_file_times(fd: i32, times: @[u8; 32]) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::set_file_times
reaches FilesystemMetadataMutation
{
    update(fd, times)
    machine update(fd: i32, times: @[u8; 32]) -> i32 {
        let mutable native: DarwinFileTimes;
        native[0].seconds = darwin_timestamp_word(@times[0..8]);
        native[0].nanoseconds = darwin_timestamp_word(@times[8..16]);
        native[1].seconds = darwin_timestamp_word(@times[16..24]);
        native[1].nanoseconds = darwin_timestamp_word(@times[24..32]);
        let outcome: i32 = PosixFilesystemDarwin::c_set_file_times(fd, @native);
        transition outcome < 0 { true -> darwin_failure_i32(), _ -> outcome }
    }
}

