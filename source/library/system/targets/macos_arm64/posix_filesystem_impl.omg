machine macos_arm64_posix_read_link(path: @[u8] in |paths|::Path, buffer: @mutable [u8], count: u64) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::read_link
reaches FilesystemMetadataQuery
{
    let mutable terminated: [u8; 4096];
    let fits: bool = |raw_fs|::posix_terminated_path(path as - |paths|::Path, @mutable terminated[..]);
    transition fits { true -> transfer(terminated, buffer, count), _ -> -63 }
    machine transfer(terminated: [u8; 4096], buffer: @mutable [u8], count: u64) -> i64 {
        let capacity: u64 = min_u64(count, buffer.length);
        let outcome: i64 = PosixFilesystemDarwinByteViews::c_read_link(@terminated, @mutable buffer[0..capacity]);
        darwin_normalize_i64(outcome)
    }
}

machine macos_arm64_posix_read_dir(fd: i32, buffer: @mutable [u8], count: u64, position: @mutable i64) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::read_dir
reaches DirectoryEnumeration
{
    let capacity: u64 = min_u64(count, buffer.length);
    transition { _ -> transfer(fd, @mutable buffer[0..capacity], position) }
    machine transfer(fd: i32, buffer: @mutable [u8], position: @mutable i64) -> i64 {
        transition {
            buffer.length >= 1024 -> extended(fd, buffer, position),
            _ -> ordinary(fd, buffer, position)
        }
    }
    machine ordinary(fd: i32, buffer: @mutable [u8], position: @mutable i64) -> i64
    {
        let outcome: i64 = PosixFilesystemDarwinByteViews::c_read_dir(fd, buffer, position);
        darwin_normalize_i64(outcome)
    }
    machine extended(fd: i32, buffer: @mutable [u8], position: @mutable i64) -> i64
    requires buffer.length >= 1024
    {
        // ___getdirentries64 reserves four suffix bytes for private EOF flags
        // at this threshold. Records occupy at most capacity - 4. Preserve the
        // caller's suffix rather than exposing that auxiliary kernel write.
        let first_index: u64 = buffer.length - 4;
        let second_index: u64 = buffer.length - 3;
        let third_index: u64 = buffer.length - 2;
        let fourth_index: u64 = buffer.length - 1;
        let first: u8 = buffer[first_index];
        let second: u8 = buffer[second_index];
        let third: u8 = buffer[third_index];
        let fourth: u8 = buffer[fourth_index];
        let outcome: i64 = PosixFilesystemDarwinByteViews::c_read_dir(fd, buffer, position);
        // Capture errno before restoring bytes, including on a failed read.
        let normalized: i64 = darwin_normalize_i64(outcome);
        buffer[first_index] = first;
        buffer[second_index] = second;
        buffer[third_index] = third;
        buffer[fourth_index] = fourth;
        normalized
    }
}

machine macos_arm64_posix_remove_name(path: @[u8]) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::remove_name
reaches FilesystemNamespaceMutation
{
    let mutable terminated: [u8; 4096];
    let fits: bool = |raw_fs|::posix_terminated_path(path, @mutable terminated[..]);
    let outcome: i32 = PosixFilesystemDarwin::c_remove_name(@terminated);
    transition fits {
        true -> settle(outcome),
        _ -> (darwin_name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (darwin_failure_i32()),
            _ -> (outcome)
        }
    }
}

