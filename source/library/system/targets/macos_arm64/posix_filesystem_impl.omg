machine macos_arm64_posix_rename(from: @[u8] in |paths|::Path, to: @[u8] in |paths|::Path) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::rename
reaches FilesystemNamespaceMutation
{
    let mutable first: [u8; 4096];
    let mutable second: [u8; 4096];
    let first_fits: bool = |raw_fs|::posix_terminated_path(from as - |paths|::Path, @mutable first[..]);
    let second_fits: bool = |raw_fs|::posix_terminated_path(to as - |paths|::Path, @mutable second[..]);
    let outcome: i32 = PosixFilesystemDarwin::c_rename(@first, @second);
    transition first_fits && second_fits {
        true -> settle(outcome),
        _ -> (darwin_name_too_long_i32())
    }

    machine settle(outcome: i32) -> i32 {
        transition outcome < 0 {
            true -> (darwin_failure_i32()),
            _ -> (outcome)
        }
    }
}

