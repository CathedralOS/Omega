        }
    }
}

machine macos_arm64_posix_read(fd: i32, buffer: @mutable [u8], count: u64) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::read
reaches FilesystemContentRead
{
    let capacity: u64 = min_u64(count, buffer.length);
    let outcome: i64 = PosixFilesystemDarwinByteViews::c_read(fd, @mutable buffer[0..capacity]);
    darwin_normalize_i64(outcome)
}

machine macos_arm64_posix_write(fd: i32, bytes: @[u8]) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::write
reaches FilesystemContentWrite
{
    let outcome: i64 = PosixFilesystemDarwinByteViews::c_write(fd, bytes);
    darwin_normalize_i64(outcome)
}

machine macos_arm64_posix_read_at(fd: i32, buffer: @mutable [u8], count: u64, offset: i64) -> i64
    satisfies |raw_fs|::PosixFilesystemHost::read_at
reaches FilesystemContentRead
{
    let capacity: u64 = min_u64(count, buffer.length);
    let outcome: i64 = PosixFilesystemDarwinByteViews::c_read_at(fd, @mutable buffer[0..capacity], offset);
