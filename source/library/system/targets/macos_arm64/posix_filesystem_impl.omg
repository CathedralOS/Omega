machine macos_arm64_posix_close(fd: i32) -> i32
    satisfies |raw_fs|::PosixFilesystemHost::close

{
    let outcome: i32 = PosixFilesystemDarwin::c_close(fd);
    transition outcome < 0 {
        true -> (darwin_failure_i32()),
        _ -> (outcome)
    }
}

