use filesystem.omg;
use posix_filesystem_adapter.omg as adapter;
use posix_filesystem_host.omg as raw_fs;
use {omega}/language/core/layout.omg;
use {omega}/language/core/numeric_conversion.omg as numeric;

// Linux x86-64 ABI facts; the POSIX algorithms live in the shared adapter.

StatLayout satisfies |layout|::FixedLayout<StatRecord> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan
    reaches none
    terminates {
    let mutable entries: [|layout|::FieldEntry; 64];
    entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
    entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 24 } };
    entries[2] = |layout|::FieldEntry { key: schema.fields[2].key, representation: |layout|::FieldPlan::At { offset: 16 } };
    entries[3] = |layout|::FieldEntry { key: schema.fields[3].key, representation: |layout|::FieldPlan::At { offset: 8 } };
    entries[4] = |layout|::FieldEntry { key: schema.fields[4].key, representation: |layout|::FieldPlan::At { offset: 28 } };
    entries[5] = |layout|::FieldEntry { key: schema.fields[5].key, representation: |layout|::FieldPlan::At { offset: 32 } };
    entries[6] = |layout|::FieldEntry { key: schema.fields[6].key, representation: |layout|::FieldPlan::At { offset: 40 } };
    entries[7] = |layout|::FieldEntry { key: schema.fields[7].key, representation: |layout|::FieldPlan::At { offset: 72 } };
    entries[8] = |layout|::FieldEntry { key: schema.fields[8].key, representation: |layout|::FieldPlan::At { offset: 88 } };
    entries[9] = |layout|::FieldEntry { key: schema.fields[9].key, representation: |layout|::FieldPlan::At { offset: 104 } };
    entries[10] = |layout|::FieldEntry { key: schema.fields[10].key, representation: |layout|::FieldPlan::At { offset: 48 } };
    entries[11] = |layout|::FieldEntry { key: schema.fields[11].key, representation: |layout|::FieldPlan::At { offset: 64 } };
    entries[12] = |layout|::FieldEntry { key: schema.fields[12].key, representation: |layout|::FieldPlan::At { offset: 56 } };
    |layout|::LayoutPlan { entries: entries, entry_count: 13, size_fixed: 144, size_is_dynamic: false, align: 8 }
}
}

machine linux_x86_64_posix_encode_open_options(filesystem: @mutable |adapter|::PosixFilesystem)
    satisfies |raw_fs|::PosixFilesystemTarget::encode_open_options {
    filesystem.open_writable = |adapter|::posix_flag_bit(filesystem.open_options.write) | |adapter|::posix_flag_bit(filesystem.open_options.append);
    filesystem.open_readable = |adapter|::posix_flag_bit(filesystem.open_options.read);
    filesystem.open_creating = |adapter|::posix_flag_bit(filesystem.open_options.create) | |adapter|::posix_flag_bit(filesystem.open_options.create_new);
    filesystem.open_flags = ((filesystem.open_writable & (filesystem.open_readable ^ 1))
        | ((filesystem.open_writable & filesystem.open_readable) << 1)
        | (|adapter|::posix_flag_bit(filesystem.open_options.append) << 10)
        | (filesystem.open_creating << 6)
        | (|adapter|::posix_flag_bit(filesystem.open_options.truncate) << 9)
        | (|adapter|::posix_flag_bit(filesystem.open_options.create_new) << 7));
}

data StatRecord {
    dev: u64;
    mode: u32;
    nlink: u64;
    ino: u64;
    uid: u32;
    gid: u32;
    rdev: u64;
    atime: i64;
    mtime: i64;
    ctime: i64;
    size: i64;
    blocks: i64;
    blksize: i64;
}

data StatView {
    value: |layout|::LayoutStorage<StatRecord, StatLayout>;
}

machine linux_x86_64_posix_decode_metadata(filesystem: @mutable |adapter|::PosixFilesystem) -> |filesystem|::MetadataResult
    satisfies |raw_fs|::PosixFilesystemTarget::decode_metadata {
    let stat: @StatView = @filesystem.stat_buf as @StatView;
    let blocks: i64 = stat.value.blocks;
    let blksize: i64 = stat.value.blksize;
    transition blocks >= 0 && blksize >= 0 {
        true -> decode(stat, blocks, blksize),
        _ -> |filesystem|::MetadataResult::Error { kind: |filesystem|::ErrorKind::InvalidInput }
    }
    machine decode(stat: @StatView, block_count: i64, block_size: i64) -> |filesystem|::MetadataResult
    requires block_count >= 0 && block_size >= 0
    {
        let mode: u32 = stat.value.mode;
        let nlink: u64 = stat.value.nlink;
        let ino: u64 = stat.value.ino;
        let uid: u32 = stat.value.uid;
        let gid: u32 = stat.value.gid;
        let dev: u64 = stat.value.dev;
        let rdev: u64 = stat.value.rdev;
        let ctime: i64 = stat.value.ctime;
        let blocks: u64 = |numeric|::narrow_i64_to_u64_exact(block_count);
        let blksize: u64 = |numeric|::narrow_i64_to_u64_exact(block_size);
        let len: i64 = stat.value.size;
        let mtime: i64 = stat.value.mtime;
        let atime: i64 = stat.value.atime;
        // Linux stat has reserved words here, not a birth timestamp.
        let details: |filesystem|::PosixMetadata = |filesystem|::PosixMetadata { mode: mode, ino: ino, dev: dev, uid: uid, gid: gid, rdev: rdev, blocks: blocks, blksize: blksize };
        let metadata: |filesystem|::Metadata = |filesystem|::Metadata {
            length: len,
            kind: |adapter|::posix_metadata_kind(mode),
            permissions: |filesystem|::Permissions::Posix { mode: mode & 4095 },
            nlink: nlink,
            posix: |filesystem|::PosixMetadataResult::Ok { details: details },
            modified_secs: mtime,
            accessed_secs: atime,
            creation_time: |filesystem|::TimestampResult::Error { kind: |filesystem|::ErrorKind::Unsupported },
            changed_secs: ctime
        };
        |filesystem|::MetadataResult::Ok { meta: metadata }
    }
}

machine linux_x86_64_posix_permission_bits(filesystem: @|adapter|::PosixFilesystem) -> u32
    satisfies |raw_fs|::PosixFilesystemTarget::permission_bits {
    let stat: @StatView = @filesystem.stat_buf as @StatView;
    stat.value.mode & 4095
}

// Resolve an absent directory hint from the native mode without decoding
// unrelated size/timestamp fields or following a final symlink.
machine linux_x86_64_posix_decode_directory_kind(filesystem: @mutable |adapter|::PosixFilesystem) -> |adapter|::PosixDirectoryKind
    satisfies |raw_fs|::PosixFilesystemTarget::decode_directory_kind {
    let stat: @StatView = @filesystem.stat_buf as @StatView;
    let kind: u32 = stat.value.mode & 61440;
    transition kind {
        16384 -> |adapter|::PosixDirectoryKind::Directory,
        32768 -> |adapter|::PosixDirectoryKind::Regular,
        _ -> |adapter|::PosixDirectoryKind::Other
    }
}
machine linux_x86_64_posix_metadata_no_follow_flag() -> i32
    satisfies |raw_fs|::PosixFilesystemTarget::metadata_no_follow_flag { 256 }

machine linux_x86_64_posix_directory_type_offset() -> u64
    satisfies |raw_fs|::PosixFilesystemTarget::directory_type_offset
    ensures result >= 18 && result <= 20
{ 18 }
machine linux_x86_64_posix_directory_name_offset() -> u64
    satisfies |raw_fs|::PosixFilesystemTarget::directory_name_offset
    ensures result >= 19 && result <= 21
{ 19 }
machine linux_x86_64_posix_remove_directory_flag() -> i32
    satisfies |raw_fs|::PosixFilesystemTarget::remove_directory_flag { 512 }
machine linux_x86_64_posix_directory_descent_flags() -> i32
    satisfies |raw_fs|::PosixFilesystemTarget::directory_descent_flags { 196608 }

// The PosixCanonicalLibc requirements are bound in system's Build machine.

// Error numbers belong to this OS, not to a synthetic shared POSIX catalog.
machine linux_x86_64_posix_kind_of_stored_error_code(filesystem: @mutable |adapter|::PosixFilesystem) -> |filesystem|::ErrorKind
    satisfies |raw_fs|::PosixFilesystemTarget::kind_of_stored_error_code {
    filesystem.err_kind = match filesystem.err_code {
        2 -> |filesystem|::ErrorKind::NotFound,
        13 -> |filesystem|::ErrorKind::PermissionDenied,
        1 -> |filesystem|::ErrorKind::PermissionDenied,
        17 -> |filesystem|::ErrorKind::AlreadyExists,
        9 -> |filesystem|::ErrorKind::BadDescriptor,
        20 -> |filesystem|::ErrorKind::InvalidInput,
        21 -> |filesystem|::ErrorKind::IsADirectory,
        11 -> |filesystem|::ErrorKind::WouldBlock,
        22 -> |filesystem|::ErrorKind::InvalidInput,
        34 -> |filesystem|::ErrorKind::InvalidInput,
        36 -> |filesystem|::ErrorKind::InvalidInput,
        38 -> |filesystem|::ErrorKind::Unsupported,
        95 -> |filesystem|::ErrorKind::Unsupported,
        _ -> |filesystem|::ErrorKind::Other
    };
    |filesystem|::error_kind_reconstruct(@filesystem.err_kind)
}

machine linux_x86_64_posix_would_block_error() -> i32
    satisfies |raw_fs|::PosixFilesystemTarget::would_block_error { 11 }

// The linux_x86_64 record layouts and constants. system's Build selects them for linux_x86_64.
LinuxX8664PosixFilesystemTarget satisfies |raw_fs|::PosixFilesystemTarget {
    |raw_fs|::PosixFilesystemTarget::encode_open_options = linux_x86_64_posix_encode_open_options;
    |raw_fs|::PosixFilesystemTarget::decode_metadata = linux_x86_64_posix_decode_metadata;
    |raw_fs|::PosixFilesystemTarget::permission_bits = linux_x86_64_posix_permission_bits;
    |raw_fs|::PosixFilesystemTarget::decode_directory_kind = linux_x86_64_posix_decode_directory_kind;
    |raw_fs|::PosixFilesystemTarget::metadata_no_follow_flag = linux_x86_64_posix_metadata_no_follow_flag;
    |raw_fs|::PosixFilesystemTarget::directory_type_offset = linux_x86_64_posix_directory_type_offset;
    |raw_fs|::PosixFilesystemTarget::directory_name_offset = linux_x86_64_posix_directory_name_offset;
    |raw_fs|::PosixFilesystemTarget::remove_directory_flag = linux_x86_64_posix_remove_directory_flag;
    |raw_fs|::PosixFilesystemTarget::directory_descent_flags = linux_x86_64_posix_directory_descent_flags;
    |raw_fs|::PosixFilesystemTarget::kind_of_stored_error_code = linux_x86_64_posix_kind_of_stored_error_code;
    |raw_fs|::PosixFilesystemTarget::would_block_error = linux_x86_64_posix_would_block_error;
}
