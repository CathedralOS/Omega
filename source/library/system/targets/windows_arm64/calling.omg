use calling.omg as abi;
use entry_shapes.omg as shapes;
use posix_byte_view_calling.omg as byte_views;

// Windows ARM64 C calls follow AAPCS64 for fixed arguments: integers and
// pointers take x0-x7 in order, a sixteen-byte view takes two consecutive
// registers (pointer, then count), and an integer result returns in x0. The
// callee preserves x18, which holds the thread environment block. This policy
// admits the same bounded byte-view signatures as the POSIX byte-view policies
// and never places a variadic argument.
// https://learn.microsoft.com/en-us/cpp/build/arm64-windows-abi-conventions
public WindowsArm64ByteViewCalling satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        let mutable plan: |abi|::BoundaryEntryPlan = windows_arm64_call_entry();
        let accepted: bool = |byte_views|::posix_byte_view_parameters(@signature, @mutable plan);
        transition accepted {
            true -> |abi|::BoundaryPlanResult::Accepted { plan: plan },
            _ -> |abi|::BoundaryPlanResult::Rejected {
                reason: |abi|::CallingPolicyRejection { reason: "expected at most six bounded byte views, integer or sized-reference formals, and Unit or integer result" as + |abi|::Utf8 }
            }
        }
    }
}

machine windows_arm64_call_entry() -> |abi|::BoundaryEntryPlan {
    let mutable plan: |abi|::BoundaryEntryPlan;
    plan.call.convention = |abi|::CallingConvention::Aapcs64;
    plan.call.stack_alignment = 16;
    plan.call.entry_control = |abi|::EntryControl::CallReturn;
    plan.call.ordinary_clobbers = |shapes|::hosted_entry_aarch64_platform_clobbers();
    plan.state.initial_regime = |abi|::MachineRegime::Aarch64A64 { exception_level: 0 };
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = |abi|::EntryStack::ProviderSelected;
    plan.state.preemption = |abi|::Preemption::NotApplicable;
    plan
}
