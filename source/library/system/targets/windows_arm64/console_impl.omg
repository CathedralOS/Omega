use calling.omg as abi;
use targets/windows_arm64/calling.omg as windows_arm64_abi;
use windows_console_host.omg;
use {omega}/language/core/process_authority.omg as process;

// The same MSVCRT calls as Windows x86-64, placed by the AAPCS64 rules Windows
// ARM64 uses. `system/build.omg` binds each requirement to its DLL export.
boundary trait WindowsArm64ConsoleIo: |abi|::Calling<|windows_arm64_abi|::WindowsArm64ByteViewCalling> {
    machine write(descriptor: i32, buffer: @mutable i32, count: u32) -> i32
    requires descriptor == 1 && count <= 4
    reaches |process|::StandardOutput
    crashes none;

    machine read(descriptor: i32, buffer: @mutable i32, count: u32) -> i32
    requires descriptor == 0 && count <= 4
    reaches |process|::StandardInput
    blocks
    crashes none;

    machine set_input_mode(descriptor: i32, mode: i32) -> i32
    requires descriptor == 0 && mode == 32768
    reaches |process|::StandardInput
    crashes none;

    machine set_output_mode(descriptor: i32, mode: i32) -> i32
    requires descriptor == 1 && mode == 32768
    reaches |process|::StandardOutput
    crashes none;
}

WindowsArm64ConsoleHost satisfies |windows_console_host|::WindowsConsoleHost {
    machine write(descriptor: i32, buffer: @mutable i32, count: u32) -> i32
    requires descriptor == 1 && count <= 4
    reaches |process|::StandardOutput crashes none {
        WindowsArm64ConsoleIo::write(descriptor, buffer, count)
    }
    machine read(descriptor: i32, buffer: @mutable i32, count: u32) -> i32
    requires descriptor == 0 && count <= 4
    reaches |process|::StandardInput blocks crashes none {
        block WindowsArm64ConsoleIo::read(descriptor, buffer, count)
    }
    machine set_input_mode(descriptor: i32, mode: i32) -> i32
    requires descriptor == 0 && mode == 32768
    reaches |process|::StandardInput crashes none {
        WindowsArm64ConsoleIo::set_input_mode(descriptor, mode)
    }
    machine set_output_mode(descriptor: i32, mode: i32) -> i32
    requires descriptor == 1 && mode == 32768
    reaches |process|::StandardOutput crashes none {
        WindowsArm64ConsoleIo::set_output_mode(descriptor, mode)
    }
}
