use calling.omg as abi;
use entry_shapes.omg as shapes;
use {omega}/language/core/extent.omg as storage;

// Apple's dyld calls appMain(argc, argv, envp, apple) and receives an int:
// https://github.com/apple-oss-distributions/dyld/blob/main/dyld/dyldMain.cpp
// The System V AMD64 realization supplies argc in edi, argv in rsi, envp in
// rdx, apple in rcx, and the completion status back in eax. These raw
// physical addresses introduce neither storage roots nor access authority.
// ProgramStorageEntry remains the separate semantic root crossing; its two
// Extents are internal bridge inputs, not hosted application arguments.
// This calling contract supplies no bridge, loader admission, receiver, or
// numeric stack guarantee. ProviderSelected requires independent backing.
// See :HostedArgumentAuthority in entry_shapes.omg for the handoff to source.
boundary trait MacosX64PhysicalEntry {
    machine enter(argc: i32, argv: addr, envp: addr, apple: addr) -> i32 reaches none crashes Trap crashes Abort;
}

MacosX64CallingPolicy satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        macos_x86_64_entry_plan(signature)
    }
}

machine macos_x86_64_entry_plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult
    satisfies |abi|::CallingPolicy::plan
{
    transition signature.parameter_count {
        4 -> physical(signature),
        2 -> semantic(signature),
        _ -> reject()
    }

    machine physical(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        transition signature.has_result {
            true -> physical_indices(signature, signature.parameters[0],
                signature.parameters[1], signature.parameters[2],
                signature.parameters[3], signature.result),
            _ -> reject()
        }
    }

    machine physical_indices(signature: |abi|::BoundarySignature, argc: u64,
        argv: u64, envp: u64, apple: u64, result: u64) -> |abi|::BoundaryPlanResult
    {
        transition argc < 256 && argv < 256 && envp < 256 && apple < 256
            && result < 256 && argc < signature.shape_count
            && argv < signature.shape_count && envp < signature.shape_count
            && apple < signature.shape_count && result < signature.shape_count
        {
            true -> physical_shapes(signature.shapes[argc], signature.shapes[argv],
                signature.shapes[envp], signature.shapes[apple], signature.shapes[result]),
            _ -> reject()
        }
    }

    machine physical_shapes(argc: |abi|::ValueShape, argv: |abi|::ValueShape, envp: |abi|::ValueShape,
        apple: |abi|::ValueShape, result: |abi|::ValueShape) -> |abi|::BoundaryPlanResult
    {
        transition |shapes|::hosted_entry_integer_shape(@argc, 4)
            && |shapes|::hosted_entry_integer_shape(@argv, 8)
            && |shapes|::hosted_entry_integer_shape(@envp, 8)
            && |shapes|::hosted_entry_integer_shape(@apple, 8)
            && |shapes|::hosted_entry_integer_shape(@result, 4)
        {
            true -> build_physical(),
            _ -> reject()
        }
    }

    machine build_physical() -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan;
        output.call.parameter_count = 4;
        // System V AMD64 integer argument order: edi, rsi, rdx, rcx.
        output.call.parameters[0] = |shapes|::hosted_entry_named_word(4,
            |abi|::MachineRegister::X86Rdi);
        output.call.parameters[1] = |shapes|::hosted_entry_named_word(8,
            |abi|::MachineRegister::X86Rsi);
        output.call.parameters[2] = |shapes|::hosted_entry_named_word(8,
            |abi|::MachineRegister::X86Rdx);
        output.call.parameters[3] = |shapes|::hosted_entry_named_word(8,
            |abi|::MachineRegister::X86Rcx);
        output.call.has_result = true;
        output.call.result = |shapes|::hosted_entry_named_word(4, |abi|::MachineRegister::X86Rax);
        transition { _ -> finish(output) }
    }

    machine semantic(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        transition signature.has_result {
            false -> semantic_indices(signature, signature.parameters[0], signature.parameters[1]),
            _ -> reject()
        }
    }

    machine semantic_indices(signature: |abi|::BoundarySignature, image: u64,
        storage: u64) -> |abi|::BoundaryPlanResult
    {
        transition image < 256 && storage < 256
            && image < signature.shape_count && storage < signature.shape_count
        {
            true -> semantic_shapes(signature.shapes[image], signature.shapes[storage], signature),
            _ -> reject()
        }
    }

    machine semantic_shapes(image: |abi|::ValueShape, storage: |abi|::ValueShape, signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        transition macos_x86_64_entry_extent_shape(image, @signature) && macos_x86_64_entry_extent_shape(storage, @signature) {
            true -> build_semantic(),
            _ -> reject()
        }
    }

    machine build_semantic() -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan;
        output.call.parameter_count = 2;
        // The generated bridge passes the image and initial-storage roots in
        // the first four System V integer registers.
        output.call.parameters[0] = |shapes|::hosted_entry_register_extent_value(
            |abi|::MachineRegister::X86Rdi, |abi|::MachineRegister::X86Rsi);
        output.call.parameters[1] = |shapes|::hosted_entry_register_extent_value(
            |abi|::MachineRegister::X86Rdx, |abi|::MachineRegister::X86Rcx);
        transition { _ -> finish(output) }
    }

    machine finish(output: |abi|::BoundaryEntryPlan) -> |abi|::BoundaryPlanResult {
        let mutable plan: |abi|::BoundaryEntryPlan = output;
        plan.call.convention = |abi|::CallingConvention::SystemVAMD64;
        plan.call.stack_alignment = 16;
        plan.call.entry_control = |abi|::EntryControl::CallReturn;
        transition { _ -> seal(plan) }
    }

    machine seal(plan: |abi|::BoundaryEntryPlan) -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan = plan;
        // System V AMD64 caller-saved banks.
        output.call.ordinary_clobbers.register_count = 25;
        output.call.ordinary_clobbers.registers[0] = |abi|::MachineRegister::X86Rax;
        output.call.ordinary_clobbers.registers[1] = |abi|::MachineRegister::X86Rcx;
        output.call.ordinary_clobbers.registers[2] = |abi|::MachineRegister::X86Rdx;
        output.call.ordinary_clobbers.registers[3] = |abi|::MachineRegister::X86Rsi;
        output.call.ordinary_clobbers.registers[4] = |abi|::MachineRegister::X86Rdi;
        output.call.ordinary_clobbers.registers[5] = |abi|::MachineRegister::X86R8;
        output.call.ordinary_clobbers.registers[6] = |abi|::MachineRegister::X86R9;
        output.call.ordinary_clobbers.registers[7] = |abi|::MachineRegister::X86R10;
        output.call.ordinary_clobbers.registers[8] = |abi|::MachineRegister::X86R11;
        output.call.ordinary_clobbers.registers[9] = |abi|::MachineRegister::X86Xmm {
            index: 0
        };
        output.call.ordinary_clobbers.registers[10] = |abi|::MachineRegister::X86Xmm {
            index: 1
        };
        output.call.ordinary_clobbers.registers[11] = |abi|::MachineRegister::X86Xmm {
            index: 2
        };
        output.call.ordinary_clobbers.registers[12] = |abi|::MachineRegister::X86Xmm {
            index: 3
        };
        output.call.ordinary_clobbers.registers[13] = |abi|::MachineRegister::X86Xmm {
            index: 4
        };
        output.call.ordinary_clobbers.registers[14] = |abi|::MachineRegister::X86Xmm {
            index: 5
        };
        output.call.ordinary_clobbers.registers[15] = |abi|::MachineRegister::X86Xmm {
            index: 6
        };
        output.call.ordinary_clobbers.registers[16] = |abi|::MachineRegister::X86Xmm {
            index: 7
        };
        output.call.ordinary_clobbers.registers[17] = |abi|::MachineRegister::X86Xmm {
            index: 8
        };
        output.call.ordinary_clobbers.registers[18] = |abi|::MachineRegister::X86Xmm {
            index: 9
        };
        output.call.ordinary_clobbers.registers[19] = |abi|::MachineRegister::X86Xmm {
            index: 10
        };
        output.call.ordinary_clobbers.registers[20] = |abi|::MachineRegister::X86Xmm {
            index: 11
        };
        output.call.ordinary_clobbers.registers[21] = |abi|::MachineRegister::X86Xmm {
            index: 12
        };
        output.call.ordinary_clobbers.registers[22] = |abi|::MachineRegister::X86Xmm {
            index: 13
        };
        output.call.ordinary_clobbers.registers[23] = |abi|::MachineRegister::X86Xmm {
            index: 14
        };
        output.call.ordinary_clobbers.registers[24] = |abi|::MachineRegister::X86Xmm {
            index: 15
        };
        output.state.initial_regime = |abi|::MachineRegime::X86Long64;
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.vector_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.permitted_transitive_use.instruction_pointer = true;
        output.state.permitted_transitive_use.stack_pointer = true;
        // A returning import's floating-control envelope restores MXCSR/FPCR,
        // which the hosted ABI makes callee-preserved.
        output.state.permitted_transitive_use.control_state = true;
        output.state.stack = |abi|::EntryStack::ProviderSelected;
        output.state.preemption = |abi|::Preemption::NotApplicable;
        |abi|::BoundaryPlanResult::Accepted { plan: output }
    }

    machine reject() -> |abi|::BoundaryPlanResult {
        |abi|::BoundaryPlanResult::Rejected {
            reason: |abi|::CallingPolicyRejection {
                reason: "MacosX64Application requires exact physical or program-storage entry shapes" as + |abi|::Utf8,
            },
        }
    }
}

machine macos_x86_64_entry_extent_shape(shape: |abi|::ValueShape, signature: @|abi|::BoundarySignature) -> bool {
    transition shape.class {
        |abi|::ValueClass::Record { first_field, field_count } -> record(shape, first_field, field_count, signature),
        _ -> no()
    }
    machine record(shape: |abi|::ValueShape, first_field: u64, field_count: u64, signature: @|abi|::BoundarySignature) -> bool {
        transition shape.byte_size == 16 && shape.alignment == 8
            && field_count == 2 && first_field < 255
        {
            true -> field_range(signature, first_field),
            _ -> no()
        }
    }
    machine field_range(signature: @|abi|::BoundarySignature, first_field: u64) -> bool
    requires first_field <= 254
    {
        let second_field: u64 = first_field + 1;
        transition second_field < signature.field_count {
            true -> fields(signature, @signature.fields[first_field], @signature.fields[second_field]),
            _ -> no()
        }
    }
    machine fields(signature: @|abi|::BoundarySignature, base: @|abi|::ValueField, length: @|abi|::ValueField) -> bool {
        transition base.byte_offset == 0 && length.byte_offset == 8
            && base.shape < 256 && length.shape < 256
            && base.shape < signature.shape_count && length.shape < signature.shape_count
        {
            true -> words(@signature.shapes[base.shape], @signature.shapes[length.shape]),
            _ -> no()
        }
    }
    machine words(base: @|abi|::ValueShape, length: @|abi|::ValueShape) -> bool {
        |shapes|::hosted_entry_integer_shape(base, 8) && |shapes|::hosted_entry_integer_shape(length, 8)
    }
    machine no() -> bool { false }
}

boundary trait MacosX64Application: |storage|::ProgramStorageEntry + MacosX64PhysicalEntry + |abi|::Calling<MacosX64CallingPolicy> {}
