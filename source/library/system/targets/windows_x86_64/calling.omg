use calling.omg as abi;

// Fixed Microsoft x64 calls with up to four scalar or sized-reference formals.
// Stack arguments, narrow register scalars and callbacks require a richer policy.
WindowsX64ScalarCalling satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        let mutable plan: |abi|::BoundaryEntryPlan = windows_x64_call_entry();
        let accepted: bool = windows_x64_scalar_signature(@signature, @mutable plan);
        transition accepted {
            true -> |abi|::BoundaryPlanResult::Accepted { plan: plan },
            _ -> |abi|::BoundaryPlanResult::Rejected { reason: |abi|::CallingPolicyRejection {
                reason: "expected at most four 32/64-bit integer or sized-reference parameters, Unit or 32/64-bit integer result, and no callbacks" as + |abi|::Utf8
            } }
        }
    }
}

machine windows_x64_scalar_signature(signature: @|abi|::BoundarySignature,
    plan: @mutable |abi|::BoundaryEntryPlan) -> bool {
    transition signature.parameter_count == signature.native_parameter_count
        && signature.parameter_count <= 4 && signature.callback_binder_count == 0
        && signature.callback_demand_count == 0 {
        true -> completion(signature, plan),
        _ -> false
    }
    machine completion(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan) -> bool
    requires signature.parameter_count <= 4 {
        plan.call.parameter_count = signature.parameter_count;
        transition signature.has_result {
            true -> result_index(signature, plan),
            _ -> windows_x64_scalar_parameters(signature, plan, 0, 4)
        }
    }
    machine result_index(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan) -> bool {
        transition signature.result < signature.shape_count && signature.result < 256 {
            true -> result_shape(signature, plan, @signature.shapes[signature.result]),
            _ -> false
        }
    }
    machine result_shape(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        shape: @|abi|::ValueShape) -> bool {
        transition shape.class {
            |abi|::ValueClass::Integer -> result_integer(signature, plan, shape),
            _ -> false
        }
    }
    machine result_integer(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        shape: @|abi|::ValueShape) -> bool {
        transition (shape.byte_size == 4 || shape.byte_size == 8) && shape.alignment == shape.byte_size {
            true -> result_place(signature, plan, shape),
            _ -> false
        }
    }
    machine result_place(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        shape: @|abi|::ValueShape) -> bool {
        plan.call.has_result = true;
        plan.call.result = windows_x64_register_place(shape.byte_size, |abi|::MachineRegister::X86Rax);
        windows_x64_scalar_parameters(signature, plan, 0, 4)
    }
}

machine windows_x64_scalar_parameters(signature: @|abi|::BoundarySignature,
    plan: @mutable |abi|::BoundaryEntryPlan, ordinal: u64, remaining: u64) -> bool
terminates by remaining {
    transition {
        ordinal == signature.parameter_count -> true,
        ordinal < signature.parameter_count && ordinal < 4 && remaining > 0 ->
            root(signature, plan, ordinal, remaining, signature.parameters[ordinal]),
        _ -> false
    }
    machine root(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        ordinal: u64, remaining: u64, root: u64) -> bool
    requires ordinal < 4, remaining > 0 {
        transition root < signature.shape_count && root < 256 {
            true -> shape(signature, plan, ordinal, remaining, @signature.shapes[root]),
            _ -> false
        }
    }
    machine shape(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        ordinal: u64, remaining: u64, shape: @|abi|::ValueShape) -> bool
    requires ordinal < 4, remaining > 0 {
        transition shape.class {
            |abi|::ValueClass::Integer -> integer(signature, plan, ordinal, remaining, shape),
            |abi|::ValueClass::Reference -> reference(signature, plan, ordinal, remaining, shape),
            _ -> false
        }
    }
    machine integer(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        ordinal: u64, remaining: u64, shape: @|abi|::ValueShape) -> bool
    requires ordinal < 4, remaining > 0 {
        transition (shape.byte_size == 4 || shape.byte_size == 8) && shape.alignment == shape.byte_size {
            true -> place(signature, plan, ordinal, remaining, shape.byte_size),
            _ -> false
        }
    }
    machine reference(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        ordinal: u64, remaining: u64, shape: @|abi|::ValueShape) -> bool
    requires ordinal < 4, remaining > 0 {
        transition shape.byte_size == 8 && shape.alignment == 8 {
            true -> place(signature, plan, ordinal, remaining, 8),
            _ -> false
        }
    }
    machine place(signature: @|abi|::BoundarySignature, plan: @mutable |abi|::BoundaryEntryPlan,
        ordinal: u64, remaining: u64, bytes: u64) -> bool
    requires ordinal < 4, remaining > 0 {
        plan.call.parameters[ordinal] = windows_x64_register_place(bytes,
            windows_x64_scalar_argument_register(ordinal));
        windows_x64_scalar_parameters(signature, plan, ordinal + 1, remaining - 1)
    }
}

machine windows_x64_scalar_argument_register(ordinal: u64) -> |abi|::MachineRegister
requires ordinal < 4 {
    transition ordinal {
        0 -> |abi|::MachineRegister::X86Rcx,
        1 -> |abi|::MachineRegister::X86Rdx,
        2 -> |abi|::MachineRegister::X86R8,
        _ -> |abi|::MachineRegister::X86R9
    }
}

machine windows_x64_call_entry() -> |abi|::BoundaryEntryPlan {
    let mutable plan: |abi|::BoundaryEntryPlan;
    plan.call.convention = |abi|::CallingConvention::MicrosoftX64;
    plan.call.stack_alignment = 16;
    plan.call.shadow_bytes = 32;
    plan.call.entry_control = |abi|::EntryControl::CallReturn;
    plan.call.ordinary_clobbers.registers[0] = |abi|::MachineRegister::X86Rax;
    plan.call.ordinary_clobbers.registers[1] = |abi|::MachineRegister::X86Rcx;
    plan.call.ordinary_clobbers.registers[2] = |abi|::MachineRegister::X86Rdx;
    plan.call.ordinary_clobbers.registers[3] = |abi|::MachineRegister::X86R8;
    plan.call.ordinary_clobbers.registers[4] = |abi|::MachineRegister::X86R9;
    plan.call.ordinary_clobbers.registers[5] = |abi|::MachineRegister::X86R10;
    plan.call.ordinary_clobbers.registers[6] = |abi|::MachineRegister::X86R11;
    plan.call.ordinary_clobbers.registers[7] = |abi|::MachineRegister::X86Xmm { index: 0 };
    plan.call.ordinary_clobbers.registers[8] = |abi|::MachineRegister::X86Xmm { index: 1 };
    plan.call.ordinary_clobbers.registers[9] = |abi|::MachineRegister::X86Xmm { index: 2 };
    plan.call.ordinary_clobbers.registers[10] = |abi|::MachineRegister::X86Xmm { index: 3 };
    plan.call.ordinary_clobbers.registers[11] = |abi|::MachineRegister::X86Xmm { index: 4 };
    plan.call.ordinary_clobbers.registers[12] = |abi|::MachineRegister::X86Xmm { index: 5 };
    plan.call.ordinary_clobbers.register_count = 13;
    plan.state.initial_regime = |abi|::MachineRegime::X86Long64;
    plan.state.permitted_transitive_use.general_registers = true;
    plan.state.permitted_transitive_use.vector_registers = true;
    plan.state.permitted_transitive_use.flags = true;
    plan.state.stack = |abi|::EntryStack::ProviderSelected;
    plan.state.preemption = |abi|::Preemption::NotApplicable;
    plan
}

machine windows_x64_register_place(bytes: u64, register: |abi|::MachineRegister) -> |abi|::ValuePlacement {
    let mutable place: |abi|::ValuePlacement;
    place.shape = |abi|::AbiValueShape { class: |abi|::AbiValueClass::Integer, byte_size: bytes, alignment: bytes };
    place.location_count = 1;
    place.locations[0] = |abi|::ValueLocation::Register {
        register: register, value_byte_offset: 0, byte_size: bytes
    };
    place
}
