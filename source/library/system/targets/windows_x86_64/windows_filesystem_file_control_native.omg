use targets/windows_x86_64/windows_filesystem_metadata_native.omg as metadata_io;
use targets/windows_x86_64/windows_filesystem_native.omg as win_io;
use {omega}/language/core/filesystem_authority.omg as authority;

// Exact metadata updates and cursor-independent file-length changes. Class
// constraints prevent SetFileInformationByHandle from selecting disposition,
// rename or another operation with a broader authority row.
// Owned attribute opens retain anonymous SQOS rather than native impersonation.
// https://learn.microsoft.com/windows/win32/api/fileapi/nf-fileapi-setfileinformationbyhandle

data WindowsNativeFileEndOfFileInfo { length: i64; }

boundary trait WindowsFilesystemFileControlIo {
    machine end_of_file(handle: i64, information_class: u32, input: @WindowsNativeFileEndOfFileInfo, size: u32) -> i32
    requires information_class == 6 && size == 8
    reaches |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation blocks
    crashes none;
    machine basic(handle: i64, information_class: u32, input: @|metadata_io|::WindowsNativeFileBasicInfo, size: u32) -> i32
    requires information_class == 0 && size == 40
    reaches |authority|::FilesystemMetadataMutation blocks
    crashes none;
    machine open_attributes(path: @[u16; 32768] in |win_io|::WindowsNativePath, desired_access: u32, sharing: u32, security: u64, disposition: u32, flags: u32, template: u64) -> i64
    requires desired_access == 384 && sharing == 7 && security == 0 && disposition == 3
        && flags == 34603008 && template == 0
    reaches |authority|::FilesystemMetadataQuery + |authority|::FilesystemMetadataMutation blocks
    crashes none;
}
