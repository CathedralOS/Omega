use filesystem.omg;
use targets/windows_x86_64/filesystem/errors.omg as errors;
use windows_filesystem_host.omg as win_fs;

// Portable locking is ordinary same-object Windows range locking. Only a
// try-acquisition's ERROR_LOCK_VIOLATION denotes contention; invalid handles,
// denied access and unmatched unlocks remain errors. No service reach is added.

machine windows_filesystem_lock(file: |filesystem|::File) -> |filesystem|::UnitResult
{ |errors|::windows_filesystem_unit(block |win_fs|::WindowsFilesystemHost::lock_file(file.handle, true, false)) }

machine windows_filesystem_lock_shared(file: |filesystem|::File) -> |filesystem|::UnitResult
{ |errors|::windows_filesystem_unit(block |win_fs|::WindowsFilesystemHost::lock_file(file.handle, false, false)) }

machine windows_filesystem_try_lock(file: |filesystem|::File) -> |filesystem|::TryLockResult
{ windows_filesystem_try_lock_result(block |win_fs|::WindowsFilesystemHost::lock_file(file.handle, true, true)) }

machine windows_filesystem_try_lock_shared(file: |filesystem|::File) -> |filesystem|::TryLockResult
{ windows_filesystem_try_lock_result(block |win_fs|::WindowsFilesystemHost::lock_file(file.handle, false, true)) }

machine windows_filesystem_unlock(file: |filesystem|::File) -> |filesystem|::UnitResult
{ |errors|::windows_filesystem_unit(block |win_fs|::WindowsFilesystemHost::unlock_file(file.handle)) }

machine windows_filesystem_try_lock_result(status: i32) -> |filesystem|::TryLockResult {
    transition status {
        0 -> |filesystem|::TryLockResult::Acquired,
        -33 -> |filesystem|::TryLockResult::WouldBlock,
        _ -> (|filesystem|::TryLockResult::Error { kind: |errors|::windows_filesystem_status_error(status as i64) })
    }
}
