use filesystem.omg as filesystem;
use filesystem_host.omg as paths;
use targets/windows_x86_64/filesystem/errors.omg as errors;
use windows_filesystem_host.omg as win_fs;
use {omega}/language/core/filesystem_authority.omg as authority;
use {omega}/language/core/numeric_conversion.omg as numeric;

// Decode native Windows facts, never invented POSIX identities. FILETIME uses
// 100-ns ticks from 1601; portable timestamps use signed Unix seconds. A real
// zero timestamp is distinct from unavailable POSIX metadata. Only the known
// symlink/junction tags become Symlink; an unknown reparse tag stays Other.

machine windows_filesystem_seconds(ticks: u64) -> i64 {
    let since_windows_epoch: u64 = ticks / 10000000;
    (since_windows_epoch as i64) - 11644473600
}

machine windows_filesystem_kind(attributes: u32, reparse_tag: u32) -> |filesystem|::FileKind {
    transition (attributes & 1024) != 0 {
        true -> reparse(reparse_tag),
        false -> ordinary(attributes)
    }
    machine reparse(tag: u32) -> |filesystem|::FileKind {
        transition tag == 2684354572 || tag == 2684354563 {
            true -> |filesystem|::FileKind::Symlink,
            false -> |filesystem|::FileKind::Other
        }
    }
    machine ordinary(attributes: u32) -> |filesystem|::FileKind {
        transition (attributes & 16) != 0 { true -> |filesystem|::FileKind::Directory, false -> |filesystem|::FileKind::File }
    }
}

machine windows_filesystem_metadata_result(outcome: |win_fs|::WindowsMetadataResult) -> |filesystem|::MetadataResult {
    transition outcome {
        |win_fs|::WindowsMetadataResult::Error { code } -> (|filesystem|::MetadataResult::Error { kind: |errors|::windows_filesystem_error(code) }),
        |win_fs|::WindowsMetadataResult::Value { metadata } -> value(metadata)
    }
    machine value(metadata: |win_fs|::WindowsFileMetadata) -> |filesystem|::MetadataResult {
        transition metadata.length >= 0 {
            true -> valid(metadata),
            false -> (|filesystem|::MetadataResult::Error { kind: |filesystem|::ErrorKind::Other })
        }
    }
    machine valid(metadata: |win_fs|::WindowsFileMetadata) -> |filesystem|::MetadataResult {
        |filesystem|::MetadataResult::Ok { meta: |filesystem|::Metadata {
            length: metadata.length,
            kind: windows_filesystem_kind(metadata.attributes, metadata.reparse_tag),
            permissions: |filesystem|::Permissions::Readonly { value: (metadata.attributes & 1) != 0 },
            nlink: |numeric|::widen_u32_to_u64(metadata.links),
            posix: |filesystem|::PosixMetadataResult::Error { kind: |filesystem|::ErrorKind::Unsupported },
            modified_secs: windows_filesystem_seconds(metadata.write_ticks),
            accessed_secs: windows_filesystem_seconds(metadata.access_ticks),
            creation_time: |filesystem|::TimestampResult::Ok { seconds: windows_filesystem_seconds(metadata.creation_ticks) },
            changed_secs: windows_filesystem_seconds(metadata.change_ticks)
        } }
    }
}

machine windows_filesystem_metadata(file: |filesystem|::File) -> |filesystem|::MetadataResult
reaches |authority|::FilesystemMetadataQuery
{
    transition file.handle != 0 {
        true -> block query(file),
        false -> (|filesystem|::MetadataResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor })
    }
    machine query(file: |filesystem|::File) -> |filesystem|::MetadataResult {
        let outcome: |win_fs|::WindowsMetadataResult = block |win_fs|::WindowsFilesystemHost::metadata(file.handle);
        windows_filesystem_metadata_result(outcome)
    }
}

machine windows_filesystem_metadata_path(path: @[u8] in |paths|::Path, no_follow: bool) -> |filesystem|::MetadataResult
reaches |authority|::FilesystemMetadataQuery
{
    let outcome: |win_fs|::WindowsMetadataResult = block |win_fs|::WindowsFilesystemHost::read_metadata(path, no_follow);
    windows_filesystem_metadata_result(outcome)
}

machine windows_filesystem_exists(path: @[u8] in |paths|::Path) -> bool
reaches |authority|::FilesystemMetadataQuery
{
    let outcome: |filesystem|::MetadataResult = block windows_filesystem_metadata_path(path, false);
    transition outcome { |filesystem|::MetadataResult::Ok { meta } -> true, _ -> false }
}

machine windows_filesystem_try_exists(path: @[u8] in |paths|::Path) -> |filesystem|::ExistsResult
reaches |authority|::FilesystemMetadataQuery
{
    let outcome: |filesystem|::MetadataResult = block windows_filesystem_metadata_path(path, false);
    transition outcome {
        |filesystem|::MetadataResult::Ok { meta } -> |filesystem|::ExistsResult::Yes,
        |filesystem|::MetadataResult::Error { kind } -> failed(kind)
    }
    machine failed(kind: |filesystem|::ErrorKind) -> |filesystem|::ExistsResult {
        transition kind {
            |filesystem|::ErrorKind::NotFound -> |filesystem|::ExistsResult::No,
            _ -> (|filesystem|::ExistsResult::Error { kind: kind })
        }
    }
}

data WindowsTimestampEncoding {
    case Error(kind: |filesystem|::ErrorKind);
    case Ticks(value: u64);
}

// SetFileTime treats FILETIME zero as "leave unchanged", not the 1601 epoch.
// Refuse that unrepresentable requested update instead of reporting a no-op as
// success. A signed Unix time outside the Windows encoding is likewise a
// supported input whose update is unavailable, not a malformed request.
// Whole-second encodings can never equal the all-ones suppression key.
// https://learn.microsoft.com/windows/win32/api/fileapi/nf-fileapi-setfiletime
machine windows_filesystem_encode_timestamp(seconds: i64) -> WindowsTimestampEncoding {
    transition seconds == -11644473600 {
        true -> (WindowsTimestampEncoding::Error { kind: |filesystem|::ErrorKind::Unsupported }),
        false -> range(seconds)
    }
    machine range(seconds: i64) -> WindowsTimestampEncoding {
        transition seconds > -11644473600 && seconds <= 1833029933770 {
            true -> encode(seconds),
            false -> (WindowsTimestampEncoding::Error { kind: |filesystem|::ErrorKind::Unsupported })
        }
    }
    machine encode(seconds: i64) -> WindowsTimestampEncoding
    requires seconds > -11644473600 && seconds <= 1833029933770 {
        let shifted: i64 = seconds + 11644473600;
        let ticks: u64 = (shifted as u64) * 10000000;
        WindowsTimestampEncoding::Ticks { value: ticks }
    }
}

machine windows_filesystem_set_times(file: |filesystem|::File, accessed: i64, modified: i64) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation
{
    transition file.handle != 0 {
        true -> block access_time(file, accessed, modified),
        false -> (|filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor })
    }
    machine access_time(file: |filesystem|::File, accessed: i64, modified: i64) -> |filesystem|::UnitResult {
        let encoded: WindowsTimestampEncoding = windows_filesystem_encode_timestamp(accessed);
        transition encoded {
            WindowsTimestampEncoding::Error { kind } -> (|filesystem|::UnitResult::Error { kind: kind }),
            WindowsTimestampEncoding::Ticks { value } -> block write_time(file, value, modified)
        }
    }
    machine write_time(file: |filesystem|::File, accessed: u64, modified: i64) -> |filesystem|::UnitResult {
        let encoded: WindowsTimestampEncoding = windows_filesystem_encode_timestamp(modified);
        transition encoded {
            WindowsTimestampEncoding::Error { kind } -> (|filesystem|::UnitResult::Error { kind: kind }),
            WindowsTimestampEncoding::Ticks { value } -> block update(file, accessed, value)
        }
    }
    machine update(file: |filesystem|::File, accessed: u64, modified: u64) -> |filesystem|::UnitResult {
        let status: i32 = block |win_fs|::WindowsFilesystemHost::set_file_time(file.handle, accessed, modified);
        |errors|::windows_filesystem_unit(status)
    }
}

// A numeric POSIX mode does not encode a Windows ACL. Only the portable
// read-only request is translated; Default restores the ordinary writable bit.
machine windows_filesystem_set_permissions(path: @[u8] in |paths|::Path, permissions: |filesystem|::Permissions) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataQuery + |authority|::FilesystemMetadataMutation
{
    transition permissions {
        |filesystem|::Permissions::Default -> block update(path, false),
        |filesystem|::Permissions::Readonly { value } -> block update(path, value),
        |filesystem|::Permissions::Posix { mode } -> (|filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::Unsupported })
    }
    machine update(path: @[u8] in |paths|::Path, readonly: bool) -> |filesystem|::UnitResult {
        let status: i32 = block |win_fs|::WindowsFilesystemHost::set_path_readonly(path, readonly);
        |errors|::windows_filesystem_unit(status)
    }
}

machine windows_filesystem_set_file_permissions(file: |filesystem|::File, permissions: |filesystem|::Permissions) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataQuery + |authority|::FilesystemMetadataMutation
{
    transition file.handle != 0 {
        true -> block select(file, permissions),
        false -> (|filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor })
    }
    machine select(file: |filesystem|::File, permissions: |filesystem|::Permissions) -> |filesystem|::UnitResult {
        transition permissions {
            |filesystem|::Permissions::Default -> block update(file, false),
            |filesystem|::Permissions::Readonly { value } -> block update(file, value),
            |filesystem|::Permissions::Posix { mode } -> (|filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::Unsupported })
        }
    }
    machine update(file: |filesystem|::File, readonly: bool) -> |filesystem|::UnitResult {
        let status: i32 = block |win_fs|::WindowsFilesystemHost::set_handle_readonly(file.handle, readonly);
        |errors|::windows_filesystem_unit(status)
    }
}
