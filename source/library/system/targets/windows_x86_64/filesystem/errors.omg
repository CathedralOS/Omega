use filesystem.omg;
use {omega}/language/core/numeric_conversion.omg as numeric;

// Portable translation of real Win32 failures. Unknown codes remain Other;
// neither a zero last-error nor a malformed raw status can manufacture success.
// Numeric identities: Microsoft WinError.h, system-error-codes--0-499-.

machine windows_filesystem_error(code: u32) -> |filesystem|::ErrorKind {
    transition code {
        1 -> |filesystem|::ErrorKind::Unsupported,
        2 -> |filesystem|::ErrorKind::NotFound,
        3 -> |filesystem|::ErrorKind::NotFound,
        5 -> |filesystem|::ErrorKind::PermissionDenied,
        6 -> |filesystem|::ErrorKind::BadDescriptor,
        15 -> |filesystem|::ErrorKind::NotFound,
        19 -> |filesystem|::ErrorKind::PermissionDenied,
        32 -> |filesystem|::ErrorKind::PermissionDenied,
        33 -> |filesystem|::ErrorKind::WouldBlock,
        50 -> |filesystem|::ErrorKind::Unsupported,
        53 -> |filesystem|::ErrorKind::NotFound,
        65 -> |filesystem|::ErrorKind::PermissionDenied,
        67 -> |filesystem|::ErrorKind::NotFound,
        80 -> |filesystem|::ErrorKind::AlreadyExists,
        87 -> |filesystem|::ErrorKind::InvalidInput,
        111 -> |filesystem|::ErrorKind::InvalidInput,
        120 -> |filesystem|::ErrorKind::Unsupported,
        123 -> |filesystem|::ErrorKind::InvalidInput,
        161 -> |filesystem|::ErrorKind::InvalidInput,
        183 -> |filesystem|::ErrorKind::AlreadyExists,
        206 -> |filesystem|::ErrorKind::InvalidInput,
        267 -> |filesystem|::ErrorKind::InvalidInput,
        _ -> |filesystem|::ErrorKind::Other
    }
}

machine windows_filesystem_status_error(status: i64) -> |filesystem|::ErrorKind {
    transition status < 0 && status >= -4294967295 {
        true -> native(status),
        false -> |filesystem|::ErrorKind::Other
    }
    machine native(status: i64) -> |filesystem|::ErrorKind
    requires status < 0 && status >= -4294967295 {
        windows_filesystem_error(|numeric|::narrow_i64_to_u32_exact(0 - status))
    }
}

machine windows_filesystem_unit(status: i32) -> |filesystem|::UnitResult {
    transition status == 0 {
        true -> |filesystem|::UnitResult::Ok,
        false -> (|filesystem|::UnitResult::Error { kind: windows_filesystem_status_error(|numeric|::widen_i32_to_i64(status)) })
    }
}

machine windows_filesystem_transferred(status: i64, requested: u64) -> |filesystem|::IoResult {
    transition status >= 0 {
        true -> nonnegative(status, requested),
        false -> (|filesystem|::IoResult::Error { kind: windows_filesystem_status_error(status) })
    }
    machine nonnegative(status: i64, requested: u64) -> |filesystem|::IoResult requires status >= 0 {
        let count: u64 = |numeric|::narrow_i64_to_u64_exact(status);
        transition count <= requested {
            true -> (|filesystem|::IoResult::Ok { count: count }),
            false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::Other })
        }
    }
}
