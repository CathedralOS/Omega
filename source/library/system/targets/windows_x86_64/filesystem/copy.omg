use filesystem.omg;
use filesystem_host.omg as paths;
use targets/windows_x86_64/filesystem/handles.omg as handles;
use targets/windows_x86_64/filesystem/metadata.omg as metadata;
use targets/windows_x86_64/filesystem/sequences.omg as sequences;
use windows_filesystem_host.omg as win_fs;
use {omega}/language/core/filesystem_authority.omg as authority;

// Copy the caller-bounded initialized prefix, not an unbounded CopyFileW.
// Read and close the source before opening the destination; every acquired
// object is closed on every returning path and an earlier failure wins.
// Restore the source's portable read-only bit on the exact destination handle,
// not a second path lookup which could race namespace replacement.

machine windows_filesystem_copy(from: @[u8] in |paths|::Path, to: @[u8] in |paths|::Path, buffer: @mutable [u8], cap: u64) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::FilesystemMetadataQuery
{
    transition cap <= buffer.length {
        true -> block acquire(from, to, buffer, cap),
        false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::InvalidInput })
    }
    machine acquire(from: @[u8] in |paths|::Path, to: @[u8] in |paths|::Path, buffer: @mutable [u8], cap: u64) -> |filesystem|::IoResult {
        let acquired: |filesystem|::OpenResult = block |handles|::windows_filesystem_open(from);
        transition acquired {
            |filesystem|::OpenResult::Error { kind } -> (|filesystem|::IoResult::Error { kind: kind }),
            |filesystem|::OpenResult::Ok { file } -> block metadata(file, to, buffer, cap)
        }
    }
    machine metadata(source: |filesystem|::File, to: @[u8] in |paths|::Path, buffer: @mutable [u8], cap: u64) -> |filesystem|::IoResult {
        let result: |filesystem|::MetadataResult = block |metadata|::windows_filesystem_metadata(source);
        transition result {
            |filesystem|::MetadataResult::Error { kind } -> block failed(source, kind),
            |filesystem|::MetadataResult::Ok { meta } -> block read(source, to, buffer, cap, meta.permissions)
        }
    }
    machine failed(file: |filesystem|::File, kind: |filesystem|::ErrorKind) -> |filesystem|::IoResult {
        let released: |filesystem|::UnitResult = block |handles|::windows_filesystem_close(file);
        |filesystem|::IoResult::Error { kind: kind }
    }
    machine read(source: |filesystem|::File, to: @[u8] in |paths|::Path, buffer: @mutable [u8], cap: u64, permissions: |filesystem|::Permissions) -> |filesystem|::IoResult {
        let result: |filesystem|::IoResult = block |handles|::windows_filesystem_read(source, buffer, cap);
        let released: |filesystem|::UnitResult = block |handles|::windows_filesystem_close(source);
        let finished: |filesystem|::IoResult = |sequences|::windows_filesystem_finish_read(result, released);
        transition finished {
            |filesystem|::IoResult::Error { kind } -> (|filesystem|::IoResult::Error { kind: kind }),
            |filesystem|::IoResult::Ok { count } -> block bounded(to, buffer, count, permissions)
        }
    }
    machine bounded(to: @[u8] in |paths|::Path, buffer: @mutable [u8], count: u64, permissions: |filesystem|::Permissions) -> |filesystem|::IoResult {
        transition count <= buffer.length {
            true -> block destination(to, buffer, count, permissions),
            false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::Other })
        }
    }
    machine destination(to: @[u8] in |paths|::Path, buffer: @mutable [u8], count: u64, permissions: |filesystem|::Permissions) -> |filesystem|::IoResult
    requires count <= buffer.length {
        // GENERIC_WRITE plus FILE_READ_ATTRIBUTES allows the permission update
        // to preserve unrelated attributes on this same object. Ordinary write
        // opens need not acquire the extra query right just for this algorithm.
        // FILE_ATTRIBUTE_NORMAL | SECURITY_SQOS_PRESENT (Anonymous).
        let handle: u64 = block |win_fs|::WindowsFilesystemHost::create_file(to, 1073741952, 7, 2, 1048704);
        let acquired: |filesystem|::OpenResult = |handles|::windows_filesystem_opened(handle);
        transition acquired {
            |filesystem|::OpenResult::Error { kind } -> (|filesystem|::IoResult::Error { kind: kind }),
            |filesystem|::OpenResult::Ok { file } -> block write(file, buffer, count, permissions)
        }
    }
    machine write(destination: |filesystem|::File, buffer: @mutable [u8], count: u64, permissions: |filesystem|::Permissions) -> |filesystem|::IoResult
    requires count <= buffer.length {
        let bytes: @[u8] = @buffer[0..count];
        let result: |filesystem|::UnitResult = block |sequences|::windows_filesystem_write_complete(destination, bytes);
        transition result {
            |filesystem|::UnitResult::Error { kind } -> block failed(destination, kind),
            |filesystem|::UnitResult::Ok -> block restore(destination, count, permissions)
        }
    }
    machine restore(destination: |filesystem|::File, count: u64, permissions: |filesystem|::Permissions) -> |filesystem|::IoResult {
        let result: |filesystem|::UnitResult = block |metadata|::windows_filesystem_set_file_permissions(destination, permissions);
        let released: |filesystem|::UnitResult = block |handles|::windows_filesystem_close(destination);
        let finished: |filesystem|::UnitResult = |sequences|::windows_filesystem_finish_unit(result, released);
        transition finished {
            |filesystem|::UnitResult::Error { kind } -> (|filesystem|::IoResult::Error { kind: kind }),
            |filesystem|::UnitResult::Ok -> (|filesystem|::IoResult::Ok { count: count })
        }
    }
}
