use filesystem.omg;
use filesystem_host.omg as paths;
use targets/windows_x86_64/filesystem/errors.omg as errors;
use targets/windows_x86_64/filesystem/metadata.omg as metadata;
use windows_filesystem_host.omg as win_fs;
use {omega}/language/core/filesystem_authority.omg as authority;

// Namespace operations use non-copying rename. Recursive creation treats drive,
// UNC and extended UNC roots as existing namespaces, not components to create.
// An already-existing prefix succeeds only after a followed directory query;
// ordinary files and dangling links must not turn mkdir failure into success.

machine windows_filesystem_remove_dir_all(path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::DirectoryEnumeration + |authority|::FilesystemMetadataQuery
{
    let status: i32 = block |win_fs|::WindowsFilesystemHost::remove_tree(path);
    |errors|::windows_filesystem_unit(status)
}

machine windows_filesystem_read_link(path: @[u8] in |paths|::Path, output: @mutable [u8], count: u64) -> |filesystem|::IoResult
reaches |authority|::FilesystemMetadataQuery
{
    let transferred: i64 = block |win_fs|::WindowsFilesystemHost::read_link(path, output, count);
    |errors|::windows_filesystem_transferred(transferred, count)
}

machine windows_filesystem_extended_path(path: @[u8]) -> bool {
    transition path.length >= 4 { true -> prefix(path), false -> false }
    machine prefix(path: @[u8]) -> bool requires path.length >= 4 {
        path[0] == 92 && path[1] == 92 && path[2] == 63 && path[3] == 92
    }
}

// Extended paths disable Win32 slash normalization. Treating their '/' as a
// separator could create a prefix which the authored path never requested.
// https://learn.microsoft.com/windows/win32/fileio/maximum-file-path-limitation
machine windows_filesystem_separator(path: @[u8], character: u8) -> bool {
    character == 92 || (character == 47 && !windows_filesystem_extended_path(path))
}

// Return the end of the root spelling. Callers check the returned bound before
// slicing; malformed roots are left to Windows, never normalized into another
// path. Ordinary paths accept both separators; extended paths only backslash.
machine windows_filesystem_root_length(path: @[u8]) -> u64 {
    transition path.length >= 2 { true -> prefix(path), false -> short(path) }
    machine short(path: @[u8]) -> u64 {
        transition path.length == 1 { true -> single(path), false -> 0 }
    }
    machine single(path: @[u8]) -> u64 requires path.length == 1 {
        transition windows_filesystem_separator(path, path[0]) { true -> 1, false -> 0 }
    }
    machine prefix(path: @[u8]) -> u64 requires path.length >= 2 {
        let has_drive_letter: bool = (path[0] >= 65 && path[0] <= 90) || (path[0] >= 97 && path[0] <= 122);
        transition has_drive_letter && path[1] == 58 {
            true -> drive(path),
            false -> network(path)
        }
    }
    machine drive(path: @[u8]) -> u64 requires path.length >= 2 {
        transition path.length >= 3 { true -> drive_separator(path), false -> 2 }
    }
    machine drive_separator(path: @[u8]) -> u64 requires path.length >= 3 {
        transition windows_filesystem_separator(path, path[2]) { true -> 3, false -> 2 }
    }
    machine network(path: @[u8]) -> u64 requires path.length >= 2 {
        transition windows_filesystem_separator(path, path[0]) && windows_filesystem_separator(path, path[1]) {
            true -> extended(path),
            false -> rooted(path)
        }
    }
    machine rooted(path: @[u8]) -> u64 requires path.length >= 2 {
        transition windows_filesystem_separator(path, path[0]) { true -> 1, false -> 0 }
    }
    machine extended(path: @[u8]) -> u64 {
        transition path.length >= 8 { true -> extended_prefix(path), false -> components(path, 2, 2) }
    }
    machine extended_prefix(path: @[u8]) -> u64 requires path.length >= 8 {
        transition path[2] == 63 && windows_filesystem_separator(path, path[3])
            && (path[4] == 85 || path[4] == 117)
            && (path[5] == 78 || path[5] == 110)
            && (path[6] == 67 || path[6] == 99)
            && windows_filesystem_separator(path, path[7]) {
            true -> components(path, 8, 2),
            false -> components(path, 2, 2)
        }
    }
    machine components(path: @[u8], start: u64, count: u64) -> u64 {
        windows_filesystem_root_components(path, start, count, path.length)
    }
}

// Only this edge advances through root components. A byte-length budget also
// closes malformed/repeated-separator cases without an unbounded search.
machine windows_filesystem_root_components(path: @[u8], position: u64, remaining: u64, budget: u64) -> u64
terminates by budget
{
    transition position < path.length && budget > 0 {
        true -> inspect(path, position, remaining, budget),
        false -> (path.length)
    }
    machine inspect(path: @[u8], position: u64, remaining: u64, budget: u64) -> u64
    requires position < path.length && budget > 0
    terminates by budget
    {
        transition windows_filesystem_separator(path, path[position]) {
            true -> separator(path, position, remaining, budget),
            false -> windows_filesystem_root_components(path, position + 1, remaining, budget - 1)
        }
    }
    machine separator(path: @[u8], position: u64, remaining: u64, budget: u64) -> u64
    requires position < path.length && budget > 0
    terminates by budget
    {
        transition remaining > 1 {
            true -> windows_filesystem_root_components(path, position + 1, remaining - 1, budget - 1),
            false -> (position + 1)
        }
    }
}

machine windows_filesystem_create_dir(path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    let status: i32 = block |win_fs|::WindowsFilesystemHost::create_directory(path);
    |errors|::windows_filesystem_unit(status)
}

machine windows_filesystem_remove_dir(path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemNamespaceMutation
{
    let status: i32 = block |win_fs|::WindowsFilesystemHost::remove_directory(path);
    |errors|::windows_filesystem_unit(status)
}

machine windows_filesystem_remove(path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemNamespaceMutation
{
    let status: i32 = block |win_fs|::WindowsFilesystemHost::delete_file(path);
    |errors|::windows_filesystem_unit(status)
}

machine windows_filesystem_rename(from: @[u8] in |paths|::Path, to: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemNamespaceMutation
{
    let status: i32 = block |win_fs|::WindowsFilesystemHost::rename_file(from, to);
    |errors|::windows_filesystem_unit(status)
}

machine windows_filesystem_existing_directory(path: @[u8] in |paths|::Path, original: |filesystem|::ErrorKind) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataQuery
{
    let result: |filesystem|::MetadataResult = block |metadata|::windows_filesystem_metadata_path(path, false);
    transition result {
        |filesystem|::MetadataResult::Ok { meta } -> kind(meta, original),
        |filesystem|::MetadataResult::Error { kind } -> (|filesystem|::UnitResult::Error { kind: original })
    }
    machine kind(metadata: |filesystem|::Metadata, original: |filesystem|::ErrorKind) -> |filesystem|::UnitResult {
        transition metadata.kind {
            |filesystem|::FileKind::Directory -> |filesystem|::UnitResult::Ok,
            _ -> (|filesystem|::UnitResult::Error { kind: original })
        }
    }
}

machine windows_filesystem_hard_link(original: @[u8] in |paths|::Path, link: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemNamespaceMutation
{
    let status: i32 = block |win_fs|::WindowsFilesystemHost::hard_link(original, link);
    |errors|::windows_filesystem_unit(status)
}

machine windows_filesystem_canonicalize(path: @[u8] in |paths|::Path, output: @mutable [u8]) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataQuery
{
    let status: i32 = block |win_fs|::WindowsFilesystemHost::canonicalize(path, output);
    |errors|::windows_filesystem_unit(status)
}

machine windows_filesystem_create_dir_existing(path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::FilesystemMetadataQuery
{
    let result: |filesystem|::UnitResult = block windows_filesystem_create_dir(path);
    transition result {
        |filesystem|::UnitResult::Ok -> |filesystem|::UnitResult::Ok,
        |filesystem|::UnitResult::Error { kind } -> block failed(path, kind)
    }
    machine failed(path: @[u8] in |paths|::Path, kind: |filesystem|::ErrorKind) -> |filesystem|::UnitResult {
        transition kind {
            |filesystem|::ErrorKind::AlreadyExists -> block windows_filesystem_existing_directory(path, kind),
            _ -> (|filesystem|::UnitResult::Error { kind: kind })
        }
    }
}

machine windows_filesystem_create_dir_all(path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::FilesystemMetadataQuery
{
    let root: u64 = windows_filesystem_root_length(path as - |paths|::Path);
    transition root < path.length {
        true -> block walk(path, root),
        false -> block check_root(path)
    }
    machine check_root(path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult {
        let result: |filesystem|::MetadataResult = block |metadata|::windows_filesystem_metadata_path(path, false);
        transition result {
            |filesystem|::MetadataResult::Error { kind } -> (|filesystem|::UnitResult::Error { kind: kind }),
            |filesystem|::MetadataResult::Ok { meta } -> root_kind(meta)
        }
    }
    machine root_kind(metadata: |filesystem|::Metadata) -> |filesystem|::UnitResult {
        transition metadata.kind {
            |filesystem|::FileKind::Directory -> |filesystem|::UnitResult::Ok,
            _ -> (|filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::AlreadyExists })
        }
    }
    machine walk(path: @[u8] in |paths|::Path, position: u64) -> |filesystem|::UnitResult {
        block windows_filesystem_create_components(path, position)
    }
}

// Advance within one activation. Native filesystem waits have no eventual-
// return promise, so a finite component scan must not publish `terminates` for
// the whole operation. Internal state edges need neither recursive frames nor
// a fabricated progress promise about the OS.
machine windows_filesystem_create_components(path: @[u8] in |paths|::Path, start: u64) -> |filesystem|::UnitResult
reaches |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation + |authority|::FilesystemMetadataQuery
{
    transition { _ -> block walk(path, start) }
    machine walk(path: @[u8] in |paths|::Path, position: u64) -> |filesystem|::UnitResult {
        transition position < path.length {
            true -> block inspect(path, position),
            false -> block complete(path)
        }
    }
    machine complete(path: @[u8] in |paths|::Path) -> |filesystem|::UnitResult {
        block windows_filesystem_create_dir_existing(path)
    }
    machine inspect(path: @[u8] in |paths|::Path, position: u64) -> |filesystem|::UnitResult
    requires position < path.length {
        // A builtin index takes an unqualified view (domains.md, "Operands").
        transition position > 0 && windows_filesystem_separator(path as - |paths|::Path, (path as - |paths|::Path)[position]) {
            true -> block create(path, position),
            false -> block walk(path, position + 1)
        }
    }
    machine create(path: @[u8] in |paths|::Path, position: u64) -> |filesystem|::UnitResult
    requires position < path.length {
        // A builtin range takes an unqualified view (domains.md, "Operands"): remove
        // `Path` before the prefix and add it back to the prefix.
        let prefix: @[u8] = @(path as - |paths|::Path)[0..position];
        let result: |filesystem|::UnitResult = block windows_filesystem_create_dir_existing(prefix as + |paths|::Path);
        transition result {
            |filesystem|::UnitResult::Error { kind } -> (|filesystem|::UnitResult::Error { kind: kind }),
            |filesystem|::UnitResult::Ok -> block walk(path, position + 1)
        }
    }
}
