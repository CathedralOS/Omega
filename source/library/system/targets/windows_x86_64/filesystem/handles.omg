use filesystem.omg;
use filesystem_host.omg as paths;
use targets/windows_x86_64/filesystem/errors.omg as errors;
use windows_filesystem_host.omg as win_fs;
use {omega}/language/core/filesystem_authority.omg as authority;

// File handles remain native HANDLE values; zero is absent. Opens preserve
// read/write/delete sharing. Append requests omit FILE_WRITE_DATA, so every
// ordinary write uses the OS's append placement rather than a racy seek to EOF.
// Positioned I/O has its own independent-object path, never seek/restore here.
// Owned opens add SECURITY_SQOS_PRESENT with the zero Anonymous level: a
// file-like endpoint must not inherit permission to impersonate the caller.
// The raw create_file API still preserves its caller's explicit native flags.

machine windows_filesystem_opened(handle: u64) -> |filesystem|::OpenResult
{
    transition handle != 0 {
        true -> (|filesystem|::OpenResult::Ok { file: |filesystem|::File { handle: handle } }),
        false -> failed()
    }
    machine failed() -> |filesystem|::OpenResult {
        let code: u32 = |win_fs|::WindowsFilesystemHost::last_error();
        |filesystem|::OpenResult::Error { kind: |errors|::windows_filesystem_error(code) }
    }
}

machine windows_filesystem_open_with(path: @[u8] in |paths|::Path, options: |filesystem|::OpenOptions) -> |filesystem|::OpenResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    transition |filesystem|::open_options_truncate_conflict(options) {
        true -> (|filesystem|::OpenResult::Error { kind: |filesystem|::ErrorKind::InvalidInput }),
        false -> block access(path, options)
    }
    machine access(path: @[u8] in |paths|::Path, options: |filesystem|::OpenOptions) -> |filesystem|::OpenResult {
        transition options.read || (!options.write && !options.append) {
            true -> block writable(path, options, 2147483648),
            false -> block writable(path, options, 0)
        }
    }
    machine writable(path: @[u8] in |paths|::Path, options: |filesystem|::OpenOptions, desired: u32) -> |filesystem|::OpenResult {
        transition options.append {
            true -> block disposition(path, options, desired | 1179924),
            false -> block ordinary_write(path, options, desired)
        }
    }
    machine ordinary_write(path: @[u8] in |paths|::Path, options: |filesystem|::OpenOptions, desired: u32) -> |filesystem|::OpenResult {
        transition options.write {
            true -> block disposition(path, options, desired | 1073741824),
            false -> block disposition(path, options, desired)
        }
    }
    machine disposition(path: @[u8] in |paths|::Path, options: |filesystem|::OpenOptions, desired: u32) -> |filesystem|::OpenResult {
        transition options.create_new {
            true -> block acquire(path, desired, 1),
            false -> block creating(path, options, desired)
        }
    }
    machine creating(path: @[u8] in |paths|::Path, options: |filesystem|::OpenOptions, desired: u32) -> |filesystem|::OpenResult {
        transition options.create {
            true -> block create_mode(path, options.truncate, desired),
            false -> block existing_mode(path, options.truncate, desired)
        }
    }
    machine create_mode(path: @[u8] in |paths|::Path, truncate: bool, desired: u32) -> |filesystem|::OpenResult {
        transition truncate { true -> block acquire(path, desired, 2), false -> block acquire(path, desired, 4) }
    }
    machine existing_mode(path: @[u8] in |paths|::Path, truncate: bool, desired: u32) -> |filesystem|::OpenResult {
        transition truncate { true -> block acquire(path, desired, 5), false -> block acquire(path, desired, 3) }
    }
    machine acquire(path: @[u8] in |paths|::Path, desired: u32, disposition: u32) -> |filesystem|::OpenResult {
        let handle: u64 = block |win_fs|::WindowsFilesystemHost::create_file(path, desired, 7, disposition, 1048704);
        windows_filesystem_opened(handle)
    }
}

machine windows_filesystem_open(path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    let options: |filesystem|::OpenOptions;
    block windows_filesystem_open_with(path, options)
}

machine windows_filesystem_create(path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    block windows_filesystem_open_with(path, |filesystem|::OpenOptions {
        read: false, write: true, append: false, truncate: true, create: true, create_new: false
    })
}

machine windows_filesystem_create_new(path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    block windows_filesystem_open_with(path, |filesystem|::OpenOptions {
        read: true, write: true, append: false, truncate: false, create: false, create_new: true
    })
}

machine windows_filesystem_append(path: @[u8] in |paths|::Path) -> |filesystem|::OpenResult
reaches |authority|::FilesystemContentRead + |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation + |authority|::FilesystemNamespaceMutation
{
    block windows_filesystem_open_with(path, |filesystem|::OpenOptions {
        read: false, write: false, append: true, truncate: false, create: false, create_new: false
    })
}

// A portable read or write may complete a prefix. Keep its native request
// inside DWORD without rejecting the caller's larger, valid byte window.
machine windows_filesystem_transfer_size(requested: u64) -> u64
ensures result <= requested && result <= 4294967295
{
    transition requested <= 4294967295 {
        true -> (requested),
        false -> (4294967295)
    }
}

machine windows_filesystem_read(file: |filesystem|::File, buffer: @mutable [u8], count: u64) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentRead
{
    transition file.handle != 0 && count <= buffer.length {
        true -> block transfer(file, buffer, count),
        false -> invalid(file)
    }
    machine transfer(file: |filesystem|::File, buffer: @mutable [u8], count: u64) -> |filesystem|::IoResult {
        let limit: u64 = windows_filesystem_transfer_size(count);
        let result: i64 = block |win_fs|::WindowsFilesystemHost::read_file(file.handle, buffer, limit);
        |errors|::windows_filesystem_transferred(result, limit)
    }
    machine invalid(file: |filesystem|::File) -> |filesystem|::IoResult {
        transition file.handle == 0 {
            true -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor }),
            false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::InvalidInput })
        }
    }
}

machine windows_filesystem_write(file: |filesystem|::File, bytes: @[u8]) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentWrite
{
    transition file.handle != 0 {
        true -> block transfer(file, bytes),
        false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor })
    }
    machine transfer(file: |filesystem|::File, bytes: @[u8]) -> |filesystem|::IoResult {
        let limit: u64 = windows_filesystem_transfer_size(bytes.length);
        let result: i64 = block |win_fs|::WindowsFilesystemHost::write_file(file.handle, @bytes[0..limit]);
        |errors|::windows_filesystem_transferred(result, limit)
    }
}

// The raw positioned operations preserve the original object's cursor and
// cannot upgrade its granted data rights. Validate portable arguments before
// acquiring their temporary independent object; retain the actual short count.
machine windows_filesystem_read_at(file: |filesystem|::File, buffer: @mutable [u8], count: u64, offset: i64) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentRead
{
    transition file.handle != 0 {
        true -> block validate(file, buffer, count, offset),
        false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor })
    }
    machine validate(file: |filesystem|::File, buffer: @mutable [u8], count: u64, offset: i64) -> |filesystem|::IoResult {
        transition offset >= 0 && count <= buffer.length {
            true -> block transfer(file, buffer, count, offset),
            false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::InvalidInput })
        }
    }
    machine transfer(file: |filesystem|::File, buffer: @mutable [u8], count: u64, offset: i64) -> |filesystem|::IoResult {
        let limit: u64 = windows_filesystem_transfer_size(count);
        let result: i64 = block |win_fs|::WindowsFilesystemHost::read_at(file.handle, buffer, limit, offset);
        |errors|::windows_filesystem_transferred(result, limit)
    }
}

machine windows_filesystem_write_at(file: |filesystem|::File, bytes: @[u8], offset: i64) -> |filesystem|::IoResult
reaches |authority|::FilesystemContentWrite
{
    transition file.handle != 0 {
        true -> block validate(file, bytes, offset),
        false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor })
    }
    machine validate(file: |filesystem|::File, bytes: @[u8], offset: i64) -> |filesystem|::IoResult {
        transition offset >= 0 {
            true -> block transfer(file, bytes, offset),
            false -> (|filesystem|::IoResult::Error { kind: |filesystem|::ErrorKind::InvalidInput })
        }
    }
    machine transfer(file: |filesystem|::File, bytes: @[u8], offset: i64) -> |filesystem|::IoResult {
        let limit: u64 = windows_filesystem_transfer_size(bytes.length);
        let result: i64 = block |win_fs|::WindowsFilesystemHost::write_at(file.handle, @bytes[0..limit], offset);
        |errors|::windows_filesystem_transferred(result, limit)
    }
}

machine windows_filesystem_close(file: |filesystem|::File) -> |filesystem|::UnitResult
{
    transition file.handle != 0 {
        true -> block release(file),
        false -> (|filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor })
    }
    machine release(file: |filesystem|::File) -> |filesystem|::UnitResult {
        let status: i32 = block |win_fs|::WindowsFilesystemHost::close_handle(file.handle);
        |errors|::windows_filesystem_unit(status)
    }
}

machine windows_filesystem_sync(file: |filesystem|::File) -> |filesystem|::UnitResult
{
    transition file.handle != 0 {
        true -> block flush(file),
        false -> (|filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor })
    }
    machine flush(file: |filesystem|::File) -> |filesystem|::UnitResult {
        let status: i32 = block |win_fs|::WindowsFilesystemHost::flush_file_buffers(file.handle);
        |errors|::windows_filesystem_unit(status)
    }
}

machine windows_filesystem_clone(file: |filesystem|::File) -> |filesystem|::OpenResult
{
    transition file.handle != 0 {
        true -> duplicate(file),
        false -> (|filesystem|::OpenResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor })
    }
    machine duplicate(file: |filesystem|::File) -> |filesystem|::OpenResult {
        let handle: u64 = |win_fs|::WindowsFilesystemHost::duplicate_handle(file.handle);
        windows_filesystem_opened(handle)
    }
}

machine windows_filesystem_set_length(file: |filesystem|::File, length: i64) -> |filesystem|::UnitResult
reaches |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation
{
    transition file.handle != 0 {
        true -> block validate(file, length),
        false -> (|filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::BadDescriptor })
    }
    machine validate(file: |filesystem|::File, length: i64) -> |filesystem|::UnitResult {
        transition length >= 0 {
            true -> block update(file, length),
            false -> (|filesystem|::UnitResult::Error { kind: |filesystem|::ErrorKind::InvalidInput })
        }
    }
    machine update(file: |filesystem|::File, length: i64) -> |filesystem|::UnitResult {
        let status: i32 = block |win_fs|::WindowsFilesystemHost::set_file_length(file.handle, length);
        |errors|::windows_filesystem_unit(status)
    }
}
