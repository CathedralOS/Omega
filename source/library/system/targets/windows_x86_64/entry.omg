use calling.omg as abi;
use entry_shapes.omg as shapes;
use {omega}/language/core/extent.omg as storage;

// The Windows loader enters a PE32+ executable at its AddressOfEntryPoint
// under the Microsoft x64 calling convention: the integer argument registers
// carry no contractual input at process arrival, the stack is 16-byte aligned
// with thirty-two bytes of shadow space, and the loader maps the value the
// entry returns in eax to the process exit code. This surface introduces
// neither storage roots nor access authority. ProgramStorageEntry remains the
// separate semantic root crossing; its two Extents are internal bridge inputs,
// not hosted application arguments. This calling contract supplies no bridge,
// loader admission, receiver, or numeric stack guarantee. ProviderSelected
// requires independent backing.
boundary trait WindowsProcessEntry {
    machine enter() -> u32 reaches none crashes Trap crashes Abort;
}

WindowsX86_64CallingPolicy satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        windows_x86_64_entry_plan(signature)
    }
}

machine windows_x86_64_entry_plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult
    satisfies |abi|::CallingPolicy::plan
{
    transition signature.parameter_count {
        0 -> physical(signature),
        2 -> semantic(signature),
        _ -> reject()
    }

    machine physical(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        transition signature.has_result {
            true -> physical_index(signature, signature.result),
            _ -> reject()
        }
    }

    machine physical_index(signature: |abi|::BoundarySignature, result: u64)
        -> |abi|::BoundaryPlanResult
    {
        transition result < 256 && result < signature.shape_count {
            true -> physical_shape(signature.shapes[result]),
            _ -> reject()
        }
    }

    machine physical_shape(result: |abi|::ValueShape) -> |abi|::BoundaryPlanResult {
        transition |shapes|::hosted_entry_integer_shape(@result, 4) {
            true -> build_physical(),
            _ -> reject()
        }
    }

    machine build_physical() -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan;
        output.call.parameter_count = 0;
        output.call.has_result = true;
        // Process completion status returns in eax; the loader maps it to the
        // process exit code.
        output.call.result = |shapes|::hosted_entry_named_word(4,
            |abi|::MachineRegister::X86Rax);
        transition { _ -> finish(output) }
    }

    machine semantic(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        transition signature.has_result {
            false -> semantic_indices(signature, signature.parameters[0],
                signature.parameters[1]),
            _ -> reject()
        }
    }

    machine semantic_indices(signature: |abi|::BoundarySignature, image: u64,
        storage: u64) -> |abi|::BoundaryPlanResult
    {
        transition image < 256 && storage < 256
            && image < signature.shape_count && storage < signature.shape_count
        {
            true -> semantic_shapes(signature.shapes[image],
                signature.shapes[storage], signature),
            _ -> reject()
        }
    }

    machine semantic_shapes(image: |abi|::ValueShape, storage: |abi|::ValueShape,
        signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult
    {
        transition |shapes|::hosted_entry_extent_shape(image, @signature)
            && |shapes|::hosted_entry_extent_shape(storage, @signature)
        {
            true -> build_semantic(),
            _ -> reject()
        }
    }

    machine build_semantic() -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan;
        output.call.parameter_count = 2;
        // The generated bridge passes the image and initial-storage roots as
        // Microsoft x64 indirect aggregates: their pointers arrive in rcx and
        // rdx, with caller-owned copies at stack offsets 32 and 48.
        output.call.parameters[0] = windows_x86_64_entry_extent_reference(
            |abi|::MachineRegister::X86Rcx, 32);
        output.call.parameters[1] = windows_x86_64_entry_extent_reference(
            |abi|::MachineRegister::X86Rdx, 48);
        transition { _ -> finish(output) }
    }

    machine finish(output: |abi|::BoundaryEntryPlan) -> |abi|::BoundaryPlanResult {
        let mutable plan: |abi|::BoundaryEntryPlan = output;
        plan.call.convention = |abi|::CallingConvention::MicrosoftX64;
        plan.call.stack_alignment = 16;
        plan.call.shadow_bytes = 32;
        plan.call.entry_control = |abi|::EntryControl::CallReturn;
        transition { _ -> seal(plan) }
    }

    machine seal(plan: |abi|::BoundaryEntryPlan) -> |abi|::BoundaryPlanResult {
        let mutable output: |abi|::BoundaryEntryPlan = plan;
        // Microsoft x64 caller-saved banks.
        output.call.ordinary_clobbers.register_count = 13;
        output.call.ordinary_clobbers.registers[0] = |abi|::MachineRegister::X86Rax;
        output.call.ordinary_clobbers.registers[1] = |abi|::MachineRegister::X86Rcx;
        output.call.ordinary_clobbers.registers[2] = |abi|::MachineRegister::X86Rdx;
        output.call.ordinary_clobbers.registers[3] = |abi|::MachineRegister::X86R8;
        output.call.ordinary_clobbers.registers[4] = |abi|::MachineRegister::X86R9;
        output.call.ordinary_clobbers.registers[5] = |abi|::MachineRegister::X86R10;
        output.call.ordinary_clobbers.registers[6] = |abi|::MachineRegister::X86R11;
        output.call.ordinary_clobbers.registers[7] = |abi|::MachineRegister::X86Xmm {
            index: 0
        };
        output.call.ordinary_clobbers.registers[8] = |abi|::MachineRegister::X86Xmm {
            index: 1
        };
        output.call.ordinary_clobbers.registers[9] = |abi|::MachineRegister::X86Xmm {
            index: 2
        };
        output.call.ordinary_clobbers.registers[10] = |abi|::MachineRegister::X86Xmm {
            index: 3
        };
        output.call.ordinary_clobbers.registers[11] = |abi|::MachineRegister::X86Xmm {
            index: 4
        };
        output.call.ordinary_clobbers.registers[12] = |abi|::MachineRegister::X86Xmm {
            index: 5
        };
        output.state.initial_regime = |abi|::MachineRegime::X86Long64;
        output.state.permitted_transitive_use.general_registers = true;
        output.state.permitted_transitive_use.vector_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.permitted_transitive_use.instruction_pointer = true;
        output.state.permitted_transitive_use.stack_pointer = true;
        // A returning import's floating-control envelope restores MXCSR/FPCR,
        // which the hosted ABI makes callee-preserved.
        output.state.permitted_transitive_use.control_state = true;
        output.state.stack = |abi|::EntryStack::ProviderSelected;
        output.state.preemption = |abi|::Preemption::NotApplicable;
        |abi|::BoundaryPlanResult::Accepted { plan: output }
    }

    machine reject() -> |abi|::BoundaryPlanResult {
        |abi|::BoundaryPlanResult::Rejected {
            reason: |abi|::CallingPolicyRejection {
                reason: "WindowsX86_64Application requires exact physical or program-storage entry shapes" as + |abi|::Utf8,
            },
        }
    }
}

machine windows_x86_64_entry_extent_reference(register: |abi|::MachineRegister,
    copy_stack_byte_offset: u64) -> |abi|::ValuePlacement
{
    // Integer fragments describe ABI placement only. The source application
    // retains the core Extent record, qualifications, and requirement identity.
    let mutable value: |abi|::ValuePlacement;
    value.shape.class = |abi|::AbiValueClass::Integer;
    value.shape.byte_size = 16;
    value.shape.alignment = 8;
    value.location_count = 1;
    value.locations[0] = |abi|::ValueLocation::Indirect {
        pointer: |abi|::IndirectPointerLocation::Register {
            register: register,
        },
        has_copy: true,
        copy_stack_byte_offset: copy_stack_byte_offset,
        byte_size: 16,
        alignment: 8,
    };
    value
}

boundary trait WindowsX86_64Application: |storage|::ProgramStorageEntry + WindowsProcessEntry + |abi|::Calling<WindowsX86_64CallingPolicy> {}
