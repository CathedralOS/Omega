use calling.omg as abi;
use targets/windows_x86_64/calling.omg as windows_abi;
use omega\language\core\StandardInput;
use omega\language\core\StandardOutput;
use ByteRead;
use ConsoleByteOperations;
use WindowsConsoleHost;
// Windows byte I/O uses MSVCRT descriptor calls. Binary mode preserves every
// authored byte, including CR/LF and Ctrl+Z. Build supplies each DLL locator.
use omega\language\core\narrow_i32_to_u8_wrapping;
use omega\language\core\widen_u8_to_i32;

// The leaf requirements below carry no source realization: each one is a
// package-owned boundary row whose DLL locator lives in `system/build.omg`
// (`Build::bind_native::<WindowsConsoleIo::...>`). Providers invoke the trait members
// directly; their raw host dependencies belong to the realization inventory.
boundary trait WindowsConsoleIo: |abi|::Calling<|windows_abi|::WindowsX64ScalarCalling> {
    machine write(descriptor: i32, buffer: @mutable i32, count: u32) -> i32
    requires descriptor == 1 && count <= 4
    reaches StandardOutput
    crashes none;

    // A console read waits for host input, so the import publishes `blocks`.
    machine read(descriptor: i32, buffer: @mutable i32, count: u32) -> i32
    requires descriptor == 0 && count <= 4
    reaches StandardInput
    blocks
    crashes none;

    // MSVCRT descriptors open in text mode, which translates CR LF pairs to a
    // single LF on reads, maps LF to CR LF on writes, and ends input at Ctrl+Z.
    // The console contract moves the authored bytes themselves, so read_byte and
    // write_byte put their descriptor in binary mode (`_O_BINARY`, 0x8000) before
    // moving data. `_setmode` is idempotent; calling it per operation keeps the
    // guarantee local to this provider with no separate descriptor-init hook.
    //   `int _setmode(int fd, int mode)`
    machine set_input_mode(descriptor: i32, mode: i32) -> i32
    requires descriptor == 0 && mode == 32768
    reaches StandardInput
    crashes none;

    machine set_output_mode(descriptor: i32, mode: i32) -> i32
    requires descriptor == 1 && mode == 32768
    reaches StandardOutput
    crashes none;
}

// A one-byte transfer yields Byte, zero bytes yields Eof. A failed binary-mode
// change, failed read, or invalid transfer count yields Error.
machine windows_console_read_byte() -> ByteRead
reaches StandardInput
blocks
crashes none
{
    let mode: i32 = WindowsConsoleHost::set_input_mode(0, 32768);
    transition mode == -1 {
        true -> failed(),
        false -> block read()
    }

    machine read() -> ByteRead {
        let mutable cell: i32 = 0;
        let count: i32 = block WindowsConsoleHost::read(0, @mutable cell, 1);
        transition count {
            1 -> byte(cell),
            0 -> end(),
            _ -> failed()
        }
    }

    machine byte(cell: i32) -> ByteRead {
        let value: u8 = narrow_i32_to_u8_wrapping(cell);
        ByteRead::Byte { value: widen_u8_to_i32(value) }
    }

    machine end() -> ByteRead { ByteRead::Eof }

    machine failed() -> ByteRead { ByteRead::Error }
}

// Descriptor 1 is stdout.
machine windows_console_write_byte(byte: i32)
reaches StandardOutput
{
    let mutable cell: i32 = byte;
    let mode: i32 = WindowsConsoleHost::set_output_mode(1, 32768);
    let written: i32 = WindowsConsoleHost::write(1, @mutable cell, 1);
}

// Windows x86-64 reaches MSVCRT through the Microsoft x64 placement above.
WindowsX64ConsoleHost satisfies WindowsConsoleHost {
    machine write(descriptor: i32, buffer: @mutable i32, count: u32) -> i32
    requires descriptor == 1 && count <= 4
    reaches StandardOutput crashes none {
        WindowsConsoleIo::write(descriptor, buffer, count)
    }
    machine read(descriptor: i32, buffer: @mutable i32, count: u32) -> i32
    requires descriptor == 0 && count <= 4
    reaches StandardInput blocks crashes none {
        block WindowsConsoleIo::read(descriptor, buffer, count)
    }
    machine set_input_mode(descriptor: i32, mode: i32) -> i32
    requires descriptor == 0 && mode == 32768
    reaches StandardInput crashes none {
        WindowsConsoleIo::set_input_mode(descriptor, mode)
    }
    machine set_output_mode(descriptor: i32, mode: i32) -> i32
    requires descriptor == 1 && mode == 32768
    reaches StandardOutput crashes none {
        WindowsConsoleIo::set_output_mode(descriptor, mode)
    }
}

WindowsConsoleBytes satisfies ConsoleByteOperations {
    machine read_byte() -> ByteRead
    reaches StandardInput blocks crashes none {
        block windows_console_read_byte()
    }
    machine write_byte(byte: i32) reaches StandardOutput {
        windows_console_write_byte(byte);
    }
}
