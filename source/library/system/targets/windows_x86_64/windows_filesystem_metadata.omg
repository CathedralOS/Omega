use filesystem_host.omg as paths;
use targets/windows_x86_64/windows_filesystem_control.omg as control;
use targets/windows_x86_64/windows_filesystem_metadata_native.omg as metadata_io;
use targets/windows_x86_64/windows_filesystem_native.omg as win_io;
use targets/windows_x86_64/windows_filesystem_paths.omg as windows_filesystem_paths;
use windows_filesystem_host.omg as win_fs;
use {omega}/language/core/filesystem_authority.omg as authority;
use {omega}/language/core/numeric_conversion.omg as numeric;

// A same-access duplicate pins one file object across the three metadata
// queries. Reopening by path could mix different objects after a rename; using
// the original number could mix objects after concurrent close/reuse. Pinning
// does not freeze concurrent writes to that object or grant new access rights.
// Capture each query error before releasing the pin. Cleanup cannot replace
// that primary failure, but a failed close cannot become a successful query.

machine windows_metadata_error() -> |win_fs|::WindowsMetadataResult {
    let code: u32 = |control|::windows_filesystem_native_last_error();
    transition code != 0 {
        true -> (|win_fs|::WindowsMetadataResult::Error { code: code }),
        false -> (|win_fs|::WindowsMetadataResult::Error { code: 31 })
    }
}

machine windows_filesystem_native_metadata(handle: u64) -> |win_fs|::WindowsMetadataResult
reaches |authority|::FilesystemMetadataQuery {
    let duplicate: u64 = |control|::windows_filesystem_native_duplicate_handle(handle);
    transition duplicate != 0 {
        true -> block query(duplicate),
        false -> (windows_metadata_error())
    }
    machine query(duplicate: u64) -> |win_fs|::WindowsMetadataResult {
        block windows_metadata_owned_handle(duplicate)
    }
}

machine windows_filesystem_native_read_metadata(path: @[u8] in |paths|::Path, no_follow: bool) -> |win_fs|::WindowsMetadataResult
reaches |authority|::FilesystemMetadataQuery {
    let mutable wide: [u16; 32768];
    let count: i64 = |windows_filesystem_paths|::windows_wide_path(path as - |paths|::Path, @mutable wide);
    wide[32767] = 0;
    transition count > 0 {
        true -> block select(wide as + |win_io|::WindowsNativePath, no_follow),
        false -> (|win_fs|::WindowsMetadataResult::Error { code: 87 })
    }
    machine select(wide: [u16; 32768] in |win_io|::WindowsNativePath, no_follow: bool) -> |win_fs|::WindowsMetadataResult {
        transition no_follow {
            true -> block open(wide, 36700160),
            false -> block open(wide, 34603008)
        }
    }
    machine open(wide: [u16; 32768] in |win_io|::WindowsNativePath, flags: u32) -> |win_fs|::WindowsMetadataResult
    requires flags == 34603008 || flags == 36700160 {
        let raw: i64 = block |metadata_io|::WindowsFilesystemMetadataIo::open_attributes(@wide, 128, 7, 0, 3, flags, 0);
        let handle: u64 = |control|::windows_filesystem_native_normalize_handle(raw);
        transition handle != 0 {
            true -> block query(handle),
            false -> (windows_metadata_error())
        }
    }
    machine query(handle: u64) -> |win_fs|::WindowsMetadataResult { block windows_metadata_owned_handle(handle) }
}

// The only callers supply either a successful same-access duplicate or a
// successful private metadata open. No borrowed caller handle is released.
machine windows_metadata_owned_handle(handle: u64) -> |win_fs|::WindowsMetadataResult
reaches |authority|::FilesystemMetadataQuery {
    let outcome: |win_fs|::WindowsMetadataResult = block windows_query_metadata(handle);
    let released: i32 = block |control|::windows_filesystem_native_close_handle(handle);
    windows_metadata_completion(outcome, released)
}

machine windows_metadata_completion(outcome: |win_fs|::WindowsMetadataResult, released: i32) -> |win_fs|::WindowsMetadataResult {
    transition outcome {
        |win_fs|::WindowsMetadataResult::Error { code } -> (|win_fs|::WindowsMetadataResult::Error { code: code }),
        |win_fs|::WindowsMetadataResult::Value { metadata } -> checked(metadata, released)
    }
    machine checked(metadata: |win_fs|::WindowsFileMetadata, released: i32) -> |win_fs|::WindowsMetadataResult {
        transition released == 0 {
            true -> (|win_fs|::WindowsMetadataResult::Value { metadata: metadata }),
            false -> (windows_metadata_error())
        }
    }
}

// GetFileInformationByHandleEx explicitly excludes pipes. Identity/liveness
// alone does not establish this premise. Clear the native error before the
// type query so a valid FILE_TYPE_UNKNOWN cannot inherit an unrelated error.
// https://learn.microsoft.com/windows/win32/api/fileapi/nf-fileapi-getfiletype
machine windows_classify_metadata_disk_file(handle: u64) -> i64 in |metadata_io|::WindowsDiskFileOrAbsent
reaches |authority|::FilesystemMetadataQuery {
    let classified: i64 = block windows_metadata_disk_file(handle);
    classified as + |metadata_io|::WindowsDiskFileOrAbsent
}

// Keep the raw predicate obligation independent of the qualification the
// authorized result boundary introduces. No internal state assumes issuance.
machine windows_metadata_disk_file(handle: u64) -> i64
ensures result != -1
reaches |authority|::FilesystemMetadataQuery {
    let raw: i64 = |numeric|::narrow_u64_to_i64_wrapping(handle);
    transition raw != 0 && raw != -1 {
        true -> block classify(raw),
        false -> refused(6)
    }
    machine classify(handle: i64) -> i64
    ensures result != -1
    requires handle != 0 && handle != -1 {
        |win_io|::WindowsFilesystemIo::c_set_last_error(0);
        let kind: u32 = block |metadata_io|::WindowsFilesystemMetadataIo::file_type(handle);
        transition kind == 1 {
            true -> (handle),
            false -> other(kind)
        }
    }
    machine other(kind: u32) -> i64
    ensures result != -1
    {
        transition kind == 0 {
            true -> unknown(),
            false -> refused(50)
        }
    }
    machine unknown() -> i64
    ensures result != -1
    {
        let code: u32 = |win_io|::WindowsFilesystemIo::c_get_last_error();
        transition code != 0 {
            true -> refused(code),
            false -> refused(50)
        }
    }
    machine refused(code: u32) -> i64
    ensures result != -1
    {
        |win_io|::WindowsFilesystemIo::c_set_last_error(code);
        0
    }
}

machine windows_query_metadata(handle: u64) -> |win_fs|::WindowsMetadataResult
reaches |authority|::FilesystemMetadataQuery {
    let classified: i64 in |metadata_io|::WindowsDiskFileOrAbsent = block windows_classify_metadata_disk_file(handle);
    transition (classified as - |metadata_io|::WindowsDiskFileOrAbsent) != 0 {
        true -> block basic(classified),
        false -> (windows_metadata_error())
    }
    machine basic(handle: i64 in |metadata_io|::WindowsDiskFileOrAbsent) -> |win_fs|::WindowsMetadataResult requires (handle as - |metadata_io|::WindowsDiskFileOrAbsent) != 0 {
        let mutable basic: |metadata_io|::WindowsNativeFileBasicInfo;
        let succeeded: i32 = block |metadata_io|::WindowsFilesystemMetadataIo::basic(handle, 0, @mutable basic, 40);
        transition succeeded != 0 {
            true -> block standard(handle, basic),
            false -> (windows_metadata_error())
        }
    }
    machine standard(handle: i64 in |metadata_io|::WindowsDiskFileOrAbsent, basic: |metadata_io|::WindowsNativeFileBasicInfo) -> |win_fs|::WindowsMetadataResult requires (handle as - |metadata_io|::WindowsDiskFileOrAbsent) != 0 {
        let mutable standard: |metadata_io|::WindowsNativeFileStandardInfo;
        let succeeded: i32 = block |metadata_io|::WindowsFilesystemMetadataIo::standard(handle, 1, @mutable standard, 24);
        transition succeeded != 0 {
            true -> block attributes(handle, basic, standard),
            false -> (windows_metadata_error())
        }
    }
    machine attributes(handle: i64 in |metadata_io|::WindowsDiskFileOrAbsent, basic: |metadata_io|::WindowsNativeFileBasicInfo, standard: |metadata_io|::WindowsNativeFileStandardInfo) -> |win_fs|::WindowsMetadataResult requires (handle as - |metadata_io|::WindowsDiskFileOrAbsent) != 0 {
        let mutable tag: |metadata_io|::WindowsNativeFileAttributeTagInfo;
        let succeeded: i32 = block |metadata_io|::WindowsFilesystemMetadataIo::attribute_tag(handle, 9, @mutable tag, 8);
        transition succeeded != 0 {
            true -> value(basic, standard, tag),
            false -> (windows_metadata_error())
        }
    }
    machine value(basic: |metadata_io|::WindowsNativeFileBasicInfo, standard: |metadata_io|::WindowsNativeFileStandardInfo, tag: |metadata_io|::WindowsNativeFileAttributeTagInfo) -> |win_fs|::WindowsMetadataResult {
        |win_fs|::WindowsMetadataResult::Value { metadata: |win_fs|::WindowsFileMetadata {
            length: standard.length, links: standard.links,
            attributes: tag.attributes, reparse_tag: tag.reparse_tag,
            creation_ticks: basic.creation_ticks, access_ticks: basic.access_ticks,
            write_ticks: basic.write_ticks, change_ticks: basic.change_ticks
        } }
    }
}
