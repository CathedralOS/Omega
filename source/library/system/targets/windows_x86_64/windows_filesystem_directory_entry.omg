use targets/windows_x86_64/windows_filesystem_control.omg as control;
use filesystem_host.omg as paths;
use targets/windows_x86_64/windows_filesystem_directory.omg as directory;
use targets/windows_x86_64/windows_filesystem_directory_native.omg as directory_io;
use targets/windows_x86_64/windows_filesystem_native.omg as win_io;
use targets/windows_x86_64/windows_filesystem_path_query_native.omg as path_io;
use windows_filesystem_host.omg as win_fs;
use system;
// Ordinal selection owns one private directory object and skips only dot rows.
// Metadata comes from that enumeration record, not a second pathname lookup
// which could select a replacement child. No ordering or snapshot is promised.
use omega\language\core\FilesystemContentRead;
use omega\language\core\FilesystemContentWrite;
use omega\language\core\FilesystemMetadataQuery;
use omega\language\core\FilesystemMetadataMutation;
use omega\language\core\DirectoryEnumeration;
use omega\language\core\FilesystemNamespaceMutation;
use omega\language\core\widen_u32_to_u64;
use omega\language\core\narrow_u64_to_i32_exact;
use omega\language\core\narrow_i32_to_u64_exact;
use omega\language\core\narrow_i64_to_u64_wrapping;

machine windows_filesystem_native_directory_nth(path: @[u8] in |paths|::Path, ordinal: u64) -> |win_fs|::WindowsDirectoryEntryResult
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation + DirectoryEnumeration + FilesystemMetadataQuery {
    let handle: i64 in WindowsPrivateNonalertFileOrAbsent = block |directory|::windows_directory_open(path);
    transition (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 { true -> block query(handle, ordinal), false -> (windows_directory_entry_error()) }
    machine query(handle: i64 in WindowsPrivateNonalertFileOrAbsent, ordinal: u64) -> |win_fs|::WindowsDirectoryEntryResult
    requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 {
        let result: |win_fs|::WindowsDirectoryEntryResult = block windows_directory_select(handle, ordinal);
        let released: i32 = block |control|::windows_filesystem_native_close_handle(narrow_i64_to_u64_wrapping(handle as -WindowsPrivateNonalertFileOrAbsent));
        transition released == 0 { true -> (result), false -> failed_close(result) }
    }
    machine failed_close(result: |win_fs|::WindowsDirectoryEntryResult) -> |win_fs|::WindowsDirectoryEntryResult {
        transition result {
            |win_fs|::WindowsDirectoryEntryResult::Error { code } -> (|win_fs|::WindowsDirectoryEntryResult::Error { code: code }),
            _ -> (windows_directory_entry_error())
        }
    }
}

machine windows_directory_entry_error() -> |win_fs|::WindowsDirectoryEntryResult {
    let code: u32 = |win_io|::WindowsFilesystemIo::c_get_last_error();
    transition code != 0 {
        true -> (|win_fs|::WindowsDirectoryEntryResult::Error { code: code }),
        false -> (|win_fs|::WindowsDirectoryEntryResult::Error { code: 31 })
    }
}

machine windows_directory_select(handle: i64 in WindowsPrivateNonalertFileOrAbsent, ordinal: u64) -> |win_fs|::WindowsDirectoryEntryResult
requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0
reaches DirectoryEnumeration + FilesystemMetadataQuery {
    let mutable output: |directory_io|::WindowsNativeDirectoryEntryInfo;
    transition { _ -> block next(handle, ordinal, @mutable output, 0) }
    machine next(handle: i64 in WindowsPrivateNonalertFileOrAbsent, ordinal: u64,
        output: @mutable |directory_io|::WindowsNativeDirectoryEntryInfo, position: u64) -> |win_fs|::WindowsDirectoryEntryResult
    requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 && position <= ordinal {
        let step: |directory|::WindowsDirectoryStep = block windows_directory_next_entry(handle, output, 0);
        transition step {
            |directory|::WindowsDirectoryStep::Error { code } -> (|win_fs|::WindowsDirectoryEntryResult::Error { code: code }),
            |directory|::WindowsDirectoryStep::End -> |win_fs|::WindowsDirectoryEntryResult::End,
            |directory|::WindowsDirectoryStep::Name { length } -> block name(handle, ordinal, output, position, length)
        }
    }
    machine name(handle: i64 in WindowsPrivateNonalertFileOrAbsent, ordinal: u64,
        output: @mutable |directory_io|::WindowsNativeDirectoryEntryInfo, position: u64, length: u64) -> |win_fs|::WindowsDirectoryEntryResult
    requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 && position <= ordinal {
        transition windows_directory_entry_dot(output, length) {
            true -> block next(handle, ordinal, output, position),
            false -> block selected(handle, ordinal, output, position, length)
        }
    }
    machine selected(handle: i64 in WindowsPrivateNonalertFileOrAbsent, ordinal: u64,
        output: @mutable |directory_io|::WindowsNativeDirectoryEntryInfo, position: u64, length: u64) -> |win_fs|::WindowsDirectoryEntryResult
    requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 && position <= ordinal {
        transition position < ordinal {
            true -> block next(handle, ordinal, output, position + 1),
            false -> (windows_directory_encode_entry(output, length))
        }
    }
}

machine windows_directory_next_entry(handle: i64 in WindowsPrivateNonalertFileOrAbsent,
    output: @mutable |directory_io|::WindowsNativeDirectoryEntryInfo, restart: u8) -> |directory|::WindowsDirectoryStep
requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 && restart <= 1
reaches DirectoryEnumeration + FilesystemMetadataQuery {
    let mutable completion: |win_io|::WindowsFilesystemIoStatus;
    let status: i32 = block |directory_io|::WindowsFilesystemDirectoryIo::next_entry(handle, 0, 0, 0, @mutable completion, output, 8256, 1, 1, 0, restart);
    transition status == 0 {
        true -> (windows_directory_decode_entry(output, completion.information)),
        false -> other(status)
    }
    machine other(status: i32) -> |directory|::WindowsDirectoryStep {
        transition status == -2147483642 || status == -1073741809 {
            true -> |directory|::WindowsDirectoryStep::End,
            false -> failed(status)
        }
    }
    machine failed(status: i32) -> |directory|::WindowsDirectoryStep {
        |directory|::WindowsDirectoryStep::Error { code: |win_io|::WindowsFilesystemIo::c_status_to_error(status) }
    }
}

machine windows_directory_decode_entry(output: @|directory_io|::WindowsNativeDirectoryEntryInfo, returned: u64) -> |directory|::WindowsDirectoryStep {
    transition returned >= 64 && returned <= 8256 {
        true -> record(output, returned),
        false -> (|directory|::WindowsDirectoryStep::Error { code: 122 })
    }
    machine record(output: @|directory_io|::WindowsNativeDirectoryEntryInfo, returned: u64) -> |directory|::WindowsDirectoryStep
    requires returned >= 64 && returned <= 8256 {
        let bytes: u64 = widen_u32_to_u64(output.name_bytes);
        transition (output.control & 4294967295) == 0 && bytes > 0 && bytes <= 8192
            && bytes % 2 == 0 && bytes <= returned - 64 {
            true -> (|directory|::WindowsDirectoryStep::Name { length: bytes / 2 }),
            false -> (|directory|::WindowsDirectoryStep::Error { code: 31 })
        }
    }
}

machine windows_directory_entry_dot(output: @|directory_io|::WindowsNativeDirectoryEntryInfo, length: u64) -> bool {
    transition length == 1 || length == 2 { true -> first(output, length), false -> false }
    machine first(output: @|directory_io|::WindowsNativeDirectoryEntryInfo, length: u64) -> bool {
        transition output.characters[0] == 46 { true -> second(output, length), false -> false }
    }
    machine second(output: @|directory_io|::WindowsNativeDirectoryEntryInfo, length: u64) -> bool {
        length == 1 || output.characters[1] == 46
    }
}

machine windows_directory_encode_entry(source: @|directory_io|::WindowsNativeDirectoryEntryInfo, characters: u64) -> |win_fs|::WindowsDirectoryEntryResult {
    transition characters > 0 && characters <= 255 {
        true -> encode(source, characters),
        false -> (|win_fs|::WindowsDirectoryEntryResult::Error { code: 31 })
    }
    machine encode(source: @|directory_io|::WindowsNativeDirectoryEntryInfo, characters: u64) -> |win_fs|::WindowsDirectoryEntryResult
    requires characters > 0 && characters <= 255 {
        let mutable encoded: [u8; 765];
        let native_count: i32 = narrow_u64_to_i32_exact(characters);
        let written: i32 = |path_io|::WindowsFilesystemUtf8Io::utf8::<4096, 765>(65001, 128, @source.characters,
            native_count, @mutable encoded, 765, 0, 0);
        transition written > 0 {
            true -> extent(@encoded, written, source.attributes),
            false -> (windows_directory_entry_error())
        }
    }
    machine extent(encoded: @[u8; 765], written: i32, attributes: u32) -> |win_fs|::WindowsDirectoryEntryResult
    requires written > 0 {
        let count: u64 = narrow_i32_to_u64_exact(written);
        transition count <= 765 {
            true -> (windows_directory_copy_entry(encoded, count, attributes)),
            false -> (|win_fs|::WindowsDirectoryEntryResult::Error { code: 122 })
        }
    }
}

machine windows_directory_copy_entry(source: @[u8; 765], count: u64, attributes: u32) -> |win_fs|::WindowsDirectoryEntryResult
requires count <= 765 {
    let mutable selected: |win_fs|::WindowsDirectoryEntry;
    selected.name_len = count;
    selected.attributes = attributes;
    windows_directory_copy_name(source, count, @mutable selected.name);
    |win_fs|::WindowsDirectoryEntryResult::Entry { entry: selected }
}

machine windows_directory_copy_name(source: @[u8; 765], count: u64, name: @mutable [u8; 765])
requires count <= 765 {
    transition { _ -> copy(source, count, name, 0) }
    machine copy(source: @[u8; 765], count: u64, name: @mutable [u8; 765], position: u64)
    requires count <= 765 {
        transition position < count { true -> store(source, count, name, position), false -> complete() }
    }
    machine store(source: @[u8; 765], count: u64, name: @mutable [u8; 765], position: u64)
    requires count <= 765 && position < count {
        name[position] = source[position];
        transition { _ -> copy(source, count, name, position + 1) }
    }
    machine complete() {}
}
