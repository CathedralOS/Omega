use targets/windows_x86_64/windows_filesystem_control.omg as control;
use targets/windows_x86_64/windows_filesystem_paths.omg as windows_filesystem_paths;
use targets/windows_x86_64/windows_filesystem_reparse_data.omg as reparse_data;
use filesystem_host.omg as paths;
use targets/windows_x86_64/windows_filesystem_metadata_native.omg as metadata_io;
use targets/windows_x86_64/windows_filesystem_path_query_native.omg as path_io;
use targets/windows_x86_64/windows_filesystem_reparse_native.omg as reparse_io;
use system;
// Stored link-target query. The fresh no-follow object never escapes before
// completion and close, so no external alias can change its synchronous mode.
// Decode/encode entirely in owned scratch before writing the requested caller
// byte prefix. read_link returns bytes, excludes NUL, and can fill count exactly
// like the portable POSIX operation; it does not claim a full-path result.
use omega\language\core\FilesystemMetadataQuery;
use omega\language\core\narrow_i64_to_i32_exact;
use omega\language\core\widen_i32_to_i64;
use omega\language\core\narrow_u64_to_i64_exact;
use omega\language\core\narrow_i32_to_u64_exact;
use omega\language\core\narrow_i64_to_u64_wrapping;

machine windows_open_reparse(path: @[u16; 32768] in WindowsNativePath) -> i64 in WindowsPrivateNonalertFileOrAbsent
reaches FilesystemMetadataQuery {
    let handle: i64 = block windows_open_reparse_handle(path);
    handle as +WindowsPrivateNonalertFileOrAbsent
}
machine windows_open_reparse_handle(path: @[u16; 32768] in WindowsNativePath) -> i64
ensures result != -1
reaches FilesystemMetadataQuery {
    let handle: i64 = block |metadata_io|::WindowsFilesystemMetadataIo::open_attributes(path, 128, 7, 0, 3, 36700160, 0);
    transition handle != 0 && handle != -1 { true -> (handle), false -> 0 }
}

machine windows_filesystem_native_read_link(path: @[u8] in |paths|::Path, output: @mutable [u8], count: u64) -> i64
reaches FilesystemMetadataQuery {
    transition count > 0 && count <= output.length { true -> block convert_path(path, output, count), false -> (-87) }
    machine convert_path(path: @[u8] in |paths|::Path, output: @mutable [u8], count: u64) -> i64 {
        let mutable wide: [u16; 32768];
        let units: i64 = |windows_filesystem_paths|::windows_wide_path(path as - |paths|::Path, @mutable wide);
        wide[32767] = 0;
        transition units > 0 { true -> block open(wide as +WindowsNativePath, output, count), false -> (-87) }
    }
    machine open(path: [u16; 32768] in WindowsNativePath, output: @mutable [u8], count: u64) -> i64 {
        let handle: i64 in WindowsPrivateNonalertFileOrAbsent = block windows_open_reparse(@path);
        transition (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 {
            true -> block query(handle, output, count),
            false -> (|control|::windows_filesystem_native_failure_i64())
        }
    }
    machine query(handle: i64 in WindowsPrivateNonalertFileOrAbsent, output: @mutable [u8], count: u64) -> i64
    requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0 {
        let result: i64 = block windows_reparse_query(handle, output, count);
        let released: i32 = block |control|::windows_filesystem_native_close_handle(narrow_i64_to_u64_wrapping(handle as -WindowsPrivateNonalertFileOrAbsent));
        transition result < 0 { true -> (result), false -> complete(result, released) }
    }
    machine complete(result: i64, released: i32) -> i64 {
        transition released < 0 { true -> (widen_i32_to_i64(released)), false -> (result) }
    }
}

machine windows_reparse_query(handle: i64 in WindowsPrivateNonalertFileOrAbsent, output: @mutable [u8], count: u64) -> i64
requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0
reaches FilesystemMetadataQuery {
    let mutable data: |reparse_io|::WindowsNativeReparseData;
    let mutable returned: u32 = 0;
    let succeeded: i32 = block |reparse_io|::WindowsFilesystemReparseIo::query(handle, 589992, 0, 0, @mutable data, 16384, @mutable returned, 0);
    transition succeeded != 0 {
        true -> decode(data, returned, output, count),
        false -> (|control|::windows_filesystem_native_failure_i64())
    }
    machine decode(data: |reparse_io|::WindowsNativeReparseData, returned: u32, output: @mutable [u8], count: u64) -> i64 {
        let mutable target: [u16; 8192];
        let units: i64 = |reparse_data|::windows_reparse_target(@data, returned, @mutable target);
        transition units > 0 && units < 8192 { true -> encode(target, units, output, count), false -> failed_decode(units) }
    }
    machine failed_decode(units: i64) -> i64 {
        transition units < 0 { true -> (units), false -> (-31) }
    }
    machine encode(target: [u16; 8192], units: i64, output: @mutable [u8], count: u64) -> i64
    requires units > 0 && units < 8192 {
        let native_units: i32 = narrow_i64_to_i32_exact(units);
        let mutable encoded: [u8; 24576];
        let written: i32 = |path_io|::WindowsFilesystemUtf8Io::utf8::<8192, 24576>(65001, 128, @target, native_units, @mutable encoded, 24576, 0, 0);
        transition written > 0 {
            true -> extent(@encoded, written, output, count),
            false -> (|control|::windows_filesystem_native_failure_i64())
        }
    }
    machine extent(encoded: @[u8; 24576], written: i32, output: @mutable [u8], count: u64) -> i64
    requires written > 0 {
        transition written <= 24576 {
            true -> (windows_reparse_copy_bytes(encoded, written, output, count)),
            false -> (-31)
        }
    }
}

machine windows_reparse_copy_bytes(source: @[u8; 24576], written: i32, output: @mutable [u8], count: u64) -> i64
requires written > 0 && written <= 24576 {
    let length: u64 = narrow_i32_to_u64_exact(written);
    transition count <= output.length {
        true -> limit(source, length, output, count),
        false -> (-87)
    }
    machine limit(source: @[u8; 24576], length: u64, output: @mutable [u8], count: u64) -> i64
    requires length <= 24576 && count <= output.length {
        transition length < count { true -> copy(source, output, length, 0), false -> copy(source, output, count, 0) }
    }
    machine copy(source: @[u8; 24576], output: @mutable [u8], count: u64, position: u64) -> i64
    requires count <= 24576 && count <= output.length {
        transition position < count { true -> store(source, output, count, position), false -> (narrow_u64_to_i64_exact(count)) }
    }
    machine store(source: @[u8; 24576], output: @mutable [u8], count: u64, position: u64) -> i64
    requires count <= 24576 && count <= output.length && position < count {
        output[position] = source[position];
        transition { _ -> copy(source, output, count, position + 1) }
    }
}
