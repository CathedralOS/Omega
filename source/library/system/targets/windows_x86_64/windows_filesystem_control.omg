use targets/windows_x86_64/windows_filesystem_paths.omg as windows_filesystem_paths;
use filesystem_host.omg as paths;
use targets/windows_x86_64/windows_filesystem_native.omg as win_io;
use windows_filesystem_host.omg as win_fs;
use system;
// Synchronous handle, path, timestamp and namespace operations. Errors are
// captured immediately after their native call; no provider error cache exists.
use omega\language\core\FilesystemContentRead;
use omega\language\core\FilesystemContentWrite;
use omega\language\core\FilesystemMetadataQuery;
use omega\language\core\FilesystemMetadataMutation;
use omega\language\core\FilesystemNamespaceMutation;
use omega\language\core\narrow_u64_to_u32_wrapping;
use omega\language\core\narrow_i64_to_i32_wrapping;
use omega\language\core\widen_u32_to_i64;
use omega\language\core\narrow_u64_to_i64_wrapping;
use omega\language\core\narrow_i64_to_u64_wrapping;

// Read GetLastError before any other native operation. Status-only methods
// retain their i32 carrier: zero/oversized codes become ERROR_GEN_FAILURE,
// rather than wrapping a failure into a success. last_error still exposes the
// untouched full native code. Byte-count methods can negate every u32 exactly.
machine windows_filesystem_native_failure_i32() -> i32
{
    let code: u32 = |win_io|::WindowsFilesystemIo::c_get_last_error();
    transition code > 0 && code <= 2147483647 {
        true -> (narrow_i64_to_i32_wrapping(0 - widen_u32_to_i64(code))),
        _ -> (-31)
    }
}
machine windows_filesystem_native_failure_i64() -> i64
{
    let code: u32 = |win_io|::WindowsFilesystemIo::c_get_last_error();
    transition code != 0 { true -> (0 - widen_u32_to_i64(code)), _ -> (-31) }
}

// A HANDLE is opaque: reject only NULL and INVALID_HANDLE_VALUE, not every
// high-bit value. Synchronous transfers do not accept FILE_FLAG_OVERLAPPED.
machine windows_filesystem_native_normalize_handle(handle: i64) -> u64 {
    transition handle != 0 && handle != -1 {
        true -> (narrow_i64_to_u64_wrapping(handle)),
        _ -> (0)
    }
}
machine windows_filesystem_native_invalid_handle() -> u64
{
    |win_io|::WindowsFilesystemIo::c_set_last_error(87);
    0
}
machine windows_filesystem_native_completion_status(succeeded: i32) -> i32
{
    transition succeeded == 0 {
        true -> (windows_filesystem_native_failure_i32()),
        _ -> (0)
    }
}
machine windows_filesystem_native_create_file(path: @[u8] in |paths|::Path, desired_access: u32, share_mode: u32, creation_disposition: u32, flags_and_attributes: u32) -> u64
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mutable wide: [u16; 32768];
    let count: i64 = |windows_filesystem_paths|::windows_wide_path(path as - |paths|::Path, @mutable wide);
    wide[32767] = 0;
    let native_wide: [u16; 32768] in WindowsNativePath = wide as +WindowsNativePath;
    transition count > 0 && (flags_and_attributes & 1073741824) == 0 {
        true -> (windows_filesystem_native_normalize_handle(block |win_io|::WindowsFilesystemIo::c_create_file(@native_wide, desired_access, share_mode, 0, creation_disposition, flags_and_attributes, 0))),
        _ -> (windows_filesystem_native_invalid_handle())
    }
}

machine windows_filesystem_native_close_handle(handle: u64) -> i32
{
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    let ok: i32 = block |win_io|::WindowsFilesystemIo::c_close_handle(raw_handle);
    transition ok == 0 {
        true -> failed(),
        _ -> (0)
    }

    machine failed() -> i32 {
        transition { _ -> (windows_filesystem_native_failure_i32()) }
    }
}

machine windows_filesystem_native_last_error() -> u32
{
    |win_io|::WindowsFilesystemIo::c_get_last_error()
}

machine windows_filesystem_native_flush_file_buffers(handle: u64) -> i32
{
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    windows_filesystem_native_completion_status(block |win_io|::WindowsFilesystemIo::c_flush_file_buffers(raw_handle))
}
machine windows_filesystem_native_set_file_pointer(handle: u64, distance: i64, method: u32) -> i64
{
    let mutable position: i64 = 0;
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    let succeeded: i32 = block |win_io|::WindowsFilesystemIo::c_set_file_pointer(raw_handle, distance, @mutable position, method);
    transition succeeded == 0 { true -> (windows_filesystem_native_failure_i64()), _ -> (position) }
}
machine windows_filesystem_native_duplicate_handle(handle: u64) -> u64
{
    let process: i64 = |win_io|::WindowsFilesystemIo::c_get_current_process();
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    let mutable duplicate: i64 = 0;
    let succeeded: i32 = |win_io|::WindowsFilesystemIo::c_duplicate_handle(process, raw_handle, process, @mutable duplicate, 0, 0, 2);
    transition succeeded == 0 { true -> (0), _ -> (windows_filesystem_native_normalize_handle(duplicate)) }
}
machine windows_filesystem_native_move_file(from: @[u8] in |paths|::Path, to: @[u8] in |paths|::Path, flags: u32) -> i32
reaches FilesystemContentRead + FilesystemContentWrite + FilesystemMetadataMutation + FilesystemNamespaceMutation {
    let mutable wide_from: [u16; 32768];
    let mutable wide_to: [u16; 32768];
    let from_count: i64 = |windows_filesystem_paths|::windows_wide_path(from as - |paths|::Path, @mutable wide_from);
    wide_from[32767] = 0;
    let native_wide_from: [u16; 32768] in WindowsNativePath = wide_from as +WindowsNativePath;
    let to_count: i64 = |windows_filesystem_paths|::windows_wide_path(to as - |paths|::Path, @mutable wide_to);
    wide_to[32767] = 0;
    let native_wide_to: [u16; 32768] in WindowsNativePath = wide_to as +WindowsNativePath;
    transition from_count > 0 && to_count > 0 {
        true -> (windows_filesystem_native_completion_status(block |win_io|::WindowsFilesystemIo::c_move_file(@native_wide_from, @native_wide_to, flags))),
        _ -> (-87)
    }
}

machine windows_filesystem_native_rename_file(from: @[u8] in |paths|::Path, to: @[u8] in |paths|::Path) -> i32
reaches FilesystemNamespaceMutation {
    let mutable wide_from: [u16; 32768];
    let mutable wide_to: [u16; 32768];
    let from_count: i64 = |windows_filesystem_paths|::windows_wide_path(from as - |paths|::Path, @mutable wide_from);
    wide_from[32767] = 0;
    let native_wide_from: [u16; 32768] in WindowsNativePath = wide_from as +WindowsNativePath;
    let to_count: i64 = |windows_filesystem_paths|::windows_wide_path(to as - |paths|::Path, @mutable wide_to);
    wide_to[32767] = 0;
    let native_wide_to: [u16; 32768] in WindowsNativePath = wide_to as +WindowsNativePath;
    transition from_count > 0 && to_count > 0 {
        true -> (windows_filesystem_native_completion_status(block |win_io|::WindowsFilesystemIo::c_rename_file(@native_wide_from, @native_wide_to, 1))),
        _ -> (-87)
    }
}
machine windows_filesystem_native_hard_link(original: @[u8] in |paths|::Path, link: @[u8] in |paths|::Path) -> i32
reaches FilesystemNamespaceMutation {
    let mutable wide_original: [u16; 32768];
    let mutable wide_link: [u16; 32768];
    let original_count: i64 = |windows_filesystem_paths|::windows_wide_path(original as - |paths|::Path, @mutable wide_original);
    wide_original[32767] = 0;
    let native_wide_original: [u16; 32768] in WindowsNativePath = wide_original as +WindowsNativePath;
    let link_count: i64 = |windows_filesystem_paths|::windows_wide_path(link as - |paths|::Path, @mutable wide_link);
    wide_link[32767] = 0;
    let native_wide_link: [u16; 32768] in WindowsNativePath = wide_link as +WindowsNativePath;
    transition original_count > 0 && link_count > 0 {
        true -> (windows_filesystem_native_completion_status(block |win_io|::WindowsFilesystemIo::c_hard_link(@native_wide_link, @native_wide_original, 0))),
        false -> (-87)
    }
}

// FILETIME is two little-endian DWORDs, not an arbitrary borrowed Omega u64.
// Encode the public by-value timestamps into their native records before
// lending them. A forwarded shared scalar loan may describe narrower storage;
// its logical u64 type alone cannot authorize an eight-byte foreign read.
machine windows_filesystem_native_set_file_time(handle: u64, access_time: u64, write_time: u64) -> i32
reaches FilesystemMetadataMutation {
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    let mutable access_record: [u32; 2];
    access_record[0] = narrow_u64_to_u32_wrapping(access_time);
    access_record[1] = narrow_u64_to_u32_wrapping(access_time >> 32);
    let mutable write_record: [u32; 2];
    write_record[0] = narrow_u64_to_u32_wrapping(write_time);
    write_record[1] = narrow_u64_to_u32_wrapping(write_time >> 32);
    windows_filesystem_native_completion_status(block |win_io|::WindowsFilesystemIo::c_set_file_time(raw_handle, 0, @access_record, @write_record))
}
machine windows_filesystem_native_get_file_time(handle: u64) -> |win_fs|::WindowsFileTimeResult
reaches FilesystemMetadataQuery {
    let raw_handle: i64 = narrow_u64_to_i64_wrapping(handle);
    let mutable access_time: u64 = 0;
    let mutable write_time: u64 = 0;
    let succeeded: i32 = block |win_io|::WindowsFilesystemIo::c_get_file_time(raw_handle, 0, @mutable access_time, @mutable write_time);
    transition succeeded == 0 { true -> failed(), _ -> value(access_time, write_time) }
    machine failed() -> |win_fs|::WindowsFileTimeResult {
        let code: u32 = |win_io|::WindowsFilesystemIo::c_get_last_error();
        |win_fs|::WindowsFileTimeResult::Error { code: code }
    }
    machine value(access_time: u64, write_time: u64) -> |win_fs|::WindowsFileTimeResult {
        |win_fs|::WindowsFileTimeResult::Value { access_time: access_time, write_time: write_time }
    }
}
machine windows_filesystem_native_set_file_attributes(path: @[u8] in |paths|::Path, attributes: u32) -> i32
reaches FilesystemMetadataMutation {
    let mutable wide: [u16; 32768];
    let count: i64 = |windows_filesystem_paths|::windows_wide_path(path as - |paths|::Path, @mutable wide);
    wide[32767] = 0;
    let native_wide: [u16; 32768] in WindowsNativePath = wide as +WindowsNativePath;
    transition count > 0 {
        true -> (windows_filesystem_native_completion_status(block |win_io|::WindowsFilesystemIo::c_set_file_attributes(@native_wide, attributes))),
        _ -> (-87)
    }
}
