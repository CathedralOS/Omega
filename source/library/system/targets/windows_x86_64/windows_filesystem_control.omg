machine windows_filesystem_native_delete_file(path: @[u8] in |paths|::Path) -> i32
reaches FilesystemNamespaceMutation {
    let mutable wide: [u16; 32768];
    let count: i64 = |windows_filesystem_paths|::windows_wide_path(path as - |paths|::Path, @mutable wide);
    wide[32767] = 0;
