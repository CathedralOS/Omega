use targets/windows_x86_64/windows_filesystem_metadata.omg as classifier;
use targets/windows_x86_64/windows_filesystem_native.omg as win_io;
use {omega}/language/core/access/access.omg as access;
use {omega}/language/core/filesystem_authority.omg as authority;
use {omega}/language/core/layout.omg as layout;
use {omega}/language/core/reflect/reflect.omg as reflect;

// GetFileInformationByHandleEx owns synchronous output completion. Its class
// selects the complete record, not an untyped byte-count promise. The x64 SDK
// records are FILE_BASIC_INFO (40 bytes), FILE_STANDARD_INFO (24 bytes), and
// FILE_ATTRIBUTE_TAG_INFO (8 bytes). BOOLEAN fields are bytes, not Win32 BOOLs.
// Private path opens require anonymous SQOS even before disk classification;
// a rejected non-disk endpoint must not acquire the caller's identity first.
//
// https://learn.microsoft.com/windows/win32/api/winbase/nf-winbase-getfileinformationbyhandleex
// https://learn.microsoft.com/windows/win32/api/winbase/ns-winbase-file_basic_info
// https://learn.microsoft.com/windows/win32/api/winbase/ns-winbase-file_standard_info
// https://learn.microsoft.com/windows/win32/api/winbase/ns-winbase-file_attribute_tag_info

// A pinned disk-file classification, not ownership of arbitrary integers.
// Zero is the failed classifier result; queries also require nonzero.
domain i64::WindowsDiskFileOrAbsent
requires self != -1
access WindowsDiskFileIssuance;

WindowsDiskFileIssuance satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan reaches none crashes none terminates {
        |access|::new_plan(@schema, |layout|::Issuance::Only { routes: [
            |reflect|::callable(|classifier|::windows_classify_metadata_disk_file)
        ] })
    }
}

data WindowsNativeFileBasicInfo {
    creation_ticks: u64;
    access_ticks: u64;
    write_ticks: u64;
    change_ticks: u64;
    attributes: u32;
    padding: u32;
}
data WindowsNativeFileStandardInfo {
    allocation_size: i64;
    length: i64;
    links: u32;
    delete_pending: u8;
    directory: u8;
    padding: [u8; 2];
}
data WindowsNativeFileAttributeTagInfo { attributes: u32; reparse_tag: u32; }

boundary trait WindowsFilesystemMetadataIo {
    machine file_type(handle: i64) -> u32 reaches |authority|::FilesystemMetadataQuery blocks crashes none;
    machine open_attributes(path: @[u16; 32768] in |win_io|::WindowsNativePath, desired_access: u32, sharing: u32, security: u64, disposition: u32, flags: u32, template: u64) -> i64
    requires desired_access == 128 && sharing == 7 && security == 0 && disposition == 3
        && (flags == 34603008 || flags == 36700160) && template == 0
    reaches |authority|::FilesystemMetadataQuery blocks
    crashes none;
    machine basic(handle: i64 in WindowsDiskFileOrAbsent, information_class: u32, output: @mutable WindowsNativeFileBasicInfo, size: u32) -> i32
    requires (handle as -WindowsDiskFileOrAbsent) != 0 && information_class == 0 && size == 40
    reaches |authority|::FilesystemMetadataQuery blocks
    crashes none;
    machine standard(handle: i64 in WindowsDiskFileOrAbsent, information_class: u32, output: @mutable WindowsNativeFileStandardInfo, size: u32) -> i32
    requires (handle as -WindowsDiskFileOrAbsent) != 0 && information_class == 1 && size == 24
    reaches |authority|::FilesystemMetadataQuery blocks
    crashes none;
    machine attribute_tag(handle: i64 in WindowsDiskFileOrAbsent, information_class: u32, output: @mutable WindowsNativeFileAttributeTagInfo, size: u32) -> i32
    requires (handle as -WindowsDiskFileOrAbsent) != 0 && information_class == 9 && size == 8
    reaches |authority|::FilesystemMetadataQuery blocks
    crashes none;
}
