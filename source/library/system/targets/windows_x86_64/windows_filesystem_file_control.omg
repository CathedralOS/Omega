use filesystem_host.omg as paths;
use targets/windows_x86_64/windows_filesystem_control.omg as control;
use targets/windows_x86_64/windows_filesystem_file_control_native.omg as control_io;
use targets/windows_x86_64/windows_filesystem_metadata.omg as classifier;
use targets/windows_x86_64/windows_filesystem_metadata_native.omg as metadata_io;
use targets/windows_x86_64/windows_filesystem_native.omg as win_io;
use targets/windows_x86_64/windows_filesystem_paths.omg as windows_filesystem_paths;
use {omega}/language/core/filesystem_authority.omg as authority;
use {omega}/language/core/numeric_conversion.omg as numeric;

// Pin the exact object for every handle operation. Length changes use the
// native end-of-file information class and never seek the shared cursor.
// Attribute updates resolve a path once, retain unrelated observed attributes,
// and leave all timestamps unchanged; this is not atomic against another
// writer changing those same attributes. Capture failure before releasing.

machine windows_file_control_completion(status: i32, released: i32) -> i32 {
    transition status != 0 { true -> (status), false -> (released) }
}

machine windows_filesystem_native_set_file_length(handle: u64, length: i64) -> i32
reaches |authority|::FilesystemContentWrite + |authority|::FilesystemMetadataMutation {
    transition length >= 0 {
        true -> block pin(handle, length),
        false -> (-87)
    }
    machine pin(handle: u64, length: i64) -> i32 {
        let duplicate: u64 = |control|::windows_filesystem_native_duplicate_handle(handle);
        transition duplicate != 0 { true -> block update(duplicate, length), false -> failed() }
    }
    machine failed() -> i32 { |control|::windows_filesystem_native_failure_i32() }
    machine update(duplicate: u64, length: i64) -> i32 {
        let input: |control_io|::WindowsNativeFileEndOfFileInfo = |control_io|::WindowsNativeFileEndOfFileInfo { length: length };
        let raw: i64 = |numeric|::narrow_u64_to_i64_wrapping(duplicate);
        let succeeded: i32 = block |control_io|::WindowsFilesystemFileControlIo::end_of_file(raw, 6, @input, 8);
        let status: i32 = |control|::windows_filesystem_native_completion_status(succeeded);
        let released: i32 = block |control|::windows_filesystem_native_close_handle(duplicate);
        windows_file_control_completion(status, released)
    }
}

machine windows_filesystem_native_set_handle_readonly(handle: u64, readonly: bool) -> i32
reaches |authority|::FilesystemMetadataQuery + |authority|::FilesystemMetadataMutation {
    let duplicate: u64 = |control|::windows_filesystem_native_duplicate_handle(handle);
    transition duplicate != 0 { true -> block update(duplicate, readonly), false -> failed() }
    machine failed() -> i32 { |control|::windows_filesystem_native_failure_i32() }
    machine update(duplicate: u64, readonly: bool) -> i32 {
        block windows_set_readonly_owned(duplicate, readonly)
    }
}

machine windows_filesystem_native_set_path_readonly(path: @[u8] in |paths|::Path, readonly: bool) -> i32
reaches |authority|::FilesystemMetadataQuery + |authority|::FilesystemMetadataMutation {
    let mutable wide: [u16; 32768];
    let count: i64 = |windows_filesystem_paths|::windows_wide_path(path as - |paths|::Path, @mutable wide);
    wide[32767] = 0;
    transition count > 0 { true -> block acquire(wide as + |win_io|::WindowsNativePath, readonly), false -> (-87) }
    machine acquire(wide: [u16; 32768] in |win_io|::WindowsNativePath, readonly: bool) -> i32 {
        let raw: i64 = block |control_io|::WindowsFilesystemFileControlIo::open_attributes(@wide, 384, 7, 0, 3, 34603008, 0);
        let handle: u64 = |control|::windows_filesystem_native_normalize_handle(raw);
        transition handle != 0 { true -> block update(handle, readonly), false -> failed() }
    }
    machine failed() -> i32 { |control|::windows_filesystem_native_failure_i32() }
    machine update(handle: u64, readonly: bool) -> i32 { block windows_set_readonly_owned(handle, readonly) }
}

machine windows_set_readonly_owned(handle: u64, readonly: bool) -> i32
reaches |authority|::FilesystemMetadataQuery + |authority|::FilesystemMetadataMutation {
    let status: i32 = block windows_update_readonly(handle, readonly);
    let released: i32 = block |control|::windows_filesystem_native_close_handle(handle);
    windows_file_control_completion(status, released)
}

machine windows_update_readonly(handle: u64, readonly: bool) -> i32
reaches |authority|::FilesystemMetadataQuery + |authority|::FilesystemMetadataMutation {
    let classified: i64 in |metadata_io|::WindowsDiskFileOrAbsent = block |classifier|::windows_classify_metadata_disk_file(handle);
    transition (classified as - |metadata_io|::WindowsDiskFileOrAbsent) != 0 { true -> block query(classified, readonly), false -> failed() }
    machine failed() -> i32 { |control|::windows_filesystem_native_failure_i32() }
    machine query(handle: i64 in |metadata_io|::WindowsDiskFileOrAbsent, readonly: bool) -> i32 requires (handle as - |metadata_io|::WindowsDiskFileOrAbsent) != 0 {
        let mutable current: |metadata_io|::WindowsNativeFileBasicInfo;
        let succeeded: i32 = block |metadata_io|::WindowsFilesystemMetadataIo::basic(handle, 0, @mutable current, 40);
        // The classifier authorizes the typed query. The setter accepts the
        // ordinary HANDLE contract and reports incompatible objects as errors.
        transition succeeded != 0 { true -> block select(handle as - |metadata_io|::WindowsDiskFileOrAbsent, current.attributes, readonly), false -> failed() }
    }
    machine select(handle: i64, attributes: u32, readonly: bool) -> i32 {
        transition readonly {
            true -> block update(handle, (attributes & 4294967167) | 1),
            false -> block writable(handle, attributes & 4294967294)
        }
    }
    machine writable(handle: i64, attributes: u32) -> i32 {
        transition attributes == 0 { true -> block update(handle, 128), false -> block update(handle, attributes) }
    }
    machine update(handle: i64, attributes: u32) -> i32 {
        let input: |metadata_io|::WindowsNativeFileBasicInfo = |metadata_io|::WindowsNativeFileBasicInfo {
            creation_ticks: 0, access_ticks: 0, write_ticks: 0, change_ticks: 0,
            attributes: attributes, padding: 0
        };
        let succeeded: i32 = block |control_io|::WindowsFilesystemFileControlIo::basic(handle, 0, @input, 40);
        |control|::windows_filesystem_native_completion_status(succeeded)
    }
}
