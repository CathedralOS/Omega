use calling.omg as abi;
use {omega}/language/core/extent.omg as storage;
use uefi_x86_64_handoff.omg as boot;

// Target-owned UEFI x86-64 physical contract. Source-owned firmware calls
// obtain Loaded Image geometry; an application explicitly selects its checked
// physical adapter. The generated shell enters the adapter under this calling
// policy. The adapter validates arrival, obtains the image and initial storage
// through scoped firmware providers, accounts for its stack, and crosses
// ProgramStorageEntry::enter. The ABI alone conveys no storage grant or
// firmware-service authority.
public data EfiImageHandle {
    raw: addr;
}

public boundary data EfiSystemTable;

public data EfiStatus {
    code: u64;
}

public boundary trait UefiPhysicalEntry {
    machine enter(
        image_handle: EfiImageHandle,
        system_table: @EfiSystemTable
    ) -> EfiStatus
        reaches |boot|::UefiBootServices
        invokes |storage|::ProgramStorageEntry
        crashes Trap crashes Abort;
}

UefiX86_64CallingPolicy satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        uefi_x86_64_plan(signature)
    }
}

machine uefi_x86_64_plan(
    signature: |abi|::BoundarySignature
) -> |abi|::BoundaryPlanResult
    satisfies |abi|::CallingPolicy::plan
{
    transition signature.parameter_count == 2 {
        true -> select_surface(signature),
        _ -> reject()
    }

    machine select_surface(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        transition signature.has_result {
            true -> accept_physical(
                signature,
                signature.parameters[0],
                signature.parameters[1],
                signature.result
            ),
            _ -> accept_semantic(
                signature,
                signature.parameters[0],
                signature.parameters[1]
            )
        }
    }

    machine accept_semantic(
        signature: |abi|::BoundarySignature,
        image: u64,
        initial_storage: u64
    ) -> |abi|::BoundaryPlanResult {
        transition image < 256 && initial_storage < 256 {
            true -> build(signature, image, initial_storage),
            _ -> reject()
        }
    }

    machine build(
        signature: |abi|::BoundarySignature,
        image: u64,
        initial_storage: u64
    ) -> |abi|::BoundaryPlanResult
    requires image < 256 && initial_storage < 256 {
        let mutable output: |abi|::BoundaryEntryPlan;
        output.call.convention = |abi|::CallingConvention::MicrosoftX64;
        output.call.parameter_count = 2;

        output.call.parameters[0].shape.class = |abi|::AbiValueClass::Integer;
        output.call.parameters[0].shape.byte_size = signature.shapes[image].byte_size;
        output.call.parameters[0].shape.alignment = signature.shapes[image].alignment;
        output.call.parameters[0].location_count = 1;
        output.call.parameters[0].locations[0] = |abi|::ValueLocation::Indirect {
            pointer: |abi|::IndirectPointerLocation::Register {
                register: |abi|::MachineRegister::X86Rcx,
            },
            has_copy: true,
            copy_stack_byte_offset: 32,
            byte_size: signature.shapes[image].byte_size,
            alignment: signature.shapes[image].alignment,
        };

        output.call.parameters[1].shape.class = |abi|::AbiValueClass::Integer;
        output.call.parameters[1].shape.byte_size = signature.shapes[initial_storage].byte_size;
        output.call.parameters[1].shape.alignment = signature.shapes[initial_storage].alignment;
        output.call.parameters[1].location_count = 1;
        output.call.parameters[1].locations[0] = |abi|::ValueLocation::Indirect {
            pointer: |abi|::IndirectPointerLocation::Register {
                register: |abi|::MachineRegister::X86Rdx,
            },
            has_copy: true,
            copy_stack_byte_offset: 48,
            byte_size: signature.shapes[initial_storage].byte_size,
            alignment: signature.shapes[initial_storage].alignment,
        };

        output.call.ordinary_clobbers.register_count = 7;
        output.call.ordinary_clobbers.registers[0] = |abi|::MachineRegister::X86Rax;
        output.call.ordinary_clobbers.registers[1] = |abi|::MachineRegister::X86Rcx;
        output.call.ordinary_clobbers.registers[2] = |abi|::MachineRegister::X86Rdx;
        output.call.ordinary_clobbers.registers[3] = |abi|::MachineRegister::X86R8;
        output.call.ordinary_clobbers.registers[4] = |abi|::MachineRegister::X86R9;
        output.call.ordinary_clobbers.registers[5] = |abi|::MachineRegister::X86R10;
        output.call.ordinary_clobbers.registers[6] = |abi|::MachineRegister::X86R11;
        output.call.stack_alignment = 16;
        output.call.shadow_bytes = 32;
        output.call.entry_control = |abi|::EntryControl::CallReturn;

        output.state.initial_regime = |abi|::MachineRegime::X86Long64;
        output.state.permitted_transitive_use.general_registers = true;
        // The bridge preserves inbound XMM registers while calling the ordinary body.
        output.state.permitted_transitive_use.vector_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.permitted_transitive_use.instruction_pointer = true;
        output.state.permitted_transitive_use.stack_pointer = true;
        // Firmware entry may establish descriptor tables and kernel segments.
        output.state.permitted_transitive_use.control_state = true;
        output.state.permitted_transitive_use.segment_state = true;
        output.state.stack = |abi|::EntryStack::ProviderSelected;
        output.state.preemption = |abi|::Preemption::NotApplicable;
        |abi|::BoundaryPlanResult::Accepted { plan: output }
    }

    machine accept_physical(
        signature: |abi|::BoundarySignature,
        image_handle: u64,
        system_table: u64,
        status: u64
    ) -> |abi|::BoundaryPlanResult {
        transition image_handle < 256 && system_table < 256 && status < 256 {
            true -> build_physical(signature, image_handle, system_table, status),
            _ -> reject()
        }
    }

    machine build_physical(
        signature: |abi|::BoundarySignature,
        image_handle: u64,
        system_table: u64,
        status: u64
    ) -> |abi|::BoundaryPlanResult
    requires image_handle < 256 && system_table < 256 && status < 256 {
        let mutable output: |abi|::BoundaryEntryPlan;
        output.call.convention = |abi|::CallingConvention::MicrosoftX64;
        output.call.parameter_count = 2;

        output.call.parameters[0].shape.class = |abi|::AbiValueClass::Integer;
        output.call.parameters[0].shape.byte_size = signature.shapes[image_handle].byte_size;
        output.call.parameters[0].shape.alignment = signature.shapes[image_handle].alignment;
        output.call.parameters[0].location_count = 1;
        output.call.parameters[0].locations[0] = |abi|::ValueLocation::Register {
            register: |abi|::MachineRegister::X86Rcx,
            value_byte_offset: 0,
            byte_size: signature.shapes[image_handle].byte_size,
        };

        output.call.parameters[1].shape.class = |abi|::AbiValueClass::Integer;
        output.call.parameters[1].shape.byte_size = signature.shapes[system_table].byte_size;
        output.call.parameters[1].shape.alignment = signature.shapes[system_table].alignment;
        output.call.parameters[1].location_count = 1;
        output.call.parameters[1].locations[0] = |abi|::ValueLocation::Register {
            register: |abi|::MachineRegister::X86Rdx,
            value_byte_offset: 0,
            byte_size: signature.shapes[system_table].byte_size,
        };

        output.call.has_result = true;
        output.call.result.shape.class = |abi|::AbiValueClass::Integer;
        output.call.result.shape.byte_size = signature.shapes[status].byte_size;
        output.call.result.shape.alignment = signature.shapes[status].alignment;
        output.call.result.location_count = 1;
        output.call.result.locations[0] = |abi|::ValueLocation::Register {
            register: |abi|::MachineRegister::X86Rax,
            value_byte_offset: 0,
            byte_size: signature.shapes[status].byte_size,
        };

        output.call.ordinary_clobbers.register_count = 7;
        output.call.ordinary_clobbers.registers[0] = |abi|::MachineRegister::X86Rax;
        output.call.ordinary_clobbers.registers[1] = |abi|::MachineRegister::X86Rcx;
        output.call.ordinary_clobbers.registers[2] = |abi|::MachineRegister::X86Rdx;
        output.call.ordinary_clobbers.registers[3] = |abi|::MachineRegister::X86R8;
        output.call.ordinary_clobbers.registers[4] = |abi|::MachineRegister::X86R9;
        output.call.ordinary_clobbers.registers[5] = |abi|::MachineRegister::X86R10;
        output.call.ordinary_clobbers.registers[6] = |abi|::MachineRegister::X86R11;
        output.call.stack_alignment = 16;
        output.call.shadow_bytes = 32;
        output.call.entry_control = |abi|::EntryControl::CallReturn;

        output.state.initial_regime = |abi|::MachineRegime::X86Long64;
        output.state.permitted_transitive_use.general_registers = true;
        // The bridge preserves inbound XMM registers while calling the ordinary body.
        output.state.permitted_transitive_use.vector_registers = true;
        output.state.permitted_transitive_use.flags = true;
        output.state.permitted_transitive_use.instruction_pointer = true;
        output.state.permitted_transitive_use.stack_pointer = true;
        // Firmware entry may establish descriptor tables and kernel segments.
        output.state.permitted_transitive_use.control_state = true;
        output.state.permitted_transitive_use.segment_state = true;
        output.state.stack = |abi|::EntryStack::ProviderSelected;
        output.state.preemption = |abi|::Preemption::NotApplicable;
        |abi|::BoundaryPlanResult::Accepted { plan: output }
    }

    machine reject() -> |abi|::BoundaryPlanResult {
        |abi|::BoundaryPlanResult::Rejected {
            reason: |abi|::CallingPolicyRejection {
                reason: "UefiApplication requires two program-storage roots" as + |abi|::Utf8,
            },
        }
    }
}

boundary trait UefiApplication: |storage|::ProgramStorageEntry + UefiPhysicalEntry + |abi|::Calling<UefiX86_64CallingPolicy> {
}
