// Console providers and raw host bindings are selected for each hosted target.
machine configure_console(builder: @mutable Build) {
    Build::bind_native::<|windows_x86_64_console_impl|::WindowsConsoleIo::write>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "msvcrt.dll", export: "_write"
        } });
    Build::bind_native::<|windows_x86_64_console_impl|::WindowsConsoleIo::read>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "msvcrt.dll", export: "_read"
        } });
    Build::bind_native::<|windows_x86_64_console_impl|::WindowsConsoleIo::set_input_mode>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "msvcrt.dll", export: "_setmode"
        } });
    Build::bind_native::<|windows_x86_64_console_impl|::WindowsConsoleIo::set_output_mode>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "msvcrt.dll", export: "_setmode"
        } });

    Build::bind_native::<|windows_arm64_console_impl|::WindowsArm64ConsoleIo::write>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "msvcrt.dll", export: "_write"
        } });
    Build::bind_native::<|windows_arm64_console_impl|::WindowsArm64ConsoleIo::read>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "msvcrt.dll", export: "_read"
        } });
    Build::bind_native::<|windows_arm64_console_impl|::WindowsArm64ConsoleIo::set_input_mode>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "msvcrt.dll", export: "_setmode"
        } });
    Build::bind_native::<|windows_arm64_console_impl|::WindowsArm64ConsoleIo::set_output_mode>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "msvcrt.dll", export: "_setmode"
        } });
    // Both Windows targets share one Console adapter; each reaches MSVCRT
    // through its own placement of the same C calls.
    Build::select_provider::<|windows_console_host|::WindowsConsoleHost, |windows_x86_64_console_impl|::WindowsX64ConsoleHost>(builder, windows_x86_64);
    Build::select_provider::<|windows_console_host|::WindowsConsoleHost, |windows_arm64_console_impl|::WindowsArm64ConsoleHost>(builder, windows_arm64);

    Build::select_provider::<|console|::Console, |console|::AlphaConsole>(builder, alpha_bootstrap);
    Build::select_provider::<|console|::Console, |console|::WindowsConsole>(builder, windows_x86_64);
    Build::select_provider::<|console|::Console, |console|::WindowsConsole>(builder, windows_arm64);
    Build::select_provider::<|console|::Console, |console|::LinuxX86Console>(builder, linux_x86_64);
    Build::bind_native::<|console|::LinuxX86ConsoleIo::read>(builder, linux_x86_64, |native|::ForeignBinding::Syscall { number: 0 });
    Build::bind_native::<|console|::LinuxX86ConsoleIo::write>(builder, linux_x86_64, |native|::ForeignBinding::Syscall { number: 1 });

    Build::select_provider::<|console|::Console, |console|::LinuxArm64Console>(builder, linux_arm64);
    Build::bind_native::<|console|::LinuxArm64ConsoleIo::read>(builder, linux_arm64, |native|::ForeignBinding::Syscall { number: 63 });
    Build::bind_native::<|console|::LinuxArm64ConsoleIo::write>(builder, linux_arm64, |native|::ForeignBinding::Syscall { number: 64 });

    Build::select_provider::<|console|::Console, |console|::DarwinArm64Console>(builder, macos_arm64);
    Build::bind_native::<|console|::DarwinArm64ConsoleIo::read>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
        } });
    Build::bind_native::<|console|::DarwinArm64ConsoleIo::write>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
        } });

    Build::select_provider::<|console|::Console, |console|::DarwinX86Console>(builder, macos_x86_64);
    Build::bind_native::<|console|::DarwinX86ConsoleIo::read>(builder, macos_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_read"
        } });
    Build::bind_native::<|console|::DarwinX86ConsoleIo::write>(builder, macos_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_write"
        } });

}

