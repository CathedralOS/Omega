use {omega}/language/core/external_binding.omg as native;
use {omega}/language/core/process_exit.omg as process;

use clock.omg;
use console.omg;
use filesystem.omg;
use linux_arm64_clock.omg;
use linux_arm64_posix_filesystem.omg;
use linux_arm64_time_host.omg;
use linux_x86_64_clock.omg;
use linux_x86_64_posix_filesystem.omg;
use linux_x86_64_time_host.omg;
use macos_arm64_clock.omg;
use macos_arm64_posix_filesystem.omg;
use macos_arm64_time_host.omg;
use macos_gui.omg;
use macos_image.omg;
use posix_filesystem_adapter.omg;
use posix_filesystem_host.omg;
use process_exit.omg;
use time_host.omg;
use windows_console_host.omg;
use windows_filesystem_host.omg;
use windows_gui_host.omg;
use windows_x86_64_clock.omg;
use windows_x86_64_time_host.omg;

use targets/linux_arm64/clock_impl.omg as linux_arm64_wait;
use targets/linux_arm64/filesystem_impl.omg as linux_arm64_filesystem_impl;
use targets/linux_arm64/posix_filesystem_impl.omg as linux_arm64_posix_filesystem_impl;
use targets/linux_arm64/time_host_impl.omg as linux_arm64_time_read;

use targets/linux_x86_64/clock_impl.omg as linux_x86_64_wait;
use targets/linux_x86_64/filesystem_impl.omg as linux_x86_64_filesystem_impl;
use targets/linux_x86_64/posix_filesystem_impl.omg as linux_x86_64_posix_filesystem_impl;
use targets/linux_x86_64/time_host_impl.omg as linux_x86_64_time_read;

use targets/macos_arm64/clock_impl.omg as macos_arm64_wait;
use targets/macos_arm64/filesystem_impl.omg as macos_arm64_filesystem_impl;
use targets/macos_arm64/posix_filesystem_impl.omg as macos_arm64_posix_filesystem_impl;
use targets/macos_arm64/time_host_impl.omg as macos_arm64_time_read;

use targets/windows_arm64/console_impl.omg as windows_arm64_console_impl;

use targets/windows_x86_64/clock_impl.omg as windows_x86_64_wait;
use targets/windows_x86_64/console_impl.omg as windows_x86_64_console_impl;
use targets/windows_x86_64/filesystem/provider.omg as windows_filesystem_provider;
use targets/windows_x86_64/filesystem_removal/native.omg as windows_filesystem_removal;
use targets/windows_x86_64/time_host_impl.omg as windows_x86_64_time_read;
use targets/windows_x86_64/windows_filesystem_directory_native.omg as windows_filesystem_directory;
use targets/windows_x86_64/windows_filesystem_file_control_native.omg as windows_filesystem_file_control;
use targets/windows_x86_64/windows_filesystem_impl.omg;
use targets/windows_x86_64/windows_filesystem_lock_native.omg as windows_filesystem_lock;
use targets/windows_x86_64/windows_filesystem_metadata_native.omg as windows_filesystem_metadata;
use targets/windows_x86_64/windows_filesystem_native.omg as windows_filesystem;
use targets/windows_x86_64/windows_filesystem_path_query_native.omg as windows_filesystem_path_query;
use targets/windows_x86_64/windows_filesystem_position_native.omg as windows_filesystem_position;
use targets/windows_x86_64/windows_filesystem_reparse_native.omg as windows_filesystem_reparse;
use targets/windows_x86_64/windows_filesystem_transfer_native.omg as windows_filesystem_transfer;
use targets/windows_x86_64/windows_gui_impl.omg;

machine build(builder: @mutable Build) {
    Build::package(builder, "system");
    configure_clock(builder);
    configure_filesystem_providers(builder);
    configure_macos_image(builder);
    configure_time_host(builder);
    configure_windows_filesystem(builder);
    configure_posix_canonical(builder);
    configure_posix_filesystem(builder);
    configure_posix_filesystem_darwin(builder);
    configure_console(builder);
    configure_process_exit(builder);
    configure_windows_gui(builder);
    configure_macos_gui(builder);
    // Bind the complete ObjectiveC family once. String extents stay static.
    Build::bind_native::<|macos_gui|::ObjectiveC::get_class>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_getClass"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::register_selector>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_sel_registerName"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::send_string>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::send_byte_string>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::send>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::send_scalar>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::send_delayed>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::send_rect>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::send_image_size>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::send_scalar4>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_msgSend"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::pool_push>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_autoreleasePoolPush"
        }
    });
    Build::bind_native::<|macos_gui|::ObjectiveC::pool_pop>(builder, macos_arm64, |native|::ForeignBinding::DllImport {
        import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libobjc.A.dylib", symbol: "_objc_autoreleasePoolPop"
        }
    });
}

// Each target's filesystem implementations are ordinary named maps; these rows
// say which one backs each requirement on which target. The portable
// `FilesystemService` sits on the POSIX or Windows raw service, and each
// POSIX target supplies its own kernel adapters and record layouts.
machine configure_filesystem_providers(builder: @mutable Build) {
    Build::select_provider::<|filesystem|::FilesystemService, |posix_filesystem_adapter|::FilesystemPosixProvider>(builder, linux_x86_64);
    Build::select_provider::<|filesystem|::FilesystemService, |posix_filesystem_adapter|::FilesystemPosixProvider>(builder, linux_arm64);
    Build::select_provider::<|filesystem|::FilesystemService, |posix_filesystem_adapter|::FilesystemPosixProvider>(builder, macos_arm64);
    Build::select_provider::<|filesystem|::FilesystemService, |windows_filesystem_provider|::FilesystemWindowsProvider>(builder, windows_x86_64);
    Build::select_provider::<|filesystem|::FilesystemService, |windows_filesystem_provider|::FilesystemWindowsProvider>(builder, windows_arm64);
    Build::select_provider::<|posix_filesystem_host|::PosixFilesystemHost, |linux_x86_64_posix_filesystem|::LinuxX8664PosixFilesystem>(builder, linux_x86_64);
    Build::select_provider::<|posix_filesystem_host|::PosixFilesystemHost, |linux_arm64_posix_filesystem|::LinuxArm64PosixFilesystem>(builder, linux_arm64);
    Build::select_provider::<|posix_filesystem_host|::PosixFilesystemHost, |macos_arm64_posix_filesystem|::MacosArm64PosixFilesystem>(builder, macos_arm64);
    Build::select_provider::<|posix_filesystem_host|::PosixFilesystemTarget, |linux_x86_64_filesystem_impl|::LinuxX8664PosixFilesystemTarget>(builder, linux_x86_64);
    Build::select_provider::<|posix_filesystem_host|::PosixFilesystemTarget, |linux_arm64_filesystem_impl|::LinuxArm64PosixFilesystemTarget>(builder, linux_arm64);
    Build::select_provider::<|posix_filesystem_host|::PosixFilesystemTarget, |macos_arm64_filesystem_impl|::MacosArm64PosixFilesystemTarget>(builder, macos_arm64);
    Build::select_provider::<|windows_filesystem_host|::WindowsFilesystemHost, |windows_filesystem_impl|::NativeWindowsFilesystem>(builder, windows_x86_64);
    Build::select_provider::<|windows_filesystem_host|::WindowsFilesystemHost, |windows_filesystem_impl|::NativeWindowsFilesystem>(builder, windows_arm64);
    Build::select_provider::<|windows_gui_host|::WindowsGuiHost, |windows_gui_impl|::NativeWindowsGui>(builder, windows_x86_64);
    Build::select_provider::<|windows_gui_host|::WindowsGuiHost, |windows_gui_impl|::NativeWindowsGui>(builder, windows_arm64);
}

// Package-local raw supply follows the checked provider closure. Applications
// use Clock without repeating imports or naming the dependency's private seams.
// Forward the activation's original Build value through this ordinary helper.
machine configure_clock(builder: @mutable Build) {
    Build::select_provider::<|clock|::Clock, |windows_x86_64_clock|::WindowsX8664Clock>(builder, windows_x86_64);
    Build::select_provider::<|clock|::Clock, |windows_x86_64_clock|::WindowsX8664Clock>(builder, windows_arm64);
    Build::bind_native::<|windows_x86_64_wait|::WindowsClockWait::sleep>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "Sleep"
        } });
    Build::bind_native::<|windows_x86_64_wait|::WindowsClockWait::sleep>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "Sleep"
        } });

    Build::select_provider::<|clock|::Clock, |macos_arm64_clock|::MacosArm64Clock>(builder, macos_arm64);
    Build::bind_native::<|macos_arm64_wait|::DarwinClockWait::poll>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_poll"
        } });

    Build::select_provider::<|clock|::Clock, |linux_x86_64_clock|::LinuxX8664Clock>(builder, linux_x86_64);
    Build::bind_native::<|linux_x86_64_wait|::LinuxClockWait::poll>(builder, linux_x86_64,
        |native|::ForeignBinding::Syscall { number: 7 });

    Build::select_provider::<|clock|::Clock, |linux_arm64_clock|::LinuxArm64Clock>(builder, linux_arm64);
    Build::bind_native::<|linux_arm64_wait|::LinuxArmClockWait::nanosleep>(builder, linux_arm64,
        |native|::ForeignBinding::Syscall { number: 101 });
}

// TimeHost owns one target-keyed provider map and its package-local raw supply.
// Ordinary helpers keep the activation's original mutable Build value.
machine configure_time_host(builder: @mutable Build) {
    Build::bind_native::<|windows_x86_64_time_read|::WindowsTimeRead::query_performance_counter>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "QueryPerformanceCounter"
        } });
    Build::bind_native::<|windows_x86_64_time_read|::WindowsTimeRead::query_performance_counter>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "QueryPerformanceCounter"
        } });
    Build::bind_native::<|windows_x86_64_time_read|::WindowsTimeRead::query_performance_frequency>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "QueryPerformanceFrequency"
        } });
    Build::bind_native::<|windows_x86_64_time_read|::WindowsTimeRead::query_performance_frequency>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "QueryPerformanceFrequency"
        } });
    Build::bind_native::<|windows_x86_64_time_read|::WindowsTimeRead::system_time_as_file_time>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "GetSystemTimePreciseAsFileTime"
        } });
    Build::bind_native::<|windows_x86_64_time_read|::WindowsTimeRead::system_time_as_file_time>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "GetSystemTimePreciseAsFileTime"
        } });
    Build::bind_native::<|windows_x86_64_time_read|::WindowsTimeRead::sleep>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "Sleep"
        } });
    Build::bind_native::<|windows_x86_64_time_read|::WindowsTimeRead::sleep>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "Sleep"
        } });
    Build::select_provider::<|time_host|::TimeHost, |windows_x86_64_time_host|::WindowsTimeHost>(builder, windows_x86_64);
    Build::select_provider::<|time_host|::TimeHost, |windows_x86_64_time_host|::WindowsTimeHost>(builder, windows_arm64);
    Build::select_provider::<|time_host|::TimeHost, |linux_x86_64_time_host|::LinuxX8664TimeHost>(builder, linux_x86_64);
    Build::select_provider::<|time_host|::TimeHost, |linux_arm64_time_host|::LinuxArm64TimeHost>(builder, linux_arm64);
    Build::select_provider::<|time_host|::TimeHost, |macos_arm64_time_host|::DarwinTimeHost>(builder, macos_arm64);
    Build::select_provider::<|time_host|::TimeHost, |macos_arm64_time_host|::DarwinTimeHost>(builder, macos_x86_64);
    Build::bind_native::<|macos_arm64_time_read|::DarwinTimeRead::clock_nanoseconds>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_clock_gettime_nsec_np"
        } });
    Build::bind_native::<|macos_arm64_time_read|::DarwinTimeRead::poll>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_poll"
        } });
    Build::bind_native::<|macos_arm64_time_read|::DarwinTimeRead::clock_nanoseconds>(builder, macos_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_clock_gettime_nsec_np"
        } });
    Build::bind_native::<|macos_arm64_time_read|::DarwinTimeRead::poll>(builder, macos_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_poll"
        } });
    Build::bind_native::<|linux_x86_64_time_read|::LinuxX64TimeRead::clock_gettime>(builder, linux_x86_64,
        |native|::ForeignBinding::Syscall { number: 228 });
    Build::bind_native::<|linux_x86_64_time_read|::LinuxX64TimeRead::poll>(builder, linux_x86_64,
        |native|::ForeignBinding::Syscall { number: 7 });
    Build::bind_native::<|linux_arm64_time_read|::LinuxArm64TimeRead::clock_gettime>(builder, linux_arm64,
        |native|::ForeignBinding::Syscall { number: 113 });
    Build::bind_native::<|linux_arm64_time_read|::LinuxArm64TimeRead::nanosleep>(builder, linux_arm64,
        |native|::ForeignBinding::Syscall { number: 101 });
}

// The raw Windows filesystem requirements are backed here; their traits carry
// every contract, so no forwarding declaration restates one. Several requirements
// share a DLL function and differ only in the contract they promise.
machine configure_windows_filesystem(builder: @mutable Build) {
    // ReadFile/WriteFile split a borrowed view by each target's C ABI.
    Build::select_provider::<|windows_filesystem_transfer|::WindowsFilesystemTransfer, |windows_filesystem_transfer|::WindowsX64FilesystemTransfer>(builder, windows_x86_64);
    Build::select_provider::<|windows_filesystem_transfer|::WindowsFilesystemTransfer, |windows_filesystem_transfer|::WindowsArm64FilesystemTransfer>(builder, windows_arm64);
    Build::bind_native::<|windows_filesystem_directory|::WindowsFilesystemDirectoryIo::next_name>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "ntdll.dll", export: "NtQueryDirectoryFile"
        } });
    Build::bind_native::<|windows_filesystem_directory|::WindowsFilesystemDirectoryIo::next_name>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "ntdll.dll", export: "NtQueryDirectoryFile"
        } });
    Build::bind_native::<|windows_filesystem_directory|::WindowsFilesystemDirectoryIo::next_entry>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "ntdll.dll", export: "NtQueryDirectoryFile"
        } });
    Build::bind_native::<|windows_filesystem_directory|::WindowsFilesystemDirectoryIo::next_entry>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "ntdll.dll", export: "NtQueryDirectoryFile"
        } });
    Build::bind_native::<|windows_filesystem_file_control|::WindowsFilesystemFileControlIo::end_of_file>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "SetFileInformationByHandle"
        } });
    Build::bind_native::<|windows_filesystem_file_control|::WindowsFilesystemFileControlIo::end_of_file>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "SetFileInformationByHandle"
        } });
    Build::bind_native::<|windows_filesystem_file_control|::WindowsFilesystemFileControlIo::basic>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "SetFileInformationByHandle"
        } });
    Build::bind_native::<|windows_filesystem_file_control|::WindowsFilesystemFileControlIo::basic>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "SetFileInformationByHandle"
        } });
    Build::bind_native::<|windows_filesystem_file_control|::WindowsFilesystemFileControlIo::open_attributes>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "CreateFileW"
        } });
    Build::bind_native::<|windows_filesystem_file_control|::WindowsFilesystemFileControlIo::open_attributes>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "CreateFileW"
        } });
    Build::bind_native::<|windows_filesystem_lock|::WindowsFilesystemLockIo::acquire>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "LockFileEx"
        } });
    Build::bind_native::<|windows_filesystem_lock|::WindowsFilesystemLockIo::acquire>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "LockFileEx"
        } });
    Build::bind_native::<|windows_filesystem_lock|::WindowsFilesystemLockIo::release>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "UnlockFile"
        } });
    Build::bind_native::<|windows_filesystem_lock|::WindowsFilesystemLockIo::release>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "UnlockFile"
        } });
    Build::bind_native::<|windows_filesystem_metadata|::WindowsFilesystemMetadataIo::file_type>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "GetFileType"
        } });
    Build::bind_native::<|windows_filesystem_metadata|::WindowsFilesystemMetadataIo::file_type>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "GetFileType"
        } });
    Build::bind_native::<|windows_filesystem_metadata|::WindowsFilesystemMetadataIo::open_attributes>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "CreateFileW"
        } });
    Build::bind_native::<|windows_filesystem_metadata|::WindowsFilesystemMetadataIo::open_attributes>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "CreateFileW"
        } });
    Build::bind_native::<|windows_filesystem_metadata|::WindowsFilesystemMetadataIo::basic>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "GetFileInformationByHandleEx"
        } });
    Build::bind_native::<|windows_filesystem_metadata|::WindowsFilesystemMetadataIo::basic>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "GetFileInformationByHandleEx"
        } });
    Build::bind_native::<|windows_filesystem_metadata|::WindowsFilesystemMetadataIo::standard>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "GetFileInformationByHandleEx"
        } });
    Build::bind_native::<|windows_filesystem_metadata|::WindowsFilesystemMetadataIo::standard>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "GetFileInformationByHandleEx"
        } });
    Build::bind_native::<|windows_filesystem_metadata|::WindowsFilesystemMetadataIo::attribute_tag>(builder, windows_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "GetFileInformationByHandleEx"
        } });
    Build::bind_native::<|windows_filesystem_metadata|::WindowsFilesystemMetadataIo::attribute_tag>(builder, windows_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName {
            library: "kernel32.dll", export: "GetFileInformationByHandleEx"
