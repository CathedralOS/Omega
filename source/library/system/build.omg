    Build::bind_native::<|macos_image|::MacosImageObjects::release_data>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation",
            symbol: "_CFRelease"
        } });
    Build::bind_native::<|macos_image|::MacosImageObjects::release_provider>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics",
