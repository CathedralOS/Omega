        |native|::ForeignBinding::Syscall { number: 80 });
    Build::bind_native::<|linux_x86_64_posix_filesystem_impl|::PosixFilesystemLinux::ftruncate>(builder, linux_arm64,
        |native|::ForeignBinding::Syscall { number: 46 });
    Build::bind_native::<|linux_x86_64_posix_filesystem_impl|::PosixFilesystemLinux::utimensat>(builder, linux_arm64,
        |native|::ForeignBinding::Syscall { number: 88 });
    Build::bind_native::<|linux_x86_64_posix_filesystem_impl|::PosixFilesystemLinux::fsync>(builder, linux_arm64,
