    Build::bind_native::<|macos_image|::MacosImageObjects::release_image>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics",
            symbol: "_CGImageRelease"
        } });
    Build::bind_native::<|macos_image|::MacosImageObjects::create>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/System/Library/Frameworks/CoreGraphics.framework/CoreGraphics",
            symbol: "_CGImageCreate"
        } });
}

// Select the checked no-return wrapper. Its authenticated core primitive owns
// full-process completion; selecting it grants no exit authority.
machine configure_process_exit(builder: @mutable Build) {
    Build::select_provider::<|process|::ProcessExit, |process_exit|::NativeProcessExit>(builder, windows_x86_64);
    Build::select_provider::<|process|::ProcessExit, |process_exit|::NativeProcessExit>(builder, windows_arm64);
    Build::select_provider::<|process|::ProcessExit, |process_exit|::NativeProcessExit>(builder, linux_x86_64);
    Build::select_provider::<|process|::ProcessExit, |process_exit|::NativeProcessExit>(builder, linux_arm64);
    Build::select_provider::<|process|::ProcessExit, |process_exit|::NativeProcessExit>(builder, macos_arm64);
    Build::select_provider::<|process|::ProcessExit, |process_exit|::NativeProcessExit>(builder, macos_x86_64);
    Build::select_provider::<|process|::ProcessExit, |process_exit|::NativeProcessExit>(builder, alpha_bootstrap);
}
