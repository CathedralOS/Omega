// The raw POSIX canonicalize requirements and libc's `errno` view are backed
// here; the boundary traits carry every contract, so no forwarding declaration
// restates one. Darwin's filesystem provider reads `errno` through the same
// `PosixErrno::slot` row.
machine configure_posix_canonical(builder: @mutable Build) {
    Build::bind_native::<|posix_filesystem_adapter|::PosixCanonicalLibc::resolve>(builder, linux_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "realpath", version: "GLIBC_2.3"
        } });
    Build::bind_native::<|posix_filesystem_adapter|::PosixErrno::slot>(builder, linux_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "__errno_location", version: "GLIBC_2.2.5"
        } });
    Build::bind_native::<|posix_filesystem_adapter|::PosixCanonicalLibc::resolve>(builder, linux_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "realpath", version: "GLIBC_2.17"
        } });
    Build::bind_native::<|posix_filesystem_adapter|::PosixErrno::slot>(builder, linux_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "__errno_location", version: "GLIBC_2.17"
        } });
    Build::bind_native::<|posix_filesystem_adapter|::PosixCanonicalLibc::resolve>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "_realpath"
        } });
    Build::bind_native::<|posix_filesystem_adapter|::PosixErrno::slot>(builder, macos_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "___error"
        } });
}

// The Linux POSIX filesystem requirements reach the kernel directly; each
// target binds its own system call numbers. Byte-view requirements carry the
// per-target calling convention in their boundary trait, so the same member
// names bind different traits on x86_64 and arm64.
