use calling.omg as abi;
use targets/windows_x86_64/windows_filesystem_calling.omg as transfer;

public WindowsFilesystemTransferCalling satisfies |abi|::CallingPolicy {
    machine plan(signature: |abi|::BoundarySignature) -> |abi|::BoundaryPlanResult {
        let accepted: bool = |transfer|::windows_filesystem_transfer_signature(@signature);
        transition accepted {
            true -> |abi|::BoundaryPlanResult::Accepted { plan: |transfer|::windows_filesystem_transfer_entry() },
            _ -> |abi|::BoundaryPlanResult::Rejected { reason: |abi|::CallingPolicyRejection {
                reason: "expected handle, whole byte view, count reference and overlapped" as + |abi|::Utf8
            } }
        }
    }
}
