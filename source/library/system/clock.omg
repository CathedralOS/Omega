use targets/linux_arm64/clock_impl.omg as linux_arm64_wait;
use targets/linux_x86_64/clock_impl.omg as linux_x86_64_wait;
use targets/macos_arm64/clock_impl.omg as macos_arm64_wait;
use targets/windows_x86_64/clock_impl.omg as windows_x86_64_wait;

// Portable pacing requirement. The owning package Build selects ordinary
// checked adapters where the native protocol differs, and binds the exact
// requirement directly where the native signature already matches. Source
// checking sees every supplied implementation; target choice stays in Build.

public boundary trait Clock {
    // Block the caller for `milliseconds`. The wait holds the caller's worker,
    // so the requirement declares `blocks` and every caller writes `block`.
    // Each hosted adapter may enter its one-member raw wait trait. The trait
    // names are synchronous invocation edges, not extra reach members.
    machine sleep(milliseconds: u32)
    reaches Clock
    invokes |linux_x86_64_wait|::LinuxClockWait
    invokes |linux_arm64_wait|::LinuxArmClockWait
    invokes |macos_arm64_wait|::DarwinClockWait
    invokes |windows_x86_64_wait|::WindowsClockWait
    blocks
    crashes none;
}
