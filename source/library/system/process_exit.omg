// The system package supplies the default ProcessExit implementation. Its
// checked body calls the compiler-owned primitive declared by core.
use {omega}/language/core/never.omg;
use {omega}/language/core/process_exit.omg;
use {omega}/language/core/process_exit_native.omg as exit_primitive;

// The selected implementation owns the complete ProcessExit map. Its one
// member calls the core primitive directly. Its distinct declaration keeps
// the canonical requirement's terminal outcome and exact i32 status; neither
// the wrapper nor provider selection grants caller exit authority.
public NativeProcessExit satisfies |process_exit|::ProcessExit {
    machine exit_process(return_code: i32) -> |never|::Never
    reaches |process_exit|::ProcessExit
    crashes none
    terminates {
        |exit_primitive|::ProcessExitPrimitive(return_code);
    }
}
