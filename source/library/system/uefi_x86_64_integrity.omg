use targets/uefi_x86_64/integrity.omg;
use targets/uefi_x86_64/tables.omg;

// The installed x86-64 layout provides the readable 120-byte prefix.
// Validate the claimed header extent before using it as the checksum bound.
public machine validate_system_table(table: @|tables|::EfiSystemTable, minimum_revision: u32) -> bool
terminates
{
    let storage: @[u8; 120] = table as @[u8; 120];
    let bytes: @[u8] = storage[..];
    validate_table(bytes, 0x5453595320494249u64, minimum_revision, 120u32)
}

public machine validate_table(
    bytes: @[u8],
    signature: u64,
    minimum_revision: u32,
    minimum_size: u32
) -> bool
terminates
{
    transition bytes.length >= 24 {
        true -> header(bytes, signature, minimum_revision, minimum_size),
        _ -> (false)
    }

    machine header(bytes: @[u8], signature: u64, minimum_revision: u32, minimum_size: u32) -> bool
    requires bytes.length >= 24
    {
        let signature_low: u32 = |integrity|::read_u32(bytes);
        let signature_high: u32 = |integrity|::read_u32(bytes[4..]);
        let actual_signature: u64 = (signature_low as u64) | ((signature_high as u64) << 32);
        let revision: u32 = |integrity|::read_u32(bytes[8..]);
        let header_size: u32 = |integrity|::read_u32(bytes[12..]);
        let expected_crc: u32 = |integrity|::read_u32(bytes[16..]);
        let reserved: u32 = |integrity|::read_u32(bytes[20..]);
        transition actual_signature == signature && revision >= minimum_revision
            && reserved == 0 && header_size >= 24 && header_size >= minimum_size
            && header_size <= bytes.length {
            true -> checksum(bytes, header_size as u64, expected_crc),
            _ -> (false)
        }
    }

    machine checksum(bytes: @[u8], header_size: u64, expected_crc: u32) -> bool
    requires header_size <= bytes.length
    {
        let computed: u32 = |integrity|::table_crc(bytes[..header_size], 0, 0xFFFFFFFF, header_size);
        computed == expected_crc
    }
}
