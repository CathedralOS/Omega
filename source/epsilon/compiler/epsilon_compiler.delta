(def epsilon_find_transition_pattern_reference ((target EpsilonPattern)
  (references EpsilonTransitionPatternReferenceList))
  EpsilonTransitionPatternReferenceLookup
  (match references
    (NoEpsilonTransitionPatternReferences NoEpsilonTransitionPatternReference)
    ((MoreEpsilonTransitionPatternReferences item rest)
      (match item
