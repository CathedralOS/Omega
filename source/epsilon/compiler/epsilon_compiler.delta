                  (EpsilonPatternParseRejected UnexpectedToken start))))))))))

(def epsilon_parse_continuation ((source Bytes) (cursor Int)) EpsilonContinuationParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source start) 18)
      (let returnEnd Int (epsilon_token_end source start)
        (let followingStart Int (epsilon_token_start source returnEnd)
          (let followingCode Int (epsilon_token_code source followingStart)
            (if (eq followingCode 31)
              (EpsilonContinuationParsed
                (EpsilonReturnContinuation start returnEnd NoEpsilonExpression))
              (if (eq followingCode 0)
                (EpsilonContinuationParsed
                  (EpsilonReturnContinuation start returnEnd NoEpsilonExpression))
                (if (lt (epsilon_probe_pattern_arrow source followingStart) 0)
                  (let expressionOutcome EpsilonExpressionParseOutcome (epsilon_parse_expression source followingStart)
                    (match expressionOutcome
                      ((EpsilonExpressionParseRejected reasonValue errorOffset)
                        (EpsilonContinuationParseRejected reasonValue errorOffset))
                      ((EpsilonExpressionParsed expressionValue)
                        (EpsilonContinuationParsed
                          (EpsilonReturnContinuation start
                            (epsilon_expression_end expressionValue)
                            (SomeEpsilonExpression expressionValue))))))
                  (EpsilonContinuationParsed
                    (EpsilonReturnContinuation start returnEnd NoEpsilonExpression))))))))
      (let expressionOutcome EpsilonExpressionParseOutcome (epsilon_parse_postfix source start)
        (match expressionOutcome
          ((EpsilonExpressionParseRejected reasonValue errorOffset)
            (EpsilonContinuationParseRejected reasonValue errorOffset))
          ((EpsilonExpressionParsed expressionValue)
            (EpsilonContinuationParsed
              (EpsilonExpressionContinuation (epsilon_expression_start expressionValue)
                (epsilon_expression_end expressionValue) expressionValue))))))))

(def epsilon_parse_arm ((source Bytes) (cursor Int)) EpsilonArmParseOutcome
  (let patternOutcome EpsilonPatternParseOutcome (epsilon_parse_pattern source cursor)
    (match patternOutcome
      ((EpsilonPatternParseRejected reasonValue errorOffset)
        (EpsilonArmParseRejected reasonValue errorOffset))
      ((EpsilonPatternParsed patternValue)
        (let arrowStart Int (epsilon_token_start source (epsilon_pattern_end patternValue))
          (if (eq (epsilon_token_code source arrowStart) 42)
            (let continuationOutcome EpsilonContinuationParseOutcome
              (epsilon_parse_continuation source (epsilon_token_end source arrowStart))
              (match continuationOutcome
                ((EpsilonContinuationParseRejected reasonValue errorOffset)
                  (EpsilonArmParseRejected reasonValue errorOffset))
                ((EpsilonContinuationParsed continuationValue)
                  (EpsilonArmParsed
                    (EpsilonArmSyntax (epsilon_pattern_start patternValue)
                      (epsilon_continuation_end continuationValue)
                      patternValue continuationValue)))))
            (epsilon_arm_reject_at source (epsilon_pattern_end patternValue))))))))

(def epsilon_parse_arms_acc ((source Bytes) (cursor Int) (count Int)
  (accumulator EpsilonArmList)) EpsilonArmListParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source start)
      (if (eq code 0)
        (EpsilonArmListParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (if (eq count 0)
            (EpsilonArmListParseRejected UnexpectedToken start)
            (EpsilonArmListParsed
              (epsilon_reverse_arms accumulator NoEpsilonArms) start))
          (let armOutcome EpsilonArmParseOutcome (epsilon_parse_arm source start)
            (match armOutcome
              ((EpsilonArmParseRejected reasonValue errorOffset)
                (EpsilonArmListParseRejected reasonValue errorOffset))
              ((EpsilonArmParsed armValue)
                (epsilon_parse_arms_acc source (epsilon_arm_end armValue) (+ count 1)
                  (MoreEpsilonArms armValue accumulator))))))))))

(def epsilon_parse_transition ((source Bytes) (cursor Int)) EpsilonTransitionParseOutcome
  (let transitionStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source transitionStart) 16)
      (let expressionOutcome EpsilonExpressionParseOutcome
        (epsilon_parse_expression source (epsilon_token_end source transitionStart))
        (match expressionOutcome
          ((EpsilonExpressionParseRejected reasonValue errorOffset)
            (EpsilonTransitionParseRejected reasonValue errorOffset))
          ((EpsilonExpressionParsed expressionValue)
            (let openStart Int (epsilon_token_start source (epsilon_expression_end expressionValue))
              (if (eq (epsilon_token_code source openStart) 30)
                (let armsOutcome EpsilonArmListParseOutcome
                  (epsilon_parse_arms_acc source (epsilon_token_end source openStart)
                    0 NoEpsilonArms)
                  (match armsOutcome
                    ((EpsilonArmListParseRejected reasonValue errorOffset)
                      (EpsilonTransitionParseRejected reasonValue errorOffset))
                    ((EpsilonArmListParsed arms closeStart)
                      (let transitionEnd Int (epsilon_token_end source closeStart)
                        (EpsilonTransitionParsed
                          (EpsilonTransitionTerminal transitionStart transitionEnd
                            expressionValue arms))))))
                (let errorStart Int (epsilon_token_start source
                  (epsilon_expression_end expressionValue))
                  (if (eq errorStart (bytes_length source))
                    (EpsilonTransitionParseRejected UnexpectedEnd errorStart)
                    (EpsilonTransitionParseRejected UnexpectedToken errorStart))))))))
      (let errorStart Int (epsilon_token_start source cursor)
        (if (eq errorStart (bytes_length source))
          (EpsilonTransitionParseRejected UnexpectedEnd errorStart)
          (EpsilonTransitionParseRejected UnexpectedToken errorStart))))))

; ---- parameters, statements, and explicit return -----------------------

(def epsilon_parameter_end ((parameterValue EpsilonParameter)) Int
  (match parameterValue
    ((EpsilonParameterSyntax start end name typeValue) end)))

(def epsilon_reverse_parameters ((input EpsilonParameterList)
  (output EpsilonParameterList)) EpsilonParameterList
  (match input
    (NoEpsilonParameters output)
    ((MoreEpsilonParameters item rest)
      (epsilon_reverse_parameters rest (MoreEpsilonParameters item output)))))

(def epsilon_parameter_reject_at ((source Bytes) (cursor Int)) EpsilonParameterParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonParameterParseRejected UnexpectedEnd start)
      (EpsilonParameterParseRejected UnexpectedToken start))))

(def epsilon_parameter_list_reject_at ((source Bytes) (cursor Int)) EpsilonParameterListParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonParameterListParseRejected UnexpectedEnd start)
      (EpsilonParameterListParseRejected UnexpectedToken start))))

(def epsilon_statement_reject_at ((source Bytes) (cursor Int)) EpsilonStatementParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonStatementParseRejected UnexpectedEnd start)
      (EpsilonStatementParseRejected UnexpectedToken start))))

(def epsilon_terminal_reject_at ((source Bytes) (cursor Int)) EpsilonTerminalParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonTerminalParseRejected UnexpectedEnd start)
      (EpsilonTerminalParseRejected UnexpectedToken start))))

(def epsilon_parse_parameter ((source Bytes) (cursor Int)) EpsilonParameterParseOutcome
  (let nameStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source nameStart) 1)
      (let nameEnd Int (epsilon_token_end source nameStart)
        (let colonStart Int (epsilon_token_start source nameEnd)
          (if (eq (epsilon_token_code source colonStart) 37)
            (let typeOutcome EpsilonTypeParseOutcome
              (epsilon_parse_type source (epsilon_token_end source colonStart))
              (match typeOutcome
                ((EpsilonTypeParseRejected reasonValue errorOffset)
                  (EpsilonParameterParseRejected reasonValue errorOffset))
                ((EpsilonTypeParsed typeValue)
                  (let parameterEnd Int (epsilon_type_end typeValue)
                    (EpsilonParameterParsed
                      (EpsilonParameterSyntax nameStart parameterEnd
                        (EpsilonNameSpan nameStart nameEnd) typeValue))))))
            (epsilon_parameter_reject_at source nameEnd))))
      (epsilon_parameter_reject_at source cursor))))

(def epsilon_parse_parameters_acc ((source Bytes) (cursor Int) (closeCode Int)
  (accumulator EpsilonParameterList)) EpsilonParameterListParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source start) closeCode)
      (EpsilonParameterListParsed
        (epsilon_reverse_parameters accumulator NoEpsilonParameters) start)
      (let parameterOutcome EpsilonParameterParseOutcome (epsilon_parse_parameter source start)
        (match parameterOutcome
          ((EpsilonParameterParseRejected reasonValue errorOffset)
            (EpsilonParameterListParseRejected reasonValue errorOffset))
          ((EpsilonParameterParsed parameterValue)
            (let followingStart Int (epsilon_token_start source
              (epsilon_parameter_end parameterValue))
              (let followingCode Int (epsilon_token_code source followingStart)
                (if (eq followingCode closeCode)
                  (EpsilonParameterListParsed
                    (epsilon_reverse_parameters
                      (MoreEpsilonParameters parameterValue accumulator)
                      NoEpsilonParameters) followingStart)
                  (if (eq followingCode 38)
                    (let afterComma Int (epsilon_token_end source followingStart)
                      (let nextStart Int (epsilon_token_start source afterComma)
                        (if (eq (epsilon_token_code source nextStart) closeCode)
                          (EpsilonParameterListParseRejected UnexpectedToken nextStart)
                          (epsilon_parse_parameters_acc source afterComma closeCode
                            (MoreEpsilonParameters parameterValue accumulator)))))
                    (epsilon_parameter_list_reject_at source followingStart)))))))))))

(def epsilon_finish_let_statement ((source Bytes) (statementStart Int)
  (nameStart Int) (nameEnd Int) (typeValue EpsilonType) (cursor Int)) EpsilonStatementParseOutcome
  (let assignStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source assignStart) 41)
      (let expressionOutcome EpsilonExpressionParseOutcome
        (epsilon_parse_expression source (epsilon_token_end source assignStart))
        (match expressionOutcome
          ((EpsilonExpressionParseRejected reasonValue errorOffset)
            (EpsilonStatementParseRejected reasonValue errorOffset))
          ((EpsilonExpressionParsed expressionValue)
            (let semiStart Int (epsilon_token_start source
              (epsilon_expression_end expressionValue))
              (if (eq (epsilon_token_code source semiStart) 36)
                (let statementEnd Int (epsilon_token_end source semiStart)
                  (EpsilonStatementParsed
                    (EpsilonLetStatement statementStart statementEnd
                      (EpsilonNameSpan nameStart nameEnd) typeValue expressionValue)))
                (epsilon_statement_reject_at source
                  (epsilon_expression_end expressionValue)))))))
      (epsilon_statement_reject_at source cursor))))

(def epsilon_parse_let_statement ((source Bytes) (cursor Int)) EpsilonStatementParseOutcome
  (let statementStart Int (epsilon_token_start source cursor)
    (let nameStart Int (epsilon_token_start source
      (epsilon_token_end source statementStart))
      (if (eq (epsilon_token_code source nameStart) 1)
        (let nameEnd Int (epsilon_token_end source nameStart)
          (let colonStart Int (epsilon_token_start source nameEnd)
            (if (eq (epsilon_token_code source colonStart) 37)
              (let typeOutcome EpsilonTypeParseOutcome
                (epsilon_parse_type source (epsilon_token_end source colonStart))
                (match typeOutcome
                  ((EpsilonTypeParseRejected reasonValue errorOffset)
                    (EpsilonStatementParseRejected reasonValue errorOffset))
                  ((EpsilonTypeParsed typeValue)
                    (epsilon_finish_let_statement source statementStart nameStart nameEnd
                      typeValue (epsilon_type_end typeValue)))))
              (epsilon_statement_reject_at source nameEnd))))
        (epsilon_statement_reject_at source
          (epsilon_token_end source statementStart))))))

(def epsilon_parse_assert_statement ((source Bytes) (cursor Int)) EpsilonStatementParseOutcome
  (let statementStart Int (epsilon_token_start source cursor)
    (let expressionOutcome EpsilonExpressionParseOutcome
      (epsilon_parse_expression source (epsilon_token_end source statementStart))
      (match expressionOutcome
        ((EpsilonExpressionParseRejected reasonValue errorOffset)
          (EpsilonStatementParseRejected reasonValue errorOffset))
        ((EpsilonExpressionParsed expressionValue)
          (let semiStart Int (epsilon_token_start source (epsilon_expression_end expressionValue))
            (if (eq (epsilon_token_code source semiStart) 36)
              (let statementEnd Int (epsilon_token_end source semiStart)
                (EpsilonStatementParsed
                  (EpsilonAssertStatement statementStart statementEnd expressionValue)))
              (epsilon_statement_reject_at source
                (epsilon_expression_end expressionValue)))))))))

(def epsilon_finish_assignment ((source Bytes) (left EpsilonExpression)
  (cursor Int)) EpsilonStatementParseOutcome
  (let rightOutcome EpsilonExpressionParseOutcome (epsilon_parse_expression source cursor)
    (match rightOutcome
      ((EpsilonExpressionParseRejected reasonValue errorOffset)
        (EpsilonStatementParseRejected reasonValue errorOffset))
      ((EpsilonExpressionParsed right)
        (let semiStart Int (epsilon_token_start source (epsilon_expression_end right))
          (if (eq (epsilon_token_code source semiStart) 36)
            (let statementEnd Int (epsilon_token_end source semiStart)
              (EpsilonStatementParsed
                (EpsilonAssignmentStatement (epsilon_expression_start left)
                  statementEnd left right)))
            (epsilon_statement_reject_at source (epsilon_expression_end right))))))))

(def epsilon_parse_postfix_statement ((source Bytes) (cursor Int)) EpsilonStatementParseOutcome
  (let leftOutcome EpsilonExpressionParseOutcome (epsilon_parse_postfix source cursor)
    (match leftOutcome
      ((EpsilonExpressionParseRejected reasonValue errorOffset)
        (EpsilonStatementParseRejected reasonValue errorOffset))
      ((EpsilonExpressionParsed left)
        (let followingStart Int (epsilon_token_start source (epsilon_expression_end left))
          (let followingCode Int (epsilon_token_code source followingStart)
            (if (eq followingCode 41)
              (epsilon_finish_assignment source left
                (epsilon_token_end source followingStart))
              (if (eq followingCode 36)
                (let statementEnd Int (epsilon_token_end source followingStart)
                  (EpsilonStatementParsed
                    (EpsilonPostfixStatement (epsilon_expression_start left)
                      statementEnd left)))
                (epsilon_statement_reject_at source followingStart)))))))))

(def epsilon_parse_statement ((source Bytes) (cursor Int)) EpsilonStatementParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source start)
      (if (eq code 17)
        (epsilon_parse_let_statement source start)
        (if (eq code 19)
          (epsilon_parse_assert_statement source start)
          (epsilon_parse_postfix_statement source start))))))

(def epsilon_parse_return_terminal ((source Bytes) (cursor Int)) EpsilonTerminalParseOutcome
  (let returnStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source returnStart) 18)
      (let afterReturn Int (epsilon_token_end source returnStart)
        (let followingStart Int (epsilon_token_start source afterReturn)
          (if (eq (epsilon_token_code source followingStart) 36)
            (let terminalEnd Int (epsilon_token_end source followingStart)
              (EpsilonTerminalParsed
                (EpsilonReturnTerminal returnStart terminalEnd NoEpsilonExpression)))
            (let expressionOutcome EpsilonExpressionParseOutcome (epsilon_parse_expression source followingStart)
              (match expressionOutcome
                ((EpsilonExpressionParseRejected reasonValue errorOffset)
                  (EpsilonTerminalParseRejected reasonValue errorOffset))
                ((EpsilonExpressionParsed expressionValue)
                  (let semiStart Int (epsilon_token_start source
                    (epsilon_expression_end expressionValue))
                    (if (eq (epsilon_token_code source semiStart) 36)
                      (let terminalEnd Int (epsilon_token_end source semiStart)
                        (EpsilonTerminalParsed
                          (EpsilonReturnTerminal returnStart terminalEnd
                            (SomeEpsilonExpression expressionValue))))
                      (epsilon_terminal_reject_at source
                        (epsilon_expression_end expressionValue))))))))))
      (epsilon_terminal_reject_at source cursor))))

; ---- state and machine bodies ------------------------------------------

(def epsilon_statement_end ((statementValue EpsilonStatement)) Int
  (match statementValue
    ((EpsilonLetStatement start end name typeValue expressionValue) end)
    ((EpsilonAssignmentStatement start end left right) end)
    ((EpsilonPostfixStatement start end expressionValue) end)
    ((EpsilonAssertStatement start end expressionValue) end)))

(def epsilon_terminal_end ((terminalValue EpsilonTerminal)) Int
  (match terminalValue
    ((EpsilonTransitionTerminal start end expressionValue arms) end)
    ((EpsilonReturnTerminal start end expressionValue) end)))

(def epsilon_state_body_end ((bodyValue EpsilonStateBody)) Int
  (match bodyValue
    ((EpsilonStateBodySyntax start end statements terminalValue) end)))

(def epsilon_state_end ((stateValue EpsilonState)) Int
  (match stateValue
    ((EpsilonStateSyntax start end name parameters bodyValue) end)))

(def epsilon_reverse_statements ((input EpsilonStatementList)
  (output EpsilonStatementList)) EpsilonStatementList
  (match input
    (NoEpsilonStatements output)
    ((MoreEpsilonStatements item rest)
      (epsilon_reverse_statements rest (MoreEpsilonStatements item output)))))

(def epsilon_reverse_states ((input EpsilonStateList) (output EpsilonStateList)) EpsilonStateList
  (match input
    (NoEpsilonStates output)
    ((MoreEpsilonStates item rest)
      (epsilon_reverse_states rest (MoreEpsilonStates item output)))))

(def epsilon_state_body_reject_at ((source Bytes) (cursor Int)) EpsilonStateBodyParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonStateBodyParseRejected UnexpectedEnd start)
      (EpsilonStateBodyParseRejected UnexpectedToken start))))

(def epsilon_state_reject_at ((source Bytes) (cursor Int)) EpsilonStateParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonStateParseRejected UnexpectedEnd start)
      (EpsilonStateParseRejected UnexpectedToken start))))

(def epsilon_machine_body_reject_at ((source Bytes) (cursor Int)) EpsilonMachineBodyParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonMachineBodyParseRejected UnexpectedEnd start)
      (EpsilonMachineBodyParseRejected UnexpectedToken start))))

(def epsilon_parse_explicit_terminal ((source Bytes) (cursor Int)) EpsilonTerminalParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source start)
      (if (eq code 18)
        (epsilon_parse_return_terminal source start)
        (if (eq code 16)
          (let transitionOutcome EpsilonTransitionParseOutcome (epsilon_parse_transition source start)
            (match transitionOutcome
              ((EpsilonTransitionParseRejected reasonValue errorOffset)
                (EpsilonTerminalParseRejected reasonValue errorOffset))
              ((EpsilonTransitionParsed terminalValue)
                (EpsilonTerminalParsed terminalValue))))
          (epsilon_terminal_reject_at source cursor))))))

(def epsilon_finish_state_terminal ((source Bytes) (bodyStart Int)
  (statements EpsilonStatementList) (terminalValue EpsilonTerminal)) EpsilonStateBodyParseOutcome
  (let closeStart Int (epsilon_token_start source (epsilon_terminal_end terminalValue))
    (if (eq (epsilon_token_code source closeStart) 31)
      (let bodyEnd Int (epsilon_token_end source closeStart)
        (EpsilonStateBodyParsed
          (EpsilonStateBodySyntax bodyStart bodyEnd
            (epsilon_reverse_statements statements NoEpsilonStatements)
            (SomeEpsilonTerminal terminalValue))))
      (epsilon_state_body_reject_at source (epsilon_terminal_end terminalValue)))))

(def epsilon_parse_state_body_items ((source Bytes) (bodyStart Int) (cursor Int)
  (statements EpsilonStatementList)) EpsilonStateBodyParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source start)
      (if (eq code 0)
        (EpsilonStateBodyParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (let bodyEnd Int (epsilon_token_end source start)
            (EpsilonStateBodyParsed
              (EpsilonStateBodySyntax bodyStart bodyEnd
                (epsilon_reverse_statements statements NoEpsilonStatements)
                NoEpsilonTerminal)))
          (if (eq code 18)
            (let terminalOutcome EpsilonTerminalParseOutcome (epsilon_parse_explicit_terminal source start)
              (match terminalOutcome
                ((EpsilonTerminalParseRejected reasonValue errorOffset)
                  (EpsilonStateBodyParseRejected reasonValue errorOffset))
                ((EpsilonTerminalParsed terminalValue)
                  (epsilon_finish_state_terminal source bodyStart statements terminalValue))))
            (if (eq code 16)
              (let terminalOutcome EpsilonTerminalParseOutcome (epsilon_parse_explicit_terminal source start)
                (match terminalOutcome
                  ((EpsilonTerminalParseRejected reasonValue errorOffset)
                    (EpsilonStateBodyParseRejected reasonValue errorOffset))
                  ((EpsilonTerminalParsed terminalValue)
                    (epsilon_finish_state_terminal source bodyStart statements terminalValue))))
              (if (eq code 15)
                (EpsilonStateBodyParseRejected UnexpectedToken start)
                (let statementOutcome EpsilonStatementParseOutcome (epsilon_parse_statement source start)
                  (match statementOutcome
                    ((EpsilonStatementParseRejected reasonValue errorOffset)
                      (EpsilonStateBodyParseRejected reasonValue errorOffset))
                    ((EpsilonStatementParsed statementValue)
                      (epsilon_parse_state_body_items source bodyStart
                        (epsilon_statement_end statementValue)
                        (MoreEpsilonStatements statementValue statements)))))))))))))

(def epsilon_parse_state_body ((source Bytes) (cursor Int)) EpsilonStateBodyParseOutcome
  (let bodyStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source bodyStart) 30)
      (epsilon_parse_state_body_items source bodyStart
        (epsilon_token_end source bodyStart) NoEpsilonStatements)
      (epsilon_state_body_reject_at source cursor))))

(def epsilon_finish_state ((source Bytes) (stateStart Int) (nameStart Int)
  (nameEnd Int) (parameters EpsilonParameterList) (cursor Int)) EpsilonStateParseOutcome
  (let bodyOutcome EpsilonStateBodyParseOutcome (epsilon_parse_state_body source cursor)
    (match bodyOutcome
      ((EpsilonStateBodyParseRejected reasonValue errorOffset)
        (EpsilonStateParseRejected reasonValue errorOffset))
      ((EpsilonStateBodyParsed bodyValue)
        (EpsilonStateParsed
          (EpsilonStateSyntax stateStart (epsilon_state_body_end bodyValue)
            (EpsilonNameSpan nameStart nameEnd) parameters bodyValue))))))

(def epsilon_parse_state ((source Bytes) (cursor Int)) EpsilonStateParseOutcome
  (let stateStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source stateStart) 15)
      (let nameStart Int (epsilon_token_start source (epsilon_token_end source stateStart))
        (if (eq (epsilon_token_code source nameStart) 1)
          (let nameEnd Int (epsilon_token_end source nameStart)
            (let openStart Int (epsilon_token_start source nameEnd)
              (if (eq (epsilon_token_code source openStart) 32)
                (let parametersOutcome EpsilonParameterListParseOutcome
                  (epsilon_parse_parameters_acc source (epsilon_token_end source openStart)
                    33 NoEpsilonParameters)
                  (match parametersOutcome
                    ((EpsilonParameterListParseRejected reasonValue errorOffset)
                      (EpsilonStateParseRejected reasonValue errorOffset))
                    ((EpsilonParameterListParsed parameters closeStart)
                      (epsilon_finish_state source stateStart nameStart nameEnd parameters
                        (epsilon_token_end source closeStart)))))
                (epsilon_state_reject_at source nameEnd))))
          (epsilon_state_reject_at source (epsilon_token_end source stateStart))))
      (epsilon_state_reject_at source cursor))))

(def epsilon_finish_machine_body ((source Bytes) (bodyStart Int) (cursor Int)
  (statements EpsilonStatementList) (terminalValue EpsilonOptionalTerminal)
  (states EpsilonStateList)) EpsilonMachineBodyParseOutcome
  (let closeStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source closeStart) 31)
      (let bodyEnd Int (epsilon_token_end source closeStart)
        (EpsilonMachineBodyParsed
          (EpsilonMachineBodySyntax bodyStart bodyEnd
            (epsilon_reverse_statements statements NoEpsilonStatements)
            terminalValue (epsilon_reverse_states states NoEpsilonStates))))
      (epsilon_machine_body_reject_at source cursor))))

(def epsilon_parse_machine_states ((source Bytes) (bodyStart Int) (cursor Int)
  (statements EpsilonStatementList) (terminalValue EpsilonOptionalTerminal)
  (states EpsilonStateList)) EpsilonMachineBodyParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source start)
      (if (eq code 0)
        (EpsilonMachineBodyParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (epsilon_finish_machine_body source bodyStart start statements terminalValue states)
          (if (eq code 15)
            (let stateOutcome EpsilonStateParseOutcome (epsilon_parse_state source start)
              (match stateOutcome
                ((EpsilonStateParseRejected reasonValue errorOffset)
                  (EpsilonMachineBodyParseRejected reasonValue errorOffset))
                ((EpsilonStateParsed stateValue)
                  (epsilon_parse_machine_states source bodyStart (epsilon_state_end stateValue)
                    statements terminalValue (MoreEpsilonStates stateValue states)))))
            (EpsilonMachineBodyParseRejected UnexpectedToken start)))))))

(def epsilon_parse_machine_terminal ((source Bytes) (bodyStart Int) (cursor Int)
  (statements EpsilonStatementList)) EpsilonMachineBodyParseOutcome
  (let terminalOutcome EpsilonTerminalParseOutcome (epsilon_parse_explicit_terminal source cursor)
    (match terminalOutcome
      ((EpsilonTerminalParseRejected reasonValue errorOffset)
        (EpsilonMachineBodyParseRejected reasonValue errorOffset))
      ((EpsilonTerminalParsed terminalValue)
        (epsilon_parse_machine_states source bodyStart (epsilon_terminal_end terminalValue)
          statements (SomeEpsilonTerminal terminalValue) NoEpsilonStates)))))

(def epsilon_parse_machine_body_items ((source Bytes) (bodyStart Int) (cursor Int)
  (statements EpsilonStatementList)) EpsilonMachineBodyParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source start)
      (if (eq code 0)
        (EpsilonMachineBodyParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (epsilon_finish_machine_body source bodyStart start statements
            NoEpsilonTerminal NoEpsilonStates)
          (if (eq code 15)
            (epsilon_parse_machine_states source bodyStart start statements
              NoEpsilonTerminal NoEpsilonStates)
            (if (eq code 18)
              (epsilon_parse_machine_terminal source bodyStart start statements)
              (if (eq code 16)
                (epsilon_parse_machine_terminal source bodyStart start statements)
                (let statementOutcome EpsilonStatementParseOutcome (epsilon_parse_statement source start)
                  (match statementOutcome
                    ((EpsilonStatementParseRejected reasonValue errorOffset)
                      (EpsilonMachineBodyParseRejected reasonValue errorOffset))
                    ((EpsilonStatementParsed statementValue)
                      (epsilon_parse_machine_body_items source bodyStart
                        (epsilon_statement_end statementValue)
                        (MoreEpsilonStatements statementValue statements)))))))))))))

(def epsilon_parse_machine_body ((source Bytes) (cursor Int)) EpsilonMachineBodyParseOutcome
  (let bodyStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source bodyStart) 30)
      (epsilon_parse_machine_body_items source bodyStart
        (epsilon_token_end source bodyStart) NoEpsilonStatements)
      (epsilon_machine_body_reject_at source cursor))))

; ---- boundary and data declarations -----------------------------------

(def epsilon_boundary_machine_end ((machineValue EpsilonBoundaryMachine)) Int
  (match machineValue
    ((EpsilonBoundaryMachineSyntax start end name parameters returnType) end)))

(def epsilon_data_member_end ((memberValue EpsilonDataMember)) Int
  (match memberValue
    ((EpsilonFieldMember start end name typeValue) end)
    ((EpsilonCaseMember start end name payload) end)))

(def epsilon_reverse_boundary_machines ((input EpsilonBoundaryMachineList)
  (output EpsilonBoundaryMachineList)) EpsilonBoundaryMachineList
  (match input
    (NoEpsilonBoundaryMachines output)
    ((MoreEpsilonBoundaryMachines item rest)
      (epsilon_reverse_boundary_machines rest
        (MoreEpsilonBoundaryMachines item output)))))

(def epsilon_reverse_data_members ((input EpsilonDataMemberList)
  (output EpsilonDataMemberList)) EpsilonDataMemberList
  (match input
    (NoEpsilonDataMembers output)
    ((MoreEpsilonDataMembers item rest)
      (epsilon_reverse_data_members rest (MoreEpsilonDataMembers item output)))))

(def epsilon_return_type_reject_at ((source Bytes) (cursor Int)) EpsilonReturnTypeParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonReturnTypeParseRejected UnexpectedEnd start)
      (EpsilonReturnTypeParseRejected UnexpectedToken start))))

(def epsilon_boundary_machine_reject_at ((source Bytes)
  (cursor Int)) EpsilonBoundaryMachineParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonBoundaryMachineParseRejected UnexpectedEnd start)
      (EpsilonBoundaryMachineParseRejected UnexpectedToken start))))

(def epsilon_boundary_machine_list_reject_at ((source Bytes)
  (cursor Int)) EpsilonBoundaryMachineListParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonBoundaryMachineListParseRejected UnexpectedEnd start)
      (EpsilonBoundaryMachineListParseRejected UnexpectedToken start))))

(def epsilon_data_member_reject_at ((source Bytes) (cursor Int)) EpsilonDataMemberParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonDataMemberParseRejected UnexpectedEnd start)
      (EpsilonDataMemberParseRejected UnexpectedToken start))))

(def epsilon_data_member_list_reject_at ((source Bytes)
  (cursor Int)) EpsilonDataMemberListParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonDataMemberListParseRejected UnexpectedEnd start)
      (EpsilonDataMemberListParseRejected UnexpectedToken start))))

(def epsilon_declaration_reject_at ((source Bytes) (cursor Int)) EpsilonDeclarationParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonDeclarationParseRejected UnexpectedEnd start)
      (EpsilonDeclarationParseRejected UnexpectedToken start))))

(def epsilon_parse_optional_return_type ((source Bytes)
  (cursor Int)) EpsilonReturnTypeParseOutcome
  (let arrowStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source arrowStart) 42)
      (let typeOutcome EpsilonTypeParseOutcome (epsilon_parse_type source (epsilon_token_end source arrowStart))
        (match typeOutcome
          ((EpsilonTypeParseRejected reasonValue errorOffset)
            (EpsilonReturnTypeParseRejected reasonValue errorOffset))
          ((EpsilonTypeParsed typeValue)
            (EpsilonReturnTypeParsed
              (SomeEpsilonType arrowStart (epsilon_type_end typeValue) typeValue)
              (epsilon_type_end typeValue)))))
      (EpsilonReturnTypeParsed NoEpsilonType arrowStart))))

(def epsilon_finish_boundary_machine ((source Bytes) (machineStart Int)
  (nameStart Int) (nameEnd Int) (parameters EpsilonParameterList)
  (cursor Int)) EpsilonBoundaryMachineParseOutcome
  (let returnOutcome EpsilonReturnTypeParseOutcome (epsilon_parse_optional_return_type source cursor)
    (match returnOutcome
      ((EpsilonReturnTypeParseRejected reasonValue errorOffset)
        (EpsilonBoundaryMachineParseRejected reasonValue errorOffset))
      ((EpsilonReturnTypeParsed returnType afterReturn)
        (let semiStart Int (epsilon_token_start source afterReturn)
          (if (eq (epsilon_token_code source semiStart) 36)
            (let machineEnd Int (epsilon_token_end source semiStart)
              (EpsilonBoundaryMachineParsed
                (EpsilonBoundaryMachineSyntax machineStart machineEnd
                  (EpsilonNameSpan nameStart nameEnd) parameters returnType)))
            (epsilon_boundary_machine_reject_at source afterReturn)))))))

(def epsilon_parse_boundary_machine ((source Bytes)
  (cursor Int)) EpsilonBoundaryMachineParseOutcome
  (let machineStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source machineStart) 14)
      (let nameStart Int (epsilon_token_start source (epsilon_token_end source machineStart))
        (if (eq (epsilon_token_code source nameStart) 1)
          (let nameEnd Int (epsilon_token_end source nameStart)
            (let openStart Int (epsilon_token_start source nameEnd)
              (if (eq (epsilon_token_code source openStart) 32)
                (let parametersOutcome EpsilonParameterListParseOutcome
                  (epsilon_parse_parameters_acc source (epsilon_token_end source openStart)
                    33 NoEpsilonParameters)
                  (match parametersOutcome
                    ((EpsilonParameterListParseRejected reasonValue errorOffset)
                      (EpsilonBoundaryMachineParseRejected reasonValue errorOffset))
                    ((EpsilonParameterListParsed parameters closeStart)
                      (epsilon_finish_boundary_machine source machineStart
                        nameStart nameEnd parameters
                        (epsilon_token_end source closeStart)))))
                (epsilon_boundary_machine_reject_at source nameEnd))))
          (epsilon_boundary_machine_reject_at source
            (epsilon_token_end source machineStart))))
      (epsilon_boundary_machine_reject_at source cursor))))

(def epsilon_parse_boundary_machines ((source Bytes) (cursor Int)
  (accumulator EpsilonBoundaryMachineList)) EpsilonBoundaryMachineListParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source start)
      (if (eq code 0)
        (EpsilonBoundaryMachineListParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (EpsilonBoundaryMachineListParsed
            (epsilon_reverse_boundary_machines accumulator NoEpsilonBoundaryMachines)
            start)
          (if (eq code 14)
            (let machineOutcome EpsilonBoundaryMachineParseOutcome (epsilon_parse_boundary_machine source start)
              (match machineOutcome
                ((EpsilonBoundaryMachineParseRejected reasonValue errorOffset)
                  (EpsilonBoundaryMachineListParseRejected reasonValue errorOffset))
                ((EpsilonBoundaryMachineParsed machineValue)
                  (epsilon_parse_boundary_machines source
                    (epsilon_boundary_machine_end machineValue)
                    (MoreEpsilonBoundaryMachines machineValue accumulator)))))
            (epsilon_boundary_machine_list_reject_at source start)))))))

(def epsilon_parse_boundary_declaration ((source Bytes)
  (cursor Int)) EpsilonDeclarationParseOutcome
  (let declarationStart Int (epsilon_token_start source cursor)
    (let traitStart Int (epsilon_token_start source
      (epsilon_token_end source declarationStart))
      (if (eq (epsilon_token_code source traitStart) 11)
        (let nameStart Int (epsilon_token_start source (epsilon_token_end source traitStart))
          (if (eq (epsilon_token_code source nameStart) 1)
            (let nameEnd Int (epsilon_token_end source nameStart)
              (let openStart Int (epsilon_token_start source nameEnd)
                (if (eq (epsilon_token_code source openStart) 30)
                  (let machinesOutcome EpsilonBoundaryMachineListParseOutcome
                    (epsilon_parse_boundary_machines source
                      (epsilon_token_end source openStart) NoEpsilonBoundaryMachines)
                    (match machinesOutcome
                      ((EpsilonBoundaryMachineListParseRejected reasonValue errorOffset)
                        (EpsilonDeclarationParseRejected reasonValue errorOffset))
                      ((EpsilonBoundaryMachineListParsed machines closeStart)
                        (let declarationEnd Int (epsilon_token_end source closeStart)
                          (EpsilonDeclarationParsed
                            (EpsilonBoundaryDeclaration declarationStart declarationEnd
                              (EpsilonNameSpan nameStart nameEnd) machines))))))
                  (epsilon_declaration_reject_at source nameEnd))))
            (epsilon_declaration_reject_at source (epsilon_token_end source traitStart))))
        (epsilon_declaration_reject_at source
          (epsilon_token_end source declarationStart))))))

(def epsilon_finish_field_member ((source Bytes) (nameStart Int) (nameEnd Int)
  (cursor Int)) EpsilonDataMemberParseOutcome
  (let typeOutcome EpsilonTypeParseOutcome (epsilon_parse_type source cursor)
    (match typeOutcome
      ((EpsilonTypeParseRejected reasonValue errorOffset)
        (EpsilonDataMemberParseRejected reasonValue errorOffset))
      ((EpsilonTypeParsed typeValue)
        (let semiStart Int (epsilon_token_start source (epsilon_type_end typeValue))
          (if (eq (epsilon_token_code source semiStart) 36)
            (let memberEnd Int (epsilon_token_end source semiStart)
              (EpsilonDataMemberParsed
                (EpsilonFieldMember nameStart memberEnd
                  (EpsilonNameSpan nameStart nameEnd) typeValue)))
            (epsilon_data_member_reject_at source (epsilon_type_end typeValue))))))))

(def epsilon_parse_field_member ((source Bytes) (cursor Int)) EpsilonDataMemberParseOutcome
  (let nameStart Int (epsilon_token_start source cursor)
    (let nameEnd Int (epsilon_token_end source nameStart)
      (let colonStart Int (epsilon_token_start source nameEnd)
        (if (eq (epsilon_token_code source colonStart) 37)
          (epsilon_finish_field_member source nameStart nameEnd
            (epsilon_token_end source colonStart))
          (epsilon_data_member_reject_at source nameEnd))))))

(def epsilon_finish_case_member ((source Bytes) (caseStart Int)
  (nameStart Int) (nameEnd Int) (payload EpsilonOptionalPayload)
  (cursor Int)) EpsilonDataMemberParseOutcome
  (let semiStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source semiStart) 36)
      (let memberEnd Int (epsilon_token_end source semiStart)
        (EpsilonDataMemberParsed
          (EpsilonCaseMember caseStart memberEnd
            (EpsilonNameSpan nameStart nameEnd) payload)))
      (epsilon_data_member_reject_at source cursor))))

(def epsilon_parse_case_payload ((source Bytes) (caseStart Int)
  (nameStart Int) (nameEnd Int) (openStart Int)) EpsilonDataMemberParseOutcome
  (let parametersOutcome EpsilonParameterListParseOutcome
    (epsilon_parse_parameters_acc source (epsilon_token_end source openStart)
      33 NoEpsilonParameters)
    (match parametersOutcome
      ((EpsilonParameterListParseRejected reasonValue errorOffset)
        (EpsilonDataMemberParseRejected reasonValue errorOffset))
      ((EpsilonParameterListParsed parameters closeStart)
        (let closeEnd Int (epsilon_token_end source closeStart)
          (epsilon_finish_case_member source caseStart nameStart nameEnd
            (SomeEpsilonPayload openStart closeEnd parameters) closeEnd))))))

(def epsilon_parse_case_member ((source Bytes) (cursor Int)) EpsilonDataMemberParseOutcome
  (let caseStart Int (epsilon_token_start source cursor)
    (let nameStart Int (epsilon_token_start source (epsilon_token_end source caseStart))
      (if (eq (epsilon_token_code source nameStart) 1)
        (let nameEnd Int (epsilon_token_end source nameStart)
          (let followingStart Int (epsilon_token_start source nameEnd)
            (if (eq (epsilon_token_code source followingStart) 32)
              (epsilon_parse_case_payload source caseStart nameStart nameEnd
                followingStart)
              (epsilon_finish_case_member source caseStart nameStart nameEnd
                NoEpsilonPayload followingStart))))
        (epsilon_data_member_reject_at source
          (epsilon_token_end source caseStart))))))

(def epsilon_parse_data_member ((source Bytes) (cursor Int)) EpsilonDataMemberParseOutcome
  (let memberStart Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source memberStart)
      (if (eq code 1)
        (epsilon_parse_field_member source memberStart)
        (if (eq code 13)
          (epsilon_parse_case_member source memberStart)
          (epsilon_data_member_reject_at source cursor))))))

(def epsilon_parse_data_members ((source Bytes) (cursor Int)
  (accumulator EpsilonDataMemberList)) EpsilonDataMemberListParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source start)
      (if (eq code 0)
        (EpsilonDataMemberListParseRejected UnexpectedEnd start)
        (if (eq code 31)
          (EpsilonDataMemberListParsed
            (epsilon_reverse_data_members accumulator NoEpsilonDataMembers) start)
          (if (eq code 1)
            (let memberOutcome EpsilonDataMemberParseOutcome (epsilon_parse_data_member source start)
              (match memberOutcome
                ((EpsilonDataMemberParseRejected reasonValue errorOffset)
                  (EpsilonDataMemberListParseRejected reasonValue errorOffset))
                ((EpsilonDataMemberParsed memberValue)
                  (epsilon_parse_data_members source (epsilon_data_member_end memberValue)
                    (MoreEpsilonDataMembers memberValue accumulator)))))
            (if (eq code 13)
              (let memberOutcome EpsilonDataMemberParseOutcome (epsilon_parse_data_member source start)
                (match memberOutcome
                  ((EpsilonDataMemberParseRejected reasonValue errorOffset)
                    (EpsilonDataMemberListParseRejected reasonValue errorOffset))
                  ((EpsilonDataMemberParsed memberValue)
                    (epsilon_parse_data_members source (epsilon_data_member_end memberValue)
                      (MoreEpsilonDataMembers memberValue accumulator)))))
              (epsilon_data_member_list_reject_at source start))))))))

(def epsilon_parse_data_declaration ((source Bytes)
  (cursor Int)) EpsilonDeclarationParseOutcome
  (let declarationStart Int (epsilon_token_start source cursor)
    (let nameStart Int (epsilon_token_start source
      (epsilon_token_end source declarationStart))
      (if (eq (epsilon_token_code source nameStart) 1)
        (let nameEnd Int (epsilon_token_end source nameStart)
          (let openStart Int (epsilon_token_start source nameEnd)
            (if (eq (epsilon_token_code source openStart) 30)
              (let membersOutcome EpsilonDataMemberListParseOutcome
                (epsilon_parse_data_members source (epsilon_token_end source openStart)
                  NoEpsilonDataMembers)
                (match membersOutcome
                  ((EpsilonDataMemberListParseRejected reasonValue errorOffset)
                    (EpsilonDeclarationParseRejected reasonValue errorOffset))
                  ((EpsilonDataMemberListParsed members closeStart)
                    (let declarationEnd Int (epsilon_token_end source closeStart)
                      (EpsilonDeclarationParsed
                        (EpsilonDataDeclaration declarationStart declarationEnd
                          (EpsilonNameSpan nameStart nameEnd) members))))))
              (epsilon_declaration_reject_at source nameEnd))))
        (epsilon_declaration_reject_at source
          (epsilon_token_end source declarationStart))))))

; ---- machine declarations and whole-program syntax --------------------

(def epsilon_qualified_name_end ((nameValue EpsilonQualifiedName)) Int
  (match nameValue
    ((EpsilonUnqualifiedName start end name) end)
    ((EpsilonQualifiedNameSyntax start end owner name) end)))

(def epsilon_machine_body_end ((bodyValue EpsilonMachineBody)) Int
  (match bodyValue
    ((EpsilonMachineBodySyntax start end statements terminalValue states) end)))

(def epsilon_declaration_end ((declarationValue EpsilonDeclaration)) Int
  (match declarationValue
    ((EpsilonBoundaryDeclaration start end name machines) end)
    ((EpsilonDataDeclaration start end name members) end)
    ((EpsilonMachineDeclaration start end name inputs returnType bodyValue) end)))

(def epsilon_reverse_declarations ((input EpsilonDeclarationList)
  (output EpsilonDeclarationList)) EpsilonDeclarationList
  (match input
    (NoEpsilonDeclarations output)
    ((MoreEpsilonDeclarations item rest)
      (epsilon_reverse_declarations rest (MoreEpsilonDeclarations item output)))))

(def epsilon_qualified_name_reject_at ((source Bytes)
  (cursor Int)) EpsilonQualifiedNameParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonQualifiedNameParseRejected UnexpectedEnd start)
      (EpsilonQualifiedNameParseRejected UnexpectedToken start))))

(def epsilon_machine_inputs_reject_at ((source Bytes)
  (cursor Int)) EpsilonMachineInputsParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonMachineInputsParseRejected UnexpectedEnd start)
      (EpsilonMachineInputsParseRejected UnexpectedToken start))))

(def epsilon_parse_qualified_name ((source Bytes)
  (cursor Int)) EpsilonQualifiedNameParseOutcome
  (let firstStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source firstStart) 1)
      (let firstEnd Int (epsilon_token_end source firstStart)
        (let scopeStart Int (epsilon_token_start source firstEnd)
          (if (eq (epsilon_token_code source scopeStart) 43)
            (let secondStart Int (epsilon_token_start source
              (epsilon_token_end source scopeStart))
              (if (eq (epsilon_token_code source secondStart) 1)
                (let secondEnd Int (epsilon_token_end source secondStart)
                  (EpsilonQualifiedNameParsed
                    (EpsilonQualifiedNameSyntax firstStart secondEnd
                      (EpsilonNameSpan firstStart firstEnd)
                      (EpsilonNameSpan secondStart secondEnd))))
                (epsilon_qualified_name_reject_at source
                  (epsilon_token_end source scopeStart))))
            (EpsilonQualifiedNameParsed
              (EpsilonUnqualifiedName firstStart firstEnd
                (EpsilonNameSpan firstStart firstEnd))))))
      (epsilon_qualified_name_reject_at source cursor))))

(def epsilon_parse_receiver_parameters ((source Bytes) (openStart Int)
  (receiverStart Int) (receiverEnd Int) (cursor Int)) EpsilonMachineInputsParseOutcome
  (let parameterStart Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source parameterStart) 33)
      (EpsilonMachineInputsParseRejected UnexpectedToken parameterStart)
      (let parametersOutcome EpsilonParameterListParseOutcome
        (epsilon_parse_parameters_acc source parameterStart 33 NoEpsilonParameters)
        (match parametersOutcome
          ((EpsilonParameterListParseRejected reasonValue errorOffset)
            (EpsilonMachineInputsParseRejected reasonValue errorOffset))
          ((EpsilonParameterListParsed parameters closeStart)
            (EpsilonMachineInputsParsed
              (EpsilonReceiverMachineInputs openStart
                (epsilon_token_end source closeStart) receiverStart receiverEnd parameters)
              closeStart)))))))

(def epsilon_finish_receiver_inputs ((source Bytes) (openStart Int)
  (receiverStart Int) (receiverEnd Int) (cursor Int)) EpsilonMachineInputsParseOutcome
  (let followingStart Int (epsilon_token_start source cursor)
    (let followingCode Int (epsilon_token_code source followingStart)
      (if (eq followingCode 33)
        (EpsilonMachineInputsParsed
          (EpsilonReceiverMachineInputs openStart
            (epsilon_token_end source followingStart) receiverStart receiverEnd
            NoEpsilonParameters)
          followingStart)
        (if (eq followingCode 38)
          (epsilon_parse_receiver_parameters source openStart receiverStart
            receiverEnd (epsilon_token_end source followingStart))
          (epsilon_machine_inputs_reject_at source cursor))))))

(def epsilon_parse_receiver_inputs ((source Bytes) (openStart Int)
  (cursor Int)) EpsilonMachineInputsParseOutcome
  (let receiverStart Int (epsilon_token_start source cursor)
    (let mutStart Int (epsilon_token_start source (epsilon_token_end source receiverStart))
      (if (eq (epsilon_token_code source mutStart) 23)
        (let selfStart Int (epsilon_token_start source (epsilon_token_end source mutStart))
          (if (eq (epsilon_token_code source selfStart) 22)
            (let receiverEnd Int (epsilon_token_end source selfStart)
              (epsilon_finish_receiver_inputs source openStart receiverStart
                receiverEnd receiverEnd))
            (epsilon_machine_inputs_reject_at source
              (epsilon_token_end source mutStart))))
        (epsilon_machine_inputs_reject_at source
          (epsilon_token_end source receiverStart))))))

(def epsilon_parse_plain_machine_inputs ((source Bytes) (openStart Int)
  (cursor Int)) EpsilonMachineInputsParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source start)
      (if (eq code 33)
        (EpsilonMachineInputsParsed
          (NoEpsilonMachineInputs openStart (epsilon_token_end source start)) start)
        (if (eq code 40)
          (EpsilonMachineInputsParseRejected UnexpectedToken start)
          (let parametersOutcome EpsilonParameterListParseOutcome
            (epsilon_parse_parameters_acc source start 33 NoEpsilonParameters)
            (match parametersOutcome
              ((EpsilonParameterListParseRejected reasonValue errorOffset)
                (EpsilonMachineInputsParseRejected reasonValue errorOffset))
              ((EpsilonParameterListParsed parameters closeStart)
                (EpsilonMachineInputsParsed
                  (EpsilonPlainMachineInputs openStart
                    (epsilon_token_end source closeStart) parameters)
                  closeStart)))))))))

(def epsilon_parse_qualified_machine_inputs ((source Bytes) (openStart Int)
  (cursor Int)) EpsilonMachineInputsParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source start) 40)
      (epsilon_parse_receiver_inputs source openStart start)
      (epsilon_parse_plain_machine_inputs source openStart start))))

(def epsilon_parse_machine_inputs_for_name ((source Bytes)
  (nameValue EpsilonQualifiedName) (openStart Int)
  (cursor Int)) EpsilonMachineInputsParseOutcome
  (match nameValue
    ((EpsilonUnqualifiedName start end name)
      (epsilon_parse_plain_machine_inputs source openStart cursor))
    ((EpsilonQualifiedNameSyntax start end owner name)
      (epsilon_parse_qualified_machine_inputs source openStart cursor))))

(def epsilon_finish_machine_declaration ((source Bytes) (machineStart Int)
  (nameValue EpsilonQualifiedName) (inputs EpsilonMachineInputs)
  (cursor Int)) EpsilonDeclarationParseOutcome
  (let returnOutcome EpsilonReturnTypeParseOutcome (epsilon_parse_optional_return_type source cursor)
    (match returnOutcome
      ((EpsilonReturnTypeParseRejected reasonValue errorOffset)
        (EpsilonDeclarationParseRejected reasonValue errorOffset))
      ((EpsilonReturnTypeParsed returnType afterReturn)
        (let bodyOutcome EpsilonMachineBodyParseOutcome (epsilon_parse_machine_body source afterReturn)
          (match bodyOutcome
            ((EpsilonMachineBodyParseRejected reasonValue errorOffset)
              (EpsilonDeclarationParseRejected reasonValue errorOffset))
            ((EpsilonMachineBodyParsed bodyValue)
              (EpsilonDeclarationParsed
                (EpsilonMachineDeclaration machineStart
                  (epsilon_machine_body_end bodyValue) nameValue inputs
                  returnType bodyValue)))))))))

(def epsilon_parse_machine_declaration ((source Bytes)
  (cursor Int)) EpsilonDeclarationParseOutcome
  (let machineStart Int (epsilon_token_start source cursor)
    (let nameOutcome EpsilonQualifiedNameParseOutcome (epsilon_parse_qualified_name source
      (epsilon_token_end source machineStart))
      (match nameOutcome
        ((EpsilonQualifiedNameParseRejected reasonValue errorOffset)
          (EpsilonDeclarationParseRejected reasonValue errorOffset))
        ((EpsilonQualifiedNameParsed nameValue)
          (let openStart Int (epsilon_token_start source
            (epsilon_qualified_name_end nameValue))
            (if (eq (epsilon_token_code source openStart) 32)
              (let inputsOutcome EpsilonMachineInputsParseOutcome (epsilon_parse_machine_inputs_for_name source
                nameValue openStart (epsilon_token_end source openStart))
                (match inputsOutcome
                  ((EpsilonMachineInputsParseRejected reasonValue errorOffset)
                    (EpsilonDeclarationParseRejected reasonValue errorOffset))
                  ((EpsilonMachineInputsParsed inputs closeStart)
                    (epsilon_finish_machine_declaration source machineStart nameValue
                      inputs (epsilon_token_end source closeStart)))))
              (epsilon_declaration_reject_at source
                (epsilon_qualified_name_end nameValue)))))))))

(def epsilon_parse_declaration ((source Bytes)
  (cursor Int)) EpsilonDeclarationParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (let code Int (epsilon_token_code source start)
      (if (eq code 10)
        (epsilon_parse_boundary_declaration source start)
        (if (eq code 12)
          (epsilon_parse_data_declaration source start)
          (if (eq code 14)
            (epsilon_parse_machine_declaration source start)
            (epsilon_declaration_reject_at source cursor)))))))

(def epsilon_parse_program_declarations ((source Bytes) (programStart Int)
  (cursor Int) (lastEnd Int) (accumulator EpsilonDeclarationList)) EpsilonProgramParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq (epsilon_token_code source start) 0)
      (EpsilonProgramParsed
        (EpsilonSyntaxProgram programStart lastEnd
          (epsilon_reverse_declarations accumulator NoEpsilonDeclarations)))
      (let declarationOutcome EpsilonDeclarationParseOutcome (epsilon_parse_declaration source start)
        (match declarationOutcome
          ((EpsilonDeclarationParseRejected reasonValue errorOffset)
            (EpsilonProgramParseRejected reasonValue errorOffset))
          ((EpsilonDeclarationParsed declarationValue)
            (let declarationEnd Int (epsilon_declaration_end declarationValue)
              (epsilon_parse_program_declarations source programStart declarationEnd
                declarationEnd
                (MoreEpsilonDeclarations declarationValue accumulator)))))))))

(def epsilon_parse_program_syntax ((source Bytes)) EpsilonProgramParseOutcome
  (let lexicalOutcome EpsilonLexicalOutcome (check_lexical source)
    (match lexicalOutcome
      (LexicallyValid
        (let programStart Int (epsilon_token_start source 0)
          (if (eq programStart (bytes_length source))
            (EpsilonProgramParseRejected UnexpectedEnd programStart)
            (epsilon_parse_program_declarations source programStart programStart
              programStart NoEpsilonDeclarations))))
      ((LexicallyRejected reasonValue errorOffset)
        (EpsilonProgramParseRejected reasonValue errorOffset)))))

; ---- D22/D24 declaration census ---------------------------------------

(def epsilon_census_min_present ((leftReason EpsilonRejectReason)
  (leftOffset Int) (right EpsilonCensusCandidate)) EpsilonCensusCandidate
  (match right
    (NoEpsilonCensusCandidate
      (EpsilonCensusCandidateAt leftReason leftOffset))
    ((EpsilonCensusCandidateAt rightReason rightOffset)
      (if (lt rightOffset leftOffset)
        (EpsilonCensusCandidateAt rightReason rightOffset)
        (EpsilonCensusCandidateAt leftReason leftOffset)))))

(def epsilon_census_min ((left EpsilonCensusCandidate)
  (right EpsilonCensusCandidate)) EpsilonCensusCandidate
  (match left
    (NoEpsilonCensusCandidate right)
    ((EpsilonCensusCandidateAt leftReason leftOffset)
      (epsilon_census_min_present leftReason leftOffset right))))

(def epsilon_census_duplicate ((offset Int)) EpsilonCensusCandidate
  (EpsilonCensusCandidateAt DuplicateName offset))

(def epsilon_name_start ((nameValue EpsilonName)) Int
  (match nameValue ((EpsilonNameSpan start end) start)))

(def epsilon_name_end ((nameValue EpsilonName)) Int
  (match nameValue ((EpsilonNameSpan start end) end)))

(def epsilon_name_bytes_equal ((source Bytes) (left Int) (right Int)
  (remaining Int)) Int
  (if (eq remaining 0)
    1
    (if (eq (bytes_get source left) (bytes_get source right))
      (epsilon_name_bytes_equal source (+ left 1) (+ right 1)
        (- remaining 1))
      0)))

(def epsilon_names_equal ((source Bytes) (left EpsilonName)
  (right EpsilonName)) Int
  (let leftStart Int (epsilon_name_start left)
    (let rightStart Int (epsilon_name_start right)
      (let leftLength Int (- (epsilon_name_end left) leftStart)
        (let rightLength Int (- (epsilon_name_end right) rightStart)
          (if (eq leftLength rightLength)
            (epsilon_name_bytes_equal source leftStart rightStart leftLength)
            0))))))

(def epsilon_census_name_in_list ((source Bytes) (nameValue EpsilonName)
  (names EpsilonNameList)) Int
  (match names
    (NoEpsilonNames 0)
    ((MoreEpsilonNames item rest)
      (if (epsilon_names_equal source nameValue item)
        1
        (epsilon_census_name_in_list source nameValue rest)))))

(def epsilon_census_name_against_names ((source Bytes)
  (nameValue EpsilonName) (names EpsilonNameList)) EpsilonCensusCandidate
  (match names
    (NoEpsilonNames NoEpsilonCensusCandidate)
    ((MoreEpsilonNames item rest)
      (let current EpsilonCensusCandidate
        (if (epsilon_names_equal source nameValue item)
          (epsilon_census_duplicate (epsilon_name_start item))
          NoEpsilonCensusCandidate)
        (epsilon_census_min current
          (epsilon_census_name_against_names source nameValue rest))))))

(def epsilon_census_name_list_duplicates ((source Bytes)
  (names EpsilonNameList)) EpsilonCensusCandidate
  (match names
    (NoEpsilonNames NoEpsilonCensusCandidate)
    ((MoreEpsilonNames item rest)
      (epsilon_census_min
        (epsilon_census_name_against_names source item rest)
        (epsilon_census_name_list_duplicates source rest)))))

(def epsilon_parameter_start ((parameterValue EpsilonParameter)) Int
  (match parameterValue
    ((EpsilonParameterSyntax start end name typeValue) start)))

(def epsilon_parameter_name ((parameterValue EpsilonParameter)) EpsilonName
  (match parameterValue
    ((EpsilonParameterSyntax start end name typeValue) name)))

(def epsilon_census_parameter_against ((source Bytes) (nameValue EpsilonName)
  (parameters EpsilonParameterList)) EpsilonCensusCandidate
  (match parameters
    (NoEpsilonParameters NoEpsilonCensusCandidate)
    ((MoreEpsilonParameters item rest)
      (let current EpsilonCensusCandidate
        (if (epsilon_names_equal source nameValue (epsilon_parameter_name item))
          (epsilon_census_duplicate (epsilon_parameter_start item))
          NoEpsilonCensusCandidate)
        (epsilon_census_min current
          (epsilon_census_parameter_against source nameValue rest))))))

(def epsilon_census_parameter_duplicates ((source Bytes)
  (parameters EpsilonParameterList)) EpsilonCensusCandidate
  (match parameters
    (NoEpsilonParameters NoEpsilonCensusCandidate)
    ((MoreEpsilonParameters item rest)
      (epsilon_census_min
        (epsilon_census_parameter_against source (epsilon_parameter_name item) rest)
        (epsilon_census_parameter_duplicates source rest)))))

(def epsilon_census_parameter_outer_collisions ((source Bytes)
  (parameters EpsilonParameterList)
  (environment EpsilonNameList)) EpsilonCensusCandidate
  (match parameters
    (NoEpsilonParameters NoEpsilonCensusCandidate)
    ((MoreEpsilonParameters item rest)
      (let current EpsilonCensusCandidate
        (if (epsilon_census_name_in_list source (epsilon_parameter_name item)
          environment)
          (epsilon_census_duplicate (epsilon_parameter_start item))
          NoEpsilonCensusCandidate)
        (epsilon_census_min current
          (epsilon_census_parameter_outer_collisions source rest environment))))))

(def epsilon_census_prepend_parameters ((parameters EpsilonParameterList)
  (environment EpsilonNameList)) EpsilonNameList
  (match parameters
    (NoEpsilonParameters environment)
    ((MoreEpsilonParameters item rest)
      (MoreEpsilonNames (epsilon_parameter_name item)
        (epsilon_census_prepend_parameters rest environment)))))

(def epsilon_census_inputs_parameters ((inputs EpsilonMachineInputs)) EpsilonParameterList
  (match inputs
    ((NoEpsilonMachineInputs start end) NoEpsilonParameters)
    ((EpsilonPlainMachineInputs start end parameters) parameters)
    ((EpsilonReceiverMachineInputs start end receiverStart receiverEnd parameters)
      parameters)))

(def epsilon_census_scan_statements ((source Bytes)
  (statements EpsilonStatementList)
  (environment EpsilonNameList)) EpsilonCensusLocalScan
  (match statements
    (NoEpsilonStatements
      (EpsilonCensusLocalScanResult NoEpsilonCensusCandidate environment))
    ((MoreEpsilonStatements item rest)
      (match item
        ((EpsilonLetStatement start end name typeValue expressionValue)
          (let current EpsilonCensusCandidate
            (if (epsilon_census_name_in_list source name environment)
              (epsilon_census_duplicate start)
              NoEpsilonCensusCandidate)
            (let tailScan EpsilonCensusLocalScan
              (epsilon_census_scan_statements source rest
                (MoreEpsilonNames name environment))
              (match tailScan
                ((EpsilonCensusLocalScanResult tailCandidate tailEnvironment)
                  (EpsilonCensusLocalScanResult
                    (epsilon_census_min current tailCandidate)
                    tailEnvironment))))))
        ((EpsilonAssignmentStatement start end placeValue expressionValue)
          (epsilon_census_scan_statements source rest environment))
        ((EpsilonPostfixStatement start end expressionValue)
          (epsilon_census_scan_statements source rest environment))
        ((EpsilonAssertStatement start end expressionValue)
          (epsilon_census_scan_statements source rest environment))))))

(def epsilon_census_binder_outer_collisions ((source Bytes)
  (names EpsilonNameList) (environment EpsilonNameList)) EpsilonCensusCandidate
  (match names
    (NoEpsilonNames NoEpsilonCensusCandidate)
    ((MoreEpsilonNames item rest)
      (let current EpsilonCensusCandidate
        (if (epsilon_census_name_in_list source item environment)
          (epsilon_census_duplicate (epsilon_name_start item))
          NoEpsilonCensusCandidate)
        (epsilon_census_min current
          (epsilon_census_binder_outer_collisions source rest environment))))))

(def epsilon_census_optional_binder ((source Bytes)
  (binder EpsilonOptionalBinder)
  (environment EpsilonNameList)) EpsilonCensusCandidate
  (match binder
    (NoEpsilonBinder NoEpsilonCensusCandidate)
    ((SomeEpsilonBinder start end names)
      (epsilon_census_min
        (epsilon_census_name_list_duplicates source names)
        (epsilon_census_binder_outer_collisions source names environment)))))

(def epsilon_census_pattern_binder ((source Bytes) (patternValue EpsilonPattern)
  (environment EpsilonNameList)) EpsilonCensusCandidate
  (match patternValue
    ((EpsilonIntegerPattern start end literal) NoEpsilonCensusCandidate)
    ((EpsilonTruePattern start end) NoEpsilonCensusCandidate)
    ((EpsilonFalsePattern start end) NoEpsilonCensusCandidate)
    ((EpsilonWildcardPattern start end) NoEpsilonCensusCandidate)
    ((EpsilonCasePattern start end owner name binder)
      (epsilon_census_optional_binder source binder environment))))

(def epsilon_census_arms ((source Bytes) (arms EpsilonArmList)
  (environment EpsilonNameList)) EpsilonCensusCandidate
  (match arms
    (NoEpsilonArms NoEpsilonCensusCandidate)
    ((MoreEpsilonArms item rest)
      (match item
        ((EpsilonArmSyntax start end patternValue continuationValue)
          (epsilon_census_min
            (epsilon_census_pattern_binder source patternValue environment)
            (epsilon_census_arms source rest environment)))))))

(def epsilon_census_optional_terminal ((source Bytes)
  (terminalValue EpsilonOptionalTerminal)
  (environment EpsilonNameList)) EpsilonCensusCandidate
  (match terminalValue
    (NoEpsilonTerminal NoEpsilonCensusCandidate)
    ((SomeEpsilonTerminal terminal)
      (match terminal
        ((EpsilonTransitionTerminal start end subject arms)
          (epsilon_census_arms source arms environment))
        ((EpsilonReturnTerminal start end expressionValue)
          NoEpsilonCensusCandidate)))))

(def epsilon_census_block ((source Bytes) (statements EpsilonStatementList)
  (terminalValue EpsilonOptionalTerminal)
  (environment EpsilonNameList)) EpsilonCensusCandidate
  (let localScan EpsilonCensusLocalScan (epsilon_census_scan_statements source statements environment)
    (match localScan
      ((EpsilonCensusLocalScanResult localCandidate finalEnvironment)
        (epsilon_census_min localCandidate
          (epsilon_census_optional_terminal source terminalValue
            finalEnvironment))))))

(def epsilon_state_start ((stateValue EpsilonState)) Int
  (match stateValue
    ((EpsilonStateSyntax start end name parameters bodyValue) start)))

(def epsilon_state_name ((stateValue EpsilonState)) EpsilonName
  (match stateValue
    ((EpsilonStateSyntax start end name parameters bodyValue) name)))

(def epsilon_census_state_against ((source Bytes) (nameValue EpsilonName)
  (states EpsilonStateList)) EpsilonCensusCandidate
  (match states
    (NoEpsilonStates NoEpsilonCensusCandidate)
    ((MoreEpsilonStates item rest)
      (let current EpsilonCensusCandidate
        (if (epsilon_names_equal source nameValue (epsilon_state_name item))
          (epsilon_census_duplicate (epsilon_state_start item))
          NoEpsilonCensusCandidate)
        (epsilon_census_min current
          (epsilon_census_state_against source nameValue rest))))))

(def epsilon_census_state_duplicates ((source Bytes)
  (states EpsilonStateList)) EpsilonCensusCandidate
  (match states
    (NoEpsilonStates NoEpsilonCensusCandidate)
    ((MoreEpsilonStates item rest)
      (epsilon_census_min
        (epsilon_census_state_against source (epsilon_state_name item) rest)
        (epsilon_census_state_duplicates source rest)))))

(def epsilon_census_state_scope ((source Bytes) (stateValue EpsilonState)
  (machineEnvironment EpsilonNameList)) EpsilonCensusCandidate
  (match stateValue
    ((EpsilonStateSyntax start end name parameters bodyValue)
      (let parameterCandidates EpsilonCensusCandidate
        (epsilon_census_min
          (epsilon_census_parameter_duplicates source parameters)
          (epsilon_census_parameter_outer_collisions source parameters
            machineEnvironment))
        (let stateEnvironment EpsilonNameList
          (epsilon_census_prepend_parameters parameters machineEnvironment)
          (match bodyValue
            ((EpsilonStateBodySyntax bodyStart bodyEnd statements terminalValue)
              (epsilon_census_min parameterCandidates
                (epsilon_census_block source statements terminalValue
                  stateEnvironment)))))))))

(def epsilon_census_state_scopes ((source Bytes) (states EpsilonStateList)
  (machineEnvironment EpsilonNameList)) EpsilonCensusCandidate
  (match states
    (NoEpsilonStates NoEpsilonCensusCandidate)
    ((MoreEpsilonStates item rest)
      (epsilon_census_min
        (epsilon_census_state_scope source item machineEnvironment)
        (epsilon_census_state_scopes source rest machineEnvironment)))))

(def epsilon_census_machine_scope ((source Bytes) (inputs EpsilonMachineInputs)
  (bodyValue EpsilonMachineBody)) EpsilonCensusCandidate
  (let parameters EpsilonParameterList (epsilon_census_inputs_parameters inputs)
    (let parameterCandidates EpsilonCensusCandidate
      (epsilon_census_parameter_duplicates source parameters)
      (let machineEnvironment EpsilonNameList
        (epsilon_census_prepend_parameters parameters NoEpsilonNames)
        (match bodyValue
          ((EpsilonMachineBodySyntax start end statements terminalValue states)
            (epsilon_census_min parameterCandidates
              (epsilon_census_min
                (epsilon_census_block source statements terminalValue
                  machineEnvironment)
                (epsilon_census_min
                  (epsilon_census_state_duplicates source states)
                  (epsilon_census_state_scopes source states
                    machineEnvironment))))))))))

(def epsilon_boundary_machine_start ((machineValue EpsilonBoundaryMachine)) Int
  (match machineValue
    ((EpsilonBoundaryMachineSyntax start end name parameters returnType) start)))

(def epsilon_boundary_machine_name ((machineValue EpsilonBoundaryMachine)) EpsilonName
  (match machineValue
    ((EpsilonBoundaryMachineSyntax start end name parameters returnType) name)))

(def epsilon_census_boundary_machine_against ((source Bytes)
  (nameValue EpsilonName)
  (machines EpsilonBoundaryMachineList)) EpsilonCensusCandidate
  (match machines
    (NoEpsilonBoundaryMachines NoEpsilonCensusCandidate)
    ((MoreEpsilonBoundaryMachines item rest)
      (let current EpsilonCensusCandidate
        (if (epsilon_names_equal source nameValue
          (epsilon_boundary_machine_name item))
          (epsilon_census_duplicate (epsilon_boundary_machine_start item))
          NoEpsilonCensusCandidate)
        (epsilon_census_min current
          (epsilon_census_boundary_machine_against source nameValue rest))))))

(def epsilon_census_boundary_machine_duplicates ((source Bytes)
  (machines EpsilonBoundaryMachineList)) EpsilonCensusCandidate
  (match machines
    (NoEpsilonBoundaryMachines NoEpsilonCensusCandidate)
    ((MoreEpsilonBoundaryMachines item rest)
      (epsilon_census_min
        (epsilon_census_boundary_machine_against source
          (epsilon_boundary_machine_name item) rest)
        (epsilon_census_boundary_machine_duplicates source rest)))))

(def epsilon_census_boundary_machine_parameters ((source Bytes)
  (machines EpsilonBoundaryMachineList)) EpsilonCensusCandidate
  (match machines
    (NoEpsilonBoundaryMachines NoEpsilonCensusCandidate)
    ((MoreEpsilonBoundaryMachines item rest)
      (match item
        ((EpsilonBoundaryMachineSyntax start end name parameters returnType)
          (epsilon_census_min
            (epsilon_census_parameter_duplicates source parameters)
            (epsilon_census_boundary_machine_parameters source rest)))))))

(def epsilon_data_member_start ((memberValue EpsilonDataMember)) Int
  (match memberValue
    ((EpsilonFieldMember start end name typeValue) start)
    ((EpsilonCaseMember start end name payload) start)))

(def epsilon_data_member_name ((memberValue EpsilonDataMember)) EpsilonName
  (match memberValue
    ((EpsilonFieldMember start end name typeValue) name)
    ((EpsilonCaseMember start end name payload) name)))

(def epsilon_census_data_member_against ((source Bytes) (nameValue EpsilonName)
  (members EpsilonDataMemberList)) EpsilonCensusCandidate
  (match members
    (NoEpsilonDataMembers NoEpsilonCensusCandidate)
    ((MoreEpsilonDataMembers item rest)
      (let current EpsilonCensusCandidate
        (if (epsilon_names_equal source nameValue (epsilon_data_member_name item))
          (epsilon_census_duplicate (epsilon_data_member_start item))
          NoEpsilonCensusCandidate)
        (epsilon_census_min current
          (epsilon_census_data_member_against source nameValue rest))))))

(def epsilon_census_data_member_duplicates ((source Bytes)
  (members EpsilonDataMemberList)) EpsilonCensusCandidate
  (match members
    (NoEpsilonDataMembers NoEpsilonCensusCandidate)
    ((MoreEpsilonDataMembers item rest)
      (epsilon_census_min
        (epsilon_census_data_member_against source
          (epsilon_data_member_name item) rest)
        (epsilon_census_data_member_duplicates source rest)))))

(def epsilon_census_data_payload_parameters ((source Bytes)
  (members EpsilonDataMemberList)) EpsilonCensusCandidate
  (match members
    (NoEpsilonDataMembers NoEpsilonCensusCandidate)
    ((MoreEpsilonDataMembers item rest)
      (match item
        ((EpsilonFieldMember start end name typeValue)
          (epsilon_census_data_payload_parameters source rest))
        ((EpsilonCaseMember start end name payload)
          (let current EpsilonCensusCandidate
            (match payload
              (NoEpsilonPayload NoEpsilonCensusCandidate)
              ((SomeEpsilonPayload payloadStart payloadEnd parameters)
                (epsilon_census_parameter_duplicates source parameters)))
            (epsilon_census_min current
              (epsilon_census_data_payload_parameters source rest))))))))

(def epsilon_unqualified_name_equal_right ((source Bytes) (leftName EpsilonName)
  (right EpsilonQualifiedName)) Int
  (match right
    ((EpsilonUnqualifiedName rightStart rightEnd rightName)
      (epsilon_names_equal source leftName rightName))
    ((EpsilonQualifiedNameSyntax rightStart rightEnd rightOwner rightName) 0)))

(def epsilon_qualified_name_equal_right ((source Bytes) (leftOwner EpsilonName)
  (leftName EpsilonName) (right EpsilonQualifiedName)) Int
  (match right
    ((EpsilonUnqualifiedName rightStart rightEnd rightName) 0)
    ((EpsilonQualifiedNameSyntax rightStart rightEnd rightOwner rightName)
      (if (epsilon_names_equal source leftOwner rightOwner)
        (epsilon_names_equal source leftName rightName)
        0))))

(def epsilon_qualified_names_equal ((source Bytes)
  (left EpsilonQualifiedName) (right EpsilonQualifiedName)) Int
  (match left
    ((EpsilonUnqualifiedName leftStart leftEnd leftName)
      (epsilon_unqualified_name_equal_right source leftName right))
    ((EpsilonQualifiedNameSyntax leftStart leftEnd leftOwner leftName)
      (epsilon_qualified_name_equal_right source leftOwner leftName right))))

(def epsilon_owner_identity_merge_present ((left EpsilonOwnerIdentity)
  (right EpsilonOwnerIdentity)) EpsilonOwnerIdentity
  (match right
    (NoEpsilonOwnerIdentity left)
    (OneEpsilonBoundaryOwner AmbiguousEpsilonOwnerIdentity)
    (OneEpsilonDataOwner AmbiguousEpsilonOwnerIdentity)
    (AmbiguousEpsilonOwnerIdentity AmbiguousEpsilonOwnerIdentity)))

(def epsilon_owner_identity_merge ((left EpsilonOwnerIdentity)
  (right EpsilonOwnerIdentity)) EpsilonOwnerIdentity
  (match left
    (NoEpsilonOwnerIdentity right)
    (OneEpsilonBoundaryOwner
      (epsilon_owner_identity_merge_present OneEpsilonBoundaryOwner right))
    (OneEpsilonDataOwner
      (epsilon_owner_identity_merge_present OneEpsilonDataOwner right))
    (AmbiguousEpsilonOwnerIdentity AmbiguousEpsilonOwnerIdentity)))

(def epsilon_owner_identity_for_rows ((source Bytes) (owner EpsilonName)
  (rows EpsilonOwnerRowList)) EpsilonOwnerIdentity
  (match rows
    (NoEpsilonOwnerRows NoEpsilonOwnerIdentity)
    ((MoreEpsilonOwnerRows item rest)
      (match item
        ((EpsilonOwnerRowSyntax declarationStart rowName kind)
          (let current EpsilonOwnerIdentity
            (if (epsilon_names_equal source owner rowName)
              (match kind
                (EpsilonBoundaryOwnerKind OneEpsilonBoundaryOwner)
                (EpsilonDataOwnerKind OneEpsilonDataOwner))
              NoEpsilonOwnerIdentity)
            (epsilon_owner_identity_merge current
              (epsilon_owner_identity_for_rows source owner rest))))))))

(def epsilon_reverse_owner_rows ((input EpsilonOwnerRowList)
  (output EpsilonOwnerRowList)) EpsilonOwnerRowList
  (match input
    (NoEpsilonOwnerRows output)
    ((MoreEpsilonOwnerRows item rest)
      (epsilon_reverse_owner_rows rest (MoreEpsilonOwnerRows item output)))))

(def epsilon_collect_owner_rows_acc ((declarations EpsilonDeclarationList)
  (accumulator EpsilonOwnerRowList)) EpsilonOwnerRowList
  (match declarations
    (NoEpsilonDeclarations
      (epsilon_reverse_owner_rows accumulator NoEpsilonOwnerRows))
    ((MoreEpsilonDeclarations item rest)
      (match item
        ((EpsilonBoundaryDeclaration start end name machines)
          (epsilon_collect_owner_rows_acc rest
            (MoreEpsilonOwnerRows
              (EpsilonOwnerRowSyntax start name EpsilonBoundaryOwnerKind)
              accumulator)))
        ((EpsilonDataDeclaration start end name members)
          (epsilon_collect_owner_rows_acc rest
            (MoreEpsilonOwnerRows
              (EpsilonOwnerRowSyntax start name EpsilonDataOwnerKind)
              accumulator)))
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (epsilon_collect_owner_rows_acc rest accumulator))))))

(def epsilon_reverse_machine_rows ((input EpsilonMachineRowList)
  (output EpsilonMachineRowList)) EpsilonMachineRowList
  (match input
    (NoEpsilonMachineRows output)
    ((MoreEpsilonMachineRows item rest)
      (epsilon_reverse_machine_rows rest (MoreEpsilonMachineRows item output)))))

(def epsilon_collect_machine_rows_acc ((declarations EpsilonDeclarationList)
  (accumulator EpsilonMachineRowList)) EpsilonMachineRowList
  (match declarations
    (NoEpsilonDeclarations
      (epsilon_reverse_machine_rows accumulator NoEpsilonMachineRows))
    ((MoreEpsilonDeclarations item rest)
      (match item
        ((EpsilonBoundaryDeclaration start end name machines)
          (epsilon_collect_machine_rows_acc rest accumulator))
        ((EpsilonDataDeclaration start end name members)
          (epsilon_collect_machine_rows_acc rest accumulator))
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (epsilon_collect_machine_rows_acc rest
            (MoreEpsilonMachineRows (EpsilonMachineRowSyntax start name)
              accumulator)))))))

; Superseded by D51: constructor and receiver-machine syntax now select
; disjoint namespaces, so this former D36 cross-kind collision census is
; deletion work rather than accepted semantics.
(def epsilon_census_later_callable_start ((leftStart Int)
  (rightStart Int)) Int
  (if (lt leftStart rightStart) rightStart leftStart))

(def epsilon_census_case_against_machine_rows ((source Bytes)
  (owner EpsilonName) (caseStart Int) (caseName EpsilonName)
  (machines EpsilonMachineRowList)) EpsilonCensusCandidate
  (match machines
    (NoEpsilonMachineRows NoEpsilonCensusCandidate)
    ((MoreEpsilonMachineRows item rest)
      (match item
        ((EpsilonMachineRowSyntax machineStart qualifiedName)
          (let current EpsilonCensusCandidate
            (match qualifiedName
              ((EpsilonUnqualifiedName nameStart nameEnd machineName)
                NoEpsilonCensusCandidate)
              ((EpsilonQualifiedNameSyntax nameStart nameEnd machineOwner
                machineName)
                (if (if (epsilon_names_equal source owner machineOwner)
                      (epsilon_names_equal source caseName machineName)
                      0)
                  (epsilon_census_duplicate
                    (epsilon_census_later_callable_start caseStart machineStart))
                  NoEpsilonCensusCandidate)))
            (epsilon_census_min current
              (epsilon_census_case_against_machine_rows source owner caseStart
                caseName rest))))))))

(def epsilon_census_data_callable_members ((source Bytes) (owner EpsilonName)
  (members EpsilonDataMemberList)
  (machines EpsilonMachineRowList)) EpsilonCensusCandidate
  (match members
    (NoEpsilonDataMembers NoEpsilonCensusCandidate)
    ((MoreEpsilonDataMembers item rest)
      (match item
        ((EpsilonFieldMember start end name typeValue)
          (epsilon_census_data_callable_members source owner rest machines))
        ((EpsilonCaseMember start end name payload)
          (epsilon_census_min
            (epsilon_census_case_against_machine_rows source owner start name
              machines)
            (epsilon_census_data_callable_members source owner rest machines)))))))

(def epsilon_census_callable_collisions ((source Bytes)
  (declarations EpsilonDeclarationList) (owners EpsilonOwnerRowList)
  (machines EpsilonMachineRowList)) EpsilonCensusCandidate
  (match declarations
    (NoEpsilonDeclarations NoEpsilonCensusCandidate)
    ((MoreEpsilonDeclarations item rest)
      (let current EpsilonCensusCandidate
        (match item
          ((EpsilonBoundaryDeclaration start end name boundaryMachines)
            NoEpsilonCensusCandidate)
          ((EpsilonDataDeclaration start end name members)
            (match (epsilon_owner_identity_for_rows source name owners)
              (OneEpsilonDataOwner
                (epsilon_census_data_callable_members source name members
                  machines))
              (NoEpsilonOwnerIdentity NoEpsilonCensusCandidate)
              (OneEpsilonBoundaryOwner NoEpsilonCensusCandidate)
              (AmbiguousEpsilonOwnerIdentity NoEpsilonCensusCandidate)))
          ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
            NoEpsilonCensusCandidate))
        (epsilon_census_min current
          (epsilon_census_callable_collisions source rest owners machines))))))

(def epsilon_census_owner_name_against ((source Bytes) (nameValue EpsilonName)
  (declarations EpsilonDeclarationList)) EpsilonCensusCandidate
  (match declarations
    (NoEpsilonDeclarations NoEpsilonCensusCandidate)
    ((MoreEpsilonDeclarations item rest)
      (match item
        ((EpsilonBoundaryDeclaration start end name machines)
          (let current EpsilonCensusCandidate
            (if (epsilon_names_equal source nameValue name)
              (epsilon_census_duplicate start)
              NoEpsilonCensusCandidate)
            (epsilon_census_min current
              (epsilon_census_owner_name_against source nameValue rest))))
        ((EpsilonDataDeclaration start end name members)
          (let current EpsilonCensusCandidate
            (if (epsilon_names_equal source nameValue name)
              (epsilon_census_duplicate start)
              NoEpsilonCensusCandidate)
            (epsilon_census_min current
              (epsilon_census_owner_name_against source nameValue rest))))
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (epsilon_census_owner_name_against source nameValue rest))))))

(def epsilon_census_owner_against ((source Bytes)
  (declarationValue EpsilonDeclaration)
  (rest EpsilonDeclarationList)) EpsilonCensusCandidate
  (match declarationValue
    ((EpsilonBoundaryDeclaration start end name machines)
      (epsilon_census_owner_name_against source name rest))
    ((EpsilonDataDeclaration start end name members)
      (epsilon_census_owner_name_against source name rest))
    ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
      NoEpsilonCensusCandidate)))

(def epsilon_census_machine_name_against ((source Bytes)
  (nameValue EpsilonQualifiedName)
  (declarations EpsilonDeclarationList)) EpsilonCensusCandidate
  (match declarations
    (NoEpsilonDeclarations NoEpsilonCensusCandidate)
    ((MoreEpsilonDeclarations item rest)
      (match item
        ((EpsilonBoundaryDeclaration start end name machines)
          (epsilon_census_machine_name_against source nameValue rest))
        ((EpsilonDataDeclaration start end name members)
          (epsilon_census_machine_name_against source nameValue rest))
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (let current EpsilonCensusCandidate
            (if (epsilon_qualified_names_equal source nameValue name)
              (epsilon_census_duplicate start)
              NoEpsilonCensusCandidate)
            (epsilon_census_min current
              (epsilon_census_machine_name_against source nameValue rest))))))))

(def epsilon_census_machine_against ((source Bytes)
  (declarationValue EpsilonDeclaration)
  (rest EpsilonDeclarationList)) EpsilonCensusCandidate
  (match declarationValue
    ((EpsilonBoundaryDeclaration start end name machines)
      NoEpsilonCensusCandidate)
    ((EpsilonDataDeclaration start end name members)
      NoEpsilonCensusCandidate)
    ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
      (epsilon_census_machine_name_against source name rest))))

(def epsilon_census_invalid_boundary ((source Bytes)
  (declarationValue EpsilonDeclaration)
  (owners EpsilonOwnerRowList)) EpsilonCensusCandidate
  (match declarationValue
    ((EpsilonBoundaryDeclaration start end name machines)
      NoEpsilonCensusCandidate)
    ((EpsilonDataDeclaration start end name members)
      NoEpsilonCensusCandidate)
    ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
      (match name
        ((EpsilonUnqualifiedName nameStart nameEnd machineName)
          NoEpsilonCensusCandidate)
        ((EpsilonQualifiedNameSyntax nameStart nameEnd owner machineName)
          (match (epsilon_owner_identity_for_rows source owner owners)
            (NoEpsilonOwnerIdentity NoEpsilonCensusCandidate)
            (OneEpsilonBoundaryOwner
              (EpsilonCensusCandidateAt InvalidBoundary start))
            (OneEpsilonDataOwner NoEpsilonCensusCandidate)
            (AmbiguousEpsilonOwnerIdentity NoEpsilonCensusCandidate)))))))

(def epsilon_census_declaration_contents ((source Bytes)
  (declarationValue EpsilonDeclaration)) EpsilonCensusCandidate
  (match declarationValue
    ((EpsilonBoundaryDeclaration start end name machines)
      (epsilon_census_min
        (epsilon_census_boundary_machine_duplicates source machines)
        (epsilon_census_boundary_machine_parameters source machines)))
    ((EpsilonDataDeclaration start end name members)
      (epsilon_census_min
        (epsilon_census_data_member_duplicates source members)
        (epsilon_census_data_payload_parameters source members)))
    ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
      (epsilon_census_machine_scope source inputs bodyValue))))

(def epsilon_census_declarations ((source Bytes)
  (declarations EpsilonDeclarationList)
  (owners EpsilonOwnerRowList)) EpsilonCensusCandidate
  (match declarations
    (NoEpsilonDeclarations NoEpsilonCensusCandidate)
    ((MoreEpsilonDeclarations item rest)
      (epsilon_census_min
        (epsilon_census_owner_against source item rest)
        (epsilon_census_min
          (epsilon_census_machine_against source item rest)
          (epsilon_census_min
            (epsilon_census_invalid_boundary source item owners)
            (epsilon_census_min
              (epsilon_census_declaration_contents source item)
              (epsilon_census_declarations source rest owners))))))))

(def epsilon_collect_program_identities ((source Bytes)
  (program EpsilonProgram)) EpsilonCensusOutcome
  (match program
    ((EpsilonSyntaxProgram start end declarations)
      ; Owner rows are complete before any authored qualified body is
      ; classified. Duplicate owners of either kind therefore yield Ambiguous,
      ; never a first-row boundary decision.
      (let owners EpsilonOwnerRowList (epsilon_collect_owner_rows_acc declarations NoEpsilonOwnerRows)
        (let machines EpsilonMachineRowList
          (epsilon_collect_machine_rows_acc declarations NoEpsilonMachineRows)
          (let candidate EpsilonCensusCandidate
            (epsilon_census_min
              (epsilon_census_declarations source declarations owners)
              (epsilon_census_callable_collisions source declarations owners
                machines))
            (match candidate
              (NoEpsilonCensusCandidate
                (EpsilonCensusAccepted
                  (EpsilonCollectedProgramSyntax program owners machines)))
              ((EpsilonCensusCandidateAt reasonValue errorOffset)
                (EpsilonCensusRejected reasonValue errorOffset)))))))))

(def epsilon_parse_and_collect_program ((source Bytes)) EpsilonCensusOutcome
  (match (epsilon_parse_program_syntax source)
    ((EpsilonProgramParseRejected reasonValue errorOffset)
      (EpsilonCensusRejected reasonValue errorOffset))
    ((EpsilonProgramParsed program)
      (epsilon_collect_program_identities source program))))

; ---- D31 structural type formation ---------------------------------------

(def epsilon_type_formation_candidate_min_present ((leftKind Int)
  (leftReason EpsilonRejectReason) (leftOffset Int)
  (right EpsilonTypeFormationCandidate)) EpsilonTypeFormationCandidate
  (match right
    (NoEpsilonTypeFormationCandidate
      (EpsilonTypeFormationCandidateAt leftKind leftReason leftOffset))
    ((EpsilonTypeFormationCandidateAt rightKind rightReason rightOffset)
      (if (lt rightOffset leftOffset)
        right
        (if (lt leftOffset rightOffset)
          (EpsilonTypeFormationCandidateAt leftKind leftReason leftOffset)
          (if (eq leftKind rightKind)
            (EpsilonTypeFormationCandidateAt leftKind leftReason leftOffset)
            (EpsilonTypeFormationConflict leftOffset)))))
    ((EpsilonTypeFormationConflict rightOffset) right)))

(def epsilon_type_formation_candidate_min ((left EpsilonTypeFormationCandidate)
  (right EpsilonTypeFormationCandidate)) EpsilonTypeFormationCandidate
  (match left
    (NoEpsilonTypeFormationCandidate right)
    ((EpsilonTypeFormationCandidateAt leftKind leftReason leftOffset)
      (epsilon_type_formation_candidate_min_present leftKind leftReason
        leftOffset right))
    ((EpsilonTypeFormationConflict leftOffset) left)))

(def epsilon_owner_name_exists ((source Bytes) (nameValue EpsilonName)
  (owners EpsilonOwnerRowList)) Int
  (match owners
    (NoEpsilonOwnerRows 0)
    ((MoreEpsilonOwnerRows item rest)
      (match item
        ((EpsilonOwnerRowSyntax declarationStart rowName kind)
          (if (epsilon_names_equal source nameValue rowName)
            1
            (epsilon_owner_name_exists source nameValue rest)))))))

(def epsilon_name_is_main ((source Bytes) (nameValue EpsilonName)) Int
  (match nameValue
    ((EpsilonNameSpan start end)
      (epsilon_span_is_4 source start end 77 97 105 110))))

(def epsilon_name_is_console_field ((source Bytes)
  (nameValue EpsilonName)) Int
  (match nameValue
    ((EpsilonNameSpan start end)
      (epsilon_span_is_7 source start end 99 111 110 115 111 108 101))))

(def epsilon_name_is_console_type ((source Bytes)
  (nameValue EpsilonName)) Int
  (match nameValue
    ((EpsilonNameSpan start end)
      (epsilon_span_is_7 source start end 67 111 110 115 111 108 101))))

(def epsilon_is_main_console_field ((source Bytes) (owner EpsilonName)
  (field EpsilonName)) Int
  (if (epsilon_name_is_main source owner)
    (epsilon_name_is_console_field source field)
    0))

(def epsilon_never_placement_candidate ((start Int)
  (placement EpsilonTypePlacement)) EpsilonTypeFormationCandidate
  (match placement
    (EpsilonStoredTypePlacement
      (EpsilonTypeFormationCandidateAt 6 TypeMismatch start))
    (EpsilonParameterTypePlacement
      (EpsilonTypeFormationCandidateAt 6 TypeMismatch start))
    (EpsilonLocalTypePlacement
      (EpsilonTypeFormationCandidateAt 6 TypeMismatch start))
    (EpsilonReturnTypePlacement NoEpsilonTypeFormationCandidate)
    (EpsilonMainConsoleTypePlacement
      (EpsilonTypeFormationCandidateAt 6 TypeMismatch start))
    (EpsilonNestedTypePlacement
      (EpsilonTypeFormationCandidateAt 6 TypeMismatch start))))

; `u8` is a storage element rather than an ordinary standalone value type.
; Stored fields and nested array/view elements admit it; authored scalar
; parameters, locals, and returns do not. Arrays containing `u8` remain valid
; in value positions because their element is checked at nested placement.
(def epsilon_u8_placement_candidate ((start Int)
  (placement EpsilonTypePlacement)) EpsilonTypeFormationCandidate
  (match placement
    (EpsilonStoredTypePlacement NoEpsilonTypeFormationCandidate)
    (EpsilonParameterTypePlacement
      (EpsilonTypeFormationCandidateAt 6 TypeMismatch start))
    (EpsilonLocalTypePlacement
      (EpsilonTypeFormationCandidateAt 6 TypeMismatch start))
    (EpsilonReturnTypePlacement
      (EpsilonTypeFormationCandidateAt 6 TypeMismatch start))
    ; This placement is structurally stored. D56's final type-formation
    ; entry-shape subjudgment owns a `Main.console` field whose type is not the
    ; sealed capability.
    (EpsilonMainConsoleTypePlacement NoEpsilonTypeFormationCandidate)
    (EpsilonNestedTypePlacement NoEpsilonTypeFormationCandidate)))

(def epsilon_named_type_formation_candidate ((source Bytes) (start Int)
  (nameValue EpsilonName) (owners EpsilonOwnerRowList)
  (placement EpsilonTypePlacement)) EpsilonTypeFormationCandidate
  (if (epsilon_name_is_console_type source nameValue)
    (match placement
      (EpsilonStoredTypePlacement
        (EpsilonTypeFormationCandidateAt 5 InvalidEntry start))
      (EpsilonParameterTypePlacement
        (EpsilonTypeFormationCandidateAt 5 InvalidEntry start))
      (EpsilonLocalTypePlacement
        (EpsilonTypeFormationCandidateAt 5 InvalidEntry start))
      (EpsilonReturnTypePlacement
        (EpsilonTypeFormationCandidateAt 5 InvalidEntry start))
      (EpsilonMainConsoleTypePlacement NoEpsilonTypeFormationCandidate)
      (EpsilonNestedTypePlacement
        (EpsilonTypeFormationCandidateAt 5 InvalidEntry start)))
    (if (epsilon_owner_name_exists source nameValue owners)
      NoEpsilonTypeFormationCandidate
      (EpsilonTypeFormationCandidateAt 1 UnknownType start))))

(def epsilon_array_length_candidate ((literal EpsilonIntegerLiteral))
  EpsilonTypeFormationCandidate
  (match literal
    ((EpsilonIntegerSpan start end value)
      (if (eq value 0)
        (EpsilonTypeFormationCandidateAt 4 InvalidArrayLength start)
        NoEpsilonTypeFormationCandidate))))

(def epsilon_validate_formed_type ((source Bytes) (typeValue EpsilonType)
  (owners EpsilonOwnerRowList) (placement EpsilonTypePlacement))
  EpsilonTypeFormationCandidate
  (match typeValue
    ((EpsilonI32Type start end) NoEpsilonTypeFormationCandidate)
    ((EpsilonU8Type start end)
      (epsilon_u8_placement_candidate start placement))
    ((EpsilonNeverType start end)
      (epsilon_never_placement_candidate start placement))
    ((EpsilonNamedType start end name)
      (epsilon_named_type_formation_candidate source start name owners
        placement))
    ((EpsilonArrayType start end elementType lengthValue)
      (epsilon_type_formation_candidate_min
        (epsilon_validate_formed_type source elementType owners
          EpsilonNestedTypePlacement)
        (epsilon_array_length_candidate lengthValue)))
    ((EpsilonViewType start end elementType)
      (match placement
        (EpsilonStoredTypePlacement
          (EpsilonTypeFormationCandidateAt 7 EscapingView start))
        (EpsilonParameterTypePlacement
          (epsilon_validate_formed_type source elementType owners
            EpsilonNestedTypePlacement))
        (EpsilonLocalTypePlacement
          (epsilon_validate_formed_type source elementType owners
            EpsilonNestedTypePlacement))
        (EpsilonReturnTypePlacement
          (EpsilonTypeFormationCandidateAt 7 EscapingView start))
        (EpsilonMainConsoleTypePlacement
          (EpsilonTypeFormationCandidateAt 7 EscapingView start))
        (EpsilonNestedTypePlacement
          (EpsilonTypeFormationCandidateAt 7 EscapingView start))))))

(def epsilon_validate_optional_formed_type ((source Bytes)
  (typeValue EpsilonOptionalType) (owners EpsilonOwnerRowList)
  (placement EpsilonTypePlacement)) EpsilonTypeFormationCandidate
  (match typeValue
    (NoEpsilonType NoEpsilonTypeFormationCandidate)
    ((SomeEpsilonType start end item)
      (epsilon_validate_formed_type source item owners placement))))

(def epsilon_validate_parameter_formed_types ((source Bytes)
  (parameters EpsilonParameterList) (owners EpsilonOwnerRowList)
  (placement EpsilonTypePlacement)) EpsilonTypeFormationCandidate
  (match parameters
    (NoEpsilonParameters NoEpsilonTypeFormationCandidate)
    ((MoreEpsilonParameters item rest)
      (match item
        ((EpsilonParameterSyntax start end name typeValue)
          (epsilon_type_formation_candidate_min
            (epsilon_validate_formed_type source typeValue owners placement)
            (epsilon_validate_parameter_formed_types source rest owners
              placement)))))))

(def epsilon_validate_payload_formed_types ((source Bytes)
  (payload EpsilonOptionalPayload) (owners EpsilonOwnerRowList))
  EpsilonTypeFormationCandidate
  (match payload
    (NoEpsilonPayload NoEpsilonTypeFormationCandidate)
    ((SomeEpsilonPayload start end parameters)
      (epsilon_validate_parameter_formed_types source parameters owners
        EpsilonStoredTypePlacement))))

(def epsilon_validate_data_member_formed_types ((source Bytes)
  (owner EpsilonName) (members EpsilonDataMemberList)
  (owners EpsilonOwnerRowList)) EpsilonTypeFormationCandidate
  (match members
    (NoEpsilonDataMembers NoEpsilonTypeFormationCandidate)
    ((MoreEpsilonDataMembers item rest)
      (let current EpsilonTypeFormationCandidate
        (match item
          ((EpsilonFieldMember start end name typeValue)
            (if (epsilon_is_main_console_field source owner name)
              (epsilon_validate_formed_type source typeValue owners
                EpsilonMainConsoleTypePlacement)
              (epsilon_validate_formed_type source typeValue owners
                EpsilonStoredTypePlacement)))
          ((EpsilonCaseMember start end name payload)
            (epsilon_validate_payload_formed_types source payload owners)))
        (epsilon_type_formation_candidate_min current
          (epsilon_validate_data_member_formed_types source owner rest
            owners))))))

(def epsilon_validate_boundary_machine_formed_types ((source Bytes)
  (machines EpsilonBoundaryMachineList) (owners EpsilonOwnerRowList))
  EpsilonTypeFormationCandidate
  (match machines
    (NoEpsilonBoundaryMachines NoEpsilonTypeFormationCandidate)
    ((MoreEpsilonBoundaryMachines item rest)
      (match item
        ((EpsilonBoundaryMachineSyntax start end name parameters returnType)
          (epsilon_type_formation_candidate_min
            (epsilon_validate_parameter_formed_types source parameters owners
              EpsilonParameterTypePlacement)
            (epsilon_type_formation_candidate_min
              (epsilon_validate_optional_formed_type source returnType owners
                EpsilonReturnTypePlacement)
              (epsilon_validate_boundary_machine_formed_types source rest
                owners))))))))

(def epsilon_validate_statement_formed_types ((source Bytes)
  (statements EpsilonStatementList) (owners EpsilonOwnerRowList))
  EpsilonTypeFormationCandidate
  (match statements
    (NoEpsilonStatements NoEpsilonTypeFormationCandidate)
    ((MoreEpsilonStatements item rest)
      (let current EpsilonTypeFormationCandidate
        (match item
          ((EpsilonLetStatement start end name typeValue expressionValue)
            (epsilon_validate_formed_type source typeValue owners
              EpsilonLocalTypePlacement))
          ((EpsilonAssignmentStatement start end placeValue expressionValue)
            NoEpsilonTypeFormationCandidate)
          ((EpsilonPostfixStatement start end expressionValue)
            NoEpsilonTypeFormationCandidate)
          ((EpsilonAssertStatement start end expressionValue)
            NoEpsilonTypeFormationCandidate))
        (epsilon_type_formation_candidate_min current
          (epsilon_validate_statement_formed_types source rest owners))))))

(def epsilon_validate_state_body_formed_types ((source Bytes)
  (bodyValue EpsilonStateBody) (owners EpsilonOwnerRowList))
  EpsilonTypeFormationCandidate
  (match bodyValue
    ((EpsilonStateBodySyntax start end statements terminalValue)
      (epsilon_validate_statement_formed_types source statements owners))))

(def epsilon_validate_state_formed_types ((source Bytes)
  (states EpsilonStateList) (owners EpsilonOwnerRowList))
  EpsilonTypeFormationCandidate
  (match states
    (NoEpsilonStates NoEpsilonTypeFormationCandidate)
    ((MoreEpsilonStates item rest)
      (match item
        ((EpsilonStateSyntax start end name parameters bodyValue)
          (epsilon_type_formation_candidate_min
            (epsilon_validate_parameter_formed_types source parameters owners
              EpsilonParameterTypePlacement)
            (epsilon_type_formation_candidate_min
              (epsilon_validate_state_body_formed_types source bodyValue owners)
              (epsilon_validate_state_formed_types source rest owners))))))))

(def epsilon_validate_machine_body_formed_types ((source Bytes)
  (bodyValue EpsilonMachineBody) (owners EpsilonOwnerRowList))
  EpsilonTypeFormationCandidate
  (match bodyValue
    ((EpsilonMachineBodySyntax start end statements terminalValue states)
      (epsilon_type_formation_candidate_min
        (epsilon_validate_statement_formed_types source statements owners)
        (epsilon_validate_state_formed_types source states owners)))))

(def epsilon_validate_machine_input_formed_types ((source Bytes)
  (inputs EpsilonMachineInputs) (owners EpsilonOwnerRowList))
  EpsilonTypeFormationCandidate
  (match inputs
    ((NoEpsilonMachineInputs start end) NoEpsilonTypeFormationCandidate)
    ((EpsilonPlainMachineInputs start end parameters)
      (epsilon_validate_parameter_formed_types source parameters owners
        EpsilonParameterTypePlacement))
    ((EpsilonReceiverMachineInputs start end receiverStart receiverEnd parameters)
      (epsilon_validate_parameter_formed_types source parameters owners
        EpsilonParameterTypePlacement))))

(def epsilon_validate_declaration_formed_types ((source Bytes)
  (declarations EpsilonDeclarationList) (owners EpsilonOwnerRowList))
  EpsilonTypeFormationCandidate
  (match declarations
    (NoEpsilonDeclarations NoEpsilonTypeFormationCandidate)
    ((MoreEpsilonDeclarations item rest)
      (let current EpsilonTypeFormationCandidate
        (match item
          ((EpsilonBoundaryDeclaration start end name machines)
            (epsilon_validate_boundary_machine_formed_types source machines
              owners))
          ((EpsilonDataDeclaration start end name members)
            (epsilon_validate_data_member_formed_types source name members
              owners))
          ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
            (epsilon_type_formation_candidate_min
              (epsilon_validate_machine_input_formed_types source inputs owners)
              (epsilon_type_formation_candidate_min
                (epsilon_validate_optional_formed_type source returnType owners
                  EpsilonReturnTypePlacement)
                (epsilon_validate_machine_body_formed_types source bodyValue
                  owners)))))
        (epsilon_type_formation_candidate_min current
          (epsilon_validate_declaration_formed_types source rest owners))))))

(def epsilon_data_members_have_field ((members EpsilonDataMemberList)) Int
  (match members
    (NoEpsilonDataMembers 0)
    ((MoreEpsilonDataMembers item rest)
      (match item
        ((EpsilonFieldMember start end name typeValue) 1)
        ((EpsilonCaseMember start end name payload)
          (epsilon_data_members_have_field rest))))))

(def epsilon_data_members_have_case ((members EpsilonDataMemberList)) Int
  (match members
    (NoEpsilonDataMembers 0)
    ((MoreEpsilonDataMembers item rest)
      (match item
        ((EpsilonFieldMember start end name typeValue)
          (epsilon_data_members_have_case rest))
        ((EpsilonCaseMember start end name payload) 1)))))

(def epsilon_data_shape_candidate ((nameValue EpsilonName)
  (members EpsilonDataMemberList)) EpsilonTypeFormationCandidate
  (if (epsilon_data_members_have_field members)
    (if (epsilon_data_members_have_case members)
      (EpsilonTypeFormationCandidateAt 3 InvalidDataShape
        (epsilon_name_start nameValue))
      NoEpsilonTypeFormationCandidate)
    NoEpsilonTypeFormationCandidate))

(def epsilon_validate_data_shapes ((declarations EpsilonDeclarationList))
  EpsilonTypeFormationCandidate
  (match declarations
    (NoEpsilonDeclarations NoEpsilonTypeFormationCandidate)
    ((MoreEpsilonDeclarations item rest)
      (let current EpsilonTypeFormationCandidate
        (match item
          ((EpsilonBoundaryDeclaration start end name machines)
            NoEpsilonTypeFormationCandidate)
          ((EpsilonDataDeclaration start end name members)
            (epsilon_data_shape_candidate name members))
          ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
            NoEpsilonTypeFormationCandidate))
        (epsilon_type_formation_candidate_min current
          (epsilon_validate_data_shapes rest))))))

(def epsilon_data_shape_kind ((members EpsilonDataMemberList)) EpsilonDataShapeKind
  (if (epsilon_data_members_have_case members)
    EpsilonSumShape
    EpsilonRecordShape))

(def epsilon_reverse_data_shape_rows ((input EpsilonDataShapeRowList)
  (output EpsilonDataShapeRowList)) EpsilonDataShapeRowList
  (match input
    (NoEpsilonDataShapeRows output)
    ((MoreEpsilonDataShapeRows item rest)
      (epsilon_reverse_data_shape_rows rest
        (MoreEpsilonDataShapeRows item output)))))

(def epsilon_collect_data_shape_rows_acc ((declarations EpsilonDeclarationList)
  (accumulator EpsilonDataShapeRowList)) EpsilonDataShapeRowList
  (match declarations
    (NoEpsilonDeclarations
      (epsilon_reverse_data_shape_rows accumulator NoEpsilonDataShapeRows))
    ((MoreEpsilonDeclarations item rest)
      (match item
        ((EpsilonBoundaryDeclaration start end name machines)
          (epsilon_collect_data_shape_rows_acc rest accumulator))
        ((EpsilonDataDeclaration start end name members)
          (epsilon_collect_data_shape_rows_acc rest
            (MoreEpsilonDataShapeRows
              (EpsilonDataShapeRowSyntax start name
                (epsilon_data_shape_kind members))
              accumulator)))
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (epsilon_collect_data_shape_rows_acc rest accumulator))))))

; Only value-owning data edges participate in recursion.  A forbidden view in
; stored data suppresses its child defects in the placement pass and likewise
; contributes no by-value graph edge here.  The complete immutable edge list
; is retained for later layout; cycle classification performs one visited-set
; graph walk per edge, avoiding path-exponential expansion through diamonds.
(def epsilon_name_is_data_owner ((source Bytes) (target EpsilonName)
  (declarations EpsilonDeclarationList)) Int
  (match declarations
    (NoEpsilonDeclarations 0)
    ((MoreEpsilonDeclarations item rest)
      (match item
        ((EpsilonBoundaryDeclaration start end name machines)
          (epsilon_name_is_data_owner source target rest))
        ((EpsilonDataDeclaration start end name members)
          (if (epsilon_names_equal source target name)
            1
            (epsilon_name_is_data_owner source target rest)))
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (epsilon_name_is_data_owner source target rest))))))

(def epsilon_collect_type_value_edges ((source Bytes) (ownerStart Int)
  (owner EpsilonName) (typeValue EpsilonType)
  (declarations EpsilonDeclarationList) (accumulator EpsilonValueEdgeList))
  EpsilonValueEdgeList
  (match typeValue
    ((EpsilonI32Type start end) accumulator)
    ((EpsilonU8Type start end) accumulator)
    ((EpsilonNeverType start end) accumulator)
    ((EpsilonNamedType start end name)
      (if (epsilon_name_is_console_type source name)
        accumulator
        (if (epsilon_name_is_data_owner source name declarations)
          (MoreEpsilonValueEdges
            (EpsilonValueEdgeSyntax ownerStart owner name start) accumulator)
          accumulator)))
    ((EpsilonArrayType start end elementType lengthValue)
      (epsilon_collect_type_value_edges source ownerStart owner elementType
        declarations accumulator))
    ((EpsilonViewType start end elementType) accumulator)))

(def epsilon_collect_parameter_value_edges ((source Bytes) (ownerStart Int)
  (owner EpsilonName) (parameters EpsilonParameterList)
  (declarations EpsilonDeclarationList) (accumulator EpsilonValueEdgeList))
  EpsilonValueEdgeList
  (match parameters
    (NoEpsilonParameters accumulator)
    ((MoreEpsilonParameters item rest)
      (match item
        ((EpsilonParameterSyntax start end name typeValue)
          (epsilon_collect_parameter_value_edges source ownerStart owner rest
            declarations
            (epsilon_collect_type_value_edges source ownerStart owner typeValue
              declarations accumulator)))))))

(def epsilon_collect_payload_value_edges ((source Bytes) (ownerStart Int)
  (owner EpsilonName) (payload EpsilonOptionalPayload)
  (declarations EpsilonDeclarationList) (accumulator EpsilonValueEdgeList))
  EpsilonValueEdgeList
  (match payload
    (NoEpsilonPayload accumulator)
    ((SomeEpsilonPayload start end parameters)
      (epsilon_collect_parameter_value_edges source ownerStart owner parameters
        declarations accumulator))))

(def epsilon_collect_member_value_edges ((source Bytes) (ownerStart Int)
  (owner EpsilonName) (members EpsilonDataMemberList)
  (declarations EpsilonDeclarationList) (accumulator EpsilonValueEdgeList))
  EpsilonValueEdgeList
  (match members
    (NoEpsilonDataMembers accumulator)
    ((MoreEpsilonDataMembers item rest)
      (let next EpsilonValueEdgeList
        (match item
          ((EpsilonFieldMember start end name typeValue)
            (epsilon_collect_type_value_edges source ownerStart owner typeValue
              declarations accumulator))
          ((EpsilonCaseMember start end name payload)
            (epsilon_collect_payload_value_edges source ownerStart owner payload
              declarations accumulator)))
        (epsilon_collect_member_value_edges source ownerStart owner rest
          declarations next)))))

(def epsilon_reverse_value_edges ((input EpsilonValueEdgeList)
  (output EpsilonValueEdgeList)) EpsilonValueEdgeList
  (match input
    (NoEpsilonValueEdges output)
    ((MoreEpsilonValueEdges item rest)
      (epsilon_reverse_value_edges rest (MoreEpsilonValueEdges item output)))))

(def epsilon_collect_value_edges_acc ((source Bytes)
  (declarations EpsilonDeclarationList)
  (allDeclarations EpsilonDeclarationList)
  (accumulator EpsilonValueEdgeList)) EpsilonValueEdgeList
  (match declarations
    (NoEpsilonDeclarations
      (epsilon_reverse_value_edges accumulator NoEpsilonValueEdges))
    ((MoreEpsilonDeclarations item rest)
      (match item
        ((EpsilonBoundaryDeclaration start end name machines)
          (epsilon_collect_value_edges_acc source rest allDeclarations
            accumulator))
        ((EpsilonDataDeclaration start end name members)
          (epsilon_collect_value_edges_acc source rest allDeclarations
            (epsilon_collect_member_value_edges source start name members
              allDeclarations accumulator)))
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (epsilon_collect_value_edges_acc source rest allDeclarations
            accumulator))))))

(def epsilon_value_graph_scan_edges ((source Bytes) (current EpsilonName)
  (goal EpsilonName) (search EpsilonValueEdgeList) (allEdges EpsilonValueEdgeList)
  (visited EpsilonNameList)) EpsilonReachabilityScan
  (match search
    (NoEpsilonValueEdges (EpsilonReachabilityScanResult 0 visited))
    ((MoreEpsilonValueEdges item rest)
      (match item
        ((EpsilonValueEdgeSyntax ownerStart edgeSource edgeTarget typeOffset)
          (if (epsilon_names_equal source current edgeSource)
            (match (epsilon_value_graph_reaches source edgeTarget goal allEdges
              visited)
              ((EpsilonReachabilityScanResult reached nextVisited)
                (if reached
                  (EpsilonReachabilityScanResult 1 nextVisited)
                  (epsilon_value_graph_scan_edges source current goal rest
                    allEdges nextVisited))))
            (epsilon_value_graph_scan_edges source current goal rest allEdges
              visited)))))))

(def epsilon_value_graph_reaches ((source Bytes) (current EpsilonName)
  (goal EpsilonName) (edges EpsilonValueEdgeList) (visited EpsilonNameList))
  EpsilonReachabilityScan
  (if (epsilon_names_equal source current goal)
    (EpsilonReachabilityScanResult 1 visited)
    (if (epsilon_census_name_in_list source current visited)
      (EpsilonReachabilityScanResult 0 visited)
      (epsilon_value_graph_scan_edges source current goal edges edges
        (MoreEpsilonNames current visited)))))

(def epsilon_recursive_edge_candidate ((source Bytes) (edge EpsilonValueEdge)
  (edges EpsilonValueEdgeList)) EpsilonTypeFormationCandidate
  (match edge
    ((EpsilonValueEdgeSyntax ownerStart edgeSource edgeTarget typeOffset)
      (match (epsilon_value_graph_reaches source edgeTarget edgeSource edges
        NoEpsilonNames)
        ((EpsilonReachabilityScanResult reached visited)
          (if reached
            (EpsilonTypeFormationCandidateAt 2 RecursiveValueType typeOffset)
            NoEpsilonTypeFormationCandidate))))))

(def epsilon_validate_recursive_edges ((source Bytes)
  (search EpsilonValueEdgeList) (allEdges EpsilonValueEdgeList))
  EpsilonTypeFormationCandidate
  (match search
    (NoEpsilonValueEdges NoEpsilonTypeFormationCandidate)
    ((MoreEpsilonValueEdges item rest)
      (epsilon_type_formation_candidate_min
        (epsilon_recursive_edge_candidate source item allEdges)
        (epsilon_validate_recursive_edges source rest allEdges)))))

(def epsilon_form_collected_types ((source Bytes)
  (collected EpsilonCollectedProgram)) EpsilonTypeFormationOutcome
  (match collected
    ((EpsilonCollectedProgramSyntax program owners machines)
      (match program
        ((EpsilonSyntaxProgram start end declarations)
          (let valueEdges EpsilonValueEdgeList
            (epsilon_collect_value_edges_acc source declarations declarations
              NoEpsilonValueEdges)
            (let candidate EpsilonTypeFormationCandidate
              (epsilon_type_formation_candidate_min
                (epsilon_validate_data_shapes declarations)
                (epsilon_type_formation_candidate_min
                  (epsilon_validate_declaration_formed_types source declarations
                    owners)
                  (epsilon_validate_recursive_edges source valueEdges
                    valueEdges)))
              (match candidate
                (NoEpsilonTypeFormationCandidate
                  (EpsilonTypeFormationAccepted
                    (EpsilonFormedProgramSyntax collected
                      (epsilon_collect_data_shape_rows_acc declarations
                        NoEpsilonDataShapeRows)
                      valueEdges)))
                ((EpsilonTypeFormationCandidateAt kind reasonValue errorOffset)
                  (EpsilonTypeFormationRejected reasonValue errorOffset))
                ((EpsilonTypeFormationConflict errorOffset)
                  (EpsilonTypeFormationInternal errorOffset))))))))))

(def epsilon_parse_collect_and_form_types ((source Bytes))
  EpsilonTypeFormationOutcome
  (match (epsilon_parse_and_collect_program source)
    ((EpsilonCensusRejected reasonValue errorOffset)
      (EpsilonTypeFormationRejected reasonValue errorOffset))
    ((EpsilonCensusAccepted collected)
      (epsilon_form_collected_types source collected))))

; ---- body-resolution catalog foundation ----------------------------------

(def epsilon_integer_literal_value ((literal EpsilonIntegerLiteral)) Int
  (match literal
    ((EpsilonIntegerSpan start end value) value)))

(def epsilon_types_equal ((source Bytes) (left EpsilonType)
  (right EpsilonType)) Int
  (match left
    ((EpsilonI32Type leftStart leftEnd)
      (match right
        ((EpsilonI32Type rightStart rightEnd) 1)
        ((EpsilonU8Type rightStart rightEnd) 0)
        ((EpsilonNeverType rightStart rightEnd) 0)
        ((EpsilonNamedType rightStart rightEnd rightName) 0)
        ((EpsilonArrayType rightStart rightEnd rightElement rightLength) 0)
        ((EpsilonViewType rightStart rightEnd rightElement) 0)))
    ((EpsilonU8Type leftStart leftEnd)
      (match right
        ((EpsilonI32Type rightStart rightEnd) 0)
        ((EpsilonU8Type rightStart rightEnd) 1)
        ((EpsilonNeverType rightStart rightEnd) 0)
        ((EpsilonNamedType rightStart rightEnd rightName) 0)
        ((EpsilonArrayType rightStart rightEnd rightElement rightLength) 0)
        ((EpsilonViewType rightStart rightEnd rightElement) 0)))
    ((EpsilonNeverType leftStart leftEnd)
      (match right
        ((EpsilonI32Type rightStart rightEnd) 0)
        ((EpsilonU8Type rightStart rightEnd) 0)
        ((EpsilonNeverType rightStart rightEnd) 1)
        ((EpsilonNamedType rightStart rightEnd rightName) 0)
        ((EpsilonArrayType rightStart rightEnd rightElement rightLength) 0)
        ((EpsilonViewType rightStart rightEnd rightElement) 0)))
    ((EpsilonNamedType leftStart leftEnd leftName)
      (match right
        ((EpsilonI32Type rightStart rightEnd) 0)
        ((EpsilonU8Type rightStart rightEnd) 0)
        ((EpsilonNeverType rightStart rightEnd) 0)
        ((EpsilonNamedType rightStart rightEnd rightName)
          (epsilon_names_equal source leftName rightName))
        ((EpsilonArrayType rightStart rightEnd rightElement rightLength) 0)
        ((EpsilonViewType rightStart rightEnd rightElement) 0)))
    ((EpsilonArrayType leftStart leftEnd leftElement leftLength)
      (match right
        ((EpsilonI32Type rightStart rightEnd) 0)
        ((EpsilonU8Type rightStart rightEnd) 0)
        ((EpsilonNeverType rightStart rightEnd) 0)
        ((EpsilonNamedType rightStart rightEnd rightName) 0)
        ((EpsilonArrayType rightStart rightEnd rightElement rightLength)
          (if (eq (epsilon_integer_literal_value leftLength)
                  (epsilon_integer_literal_value rightLength))
            (epsilon_types_equal source leftElement rightElement)
            0))
        ((EpsilonViewType rightStart rightEnd rightElement) 0)))
    ((EpsilonViewType leftStart leftEnd leftElement)
      (match right
        ((EpsilonI32Type rightStart rightEnd) 0)
        ((EpsilonU8Type rightStart rightEnd) 0)
        ((EpsilonNeverType rightStart rightEnd) 0)
        ((EpsilonNamedType rightStart rightEnd rightName) 0)
        ((EpsilonArrayType rightStart rightEnd rightElement rightLength) 0)
        ((EpsilonViewType rightStart rightEnd rightElement)
          (epsilon_types_equal source leftElement rightElement))))))

(def epsilon_optional_types_equal ((source Bytes) (left EpsilonOptionalType)
  (right EpsilonOptionalType)) Int
  (match left
    (NoEpsilonType
      (match right
        (NoEpsilonType 1)
        ((SomeEpsilonType rightStart rightEnd rightType) 0)))
    ((SomeEpsilonType leftStart leftEnd leftType)
      (match right
        (NoEpsilonType 0)
        ((SomeEpsilonType rightStart rightEnd rightType)
          (epsilon_types_equal source leftType rightType))))))

(def epsilon_parameter_types_equal ((source Bytes)
  (left EpsilonParameterList) (right EpsilonParameterList)) Int
  (match left
    (NoEpsilonParameters
      (match right
        (NoEpsilonParameters 1)
        ((MoreEpsilonParameters rightItem rightRest) 0)))
    ((MoreEpsilonParameters leftItem leftRest)
      (match right
        (NoEpsilonParameters 0)
        ((MoreEpsilonParameters rightItem rightRest)
          (match leftItem
            ((EpsilonParameterSyntax leftStart leftEnd leftName leftType)
              (match rightItem
                ((EpsilonParameterSyntax rightStart rightEnd rightName rightType)
                  (if (epsilon_types_equal source leftType rightType)
                    (epsilon_parameter_types_equal source leftRest rightRest)
                    0))))))))))

(def epsilon_reject_reason_identity ((reasonValue EpsilonRejectReason)) Int
  (match reasonValue
    (InvalidSourceByte 1)
    (InvalidToken 2)
    (InvalidCharacterLiteral 3)
    (UnterminatedString 4)
    (InvalidEscape 5)
    (IntegerLiteralOutOfRange 6)
    (UnexpectedToken 7)
    (UnexpectedEnd 8)
    (DuplicateName 9)
    (MissingEntry 10)
    (InvalidEntry 11)
    (InvalidBoundary 12)
    (UnknownType 13)
    (RecursiveValueType 14)
    (InvalidDataShape 15)
    (InvalidArrayLength 16)
    (UnknownName 17)
    (TypeMismatch 18)
    (ArityMismatch 19)
    (InvalidPlace 20)
    (UseBeforeInitialization 21)
    (EscapingView 22)
    (InvalidControlTarget 23)
    (InvalidTerminal 24)
    (DuplicatePattern 25)
    (NonexhaustiveSum 26)))

(def epsilon_reject_reasons_equal ((left EpsilonRejectReason)
  (right EpsilonRejectReason)) Int
  (eq (epsilon_reject_reason_identity left)
    (epsilon_reject_reason_identity right)))

(def epsilon_final_reason_list_contains ((target EpsilonRejectReason)
  (reasons EpsilonFinalReasonList)) Int
  (match reasons
    (NoEpsilonFinalReasons 0)
    ((MoreEpsilonFinalReasons item rest)
      (if (epsilon_reject_reasons_equal target item)
        1
        (epsilon_final_reason_list_contains target rest)))))

(def epsilon_final_reason_list_add ((reasonValue EpsilonRejectReason)
  (reasons EpsilonFinalReasonList)) EpsilonFinalReasonList
  (if (epsilon_final_reason_list_contains reasonValue reasons)
    reasons
    (MoreEpsilonFinalReasons reasonValue reasons)))

(def epsilon_final_reason_lists_union ((input EpsilonFinalReasonList)
  (output EpsilonFinalReasonList)) EpsilonFinalReasonList
  (match input
    (NoEpsilonFinalReasons output)
    ((MoreEpsilonFinalReasons reasonValue rest)
      (epsilon_final_reason_lists_union rest
        (epsilon_final_reason_list_add reasonValue output)))))

(def epsilon_final_candidate_add ((reasonValue EpsilonRejectReason)
  (offset Int) (current EpsilonFinalCandidate)) EpsilonFinalCandidate
  (match current
    (NoEpsilonFinalCandidate
      (EpsilonFinalCandidateAt offset
        (MoreEpsilonFinalReasons reasonValue NoEpsilonFinalReasons)))
    ((EpsilonFinalCandidateAt currentOffset reasons)
      (if (lt offset currentOffset)
        (EpsilonFinalCandidateAt offset
          (MoreEpsilonFinalReasons reasonValue NoEpsilonFinalReasons))
        (if (lt currentOffset offset)
          current
          (EpsilonFinalCandidateAt offset
            (epsilon_final_reason_list_add reasonValue reasons)))))))

(def epsilon_final_candidate_merge ((left EpsilonFinalCandidate)
  (right EpsilonFinalCandidate)) EpsilonFinalCandidate
  (match left
    (NoEpsilonFinalCandidate right)
    ((EpsilonFinalCandidateAt leftOffset leftReasons)
      (match right
        (NoEpsilonFinalCandidate left)
        ((EpsilonFinalCandidateAt rightOffset rightReasons)
          (if (lt leftOffset rightOffset)
            left
            (if (lt rightOffset leftOffset)
              right
              (EpsilonFinalCandidateAt leftOffset
                (epsilon_final_reason_lists_union leftReasons
                  rightReasons)))))))))

(def epsilon_find_data_declaration ((source Bytes) (owner EpsilonName)
  (declarations EpsilonDeclarationList)) EpsilonDataDeclarationLookup
  (match declarations
    (NoEpsilonDeclarations NoEpsilonDataDeclaration)
    ((MoreEpsilonDeclarations item rest)
      (match item
        ((EpsilonBoundaryDeclaration start end name machines)
          (epsilon_find_data_declaration source owner rest))
        ((EpsilonDataDeclaration start end name members)
          (if (epsilon_names_equal source owner name)
            (OneEpsilonDataDeclaration item)
            (epsilon_find_data_declaration source owner rest)))
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (epsilon_find_data_declaration source owner rest))))))

(def epsilon_catalog_machine_owner ((source Bytes)
  (nameValue EpsilonQualifiedName) (declarations EpsilonDeclarationList))
  EpsilonCatalogMachineOwner
  (match nameValue
    ((EpsilonUnqualifiedName start end name)
      EpsilonCatalogUnqualifiedMachine)
    ((EpsilonQualifiedNameSyntax start end owner name)
      (match (epsilon_find_data_declaration source owner declarations)
        (NoEpsilonDataDeclaration (EpsilonCatalogUnknownMachineOwner owner))
        ((OneEpsilonDataDeclaration declarationValue)
          (EpsilonCatalogDataMachineOwner declarationValue))))))

(def epsilon_reverse_catalog_declarations
  ((input EpsilonCatalogDeclarationList)
   (output EpsilonCatalogDeclarationList)) EpsilonCatalogDeclarationList
  (match input
    (NoEpsilonCatalogDeclarations output)
    ((MoreEpsilonCatalogDeclarations item rest)
      (epsilon_reverse_catalog_declarations rest
        (MoreEpsilonCatalogDeclarations item output)))))

(def epsilon_catalog_declarations_acc ((source Bytes)
  (declarations EpsilonDeclarationList)
  (allDeclarations EpsilonDeclarationList)
  (accumulator EpsilonCatalogDeclarationList)) EpsilonCatalogDeclarationList
  (match declarations
    (NoEpsilonDeclarations
      (epsilon_reverse_catalog_declarations accumulator
        NoEpsilonCatalogDeclarations))
    ((MoreEpsilonDeclarations item rest)
      (let row EpsilonCatalogDeclaration
        (match item
          ((EpsilonBoundaryDeclaration start end name machines)
            (EpsilonCatalogBoundaryDeclaration item))
          ((EpsilonDataDeclaration start end name members)
            (EpsilonCatalogDataDeclaration item
              (epsilon_data_shape_kind members)))
          ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
            (EpsilonCatalogMachineDeclaration item
              (epsilon_catalog_machine_owner source name allDeclarations))))
        (epsilon_catalog_declarations_acc source rest allDeclarations
          (MoreEpsilonCatalogDeclarations row accumulator))))))

(def epsilon_catalog_unknown_machine_owner_candidate
  ((rows EpsilonCatalogDeclarationList)) EpsilonFinalCandidate
  (match rows
    (NoEpsilonCatalogDeclarations NoEpsilonFinalCandidate)
    ((MoreEpsilonCatalogDeclarations row rest)
      (let current EpsilonFinalCandidate
        (match row
          ((EpsilonCatalogBoundaryDeclaration declarationValue)
            NoEpsilonFinalCandidate)
          ((EpsilonCatalogDataDeclaration declarationValue shape)
            NoEpsilonFinalCandidate)
          ((EpsilonCatalogMachineDeclaration declarationValue owner)
            (match owner
              (EpsilonCatalogUnqualifiedMachine NoEpsilonFinalCandidate)
              ((EpsilonCatalogDataMachineOwner ownerDeclaration)
                NoEpsilonFinalCandidate)
              ((EpsilonCatalogUnknownMachineOwner unknownOwner)
                (epsilon_final_candidate_add UnknownName
                  (epsilon_name_start unknownOwner) NoEpsilonFinalCandidate)))))
        (epsilon_final_candidate_merge current
          (epsilon_catalog_unknown_machine_owner_candidate rest))))))

(def epsilon_catalog_find_owner ((source Bytes) (target EpsilonName)
  (rows EpsilonCatalogDeclarationList)) EpsilonCatalogOwnerLookup
  (match rows
    (NoEpsilonCatalogDeclarations NoEpsilonCatalogOwner)
    ((MoreEpsilonCatalogDeclarations row rest)
      (match row
        ((EpsilonCatalogBoundaryDeclaration declarationValue)
          (match declarationValue
            ((EpsilonBoundaryDeclaration start end name machines)
              (if (epsilon_names_equal source target name)
                (OneEpsilonCatalogBoundaryOwner declarationValue)
                (epsilon_catalog_find_owner source target rest)))
            ((EpsilonDataDeclaration start end name members)
              (epsilon_catalog_find_owner source target rest))
            ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
              (epsilon_catalog_find_owner source target rest))))
        ((EpsilonCatalogDataDeclaration declarationValue shape)
          (match declarationValue
            ((EpsilonBoundaryDeclaration start end name machines)
              (epsilon_catalog_find_owner source target rest))
            ((EpsilonDataDeclaration start end name members)
              (if (epsilon_names_equal source target name)
                (OneEpsilonCatalogDataOwner declarationValue shape)
                (epsilon_catalog_find_owner source target rest)))
            ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
              (epsilon_catalog_find_owner source target rest))))
        ((EpsilonCatalogMachineDeclaration declarationValue owner)
          (epsilon_catalog_find_owner source target rest))))))

(def epsilon_catalog_find_unqualified_machine ((source Bytes)
  (target EpsilonName) (rows EpsilonCatalogDeclarationList))
  EpsilonCatalogMachineLookup
  (match rows
    (NoEpsilonCatalogDeclarations NoEpsilonCatalogMachine)
    ((MoreEpsilonCatalogDeclarations row rest)
      (match row
        ((EpsilonCatalogBoundaryDeclaration declarationValue)
          (epsilon_catalog_find_unqualified_machine source target rest))
        ((EpsilonCatalogDataDeclaration declarationValue shape)
          (epsilon_catalog_find_unqualified_machine source target rest))
        ((EpsilonCatalogMachineDeclaration declarationValue owner)
          (match declarationValue
            ((EpsilonBoundaryDeclaration start end name machines)
              (epsilon_catalog_find_unqualified_machine source target rest))
            ((EpsilonDataDeclaration start end name members)
              (epsilon_catalog_find_unqualified_machine source target rest))
            ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
              (match name
                ((EpsilonUnqualifiedName nameStart nameEnd machineName)
                  (if (epsilon_names_equal source target machineName)
                    (OneEpsilonCatalogMachine declarationValue)
                    (epsilon_catalog_find_unqualified_machine source target
                      rest)))
                ((EpsilonQualifiedNameSyntax nameStart nameEnd machineOwner
                  machineName)
                  (epsilon_catalog_find_unqualified_machine source target
                    rest))))))))))

; Semantic qualified application lookup excludes unresolved owner spellings.
; D36 application identity requires the exact resolved data owner as custody,
; so there is one qualified-machine walk rather than a raw spelling-only twin.
(def epsilon_catalog_find_qualified_data_machine ((source Bytes)
  (targetOwner EpsilonName) (targetName EpsilonName)
  (rows EpsilonCatalogDeclarationList)) EpsilonCatalogDataMachineLookup
  (match rows
    (NoEpsilonCatalogDeclarations NoEpsilonCatalogDataMachine)
    ((MoreEpsilonCatalogDeclarations row rest)
      (match row
        ((EpsilonCatalogBoundaryDeclaration declarationValue)
          (epsilon_catalog_find_qualified_data_machine source targetOwner
            targetName rest))
        ((EpsilonCatalogDataDeclaration declarationValue shape)
          (epsilon_catalog_find_qualified_data_machine source targetOwner
            targetName rest))
        ((EpsilonCatalogMachineDeclaration declarationValue owner)
          (match owner
            (EpsilonCatalogUnqualifiedMachine
              (epsilon_catalog_find_qualified_data_machine source targetOwner
                targetName rest))
            ((EpsilonCatalogUnknownMachineOwner unknownOwner)
              (epsilon_catalog_find_qualified_data_machine source targetOwner
                targetName rest))
            ((EpsilonCatalogDataMachineOwner ownerDeclaration)
              (match declarationValue
                ((EpsilonBoundaryDeclaration start end name machines)
                  (epsilon_catalog_find_qualified_data_machine source targetOwner
                    targetName rest))
                ((EpsilonDataDeclaration start end name members)
                  (epsilon_catalog_find_qualified_data_machine source targetOwner
                    targetName rest))
                ((EpsilonMachineDeclaration start end name inputs returnType
                  bodyValue)
                  (match name
                    ((EpsilonUnqualifiedName nameStart nameEnd machineName)
                      (epsilon_catalog_find_qualified_data_machine source
                        targetOwner targetName rest))
                    ((EpsilonQualifiedNameSyntax nameStart nameEnd machineOwner
                      machineName)
                      (if (epsilon_names_equal source targetOwner machineOwner)
                        (if (epsilon_names_equal source targetName machineName)
                          (OneEpsilonCatalogDataMachine ownerDeclaration
                            declarationValue)
                          (epsilon_catalog_find_qualified_data_machine source
                            targetOwner targetName rest))
                        (epsilon_catalog_find_qualified_data_machine source
                          targetOwner targetName rest)))))))))))))

(def epsilon_catalog_find_boundary_machine ((source Bytes)
  (target EpsilonName) (machines EpsilonBoundaryMachineList))
  EpsilonCatalogBoundaryMemberLookup
  (match machines
    (NoEpsilonBoundaryMachines NoEpsilonCatalogBoundaryMember)
    ((MoreEpsilonBoundaryMachines item rest)
      (match item
        ((EpsilonBoundaryMachineSyntax start end name parameters returnType)
          (if (epsilon_names_equal source target name)
            (OneEpsilonCatalogBoundaryMember item)
            (epsilon_catalog_find_boundary_machine source target rest)))))))

(def epsilon_catalog_find_boundary_member ((source Bytes)
  (owner EpsilonName) (member EpsilonName)
  (rows EpsilonCatalogDeclarationList)) EpsilonCatalogBoundaryMemberLookup
  (match (epsilon_catalog_find_owner source owner rows)
    (NoEpsilonCatalogOwner NoEpsilonCatalogBoundaryMember)
    ((OneEpsilonCatalogDataOwner declarationValue shape)
      NoEpsilonCatalogBoundaryMember)
    ((OneEpsilonCatalogBoundaryOwner declarationValue)
      (match declarationValue
        ((EpsilonBoundaryDeclaration start end name machines)
          (epsilon_catalog_find_boundary_machine source member machines))
        ((EpsilonDataDeclaration start end name members)
          NoEpsilonCatalogBoundaryMember)
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          NoEpsilonCatalogBoundaryMember)))))

(def epsilon_catalog_find_member_in_data ((source Bytes)
  (target EpsilonName) (ownerValue EpsilonDeclaration)
  (members EpsilonDataMemberList))
  EpsilonCatalogDataMemberLookup
  (match members
    (NoEpsilonDataMembers NoEpsilonCatalogDataMember)
    ((MoreEpsilonDataMembers item rest)
      (match item
        ((EpsilonFieldMember start end name typeValue)
          (if (epsilon_names_equal source target name)
            (OneEpsilonCatalogField ownerValue item)
            (epsilon_catalog_find_member_in_data source target ownerValue
              rest)))
        ((EpsilonCaseMember start end name payload)
          (if (epsilon_names_equal source target name)
            (OneEpsilonCatalogCase ownerValue item)
            (epsilon_catalog_find_member_in_data source target ownerValue
              rest)))))))

(def epsilon_catalog_find_data_member ((source Bytes) (owner EpsilonName)
  (member EpsilonName) (rows EpsilonCatalogDeclarationList))
  EpsilonCatalogDataMemberLookup
  (match (epsilon_catalog_find_owner source owner rows)
    (NoEpsilonCatalogOwner NoEpsilonCatalogDataMember)
    ((OneEpsilonCatalogBoundaryOwner declarationValue)
      NoEpsilonCatalogDataMember)
    ((OneEpsilonCatalogDataOwner declarationValue shape)
      (match declarationValue
        ((EpsilonBoundaryDeclaration start end name machines)
          NoEpsilonCatalogDataMember)
        ((EpsilonDataDeclaration start end name members)
          (epsilon_catalog_find_member_in_data source member declarationValue
            members))
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          NoEpsilonCatalogDataMember)))))

(def epsilon_catalog_find_state_in_list ((source Bytes) (target EpsilonName)
  (states EpsilonStateList)) EpsilonCatalogStateLookup
  (match states
    (NoEpsilonStates NoEpsilonCatalogState)
    ((MoreEpsilonStates item rest)
      (match item
        ((EpsilonStateSyntax start end name parameters bodyValue)
          (if (epsilon_names_equal source target name)
            (OneEpsilonCatalogState item)
            (epsilon_catalog_find_state_in_list source target rest)))))))

(def epsilon_catalog_find_state ((source Bytes)
  (machineValue EpsilonDeclaration) (target EpsilonName)) EpsilonCatalogStateLookup
  (match machineValue
    ((EpsilonBoundaryDeclaration start end name machines)
      NoEpsilonCatalogState)
    ((EpsilonDataDeclaration start end name members)
      NoEpsilonCatalogState)
    ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
      (match bodyValue
        ((EpsilonMachineBodySyntax bodyStart bodyEnd statements terminalValue
          states)
          (epsilon_catalog_find_state_in_list source target states))))))

(def epsilon_machine_input_parameters ((inputs EpsilonMachineInputs))
  EpsilonParameterList
  (match inputs
    ((NoEpsilonMachineInputs start end) NoEpsilonParameters)
    ((EpsilonPlainMachineInputs start end parameters) parameters)
    ((EpsilonReceiverMachineInputs start end receiverStart receiverEnd parameters)
      parameters)))

(def epsilon_machine_inputs_have_receiver ((inputs EpsilonMachineInputs)) Int
  (match inputs
    ((NoEpsilonMachineInputs start end) 0)
    ((EpsilonPlainMachineInputs start end parameters) 0)
    ((EpsilonReceiverMachineInputs start end receiverStart receiverEnd parameters)
      1)))

(def epsilon_constructor_parameters ((memberValue EpsilonDataMember))
  EpsilonParameterList
  (match memberValue
    ((EpsilonFieldMember start end name typeValue) NoEpsilonParameters)
    ((EpsilonCaseMember start end name payload)
      (match payload
        (NoEpsilonPayload NoEpsilonParameters)
        ((SomeEpsilonPayload payloadStart payloadEnd parameters) parameters)))))

(def epsilon_catalog_formed_program ((source Bytes)
  (formed EpsilonFormedProgram))
  EpsilonCatalogedProgram
  (match formed
    ((EpsilonFormedProgramSyntax collected shapes valueEdges)
      (match collected
        ((EpsilonCollectedProgramSyntax program owners machines)
          (match program
            ((EpsilonSyntaxProgram start end declarations)
              (let rows EpsilonCatalogDeclarationList
                (epsilon_catalog_declarations_acc source declarations
                  declarations NoEpsilonCatalogDeclarations)
                (EpsilonCatalogedProgramSyntax formed
                  (EpsilonCatalogStateSyntax
                    (EpsilonResolutionCatalogSyntax rows)
                    (epsilon_catalog_unknown_machine_owner_candidate
                      rows)))))))))))

(def epsilon_parse_collect_form_and_catalog ((source Bytes))
  EpsilonCatalogOutcome
  (match (epsilon_parse_collect_and_form_types source)
    ((EpsilonTypeFormationRejected reasonValue errorOffset)
      (EpsilonCatalogRejected reasonValue errorOffset))
    ((EpsilonTypeFormationInternal errorOffset)
      (EpsilonCatalogInternal errorOffset))
    ((EpsilonTypeFormationAccepted formed)
      (EpsilonCatalogAccepted (epsilon_catalog_formed_program source formed)))))

; ---- ordered local and expression-fact resolution ------------------------

(def epsilon_local_binding_name ((bindingValue EpsilonLocalBinding))
  EpsilonLocalBindingNameLookup
  (match bindingValue
    ((EpsilonSelfLocal ownerDeclaration) NoEpsilonLocalBindingName)
    ((EpsilonMachineParameterLocal parameterValue)
      (match parameterValue
        ((EpsilonParameterSyntax start end name typeValue)
          (OneEpsilonLocalBindingName name))))
    ((EpsilonStateParameterLocal parameterValue)
      (match parameterValue
        ((EpsilonParameterSyntax start end name typeValue)
          (OneEpsilonLocalBindingName name))))
    ((EpsilonLetLocal name typeValue statementValue)
      (OneEpsilonLocalBindingName name))
    ((EpsilonTransitionBinderLocal patternValue name)
      (OneEpsilonLocalBindingName name))))

(def epsilon_local_find_binding ((source Bytes) (target EpsilonName)
  (bindings EpsilonLocalBindingList)) EpsilonLocalBindingLookup
  (match bindings
    (NoEpsilonLocalBindings NoEpsilonLocalBinding)
    ((MoreEpsilonLocalBindings item rest)
      (match (epsilon_local_binding_name item)
        (NoEpsilonLocalBindingName
          (epsilon_local_find_binding source target rest))
        ((OneEpsilonLocalBindingName name)
          (if (epsilon_names_equal source target name)
            (OneEpsilonLocalBinding item)
            (epsilon_local_find_binding source target rest)))))))

(def epsilon_local_find_self_binding ((bindings EpsilonLocalBindingList))
  EpsilonSelfBindingLookup
  (match bindings
    (NoEpsilonLocalBindings NoEpsilonSelfBinding)
    ((MoreEpsilonLocalBindings item rest)
      (match item
        ((EpsilonSelfLocal ownerDeclaration)
          (OneEpsilonSelfBinding item ownerDeclaration))
        ((EpsilonMachineParameterLocal parameterValue)
          (epsilon_local_find_self_binding rest))
        ((EpsilonStateParameterLocal parameterValue)
          (epsilon_local_find_self_binding rest))
        ((EpsilonLetLocal name typeValue statementValue)
          (epsilon_local_find_self_binding rest))
        ((EpsilonTransitionBinderLocal patternValue name)
          (epsilon_local_find_self_binding rest))))))

(def epsilon_add_machine_parameter_bindings
  ((parameters EpsilonParameterList) (bindings EpsilonLocalBindingList))
  EpsilonLocalBindingList
  (match parameters
    (NoEpsilonParameters bindings)
    ((MoreEpsilonParameters item rest)
      (epsilon_add_machine_parameter_bindings rest
        (MoreEpsilonLocalBindings
          (EpsilonMachineParameterLocal item) bindings)))))

; Superseded by D51: the reserved self token becomes one ordinary named
; receiver binding carrying its owner-derived type/place. Receiverless
; qualified machines and this nameless carrier are deletion work.
(def epsilon_add_catalog_machine_self_binding
  ((machineDeclaration EpsilonDeclaration) (owner EpsilonCatalogMachineOwner)
  (bindings EpsilonLocalBindingList)) EpsilonLocalBindingList
  (match machineDeclaration
    ((EpsilonBoundaryDeclaration start end name machines) bindings)
    ((EpsilonDataDeclaration start end name members) bindings)
    ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
      (if (epsilon_machine_inputs_have_receiver inputs)
        (match owner
          (EpsilonCatalogUnqualifiedMachine bindings)
          ((EpsilonCatalogUnknownMachineOwner unknownOwner) bindings)
          ((EpsilonCatalogDataMachineOwner ownerDeclaration)
            (MoreEpsilonLocalBindings
              (EpsilonSelfLocal ownerDeclaration) bindings)))
        bindings))))

(def epsilon_add_state_parameter_bindings
  ((parameters EpsilonParameterList) (bindings EpsilonLocalBindingList))
  EpsilonLocalBindingList
  (match parameters
    (NoEpsilonParameters bindings)
    ((MoreEpsilonParameters item rest)
      (epsilon_add_state_parameter_bindings rest
        (MoreEpsilonLocalBindings
          (EpsilonStateParameterLocal item) bindings)))))

(def epsilon_add_transition_binder_names ((patternValue EpsilonPattern)
  (names EpsilonNameList) (bindings EpsilonLocalBindingList))
  EpsilonLocalBindingList
  (match names
    (NoEpsilonNames bindings)
    ((MoreEpsilonNames item rest)
      (epsilon_add_transition_binder_names patternValue rest
        (MoreEpsilonLocalBindings
          (EpsilonTransitionBinderLocal patternValue item) bindings)))))

(def epsilon_add_transition_pattern_bindings ((patternValue EpsilonPattern)
  (bindings EpsilonLocalBindingList)) EpsilonLocalBindingList
  (match patternValue
    ((EpsilonIntegerPattern start end literal) bindings)
    ((EpsilonTruePattern start end) bindings)
    ((EpsilonFalsePattern start end) bindings)
    ((EpsilonWildcardPattern start end) bindings)
    ((EpsilonCasePattern start end owner name binder)
      (match binder
        (NoEpsilonBinder bindings)
        ((SomeEpsilonBinder binderStart binderEnd names)
          (epsilon_add_transition_binder_names patternValue names bindings))))))

(def epsilon_collect_pending_lets ((statements EpsilonStatementList)
  (pending EpsilonLocalBindingList)) EpsilonLocalBindingList
  (match statements
    (NoEpsilonStatements pending)
    ((MoreEpsilonStatements item rest)
      (match item
        ((EpsilonLetStatement start end name typeValue initializer)
          (epsilon_collect_pending_lets rest
            (MoreEpsilonLocalBindings
              (EpsilonLetLocal name typeValue item) pending)))
        ((EpsilonAssignmentStatement start end placeValue assignedValue)
          (epsilon_collect_pending_lets rest pending))
        ((EpsilonPostfixStatement start end expressionValue)
          (epsilon_collect_pending_lets rest pending))
        ((EpsilonAssertStatement start end expressionValue)
          (epsilon_collect_pending_lets rest pending))))))

(def epsilon_remove_pending_binding ((source Bytes) (target EpsilonName)
  (pending EpsilonLocalBindingList)) EpsilonLocalBindingList
  (match pending
    (NoEpsilonLocalBindings NoEpsilonLocalBindings)
    ((MoreEpsilonLocalBindings item rest)
      (match (epsilon_local_binding_name item)
        (NoEpsilonLocalBindingName
          (MoreEpsilonLocalBindings item
            (epsilon_remove_pending_binding source target rest)))
        ((OneEpsilonLocalBindingName name)
          (if (epsilon_names_equal source target name)
            rest
            (MoreEpsilonLocalBindings item
              (epsilon_remove_pending_binding source target rest))))))))

(def epsilon_reverse_resolved_local_references
  ((input EpsilonResolvedLocalReferenceList)
   (output EpsilonResolvedLocalReferenceList)) EpsilonResolvedLocalReferenceList
  (match input
    (NoEpsilonResolvedLocalReferences output)
    ((MoreEpsilonResolvedLocalReferences item rest)
      (epsilon_reverse_resolved_local_references rest
        (MoreEpsilonResolvedLocalReferences item output)))))

(def epsilon_expression_kind ((expressionValue EpsilonExpression)) Int
  (match expressionValue
    ((EpsilonIntegerExpression start end literal) 0)
    ((EpsilonCharacterExpression start end literal) 1)
    ((EpsilonStringExpression start end literal) 2)
    ((EpsilonTrueExpression start end) 3)
    ((EpsilonFalseExpression start end) 4)
    ((EpsilonSelfExpression start end) 5)
    ((EpsilonNameExpression start end name) 6)
    ((EpsilonQualifiedExpression start end owner name arguments) 7)
    ((EpsilonGroupedExpression start end inner) 8)
    ((EpsilonFieldExpression start end base field) 9)
    ((EpsilonCallExpression start end base arguments) 10)
    ((EpsilonIndexExpression start end base indexValue) 11)
    ((EpsilonSliceExpression start end base low high) 12)
    ((EpsilonNegateExpression start end operand) 13)
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
      left right) 14)))

; Postfix nodes inherit their base's start coordinate, so a source offset alone
; is not an expression identity. Constructor plus exact span is sufficient for
; the parser's tree-shaped AST and prevents a base fact from answering for its
; enclosing field, call, index, or slice.
(def epsilon_expressions_same_identity ((left EpsilonExpression)
  (right EpsilonExpression)) Int
  (if (eq (epsilon_expression_kind left) (epsilon_expression_kind right))
    (if (eq (epsilon_expression_start left) (epsilon_expression_start right))
      (eq (epsilon_expression_end left) (epsilon_expression_end right))
      0)
    0))

(def epsilon_find_resolved_local_reference ((target EpsilonExpression)
  (references EpsilonResolvedLocalReferenceList))
  EpsilonResolvedLocalReferenceLookup
  (match references
    (NoEpsilonResolvedLocalReferences NoEpsilonResolvedLocalReference)
    ((MoreEpsilonResolvedLocalReferences item rest)
      (match item
        ((EpsilonResolvedLocalReferenceSyntax expressionValue bindingValue)
          (if (epsilon_expressions_same_identity target expressionValue)
            (OneEpsilonResolvedLocalReference bindingValue)
            (epsilon_find_resolved_local_reference target rest)))))))

(def epsilon_reverse_resolved_field_references
  ((input EpsilonResolvedFieldReferenceList)
   (output EpsilonResolvedFieldReferenceList)) EpsilonResolvedFieldReferenceList
  (match input
    (NoEpsilonResolvedFieldReferences output)
    ((MoreEpsilonResolvedFieldReferences item rest)
      (epsilon_reverse_resolved_field_references rest
        (MoreEpsilonResolvedFieldReferences item output)))))

(def epsilon_find_resolved_field_reference ((target EpsilonExpression)
  (references EpsilonResolvedFieldReferenceList))
  EpsilonResolvedFieldReferenceLookup
  (match references
    (NoEpsilonResolvedFieldReferences NoEpsilonResolvedFieldReference)
    ((MoreEpsilonResolvedFieldReferences item rest)
      (match item
        ((EpsilonResolvedFieldReferenceSyntax expressionValue owner member)
          (if (epsilon_expressions_same_identity target expressionValue)
            (OneEpsilonResolvedFieldReference owner member)
            (epsilon_find_resolved_field_reference target rest)))))))

(def epsilon_reverse_resolved_callable_references
  ((input EpsilonResolvedCallableReferenceList)
   (output EpsilonResolvedCallableReferenceList))
