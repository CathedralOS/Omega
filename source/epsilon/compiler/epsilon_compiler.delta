; ---- transition patterns and arms --------------------------------------
; The current parser still accepts `_` through the common pattern arm. D57
; requires a nonempty transition body with at most one grammar-owned final
; wildcard; any following pattern must reject as `UnexpectedToken`.

(def epsilon_pattern_start ((patternValue EpsilonPattern)) Int
  (match patternValue
    ((EpsilonIntegerPattern start end literal) start)
    ((EpsilonTruePattern start end) start)
    ((EpsilonFalsePattern start end) start)
    ((EpsilonWildcardPattern start end) start)
    ((EpsilonCasePattern start end owner name binder) start)))

(def epsilon_pattern_end ((patternValue EpsilonPattern)) Int
  (match patternValue
    ((EpsilonIntegerPattern start end literal) end)
    ((EpsilonTruePattern start end) end)
    ((EpsilonFalsePattern start end) end)
    ((EpsilonWildcardPattern start end) end)
    ((EpsilonCasePattern start end owner name binder) end)))

(def epsilon_continuation_start ((continuationValue EpsilonContinuation)) Int
  (match continuationValue
    ((EpsilonExpressionContinuation start end expressionValue) start)
    ((EpsilonReturnContinuation start end expressionValue) start)))

(def epsilon_continuation_end ((continuationValue EpsilonContinuation)) Int
  (match continuationValue
    ((EpsilonExpressionContinuation start end expressionValue) end)
    ((EpsilonReturnContinuation start end expressionValue) end)))

(def epsilon_arm_start ((armValue EpsilonArm)) Int
  (match armValue ((EpsilonArmSyntax start end patternValue continuationValue) start)))

(def epsilon_arm_end ((armValue EpsilonArm)) Int
  (match armValue ((EpsilonArmSyntax start end patternValue continuationValue) end)))

(def epsilon_reverse_names ((input EpsilonNameList) (output EpsilonNameList)) EpsilonNameList
  (match input
    (NoEpsilonNames output)
    ((MoreEpsilonNames item rest)
