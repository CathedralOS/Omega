            (if (eq matchedCount targetCount)
              EpsilonAlphaReplayValid
              (EpsilonAlphaReplayInternal 51))
            (if (lt payloadOffset 0)
              (EpsilonAlphaReplayInternal 47)
              (if (lt payloadLength payloadOffset)
                (EpsilonAlphaReplayInternal 48)
                (let opcode Int (bytes_get payload payloadOffset)
                  (let width Int (epsilon_alpha_replay_opcode_width opcode)
                    (if (eq width 0)
                      (EpsilonAlphaReplayInternal 49)
                      (if (lt (- payloadLength payloadOffset) width)
                        (EpsilonAlphaReplayInternal 50)
                        (match (epsilon_alpha_trie_lookup targets payloadOffset)
                          (NoEpsilonAlphaTrieValue
                            (epsilon_alpha_replay_match_starts payload
                              payloadLength (+ payloadOffset width) targets
                              targetCount matchedCount))
                          ((SomeEpsilonAlphaTrieValue present)
                            (epsilon_alpha_replay_match_starts payload
                              payloadLength (+ payloadOffset width) targets
                              targetCount (+ matchedCount 1))))))))))))))))

(def epsilon_alpha_replay ((payload Bytes)) EpsilonAlphaReplayOutcome
  (let payloadLength Int (bytes_length payload)
    (if (lt payloadLength 1)
      (EpsilonAlphaReplayInternal 52)
      (if (lt 16777212 payloadLength)
        (EpsilonAlphaReplayInternal 54)
        (match (epsilon_alpha_replay_collect_targets payload payloadLength 0
          EmptyEpsilonAlphaTrie 0)
          ((EpsilonAlphaReplayTargetSet targets targetCount)
            (epsilon_alpha_replay_match_starts payload payloadLength 0
              targets targetCount 0))
          ((EpsilonAlphaReplayTargetSetInternal detail)
            (EpsilonAlphaReplayInternal detail)))))))

(def epsilon_alpha_finish_encoding ((payloadLength Int)
  (payload Bytes)) EpsilonAlphaEncodeOutcome
  (if (if (lt payloadLength 1) 1 (lt 16777212 payloadLength))
    (EpsilonAlphaEncodingInternal 76)
    (if (eq (bytes_length payload) payloadLength)
      (match (epsilon_alpha_replay payload)
        (EpsilonAlphaReplayValid (EpsilonAlphaEncoded payload))
        ((EpsilonAlphaReplayInternal detail)
          (EpsilonAlphaEncodingInternal detail)))
      (EpsilonAlphaEncodingInternal 56))))

(def epsilon_alpha_encode_program ((program EpsilonAlphaProgram)) EpsilonAlphaEncodeOutcome
  (match (epsilon_alpha_layout program)
    ((EpsilonAlphaLayoutOversized requested)
      (EpsilonAlphaOversizedCandidate
        (epsilon_alpha_make_oversized_candidate requested) requested))
    ((EpsilonAlphaLayoutInternal detail)
      (EpsilonAlphaEncodingInternal detail))
    ((EpsilonAlphaLayoutReady payloadLength instructionCount labels)
      (match program
        ((EpsilonAlphaProgramItems labelCount items)
          (match (epsilon_alpha_encode_balanced items instructionCount labels
            payloadLength)
            ((EpsilonAlphaBalancedInternal detail)
              (EpsilonAlphaEncodingInternal detail))
            ((EpsilonAlphaBalancedBytes payload remaining)
              (if (epsilon_alpha_only_labels remaining)
                (epsilon_alpha_finish_encoding payloadLength payload)
                (EpsilonAlphaEncodingInternal 57)))))))))
