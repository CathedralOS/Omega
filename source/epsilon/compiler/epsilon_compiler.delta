(def epsilon_data_members_same_identity ((left EpsilonDataMember)
  (right EpsilonDataMember)) Int
  (match left
    ((EpsilonFieldMember leftStart leftEnd leftName leftType)
      (match right
        ((EpsilonFieldMember rightStart rightEnd rightName rightType)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))
        ((EpsilonCaseMember rightStart rightEnd rightName rightPayload) 0)))
    ((EpsilonCaseMember leftStart leftEnd leftName leftPayload)
      (match right
        ((EpsilonFieldMember rightStart rightEnd rightName rightType) 0)
        ((EpsilonCaseMember rightStart rightEnd rightName rightPayload)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))))))

(def epsilon_control_find_state_application ((target EpsilonExpression)
  (control EpsilonControlReferenceLedger)) EpsilonStateApplicationReferenceLookup
  (match control
    ((EpsilonControlReferenceLedgerSyntax stateApplications subjects cases
      coverages)
      (epsilon_find_state_application_reference target stateApplications))))

(def epsilon_control_find_transition_subject ((target EpsilonTerminal)
  (control EpsilonControlReferenceLedger))
  EpsilonTransitionSubjectReferenceLookup
  (match control
    ((EpsilonControlReferenceLedgerSyntax stateApplications subjects patterns
      coverages)
      (epsilon_find_transition_subject_reference target subjects))))

(def epsilon_control_find_transition_pattern ((target EpsilonPattern)
  (control EpsilonControlReferenceLedger))
  EpsilonTransitionPatternReferenceLookup
  (match control
    ((EpsilonControlReferenceLedgerSyntax stateApplications subjects patterns
      coverages)
      (epsilon_find_transition_pattern_reference target patterns))))

(def epsilon_reverse_control_references ((control EpsilonControlReferenceLedger))
  EpsilonControlReferenceLedger
  (match control
    ((EpsilonControlReferenceLedgerSyntax stateApplications subjects cases
      coverages)
      (EpsilonControlReferenceLedgerSyntax
        (epsilon_reverse_state_application_references stateApplications
          NoEpsilonStateApplicationReferences)
        (epsilon_reverse_transition_subject_references subjects
          NoEpsilonTransitionSubjectReferences)
        (epsilon_reverse_transition_pattern_references cases
          NoEpsilonTransitionPatternReferences)
        (epsilon_reverse_transition_coverage_references coverages
          NoEpsilonTransitionCoverageReferences)))))

(def epsilon_reverse_typed_expressions ((input EpsilonTypedExpressionList)
  (output EpsilonTypedExpressionList)) EpsilonTypedExpressionList
  (match input
    (NoEpsilonTypedExpressions output)
    ((MoreEpsilonTypedExpressions item rest)
      (epsilon_reverse_typed_expressions rest
        (MoreEpsilonTypedExpressions item output)))))

(def epsilon_find_expression_result ((target EpsilonExpression)
  (expressions EpsilonTypedExpressionList)) EpsilonExpressionResultLookup
  (match expressions
    (NoEpsilonTypedExpressions NoEpsilonExpressionResult)
    ((MoreEpsilonTypedExpressions item rest)
      (match item
        ((EpsilonTypedExpressionSyntax expressionValue resultValue)
          (if (epsilon_expressions_same_identity target expressionValue)
            (OneEpsilonExpressionResult resultValue)
            (epsilon_find_expression_result target rest)))))))

(def epsilon_binder_parameter_type ((source Bytes) (target EpsilonName)
  (names EpsilonNameList) (parameters EpsilonParameterList))
  EpsilonLocalBindingTypeLookup
  (match names
    (NoEpsilonNames NoEpsilonLocalBindingType)
    ((MoreEpsilonNames name restNames)
      (match parameters
        (NoEpsilonParameters NoEpsilonLocalBindingType)
        ((MoreEpsilonParameters parameterValue restParameters)
          (if (epsilon_names_equal source target name)
            (match parameterValue
              ((EpsilonParameterSyntax start end parameterName typeValue)
                (OneEpsilonLocalBindingType typeValue)))
            (epsilon_binder_parameter_type source target restNames
              restParameters)))))))

(def epsilon_transition_binder_type ((source Bytes) (patternValue EpsilonPattern)
  (target EpsilonName) (control EpsilonControlReferenceLedger))
  EpsilonLocalBindingTypeLookup
  (match (epsilon_control_find_transition_pattern patternValue control)
    (NoEpsilonTransitionPatternReference NoEpsilonLocalBindingType)
    ((OneEpsilonTransitionPatternReference kind progress)
      (match progress
        (EpsilonTransitionPatternResolved NoEpsilonLocalBindingType)
        (EpsilonTransitionPatternComplete
          (match kind
            ((EpsilonScalarPatternSelector value) NoEpsilonLocalBindingType)
            (EpsilonTransitionWildcard NoEpsilonLocalBindingType)
            ((EpsilonSumCasePattern ownerValue caseValue)
              (match patternValue
                ((EpsilonIntegerPattern start end literal)
                  NoEpsilonLocalBindingType)
                ((EpsilonTruePattern start end) NoEpsilonLocalBindingType)
                ((EpsilonFalsePattern start end) NoEpsilonLocalBindingType)
                ((EpsilonWildcardPattern start end) NoEpsilonLocalBindingType)
                ((EpsilonCasePattern start end owner name binder)
                  (match binder
                    (NoEpsilonBinder NoEpsilonLocalBindingType)
                    ((SomeEpsilonBinder binderStart binderEnd names)
                      (epsilon_binder_parameter_type source target names
                        (epsilon_constructor_parameters caseValue)))))))))))))

(def epsilon_local_binding_type ((source Bytes)
  (bindingValue EpsilonLocalBinding) (control EpsilonControlReferenceLedger))
  EpsilonLocalBindingTypeLookup
  (match bindingValue
    ((EpsilonSelfLocal ownerDeclaration) NoEpsilonLocalBindingType)
    ((EpsilonMachineParameterLocal parameterValue)
      (match parameterValue
        ((EpsilonParameterSyntax start end name typeValue)
          (OneEpsilonLocalBindingType typeValue))))
    ((EpsilonStateParameterLocal parameterValue)
      (match parameterValue
        ((EpsilonParameterSyntax start end name typeValue)
          (OneEpsilonLocalBindingType typeValue))))
    ((EpsilonLetLocal name typeValue statementValue)
      (OneEpsilonLocalBindingType typeValue))
    ((EpsilonTransitionBinderLocal patternValue name)
      (epsilon_transition_binder_type source patternValue name control))))

(def epsilon_local_scan_binding_type ((source Bytes)
  (bindingValue EpsilonLocalBinding) (scan EpsilonLocalResolutionScan))
  EpsilonLocalBindingTypeLookup
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (epsilon_local_binding_type source bindingValue control))))

; `u8` names storage, not an arithmetic value type. Reading one storage slot
; yields a zero-extended `i32`; every other complete value keeps its type.
(def epsilon_storage_read_type ((expressionValue EpsilonExpression)
  (typeValue EpsilonType)) EpsilonType
  (match typeValue
    ((EpsilonU8Type start end)
      (EpsilonI32Type (epsilon_expression_start expressionValue)
        (epsilon_expression_end expressionValue)))
    ((EpsilonI32Type start end) typeValue)
    ((EpsilonNeverType start end) typeValue)
    ((EpsilonNamedType start end name) typeValue)
    ((EpsilonArrayType start end element lengthValue) typeValue)
    ((EpsilonViewType start end element) typeValue)))

(def epsilon_type_is_i32 ((typeValue EpsilonType)) Int
  (match typeValue
    ((EpsilonI32Type start end) 1)
    ((EpsilonU8Type start end) 0)
    ((EpsilonNeverType start end) 0)
    ((EpsilonNamedType start end name) 0)
    ((EpsilonArrayType start end element lengthValue) 0)
    ((EpsilonViewType start end element) 0)))

(def epsilon_local_scan_add_result ((expressionValue EpsilonExpression)
  (resultValue EpsilonExpressionResult) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (EpsilonLocalResolutionScanSyntax catalog references fields callables
        stateApplications
        (MoreEpsilonTypedExpressions
          (EpsilonTypedExpressionSyntax expressionValue resultValue) types)
        candidate))))

(def epsilon_local_scan_add_value ((expressionValue EpsilonExpression)
  (typeValue EpsilonType) (placeType EpsilonOptionalPlaceType)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (epsilon_local_scan_add_result expressionValue
    (EpsilonValueExpressionResult typeValue placeType) scan))

(def epsilon_local_scan_add_reference ((expressionValue EpsilonExpression)
  (bindingValue EpsilonLocalBinding) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (EpsilonLocalResolutionScanSyntax catalog
        (MoreEpsilonResolvedLocalReferences
          (EpsilonResolvedLocalReferenceSyntax expressionValue bindingValue)
          references)
        fields callables stateApplications types candidate))))

(def epsilon_local_scan_add_field_reference ((expressionValue EpsilonExpression)
  (owner EpsilonDeclaration) (member EpsilonDataMember)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (EpsilonLocalResolutionScanSyntax catalog references
        (MoreEpsilonResolvedFieldReferences
          (EpsilonResolvedFieldReferenceSyntax expressionValue owner member)
          fields)
        callables stateApplications types candidate))))

(def epsilon_local_scan_add_callable_reference
  ((expressionValue EpsilonExpression)
   (callable EpsilonResolvedCallable)
   (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (EpsilonLocalResolutionScanSyntax catalog references fields
        (MoreEpsilonResolvedCallableReferences
          (EpsilonResolvedCallableReferenceSyntax expressionValue callable)
          callables)
        stateApplications types candidate))))

(def epsilon_local_scan_add_state_application
  ((expressionValue EpsilonExpression) (machineValue EpsilonDeclaration)
   (stateValue EpsilonState) (progress EpsilonStateApplicationProgress)
   (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      stateApplications types candidate)
      (match stateApplications
        ((EpsilonControlReferenceLedgerSyntax states subjects patterns coverages)
          (EpsilonLocalResolutionScanSyntax catalog references fields callables
            (EpsilonControlReferenceLedgerSyntax
              (MoreEpsilonStateApplicationReferences
                (EpsilonStateApplicationReferenceSyntax expressionValue
                  machineValue stateValue progress)
                states)
              subjects patterns coverages)
            types candidate))))))

(def epsilon_local_scan_add_transition_subject ((terminalValue EpsilonTerminal)
  (kind EpsilonTransitionSubjectKind) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match control
        ((EpsilonControlReferenceLedgerSyntax states subjects patterns coverages)
          (EpsilonLocalResolutionScanSyntax catalog references fields callables
            (EpsilonControlReferenceLedgerSyntax states
              (MoreEpsilonTransitionSubjectReferences
                (EpsilonTransitionSubjectReferenceSyntax terminalValue kind)
                subjects)
              patterns coverages)
            types candidate))))))

(def epsilon_local_scan_add_transition_pattern ((terminalValue EpsilonTerminal)
  (patternValue EpsilonPattern) (kind EpsilonTransitionPatternKind)
  (progress EpsilonTransitionPatternProgress)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match control
        ((EpsilonControlReferenceLedgerSyntax states subjects patterns coverages)
          (EpsilonLocalResolutionScanSyntax catalog references fields callables
            (EpsilonControlReferenceLedgerSyntax states subjects
              (MoreEpsilonTransitionPatternReferences
                (EpsilonTransitionPatternReferenceSyntax terminalValue
                  patternValue kind progress)
                patterns)
              coverages)
            types candidate))))))

(def epsilon_local_scan_add_transition_coverage ((terminalValue EpsilonTerminal)
  (ownerValue EpsilonDeclaration) (state EpsilonTransitionCoverageState)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match control
        ((EpsilonControlReferenceLedgerSyntax states subjects patterns coverages)
          (EpsilonLocalResolutionScanSyntax catalog references fields callables
            (EpsilonControlReferenceLedgerSyntax states subjects patterns
              (MoreEpsilonTransitionCoverageReferences
                (EpsilonTransitionCoverageReferenceSyntax terminalValue
                  ownerValue state)
                coverages))
            types candidate))))))

(def epsilon_local_scan_add_candidate ((reasonValue EpsilonRejectReason)
  (offset Int) (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
        (epsilon_final_candidate_add reasonValue offset candidate)))))

(def epsilon_expression_list_count ((expressions EpsilonExpressionList)) Int
  (match expressions
    (NoEpsilonExpressions 0)
    ((MoreEpsilonExpressions item rest)
      (+ 1 (epsilon_expression_list_count rest)))))

(def epsilon_parameter_list_count ((parameters EpsilonParameterList)) Int
  (match parameters
    (NoEpsilonParameters 0)
    ((MoreEpsilonParameters item rest)
      (+ 1 (epsilon_parameter_list_count rest)))))

(def epsilon_name_list_count ((names EpsilonNameList)) Int
  (match names
    (NoEpsilonNames 0)
    ((MoreEpsilonNames item rest) (+ 1 (epsilon_name_list_count rest)))))

(def epsilon_optional_binder_count ((binder EpsilonOptionalBinder)) Int
  (match binder
    (NoEpsilonBinder 0)
    ((SomeEpsilonBinder start end names) (epsilon_name_list_count names))))

(def epsilon_data_declarations_same_identity ((left EpsilonDeclaration)
  (right EpsilonDeclaration)) Int
  (match left
    ((EpsilonBoundaryDeclaration leftStart leftEnd leftName leftMachines) 0)
    ((EpsilonMachineDeclaration leftStart leftEnd leftName leftInputs
      leftReturn leftBody) 0)
    ((EpsilonDataDeclaration leftStart leftEnd leftName leftMembers)
      (match right
        ((EpsilonBoundaryDeclaration rightStart rightEnd rightName rightMachines)
          0)
        ((EpsilonMachineDeclaration rightStart rightEnd rightName rightInputs
          rightReturn rightBody) 0)
        ((EpsilonDataDeclaration rightStart rightEnd rightName rightMembers)
          (if (eq leftStart rightStart) (eq leftEnd rightEnd) 0))))))

(def epsilon_optional_arguments_count ((arguments EpsilonOptionalArguments)) Int
  (match arguments
    (NoEpsilonArguments 0)
    ((SomeEpsilonArguments openStart closeEnd values)
      (epsilon_expression_list_count values))))

(def epsilon_argument_value_type_compatible ((source Bytes)
  (actual EpsilonType) (expected EpsilonType) (storedEstablishment Int)) Int
  (if storedEstablishment
    (match expected
      ((EpsilonU8Type start end) (epsilon_type_is_i32 actual))
      ((EpsilonI32Type start end) (epsilon_types_equal source actual expected))
      ((EpsilonNeverType start end) (epsilon_types_equal source actual expected))
      ((EpsilonNamedType start end name)
        (epsilon_types_equal source actual expected))
      ((EpsilonArrayType start end element lengthValue)
        (epsilon_types_equal source actual expected))
      ((EpsilonViewType start end element)
        (epsilon_types_equal source actual expected)))
    (epsilon_types_equal source actual expected)))

(def epsilon_argument_type_join_merge ((left EpsilonArgumentTypeJoin)
  (right EpsilonArgumentTypeJoin)) EpsilonArgumentTypeJoin
  (match left
    (EpsilonArgumentsIncomplete EpsilonArgumentsIncomplete)
    (EpsilonArgumentsTypeMismatch
      (match right
        (EpsilonArgumentsIncomplete EpsilonArgumentsIncomplete)
        (EpsilonArgumentsCompatible EpsilonArgumentsTypeMismatch)
        (EpsilonArgumentsTypeMismatch EpsilonArgumentsTypeMismatch)))
    (EpsilonArgumentsCompatible right)))

(def epsilon_argument_types_join ((source Bytes)
  (arguments EpsilonExpressionList) (parameters EpsilonParameterList)
  (types EpsilonTypedExpressionList) (storedEstablishment Int))
  EpsilonArgumentTypeJoin
  (match arguments
    (NoEpsilonExpressions
      (match parameters
        (NoEpsilonParameters EpsilonArgumentsCompatible)
        ((MoreEpsilonParameters parameter rest)
          EpsilonArgumentsIncomplete)))
    ((MoreEpsilonExpressions argument argumentRest)
      (match parameters
        (NoEpsilonParameters EpsilonArgumentsIncomplete)
        ((MoreEpsilonParameters parameter parameterRest)
          (match parameter
            ((EpsilonParameterSyntax start end name expectedType)
              (let current EpsilonArgumentTypeJoin
                (match (epsilon_find_expression_result argument types)
                  (NoEpsilonExpressionResult EpsilonArgumentsIncomplete)
                  ((OneEpsilonExpressionResult resultValue)
                    (match resultValue
                      ((EpsilonValueExpressionResult actualType placeType)
                        (if (epsilon_argument_value_type_compatible source
                          actualType expectedType storedEstablishment)
                          EpsilonArgumentsCompatible
                          EpsilonArgumentsTypeMismatch))
                      (EpsilonResultlessExpressionResult
                        EpsilonArgumentsIncomplete)
                      (EpsilonNeverExpressionResult
                        EpsilonArgumentsIncomplete))))
                (epsilon_argument_type_join_merge current
                  (epsilon_argument_types_join source argumentRest parameterRest
                    types storedEstablishment))))))))))

(def epsilon_optional_argument_types_join ((source Bytes)
  (arguments EpsilonOptionalArguments) (parameters EpsilonParameterList)
  (types EpsilonTypedExpressionList) (storedEstablishment Int))
  EpsilonArgumentTypeJoin
  (match arguments
    (NoEpsilonArguments
      (match parameters
        (NoEpsilonParameters EpsilonArgumentsCompatible)
        ((MoreEpsilonParameters item rest) EpsilonArgumentsIncomplete)))
    ((SomeEpsilonArguments openStart closeEnd values)
      (epsilon_argument_types_join source values parameters types
        storedEstablishment))))

(def epsilon_local_scan_add_machine_result ((expressionValue EpsilonExpression)
  (returnType EpsilonOptionalType) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match returnType
    (NoEpsilonType
      (epsilon_local_scan_add_result expressionValue
        EpsilonResultlessExpressionResult scan))
    ((SomeEpsilonType start end typeValue)
      (match typeValue
        ((EpsilonNeverType typeStart typeEnd)
          (epsilon_local_scan_add_result expressionValue
            EpsilonNeverExpressionResult scan))
        ((EpsilonI32Type typeStart typeEnd)
          (epsilon_local_scan_add_value expressionValue typeValue
            NoEpsilonPlaceType scan))
        ((EpsilonU8Type typeStart typeEnd)
          (epsilon_local_scan_add_value expressionValue typeValue
            NoEpsilonPlaceType scan))
        ((EpsilonNamedType typeStart typeEnd name)
          (epsilon_local_scan_add_value expressionValue typeValue
            NoEpsilonPlaceType scan))
        ((EpsilonArrayType typeStart typeEnd element lengthValue)
          (epsilon_local_scan_add_value expressionValue typeValue
            NoEpsilonPlaceType scan))
        ((EpsilonViewType typeStart typeEnd element)
          (epsilon_local_scan_add_value expressionValue typeValue
            NoEpsilonPlaceType scan))))))

; An argument's category is a sibling of the enclosing callable's admission
; and arity. D52 anchors a resultless argument's TypeMismatch at the authored
; argument expression start, including outer grouping; its branch below remains
; intentionally unimplemented. The existing `never` sibling keeps the core
; call-head anchor, and the later all-value join owns application-anchored type
; mismatch.
(def epsilon_local_scan_argument_terminal_candidates
  ((arguments EpsilonExpressionList) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match arguments
    (NoEpsilonExpressions scan)
    ((MoreEpsilonExpressions item rest)
      (let nextScan EpsilonLocalResolutionScan
        (match scan
          ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications
            types candidate)
            (match (epsilon_find_expression_result item types)
              (NoEpsilonExpressionResult scan)
              ((OneEpsilonExpressionResult resultValue)
                (match resultValue
                  ((EpsilonValueExpressionResult typeValue placeType) scan)
                  (EpsilonResultlessExpressionResult scan)
                  (EpsilonNeverExpressionResult
                    (epsilon_local_scan_add_candidate InvalidTerminal
                      (epsilon_expression_start (epsilon_call_head_core item))
                      scan)))))))
        (epsilon_local_scan_argument_terminal_candidates rest nextScan)))))

; Every admitted callable spelling converges here after identity and category
; resolution. Arity depends on the signature plus authored argument count; the
; sibling argument-type join additionally waits for every complete value fact.
; A receiver is implicit and therefore never appears in either list.
(def epsilon_local_scan_admitted_signature_application ((source Bytes)
  (expressionValue EpsilonExpression) (arguments EpsilonExpressionList)
  (parameters EpsilonParameterList) (returnType EpsilonOptionalType)
  (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (if (eq (epsilon_expression_list_count arguments)
    (epsilon_parameter_list_count parameters))
    (match scan
      ((EpsilonLocalResolutionScanSyntax catalog references fields
        callables stateApplications types candidate)
        (match (epsilon_argument_types_join source arguments parameters
          types 0)
          (EpsilonArgumentsCompatible
            (epsilon_local_scan_add_machine_result expressionValue
              returnType scan))
          (EpsilonArgumentsIncomplete scan)
          (EpsilonArgumentsTypeMismatch
            (epsilon_local_scan_add_candidate TypeMismatch
              (epsilon_expression_start expressionValue) scan)))))
    (epsilon_local_scan_add_candidate ArityMismatch
      (epsilon_expression_start expressionValue) scan)))

(def epsilon_local_scan_admitted_machine_application ((source Bytes)
  (expressionValue EpsilonExpression) (arguments EpsilonExpressionList)
  (machineDeclaration EpsilonDeclaration) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match machineDeclaration
    ((EpsilonBoundaryDeclaration start end name machines) scan)
    ((EpsilonDataDeclaration start end name members) scan)
    ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
      (epsilon_local_scan_admitted_signature_application source expressionValue
        arguments (epsilon_machine_input_parameters inputs) returnType scan))))

(def epsilon_state_parameters ((stateValue EpsilonState)) EpsilonParameterList
  (match stateValue
    ((EpsilonStateSyntax start end name parameters bodyValue) parameters)))

; State identity is retained before arity and argument typing, but only the
; stronger complete row authorizes lowering a transfer. A state is not an
; expression result and never enters the callable ledger.
(def epsilon_local_scan_admitted_state_application ((source Bytes)
  (expressionValue EpsilonExpression) (arguments EpsilonExpressionList)
  (machineValue EpsilonDeclaration) (stateValue EpsilonState)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (let parameters EpsilonParameterList (epsilon_state_parameters stateValue)
    (if (eq (epsilon_expression_list_count arguments)
      (epsilon_parameter_list_count parameters))
      (match scan
        ((EpsilonLocalResolutionScanSyntax catalog references fields callables
          stateApplications types candidate)
          (match (epsilon_argument_types_join source arguments parameters
            types 0)
            (EpsilonArgumentsCompatible
              (epsilon_local_scan_add_state_application expressionValue
                machineValue stateValue EpsilonStateApplicationComplete scan))
            (EpsilonArgumentsIncomplete
              (epsilon_local_scan_add_state_application expressionValue
                machineValue stateValue EpsilonStateApplicationResolved scan))
            (EpsilonArgumentsTypeMismatch
              (epsilon_local_scan_add_candidate TypeMismatch
                (epsilon_expression_start expressionValue)
                (epsilon_local_scan_add_state_application expressionValue
                  machineValue stateValue EpsilonStateApplicationResolved
                  scan))))))
      (epsilon_local_scan_add_candidate ArityMismatch
        (epsilon_expression_start expressionValue)
        (epsilon_local_scan_add_state_application expressionValue machineValue
          stateValue EpsilonStateApplicationResolved scan)))))

(def epsilon_expression_use_qualified_failure_anchor
  ((expressionValue EpsilonExpression) (useValue EpsilonExpressionUse)) Int
  (match useValue
    (EpsilonOrdinaryExpressionUse (epsilon_expression_start expressionValue))
    (EpsilonCallHeadExpressionUse (epsilon_expression_start expressionValue))
    ((EpsilonPostfixStatementExpressionUse statementStart) statementStart)
    ((EpsilonTransitionContinuationExpressionUse machineValue continuationStart)
      continuationStart)))

(def epsilon_local_scan_constructor_value_application ((source Bytes)
  (expressionValue EpsilonExpression) (ownerName EpsilonName)
  (arguments EpsilonOptionalArguments) (caseValue EpsilonDataMember)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (let parameters EpsilonParameterList (epsilon_constructor_parameters caseValue)
    (if (eq (epsilon_optional_arguments_count arguments)
      (epsilon_parameter_list_count parameters))
      (match scan
        ((EpsilonLocalResolutionScanSyntax catalog references fields
          callables stateApplications types candidate)
          (match (epsilon_optional_argument_types_join source arguments
            parameters types 1)
            (EpsilonArgumentsCompatible
              (epsilon_local_scan_add_value expressionValue
                (EpsilonNamedType (epsilon_expression_start expressionValue)
                  (epsilon_expression_end expressionValue) ownerName)
                NoEpsilonPlaceType scan))
            (EpsilonArgumentsIncomplete scan)
            (EpsilonArgumentsTypeMismatch
              (epsilon_local_scan_add_candidate TypeMismatch
                (epsilon_expression_start expressionValue) scan)))))
      (epsilon_local_scan_add_candidate ArityMismatch
        (epsilon_expression_start expressionValue) scan))))

(def epsilon_local_scan_constructor_application ((source Bytes)
  (expressionValue EpsilonExpression) (ownerName EpsilonName)
  (arguments EpsilonOptionalArguments) (ownerDeclaration EpsilonDeclaration)
  (caseValue EpsilonDataMember) (useValue EpsilonExpressionUse)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (let identityScan EpsilonLocalResolutionScan
    (epsilon_local_scan_add_callable_reference expressionValue
      (EpsilonResolvedConstructorCallable ownerDeclaration caseValue) scan)
    (match useValue
      (EpsilonOrdinaryExpressionUse
        (epsilon_local_scan_constructor_value_application source expressionValue
          ownerName arguments caseValue identityScan))
      (EpsilonCallHeadExpressionUse
        (epsilon_local_scan_constructor_value_application source expressionValue
          ownerName arguments caseValue identityScan))
      ((EpsilonPostfixStatementExpressionUse statementStart)
        (epsilon_local_scan_add_candidate TypeMismatch
          statementStart identityScan))
      ((EpsilonTransitionContinuationExpressionUse machineValue continuationStart)
        (epsilon_local_scan_add_candidate InvalidControlTarget
          continuationStart identityScan)))))

(def epsilon_local_scan_data_machine_application ((source Bytes)
  (expressionValue EpsilonExpression) (arguments EpsilonOptionalArguments)
  (ownerDeclaration EpsilonDeclaration) (machineDeclaration EpsilonDeclaration)
  (useValue EpsilonExpressionUse) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (let identityScan EpsilonLocalResolutionScan
    (epsilon_local_scan_add_callable_reference expressionValue
      (EpsilonResolvedDataMachineCallable ownerDeclaration machineDeclaration)
      scan)
    (match machineDeclaration
      ((EpsilonBoundaryDeclaration start end name machines) identityScan)
      ((EpsilonDataDeclaration start end name members) identityScan)
      ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
        (match arguments
          (NoEpsilonArguments
            (match useValue
              (EpsilonOrdinaryExpressionUse
                (epsilon_local_scan_add_candidate TypeMismatch
                  (epsilon_expression_start expressionValue) identityScan))
              ; A bare qualified machine can be the grammar-selected head of
              ; a following call suffix. That outer application owns custody.
              (EpsilonCallHeadExpressionUse identityScan)
              ((EpsilonPostfixStatementExpressionUse statementStart)
                (epsilon_local_scan_add_candidate TypeMismatch
                  statementStart identityScan))
              ((EpsilonTransitionContinuationExpressionUse machineValue
                continuationStart) identityScan)))
          ((SomeEpsilonArguments openStart closeEnd values)
            (if (epsilon_machine_inputs_have_receiver inputs)
              ; Static qualified syntax never supplies or infers a receiver,
              ; regardless of expression, statement, or continuation context.
              (epsilon_local_scan_wrong_qualified_callable_kind expressionValue
                useValue identityScan)
              (epsilon_local_scan_admitted_machine_application source
                expressionValue values machineDeclaration identityScan))))))))

(def epsilon_local_scan_wrong_qualified_callable_kind
  ((expressionValue EpsilonExpression) (useValue EpsilonExpressionUse)
   (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match useValue
    (EpsilonOrdinaryExpressionUse
      (epsilon_local_scan_add_candidate TypeMismatch
        (epsilon_expression_start expressionValue) scan))
    (EpsilonCallHeadExpressionUse
      (epsilon_local_scan_add_candidate TypeMismatch
        (epsilon_expression_start expressionValue) scan))
    ((EpsilonPostfixStatementExpressionUse statementStart)
      (epsilon_local_scan_add_candidate TypeMismatch
        statementStart scan))
    ((EpsilonTransitionContinuationExpressionUse machineValue continuationStart)
      (epsilon_local_scan_add_candidate InvalidControlTarget continuationStart
        scan))))

(def epsilon_local_scan_qualified_callable_fact ((source Bytes)
  (expressionValue EpsilonExpression) (ownerName EpsilonName) (memberName EpsilonName)
  (arguments EpsilonOptionalArguments) (useValue EpsilonExpressionUse)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match catalog
        ((EpsilonResolutionCatalogSyntax rows)
          (match (epsilon_catalog_find_owner source ownerName rows)
            (NoEpsilonCatalogOwner
              (epsilon_local_scan_add_candidate UnknownName
                (epsilon_name_start ownerName) scan))
            ((OneEpsilonCatalogBoundaryOwner ownerDeclaration)
              (match (epsilon_catalog_find_boundary_member source ownerName
                memberName rows)
                (NoEpsilonCatalogBoundaryMember
                  (epsilon_local_scan_add_candidate UnknownName
                    (epsilon_name_start memberName) scan))
                ((OneEpsilonCatalogBoundaryMember memberValue)
                  (epsilon_local_scan_wrong_qualified_callable_kind
                    expressionValue useValue scan))))
            ((OneEpsilonCatalogDataOwner ownerDeclaration shape)
              (let memberLookup EpsilonCatalogDataMemberLookup
                (epsilon_catalog_find_data_member source ownerName memberName rows)
                (let machineLookup EpsilonCatalogDataMachineLookup
                  (epsilon_catalog_find_qualified_data_machine source ownerName
                    memberName rows)
                  (match machineLookup
                    ((OneEpsilonCatalogDataMachine machineOwner
                      machineDeclaration)
                      (match memberLookup
                        ((OneEpsilonCatalogCase caseOwner caseValue)
                          ; Accepted D36 census makes this dual success
                          ; unreachable. Never choose a callable by lookup order.
                          scan)
                        (NoEpsilonCatalogDataMember
                          (epsilon_local_scan_data_machine_application source
                            expressionValue arguments machineOwner
                            machineDeclaration useValue scan))
                        ((OneEpsilonCatalogField fieldOwner fieldValue)
                          (epsilon_local_scan_data_machine_application source
                            expressionValue arguments machineOwner
                            machineDeclaration useValue scan))))
                    (NoEpsilonCatalogDataMachine
                      (match memberLookup
                        ((OneEpsilonCatalogCase caseOwner caseValue)
                          (epsilon_local_scan_constructor_application source
                            expressionValue ownerName arguments caseOwner
                            caseValue useValue scan))
                        ((OneEpsilonCatalogField fieldOwner fieldValue)
                          (epsilon_local_scan_wrong_qualified_callable_kind
                            expressionValue useValue scan))
                        (NoEpsilonCatalogDataMember
                          (epsilon_local_scan_add_candidate UnknownName
                            (epsilon_name_start memberName) scan))))))))))))))

; Parentheses do not create a distinct callable identity. The outer
; application remains the custody/result key while this allocation-free view
; exposes only the grammar-selected core head.
(def epsilon_call_head_core ((expressionValue EpsilonExpression)) EpsilonExpression
  (match expressionValue
    ((EpsilonGroupedExpression start end inner) (epsilon_call_head_core inner))
    ((EpsilonIntegerExpression start end literal) expressionValue)
    ((EpsilonCharacterExpression start end literal) expressionValue)
    ((EpsilonStringExpression start end literal) expressionValue)
    ((EpsilonTrueExpression start end) expressionValue)
    ((EpsilonFalseExpression start end) expressionValue)
    ((EpsilonSelfExpression start end) expressionValue)
    ((EpsilonNameExpression start end name) expressionValue)
    ((EpsilonQualifiedExpression start end owner name arguments) expressionValue)
    ((EpsilonFieldExpression start end base field) expressionValue)
    ((EpsilonCallExpression start end base arguments) expressionValue)
    ((EpsilonIndexExpression start end base indexValue) expressionValue)
    ((EpsilonSliceExpression start end base low high) expressionValue)
    ((EpsilonNegateExpression start end operand) expressionValue)
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
      left right) expressionValue)))

; If a call-head selector resolves to an authored field rather than a receiver
; machine, materialize the ordinary field result on the exact selector and
; carry it through authored parentheses. The general value-call rule then owns
; the outer TypeMismatch. This preserves field custody and never chooses a
; callable merely because a field shares its spelling.
(def epsilon_local_scan_propagate_grouped_call_head_result
  ((callBase EpsilonExpression) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match callBase
    ((EpsilonGroupedExpression start end inner)
      (match scan
        ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications
          types candidate)
          (match (epsilon_find_expression_result callBase types)
            ((OneEpsilonExpressionResult resultValue) scan)
            (NoEpsilonExpressionResult
              (let nextScan EpsilonLocalResolutionScan
                (epsilon_local_scan_propagate_grouped_call_head_result inner scan)
                (epsilon_local_scan_propagate_result callBase inner
                  nextScan)))))))
    ((EpsilonIntegerExpression start end literal) scan)
    ((EpsilonCharacterExpression start end literal) scan)
    ((EpsilonStringExpression start end literal) scan)
    ((EpsilonTrueExpression start end) scan)
    ((EpsilonFalseExpression start end) scan)
    ((EpsilonSelfExpression start end) scan)
    ((EpsilonNameExpression start end name) scan)
    ((EpsilonQualifiedExpression start end owner name argumentsValue) scan)
    ((EpsilonFieldExpression start end base member) scan)
    ((EpsilonCallExpression start end base callArguments) scan)
    ((EpsilonIndexExpression start end base indexValue) scan)
    ((EpsilonSliceExpression start end base low high) scan)
    ((EpsilonNegateExpression start end operand) scan)
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
      left right) scan)))

(def epsilon_local_scan_boundary_receiver_application ((source Bytes)
  (expressionValue EpsilonExpression) (callBase EpsilonExpression)
  (receiver EpsilonExpression)
  (memberName EpsilonName) (arguments EpsilonExpressionList)
  (receiverPlace EpsilonOptionalPlaceType) (ownerDeclaration EpsilonDeclaration)
  (useValue EpsilonExpressionUse) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match ownerDeclaration
    ((EpsilonBoundaryDeclaration start end name machines)
      (match (epsilon_catalog_find_boundary_machine source memberName machines)
        (NoEpsilonCatalogBoundaryMember
          (epsilon_local_scan_propagate_grouped_call_head_result callBase
            (epsilon_local_scan_field_fact source
              (epsilon_call_head_core callBase) receiver memberName useValue
              scan)))
        ((OneEpsilonCatalogBoundaryMember memberValue)
          (let identityScan EpsilonLocalResolutionScan
            (epsilon_local_scan_add_callable_reference expressionValue
              (EpsilonResolvedBoundaryMachineCallable ownerDeclaration
                memberValue)
              scan)
            (match receiverPlace
              (NoEpsilonPlaceType
                (epsilon_local_scan_add_candidate InvalidPlace
                  (epsilon_expression_start receiver) identityScan))
              ((SomeEpsilonPlaceType storageType)
                (match memberValue
                  ((EpsilonBoundaryMachineSyntax memberStart memberEnd memberNameValue
                    parameters returnType)
                    (epsilon_local_scan_admitted_signature_application source
                      expressionValue arguments parameters returnType
                      identityScan)))))))))
    ((EpsilonDataDeclaration start end name members) scan)
    ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
      scan)))

(def epsilon_local_scan_data_receiver_application ((source Bytes)
  (expressionValue EpsilonExpression) (callBase EpsilonExpression)
  (receiver EpsilonExpression) (ownerName EpsilonName) (memberName EpsilonName)
  (arguments EpsilonExpressionList)
  (receiverPlace EpsilonOptionalPlaceType) (rows EpsilonCatalogDeclarationList)
  (useValue EpsilonExpressionUse) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (let memberLookup EpsilonCatalogDataMemberLookup
    (epsilon_catalog_find_data_member source ownerName memberName rows)
    (let machineLookup EpsilonCatalogDataMachineLookup
      (epsilon_catalog_find_qualified_data_machine source ownerName memberName
        rows)
      (match machineLookup
        ((OneEpsilonCatalogDataMachine machineOwner machineDeclaration)
          (let caseCollision Int
            (match memberLookup
              ((OneEpsilonCatalogCase caseOwner caseValue) 1)
              ((OneEpsilonCatalogField fieldOwner fieldValue) 0)
              (NoEpsilonCatalogDataMember 0))
            ; Superseded by D51: the final compiler removes this cross-kind
            ; collision guard because constructor and receiver syntax select
            ; distinct namespaces.
            (if caseCollision
              scan
              (let identityScan EpsilonLocalResolutionScan
                (epsilon_local_scan_add_callable_reference expressionValue
                  (EpsilonResolvedDataMachineCallable machineOwner
                    machineDeclaration)
                  scan)
                (match machineDeclaration
                  ((EpsilonBoundaryDeclaration start end name machines)
                    identityScan)
                  ((EpsilonDataDeclaration start end name members) identityScan)
                  ((EpsilonMachineDeclaration start end name inputs returnType
                    bodyValue)
                    (if (epsilon_machine_inputs_have_receiver inputs)
                      (match receiverPlace
                        (NoEpsilonPlaceType
                          (epsilon_local_scan_add_candidate InvalidPlace
                            (epsilon_expression_start receiver) identityScan))
                        ((SomeEpsilonPlaceType storageType)
                          (epsilon_local_scan_admitted_signature_application
                            source expressionValue arguments
                            (epsilon_machine_input_parameters inputs) returnType
                            identityScan)))
                      (epsilon_local_scan_wrong_qualified_callable_kind
                        expressionValue useValue identityScan))))))))
        (NoEpsilonCatalogDataMachine
          (epsilon_local_scan_propagate_grouped_call_head_result callBase
            (epsilon_local_scan_field_fact source
              (epsilon_call_head_core callBase) receiver memberName useValue
              scan)))))))

(def epsilon_local_scan_receiver_application ((source Bytes)
  (expressionValue EpsilonExpression) (callBase EpsilonExpression)
  (arguments EpsilonExpressionList) (useValue EpsilonExpressionUse)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match (epsilon_call_head_core callBase)
    ((EpsilonFieldExpression start end receiver member)
      (match scan
        ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications
          types candidate)
          (match (epsilon_find_expression_result receiver types)
            (NoEpsilonExpressionResult scan)
            ((OneEpsilonExpressionResult receiverResult)
              (match receiverResult
                ((EpsilonValueExpressionResult receiverType receiverPlace)
                  (match receiverType
                    ((EpsilonNamedType typeStart typeEnd ownerName)
                      (match catalog
                        ((EpsilonResolutionCatalogSyntax rows)
                          (match (epsilon_catalog_find_owner source ownerName rows)
                            (NoEpsilonCatalogOwner
                              (epsilon_local_scan_propagate_grouped_call_head_result
                                callBase
                                (epsilon_local_scan_field_fact source
                                  (epsilon_call_head_core callBase) receiver member
                                  useValue scan)))
                            ((OneEpsilonCatalogBoundaryOwner ownerDeclaration)
                              (epsilon_local_scan_boundary_receiver_application
                                source expressionValue callBase receiver member
                                arguments receiverPlace ownerDeclaration
                                useValue scan))
                            ((OneEpsilonCatalogDataOwner ownerDeclaration shape)
                              (epsilon_local_scan_data_receiver_application source
                                expressionValue callBase receiver ownerName
                                member arguments receiverPlace rows useValue
                                scan))))))
                    ((EpsilonI32Type typeStart typeEnd) scan)
                    ((EpsilonU8Type typeStart typeEnd) scan)
                    ((EpsilonNeverType typeStart typeEnd) scan)
                    ((EpsilonArrayType typeStart typeEnd element lengthValue)
                      scan)
                    ((EpsilonViewType typeStart typeEnd element) scan)))
                (EpsilonResultlessExpressionResult scan)
                (EpsilonNeverExpressionResult scan)))))))
    ((EpsilonIntegerExpression start end literal) scan)
    ((EpsilonCharacterExpression start end literal) scan)
    ((EpsilonStringExpression start end literal) scan)
    ((EpsilonTrueExpression start end) scan)
    ((EpsilonFalseExpression start end) scan)
    ((EpsilonSelfExpression start end) scan)
    ((EpsilonNameExpression start end name) scan)
    ((EpsilonQualifiedExpression start end owner name argumentsValue) scan)
    ((EpsilonGroupedExpression start end inner) scan)
    ((EpsilonCallExpression start end base callArguments) scan)
    ((EpsilonIndexExpression start end base indexValue) scan)
    ((EpsilonSliceExpression start end base low high) scan)
    ((EpsilonNegateExpression start end operand) scan)
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
      left right) scan)))

; Statement and continuation syntax may group a complete application. Callable
; custody stays on that exact application rather than being copied onto every
; group wrapper; category consumers normalize through the same group view.
(def epsilon_find_resolved_callable_reference_normalized
  ((target EpsilonExpression) (references EpsilonResolvedCallableReferenceList))
  EpsilonResolvedCallableReferenceLookup
  (epsilon_find_resolved_callable_reference (epsilon_call_head_core target)
    references))

; `(Owner::machine)(args)` and its grouped forms use the authored outer call
; suffix as the machine application. The inner bare qualified spelling retains
; identity only in call-head use; this join moves custody to the exact outer
; application before receiver/static, arity, or argument typing.
(def epsilon_local_scan_qualified_head_application ((source Bytes)
  (expressionValue EpsilonExpression) (callBase EpsilonExpression)
  (arguments EpsilonExpressionList) (useValue EpsilonExpressionUse)
  (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match (epsilon_call_head_core callBase)
    ((EpsilonQualifiedExpression start end owner name argumentsValue)
      (match argumentsValue
        ((SomeEpsilonArguments openStart closeEnd innerArguments) scan)
        (NoEpsilonArguments
          (match scan
            ((EpsilonLocalResolutionScanSyntax catalog references fields
              callables stateApplications types candidate)
              (match (epsilon_find_resolved_callable_reference
                (epsilon_call_head_core callBase) callables)
                (NoEpsilonResolvedCallableReference scan)
                ((OneEpsilonResolvedCallableReference callable)
                  (match callable
                    ((EpsilonResolvedDataMachineCallable ownerDeclaration
                      machineDeclaration)
                      (let identityScan EpsilonLocalResolutionScan
                        (epsilon_local_scan_add_callable_reference expressionValue
                          callable scan)
                        (match machineDeclaration
                          ((EpsilonBoundaryDeclaration machineStart machineEnd
                            machineName machines) identityScan)
                          ((EpsilonDataDeclaration machineStart machineEnd
                            machineName members) identityScan)
                          ((EpsilonMachineDeclaration machineStart machineEnd
                            machineName inputs returnType bodyValue)
                            (if (epsilon_machine_inputs_have_receiver inputs)
                              (epsilon_local_scan_wrong_qualified_callable_kind
                                expressionValue useValue identityScan)
                              (epsilon_local_scan_admitted_machine_application
                                source expressionValue arguments
                                machineDeclaration identityScan))))))
                    ((EpsilonResolvedConstructorCallable constructorOwner
                      caseValue) scan)
                    ((EpsilonResolvedUnqualifiedMachineCallable
                      machineDeclaration) scan)
                    ((EpsilonResolvedBoundaryMachineCallable boundaryOwner
                      memberValue) scan)))))))))
    ((EpsilonIntegerExpression start end literal) scan)
    ((EpsilonCharacterExpression start end literal) scan)
    ((EpsilonStringExpression start end literal) scan)
    ((EpsilonTrueExpression start end) scan)
    ((EpsilonFalseExpression start end) scan)
    ((EpsilonSelfExpression start end) scan)
    ((EpsilonNameExpression start end name) scan)
    ((EpsilonGroupedExpression start end inner) scan)
    ((EpsilonFieldExpression start end base field) scan)
    ((EpsilonCallExpression start end base innerArguments) scan)
    ((EpsilonIndexExpression start end base indexValue) scan)
    ((EpsilonSliceExpression start end base low high) scan)
    ((EpsilonNegateExpression start end operand) scan)
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
      left right) scan)))

(def epsilon_expression_use_admits_unqualified_machine
  ((useValue EpsilonExpressionUse)) Int
  (match useValue
    (EpsilonOrdinaryExpressionUse 1)
    (EpsilonCallHeadExpressionUse 1)
    ((EpsilonPostfixStatementExpressionUse statementStart) 1)
    ; State and unqualified-machine lookup must be joined before either is
    ; admitted for a continuation.
    ((EpsilonTransitionContinuationExpressionUse machineValue continuationStart)
      0)))

(def epsilon_local_scan_unqualified_machine_application ((source Bytes)
  (expressionValue EpsilonExpression) (callBase EpsilonExpression)
  (arguments EpsilonExpressionList) (active EpsilonLocalBindingList)
  (pending EpsilonLocalBindingList) (useValue EpsilonExpressionUse)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (if (epsilon_expression_use_admits_unqualified_machine useValue)
    (match (epsilon_call_head_core callBase)
      ((EpsilonNameExpression start end name)
        (match scan
          ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications
            types candidate)
            (match catalog
              ((EpsilonResolutionCatalogSyntax rows)
                (match (epsilon_catalog_find_unqualified_machine source name rows)
                  ((OneEpsilonCatalogMachine machineDeclaration)
                    (epsilon_local_scan_admitted_machine_application source
                      expressionValue arguments machineDeclaration
                      (epsilon_local_scan_add_callable_reference expressionValue
                        (EpsilonResolvedUnqualifiedMachineCallable
                          machineDeclaration)
                        scan)))
                  (NoEpsilonCatalogMachine
                    (let localScan EpsilonLocalResolutionScan
                      (epsilon_resolve_local_value_name source
                        (EpsilonNameExpression start end name) name active pending
                        scan)
                      (match localScan
                        ((EpsilonLocalResolutionScanSyntax nextCatalog
                          nextReferences nextFields nextCallables
                          nextStateApplications nextTypes nextCandidate)
                          (match (epsilon_find_expression_result
                            (EpsilonNameExpression start end name) nextTypes)
                            (NoEpsilonExpressionResult localScan)
                            ((OneEpsilonExpressionResult resultValue)
                              (match resultValue
                                ((EpsilonValueExpressionResult typeValue
                                  placeType)
                                  (epsilon_local_scan_add_candidate TypeMismatch
                                    (epsilon_expression_start expressionValue)
                                    localScan))
                                (EpsilonResultlessExpressionResult localScan)
                                (EpsilonNeverExpressionResult
                                  localScan))))))))))))))
      ((EpsilonGroupedExpression start end inner) scan)
      ((EpsilonIntegerExpression start end literal) scan)
      ((EpsilonCharacterExpression start end literal) scan)
      ((EpsilonStringExpression start end literal) scan)
      ((EpsilonTrueExpression start end) scan)
      ((EpsilonFalseExpression start end) scan)
      ((EpsilonSelfExpression start end) scan)
      ((EpsilonQualifiedExpression start end owner name argumentsValue) scan)
      ((EpsilonFieldExpression start end base field) scan)
      ((EpsilonCallExpression start end base innerArguments) scan)
      ((EpsilonIndexExpression start end base indexValue) scan)
      ((EpsilonSliceExpression start end base low high) scan)
      ((EpsilonNegateExpression start end operand) scan)
      ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
        left right) scan))
    scan))

; Explicit transition applications join the current machine's state namespace
; with the global unqualified-machine namespace before either identity is
; admitted. Arity and expected result never disambiguate the collision.
(def epsilon_local_scan_transition_unqualified_application ((source Bytes)
  (expressionValue EpsilonExpression) (callBase EpsilonExpression)
  (arguments EpsilonExpressionList) (active EpsilonLocalBindingList)
  (pending EpsilonLocalBindingList) (machineValue EpsilonDeclaration)
  (continuationStart Int) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match (epsilon_call_head_core callBase)
    ((EpsilonNameExpression start end name)
      (match scan
        ((EpsilonLocalResolutionScanSyntax catalog references fields callables
          stateApplications types candidate)
          (match catalog
            ((EpsilonResolutionCatalogSyntax rows)
              (let stateLookup EpsilonCatalogStateLookup
                (epsilon_catalog_find_state source machineValue name)
                (let machineLookup EpsilonCatalogMachineLookup
                  (epsilon_catalog_find_unqualified_machine source name rows)
                  (match stateLookup
                    ((OneEpsilonCatalogState stateValue)
                      (match machineLookup
                        ((OneEpsilonCatalogMachine targetMachine)
                          (epsilon_local_scan_add_candidate InvalidControlTarget
                            continuationStart scan))
                        (NoEpsilonCatalogMachine
                          (epsilon_local_scan_admitted_state_application source
                            expressionValue arguments machineValue stateValue
                            scan))))
                    (NoEpsilonCatalogState
                      (match machineLookup
                        ((OneEpsilonCatalogMachine targetMachine)
                          (epsilon_local_scan_admitted_machine_application source
                            expressionValue arguments targetMachine
                            (epsilon_local_scan_add_callable_reference
                              expressionValue
                              (EpsilonResolvedUnqualifiedMachineCallable
                                targetMachine)
                              scan)))
                        (NoEpsilonCatalogMachine
                          (epsilon_local_scan_propagate_grouped_call_head_result
                            callBase
                            (epsilon_resolve_local_value_name source
                              (EpsilonNameExpression start end name) name active
                              pending scan)))))))))))))
    ((EpsilonIntegerExpression start end literal) scan)
    ((EpsilonCharacterExpression start end literal) scan)
    ((EpsilonStringExpression start end literal) scan)
    ((EpsilonTrueExpression start end) scan)
    ((EpsilonFalseExpression start end) scan)
    ((EpsilonSelfExpression start end) scan)
    ((EpsilonQualifiedExpression start end owner name argumentsValue) scan)
    ((EpsilonGroupedExpression start end inner) scan)
    ((EpsilonFieldExpression start end base field) scan)
    ((EpsilonCallExpression start end base innerArguments) scan)
    ((EpsilonIndexExpression start end base indexValue) scan)
    ((EpsilonSliceExpression start end base low high) scan)
    ((EpsilonNegateExpression start end operand) scan)
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
      left right) scan)))

; D50 settles a state-only bare spelling as InvalidControlTarget independent of
; state arity. Its branch below remains intentionally unimplemented here. A
; state/machine collision is already invalid, a machine-only spelling is a
; known but unapplied control target, and genuine namespace absence may fall
; back to a local value judgment without inventing a target. A bare state never
; enters stateApplications because no application was authored.
(def epsilon_local_scan_transition_bare_name ((source Bytes)
  (expressionValue EpsilonExpression) (name EpsilonName)
  (active EpsilonLocalBindingList) (pending EpsilonLocalBindingList)
  (machineValue EpsilonDeclaration) (continuationStart Int)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      stateApplications types candidate)
      (match catalog
        ((EpsilonResolutionCatalogSyntax rows)
          (let stateLookup EpsilonCatalogStateLookup (epsilon_catalog_find_state source machineValue name)
            (let machineLookup EpsilonCatalogMachineLookup
              (epsilon_catalog_find_unqualified_machine source name rows)
              (match stateLookup
                ((OneEpsilonCatalogState stateValue)
                  (match machineLookup
                    ((OneEpsilonCatalogMachine targetMachine)
                      (epsilon_local_scan_add_candidate InvalidControlTarget
                        continuationStart scan))
                    ; D50 requires InvalidControlTarget at continuationStart;
                    ; the implementation milestone replaces this pending scan.
                    (NoEpsilonCatalogMachine scan)))
                (NoEpsilonCatalogState
                  (match machineLookup
                    ((OneEpsilonCatalogMachine targetMachine)
                      (epsilon_local_scan_add_candidate InvalidControlTarget
                        continuationStart
                        (epsilon_local_scan_add_callable_reference expressionValue
                          (EpsilonResolvedUnqualifiedMachineCallable targetMachine)
                          scan)))
                    (NoEpsilonCatalogMachine
                      (epsilon_resolve_local_value_name source expressionValue
                        name active pending scan))))))))))))

(def epsilon_local_scan_transition_result_candidate
  ((expressionValue EpsilonExpression) (continuationStart Int)
   (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      stateApplications types candidate)
      (match (epsilon_find_expression_result expressionValue types)
        ((OneEpsilonExpressionResult resultValue)
          (match resultValue
            ((EpsilonValueExpressionResult typeValue placeType)
              (epsilon_local_scan_add_candidate InvalidControlTarget
                continuationStart scan))
            (EpsilonResultlessExpressionResult
              (epsilon_local_scan_add_candidate InvalidControlTarget
                continuationStart scan))
            (EpsilonNeverExpressionResult
              (epsilon_local_scan_add_candidate InvalidTerminal
                (epsilon_expression_start
                  (epsilon_call_head_core expressionValue))
                scan))))
        (NoEpsilonExpressionResult
          (match expressionValue
            ((EpsilonCallExpression start end base arguments)
              (match (epsilon_find_expression_result base types)
                (NoEpsilonExpressionResult scan)
                ((OneEpsilonExpressionResult baseResult)
                  (match baseResult
                    ((EpsilonValueExpressionResult typeValue placeType)
                      (epsilon_local_scan_add_candidate InvalidControlTarget
                        continuationStart scan))
                    (EpsilonResultlessExpressionResult
                      (epsilon_local_scan_add_candidate InvalidControlTarget
                        continuationStart scan))
                    (EpsilonNeverExpressionResult
                      (epsilon_local_scan_add_candidate InvalidTerminal
                        (epsilon_expression_start (epsilon_call_head_core base))
                        scan))))))
            ((EpsilonIntegerExpression start end literal) scan)
            ((EpsilonCharacterExpression start end literal) scan)
            ((EpsilonStringExpression start end literal) scan)
            ((EpsilonTrueExpression start end) scan)
            ((EpsilonFalseExpression start end) scan)
            ((EpsilonSelfExpression start end) scan)
            ((EpsilonNameExpression start end name) scan)
            ((EpsilonQualifiedExpression start end owner name argumentsValue)
              scan)
            ((EpsilonGroupedExpression start end inner) scan)
            ((EpsilonFieldExpression start end base field) scan)
            ((EpsilonIndexExpression start end base indexValue) scan)
            ((EpsilonSliceExpression start end base low high) scan)
            ((EpsilonNegateExpression start end operand) scan)
            ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
              left right) scan)))))))

; Identity/category admission is a postpass over the exact continuation. A
; resolved state or applied machine remains admitted even when later premises
; are incomplete; constructors and completed non-control values are rejected
; before any dependent arity/type guess.
(def epsilon_local_scan_transition_admission
  ((expressionValue EpsilonExpression) (continuationStart Int)
   (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      stateApplications types candidate)
      (match (epsilon_control_find_state_application
        (epsilon_call_head_core expressionValue) stateApplications)
        ((OneEpsilonStateApplicationReference machineValue stateValue progress)
          scan)
        (NoEpsilonStateApplicationReference
          (match (epsilon_find_resolved_callable_reference_normalized
            expressionValue callables)
            ((OneEpsilonResolvedCallableReference callable)
              (match callable
                ((EpsilonResolvedConstructorCallable ownerDeclaration caseValue)
                  (epsilon_local_scan_add_candidate InvalidControlTarget
                    continuationStart scan))
                ((EpsilonResolvedDataMachineCallable ownerDeclaration
                  machineDeclaration)
                  (if (epsilon_expression_has_authored_application expressionValue)
                    scan
                    (epsilon_local_scan_add_candidate InvalidControlTarget
                      continuationStart scan)))
                ((EpsilonResolvedUnqualifiedMachineCallable machineDeclaration)
                  (if (epsilon_expression_has_authored_application expressionValue)
                    scan
                    (epsilon_local_scan_add_candidate InvalidControlTarget
                      continuationStart scan)))
                ((EpsilonResolvedBoundaryMachineCallable ownerDeclaration
                  memberValue)
                  (if (epsilon_expression_has_authored_application expressionValue)
                    scan
                    (epsilon_local_scan_add_candidate InvalidControlTarget
                      continuationStart scan)))))
            (NoEpsilonResolvedCallableReference
              (epsilon_local_scan_transition_result_candidate expressionValue
                continuationStart scan))))))))

; A discarded-call statement selects the unqualified machine namespace before
; local fallback even when its authored argument list is missing. Retain the
; known identity and reject the bare spelling at the carried outer statement
; anchor; only genuine machine absence permits ordinary local resolution.
(def epsilon_resolve_local_postfix_statement_name ((source Bytes)
  (expressionValue EpsilonExpression) (name EpsilonName)
  (statementStart Int) (active EpsilonLocalBindingList)
  (pending EpsilonLocalBindingList) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match catalog
        ((EpsilonResolutionCatalogSyntax rows)
          (match (epsilon_catalog_find_unqualified_machine source name rows)
            ((OneEpsilonCatalogMachine machineDeclaration)
              (epsilon_local_scan_add_candidate TypeMismatch
                statementStart
                (epsilon_local_scan_add_callable_reference expressionValue
                  (EpsilonResolvedUnqualifiedMachineCallable machineDeclaration)
                  scan)))
            (NoEpsilonCatalogMachine
              (epsilon_resolve_local_value_name source expressionValue name active
                pending scan))))))))

(def epsilon_resolve_local_value_name ((source Bytes)
  (expressionValue EpsilonExpression) (name EpsilonName)
  (active EpsilonLocalBindingList) (pending EpsilonLocalBindingList)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match (epsilon_local_find_binding source name active)
    ((OneEpsilonLocalBinding bindingValue)
      (let nextScan EpsilonLocalResolutionScan
        (epsilon_local_scan_add_reference expressionValue bindingValue scan)
        (match (epsilon_local_scan_binding_type source bindingValue nextScan)
          (NoEpsilonLocalBindingType nextScan)
          ((OneEpsilonLocalBindingType typeValue)
            (epsilon_local_scan_add_value expressionValue
              (epsilon_storage_read_type expressionValue typeValue)
              (SomeEpsilonPlaceType typeValue)
              nextScan)))))
    (NoEpsilonLocalBinding
      (match (epsilon_local_find_binding source name pending)
        ((OneEpsilonLocalBinding bindingValue)
          (epsilon_local_scan_add_candidate UseBeforeInitialization
            (epsilon_expression_start expressionValue) scan))
        (NoEpsilonLocalBinding
          (epsilon_local_scan_add_candidate UnknownName
            (epsilon_expression_start expressionValue) scan))))))

; Superseded by D51: self expressions follow ordinary local lookup. This
; self-only fact path remains only until receiver normalization is implemented.
(def epsilon_local_scan_self_fact ((expressionValue EpsilonExpression)
  (active EpsilonLocalBindingList) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match (epsilon_local_find_self_binding active)
    (NoEpsilonSelfBinding scan)
    ((OneEpsilonSelfBinding bindingValue ownerDeclaration)
      (match ownerDeclaration
        ((EpsilonBoundaryDeclaration start end name machines) scan)
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          scan)
        ((EpsilonDataDeclaration start end ownerName members)
          (let selfType EpsilonType
            (EpsilonNamedType (epsilon_expression_start expressionValue)
              (epsilon_expression_end expressionValue) ownerName)
            (epsilon_local_scan_add_value expressionValue selfType
              (SomeEpsilonPlaceType selfType)
              (epsilon_local_scan_add_reference expressionValue bindingValue
                scan))))))))

(def epsilon_resolve_local_expression_list ((source Bytes)
  (expressions EpsilonExpressionList) (active EpsilonLocalBindingList)
  (pending EpsilonLocalBindingList) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match expressions
    (NoEpsilonExpressions scan)
    ((MoreEpsilonExpressions item rest)
      (epsilon_resolve_local_expression_list source rest active pending
        (epsilon_resolve_local_expression source item active pending scan)))))

(def epsilon_resolve_local_optional_expression ((source Bytes)
  (expressionValue EpsilonOptionalExpression)
  (active EpsilonLocalBindingList) (pending EpsilonLocalBindingList)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match expressionValue
    (NoEpsilonExpression scan)
    ((SomeEpsilonExpression item)
      (epsilon_resolve_local_expression source item active pending scan))))

(def epsilon_expression_i32_type ((expressionValue EpsilonExpression)) EpsilonType
  (EpsilonI32Type (epsilon_expression_start expressionValue)
    (epsilon_expression_end expressionValue)))

(def epsilon_expression_string_type ((expressionValue EpsilonExpression))
  EpsilonType
  (EpsilonViewType (epsilon_expression_start expressionValue)
    (epsilon_expression_end expressionValue)
    (EpsilonU8Type (epsilon_expression_start expressionValue)
      (epsilon_expression_end expressionValue))))

(def epsilon_expression_view_type ((expressionValue EpsilonExpression)
  (elementType EpsilonType)) EpsilonType
  (EpsilonViewType (epsilon_expression_start expressionValue)
    (epsilon_expression_end expressionValue) elementType))

(def epsilon_name_is_len ((source Bytes) (nameValue EpsilonName)) Int
  (match nameValue
    ((EpsilonNameSpan start end)
      (epsilon_span_is_3 source start end 108 101 110))))

(def epsilon_name_is_as_slice ((source Bytes) (nameValue EpsilonName)) Int
  (match nameValue
    ((EpsilonNameSpan start end)
      (epsilon_span_is_8 source start end 97 115 95 115 108 105 99 101))))

(def epsilon_name_is_contextual_field ((source Bytes) (nameValue EpsilonName)) Int
  (if (epsilon_name_is_len source nameValue)
    1
    (epsilon_name_is_as_slice source nameValue)))

(def epsilon_projected_place_type ((basePlace EpsilonOptionalPlaceType)
  (storageType EpsilonType)) EpsilonOptionalPlaceType
  (match basePlace
    (NoEpsilonPlaceType NoEpsilonPlaceType)
    ((SomeEpsilonPlaceType baseStorage)
      (SomeEpsilonPlaceType storageType))))

(def epsilon_local_scan_absent_field_candidate ((source Bytes)
  (expressionValue EpsilonExpression) (member EpsilonName)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (if (epsilon_name_is_contextual_field source member)
    (epsilon_local_scan_add_candidate TypeMismatch
      (epsilon_expression_start expressionValue) scan)
    (epsilon_local_scan_add_candidate UnknownName
      (epsilon_name_start member) scan)))

(def epsilon_local_scan_known_machine_field_candidate
  ((expressionValue EpsilonExpression) (useValue EpsilonExpressionUse)
   (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match useValue
    ((EpsilonTransitionContinuationExpressionUse machineValue continuationStart)
      (epsilon_local_scan_add_candidate InvalidControlTarget continuationStart
        scan))
    (EpsilonOrdinaryExpressionUse
      (epsilon_local_scan_add_candidate TypeMismatch
        (epsilon_expression_start expressionValue) scan))
    (EpsilonCallHeadExpressionUse
      (epsilon_local_scan_add_candidate TypeMismatch
        (epsilon_expression_start expressionValue) scan))
    ((EpsilonPostfixStatementExpressionUse statementStart)
      (epsilon_local_scan_add_candidate TypeMismatch
        statementStart scan))))

(def epsilon_local_scan_field_fact ((source Bytes)
  (expressionValue EpsilonExpression) (base EpsilonExpression)
  (member EpsilonName) (useValue EpsilonExpressionUse)
  (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (epsilon_find_expression_result base types)
        (NoEpsilonExpressionResult scan)
        ((OneEpsilonExpressionResult baseResult)
          (match baseResult
            ((EpsilonValueExpressionResult baseType basePlace)
              (match baseType
                ((EpsilonI32Type start end)
                  (epsilon_local_scan_absent_field_candidate source
                    expressionValue member scan))
                ((EpsilonU8Type start end)
                  (epsilon_local_scan_absent_field_candidate source
                    expressionValue member scan))
                ((EpsilonNeverType start end)
                  (epsilon_local_scan_absent_field_candidate source
                    expressionValue member scan))
                ((EpsilonNamedType start end ownerName)
                  (match catalog
                    ((EpsilonResolutionCatalogSyntax rows)
                      (match (epsilon_catalog_find_owner source ownerName rows)
                        (NoEpsilonCatalogOwner
                          (epsilon_local_scan_absent_field_candidate source
                            expressionValue member scan))
                        ((OneEpsilonCatalogBoundaryOwner ownerDeclaration)
                          (match ownerDeclaration
                            ((EpsilonBoundaryDeclaration ownerStart ownerEnd
                              ownerNameValue machines)
                              (match (epsilon_catalog_find_boundary_machine source
                                member machines)
                                (NoEpsilonCatalogBoundaryMember
                                  (epsilon_local_scan_absent_field_candidate
                                    source expressionValue member scan))
                                ((OneEpsilonCatalogBoundaryMember memberValue)
                                  (epsilon_local_scan_known_machine_field_candidate
                                    expressionValue useValue scan))))
                            ((EpsilonDataDeclaration ownerStart ownerEnd
                              ownerNameValue members) scan)
                            ((EpsilonMachineDeclaration ownerStart ownerEnd
                              machineName inputs returnType bodyValue) scan)))
                        ((OneEpsilonCatalogDataOwner ownerDeclaration shape)
                          (match ownerDeclaration
                            ((EpsilonBoundaryDeclaration ownerStart ownerEnd
                              ownerNameValue machines) scan)
                            ((EpsilonDataDeclaration ownerStart ownerEnd
                              ownerNameValue members)
                              (let memberLookup EpsilonCatalogDataMemberLookup
                                (epsilon_catalog_find_member_in_data source member
                                  ownerDeclaration members)
                                (match memberLookup
                                  ((OneEpsilonCatalogField ownerValue fieldValue)
                                    (match fieldValue
                                      ((EpsilonFieldMember fieldStart fieldEnd
                                        fieldName fieldType)
                                        (epsilon_local_scan_add_value
                                          expressionValue
                                          (epsilon_storage_read_type
                                            expressionValue fieldType)
                                          (epsilon_projected_place_type basePlace
                                            fieldType)
                                          (epsilon_local_scan_add_field_reference
                                            expressionValue ownerValue
                                            fieldValue scan)))
                                      ((EpsilonCaseMember fieldStart fieldEnd
                                        fieldName payload) scan)))
                                  ((OneEpsilonCatalogCase caseOwner caseValue)
                                    (epsilon_local_scan_add_candidate TypeMismatch
                                      (epsilon_expression_start expressionValue)
                                      scan))
                                  (NoEpsilonCatalogDataMember
                                    (match
                                      (epsilon_catalog_find_qualified_data_machine
                                        source ownerName member rows)
                                      ((OneEpsilonCatalogDataMachine machineOwner
                                        machineDeclaration)
                                        (epsilon_local_scan_known_machine_field_candidate
                                          expressionValue useValue scan))
                                      (NoEpsilonCatalogDataMachine
                                        (epsilon_local_scan_absent_field_candidate
                                          source expressionValue member
                                          scan)))))))
                            ((EpsilonMachineDeclaration ownerStart ownerEnd
                              machineName inputs returnType bodyValue)
                              scan)))))))
                ((EpsilonArrayType start end element lengthValue)
                  (if (epsilon_name_is_len source member)
                    (epsilon_local_scan_add_value expressionValue
                      (epsilon_expression_i32_type expressionValue)
                      NoEpsilonPlaceType scan)
                    (if (epsilon_name_is_as_slice source member)
                      (match basePlace
                        (NoEpsilonPlaceType
                          (epsilon_local_scan_add_candidate InvalidPlace
                            (epsilon_expression_start base) scan))
                        ((SomeEpsilonPlaceType storageType)
                          (epsilon_local_scan_add_value expressionValue
                            (epsilon_expression_view_type expressionValue element)
                            NoEpsilonPlaceType scan)))
                      (epsilon_local_scan_absent_field_candidate source
                        expressionValue member scan))))
                ((EpsilonViewType start end element)
                  (if (epsilon_name_is_len source member)
                    (epsilon_local_scan_add_value expressionValue
                      (epsilon_expression_i32_type expressionValue)
                      NoEpsilonPlaceType scan)
                    (if (epsilon_name_is_as_slice source member)
                      (epsilon_local_scan_add_candidate TypeMismatch
                        (epsilon_expression_start expressionValue) scan)
                      (epsilon_local_scan_absent_field_candidate source
                        expressionValue member scan))))))
            (EpsilonResultlessExpressionResult
              (epsilon_local_scan_add_candidate TypeMismatch
                (epsilon_expression_start expressionValue) scan))
            (EpsilonNeverExpressionResult
              (epsilon_local_scan_add_candidate InvalidTerminal
                (epsilon_expression_start (epsilon_call_head_core base))
                scan))))))))

; Named field-shaped call heads first belong to D36 receiver-machine
; resolution. Every non-named receiver and every complete category failure can
; use the one ordinary field classifier immediately; a positive field result
; is carried through authored groups so the following `()` remains a separate
; call suffix. Named no-machine branches fall back through the same classifier.
(def epsilon_local_scan_non_named_call_head_field_fact ((source Bytes)
  (callBase EpsilonExpression) (useValue EpsilonExpressionUse)
  (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match callBase
    ((EpsilonGroupedExpression start end inner)
      (match scan
        ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications
          types candidate)
          (match (epsilon_find_expression_result callBase types)
            ((OneEpsilonExpressionResult resultValue) scan)
            (NoEpsilonExpressionResult
              (epsilon_local_scan_propagate_result callBase inner
                (epsilon_local_scan_non_named_call_head_field_fact source inner
                  useValue scan)))))))
    ((EpsilonFieldExpression start end receiver member)
      (match scan
        ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications
          types candidate)
          (match (epsilon_find_expression_result receiver types)
            (NoEpsilonExpressionResult scan)
            ((OneEpsilonExpressionResult receiverResult)
              (match receiverResult
                ((EpsilonValueExpressionResult receiverType receiverPlace)
                  (match receiverType
                    ((EpsilonI32Type typeStart typeEnd)
                      (epsilon_local_scan_field_fact source callBase receiver
                        member useValue scan))
                    ((EpsilonU8Type typeStart typeEnd)
                      (epsilon_local_scan_field_fact source callBase receiver
                        member useValue scan))
                    ((EpsilonNeverType typeStart typeEnd)
                      (epsilon_local_scan_field_fact source callBase receiver
                        member useValue scan))
                    ((EpsilonNamedType typeStart typeEnd name) scan)
                    ((EpsilonArrayType typeStart typeEnd element lengthValue)
                      (epsilon_local_scan_field_fact source callBase receiver
                        member useValue scan))
                    ((EpsilonViewType typeStart typeEnd element)
                      (epsilon_local_scan_field_fact source callBase receiver
                        member useValue scan))))
                (EpsilonResultlessExpressionResult
                  (epsilon_local_scan_field_fact source callBase receiver member
                    useValue scan))
                (EpsilonNeverExpressionResult
                  (epsilon_local_scan_field_fact source callBase receiver member
                    useValue scan))))))))
    ((EpsilonIntegerExpression start end literal) scan)
    ((EpsilonCharacterExpression start end literal) scan)
    ((EpsilonStringExpression start end literal) scan)
    ((EpsilonTrueExpression start end) scan)
    ((EpsilonFalseExpression start end) scan)
    ((EpsilonSelfExpression start end) scan)
    ((EpsilonNameExpression start end name) scan)
    ((EpsilonQualifiedExpression start end owner name arguments) scan)
    ((EpsilonCallExpression start end base arguments) scan)
    ((EpsilonIndexExpression start end base indexValue) scan)
    ((EpsilonSliceExpression start end base low high) scan)
    ((EpsilonNegateExpression start end operand) scan)
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
      left right) scan)))

(def epsilon_local_scan_reject_value_call ((expressionValue EpsilonExpression)
  (base EpsilonExpression) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (epsilon_find_expression_result base types)
        (NoEpsilonExpressionResult scan)
        ((OneEpsilonExpressionResult resultValue)
          (match resultValue
            ((EpsilonValueExpressionResult typeValue placeType)
              (epsilon_local_scan_add_candidate TypeMismatch
                (epsilon_expression_start expressionValue) scan))
            (EpsilonResultlessExpressionResult
              (epsilon_local_scan_add_candidate TypeMismatch
                (epsilon_expression_start expressionValue) scan))
            (EpsilonNeverExpressionResult
              (epsilon_local_scan_add_candidate InvalidTerminal
                (epsilon_expression_start (epsilon_call_head_core base))
                scan))))))))

; Resultless and `never` are complete expression categories whose invalid use
; is independent of sibling premises. The relation anchor owns a resultless
; value-use mismatch, while a mispositioned `never` result remains anchored at
; the exact call beneath any grouping. Value-type and place relations stay in
; their enclosing joins and therefore wait for every fact they consume.
(def epsilon_local_scan_value_use_candidate
  ((expressionValue EpsilonExpression) (child EpsilonExpression)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (epsilon_find_expression_result child types)
        (NoEpsilonExpressionResult scan)
        ((OneEpsilonExpressionResult resultValue)
          (match resultValue
            ((EpsilonValueExpressionResult typeValue placeType) scan)
            (EpsilonResultlessExpressionResult
              (epsilon_local_scan_add_candidate TypeMismatch
                (epsilon_expression_start expressionValue) scan))
            (EpsilonNeverExpressionResult
              (epsilon_local_scan_add_candidate InvalidTerminal
                (epsilon_expression_start (epsilon_call_head_core child))
                scan))))))))

(def epsilon_local_scan_index_fact ((expressionValue EpsilonExpression)
  (base EpsilonExpression) (indexValue EpsilonExpression)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (let categoryScan EpsilonLocalResolutionScan
    (epsilon_local_scan_value_use_candidate expressionValue indexValue
      (epsilon_local_scan_value_use_candidate expressionValue base
        scan))
    (match categoryScan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (epsilon_find_expression_result base types)
        (NoEpsilonExpressionResult categoryScan)
        ((OneEpsilonExpressionResult baseResult)
          (match (epsilon_find_expression_result indexValue types)
            (NoEpsilonExpressionResult categoryScan)
            ((OneEpsilonExpressionResult indexResult)
              (match baseResult
                ((EpsilonValueExpressionResult baseType basePlace)
                  (match indexResult
                    ((EpsilonValueExpressionResult indexType indexPlace)
                      (if (epsilon_type_is_i32 indexType)
                        (match baseType
                          ((EpsilonI32Type start end)
                            (epsilon_local_scan_add_candidate TypeMismatch
                              (epsilon_expression_start expressionValue)
                              categoryScan))
                          ((EpsilonU8Type start end)
                            (epsilon_local_scan_add_candidate TypeMismatch
                              (epsilon_expression_start expressionValue)
                              categoryScan))
                          ((EpsilonNeverType start end)
                            (epsilon_local_scan_add_candidate TypeMismatch
                              (epsilon_expression_start expressionValue)
                              categoryScan))
                          ((EpsilonNamedType start end name)
                            (epsilon_local_scan_add_candidate TypeMismatch
                              (epsilon_expression_start expressionValue)
                              categoryScan))
                          ((EpsilonArrayType start end element lengthValue)
                            (epsilon_local_scan_add_value expressionValue
                              (epsilon_storage_read_type expressionValue element)
                              (epsilon_projected_place_type basePlace element)
                              categoryScan))
                          ((EpsilonViewType start end element)
                            (epsilon_local_scan_add_value expressionValue
                              (epsilon_storage_read_type expressionValue element)
                              NoEpsilonPlaceType categoryScan)))
                        (epsilon_local_scan_add_candidate TypeMismatch
                          (epsilon_expression_start expressionValue)
                          categoryScan)))
                    (EpsilonResultlessExpressionResult categoryScan)
                    (EpsilonNeverExpressionResult categoryScan)))
                (EpsilonResultlessExpressionResult categoryScan)
                (EpsilonNeverExpressionResult categoryScan))))))))))

(def epsilon_optional_bound_is_i32 ((bound EpsilonOptionalExpression)
  (types EpsilonTypedExpressionList)) Int
  (match bound
    (NoEpsilonExpression 1)
    ((SomeEpsilonExpression expressionValue)
      (match (epsilon_find_expression_result expressionValue types)
        (NoEpsilonExpressionResult 0)
        ((OneEpsilonExpressionResult resultValue)
          (match resultValue
            ((EpsilonValueExpressionResult typeValue placeType)
              (epsilon_type_is_i32 typeValue))
            (EpsilonResultlessExpressionResult 0)
            (EpsilonNeverExpressionResult 0)))))))

(def epsilon_optional_bound_has_value ((bound EpsilonOptionalExpression)
  (types EpsilonTypedExpressionList)) Int
  (match bound
    (NoEpsilonExpression 1)
    ((SomeEpsilonExpression expressionValue)
      (match (epsilon_find_expression_result expressionValue types)
        (NoEpsilonExpressionResult 0)
        ((OneEpsilonExpressionResult resultValue)
          (match resultValue
            ((EpsilonValueExpressionResult typeValue placeType) 1)
            (EpsilonResultlessExpressionResult 0)
            (EpsilonNeverExpressionResult 0)))))))

(def epsilon_local_scan_optional_value_use_candidate
  ((expressionValue EpsilonExpression) (bound EpsilonOptionalExpression)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match bound
    (NoEpsilonExpression scan)
    ((SomeEpsilonExpression child)
      (epsilon_local_scan_value_use_candidate expressionValue child
        scan))))

(def epsilon_local_scan_slice_fact ((expressionValue EpsilonExpression)
  (base EpsilonExpression) (low EpsilonOptionalExpression)
  (high EpsilonOptionalExpression) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (let categoryScan EpsilonLocalResolutionScan
    (epsilon_local_scan_optional_value_use_candidate expressionValue
      high
      (epsilon_local_scan_optional_value_use_candidate
        expressionValue low
        (epsilon_local_scan_value_use_candidate expressionValue base
          scan)))
    (match categoryScan
      ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
        candidate)
        (match (epsilon_find_expression_result base types)
          (NoEpsilonExpressionResult categoryScan)
          ((OneEpsilonExpressionResult baseResult)
            (match baseResult
              ((EpsilonValueExpressionResult baseType basePlace)
                (if (epsilon_optional_bound_has_value low types)
                  (if (epsilon_optional_bound_has_value high types)
                    (if (epsilon_optional_bound_is_i32 low types)
                      (if (epsilon_optional_bound_is_i32 high types)
                        (match baseType
                          ((EpsilonI32Type start end)
                            (epsilon_local_scan_add_candidate TypeMismatch
                              (epsilon_expression_start expressionValue)
                              categoryScan))
                          ((EpsilonU8Type start end)
                            (epsilon_local_scan_add_candidate TypeMismatch
                              (epsilon_expression_start expressionValue)
                              categoryScan))
                          ((EpsilonNeverType start end)
                            (epsilon_local_scan_add_candidate TypeMismatch
                              (epsilon_expression_start expressionValue)
                              categoryScan))
                          ((EpsilonNamedType start end name)
                            (epsilon_local_scan_add_candidate TypeMismatch
                              (epsilon_expression_start expressionValue)
                              categoryScan))
                          ((EpsilonArrayType start end element lengthValue)
                            (epsilon_local_scan_add_value expressionValue
                              (epsilon_expression_view_type expressionValue
                                element)
                              NoEpsilonPlaceType categoryScan))
                          ((EpsilonViewType start end element)
                            (epsilon_local_scan_add_value expressionValue
                              (epsilon_expression_view_type expressionValue
                                element)
                              NoEpsilonPlaceType categoryScan)))
                        (epsilon_local_scan_add_candidate TypeMismatch
                          (epsilon_expression_start expressionValue)
                          categoryScan))
                      (epsilon_local_scan_add_candidate TypeMismatch
                        (epsilon_expression_start expressionValue) categoryScan))
                    categoryScan)
                  categoryScan))
              (EpsilonResultlessExpressionResult categoryScan)
              (EpsilonNeverExpressionResult categoryScan))))))))

(def epsilon_local_scan_propagate_result ((expressionValue EpsilonExpression)
  (child EpsilonExpression) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (epsilon_find_expression_result child types)
        (NoEpsilonExpressionResult scan)
        ((OneEpsilonExpressionResult resultValue)
          (epsilon_local_scan_add_result expressionValue resultValue scan))))))

(def epsilon_local_scan_require_i32 ((expressionValue EpsilonExpression)
  (child EpsilonExpression) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (let categoryScan EpsilonLocalResolutionScan
    (epsilon_local_scan_value_use_candidate expressionValue child scan)
    (match categoryScan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (epsilon_find_expression_result child types)
        (NoEpsilonExpressionResult categoryScan)
        ((OneEpsilonExpressionResult resultValue)
          (match resultValue
            ((EpsilonValueExpressionResult typeValue placeType)
              (if (epsilon_type_is_i32 typeValue)
                (epsilon_local_scan_add_value expressionValue
                  (epsilon_expression_i32_type expressionValue)
                  NoEpsilonPlaceType categoryScan)
                (epsilon_local_scan_add_candidate TypeMismatch
                  (epsilon_expression_start expressionValue) categoryScan)))
            (EpsilonResultlessExpressionResult categoryScan)
            (EpsilonNeverExpressionResult categoryScan))))))))

(def epsilon_local_scan_binary_i32 ((expressionValue EpsilonExpression)
  (left EpsilonExpression) (right EpsilonExpression)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (let categoryScan EpsilonLocalResolutionScan
    (epsilon_local_scan_value_use_candidate expressionValue right
      (epsilon_local_scan_value_use_candidate expressionValue left scan))
    (match categoryScan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (epsilon_find_expression_result left types)
        (NoEpsilonExpressionResult categoryScan)
        ((OneEpsilonExpressionResult leftResult)
          (match (epsilon_find_expression_result right types)
            (NoEpsilonExpressionResult categoryScan)
            ((OneEpsilonExpressionResult rightResult)
              (match leftResult
                ((EpsilonValueExpressionResult leftType leftPlace)
                  (match rightResult
                    ((EpsilonValueExpressionResult rightType rightPlace)
                      (if (epsilon_type_is_i32 leftType)
                        (if (epsilon_type_is_i32 rightType)
                          (epsilon_local_scan_add_value expressionValue
                            (epsilon_expression_i32_type expressionValue)
                            NoEpsilonPlaceType categoryScan)
                          (epsilon_local_scan_add_candidate TypeMismatch
                            (epsilon_expression_start expressionValue)
                            categoryScan))
                        (epsilon_local_scan_add_candidate TypeMismatch
                          (epsilon_expression_start expressionValue)
                          categoryScan)))
                    (EpsilonResultlessExpressionResult categoryScan)
                    (EpsilonNeverExpressionResult categoryScan)))
                (EpsilonResultlessExpressionResult categoryScan)
                (EpsilonNeverExpressionResult categoryScan))))))))))

(def epsilon_expression_use_resolves_local_value ((useValue EpsilonExpressionUse))
  Int
  (match useValue
    (EpsilonOrdinaryExpressionUse 1)
    (EpsilonCallHeadExpressionUse 0)
    ((EpsilonPostfixStatementExpressionUse statementStart) 1)
    ((EpsilonTransitionContinuationExpressionUse machineValue continuationStart)
      1)))

; Every nested operand, argument, receiver, index, and bound is an ordinary
; value position. Only the exact outer name/selector retains the grammar-
; selected call, statement, or continuation namespace.
(def epsilon_resolve_local_expression_context ((source Bytes)
  (expressionValue EpsilonExpression) (active EpsilonLocalBindingList)
  (pending EpsilonLocalBindingList) (scan EpsilonLocalResolutionScan)
  (useValue EpsilonExpressionUse))
  EpsilonLocalResolutionScan
  (match expressionValue
    ((EpsilonIntegerExpression start end literal)
      (epsilon_local_scan_add_value expressionValue
        (epsilon_expression_i32_type expressionValue) NoEpsilonPlaceType scan))
    ((EpsilonCharacterExpression start end literal)
      (epsilon_local_scan_add_value expressionValue
        (epsilon_expression_i32_type expressionValue) NoEpsilonPlaceType scan))
    ((EpsilonStringExpression start end literal)
      (epsilon_local_scan_add_value expressionValue
        (epsilon_expression_string_type expressionValue) NoEpsilonPlaceType scan))
    ((EpsilonTrueExpression start end)
      (epsilon_local_scan_add_value expressionValue
        (epsilon_expression_i32_type expressionValue) NoEpsilonPlaceType scan))
    ((EpsilonFalseExpression start end)
      (epsilon_local_scan_add_value expressionValue
        (epsilon_expression_i32_type expressionValue) NoEpsilonPlaceType scan))
    ((EpsilonSelfExpression start end)
      (epsilon_local_scan_self_fact expressionValue active scan))
    ((EpsilonNameExpression start end name)
      (match useValue
        ((EpsilonPostfixStatementExpressionUse statementStart)
          (epsilon_resolve_local_postfix_statement_name source expressionValue
            name statementStart active pending scan))
        (EpsilonOrdinaryExpressionUse
          (epsilon_resolve_local_value_name source expressionValue name active
            pending scan))
        (EpsilonCallHeadExpressionUse scan)
        ((EpsilonTransitionContinuationExpressionUse machineValue
          continuationStart)
          (epsilon_local_scan_transition_bare_name source expressionValue name
            active pending machineValue continuationStart scan))))
    ((EpsilonQualifiedExpression start end owner name arguments)
      (match arguments
        (NoEpsilonArguments
          (epsilon_local_scan_qualified_callable_fact source expressionValue
            owner name arguments useValue scan))
        ((SomeEpsilonArguments openStart closeEnd values)
          (let argumentScan EpsilonLocalResolutionScan
            (epsilon_local_scan_argument_terminal_candidates values
              (epsilon_resolve_local_expression_list source values active pending
                scan))
            (epsilon_local_scan_qualified_callable_fact source expressionValue
              owner name arguments useValue argumentScan)))))
    ((EpsilonGroupedExpression start end inner)
      (epsilon_local_scan_propagate_result expressionValue inner
        (epsilon_resolve_local_expression_context source inner active pending
          scan useValue)))
    ((EpsilonFieldExpression start end base member)
      (let nextScan EpsilonLocalResolutionScan
        (epsilon_resolve_local_expression source base active pending scan)
        (if (epsilon_expression_use_resolves_local_value useValue)
          (epsilon_local_scan_field_fact source expressionValue base member
            useValue nextScan)
          nextScan)))
    ((EpsilonCallExpression start end base arguments)
      (let childScan EpsilonLocalResolutionScan
        (epsilon_resolve_local_expression_list source arguments active pending
          (epsilon_resolve_local_expression_context source base active pending
            scan EpsilonCallHeadExpressionUse))
        (let argumentScan EpsilonLocalResolutionScan
          (epsilon_local_scan_argument_terminal_candidates arguments childScan)
          (let contextualScan EpsilonLocalResolutionScan
            (epsilon_local_scan_non_named_call_head_field_fact source base
              useValue argumentScan)
          (let receiverScan EpsilonLocalResolutionScan
            (epsilon_local_scan_receiver_application source expressionValue base
              arguments useValue contextualScan)
            (let qualifiedScan EpsilonLocalResolutionScan
              (epsilon_local_scan_qualified_head_application source
                expressionValue base arguments useValue receiverScan)
              (match useValue
                ((EpsilonTransitionContinuationExpressionUse machineValue
                  continuationStart)
                  (epsilon_local_scan_transition_unqualified_application source
                    expressionValue base arguments active pending machineValue
                    continuationStart qualifiedScan))
                (EpsilonOrdinaryExpressionUse
                  (epsilon_local_scan_unqualified_machine_application source
                    expressionValue base arguments active pending useValue
                    (epsilon_local_scan_reject_value_call expressionValue base
                      qualifiedScan)))
                (EpsilonCallHeadExpressionUse
                  (epsilon_local_scan_unqualified_machine_application source
                    expressionValue base arguments active pending useValue
                    (epsilon_local_scan_reject_value_call expressionValue base
                      qualifiedScan)))
                ((EpsilonPostfixStatementExpressionUse statementStart)
                  (epsilon_local_scan_unqualified_machine_application source
                    expressionValue base arguments active pending useValue
                    (epsilon_local_scan_reject_value_call expressionValue base
                      qualifiedScan))))))))))
    ((EpsilonIndexExpression start end base indexValue)
      (epsilon_local_scan_index_fact expressionValue base indexValue
        (epsilon_resolve_local_expression source indexValue active pending
          (epsilon_resolve_local_expression source base active pending scan))))
    ((EpsilonSliceExpression start end base low high)
      (epsilon_local_scan_slice_fact expressionValue base low high
        (epsilon_resolve_local_optional_expression source high active pending
          (epsilon_resolve_local_optional_expression source low active pending
            (epsilon_resolve_local_expression source base active pending
              scan)))))
    ((EpsilonNegateExpression start end operand)
      (epsilon_local_scan_require_i32 expressionValue operand
        (epsilon_resolve_local_expression source operand active pending scan)))
    ((EpsilonBinaryExpression start end operatorValue operatorStart operatorEnd
      left right)
      (epsilon_local_scan_binary_i32 expressionValue left right
        (epsilon_resolve_local_expression source right active pending
          (epsilon_resolve_local_expression source left active pending scan))))))

(def epsilon_resolve_local_expression ((source Bytes)
  (expressionValue EpsilonExpression) (active EpsilonLocalBindingList)
  (pending EpsilonLocalBindingList) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (epsilon_resolve_local_expression_context source expressionValue active
    pending scan EpsilonOrdinaryExpressionUse))

(def epsilon_expression_has_authored_application
  ((expressionValue EpsilonExpression)) Int
  (match (epsilon_call_head_core expressionValue)
    ((EpsilonQualifiedExpression start end owner name argumentsValue)
      (match argumentsValue
        (NoEpsilonArguments 0)
        ((SomeEpsilonArguments openStart closeEnd values) 1)))
    ((EpsilonCallExpression start end base arguments) 1)
    ((EpsilonIntegerExpression start end literal) 0)
    ((EpsilonCharacterExpression start end literal) 0)
    ((EpsilonStringExpression start end literal) 0)
    ((EpsilonTrueExpression start end) 0)
    ((EpsilonFalseExpression start end) 0)
    ((EpsilonSelfExpression start end) 0)
    ((EpsilonNameExpression start end name) 0)
    ((EpsilonGroupedExpression start end inner) 0)
    ((EpsilonFieldExpression start end base field) 0)
    ((EpsilonIndexExpression start end base indexValue) 0)
    ((EpsilonSliceExpression start end base low high) 0)
    ((EpsilonNegateExpression start end operand) 0)
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd
      left right) 0)))

; A discarded postfix statement admits only an exact resolved machine
; application. Custody plus authored application shape establishes category
; before arity/type completion: a failed admitted machine therefore receives no
; dependent statement mismatch. Successful value/resultless results are
; discardable, and a successful `never` result is retained for later block flow.
(def epsilon_local_scan_postfix_statement_admission
  ((expressionValue EpsilonExpression) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
      candidate)
      (match (epsilon_find_resolved_callable_reference_normalized expressionValue
        callables)
        ((OneEpsilonResolvedCallableReference callable)
          (match callable
            ((EpsilonResolvedConstructorCallable ownerDeclaration caseValue)
              (epsilon_local_scan_add_candidate TypeMismatch
                (epsilon_expression_start expressionValue) scan))
            ((EpsilonResolvedDataMachineCallable ownerDeclaration
              machineDeclaration)
              (if (epsilon_expression_has_authored_application expressionValue)
                scan
                (epsilon_local_scan_add_candidate TypeMismatch
                  (epsilon_expression_start expressionValue) scan)))
            ((EpsilonResolvedUnqualifiedMachineCallable machineDeclaration)
              (if (epsilon_expression_has_authored_application expressionValue)
                scan
                (epsilon_local_scan_add_candidate TypeMismatch
                  (epsilon_expression_start expressionValue) scan)))
            ((EpsilonResolvedBoundaryMachineCallable ownerDeclaration memberValue)
              (if (epsilon_expression_has_authored_application expressionValue)
                scan
                (epsilon_local_scan_add_candidate TypeMismatch
                  (epsilon_expression_start expressionValue) scan)))))
        (NoEpsilonResolvedCallableReference
          (match (epsilon_find_expression_result expressionValue types)
            (NoEpsilonExpressionResult scan)
            ((OneEpsilonExpressionResult resultValue)
              (match resultValue
                ((EpsilonValueExpressionResult typeValue placeType)
                  (epsilon_local_scan_add_candidate TypeMismatch
                    (epsilon_expression_start expressionValue) scan))
                (EpsilonResultlessExpressionResult scan)
                (EpsilonNeverExpressionResult scan)))))))))

(def epsilon_resolve_local_postfix_statement_expression ((source Bytes)
  (expressionValue EpsilonExpression) (active EpsilonLocalBindingList)
  (pending EpsilonLocalBindingList) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (epsilon_local_scan_postfix_statement_admission expressionValue
    (epsilon_resolve_local_expression_context source expressionValue active
      pending scan
        (EpsilonPostfixStatementExpressionUse
          (epsilon_expression_start expressionValue)))))

(def epsilon_resolve_local_transition_continuation_expression ((source Bytes)
  (expressionValue EpsilonExpression) (active EpsilonLocalBindingList)
  (machineValue EpsilonDeclaration) (continuationStart Int)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (epsilon_local_scan_transition_admission expressionValue continuationStart
    (epsilon_resolve_local_expression_context source expressionValue active
      NoEpsilonLocalBindings scan
      (EpsilonTransitionContinuationExpressionUse machineValue
        continuationStart))))

; A statement value relation first consumes a complete value category, then
; compares its type. Category failures remain independent of the comparison;
; an unresolved child manufactures neither a mismatch nor an error type.
(def epsilon_local_scan_statement_value_type_relation ((source Bytes)
  (expressionValue EpsilonExpression) (expectedType EpsilonType)
  (storedEstablishment Int) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (let categoryScan EpsilonLocalResolutionScan
    (epsilon_local_scan_value_use_candidate expressionValue expressionValue scan)
    (match categoryScan
      ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
        candidate)
        (match (epsilon_find_expression_result expressionValue types)
          (NoEpsilonExpressionResult categoryScan)
          ((OneEpsilonExpressionResult resultValue)
            (match resultValue
              ((EpsilonValueExpressionResult actualType placeType)
                (if (epsilon_argument_value_type_compatible source actualType
                  expectedType storedEstablishment)
                  categoryScan
                  (epsilon_local_scan_add_candidate TypeMismatch
                    (epsilon_expression_start expressionValue) categoryScan)))
              (EpsilonResultlessExpressionResult categoryScan)
              (EpsilonNeverExpressionResult categoryScan))))))))

; Assignment place admission consumes only a complete value result. The
; retained place type is the storage type (not the zero-extended read type),
; which is required for the later assignment value join and `u8` establishment.
(def epsilon_local_scan_statement_place_relation
  ((placeValue EpsilonExpression) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (let categoryScan EpsilonLocalResolutionScan
    (epsilon_local_scan_value_use_candidate placeValue placeValue scan)
    (match categoryScan
      ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
        candidate)
        (match (epsilon_find_expression_result placeValue types)
          (NoEpsilonExpressionResult categoryScan)
          ((OneEpsilonExpressionResult resultValue)
            (match resultValue
              ((EpsilonValueExpressionResult valueType placeType)
                (match placeType
                  (NoEpsilonPlaceType
                    (epsilon_local_scan_add_candidate InvalidPlace
                      (epsilon_expression_start placeValue) categoryScan))
                  ((SomeEpsilonPlaceType storageType) categoryScan)))
              (EpsilonResultlessExpressionResult categoryScan)
              (EpsilonNeverExpressionResult categoryScan))))))))

; The assignment type relation consumes both a valid left place and a complete
; right value. It therefore cannot derive a second failure from a missing or
; non-place left premise, while the right-side category branch is still kept.
(def epsilon_local_scan_assignment_relation ((source Bytes)
  (placeValue EpsilonExpression) (assignedValue EpsilonExpression)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (let categoryScan EpsilonLocalResolutionScan
    (epsilon_local_scan_value_use_candidate assignedValue assignedValue
      (epsilon_local_scan_statement_place_relation placeValue scan))
    (match categoryScan
      ((EpsilonLocalResolutionScanSyntax catalog references fields callables stateApplications types
        candidate)
        (match (epsilon_find_expression_result placeValue types)
          (NoEpsilonExpressionResult categoryScan)
          ((OneEpsilonExpressionResult placeResult)
            (match placeResult
              ((EpsilonValueExpressionResult readType placeType)
                (match placeType
                  (NoEpsilonPlaceType categoryScan)
                  ((SomeEpsilonPlaceType storageType)
                    (match (epsilon_find_expression_result assignedValue types)
                      (NoEpsilonExpressionResult categoryScan)
                      ((OneEpsilonExpressionResult assignedResult)
                        (match assignedResult
                          ((EpsilonValueExpressionResult assignedType
                            assignedPlace)
                            (if (epsilon_argument_value_type_compatible source
                              assignedType storageType 1)
                              categoryScan
                              (epsilon_local_scan_add_candidate TypeMismatch
                                (epsilon_expression_start assignedValue)
                                categoryScan)))
                          (EpsilonResultlessExpressionResult categoryScan)
                          (EpsilonNeverExpressionResult categoryScan)))))))
              (EpsilonResultlessExpressionResult categoryScan)
              (EpsilonNeverExpressionResult categoryScan))))))))

(def epsilon_resolve_local_statement_expressions ((source Bytes)
  (statementValue EpsilonStatement) (active EpsilonLocalBindingList)
  (pending EpsilonLocalBindingList) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match statementValue
    ((EpsilonLetStatement start end name typeValue initializer)
      (epsilon_local_scan_statement_value_type_relation source initializer
        typeValue 0
        (epsilon_resolve_local_expression source initializer active pending
          scan)))
    ((EpsilonAssignmentStatement start end placeValue assignedValue)
      (epsilon_local_scan_assignment_relation source placeValue assignedValue
        (epsilon_resolve_local_expression source assignedValue active pending
          (epsilon_resolve_local_expression source placeValue active pending
            scan))))
    ((EpsilonPostfixStatement start end expressionValue)
      (epsilon_resolve_local_postfix_statement_expression source expressionValue
        active pending scan))
    ((EpsilonAssertStatement start end expressionValue)
      (epsilon_local_scan_statement_value_type_relation source expressionValue
        (epsilon_expression_i32_type expressionValue) 0
        (epsilon_resolve_local_expression source expressionValue active pending
          scan)))))

(def epsilon_local_activate_statement ((statementValue EpsilonStatement)
  (active EpsilonLocalBindingList)) EpsilonLocalBindingList
  (match statementValue
    ((EpsilonLetStatement start end name typeValue initializer)
      (MoreEpsilonLocalBindings
        (EpsilonLetLocal name typeValue statementValue) active))
    ((EpsilonAssignmentStatement start end placeValue assignedValue) active)
    ((EpsilonPostfixStatement start end expressionValue) active)
    ((EpsilonAssertStatement start end expressionValue) active)))

(def epsilon_local_pending_after_statement ((source Bytes)
  (statementValue EpsilonStatement) (pending EpsilonLocalBindingList))
  EpsilonLocalBindingList
  (match statementValue
    ((EpsilonLetStatement start end name typeValue initializer)
      (epsilon_remove_pending_binding source name pending))
    ((EpsilonAssignmentStatement start end placeValue assignedValue) pending)
    ((EpsilonPostfixStatement start end expressionValue) pending)
    ((EpsilonAssertStatement start end expressionValue) pending)))

(def epsilon_statement_start ((statementValue EpsilonStatement)) Int
  (match statementValue
    ((EpsilonLetStatement start end name typeValue initializer) start)
    ((EpsilonAssignmentStatement start end placeValue assignedValue) start)
    ((EpsilonPostfixStatement start end expressionValue) start)
    ((EpsilonAssertStatement start end expressionValue) start)))

; Superseded by D53: a successful `never` statement ends local block flow, and
; the first later executable statement or terminal anchors InvalidTerminal at
; its terminating delimiter. The final pass still visits every authored child
; but admits no later construct's block-exit parent relation.
(def epsilon_local_scan_statement_after_never
  ((statementValue EpsilonStatement) (flow EpsilonStatementFlow)
   (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match flow
    (EpsilonStatementFlowOpen scan)
    (EpsilonStatementFlowEndedByNever
      (epsilon_local_scan_add_candidate InvalidTerminal
        (epsilon_statement_start statementValue) scan))
    (EpsilonStatementFlowInvalidAfterNever scan)))

(def epsilon_statement_flow_after ((statementValue EpsilonStatement)
  (flow EpsilonStatementFlow) (scan EpsilonLocalResolutionScan))
  EpsilonStatementFlow
  (match flow
    (EpsilonStatementFlowEndedByNever EpsilonStatementFlowInvalidAfterNever)
    (EpsilonStatementFlowInvalidAfterNever EpsilonStatementFlowInvalidAfterNever)
    (EpsilonStatementFlowOpen
      (match statementValue
        ((EpsilonLetStatement start end name typeValue initializer)
          EpsilonStatementFlowOpen)
        ((EpsilonAssignmentStatement start end placeValue assignedValue)
          EpsilonStatementFlowOpen)
        ((EpsilonAssertStatement start end expressionValue)
          EpsilonStatementFlowOpen)
        ((EpsilonPostfixStatement start end expressionValue)
          (match scan
            ((EpsilonLocalResolutionScanSyntax catalog references fields
              callables stateApplications types candidate)
              (match (epsilon_find_expression_result expressionValue types)
                (NoEpsilonExpressionResult EpsilonStatementFlowOpen)
                ((OneEpsilonExpressionResult resultValue)
                  (match resultValue
                    ((EpsilonValueExpressionResult typeValue placeType)
                      EpsilonStatementFlowOpen)
                    (EpsilonResultlessExpressionResult EpsilonStatementFlowOpen)
                    (EpsilonNeverExpressionResult
                      EpsilonStatementFlowEndedByNever)))))))))))

(def epsilon_resolve_local_statements_with_flow ((source Bytes)
  (statements EpsilonStatementList) (active EpsilonLocalBindingList)
  (pending EpsilonLocalBindingList) (flow EpsilonStatementFlow)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalBlockScan
  (match statements
    (NoEpsilonStatements
      (EpsilonLocalBlockScanSyntax active pending scan))
    ((MoreEpsilonStatements item rest)
      (let candidateScan EpsilonLocalResolutionScan
        (epsilon_local_scan_statement_after_never item flow scan)
        (let expressionScan EpsilonLocalResolutionScan
          (epsilon_resolve_local_statement_expressions source item active pending
            candidateScan)
          (epsilon_resolve_local_statements_with_flow source rest
            (epsilon_local_activate_statement item active)
            (epsilon_local_pending_after_statement source item pending)
            (epsilon_statement_flow_after item flow expressionScan)
            expressionScan))))))

(def epsilon_resolve_local_statements ((source Bytes)
  (statements EpsilonStatementList) (active EpsilonLocalBindingList)
  (pending EpsilonLocalBindingList) (scan EpsilonLocalResolutionScan))
  EpsilonLocalBlockScan
  (epsilon_resolve_local_statements_with_flow source statements active pending
    EpsilonStatementFlowOpen scan))

; An explicit return is a relation against the enclosing machine signature.
; A resultless machine admits only `return;`. A value-returning machine
; requires an authored value, while a `never` machine admits no normal return;
; either kind's absent value is anchored at `return`. When a value is present,
; the ordinary D37 value-use branch retains resultless/never category failures
; independently before the type join.
(def epsilon_local_scan_return_relation ((source Bytes) (returnStart Int)
  (expressionValue EpsilonOptionalExpression) (returnType EpsilonOptionalType)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match returnType
    (NoEpsilonType
      (match expressionValue
        (NoEpsilonExpression scan)
        ((SomeEpsilonExpression item)
          (let categoryScan EpsilonLocalResolutionScan
            (epsilon_local_scan_value_use_candidate item item scan)
            (match categoryScan
              ((EpsilonLocalResolutionScanSyntax catalog references fields
                callables stateApplications types candidate)
                (match (epsilon_find_expression_result item types)
                  (NoEpsilonExpressionResult categoryScan)
                  ((OneEpsilonExpressionResult resultValue)
                    (match resultValue
                      ((EpsilonValueExpressionResult actualType placeType)
                        (epsilon_local_scan_add_candidate TypeMismatch
                          (epsilon_expression_start item) categoryScan))
                      (EpsilonResultlessExpressionResult categoryScan)
                      (EpsilonNeverExpressionResult categoryScan))))))))))
    ((SomeEpsilonType typeStart typeEnd expectedType)
      (match expressionValue
        (NoEpsilonExpression
          (epsilon_local_scan_add_candidate TypeMismatch returnStart scan))
        ((SomeEpsilonExpression item)
          (epsilon_local_scan_statement_value_type_relation source item
            expectedType 0 scan))))))

(def epsilon_local_scan_named_transition_subject ((source Bytes)
  (terminalValue EpsilonTerminal) (subject EpsilonExpression) (name EpsilonName)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match catalog
        ((EpsilonResolutionCatalogSyntax rows)
          (match (epsilon_catalog_find_owner source name rows)
            (NoEpsilonCatalogOwner scan)
            ((OneEpsilonCatalogBoundaryOwner ownerValue)
              (epsilon_local_scan_add_candidate TypeMismatch
                (epsilon_expression_start subject) scan))
            ((OneEpsilonCatalogDataOwner ownerValue shape)
              (match shape
                (EpsilonRecordShape
                  (epsilon_local_scan_add_candidate TypeMismatch
                    (epsilon_expression_start subject) scan))
                (EpsilonSumShape
                  (epsilon_local_scan_add_transition_subject terminalValue
                    (EpsilonSumTransitionSubject ownerValue) scan))))))))))

(def epsilon_local_scan_transition_subject ((source Bytes)
  (terminalValue EpsilonTerminal) (subject EpsilonExpression)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (let categoryScan EpsilonLocalResolutionScan
    (epsilon_local_scan_value_use_candidate subject subject scan)
    (match categoryScan
      ((EpsilonLocalResolutionScanSyntax catalog references fields callables
        control types candidate)
        (match (epsilon_find_expression_result subject types)
          (NoEpsilonExpressionResult categoryScan)
          ((OneEpsilonExpressionResult resultValue)
            (match resultValue
              (EpsilonResultlessExpressionResult categoryScan)
              (EpsilonNeverExpressionResult categoryScan)
              ((EpsilonValueExpressionResult typeValue placeType)
                (match typeValue
                  ((EpsilonI32Type start end)
                    (epsilon_local_scan_add_transition_subject terminalValue
                      EpsilonScalarTransitionSubject categoryScan))
                  ((EpsilonNamedType start end name)
                    (epsilon_local_scan_named_transition_subject source
                      terminalValue subject name categoryScan))
                  ((EpsilonU8Type start end)
                    (epsilon_local_scan_add_candidate TypeMismatch
                      (epsilon_expression_start subject) categoryScan))
                  ((EpsilonNeverType start end)
                    (epsilon_local_scan_add_candidate TypeMismatch
                      (epsilon_expression_start subject) categoryScan))
                  ((EpsilonArrayType start end element lengthValue)
                    (epsilon_local_scan_add_candidate TypeMismatch
                      (epsilon_expression_start subject) categoryScan))
                  ((EpsilonViewType start end element)
                    (epsilon_local_scan_add_candidate TypeMismatch
                      (epsilon_expression_start subject) categoryScan)))))))))))

(def epsilon_local_scan_scalar_transition_pattern ((terminalValue EpsilonTerminal)
  (patternValue EpsilonPattern) (selector Int)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match (epsilon_control_find_transition_subject terminalValue control)
        (NoEpsilonTransitionSubjectReference
          (epsilon_local_scan_add_transition_pattern terminalValue patternValue
            (EpsilonScalarPatternSelector selector)
            EpsilonTransitionPatternResolved scan))
        ((OneEpsilonTransitionSubjectReference subjectKind)
          (match subjectKind
            (EpsilonScalarTransitionSubject
              (epsilon_local_scan_add_transition_pattern terminalValue patternValue
                (EpsilonScalarPatternSelector selector)
                EpsilonTransitionPatternComplete scan))
            ((EpsilonSumTransitionSubject ownerValue)
              (epsilon_local_scan_add_transition_pattern terminalValue patternValue
                (EpsilonScalarPatternSelector selector)
                EpsilonTransitionPatternResolved scan))))))))

(def epsilon_local_scan_wildcard_transition_pattern
  ((terminalValue EpsilonTerminal) (patternValue EpsilonPattern)
   (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match (epsilon_control_find_transition_subject terminalValue control)
        (NoEpsilonTransitionSubjectReference
          (epsilon_local_scan_add_transition_pattern terminalValue patternValue
            EpsilonTransitionWildcard EpsilonTransitionPatternResolved scan))
        ((OneEpsilonTransitionSubjectReference subjectKind)
          (epsilon_local_scan_add_transition_pattern terminalValue patternValue
            EpsilonTransitionWildcard EpsilonTransitionPatternComplete scan))))))

(def epsilon_local_scan_resolved_case_transition_pattern ((source Bytes)
  (terminalValue EpsilonTerminal) (patternValue EpsilonPattern)
  (binder EpsilonOptionalBinder) (ownerValue EpsilonDeclaration)
  (caseValue EpsilonDataMember) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (let kind EpsilonTransitionPatternKind (EpsilonSumCasePattern ownerValue caseValue)
    (if (eq (epsilon_optional_binder_count binder)
      (epsilon_parameter_list_count (epsilon_constructor_parameters caseValue)))
      (match scan
        ((EpsilonLocalResolutionScanSyntax catalog references fields callables
          control types candidate)
          (match (epsilon_control_find_transition_subject terminalValue control)
            (NoEpsilonTransitionSubjectReference
              (epsilon_local_scan_add_transition_pattern terminalValue patternValue kind
                EpsilonTransitionPatternResolved scan))
            ((OneEpsilonTransitionSubjectReference subjectKind)
              (match subjectKind
                (EpsilonScalarTransitionSubject
                  (epsilon_local_scan_add_transition_pattern terminalValue patternValue kind
                    EpsilonTransitionPatternResolved scan))
                ((EpsilonSumTransitionSubject subjectOwner)
                  (if (epsilon_data_declarations_same_identity subjectOwner
                    ownerValue)
                    (epsilon_local_scan_add_transition_pattern terminalValue patternValue kind
                      EpsilonTransitionPatternComplete scan)
                    (epsilon_local_scan_add_transition_pattern terminalValue patternValue kind
                      EpsilonTransitionPatternResolved scan))))))))
      (epsilon_local_scan_add_transition_pattern terminalValue patternValue kind
        EpsilonTransitionPatternResolved scan))))

(def epsilon_local_scan_case_transition_pattern ((source Bytes)
  (terminalValue EpsilonTerminal) (patternValue EpsilonPattern)
  (owner EpsilonName) (name EpsilonName) (binder EpsilonOptionalBinder)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match catalog
        ((EpsilonResolutionCatalogSyntax rows)
          (match (epsilon_catalog_find_owner source owner rows)
            (NoEpsilonCatalogOwner
              (epsilon_local_scan_add_candidate UnknownName
                (epsilon_name_start owner) scan))
            ((OneEpsilonCatalogBoundaryOwner ownerValue)
              scan)
            ((OneEpsilonCatalogDataOwner ownerValue shape)
              (match shape
                (EpsilonRecordShape
                  scan)
                (EpsilonSumShape
                  (match (epsilon_catalog_find_data_member source owner name rows)
                    (NoEpsilonCatalogDataMember
                      (epsilon_local_scan_add_candidate UnknownName
                        (epsilon_name_start name) scan))
                    ((OneEpsilonCatalogField fieldOwner fieldValue)
                      scan)
                    ((OneEpsilonCatalogCase caseOwner caseValue)
                      (epsilon_local_scan_resolved_case_transition_pattern source
                        terminalValue patternValue binder caseOwner caseValue
                        scan))))))))))))

(def epsilon_local_scan_transition_pattern ((source Bytes)
  (terminalValue EpsilonTerminal) (patternValue EpsilonPattern)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match patternValue
    ((EpsilonIntegerPattern start end literal)
      (epsilon_local_scan_scalar_transition_pattern terminalValue patternValue
        (epsilon_integer_literal_value literal) scan))
    ((EpsilonTruePattern start end)
      (epsilon_local_scan_scalar_transition_pattern terminalValue patternValue 1
        scan))
    ((EpsilonFalsePattern start end)
      (epsilon_local_scan_scalar_transition_pattern terminalValue patternValue 0
        scan))
    ((EpsilonWildcardPattern start end)
      (epsilon_local_scan_wildcard_transition_pattern terminalValue patternValue
        scan))
    ((EpsilonCasePattern start end owner name binder)
      (epsilon_local_scan_case_transition_pattern source terminalValue
        patternValue owner name binder scan))))

(def epsilon_pattern_is_wildcard ((patternValue EpsilonPattern)) Int
  (match patternValue
    ((EpsilonIntegerPattern start end literal) 0)
    ((EpsilonTruePattern start end) 0)
    ((EpsilonFalsePattern start end) 0)
    ((EpsilonWildcardPattern start end) 1)
    ((EpsilonCasePattern start end owner name binder) 0)))

(def epsilon_arms_have_nonfinal_wildcard ((arms EpsilonArmList)) Int
  (match arms
    (NoEpsilonArms 0)
    ((MoreEpsilonArms item rest)
      (match item
        ((EpsilonArmSyntax start end patternValue continuation)
          (if (epsilon_pattern_is_wildcard patternValue)
            (match rest
              (NoEpsilonArms 0)
              ((MoreEpsilonArms nextItem nextRest) 1))
            (epsilon_arms_have_nonfinal_wildcard rest)))))))

(def epsilon_arms_have_final_wildcard ((arms EpsilonArmList)) Int
  (match arms
    (NoEpsilonArms 0)
    ((MoreEpsilonArms item rest)
      (match rest
        (NoEpsilonArms
          (match item
            ((EpsilonArmSyntax start end patternValue continuation)
              (epsilon_pattern_is_wildcard patternValue))))
        ((MoreEpsilonArms nextItem nextRest)
          (epsilon_arms_have_final_wildcard rest))))))

(def epsilon_arms_have_complete_patterns ((arms EpsilonArmList)
  (control EpsilonControlReferenceLedger)) Int
  (match arms
    (NoEpsilonArms 1)
    ((MoreEpsilonArms item rest)
      (match item
        ((EpsilonArmSyntax start end patternValue continuation)
          (match (epsilon_control_find_transition_pattern patternValue control)
            (NoEpsilonTransitionPatternReference 0)
            ((OneEpsilonTransitionPatternReference kind progress)
              (match progress
                (EpsilonTransitionPatternResolved 0)
                (EpsilonTransitionPatternComplete
                  (epsilon_arms_have_complete_patterns rest control))))))))))

(def epsilon_transition_case_is_covered ((terminalValue EpsilonTerminal)
  (ownerValue EpsilonDeclaration) (caseValue EpsilonDataMember)
  (references EpsilonTransitionPatternReferenceList)) Int
  (match references
    (NoEpsilonTransitionPatternReferences 0)
    ((MoreEpsilonTransitionPatternReferences item rest)
      (match item
        ((EpsilonTransitionPatternReferenceSyntax priorTerminal priorPattern
          priorKind priorProgress)
          (if (epsilon_terminals_same_identity terminalValue priorTerminal)
            (match priorProgress
              (EpsilonTransitionPatternResolved
                (epsilon_transition_case_is_covered terminalValue ownerValue
                  caseValue rest))
              (EpsilonTransitionPatternComplete
                (match priorKind
                  ((EpsilonScalarPatternSelector value)
                    (epsilon_transition_case_is_covered terminalValue ownerValue
                      caseValue rest))
                  (EpsilonTransitionWildcard
                    (epsilon_transition_case_is_covered terminalValue ownerValue
                      caseValue rest))
                  ((EpsilonSumCasePattern priorOwner priorCase)
                    (if (epsilon_data_declarations_same_identity ownerValue
                      priorOwner)
                      (if (epsilon_data_members_same_identity caseValue priorCase)
                        1
                        (epsilon_transition_case_is_covered terminalValue
                          ownerValue caseValue rest))
                      (epsilon_transition_case_is_covered terminalValue
                        ownerValue caseValue rest))))))
            (epsilon_transition_case_is_covered terminalValue ownerValue caseValue
              rest)))))))

(def epsilon_sum_members_are_covered ((terminalValue EpsilonTerminal)
  (ownerValue EpsilonDeclaration) (members EpsilonDataMemberList)
  (references EpsilonTransitionPatternReferenceList)) Int
  (match members
    (NoEpsilonDataMembers 1)
    ((MoreEpsilonDataMembers item rest)
      (match item
        ((EpsilonFieldMember start end name typeValue) 0)
        ((EpsilonCaseMember start end name payload)
          (if (epsilon_transition_case_is_covered terminalValue ownerValue item
            references)
            (epsilon_sum_members_are_covered terminalValue ownerValue rest
              references)
            0))))))

(def epsilon_sum_owner_is_covered ((terminalValue EpsilonTerminal)
  (ownerValue EpsilonDeclaration)
  (references EpsilonTransitionPatternReferenceList)) Int
  (match ownerValue
    ((EpsilonBoundaryDeclaration start end name machines) 0)
    ((EpsilonMachineDeclaration start end name inputs returnType bodyValue) 0)
    ((EpsilonDataDeclaration start end name members)
      (epsilon_sum_members_are_covered terminalValue ownerValue members
        references))))

(def epsilon_local_scan_transition_coverage ((terminalValue EpsilonTerminal)
  (arms EpsilonArmList) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match scan
    ((EpsilonLocalResolutionScanSyntax catalog references fields callables
      control types candidate)
      (match control
        ((EpsilonControlReferenceLedgerSyntax states subjects patterns coverages)
          (match (epsilon_find_transition_subject_reference terminalValue subjects)
            (NoEpsilonTransitionSubjectReference scan)
            ((OneEpsilonTransitionSubjectReference subjectKind)
              (match subjectKind
                (EpsilonScalarTransitionSubject scan)
                ((EpsilonSumTransitionSubject ownerValue)
                  (if (epsilon_arms_have_complete_patterns arms control)
                    (if (epsilon_arms_have_nonfinal_wildcard arms)
                      (epsilon_local_scan_add_transition_coverage terminalValue
                        ownerValue EpsilonTransitionCoverageUnresolved scan)
                      (if (epsilon_arms_have_final_wildcard arms)
                        (epsilon_local_scan_add_transition_coverage terminalValue
                          ownerValue EpsilonTransitionCoverageComplete scan)
                        (if (epsilon_sum_owner_is_covered terminalValue ownerValue
                          patterns)
                          (epsilon_local_scan_add_transition_coverage terminalValue
                            ownerValue EpsilonTransitionCoverageComplete scan)
                          (epsilon_local_scan_add_transition_coverage terminalValue
                            ownerValue EpsilonTransitionCoverageMissing scan))))
                    (epsilon_local_scan_add_transition_coverage terminalValue
                      ownerValue EpsilonTransitionCoverageUnresolved scan)))))))))))

(def epsilon_resolve_local_continuation ((source Bytes)
  (continuation EpsilonContinuation) (active EpsilonLocalBindingList)
  (machineValue EpsilonDeclaration) (returnType EpsilonOptionalType)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match continuation
    ((EpsilonExpressionContinuation start end expressionValue)
      (epsilon_resolve_local_transition_continuation_expression source
        expressionValue active machineValue start scan))
    ((EpsilonReturnContinuation start end expressionValue)
      (epsilon_local_scan_return_relation source start expressionValue returnType
        (epsilon_resolve_local_optional_expression source expressionValue active
          NoEpsilonLocalBindings scan)))))

(def epsilon_resolve_local_arms ((source Bytes) (terminalValue EpsilonTerminal)
  (arms EpsilonArmList) (active EpsilonLocalBindingList)
  (machineValue EpsilonDeclaration) (returnType EpsilonOptionalType)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match arms
    (NoEpsilonArms scan)
    ((MoreEpsilonArms item rest)
      (match item
        ((EpsilonArmSyntax start end patternValue continuation)
          (let patternScan EpsilonLocalResolutionScan
            (epsilon_local_scan_transition_pattern source terminalValue
              patternValue scan)
            (epsilon_resolve_local_arms source terminalValue rest active
              machineValue returnType
              (epsilon_resolve_local_continuation source continuation
                (epsilon_add_transition_pattern_bindings patternValue active)
                machineValue returnType patternScan))))))))

(def epsilon_resolve_local_terminal ((source Bytes)
  (terminalValue EpsilonOptionalTerminal) (active EpsilonLocalBindingList)
  (machineValue EpsilonDeclaration) (returnType EpsilonOptionalType)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match terminalValue
    (NoEpsilonTerminal scan)
    ((SomeEpsilonTerminal terminal)
      (match terminal
        ((EpsilonTransitionTerminal start end subject arms)
          (let subjectScan EpsilonLocalResolutionScan
            (epsilon_resolve_local_expression source subject active
              NoEpsilonLocalBindings scan)
            (let classifiedScan EpsilonLocalResolutionScan
              (epsilon_local_scan_transition_subject source terminal subject
                subjectScan)
              (epsilon_local_scan_transition_coverage terminal arms
                (epsilon_resolve_local_arms source terminal arms active
                  machineValue returnType classifiedScan)))))
        ((EpsilonReturnTerminal start end expressionValue)
          (epsilon_local_scan_return_relation source start expressionValue
            returnType
            (epsilon_resolve_local_optional_expression source expressionValue
              active NoEpsilonLocalBindings scan)))))))

(def epsilon_resolve_state_body_locals ((source Bytes)
  (bodyValue EpsilonStateBody) (active EpsilonLocalBindingList)
  (machineValue EpsilonDeclaration) (returnType EpsilonOptionalType)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match bodyValue
    ((EpsilonStateBodySyntax start end statements terminalValue)
      (match (epsilon_resolve_local_statements source statements active
        (epsilon_collect_pending_lets statements NoEpsilonLocalBindings) scan)
        ((EpsilonLocalBlockScanSyntax finalActive finalPending nextScan)
          (epsilon_resolve_local_terminal source terminalValue finalActive
            machineValue returnType nextScan))))))

(def epsilon_resolve_state_locals ((source Bytes) (stateValue EpsilonState)
  (machineValue EpsilonDeclaration) (machineBindings EpsilonLocalBindingList)
  (returnType EpsilonOptionalType) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match stateValue
    ((EpsilonStateSyntax start end name parameters bodyValue)
      (epsilon_resolve_state_body_locals source bodyValue
        (epsilon_add_state_parameter_bindings parameters machineBindings)
        machineValue returnType scan))))

(def epsilon_resolve_states_locals ((source Bytes) (states EpsilonStateList)
  (machineValue EpsilonDeclaration) (machineBindings EpsilonLocalBindingList)
  (returnType EpsilonOptionalType) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match states
    (NoEpsilonStates scan)
    ((MoreEpsilonStates item rest)
      (epsilon_resolve_states_locals source rest machineValue machineBindings
        returnType
        (epsilon_resolve_state_locals source item machineValue machineBindings
          returnType scan)))))

(def epsilon_resolve_machine_body_locals ((source Bytes)
  (bodyValue EpsilonMachineBody) (machineValue EpsilonDeclaration)
  (machineBindings EpsilonLocalBindingList) (returnType EpsilonOptionalType)
  (scan EpsilonLocalResolutionScan)) EpsilonLocalResolutionScan
  (match bodyValue
    ((EpsilonMachineBodySyntax start end statements terminalValue states)
      (match (epsilon_resolve_local_statements source statements machineBindings
        (epsilon_collect_pending_lets statements NoEpsilonLocalBindings) scan)
        ((EpsilonLocalBlockScanSyntax finalActive finalPending nextScan)
          (epsilon_resolve_states_locals source states machineValue
            machineBindings returnType
            (epsilon_resolve_local_terminal source terminalValue finalActive
              machineValue returnType nextScan)))))))

(def epsilon_resolve_catalog_declaration_locals ((source Bytes)
  (row EpsilonCatalogDeclaration) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match row
    ((EpsilonCatalogBoundaryDeclaration declarationValue) scan)
    ((EpsilonCatalogDataDeclaration declarationValue shape) scan)
    ((EpsilonCatalogMachineDeclaration declarationValue owner)
      (match declarationValue
        ((EpsilonBoundaryDeclaration start end name machines) scan)
        ((EpsilonDataDeclaration start end name members) scan)
        ((EpsilonMachineDeclaration start end name inputs returnType bodyValue)
          (epsilon_resolve_machine_body_locals source bodyValue declarationValue
            (epsilon_add_catalog_machine_self_binding declarationValue owner
              (epsilon_add_machine_parameter_bindings
                (epsilon_machine_input_parameters inputs)
                NoEpsilonLocalBindings))
            returnType scan))))))

(def epsilon_resolve_catalog_declarations_locals ((source Bytes)
  (rows EpsilonCatalogDeclarationList) (scan EpsilonLocalResolutionScan))
  EpsilonLocalResolutionScan
  (match rows
    (NoEpsilonCatalogDeclarations scan)
    ((MoreEpsilonCatalogDeclarations item rest)
      (epsilon_resolve_catalog_declarations_locals source rest
        (epsilon_resolve_catalog_declaration_locals source item scan)))))

(def epsilon_resolve_cataloged_locals ((source Bytes)
  (cataloged EpsilonCatalogedProgram)) EpsilonLocallyResolvedProgram
  (match cataloged
    ((EpsilonCatalogedProgramSyntax formed catalogState)
      (match catalogState
        ((EpsilonCatalogStateSyntax catalog candidate)
          (match formed
            ((EpsilonFormedProgramSyntax collected shapes valueEdges)
              (match collected
                ((EpsilonCollectedProgramSyntax program owners machines)
                  (match program
                    ((EpsilonSyntaxProgram start end declarations)
                      (match catalog
                        ((EpsilonResolutionCatalogSyntax rows)
                          (match
                            (epsilon_resolve_catalog_declarations_locals source
                              rows
                              (EpsilonLocalResolutionScanSyntax
                                catalog
                                NoEpsilonResolvedLocalReferences
                                NoEpsilonResolvedFieldReferences
                                NoEpsilonResolvedCallableReferences
                                (EpsilonControlReferenceLedgerSyntax
                                  NoEpsilonStateApplicationReferences
                                  NoEpsilonTransitionSubjectReferences
                                  NoEpsilonTransitionPatternReferences
                                  NoEpsilonTransitionCoverageReferences)
                                NoEpsilonTypedExpressions candidate))
                            ((EpsilonLocalResolutionScanSyntax finalCatalog
                              references fields callables stateApplications
                              types finalCandidate)
                              (EpsilonLocallyResolvedProgramSyntax cataloged
                                (epsilon_reverse_resolved_local_references
                                  references
                                  NoEpsilonResolvedLocalReferences)
                                (epsilon_reverse_resolved_field_references fields
                                  NoEpsilonResolvedFieldReferences)
                                (epsilon_reverse_resolved_callable_references
                                  callables NoEpsilonResolvedCallableReferences)
                                (epsilon_reverse_control_references
                                  stateApplications)
                                (epsilon_reverse_typed_expressions types
                                  NoEpsilonTypedExpressions)
                                finalCandidate))))))))))))))))

(def epsilon_parse_through_expression_facts ((source Bytes))
  EpsilonLocalResolutionOutcome
  (match (epsilon_parse_collect_form_and_catalog source)
    ((EpsilonCatalogRejected reasonValue errorOffset)
      (EpsilonLocalResolutionRejected reasonValue errorOffset))
    ((EpsilonCatalogInternal errorOffset)
      (EpsilonLocalResolutionInternal errorOffset))
    ((EpsilonCatalogAccepted cataloged)
      (EpsilonLocalResolutionAccepted
        (epsilon_resolve_cataloged_locals source cataloged)))))

; ---- direct symbolic Alpha encoding ----------------------------------------

(def epsilon_alpha_register_valid ((value Int)) Int
  (if (lt value 0) 0 (if (lt 255 value) 0 1)))

(def epsilon_alpha_label_valid ((label Int) (labelCount Int)) Int
  (if (lt label 0) 0 (lt label labelCount)))

(def epsilon_alpha_trie_lookup_depth ((tree EpsilonAlphaTrie) (key Int)
  (depth Int)) EpsilonAlphaTrieValue
  (if (if (lt depth 0) 1 (lt 24 depth))
    NoEpsilonAlphaTrieValue
    (match tree
      (EmptyEpsilonAlphaTrie NoEpsilonAlphaTrieValue)
      ((EpsilonAlphaTrieBranch value low high)
        (if (eq depth 0)
          (if (eq key 0) value NoEpsilonAlphaTrieValue)
          (if (eq (% key 2) 0)
            (epsilon_alpha_trie_lookup_depth low (/ key 2) (- depth 1))
            (epsilon_alpha_trie_lookup_depth high (/ key 2) (- depth 1))))))))

(def epsilon_alpha_trie_lookup ((tree EpsilonAlphaTrie)
  (key Int)) EpsilonAlphaTrieValue
  (if (lt key 0)
    NoEpsilonAlphaTrieValue
    (if (lt 16777215 key)
      NoEpsilonAlphaTrieValue
      (epsilon_alpha_trie_lookup_depth tree key 24))))

(def epsilon_alpha_trie_insert_depth ((tree EpsilonAlphaTrie) (key Int)
  (depth Int) (insertedValue Int)) EpsilonAlphaTrieInsertOutcome
  (if (if (lt depth 0) 1 (lt 24 depth))
    EpsilonAlphaTrieInsertInvalid
    (match tree
      (EmptyEpsilonAlphaTrie
        (if (eq depth 0)
          (if (eq key 0)
            (EpsilonAlphaTrieInserted
              (EpsilonAlphaTrieBranch
                (SomeEpsilonAlphaTrieValue insertedValue)
                EmptyEpsilonAlphaTrie EmptyEpsilonAlphaTrie))
            EpsilonAlphaTrieInsertInvalid)
          (if (eq (% key 2) 0)
            (match (epsilon_alpha_trie_insert_depth EmptyEpsilonAlphaTrie
              (/ key 2) (- depth 1) insertedValue)
              ((EpsilonAlphaTrieInserted low)
                (EpsilonAlphaTrieInserted
                  (EpsilonAlphaTrieBranch NoEpsilonAlphaTrieValue low
                    EmptyEpsilonAlphaTrie)))
              (EpsilonAlphaTrieInsertDuplicate EpsilonAlphaTrieInsertDuplicate)
              (EpsilonAlphaTrieInsertInvalid EpsilonAlphaTrieInsertInvalid))
            (match (epsilon_alpha_trie_insert_depth EmptyEpsilonAlphaTrie
              (/ key 2) (- depth 1) insertedValue)
              ((EpsilonAlphaTrieInserted high)
                (EpsilonAlphaTrieInserted
                  (EpsilonAlphaTrieBranch NoEpsilonAlphaTrieValue
                    EmptyEpsilonAlphaTrie high)))
              (EpsilonAlphaTrieInsertDuplicate EpsilonAlphaTrieInsertDuplicate)
              (EpsilonAlphaTrieInsertInvalid EpsilonAlphaTrieInsertInvalid)))))
      ((EpsilonAlphaTrieBranch value low high)
        (if (eq depth 0)
          (if (eq key 0)
            (match value
              (NoEpsilonAlphaTrieValue
                (EpsilonAlphaTrieInserted
                  (EpsilonAlphaTrieBranch
                    (SomeEpsilonAlphaTrieValue insertedValue) low high)))
              ((SomeEpsilonAlphaTrieValue oldValue)
                EpsilonAlphaTrieInsertDuplicate))
            EpsilonAlphaTrieInsertInvalid)
          (if (eq (% key 2) 0)
            (match (epsilon_alpha_trie_insert_depth low (/ key 2)
              (- depth 1) insertedValue)
              ((EpsilonAlphaTrieInserted newLow)
                (EpsilonAlphaTrieInserted
                  (EpsilonAlphaTrieBranch value newLow high)))
              (EpsilonAlphaTrieInsertDuplicate EpsilonAlphaTrieInsertDuplicate)
              (EpsilonAlphaTrieInsertInvalid EpsilonAlphaTrieInsertInvalid))
            (match (epsilon_alpha_trie_insert_depth high (/ key 2)
              (- depth 1) insertedValue)
              ((EpsilonAlphaTrieInserted newHigh)
                (EpsilonAlphaTrieInserted
                  (EpsilonAlphaTrieBranch value low newHigh)))
              (EpsilonAlphaTrieInsertDuplicate EpsilonAlphaTrieInsertDuplicate)
              (EpsilonAlphaTrieInsertInvalid EpsilonAlphaTrieInsertInvalid))))))))

(def epsilon_alpha_trie_insert ((tree EpsilonAlphaTrie) (key Int)
  (insertedValue Int)) EpsilonAlphaTrieInsertOutcome
  (if (lt key 0)
    EpsilonAlphaTrieInsertInvalid
    (if (lt 16777215 key)
      EpsilonAlphaTrieInsertInvalid
      (epsilon_alpha_trie_insert_depth tree key 24 insertedValue))))

(def epsilon_alpha_item_width ((item EpsilonAlphaItem)
  (labelCount Int)) Int
  (match item
    ((EpsilonAlphaLabel label) 0)
    ((EpsilonAlphaHalt register)
      (if (epsilon_alpha_register_valid register) 2 0))
    ((EpsilonAlphaImm register value)
      (if (epsilon_alpha_register_valid register) 10 0))
    ((EpsilonAlphaMov left right)
      (if (epsilon_alpha_register_valid left)
        (if (epsilon_alpha_register_valid right) 3 0) 0))
    ((EpsilonAlphaAdd left right)
      (if (epsilon_alpha_register_valid left)
        (if (epsilon_alpha_register_valid right) 3 0) 0))
    ((EpsilonAlphaSub left right)
      (if (epsilon_alpha_register_valid left)
