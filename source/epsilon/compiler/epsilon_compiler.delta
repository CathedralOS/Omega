(data EpsilonCensusOutcome
  (EpsilonCensusAccepted EpsilonCollectedProgram)
  (EpsilonCensusRejected EpsilonRejectReason Int))

(data EpsilonCensusLocalScan
  (EpsilonCensusLocalScanResult EpsilonCensusCandidate EpsilonNameList))

; D31 type formation is a complete source-coordinate candidate judgment.  The
; small kind Int is private equality identity only: it detects the impossible
; case where two distinct structural reasons claim one exact anchor and never
; orders reasons or enters ECOUT.
(data EpsilonTypePlacement
  (EpsilonStoredTypePlacement)
  (EpsilonParameterTypePlacement)
  (EpsilonLocalTypePlacement)
  (EpsilonReturnTypePlacement)
  (EpsilonMainConsoleTypePlacement)
  (EpsilonNestedTypePlacement))

(data EpsilonTypeFormationCandidate
  (NoEpsilonTypeFormationCandidate)
  (EpsilonTypeFormationCandidateAt Int EpsilonRejectReason Int)
  (EpsilonTypeFormationConflict Int))

(data EpsilonDataShapeKind
  (EpsilonRecordShape)
  (EpsilonSumShape))

(data EpsilonDataShapeRow
  (EpsilonDataShapeRowSyntax Int EpsilonName EpsilonDataShapeKind))

(data EpsilonDataShapeRowList
  (NoEpsilonDataShapeRows)
  (MoreEpsilonDataShapeRows EpsilonDataShapeRow EpsilonDataShapeRowList))

(data EpsilonValueEdge
  (EpsilonValueEdgeSyntax Int EpsilonName EpsilonName Int))

(data EpsilonValueEdgeList
  (NoEpsilonValueEdges)
  (MoreEpsilonValueEdges EpsilonValueEdge EpsilonValueEdgeList))

(data EpsilonReachabilityScan
  (EpsilonReachabilityScanResult Int EpsilonNameList))

(data EpsilonFormedProgram
  (EpsilonFormedProgramSyntax EpsilonCollectedProgram EpsilonDataShapeRowList EpsilonValueEdgeList))

(data EpsilonTypeFormationOutcome
  (EpsilonTypeFormationAccepted EpsilonFormedProgram)
  (EpsilonTypeFormationRejected EpsilonRejectReason Int)
  (EpsilonTypeFormationInternal Int))

; Body resolution consumes one source-shaped catalog rather than repeatedly
; rediscovering declaration ownership or assigning opaque numeric node ids.
; Each row retains one original top-level syntax value. Fields, cases, boundary
; members, and states stay inside that owner instead of becoming a second flat
; tree. D56 keeps the final entry-shape candidates in type formation;
; body/control candidates remain later facts in their separate carrier.
(data EpsilonCatalogMachineOwner
  (EpsilonCatalogUnqualifiedMachine)
  (EpsilonCatalogDataMachineOwner EpsilonDeclaration)
  (EpsilonCatalogUnknownMachineOwner EpsilonName))

(data EpsilonCatalogDeclaration
  (EpsilonCatalogBoundaryDeclaration EpsilonDeclaration)
  (EpsilonCatalogDataDeclaration EpsilonDeclaration EpsilonDataShapeKind)
  (EpsilonCatalogMachineDeclaration EpsilonDeclaration EpsilonCatalogMachineOwner))

(data EpsilonCatalogDeclarationList
  (NoEpsilonCatalogDeclarations)
  (MoreEpsilonCatalogDeclarations EpsilonCatalogDeclaration EpsilonCatalogDeclarationList))

(data EpsilonDataDeclarationLookup
  (NoEpsilonDataDeclaration)
  (OneEpsilonDataDeclaration EpsilonDeclaration))

(data EpsilonCatalogOwnerLookup
  (NoEpsilonCatalogOwner)
  (OneEpsilonCatalogBoundaryOwner EpsilonDeclaration)
  (OneEpsilonCatalogDataOwner EpsilonDeclaration EpsilonDataShapeKind))

(data EpsilonCatalogMachineLookup
  (NoEpsilonCatalogMachine)
  (OneEpsilonCatalogMachine EpsilonDeclaration))

(data EpsilonCatalogDataMachineLookup
  (NoEpsilonCatalogDataMachine)
  (OneEpsilonCatalogDataMachine EpsilonDeclaration EpsilonDeclaration))

(data EpsilonCatalogBoundaryMemberLookup
  (NoEpsilonCatalogBoundaryMember)
  (OneEpsilonCatalogBoundaryMember EpsilonBoundaryMachine))

(data EpsilonCatalogDataMemberLookup
  (NoEpsilonCatalogDataMember)
  (OneEpsilonCatalogField EpsilonDeclaration EpsilonDataMember)
  (OneEpsilonCatalogCase EpsilonDeclaration EpsilonDataMember))

(data EpsilonCatalogStateLookup
  (NoEpsilonCatalogState)
  (OneEpsilonCatalogState EpsilonState))

(data EpsilonFinalReasonList
  (NoEpsilonFinalReasons)
  (MoreEpsilonFinalReasons EpsilonRejectReason EpsilonFinalReasonList))

; Equal-coordinate body/control reasons are retained as a bucket. D56 keeps
; entry closure in the earlier type-formation carrier, so this carrier never
; composes or compares coordinates with entry candidates. D36 owns
; the earlier receiver grammar and callable-name census; D37 deduplicates one
; body reason/coordinate and makes distinct same-coordinate reasons an internal
; contradiction.
(data EpsilonFinalCandidate
  (NoEpsilonFinalCandidate)
  (EpsilonFinalCandidateAt Int EpsilonFinalReasonList))

(data EpsilonResolutionCatalog
  (EpsilonResolutionCatalogSyntax EpsilonCatalogDeclarationList))

(data EpsilonCatalogState
  (EpsilonCatalogStateSyntax EpsilonResolutionCatalog EpsilonFinalCandidate))

(data EpsilonCatalogedProgram
  (EpsilonCatalogedProgramSyntax EpsilonFormedProgram EpsilonCatalogState))

(data EpsilonCatalogOutcome
  (EpsilonCatalogAccepted EpsilonCatalogedProgram)
  (EpsilonCatalogRejected EpsilonRejectReason Int)
  (EpsilonCatalogInternal Int))

; Ordered body resolution keeps the exact source declaration behind every
; bare local-value reference. A transition binder retains its complete pattern
; because its eventual type comes from the resolved case payload position.
(data EpsilonLocalBinding
  (EpsilonSelfLocal EpsilonDeclaration)
  (EpsilonMachineParameterLocal EpsilonParameter)
  (EpsilonStateParameterLocal EpsilonParameter)
  (EpsilonLetLocal EpsilonName EpsilonType EpsilonStatement)
  (EpsilonTransitionBinderLocal EpsilonPattern EpsilonName))

(data EpsilonLocalBindingList
  (NoEpsilonLocalBindings)
  (MoreEpsilonLocalBindings EpsilonLocalBinding EpsilonLocalBindingList))

(data EpsilonLocalBindingLookup
  (NoEpsilonLocalBinding)
  (OneEpsilonLocalBinding EpsilonLocalBinding))

(data EpsilonLocalBindingNameLookup
  (NoEpsilonLocalBindingName)
  (OneEpsilonLocalBindingName EpsilonName))

(data EpsilonSelfBindingLookup
  (NoEpsilonSelfBinding)
  (OneEpsilonSelfBinding EpsilonLocalBinding EpsilonDeclaration))

(data EpsilonResolvedLocalReference
  (EpsilonResolvedLocalReferenceSyntax EpsilonExpression EpsilonLocalBinding))

(data EpsilonResolvedLocalReferenceList
  (NoEpsilonResolvedLocalReferences)
  (MoreEpsilonResolvedLocalReferences EpsilonResolvedLocalReference EpsilonResolvedLocalReferenceList))

(data EpsilonResolvedLocalReferenceLookup
  (NoEpsilonResolvedLocalReference)
  (OneEpsilonResolvedLocalReference EpsilonLocalBinding))

; Field custody retains both the nominal record declaration and exact authored
; member. Later layout/lowering can recover declaration order without another
; semantic lookup or a private numeric member identity.
(data EpsilonResolvedFieldReference
  (EpsilonResolvedFieldReferenceSyntax EpsilonExpression EpsilonDeclaration
    EpsilonDataMember))

(data EpsilonResolvedFieldReferenceList
  (NoEpsilonResolvedFieldReferences)
  (MoreEpsilonResolvedFieldReferences EpsilonResolvedFieldReference
    EpsilonResolvedFieldReferenceList))

(data EpsilonResolvedFieldReferenceLookup
  (NoEpsilonResolvedFieldReference)
  (OneEpsilonResolvedFieldReference EpsilonDeclaration EpsilonDataMember))

; Callable custody is retained before context, arity, or argument typing.
; Constructor and machine identities stay distinct after D36's census; the
; expression row gives lowering exact source authority without repeating a
; preferred-order catalog lookup.
(data EpsilonResolvedCallable
  (EpsilonResolvedConstructorCallable EpsilonDeclaration EpsilonDataMember)
  (EpsilonResolvedDataMachineCallable EpsilonDeclaration EpsilonDeclaration)
  (EpsilonResolvedUnqualifiedMachineCallable EpsilonDeclaration)
  (EpsilonResolvedBoundaryMachineCallable EpsilonDeclaration
    EpsilonBoundaryMachine))

(data EpsilonResolvedCallableReference
  (EpsilonResolvedCallableReferenceSyntax EpsilonExpression
    EpsilonResolvedCallable))

(data EpsilonResolvedCallableReferenceList
  (NoEpsilonResolvedCallableReferences)
  (MoreEpsilonResolvedCallableReferences EpsilonResolvedCallableReference
    EpsilonResolvedCallableReferenceList))

(data EpsilonResolvedCallableReferenceLookup
  (NoEpsilonResolvedCallableReference)
  (OneEpsilonResolvedCallableReference EpsilonResolvedCallable))

; A state transfer is control identity, not a callable or expression result.
; Resolution is retained even when arity or argument typing prevents a
; completed transfer, so lowering can require the stronger exact-AST fact.
(data EpsilonStateApplicationProgress
  (EpsilonStateApplicationResolved)
  (EpsilonStateApplicationComplete))

(data EpsilonStateApplicationReference
  (EpsilonStateApplicationReferenceSyntax EpsilonExpression EpsilonDeclaration
    EpsilonState EpsilonStateApplicationProgress))

(data EpsilonStateApplicationReferenceList
  (NoEpsilonStateApplicationReferences)
  (MoreEpsilonStateApplicationReferences EpsilonStateApplicationReference
    EpsilonStateApplicationReferenceList))

(data EpsilonStateApplicationReferenceLookup
  (NoEpsilonStateApplicationReference)
  (OneEpsilonStateApplicationReference EpsilonDeclaration EpsilonState
    EpsilonStateApplicationProgress))

; A transition subject is classified once from its complete expression fact.
; Later pattern, reachability, and lowering passes consume this exact terminal
; custody rather than re-resolving the subject expression.
(data EpsilonTransitionSubjectKind
  (EpsilonScalarTransitionSubject)
  (EpsilonSumTransitionSubject EpsilonDeclaration))

(data EpsilonTransitionSubjectReference
  (EpsilonTransitionSubjectReferenceSyntax EpsilonTerminal
    EpsilonTransitionSubjectKind))

(data EpsilonTransitionSubjectReferenceList
  (NoEpsilonTransitionSubjectReferences)
  (MoreEpsilonTransitionSubjectReferences EpsilonTransitionSubjectReference
    EpsilonTransitionSubjectReferenceList))

(data EpsilonTransitionSubjectReferenceLookup
  (NoEpsilonTransitionSubjectReference)
  (OneEpsilonTransitionSubjectReference EpsilonTransitionSubjectKind))

; D57 requires this broad progress pair to split into name-resolved,
; subject-admitted semantic identity, and complete-pattern stages before the
; negative transition-pattern judgment is implemented.
(data EpsilonTransitionPatternProgress
  (EpsilonTransitionPatternResolved)
  (EpsilonTransitionPatternComplete))

(data EpsilonTransitionPatternKind
  (EpsilonScalarPatternSelector Int)
  (EpsilonTransitionWildcard)
  (EpsilonSumCasePattern EpsilonDeclaration EpsilonDataMember))

; Pattern identity is independent of subject compatibility. Complete custody
; additionally proves the subject category, and for a case proves payload
; arity, so binder-to-parameter typing may consume it without a guessed fact.
(data EpsilonTransitionPatternReference
  (EpsilonTransitionPatternReferenceSyntax EpsilonTerminal EpsilonPattern
    EpsilonTransitionPatternKind EpsilonTransitionPatternProgress))

(data EpsilonTransitionPatternReferenceList
  (NoEpsilonTransitionPatternReferences)
  (MoreEpsilonTransitionPatternReferences EpsilonTransitionPatternReference
    EpsilonTransitionPatternReferenceList))

(data EpsilonTransitionPatternReferenceLookup
  (NoEpsilonTransitionPatternReference)
  (OneEpsilonTransitionPatternReference EpsilonTransitionPatternKind
    EpsilonTransitionPatternProgress))

(data EpsilonTransitionCoverageState
  (EpsilonTransitionCoverageComplete)
  (EpsilonTransitionCoverageMissing)
  (EpsilonTransitionCoverageUnresolved))

; D57 assigns missing complete coverage to `NonexhaustiveSum` at the transition
; subject. Unresolved keeps an invalid or incomplete pattern premise from
; manufacturing that later coverage judgment.
(data EpsilonTransitionCoverageReference
  (EpsilonTransitionCoverageReferenceSyntax EpsilonTerminal EpsilonDeclaration
    EpsilonTransitionCoverageState))

(data EpsilonTransitionCoverageReferenceList
  (NoEpsilonTransitionCoverageReferences)
  (MoreEpsilonTransitionCoverageReferences EpsilonTransitionCoverageReference
    EpsilonTransitionCoverageReferenceList))

(data EpsilonControlReferenceLedger
  (EpsilonControlReferenceLedgerSyntax EpsilonStateApplicationReferenceList
    EpsilonTransitionSubjectReferenceList EpsilonTransitionPatternReferenceList
    EpsilonTransitionCoverageReferenceList))

(data EpsilonOptionalPlaceType
  (NoEpsilonPlaceType)
  (SomeEpsilonPlaceType EpsilonType))

(data EpsilonExpressionResult
  (EpsilonValueExpressionResult EpsilonType EpsilonOptionalPlaceType)
  (EpsilonResultlessExpressionResult)
  (EpsilonNeverExpressionResult))

(data EpsilonTypedExpression
  (EpsilonTypedExpressionSyntax EpsilonExpression EpsilonExpressionResult))

(data EpsilonTypedExpressionList
  (NoEpsilonTypedExpressions)
  (MoreEpsilonTypedExpressions EpsilonTypedExpression EpsilonTypedExpressionList))

(data EpsilonExpressionResultLookup
  (NoEpsilonExpressionResult)
  (OneEpsilonExpressionResult EpsilonExpressionResult))

(data EpsilonLocalBindingTypeLookup
  (NoEpsilonLocalBindingType)
  (OneEpsilonLocalBindingType EpsilonType))

(data EpsilonArgumentTypeJoin
  (EpsilonArgumentsCompatible)
  (EpsilonArgumentsIncomplete)
  (EpsilonArgumentsTypeMismatch))

; Grammar-selected expression use is semantic. In particular, a call head,
; discarded postfix statement, and transition continuation cannot share one
; Boolean "not a value" bucket: D36 assigns them different callable namespaces
; and category failures before arity or argument typing.
(data EpsilonExpressionUse
  (EpsilonOrdinaryExpressionUse)
  (EpsilonCallHeadExpressionUse)
  (EpsilonPostfixStatementExpressionUse Int)
  (EpsilonTransitionContinuationExpressionUse EpsilonDeclaration Int))

; The scan carries the immutable catalog context, accumulates custody and
; expression facts in reverse dependency order, and retains the same neutral
; final-phase candidate bucket established by the catalog.
(data EpsilonLocalResolutionScan
  (EpsilonLocalResolutionScanSyntax EpsilonResolutionCatalog
    EpsilonResolvedLocalReferenceList EpsilonResolvedFieldReferenceList
    EpsilonResolvedCallableReferenceList EpsilonControlReferenceLedger
    EpsilonTypedExpressionList
    EpsilonFinalCandidate))

; Superseded by D53: the final compiler replaces this partial statement-flow
; carrier with five local block-exit effects and no reachability fixed point.
(data EpsilonStatementFlow
  (EpsilonStatementFlowOpen)
  (EpsilonStatementFlowEndedByNever)
  (EpsilonStatementFlowInvalidAfterNever))

(data EpsilonLocalBlockScan
  (EpsilonLocalBlockScanSyntax EpsilonLocalBindingList EpsilonLocalBindingList
    EpsilonLocalResolutionScan))

(data EpsilonLocallyResolvedProgram
  (EpsilonLocallyResolvedProgramSyntax EpsilonCatalogedProgram
    EpsilonResolvedLocalReferenceList EpsilonResolvedFieldReferenceList
    EpsilonResolvedCallableReferenceList EpsilonControlReferenceLedger
    EpsilonTypedExpressionList
    EpsilonFinalCandidate))

(data EpsilonLocalResolutionOutcome
  (EpsilonLocalResolutionAccepted EpsilonLocallyResolvedProgram)
  (EpsilonLocalResolutionRejected EpsilonRejectReason Int)
  (EpsilonLocalResolutionInternal Int))

(data EpsilonOwnerIdentity
  (NoEpsilonOwnerIdentity)
  (OneEpsilonBoundaryOwner)
  (OneEpsilonDataOwner)
  (AmbiguousEpsilonOwnerIdentity))

; The direct backend keeps Alpha construction symbolic until every label has an
; exact payload offset.  Label ids are dense in `0 .. label_count`; the private
; 24-level trie covers the complete 16,777,212-byte AlphaBootstrapV2 payload
; profile without
; linear lookup or a mutable patch table.
(data EpsilonAlphaItem
  (EpsilonAlphaLabel Int)
  (EpsilonAlphaHalt Int)
  (EpsilonAlphaImm Int Int)
  (EpsilonAlphaMov Int Int)
  (EpsilonAlphaAdd Int Int)
  (EpsilonAlphaSub Int Int)
  (EpsilonAlphaMul Int Int)
  (EpsilonAlphaDiv Int Int)
  (EpsilonAlphaMod Int Int)
  (EpsilonAlphaLoadByte Int Int)
  (EpsilonAlphaStoreByte Int Int)
  (EpsilonAlphaLoadWord Int Int)
  (EpsilonAlphaStoreWord Int Int)
  (EpsilonAlphaJump Int)
  (EpsilonAlphaJumpZero Int Int)
  (EpsilonAlphaJumpNonzero Int Int)
  (EpsilonAlphaJumpLess Int Int Int)
  (EpsilonAlphaJumpEqual Int Int Int)
  (EpsilonAlphaRead Int)
  (EpsilonAlphaWrite Int)
  (EpsilonAlphaCall Int)
  (EpsilonAlphaReturn))

(data EpsilonAlphaItemList
  (NoEpsilonAlphaItems)
  (MoreEpsilonAlphaItems EpsilonAlphaItem EpsilonAlphaItemList))

(data EpsilonAlphaProgram
  (EpsilonAlphaProgramItems Int EpsilonAlphaItemList))

(data EpsilonAlphaTrieValue
  (NoEpsilonAlphaTrieValue)
  (SomeEpsilonAlphaTrieValue Int))

(data EpsilonAlphaTrie
  (EmptyEpsilonAlphaTrie)
  (EpsilonAlphaTrieBranch EpsilonAlphaTrieValue EpsilonAlphaTrie EpsilonAlphaTrie))

(data EpsilonAlphaTrieInsertOutcome
  (EpsilonAlphaTrieInserted EpsilonAlphaTrie)
  (EpsilonAlphaTrieInsertDuplicate)
  (EpsilonAlphaTrieInsertInvalid))

(data EpsilonAlphaLayoutOutcome
  (EpsilonAlphaLayoutReady Int Int EpsilonAlphaTrie)
  (EpsilonAlphaLayoutOversized Int)
  (EpsilonAlphaLayoutInternal Int))

(data EpsilonAlphaInstructionBytesOutcome
  (EpsilonAlphaInstructionEncoded Bytes)
  (EpsilonAlphaInstructionInternal Int))

(data EpsilonAlphaBalancedBytesOutcome
  (EpsilonAlphaBalancedBytes Bytes EpsilonAlphaItemList)
  (EpsilonAlphaBalancedInternal Int))

(data EpsilonAlphaReplayTargetSetOutcome
  (EpsilonAlphaReplayTargetSet EpsilonAlphaTrie Int)
  (EpsilonAlphaReplayTargetSetInternal Int))

(data EpsilonAlphaReplayOutcome
  (EpsilonAlphaReplayValid)
  (EpsilonAlphaReplayInternal Int))

; These are private compiler outcomes, not EpsilonCompileOutcome cases.  The
; eventual pure compiler may hand an oversized candidate to Complete; the
; adapter's mandatory output-length preflight then reports outer Incomplete
; before validating or publishing it.  A compiler contradiction maps to
; InternalFailure.  Neither private case becomes a Epsilon reject.
(data EpsilonAlphaEncodeOutcome
  (EpsilonAlphaEncoded Bytes)
  (EpsilonAlphaOversizedCandidate Bytes Int)
  (EpsilonAlphaEncodingInternal Int))

(def ascii_between ((c Int) (low Int) (high Int)) Int
  (if (lt c low) 0 (if (lt high c) 0 1)))

(def source_byte_allowed ((c Int)) Int
  (if (eq c 9) 1
    (if (eq c 10) 1
      (if (eq c 13) 1
        (ascii_between c 32 126)))))

(def is_space ((c Int)) Int
  (if (eq c 32) 1
    (if (eq c 9) 1
      (if (eq c 10) 1 (eq c 13)))))

(def is_digit ((c Int)) Int
  (ascii_between c 48 57))

(def is_upper ((c Int)) Int
  (ascii_between c 65 90))

(def is_lower ((c Int)) Int
  (ascii_between c 97 122))

(def is_ident_start ((c Int)) Int
  (if (is_upper c) 1
    (if (is_lower c) 1 (eq c 95))))

(def is_ident_continue ((c Int)) Int
  (if (is_ident_start c) 1 (is_digit c)))

(def is_hex_digit ((c Int)) Int
  (if (is_digit c) 1
    (if (ascii_between c 65 70) 1
      (ascii_between c 97 102))))

(def is_printable ((c Int)) Int
  (ascii_between c 32 126))

(def is_simple_escape ((c Int)) Int
  (if (eq c 110) 1
    (if (eq c 114) 1
      (if (eq c 116) 1
        (if (eq c 34) 1 (eq c 92))))))

(def next_is ((source Bytes) (index Int) (length Int) (expected Int)) Int
  (if (lt (+ index 1) length)
    (eq (bytes_get source (+ index 1)) expected)
    0))

(def scan_identifier ((source Bytes) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    (scan_tokens source index length)
    (if (is_ident_continue (bytes_get source index))
      (scan_identifier source (+ index 1) length)
      (scan_tokens source index length))))

(def scan_number ((source Bytes) (start Int) (index Int) (length Int) (value Int)) EpsilonLexicalOutcome
  (if (eq index length)
    (scan_tokens source index length)
    (let c Int (bytes_get source index)
      (if (is_digit c)
        (let digit Int (- c 48)
          (if (lt value 214748364)
            (scan_number source start (+ index 1) length (+ (* value 10) digit))
            (if (eq value 214748364)
              (if (lt digit 9)
                (scan_number source start (+ index 1) length (+ (* value 10) digit))
                (LexicallyRejected IntegerLiteralOutOfRange start))
              (LexicallyRejected IntegerLiteralOutOfRange start))))
        (scan_tokens source index length)))))

(def scan_line_comment ((source Bytes) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    LexicallyValid
    (let c Int (bytes_get source index)
      (if (eq c 10)
        (scan_tokens source index length)
        (if (eq c 13)
          (scan_tokens source index length)
          (scan_line_comment source (+ index 1) length))))))

(def scan_string_escape ((source Bytes) (opening Int) (slash Int) (length Int)) EpsilonLexicalOutcome
  (if (eq (+ slash 1) length)
    (LexicallyRejected InvalidEscape slash)
    (let c Int (bytes_get source (+ slash 1))
      (if (is_simple_escape c)
        (scan_string source opening (+ slash 2) length)
        (if (eq c 120)
          (if (lt (+ slash 3) length)
            (if (is_hex_digit (bytes_get source (+ slash 2)))
              (if (is_hex_digit (bytes_get source (+ slash 3)))
                (scan_string source opening (+ slash 4) length)
                (LexicallyRejected InvalidEscape slash))
              (LexicallyRejected InvalidEscape slash))
            (LexicallyRejected InvalidEscape slash))
          (LexicallyRejected InvalidEscape slash))))))

(def scan_string ((source Bytes) (opening Int) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    (LexicallyRejected UnterminatedString opening)
    (let c Int (bytes_get source index)
      (if (eq c 34)
        (scan_tokens source (+ index 1) length)
        (if (eq c 92)
          (scan_string_escape source opening index length)
          (if (is_printable c)
            (scan_string source opening (+ index 1) length)
            (LexicallyRejected UnterminatedString opening)))))))

(def finish_character ((source Bytes) (opening Int) (close_index Int) (length Int)) EpsilonLexicalOutcome
  (if (lt close_index length)
    (if (eq (bytes_get source close_index) 39)
      (scan_tokens source (+ close_index 1) length)
      (LexicallyRejected InvalidCharacterLiteral opening))
    (LexicallyRejected InvalidCharacterLiteral opening)))

(def scan_character_escape ((source Bytes) (opening Int) (slash Int) (length Int)) EpsilonLexicalOutcome
  (if (eq (+ slash 1) length)
    (LexicallyRejected InvalidEscape slash)
    (let c Int (bytes_get source (+ slash 1))
      (if (is_simple_escape c)
        (finish_character source opening (+ slash 2) length)
        (if (eq c 120)
          (if (lt (+ slash 3) length)
            (if (is_hex_digit (bytes_get source (+ slash 2)))
              (if (is_hex_digit (bytes_get source (+ slash 3)))
                (finish_character source opening (+ slash 4) length)
                (LexicallyRejected InvalidEscape slash))
              (LexicallyRejected InvalidEscape slash))
            (LexicallyRejected InvalidEscape slash))
          (LexicallyRejected InvalidEscape slash))))))

(def scan_character ((source Bytes) (opening Int) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    (LexicallyRejected InvalidCharacterLiteral opening)
    (let c Int (bytes_get source index)
      (if (eq c 92)
        (scan_character_escape source opening index length)
        (if (eq c 39)
          (LexicallyRejected InvalidCharacterLiteral opening)
          (if (is_printable c)
            (finish_character source opening (+ index 1) length)
            (LexicallyRejected InvalidCharacterLiteral opening)))))))

(def is_plain_punctuation ((c Int)) Int
  (if (eq c 123) 1
    (if (eq c 125) 1
      (if (eq c 40) 1
        (if (eq c 41) 1
          (if (eq c 91) 1
            (if (eq c 93) 1
              (if (eq c 59) 1
                (if (eq c 44) 1
                  (if (eq c 43) 1
                    (if (eq c 42) 1
                      (if (eq c 37) 1 (eq c 94)))))))))))))

(def scan_operator ((source Bytes) (index Int) (length Int) (c Int)) EpsilonLexicalOutcome
  (if (is_plain_punctuation c)
    (scan_tokens source (+ index 1) length)
    (if (eq c 58)
      (if (next_is source index length 58)
        (scan_tokens source (+ index 2) length)
        (scan_tokens source (+ index 1) length))
      (if (eq c 45)
        (if (next_is source index length 62)
          (scan_tokens source (+ index 2) length)
          (scan_tokens source (+ index 1) length))
        (if (eq c 38)
          (if (next_is source index length 38)
            (scan_tokens source (+ index 2) length)
            (scan_tokens source (+ index 1) length))
          (if (eq c 124)
            (if (next_is source index length 124)
              (scan_tokens source (+ index 2) length)
              (scan_tokens source (+ index 1) length))
            (if (eq c 61)
              (if (next_is source index length 61)
                (scan_tokens source (+ index 2) length)
                (scan_tokens source (+ index 1) length))
              (if (eq c 33)
                (if (next_is source index length 61)
                  (scan_tokens source (+ index 2) length)
                  (LexicallyRejected InvalidToken index))
                (if (eq c 60)
                  (if (next_is source index length 61)
                    (scan_tokens source (+ index 2) length)
                    (if (next_is source index length 60)
                      (scan_tokens source (+ index 2) length)
                      (scan_tokens source (+ index 1) length)))
                  (if (eq c 62)
                    (if (next_is source index length 61)
                      (scan_tokens source (+ index 2) length)
                      (if (next_is source index length 62)
                        (scan_tokens source (+ index 2) length)
                        (scan_tokens source (+ index 1) length)))
                    (if (eq c 46)
                      (if (next_is source index length 46)
                        (scan_tokens source (+ index 2) length)
                        (scan_tokens source (+ index 1) length))
                      (if (eq c 47)
                        (if (next_is source index length 47)
                          (scan_line_comment source (+ index 2) length)
                          (scan_tokens source (+ index 1) length))
                        (LexicallyRejected InvalidToken index)))))))))))))

(def scan_tokens ((source Bytes) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    LexicallyValid
    (let c Int (bytes_get source index)
      (if (is_space c)
        (scan_tokens source (+ index 1) length)
        (if (is_ident_start c)
          (scan_identifier source (+ index 1) length)
          (if (is_digit c)
            (scan_number source index index length 0)
            (if (eq c 34)
              (scan_string source index (+ index 1) length)
              (if (eq c 39)
                (scan_character source index (+ index 1) length)
                (scan_operator source index length c)))))))))

(def check_source_bytes ((source Bytes) (index Int) (length Int)) EpsilonLexicalOutcome
  (if (eq index length)
    (scan_tokens source 0 length)
    (if (source_byte_allowed (bytes_get source index))
      (check_source_bytes source (+ index 1) length)
      (LexicallyRejected InvalidSourceByte index))))

(def check_lexical ((source Bytes)) EpsilonLexicalOutcome
  (check_source_bytes source 0 (bytes_length source)))

; ---- allocation-free syntax-token rescan -------------------------------
;
; These scalar helpers are called only after LexicallyValid. A parser keeps a
; source cursor, skips trivia to the next start (or source extent at EOF), and
; rescans code, end, or literal value as needed. No token fact enters the
; immutable Delta heap and no coordinate is packed into a narrower integer.

(def epsilon_span_is_1 ((source Bytes) (start Int) (end Int) (a Int)) Int
  (if (eq (- end start) 1) (eq (bytes_get source start) a) 0))

(def epsilon_span_is_2 ((source Bytes) (start Int) (end Int) (a Int) (b Int)) Int
  (if (eq (- end start) 2)
    (if (eq (bytes_get source start) a) (eq (bytes_get source (+ start 1)) b) 0)
    0))

(def epsilon_span_is_3 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int)) Int
  (if (eq (- end start) 3)
    (if (epsilon_span_is_2 source start (+ start 2) a b) (eq (bytes_get source (+ start 2)) c) 0)
    0))

(def epsilon_span_is_4 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int)) Int
  (if (eq (- end start) 4)
    (if (epsilon_span_is_3 source start (+ start 3) a b c) (eq (bytes_get source (+ start 3)) d) 0)
    0))

(def epsilon_span_is_5 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int)) Int
  (if (eq (- end start) 5)
    (if (epsilon_span_is_4 source start (+ start 4) a b c d) (eq (bytes_get source (+ start 4)) e) 0)
    0))

(def epsilon_span_is_6 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int)) Int
  (if (eq (- end start) 6)
    (if (epsilon_span_is_5 source start (+ start 5) a b c d e) (eq (bytes_get source (+ start 5)) f) 0)
    0))

(def epsilon_span_is_7 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int)) Int
  (if (eq (- end start) 7)
    (if (epsilon_span_is_6 source start (+ start 6) a b c d e f) (eq (bytes_get source (+ start 6)) g) 0)
    0))

(def epsilon_span_is_8 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int)) Int
  (if (eq (- end start) 8)
    (if (epsilon_span_is_7 source start (+ start 7) a b c d e f g) (eq (bytes_get source (+ start 7)) h) 0)
    0))

(def epsilon_span_is_10 ((source Bytes) (start Int) (end Int) (a Int) (b Int) (c Int) (d Int) (e Int) (f Int) (g Int) (h Int) (i Int) (j Int)) Int
  (if (eq (- end start) 10)
    (if (epsilon_span_is_8 source start (+ start 8) a b c d e f g h)
      (if (eq (bytes_get source (+ start 8)) i) (eq (bytes_get source (+ start 9)) j) 0)
      0)
    0))

(def epsilon_keyword_code ((source Bytes) (start Int) (end Int)) Int
  (if (epsilon_span_is_8 source start end 98 111 117 110 100 97 114 121) 10
    (if (epsilon_span_is_5 source start end 116 114 97 105 116) 11
      (if (epsilon_span_is_4 source start end 100 97 116 97) 12
        (if (epsilon_span_is_4 source start end 99 97 115 101) 13
          (if (epsilon_span_is_7 source start end 109 97 99 104 105 110 101) 14
            (if (epsilon_span_is_5 source start end 115 116 97 116 101) 15
              (if (epsilon_span_is_10 source start end 116 114 97 110 115 105 116 105 111 110) 16
                (if (epsilon_span_is_3 source start end 108 101 116) 17
                  (if (epsilon_span_is_6 source start end 114 101 116 117 114 110) 18
                    (if (epsilon_span_is_6 source start end 97 115 115 101 114 116) 19
                      (if (epsilon_span_is_4 source start end 116 114 117 101) 20
                        (if (epsilon_span_is_5 source start end 102 97 108 115 101) 21
                          (if (epsilon_span_is_4 source start end 115 101 108 102) 22
                            (if (epsilon_span_is_3 source start end 109 117 116) 23
                              (if (epsilon_span_is_3 source start end 105 51 50) 24
                                (if (epsilon_span_is_2 source start end 117 56) 25
                                  (if (epsilon_span_is_5 source start end 110 101 118 101 114) 26 1))))))))))))))))))

(def epsilon_skip_comment ((source Bytes) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (let commentByte Int (bytes_get source index)
      (if (eq commentByte 10)
        (epsilon_token_start source index)
        (if (eq commentByte 13)
          (epsilon_token_start source index)
          (epsilon_skip_comment source (+ index 1) length))))))

(def epsilon_token_start ((source Bytes) (index Int)) Int
  (let length Int (bytes_length source)
    (if (eq index length)
      length
      (let startByte Int (bytes_get source index)
        (if (is_space startByte)
          (epsilon_token_start source (+ index 1))
          (if (eq startByte 47)
            (if (next_is source index length 47)
              (epsilon_skip_comment source (+ index 2) length)
              index)
            index))))))

(def epsilon_identifier_end ((source Bytes) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (if (is_ident_continue (bytes_get source index))
      (epsilon_identifier_end source (+ index 1) length)
      index)))

(def epsilon_number_end ((source Bytes) (index Int) (length Int)) Int
  (if (eq index length)
    length
    (if (is_digit (bytes_get source index))
      (epsilon_number_end source (+ index 1) length)
      index)))

(def epsilon_string_end ((source Bytes) (index Int)) Int
  (let stringByte Int (bytes_get source index)
    (if (eq stringByte 34)
      (+ index 1)
      (if (eq stringByte 92)
        (if (eq (bytes_get source (+ index 1)) 120)
          (epsilon_string_end source (+ index 4))
          (epsilon_string_end source (+ index 2)))
        (epsilon_string_end source (+ index 1))))))

(def epsilon_character_end ((source Bytes) (start Int)) Int
  (if (eq (bytes_get source (+ start 1)) 92)
    (if (eq (bytes_get source (+ start 2)) 120) (+ start 6) (+ start 4))
    (+ start 3)))

(def epsilon_operator_end ((source Bytes) (start Int) (length Int) (operatorByte Int)) Int
  (if (eq operatorByte 58)
    (if (next_is source start length 58) (+ start 2) (+ start 1))
    (if (eq operatorByte 45)
      (if (next_is source start length 62) (+ start 2) (+ start 1))
      (if (eq operatorByte 38)
        (if (next_is source start length 38) (+ start 2) (+ start 1))
        (if (eq operatorByte 124)
          (if (next_is source start length 124) (+ start 2) (+ start 1))
          (if (eq operatorByte 61)
            (if (next_is source start length 61) (+ start 2) (+ start 1))
            (if (eq operatorByte 33) (+ start 2)
              (if (eq operatorByte 60)
                (if (next_is source start length 61) (+ start 2)
                  (if (next_is source start length 60) (+ start 2) (+ start 1)))
                (if (eq operatorByte 62)
                  (if (next_is source start length 61) (+ start 2)
                    (if (next_is source start length 62) (+ start 2) (+ start 1)))
                  (if (eq operatorByte 46)
                    (if (next_is source start length 46) (+ start 2) (+ start 1))
                    (+ start 1)))))))))))

(def epsilon_token_end ((source Bytes) (start Int)) Int
  (let length Int (bytes_length source)
    (if (eq start length)
      length
      (let tokenByte Int (bytes_get source start)
        (if (is_ident_start tokenByte)
          (epsilon_identifier_end source (+ start 1) length)
          (if (is_digit tokenByte)
            (epsilon_number_end source (+ start 1) length)
            (if (eq tokenByte 34)
              (epsilon_string_end source (+ start 1))
              (if (eq tokenByte 39)
                (epsilon_character_end source start)
                (epsilon_operator_end source start length tokenByte)))))))))

(def epsilon_operator_code ((source Bytes) (start Int) (length Int) (operatorByte Int)) Int
  (if (eq operatorByte 123) 30 (if (eq operatorByte 125) 31
    (if (eq operatorByte 40) 32 (if (eq operatorByte 41) 33
      (if (eq operatorByte 91) 34 (if (eq operatorByte 93) 35
        (if (eq operatorByte 59) 36
          (if (eq operatorByte 58) (if (next_is source start length 58) 43 37)
            (if (eq operatorByte 44) 38
              (if (eq operatorByte 46) (if (next_is source start length 46) 44 39)
                (if (eq operatorByte 38) (if (next_is source start length 38) 46 40)
                  (if (eq operatorByte 61) (if (next_is source start length 61) 49 41)
                    (if (eq operatorByte 45) (if (next_is source start length 62) 42 58)
                      (if (eq operatorByte 124) (if (next_is source start length 124) 45 47)
                        (if (eq operatorByte 94) 48 (if (eq operatorByte 33) 50
                          (if (eq operatorByte 60)
                            (if (next_is source start length 61) 52
                              (if (next_is source start length 60) 55 51))
                            (if (eq operatorByte 62)
                              (if (next_is source start length 61) 54
                                (if (next_is source start length 62) 56 53))
                              (if (eq operatorByte 43) 57
                                (if (eq operatorByte 42) 59
                                  (if (eq operatorByte 47) 60 61))))))))))))))))))))))

(def epsilon_token_code ((source Bytes) (start Int)) Int
  (let length Int (bytes_length source)
    (if (eq start length)
      0
      (let tokenByte Int (bytes_get source start)
        (if (is_ident_start tokenByte)
          (epsilon_keyword_code source start (epsilon_identifier_end source (+ start 1) length))
          (if (is_digit tokenByte) 2
            (if (eq tokenByte 39) 3
              (if (eq tokenByte 34) 4
                (epsilon_operator_code source start length tokenByte)))))))))

(def epsilon_hex_value ((c Int)) Int
  (if (is_digit c) (- c 48)
    (if (ascii_between c 65 70) (+ (- c 65) 10) (+ (- c 97) 10))))

(def epsilon_escape_value ((c Int)) Int
  (if (eq c 110) 10 (if (eq c 114) 13 (if (eq c 116) 9 c))))

(def epsilon_character_value ((source Bytes) (opening Int)) Int
  (let characterByte Int (bytes_get source (+ opening 1))
    (if (eq characterByte 92)
      (let escapeByte Int (bytes_get source (+ opening 2))
        (if (eq escapeByte 120)
          (+ (* (epsilon_hex_value (bytes_get source (+ opening 3))) 16)
             (epsilon_hex_value (bytes_get source (+ opening 4))))
          (epsilon_escape_value escapeByte)))
      characterByte)))

(def epsilon_number_value ((source Bytes) (index Int) (end Int) (value Int)) Int
  (if (eq index end)
    value
    (epsilon_number_value source (+ index 1) end
      (+ (* value 10) (- (bytes_get source index) 48)))))

(def epsilon_token_value ((source Bytes) (start Int)) Int
  (let length Int (bytes_length source)
    (if (eq start length)
      0
      (let tokenByte Int (bytes_get source start)
        (if (is_digit tokenByte)
          (epsilon_number_value source start (epsilon_number_end source (+ start 1) length) 0)
          (if (eq tokenByte 39) (epsilon_character_value source start) 0))))))

; ---- type and expression parsing ---------------------------------------

(def epsilon_type_start ((typeValue EpsilonType)) Int
  (match typeValue
    ((EpsilonI32Type start end) start)
    ((EpsilonU8Type start end) start)
    ((EpsilonNeverType start end) start)
    ((EpsilonNamedType start end name) start)
    ((EpsilonArrayType start end element lengthValue) start)
    ((EpsilonViewType start end element) start)))

(def epsilon_type_end ((typeValue EpsilonType)) Int
  (match typeValue
    ((EpsilonI32Type start end) end)
    ((EpsilonU8Type start end) end)
    ((EpsilonNeverType start end) end)
    ((EpsilonNamedType start end name) end)
    ((EpsilonArrayType start end element lengthValue) end)
    ((EpsilonViewType start end element) end)))

(def epsilon_expression_start ((expressionValue EpsilonExpression)) Int
  (match expressionValue
    ((EpsilonIntegerExpression start end literal) start)
    ((EpsilonCharacterExpression start end literal) start)
    ((EpsilonStringExpression start end literal) start)
    ((EpsilonTrueExpression start end) start)
    ((EpsilonFalseExpression start end) start)
    ((EpsilonSelfExpression start end) start)
    ((EpsilonNameExpression start end name) start)
    ((EpsilonQualifiedExpression start end owner name arguments) start)
    ((EpsilonGroupedExpression start end inner) start)
    ((EpsilonFieldExpression start end base field) start)
    ((EpsilonCallExpression start end base arguments) start)
    ((EpsilonIndexExpression start end base indexValue) start)
    ((EpsilonSliceExpression start end base low high) start)
    ((EpsilonNegateExpression start end operand) start)
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd left right) start)))

(def epsilon_expression_end ((expressionValue EpsilonExpression)) Int
  (match expressionValue
    ((EpsilonIntegerExpression start end literal) end)
    ((EpsilonCharacterExpression start end literal) end)
    ((EpsilonStringExpression start end literal) end)
    ((EpsilonTrueExpression start end) end)
    ((EpsilonFalseExpression start end) end)
    ((EpsilonSelfExpression start end) end)
    ((EpsilonNameExpression start end name) end)
    ((EpsilonQualifiedExpression start end owner name arguments) end)
    ((EpsilonGroupedExpression start end inner) end)
    ((EpsilonFieldExpression start end base field) end)
    ((EpsilonCallExpression start end base arguments) end)
    ((EpsilonIndexExpression start end base indexValue) end)
    ((EpsilonSliceExpression start end base low high) end)
    ((EpsilonNegateExpression start end operand) end)
    ((EpsilonBinaryExpression start end operator operatorStart operatorEnd left right) end)))

(def epsilon_type_reject_at ((source Bytes) (cursor Int)) EpsilonTypeParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonTypeParseRejected UnexpectedEnd start)
      (EpsilonTypeParseRejected UnexpectedToken start))))

(def epsilon_expression_reject_at ((source Bytes) (cursor Int)) EpsilonExpressionParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonExpressionParseRejected UnexpectedEnd start)
      (EpsilonExpressionParseRejected UnexpectedToken start))))

(def epsilon_arguments_reject_at ((source Bytes) (cursor Int)) EpsilonArgumentsParseOutcome
  (let start Int (epsilon_token_start source cursor)
    (if (eq start (bytes_length source))
      (EpsilonArgumentsParseRejected UnexpectedEnd start)
      (EpsilonArgumentsParseRejected UnexpectedToken start))))

(def epsilon_reverse_expression_list ((input EpsilonExpressionList)
  (output EpsilonExpressionList)) EpsilonExpressionList
  (match input
    (NoEpsilonExpressions output)
    ((MoreEpsilonExpressions item rest)
      (epsilon_reverse_expression_list rest (MoreEpsilonExpressions item output)))))

(def epsilon_parse_array_length ((source Bytes) (arrayStart Int)
