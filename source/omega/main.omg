// Product compiler phase driver. Gate protocol serialization lives outside
// this closure in the parser gate package.

use omega_language_std::console;
use omega::language::core::service;
use psi::lex::lexer;
use psi::parse::parser;

data Main {
    console: Service<Console> in Bound;
    lexer: Lexer;
    parser: Parser;
}

machine Main::main(&mut self) {
    self.lexer.initialize(1);
    transition { _ -> read() }

    state read(&mut self) {
        let input: ByteRead = self.console.read_byte();
        transition input {
            ByteRead::Byte { value } -> retain(value)
            _ -> tokenize()
        }
    }

    state retain(&mut self, value: i32) {
        self.lexer.append_source_byte(value as u8);
        transition self.lexer.source.last_retained {
            true -> read()
            _ -> source_full()
        }
    }

    state source_full(&mut self) {
        self.console.exit_process(252);
    }

    state tokenize(&mut self) {
        self.lexer.tokenize();
        transition self.lexer.output.accepted {
            true -> parse()
            _ -> lex_rejected()
        }
    }

    state parse(&mut self) {
        self.parser.initialize(
            self.lexer.source.id,
            self.lexer.source.length,
            self.lexer.output
        );
        self.parser.parse();
        transition self.parser.output.accepted {
            true -> accepted()
            _ -> parse_rejected()
        }
    }

    state accepted(&mut self) {
        self.console.exit_process(0);
    }

    state parse_rejected(&mut self) {
        self.console.exit_process(250);
    }

    state lex_rejected(&mut self) {
        self.console.exit_process(251);
    }
}
