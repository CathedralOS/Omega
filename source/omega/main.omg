// Product compiler entry: one sealed OCREQ V1 request on stdin, one outcome
// on stdout. Nothing outside the request supplies meaning. The request's
// phases run in contract order; the first refusal publishes its OCOUT frame
// and exits with the outcome's tag.

use omega_language_std::console;
use request::outcome;
use request::request;

data Main { }

machine Main::main(context: &mut Main)
reaches Console
crashes Trap
blocks;
{
    let mut request: Request;
    Request::clear(&mut request);
    transition { _ -> read(context, &mut request) }

    state read(context: &mut Main, request: &mut Request) {
        let input: ByteRead = block Console::read_byte();
        transition input {
            ByteRead::Byte { value } -> stage(context, request, value)
            _ -> envelope(context, request)
        }
    }

    state stage(context: &mut Main, request: &mut Request, value: i32) {
        Request::stage(request, value as u8);
        transition { _ -> read(context, request) }
    }

    state envelope(context: &mut Main, request: &Request) {
        let verdict: Verdict = Request::envelope(request);
        transition verdict.complete {
            true -> structure(context, request, verdict.sections)
            _ -> publish(context, verdict.outcome)
        }
    }

    state structure(context: &mut Main, request: &Request, sections: Sections) {
        let outcome: Outcome = Request::structure(request, sections);
        transition { _ -> publish(context, outcome) }
    }

    state publish(context: &mut Main, outcome: Outcome) {
        Main::write_frame(context, outcome);
        let tag: u8 = OutcomeTag::value(outcome.tag);
        Console::exit_process(tag as i32);
    }
}

// The outcome's frame, byte by byte.
machine Main::write_frame(context: &mut Main, outcome: Outcome)
reaches Console
crashes Trap
{
    transition { _ -> next(context, outcome, 0) }

    state next(context: &mut Main, outcome: Outcome, index: u64 in Trapping) {
        let length: u64 in Trapping = Outcome::frame_length(outcome);
        transition index < length {
            true -> write(context, outcome, index)
            _ -> done()
        }
    }

    state write(context: &mut Main, outcome: Outcome, index: u64 in Trapping) {
        let value: u8 = Outcome::frame_byte(outcome, index);
        Console::write_byte(value as i32);
        transition { _ -> next(context, outcome, index + 1) }
    }

    state done() {}
}
