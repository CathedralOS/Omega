// Product compiler phase driver. Gate protocol serialization lives outside
// this closure in the parser gate package.

use omega_language_std::console;
use omega::language::core::binding;
use psi::lex::lexer;
use psi::parse::parser;

data Main {
    console: Binding<Console>;
}

machine Main::main(context: &mut Main)
reaches Console
crashes Trap
blocks;
{
    let mut lexer: Lexer;
    Lexer::initialize(&mut lexer, 1);
    transition { _ -> read(context, &mut lexer) }

    state read(context: &mut Main, lexer: &mut Lexer) {
        let input: ByteRead = block context.console.read_byte();
        transition input {
            ByteRead::Byte { value } -> retain(context, lexer, value)
            _ -> tokenize(context, lexer)
        }
    }

    state retain(context: &mut Main, lexer: &mut Lexer, value: i32) {
        Lexer::append_source_byte(lexer, value as u8);
        transition lexer.source.last_retained {
            true -> read(context, lexer)
            _ -> source_full(context)
        }
    }

    state source_full(context: &mut Main) {
        context.console.exit_process(252);
    }

    state tokenize(context: &mut Main, lexer: &mut Lexer) {
        Lexer::tokenize(lexer);
        transition lexer.output.accepted {
            true -> parse(context, lexer)
            _ -> lex_rejected(context)
        }
    }

    state parse(context: &mut Main, lexer: &Lexer) {
        let mut parser: Parser;
        Parser::initialize(&mut parser, lexer.source.id,
            lexer.source.length as u64 in Trapping
        );
        Parser::parse(&mut parser, &lexer.output);
        transition parser.output.accepted {
            true -> accepted(context)
            _ -> parse_rejected(context)
        }
    }

    state accepted(context: &mut Main) {
        context.console.exit_process(0);
    }

    state parse_rejected(context: &mut Main) {
        context.console.exit_process(250);
    }

    state lex_rejected(context: &mut Main) {
        context.console.exit_process(251);
    }
}
