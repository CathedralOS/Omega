// Hosted product-compiler entrypoint. The current live slice exposes Psi's exact
// source-to-token phase and first structural parse through a hosted status
// adapter; later phases compose the remaining Psi/Omega owners behind it.

use omega::language::std::console;
use psi::lex::lexer;
use psi::parse::parser;
use psi::syntax::syntax;

data Main {
    console: Console;
    lexer: Lexer;
    parser: Parser;
}

machine Main::main(&mut self) {
    self.lexer.initialize(1);
    transition { _ -> read() }

    state read(&mut self) {
        let input: ByteRead = self.console.read_byte();
        transition input {
            ByteRead::Byte { value } -> retain(value)
            _ -> tokenize()
        }
    }

    state retain(&mut self, value: i32) {
        self.lexer.append_source_byte(value as u8);
        transition self.lexer.source.last_retained {
            true -> read()
            _ -> source_full()
        }
    }

    state source_full(&mut self) {
        self.lexer.reject(
            LexDiagnosticCode::SourceCapacityExceeded,
            self.lexer.source.length,
            self.lexer.source.length
        );
        self.write_lex_observation();
        self.console.exit_process(252);
    }

    state tokenize(&mut self) {
        self.lexer.tokenize();
        transition self.lexer.output.accepted {
            true -> prepare_parse()
            _ -> rejected()
        }
    }

    state prepare_parse(&mut self) {
        self.parser.initialize(self.lexer.source.id, self.lexer.source.length);
        transition self.lexer.output.token_count > 0 {
            true -> parser_token(0)
            _ -> parse()
        }
    }

    state parser_token(&mut self, index: u64 [0..=16383]) {
        let token: TokenObservation = self.lexer.output.observations[index];
        let tag: u8 = token.tag;
        let first: u8 = token.first;
        let start: u64 in Trapping = token.start;
        let end: u64 in Trapping = token.end;
        self.parser.append_token(tag, first, start, end);
        transition self.parser.last_retained {
            true -> parser_token_next(index)
            _ -> parser_input_rejected()
        }
    }

    state parser_token_next(&mut self, index: u64 [0..=16383]) {
        let next: u64 = index + 1;
        transition next < self.lexer.output.token_count {
            true -> parser_token_bound(next)
            _ -> parse()
        }
    }

    state parser_token_bound(&mut self, next: u64) {
        transition next < 16384 {
            true -> parser_token(next)
            _ -> parser_input_rejected()
        }
    }

    state parse(&mut self) {
        self.parser.parse();
        transition self.parser.output.accepted {
            true -> accepted()
            _ -> parse_rejected()
        }
    }

    state parser_input_rejected(&mut self) {
        self.write_parse_observation();
        self.console.exit_process(250);
    }

    state accepted(&mut self) {
        self.write_parse_observation();
        self.console.exit_process(0);
    }

    state parse_rejected(&mut self) {
        self.write_parse_observation();
        self.console.exit_process(250);
    }

    state rejected(&mut self) {
        self.write_lex_observation();
        self.console.exit_process(251);
    }
}

// Versioned canonical structural parse observation. Every scalar coordinate
// and count is little-endian u64. The stream begins with `OMGPAR2\0`, version
// 2, acceptance and diagnostic fields, followed by ordered root, use-item,
// path-member, data-item, data-field, and type-reference tables. This is hosted
// development tooling, not an Omega ABI.
machine Main::write_parse_observation(&mut self) {
    self.write_byte(79);
    self.write_byte(77);
    self.write_byte(71);
    self.write_byte(80);
    self.write_byte(65);
    self.write_byte(82);
    self.write_byte(50);
    self.write_byte(0);
    self.write_u64(2);
    transition self.parser.output.accepted {
        true -> parse_accepted_header()
        _ -> parse_rejected_header()
    }

    state parse_accepted_header(&mut self) {
        self.write_byte(1);
        transition { _ -> parse_diagnostic_none() }
    }

    state parse_rejected_header(&mut self) {
        self.write_byte(0);
        transition self.parser.output.diagnostic.code {
            ParseDiagnosticCode::None -> parse_diagnostic_none()
            ParseDiagnosticCode::LexicalInputRejected -> parse_diagnostic(1)
            ParseDiagnosticCode::UnsupportedRootItem -> parse_diagnostic(2)
            ParseDiagnosticCode::ExpectedPathMember -> parse_diagnostic(3)
            ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon -> parse_diagnostic(4)
            ParseDiagnosticCode::RootCapacityExceeded -> parse_diagnostic(5)
            ParseDiagnosticCode::UseCapacityExceeded -> parse_diagnostic(6)
            ParseDiagnosticCode::PathMemberCapacityExceeded -> parse_diagnostic(7)
            ParseDiagnosticCode::TokenInputCapacityExceeded -> parse_diagnostic(8)
            ParseDiagnosticCode::ExpectedDataAfterPub -> parse_diagnostic(9)
            ParseDiagnosticCode::ExpectedDataName -> parse_diagnostic(10)
            ParseDiagnosticCode::ExpectedDataBody -> parse_diagnostic(11)
            ParseDiagnosticCode::ExpectedDataFieldColon -> parse_diagnostic(12)
            ParseDiagnosticCode::ExpectedDataFieldType -> parse_diagnostic(13)
            ParseDiagnosticCode::ExpectedDataFieldEnd -> parse_diagnostic(14)
            ParseDiagnosticCode::DataCapacityExceeded -> parse_diagnostic(15)
            ParseDiagnosticCode::DataFieldCapacityExceeded -> parse_diagnostic(16)
            ParseDiagnosticCode::TypeReferenceCapacityExceeded -> parse_diagnostic(17)
        }
    }

    state parse_diagnostic_none(&mut self) {
        self.write_byte(0);
        transition { _ -> parse_diagnostic_coordinates() }
    }

    state parse_diagnostic(&mut self, tag: u8) {
        self.write_byte(tag);
        transition { _ -> parse_diagnostic_coordinates() }
    }

    state parse_diagnostic_coordinates(&mut self) {
        self.write_u64(self.parser.output.diagnostic.source_span.source.value as u64);
        self.write_u64(self.parser.output.diagnostic.source_span.span.start);
        self.write_u64(self.parser.output.diagnostic.source_span.span.end);
        self.write_u64(self.parser.output.root_count);
        transition self.parser.output.root_count > 0 {
            true -> parse_root(0)
            _ -> parse_use_count()
        }
    }

    state parse_root(&mut self, index: u64 [0..=255]) {
        let root: RootItem = self.parser.output.roots[index];
        transition root.kind {
            RootItemKind::Use -> parse_root_use(root, index)
            RootItemKind::Data -> parse_root_data(root, index)
        }
    }

    state parse_root_use(
        &mut self,
        root: RootItem,
        index: u64 [0..=255]
    ) {
        self.write_byte(1);
        self.write_u64(root.item_index);
        self.write_u64(root.source_span.source.value as u64);
        self.write_u64(root.source_span.span.start);
        self.write_u64(root.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.root_count {
            true -> parse_root_bound(next)
            _ -> parse_use_count()
        }
    }

    state parse_root_data(
        &mut self,
        root: RootItem,
        index: u64 [0..=255]
    ) {
        self.write_byte(2);
        self.write_u64(root.item_index);
        self.write_u64(root.source_span.source.value as u64);
        self.write_u64(root.source_span.span.start);
        self.write_u64(root.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.root_count {
            true -> parse_root_bound(next)
            _ -> parse_use_count()
        }
    }

    state parse_root_bound(&mut self, next: u64) {
        transition next < 256 {
            true -> parse_root(next)
            _ -> parse_use_count()
        }
    }

    state parse_use_count(&mut self) {
        self.write_u64(self.parser.output.use_count);
        transition self.parser.output.use_count > 0 {
            true -> parse_use_item(0)
            _ -> parse_member_count()
        }
    }

    state parse_use_item(&mut self, index: u64 [0..=255]) {
        let item: UseItem = self.parser.output.uses[index];
        self.write_u64(item.first_member);
        self.write_u64(item.member_count);
        self.write_u64(item.source_span.source.value as u64);
        self.write_u64(item.source_span.span.start);
        self.write_u64(item.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.use_count {
            true -> parse_use_bound(next)
            _ -> parse_member_count()
        }
    }

    state parse_use_bound(&mut self, next: u64) {
        transition next < 256 {
            true -> parse_use_item(next)
            _ -> parse_member_count()
        }
    }

    state parse_member_count(&mut self) {
        self.write_u64(self.parser.output.member_count);
        transition self.parser.output.member_count > 0 {
            true -> parse_member(0)
            _ -> parse_data_count()
        }
    }

    state parse_member(&mut self, index: u64 [0..=1023]) {
        let member: IdentifierSpan = self.parser.output.members[index];
        self.write_u64(member.source_span.source.value as u64);
        self.write_u64(member.source_span.span.start);
        self.write_u64(member.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.member_count {
            true -> parse_member_bound(next)
            _ -> parse_data_count()
        }
    }

    state parse_member_bound(&mut self, next: u64) {
        transition next < 1024 {
            true -> parse_member(next)
            _ -> parse_data_count()
        }
    }

    state parse_data_count(&mut self) {
        self.write_u64(self.parser.output.data_count);
        transition self.parser.output.data_count > 0 {
            true -> parse_data_item(0)
            _ -> parse_field_count()
        }
    }

    state parse_data_item(&mut self, index: u64 [0..=255]) {
        let item: DataItem = self.parser.output.data_items[index];
        self.write_u64(item.name.source_span.source.value as u64);
        self.write_u64(item.name.source_span.span.start);
        self.write_u64(item.name.source_span.span.end);
        self.write_u64(item.first_field);
        self.write_u64(item.field_count);
        transition item.is_public {
            true -> parse_data_public(item, index)
            _ -> parse_data_private(item, index)
        }
    }

    state parse_data_public(
        &mut self,
        item: DataItem,
        index: u64 [0..=255]
    ) {
        self.write_byte(1);
        transition { _ -> parse_data_span(item, index) }
    }

    state parse_data_private(
        &mut self,
        item: DataItem,
        index: u64 [0..=255]
    ) {
        self.write_byte(0);
        transition { _ -> parse_data_span(item, index) }
    }

    state parse_data_span(
        &mut self,
        item: DataItem,
        index: u64 [0..=255]
    ) {
        self.write_u64(item.source_span.source.value as u64);
        self.write_u64(item.source_span.span.start);
        self.write_u64(item.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.data_count {
            true -> parse_data_bound(next)
            _ -> parse_field_count()
        }
    }

    state parse_data_bound(&mut self, next: u64) {
        transition next < 256 {
            true -> parse_data_item(next)
            _ -> parse_field_count()
        }
    }

    state parse_field_count(&mut self) {
        self.write_u64(self.parser.output.field_count);
        transition self.parser.output.field_count > 0 {
            true -> parse_field(0)
            _ -> parse_type_reference_count()
        }
    }

    state parse_field(&mut self, index: u64 [0..=1023]) {
        let field: DataField = self.parser.output.fields[index];
        self.write_u64(field.name.source_span.source.value as u64);
        self.write_u64(field.name.source_span.span.start);
        self.write_u64(field.name.source_span.span.end);
        self.write_u64(field.type_reference);
        self.write_u64(field.source_span.source.value as u64);
        self.write_u64(field.source_span.span.start);
        self.write_u64(field.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.field_count {
            true -> parse_field_bound(next)
            _ -> parse_type_reference_count()
        }
    }

    state parse_field_bound(&mut self, next: u64) {
        transition next < 1024 {
            true -> parse_field(next)
            _ -> parse_type_reference_count()
        }
    }

    state parse_type_reference_count(&mut self) {
        self.write_u64(self.parser.output.type_reference_count);
        transition self.parser.output.type_reference_count > 0 {
            true -> parse_type_reference(0)
            _ -> parse_done()
        }
    }

    state parse_type_reference(&mut self, index: u64 [0..=1023]) {
        let type_reference: TypeReference =
            self.parser.output.type_references[index];
        transition type_reference.kind {
            TypeReferenceKind::Named -> parse_named_type_reference(type_reference, index)
        }
    }

    state parse_named_type_reference(
        &mut self,
        type_reference: TypeReference,
        index: u64 [0..=1023]
    ) {
        self.write_byte(1);
        self.write_u64(type_reference.name.source_span.source.value as u64);
        self.write_u64(type_reference.name.source_span.span.start);
        self.write_u64(type_reference.name.source_span.span.end);
        self.write_u64(type_reference.source_span.source.value as u64);
        self.write_u64(type_reference.source_span.span.start);
        self.write_u64(type_reference.source_span.span.end);
        let next: u64 = index + 1;
        transition next < self.parser.output.type_reference_count {
            true -> parse_type_reference_bound(next)
            _ -> parse_done()
        }
    }

    state parse_type_reference_bound(&mut self, next: u64) {
        transition next < 1024 {
            true -> parse_type_reference(next)
            _ -> parse_done()
        }
    }

    state parse_done(&mut self) { }
}

// Versioned canonical lexical observation. Every scalar coordinate/count is
// little-endian u64. The stream begins with `OMGLEX1\0`, version 1, then:
// accepted byte, diagnostic tag, diagnostic source/start/end, exact retained
// source bytes, and every retained token. Each token carries a structural kind
// tag plus three metadata bytes, source/start/end, raw spelling, and decoded
// bytes. This is hosted development tooling, not an Omega ABI or an enum layout.
machine Main::write_lex_observation(&mut self) {
    self.write_byte(79);
    self.write_byte(77);
    self.write_byte(71);
    self.write_byte(76);
    self.write_byte(69);
    self.write_byte(88);
    self.write_byte(49);
    self.write_byte(0);
    self.write_u64(1);
    transition self.lexer.output.accepted {
        true -> accepted_header()
        _ -> rejected_header()
    }

    state accepted_header(&mut self) {
        self.write_byte(1);
        transition { _ -> diagnostic_none() }
    }

    state rejected_header(&mut self) {
        self.write_byte(0);
        transition self.lexer.output.diagnostic.code {
            LexDiagnosticCode::None -> diagnostic_none()
            LexDiagnosticCode::InvalidUtf8 -> diagnostic(1)
            LexDiagnosticCode::UnsupportedPunctuation -> diagnostic(2)
            LexDiagnosticCode::UnterminatedBlockComment -> diagnostic(3)
            LexDiagnosticCode::UnterminatedStringLiteral -> diagnostic(4)
            LexDiagnosticCode::UnterminatedStringEscape -> diagnostic(5)
            LexDiagnosticCode::UnsupportedEscape -> diagnostic(6)
            LexDiagnosticCode::UnterminatedHexEscape -> diagnostic(7)
            LexDiagnosticCode::InvalidHexEscapeDigit -> diagnostic(8)
            LexDiagnosticCode::UnterminatedUnicodeEscape -> diagnostic(9)
            LexDiagnosticCode::ExpectedUnicodeEscapeBrace -> diagnostic(10)
            LexDiagnosticCode::EmptyUnicodeEscape -> diagnostic(11)
            LexDiagnosticCode::InvalidUnicodeEscapeDigit -> diagnostic(12)
            LexDiagnosticCode::InvalidUnicodeEscapeValue -> diagnostic(13)
            LexDiagnosticCode::InvalidUnicodeScalar -> diagnostic(14)
            LexDiagnosticCode::InvalidRawStringDelimiter -> diagnostic(15)
            LexDiagnosticCode::UnterminatedRawString -> diagnostic(16)
            LexDiagnosticCode::TokenCapacityExceeded -> diagnostic(17)
            LexDiagnosticCode::SourceCapacityExceeded -> diagnostic(18)
            LexDiagnosticCode::DecodedCapacityExceeded -> diagnostic(19)
        }
    }

    state diagnostic_none(&mut self) {
        self.write_byte(0);
        transition { _ -> diagnostic_coordinates() }
    }

    state diagnostic(&mut self, tag: u8) {
        self.write_byte(tag);
        transition { _ -> diagnostic_coordinates() }
    }

    state diagnostic_coordinates(&mut self) {
        self.write_u64(self.lexer.output.diagnostic.source_span.source.value as u64);
        self.write_u64(self.lexer.output.diagnostic.source_span.span.start);
        self.write_u64(self.lexer.output.diagnostic.source_span.span.end);
        self.write_u64(self.lexer.source.length);
        transition self.lexer.source.length > 0 {
            true -> source_byte(0)
            _ -> token_count()
        }
    }

    state source_byte(&mut self, index: u64 [0..=65535]) {
        self.write_byte(self.lexer.source.bytes[index]);
        let next: u64 = index + 1;
        transition next < self.lexer.source.length {
            true -> source_bound(next)
            _ -> token_count()
        }
    }

    state source_bound(&mut self, next: u64) {
        transition next < 65536 {
            true -> source_byte(next)
            _ -> token_count()
        }
    }

    state token_count(&mut self) {
        self.write_u64(self.lexer.output.token_count);
        transition self.lexer.output.token_count > 0 {
            true -> token(0)
            _ -> done()
        }
    }

    state token(&mut self, index: u64 [0..=16383]) {
        let observation: TokenObservation = self.lexer.output.observations[index];
        let tag: u8 = observation.tag;
        let first: u8 = observation.first;
        let second: u8 = observation.second;
        let third: u8 = observation.third;
        let source_id: u32 in Trapping = observation.source;
        let start: u64 in Trapping = observation.start;
        let end: u64 in Trapping = observation.end;
        let decoded_start: u64 in Trapping = observation.decoded_start;
        let decoded_length: u64 in Trapping = observation.decoded_length;
        self.write_byte(tag);
        self.write_byte(first);
        self.write_byte(second);
        self.write_byte(third);
        self.write_token_payload(
            source_id,
            start,
            end,
            decoded_start,
            decoded_length
        );
        let next: u64 = index + 1;
        transition next < self.lexer.output.token_count {
            true -> token_bound(next)
            _ -> done()
        }
    }

    state token_bound(&mut self, next: u64) {
        transition next < 16384 {
            true -> token(next)
            _ -> done()
        }
    }

    state done(&mut self) { }
}

machine Main::write_token_payload(
    &mut self,
    source_id: u32 in Trapping,
    start: u64 in Trapping,
    end: u64 in Trapping,
    decoded_start: u64 in Trapping,
    decoded_length: u64 in Trapping
) {
    self.write_u64(source_id as u64);
    self.write_u64(start);
    self.write_u64(end);
    self.write_u64(end - start);
    transition start < end {
        true -> raw_start(start as u64)
        _ -> decoded_count()
    }

    state raw_start(&mut self, byte_index: u64) {
        transition byte_index < 65536 {
            true -> raw_byte(byte_index)
            _ -> decoded_count()
        }
    }

    state raw_byte(&mut self, byte_index: u64 [0..=65535]) {
        self.write_byte(self.lexer.source.bytes[byte_index]);
        let next: u64 = byte_index + 1;
        transition next < end {
            true -> raw_bound(next)
            _ -> decoded_count()
        }
    }

    state raw_bound(&mut self, next: u64) {
        transition next < 65536 {
            true -> raw_byte(next)
            _ -> decoded_count()
        }
    }

    state decoded_count(&mut self) {
        self.write_u64(decoded_length);
        transition decoded_length > 0 {
            true -> decoded_start_bound(decoded_start as u64, decoded_length)
            _ -> done()
        }
    }

    state decoded_start_bound(
        &mut self,
        byte_index: u64,
        remaining: u64 in Trapping
    ) {
        transition byte_index < 65536 {
            true -> decoded_byte(byte_index, remaining)
            _ -> done()
        }
    }

    state decoded_byte(
        &mut self,
        byte_index: u64 [0..=65535],
        remaining: u64 in Trapping
    ) {
        self.write_byte(self.lexer.output.decoded[byte_index]);
        transition remaining > 1 {
            true -> decoded_next(byte_index, remaining)
            _ -> done()
        }
    }

    state decoded_next(
        &mut self,
        byte_index: u64 [0..=65535],
        remaining: u64 in Trapping
    ) {
        let next: u64 = byte_index + 1;
        transition next < 65536 {
            true -> decoded_decrement(next, remaining)
            _ -> done()
        }
    }

    state decoded_decrement(
        &mut self,
        next: u64 [0..=65535],
        remaining: u64 in Trapping
    ) {
        let next_remaining: u64 in Trapping = remaining - 1;
        transition { _ -> decoded_byte(next, next_remaining) }
    }

    state done(&mut self) { }
}

machine Main::write_u64(&mut self, value: u64 in Trapping) {
    self.write_byte((value % 256) as u8);
    self.write_byte((value / 256 % 256) as u8);
    self.write_byte((value / 65536 % 256) as u8);
    self.write_byte((value / 16777216 % 256) as u8);
    self.write_byte((value / 4294967296 % 256) as u8);
    self.write_byte((value / 1099511627776 % 256) as u8);
    self.write_byte((value / 281474976710656 % 256) as u8);
    self.write_byte((value / 72057594037927936 % 256) as u8);
}

machine Main::write_byte(&mut self, value: u8) {
    let mut output: u8 = value;
    self.console.write_byte(output as i32);
}
