    }

    state retain_type_reference_mutable() {
        self.type_reference_access = OmegaReferenceAccess::Mutable;
        self.type_reference_is_exclusive = 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(13) }
    }

    state retain_type_reference_write_only() {
        self.type_reference_access = OmegaReferenceAccess::WriteOnly;
