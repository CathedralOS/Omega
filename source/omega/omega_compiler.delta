            _ -> retain_type_reference_lifetime()
        }
    }

    state retain_type_reference_lifetime() {
        self.type_reference_has_lifetime = 1;
        self.type_reference_lifetime_start = self.scan.token_start;
        self.type_reference_lifetime_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(37) }
    }

    state retain_type_name() {
        self.type_base_kind = OmegaTypeBaseKind::Named;
        self.type_name_start = self.scan.token_start;
        self.type_name_end = self.scan.token_end;
        self.type_end = self.scan.token_end;
        self.type_allows_range = 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(14) }
    }

    state begin_type_array() {
        transition self.type_array_depth < 128 {
            true -> retain_type_array_frame()
            _ -> resource_failure(
                OmegaParserResource::TypeDepth,
                128,
                self.type_array_depth + 1
            )
