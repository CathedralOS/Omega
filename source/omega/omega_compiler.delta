        transition self.scan.punctuation {
            OmegaPunctuationKind::Comma -> next_struct_literal_field()
            OmegaPunctuationKind::RightBrace -> retain_struct_literal()
            _ -> internal_failure()
        }
    }

    state next_struct_literal_field() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(55) }
    }

    state retain_struct_literal() {
        transition (self.expression_count < 16384) &&
            (self.struct_literal_count < 16384) {
            true -> retain_struct_literal_bounded()
            _ -> resource_failure(
                OmegaParserResource::Expressions,
                16384,
                self.expression_count + 1
            )
        }
    }

    state retain_struct_literal_bounded() {
        self.struct_literals[self.struct_literal_count].first_type_member =
            self.struct_literal_first_type_member;
        self.struct_literals[self.struct_literal_count].type_member_count =
            self.struct_literal_type_member_count;
        self.struct_literals[self.struct_literal_count].first_field =
            self.struct_literal_first_field;
        self.struct_literals[self.struct_literal_count].field_count =
            self.struct_literal_field_count - self.struct_literal_first_field;
        self.struct_literals[self.struct_literal_count].start =
            self.struct_literal_start;
        self.struct_literals[self.struct_literal_count].end = self.scan.token_end;
        self.expression_result = self.expression_count;
        self.expression_end = self.scan.token_end;
        self.expressions[self.expression_count].kind =
            OmegaExpressionKind::StructLiteral;
        self.expressions[self.expression_count].path_kind =
            OmegaPathExpressionKind::Name;
        self.expressions[self.expression_count].payload0 = self.struct_literal_count;
        self.expressions[self.expression_count].payload1 = 0;
        self.expressions[self.expression_count].payload2 = 0;
        self.expressions[self.expression_count].payload3 = 0;
        self.expressions[self.expression_count].payload4 = 0;
        self.expressions[self.expression_count].payload5 = 0;
        self.struct_literal_count = self.struct_literal_count + 1;
        self.expression_count = self.expression_count + 1;
        self.expression_consumer = self.struct_literal_consumer;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(54) }
    }

    state retain_path_expression() {
        transition self.expression_count < 16384 {
            true -> retain_path_expression_argument_capacity()
            _ -> resource_failure(
                OmegaParserResource::Expressions,
                16384,
                self.expression_count + 1
            )
        }
    }

    state retain_path_expression_argument_capacity() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::CallArgument -> retain_call_argument_capacity()
            OmegaExpressionConsumer::AssignmentValue -> retain_path_expression_bounded()
            OmegaExpressionConsumer::StructFieldValue -> retain_path_expression_bounded()
            OmegaExpressionConsumer::TransitionSubject -> retain_path_expression_bounded()
        }
    }

    state retain_call_argument_capacity() {
        transition self.call_argument_count < 16384 {
            true -> retain_path_expression_bounded()
            _ -> resource_failure(
                OmegaParserResource::Expressions,
                16384,
                self.call_argument_count + 1
            )
        }
    }

    state retain_path_expression_bounded() {
        self.expressions[self.expression_count].kind = OmegaExpressionKind::Path;
        self.expressions[self.expression_count].path_kind =
            self.argument_path_kind;
        self.expressions[self.expression_count].payload0 =
            self.argument_first_path_member;
        self.expressions[self.expression_count].payload1 =
            self.argument_path_member_count;
        self.expressions[self.expression_count].payload2 =
            self.argument_starts_at_self;
        self.expressions[self.expression_count].payload3 =
            self.argument_name_member_count;
        self.expressions[self.expression_count].payload4 = 0;
        self.expressions[self.expression_count].payload5 = 0;
        transition self.expression_consumer {
            OmegaExpressionConsumer::CallArgument -> retain_call_argument_handle()
            OmegaExpressionConsumer::AssignmentValue -> retain_assignment_value_handle()
            OmegaExpressionConsumer::StructFieldValue -> retain_struct_field_value_handle()
            OmegaExpressionConsumer::TransitionSubject ->
                retain_transition_subject_handle()
        }
    }

    state retain_call_argument_handle() {
        self.call_arguments[self.call_argument_count] = self.expression_count;
        self.expression_count = self.expression_count + 1;
        self.call_argument_count = self.call_argument_count + 1;
        transition self.scan.punctuation {
            OmegaPunctuationKind::Comma -> next_call_argument()
            OmegaPunctuationKind::RightParen -> finish_call_arguments()
            _ -> internal_failure()
        }
    }

    state retain_assignment_value_handle() {
        self.assignment_value_expression = self.expression_count;
        self.expression_count = self.expression_count + 1;
        transition true { true -> retain_assignment_statement() }
    }

    state retain_struct_field_value_handle() {
        self.struct_field_value = self.expression_count;
        self.struct_field_value_end = self.members[self.member_count - 1].end;
        self.expression_count = self.expression_count + 1;
        transition true { true -> retain_struct_literal_field() }
    }

    state next_call_argument() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(44) }
    }

    state finish_call_arguments() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(47) }
    }

    state call_semicolon_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> call_semicolon_punctuation()
            _ -> incomplete_root()
        }
    }

    state call_semicolon_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Semicolon -> retain_call_statement()
            _ -> incomplete_root()
        }
    }

    state retain_call_statement() {
        transition (self.statement_count < 16384) &&
            (self.call_statement_count < 16384) {
            true -> retain_call_statement_bounded()
            _ -> resource_failure(
                OmegaParserResource::Statements,
                16384,
                self.statement_count + 1
            )
        }
    }

    state retain_call_statement_bounded() {
        self.call_statements[self.call_statement_count].first_receiver_member =
            self.call_first_path_member;
        self.call_statements[self.call_statement_count].receiver_member_count =
            self.call_path_member_count - 1;
        self.call_statements[self.call_statement_count].receiver_starts_at_self =
            self.call_receiver_starts_at_self;
        self.call_statements[self.call_statement_count].target_member =
            self.call_first_path_member + self.call_path_member_count - 1;
        self.call_statements[self.call_statement_count].first_machine_argument =
            self.call_first_machine_argument;
        self.call_statements[self.call_statement_count].machine_argument_count =
            self.static_machine_argument_count - self.call_first_machine_argument;
        self.call_statements[self.call_statement_count].first_argument =
            self.call_first_argument;
        self.call_statements[self.call_statement_count].argument_count =
            self.call_argument_count - self.call_first_argument;
        self.call_statements[self.call_statement_count].start = self.call_start;
        self.call_statements[self.call_statement_count].end = self.scan.token_end;
        self.statements[self.statement_count].kind = OmegaStatementKind::Call;
        self.statements[self.statement_count].item_index =
            self.call_statement_count;
        self.call_statement_count = self.call_statement_count + 1;
        self.statement_count = self.statement_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> resume_state_body() }
    }

    state begin_assignment_statement() {
        transition self.call_receiver_starts_at_self {
            1 -> classify_self_assignment_target()
            _ -> classify_named_assignment_target()
        }
    }

    state classify_self_assignment_target() {
        transition self.call_path_member_count {
            1 -> select_self_assignment_target()
            _ -> select_member_assignment_target()
        }
    }

    state classify_named_assignment_target() {
        transition self.call_path_member_count {
            1 -> select_name_assignment_target()
            _ -> select_member_assignment_target()
        }
    }

    state select_self_assignment_target() {
        self.assignment_target_name_member_count = 0;
        self.assignment_target_path_kind = OmegaPathExpressionKind::SelfValue;
        transition true { true -> retain_assignment_target_available() }
    }

    state select_name_assignment_target() {
        self.assignment_target_name_member_count = 1;
        self.assignment_target_path_kind = OmegaPathExpressionKind::Name;
        transition true { true -> retain_assignment_target_available() }
    }

    state select_member_assignment_target() {
        transition self.call_receiver_starts_at_self {
            1 -> select_self_member_assignment_target()
            _ -> select_named_member_assignment_target()
        }
    }

    state select_self_member_assignment_target() {
        self.assignment_target_name_member_count = 0;
        self.assignment_target_path_kind = OmegaPathExpressionKind::Member;
        transition true { true -> retain_assignment_target_available() }
    }

    state select_named_member_assignment_target() {
        self.assignment_target_name_member_count = 1;
        self.assignment_target_path_kind = OmegaPathExpressionKind::Member;
        transition true { true -> retain_assignment_target_available() }
    }

    state retain_assignment_target_available() {
        transition self.expression_count < 16384 {
            true -> retain_assignment_target()
            _ -> resource_failure(
                OmegaParserResource::Expressions,
                16384,
                self.expression_count + 1
            )
        }
    }

    state retain_assignment_target() {
        self.assignment_target_expression = self.expression_count;
        self.expressions[self.expression_count].kind = OmegaExpressionKind::Path;
        self.expressions[self.expression_count].path_kind =
            self.assignment_target_path_kind;
        self.expressions[self.expression_count].payload0 =
            self.call_first_path_member;
        self.expressions[self.expression_count].payload1 =
            self.call_path_member_count;
        self.expressions[self.expression_count].payload2 =
            self.call_receiver_starts_at_self;
        self.expressions[self.expression_count].payload3 =
            self.assignment_target_name_member_count;
        self.expressions[self.expression_count].payload4 = 0;
        self.expressions[self.expression_count].payload5 = 0;
        self.expression_count = self.expression_count + 1;
        self.expression_consumer = OmegaExpressionConsumer::AssignmentValue;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(48) }
    }

    state assignment_value_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> begin_named_assignment_value()
            OmegaTokenKind::Integer -> check_integer_expression()
            OmegaTokenKind::StringLiteral -> retain_string_expression()
            OmegaTokenKind::Keyword -> assignment_keyword_value()
            _ -> incomplete_root()
        }
    }

    state assignment_keyword_value() {
        transition self.scan.keyword {
            OmegaKeywordKind::True -> retain_boolean_expression(1)
            OmegaKeywordKind::False -> retain_boolean_expression(0)
            OmegaKeywordKind::SelfValue -> begin_self_assignment_value()
            OmegaKeywordKind::SelfType -> incomplete_root()
            _ -> begin_named_assignment_value()
        }
    }

    state check_integer_expression() {
        transition (self.scan.numeric_base == OmegaNumericBase::Decimal) &&
            (self.scan.numeric_empty_digits == 0) &&
            (self.scan.numeric_has_suffix == 0) &&
            (self.scan.numeric_has_exponent == 0) {
            true -> retain_integer_expression()
            _ -> incomplete_root()
        }
    }

    state retain_boolean_expression(value: i32) {
        transition self.expression_count < 16384 {
            true -> retain_boolean_expression_bounded(value)
            _ -> resource_failure(
                OmegaParserResource::Expressions,
                16384,
                self.expression_count + 1
            )
        }
    }

    state retain_boolean_expression_bounded(value: i32) {
        self.expression_result = self.expression_count;
        self.expression_end = self.scan.token_end;
        self.expressions[self.expression_count].kind = OmegaExpressionKind::Boolean;
        self.expressions[self.expression_count].path_kind =
            OmegaPathExpressionKind::Name;
        self.expressions[self.expression_count].payload0 = value;
        self.expressions[self.expression_count].payload1 = self.scan.token_start;
        self.expressions[self.expression_count].payload2 = self.scan.token_end;
        self.expressions[self.expression_count].payload3 = 0;
        self.expressions[self.expression_count].payload4 = 0;
        self.expressions[self.expression_count].payload5 = 0;
        self.expression_count = self.expression_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(54) }
    }

    state retain_integer_expression() {
        transition self.expression_count < 16384 {
            true -> retain_integer_expression_bounded()
            _ -> resource_failure(
                OmegaParserResource::Expressions,
                16384,
                self.expression_count + 1
            )
        }
    }

    state retain_integer_expression_bounded() {
        self.expression_result = self.expression_count;
        self.expression_end = self.scan.token_end;
        self.expressions[self.expression_count].kind = OmegaExpressionKind::Integer;
        self.expressions[self.expression_count].path_kind =
            OmegaPathExpressionKind::Name;
        self.expressions[self.expression_count].payload0 = self.scan.token_start;
        self.expressions[self.expression_count].payload1 = self.scan.token_end;
        self.expressions[self.expression_count].payload2 = 0;
        self.expressions[self.expression_count].payload3 = 0;
        self.expressions[self.expression_count].payload4 = 0;
        self.expressions[self.expression_count].payload5 = 0;
        self.expression_count = self.expression_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(54) }
    }

    state retain_string_expression() {
        transition self.expression_count < 16384 {
            true -> retain_string_expression_bounded()
            _ -> resource_failure(
                OmegaParserResource::Expressions,
                16384,
                self.expression_count + 1
            )
        }
    }

    state retain_string_expression_bounded() {
        self.expression_result = self.expression_count;
        self.expression_end = self.scan.token_end;
        self.expressions[self.expression_count].kind = OmegaExpressionKind::String;
        self.expressions[self.expression_count].path_kind =
            OmegaPathExpressionKind::Name;
        self.expressions[self.expression_count].payload0 = self.scan.token_start;
        self.expressions[self.expression_count].payload1 = self.scan.token_end;
        self.expressions[self.expression_count].payload2 = self.scan.decoded_length;
        self.expressions[self.expression_count].payload3 = 0;
        self.expressions[self.expression_count].payload4 = 0;
        self.expressions[self.expression_count].payload5 = 0;
        self.expression_count = self.expression_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(54) }
    }

    state begin_named_assignment_value() {
        self.argument_starts_at_self = 0;
        self.argument_name_member_count = 1;
        self.argument_path_kind = OmegaPathExpressionKind::Name;
        self.expression_consumer = OmegaExpressionConsumer::AssignmentValue;
        transition true { true -> begin_path_expression() }
    }

    state begin_self_assignment_value() {
        self.argument_starts_at_self = 1;
        self.argument_name_member_count = 0;
        self.argument_path_kind = OmegaPathExpressionKind::SelfValue;
        self.expression_consumer = OmegaExpressionConsumer::AssignmentValue;
        transition true { true -> begin_path_expression() }
    }

    state primary_expression_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> primary_expression_end_punctuation()
            OmegaTokenKind::Identifier -> possible_implicit_struct_field()
            OmegaTokenKind::Keyword -> possible_implicit_struct_field()
            _ -> primary_expression_end_failure()
        }
    }

    state possible_implicit_struct_field() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::StructFieldValue -> incomplete_root()
            _ -> incomplete_root()
        }
    }

    state primary_expression_end_failure() {
        transition true { true -> incomplete_root() }
    }

    state primary_expression_end_punctuation() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::CallArgument -> call_literal_end_punctuation()
            OmegaExpressionConsumer::AssignmentValue ->
                assignment_literal_end_punctuation()
            OmegaExpressionConsumer::StructFieldValue ->
                struct_field_literal_end_punctuation()
            OmegaExpressionConsumer::TransitionSubject -> incomplete_root()
        }
    }

    state call_literal_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Comma -> retain_call_literal_argument()
            OmegaPunctuationKind::RightParen -> retain_call_literal_argument()
            _ -> incomplete_root()
        }
    }

    state assignment_literal_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Semicolon -> retain_assignment_literal_value()
            _ -> incomplete_root()
        }
    }

    state struct_field_literal_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Comma -> retain_struct_field_literal_value()
            OmegaPunctuationKind::RightBrace -> retain_struct_field_literal_value()
            _ -> incomplete_root()
        }
    }

    state retain_struct_field_literal_value() {
        self.struct_field_value = self.expression_result;
        self.struct_field_value_end = self.expression_end;
        transition true { true -> retain_struct_literal_field() }
    }

    state retain_call_literal_argument() {
        transition self.call_argument_count < 16384 {
            true -> retain_call_literal_argument_bounded()
            _ -> resource_failure(
                OmegaParserResource::Expressions,
                16384,
                self.call_argument_count + 1
            )
        }
    }

    state retain_call_literal_argument_bounded() {
        self.call_arguments[self.call_argument_count] = self.expression_result;
        self.call_argument_count = self.call_argument_count + 1;
        transition self.scan.punctuation {
            OmegaPunctuationKind::Comma -> next_call_argument()
            OmegaPunctuationKind::RightParen -> finish_call_arguments()
            _ -> internal_failure()
        }
    }

    state retain_assignment_literal_value() {
        self.assignment_value_expression = self.expression_result;
        transition true { true -> retain_assignment_statement() }
    }

    state retain_assignment_statement() {
        transition (self.statement_count < 16384) &&
            (self.assignment_statement_count < 16384) {
            true -> retain_assignment_statement_bounded()
            _ -> resource_failure(
                OmegaParserResource::Statements,
                16384,
                self.statement_count + 1
            )
        }
    }

    state retain_assignment_statement_bounded() {
        self.assignment_statements[self.assignment_statement_count].target =
            self.assignment_target_expression;
        self.assignment_statements[self.assignment_statement_count].value =
            self.assignment_value_expression;
        self.assignment_statements[self.assignment_statement_count].start =
            self.call_start;
        self.assignment_statements[self.assignment_statement_count].end =
            self.scan.token_end;
        self.statements[self.statement_count].kind =
            OmegaStatementKind::Assignment;
        self.statements[self.statement_count].item_index =
            self.assignment_statement_count;
        self.assignment_statement_count = self.assignment_statement_count + 1;
        self.statement_count = self.statement_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> resume_state_body() }
    }

    state retain_implicit_state_for_machine() {
        transition true { true -> begin_retain_implicit_state(0) }
    }

    state retain_implicit_state_for_explicit_state() {
        transition true { true -> begin_retain_implicit_state(1) }
    }

    state begin_retain_implicit_state(continuation: i32) {
        transition self.machine_state_count < 4096 {
            true -> retain_implicit_state_bounded(continuation)
            _ -> resource_failure(
                OmegaParserResource::States,
                4096,
                self.machine_state_count + 1
            )
        }
    }

    state retain_implicit_state_bounded(continuation: i32) {
        self.machine_states[self.machine_state_count].name.start = 0;
        self.machine_states[self.machine_state_count].name.end = 0;
        self.machine_states[self.machine_state_count].first_parameter =
            self.state_first_parameter;
        self.machine_states[self.machine_state_count].parameter_count =
            self.machine_parameter_count - self.state_first_parameter;
        self.machine_states[self.machine_state_count].has_return_type =
            self.state_has_return_type;
        self.machine_states[self.machine_state_count].return_type =
            self.state_return_type;
        self.machine_states[self.machine_state_count].first_statement =
            self.state_first_statement;
        self.machine_states[self.machine_state_count].statement_count =
            self.statement_count - self.state_first_statement;
        transition self.machine_path_member_count {
            1 -> retain_free_machine_entry(continuation)
            _ -> retain_attached_machine_entry(continuation)
        }
    }

    state retain_free_machine_entry(continuation: i32) {
        self.machine_states[self.machine_state_count].name_kind =
            OmegaMachineStateNameKind::GeneratedEntry;
        transition true { true -> finish_retain_state(continuation) }
    }

    state retain_attached_machine_entry(continuation: i32) {
        self.machine_states[self.machine_state_count].name_kind =
            OmegaMachineStateNameKind::FinalPathMember;
        self.machine_states[self.machine_state_count].name.start =
            self.members[
                self.first_member + self.machine_path_member_count - 1
            ].start;
        self.machine_states[self.machine_state_count].name.end =
            self.members[
                self.first_member + self.machine_path_member_count - 1
            ].end;
        transition true { true -> finish_retain_state(continuation) }
    }

    state retain_explicit_state_for_machine_members() {
        transition self.machine_state_count < 4096 {
            true -> retain_explicit_state_bounded()
            _ -> resource_failure(
                OmegaParserResource::States,
                4096,
                self.machine_state_count + 1
            )
        }
    }

    state retain_explicit_state_bounded() {
        self.machine_states[self.machine_state_count].name_kind =
            OmegaMachineStateNameKind::Authored;
        self.machine_states[self.machine_state_count].name.start =
            self.state_name_start;
        self.machine_states[self.machine_state_count].name.end =
            self.state_name_end;
        self.machine_states[self.machine_state_count].first_parameter =
            self.state_first_parameter;
        self.machine_states[self.machine_state_count].parameter_count =
            self.machine_parameter_count - self.state_first_parameter;
        self.machine_states[self.machine_state_count].has_return_type =
            self.state_has_return_type;
        self.machine_states[self.machine_state_count].return_type =
            self.state_return_type;
        self.machine_states[self.machine_state_count].first_statement =
            self.state_first_statement;
        self.machine_states[self.machine_state_count].statement_count =
            self.statement_count - self.state_first_statement;
        transition true { true -> finish_retain_state(2) }
    }

    state finish_retain_state(continuation: i32) {
        self.machine_state_count = self.machine_state_count + 1;
        transition continuation {
            0 -> retain_machine()
            1 -> begin_explicit_state()
            _ -> finish_explicit_state()
        }
    }

    state finish_explicit_state() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(67) }
    }

    state retain_machine() {
        transition self.machine_state_count > self.machine_first_state {
            true -> retain_machine_bounded()
            _ -> internal_failure()
        }
    }

    state retain_machine_bounded() {
        self.machine_items[self.machine_count].first_path_member =
            self.first_member;
        self.machine_items[self.machine_count].path_member_count =
            self.machine_path_member_count;
        self.machine_items[self.machine_count].first_state =
            self.machine_first_state;
        self.machine_items[self.machine_count].state_count =
            self.machine_state_count - self.machine_first_state;
        self.machine_items[self.machine_count].is_public = self.machine_is_public;
        self.machine_items[self.machine_count].has_target = self.machine_has_target;
        self.machine_items[self.machine_count].target.start =
            self.machine_target_start;
        self.machine_items[self.machine_count].target.end = self.machine_target_end;
        self.machine_items[self.machine_count].start = self.item_start;
        self.machine_items[self.machine_count].end = self.scan.token_end;
        self.roots[self.root_count].kind = OmegaRootKind::Machine;
        self.roots[self.root_count].item_index = self.machine_count;
        self.machine_count = self.machine_count + 1;
        self.root_count = self.root_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(0) }
    }

    state begin_public_root() {
        self.item_start = self.scan.token_start;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(3) }
    }

    state public_root_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Keyword -> public_root_keyword()
            _ -> incomplete_root()
        }
    }

    state public_root_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::Data -> begin_data(1)
            OmegaKeywordKind::Machine -> begin_unscoped_machine(1)
            _ -> incomplete_root()
        }
    }

    state begin_data_root() {
        self.item_start = self.scan.token_start;
        transition true { true -> begin_data(0) }
    }

    state begin_data(is_public: i32) {
        transition self.root_count < 4096 {
            true -> begin_data_bounded(is_public)
            _ -> resource_failure(
                OmegaParserResource::Roots,
                4096,
                self.root_count + 1
            )
        }
    }

    state begin_data_bounded(is_public: i32) {
        self.data_first_member = self.data_member_count;
        self.data_first_field = self.data_field_count;
        self.data_first_case = self.data_case_count;
        self.data_is_public = is_public;
        self.data_multiplicity = OmegaDataMultiplicity::Affine;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(4) }
    }

    state data_name_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> data_identifier_name()
            OmegaTokenKind::Keyword -> data_name_keyword()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataName,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    // `Slice` has governed built-in meaning. Until the richer named-data path
    // is retained, do not misclassify it as an ordinary declaration name.
    state data_identifier_name() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "Slice"
        ) {
            1 -> incomplete_root()
            _ -> retain_data_name()
        }
    }

    state data_name_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataName,
                self.scan.token_start,
                self.scan.token_end
            )
            OmegaKeywordKind::SelfValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataName,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> retain_data_name()
        }
    }

    state retain_data_name() {
        self.data_name_start = self.scan.token_start;
        self.data_name_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(5) }
    }

    state data_body_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> data_body_punctuation()
            OmegaTokenKind::Identifier -> incomplete_root()
            OmegaTokenKind::Keyword -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state data_body_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBrace -> enter_data_body()
            OmegaPunctuationKind::LeftBracket -> begin_data_property()
            OmegaPunctuationKind::Less -> incomplete_root()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::Equal -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_data_property() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(6) }
    }

    state data_property_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Keyword -> data_property_keyword()
            _ -> incomplete_root()
        }
    }

    state data_property_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::Copy -> retain_copy_property()
            _ -> incomplete_root()
        }
    }

    state retain_copy_property() {
        self.data_multiplicity = OmegaDataMultiplicity::Unrestricted;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(7) }
    }

    state data_property_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> data_property_end_punctuation()
            _ -> incomplete_root()
        }
    }

    state data_property_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBracket -> after_data_property()
            _ -> incomplete_root()
        }
    }

    state after_data_property() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(8) }
    }

    state data_body_after_property_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> data_body_after_property_punctuation()
            OmegaTokenKind::Identifier -> incomplete_root()
            OmegaTokenKind::Keyword -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state data_body_after_property_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBrace -> enter_data_body()
            OmegaPunctuationKind::Equal -> incomplete_root()
            OmegaPunctuationKind::Less -> incomplete_root()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state enter_data_body() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(9) }
    }

    state data_member_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> data_member_punctuation()
            OmegaTokenKind::Identifier -> data_member_identifier()
            OmegaTokenKind::Keyword -> data_member_keyword()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataMemberOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state data_member_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "retired"
        ) {
            1 -> incomplete_root()
            _ -> begin_field(OmegaTypeConsumer::DirectDataField)
        }
    }

    state data_member_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBrace -> retain_data()
            OmegaPunctuationKind::Hash -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataMemberOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state data_member_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::Case -> begin_case_marker()
            OmegaKeywordKind::SelfType -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataMemberOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
            OmegaKeywordKind::SelfValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataMemberOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> begin_field(OmegaTypeConsumer::DirectDataField)
        }
    }

    state begin_case_marker() {
        self.case_start = self.scan.token_start;
        self.case_keyword_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(10) }
    }

    state case_marker_tail_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> case_marker_tail_punctuation()
            OmegaTokenKind::Identifier -> retain_case_name()
            OmegaTokenKind::Keyword -> case_name_keyword()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseName,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state case_marker_tail_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Colon -> contextual_case_field()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseName,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state case_name_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseName,
                self.scan.token_start,
                self.scan.token_end
            )
            OmegaKeywordKind::SelfValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseName,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> retain_case_name()
        }
    }

    state retain_case_name() {
        self.case_name_start = self.scan.token_start;
        self.case_name_end = self.scan.token_end;
        self.case_body_end = self.scan.token_end;
        self.case_first_payload_field = self.data_payload_field_count;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(11) }
    }

    state case_end_token(payload_allowed: i32) {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> case_end_punctuation(payload_allowed)
            OmegaTokenKind::Identifier -> incomplete_root()
            OmegaTokenKind::Keyword -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state case_end_punctuation(payload_allowed: i32) {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Semicolon -> retain_case(
                self.scan.token_end,
                self.scan.next_cursor
            )
            OmegaPunctuationKind::RightBrace -> retain_case(
                self.case_body_end,
                self.scan.token_start
            )
            OmegaPunctuationKind::LeftParen -> case_payload_allowed(
                payload_allowed
            )
            OmegaPunctuationKind::LeftBrace -> incomplete_root()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::Colon -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            OmegaPunctuationKind::Less -> incomplete_root()
            OmegaPunctuationKind::ColonColon -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state case_payload_allowed(payload_allowed: i32) {
        transition payload_allowed {
            1 -> begin_case_payload()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_case_payload() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(15) }
    }

    state case_payload_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> case_payload_punctuation()
            OmegaTokenKind::Identifier -> case_payload_identifier()
            OmegaTokenKind::Keyword -> case_payload_keyword()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataPayloadFieldOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state case_payload_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "retired"
        ) {
            1 -> incomplete_root()
            _ -> begin_field(OmegaTypeConsumer::CasePayloadField)
        }
    }

    state case_payload_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightParen -> finish_case_payload()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataPayloadFieldOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state case_payload_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataPayloadFieldOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
            OmegaKeywordKind::SelfValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataPayloadFieldOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> begin_field(OmegaTypeConsumer::CasePayloadField)
        }
    }

    state finish_case_payload() {
        self.case_body_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(16) }
    }

    state retain_case(member_end: i32, next_cursor: i32) {
        transition self.data_member_count < 16384 {
            true -> retain_case_bounded(member_end, next_cursor)
            _ -> resource_failure(
                OmegaParserResource::DataMembers,
                16384,
                self.data_member_count + 1
            )
        }
    }

    state retain_case_bounded(member_end: i32, next_cursor: i32) {
        self.data_cases[self.data_case_count].name.start = self.case_name_start;
        self.data_cases[self.data_case_count].name.end = self.case_name_end;
        self.data_cases[self.data_case_count].first_payload_field =
            self.case_first_payload_field;
        self.data_cases[self.data_case_count].payload_field_count =
            self.data_payload_field_count - self.case_first_payload_field;
        self.data_cases[self.data_case_count].start = self.case_start;
        self.data_cases[self.data_case_count].end = member_end;
        self.data_members[self.data_member_count].kind =
            OmegaDataMemberKind::Case;
        self.data_members[self.data_member_count].item_index =
            self.data_case_count;
        self.data_case_count = self.data_case_count + 1;
        self.data_member_count = self.data_member_count + 1;
        self.cursor = next_cursor;
        transition true { true -> scan_semantic(9) }
    }

    state begin_field(consumer: OmegaTypeConsumer) {
        self.type_subject_start = self.scan.token_start;
        self.type_subject_name_start = self.scan.token_start;
        self.type_subject_name_end = self.scan.token_end;
        self.type_consumer = consumer;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(12) }
    }

    state contextual_case_field() {
        self.type_subject_start = self.case_start;
        self.type_subject_name_start = self.case_start;
        self.type_subject_name_end = self.case_keyword_end;
        self.type_consumer = OmegaTypeConsumer::DirectDataField;
        transition true { true -> begin_type() }
    }

    state field_colon_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> field_colon_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldColon,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state field_colon_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Colon -> begin_type()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldColon,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_type() {
        self.type_constraint_mode = 0;
        self.type_array_frame_count = 0;
        self.type_array_depth = 0;
        self.type_allows_range = 0;
        self.type_base_kind = OmegaTypeBaseKind::Named;
        self.type_has_reference = 0;
        self.type_reference_access = OmegaReferenceAccess::Shared;
        self.type_reference_is_exclusive = 0;
        self.type_reference_has_lifetime = 0;
        self.type_reference_lifetime_start = 0;
        self.type_reference_lifetime_end = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(13) }
    }

    state type_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> type_identifier()
            OmegaTokenKind::Keyword -> type_keyword()
            OmegaTokenKind::Punctuation -> type_punctuation()
            _ -> type_missing_failure(
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state type_missing_failure(start: i32, end: i32) {
        transition self.type_consumer {
            OmegaTypeConsumer::MachineParameter -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterType,
                start,
                end
            )
            OmegaTypeConsumer::MachineReturn -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineReturnType,
                start,
                end
            )
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldType,
                start,
                end
            )
        }
    }

    state type_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "dyn"
