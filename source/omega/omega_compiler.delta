// Delta-written Omega compiler D: final Alpha tape encoder.
//
// This source intentionally has no Main yet. The canonical sealed Omega
// compilation request and publication boundary are owner-blocked by Q7. This
// unit owns only a boundary-independent final component: exact construction of
// Alpha's [u32 little-endian payload length][payload] tape format.
//
// status is sticky: 0 open, 1 output capacity, 2 internal misuse.
// failure_offset is a payload-relative byte offset. failure_requested is the
// rejected instruction width or invalid scalar supplied by the caller.

data AlphaTapeBuffer {
    bytes: [u8; 262144];
    length: i32;
    status: i32;
    failure_offset: i32;
    failure_requested: i32;
    finalized: i32;
}

machine AlphaTapeBuffer::initialize(&mut self) {
    self.bytes[0] = 0;
    self.bytes[1] = 0;
    self.bytes[2] = 0;
    self.bytes[3] = 0;
    self.length = 4;
    self.status = 0;
    self.failure_offset = 0;
    self.failure_requested = 0;
    self.finalized = 0;
}

machine AlphaTapeBuffer::payload_length(&mut self) -> i32 {
    return self.length - 4;
}

machine AlphaTapeBuffer::is_open(&mut self) -> i32 {
    transition self.status {
        0 -> check_finalized()
        _ -> return 0
    }

    state check_finalized() {
        transition self.finalized {
            0 -> return 1
            _ -> return 0
        }
    }
}

machine AlphaTapeBuffer::fail_internal(&mut self, detail: i32) -> i32 {
    self.status = 2;
    self.failure_offset = self.length - 4;
    self.failure_requested = detail;
    return 0;
}

// Reserve an entire instruction before any of its bytes are written. This is
// the atomicity boundary for every emitter below.
machine AlphaTapeBuffer::reserve(&mut self, count: i32) -> i32 {
    transition self.is_open() {
        1 -> check_length()
        _ -> return 0
    }

    state check_length() {
        transition (self.length >= 4) && (self.length <= 262144) {
            true -> check_count()
            _ -> corrupt_length()
        }
    }

    state check_count() {
        transition count >= 0 {
            true -> check_capacity()
            _ -> invalid_count()
        }
    }

    state check_capacity() {
        transition count <= 262144 - self.length {
            true -> return 1
            _ -> capacity()
        }
    }

    state corrupt_length() {
        self.status = 2;
        self.failure_offset = 0;
        self.failure_requested = self.length;
        return 0;
    }

    state invalid_count() {
        self.status = 2;
        self.failure_offset = self.length - 4;
        self.failure_requested = count;
        return 0;
    }

    state capacity() {
        self.status = 1;
        self.failure_offset = self.length - 4;
        self.failure_requested = count;
        return 0;
    }
}

// These two helpers are used only after one successful full-instruction
// reserve. The checked emitters below are the public correctness boundary.
machine AlphaTapeBuffer::write_reserved_byte(&mut self, value: i32) {
    self.bytes[self.length] = value;
    self.length = self.length + 1;
}

machine AlphaTapeBuffer::write_reserved_word(&mut self, value: i32) {
    self.write_reserved_byte(value & 255);
    self.write_reserved_byte((value >> 8) & 255);
    self.write_reserved_byte((value >> 16) & 255);
    self.write_reserved_byte((value >> 24) & 255);
}

machine AlphaTapeBuffer::write_reserved_address(&mut self, target: i32) {
    self.write_reserved_word(target);
    self.write_reserved_word(0);
}

// Shape r: halt(0), read(17), write(18). Width 2.
machine AlphaTapeBuffer::emit_r(&mut self, opcode: i32, register: i32) -> i32 {
    transition self.is_open() {
        1 -> check_opcode()
        _ -> return 0
    }

    state check_opcode() {
        transition (opcode == 0) || (opcode == 17) || (opcode == 18) {
            true -> check_register()
            _ -> invalid_opcode()
        }
    }

    state check_register() {
        transition (register >= 0) && (register <= 255) {
            true -> reserve_instruction()
            _ -> invalid_register()
        }
    }

    state reserve_instruction() {
        transition self.reserve(2) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(opcode);
        self.write_reserved_byte(register);
        return 1;
    }

    state invalid_opcode() {
        return self.fail_internal(opcode);
    }

    state invalid_register() {
        return self.fail_internal(register);
    }
}

// Shape r,r: mov through store (2..11). Width 3.
machine AlphaTapeBuffer::emit_rr(
    &mut self,
    opcode: i32,
    left: i32,
    right: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_opcode()
        _ -> return 0
    }

    state check_opcode() {
        transition (opcode >= 2) && (opcode <= 11) {
            true -> check_left()
            _ -> invalid_opcode()
        }
    }

    state check_left() {
        transition (left >= 0) && (left <= 255) {
            true -> check_right()
            _ -> invalid_left()
        }
    }

    state check_right() {
        transition (right >= 0) && (right <= 255) {
            true -> reserve_instruction()
            _ -> invalid_right()
        }
    }

    state reserve_instruction() {
        transition self.reserve(3) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(opcode);
        self.write_reserved_byte(left);
        self.write_reserved_byte(right);
        return 1;
    }

    state invalid_opcode() {
        return self.fail_internal(opcode);
    }

    state invalid_left() {
        return self.fail_internal(left);
    }

    state invalid_right() {
        return self.fail_internal(right);
    }
}

// imm(1) carries an arbitrary 64-bit pattern as low and high i32 halves.
// Width 10.
machine AlphaTapeBuffer::emit_imm(
    &mut self,
    register: i32,
    low: i32,
    high: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_register()
        _ -> return 0
    }

    state check_register() {
        transition (register >= 0) && (register <= 255) {
            true -> reserve_instruction()
            _ -> invalid_register()
        }
    }

    state reserve_instruction() {
        transition self.reserve(10) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(1);
        self.write_reserved_byte(register);
        self.write_reserved_word(low);
        self.write_reserved_word(high);
        return 1;
    }

    state invalid_register() {
        return self.fail_internal(register);
    }
}

// Shape address: jmp(12), call(19). Width 9.
machine AlphaTapeBuffer::emit_jump(
    &mut self,
    opcode: i32,
    target: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_opcode()
        _ -> return 0
    }

    state check_opcode() {
        transition (opcode == 12) || (opcode == 19) {
            true -> check_target()
            _ -> invalid_opcode()
        }
    }

    state check_target() {
        transition (target >= 0) && (target <= 262139) {
            true -> reserve_instruction()
            _ -> invalid_target()
        }
    }

    state reserve_instruction() {
        transition self.reserve(9) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(opcode);
        self.write_reserved_address(target);
        return 1;
    }

    state invalid_opcode() {
        return self.fail_internal(opcode);
    }

    state invalid_target() {
        return self.fail_internal(target);
    }
}

// Shape r,address: jz(13), jnz(14). Width 10.
machine AlphaTapeBuffer::emit_rx(
    &mut self,
    opcode: i32,
    register: i32,
    target: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_opcode()
        _ -> return 0
    }

    state check_opcode() {
        transition (opcode == 13) || (opcode == 14) {
            true -> check_register()
            _ -> invalid_opcode()
        }
    }

    state check_register() {
        transition (register >= 0) && (register <= 255) {
            true -> check_target()
            _ -> invalid_register()
        }
    }

    state check_target() {
        transition (target >= 0) && (target <= 262139) {
            true -> reserve_instruction()
            _ -> invalid_target()
        }
    }

    state reserve_instruction() {
        transition self.reserve(10) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(opcode);
        self.write_reserved_byte(register);
        self.write_reserved_address(target);
        return 1;
    }

    state invalid_opcode() {
        return self.fail_internal(opcode);
    }

    state invalid_register() {
        return self.fail_internal(register);
    }

    state invalid_target() {
        return self.fail_internal(target);
    }
}

// Shape r,r,address: jlt(15), jeq(16). Width 11.
machine AlphaTapeBuffer::emit_rrx(
    &mut self,
    opcode: i32,
    left: i32,
    right: i32,
    target: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_opcode()
        _ -> return 0
    }

    state check_opcode() {
        transition (opcode == 15) || (opcode == 16) {
            true -> check_left()
            _ -> invalid_opcode()
        }
    }

    state check_left() {
        transition (left >= 0) && (left <= 255) {
            true -> check_right()
            _ -> invalid_left()
        }
    }

    state check_right() {
        transition (right >= 0) && (right <= 255) {
            true -> check_target()
            _ -> invalid_right()
        }
    }

    state check_target() {
        transition (target >= 0) && (target <= 262139) {
            true -> reserve_instruction()
            _ -> invalid_target()
        }
    }

    state reserve_instruction() {
        transition self.reserve(11) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(opcode);
        self.write_reserved_byte(left);
        self.write_reserved_byte(right);
        self.write_reserved_address(target);
        return 1;
    }

    state invalid_opcode() {
        return self.fail_internal(opcode);
    }

    state invalid_left() {
        return self.fail_internal(left);
    }

    state invalid_right() {
        return self.fail_internal(right);
    }

    state invalid_target() {
        return self.fail_internal(target);
    }
}

// ret(20). Width 1.
machine AlphaTapeBuffer::emit_ret(&mut self) -> i32 {
    transition self.reserve(1) {
        1 -> write_instruction()
        _ -> return 0
    }

    state write_instruction() {
        self.write_reserved_byte(20);
        return 1;
    }
}

// Patch one previously reserved 64-bit address operand. payload_offset is
// relative to Alpha bytecode, not to the four-byte descriptive tape prefix.
// The final structural replay must still prove that the target is an
// instruction start and that this offset belongs to an address operand.
machine AlphaTapeBuffer::patch_address(
    &mut self,
    payload_offset: i32,
    target: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_offset_low()
        _ -> return 0
    }

    state check_offset_low() {
        transition payload_offset >= 0 {
            true -> check_offset_high()
            _ -> invalid_offset()
        }
    }

    state check_offset_high() {
        transition payload_offset <= (self.length - 4) - 8 {
            true -> check_target_low()
            _ -> invalid_offset()
        }
    }

    state check_target_low() {
        transition target >= 0 {
            true -> check_target_high()
            _ -> invalid_target()
        }
    }

    state check_target_high() {
        transition target < self.length - 4 {
            true -> write_patch()
            _ -> invalid_target()
        }
    }

    state write_patch() {
        let index: i32 = 4 + payload_offset;
        self.bytes[index] = target & 255;
        self.bytes[index + 1] = (target >> 8) & 255;
        self.bytes[index + 2] = (target >> 16) & 255;
        self.bytes[index + 3] = (target >> 24) & 255;
        self.bytes[index + 4] = 0;
        self.bytes[index + 5] = 0;
        self.bytes[index + 6] = 0;
        self.bytes[index + 7] = 0;
        return 1;
    }

    state invalid_offset() {
        return self.fail_internal(payload_offset);
    }

    state invalid_target() {
        return self.fail_internal(target);
    }
}

// Seal the tape by committing the exact Alpha payload length prefix. Once
// finalized, no instruction or fixup may modify the tape.
machine AlphaTapeBuffer::finalize_length_prefix(&mut self) -> i32 {
    transition self.is_open() {
        1 -> check_payload()
        _ -> return 0
    }

    state check_payload() {
        let payload: i32 = self.length - 4;
        transition (payload >= 0) && (payload <= 262140) {
            true -> write_prefix(payload)
            _ -> invalid_payload()
        }
    }

    state write_prefix(payload: i32) {
        self.bytes[0] = payload & 255;
        self.bytes[1] = (payload >> 8) & 255;
        self.bytes[2] = (payload >> 16) & 255;
        self.bytes[3] = (payload >> 24) & 255;
        self.finalized = 1;
        return 1;
    }

    state invalid_payload() {
        return self.fail_internal(self.length);
    }
}
