    }

    state retain_type_array_frame() {
        self.type_array_frames[self.type_array_depth].kind =
            OmegaTypeArrayKind::FixedArray;
        self.type_array_frame_count = self.type_array_frame_count + 1;
        self.type_array_depth = self.type_array_depth + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(24) }
    }

    state array_element_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> array_element_identifier()
            OmegaTokenKind::Keyword -> array_element_keyword()
            OmegaTokenKind::Punctuation -> array_element_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArrayElementType,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state array_element_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "dyn"
        ) {
            1 -> incomplete_root()
            _ -> retain_array_element_name()
        }
    }

    state array_element_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> retain_array_element_self()
            OmegaKeywordKind::SelfValue -> incomplete_root()
            _ -> retain_array_element_name()
        }
    }

    state array_element_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBracket -> begin_type_array()
            OmegaPunctuationKind::Ampersand -> incomplete_root()
            OmegaPunctuationKind::LeftParen -> begin_array_unit_type()
            OmegaPunctuationKind::Hash -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArrayElementType,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_array_unit_type() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(41) }
    }

    state array_unit_type_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> array_unit_type_end_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state array_unit_type_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightParen -> retain_array_unit_type()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state retain_array_unit_type() {
        self.type_base_kind = OmegaTypeBaseKind::Unit;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(25) }
    }

    state retain_array_element_name() {
        self.type_base_kind = OmegaTypeBaseKind::Named;
        self.type_name_start = self.scan.token_start;
        self.type_name_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(25) }
    }

    state retain_array_element_self() {
        self.type_base_kind = OmegaTypeBaseKind::SelfType;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(25) }
    }

    state array_semicolon_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> array_semicolon_punctuation()
            OmegaTokenKind::Identifier -> incomplete_root()
            OmegaTokenKind::Keyword -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArraySeparatorOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state array_semicolon_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Semicolon -> after_array_semicolon()
            OmegaPunctuationKind::ColonColon -> incomplete_root()
            OmegaPunctuationKind::Less -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            OmegaPunctuationKind::Ampersand -> incomplete_root()
            OmegaPunctuationKind::RightBracket -> retain_type_slice_layer()
            OmegaPunctuationKind::Comma -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArraySeparatorOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state retain_type_slice_layer() {
        self.type_array_frames[self.type_array_depth - 1].kind =
            OmegaTypeArrayKind::Slice;
        transition true { true -> finish_type_array_layer() }
    }

    state after_array_semicolon() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(26) }
    }

    state array_length_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Integer -> array_length_integer()
            OmegaTokenKind::Identifier -> incomplete_root()
            OmegaTokenKind::Keyword -> incomplete_root()
            OmegaTokenKind::Punctuation -> array_length_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArrayLength,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state array_length_integer() {
        transition (self.scan.numeric_base == OmegaNumericBase::Decimal) &&
            (self.scan.numeric_empty_digits == 0) &&
            (self.scan.numeric_has_suffix == 0) {
            true -> retain_array_length()
            _ -> incomplete_root()
        }
    }

    state array_length_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBracket -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArrayLength,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> incomplete_root()
        }
    }

    state retain_array_length() {
        self.type_array_frames[self.type_array_depth - 1].length_start =
            self.scan.token_start;
        self.type_array_frames[self.type_array_depth - 1].length_end =
            self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(27) }
    }

    state array_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> array_end_punctuation()
            _ -> incomplete_root()
        }
    }

    state array_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBracket -> finish_type_array_layer()
            _ -> incomplete_root()
        }
    }

    state finish_type_array_layer() {
        self.type_array_depth = self.type_array_depth - 1;
        self.type_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition self.type_array_depth {
            0 -> finish_type_array()
            _ -> scan_semantic(25)
        }
    }

    state finish_type_array() {
        self.type_allows_range = 0;
        transition true { true -> scan_semantic(14) }
    }

    state type_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> type_base_end_punctuation()
            OmegaTokenKind::Identifier -> type_suffix_identifier()
            OmegaTokenKind::Keyword -> incomplete_root()
            _ -> type_end_failure(
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state type_end_failure(start: i32, end: i32) {
        transition self.type_consumer {
            OmegaTypeConsumer::MachineParameter -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterEnd,
                start,
                end
            )
            OmegaTypeConsumer::MachineReturn -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineReturnEnd,
                start,
                end
            )
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldEnd,
                start,
                end
            )
        }
    }

    state type_suffix_identifier() {
        transition self.type_array_frame_count > 0 {
            true -> domain_type_suffix_identifier()
            _ -> type_base_suffix_identifier()
        }
    }

    state type_base_suffix_identifier() {
        transition self.type_base_kind {
            OmegaTypeBaseKind::SelfType -> type_end_failure(
                self.scan.token_start,
                self.scan.token_end
            )
            OmegaTypeBaseKind::Unit -> type_end_failure(
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> domain_type_suffix_identifier()
        }
    }

    state domain_type_suffix_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "in"
        ) {
            1 -> begin_type_domain()
            _ -> incomplete_root()
        }
    }

    state begin_type_domain() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(17) }
    }

    state type_domain_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> retain_type_domain()
            OmegaTokenKind::Keyword -> type_domain_keyword()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeDomain,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state type_domain_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeDomain,
                self.scan.token_start,
                self.scan.token_end
            )
            OmegaKeywordKind::SelfValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeDomain,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> retain_type_domain()
        }
    }

    state retain_type_domain() {
        self.type_constraint_mode = 1;
        self.type_domain_name_start = self.scan.token_start;
        self.type_domain_name_end = self.scan.token_end;
        self.type_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(18) }
    }

    state type_domain_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> type_consumer_punctuation()
            OmegaTokenKind::Identifier -> incomplete_root()
            OmegaTokenKind::Keyword -> incomplete_root()
            _ -> type_end_failure(
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state type_base_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBracket -> type_range_allowed()
            _ -> type_consumer_punctuation()
        }
    }

    state type_range_allowed() {
        transition self.type_allows_range {
            1 -> begin_type_range()
            _ -> incomplete_root()
        }
    }

    state begin_type_range() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(19) }
    }

    state type_range_minimum_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Integer -> type_range_minimum_integer()
            _ -> incomplete_root()
        }
    }

    state type_range_minimum_integer() {
        transition (self.scan.numeric_base == OmegaNumericBase::Decimal) &&
            (self.scan.numeric_empty_digits == 0) &&
            (self.scan.numeric_has_suffix == 0) {
            true -> retain_type_range_minimum()
            _ -> incomplete_root()
        }
    }

    state retain_type_range_minimum() {
        self.type_range_minimum_start = self.scan.token_start;
        self.type_range_minimum_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(20) }
    }

    state type_range_operator_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> type_range_operator_punctuation()
            _ -> incomplete_root()
        }
    }

    state type_range_operator_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::DotDotEqual -> after_type_range_operator()
            _ -> incomplete_root()
        }
    }

    state after_type_range_operator() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(21) }
    }

    state type_range_maximum_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Integer -> type_range_maximum_integer()
            OmegaTokenKind::Punctuation -> type_range_maximum_punctuation()
            _ -> incomplete_root()
        }
    }

    state type_range_maximum_integer() {
        transition (self.scan.numeric_base == OmegaNumericBase::Decimal) &&
            (self.scan.numeric_empty_digits == 0) &&
            (self.scan.numeric_has_suffix == 0) {
            true -> retain_type_range_maximum()
            _ -> incomplete_root()
        }
    }

    state type_range_maximum_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBracket -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeRangeBound,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> incomplete_root()
        }
    }

    state retain_type_range_maximum() {
        self.type_range_maximum_start = self.scan.token_start;
        self.type_range_maximum_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(22) }
    }

    state type_range_close_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> type_range_close_punctuation()
            _ -> incomplete_root()
        }
    }

    state type_range_close_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBracket -> retain_type_range()
            _ -> incomplete_root()
        }
    }

    state retain_type_range() {
        self.type_constraint_mode = 2;
        self.type_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(23) }
    }

    state type_constraint_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> type_consumer_punctuation()
            OmegaTokenKind::Identifier -> incomplete_root()
            OmegaTokenKind::Keyword -> incomplete_root()
            _ -> type_end_failure(
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state type_consumer_punctuation() {
        transition self.type_consumer {
            OmegaTypeConsumer::DirectDataField -> direct_data_field_end()
            OmegaTypeConsumer::CasePayloadField -> case_payload_field_end()
            OmegaTypeConsumer::MachineParameter -> machine_parameter_end()
            OmegaTypeConsumer::MachineReturn -> machine_return_end()
        }
    }

    state machine_return_end() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBrace -> retain_type_for_consumer(
                self.type_end,
                self.scan.next_cursor
            )
            OmegaPunctuationKind::Semicolon -> incomplete_root()
            OmegaPunctuationKind::ColonColon -> incomplete_root()
            OmegaPunctuationKind::Less -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::Ampersand -> incomplete_root()
            _ -> type_end_failure(
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_parameter_end() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Comma -> retain_machine_parameter_with_more()
            OmegaPunctuationKind::RightParen -> retain_last_machine_parameter()
            OmegaPunctuationKind::ColonColon -> incomplete_root()
            OmegaPunctuationKind::Less -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::Ampersand -> incomplete_root()
            _ -> type_end_failure(
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state retain_machine_parameter_with_more() {
        self.machine_parameter_has_more = 1;
        transition true {
            true -> retain_type_for_consumer(
                self.type_end,
                self.scan.next_cursor
            )
        }
    }

    state retain_last_machine_parameter() {
        self.machine_parameter_has_more = 0;
        transition true {
            true -> retain_type_for_consumer(
                self.type_end,
                self.scan.next_cursor
            )
        }
    }

    state direct_data_field_end() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Semicolon -> retain_type_for_consumer(
                self.scan.token_end,
                self.scan.next_cursor
            )
            OmegaPunctuationKind::RightBrace -> retain_type_for_consumer(
                self.type_end,
                self.scan.token_start
            )
            OmegaPunctuationKind::ColonColon -> incomplete_root()
            OmegaPunctuationKind::Less -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::Ampersand -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state case_payload_field_end() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Comma -> retain_type_for_consumer(
                self.scan.token_end,
                self.scan.next_cursor
            )
            OmegaPunctuationKind::RightParen -> retain_type_for_consumer(
                self.type_end,
                self.scan.token_start
            )
            OmegaPunctuationKind::ColonColon -> incomplete_root()
            OmegaPunctuationKind::Less -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::Ampersand -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state retain_type_for_consumer(member_end: i32, next_cursor: i32) {
        transition self.type_consumer {
            OmegaTypeConsumer::DirectDataField -> retain_direct_data_field_capacity(
                member_end,
                next_cursor
            )
            OmegaTypeConsumer::CasePayloadField -> retain_type_nodes(
                member_end,
                next_cursor
            )
            OmegaTypeConsumer::MachineParameter -> retain_type_nodes(
                member_end,
                next_cursor
            )
            OmegaTypeConsumer::MachineReturn -> retain_type_nodes(
                member_end,
                next_cursor
            )
        }
    }

    state retain_direct_data_field_capacity(
        member_end: i32,
        next_cursor: i32
    ) {
        transition self.data_member_count < 16384 {
            true -> retain_type_nodes(member_end, next_cursor)
            _ -> resource_failure(
                OmegaParserResource::DataMembers,
                16384,
                self.data_member_count + 1
            )
        }
    }

    state retain_type_nodes(member_end: i32, next_cursor: i32) {
        self.type_required_nodes = 1 + self.type_array_frame_count;
        transition self.type_constraint_mode {
            1 -> add_constraint_node_requirement(member_end, next_cursor)
            2 -> add_constraint_node_requirement(member_end, next_cursor)
            _ -> add_reference_node_requirement(member_end, next_cursor)
        }
    }

    state add_constraint_node_requirement(
        member_end: i32,
        next_cursor: i32
    ) {
        self.type_required_nodes = self.type_required_nodes + 1;
        transition true {
            true -> add_reference_node_requirement(member_end, next_cursor)
        }
    }

    state add_reference_node_requirement(
        member_end: i32,
        next_cursor: i32
    ) {
        transition self.type_has_reference {
            1 -> add_reference_node_requirement_bounded(
                member_end,
                next_cursor
            )
            _ -> retain_type_node_capacity(member_end, next_cursor)
        }
    }

    state add_reference_node_requirement_bounded(
        member_end: i32,
        next_cursor: i32
    ) {
        self.type_required_nodes = self.type_required_nodes + 1;
        transition true {
            true -> retain_type_node_capacity(member_end, next_cursor)
        }
    }

    state retain_type_node_capacity(
        member_end: i32,
        next_cursor: i32
    ) {
        transition (self.type_required_nodes >= 1) &&
            (self.type_required_nodes <= 16384) &&
            (self.type_reference_count <= 16384 - self.type_required_nodes) {
            true -> retain_constraint_storage(member_end, next_cursor)
            _ -> resource_failure(
                OmegaParserResource::TypeNodes,
                16384,
                self.type_reference_count + self.type_required_nodes
            )
        }
    }

    state retain_constraint_storage(member_end: i32, next_cursor: i32) {
        transition self.type_constraint_mode {
            1 -> retain_domain_path_capacity(member_end, next_cursor)
            2 -> retain_range_constrained_type(member_end, next_cursor)
            _ -> begin_retain_type_tree(member_end, next_cursor)
        }
    }

    state retain_domain_path_capacity(member_end: i32, next_cursor: i32) {
        transition self.member_count < 16384 {
            true -> retain_domain_constraint(member_end, next_cursor)
            _ -> resource_failure(
                OmegaParserResource::PathMembers,
                16384,
                self.member_count + 1
            )
        }
    }

    state retain_domain_constraint(member_end: i32, next_cursor: i32) {
        self.members[self.member_count].start = self.type_domain_name_start;
        self.members[self.member_count].end = self.type_domain_name_end;
        self.type_constraints[self.type_constraint_count].kind =
            OmegaTypeConstraintKind::Domain;
        self.type_constraints[self.type_constraint_count].payload0 =
            self.member_count;
        self.type_constraints[self.type_constraint_count].payload1 = 1;
        self.member_count = self.member_count + 1;
        transition true {
            true -> begin_retain_type_tree(member_end, next_cursor)
        }
    }

    state retain_range_constrained_type(
        member_end: i32,
        next_cursor: i32
    ) {
        self.type_constraints[self.type_constraint_count].kind =
            OmegaTypeConstraintKind::InclusiveRange;
        self.type_constraints[self.type_constraint_count].payload0 =
            self.type_range_minimum_start;
        self.type_constraints[self.type_constraint_count].payload1 =
            self.type_range_minimum_end;
        self.type_constraints[self.type_constraint_count].payload2 =
            self.type_range_maximum_start;
        self.type_constraints[self.type_constraint_count].payload3 =
            self.type_range_maximum_end;
        transition true {
            true -> begin_retain_type_tree(member_end, next_cursor)
        }
    }

    state begin_retain_type_tree(
        member_end: i32,
        next_cursor: i32
    ) {
        transition self.type_base_kind {
            OmegaTypeBaseKind::Named -> retain_named_type_base(
                member_end,
                next_cursor
            )
            OmegaTypeBaseKind::SelfType -> retain_self_type_base(
                member_end,
                next_cursor
            )
            OmegaTypeBaseKind::Unit -> retain_unit_type_base(
                member_end,
                next_cursor
            )
        }
    }

    state retain_named_type_base(member_end: i32, next_cursor: i32) {
        self.type_references[self.type_reference_count].kind =
            OmegaTypeReferenceKind::Named;
        self.type_references[self.type_reference_count].payload0 =
            self.type_name_start;
        self.type_references[self.type_reference_count].payload1 =
            self.type_name_end;
        transition true {
            true -> finish_retain_type_base(member_end, next_cursor)
        }
    }

    state retain_self_type_base(member_end: i32, next_cursor: i32) {
        self.type_references[self.type_reference_count].kind =
            OmegaTypeReferenceKind::SelfType;
        transition true {
            true -> finish_retain_type_base(member_end, next_cursor)
        }
    }

    state retain_unit_type_base(member_end: i32, next_cursor: i32) {
        self.type_references[self.type_reference_count].kind =
            OmegaTypeReferenceKind::Unit;
        transition true {
            true -> finish_retain_type_base(member_end, next_cursor)
        }
    }

    state finish_retain_type_base(member_end: i32, next_cursor: i32) {
        self.type_root = self.type_reference_count;
        self.type_reference_count = self.type_reference_count + 1;
        self.type_array_emit_index = self.type_array_frame_count - 1;
        transition true { true -> retain_type_array_nodes(member_end, next_cursor) }
    }

    state retain_type_array_nodes(member_end: i32, next_cursor: i32) {
        transition self.type_array_emit_index >= 0 {
            true -> retain_type_array_node(member_end, next_cursor)
            _ -> retain_type_constraint_node(member_end, next_cursor)
        }
    }

    state retain_type_array_node(member_end: i32, next_cursor: i32) {
        transition self.type_array_frames[self.type_array_emit_index].kind {
            OmegaTypeArrayKind::FixedArray -> retain_fixed_array_type_node(
                member_end,
                next_cursor
            )
            OmegaTypeArrayKind::Slice -> retain_slice_type_node(
                member_end,
                next_cursor
            )
        }
    }

    state retain_fixed_array_type_node(member_end: i32, next_cursor: i32) {
        self.type_references[self.type_reference_count].kind =
            OmegaTypeReferenceKind::FixedArray;
        self.type_references[self.type_reference_count].payload0 =
            self.type_root;
        self.type_references[self.type_reference_count].payload1 =
            self.type_array_frames[self.type_array_emit_index].length_start;
        self.type_references[self.type_reference_count].payload2 =
            self.type_array_frames[self.type_array_emit_index].length_end;
        transition true {
            true -> finish_retain_type_array_node(member_end, next_cursor)
        }
    }

    state retain_slice_type_node(member_end: i32, next_cursor: i32) {
        self.type_references[self.type_reference_count].kind =
            OmegaTypeReferenceKind::Slice;
        self.type_references[self.type_reference_count].payload0 = self.type_root;
        transition true {
            true -> finish_retain_type_array_node(member_end, next_cursor)
        }
    }

    state finish_retain_type_array_node(member_end: i32, next_cursor: i32) {
        self.type_root = self.type_reference_count;
        self.type_reference_count = self.type_reference_count + 1;
        self.type_array_emit_index = self.type_array_emit_index - 1;
        transition true { true -> retain_type_array_nodes(member_end, next_cursor) }
    }

    state retain_type_constraint_node(member_end: i32, next_cursor: i32) {
        transition self.type_constraint_mode {
            1 -> retain_type_constraint_node_bounded(member_end, next_cursor)
            2 -> retain_type_constraint_node_bounded(member_end, next_cursor)
            _ -> retain_type_reference_node(member_end, next_cursor)
        }
    }

    state retain_type_constraint_node_bounded(
        member_end: i32,
        next_cursor: i32
    ) {
        self.type_references[self.type_reference_count].kind =
            OmegaTypeReferenceKind::Constrained;
        self.type_references[self.type_reference_count].payload0 =
            self.type_root;
        self.type_references[self.type_reference_count].payload1 =
            self.type_constraint_count;
        self.type_references[self.type_reference_count].payload2 = 1;
        self.type_root = self.type_reference_count;
        self.type_constraint_count = self.type_constraint_count + 1;
        self.type_reference_count = self.type_reference_count + 1;
        transition true {
            true -> retain_type_reference_node(member_end, next_cursor)
        }
    }

    state retain_type_reference_node(member_end: i32, next_cursor: i32) {
        transition self.type_has_reference {
            1 -> begin_retain_type_reference(member_end, next_cursor)
            _ -> retain_type_consumer_row(member_end, next_cursor)
        }
    }

    state begin_retain_type_reference(member_end: i32, next_cursor: i32) {
        self.type_references[self.type_reference_count].kind =
            OmegaTypeReferenceKind::Reference;
        self.type_references[self.type_reference_count].payload0 = self.type_root;
        self.type_references[self.type_reference_count].payload2 =
            self.type_reference_has_lifetime;
        self.type_references[self.type_reference_count].payload3 =
            self.type_reference_lifetime_start;
        self.type_references[self.type_reference_count].payload4 =
            self.type_reference_lifetime_end;
        transition self.type_reference_access {
            OmegaReferenceAccess::Shared -> retain_shared_type_reference(
                member_end,
                next_cursor
            )
            OmegaReferenceAccess::Mutable -> retain_mutable_type_reference(
                member_end,
                next_cursor
            )
            OmegaReferenceAccess::WriteOnly -> retain_write_type_reference(
                member_end,
                next_cursor
            )
        }
    }

    state retain_shared_type_reference(member_end: i32, next_cursor: i32) {
        self.type_references[self.type_reference_count].payload1 = 0;
        transition true {
            true -> finish_retain_type_reference(member_end, next_cursor)
        }
    }

    state retain_mutable_type_reference(member_end: i32, next_cursor: i32) {
        self.type_references[self.type_reference_count].payload1 = 1;
        transition true {
            true -> finish_retain_type_reference(member_end, next_cursor)
        }
    }

    state retain_write_type_reference(member_end: i32, next_cursor: i32) {
        self.type_references[self.type_reference_count].payload1 = 2;
        transition true {
            true -> finish_retain_type_reference(member_end, next_cursor)
        }
    }

    state finish_retain_type_reference(member_end: i32, next_cursor: i32) {
        self.type_root = self.type_reference_count;
        self.type_reference_count = self.type_reference_count + 1;
        transition true {
            true -> retain_type_consumer_row(member_end, next_cursor)
        }
    }

    state retain_type_consumer_row(member_end: i32, next_cursor: i32) {
        transition self.type_consumer {
            OmegaTypeConsumer::DirectDataField -> retain_direct_data_field_bounded(
                member_end,
                next_cursor
            )
            OmegaTypeConsumer::CasePayloadField -> retain_case_payload_field_bounded(
                member_end,
                next_cursor
            )
            OmegaTypeConsumer::MachineParameter -> retain_machine_parameter_by_reference(
                next_cursor
            )
            OmegaTypeConsumer::MachineReturn -> retain_machine_return_type(
                next_cursor
            )
        }
    }

    state retain_machine_return_type(next_cursor: i32) {
        self.state_has_return_type = 1;
        self.state_return_type = self.type_root;
        self.cursor = next_cursor;
        transition true { true -> resume_state_body() }
    }

    state retain_machine_parameter_by_reference(next_cursor: i32) {
        transition self.type_reference_is_exclusive {
            1 -> retain_exclusive_machine_parameter(next_cursor)
            _ -> retain_machine_parameter_bounded(next_cursor)
        }
    }

    state retain_exclusive_machine_parameter(next_cursor: i32) {
        self.machine_parameter_is_mutable = 1;
        transition true { true -> retain_machine_parameter_bounded(next_cursor) }
    }

    state retain_machine_parameter_bounded(next_cursor: i32) {
        self.machine_parameters[self.machine_parameter_count].name.start =
            self.type_subject_name_start;
        self.machine_parameters[self.machine_parameter_count].name.end =
            self.type_subject_name_end;
        self.machine_parameters[self.machine_parameter_count].type_reference =
            self.type_root;
        self.machine_parameters[self.machine_parameter_count].is_const =
            self.machine_parameter_is_const;
        self.machine_parameters[self.machine_parameter_count].is_mutable =
            self.machine_parameter_is_mutable;
        self.machine_parameters[self.machine_parameter_count].is_self =
            self.machine_parameter_is_self;
        self.machine_parameter_count = self.machine_parameter_count + 1;
        self.cursor = next_cursor;
        transition self.machine_parameter_has_more {
            1 -> scan_semantic(31)
            _ -> scan_semantic(29)
        }
    }

    state retain_direct_data_field_bounded(
        member_end: i32,
        next_cursor: i32
    ) {
        self.data_fields[self.data_field_count].name.start =
            self.type_subject_name_start;
        self.data_fields[self.data_field_count].name.end =
            self.type_subject_name_end;
        self.data_fields[self.data_field_count].type_reference =
            self.type_root;
        self.data_fields[self.data_field_count].start = self.type_subject_start;
        self.data_fields[self.data_field_count].end = member_end;
        self.data_members[self.data_member_count].kind =
            OmegaDataMemberKind::Field;
        self.data_members[self.data_member_count].item_index =
            self.data_field_count;
        self.data_field_count = self.data_field_count + 1;
        self.data_member_count = self.data_member_count + 1;
        self.cursor = next_cursor;
        transition true { true -> scan_semantic(9) }
    }

    state retain_case_payload_field_bounded(
        member_end: i32,
        next_cursor: i32
    ) {
        self.data_payload_fields[self.data_payload_field_count].name.start =
            self.type_subject_name_start;
        self.data_payload_fields[self.data_payload_field_count].name.end =
            self.type_subject_name_end;
        self.data_payload_fields[self.data_payload_field_count].type_reference =
            self.type_root;
        self.data_payload_fields[self.data_payload_field_count].start =
            self.type_subject_start;
        self.data_payload_fields[self.data_payload_field_count].end = member_end;
        self.data_payload_field_count = self.data_payload_field_count + 1;
        self.cursor = next_cursor;
        transition true { true -> scan_semantic(15) }
    }

    state retain_data() {
        self.data_items[self.data_count].name.start = self.data_name_start;
        self.data_items[self.data_count].name.end = self.data_name_end;
        self.data_items[self.data_count].first_member = self.data_first_member;
        self.data_items[self.data_count].member_count =
            self.data_member_count - self.data_first_member;
        self.data_items[self.data_count].first_field = self.data_first_field;
        self.data_items[self.data_count].field_count =
            self.data_field_count - self.data_first_field;
        self.data_items[self.data_count].first_case = self.data_first_case;
        self.data_items[self.data_count].case_count =
            self.data_case_count - self.data_first_case;
        self.data_items[self.data_count].multiplicity = self.data_multiplicity;
        self.data_items[self.data_count].is_public = self.data_is_public;
        self.data_items[self.data_count].start = self.item_start;
        self.data_items[self.data_count].end = self.scan.token_end;
        self.roots[self.root_count].kind = OmegaRootKind::Data;
        self.roots[self.root_count].item_index = self.data_count;
        self.data_count = self.data_count + 1;
        self.root_count = self.root_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(0) }
    }

    state syntax_failure(
        code: OmegaParseDiagnosticCode,
        start: i32,
        end: i32
    ) {
        self.status = OmegaParserStatus::SyntaxFailure;
        self.diagnostic_code = code;
        self.diagnostic_start = start;
        self.diagnostic_end = end;
    }

    state resource_failure(
        kind: OmegaParserResource,
        limit: i32,
        requested: i32
    ) {
        self.status = OmegaParserStatus::ResourceFailure;
        self.resource = kind;
        self.resource_limit = limit;
        self.resource_requested = requested;
        self.diagnostic_start = self.scan.token_start;
        self.diagnostic_end = self.scan.token_end;
    }

    state complete() {
        self.status = OmegaParserStatus::Complete;
    }

    state internal_failure() {
        self.status = OmegaParserStatus::InternalFailure;
    }
}

machine AlphaTapeBuffer::initialize(&mut self) {
    self.length = 0;
    self.label_count = 0;
    self.fixup_count = 0;
    self.status = 0;
    self.failure_offset = 0;
    self.failure_requested = 0;
    self.finalized = 0;
}

machine AlphaTapeBuffer::payload_length(&mut self) -> i32 {
    return self.length;
}

machine AlphaTapeBuffer::is_open(&mut self) -> i32 {
    transition self.status {
        0 -> check_finalized()
        _ -> return 0
    }

    state check_finalized() {
        transition self.finalized {
            0 -> return 1
            _ -> return 0
        }
    }
}

machine AlphaTapeBuffer::fail_internal(&mut self, detail: i32) -> i32 {
    transition self.is_open() {
        1 -> record_failure()
        _ -> return 0
    }

    state record_failure() {
        self.status = 2;
        self.failure_offset = self.length;
        self.failure_requested = detail;
        return 0;
    }
}

machine AlphaTapeBuffer::fail_capacity(&mut self, detail: i32) -> i32 {
    transition self.is_open() {
        1 -> record_failure()
        _ -> return 0
    }

    state record_failure() {
        self.status = 1;
        self.failure_offset = self.length;
        self.failure_requested = detail;
        return 0;
    }
}

machine AlphaTapeBuffer::fail_structure(
    &mut self,
    payload_offset: i32,
    detail: i32
) -> i32 {
    transition self.is_open() {
        1 -> record_failure()
        _ -> return 0
    }

    state record_failure() {
        self.status = 2;
        self.failure_offset = payload_offset;
        self.failure_requested = detail;
        return 0;
    }
}

// Return width + 16 * address-operand offset. An offset of zero means that the
// instruction has no direct target. Zero is not an Alpha instruction.
machine alpha_instruction_shape(opcode: i32) -> i32 {
    transition opcode {
        0 -> return 2
        1 -> return 10
        2 -> return 3
        3 -> return 3
        4 -> return 3
        5 -> return 3
        6 -> return 3
        7 -> return 3
        8 -> return 3
        9 -> return 3
        10 -> return 3
        11 -> return 3
        12 -> return 25
        13 -> return 42
        14 -> return 42
        15 -> return 59
        16 -> return 59
        17 -> return 2
        18 -> return 2
        19 -> return 25
        20 -> return 1
        _ -> return 0
    }
}

// Labels are monotonic compiler-owned IDs. A label is defined at most once;
// aliases at one instruction start use distinct IDs and remain explicit.
machine AlphaTapeBuffer::new_label(&mut self) -> i32 {
    transition self.is_open() {
        1 -> check_capacity()
        _ -> return -1
    }

    state check_capacity() {
        transition (self.label_count >= 0) && (self.label_count < 262140) {
            true -> allocate()
            _ -> classify_count()
        }
    }

    state classify_count() {
        transition self.label_count {
            262140 -> capacity()
            _ -> invalid_count()
        }
    }

    state allocate() {
        let label: i32 = self.label_count;
        self.label_offsets[label] = 0;
        self.label_defined[label] = 0;
        self.label_count = self.label_count + 1;
        return label;
    }

    state invalid_count() {
        self.fail_internal(self.label_count);
        return -1;
    }

    state capacity() {
        self.fail_capacity(262141);
        return -1;
    }
}

machine AlphaTapeBuffer::define_label(&mut self, label: i32) -> i32 {
    transition self.is_open() {
        1 -> check_profile()
        _ -> return 0
    }

    state check_profile() {
        transition (self.label_count >= 0) &&
            (self.label_count <= 262140) &&
            (self.length >= 0) &&
            (self.length <= 262140) {
            true -> check_low()
            _ -> invalid_profile()
        }
    }

    state check_low() {
        transition label >= 0 {
            true -> check_high()
            _ -> invalid_label()
        }
    }

    state check_high() {
        transition label < self.label_count {
            true -> check_unbound()
            _ -> invalid_label()
        }
    }

    state check_unbound() {
        transition self.label_defined[label] {
            0 -> bind()
            _ -> invalid_label()
        }
    }

    state bind() {
        self.label_offsets[label] = self.length;
        self.label_defined[label] = 1;
        return 1;
    }

    state invalid_label() {
        return self.fail_internal(label);
    }

    state invalid_profile() {
        return self.fail_internal(self.label_count);
    }
}

// Reserve an entire instruction before any of its bytes are written. This is
// the atomicity boundary for every emitter below.
machine AlphaTapeBuffer::reserve(&mut self, count: i32) -> i32 {
    transition self.is_open() {
        1 -> check_length()
        _ -> return 0
    }

    state check_length() {
        transition (self.length >= 0) && (self.length <= 262140) {
            true -> check_count()
            _ -> corrupt_length()
        }
    }

    state check_count() {
        transition count >= 0 {
            true -> check_capacity()
            _ -> invalid_count()
        }
    }

    state check_capacity() {
        transition count <= 262140 - self.length {
            true -> return 1
            _ -> capacity()
        }
    }

    state corrupt_length() {
        self.status = 2;
        self.failure_offset = 0;
        self.failure_requested = self.length;
        return 0;
    }

    state invalid_count() {
        self.status = 2;
        self.failure_offset = self.length;
        self.failure_requested = count;
        return 0;
    }

    state capacity() {
        self.status = 1;
        self.failure_offset = self.length;
        self.failure_requested = count;
        return 0;
    }
}

// Checked emitters reserve a full instruction before entering these writers.
// Delta has no private visibility, so each writer also defends its complete
// direct call: it cannot bypass sealing, trap on u8 range, or partially cross
// the tape capacity.
machine AlphaTapeBuffer::write_reserved_byte(&mut self, value: i32) {
    transition self.is_open() {
        1 -> check_value()
        _ -> return
    }

    state check_value() {
        transition (value >= 0) && (value <= 255) {
            true -> check_capacity()
            _ -> invalid_value()
        }
    }

    state check_capacity() {
        transition self.reserve(1) {
            true -> write_byte()
            _ -> return
        }
    }

    state write_byte() {
        self.bytes[self.length] = value;
        self.length = self.length + 1;
        return;
    }

    state invalid_value() {
        self.fail_internal(value);
        return;
    }

}

machine AlphaTapeBuffer::write_reserved_word(&mut self, value: i32) {
    transition self.reserve(4) {
        1 -> write_word()
        _ -> return
    }

    state write_word() {
        self.write_reserved_byte(value & 255);
        self.write_reserved_byte((value >> 8) & 255);
        self.write_reserved_byte((value >> 16) & 255);
        self.write_reserved_byte((value >> 24) & 255);
        return;
    }
}

machine AlphaTapeBuffer::write_reserved_address(&mut self, target: i32) {
    transition self.is_open() {
        1 -> check_target()
        _ -> return
    }

    state check_target() {
        transition (target >= 0) && (target <= 262139) {
            true -> check_capacity()
            _ -> invalid_target()
        }
    }

    state check_capacity() {
        transition self.reserve(8) {
            1 -> write_address()
            _ -> return
        }
    }

    state write_address() {
        self.write_reserved_word(target);
        self.write_reserved_word(0);
        return;
    }

    state invalid_target() {
        self.fail_internal(target);
        return;
    }
}

// Shape r: halt(0), read(17), write(18). Width 2.
machine AlphaTapeBuffer::emit_r(&mut self, opcode: i32, register: i32) -> i32 {
    transition self.is_open() {
        1 -> check_opcode()
        _ -> return 0
    }

    state check_opcode() {
        transition (opcode == 0) || (opcode == 17) || (opcode == 18) {
            true -> check_register()
            _ -> invalid_opcode()
        }
    }

    state check_register() {
        transition (register >= 0) && (register <= 255) {
            true -> reserve_instruction()
            _ -> invalid_register()
        }
    }

    state reserve_instruction() {
        transition self.reserve(2) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(opcode);
        self.write_reserved_byte(register);
        return 1;
    }

    state invalid_opcode() {
        return self.fail_internal(opcode);
    }

    state invalid_register() {
        return self.fail_internal(register);
    }
}

// Shape r,r: mov through store (2..11). Width 3.
machine AlphaTapeBuffer::emit_rr(
    &mut self,
    opcode: i32,
    left: i32,
    right: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_opcode()
        _ -> return 0
    }

    state check_opcode() {
        transition (opcode >= 2) && (opcode <= 11) {
            true -> check_left()
            _ -> invalid_opcode()
        }
    }

    state check_left() {
        transition (left >= 0) && (left <= 255) {
            true -> check_right()
            _ -> invalid_left()
        }
    }

    state check_right() {
        transition (right >= 0) && (right <= 255) {
            true -> reserve_instruction()
            _ -> invalid_right()
        }
    }

    state reserve_instruction() {
        transition self.reserve(3) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(opcode);
        self.write_reserved_byte(left);
        self.write_reserved_byte(right);
        return 1;
    }

    state invalid_opcode() {
        return self.fail_internal(opcode);
    }

    state invalid_left() {
        return self.fail_internal(left);
    }

    state invalid_right() {
        return self.fail_internal(right);
    }
}

// imm(1) carries an arbitrary 64-bit pattern as low and high i32 halves.
// Width 10.
machine AlphaTapeBuffer::emit_imm(
    &mut self,
    register: i32,
    low: i32,
    high: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_register()
        _ -> return 0
    }

    state check_register() {
        transition (register >= 0) && (register <= 255) {
            true -> reserve_instruction()
            _ -> invalid_register()
        }
    }

    state reserve_instruction() {
        transition self.reserve(10) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(1);
        self.write_reserved_byte(register);
        self.write_reserved_word(low);
        self.write_reserved_word(high);
        return 1;
    }

    state invalid_register() {
        return self.fail_internal(register);
    }
}

// Shape address: jmp(12), call(19). Width 9.
machine AlphaTapeBuffer::emit_jump(
    &mut self,
    opcode: i32,
    target: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_opcode()
        _ -> return 0
    }

    state check_opcode() {
        transition (opcode == 12) || (opcode == 19) {
            true -> check_target()
            _ -> invalid_opcode()
        }
    }

    state check_target() {
        transition (target >= 0) && (target <= 262139) {
            true -> reserve_instruction()
            _ -> invalid_target()
        }
    }

    state reserve_instruction() {
        transition self.reserve(9) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(opcode);
        self.write_reserved_address(target);
        return 1;
    }

    state invalid_opcode() {
        return self.fail_internal(opcode);
    }

    state invalid_target() {
        return self.fail_internal(target);
    }
}

// Shape r,address: jz(13), jnz(14). Width 10.
machine AlphaTapeBuffer::emit_rx(
    &mut self,
    opcode: i32,
    register: i32,
    target: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_opcode()
        _ -> return 0
    }

    state check_opcode() {
        transition (opcode == 13) || (opcode == 14) {
            true -> check_register()
            _ -> invalid_opcode()
        }
    }

    state check_register() {
        transition (register >= 0) && (register <= 255) {
            true -> check_target()
            _ -> invalid_register()
        }
    }

    state check_target() {
        transition (target >= 0) && (target <= 262139) {
            true -> reserve_instruction()
            _ -> invalid_target()
        }
    }

    state reserve_instruction() {
        transition self.reserve(10) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(opcode);
        self.write_reserved_byte(register);
        self.write_reserved_address(target);
        return 1;
    }

    state invalid_opcode() {
        return self.fail_internal(opcode);
    }

    state invalid_register() {
        return self.fail_internal(register);
    }

    state invalid_target() {
        return self.fail_internal(target);
    }
}

// Shape r,r,address: jlt(15), jeq(16). Width 11.
machine AlphaTapeBuffer::emit_rrx(
    &mut self,
    opcode: i32,
    left: i32,
    right: i32,
    target: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_opcode()
        _ -> return 0
    }

    state check_opcode() {
        transition (opcode == 15) || (opcode == 16) {
            true -> check_left()
            _ -> invalid_opcode()
        }
    }

    state check_left() {
        transition (left >= 0) && (left <= 255) {
            true -> check_right()
            _ -> invalid_left()
        }
    }

    state check_right() {
        transition (right >= 0) && (right <= 255) {
            true -> check_target()
            _ -> invalid_right()
        }
    }

    state check_target() {
        transition (target >= 0) && (target <= 262139) {
            true -> reserve_instruction()
            _ -> invalid_target()
        }
    }

    state reserve_instruction() {
        transition self.reserve(11) {
            1 -> write_instruction()
            _ -> return 0
        }
    }

    state write_instruction() {
        self.write_reserved_byte(opcode);
        self.write_reserved_byte(left);
        self.write_reserved_byte(right);
        self.write_reserved_address(target);
        return 1;
    }

    state invalid_opcode() {
        return self.fail_internal(opcode);
    }

    state invalid_left() {
        return self.fail_internal(left);
    }

    state invalid_right() {
        return self.fail_internal(right);
    }

    state invalid_target() {
        return self.fail_internal(target);
    }
}

// ret(20). Width 1.
machine AlphaTapeBuffer::emit_ret(&mut self) -> i32 {
    transition self.reserve(1) {
        1 -> write_instruction()
        _ -> return 0
    }

    state write_instruction() {
        self.write_reserved_byte(20);
        return 1;
    }
}

// Record the one address operand of the most recently emitted instruction.
// Strictly increasing operand offsets give every fixup one owner and reject
// duplicate registration without a second bitmap.
machine AlphaTapeBuffer::record_fixup(
    &mut self,
    label: i32,
    instruction_start: i32,
    operand_offset: i32
) -> i32 {
    transition self.is_open() {
        1 -> check_profile()
        _ -> return 0
    }

    state check_profile() {
        transition (self.length >= 0) &&
            (self.length <= 262140) &&
            (self.label_count >= 0) &&
            (self.label_count <= 262140) {
            true -> check_label_low()
            _ -> invalid_profile()
        }
    }

    state check_label_low() {
        transition label >= 0 {
            true -> check_label_high()
            _ -> invalid_label()
        }
    }

    state check_label_high() {
        transition label < self.label_count {
            true -> check_instruction_low()
            _ -> invalid_label()
        }
    }

    state check_instruction_low() {
        transition instruction_start >= 0 {
            true -> check_instruction_high()
            _ -> invalid_instruction()
        }
    }

    state check_instruction_high() {
        transition instruction_start < self.length {
            true -> check_shape()
            _ -> invalid_instruction()
        }
    }

    state check_shape() {
        let shape: i32 = alpha_instruction_shape(
            self.bytes[instruction_start]
        );
        transition shape / 16 {
            0 -> invalid_instruction()
            _ -> check_operand(shape)
        }
    }

    state check_operand(shape: i32) {
        transition operand_offset == instruction_start + (shape / 16) {
            true -> check_instruction_end(shape)
            _ -> invalid_operand()
        }
    }

    state check_instruction_end(shape: i32) {
        transition instruction_start + (shape % 16) == self.length {
            true -> check_count()
            _ -> invalid_instruction()
        }
    }

    state check_count() {
        transition (self.fixup_count >= 0) && (self.fixup_count < 29126) {
            true -> check_order()
            _ -> invalid_count()
        }
    }

    state check_order() {
        transition self.fixup_count {
            0 -> record()
            _ -> check_previous()
        }
    }

    state check_previous() {
        let previous: i32 = self.fixup_operands[self.fixup_count - 1];
        transition previous < operand_offset {
            true -> record()
            _ -> invalid_operand()
        }
    }

    state record() {
        let fixup: i32 = self.fixup_count;
        self.fixup_labels[fixup] = label;
        self.fixup_instructions[fixup] = instruction_start;
        self.fixup_operands[fixup] = operand_offset;
        self.fixup_resolved[fixup] = 0;
        self.fixup_count = self.fixup_count + 1;
        return 1;
    }

    state invalid_label() {
        return self.fail_structure(instruction_start, label);
    }

    state invalid_instruction() {
        return self.fail_structure(instruction_start, operand_offset);
    }

    state invalid_operand() {
        return self.fail_structure(instruction_start, operand_offset);
    }

    state invalid_count() {
        return self.fail_structure(instruction_start, self.fixup_count);
    }

    state invalid_profile() {
        return self.fail_structure(instruction_start, self.length);
    }
}

machine AlphaTapeBuffer::emit_jump_label(
    &mut self,
    opcode: i32,
    label: i32
) -> i32 {
    let instruction_start: i32 = self.length;
    transition self.emit_jump(opcode, 0) {
        1 -> own_fixup(instruction_start)
        _ -> return 0
    }

    state own_fixup(instruction_start: i32) {
        return self.record_fixup(
            label,
            instruction_start,
            instruction_start + 1
        );
    }
}

machine AlphaTapeBuffer::emit_rx_label(
    &mut self,
    opcode: i32,
    register: i32,
    label: i32
) -> i32 {
    let instruction_start: i32 = self.length;
    transition self.emit_rx(opcode, register, 0) {
        1 -> own_fixup(instruction_start)
        _ -> return 0
    }

    state own_fixup(instruction_start: i32) {
        return self.record_fixup(
            label,
            instruction_start,
            instruction_start + 2
        );
    }
}

machine AlphaTapeBuffer::emit_rrx_label(
    &mut self,
    opcode: i32,
    left: i32,
    right: i32,
    label: i32
) -> i32 {
    let instruction_start: i32 = self.length;
    transition self.emit_rrx(opcode, left, right, 0) {
        1 -> own_fixup(instruction_start)
        _ -> return 0
    }

    state own_fixup(instruction_start: i32) {
        return self.record_fixup(
            label,
            instruction_start,
            instruction_start + 3
        );
    }
}

// Bind every recorded symbolic target exactly through its recorded operand.
// A second call is idempotent, but no fixup can be skipped or redirected.
machine AlphaTapeBuffer::resolve_fixups(&mut self) -> i32 {
    transition self.is_open() {
        1 -> rebuild_partition()
        _ -> return 0
    }

    state rebuild_partition() {
        transition self.rebuild_instruction_partition() {
            1 -> check_count()
            _ -> return 0
        }
    }

    state check_count() {
        transition (self.fixup_count >= 0) && (self.fixup_count <= 29126) {
            true -> check_label_count()
            _ -> invalid_count()
        }
    }

    state check_label_count() {
        transition (self.label_count >= 0) && (self.label_count <= 262140) {
            true -> resolve(0)
            _ -> invalid_label_count()
        }
    }

    state resolve(fixup: i32) {
        transition fixup < self.fixup_count {
            true -> check_resolved(fixup)
            _ -> return 1
        }
    }

    state check_resolved(fixup: i32) {
        transition self.fixup_resolved[fixup] {
            0 -> check_label(fixup)
            1 -> next(fixup)
            _ -> invalid_fixup(fixup)
        }
    }

    state check_label(fixup: i32) {
        let label: i32 = self.fixup_labels[fixup];
        transition (label >= 0) && (label < self.label_count) {
            true -> check_defined(fixup, label)
            _ -> invalid_fixup(fixup)
        }
    }

    state check_defined(fixup: i32, label: i32) {
        transition self.label_defined[label] {
            1 -> check_target(fixup, label)
            _ -> invalid_fixup(fixup)
        }
    }

    state check_target(fixup: i32, label: i32) {
        let target: i32 = self.label_offsets[label];
        transition (target >= 0) && (target < self.length) {
            true -> check_owner(fixup, target)
            _ -> invalid_fixup(fixup)
        }
    }

    state check_owner(fixup: i32, target: i32) {
        let instruction_start: i32 = self.fixup_instructions[fixup];
        let operand_offset: i32 = self.fixup_operands[fixup];
        transition (instruction_start >= 0) &&
            (instruction_start < self.length) &&
            (operand_offset >= 0) &&
            (operand_offset <= self.length - 8) {
            true -> check_owner_start(
                fixup,
                instruction_start,
                operand_offset,
                target
            )
            _ -> invalid_fixup(fixup)
        }
    }

    state check_owner_start(
        fixup: i32,
        instruction_start: i32,
        operand_offset: i32,
        target: i32
    ) {
        transition self.instruction_starts[instruction_start] {
            1 -> inspect_owner(fixup, instruction_start, operand_offset, target)
            _ -> invalid_fixup(fixup)
        }
    }

    state inspect_owner(
        fixup: i32,
        instruction_start: i32,
        operand_offset: i32,
        target: i32
    ) {
        let shape: i32 = alpha_instruction_shape(
            self.bytes[instruction_start]
        );
        transition (shape / 16 != 0) &&
            (operand_offset == instruction_start + (shape / 16)) {
            true -> write_fixup(fixup, operand_offset, target)
            _ -> invalid_fixup(fixup)
        }
    }

    state write_fixup(fixup: i32, operand_offset: i32, target: i32) {
        let index: i32 = operand_offset;
        self.bytes[index] = target & 255;
        self.bytes[index + 1] = (target >> 8) & 255;
        self.bytes[index + 2] = (target >> 16) & 255;
        self.bytes[index + 3] = (target >> 24) & 255;
        self.bytes[index + 4] = 0;
        self.bytes[index + 5] = 0;
        self.bytes[index + 6] = 0;
        self.bytes[index + 7] = 0;
        self.fixup_resolved[fixup] = 1;
        transition true {
            true -> next(fixup)
        }
    }

    state next(fixup: i32) {
        transition true {
            true -> resolve(fixup + 1)
        }
    }

    state invalid_count() {
        return self.fail_structure(0, self.fixup_count);
    }

    state invalid_label_count() {
        return self.fail_structure(0, self.label_count);
    }

    state invalid_fixup(fixup: i32) {
        return self.fail_structure(
            self.fixup_instructions[fixup],
            self.fixup_operands[fixup]
        );
    }
}

// Decode the canonical in-tape address form produced by this encoder. Alpha
// addresses are 64-bit, but every compiler-generated direct target is a
// nonnegative offset inside the at-most-262140-byte payload. Return -1 when
// high bytes make that final form noncanonical.
machine AlphaTapeBuffer::decode_address(&mut self, payload_offset: i32) -> i32 {
    transition (self.length >= 0) && (self.length <= 262140) {
        true -> check_offset()
        _ -> return -1
    }

    state check_offset() {
        transition payload_offset >= 0 {
            true -> check_extent()
            _ -> return -1
        }
    }

    state check_extent() {
        transition payload_offset <= self.length - 8 {
            true -> decode()
            _ -> return -1
        }
    }

    state decode() {
        let index: i32 = payload_offset;
        transition (self.bytes[index + 3] == 0) &&
            (self.bytes[index + 4] == 0) &&
            (self.bytes[index + 5] == 0) &&
            (self.bytes[index + 6] == 0) &&
            (self.bytes[index + 7] == 0) {
            true -> return self.bytes[index] +
                (self.bytes[index + 1] * 256) +
                (self.bytes[index + 2] * 65536)
            _ -> return -1
        }
    }
}

// Reconstruct the payload's unique instruction partition without interpreting
// direct targets. Finalization runs this over the unpatched bytes so a fixup
// owner cannot be forged from an opcode-looking immediate or register byte.
machine AlphaTapeBuffer::rebuild_instruction_partition(&mut self) -> i32 {
    transition self.is_open() {
        1 -> check_length()
        _ -> return 0
    }

    state check_length() {
        transition (self.length > 0) && (self.length <= 262140) {
            true -> clear_starts(0)
            _ -> invalid_length()
        }
    }

    state clear_starts(cursor: i32) {
        transition cursor < self.length {
            true -> clear_start(cursor)
            _ -> first_scan(0)
        }
    }

    state clear_start(cursor: i32) {
        self.instruction_starts[cursor] = 0;
        transition true {
            true -> clear_starts(cursor + 1)
        }
    }

    state first_scan(pc: i32) {
        transition pc < self.length {
            true -> first_instruction(pc)
            _ -> return 1
        }
    }

    state first_instruction(pc: i32) {
        let opcode: i32 = self.bytes[pc];
        let shape: i32 = alpha_instruction_shape(opcode);
        transition shape {
            0 -> invalid_instruction(pc, opcode)
            _ -> first_extent(pc, shape % 16)
        }
    }

    state first_extent(pc: i32, width: i32) {
        transition width <= self.length - pc {
            true -> mark_start(pc, width)
            _ -> invalid_instruction(pc, width)
        }
    }

    state mark_start(pc: i32, width: i32) {
        self.instruction_starts[pc] = 1;
        transition true {
            true -> first_scan(pc + width)
        }
    }

    state invalid_length() {
        return self.fail_structure(0, self.length);
    }

    state invalid_instruction(pc: i32, detail: i32) {
        return self.fail_structure(pc, detail);
    }
}

// Replay the completed payload independently of emitter call order. Rebuild
// its partition, then require every direct jump/call target to land on a
// reconstructed instruction start. Inline data and implicit zero-filled suffix
// instructions are deliberately not admitted.
machine AlphaTapeBuffer::validate_structure(&mut self) -> i32 {
    transition self.rebuild_instruction_partition() {
        1 -> second_scan(0)
        _ -> return 0
    }

    state second_scan(pc: i32) {
        transition pc < self.length {
            true -> second_instruction(pc)
            _ -> return 1
        }
    }

    state second_instruction(pc: i32) {
        let shape: i32 = alpha_instruction_shape(self.bytes[pc]);
        let width: i32 = shape % 16;
        let target_delta: i32 = shape / 16;
        transition target_delta {
            0 -> second_advance(pc, width)
            _ -> decode_target(pc, width, target_delta)
        }
    }

    state decode_target(pc: i32, width: i32, target_delta: i32) {
        let target: i32 = self.decode_address(pc + target_delta);
        transition target >= 0 {
            true -> check_target_extent(pc, width, target)
            _ -> invalid_instruction(pc, target)
        }
    }

    state check_target_extent(pc: i32, width: i32, target: i32) {
        transition target < self.length {
            true -> check_target_start(pc, width, target)
            _ -> invalid_instruction(pc, target)
        }
    }

    state check_target_start(pc: i32, width: i32, target: i32) {
        transition self.instruction_starts[target] {
            1 -> second_advance(pc, width)
            _ -> invalid_instruction(pc, target)
        }
    }

    state second_advance(pc: i32, width: i32) {
        transition true {
            true -> second_scan(pc + width)
        }
    }

    state invalid_instruction(pc: i32, detail: i32) {
        return self.fail_structure(pc, detail);
    }
}

// Seal the exact raw Alpha payload. Native seed stamping owns the descriptive
// four-byte length prefix; it is not part of a `.tape` or compiler identity.
// Once finalized, no instruction or fixup may modify the payload.
machine AlphaTapeBuffer::finalize(&mut self) -> i32 {
    transition self.is_open() {
        1 -> check_payload()
        _ -> return 0
    }

    state check_payload() {
        transition (self.length > 0) && (self.length <= 262140) {
            true -> resolve_payload()
            _ -> invalid_payload()
        }
    }

    state resolve_payload() {
        transition self.resolve_fixups() {
            1 -> replay_payload()
            _ -> return 0
        }
    }

    state replay_payload() {
        transition self.validate_structure() {
            1 -> seal()
            _ -> return 0
        }
    }

    state seal() {
        self.finalized = 1;
        return 1;
    }

    state invalid_payload() {
        return self.fail_internal(self.length);
    }
}
