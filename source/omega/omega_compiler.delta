            1 -> incomplete_root()
            _ -> retain_type_name()
        }
    }

    state type_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> retain_type_self()
            OmegaKeywordKind::SelfValue -> incomplete_root()
            _ -> retain_type_name()
        }
    }

    state retain_type_self() {
        self.type_base_kind = OmegaTypeBaseKind::SelfType;
        self.type_end = self.scan.token_end;
        self.type_allows_range = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(14) }
    }

    state type_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBracket -> begin_type_array()
            OmegaPunctuationKind::Ampersand -> begin_type_reference()
            OmegaPunctuationKind::LeftParen -> begin_unit_type()
            OmegaPunctuationKind::Hash -> incomplete_root()
            _ -> type_missing_failure(
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_unit_type() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(40) }
    }

    state unit_type_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> unit_type_end_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state unit_type_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightParen -> retain_unit_type()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state retain_unit_type() {
        self.type_base_kind = OmegaTypeBaseKind::Unit;
        self.type_end = self.scan.token_end;
        self.type_allows_range = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(14) }
    }

    state begin_type_reference() {
        self.type_has_reference = 1;
        self.type_reference_access = OmegaReferenceAccess::Shared;
        self.type_reference_is_exclusive = 0;
        self.type_reference_has_lifetime = 0;
        self.type_reference_lifetime_start = 0;
        self.type_reference_lifetime_end = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(37) }
    }

    state type_reference_access_or_type_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> type_reference_access_or_type_identifier()
            OmegaTokenKind::Keyword -> type_token()
            OmegaTokenKind::Punctuation -> type_reference_prefix_punctuation()
            _ -> type_missing_failure(
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state type_reference_access_or_type_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "mut"
        ) {
            1 -> retain_type_reference_mutable()
            _ -> type_reference_write_or_type_identifier()
        }
    }

    state type_reference_write_or_type_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "write"
        ) {
            1 -> retain_type_reference_write_only()
            _ -> type_reference_relaxed_or_type_identifier()
        }
    }

    state type_reference_relaxed_or_type_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "relaxed"
        ) {
            1 -> type_missing_failure(
                self.scan.token_start,
                self.scan.token_end
