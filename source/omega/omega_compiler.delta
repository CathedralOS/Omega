// Delta-written Omega compiler D: final boundary-independent foundations.
//
// This source intentionally has no Main yet. The canonical sealed Omega
// compilation request and publication boundary are owner-blocked by Q7. This
// incomplete unit currently owns exact Alpha tape construction, strict source
// UTF-8 framing, complete source-neutral lexical scanning, and the first
// source-shaped slice of the one-invocation parser. It owns no invented
// source-unit or package boundary.
//
// status is sticky: 0 open, 1 construction capacity, 2 internal misuse.
// failure_offset is a payload-relative byte offset. failure_requested is the
// rejected instruction width or invalid scalar supplied by the caller.

data AlphaTapeBuffer {
    bytes: [u8; 262140];
    instruction_starts: [u8; 262140];
    label_offsets: [i32; 262140];
    label_defined: [u8; 262140];
    fixup_labels: [i32; 29126];
    fixup_instructions: [i32; 29126];
    fixup_operands: [i32; 29126];
    fixup_resolved: [u8; 29126];
    length: i32;
    label_count: i32;
    fixup_count: i32;
    status: i32;
    failure_offset: i32;
    failure_requested: i32;
    finalized: i32;
}

data OmegaUtf8Validation {
    valid: i32;
    error_offset: i32;
}

data OmegaNumericBase {
    case Binary;
    case Octal;
    case Decimal;
    case Hexadecimal;
}

data OmegaKeywordKind {
    case As;
    case CallingConvention;
    case Capability;
    case Contains;
    case Data;
    case Else;
    case Enum;
    case False;
    case Foreign;
    case Host;
    case If;
    case Let;
    case Library;
    case Loop;
    case Machine;
    case Match;
    case Owns;
    case Platform;
    case Pub;
    case Return;
    case SelfType;
    case SelfValue;
    case State;
    case Struct;
    case Target;
    case Transition;
    case True;
    case Use;
    case When;
    case While;
    case Case;
    case Copy;
}

data OmegaPunctuationKind {
    case Ampersand;
    case AndAnd;
    case Apostrophe;
    case Arrow;
    case Asterisk;
    case Caret;
    case Colon;
    case ColonColon;
    case Comma;
    case Dot;
    case DotDot;
    case DotDotEqual;
    case Equal;
    case EqualEqual;
    case Exclamation;
    case ExclamationEqual;
    case Greater;
    case GreaterEqual;
    case GreaterGreater;
    case Hash;
    case LeftBrace;
    case LeftBracket;
    case LeftParen;
    case Less;
    case LessEqual;
    case LessLess;
    case Minus;
    case Percent;
    case Pipe;
    case PipePipe;
    case Plus;
    case PlusEqual;
    case MinusEqual;
    case AsteriskEqual;
    case SlashEqual;
    case PercentEqual;
    case RightBrace;
    case RightBracket;
    case RightParen;
    case Semicolon;
    case Slash;
    case Tilde;
}

data OmegaTokenKind {
    case Identifier;
    case Integer;
    case Float;
    case StringLiteral;
    case Keyword;
    case Punctuation;
    case Whitespace;
    case LineComment;
    case BlockComment;
}

data OmegaLexDiagnosticCode {
    case InvalidUtf8;
    case OutsideLexicalProfile;
    case UnterminatedBlockComment;
    case UnterminatedStringLiteral;
    case UnterminatedStringEscape;
    case UnsupportedEscape;
    case UnterminatedHexEscape;
    case InvalidHexEscapeDigit;
}

// One source-neutral current-token observation. No source view, token ledger,
// or decoded literal bytes are retained. Only scan_at is the standalone token
// judgment; validate_lexical owns its whole-view walk without exporting a
// preflight token capability that another same-sized view could counterfeit.
data OmegaLexScan {
    utf8: OmegaUtf8Validation;
    accepted: i32;
    has_token: i32;
    internal_failure: i32;
    token_kind: OmegaTokenKind;
    keyword: OmegaKeywordKind;
    punctuation: OmegaPunctuationKind;
    numeric_base: OmegaNumericBase;
    token_start: i32;
    token_end: i32;
    next_cursor: i32;
    numeric_empty_digits: i32;
    numeric_has_suffix: i32;
    numeric_has_exponent: i32;
    numeric_empty_exponent: i32;
    decoded_length: i32;
    diagnostic_code: OmegaLexDiagnosticCode;
    diagnostic_start: i32;
    diagnostic_end: i32;
    predicate_result: i32;
    digit_value: i32;
}

// Parser results remain relative to the one immutable source view supplied to
// parse_view. Q7 will eventually bind that view to a package-owned source
// identity and an outer outcome; neither identity nor wire tags are guessed
// here. These fixed tables are private compiler budgets, not Omega limits.
data OmegaRelativeSpan {
    start: i32;
    end: i32;
}

data OmegaUseSyntax {
    first_member: i32;
    member_count: i32;
    start: i32;
    end: i32;
}

data OmegaRootKind {
    case Use;
    case Data;
    case Machine;
}

data OmegaRootSyntax {
    kind: OmegaRootKind;
    item_index: i32;
}

data OmegaDataMultiplicity {
    case Affine;
    case Unrestricted;
}

data OmegaDataMemberKind {
    case Field;
    case Case;
}

data OmegaTypeConsumer {
    case DirectDataField;
    case CasePayloadField;
    case MachineParameter;
    case MachineReturn;
}

data OmegaPathDestination {
    case Use;
    case Machine;
}

data OmegaTypeReferenceKind {
    case Named;
    case SelfType;
    case Unit;
    case Constrained;
    case FixedArray;
    case Slice;
    case Reference;
}

data OmegaTypeBaseKind {
    case Named;
    case SelfType;
    case Unit;
}

data OmegaReferenceAccess {
    case Shared;
    case Mutable;
    case WriteOnly;
}

data OmegaTypeArrayKind {
    case FixedArray;
    case Slice;
}

// Compact tagged type node. Payload interpretation is owned by kind:
// Named uses payload0/payload1 as its name span; Constrained uses payload0 as
// its base node and payload1/payload2 as its constraint span; FixedArray uses
// payload0 for its element and payload1/payload2 for the exact length span;
// Slice uses payload0 for its element.
// Reference uses payload0 for its referee, payload1 for access (0 shared,
// 1 mutable, 2 write-only), payload2 as has-lifetime, and payload3/payload4 for
// the exact optional lifetime span. SelfType and Unit have no payload.
// Remaining words are reserved for final recursive type variants without
// parallel node arenas. Words not selected by kind have no meaning and need
// not be cleared.
data OmegaTypeReferenceSyntax {
    kind: OmegaTypeReferenceKind;
    payload0: i32;
    payload1: i32;
    payload2: i32;
    payload3: i32;
    payload4: i32;
    payload5: i32;
}

data OmegaTypeConstraintKind {
    case Domain;
    case InclusiveRange;
}

// Kind-selected constraint payload. Domain uses payload0/payload1 as its path
// span. InclusiveRange uses payload0..payload3 as the exact minimum/maximum
// literal spans; payload4/payload5 are reserved for their eventual expression
// handles, while Domain can use them for its argument span. Unselected words
// have no meaning and need not be cleared.
data OmegaTypeConstraintSyntax {
    kind: OmegaTypeConstraintKind;
    payload0: i32;
    payload1: i32;
    payload2: i32;
    payload3: i32;
    payload4: i32;
    payload5: i32;
}

data OmegaTypeArrayFrame {
    kind: OmegaTypeArrayKind;
    length_start: i32;
    length_end: i32;
}

data OmegaDataFieldSyntax {
    name: OmegaRelativeSpan;
    type_reference: i32;
    start: i32;
    end: i32;
}

data OmegaDataCaseSyntax {
    name: OmegaRelativeSpan;
    first_payload_field: i32;
    payload_field_count: i32;
    start: i32;
    end: i32;
}

data OmegaDataMemberSyntax {
    kind: OmegaDataMemberKind;
    item_index: i32;
}

data OmegaDataSyntax {
    name: OmegaRelativeSpan;
    first_member: i32;
    member_count: i32;
    first_field: i32;
    field_count: i32;
    first_case: i32;
    case_count: i32;
    multiplicity: OmegaDataMultiplicity;
    is_public: i32;
    start: i32;
    end: i32;
}

data OmegaMachineStateNameKind {
    case GeneratedEntry;
    case FinalPathMember;
    case Authored;
}

data OmegaMachineParameterSyntax {
    name: OmegaRelativeSpan;
    type_reference: i32;
    is_const: i32;
    is_mutable: i32;
    is_self: i32;
}

data OmegaStatementKind {
    case Call;
    case Assignment;
    case Transition;
}

data OmegaStatementSyntax {
    kind: OmegaStatementKind;
    item_index: i32;
}

data OmegaCallStatementSyntax {
    first_receiver_member: i32;
    receiver_member_count: i32;
    receiver_starts_at_self: i32;
    target_member: i32;
    first_machine_argument: i32;
    machine_argument_count: i32;
    first_argument: i32;
    argument_count: i32;
    start: i32;
    end: i32;
}

data OmegaStaticMachineArgumentKind {
    case Path;
}

data OmegaStaticMachineArgumentSyntax {
    kind: OmegaStaticMachineArgumentKind;
    first_path_member: i32;
    path_member_count: i32;
    start: i32;
    end: i32;
    payload0: i32;
    payload1: i32;
}

data OmegaAssignmentStatementSyntax {
    target: i32;
    value: i32;
    start: i32;
    end: i32;
}

data OmegaTransitionGuardKind {
    case Always;
    case Boolean;
    case Integer;
}

// The first transition slice retains one path subject and expands every arm
// into one ordinary statement, matching the canonical syntax tree. Guard
// spelling stays source-shaped; target is one authored zero-argument state
// name. Richer subjects, patterns, and targets remain parser-incomplete.
data OmegaTransitionStatementSyntax {
    subject: i32;
    guard_kind: OmegaTransitionGuardKind;
    guard_boolean: i32;
    guard_start: i32;
    guard_end: i32;
    target: OmegaRelativeSpan;
    start: i32;
    end: i32;
}

data OmegaExpressionKind {
    case Path;
    case Boolean;
    case Integer;
    case String;
    case StructLiteral;
}

data OmegaPathExpressionKind {
    case Name;
    case SelfValue;
    case Member;
}

data OmegaExpressionConsumer {
    case CallArgument;
    case AssignmentValue;
    case StructFieldValue;
    case TransitionSubject;
}

data OmegaStructLiteralFieldSyntax {
    name: OmegaRelativeSpan;
    value: i32;
    start: i32;
    end: i32;
}

data OmegaStructLiteralSyntax {
    first_type_member: i32;
    type_member_count: i32;
    first_field: i32;
    field_count: i32;
    start: i32;
    end: i32;
}

// Path payload0/payload1 are the member span, payload2 records whether the path
// starts at `self`, and payload3 records the qualified-Name prefix length before
// any runtime member chain; path_kind distinguishes Name, bare SelfValue, and
// Member. Boolean payload0 is its value and payload1/payload2 retain the
// authored span. Integer payload0/payload1 retain its authored span; this first
// numeric slice admits only unsuffixed nonnegative decimal spelling. String
// payload0/payload1 retain the authored token span and payload2 its decoded
// byte length. StructLiteral payload0 selects its dedicated row. Remaining
// words are reserved for richer nodes.
data OmegaExpressionSyntax {
    kind: OmegaExpressionKind;
    path_kind: OmegaPathExpressionKind;
    payload0: i32;
    payload1: i32;
    payload2: i32;
    payload3: i32;
    payload4: i32;
    payload5: i32;
}

data OmegaMachineStateSyntax {
    name_kind: OmegaMachineStateNameKind;
    name: OmegaRelativeSpan;
    first_parameter: i32;
    parameter_count: i32;
    has_return_type: i32;
    return_type: i32;
    first_statement: i32;
    statement_count: i32;
}

data OmegaMachineSyntax {
    first_path_member: i32;
    path_member_count: i32;
    first_state: i32;
    state_count: i32;
    is_public: i32;
    has_target: i32;
    target: OmegaRelativeSpan;
    start: i32;
    end: i32;
}

data OmegaParserStatus {
    case Parsing;
    case Complete;
    case LexicalFailure;
    case SyntaxFailure;
    case Incomplete;
    case ResourceFailure;
    case InternalFailure;
}

// Internal parser distinctions have no Q7 outcome-code identity. The scanner
// retains the exact lexical diagnostic when status is LexicalFailure.
data OmegaParseDiagnosticCode {
    case None;
    case ExpectedPathMember;
    case ExpectedPathSeparatorOrSemicolon;
    case ExpectedDataName;
    case ExpectedDataBody;
    case ExpectedDataProperty;
    case ExpectedDataPropertyEnd;
    case ExpectedDataMemberOrEnd;
    case ExpectedDataCaseName;
    case ExpectedDataCaseEnd;
    case ExpectedDataPayloadFieldOrEnd;
    case ExpectedDataFieldColon;
    case ExpectedDataFieldType;
    case ExpectedTypeDomain;
    case ExpectedTypeRangeOperator;
    case ExpectedTypeRangeBound;
    case ExpectedTypeRangeEnd;
    case ExpectedArrayElementType;
    case ExpectedArraySeparatorOrEnd;
    case ExpectedArrayLength;
    case ExpectedArrayEnd;
    case ExpectedMachineParameterOrEnd;
    case ExpectedMachineParameter;
    case ExpectedMachineParameterColon;
    case ExpectedMachineParameterType;
    case ExpectedMachineParameterEnd;
    case ExpectedMachineReturnType;
    case ExpectedMachineReturnEnd;
    case ExpectedReferenceLifetime;
    case ExpectedUnitTypeEnd;
    case ExpectedMachineBody;
    case ExpectedMachineBodyEnd;
    case ExpectedCallPathMember;
    case ExpectedCallPathTail;
    case ExpectedCallArgument;
    case ExpectedCallArgumentEnd;
    case ExpectedCallSemicolon;
    case ExpectedAssignmentValue;
    case ExpectedAssignmentSemicolon;
    case ExpectedStaticArgument;
    case ExpectedStaticArgumentEnd;
    case ExpectedStaticCallOpen;
    case ExpectedStructLiteralFieldOrEnd;
    case ExpectedStructLiteralFieldColon;
    case ExpectedStructLiteralValue;
    case ExpectedStructLiteralFieldEnd;
    case ExpectedStateName;
    case ExpectedStateBody;
    case ExpectedTransitionSubject;
    case ExpectedTransitionArm;
    case ExpectedTransitionArrow;
    case ExpectedTransitionTarget;
    case ExpectedTransitionTargetOpen;
    case ExpectedTransitionTargetClose;
    case ExpectedDataFieldEnd;
}

data OmegaParserResource {
    case None;
    case Roots;
    case States;
    case PathMembers;
    case DataMembers;
    case TypeNodes;
    case TypeDepth;
    case Statements;
    case Expressions;
}

data OmegaParser {
    scan: OmegaLexScan;
    // Only Complete authorizes consumers to inspect rows below the matching
    // count. Failure/incomplete may leave unowned prefixes; reset invalidates
    // prior rows by zeroing counts rather than clearing arrays.
    roots: [OmegaRootSyntax; 4096];
    members: [OmegaRelativeSpan; 16384];
    uses: [OmegaUseSyntax; 4096];
    data_items: [OmegaDataSyntax; 4096];
    machine_items: [OmegaMachineSyntax; 4096];
    machine_states: [OmegaMachineStateSyntax; 4096];
    machine_parameters: [OmegaMachineParameterSyntax; 16384];
    statements: [OmegaStatementSyntax; 16384];
    call_statements: [OmegaCallStatementSyntax; 16384];
    assignment_statements: [OmegaAssignmentStatementSyntax; 16384];
    transition_statements: [OmegaTransitionStatementSyntax; 16384];
    static_machine_arguments: [OmegaStaticMachineArgumentSyntax; 16384];
    expressions: [OmegaExpressionSyntax; 16384];
    call_arguments: [i32; 16384];
    struct_literals: [OmegaStructLiteralSyntax; 16384];
    struct_literal_fields: [OmegaStructLiteralFieldSyntax; 16384];
    data_members: [OmegaDataMemberSyntax; 16384];
    data_fields: [OmegaDataFieldSyntax; 16384];
    // Every payload field owns at least one type-reference row. The shared
    // 16,384-row type-reference bound therefore fails before this equal-sized
    // arena can.
    data_payload_fields: [OmegaDataFieldSyntax; 16384];
    data_cases: [OmegaDataCaseSyntax; 16384];
    type_references: [OmegaTypeReferenceSyntax; 16384];
    type_constraints: [OmegaTypeConstraintSyntax; 16384];
    type_array_frames: [OmegaTypeArrayFrame; 128];
    root_count: i32;
    member_count: i32;
    use_count: i32;
    data_count: i32;
    machine_count: i32;
    machine_state_count: i32;
    machine_parameter_count: i32;
    statement_count: i32;
    call_statement_count: i32;
    assignment_statement_count: i32;
    transition_statement_count: i32;
    static_machine_argument_count: i32;
    expression_count: i32;
    call_argument_count: i32;
    struct_literal_count: i32;
    struct_literal_field_count: i32;
    data_member_count: i32;
    data_field_count: i32;
    data_payload_field_count: i32;
    data_case_count: i32;
    type_reference_count: i32;
    type_constraint_count: i32;
    cursor: i32;
    item_start: i32;
    first_member: i32;
    path_destination: OmegaPathDestination;
    data_name_start: i32;
    data_name_end: i32;
    data_first_member: i32;
    data_first_field: i32;
    data_first_case: i32;
    data_is_public: i32;
    data_multiplicity: OmegaDataMultiplicity;
    type_subject_start: i32;
    type_subject_name_start: i32;
    type_subject_name_end: i32;
    type_consumer: OmegaTypeConsumer;
    type_name_start: i32;
    type_name_end: i32;
    type_end: i32;
    // 0 is a bare base, 1 an unqualified domain, and 2 a literal range.
    type_constraint_mode: i32;
    type_domain_name_start: i32;
    type_domain_name_end: i32;
    type_range_minimum_start: i32;
    type_range_minimum_end: i32;
    type_range_maximum_start: i32;
    type_range_maximum_end: i32;
    type_root: i32;
    type_allows_range: i32;
    type_array_frame_count: i32;
    type_array_depth: i32;
    type_required_nodes: i32;
    type_array_emit_index: i32;
    case_start: i32;
    case_keyword_end: i32;
    case_name_start: i32;
    case_name_end: i32;
    case_body_end: i32;
    case_first_payload_field: i32;
    machine_first_state: i32;
    state_first_parameter: i32;
    machine_parameter_has_more: i32;
    machine_path_member_count: i32;
    machine_is_public: i32;
    machine_has_target: i32;
    machine_target_start: i32;
    machine_target_end: i32;
    state_has_return_type: i32;
    state_return_type: i32;
    state_first_statement: i32;
    state_has_body_syntax: i32;
    state_is_explicit: i32;
    state_name_start: i32;
    state_name_end: i32;
    machine_parameter_is_const: i32;
    machine_parameter_is_leading_mutable: i32;
    machine_parameter_is_mutable: i32;
    machine_parameter_is_self: i32;
    machine_parameter_has_binding_reference: i32;
    machine_parameter_binding_access: OmegaReferenceAccess;
    type_base_kind: OmegaTypeBaseKind;
    type_has_reference: i32;
    type_reference_access: OmegaReferenceAccess;
    type_reference_is_exclusive: i32;
    type_reference_has_lifetime: i32;
    type_reference_lifetime_start: i32;
    type_reference_lifetime_end: i32;
    call_start: i32;
    call_first_path_member: i32;
    call_path_member_count: i32;
    call_receiver_starts_at_self: i32;
    call_first_machine_argument: i32;
    call_first_argument: i32;
    static_argument_first_path_member: i32;
    static_argument_path_member_count: i32;
    static_argument_start: i32;
    argument_first_path_member: i32;
    argument_path_member_count: i32;
    argument_starts_at_self: i32;
    argument_name_member_count: i32;
    argument_path_kind: OmegaPathExpressionKind;
    expression_consumer: OmegaExpressionConsumer;
    expression_result: i32;
    expression_end: i32;
    assignment_target_expression: i32;
    assignment_target_name_member_count: i32;
    assignment_target_path_kind: OmegaPathExpressionKind;
    assignment_value_expression: i32;
    struct_literal_consumer: OmegaExpressionConsumer;
    struct_literal_first_type_member: i32;
    struct_literal_type_member_count: i32;
    struct_literal_first_field: i32;
    struct_literal_start: i32;
    struct_field_name_start: i32;
    struct_field_name_end: i32;
    struct_field_value: i32;
    struct_field_value_end: i32;
    transition_subject_expression: i32;
    transition_guard_kind: OmegaTransitionGuardKind;
    transition_guard_boolean: i32;
    transition_guard_start: i32;
    transition_guard_end: i32;
    transition_arrow_start: i32;
    transition_arrow_end: i32;
    transition_target_start: i32;
    transition_target_end: i32;
    status: OmegaParserStatus;
    diagnostic_code: OmegaParseDiagnosticCode;
    diagnostic_start: i32;
    diagnostic_end: i32;
    incomplete_start: i32;
    incomplete_end: i32;
    resource: OmegaParserResource;
    resource_limit: i32;
    resource_requested: i32;
}

// Validate one exact source byte view. On failure error_offset is the lead byte
// of the malformed scalar, matching LEXICAL-PROFILE-V1's one-byte diagnostic
// span. This does not decide where non-ASCII scalars are permitted by the lexer.
machine OmegaUtf8Validation::validate(&mut self, source: &[u8]) {
    self.valid = 1;
    self.error_offset = 0;
    transition source.len {
        0 -> return
        _ -> scan(0)
    }

    state scan(index: i32) {
        transition index < source.len {
            true -> first(index)
            _ -> return
        }
    }

    state first(index: i32) {
        let byte0: i32 = source[index];
        transition byte0 < 128 {
            true -> advance(index, 1)
            _ -> two_lead(index, byte0)
        }
    }

    state two_lead(index: i32, byte0: i32) {
        transition (byte0 >= 194) && (byte0 <= 223) {
            true -> two_extent(index)
            _ -> three_lead(index, byte0)
        }
    }

    state two_extent(index: i32) {
        transition source.len - index >= 2 {
            true -> two_tail(index)
            _ -> invalid(index)
        }
    }

    state two_tail(index: i32) {
        let byte1: i32 = source[index + 1];
        transition (byte1 >= 128) && (byte1 <= 191) {
            true -> advance(index, 2)
            _ -> invalid(index)
        }
    }

    state three_lead(index: i32, byte0: i32) {
        transition (byte0 >= 224) && (byte0 <= 239) {
            true -> three_extent(index, byte0)
            _ -> four_lead(index, byte0)
        }
    }

    state three_extent(index: i32, byte0: i32) {
        transition source.len - index >= 3 {
            true -> three_tails(index, byte0)
            _ -> invalid(index)
        }
    }

    state three_tails(index: i32, byte0: i32) {
        let byte1: i32 = source[index + 1];
        let byte2: i32 = source[index + 2];
        transition (byte2 >= 128) && (byte2 <= 191) {
            true -> three_second(index, byte0, byte1)
            _ -> invalid(index)
        }
    }

    state three_second(index: i32, byte0: i32, byte1: i32) {
        transition byte0 {
            224 -> three_e0(index, byte1)
            237 -> three_ed(index, byte1)
            _ -> three_regular(index, byte1)
        }
    }

    state three_e0(index: i32, byte1: i32) {
        transition (byte1 >= 160) && (byte1 <= 191) {
            true -> advance(index, 3)
            _ -> invalid(index)
        }
    }

    state three_ed(index: i32, byte1: i32) {
        transition (byte1 >= 128) && (byte1 <= 159) {
            true -> advance(index, 3)
            _ -> invalid(index)
        }
    }

    state three_regular(index: i32, byte1: i32) {
        transition (byte1 >= 128) && (byte1 <= 191) {
            true -> advance(index, 3)
            _ -> invalid(index)
        }
    }

    state four_lead(index: i32, byte0: i32) {
        transition (byte0 >= 240) && (byte0 <= 244) {
            true -> four_extent(index, byte0)
            _ -> invalid(index)
        }
    }

    state four_extent(index: i32, byte0: i32) {
        transition source.len - index >= 4 {
            true -> four_tails(index, byte0)
            _ -> invalid(index)
        }
    }

    state four_tails(index: i32, byte0: i32) {
        let byte1: i32 = source[index + 1];
        let byte2: i32 = source[index + 2];
        let byte3: i32 = source[index + 3];
        transition (byte2 >= 128) && (byte2 <= 191) &&
            (byte3 >= 128) && (byte3 <= 191) {
            true -> four_second(index, byte0, byte1)
            _ -> invalid(index)
        }
    }

    state four_second(index: i32, byte0: i32, byte1: i32) {
        transition byte0 {
            240 -> four_f0(index, byte1)
            244 -> four_f4(index, byte1)
            _ -> four_regular(index, byte1)
        }
    }

    state four_f0(index: i32, byte1: i32) {
        transition (byte1 >= 144) && (byte1 <= 191) {
            true -> advance(index, 4)
            _ -> invalid(index)
        }
    }

    state four_f4(index: i32, byte1: i32) {
        transition (byte1 >= 128) && (byte1 <= 143) {
            true -> advance(index, 4)
            _ -> invalid(index)
        }
    }

    state four_regular(index: i32, byte1: i32) {
        transition (byte1 >= 128) && (byte1 <= 191) {
            true -> advance(index, 4)
            _ -> invalid(index)
        }
    }

    state advance(index: i32, width: i32) {
        transition true {
            true -> scan(index + width)
        }
    }

    state invalid(index: i32) {
        self.valid = 0;
        self.error_offset = index;
        return;
    }
}

machine omega_is_whitespace(byte: i32) -> i32 {
    transition byte {
        9 -> return 1
        10 -> return 1
        13 -> return 1
        32 -> return 1
        _ -> return 0
    }
}

machine omega_is_identifier_start(byte: i32) -> i32 {
    transition byte == 95 {
        true -> return 1
        _ -> upper()
    }

    state upper() {
        transition (byte >= 65) && (byte <= 90) {
            true -> return 1
            _ -> lower()
        }
    }

    state lower() {
        transition (byte >= 97) && (byte <= 122) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine omega_is_identifier_continue(byte: i32) -> i32 {
    transition omega_is_identifier_start(byte) {
        1 -> return 1
        _ -> digit()
    }

    state digit() {
        transition (byte >= 48) && (byte <= 57) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine omega_hex_value(byte: i32) -> i32 {
    transition (byte >= 48) && (byte <= 57) {
        true -> return byte - 48
        _ -> lower()
    }

    state lower() {
        transition (byte >= 97) && (byte <= 102) {
            true -> return byte - 87
            _ -> upper()
        }
    }

    state upper() {
        transition (byte >= 65) && (byte <= 70) {
            true -> return byte - 55
            _ -> return -1
        }
    }
}

machine omega_digit_in_base(byte: i32, base: OmegaNumericBase) -> i32 {
    transition base {
        OmegaNumericBase::Binary -> binary()
        OmegaNumericBase::Octal -> octal()
        OmegaNumericBase::Decimal -> decimal()
        OmegaNumericBase::Hexadecimal -> hex()
    }

    state binary() {
        transition (byte >= 48) && (byte <= 49) {
            true -> return 1
            _ -> return 0
        }
    }

    state octal() {
        transition (byte >= 48) && (byte <= 55) {
            true -> return 1
            _ -> return 0
        }
    }

    state decimal() {
        transition (byte >= 48) && (byte <= 57) {
            true -> return 1
            _ -> return 0
        }
    }

    state hex() {
        transition (byte >= 48) && (byte <= 57) {
            true -> return 1
            _ -> hex_upper()
        }
    }

    state hex_upper() {
        transition (byte >= 65) && (byte <= 70) {
            true -> return 1
            _ -> hex_lower()
        }
    }

    state hex_lower() {
        transition (byte >= 97) && (byte <= 102) {
            true -> return 1
            _ -> return 0
        }
    }
}

machine OmegaLexScan::reset(&mut self, cursor: i32) {
    self.accepted = 1;
    self.has_token = 0;
    self.internal_failure = 0;
    self.numeric_empty_digits = 0;
    self.numeric_has_suffix = 0;
    self.numeric_has_exponent = 0;
    self.numeric_empty_exponent = 0;
    self.decoded_length = 0;
    self.diagnostic_start = 0;
    self.diagnostic_end = 0;
    transition cursor >= 0 {
        true -> valid()
        _ -> invalid()
    }

    state valid() {
        self.token_start = cursor;
        self.token_end = cursor;
        self.next_cursor = cursor;
    }

    state invalid() {
        self.token_start = 0;
        self.token_end = 0;
        self.next_cursor = 0;
        self.fail_stage();
    }
}

// Delta D17 has no private machine visibility. Every factored scanner stage is
// therefore callable, even though only scan_at and validate_lexical are lexical
// judgments. View-accepting stages reject invalid cursor/extent shapes before
// indexing; construction helpers enforce their local arithmetic invariants.
// Calling a stage directly does not establish UTF-8 or token-boundary custody.
machine OmegaLexScan::fail_stage(&mut self) {
    self.accepted = 0;
    self.has_token = 0;
    self.internal_failure = 1;
}

machine OmegaLexScan::reject(
    &mut self,
    code: OmegaLexDiagnosticCode,
    start: i32,
    end: i32
) {
    transition start >= 0 {
        true -> check_order()
        _ -> self.fail_stage()
    }

    state check_order() {
        transition end > start {
            true -> commit()
            _ -> self.fail_stage()
        }
    }

    state commit() {
        self.accepted = 0;
        self.has_token = 0;
        self.diagnostic_code = code;
        self.diagnostic_start = start;
        self.diagnostic_end = end;
    }
}

machine OmegaLexScan::emit(
    &mut self,
    kind: OmegaTokenKind,
    end: i32
) {
    transition self.token_start >= 0 {
        true -> check_order()
        _ -> self.fail_stage()
    }

    state check_order() {
        transition end > self.token_start {
            true -> commit()
            _ -> self.fail_stage()
        }
    }

    state commit() {
        self.token_kind = kind;
        self.token_end = end;
        self.next_cursor = end;
        self.has_token = 1;
    }
}

machine OmegaLexScan::span_equals(
    &mut self,
    source: &[u8],
    start: i32,
    end: i32,
    candidate: &[u8]
) -> i32 {
    transition (start >= 0) && (end >= start) && (end <= source.len) {
        true -> check_length()
        _ -> return 0
    }

    state check_length() {
        transition end - start == candidate.len {
            true -> compare(0)
            _ -> return 0
        }
    }

    state compare(index: i32) {
        transition index < candidate.len {
            true -> compare_byte(index)
            _ -> return 1
        }
    }

    state compare_byte(index: i32) {
        transition source[start + index] == candidate[index] {
            true -> compare(index + 1)
            _ -> return 0
        }
    }
}

machine OmegaLexScan::set_keyword(&mut self, keyword: OmegaKeywordKind) {
    self.keyword = keyword;
    self.emit(OmegaTokenKind::Keyword, self.token_end);
}

machine OmegaLexScan::classify_keyword(
    &mut self,
    source: &[u8]
) {
    transition self.token_start >= 0 {
        true -> check_order()
        _ -> self.fail_stage()
    }

    state check_order() {
        transition self.token_end >= self.token_start {
            true -> check_extent()
            _ -> self.fail_stage()
        }
    }

    state check_extent() {
        transition self.token_end <= source.len {
            true -> classify()
            _ -> self.fail_stage()
        }
    }

    state classify() {
        transition self.span_equals(source, self.token_start, self.token_end, "as") {
            1 -> self.set_keyword(OmegaKeywordKind::As)
            _ -> calling_convention()
        }
    }

    state calling_convention() {
        transition self.span_equals(
            source,
            self.token_start,
            self.token_end,
            "calling_convention"
        ) {
            1 -> self.set_keyword(OmegaKeywordKind::CallingConvention)
            _ -> capability()
        }
    }

    state capability() {
        transition self.span_equals(source, self.token_start, self.token_end, "capability") {
            1 -> self.set_keyword(OmegaKeywordKind::Capability)
            _ -> contains()
        }
    }

    state contains() {
        transition self.span_equals(source, self.token_start, self.token_end, "contains") {
            1 -> self.set_keyword(OmegaKeywordKind::Contains)
            _ -> data_word()
        }
    }

    state data_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "data") {
            1 -> self.set_keyword(OmegaKeywordKind::Data)
            _ -> else_word()
        }
    }

    state else_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "else") {
            1 -> self.set_keyword(OmegaKeywordKind::Else)
            _ -> enum_word()
        }
    }

    state enum_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "enum") {
            1 -> self.set_keyword(OmegaKeywordKind::Enum)
            _ -> false_word()
        }
    }

    state false_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "false") {
            1 -> self.set_keyword(OmegaKeywordKind::False)
            _ -> foreign()
        }
    }

    state foreign() {
        transition self.span_equals(source, self.token_start, self.token_end, "foreign") {
            1 -> self.set_keyword(OmegaKeywordKind::Foreign)
            _ -> host()
        }
    }

    state host() {
        transition self.span_equals(source, self.token_start, self.token_end, "host") {
            1 -> self.set_keyword(OmegaKeywordKind::Host)
            _ -> if_word()
        }
    }

    state if_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "if") {
            1 -> self.set_keyword(OmegaKeywordKind::If)
            _ -> let_word()
        }
    }

    state let_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "let") {
            1 -> self.set_keyword(OmegaKeywordKind::Let)
            _ -> library()
        }
    }

    state library() {
        transition self.span_equals(source, self.token_start, self.token_end, "library") {
            1 -> self.set_keyword(OmegaKeywordKind::Library)
            _ -> loop_word()
        }
    }

    state loop_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "loop") {
            1 -> self.set_keyword(OmegaKeywordKind::Loop)
            _ -> machine_word()
        }
    }

    state machine_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "machine") {
            1 -> self.set_keyword(OmegaKeywordKind::Machine)
            _ -> match_word()
        }
    }

    state match_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "match") {
            1 -> self.set_keyword(OmegaKeywordKind::Match)
            _ -> owns()
        }
    }

    state owns() {
        transition self.span_equals(source, self.token_start, self.token_end, "owns") {
            1 -> self.set_keyword(OmegaKeywordKind::Owns)
            _ -> platform()
        }
    }

    state platform() {
        transition self.span_equals(source, self.token_start, self.token_end, "platform") {
            1 -> self.set_keyword(OmegaKeywordKind::Platform)
            _ -> pub_word()
        }
    }

    state pub_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "pub") {
            1 -> self.set_keyword(OmegaKeywordKind::Pub)
            _ -> return_word()
        }
    }

    state return_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "return") {
            1 -> self.set_keyword(OmegaKeywordKind::Return)
            _ -> self_type()
        }
    }

    state self_type() {
        transition self.span_equals(source, self.token_start, self.token_end, "Self") {
            1 -> self.set_keyword(OmegaKeywordKind::SelfType)
            _ -> self_value()
        }
    }

    state self_value() {
        transition self.span_equals(source, self.token_start, self.token_end, "self") {
            1 -> self.set_keyword(OmegaKeywordKind::SelfValue)
            _ -> state_word()
        }
    }

    state state_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "state") {
            1 -> self.set_keyword(OmegaKeywordKind::State)
            _ -> struct_word()
        }
    }

    state struct_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "struct") {
            1 -> self.set_keyword(OmegaKeywordKind::Struct)
            _ -> target()
        }
    }

    state target() {
        transition self.span_equals(source, self.token_start, self.token_end, "target") {
            1 -> self.set_keyword(OmegaKeywordKind::Target)
            _ -> transition_word()
        }
    }

    state transition_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "transition") {
            1 -> self.set_keyword(OmegaKeywordKind::Transition)
            _ -> true_word()
        }
    }

    state true_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "true") {
            1 -> self.set_keyword(OmegaKeywordKind::True)
            _ -> use_word()
        }
    }

    state use_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "use") {
            1 -> self.set_keyword(OmegaKeywordKind::Use)
            _ -> when_word()
        }
    }

    state when_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "when") {
            1 -> self.set_keyword(OmegaKeywordKind::When)
            _ -> while_word()
        }
    }

    state while_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "while") {
            1 -> self.set_keyword(OmegaKeywordKind::While)
            _ -> case_word()
        }
    }

    state case_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "case") {
            1 -> self.set_keyword(OmegaKeywordKind::Case)
            _ -> copy_word()
        }
    }

    state copy_word() {
        transition self.span_equals(source, self.token_start, self.token_end, "copy") {
            1 -> self.set_keyword(OmegaKeywordKind::Copy)
            _ -> self.emit(OmegaTokenKind::Identifier, self.token_end)
        }
    }
}

machine OmegaLexScan::scan_whitespace(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    transition cursor >= 0 {
        true -> check_extent()
        _ -> self.fail_stage()
    }

    state check_extent() {
        transition cursor < source.len {
            true -> check_first()
            _ -> self.fail_stage()
        }
    }

    state check_first() {
        transition omega_is_whitespace(source[cursor]) {
            1 -> begin()
            _ -> self.fail_stage()
        }
    }

    state begin() {
        self.token_start = cursor;
        transition true {
            true -> scan(cursor)
        }
    }

    state scan(index: i32) {
        transition index < source.len {
            true -> classify(index)
            _ -> finish(index)
        }
    }

    state classify(index: i32) {
        transition omega_is_whitespace(source[index]) {
            1 -> scan(index + 1)
            _ -> finish(index)
        }
    }

    state finish(index: i32) {
        self.emit(OmegaTokenKind::Whitespace, index);
    }
}

machine OmegaLexScan::scan_identifier(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    transition cursor >= 0 {
        true -> check_extent()
        _ -> self.fail_stage()
    }

    state check_extent() {
        transition cursor < source.len {
            true -> check_first()
            _ -> self.fail_stage()
        }
    }

    state check_first() {
        transition omega_is_identifier_start(source[cursor]) {
            1 -> begin()
            _ -> self.fail_stage()
        }
    }

    state begin() {
        self.token_start = cursor;
        transition true {
            true -> scan(cursor + 1)
        }
    }

    state scan(index: i32) {
        transition index < source.len {
            true -> classify(index)
            _ -> finish(index)
        }
    }

    state classify(index: i32) {
        transition omega_is_identifier_continue(source[index]) {
            1 -> scan(index + 1)
            _ -> finish(index)
        }
    }

    state finish(index: i32) {
        self.token_end = index;
        self.next_cursor = index;
        self.classify_keyword(source);
    }
}

machine OmegaLexScan::scan_line_comment(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    transition cursor >= 0 {
        true -> check_extent()
        _ -> self.fail_stage()
    }

    state check_extent() {
        transition cursor < source.len {
            true -> check_width()
            _ -> self.fail_stage()
        }
    }

    state check_width() {
        transition source.len - cursor >= 2 {
            true -> check_open()
            _ -> self.fail_stage()
        }
    }

    state check_open() {
        transition (source[cursor] == 47) && (source[cursor + 1] == 47) {
            true -> begin()
            _ -> self.fail_stage()
        }
    }

    state begin() {
        self.token_start = cursor;
        transition true {
            true -> scan(cursor + 2)
        }
    }

    state scan(index: i32) {
        transition index < source.len {
            true -> newline(index)
            _ -> finish(index)
        }
    }

    state newline(index: i32) {
        transition source[index] {
            10 -> consume_newline(index)
            _ -> scan(index + 1)
        }
    }

    state consume_newline(index: i32) {
        self.token_kind = OmegaTokenKind::LineComment;
        self.token_end = index;
        self.next_cursor = index + 1;
        self.has_token = 1;
    }

    state finish(index: i32) {
        self.emit(OmegaTokenKind::LineComment, index);
    }
}

machine OmegaLexScan::scan_block_comment(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    transition cursor >= 0 {
        true -> check_extent()
        _ -> self.fail_stage()
    }

    state check_extent() {
        transition cursor < source.len {
            true -> check_width()
            _ -> self.fail_stage()
        }
    }

    state check_width() {
        transition source.len - cursor >= 2 {
            true -> check_open()
            _ -> self.fail_stage()
        }
    }

    state check_open() {
        transition (source[cursor] == 47) && (source[cursor + 1] == 42) {
            true -> begin()
            _ -> self.fail_stage()
        }
    }

    state begin() {
        self.token_start = cursor;
        transition true {
            true -> scan(cursor + 2, 1)
        }
    }

    state scan(index: i32, depth: i32) {
        transition index < source.len {
            true -> pair_extent(index, depth)
            _ -> unterminated()
        }
    }

    state pair_extent(index: i32, depth: i32) {
        transition source.len - index >= 2 {
            true -> open(index, depth)
            _ -> scan(index + 1, depth)
        }
    }

    state open(index: i32, depth: i32) {
        transition (source[index] == 47) && (source[index + 1] == 42) {
            true -> scan(index + 2, depth + 1)
            _ -> close(index, depth)
        }
    }

    state close(index: i32, depth: i32) {
        transition (source[index] == 42) && (source[index + 1] == 47) {
            true -> close_depth(index, depth)
            _ -> scan(index + 1, depth)
        }
    }

    state close_depth(index: i32, depth: i32) {
        transition depth {
            1 -> finish(index + 2)
            _ -> scan(index + 2, depth - 1)
        }
    }

    state finish(index: i32) {
        self.emit(OmegaTokenKind::BlockComment, index);
    }

    state unterminated() {
        self.reject(
            OmegaLexDiagnosticCode::UnterminatedBlockComment,
            self.token_start,
            source.len
        );
    }
}

machine OmegaLexScan::scan_string(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    transition cursor >= 0 {
        true -> check_extent()
        _ -> self.fail_stage()
    }

    state check_extent() {
        transition cursor < source.len {
            true -> check_quote()
            _ -> self.fail_stage()
        }
    }

    state check_quote() {
        transition source[cursor] {
            34 -> begin()
            _ -> self.fail_stage()
        }
    }

    state begin() {
        self.token_start = cursor;
        self.decoded_length = 0;
        transition true {
            true -> scan(cursor + 1)
        }
    }

    state scan(index: i32) {
        transition index < source.len {
            true -> classify(index)
            _ -> unterminated()
        }
    }

    state classify(index: i32) {
        transition source[index] {
            34 -> finish(index + 1)
            10 -> outside_line(index)
            13 -> outside_line(index)
            92 -> escape_extent(index)
            _ -> copy(index)
        }
    }

    state copy(index: i32) {
        self.decoded_length = self.decoded_length + 1;
        transition true {
            true -> scan(index + 1)
        }
    }

    state escape_extent(index: i32) {
        transition source.len - index >= 2 {
            true -> escape(index)
            _ -> unterminated_escape()
        }
    }

    state escape(index: i32) {
        transition source[index + 1] {
            34 -> simple_escape(index)
            92 -> simple_escape(index)
            110 -> simple_escape(index)
            114 -> simple_escape(index)
            116 -> simple_escape(index)
            48 -> simple_escape(index)
            120 -> hex_extent(index)
            117 -> outside_escape(index)
            _ -> unsupported_escape(index)
        }
    }

    state simple_escape(index: i32) {
        self.decoded_length = self.decoded_length + 1;
        transition true {
            true -> scan(index + 2)
        }
    }

    state hex_extent(index: i32) {
        transition source.len - index >= 4 {
            true -> hex_first(index)
            _ -> hex_unterminated(index)
        }
    }

    state hex_first(index: i32) {
        let first: i32 = omega_hex_value(source[index + 2]);
        transition first >= 0 {
            true -> hex_second(index)
            _ -> hex_invalid_first(index)
        }
    }

    state hex_second(index: i32) {
        let second: i32 = omega_hex_value(source[index + 3]);
        transition second >= 0 {
            true -> hex_emit(index)
            _ -> hex_invalid_second(index)
        }
    }

    state hex_emit(index: i32) {
        self.decoded_length = self.decoded_length + 1;
        transition true {
            true -> scan(index + 4)
        }
    }

    state finish(index: i32) {
        self.emit(OmegaTokenKind::StringLiteral, index);
    }

    state unterminated() {
        self.reject(
            OmegaLexDiagnosticCode::UnterminatedStringLiteral,
            self.token_start,
            source.len
        );
    }

    state unterminated_escape() {
        self.reject(
            OmegaLexDiagnosticCode::UnterminatedStringEscape,
            self.token_start,
            source.len
        );
    }

    state unsupported_escape(index: i32) {
        self.reject(
            OmegaLexDiagnosticCode::UnsupportedEscape,
            index,
            index + 2
        );
    }

    state hex_unterminated(index: i32) {
        self.reject(
            OmegaLexDiagnosticCode::UnterminatedHexEscape,
            index,
            source.len
        );
    }

    state hex_invalid_first(index: i32) {
        self.reject(
            OmegaLexDiagnosticCode::InvalidHexEscapeDigit,
            index + 2,
            index + 3
        );
    }

    state hex_invalid_second(index: i32) {
        self.reject(
            OmegaLexDiagnosticCode::InvalidHexEscapeDigit,
            index + 3,
            index + 4
        );
    }

    state outside_escape(index: i32) {
        self.reject(
            OmegaLexDiagnosticCode::OutsideLexicalProfile,
            index,
            index + 2
        );
    }

    state outside_line(index: i32) {
        self.reject(
            OmegaLexDiagnosticCode::OutsideLexicalProfile,
            index,
            index + 1
        );
    }
}

machine OmegaLexScan::consume_digits(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    self.predicate_result = 0;
    transition cursor >= 0 {
        true -> check_extent()
        _ -> self.fail_stage()
    }

    state check_extent() {
        transition cursor <= source.len {
            true -> scan(cursor)
            _ -> self.fail_stage()
        }
    }

    state scan(index: i32) {
        transition index < source.len {
            true -> classify(index)
            _ -> finish(index)
        }
    }

    state classify(index: i32) {
        transition source[index] {
            95 -> scan(index + 1)
            _ -> digit(index)
        }
    }

    state digit(index: i32) {
        transition omega_digit_in_base(source[index], self.numeric_base) {
            1 -> consume(index)
            _ -> finish(index)
        }
    }

    state consume(index: i32) {
        self.predicate_result = 1;
        transition true {
            true -> scan(index + 1)
        }
    }

    state finish(index: i32) {
        self.next_cursor = index;
    }
}

machine OmegaLexScan::consume_suffix(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    self.numeric_has_suffix = 0;
    transition cursor >= 0 {
        true -> check_extent()
        _ -> self.fail_stage()
    }

    state check_extent() {
        transition cursor <= source.len {
            true -> check_end()
            _ -> self.fail_stage()
        }
    }

    state check_end() {
        transition cursor < source.len {
            true -> first(cursor)
            _ -> finish(cursor)
        }
    }

    state first(index: i32) {
        transition omega_is_identifier_start(source[index]) {
            1 -> consume(index)
            _ -> finish(index)
        }
    }

    state consume(index: i32) {
        self.numeric_has_suffix = 1;
        transition true {
            true -> rest(index + 1)
        }
    }

    state rest(index: i32) {
        transition index < source.len {
            true -> continue_suffix(index)
            _ -> finish(index)
        }
    }

    state continue_suffix(index: i32) {
        transition omega_is_identifier_continue(source[index]) {
            1 -> rest(index + 1)
            _ -> finish(index)
        }
    }

    state finish(index: i32) {
        self.next_cursor = index;
    }
}

machine OmegaLexScan::dot_starts_float(
    &mut self,
    source: &[u8],
    cursor: i32
) -> i32 {
    transition cursor >= 0 {
        true -> check_extent()
        _ -> invalid()
    }

    state check_extent() {
        transition cursor < source.len {
            true -> check_dot()
            _ -> invalid()
        }
    }

    state check_dot() {
        transition source[cursor] {
            46 -> check_next()
            _ -> invalid()
        }
    }

    state check_next() {
        transition source.len - cursor >= 2 {
            true -> classify(source[cursor + 1])
            _ -> return 1
        }
    }

    state classify(next: i32) {
        transition (next >= 48) && (next <= 57) {
            true -> return 1
            _ -> dot(next)
        }
    }

    state dot(next: i32) {
        transition next {
            46 -> return 0
            _ -> identifier(next)
        }
    }

    state identifier(next: i32) {
        transition omega_is_identifier_start(next) {
            1 -> return 0
            _ -> return 1
        }
    }

    state invalid() {
        self.fail_stage();
        return 0;
    }
}

machine OmegaLexScan::scan_number(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    transition cursor >= 0 {
        true -> check_extent()
        _ -> self.fail_stage()
    }

    state check_extent() {
        transition cursor < source.len {
            true -> classify_first()
            _ -> self.fail_stage()
        }
    }

    state classify_first() {
        let first: i32 = source[cursor];
        transition first {
            46 -> check_leading_dot()
            _ -> check_digit(first)
        }
    }

    state check_leading_dot() {
        transition source.len - cursor >= 2 {
            true -> check_leading_digit()
            _ -> self.fail_stage()
        }
    }

    state check_leading_digit() {
        let next: i32 = source[cursor + 1];
        transition (next >= 48) && (next <= 57) {
            true -> begin()
            _ -> self.fail_stage()
        }
    }

    state check_digit(first: i32) {
        transition (first >= 48) && (first <= 57) {
            true -> begin()
            _ -> self.fail_stage()
        }
    }

    state begin() {
        self.token_start = cursor;
        self.numeric_base = OmegaNumericBase::Decimal;
        self.numeric_empty_digits = 0;
        self.numeric_has_suffix = 0;
        self.numeric_has_exponent = 0;
        self.numeric_empty_exponent = 0;
        transition source[cursor] {
            46 -> leading_dot(cursor)
            _ -> integer_begin(cursor)
        }
    }

    state leading_dot(index: i32) {
        self.token_kind = OmegaTokenKind::Float;
        self.consume_digits(source, index + 1);
        transition true {
            true -> exponent_check(self.next_cursor)
        }
    }

    state integer_begin(index: i32) {
        self.token_kind = OmegaTokenKind::Integer;
        transition source[index] {
            48 -> prefix_bound(index + 1)
            _ -> decimal_digits(index + 1)
        }
    }

    state prefix_bound(index: i32) {
        transition index < source.len {
            true -> prefix(index)
            _ -> dot_check(index)
        }
    }

    state prefix(index: i32) {
        transition source[index] {
            98 -> binary_prefix(index + 1)
            66 -> binary_prefix(index + 1)
            111 -> octal_prefix(index + 1)
            79 -> octal_prefix(index + 1)
            120 -> hex_prefix(index + 1)
            88 -> hex_prefix(index + 1)
            _ -> decimal_digits(index)
        }
    }

    state binary_prefix(index: i32) {
        self.numeric_base = OmegaNumericBase::Binary;
        transition true {
            true -> based_digits(index)
        }
    }

    state octal_prefix(index: i32) {
        self.numeric_base = OmegaNumericBase::Octal;
        transition true {
            true -> based_digits(index)
        }
    }

    state hex_prefix(index: i32) {
        self.numeric_base = OmegaNumericBase::Hexadecimal;
        transition true {
            true -> based_digits(index)
        }
    }

    state based_digits(index: i32) {
        self.consume_digits(source, index);
        transition self.predicate_result {
            1 -> based_suffix(self.next_cursor)
            _ -> empty_based_suffix(self.next_cursor)
        }
    }

    state empty_based_suffix(index: i32) {
        self.numeric_empty_digits = 1;
        transition true {
            true -> based_suffix(index)
        }
    }

    state based_suffix(index: i32) {
        self.consume_suffix(source, index);
        transition true {
            true -> finish_integer(self.next_cursor)
        }
    }

    state decimal_digits(index: i32) {
        self.consume_digits(source, index);
        transition true {
            true -> dot_check(self.next_cursor)
        }
    }

    state dot_check(index: i32) {
        transition index < source.len {
            true -> dot_byte(index)
            _ -> exponent_check(index)
        }
    }

    state dot_byte(index: i32) {
        transition source[index] {
            46 -> dot_decision(index)
            _ -> exponent_check(index)
        }
    }

    state dot_decision(index: i32) {
        transition self.dot_starts_float(source, index) {
            1 -> dot_consume(index + 1)
            _ -> exponent_check(index)
        }
    }

    state dot_consume(index: i32) {
        self.token_kind = OmegaTokenKind::Float;
        self.consume_digits(source, index);
        transition true {
            true -> exponent_check(self.next_cursor)
        }
    }

    state exponent_check(index: i32) {
        transition self.numeric_base {
            OmegaNumericBase::Decimal -> exponent_extent(index)
            _ -> suffix(index)
        }
    }

    state exponent_extent(index: i32) {
        transition index < source.len {
            true -> exponent_byte(index)
            _ -> suffix(index)
        }
    }

    state exponent_byte(index: i32) {
        transition source[index] {
            101 -> exponent_begin(index + 1)
            69 -> exponent_begin(index + 1)
            _ -> suffix(index)
        }
    }

    state exponent_begin(index: i32) {
        self.token_kind = OmegaTokenKind::Float;
        self.numeric_has_exponent = 1;
        transition index < source.len {
            true -> exponent_sign(index)
            _ -> exponent_digits(index)
        }
    }

    state exponent_sign(index: i32) {
        transition source[index] {
            43 -> exponent_digits(index + 1)
            45 -> exponent_digits(index + 1)
            _ -> exponent_digits(index)
        }
    }

    state exponent_digits(index: i32) {
        self.numeric_base = OmegaNumericBase::Decimal;
        self.consume_digits(source, index);
        transition self.predicate_result {
            1 -> suffix(self.next_cursor)
            _ -> empty_exponent(self.next_cursor)
        }
    }

    state empty_exponent(index: i32) {
        self.numeric_empty_exponent = 1;
        transition true {
            true -> suffix(index)
        }
    }

    state suffix(index: i32) {
        self.consume_suffix(source, index);
        transition self.token_kind {
            OmegaTokenKind::Float -> finish_float(self.next_cursor)
            _ -> finish_integer(self.next_cursor)
        }
    }

    state finish_float(index: i32) {
        self.emit(OmegaTokenKind::Float, index);
    }

    state finish_integer(index: i32) {
        self.emit(OmegaTokenKind::Integer, index);
    }
}

machine OmegaLexScan::set_punctuation(
    &mut self,
    punctuation: OmegaPunctuationKind,
    length: i32
) {
    transition length >= 1 {
        true -> check_length()
        _ -> self.fail_stage()
    }

    state check_length() {
        transition length <= 3 {
            true -> check_start()
            _ -> self.fail_stage()
        }
    }

    state check_start() {
        transition self.token_start >= 0 {
            true -> check_sum()
            _ -> self.fail_stage()
        }
    }

    state check_sum() {
        transition self.token_start <= 2147483647 - length {
            true -> commit()
            _ -> self.fail_stage()
        }
    }

    state commit() {
        self.punctuation = punctuation;
        self.emit(OmegaTokenKind::Punctuation, self.token_start + length);
    }
}

machine OmegaLexScan::scan_punctuation(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    transition cursor >= 0 {
        true -> check_extent()
        _ -> self.fail_stage()
    }

    state check_extent() {
        transition cursor < source.len {
            true -> begin()
            _ -> self.fail_stage()
        }
    }

    state begin() {
        self.token_start = cursor;
        let first: i32 = source[cursor];
        transition source.len - cursor {
            1 -> classify(first, -1, -1)
            2 -> second(first)
            _ -> third(first)
        }
    }

    state second(first: i32) {
        transition true {
            true -> classify(first, source[self.token_start + 1], -1)
        }
    }

    state third(first: i32) {
        transition true {
            true -> classify(
                first,
                source[self.token_start + 1],
                source[self.token_start + 2]
            )
        }
    }

    state classify(first: i32, second: i32, third: i32) {
        transition first {
            38 -> ampersand(second)
            39 -> self.set_punctuation(OmegaPunctuationKind::Apostrophe, 1)
            42 -> asterisk(second)
            94 -> self.set_punctuation(OmegaPunctuationKind::Caret, 1)
            58 -> colon(second)
            44 -> self.set_punctuation(OmegaPunctuationKind::Comma, 1)
            46 -> dot(second, third)
            61 -> equal(second)
            33 -> exclamation(second)
            62 -> greater(second)
            35 -> self.set_punctuation(OmegaPunctuationKind::Hash, 1)
            123 -> self.set_punctuation(OmegaPunctuationKind::LeftBrace, 1)
            91 -> self.set_punctuation(OmegaPunctuationKind::LeftBracket, 1)
            40 -> self.set_punctuation(OmegaPunctuationKind::LeftParen, 1)
            60 -> less(second)
            45 -> minus(second)
            37 -> percent(second)
            124 -> pipe(second)
            43 -> plus(second)
            125 -> self.set_punctuation(OmegaPunctuationKind::RightBrace, 1)
            93 -> self.set_punctuation(OmegaPunctuationKind::RightBracket, 1)
            41 -> self.set_punctuation(OmegaPunctuationKind::RightParen, 1)
            59 -> self.set_punctuation(OmegaPunctuationKind::Semicolon, 1)
            47 -> slash(second)
            126 -> self.set_punctuation(OmegaPunctuationKind::Tilde, 1)
            _ -> unsupported()
        }
    }

    state ampersand(second: i32) {
        transition second {
            38 -> self.set_punctuation(OmegaPunctuationKind::AndAnd, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Ampersand, 1)
        }
    }

    state asterisk(second: i32) {
        transition second {
            61 -> self.set_punctuation(OmegaPunctuationKind::AsteriskEqual, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Asterisk, 1)
        }
    }

    state colon(second: i32) {
        transition second {
            58 -> self.set_punctuation(OmegaPunctuationKind::ColonColon, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Colon, 1)
        }
    }

    state dot(second: i32, third: i32) {
        transition second {
            46 -> dotdot(third)
            _ -> self.set_punctuation(OmegaPunctuationKind::Dot, 1)
        }
    }

    state dotdot(third: i32) {
        transition third {
            61 -> self.set_punctuation(OmegaPunctuationKind::DotDotEqual, 3)
            _ -> self.set_punctuation(OmegaPunctuationKind::DotDot, 2)
        }
    }

    state equal(second: i32) {
        transition second {
            61 -> self.set_punctuation(OmegaPunctuationKind::EqualEqual, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Equal, 1)
        }
    }

    state exclamation(second: i32) {
        transition second {
            61 -> self.set_punctuation(OmegaPunctuationKind::ExclamationEqual, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Exclamation, 1)
        }
    }

    state greater(second: i32) {
        transition second {
            62 -> self.set_punctuation(OmegaPunctuationKind::GreaterGreater, 2)
            61 -> self.set_punctuation(OmegaPunctuationKind::GreaterEqual, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Greater, 1)
        }
    }

    state less(second: i32) {
        transition second {
            60 -> self.set_punctuation(OmegaPunctuationKind::LessLess, 2)
            61 -> self.set_punctuation(OmegaPunctuationKind::LessEqual, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Less, 1)
        }
    }

    state minus(second: i32) {
        transition second {
            62 -> self.set_punctuation(OmegaPunctuationKind::Arrow, 2)
            61 -> self.set_punctuation(OmegaPunctuationKind::MinusEqual, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Minus, 1)
        }
    }

    state percent(second: i32) {
        transition second {
            61 -> self.set_punctuation(OmegaPunctuationKind::PercentEqual, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Percent, 1)
        }
    }

    state pipe(second: i32) {
        transition second {
            124 -> self.set_punctuation(OmegaPunctuationKind::PipePipe, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Pipe, 1)
        }
    }

    state plus(second: i32) {
        transition second {
            61 -> self.set_punctuation(OmegaPunctuationKind::PlusEqual, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Plus, 1)
        }
    }

    state slash(second: i32) {
        transition second {
            61 -> self.set_punctuation(OmegaPunctuationKind::SlashEqual, 2)
            _ -> self.set_punctuation(OmegaPunctuationKind::Slash, 1)
        }
    }

    state unsupported() {
        self.reject(
            OmegaLexDiagnosticCode::OutsideLexicalProfile,
            self.token_start,
            self.token_start + 1
        );
    }
}

machine omega_utf8_lead_width(byte: i32) -> i32 {
    transition byte < 128 {
        true -> return 1
        _ -> two()
    }

    state two() {
        transition byte <= 223 {
            true -> return 2
            _ -> three()
        }
    }

    state three() {
        transition byte <= 239 {
            true -> return 3
            _ -> return 4
        }
    }
}

machine OmegaLexScan::raw_candidate_end(
    &mut self,
    source: &[u8],
    cursor: i32
) -> i32 {
    transition cursor >= 0 {
        true -> check_extent()
        _ -> invalid()
    }

    state check_extent() {
        transition cursor < source.len {
            true -> check_raw()
            _ -> invalid()
        }
    }

    state check_raw() {
        transition source[cursor] {
            114 -> scan(cursor + 1)
            _ -> invalid()
        }
    }

    state scan(index: i32) {
        transition index < source.len {
            true -> classify(index)
            _ -> return -1
        }
    }

    state classify(index: i32) {
        transition source[index] {
            35 -> scan(index + 1)
            34 -> return index + 1
            _ -> return -1
        }
    }

    state invalid() {
        self.fail_stage();
        return -1;
    }
}

// Factored token stage invoked only inside a canonical operation immediately
// after that operation preflights the exact source view. It is nevertheless
// total and memory-bounded for every direct call because D17 cannot make the
// stage private. It is not a transferable preflight token or a standalone
// lexical judgment; scan_at below owns that boundary.
machine OmegaLexScan::scan_preflighted_stage(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    self.reset(cursor);
    transition cursor >= 0 {
        true -> check_high()
        _ -> internal()
    }

    state check_high() {
        transition cursor <= source.len {
            true -> check_end()
            _ -> internal()
        }
    }

    state check_end() {
        transition cursor < source.len {
            true -> first()
            _ -> return
        }
    }

    state first() {
        let byte: i32 = source[cursor];
        transition byte >= 128 {
            true -> outside_non_ascii(byte)
            _ -> whitespace(byte)
        }
    }

    state outside_non_ascii(byte: i32) {
        transition byte >= 194 {
            true -> check_scalar_ceiling(byte)
            _ -> internal()
        }
    }

    state check_scalar_ceiling(byte: i32) {
        transition byte <= 244 {
            true -> check_scalar_extent(byte)
            _ -> internal()
        }
    }

    state check_scalar_extent(byte: i32) {
        let width: i32 = omega_utf8_lead_width(byte);
        transition width <= source.len - cursor {
            true -> outside_scalar(width)
            _ -> internal()
        }
    }

    state outside_scalar(width: i32) {
        self.reject(
            OmegaLexDiagnosticCode::OutsideLexicalProfile,
            cursor,
            cursor + width
        );
    }

    state whitespace(byte: i32) {
        transition omega_is_whitespace(byte) {
            1 -> self.scan_whitespace(source, cursor)
            _ -> comment_extent(byte)
        }
    }

    state comment_extent(byte: i32) {
        transition (byte == 47) && (source.len - cursor >= 2) {
            true -> comment_second()
            _ -> raw(byte)
        }
    }

    state comment_second() {
        transition source[cursor + 1] {
            47 -> self.scan_line_comment(source, cursor)
            42 -> self.scan_block_comment(source, cursor)
            _ -> raw(47)
        }
    }

    state raw(byte: i32) {
        transition byte {
            114 -> raw_candidate()
            _ -> identifier(byte)
        }
    }

    state raw_candidate() {
        let end: i32 = self.raw_candidate_end(source, cursor);
        transition end >= 0 {
            true -> raw_reject(end)
            _ -> identifier(114)
        }
    }

    state raw_reject(end: i32) {
        self.reject(
            OmegaLexDiagnosticCode::OutsideLexicalProfile,
            cursor,
            end
        );
    }

    state identifier(byte: i32) {
        transition omega_is_identifier_start(byte) {
            1 -> self.scan_identifier(source, cursor)
            _ -> number(byte)
        }
    }

    state number(byte: i32) {
        transition (byte >= 48) && (byte <= 57) {
            true -> self.scan_number(source, cursor)
            _ -> leading_dot(byte)
        }
    }

    state leading_dot(byte: i32) {
        transition (byte == 46) && (source.len - cursor >= 2) {
            true -> leading_dot_second()
            _ -> string(byte)
        }
    }

    state leading_dot_second() {
        let next: i32 = source[cursor + 1];
        transition (next >= 48) && (next <= 57) {
            true -> self.scan_number(source, cursor)
            _ -> string(46)
        }
    }

    state string(byte: i32) {
        transition byte {
            34 -> self.scan_string(source, cursor)
            _ -> self.scan_punctuation(source, cursor)
        }
    }

    state internal() {
        self.fail_stage();
    }
}

// Canonical standalone one-token query. InvalidUtf8 retains whole-view priority
// even when malformed bytes occur after the requested token.
machine OmegaLexScan::scan_at(
    &mut self,
    source: &[u8],
    cursor: i32
) {
    self.reset(0);
    self.utf8.validate(source);
    transition self.utf8.valid {
        1 -> scan_validated()
        _ -> invalid_utf8()
    }

    state scan_validated() {
        self.scan_preflighted_stage(source, cursor);
    }

    state invalid_utf8() {
        self.reject(
            OmegaLexDiagnosticCode::InvalidUtf8,
            self.utf8.error_offset,
            self.utf8.error_offset + 1
        );
    }
}

// Validate the complete view before any parser can stop at an early token.
// Success leaves accepted=1, has_token=0, and next_cursor=source.len.
machine OmegaLexScan::validate_lexical(
    &mut self,
    source: &[u8]
) {
    self.reset(0);
    self.utf8.validate(source);
    transition self.utf8.valid {
        1 -> scan(0)
        _ -> invalid_utf8()
    }

    state scan(cursor: i32) {
        transition cursor < source.len {
            true -> token(cursor)
            _ -> complete()
        }
    }

    state token(cursor: i32) {
        self.scan_preflighted_stage(source, cursor);
        transition self.accepted {
            1 -> check_progress(cursor)
            _ -> return
        }
    }

    state check_progress(cursor: i32) {
        transition (self.has_token == 1) && (self.next_cursor > cursor) {
            true -> scan(self.next_cursor)
            _ -> internal()
        }
    }

    state complete() {
        self.reset(source.len);
    }

    state invalid_utf8() {
        self.reject(
            OmegaLexDiagnosticCode::InvalidUtf8,
            self.utf8.error_offset,
            self.utf8.error_offset + 1
        );
    }

    state internal() {
        self.fail_stage();
    }
}

// Canonical parser invocation for one immutable source view. The invocation
// performs the whole-view lexical judgment once, then streams that exact view
// through bounded scanner stages. State purposes select parser-local grammar
// positions; no purpose or preflight fact escapes this invocation.
//
// The retained syntax currently owns ordinary `use path::member;`, basic
// `[pub] data` roots, and `[pub]`/target-scoped machine roots with source-ordered
// states, state parameters, optional immediate return types, and bodies
// containing neutral path calls, simple assignments, or restricted transition
// blocks. Data fields,
// parameters, and returns share named/Self/Unit, outer-reference with optional
// lifetime, domain-qualified, range-refined, and nested fixed-array/slice type
// syntax; parameters additionally retain their canonical
// simple modifiers, binding references, and receivers.
// Rich valid syntax stops as Incomplete rather than becoming a false Omega
// rejection. Later grammar slices extend this machine.
machine OmegaParser::parse_view(
    &mut self,
    source: &[u8]
) {
    self.root_count = 0;
    self.member_count = 0;
    self.use_count = 0;
    self.data_count = 0;
    self.machine_count = 0;
    self.machine_state_count = 0;
    self.machine_parameter_count = 0;
    self.statement_count = 0;
    self.call_statement_count = 0;
    self.assignment_statement_count = 0;
    self.transition_statement_count = 0;
    self.static_machine_argument_count = 0;
    self.expression_count = 0;
    self.call_argument_count = 0;
    self.struct_literal_count = 0;
    self.struct_literal_field_count = 0;
    self.data_member_count = 0;
    self.data_field_count = 0;
    self.data_payload_field_count = 0;
    self.data_case_count = 0;
    self.type_reference_count = 0;
    self.type_constraint_count = 0;
    self.cursor = 0;
    self.item_start = 0;
    self.first_member = 0;
    self.path_destination = OmegaPathDestination::Use;
    self.data_name_start = 0;
    self.data_name_end = 0;
    self.data_first_member = 0;
    self.data_first_field = 0;
    self.data_first_case = 0;
    self.data_is_public = 0;
    self.data_multiplicity = OmegaDataMultiplicity::Affine;
    self.type_subject_start = 0;
    self.type_subject_name_start = 0;
    self.type_subject_name_end = 0;
    self.type_consumer = OmegaTypeConsumer::DirectDataField;
    self.type_name_start = 0;
    self.type_name_end = 0;
    self.type_end = 0;
    self.type_constraint_mode = 0;
    self.type_domain_name_start = 0;
    self.type_domain_name_end = 0;
    self.type_range_minimum_start = 0;
    self.type_range_minimum_end = 0;
    self.type_range_maximum_start = 0;
    self.type_range_maximum_end = 0;
    self.type_root = 0;
    self.type_allows_range = 0;
    self.type_array_frame_count = 0;
    self.type_array_depth = 0;
    self.type_required_nodes = 0;
    self.type_array_emit_index = 0;
    self.case_start = 0;
    self.case_keyword_end = 0;
    self.case_name_start = 0;
    self.case_name_end = 0;
    self.case_body_end = 0;
    self.case_first_payload_field = 0;
    self.machine_first_state = 0;
    self.state_first_parameter = 0;
    self.machine_parameter_has_more = 0;
    self.machine_path_member_count = 0;
    self.machine_is_public = 0;
    self.machine_has_target = 0;
    self.machine_target_start = 0;
    self.machine_target_end = 0;
    self.state_has_return_type = 0;
    self.state_return_type = 0;
    self.state_first_statement = 0;
    self.state_has_body_syntax = 0;
    self.state_is_explicit = 0;
    self.state_name_start = 0;
    self.state_name_end = 0;
    self.machine_parameter_is_const = 0;
    self.machine_parameter_is_leading_mutable = 0;
    self.machine_parameter_is_mutable = 0;
    self.machine_parameter_is_self = 0;
    self.machine_parameter_has_binding_reference = 0;
    self.machine_parameter_binding_access = OmegaReferenceAccess::Shared;
    self.type_base_kind = OmegaTypeBaseKind::Named;
    self.type_has_reference = 0;
    self.type_reference_access = OmegaReferenceAccess::Shared;
    self.type_reference_is_exclusive = 0;
    self.type_reference_has_lifetime = 0;
    self.type_reference_lifetime_start = 0;
    self.type_reference_lifetime_end = 0;
    self.call_start = 0;
    self.call_first_path_member = 0;
    self.call_path_member_count = 0;
    self.call_receiver_starts_at_self = 0;
    self.call_first_machine_argument = 0;
    self.call_first_argument = 0;
    self.static_argument_first_path_member = 0;
    self.static_argument_path_member_count = 0;
    self.static_argument_start = 0;
    self.argument_first_path_member = 0;
    self.argument_path_member_count = 0;
    self.argument_starts_at_self = 0;
    self.argument_name_member_count = 0;
    self.argument_path_kind = OmegaPathExpressionKind::Name;
    self.expression_consumer = OmegaExpressionConsumer::CallArgument;
    self.expression_result = 0;
    self.expression_end = 0;
    self.assignment_target_expression = 0;
    self.assignment_target_name_member_count = 0;
    self.assignment_target_path_kind = OmegaPathExpressionKind::Name;
    self.assignment_value_expression = 0;
    self.struct_literal_consumer = OmegaExpressionConsumer::CallArgument;
    self.struct_literal_first_type_member = 0;
    self.struct_literal_type_member_count = 0;
    self.struct_literal_first_field = 0;
    self.struct_literal_start = 0;
    self.struct_field_name_start = 0;
    self.struct_field_name_end = 0;
    self.struct_field_value = 0;
    self.struct_field_value_end = 0;
    self.transition_subject_expression = 0;
    self.transition_guard_kind = OmegaTransitionGuardKind::Always;
    self.transition_guard_boolean = 0;
    self.transition_guard_start = 0;
    self.transition_guard_end = 0;
    self.transition_arrow_start = 0;
    self.transition_arrow_end = 0;
    self.transition_target_start = 0;
    self.transition_target_end = 0;
    self.status = OmegaParserStatus::Parsing;
    self.diagnostic_code = OmegaParseDiagnosticCode::None;
    self.diagnostic_start = 0;
    self.diagnostic_end = 0;
    self.incomplete_start = 0;
    self.incomplete_end = 0;
    self.resource = OmegaParserResource::None;
    self.resource_limit = 0;
    self.resource_requested = 0;
    self.scan.validate_lexical(source);
    transition self.scan.accepted {
        1 -> scan_semantic(0)
        _ -> lexical_failure()
    }

    state lexical_failure() {
        transition self.scan.internal_failure {
            1 -> internal_failure()
            _ -> lexical_rejection()
        }
    }

    state lexical_rejection() {
        self.status = OmegaParserStatus::LexicalFailure;
        self.diagnostic_start = self.scan.diagnostic_start;
        self.diagnostic_end = self.scan.diagnostic_end;
    }

    // scan_preflighted_stage is public only because D17 has no private machine
    // visibility. Here it is authorized solely by validate_lexical above and
    // the same invocation-local source parameter.
    state scan_semantic(purpose: i32) {
        self.scan.scan_preflighted_stage(source, self.cursor);
        transition self.scan.accepted {
            1 -> scanned(purpose)
            _ -> internal_failure()
        }
    }

    state scanned(purpose: i32) {
        transition self.scan.has_token {
            1 -> token_progress(purpose)
            _ -> end_progress(purpose)
        }
    }

    state token_progress(purpose: i32) {
        transition (self.scan.token_start == self.cursor) &&
            (self.scan.token_end > self.cursor) &&
            (self.scan.token_end <= source.len) &&
            (self.scan.next_cursor > self.cursor) &&
            (self.scan.next_cursor <= source.len) {
            true -> token_advance_shape(purpose)
            _ -> internal_failure()
        }
    }

    state token_advance_shape(purpose: i32) {
        transition self.scan.token_end == self.scan.next_cursor {
            true -> trivia(purpose)
            _ -> line_comment_advance(purpose)
        }
    }

    // A line comment excludes its terminating LF from the token span but owns
    // that byte's advance. No other scanner token may hide a span/advance gap.
    state line_comment_advance(purpose: i32) {
        transition self.scan.token_kind {
            OmegaTokenKind::LineComment -> line_comment_extent(purpose)
            _ -> internal_failure()
        }
    }

    state line_comment_extent(purpose: i32) {
        transition (self.scan.token_end < source.len) &&
            (self.scan.next_cursor == self.scan.token_end + 1) {
            true -> line_comment_newline(purpose)
            _ -> internal_failure()
        }
    }

    state line_comment_newline(purpose: i32) {
        transition source[self.scan.token_end] {
            10 -> trivia(purpose)
            _ -> internal_failure()
        }
    }

    state end_progress(purpose: i32) {
        transition self.cursor == source.len {
            true -> end_of_view(purpose)
            _ -> internal_failure()
        }
    }

    state trivia(purpose: i32) {
        transition self.scan.token_kind {
            OmegaTokenKind::Whitespace -> advance_trivia(purpose)
            OmegaTokenKind::LineComment -> advance_trivia(purpose)
            OmegaTokenKind::BlockComment -> advance_trivia(purpose)
            _ -> semantic_token(purpose)
        }
    }

    state advance_trivia(purpose: i32) {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(purpose) }
    }

    state semantic_token(purpose: i32) {
        transition purpose {
            0 -> root_token()
            1 -> member_token()
            2 -> path_tail_token()
            3 -> public_root_token()
            4 -> data_name_token()
            5 -> data_body_token()
            6 -> data_property_token()
            7 -> data_property_end_token()
            8 -> data_body_after_property_token()
            9 -> data_member_token()
            10 -> case_marker_tail_token()
            11 -> case_end_token(1)
            12 -> field_colon_token()
            13 -> type_token()
            14 -> type_end_token()
            15 -> case_payload_token()
            16 -> case_end_token(0)
            17 -> type_domain_token()
            18 -> type_domain_end_token()
            19 -> type_range_minimum_token()
            20 -> type_range_operator_token()
            21 -> type_range_maximum_token()
            22 -> type_range_close_token()
            23 -> type_constraint_end_token()
            24 -> array_element_token()
            25 -> array_semicolon_token()
            26 -> array_length_token()
            27 -> array_end_token()
            28 -> machine_parameter_or_end_token()
            29 -> machine_header_end_token()
            30 -> state_body_token()
            31 -> machine_parameter_token()
            32 -> machine_parameter_colon_token()
            33 -> machine_parameter_after_const_token()
            34 -> machine_parameter_core_token()
            35 -> machine_binding_access_or_name_token()
            36 -> machine_binding_name_token()
            37 -> type_reference_access_or_type_token()
            38 -> target_machine_token()
            39 -> type_reference_lifetime_token()
            40 -> unit_type_end_token()
            41 -> array_unit_type_end_token()
            42 -> call_path_tail_token()
            43 -> call_path_member_token()
            44 -> call_argument_or_end_token()
            45 -> path_expression_tail_token()
            46 -> path_expression_member_token()
            47 -> call_semicolon_token()
            48 -> assignment_value_token()
            50 -> call_static_argument_token()
            51 -> call_static_argument_tail_token()
            52 -> call_static_argument_member_token()
            53 -> static_call_open_token()
            54 -> primary_expression_end_token()
            55 -> struct_literal_field_or_end_token()
            56 -> struct_literal_field_colon_token()
            57 -> struct_literal_field_value_token()
            58 -> explicit_state_name_token()
            59 -> explicit_state_header_token()
            60 -> transition_subject_token()
            61 -> transition_arm_token()
            62 -> transition_arrow_token()
            63 -> transition_target_token()
            64 -> transition_target_open_token()
            65 -> transition_target_close_token()
            66 -> state_body_token()
            67 -> machine_member_token()
            _ -> internal_failure()
        }
    }

    state end_of_view(purpose: i32) {
        transition purpose {
            0 -> complete()
            1 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedPathMember,
                source.len,
                source.len
            )
            2 -> path_end_at_view_end()
            3 -> incomplete_at_end()
            4 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataName,
                source.len,
                source.len
            )
            5 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataBody,
                source.len,
                source.len
            )
            6 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataProperty,
                source.len,
                source.len
            )
            7 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataPropertyEnd,
                source.len,
                source.len
            )
            8 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataBody,
                source.len,
                source.len
            )
            9 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataMemberOrEnd,
                source.len,
                source.len
            )
            10 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseName,
                source.len,
                source.len
            )
            11 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseEnd,
                source.len,
                source.len
            )
            12 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldColon,
                source.len,
                source.len
            )
            13 -> type_missing_at_view_end()
            14 -> type_end_at_view_end()
            15 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataPayloadFieldOrEnd,
                source.len,
                source.len
            )
            16 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataCaseEnd,
                source.len,
                source.len
            )
            17 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeDomain,
                source.len,
                source.len
            )
            18 -> type_end_at_view_end()
            19 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeRangeBound,
                source.len,
                source.len
            )
            20 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeRangeOperator,
                source.len,
                source.len
            )
            21 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeRangeBound,
                source.len,
                source.len
            )
            22 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTypeRangeEnd,
                source.len,
                source.len
            )
            23 -> type_end_at_view_end()
            24 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArrayElementType,
                source.len,
                source.len
            )
            25 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArraySeparatorOrEnd,
                source.len,
                source.len
            )
            26 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArrayLength,
                source.len,
                source.len
            )
            27 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedArrayEnd,
                source.len,
                source.len
            )
            28 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterOrEnd,
                source.len,
                source.len
            )
            29 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBody,
                source.len,
                source.len
            )
            30 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBodyEnd,
                source.len,
                source.len
            )
            31 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                source.len,
                source.len
            )
            32 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterColon,
                source.len,
                source.len
            )
            33 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                source.len,
                source.len
            )
            34 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                source.len,
                source.len
            )
            35 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                source.len,
                source.len
            )
            36 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                source.len,
                source.len
            )
            37 -> type_missing_at_view_end()
            38 -> incomplete_at_end()
            39 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedReferenceLifetime,
                source.len,
                source.len
            )
            40 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                source.len,
                source.len
            )
            41 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedUnitTypeEnd,
                source.len,
                source.len
            )
            42 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCallPathTail,
                source.len,
                source.len
            )
            43 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCallPathMember,
                source.len,
                source.len
            )
            44 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCallArgument,
                source.len,
                source.len
            )
            45 -> path_expression_end_at_view_end()
            46 -> path_expression_member_end_at_view_end()
            47 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCallSemicolon,
                source.len,
                source.len
            )
            48 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedAssignmentValue,
                source.len,
                source.len
            )
            50 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticArgument,
                source.len,
                source.len
            )
            51 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticArgumentEnd,
                source.len,
                source.len
            )
            52 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticArgument,
                source.len,
                source.len
            )
            53 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStaticCallOpen,
                source.len,
                source.len
            )
            54 -> primary_expression_end_at_view_end()
            55 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStructLiteralFieldOrEnd,
                source.len,
                source.len
            )
            56 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStructLiteralFieldColon,
                source.len,
                source.len
            )
            57 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStructLiteralValue,
                source.len,
                source.len
            )
            58 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateName,
                source.len,
                source.len
            )
            59 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateBody,
                source.len,
                source.len
            )
            60 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionSubject,
                source.len,
                source.len
            )
            61 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionArm,
                source.len,
                source.len
            )
            62 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionArrow,
                source.len,
                source.len
            )
            63 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionTarget,
                source.len,
                source.len
            )
            64 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionTargetOpen,
                source.len,
                source.len
            )
            65 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionTargetClose,
                source.len,
                source.len
            )
            66 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateBody,
                source.len,
                source.len
            )
            67 -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBodyEnd,
                source.len,
                source.len
            )
            _ -> internal_failure()
        }
    }

    state path_end_at_view_end() {
        transition self.path_destination {
            OmegaPathDestination::Machine -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBody,
                source.len,
                source.len
            )
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon,
                source.len,
                source.len
            )
        }
    }

    state path_expression_end_at_view_end() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::CallArgument -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCallArgumentEnd,
                source.len,
                source.len
            )
            OmegaExpressionConsumer::AssignmentValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedAssignmentSemicolon,
                source.len,
                source.len
            )
            OmegaExpressionConsumer::StructFieldValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStructLiteralFieldEnd,
                source.len,
                source.len
            )
            OmegaExpressionConsumer::TransitionSubject -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionSubject,
                source.len,
                source.len
            )
        }
    }

    state path_expression_member_end_at_view_end() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::CallArgument -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCallPathMember,
                source.len,
                source.len
            )
            OmegaExpressionConsumer::AssignmentValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedAssignmentValue,
                source.len,
                source.len
            )
            OmegaExpressionConsumer::StructFieldValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStructLiteralValue,
                source.len,
                source.len
            )
            OmegaExpressionConsumer::TransitionSubject -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionSubject,
                source.len,
                source.len
            )
        }
    }

    state primary_expression_end_at_view_end() {
        transition self.expression_consumer {
            OmegaExpressionConsumer::CallArgument -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedCallArgumentEnd,
                source.len,
                source.len
            )
            OmegaExpressionConsumer::AssignmentValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedAssignmentSemicolon,
                source.len,
                source.len
            )
            OmegaExpressionConsumer::StructFieldValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStructLiteralFieldEnd,
                source.len,
                source.len
            )
            OmegaExpressionConsumer::TransitionSubject -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedTransitionSubject,
                source.len,
                source.len
            )
        }
    }

    state type_missing_at_view_end() {
        transition self.type_consumer {
            OmegaTypeConsumer::MachineParameter -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterType,
                source.len,
                source.len
            )
            OmegaTypeConsumer::MachineReturn -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineReturnType,
                source.len,
                source.len
            )
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldType,
                source.len,
                source.len
            )
        }
    }

    state type_end_at_view_end() {
        transition self.type_consumer {
            OmegaTypeConsumer::MachineParameter -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterEnd,
                source.len,
                source.len
            )
            OmegaTypeConsumer::MachineReturn -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineReturnEnd,
                source.len,
                source.len
            )
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedDataFieldEnd,
                source.len,
                source.len
            )
        }
    }

    state root_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Keyword -> root_keyword()
            OmegaTokenKind::Identifier -> begin_target_machine_root()
            _ -> incomplete_root()
        }
    }

    state root_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::Use -> begin_use()
            OmegaKeywordKind::Data -> begin_data_root()
            OmegaKeywordKind::Machine -> begin_machine_root()
            OmegaKeywordKind::Pub -> begin_public_root()
            _ -> incomplete_root()
        }
    }

    state incomplete_root() {
        self.status = OmegaParserStatus::Incomplete;
        self.incomplete_start = self.scan.token_start;
        self.incomplete_end = self.scan.token_end;
    }

    state incomplete_at_end() {
        self.status = OmegaParserStatus::Incomplete;
        self.incomplete_start = source.len;
        self.incomplete_end = source.len;
    }

    state begin_use() {
        transition self.root_count < 4096 {
            true -> begin_use_bounded()
            _ -> resource_failure(
                OmegaParserResource::Roots,
                4096,
                self.root_count + 1
            )
        }
    }

    state begin_use_bounded() {
        self.item_start = self.scan.token_start;
        self.first_member = self.member_count;
        self.path_destination = OmegaPathDestination::Use;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(1) }
    }

    state begin_machine_root() {
        self.item_start = self.scan.token_start;
        transition true { true -> begin_unscoped_machine(0) }
    }

    state begin_unscoped_machine(is_public: i32) {
        self.machine_has_target = 0;
        self.machine_target_start = 0;
        self.machine_target_end = 0;
        transition true { true -> begin_machine(is_public) }
    }

    state begin_target_machine_root() {
        self.item_start = self.scan.token_start;
        self.machine_has_target = 1;
        self.machine_target_start = self.scan.token_start;
        self.machine_target_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(38) }
    }

    state target_machine_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Keyword -> target_machine_keyword()
            _ -> incomplete_root()
        }
    }

    state target_machine_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::Machine -> begin_machine(0)
            _ -> incomplete_root()
        }
    }

    state begin_machine(is_public: i32) {
        transition self.root_count < 4096 {
            true -> begin_machine_bounded(is_public)
            _ -> resource_failure(
                OmegaParserResource::Roots,
                4096,
                self.root_count + 1
            )
        }
    }

    state begin_machine_bounded(is_public: i32) {
        self.first_member = self.member_count;
        self.machine_first_state = self.machine_state_count;
        self.state_first_parameter = self.machine_parameter_count;
        self.state_first_statement = self.statement_count;
        self.state_has_body_syntax = 0;
        self.state_is_explicit = 0;
        self.state_name_start = 0;
        self.state_name_end = 0;
        self.machine_is_public = is_public;
        self.state_has_return_type = 0;
        self.state_return_type = 0;
        self.path_destination = OmegaPathDestination::Machine;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(1) }
    }

    state member_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> retain_member()
            OmegaTokenKind::Keyword -> keyword_member()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedPathMember,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    // Omega's name-like parser rule admits contextual and ordinary keyword
    // spellings in paths. `Self` and `self` remain semantic self forms rather
    // than import-path members.
    state keyword_member() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedPathMember,
                self.scan.token_start,
                self.scan.token_end
            )
            OmegaKeywordKind::SelfValue -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedPathMember,
                self.scan.token_start,
                self.scan.token_end
            )
            _ -> retain_member()
        }
    }

    state retain_member() {
        transition self.member_count < 16384 {
            true -> retain_member_bounded()
            _ -> resource_failure(
                OmegaParserResource::PathMembers,
                16384,
                self.member_count + 1
            )
        }
    }

    state retain_member_bounded() {
        self.members[self.member_count].start = self.scan.token_start;
        self.members[self.member_count].end = self.scan.token_end;
        self.member_count = self.member_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(2) }
    }

    state path_tail_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> path_tail_punctuation()
            _ -> path_tail_nonpunctuation()
        }
    }

    state path_tail_nonpunctuation() {
        transition self.path_destination {
            OmegaPathDestination::Machine -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state path_tail_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::ColonColon -> next_member()
            _ -> finish_path_punctuation()
        }
    }

    state finish_path_punctuation() {
        transition self.path_destination {
            OmegaPathDestination::Use -> use_path_end()
            OmegaPathDestination::Machine -> machine_path_end()
        }
    }

    state use_path_end() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Semicolon -> retain_use()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_path_end() {
        self.machine_path_member_count = self.member_count - self.first_member;
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftParen -> begin_machine_parameters()
            OmegaPunctuationKind::LeftBrace -> enter_machine_body()
            OmegaPunctuationKind::Less -> incomplete_root()
            OmegaPunctuationKind::Arrow -> begin_machine_return_type()
            OmegaPunctuationKind::Semicolon -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state next_member() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(1) }
    }

    state retain_use() {
        self.uses[self.use_count].first_member = self.first_member;
        self.uses[self.use_count].member_count =
            self.member_count - self.first_member;
        self.uses[self.use_count].start = self.item_start;
        self.uses[self.use_count].end = self.scan.token_end;
        self.roots[self.root_count].kind = OmegaRootKind::Use;
        self.roots[self.root_count].item_index = self.use_count;
        self.use_count = self.use_count + 1;
        self.root_count = self.root_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(0) }
    }

    state begin_machine_parameters() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(28) }
    }

    state machine_parameter_or_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> machine_parameter_or_end_punctuation()
            OmegaTokenKind::Identifier -> begin_machine_parameter_form()
            OmegaTokenKind::Keyword -> begin_machine_parameter_form()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_parameter_or_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightParen -> finish_machine_parameters()
            OmegaPunctuationKind::Ampersand -> begin_machine_parameter_form()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterOrEnd,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_parameter_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> begin_machine_parameter_form()
            OmegaTokenKind::Keyword -> begin_machine_parameter_form()
            OmegaTokenKind::Punctuation -> machine_parameter_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_parameter_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Ampersand -> begin_machine_parameter_form()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_machine_parameter_form() {
        self.machine_parameter_is_const = 0;
        self.machine_parameter_is_leading_mutable = 0;
        self.machine_parameter_is_mutable = 0;
        self.machine_parameter_is_self = 0;
        self.machine_parameter_has_binding_reference = 0;
        self.machine_parameter_binding_access = OmegaReferenceAccess::Shared;
        transition true { true -> machine_parameter_prefix_token() }
    }

    state machine_parameter_prefix_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> machine_parameter_prefix_identifier()
            OmegaTokenKind::Keyword -> machine_parameter_core_keyword()
            OmegaTokenKind::Punctuation -> machine_parameter_core_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_parameter_prefix_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "const"
        ) {
            1 -> retain_machine_parameter_const()
            _ -> machine_parameter_leading_mutable_identifier()
        }
    }

    state machine_parameter_leading_mutable_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "mut"
        ) {
            1 -> retain_machine_parameter_leading_mutable()
            _ -> begin_machine_parameter()
        }
    }

    state retain_machine_parameter_const() {
        self.machine_parameter_is_const = 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(33) }
    }

    state machine_parameter_after_const_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> machine_parameter_after_const_identifier()
            OmegaTokenKind::Keyword -> machine_parameter_core_keyword()
            OmegaTokenKind::Punctuation -> machine_parameter_core_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_parameter_after_const_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "mut"
        ) {
            1 -> retain_machine_parameter_leading_mutable()
            _ -> begin_machine_parameter()
        }
    }

    state retain_machine_parameter_leading_mutable() {
        self.machine_parameter_is_leading_mutable = 1;
        self.machine_parameter_is_mutable = 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(34) }
    }

    state machine_parameter_core_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> begin_machine_parameter()
            OmegaTokenKind::Keyword -> machine_parameter_core_keyword()
            OmegaTokenKind::Punctuation -> machine_parameter_core_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_parameter_core_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> incomplete_root()
            OmegaKeywordKind::SelfValue -> begin_machine_self_parameter()
            _ -> begin_machine_parameter()
        }
    }

    state machine_parameter_core_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Ampersand -> begin_machine_binding_reference()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_machine_binding_reference() {
        self.machine_parameter_has_binding_reference = 1;
        self.machine_parameter_binding_access = OmegaReferenceAccess::Shared;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(35) }
    }

    state machine_binding_access_or_name_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> machine_binding_access_or_name_identifier()
            OmegaTokenKind::Keyword -> machine_binding_name_keyword()
            OmegaTokenKind::Punctuation -> machine_binding_access_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_binding_access_or_name_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "mut"
        ) {
            1 -> retain_machine_binding_mutable()
            _ -> machine_binding_write_or_name_identifier()
        }
    }

    state machine_binding_write_or_name_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "write"
        ) {
            1 -> retain_machine_binding_write_only()
            _ -> begin_machine_parameter()
        }
    }

    state retain_machine_binding_mutable() {
        self.machine_parameter_binding_access = OmegaReferenceAccess::Mutable;
        self.machine_parameter_is_mutable = 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(36) }
    }

    state retain_machine_binding_write_only() {
        self.machine_parameter_binding_access = OmegaReferenceAccess::WriteOnly;
        self.machine_parameter_is_mutable = 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(36) }
    }

    state machine_binding_access_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Ampersand -> incomplete_root()
            OmegaPunctuationKind::Apostrophe -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_binding_name_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> begin_machine_parameter()
            OmegaTokenKind::Keyword -> machine_binding_name_keyword()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameter,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_binding_name_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> incomplete_root()
            OmegaKeywordKind::SelfValue -> begin_machine_self_parameter()
            _ -> begin_machine_parameter()
        }
    }

    state begin_machine_parameter() {
        self.type_subject_start = self.scan.token_start;
        self.type_subject_name_start = self.scan.token_start;
        self.type_subject_name_end = self.scan.token_end;
        self.type_consumer = OmegaTypeConsumer::MachineParameter;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(32) }
    }

    state begin_machine_self_parameter() {
        self.type_subject_start = self.scan.token_start;
        self.type_subject_name_start = self.scan.token_start;
        self.type_subject_name_end = self.scan.token_end;
        self.type_consumer = OmegaTypeConsumer::MachineParameter;
        self.machine_parameter_is_self = 1;
        self.type_base_kind = OmegaTypeBaseKind::SelfType;
        self.type_has_reference = 0;
        self.type_reference_access = OmegaReferenceAccess::Shared;
        self.type_reference_is_exclusive = 0;
        self.type_reference_has_lifetime = 0;
        self.type_reference_lifetime_start = 0;
        self.type_reference_lifetime_end = 0;
        self.type_constraint_mode = 0;
        self.type_array_frame_count = 0;
        self.type_array_depth = 0;
        self.type_allows_range = 0;
        self.type_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition self.machine_parameter_has_binding_reference {
            1 -> begin_machine_self_reference()
            _ -> scan_semantic(14)
        }
    }

    state begin_machine_self_reference() {
        self.type_has_reference = 1;
        transition self.machine_parameter_is_leading_mutable {
            1 -> retain_leading_mutable_self_reference()
            _ -> retain_binding_self_reference()
        }
    }

    state retain_leading_mutable_self_reference() {
        self.type_reference_access = OmegaReferenceAccess::Mutable;
        self.type_reference_is_exclusive = 1;
        transition true { true -> scan_semantic(14) }
    }

    state retain_binding_self_reference() {
        self.type_reference_access = self.machine_parameter_binding_access;
        self.type_reference_is_exclusive = self.machine_parameter_is_mutable;
        transition true { true -> scan_semantic(14) }
    }

    state machine_parameter_colon_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> machine_parameter_colon_punctuation()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterColon,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_parameter_colon_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Colon -> begin_type()
            OmegaPunctuationKind::Hash -> incomplete_root()
            OmegaPunctuationKind::LeftBracket -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineParameterColon,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state finish_machine_parameters() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(29) }
    }

    state machine_header_end_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> machine_header_end_punctuation()
            OmegaTokenKind::Identifier -> incomplete_root()
            OmegaTokenKind::Keyword -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_header_end_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftBrace -> enter_current_state_body()
            OmegaPunctuationKind::Arrow -> begin_machine_return_type()
            OmegaPunctuationKind::Semicolon -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedMachineBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_machine_return_type() {
        self.type_consumer = OmegaTypeConsumer::MachineReturn;
        transition true { true -> begin_type() }
    }

    state enter_machine_body() {
        self.state_is_explicit = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> resume_state_body() }
    }

    state enter_current_state_body() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> resume_state_body() }
    }

    state resume_state_body() {
        transition self.state_is_explicit {
            1 -> scan_semantic(66)
            _ -> scan_semantic(30)
        }
    }

    state state_body_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> state_body_punctuation()
            OmegaTokenKind::Identifier -> begin_named_call_statement()
            OmegaTokenKind::Keyword -> state_body_keyword()
            _ -> incomplete_root()
        }
    }

    state state_body_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfType -> incomplete_root()
            OmegaKeywordKind::SelfValue -> begin_self_call_statement()
            OmegaKeywordKind::True -> incomplete_root()
            OmegaKeywordKind::False -> incomplete_root()
            OmegaKeywordKind::Let -> incomplete_root()
            OmegaKeywordKind::If -> incomplete_root()
            OmegaKeywordKind::Transition -> begin_transition()
            OmegaKeywordKind::Match -> incomplete_root()
            OmegaKeywordKind::State -> begin_nested_state()
            _ -> begin_named_call_statement()
        }
    }

    state state_body_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBrace -> finish_current_state()
            _ -> incomplete_root()
        }
    }

    state finish_current_state() {
        transition self.state_is_explicit {
            1 -> retain_explicit_state_for_machine_members()
            _ -> retain_implicit_state_for_machine()
        }
    }

    state begin_nested_state() {
        transition self.state_is_explicit {
            1 -> incomplete_root()
            _ -> begin_explicit_state_after_implicit_check()
        }
    }

    state begin_explicit_state_after_implicit_check() {
        transition (self.machine_parameter_count > self.state_first_parameter) ||
            (self.state_has_return_type == 1) ||
            (self.state_has_body_syntax == 1) ||
            (self.statement_count > self.state_first_statement) {
            true -> retain_implicit_state_for_explicit_state()
            _ -> begin_explicit_state()
        }
    }

    state begin_explicit_state() {
        self.state_is_explicit = 1;
        self.state_first_parameter = self.machine_parameter_count;
        self.state_first_statement = self.statement_count;
        self.state_has_body_syntax = 0;
        self.state_has_return_type = 0;
        self.state_return_type = 0;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(58) }
    }

    state explicit_state_name_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> retain_explicit_state_name()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateName,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state retain_explicit_state_name() {
        self.state_name_start = self.scan.token_start;
        self.state_name_end = self.scan.token_end;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(59) }
    }

    state explicit_state_header_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> explicit_state_header_punctuation()
            OmegaTokenKind::Identifier -> incomplete_root()
            OmegaTokenKind::Keyword -> incomplete_root()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state explicit_state_header_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::LeftParen -> begin_machine_parameters()
            OmegaPunctuationKind::LeftBrace -> enter_current_state_body()
            OmegaPunctuationKind::Arrow -> begin_machine_return_type()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedStateBody,
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state machine_member_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> machine_member_punctuation()
            OmegaTokenKind::Keyword -> machine_member_keyword()
            _ -> incomplete_root()
        }
    }

    state machine_member_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::State -> begin_explicit_state()
            _ -> incomplete_root()
        }
    }

    state machine_member_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBrace -> retain_machine()
            _ -> incomplete_root()
        }
    }

    state begin_transition() {
        self.state_has_body_syntax = 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(60) }
    }

    state transition_subject_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> begin_named_transition_subject()
            OmegaTokenKind::Keyword -> transition_subject_keyword()
            _ -> incomplete_root()
        }
    }

    state transition_subject_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::SelfValue -> begin_self_transition_subject()
            _ -> incomplete_root()
        }
    }

    state begin_named_transition_subject() {
        self.argument_starts_at_self = 0;
        self.argument_name_member_count = 1;
        self.argument_path_kind = OmegaPathExpressionKind::Name;
        self.expression_consumer = OmegaExpressionConsumer::TransitionSubject;
        transition true { true -> begin_path_expression() }
    }

    state begin_self_transition_subject() {
        self.argument_starts_at_self = 1;
        self.argument_name_member_count = 0;
        self.argument_path_kind = OmegaPathExpressionKind::SelfValue;
        self.expression_consumer = OmegaExpressionConsumer::TransitionSubject;
        transition true { true -> begin_path_expression() }
    }

    state retain_transition_subject_handle() {
        self.transition_subject_expression = self.expression_count;
        self.expression_count = self.expression_count + 1;
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(61) }
    }

    state transition_arm_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> transition_arm_punctuation()
            OmegaTokenKind::Identifier -> transition_arm_identifier()
            OmegaTokenKind::Integer -> transition_arm_integer()
            OmegaTokenKind::Keyword -> transition_arm_keyword()
            _ -> incomplete_root()
        }
    }

    state transition_arm_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::RightBrace -> finish_transition_block()
            _ -> incomplete_root()
        }
    }

    state transition_arm_identifier() {
        transition self.scan.span_equals(
            source,
            self.scan.token_start,
            self.scan.token_end,
            "_"
        ) {
            1 -> retain_wildcard_transition_guard()
            _ -> incomplete_root()
        }
    }

    state transition_arm_integer() {
        transition (self.scan.numeric_base == OmegaNumericBase::Decimal) &&
            (self.scan.numeric_empty_digits == 0) &&
            (self.scan.numeric_has_suffix == 0) &&
            (self.scan.numeric_has_exponent == 0) {
            true -> retain_integer_transition_guard()
            _ -> incomplete_root()
        }
    }

    state transition_arm_keyword() {
        transition self.scan.keyword {
            OmegaKeywordKind::True -> retain_boolean_transition_guard(1)
            OmegaKeywordKind::False -> retain_boolean_transition_guard(0)
            _ -> incomplete_root()
        }
    }

    state retain_wildcard_transition_guard() {
        self.transition_guard_kind = OmegaTransitionGuardKind::Always;
        self.transition_guard_boolean = 0;
        self.transition_guard_start = self.scan.token_start;
        self.transition_guard_end = self.scan.token_end;
        transition true { true -> after_transition_guard() }
    }

    state retain_integer_transition_guard() {
        self.transition_guard_kind = OmegaTransitionGuardKind::Integer;
        self.transition_guard_boolean = 0;
        self.transition_guard_start = self.scan.token_start;
        self.transition_guard_end = self.scan.token_end;
        transition true { true -> after_transition_guard() }
    }

    state retain_boolean_transition_guard(value: i32) {
        self.transition_guard_kind = OmegaTransitionGuardKind::Boolean;
        self.transition_guard_boolean = value;
        self.transition_guard_start = self.scan.token_start;
        self.transition_guard_end = self.scan.token_end;
        transition true { true -> after_transition_guard() }
    }

    state after_transition_guard() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(62) }
    }

    state transition_arrow_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Punctuation -> transition_arrow_punctuation()
            _ -> incomplete_root()
        }
    }

    state transition_arrow_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Arrow -> retain_transition_arrow()
            _ -> incomplete_root()
        }
