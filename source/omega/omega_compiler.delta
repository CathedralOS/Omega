    state type_reference_prefix_punctuation() {
        transition self.scan.punctuation {
            OmegaPunctuationKind::Apostrophe -> type_reference_lifetime_allowed()
            OmegaPunctuationKind::Ampersand -> incomplete_root()
            _ -> type_token()
        }
    }

    state type_reference_lifetime_allowed() {
        transition self.type_reference_has_lifetime {
            0 -> begin_type_reference_lifetime()
            _ -> type_missing_failure(
                self.scan.token_start,
                self.scan.token_end
            )
        }
    }

    state begin_type_reference_lifetime() {
        self.cursor = self.scan.next_cursor;
        transition true { true -> scan_semantic(39) }
    }

    state type_reference_lifetime_token() {
        transition self.scan.token_kind {
            OmegaTokenKind::Identifier -> retain_type_reference_lifetime()
            OmegaTokenKind::Keyword -> type_reference_lifetime_keyword()
            _ -> syntax_failure(
                OmegaParseDiagnosticCode::ExpectedReferenceLifetime,
                self.scan.token_start,
                self.scan.token_end
            )
