pub machine Provision::space(provision: Provision) -> CoordinateSpace {
    transition provision {
        Provision::RequestSubjectBytes -> request()
        Provision::RequestInvocationBytes -> request()
        Provision::TapePayloadBytes -> emitted_artifact()
        Provision::TapeFixups -> emitted_artifact()
        Provision::TapeLabels -> emitted_artifact()
        Provision::CoverageEmptySubject -> none()
        Provision::CoverageRequestSemantics -> none()
        Provision::RequestStagingBytes -> request()
        Provision::ProofSearchRosterRounds -> internal_row()
        Provision::ProofSearchCandidateWork -> internal_row()
        Provision::ProofSearchCyclicGuaranteeWork -> internal_row()
        Provision::ProofSearchResultGuaranteeWork -> internal_row()
        Provision::ProofSearchDivisorDefinitionVisits -> internal_row()
        Provision::ProofSearchDivisorSearchDepth -> internal_row()
        Provision::ProofSearchDivisorComputedJoins -> internal_row()
        Provision::ProofObligationIdentities -> internal_row()
        Provision::ProofSearchIntegerCertificateWork -> internal_row()
        _ -> canonical_source()
    }

    state none() -> CoordinateSpace {
        CoordinateSpace::None
    }

    state request() -> CoordinateSpace {
        CoordinateSpace::Request
    }

    state emitted_artifact() -> CoordinateSpace {
        CoordinateSpace::EmittedArtifact
    }

    state internal_row() -> CoordinateSpace {
        CoordinateSpace::InternalRow
    }

    state canonical_source() -> CoordinateSpace {
        CoordinateSpace::CanonicalSource
    }
}

// The frame's extent: 48 bytes for canonical source, whose tail carries the
// package and source-unit ordinals, and 40 bytes otherwise.
pub machine Outcome::frame_length(outcome: Outcome) -> u64 in Trapping {
    transition outcome.space {
        CoordinateSpace::CanonicalSource -> length(48)
        _ -> length(40)
    }

    state length(value: u64 in Trapping) -> u64 in Trapping {
        value
    }
}

// The frame's bytes by position: identity `FF 4F 43 4F 55 54 01 00`, tag,
// coordinate space, two reserved zeros, then the code (`u32`) and the
// coordinate, limit and requested amount (`u64`), all little-endian, then
// for canonical source the package and source-unit ordinals (`u32`).
pub machine Outcome::frame_byte(outcome: Outcome, index: u64 in Trapping) -> u8
crashes Trap
{
    transition index < 8 {
        true -> identity(index)
        _ -> header(outcome, index)
    }

    state identity(index: u64 in Trapping) -> u8 {
        transition index {
            0 -> byte(255)
            1 -> byte(79)
            2 -> byte(67)
            3 -> byte(79)
            4 -> byte(85)
            5 -> byte(84)
            6 -> byte(1)
            _ -> byte(0)
        }
    }

    state header(outcome: Outcome, index: u64 in Trapping) -> u8 {
        let tag: u8 = OutcomeTag::value(outcome.tag);
        let space: u8 = CoordinateSpace::value(outcome.space);
        transition index {
            8 -> byte(tag)
            9 -> byte(space)
            10 -> byte(0)
            11 -> byte(0)
            _ -> code(outcome, index)
        }
    }

    state code(outcome: Outcome, index: u64 in Trapping) -> u8 {
        transition index < 16 {
            true -> little_endian(outcome.code, index - 12)
            _ -> coordinate(outcome, index)
        }
    }

    state coordinate(outcome: Outcome, index: u64 in Trapping) -> u8 {
        let coordinate: u64 in Trapping = Outcome::published(outcome.coordinate);
        transition index < 24 {
            true -> little_endian(coordinate, index - 16)
            _ -> limit(outcome, index)
        }
    }

    state limit(outcome: Outcome, index: u64 in Trapping) -> u8 {
        let limit: u64 in Trapping = Outcome::published(outcome.limit);
        transition index < 32 {
            true -> little_endian(limit, index - 24)
            _ -> requested(outcome, index)
        }
    }

    state requested(outcome: Outcome, index: u64 in Trapping) -> u8 {
        let requested: u64 in Trapping = Outcome::published(outcome.requested);
        transition index < 40 {
            true -> little_endian(requested, index - 32)
            _ -> tail(outcome, index)
        }
    }

    state tail(outcome: Outcome, index: u64 in Trapping) -> u8 {
        transition index < 44 {
            true -> little_endian(outcome.package, index - 40)
            _ -> little_endian(outcome.source_unit, index - 44)
        }
    }

    state little_endian(value: u64 in Trapping, position: u64 in Trapping) -> u8 {
        Outcome::byte_of(value, position)
    }

    state byte(value: u8) -> u8 {
        value
    }
}

// A published quantity: `min(quantity, INT32_MAX)`.
machine Outcome::published(quantity: u64 in Trapping) -> u64 in Trapping {
    transition quantity > 2147483647 {
        true -> saturated()
        _ -> exact(quantity)
    }

    state saturated() -> u64 in Trapping {
        2147483647
    }

    state exact(quantity: u64 in Trapping) -> u64 in Trapping {
        quantity
    }
}

// The outcome's tag as the frame byte and the process exit value.
pub machine OutcomeTag::value(tag: OutcomeTag) -> u8 {
    transition tag {
        OutcomeTag::Reject -> byte(1)
        OutcomeTag::Incomplete -> byte(2)
        OutcomeTag::InternalFailure -> byte(3)
    }

    state byte(value: u8) -> u8 {
        value
    }
}

machine CoordinateSpace::value(space: CoordinateSpace) -> u8 {
    transition space {
        CoordinateSpace::None -> byte(0)
        CoordinateSpace::Request -> byte(1)
        CoordinateSpace::EmittedArtifact -> byte(2)
        CoordinateSpace::InternalRow -> byte(3)
        CoordinateSpace::CanonicalSource -> byte(4)
    }

    state byte(value: u8) -> u8 {
        value
    }
}

// Byte `position` (0 lowest) of `value`.
machine Outcome::byte_of(value: u64 in Trapping, position: u64 in Trapping) -> u8
crashes Trap
{
    transition position < 8 {
        true -> shift(position, value)
        _ -> invalid()
    }

    state shift(remaining: u64 in Trapping, rest: u64 in Trapping) -> u8 {
        transition remaining > 0 {
            true -> shift(remaining - 1, rest / 256)
            _ -> low(rest)
        }
    }

    state low(rest: u64 in Trapping) -> u8 {
        (rest % 256) as u8
    }

    state invalid() -> u8 {
        crash Trap;
    }
}
