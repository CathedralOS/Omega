use omega_language_std::console;

// The outcome side of the standalone compiler request
// (wiki/spec/build/compiler_request.md). A Complete result publishes the
// unwrapped artifact; every other outcome publishes exactly one closed OCOUT
// V1 frame and exits with the outcome's tag. Each tag owns its own code
// table: Reject codes name request and source refusals, and Incomplete codes
// are the scalar-resource table. The tables are typed here in the
// contract's row order; their wire numbers, limits and coordinate spaces are
// projections the frame encoder reads, embedded rather than read from any
// sidecar.

pub data OutcomeTag [copy] {
    case Reject;
    case Incomplete;
    case InternalFailure;
}

// Where a frame's primary coordinate points. Only canonical Omega source
// carries a tail: the package and source-unit ordinals.
pub data CoordinateSpace [copy] {
    case None;
    case Request;
    case EmittedArtifact;
    case InternalRow;
    case CanonicalSource;
}

// The assigned Reject codes: 1 the request, 2-12 lexical, declaration, entry
// and literal refusals, 13-89 the syntax inventory, 90-97 checking.
pub data RejectCode [copy] {
    case MalformedRequest;
    case InvalidUtf8;
    case OutsideLexicalProfile;
    case UnterminatedBlockComment;
    case UnterminatedStringLiteral;
    case UnterminatedStringEscape;
    case UnsupportedEscape;
    case UnterminatedHexEscape;
    case InvalidHexEscapeDigit;
    case DuplicateName;
    case MissingEntry;
    case IntegerLiteralOutOfRange;
    case ExpectedPathMember;
    case ExpectedPathSeparatorOrSemicolon;
    case ExpectedDataName;
    case ExpectedDataBody;
    case ExpectedDataProperty;
    case ExpectedDataPropertyEnd;
    case ExpectedDataMemberOrEnd;
    case ExpectedDataCaseName;
    case ExpectedDataCaseEnd;
    case ExpectedDataPayloadFieldOrEnd;
    case ExpectedDataFieldColon;
    case ExpectedDataFieldType;
    case ExpectedDataFieldEnd;
    case ExpectedTypeDomain;
    case ExpectedTypeRangeOperator;
    case ExpectedTypeRangeBound;
    case ExpectedTypeRangeEnd;
    case ExpectedArrayElementType;
    case ExpectedArraySeparatorOrEnd;
    case ExpectedArrayLength;
    case ExpectedArrayEnd;
    case ExpectedReferenceLifetime;
    case ExpectedUnitTypeEnd;
    case ExpectedMachineParameterOrEnd;
    case ExpectedMachineParameter;
    case ExpectedMachineParameterColon;
    case ExpectedMachineParameterType;
    case ExpectedMachineParameterEnd;
    case ExpectedMachineReturnType;
    case ExpectedMachineReturnEnd;
    case ExpectedMachineBody;
    case ExpectedMachineBodyEnd;
    case ExpectedExpressionPathMember;
    case ExpectedCallPathTail;
    case ExpectedCallArgument;
    case ExpectedCallArgumentEnd;
    case ExpectedCallSemicolon;
    case ExpectedAssignmentValue;
    case ExpectedAssignmentSemicolon;
    case ExpectedStaticArgument;
    case ExpectedStaticArgumentEnd;
    case ExpectedStaticCallOpen;
    case ExpectedStructLiteralFieldOrEnd;
    case ExpectedStructLiteralFieldColon;
    case ExpectedStructLiteralValue;
    case ExpectedStructLiteralFieldEnd;
    case ExpectedStateName;
    case ExpectedStateBody;
    case ExpectedTransitionSubject;
    case ExpectedTransitionArm;
    case ExpectedTransitionArrow;
    case ExpectedTransitionTarget;
    case ExpectedTransitionTargetOpen;
    case ExpectedTransitionTargetClose;
    case ExpectedSatisfiesTrait;
    case ExpectedSatisfiesRequirement;
    case ExpectedExternalBinding;
    case ExpectedExternalLeafEnd;
    case ExpectedReachService;
    case ExpectedTerminationBy;
    case ExpectedTerminationSubject;
    case ExpectedTerminationArrow;
    case ExpectedTerminationView;
    case ExpectedTerminationEnd;
    case ExpectedIndexedIndex;
    case ExpectedIndexedRangeEnd;
    case ExpectedIndexedTail;
    case ExpectedLocalDataName;
    case ExpectedLocalDataColon;
    case ExpectedLocalDataType;
    case ExpectedLocalDataEnd;
    case ExpectedLocalDataInitialValue;
    case ExpectedCastType;
    case ExpectedCastDomain;
    case ExpectedCastEnd;
    case ExpectedMembershipDomain;
    case ExpectedMembershipEnd;
    case UnresolvedCallTarget;
    case CallArityMismatch;
    case UnresolvedStateTarget;
    case TransitionArityMismatch;
    case MissingStateTerminal;
    case UncoveredTransitionSubject;
    case ArithmeticResultOutOfRange;
    case ArithmeticOperandOutOfDomain;
}

// The scalar-resource table: one Incomplete code per named private
// provision, with the same names, limits and coordinate rules in every
// implementation.
pub data Provision [copy] {
    case RequestSubjectBytes;
    case RequestInvocationBytes;
    case ParserRoots;
    case ParserStates;
    case ParserPathMembers;
    case ParserDataMembers;
    case ParserTypeNodes;
    case ParserTypeDepth;
    case ParserExpressionDepth;
    case ParserStatements;
    case ParserExpressions;
    case TapePayloadBytes;
    case TapeFixups;
    case TapeLabels;
    case CoverageSourceForms;
    case CoverageNonMachineRoots;
    case CoverageMachineHeaders;
    case CoverageEntrySignatures;
    case CoverageStateSignatures;
    case CoverageStatementForms;
    case CoverageCallForms;
    case CoverageExpressionForms;
    case CoverageTransitionForms;
    case CoverageEmptySubject;
    case CoverageRequestSemantics;
    case RequestStagingBytes;
    case ProofSearchRosterRounds;
    case ProofSearchCandidateWork;
    case ProofSearchCyclicGuaranteeWork;
    case ProofSearchResultGuaranteeWork;
    case ProofSearchDivisorDefinitionVisits;
    case ProofSearchDivisorSearchDepth;
    case ProofSearchDivisorComputedJoins;
    case ProofObligationIdentities;
    case ProofSearchIntegerCertificateWork;
}

// One outcome as recorded before publication. Quantities are exact here and
// normalized to `min(quantity, INT32_MAX)` only when the frame is written.
pub data Outcome [copy] {
    tag: OutcomeTag;
    space: CoordinateSpace;
    code: u64 in Trapping;
    coordinate: u64 in Trapping;
    limit: u64 in Trapping;
    requested: u64 in Trapping;
    package: u64 in Trapping;
    source_unit: u64 in Trapping;
}

// `malformed_request` anchored at a request byte.
pub machine Outcome::malformed_request(offset: u64 in Trapping) -> Outcome {
    let code: u64 in Trapping = RejectCode::number(RejectCode::MalformedRequest);
    Outcome {
        tag: OutcomeTag::Reject,
        space: CoordinateSpace::Request,
        code: code,
        coordinate: offset,
        limit: 0,
        requested: 0,
        package: 0,
        source_unit: 0
    }
}

// An Incomplete provision with its coordinate and requested amount, in the
// provision's own coordinate space.
pub machine Outcome::incomplete(provision: Provision, coordinate: u64 in Trapping, requested: u64 in Trapping) -> Outcome {
    let space: CoordinateSpace = Provision::space(provision);
    let code: u64 in Trapping = Provision::number(provision);
    let limit: u64 in Trapping = Provision::limit(provision);
    Outcome {
        tag: OutcomeTag::Incomplete,
        space: space,
        code: code,
        coordinate: coordinate,
        limit: limit,
        requested: requested,
        package: 0,
        source_unit: 0
    }
}

// A well-formed request whose semantic phases this compiler does not
// implement yet: the provision covers the whole request, so it carries no
// coordinate and no requested amount.
pub machine Outcome::coverage_request_semantics() -> Outcome {
    Outcome::incomplete(Provision::CoverageRequestSemantics, 0, 0)
}

pub machine RejectCode::number(code: RejectCode) -> u64 in Trapping {
    transition code {
        RejectCode::MalformedRequest -> value(1)
        RejectCode::InvalidUtf8 -> value(2)
        RejectCode::OutsideLexicalProfile -> value(3)
        RejectCode::UnterminatedBlockComment -> value(4)
        RejectCode::UnterminatedStringLiteral -> value(5)
        RejectCode::UnterminatedStringEscape -> value(6)
        RejectCode::UnsupportedEscape -> value(7)
        RejectCode::UnterminatedHexEscape -> value(8)
        RejectCode::InvalidHexEscapeDigit -> value(9)
        RejectCode::DuplicateName -> value(10)
        RejectCode::MissingEntry -> value(11)
        RejectCode::IntegerLiteralOutOfRange -> value(12)
        RejectCode::ExpectedPathMember -> value(13)
        RejectCode::ExpectedPathSeparatorOrSemicolon -> value(14)
        RejectCode::ExpectedDataName -> value(15)
        RejectCode::ExpectedDataBody -> value(16)
        RejectCode::ExpectedDataProperty -> value(17)
        RejectCode::ExpectedDataPropertyEnd -> value(18)
        RejectCode::ExpectedDataMemberOrEnd -> value(19)
        RejectCode::ExpectedDataCaseName -> value(20)
        RejectCode::ExpectedDataCaseEnd -> value(21)
        RejectCode::ExpectedDataPayloadFieldOrEnd -> value(22)
        RejectCode::ExpectedDataFieldColon -> value(23)
        RejectCode::ExpectedDataFieldType -> value(24)
        RejectCode::ExpectedDataFieldEnd -> value(25)
        RejectCode::ExpectedTypeDomain -> value(26)
        RejectCode::ExpectedTypeRangeOperator -> value(27)
        RejectCode::ExpectedTypeRangeBound -> value(28)
        RejectCode::ExpectedTypeRangeEnd -> value(29)
        RejectCode::ExpectedArrayElementType -> value(30)
        RejectCode::ExpectedArraySeparatorOrEnd -> value(31)
        RejectCode::ExpectedArrayLength -> value(32)
        RejectCode::ExpectedArrayEnd -> value(33)
        RejectCode::ExpectedReferenceLifetime -> value(34)
        RejectCode::ExpectedUnitTypeEnd -> value(35)
        RejectCode::ExpectedMachineParameterOrEnd -> value(36)
        RejectCode::ExpectedMachineParameter -> value(37)
        RejectCode::ExpectedMachineParameterColon -> value(38)
        RejectCode::ExpectedMachineParameterType -> value(39)
        RejectCode::ExpectedMachineParameterEnd -> value(40)
        RejectCode::ExpectedMachineReturnType -> value(41)
        RejectCode::ExpectedMachineReturnEnd -> value(42)
        RejectCode::ExpectedMachineBody -> value(43)
        RejectCode::ExpectedMachineBodyEnd -> value(44)
        RejectCode::ExpectedExpressionPathMember -> value(45)
        RejectCode::ExpectedCallPathTail -> value(46)
        RejectCode::ExpectedCallArgument -> value(47)
        RejectCode::ExpectedCallArgumentEnd -> value(48)
        RejectCode::ExpectedCallSemicolon -> value(49)
        RejectCode::ExpectedAssignmentValue -> value(50)
        RejectCode::ExpectedAssignmentSemicolon -> value(51)
        RejectCode::ExpectedStaticArgument -> value(52)
        RejectCode::ExpectedStaticArgumentEnd -> value(53)
        RejectCode::ExpectedStaticCallOpen -> value(54)
        RejectCode::ExpectedStructLiteralFieldOrEnd -> value(55)
        RejectCode::ExpectedStructLiteralFieldColon -> value(56)
        RejectCode::ExpectedStructLiteralValue -> value(57)
        RejectCode::ExpectedStructLiteralFieldEnd -> value(58)
        RejectCode::ExpectedStateName -> value(59)
        RejectCode::ExpectedStateBody -> value(60)
        RejectCode::ExpectedTransitionSubject -> value(61)
        RejectCode::ExpectedTransitionArm -> value(62)
        RejectCode::ExpectedTransitionArrow -> value(63)
        RejectCode::ExpectedTransitionTarget -> value(64)
        RejectCode::ExpectedTransitionTargetOpen -> value(65)
        RejectCode::ExpectedTransitionTargetClose -> value(66)
        RejectCode::ExpectedSatisfiesTrait -> value(67)
        RejectCode::ExpectedSatisfiesRequirement -> value(68)
        RejectCode::ExpectedExternalBinding -> value(69)
        RejectCode::ExpectedExternalLeafEnd -> value(70)
        RejectCode::ExpectedReachService -> value(71)
        RejectCode::ExpectedTerminationBy -> value(72)
        RejectCode::ExpectedTerminationSubject -> value(73)
        RejectCode::ExpectedTerminationArrow -> value(74)
        RejectCode::ExpectedTerminationView -> value(75)
        RejectCode::ExpectedTerminationEnd -> value(76)
        RejectCode::ExpectedIndexedIndex -> value(77)
        RejectCode::ExpectedIndexedRangeEnd -> value(78)
        RejectCode::ExpectedIndexedTail -> value(79)
        RejectCode::ExpectedLocalDataName -> value(80)
