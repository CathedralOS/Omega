    transition provision {
        Provision::RequestSubjectBytes -> value(1)
        Provision::RequestInvocationBytes -> value(2)
        Provision::ParserRoots -> value(3)
        Provision::ParserStates -> value(4)
        Provision::ParserPathMembers -> value(5)
        Provision::ParserDataMembers -> value(6)
        Provision::ParserTypeNodes -> value(7)
        Provision::ParserTypeDepth -> value(8)
        Provision::ParserExpressionDepth -> value(9)
        Provision::ParserStatements -> value(10)
        Provision::ParserExpressions -> value(11)
        Provision::TapePayloadBytes -> value(12)
        Provision::TapeFixups -> value(13)
        Provision::TapeLabels -> value(14)
        Provision::CoverageSourceForms -> value(15)
        Provision::CoverageNonMachineRoots -> value(16)
        Provision::CoverageMachineHeaders -> value(17)
        Provision::CoverageEntrySignatures -> value(18)
        Provision::CoverageStateSignatures -> value(19)
        Provision::CoverageStatementForms -> value(20)
        Provision::CoverageCallForms -> value(21)
        Provision::CoverageExpressionForms -> value(22)
        Provision::CoverageTransitionForms -> value(23)
        Provision::CoverageEmptySubject -> value(24)
        Provision::CoverageRequestSemantics -> value(25)
        Provision::RequestStagingBytes -> value(26)
