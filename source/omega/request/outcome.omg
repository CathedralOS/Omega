pub machine RejectCode::space(code: RejectCode) -> CoordinateSpace {
    transition code {
        RejectCode::MalformedRequest -> request()
        RejectCode::MissingEntry -> none()
        _ -> canonical_source()
    }

    state none() -> CoordinateSpace {
        CoordinateSpace::None
    }

    state request() -> CoordinateSpace {
        CoordinateSpace::Request
    }

    state canonical_source() -> CoordinateSpace {
        CoordinateSpace::CanonicalSource
    }
}

