use request::outcome;

// The sealed OCREQ V1 request (wiki/spec/build/compiler_request.md), staged
// from stdin before any of it is interpreted. Staging is a private
// provision: a request longer than its 65,536 bytes is the
// `request_staging_bytes` Incomplete outcome, anchored at the first byte
// that could not be staged and reporting the full observed length, so the
// entry keeps counting after the buffer fills.
pub data Request
where
    length <= 65536,
{
    bytes: [u8; 65536] in Trapping;
    length: u64;
    observed: u64 in Trapping;
}

pub machine Request::clear(request: &mut Request) {
    request.length = 0;
    request.observed = 0;
}

// Stage one more stdin byte, or only count it past a full buffer.
pub machine Request::stage(request: &mut Request, byte: u8)
crashes Trap
{
    request.observed = request.observed + 1;
    transition request.length < 65536 {
        true -> store(request, byte)
        _ -> counted()
    }

    state store(request: &mut Request, byte: u8) {
        request.bytes[request.length] = byte as u8 in Trapping;
        request.length = request.length + 1;
    }

    state counted() {}
}

// How many bytes were staged.
machine Request::staged(request: &Request) -> u64 in Trapping {
    request.length as u64 in Trapping
}

// The request byte at `offset`; callers have bounded it by `length`.
machine Request::byte(request: &Request, offset: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition offset < request.length {
        true -> read(request, offset)
        _ -> invalid()
    }

    // The staged length's range does not transport through the comparison,
    // so the array bound is restated before the read.
    state read(request: &Request, offset: u64 in Trapping) -> u64 in Trapping {
        transition offset < 65536 {
            true -> element(request, offset)
            _ -> invalid()
        }
    }

    state element(request: &Request, offset: u64 in Trapping) -> u64 in Trapping {
        request.bytes[offset] as u64 in Trapping
    }

    state invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// The little-endian `u32` at `offset`; callers have bounded `offset + 4`.
machine Request::u32_at(request: &Request, offset: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let b0: u64 in Trapping = Request::byte(request, offset);
    let b1: u64 in Trapping = Request::byte(request, offset + 1);
    let b2: u64 in Trapping = Request::byte(request, offset + 2);
    let b3: u64 in Trapping = Request::byte(request, offset + 3);
    b0 + b1 * 256 + b2 * 65536 + b3 * 16777216
}

// The OCREQ identity `4F 43 52 45 51 01 00 00` by position.
machine Request::identity_byte(index: u64 in Trapping) -> u64 in Trapping {
    transition index {
        0 -> byte(79)
        1 -> byte(67)
        2 -> byte(82)
        3 -> byte(69)
        4 -> byte(81)
        5 -> byte(1)
        _ -> byte(0)
    }

    state byte(value: u64 in Trapping) -> u64 in Trapping {
        value
    }
}

// The two sections the envelope frames, as request offsets.
pub data Sections [copy] {
    subject_start: u64 in Trapping;
    subject_end: u64 in Trapping;
    invocation_start: u64 in Trapping;
    invocation_end: u64 in Trapping;
}

machine Sections::none() -> Sections {
    Sections { subject_start: 0, subject_end: 0, invocation_start: 0, invocation_end: 0 }
}

// What a request phase concludes: it continues into `sections`, or it
// publishes `outcome`.
pub data Verdict [copy] {
    complete: bool;
    sections: Sections;
    outcome: Outcome;
}

machine Verdict::refuse(outcome: Outcome) -> Verdict {
    let sections: Sections = Sections::none();
    Verdict { complete: false, sections: sections, outcome: outcome }
}

// Phases 0 and 1 over a staged request: the eight identity bytes, the two
// section lengths with their high bits clear, extents compared
// subtractively against what remains, and the exact end; then the declared
// subject and invocation extents against their provisions. A refusal names
// `malformed_request` at the first missing, incorrect or trailing byte; a
// stream shorter than a fixed field is missing its byte at the stream end.
// A request the staging provision could not hold is refused first, at the
// first byte that could not be staged.
pub machine Request::envelope(request: &Request) -> Verdict
crashes Trap
{
    let length: u64 in Trapping = Request::staged(request);
    transition request.observed > length {
        true -> incomplete(Provision::RequestStagingBytes, 65536, request.observed)
        _ -> framing(request, length)
    }

    state framing(request: &Request, length: u64 in Trapping) -> Verdict {
        transition length >= 8 {
            true -> identity(request, length, 0)
            _ -> malformed(length)
        }
    }

    state identity(request: &Request, length: u64 in Trapping, index: u64 in Trapping) -> Verdict {
        let byte: u64 in Trapping = Request::byte(request, index);
        let expected: u64 in Trapping = Request::identity_byte(index);
        transition byte == expected {
            true -> identity_next(request, length, index)
            _ -> malformed(index)
        }
    }

    state identity_next(request: &Request, length: u64 in Trapping, index: u64 in Trapping) -> Verdict {
        transition index < 7 {
            true -> identity(request, length, index + 1)
            _ -> header(request, length)
        }
    }

    state header(request: &Request, length: u64 in Trapping) -> Verdict {
        transition length >= 16 {
            true -> subject_high_bit(request, length)
            _ -> malformed(length)
        }
    }

    state subject_high_bit(request: &Request, length: u64 in Trapping) -> Verdict {
        let high: u64 in Trapping = Request::byte(request, 11);
        transition high < 128 {
            true -> invocation_high_bit(request, length)
            _ -> malformed(8)
        }
    }

    state invocation_high_bit(request: &Request, length: u64 in Trapping) -> Verdict {
        let high: u64 in Trapping = Request::byte(request, 15);
        transition high < 128 {
            true -> lengths(request, length)
            _ -> malformed(12)
        }
    }

    state lengths(request: &Request, length: u64 in Trapping) -> Verdict {
        let subject_length: u64 in Trapping = Request::u32_at(request, 8);
        let invocation_length: u64 in Trapping = Request::u32_at(request, 12);
        transition subject_length <= length - 16 {
            true -> subject(length, 16 + subject_length, invocation_length)
            _ -> malformed(8)
        }
    }

    state subject(length: u64 in Trapping, subject_end: u64 in Trapping, invocation_length: u64 in Trapping) -> Verdict {
        transition invocation_length <= length - subject_end {
            true -> exact_end(length, subject_end, subject_end + invocation_length)
            _ -> malformed(12)
        }
    }

    state exact_end(length: u64 in Trapping, subject_end: u64 in Trapping, invocation_end: u64 in Trapping) -> Verdict {
        transition invocation_end == length {
            true -> subject_extent(subject_end, invocation_end)
            _ -> malformed(invocation_end)
        }
    }

    // Phase 1: the declared extents against their provisions.
    state subject_extent(subject_end: u64 in Trapping, invocation_end: u64 in Trapping) -> Verdict {
        transition subject_end - 16 <= 67108864 {
            true -> invocation_extent(subject_end, invocation_end)
            _ -> incomplete(Provision::RequestSubjectBytes, 8, subject_end - 16)
        }
    }

    state invocation_extent(subject_end: u64 in Trapping, invocation_end: u64 in Trapping) -> Verdict {
        transition invocation_end - subject_end <= 1048576 {
            true -> framed(subject_end, invocation_end)
            _ -> incomplete(Provision::RequestInvocationBytes, 12, invocation_end - subject_end)
        }
    }

    state framed(subject_end: u64 in Trapping, invocation_end: u64 in Trapping) -> Verdict {
        let sections: Sections = Sections {
            subject_start: 16,
            subject_end: subject_end,
            invocation_start: subject_end,
            invocation_end: invocation_end
        };
        let outcome: Outcome = Outcome::coverage_request_semantics();
        Verdict { complete: true, sections: sections, outcome: outcome }
    }

    state malformed(offset: u64 in Trapping) -> Verdict {
        let outcome: Outcome = Outcome::malformed_request(offset);
        Verdict::refuse(outcome)
    }

    state incomplete(provision: Provision, coordinate: u64 in Trapping, requested: u64 in Trapping) -> Verdict {
        let outcome: Outcome = Outcome::incomplete(provision, coordinate, requested);
        Verdict::refuse(outcome)
    }
}

// A cursor over one section for the field/tag structure pass. Every read is
// compared subtractively against the section end, a `u32` with its high bit
// set refuses at its first byte, and a declared count must fit the
// remaining extent at its row's minimum width before any row is read, so a
// hostile count cannot stretch the walk. The first failure records where
// `malformed_request` anchors: a missing byte at the section end, an invalid
// value at its field, trailing bytes at the first one. Reads after a
// failure take nothing and return zero.
pub data SectionReader {
    cursor: u64 in Trapping;
    end: u64 in Trapping;
    failed: bool;
    failure: u64 in Trapping;
}

machine SectionReader::open(reader: &mut SectionReader, start: u64 in Trapping, end: u64 in Trapping) {
    transition start <= end {
        true -> framed(reader, start, end)
        _ -> empty(reader, end)
    }

    state framed(reader: &mut SectionReader, start: u64 in Trapping, end: u64 in Trapping) {
        reader.end = end;
        reader.cursor = start;
        reader.failed = false;
        reader.failure = 0;
    }

    state empty(reader: &mut SectionReader, end: u64 in Trapping) {
        reader.end = end;
        reader.cursor = end;
        reader.failed = true;
        reader.failure = end;
    }
}

// The bytes left before the section end.
machine SectionReader::remaining(reader: &SectionReader) -> u64 in Trapping {
    reader.end - reader.cursor
}

machine SectionReader::fail(reader: &mut SectionReader, offset: u64 in Trapping) {
    transition reader.failed {
        true -> kept()
        _ -> record(reader, offset)
    }

    state record(reader: &mut SectionReader, offset: u64 in Trapping) {
        reader.failed = true;
        reader.failure = offset;
    }

    state kept() {}
}

// Move past `width` bytes the caller has bounded by `remaining`.
machine SectionReader::advance(reader: &mut SectionReader, width: u64 in Trapping) {
    transition width <= reader.end - reader.cursor {
        true -> past(reader, width)
        _ -> missing(reader)
    }

    state past(reader: &mut SectionReader, width: u64 in Trapping) {
        reader.cursor = reader.cursor + width;
    }

    state missing(reader: &mut SectionReader) {
        let end: u64 in Trapping = reader.end;
        SectionReader::fail(reader, end);
    }
}

// A little-endian `u32` whose high bit is clear.
machine SectionReader::take_u32(reader: &mut SectionReader, request: &Request) -> u64 in Trapping
crashes Trap
{
    let remaining: u64 in Trapping = SectionReader::remaining(reader);
    transition reader.failed || remaining < 4 {
        true -> missing(reader)
        _ -> high_bit(reader, request)
    }

    state missing(reader: &mut SectionReader) -> u64 in Trapping {
        let end: u64 in Trapping = reader.end;
        SectionReader::fail(reader, end);
        0
    }

    state high_bit(reader: &mut SectionReader, request: &Request) -> u64 in Trapping {
        let high: u64 in Trapping = Request::byte(request, reader.cursor + 3);
        transition high < 128 {
            true -> value(reader, request)
            _ -> refused(reader)
        }
    }

    state refused(reader: &mut SectionReader) -> u64 in Trapping {
        let field: u64 in Trapping = reader.cursor;
        SectionReader::fail(reader, field);
        0
    }

    state value(reader: &mut SectionReader, request: &Request) -> u64 in Trapping {
        let value: u64 in Trapping = Request::u32_at(request, reader.cursor);
        SectionReader::advance(reader, 4);
        value
    }
}

// A table count that must fit the remaining extent at `minimum_row` bytes a
// row; an impossible count is malformed at its count field.
machine SectionReader::take_count(reader: &mut SectionReader, request: &Request, minimum_row: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let count: u64 in Trapping = SectionReader::take_u32(reader, request);
    let remaining: u64 in Trapping = SectionReader::remaining(reader);
    transition reader.failed || count <= remaining / minimum_row {
        true -> fits(count)
        _ -> impossible(reader)
    }

    state fits(count: u64 in Trapping) -> u64 in Trapping {
        count
    }

    state impossible(reader: &mut SectionReader) -> u64 in Trapping {
        let field: u64 in Trapping = reader.cursor - 4;
        SectionReader::fail(reader, field);
        0
    }
}

// A `u32` tag that must lie in `low..=high`; an empty range refuses every
// value.
machine SectionReader::take_tag(reader: &mut SectionReader, request: &Request, low: u64 in Trapping, high: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let tag: u64 in Trapping = SectionReader::take_u32(reader, request);
    transition reader.failed || tag >= low && tag <= high {
        true -> member(tag)
        _ -> refused(reader)
    }

    state member(tag: u64 in Trapping) -> u64 in Trapping {
        tag
    }

    state refused(reader: &mut SectionReader) -> u64 in Trapping {
        let field: u64 in Trapping = reader.cursor - 4;
        SectionReader::fail(reader, field);
        0
    }
}

// A length-framed byte field: its content's first offset, with the cursor
// moved past it.
machine SectionReader::take_bytes(reader: &mut SectionReader, request: &Request) -> u64 in Trapping
crashes Trap
{
    let length: u64 in Trapping = SectionReader::take_u32(reader, request);
    let start: u64 in Trapping = reader.cursor;
    SectionReader::advance(reader, length);
    start
}

// Bytes left in the section are malformed at the first one.
machine SectionReader::finish(reader: &mut SectionReader) {
    transition reader.failed || reader.cursor == reader.end {
        true -> done()
        _ -> trailing(reader)
    }

    state trailing(reader: &mut SectionReader) {
        let cursor: u64 in Trapping = reader.cursor;
        SectionReader::fail(reader, cursor);
    }

    state done() {}
}

// Phases 2 and 6: the subject's and the invocation's field/tag shape, read
// positionally in the contract's table order. Reads are fail-sticky, so a
// table whose count failed reads no rows. A request that survives is
// well formed, but its semantic phases (package keys, ordering, graph,
// snapshots, admissions, commitment) are not implemented yet, so it
// publishes the `coverage_request_semantics` provision rather than a
// verdict it cannot defend.
pub machine Request::structure(request: &Request, sections: Sections) -> Outcome
crashes Trap
{
    let mut reader: SectionReader;
    SectionReader::open(&mut reader, sections.subject_start, sections.subject_end);
    // A package row is at least its eight framing words and snapshot count.
    let packages: u64 in Trapping = SectionReader::take_count(&mut reader, request, 36);
    transition { _ -> package(request, sections, &mut reader, packages, 0) }

    state package(request: &Request, sections: Sections, reader: &mut SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> Outcome {
        transition index < count && !reader.failed {
            true -> package_fields(request, sections, reader, count, index)
            _ -> edges(request, sections, reader)
        }
    }

    state package_fields(request: &Request, sections: Sections, reader: &mut SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> Outcome {
        let name: u64 in Trapping = SectionReader::take_bytes(reader, request);
        let lineage_kind: u64 in Trapping = SectionReader::take_tag(reader, request, 1, 2);
        let lineage: u64 in Trapping = SectionReader::take_bytes(reader, request);
        let revision: u64 in Trapping = SectionReader::take_bytes(reader, request);
        let tree: u64 in Trapping = SectionReader::take_bytes(reader, request);
        let content: u64 in Trapping = SectionReader::take_bytes(reader, request);
        let member: u64 in Trapping = SectionReader::take_bytes(reader, request);
        let role: u64 in Trapping = SectionReader::take_tag(reader, request, 1, 2);
        // A snapshot row is at least its kind and path length.
        let rows: u64 in Trapping = SectionReader::take_count(reader, request, 8);
        transition { _ -> snapshot(request, sections, reader, count, index, rows, 0) }
    }

    state snapshot(
        request: &Request,
        sections: Sections,
        reader: &mut SectionReader,
        count: u64 in Trapping,
        index: u64 in Trapping,
        rows: u64 in Trapping,
        row: u64 in Trapping
    ) -> Outcome {
        transition row < rows && !reader.failed {
            true -> snapshot_row(request, sections, reader, count, index, rows, row)
            _ -> package(request, sections, reader, count, index + 1)
        }
    }

    // Kind 1 is a directory with no payload, 2 a regular file with its
    // executable tag and content, 3 a symbolic link with its target.
    state snapshot_row(
        request: &Request,
        sections: Sections,
        reader: &mut SectionReader,
        count: u64 in Trapping,
        index: u64 in Trapping,
        rows: u64 in Trapping,
        row: u64 in Trapping
    ) -> Outcome {
        let kind: u64 in Trapping = SectionReader::take_tag(reader, request, 1, 3);
        let path: u64 in Trapping = SectionReader::take_bytes(reader, request);
        transition kind {
            2 -> regular_file(request, sections, reader, count, index, rows, row)
            3 -> link(request, sections, reader, count, index, rows, row)
            _ -> snapshot(request, sections, reader, count, index, rows, row + 1)
        }
    }

    state regular_file(
        request: &Request,
        sections: Sections,
        reader: &mut SectionReader,
        count: u64 in Trapping,
        index: u64 in Trapping,
        rows: u64 in Trapping,
        row: u64 in Trapping
    ) -> Outcome {
        let executable: u64 in Trapping = SectionReader::take_tag(reader, request, 0, 1);
        let content: u64 in Trapping = SectionReader::take_bytes(reader, request);
        transition { _ -> snapshot(request, sections, reader, count, index, rows, row + 1) }
    }

    state link(
        request: &Request,
        sections: Sections,
        reader: &mut SectionReader,
        count: u64 in Trapping,
        index: u64 in Trapping,
        rows: u64 in Trapping,
        row: u64 in Trapping
    ) -> Outcome {
        let target: u64 in Trapping = SectionReader::take_bytes(reader, request);
        transition { _ -> snapshot(request, sections, reader, count, index, rows, row + 1) }
    }

    // An edge row is four words: requester, scope, alias length, target.
    state edges(request: &Request, sections: Sections, reader: &mut SectionReader) -> Outcome {
        let count: u64 in Trapping = SectionReader::take_count(reader, request, 16);
        transition { _ -> edge(request, sections, reader, count, 0) }
    }

    state edge(request: &Request, sections: Sections, reader: &mut SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> Outcome {
        transition index < count && !reader.failed {
            true -> edge_fields(request, sections, reader, count, index)
            _ -> root(request, sections, reader)
        }
    }

    state edge_fields(request: &Request, sections: Sections, reader: &mut SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> Outcome {
        let requester: u64 in Trapping = SectionReader::take_u32(reader, request);
        let scope: u64 in Trapping = SectionReader::take_tag(reader, request, 1, 2);
        let alias: u64 in Trapping = SectionReader::take_bytes(reader, request);
        let target: u64 in Trapping = SectionReader::take_u32(reader, request);
        transition { _ -> edge(request, sections, reader, count, index + 1) }
    }

    state root(request: &Request, sections: Sections, reader: &mut SectionReader) -> Outcome {
        let package: u64 in Trapping = SectionReader::take_u32(reader, request);
        let role: u64 in Trapping = SectionReader::take_tag(reader, request, 1, 2);
        SectionReader::finish(reader);
        transition reader.failed {
            true -> malformed(reader.failure)
            _ -> invocation(request, sections, reader)
        }
    }

    // The invocation: product, target profile, admissions (no admission kind
    // is assigned, so any present row refuses), and the 32-byte commitment.
    state invocation(request: &Request, sections: Sections, reader: &mut SectionReader) -> Outcome {
        SectionReader::open(reader, sections.invocation_start, sections.invocation_end);
        let product: u64 in Trapping = SectionReader::take_tag(reader, request, 1, 4);
        let target_profile: u64 in Trapping = SectionReader::take_bytes(reader, request);
        // An admission row is at least its kind and data length.
        let admissions: u64 in Trapping = SectionReader::take_count(reader, request, 8);
        transition { _ -> admission(request, reader, admissions, 0) }
    }

    state admission(request: &Request, reader: &mut SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> Outcome {
        transition index < count && !reader.failed {
            true -> admission_fields(request, reader, count, index)
            _ -> commitment(reader)
        }
    }

    state admission_fields(request: &Request, reader: &mut SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> Outcome {
        let kind: u64 in Trapping = SectionReader::take_tag(reader, request, 1, 0);
        let data: u64 in Trapping = SectionReader::take_bytes(reader, request);
        transition { _ -> admission(request, reader, count, index + 1) }
    }

    state commitment(reader: &mut SectionReader) -> Outcome {
        SectionReader::advance(reader, 32);
        SectionReader::finish(reader);
        transition reader.failed {
            true -> malformed(reader.failure)
            _ -> semantics()
        }
    }

    state malformed(offset: u64 in Trapping) -> Outcome {
        Outcome::malformed_request(offset)
    }

    state semantics() -> Outcome {
        Outcome::coverage_request_semantics()
    }
}
