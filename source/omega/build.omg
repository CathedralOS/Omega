// The invocation supplies one exact target; these are root bindings rather
// than a source-declared support set.

machine build(builder: &mut Build) {
    Build::application(builder, "omega_compiler");
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
    Build::bind(builder, alpha_bootstrap::ProgramEntry, Main::main);
    Build::depend_as(builder, "psi", Source::Path {
        location: "../psi"
    });
    Build::depend(builder, Source::Path {
        location: "../library/std"
    });
}
