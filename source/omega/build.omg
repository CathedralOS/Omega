// The invocation supplies one exact target; these are root bindings rather
// than a source-declared support set.

machine build(builder: &mut Build) {
    Build::application(builder, "omega_compiler");
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder, linux_arm64);
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder, linux_x86_64);
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder, macos_arm64);
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder, macos_x86_64);
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder, windows_x86_64);
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder, uefi_x86_64);
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder, cross_platform_cli);
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder, local_unchecked);
    Build::select_provider<omega_language_std::Console, omega_language_std::NativeConsole>(builder, alpha_bootstrap);
    Build::bind(builder, windows_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, entry_start);
    Build::bind(builder, alpha_bootstrap::ProgramEntry, entry_start);
    let mut psi_dependency: DependencyDescription = dependency::from_source(Source::Path {
        location: "../psi"
    });
    dependency::with_alias(&mut psi_dependency, "psi");
    let psi_registration: DependencyRegistration = Build::dependency(builder, psi_dependency);
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency::from_source(Source::Path {
        location: "../library/std"
    }));
}
