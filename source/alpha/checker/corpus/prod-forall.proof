; prod-forall.proof — the MULTIPLICATIVE fold ∀-input theorem (factorial-style products over a list). Where
; sum-forall's fold ADDS the element, this MULTIPLIES by it:  prodfold(Cons h t, n) = prodfold(t, h*n).
; Proving it universal needs the user nat to be a commutative SEMIRING under uadd and umul — now supplied by the
; shared lib/nat-semiring.proof (add0r / mulassoc / mulcomm etc. auto-wrap this proof).
;
;     forall xs n.  prodfold(xs, n)  =  listprod(xs) * n
;
; All user nats (k2/k3) and user lists (k60/k61). uadd = fun 21, umul = fun 22, listprod = fun 98 (from the lib).
(include lib/nat-semiring.proof)

(fun 98 60 (k 3 (k 2))) (fun 98 61 (f 22 (v 0) (rec 1)))  ; listprod(Nil)=1 ; listprod(Cons h t)=h*listprod(t)
(fun 99 60 (y 0)) (fun 99 61 (recx 1 (f 22 (v 0) (y 0)))) ; prodfold(Nil,n)=n ; (Cons h t,n)=prodfold(t, h*n)

(all xs (all n (= (f 99 xs n) (f 22 (f 98 xs) n))))
; --- the multiplicative fold theorem, by induction on xs (cites the included semiring lemmas by name) ---
(rec 60 61 xs (all n (= (f 99 xs n) (f 22 (f 98 xs) n))) (gen n (eqelim x (= x (f 22 (f 98 (k 60)) n)) (inst add0r n) (refl (f 22 (f 98 (k 60)) n)))) (gen h (gen t (lam ih (all n (= (f 99 t n) (f 22 (f 98 t) n))) (gen n (have s1 (= (f 22 (f 98 t) (f 22 h n)) (f 22 (f 22 (f 98 t) h) n)) (eqelim x (= x (f 22 (f 22 (f 98 t) h) n)) (inst* mulassoc (f 98 t) h n) (refl (f 22 (f 22 (f 98 t) h) n))) (have s2 (= (f 22 (f 22 (f 98 t) h) n) (f 22 (f 22 h (f 98 t)) n)) (eqelim x (= (f 22 (f 22 (f 98 t) h) n) (f 22 x n)) (inst* mulcomm (f 98 t) h) (refl (f 22 (f 22 (f 98 t) h) n))) (have bridge (= (f 22 (f 98 t) (f 22 h n)) (f 22 (f 22 h (f 98 t)) n)) (eqelim x (= (f 22 (f 98 t) (f 22 h n)) x) s2 s1) (eqelim x (= (f 99 t (f 22 h n)) x) bridge (inst ih (f 22 h n)))))))))))
