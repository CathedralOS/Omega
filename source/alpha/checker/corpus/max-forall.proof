; max-forall.proof — the MAX-fold ∀-input theorem: the first ORDER-monoid fold in the suite (count/sum/pair/prod
; are additive/multiplicative; this is the idempotent JOIN of the ≤-lattice). Shape of slice_maximum's real loop
; `find_max(s[1..], max(current, s[0]))`:  maxfold(Cons h t, acc) = maxfold(t, max(acc, h)).  Proving it universal
; needs `max` an associative monoid with identity 0 (acc-first, so no commutativity):
;
;     ∀xs ∀acc.  maxfold(xs, acc)  =  max(acc, listmax(xs))
;
; max needs DUAL dispatch (compare both args), so it is defined by MUTUAL recursion max/maxhelp. All user nats
; (k2/k3, 0 is the bottom so listmax(Nil)=0) and user lists (k60/k61), matching the meaning route's USER_PRELUDE.
(data 2 0 0 0) (data 3 1 1 0) (data 60 0 0 0) (data 61 2 0 1)
(fun 23 2 (y 0)) (fun 23 3 (f 24 (y 0) (v 0)))          ; max(0,n)=n ; max(s m,n)=maxhelp(n,m)
(fun 24 2 (k 3 (y 0))) (fun 24 3 (k 3 (f 23 (y 0) (v 0)))) ; maxhelp(0,m)=s m ; maxhelp(s n,m)=s(max(m,n))
(fun 94 60 (k 2)) (fun 94 61 (f 23 (v 0) (rec 1)))      ; listmax(Nil)=0 ; listmax(Cons h t)=max(h, listmax t)
(fun 95 60 (y 0)) (fun 95 61 (recx 1 (f 23 (y 0) (v 0)))) ; maxfold(Nil,acc)=acc ; (Cons h t,acc)=maxfold(t,max(acc,h))

(all xs (all acc (= (f 95 xs acc) (f 23 acc (f 94 xs)))))

(have maxid (all a (= (f 23 a (k 2)) a))
  (rec 2 3 a (= (f 23 a (k 2)) a)
    (refl (k 2))
    (gen a1 (lam ih (= (f 23 a1 (k 2)) a1) (refl (k 3 a1)))))
(have maxassoc (all a (all b (all c (= (f 23 (f 23 a b) c) (f 23 a (f 23 b c))))))
  (rec 2 3 a (all b (all c (= (f 23 (f 23 a b) c) (f 23 a (f 23 b c)))))
    (gen b (gen c (refl (f 23 b c))))
    (gen a1 (lam iha (all b (all c (= (f 23 (f 23 a1 b) c) (f 23 a1 (f 23 b c)))))
      (rec 2 3 b (all c (= (f 23 (f 23 (k 3 a1) b) c) (f 23 (k 3 a1) (f 23 b c))))
        (gen c (refl (f 23 (k 3 a1) c)))
        (gen b1 (lam ihb (all c (= (f 23 (f 23 (k 3 a1) b1) c) (f 23 (k 3 a1) (f 23 b1 c))))
          (rec 2 3 c (= (f 23 (f 23 (k 3 a1) (k 3 b1)) c) (f 23 (k 3 a1) (f 23 (k 3 b1) c)))
            (refl (k 3 (f 23 a1 b1)))
            (gen c1 (lam ihc (= (f 23 (f 23 (k 3 a1) (k 3 b1)) c1) (f 23 (k 3 a1) (f 23 (k 3 b1) c1)))
              (eqelim x (= (k 3 (f 23 (f 23 a1 b1) c1)) (k 3 x)) (inst* iha b1 c1) (refl (k 3 (f 23 (f 23 a1 b1) c1)))))))))))))
(rec 60 61 xs (all acc (= (f 95 xs acc) (f 23 acc (f 94 xs))))
  (gen acc (eqelim x (= x (f 23 acc (k 2))) (inst maxid acc) (refl (f 23 acc (k 2)))))
  (gen h (gen t (lam ih (all acc (= (f 95 t acc) (f 23 acc (f 94 t))))
    (gen acc
      (eqelim x (= (f 95 t (f 23 acc h)) x) (inst* maxassoc acc h (f 94 t)) (inst ih (f 23 acc h))))))))))
