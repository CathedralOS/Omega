; the successor of an odd number is even -- completes "parity alternates with successor".
; If n = s(k+k) then s n = s(s(k+k)) = (s k)+(s k): the witness is (s k). add-succ-right gives
; (s k)+(s k) = s((s k)+k), and the primitive +'s LEFT reduction collapses (s k)+k = s(k+k); a
; cong-s on n=s(k+k) and an eqelim splice finish it. With succ-of-even-is-odd, even and odd strictly
; interleave along the successors of 0.
(def 0 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(all x1 (-> (ex x2 (= x1 (s (+ x2 x2)))) (ex x3 (= (s x1) (+ x3 x3)))))
(gen x1 (lam h2 (ex x3 (= x1 (s (+ x3 x3)))) (unpack h2 (gen x4 (lam h5 (= x1 (s (+ x4 x4))) (wit x6 (= (s x1) (+ x6 x6)) (s x4) (eqelim x7 (= (s x1) x7) (eqelim x8 (= x8 (+ (s x4) (s x4))) (inst (inst (use 0) (s x4)) x4) (refl (+ (s x4) (s x4)))) (eqelim x9 (= (s x1) (s x9)) h5 (refl (s x1))))))))))
