; le-add-mono.proof — ADD-MONOTONICITY of the decidable order:  forall a b c.  a<=b  ->  a+c <= b+c
; (x<=y is le(x,y)=True). The reusable congruence lemma behind every BOUNDED-ACCUMULATOR argument (e.g.
; proving a Trapping fold's accumulator stays in range). By induction on c: base uses add0r (a+0=a); the
; successor step rewrites a+(s c1) -> s(a+c1) via uaddsuc, then le(s _, s _) reduces to le(_,_) = the IH.
(data 2 0 0 0) (data 3 1 1 0)
(fun 25 2 (s z)) (fun 25 3 (f 26 (y 0) (v 0)))        ; le(0,n)=True ; le(s m,n)=lehelp(n,m)
(fun 26 2 z) (fun 26 3 (f 25 (y 0) (v 0)))            ; lehelp(0,m)=False ; lehelp(s n,m)=le(m,n)
(include lib/nat-monoid.proof)

(all a (all b (all c (-> (= (f 25 a b) (s z)) (= (f 25 (f 21 a c) (f 21 b c)) (s z))))))
(gen a (gen b (rec 2 3 c (-> (= (f 25 a b) (s z)) (= (f 25 (f 21 a c) (f 21 b c)) (s z)))
  (lam h (= (f 25 a b) (s z)) (eqelim x (= (f 25 x (f 21 b (k 2))) (s z)) (eqelim x (= x (f 21 a (k 2))) (inst add0r a) (refl (f 21 a (k 2)))) (eqelim x (= (f 25 a x) (s z)) (eqelim x (= x (f 21 b (k 2))) (inst add0r b) (refl (f 21 b (k 2)))) h)))
  (gen c1 (lam ih (-> (= (f 25 a b) (s z)) (= (f 25 (f 21 a c1) (f 21 b c1)) (s z))) (lam h (= (f 25 a b) (s z)) (eqelim x (= (f 25 (f 21 a (k 3 c1)) x) (s z)) (eqelim x (= x (f 21 b (k 3 c1))) (inst* uaddsuc b c1) (refl (f 21 b (k 3 c1)))) (eqelim x (= (f 25 x (k 3 (f 21 b c1))) (s z)) (eqelim x (= x (f 21 a (k 3 c1))) (inst* uaddsuc a c1) (refl (f 21 a (k 3 c1)))) (app ih h)))))))))
