; even(a) -> even(a^(S k)): an even base raised to any POSITIVE exponent is even.
; a^(S k) = a * a^k unfolds by conversion (power recurses on its constructor-headed exponent), and
; even-absorbs-mult (even a -> even(a*b)) closes it directly -- one lemma, no induction. With odd-power
; (odd a -> odd a^n) this completes the parity characterization of a^n by the parity of the base.
(data 2 0 0 0)
(data 3 1 1 0)
(fun 12 2 (s z))
(fun 12 3 (* (y 0) (rec 0)))
(def 0 (all x1 (all x2 (all x3 (= (+ (+ x1 x2) x3) (+ x1 (+ x2 x3)))))) (natind x4 (all x5 (all x6 (= (+ (+ x4 x5) x6) (+ x4 (+ x5 x6))))) (gen x7 (gen x8 (refl (+ x7 x8)))) (gen x9 (lam h10 (all x11 (all x12 (= (+ (+ x9 x11) x12) (+ x9 (+ x11 x12))))) (gen x13 (gen x14 (eqelim x15 (= (+ (+ (s x9) x13) x14) (s x15)) (inst (inst h10 x13) x14) (refl (+ (+ (s x9) x13) x14)))))))))
(def 1 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 2 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 3 (all x1 (all x2 (= (+ (s x1) x2) (s (+ x1 x2))))) (gen x3 (gen x4 (refl (+ (s x3) x4)))))
(def 4 (all x1 (all x2 (= (* (s x1) x2) (+ x2 (* x1 x2))))) (gen x3 (gen x4 (refl (* (s x3) x4)))))
(def 5 (all x1 (all x2 (all x3 (= (* (+ x1 x2) x3) (+ (* x1 x3) (* x2 x3)))))) (natind x4 (all x5 (all x6 (= (* (+ x4 x5) x6) (+ (* x4 x6) (* x5 x6))))) (gen x7 (gen x8 (refl (* x7 x8)))) (gen x9 (lam h10 (all x11 (all x12 (= (* (+ x9 x11) x12) (+ (* x9 x12) (* x11 x12))))) (gen x13 (gen x14 (app (app (inst (inst (inst (use 2) (* (+ (s x9) x13) x14)) (* (s (+ x9 x13)) x14)) (+ (* (s x9) x14) (* x13 x14))) (eqelim x15 (= (* (+ (s x9) x13) x14) (* x15 x14)) (inst (inst (use 3) x9) x13) (refl (* (+ (s x9) x13) x14)))) (app (app (inst (inst (inst (use 2) (* (s (+ x9 x13)) x14)) (+ x14 (* (+ x9 x13) x14))) (+ (* (s x9) x14) (* x13 x14))) (inst (inst (use 4) (+ x9 x13)) x14)) (app (app (inst (inst (inst (use 2) (+ x14 (* (+ x9 x13) x14))) (+ x14 (+ (* x9 x14) (* x13 x14)))) (+ (* (s x9) x14) (* x13 x14))) (eqelim x16 (= (+ x14 (* (+ x9 x13) x14)) (+ x14 x16)) (inst (inst h10 x13) x14) (refl (+ x14 (* (+ x9 x13) x14))))) (app (app (inst (inst (inst (use 2) (+ x14 (+ (* x9 x14) (* x13 x14)))) (+ (+ x14 (* x9 x14)) (* x13 x14))) (+ (* (s x9) x14) (* x13 x14))) (app (inst (inst (use 1) (+ (+ x14 (* x9 x14)) (* x13 x14))) (+ x14 (+ (* x9 x14) (* x13 x14)))) (inst (inst (inst (use 0) x14) (* x9 x14)) (* x13 x14)))) (eqelim x17 (= (+ (+ x14 (* x9 x14)) (* x13 x14)) (+ x17 (* x13 x14))) (app (inst (inst (use 1) (* (s x9) x14)) (+ x14 (* x9 x14))) (inst (inst (use 4) x9) x14)) (refl (+ (+ x14 (* x9 x14)) (* x13 x14))))))))))))))
(def 6 (all x1 (all x2 (-> (ex x3 (= x1 (+ x3 x3))) (ex x4 (= (* x1 x2) (+ x4 x4)))))) (gen x5 (gen x6 (lam h7 (ex x8 (= x5 (+ x8 x8))) (unpack h7 (gen x9 (lam h10 (= x5 (+ x9 x9)) (wit x11 (= (* x5 x6) (+ x11 x11)) (* x9 x6) (app (app (inst (inst (inst (use 2) (* x5 x6)) (* (+ x9 x9) x6)) (+ (* x9 x6) (* x9 x6))) (eqelim x12 (= (* x5 x6) (* x12 x6)) h10 (refl (* x5 x6)))) (inst (inst (inst (use 5) x9) x9) x6))))))))))
(all x1 (all x2 (-> (ex x3 (= x2 (+ x3 x3))) (ex x4 (= (f 12 (k 3 x1) x2) (+ x4 x4))))))
