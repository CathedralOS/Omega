; le-trans.proof — the decidable order `le` is TRANSITIVE:  ∀a b c. a≤b -> b≤c -> a≤c  (where x≤y is le(x,y)=True).
; Second total-order property of `le` (with le-refl inside le-max-bound). `le` returns a BUILT-IN nat Bool
; (True=(s z), False=z) so the kernel's `disj` no-confusion (z != s z) can discharge the VACUOUS cases — where
; a hypothesis like le(s a,0)=True reduces to z=(s z), a contradiction, killed by (absurd .. (disj h)). Elements
; are user nats (k2/k3). Proof: triple-nested induction; a=0 concludes directly (le(0,c)=True); any 0 in the
; MIDDLE (b=0 with a=s.., or c=0) makes a premise false -> disj; the all-successor case peels one s off every le
; (le(s x,s y)=le(x,y)) and applies the induction hypothesis. Toward le-total and a Sorted predicate.
(data 2 0 0 0) (data 3 1 1 0)
(fun 25 2 (s z)) (fun 25 3 (f 26 (y 0) (v 0)))          ; le(0,n)=True ; le(s m,n)=lehelp(n,m)
(fun 26 2 z) (fun 26 3 (f 25 (y 0) (v 0)))              ; lehelp(0,m)=False ; lehelp(s n,m)=le(m,n)

(all a (all b (all c (-> (= (f 25 a b) (s z)) (-> (= (f 25 b c) (s z)) (= (f 25 a c) (s z)))))))
(rec 2 3 a (all b (all c (-> (= (f 25 a b) (s z)) (-> (= (f 25 b c) (s z)) (= (f 25 a c) (s z)))))) (gen b (gen c (lam h1 (= (f 25 (k 2) b) (s z)) (lam h2 (= (f 25 b c) (s z)) (refl (s z)))))) (gen a1 (lam iha (all b (all c (-> (= (f 25 a1 b) (s z)) (-> (= (f 25 b c) (s z)) (= (f 25 a1 c) (s z)))))) (rec 2 3 b (all c (-> (= (f 25 (k 3 a1) b) (s z)) (-> (= (f 25 b c) (s z)) (= (f 25 (k 3 a1) c) (s z))))) (gen c (lam h1 (= (f 25 (k 3 a1) (k 2)) (s z)) (lam h2 (= (f 25 (k 2) c) (s z)) (absurd (= (f 25 (k 3 a1) c) (s z)) (disj h1))))) (gen b1 (lam ihb (all c (-> (= (f 25 (k 3 a1) b1) (s z)) (-> (= (f 25 b1 c) (s z)) (= (f 25 (k 3 a1) c) (s z))))) (rec 2 3 c (-> (= (f 25 (k 3 a1) (k 3 b1)) (s z)) (-> (= (f 25 (k 3 b1) c) (s z)) (= (f 25 (k 3 a1) c) (s z)))) (lam h1 (= (f 25 (k 3 a1) (k 3 b1)) (s z)) (lam h2 (= (f 25 (k 3 b1) (k 2)) (s z)) (absurd (= (f 25 (k 3 a1) (k 2)) (s z)) (disj h2)))) (gen c1 (lam ihc (-> (= (f 25 (k 3 a1) (k 3 b1)) (s z)) (-> (= (f 25 (k 3 b1) c1) (s z)) (= (f 25 (k 3 a1) c1) (s z)))) (lam h1 (= (f 25 (k 3 a1) (k 3 b1)) (s z)) (lam h2 (= (f 25 (k 3 b1) (k 3 c1)) (s z)) (app (app (inst* iha b1 c1) h1) h2))))))))))))
