; sorted-tail.proof — a SORTED list's TAIL is sorted:  ∀x t. sorted(Cons x t)=True -> sorted(t)=True. Companion
; to sorted-head; both feed insert-preserves-sorted. Same recursive-boolean Sorted over user nats/lists + user Bool
; (True=k80). Needs `and-true-right` (∀a b. and(a,b)=True -> b=True) whose False case is VACUOUS (and(False,b)=False,
; so False=True) — discharged by `boolnc`, a Bool NO-CONFUSION lemma built from a discriminator disc(True)=(s z),
; disc(False)=z: from k81=k80, cong disc gives z=(s z), killed by the kernel's built-in disj no-confusion.
(data 2 0 0 0) (data 3 1 1 0) (data 60 0 0 0) (data 61 2 0 1) (data 80 0 0 0) (data 81 0 0 0)
(fun 25 2 (k 80)) (fun 25 3 (f 26 (y 0) (v 0)))
(fun 26 2 (k 81)) (fun 26 3 (f 25 (y 0) (v 0)))
(fun 27 80 (y 0)) (fun 27 81 (k 81))
(fun 32 60 (k 80)) (fun 32 61 (f 33 (v 1) (v 0)))
(fun 33 60 (k 80)) (fun 33 61 (f 27 (f 25 (y 0) (v 0)) (f 32 (k 61 (v 0) (v 1)))))
(fun 34 80 (s z)) (fun 34 81 z)

(all x (all t (-> (= (f 32 (k 61 x t)) (k 80)) (= (f 32 t) (k 80)))))
(have boolnc (-> (= (k 81) (k 80)) (bot)) (lam e (= (k 81) (k 80)) (disj (eqelim w (= (f 34 (k 81)) (f 34 w)) e (refl (f 34 (k 81)))))) (have andtrueright (all a (all b (-> (= (f 27 a b) (k 80)) (= b (k 80))))) (rec 80 81 a (all b (-> (= (f 27 a b) (k 80)) (= b (k 80)))) (gen b (lam h (= (f 27 (k 80) b) (k 80)) h)) (gen b (lam h (= (f 27 (k 81) b) (k 80)) (absurd (= b (k 80)) (app boolnc h))))) (gen x (rec 60 61 t (-> (= (f 32 (k 61 x t)) (k 80)) (= (f 32 t) (k 80))) (lam h (= (f 32 (k 61 x (k 60))) (k 80)) (refl (k 80))) (gen y (gen r (lam ih (-> (= (f 32 (k 61 x r)) (k 80)) (= (f 32 r) (k 80))) (lam h (= (f 32 (k 61 x (k 61 y r))) (k 80)) (app (inst* andtrueright (f 25 x y) (f 32 (k 61 y r))) h)))))))))
