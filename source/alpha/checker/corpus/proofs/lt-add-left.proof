; strict order is preserved by left addition: a<b -> c+a < c+b
; witness unchanged; (c+a)+S(k) = c+(a+S(k)) = c+b via add-assoc + the hypothesis.
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 2 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(all x1 (all x2 (all x3 (-> (ex x4 (= (+ x1 (s x4)) x2)) (ex x5 (= (+ (+ x3 x1) (s x5)) (+ x3 x2)))))))
(gen x1 (gen x2 (gen x3 (lam h4 (ex x5 (= (+ x1 (s x5)) x2)) (unpack h4 (gen x6 (lam h7 (= (+ x1 (s x6)) x2) (wit x8 (= (+ (+ x3 x1) (s x8)) (+ x3 x2)) x6 (app (app (inst (inst (inst (use 1) (+ (+ x3 x1) (s x6))) (+ x3 (+ x1 (s x6)))) (+ x3 x2)) (inst (inst (inst (use 2) x1) (s x6)) x3)) (eqelim x9 (= (+ x3 (+ x1 (s x6))) (+ x3 x9)) h7 (refl (+ x3 (+ x1 (s x6))))))))))))))
