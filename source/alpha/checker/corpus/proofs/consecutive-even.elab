; one of any two consecutive integers is even: even n OR even (s n).
; Case-split on the parity of n (even-or-odd): if n is even, done (left); if n is odd, then s n is
; even by succ-of-odd-is-even (right). The parity analogue of consecutive-coprime, and why every other
; integer is even. Composes even-or-odd + succ-of-odd-is-even with a single case; no induction.
(def 0 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(def 1 (all x1 (all x2 (-> (= x1 x2) (= (s x1) (s x2))))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= (s x3) (s x6)) h5 (refl (s x3)))))))
(def 2 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 3 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 4 (all x1 (or (ex x2 (= x1 (+ x2 x2))) (ex x3 (= x1 (s (+ x3 x3)))))) (natind x4 (or (ex x5 (= x4 (+ x5 x5))) (ex x6 (= x4 (s (+ x6 x6))))) (inl (ex x7 (= z (s (+ x7 x7)))) (wit x8 (= z (+ x8 x8)) z (refl z))) (gen x9 (lam h10 (or (ex x11 (= x9 (+ x11 x11))) (ex x12 (= x9 (s (+ x12 x12))))) (case h10 (lam h13 (ex x14 (= x9 (+ x14 x14))) (inr (ex x15 (= (s x9) (+ x15 x15))) (unpack h13 (gen x16 (lam h17 (= x9 (+ x16 x16)) (wit x18 (= (s x9) (s (+ x18 x18))) x16 (eqelim x19 (= (s x9) (s x19)) h17 (refl (s x9))))))))) (lam h20 (ex x21 (= x9 (s (+ x21 x21)))) (inl (ex x22 (= (s x9) (s (+ x22 x22)))) (unpack h20 (gen x23 (lam h24 (= x9 (s (+ x23 x23))) (wit x25 (= (s x9) (+ x25 x25)) (s x23) (app (app (inst (inst (inst (use 3) (s x9)) (s (s (+ x23 x23)))) (s (+ x23 (s x23)))) (app (inst (inst (use 1) x9) (s (+ x23 x23))) h24)) (app (inst (inst (use 2) (s (+ x23 (s x23)))) (s (s (+ x23 x23)))) (app (inst (inst (use 1) (+ x23 (s x23))) (s (+ x23 x23))) (inst (inst (use 0) x23) x23)))))))))))))))
(def 5 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(def 6 (all x1 (-> (ex x2 (= x1 (s (+ x2 x2)))) (ex x3 (= (s x1) (+ x3 x3))))) (gen x4 (lam h5 (ex x6 (= x4 (s (+ x6 x6)))) (unpack h5 (gen x7 (lam h8 (= x4 (s (+ x7 x7))) (wit x9 (= (s x4) (+ x9 x9)) (s x7) (eqelim x10 (= (s x4) x10) (eqelim x11 (= x11 (+ (s x7) (s x7))) (inst (inst (use 5) (s x7)) x7) (refl (+ (s x7) (s x7)))) (eqelim x12 (= (s x4) (s x12)) h8 (refl (s x4)))))))))))
(all x1 (or (ex x2 (= x1 (+ x2 x2))) (ex x3 (= (s x1) (+ x3 x3)))))
(gen x1 (case (inst (use 4) x1) (lam h2 (ex x3 (= x1 (+ x3 x3))) (inl (ex x4 (= (s x1) (+ x4 x4))) h2)) (lam h5 (ex x6 (= x1 (s (+ x6 x6)))) (inr (ex x7 (= x1 (+ x7 x7))) (app (inst (use 6) x1) h5)))))
