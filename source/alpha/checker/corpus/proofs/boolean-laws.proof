; boolean-laws.proof — core BOOLEAN-ALGEBRA laws for the decidable Bool the lattice's decision procedures return
; (True=k80/False=k81): double-negation, commutativity of and/or, associativity of and/or. With de-morgan this is
; the working Boolean algebra. and(True,b)=b/and(False,b)=False, or(True,b)=True/or(False,b)=b, not(T)=F/not(F)=T.
; Every leaf reduces DEFINITIONALLY to a refl (induction on the leading Bool; the identity/annihilator arms of
; and/or collapse each case — e.g. and-assoc a=False makes both sides False, or-assoc a=False makes both or(b,c)).
(data 80 0 0 0) (data 81 0 0 0)
(fun 27 80 (y 0)) (fun 27 81 (k 81))          ; and
(fun 41 80 (k 81)) (fun 41 81 (k 80))          ; not
(fun 42 80 (k 80)) (fun 42 81 (y 0))          ; or

(& (all a (= (f 41 (f 41 a)) a))
(& (all a (all b (= (f 27 a b) (f 27 b a))))
(& (all a (all b (= (f 42 a b) (f 42 b a))))
(& (all a (all b (all c (= (f 27 (f 27 a b) c) (f 27 a (f 27 b c))))))
   (all a (all b (all c (= (f 42 (f 42 a b) c) (f 42 a (f 42 b c))))))))))

(pair
  (rec 80 81 a (= (f 41 (f 41 a)) a) (refl (k 80)) (refl (k 81)))
(pair
  (rec 80 81 a (all b (= (f 27 a b) (f 27 b a)))
    (rec 80 81 b (= (f 27 (k 80) b) (f 27 b (k 80))) (refl (k 80)) (refl (k 81)))
    (rec 80 81 b (= (f 27 (k 81) b) (f 27 b (k 81))) (refl (k 81)) (refl (k 81))))
(pair
  (rec 80 81 a (all b (= (f 42 a b) (f 42 b a)))
    (rec 80 81 b (= (f 42 (k 80) b) (f 42 b (k 80))) (refl (k 80)) (refl (k 80)))
    (rec 80 81 b (= (f 42 (k 81) b) (f 42 b (k 81))) (refl (k 80)) (refl (k 81))))
(pair
  (rec 80 81 a (all b (all c (= (f 27 (f 27 a b) c) (f 27 a (f 27 b c)))))
    (gen b (gen c (refl (f 27 b c))))
    (gen b (gen c (refl (k 81)))))
  (rec 80 81 a (all b (all c (= (f 42 (f 42 a b) c) (f 42 a (f 42 b c)))))
    (gen b (gen c (refl (k 80))))
    (gen b (gen c (refl (f 42 b c)))))))))
