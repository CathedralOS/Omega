; le-max-bound.proof — max is an UPPER BOUND of both its arguments under a DECIDABLE ≤ (the ≤-lattice JOIN
; property):  ∀a ∀b.  (a ≤ max(a,b))  ∧  (b ≤ max(a,b))  where  x ≤ y  is the boolean  le(x,y) = True.
;
; Introduces the decidable order `le` (a stepping stone toward a Sorted predicate) defined — like max — by
; DUAL-DISPATCH mutual recursion le/lehelp over user nats, returning a BUILT-IN nat Bool (True=(s z), False=z, so disj no-confusion applies). Together
; with max-forall (maxfold computes max(acc, listmax)), this characterizes max as the least-upper-bound JOIN of
; the ≤-lattice. Proof: le-refl (le(a,a)=True) + induction on a; every case reduces definitionally except the
; recursive ones, which cite le-refl (b=0 arm) or the induction hypothesis (both parts, via fst/snd of the pair).
(data 2 0 0 0) (data 3 1 1 0)
(fun 23 2 (y 0)) (fun 23 3 (f 24 (y 0) (v 0)))          ; max / maxhelp (dual dispatch)
(fun 24 2 (k 3 (y 0))) (fun 24 3 (k 3 (f 23 (y 0) (v 0))))
(fun 25 2 (s z)) (fun 25 3 (f 26 (y 0) (v 0)))        ; le(0,n)=True ; le(s m,n)=lehelp(n,m)
(fun 26 2 z) (fun 26 3 (f 25 (y 0) (v 0)))        ; lehelp(0,m)=False ; lehelp(s n,m)=le(m,n)

(all a (all b (& (= (f 25 a (f 23 a b)) (s z)) (= (f 25 b (f 23 a b)) (s z)))))

(have lerefl (all a (= (f 25 a a) (s z)))
  (rec 2 3 a (= (f 25 a a) (s z)) (refl (s z)) (gen a1 (lam ih (= (f 25 a1 a1) (s z)) ih)))
(rec 2 3 a (all b (& (= (f 25 a (f 23 a b)) (s z)) (= (f 25 b (f 23 a b)) (s z))))
  (gen b (pair (refl (s z)) (inst lerefl b)))
  (gen a1 (lam iha (all b (& (= (f 25 a1 (f 23 a1 b)) (s z)) (= (f 25 b (f 23 a1 b)) (s z))))
    (rec 2 3 b (& (= (f 25 (k 3 a1) (f 23 (k 3 a1) b)) (s z)) (= (f 25 b (f 23 (k 3 a1) b)) (s z)))
      (pair (inst lerefl a1) (refl (s z)))
      (gen b1 (lam ihb (& (= (f 25 (k 3 a1) (f 23 (k 3 a1) b1)) (s z)) (= (f 25 b1 (f 23 (k 3 a1) b1)) (s z)))
        (pair (fst (inst iha b1)) (snd (inst iha b1))))))))))
