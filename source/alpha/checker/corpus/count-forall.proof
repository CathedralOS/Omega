; count-forall.proof — the first ∀-INPUT THEOREM at the summit.
;
; The summit's input loops compile to accumulator recursion: count(Nil, n) = n,
; count(Cons h t, n) = count(t, n+1). Per-vector proof (input-tv.sh) shows count on
; particular inputs; THIS proves it for ALL inputs at once:
;
;     ∀xs ∀n.  count(xs, n)  =  len(xs) + n
;
; by structural induction on xs, the induction hypothesis used at the SHIFTED
; accumulator (s n) — exactly the shape recx was added to the kernel to express.
; Everything is user nats (k2=zero, k3=succ) / user lists (k60=Nil, k61=Cons),
; matching the meaning route's USER_PRELUDE.

(data 2 0 0 0)                                  ; user zero
(data 3 1 1 0)                                  ; user succ (arity 1, field 0 recursive)
(data 60 0 0 0)                                 ; Nil
(data 61 2 0 1)                                 ; Cons (arity 2; field 0 head, field 1 tail recursive)

(fun 21 2 (y 0))                                ; uadd(0, n)      = n
(fun 21 3 (k 3 (rec 0)))                        ; uadd(s m, n)    = s(uadd(m, n))
(fun 93 60 (k 2))                               ; len(Nil)        = 0
(fun 93 61 (k 3 (rec 1)))                       ; len(Cons h t)   = s(len(t))
(fun 91 60 (y 0))                               ; count(Nil, n)   = n
(fun 91 61 (recx 1 (k 3 (y 0))))                ; count(Cons h t, n) = count(t, s n)

; ∀xs ∀n. count(xs, n) = len(xs) + n, by induction on the list xs, using a local lemma
; uaddsuc: ∀a ∀b. uadd(a, s b) = s(uadd(a, b))  (by induction on the user nat a).
; The lemma is bound with `have` (a local hypothesis = app/lam) rather than def/use, so the proof
; carries no def/use prelude and thus translates to checker.gamma unchanged (the third-checker leg).
(all xs (all n (= (f 91 xs n) (f 21 (f 93 xs) n))))
(have uaddsuc (all a (all b (= (f 21 a (k 3 b)) (k 3 (f 21 a b)))))
  (rec 2 3 a (all b (= (f 21 a (k 3 b)) (k 3 (f 21 a b))))
    (gen b (refl (k 3 b)))                      ; base a=0: both sides reduce to (s b)
    (gen a1 (lam ih (all b (= (f 21 a1 (k 3 b)) (k 3 (f 21 a1 b))))
      (gen b
        (eqelim x (= (k 3 (f 21 a1 (k 3 b))) (k 3 x))
          (inst ih b)
          (refl (k 3 (f 21 a1 (k 3 b)))))))))
  (rec 60 61 xs (all n (= (f 91 xs n) (f 21 (f 93 xs) n)))
    (gen n (refl n))                            ; base xs=Nil: both sides reduce to n
    (gen h (gen t (lam ih (all n (= (f 91 t n) (f 21 (f 93 t) n)))
      (gen n
        ; goal reduces to: count(t, s n) = s(uadd(len t, n))
        ; IH at (s n):     count(t, s n) = uadd(len t, s n)
        ; uaddsuc at len t, n: uadd(len t, s n) = s(uadd(len t, n))  — rewrite the RHS of IH
        (eqelim x (= (f 91 t (k 3 n)) x)
          (inst* uaddsuc (f 93 t) n)
          (inst ih (k 3 n)))))))))
