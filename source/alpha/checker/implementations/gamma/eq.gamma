; eq.gamma - a definitional-equality checker, written in Beta.  (proof-kernel companion)
;
; check.gamma validates *logical* proofs (natural deduction). This validates
; *computational* claims: "do these two terms denote the same value?", decided by
; reducing both to normal form with the definitional rules and comparing. It is
; the other half of what a real proof kernel needs - the bridge from a proposition to
; "what a program actually computes" runs through definitional equality.
;
; Crucially the reducer is FUEL-BOUNDED: normalize(term, fuel) either returns a
; normal form or stops at OutOfFuel. That is exactly the totality discipline
; gamma.md / proof_kernel.md require - a total checker cannot contain an unbounded
; evaluator, so the slow reference route is bounded and explicit.
;
; Signature: z, (s t), (p a b) plus, (m a b) mul; nil, (cons h t), (app l1 l2)
; append, (len l) length.  Input (stdin): two terms; output "equal\n" (exit 1) if
; they share a normal form, else "differ\n" (exit 0).
;
; CONTROL FLOW is CFG/Omega-shaped: each proc is a set of `state` basic blocks linked
; by guarded `to ... when ...` transitions - no if/while. A proc falls into its first
; state and falls through to the next unless it transitions or returns; a loop is a
; state that transitions back to itself.
;
; Memory: 2097152 SRC  2097144 CUR  2097136 LEN  2097128 APTR  3145728 ARENA.
; Nodes [tag,f0,f1] at 24-byte stride.  tag 0 ZERO 1 SUC 2 PLUS 3 MUL ; 4 NIL 5 CONS 6 APPEND 7 LEN.

proc slurp() {
    let n = 0
    let c = read_byte()
    state loop {
        to body when (c >= 0)
        to done
    }
    state body {
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
        to loop
    }
    state done {
        word[2097136] = n
        word[2097144] = 0
        word[2097128] = 3145728
    }
}

proc cbyte() {
    let i = word[2097144]
    state chk {
        to hit when (i < word[2097136])
        return 0
    }
    state hit {
        return byte[2097152 + i]
    }
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

proc is_space(c) {
    state c1 { to yes when (c == ' ')  to c2 }
    state c2 { to yes when (c == 9)    to c3 }
    state c3 { to yes when (c == 10)   to c4 }
    state c4 { to yes when (c == 13)   return 0 }
    state yes { return 1 }
}

proc skip_ws() {
    state loop {
        to body when (is_space(cbyte()) == 1)
        return 0
    }
    state body {
        adv()
        to loop
    }
}

proc alloc(tag, f0, f1) {
    let p = word[2097128]
    word[p] = tag
    word[p + 8] = f0
    word[p + 16] = f1
    word[2097128] = p + 24
    return p
}

proc is_lower(c) {
    state c1 { to no when (c < 'a')  to c2 }
    state c2 { to no when (c > 'z')  return 1 }
    state no { return 0 }
}

proc skip_ident() {              ; consume a lowercase keyword (s / m / cons / app / len ...)
    state loop {
        to body when (is_lower(cbyte()) == 1)
        return 0
    }
    state body {
        adv()
        to loop
    }
}

proc is_digit(c) {
    state c1 { to no when (c < '0')  to c2 }
    state c2 { to no when (c > '9')  return 1 }
    state no { return 0 }
}

proc parse_number() {
    let v = 0
    state loop { to body when (is_digit(cbyte()) == 1)  return v }
    state body { v = v * 10 + (cbyte() - '0')  adv()  to loop }
}

; tags: Peano 0 z 1 s 2 p 3 m ; Lists 4 nil 5 cons 6 app 7 len ; user 34 IVAR 50 CON
; 51 APPLY 52 FAPP 54 RECCALL.  (k cid args...) (f fid arg) (rec i) (v k) parse here too.
proc parse_term() {
    skip_ws()
    let a = 0
    let b = 0
    state tz { to do_z when (cbyte() == 'z')  to tn }
    state do_z { adv()  return alloc(0, 0, 0) }
    state tn { to do_n when (cbyte() == 'n')  to paren }
    state do_n { skip_ident()  return alloc(4, 0, 0) }
    state paren {
        adv()                    ; '('
        skip_ws()
        let op = cbyte()
        skip_ident()             ; consume the whole operator keyword
        to op_s when (op == 's')
        to op_m
    }
    state op_s { a = parse_term()  skip_ws()  adv()  return alloc(1, a, 0) }
    state op_m { to do_m when (op == 'm')  to op_c }
    state do_m { a = parse_term()  b = parse_term()  skip_ws()  adv()  return alloc(3, a, b) }
    state op_c { to do_c when (op == 'c')  to op_a }
    state do_c { a = parse_term()  b = parse_term()  skip_ws()  adv()  return alloc(5, a, b) }
    state op_a { to do_a when (op == 'a')  to op_l }
    state do_a { a = parse_term()  b = parse_term()  skip_ws()  adv()  return alloc(6, a, b) }
    state op_l { to do_l when (op == 'l')  to op_v }
    state do_l { a = parse_term()  skip_ws()  adv()  return alloc(7, a, 0) }
    state op_v { to do_v when (op == 'v')  to op_k }      ; (v k) pattern/indiv var
    state do_v { skip_ws()  a = parse_number()  skip_ws()  adv()  return alloc(34, a, 0) }
    state op_k { to do_k when (op == 'k')  to op_f }      ; (k cid args...) user constructor
    state do_k {
        skip_ws()
        a = parse_number()
        b = alloc(50, a, 0)      ; CON(cid)
        skip_ws()
        to kloop
    }
    state kloop {
        to kbody when (cbyte() != ')')
        adv()
        return b
    }
    state kbody { b = alloc(51, b, parse_term())  skip_ws()  to kloop }   ; APPLY(b, arg)
    state op_f { to do_f when (op == 'f')  to op_y }      ; (f fid arg [arg2]) function application
    state do_f {
        skip_ws()
        a = parse_number()
        b = parse_term()
        skip_ws()
        to f_bin when (cbyte() != ')')   ; a 2nd argument -> binary
        adv()
        return alloc(52, a, b)
    }
    state f_bin { b = alloc(53, b, parse_term())  skip_ws()  adv()  return alloc(52, a, b) }   ; FBUNDLE
    state op_y { to do_y when (op == 'y')  to op_r }      ; (y k) - k-th extra arg (binary fn body)
    state do_y { skip_ws()  a = parse_number()  skip_ws()  adv()  return alloc(56, a, 0) }
    state op_r { to do_r when (op == 'r')  to do_plus }   ; (rec i) recursive call
    state do_r { skip_ws()  a = parse_number()  skip_ws()  adv()  return alloc(54, a, 0) }
    state do_plus {
        a = parse_term()         ; (p a b) plus
        b = parse_term()
        skip_ws()
        adv()                    ; ')'
        return alloc(2, a, b)
    }
}

; one rewrite step of (f fid arg) - mirrors check.gamma. FRULE table at 5898240.
proc reduce_fun(fid, arg, fuel) {
    let scrut = arg
    let extra = 0
    let a = 0
    let cid = 0
    let body = 0
    state bundle { to do_bundle when (word[arg] == 53)  to norm }    ; binary: FBUNDLE(scrut, extra)
    state do_bundle { scrut = word[arg + 8]  extra = word[arg + 16]  to norm }
    state norm { a = normalize(scrut, fuel)  to nullary }
    state nullary { to do_null when (word[a] == 50)  to applied }
    state do_null {
        cid = word[a + 8]
        body = word[5898240 + (fid * 64 + cid) * 8]
        to stuck when (body == 0)
        return instantiate(body, fid, alloc(53, 0, 0), extra)
    }
    state applied { to do_app when (word[a] == 51)  to stuck }
    state do_app {
        to unary when (word[word[a + 8]] == 50)
        to binary when (word[word[a + 8]] == 51)
        to stuck
    }
    state unary {
        cid = word[word[a + 8] + 8]
        body = word[5898240 + (fid * 64 + cid) * 8]
        to stuck when (body == 0)
        return instantiate(body, fid, alloc(53, word[a + 16], 0), extra)
    }
    state binary {
        to bin_ok when (word[word[word[a + 8] + 8]] == 50)
        to stuck
    }
    state bin_ok {
        cid = word[word[word[a + 8] + 8] + 8]
        body = word[5898240 + (fid * 64 + cid) * 8]
        to stuck when (body == 0)
        return instantiate(body, fid, alloc(53, word[word[a + 8] + 16], word[a + 16]), extra)
    }
    state stuck { return 0 }
}

proc instantiate(t, fid, flds, extra) {
    state iv { to do_iv when (word[t] == 34)  to par }
    state do_iv {
        to ret_a0 when (word[t + 8] == 0)
        to ret_a1 when (word[t + 8] == 1)
        return t
    }
    state ret_a0 { return word[flds + 8] }
    state ret_a1 { return word[flds + 16] }
    state par { to do_par when (word[t] == 56)  to rc }    ; PAR (y k) - the extra argument
    state do_par { return extra }
    state rc { to do_rc when (word[t] == 54)  to fapp }
    state do_rc {
        to rec_a0 when (word[t + 8] == 0)
        to rec_a1
    }
    state rec_a0 {
        to ra0_bin when (extra != 0)
        return alloc(52, fid, word[flds + 8])
    }
    state ra0_bin { return alloc(52, fid, alloc(53, word[flds + 8], extra)) }
    state rec_a1 {
        to ra1_bin when (extra != 0)
        return alloc(52, fid, word[flds + 16])
    }
    state ra1_bin { return alloc(52, fid, alloc(53, word[flds + 16], extra)) }
    state fapp { to do_fa when (word[t] == 52)  to z }
    state do_fa { return alloc(52, word[t + 8], instantiate(word[t + 16], fid, flds, extra)) }
    state z { to ret_t when (word[t] == 0)  to nilc }
    state ret_t { return t }
    state nilc { to ret_t when (word[t] == 4)  to con }
    state con { to ret_t when (word[t] == 50)  to suc }
    state suc { to do_suc when (word[t] == 1)  to lenc }
    state do_suc { return alloc(1, instantiate(word[t + 8], fid, flds, extra), 0) }
    state lenc { to do_len when (word[t] == 7)  to dflt }
    state do_len { return alloc(7, instantiate(word[t + 8], fid, flds, extra), 0) }
    state dflt { return alloc(word[t], instantiate(word[t + 8], fid, flds, extra), instantiate(word[t + 16], fid, flds, extra)) }
}

; reduce to normal form using the definitional rules; fuel-bounded (total).
proc normalize(t, fuel) {
    state fuelchk { to oof when (fuel < 1)  to live }
    state oof { return t }                       ; OutOfFuel - return as-is
    state live {
        let tag = word[t]
        let a = 0
        let b = 0
        to ret_t when (tag == 0)                 ; z is a normal form
        to t4
    }
    state ret_t { return t }
    state t4 { to ret_t when (tag == 4)  to t1 } ; nil is a normal form
    state t1 { to do_s when (tag == 1)  to t5 }
    state do_s {
        a = normalize(word[t + 8], fuel - 1)
        return alloc(1, a, 0)
    }
    state t5 { to do_cons when (tag == 5)  to t2 }
    state do_cons {
        a = normalize(word[t + 8], fuel - 1)
        b = normalize(word[t + 16], fuel - 1)
        return alloc(5, a, b)
    }
    state t2 { to do_plus when (tag == 2)  to t6 }
    state do_plus {
        a = normalize(word[t + 8], fuel - 1)
        b = normalize(word[t + 16], fuel - 1)
        to plus_z when (word[a] == 0)            ; p z b => b
        to plus_s
    }
    state plus_z { return b }
    state plus_s {
        to do_plus_s when (word[a] == 1)         ; p (s x) b => s (p x b)
        return alloc(2, a, b)                    ; stuck
    }
    state do_plus_s {
        a = normalize(alloc(2, word[a + 8], b), fuel - 1)
        return alloc(1, a, 0)
    }
    state t6 { to do_app when (tag == 6)  to t7 }
    state do_app {
        a = normalize(word[t + 8], fuel - 1)
        to app_nil when (word[a] == 4)           ; app nil l2 => l2
        to app_cons
    }
    state app_nil { return normalize(word[t + 16], fuel - 1) }
    state app_cons {
        to do_app_cons when (word[a] == 5)       ; app (cons h t) l2 => cons h (app t l2)
        return alloc(6, a, normalize(word[t + 16], fuel - 1))
    }
    state do_app_cons {
        b = alloc(6, word[a + 16], word[t + 16])
        return alloc(5, word[a + 8], normalize(b, fuel - 1))
    }
    state t7 { to do_len when (tag == 7)  to t3 }
    state do_len {
        a = normalize(word[t + 8], fuel - 1)
        to len_nil when (word[a] == 4)           ; len nil => z
        to len_cons
    }
    state len_nil { return alloc(0, 0, 0) }
    state len_cons {
        to do_len_cons when (word[a] == 5)       ; len (cons h t) => s (len t)
        return alloc(7, a, 0)
    }
    state do_len_cons {
        b = normalize(alloc(7, word[a + 16], 0), fuel - 1)
        return alloc(1, b, 0)
    }
    state t3 { to do_mul when (tag == 3)  to t_user }
    state do_mul {
        a = normalize(word[t + 8], fuel - 1)
        to mul_z when (word[a] == 0)             ; m z y => z
        to mul_s
    }
    state mul_z { return alloc(0, 0, 0) }
    state mul_s {
        to do_mul_s when (word[a] == 1)          ; m (s x) y => p y (m x y)
        return alloc(3, a, word[t + 16])
    }
    state do_mul_s {
        b = alloc(3, word[a + 8], word[t + 16])              ; m x y
        return normalize(alloc(2, word[t + 16], b), fuel - 1) ; p y (m x y)
    }
    state t_user { to ret_t when (tag == 50)  to t_iv }   ; CON(cid) - normal
    state t_iv { to ret_t when (tag == 34)  to t_rec }    ; IVAR - normal
    state t_rec { to ret_t when (tag == 54)  to t_apply } ; RECCALL - normal
    state t_apply { to do_apply when (tag == 51)  to t_fapp }
    state do_apply {                                      ; APPLY(f,a) - inert: reduce both
        a = normalize(word[t + 8], fuel - 1)
        b = normalize(word[t + 16], fuel - 1)
        return alloc(51, a, b)
    }
    state t_fapp { to do_fapp when (tag == 52)  to t_53 }    ; (f fid arg) - reduce or STUCK
    state do_fapp {
        a = reduce_fun(word[t + 8], word[t + 16], fuel - 1)
        to fapp_stuck when (a == 0)
        return normalize(a, fuel - 1)
    }
    state fapp_stuck { return alloc(52, word[t + 8], normalize(word[t + 16], fuel - 1)) }
    state t_53 { to do_53 when (tag == 53)  return t }       ; FBUNDLE(scrut,extra) - normalize both
    state do_53 {
        a = normalize(word[t + 8], fuel - 1)
        b = normalize(word[t + 16], fuel - 1)
        return alloc(53, a, b)
    }
}

proc term_eq(a, b) {
    state e0 { to neq when (word[a] != word[b])  to e1 }
    state neq { return 0 }
    state e1 { to ret1 when (word[a] == 0)  to e4 }       ; z
    state ret1 { return 1 }
    state e4 { to ret1 when (word[a] == 4)  to e_s }      ; nil
    state e_s { to do_child when (word[a] == 1)  to e_len }   ; s - compare the child
    state do_child { return term_eq(word[a + 8], word[b + 8]) }
    state e_len { to do_child when (word[a] == 7)  to e_con }  ; len - unary
    state e_con { to id_eq when (word[a] == 50)  to e_iv }     ; CON: same cid?
    state id_eq { to ret1 when (word[a + 8] == word[b + 8])  return 0 }
    state e_iv { to id_eq when (word[a] == 34)  to e_fapp }    ; IVAR: same index
    state e_fapp { to fapp_eq when (word[a] == 52)  to e_both }
    state fapp_eq {
        to both_neq when (word[a + 8] != word[b + 8])          ; (f fid arg): same fid + arg?
        return term_eq(word[a + 16], word[b + 16])
    }
    state e_both {
        to both_neq when (term_eq(word[a + 8], word[b + 8]) == 0)   ; plus/mul/cons/app/APPLY
        return term_eq(word[a + 16], word[b + 16])
    }
    state both_neq { return 0 }
}

proc at_fun() {                  ; peek for a (fun ...) DECL - must be "(fu", not a (f ...) app
    let save = word[2097144]
    skip_ws()
    let r = 0
    state p1 { to p2 when (cbyte() == '(')  to done }
    state p2 {
        adv()
        to p3 when (cbyte() == 'f')
        to done
    }
    state p3 {
        adv()
        to setr when (cbyte() == 'u')    ; "(fu..." = fun ; "(f ..." / "(f0..." = application
        to done
    }
    state setr { r = 1  to done }
    state done { word[2097144] = save  return r }
}

proc parse_fun() {               ; (fun FID CID body) -> FRULE[fid][cid] = body
    skip_ws()
    adv()                        ; '('
    skip_ws()
    skip_ident()                 ; "fun"
    skip_ws()
    let fid = parse_number()
    skip_ws()
    let cid = parse_number()
    let body = parse_term()
    skip_ws()
    adv()                        ; ')'
    word[5898240 + (fid * 64 + cid) * 8] = body
    return 0
}

proc main() {
    slurp()
    state funloop { to funbody when (at_fun() == 1)  to terms }   ; (fun ...) prefix, like check.gamma
    state funbody { parse_fun()  to funloop }
    state terms {
        let t1 = parse_term()
        let t2 = parse_term()
        let n1 = normalize(t1, 1000000)
        let n2 = normalize(t2, 1000000)
        to chk
    }
    state chk { to eq when (term_eq(n1, n2) == 1)  to differ }
    state eq { emit("equal\n")  return 1 }
    state differ { emit("differ\n")  return 0 }
}
