// Full Omega rejects this source: the index retains its complete trapping-u32
// interval, so the compiler cannot prove it lies within the two-element array.

data UnsafeIndexProbe {
    values: [u8; 2] in Trapping;
    index: u32 in Trapping;
}

machine UnsafeIndexProbe::run(&mut self) -> u8 {
    self.values[self.index]
}
