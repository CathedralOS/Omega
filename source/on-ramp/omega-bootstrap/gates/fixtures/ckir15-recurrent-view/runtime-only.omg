data ByteProducer {}
machine ByteProducer::run(&mut self) -> u8 {
    70
    state inspect(&mut self, bytes: &[u8], prefix: u8, middle: u8, suffix: u8) {
        transition bytes.len > 0 {
            true -> emit(prefix, bytes[0], middle, bytes[1..], suffix)
            false -> finish(prefix, middle, suffix)
        }
    }
    state emit(&mut self, prefix: u8, byte: u8, middle: u8, bytes: &[u8], suffix: u8) {
        transition bytes.len > 0 {
            true -> emit(prefix, bytes[0], middle, bytes[1..], suffix)
            false -> finish(prefix, middle, suffix)
        }
    }
    state finish(&mut self, prefix: u8, middle: u8, suffix: u8) { prefix }
}
