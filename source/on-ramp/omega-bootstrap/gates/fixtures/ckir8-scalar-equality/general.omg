data Pair [copy] {
    left: u8;
    right: u8;
}

data Packet [copy] {
    case Empty;
    case One(value: u8);
    case Two(left: u8, right: u8);
    case Three(a: bool, b: bool, c: bool);
    case Four(a: u8, b: u8, nested: Pair, tail: u8);
}

data EqualityGate {}

data SumProducer {
    pad: u8;
    current: Packet;
    gate: EqualityGate;
}

machine SumProducer::consume(&mut self, packet: Packet) -> u8 {
    transition packet {
        Packet::Empty -> consume_empty()
        Packet::One { value } -> consume_one(value)
        Packet::Two { left, right } -> consume_two(left, right)
        Packet::Three { a, b, c } -> consume_three(a, b, c)
        Packet::Four { a, b, nested, tail } -> consume_four(a, b, nested, tail)
    }

    state consume_empty(&mut self) { 0 }
    state consume_one(&mut self, value: u8) { value }
    state consume_two(&mut self, left: u8, right: u8) { right }
    state consume_three(&mut self, a: bool, b: bool, c: bool) { 0 }
    state consume_four(&mut self, a: u8, b: u8, nested: Pair, tail: u8) {
        tail
    }
}

machine SumProducer::run(&mut self) -> u8 {
    self.pad = self.gate.check();
    self.current = Packet::Empty;
    self.current = Packet::Two { left: 1, right: 2 };
    self.current = Packet::Three { a: true, b: false, c: true };
    self.current = Packet::One { value: self.pad };
    transition self.current {
        Packet::Empty -> field_empty()
        Packet::One { value } -> field_one(value)
        Packet::Two { left, right } -> field_two(left, right)
        Packet::Three { a, b, c } -> field_three(a, b, c)
        Packet::Four { a, b, nested, tail } -> field_four(a, b, nested, tail)
    }

    state field_empty(&mut self) { 1 }
    state field_one(&mut self, value: u8) {
        self.consume(Packet::Four {
            a: value,
            b: 2,
            nested: Pair { left: 3, right: 4 },
            tail: value
        })
    }
    state field_two(&mut self, left: u8, right: u8) { right }
    state field_three(&mut self, a: bool, b: bool, c: bool) { 2 }
    state field_four(&mut self, a: u8, b: u8, nested: Pair, tail: u8) {
        tail
    }
}

machine EqualityGate::check(&self) -> u8 {
    transition 70 == 70 {
        true -> equality_passed()
        false -> equality_failed()
    }

    state equality_failed(&self) { 0 }
    state equality_passed(&self) { 70 }
}
