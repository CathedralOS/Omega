data CallValue [copy] {
    value: u8;
}

data DirectCallProbe {
    retained: CallValue;
    scalar: u8;
}

machine DirectCallProbe::install(&mut self, value: CallValue) {
    self.retained = value;
}

machine DirectCallProbe::run(&mut self) -> u8 {
    self.scalar = 70;
    self.install(CallValue { value: self.scalar });
    self.retained.value
}
