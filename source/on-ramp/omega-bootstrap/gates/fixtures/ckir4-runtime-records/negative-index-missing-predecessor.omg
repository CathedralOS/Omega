data MissingBoundProbe {
    bytes: [u8; 8] in Trapping;
    length: u32 [0..=8];
}

machine MissingBoundProbe::run(&mut self) -> u8 {
    transition self.length < 8 {
        true -> retain()
        _ -> retain()
    }

    state retain(&mut self) {
        self.bytes[self.length] = 0;
        70
    }
}
