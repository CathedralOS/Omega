data U64Probe {
    stored: u64;
}

machine U64Probe::echo(
    &self,
    value: u64 [0..=8589934591]
) -> u64 [0..=8589934591] {
    value
}

machine U64Probe::run(&mut self) -> u8 {
    self.stored = 8589934591;
    transition self.stored < 8589934592 {
        true -> bounded(self.stored)
        false -> failed()
    }

    state bounded(&mut self, value: u64 [0..=8589934591]) {
        self.stored = self.echo(value);
        70
    }

    state failed(&mut self) { 0 }
}
