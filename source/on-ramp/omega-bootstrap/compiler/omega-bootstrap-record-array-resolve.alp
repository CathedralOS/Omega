// Focused OMGCOMP1 -> OMGRSWB structural record-array resolver.
// It parses a one-unit compilation and selected declarations by grammar and
// resolved identity.  It does not select by filename, source digest, token
// count, declaration order, or readable record/machine names.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
    machine write_byte(byte: i32);
}

data Main {
    console: Console;
    status: i32; c: i32; n: i32; pos: i32; limit: i32;
    tok: i32; tok_start: i32; tok_len: i32; int_value: i32;
    decoded: i32; i: i32; j: i32; k: i32; x: i32; y: i32; word: i32;
    match_ok: i32; char_ok: i32; depth: i32; comment_depth: i32;
    total_length: i32; bundle_length: i32; string_length: i32;
    string_count: i32; root_owner_string: i32; root_machine_string: i32;
    package_table: i32; source_table: i32; string_table: i32;
    bundle_start: i32; source_start: i32; source_length: i32;
    module_string_start: i32; module_string_len: i32;
    root_owner_start: i32; root_owner_len: i32;
    root_machine_start: i32; root_machine_len: i32;
    input: [u8; 267281];

    // Declaration custody.  Extra inert fields are parsed but omitted from
    // the focused witness.  Selected rows use semantic-role IDs.
    data_count: i32; field_count: i32; machine_count: i32; param_count: i32;
    data_names: [i32; 8]; data_name_lens: [i32; 8];
    data_copy_flags: [i32; 8];
    data_field_starts: [i32; 8]; data_field_counts: [i32; 8];
    field_owners: [i32; 32]; field_ordinals: [i32; 32];
    field_names: [i32; 32]; field_name_lens: [i32; 32];
    field_kinds: [i32; 32]; field_payloads: [i32; 32];
    field_nominal_names: [i32; 32]; field_nominal_lens: [i32; 32];
    machine_owner_names: [i32; 8]; machine_owner_lens: [i32; 8];
    machine_names: [i32; 8]; machine_name_lens: [i32; 8];
    machine_access: [i32; 8]; machine_result_kinds: [i32; 8];
    machine_param_starts: [i32; 8]; machine_param_counts: [i32; 8];
    machine_body_starts: [i32; 8]; machine_body_lengths: [i32; 8];
    param_owners: [i32; 16]; param_ordinals: [i32; 16];
    param_names: [i32; 16]; param_name_lens: [i32; 16];
    param_kinds: [i32; 16];

    // Resolved semantic roles and authored ordinals/spans.
    observation_data: i32; stream_data: i32; root_data: i32; array_n: i32;
    rows_field: i32; count_field: i32; retained_field: i32; stream_field: i32;
    push_machine: i32; lookup_machine: i32; run_machine: i32; index_param: i32;
    observation_fields: [i32; 9]; push_params: [i32; 9];
    store_fields: [i32; 9]; store_params: [i32; 9]; store_seen: [i32; 9];
    argument_values: [i32; 9];
    read_field: i32; read_param: i32; read_argument_ordinal: i32;
    block_name_starts: [i32; 4]; block_name_lens: [i32; 4];
    block_body_starts: [i32; 4]; block_body_lengths: [i32; 4];
    block_source_ordinals: [i32; 4];
    call_starts: [i32; 2]; call_lengths: [i32; 2];
    call_argument_counts: [i32; 2];
    result_kind: i32; result_payload: i32;
    result_span_start: i32; result_span_len: i32;
    saved_name_start: i32; saved_name_len: i32;
    saved_pos: i32; saved_limit: i32; current_data: i32;
    current_machine: i32; current_param: i32; current_field: i32;
    scan_data: i32; scan_field: i32; scan_end: i32; scan_machine: i32;
    words: [u8; 74];

    // 2,172 bytes after the 16-byte identity prefix are 539 u32 words.
    publication: [i32; 539];
}

machine Main::reject(&mut self) {
    transition self.status == 0 { true -> set_status() _ -> done() }
    state set_status() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::exhaust(&mut self) {
    transition self.status == 0 { true -> set_status() _ -> done() }
    state set_status() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::slurp(&mut self) {
    self.n = 0; transition 0 { _ -> read_next() }
    state read_next() { self.c = read_byte(); transition self.c < 0 { true -> done() _ -> capacity() } }
    state capacity() { transition self.n < 267281 { true -> store() _ -> over() } }
    state store() { self.input[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> read_next() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_u32(&mut self, at: i32) {
    self.decoded = 0 - 1;
    transition at >= 0 { true -> room() _ -> bad() }
    state room() { transition at <= self.n - 4 { true -> signed() _ -> bad() } }
    state signed() { transition self.input[at + 3] < 128 { true -> decode() _ -> bad() } }
    state decode() {
        self.decoded = self.input[at] + self.input[at + 1] * 256
            + self.input[at + 2] * 65536 + self.input[at + 3] * 16777216;
        transition 0 { _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::stored_spans_equal(&mut self, left: i32, right: i32, count: i32) {
    self.bytes_equal(self.source_start + left, self.source_start + right, count);
}

machine Main::bytes_equal(&mut self, left: i32, right: i32, count: i32) {
    self.match_ok = 0; self.i = 0; transition 0 { _ -> loop() }
    state loop() { transition self.i < count { true -> compare() _ -> yes() } }
    state compare() { transition self.input[left + self.i] == self.input[right + self.i] { true -> advance() _ -> done() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok = 1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::check_magic8(&mut self, at: i32) {
    self.match_ok = 0;
    transition self.input[at] == 79 { true -> b1_check() _ -> done() }
    state b1_check() { transition self.input[at + 1] == 77 { true -> b2_check() _ -> done() } }
    state b2_check() { transition self.input[at + 2] == 71 { true -> b3_check() _ -> done() } }
    state b3_check() { transition self.input[at + 3] == self.x { true -> b4_check() _ -> done() } }
    state b4_check() { transition self.input[at + 4] == self.y { true -> b5_check() _ -> done() } }
    state b5_check() { transition self.input[at + 5] == self.k { true -> b6_check() _ -> done() } }
    state b6_check() { transition self.input[at + 6] == self.j { true -> b7_check() _ -> done() } }
    state b7_check() { transition self.input[at + 7] == self.current_data { true -> yes() _ -> done() } }
    state yes() { self.match_ok = 1; transition 0 { _ -> done() } }
    state done() { }
}

// Exact one-unit OMGCOMP1 transport.  Readable label bytes are custody only.
machine Main::decode_compilation(&mut self) {
    transition self.n >= 64 { true -> magic() _ -> bad() }
    state magic() { self.x=67; self.y=79; self.k=77; self.j=80; self.current_data=0; self.check_magic8(0); transition self.match_ok == 1 { true -> fixed() _ -> bad() } }
    state fixed() { transition self.input[8] == 1 { true -> fixed1() _ -> bad() } }
    state fixed1() { transition self.input[9] == 0 { true -> fixed2() _ -> bad() } }
    state fixed2() { transition self.input[10] == 0 { true -> fixed3() _ -> bad() } }
    state fixed3() { transition self.input[11] == 0 { true -> target0() _ -> bad() } }
    state target0() { transition self.input[12] == 1 { true -> target1() _ -> bad() } }
    state target1() { transition self.input[13] == 0 { true -> target2() _ -> bad() } }
    state target2() { transition self.input[14] == 0 { true -> target3() _ -> bad() } }
    state target3() { transition self.input[15] == 0 { true -> header() _ -> bad() } }
    state header() {
        self.read_u32(16); self.total_length = self.decoded;
        self.read_u32(20); self.bundle_length = self.decoded;
        self.read_u32(24); self.string_length = self.decoded;
        self.read_u32(28); self.string_count = self.decoded;
        self.read_u32(52); self.root_owner_string = self.decoded;
        self.read_u32(56); self.root_machine_string = self.decoded;
        transition self.status == 0 { true -> exact_length() _ -> done() }
    }
    state exact_length() { transition self.total_length == self.n { true -> input_limit() _ -> bad() } }
    state input_limit() { transition self.total_length <= 267280 { true -> count_package() _ -> over() } }
    state count_package() { self.read_u32(32); transition self.decoded == 1 { true -> count_source() _ -> bad() } }
    state count_source() { self.read_u32(36); transition self.decoded == 1 { true -> count_alias() _ -> bad() } }
    state count_alias() { self.read_u32(40); transition self.decoded == 0 { true -> root_package() _ -> bad() } }
    state root_package() { self.read_u32(44); transition self.decoded == 0 { true -> root_source() _ -> bad() } }
    state root_source() { self.read_u32(48); transition self.decoded == 0 { true -> reserved() _ -> bad() } }
    state reserved() { self.read_u32(60); transition self.decoded == 0 { true -> string_bounds() _ -> bad() } }
    state string_bounds() { transition self.string_count >= 1 { true -> string_ceiling() _ -> bad() } }
    state string_ceiling() { transition self.string_count <= 64 { true -> tables() _ -> over() } }
    state tables() {
        self.package_table = 64; self.source_table = 112;
        self.string_table = 132; self.bundle_start = self.string_table + self.string_length;
        transition self.bundle_start <= self.n { true -> bundle_extent() _ -> bad() }
    }
    state bundle_extent() { transition self.bundle_length == self.n - self.bundle_start { true -> package_row() _ -> bad() } }
    state package_row() { self.read_u32(64); transition self.decoded == 0 { true -> package_key() _ -> bad() } }
    state package_key() { self.i = 0; self.x = 0; transition 0 { _ -> package_key_loop() } }
    state package_key_loop() { transition self.i < 32 { true -> package_key_byte() _ -> package_key_nonzero() } }
    state package_key_byte() { self.x = self.x + self.input[68 + self.i]; self.i = self.i + 1; transition 0 { _ -> package_key_loop() } }
    state package_key_nonzero() { transition self.x != 0 { true -> package_span0() _ -> bad() } }
    state package_span0() { self.read_u32(100); transition self.decoded == 0 { true -> package_span1() _ -> bad() } }
    state package_span1() { self.read_u32(104); transition self.decoded == 1 { true -> package_reserved() _ -> bad() } }
    state package_reserved() { self.read_u32(108); transition self.decoded == 0 { true -> source_row() _ -> bad() } }
    state source_row() { self.read_u32(112); transition self.decoded == 0 { true -> source_owner() _ -> bad() } }
    state source_owner() { self.read_u32(116); transition self.decoded == 0 { true -> source_bundle() _ -> bad() } }
    state source_bundle() { self.read_u32(120); transition self.decoded == 0 { true -> source_module() _ -> bad() } }
    state source_module() { self.read_u32(124); self.x = self.decoded; transition self.x < self.string_count { true -> source_flags() _ -> bad() } }
    state source_flags() { self.read_u32(128); transition self.decoded == 0 { true -> roots_in_range() _ -> bad() } }
    state roots_in_range() { transition self.root_owner_string < self.string_count { true -> root_machine_range() _ -> bad() } }
    state root_machine_range() { transition self.root_machine_string < self.string_count { true -> strings_begin() _ -> bad() } }
    state strings_begin() { self.pos = self.string_table; self.i = 0; transition 0 { _ -> strings_loop() } }
    state strings_loop() { transition self.i < self.string_count { true -> string_size() _ -> strings_end() } }
    state string_size() { self.read_u32(self.pos); self.y = self.decoded; transition self.status == 0 { true -> string_room() _ -> done() } }
    state string_room() { transition self.y <= self.bundle_start - self.pos - 4 { true -> string_save() _ -> bad() } }
    state string_save() {
        transition self.i == self.x { true -> save_module() _ -> save_owner_check() }
    }
    state save_module() { self.module_string_start = self.pos + 4; self.module_string_len = self.y; transition 0 { _ -> save_owner_check() } }
    state save_owner_check() { transition self.i == self.root_owner_string { true -> save_owner() _ -> save_machine_check() } }
    state save_owner() { self.root_owner_start = self.pos + 4; self.root_owner_len = self.y; transition 0 { _ -> save_machine_check() } }
    state save_machine_check() { transition self.i == self.root_machine_string { true -> save_machine() _ -> string_advance() } }
    state save_machine() { self.root_machine_start = self.pos + 4; self.root_machine_len = self.y; transition 0 { _ -> string_advance() } }
    state string_advance() { self.pos = self.pos + 4 + self.y; self.i = self.i + 1; transition 0 { _ -> strings_loop() } }
    state strings_end() { transition self.pos == self.bundle_start { true -> bundle_header() _ -> bad() } }
    state bundle_header() { transition self.bundle_length >= 24 { true -> bundle_magic() _ -> bad() } }
    state bundle_magic() { self.x=48; self.y=66; self.k=78; self.j=68; self.current_data=76; self.check_magic8(self.bundle_start); transition self.match_ok == 1 { true -> bundle_version() _ -> bad() } }
    state bundle_version() { self.read_u32(self.bundle_start + 8); transition self.decoded == 1 { true -> bundle_count() _ -> bad() } }
    state bundle_count() { self.read_u32(self.bundle_start + 12); transition self.decoded == 1 { true -> entry_lengths() _ -> bad() } }
    state entry_lengths() {
        self.read_u32(self.bundle_start + 16); self.x = self.decoded;
        self.read_u32(self.bundle_start + 20); self.source_length = self.decoded;
        transition self.status == 0 { true -> label_limit() _ -> done() }
    }
    state label_limit() { transition self.x >= 1 { true -> label_ceiling() _ -> bad() } }
    state label_ceiling() { transition self.x <= 64 { true -> source_ceiling() _ -> over() } }
    state source_ceiling() { transition self.source_length <= 131072 { true -> entry_extent() _ -> over() } }
    state entry_extent() { self.source_start = self.bundle_start + 24 + self.x; transition self.source_length == self.n - self.source_start { true -> done() _ -> bad() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::is_ident_start(&mut self) {
    self.char_ok = 0;
    transition self.c == 95 { true -> yes() _ -> upper0() }
    state upper0() { transition self.c >= 65 { true -> upper1() _ -> lower0() } }
    state upper1() { transition self.c < 91 { true -> yes() _ -> lower0() } }
    state lower0() { transition self.c >= 97 { true -> lower1() _ -> done() } }
    state lower1() { transition self.c < 123 { true -> yes() _ -> done() } }
    state yes() { self.char_ok = 1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::is_ident_continue(&mut self) {
    self.is_ident_start(); transition self.char_ok == 1 { true -> done() _ -> digit0() }
    state digit0() { transition self.c >= 48 { true -> digit1() _ -> done() } }
    state digit1() { transition self.c < 58 { true -> yes() _ -> done() } }
    state yes() { self.char_ok = 1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::skip_block_comment(&mut self) {
    self.comment_depth = 1; self.pos = self.pos + 2; transition 0 { _ -> loop() }
    state loop() { transition self.pos < self.limit { true -> room() _ -> bad() } }
    state room() { transition self.pos + 1 < self.limit { true -> open0() _ -> advance() } }
    state open0() { transition self.input[self.pos] == 47 { true -> open1() _ -> close0() } }
    state open1() { transition self.input[self.pos + 1] == 42 { true -> open() _ -> close0() } }
    state open() { self.comment_depth = self.comment_depth + 1; self.pos = self.pos + 2; transition 0 { _ -> loop() } }
    state close0() { transition self.input[self.pos] == 42 { true -> close1() _ -> advance() } }
    state close1() { transition self.input[self.pos + 1] == 47 { true -> close() _ -> advance() } }
    state close() { self.comment_depth = self.comment_depth - 1; self.pos = self.pos + 2; transition self.comment_depth == 0 { true -> done() _ -> loop() } }
    state advance() { self.pos = self.pos + 1; transition 0 { _ -> loop() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

// Kinds: 0 EOF, 256 identifier, 257 nonnegative signed-i32 integer.
machine Main::next_token(&mut self) {
    self.tok = 0; self.tok_start = self.pos; self.tok_len = 0; self.int_value = 0;
    transition self.status == 0 { true -> skip() _ -> done() }
    state skip() { transition self.pos < self.limit { true -> whitespace() _ -> eof() } }
    state whitespace() { self.c = self.input[self.pos]; transition self.c == 32 { true -> skip_one() _ -> tab() } }
    state tab() { transition self.c == 9 { true -> skip_one() _ -> lf() } }
    state lf() { transition self.c == 10 { true -> skip_one() _ -> cr() } }
    state cr() { transition self.c == 13 { true -> skip_one() _ -> slash() } }
    state skip_one() { self.pos = self.pos + 1; transition 0 { _ -> skip() } }
    state slash() { transition self.c == 47 { true -> slash_room() _ -> classify() } }
    state slash_room() { transition self.pos + 1 < self.limit { true -> slash_kind() _ -> classify() } }
    state slash_kind() { transition self.input[self.pos + 1] == 47 { true -> line_begin() _ -> block_check() } }
    state line_begin() { self.pos = self.pos + 2; transition 0 { _ -> line() } }
    state line() { transition self.pos < self.limit { true -> line_byte() _ -> eof() } }
    state line_byte() { transition self.input[self.pos] == 10 { true -> skip_one() _ -> line_advance() } }
    state line_advance() { self.pos = self.pos + 1; transition 0 { _ -> line() } }
    state block_check() { transition self.input[self.pos + 1] == 42 { true -> block() _ -> classify() } }
    state block() { self.skip_block_comment(); transition self.status == 0 { true -> skip() _ -> done() } }
    state classify() { self.tok_start = self.pos; self.c = self.input[self.pos]; self.is_ident_start(); transition self.char_ok == 1 { true -> ident_begin() _ -> digit0() } }
    state ident_begin() { self.pos = self.pos + 1; transition 0 { _ -> ident_loop() } }
    state ident_loop() { transition self.pos < self.limit { true -> ident_byte() _ -> ident_done() } }
    state ident_byte() { self.c = self.input[self.pos]; self.is_ident_continue(); transition self.char_ok == 1 { true -> ident_advance() _ -> ident_done() } }
    state ident_advance() { self.pos = self.pos + 1; transition self.pos - self.tok_start <= 64 { true -> ident_loop() _ -> over() } }
    state ident_done() { self.tok = 256; self.tok_len = self.pos - self.tok_start; transition 0 { _ -> done() } }
    state digit0() { transition self.c >= 48 { true -> digit1() _ -> punctuation() } }
    state digit1() { transition self.c < 58 { true -> integer_begin() _ -> punctuation() } }
    state integer_begin() { self.int_value = 0; transition 0 { _ -> integer_loop() } }
    state integer_loop() { transition self.pos < self.limit { true -> integer_byte() _ -> integer_done() } }
    state integer_byte() { self.c = self.input[self.pos]; transition self.c >= 48 { true -> integer_high() _ -> integer_done() } }
    state integer_high() { transition self.c < 58 { true -> integer_bound() _ -> integer_done() } }
    state integer_bound() { transition self.int_value < 214748364 { true -> integer_add() _ -> integer_last() } }
    state integer_last() { transition self.int_value == 214748364 { true -> integer_last_digit() _ -> bad() } }
    state integer_last_digit() { transition self.c < 56 { true -> integer_add() _ -> bad() } }
    state integer_add() { self.int_value = self.int_value * 10 + self.c - 48; self.pos = self.pos + 1; transition 0 { _ -> integer_loop() } }
    state integer_done() { self.tok = 257; self.tok_len = self.pos - self.tok_start; transition 0 { _ -> done() } }
    state punctuation() { transition self.c < 128 { true -> punctuation_save() _ -> bad() } }
    state punctuation_save() { self.tok = self.c; self.tok_len = 1; self.pos = self.pos + 1; transition 0 { _ -> done() } }
    state eof() { self.tok = 0; self.tok_start = self.limit; transition 0 { _ -> done() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::init_words(&mut self) {
    // moduledatamachinemutselfu8u64boolinTrappingtransitiontruefalsestate
    self.words[0]=109; self.words[1]=111; self.words[2]=100; self.words[3]=117;
    self.words[4]=108; self.words[5]=101;
    self.words[6]=100; self.words[7]=97; self.words[8]=116; self.words[9]=97;
    self.words[10]=109; self.words[11]=97; self.words[12]=99; self.words[13]=104;
    self.words[14]=105; self.words[15]=110; self.words[16]=101;
    self.words[17]=109; self.words[18]=117; self.words[19]=116;
    self.words[20]=115; self.words[21]=101; self.words[22]=108; self.words[23]=102;
    self.words[24]=117; self.words[25]=56;
    self.words[26]=117; self.words[27]=54; self.words[28]=52;
    self.words[29]=98; self.words[30]=111; self.words[31]=111; self.words[32]=108;
    self.words[33]=105; self.words[34]=110;
    self.words[35]=84; self.words[36]=114; self.words[37]=97; self.words[38]=112;
    self.words[39]=112; self.words[40]=105; self.words[41]=110; self.words[42]=103;
    self.words[43]=116; self.words[44]=114; self.words[45]=97; self.words[46]=110;
    self.words[47]=115; self.words[48]=105; self.words[49]=116; self.words[50]=105;
    self.words[51]=111; self.words[52]=110;
    self.words[53]=116; self.words[54]=114; self.words[55]=117; self.words[56]=101;
    self.words[57]=102; self.words[58]=97; self.words[59]=108; self.words[60]=115; self.words[61]=101;
    self.words[62]=115; self.words[63]=116; self.words[64]=97; self.words[65]=116; self.words[66]=101;
    self.words[67]=117; self.words[68]=51; self.words[69]=50;
    self.words[70]=99; self.words[71]=111; self.words[72]=112; self.words[73]=121;
}

machine Main::token_word(&mut self, base: i32, count: i32) {
    self.match_ok = 0; self.i = 0;
    transition self.tok == 256 { true -> length() _ -> done() }
    state length() { transition self.tok_len == count { true -> loop() _ -> done() } }
    state loop() { transition self.i < count { true -> compare() _ -> yes() } }
    state compare() { transition self.input[self.tok_start + self.i] == self.words[base + self.i] { true -> advance() _ -> done() } }
    state advance() { self.i = self.i + 1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok = 1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::token_span_equal(&mut self, start: i32, count: i32) {
    self.match_ok = 0;
    transition self.tok == 256 { true -> length() _ -> done() }
    state length() { transition self.tok_len == count { true -> compare() _ -> done() } }
    state compare() { self.bytes_equal(self.tok_start, start, count); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_token(&mut self, expected: i32) {
    transition self.tok == expected { true -> advance() _ -> bad() }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_word(&mut self, base: i32, count: i32) {
    self.token_word(base, count);
    transition self.match_ok == 1 { true -> advance() _ -> bad() }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_span(&mut self, start: i32, count: i32) {
    self.token_span_equal(start, count);
    transition self.match_ok == 1 { true -> advance() _ -> bad() }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_type(&mut self) {
    self.result_kind = 0 - 1; self.result_payload = 0;
    self.result_span_start = 0; self.result_span_len = 0;
    transition self.tok == 91 { true -> array_open() _ -> scalar_u8() }
    state array_open() { self.next_token(); transition self.tok == 256 { true -> array_element() _ -> bad() } }
    state array_element() { self.result_span_start = self.tok_start; self.result_span_len = self.tok_len; self.next_token(); self.expect_token(59); transition self.status == 0 { true -> array_length() _ -> done() } }
    state array_length() { transition self.tok == 257 { true -> array_value() _ -> bad() } }
    state array_value() { self.result_payload = self.int_value; self.next_token(); self.expect_token(93); self.expect_word(33,2); self.expect_word(35,8); transition self.status == 0 { true -> array_bounds0() _ -> done() } }
    state array_bounds0() { transition self.result_payload >= 1 { true -> array_bounds1() _ -> bad() } }
    state array_bounds1() { transition self.result_payload <= 65536 { true -> array_yes() _ -> array_too_large() } }
    state array_too_large() { transition self.result_payload == 65537 { true -> bad() _ -> over() } }
    state array_yes() { self.result_kind = 4; transition 0 { _ -> done() } }
    state scalar_u8() { self.token_word(24,2); transition self.match_ok == 1 { true -> u8_yes() _ -> scalar_u32() } }
    state u8_yes() { self.result_kind = 1; self.next_token(); transition 0 { _ -> done() } }
    state scalar_u32() { self.token_word(67,3); transition self.match_ok == 1 { true -> u32_yes() _ -> scalar_bool() } }
    state u32_yes() { self.next_token(); self.expect_word(33,2); self.expect_word(35,8); transition self.status == 0 { true -> u32_policy_yes() _ -> done() } }
    state u32_policy_yes() { self.result_kind = 7; transition 0 { _ -> done() } }
    state scalar_bool() { self.token_word(29,4); transition self.match_ok == 1 { true -> bool_yes() _ -> scalar_u64() } }
    state bool_yes() { self.result_kind = 2; self.next_token(); transition 0 { _ -> done() } }
    state scalar_u64() { self.token_word(26,3); transition self.match_ok == 1 { true -> u64_begin() _ -> nominal() } }
    state u64_begin() { self.next_token(); transition self.tok == 91 { true -> range_open() _ -> u64_policy() } }
    state range_open() { self.next_token(); transition self.tok == 257 { true -> range_zero() _ -> bad() } }
    state range_zero() { transition self.int_value == 0 { true -> range_dot0() _ -> bad() } }
    state range_dot0() { self.next_token(); self.expect_token(46); self.expect_token(46); self.expect_token(61); transition self.status == 0 { true -> range_high() _ -> done() } }
    state range_high() { transition self.tok == 257 { true -> range_save() _ -> bad() } }
    state range_save() { self.result_payload = self.int_value; self.next_token(); self.expect_token(93); transition self.status == 0 { true -> range_yes() _ -> done() } }
    state range_yes() { self.result_kind = 3; transition 0 { _ -> done() } }
    state u64_policy() { self.expect_word(33,2); self.expect_word(35,8); transition self.status == 0 { true -> u64_yes() _ -> done() } }
    state u64_yes() { self.result_kind = 6; transition 0 { _ -> done() } }
    state nominal() { transition self.tok == 256 { true -> nominal_save() _ -> bad() } }
    state nominal_save() { self.result_kind = 5; self.result_span_start = self.tok_start; self.result_span_len = self.tok_len; self.next_token(); transition 0 { _ -> done() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::skip_balanced_body(&mut self) {
    self.result_span_start = self.tok_start - self.source_start; self.depth = 0;
    transition self.tok == 123 { true -> loop() _ -> bad() }
    state loop() {
        transition self.tok == 123 { true -> open() _ -> close_check() }
    }
    state open() { self.depth = self.depth + 1; self.next_token(); transition 0 { _ -> loop() } }
    state close_check() { transition self.tok == 125 { true -> close() _ -> eof_check() } }
    state close() { self.depth = self.depth - 1; self.x = self.tok_start + self.tok_len - self.source_start; self.next_token(); transition self.depth == 0 { true -> finish() _ -> loop() } }
    state eof_check() { transition self.tok == 0 { true -> bad() _ -> advance() } }
    state advance() { self.next_token(); transition 0 { _ -> loop() } }
    state finish() { self.result_span_len = self.x - self.result_span_start; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_data(&mut self) {
    transition self.data_count < 8 { true -> name() _ -> over() }
    state name() { transition self.tok == 256 { true -> save_name() _ -> bad() } }
    state save_name() {
        self.current_data = self.data_count;
        self.data_names[self.current_data] = self.tok_start - self.source_start;
        self.data_name_lens[self.current_data] = self.tok_len;
        self.data_field_starts[self.current_data] = self.field_count;
        self.data_field_counts[self.current_data] = 0;
        self.data_copy_flags[self.current_data]=0; self.next_token(); transition self.tok == 91 { true -> copy_open() _ -> open_body() }
    }
    state copy_open() { self.next_token(); self.expect_word(70,4); self.expect_token(93); self.data_copy_flags[self.current_data]=1; transition 0 { _ -> open_body() } }
    state open_body() { self.expect_token(123); transition self.status == 0 { true -> fields() _ -> done() } }
    state fields() { transition self.tok == 125 { true -> close() _ -> field_capacity() } }
    state field_capacity() { transition self.field_count < 32 { true -> field_name() _ -> over() } }
    state field_name() { transition self.tok == 256 { true -> field_save() _ -> bad() } }
    state field_save() {
        self.current_field = self.field_count; self.field_owners[self.current_field] = self.current_data;
        self.field_ordinals[self.current_field] = self.data_field_counts[self.current_data];
        self.field_names[self.current_field] = self.tok_start - self.source_start;
        self.field_name_lens[self.current_field] = self.tok_len;
        self.next_token(); self.expect_token(58); self.parse_type();
        transition self.status == 0 { true -> field_type() _ -> done() }
    }
    state field_type() {
        self.field_kinds[self.current_field] = self.result_kind; self.field_payloads[self.current_field] = self.result_payload;
        self.field_nominal_names[self.current_field] = self.result_span_start - self.source_start;
        self.field_nominal_lens[self.current_field] = self.result_span_len;
        self.expect_token(59); transition self.status == 0 { true -> field_next() _ -> done() }
    }
    state field_next() { self.field_count = self.field_count + 1; self.data_field_counts[self.current_data] = self.data_field_counts[self.current_data] + 1; transition 0 { _ -> fields() } }
    state close() { self.next_token(); self.data_count = self.data_count + 1; transition 0 { _ -> done() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_machine(&mut self) {
    transition self.machine_count < 8 { true -> owner() _ -> over() }
    state owner() { transition self.tok == 256 { true -> owner_save() _ -> bad() } }
    state owner_save() {
        self.current_machine = self.machine_count;
        self.machine_owner_names[self.current_machine] = self.tok_start - self.source_start;
        self.machine_owner_lens[self.current_machine] = self.tok_len;
        self.next_token(); self.expect_token(58); self.expect_token(58);
        transition self.status == 0 { true -> name() _ -> done() }
    }
    state name() { transition self.tok == 256 { true -> name_save() _ -> bad() } }
    state name_save() {
        self.machine_names[self.current_machine] = self.tok_start - self.source_start;
        self.machine_name_lens[self.current_machine] = self.tok_len;
        self.machine_param_starts[self.current_machine] = self.param_count;
        self.machine_param_counts[self.current_machine] = 0;
        self.machine_result_kinds[self.current_machine] = 0;
        self.machine_access[self.current_machine] = 1;
        self.next_token(); self.expect_token(40); self.expect_token(38);
        transition self.status == 0 { true -> receiver_mut() _ -> done() }
    }
    state receiver_mut() { self.token_word(17,3); transition self.match_ok == 1 { true -> receiver_mut_yes() _ -> receiver_self() } }
    state receiver_mut_yes() { self.machine_access[self.current_machine] = 2; self.next_token(); transition 0 { _ -> receiver_self() } }
    state receiver_self() { self.expect_word(20,4); transition self.status == 0 { true -> receiver_tail() _ -> done() } }
    state receiver_tail() { transition self.tok == 44 { true -> parameter_begin() _ -> close_params() } }
    state parameter_begin() { self.next_token(); transition self.param_count < 16 { true -> parameter_name() _ -> over() } }
    state parameter_name() { transition self.tok == 256 { true -> parameter_save() _ -> bad() } }
    state parameter_save() {
        self.current_param = self.param_count; self.param_owners[self.current_param] = self.current_machine;
        self.param_ordinals[self.current_param] = self.machine_param_counts[self.current_machine];
        self.param_names[self.current_param] = self.tok_start - self.source_start;
        self.param_name_lens[self.current_param] = self.tok_len;
        self.next_token(); self.expect_token(58); self.parse_type(); transition self.status == 0 { true -> parameter_type() _ -> done() }
    }
    state parameter_type() { self.param_kinds[self.current_param] = self.result_kind; self.param_count = self.param_count + 1; self.machine_param_counts[self.current_machine] = self.machine_param_counts[self.current_machine] + 1; transition self.tok == 44 { true -> parameter_begin() _ -> close_params() } }
    state close_params() { self.expect_token(41); transition self.status == 0 { true -> result_arrow() _ -> done() } }
    state result_arrow() { transition self.tok == 45 { true -> arrow_dash() _ -> body() } }
    state arrow_dash() { self.next_token(); self.expect_token(62); self.parse_type(); self.machine_result_kinds[self.current_machine] = self.result_kind; transition self.status == 0 { true -> body() _ -> done() } }
    state body() {
        self.skip_balanced_body();
        self.machine_body_starts[self.current_machine] = self.result_span_start;
        self.machine_body_lengths[self.current_machine] = self.result_span_len;
        transition self.status == 0 { true -> next_machine() _ -> done() }
    }
    state next_machine() { self.machine_count = self.machine_count + 1; transition 0 { _ -> done() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_source(&mut self) {
    self.pos = self.source_start; self.limit = self.source_start + self.source_length;
    self.data_count = 0; self.field_count = 0; self.machine_count = 0; self.param_count = 0;
    self.next_token(); self.expect_word(0,6); transition self.status == 0 { true -> module_name() _ -> done() }
    state module_name() { transition self.tok == 256 { true -> module_match() _ -> bad() } }
    state module_match() { self.bytes_equal(self.tok_start, self.module_string_start, self.tok_len); transition self.match_ok == 1 { true -> module_length() _ -> bad() } }
    state module_length() { transition self.tok_len == self.module_string_len { true -> module_tail() _ -> bad() } }
    state module_tail() { self.next_token(); self.expect_token(59); transition self.status == 0 { true -> declarations() _ -> done() } }
    state declarations() { transition self.tok == 0 { true -> done() _ -> data_check() } }
    state data_check() { self.token_word(6,4); transition self.match_ok == 1 { true -> data_begin() _ -> machine_check() } }
    state data_begin() { self.next_token(); self.parse_data(); transition self.status == 0 { true -> declarations() _ -> done() } }
    state machine_check() { self.token_word(10,7); transition self.match_ok == 1 { true -> machine_begin() _ -> bad() } }
    state machine_begin() { self.next_token(); self.parse_machine(); transition self.status == 0 { true -> declarations() _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::field_name_is_token(&mut self, field: i32) {
    self.token_span_equal(self.source_start + self.field_names[field], self.field_name_lens[field]);
}

machine Main::machine_name_is_token(&mut self, machine: i32) {
    self.token_span_equal(self.source_start + self.machine_names[machine], self.machine_name_lens[machine]);
}

machine Main::owner_names_data(&mut self, machine: i32, data_id: i32) {
    self.match_ok = 0;
    transition self.machine_owner_lens[machine] == self.data_name_lens[data_id] { true -> compare() _ -> done() }
    state compare() { self.stored_spans_equal(self.machine_owner_names[machine], self.data_names[data_id], self.machine_owner_lens[machine]); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::nominal_names_data(&mut self, field: i32, data_id: i32) {
    self.match_ok = 0;
    transition self.field_nominal_lens[field] == self.data_name_lens[data_id] { true -> compare() _ -> done() }
    state compare() { self.stored_spans_equal(self.field_nominal_names[field], self.data_names[data_id], self.field_nominal_lens[field]); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::find_observation_record(&mut self) {
    self.observation_data=0-1; self.scan_data=0; transition 0 { _ -> data_loop() }
    state data_loop() { transition self.scan_data < self.data_count { true -> begin_fields() _ -> complete() } }
    state begin_fields() { self.scan_field=self.data_field_starts[self.scan_data]; self.scan_end=self.scan_field+self.data_field_counts[self.scan_data]; self.x=0; self.y=0; self.k=0; self.j=0; transition 0 { _ -> field_loop() } }
    state field_loop() { transition self.scan_field < self.scan_end { true -> kind_u8() _ -> candidate() } }
    state kind_u8() { transition self.field_kinds[self.scan_field] == 1 { true -> add_u8() _ -> kind_u32() } }
    state add_u8() { self.x=self.x+1; transition 0 { _ -> next_field() } }
    state kind_u32() { transition self.field_kinds[self.scan_field] == 7 { true -> add_u32() _ -> kind_u64() } }
    state add_u32() { self.y=self.y+1; transition 0 { _ -> next_field() } }
    state kind_u64() { transition self.field_kinds[self.scan_field] == 6 { true -> add_u64() _ -> mark_other() } }
    state add_u64() { self.k=self.k+1; transition 0 { _ -> next_field() } }
    state mark_other() { self.j=1; transition 0 { _ -> next_field() } }
    state next_field() { self.scan_field=self.scan_field+1; transition 0 { _ -> field_loop() } }
    state candidate() { transition self.x == 4 { true -> candidate_u32() _ -> data_next() } }
    state candidate_u32() { transition self.y == 1 { true -> candidate_u64() _ -> data_next() } }
    state candidate_u64() { transition self.k == 4 { true -> candidate_other() _ -> data_next() } }
    state candidate_other() { transition self.j == 0 { true -> candidate_copy() _ -> data_next() } }
    state candidate_copy() { transition self.data_copy_flags[self.scan_data] == 1 { true -> unique() _ -> data_next() } }
    state unique() { transition self.observation_data < 0 { true -> save() _ -> bad() } }
    state save() { self.observation_data=self.scan_data; transition 0 { _ -> data_next() } }
    state data_next() { self.scan_data=self.scan_data+1; transition 0 { _ -> data_loop() } }
    state complete() { transition self.observation_data >= 0 { true -> save_fields() _ -> bad() } }
    state save_fields() { self.i=0; self.scan_field=self.data_field_starts[self.observation_data]; transition 0 { _ -> save_loop() } }
    state save_loop() { transition self.i < 9 { true -> save_one() _ -> done() } }
    state save_one() { self.observation_fields[self.i]=self.scan_field; self.i=self.i+1; self.scan_field=self.scan_field+1; transition 0 { _ -> save_loop() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::find_stream_record(&mut self) {
    self.stream_data=0-1; self.scan_data=0; transition 0 { _ -> data_loop() }
    state data_loop() { transition self.scan_data < self.data_count { true -> not_observation() _ -> complete() } }
    state not_observation() { transition self.scan_data == self.observation_data { true -> data_next() _ -> begin_fields() } }
    state begin_fields() { self.scan_field=self.data_field_starts[self.scan_data]; self.scan_end=self.scan_field+self.data_field_counts[self.scan_data]; self.x=0-1; self.y=0-1; self.k=0-1; transition 0 { _ -> field_loop() } }
    state field_loop() { transition self.scan_field < self.scan_end { true -> array_check() _ -> candidate() } }
    state array_check() { transition self.field_kinds[self.scan_field] == 4 { true -> array_nominal() _ -> count_check() } }
    state array_nominal() { self.nominal_names_data(self.scan_field,self.observation_data); transition self.match_ok == 1 { true -> array_n() _ -> next_field() } }
    state array_n() { transition self.field_payloads[self.scan_field] == 16384 { true -> array_unique() _ -> bad() } }
    state array_unique() { transition self.x < 0 { true -> array_save() _ -> bad() } }
    state array_save() { self.x=self.scan_field; transition 0 { _ -> next_field() } }
    state count_check() { transition self.field_kinds[self.scan_field] == 3 { true -> count_n() _ -> bool_check() } }
    state count_n() { transition self.field_payloads[self.scan_field] == 16384 { true -> count_unique() _ -> next_field() } }
    state count_unique() { transition self.y < 0 { true -> count_save() _ -> bad() } }
    state count_save() { self.y=self.scan_field; transition 0 { _ -> next_field() } }
    state bool_check() { transition self.field_kinds[self.scan_field] == 2 { true -> bool_unique() _ -> next_field() } }
    state bool_unique() { transition self.k < 0 { true -> bool_save() _ -> bad() } }
    state bool_save() { self.k=self.scan_field; transition 0 { _ -> next_field() } }
    state next_field() { self.scan_field=self.scan_field+1; transition 0 { _ -> field_loop() } }
    state candidate() { transition self.x >= 0 { true -> candidate_count() _ -> data_next() } }
    state candidate_count() { transition self.y >= 0 { true -> candidate_bool() _ -> data_next() } }
    state candidate_bool() { transition self.k >= 0 { true -> candidate_noncopy() _ -> data_next() } }
    state candidate_noncopy() { transition self.data_copy_flags[self.scan_data] == 0 { true -> unique() _ -> data_next() } }
    state unique() { transition self.stream_data < 0 { true -> save() _ -> bad() } }
    state save() { self.stream_data=self.scan_data; self.rows_field=self.x; self.count_field=self.y; self.retained_field=self.k; self.array_n=16384; transition 0 { _ -> data_next() } }
    state data_next() { self.scan_data=self.scan_data+1; transition 0 { _ -> data_loop() } }
    state complete() { transition self.stream_data >= 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::find_root_record(&mut self) {
    self.root_data=0-1; self.stream_field=0-1; self.scan_data=0; transition 0 { _ -> data_loop() }
    state data_loop() { transition self.scan_data < self.data_count { true -> excluded() _ -> complete() } }
    state excluded() { transition self.scan_data == self.observation_data { true -> data_next() _ -> stream_excluded() } }
    state stream_excluded() { transition self.scan_data == self.stream_data { true -> data_next() _ -> fields_begin() } }
    state fields_begin() { self.scan_field=self.data_field_starts[self.scan_data]; self.scan_end=self.scan_field+self.data_field_counts[self.scan_data]; self.x=0-1; transition 0 { _ -> fields() } }
    state fields() { transition self.scan_field < self.scan_end { true -> nominal() _ -> candidate() } }
    state nominal() { transition self.field_kinds[self.scan_field] == 5 { true -> match_stream() _ -> next_field() } }
    state match_stream() { self.nominal_names_data(self.scan_field,self.stream_data); transition self.match_ok == 1 { true -> unique_field() _ -> next_field() } }
    state unique_field() { transition self.x < 0 { true -> save_field() _ -> bad() } }
    state save_field() { self.x=self.scan_field; transition 0 { _ -> next_field() } }
    state next_field() { self.scan_field=self.scan_field+1; transition 0 { _ -> fields() } }
    state candidate() { transition self.x >= 0 { true -> candidate_noncopy() _ -> data_next() } }
    state candidate_noncopy() { transition self.data_copy_flags[self.scan_data] == 0 { true -> unique_root() _ -> data_next() } }
    state unique_root() { transition self.root_data < 0 { true -> save_root() _ -> bad() } }
    state save_root() { self.root_data=self.scan_data; self.stream_field=self.x; transition 0 { _ -> data_next() } }
    state data_next() { self.scan_data=self.scan_data+1; transition 0 { _ -> data_loop() } }
    state complete() { transition self.root_data >= 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::classify_machines(&mut self) {
    self.push_machine=0-1; self.lookup_machine=0-1; self.run_machine=0-1; self.scan_machine=0; transition 0 { _ -> loop() }
    state loop() { transition self.scan_machine < self.machine_count { true -> stream_owner() _ -> complete() } }
    state stream_owner() { self.owner_names_data(self.scan_machine,self.stream_data); transition self.match_ok == 1 { true -> stream_signature() _ -> root_owner() } }
    state stream_signature() { transition self.machine_param_counts[self.scan_machine] == 9 { true -> push_access() _ -> lookup_count() } }
    state push_access() { transition self.machine_access[self.scan_machine] == 2 { true -> push_result() _ -> bad() } }
    state push_result() { transition self.machine_result_kinds[self.scan_machine] == 0 { true -> push_types() _ -> bad() } }
    state push_types() { self.i=0; self.x=0; self.y=0; self.k=0; self.current_param=self.machine_param_starts[self.scan_machine]; transition 0 { _ -> push_type_loop() } }
    state push_type_loop() { transition self.i < 9 { true -> push_type_one() _ -> push_counts() } }
    state push_type_one() { self.push_params[self.i]=self.current_param; transition self.param_kinds[self.current_param] == 1 { true -> push_u8() _ -> push_u32_check() } }
    state push_u8() { self.x=self.x+1; transition 0 { _ -> push_next() } }
    state push_u32_check() { transition self.param_kinds[self.current_param] == 7 { true -> push_u32() _ -> push_u64_check() } }
    state push_u32() { self.y=self.y+1; transition 0 { _ -> push_next() } }
    state push_u64_check() { transition self.param_kinds[self.current_param] == 6 { true -> push_u64() _ -> bad() } }
    state push_u64() { self.k=self.k+1; transition 0 { _ -> push_next() } }
    state push_next() { self.i=self.i+1; self.current_param=self.current_param+1; transition 0 { _ -> push_type_loop() } }
    state push_counts() { transition self.x == 4 { true -> push_count_u32() _ -> bad() } }
    state push_count_u32() { transition self.y == 1 { true -> push_count_u64() _ -> bad() } }
    state push_count_u64() { transition self.k == 4 { true -> push_unique() _ -> bad() } }
    state push_unique() { transition self.push_machine < 0 { true -> push_save() _ -> bad() } }
    state push_save() { self.push_machine=self.scan_machine; transition 0 { _ -> next() } }
    state lookup_count() { transition self.machine_param_counts[self.scan_machine] == 1 { true -> lookup_param() _ -> bad() } }
    state lookup_param() { self.current_param=self.machine_param_starts[self.scan_machine]; transition self.param_kinds[self.current_param] == 6 { true -> lookup_access() _ -> bad() } }
    state lookup_access() { transition self.machine_access[self.scan_machine] == 1 { true -> lookup_result() _ -> bad() } }
    state lookup_result() { transition self.machine_result_kinds[self.scan_machine] == 1 { true -> lookup_unique() _ -> bad() } }
    state lookup_unique() { transition self.lookup_machine < 0 { true -> lookup_save() _ -> bad() } }
    state lookup_save() { self.lookup_machine=self.scan_machine; self.index_param=self.current_param; transition 0 { _ -> next() } }
    state root_owner() { self.owner_names_data(self.scan_machine,self.root_data); transition self.match_ok == 1 { true -> run_signature() _ -> bad() } }
    state run_signature() { transition self.machine_param_counts[self.scan_machine] == 0 { true -> run_access() _ -> bad() } }
    state run_access() { transition self.machine_access[self.scan_machine] == 2 { true -> run_result() _ -> bad() } }
    state run_result() { transition self.machine_result_kinds[self.scan_machine] == 1 { true -> run_unique() _ -> bad() } }
    state run_unique() { transition self.run_machine < 0 { true -> run_save() _ -> bad() } }
    state run_save() { self.run_machine=self.scan_machine; transition 0 { _ -> next() } }
    state next() { self.scan_machine=self.scan_machine+1; transition 0 { _ -> loop() } }
    state complete() { transition self.machine_count == 3 { true -> all_push() _ -> bad() } }
    state all_push() { transition self.push_machine >= 0 { true -> all_lookup() _ -> bad() } }
    state all_lookup() { transition self.lookup_machine >= 0 { true -> all_run() _ -> bad() } }
    state all_run() { transition self.run_machine >= 0 { true -> root_owner_name() _ -> bad() } }
    state root_owner_name() { transition self.data_name_lens[self.root_data] == self.root_owner_len { true -> root_owner_compare() _ -> bad() } }
    state root_owner_compare() { self.bytes_equal(self.source_start+self.data_names[self.root_data],self.root_owner_start,self.root_owner_len); transition self.match_ok == 1 { true -> root_machine_name() _ -> bad() } }
    state root_machine_name() { transition self.machine_name_lens[self.run_machine] == self.root_machine_len { true -> root_machine_compare() _ -> bad() } }
    state root_machine_compare() { self.bytes_equal(self.source_start+self.machine_names[self.run_machine],self.root_machine_start,self.root_machine_len); transition self.match_ok == 1 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::begin_machine_body(&mut self, machine: i32) {
    self.pos=self.source_start+self.machine_body_starts[machine]; self.limit=self.pos+self.machine_body_lengths[machine];
    self.next_token(); self.expect_token(123);
}

machine Main::expect_self_field(&mut self, field: i32) {
    self.expect_word(20,4); self.expect_token(46); transition self.status == 0 { true -> field_name() _ -> done() }
    state field_name() { self.field_name_is_token(field); transition self.match_ok == 1 { true -> advance() _ -> bad() } }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_parameter(&mut self, parameter: i32) {
    self.token_span_equal(self.source_start+self.param_names[parameter],self.param_name_lens[parameter]);
    transition self.match_ok == 1 { true -> advance() _ -> bad() }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_integer(&mut self, value: i32) {
    transition self.tok == 257 { true -> exact() _ -> bad() }
    state exact() { transition self.int_value == value { true -> advance() _ -> bad() } }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_arrow(&mut self) { self.expect_token(45); self.expect_token(62); }

machine Main::expect_underscore(&mut self) {
    transition self.tok == 256 { true -> length() _ -> bad() }
    state length() { transition self.tok_len == 1 { true -> byte() _ -> bad() } }
    state byte() { transition self.input[self.tok_start] == 95 { true -> advance() _ -> bad() } }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::capture_target_name(&mut self, slot: i32) {
    transition self.tok == 256 { true -> save() _ -> bad() }
    state save() { self.block_name_starts[slot]=self.tok_start-self.source_start; self.block_name_lens[slot]=self.tok_len; self.next_token(); self.expect_token(40); self.expect_token(41); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::capture_state(&mut self, base_slot: i32, access: i32) {
    self.expect_word(62,5); transition self.status == 0 { true -> name() _ -> done() }
    state name() { transition self.tok == 256 { true -> save_name() _ -> bad() } }
    state save_name() { self.saved_name_start=self.tok_start-self.source_start; self.saved_name_len=self.tok_len; self.next_token(); self.expect_token(40); self.expect_token(38); transition self.status == 0 { true -> mut_check() _ -> done() } }
    state mut_check() { transition access == 2 { true -> mut_word() _ -> self_word() } }
    state mut_word() { self.expect_word(17,3); transition 0 { _ -> self_word() } }
    state self_word() { self.expect_word(20,4); self.expect_token(41); transition self.status == 0 { true -> body() _ -> done() } }
    state body() { self.skip_balanced_body(); transition self.status == 0 { true -> target0_length() _ -> done() } }
    state target0_length() { transition self.saved_name_len == self.block_name_lens[base_slot] { true -> target0_compare() _ -> target1_length() } }
    state target0_compare() { self.stored_spans_equal(self.saved_name_start,self.block_name_starts[base_slot],self.saved_name_len); transition self.match_ok == 1 { true -> target0_unique() _ -> target1_length() } }
    state target0_unique() { transition self.block_body_lengths[base_slot] == 0 { true -> target0_save() _ -> bad() } }
    state target0_save() { self.block_name_starts[base_slot]=self.saved_name_start; self.block_name_lens[base_slot]=self.saved_name_len; self.block_body_starts[base_slot]=self.result_span_start; self.block_body_lengths[base_slot]=self.result_span_len; self.block_source_ordinals[base_slot]=self.current_data; transition 0 { _ -> done() } }
    state target1_length() { transition self.saved_name_len == self.block_name_lens[base_slot+1] { true -> target1_compare() _ -> bad() } }
    state target1_compare() { self.stored_spans_equal(self.saved_name_start,self.block_name_starts[base_slot+1],self.saved_name_len); transition self.match_ok == 1 { true -> target1_unique() _ -> bad() } }
    state target1_unique() { transition self.block_body_lengths[base_slot+1] == 0 { true -> target1_save() _ -> bad() } }
    state target1_save() { self.block_name_starts[base_slot+1]=self.saved_name_start; self.block_name_lens[base_slot+1]=self.saved_name_len; self.block_body_starts[base_slot+1]=self.result_span_start; self.block_body_lengths[base_slot+1]=self.result_span_len; self.block_source_ordinals[base_slot+1]=self.current_data; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::begin_selected_block(&mut self, slot: i32) {
    self.pos=self.source_start+self.block_body_starts[slot]; self.limit=self.pos+self.block_body_lengths[slot]; self.next_token(); self.expect_token(123);
}

machine Main::find_current_observation_field(&mut self) {
    self.result_payload=0-1; self.j=0; transition 0 { _ -> loop() }
    state loop() { transition self.j < 9 { true -> compare() _ -> complete() } }
    state compare() { self.current_field=self.observation_fields[self.j]; self.field_name_is_token(self.current_field); transition self.match_ok == 1 { true -> unique() _ -> next() } }
    state unique() { transition self.result_payload < 0 { true -> save() _ -> bad() } }
    state save() { self.result_payload=self.current_field; transition 0 { _ -> next() } }
    state next() { self.j=self.j+1; transition 0 { _ -> loop() } }
    state complete() { transition self.result_payload >= 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::find_current_push_parameter(&mut self) {
    self.result_payload=0-1; self.j=0; transition 0 { _ -> loop() }
    state loop() { transition self.j < 9 { true -> compare() _ -> complete() } }
    state compare() { self.current_param=self.push_params[self.j]; self.token_span_equal(self.source_start+self.param_names[self.current_param],self.param_name_lens[self.current_param]); transition self.match_ok == 1 { true -> unique() _ -> next() } }
    state unique() { transition self.result_payload < 0 { true -> save() _ -> bad() } }
    state save() { self.result_payload=self.current_param; transition 0 { _ -> next() } }
    state next() { self.j=self.j+1; transition 0 { _ -> loop() } }
    state complete() { transition self.result_payload >= 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_push_body(&mut self) {
    self.begin_machine_body(self.push_machine);
    self.expect_self_field(self.retained_field); self.expect_token(61); self.expect_word(57,5); self.expect_token(59);
    self.expect_word(43,10); self.expect_self_field(self.count_field); self.expect_token(60); self.expect_integer(self.array_n);
    self.expect_token(123); self.expect_word(53,4); self.expect_arrow(); self.capture_target_name(0);
    self.expect_underscore(); self.expect_arrow(); self.capture_target_name(1); self.expect_token(125);
    transition self.status == 0 { true -> distinct() _ -> done() }
    state distinct() { transition self.block_name_lens[0] == self.block_name_lens[1] { true -> distinct_compare() _ -> states_begin() } }
    state distinct_compare() { self.stored_spans_equal(self.block_name_starts[0],self.block_name_starts[1],self.block_name_lens[0]); transition self.match_ok == 1 { true -> bad() _ -> states_begin() } }
    state states_begin() { self.current_data=0; transition 0 { _ -> states_loop() } }
    state states_loop() { transition self.current_data < 2 { true -> state_one() _ -> outer_close() } }
    state state_one() { self.capture_state(0,2); self.current_data=self.current_data+1; transition self.status == 0 { true -> states_loop() _ -> done() } }
    state outer_close() { self.expect_token(125); transition self.status == 0 { true -> exact() _ -> done() } }
    state exact() { transition self.tok == 0 { true -> complete0() _ -> bad() } }
    state complete0() { transition self.block_body_lengths[0] > 0 { true -> complete1() _ -> bad() } }
    state complete1() { transition self.block_body_lengths[1] > 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_push_store(&mut self, slot: i32) {
    self.expect_self_field(self.rows_field); self.expect_token(91); self.expect_self_field(self.count_field); self.expect_token(93); self.expect_token(46);
    transition self.status == 0 { true -> field() _ -> done() }
    state field() { self.find_current_observation_field(); self.x=self.result_payload; transition self.status == 0 { true -> field_advance() _ -> done() } }
    state field_advance() { self.next_token(); self.expect_token(61); transition self.status == 0 { true -> parameter() _ -> done() } }
    state parameter() { self.find_current_push_parameter(); self.y=self.result_payload; transition self.status == 0 { true -> type_match() _ -> done() } }
    state type_match() { transition self.field_kinds[self.x] == self.param_kinds[self.y] { true -> unused_field() _ -> bad() } }
    state unused_field() { self.i=0; transition 0 { _ -> unused_loop() } }
    state unused_loop() { transition self.i < slot { true -> unused_compare() _ -> save() } }
    state unused_compare() { transition self.store_fields[self.i] == self.x { true -> bad() _ -> unused_param() } }
    state unused_param() { transition self.store_params[self.i] == self.y { true -> bad() _ -> unused_next() } }
    state unused_next() { self.i=self.i+1; transition 0 { _ -> unused_loop() } }
    state save() { self.store_fields[slot]=self.x; self.store_params[slot]=self.y; self.next_token(); self.expect_token(59); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_push_retain(&mut self) {
    self.begin_selected_block(0); self.current_data=0; transition 0 { _ -> stores() }
    state stores() { transition self.current_data < 9 { true -> one() _ -> increment() } }
    state one() { self.parse_push_store(self.current_data); self.current_data=self.current_data+1; transition self.status == 0 { true -> stores() _ -> done() } }
    state increment() { self.expect_self_field(self.count_field); self.expect_token(61); self.expect_self_field(self.count_field); self.expect_token(43); self.expect_integer(1); self.expect_token(59); transition self.status == 0 { true -> retained() _ -> done() } }
    state retained() { self.expect_self_field(self.retained_field); self.expect_token(61); self.expect_word(53,4); self.expect_token(59); self.expect_token(125); transition self.status == 0 { true -> exact() _ -> done() } }
    state exact() { transition self.tok == 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_push_full(&mut self) {
    self.begin_selected_block(1); self.expect_self_field(self.retained_field); self.expect_token(61); self.expect_word(57,5); self.expect_token(59); self.expect_token(125);
    transition self.status == 0 { true -> exact() _ -> done() }
    state exact() { transition self.tok == 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_lookup_body(&mut self) {
    self.begin_machine_body(self.lookup_machine); self.expect_word(43,10); self.expect_parameter(self.index_param); self.expect_token(60); self.expect_self_field(self.count_field);
    self.expect_token(123); self.expect_word(53,4); self.expect_arrow(); self.capture_target_name(2); self.expect_underscore(); self.expect_arrow(); self.capture_target_name(3); self.expect_token(125);
    transition self.status == 0 { true -> distinct() _ -> done() }
    state distinct() { transition self.block_name_lens[2] == self.block_name_lens[3] { true -> distinct_compare() _ -> states_begin() } }
    state distinct_compare() { self.stored_spans_equal(self.block_name_starts[2],self.block_name_starts[3],self.block_name_lens[2]); transition self.match_ok == 1 { true -> bad() _ -> states_begin() } }
    state states_begin() { self.current_data=0; transition 0 { _ -> states_loop() } }
    state states_loop() { transition self.current_data < 2 { true -> state_one() _ -> outer_close() } }
    state state_one() { self.capture_state(2,1); self.current_data=self.current_data+1; transition self.status == 0 { true -> states_loop() _ -> done() } }
    state outer_close() { self.expect_token(125); transition self.status == 0 { true -> exact() _ -> done() } }
    state exact() { transition self.tok == 0 { true -> complete0() _ -> bad() } }
    state complete0() { transition self.block_body_lengths[2] > 0 { true -> complete1() _ -> bad() } }
    state complete1() { transition self.block_body_lengths[3] > 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_lookup_retain(&mut self) {
    self.begin_selected_block(2); self.expect_self_field(self.rows_field); self.expect_token(91); self.expect_parameter(self.index_param); self.expect_token(93); self.expect_token(46);
    transition self.status == 0 { true -> field() _ -> done() }
    state field() { self.find_current_observation_field(); self.read_field=self.result_payload; transition self.status == 0 { true -> field_u8() _ -> done() } }
    state field_u8() { transition self.field_kinds[self.read_field] == 1 { true -> advance() _ -> bad() } }
    state advance() { self.next_token(); self.expect_token(125); transition self.status == 0 { true -> exact() _ -> done() } }
    state exact() { transition self.tok == 0 { true -> find_store() _ -> bad() } }
    state find_store() { self.i=0; self.read_argument_ordinal=0-1; transition 0 { _ -> find_loop() } }
    state find_loop() { transition self.i < 9 { true -> find_compare() _ -> find_complete() } }
    state find_compare() { transition self.store_fields[self.i] == self.read_field { true -> find_save() _ -> find_next() } }
    state find_save() { self.read_argument_ordinal=self.param_ordinals[self.store_params[self.i]]; transition 0 { _ -> find_next() } }
    state find_next() { self.i=self.i+1; transition 0 { _ -> find_loop() } }
    state find_complete() { transition self.read_argument_ordinal >= 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_lookup_absent(&mut self) {
    self.begin_selected_block(3); self.expect_integer(0); self.expect_token(125); transition self.status == 0 { true -> exact() _ -> done() }
    state exact() { transition self.tok == 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::begin_call(&mut self, slot: i32, target: i32) {
    self.expect_self_field(self.stream_field); self.expect_token(46); transition self.status == 0 { true -> target_name() _ -> done() }
    state target_name() { self.machine_name_is_token(target); transition self.match_ok == 1 { true -> save() _ -> bad() } }
    state save() { self.call_starts[slot]=self.tok_start-self.source_start; self.next_token(); self.expect_token(40); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::finish_call(&mut self, slot: i32, arguments: i32) {
    transition self.tok == 41 { true -> save() _ -> bad() }
    state save() { self.call_lengths[slot]=self.tok_start+self.tok_len-self.source_start-self.call_starts[slot]; self.call_argument_counts[slot]=arguments; self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_run_argument(&mut self, ordinal: i32) {
    transition self.tok == 257 { true -> kind() _ -> bad() }
    state kind() { self.current_param=self.push_params[ordinal]; transition self.param_kinds[self.current_param] == 1 { true -> u8_bound() _ -> u32_check() } }
    state u8_bound() { transition self.int_value <= 255 { true -> readback_check() _ -> bad() } }
    state u32_check() { transition self.param_kinds[self.current_param] == 7 { true -> readback_check() _ -> u64_check() } }
    state u64_check() { transition self.param_kinds[self.current_param] == 6 { true -> readback_check() _ -> bad() } }
    state readback_check() { transition ordinal == self.read_argument_ordinal { true -> readback_value() _ -> ordinal_value() } }
    state readback_value() { transition self.int_value == 70 { true -> save() _ -> bad() } }
    state ordinal_value() { transition self.int_value == ordinal { true -> save() _ -> bad() } }
    state save() { self.argument_values[ordinal]=self.int_value; self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_run_body(&mut self) {
    self.begin_machine_body(self.run_machine); self.begin_call(0,self.push_machine); self.i=0; transition self.status == 0 { true -> args() _ -> done() }
    state args() { transition self.i < 9 { true -> arg() _ -> push_end() } }
    state arg() { self.parse_run_argument(self.i); self.i=self.i+1; transition self.status == 0 { true -> arg_separator() _ -> done() } }
    state arg_separator() { transition self.i < 9 { true -> comma() _ -> args() } }
    state comma() { self.expect_token(44); transition 0 { _ -> args() } }
    state push_end() { self.finish_call(0,9); self.expect_token(59); self.begin_call(1,self.lookup_machine); self.expect_integer(0); self.finish_call(1,1); transition self.status == 0 { true -> close() _ -> done() } }
    state close() { self.expect_token(125); transition self.status == 0 { true -> exact() _ -> done() } }
    state exact() { transition self.tok == 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_relation(&mut self) {
    self.find_observation_record(); transition self.status == 0 { true -> stream() _ -> done() }
    state stream() { self.find_stream_record(); transition self.status == 0 { true -> root() _ -> done() } }
    state root() { self.find_root_record(); transition self.status == 0 { true -> machines() _ -> done() } }
    state machines() { self.classify_machines(); transition self.status == 0 { true -> push_body() _ -> done() } }
    state push_body() { self.parse_push_body(); transition self.status == 0 { true -> push_retain() _ -> done() } }
    state push_retain() { self.parse_push_retain(); transition self.status == 0 { true -> push_full() _ -> done() } }
    state push_full() { self.parse_push_full(); transition self.status == 0 { true -> lookup_body() _ -> done() } }
    state lookup_body() { self.parse_lookup_body(); transition self.status == 0 { true -> lookup_retain() _ -> done() } }
    state lookup_retain() { self.parse_lookup_retain(); transition self.status == 0 { true -> lookup_absent() _ -> done() } }
    state lookup_absent() { self.parse_lookup_absent(); transition self.status == 0 { true -> run_body() _ -> done() } }
    state run_body() { self.parse_run_body(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::clear_publication(&mut self) {
    self.i=0; transition 0 { _ -> loop() }
    state loop() { transition self.i < 539 { true -> one() _ -> done() } }
    state one() { self.publication[self.i]=0; self.i=self.i+1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::set_type_row(&mut self, row: i32, kind: i32, flags: i32) {
    self.i=41+row*8; self.publication[self.i]=row; self.publication[self.i+1]=kind+flags*256;
}

machine Main::fill_type_rows(&mut self) {
    self.set_type_row(0,0,0); self.set_type_row(1,1,0); self.publication[41+1*8+6]=255;
    self.set_type_row(2,2,1); self.publication[41+2*8+6]=-1;
    self.set_type_row(3,3,0); self.publication[41+3*8+6]=1;
    self.set_type_row(4,10,1); self.publication[41+4*8+6]=-1; self.publication[41+4*8+7]=-1;
    self.set_type_row(5,10,0); self.publication[41+5*8+6]=16384;
    self.set_type_row(6,5,1); self.publication[41+6*8+2]=7; self.publication[41+6*8+3]=16384;
    self.set_type_row(7,4,0); self.publication[41+7*8+2]=0;
    self.set_type_row(8,4,0); self.publication[41+8*8+2]=1;
    self.set_type_row(9,4,0); self.publication[41+9*8+2]=2;
