// Focused OMGLOWJ19 (OMGCOMP1 + OMGRSWA) -> CKIR18 lowerer.  The selected
// semantic witness is validated and paired to its source spans before any
// checked-IR byte is published.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
    machine write_byte(byte: i32);
}

data Main {
    console: Console;
    status: i32; c: i32; n: i32; i: i32; j: i32; x: i32; y: i32;
    decoded: i32; total: i32; comp_n: i32; witness_n: i32;
    comp: i32; witness: i32; bundle: i32; bundle_length: i32;
    string_length: i32; source_start: i32; source_length: i32;
    buffer_n: i32; at: i32; row: i32; start: i32; count: i32; word: i32;
    match_ok: i32; char_ok: i32;
    input: [u8; 268689];
    publication: [i32; 977];
}

machine Main::reject(&mut self) {
    transition self.status == 0 { true -> set_status() _ -> done() }
    state set_status() { self.status=251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::exhaust(&mut self) {
    transition self.status == 0 { true -> set_status() _ -> done() }
    state set_status() { self.status=252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::slurp(&mut self) {
    self.n=0; transition 0 { _ -> read_next() }
    state read_next() { self.c=read_byte(); transition self.c < 0 { true -> done() _ -> room() } }
    state room() { transition self.n < 268689 { true -> store() _ -> over() } }
    state store() { self.input[self.n]=self.c; self.n=self.n+1; transition self.n > 268688 { true -> over() _ -> read_next() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_u32(&mut self, position: i32) {
    self.decoded=0-1;
    transition position >= 0 { true -> room() _ -> bad() }
    state room() { transition position <= self.n-4 { true -> signed() _ -> bad() } }
    state signed() { transition self.input[position+3] < 128 { true -> value() _ -> bad() } }
    state value() {
        self.decoded=self.input[position]+self.input[position+1]*256
            +self.input[position+2]*65536+self.input[position+3]*16777216;
        transition 0 { _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_u32(&mut self, position: i32, value: i32) {
    self.read_u32(position); transition self.status == 0 { true -> equal() _ -> done() }
    state equal() { transition self.decoded == value { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_byte(&mut self, position: i32, value: i32) {
    transition position >= 0 { true -> room() _ -> bad() }
    state room() { transition position < self.n { true -> equal() _ -> bad() } }
    state equal() { transition self.input[position] == value { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_no_id(&mut self, position: i32) {
    self.expect_byte(position,255); self.expect_byte(position+1,255);
    self.expect_byte(position+2,255); self.expect_byte(position+3,255);
}

machine Main::validate_outer(&mut self) {
    transition self.n >= 32 { true -> magic() _ -> bad() }
    state magic() {
        self.expect_byte(0,79); self.expect_byte(1,77); self.expect_byte(2,71);
        self.expect_byte(3,76); self.expect_byte(4,79); self.expect_byte(5,87);
        self.expect_byte(6,74); self.expect_byte(7,0);
        transition self.status == 0 { true -> fixed() _ -> done() }
    }
    state fixed() {
        self.expect_byte(8,19); self.expect_byte(9,0); self.expect_byte(10,0);
        self.expect_byte(11,0); self.expect_byte(12,0); self.expect_byte(13,0);
        self.expect_byte(14,32); self.expect_byte(15,0); self.expect_u32(28,10);
        transition self.status == 0 { true -> lengths() _ -> done() }
    }
    state lengths() {
        self.read_u32(16); self.total=self.decoded;
        self.read_u32(20); self.comp_n=self.decoded;
        self.read_u32(24); self.witness_n=self.decoded;
        transition self.status == 0 { true -> comp_limit() _ -> done() }
    }
    state comp_limit() { transition self.comp_n <= 267280 { true -> witness_exact() _ -> over() } }
    state witness_exact() { transition self.witness_n == 1376 { true -> exact_sum() _ -> bad() } }
    state exact_sum() { transition self.total == 32+self.comp_n+self.witness_n { true -> exact_input() _ -> bad() } }
    state exact_input() { transition self.total == self.n { true -> save() _ -> bad() } }
    state save() { self.comp=32; self.witness=32+self.comp_n; transition 0 { _ -> done() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_compilation(&mut self) {
    transition self.comp_n >= 154 { true -> magic() _ -> bad() }
    state magic() {
        self.expect_byte(self.comp,79); self.expect_byte(self.comp+1,77); self.expect_byte(self.comp+2,71);
        self.expect_byte(self.comp+3,67); self.expect_byte(self.comp+4,79); self.expect_byte(self.comp+5,77);
        self.expect_byte(self.comp+6,80); self.expect_byte(self.comp+7,0);
        self.expect_byte(self.comp+8,1); self.expect_byte(self.comp+9,0);
        self.expect_byte(self.comp+10,0); self.expect_byte(self.comp+11,0);
        self.expect_byte(self.comp+12,1); self.expect_byte(self.comp+13,0);
        self.expect_byte(self.comp+14,0); self.expect_byte(self.comp+15,0);
        self.expect_u32(self.comp+16,self.comp_n);
        transition self.status == 0 { true -> header() _ -> done() }
    }
    state header() {
        self.read_u32(self.comp+20); self.bundle_length=self.decoded;
        self.read_u32(self.comp+24); self.string_length=self.decoded;
        self.expect_u32(self.comp+32,1); self.expect_u32(self.comp+36,1);
        self.expect_u32(self.comp+40,0); self.expect_u32(self.comp+44,0);
        self.expect_u32(self.comp+48,0); self.expect_u32(self.comp+60,0);
        transition self.status == 0 { true -> fixed_rows() _ -> done() }
    }
    state fixed_rows() {
        self.expect_u32(self.comp+64,0); self.expect_u32(self.comp+100,0);
        self.expect_u32(self.comp+104,1); self.expect_u32(self.comp+108,0);
        self.expect_u32(self.comp+112,0); self.expect_u32(self.comp+116,0);
        self.expect_u32(self.comp+120,0); self.read_u32(self.comp+124); self.x=self.decoded;
        self.expect_u32(self.comp+128,0);
        transition self.status == 0 { true -> string_range() _ -> done() }
    }
    state string_range() { self.read_u32(self.comp+28); transition self.x < self.decoded { true -> bundle_offset() _ -> bad() } }
    state bundle_offset() { self.bundle=self.comp+132+self.string_length; transition self.bundle <= self.comp+self.comp_n { true -> bundle_extent() _ -> bad() } }
    state bundle_extent() { transition self.bundle_length == self.comp+self.comp_n-self.bundle { true -> bundle_header() _ -> bad() } }
    state bundle_header() {
        self.expect_byte(self.bundle,79); self.expect_byte(self.bundle+1,77); self.expect_byte(self.bundle+2,71);
        self.expect_byte(self.bundle+3,48); self.expect_byte(self.bundle+4,66); self.expect_byte(self.bundle+5,78);
        self.expect_byte(self.bundle+6,68); self.expect_byte(self.bundle+7,76);
        self.expect_u32(self.bundle+8,1); self.expect_u32(self.bundle+12,1);
        self.read_u32(self.bundle+16); self.x=self.decoded;
        self.read_u32(self.bundle+20); self.source_length=self.decoded;
        transition self.status == 0 { true -> source_limit() _ -> done() }
    }
    state source_limit() { transition self.source_length <= 131072 { true -> source_extent() _ -> over() } }
    state source_extent() { self.source_start=self.bundle+24+self.x; transition self.source_length == self.comp+self.comp_n-self.source_start { true -> done() _ -> bad() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::span_bounds(&mut self, relative: i32, length: i32) {
    self.match_ok=0;
    transition relative >= 0 { true -> length_nonnegative() _ -> done() }
    state length_nonnegative() { transition length >= 0 { true -> room() _ -> done() } }
    state room() { transition relative <= self.source_length-length { true -> yes() _ -> done() } }
    state yes() { self.match_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::is_ident_start(&mut self) {
    self.char_ok=0; transition self.c == 95 { true -> yes() _ -> upper0() }
    state upper0() { transition self.c >= 65 { true -> upper1() _ -> lower0() } }
    state upper1() { transition self.c < 91 { true -> yes() _ -> lower0() } }
    state lower0() { transition self.c >= 97 { true -> lower1() _ -> done() } }
    state lower1() { transition self.c < 123 { true -> yes() _ -> done() } }
    state yes() { self.char_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::is_ident_continue(&mut self) {
    self.is_ident_start(); transition self.char_ok == 1 { true -> done() _ -> digit0() }
    state digit0() { transition self.c >= 48 { true -> digit1() _ -> done() } }
    state digit1() { transition self.c < 58 { true -> yes() _ -> done() } }
    state yes() { self.char_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_identifier_span(&mut self, relative: i32, length: i32) {
    self.span_bounds(relative,length); transition self.match_ok == 1 { true -> nonempty() _ -> bad() }
    state nonempty() { transition length >= 1 { true -> ceiling() _ -> bad() } }
    state ceiling() { transition length <= 64 { true -> first() _ -> over() } }
    state first() { self.c=self.input[self.source_start+relative]; self.is_ident_start(); transition self.char_ok == 1 { true -> rest_begin() _ -> bad() } }
    state rest_begin() { self.i=1; transition 0 { _ -> rest() } }
    state rest() { transition self.i < length { true -> byte() _ -> done() } }
    state byte() { self.c=self.input[self.source_start+relative+self.i]; self.is_ident_continue(); transition self.char_ok == 1 { true -> advance() _ -> bad() } }
    state advance() { self.i=self.i+1; transition 0 { _ -> rest() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_body_span(&mut self, relative: i32, length: i32) {
    self.span_bounds(relative,length); transition self.match_ok == 1 { true -> minimum() _ -> bad() }
    state minimum() { transition length >= 2 { true -> open() _ -> bad() } }
    state open() { transition self.input[self.source_start+relative] == 123 { true -> close() _ -> bad() } }
    state close() { transition self.input[self.source_start+relative+length-1] == 125 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::source_spans_equal(&mut self, left: i32, right: i32, length: i32) {
    self.match_ok=0; self.i=0; transition 0 { _ -> loop() }
    state loop() { transition self.i < length { true -> byte() _ -> yes() } }
    state byte() { transition self.input[self.source_start+left+self.i] == self.input[self.source_start+right+self.i] { true -> advance() _ -> done() } }
    state advance() { self.i=self.i+1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_witness_header(&mut self) {
    transition self.witness_n == 1376 { true -> magic() _ -> bad() }
    state magic() {
        self.expect_byte(self.witness,79); self.expect_byte(self.witness+1,77); self.expect_byte(self.witness+2,71);
        self.expect_byte(self.witness+3,82); self.expect_byte(self.witness+4,83); self.expect_byte(self.witness+5,87);
        self.expect_byte(self.witness+6,65); self.expect_byte(self.witness+7,0);
        self.expect_byte(self.witness+8,10); self.expect_byte(self.witness+9,0);
        self.expect_byte(self.witness+10,0); self.expect_byte(self.witness+11,0);
        self.expect_byte(self.witness+12,0); self.expect_byte(self.witness+13,0);
        self.expect_byte(self.witness+14,128); self.expect_byte(self.witness+15,0);
        transition self.status == 0 { true -> fixed() _ -> done() }
    }
    state fixed() {
        self.expect_u32(self.witness+16,1376); self.expect_u32(self.witness+20,self.comp_n);
        self.expect_u32(self.witness+24,1); self.expect_u32(self.witness+28,8);
        self.expect_u32(self.witness+32,2); self.expect_u32(self.witness+36,6);
        self.expect_u32(self.witness+40,4); self.expect_u32(self.witness+44,2);
        self.expect_u32(self.witness+48,8); self.expect_u32(self.witness+52,5);
        self.expect_u32(self.witness+56,3); self.expect_u32(self.witness+60,0);
        self.expect_u32(self.witness+64,0); self.expect_u32(self.witness+68,1);
        self.expect_u32(self.witness+72,2); self.read_u32(self.witness+76); self.buffer_n=self.decoded;
        transition self.status == 0 { true -> n_low() _ -> done() }
    }
    state n_low() { transition self.buffer_n >= 1 { true -> n_high() _ -> bad() } }
    state n_high() { transition self.buffer_n <= 65536 { true -> identities() _ -> bad() } }
    state identities() {
        self.expect_u32(self.witness+80,1); self.expect_u32(self.witness+84,2);
        self.expect_u32(self.witness+88,3); self.expect_u32(self.witness+92,4);
        self.expect_u32(self.witness+96,5); self.expect_u32(self.witness+100,6);
        self.expect_u32(self.witness+104,7); self.expect_u32(self.witness+108,1);
        self.expect_u32(self.witness+112,0); self.expect_u32(self.witness+116,0);
        self.expect_u32(self.witness+120,0); self.expect_u32(self.witness+124,0);
        transition self.status == 0 { true -> unit() _ -> done() }
    }
    state unit() {
        self.expect_u32(self.witness+128,0); self.expect_u32(self.witness+132,0);
        self.expect_u32(self.witness+136,0); self.expect_u32(self.witness+140,self.source_length);
        self.expect_u32(self.witness+144,0); transition 0 { _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_type_row(&mut self, id: i32, kind: i32, flags: i32) {
    self.at=self.witness+148+id*32; self.expect_u32(self.at,id);
    self.expect_byte(self.at+4,kind); self.expect_byte(self.at+5,flags);
    self.expect_byte(self.at+6,0); self.expect_byte(self.at+7,0);
}

machine Main::validate_types(&mut self) {
    self.validate_type_row(0,0,0); self.validate_type_row(1,1,0);
    self.validate_type_row(2,3,0); self.validate_type_row(3,10,1);
    self.validate_type_row(4,10,0); self.validate_type_row(5,5,1);
    self.validate_type_row(6,4,0); self.validate_type_row(7,4,0);
    transition self.status == 0 { true -> payloads() _ -> done() }
    state payloads() {
        self.expect_u32(self.witness+148+1*32+24,255);
        self.expect_u32(self.witness+148+2*32+24,1);
        self.expect_u32(self.witness+148+3*32+8,0); self.expect_u32(self.witness+148+3*32+12,0);
        self.expect_u32(self.witness+148+3*32+16,0); self.expect_u32(self.witness+148+3*32+20,0);
        self.expect_no_id(self.witness+148+3*32+24); self.expect_no_id(self.witness+148+3*32+28);
        self.expect_u32(self.witness+148+4*32+24,self.buffer_n); self.expect_u32(self.witness+148+4*32+28,0);
        self.expect_u32(self.witness+148+5*32+8,1); self.expect_u32(self.witness+148+5*32+12,self.buffer_n);
        self.expect_u32(self.witness+148+6*32+8,0); self.expect_u32(self.witness+148+7*32+8,1);
        transition 0 { _ -> done() }
    }
    state done() { }
}

machine Main::validate_records_fields(&mut self) {
    // Record semantic IDs and projected field spans.
    self.row=0; transition 0 { _ -> records() }
    state records() { transition self.row < 2 { true -> record_row() _ -> fields_begin() } }
    state record_row() { self.at=self.witness+404+self.row*28; self.expect_u32(self.at,self.row); self.expect_u32(self.at+4,0); self.expect_u32(self.at+8,6+self.row); self.expect_u32(self.at+12,self.row*3); self.expect_u32(self.at+16,3); self.read_u32(self.at+20); self.x=self.decoded; self.read_u32(self.at+24); self.y=self.decoded; transition self.status == 0 { true -> record_span() _ -> done() } }
    state record_span() { self.validate_identifier_span(self.x,self.y); self.row=self.row+1; transition self.status == 0 { true -> records() _ -> done() } }
    state fields_begin() { self.row=0; transition 0 { _ -> fields() } }
    state fields() { transition self.row < 6 { true -> field_row() _ -> done() } }
    state field_row() { self.at=self.witness+460+self.row*24; self.expect_u32(self.at,self.row); self.expect_u32(self.at+4,self.row/3); self.read_u32(self.at+8); self.x=self.decoded; transition self.x < 32 { true -> field_type() _ -> bad() } }
    state field_type() { self.y=1; transition self.row == 0 { true -> type_array() _ -> type_length_check() } }
    state type_array() { self.y=5; transition 0 { _ -> field_values() } }
    state type_length_check() { transition self.row == 1 { true -> type_length() _ -> type_bool_check() } }
    state type_length() { self.y=4; transition 0 { _ -> field_values() } }
    state type_bool_check() { transition self.row == 2 { true -> type_bool() _ -> type_source_check() } }
    state type_bool() { self.y=2; transition 0 { _ -> field_values() } }
    state type_source_check() { transition self.row == 3 { true -> type_source() _ -> field_values() } }
    state type_source() { self.y=6; transition 0 { _ -> field_values() } }
    state field_values() { self.expect_u32(self.at+12,self.y); self.read_u32(self.at+16); self.x=self.decoded; self.read_u32(self.at+20); self.y=self.decoded; transition self.status == 0 { true -> field_span() _ -> done() } }
    state field_span() { self.validate_identifier_span(self.x,self.y); self.row=self.row+1; transition self.status == 0 { true -> fields() _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_machines(&mut self) {
    self.row=0; transition 0 { _ -> loop() }
    state loop() { transition self.row < 4 { true -> row_begin() _ -> done() } }
    state row_begin() { self.at=self.witness+604+self.row*56; self.expect_u32(self.at,self.row); self.expect_u32(self.at+4,0); self.expect_u32(self.at+8,self.row/3); self.x=2; transition self.row == 2 { true -> shared() _ -> result_check() } }
    state shared() { self.x=1; transition 0 { _ -> result_check() } }
    state result_check() { self.expect_u32(self.at+12,self.x); transition self.row < 2 { true -> unit_result() _ -> u8_result() } }
    state unit_result() { self.expect_no_id(self.at+16); transition 0 { _ -> partitions() } }
    state u8_result() { self.expect_u32(self.at+16,1); transition 0 { _ -> partitions() } }
    state partitions() { self.x=0; self.y=0; transition self.row == 1 { true -> append_partition() _ -> lookup_partition_check() } }
    state append_partition() { self.x=0; self.y=1; transition 0 { _ -> partition_values() } }
    state lookup_partition_check() { transition self.row == 2 { true -> lookup_partition() _ -> run_partition_check() } }
    state lookup_partition() { self.x=1; self.y=1; transition 0 { _ -> partition_values() } }
    state run_partition_check() { transition self.row == 3 { true -> run_partition() _ -> partition_values() } }
    state run_partition() { self.x=2; self.y=0; transition 0 { _ -> partition_values() } }
    state partition_values() { self.expect_u32(self.at+20,self.x); self.expect_u32(self.at+24,self.y); self.x=0; self.y=1; transition self.row == 1 { true -> append_blocks() _ -> lookup_blocks_check() } }
    state append_blocks() { self.x=1; self.y=3; transition 0 { _ -> block_values() } }
    state lookup_blocks_check() { transition self.row == 2 { true -> lookup_blocks() _ -> run_blocks_check() } }
    state lookup_blocks() { self.x=4; self.y=3; transition 0 { _ -> block_values() } }
    state run_blocks_check() { transition self.row == 3 { true -> run_blocks() _ -> block_values() } }
    state run_blocks() { self.x=7; transition 0 { _ -> block_values() } }
    state block_values() { self.expect_u32(self.at+28,self.x); self.expect_u32(self.at+32,self.y); self.read_u32(self.at+36); self.x=self.decoded; self.read_u32(self.at+40); self.y=self.decoded; self.expect_u32(self.at+52,0); transition self.status == 0 { true -> name_span() _ -> done() } }
    state name_span() { self.validate_identifier_span(self.x,self.y); self.read_u32(self.at+44); self.x=self.decoded; self.read_u32(self.at+48); self.y=self.decoded; transition self.status == 0 { true -> body_span() _ -> done() } }
    state body_span() { self.validate_body_span(self.x,self.y); self.row=self.row+1; transition self.status == 0 { true -> loop() _ -> done() } }
    state done() { }
}

machine Main::validate_parameters_blocks(&mut self) {
    self.expect_u32(self.witness+828,0); self.expect_u32(self.witness+832,1); self.expect_u32(self.witness+836,0); self.expect_u32(self.witness+840,1);
    self.read_u32(self.witness+844); self.x=self.decoded; self.read_u32(self.witness+848); self.y=self.decoded; self.validate_identifier_span(self.x,self.y);
    self.expect_u32(self.witness+852,1); self.expect_u32(self.witness+856,2); self.expect_u32(self.witness+860,0); self.expect_u32(self.witness+864,3);
    self.read_u32(self.witness+868); self.x=self.decoded; self.read_u32(self.witness+872); self.y=self.decoded; self.validate_identifier_span(self.x,self.y);
    self.row=0; transition self.status == 0 { true -> blocks() _ -> done() }
    state blocks() { transition self.row < 8 { true -> block_row() _ -> state_ordinals() } }
    state block_row() { self.at=self.witness+876+self.row*40; self.expect_u32(self.at,self.row); self.x=0; transition self.row == 0 { true -> owner0() _ -> owner1_check() } }
    state owner0() { self.x=0; transition 0 { _ -> owner_values() } }
    state owner1_check() { transition self.row < 4 { true -> owner1() _ -> owner2_check() } }
    state owner1() { self.x=1; transition 0 { _ -> owner_values() } }
    state owner2_check() { transition self.row < 7 { true -> owner2() _ -> owner3() } }
    state owner2() { self.x=2; transition 0 { _ -> owner_values() } }
    state owner3() { self.x=3; transition 0 { _ -> owner_values() } }
    state owner_values() { self.expect_u32(self.at+4,self.x); self.y=2; transition self.x == 2 { true -> shared() _ -> fixed() } }
    state shared() { self.y=1; transition 0 { _ -> fixed() } }
    state fixed() { self.expect_u32(self.at+12,self.y); self.expect_u32(self.at+16,0); self.expect_u32(self.at+20,0); self.read_u32(self.at+32); self.x=self.decoded; self.read_u32(self.at+36); self.y=self.decoded; self.validate_body_span(self.x,self.y); transition self.status == 0 { true -> named_check() _ -> done() } }
    state named_check() { transition self.row == 2 { true -> named() _ -> named3() } }
    state named3() { transition self.row == 3 { true -> named() _ -> named5() } }
    state named5() { transition self.row == 5 { true -> named() _ -> named6() } }
    state named6() { transition self.row == 6 { true -> named() _ -> next() } }
    state named() { self.read_u32(self.at+24); self.x=self.decoded; self.read_u32(self.at+28); self.y=self.decoded; self.validate_identifier_span(self.x,self.y); transition 0 { _ -> next() } }
    state next() { self.row=self.row+1; transition self.status == 0 { true -> blocks() _ -> done() } }
    state state_ordinals() { self.read_u32(self.witness+876+2*40+8); self.x=self.decoded; self.read_u32(self.witness+876+3*40+8); self.y=self.decoded; transition self.x != self.y { true -> lookup_ordinals() _ -> bad() } }
    state lookup_ordinals() { self.read_u32(self.witness+876+5*40+8); self.x=self.decoded; self.read_u32(self.witness+876+6*40+8); self.y=self.decoded; transition self.x != self.y { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_calls(&mut self) {
    self.row=0; transition 0 { _ -> loop() }
    state loop() { transition self.row < 5 { true -> row_begin() _ -> done() } }
    state row_begin() { self.at=self.witness+1196+self.row*36; self.expect_u32(self.at,self.row); self.expect_u32(self.at+4,0); self.expect_u32(self.at+8,3); self.x=2; transition self.row == 0 { true -> target0() _ -> target1_check() } }
    state target0() { self.x=0; transition 0 { _ -> target_values() } }
    state target1_check() { transition self.row == 1 { true -> target1() _ -> target2_check() } }
    state target1() { self.x=1; transition 0 { _ -> target_values() } }
    state target2_check() { transition self.row == 2 { true -> target2() _ -> target3_check() } }
    state target2() { self.x=2; transition 0 { _ -> target_values() } }
    state target3_check() { transition self.row == 3 { true -> target1() _ -> target2() } }
    state target_values() { self.expect_u32(self.at+12,self.x); self.expect_u32(self.at+16,3); self.read_u32(self.at+20); self.start=self.decoded; self.read_u32(self.at+24); self.count=self.decoded; self.y=1; transition self.row == 0 { true -> zero_args() _ -> call_fixed() } }
    state zero_args() { self.y=0; transition 0 { _ -> call_fixed() } }
    state call_fixed() { self.expect_u32(self.at+28,self.y); self.expect_u32(self.at+32,0); transition self.status == 0 { true -> close() _ -> done() } }
    // The complete call span includes `(`...`)`; the target machine name is
    // compared separately below, so validate only its bounds and close byte.
    state close() { self.span_bounds(self.start,self.count); transition self.match_ok == 1 { true -> close_byte() _ -> bad() } }
    state close_byte() { transition self.input[self.source_start+self.start+self.count-1] == 41 { true -> target_name() _ -> bad() } }
    state target_name() { self.at=self.witness+604+self.x*56; self.read_u32(self.at+36); self.j=self.decoded; self.read_u32(self.at+40); self.y=self.decoded; transition self.y <= self.count { true -> name_compare() _ -> bad() } }
    state name_compare() { self.source_spans_equal(self.start,self.j,self.y); transition self.match_ok == 1 { true -> next() _ -> bad() } }
    state next() { self.row=self.row+1; transition 0 { _ -> loop() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_witness(&mut self) {
    self.validate_witness_header(); transition self.status == 0 { true -> types() _ -> done() }
    state types() { self.validate_types(); transition self.status == 0 { true -> records() _ -> done() } }
    state records() { self.validate_records_fields(); transition self.status == 0 { true -> machines() _ -> done() } }
    state machines() { self.validate_machines(); transition self.status == 0 { true -> blocks() _ -> done() } }
    state blocks() { self.validate_parameters_blocks(); transition self.status == 0 { true -> calls() _ -> done() } }
    state calls() { self.validate_calls(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::clear_publication(&mut self) {
    self.i=0; transition 0 { _ -> loop() }
    state loop() { transition self.i < 977 { true -> one() _ -> done() } }
    state one() { self.publication[self.i]=0; self.i=self.i+1; transition 0 { _ -> loop() } }
    state done() { }
}

