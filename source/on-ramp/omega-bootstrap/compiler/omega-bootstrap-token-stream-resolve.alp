}

machine Main::find_current_observation_field(&mut self) {
    self.result_payload=0-1; self.j=0; transition 0 { _ -> loop() }
    state loop() { transition self.j < 9 { true -> compare() _ -> complete() } }
    state compare() { self.current_field=self.observation_fields[self.j]; self.field_name_is_token(self.current_field); transition self.match_ok == 1 { true -> unique() _ -> next() } }
    state unique() { transition self.result_payload < 0 { true -> save() _ -> bad() } }
    state save() { self.result_payload=self.current_field; transition 0 { _ -> next() } }
    state next() { self.j=self.j+1; transition 0 { _ -> loop() } }
    state complete() { transition self.result_payload >= 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::find_current_token_u64_field(&mut self, slot: i32) {
    self.result_payload=0-1; self.scan_field=self.data_field_starts[self.token_data];
    self.scan_end=self.scan_field+self.data_field_counts[self.token_data]; transition 0 { _ -> loop() }
    state loop() { transition self.scan_field < self.scan_end { true -> kind() _ -> complete() } }
    state kind() { transition self.field_kinds[self.scan_field] == 6 { true -> compare() _ -> next() } }
    state compare() { self.field_name_is_token(self.scan_field); transition self.match_ok == 1 { true -> unique() _ -> next() } }
    state unique() { transition self.result_payload < 0 { true -> prior() _ -> bad() } }
    state prior() { transition slot == 5 { true -> distinct() _ -> save() } }
    state distinct() { transition self.store_fields[4] == self.scan_field { true -> bad() _ -> save() } }
    state save() { self.result_payload=self.scan_field; transition 0 { _ -> next() } }
    state next() { self.scan_field=self.scan_field+1; transition 0 { _ -> loop() } }
    state complete() { transition self.result_payload >= 0 { true -> role() _ -> bad() } }
    state role() { transition slot == 4 { true -> decoded_start() _ -> decoded_length() } }
    state decoded_start() { self.token_decoded_start_field=self.result_payload; transition 0 { _ -> done() } }
    state decoded_length() { self.token_decoded_length_field=self.result_payload; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::find_current_push_parameter(&mut self) {
    self.result_payload=0-1; self.j=0; transition 0 { _ -> loop() }
    state loop() { transition self.j < 9 { true -> compare() _ -> complete() } }
    state compare() { self.current_param=self.push_params[self.j]; self.token_span_equal(self.source_start+self.param_names[self.current_param],self.param_name_lens[self.current_param]); transition self.match_ok == 1 { true -> unique() _ -> next() } }
    state unique() { transition self.result_payload < 0 { true -> save() _ -> bad() } }
    state save() { self.result_payload=self.current_param; transition 0 { _ -> next() } }
    state next() { self.j=self.j+1; transition 0 { _ -> loop() } }
    state complete() { transition self.result_payload >= 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_push_body(&mut self) {
    self.begin_machine_body(self.push_machine);
    self.capture_stream_bool_field(); self.retained_field=self.result_payload;
    self.expect_token(61); self.expect_word(57,5); self.expect_token(59);
    self.expect_word(43,10); self.expect_self_field(self.count_field); self.expect_token(60); self.expect_integer(self.array_n);
    self.expect_token(123); self.expect_word(53,4); self.expect_arrow(); self.capture_target_name(0);
    self.expect_underscore(); self.expect_arrow(); self.capture_target_name(1); self.expect_token(125);
    transition self.status == 0 { true -> distinct() _ -> done() }
    state distinct() { transition self.block_name_lens[0] == self.block_name_lens[1] { true -> distinct_compare() _ -> states_begin() } }
    state distinct_compare() { self.stored_spans_equal(self.block_name_starts[0],self.block_name_starts[1],self.block_name_lens[0]); transition self.match_ok == 1 { true -> bad() _ -> states_begin() } }
    state states_begin() { self.current_data=0; transition 0 { _ -> states_loop() } }
    state states_loop() { transition self.current_data < 2 { true -> state_one() _ -> outer_close() } }
    state state_one() { self.capture_state(0,2); self.current_data=self.current_data+1; transition self.status == 0 { true -> states_loop() _ -> done() } }
    state outer_close() { self.expect_token(125); transition self.status == 0 { true -> exact() _ -> done() } }
    state exact() { transition self.tok == 0 { true -> complete0() _ -> bad() } }
    state complete0() { transition self.block_body_lengths[0] > 0 { true -> complete1() _ -> bad() } }
    state complete1() { transition self.block_body_lengths[1] > 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_push_store(&mut self, slot: i32) {
    transition slot < 6 { true -> token_base() _ -> observation_base() }
    state token_base() { self.expect_self_field(self.tokens_field); transition 0 { _ -> index() } }
    state observation_base() { self.expect_self_field(self.observations_field); transition 0 { _ -> index() } }
    state index() { self.expect_token(91); self.expect_self_field(self.count_field); self.expect_token(93); self.expect_token(46); transition self.status == 0 { true -> destination() _ -> done() } }
    state destination() { transition slot == 0 { true -> token_kind() _ -> slot1() } }
    state token_kind() { self.field_name_is_token(self.token_kind_field); transition self.match_ok == 1 { true -> destination_advance() _ -> bad() } }
    state slot1() { transition slot == 1 { true -> token_source0() _ -> slot2() } }
    state token_source0() { self.field_name_is_token(self.token_source_span_field); transition self.match_ok == 1 { true -> token_source1() _ -> bad() } }
    state token_source1() { self.next_token(); self.expect_token(46); self.field_name_is_token(self.source_span_source_field); transition self.match_ok == 1 { true -> destination_advance() _ -> bad() } }
    state slot2() { transition slot < 4 { true -> token_span0() _ -> slot4() } }
    state token_span0() { self.field_name_is_token(self.token_source_span_field); transition self.match_ok == 1 { true -> token_span1() _ -> bad() } }
    state token_span1() { self.next_token(); self.expect_token(46); self.field_name_is_token(self.source_span_span_field); transition self.match_ok == 1 { true -> token_span2() _ -> bad() } }
    state token_span2() { self.next_token(); self.expect_token(46); transition slot == 2 { true -> token_start() _ -> token_end() } }
    state token_start() { self.field_name_is_token(self.span_start_field); transition self.match_ok == 1 { true -> destination_advance() _ -> bad() } }
    state token_end() { self.field_name_is_token(self.span_end_field); transition self.match_ok == 1 { true -> destination_advance() _ -> bad() } }
    state slot4() { transition slot < 6 { true -> token_u64() _ -> observation_field() } }
    state token_u64() { self.find_current_token_u64_field(slot); self.x=self.result_payload; transition self.status == 0 { true -> destination_advance() _ -> done() } }
    state observation_field() { self.find_current_observation_field(); self.x=self.result_payload; transition self.status == 0 { true -> destination_advance() _ -> done() } }
    state destination_advance() { transition slot < 4 { true -> known_destination() _ -> selected_destination() } }
    state known_destination() { transition slot == 0 { true -> known_kind() _ -> known_source() } }
    state known_kind() { self.x=self.token_kind_field; transition 0 { _ -> advance_equal() } }
    state known_source() { transition slot == 1 { true -> known_source_save() _ -> known_span() } }
    state known_source_save() { self.x=self.source_span_source_field; transition 0 { _ -> advance_equal() } }
    state known_span() { transition slot == 2 { true -> known_start() _ -> known_end() } }
    state known_start() { self.x=self.span_start_field; transition 0 { _ -> advance_equal() } }
    state known_end() { self.x=self.span_end_field; transition 0 { _ -> advance_equal() } }
    state selected_destination() { transition 0 { _ -> advance_equal() } }
    state advance_equal() { self.next_token(); self.expect_token(61); transition self.status == 0 { true -> source_ordinal() _ -> done() } }
    state source_ordinal() { transition slot == 0 { true -> source1() _ -> source_slot1() } }
    state source1() { self.y=1; transition 0 { _ -> source_parameter() } }
    state source_slot1() { transition slot == 1 { true -> source0() _ -> source_slot6() } }
    state source0() { self.y=0; transition 0 { _ -> source_parameter() } }
    state source_slot6() { transition slot < 10 { true -> source_obs_u8() _ -> source_obs_source() } }
    state source_obs_u8() { self.y=slot; transition 0 { _ -> source_parameter() } }
    state source_obs_source() { transition slot == 10 { true -> source_projection() _ -> source_u64() } }
    state source_projection() { self.y=0; self.expect_parameter(self.push_params[0]); self.expect_token(46); self.field_name_is_token(self.source_value_field); transition self.match_ok == 1 { true -> source_projection_advance() _ -> bad() } }
    state source_projection_advance() { self.next_token(); transition 0 { _ -> source_done() } }
    state source_u64() { transition slot < 6 { true -> source_token_u64() _ -> source_observation_u64() } }
    state source_token_u64() { self.y=slot-2; transition 0 { _ -> source_parameter() } }
    state source_observation_u64() { self.y=slot-9; transition 0 { _ -> source_parameter() } }
    state source_parameter() { self.expect_parameter(self.push_params[self.y]); transition self.status == 0 { true -> source_done() _ -> done() } }
    state source_done() { self.store_fields[slot]=self.x; self.store_params[slot]=self.y; self.expect_token(59); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_push_stores(&mut self) {
    self.i=6; transition 0 { _ -> outer() }
    state outer() { transition self.i < 15 { true -> kind() _ -> done() } }
    state kind() { transition self.i < 10 { true -> u8_kind() _ -> source_kind() } }
    state u8_kind() { transition self.field_kinds[self.store_fields[self.i]] == 1 { true -> inner_begin() _ -> bad() } }
    state source_kind() { transition self.i == 10 { true -> u32_kind() _ -> u64_kind() } }
    state u32_kind() { transition self.field_kinds[self.store_fields[self.i]] == 7 { true -> inner_begin() _ -> bad() } }
    state u64_kind() { transition self.field_kinds[self.store_fields[self.i]] == 6 { true -> inner_begin() _ -> bad() } }
    state inner_begin() { self.j=6; transition 0 { _ -> inner() } }
    state inner() { transition self.j < self.i { true -> distinct() _ -> next() } }
    state distinct() { transition self.store_fields[self.j] == self.store_fields[self.i] { true -> bad() _ -> inner_next() } }
    state inner_next() { self.j=self.j+1; transition 0 { _ -> inner() } }
    state next() { self.i=self.i+1; transition 0 { _ -> outer() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_push_retain(&mut self) {
    self.begin_selected_block(0); self.current_data=0; transition 0 { _ -> stores() }
    state stores() { transition self.current_data < 15 { true -> one() _ -> validate() } }
    state one() { self.parse_push_store(self.current_data); self.current_data=self.current_data+1; transition self.status == 0 { true -> stores() _ -> done() } }
    state validate() { self.validate_push_stores(); transition self.status == 0 { true -> increment() _ -> done() } }
