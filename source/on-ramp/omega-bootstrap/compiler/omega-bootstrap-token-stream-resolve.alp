machine Main::find_accepted_field(&mut self) {
    self.accepted_field=0-1; self.scan_field=self.data_field_starts[self.stream_data];
    self.scan_end=self.scan_field+self.data_field_counts[self.stream_data]; transition 0 { _ -> loop() }
    state loop() { transition self.scan_field < self.scan_end { true -> kind() _ -> complete() } }
    state kind() { transition self.field_kinds[self.scan_field] == 2 { true -> retained_check() _ -> next() } }
    state retained_check() { transition self.scan_field == self.retained_field { true -> next() _ -> unique() } }
    state unique() { transition self.accepted_field < 0 { true -> save() _ -> bad() } }
    state save() { self.accepted_field=self.scan_field; transition 0 { _ -> next() } }
    state next() { self.scan_field=self.scan_field+1; transition 0 { _ -> loop() } }
    state complete() { transition self.accepted_field >= 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_relation(&mut self) {
    self.classify_sums(); transition self.status == 0 { true -> leaves() _ -> done() }
    state leaves() { self.find_leaf_records(); transition self.status == 0 { true -> source_span() _ -> done() } }
    state source_span() { self.find_source_span_record(); transition self.status == 0 { true -> token() _ -> done() } }
    state token() { self.find_token_record(); transition self.status == 0 { true -> lex_diagnostic() _ -> done() } }
    state lex_diagnostic() { self.find_lex_diagnostic_record(); transition self.status == 0 { true -> observation() _ -> done() } }
    state observation() { self.find_observation_record(); transition self.status == 0 { true -> stream() _ -> done() } }
    state stream() { self.find_stream_record(); transition self.status == 0 { true -> root() _ -> done() } }
    state root() { self.find_root_record(); transition self.status == 0 { true -> machines() _ -> done() } }
    state machines() { self.classify_machines(); transition self.status == 0 { true -> push_body() _ -> done() } }
    state push_body() { self.parse_push_body(); transition self.status == 0 { true -> push_retain() _ -> done() } }
    state push_retain() { self.parse_push_retain(); transition self.status == 0 { true -> push_full() _ -> done() } }
    state push_full() { self.parse_push_full(); transition self.status == 0 { true -> lookup_body() _ -> done() } }
    state lookup_body() { self.parse_lookup_body(); transition self.status == 0 { true -> lookup_retain() _ -> done() } }
    state lookup_retain() { self.parse_lookup_retain(); transition self.status == 0 { true -> lookup_exponent() _ -> done() } }
    state lookup_exponent() { self.parse_lookup_exponent(); transition self.status == 0 { true -> lookup_empty() _ -> done() } }
    state lookup_empty() { self.parse_lookup_empty(); transition self.status == 0 { true -> lookup_suffix() _ -> done() } }
    state lookup_suffix() { self.parse_lookup_suffix(); transition self.status == 0 { true -> lookup_tag() _ -> done() } }
    state lookup_tag() { self.parse_lookup_tag(); transition self.status == 0 { true -> lookup_absent() _ -> done() } }
    state lookup_absent() { self.parse_lookup_absent(); transition self.status == 0 { true -> run_body() _ -> done() } }
    state run_body() { self.parse_run_body(); transition self.status == 0 { true -> accepted() _ -> done() } }
    state accepted() { self.find_accepted_field(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::clear_v12_publication(&mut self) {
    self.i=0; transition 0 { _ -> loop() }
    state loop() { transition self.i < 1876 { true -> one() _ -> done() } }
    state one() { self.publication[self.i]=0; self.i=self.i+1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::v12_type(&mut self, row: i32, kind: i32, flags: i32) {
    self.i=49+row*8; self.publication[self.i]=row; self.publication[self.i+1]=kind+flags*256;
    self.publication[self.i+2]=self.x; self.publication[self.i+3]=self.y;
    self.publication[self.i+4]=self.k; self.publication[self.i+5]=0;
    self.publication[self.i+6]=self.current_field; self.publication[self.i+7]=0;
}

machine Main::fill_v12_types(&mut self) {
    self.j=0; transition 0 { _ -> records() }
    state records() { transition self.j < 8 { true -> record() _ -> sums_begin() } }
    state record() { self.x=self.j; self.y=0; self.k=0; self.current_field=0; self.v12_type(self.j,4,0); self.j=self.j+1; transition 0 { _ -> records() } }
    state sums_begin() { self.j=0; transition 0 { _ -> sums() } }
    state sums() { transition self.j < 5 { true -> sum() _ -> scalars() } }
    state sum() { self.x=self.j; self.y=0; self.k=0; self.current_field=0; self.v12_type(8+self.j,6,0); self.j=self.j+1; transition 0 { _ -> sums() } }
    state scalars() {
        self.x=0; self.y=0; self.k=0; self.current_field=255; self.v12_type(13,1,0);
        self.current_field=-1; self.v12_type(14,2,1); self.current_field=1; self.v12_type(15,3,0); self.current_field=-1; self.v12_type(16,10,1);
        self.current_field=16384; self.v12_type(17,10,0); self.current_field=65536; self.v12_type(18,10,0);
        self.x=3; self.y=16384; self.current_field=0; self.v12_type(19,5,1);
        self.x=5; self.v12_type(20,5,1); self.x=13; self.y=65536; self.v12_type(21,5,1); transition 0 { _ -> done() }
    }
    state done() { }
}

machine Main::v12_record(&mut self, row: i32, source_data: i32, field_start: i32) {
    self.i=225+row*8; self.publication[self.i]=row; self.publication[self.i+1]=0;
    self.publication[self.i+2]=row; self.publication[self.i+3]=field_start; transition row == 0 { true -> one() _ -> row1_check() }
    state row1_check() { transition row == 1 { true -> two() _ -> row2_check() } }
    state row2_check() { transition row == 2 { true -> two() _ -> row3_check() } }
    state row3_check() { transition row == 3 { true -> four() _ -> row4_check() } }
    state row4_check() { transition row == 4 { true -> two() _ -> row5_check() } }
    state row5_check() { transition row == 5 { true -> nine() _ -> row6_check() } }
    state row6_check() { transition row == 6 { true -> eight() _ -> one() } }
    state one() { self.x=1; transition 0 { _ -> save() } }
    state two() { self.x=2; transition 0 { _ -> save() } }
    state four() { self.x=4; transition 0 { _ -> save() } }
    state eight() { self.x=8; transition 0 { _ -> save() } }
    state nine() { self.x=9; transition 0 { _ -> save() } }
    state save() { self.publication[self.i+4]=self.x;
    self.publication[self.i+5]=self.data_names[source_data]; self.publication[self.i+6]=self.data_name_lens[source_data];
    self.publication[self.i+7]=self.data_copy_flags[source_data];
        transition 0 { _ -> done() }
    }
    state done() { }
}

machine Main::v12_field(&mut self, row: i32, type_id: i32, source_field: i32) {
    self.i=289+row*6; self.publication[self.i]=row;
    transition row < 1 { true -> owner0() _ -> owner1_check() }
    state owner0() { self.x=0; self.y=row; transition 0 { _ -> save() } }
    state owner1_check() { transition row < 3 { true -> owner1() _ -> owner2_check() } }
    state owner1() { self.x=1; self.y=row-1; transition 0 { _ -> save() } }
    state owner2_check() { transition row < 5 { true -> owner2() _ -> owner3_check() } }
    state owner2() { self.x=2; self.y=row-3; transition 0 { _ -> save() } }
    state owner3_check() { transition row < 9 { true -> owner3() _ -> owner4_check() } }
    state owner3() { self.x=3; self.y=row-5; transition 0 { _ -> save() } }
    state owner4_check() { transition row < 11 { true -> owner4() _ -> owner5_check() } }
    state owner4() { self.x=4; self.y=row-9; transition 0 { _ -> save() } }
    state owner5_check() { transition row < 20 { true -> owner5() _ -> owner6_check() } }
    state owner5() { self.x=5; self.y=row-11; transition 0 { _ -> save() } }
    state owner6_check() { transition row < 28 { true -> owner6() _ -> owner7() } }
    state owner6() { self.x=6; self.y=row-20; transition 0 { _ -> save() } }
    state owner7() { self.x=7; self.y=0; transition 0 { _ -> save() } }
    state save() { self.publication[self.i+1]=self.x; self.publication[self.i+2]=self.y; self.publication[self.i+3]=type_id;
    self.publication[self.i+4]=self.field_names[source_field]; self.publication[self.i+5]=self.field_name_lens[source_field];
        transition 0 { _ -> done() }
    }
    state done() { }
}

machine Main::fill_v12_records_fields(&mut self) {
    self.v12_record(0,self.source_id_data,0); self.v12_record(1,self.span_data,1);
    self.v12_record(2,self.source_span_data,3); self.v12_record(3,self.token_data,5);
    self.v12_record(4,self.lex_diagnostic_data,9); self.v12_record(5,self.observation_data,11);
    self.v12_record(6,self.stream_data,20); self.v12_record(7,self.root_data,28);
    self.v12_field(0,14,self.source_value_field);
    self.v12_field(1,16,self.span_start_field); self.v12_field(2,16,self.span_end_field);
    self.v12_field(3,0,self.source_span_source_field); self.v12_field(4,1,self.source_span_span_field);
    self.v12_field(5,11,self.token_kind_field); self.v12_field(6,2,self.token_source_span_field);
    self.v12_field(7,16,self.token_decoded_start_field); self.v12_field(8,16,self.token_decoded_length_field);
    self.current_field=self.data_field_starts[self.lex_diagnostic_data];
    self.v12_field(9,12,self.current_field); self.v12_field(10,2,self.current_field+1);
    self.j=0; transition 0 { _ -> observation() }
    state observation() { transition self.j < 9 { true -> observation_one() _ -> stream() } }
    state observation_one() { self.current_field=self.store_fields[6+self.j]; transition self.j < 4 { true -> observation_u8() _ -> observation_u32_check() } }
    state observation_u8() { self.k=13; transition 0 { _ -> observation_save() } }
    state observation_u32_check() { transition self.j == 4 { true -> observation_u32() _ -> observation_u64() } }
    state observation_u32() { self.k=14; transition 0 { _ -> observation_save() } }
