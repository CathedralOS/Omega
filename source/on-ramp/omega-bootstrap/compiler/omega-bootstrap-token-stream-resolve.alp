    state numeric_ref() { self.payload_nominal_names_data(self.j,self.numeric_base_data); transition self.match_ok == 1 { true -> integer_bool0() _ -> bad() } }
    state integer_bool0() { transition self.payload_kinds[self.j+1] == 2 { true -> integer_bool1() _ -> bad() } }
    state integer_bool1() { transition self.payload_kinds[self.j+2] == 2 { true -> float_bool0() _ -> bad() } }
    state float_bool0() { self.k=self.case_payload_starts[self.result_span_start+2]; transition self.payload_kinds[self.k] == 2 { true -> float_bool1() _ -> bad() } }
    state float_bool1() { transition self.payload_kinds[self.k+1] == 2 { true -> float_bool2() _ -> bad() } }
    state float_bool2() { transition self.payload_kinds[self.k+2] == 2 { true -> keyword_ref_kind() _ -> bad() } }
    state keyword_ref_kind() { self.j=self.case_payload_starts[self.result_span_start+4]; transition self.payload_kinds[self.j] == 5 { true -> keyword_ref() _ -> bad() } }
    state keyword_ref() { self.payload_nominal_names_data(self.j,self.keyword_kind_data); transition self.match_ok == 1 { true -> punctuation_ref_kind() _ -> bad() } }
    state punctuation_ref_kind() { self.j=self.case_payload_starts[self.result_span_start+5]; transition self.payload_kinds[self.j] == 5 { true -> punctuation_ref() _ -> bad() } }
    state punctuation_ref() { self.payload_nominal_names_data(self.j,self.punctuation_kind_data); transition self.match_ok == 1 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

