machine Main::capture_read_state(&mut self, slot: i32, param_base: i32, count: i32) {
    self.expect_word(62,5); transition self.status == 0 { true -> name() _ -> done() }
    state name() { transition self.tok == 256 { true -> name_role() _ -> bad() } }
    state name_role() { transition self.block_name_lens[slot] > 0 { true -> name_compare() _ -> name_save() } }
    state name_compare() { self.token_span_equal(self.source_start+self.block_name_starts[slot],self.block_name_lens[slot]); transition self.match_ok == 1 { true -> name_advance() _ -> bad() } }
    state name_save() { self.block_name_starts[slot]=self.tok_start-self.source_start; self.block_name_lens[slot]=self.tok_len; transition 0 { _ -> name_advance() } }
    state name_advance() { self.next_token(); self.expect_token(40); self.expect_token(38); self.expect_word(20,4); self.j=0; transition self.status == 0 { true -> params() _ -> done() } }
    state params() { transition self.j < count { true -> comma() _ -> close() } }
    state comma() { self.expect_token(44); transition self.status == 0 { true -> param_name() _ -> done() } }
    state param_name() { transition self.tok == 256 { true -> param_save() _ -> bad() } }
    state param_save() { self.read_param_names[param_base+self.j]=self.tok_start-self.source_start; self.read_param_lens[param_base+self.j]=self.tok_len; self.next_token(); self.expect_token(58); self.expect_word(29,4); self.j=self.j+1; transition self.status == 0 { true -> params() _ -> done() } }
    state close() { self.expect_token(41); self.skip_balanced_body(); self.block_body_starts[slot]=self.result_span_start; self.block_body_lengths[slot]=self.result_span_len; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

