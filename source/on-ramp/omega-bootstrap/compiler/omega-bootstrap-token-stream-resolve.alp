machine Main::capture_state(&mut self, base_slot: i32, access: i32) {
    self.expect_word(62,5); transition self.status == 0 { true -> name() _ -> done() }
    state name() { transition self.tok == 256 { true -> save_name() _ -> bad() } }
    state save_name() { self.saved_name_start=self.tok_start-self.source_start; self.saved_name_len=self.tok_len; self.next_token(); self.expect_token(40); self.expect_token(38); transition self.status == 0 { true -> mut_check() _ -> done() } }
    state mut_check() { transition access == 2 { true -> mut_word() _ -> self_word() } }
    state mut_word() { self.expect_word(17,3); transition 0 { _ -> self_word() } }
    state self_word() { self.expect_word(20,4); self.expect_token(41); transition self.status == 0 { true -> body() _ -> done() } }
    state body() { self.skip_balanced_body(); transition self.status == 0 { true -> target0_length() _ -> done() } }
    state target0_length() { transition self.saved_name_len == self.block_name_lens[base_slot] { true -> target0_compare() _ -> target1_length() } }
    state target0_compare() { self.stored_spans_equal(self.saved_name_start,self.block_name_starts[base_slot],self.saved_name_len); transition self.match_ok == 1 { true -> target0_unique() _ -> target1_length() } }
    state target0_unique() { transition self.block_body_lengths[base_slot] == 0 { true -> target0_save() _ -> bad() } }
    state target0_save() { self.block_name_starts[base_slot]=self.saved_name_start; self.block_name_lens[base_slot]=self.saved_name_len; self.block_body_starts[base_slot]=self.result_span_start; self.block_body_lengths[base_slot]=self.result_span_len; self.block_source_ordinals[base_slot]=self.current_data; transition 0 { _ -> done() } }
    state target1_length() { transition self.saved_name_len == self.block_name_lens[base_slot+1] { true -> target1_compare() _ -> bad() } }
    state target1_compare() { self.stored_spans_equal(self.saved_name_start,self.block_name_starts[base_slot+1],self.saved_name_len); transition self.match_ok == 1 { true -> target1_unique() _ -> bad() } }
    state target1_unique() { transition self.block_body_lengths[base_slot+1] == 0 { true -> target1_save() _ -> bad() } }
    state target1_save() { self.block_name_starts[base_slot+1]=self.saved_name_start; self.block_name_lens[base_slot+1]=self.saved_name_len; self.block_body_starts[base_slot+1]=self.result_span_start; self.block_body_lengths[base_slot+1]=self.result_span_len; self.block_source_ordinals[base_slot+1]=self.current_data; transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::capture_stream_bool_field(&mut self) {
    self.expect_word(20,4); self.expect_token(46); self.result_payload=0-1;
    transition self.status == 0 { true -> scan_begin() _ -> done() }
    state scan_begin() { self.scan_field=self.data_field_starts[self.stream_data]; self.scan_end=self.scan_field+self.data_field_counts[self.stream_data]; transition 0 { _ -> scan() } }
    state scan() { transition self.scan_field < self.scan_end { true -> kind() _ -> complete() } }
    state kind() { transition self.field_kinds[self.scan_field] == 2 { true -> compare() _ -> next() } }
    state compare() { self.field_name_is_token(self.scan_field); transition self.match_ok == 1 { true -> unique() _ -> next() } }
    state unique() { transition self.result_payload < 0 { true -> save() _ -> bad() } }
    state save() { self.result_payload=self.scan_field; transition 0 { _ -> next() } }
    state next() { self.scan_field=self.scan_field+1; transition 0 { _ -> scan() } }
    state complete() { transition self.result_payload >= 0 { true -> advance() _ -> bad() } }
    state advance() { self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

