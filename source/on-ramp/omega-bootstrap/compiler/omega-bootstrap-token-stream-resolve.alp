machine Main::fill_v12_sums(&mut self) {
    self.v12_sum(0,self.numeric_base_data,0); self.v12_sum(1,self.keyword_kind_data,4);
    self.v12_sum(2,self.punctuation_kind_data,34); self.v12_sum(3,self.token_kind_data,76);
    self.v12_sum(4,self.lex_code_data,85); self.j=0; transition 0 { _ -> sums() }
    state sums() { transition self.j < 5 { true -> select() _ -> payloads() } }
    state select() { transition self.j == 0 { true -> numeric() _ -> keyword_check() } }
    state numeric() { self.current_data=self.numeric_base_data; self.x=0; transition 0 { _ -> case_loop_begin() } }
    state keyword_check() { transition self.j == 1 { true -> keyword() _ -> punct_check() } }
    state keyword() { self.current_data=self.keyword_kind_data; self.x=4; transition 0 { _ -> case_loop_begin() } }
    state punct_check() { transition self.j == 2 { true -> punct() _ -> token_check() } }
    state punct() { self.current_data=self.punctuation_kind_data; self.x=34; transition 0 { _ -> case_loop_begin() } }
    state token_check() { transition self.j == 3 { true -> token() _ -> lex() } }
