    state case_loop_begin() { self.k=0; transition 0 { _ -> case_loop() } }
    state case_loop() { transition self.k < self.data_case_counts[self.current_data] { true -> case_one() _ -> sum_next() } }
    state case_one() { self.current_field=self.data_case_starts[self.current_data]+self.k; self.v12_case(self.x+self.k,self.j,self.current_field); self.k=self.k+1; transition 0 { _ -> case_loop() } }
    state sum_next() { self.j=self.j+1; transition 0 { _ -> sums() } }
    state payloads() {
