machine Main::v12_store(&mut self, row: i32, path_start: i32, param_ordinal: i32) {
    self.i=1618+row*10; self.publication[self.i]=row; self.publication[self.i+1]=0; self.publication[self.i+2]=1;
    transition row < 6 { true -> token_array() _ -> observation_array() }
