    state observation_array() { self.publication[self.i+3]=21; transition 0 { _ -> common() } }
    state common() { self.publication[self.i+4]=path_start; transition row < 1 { true -> count1() _ -> count2_check() } }
    state count1() { self.x=1; transition 0 { _ -> type_select() } }
    state count2_check() { transition row == 1 { true -> count2() _ -> count3_check() } }
    state count2() { self.x=2; transition 0 { _ -> type_select() } }
    state count3_check() { transition row < 4 { true -> count3() _ -> count1() } }
    state count3() { self.x=3; transition 0 { _ -> type_select() } }
