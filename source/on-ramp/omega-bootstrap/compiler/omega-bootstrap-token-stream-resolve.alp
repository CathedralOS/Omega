machine Main::fill_v12_publication(&mut self) {
    self.clear_v12_publication(); self.fill_v12_header(); self.fill_v12_types(); self.fill_v12_records_fields();
    self.fill_v12_sums(); self.fill_v12_machines_blocks(); self.fill_v12_effects();
}

machine Main::emit_u32(&mut self, value: i32) {
    transition value >= 0 { true -> positive() _ -> negative() }
    state positive() { write_byte(value & 255); write_byte((value >> 8) & 255); write_byte((value >> 16) & 255); write_byte((value >> 24) & 255); transition 0 { _ -> done() } }
    state negative() { self.word=0-value-1; write_byte(255-(self.word&255)); self.word=self.word/256; write_byte(255-(self.word&255)); self.word=self.word/256; write_byte(255-(self.word&255)); self.word=self.word/256; write_byte(255-(self.word&255)); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::publish(&mut self) {
    self.fill_v12_publication(); write_byte(79); write_byte(77); write_byte(71); write_byte(82); write_byte(83); write_byte(87); write_byte(67); write_byte(0);
    write_byte(12); write_byte(0); write_byte(0); write_byte(0); write_byte(0); write_byte(0); write_byte(192); write_byte(0);
    self.i=0; transition 0 { _ -> words() }
    state words() { transition self.i < 1876 { true -> one() _ -> done() } }
    state one() { self.emit_u32(self.publication[self.i]); self.i=self.i+1; transition 0 { _ -> words() } }
    state done() { }
}

machine Main::main(&mut self) {
    self.status=0; self.slurp(); transition self.status == 0 { true -> compilation() _ -> done() }
    state compilation() { self.decode_compilation(); transition self.status == 0 { true -> words() _ -> done() } }
    state words() { self.init_words(); self.parse_source(); transition self.status == 0 { true -> relation() _ -> done() } }
    state relation() { self.validate_relation(); transition self.status == 0 { true -> output() _ -> done() } }
    state output() { self.publish(); transition 0 { _ -> done() } }
    state done() { self.console.exit_process(self.status); }
}
