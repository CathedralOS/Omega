machine Main::find_stream_record(&mut self) {
    self.stream_data=0-1; self.scan_data=0; transition 0 { _ -> data_loop() }
    state data_loop() { transition self.scan_data < self.data_count { true -> candidate_record() _ -> complete() } }
    state candidate_record() { transition self.data_is_sum[self.scan_data] == 0 { true -> noncopy() _ -> data_next() } }
    state noncopy() { transition self.data_copy_flags[self.scan_data] == 0 { true -> begin_fields() _ -> data_next() } }
    state begin_fields() {
        self.scan_field=self.data_field_starts[self.scan_data]; self.scan_end=self.scan_field+self.data_field_counts[self.scan_data];
        self.x=0-1; self.y=0-1; self.k=0-1; self.current_field=0-1; self.current_param=0-1;
        self.result_kind=0-1; self.result_payload=0; self.current_data=0; transition 0 { _ -> field_loop() }
    }
    state field_loop() { transition self.scan_field < self.scan_end { true -> array_check() _ -> candidate() } }
    state array_check() { transition self.field_kinds[self.scan_field] == 4 { true -> token_array_ref() _ -> count_check() } }
    state token_array_ref() { self.nominal_names_data(self.scan_field,self.token_data); transition self.match_ok == 1 { true -> token_array_n() _ -> observation_array_ref() } }
    state token_array_n() { transition self.field_payloads[self.scan_field] == 16384 { true -> token_array_unique() _ -> data_next() } }
    state token_array_unique() { transition self.x < 0 { true -> token_array_save() _ -> bad() } }
    state token_array_save() { self.x=self.scan_field; transition 0 { _ -> next_field() } }
    state observation_array_ref() { self.nominal_names_data(self.scan_field,self.observation_data); transition self.match_ok == 1 { true -> observation_array_n() _ -> byte_array() } }
    state observation_array_n() { transition self.field_payloads[self.scan_field] == 16384 { true -> observation_array_unique() _ -> data_next() } }
    state observation_array_unique() { transition self.y < 0 { true -> observation_array_save() _ -> bad() } }
    state observation_array_save() { self.y=self.scan_field; transition 0 { _ -> next_field() } }
    state byte_array() { transition self.field_payloads[self.scan_field] == 65536 { true -> byte_name_length() _ -> next_field() } }
    state byte_name_length() { transition self.field_nominal_lens[self.scan_field] == 2 { true -> byte_name0() _ -> next_field() } }
    state byte_name0() { transition self.input[self.source_start+self.field_nominal_names[self.scan_field]] == 117 { true -> byte_name1() _ -> next_field() } }
    state byte_name1() { transition self.input[self.source_start+self.field_nominal_names[self.scan_field]+1] == 56 { true -> byte_save() _ -> next_field() } }
    state byte_save() { self.result_payload=self.result_payload+1; transition self.current_field < 0 { true -> byte_first() _ -> next_field() } }
    state byte_first() { self.current_field=self.scan_field; transition 0 { _ -> next_field() } }
    state count_check() { transition self.field_kinds[self.scan_field] == 3 { true -> count_value() _ -> diagnostic_check() } }
    state count_value() { transition self.field_payloads[self.scan_field] == 16384 { true -> count_unique() _ -> decoded_count_value() } }
    state count_unique() { transition self.k < 0 { true -> count_save() _ -> bad() } }
    state count_save() { self.k=self.scan_field; transition 0 { _ -> next_field() } }
    state decoded_count_value() { transition self.field_payloads[self.scan_field] == 65536 { true -> decoded_count_unique() _ -> next_field() } }
    state decoded_count_unique() { transition self.current_param < 0 { true -> decoded_count_save() _ -> bad() } }
    state decoded_count_save() { self.current_param=self.scan_field; transition 0 { _ -> next_field() } }
    state diagnostic_check() { transition self.field_kinds[self.scan_field] == 5 { true -> diagnostic_ref() _ -> bool_check() } }
    state diagnostic_ref() { self.nominal_names_data(self.scan_field,self.lex_diagnostic_data); transition self.match_ok == 1 { true -> diagnostic_unique() _ -> next_field() } }
    state diagnostic_unique() { transition self.result_kind < 0 { true -> diagnostic_save() _ -> bad() } }
    state diagnostic_save() { self.result_kind=self.scan_field; transition 0 { _ -> next_field() } }
    state bool_check() { transition self.field_kinds[self.scan_field] == 2 { true -> bool_add() _ -> next_field() } }
    state bool_add() { self.current_data=self.current_data+1; transition 0 { _ -> next_field() } }
    state next_field() { self.scan_field=self.scan_field+1; transition 0 { _ -> field_loop() } }
    state candidate() { transition self.x >= 0 { true -> candidate_obs() _ -> data_next() } }
    state candidate_obs() { transition self.y >= 0 { true -> candidate_count() _ -> data_next() } }
    state candidate_count() { transition self.k >= 0 { true -> candidate_decoded() _ -> data_next() } }
    state candidate_decoded() { transition self.current_param >= 0 { true -> candidate_diagnostic() _ -> data_next() } }
    state candidate_diagnostic() { transition self.result_kind >= 0 { true -> candidate_bytes() _ -> data_next() } }
    state candidate_bytes() { transition self.result_payload >= 1 { true -> owner_ceiling() _ -> data_next() } }
    state owner_ceiling() { transition self.result_payload < 8 { true -> candidate_bools() _ -> over() } }
    state candidate_bools() { transition self.current_data >= 2 { true -> unique() _ -> data_next() } }
    state unique() { transition self.stream_data < 0 { true -> save() _ -> bad() } }
    state save() {
        self.stream_data=self.scan_data; self.tokens_field=self.x; self.observations_field=self.y;
        self.count_field=self.k; self.decoded_field=self.current_field; self.decoded_count_field=self.current_param;
        self.diagnostic_field=self.result_kind; self.array_n=16384; transition 0 { _ -> data_next() }
    }
    state data_next() { self.scan_data=self.scan_data+1; transition 0 { _ -> data_loop() } }
    state complete() { transition self.stream_data >= 0 { true -> done() _ -> bad() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::find_root_record(&mut self) {
    self.root_data=0-1; self.stream_field=0-1; self.scan_data=0; transition 0 { _ -> data_loop() }
    state data_loop() { transition self.scan_data < self.data_count { true -> excluded() _ -> complete() } }
    state excluded() { transition self.scan_data == self.observation_data { true -> data_next() _ -> stream_excluded() } }
    state stream_excluded() { transition self.scan_data == self.stream_data { true -> data_next() _ -> fields_begin() } }
    state fields_begin() { self.scan_field=self.data_field_starts[self.scan_data]; self.scan_end=self.scan_field+self.data_field_counts[self.scan_data]; self.x=0-1; transition 0 { _ -> fields() } }
    state fields() { transition self.scan_field < self.scan_end { true -> nominal() _ -> candidate() } }
    state nominal() { transition self.field_kinds[self.scan_field] == 5 { true -> match_stream() _ -> next_field() } }
    state match_stream() { self.nominal_names_data(self.scan_field,self.stream_data); transition self.match_ok == 1 { true -> unique_field() _ -> next_field() } }
    state unique_field() { transition self.x < 0 { true -> save_field() _ -> bad() } }
    state save_field() { self.x=self.scan_field; transition 0 { _ -> next_field() } }
    state next_field() { self.scan_field=self.scan_field+1; transition 0 { _ -> fields() } }
    state candidate() { transition self.x >= 0 { true -> candidate_noncopy() _ -> data_next() } }
    state candidate_noncopy() { transition self.data_copy_flags[self.scan_data] == 0 { true -> unique_root() _ -> data_next() } }
    state unique_root() { transition self.root_data < 0 { true -> save_root() _ -> bad() } }
    state save_root() { self.root_data=self.scan_data; self.stream_field=self.x; transition 0 { _ -> data_next() } }
    state data_next() { self.scan_data=self.scan_data+1; transition 0 { _ -> data_loop() } }
    state complete() { transition self.root_data >= 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::classify_machines(&mut self) {
    self.push_machine=0-1; self.lookup_machine=0-1; self.run_machine=0-1; self.scan_machine=0; transition 0 { _ -> loop() }
    state loop() { transition self.scan_machine < self.machine_count { true -> stream_owner() _ -> complete() } }
    state stream_owner() { self.owner_names_data(self.scan_machine,self.stream_data); transition self.match_ok == 1 { true -> stream_signature() _ -> root_owner() } }
    state stream_signature() { transition self.machine_param_counts[self.scan_machine] == 10 { true -> push_access() _ -> lookup_count() } }
    state push_access() { transition self.machine_access[self.scan_machine] == 2 { true -> push_result() _ -> bad() } }
    state push_result() { transition self.machine_result_kinds[self.scan_machine] == 0 { true -> push_types() _ -> bad() } }
    state push_types() { self.current_param=self.machine_param_starts[self.scan_machine]; self.j=0; transition 0 { _ -> push_type_loop() } }
    state push_type_loop() { transition self.j < 10 { true -> push_type_one() _ -> push_unique() } }
    state push_type_one() { self.push_params[self.j]=self.current_param; transition self.j == 0 { true -> source_kind() _ -> kind_ordinal() } }
    state source_kind() { transition self.param_kinds[self.current_param] == 5 { true -> source_ref() _ -> bad() } }
    state source_ref() { self.param_nominal_names_data(self.current_param,self.source_id_data); transition self.match_ok == 1 { true -> push_next() _ -> bad() } }
    state kind_ordinal() { transition self.j == 1 { true -> kind_kind() _ -> u64_ordinals() } }
    state kind_kind() { transition self.param_kinds[self.current_param] == 5 { true -> kind_ref() _ -> bad() } }
    state kind_ref() { self.param_nominal_names_data(self.current_param,self.token_kind_data); transition self.match_ok == 1 { true -> push_next() _ -> bad() } }
    state u64_ordinals() { transition self.j < 6 { true -> push_u64_check() _ -> push_u8_check() } }
    state push_u64_check() { transition self.param_kinds[self.current_param] == 6 { true -> push_next() _ -> bad() } }
    state push_u8_check() { transition self.param_kinds[self.current_param] == 1 { true -> push_next() _ -> bad() } }
    state push_next() { self.j=self.j+1; self.current_param=self.machine_param_starts[self.scan_machine]+self.j; transition 0 { _ -> push_type_loop() } }
    state push_unique() { transition self.push_machine < 0 { true -> push_save() _ -> bad() } }
    state push_save() { self.push_machine=self.scan_machine; transition 0 { _ -> next() } }
    state lookup_count() { transition self.machine_param_counts[self.scan_machine] == 1 { true -> lookup_param() _ -> bad() } }
    state lookup_param() { self.current_param=self.machine_param_starts[self.scan_machine]; transition self.param_kinds[self.current_param] == 6 { true -> lookup_access() _ -> bad() } }
    state lookup_access() { transition self.machine_access[self.scan_machine] == 1 { true -> lookup_result() _ -> bad() } }
    state lookup_result() { transition self.machine_result_kinds[self.scan_machine] == 1 { true -> lookup_unique() _ -> bad() } }
    state lookup_unique() { transition self.lookup_machine < 0 { true -> lookup_save() _ -> bad() } }
    state lookup_save() { self.lookup_machine=self.scan_machine; self.index_param=self.current_param; transition 0 { _ -> next() } }
    state root_owner() { self.owner_names_data(self.scan_machine,self.root_data); transition self.match_ok == 1 { true -> run_signature() _ -> bad() } }
    state run_signature() { transition self.machine_param_counts[self.scan_machine] == 0 { true -> run_access() _ -> bad() } }
    state run_access() { transition self.machine_access[self.scan_machine] == 2 { true -> run_result() _ -> bad() } }
    state run_result() { transition self.machine_result_kinds[self.scan_machine] == 1 { true -> run_unique() _ -> bad() } }
    state run_unique() { transition self.run_machine < 0 { true -> run_save() _ -> bad() } }
    state run_save() { self.run_machine=self.scan_machine; transition 0 { _ -> next() } }
    state next() { self.scan_machine=self.scan_machine+1; transition 0 { _ -> loop() } }
    state complete() { transition self.machine_count == 3 { true -> all_push() _ -> bad() } }
    state all_push() { transition self.push_machine >= 0 { true -> all_lookup() _ -> bad() } }
    state all_lookup() { transition self.lookup_machine >= 0 { true -> all_run() _ -> bad() } }
    state all_run() { transition self.run_machine >= 0 { true -> root_owner_name() _ -> bad() } }
    state root_owner_name() { transition self.data_name_lens[self.root_data] == self.root_owner_len { true -> root_owner_compare() _ -> bad() } }
    state root_owner_compare() { self.bytes_equal(self.source_start+self.data_names[self.root_data],self.root_owner_start,self.root_owner_len); transition self.match_ok == 1 { true -> root_machine_name() _ -> bad() } }
    state root_machine_name() { transition self.machine_name_lens[self.run_machine] == self.root_machine_len { true -> root_machine_compare() _ -> bad() } }
    state root_machine_compare() { self.bytes_equal(self.source_start+self.machine_names[self.run_machine],self.root_machine_start,self.root_machine_len); transition self.match_ok == 1 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::begin_machine_body(&mut self, machine: i32) {
