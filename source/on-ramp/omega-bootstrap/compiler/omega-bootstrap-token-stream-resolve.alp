        self.v12_payload(0,8,self.current_param); self.v12_payload(1,15,self.current_param+1); self.v12_payload(2,15,self.current_param+2);
        self.current_field=self.data_case_starts[self.token_kind_data]+2; self.current_param=self.case_payload_starts[self.current_field];
        self.v12_payload(3,15,self.current_param); self.v12_payload(4,15,self.current_param+1); self.v12_payload(5,15,self.current_param+2);
