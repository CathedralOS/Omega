machine Main::begin_call(&mut self, slot: i32, target: i32) {
    self.expect_self_field(self.stream_field); self.expect_token(46); transition self.status == 0 { true -> target_name() _ -> done() }
    state target_name() { self.machine_name_is_token(target); transition self.match_ok == 1 { true -> save() _ -> bad() } }
    state save() { self.call_starts[slot]=self.tok_start-self.source_start; self.next_token(); self.expect_token(40); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::finish_call(&mut self, slot: i32, arguments: i32) {
    transition self.tok == 41 { true -> save() _ -> bad() }
    state save() { self.call_lengths[slot]=self.tok_start+self.tok_len-self.source_start-self.call_starts[slot]; self.call_argument_counts[slot]=arguments; self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_run_argument(&mut self, ordinal: i32, expected: i32) {
    transition self.tok == 257 { true -> kind() _ -> bad() }
    state kind() { self.current_param=self.push_params[ordinal]; transition self.param_kinds[self.current_param] == 1 { true -> u8_bound() _ -> u64_check() } }
    state u8_bound() { transition self.int_value <= 255 { true -> expected_value() _ -> bad() } }
    state u64_check() { transition self.param_kinds[self.current_param] == 6 { true -> expected_value() _ -> bad() } }
    state expected_value() { transition self.int_value == expected { true -> save() _ -> bad() } }
    state save() { self.argument_values[ordinal]=self.int_value; self.next_token(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::parse_run_body(&mut self) {
    self.begin_machine_body(self.run_machine); self.begin_call(0,self.push_machine); transition self.status == 0 { true -> source_type() _ -> done() }
    state source_type() { self.expect_data_name(self.source_id_data); self.expect_token(123); self.field_name_is_token(self.source_value_field); transition self.match_ok == 1 { true -> source_equal() _ -> bad() } }
    state source_equal() { self.next_token(); self.expect_token(58); self.expect_integer(4); self.expect_token(125); self.expect_token(44); self.expect_data_name(self.token_kind_data); self.expect_token(58); self.expect_token(58); self.expect_case_name(self.float_case); self.expect_token(123); transition self.status == 0 { true -> float0() _ -> done() } }
    state float0() { self.current_field=self.case_payload_starts[self.float_case]; self.expect_payload_name(self.current_field); self.expect_token(58); self.expect_word(53,4); self.expect_token(44); self.expect_payload_name(self.current_field+1); self.expect_token(58); self.expect_word(57,5); self.expect_token(44); self.expect_payload_name(self.current_field+2); self.expect_token(58); self.expect_word(53,4); self.expect_token(125); self.expect_token(44); transition self.status == 0 { true -> scalar2() _ -> done() } }
    state scalar2() { self.parse_run_argument(2,5); self.expect_token(44); transition self.status == 0 { true -> scalar3() _ -> done() } }
    state scalar3() { self.parse_run_argument(3,6); self.expect_token(44); transition self.status == 0 { true -> scalar4() _ -> done() } }
    state scalar4() { self.parse_run_argument(4,7); self.expect_token(44); transition self.status == 0 { true -> scalar5() _ -> done() } }
    state scalar5() { self.parse_run_argument(5,8); self.expect_token(44); transition self.status == 0 { true -> scalar6() _ -> done() } }
    state scalar6() { self.parse_run_argument(6,70); self.expect_token(44); transition self.status == 0 { true -> scalar7() _ -> done() } }
    state scalar7() { self.parse_run_argument(7,1); self.expect_token(44); transition self.status == 0 { true -> scalar8() _ -> done() } }
    state scalar8() { self.parse_run_argument(8,2); self.expect_token(44); transition self.status == 0 { true -> scalar9() _ -> done() } }
    state scalar9() { self.parse_run_argument(9,3); transition self.status == 0 { true -> push_end() _ -> done() } }
    state push_end() { self.finish_call(0,10); self.expect_token(59); self.begin_call(1,self.lookup_machine); self.expect_integer(0); self.finish_call(1,1); transition self.status == 0 { true -> close() _ -> done() } }
    state close() { self.expect_token(125); transition self.status == 0 { true -> exact() _ -> done() } }
