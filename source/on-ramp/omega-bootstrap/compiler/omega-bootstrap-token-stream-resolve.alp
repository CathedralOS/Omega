machine Main::parse_lookup_body(&mut self) {
    self.begin_machine_body(self.lookup_machine); self.expect_word(43,10); self.expect_parameter(self.index_param); self.expect_token(60); self.expect_self_field(self.count_field);
    self.expect_token(123); self.expect_word(53,4); self.expect_arrow(); self.capture_target_name(2); self.expect_underscore(); self.expect_arrow(); self.capture_target_name(3); self.expect_token(125);
    transition self.status == 0 { true -> distinct() _ -> done() }
    state distinct() { transition self.block_name_lens[2] == self.block_name_lens[3] { true -> distinct_compare() _ -> states_begin() } }
    state distinct_compare() { self.stored_spans_equal(self.block_name_starts[2],self.block_name_starts[3],self.block_name_lens[2]); transition self.match_ok == 1 { true -> bad() _ -> states_begin() } }
    state states_begin() { self.capture_read_state(2,0,0); transition self.status == 0 { true -> exponent() _ -> done() } }
    state exponent() { self.capture_read_state(4,0,3); transition self.status == 0 { true -> empty() _ -> done() } }
    state empty() { self.capture_read_state(5,3,2); transition self.status == 0 { true -> suffix() _ -> done() } }
    state suffix() { self.capture_read_state(6,5,1); transition self.status == 0 { true -> retained() _ -> done() } }
    state retained() { self.capture_read_state(7,6,0); transition self.status == 0 { true -> absent() _ -> done() } }
    state absent() { self.capture_read_state(3,6,0); transition self.status == 0 { true -> outer_close() _ -> done() } }
    state outer_close() { self.expect_token(125); transition self.status == 0 { true -> exact() _ -> done() } }
    state exact() { transition self.tok == 0 { true -> complete0() _ -> bad() } }
    state complete0() { transition self.block_body_lengths[2] > 0 { true -> complete1() _ -> bad() } }
    state complete1() { transition self.block_body_lengths[3] > 0 { true -> complete2() _ -> bad() } }
    state complete2() { transition self.block_body_lengths[4] > 0 { true -> complete3() _ -> bad() } }
    state complete3() { transition self.block_body_lengths[5] > 0 { true -> complete4() _ -> bad() } }
    state complete4() { transition self.block_body_lengths[6] > 0 { true -> complete5() _ -> bad() } }
    state complete5() { transition self.block_body_lengths[7] > 0 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

