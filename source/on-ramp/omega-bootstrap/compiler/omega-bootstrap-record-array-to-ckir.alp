// Focused OMGLOWK20 (OMGCOMP1 + OMGRSWB) -> CKIR19 lowerer.  The selected
// semantic witness is validated and paired to its source spans before any
// checked-IR byte is published.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
    machine write_byte(byte: i32);
}
data Main {
    console: Console;
    status: i32; c: i32; n: i32; i: i32; j: i32; x: i32; y: i32;
    decoded: i32; total: i32; comp_n: i32; witness_n: i32;
    comp: i32; witness: i32; bundle: i32; bundle_length: i32;
    string_length: i32; source_start: i32; source_length: i32;
    buffer_n: i32; at: i32; row: i32; start: i32; count: i32; word: i32;
    match_ok: i32; char_ok: i32;
    input: [u8; 269485];
    publication: [i32; 1587];
}

machine Main::reject(&mut self) {
    transition self.status == 0 { true -> set_status() _ -> done() }
    state set_status() { self.status=251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::exhaust(&mut self) {
    transition self.status == 0 { true -> set_status() _ -> done() }
    state set_status() { self.status=252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::slurp(&mut self) {
    self.n=0; transition 0 { _ -> read_next() }
    state read_next() { self.c=read_byte(); transition self.c < 0 { true -> done() _ -> room() } }
    state room() { transition self.n < 269485 { true -> store() _ -> over() } }
    state store() { self.input[self.n]=self.c; self.n=self.n+1; transition self.n > 269484 { true -> over() _ -> read_next() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_u32(&mut self, position: i32) {
    self.decoded=0-1;
    transition position >= 0 { true -> room() _ -> bad() }
    state room() { transition position <= self.n-4 { true -> signed() _ -> bad() } }
    state signed() { transition self.input[position+3] < 128 { true -> value() _ -> bad() } }
    state value() {
        self.decoded=self.input[position]+self.input[position+1]*256
            +self.input[position+2]*65536+self.input[position+3]*16777216;
        transition 0 { _ -> done() }
    }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_u32(&mut self, position: i32, value: i32) {
    self.read_u32(position); transition self.status == 0 { true -> equal() _ -> done() }
    state equal() { transition self.decoded == value { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_byte(&mut self, position: i32, value: i32) {
    transition position >= 0 { true -> room() _ -> bad() }
    state room() { transition position < self.n { true -> equal() _ -> bad() } }
    state equal() { transition self.input[position] == value { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_no_id(&mut self, position: i32) {
    self.expect_byte(position,255); self.expect_byte(position+1,255);
    self.expect_byte(position+2,255); self.expect_byte(position+3,255);
}

machine Main::validate_outer(&mut self) {
    transition self.n >= 32 { true -> magic() _ -> bad() }
    state magic() {
        self.expect_byte(0,79); self.expect_byte(1,77); self.expect_byte(2,71);
        self.expect_byte(3,76); self.expect_byte(4,79); self.expect_byte(5,87);
        self.expect_byte(6,75); self.expect_byte(7,0);
        transition self.status == 0 { true -> fixed() _ -> done() }
    }
    state fixed() {
        self.expect_byte(8,20); self.expect_byte(9,0); self.expect_byte(10,0);
        self.expect_byte(11,0); self.expect_byte(12,0); self.expect_byte(13,0);
        self.expect_byte(14,32); self.expect_byte(15,0); self.expect_u32(28,11);
        transition self.status == 0 { true -> lengths() _ -> done() }
    }
    state lengths() {
        self.read_u32(16); self.total=self.decoded;
        self.read_u32(20); self.comp_n=self.decoded;
        self.read_u32(24); self.witness_n=self.decoded;
        transition self.status == 0 { true -> comp_limit() _ -> done() }
    }
    state comp_limit() { transition self.comp_n <= 267280 { true -> witness_exact() _ -> over() } }
    state witness_exact() { transition self.witness_n == 2172 { true -> exact_sum() _ -> bad() } }
    state exact_sum() { transition self.total == 32+self.comp_n+self.witness_n { true -> exact_input() _ -> bad() } }
    state exact_input() { transition self.total == self.n { true -> save() _ -> bad() } }
    state save() { self.comp=32; self.witness=32+self.comp_n; transition 0 { _ -> done() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_compilation(&mut self) {
    transition self.comp_n >= 154 { true -> magic() _ -> bad() }
    state magic() {
        self.expect_byte(self.comp,79); self.expect_byte(self.comp+1,77); self.expect_byte(self.comp+2,71);
        self.expect_byte(self.comp+3,67); self.expect_byte(self.comp+4,79); self.expect_byte(self.comp+5,77);
        self.expect_byte(self.comp+6,80); self.expect_byte(self.comp+7,0);
        self.expect_byte(self.comp+8,1); self.expect_byte(self.comp+9,0);
        self.expect_byte(self.comp+10,0); self.expect_byte(self.comp+11,0);
        self.expect_byte(self.comp+12,1); self.expect_byte(self.comp+13,0);
        self.expect_byte(self.comp+14,0); self.expect_byte(self.comp+15,0);
        self.expect_u32(self.comp+16,self.comp_n);
        transition self.status == 0 { true -> header() _ -> done() }
    }
    state header() {
        self.read_u32(self.comp+20); self.bundle_length=self.decoded;
        self.read_u32(self.comp+24); self.string_length=self.decoded;
        self.expect_u32(self.comp+32,1); self.expect_u32(self.comp+36,1);
        self.expect_u32(self.comp+40,0); self.expect_u32(self.comp+44,0);
        self.expect_u32(self.comp+48,0); self.expect_u32(self.comp+60,0);
        transition self.status == 0 { true -> fixed_rows() _ -> done() }
    }
    state fixed_rows() {
        self.expect_u32(self.comp+64,0); self.expect_u32(self.comp+100,0);
        self.expect_u32(self.comp+104,1); self.expect_u32(self.comp+108,0);
        self.expect_u32(self.comp+112,0); self.expect_u32(self.comp+116,0);
        self.expect_u32(self.comp+120,0); self.read_u32(self.comp+124); self.x=self.decoded;
        self.expect_u32(self.comp+128,0);
        transition self.status == 0 { true -> string_range() _ -> done() }
    }
    state string_range() { self.read_u32(self.comp+28); transition self.x < self.decoded { true -> bundle_offset() _ -> bad() } }
    state bundle_offset() { self.bundle=self.comp+132+self.string_length; transition self.bundle <= self.comp+self.comp_n { true -> bundle_extent() _ -> bad() } }
    state bundle_extent() { transition self.bundle_length == self.comp+self.comp_n-self.bundle { true -> bundle_header() _ -> bad() } }
    state bundle_header() {
        self.expect_byte(self.bundle,79); self.expect_byte(self.bundle+1,77); self.expect_byte(self.bundle+2,71);
        self.expect_byte(self.bundle+3,48); self.expect_byte(self.bundle+4,66); self.expect_byte(self.bundle+5,78);
        self.expect_byte(self.bundle+6,68); self.expect_byte(self.bundle+7,76);
        self.expect_u32(self.bundle+8,1); self.expect_u32(self.bundle+12,1);
        self.read_u32(self.bundle+16); self.x=self.decoded;
        self.read_u32(self.bundle+20); self.source_length=self.decoded;
        transition self.status == 0 { true -> source_limit() _ -> done() }
    }
    state source_limit() { transition self.source_length <= 131072 { true -> source_extent() _ -> over() } }
    state source_extent() { self.source_start=self.bundle+24+self.x; transition self.source_length == self.comp+self.comp_n-self.source_start { true -> done() _ -> bad() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::span_bounds(&mut self, relative: i32, length: i32) {
    self.match_ok=0;
    transition relative >= 0 { true -> length_nonnegative() _ -> done() }
    state length_nonnegative() { transition length >= 0 { true -> room() _ -> done() } }
    state room() { transition relative <= self.source_length-length { true -> yes() _ -> done() } }
    state yes() { self.match_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::is_ident_start(&mut self) {
    self.char_ok=0; transition self.c == 95 { true -> yes() _ -> upper0() }
    state upper0() { transition self.c >= 65 { true -> upper1() _ -> lower0() } }
    state upper1() { transition self.c < 91 { true -> yes() _ -> lower0() } }
    state lower0() { transition self.c >= 97 { true -> lower1() _ -> done() } }
    state lower1() { transition self.c < 123 { true -> yes() _ -> done() } }
    state yes() { self.char_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::is_ident_continue(&mut self) {
    self.is_ident_start(); transition self.char_ok == 1 { true -> done() _ -> digit0() }
    state digit0() { transition self.c >= 48 { true -> digit1() _ -> done() } }
    state digit1() { transition self.c < 58 { true -> yes() _ -> done() } }
    state yes() { self.char_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_identifier_span(&mut self, relative: i32, length: i32) {
    self.span_bounds(relative,length); transition self.match_ok == 1 { true -> nonempty() _ -> bad() }
    state nonempty() { transition length >= 1 { true -> ceiling() _ -> bad() } }
    state ceiling() { transition length <= 64 { true -> first() _ -> over() } }
    state first() { self.c=self.input[self.source_start+relative]; self.is_ident_start(); transition self.char_ok == 1 { true -> rest_begin() _ -> bad() } }
    state rest_begin() { self.i=1; transition 0 { _ -> rest() } }
    state rest() { transition self.i < length { true -> byte() _ -> done() } }
    state byte() { self.c=self.input[self.source_start+relative+self.i]; self.is_ident_continue(); transition self.char_ok == 1 { true -> advance() _ -> bad() } }
    state advance() { self.i=self.i+1; transition 0 { _ -> rest() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_body_span(&mut self, relative: i32, length: i32) {
    self.span_bounds(relative,length); transition self.match_ok == 1 { true -> minimum() _ -> bad() }
    state minimum() { transition length >= 2 { true -> open() _ -> bad() } }
    state open() { transition self.input[self.source_start+relative] == 123 { true -> close() _ -> bad() } }
    state close() { transition self.input[self.source_start+relative+length-1] == 125 { true -> done() _ -> bad() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::source_spans_equal(&mut self, left: i32, right: i32, length: i32) {
    self.match_ok=0; self.i=0; transition 0 { _ -> loop() }
    state loop() { transition self.i < length { true -> byte() _ -> yes() } }
    state byte() { transition self.input[self.source_start+left+self.i] == self.input[self.source_start+right+self.i] { true -> advance() _ -> done() } }
    state advance() { self.i=self.i+1; transition 0 { _ -> loop() } }
    state yes() { self.match_ok=1; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_v11_dense(&mut self, start: i32, rows: i32, width: i32) {
    self.row=0; transition 0 { _ -> loop() }
    state loop() { transition self.row < rows { true -> one() _ -> done() } }
    state one() { self.expect_u32(self.witness+start+self.row*width,self.row); self.row=self.row+1; transition self.status == 0 { true -> loop() _ -> done() } }
    state done() { }
}

machine Main::validate_v11_header(&mut self) {
    transition self.witness_n == 2172 { true -> magic() _ -> bad() }
    state magic() {
        self.expect_byte(self.witness,79); self.expect_byte(self.witness+1,77); self.expect_byte(self.witness+2,71); self.expect_byte(self.witness+3,82);
        self.expect_byte(self.witness+4,83); self.expect_byte(self.witness+5,87); self.expect_byte(self.witness+6,66); self.expect_byte(self.witness+7,0);
        self.expect_byte(self.witness+8,11); self.expect_byte(self.witness+9,0); self.expect_byte(self.witness+10,0); self.expect_byte(self.witness+11,0);
        self.expect_byte(self.witness+12,0); self.expect_byte(self.witness+13,0); self.expect_byte(self.witness+14,160); self.expect_byte(self.witness+15,0);
        transition self.status == 0 { true -> fixed0() _ -> done() }
    }
    state fixed0() { self.expect_u32(self.witness+16,2172); self.expect_u32(self.witness+20,self.comp_n); self.expect_u32(self.witness+24,1); self.expect_u32(self.witness+28,10); self.expect_u32(self.witness+32,3); self.expect_u32(self.witness+36,13); transition self.status == 0 { true -> fixed1() _ -> done() } }
    state fixed1() { self.expect_u32(self.witness+40,3); self.expect_u32(self.witness+44,10); self.expect_u32(self.witness+48,7); self.expect_u32(self.witness+52,2); self.expect_u32(self.witness+56,9); self.expect_u32(self.witness+60,9); transition self.status == 0 { true -> fixed2() _ -> done() } }
    state fixed2() { self.expect_u32(self.witness+64,2); self.expect_u32(self.witness+68,0); self.expect_u32(self.witness+72,1); self.expect_u32(self.witness+76,2); self.expect_u32(self.witness+80,0); self.expect_u32(self.witness+84,1); self.expect_u32(self.witness+88,16384); transition self.status == 0 { true -> fixed3() _ -> done() } }
    state fixed3() { self.expect_u32(self.witness+92,1); self.expect_u32(self.witness+96,2); self.expect_u32(self.witness+100,3); self.expect_u32(self.witness+104,4); self.expect_u32(self.witness+108,5); self.expect_u32(self.witness+112,6); self.expect_u32(self.witness+116,7); transition self.status == 0 { true -> fixed4() _ -> done() } }
    state fixed4() { self.expect_u32(self.witness+120,8); self.expect_u32(self.witness+124,9); self.expect_u32(self.witness+128,1); self.i=132; transition 0 { _ -> reserved() } }
    state reserved() { transition self.i < 160 { true -> reserved_one() _ -> unit() } }
    state reserved_one() { self.expect_u32(self.witness+self.i,0); self.i=self.i+4; transition self.status == 0 { true -> reserved() _ -> done() } }
    state unit() { self.expect_u32(self.witness+160,0); self.expect_u32(self.witness+164,0); self.expect_u32(self.witness+168,0); self.expect_u32(self.witness+172,self.source_length); self.expect_u32(self.witness+176,0); transition 0 { _ -> done() } }
    state bad() { self.reject(); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::v11_expected_scalar_type(&mut self) {
    self.y=4; transition self.row < 4 { true -> u8() _ -> u32_check() }
    state u8() { self.y=1; transition 0 { _ -> done() } }
    state u32_check() { transition self.row == 4 { true -> u32() _ -> done() } }
    state u32() { self.y=2; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_v11_types_records(&mut self) {
    self.row=0; transition 0 { _ -> types() }
    state types() { transition self.row < 10 { true -> type_one() _ -> type_payloads() } }
    state type_one() { self.at=self.witness+180+self.row*32; self.x=4; self.y=0; transition self.row == 0 { true -> type_unit() _ -> type_u8_check() } }
    state type_unit() { self.x=0; transition 0 { _ -> type_fixed() } }
    state type_u8_check() { transition self.row == 1 { true -> type_u8() _ -> type_u32_check() } }
    state type_u8() { self.x=1; transition 0 { _ -> type_fixed() } }
    state type_u32_check() { transition self.row == 2 { true -> type_u32() _ -> type_bool_check() } }
    state type_u32() { self.x=2; self.y=1; transition 0 { _ -> type_fixed() } }
    state type_bool_check() { transition self.row == 3 { true -> type_bool() _ -> type_u64_check() } }
    state type_bool() { self.x=3; transition 0 { _ -> type_fixed() } }
    state type_u64_check() { transition self.row < 6 { true -> type_u64() _ -> type_array_check() } }
    state type_u64() { self.x=10; transition self.row == 4 { true -> type_trap() _ -> type_fixed() } }
    state type_trap() { self.y=1; transition 0 { _ -> type_fixed() } }
    state type_array_check() { transition self.row == 6 { true -> type_array() _ -> type_fixed() } }
    state type_array() { self.x=5; self.y=1; transition 0 { _ -> type_fixed() } }
    state type_fixed() { self.expect_u32(self.at,self.row); self.expect_byte(self.at+4,self.x); self.expect_byte(self.at+5,self.y); self.expect_byte(self.at+6,0); self.expect_byte(self.at+7,0); self.row=self.row+1; transition self.status == 0 { true -> types() _ -> done() } }
    state type_payloads() { self.expect_u32(self.witness+180+1*32+24,255); self.expect_no_id(self.witness+180+2*32+24); self.expect_u32(self.witness+180+3*32+24,1); self.expect_no_id(self.witness+180+4*32+24); self.expect_no_id(self.witness+180+4*32+28); self.expect_u32(self.witness+180+5*32+24,16384); self.expect_u32(self.witness+180+6*32+8,7); self.expect_u32(self.witness+180+6*32+12,16384); self.row=0; transition self.status == 0 { true -> records() _ -> done() } }
    state records() { transition self.row < 3 { true -> record_one() _ -> done() } }
    state record_one() { self.at=self.witness+500+self.row*32; self.expect_u32(self.at,self.row); self.expect_u32(self.at+4,0); self.expect_u32(self.at+8,7+self.row); self.x=12; self.y=1; transition self.row == 0 { true -> obs_record() _ -> stream_check() } }
    state obs_record() { self.x=0; self.y=9; transition 0 { _ -> record_fixed() } }
    state stream_check() { transition self.row == 1 { true -> stream_record() _ -> record_fixed() } }
    state stream_record() { self.x=9; self.y=3; transition 0 { _ -> record_fixed() } }
    state record_fixed() { self.expect_u32(self.at+12,self.x); self.expect_u32(self.at+16,self.y); self.read_u32(self.at+20); self.x=self.decoded; self.read_u32(self.at+24); self.y=self.decoded; self.validate_identifier_span(self.x,self.y); self.x=0; transition self.row == 0 { true -> copy_flag() _ -> record_flag() } }
    state copy_flag() { self.x=1; transition 0 { _ -> record_flag() } }
    state record_flag() { self.expect_u32(self.at+28,self.x); self.row=self.row+1; transition self.status == 0 { true -> records() _ -> done() } }
    state done() { }
}

machine Main::validate_v11_fields(&mut self) {
    self.row=0; transition 0 { _ -> loop() }
    state loop() { transition self.row < 13 { true -> one() _ -> done() } }
    state one() { self.at=self.witness+596+self.row*24; self.expect_u32(self.at,self.row); self.x=2; transition self.row < 9 { true -> obs_owner() _ -> stream_owner_check() } }
    state obs_owner() { self.x=0; transition 0 { _ -> owner_fixed() } }
    state stream_owner_check() { transition self.row < 12 { true -> stream_owner() _ -> owner_fixed() } }
    state stream_owner() { self.x=1; transition 0 { _ -> owner_fixed() } }
    state owner_fixed() { self.expect_u32(self.at+4,self.x); self.x=0; transition self.row < 9 { true -> obs_ordinal() _ -> stream_ordinal_check() } }
    state obs_ordinal() { self.x=self.row; transition 0 { _ -> ordinal_fixed() } }
    state stream_ordinal_check() { transition self.row < 12 { true -> stream_ordinal() _ -> ordinal_fixed() } }
    state stream_ordinal() { self.x=self.row-9; transition 0 { _ -> ordinal_fixed() } }
    state ordinal_fixed() { self.expect_u32(self.at+8,self.x); self.y=8; transition self.row < 9 { true -> scalar_type() _ -> array_check() } }
    state scalar_type() { self.v11_expected_scalar_type(); transition 0 { _ -> type_fixed() } }
    state array_check() { transition self.row == 9 { true -> array_type() _ -> count_check() } }
    state array_type() { self.y=6; transition 0 { _ -> type_fixed() } }
    state count_check() { transition self.row == 10 { true -> count_type() _ -> bool_check() } }
    state count_type() { self.y=5; transition 0 { _ -> type_fixed() } }
    state bool_check() { transition self.row == 11 { true -> bool_type() _ -> type_fixed() } }
    state bool_type() { self.y=3; transition 0 { _ -> type_fixed() } }
    state type_fixed() { self.expect_u32(self.at+12,self.y); self.read_u32(self.at+16); self.x=self.decoded; self.read_u32(self.at+20); self.y=self.decoded; self.validate_identifier_span(self.x,self.y); self.row=self.row+1; transition self.status == 0 { true -> loop() _ -> done() } }
    state done() { }
}

machine Main::validate_v11_machines(&mut self) {
    self.row=0; transition 0 { _ -> machines() }
    state machines() { transition self.row < 3 { true -> machine_one() _ -> params_begin() } }
    state machine_one() { self.at=self.witness+908+self.row*56; self.expect_u32(self.at,self.row); self.expect_u32(self.at+4,0); self.x=1; transition self.row == 2 { true -> root_owner() _ -> machine_owner() } }
    state root_owner() { self.x=2; transition 0 { _ -> machine_owner() } }
    state machine_owner() { self.expect_u32(self.at+8,self.x); self.x=2; transition self.row == 1 { true -> shared() _ -> access() } }
    state shared() { self.x=1; transition 0 { _ -> access() } }
    state access() { self.expect_u32(self.at+12,self.x); transition self.row == 0 { true -> push_parts() _ -> result_u8() } }
    state result_u8() { self.expect_u32(self.at+16,1); transition self.row == 1 { true -> lookup_parts() _ -> run_parts() } }
    state push_parts() { self.expect_no_id(self.at+16); self.x=0; self.y=9; self.start=0; self.count=3; transition 0 { _ -> parts() } }
    state lookup_parts() { self.x=9; self.y=1; self.start=3; self.count=3; transition 0 { _ -> parts() } }
    state run_parts() { self.x=10; self.y=0; self.start=6; self.count=1; transition 0 { _ -> parts() } }
    state parts() { self.expect_u32(self.at+20,self.x); self.expect_u32(self.at+24,self.y); self.expect_u32(self.at+28,self.start); self.expect_u32(self.at+32,self.count); self.read_u32(self.at+36); self.x=self.decoded; self.read_u32(self.at+40); self.y=self.decoded; self.expect_u32(self.at+52,0); self.validate_identifier_span(self.x,self.y); self.read_u32(self.at+44); self.x=self.decoded; self.read_u32(self.at+48); self.y=self.decoded; self.validate_body_span(self.x,self.y); self.row=self.row+1; transition self.status == 0 { true -> machines() _ -> done() } }
