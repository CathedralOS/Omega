machine Main::emit_u32(&mut self, value: i32) {
    transition value >= 0 { true -> positive() _ -> negative() }
    state positive() {
        write_byte(value & 255); write_byte((value >> 8) & 255);
        write_byte((value >> 16) & 255); write_byte((value >> 24) & 255);
        transition 0 { _ -> done() }
    }
    state negative() {
        self.word = 0 - value - 1;
        write_byte(255 - (self.word & 255)); self.word = self.word / 256;
        write_byte(255 - (self.word & 255)); self.word = self.word / 256;
        write_byte(255 - (self.word & 255)); self.word = self.word / 256;
        write_byte(255 - (self.word & 255)); transition 0 { _ -> done() }
    }
    state done() { }
}

machine Main::publish(&mut self) {
    self.init_v19_publication();
    write_byte(79); write_byte(77); write_byte(71); write_byte(67);
    write_byte(75); write_byte(73); write_byte(82); write_byte(0);
    write_byte(19); write_byte(0); write_byte(0); write_byte(0);
    write_byte(1); write_byte(0); write_byte(1); write_byte(0);
    self.i=0; transition 0 { _ -> words() }
    state words() { transition self.i < 1587 { true -> one() _ -> done() } }
    state one() { self.emit_u32(self.publication[self.i]); self.i=self.i+1; transition 0 { _ -> words() } }
    state done() { }
}

machine Main::main(&mut self) {
    self.status=0; self.slurp(); transition self.status == 0 { true -> outer() _ -> done() }
    state outer() { self.validate_outer(); transition self.status == 0 { true -> compilation() _ -> done() } }
    state compilation() { self.validate_compilation(); transition self.status == 0 { true -> witness_check() _ -> done() } }
    state witness_check() { self.validate_v11(); transition self.status == 0 { true -> output() _ -> done() } }
    state output() { self.publish(); transition 0 { _ -> done() } }
    state done() { self.console.exit_process(self.status); }
}
