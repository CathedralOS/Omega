// Rust-free compact meaning probe for OMGRSWC12-only relation facts.
// Its certificate is extracted from an independently accepted V12 witness;
// inherited OMGRSW11 supplies scalar array/store meaning, while this probe
// joins the new copy/sum/constructor/projection/dispatch facts to result 70.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
    machine write_byte(byte: i32);
}

data Main {
    console: Console;
    status: i32;
    c: i32;
    n: i32;
    input: [u8; 64];
}

machine Main::slurp(&mut self) {
    self.n=0; transition 0 { _ -> read() }
    state read() { self.c=read_byte(); transition self.c < 0 { true -> done() _ -> room() } }
    state room() { transition self.n < 64 { true -> save() _ -> over() } }
    state save() { self.input[self.n]=self.c; self.n=self.n+1; transition 0 { _ -> read() } }
    state over() { self.status=252; transition 0 { _ -> drain() } }
    state drain() { self.c=read_byte(); transition self.c < 0 { true -> done() _ -> drain() } }
    state done() { }
}

machine Main::expect(&mut self, index: i32, value: i32) {
    transition self.status == 0 { true -> compare() _ -> done() }
    state compare() { transition self.input[index] == value { true -> done() _ -> bad() } }
    state bad() { self.status=251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::main(&mut self) {
    self.status=0; self.slurp(); transition self.status == 0 { true -> length() _ -> finish() }
    state length() { transition self.n == 24 { true -> facts0() _ -> bad() } }
    state facts0() { self.expect(0,6); self.expect(1,5); self.expect(2,4); self.expect(3,30); self.expect(4,42); self.expect(5,9); self.expect(6,20); self.expect(7,10); transition self.status == 0 { true -> facts1() _ -> finish() } }
    state facts1() { self.expect(8,15); self.expect(9,20); self.expect(10,4); self.expect(11,78); self.expect(12,1); self.expect(13,0); self.expect(14,1); self.expect(15,70); transition self.status == 0 { true -> facts2() _ -> finish() } }
    state facts2() { self.expect(16,0); self.expect(17,64); self.expect(18,0); self.expect(19,1); self.expect(20,2); self.expect(21,1); self.expect(22,70); self.expect(23,70); transition self.status == 0 { true -> publish() _ -> finish() } }
    state publish() { write_byte(70); transition 0 { _ -> finish() } }
    state bad() { self.status=251; transition 0 { _ -> finish() } }
    state finish() { self.console.exit_process(self.status); }
}
