// Bounded SHA-256 over exact stdin bytes. This is a structural digest producer,
// not accepted-lock, package, source-root, or compilation authority.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
    machine write_byte(value: i32);
}

data Main {
    console: Console;
    status: i32; c: i32; n: i32; total: i32; bit_length: i32;
    block_count: i32; block: i32; round: i32;
    i: i32; j: i32; bit: i32; source_bit: i32;
    source_byte: i32; source_value: i32; value: i32;
    carry: i32; sum: i32; base: i32;
    arg0: i32; arg1: i32; arg2: i32;

    input: [u8; 267281];
    power: [i32; 8];
    hash: [i32; 32];
    saved: [i32; 32];
    work: [i32; 32];
    schedule: [i32; 256];
    constants: [i32; 256];
    scratch: [i32; 64];
}

machine Main::exhaust(&mut self) { self.status = 252; }

machine Main::slurp(&mut self) {
    self.n = 0;
    transition 0 { _ -> read() }
    state read() { self.c = read_byte(); transition self.c < 0 { true -> done() _ -> room() } }
    state room() { transition self.n < 267281 { true -> store() _ -> over() } }
    state store() { self.input[self.n] = self.c; self.n = self.n + 1; transition self.n > 267280 { true -> over() _ -> read() } }
    state over() { self.exhaust(); transition 0 { _ -> done() } }
    state done() { }
}

