machine Main::xor2(&mut self, a: i32, b: i32) -> i32 {
    return ((a / 128) % 2 + (b / 128) % 2) % 2 * 128
        + ((a / 64) % 2 + (b / 64) % 2) % 2 * 64
        + ((a / 32) % 2 + (b / 32) % 2) % 2 * 32
        + ((a / 16) % 2 + (b / 16) % 2) % 2 * 16
        + ((a / 8) % 2 + (b / 8) % 2) % 2 * 8
        + ((a / 4) % 2 + (b / 4) % 2) % 2 * 4
        + ((a / 2) % 2 + (b / 2) % 2) % 2 * 2
        + (a % 2 + b % 2) % 2;
}

machine Main::xor3(&mut self, a: i32, b: i32, c: i32) -> i32 {
    return ((a / 128) % 2 + (b / 128) % 2 + (c / 128) % 2) % 2 * 128
        + ((a / 64) % 2 + (b / 64) % 2 + (c / 64) % 2) % 2 * 64
        + ((a / 32) % 2 + (b / 32) % 2 + (c / 32) % 2) % 2 * 32
        + ((a / 16) % 2 + (b / 16) % 2 + (c / 16) % 2) % 2 * 16
        + ((a / 8) % 2 + (b / 8) % 2 + (c / 8) % 2) % 2 * 8
        + ((a / 4) % 2 + (b / 4) % 2 + (c / 4) % 2) % 2 * 4
        + ((a / 2) % 2 + (b / 2) % 2 + (c / 2) % 2) % 2 * 2
        + (a % 2 + b % 2 + c % 2) % 2;
}

machine Main::and2(&mut self, a: i32, b: i32) -> i32 {
    return ((a / 128) % 2) * ((b / 128) % 2) * 128
        + ((a / 64) % 2) * ((b / 64) % 2) * 64
        + ((a / 32) % 2) * ((b / 32) % 2) * 32
        + ((a / 16) % 2) * ((b / 16) % 2) * 16
        + ((a / 8) % 2) * ((b / 8) % 2) * 8
        + ((a / 4) % 2) * ((b / 4) % 2) * 4
        + ((a / 2) % 2) * ((b / 2) % 2) * 2
        + (a % 2) * (b % 2);
}

machine Main::rotate_work(&mut self, word: i32, amount: i32, destination: i32) {
    self.j = 0;
    transition 0 { _ -> byte_loop() }
    state byte_loop() { transition self.j < 4 { true -> byte_begin() _ -> done() } }
    state byte_begin() { self.scratch[destination + self.j] = 0; self.bit = 0; transition 0 { _ -> bit_loop() } }
    state bit_loop() { transition self.bit < 8 { true -> source() _ -> byte_advance() } }
    state source() { self.source_bit = self.j * 8 + self.bit + 32 - amount; transition self.source_bit >= 32 { true -> wrap() _ -> read() } }
    state wrap() { self.source_bit = self.source_bit - 32; transition 0 { _ -> read() } }
    state read() { self.source_byte = self.source_bit / 8; self.source_value = (self.work[word + self.source_byte] / self.power[self.source_bit % 8]) % 2; self.scratch[destination + self.j] = self.scratch[destination + self.j] + self.source_value * self.power[self.bit]; self.bit = self.bit + 1; transition 0 { _ -> bit_loop() } }
    state byte_advance() { self.j = self.j + 1; transition 0 { _ -> byte_loop() } }
    state done() { }
}

machine Main::rotate_schedule(&mut self, word: i32, amount: i32, destination: i32) {
    self.j = 0;
    transition 0 { _ -> byte_loop() }
    state byte_loop() { transition self.j < 4 { true -> byte_begin() _ -> done() } }
    state byte_begin() { self.scratch[destination + self.j] = 0; self.bit = 0; transition 0 { _ -> bit_loop() } }
    state bit_loop() { transition self.bit < 8 { true -> source() _ -> byte_advance() } }
    state source() { self.source_bit = self.j * 8 + self.bit + 32 - amount; transition self.source_bit >= 32 { true -> wrap() _ -> read() } }
    state wrap() { self.source_bit = self.source_bit - 32; transition 0 { _ -> read() } }
    state read() { self.source_byte = self.source_bit / 8; self.source_value = (self.schedule[word + self.source_byte] / self.power[self.source_bit % 8]) % 2; self.scratch[destination + self.j] = self.scratch[destination + self.j] + self.source_value * self.power[self.bit]; self.bit = self.bit + 1; transition 0 { _ -> bit_loop() } }
    state byte_advance() { self.j = self.j + 1; transition 0 { _ -> byte_loop() } }
    state done() { }
}

machine Main::shift_schedule(&mut self, word: i32, amount: i32, destination: i32) {
    self.j = 0;
    transition 0 { _ -> byte_loop() }
    state byte_loop() { transition self.j < 4 { true -> byte_begin() _ -> done() } }
    state byte_begin() { self.scratch[destination + self.j] = 0; self.bit = 0; transition 0 { _ -> bit_loop() } }
    state bit_loop() { transition self.bit < 8 { true -> source() _ -> byte_advance() } }
    state source() { self.source_bit = self.j * 8 + self.bit - amount; transition self.source_bit >= 0 { true -> read() _ -> bit_advance() } }
    state read() { self.source_byte = self.source_bit / 8; self.source_value = (self.schedule[word + self.source_byte] / self.power[self.source_bit % 8]) % 2; self.scratch[destination + self.j] = self.scratch[destination + self.j] + self.source_value * self.power[self.bit]; transition 0 { _ -> bit_advance() } }
    state bit_advance() { self.bit = self.bit + 1; transition 0 { _ -> bit_loop() } }
    state byte_advance() { self.j = self.j + 1; transition 0 { _ -> byte_loop() } }
    state done() { }
}

machine Main::xor3_scratch(&mut self, first: i32, second: i32, third: i32) {
    self.arg0 = first; self.arg1 = second; self.arg2 = third; self.j = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.j < 4 { true -> value() _ -> done() } }
    state value() { self.value = self.xor3(self.scratch[self.arg0 + self.j], self.scratch[self.arg1 + self.j], self.scratch[self.arg2 + self.j]); self.scratch[self.base + self.j] = self.value; self.j = self.j + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::choose_work(&mut self) {
    self.j = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.j < 4 { true -> first() _ -> done() } }
    state first() { self.value = self.and2(self.work[16 + self.j], self.work[20 + self.j]); self.source_value = self.and2(255 - self.work[16 + self.j], self.work[24 + self.j]); self.sum = self.xor2(self.value, self.source_value); self.scratch[16 + self.j] = self.sum; self.j = self.j + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::majority_work(&mut self) {
    self.j = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.j < 4 { true -> first() _ -> done() } }
    state first() { self.value = self.and2(self.work[self.j], self.work[4 + self.j]); self.source_value = self.and2(self.work[self.j], self.work[8 + self.j]); self.sum = self.xor2(self.value, self.source_value); self.scratch[40 + self.j] = self.sum; self.source_value = self.and2(self.work[4 + self.j], self.work[8 + self.j]); self.sum = self.xor2(self.scratch[40 + self.j], self.source_value); self.scratch[40 + self.j] = self.sum; self.j = self.j + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::sum_schedule4(&mut self) {
    self.j = 3; self.carry = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.j >= 0 { true -> value() _ -> done() } }
    state value() { self.sum = self.schedule[(self.round - 16) * 4 + self.j] + self.scratch[12 + self.j] + self.schedule[(self.round - 7) * 4 + self.j] + self.scratch[28 + self.j] + self.carry; self.schedule[self.round * 4 + self.j] = self.sum % 256; self.carry = self.sum / 256; self.j = self.j - 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::sum_t1(&mut self) {
    self.j = 3; self.carry = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.j >= 0 { true -> value() _ -> done() } }
    state value() { self.sum = self.work[28 + self.j] + self.scratch[12 + self.j] + self.scratch[16 + self.j] + self.constants[self.round * 4 + self.j] + self.schedule[self.round * 4 + self.j] + self.carry; self.scratch[20 + self.j] = self.sum % 256; self.carry = self.sum / 256; self.j = self.j - 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::sum_scratch2(&mut self, destination: i32, first: i32, second: i32) {
    self.j = 3; self.carry = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.j >= 0 { true -> value() _ -> done() } }
    state value() { self.sum = self.scratch[first + self.j] + self.scratch[second + self.j] + self.carry; self.scratch[destination + self.j] = self.sum % 256; self.carry = self.sum / 256; self.j = self.j - 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::sum_work_scratch(&mut self, destination: i32, word: i32, other: i32) {
    self.j = 3; self.carry = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.j >= 0 { true -> value() _ -> done() } }
    state value() { self.sum = self.work[word + self.j] + self.scratch[other + self.j] + self.carry; self.scratch[destination + self.j] = self.sum % 256; self.carry = self.sum / 256; self.j = self.j - 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::padded_byte(&mut self, position: i32) -> i32 {
    transition position < self.n { true -> source() _ -> marker_test() }
    state source() { return self.input[position]; }
    state marker_test() { transition position == self.n { true -> marker() _ -> length_test() } }
    state marker() { return 128; }
    state length_test() { transition position >= self.total - 4 { true -> length() _ -> zero() } }
    state length() {
        transition position == self.total - 4 { true -> length3() _ -> length2_test() }
    }
    state length3() { return (self.bit_length / 16777216) % 256; }
    state length2_test() { transition position == self.total - 3 { true -> length2() _ -> length1_test() } }
    state length2() { return (self.bit_length / 65536) % 256; }
    state length1_test() { transition position == self.total - 2 { true -> length1() _ -> length0() } }
    state length1() { return (self.bit_length / 256) % 256; }
    state length0() { return self.bit_length % 256; }
    state zero() { return 0; }
}

machine Main::load_block(&mut self) {
    self.i = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < 64 { true -> load() _ -> done() } }
    state load() { self.value = self.padded_byte(self.block * 64 + self.i); self.schedule[self.i] = self.value; self.i = self.i + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::expand_schedule(&mut self) {
    self.round = 16;
    transition 0 { _ -> loop() }
    state loop() { transition self.round < 64 { true -> sigma0a() _ -> done() } }
    state sigma0a() { self.base = (self.round - 15) * 4; self.rotate_schedule(self.base, 7, 0); self.rotate_schedule(self.base, 18, 4); self.shift_schedule(self.base, 3, 8); self.base = 12; self.xor3_scratch(0, 4, 8); transition 0 { _ -> sigma1() } }
    state sigma1() { self.base = (self.round - 2) * 4; self.rotate_schedule(self.base, 17, 16); self.rotate_schedule(self.base, 19, 20); self.shift_schedule(self.base, 10, 24); self.base = 28; self.xor3_scratch(16, 20, 24); transition 0 { _ -> sum() } }
    state sum() { self.sum_schedule4(); self.round = self.round + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::init_work(&mut self) {
    self.i = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < 32 { true -> copy() _ -> done() } }
    state copy() { self.saved[self.i] = self.hash[self.i]; self.work[self.i] = self.hash[self.i]; self.i = self.i + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::rounds(&mut self) {
    self.round = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.round < 64 { true -> sigma1() _ -> done() } }
    state sigma1() { self.rotate_work(16, 6, 0); self.rotate_work(16, 11, 4); self.rotate_work(16, 25, 8); self.base = 12; self.xor3_scratch(0, 4, 8); self.choose_work(); self.sum_t1(); transition 0 { _ -> sigma0() } }
    state sigma0() { self.rotate_work(0, 2, 24); self.rotate_work(0, 13, 28); self.rotate_work(0, 22, 32); self.base = 36; self.xor3_scratch(24, 28, 32); self.majority_work(); self.sum_scratch2(44, 36, 40); self.sum_work_scratch(48, 12, 20); self.sum_scratch2(52, 20, 44); transition 0 { _ -> shift() } }
    state shift() {
        self.j = 0; transition 0 { _ -> shift_loop() }
    }
    state shift_loop() { transition self.j < 4 { true -> shift_words() _ -> advance() } }
    state shift_words() { self.work[28 + self.j] = self.work[24 + self.j]; self.work[24 + self.j] = self.work[20 + self.j]; self.work[20 + self.j] = self.work[16 + self.j]; self.work[16 + self.j] = self.scratch[48 + self.j]; self.work[12 + self.j] = self.work[8 + self.j]; self.work[8 + self.j] = self.work[4 + self.j]; self.work[4 + self.j] = self.work[self.j]; self.work[self.j] = self.scratch[52 + self.j]; self.j = self.j + 1; transition 0 { _ -> shift_loop() } }
    state advance() { self.round = self.round + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::commit_hash(&mut self) {
    self.base = 0;
    transition 0 { _ -> word_loop() }
    state word_loop() { transition self.base < 32 { true -> word_begin() _ -> done() } }
    state word_begin() { self.j = 3; self.carry = 0; transition 0 { _ -> byte_loop() } }
    state byte_loop() { transition self.j >= 0 { true -> add() _ -> word_advance() } }
    state add() { self.sum = self.saved[self.base + self.j] + self.work[self.base + self.j] + self.carry; self.hash[self.base + self.j] = self.sum % 256; self.carry = self.sum / 256; self.j = self.j - 1; transition 0 { _ -> byte_loop() } }
    state word_advance() { self.base = self.base + 4; transition 0 { _ -> word_loop() } }
    state done() { }
}

machine Main::hash_blocks(&mut self) {
    self.bit_length = self.n * 8;
    self.block_count = (self.n + 72) / 64;
    self.total = self.block_count * 64;
    self.block = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.block < self.block_count { true -> load() _ -> done() } }
    state load() { self.load_block(); self.expand_schedule(); self.init_work(); self.rounds(); self.commit_hash(); self.block = self.block + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::publish(&mut self) {
    self.i = 0;
    transition 0 { _ -> loop() }
    state loop() { transition self.i < 32 { true -> byte() _ -> done() } }
    state byte() { write_byte(self.hash[self.i]); self.i = self.i + 1; transition 0 { _ -> loop() } }
    state done() { }
}

machine Main::main(&mut self) {
    self.slurp();
    transition self.status == 0 { true -> initialize() _ -> stop() }
    state initialize() { self.init_constants(); self.hash_blocks(); self.publish(); transition 0 { _ -> stop() } }
    state stop() { self.console.exit_process(self.status); }
}
