machine Main::read_text(&mut self) {
    self.c = read_byte();
    transition self.c < 0 { true -> bad() false -> low() }
    state low() { self.text_len = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> high() } }
    state high() { self.text_len = self.text_len + self.c * 256; self.expect_byte(0); self.expect_byte(0); transition self.status == 0 { true -> capacity() false -> done() } }
    state capacity() { transition self.text_len <= 1024 - self.text_used { true -> setup() false -> exhausted() } }
    state setup() {
        self.write_starts[self.write_index] = self.text_used;
        self.write_lengths[self.write_index] = self.text_len;
        self.i = 0;
        transition 0 { _ -> loop() }
    }
    state loop() { transition self.i < self.text_len { true -> byte() false -> done() } }
    state byte() { self.c = read_byte(); transition self.c < 0 { true -> bad() false -> store() } }
    state store() { self.text[self.text_used + self.i] = self.c; self.i = self.i + 1; transition 0 { _ -> loop() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() {
        transition self.status == 0 { true -> retained() false -> finish() }
    }
    state retained() { self.text_used = self.text_used + self.text_len; self.write_index = self.write_index + 1; transition 0 { _ -> finish() } }
    state finish() { }
}

machine Main::read_exit_code(&mut self) {
    self.c = read_byte();
    transition self.c < 0 { true -> bad() false -> byte0() }
    state byte0() { self.exit0 = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> byte1() } }
    state byte1() { self.exit1 = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> byte2() } }
    state byte2() { self.exit2 = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> range() } }
    state range() { transition self.c < 128 { true -> byte3() false -> bad() } }
    state byte3() { self.exit3 = self.c; self.expect_zeroes(12); transition 0 { _ -> done() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::decode_terminal_module(&mut self) {
    self.expect_byte(80); self.expect_byte(83); self.expect_byte(73); self.expect_byte(84);
    self.expect_byte(69); self.expect_byte(82); self.expect_byte(77); self.expect_byte(0);
    self.expect_u16(26); self.expect_u16(28); self.read_id();
    self.entry_machine_id = self.id_value;

    // A zero-write closure has no byte-sequence type or write_line boundary.
    // One-or-more writes share the O0 structural envelope. A zero structural
    // type count selects the disjoint scalar call/return lane.
    self.read_small_u32();
    transition self.status == 0 { true -> structural_type_count() false -> done() }
    state structural_type_count() {
        transition self.word {
            0 -> scalar()
            1 -> o1_no_writes()
            2 -> o1_with_writes()
            _ -> bad()
        }
    }
    state scalar() { self.mode = 1; self.decode_scalar_module_tail(); transition 0 { _ -> done() } }
    state o1_no_writes() { self.has_writes = 0; transition 0 { _ -> o1_entry() } }
    state o1_with_writes() { self.has_writes = 1; transition 0 { _ -> o1_entry() } }
    state o1_entry() { transition self.entry_machine_id == 1 { true -> main_type() false -> bad() } }
    state main_type() {
    self.expect_id(1); self.expect_u32(17); self.expect_main_identity();
    self.expect_byte(1); self.expect_u32(1);
    self.expect_id(1); self.expect_u32(7); self.expect_console_field();
    self.expect_byte(1); self.expect_byte(3); self.expect_u32(20); self.expect_console_type_identity();
        transition self.has_writes { 1 -> bytes_type() _ -> module_tail() }
    }
    state bytes_type() {
        self.expect_id(2); self.expect_u32(22); self.expect_bytes_type_identity();
        self.expect_byte(4); self.expect_byte(1);
        transition 0 { _ -> module_tail() }
    }
    state module_tail() {

    self.expect_u32(0);
    self.expect_u32(1); self.expect_id(1); self.expect_u32(7); self.expect_console_service(); self.expect_u32(0);
    self.expect_u32(1); self.expect_id(1);
    self.expect_u32(0);

        transition self.has_writes { 1 -> two_boundaries() _ -> one_boundary() }
    }
    state two_boundaries() { self.expect_u32(2); transition 0 { _ -> exit_boundary() } }
    state one_boundary() { self.expect_u32(1); transition 0 { _ -> exit_boundary() } }
    state exit_boundary() {
    self.expect_id(1); self.expect_u32(147); self.expect_exit_boundary_identity();
    self.expect_byte(0);
    self.expect_u32(1); self.expect_byte(2); self.expect_byte(1); self.expect_u16(32);
    // No structural requirements, program-local roots, or content guarantees.
    self.expect_u32(0); self.expect_byte(0); self.expect_u32(0);
    self.expect_u32(0); self.expect_u32(0); self.expect_u32(1); self.expect_id(1);

        transition self.has_writes { 1 -> write_boundary() _ -> declarations() }
    }
    state write_boundary() {
    self.expect_id(2); self.expect_u32(160); self.expect_write_boundary_identity();
    self.expect_byte(0);
    self.expect_u32(0);
    self.expect_u32(1); self.expect_id(1); self.expect_u32(0); self.expect_byte(0);
    self.expect_id(2); self.expect_byte(1); self.expect_byte(2); self.expect_u32(0);
    // No structural requirements, program-local roots, or content guarantees.
    self.expect_byte(0); self.expect_u32(0);
    self.expect_u32(0); self.expect_u32(0); self.expect_u32(1); self.expect_id(1);
        transition 0 { _ -> declarations() }
    }
    state declarations() {

    self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
    self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
    self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
    self.expect_u32(1);

    self.expect_id(1); self.expect_byte(1); self.expect_id(1);
    self.expect_u32(0); self.expect_u32(0); self.expect_byte(0);
        self.read_small_u32();
        transition self.status == 0 { true -> place_count() false -> done() }
    }
    state place_count() {
        transition self.has_writes { 1 -> write_place_count() _ -> no_write_place_count() }
    }
    state no_write_place_count() {
        transition self.word == 1 { true -> provider_places() false -> bad() }
    }
    state write_place_count() {
        transition self.word >= 3 { true -> bounded_place_count() false -> bad() }
    }
    state bounded_place_count() {
        self.write_count = self.word - 2;
        transition self.write_count <= 16 { true -> provider_places() false -> exhausted() }
    }
    state provider_places() {
        transition self.has_writes { 1 -> exit_provider_with_writes() _ -> exit_provider_only() }
    }
    state exit_provider_only() {
        self.expect_id(1); self.expect_byte(5); self.expect_id(1); self.expect_id(1); self.expect_id(1);
        transition 0 { _ -> machine_tail() }
    }
    state exit_provider_with_writes() {
        self.expect_id(2); self.expect_byte(5); self.expect_id(1); self.expect_id(1); self.expect_id(1);
        transition 0 { _ -> write_provider() }
    }
    state write_provider() {
    self.expect_id(3); self.expect_byte(5); self.expect_id(1); self.expect_id(1); self.expect_id(2);
        self.i = 0;
        transition 0 { _ -> literal_places() }
    }
    state literal_places() {
        transition self.i < self.write_count { true -> literal_place() false -> machine_tail() }
    }
    state literal_place() {
        self.expect_id(4 + self.i); self.expect_byte(4); self.expect_u32(self.i); self.expect_id(2);
        self.i = self.i + 1;
        transition self.status == 0 { true -> literal_places() false -> done() }
    }
    state machine_tail() {
    self.expect_u32(0);
    self.expect_u32(1); self.expect_id(1);
    self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
    self.expect_id(1); self.expect_u32(1);

        self.expect_id(1); self.expect_u32(0); self.expect_u32(self.write_count * 2 + 2);
        self.write_index = 0;
        transition 0 { _ -> literal_operations() }
    }
    state literal_operations() {
        transition self.write_index < self.write_count { true -> literal_operation() false -> write_setup() }
    }
    state literal_operation() {
        self.expect_id(1 + self.write_index); self.expect_byte(0); self.expect_byte(40); self.expect_id(4 + self.write_index);
        self.read_text();
        transition self.status == 0 { true -> literal_operations() false -> done() }
    }
    state write_setup() { self.write_index = 0; transition 0 { _ -> write_operations() } }
    state write_operations() {
        transition self.write_index < self.write_count { true -> write_operation() false -> exit_constant() }
    }
    state write_operation() {
        self.expect_id(self.write_count + 1 + self.write_index); self.expect_byte(0); self.expect_byte(35); self.expect_id(2);
        self.expect_u32(0);
        self.expect_u32(1); self.expect_id(4 + self.write_index); self.expect_byte(2); self.expect_u32(0);
        self.expect_u32(0); self.expect_u32(0);
        self.write_index = self.write_index + 1;
        transition self.status == 0 { true -> write_operations() false -> done() }
    }
    state exit_constant() {
    self.expect_id(self.write_count * 2 + 1); self.expect_byte(1); self.expect_id(1);
    self.expect_byte(2); self.expect_byte(1); self.expect_u16(32);
    self.expect_byte(1); self.expect_byte(1); self.read_exit_code();

    self.expect_id(self.write_count * 2 + 2); self.expect_byte(0); self.expect_byte(35); self.expect_id(1);
    self.expect_u32(1); self.expect_id(1);
    self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);

    self.expect_byte(5); self.expect_id(1); self.expect_u32(0);
    self.expect_id(1); self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
        transition 0 { _ -> done() }
    }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::record_value(&mut self, order: i32, runtime: i32) {
    self.j = 0;
    transition self.status == 0 { true -> scan() false -> done() }
    state scan() { transition self.j < self.value_used { true -> compare() false -> capacity() } }
    state compare() { transition self.value_ids[self.j] == self.current_value_id { true -> duplicate() false -> next() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> scan() } }
    state capacity() { transition self.value_used < 336 { true -> store() false -> exhausted() } }
    state store() {
        self.value_ids[self.value_used] = self.current_value_id;
        self.value_machines[self.value_used] = self.current_machine;
        self.value_slots[self.value_used] = self.current_slot;
        self.value_orders[self.value_used] = order;
        self.value_runtime[self.value_used] = runtime;
        self.value_used = self.value_used + 1;
        transition 0 { _ -> done() }
    }
    state duplicate() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::record_operation_id(&mut self, operation_id: i32) {
    self.j = 0;
    transition self.status == 0 { true -> scan() false -> done() }
    state scan() { transition self.j < self.op_used { true -> compare() false -> done() } }
    state compare() { transition self.op_ids[self.j] == operation_id { true -> duplicate() false -> next() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> scan() } }
    state duplicate() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::record_block_id(&mut self, id: i32) {
    self.j = 0;
    transition self.status == 0 { true -> scan() false -> done() }
    state scan() { transition self.j < self.block_used { true -> compare() false -> store() } }
    state compare() { transition self.block_ids[self.j] == id { true -> duplicate() false -> next() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> scan() } }
    state store() { self.block_ids[self.block_used] = id; self.block_used = self.block_used + 1; transition 0 { _ -> done() } }
    state duplicate() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::record_edge_id(&mut self, id: i32) {
    self.j = 0;
    transition self.status == 0 { true -> scan() false -> done() }
    state scan() { transition self.j < self.edge_used { true -> compare() false -> store() } }
    state compare() { transition self.edge_ids[self.j] == id { true -> duplicate() false -> next() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> scan() } }
    state store() { self.edge_ids[self.edge_used] = id; self.edge_used = self.edge_used + 1; transition 0 { _ -> done() } }
    state duplicate() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::record_contract_id(&mut self, id: i32) {
    self.j = 0;
    transition self.status == 0 { true -> scan() false -> done() }
    state scan() { transition self.j < self.contract_used { true -> compare() false -> store() } }
    state compare() { transition self.contract_ids[self.j] == id { true -> duplicate() false -> next() } }
    state next() { self.j = self.j + 1; transition 0 { _ -> scan() } }
    state store() { self.contract_ids[self.contract_used] = id; self.contract_used = self.contract_used + 1; transition 0 { _ -> done() } }
    state duplicate() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::find_machine(&mut self, id: i32) -> i32 {
    self.i = 0;
    transition 0 { _ -> scan() }
    state scan() { transition self.i < self.machine_count { true -> compare() false -> missing() } }
    state compare() { transition self.machine_ids[self.i] == id { true -> found() false -> next() } }
    state next() { self.i = self.i + 1; transition 0 { _ -> scan() } }
    state found() { return self.i; }
    state missing() { return -1; }
}

machine Main::find_runtime_value_slot(&mut self, machine_index: i32, id: i32, before_order: i32) -> i32 {
    self.i = 0;
    transition 0 { _ -> scan() }
    state scan() { transition self.i < self.value_used { true -> machine() false -> missing() } }
    state machine() { transition self.value_machines[self.i] == machine_index { true -> identity() false -> next() } }
    state identity() { transition self.value_ids[self.i] == id { true -> runtime() false -> next() } }
    state runtime() { transition self.value_runtime[self.i] == 1 { true -> order() false -> missing() } }
    state order() { transition self.value_orders[self.i] < before_order { true -> found() false -> missing() } }
    state next() { self.i = self.i + 1; transition 0 { _ -> scan() } }
    state found() { return self.value_slots[self.i]; }
    state missing() { return -1; }
}

machine Main::read_scalar_constant(&mut self) {
    self.op_kinds[self.current_op] = 1;
    self.expect_byte(1);
    self.c = read_byte();
    transition self.c < 0 { true -> bad() false -> b0() }
    state b0() { self.op_const0[self.current_op] = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> b1() } }
    state b1() { self.op_const1[self.current_op] = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> b2() } }
    state b2() { self.op_const2[self.current_op] = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> b3() } }
    state b3() {
        self.op_const3[self.current_op] = self.c;
        self.i = 4;
        transition self.c < 128 { true -> positive() false -> negative() }
    }
    state positive() { self.word = 0; transition 0 { _ -> high_loop() } }
    state negative() { self.word = 255; transition 0 { _ -> high_loop() } }
    state high_loop() { transition self.i < 16 { true -> high_byte() false -> done() } }
    state high_byte() {
        self.c = read_byte();
        transition self.c < 0 { true -> bad() false -> high_value() }
    }
    state high_value() { transition self.c == self.word { true -> high_next() false -> bad() } }
    state high_next() { self.i = self.i + 1; transition 0 { _ -> high_loop() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_scalar_call(&mut self) {
    self.op_kinds[self.current_op] = 33;
    self.read_id(); self.op_callee_ids[self.current_op] = self.id_value;
    self.read_u32(); self.current_arg = self.word;
    transition self.status == 0 { true -> count() false -> done() }
    state count() { transition self.current_arg <= 4 { true -> capacity() false -> exhausted() } }
    state capacity() { transition self.current_arg <= 1024 - self.arg_used { true -> setup() false -> exhausted() } }
    state setup() {
        self.op_arg_starts[self.current_op] = self.arg_used;
        self.op_arg_counts[self.current_op] = self.current_arg;
        self.j = 0;
        transition 0 { _ -> arguments() }
    }
    state arguments() { transition self.j < self.current_arg { true -> argument() false -> tail() } }
    state argument() {
        self.read_id(); self.arg_ids[self.arg_used] = self.id_value;
        self.arg_used = self.arg_used + 1; self.j = self.j + 1;
        transition self.status == 0 { true -> arguments() false -> done() }
    }
    state tail() { self.expect_u32(0); self.expect_u32(0); transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_scalar_operation(&mut self) {
    self.current_op = self.op_used;
    self.read_id(); self.record_operation_id(self.id_value);
    self.op_ids[self.current_op] = self.id_value;
    self.op_machine[self.current_op] = self.current_machine;
    self.expect_byte(1); self.read_id();
    self.op_result_ids[self.current_op] = self.id_value;
    self.current_value_id = self.id_value;
    self.expect_scalar_i32();
    self.current_slot = self.current_param_count + self.current_op - self.machine_op_starts[self.current_machine];
    self.record_value(self.current_op - self.machine_op_starts[self.current_machine], 1);
    self.c = read_byte();
    transition self.status == 0 { true -> kind() false -> done() }
    state kind() {
        transition self.c {
            1 -> constant()
            33 -> call()
            _ -> bad()
        }
    }
    state constant() { self.read_scalar_constant(); transition 0 { _ -> retained() } }
    state call() { self.read_scalar_call(); transition 0 { _ -> retained() } }
    state retained() {
        transition self.status == 0 { true -> advance() false -> done() }
    }
    state advance() { self.op_used = self.op_used + 1; transition 0 { _ -> done() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_scalar_machine(&mut self) {
    self.current_machine = self.machine_index;
    self.read_id(); self.current_value_id = self.id_value;
    self.j = 0;
    transition self.status == 0 { true -> machine_id_scan() false -> done() }
    state machine_id_scan() { transition self.j < self.machine_index { true -> machine_id_compare() false -> machine_id_store() } }
    state machine_id_compare() { transition self.machine_ids[self.j] == self.current_value_id { true -> bad() false -> machine_id_next() } }
    state machine_id_next() { self.j = self.j + 1; transition 0 { _ -> machine_id_scan() } }
    state machine_id_store() {
        self.machine_ids[self.current_machine] = self.current_value_id;
        self.expect_byte(0);
        self.read_u32(); self.current_param_count = self.word;
        transition self.status == 0 { true -> parameter_count() false -> done() }
    }
    state parameter_count() { transition self.current_param_count <= 4 { true -> parameter_capacity() false -> exhausted() } }
    state parameter_capacity() { transition self.current_param_count <= 64 - self.param_used { true -> parameter_setup() false -> exhausted() } }
    state parameter_setup() {
        self.machine_param_starts[self.current_machine] = self.param_used;
        self.machine_param_counts[self.current_machine] = self.current_param_count;
        transition 0 { _ -> parameters() }
    }
    state parameters() {
        transition self.param_used < self.machine_param_starts[self.current_machine] + self.current_param_count {
            true -> parameter()
            false -> result()
        }
    }
    state parameter() {
        self.read_id(); self.param_ids[self.param_used] = self.id_value;
        self.current_value_id = self.id_value;
        self.current_slot = self.param_used - self.machine_param_starts[self.current_machine];
        self.record_value(-1, 1);
        self.expect_scalar_i32(); self.param_used = self.param_used + 1;
        transition self.status == 0 { true -> parameters() false -> done() }
    }
    state result() {
        self.expect_u32(0); self.expect_byte(1); self.read_id();
        self.current_value_id = self.id_value; self.current_slot = -1;
        self.record_value(17, 0);
        self.expect_scalar_i32();
        self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
        self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
        self.read_id(); self.current_value_id = self.id_value;
        self.expect_u32(1); self.read_id();
        transition self.status == 0 { true -> block_identity() false -> done() }
    }
    state block_identity() { transition self.id_value == self.current_value_id { true -> block_store() false -> bad() } }
    state block_store() {
        self.record_block_id(self.id_value);
        self.expect_u32(0); self.read_u32(); self.current_op_count = self.word;
        transition self.status == 0 { true -> operation_count() false -> done() }
    }
    state operation_count() { transition self.current_op_count <= 16 { true -> operation_capacity() false -> exhausted() } }
    state operation_capacity() { transition self.current_op_count <= 256 - self.op_used { true -> operation_setup() false -> exhausted() } }
    state operation_setup() {
        self.machine_op_starts[self.current_machine] = self.op_used;
        self.machine_op_counts[self.current_machine] = self.current_op_count;
        transition 0 { _ -> operations() }
    }
    state operations() {
        transition self.op_used < self.machine_op_starts[self.current_machine] + self.current_op_count {
            true -> operation()
            false -> terminator()
        }
    }
    state operation() {
        self.read_scalar_operation();
        transition self.status == 0 { true -> operations() false -> done() }
    }
    state terminator() {
        self.expect_byte(2); self.read_id(); self.record_edge_id(self.id_value);
        self.read_id(); self.machine_return_ids[self.current_machine] = self.id_value;
        self.expect_u32(0); self.read_id(); self.record_contract_id(self.id_value);
        self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
        transition 0 { _ -> done() }
    }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::decode_scalar_module_tail(&mut self) {
    // Fourteen remaining top-level tables follow the already-consumed empty
    // structural-type table, then the machine vector.
    self.expect_u32(0); self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
    self.expect_u32(0); self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
    self.expect_u32(0); self.expect_u32(0); self.expect_u32(0); self.expect_u32(0);
    self.expect_u32(0); self.expect_u32(0);
    self.read_u32(); self.machine_count = self.word;
    transition self.status == 0 { true -> machine_count() false -> done() }
    state machine_count() { transition self.machine_count > 0 { true -> capacity() false -> bad() } }
    state capacity() { transition self.machine_count <= 16 { true -> setup() false -> exhausted() } }
    state setup() { self.machine_index = 0; transition 0 { _ -> machines() } }
    state machines() { transition self.machine_index < self.machine_count { true -> machine() false -> validate() } }
    state machine() {
        self.read_scalar_machine(); self.machine_index = self.machine_index + 1;
        transition self.status == 0 { true -> machines() false -> done() }
    }
    state validate() { self.validate_scalar_module(); transition 0 { _ -> done() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::validate_scalar_module(&mut self) {
    self.found = self.find_machine(self.entry_machine_id);
    transition self.found >= 0 { true -> entry_arity() false -> bad() }
    state entry_arity() { transition self.machine_param_counts[self.found] == 0 { true -> machine_setup() false -> bad() } }
    state machine_setup() { self.current_machine = 0; transition 0 { _ -> machines() } }
    state machines() { transition self.current_machine < self.machine_count { true -> return_value() false -> closure_setup() } }
    state return_value() {
        self.found = self.find_runtime_value_slot(self.current_machine,
            self.machine_return_ids[self.current_machine], 17);
        transition self.found >= 0 { true -> operation_setup() false -> bad() }
    }
    state operation_setup() {
        self.current_op = self.machine_op_starts[self.current_machine];
        transition 0 { _ -> operations() }
    }
    state operations() {
        transition self.current_op < self.machine_op_starts[self.current_machine] + self.machine_op_counts[self.current_machine] {
            true -> operation_kind()
            false -> next_machine()
        }
    }
    state operation_kind() { transition self.op_kinds[self.current_op] { 1 -> next_operation() 33 -> call_target() _ -> bad() } }
    state call_target() {
        self.found = self.find_machine(self.op_callee_ids[self.current_op]);
        transition self.found >= 0 { true -> call_arity() false -> bad() }
    }
    state call_arity() {
        transition self.op_arg_counts[self.current_op] == self.machine_param_counts[self.found] {
            true -> call_edge()
            false -> bad()
        }
    }
    state call_edge() {
        self.call_graph[self.current_machine * 16 + self.found] = 1;
        self.current_arg = 0;
        transition 0 { _ -> call_arguments() }
    }
    state call_arguments() { transition self.current_arg < self.op_arg_counts[self.current_op] { true -> call_argument() false -> next_operation() } }
    state call_argument() {
        self.current_value_id = self.arg_ids[self.op_arg_starts[self.current_op] + self.current_arg];
        self.found = self.find_runtime_value_slot(self.current_machine, self.current_value_id,
            self.current_op - self.machine_op_starts[self.current_machine]);
        transition self.found >= 0 { true -> next_argument() false -> bad() }
    }
    state next_argument() { self.current_arg = self.current_arg + 1; transition 0 { _ -> call_arguments() } }
    state next_operation() { self.current_op = self.current_op + 1; transition 0 { _ -> operations() } }
    state next_machine() { self.current_machine = self.current_machine + 1; transition 0 { _ -> machines() } }

    // Floyd-Warshall closure over the fixed 16x16 backing detects every cycle,
    // independent of machine declaration order or call direction.
    state closure_setup() { self.k = 0; transition 0 { _ -> closure_k() } }
    state closure_k() { transition self.k < self.machine_count { true -> closure_i_setup() false -> diagonal_setup() } }
    state closure_i_setup() { self.i = 0; transition 0 { _ -> closure_i() } }
    state closure_i() { transition self.i < self.machine_count { true -> closure_j_setup() false -> closure_next_k() } }
    state closure_j_setup() { self.j = 0; transition 0 { _ -> closure_j() } }
    state closure_j() { transition self.j < self.machine_count { true -> closure_left() false -> closure_next_i() } }
    state closure_left() { transition self.call_graph[self.i * 16 + self.k] == 1 { true -> closure_right() false -> closure_next_j() } }
    state closure_right() { transition self.call_graph[self.k * 16 + self.j] == 1 { true -> closure_store() false -> closure_next_j() } }
    state closure_store() { self.call_graph[self.i * 16 + self.j] = 1; transition 0 { _ -> closure_next_j() } }
    state closure_next_j() { self.j = self.j + 1; transition 0 { _ -> closure_j() } }
    state closure_next_i() { self.i = self.i + 1; transition 0 { _ -> closure_i() } }
    state closure_next_k() { self.k = self.k + 1; transition 0 { _ -> closure_k() } }
    state diagonal_setup() { self.i = 0; transition 0 { _ -> diagonal() } }
    state diagonal() { transition self.i < self.machine_count { true -> diagonal_check() false -> done() } }
    state diagonal_check() { transition self.call_graph[self.i * 16 + self.i] == 0 { true -> diagonal_next() false -> bad() } }
    state diagonal_next() { self.i = self.i + 1; transition 0 { _ -> diagonal() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::check_eof(&mut self) {
    transition self.status == 0 { true -> read() false -> done() }
    state read() { self.c = read_byte(); transition self.c < 0 { true -> done() false -> bad() } }
    state bad() { self.status = 251; }
    state done() { }
}

machine Main::emit_u16(&mut self, value: i32) {
    write_byte(value & 255); write_byte((value >> 8) & 255);
}

machine Main::emit_u32(&mut self, value: i32) {
    write_byte(value & 255); write_byte((value >> 8) & 255);
    write_byte((value >> 16) & 255); write_byte((value >> 24) & 255);
}

machine Main::emit_u64(&mut self, value: i32) {
    self.emit_u32(value); self.emit_u32(0);
}

machine Main::emit_scalar_byte(&mut self, value: i32) {
    write_byte(value); self.code_cursor = self.code_cursor + 1;
}

machine Main::emit_scalar_u32(&mut self, value: i32) {
    self.emit_scalar_byte(value & 255); self.emit_scalar_byte((value >> 8) & 255);
    self.emit_scalar_byte((value >> 16) & 255); self.emit_scalar_byte((value >> 24) & 255);
}

machine Main::emit_scalar_signed_u32(&mut self, value: i32) {
    transition value >= 0 { true -> positive() false -> negative() }
    state positive() { self.emit_scalar_u32(value); transition 0 { _ -> done() } }
    state negative() {
        self.word = 0 - value - 1;
        self.emit_scalar_byte(255 - (self.word & 255)); self.word = self.word / 256;
        self.emit_scalar_byte(255 - (self.word & 255)); self.word = self.word / 256;
        self.emit_scalar_byte(255 - (self.word & 255)); self.word = self.word / 256;
        self.emit_scalar_byte(255 - (self.word & 255));
        transition 0 { _ -> done() }
    }
    state done() { }
}

machine Main::emit_scalar_slot_displacement(&mut self, slot: i32) {
    self.emit_scalar_signed_u32(0 - (slot + 1) * 4);
}

machine Main::emit_zeroes(&mut self, count: i32) {
    self.i = 0;
    transition self.i < count { true -> byte() false -> done() }
    state byte() { write_byte(0); self.i = self.i + 1; transition self.i < count { true -> byte() false -> done() } }
    state done() { }
}

machine Main::emit_elf_header(&mut self) {
    write_byte(127); write_byte(69); write_byte(76); write_byte(70);
    write_byte(2); write_byte(1); write_byte(1); write_byte(0); self.emit_zeroes(8);
    self.emit_u16(2); self.emit_u16(62); self.emit_u32(1);
    self.emit_u64(4198400); self.emit_u64(64); self.emit_u64(0); self.emit_u32(0);
    self.emit_u16(64); self.emit_u16(56); self.emit_u16(2);
    self.emit_u16(0); self.emit_u16(0); self.emit_u16(0);
}

machine Main::emit_program_headers(&mut self) {
    // One read+execute segment covering headers and text.
    self.emit_u32(1); self.emit_u32(5); self.emit_u64(0);
    self.emit_u64(4194304); self.emit_u64(4194304);
    self.emit_u64(4096 + self.text_size); self.emit_u64(4096 + self.text_size); self.emit_u64(4096);
    // Empty read+write data segment retained by the canonical ELF image layout.
    self.emit_u32(1); self.emit_u32(6); self.emit_u64(8192);
    self.emit_u64(4202496); self.emit_u64(4202496);
    self.emit_u64(0); self.emit_u64(0); self.emit_u64(4096);
}

machine Main::emit_write_line(&mut self) {
    // mov edi,1; lea rsi,[rip+40]; mov edx,text_len+1
    write_byte(191); self.emit_u32(1);
    write_byte(72); write_byte(141); write_byte(53); self.emit_u32(40);
    write_byte(186); self.emit_u32(self.text_len + 1);
    // Retry SYS_write; trap on nonpositive progress.
    write_byte(184); self.emit_u32(1); write_byte(15); write_byte(5);
    write_byte(72); write_byte(133); write_byte(192);
    write_byte(15); write_byte(142); self.emit_u32(17);
    write_byte(72); write_byte(1); write_byte(198);
    write_byte(72); write_byte(41); write_byte(194);
    // rel32 -28, written explicitly so this O1 backend does not require the
    // broader signed-shift/bit-mask profile merely to encode a fixed opcode.
    write_byte(15); write_byte(133);
    write_byte(228); write_byte(255); write_byte(255); write_byte(255);
    // Jump over trap and inline literal+newline.
    write_byte(233); self.emit_u32(self.text_len + 3);
    write_byte(15); write_byte(11);
    self.i = 0;
    transition 0 { _ -> literal_loop() }
    state literal_loop() { transition self.i < self.text_len { true -> literal_byte() false -> newline() } }
    state literal_byte() { write_byte(self.text[self.text_start + self.i]); self.i = self.i + 1; transition 0 { _ -> literal_loop() } }
    state newline() { write_byte(10); }
}

machine Main::emit_exit(&mut self) {
    write_byte(191); write_byte(self.exit0); write_byte(self.exit1); write_byte(self.exit2); write_byte(self.exit3);
    write_byte(184); self.emit_u32(231);
    write_byte(15); write_byte(5); write_byte(15); write_byte(11);
    // The product's zero-write single-effect function has no nominal return
    // byte after its nonreturning exit tail. Positive-write functions retain
    // the canonical return byte following the trap.
    transition self.write_count > 0 { true -> return_byte() false -> done() }
    state return_byte() { write_byte(195); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::preflight_scalar(&mut self) {
    self.code_cursor = 16;
    self.current_machine = 0;
    transition 0 { _ -> machines() }
    state machines() { transition self.current_machine < self.machine_count { true -> machine() false -> total() } }
    state machine() {
        self.machine_code_offsets[self.current_machine] = self.code_cursor;
        self.word = 11 + self.machine_param_counts[self.current_machine] * 6 + 8;
        self.current_op = self.machine_op_starts[self.current_machine];
        transition 0 { _ -> operations() }
    }
    state operations() {
        transition self.current_op < self.machine_op_starts[self.current_machine] + self.machine_op_counts[self.current_machine] {
            true -> operation()
            false -> machine_size()
        }
    }
    state operation() {
        transition self.op_kinds[self.current_op] {
            1 -> constant()
            33 -> call()
            _ -> bad()
        }
    }
    state constant() { self.word = self.word + 11; transition 0 { _ -> next_operation() } }
    state call() { self.word = self.word + 11 + self.op_arg_counts[self.current_op] * 6; transition 0 { _ -> next_operation() } }
    state next_operation() { self.current_op = self.current_op + 1; transition 0 { _ -> operations() } }
    state machine_size() {
        self.machine_code_sizes[self.current_machine] = self.word;
        transition self.word <= 4096 - self.code_cursor { true -> machine_advance() false -> exhausted() }
    }
    state machine_advance() {
        self.code_cursor = self.code_cursor + self.word;
        self.current_machine = self.current_machine + 1;
        transition 0 { _ -> machines() }
    }
    state total() { self.text_size = self.code_cursor; transition 0 { _ -> done() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_scalar_entry(&mut self) {
    self.found = self.find_machine(self.entry_machine_id);
    self.emit_scalar_byte(232);
    self.code_delta = self.machine_code_offsets[self.found] - (self.code_cursor + 4);
    self.emit_scalar_signed_u32(self.code_delta);
    self.emit_scalar_byte(137); self.emit_scalar_byte(199);
    self.emit_scalar_byte(184); self.emit_scalar_u32(231);
    self.emit_scalar_byte(15); self.emit_scalar_byte(5);
    self.emit_scalar_byte(15); self.emit_scalar_byte(11);
}

machine Main::emit_scalar_parameter_spill(&mut self) {
    self.emit_scalar_byte(137);
    transition self.current_arg {
        0 -> edi()
        1 -> esi()
        2 -> edx()
        3 -> ecx()
        _ -> done()
    }
    state edi() { self.emit_scalar_byte(189); transition 0 { _ -> displacement() } }
    state esi() { self.emit_scalar_byte(181); transition 0 { _ -> displacement() } }
    state edx() { self.emit_scalar_byte(149); transition 0 { _ -> displacement() } }
    state ecx() { self.emit_scalar_byte(141); transition 0 { _ -> displacement() } }
    state displacement() { self.emit_scalar_slot_displacement(self.current_arg); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_scalar_argument_load(&mut self) {
    self.current_value_id = self.arg_ids[self.op_arg_starts[self.current_op] + self.current_arg];
    self.found = self.find_runtime_value_slot(self.current_machine, self.current_value_id,
        self.current_op - self.machine_op_starts[self.current_machine]);
    self.emit_scalar_byte(139);
    transition self.current_arg {
        0 -> edi()
        1 -> esi()
        2 -> edx()
        3 -> ecx()
        _ -> done()
    }
    state edi() { self.emit_scalar_byte(189); transition 0 { _ -> displacement() } }
    state esi() { self.emit_scalar_byte(181); transition 0 { _ -> displacement() } }
    state edx() { self.emit_scalar_byte(149); transition 0 { _ -> displacement() } }
    state ecx() { self.emit_scalar_byte(141); transition 0 { _ -> displacement() } }
    state displacement() { self.emit_scalar_slot_displacement(self.found); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::emit_scalar_operation(&mut self) {
    self.current_slot = self.machine_param_counts[self.current_machine]
        + self.current_op - self.machine_op_starts[self.current_machine];
    transition self.op_kinds[self.current_op] {
        1 -> constant()
        33 -> call_setup()
        _ -> done()
    }
    state constant() {
        self.emit_scalar_byte(184);
        self.emit_scalar_byte(self.op_const0[self.current_op]);
        self.emit_scalar_byte(self.op_const1[self.current_op]);
        self.emit_scalar_byte(self.op_const2[self.current_op]);
        self.emit_scalar_byte(self.op_const3[self.current_op]);
        transition 0 { _ -> store() }
    }
    state call_setup() { self.current_arg = 0; transition 0 { _ -> call_arguments() } }
    state call_arguments() { transition self.current_arg < self.op_arg_counts[self.current_op] { true -> call_argument() false -> call_target() } }
    state call_argument() {
        self.emit_scalar_argument_load(); self.current_arg = self.current_arg + 1;
        transition 0 { _ -> call_arguments() }
    }
    state call_target() {
        self.found = self.find_machine(self.op_callee_ids[self.current_op]);
        self.emit_scalar_byte(232);
        self.code_delta = self.machine_code_offsets[self.found] - (self.code_cursor + 4);
        self.emit_scalar_signed_u32(self.code_delta);
        transition 0 { _ -> store() }
    }
    state store() {
        self.emit_scalar_byte(137); self.emit_scalar_byte(133);
        self.emit_scalar_slot_displacement(self.current_slot);
        transition 0 { _ -> done() }
    }
    state done() { }
}

machine Main::emit_scalar_machine(&mut self) {
    self.emit_scalar_byte(85);
    self.emit_scalar_byte(72); self.emit_scalar_byte(137); self.emit_scalar_byte(229);
    self.emit_scalar_byte(72); self.emit_scalar_byte(129); self.emit_scalar_byte(236);
    self.emit_scalar_u32(512);
    self.current_arg = 0;
    transition 0 { _ -> parameters() }
    state parameters() { transition self.current_arg < self.machine_param_counts[self.current_machine] { true -> parameter() false -> operation_setup() } }
    state parameter() { self.emit_scalar_parameter_spill(); self.current_arg = self.current_arg + 1; transition 0 { _ -> parameters() } }
    state operation_setup() { self.current_op = self.machine_op_starts[self.current_machine]; transition 0 { _ -> operations() } }
    state operations() {
        transition self.current_op < self.machine_op_starts[self.current_machine] + self.machine_op_counts[self.current_machine] {
            true -> operation()
            false -> return_value()
        }
    }
    state operation() { self.emit_scalar_operation(); self.current_op = self.current_op + 1; transition 0 { _ -> operations() } }
    state return_value() {
        self.found = self.find_runtime_value_slot(self.current_machine,
            self.machine_return_ids[self.current_machine], 17);
        self.emit_scalar_byte(139); self.emit_scalar_byte(133);
        self.emit_scalar_slot_displacement(self.found);
        self.emit_scalar_byte(201); self.emit_scalar_byte(195);
    }
}

machine Main::emit_scalar_elf(&mut self) {
    self.emit_elf_header(); self.emit_program_headers(); self.emit_zeroes(3920);
    self.code_cursor = 0; self.emit_scalar_entry();
    self.current_machine = 0;
    transition 0 { _ -> machines() }
    state machines() { transition self.current_machine < self.machine_count { true -> machine() false -> padding() } }
    state machine() {
        self.emit_scalar_machine(); self.current_machine = self.current_machine + 1;
        transition 0 { _ -> machines() }
    }
    state padding() { self.emit_zeroes(4096 - self.text_size); }
}

machine Main::emit_elf(&mut self) {
    transition self.mode { 1 -> scalar() _ -> o1() }
    state scalar() { self.emit_scalar_elf(); transition 0 { _ -> done() } }
    state o1() { self.emit_elf_header(); self.emit_program_headers(); self.emit_zeroes(3920); transition 0 { _ -> o1_writes_setup() } }
    state o1_writes_setup() {
    self.write_index = 0;
        transition 0 { _ -> writes() }
    }
    state writes() { transition self.write_index < self.write_count { true -> write() false -> exit() } }
    state write() {
        self.text_start = self.write_starts[self.write_index];
        self.text_len = self.write_lengths[self.write_index];
        self.emit_write_line();
        self.write_index = self.write_index + 1;
        transition 0 { _ -> writes() }
    }
    state exit() { self.emit_exit(); self.emit_zeroes(4096 - self.text_size); transition 0 { _ -> done() } }
    state done() { }
}

machine Main::preflight(&mut self) {
    transition self.mode { 1 -> scalar() _ -> o1() }
    state scalar() { self.preflight_scalar(); transition 0 { _ -> done() } }
    state o1() {
    // Each write loop is 53 bytes plus its literal. The zero-write closure's
    // single-effect exit tail is 14 bytes; positive-write functions retain the
    // product's nominal return byte and therefore use 15.
    self.text_size = self.write_count * 53 + self.text_used + 14;
        transition self.write_count > 0 { true -> return_byte() false -> capacity() }
    }
    state return_byte() { self.text_size = self.text_size + 1; transition 0 { _ -> capacity() } }
    state capacity() {
    transition self.text_size <= 4096 { true -> done() false -> exhausted() }
    }
    state exhausted() { self.status = 252; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::main(&mut self) {
    self.status = 0; self.has_writes = 0; self.write_count = 0;
    self.write_index = 0; self.text_used = 0; self.text_len = 0;
    self.decode_terminal_module();
    transition self.status == 0 { true -> eof() false -> reject() }
    state eof() { self.check_eof(); transition self.status == 0 { true -> preflight() false -> reject() } }
    state preflight() { self.preflight(); transition self.status == 0 { true -> accepted() false -> reject() } }
    state accepted() { self.emit_elf(); self.console.exit_process(0); }
    state reject() { self.console.exit_process(self.status); }
}
