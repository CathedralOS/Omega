// Delta-written bounded terminal-Psi -> Linux x86-64 ELF backend.
//
// Input is either the vocabulary-28 O1 console shape or the profile-neutral
// scalar in-module call/return conformance shape. The scalar lane retains at
// most sixteen machines, four signed-i32 parameters per machine, sixteen
// constant/call operations per machine, and four arguments per call. It checks
// IDs, signatures, value definition order, return values, and the complete
// acyclic call graph before publication, then emits a deterministic direct
// Linux x86-64 image with an explicit process-entry shim.
// That shim maps the selected scalar i32 result to process status for runnable
// conformance evidence; it does not model Omega target::ProgramEntry selection.
// Success emits one deterministic import-free ELF64 image and exits 0.
// Malformed/unsupported input exits 251; table, literal, or image exhaustion
// exits 252.
boundary trait Console {
    machine read_byte() -> i32;
    machine write_byte(byte: i32);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    status: i32; c: i32; i: i32; j: i32; k: i32;
    word: i32; has_writes: i32; write_count: i32; write_index: i32;
    text_used: i32; text_start: i32; text_len: i32;
    exit0: i32; exit1: i32; exit2: i32; exit3: i32; text_size: i32;
    write_starts: [i32; 16]; write_lengths: [i32; 16];
    text: [u8; 1024];

    // Scalar-call retained IR. mode 0 is O1; mode 1 is scalar call/return.
    mode: i32; entry_machine_id: i32; id_value: i32;
    byte0: i32; byte1: i32; byte2: i32; byte3: i32;
    machine_count: i32; machine_index: i32;
    param_used: i32; op_used: i32; arg_used: i32; value_used: i32;
    block_used: i32; edge_used: i32; contract_used: i32;
    current_machine: i32; current_op: i32; current_arg: i32;
    current_param_count: i32; current_op_count: i32;
    current_value_id: i32; current_slot: i32; found: i32;
    return_value_id: i32; code_cursor: i32; code_delta: i32;
    machine_ids: [i32; 16];
    machine_param_starts: [i32; 16]; machine_param_counts: [i32; 16];
    machine_op_starts: [i32; 16]; machine_op_counts: [i32; 16];
    machine_return_ids: [i32; 16];
    machine_code_offsets: [i32; 16]; machine_code_sizes: [i32; 16];
    param_ids: [i32; 64];
    op_ids: [i32; 256]; op_machine: [i32; 256];
    op_result_ids: [i32; 256]; op_kinds: [i32; 256];
    op_const0: [i32; 256]; op_const1: [i32; 256];
    op_const2: [i32; 256]; op_const3: [i32; 256];
    op_callee_ids: [i32; 256];
    op_arg_starts: [i32; 256]; op_arg_counts: [i32; 256];
    arg_ids: [i32; 1024];
    value_ids: [i32; 336]; value_machines: [i32; 336];
    value_slots: [i32; 336]; value_orders: [i32; 336];
    value_runtime: [i32; 336];
    block_ids: [i32; 16]; edge_ids: [i32; 16]; contract_ids: [i32; 16];
    call_graph: [i32; 256];
}

machine Main::expect_byte(&mut self, expected: i32) {
    transition self.status == 0 { true -> read() false -> done() }
    state read() { self.c = read_byte(); transition self.c == expected { true -> done() false -> bad() } }
    state bad() { self.status = 251; }
    state done() { }
}

machine Main::expect_u16(&mut self, expected: i32) {
    self.expect_byte(expected & 255);
    self.expect_byte((expected >> 8) & 255);
}

machine Main::expect_u32(&mut self, expected: i32) {
    self.expect_byte(expected & 255);
    self.expect_byte((expected >> 8) & 255);
    self.expect_byte((expected >> 16) & 255);
    self.expect_byte((expected >> 24) & 255);
}

machine Main::read_small_u32(&mut self) {
    self.c = read_byte();
    transition self.c < 0 { true -> bad() false -> value() }
    state value() { self.word = self.c; self.expect_zeroes(3); transition 0 { _ -> done() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

// Read the nonnegative half of canonical u32. Counts and retained semantic IDs
// in this bounded profile must fit signed i32; high-bit encodings are malformed
// rather than being allowed to overflow Delta arithmetic.
machine Main::read_u32(&mut self) {
    self.c = read_byte();
    transition self.c < 0 { true -> bad() false -> b0() }
    state b0() { self.byte0 = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> b1() } }
    state b1() { self.byte1 = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> b2() } }
    state b2() { self.byte2 = self.c; self.c = read_byte(); transition self.c < 0 { true -> bad() false -> b3() } }
    state b3() { self.byte3 = self.c; transition self.byte3 < 128 { true -> value() false -> bad() } }
    state value() {
        self.word = self.byte0 + self.byte1 * 256 + self.byte2 * 65536 + self.byte3 * 16777216;
        transition 0 { _ -> done() }
    }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::read_id(&mut self) {
    self.read_u32();
    self.id_value = self.word;
    self.expect_u32(0);
    transition self.status == 0 { true -> nonzero() false -> done() }
    state nonzero() { transition self.id_value > 0 { true -> done() false -> bad() } }
    state bad() { self.status = 251; transition 0 { _ -> done() } }
    state done() { }
}

machine Main::expect_scalar_i32(&mut self) {
    self.expect_byte(2); self.expect_byte(1); self.expect_u16(32);
}

machine Main::expect_id(&mut self, expected: i32) {
    self.expect_u32(expected);
    self.expect_u32(0);
}

machine Main::expect_zeroes(&mut self, count: i32) {
    self.i = 0;
    transition self.status == 0 { true -> loop() false -> done() }
    state loop() { transition self.i < count { true -> byte() false -> done() } }
    state byte() { self.expect_byte(0); self.i = self.i + 1; transition self.status == 0 { true -> loop() false -> done() } }
    state done() { }
}

machine Main::expect_main_identity(&mut self) {
    self.expect_byte(110); self.expect_byte(97); self.expect_byte(109); self.expect_byte(101); self.expect_byte(100); self.expect_byte(40); self.expect_byte(110); self.expect_byte(97);
    self.expect_byte(109); self.expect_byte(101); self.expect_byte(40); self.expect_byte(77); self.expect_byte(97); self.expect_byte(105); self.expect_byte(110); self.expect_byte(41);
    self.expect_byte(41);
}

