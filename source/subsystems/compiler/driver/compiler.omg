use {psi}/pipeline/syntax_trees_to_symbol_resolved_trees/resolution_state.omg;
use {psi}/pipeline/syntax_trees_to_symbol_resolved_trees/resolver.omg;
use {psi}/pipeline/symbol_resolved_trees_to_typed_trees/typer.omg;
use {psi}/pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;
use {psi}/pipeline/checked_trees_to_scalar_operations/scalar.omg;
use {psi}/pipeline/checked_trees_to_scalar_operations/lowerer.omg;
use compiler_alpha\AlphaEmitter;
use psi\pipeline\source_files_to_tokens\Lexer;
use psi\pipeline\source_files_to_tokens\tokenize;
use psi\pipeline\tokens_to_syntax_trees\Parser;
use psi\pipeline\tokens_to_syntax_trees\parse;
use psi\pipeline\tokens_to_syntax_trees\parser_initialize;
use psi\pipeline\typed_trees_to_checked_trees\Checker;
use psi\pipeline\typed_trees_to_checked_trees\checker_check;
use psi\representations\lowered_program\ScalarStatus;
use psi\representations\source_files\ModulePath;
use psi\representations\source_files\SourceSet;
use psi\representations\source_files\SourceSpan;
use psi\representations\source_files\source_set_add;
use psi\representations\source_files\source_set_clear;
use psi\representations\source_files\span_spells;
use psi\representations\syntax_trees\MachineItem;
use psi\representations\syntax_trees\machine_item;

// Compilation consumes an explicit closed source set. Package acquisition and
// public OCREQ admission are separate owners; neither is inferred from a path
// or from the spelling of the selected entry. Both the construction application
// and diagnostic callers use this single semantic pipeline.
public data CompilationStatus [copy] {
    case Collecting;
    case Complete;
    case Capacity;
    case Lexical;
    case Parsing;
    case Resolution;
    case Typing;
    case Checking;
    case Unsupported;
    case Entry;
}

public data Compilation {
    sources: SourceSet;
    parser: Parser;
    output: AlphaEmitter;
    status: CompilationStatus;
    diagnostic: SourceSpan;
}

public machine compilation_clear(compilation: @mutable Compilation) {
    source_set_clear(@mutable compilation.sources);
    parser_initialize(@mutable compilation.parser);
    compilation.output.complete = false;
    compilation.output.length = 0;
    compilation.status = CompilationStatus::Collecting;
}

// One source unit retains its bytes and source identity before parsing appends
// declarations. A failure is sticky: no later unit or finish call can turn an
// incomplete source set into a published artifact.
public machine compilation_add_unit(compilation: @mutable Compilation, lexer: @mutable Lexer, package: u64 in Trapping, module_path: @ModulePath)
crashes Trap
{
    transition compilation.status {
        CompilationStatus::Collecting -> verify_identity(compilation, lexer, package, module_path),
        _ -> done()
    }
    machine verify_identity(compilation: @mutable Compilation, lexer: @mutable Lexer, package: u64 in Trapping, module_path: @ModulePath) {
        transition (lexer.source.id.value as -Trapping) == compilation.sources.unit_count {
            true -> retain(compilation, lexer, package, module_path),
            _ -> invalid(compilation)
        }
    }
    machine retain(compilation: @mutable Compilation, lexer: @mutable Lexer, package: u64 in Trapping, module_path: @ModulePath) {
        let added: bool = source_set_add(@mutable compilation.sources, @lexer.source, package, module_path);
        transition added {
            true -> tokenize_unit(compilation, lexer),
            _ -> full(compilation)
        }
    }
    machine tokenize_unit(compilation: @mutable Compilation, lexer: @mutable Lexer) {
        tokenize(lexer);
        transition lexer.output.accepted {
            true -> parse_unit(compilation, lexer),
            _ -> lexical(compilation, lexer)
        }
    }
    machine parse_unit(compilation: @mutable Compilation, lexer: @Lexer) {
        parse(@mutable compilation.parser, lexer.source.id, lexer.source.length as +Trapping, @lexer.output);
        transition compilation.parser.output.accepted {
            true -> done(),
            _ -> parsing(compilation)
        }
    }
    machine lexical(compilation: @mutable Compilation, lexer: @Lexer) {
        compilation.status = CompilationStatus::Lexical;
        compilation.diagnostic = lexer.output.diagnostic.source_span;
    }
    machine parsing(compilation: @mutable Compilation) {
        compilation.status = CompilationStatus::Parsing;
        compilation.diagnostic = compilation.parser.output.diagnostic.source_span;
    }
    machine full(compilation: @mutable Compilation) { compilation.status = CompilationStatus::Capacity; }
    machine invalid(compilation: @mutable Compilation) { compilation.status = CompilationStatus::Entry; }
    machine done() {}
}

// Name selection happens over parsed declaration identities, not a source
// fingerprint or a test-only fixed name. The supplied unit and name choose
// exactly one top-level declaration; lowering still checks its entry contract.
public machine compilation_finish(compilation: @mutable Compilation, entry_unit: u32, entry_name: @[u8])
crashes Trap
{
    transition compilation.status {
        CompilationStatus::Collecting -> find(compilation, entry_unit, entry_name, 0 as u64 +Trapping, 0 as u64 +Trapping, false),
        _ -> done()
    }
    machine find(compilation: @mutable Compilation, entry_unit: u32, entry_name: @[u8], index: u64 in Trapping, selected: u64 in Trapping, found: bool) {
        transition index < compilation.parser.output.machine_count {
            true -> candidate(compilation, entry_unit, entry_name, index, selected, found),
            _ -> finish_selection(compilation, selected, found)
        }
    }
    machine candidate(compilation: @mutable Compilation, entry_unit: u32, entry_name: @[u8], index: u64 in Trapping, selected: u64 in Trapping, found: bool) {
        let item: MachineItem = machine_item(@compilation.parser.output, index);
        let matches: bool = item.parent == 0
            && (item.source_span.source.value as -Trapping) == entry_unit
            && span_spells(@compilation.sources, item.name.source_span, entry_name);
        transition matches {
            true -> choose(compilation, entry_unit, entry_name, index, found),
            _ -> find(compilation, entry_unit, entry_name, index + 1, selected, found)
        }
    }
    machine choose(compilation: @mutable Compilation, entry_unit: u32, entry_name: @[u8], index: u64 in Trapping, found: bool) {
        transition found {
            true -> invalid(compilation),
            _ -> find(compilation, entry_unit, entry_name, index + 1, index, true)
        }
    }
    machine finish_selection(compilation: @mutable Compilation, selected: u64 in Trapping, found: bool) {
        transition found {
            true -> resolve_program(compilation, selected),
            _ -> invalid(compilation)
        }
    }
    machine resolve_program(compilation: @mutable Compilation, selected: u64 in Trapping) {
        let mutable resolver: |resolution_state|::Resolver;
        |resolver|::resolve(@mutable resolver, @compilation.sources, @compilation.parser.output);
        transition resolver.output.accepted {
            true -> type_program(compilation, selected, @resolver),
            _ -> resolution_failed(compilation)
        }
    }
    machine type_program(compilation: @mutable Compilation, selected: u64 in Trapping, resolver: @|resolution_state|::Resolver) {
        let mutable typer: |typing_state|::Typer;
        |typer|::type_check(@mutable typer, @compilation.sources, @compilation.parser.output, @resolver.output);
        transition typer.output.accepted {
            true -> check(compilation, selected, resolver, @typer),
            _ -> typing_failed(compilation)
        }
    }
    machine check(compilation: @mutable Compilation, selected: u64 in Trapping, resolver: @|resolution_state|::Resolver, typer: @|typing_state|::Typer) {
        let mutable checker: Checker;
        checker_check(@mutable checker, @compilation.parser.output, @resolver.output, @typer.output);
        transition checker.output.accepted {
            true -> lower(compilation, selected, resolver, typer, @checker),
            _ -> checking_failed(compilation)
        }
    }
    machine lower(compilation: @mutable Compilation, selected: u64 in Trapping, resolver: @|resolution_state|::Resolver, typer: @|typing_state|::Typer, checker: @Checker) {
        let mutable lowerer: |lowerer|::ScalarLowerer;
        |scalar|::scalar_lower(@mutable lowerer, @compilation.parser.output, @resolver.output, @typer.output, @checker.output, selected);
        transition lowerer.output.status {
            ScalarStatus::Complete -> emit(compilation, @lowerer),
            ScalarStatus::Capacity -> full(compilation),
            _ -> unsupported(compilation)
        }
    }
    machine emit(compilation: @mutable Compilation, lowerer: @|lowerer|::ScalarLowerer) {
        compiler_alpha\alpha_emit(@mutable compilation.output, @lowerer.output);
        transition compilation.output.complete {
            true -> complete(compilation),
            _ -> full(compilation)
        }
    }
    machine complete(compilation: @mutable Compilation) { compilation.status = CompilationStatus::Complete; }
    machine full(compilation: @mutable Compilation) { compilation.status = CompilationStatus::Capacity; }
    machine unsupported(compilation: @mutable Compilation) { compilation.status = CompilationStatus::Unsupported; }
    machine invalid(compilation: @mutable Compilation) { compilation.status = CompilationStatus::Entry; }
    machine resolution_failed(compilation: @mutable Compilation) { compilation.status = CompilationStatus::Resolution; }
    machine typing_failed(compilation: @mutable Compilation) { compilation.status = CompilationStatus::Typing; }
    machine checking_failed(compilation: @mutable Compilation) { compilation.status = CompilationStatus::Checking; }
    machine done() {}
}
