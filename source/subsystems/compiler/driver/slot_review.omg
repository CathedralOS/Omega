use {psi}/pipeline/typed_trees_to_checked_trees/slot_review.omg as slot_records;
use {psi}/representations/checks/checks.omg;

// Review the slot records published by Psi checking.
public data OmegaSlotReview {}

public machine prepare(review: @mutable OmegaSlotReview) {}

public machine admits(review: @OmegaSlotReview, checks: @|checks|::Checks) -> bool
crashes Trap
{
    let mutable admission: |slot_records|::SlotReview;
    |slot_records|::prepare(@mutable admission);
    |slot_records|::admits(@admission, checks)
}
