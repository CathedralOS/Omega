use psi::representations::checks::Checks;
use psi::pipeline::typed_trees_to_checked_trees::SlotReview;

// Review the slot records published by Psi checking.
public data OmegaSlotReview {}

public machine prepare(review: @mut OmegaSlotReview) {}

public machine admits(review: @OmegaSlotReview, checks: @Checks) -> bool
crashes Trap
{
    let mut admission: SlotReview;
    psi::pipeline::typed_trees_to_checked_trees::prepare(@mut admission);
    psi::pipeline::typed_trees_to_checked_trees::admits(@admission, checks)
}
