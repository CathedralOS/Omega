use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;

// A member inherits its container's generic parameters and visibility. Name resolution
// and type checking read both from the same parsed declaration and resolved owner.
public machine generic_scope(first: u64 in Trapping, count: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
    |symbol_resolved_trees|::TypeScope {
        lexical_machine: 0 as +Trapping,
        first_generic_parameter: first,
        generic_parameter_count: count,
        first_outer_parameter: 0 as +Trapping,
        outer_parameter_count: 0 as +Trapping
    }
}

public machine container_scope(syntax: @|syntax_trees|::SyntaxTrees, owner: |symbol_resolved_trees|::MachineOwner) -> |symbol_resolved_trees|::TypeScope
crashes Trap
{
    transition owner.container {
        |syntax_trees|::MachineContainer::Root -> none(),
        |syntax_trees|::MachineContainer::Measure -> none(),
        |syntax_trees|::MachineContainer::Trait -> trait_scope(syntax, owner.item),
        |syntax_trees|::MachineContainer::Conformance -> conformance_scope(syntax, owner.item),
        |syntax_trees|::MachineContainer::Refinement -> trait_scope(syntax, owner.item)
    }

    machine none() -> |symbol_resolved_trees|::TypeScope {
        generic_scope(0 as +Trapping, 0 as +Trapping)
    }

    machine trait_scope(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
        let item: |syntax_trees|::TraitItem = |syntax_trees|::trait_item(syntax, index);
        generic_scope(item.first_generic_parameter, item.generic_parameter_count)
    }

    machine conformance_scope(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
        let item: |syntax_trees|::ConformanceItem = |syntax_trees|::conformance_item(syntax, index);
        generic_scope(item.first_generic_parameter, item.generic_parameter_count)
    }
}

public machine machine_public(resolution: @|symbol_resolved_trees|::NameResolution, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem, handle: u64 in Trapping) -> bool
crashes Trap
{
    let owner: |symbol_resolved_trees|::MachineOwner = |symbol_resolved_trees|::machine_owner(resolution, handle);
    transition owner.container {
        |syntax_trees|::MachineContainer::Root -> answer(item.is_public),
        |syntax_trees|::MachineContainer::Measure -> answer(false),
        |syntax_trees|::MachineContainer::Trait -> trait_container(syntax, owner.item),
        |syntax_trees|::MachineContainer::Refinement -> trait_container(syntax, owner.item),
        |syntax_trees|::MachineContainer::Conformance -> conformance_container(syntax, owner.item)
    }

    machine trait_container(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) -> bool {
        let container: |syntax_trees|::TraitItem = |syntax_trees|::trait_item(syntax, index);
        container.is_public
    }

    machine conformance_container(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) -> bool {
        let container: |syntax_trees|::ConformanceItem = |syntax_trees|::conformance_item(syntax, index);
        container.is_public
    }

    machine answer(is_public: bool) -> bool {
        is_public
    }
}
