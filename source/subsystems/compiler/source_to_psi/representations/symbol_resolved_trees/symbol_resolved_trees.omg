use representations/syntax_trees/syntax_trees.omg;
use representations/source_files/source.omg;

// Name bindings for the parsed roots of a compilation's source set. Each
// binding table is indexed by the syntax table whose names it binds
// (`SyntaxTrees::type_references`, `expressions`, `name_paths`, `machines`),
// so each syntax handle keeps its identity; no table repeats a spelling. The
// zero binding is the unresolved state, and an accepted resolution leaves
// none.

// Compiler-installed type names, in the reference compiler's builtin order.
public data BuiltinType [copy] {
    case Bool;
    case I8;
    case I16;
    case I32;
    case I64;
    case U8;
    case U16;
    case U32;
    case U64;
    case Address;
    case F32;
    case F64;
    case Slice;
    case SyscallResult;
    case Terminal;
    case Never;
    case UInt;
    case Int;
    case AtomicBool;
    case AtomicU32;
    case AtomicU64;
}

// Whether `builtin` is a fixed-width integer carrier.
public machine fixed_integer(builtin: BuiltinType) -> bool {
    builtin == BuiltinType::I8 || builtin == BuiltinType::I16 || builtin == BuiltinType::I32
        || builtin == BuiltinType::I64 || builtin == BuiltinType::U8 || builtin == BuiltinType::U16
        || builtin == BuiltinType::U32 || builtin == BuiltinType::U64
}

// What a type reference's name denotes: a compiler-installed type, a data
// declaration (its `SyntaxTrees::data_items` handle), or a generic parameter
// of the enclosing declaration (its `SyntaxTrees::generic_parameters`
// handle). A trait (`SyntaxTrees::traits`) is named only where a trait
// application stands: a trait's parents and a conformance's satisfied trait.
// A named conformance (`SyntaxTrees::conformances`) is named only as a static
// argument. Reference, array, slice and integer rows name no declaration:
// each binds by its form, and the rows of its run carry the names' bindings.
public data TypeBinding [copy] {
    case Unresolved;
    // Two visible declarations spell the name; the reference rejects.
    case Ambiguous;
    case Builtin(builtin: BuiltinType);
    case Data(item: u64 in Trapping);
    case GenericParameter(parameter: u64 in Trapping);
    case Reference;
    case Array;
    case Slice;
    case Literal;
    case Trait(item: u64 in Trapping);
    case Conformance(item: u64 in Trapping);
    // A static argument naming a machine (the first declaration of its
    // overload family), for a callee's machine binder.
    case Machine(handle: u64 in Trapping);
}

// A machine binder's callable contract, `requires machine F(...) -> T`
// (wiki/spec/language/generics.md, Static machine binder categories): the
// contract row the binder carries, when it has one.
public data BinderContract [copy] {
    present: bool;
    contract: u64 in Trapping;
}

// What a name or path in an expression denotes, indexed like
// `SyntaxTrees::expressions`. A membership `value in Type::Case` binds the
// case whose implied domain it names; other expressions that are not names
// stay `NotAName`; an accepted resolution leaves no `Unresolved` name. A machine
// lookup supplies a representative. A bound callee also carries the overload
// candidates visible at this use; typing selects among them. A trait requirement or a conformance member is a machine
// like any other, named through its container. A generic parameter binding
// names a value or machine binder of the enclosing machine (or of the trait
// or conformance containing it) by its `SyntaxTrees::generic_parameters`
// handle. A constant binding names a `SyntaxTrees::constants` handle, and a
// proposition binding a `SyntaxTrees::propositions` handle.
public data ValueBinding [copy] {
    case NotAName;
    case Unresolved;
    // Two visible declarations spell the name; the reference rejects.
    case Ambiguous;
    case Local(statement: u64 in Trapping);
    case Parameter(parameter: u64 in Trapping);
    case PatternBinder(field: u64 in Trapping);
    // An exact requirement or a name lookup's representative. At an
    // expression use the resolver publishes Overloads before returning.
    case Machine(handle: u64 in Trapping);
    case Data(item: u64 in Trapping);
    case DataCase(item: u64 in Trapping, data_case: u64 in Trapping);
    case GenericParameter(parameter: u64 in Trapping);
    case Constant(constant: u64 in Trapping);
    // A bare name in a data declaration's `requires` fact: one of its fields.
    case Field(field: u64 in Trapping);
    // `result` in a machine's `ensures` fact: the value the machine returns
    // (wiki/spec/language/state_contracts.md#returns-and-proof-use).
    case ReturnedValue(machine: u64 in Trapping);
    // The callee of a proposition application, which stands only as a
    // whole fact (wiki/language_guide/chapter_10_compile_time_proofs.md).
    case Proposition(proposition: u64 in Trapping);
    // A domain declaration's subject binder in its predicates: the value the
    // domain classifies (wiki/spec/language/domains.md#declaration-and-membership).
    case DomainSubject(domain: u64 in Trapping);
    // `self` in a data declaration's default-domain `requires`.
    case DataSubject(item: u64 in Trapping);
    // A compiler-known primitive byte predicate applied to a byte view.
    case BytePredicate(predicate: BytePredicate);
    // `size_of` or `align_of`, the primitive layout queries
    // (wiki/spec/language/counts_and_addresses.md).
    case LayoutQuery(query: LayoutQuery);
    // `result` in a callable binder contract belongs to that exact signature,
    // independently of the enclosing machine's result type.
    case ContractReturnedValue(contract: u64 in Trapping);
    case Overloads(representative: u64 in Trapping, candidates: VisibleOverloads);
    // A bare pattern and its uses name the same evaluated expression.
    case MatchedSubject(subject: u64 in Trapping);
}

// A candidate is a machine handle plus one; zero ends the family. Every call
// in the declaring package shares the full chain. Imports from other packages
// share the chain of public members. Both preserve declaration order.
public data VisibleOverloads [copy] {
    first: u64 in Trapping;
    public_only: bool;
}

public data OverloadLinks [copy] {
    all: u64 in Trapping;
    exported: u64 in Trapping;
}

// The primitive byte predicates over a byte view
// (wiki/spec/terminal-psi/byte_views.md, source-rust/subsystems/compiler/psi/artifact/wire/encoding.md):
// `valid_utf8`, `no_nul`, `ascii_only` and `non_empty`. A declaration of the
// same spelling is found first.
public data BytePredicate [copy] {
    case ValidUtf8;
    case NoNul;
    case AsciiOnly;
    case NonEmpty;
}

public data LayoutQuery [copy] {
    case Size;
    case Align;
}

// What a `::` name path denotes, indexed like `SyntaxTrees::name_paths`: a
// machine (a domain's establishment route; a trait requirement is a machine)
// or a domain (an alias constituent).
public data PathBinding [copy] {
    case Unresolved;
    case Machine(handle: u64 in Trapping);
    case Domain(item: u64 in Trapping);
}

// The generic parameters a type name may bind: the enclosing declaration's
// contiguous range of `SyntaxTrees::generic_parameters`, then, for a trait or
// conformance member, its container's range, which the member's own shadow.
public data TypeScope [copy] {
    // Declaration handle plus one, never a runtime environment.
    lexical_machine: u64 in Trapping;
    first_generic_parameter: u64 in Trapping;
    generic_parameter_count: u64 in Trapping;
    first_outer_parameter: u64 in Trapping;
    outer_parameter_count: u64 in Trapping;
}

// What the `in Domain` qualifier of a type reference denotes. A bare
// reference stays `Unqualified`. The arithmetic policies and `Finite` are
// compiler-known; `Declared` is a `domain` declaration whose handle is the
// row's `NameResolution::domain_items` entry, and `Case` a case's implied
// domain (`Type::Case`), whose entry is the case's `SyntaxTrees::data_cases`
// handle.
public data DomainBinding [copy] {
    case Unqualified;
    case Wrapping;
    case Saturating;
    case Trapping;
    case Finite;
    case Declared;
    case Case;
}

// Where a machine declaration stands and the owner its path spells. A root
// machine's owner is its authored `Owner::`; a trait requirement or default
// and a conformance member are named through their container (`Trait::name`,
// `Conformance::name`), whose `SyntaxTrees::traits` or `conformances` handle
// is `item`. Overload families, duplicates and callees compare these paths.
public data MachineOwner [copy] {
    container: |syntax_trees|::MachineContainer;
    item: u64 in Trapping;
    has_owner: bool;
    owner: |syntax_trees|::IdentifierSpan;
}

public data ResolveDiagnosticCode [copy] {
    case None;
    case UnresolvedImport;
    // A required rooted import has no matching product dependency or toolchain mount.
    case UndeclaredDependency;
    // A data, trait or conformance name spells a builtin type, or a domain
    // name a compiler-known domain.
    case ShadowsBuiltin;
    case DuplicateData;
    case DuplicateDataMember;
    case DuplicateCasePayloadField;
    case PayloadFieldCollidesWithCommonField;
    case UnknownDataType;
    case UnknownDomain;
    case DuplicateParameter;
    case DuplicateMachine;
    case DuplicateGenericParameter;
    case UnknownName;
    case AmbiguousName;
    case PartialStableIdentities;
    case DuplicateStableIdentity;
    case InvalidStableIdentity;
    // A declaration kind resolution does not bind yet: a mathematical
    // definition (`let` root) or a transparent trait refinement. It rejects
    // at its root rather than resolving as if absent.
    case UnsupportedDeclaration;
    // A form whose bindings resolution does not record yet rejects at that
    // form: an operator token outside an ordinary owned machine (or `==`,
    // `!=`, `[]`, `[..]`), a `requires machine` or `requires proposition`
    // contract, a `satisfies` clause naming its trait through a module path,
    // or a proposition or evidence binder.
    case UnsupportedOperatorToken;
    case UnsupportedMachineContract;
    case UnsupportedClause;
    case UnsupportedGenericParameter;
    // An expression form resolution does not bind yet: a membership in
    // several domains at once, or a proposition application inside a
    // larger fact.
    case UnsupportedExpression;
    // A trait, conformance, domain, constant or proposition repeats an
    // earlier declaration of its namespace in one module.
    case DuplicateDeclaration;
    // A trait or conformance named where a type stands.
    case NotAType;
    // A trait position names something other than a trait.
    case NotATrait;
    case ExpectedBoundaryService;
    case MissingServiceArguments;
    // A `satisfies` clause names no requirement of its trait.
    case NotARequirement;
    // A token-bound machine whose owner is not a data declaration of its own
    // package: only a closed family's semantic home publishes its tokens.
    case ForeignOperatorHome;
    // A proposition applied where a value is computed: a body, a
    // transition target, a constant's value, a clause's payload. A
    // proposition names a statement, not an executable condition
    // (wiki/spec/proofs/mathematical_bindings.md#assumptions-and-executable-demand).
    case ProofOnlyApplication;
    // A `requires machine` contract whose name is none of its machine's
    // `machine` binders.
    case ContractNamesNoBinder;
    // A second `requires machine` contract for one binder.
    case DuplicateContract;
    // A `terminates by` view outside the compiler's ranking vocabulary.
    case UnsupportedRankingView;
    // A lifetime tag no binder of the declaration declares, and an applied
    // name whose lifetime arguments, when it spells any, differ in count
    // from its declaration's lifetime binders
    // (wiki/spec/language/lifetimes.md).
    case UndeclaredLifetime;
    case LifetimeArgumentCount;
    // A computed measure without exactly one parameter, a result type and
    // a one-expression body, or a lexicographic measure whose owner is no
    // data declaration (wiki/spec/language/termination.md#ranking).
    case MeasureForm;
    // A lexicographic component naming no field of the measure's owner.
    case UnknownMeasureComponent;
    case DuplicateLocalBinding;
}

public data ResolveDiagnostic [copy] {
    code: ResolveDiagnosticCode;
    source_span: |source|::SourceSpan;
}

public data NameResolution
requires
    binding_count <= 65536,
    value_binding_count <= 131072,
    path_binding_count <= 2048,
    machine_owner_count <= 10240,
    requirement_count <= 2048,
{
    type_bindings: [TypeBinding; 65536];
    domain_bindings: [DomainBinding; 65536];
    domain_items: [u64; 65536];
    binding_count: u64;
    value_bindings: [ValueBinding; 131072];
    value_binding_count: u64;
    path_bindings: [PathBinding; 2048];
    path_binding_count: u64;
    overloads: OverloadTable;
    machine_owners: [MachineOwner; 10240];
    machine_owner_count: u64;
    // Each clause's exact trait requirement, by clause handle: a `satisfies`
    // clause binds the requirement machine it names, every other clause
    // nothing (`NotAName`).
    requirements: [ValueBinding; 2048];
    requirement_count: u64;
    // Each machine's operator home, by machine handle: the data declaration
    // a token-bound machine's owner names; `Unresolved` for a machine
    // binding no token.
    operator_homes: [TypeBinding; 10240];
    // Each generic parameter's callable contract, by generic parameter
    // handle.
    binder_contracts: [BinderContract; 256];
    // Each `terminates by` clause's ranking view, by clause handle.
    ranking_views: [RankingView; 2048];
    // For a clause whose view is a declared measure, that measure's machine
    // handle.
    ranking_measures: [u64; 2048];
    // For each component of a lexicographic measure, by member handle, the
    // field handle of its owner it names, plus one; zero for none.
    component_fields: [u64; 32000];
    // One-based trait handle for a resolved service occurrence, zero on
    // every other path member. The syntax table holds at most 256 traits.
    service_traits: [u16; 32000];
    service_member_count: u64;
    diagnostic: ResolveDiagnostic;
    accepted: bool;
}

public data OverloadTable {
    successors: [OverloadLinks; 10240];
}

// Build in reverse order so a member can share the suffix of both lists.
public machine prepend_overload(table: @mutable OverloadTable, handle: u64 in Trapping, heads: OverloadLinks, exported: bool) -> OverloadLinks
crashes Trap
{
    transition handle < 10240 {
        true -> store(table, handle, heads, exported),
        _ -> invalid()
    }
    machine store(table: @mutable OverloadTable, handle: u64 in Trapping, heads: OverloadLinks, exported: bool) -> OverloadLinks
    requires handle < 10240
    {
        table.successors[handle as -Trapping] = heads;
        let cursor: u64 in Trapping = handle + 1;
        transition exported {
            true -> OverloadLinks { all: cursor, exported: cursor },
            false -> OverloadLinks { all: cursor, exported: heads.exported }
        }
    }
    machine invalid() -> OverloadLinks { crash Trap; }
}

public machine next_overload(table: @OverloadTable, handle: u64 in Trapping, public_only: bool) -> u64 in Trapping
crashes Trap
{
    transition handle < 10240 {
        true -> read(table, handle, public_only),
        _ -> invalid()
    }
    machine read(table: @OverloadTable, handle: u64 in Trapping, public_only: bool) -> u64 in Trapping
    requires handle < 10240
    {
        let links: OverloadLinks = table.successors[handle as -Trapping];
        transition public_only { true -> links.exported, false -> links.all }
    }
    machine invalid() -> u64 in Trapping { crash Trap; }
}

public machine name_resolution_clear(resolution: @mutable NameResolution, source: |source|::SourceId) {
    resolution.binding_count = 0;
    resolution.value_binding_count = 0;
    resolution.path_binding_count = 0;
    resolution.machine_owner_count = 0;
    resolution.requirement_count = 0;
    resolution.accepted = true;
    resolution.diagnostic.code = ResolveDiagnosticCode::None;
    resolution.diagnostic.source_span.source = source;
    resolution.diagnostic.source_span.span.start = 0 as +Trapping;
    resolution.diagnostic.source_span.span.end = 0 as +Trapping;
}

public machine name_resolution_reject(
    resolution: @mutable NameResolution,
    code: ResolveDiagnosticCode,
    source_span: |source|::SourceSpan
) {
    resolution.accepted = false;
    resolution.diagnostic.code = code;
    resolution.diagnostic.source_span = source_span;
}

// The binding of expression `index`, which must be below the bound count.
public machine value_binding(resolution: @NameResolution, index: u64 in Trapping) -> ValueBinding
crashes Trap
{
    transition index < resolution.value_binding_count {
        true -> read(resolution, index),
        _ -> invalid()
    }

    machine read(resolution: @NameResolution, index: u64 in Trapping) -> ValueBinding {
        resolution.value_bindings[index as -Trapping]
    }

    machine invalid() -> ValueBinding {
        crash Trap;
    }
}

// A machine binder's static argument: a declared machine (the first
// declaration of the family its name binds), or a binder of the caller's
// forwarded.
public data MachineArgument [copy] {
    case Absent;
    case Declared(machine: u64 in Trapping);
    case Forwarded(parameter: u64 in Trapping);
}

// What static argument row `row` names for a machine binder
// (wiki/spec/language/generics.md#static-machine-binder-categories).
public machine name_resolution_machine_argument(syntax: @|syntax_trees|::SyntaxTrees, resolution: @NameResolution, row: u64 in Trapping) -> MachineArgument
crashes Trap
{
    let binding: TypeBinding = type_binding_at(resolution, row);
    transition binding {
        TypeBinding::Machine { handle } -> chosen(MachineArgument::Declared { machine: handle }),
        TypeBinding::GenericParameter { parameter } -> generic(syntax, parameter),
        _ -> chosen(MachineArgument::Absent)
    }

    machine generic(syntax: @|syntax_trees|::SyntaxTrees, parameter: u64 in Trapping) -> MachineArgument {
        let declared: |syntax_trees|::GenericParameter = |syntax_trees|::syntax_trees_generic_parameter(syntax, parameter);
        transition declared.kind == |syntax_trees|::GenericParameterKind::Machine {
            true -> chosen(MachineArgument::Forwarded { parameter: parameter }),
            _ -> chosen(MachineArgument::Absent)
        }
    }

    machine chosen(argument: MachineArgument) -> MachineArgument {
        argument
    }
}

// The callable contract generic parameter `parameter` carries; none for a
// parameter beyond the table.
public machine binder_contract(resolution: @NameResolution, parameter: u64 in Trapping) -> BinderContract {
    transition parameter < 256 {
        true -> read(resolution, parameter),
        _ -> none()
    }

    machine read(resolution: @NameResolution, parameter: u64 in Trapping) -> BinderContract
    requires parameter < 256
    {
        resolution.binder_contracts[parameter as -Trapping]
    }

    machine none() -> BinderContract {
        BinderContract { present: false, contract: 0 as +Trapping }
    }
}

public machine set_binder_contract(resolution: @mutable NameResolution, parameter: u64 in Trapping, contract: BinderContract)
crashes Trap
{
    transition parameter < 256 {
        true -> write(resolution, parameter, contract),
        _ -> invalid()
    }

    machine write(resolution: @mutable NameResolution, parameter: u64 in Trapping, contract: BinderContract)
    requires parameter < 256
    {
        resolution.binder_contracts[parameter as -Trapping] = contract;
    }

    machine invalid() {
        crash Trap;
    }
}

// The requirement clause `index` names, which must be below the bound count.
public machine name_resolution_requirement(resolution: @NameResolution, index: u64 in Trapping) -> ValueBinding
crashes Trap
{
    transition index < resolution.requirement_count {
        true -> read(resolution, index),
        _ -> invalid()
    }

    machine read(resolution: @NameResolution, index: u64 in Trapping) -> ValueBinding {
        resolution.requirements[index as -Trapping]
    }

    machine invalid() -> ValueBinding {
        crash Trap;
    }
}

public machine operator_home_is_data(home: TypeBinding, data: u64 in Trapping) -> bool {
    transition home {
        TypeBinding::Data { item } -> data_item(item, data),
        _ -> elsewhere()
    }

    machine data_item(item: u64 in Trapping, data: u64 in Trapping) -> bool {
        item == data
    }

    machine elsewhere() -> bool {
        false
    }
}

// The data a token-bound machine `handle` is homed at, or `Unresolved`;
// `handle` must be below the machine count.
public machine operator_home(resolution: @NameResolution, handle: u64 in Trapping) -> TypeBinding
crashes Trap
{
    transition handle < resolution.machine_owner_count {
        true -> read(resolution, handle),
        _ -> invalid()
    }

    machine read(resolution: @NameResolution, handle: u64 in Trapping) -> TypeBinding {
        resolution.operator_homes[handle as -Trapping]
    }

    machine invalid() -> TypeBinding {
        crash Trap;
    }
}

// Where machine `handle` stands, which must be below the bound count.
public machine machine_owner(resolution: @NameResolution, handle: u64 in Trapping) -> MachineOwner
crashes Trap
{
    transition handle < resolution.machine_owner_count {
        true -> read(resolution, handle),
        _ -> invalid()
    }

    machine read(resolution: @NameResolution, handle: u64 in Trapping) -> MachineOwner {
        resolution.machine_owners[handle as -Trapping]
    }

    machine invalid() -> MachineOwner {
        crash Trap;
    }
}

// The reserved policy names always denote the same domains.
public machine builtin_domain(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> DomainBinding
crashes Trap
{
    let matched: bool = |source|::span_spells(sources, name, "Wrapping");
    transition matched {
        true -> found(DomainBinding::Wrapping),
        _ -> saturating(sources, name)
    }

    machine saturating(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> DomainBinding {
        let matched: bool = |source|::span_spells(sources, name, "Saturating");
        transition matched {
            true -> found(DomainBinding::Saturating),
            _ -> trapping(sources, name)
        }
    }

    machine trapping(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> DomainBinding {
        let matched: bool = |source|::span_spells(sources, name, "Trapping");
        transition matched {
            true -> found(DomainBinding::Trapping),
            _ -> finite(sources, name)
        }
    }

    machine finite(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> DomainBinding {
        let matched: bool = |source|::span_spells(sources, name, "Finite");
        transition matched {
            true -> found(DomainBinding::Finite),
            _ -> found(DomainBinding::Unqualified)
        }
    }

    machine found(binding: DomainBinding) -> DomainBinding {
        binding
    }
}

// The qualifier kind of type reference `row`, below the bound count.
public machine domain_binding_at(resolution: @NameResolution, row: u64 in Trapping) -> DomainBinding
crashes Trap
{
    transition row < resolution.binding_count {
        true -> read(resolution, row),
        _ -> invalid()
    }

    machine read(resolution: @NameResolution, row: u64 in Trapping) -> DomainBinding {
        resolution.domain_bindings[row as -Trapping]
    }

    machine invalid() -> DomainBinding {
        crash Trap;
    }
}

// The declared domain or case of type reference `row`, below the bound
// count.
public machine name_resolution_domain_item(resolution: @NameResolution, row: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition row < resolution.binding_count {
        true -> read(resolution, row),
        _ -> invalid()
    }

    machine read(resolution: @NameResolution, row: u64 in Trapping) -> u64 in Trapping {
        resolution.domain_items[row as -Trapping] as +Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// The binding of name path `handle`, below the bound count.
public machine path_binding(resolution: @NameResolution, handle: u64 in Trapping) -> PathBinding
crashes Trap
{
    transition handle < resolution.path_binding_count {
        true -> read(resolution, handle),
        _ -> invalid()
    }

    machine read(resolution: @NameResolution, handle: u64 in Trapping) -> PathBinding {
        resolution.path_bindings[handle as -Trapping]
    }

    machine invalid() -> PathBinding {
        crash Trap;
    }
}

// The binding of type reference `row` while resolution runs: every row
// below the syntax table's count, bound or not yet.
public machine type_binding_at(resolution: @NameResolution, row: u64 in Trapping) -> TypeBinding
crashes Trap
{
    transition row < 65536 {
        true -> read(resolution, row),
        _ -> invalid()
    }

    machine read(resolution: @NameResolution, row: u64 in Trapping) -> TypeBinding {
        resolution.type_bindings[row as -Trapping]
    }

    machine invalid() -> TypeBinding {
        crash Trap;
    }
}

// The binding of name path `handle` while resolution runs.
public machine path_binding_at(resolution: @NameResolution, handle: u64 in Trapping) -> PathBinding
crashes Trap
{
    transition handle < 2048 {
        true -> read(resolution, handle),
        _ -> invalid()
    }

    machine read(resolution: @NameResolution, handle: u64 in Trapping) -> PathBinding {
        resolution.path_bindings[handle as -Trapping]
    }

    machine invalid() -> PathBinding {
        crash Trap;
    }
}

// The binding of expression `handle` while resolution runs: every
// expression below the table's capacity, bound or not yet.
public machine value_binding_at(resolution: @NameResolution, handle: u64 in Trapping) -> ValueBinding
crashes Trap
{
    transition handle < 131072 {
        true -> read(resolution, handle),
        _ -> invalid()
    }

    machine read(resolution: @NameResolution, handle: u64 in Trapping) -> ValueBinding {
        resolution.value_bindings[handle as -Trapping]
    }

    machine invalid() -> ValueBinding {
        crash Trap;
    }
}

// The well-founded order a `terminates by` witness ranks its subjects in
// (wiki/spec/language/termination.md#ranking): a closed vocabulary the
// compiler owns. `Default` is a witness without `-> View`, which the
// subjects' carriers elaborate: a single unsigned integer descends as a
// natural and a two-subject tuple ranks by its bounded distance.
// `Descending` is `Nat::Descending`; `BoundedDistance` is
// `Nat::BoundedDistance` over `(lower, upper)`, the distance from the lower
// subject up to the upper; `SliceLength` is `Slice::Length`, a slice's
// length; `IncreasingTo` is `Nat::IncreasingTo(limit)`, one climbing subject's
// distance up to the view's argument.
public data RankingView [copy] {
    case Default;
    case Descending;
    case BoundedDistance;
    case SliceLength;
    case IncreasingTo;
    // A declared measure, the machine `ranking_measures` records for the
    // clause (wiki/spec/language/termination.md#ranking).
    case Measure;
}

public machine ranking_view(resolution: @NameResolution, clause: u64 in Trapping) -> RankingView {
    transition clause < 2048 {
        true -> read(resolution, clause),
        _ -> none()
    }

    machine read(resolution: @NameResolution, clause: u64 in Trapping) -> RankingView
    requires clause < 2048
    {
        resolution.ranking_views[clause as -Trapping]
    }

    machine none() -> RankingView {
        RankingView::Default
    }
}

public machine set_ranking_view(resolution: @mutable NameResolution, clause: u64 in Trapping, view: RankingView)
crashes Trap
{
    transition clause < 2048 {
        true -> write(resolution, clause, view),
        _ -> invalid()
    }

    machine write(resolution: @mutable NameResolution, clause: u64 in Trapping, view: RankingView)
    requires clause < 2048
    {
        resolution.ranking_views[clause as -Trapping] = view;
    }

    machine invalid() {
        crash Trap;
    }
}

// The exact declared measure selected by this witness clause.
public machine ranking_measure(resolution: @NameResolution, clause: u64 in Trapping) -> u64 in Trapping {
    transition clause < 2048 {
        true -> read(resolution, clause),
        _ -> none()
    }

    machine read(resolution: @NameResolution, clause: u64 in Trapping) -> u64 in Trapping
    requires clause < 2048
    {
        resolution.ranking_measures[clause as -Trapping] as +Trapping
    }

    machine none() -> u64 in Trapping {
        0 as +Trapping
    }
}

public machine set_ranking_measure(resolution: @mutable NameResolution, clause: u64 in Trapping, measure: u64 in Trapping)
crashes Trap
{
    transition clause < 2048 {
        true -> write(resolution, clause, measure),
        _ -> invalid()
    }

    machine write(resolution: @mutable NameResolution, clause: u64 in Trapping, measure: u64 in Trapping)
    requires clause < 2048
    {
        resolution.ranking_measures[clause as -Trapping] = measure as -Trapping;
    }

    machine invalid() {
        crash Trap;
    }
}

public machine component_field(resolution: @NameResolution, member: u64 in Trapping) -> u64 in Trapping {
    transition member < 32000 {
        true -> read(resolution, member),
        _ -> none()
    }

    machine read(resolution: @NameResolution, member: u64 in Trapping) -> u64 in Trapping
    requires member < 32000
    {
        resolution.component_fields[member as -Trapping] as +Trapping
    }

    machine none() -> u64 in Trapping {
        0 as +Trapping
    }
}

public machine set_component_field(resolution: @mutable NameResolution, member: u64 in Trapping, bound: u64 in Trapping)
crashes Trap
{
    transition member < 32000 {
        true -> write(resolution, member, bound),
        _ -> invalid()
    }

    machine write(resolution: @mutable NameResolution, member: u64 in Trapping, bound: u64 in Trapping)
    requires member < 32000
    {
        resolution.component_fields[member as -Trapping] = bound as -Trapping;
    }

    machine invalid() {
        crash Trap;
    }
}

public machine service_trait(resolution: @NameResolution, member: u64 in Trapping) -> u16 {
    transition member < resolution.service_member_count && member < 32000 {
        true -> read(resolution, member as -Trapping),
        _ -> none()
    }
    machine read(resolution: @NameResolution, member: u64) -> u16
    requires member < 32000
    { resolution.service_traits[member] }
    machine none() -> u16 { 0 }
}
