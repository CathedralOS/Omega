// Product Psi source custody for the current hosted compiler slice.
//
// Source coordinates are byte offsets. UTF-8 validation belongs at the
// source-unit boundary; the lexer never repairs invalid input or substitutes
// host paths for authored source identity.

public data SourceId [copy] {
    value: u32 in Trapping;
}

public data Span [copy] {
    start: u64 in Trapping;
    end: u64 in Trapping;
}

public data SourceSpan [copy] {
    source: SourceId;
    span: Span;
}

public data SourceUnit
requires
    length <= 131072,
{
    id: SourceId;
    bytes: [u8; 131072];
    length: u64;
    last_retained: bool;
}

machine source_unit_clear(source_unit: @mutable SourceUnit, id: SourceId) {
    source_unit.id = id;
    source_unit.length = 0;
    source_unit.last_retained = true;
}

machine source_unit_append(source_unit: @mutable SourceUnit, byte: u8) {
    source_unit.last_retained = false;
    transition source_unit.length < 131072 {
        true -> retain(source_unit, byte),
        _ -> full(source_unit)
    }

    machine retain(source_unit: @mutable SourceUnit, byte: u8)
    requires source_unit.length < 131072
    {
        source_unit.bytes[source_unit.length] = byte;
        source_unit.length = source_unit.length + 1;
        source_unit.last_retained = true;
    }

    machine full(source_unit: @mutable SourceUnit) {
        source_unit.last_retained = false;
    }
}

// Centralize the backing-array proof. Lexer callers establish their stronger
// lexical bounds before reading; the NUL fallback makes a violated internal
// coordinate fail token recognition instead of performing an unchecked read.
// The forwarded coordinate is proven against the array's own length: the
// `length` range does not transport through the retained-length comparison.
machine source_unit_byte_or_nul(source_unit: @SourceUnit, index: u64 in Trapping) -> u8 {
    transition index < source_unit.length {
        true -> retain(source_unit, index),
        _ -> absent()
    }

    machine retain(source_unit: @SourceUnit, index: u64 in Trapping) -> u8 {
        transition index < 131072 {
            true -> read(source_unit, index),
            _ -> absent()
        }
    }

    machine read(source_unit: @SourceUnit, index: u64 in Trapping) -> u8
    requires index < 131072
    {
        // The buffer stores ordinary bytes; only the coordinate carries a
        // policy. Remove it after establishing the physical array bound.
        source_unit.bytes[index as -Trapping]
    }

    machine absent() -> u8 {
        0
    }
}

// An admitted package-relative filename or a package or dependency name.
// The construction request provides filenames with the literal .omg suffix
// and forward slashes between components.
public data ModulePath
requires
    length <= 256,
{
    bytes: [u8; 256];
    length: u64;
}

public machine module_path_clear(module_path: @mutable ModulePath) {
    module_path.length = 0;
}

// Append one byte; the path's provision is exhausted when it reports false.
public machine module_path_append(module_path: @mutable ModulePath, byte: u8) -> bool {
    transition module_path.length < 256 {
        true -> retain(module_path, byte),
        _ -> full()
    }

    machine retain(module_path: @mutable ModulePath, byte: u8) -> bool
    requires module_path.length < 256
    {
        module_path.bytes[module_path.length] = byte;
        module_path.length = module_path.length + 1;
        true
    }

    machine full() -> bool {
        false
    }
}

public data SourceRange [copy] {
    start: u64 in Trapping;
    length: u64 in Trapping;
}

// A package of one compilation (wiki/spec/build/compiler_request.md): its
// declared name, a range of the path arena, or the toolchain's core package,
// which carries no name and which every package selects through the
// language's mount `{omega}/language/core` rather than by a dependency
// alias (wiki/spec/packages/toolchain.md).
public data PackageRow [copy] {
    name: SourceRange;
    toolchain: bool;
}

// Which checked context a dependency edge authorizes: ordinary product
// imports, or the build entry's and its local helpers' imports. An alias of
// one scope never stands in for the other.
public data DependencyScope [copy] {
    case Product;
    case Build;
}

// A requester-local dependency edge, as the request's edge rows give it:
// within package `requester`'s `scope` imports, `alias` (a range of the path
// arena) names package `target`.
public data DependencyRow [copy] {
    requester: u64 in Trapping;
    scope: DependencyScope;
    alias: SourceRange;
    target: u64 in Trapping;
}

// Every source unit of one compilation, with its package and filename, and the packages' requester-local dependency
// edges. A unit's `SourceId` is its position, so a `SourceSpan` names its
// bytes wherever the span is stored, and spans of different units compare
// through the set. Units, filenames, package names and aliases share
// bounded arenas; the request's graph validation, not this set, rejects
// duplicate aliases of one requester and scope.
public data SourceSet
requires
    unit_count <= 512,
    byte_count <= 8388608,
    path_byte_count <= 16384,
    package_count <= 64,
    dependency_count <= 256,
{
    bytes: [u8; 8388608];
    byte_count: u64;
    path_bytes: [u8; 16384];
    path_byte_count: u64;
    units: [SourceRange; 512];
    paths: [SourceRange; 512];
    unit_packages: [u64; 512];
    unit_count: u64;
    packages: [PackageRow; 64];
    package_count: u64;
    dependencies: [DependencyRow; 256];
    dependency_count: u64;
}

public machine source_set_clear(sources: @mutable SourceSet) {
    sources.byte_count = 0;
    sources.path_byte_count = 0;
    sources.unit_count = 0;
    sources.package_count = 0;
    sources.dependency_count = 0;
}

// Add a unit of package `package` as the next `SourceId`, or report false
// when the package is not in the set or the set's provisions cannot hold
// the unit.
public machine source_set_add(
    sources: @mutable SourceSet,
    unit: @SourceUnit,
    package: u64 in Trapping,
    module_path: @ModulePath
) -> bool
crashes Trap
{
    transition sources.unit_count < 512
        && package < sources.package_count
        && unit.length <= 8388608 - sources.byte_count
        && module_path.length <= 16384 - sources.path_byte_count {
        true -> check_name(sources, unit, package, module_path, 0 as +Trapping),
        _ -> full()
    }

    machine check_name(sources: @mutable SourceSet, unit: @SourceUnit, package: u64 in Trapping, filename: @ModulePath, prior: u64 in Trapping) -> bool {
        transition filename.length > 0 && prior < sources.unit_count {
            true -> candidate(sources, unit, package, filename, prior),
            false -> path(sources, unit, package, filename)
        }
    }

    machine candidate(sources: @mutable SourceSet, unit: @SourceUnit, package: u64 in Trapping, filename: @ModulePath, prior: u64 in Trapping) -> bool {
        let owner: u64 in Trapping = unit_package(sources, prior);
        let length: u64 in Trapping = path_length(sources, prior);
        transition owner == package && length == filename.length {
            true -> compare(sources, unit, package, filename, prior, 0 as +Trapping),
            false -> check_name(sources, unit, package, filename, prior + 1)
        }
    }

    machine compare(sources: @mutable SourceSet, unit: @SourceUnit, package: u64 in Trapping, filename: @ModulePath, prior: u64 in Trapping, offset: u64 in Trapping) -> bool {
        transition offset < filename.length && offset < 256 {
            true -> compare_byte(sources, unit, package, filename, prior, offset),
            false -> full()
        }
    }

    machine compare_byte(sources: @mutable SourceSet, unit: @SourceUnit, package: u64 in Trapping, filename: @ModulePath, prior: u64 in Trapping, offset: u64 in Trapping) -> bool
    requires offset < 256
    {
        let byte: u8 = path_byte_or_nul(sources, prior, offset);
        transition byte == filename.bytes[offset as -Trapping] {
            true -> compare(sources, unit, package, filename, prior, offset + 1),
            false -> check_name(sources, unit, package, filename, prior + 1)
        }
    }

    machine path(sources: @mutable SourceSet, unit: @SourceUnit, package: u64 in Trapping, module_path: @ModulePath) -> bool {
        let path: SourceRange = store_name(sources, module_path);
        transition { _ -> bytes(sources, unit, package, path, 0 as +Trapping) }
    }

    machine bytes(sources: @mutable SourceSet, unit: @SourceUnit, package: u64 in Trapping, path: SourceRange, index: u64 in Trapping) -> bool {
        transition index < unit.length {
            true -> unit_byte(sources, unit, package, path, index),
            _ -> record(sources, unit, package, path)
        }
    }

    machine unit_byte(sources: @mutable SourceSet, unit: @SourceUnit, package: u64 in Trapping, path: SourceRange, index: u64 in Trapping) -> bool {
        let at: u64 in Trapping = (sources.byte_count as +Trapping) + index;
        let byte: u8 = source_unit_byte_or_nul(unit, index);
        transition at < 8388608 {
            true -> store_unit_byte(sources, unit, package, path, index, at, byte),
            _ -> invalid()
        }
    }

    machine store_unit_byte(
        sources: @mutable SourceSet,
        unit: @SourceUnit,
        package: u64 in Trapping,
        path: SourceRange,
        index: u64 in Trapping,
        at: u64 in Trapping,
        byte: u8
    ) -> bool
    requires at < 8388608
    {
        sources.bytes[at as -Trapping] = byte;
        transition { _ -> bytes(sources, unit, package, path, index + 1) }
    }

    // The unit's bytes begin where the arena ended before it.
    machine record(sources: @mutable SourceSet, unit: @SourceUnit, package: u64 in Trapping, path: SourceRange) -> bool {
        let unit_count: u64 in Trapping = sources.unit_count as +Trapping;
        let unit_start: u64 in Trapping = sources.byte_count as +Trapping;
        let unit_length: u64 in Trapping = unit.length as +Trapping;
        let unit_end: u64 in Trapping = unit_start + unit_length;
        transition unit_count < 512 && unit_end <= 8388608 {
            true -> store_ranges(sources, unit_count, unit_start, unit_length, unit_end, package, path),
            _ -> invalid()
        }
    }

    machine store_ranges(
        sources: @mutable SourceSet,
        unit_count: u64 in Trapping,
        unit_start: u64 in Trapping,
        unit_length: u64 in Trapping,
        unit_end: u64 in Trapping,
        package: u64 in Trapping,
        path: SourceRange
    ) -> bool
    requires unit_count < 512, unit_end <= 8388608
    {
        sources.units[unit_count as -Trapping] = SourceRange { start: unit_start, length: unit_length };
        sources.paths[unit_count as -Trapping] = path;
        sources.unit_packages[unit_count as -Trapping] = package as -Trapping;
        sources.byte_count = unit_end as -Trapping;
        sources.unit_count = (unit_count + 1) as -Trapping;
        true
    }

    machine full() -> bool {
        false
    }

    machine invalid() -> bool {
        crash Trap;
    }
}

// Add a package named `name`, or the toolchain package (whose name is
// empty), as the next package index, or report false when the set's
// provisions cannot hold it.
public machine add_package(sources: @mutable SourceSet, name: @ModulePath, toolchain: bool) -> bool
crashes Trap
{
    transition sources.package_count < 64 && name.length <= 16384 - sources.path_byte_count {
        true -> store(sources, name, toolchain),
        _ -> full()
    }

    machine store(sources: @mutable SourceSet, name: @ModulePath, toolchain: bool) -> bool {
        let range: SourceRange = store_name(sources, name);
        let index: u64 in Trapping = sources.package_count as +Trapping;
        transition index < 64 {
            true -> record(sources, index, range, toolchain),
            _ -> full()
        }
    }

    machine record(sources: @mutable SourceSet, index: u64 in Trapping, range: SourceRange, toolchain: bool) -> bool
    requires index < 64
    {
        sources.packages[index as -Trapping] = PackageRow { name: range, toolchain: toolchain };
        sources.package_count = (index + 1) as -Trapping;
        true
    }

    machine full() -> bool {
        false
    }
}

// Add the edge by which `alias` names package `target` within package
// `requester`'s `scope` imports, or report false when either package is not
// in the set or the set's provisions cannot hold the edge.
public machine add_dependency(
    sources: @mutable SourceSet,
    requester: u64 in Trapping,
    scope: DependencyScope,
    alias: @ModulePath,
    target: u64 in Trapping
) -> bool
crashes Trap
{
    transition sources.dependency_count < 256
        && requester < sources.package_count
        && target < sources.package_count
        && alias.length <= 16384 - sources.path_byte_count {
        true -> store(sources, requester, scope, alias, target),
        _ -> refused()
    }

    machine store(
        sources: @mutable SourceSet,
        requester: u64 in Trapping,
        scope: DependencyScope,
        alias: @ModulePath,
        target: u64 in Trapping
    ) -> bool {
        let range: SourceRange = store_name(sources, alias);
        let index: u64 in Trapping = sources.dependency_count as +Trapping;
        transition index < 256 {
            true -> record(sources, index, requester, scope, range, target),
            _ -> refused()
        }
    }

    machine record(
        sources: @mutable SourceSet,
        index: u64 in Trapping,
        requester: u64 in Trapping,
        scope: DependencyScope,
        range: SourceRange,
        target: u64 in Trapping
    ) -> bool
    requires index < 256
    {
        sources.dependencies[index as -Trapping] = DependencyRow { requester: requester, scope: scope, alias: range, target: target };
        sources.dependency_count = (index + 1) as -Trapping;
        true
    }

    machine refused() -> bool {
        false
    }
}

// Append `name` to the path arena and give its range. Callers check the
// arena's provision first, so running out of it is an internal fault.
machine store_name(sources: @mutable SourceSet, name: @ModulePath) -> SourceRange
crashes Trap
{
    transition { _ -> next(sources, name, 0 as +Trapping) }

    machine next(sources: @mutable SourceSet, name: @ModulePath, index: u64 in Trapping) -> SourceRange {
        transition index < name.length {
            true -> byte(sources, name, index),
            _ -> stored(sources, name)
        }
    }

    machine byte(sources: @mutable SourceSet, name: @ModulePath, index: u64 in Trapping) -> SourceRange {
        let at: u64 in Trapping = (sources.path_byte_count as +Trapping) + index;
        transition index < 256 && at < 16384 {
            true -> store(sources, name, index, at),
            _ -> invalid()
        }
    }

    machine store(sources: @mutable SourceSet, name: @ModulePath, index: u64 in Trapping, at: u64 in Trapping) -> SourceRange
    requires index < 256, at < 16384
    {
        let byte: u8 = name.bytes[index as -Trapping];
        sources.path_bytes[at as -Trapping] = byte;
        transition { _ -> next(sources, name, index + 1) }
    }

    machine stored(sources: @mutable SourceSet, name: @ModulePath) -> SourceRange {
        let start: u64 in Trapping = sources.path_byte_count as +Trapping;
        let length: u64 in Trapping = name.length as +Trapping;
        let end: u64 in Trapping = start + length;
        transition end <= 16384 {
            true -> advance(sources, start, length, end),
            _ -> invalid()
        }
    }

    machine advance(sources: @mutable SourceSet, start: u64 in Trapping, length: u64 in Trapping, end: u64 in Trapping) -> SourceRange
    requires end <= 16384
    {
        sources.path_byte_count = end as -Trapping;
        SourceRange { start: start, length: length }
    }

    machine invalid() -> SourceRange {
        crash Trap;
    }
}

// The byte at `index` of unit `source`, or NUL past the unit's end; as for
// `source_unit_byte_or_nul`, the fallback makes a violated coordinate fail a
// comparison rather than read another unit.
public machine source_set_byte_or_nul(sources: @SourceSet, source: SourceId, index: u64 in Trapping) -> u8
crashes Trap
{
    let unit: u64 in Trapping = (source.value as -Trapping) as u64 +Trapping;
    transition unit < sources.unit_count {
        true -> unit_range(sources, unit, index),
        _ -> absent()
    }

    machine unit_range(sources: @SourceSet, unit: u64 in Trapping, index: u64 in Trapping) -> u8 {
        transition unit < 512 {
            true -> within(sources, sources.units[unit as -Trapping], index),
            _ -> absent()
        }
    }

    machine within(sources: @SourceSet, range: SourceRange, index: u64 in Trapping) -> u8 {
        transition index < range.length {
            true -> located(sources, range.start + index),
            _ -> absent()
        }
    }

    machine located(sources: @SourceSet, at: u64 in Trapping) -> u8 {
        transition at < 8388608 {
            true -> read(sources, at),
            _ -> absent()
        }
    }

    machine read(sources: @SourceSet, at: u64 in Trapping) -> u8
    requires at < 8388608
    {
        sources.bytes[at as -Trapping]
    }

    machine absent() -> u8 {
        0
    }
}

// Empty spans at the end of a unit are valid. Invalid spans have no
// spelling, even when their unreadable bytes would all fall back to NUL.
machine source_span_within_unit(sources: @SourceSet, span: SourceSpan) -> bool
crashes Trap
{
    let unit: u64 in Trapping = (span.source.value as -Trapping) as u64 +Trapping;
    transition unit < sources.unit_count && unit < 512 && span.span.start <= span.span.end {
        true -> within(sources, sources.units[unit as -Trapping], span.span.end),
        _ -> invalid()
    }

    machine within(sources: @SourceSet, range: SourceRange, end: u64 in Trapping) -> bool {
        let used: u64 in Trapping = sources.byte_count as +Trapping;
        transition range.start <= used {
            true -> fits(range, end, used),
            _ -> invalid()
        }
    }

    machine fits(range: SourceRange, end: u64 in Trapping, used: u64 in Trapping) -> bool
    requires range.start <= used
    {
        end <= range.length && range.length <= used - range.start
    }

    machine invalid() -> bool { false }
}

// Whether two spans, of any units, spell the same bytes. Identifier
// spellings are their source bytes under LEXICAL-PROFILE-V1 (no escapes), so
// name comparison reads the units rather than a decoded copy.
public machine spans_equal(sources: @SourceSet, left: SourceSpan, right: SourceSpan) -> bool
crashes Trap
{
    transition source_span_within_unit(sources, left) && source_span_within_unit(sources, right) {
        true -> lengths(sources, left, right),
        _ -> different()
    }

    machine lengths(sources: @SourceSet, left: SourceSpan, right: SourceSpan) -> bool {
        transition left.span.end - left.span.start == right.span.end - right.span.start {
            true -> scan(sources, left, right, 0 as +Trapping),
            _ -> different()
        }
    }

    machine scan(sources: @SourceSet, left: SourceSpan, right: SourceSpan, offset: u64 in Trapping) -> bool {
        transition offset < left.span.end - left.span.start {
            true -> compare(sources, left, right, offset),
            _ -> same()
        }
    }

    machine compare(sources: @SourceSet, left: SourceSpan, right: SourceSpan, offset: u64 in Trapping) -> bool {
        let left_byte: u8 = source_set_byte_or_nul(sources, left.source, left.span.start + offset);
        let right_byte: u8 = source_set_byte_or_nul(sources, right.source, right.span.start + offset);
        transition left_byte == right_byte {
            true -> scan(sources, left, right, offset + 1),
            _ -> different()
        }
    }

    machine same() -> bool {
        true
    }

    machine different() -> bool {
        false
    }
}

// Whether a span spells exactly `spelling`.
public machine span_spells(sources: @SourceSet, span: SourceSpan, spelling: @[u8]) -> bool
crashes Trap
{
    transition source_span_within_unit(sources, span) {
        true -> length(sources, span, spelling),
        _ -> different()
    }

    machine length(sources: @SourceSet, span: SourceSpan, spelling: @[u8]) -> bool {
        transition span.span.end - span.span.start == spelling.length {
            true -> scan(sources, span, spelling, 0 as +Trapping),
            _ -> different()
        }
    }

    machine scan(sources: @SourceSet, span: SourceSpan, spelling: @[u8], index: u64 in Trapping) -> bool {
        transition index < spelling.length {
            true -> compare(sources, span, spelling, index),
            _ -> same()
        }
    }

    machine compare(sources: @SourceSet, span: SourceSpan, spelling: @[u8], index: u64 in Trapping) -> bool
    requires index < spelling.length
    {
        let source_byte: u8 = source_set_byte_or_nul(sources, span.source, span.span.start + index);
        let spelling_byte: u8 = spelling[index as -Trapping];
        transition source_byte == spelling_byte {
            true -> scan(sources, span, spelling, index + 1),
            _ -> different()
        }
    }

    machine same() -> bool {
        true
    }

    machine different() -> bool {
        false
    }
}

// The byte at `index` of unit `unit`'s filename, or NUL past its end.
public machine path_byte_or_nul(sources: @SourceSet, unit: u64 in Trapping, index: u64 in Trapping) -> u8
crashes Trap
{
    transition unit < sources.unit_count {
        true -> unit_range(sources, unit, index),
        _ -> absent()
    }

    machine unit_range(sources: @SourceSet, unit: u64 in Trapping, index: u64 in Trapping) -> u8 {
        transition unit < 512 {
            true -> within(sources, sources.paths[unit as -Trapping], index),
            _ -> absent()
        }
    }

    machine within(sources: @SourceSet, range: SourceRange, index: u64 in Trapping) -> u8 {
        transition index < range.length {
            true -> located(sources, range.start + index),
            _ -> absent()
        }
    }

    machine located(sources: @SourceSet, at: u64 in Trapping) -> u8 {
        transition at < 16384 {
            true -> read(sources, at),
            _ -> absent()
        }
    }

    machine read(sources: @SourceSet, at: u64 in Trapping) -> u8
    requires at < 16384
    {
        sources.path_bytes[at as -Trapping]
    }

    machine absent() -> u8 {
        0
    }
}

// The length of unit `unit`'s filename; zero for no unit.
public machine path_length(sources: @SourceSet, unit: u64 in Trapping) -> u64 in Trapping {
    transition unit < sources.unit_count && unit < 512 {
        true -> read(sources, unit),
        _ -> none()
    }

    machine read(sources: @SourceSet, unit: u64 in Trapping) -> u64 in Trapping
    requires unit < 512
    {
        sources.paths[unit as -Trapping].length
    }

    machine none() -> u64 in Trapping {
        0 as +Trapping
    }
}

// The package unit `unit` belongs to; zero for no unit.
public machine unit_package(sources: @SourceSet, unit: u64 in Trapping) -> u64 in Trapping {
    transition unit < sources.unit_count && unit < 512 {
        true -> read(sources, unit),
        _ -> none()
    }

    machine read(sources: @SourceSet, unit: u64 in Trapping) -> u64 in Trapping
    requires unit < 512
    {
        sources.unit_packages[unit as -Trapping] as +Trapping
    }

    machine none() -> u64 in Trapping {
        0 as +Trapping
    }
}

public machine same_package(sources: @SourceSet, left: u64 in Trapping, right: u64 in Trapping) -> bool {
    let left_package: u64 in Trapping = unit_package(sources, left);
    let right_package: u64 in Trapping = unit_package(sources, right);
    left_package == right_package
}

// Package `package`'s row; an unnamed ordinary package for no package.
public machine package_row(sources: @SourceSet, package: u64 in Trapping) -> PackageRow {
    transition package < sources.package_count && package < 64 {
        true -> read(sources, package),
        _ -> none()
    }

    machine read(sources: @SourceSet, package: u64 in Trapping) -> PackageRow
    requires package < 64
    {
        sources.packages[package as -Trapping]
    }

    machine none() -> PackageRow {
        PackageRow { name: SourceRange { start: 0 as +Trapping, length: 0 as +Trapping }, toolchain: false }
    }
}

// Dependency edge `index`; for no edge, a build edge of no requester (64 is
// past every package index).
public machine dependency_row(sources: @SourceSet, index: u64 in Trapping) -> DependencyRow {
    transition index < sources.dependency_count && index < 256 {
        true -> read(sources, index),
        _ -> none()
    }

    machine read(sources: @SourceSet, index: u64 in Trapping) -> DependencyRow
    requires index < 256
    {
        sources.dependencies[index as -Trapping]
    }

    machine none() -> DependencyRow {
        DependencyRow {
            requester: 64 as +Trapping,
            scope: DependencyScope::Build,
            alias: SourceRange { start: 0 as +Trapping, length: 0 as +Trapping },
            target: 0 as +Trapping
        }
    }
}

// Whether a span spells exactly the path-arena bytes of `name`, a package
// name or dependency alias.
public machine span_names(sources: @SourceSet, span: SourceSpan, name: SourceRange) -> bool
crashes Trap
{
    transition span.span.end - span.span.start == name.length {
        true -> scan(sources, span, name, 0 as +Trapping),
        _ -> different()
    }

    machine scan(sources: @SourceSet, span: SourceSpan, name: SourceRange, index: u64 in Trapping) -> bool {
        transition index < name.length {
            true -> compare(sources, span, name, index),
            _ -> same()
        }
    }

    machine compare(sources: @SourceSet, span: SourceSpan, name: SourceRange, index: u64 in Trapping) -> bool {
        let source_byte: u8 = source_set_byte_or_nul(sources, span.source, span.span.start + index);
        let name_byte: u8 = name_byte_or_nul(sources, name.start + index);
        transition source_byte == name_byte {
            true -> scan(sources, span, name, index + 1),
            _ -> different()
        }
    }

    machine same() -> bool {
        true
    }

    machine different() -> bool {
        false
    }
}

// The path-arena byte at `at`, or NUL past the arena's end.
machine name_byte_or_nul(sources: @SourceSet, at: u64 in Trapping) -> u8 {
    transition at < sources.path_byte_count && at < 16384 {
        true -> read(sources, at),
        _ -> absent()
    }

    machine read(sources: @SourceSet, at: u64 in Trapping) -> u8
    requires at < 16384
    {
        sources.path_bytes[at as -Trapping]
    }

    machine absent() -> u8 {
        0
    }
}
