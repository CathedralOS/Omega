// Handles 1 through 65 project from the preceding row. Handle 66 selects a
// different field of row 64. In the index fixture, each row indexes the previous one.
public data SyntaxTrees { expression_count: u64; indexes: bool; }
public data ExpressionKind [copy] { case Name; case Index; case Field; case Cast; case Unary; case Integer; }
public data OperatorKind [copy] { case Borrow; case BorrowMutable; case BorrowWrite; case None; }
public data Expression [copy] { kind: ExpressionKind; left: u64 in Trapping; right: u64 in Trapping; operator: OperatorKind; }
public data NameResolution { local_id: u64 in Trapping; }
public data ValueBinding [copy] { case Local(statement: u64 in Trapping); case Parameter(parameter: u64 in Trapping); case PatternBinder(field: u64 in Trapping); case None; }
public data Selection [copy] { case Field(field: u64 in Trapping); case None; }
public data TypeKind [copy] { case Reference; case Other; }
public data ReferenceAccess [copy] { case WriteOnly; case Shared; }
public data TypeRow [copy] { kind: TypeKind; access: ReferenceAccess; }
public data Typing { types: TypeRow; }
public data ExactInteger [copy] { value: u64 in Trapping; }
public data PlaceRelation [copy] { case Apart; case Inside; case Encloses; }

machine syntax_trees_expression(syntax: @SyntaxTrees, node: u64 in Trapping) -> Expression crashes Trap {
    transition {
        node >= syntax.expression_count -> invalid(),
        node == 0 -> row(ExpressionKind::Name, 0 as +Trapping),
        syntax.indexes -> row(ExpressionKind::Index, node - 1),
        node == 66 -> row(ExpressionKind::Field, 64 as +Trapping),
        _ -> row(ExpressionKind::Field, node - 1)
    }
    machine row(kind: ExpressionKind, left: u64 in Trapping) -> Expression {
        Expression { kind: kind, left: left, right: 0 as +Trapping, operator: OperatorKind::None }
    }
    machine invalid() -> Expression { crash Trap; }
}
machine value_binding(resolution: @NameResolution, node: u64 in Trapping) -> ValueBinding { ValueBinding::Local { statement: resolution.local_id } }
machine typing_expression_type(typing: @Typing, node: u64 in Trapping) -> u64 in Trapping { node }
machine type_table_row(types: @TypeRow, node: u64 in Trapping) -> TypeRow {
    transition node == 0 {
        true -> root(types.kind, types.access), _ -> root(TypeKind::Other, ReferenceAccess::Shared)
    }
    machine root(kind: TypeKind, access: ReferenceAccess) -> TypeRow { TypeRow { kind: kind, access: access } }
}
machine typing_selection(typing: @Typing, node: u64 in Trapping) -> Selection { Selection::Field { field: node } }
machine typing_value(typing: @Typing, node: u64 in Trapping) -> ExactInteger { ExactInteger { value: node } }
machine exact_integer_at_most(left: ExactInteger, right: ExactInteger) -> bool { left.value <= right.value }

machine start() crashes Trap {
    let syntax: SyntaxTrees = SyntaxTrees { expression_count: 67, indexes: false };
    let indexes: SyntaxTrees = SyntaxTrees { expression_count: 67, indexes: true };
    let resolution: NameResolution = NameResolution { local_id: 2 as +Trapping };
    let typing: Typing = Typing { types: TypeRow { kind: TypeKind::Other, access: ReferenceAccess::Shared } };
    let borrowed: Typing = Typing { types: TypeRow { kind: TypeKind::Reference, access: ReferenceAccess::WriteOnly } };
    let root: u64 in Trapping = 0 as +Trapping;
    let short: u64 in Trapping = 64 as +Trapping;
    let deep: u64 in Trapping = 65 as +Trapping;
    let at_limit: PlaceRelation = path_relation(@syntax, @resolution, @typing, short, root, false);
    let past_limit: PlaceRelation = path_relation(@syntax, @resolution, @typing, deep, root, false);
    let identical: PlaceRelation = path_relation(@syntax, @resolution, @typing, deep, deep, false);
    let sibling: PlaceRelation = path_relation(@syntax, @resolution, @typing, deep, 66 as +Trapping, false);
    let encloses: PlaceRelation = path_relation(@syntax, @resolution, @typing, root, deep, false);
    let indices: u64 in Trapping = index_steps(@indexes, deep);
    let unindexed: u64 in Trapping = skip_indexes(@indexes, deep);
    let via_write_only: bool = through_write_only(@syntax, @borrowed, deep);
    let via_borrow: bool = borrowed_place(@syntax, @borrowed, deep);
    let plain: bool = through_write_only(@syntax, @typing, deep) || borrowed_place(@syntax, @typing, deep);
    transition via_write_only && via_borrow && !plain && sibling == PlaceRelation::Apart && encloses == PlaceRelation::Encloses && indices == 65 && unindexed == root
        && at_limit == PlaceRelation::Inside && past_limit == PlaceRelation::Inside && identical == PlaceRelation::Inside {
        true -> done(), _ -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
