use main.omg as operator_holds_test;

machine build(builder: @mutable Build) {
    Build::application(builder, "operator_holds_tests");
    Build::bind(builder, windows_x86_64::ProgramEntry, |operator_holds_test|::start);
    Build::bind(builder, windows_arm64::ProgramEntry, |operator_holds_test|::start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |operator_holds_test|::start);
    Build::bind(builder, macos_arm64::ProgramEntry, |operator_holds_test|::start);
    Build::bind(builder, linux_arm64::ProgramEntry, |operator_holds_test|::start);
}
