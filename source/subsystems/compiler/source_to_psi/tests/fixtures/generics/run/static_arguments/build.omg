use main.omg as program;

machine build(builder: @mutable Build) {
    Build::application(builder, "static_arguments_tests");
    Build::bind(builder, linux_x86_64::ProgramEntry, |program|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |program|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |program|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |program|::main);
}
