use pipeline/checked_trees_to_scalar_operations/layout.omg;
use pipeline/checked_trees_to_scalar_operations/lowerer.omg;
use pipeline/checked_trees_to_scalar_operations/statements.omg;

use representations/checks/checks.omg;
use representations/lowered_program/layouts.omg;
use representations/lowered_program/scalar.omg as program;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

machine scalar_entry_result(row: |typed_trees|::TypeRow) -> bool
{
    transition row.kind {
        |typed_trees|::TypeKind::Unit -> yes(),
        |typed_trees|::TypeKind::Builtin -> builtin(row),
        _ -> no()
    }
    machine builtin(row: |typed_trees|::TypeRow) -> bool {
        transition row.builtin {
            |symbol_resolved_trees|::BuiltinType::U8 -> policy(row),
            _ -> no()
        }
    }
    machine policy(row: |typed_trees|::TypeRow) -> bool {
        transition row.domain { |symbol_resolved_trees|::DomainBinding::Unqualified -> yes(), _ -> no() }
    }
    machine yes() -> bool { true }
    machine no() -> bool { false }
}

// A reach ceiling and a checked crash ceiling impose no parameters on an
// Alpha call. Every body still goes through ordinary operation selection.
machine scalar_machine_clauses(syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem) -> bool
crashes Trap
{
    transition { _ -> next(syntax, item.first_clause, item.first_clause + item.clause_count) }
    machine next(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping) -> bool {
        transition index < end {
            true -> check(syntax, index, end),
            _ -> yes()
        }
    }
    machine check(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping) -> bool {
        let clause: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, index);
        transition clause.kind {
            |syntax_trees|::ClauseKind::CrashesNone -> next(syntax, index + 1, end),
            |syntax_trees|::ClauseKind::Reaches -> next(syntax, index + 1, end),
            |syntax_trees|::ClauseKind::Crashes -> crash_cause(syntax, index, end, clause.cause),
            _ -> no()
        }
    }
    machine crash_cause(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping, cause: |syntax_trees|::CrashCause) -> bool {
        transition cause {
            |syntax_trees|::CrashCause::Trap -> next(syntax, index + 1, end),
            |syntax_trees|::CrashCause::Abort -> no()
        }
    }
    machine yes() -> bool { true }
    machine no() -> bool { false }
}

// The synthetic entry has no caller-provided arguments or premises. Other
// machines retain independent parameter storage and ordinary checked calls.
public machine scalar_lower(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, checks: @|checks|::Checks, entry: u64 in Trapping)
crashes Trap
{
    lowerer.output.operation_count = 0 as u64 +Trapping;
    lowerer.output.machine_count = 0 as u64 +Trapping;
    lowerer.output.argument_count = 0 as u64 +Trapping;
    lowerer.output.parameter_count = syntax.parameter_count;
    lowerer.output.entry = entry;
    lowerer.output.status = |program|::ScalarStatus::Unchecked;
    transition syntax.accepted && resolution.accepted && typing.accepted && checks.accepted {
        true -> select(lowerer, syntax, resolution, typing, entry),
        _ -> done()
    }
    machine select(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, entry: u64 in Trapping) {
        lowerer.output.status = |program|::ScalarStatus::Unsupported;
        transition entry < syntax.machine_count && syntax.machine_count <= 10240
            && syntax.erased_binding_count == 0 && syntax.parameter_count <= 32768 {
            true -> entry_root(lowerer, syntax, resolution, typing, entry),
            _ -> done()
        }
    }
    machine entry_root(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, entry: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, entry);
        transition item.parent == 0 && item.parameter_count == 0
            && !item.has_owner && item.container == |syntax_trees|::MachineContainer::Root {
            true -> entry_result(lowerer, syntax, resolution, typing, item),
            _ -> done()
        }
    }
    machine entry_result(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem) {
        let handle: u64 in Trapping = |statements|::scalar_result_type(typing, item);
        let supported: bool = scalar_entry_result(|typed_trees|::type_table_row(@typing.types, handle));
        transition supported {
            true -> begin(lowerer, syntax, resolution, typing),
            _ -> done()
        }
    }
    machine begin(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing) {
        lowerer.output.status = |program|::ScalarStatus::Complete;
        |layout|::scalar_layout_clear(lowerer, typing);
        transition { _ -> roots(lowerer, syntax, resolution, typing, 0 as u64 +Trapping) }
    }
    machine roots(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        transition index < syntax.root_count && lowerer.output.status == |program|::ScalarStatus::Complete {
            true -> root(lowerer, syntax, resolution, typing, index),
            _ -> machines(lowerer, syntax, resolution, typing, 0 as u64 +Trapping)
        }
    }
    machine root(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        let item: |syntax_trees|::RootItem = |syntax_trees|::root_item(syntax, index);
        transition item.kind {
            |syntax_trees|::RootItemKind::Use -> roots(lowerer, syntax, resolution, typing, index + 1),
            |syntax_trees|::RootItemKind::Machine -> roots(lowerer, syntax, resolution, typing, index + 1),
            |syntax_trees|::RootItemKind::Data -> data_root(lowerer, syntax, resolution, typing, index, item),
            |syntax_trees|::RootItemKind::Trait -> marker_root(lowerer, syntax, resolution, typing, index, item),
            _ -> unsupported(lowerer)
        }
    }
    machine marker_root(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, root: |syntax_trees|::RootItem) {
        let marker: |syntax_trees|::TraitItem = |syntax_trees|::trait_item(syntax, root.item_index);
        transition marker.is_boundary && !marker.is_refinement && marker.generic_parameter_count == 0
            && marker.machine_count == 0 && marker.parent_count == 0 && marker.contract_count == 0 {
            true -> roots(lowerer, syntax, resolution, typing, index + 1),
            _ -> unsupported(lowerer)
        }
    }
    machine data_root(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, root: |syntax_trees|::RootItem) {
        let item: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, root.item_index);
        transition item.generic_parameter_count == 0 && item.case_count == 0 && !item.is_boundary
            && item.multiplicity != |syntax_trees|::DataMultiplicity::Linear {
            true -> roots(lowerer, syntax, resolution, typing, index + 1),
            _ -> unsupported(lowerer)
        }
    }
    machine machines(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        transition lowerer.output.status {
            |program|::ScalarStatus::Complete -> next(lowerer, syntax, resolution, typing, index),
            _ -> done()
        }
    }
    machine next(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> body(lowerer, syntax, resolution, typing, index),
            _ -> acyclic(lowerer)
        }
    }
    machine body(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        transition item.has_body && item.generic_parameter_count == 0 && !item.is_boundary && !item.has_target
            && !item.has_owner && item.container == |syntax_trees|::MachineContainer::Root
            && item.contract_count == 0 && item.component_count == 0 && scalar_machine_clauses(syntax, item) {
            true -> result(lowerer, syntax, resolution, typing, index, item),
            _ -> unsupported(lowerer)
        }
    }
    machine result(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, item: |syntax_trees|::MachineItem) {
        let handle: u64 in Trapping = |statements|::scalar_result_type(typing, item);
        |layout|::scalar_require_layout(lowerer, syntax, typing, handle);
        transition lowerer.output.status {
            |program|::ScalarStatus::Complete -> result_layout(lowerer, syntax, resolution, typing, index, item, handle),
            _ -> done()
        }
    }
    machine result_layout(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, item: |syntax_trees|::MachineItem, handle: u64 in Trapping) {
        let layout: |layouts|::ScalarLayout = |layouts|::scalar_layout_at(@lowerer.output, handle);
        transition layout.kind == |layouts|::ScalarLayoutKind::Scalar || layout.kind == |layouts|::ScalarLayoutKind::Unit {
            true -> parameters(lowerer, syntax, resolution, typing, index, item),
            _ -> unsupported(lowerer)
        }
    }
    machine parameters(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, item: |syntax_trees|::MachineItem) {
        lowerer.storage_size = 0 as u64 +Trapping;
        lowerer.argument_capacity = 0 as u64 +Trapping;
        lowerer.current_machine = index;
        |statements|::scalar_parameters(lowerer, syntax, typing, item);
        transition lowerer.output.status {
            |program|::ScalarStatus::Complete -> statements(lowerer, syntax, resolution, typing, index, item),
            _ -> done()
        }
    }
    machine statements(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, item: |syntax_trees|::MachineItem) {
        let first: u64 in Trapping = lowerer.output.operation_count;
        |statements|::scalar_statements(lowerer, syntax, resolution, typing, item);
        transition lowerer.output.status {
            |program|::ScalarStatus::Complete -> store(lowerer, syntax, resolution, typing, index, item, first),
            _ -> done()
        }
    }
    machine store(lowerer: @mutable |lowerer|::ScalarLowerer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, item: |syntax_trees|::MachineItem, first: u64 in Trapping) {
        lowerer.output.machines[index as -Trapping] = |program|::ScalarMachine {
            first: first, count: lowerer.output.operation_count - first,
            storage_size: lowerer.storage_size,
            first_parameter: item.first_parameter, parameter_count: item.parameter_count,
            argument_capacity: lowerer.argument_capacity
        };
        lowerer.output.machine_count = index + 1;
        transition { _ -> machines(lowerer, syntax, resolution, typing, index + 1) }
    }
    machine acyclic(lowerer: @mutable |lowerer|::ScalarLowerer) { scalar_acyclic(lowerer); }
    machine unsupported(lowerer: @mutable |lowerer|::ScalarLowerer) { lowerer.output.status = |program|::ScalarStatus::Unsupported; }
    machine done() {}
}

// Runtime recursive cycles require proper tail transfer. Until that terminator
// is lowered, refuse every cycle instead of emitting frame-growing recursion.
// A linear DFS inspects each machine and call once; it is not a reachability
// matrix, and declaration order cannot change acceptance.
machine scalar_acyclic(lowerer: @mutable |lowerer|::ScalarLowerer)
crashes Trap
{
    lowerer.call_count = 0 as u64 +Trapping;
    transition { _ -> clear(lowerer, 0 as u64 +Trapping) }
    machine clear(lowerer: @mutable |lowerer|::ScalarLowerer, index: u64 in Trapping) {
        transition index < lowerer.output.machine_count && index < 10240 {
            true -> reset(lowerer, index),
            _ -> select_root(lowerer, 0 as u64 +Trapping)
        }
    }
    machine reset(lowerer: @mutable |lowerer|::ScalarLowerer, index: u64 in Trapping) {
        lowerer.colors[(index) as -Trapping] = 0;
        transition { _ -> clear(lowerer, index + 1) }
    }
    machine select_root(lowerer: @mutable |lowerer|::ScalarLowerer, index: u64 in Trapping) {
        transition index < lowerer.output.machine_count && index < 10240 {
            true -> color(lowerer, index),
            _ -> done()
        }
    }
    machine color(lowerer: @mutable |lowerer|::ScalarLowerer, index: u64 in Trapping) {
        transition lowerer.colors[(index) as -Trapping] == 0 {
            true -> push(lowerer, index, index),
            _ -> select_root(lowerer, index + 1)
        }
    }
    machine push(lowerer: @mutable |lowerer|::ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        transition lowerer.call_count < 10240 && callee < 10240 {
            true -> pushed(lowerer, root, callee),
            _ -> unsupported(lowerer)
        }
    }
    machine pushed(lowerer: @mutable |lowerer|::ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        lowerer.calls[(lowerer.call_count) as -Trapping] = callee;
        lowerer.call_count = lowerer.call_count + 1;
        lowerer.colors[(callee) as -Trapping] = 1;
        lowerer.cursors[(callee) as -Trapping] = 0 as u64 +Trapping;
        transition { _ -> walk(lowerer, root) }
    }
    machine walk(lowerer: @mutable |lowerer|::ScalarLowerer, root: u64 in Trapping) {
        transition lowerer.call_count > 0 && lowerer.call_count <= 10240 {
            true -> top(lowerer, root),
            _ -> select_root(lowerer, root + 1)
        }
    }
    machine top(lowerer: @mutable |lowerer|::ScalarLowerer, root: u64 in Trapping) {
        let handle: u64 in Trapping = lowerer.calls[(lowerer.call_count - 1) as -Trapping];
        transition handle < 10240 {
            true -> body(lowerer, root, handle),
            _ -> unsupported(lowerer)
        }
    }
    machine body(lowerer: @mutable |lowerer|::ScalarLowerer, root: u64 in Trapping, handle: u64 in Trapping) {
        let body: |program|::ScalarMachine = |program|::scalar_machine_at(@lowerer.output, handle);
        let offset: u64 in Trapping = lowerer.cursors[(handle) as -Trapping];
        transition offset < body.count {
            true -> operation(lowerer, root, handle, body.first + offset, offset),
            _ -> pop(lowerer, root, handle)
        }
    }
    machine operation(lowerer: @mutable |lowerer|::ScalarLowerer, root: u64 in Trapping, handle: u64 in Trapping, index: u64 in Trapping, offset: u64 in Trapping) {
        let operation: |program|::ScalarOperation = |program|::scalar_operation(@lowerer.output, index);
        lowerer.cursors[(handle) as -Trapping] = offset + 1;
        transition operation.kind {
            |program|::ScalarOperationKind::Call -> callee(lowerer, root, operation.left),
            _ -> walk(lowerer, root)
        }
    }
    machine callee(lowerer: @mutable |lowerer|::ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        transition callee < lowerer.output.machine_count && callee < 10240 {
            true -> visit(lowerer, root, callee),
            _ -> unsupported(lowerer)
        }
    }
    machine visit(lowerer: @mutable |lowerer|::ScalarLowerer, root: u64 in Trapping, callee: u64 in Trapping) {
        transition lowerer.colors[(callee) as -Trapping] {
            0 -> push(lowerer, root, callee),
            1 -> unsupported(lowerer),
            _ -> walk(lowerer, root)
        }
    }
    machine pop(lowerer: @mutable |lowerer|::ScalarLowerer, root: u64 in Trapping, handle: u64 in Trapping) {
        lowerer.colors[(handle) as -Trapping] = 2;
        lowerer.call_count = lowerer.call_count - 1;
        transition { _ -> walk(lowerer, root) }
    }
    machine unsupported(lowerer: @mutable |lowerer|::ScalarLowerer) { lowerer.output.status = |program|::ScalarStatus::Unsupported; }
    machine done() {}
}
