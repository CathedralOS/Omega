use pipeline/syntax_trees_to_symbol_resolved_trees/resolution_state.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/declarations.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/domains.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/generic_scopes.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/imports.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/names.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;

// Bind a type row in the role its syntax owner supplies, including builtin names and domain qualifiers.

// What a type's root position admits. A trait application stands as a
// trait's parent or a conformance's satisfied trait; a static argument may
// also name a conformance; every other position names a type. A row inside
// a type is always a type, or a conformance as an applied name's argument.
public data TypeRole [copy] {
    case Type;
    case Trait;
    case StaticArgument;
    // The type of a trait's static parameter may be a value type or a trait
    // describing an explicitly selected implementation.
    case StaticParameter;
}

// What a bound row names, for its position's admission.
data BoundKind [copy] {
    case Type;
    case Trait;
    case Conformance;
}

// Bind one type in its owner's scope. A type fills a contiguous run of
// rows that ends at its root, so every row of the run binds in order: a
// named row binds its name and an `in` domain, and a reference, array, slice
// or integer row binds by its form. Nested rows need no recursion. `role` is
// what the root's position admits.
public machine bind_type_reference(
    resolver: @mutable |resolution_state|::Resolver,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    scope: |symbol_resolved_trees|::TypeScope,
    root: u64 in Trapping,
    role: TypeRole
)
crashes Trap
{
    let root_row: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, root);
    transition { _ -> next(resolver, sources, syntax, scope, root, role, root_row.first_row) }

    machine next(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        root: u64 in Trapping,
        role: TypeRole,
        row: u64 in Trapping
    ) {
        transition row <= root && resolver.output.accepted {
            true -> bind(resolver, sources, syntax, scope, root, role, row),
            _ -> done()
        }
    }

    machine bind(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        root: u64 in Trapping,
        role: TypeRole,
        row: u64 in Trapping
    ) {
        bind_type_row(resolver, sources, syntax, scope, row, row == root, role);
        transition { _ -> next(resolver, sources, syntax, scope, root, role, row + 1) }
    }

    machine done() {}
}

// One row. A trait binds only at the root of a trait position, and a trait
// position admits nothing else; a conformance binds as a static argument's
// root or as an applied name's argument, never under a reference, array or
// slice, which bind only types.
machine bind_type_row(
    resolver: @mutable |resolution_state|::Resolver,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    scope: |symbol_resolved_trees|::TypeScope,
    row: u64 in Trapping,
    is_root: bool,
    role: TypeRole
)
crashes Trap
{
    let type_reference: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, row);
    let whole: |syntax_trees|::IdentifierSpan = |syntax_trees|::IdentifierSpan { source_span: type_reference.source_span };
    let lifetimes: bool = |generic_scopes|::lifetimes_declared(sources, syntax, scope, type_reference);
    transition lifetimes {
        true -> kinds(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole),
        _ -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UndeclaredLifetime, whole)
    }

    machine kinds(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: |syntax_trees|::TypeReference,
        whole: |syntax_trees|::IdentifierSpan
    ) {
        transition type_reference.kind {
            |syntax_trees|::TypeReferenceKind::Named -> arity(resolver, sources, syntax, scope, row, is_root, role, type_reference),
            |syntax_trees|::TypeReferenceKind::Reference -> holder(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, |symbol_resolved_trees|::TypeBinding::Reference),
            |syntax_trees|::TypeReferenceKind::Array -> holder(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, |symbol_resolved_trees|::TypeBinding::Array),
            |syntax_trees|::TypeReferenceKind::Slice -> holder(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, |symbol_resolved_trees|::TypeBinding::Slice),
            |syntax_trees|::TypeReferenceKind::Literal -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, |symbol_resolved_trees|::TypeBinding::Literal, BoundKind::Type)
        }
    }

    // An applied data name supplies as many lifetime arguments as the data
    // declares lifetime binders, or elides them all; other names take none.
    machine arity(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: |syntax_trees|::TypeReference
    ) {
        let binding: |symbol_resolved_trees|::TypeBinding = type_binding(sources, syntax, scope, type_reference.name.source_span);
        let declared: u64 in Trapping = |generic_scopes|::lifetime_arity(syntax, binding);
        transition declared == type_reference.lifetime_count || type_reference.lifetime_count == 0 {
            true -> named(resolver, sources, syntax, scope, row, is_root, role, type_reference),
            _ -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::LifetimeArgumentCount, type_reference.name)
        }
    }

    machine named(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: |syntax_trees|::TypeReference
    ) {
        let binding: |symbol_resolved_trees|::TypeBinding = type_binding(sources, syntax, scope,
            type_reference.name.source_span
        );
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Unresolved -> unnamed(resolver, sources, syntax, scope, row, is_root, role, type_reference),
            |symbol_resolved_trees|::TypeBinding::Ambiguous -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::AmbiguousName, type_reference.name),
            |symbol_resolved_trees|::TypeBinding::Trait { item } -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, type_reference.name, binding, BoundKind::Trait),
            |symbol_resolved_trees|::TypeBinding::Conformance { item } -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, type_reference.name, binding, BoundKind::Conformance),
            _ -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, type_reference.name, binding, BoundKind::Type)
        }
    }

    // A name no type spells: a static argument may name a machine, for a
    // callee's machine binder (wiki/spec/language/generics.md, Static
    // machine binder categories); anything else is unknown.
    machine unnamed(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: |syntax_trees|::TypeReference
    ) {
        transition is_root && role == TypeRole::StaticArgument && !type_reference.has_domain {
            true -> machine_argument(resolver, sources, syntax, scope, row, type_reference),
            _ -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UnknownDataType, type_reference.name)
        }
    }

    machine machine_argument(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, row: u64 in Trapping, type_reference: |syntax_trees|::TypeReference) {
        let binding: |symbol_resolved_trees|::ValueBinding = |names|::declaration_callee(@resolver.output, sources, syntax, scope.lexical_machine, type_reference.name.source_span);
        transition binding {
            |symbol_resolved_trees|::ValueBinding::Machine { handle } -> bounded(resolver, sources, syntax, scope, row, type_reference, |symbol_resolved_trees|::TypeBinding::Machine { handle: handle }),
            |symbol_resolved_trees|::ValueBinding::Ambiguous -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::AmbiguousName, type_reference.name),
            _ -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UnknownDataType, type_reference.name)
        }
    }

    // A reference, array or slice holds a type, never a conformance.
    machine holder(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: |syntax_trees|::TypeReference,
        whole: |syntax_trees|::IdentifierSpan,
        binding: |symbol_resolved_trees|::TypeBinding
    ) {
        let held: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(@resolver.output, type_reference.inner);
        let held_row: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, type_reference.inner);
        transition held {
            |symbol_resolved_trees|::TypeBinding::Conformance { item } -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::NotAType, held_row.name),
            _ -> placed(resolver, sources, syntax, scope, row, is_root, role, type_reference, whole, binding, BoundKind::Type)
        }
    }

    machine placed(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        row: u64 in Trapping,
        is_root: bool,
        role: TypeRole,
        type_reference: |syntax_trees|::TypeReference,
        spelled: |syntax_trees|::IdentifierSpan,
        binding: |symbol_resolved_trees|::TypeBinding,
        kind: BoundKind
    ) {
        let trait_root: bool = is_root && role == TypeRole::Trait;
        transition kind {
            BoundKind::Trait -> admitted(resolver, sources, syntax, scope, row, type_reference, spelled, binding,
                trait_name_admitted(role, is_root), |symbol_resolved_trees|::ResolveDiagnosticCode::NotAType),
            BoundKind::Conformance -> admitted(resolver, sources, syntax, scope, row, type_reference, spelled, binding,
                !is_root || role == TypeRole::StaticArgument, |symbol_resolved_trees|::ResolveDiagnosticCode::NotAType),
            BoundKind::Type -> admitted(resolver, sources, syntax, scope, row, type_reference, spelled, binding, !trait_root, |symbol_resolved_trees|::ResolveDiagnosticCode::NotATrait)
        }
    }

    machine admitted(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        row: u64 in Trapping,
        type_reference: |syntax_trees|::TypeReference,
        spelled: |syntax_trees|::IdentifierSpan,
        binding: |symbol_resolved_trees|::TypeBinding,
        admits: bool,
        code: |symbol_resolved_trees|::ResolveDiagnosticCode
    ) {
        transition admits {
            true -> bounded(resolver, sources, syntax, scope, row, type_reference, binding),
            _ -> reject(resolver, code, spelled)
        }
    }

    machine bounded(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        row: u64 in Trapping,
        type_reference: |syntax_trees|::TypeReference,
        binding: |symbol_resolved_trees|::TypeBinding
    ) {
        transition row < 65536 {
            true -> store(resolver, sources, syntax, scope, row, type_reference, binding),
            _ -> invalid()
        }
    }

    machine store(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        row: u64 in Trapping,
        type_reference: |syntax_trees|::TypeReference,
        binding: |symbol_resolved_trees|::TypeBinding
    ) {
        resolver.output.type_bindings[row as -Trapping] = binding;
        resolver.output.domain_bindings[row as -Trapping] = |symbol_resolved_trees|::DomainBinding::Unqualified;
        resolver.output.domain_items[row as -Trapping] = 0;
        transition type_reference.has_domain {
            true -> qualified(resolver, sources, syntax, scope, row, type_reference),
            _ -> done()
        }
    }

    machine qualified(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        row: u64 in Trapping,
        type_reference: |syntax_trees|::TypeReference
    ) {
        bind_domain(resolver, sources, syntax, scope, row, type_reference);
    }

    machine reject(resolver: @mutable |resolution_state|::Resolver, code: |symbol_resolved_trees|::ResolveDiagnosticCode, name: |syntax_trees|::IdentifierSpan) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, code, name.source_span);
    }

    machine invalid() {
        crash Trap;
    }

    machine done() {}
}

// The declaration a type name denotes in `scope`: an enclosing generic
// parameter by spelling (lifetimes are not type names), the declaration's
// own before its container's, then a builtin type, then the one data, trait
// or conformance declaration the name's unit can see.
public machine type_binding(
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    scope: |symbol_resolved_trees|::TypeScope,
    name: |source|::SourceSpan
) -> |symbol_resolved_trees|::TypeBinding
crashes Trap
{
    let own: |declarations|::Lookup = |generic_scopes|::generic_named(sources, syntax, scope.first_generic_parameter, scope.generic_parameter_count, name);
    transition own {
        |declarations|::Lookup::Found { handle } -> found(|symbol_resolved_trees|::TypeBinding::GenericParameter { parameter: handle }),
        _ -> outer(sources, syntax, scope, name)
    }

    machine outer(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let container: |declarations|::Lookup = |generic_scopes|::scoped_generic_named(sources, syntax, scope, name);
        transition container {
            |declarations|::Lookup::Found { handle } -> found(|symbol_resolved_trees|::TypeBinding::GenericParameter { parameter: handle }),
            _ -> builtin(sources, syntax, name)
        }
    }

    machine builtin(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let binding: |symbol_resolved_trees|::TypeBinding = builtin_type(sources, name);
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Unresolved -> declared(sources, syntax, name),
            _ -> found(binding)
        }
    }

    // A visible data declaration, trait or conformance of the spelling; two
    // of them, of any kinds, make the name ambiguous.
    machine declared(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let data: |declarations|::Lookup = |imports|::data_named(sources, syntax, name);
        transition data {
            |declarations|::Lookup::Found { handle } -> data_found(sources, syntax, name, handle),
            |declarations|::Lookup::Ambiguous -> found(|symbol_resolved_trees|::TypeBinding::Ambiguous),
            |declarations|::Lookup::Absent -> traits(sources, syntax, name)
        }
    }

    machine data_found(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan, item: u64 in Trapping) -> |symbol_resolved_trees|::TypeBinding {
        let rivals: bool = trait_or_conformance_named(sources, syntax, name);
        transition rivals {
            true -> found(|symbol_resolved_trees|::TypeBinding::Ambiguous),
            _ -> found(|symbol_resolved_trees|::TypeBinding::Data { item: item })
        }
    }

    machine traits(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let traits: |declarations|::Lookup = |imports|::declared_named(sources, syntax, |declarations|::DeclarationKind::Trait, false, name, name);
        transition traits {
            |declarations|::Lookup::Found { handle } -> trait_found(sources, syntax, name, handle),
            |declarations|::Lookup::Ambiguous -> found(|symbol_resolved_trees|::TypeBinding::Ambiguous),
            |declarations|::Lookup::Absent -> conformances(sources, syntax, name)
        }
    }

    machine trait_found(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan, item: u64 in Trapping) -> |symbol_resolved_trees|::TypeBinding {
        let conformances: |declarations|::Lookup = |imports|::declared_named(sources, syntax, |declarations|::DeclarationKind::Conformance, false, name, name);
        transition conformances {
            |declarations|::Lookup::Absent -> found(|symbol_resolved_trees|::TypeBinding::Trait { item: item }),
            _ -> found(|symbol_resolved_trees|::TypeBinding::Ambiguous)
        }
    }

    machine conformances(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let conformances: |declarations|::Lookup = |imports|::declared_named(sources, syntax, |declarations|::DeclarationKind::Conformance, false, name, name);
        transition conformances {
            |declarations|::Lookup::Found { handle } -> found(|symbol_resolved_trees|::TypeBinding::Conformance { item: handle }),
            |declarations|::Lookup::Ambiguous -> found(|symbol_resolved_trees|::TypeBinding::Ambiguous),
            |declarations|::Lookup::Absent -> found(|symbol_resolved_trees|::TypeBinding::Unresolved)
        }
    }

    machine found(binding: |symbol_resolved_trees|::TypeBinding) -> |symbol_resolved_trees|::TypeBinding {
        binding
    }
}

// Whether a trait or a conformance of the spelling is visible.
machine trait_or_conformance_named(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan) -> bool
crashes Trap
{
    let traits: |declarations|::Lookup = |imports|::declared_named(sources, syntax, |declarations|::DeclarationKind::Trait, false, name, name);
    transition traits {
        |declarations|::Lookup::Absent -> conformances(sources, syntax, name),
        _ -> yes()
    }

    machine conformances(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan) -> bool {
        let conformances: |declarations|::Lookup = |imports|::declared_named(sources, syntax, |declarations|::DeclarationKind::Conformance, false, name, name);
        transition conformances {
            |declarations|::Lookup::Absent -> no(),
            _ -> yes()
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// The domain an `in` qualifier names. A bare name is a compiler-known
// domain by spelling, else the one declared domain of that name whose
// carrier admits the qualified type (domains.omg). A path `Owner::Name`
// names what a membership's path names (names.omg): a case of data `Owner`,
// whose implied domain qualifies only that data, or the declared domain
// over the type `Owner` names in `scope`, whose carrier must admit the
// qualified type (wiki/spec/language/modules.md#foreign-attached-declaration-paths).
// A longer path crosses a package, which this source set cannot bind.
// Generic parameters do not bind domains.
machine bind_domain(
    resolver: @mutable |resolution_state|::Resolver,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    scope: |symbol_resolved_trees|::TypeScope,
    reference: u64 in Trapping,
    type_reference: |syntax_trees|::TypeReference
)
// The caller binds only references it has bounded by the syntax table.
requires reference < 65536
crashes Trap
{
    let whole: |source|::SourceSpan = |syntax_trees|::qualifier_span(type_reference);
    transition type_reference.has_domain_owner {
        true -> owned(resolver, sources, syntax, scope, reference, type_reference, whole),
        _ -> bare(resolver, sources, syntax, reference, type_reference.domain)
    }

    machine bare(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, reference: u64 in Trapping, domain: |syntax_trees|::IdentifierSpan) {
        let known: |symbol_resolved_trees|::DomainBinding = |domains|::known_domain(sources, domain.source_span);
        transition known {
            |symbol_resolved_trees|::DomainBinding::Unqualified -> declared(resolver, sources, syntax, reference, domain),
            _ -> bind(resolver, reference, known, 0 as +Trapping)
        }
    }

    machine declared(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, reference: u64 in Trapping, domain: |syntax_trees|::IdentifierSpan) {
        let lookup: |declarations|::Lookup = |domains|::resolver_declared_domain(resolver, sources, syntax, reference, domain.source_span);
        transition lookup {
            |declarations|::Lookup::Found { handle } -> bind(resolver, reference, |symbol_resolved_trees|::DomainBinding::Declared, handle),
            |declarations|::Lookup::Ambiguous -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::AmbiguousName, domain.source_span),
            |declarations|::Lookup::Absent -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UnknownDomain, domain.source_span)
        }
    }

    machine owned(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        reference: u64 in Trapping,
        type_reference: |syntax_trees|::TypeReference,
        whole: |source|::SourceSpan
    ) {
        let named: |names|::DomainPath = |names|::resolver_domain_path(resolver, sources, syntax, scope,
            type_reference.domain_owner.source_span, type_reference.domain.source_span
        );
        transition named {
            |names|::DomainPath::Case { item, data_case } -> case_domain(resolver, reference, whole, item, data_case),
            |names|::DomainPath::Declared { item } -> declared_carrier(resolver, sources, syntax, reference, type_reference, whole, item),
            |names|::DomainPath::Ambiguous -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::AmbiguousName, whole),
            |names|::DomainPath::Absent -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    machine case_domain(resolver: @mutable |resolution_state|::Resolver, reference: u64 in Trapping, whole: |source|::SourceSpan, owner: u64 in Trapping, data_case: u64 in Trapping) {
        let qualified: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(@resolver.output, reference);
        transition qualified {
            |symbol_resolved_trees|::TypeBinding::Data { item } -> case_carrier(resolver, reference, whole, item == owner, data_case),
            _ -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    machine case_carrier(resolver: @mutable |resolution_state|::Resolver, reference: u64 in Trapping, whole: |source|::SourceSpan, own: bool, data_case: u64 in Trapping) {
        transition own {
            true -> bind(resolver, reference, |symbol_resolved_trees|::DomainBinding::Case, data_case),
            _ -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    machine declared_carrier(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        reference: u64 in Trapping,
        type_reference: |syntax_trees|::TypeReference,
        whole: |source|::SourceSpan,
        domain: u64 in Trapping
    ) {
        let admitted: bool = |domains|::domain_admits(resolver, sources, syntax, domain, reference, type_reference.domain.source_span);
        transition admitted {
            true -> bind(resolver, reference, |symbol_resolved_trees|::DomainBinding::Declared, domain),
            _ -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UnknownDomain, whole)
        }
    }

    machine bind(resolver: @mutable |resolution_state|::Resolver, reference: u64 in Trapping, binding: |symbol_resolved_trees|::DomainBinding, item: u64 in Trapping) {
        resolver.output.domain_bindings[reference as -Trapping] = binding;
        resolver.output.domain_items[reference as -Trapping] = item as u64;
    }

    machine reject(resolver: @mutable |resolution_state|::Resolver, code: |symbol_resolved_trees|::ResolveDiagnosticCode, source_span: |source|::SourceSpan) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, code, source_span);
    }
}

// Whether a name is spelled like a builtin type
// (wiki/spec/language/modules.md#builtin-type-names): an installed builtin,
// or the open-ended integer family `i`, `u`, and either letter followed by
// decimal digits, whether or not the digits form a valid width. `u7` and
// `u128` install no type, yet no declaration may introduce a type with
// those spellings, so this test is wider than `builtin_type`.
public machine builtin_type_spelling(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> bool
crashes Trap
{
    let installed: |symbol_resolved_trees|::TypeBinding = builtin_type(sources, name);
    transition installed {
        |symbol_resolved_trees|::TypeBinding::Unresolved -> family(sources, name),
        _ -> yes()
    }

    machine family(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> bool {
        let first: u8 = |source|::source_set_byte_or_nul(sources, name.source, name.span.start);
        transition name.span.end > name.span.start && (first == 105 || first == 117) {
            true -> digits(sources, name, name.span.start + 1),
            _ -> no()
        }
    }

    machine digits(sources: @|source|::SourceSet, name: |source|::SourceSpan, index: u64 in Trapping) -> bool {
        transition index < name.span.end {
            true -> digit(sources, name, index),
            _ -> yes()
        }
    }

    machine digit(sources: @|source|::SourceSet, name: |source|::SourceSpan, index: u64 in Trapping) -> bool {
        let byte: u8 = |source|::source_set_byte_or_nul(sources, name.source, index);
        transition byte >= 48 && byte <= 57 {
            true -> digits(sources, name, index + 1),
            _ -> no()
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// The compiler-installed type a name spells, or `Unresolved`. Builtin names
// are not source declarations, so they match by spelling, not by span.
public machine builtin_type(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding
crashes Trap
{
    let matched: bool = |source|::span_spells(sources, name, "bool");
    transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::Bool), _ -> spells_i8(sources, name) }

    machine spells_i8(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "i8");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::I8), _ -> spells_i16(sources, name) }
    }

    machine spells_i16(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "i16");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::I16), _ -> spells_i32(sources, name) }
    }

    machine spells_i32(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "i32");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::I32), _ -> spells_i64(sources, name) }
    }

    machine spells_i64(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "i64");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::I64), _ -> spells_u8(sources, name) }
    }

    machine spells_u8(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "u8");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::U8), _ -> spells_u16(sources, name) }
    }

    machine spells_u16(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "u16");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::U16), _ -> spells_u32(sources, name) }
    }

    machine spells_u32(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "u32");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::U32), _ -> spells_u64(sources, name) }
    }

    machine spells_u64(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "u64");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::U64), _ -> spells_address(sources, name) }
    }

    machine spells_address(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "address");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::Address), _ -> spells_f32(sources, name) }
    }

    machine spells_f32(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "f32");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::F32), _ -> spells_f64(sources, name) }
    }

    machine spells_f64(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "f64");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::F64), _ -> spells_slice(sources, name) }
    }

    machine spells_slice(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "Slice");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::Slice), _ -> spells_syscallresult(sources, name) }
    }

    machine spells_syscallresult(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "SyscallResult");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::SyscallResult), _ -> spells_terminal(sources, name) }
    }

    machine spells_terminal(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "Terminal");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::Terminal), _ -> spells_never(sources, name) }
    }

    machine spells_never(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "Never");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::Never), _ -> spells_uint(sources, name) }
    }

    machine spells_uint(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "UInt");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::UInt), _ -> spells_int(sources, name) }
    }

    machine spells_int(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "Int");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::Int), _ -> spells_atomicbool(sources, name) }
    }

    machine spells_atomicbool(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "AtomicBool");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::AtomicBool), _ -> spells_atomicu32(sources, name) }
    }

    machine spells_atomicu32(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "AtomicU32");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::AtomicU32), _ -> spells_atomicu64(sources, name) }
    }

    machine spells_atomicu64(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::TypeBinding {
        let matched: bool = |source|::span_spells(sources, name, "AtomicU64");
        transition matched { true -> found(|symbol_resolved_trees|::BuiltinType::AtomicU64), _ -> absent() }
    }

    machine found(builtin: |symbol_resolved_trees|::BuiltinType) -> |symbol_resolved_trees|::TypeBinding {
        |symbol_resolved_trees|::TypeBinding::Builtin { builtin: builtin }
    }

    machine absent() -> |symbol_resolved_trees|::TypeBinding {
        |symbol_resolved_trees|::TypeBinding::Unresolved
    }
}

// A trait is a contract at a parent or satisfaction edge and at the root of
// a typed static parameter. A field or the element of a reference needs a type.
machine trait_name_admitted(role: TypeRole, is_root: bool) -> bool {
    is_root && (role == TypeRole::Trait || role == TypeRole::StaticParameter)
}
