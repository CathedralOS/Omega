use pipeline/syntax_trees_to_symbol_resolved_trees/resolution_state.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/containers.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/imports.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/machine_signatures.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/type_names.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;

// Operator homes (wiki/spec/language/expressions.md#operator-families). A
// qualified token-bound machine `machine <= Home::compare(...)`
// establishes its semantic home through its owner: the data declaration
// `Home`. Direct families are closed, so only the home's own package may
// publish its token bindings: an owner naming a builtin carrier, a trait or
// another package's data rejects at the owner. Two machines binding one
// token at one home with the same parameters are duplicate participating
// shapes and reject at the later one. Typing selects among a home's machines
// by their operands (pipeline/symbol_resolved_trees_to_typed_trees/operators.omg).
public machine bind_operator_homes(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0 as +Trapping) }

    machine next(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count && resolver.output.accepted {
            true -> machine(resolver, sources, syntax, index),
            _ -> done()
        }
    }

    machine machine(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        set_operator_home(resolver, index, |symbol_resolved_trees|::TypeBinding::Unresolved);
        transition item.operator == |syntax_trees|::OperatorToken::None {
            true -> next(resolver, sources, syntax, index + 1),
            _ -> owner(resolver, sources, syntax, index, item)
        }
    }

    machine owner(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, entry: |syntax_trees|::MachineItem) {
        let scope: |symbol_resolved_trees|::TypeScope = |containers|::resolver_machine_scope(@resolver.output, syntax, index);
        let binding: |symbol_resolved_trees|::TypeBinding = |type_names|::type_binding(sources, syntax, scope, entry.owner.source_span);
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Data { item } -> data_home(resolver, sources, syntax, index, entry, item),
            _ -> foreign(resolver, entry)
        }
    }

    machine data_home(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, entry: |syntax_trees|::MachineItem, data: u64 in Trapping) {
        let declared: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, data);
        let machine_unit: u64 in Trapping = entry.name.source_span.source.value as -Trapping as u64 +Trapping;
        let data_unit: u64 in Trapping = declared.name.source_span.source.value as -Trapping as u64 +Trapping;
        let own: bool = |imports|::resolver_same_package(sources, machine_unit, data_unit);
        transition own {
            true -> homed(resolver, sources, syntax, index, entry, data),
            _ -> foreign(resolver, entry)
        }
    }

    machine homed(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, entry: |syntax_trees|::MachineItem, data: u64 in Trapping) {
        set_operator_home(resolver, index, |symbol_resolved_trees|::TypeBinding::Data { item: data });
        let duplicate: bool = earlier_operator_shape(resolver, sources, syntax, index, entry.operator, data);
        transition duplicate {
            true -> repeated(resolver, entry),
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine foreign(resolver: @mutable |resolution_state|::Resolver, entry: |syntax_trees|::MachineItem) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, |symbol_resolved_trees|::ResolveDiagnosticCode::ForeignOperatorHome, entry.owner.source_span);
    }

    machine repeated(resolver: @mutable |resolution_state|::Resolver, entry: |syntax_trees|::MachineItem) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, |symbol_resolved_trees|::ResolveDiagnosticCode::DuplicateMachine, entry.name.source_span);
    }

    machine done() {}
}

// Whether a machine before `handle` binds `token` at home `data` with the
// same parameters.
machine earlier_operator_shape(
    resolver: @|resolution_state|::Resolver,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    handle: u64 in Trapping,
    token: |syntax_trees|::OperatorToken,
    data: u64 in Trapping
) -> bool
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, handle, token, data, 0 as +Trapping) }

    machine next(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping, token: |syntax_trees|::OperatorToken, data: u64 in Trapping, earlier: u64 in Trapping) -> bool {
        transition earlier < handle {
            true -> candidate(resolver, sources, syntax, handle, token, data, earlier),
            _ -> unique()
        }
    }

    machine candidate(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping, token: |syntax_trees|::OperatorToken, data: u64 in Trapping, earlier: u64 in Trapping) -> bool {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, earlier);
        let home: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::operator_home(@resolver.output, earlier);
        let same_home: bool = homed_at(home, data);
        transition item.operator == token && same_home {
            true -> shape(resolver, sources, syntax, handle, token, data, earlier),
            _ -> next(resolver, sources, syntax, handle, token, data, earlier + 1)
        }
    }

    machine shape(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping, token: |syntax_trees|::OperatorToken, data: u64 in Trapping, earlier: u64 in Trapping) -> bool {
        let same: bool = |machine_signatures|::same_parameters(resolver, syntax, earlier, handle);
        transition same {
            true -> repeated(),
            _ -> next(resolver, sources, syntax, handle, token, data, earlier + 1)
        }
    }

    machine repeated() -> bool {
        true
    }

    machine unique() -> bool {
        false
    }
}

// Whether an operator home is data declaration `data`.
public machine homed_at(home: |symbol_resolved_trees|::TypeBinding, data: u64 in Trapping) -> bool
{
    |symbol_resolved_trees|::operator_home_is_data(home, data)
}

machine set_operator_home(resolver: @mutable |resolution_state|::Resolver, handle: u64 in Trapping, home: |symbol_resolved_trees|::TypeBinding)
crashes Trap
{
    transition handle < 10240 {
        true -> store(resolver, handle, home),
        _ -> invalid()
    }

    machine store(resolver: @mutable |resolution_state|::Resolver, handle: u64 in Trapping, home: |symbol_resolved_trees|::TypeBinding)
    requires handle < 10240
    {
        resolver.output.operator_homes[handle as -Trapping] = home;
    }

    machine invalid() {
        crash Trap;
    }
}
