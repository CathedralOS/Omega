use representations/symbol_resolved_trees/machine_declarations.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/resolution_state.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/declarations.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/imports.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;

// A machine name binds at one lexical tier in one module. Every declaration
// in that family shares the same import route. Across packages only its public
// members are visible; each use records which chain typing may walk.
public machine bind_visible_overloads(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> clear(resolver, sources, syntax, 0u64 as +Trapping) }
    machine clear(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition (index as -Trapping) < syntax.machine_count && index < 10240 {
            true -> clear_one(resolver, sources, syntax, index),
            false -> next(resolver, sources, syntax, 0u64 as +Trapping)
        }
    }
    machine clear_one(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping)
    requires index < 10240
    {
        resolver.overload_heads[index as -Trapping] = |symbol_resolved_trees|::OverloadLinks { all: 0u64 as +Trapping, exported: 0u64 as +Trapping };
        transition { _ -> clear(resolver, sources, syntax, index + 1) }
    }

    machine next(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition (index as -Trapping) < syntax.expression_count && index < 131072 {
            true -> inspect(resolver, sources, syntax, index),
            false -> done()
        }
    }
    machine inspect(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping)
    requires index < 131072
    {
        let binding: |symbol_resolved_trees|::ValueBinding = resolver.output.value_bindings[index as -Trapping];
        transition binding {
            |symbol_resolved_trees|::ValueBinding::Machine { handle } -> bind(resolver, sources, syntax, index, handle),
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }
    machine bind(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, handle: u64 in Trapping)
    requires index < 131072
    {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, index);
        let candidates: |symbol_resolved_trees|::VisibleOverloads = visible_overloads(resolver, sources, syntax, handle, expression.source_span.source);
        resolver.output.value_bindings[index as -Trapping] = |symbol_resolved_trees|::ValueBinding::Overloads { representative: handle, candidates: candidates };
        transition { _ -> next(resolver, sources, syntax, index + 1) }
    }
    machine done() {}
}

machine visible_overloads(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, representative: u64 in Trapping, from: |source|::SourceId) -> |symbol_resolved_trees|::VisibleOverloads
crashes Trap
{
    let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, representative);
    let declared: |source|::SourceId = item.name.source_span.source;
    let local: bool = |imports|::resolver_same_package(sources, overload_unit_index(from), overload_unit_index(declared));
    transition representative < 10240 {
        true -> family(resolver, sources, syntax, representative, item, local),
        _ -> |symbol_resolved_trees|::VisibleOverloads { first: 0u64 as +Trapping, public_only: false }
    }

    machine family(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, representative: u64 in Trapping, item: |syntax_trees|::MachineItem, local: bool) -> |symbol_resolved_trees|::VisibleOverloads
    requires representative < 10240
    {
        let heads: |symbol_resolved_trees|::OverloadLinks = resolver.overload_heads[representative as -Trapping];
        transition heads.all > 0 {
            true -> selected(heads, local),
            _ -> build(resolver, sources, syntax, representative, item, local)
        }
    }

    machine build(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, representative: u64 in Trapping, item: |syntax_trees|::MachineItem, local: bool) -> |symbol_resolved_trees|::VisibleOverloads {
        let path: |symbol_resolved_trees|::MachineOwner = |symbol_resolved_trees|::machine_owner(@resolver.output, representative);
        let empty: |symbol_resolved_trees|::OverloadLinks = |symbol_resolved_trees|::OverloadLinks { all: 0u64 as +Trapping, exported: 0u64 as +Trapping };
        let heads: |symbol_resolved_trees|::OverloadLinks = link_overloads(resolver, sources, syntax, item, path, syntax.machine_count as +Trapping, empty);
        transition representative < 10240 {
            true -> cache(resolver, representative, heads, local),
            _ -> invalid()
        }
    }
    machine cache(resolver: @mutable |resolution_state|::Resolver, representative: u64 in Trapping, heads: |symbol_resolved_trees|::OverloadLinks, local: bool) -> |symbol_resolved_trees|::VisibleOverloads
    requires representative < 10240
    {
        resolver.overload_heads[representative as -Trapping] = heads;
        transition { _ -> selected(heads, local) }
    }
    machine selected(heads: |symbol_resolved_trees|::OverloadLinks, local: bool) -> |symbol_resolved_trees|::VisibleOverloads {
        transition local {
            true -> |symbol_resolved_trees|::VisibleOverloads { first: heads.all, public_only: false },
            false -> |symbol_resolved_trees|::VisibleOverloads { first: heads.exported, public_only: true }
        }
    }
    machine invalid() -> |symbol_resolved_trees|::VisibleOverloads { crash Trap; }
}

// Prepending in reverse declaration order gives both views stable forward
// iteration. Links are stored once per declaration, regardless of call count.
machine link_overloads(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, named: |syntax_trees|::MachineItem, path: |symbol_resolved_trees|::MachineOwner, end: u64 in Trapping, heads: |symbol_resolved_trees|::OverloadLinks) -> |symbol_resolved_trees|::OverloadLinks
crashes Trap
{
    transition end > 0 {
        true -> candidate(resolver, sources, syntax, named, path, end - 1, heads),
        false -> heads
    }

    machine candidate(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, named: |syntax_trees|::MachineItem, path: |symbol_resolved_trees|::MachineOwner, index: u64 in Trapping, heads: |symbol_resolved_trees|::OverloadLinks) -> |symbol_resolved_trees|::OverloadLinks {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        let same: bool = machine_spells(@resolver.output, sources, item, index, path.has_owner, path.owner.source_span, named.name.source_span);
        transition same && item.parent == named.parent {
            true -> owner(resolver, sources, syntax, named, path, index, item, heads),
            false -> link_overloads(resolver, sources, syntax, named, path, index, heads)
        }
    }

    machine owner(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, named: |syntax_trees|::MachineItem, path: |symbol_resolved_trees|::MachineOwner, index: u64 in Trapping, item: |syntax_trees|::MachineItem, heads: |symbol_resolved_trees|::OverloadLinks) -> |symbol_resolved_trees|::OverloadLinks {
        let same: bool = |imports|::resolver_same_module(sources, overload_unit_index(named.name.source_span.source), overload_unit_index(item.name.source_span.source));
        transition same {
            true -> prepend(resolver, sources, syntax, named, path, index, item, heads),
            false -> link_overloads(resolver, sources, syntax, named, path, index, heads)
        }
    }

    machine prepend(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, named: |syntax_trees|::MachineItem, path: |symbol_resolved_trees|::MachineOwner, index: u64 in Trapping, item: |syntax_trees|::MachineItem, heads: |symbol_resolved_trees|::OverloadLinks) -> |symbol_resolved_trees|::OverloadLinks {
        let exported: bool = machine_public(@resolver.output, syntax, item, index);
        let first: |symbol_resolved_trees|::OverloadLinks = |symbol_resolved_trees|::prepend_overload(@mutable resolver.output.overloads, index, heads, exported);
        transition { _ -> link_overloads(resolver, sources, syntax, named, path, index, first) }
    }
}

// Source IDs are 32-bit. SourceSet lookups use a 64-bit unit index.
machine overload_unit_index(source: |source|::SourceId) -> u64 in Trapping {
    ((source.value as -Trapping) as u64) as +Trapping
}

// The first visible machine whose path is `name` (owned by `owner` when
// `owned`): its overload family's representative, since typing selects
// among a module's overloads. A machine's path is its `MachineOwner`'s, so
// `Trait::requirement` and `Conformance::member` name container members. A
// visible machine of the same path in another module makes the name
// ambiguous.
public machine machine_named(
    resolution: @|symbol_resolved_trees|::NameResolution,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    owned: bool,
    owner: |source|::SourceSpan,
    name: |source|::SourceSpan
) -> |declarations|::Lookup
crashes Trap
{
    transition { _ -> next(resolution, sources, syntax, owned, owner, name, 0 as +Trapping) }

    machine next(resolution: @|symbol_resolved_trees|::NameResolution, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, owned: bool, owner: |source|::SourceSpan, name: |source|::SourceSpan, index: u64 in Trapping) -> |declarations|::Lookup {
        transition index < syntax.machine_count {
            true -> candidate(resolution, sources, syntax, owned, owner, name, index),
            _ -> absent()
        }
    }

    machine candidate(resolution: @|symbol_resolved_trees|::NameResolution, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, owned: bool, owner: |source|::SourceSpan, name: |source|::SourceSpan, index: u64 in Trapping) -> |declarations|::Lookup {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        let named: bool = item.parent == 0 && machine_spells(resolution, sources, item, index, owned, |imports|::member_spelling(syntax, owner), |imports|::member_spelling(syntax, name));
        let visible: bool = machine_visible_if(resolution, sources, syntax, named, owner, item, index);
        transition visible {
            true -> rival(resolution, sources, syntax, owned, owner, name, index, item.name.source_span.source, index + 1),
            _ -> next(resolution, sources, syntax, owned, owner, name, index + 1)
        }
    }

    machine rival(
        resolution: @|symbol_resolved_trees|::NameResolution,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        owned: bool,
        owner: |source|::SourceSpan,
        name: |source|::SourceSpan,
        found: u64 in Trapping,
        family: |source|::SourceId,
        index: u64 in Trapping
    ) -> |declarations|::Lookup {
        transition index < syntax.machine_count {
            true -> rival_candidate(resolution, sources, syntax, owned, owner, name, found, family, index),
            _ -> unique(found)
        }
    }

    machine rival_candidate(
        resolution: @|symbol_resolved_trees|::NameResolution,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        owned: bool,
        owner: |source|::SourceSpan,
        name: |source|::SourceSpan,
        found: u64 in Trapping,
        family: |source|::SourceId,
        index: u64 in Trapping
    ) -> |declarations|::Lookup {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        let named: bool = item.parent == 0 && machine_spells(resolution, sources, item, index, owned, |imports|::member_spelling(syntax, owner), |imports|::member_spelling(syntax, name));
        let visible: bool = machine_visible_if(resolution, sources, syntax, named, owner, item, index);
        let overload: bool = |imports|::resolver_same_module(sources, family.value as -Trapping as u64 +Trapping,
            item.name.source_span.source.value as -Trapping as u64 +Trapping);
        transition visible && !overload {
            true -> ambiguous(),
            _ -> rival(resolution, sources, syntax, owned, owner, name, found, family, index + 1)
        }
    }

    machine unique(found: u64 in Trapping) -> |declarations|::Lookup {
        |declarations|::Lookup::Found { handle: found }
    }

    machine absent() -> |declarations|::Lookup {
        |declarations|::Lookup::Absent
    }

    machine ambiguous() -> |declarations|::Lookup {
        |declarations|::Lookup::Ambiguous
    }
}

// Whether machine `handle` (row `item`) has the path `name` (owned by
// `owner` when `owned`), through its `MachineOwner`.
public machine machine_spells(
    resolution: @|symbol_resolved_trees|::NameResolution,
    sources: @|source|::SourceSet,
    item: |syntax_trees|::MachineItem,
    handle: u64 in Trapping,
    owned: bool,
    owner: |source|::SourceSpan,
    name: |source|::SourceSpan
) -> bool
crashes Trap
{
    let path: |symbol_resolved_trees|::MachineOwner = |symbol_resolved_trees|::machine_owner(resolution, handle);
    let named: bool = |source|::spans_equal(sources, item.name.source_span, name);
    let owner_named: bool = |source|::spans_equal(sources, path.owner.source_span, owner);
    let callable: bool = item.container != |syntax_trees|::MachineContainer::Measure;
    callable && named && path.has_owner == owned && (!owned || owner_named)
}

// A machine's visibility, tested only when its spelling matched.
public machine machine_visible_if(
    resolution: @|symbol_resolved_trees|::NameResolution,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    named: bool,
    from: |source|::SourceSpan,
    item: |syntax_trees|::MachineItem,
    handle: u64 in Trapping
) -> bool
crashes Trap
{
    transition named {
        true -> test(resolution, sources, syntax, from, item, handle),
        _ -> hidden()
    }

    machine test(resolution: @|symbol_resolved_trees|::NameResolution, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, from: |source|::SourceSpan, item: |syntax_trees|::MachineItem, handle: u64 in Trapping) -> bool {
        let is_public: bool = machine_public(resolution, syntax, item, handle);
        |imports|::resolver_visible(sources, syntax, from, item.name.source_span.source, is_public)
    }

    machine hidden() -> bool {
        false
    }
}

// Whether machine `handle` (row `item`) is `public`: a root machine by its own
// marker, a trait's or conformance's member by its container's.
public machine machine_public(resolution: @|symbol_resolved_trees|::NameResolution, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem, handle: u64 in Trapping) -> bool
crashes Trap
{
    |machine_declarations|::machine_public(resolution, syntax, item, handle)
}
