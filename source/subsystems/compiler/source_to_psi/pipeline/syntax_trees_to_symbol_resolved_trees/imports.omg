use pipeline/syntax_trees_to_symbol_resolved_trees/resolution_state.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/declarations.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;

// Which declarations a source unit can name (wiki/spec/language/modules.md,
// wiki/spec/packages/boundaries.md). Every unit belongs to a package and to
// a module within it; a module is its package and its path together, so one
// path in two packages names two modules. A unit sees its own module's
// declarations, whichever of the module's units declares them, and the
// declarations of each module its `use` rows import; an import affects only
// the unit that writes it and is not transitive. Within one package every
// declaration is visible to an importer; across packages only a `public` one
// is, a trait's or conformance's member taking its container's visibility.
//
// A `use` path's leading members select the package of the module it names
// (`import_target`). The language's toolchain mount `omega\language\core`
// selects the toolchain's core package from every package
// (wiki/spec/packages/toolchain.md). Otherwise a first member spelling one
// of the requester's product dependency aliases selects that dependency,
// and one spelling the requester's own name its own package; the rest of
// the path is the module's path there. Any other path is a module path of
// the requester's own package. A first member spelling another package's
// name, or one of the requester's build-scope aliases, where the
// requester's package holds no such module, is an undeclared dependency: a
// package's name grants nothing without an edge, and build edges never
// authorize product imports (wiki/spec/build/declarations.md).
//
// Name lookup tests a declaration's import route after its spelling matches.
// Once a machine name is bound, overloads.omg publishes the visible members
// for that use so typing can walk the family directly.

// The package a `use` path selects, and how many of its leading members
// select it; the members after them spell the module's path there. `found`
// is false when the toolchain mount names no supplied toolchain package.
public data ImportTarget [copy] {
    found: bool;
    package: u64 in Trapping;
    selector_count: u64 in Trapping;
}

// Every `use` names a supplied module; the first that names none rejects.
public machine check_imports(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0 as +Trapping) }

    machine next(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.use_count {
            true -> import(resolver, sources, syntax, index),
            _ -> done()
        }
    }

    machine import(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let use_item: |syntax_trees|::UseItem = |syntax_trees|::syntax_trees_use_item(syntax, index);
        let target: ImportTarget = import_target(sources, syntax, use_item);
        let named: bool = names_some_unit(sources, syntax, use_item, target, 0 as +Trapping);
        transition named {
            true -> next(resolver, sources, syntax, index + 1),
            _ -> unresolved(resolver, sources, syntax, use_item, target)
        }
    }

    machine unresolved(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, use_item: |syntax_trees|::UseItem, target: ImportTarget) {
        let undeclared: bool = undeclared_dependency(sources, syntax, use_item, target);
        transition undeclared {
            true -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UndeclaredDependency, use_item),
            _ -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UnresolvedImport, use_item)
        }
    }

    machine reject(resolver: @mutable |resolution_state|::Resolver, code: |symbol_resolved_trees|::ResolveDiagnosticCode, use_item: |syntax_trees|::UseItem) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, code, use_item.source_span);
    }

    machine done() {}
}

// The package `use_item`'s path selects and the members selecting it.
public machine import_target(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, use_item: |syntax_trees|::UseItem) -> ImportTarget
crashes Trap
{
    let requester: u64 in Trapping = |source|::unit_package(sources, use_item.source_span.source.value as -Trapping as u64 +Trapping);
    let mounted: bool = names_toolchain_mount(sources, syntax, use_item);
    transition mounted {
        true -> toolchain(sources, 0 as +Trapping),
        _ -> first(sources, syntax, use_item, requester)
    }

    machine toolchain(sources: @|source|::SourceSet, package: u64 in Trapping) -> ImportTarget {
        transition package < sources.package_count {
            true -> toolchain_candidate(sources, package),
            _ -> missing()
        }
    }

    machine toolchain_candidate(sources: @|source|::SourceSet, package: u64 in Trapping) -> ImportTarget {
        let row: |source|::PackageRow = |source|::package_row(sources, package);
        transition row.toolchain {
            true -> selected(package, 3 as +Trapping),
            _ -> toolchain(sources, package + 1)
        }
    }

    machine first(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, use_item: |syntax_trees|::UseItem, requester: u64 in Trapping) -> ImportTarget {
        let member: |syntax_trees|::IdentifierSpan = |syntax_trees|::syntax_trees_member(syntax, use_item.first_member);
        let spelling: |source|::SourceSpan = member.source_span;
        transition { _ -> alias(sources, requester, spelling, 0 as +Trapping) }
    }

    machine alias(sources: @|source|::SourceSet, requester: u64 in Trapping, spelling: |source|::SourceSpan, index: u64 in Trapping) -> ImportTarget {
        transition index < sources.dependency_count {
            true -> alias_candidate(sources, requester, spelling, index),
            _ -> own(sources, requester, spelling)
        }
    }

    machine alias_candidate(sources: @|source|::SourceSet, requester: u64 in Trapping, spelling: |source|::SourceSpan, index: u64 in Trapping) -> ImportTarget {
        let edge: |source|::DependencyRow = |source|::dependency_row(sources, index);
        let named: bool = edge_names(sources, edge, requester, |source|::DependencyScope::Product, spelling);
        transition named {
            true -> selected(edge.target, 1 as +Trapping),
            _ -> alias(sources, requester, spelling, index + 1)
        }
    }

    machine own(sources: @|source|::SourceSet, requester: u64 in Trapping, spelling: |source|::SourceSpan) -> ImportTarget {
        let row: |source|::PackageRow = |source|::package_row(sources, requester);
        let named: bool = |source|::span_names(sources, spelling, row.name);
        transition named {
            true -> selected(requester, 1 as +Trapping),
            _ -> selected(requester, 0 as +Trapping)
        }
    }

    machine selected(package: u64 in Trapping, selector_count: u64 in Trapping) -> ImportTarget {
        ImportTarget { found: true, package: package, selector_count: selector_count }
    }

    machine missing() -> ImportTarget {
        ImportTarget { found: false, package: 0 as +Trapping, selector_count: 0 as +Trapping }
    }
}

// Whether `use_item` begins with the toolchain mount `omega\language\core`,
// which claims every path below it.
machine names_toolchain_mount(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, use_item: |syntax_trees|::UseItem) -> bool
crashes Trap
{
    transition use_item.member_count >= 3 {
        true -> member(sources, syntax, use_item, 0 as +Trapping),
        _ -> no()
    }

    machine member(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, use_item: |syntax_trees|::UseItem, offset: u64 in Trapping) -> bool {
        let spelling: |syntax_trees|::IdentifierSpan = |syntax_trees|::syntax_trees_member(syntax, use_item.first_member + offset);
        let omega: bool = |source|::span_spells(sources, spelling.source_span, "omega");
        let language: bool = |source|::span_spells(sources, spelling.source_span, "language");
        let core: bool = |source|::span_spells(sources, spelling.source_span, "core");
        transition (offset == 0 && omega) || (offset == 1 && language) || (offset == 2 && core) {
            true -> spelled(sources, syntax, use_item, offset),
            _ -> no()
        }
    }

    machine spelled(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, use_item: |syntax_trees|::UseItem, offset: u64 in Trapping) -> bool {
        transition offset < 2 {
            true -> member(sources, syntax, use_item, offset + 1),
            _ -> yes()
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Whether `edge` is `requester`'s edge of `scope` whose alias `spelling`
// spells.
machine edge_names(
    sources: @|source|::SourceSet,
    edge: |source|::DependencyRow,
    requester: u64 in Trapping,
    scope: |source|::DependencyScope,
    spelling: |source|::SourceSpan
) -> bool
crashes Trap
{
    transition edge.requester == requester && edge.scope == scope {
        true -> spelled(sources, edge, spelling),
        _ -> no()
    }

    machine spelled(sources: @|source|::SourceSet, edge: |source|::DependencyRow, spelling: |source|::SourceSpan) -> bool {
        |source|::span_names(sources, spelling, edge.alias)
    }

    machine no() -> bool {
        false
    }
}

// Whether an import that names no module is an undeclared dependency: its
// path would be a module path of the requester's own package, but its first
// member spells another package's name or one of the requester's
// build-scope aliases.
machine undeclared_dependency(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, use_item: |syntax_trees|::UseItem, target: ImportTarget) -> bool
crashes Trap
{
    let requester: u64 in Trapping = |source|::unit_package(sources, use_item.source_span.source.value as -Trapping as u64 +Trapping);
    let member: |syntax_trees|::IdentifierSpan = |syntax_trees|::syntax_trees_member(syntax, use_item.first_member);
    let spelling: |source|::SourceSpan = member.source_span;
    transition target.found && target.selector_count == 0 {
        true -> named_package(sources, requester, spelling, 0 as +Trapping),
        _ -> no()
    }

    machine named_package(sources: @|source|::SourceSet, requester: u64 in Trapping, spelling: |source|::SourceSpan, index: u64 in Trapping) -> bool {
        transition index < sources.package_count {
            true -> package_candidate(sources, requester, spelling, index),
            _ -> build_alias(sources, requester, spelling, 0 as +Trapping)
        }
    }

    machine package_candidate(sources: @|source|::SourceSet, requester: u64 in Trapping, spelling: |source|::SourceSpan, index: u64 in Trapping) -> bool {
        let row: |source|::PackageRow = |source|::package_row(sources, index);
        let named: bool = |source|::span_names(sources, spelling, row.name);
        transition named && index != requester {
            true -> yes(),
            _ -> named_package(sources, requester, spelling, index + 1)
        }
    }

    machine build_alias(sources: @|source|::SourceSet, requester: u64 in Trapping, spelling: |source|::SourceSpan, index: u64 in Trapping) -> bool {
        transition index < sources.dependency_count {
            true -> build_alias_candidate(sources, requester, spelling, index),
            _ -> no()
        }
    }

    machine build_alias_candidate(sources: @|source|::SourceSet, requester: u64 in Trapping, spelling: |source|::SourceSpan, index: u64 in Trapping) -> bool {
        let edge: |source|::DependencyRow = |source|::dependency_row(sources, index);
        let named: bool = edge_names(sources, edge, requester, |source|::DependencyScope::Build, spelling);
        transition named {
            true -> yes(),
            _ -> build_alias(sources, requester, spelling, index + 1)
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Whether some unit at or after `unit` belongs to the module `use_item`
// names in the package `target` selects.
machine names_some_unit(
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    use_item: |syntax_trees|::UseItem,
    target: ImportTarget,
    unit: u64 in Trapping
) -> bool
crashes Trap
{
    transition unit < sources.unit_count {
        true -> candidate(sources, syntax, use_item, target, unit),
        _ -> none()
    }

    machine candidate(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, use_item: |syntax_trees|::UseItem, target: ImportTarget, unit: u64 in Trapping) -> bool {
        let named: bool = use_names_unit(sources, syntax, use_item, target, unit);
        transition named {
            true -> some(),
            _ -> next(sources, syntax, use_item, target, unit + 1)
        }
    }

    machine next(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, use_item: |syntax_trees|::UseItem, target: ImportTarget, unit: u64 in Trapping) -> bool {
        transition unit < sources.unit_count {
            true -> candidate(sources, syntax, use_item, target, unit),
            _ -> none()
        }
    }

    machine some() -> bool {
        true
    }

    machine none() -> bool {
        false
    }
}

// Whether a declaration of unit `declared`, `public` when `is_public`, is one a
// reference in `from` may name: one of the same unit or module, or one a
// `use` of `from` imports, which across packages must be `public`.
public machine resolver_visible(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, from: |source|::SourceId, declared: |source|::SourceId, is_public: bool) -> bool
crashes Trap
{
    let from_unit: u64 in Trapping = from.value as -Trapping as u64 +Trapping;
    let declared_unit: u64 in Trapping = declared.value as -Trapping as u64 +Trapping;
    let same_module: bool = resolver_same_module(sources, from_unit, declared_unit);
    let same_package: bool = resolver_same_package(sources, from_unit, declared_unit);
    transition from_unit == declared_unit || same_module {
        true -> seen(),
        _ -> exposed(sources, syntax, from, declared_unit, is_public || same_package)
    }

    machine exposed(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, from: |source|::SourceId, declared_unit: u64 in Trapping, open: bool) -> bool {
        transition open {
            true -> imported(sources, syntax, from, declared_unit, 0 as +Trapping),
            _ -> unseen()
        }
    }

    machine imported(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, from: |source|::SourceId, declared_unit: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < syntax.use_count {
            true -> use_row(sources, syntax, from, declared_unit, index),
            _ -> unseen()
        }
    }

    machine use_row(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, from: |source|::SourceId, declared_unit: u64 in Trapping, index: u64 in Trapping) -> bool {
        let use_item: |syntax_trees|::UseItem = |syntax_trees|::syntax_trees_use_item(syntax, index);
        transition use_item.source_span.source.value == from.value {
            true -> own_use(sources, syntax, from, declared_unit, index, use_item),
            _ -> imported(sources, syntax, from, declared_unit, index + 1)
        }
    }

    machine own_use(
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        from: |source|::SourceId,
        declared_unit: u64 in Trapping,
        index: u64 in Trapping,
        use_item: |syntax_trees|::UseItem
    ) -> bool {
        let target: ImportTarget = import_target(sources, syntax, use_item);
        let named: bool = use_names_unit(sources, syntax, use_item, target, declared_unit);
        transition named {
            true -> seen(),
            _ -> imported(sources, syntax, from, declared_unit, index + 1)
        }
    }

    machine seen() -> bool {
        true
    }

    machine unseen() -> bool {
        false
    }
}

// Whether two units belong to one package.
public machine resolver_same_package(sources: @|source|::SourceSet, left: u64 in Trapping, right: u64 in Trapping) -> bool
{
    |source|::same_package(sources, left, right)
}

// Whether two units belong to one module: one package and one module path.
public machine resolver_same_module(sources: @|source|::SourceSet, left: u64 in Trapping, right: u64 in Trapping) -> bool
crashes Trap
{
    let left_length: u64 in Trapping = |source|::path_length(sources, left);
    let right_length: u64 in Trapping = |source|::path_length(sources, right);
    let same_package: bool = resolver_same_package(sources, left, right);
    transition same_package && left_length == right_length {
        true -> compare(sources, left, right, left_length, 0 as +Trapping),
        _ -> different()
    }

    machine compare(sources: @|source|::SourceSet, left: u64 in Trapping, right: u64 in Trapping, length: u64 in Trapping, index: u64 in Trapping) -> bool {
        let left_byte: u8 = |source|::path_byte_or_nul(sources, left, index);
        let right_byte: u8 = |source|::path_byte_or_nul(sources, right, index);
        transition index < length {
            true -> byte(sources, left, right, length, index, left_byte == right_byte),
            _ -> same()
        }
    }

    machine byte(sources: @|source|::SourceSet, left: u64 in Trapping, right: u64 in Trapping, length: u64 in Trapping, index: u64 in Trapping, equal: bool) -> bool {
        transition equal {
            true -> compare(sources, left, right, length, index + 1),
            _ -> different()
        }
    }

    machine same() -> bool {
        true
    }

    machine different() -> bool {
        false
    }
}

// Whether `use_item`, selecting `target`, names unit `unit`'s module: the
// unit belongs to the selected package, and the members after the selecting
// ones, in order and joined by `::`, spell its module path.
public machine use_names_unit(
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    use_item: |syntax_trees|::UseItem,
    target: ImportTarget,
    unit: u64 in Trapping
) -> bool
crashes Trap
{
    let length: u64 in Trapping = |source|::path_length(sources, unit);
    let package: u64 in Trapping = |source|::unit_package(sources, unit);
    transition target.found && package == target.package && target.selector_count < use_item.member_count {
        true -> member(sources, syntax, use_item, unit, length, target.selector_count, 0 as +Trapping),
        _ -> different()
    }

    // `position` is where member `member` must begin in the module path.
    machine member(
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        use_item: |syntax_trees|::UseItem,
        unit: u64 in Trapping,
        length: u64 in Trapping,
        member: u64 in Trapping,
        position: u64 in Trapping
    ) -> bool {
        let spelling: |syntax_trees|::IdentifierSpan = |syntax_trees|::syntax_trees_member(syntax, use_item.first_member + member);
        let width: u64 in Trapping = spelling.source_span.span.end - spelling.source_span.span.start;
        transition position + width <= length {
            true -> spell(sources, syntax, use_item, unit, length, member, position, spelling.source_span, 0 as +Trapping),
            _ -> different()
        }
    }

    machine spell(
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        use_item: |syntax_trees|::UseItem,
        unit: u64 in Trapping,
        length: u64 in Trapping,
        member: u64 in Trapping,
        position: u64 in Trapping,
        spelling: |source|::SourceSpan,
        offset: u64 in Trapping
    ) -> bool {
        let source_byte: u8 = |source|::source_set_byte_or_nul(sources, spelling.source, spelling.span.start + offset);
        let path_byte: u8 = |source|::path_byte_or_nul(sources, unit, position + offset);
        transition offset < spelling.span.end - spelling.span.start {
            true -> spelled_byte(sources, syntax, use_item, unit, length, member, position, spelling, offset, source_byte == path_byte),
            _ -> member_end(sources, syntax, use_item, unit, length, member, position + offset)
        }
    }

    machine spelled_byte(
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        use_item: |syntax_trees|::UseItem,
        unit: u64 in Trapping,
        length: u64 in Trapping,
        member: u64 in Trapping,
        position: u64 in Trapping,
        spelling: |source|::SourceSpan,
        offset: u64 in Trapping,
        equal: bool
    ) -> bool {
        transition equal {
            true -> spell(sources, syntax, use_item, unit, length, member, position, spelling, offset + 1),
            _ -> different()
        }
    }

    // After the last member the path must end; otherwise `::` follows.
    machine member_end(
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        use_item: |syntax_trees|::UseItem,
        unit: u64 in Trapping,
        length: u64 in Trapping,
        member: u64 in Trapping,
        position: u64 in Trapping
    ) -> bool {
        transition member + 1 < use_item.member_count {
            true -> separator(sources, syntax, use_item, unit, length, member, position),
            _ -> ended(length, position)
        }
    }

    machine separator(
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        use_item: |syntax_trees|::UseItem,
        unit: u64 in Trapping,
        length: u64 in Trapping,
        current_member: u64 in Trapping,
        position: u64 in Trapping
    ) -> bool {
        let first: u8 = |source|::path_byte_or_nul(sources, unit, position);
        let second: u8 = |source|::path_byte_or_nul(sources, unit, position + 1);
        transition first == 58 && second == 58 {
            true -> member(sources, syntax, use_item, unit, length, current_member + 1, position + 2),
            _ -> different()
        }
    }

    machine ended(length: u64 in Trapping, position: u64 in Trapping) -> bool {
        position == length
    }

    machine different() -> bool {
        false
    }
}

// The declaration of `kind` that `name` (owned by `owner` when `owned`)
// denotes from its own unit. A second visible declaration of the path
// belongs to another module (a module's duplicates reject earlier), so it
// makes the name ambiguous.
public machine declared_named(
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    kind: |declarations|::DeclarationKind,
    owned: bool,
    owner: |source|::SourceSpan,
    name: |source|::SourceSpan
) -> |declarations|::Lookup
crashes Trap
{
    let count: u64 in Trapping = |declarations|::declaration_count(syntax, kind);
    transition { _ -> next(sources, syntax, kind, owned, owner, name, count, 0 as +Trapping) }

    machine next(
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        kind: |declarations|::DeclarationKind,
        owned: bool,
        owner: |source|::SourceSpan,
        name: |source|::SourceSpan,
        count: u64 in Trapping,
        index: u64 in Trapping
    ) -> |declarations|::Lookup {
        transition index < count {
            true -> candidate(sources, syntax, kind, owned, owner, name, count, index),
            _ -> absent()
        }
    }

    machine candidate(
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        kind: |declarations|::DeclarationKind,
        owned: bool,
        owner: |source|::SourceSpan,
        name: |source|::SourceSpan,
        count: u64 in Trapping,
        index: u64 in Trapping
    ) -> |declarations|::Lookup {
        let path: |declarations|::DeclarationPath = |declarations|::declaration_path(syntax, kind, index);
        let named: bool = |declarations|::path_spells(sources, path, owned, owner, name);
        let visible: bool = visible_if(sources, syntax, named, name.source, path.name.source_span.source, path.is_public);
        transition visible {
            true -> rival(sources, syntax, kind, owned, owner, name, count, index, index + 1),
            _ -> next(sources, syntax, kind, owned, owner, name, count, index + 1)
        }
    }

    machine rival(
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        kind: |declarations|::DeclarationKind,
        owned: bool,
        owner: |source|::SourceSpan,
        name: |source|::SourceSpan,
        count: u64 in Trapping,
        found: u64 in Trapping,
        index: u64 in Trapping
    ) -> |declarations|::Lookup {
        transition index < count {
            true -> rival_candidate(sources, syntax, kind, owned, owner, name, count, found, index),
            _ -> unique(found)
        }
    }

    machine rival_candidate(
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        kind: |declarations|::DeclarationKind,
        owned: bool,
        owner: |source|::SourceSpan,
        name: |source|::SourceSpan,
        count: u64 in Trapping,
        found: u64 in Trapping,
        index: u64 in Trapping
    ) -> |declarations|::Lookup {
        let path: |declarations|::DeclarationPath = |declarations|::declaration_path(syntax, kind, index);
        let named: bool = |declarations|::path_spells(sources, path, owned, owner, name);
        let visible: bool = visible_if(sources, syntax, named, name.source, path.name.source_span.source, path.is_public);
        transition visible {
            true -> ambiguous(),
            _ -> rival(sources, syntax, kind, owned, owner, name, count, found, index + 1)
        }
    }

    machine unique(found: u64 in Trapping) -> |declarations|::Lookup {
        |declarations|::Lookup::Found { handle: found }
    }

    machine absent() -> |declarations|::Lookup {
        |declarations|::Lookup::Absent
    }

    machine ambiguous() -> |declarations|::Lookup {
        |declarations|::Lookup::Ambiguous
    }
}

// The data declaration `name` denotes from its own unit.
public machine data_named(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan) -> |declarations|::Lookup
crashes Trap
{
    declared_named(sources, syntax, |declarations|::DeclarationKind::Data, false, name, name)
}

// The declared measure `Owner::name` (wiki/spec/language/termination.md),
// as its machine handle plus one; zero for none. A measure is a view, not a
// callee, so `machine_spells` never matches one.
public machine measure_named(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, owner: |source|::SourceSpan, name: |source|::SourceSpan) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(sources, syntax, owner, name, 0 as +Trapping) }

    machine next(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, owner: |source|::SourceSpan, name: |source|::SourceSpan, index: u64 in Trapping) -> u64 in Trapping {
        transition index < syntax.machine_count {
            true -> candidate(sources, syntax, owner, name, index),
            _ -> absent()
        }
    }

    machine candidate(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, owner: |source|::SourceSpan, name: |source|::SourceSpan, index: u64 in Trapping) -> u64 in Trapping {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        let named: bool = item.container == |syntax_trees|::MachineContainer::Measure && item.has_owner
            && |source|::spans_equal(sources, item.name.source_span, name)
            && |source|::spans_equal(sources, item.owner.source_span, owner);
        transition named {
            true -> found(index),
            _ -> next(sources, syntax, owner, name, index + 1)
        }
    }

    machine found(index: u64 in Trapping) -> u64 in Trapping {
        index + 1
    }

    machine absent() -> u64 in Trapping {
        0 as +Trapping
    }
}

// Visibility, tested only for a declaration whose spelling matched.
public machine visible_if(
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    named: bool,
    from: |source|::SourceId,
    declared: |source|::SourceId,
    is_public: bool
) -> bool
crashes Trap
{
    transition named {
        true -> test(sources, syntax, from, declared, is_public),
        _ -> hidden()
    }

    machine test(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, from: |source|::SourceId, declared: |source|::SourceId, is_public: bool) -> bool {
        resolver_visible(sources, syntax, from, declared, is_public)
    }

    machine hidden() -> bool {
        false
    }
}
