use representations::source_files::SourceSet;
use representations::source_files::spans_equal;
use representations::symbol_resolved_trees::NameResolution;
use representations::symbol_resolved_trees::ResolveDiagnosticCode;
use representations::symbol_resolved_trees::TypeScope;
use representations::symbol_resolved_trees::name_resolution_reject;
use representations::syntax_trees::ConformanceItem;
use representations::syntax_trees::DataCase;
use representations::syntax_trees::DataField;
use representations::syntax_trees::DataItem;
use representations::syntax_trees::DataMember;
use representations::syntax_trees::DomainItem;
use representations::syntax_trees::IdentifierSpan;
use representations::syntax_trees::MachineItem;
use representations::syntax_trees::PropositionItem;
use representations::syntax_trees::RootItem;
use representations::syntax_trees::RootItemKind;
use representations::syntax_trees::SyntaxTrees;
use representations::syntax_trees::TraitItem;
use representations::syntax_trees::conformance_item;
use representations::syntax_trees::machine_item;
use representations::syntax_trees::member_name;
use representations::syntax_trees::proposition_item;
use representations::syntax_trees::root_item;
use representations::syntax_trees::syntax_trees_data_case;
use representations::syntax_trees::syntax_trees_data_item;
use representations::syntax_trees::syntax_trees_data_member;
use representations::syntax_trees::syntax_trees_domain_item;
use representations::syntax_trees::syntax_trees_field;
use representations::syntax_trees::syntax_trees_payload_field;
use representations::syntax_trees::trait_item;

// Root names and member namespaces are checked before later lookup can choose between declarations.

// The namespace a root's name occupies within its module: data, traits and
// conformances share the type names, constants are values by owner and
// name, and propositions name logical declarations. `use` rows, machines
// (overload families, check_machines) and domains (by carrier,
// domains.omg) are checked apart.
public data RootNamespace [copy] {
    case None;
    case Type;
    case Constant;
    case Proposition;
}

public data RootName [copy] {
    kind: RootItemKind;
    space: RootNamespace;
    has_owner: bool;
    owner: IdentifierSpan;
    name: IdentifierSpan;
}

machine root_name(syntax: @SyntaxTrees, index: u64 in Trapping) -> RootName
crashes Trap
{
    let root: RootItem = root_item(syntax, index);
    transition root.kind {
        RootItemKind::Data -> declared(syntax, root, RootNamespace::Type, DeclarationKind::Data),
        RootItemKind::Trait -> declared(syntax, root, RootNamespace::Type, DeclarationKind::Trait),
        RootItemKind::Conformance -> declared(syntax, root, RootNamespace::Type, DeclarationKind::Conformance),
        RootItemKind::Constant -> declared(syntax, root, RootNamespace::Constant, DeclarationKind::Constant),
        RootItemKind::Proposition -> declared(syntax, root, RootNamespace::Proposition, DeclarationKind::Proposition),
        _ -> none(root)
    }

    machine declared(syntax: @SyntaxTrees, root: RootItem, space: RootNamespace, kind: DeclarationKind) -> RootName {
        let path: DeclarationPath = declaration_path(syntax, kind, root.item_index);
        RootName { kind: root.kind, space: space, has_owner: path.has_owner, owner: path.owner, name: path.name }
    }

    machine none(root: RootItem) -> RootName {
        let span: IdentifierSpan = IdentifierSpan { source_span: root.source_span };
        RootName { kind: root.kind, space: RootNamespace::None, has_owner: false, owner: span, name: span }
    }
}

// Declaration names, root by root. A type name that spells a builtin type
// rejects: references would bind the builtin and the declaration could
// never be named. A path an earlier root of the same module and namespace
// already took rejects at the later root, as duplicate data when both are
// data; other modules' declarations conflict only where both are visible to
// one reference.
machine declare_roots(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0) }

    machine next(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.root_count {
            true -> root(resolver, sources, syntax, index),
            _ -> done()
        }
    }

    machine root(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping) {
        let declared: RootName = root_name(syntax, index);
        transition declared.space {
            RootNamespace::None -> next(resolver, sources, syntax, index + 1),
            RootNamespace::Type -> builtin_shadow(resolver, sources, syntax, index, declared),
            _ -> earlier(resolver, sources, syntax, index, declared, 0)
        }
    }

    machine builtin_shadow(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping, declared: RootName) {
        let builtin: bool = builtin_type_spelling(sources, declared.name.source_span);
        transition builtin {
            true -> reject(resolver, ResolveDiagnosticCode::ShadowsBuiltin, declared.name),
            _ -> earlier(resolver, sources, syntax, index, declared, 0)
        }
    }

    machine earlier(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping, declared: RootName, prior: u64 in Trapping) {
        transition prior < index {
            true -> compare(resolver, sources, syntax, index, declared, prior),
            _ -> competing(resolver, sources, syntax, index, declared)
        }
    }

    // A constant's path is a value path that a case (`Owner::Case`) or a
    // machine of its module must not also spell.
    machine competing(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping, declared: RootName) {
        transition declared.space == RootNamespace::Constant {
            true -> constant_path(resolver, sources, syntax, index, declared),
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine constant_path(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping, declared: RootName) {
        let spelled: bool = value_path_taken(@resolver.output, sources, syntax, declared);
        transition spelled {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateDeclaration, declared.name),
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine compare(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping, declared: RootName, prior: u64 in Trapping) {
        let other: RootName = root_name(syntax, prior);
        let named: bool = spans_equal(sources, declared.name.source_span, other.name.source_span);
        let owner_named: bool = spans_equal(sources, declared.owner.source_span, other.owner.source_span);
        let same_module: bool = resolver_same_module(sources, declared.name.source_span.source.value as u64 in Trapping,
            other.name.source_span.source.value as u64 in Trapping);
        transition declared.space == other.space && named && declared.has_owner == other.has_owner
            && (!declared.has_owner || owner_named) && same_module {
            true -> duplicate(resolver, declared, other),
            _ -> earlier(resolver, sources, syntax, index, declared, prior + 1)
        }
    }

    machine duplicate(resolver: @mut Resolver, declared: RootName, other: RootName) {
        transition declared.kind == RootItemKind::Data && other.kind == RootItemKind::Data {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateData, declared.name),
            _ -> reject(resolver, ResolveDiagnosticCode::DuplicateDeclaration, declared.name)
        }
    }

    machine reject(resolver: @mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        name_resolution_reject(@mut resolver.output, code, name.source_span);
    }

    machine done() {}
}

// Whether a case or a machine of `declared`'s module spells its path: a
// case `Owner::NAME` of a data declaration `Owner`, or a machine whose path
// is the constant's.
machine value_path_taken(resolution: @NameResolution, sources: @SourceSet, syntax: @SyntaxTrees, declared: RootName) -> bool
crashes Trap
{
    transition { _ -> machine_at(resolution, sources, syntax, declared, 0) }

    machine machine_at(resolution: @NameResolution, sources: @SourceSet, syntax: @SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        transition index < syntax.machine_count {
            true -> machine_path(resolution, sources, syntax, declared, index),
            _ -> owner_data(sources, syntax, declared, 0)
        }
    }

    machine machine_path(resolution: @NameResolution, sources: @SourceSet, syntax: @SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        let item: MachineItem = machine_item(syntax, index);
        let spelled: bool = machine_spells(resolution, sources, item, index, declared.has_owner,
            declared.owner.source_span, declared.name.source_span);
        let same_module: bool = resolver_same_module(sources, declared.name.source_span.source.value as u64 in Trapping,
            item.name.source_span.source.value as u64 in Trapping);
        transition spelled && same_module {
            true -> taken(),
            _ -> machine_at(resolution, sources, syntax, declared, index + 1)
        }
    }

    machine owner_data(sources: @SourceSet, syntax: @SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        transition declared.has_owner && index < syntax.data_count {
            true -> owner_named(sources, syntax, declared, index),
            _ -> free()
        }
    }

    machine owner_named(sources: @SourceSet, syntax: @SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        let item: DataItem = syntax_trees_data_item(syntax, index);
        let named: bool = spans_equal(sources, item.name.source_span, declared.owner.source_span);
        let same_module: bool = resolver_same_module(sources, declared.name.source_span.source.value as u64 in Trapping,
            item.name.source_span.source.value as u64 in Trapping);
        transition named && same_module {
            true -> case_at(sources, syntax, declared, index, item, 0),
            _ -> owner_data(sources, syntax, declared, index + 1)
        }
    }

    machine case_at(sources: @SourceSet, syntax: @SyntaxTrees, declared: RootName, index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) -> bool {
        transition offset < item.case_count {
            true -> case_named(sources, syntax, declared, index, item, offset),
            _ -> owner_data(sources, syntax, declared, index + 1)
        }
    }

    machine case_named(sources: @SourceSet, syntax: @SyntaxTrees, declared: RootName, index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) -> bool {
        let data_case: DataCase = syntax_trees_data_case(syntax, item.first_case + offset);
        let named: bool = spans_equal(sources, data_case.name.source_span, declared.name.source_span);
        transition named {
            true -> taken(),
            _ -> case_at(sources, syntax, declared, index, item, offset + 1)
        }
    }

    machine taken() -> bool {
        true
    }

    machine free() -> bool {
        false
    }
}

// The generic parameter names of every trait, conformance, domain and
// proposition, and each proposition's parameter names. Data declarations'
// generics check with their members, machines' with their signatures.
machine check_declaration_namespaces(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees)
crashes Trap
{
    transition { _ -> traits(resolver, sources, syntax, 0) }

    machine traits(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.trait_count && resolver.output.accepted {
            true -> trait_generics(resolver, sources, syntax, index),
            _ -> conformances(resolver, sources, syntax, 0)
        }
    }

    machine trait_generics(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping) {
        let item: TraitItem = trait_item(syntax, index);
        let scope: TypeScope = resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        check_generic_names(resolver, sources, syntax, scope);
        transition { _ -> traits(resolver, sources, syntax, index + 1) }
    }

    machine conformances(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.conformance_count && resolver.output.accepted {
            true -> conformance_generics(resolver, sources, syntax, index),
            _ -> domains(resolver, sources, syntax, 0)
        }
    }

    machine conformance_generics(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping) {
        let item: ConformanceItem = conformance_item(syntax, index);
        let scope: TypeScope = resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        check_generic_names(resolver, sources, syntax, scope);
        transition { _ -> conformances(resolver, sources, syntax, index + 1) }
    }

    machine domains(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.domain_count && resolver.output.accepted {
            true -> domain_generics(resolver, sources, syntax, index),
            _ -> propositions(resolver, sources, syntax, 0)
        }
    }

    machine domain_generics(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping) {
        let item: DomainItem = syntax_trees_domain_item(syntax, index);
        let scope: TypeScope = resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        check_generic_names(resolver, sources, syntax, scope);
        transition { _ -> domains(resolver, sources, syntax, index + 1) }
    }

    machine propositions(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.proposition_count && resolver.output.accepted {
            true -> proposition_generics(resolver, sources, syntax, index),
            _ -> done()
        }
    }

    machine proposition_generics(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping) {
        let item: PropositionItem = proposition_item(syntax, index);
        let scope: TypeScope = resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        check_generic_names(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> proposition_parameters(resolver, sources, syntax, index, item),
            _ -> done()
        }
    }

    machine proposition_parameters(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, index: u64 in Trapping, item: PropositionItem) {
        check_parameter_names(resolver, sources, syntax, item.first_parameter, item.parameter_count);
        transition { _ -> propositions(resolver, sources, syntax, index + 1) }
    }

    machine done() {}
}

// Member namespaces of each data declaration. Direct fields and cases share
// one namespace in authored order. Each case's payload fields have their own
// namespace, which the declaration's direct (common) fields also occupy.
machine check_members(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, sources, syntax, 0) }

    machine next_data(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping) {
        transition data_index < syntax.data_count {
            true -> data_members(resolver, sources, syntax, data_index),
            _ -> done()
        }
    }

    machine data_members(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping) {
        let item: DataItem = syntax_trees_data_item(syntax, data_index);
        let scope: TypeScope = data_scope(item);
        check_generic_names(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, 0),
            _ -> done()
        }
    }

    machine member(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        transition offset < item.member_count {
            true -> member_named(resolver, sources, syntax, data_index, item, offset),
            _ -> cases(resolver, sources, syntax, data_index, item, 0)
        }
    }

    machine member_named(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping) {
        let data_member: DataMember = syntax_trees_data_member(syntax, item.first_member + offset);
        let name: IdentifierSpan = member_name(syntax, data_member);
        transition { _ -> member_prior(resolver, sources, syntax, data_index, item, offset, name, 0) }
    }

    machine member_prior(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < offset {
            true -> member_compare(resolver, sources, syntax, data_index, item, offset, name, prior),
            _ -> member(resolver, sources, syntax, data_index, item, offset + 1)
        }
    }

    machine member_compare(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_member: DataMember = syntax_trees_data_member(syntax, item.first_member + prior);
        let prior_name: IdentifierSpan = member_name(syntax, prior_member);
        let equal: bool = spans_equal(sources, name.source_span,
            prior_name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateDataMember, name),
            _ -> member_prior(resolver, sources, syntax, data_index, item, offset, name, prior + 1)
        }
    }

    machine cases(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) {
        transition case_offset < item.case_count {
            true -> case_payload(resolver, sources, syntax, data_index, item, case_offset),
            _ -> next_data(resolver, sources, syntax, data_index + 1)
        }
    }

    machine case_payload(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping) {
        let data_case: DataCase = syntax_trees_data_case(syntax, item.first_case + case_offset);
        transition { _ -> payload(resolver, sources, syntax, data_index, item, case_offset, data_case, 0) }
    }

    machine payload(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        transition field_offset < data_case.payload_field_count {
            true -> payload_named(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset),
            _ -> cases(resolver, sources, syntax, data_index, item, case_offset + 1)
        }
    }

    machine payload_named(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping) {
        let field: DataField = syntax_trees_payload_field(syntax, data_case.first_payload_field + field_offset);
        transition { _ -> payload_prior(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, field.name, 0) }
    }

    machine payload_prior(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        transition prior < field_offset {
            true -> payload_compare(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, prior),
            _ -> common(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, 0)
        }
    }

    machine payload_compare(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, prior: u64 in Trapping) {
        let prior_field: DataField = syntax_trees_payload_field(syntax, data_case.first_payload_field + prior);
        let equal: bool = spans_equal(sources, name.source_span,
            prior_field.name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::DuplicateCasePayloadField, name),
            _ -> payload_prior(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, prior + 1)
        }
    }

    machine common(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, common_offset: u64 in Trapping) {
        transition common_offset < item.field_count {
            true -> common_compare(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, common_offset),
            _ -> payload(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset + 1)
        }
    }

    machine common_compare(resolver: @mut Resolver, sources: @SourceSet, syntax: @SyntaxTrees, data_index: u64 in Trapping, item: DataItem, case_offset: u64 in Trapping, data_case: DataCase, field_offset: u64 in Trapping, name: IdentifierSpan, common_offset: u64 in Trapping) {
        let common_field: DataField = syntax_trees_field(syntax, item.first_field + common_offset);
        let equal: bool = spans_equal(sources, name.source_span,
            common_field.name.source_span
        );
        transition equal {
            true -> reject(resolver, ResolveDiagnosticCode::PayloadFieldCollidesWithCommonField, name),
            _ -> common(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, common_offset + 1)
        }
    }

    machine reject(resolver: @mut Resolver, code: ResolveDiagnosticCode, name: IdentifierSpan) {
        name_resolution_reject(@mut resolver.output, code, name.source_span);
    }

    machine done() {}
}
