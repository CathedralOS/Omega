use pipeline/syntax_trees_to_symbol_resolved_trees/resolution_state.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/declarations.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/generic_scopes.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/machine_signatures.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/overloads.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/type_names.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/imports.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;

// Root names and member namespaces are checked before later lookup can choose between declarations.

// The namespace a root's name occupies within its module: data, traits and
// conformances share the type names, constants are values by owner and
// name, and propositions name logical declarations. `use` rows, machines
// (overload families, check_machines) and domains (by carrier,
// domains.omg) are checked apart.
public data RootNamespace [copy] {
    case None;
    case Type;
    case Constant;
    case Proposition;
}

public data RootName [copy] {
    kind: |syntax_trees|::RootItemKind;
    space: RootNamespace;
    has_owner: bool;
    owner: |syntax_trees|::IdentifierSpan;
    name: |syntax_trees|::IdentifierSpan;
}

machine root_name(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) -> RootName
crashes Trap
{
    let root: |syntax_trees|::RootItem = |syntax_trees|::root_item(syntax, index);
    transition root.kind {
        |syntax_trees|::RootItemKind::Data -> declared(syntax, root, RootNamespace::Type, |declarations|::DeclarationKind::Data),
        |syntax_trees|::RootItemKind::Trait -> declared(syntax, root, RootNamespace::Type, |declarations|::DeclarationKind::Trait),
        |syntax_trees|::RootItemKind::Conformance -> declared(syntax, root, RootNamespace::Type, |declarations|::DeclarationKind::Conformance),
        |syntax_trees|::RootItemKind::Constant -> declared(syntax, root, RootNamespace::Constant, |declarations|::DeclarationKind::Constant),
        |syntax_trees|::RootItemKind::Proposition -> declared(syntax, root, RootNamespace::Proposition, |declarations|::DeclarationKind::Proposition),
        _ -> none(root)
    }

    machine declared(syntax: @|syntax_trees|::SyntaxTrees, root: |syntax_trees|::RootItem, space: RootNamespace, kind: |declarations|::DeclarationKind) -> RootName {
        let path: |declarations|::DeclarationPath = |declarations|::declaration_path(syntax, kind, root.item_index);
        RootName { kind: root.kind, space: space, has_owner: path.has_owner, owner: path.owner, name: path.name }
    }

    machine none(root: |syntax_trees|::RootItem) -> RootName {
        let span: |syntax_trees|::IdentifierSpan = |syntax_trees|::IdentifierSpan { source_span: root.source_span };
        RootName { kind: root.kind, space: RootNamespace::None, has_owner: false, owner: span, name: span }
    }
}

// Declaration names, root by root. A type name that spells a builtin type
// rejects: references would bind the builtin and the declaration could
// never be named. A path an earlier root of the same module and namespace
// already took rejects at the later root, as duplicate data when both are
// data; other modules' declarations conflict only where both are visible to
// one reference.
machine declare_roots(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0 as +Trapping) }

    machine next(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.root_count {
            true -> root(resolver, sources, syntax, index),
            _ -> done()
        }
    }

    machine root(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let declared: RootName = root_name(syntax, index);
        transition declared.space {
            RootNamespace::None -> next(resolver, sources, syntax, index + 1),
            RootNamespace::Type -> builtin_shadow(resolver, sources, syntax, index, declared),
            _ -> earlier(resolver, sources, syntax, index, declared, 0 as +Trapping)
        }
    }

    machine builtin_shadow(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, declared: RootName) {
        let builtin: bool = |type_names|::builtin_type_spelling(sources, declared.name.source_span);
        transition builtin {
            true -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::ShadowsBuiltin, declared.name),
            _ -> earlier(resolver, sources, syntax, index, declared, 0 as +Trapping)
        }
    }

    machine earlier(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, declared: RootName, prior: u64 in Trapping) {
        transition prior < index {
            true -> compare(resolver, sources, syntax, index, declared, prior),
            _ -> competing(resolver, sources, syntax, index, declared)
        }
    }

    // A constant's path is a value path that a case (`Owner::Case`) or a
    // machine of its module must not also spell.
    machine competing(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, declared: RootName) {
        transition declared.space == RootNamespace::Constant {
            true -> constant_path(resolver, sources, syntax, index, declared),
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine constant_path(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, declared: RootName) {
        let spelled: bool = value_path_taken(@resolver.output, sources, syntax, declared);
        transition spelled {
            true -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::DuplicateDeclaration, declared.name),
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine compare(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, declared: RootName, prior: u64 in Trapping) {
        let other: RootName = root_name(syntax, prior);
        let named: bool = |source|::spans_equal(sources, declared.name.source_span, other.name.source_span);
        let owner_named: bool = |source|::spans_equal(sources, declared.owner.source_span, other.owner.source_span);
        let same_module: bool = |imports|::resolver_same_module(sources, declared.name.source_span.source.value as -Trapping as u64 +Trapping,
            other.name.source_span.source.value as -Trapping as u64 +Trapping);
        transition declared.space == other.space && named && declared.has_owner == other.has_owner
            && (!declared.has_owner || owner_named) && same_module {
            true -> duplicate(resolver, declared, other),
            _ -> earlier(resolver, sources, syntax, index, declared, prior + 1)
        }
    }

    machine duplicate(resolver: @mutable |resolution_state|::Resolver, declared: RootName, other: RootName) {
        transition declared.kind == |syntax_trees|::RootItemKind::Data && other.kind == |syntax_trees|::RootItemKind::Data {
            true -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::DuplicateData, declared.name),
            _ -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::DuplicateDeclaration, declared.name)
        }
    }

    machine reject(resolver: @mutable |resolution_state|::Resolver, code: |symbol_resolved_trees|::ResolveDiagnosticCode, name: |syntax_trees|::IdentifierSpan) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, code, name.source_span);
    }

    machine done() {}
}

// Whether a case or a machine of `declared`'s module spells its path: a
// case `Owner::NAME` of a data declaration `Owner`, or a machine whose path
// is the constant's.
machine value_path_taken(resolution: @|symbol_resolved_trees|::NameResolution, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, declared: RootName) -> bool
crashes Trap
{
    transition { _ -> machine_at(resolution, sources, syntax, declared, 0 as +Trapping) }

    machine machine_at(resolution: @|symbol_resolved_trees|::NameResolution, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        transition index < syntax.machine_count {
            true -> machine_path(resolution, sources, syntax, declared, index),
            _ -> owner_data(sources, syntax, declared, 0 as +Trapping)
        }
    }

    machine machine_path(resolution: @|symbol_resolved_trees|::NameResolution, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        let spelled: bool = |overloads|::machine_spells(resolution, sources, item, index, declared.has_owner,
            declared.owner.source_span, declared.name.source_span);
        let same_module: bool = |imports|::resolver_same_module(sources, declared.name.source_span.source.value as -Trapping as u64 +Trapping,
            item.name.source_span.source.value as -Trapping as u64 +Trapping);
        transition spelled && same_module {
            true -> taken(),
            _ -> machine_at(resolution, sources, syntax, declared, index + 1)
        }
    }

    machine owner_data(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        transition declared.has_owner && index < syntax.data_count {
            true -> owner_named(sources, syntax, declared, index),
            _ -> free()
        }
    }

    machine owner_named(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, declared: RootName, index: u64 in Trapping) -> bool {
        let item: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, index);
        let named: bool = |source|::spans_equal(sources, item.name.source_span, declared.owner.source_span);
        let same_module: bool = |imports|::resolver_same_module(sources, declared.name.source_span.source.value as -Trapping as u64 +Trapping,
            item.name.source_span.source.value as -Trapping as u64 +Trapping);
        transition named && same_module {
            true -> case_at(sources, syntax, declared, index, item, 0 as +Trapping),
            _ -> owner_data(sources, syntax, declared, index + 1)
        }
    }

    machine case_at(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, declared: RootName, index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping) -> bool {
        transition offset < item.case_count {
            true -> case_named(sources, syntax, declared, index, item, offset),
            _ -> owner_data(sources, syntax, declared, index + 1)
        }
    }

    machine case_named(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, declared: RootName, index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping) -> bool {
        let data_case: |syntax_trees|::DataCase = |syntax_trees|::syntax_trees_data_case(syntax, item.first_case + offset);
        let named: bool = |source|::spans_equal(sources, data_case.name.source_span, declared.name.source_span);
        transition named {
            true -> taken(),
            _ -> case_at(sources, syntax, declared, index, item, offset + 1)
        }
    }

    machine taken() -> bool {
        true
    }

    machine free() -> bool {
        false
    }
}

// The generic parameter names of every trait, conformance, domain and
// proposition, and each proposition's parameter names. Data declarations'
// generics check with their members, machines' with their signatures.
machine check_declaration_namespaces(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> traits(resolver, sources, syntax, 0 as +Trapping) }

    machine traits(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.trait_count && resolver.output.accepted {
            true -> trait_generics(resolver, sources, syntax, index),
            _ -> conformances(resolver, sources, syntax, 0 as +Trapping)
        }
    }

    machine trait_generics(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::TraitItem = |syntax_trees|::trait_item(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        |generic_scopes|::check_generic_names(resolver, sources, syntax, scope);
        transition { _ -> traits(resolver, sources, syntax, index + 1) }
    }

    machine conformances(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.conformance_count && resolver.output.accepted {
            true -> conformance_generics(resolver, sources, syntax, index),
            _ -> domains(resolver, sources, syntax, 0 as +Trapping)
        }
    }

    machine conformance_generics(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::ConformanceItem = |syntax_trees|::conformance_item(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        |generic_scopes|::check_generic_names(resolver, sources, syntax, scope);
        transition { _ -> conformances(resolver, sources, syntax, index + 1) }
    }

    machine domains(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.domain_count && resolver.output.accepted {
            true -> domain_generics(resolver, sources, syntax, index),
            _ -> propositions(resolver, sources, syntax, 0 as +Trapping)
        }
    }

    machine domain_generics(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        |generic_scopes|::check_generic_names(resolver, sources, syntax, scope);
        transition { _ -> domains(resolver, sources, syntax, index + 1) }
    }

    machine propositions(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.proposition_count && resolver.output.accepted {
            true -> proposition_generics(resolver, sources, syntax, index),
            _ -> done()
        }
    }

    machine proposition_generics(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::PropositionItem = |syntax_trees|::proposition_item(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        |generic_scopes|::check_generic_names(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> proposition_parameters(resolver, sources, syntax, index, item),
            _ -> done()
        }
    }

    machine proposition_parameters(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, item: |syntax_trees|::PropositionItem) {
        |machine_signatures|::check_parameter_names(resolver, sources, syntax, item.first_parameter, item.parameter_count);
        transition { _ -> propositions(resolver, sources, syntax, index + 1) }
    }

    machine done() {}
}

// Member namespaces of each data declaration. Direct fields and cases share
// one namespace in authored order. Each case's payload fields have their own
// namespace, which the declaration's direct (common) fields also occupy.
machine check_members(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, sources, syntax, 0 as +Trapping) }

    machine next_data(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping) {
        transition data_index < syntax.data_count {
            true -> data_members(resolver, sources, syntax, data_index),
            _ -> done()
        }
    }

    machine data_members(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping) {
        let item: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, data_index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::data_scope(item);
        |generic_scopes|::check_generic_names(resolver, sources, syntax, scope);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, 0 as +Trapping),
            _ -> done()
        }
    }

    machine member(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping) {
        transition offset < item.member_count {
            true -> member_named(resolver, sources, syntax, data_index, item, offset),
            _ -> cases(resolver, sources, syntax, data_index, item, 0 as +Trapping)
        }
    }

    machine member_named(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping) {
        let data_member: |syntax_trees|::DataMember = |syntax_trees|::syntax_trees_data_member(syntax, item.first_member + offset);
        let name: |syntax_trees|::IdentifierSpan = |syntax_trees|::member_name(syntax, data_member);
        transition { _ -> member_prior(resolver, sources, syntax, data_index, item, offset, name, 0 as +Trapping) }
    }

    machine member_prior(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping, name: |syntax_trees|::IdentifierSpan, prior: u64 in Trapping) {
        transition prior < offset {
            true -> member_compare(resolver, sources, syntax, data_index, item, offset, name, prior),
            _ -> member(resolver, sources, syntax, data_index, item, offset + 1)
        }
    }

    machine member_compare(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping, name: |syntax_trees|::IdentifierSpan, prior: u64 in Trapping) {
        let prior_member: |syntax_trees|::DataMember = |syntax_trees|::syntax_trees_data_member(syntax, item.first_member + prior);
        let prior_name: |syntax_trees|::IdentifierSpan = |syntax_trees|::member_name(syntax, prior_member);
        let equal: bool = |source|::spans_equal(sources, name.source_span,
            prior_name.source_span
        );
        transition equal {
            true -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::DuplicateDataMember, name),
            _ -> member_prior(resolver, sources, syntax, data_index, item, offset, name, prior + 1)
        }
    }

    machine cases(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, case_offset: u64 in Trapping) {
        transition case_offset < item.case_count {
            true -> case_payload(resolver, sources, syntax, data_index, item, case_offset),
            _ -> next_data(resolver, sources, syntax, data_index + 1)
        }
    }

    machine case_payload(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, case_offset: u64 in Trapping) {
        let data_case: |syntax_trees|::DataCase = |syntax_trees|::syntax_trees_data_case(syntax, item.first_case + case_offset);
        transition { _ -> payload(resolver, sources, syntax, data_index, item, case_offset, data_case, 0 as +Trapping) }
    }

    machine payload(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, case_offset: u64 in Trapping, data_case: |syntax_trees|::DataCase, field_offset: u64 in Trapping) {
        transition field_offset < data_case.payload_field_count {
            true -> payload_named(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset),
            _ -> cases(resolver, sources, syntax, data_index, item, case_offset + 1)
        }
    }

    machine payload_named(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, case_offset: u64 in Trapping, data_case: |syntax_trees|::DataCase, field_offset: u64 in Trapping) {
        let field: |syntax_trees|::DataField = |syntax_trees|::syntax_trees_payload_field(syntax, data_case.first_payload_field + field_offset);
        transition { _ -> payload_prior(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, field.name, 0 as +Trapping) }
    }

    machine payload_prior(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, case_offset: u64 in Trapping, data_case: |syntax_trees|::DataCase, field_offset: u64 in Trapping, name: |syntax_trees|::IdentifierSpan, prior: u64 in Trapping) {
        transition prior < field_offset {
            true -> payload_compare(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, prior),
            _ -> common(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, 0 as +Trapping)
        }
    }

    machine payload_compare(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, case_offset: u64 in Trapping, data_case: |syntax_trees|::DataCase, field_offset: u64 in Trapping, name: |syntax_trees|::IdentifierSpan, prior: u64 in Trapping) {
        let prior_field: |syntax_trees|::DataField = |syntax_trees|::syntax_trees_payload_field(syntax, data_case.first_payload_field + prior);
        let equal: bool = |source|::spans_equal(sources, name.source_span,
            prior_field.name.source_span
        );
        transition equal {
            true -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::DuplicateCasePayloadField, name),
            _ -> payload_prior(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, prior + 1)
        }
    }

    machine common(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, case_offset: u64 in Trapping, data_case: |syntax_trees|::DataCase, field_offset: u64 in Trapping, name: |syntax_trees|::IdentifierSpan, common_offset: u64 in Trapping) {
        transition common_offset < item.field_count {
            true -> common_compare(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, common_offset),
            _ -> payload(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset + 1)
        }
    }

    machine common_compare(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, case_offset: u64 in Trapping, data_case: |syntax_trees|::DataCase, field_offset: u64 in Trapping, name: |syntax_trees|::IdentifierSpan, common_offset: u64 in Trapping) {
        let common_field: |syntax_trees|::DataField = |syntax_trees|::syntax_trees_field(syntax, item.first_field + common_offset);
        let equal: bool = |source|::spans_equal(sources, name.source_span,
            common_field.name.source_span
        );
        transition equal {
            true -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::PayloadFieldCollidesWithCommonField, name),
            _ -> common(resolver, sources, syntax, data_index, item, case_offset, data_case, field_offset, name, common_offset + 1)
        }
    }

    machine reject(resolver: @mutable |resolution_state|::Resolver, code: |symbol_resolved_trees|::ResolveDiagnosticCode, name: |syntax_trees|::IdentifierSpan) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, code, name.source_span);
    }

    machine done() {}
}
