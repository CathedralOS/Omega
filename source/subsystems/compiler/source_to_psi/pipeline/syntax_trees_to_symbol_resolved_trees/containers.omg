use representations/symbol_resolved_trees/machine_declarations.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/resolution_state.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/declarations.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/overloads.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/imports.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;

// Trait and conformance members (wiki/spec/language/conformances.md). Inside
// a trait `machine` declares a requirement (bodyless) or its default; inside
// a named conformance it declares the satisfier of the block's corresponding
// requirement. Each is a machine like any other, named through its
// container: `Trait::requirement`, `Conformance::member`. The container's
// generic parameters cover the member's signature and body, and the member's
// own shadow them. Which requirement a member fills, and whether every
// requirement is filled once, is checking's question.

// Every machine's `MachineOwner`, in machine order: a root machine keeps its
// authored owner; a member takes its container's name. Containers cover
// contiguous machine ranges, so one pass per container table places them.
public machine place_machines(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> root(resolver, syntax, 0 as +Trapping) }

    machine root(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> root_owner(resolver, syntax, index),
            _ -> traits(resolver, syntax, 0 as +Trapping)
        }
    }

    machine root_owner(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        set_machine_owner(resolver, index, |symbol_resolved_trees|::MachineOwner {
            container: item.container,
            item: 0 as +Trapping,
            has_owner: item.has_owner,
            owner: item.owner
        });
        transition { _ -> root(resolver, syntax, index + 1) }
    }

    machine traits(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.trait_count {
            true -> trait_members(resolver, syntax, index),
            _ -> conformances(resolver, syntax, 0 as +Trapping)
        }
    }

    machine trait_members(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::TraitItem = |syntax_trees|::trait_item(syntax, index);
        let container: |syntax_trees|::MachineContainer = resolver_trait_container(item.is_refinement);
        let owner: |symbol_resolved_trees|::MachineOwner = |symbol_resolved_trees|::MachineOwner {
            container: container,
            item: index,
            has_owner: true,
            owner: item.name
        };
        place_members(resolver, syntax, item.first_machine, item.machine_count, owner);
        transition { _ -> traits(resolver, syntax, index + 1) }
    }

    machine conformances(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.conformance_count {
            true -> conformance_members(resolver, syntax, index),
            _ -> done(resolver, syntax)
        }
    }

    machine conformance_members(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::ConformanceItem = |syntax_trees|::conformance_item(syntax, index);
        let owner: |symbol_resolved_trees|::MachineOwner = |symbol_resolved_trees|::MachineOwner {
            container: |syntax_trees|::MachineContainer::Conformance,
            item: index,
            has_owner: true,
            owner: item.name
        };
        place_members(resolver, syntax, item.first_machine, item.machine_count, owner);
        transition { _ -> conformances(resolver, syntax, index + 1) }
    }

    machine done(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees) {
        resolver.output.machine_owner_count = syntax.machine_count;
    }
}

// A trait's members are requirements and defaults; a transparent
// refinement's members only refine its base's requirements.
machine resolver_trait_container(is_refinement: bool) -> |syntax_trees|::MachineContainer {
    transition is_refinement {
        true -> found(|syntax_trees|::MachineContainer::Refinement),
        _ -> found(|syntax_trees|::MachineContainer::Trait)
    }

    machine found(container: |syntax_trees|::MachineContainer) -> |syntax_trees|::MachineContainer {
        container
    }
}

machine place_members(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, owner: |symbol_resolved_trees|::MachineOwner)
crashes Trap
{
    transition { _ -> next(resolver, syntax, first, count, owner, 0 as +Trapping) }

    machine next(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, owner: |symbol_resolved_trees|::MachineOwner, offset: u64 in Trapping) {
        transition offset < count {
            true -> place(resolver, syntax, first, count, owner, offset),
            _ -> done()
        }
    }

    machine place(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, owner: |symbol_resolved_trees|::MachineOwner, offset: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, first + offset);
        transition item.parent == 0 {
            true -> place_direct(resolver, syntax, first, count, owner, offset),
            false -> next(resolver, syntax, first, count, owner, offset + 1)
        }
    }

    machine place_direct(resolver: @mutable |resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, owner: |symbol_resolved_trees|::MachineOwner, offset: u64 in Trapping) {
        set_machine_owner(resolver, first + offset, owner);
        transition { _ -> next(resolver, syntax, first, count, owner, offset + 1) }
    }

    machine done() {}
}

machine set_machine_owner(resolver: @mutable |resolution_state|::Resolver, handle: u64 in Trapping, owner: |symbol_resolved_trees|::MachineOwner)
crashes Trap
{
    transition handle < 10240 {
        true -> store(resolver, handle, owner),
        _ -> invalid()
    }

    machine store(resolver: @mutable |resolution_state|::Resolver, handle: u64 in Trapping, owner: |symbol_resolved_trees|::MachineOwner) {
        resolver.output.machine_owners[handle as -Trapping] = owner;
    }

    machine invalid() {
        crash Trap;
    }
}

// A machine's type scope: its own generic parameters, then its container's.
public machine resolver_machine_scope(resolution: @|symbol_resolved_trees|::NameResolution, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope
crashes Trap
{
    let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, handle);
    let root: u64 in Trapping = lexical_root(syntax, handle);
    let owner: |symbol_resolved_trees|::MachineOwner = |symbol_resolved_trees|::machine_owner(resolution, root);
    let outer: |symbol_resolved_trees|::TypeScope = container_scope(syntax, owner);
    |symbol_resolved_trees|::TypeScope {
        lexical_machine: handle + 1,
        first_generic_parameter: item.first_generic_parameter,
        generic_parameter_count: item.generic_parameter_count,
        first_outer_parameter: outer.first_generic_parameter,
        outer_parameter_count: outer.generic_parameter_count
    }
}

// A container's own generic parameters as a scope; a root machine has none.
public machine container_scope(syntax: @|syntax_trees|::SyntaxTrees, owner: |symbol_resolved_trees|::MachineOwner) -> |symbol_resolved_trees|::TypeScope
crashes Trap
{
    |machine_declarations|::container_scope(syntax, owner)
}

// Bind name path `path` to the machine it names as a callee would, or
// reject it as unknown or ambiguous at its span.
public machine bind_machine_path(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, path: u64 in Trapping)
crashes Trap
{
    let name_path: |syntax_trees|::NamePath = |syntax_trees|::syntax_trees_name_path(syntax, path);
    let lookup: |declarations|::Lookup = machine_path_lookup(@resolver.output, sources, syntax, name_path);
    transition lookup {
        |declarations|::Lookup::Found { handle } -> bound(resolver, path, handle),
        |declarations|::Lookup::Ambiguous -> ambiguous(resolver, name_path),
        |declarations|::Lookup::Absent -> unknown(resolver, name_path)
    }

    machine bound(resolver: @mutable |resolution_state|::Resolver, path: u64 in Trapping, handle: u64 in Trapping) {
        set_path_binding(resolver, path, |symbol_resolved_trees|::PathBinding::Machine { handle: handle });
    }

    machine ambiguous(resolver: @mutable |resolution_state|::Resolver, name_path: |syntax_trees|::NamePath) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, |symbol_resolved_trees|::ResolveDiagnosticCode::AmbiguousName, name_path.source_span);
    }

    machine unknown(resolver: @mutable |resolution_state|::Resolver, name_path: |syntax_trees|::NamePath) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, |symbol_resolved_trees|::ResolveDiagnosticCode::UnknownName, name_path.source_span);
    }
}

// The machine a name path names: a free machine for one member, an owned
// machine (a trait requirement or conformance member included) for two. A
// longer path crosses a package, which this source set cannot bind.
public machine machine_path_lookup(resolution: @|symbol_resolved_trees|::NameResolution, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name_path: |syntax_trees|::NamePath) -> |declarations|::Lookup
crashes Trap
{
    transition name_path.member_count {
        1 -> free(resolution, sources, syntax, name_path),
        2 -> owned(resolution, sources, syntax, name_path),
        _ -> absent()
    }

    machine free(resolution: @|symbol_resolved_trees|::NameResolution, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name_path: |syntax_trees|::NamePath) -> |declarations|::Lookup {
        let name: |syntax_trees|::IdentifierSpan = |syntax_trees|::syntax_trees_member(syntax, name_path.first_member);
        |overloads|::machine_named(resolution, sources, syntax, false, name.source_span, name.source_span)
    }

    machine owned(resolution: @|symbol_resolved_trees|::NameResolution, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name_path: |syntax_trees|::NamePath) -> |declarations|::Lookup {
        let owner: |syntax_trees|::IdentifierSpan = |syntax_trees|::syntax_trees_member(syntax, name_path.first_member);
        let name: |syntax_trees|::IdentifierSpan = |syntax_trees|::syntax_trees_member(syntax, name_path.first_member + 1);
        |overloads|::machine_named(resolution, sources, syntax, true, owner.source_span, name.source_span)
    }

    machine absent() -> |declarations|::Lookup {
        |declarations|::Lookup::Absent
    }
}

// The first member of trait `trait_index` named `name`: its overload
// family's representative.
public machine trait_member_named(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, trait_index: u64 in Trapping, name: |source|::SourceSpan) -> |declarations|::Lookup
crashes Trap
{
    let item: |syntax_trees|::TraitItem = |syntax_trees|::trait_item(syntax, trait_index);
    transition { _ -> next(sources, syntax, item, name, 0 as +Trapping) }

    machine next(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::TraitItem, name: |source|::SourceSpan, offset: u64 in Trapping) -> |declarations|::Lookup {
        transition offset < item.machine_count {
            true -> candidate(sources, syntax, item, name, offset),
            _ -> absent()
        }
    }

    machine candidate(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::TraitItem, name: |source|::SourceSpan, offset: u64 in Trapping) -> |declarations|::Lookup {
        let member: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, item.first_machine + offset);
        let named: bool = |source|::spans_equal(sources, member.name.source_span, name);
        transition named && member.parent == 0 {
            true -> found(item.first_machine + offset),
            _ -> next(sources, syntax, item, name, offset + 1)
        }
    }

    machine found(handle: u64 in Trapping) -> |declarations|::Lookup {
        |declarations|::Lookup::Found { handle: handle }
    }

    machine absent() -> |declarations|::Lookup {
        |declarations|::Lookup::Absent
    }
}

// `Conformance::name` when the block declares no member `name`: the satisfied
// trait's requirement or default of that name. Calling it selects the
// conformance's row for the requirement
// (wiki/spec/language/conformances.md#complete-row-identity).
public machine conformance_requirement_named(
    resolution: @|symbol_resolved_trees|::NameResolution,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    owner: |source|::SourceSpan,
    name: |source|::SourceSpan
) -> |symbol_resolved_trees|::ValueBinding
crashes Trap
{
    let conformance: |declarations|::Lookup = |imports|::declared_named(sources, syntax, |declarations|::DeclarationKind::Conformance, false, owner, owner);
    transition conformance {
        |declarations|::Lookup::Found { handle } -> trait_requirement(resolution, sources, syntax, |syntax_trees|::conformance_item(syntax, handle), name),
        |declarations|::Lookup::Ambiguous -> found(|symbol_resolved_trees|::ValueBinding::Ambiguous),
        |declarations|::Lookup::Absent -> found(|symbol_resolved_trees|::ValueBinding::Unresolved)
    }

    machine trait_requirement(resolution: @|symbol_resolved_trees|::NameResolution, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, declared: |syntax_trees|::ConformanceItem, name: |source|::SourceSpan) -> |symbol_resolved_trees|::ValueBinding {
        let binding: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(resolution, declared.trait_type);
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Trait { item } -> requirement(sources, syntax, item, name),
            _ -> found(|symbol_resolved_trees|::ValueBinding::Unresolved)
        }
    }

    machine requirement(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, trait_index: u64 in Trapping, name: |source|::SourceSpan) -> |symbol_resolved_trees|::ValueBinding {
        let member: |declarations|::Lookup = trait_member_named(sources, syntax, trait_index, name);
        transition member {
            |declarations|::Lookup::Found { handle } -> found(|symbol_resolved_trees|::ValueBinding::Machine { handle: handle }),
            _ -> found(|symbol_resolved_trees|::ValueBinding::Unresolved)
        }
    }

    machine found(binding: |symbol_resolved_trees|::ValueBinding) -> |symbol_resolved_trees|::ValueBinding {
        binding
    }
}

public machine set_path_binding(resolver: @mutable |resolution_state|::Resolver, path: u64 in Trapping, binding: |symbol_resolved_trees|::PathBinding)
crashes Trap
{
    transition path < 2048 {
        true -> store(resolver, path, binding),
        _ -> invalid()
    }

    machine store(resolver: @mutable |resolution_state|::Resolver, path: u64 in Trapping, binding: |symbol_resolved_trees|::PathBinding) {
        resolver.output.path_bindings[path as -Trapping] = binding;
    }

    machine invalid() {
        crash Trap;
    }
}

// Ancestry supplies static declaration context, never invocation values.
public machine lexical_root(syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> parent(syntax, handle) }
    machine parent(syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, handle);
        transition item.parent > 0 {
            true -> parent(syntax, item.parent - 1),
            false -> handle
        }
    }
}

// Qualification can name a lexically visible nested declaration; it cannot
// open a sibling's private scope or borrow a missing same-spelled owner's member.
public machine qualified_lexical_machine(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, machine: u64 in Trapping, owner: |source|::SourceSpan, name: |source|::SourceSpan) -> |symbol_resolved_trees|::ValueBinding
crashes Trap
{
    transition { _ -> scope(sources, syntax, machine, owner, name) }
    machine scope(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, parent: u64 in Trapping, owner: |source|::SourceSpan, name: |source|::SourceSpan) -> |symbol_resolved_trees|::ValueBinding {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, parent);
        let named: bool = |source|::spans_equal(sources, item.name.source_span, owner);
        transition named {
            true -> child(sources, syntax, parent, name, 0 as +Trapping),
            false -> outer(sources, syntax, item.parent, owner, name)
        }
    }
    machine child(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, parent: u64 in Trapping, name: |source|::SourceSpan, index: u64 in Trapping) -> |symbol_resolved_trees|::ValueBinding {
        transition index < syntax.machine_count {
            true -> candidate(sources, syntax, parent, name, index),
            false -> |symbol_resolved_trees|::ValueBinding::Unresolved
        }
    }
    machine candidate(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, parent: u64 in Trapping, name: |source|::SourceSpan, index: u64 in Trapping) -> |symbol_resolved_trees|::ValueBinding {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        transition { _ -> named(sources, syntax, parent, name, index, item) }
    }
    machine named(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, parent: u64 in Trapping, name: |source|::SourceSpan, index: u64 in Trapping, item: |syntax_trees|::MachineItem) -> |symbol_resolved_trees|::ValueBinding {
        let same: bool = |source|::spans_equal(sources, item.name.source_span, name);
        transition item.parent == parent + 1 && same {
            true -> |symbol_resolved_trees|::ValueBinding::Machine { handle: index },
            false -> child(sources, syntax, parent, name, index + 1)
        }
    }
    machine outer(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, parent: u64 in Trapping, owner: |source|::SourceSpan, name: |source|::SourceSpan) -> |symbol_resolved_trees|::ValueBinding {
        transition parent > 0 {
            true -> scope(sources, syntax, parent - 1, owner, name),
            false -> |symbol_resolved_trees|::ValueBinding::Unresolved
        }
    }
}

public machine lexical_owner_visible(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, parent: u64 in Trapping, name: |source|::SourceSpan) -> bool
crashes Trap
{
    let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, parent);
    let named: bool = |source|::spans_equal(sources, item.name.source_span, name);
    transition named {
        true -> true,
        false -> outer(sources, syntax, item.parent, name)
    }
    machine outer(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, parent: u64 in Trapping, name: |source|::SourceSpan) -> bool {
        transition parent > 0 {
            true -> lexical_owner_visible(sources, syntax, parent - 1, name),
            false -> false
        }
    }
}
