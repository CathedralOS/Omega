use pipeline/syntax_trees_to_symbol_resolved_trees/resolution_state.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/containers.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/generic_scopes.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/type_names.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;

// Walk the syntax owners that supply a type reference’s lexical scope. The binding of each individual type lives in type_names.omg.

// Type references of each data declaration: its generic-parameter
// annotations, then its members' references in authored order. Every type
// reference has exactly one owner, so this walk binds the whole table.
machine bind_references(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> next_data(resolver, sources, syntax, 0 as +Trapping) }

    machine next_data(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping) {
        transition data_index < syntax.data_count {
            true -> data_references(resolver, sources, syntax, data_index),
            _ -> done()
        }
    }

    machine data_references(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping) {
        let item: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, data_index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::data_scope(item);
        |generic_scopes|::bind_generic_annotations(resolver, sources, syntax, scope, false);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, 0 as +Trapping),
            _ -> done()
        }
    }

    machine member(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping) {
        transition offset < item.member_count {
            true -> member_kind(resolver, sources, syntax, data_index, item, offset),
            _ -> next_data(resolver, sources, syntax, data_index + 1)
        }
    }

    machine member_kind(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping) {
        let data_member: |syntax_trees|::DataMember = |syntax_trees|::syntax_trees_data_member(syntax, item.first_member + offset);
        transition data_member.kind {
            |syntax_trees|::DataMemberKind::Field -> field_reference(resolver, sources, syntax, data_index, item, offset, data_member.item_index),
            |syntax_trees|::DataMemberKind::Case -> case_references(resolver, sources, syntax, data_index, item, offset, data_member.item_index)
        }
    }

    machine field_reference(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping, handle: u64 in Trapping) {
        let field: |syntax_trees|::DataField = |syntax_trees|::syntax_trees_field(syntax, handle);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::data_scope(item);
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, field.type_reference, |type_names|::TypeRole::Type);
        transition resolver.output.accepted {
            true -> member(resolver, sources, syntax, data_index, item, offset + 1),
            _ -> done()
        }
    }

    machine case_references(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping, handle: u64 in Trapping) {
        let data_case: |syntax_trees|::DataCase = |syntax_trees|::syntax_trees_data_case(syntax, handle);
        transition { _ -> payload(resolver, sources, syntax, data_index, item, offset, data_case, 0 as +Trapping) }
    }

    machine payload(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping, data_case: |syntax_trees|::DataCase, field_offset: u64 in Trapping) {
        transition field_offset < data_case.payload_field_count {
            true -> payload_reference(resolver, sources, syntax, data_index, item, offset, data_case, field_offset),
            _ -> member(resolver, sources, syntax, data_index, item, offset + 1)
        }
    }

    machine payload_reference(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, data_index: u64 in Trapping, item: |syntax_trees|::DataItem, offset: u64 in Trapping, data_case: |syntax_trees|::DataCase, field_offset: u64 in Trapping) {
        let field: |syntax_trees|::DataField = |syntax_trees|::syntax_trees_payload_field(syntax, data_case.first_payload_field + field_offset);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::data_scope(item);
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, field.type_reference, |type_names|::TypeRole::Type);
        transition resolver.output.accepted {
            true -> payload(resolver, sources, syntax, data_index, item, offset, data_case, field_offset + 1),
            _ -> done()
        }
    }

    machine done() {}
}

// Type references of every trait, conformance, constant and proposition,
// each in its declaration's scope: a trait's generic annotations and
// parents, which name traits; a conformance's generic annotations and
// satisfied trait; a constant's type; a proposition's generic annotations,
// parameter types and evidence type.
machine bind_declaration_references(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> traits(resolver, sources, syntax, 0 as +Trapping) }

    machine traits(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.trait_count && resolver.output.accepted {
            true -> trait_annotations(resolver, sources, syntax, index),
            _ -> conformances(resolver, sources, syntax, 0 as +Trapping)
        }
    }

    machine trait_annotations(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::TraitItem = |syntax_trees|::trait_item(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        |generic_scopes|::bind_generic_annotations(resolver, sources, syntax, scope, !item.is_boundary);
        transition { _ -> parents(resolver, sources, syntax, index, item, scope, 0 as +Trapping) }
    }

    machine parents(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, item: |syntax_trees|::TraitItem, scope: |symbol_resolved_trees|::TypeScope, offset: u64 in Trapping) {
        transition offset < item.parent_count && resolver.output.accepted {
            true -> parent(resolver, sources, syntax, index, item, scope, offset),
            _ -> traits(resolver, sources, syntax, index + 1)
        }
    }

    machine parent(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, item: |syntax_trees|::TraitItem, scope: |symbol_resolved_trees|::TypeScope, offset: u64 in Trapping) {
        let row: u64 in Trapping = |syntax_trees|::trait_parent(syntax, item.first_parent + offset);
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, row, |type_names|::TypeRole::Trait);
        transition { _ -> parents(resolver, sources, syntax, index, item, scope, offset + 1) }
    }

    machine conformances(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.conformance_count && resolver.output.accepted {
            true -> conformance(resolver, sources, syntax, index),
            _ -> constants(resolver, sources, syntax, 0 as +Trapping)
        }
    }

    machine conformance(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::ConformanceItem = |syntax_trees|::conformance_item(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        |generic_scopes|::bind_generic_annotations(resolver, sources, syntax, scope, false);
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, item.trait_type, |type_names|::TypeRole::Trait);
        transition { _ -> conformances(resolver, sources, syntax, index + 1) }
    }

    machine constants(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.constant_count && resolver.output.accepted {
            true -> constant(resolver, sources, syntax, index),
            _ -> propositions(resolver, sources, syntax, 0 as +Trapping)
        }
    }

    machine constant(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::ConstantItem = |syntax_trees|::constant_item(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::empty_scope();
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, item.type_reference, |type_names|::TypeRole::Type);
        transition { _ -> constants(resolver, sources, syntax, index + 1) }
    }

    machine propositions(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.proposition_count && resolver.output.accepted {
            true -> proposition(resolver, sources, syntax, index),
            _ -> done()
        }
    }

    machine proposition(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::PropositionItem = |syntax_trees|::proposition_item(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        |generic_scopes|::bind_generic_annotations(resolver, sources, syntax, scope, false);
        transition resolver.output.accepted {
            true -> proposition_signature(resolver, sources, syntax, index, item, scope),
            _ -> done()
        }
    }

    machine proposition_signature(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, item: |syntax_trees|::PropositionItem, scope: |symbol_resolved_trees|::TypeScope) {
        bind_signature(resolver, sources, syntax, scope, item.first_parameter, item.parameter_count, false, 0 as +Trapping);
        transition resolver.output.accepted && item.body == |syntax_trees|::PropositionBody::Evidence {
            true -> evidence(resolver, sources, syntax, index, item, scope),
            _ -> propositions(resolver, sources, syntax, index + 1)
        }
    }

    machine evidence(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, item: |syntax_trees|::PropositionItem, scope: |symbol_resolved_trees|::TypeScope) {
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, item.evidence, |type_names|::TypeRole::Type);
        transition { _ -> propositions(resolver, sources, syntax, index + 1) }
    }

    machine done() {}
}

// Machine signatures: each machine's generic annotations, its parameter and
// return types and its `requires machine` contracts, all in
// the machine's scope (a trait or conformance member's includes its
// container's generic parameters).
machine bind_machine_references(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> next_machine(resolver, sources, syntax, 0 as +Trapping) }

    machine next_machine(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> machine_signature(resolver, sources, syntax, index),
            _ -> done()
        }
    }

    machine machine_signature(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |containers|::resolver_machine_scope(@resolver.output, syntax, index);
        |generic_scopes|::bind_generic_annotations(resolver, sources, syntax, scope, false);
        transition resolver.output.accepted {
            true -> entry_signature(resolver, sources, syntax, index, item, scope),
            _ -> done()
        }
    }

    machine entry_signature(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        item: |syntax_trees|::MachineItem,
        scope: |symbol_resolved_trees|::TypeScope
    ) {
        bind_signature(resolver, sources, syntax, scope, item.first_parameter, item.parameter_count,
            item.has_return_type, item.return_type
        );
        transition resolver.output.accepted {
            true -> contract_signature(resolver, sources, syntax, index, item, scope, 0 as +Trapping),
            _ -> done()
        }
    }

    // Each `requires machine` contract's signature, in the machine's scope.
    machine contract_signature(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        item: |syntax_trees|::MachineItem,
        scope: |symbol_resolved_trees|::TypeScope,
        offset: u64 in Trapping
    ) {
        transition offset < item.contract_count && resolver.output.accepted {
            true -> bind_contract(resolver, sources, syntax, index, item, scope, offset),
            _ -> next_machine(resolver, sources, syntax, index + 1)
        }
    }

    machine bind_contract(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        item: |syntax_trees|::MachineItem,
        scope: |symbol_resolved_trees|::TypeScope,
        offset: u64 in Trapping
    ) {
        let written: |syntax_trees|::Contract = |syntax_trees|::syntax_trees_contract(syntax, item.first_contract + offset);
        bind_signature(resolver, sources, syntax, scope, written.first_parameter, written.parameter_count,
            written.has_return_type, written.return_type
        );
        transition { _ -> contract_signature(resolver, sources, syntax, index, item, scope, offset + 1) }
    }

    machine done() {}
}

// One signature's parameter types, then its return type when present, in
// its machine's scope.
machine bind_signature(
    resolver: @mutable |resolution_state|::Resolver,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    scope: |symbol_resolved_trees|::TypeScope,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping,
    has_return_type: bool,
    return_type: u64 in Trapping
)
crashes Trap
{
    transition { _ -> parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, 0 as +Trapping) }

    machine parameter(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        has_return_type: bool,
        return_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < parameter_count {
            true -> bind_parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, offset),
            _ -> result(resolver, sources, syntax, scope, has_return_type, return_type)
        }
    }

    machine bind_parameter(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        has_return_type: bool,
        return_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let current_parameter: |syntax_trees|::Parameter = |syntax_trees|::syntax_trees_parameter(syntax, first_parameter + offset);
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, current_parameter.type_reference, |type_names|::TypeRole::Type);
        transition resolver.output.accepted {
            true -> parameter(resolver, sources, syntax, scope, first_parameter, parameter_count, has_return_type, return_type, offset + 1),
            _ -> done()
        }
    }

    machine result(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        scope: |symbol_resolved_trees|::TypeScope,
        has_return_type: bool,
        return_type: u64 in Trapping
    ) {
        transition has_return_type {
            true -> bind_result(resolver, sources, syntax, scope, return_type),
            _ -> done()
        }
    }

    machine bind_result(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, return_type: u64 in Trapping) {
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, return_type, |type_names|::TypeRole::Type);
    }

    machine done() {}
}

// Body type references: every `let` statement's type, then every cast's
// target type and every static application's arguments, in table order. A
// machine's statements and its expressions each fill a contiguous run, and
// machines follow one another in both tables, so one pass with a cursor on
// the owning machine binds each in that machine's scope. Statements belong
// to machines only; an expression outside every machine binds in the scope
// of the declaration whose fact or value holds it (`detached_scope`).
machine bind_body_references(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> statement(resolver, sources, syntax, 0 as +Trapping, 0 as +Trapping) }

    machine statement(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition index < syntax.statement_count && resolver.output.accepted {
            true -> statement_owner(resolver, sources, syntax, index, owner),
            _ -> expressions(resolver, sources, syntax)
        }
    }

    machine statement_owner(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition owner < syntax.machine_count {
            true -> statement_in(resolver, sources, syntax, index, owner),
            _ -> invalid()
        }
    }

    machine statement_in(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, owner);
        let end: u64 in Trapping = resolver_statement_end(syntax, item);
        transition index < end {
            true -> statement_kind(resolver, sources, syntax, index, owner, item),
            _ -> statement_owner(resolver, sources, syntax, index, owner + 1)
        }
    }

    machine statement_kind(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        item: |syntax_trees|::MachineItem
    ) {
        let current_statement: |syntax_trees|::Statement = |syntax_trees|::syntax_trees_statement(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |containers|::resolver_machine_scope(@resolver.output, syntax, owner);
        transition current_statement.kind {
            |syntax_trees|::StatementKind::Let -> bind_local(resolver, sources, syntax, index, owner, scope, current_statement.type_reference),
            _ -> statement(resolver, sources, syntax, index + 1, owner)
        }
    }

    machine bind_local(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: |symbol_resolved_trees|::TypeScope,
        reference: u64 in Trapping
    ) {
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, reference, |type_names|::TypeRole::Type);
        transition { _ -> statement(resolver, sources, syntax, index + 1, owner) }
    }

    machine expressions(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees) {
        transition resolver.output.accepted {
            true -> expression(resolver, sources, syntax, 0 as +Trapping, 0 as +Trapping),
            _ -> done()
        }
    }

    machine expression(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        transition index < syntax.expression_count && resolver.output.accepted {
            true -> expression_owner(resolver, sources, syntax, index, owner),
            _ -> done()
        }
    }

    // Move the cursor past machines whose run ends at or before `index`.
    machine expression_owner(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let scope: |symbol_resolved_trees|::TypeScope = detached_scope(syntax, index);
        transition owner < syntax.machine_count {
            true -> expression_in(resolver, sources, syntax, index, owner),
            _ -> expression_kind(resolver, sources, syntax, index, owner, scope)
        }
    }

    machine expression_in(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, owner: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, owner);
        transition index < item.first_expression + item.expression_count {
            true -> expression_scope(resolver, sources, syntax, index, owner, item),
            _ -> expression_owner(resolver, sources, syntax, index, owner + 1)
        }
    }

    machine expression_scope(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        item: |syntax_trees|::MachineItem
    ) {
        let owned: |symbol_resolved_trees|::TypeScope = |containers|::resolver_machine_scope(@resolver.output, syntax, owner);
        let unowned: |symbol_resolved_trees|::TypeScope = detached_scope(syntax, index);
        transition index >= item.first_expression {
            true -> expression_kind(resolver, sources, syntax, index, owner, owned),
            _ -> expression_kind(resolver, sources, syntax, index, owner, unowned)
        }
    }

    machine expression_kind(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: |symbol_resolved_trees|::TypeScope
    ) {
        let current_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, index);
        transition current_expression.kind {
            |syntax_trees|::ExpressionKind::Cast -> cast_form(resolver, sources, syntax, index, owner, scope, current_expression),
            |syntax_trees|::ExpressionKind::Apply -> static_argument(resolver, sources, syntax, index, owner, scope, current_expression, 0 as +Trapping),
            _ -> expression(resolver, sources, syntax, index + 1, owner)
        }
    }

    // A static application's arguments are types (or integer values) listed
    // in `type_arguments`; each binds like a body type.
    machine static_argument(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: |symbol_resolved_trees|::TypeScope,
        application: |syntax_trees|::Expression,
        offset: u64 in Trapping
    ) {
        transition offset < application.count && resolver.output.accepted {
            true -> bind_static_argument(resolver, sources, syntax, index, owner, scope, application, offset),
            _ -> expression(resolver, sources, syntax, index + 1, owner)
        }
    }

    machine bind_static_argument(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: |symbol_resolved_trees|::TypeScope,
        application: |syntax_trees|::Expression,
        offset: u64 in Trapping
    ) {
        let argument: u64 in Trapping = |syntax_trees|::type_argument(syntax, application.first + offset);
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, argument, |type_names|::TypeRole::StaticArgument);
        transition { _ -> static_argument(resolver, sources, syntax, index, owner, scope, application, offset + 1) }
    }

    // A domain-only cast has no carrier type-reference row. Its zero field
    // is unused storage, not an alias for the first authored type. The
    // supported compiler-known policy name is classified at type checking;
    // other domain forms remain explicit coverage refusals there.
    machine cast_form(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: |symbol_resolved_trees|::TypeScope,
        cast: |syntax_trees|::Expression
    ) {
        transition cast.flag {
            true -> expression(resolver, sources, syntax, index + 1, owner),
            _ -> bind_cast(resolver, sources, syntax, index, owner, scope, cast.type_reference)
        }
    }

    machine bind_cast(
        resolver: @mutable |resolution_state|::Resolver,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        index: u64 in Trapping,
        owner: u64 in Trapping,
        scope: |symbol_resolved_trees|::TypeScope,
        reference: u64 in Trapping
    ) {
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, reference, |type_names|::TypeRole::Type);
        transition { _ -> expression(resolver, sources, syntax, index + 1, owner) }
    }

    // Every statement lies in a machine's run.
    machine invalid() {
        crash Trap;
    }

    machine done() {}
}

// The scope of expression `index` outside every machine: a domain's
// predicate facts see its generic parameters, a transparent proposition's
// fact its own, a data declaration's or case's `requires` facts the data's; a
// constant's value has no generic parameters. Only casts and static
// applications ask, so the scan is rare.
machine detached_scope(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope
crashes Trap
{
    transition { _ -> domain(syntax, index, 0 as +Trapping) }

    machine domain(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
        transition offset < syntax.domain_count {
            true -> domain_facts(syntax, index, offset),
            _ -> proposition(syntax, index, 0 as +Trapping)
        }
    }

    machine domain_facts(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
        let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, offset);
        let holds: bool = clauses_hold(syntax, item.first_clause, item.clause_count, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        transition holds {
            true -> found(scope),
            _ -> domain(syntax, index, offset + 1)
        }
    }

    machine proposition(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
        transition offset < syntax.proposition_count {
            true -> proposition_fact(syntax, index, offset),
            _ -> data(syntax, index, 0 as +Trapping)
        }
    }

    machine proposition_fact(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
        let item: |syntax_trees|::PropositionItem = |syntax_trees|::proposition_item(syntax, offset);
        let holds: bool = tree_holds(syntax, item.body == |syntax_trees|::PropositionBody::Transparent, item.fact, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        transition holds {
            true -> found(scope),
            _ -> proposition(syntax, index, offset + 1)
        }
    }

    machine data(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
        let empty: |symbol_resolved_trees|::TypeScope = |generic_scopes|::empty_scope();
        transition offset < syntax.data_count {
            true -> data_facts(syntax, index, offset),
            _ -> found(empty)
        }
    }

    machine data_facts(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
        let item: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, offset);
        let holds: bool = clauses_hold(syntax, item.first_clause, item.clause_count, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::data_scope(item);
        transition holds {
            true -> found(scope),
            _ -> case_facts(syntax, index, offset, item, 0 as +Trapping)
        }
    }

    machine case_facts(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, item: |syntax_trees|::DataItem, case_offset: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
        transition case_offset < item.case_count {
            true -> case_holds(syntax, index, offset, item, case_offset),
            _ -> data(syntax, index, offset + 1)
        }
    }

    machine case_holds(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, item: |syntax_trees|::DataItem, case_offset: u64 in Trapping) -> |symbol_resolved_trees|::TypeScope {
        let data_case: |syntax_trees|::DataCase = |syntax_trees|::syntax_trees_data_case(syntax, item.first_case + case_offset);
        let holds: bool = clauses_hold(syntax, data_case.first_clause, data_case.clause_count, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::data_scope(item);
        transition holds {
            true -> found(scope),
            _ -> case_facts(syntax, index, offset, item, case_offset + 1)
        }
    }

    machine found(scope: |symbol_resolved_trees|::TypeScope) -> |symbol_resolved_trees|::TypeScope {
        scope
    }
}

// Whether expression `index` lies in the fact tree of one of the clauses
// `first..first + count`.
machine clauses_hold(syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(syntax, first, count, index, 0 as +Trapping) }

    machine next(syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> clause(syntax, first, count, index, offset),
            _ -> no()
        }
    }

    machine clause(syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, index: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let fact: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, first + offset);
        let factual: bool = fact.kind == |syntax_trees|::ClauseKind::Requires || fact.kind == |syntax_trees|::ClauseKind::Ensures;
        let holds: bool = tree_holds(syntax, factual, fact.expression, index);
        transition holds {
            true -> yes(),
            _ -> next(syntax, first, count, index, offset + 1)
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Whether expression `index` lies in the tree rooted at `root`, whose rows
// run from the root's first row to the root; `present` says a tree exists.
machine tree_holds(syntax: @|syntax_trees|::SyntaxTrees, present: bool, root: u64 in Trapping, index: u64 in Trapping) -> bool
crashes Trap
{
    transition present {
        true -> run(syntax, root, index),
        _ -> no()
    }

    machine run(syntax: @|syntax_trees|::SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping) -> bool {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
        expression.first_row <= index && index <= root
    }

    machine no() -> bool {
        false
    }
}

// A declaration owns only its executable statements; descendants have independent ranges.
machine resolver_statement_end(syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem) -> u64 in Trapping {
    item.first_statement + item.statement_count
}
