use pipeline/syntax_trees_to_symbol_resolved_trees/resolution_state.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/declarations.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/containers.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/generic_scopes.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/machine_signatures.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/imports.omg;
use pipeline/syntax_trees_to_symbol_resolved_trees/type_names.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;

// Domain declarations (wiki/spec/language/domains.md). A domain is
// carrier-qualified: `domain<binders> Carrier::Name<indices>(subject)`. Its
// carrier and index arguments bind in its own generic scope before any other
// type reference, so an `in Name` qualifier anywhere can select by carrier:
// a short name selects the visible domain of that name whose carrier is the
// qualified type, where the domain's own generic parameters stand for any
// type (wiki/spec/language/modules.md#foreign-attached-declaration-paths).
// Two such candidates compete and reject as ambiguous. Alias constituents
// (`= A & C::B`) name domains the same way, a bare one by the alias's own
// carrier; establishment routes (`established by Path`) name a trait
// requirement or an exact machine as a callee would. The predicate facts and
// the subject binder belong to checking, like every other fact.

// Each domain's generic annotations, carrier and index arguments, in its
// own scope.
public machine bind_domain_carriers(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0 as +Trapping) }

    machine next(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.domain_count && resolver.output.accepted {
            true -> carrier(resolver, sources, syntax, index),
            _ -> done()
        }
    }

    machine carrier(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, index);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        |generic_scopes|::bind_generic_annotations(resolver, sources, syntax, scope, false);
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, item.carrier, |type_names|::TypeRole::Type);
        transition { _ -> argument(resolver, sources, syntax, index, item, scope, 0 as +Trapping) }
    }

    machine argument(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, item: |syntax_trees|::DomainItem, scope: |symbol_resolved_trees|::TypeScope, offset: u64 in Trapping) {
        transition offset < item.argument_count && resolver.output.accepted {
            true -> bind_argument(resolver, sources, syntax, index, item, scope, offset),
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine bind_argument(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, item: |syntax_trees|::DomainItem, scope: |symbol_resolved_trees|::TypeScope, offset: u64 in Trapping) {
        let row: u64 in Trapping = |syntax_trees|::type_argument(syntax, item.first_argument + offset);
        |type_names|::bind_type_reference(resolver, sources, syntax, scope, row, |type_names|::TypeRole::StaticArgument);
        transition { _ -> argument(resolver, sources, syntax, index, item, scope, offset + 1) }
    }

    machine done() {}
}

// Domain names: none spells a compiler-known domain, and a module declares
// one name over one carrier type once.
public machine check_domains(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0 as +Trapping) }

    machine next(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.domain_count && resolver.output.accepted {
            true -> domain(resolver, sources, syntax, index),
            _ -> done()
        }
    }

    machine domain(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, index);
        let known: |symbol_resolved_trees|::DomainBinding = known_domain(sources, item.name.source_span);
        transition known {
            |symbol_resolved_trees|::DomainBinding::Unqualified -> prior(resolver, sources, syntax, index, item, 0 as +Trapping),
            _ -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::ShadowsBuiltin, item.name)
        }
    }

    machine prior(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, item: |syntax_trees|::DomainItem, earlier: u64 in Trapping) {
        transition earlier < index {
            true -> compare(resolver, sources, syntax, index, item, earlier),
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine compare(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, item: |syntax_trees|::DomainItem, earlier: u64 in Trapping) {
        let earlier_item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, earlier);
        let named: bool = |source|::spans_equal(sources, item.name.source_span, earlier_item.name.source_span);
        let same_module: bool = |imports|::resolver_same_module(sources, item.name.source_span.source.value as -Trapping as u64 +Trapping,
            earlier_item.name.source_span.source.value as -Trapping as u64 +Trapping);
        transition named && same_module {
            true -> carriers(resolver, sources, syntax, index, item, earlier, earlier_item),
            _ -> prior(resolver, sources, syntax, index, item, earlier + 1)
        }
    }

    machine carriers(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, item: |syntax_trees|::DomainItem, earlier: u64 in Trapping, earlier_item: |syntax_trees|::DomainItem) {
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(item.first_generic_parameter, item.generic_parameter_count);
        let earlier_scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(earlier_item.first_generic_parameter, earlier_item.generic_parameter_count);
        let same: bool = |machine_signatures|::same_type(resolver, syntax, scope, item.carrier, earlier_scope, earlier_item.carrier);
        transition same {
            true -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::DuplicateDeclaration, item.name),
            _ -> prior(resolver, sources, syntax, index, item, earlier + 1)
        }
    }

    machine reject(resolver: @mutable |resolution_state|::Resolver, code: |symbol_resolved_trees|::ResolveDiagnosticCode, name: |syntax_trees|::IdentifierSpan) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, code, name.source_span);
    }

    machine done() {}
}

// The compiler-known domain a name spells, or `Unqualified`.
public machine known_domain(sources: @|source|::SourceSet, name: |source|::SourceSpan) -> |symbol_resolved_trees|::DomainBinding
crashes Trap
{
    |symbol_resolved_trees|::builtin_domain(sources, name)
}

// The declared domain `name` selects for the type whose root is row `row`:
// the one visible domain of that name whose carrier admits the type.
public machine resolver_declared_domain(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, row: u64 in Trapping, name: |source|::SourceSpan) -> |declarations|::Lookup
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, row, name, 0 as +Trapping) }

    machine next(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, row: u64 in Trapping, name: |source|::SourceSpan, index: u64 in Trapping) -> |declarations|::Lookup {
        transition index < syntax.domain_count {
            true -> candidate(resolver, sources, syntax, row, name, index),
            _ -> absent()
        }
    }

    machine candidate(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, row: u64 in Trapping, name: |source|::SourceSpan, index: u64 in Trapping) -> |declarations|::Lookup {
        let admitted: bool = domain_admits(resolver, sources, syntax, index, row, name);
        transition admitted {
            true -> rival(resolver, sources, syntax, row, name, index, index + 1),
            _ -> next(resolver, sources, syntax, row, name, index + 1)
        }
    }

    machine rival(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, row: u64 in Trapping, name: |source|::SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> |declarations|::Lookup {
        transition index < syntax.domain_count {
            true -> rival_candidate(resolver, sources, syntax, row, name, found, index),
            _ -> unique(found)
        }
    }

    machine rival_candidate(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, row: u64 in Trapping, name: |source|::SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> |declarations|::Lookup {
        let admitted: bool = domain_admits(resolver, sources, syntax, index, row, name);
        transition admitted {
            true -> ambiguous(),
            _ -> rival(resolver, sources, syntax, row, name, found, index + 1)
        }
    }

    machine unique(found: u64 in Trapping) -> |declarations|::Lookup {
        |declarations|::Lookup::Found { handle: found }
    }

    machine absent() -> |declarations|::Lookup {
        |declarations|::Lookup::Absent
    }

    machine ambiguous() -> |declarations|::Lookup {
        |declarations|::Lookup::Ambiguous
    }
}

// Whether domain `index` is named `name`, visible from it, and carried by
// the type rooted at `row`.
public machine domain_admits(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, row: u64 in Trapping, name: |source|::SourceSpan) -> bool
crashes Trap
{
    let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, index);
    let named: bool = |source|::spans_equal(sources, item.name.source_span, |imports|::member_spelling(syntax, name));
    let visible: bool = |imports|::visible_if(sources, syntax, named, name, item.name.source_span.source, item.is_public);
    transition visible {
        true -> carried(resolver, sources, syntax, item, row),
        _ -> no()
    }

    machine carried(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::DomainItem, row: u64 in Trapping) -> bool {
        carrier_matches(resolver, syntax, item, row)
    }

    machine no() -> bool {
        false
    }
}

// Whether domain `item`'s carrier is the type rooted at `actual`. Both types
// are runs listing children before parents, so walking both from their roots
// toward their first rows meets each row's children after it, in the same
// order whenever the rows agree. A carrier row naming one of the domain's
// own generic parameters stands for any type: the walk skips the whole
// subtree the actual type has in its place. No recursion or stack is needed.
public machine carrier_matches(resolver: @|resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::DomainItem, actual: u64 in Trapping) -> bool
crashes Trap
{
    let carrier_root: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, item.carrier);
    let actual_root: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, actual);
    transition { _ -> step(resolver, syntax, item, carrier_root.first_row, item.carrier + 1, actual_root.first_row, actual + 1) }

    // `carrier_end` and `actual_end` are one past the next rows to compare.
    machine step(
        resolver: @|resolution_state|::Resolver,
        syntax: @|syntax_trees|::SyntaxTrees,
        item: |syntax_trees|::DomainItem,
        carrier_first: u64 in Trapping,
        carrier_end: u64 in Trapping,
        actual_first: u64 in Trapping,
        actual_end: u64 in Trapping
    ) -> bool {
        transition carrier_end > carrier_first {
            true -> pair(resolver, syntax, item, carrier_first, carrier_end, actual_first, actual_end),
            _ -> finished(actual_first, actual_end)
        }
    }

    machine pair(
        resolver: @|resolution_state|::Resolver,
        syntax: @|syntax_trees|::SyntaxTrees,
        item: |syntax_trees|::DomainItem,
        carrier_first: u64 in Trapping,
        carrier_end: u64 in Trapping,
        actual_first: u64 in Trapping,
        actual_end: u64 in Trapping
    ) -> bool {
        transition actual_end > actual_first {
            true -> wildcard(resolver, syntax, item, carrier_first, carrier_end, actual_first, actual_end),
            _ -> different()
        }
    }

    machine wildcard(
        resolver: @|resolution_state|::Resolver,
        syntax: @|syntax_trees|::SyntaxTrees,
        item: |syntax_trees|::DomainItem,
        carrier_first: u64 in Trapping,
        carrier_end: u64 in Trapping,
        actual_first: u64 in Trapping,
        actual_end: u64 in Trapping
    ) -> bool {
        let carrier_binding: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(@resolver.output, carrier_end - 1);
        transition carrier_binding {
            |symbol_resolved_trees|::TypeBinding::GenericParameter { parameter } -> generic(resolver, syntax, item, carrier_first, carrier_end, actual_first, actual_end, parameter),
            _ -> head(resolver, syntax, item, carrier_first, carrier_end, actual_first, actual_end)
        }
    }

    machine generic(
        resolver: @|resolution_state|::Resolver,
        syntax: @|syntax_trees|::SyntaxTrees,
        item: |syntax_trees|::DomainItem,
        carrier_first: u64 in Trapping,
        carrier_end: u64 in Trapping,
        actual_first: u64 in Trapping,
        actual_end: u64 in Trapping,
        parameter: u64 in Trapping
    ) -> bool {
        let skipped: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, actual_end - 1);
        transition parameter >= item.first_generic_parameter && parameter < item.first_generic_parameter + item.generic_parameter_count {
            true -> step(resolver, syntax, item, carrier_first, carrier_end - 1, actual_first, skipped.first_row),
            _ -> head(resolver, syntax, item, carrier_first, carrier_end, actual_first, actual_end)
        }
    }

    machine head(
        resolver: @|resolution_state|::Resolver,
        syntax: @|syntax_trees|::SyntaxTrees,
        item: |syntax_trees|::DomainItem,
        carrier_first: u64 in Trapping,
        carrier_end: u64 in Trapping,
        actual_first: u64 in Trapping,
        actual_end: u64 in Trapping
    ) -> bool {
        let same: bool = same_head(resolver, syntax, carrier_end - 1, actual_end - 1);
        transition same {
            true -> step(resolver, syntax, item, carrier_first, carrier_end - 1, actual_first, actual_end - 1),
            _ -> different()
        }
    }

    machine finished(actual_first: u64 in Trapping, actual_end: u64 in Trapping) -> bool {
        actual_end == actual_first
    }

    machine different() -> bool {
        false
    }
}

// Whether two rows agree in form, access, argument count and binding,
// regardless of their own `in` qualifiers. Integer rows compare by value.
machine same_head(resolver: @|resolution_state|::Resolver, syntax: @|syntax_trees|::SyntaxTrees, left: u64 in Trapping, right: u64 in Trapping) -> bool
crashes Trap
{
    let left_row: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, left);
    let right_row: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, right);
    transition |syntax_trees|::same_type_form(syntax, left_row, right_row) {
        true -> bindings(resolver, left, right),
        _ -> different()
    }

    machine bindings(resolver: @|resolution_state|::Resolver, left: u64 in Trapping, right: u64 in Trapping) -> bool {
        same_bound_rows(@resolver.output, left, right)
    }

    machine different() -> bool {
        false
    }
}

// Whether rows `left` and `right`, of one form, bind the same declaration.
// Reference, array, slice and integer rows bind by form, which the caller
// matched; unresolved, ambiguous, trait and conformance rows name no carrier.
machine same_bound_rows(resolution: @|symbol_resolved_trees|::NameResolution, left: u64 in Trapping, right: u64 in Trapping) -> bool
crashes Trap
{
    let left_binding: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(resolution, left);
    transition left_binding {
        |symbol_resolved_trees|::TypeBinding::Builtin { builtin } -> builtin_row(resolution, builtin, right),
        |symbol_resolved_trees|::TypeBinding::Data { item } -> data_row(resolution, item, right),
        |symbol_resolved_trees|::TypeBinding::GenericParameter { parameter } -> generic_row(resolution, parameter, right),
        |symbol_resolved_trees|::TypeBinding::Reference -> answer(true),
        |symbol_resolved_trees|::TypeBinding::Array -> answer(true),
        |symbol_resolved_trees|::TypeBinding::Slice -> answer(true),
        |symbol_resolved_trees|::TypeBinding::Literal -> answer(true),
        _ -> answer(false)
    }

    machine builtin_row(resolution: @|symbol_resolved_trees|::NameResolution, left_builtin: |symbol_resolved_trees|::BuiltinType, right: u64 in Trapping) -> bool {
        let right_binding: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(resolution, right);
        transition right_binding {
            |symbol_resolved_trees|::TypeBinding::Builtin { builtin } -> answer(left_builtin == builtin),
            _ -> answer(false)
        }
    }

    machine data_row(resolution: @|symbol_resolved_trees|::NameResolution, left_item: u64 in Trapping, right: u64 in Trapping) -> bool {
        let right_binding: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(resolution, right);
        transition right_binding {
            |symbol_resolved_trees|::TypeBinding::Data { item } -> answer(left_item == item),
            _ -> answer(false)
        }
    }

    machine generic_row(resolution: @|symbol_resolved_trees|::NameResolution, left_parameter: u64 in Trapping, right: u64 in Trapping) -> bool {
        let right_binding: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(resolution, right);
        transition right_binding {
            |symbol_resolved_trees|::TypeBinding::GenericParameter { parameter } -> answer(left_parameter == parameter),
            _ -> answer(false)
        }
    }

    machine answer(same: bool) -> bool {
        same
    }
}

// Establishment routes and alias constituents, in domain order.
public machine bind_domain_paths(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, 0 as +Trapping) }

    machine next(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.domain_count && resolver.output.accepted {
            true -> routes(resolver, sources, syntax, index, 0 as +Trapping),
            _ -> done()
        }
    }

    machine routes(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) {
        let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, index);
        transition offset < item.route_count && resolver.output.accepted {
            true -> route(resolver, sources, syntax, index, offset, item.first_route + offset),
            _ -> constituents(resolver, sources, syntax, index, 0 as +Trapping)
        }
    }

    machine route(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, path: u64 in Trapping) {
        |containers|::bind_machine_path(resolver, sources, syntax, path);
        transition { _ -> routes(resolver, sources, syntax, index, offset + 1) }
    }

    machine constituents(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping) {
        let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, index);
        transition offset < item.constituent_count && resolver.output.accepted {
            true -> constituent(resolver, sources, syntax, index, offset, item, item.first_constituent + offset),
            _ -> next(resolver, sources, syntax, index + 1)
        }
    }

    machine constituent(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, item: |syntax_trees|::DomainItem, path: u64 in Trapping) {
        let name_path: |syntax_trees|::NamePath = |syntax_trees|::syntax_trees_name_path(syntax, path);
        let lookup: |declarations|::Lookup = constituent_domain(resolver, sources, syntax, item, name_path);
        transition lookup {
            |declarations|::Lookup::Found { handle } -> bound(resolver, sources, syntax, index, offset, path, handle),
            |declarations|::Lookup::Ambiguous -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::AmbiguousName, name_path),
            |declarations|::Lookup::Absent -> reject(resolver, |symbol_resolved_trees|::ResolveDiagnosticCode::UnknownDomain, name_path)
        }
    }

    machine bound(resolver: @mutable |resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, offset: u64 in Trapping, path: u64 in Trapping, handle: u64 in Trapping) {
        |containers|::set_path_binding(resolver, path, |symbol_resolved_trees|::PathBinding::Domain { item: handle });
        transition { _ -> constituents(resolver, sources, syntax, index, offset + 1) }
    }

    machine reject(resolver: @mutable |resolution_state|::Resolver, code: |symbol_resolved_trees|::ResolveDiagnosticCode, name_path: |syntax_trees|::NamePath) {
        |symbol_resolved_trees|::name_resolution_reject(@mutable resolver.output, code, name_path.source_span);
    }

    machine done() {}
}

// The domain an alias constituent names: `Name` over the alias's own
// carrier, or `Carrier::Name` over the type `Carrier` names in the alias's
// scope. A longer path crosses a package, which this source set cannot bind.
machine constituent_domain(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, alias: |syntax_trees|::DomainItem, name_path: |syntax_trees|::NamePath) -> |declarations|::Lookup
crashes Trap
{
    transition name_path.member_count {
        1 -> bare(resolver, sources, syntax, alias, name_path),
        2 -> qualified(resolver, sources, syntax, alias, name_path),
        _ -> absent()
    }

    machine bare(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, alias: |syntax_trees|::DomainItem, name_path: |syntax_trees|::NamePath) -> |declarations|::Lookup {
        let name: |syntax_trees|::IdentifierSpan = |syntax_trees|::syntax_trees_member(syntax, name_path.first_member);
        resolver_declared_domain(resolver, sources, syntax, alias.carrier, name.source_span)
    }

    machine qualified(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, alias: |syntax_trees|::DomainItem, name_path: |syntax_trees|::NamePath) -> |declarations|::Lookup {
        let carrier: |syntax_trees|::IdentifierSpan = |syntax_trees|::syntax_trees_member(syntax, name_path.first_member);
        let name: |syntax_trees|::IdentifierSpan = |syntax_trees|::syntax_trees_member(syntax, name_path.first_member + 1);
        let scope: |symbol_resolved_trees|::TypeScope = |generic_scopes|::resolver_scope(alias.first_generic_parameter, alias.generic_parameter_count);
        domain_by_head(resolver, sources, syntax, scope, carrier.source_span, name.source_span)
    }

    machine absent() -> |declarations|::Lookup {
        |declarations|::Lookup::Absent
    }
}

// The visible domain named `name` whose carrier's root binds like the type
// `carrier` names in `scope`, or is one of the domain's own generic
// parameters.
public machine domain_by_head(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, carrier: |source|::SourceSpan, name: |source|::SourceSpan) -> |declarations|::Lookup
crashes Trap
{
    transition { _ -> next(resolver, sources, syntax, scope, carrier, name, 0 as +Trapping) }

    machine next(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, carrier: |source|::SourceSpan, name: |source|::SourceSpan, index: u64 in Trapping) -> |declarations|::Lookup {
        transition index < syntax.domain_count {
            true -> candidate(resolver, sources, syntax, scope, carrier, name, index),
            _ -> absent()
        }
    }

    machine candidate(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, carrier: |source|::SourceSpan, name: |source|::SourceSpan, index: u64 in Trapping) -> |declarations|::Lookup {
        let admitted: bool = domain_head_admits(resolver, sources, syntax, index, scope, carrier, name);
        transition admitted {
            true -> rival(resolver, sources, syntax, scope, carrier, name, index, index + 1),
            _ -> next(resolver, sources, syntax, scope, carrier, name, index + 1)
        }
    }

    machine rival(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, carrier: |source|::SourceSpan, name: |source|::SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> |declarations|::Lookup {
        transition index < syntax.domain_count {
            true -> rival_candidate(resolver, sources, syntax, scope, carrier, name, found, index),
            _ -> unique(found)
        }
    }

    machine rival_candidate(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, carrier: |source|::SourceSpan, name: |source|::SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> |declarations|::Lookup {
        let admitted: bool = domain_head_admits(resolver, sources, syntax, index, scope, carrier, name);
        transition admitted {
            true -> ambiguous(),
            _ -> rival(resolver, sources, syntax, scope, carrier, name, found, index + 1)
        }
    }

    machine unique(found: u64 in Trapping) -> |declarations|::Lookup {
        |declarations|::Lookup::Found { handle: found }
    }

    machine absent() -> |declarations|::Lookup {
        |declarations|::Lookup::Absent
    }

    machine ambiguous() -> |declarations|::Lookup {
        |declarations|::Lookup::Ambiguous
    }
}

machine domain_head_admits(
    resolver: @|resolution_state|::Resolver,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    index: u64 in Trapping,
    scope: |symbol_resolved_trees|::TypeScope,
    carrier: |source|::SourceSpan,
    name: |source|::SourceSpan
) -> bool
crashes Trap
{
    let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, index);
    let named: bool = |source|::spans_equal(sources, item.name.source_span, |imports|::member_spelling(syntax, name));
    let visible: bool = |imports|::visible_if(sources, syntax, named, carrier, item.name.source_span.source, item.is_public);
    transition visible {
        true -> head(resolver, sources, syntax, item, scope, carrier),
        _ -> answer(false)
    }

    machine head(resolver: @|resolution_state|::Resolver, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, declared: |syntax_trees|::DomainItem, scope: |symbol_resolved_trees|::TypeScope, carrier: |source|::SourceSpan) -> bool {
        let own: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(@resolver.output, declared.carrier);
        transition own {
            |symbol_resolved_trees|::TypeBinding::GenericParameter { parameter } -> own_generic(declared, parameter),
            |symbol_resolved_trees|::TypeBinding::Builtin { builtin } -> builtin_carrier(sources, syntax, scope, carrier, builtin),
            |symbol_resolved_trees|::TypeBinding::Data { item } -> data_carrier(sources, syntax, scope, carrier, item),
            _ -> answer(false)
        }
    }

    // A domain's own parameters carry any type; the carrier names none here.
    machine own_generic(declared: |syntax_trees|::DomainItem, parameter: u64 in Trapping) -> bool {
        parameter >= declared.first_generic_parameter && parameter < declared.first_generic_parameter + declared.generic_parameter_count
    }

    machine builtin_carrier(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, carrier: |source|::SourceSpan, own: |symbol_resolved_trees|::BuiltinType) -> bool {
        let spelling: |source|::SourceSpan = |imports|::member_spelling(syntax, carrier);
        let named: |symbol_resolved_trees|::TypeBinding = |type_names|::type_binding(sources, syntax, scope, spelling);
        transition named {
            |symbol_resolved_trees|::TypeBinding::Builtin { builtin } -> answer(own == builtin),
            _ -> answer(false)
        }
    }

    machine data_carrier(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, carrier: |source|::SourceSpan, own: u64 in Trapping) -> bool {
        let selector: u64 in Trapping = |syntax_trees|::file_selector_at(syntax, carrier);
        transition selector > 0 {
            true -> attached(sources, syntax, carrier, own),
            false -> ordinary(sources, syntax, scope, carrier, own)
        }
    }

    // A file prefix selects the declaration of the domain. Its bound
    // carrier may itself have been imported from a different file.
    machine attached(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, carrier: |source|::SourceSpan, own: u64 in Trapping) -> bool {
        let data: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, own);
        let spelling: |source|::SourceSpan = |imports|::member_spelling(syntax, carrier);
        let named: bool = |source|::spans_equal(sources, spelling, data.name.source_span);
        let requester: u64 in Trapping = |source|::unit_package(sources, carrier.source.value as -Trapping as u64 +Trapping);
        let package: u64 in Trapping = |source|::unit_package(sources, data.name.source_span.source.value as -Trapping as u64 +Trapping);
        transition {
            !named -> false,
            requester == package -> true,
            data.is_public -> dependency(sources, requester, package, 0 as +Trapping),
            _ -> false
        }
    }

    machine dependency(sources: @|source|::SourceSet, requester: u64 in Trapping, package: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < sources.dependency_count {
            true -> edge(sources, requester, package, index),
            false -> false
        }
    }

    machine edge(sources: @|source|::SourceSet, requester: u64 in Trapping, package: u64 in Trapping, index: u64 in Trapping) -> bool {
        let row: |source|::DependencyRow = |source|::dependency_row(sources, index);
        transition row.requester == requester && row.target == package && row.scope == |source|::DependencyScope::Product {
            true -> true,
            false -> dependency(sources, requester, package, index + 1)
        }
    }

    machine ordinary(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, scope: |symbol_resolved_trees|::TypeScope, carrier: |source|::SourceSpan, own: u64 in Trapping) -> bool {
        let named: |symbol_resolved_trees|::TypeBinding = |type_names|::type_binding(sources, syntax, scope, carrier);
        transition named {
            |symbol_resolved_trees|::TypeBinding::Data { item } -> answer(own == item),
            _ -> answer(false)
        }
    }

    machine answer(admitted: bool) -> bool {
        admitted
    }
}

// The one visible domain named `name`, whatever its carrier; several are
// ambiguous until the carrier is known.
public machine domain_named(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan) -> |declarations|::Lookup
crashes Trap
{
    transition { _ -> next(sources, syntax, name, 0 as +Trapping) }

    machine next(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan, index: u64 in Trapping) -> |declarations|::Lookup {
        transition index < syntax.domain_count {
            true -> candidate(sources, syntax, name, index),
            _ -> absent()
        }
    }

    machine candidate(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan, index: u64 in Trapping) -> |declarations|::Lookup {
        let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, index);
        let named: bool = |source|::spans_equal(sources, item.name.source_span, |imports|::member_spelling(syntax, name));
        let visible: bool = |imports|::visible_if(sources, syntax, named, name, item.name.source_span.source, item.is_public);
        transition visible {
            true -> rival(sources, syntax, name, index, index + 1),
            _ -> next(sources, syntax, name, index + 1)
        }
    }

    machine rival(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> |declarations|::Lookup {
        transition index < syntax.domain_count {
            true -> rival_candidate(sources, syntax, name, found, index),
            _ -> unique(found)
        }
    }

    machine rival_candidate(sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, name: |source|::SourceSpan, found: u64 in Trapping, index: u64 in Trapping) -> |declarations|::Lookup {
        let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, index);
        let named: bool = |source|::spans_equal(sources, item.name.source_span, |imports|::member_spelling(syntax, name));
        let visible: bool = |imports|::visible_if(sources, syntax, named, name, item.name.source_span.source, item.is_public);
        transition visible {
            true -> ambiguous(),
            _ -> rival(sources, syntax, name, found, index + 1)
        }
    }

    machine unique(found: u64 in Trapping) -> |declarations|::Lookup {
        |declarations|::Lookup::Found { handle: found }
    }

    machine absent() -> |declarations|::Lookup {
        |declarations|::Lookup::Absent
    }

    machine ambiguous() -> |declarations|::Lookup {
        |declarations|::Lookup::Ambiguous
    }
}
