use representations/source_files/source.omg;

// Length and byte properties describe the decoded octets between the quotes.
public data QuotedLiteral [copy] {
    length: u64 in Trapping;
    roster: u64 in Trapping;
}

// A special leading byte restricts the legal range of its first continuation.
data Utf8 [copy] {
    case Complete;
    case NeedOne;
    case NeedTwo;
    case NeedThree;
    case AfterE0;
    case AfterED;
    case AfterF0;
    case AfterF4;
    case Invalid;
}

machine utf8_after(status: Utf8, byte: u64 in Trapping) -> Utf8 {
    transition status {
        Utf8::Complete -> lead(byte),
        Utf8::NeedOne -> accept(byte, 128 as +Trapping, 191 as +Trapping, Utf8::Complete),
        Utf8::NeedTwo -> accept(byte, 128 as +Trapping, 191 as +Trapping, Utf8::NeedOne),
        Utf8::NeedThree -> accept(byte, 128 as +Trapping, 191 as +Trapping, Utf8::NeedTwo),
        Utf8::AfterE0 -> accept(byte, 160 as +Trapping, 191 as +Trapping, Utf8::NeedOne),
        Utf8::AfterED -> accept(byte, 128 as +Trapping, 159 as +Trapping, Utf8::NeedOne),
        Utf8::AfterF0 -> accept(byte, 144 as +Trapping, 191 as +Trapping, Utf8::NeedTwo),
        Utf8::AfterF4 -> accept(byte, 128 as +Trapping, 143 as +Trapping, Utf8::NeedTwo),
        Utf8::Invalid -> Utf8::Invalid
    }

    machine lead(byte: u64 in Trapping) -> Utf8 {
        transition {
            byte < 128 -> Utf8::Complete,
            byte >= 194 && byte <= 223 -> Utf8::NeedOne,
            byte == 224 -> Utf8::AfterE0,
            byte >= 225 && byte <= 236 -> Utf8::NeedTwo,
            byte == 237 -> Utf8::AfterED,
            byte >= 238 && byte <= 239 -> Utf8::NeedTwo,
            byte == 240 -> Utf8::AfterF0,
            byte >= 241 && byte <= 243 -> Utf8::NeedThree,
            byte == 244 -> Utf8::AfterF4,
            _ -> Utf8::Invalid
        }
    }

    machine accept(byte: u64 in Trapping, low: u64 in Trapping, high: u64 in Trapping, next: Utf8) -> Utf8 {
        transition byte >= low && byte <= high { true -> next, _ -> Utf8::Invalid }
    }
}

data DecodedByte [copy] {
    value: u64 in Trapping;
    next: u64 in Trapping;
}

machine decode_byte(sources: @|source|::SourceSet, source_id: |source|::SourceId, index: u64 in Trapping) -> DecodedByte
crashes Trap
{
    let byte: u8 = |source|::source_set_byte_or_nul(sources, source_id, index);
    transition byte == 92 {
        true -> escape(sources, source_id, index),
        _ -> DecodedByte { value: byte as u64 +Trapping, next: index + 1 }
    }

    machine escape(sources: @|source|::SourceSet, source_id: |source|::SourceId, index: u64 in Trapping) -> DecodedByte {
        let kind: u8 = |source|::source_set_byte_or_nul(sources, source_id, index + 1);
        transition kind == 120 {
            true -> hex(sources, source_id, index),
            _ -> DecodedByte { value: simple_escape(kind), next: index + 2 }
        }
    }

    machine hex(sources: @|source|::SourceSet, source_id: |source|::SourceId, index: u64 in Trapping) -> DecodedByte {
        let first: u8 = |source|::source_set_byte_or_nul(sources, source_id, index + 2);
        let second: u8 = |source|::source_set_byte_or_nul(sources, source_id, index + 3);
        let high: u64 in Trapping = hex_value(first);
        let low: u64 in Trapping = hex_value(second);
        DecodedByte { value: high * 16 + low, next: index + 4 }
    }
}

public machine inspect_quoted(sources: @|source|::SourceSet, span: |source|::SourceSpan) -> QuotedLiteral
crashes Trap
{
    transition span.span.start + 2 <= span.span.end {
        true -> scan(sources, span.source, span.span.start + 1, span.span.end - 1, 0 as +Trapping, Utf8::Complete, true, true),
        _ -> finish(0 as +Trapping, Utf8::Complete, true, true)
    }

    machine scan(sources: @|source|::SourceSet, source_id: |source|::SourceId, index: u64 in Trapping, end: u64 in Trapping,
        length: u64 in Trapping, utf8: Utf8, nul_free: bool, ascii: bool) -> QuotedLiteral {
        transition index < end {
            true -> read(sources, source_id, index, end, length, utf8, nul_free, ascii),
            _ -> finish(length, utf8, nul_free, ascii)
        }
    }

    machine read(sources: @|source|::SourceSet, source_id: |source|::SourceId, index: u64 in Trapping, end: u64 in Trapping,
        length: u64 in Trapping, utf8: Utf8, nul_free: bool, ascii: bool) -> QuotedLiteral {
        let byte: DecodedByte = decode_byte(sources, source_id, index);
        let status: Utf8 = utf8_after(utf8, byte.value);
        transition { _ -> scan(sources, source_id, byte.next, end, length + 1, status, nul_free && byte.value != 0, ascii && byte.value < 128) }
    }

    machine finish(length: u64 in Trapping, utf8: Utf8, nul_free: bool, ascii: bool) -> QuotedLiteral {
        let bits: u64 in Trapping = roster_bits(utf8 == Utf8::Complete, nul_free, ascii, length != 0);
        QuotedLiteral { length: length, roster: bits }
    }
}

// The roster bits for the predicates that hold.
machine roster_bits(utf8: bool, nul_free: bool, ascii: bool, any: bool) -> u64 in Trapping
crashes Trap
{
    transition utf8 {
        true -> nul(1 as +Trapping, nul_free, ascii, any),
        _ -> nul(0 as +Trapping, nul_free, ascii, any)
    }

    machine nul(bits: u64 in Trapping, nul_free: bool, ascii: bool, any: bool) -> u64 in Trapping {
        transition nul_free {
            true -> ascii_bit(bits + 2, ascii, any),
            _ -> ascii_bit(bits, ascii, any)
        }
    }

    machine ascii_bit(bits: u64 in Trapping, ascii: bool, any: bool) -> u64 in Trapping {
        transition ascii {
            true -> any_bit(bits + 4, any),
            _ -> any_bit(bits, any)
        }
    }

    machine any_bit(bits: u64 in Trapping, any: bool) -> u64 in Trapping {
        transition any {
            true -> answer(bits + 8),
            _ -> answer(bits)
        }
    }

    machine answer(bits: u64 in Trapping) -> u64 in Trapping {
        bits
    }
}

// The byte a simple escape `\k` decodes to, as the lexer decodes it.
machine simple_escape(kind: u8) -> u64 in Trapping
crashes Trap
{
    transition kind {
        110 -> answer(10 as +Trapping),
        114 -> answer(13 as +Trapping),
        116 -> answer(9 as +Trapping),
        48 -> answer(0 as +Trapping),
        _ -> answer(kind as u64 +Trapping)
    }

    machine answer(byte: u64 in Trapping) -> u64 in Trapping {
        byte
    }
}

// The lexer has already checked the two hexadecimal digits.
machine hex_value(byte: u8) -> u64 in Trapping
crashes Trap
{
    let value: u64 in Trapping = byte as u64 +Trapping;
    transition value >= 48 && value <= 57 {
        true -> answer(value - 48),
        _ -> letter(value)
    }

    machine letter(value: u64 in Trapping) -> u64 in Trapping {
        transition value >= 97 && value <= 102 {
            true -> answer(value - 87),
            _ -> upper(value)
        }
    }

    machine upper(value: u64 in Trapping) -> u64 in Trapping {
        transition value >= 65 && value <= 70 {
            true -> answer(value - 55),
            _ -> answer(0 as +Trapping)
        }
    }

    machine answer(value: u64 in Trapping) -> u64 in Trapping {
        value
    }
}
