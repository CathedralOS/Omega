use pipeline/symbol_resolved_trees_to_typed_trees/quoted_literals.omg;
use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/tokens/numeric.omg;

// Integer literal values and anonymous integer values
// (wiki/spec/language/numeric_values.md#literal-landing-and-destinations).
// The lexer decodes each literal's base, digits and suffix once; typing
// reads that decoded row. A suffixed literal is typed at its suffix; an
// unsuffixed one is anonymous until it lands. Values stay exact: a
// magnitude past 2^64 - 1 rejects instead of wrapping.

public data LiteralValue [copy] {
    valid: bool;
    has_suffix: bool;
    suffix: |symbol_resolved_trees|::BuiltinType;
    magnitude: u64 in Wrapping;
}

// An integer literal's value and carrier, from the row the lexer decoded.
// A literal is valid when it has digits, its value fits in 64 bits and any
// suffix names a carrier.
public machine literal_value(syntax: @|syntax_trees|::SyntaxTrees, literal: u64 in Trapping) -> LiteralValue
crashes Trap
{
    let decoded: |syntax_trees|::IntegerLiteral = |syntax_trees|::syntax_trees_integer_literal(syntax, literal);
    let magnitude: u64 in Wrapping = decoded.magnitude;
    transition decoded.exact && !decoded.empty_digits {
        true -> suffix(magnitude, decoded.suffix),
        _ -> invalid()
    }

    machine suffix(magnitude: u64 in Wrapping, suffix: |numeric|::IntegerSuffix) -> LiteralValue {
        transition suffix {
            |numeric|::IntegerSuffix::None -> plain(magnitude),
            |numeric|::IntegerSuffix::U8 -> suffixed(|symbol_resolved_trees|::BuiltinType::U8, magnitude),
            |numeric|::IntegerSuffix::U16 -> suffixed(|symbol_resolved_trees|::BuiltinType::U16, magnitude),
            |numeric|::IntegerSuffix::U32 -> suffixed(|symbol_resolved_trees|::BuiltinType::U32, magnitude),
            |numeric|::IntegerSuffix::U64 -> suffixed(|symbol_resolved_trees|::BuiltinType::U64, magnitude),
            |numeric|::IntegerSuffix::I8 -> suffixed(|symbol_resolved_trees|::BuiltinType::I8, magnitude),
            |numeric|::IntegerSuffix::I16 -> suffixed(|symbol_resolved_trees|::BuiltinType::I16, magnitude),
            |numeric|::IntegerSuffix::I32 -> suffixed(|symbol_resolved_trees|::BuiltinType::I32, magnitude),
            |numeric|::IntegerSuffix::I64 -> suffixed(|symbol_resolved_trees|::BuiltinType::I64, magnitude),
            |numeric|::IntegerSuffix::Unknown -> invalid()
        }
    }

    machine plain(magnitude: u64 in Wrapping) -> LiteralValue {
        LiteralValue { valid: true, has_suffix: false, suffix: |symbol_resolved_trees|::BuiltinType::U64, magnitude: magnitude }
    }

    machine suffixed(builtin: |symbol_resolved_trees|::BuiltinType, magnitude: u64 in Wrapping) -> LiteralValue {
        LiteralValue { valid: true, has_suffix: true, suffix: builtin, magnitude: magnitude }
    }

    machine invalid() -> LiteralValue {
        LiteralValue { valid: false, has_suffix: false, suffix: |symbol_resolved_trees|::BuiltinType::U64, magnitude: 0 as +Wrapping }
    }
}

public machine quoted_length(sources: @|source|::SourceSet, span: |source|::SourceSpan) -> u64 in Trapping
crashes Trap
{
    let literal = |quoted_literals|::inspect_quoted(sources, span);
    literal.length
}

public machine quoted_roster(sources: @|source|::SourceSet, span: |source|::SourceSpan) -> u64 in Trapping
crashes Trap
{
    let literal = |quoted_literals|::inspect_quoted(sources, span);
    literal.roster
}
