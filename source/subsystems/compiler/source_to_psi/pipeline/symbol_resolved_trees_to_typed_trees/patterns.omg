use pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;

use representations/source_files/source.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Braces name a structural field roster, unlike a bare case-tag test.
// Every field resolves before this check. Distinct field names must cover
// the common fields and selected payload unless `..` opts out of drift
// checking (wiki/spec/language/patterns.md#pattern-subjects-and-bindings).
public machine validate_pattern_fields(
    typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees,
    arm: |syntax_trees|::TransitionArm, expected: u64 in Trapping
)
crashes Trap
{
    transition typer.output.accepted && arm.has_fields {
        true -> field(typer, sources, syntax, arm, expected, 0 as +Trapping),
        _ -> done()
    }

    machine field(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm, expected: u64 in Trapping, offset: u64 in Trapping) {
        transition offset < arm.field_count {
            true -> prior(typer, sources, syntax, arm, expected, offset, 0 as +Trapping),
            _ -> complete(typer, syntax, arm, expected)
        }
    }

    machine prior(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm, expected: u64 in Trapping, offset: u64 in Trapping, earlier: u64 in Trapping) {
        transition earlier < offset {
            true -> compare(typer, sources, syntax, arm, expected, offset, earlier),
            _ -> field(typer, sources, syntax, arm, expected, offset + 1)
        }
    }

    machine compare(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm, expected: u64 in Trapping, offset: u64 in Trapping, earlier: u64 in Trapping) {
        let written: |syntax_trees|::PatternField = |syntax_trees|::syntax_trees_pattern_field(syntax, arm.first_field + offset);
        let before: |syntax_trees|::PatternField = |syntax_trees|::syntax_trees_pattern_field(syntax, arm.first_field + earlier);
        let repeated: bool = |source|::spans_equal(sources, before.name.source_span, written.name.source_span);
        transition repeated {
            true -> duplicate(typer, written),
            _ -> prior(typer, sources, syntax, arm, expected, offset, earlier + 1)
        }
    }

    machine complete(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm, expected: u64 in Trapping) {
        transition !arm.has_rest && arm.field_count != expected {
            true -> missing(typer, syntax, arm),
            _ -> done()
        }
    }

    machine duplicate(typer: @mutable |typing_state|::Typer, written: |syntax_trees|::PatternField) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::DuplicatePatternField, written.source_span);
    }

    machine missing(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm) {
        let head: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.pattern);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::MissingPatternField, head.source_span);
    }

    machine done() {}
}
