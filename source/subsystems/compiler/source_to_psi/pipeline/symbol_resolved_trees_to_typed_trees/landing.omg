use pipeline/symbol_resolved_trees_to_typed_trees/admission.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;

use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Unlanded values take their type from their destination
// (wiki/spec/language/numeric_values.md: an anonymous number lands once).
// An anonymous number, an anonymous choice (a match of unlanded arms) and an
// anonymous array (a fixed-array literal of unlanded elements) have no type
// of their own. An anonymous array's type keeps its shape, its elements'
// unlanded type and its extent, so a destination of the same nesting, each
// level an array of the same extent, gives every level its type: a node
// `k` array levels below the root takes the destination with `k` levels
// peeled, and every anonymous number among the joined values lands at the
// innermost element type. Admission asks `typer_landing` whether a value
// lands and `typer_land` lands it. The unlanded nodes of a value's tree
// are exactly its matches and array literals still typed unlanded: any
// other has taken a type, and an unlanded one anywhere else, a subject or
// an operand, has been rejected.

public machine typer_unlanded(typer: @|typing_state|::Typer, handle: u64 in Trapping) -> bool
crashes Trap
{
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, handle);
    row.kind == |typed_trees|::TypeKind::AnonymousInteger || row.kind == |typed_trees|::TypeKind::AnonymousFloat
        || row.kind == |typed_trees|::TypeKind::AnonymousChoice || row.kind == |typed_trees|::TypeKind::AnonymousArray
}

// A choice or an anonymous array: an unlanded value with joined values.
public machine unlanded_join_type(typer: @|typing_state|::Typer, handle: u64 in Trapping) -> bool
crashes Trap
{
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, handle);
    row.kind == |typed_trees|::TypeKind::AnonymousChoice || row.kind == |typed_trees|::TypeKind::AnonymousArray
}

// How many anonymous array levels an unlanded type nests.
machine shape_depth(typer: @|typing_state|::Typer, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> level(typer, handle, 0 as +Trapping) }

    machine level(typer: @|typing_state|::Typer, handle: u64 in Trapping, depth: u64 in Trapping) -> u64 in Trapping {
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, handle);
        transition row.kind == |typed_trees|::TypeKind::AnonymousArray && depth < 64 {
            true -> level(typer, row.inner, depth + 1),
            _ -> found(depth)
        }
    }

    machine found(depth: u64 in Trapping) -> u64 in Trapping {
        depth
    }
}

// The element type `levels` array levels inside `destination`.
machine peeled(typer: @|typing_state|::Typer, destination: u64 in Trapping, levels: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> level(typer, destination, levels) }

    machine level(typer: @|typing_state|::Typer, handle: u64 in Trapping, remaining: u64 in Trapping) -> u64 in Trapping {
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, handle);
        transition remaining > 0 && row.kind == |typed_trees|::TypeKind::Array {
            true -> level(typer, row.inner, remaining - 1),
            _ -> found(handle)
        }
    }

    machine found(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// The innermost element type an unlanded value of type `unlanded` lands its
// numbers at, when `destination` has its shape: each anonymous array level
// an array of the same extent. Zero otherwise.
machine landing_scalar(typer: @|typing_state|::Typer, destination: u64 in Trapping, unlanded: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> level(typer, destination, unlanded, 0 as +Trapping) }

    machine level(typer: @|typing_state|::Typer, wanted: u64 in Trapping, shape: u64 in Trapping, depth: u64 in Trapping) -> u64 in Trapping {
        let shape_row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, shape);
        transition shape_row.kind == |typed_trees|::TypeKind::AnonymousArray && depth < 64 {
            true -> array_level(typer, wanted, shape_row, depth),
            _ -> found(wanted)
        }
    }

    machine array_level(typer: @|typing_state|::Typer, wanted: u64 in Trapping, shape_row: |typed_trees|::TypeRow, depth: u64 in Trapping) -> u64 in Trapping {
        let wanted_row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, wanted);
        transition wanted_row.kind == |typed_trees|::TypeKind::Array && wanted_row.length == shape_row.length
            && wanted_row.domain == |symbol_resolved_trees|::DomainBinding::Unqualified {
            true -> level(typer, wanted_row.inner, shape_row.inner, depth + 1),
            _ -> found(0 as +Trapping)
        }
    }

    machine found(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// How an unlanded value lands: `Landed`, or the first value that does not
// land and why.
public data Landing [copy] {
    admission: |admission|::Admission;
    value: u64 in Trapping;
}

// Whether the unlanded value rooted at `root` lands at `destination`.
public machine typer_landing(typer: @|typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, destination: u64 in Trapping, root: u64 in Trapping) -> Landing
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    let root_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, root);
    let scalar: u64 in Trapping = landing_scalar(typer, destination, root_type);
    transition scalar > 0 {
        true -> shaped(typer, syntax, scalar, tree.first_row, root),
        _ -> refused(|admission|::Admission::Rejected, root)
    }

    machine shaped(typer: @|typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, scalar: u64 in Trapping, low: u64 in Trapping, root: u64 in Trapping) -> Landing {
        let wanted: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, scalar);
        transition { _ -> node(typer, syntax, wanted, low, root) }
    }

    machine node(typer: @|typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, wanted: |typed_trees|::TypeRow, low: u64 in Trapping, handle: u64 in Trapping) -> Landing {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        let handle_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, handle);
        let joining: bool = unlanded_join_type(typer, handle_type);
        let values: |syntax_trees|::JoinedValues = |syntax_trees|::joined_values(expression);
        transition joining && (expression.kind == |syntax_trees|::ExpressionKind::Match || expression.kind == |syntax_trees|::ExpressionKind::Array) {
            true -> value(typer, syntax, wanted, low, handle, values, 0 as +Trapping),
            _ -> next(typer, syntax, wanted, low, handle)
        }
    }

    machine next(typer: @|typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, wanted: |typed_trees|::TypeRow, low: u64 in Trapping, handle: u64 in Trapping) -> Landing {
        transition handle > low {
            true -> node(typer, syntax, wanted, low, handle - 1),
            _ -> landed(handle)
        }
    }

    machine value(
        typer: @|typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        wanted: |typed_trees|::TypeRow,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        values: |syntax_trees|::JoinedValues,
        offset: u64 in Trapping
    ) -> Landing {
        transition offset < values.count {
            true -> number(typer, syntax, wanted, low, handle, values, offset),
            _ -> next(typer, syntax, wanted, low, handle)
        }
    }

    machine number(
        typer: @|typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        wanted: |typed_trees|::TypeRow,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        values: |syntax_trees|::JoinedValues,
        offset: u64 in Trapping
    ) -> Landing {
        let joined: u64 in Trapping = |syntax_trees|::joined_value(syntax, values, offset);
        let value_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, joined);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, value_type);
        let anonymous: bool = row.kind == |typed_trees|::TypeKind::AnonymousInteger || row.kind == |typed_trees|::TypeKind::AnonymousFloat;
        transition anonymous {
            true -> lands(typer, syntax, wanted, low, handle, values, offset, joined),
            _ -> value(typer, syntax, wanted, low, handle, values, offset + 1)
        }
    }

    machine lands(
        typer: @|typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        wanted: |typed_trees|::TypeRow,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        values: |syntax_trees|::JoinedValues,
        offset: u64 in Trapping,
        joined: u64 in Trapping
    ) -> Landing {
        let admission: |admission|::Admission = |admission|::literal_admission(typer, joined, wanted);
        transition admission == |admission|::Admission::Landed {
            true -> value(typer, syntax, wanted, low, handle, values, offset + 1),
            _ -> refused(admission, joined)
        }
    }

    machine landed(handle: u64 in Trapping) -> Landing {
        Landing { admission: |admission|::Admission::Landed, value: handle }
    }

    machine refused(admission: |admission|::Admission, value: u64 in Trapping) -> Landing {
        Landing { admission: admission, value: value }
    }
}

// Land the unlanded value rooted at `root` at `destination`, which
// `typer_landing` admits: each unlanded match or array literal, parents
// first, takes the destination peeled by its depth below the root, and each
// anonymous number among its values lands at the innermost element type.
public machine typer_land(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, destination: u64 in Trapping, root: u64 in Trapping)
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    let root_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, root);
    let scalar: u64 in Trapping = landing_scalar(typer, destination, root_type);
    let depth: u64 in Trapping = shape_depth(typer, root_type);
    transition { _ -> node(typer, syntax, destination, scalar, depth, tree.first_row, root) }

    machine node(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        destination: u64 in Trapping,
        scalar: u64 in Trapping,
        depth: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        let handle_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, handle);
        let joining: bool = unlanded_join_type(typer, handle_type);
        transition joining && (expression.kind == |syntax_trees|::ExpressionKind::Match || expression.kind == |syntax_trees|::ExpressionKind::Array) {
            true -> typed(typer, syntax, destination, scalar, depth, low, handle, expression, handle_type),
            _ -> next(typer, syntax, destination, scalar, depth, low, handle)
        }
    }

    machine typed(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        destination: u64 in Trapping,
        scalar: u64 in Trapping,
        depth: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        handle_type: u64 in Trapping
    ) {
        let own_depth: u64 in Trapping = shape_depth(typer, handle_type);
        let levels: u64 in Trapping = lesser_depth(depth, own_depth);
        let concrete: u64 in Trapping = peeled(typer, destination, levels);
        |typed_trees|::set_expression_type(@mutable typer.output, handle, concrete);
        let values: |syntax_trees|::JoinedValues = |syntax_trees|::joined_values(expression);
        transition { _ -> value(typer, syntax, destination, scalar, depth, low, handle, values, 0 as +Trapping) }
    }

    machine next(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        destination: u64 in Trapping,
        scalar: u64 in Trapping,
        depth: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        transition handle > low {
            true -> node(typer, syntax, destination, scalar, depth, low, handle - 1),
            _ -> done()
        }
    }

    machine value(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        destination: u64 in Trapping,
        scalar: u64 in Trapping,
        depth: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        values: |syntax_trees|::JoinedValues,
        offset: u64 in Trapping
    ) {
        transition offset < values.count {
            true -> number(typer, syntax, destination, scalar, depth, low, handle, values, offset),
            _ -> next(typer, syntax, destination, scalar, depth, low, handle)
        }
    }

    machine number(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        destination: u64 in Trapping,
        scalar: u64 in Trapping,
        depth: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        values: |syntax_trees|::JoinedValues,
        offset: u64 in Trapping
    ) {
        let joined: u64 in Trapping = |syntax_trees|::joined_value(syntax, values, offset);
        let value_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, joined);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, value_type);
        let anonymous: bool = row.kind == |typed_trees|::TypeKind::AnonymousInteger || row.kind == |typed_trees|::TypeKind::AnonymousFloat;
        transition anonymous {
            true -> lands(typer, syntax, destination, scalar, depth, low, handle, values, offset, joined),
            _ -> value(typer, syntax, destination, scalar, depth, low, handle, values, offset + 1)
        }
    }

    machine lands(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        destination: u64 in Trapping,
        scalar: u64 in Trapping,
        depth: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        values: |syntax_trees|::JoinedValues,
        offset: u64 in Trapping,
        joined: u64 in Trapping
    ) {
        |typed_trees|::set_expression_type(@mutable typer.output, joined, scalar);
        |typed_trees|::set_adaptation(@mutable typer.output, joined, |typed_trees|::Adaptation::Landed);
        transition { _ -> value(typer, syntax, destination, scalar, depth, low, handle, values, offset + 1) }
    }

    machine done() {}
}

// The levels between a root of `depth` array levels and a node of `own`.
machine lesser_depth(depth: u64 in Trapping, own: u64 in Trapping) -> u64 in Trapping {
    transition depth >= own {
        true -> found(depth - own),
        _ -> found(0 as +Trapping)
    }

    machine found(levels: u64 in Trapping) -> u64 in Trapping {
        levels
    }
}
