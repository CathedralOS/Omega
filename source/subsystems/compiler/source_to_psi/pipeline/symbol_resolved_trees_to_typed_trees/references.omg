use pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Every written type, row by row. A type's rows follow their children in the
// syntax table, so one pass in table order meets each row after the rows it
// names and interns it from their types and its own binding. Integer static
// arguments and array lengths use their decoded values; a named static value
// (a `const` parameter) has no value before evaluation exists and rejects.
public machine type_references(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution)
crashes Trap
{
    typer.output.reference_count = syntax.type_reference_count;
    transition { _ -> next(typer, sources, syntax, resolution, 0 as +Trapping) }

    machine next(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        transition index < typer.output.reference_count && index < 65536 && typer.output.accepted {
            true -> row(typer, sources, syntax, resolution, index),
            _ -> done()
        }
    }

    machine row(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping)
    requires index < 65536
    {
        let reference: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, index);
        let slot: u64 = index as -Trapping;
        let binding: |symbol_resolved_trees|::TypeBinding = resolution.type_bindings[slot];
        let domain: |symbol_resolved_trees|::DomainBinding = resolution.domain_bindings[slot];
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Builtin { builtin as selected_builtin } -> builtin(typer, sources, syntax, resolution, index, reference, selected_builtin, domain),
            |symbol_resolved_trees|::TypeBinding::Data { item } -> data(typer, sources, syntax, resolution, index, reference, item, domain),
            |symbol_resolved_trees|::TypeBinding::GenericParameter { parameter } -> generic(typer, sources, syntax, resolution, index, reference, parameter, domain),
            |symbol_resolved_trees|::TypeBinding::Reference -> referenced(typer, sources, syntax, resolution, index, reference),
            |symbol_resolved_trees|::TypeBinding::Array -> array(typer, sources, syntax, resolution, index, reference, domain),
            |symbol_resolved_trees|::TypeBinding::Slice -> slice(typer, sources, syntax, resolution, index, reference, domain),
            |symbol_resolved_trees|::TypeBinding::Literal -> literal(typer, sources, syntax, resolution, index, reference),
            |symbol_resolved_trees|::TypeBinding::Trait { item } -> trait_application(typer, sources, syntax, resolution, index, item),
            |symbol_resolved_trees|::TypeBinding::Machine { handle } -> application(typer, sources, syntax, resolution, index),
            |symbol_resolved_trees|::TypeBinding::Conformance { item } -> conformance_argument(typer, sources, syntax, resolution, index, reference),
            _ -> unsupported(typer, reference)
        }
    }

    // A trait application (a trait's parent, a conformance's satisfied
    // trait, an evidence binder's trait) and a static argument naming a
    // machine are not types: the row takes none, and an application's
    // arguments' rows intern as ever. Every argument must occupy the slot
    // of its declared kind, in the order the trait wrote its telescope.
    machine trait_application(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, item: u64 in Trapping) {
        |typed_trees|::set_reference_type(@mutable typer.output, index, 0 as +Trapping);
        check_trait_telescope(typer, syntax, resolution, index, item);
        transition { _ -> next(typer, sources, syntax, resolution, index + 1) }
    }

    machine application(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        |typed_trees|::set_reference_type(@mutable typer.output, index, 0 as +Trapping);
        transition { _ -> next(typer, sources, syntax, resolution, index + 1) }
    }

    // A conformance is an implementation argument only when a trait
    // application lists it. A call's static argument naming a conformance
    // stays unsupported: this typer does not yet bind a machine's separate
    // evidence telescope.
    machine conformance_argument(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, reference: |syntax_trees|::TypeReference) {
        let admitted: bool = trait_slot_argument(syntax, resolution, index);
        transition admitted {
            true -> application(typer, sources, syntax, resolution, index),
            _ -> unsupported(typer, reference)
        }
    }

    machine builtin(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        builtin: |symbol_resolved_trees|::BuiltinType,
        domain: |symbol_resolved_trees|::DomainBinding
    ) {
        let admitted: bool = domain_admitted(builtin, domain);
        let mutable row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::Builtin);
        row.builtin = builtin;
        row.domain = domain;
        row.domain_item = |symbol_resolved_trees|::name_resolution_domain_item(resolution, index);
        transition admitted {
            true -> intern(typer, sources, syntax, resolution, index, reference, row),
            _ -> domain_rejected(typer, reference)
        }
    }

    // A data type's arguments are its argument rows' types; their count must
    // match the declaration's generic parameters, lifetimes aside, which an
    // application does not spell.
    machine data(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        item: u64 in Trapping,
        domain: |symbol_resolved_trees|::DomainBinding
    ) {
        let expected: u64 in Trapping = |syntax_trees|::applied_parameter_count(syntax, item);
        transition domain == |symbol_resolved_trees|::DomainBinding::Unqualified || domain == |symbol_resolved_trees|::DomainBinding::Declared {
            true -> data_arity(typer, sources, syntax, resolution, index, reference, item, expected),
            _ -> domain_rejected(typer, reference)
        }
    }

    machine data_arity(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        item: u64 in Trapping,
        expected: u64 in Trapping
    ) {
        let first: u64 in Trapping = typer.output.types.argument_count as +Trapping;
        transition reference.argument_count == expected {
            true -> data_argument(typer, sources, syntax, resolution, index, reference, item, first, 0 as +Trapping),
            _ -> arity_rejected(typer, reference)
        }
    }

    machine data_argument(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        item: u64 in Trapping,
        first: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < reference.argument_count {
            true -> data_argument_push(typer, sources, syntax, resolution, index, reference, item, first, offset),
            _ -> data_row(typer, sources, syntax, resolution, index, reference, item, first)
        }
    }

    machine data_argument_push(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        item: u64 in Trapping,
        first: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let argument_row: u64 in Trapping = |syntax_trees|::type_argument(syntax, reference.first_argument + offset);
        let argument: u64 in Trapping = |typed_trees|::reference_type(@typer.output, argument_row);
        let kept: bool = |typed_trees|::type_table_push_argument(@mutable typer.output.types, argument);
        transition kept {
            true -> data_argument(typer, sources, syntax, resolution, index, reference, item, first, offset + 1),
            _ -> full(typer, reference)
        }
    }

    machine data_row(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        item: u64 in Trapping,
        first: u64 in Trapping
    ) {
        let mutable row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::Data);
        row.item = item;
        row.first_argument = first;
        row.argument_count = reference.argument_count;
        row.domain = |symbol_resolved_trees|::domain_binding_at(resolution, index);
        row.domain_item = |symbol_resolved_trees|::name_resolution_domain_item(resolution, index);
        transition { _ -> intern(typer, sources, syntax, resolution, index, reference, row) }
    }

    machine generic(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        parameter: u64 in Trapping,
        domain: |symbol_resolved_trees|::DomainBinding
    ) {
        let declared: |syntax_trees|::GenericParameter = |syntax_trees|::syntax_trees_generic_parameter(syntax, parameter);
        transition static_parameter_annotation(resolution, declared) {
            |symbol_resolved_trees|::TypeBinding::Trait { item } -> unsupported(typer, reference),
            _ -> generic_type(typer, sources, syntax, resolution, index, reference, parameter, domain)
        }
    }

    machine generic_type(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        parameter: u64 in Trapping,
        domain: |symbol_resolved_trees|::DomainBinding
    ) {
        let mutable row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::GenericParameter);
        row.item = parameter;
        transition domain == |symbol_resolved_trees|::DomainBinding::Unqualified {
            true -> intern(typer, sources, syntax, resolution, index, reference, row),
            _ -> domain_rejected(typer, reference)
        }
    }

    machine referenced(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference
    ) {
        let mutable row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::Reference);
        row.access = reference.access;
        row.inner = |typed_trees|::reference_type(@typer.output, reference.inner);
        transition { _ -> intern(typer, sources, syntax, resolution, index, reference, row) }
    }

    machine array(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        domain: |symbol_resolved_trees|::DomainBinding
    ) {
        let length_row: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, reference.length);
        let length: u64 in Trapping = |typed_trees|::reference_type(@typer.output, reference.length);
        let extent: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, length);
        let parameter: bool = const_parameter(syntax, extent);
        transition extent.kind == |typed_trees|::TypeKind::StaticInteger || parameter {
            true -> array_length(typer, sources, syntax, resolution, index, reference, domain),
            _ -> length_rejected(typer, length_row)
        }
    }

    machine array_length(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        domain: |symbol_resolved_trees|::DomainBinding
    ) {
        let length: u64 in Trapping = |typed_trees|::reference_type(@typer.output, reference.length);
        let mutable row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::Array);
        row.inner = |typed_trees|::reference_type(@typer.output, reference.inner);
        row.length = length;
        row.domain = domain;
        row.domain_item = |symbol_resolved_trees|::name_resolution_domain_item(resolution, index);
        let admitted: bool = collection_qualifier(domain);
        transition admitted {
            true -> intern(typer, sources, syntax, resolution, index, reference, row),
            _ -> domain_rejected(typer, reference)
        }
    }

    machine slice(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        domain: |symbol_resolved_trees|::DomainBinding
    ) {
        let mutable row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::Slice);
        row.inner = |typed_trees|::reference_type(@typer.output, reference.inner);
        row.domain = domain;
        row.domain_item = |symbol_resolved_trees|::name_resolution_domain_item(resolution, index);
        let admitted: bool = collection_qualifier(domain);
        transition admitted {
            true -> intern(typer, sources, syntax, resolution, index, reference, row),
            _ -> domain_rejected(typer, reference)
        }
    }

    machine literal(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference
    ) {
        let value: |syntax_trees|::IntegerLiteral = |syntax_trees|::syntax_trees_integer_literal(syntax, reference.literal);
        let mutable row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::StaticInteger);
        row.length = (value.magnitude as -Wrapping) as +Trapping;
        transition |syntax_trees|::static_integer_is_valid(value) {
            true -> intern(typer, sources, syntax, resolution, index, reference, row),
            _ -> literal_rejected(typer, reference)
        }
    }

    machine intern(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        reference: |syntax_trees|::TypeReference,
        row: |typed_trees|::TypeRow
    ) {
        let handle: u64 in Trapping = |typed_trees|::type_table_intern(@mutable typer.output.types, row);
        |typed_trees|::set_reference_type(@mutable typer.output, index, handle);
        transition handle > 0 {
            true -> next(typer, sources, syntax, resolution, index + 1),
            _ -> full(typer, reference)
        }
    }

    machine unsupported(typer: @mutable |typing_state|::Typer, reference: |syntax_trees|::TypeReference) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::UnsupportedTypeForm, reference.source_span);
    }

    machine domain_rejected(typer: @mutable |typing_state|::Typer, reference: |syntax_trees|::TypeReference) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::UnsupportedDomain, reference.source_span);
    }

    machine arity_rejected(typer: @mutable |typing_state|::Typer, reference: |syntax_trees|::TypeReference) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::GenericArgumentCount, reference.source_span);
    }

    machine length_rejected(typer: @mutable |typing_state|::Typer, length_row: |syntax_trees|::TypeReference) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::UnsupportedArrayLength, length_row.source_span);
    }

    machine literal_rejected(typer: @mutable |typing_state|::Typer, reference: |syntax_trees|::TypeReference) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::UnsupportedLiteral, reference.source_span);
    }

    machine full(typer: @mutable |typing_state|::Typer, reference: |syntax_trees|::TypeReference) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::TypeCapacityExceeded, reference.source_span);
    }

    machine done() {}
}

// Whether `domain` may qualify `builtin`: an arithmetic policy qualifies a
// fixed integer, `Finite` a float, a declared domain the carrier resolution
// matched it to (wiki/spec/language/domains.md#declaration-and-membership),
// and anything may stay unqualified
// (wiki/spec/language/numeric_values.md#overflow-policies). A case's implied
// domain qualifies data, never a builtin.
machine domain_admitted(builtin: |symbol_resolved_trees|::BuiltinType, domain: |symbol_resolved_trees|::DomainBinding) -> bool {
    transition domain {
        |symbol_resolved_trees|::DomainBinding::Unqualified -> yes(),
        |symbol_resolved_trees|::DomainBinding::Finite -> float(builtin),
        |symbol_resolved_trees|::DomainBinding::Declared -> yes(),
        |symbol_resolved_trees|::DomainBinding::Case -> no(),
        _ -> integer(builtin)
    }

    machine no() -> bool {
        false
    }

    machine float(builtin: |symbol_resolved_trees|::BuiltinType) -> bool {
        builtin == |symbol_resolved_trees|::BuiltinType::F32 || builtin == |symbol_resolved_trees|::BuiltinType::F64
    }

    machine integer(builtin: |symbol_resolved_trees|::BuiltinType) -> bool {
        let fixed: bool = fixed_integer(builtin);
        fixed
    }

    machine yes() -> bool {
        true
    }
}

public machine fixed_integer(builtin: |symbol_resolved_trees|::BuiltinType) -> bool {
    |symbol_resolved_trees|::fixed_integer(builtin)
}

// Whether a type row is a `const` generic parameter, the only binder an
// inline array's static extent may name
// (wiki/spec/language/generics.md#value-binders-and-const-requirements).
public machine const_parameter(syntax: @|syntax_trees|::SyntaxTrees, row: |typed_trees|::TypeRow) -> bool
crashes Trap
{
    transition row.kind == |typed_trees|::TypeKind::GenericParameter {
        true -> declared(syntax, row.item),
        _ -> no()
    }

    machine declared(syntax: @|syntax_trees|::SyntaxTrees, parameter: u64 in Trapping) -> bool {
        let generic: |syntax_trees|::GenericParameter = |syntax_trees|::syntax_trees_generic_parameter(syntax, parameter);
        generic.kind == |syntax_trees|::GenericParameterKind::Const
    }

    machine no() -> bool {
        false
    }
}

// The qualifiers an array or slice type takes: none, an arithmetic policy
// its integer or Boolean elements read under
// (wiki/spec/language/numeric_values.md), or a declared domain.
public machine collection_qualifier(domain: |symbol_resolved_trees|::DomainBinding) -> bool {
    transition domain {
        |symbol_resolved_trees|::DomainBinding::Unqualified -> yes(),
        |symbol_resolved_trees|::DomainBinding::Wrapping -> yes(),
        |symbol_resolved_trees|::DomainBinding::Saturating -> yes(),
        |symbol_resolved_trees|::DomainBinding::Trapping -> yes(),
        |symbol_resolved_trees|::DomainBinding::Declared -> yes(),
        _ -> no()
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Whether type-reference `row` is an argument of some trait application.
// The parent's binding is enough: argument rows are typed before the parent
// root, and resolution has already recorded which root is a trait.
public machine trait_slot_argument(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, row: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> parent(syntax, resolution, row, 0 as +Trapping) }

    machine parent(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, row: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < syntax.type_reference_count {
            true -> kind(syntax, resolution, row, index),
            _ -> no()
        }
    }

    machine kind(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, row: u64 in Trapping, index: u64 in Trapping) -> bool {
        let binding: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(resolution, index);
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Trait { item } -> arguments(syntax, resolution, row, index),
            _ -> parent(syntax, resolution, row, index + 1)
        }
    }

    machine arguments(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, row: u64 in Trapping, index: u64 in Trapping) -> bool {
        let reference: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, index);
        transition { _ -> argument(syntax, resolution, row, index, reference, 0 as +Trapping) }
    }

    machine argument(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, row: u64 in Trapping, index: u64 in Trapping, reference: |syntax_trees|::TypeReference, offset: u64 in Trapping) -> bool {
        transition offset < reference.argument_count {
            true -> listed(syntax, resolution, row, index, reference, offset),
            _ -> parent(syntax, resolution, row, index + 1)
        }
    }

    machine listed(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, row: u64 in Trapping, index: u64 in Trapping, reference: |syntax_trees|::TypeReference, offset: u64 in Trapping) -> bool {
        let handle: u64 in Trapping = |syntax_trees|::type_argument(syntax, reference.first_argument + offset);
        transition handle == row {
            true -> yes(),
            _ -> argument(syntax, resolution, row, index, reference, offset + 1)
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Non-lifetime binders of one telescope. Lifetimes are a separate argument run.
machine runtime_binder_count(syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(syntax, first, count, 0 as +Trapping, 0 as +Trapping) }

    machine next(syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping, counted: u64 in Trapping) -> u64 in Trapping {
        transition offset < count {
            true -> one(syntax, first, count, offset, counted),
            _ -> result(counted)
        }
    }

    machine one(syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping, counted: u64 in Trapping) -> u64 in Trapping {
        let parameter: |syntax_trees|::GenericParameter = |syntax_trees|::syntax_trees_generic_parameter(syntax, first + offset);
        transition parameter.kind == |syntax_trees|::GenericParameterKind::Lifetime {
            true -> next(syntax, first, count, offset + 1, counted),
            _ -> next(syntax, first, count, offset + 1, counted + 1)
        }
    }

    machine result(counted: u64 in Trapping) -> u64 in Trapping {
        counted
    }
}

// Whether static argument `binding` may occupy a binder of `kind`.
// An evidence slot takes a named implementation or a forwarded evidence
// binder. A type slot takes a type. A const slot takes a static integer or
// a const binder. A value slot also permits a runtime-capable value binder.
// Order is the caller's: this predicate does not search.
public machine slot_accepts(syntax: @|syntax_trees|::SyntaxTrees, kind: |syntax_trees|::GenericParameterKind, binding: |symbol_resolved_trees|::TypeBinding) -> bool
crashes Trap
{
    transition kind {
        |syntax_trees|::GenericParameterKind::Evidence -> evidence(syntax, binding),
        |syntax_trees|::GenericParameterKind::Type -> type_slot(syntax, binding),
        |syntax_trees|::GenericParameterKind::Const -> const_slot(syntax, binding),
        |syntax_trees|::GenericParameterKind::Value -> value_slot(syntax, binding),
        |syntax_trees|::GenericParameterKind::Machine -> machine_slot(syntax, binding),
        _ -> no()
    }

    machine evidence(syntax: @|syntax_trees|::SyntaxTrees, binding: |symbol_resolved_trees|::TypeBinding) -> bool {
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Conformance { item } -> yes(),
            |symbol_resolved_trees|::TypeBinding::GenericParameter { parameter } -> generic_kind(syntax, parameter, |syntax_trees|::GenericParameterKind::Evidence),
            _ -> no()
        }
    }

    machine type_slot(syntax: @|syntax_trees|::SyntaxTrees, binding: |symbol_resolved_trees|::TypeBinding) -> bool {
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Builtin { builtin } -> yes(),
            |symbol_resolved_trees|::TypeBinding::Data { item } -> yes(),
            |symbol_resolved_trees|::TypeBinding::Reference -> yes(),
            |symbol_resolved_trees|::TypeBinding::Array -> yes(),
            |symbol_resolved_trees|::TypeBinding::Slice -> yes(),
            |symbol_resolved_trees|::TypeBinding::GenericParameter { parameter } -> generic_kind(syntax, parameter, |syntax_trees|::GenericParameterKind::Type),
            _ -> no()
        }
    }

    machine const_slot(syntax: @|syntax_trees|::SyntaxTrees, binding: |symbol_resolved_trees|::TypeBinding) -> bool {
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Literal -> yes(),
            |symbol_resolved_trees|::TypeBinding::GenericParameter { parameter } -> generic_kind(syntax, parameter, |syntax_trees|::GenericParameterKind::Const),
            _ -> no()
        }
    }

    machine machine_slot(syntax: @|syntax_trees|::SyntaxTrees, binding: |symbol_resolved_trees|::TypeBinding) -> bool {
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Machine { handle } -> yes(),
            |symbol_resolved_trees|::TypeBinding::GenericParameter { parameter } -> generic_kind(syntax, parameter, |syntax_trees|::GenericParameterKind::Machine),
            _ -> no()
        }
    }

    machine value_slot(syntax: @|syntax_trees|::SyntaxTrees, binding: |symbol_resolved_trees|::TypeBinding) -> bool {
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Literal -> yes(),
            |symbol_resolved_trees|::TypeBinding::GenericParameter { parameter } -> value_parameter(syntax, parameter),
            _ -> no()
        }
    }

    machine value_parameter(syntax: @|syntax_trees|::SyntaxTrees, parameter: u64 in Trapping) -> bool {
        let declared: |syntax_trees|::GenericParameter = |syntax_trees|::syntax_trees_generic_parameter(syntax, parameter);
        declared.kind == |syntax_trees|::GenericParameterKind::Value || declared.kind == |syntax_trees|::GenericParameterKind::Const
    }

    machine generic_kind(syntax: @|syntax_trees|::SyntaxTrees, parameter: u64 in Trapping, expected: |syntax_trees|::GenericParameterKind) -> bool {
        let declared: |syntax_trees|::GenericParameter = |syntax_trees|::syntax_trees_generic_parameter(syntax, parameter);
        declared.kind == expected
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Match one trait application's arguments to its authored telescope.
// Lifetimes are not in this argument run. A short or long run rejects as a
// count; a run of the right length with a binder in the wrong category
// rejects at that argument.
public machine check_trait_telescope(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, item: u64 in Trapping)
crashes Trap
{
    let reference: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, index);
    let declared: |syntax_trees|::TraitItem = |syntax_trees|::trait_item(syntax, item);
    let expected: u64 in Trapping = runtime_binder_count(syntax, declared.first_generic_parameter, declared.generic_parameter_count);
    transition reference.argument_count == expected {
        true -> parameter(typer, syntax, resolution, declared, reference, 0 as +Trapping, 0 as +Trapping),
        _ -> count_rejected(typer, reference)
    }

    machine parameter(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, declared: |syntax_trees|::TraitItem, reference: |syntax_trees|::TypeReference, offset: u64 in Trapping, position: u64 in Trapping) {
        transition offset < declared.generic_parameter_count && typer.output.accepted {
            true -> kind(typer, syntax, resolution, declared, reference, offset, position),
            _ -> done()
        }
    }

    machine kind(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, declared: |syntax_trees|::TraitItem, reference: |syntax_trees|::TypeReference, offset: u64 in Trapping, position: u64 in Trapping) {
        let current_parameter: |syntax_trees|::GenericParameter = |syntax_trees|::syntax_trees_generic_parameter(syntax, declared.first_generic_parameter + offset);
        transition current_parameter.kind {
            |syntax_trees|::GenericParameterKind::Lifetime -> parameter(typer, syntax, resolution, declared, reference, offset + 1, position),
            _ -> slot(typer, syntax, resolution, declared, reference, offset, position, current_parameter)
        }
    }

    machine slot(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, declared: |syntax_trees|::TraitItem, reference: |syntax_trees|::TypeReference, offset: u64 in Trapping, position: u64 in Trapping, parameter: |syntax_trees|::GenericParameter) {
        transition position < reference.argument_count {
            true -> classify(typer, syntax, resolution, declared, reference, offset, position, parameter),
            _ -> count_rejected(typer, reference)
        }
    }

    machine classify(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, declared: |syntax_trees|::TraitItem, reference: |syntax_trees|::TypeReference, offset: u64 in Trapping, position: u64 in Trapping, current_parameter: |syntax_trees|::GenericParameter) {
        let argument: u64 in Trapping = |syntax_trees|::type_argument(syntax, reference.first_argument + position);
        let binding: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(resolution, argument);
        let fits: bool = trait_slot_accepts(syntax, resolution, current_parameter, argument, binding);
        transition fits {
            true -> parameter(typer, syntax, resolution, declared, reference, offset + 1, position + 1),
            _ -> slot_rejected(typer, syntax, argument)
        }
    }

    machine slot_rejected(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, argument: u64 in Trapping) {
        let row: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, argument);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::UnsupportedTypeForm, row.source_span);
    }

    machine count_rejected(typer: @mutable |typing_state|::Typer, reference: |syntax_trees|::TypeReference) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::GenericArgumentCount, reference.source_span);
    }

    machine done() {}
}

// Resolution gives a typed static parameter its annotation's identity. A
// parameter describing an implementation supplies no runtime value type.
machine static_parameter_annotation(resolution: @|symbol_resolved_trees|::NameResolution, parameter: |syntax_trees|::GenericParameter) -> |symbol_resolved_trees|::TypeBinding
crashes Trap
{
    transition parameter.kind == |syntax_trees|::GenericParameterKind::Const && parameter.has_type_reference {
        true -> read(resolution, parameter.type_reference),
        _ -> absent()
    }
    machine read(resolution: @|symbol_resolved_trees|::NameResolution, row: u64 in Trapping) -> |symbol_resolved_trees|::TypeBinding { |symbol_resolved_trees|::type_binding_at(resolution, row) }
    machine absent() -> |symbol_resolved_trees|::TypeBinding { |symbol_resolved_trees|::TypeBinding::Unresolved }
}

// Match a closed implementation to the exact trait required by this slot.
// An applied or forwarded map needs substitution evidence of its own.
machine trait_slot_accepts(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, parameter: |syntax_trees|::GenericParameter, argument: u64 in Trapping, binding: |symbol_resolved_trees|::TypeBinding) -> bool
crashes Trap
{
    transition static_parameter_annotation(resolution, parameter) {
        |symbol_resolved_trees|::TypeBinding::Trait { item } -> contract(syntax, resolution, parameter.type_reference, item, argument, binding),
        _ -> ordinary(syntax, parameter.kind, binding)
    }
    machine ordinary(syntax: @|syntax_trees|::SyntaxTrees, kind: |syntax_trees|::GenericParameterKind, binding: |symbol_resolved_trees|::TypeBinding) -> bool {
        slot_accepts(syntax, kind, binding)
    }
    machine contract(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, required: u64 in Trapping, item: u64 in Trapping, argument: u64 in Trapping, binding: |symbol_resolved_trees|::TypeBinding) -> bool {
        let trait_definition: |syntax_trees|::TraitItem = |syntax_trees|::trait_item(syntax, item);
        transition trait_definition.generic_parameter_count == 0 && plain_static_name(syntax, required) && plain_static_name(syntax, argument) {
            true -> selected(syntax, resolution, item, binding),
            _ -> no()
        }
    }
    machine selected(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, expected: u64 in Trapping, binding: |symbol_resolved_trees|::TypeBinding) -> bool {
        transition binding {
            |symbol_resolved_trees|::TypeBinding::Conformance { item } -> declaration(syntax, resolution, expected, item),
            _ -> no()
        }
    }
    machine declaration(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, expected: u64 in Trapping, item: u64 in Trapping) -> bool {
        let selected: |syntax_trees|::ConformanceItem = |syntax_trees|::conformance_item(syntax, item);
        transition selected.generic_parameter_count == 0 && plain_static_name(syntax, selected.trait_type) {
            true -> identity(resolution, expected, selected.trait_type),
            _ -> no()
        }
    }
    machine identity(resolution: @|symbol_resolved_trees|::NameResolution, expected: u64 in Trapping, supplied: u64 in Trapping) -> bool {
        let actual: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::type_binding_at(resolution, supplied);
        transition actual {
            |symbol_resolved_trees|::TypeBinding::Trait { item } -> same(expected, item),
            _ -> no()
        }
    }
    machine same(expected: u64 in Trapping, actual: u64 in Trapping) -> bool { expected == actual }
    machine no() -> bool { false }
}

machine plain_static_name(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) -> bool
crashes Trap
{
    let row: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, index);
    row.kind == |syntax_trees|::TypeReferenceKind::Named && row.argument_count == 0 && row.lifetime_count == 0 && !row.has_domain
}
