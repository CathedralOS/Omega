use pipeline/symbol_resolved_trees_to_typed_trees/calls.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/generics.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Static machine binders (wiki/spec/language/generics.md, Static machine
// binder categories). A `machine F` binder with a `requires machine F(...)`
// contract is called through that contract: its arguments meet the
// contract's parameters and the call has the contract's result. A call of
// a generic machine supplies each machine binder a static argument naming
// a machine or forwarding a binder of the caller's; static arguments match
// binders by kind, machines to machine binders and types to the others,
// each in order. The argument must have its binder's contract signature
// under the call's bindings, and the contract may bind the callee's other
// generic parameters from it (`U` of `map<T, U, machine F>` from `F`'s
// result). A generic machine as an argument is not supported yet.

// A callable signature: a contract's or a machine's parameters and result.
public data CallableSignature [copy] {
    present: bool;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    has_return_type: bool;
    return_type: u64 in Trapping;
}

// Whether a machine binder's argument selects a machine.
public machine selects_machine_argument(argument: |symbol_resolved_trees|::MachineArgument) -> bool {
    transition argument {
        |symbol_resolved_trees|::MachineArgument::Absent -> no(),
        _ -> yes()
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

public machine bind_machine(typer: @mutable |typing_state|::Typer, parameter: u64 in Trapping, argument: |symbol_resolved_trees|::MachineArgument)
crashes Trap
{
    transition parameter < 256 {
        true -> write(typer, parameter, argument),
        _ -> invalid()
    }

    machine write(typer: @mutable |typing_state|::Typer, parameter: u64 in Trapping, argument: |symbol_resolved_trees|::MachineArgument)
    requires parameter < 256
    {
        typer.machine_bound[parameter as -Trapping] = argument;
        typer.machine_stamps[parameter as -Trapping] = typer.binding_generation as u64;
    }

    machine invalid() {
        crash Trap;
    }
}

// The argument bound to machine binder `parameter` in the live set.
public machine machine_bound(typer: @|typing_state|::Typer, parameter: u64 in Trapping) -> |symbol_resolved_trees|::MachineArgument
crashes Trap
{
    transition parameter < 256 {
        true -> read(typer, parameter),
        _ -> absent()
    }

    machine read(typer: @|typing_state|::Typer, parameter: u64 in Trapping) -> |symbol_resolved_trees|::MachineArgument
    requires parameter < 256
    {
        let stamp: u64 = typer.machine_stamps[parameter as -Trapping];
        transition stamp == typer.binding_generation {
            true -> live(typer, parameter),
            _ -> absent()
        }
    }

    machine live(typer: @|typing_state|::Typer, parameter: u64 in Trapping) -> |symbol_resolved_trees|::MachineArgument
    requires parameter < 256
    {
        typer.machine_bound[parameter as -Trapping]
    }

    machine absent() -> |symbol_resolved_trees|::MachineArgument {
        |symbol_resolved_trees|::MachineArgument::Absent
    }
}

// The callable contract of machine binder `parameter`, when it has one.
public machine binder_signature(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, parameter: u64 in Trapping) -> CallableSignature
crashes Trap
{
    let contract: |symbol_resolved_trees|::BinderContract = |symbol_resolved_trees|::binder_contract(resolution, parameter);
    transition contract.present {
        true -> written(syntax, contract.contract),
        _ -> none()
    }

    machine written(syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) -> CallableSignature {
        let declared: |syntax_trees|::Contract = |syntax_trees|::syntax_trees_contract(syntax, handle);
        CallableSignature {
            present: true,
            first_parameter: declared.first_parameter,
            parameter_count: declared.parameter_count,
            has_return_type: declared.has_return_type,
            return_type: declared.return_type
        }
    }

    machine none() -> CallableSignature {
        CallableSignature { present: false, first_parameter: 0 as +Trapping, parameter_count: 0 as +Trapping, has_return_type: false, return_type: 0 as +Trapping }
    }
}

// A machine argument's signature: a declared non-generic machine's own, a
// forwarded binder's contract.
public machine argument_signature(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, argument: |symbol_resolved_trees|::MachineArgument) -> CallableSignature
crashes Trap
{
    transition argument {
        |symbol_resolved_trees|::MachineArgument::Declared { machine } -> declared(syntax, machine),
        |symbol_resolved_trees|::MachineArgument::Forwarded { parameter } -> forwarded(syntax, resolution, parameter),
        _ -> none()
    }

    machine declared(syntax: @|syntax_trees|::SyntaxTrees, machine: u64 in Trapping) -> CallableSignature {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, machine);
        transition item.generic_parameter_count == 0 {
            true -> signature(item),
            _ -> none()
        }
    }

    machine signature(item: |syntax_trees|::MachineItem) -> CallableSignature {
        CallableSignature {
            present: true,
            first_parameter: item.first_parameter,
            parameter_count: item.parameter_count,
            has_return_type: item.has_return_type,
            return_type: item.return_type
        }
    }

    machine forwarded(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, parameter: u64 in Trapping) -> CallableSignature {
        let signature: CallableSignature = binder_signature(syntax, resolution, parameter);
        signature
    }

    machine none() -> CallableSignature {
        CallableSignature { present: false, first_parameter: 0 as +Trapping, parameter_count: 0 as +Trapping, has_return_type: false, return_type: 0 as +Trapping }
    }
}

// A signature's result type: its declared type, else Unit.
public machine signature_result(typer: @|typing_state|::Typer, signature: CallableSignature) -> u64 in Trapping
crashes Trap
{
    let result: u64 in Trapping = |typing_state|::declared_result(typer, signature.has_return_type, signature.return_type, typer.output.unit);
    result
}

// A signature parameter's declared type.
public machine signature_parameter(typer: @|typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, signature: CallableSignature, offset: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let parameter: |syntax_trees|::Parameter = |syntax_trees|::syntax_trees_parameter(syntax, signature.first_parameter + offset);
    let handle: u64 in Trapping = |typed_trees|::reference_type(@typer.output, parameter.type_reference);
    handle
}

// Unify each machine binder's contract in `first .. first + count` with its
// bound argument's signature, binding the callee's other generic
// parameters the contract names.
public machine unify_machine_arguments(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, first: u64 in Trapping, count: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(typer, syntax, resolution, first, count, 0 as +Trapping) }

    machine next(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) {
        transition offset < count {
            true -> binder(typer, syntax, resolution, first, count, offset),
            _ -> done()
        }
    }

    machine binder(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) {
        let generic: |syntax_trees|::GenericParameter = |syntax_trees|::syntax_trees_generic_parameter(syntax, first + offset);
        let contract: CallableSignature = binder_signature(syntax, resolution, first + offset);
        let argument: |symbol_resolved_trees|::MachineArgument = machine_bound(typer, first + offset);
        let signature: CallableSignature = argument_signature(syntax, resolution, argument);
        transition generic.kind == |syntax_trees|::GenericParameterKind::Machine && contract.present && signature.present
            && contract.parameter_count == signature.parameter_count {
            true -> parameter(typer, syntax, resolution, first, count, offset, contract, signature, 0 as +Trapping),
            _ -> next(typer, syntax, resolution, first, count, offset + 1)
        }
    }

    machine parameter(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature,
        index: u64 in Trapping
    ) {
        transition index < contract.parameter_count {
            true -> unified(typer, syntax, resolution, first, count, offset, contract, signature, index),
            _ -> result(typer, syntax, resolution, first, count, offset, contract, signature)
        }
    }

    machine unified(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature,
        index: u64 in Trapping
    ) {
        let wanted: u64 in Trapping = signature_parameter(typer, syntax, contract, index);
        let given: u64 in Trapping = signature_parameter(typer, syntax, signature, index);
        |generics|::typer_unify(typer, first, count, wanted, given);
        transition { _ -> parameter(typer, syntax, resolution, first, count, offset, contract, signature, index + 1) }
    }

    machine result(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature
    ) {
        let wanted: u64 in Trapping = signature_result(typer, contract);
        let given: u64 in Trapping = signature_result(typer, signature);
        |generics|::typer_unify(typer, first, count, wanted, given);
        transition { _ -> next(typer, syntax, resolution, first, count, offset + 1) }
    }

    machine done() {}
}

// Whether every machine binder in `first .. first + count` has a contract
// and an argument with exactly that signature under the live bindings:
// the same arity, and each parameter and the result equal once the
// contract's types are substituted.
public machine machine_arguments_refine(
    typer: @mutable |typing_state|::Typer,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    first: u64 in Trapping,
    count: u64 in Trapping,
    source_span: |source|::SourceSpan
) -> bool
crashes Trap
{
    transition { _ -> next(typer, syntax, resolution, first, count, source_span, 0 as +Trapping) }

    machine next(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, first: u64 in Trapping, count: u64 in Trapping, source_span: |source|::SourceSpan, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> binder(typer, syntax, resolution, first, count, source_span, offset),
            _ -> refined()
        }
    }

    machine binder(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, first: u64 in Trapping, count: u64 in Trapping, source_span: |source|::SourceSpan, offset: u64 in Trapping) -> bool {
        let generic: |syntax_trees|::GenericParameter = |syntax_trees|::syntax_trees_generic_parameter(syntax, first + offset);
        transition generic.kind == |syntax_trees|::GenericParameterKind::Machine {
            true -> machine(typer, syntax, resolution, first, count, source_span, offset),
            _ -> next(typer, syntax, resolution, first, count, source_span, offset + 1)
        }
    }

    machine machine(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, first: u64 in Trapping, count: u64 in Trapping, source_span: |source|::SourceSpan, offset: u64 in Trapping) -> bool {
        let contract: CallableSignature = binder_signature(syntax, resolution, first + offset);
        let argument: |symbol_resolved_trees|::MachineArgument = machine_bound(typer, first + offset);
        let signature: CallableSignature = argument_signature(syntax, resolution, argument);
        transition contract.present && signature.present && contract.parameter_count == signature.parameter_count {
            true -> parameter(typer, syntax, resolution, first, count, source_span, offset, contract, signature, 0 as +Trapping),
            _ -> unrefined()
        }
    }

    machine parameter(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        source_span: |source|::SourceSpan,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature,
        index: u64 in Trapping
    ) -> bool {
        transition index < contract.parameter_count {
            true -> compared(typer, syntax, resolution, first, count, source_span, offset, contract, signature, index),
            _ -> result(typer, syntax, resolution, first, count, source_span, offset, contract, signature)
        }
    }

    machine compared(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        source_span: |source|::SourceSpan,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature,
        index: u64 in Trapping
    ) -> bool {
        let wanted: u64 in Trapping = signature_parameter(typer, syntax, contract, index);
        let substituted: u64 in Trapping = |generics|::substitute_bound(typer, wanted, source_span);
        let given: u64 in Trapping = signature_parameter(typer, syntax, signature, index);
        transition substituted == given {
            true -> parameter(typer, syntax, resolution, first, count, source_span, offset, contract, signature, index + 1),
            _ -> unrefined()
        }
    }

    machine result(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        first: u64 in Trapping,
        count: u64 in Trapping,
        source_span: |source|::SourceSpan,
        offset: u64 in Trapping,
        contract: CallableSignature,
        signature: CallableSignature
    ) -> bool {
        let wanted: u64 in Trapping = signature_result(typer, contract);
        let substituted: u64 in Trapping = |generics|::substitute_bound(typer, wanted, source_span);
        let given: u64 in Trapping = signature_result(typer, signature);
        transition substituted == given {
            true -> next(typer, syntax, resolution, first, count, source_span, offset + 1),
            _ -> unrefined()
        }
    }

    machine refined() -> bool {
        true
    }

    machine unrefined() -> bool {
        false
    }
}

// A call of machine binder `parameter`: its arguments meet its contract's
// parameters and the call has the contract's result. A binder without a
// contract cannot be called.
public machine type_binder_call(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, expression: |syntax_trees|::Expression, parameter: u64 in Trapping)
crashes Trap
{
    let contract: CallableSignature = binder_signature(syntax, resolution, parameter);
    transition contract.present {
        true -> counted(typer, syntax, index, expression, parameter, contract),
        _ -> not_callable(typer, syntax, expression)
    }

    machine counted(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, expression: |syntax_trees|::Expression, parameter: u64 in Trapping, contract: CallableSignature) {
        transition contract.parameter_count == expression.count {
            true -> called(typer, syntax, index, expression, parameter, contract),
            _ -> reject(typer, expression, |typed_trees|::TypeDiagnosticCode::NoMatchingMachine)
        }
    }

    machine called(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, expression: |syntax_trees|::Expression, parameter: u64 in Trapping, contract: CallableSignature) {
        let result: u64 in Trapping = signature_result(typer, contract);
        |typed_trees|::set_selection(@mutable typer.output, index, |typed_trees|::Selection::Binder { parameter: parameter });
        |typed_trees|::set_expression_type(@mutable typer.output, index, result);
        |calls|::bind_arguments(typer, syntax, expression, contract.first_parameter, false, 0 as +Trapping);
    }

    machine not_callable(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, expression: |syntax_trees|::Expression) {
        let callee: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, expression.left);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::NotCallable, callee.source_span);
    }

    machine reject(typer: @mutable |typing_state|::Typer, expression: |syntax_trees|::Expression, code: |typed_trees|::TypeDiagnosticCode) {
        |typed_trees|::typing_reject(@mutable typer.output, code, expression.source_span);
    }
}
