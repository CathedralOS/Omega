use pipeline/symbol_resolved_trees_to_typed_trees/admission.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/calls.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/coverage.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/expressions.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/patterns.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// One body's statements in authored order. A `let` initializer meets its
// declared type, an assignment its place's, and a final unterminated
// expression the body's result. A non-Unit result cannot be silently
// discarded: an expression statement's value is Unit (or `Never`), and the
// intentional discard `_ = call();` drops a call's result
// (wiki/spec/language/effects.md). A transition's case arm binds its payload
// binders before its target types; each callee's arguments meet its
// parameters, a terminal machine call's result the body's result, and `-> {}`
// completes a unit body (wiki/spec/language/state_contracts.md). Its arms
// cover its subject (coverage.omg).
public machine type_body(
    typer: @mutable |typing_state|::Typer,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    first_statement: u64 in Trapping,
    statement_count: u64 in Trapping,
    result: u64 in Trapping
)
crashes Trap
{
    transition { _ -> next(typer, sources, syntax, resolution, first_statement, first_statement + statement_count, result) }

    machine next(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, result: u64 in Trapping) {
        transition index < end && typer.output.accepted {
            true -> statement(typer, sources, syntax, resolution, index, end, result),
            _ -> done()
        }
    }

    machine statement(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, result: u64 in Trapping) {
        type_statement(typer, sources, syntax, resolution, index, result);
        transition { _ -> next(typer, sources, syntax, resolution, index + 1, end, result) }
    }

    machine done() {}
}

// An executable declaration that reaches its end completes with Unit. A
// terminal statement or a Never expression has no fallthrough completion.
// Bodyless signatures make no executable completion claim.
public machine require_body_completion(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem, result: u64 in Trapping)
crashes Trap
{
    transition item.has_body && typer.output.accepted && result != typer.output.unit {
        true -> next(typer, syntax, item, item.first_statement),
        false -> done()
    }
    machine next(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem, index: u64 in Trapping) {
        transition index < item.first_statement + item.statement_count {
            true -> statement(typer, syntax, item, index),
            false -> missing(typer, item)
        }
    }
    machine statement(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem, index: u64 in Trapping) {
        let statement: |syntax_trees|::Statement = |syntax_trees|::syntax_trees_statement(syntax, index);
        let terminal: bool = statement.kind == |syntax_trees|::StatementKind::Tail || statement.kind == |syntax_trees|::StatementKind::Crash || statement.kind == |syntax_trees|::StatementKind::Transition;
        transition terminal {
            true -> done(),
            false -> evaluated(typer, syntax, item, index, statement)
        }
    }
    machine evaluated(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem, index: u64 in Trapping, statement: |syntax_trees|::Statement) {
        transition statement.has_value {
            true -> value(typer, syntax, item, index, statement.value),
            false -> next(typer, syntax, item, index + 1)
        }
    }
    machine value(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem, index: u64 in Trapping, expression: u64 in Trapping) {
        let value_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, expression);
        let never: bool = |typed_trees|::never_type(@typer.output.types, value_type);
        transition never {
            true -> done(),
            false -> next(typer, syntax, item, index + 1)
        }
    }
    machine missing(typer: @mutable |typing_state|::Typer, item: |syntax_trees|::MachineItem) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::TerminalResultMismatch, item.source_span);
    }
    machine done() {}
}

machine type_statement(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, result: u64 in Trapping)
crashes Trap
{
    let statement: |syntax_trees|::Statement = |syntax_trees|::syntax_trees_statement(syntax, index);
    transition statement.kind {
        |syntax_trees|::StatementKind::Let -> local(typer, sources, syntax, resolution, statement),
        |syntax_trees|::StatementKind::Assign -> assign(typer, sources, syntax, resolution, statement),
        |syntax_trees|::StatementKind::Expression -> evaluated(typer, sources, syntax, resolution, statement),
        |syntax_trees|::StatementKind::Discard -> discarded(typer, sources, syntax, resolution, statement),
        |syntax_trees|::StatementKind::Tail -> tail(typer, sources, syntax, resolution, statement, result),
        |syntax_trees|::StatementKind::Crash -> done(),
        |syntax_trees|::StatementKind::Transition -> transition_statement(typer, sources, syntax, resolution, statement, result)
    }

    machine local(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement) {
        transition statement.has_value {
            true -> initialized(typer, sources, syntax, resolution, statement),
            _ -> done()
        }
    }

    machine initialized(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement) {
        |expressions|::type_tree(typer, sources, syntax, resolution, statement.value);
        let declared: u64 in Trapping = |typed_trees|::reference_type(@typer.output, statement.type_reference);
        transition typer.output.accepted {
            true -> admit(typer, syntax, declared, statement.value),
            _ -> done()
        }
    }

    machine assign(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement) {
        |expressions|::type_tree(typer, sources, syntax, resolution, statement.target);
        |expressions|::type_tree(typer, sources, syntax, resolution, statement.value);
        let place: bool = |expressions|::is_place(typer, syntax, resolution, statement.target);
        let destination: u64 in Trapping = |expressions|::place_type(typer, syntax, statement.target);
        transition typer.output.accepted && place {
            true -> assigned(typer, syntax, resolution, statement, destination),
            _ -> assign_rejected(typer, syntax, statement, place)
        }
    }

    machine assigned(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement, destination: u64 in Trapping) {
        let writable: bool = |expressions|::writable_place(typer, syntax, resolution, statement.target);
        transition writable {
            true -> admit(typer, syntax, destination, statement.value),
            _ -> immutable(typer, syntax, statement)
        }
    }

    machine immutable(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, statement: |syntax_trees|::Statement) {
        let target: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, statement.target);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::ImmutablePlace, target.source_span);
    }

    machine assign_rejected(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, statement: |syntax_trees|::Statement, place: bool) {
        let target: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, statement.target);
        transition typer.output.accepted && !place {
            true -> not_a_place(typer, target),
            _ -> done()
        }
    }

    machine evaluated(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement) {
        |expressions|::type_tree(typer, sources, syntax, resolution, statement.value);
        let value_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, statement.value);
        let never: bool = |typed_trees|::never_type(@typer.output.types, value_type);
        transition !typer.output.accepted || value_type == typer.output.unit || never {
            true -> done(),
            _ -> silently_discarded(typer, syntax, statement)
        }
    }

    machine silently_discarded(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, statement: |syntax_trees|::Statement) {
        let value: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, statement.value);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::SilentDiscard, value.source_span);
    }

    // Only a call's result is dropped intentionally.
    machine discarded(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement) {
        let value: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, statement.value);
        |expressions|::type_tree(typer, sources, syntax, resolution, statement.value);
        transition !typer.output.accepted || value.kind == |syntax_trees|::ExpressionKind::Call {
            true -> done(),
            _ -> discards_no_call(typer, value)
        }
    }

    machine discards_no_call(typer: @mutable |typing_state|::Typer, value: |syntax_trees|::Expression) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::DiscardsNoCall, value.source_span);
    }

    machine tail(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement, result: u64 in Trapping) {
        |expressions|::type_tree(typer, sources, syntax, resolution, statement.value);
        transition typer.output.accepted {
            true -> admit(typer, syntax, result, statement.value),
            _ -> done()
        }
    }

    machine transition_statement(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement, result: u64 in Trapping) {
        transition statement.has_value {
            true -> subject(typer, sources, syntax, resolution, statement, result),
            _ -> arms(typer, sources, syntax, resolution, statement, result, 0 as +Trapping)
        }
    }

    machine subject(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement, result: u64 in Trapping) {
        |expressions|::type_tree(typer, sources, syntax, resolution, statement.value);
        let subject_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, statement.value);
        transition typer.output.accepted && subject_type == 0 {
            true -> subject_absent(typer, syntax, statement),
            _ -> arms(typer, sources, syntax, resolution, statement, result, subject_type)
        }
    }

    machine subject_absent(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, statement: |syntax_trees|::Statement) {
        let subject_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, statement.value);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::NotAValue, subject_expression.source_span);
    }

    machine arms(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement, result: u64 in Trapping, subject_type: u64 in Trapping) {
        type_arms(typer, sources, syntax, resolution, statement, result, subject_type, 0 as +Trapping);
        transition typer.output.accepted {
            true -> coverage(typer, sources, syntax, resolution, statement, subject_type),
            _ -> done()
        }
    }

    machine coverage(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement, subject_type: u64 in Trapping) {
        let range: |syntax_trees|::ArmRange = |syntax_trees|::ArmRange { matched: false, first: statement.first_arm, count: statement.arm_count };
        let covered: bool = |coverage|::covers(typer, sources, syntax, resolution, range, subject_type);
        transition covered {
            true -> done(),
            _ -> uncovered(typer, statement)
        }
    }

    machine uncovered(typer: @mutable |typing_state|::Typer, statement: |syntax_trees|::Statement) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::UncoveredDispatch, statement.source_span);
    }

    machine admit(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, destination: u64 in Trapping, value: u64 in Trapping) {
        let admitted: bool = |admission|::typer_admit(typer, syntax, destination, value, false);
    }

    machine not_a_place(typer: @mutable |typing_state|::Typer, target: |syntax_trees|::Expression) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::NotAPlace, target.source_span);
    }

    machine done() {}
}

// The arms of a transition over `subject_type` (zero for a subjectless block).
machine type_arms(
    typer: @mutable |typing_state|::Typer,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    statement: |syntax_trees|::Statement,
    result: u64 in Trapping,
    subject_type: u64 in Trapping,
    offset: u64 in Trapping
)
crashes Trap
{
    transition offset < statement.arm_count && typer.output.accepted {
        true -> arm(typer, sources, syntax, resolution, statement, result, subject_type, offset),
        _ -> done()
    }

    machine arm(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        statement: |syntax_trees|::Statement,
        result: u64 in Trapping,
        subject_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_arm(syntax, statement.first_arm + offset);
        type_pattern(typer, sources, syntax, resolution, arm, subject_type);
        type_guard_clause(typer, sources, syntax, resolution, arm);
        transition typer.output.accepted {
            true -> target(typer, sources, syntax, resolution, statement, result, subject_type, offset, arm),
            _ -> done()
        }
    }

    machine target(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        statement: |syntax_trees|::Statement,
        result: u64 in Trapping,
        subject_type: u64 in Trapping,
        offset: u64 in Trapping,
        arm: |syntax_trees|::TransitionArm
    ) {
        type_target(typer, sources, syntax, resolution, arm, result);
        transition { _ -> arms_next(typer, sources, syntax, resolution, statement, result, subject_type, offset + 1) }
    }

    machine arms_next(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        statement: |syntax_trees|::Statement,
        result: u64 in Trapping,
        subject_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < statement.arm_count && typer.output.accepted {
            true -> arm(typer, sources, syntax, resolution, statement, result, subject_type, offset),
            _ -> done()
        }
    }

    machine done() {}
}

// An arm's `if` guard is Boolean, typed after the pattern so its binders
// are known.
machine type_guard_clause(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, arm: |syntax_trees|::TransitionArm)
crashes Trap
{
    transition arm.has_guard && typer.output.accepted {
        true -> typed(typer, sources, syntax, resolution, arm),
        _ -> done()
    }

    machine typed(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, arm: |syntax_trees|::TransitionArm) {
        |expressions|::type_tree(typer, sources, syntax, resolution, arm.guard);
        let guard_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, arm.guard);
        transition typer.output.accepted && guard_type != typer.output.boolean {
            true -> not_boolean(typer, syntax, arm),
            _ -> done()
        }
    }

    machine not_boolean(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm) {
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.guard);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::NotBoolean, written.source_span);
    }

    machine done() {}
}

// An arm's pattern: a guard is Boolean, a literal or a case meets the
// subject as its head does, and a case binds its fields.
machine type_pattern(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, arm: |syntax_trees|::TransitionArm, subject_type: u64 in Trapping)
crashes Trap
{
    transition arm.kind {
        |syntax_trees|::ArmPatternKind::Guard -> guard(typer, sources, syntax, resolution, arm),
        |syntax_trees|::ArmPatternKind::Wildcard -> done(),
        |syntax_trees|::ArmPatternKind::Binder -> |expressions|::type_tree(typer, sources, syntax, resolution, arm.pattern),
        |syntax_trees|::ArmPatternKind::Literal -> head(typer, sources, syntax, resolution, arm, subject_type),
        |syntax_trees|::ArmPatternKind::Case -> head(typer, sources, syntax, resolution, arm, subject_type)
    }

    machine guard(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, arm: |syntax_trees|::TransitionArm) {
        |expressions|::type_tree(typer, sources, syntax, resolution, arm.pattern);
        let guard_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, arm.pattern);
        transition typer.output.accepted && guard_type != typer.output.boolean {
            true -> not_boolean(typer, syntax, arm),
            _ -> done()
        }
    }

    machine head(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, arm: |syntax_trees|::TransitionArm, subject_type: u64 in Trapping) {
        |expressions|::type_tree(typer, sources, syntax, resolution, arm.pattern);
        transition typer.output.accepted {
            true -> headed(typer, sources, syntax, resolution, arm, subject_type),
            _ -> done()
        }
    }

    machine headed(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, arm: |syntax_trees|::TransitionArm, subject_type: u64 in Trapping) {
        let named: u64 in Trapping = pattern_head(typer, syntax, resolution, arm, subject_type);
        let base: u64 in Trapping = |typing_state|::typer_referent(typer, subject_type);
        let subject_row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, base);
        transition named > 0 && typer.output.accepted {
            true -> named_case(typer, sources, syntax, resolution, arm, subject_row, named - 1),
            _ -> done()
        }
    }

    machine named_case(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        arm: |syntax_trees|::TransitionArm,
        subject_row: |typed_trees|::TypeRow,
        data_case: u64 in Trapping
    ) {
        let declared: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, subject_row.item);
        transition { _ -> fields(typer, sources, syntax, resolution, arm, subject_row, declared, data_case, 0 as +Trapping) }
    }

    machine fields(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        arm: |syntax_trees|::TransitionArm,
        subject_row: |typed_trees|::TypeRow,
        declared: |syntax_trees|::DataItem,
        data_case: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < arm.field_count && typer.output.accepted {
            true -> field(typer, sources, syntax, resolution, arm, subject_row, declared, data_case, offset),
            _ -> complete_pattern(typer, sources, syntax, arm, declared, data_case)
        }
    }

    machine complete_pattern(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm, declared: |syntax_trees|::DataItem, data_case: u64 in Trapping) {
        let selected: |syntax_trees|::DataCase = |syntax_trees|::syntax_trees_data_case(syntax, data_case);
        let expected: u64 in Trapping = declared.field_count + selected.payload_field_count;
        |patterns|::validate_pattern_fields(typer, sources, syntax, arm, expected);
    }

    machine field(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        arm: |syntax_trees|::TransitionArm,
        subject_row: |typed_trees|::TypeRow,
        declared: |syntax_trees|::DataItem,
        data_case: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let handle: u64 in Trapping = arm.first_field + offset;
        let pattern_field: |syntax_trees|::PatternField = |syntax_trees|::syntax_trees_pattern_field(syntax, handle);
        let target: |typed_trees|::MemberTarget = |calls|::member_target(sources, syntax, declared, true, data_case, pattern_field.name);
        |typed_trees|::set_binder_member(@mutable typer.output, handle, target);
        let reference: u64 in Trapping = |calls|::target_reference(syntax, target);
        transition reference < 18446744073709551615 {
            true -> field_typed(typer, sources, syntax, resolution, arm, subject_row, declared, data_case, offset, handle, pattern_field, reference),
            _ -> unknown_field(typer, pattern_field)
        }
    }

    machine field_typed(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        arm: |syntax_trees|::TransitionArm,
        subject_row: |typed_trees|::TypeRow,
        declared: |syntax_trees|::DataItem,
        data_case: u64 in Trapping,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        pattern_field: |syntax_trees|::PatternField,
        reference: u64 in Trapping
    ) {
        let written: u64 in Trapping = |typed_trees|::reference_type(@typer.output, reference);
        let field_type: u64 in Trapping = |expressions|::substitute(typer, syntax, written, subject_row, pattern_field.source_span);
        transition pattern_field.has_value {
            true -> field_value(typer, sources, syntax, resolution, arm, subject_row, declared, data_case, offset, pattern_field, field_type),
            _ -> field_binder(typer, sources, syntax, resolution, arm, subject_row, declared, data_case, offset, handle, field_type)
        }
    }

    machine field_binder(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        arm: |syntax_trees|::TransitionArm,
        subject_row: |typed_trees|::TypeRow,
        declared: |syntax_trees|::DataItem,
        data_case: u64 in Trapping,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        field_type: u64 in Trapping
    ) {
        |typed_trees|::set_binder_type(@mutable typer.output, handle, field_type);
        transition { _ -> fields(typer, sources, syntax, resolution, arm, subject_row, declared, data_case, offset + 1) }
    }

    machine field_value(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        arm: |syntax_trees|::TransitionArm,
        subject_row: |typed_trees|::TypeRow,
        declared: |syntax_trees|::DataItem,
        data_case: u64 in Trapping,
        offset: u64 in Trapping,
        pattern_field: |syntax_trees|::PatternField,
        field_type: u64 in Trapping
    ) {
        |expressions|::type_tree(typer, sources, syntax, resolution, pattern_field.value);
        transition typer.output.accepted {
            true -> field_value_admit(typer, sources, syntax, resolution, arm, subject_row, declared, data_case, offset, pattern_field, field_type),
            _ -> done()
        }
    }

    machine field_value_admit(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        arm: |syntax_trees|::TransitionArm,
        subject_row: |typed_trees|::TypeRow,
        declared: |syntax_trees|::DataItem,
        data_case: u64 in Trapping,
        offset: u64 in Trapping,
        pattern_field: |syntax_trees|::PatternField,
        field_type: u64 in Trapping
    ) {
        let admitted: bool = |admission|::typer_admit(typer, syntax, field_type, pattern_field.value, false);
        transition { _ -> fields(typer, sources, syntax, resolution, arm, subject_row, declared, data_case, offset + 1) }
    }

    machine not_boolean(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm) {
        let pattern: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.pattern);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::NotBoolean, pattern.source_span);
    }

    machine unknown_field(typer: @mutable |typing_state|::Typer, pattern_field: |syntax_trees|::PatternField) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::UnknownPatternField, pattern_field.source_span);
    }

    machine done() {}
}

// A literal or case pattern, already typed, meets the subject: a case names
// a case of the subject's data, and a value pattern (a literal, or a path
// or name denoting no case, such as a constant) lands at the subject's
// type, through references, and selects by equality, so that type must
// compare intrinsically (wiki/spec/language/patterns.md: scalars use value
// patterns); `_` has no pattern. The named case plus one; zero for any
// other arm or a rejection.
public machine pattern_head(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, arm: |syntax_trees|::TransitionArm, subject_type: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let base: u64 in Trapping = |typing_state|::typer_referent(typer, subject_type);
    transition arm.kind {
        |syntax_trees|::ArmPatternKind::Case -> case_pattern(typer, syntax, resolution, arm, base),
        |syntax_trees|::ArmPatternKind::Literal -> value(typer, syntax, arm, base),
        _ -> none()
    }

    machine value(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm, base: u64 in Trapping) -> u64 in Trapping {
        let admitted: bool = |admission|::typer_admit(typer, syntax, base, arm.pattern, false);
        let integer: bool = |expressions|::intrinsic_equality(typer, syntax, base);
        let float: bool = |expressions|::float_like(typer, base);
        transition !admitted || integer || float {
            true -> none(),
            _ -> incomparable(typer, syntax, arm)
        }
    }

    machine incomparable(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm) -> u64 in Trapping {
        let pattern: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.pattern);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::UnsupportedEquality, pattern.source_span);
        transition { _ -> none() }
    }

    machine case_pattern(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, arm: |syntax_trees|::TransitionArm, base: u64 in Trapping) -> u64 in Trapping {
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, arm.pattern);
        let subject_row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, base);
        transition binding {
            |symbol_resolved_trees|::ValueBinding::DataCase { item, data_case } -> named_case(typer, syntax, arm, subject_row, item, data_case),
            _ -> valued(typer, syntax, arm, base)
        }
    }

    // A path or name denoting no case is a value pattern; binders belong
    // only to a case.
    machine valued(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm, base: u64 in Trapping) -> u64 in Trapping {
        transition !arm.has_fields {
            true -> value(typer, syntax, arm, base),
            _ -> other_data(typer, syntax, arm)
        }
    }

    machine named_case(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm, subject_row: |typed_trees|::TypeRow, item: u64 in Trapping, data_case: u64 in Trapping) -> u64 in Trapping {
        transition subject_row.kind == |typed_trees|::TypeKind::Data && subject_row.item == item {
            true -> named(data_case + 1),
            _ -> other_data(typer, syntax, arm)
        }
    }

    machine other_data(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm) -> u64 in Trapping {
        let pattern: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.pattern);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::CaseOfOtherData, pattern.source_span);
        transition { _ -> none() }
    }

    machine named(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }

    machine none() -> u64 in Trapping {
        0 as +Trapping
    }
}

// A terminal target forwards the selected call's result, its own value, or
// Unit. Every form meets the current declaration's independent result.
machine type_target(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, arm: |syntax_trees|::TransitionArm, result: u64 in Trapping)
crashes Trap
{
    transition arm.target_kind == |syntax_trees|::ArmTargetKind::Unit {
        true -> terminal(typer, syntax, arm, result),
        _ -> target(typer, sources, syntax, resolution, arm, result)
    }

    machine terminal(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm, result: u64 in Trapping) {
        transition result == typer.output.unit {
            true -> done(),
            _ -> mismatch(typer, arm.source_span)
        }
    }

    machine target(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, arm: |syntax_trees|::TransitionArm, result: u64 in Trapping) {
        |expressions|::type_tree(typer, sources, syntax, resolution, arm.target);
        transition typer.output.accepted {
            true -> completes(typer, syntax, arm, result),
            _ -> done()
        }
    }

    machine completes(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm, result: u64 in Trapping) {
        let admitted: bool = |admission|::typer_admit(typer, syntax, result, arm.target, false);
    }

    machine mismatch(typer: @mutable |typing_state|::Typer, source_span: |source|::SourceSpan) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::TerminalResultMismatch, source_span);
    }

    machine done() {}
}
