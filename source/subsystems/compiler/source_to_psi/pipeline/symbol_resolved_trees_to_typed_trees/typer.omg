use pipeline/symbol_resolved_trees_to_typed_trees/admission.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/clauses.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/expressions.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/facts.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/references.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/statements.omg;
use foundation/integers.omg;
use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;

// Typing over a name-resolved source set. The pass runs in fail-closed
// steps: every written type reference interns (references.omg), then each
// constant's value types against its declared type, then each
// machine body's statements type in authored order (statements.omg), each
// statement's expression trees in table order, children before parents
// (expressions.omg). An anonymous integer tree lands where its destination
// is known: a declared local, a parameter, a field, an operand of a typed
// operation, a cast or a result. The first rejection is the diagnostic.
public machine type_check(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution)
crashes Trap
{
    typer_clear(typer, syntax);
    |references|::type_references(typer, sources, syntax, resolution);
    transition typer.output.accepted {
        true -> constants(typer, sources, syntax, resolution),
        _ -> done()
    }

    machine constants(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution) {
        type_constants(typer, sources, syntax, resolution);
        transition typer.output.accepted {
            true -> bodies(typer, sources, syntax, resolution),
            _ -> done()
        }
    }

    machine bodies(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution) {
        type_bodies(typer, sources, syntax, resolution);
        transition typer.output.accepted {
            true -> facts(typer, sources, syntax, resolution),
            _ -> done()
        }
    }

    machine facts(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution) {
        |facts|::type_facts(typer, sources, syntax, resolution);
        transition typer.output.accepted {
            true -> clauses(typer, sources, syntax, resolution),
            _ -> done()
        }
    }

    machine clauses(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution) {
        |clauses|::type_clauses(typer, sources, syntax, resolution);
    }

    machine done() {}
}

// Empty annotations over `syntax`, with the absent row and the unit,
// Boolean and anonymous-integer types interned first.
machine typer_clear(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    typer.output.accepted = true;
    typer.output.diagnostic.code = |typed_trees|::TypeDiagnosticCode::None;
    let absent_row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::Absent);
    typer.output.types.rows[0] = absent_row;
    typer.output.types.row_count = 1;
    typer.output.types.argument_count = 0;
    typer.output.reference_count = 0;
    typer.output.binder_count = syntax.pattern_field_count;
    typer.output.construct_count = syntax.construct_field_count;
    typer.output.expression_count = syntax.expression_count;
    let unit_row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::Unit);
    let unit: u64 in Trapping = |typed_trees|::type_table_intern(@mutable typer.output.types, unit_row);
    let mutable boolean_row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::Builtin);
    boolean_row.builtin = |symbol_resolved_trees|::BuiltinType::Bool;
    let boolean: u64 in Trapping = |typed_trees|::type_table_intern(@mutable typer.output.types, boolean_row);
    let anonymous_row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::AnonymousInteger);
    let anonymous: u64 in Trapping = |typed_trees|::type_table_intern(@mutable typer.output.types, anonymous_row);
    let anonymous_float_row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::AnonymousFloat);
    let anonymous_float: u64 in Trapping = |typed_trees|::type_table_intern(@mutable typer.output.types, anonymous_float_row);
    typer.output.unit = unit;
    typer.output.boolean = boolean;
    typer.output.anonymous = anonymous;
    typer.output.anonymous_float = anonymous_float;
    transition { _ -> expression(typer, 0 as +Trapping) }

    machine expression(typer: @mutable |typing_state|::Typer, index: u64 in Trapping) {
        transition index < typer.output.expression_count {
            true -> clear_expression(typer, index),
            _ -> binder(typer, 0 as +Trapping)
        }
    }

    machine clear_expression(typer: @mutable |typing_state|::Typer, index: u64 in Trapping) {
        |typed_trees|::set_expression_type(@mutable typer.output, index, 0 as +Trapping);
        |typed_trees|::set_selection(@mutable typer.output, index, |typed_trees|::Selection::None);
        |typed_trees|::set_adaptation(@mutable typer.output, index, |typed_trees|::Adaptation::None);
        |typed_trees|::typing_set_value(@mutable typer.output, index, |integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping });
        |typed_trees|::set_roster(@mutable typer.output, index, 0 as +Trapping);
        |typing_state|::mark_typed(typer, index, false);
        transition { _ -> expression(typer, index + 1) }
    }

    machine binder(typer: @mutable |typing_state|::Typer, index: u64 in Trapping) {
        transition index < typer.output.binder_count {
            true -> clear_binder(typer, index),
            _ -> construct(typer, 0 as +Trapping)
        }
    }

    machine clear_binder(typer: @mutable |typing_state|::Typer, index: u64 in Trapping) {
        |typed_trees|::set_binder_type(@mutable typer.output, index, 0 as +Trapping);
        |typed_trees|::set_binder_member(@mutable typer.output, index, |typed_trees|::MemberTarget::Unknown);
        transition { _ -> binder(typer, index + 1) }
    }

    machine construct(typer: @mutable |typing_state|::Typer, index: u64 in Trapping) {
        transition index < typer.output.construct_count {
            true -> clear_construct(typer, index),
            _ -> done()
        }
    }

    machine clear_construct(typer: @mutable |typing_state|::Typer, index: u64 in Trapping) {
        |typed_trees|::set_construct_target(@mutable typer.output, index, |typed_trees|::MemberTarget::Unknown);
        transition { _ -> construct(typer, index + 1) }
    }

    machine done() {}
}

// Each constant's value, landed at its declared type like a `let`
// initializer (wiki/spec/language/constants.md).
machine type_constants(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution)
crashes Trap
{
    transition { _ -> next(typer, sources, syntax, resolution, 0 as +Trapping) }

    machine next(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        transition index < syntax.constant_count && typer.output.accepted {
            true -> value(typer, sources, syntax, resolution, index),
            _ -> done()
        }
    }

    machine value(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        let item: |syntax_trees|::ConstantItem = |syntax_trees|::constant_item(syntax, index);
        |expressions|::type_tree(typer, sources, syntax, resolution, item.value);
        let declared: u64 in Trapping = |typed_trees|::reference_type(@typer.output, item.type_reference);
        transition typer.output.accepted {
            true -> admit(typer, sources, syntax, resolution, index, declared, item.value),
            _ -> done()
        }
    }

    machine admit(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, declared: u64 in Trapping, value: u64 in Trapping) {
        let admitted: bool = |admission|::typer_admit(typer, syntax, declared, value, false);
        transition { _ -> next(typer, sources, syntax, resolution, index + 1) }
    }

    machine done() {}
}

// Every declaration checks its own executable body and result. An omitted
// result is Unit, independent of lexical ancestry.
machine type_bodies(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution)
crashes Trap
{
    transition { _ -> next_machine(typer, sources, syntax, resolution, 0 as +Trapping) }

    machine next_machine(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        transition index < syntax.machine_count && typer.output.accepted {
            true -> entry(typer, sources, syntax, resolution, index),
            _ -> done()
        }
    }

    machine entry(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        let result: u64 in Trapping = |typing_state|::declared_result(typer, item.has_return_type, item.return_type, typer.output.unit);
        |statements|::type_body(typer, sources, syntax, resolution, item.first_statement, item.statement_count, result);
        |statements|::require_body_completion(typer, syntax, item, result);
        transition { _ -> next_machine(typer, sources, syntax, resolution, index + 1) }
    }

    machine done() {}
}
