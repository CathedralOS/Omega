use representations/symbol_resolved_trees/machine_declarations.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/admission.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Operator syntax over data (wiki/spec/language/expressions.md#operator-declarations).
// An arithmetic or order operator with a data operand is operand-directed:
// its candidates are the machines binding its token whose semantic home is
// an operand's data, never a scan of imports. A candidate is one its use can
// see (the home's package, or a `public` machine), takes two parameters and
// admits both operands as a call admits its arguments; exactly one must.
// The expression takes the selected machine's result and records the
// selection, so checking owes the machine's contract as at a named call. A
// generic token machine is no candidate yet.
public machine type_operator_call(
    typer: @mutable |typing_state|::Typer,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    index: u64 in Trapping,
    expression: |syntax_trees|::Expression
)
crashes Trap
{
    let matches: u64 in Trapping = operator_matches(typer, sources, syntax, resolution, expression, 0 as +Trapping, 0 as +Trapping);
    transition matches == 1 {
        true -> select(typer, sources, syntax, resolution, index, expression, 0 as +Trapping),
        _ -> unmatched(typer, expression, matches)
    }

    machine select(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        candidate: u64 in Trapping
    ) {
        let admits: bool = operator_admits(typer, sources, syntax, resolution, expression, candidate);
        transition admits {
            true -> selected(typer, syntax, index, expression, candidate),
            _ -> select(typer, sources, syntax, resolution, index, expression, candidate + 1)
        }
    }

    machine selected(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, expression: |syntax_trees|::Expression, candidate: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, candidate);
        let result: u64 in Trapping = |typing_state|::declared_result(typer, item.has_return_type, item.return_type, typer.output.unit);
        |typed_trees|::set_selection(@mutable typer.output, index, |typed_trees|::Selection::Machine { handle: candidate });
        |typed_trees|::set_expression_type(@mutable typer.output, index, result);
        let left: |syntax_trees|::Parameter = |syntax_trees|::syntax_trees_parameter(syntax, item.first_parameter);
        let right: |syntax_trees|::Parameter = |syntax_trees|::syntax_trees_parameter(syntax, item.first_parameter + 1);
        let left_type: u64 in Trapping = |typed_trees|::reference_type(@typer.output, left.type_reference);
        let right_type: u64 in Trapping = |typed_trees|::reference_type(@typer.output, right.type_reference);
        let left_admitted: bool = |admission|::typer_admit(typer, syntax, left_type, expression.left, true);
        let right_admitted: bool = |admission|::typer_admit(typer, syntax, right_type, expression.right, true);
    }

    machine unmatched(typer: @mutable |typing_state|::Typer, expression: |syntax_trees|::Expression, matches: u64 in Trapping) {
        transition matches == 0 {
            true -> reject(typer, expression, |typed_trees|::TypeDiagnosticCode::OperandMismatch),
            _ -> reject(typer, expression, |typed_trees|::TypeDiagnosticCode::AmbiguousMachine)
        }
    }

    machine reject(typer: @mutable |typing_state|::Typer, expression: |syntax_trees|::Expression, code: |typed_trees|::TypeDiagnosticCode) {
        |typed_trees|::typing_reject(@mutable typer.output, code, expression.source_span);
    }
}

// How many machines from `candidate` on admit operator `expression`.
machine operator_matches(
    typer: @mutable |typing_state|::Typer,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    expression: |syntax_trees|::Expression,
    candidate: u64 in Trapping,
    count: u64 in Trapping
) -> u64 in Trapping
crashes Trap
{
    transition candidate < syntax.machine_count {
        true -> test(typer, sources, syntax, resolution, expression, candidate, count),
        _ -> result(count)
    }

    machine test(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        expression: |syntax_trees|::Expression,
        candidate: u64 in Trapping,
        count: u64 in Trapping
    ) -> u64 in Trapping {
        let admits: bool = operator_admits(typer, sources, syntax, resolution, expression, candidate);
        transition admits {
            true -> next(typer, sources, syntax, resolution, expression, candidate + 1, count + 1),
            _ -> next(typer, sources, syntax, resolution, expression, candidate + 1, count)
        }
    }

    machine next(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        expression: |syntax_trees|::Expression,
        candidate: u64 in Trapping,
        count: u64 in Trapping
    ) -> u64 in Trapping {
        transition candidate < syntax.machine_count {
            true -> test(typer, sources, syntax, resolution, expression, candidate, count),
            _ -> result(count)
        }
    }

    machine result(count: u64 in Trapping) -> u64 in Trapping {
        count
    }
}

// Whether machine `candidate` binds operator `expression`'s token, is homed
// at an operand's data, is visible to the use, and admits both operands.
machine operator_admits(
    typer: @mutable |typing_state|::Typer,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    expression: |syntax_trees|::Expression,
    candidate: u64 in Trapping
) -> bool
crashes Trap
{
    let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, candidate);
    let token: |syntax_trees|::OperatorToken = operator_token(expression.operator);
    transition item.operator == token && item.parameter_count == 2 && item.generic_parameter_count == 0 {
        true -> homed(typer, sources, syntax, resolution, expression, candidate, item),
        _ -> no()
    }

    machine homed(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        expression: |syntax_trees|::Expression,
        candidate: u64 in Trapping,
        item: |syntax_trees|::MachineItem
    ) -> bool {
        let home: |symbol_resolved_trees|::TypeBinding = |symbol_resolved_trees|::operator_home(resolution, candidate);
        let left_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, expression.left);
        let right_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, expression.right);
        let left_home: bool = homed_operand(typer, home, left_type);
        let right_home: bool = homed_operand(typer, home, right_type);
        transition left_home || right_home {
            true -> visible(typer, sources, syntax, resolution, expression, candidate, item),
            _ -> no()
        }
    }

    machine visible(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        expression: |syntax_trees|::Expression,
        candidate: u64 in Trapping,
        item: |syntax_trees|::MachineItem
    ) -> bool {
        let is_public: bool = |machine_declarations|::machine_public(resolution, syntax, item, candidate);
        let use_unit: u64 in Trapping = expression.source_span.source.value as -Trapping as u64 +Trapping;
        let declared_unit: u64 in Trapping = item.name.source_span.source.value as -Trapping as u64 +Trapping;
        let own: bool = |source|::same_package(sources, use_unit, declared_unit);
        transition is_public || own {
            true -> operands(typer, syntax, expression, item),
            _ -> no()
        }
    }

    machine operands(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, expression: |syntax_trees|::Expression, item: |syntax_trees|::MachineItem) -> bool {
        let left: |syntax_trees|::Parameter = |syntax_trees|::syntax_trees_parameter(syntax, item.first_parameter);
        let right: |syntax_trees|::Parameter = |syntax_trees|::syntax_trees_parameter(syntax, item.first_parameter + 1);
        let left_type: u64 in Trapping = |typed_trees|::reference_type(@typer.output, left.type_reference);
        let right_type: u64 in Trapping = |typed_trees|::reference_type(@typer.output, right.type_reference);
        let left_admitted: bool = |admission|::admissible(typer, syntax, left_type, expression.left);
        let right_admitted: bool = |admission|::admissible(typer, syntax, right_type, expression.right);
        left_admitted && right_admitted
    }

    machine no() -> bool {
        false
    }
}

// Whether type `handle` is data homed at `home`.
machine homed_operand(typer: @|typing_state|::Typer, home: |symbol_resolved_trees|::TypeBinding, handle: u64 in Trapping) -> bool
crashes Trap
{
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, handle);
    transition row.kind == |typed_trees|::TypeKind::Data {
        true -> data(home, row.item),
        _ -> elsewhere()
    }

    machine data(home: |symbol_resolved_trees|::TypeBinding, item: u64 in Trapping) -> bool {
        |symbol_resolved_trees|::operator_home_is_data(home, item)
    }

    machine elsewhere() -> bool {
        false
    }
}

// Whether type `handle` is data.
public machine typer_data_type(typer: @|typing_state|::Typer, handle: u64 in Trapping) -> bool
crashes Trap
{
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, handle);
    row.kind == |typed_trees|::TypeKind::Data
}

// The token an operator binds, or `None` for an operator no machine binds
// (equality keeps the sealed `Equatable` route; logical, bitwise and shift
// operators are builtin).
public machine operator_token(operator: |syntax_trees|::OperatorKind) -> |syntax_trees|::OperatorToken {
    transition operator {
        |syntax_trees|::OperatorKind::Add -> chosen(|syntax_trees|::OperatorToken::Add),
        |syntax_trees|::OperatorKind::Subtract -> chosen(|syntax_trees|::OperatorToken::Subtract),
        |syntax_trees|::OperatorKind::Multiply -> chosen(|syntax_trees|::OperatorToken::Multiply),
        |syntax_trees|::OperatorKind::Divide -> chosen(|syntax_trees|::OperatorToken::Divide),
        |syntax_trees|::OperatorKind::Modulo -> chosen(|syntax_trees|::OperatorToken::Modulo),
        |syntax_trees|::OperatorKind::Less -> chosen(|syntax_trees|::OperatorToken::Less),
        |syntax_trees|::OperatorKind::LessEqual -> chosen(|syntax_trees|::OperatorToken::LessEqual),
        |syntax_trees|::OperatorKind::Greater -> chosen(|syntax_trees|::OperatorToken::Greater),
        |syntax_trees|::OperatorKind::GreaterEqual -> chosen(|syntax_trees|::OperatorToken::GreaterEqual),
        _ -> chosen(|syntax_trees|::OperatorToken::None)
    }

    machine chosen(token: |syntax_trees|::OperatorToken) -> |syntax_trees|::OperatorToken {
        token
    }
}
