use pipeline/symbol_resolved_trees_to_typed_trees/expressions.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Facts type like any expression, and each one is a Boolean: a machine's
// `requires` and `ensures` facts and each state's `requires` facts over
// their parameters (`result` is the machine's result), each `requires
// machine` contract's `requires` facts over its own parameters, each
// domain's predicates over its subject binder, and a data declaration's
// `requires` facts over its fields. A case carries no facts of its own.
// A data `requires self` types `self` as that declaration applied to its
// own generic parameters. A proposition application, a whole fact, is a
// Boolean statement (calls.omg).
public machine type_facts(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution)
crashes Trap
{
    transition { _ -> next_machine(typer, sources, syntax, resolution, 0 as +Trapping) }

    machine next_machine(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        transition index < syntax.machine_count && typer.output.accepted {
            true -> machine(typer, sources, syntax, resolution, index),
            _ -> next_data(typer, sources, syntax, resolution, 0 as +Trapping)
        }
    }

    machine machine(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        type_clause_facts(typer, sources, syntax, resolution, item.first_clause, item.clause_count, |syntax_trees|::ClauseKind::Requires);
        type_clause_facts(typer, sources, syntax, resolution, item.first_clause, item.clause_count, |syntax_trees|::ClauseKind::Ensures);
        transition { _ -> next_contract(typer, sources, syntax, resolution, index, item, 0 as +Trapping) }
    }

    machine next_contract(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, item: |syntax_trees|::MachineItem, offset: u64 in Trapping) {
        transition offset < item.contract_count && typer.output.accepted {
            true -> contract_facts(typer, sources, syntax, resolution, index, item, offset),
            _ -> next_machine(typer, sources, syntax, resolution, index + 1)
        }
    }

    machine contract_facts(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, item: |syntax_trees|::MachineItem, offset: u64 in Trapping) {
        let written: |syntax_trees|::Contract = |syntax_trees|::syntax_trees_contract(syntax, item.first_contract + offset);
        type_clause_facts(typer, sources, syntax, resolution, written.first_clause, written.clause_count, |syntax_trees|::ClauseKind::Requires);
        type_clause_facts(typer, sources, syntax, resolution, written.first_clause, written.clause_count, |syntax_trees|::ClauseKind::Ensures);
        transition { _ -> next_contract(typer, sources, syntax, resolution, index, item, offset + 1) }
    }

    machine next_data(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        transition index < syntax.data_count && typer.output.accepted {
            true -> data(typer, sources, syntax, resolution, index),
            _ -> next_domain(typer, sources, syntax, resolution, 0 as +Trapping)
        }
    }

    machine next_domain(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        transition index < syntax.domain_count && typer.output.accepted {
            true -> domain(typer, sources, syntax, resolution, index),
            _ -> done()
        }
    }

    machine domain(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, index);
        type_clause_facts(typer, sources, syntax, resolution, item.first_clause, item.clause_count, |syntax_trees|::ClauseKind::Requires);
        transition { _ -> next_domain(typer, sources, syntax, resolution, index + 1) }
    }

    machine data(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        let item: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, index);
        type_clause_facts(typer, sources, syntax, resolution, item.first_clause, item.clause_count, |syntax_trees|::ClauseKind::Requires);
        transition { _ -> next_data(typer, sources, syntax, resolution, index + 1) }
    }

    machine done() {}
}

// The facts of `kind` in a clause run, each a Boolean.
machine type_clause_facts(
    typer: @mutable |typing_state|::Typer,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    first_clause: u64 in Trapping,
    clause_count: u64 in Trapping,
    kind: |syntax_trees|::ClauseKind
)
crashes Trap
{
    transition { _ -> next(typer, sources, syntax, resolution, first_clause, first_clause + clause_count, kind) }

    machine next(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, kind: |syntax_trees|::ClauseKind) {
        transition index < end && typer.output.accepted {
            true -> clause(typer, sources, syntax, resolution, index, end, kind),
            _ -> done()
        }
    }

    machine clause(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, kind: |syntax_trees|::ClauseKind) {
        let clause: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, index);
        transition clause.kind == kind && clause.has_expression {
            true -> fact(typer, sources, syntax, resolution, index, end, kind, clause.expression),
            _ -> next(typer, sources, syntax, resolution, index + 1, end, kind)
        }
    }

    machine fact(typer: @mutable |typing_state|::Typer, sources: @|source|::SourceSet, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, kind: |syntax_trees|::ClauseKind, root: u64 in Trapping) {
        |expressions|::type_tree(typer, sources, syntax, resolution, root);
        let fact_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, root);
        transition !typer.output.accepted || fact_type == typer.output.boolean {
            true -> next(typer, sources, syntax, resolution, index + 1, end, kind),
            _ -> not_boolean(typer, syntax, root)
        }
    }

    machine not_boolean(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, root: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::NotBoolean, expression.source_span);
    }

    machine done() {}
}
