use pipeline/symbol_resolved_trees_to_typed_trees/coverage.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/landing.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/statements.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/joins.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;

use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// A value-position match (wiki/spec/language/patterns.md): `match subject {
// pattern -> value, ... }` produces the value of its first arm whose pattern
// matches. The subject is a value, and each arm's pattern, typed with the
// match's other children, meets it as a transition arm's head does
// (`pattern_head`): `_`, a literal of the subject's type, or a case
// of its data. The arms' values join into one type (joins.omg); a match
// whose arms fix no type is an unlanded value, an anonymous choice or an
// anonymous array, which lands arm by arm where its destination is known
// (landing.omg) and is no subject. The arms cover the subject
// (coverage.omg).
public machine type_match(
    typer: @mutable |typing_state|::Typer,
    sources: @|source|::SourceSet,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    index: u64 in Trapping,
    expression: |syntax_trees|::Expression
)
crashes Trap
{
    let subject_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, expression.left);
    let joined: bool = |landing|::unlanded_join_type(typer, subject_type);
    transition subject_type == 0 || joined {
        true -> subject_absent(typer, syntax, expression),
        _ -> pattern(typer, sources, syntax, resolution, index, expression, subject_type, 0 as +Trapping)
    }

    machine subject_absent(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, expression: |syntax_trees|::Expression) {
        let subject: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, expression.left);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::NotAValue, subject.source_span);
    }

    machine pattern(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        subject_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < expression.count && typer.output.accepted {
            true -> arm_pattern(typer, sources, syntax, resolution, index, expression, subject_type, offset),
            _ -> patterns_typed(typer, sources, syntax, resolution, index, expression, subject_type)
        }
    }

    machine arm_pattern(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        subject_type: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_match_arm(syntax, expression.first + offset);
        let named: u64 in Trapping = |statements|::pattern_head(typer, syntax, resolution, arm, subject_type);
        transition { _ -> pattern(typer, sources, syntax, resolution, index, expression, subject_type, offset + 1) }
    }

    machine patterns_typed(
        typer: @mutable |typing_state|::Typer,
        sources: @|source|::SourceSet,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        index: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        subject_type: u64 in Trapping
    ) {
        let range: |syntax_trees|::ArmRange = |syntax_trees|::ArmRange { matched: true, first: expression.first, count: expression.count };
        let covered: bool = |coverage|::covers(typer, sources, syntax, resolution, range, subject_type);
        transition !typer.output.accepted {
            true -> done(),
            _ -> coverage(typer, syntax, index, expression, covered)
        }
    }

    machine coverage(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, expression: |syntax_trees|::Expression, covered: bool) {
        transition covered {
            true -> values(typer, syntax, index, expression),
            _ -> uncovered(typer, expression)
        }
    }

    machine uncovered(typer: @mutable |typing_state|::Typer, expression: |syntax_trees|::Expression) {
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::UncoveredDispatch, expression.source_span);
    }

    machine values(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, expression: |syntax_trees|::Expression) {
        let values: |syntax_trees|::JoinedValues = |syntax_trees|::joined_values(expression);
        let result_type: u64 in Trapping = |joins|::fixed_join(typer, syntax, values);
        transition result_type > 0 {
            true -> fixed(typer, syntax, index, values, result_type),
            _ -> unfixed(typer, syntax, index, values)
        }
    }

    machine fixed(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, values: |syntax_trees|::JoinedValues, result_type: u64 in Trapping) {
        |typed_trees|::set_expression_type(@mutable typer.output, index, result_type);
        |joins|::admit_joined(typer, syntax, values, result_type);
    }

    // Arms of `Never` alone make the match `Never` too.
    machine unfixed(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, values: |syntax_trees|::JoinedValues) {
        let join: |joins|::UnlandedJoin = |joins|::unlanded_join(typer, syntax, values);
        transition join.mismatch > 0 {
            true -> mismatched(typer, syntax, join.mismatch - 1),
            _ -> joined(typer, index, join.joined)
        }
    }

    machine joined(typer: @mutable |typing_state|::Typer, index: u64 in Trapping, joined: u64 in Trapping) {
        |typed_trees|::set_expression_type(@mutable typer.output, index, joined);
    }

    machine mismatched(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, value: u64 in Trapping) {
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, value);
        |typed_trees|::typing_reject(@mutable typer.output, |typed_trees|::TypeDiagnosticCode::MismatchedTypes, written.source_span);
    }

    machine done() {}
}
