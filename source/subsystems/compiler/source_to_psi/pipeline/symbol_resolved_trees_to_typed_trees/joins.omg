use pipeline/symbol_resolved_trees_to_typed_trees/landing.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/admission.omg;
use pipeline/symbol_resolved_trees_to_typed_trees/typing_state.omg;

use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// The values one expression joins into one type: a value-position match's
// arm values and a fixed-array literal's elements (wiki/spec/language/
// patterns.md, "compatible arm values"). The first value of a fixed type
// gives the join its type, and every other value has that type, lands there
// as an unlanded value, or is `Never`; a value qualified differently, or one
// that would meet it only by a new loan or a membership, is incompatible.
// Existing references retain their admitted shared reborrow at the join. When
// no value fixes a type, the values are unlanded and share one shape:
// anonymous numbers and choices join as an anonymous choice, and anonymous
// arrays of one shape as that array (landing.omg).

// The type of the first value of a fixed type, or zero.
public machine fixed_join(typer: @|typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, values: |syntax_trees|::JoinedValues) -> u64 in Trapping
crashes Trap
{
    transition { _ -> value(typer, syntax, values, 0 as +Trapping) }

    machine value(typer: @|typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, values: |syntax_trees|::JoinedValues, offset: u64 in Trapping) -> u64 in Trapping {
        transition offset < values.count {
            true -> candidate(typer, syntax, values, offset),
            _ -> found(0 as +Trapping)
        }
    }

    machine candidate(typer: @|typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, values: |syntax_trees|::JoinedValues, offset: u64 in Trapping) -> u64 in Trapping {
        let handle: u64 in Trapping = |syntax_trees|::joined_value(syntax, values, offset);
        let value_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, handle);
        let unlanded: bool = |landing|::typer_unlanded(typer, value_type);
        let never: bool = |typed_trees|::never_type(@typer.output.types, value_type);
        transition unlanded || never {
            true -> value(typer, syntax, values, offset + 1),
            _ -> found(value_type)
        }
    }

    machine found(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// Each value meets the join's type exactly, by landing there, or as `Never`.
public machine admit_joined(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, values: |syntax_trees|::JoinedValues, result_type: u64 in Trapping)
crashes Trap
{
    transition { _ -> value(typer, syntax, values, result_type, 0 as +Trapping) }

    machine value(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, values: |syntax_trees|::JoinedValues, result_type: u64 in Trapping, offset: u64 in Trapping) {
        transition offset < values.count && typer.output.accepted {
            true -> admission(typer, syntax, values, result_type, offset),
            _ -> done()
        }
    }

    machine admission(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, values: |syntax_trees|::JoinedValues, result_type: u64 in Trapping, offset: u64 in Trapping) {
        let handle: u64 in Trapping = |syntax_trees|::joined_value(syntax, values, offset);
        let admission: |admission|::Admission = |admission|::typer_admission(typer, syntax, result_type, handle);
        transition admission {
            |admission|::Admission::Exact -> value(typer, syntax, values, result_type, offset + 1),
            |admission|::Admission::Landed -> adapted(typer, syntax, values, result_type, offset, handle),
            |admission|::Admission::SharedReborrow -> adapted(typer, syntax, values, result_type, offset, handle),
            _ -> incompatible(typer, syntax, handle, admission)
        }
    }

    machine adapted(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        values: |syntax_trees|::JoinedValues,
        result_type: u64 in Trapping,
        offset: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        let admitted: bool = |admission|::typer_admit(typer, syntax, result_type, handle, false);
        transition { _ -> value(typer, syntax, values, result_type, offset + 1) }
    }

    machine incompatible(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping, admission: |admission|::Admission) {
        let value: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        transition admission {
            |admission|::Admission::OutOfRange -> rejected(typer, value, |typed_trees|::TypeDiagnosticCode::LiteralOutOfRange),
            |admission|::Admission::Fraction -> rejected(typer, value, |typed_trees|::TypeDiagnosticCode::AnonymousFraction),
            _ -> rejected(typer, value, |typed_trees|::TypeDiagnosticCode::MismatchedTypes)
        }
    }

    machine rejected(typer: @mutable |typing_state|::Typer, value: |syntax_trees|::Expression, code: |typed_trees|::TypeDiagnosticCode) {
        |typed_trees|::typing_reject(@mutable typer.output, code, value.source_span);
    }

    machine done() {}
}

// The unlanded type values of no fixed type share: an anonymous choice for
// anonymous numbers and choices, one anonymous array type for anonymous
// arrays, or, when every value is `Never`, the first value's type. A value
// whose shape differs from those before it is named, its handle plus one.
public data UnlandedJoin [copy] {
    joined: u64 in Trapping;
    mismatch: u64 in Trapping;
}

public machine unlanded_join(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, values: |syntax_trees|::JoinedValues) -> UnlandedJoin
crashes Trap
{
    let choice_row: |typed_trees|::TypeRow = |typed_trees|::type_row_of(|typed_trees|::TypeKind::AnonymousChoice);
    let choice: u64 in Trapping = |typed_trees|::type_table_intern(@mutable typer.output.types, choice_row);
    transition { _ -> value(typer, syntax, values, choice, 0 as +Trapping, 0 as +Trapping) }

    machine value(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, values: |syntax_trees|::JoinedValues, choice: u64 in Trapping, shape: u64 in Trapping, offset: u64 in Trapping) -> UnlandedJoin {
        transition offset < values.count {
            true -> candidate(typer, syntax, values, choice, shape, offset),
            _ -> finished(typer, syntax, values, shape)
        }
    }

    machine candidate(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, values: |syntax_trees|::JoinedValues, choice: u64 in Trapping, shape: u64 in Trapping, offset: u64 in Trapping) -> UnlandedJoin {
        let handle: u64 in Trapping = |syntax_trees|::joined_value(syntax, values, offset);
        let value_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, handle);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typer.output.types, value_type);
        let value_shape: u64 in Trapping = scalar_or_array(row, value_type, choice);
        transition value_shape == 0 || value_shape == shape {
            true -> value(typer, syntax, values, choice, shape, offset + 1),
            _ -> differing(typer, syntax, values, choice, shape, offset, handle, value_shape)
        }
    }

    machine differing(
        typer: @mutable |typing_state|::Typer,
        syntax: @|syntax_trees|::SyntaxTrees,
        values: |syntax_trees|::JoinedValues,
        choice: u64 in Trapping,
        shape: u64 in Trapping,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        value_shape: u64 in Trapping
    ) -> UnlandedJoin {
        transition shape == 0 {
            true -> value(typer, syntax, values, choice, value_shape, offset + 1),
            _ -> mismatched(handle)
        }
    }

    machine finished(typer: @mutable |typing_state|::Typer, syntax: @|syntax_trees|::SyntaxTrees, values: |syntax_trees|::JoinedValues, shape: u64 in Trapping) -> UnlandedJoin {
        let first: u64 in Trapping = |syntax_trees|::joined_value(syntax, values, 0 as +Trapping);
        let first_type: u64 in Trapping = |typed_trees|::typing_expression_type(@typer.output, first);
        transition shape > 0 {
            true -> joined(shape),
            _ -> joined(first_type)
        }
    }

    machine joined(handle: u64 in Trapping) -> UnlandedJoin {
        UnlandedJoin { joined: handle, mismatch: 0 as +Trapping }
    }

    machine mismatched(handle: u64 in Trapping) -> UnlandedJoin {
        UnlandedJoin { joined: 0 as +Trapping, mismatch: handle + 1 }
    }
}

// An unlanded value's shape: the anonymous choice for a scalar, its own type
// for an anonymous array; zero for `Never`.
machine scalar_or_array(row: |typed_trees|::TypeRow, handle: u64 in Trapping, choice: u64 in Trapping) -> u64 in Trapping {
    transition row.kind {
        |typed_trees|::TypeKind::AnonymousArray -> shaped(handle),
        |typed_trees|::TypeKind::AnonymousInteger -> shaped(choice),
        |typed_trees|::TypeKind::AnonymousFloat -> shaped(choice),
        |typed_trees|::TypeKind::AnonymousChoice -> shaped(choice),
        _ -> shaped(0 as +Trapping)
    }

    machine shaped(shape: u64 in Trapping) -> u64 in Trapping {
        shape
    }
}
