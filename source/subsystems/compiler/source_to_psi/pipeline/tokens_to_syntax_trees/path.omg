use pipeline/tokens_to_syntax_trees/input.omg;
use pipeline/tokens_to_syntax_trees/parser_state.omg as parser;

use representations/syntax_trees/syntax_trees.omg;
use representations/tokens/tokens.omg;

// `name {:: name}`, a name path, entered at its first name. Its members
// append to `SyntaxTrees::members` and its row to `SyntaxTrees::name_paths`;
// the row's handle lands in `name_path_result`. `missing` is the caller's
// diagnostic for an absent first name; a name missing after `::` is
// `ExpectedPathMember`.
public machine parse_name_path(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, missing: |syntax_trees|::ParseDiagnosticCode)
crashes Trap
{
    let first_member: u64 in Trapping = parser.output.member_count as +Trapping;
    |input|::expect_path_head(parser, input, missing);
    let saved_name_start: u64 in Trapping = parser.name_start;
    transition parser.output.accepted {
        true -> member(parser, input, first_member, saved_name_start),
        _ -> done()
    }

    machine member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, first_member: u64 in Trapping, start: u64 in Trapping) {
        let name_start: u64 in Trapping = parser.name_start;
        let name_end: u64 in Trapping = parser.name_end;
        append_member(parser, input, name_start, name_end);
        transition parser.output.accepted {
            true -> separator(parser, input, first_member, start),
            _ -> done()
        }
    }

    machine separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, first_member: u64 in Trapping, start: u64 in Trapping) {
        let more: bool = |input|::at_path_separator(parser, input)
            && !|input|::at_expression_arguments(parser, input);
        transition more {
            true -> next_member(parser, input, first_member, start),
            _ -> retain_capacity(parser, input, first_member, start)
        }
    }

    machine next_member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, first_member: u64 in Trapping, start: u64 in Trapping) {
        |input|::take_current(parser, input);
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedPathMember);
        transition parser.output.accepted {
            true -> member(parser, input, first_member, start),
            _ -> done()
        }
    }

    machine retain_capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, first_member: u64 in Trapping, start: u64 in Trapping) {
        transition parser.output.name_path_count < 2048 {
            true -> retain(parser, first_member, start),
            _ -> full(parser, input)
        }
    }

    machine retain(parser: @mutable |parser|::Parser, first_member: u64 in Trapping, start: u64 in Trapping) {
        parser.name_path_result = parser.output.name_path_count as +Trapping;
        parser.output.name_paths[parser.output.name_path_count] = |syntax_trees|::NamePath {
            first_member: first_member,
            member_count: (parser.output.member_count as +Trapping) - first_member,
            first_argument: 0 as +Trapping,
            argument_count: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, start, parser.name_end)
        };
        parser.output.name_path_count = parser.output.name_path_count + 1;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::NamePathCapacityExceeded);
    }

    machine done() {}
}

// Append one name to `SyntaxTrees::members`.
machine append_member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, end: u64 in Trapping)
crashes Trap
{
    transition parser.output.member_count < 32000 {
        true -> append(parser, start, end),
        _ -> full(parser, input)
    }

    machine append(parser: @mutable |parser|::Parser, start: u64 in Trapping, end: u64 in Trapping) {
        parser.output.members[parser.output.member_count] = |parser|::identifier_span(parser, start, end);
        parser.output.member_count = parser.output.member_count + 1;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::PathMemberCapacityExceeded);
    }
}
