use pipeline/tokens_to_syntax_trees/conformance.omg;
use pipeline/tokens_to_syntax_trees/constant.omg;
use pipeline/tokens_to_syntax_trees/data.omg as data_file;
use pipeline/tokens_to_syntax_trees/definition.omg;
use pipeline/tokens_to_syntax_trees/domain.omg;
use pipeline/tokens_to_syntax_trees/input.omg;
use pipeline/tokens_to_syntax_trees/machine.omg as machine_parser;
use pipeline/tokens_to_syntax_trees/parser_state.omg;
use pipeline/tokens_to_syntax_trees/path.omg;
use pipeline/tokens_to_syntax_trees/proposition.omg;
use pipeline/tokens_to_syntax_trees/traits.omg;

use representations/source_files/source.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/tokens/tokens.omg;

// Whole-file sequencing and use-item grammar. Every other declaration is
// delegated to its grammar machine (data.omg, machine.omg, traits.omg,
// conformance.omg, domain.omg, constant.omg, proposition.omg,
// definition.omg), the shared type grammar lives in types.omg, and input.omg
// remains the only token/cursor behavior owner. A root is `[public]` and then a
// declaration: `use`, `data`, `machine` and `let` by keyword; `boundary`,
// `trait`, `domain`, `const` and `proposition` by contextual word; and, led
// by a name, a target-scoped `target [boundary] machine` or a named
// conformance `Name [<...>] satisfies`. The retired `boundary requirement` and `operator`
// introducers reject at their word. Bounded array reads carry their
// collection's Trapping policy, so parsing publishes the same crash route
// its callees do.
public machine parse(
    parser: @mutable |parser_state|::Parser,
    source: |source|::SourceId,
    source_length: u64 in Trapping,
    input: @|tokens|::TokenStream
)
crashes Trap
{
    |input|::begin_unit(parser, source, source_length);
    transition { _ -> next_root(parser, input) }

    machine next_root(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        transition parser.cursor < input.token_count {
            true -> classify_root(parser, input),
            _ -> done()
        }
    }

    machine classify_root(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        |input|::load_current(parser, input);
        let token: |tokens|::Token = input.tokens[parser.current_index];
        parser.item_start = token.start;
        transition token.kind {
            |tokens|::TokenKind::Keyword { keyword, .. } -> classify_root_keyword(parser, input,
                keyword,
                token.start,
                token.end
            ),
            |tokens|::TokenKind::Identifier -> named_root(parser, input, false),
            _ -> unsupported_root(parser, token.start,
                token.end
            )
        }
    }


    machine classify_root_keyword(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream,
        keyword: |tokens|::KeywordKind,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        let head: |machine_parser|::MachineHead = root_machine_head(parser.item_start, false);
        transition keyword {
            |tokens|::KeywordKind::Use -> prepare_use(parser, input),
            |tokens|::KeywordKind::Data -> dispatch_data(parser, input, false, false),
            |tokens|::KeywordKind::Machine -> dispatch_machine(parser, input, head),
            |tokens|::KeywordKind::Let -> dispatch_definition(parser, input, false, false),
            |tokens|::KeywordKind::Public -> public_item_root(parser, input),
            _ -> unsupported_root(parser, start, end)
        }
    }

    machine public_item_root(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
                |input|::parser_advance(parser, input);
        transition parser.cursor < input.token_count {
            true -> public_item_keyword(parser, input),
            _ -> expected_item_after_public_at_end(parser)
        }
    }

    machine public_item_keyword(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        |input|::load_current(parser, input);
        let token: |tokens|::Token = input.tokens[parser.current_index];
        let head: |machine_parser|::MachineHead = root_machine_head(parser.item_start, true);
        transition token.kind {
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::Data, .. } -> dispatch_data(parser, input, true, false),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::Machine, .. } -> dispatch_machine(parser, input, head),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::Let, .. } -> dispatch_definition(parser, input, true, false),
            |tokens|::TokenKind::Identifier -> named_root(parser, input, true),
            _ -> expected_item_after_public(parser, token.start,
                token.end
            )
        }
    }

    // A root led by a name: a contextual introducer, a target name before
    // `machine` or `boundary machine`, or a conformance's name.
    machine named_root(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let crossing: bool = |input|::at_word(parser, input, "boundary");
        transition crossing {
            true -> boundary_root(parser, input, is_public),
            _ -> trait_word(parser, input, is_public)
        }
    }

    machine trait_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let requirements: bool = |input|::at_word(parser, input, "trait");
        transition requirements {
            true -> dispatch_trait(parser, input, is_public, false),
            _ -> domain_word(parser, input, is_public)
        }
    }

    machine domain_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let classification: bool = |input|::at_word(parser, input, "domain");
        transition classification {
            true -> dispatch_domain(parser, input, is_public),
            _ -> constant_word(parser, input, is_public)
        }
    }

    machine constant_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let constant: bool = |input|::at_word(parser, input, "const");
        transition constant {
            true -> dispatch_constant(parser, input, is_public),
            _ -> proposition_word(parser, input, is_public)
        }
    }

    machine proposition_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let proposition: bool = |input|::at_word(parser, input, "proposition");
        transition proposition {
            true -> dispatch_proposition(parser, input, is_public),
            _ -> measure_word(parser, input, is_public)
        }
    }

    // `measure Owner::Name ...` declares a ranking view, parsed as a root
    // machine in the `Measure` container; `public measure` rejects, as declared
    // measures are package-private (wiki/spec/language/termination.md).
    machine measure_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let ranking: bool = |input|::at_word(parser, input, "measure");
        transition ranking {
            true -> dispatch_measure(parser, input, is_public),
            _ -> operator_word(parser, input, is_public)
        }
    }

    machine dispatch_measure(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let head: |machine_parser|::MachineHead = measure_head(parser.item_start);
        transition is_public {
            true -> reject_here(parser, input, |syntax_trees|::ParseDiagnosticCode::MeasureNotPublic),
            _ -> dispatch_machine(parser, input, head)
        }
    }

    // A token binds to an ordinary `machine + Name(...)` declaration; there
    // is no separate `operator` introducer.
    machine operator_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let retired: bool = |input|::at_word(parser, input, "operator");
        transition retired {
            true -> reject_here(parser, input, |syntax_trees|::ParseDiagnosticCode::RetiredOperatorDeclaration),
            _ -> target_machine_word(parser, input, is_public)
        }
    }

    machine target_machine_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let scoped: bool = |input|::next_is_keyword(parser, input, |tokens|::KeywordKind::Machine);
        transition scoped {
            true -> target_machine(parser, input, is_public),
            _ -> target_boundary_word(parser, input, is_public)
        }
    }

    machine target_boundary_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let scoped: bool = |input|::next_is_word(parser, input, "boundary");
        transition scoped {
            true -> target_boundary(parser, input, is_public),
            _ -> conformance_word(parser, input, is_public)
        }
    }

    machine conformance_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let satisfies: bool = |input|::next_is_word(parser, input, "satisfies");
        let generic: bool = |input|::next_is_punctuation(parser, input, |tokens|::PunctuationKind::Less);
        transition satisfies || generic {
            true -> dispatch_conformance(parser, input, is_public),
            _ -> unnamed_root(parser, input, is_public)
        }
    }

    machine unnamed_root(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        transition is_public {
            true -> reject_here(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedItemAfterPub),
            _ -> reject_here(parser, input, |syntax_trees|::ParseDiagnosticCode::UnsupportedRootItem)
        }
    }

    // `boundary data`, `boundary machine`, `boundary trait` and the
    // assumption `boundary let`. The carrier-owned `boundary requirement` and
    // the `boundary operator` introducer are retired; a boundary operation is
    // a requirement of a boundary trait.
    machine boundary_root(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        |input|::take_current(parser, input);
        let opaque: bool = |input|::at_keyword(parser, input, |tokens|::KeywordKind::Data);
        let assumed: bool = |input|::at_keyword(parser, input, |tokens|::KeywordKind::Let);
        transition opaque {
            true -> dispatch_data(parser, input, is_public, true),
            _ -> boundary_let(parser, input, is_public, assumed)
        }
    }

    machine boundary_let(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool, assumed: bool) {
        transition assumed {
            true -> dispatch_definition(parser, input, is_public, true),
            _ -> boundary_machine_word(parser, input, is_public)
        }
    }

    machine boundary_machine_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let crossing: bool = |input|::at_keyword(parser, input, |tokens|::KeywordKind::Machine);
        let root_head: |machine_parser|::MachineHead = root_machine_head(parser.item_start, is_public);
        let head: |machine_parser|::MachineHead = boundary_machine_head(root_head);
        transition crossing {
            true -> dispatch_machine(parser, input, head),
            _ -> boundary_trait_word(parser, input, is_public)
        }
    }

    machine boundary_trait_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let requirements: bool = |input|::at_word(parser, input, "trait");
        transition requirements {
            true -> dispatch_trait(parser, input, is_public, true),
            _ -> boundary_requirement_word(parser, input)
        }
    }

    machine boundary_requirement_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        let retired: bool = |input|::at_word(parser, input, "requirement");
        transition retired {
            true -> reject_here(parser, input, |syntax_trees|::ParseDiagnosticCode::RetiredBoundaryRequirement),
            _ -> boundary_operator_word(parser, input)
        }
    }

    machine boundary_operator_word(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        let retired: bool = |input|::at_word(parser, input, "operator");
        transition retired {
            true -> reject_here(parser, input, |syntax_trees|::ParseDiagnosticCode::RetiredOperatorDeclaration),
            _ -> reject_here(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedBoundaryDeclaration)
        }
    }

    // `target machine ...`: the leading name is the family's target.
    machine target_machine(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        |input|::take_current(parser, input);
        let root_head: |machine_parser|::MachineHead = root_machine_head(parser.item_start, is_public);
        let head: |machine_parser|::MachineHead = target_machine_head(root_head, parser.token_start, parser.token_end);
        transition { _ -> dispatch_machine(parser, input, head) }
    }

    machine target_boundary(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        |input|::take_current(parser, input);
        let root_head: |machine_parser|::MachineHead = root_machine_head(parser.item_start, is_public);
        let target_head: |machine_parser|::MachineHead = target_machine_head(root_head, parser.token_start, parser.token_end);
        let head: |machine_parser|::MachineHead = boundary_machine_head(target_head);
        |input|::take_current(parser, input);
        let crossing: bool = |input|::at_keyword(parser, input, |tokens|::KeywordKind::Machine);
        transition crossing {
            true -> dispatch_machine(parser, input, head),
            _ -> reject_here(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedTargetScopedMachine)
        }
    }

    machine dispatch_data(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool, is_boundary: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        |data_file|::parse_data(parser, input, item_start, is_public, is_boundary);
        transition { _ -> declared(parser, input) }
    }

    machine dispatch_machine(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, head: |machine_parser|::MachineHead) {
        |machine_parser|::parse_machine(parser, input, head);
        transition { _ -> declared(parser, input) }
    }

    machine dispatch_trait(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool, is_boundary: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        |traits|::parse_trait(parser, input, item_start, is_public, is_boundary);
        transition { _ -> declared(parser, input) }
    }

    machine dispatch_conformance(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        |conformance|::parse_conformance(parser, input, item_start, is_public);
        transition { _ -> declared(parser, input) }
    }

    machine dispatch_domain(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        |domain|::parse_domain(parser, input, item_start, is_public);
        transition { _ -> declared(parser, input) }
    }

    machine dispatch_constant(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        |constant|::parse_constant(parser, input, item_start, is_public);
        transition { _ -> declared(parser, input) }
    }

    machine dispatch_definition(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool, is_boundary: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        |definition|::parse_definition(parser, input, item_start, is_public, is_boundary);
        transition { _ -> declared(parser, input) }
    }

    machine dispatch_proposition(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, is_public: bool) {
        let item_start: u64 in Trapping = parser.item_start;
        |proposition|::parse_proposition(parser, input, item_start, is_public);
        transition { _ -> declared(parser, input) }
    }

    machine declared(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.accepted {
            true -> next_root(parser, input),
            _ -> done()
        }
    }

    machine reject_here(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::reject_current(parser, input, code);
    }

    machine unsupported_root(
        parser: @mutable |parser_state|::Parser,
        start: u64 in Trapping,
        end: u64 in Trapping
    ) {
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::UnsupportedRootItem, parser.source, start, end);
    }

    machine prepare_use(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.root_count < 4096 {
            true -> use_capacity(parser, input),
            _ -> root_full(parser, input)
        }
    }

    machine root_full(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::RootCapacityExceeded,
            parser.source,
            token.start,
            token.end
        );
    }

    machine use_capacity(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.use_count < 4096 {
            true -> use_start(parser, input),
            _ -> use_full(parser, input)
        }
    }

    machine use_full(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::UseCapacityExceeded,
            parser.source,
            token.start,
            token.end
        );
    }

    machine use_start(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        parser.use_first_member = parser.output.member_count as +Trapping;
        |input|::take_current(parser, input);
        parser.use_rooted = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace);
        transition parser.use_rooted {
            true -> use_root(parser, input),
            false -> component(parser, input)
        }
    }

    machine use_root(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedPathMember);
        let root: |syntax_trees|::IdentifierSpan = |parser_state|::identifier_span(parser, parser.name_start, parser.name_end);
        transition parser.output.accepted {
            true -> root_end(parser, input, root),
            false -> done()
        }
    }

    machine root_end(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, root: |syntax_trees|::IdentifierSpan) {
        |path|::append_member(parser, input, root.source_span.span.start, root.source_span.span.end);
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace, |syntax_trees|::ParseDiagnosticCode::ExpectedPathMember);
        transition parser.output.accepted {
            true -> root_slash(parser, input),
            false -> done()
        }
    }

    machine root_slash(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Slash, |syntax_trees|::ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon);
        transition parser.output.accepted {
            true -> component(parser, input),
            false -> done()
        }
    }

    machine component(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        |input|::load_current(parser, input);
        transition parser.current_present {
            true -> component_start(parser, input),
            false -> expected_member_at_end(parser)
        }
    }

    machine component_start(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        parser.use_alias_token = parser.current_index;
        let token: |tokens|::Token = input.tokens[parser.current_index];
        transition file_component_token(token.kind) {
            true -> piece(parser, input, token.start, file_alias_token(token.kind)),
            false -> expected_member(parser, token.start, token.end)
        }
    }

    // A component can span several adjacent tokens, as in value-cell.omg.
    // Only a stem lexed as one identifier supplies a default alias.
    machine piece(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, implicit: bool) {
        |input|::take_current(parser, input);
        let end: u64 in Trapping = parser.token_end;
        |input|::load_current(parser, input);
        transition parser.current_present {
            true -> after_piece(parser, input, start, end, implicit),
            false -> expected_separator_at_end(parser)
        }
    }

    machine after_piece(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, end: u64 in Trapping, implicit: bool) {
        let next: |tokens|::Token = input.tokens[parser.current_index];
        transition next.start == end && file_component_token(next.kind) {
            true -> piece(parser, input, start, false),
            false -> component_end(parser, input, start, end, implicit)
        }
    }

    machine component_end(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, end: u64 in Trapping, implicit: bool) {
        |path|::append_member(parser, input, start, end);
        transition parser.output.accepted {
            true -> path_separator(parser, input, start, end, implicit),
            false -> done()
        }
    }

    machine path_separator(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, end: u64 in Trapping, implicit: bool) {
        let slash: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Slash);
        let dot: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Dot);
        transition {
            slash -> directory(parser, input),
            dot -> extension(parser, input, start, end, implicit),
            _ -> bad_path(parser, input)
        }
    }

    machine directory(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> component(parser, input) }
    }

    machine extension(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, end: u64 in Trapping, implicit: bool) {
        |input|::take_current(parser, input);
        let omg: bool = |input|::at_word(parser, input, "omg");
        transition omg {
            true -> alias(parser, input, start, end, implicit),
            false -> bad_path(parser, input)
        }
    }

    machine alias(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, end: u64 in Trapping, implicit: bool) {
        |input|::take_current(parser, input);
        let renamed: bool = |input|::at_keyword(parser, input, |tokens|::KeywordKind::As);
        let default_alias: |syntax_trees|::IdentifierSpan = |parser_state|::identifier_span(parser, start, end);
        transition {
            renamed -> explicit_alias(parser, input),
            implicit -> semicolon(parser, input, default_alias),
            _ -> bad_alias(parser, input)
        }
    }

    machine explicit_alias(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        |input|::load_current(parser, input);
        transition parser.current_present {
            true -> alias_token(parser, input),
            false -> bad_alias(parser, input)
        }
    }

    machine alias_token(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        parser.use_alias_token = parser.current_index;
        let token: |tokens|::Token = input.tokens[parser.current_index];
        let name: |syntax_trees|::IdentifierSpan = |parser_state|::identifier_span(parser, token.start, token.end);
        transition file_alias_token(token.kind) {
            true -> take_alias(parser, input, name),
            false -> bad_alias(parser, input)
        }
    }

    machine take_alias(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, alias: |syntax_trees|::IdentifierSpan) {
        |input|::take_current(parser, input);
        transition { _ -> semicolon(parser, input, alias) }
    }

    machine semicolon(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, alias: |syntax_trees|::IdentifierSpan) {
        parser.use_alias = alias;
        let terminated: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Semicolon);
        let end: u64 in Trapping = input.tokens[parser.current_index].end;
        transition terminated {
            true -> check_alias(parser, input, end),
            false -> bad_path(parser, input)
        }
    }

    // Compare decoded identifier bytes only with imports of this unit.
    machine check_alias(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, item_end: u64 in Trapping) {
        let token: |tokens|::Token = input.tokens[parser.use_alias_token];
        let end: u64 in Trapping = token.decoded_start + token.decoded_length;
        let first: u64 in Trapping = parser.first_unit_use;
        let builtin: bool = reserved_file_alias(input, token);
        transition {
            builtin -> alias_rejection(parser, |syntax_trees|::ParseDiagnosticCode::BuiltinFileAlias),
            end <= 131072 && token.decoded_start <= end -> previous(parser, input, item_end, token.decoded_start, end, first),
            _ -> bad_alias(parser, input)
        }
    }
    machine previous(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, item_end: u64 in Trapping, start: u64 in Trapping, end: u64 in Trapping, index: u64 in Trapping) {
        transition index < parser.output.use_count && index < 4096 {
            true -> compare_alias(parser, input, item_end, start, end, index),
            false -> retain_use(parser, input, item_end)
        }
    }
    machine compare_alias(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, item_end: u64 in Trapping, start: u64 in Trapping, end: u64 in Trapping, index: u64 in Trapping)
    requires index < 4096
    {
        let prior: u64 in Trapping = parser.alias_tokens[index as -Trapping] as +Trapping;
        transition prior < 65536 && start <= end && end <= 131072 {
            true -> compare_spelling(parser, input, item_end, start, end, index, prior),
            false -> bad_alias(parser, input)
        }
    }
    machine compare_spelling(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, item_end: u64 in Trapping, start: u64 in Trapping, end: u64 in Trapping, index: u64 in Trapping, prior_index: u64 in Trapping)
    requires prior_index < 65536, start <= end, end <= 131072
    {
        let prior: |tokens|::Token = input.tokens[prior_index as -Trapping];
        let equal: bool = |input|::decoded_spells(input, prior.decoded_start, prior.decoded_length, @input.decoded[start as -Trapping..end as -Trapping]);
        transition equal {
            true -> alias_rejection(parser, |syntax_trees|::ParseDiagnosticCode::DuplicateFileAlias),
            false -> previous(parser, input, item_end, start, end, index + 1)
        }
    }
    machine alias_rejection(parser: @mutable |parser_state|::Parser, code: |syntax_trees|::ParseDiagnosticCode) {
        let span: |source|::SourceSpan = parser.use_alias.source_span;
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, code, span.source, span.span.start, span.span.end);
    }

    machine bad_alias(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedFileAlias);
    }

    machine bad_path(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon);
    }

    machine retain_use(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, item_end: u64 in Trapping) {
        transition parser.output.use_count < 4096 {
            true -> retain_use_bounded(parser, input, item_end),
            _ -> retained_capacity_lost(parser)
        }
    }

    machine retain_use_bounded(parser: @mutable |parser_state|::Parser, input: @|tokens|::TokenStream, item_end: u64 in Trapping) {
        let use_index: u64 in Trapping = parser.output.use_count as +Trapping;
        parser.alias_tokens[parser.output.use_count] = parser.use_alias_token;
        parser.output.uses[parser.output.use_count] = |syntax_trees|::UseItem {
            rooted: parser.use_rooted,
            alias: parser.use_alias,
            first_member: parser.use_first_member,
            member_count: (parser.output.member_count as +Trapping) - parser.use_first_member,
            source_span: |parser_state|::parser_source_span(parser, parser.item_start, item_end)
        };
        parser.output.use_count = parser.output.use_count + 1;
        transition { _ -> retain_root(parser, input, item_end, use_index) }
    }

    machine retain_root(
        parser: @mutable |parser_state|::Parser,
        input: @|tokens|::TokenStream,
        item_end: u64 in Trapping,
        use_index: u64 in Trapping
    ) {
        transition parser.output.root_count < 4096 {
            true -> retain_root_bounded(parser, input, item_end, use_index),
            _ -> retained_capacity_lost(parser)
        }
    }

    machine retain_root_bounded(
        parser: @mutable |parser_state|::Parser,
        input: @|tokens|::TokenStream,
        item_end: u64 in Trapping,
        use_index: u64 in Trapping
    ) {
        parser.output.roots[parser.output.root_count] = |syntax_trees|::RootItem {
            kind: |syntax_trees|::RootItemKind::Use,
            item_index: use_index,
            source_span: |parser_state|::parser_source_span(parser, parser.item_start, item_end)
        };
        parser.output.root_count = parser.output.root_count + 1;
        parser.cursor = parser.cursor + 1;
        transition { _ -> next_root(parser, input) }
    }

    machine expected_item_after_public_at_end(parser: @mutable |parser_state|::Parser) {
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::ExpectedItemAfterPub, parser.source, parser.source_length, parser.source_length);
    }

    machine expected_item_after_public(parser: @mutable |parser_state|::Parser, start: u64 in Trapping, end: u64 in Trapping) {
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::ExpectedItemAfterPub, parser.source, start, end);
    }

    machine retained_capacity_lost(parser: @mutable |parser_state|::Parser) {
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::RootCapacityExceeded, parser.source, parser.item_start, parser.item_start);
    }

    machine expected_member_at_end(parser: @mutable |parser_state|::Parser) {
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::ExpectedPathMember, parser.source, parser.source_length, parser.source_length);
    }

    machine expected_member(parser: @mutable |parser_state|::Parser, start: u64 in Trapping, end: u64 in Trapping) {
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::ExpectedPathMember, parser.source, start, end);
    }

    machine expected_separator_at_end(parser: @mutable |parser_state|::Parser) {
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::ExpectedPathSeparatorOrSemicolon, parser.source, parser.source_length, parser.source_length);
    }

    machine done() { }
}

// The head of a root `[public] machine` declaration starting at `start`; the
// constructors below add a target name or `boundary`.
machine root_machine_head(start: u64 in Trapping, is_public: bool) -> |machine_parser|::MachineHead {
    |machine_parser|::MachineHead {
        start: start,
        is_public: is_public,
        has_target: false,
        target_start: 0 as +Trapping,
        target_end: 0 as +Trapping,
        is_boundary: false,
        container: |syntax_trees|::MachineContainer::Root
    }
}

machine measure_head(start: u64 in Trapping) -> |machine_parser|::MachineHead {
    |machine_parser|::MachineHead {
        start: start,
        is_public: false,
        has_target: false,
        target_start: 0 as +Trapping,
        target_end: 0 as +Trapping,
        is_boundary: false,
        container: |syntax_trees|::MachineContainer::Measure
    }
}

machine target_machine_head(head: |machine_parser|::MachineHead, start: u64 in Trapping, end: u64 in Trapping) -> |machine_parser|::MachineHead {
    |machine_parser|::MachineHead {
        start: head.start,
        is_public: head.is_public,
        has_target: true,
        target_start: start,
        target_end: end,
        is_boundary: head.is_boundary,
        container: head.container
    }
}

machine boundary_machine_head(head: |machine_parser|::MachineHead) -> |machine_parser|::MachineHead {
    |machine_parser|::MachineHead {
        start: head.start,
        is_public: head.is_public,
        has_target: head.has_target,
        target_start: head.target_start,
        target_end: head.target_end,
        is_boundary: true,
        container: head.container
    }
}

machine file_alias_token(kind: |tokens|::TokenKind) -> bool {
    transition kind { |tokens|::TokenKind::Identifier -> true, _ -> false }
}

machine file_component_token(kind: |tokens|::TokenKind) -> bool {
    transition kind {
        |tokens|::TokenKind::Identifier -> true,
        |tokens|::TokenKind::Keyword { .. } -> true,
        |tokens|::TokenKind::Integer { .. } -> true,
        |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Minus, .. } -> true,
        _ -> false
    }
}


// File aliases reserve the installed builtin spellings, including the entire
// i/u decimal width family. The token's decoded bytes are available at parse time.
machine reserved_file_alias(input: @|tokens|::TokenStream, token: |tokens|::Token) -> bool
crashes Trap
{
    let start: u64 in Trapping = token.decoded_start;
    let end: u64 in Trapping = start + token.decoded_length;
    transition start < end && end <= 131072 {
        true -> spelling(input, start, end),
        false -> false
    }
    machine spelling(input: @|tokens|::TokenStream, start: u64 in Trapping, end: u64 in Trapping) -> bool
    requires start < 131072
    {
        let first: u8 = input.decoded[start as -Trapping];
        transition first == 105 || first == 117 {
            true -> digits(input, start + 1, end),
            false -> named(input, start, end - start)
        }
    }
    machine digits(input: @|tokens|::TokenStream, index: u64 in Trapping, end: u64 in Trapping) -> bool {
        transition index < end && index < 131072 {
            true -> digit(input, index, end),
            false -> true
        }
    }
    machine digit(input: @|tokens|::TokenStream, index: u64 in Trapping, end: u64 in Trapping) -> bool
    requires index < 131072
    {
        let byte: u8 = input.decoded[index as -Trapping];
        transition byte >= 48 && byte <= 57 {
            true -> digits(input, index + 1, end),
            false -> false
        }
    }
    machine named(input: @|tokens|::TokenStream, start: u64 in Trapping, length: u64 in Trapping) -> bool {
        |input|::decoded_spells(input, start, length, "bool")
            || |input|::decoded_spells(input, start, length, "address")
            || |input|::decoded_spells(input, start, length, "f32")
            || |input|::decoded_spells(input, start, length, "f64")
            || |input|::decoded_spells(input, start, length, "Slice")
            || |input|::decoded_spells(input, start, length, "SyscallResult")
            || |input|::decoded_spells(input, start, length, "Terminal")
            || |input|::decoded_spells(input, start, length, "UInt")
            || |input|::decoded_spells(input, start, length, "Int")
            || |input|::decoded_spells(input, start, length, "AtomicBool")
            || |input|::decoded_spells(input, start, length, "AtomicU32")
            || |input|::decoded_spells(input, start, length, "AtomicU64")
    }
}
