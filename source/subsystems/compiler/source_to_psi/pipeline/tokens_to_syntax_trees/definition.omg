use pipeline/tokens_to_syntax_trees/expression.omg;
use pipeline/tokens_to_syntax_trees/generics.omg;
use pipeline/tokens_to_syntax_trees/input.omg;
use pipeline/tokens_to_syntax_trees/machine.omg as machine_file;
use pipeline/tokens_to_syntax_trees/types.omg;
use pipeline/tokens_to_syntax_trees/parser_state.omg as parser;

use representations/source_files/source.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/tokens/tokens.omg;

// `[public] [boundary] let Name [<generic parameters>] [(parameters)] : Type
// [= term];`, a named mathematical definition (wiki/spec/proofs/
// mathematical_bindings.md), entered at the `let` keyword. A checked
// definition gives its term after `=`; `boundary let` is the same signature
// without a term, an explicitly admitted assumption. The generic parameters
// and parameters share the machine grammars. The item and its root are
// retained at the closing `;`.
public machine parse_definition(
    parser: @mutable |parser|::Parser,
    input: @|tokens|::TokenStream,
    item_start: u64 in Trapping,
    is_public: bool,
    is_boundary: bool
)
crashes Trap
{
    parser.declaration_start = item_start;
    parser.declaration_is_public = is_public;
    parser.declaration_is_boundary = is_boundary;
    transition parser.output.definition_count < 256 {
        true -> keyword(parser, input),
        _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::DefinitionCapacityExceeded)
    }

    machine keyword(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        parser.declaration_first_generic = parser.output.generic_parameter_count as +Trapping;
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedDefinitionName);
        transition parser.output.accepted {
            true -> named(parser, input),
            _ -> done()
        }
    }

    machine named(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.declaration_name_start = parser.name_start;
        parser.declaration_name_end = parser.name_end;
        let generic: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Less);
        transition generic {
            true -> generics(parser, input),
            _ -> parameters(parser, input)
        }
    }

    machine generics(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |generics|::parse_generic_parameters(parser, input);
        transition parser.output.accepted {
            true -> parameters(parser, input),
            _ -> done()
        }
    }

    machine parameters(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |machine_file|::parse_parameters(parser, input);
        transition parser.output.accepted {
            true -> colon(parser, input),
            _ -> done()
        }
    }

    machine colon(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.declaration_first_parameter = parser.signature_first_parameter;
        parser.declaration_parameter_count = parser.signature_parameter_count;
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Colon, |syntax_trees|::ParseDiagnosticCode::ExpectedDefinitionColon);
        transition parser.output.accepted {
            true -> result_type(parser, input),
            _ -> done()
        }
    }

    machine result_type(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |types|::parse_type_reference(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedDefinitionType);
        let type_result: u64 in Trapping = parser.type_result;
        transition parser.output.accepted {
            true -> body(parser, input, type_result),
            _ -> done()
        }
    }

    // An assumption ends at its signature; a checked definition owes a term.
    machine body(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, result: u64 in Trapping) {
        transition parser.declaration_is_boundary {
            true -> end(parser, input, result, false, 0 as +Trapping),
            _ -> equals(parser, input, result)
        }
    }

    machine equals(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, result: u64 in Trapping) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Equal, |syntax_trees|::ParseDiagnosticCode::ExpectedDefinitionTerm);
        transition parser.output.accepted {
            true -> term(parser, input, result),
            _ -> done()
        }
    }

    machine term(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, result: u64 in Trapping) {
        |expression|::parse_expression(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedDefinitionTerm, true, true);
        let expression_result: u64 in Trapping = parser.expression_result;
        transition parser.output.accepted {
            true -> end(parser, input, result, true, expression_result),
            _ -> done()
        }
    }

    machine end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, result: u64 in Trapping, has_term: bool, term: u64 in Trapping) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Semicolon, |syntax_trees|::ParseDiagnosticCode::ExpectedDefinitionEnd);
        transition parser.output.accepted {
            true -> retain_capacity(parser, input, result, has_term, term),
            _ -> done()
        }
    }

    machine retain_capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, result: u64 in Trapping, has_term: bool, term: u64 in Trapping) {
        transition parser.output.definition_count < 256 {
            true -> root_capacity(parser, input, result, has_term, term),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::DefinitionCapacityExceeded)
        }
    }

    machine root_capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, result: u64 in Trapping, has_term: bool, term: u64 in Trapping) {
        transition parser.output.root_count < 4096 {
            true -> retain(parser, result, has_term, term),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::RootCapacityExceeded)
        }
    }

    machine retain(parser: @mutable |parser|::Parser, result: u64 in Trapping, has_term: bool, term: u64 in Trapping) {
        let definition: u64 in Trapping = parser.output.definition_count as +Trapping;
        let span: |source|::SourceSpan = |parser|::parser_source_span(parser, parser.declaration_start, parser.token_end);
        parser.output.definitions[parser.output.definition_count] = |syntax_trees|::DefinitionItem {
            name: |parser|::identifier_span(parser, parser.declaration_name_start, parser.declaration_name_end),
            first_generic_parameter: parser.declaration_first_generic,
            generic_parameter_count: (parser.output.generic_parameter_count as +Trapping) - parser.declaration_first_generic,
            first_parameter: parser.declaration_first_parameter,
            parameter_count: parser.declaration_parameter_count,
            result_type: result,
            has_term: has_term,
            term: term,
            is_boundary: parser.declaration_is_boundary,
            is_public: parser.declaration_is_public,
            source_span: span
        };
        parser.output.definition_count = parser.output.definition_count + 1;
        parser.output.roots[parser.output.root_count] = |syntax_trees|::RootItem {
            kind: |syntax_trees|::RootItemKind::Definition,
            item_index: definition,
            source_span: span
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    machine reject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::reject_current(parser, input, code);
    }

    machine done() {}
}
