use pipeline/tokens_to_syntax_trees/generics.omg;
use pipeline/tokens_to_syntax_trees/input.omg;
use pipeline/tokens_to_syntax_trees/traits.omg;
use pipeline/tokens_to_syntax_trees/types.omg;
use pipeline/tokens_to_syntax_trees/machine.omg as machine_parser;
use pipeline/tokens_to_syntax_trees/parser.omg;

use representations/source_files/source.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/tokens/tokens.omg;

// `[public] Name [<generic parameters>] satisfies Trait<arguments> { member* }`,
// entered at the implementation's name. The name identifies a closed map of
// machines, not a data subject: the satisfied trait application is one type
// reference, and every member is a checked machine with a body (machine.omg's
// grammar, contained by the conformance). The reference row
// `Trait::requirement = Path;` is retired, because reuse is an ordinary call
// from an inline member; any token other than `machine` at a member position
// rejects as `ExpectedConformanceMember`, as the Rust producer's conformance
// parser does (wiki/spec/language/conformances.md). The item and its root are
// retained at the closing `}`.
public machine parse_conformance(
    parser: @mutable |parser|::Parser,
    input: @|tokens|::TokenStream,
    item_start: u64 in Trapping,
    is_public: bool
)
crashes Trap
{
    parser.declaration_start = item_start;
    parser.declaration_is_public = is_public;
    transition parser.output.conformance_count < 256 {
        true -> implementation_name(parser, input),
        _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ConformanceCapacityExceeded)
    }

    machine implementation_name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.declaration_first_generic = parser.output.generic_parameter_count as +Trapping;
        |input|::take_current(parser, input);
        parser.declaration_name_start = parser.token_start;
        parser.declaration_name_end = parser.token_end;
        let generic: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Less);
        transition generic {
            true -> generics(parser, input),
            _ -> satisfies_word(parser, input)
        }
    }

    machine generics(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |generics|::parse_generic_parameters(parser, input);
        transition parser.output.accepted {
            true -> satisfies_word(parser, input),
            _ -> done()
        }
    }

    machine satisfies_word(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.declaration_generic_count = (parser.output.generic_parameter_count as +Trapping) - parser.declaration_first_generic;
        let relation: bool = |input|::at_word(parser, input, "satisfies");
        transition relation {
            true -> trait_application(parser, input),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedConformanceSatisfies)
        }
    }

    machine trait_application(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        |types|::parse_type_reference(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedConformanceTrait);
        parser.declaration_type = parser.type_result;
        transition parser.output.accepted {
            true -> body(parser, input),
            _ -> done()
        }
    }

    machine body(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace, |syntax_trees|::ParseDiagnosticCode::ExpectedConformanceBody);
        parser.declaration_first_machine = parser.output.machine_count as +Trapping;
        transition parser.output.accepted {
            true -> member(parser, input),
            _ -> done()
        }
    }

    machine member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace);
        transition closing {
            true -> close(parser, input),
            _ -> machine_member(parser, input)
        }
    }

    machine machine_member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let checked: bool = |input|::at_keyword(parser, input, |tokens|::KeywordKind::Machine);
        transition checked {
            true -> checked_member(parser, input),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedConformanceMember)
        }
    }

    machine checked_member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        let head: |machine_parser|::MachineHead = |traits|::member_machine_head(token.start, |syntax_trees|::MachineContainer::Conformance);
        |machine_parser|::parse_machine(parser, input, head);
        transition parser.output.accepted {
            true -> checked_body(parser, input),
            _ -> done()
        }
    }

    // A member supplies its requirement's implementation, so it has a
    // checked body; a bodyless one rejects at the `;` that ended it.
    machine checked_body(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let handle: u64 in Trapping = parser.machine_result;
        let checked: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(@parser.output, handle);
        transition checked.has_body {
            true -> member(parser, input),
            _ -> bodyless(parser)
        }
    }

    machine bodyless(parser: @mutable |parser|::Parser) {
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::ExpectedConformanceMachineBody,
            parser.source, parser.token_start, parser.token_end);
    }

    machine close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition parser.output.conformance_count < 256 {
            true -> root_capacity(parser, input),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ConformanceCapacityExceeded)
        }
    }

    machine root_capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.root_count < 4096 {
            true -> retain(parser),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::RootCapacityExceeded)
        }
    }

    machine retain(parser: @mutable |parser|::Parser) {
        let conformance: u64 in Trapping = parser.output.conformance_count as +Trapping;
        let span: |source|::SourceSpan = |parser|::parser_source_span(parser, parser.declaration_start, parser.token_end);
        parser.output.conformances[parser.output.conformance_count] = |syntax_trees|::ConformanceItem {
            name: |parser|::identifier_span(parser, parser.declaration_name_start, parser.declaration_name_end),
            first_generic_parameter: parser.declaration_first_generic,
            generic_parameter_count: parser.declaration_generic_count,
            trait_type: parser.declaration_type,
            first_machine: parser.declaration_first_machine,
            machine_count: (parser.output.machine_count as +Trapping) - parser.declaration_first_machine,
            is_public: parser.declaration_is_public,
            source_span: span
        };
        parser.output.conformance_count = parser.output.conformance_count + 1;
        parser.output.roots[parser.output.root_count] = |syntax_trees|::RootItem {
            kind: |syntax_trees|::RootItemKind::Conformance,
            item_index: conformance,
            source_span: span
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    machine reject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::reject_current(parser, input, code);
    }

    machine done() {}
}
