use representations/source_files/source.omg;
use pipeline/tokens_to_syntax_trees/expression_frames.omg as frames;
use pipeline/tokens_to_syntax_trees/input.omg;
use pipeline/tokens_to_syntax_trees/parser_state.omg as parser;
use pipeline/tokens_to_syntax_trees/path.omg;
use pipeline/tokens_to_syntax_trees/types.omg;

use representations/syntax_trees/syntax_trees.omg;
use representations/tokens/tokens.omg;

// Expression grammar: one shift-reduce pass over explicit stacks, so nested
// groups, calls, indexes, constructions and matches need no recursion.
// Precedence follows the reference grammar's two tiers, folded into one
// ladder: `||` 1, `&&` 2, `==`/`!=` 3, comparisons 4, then `|` 5, `^` 6, `&`
// 7, shifts 8, `+`/`-` 9, `*`/`/`/`%` 10, and prefix operators 11. Postfix
// suffixes (`.field`, `[index]`, `(arguments)`, `as Type`) apply to the
// operand at once, so they bind tighter than any prefix. Binary operators
// associate to the left. A membership `value in Domain {& Domain}` or
// `value in Domain {| Domain}` separates the tiers: it applies to the whole
// bitwise and arithmetic operand before it, and comparisons and the logical
// operators take its result. A value-position `match subject { pattern ->
// value, ... }` is an operand; its arms are `_` or a value pattern, separated
// by commas. A call's arguments, a construction's fields and a match's arms
// are staged on scratch stacks while their nested expressions append nodes,
// and are copied contiguously into their tables when the bracket closes.

// Parse one expression, leaving its handle in `expression_result`. `missing`
// is the caller's diagnostic for an absent first operand; constructions
// (`Path { field: value }`) are admitted only when `allow_construct` holds,
// since a transition subject's `{` opens its arms instead, and memberships
// only when `allow_membership` holds, since a ranking subject's `in` opens
// its rank range instead.
public machine parse_expression(
    parser: @mutable |parser|::Parser,
    input: @|tokens|::TokenStream,
    missing: |syntax_trees|::ParseDiagnosticCode,
    allow_construct: bool,
    allow_membership: bool
)
crashes Trap
{
    parser.expression_operand_depth = 0;
    parser.expression_operator_depth = 0;
    parser.expression_frame_depth = 0;
    parser.pending_argument_count = 0;
    parser.pending_field_count = 0;
    parser.pending_arm_count = 0;
    parser.expression_allow_construct = allow_construct;
    parser.expression_allow_membership = allow_membership;
    transition { _ -> operand(parser, input, missing) }

    machine operand(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::load_current(parser, input);
        transition parser.current_present {
            true -> operand_token(parser, input, code),
            _ -> reject(parser, input, code)
        }
    }

    machine operand_token(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        transition token.kind {
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Pipe, .. } -> path(parser, input),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Exclamation, .. } -> prefix(parser, input, |syntax_trees|::OperatorKind::Not),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Minus, .. } -> prefix(parser, input, |syntax_trees|::OperatorKind::Negate),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Dollar, .. } -> prefix(parser, input, |syntax_trees|::OperatorKind::Dereference),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Tilde, .. } -> prefix(parser, input, |syntax_trees|::OperatorKind::BitNot),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::At, .. } -> borrow(parser, input),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::LeftParen, .. } -> open_group(parser, input),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::LeftBracket, .. } -> open_array(parser, input),
            |tokens|::TokenKind::Integer { base, empty_digits, has_suffix, .. } -> integer(parser, input),
            |tokens|::TokenKind::Float { has_exponent, empty_exponent, has_suffix, .. } -> literal(parser, input, |syntax_trees|::ExpressionKind::Float),
            |tokens|::TokenKind::StringLiteral -> literal(parser, input, |syntax_trees|::ExpressionKind::String),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::True, .. } -> boolean(parser, input, true),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::False, .. } -> boolean(parser, input, false),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::Match, .. } -> match_open(parser, input),
            |tokens|::TokenKind::Keyword { keyword, .. } -> keyword_operand(parser, input, code, keyword),
            |tokens|::TokenKind::Identifier -> identifier_operand(parser, input),
            _ -> reject(parser, input, code)
        }
    }

    // `suspend [block]` and `block` acknowledge the operational effects of
    // the call they prefix, in that canonical order and once each. Followed
    // by `(` either word is an ordinary name.
    machine identifier_operand(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let suspends: bool = |input|::at_word(parser, input, "suspend");
        let blocks: bool = |input|::at_word(parser, input, "block");
        let moves: bool = |input|::at_word(parser, input, "move");
        let called: bool = |input|::next_is_punctuation(parser, input, |tokens|::PunctuationKind::LeftParen);
        transition (suspends || blocks || moves) && !called {
            true -> word_prefix(parser, input, suspends, blocks),
            _ -> path(parser, input)
        }
    }

    // `move place` spells an ownership transfer the transfer itself already
    // means (wiki/spec/language/ownership.md): the word is read and the
    // operand stands alone, as the reference compiler treats it.
    machine word_prefix(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, suspends: bool, blocks: bool) {
        transition suspends || blocks {
            true -> acknowledgement(parser, input, suspends),
            _ -> moved(parser, input)
        }
    }

    machine moved(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedOperand) }
    }

    machine acknowledgement(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, suspends: bool) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        |input|::take_current(parser, input);
        let then_suspend: bool = |input|::at_word(parser, input, "suspend");
        let then_block: bool = |input|::at_word(parser, input, "block");
        transition suspends {
            true -> after_suspend(parser, input, token.start, then_suspend, then_block),
            _ -> after_block(parser, input, token.start, then_suspend, then_block)
        }
    }

    machine after_suspend(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        start: u64 in Trapping,
        then_suspend: bool,
        then_block: bool
    ) {
        transition then_suspend {
            true -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::DuplicateCallAcknowledgement),
            _ -> suspend_alone(parser, input, start, then_block)
        }
    }

    machine suspend_alone(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, then_block: bool) {
        transition then_block {
            true -> suspend_block(parser, input, start),
            _ -> acknowledge(parser, input, |syntax_trees|::OperatorKind::Suspend, start)
        }
    }

    machine suspend_block(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping) {
        |input|::take_current(parser, input);
        let again: bool = |input|::at_word(parser, input, "block");
        let reversed: bool = |input|::at_word(parser, input, "suspend");
        transition again || reversed {
            true -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::DuplicateCallAcknowledgement),
            _ -> acknowledge(parser, input, |syntax_trees|::OperatorKind::SuspendBlock, start)
        }
    }

    machine after_block(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        start: u64 in Trapping,
        then_suspend: bool,
        then_block: bool
    ) {
        transition then_suspend {
            true -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::CallAcknowledgementOrder),
            _ -> block_alone(parser, input, start, then_block)
        }
    }

    machine block_alone(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, then_block: bool) {
        transition then_block {
            true -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::DuplicateCallAcknowledgement),
            _ -> acknowledge(parser, input, |syntax_trees|::OperatorKind::Block, start)
        }
    }

    // An acknowledgement binds like a prefix operator: it applies to the
    // whole postfix expression that follows.
    machine acknowledge(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operator: |syntax_trees|::OperatorKind, start: u64 in Trapping) {
        push_operator(parser, input, operator, 11 as +Trapping, true, start);
        transition parser.output.accepted {
            true -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedOperand),
            _ -> done()
        }
    }

    // As in every name position, a keyword other than `self` is an ordinary
    // name here (`data(...)` targets a state named `data`).
    machine keyword_operand(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode, keyword: |tokens|::KeywordKind) {
        transition keyword {
            |tokens|::KeywordKind::SelfValue -> logical_subject(parser, input, code),
            _ -> path(parser, input)
        }
    }

    // Predicate `self` is the fixed logical subject. Outside a domain or data
    // `requires` it is not a name (wiki/spec/language/domains.md).
    machine logical_subject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        transition parser.expression_allow_subject {
            true -> path(parser, input),
            _ -> reject(parser, input, code)
        }
    }

    machine prefix(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operator: |syntax_trees|::OperatorKind) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        push_operator(parser, input, operator, 11 as +Trapping, true, token.start);
        transition parser.output.accepted {
            true -> prefix_taken(parser, input),
            _ -> done()
        }
    }

    machine prefix_taken(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedOperand) }
    }

    // `@mutable` borrows exclusively, `@write` exclusively without observation;
    // a bare `@` borrows shared.
    machine borrow(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let start: u64 in Trapping = parser.token_start;
        let marked_mutable: bool = |input|::at_word(parser, input, "mutable");
        let write_only: bool = |input|::at_word(parser, input, "write");
        transition marked_mutable {
            true -> accessed_borrow(parser, input, |syntax_trees|::OperatorKind::BorrowMutable, start),
            _ -> unqualified_borrow(parser, input, start, write_only)
        }
    }

    machine unqualified_borrow(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, write_only: bool) {
        transition write_only {
            true -> accessed_borrow(parser, input, |syntax_trees|::OperatorKind::BorrowWrite, start),
            _ -> borrow_operator(parser, input, |syntax_trees|::OperatorKind::Borrow, start)
        }
    }

    machine accessed_borrow(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operator: |syntax_trees|::OperatorKind, start: u64 in Trapping) {
        |input|::take_current(parser, input);
        transition { _ -> borrow_operator(parser, input, operator, start) }
    }

    machine borrow_operator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operator: |syntax_trees|::OperatorKind, start: u64 in Trapping) {
        push_operator(parser, input, operator, 11 as +Trapping, true, start);
        transition parser.output.accepted {
            true -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedOperand),
            _ -> done()
        }
    }

    machine literal(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, kind: |syntax_trees|::ExpressionKind) {
        |input|::take_current(parser, input);
        transition { _ -> literal_node(parser, input, kind, 0 as +Trapping) }
    }

    machine integer(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let literal_handle: u64 in Trapping = |input|::take_integer_literal(parser, input);
        transition parser.output.accepted {
            true -> literal_node(parser, input, |syntax_trees|::ExpressionKind::Integer, literal_handle),
            _ -> done()
        }
    }

    machine literal_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, kind: |syntax_trees|::ExpressionKind, literal_handle: u64 in Trapping) {
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: kind,
            operator: |syntax_trees|::OperatorKind::None,
            left: 0 as +Trapping,
            right: 0 as +Trapping,
            first: 0 as +Trapping,
            count: 0 as +Trapping,
            flag: false,
            name: |parser|::identifier_span(parser, parser.token_start, parser.token_end),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: literal_handle,
            source_span: |parser|::parser_source_span(parser, parser.token_start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    machine boolean(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, value: bool) {
        |input|::take_current(parser, input);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Boolean,
            operator: |syntax_trees|::OperatorKind::None,
            left: 0 as +Trapping,
            right: 0 as +Trapping,
            first: 0 as +Trapping,
            count: 0 as +Trapping,
            flag: value,
            name: |parser|::identifier_span(parser, parser.token_start, parser.token_end),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, parser.token_start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    // `name (:: name)*`: one name is a Name, which holds its identifier in
    // `name` and stores no member row; a `::` makes a Path, whose members,
    // the first included, fill a contiguous range of `SyntaxTrees::members`.
    machine path(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        parser.path_start = token.start;
        parser.path_first_member = parser.output.member_count as +Trapping;
        transition token.kind {
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Pipe, .. } -> selected_path(parser, input),
            _ -> ordinary_path(parser, input)
        }
    }

    machine ordinary_path(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> path_head(parser, input) }
    }

    machine selected_path(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_path_head(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedExpressionPathMember);
        transition parser.output.accepted {
            true -> path_head(parser, input),
            false -> done()
        }
    }

    machine path_head(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let qualified: bool = |input|::at_path_separator(parser, input);
        transition qualified {
            true -> path_member(parser, input),
            _ -> name_node(parser, input)
        }
    }

    machine path_member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.member_count < 32000 {
            true -> path_member_bounded(parser, input),
            _ -> member_full(parser, input)
        }
    }

    machine path_member_bounded(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.output.members[parser.output.member_count] =
            |parser|::identifier_span(parser, parser.token_start, parser.token_end);
        parser.output.member_count = parser.output.member_count + 1;
        let qualified: bool = |input|::at_path_separator(parser, input);
        transition qualified {
            true -> path_separator(parser, input),
            _ -> path_node(parser, input)
        }
    }

    machine path_separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedExpressionPathMember);
        transition parser.output.accepted {
            true -> path_member(parser, input),
            _ -> done()
        }
    }

    machine name_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Name,
            operator: |syntax_trees|::OperatorKind::None,
            left: 0 as +Trapping,
            right: 0 as +Trapping,
            first: 0 as +Trapping,
            count: 0 as +Trapping,
            flag: false,
            name: |parser|::identifier_span(parser, parser.path_start, parser.token_end),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, parser.path_start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_path(parser, input),
            _ -> done()
        }
    }

    machine path_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let count: u64 in Trapping = (parser.output.member_count as +Trapping) - parser.path_first_member;
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Path,
            operator: |syntax_trees|::OperatorKind::None,
            left: 0 as +Trapping,
            right: 0 as +Trapping,
            first: parser.path_first_member,
            count: count,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, parser.path_start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_path(parser, input),
            _ -> done()
        }
    }

    machine after_path(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let braced: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace);
        let admitted: bool = construct_admitted(parser);
        transition braced && admitted {
            true -> open_construct(parser, input),
            _ -> after_operand(parser, input)
        }
    }

    // A completed operand: apply postfix suffixes, then a binary operator,
    // or end the operand.
    machine after_operand(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::load_current(parser, input);
        transition parser.current_present {
            true -> suffix(parser, input),
            _ -> end_operand(parser, input)
        }
    }

    machine suffix(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        transition token.kind {
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::ColonColon, .. } -> explicit_arguments(parser, input),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Dot, .. } -> field(parser, input),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::LeftBracket, .. } -> open_index(parser, input),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::LeftParen, .. } -> open_call(parser, input),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::As, .. } -> cast(parser, input),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::PipePipe, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::Or, 1 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::AndAnd, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::And, 2 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::EqualEqual, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::Equal, 3 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::ExclamationEqual, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::NotEqual, 3 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Less, .. } -> less(parser, input),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::LessEqual, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::LessEqual, 4 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Greater, .. } -> greater(parser, input),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::GreaterEqual, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::GreaterEqual, 4 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Pipe, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::BitOr, 5 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Caret, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::BitXor, 6 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Ampersand, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::BitAnd, 7 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::LessLess, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::ShiftLeft, 8 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Plus, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::Add, 9 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Minus, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::Subtract, 9 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Asterisk, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::Multiply, 10 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Slash, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::Divide, 10 as +Trapping),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Percent, .. } -> binary(parser, input, |syntax_trees|::OperatorKind::Modulo, 10 as +Trapping),
            |tokens|::TokenKind::Identifier -> word_suffix(parser, input),
            _ -> end_operand(parser, input)
        }
    }

    machine word_suffix(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let has_membership_word: bool = |input|::at_word(parser, input, "in");
        transition has_membership_word && parser.expression_allow_membership {
            true -> membership(parser, input),
            _ -> end_operand(parser, input)
        }
    }

    // `in` first closes every pending operator that binds tighter than a
    // membership, so its value is the whole operand before it.
    machine membership(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let base: u64 in Trapping = frame_operator_base(parser);
        reduce_until(parser, input, base, 5 as +Trapping);
        transition parser.output.accepted {
            true -> membership_value(parser, input),
            _ -> done()
        }
    }

    machine membership_value(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let value: u64 in Trapping = pop_operand(parser);
        let first_domain: u64 in Trapping = parser.output.name_path_count as +Trapping;
        |input|::take_current(parser, input);
        transition { _ -> membership_domain(parser, input, value, first_domain, |syntax_trees|::OperatorKind::None) }
    }

    machine membership_domain(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        value: u64 in Trapping,
        first_domain: u64 in Trapping,
        connective: |syntax_trees|::OperatorKind
    ) {
        parse_membership_domain(parser, input);
        let both: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Ampersand);
        let either: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Pipe);
        transition parser.output.accepted {
            true -> membership_connective(parser, input, value, first_domain, connective, both, either),
            _ -> done()
        }
    }

    machine membership_connective(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        value: u64 in Trapping,
        first_domain: u64 in Trapping,
        connective: |syntax_trees|::OperatorKind,
        both: bool,
        either: bool
    ) {
        transition both {
            true -> joined(parser, input, value, first_domain, connective, |syntax_trees|::OperatorKind::And),
            _ -> union_connective(parser, input, value, first_domain, connective, either)
        }
    }

    machine union_connective(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        value: u64 in Trapping,
        first_domain: u64 in Trapping,
        connective: |syntax_trees|::OperatorKind,
        either: bool
    ) {
        transition either {
            true -> joined(parser, input, value, first_domain, connective, |syntax_trees|::OperatorKind::Or),
            _ -> membership_node(parser, input, value, first_domain, connective)
        }
    }

    // One membership joins its domains by one connective: `A & B | C` needs
    // its grouping spelled.
    machine joined(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        value: u64 in Trapping,
        first_domain: u64 in Trapping,
        connective: |syntax_trees|::OperatorKind,
        next: |syntax_trees|::OperatorKind
    ) {
        transition connective == |syntax_trees|::OperatorKind::None || connective == next {
            true -> joined_taken(parser, input, value, first_domain, next),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::MixedDomainConnectives)
        }
    }

    machine joined_taken(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        value: u64 in Trapping,
        first_domain: u64 in Trapping,
        connective: |syntax_trees|::OperatorKind
    ) {
        |input|::take_current(parser, input);
        transition { _ -> membership_domain(parser, input, value, first_domain, connective) }
    }

    machine membership_node(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        value: u64 in Trapping,
        first_domain: u64 in Trapping,
        connective: |syntax_trees|::OperatorKind
    ) {
        let value_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, value);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Membership,
            operator: connective,
            left: value,
            right: 0 as +Trapping,
            first: first_domain,
            count: (parser.output.name_path_count as +Trapping) - first_domain,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, value_expression.source_span.span.start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    // `match subject { arm, ... }`: the subject admits no construction, since
    // its `{` opens the arms.
    machine match_open(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        parser_push_frame(parser, input, |frames|::ExpressionFrameKind::MatchSubject, 0 as +Trapping);
        transition parser.output.accepted {
            true -> match_taken(parser, input, token.start),
            _ -> done()
        }
    }

    machine match_taken(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping) {
        |input|::take_current(parser, input);
        let frame: |frames|::ExpressionFrame = top_frame(parser);
        replace_top_frame(parser, |frames|::match_frame(frame, |frames|::ExpressionFrameKind::MatchSubject, 0 as +Trapping, start));
        transition { _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMatchSubject) }
    }

    machine match_subject_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace, |syntax_trees|::ParseDiagnosticCode::ExpectedMatchArms);
        transition parser.output.accepted {
            true -> match_subject(parser, input, frame),
            _ -> done()
        }
    }

    machine match_subject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        let subject: u64 in Trapping = pop_operand(parser);
        let arms: |frames|::ExpressionFrame = |frames|::match_frame(frame, |frames|::ExpressionFrameKind::MatchPattern, subject, frame.start);
        replace_top_frame(parser, arms);
        transition { _ -> match_arm(parser, input, arms) }
    }

    // An arm, or the `}` that closes a match with at least one arm.
    machine match_arm(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace);
        let armed: bool = parser.pending_arm_count > frame.pending_base;
        transition closing {
            true -> match_close_armed(parser, input, frame, armed),
            _ -> match_pattern(parser, input, frame)
        }
    }

    machine match_close_armed(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame, armed: bool) {
        transition armed {
            true -> match_close(parser, input, frame),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::EmptyMatch)
        }
    }

    machine match_pattern(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        |input|::load_current(parser, input);
        transition parser.current_present {
            true -> match_pattern_token(parser, input, frame),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMatchPattern)
        }
    }

    machine match_pattern_token(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        let wildcard: bool = |input|::at_word(parser, input, "_");
        let started: |frames|::ExpressionFrame = |frames|::match_arm_frame(frame, token.start);
        replace_top_frame(parser, started);
        transition wildcard {
            true -> match_wildcard(parser, input, started),
            _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMatchPattern)
        }
    }

    machine match_wildcard(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        |input|::take_current(parser, input);
        transition { _ -> match_arrow(parser, input, frame, |syntax_trees|::ArmPatternKind::Wildcard, 0 as +Trapping) }
    }

    // A bare name binds; a qualified path may name a case or constant.
    machine match_pattern_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        let pattern: u64 in Trapping = pop_operand(parser);
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, pattern);
        transition expression.kind {
            |syntax_trees|::ExpressionKind::Name -> match_name_pattern(parser, input, frame, pattern, expression.name.source_span),
            |syntax_trees|::ExpressionKind::Path -> match_arrow(parser, input, frame, |syntax_trees|::ArmPatternKind::Case, pattern),
            _ -> match_arrow(parser, input, frame, |syntax_trees|::ArmPatternKind::Literal, pattern)
        }
    }

    machine match_name_pattern(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame, pattern: u64 in Trapping, name: |source|::SourceSpan) {
        let selector: u64 in Trapping = |syntax_trees|::file_selector_at(@parser.output, name);
        transition selector > 0 {
            true -> match_arrow(parser, input, frame, |syntax_trees|::ArmPatternKind::Literal, pattern),
            false -> match_arrow(parser, input, frame, |syntax_trees|::ArmPatternKind::Binder, pattern)
        }
    }

    machine match_arrow(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        frame: |frames|::ExpressionFrame,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping
    ) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Arrow, |syntax_trees|::ParseDiagnosticCode::ExpectedMatchArrow);
        transition parser.output.accepted {
            true -> match_value(parser, input, |frames|::match_value_frame(frame, kind, pattern)),
            _ -> done()
        }
    }

    machine match_value(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        replace_top_frame(parser, frame);
        transition { _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMatchValue) }
    }

    machine match_value_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        let value: u64 in Trapping = pop_operand(parser);
        let value_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, value);
        let arm: |syntax_trees|::TransitionArm = match_arm_row(parser, frame, value, value_expression.source_span.span.end);
        stage_arm(parser, input, arm);
        transition parser.output.accepted {
            true -> match_arm_delimiter(parser, input, frame),
            _ -> done()
        }
    }

    // A comma between arms is optional, as between a transition's arms.
    machine match_arm_delimiter(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        let separator: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        let next: |frames|::ExpressionFrame = |frames|::match_frame(frame, |frames|::ExpressionFrameKind::MatchPattern, frame.callee, frame.start);
        transition separator {
            true -> match_separator(parser, input, next),
            _ -> match_following(parser, input, next)
        }
    }

    machine match_separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        |input|::take_current(parser, input);
        transition { _ -> match_following(parser, input, frame) }
    }

    machine match_following(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        replace_top_frame(parser, frame);
        transition { _ -> match_arm(parser, input, frame) }
    }

    machine match_close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        |input|::take_current(parser, input);
        commit_arms(parser, input, frame.pending_base);
        transition parser.output.accepted {
            true -> match_node(parser, input, frame),
            _ -> done()
        }
    }

    machine match_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        parser_pop_frame(parser);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Match,
            operator: |syntax_trees|::OperatorKind::None,
            left: frame.callee,
            right: 0 as +Trapping,
            first: parser.committed_first,
            count: parser.committed_count,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, frame.start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    // After a name or path, `<` opens static arguments when its matching
    // `>` is followed by `(`, as in `Build::select_provider::<Slot, Provider>(builder)`;
    // otherwise it compares.
    machine less(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let top: u64 in Trapping = top_operand(parser);
        let callee: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, top);
        let named: bool = names_declaration(callee.kind);
        let applied: bool = static_arguments_ahead(parser, input);
        transition named && applied {
            true -> static_arguments(parser, input),
            _ -> binary(parser, input, |syntax_trees|::OperatorKind::Less, 4 as +Trapping)
        }
    }

    // The static argument list (types.omg) commits to `type_arguments`.
    machine explicit_arguments(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition |input|::at_expression_arguments(parser, input) {
            true -> take_separator(parser, input),
            false -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedExpressionPathMember)
        }
    }

    machine take_separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> static_arguments(parser, input) }
    }

    machine static_arguments(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |types|::parse_static_arguments(parser, input, true);
        transition parser.output.accepted {
            true -> apply_node(parser, input),
            _ -> done()
        }
    }

    machine apply_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let callee: u64 in Trapping = pop_operand(parser);
        let callee_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, callee);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Apply,
            operator: |syntax_trees|::OperatorKind::None,
            left: callee,
            right: 0 as +Trapping,
            first: parser.committed_type_first,
            count: parser.committed_type_count,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, callee_expression.source_span.span.start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    // `>>` arrives as two `>` tokens; adjacent ones shift right.
    machine greater(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        let shift: bool = |input|::next_is_adjacent_punctuation(parser, input, |tokens|::PunctuationKind::Greater, token.end);
        transition shift {
            true -> shift_right(parser, input),
            _ -> binary(parser, input, |syntax_trees|::OperatorKind::Greater, 4 as +Trapping)
        }
    }

    machine shift_right(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> binary(parser, input, |syntax_trees|::OperatorKind::ShiftRight, 8 as +Trapping) }
    }

    machine field(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedFieldName);
        transition parser.output.accepted {
            true -> field_node(parser, input),
            _ -> done()
        }
    }

    machine field_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let base: u64 in Trapping = pop_operand(parser);
        let base_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, base);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Field,
            operator: |syntax_trees|::OperatorKind::None,
            left: base,
            right: 0 as +Trapping,
            first: 0 as +Trapping,
            count: 0 as +Trapping,
            flag: false,
            name: |parser|::identifier_span(parser, parser.name_start, parser.name_end),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, base_expression.source_span.span.start, parser.name_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    // A carrier cast and its optional addition are separate semantic nodes.
    // Domain-only entries retain their written operation; they never reuse a
    // type's `in` qualifier, which would hide what was added or removed.
    machine cast(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let base: u64 in Trapping = frame_operator_base(parser);
        reduce_until(parser, input, base, 11 as +Trapping);
        transition parser.output.accepted {
            true -> cast_begin(parser, input),
            _ -> done()
        }
    }

    machine cast_begin(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let addition: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Plus);
        let removal: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Minus);
        let retention: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Equal);
        transition addition || removal || retention {
            true -> cast_entry(parser, input, false),
            _ -> cast_target(parser, input)
        }
    }

    machine cast_target(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |types|::parse_type_reference(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedCastType);
        transition parser.output.accepted {
            true -> cast_type_checked(parser, input),
            _ -> done()
        }
    }

    machine cast_type_checked(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let reference: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(@parser.output, parser.type_result);
        transition reference.has_domain {
            true -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::RetiredCastQualifier),
            _ -> cast_node(parser, input)
        }
    }

    machine cast_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let value: u64 in Trapping = pop_operand(parser);
        let value_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, value);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Cast,
            operator: |syntax_trees|::OperatorKind::None,
            left: value,
            right: 0 as +Trapping,
            first: 0 as +Trapping,
            count: 0 as +Trapping,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: parser.type_result,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, value_expression.source_span.span.start, parser.type_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> cast_suffix(parser, input),
            _ -> done()
        }
    }

    machine cast_suffix(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let addition: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Plus);
        let removal: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Minus);
        let retention: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Equal);
        transition addition || removal || retention {
            true -> cast_entry(parser, input, true),
            _ -> after_operand(parser, input)
        }
    }

    machine cast_entry(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, carrier: bool) {
        let addition: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Plus);
        let removal: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Minus);
        transition carrier && !addition {
            true -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::InvalidCarrierCastEntry),
            _ -> cast_operation(parser, input, addition, removal)
        }
    }

    machine cast_operation(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, addition: bool, removal: bool) {
        transition addition {
            true -> cast_domain(parser, input, |syntax_trees|::OperatorKind::Add),
            _ -> cast_nonaddition(parser, input, removal)
        }
    }

    machine cast_nonaddition(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, removal: bool) {
        transition removal {
            true -> cast_domain(parser, input, |syntax_trees|::OperatorKind::Subtract),
            _ -> cast_domain(parser, input, |syntax_trees|::OperatorKind::Equal)
        }
    }

    machine cast_domain(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operation: |syntax_trees|::OperatorKind) {
        |input|::take_current(parser, input);
        let first: u64 in Trapping = parser.output.name_path_count as u64 +Trapping;
        |path|::parse_name_path(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedCastDomain);
        transition parser.output.accepted {
            true -> cast_domain_end(parser, input, operation, first),
            _ -> done()
        }
    }

    // The current type row carries one domain. A second entry is an explicit
    // coverage refusal, never a sequence of separately interpreted casts.
    machine cast_domain_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operation: |syntax_trees|::OperatorKind, first: u64 in Trapping) {
        let addition: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Plus);
        let removal: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Minus);
        let retention: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Equal);
        let arguments: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Less);
        transition addition || removal || retention || arguments {
            true -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::UnsupportedCastEntries),
            _ -> cast_domain_node(parser, input, operation, first)
        }
    }

    machine cast_domain_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operation: |syntax_trees|::OperatorKind, first: u64 in Trapping) {
        let value: u64 in Trapping = pop_operand(parser);
        let value_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, value);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Cast,
            operator: operation,
            left: value,
            right: 0 as +Trapping,
            first: first,
            count: 1 as +Trapping,
            flag: true,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, value_expression.source_span.span.start, parser.name_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    machine binary(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operator: |syntax_trees|::OperatorKind, precedence: u64 in Trapping) {
        let base: u64 in Trapping = frame_operator_base(parser);
        reduce_until(parser, input, base, precedence);
        transition parser.output.accepted {
            true -> binary_push(parser, input, operator, precedence),
            _ -> done()
        }
    }

    machine binary_push(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operator: |syntax_trees|::OperatorKind, precedence: u64 in Trapping) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        push_operator(parser, input, operator, precedence, false, token.start);
        transition parser.output.accepted {
            true -> prefix_taken(parser, input),
            _ -> done()
        }
    }

    machine open_group(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser_push_frame(parser, input, |frames|::ExpressionFrameKind::Group, 0 as +Trapping);
        transition parser.output.accepted {
            true -> prefix_taken(parser, input),
            _ -> done()
        }
    }

    machine open_index(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let base: u64 in Trapping = pop_operand(parser);
        parser_push_frame(parser, input, |frames|::ExpressionFrameKind::Index, base);
        transition parser.output.accepted {
            true -> index_taken(parser, input),
            _ -> done()
        }
    }

    machine index_taken(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let open: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::DotDot);
        let inclusive: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::DotDotEqual);
        transition open || inclusive {
            true -> range_open(parser, input, false, 0 as +Trapping, inclusive, 0 as +Trapping),
            _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedOperand)
        }
    }

    // `..` or `..=` is current, after the index's start operand (beginning
    // at `from`) or none, when the range begins at the dots: the range's end
    // follows, or `]` closes an open `..` range at once.
    machine range_open(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, has_start: bool, start: u64 in Trapping, inclusive: bool, from: u64 in Trapping) {
        |input|::take_current(parser, input);
        let dots: u64 in Trapping = parser.token_start;
        push_range_frame(parser, input, has_start, start, inclusive, from, dots);
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBracket);
        transition parser.output.accepted && closing && !inclusive {
            true -> range_node(parser, input, false),
            _ -> range_end_operand(parser, input)
        }
    }

    machine range_end_operand(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.accepted {
            true -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedRangeEnd),
            _ -> done()
        }
    }

    // A completed range end, or none: the range replaces the index operand.
    machine range_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, has_end: bool) {
        let frame: |frames|::ExpressionFrame = top_frame(parser);
        parser_pop_frame(parser);
        transition has_end {
            true -> range_ended(parser, input, frame),
            _ -> range_built(parser, input, frame, false, 0 as +Trapping)
        }
    }

    machine range_ended(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        let end: u64 in Trapping = pop_operand(parser);
        transition { _ -> range_built(parser, input, frame, true, end) }
    }

    machine range_built(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame, has_end: bool, end: u64 in Trapping) {
        let first: u64 in Trapping = presence(frame.range_start);
        let count: u64 in Trapping = presence(has_end);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Range,
            operator: |syntax_trees|::OperatorKind::None,
            left: frame.callee,
            right: end,
            first: first,
            count: count,
            flag: frame.range_inclusive,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, frame.start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> frame_delimiter(parser, input),
            _ -> done()
        }
    }

    // `[element, ...]`: a fixed-array literal, a trailing comma allowed; `[]`
    // has no elements.
    machine open_array(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        parser_push_frame(parser, input, |frames|::ExpressionFrameKind::Elements, 0 as +Trapping);
        transition parser.output.accepted {
            true -> array_taken(parser, input, token.start),
            _ -> done()
        }
    }

    machine array_taken(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping) {
        |input|::take_current(parser, input);
        let frame: |frames|::ExpressionFrame = top_frame(parser);
        replace_top_frame(parser, |frames|::started_frame(frame, start));
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBracket);
        transition closing {
            true -> close_array(parser, input),
            _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedArrayElement)
        }
    }

    machine element_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let element: u64 in Trapping = pop_operand(parser);
        stage_argument(parser, input, element);
        transition parser.output.accepted {
            true -> element_delimiter(parser, input),
            _ -> done()
        }
    }

    machine element_delimiter(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let separator: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        transition separator {
            true -> element_separator(parser, input),
            _ -> element_close(parser, input)
        }
    }

    machine element_separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBracket);
        transition closing {
            true -> close_array(parser, input),
            _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedArrayElement)
        }
    }

    machine element_close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBracket);
        transition closing {
            true -> close_array(parser, input),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedArrayElementEnd)
        }
    }

    machine close_array(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let frame: |frames|::ExpressionFrame = top_frame(parser);
        commit_arguments(parser, input, frame.pending_base);
        transition parser.output.accepted {
            true -> array_node(parser, input, frame),
            _ -> done()
        }
    }

    machine array_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        parser_pop_frame(parser);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Array,
            operator: |syntax_trees|::OperatorKind::None,
            left: 0 as +Trapping,
            right: 0 as +Trapping,
            first: parser.committed_first,
            count: parser.committed_count,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, frame.start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    machine open_call(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let callee: u64 in Trapping = pop_operand(parser);
        parser_push_frame(parser, input, |frames|::ExpressionFrameKind::Arguments, callee);
        transition parser.output.accepted {
            true -> call_taken(parser, input),
            _ -> done()
        }
    }

    machine call_taken(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightParen);
        transition closing {
            true -> close_call(parser, input),
            _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedCallArgument)
        }
    }

    machine open_construct(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let path: u64 in Trapping = pop_operand(parser);
        parser_push_frame(parser, input, |frames|::ExpressionFrameKind::Construct, path);
        transition parser.output.accepted {
            true -> construct_taken(parser, input),
            _ -> done()
        }
    }

    machine construct_taken(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> construct_field_or_end(parser, input) }
    }

    machine construct_field_or_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace);
        transition closing {
            true -> close_construct(parser, input),
            _ -> construct_field(parser, input)
        }
    }

    machine construct_field(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedStructLiteralFieldOrEnd);
        transition parser.output.accepted {
            true -> construct_colon(parser, input),
            _ -> done()
        }
    }

    machine construct_colon(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let field_start: u64 in Trapping = parser.name_start;
        let field_end: u64 in Trapping = parser.name_end;
        set_frame_field(parser, field_start, field_end);
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Colon,
            |syntax_trees|::ParseDiagnosticCode::ExpectedStructLiteralFieldColon
        );
        transition parser.output.accepted {
            true -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedStructLiteralValue),
            _ -> done()
        }
    }

    // No suffix or operator continues the operand: close what is pending in
    // the innermost frame, then let that frame read its delimiter.
    machine end_operand(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let base: u64 in Trapping = frame_operator_base(parser);
        reduce_until(parser, input, base, 0 as +Trapping);
        transition parser.output.accepted {
            true -> frame_delimiter(parser, input),
            _ -> done()
        }
    }

    machine frame_delimiter(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.expression_frame_depth > 0 {
            true -> innermost(parser, input),
            _ -> finish(parser)
        }
    }

    machine innermost(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let frame: |frames|::ExpressionFrame = top_frame(parser);
        transition frame.kind {
            |frames|::ExpressionFrameKind::Group -> close_group(parser, input),
            |frames|::ExpressionFrameKind::Arguments -> argument_end(parser, input),
            |frames|::ExpressionFrameKind::Index -> close_index(parser, input, frame),
            |frames|::ExpressionFrameKind::Construct -> construct_value_end(parser, input, frame),
            |frames|::ExpressionFrameKind::MatchSubject -> match_subject_end(parser, input, frame),
            |frames|::ExpressionFrameKind::MatchPattern -> match_pattern_end(parser, input, frame),
            |frames|::ExpressionFrameKind::MatchValue -> match_value_end(parser, input, frame),
            |frames|::ExpressionFrameKind::RangeEnd -> range_node(parser, input, true),
            |frames|::ExpressionFrameKind::Elements -> element_end(parser, input)
        }
    }

    machine close_group(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::RightParen, |syntax_trees|::ParseDiagnosticCode::ExpectedGroupEnd);
        transition parser.output.accepted {
            true -> group_closed(parser, input),
            _ -> done()
        }
    }

    machine group_closed(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser_pop_frame(parser);
        transition { _ -> after_operand(parser, input) }
    }

    // After the index operand, `..` or `..=` makes it a range's start.
    machine close_index(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        let open: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::DotDot);
        let inclusive: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::DotDotEqual);
        transition open || inclusive {
            true -> range_start(parser, input, inclusive),
            _ -> index_bracket(parser, input, frame)
        }
    }

    machine range_start(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, inclusive: bool) {
        let start: u64 in Trapping = pop_operand(parser);
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, start);
        transition { _ -> range_open(parser, input, true, start, inclusive, written.source_span.span.start) }
    }

    machine index_bracket(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::RightBracket, |syntax_trees|::ParseDiagnosticCode::ExpectedIndexEnd);
        transition parser.output.accepted {
            true -> index_node(parser, input, frame),
            _ -> done()
        }
    }

    machine index_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        parser_pop_frame(parser);
        let index: u64 in Trapping = pop_operand(parser);
        let base_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, frame.callee);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Index,
            operator: |syntax_trees|::OperatorKind::None,
            left: frame.callee,
            right: index,
            first: 0 as +Trapping,
            count: 0 as +Trapping,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, base_expression.source_span.span.start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    machine argument_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let argument: u64 in Trapping = pop_operand(parser);
        stage_argument(parser, input, argument);
        transition parser.output.accepted {
            true -> argument_delimiter(parser, input),
            _ -> done()
        }
    }

    machine argument_delimiter(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let separator: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        transition separator {
            true -> argument_separator(parser, input),
            _ -> argument_close(parser, input)
        }
    }

    machine argument_separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedCallArgument) }
    }

    machine argument_close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightParen);
        transition closing {
            true -> close_call(parser, input),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedCallArgumentEnd)
        }
    }

    machine close_call(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let frame: |frames|::ExpressionFrame = top_frame(parser);
        commit_arguments(parser, input, frame.pending_base);
        transition parser.output.accepted {
            true -> call_node(parser, input, frame),
            _ -> done()
        }
    }

    machine call_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        parser_pop_frame(parser);
        let callee_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, frame.callee);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Call,
            operator: |syntax_trees|::OperatorKind::None,
            left: frame.callee,
            right: 0 as +Trapping,
            first: parser.committed_first,
            count: parser.committed_count,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, callee_expression.source_span.span.start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    machine construct_value_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        let value: u64 in Trapping = pop_operand(parser);
        stage_field(parser, input, frame.field_start, frame.field_end, value);
        transition parser.output.accepted {
            true -> construct_delimiter(parser, input),
            _ -> done()
        }
    }

    machine construct_delimiter(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let separator: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        transition separator {
            true -> construct_separator(parser, input),
            _ -> construct_close(parser, input)
        }
    }

    machine construct_separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> construct_field_or_end(parser, input) }
    }

    machine construct_close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace);
        transition closing {
            true -> close_construct(parser, input),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedStructLiteralFieldEnd)
        }
    }

    machine close_construct(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let frame: |frames|::ExpressionFrame = top_frame(parser);
        commit_fields(parser, input, frame.pending_base);
        transition parser.output.accepted {
            true -> construct_node(parser, input, frame),
            _ -> done()
        }
    }

    machine construct_node(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame) {
        parser_pop_frame(parser);
        let path_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, frame.callee);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Construct,
            operator: |syntax_trees|::OperatorKind::None,
            left: frame.callee,
            right: 0 as +Trapping,
            first: parser.committed_first,
            count: parser.committed_count,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, path_expression.source_span.span.start, parser.token_end)
        };
        emit_expression(parser, input, node);
        transition parser.output.accepted {
            true -> after_operand(parser, input),
            _ -> done()
        }
    }

    machine finish(parser: @mutable |parser|::Parser) {
        let result: u64 in Trapping = pop_operand(parser);
        parser.expression_result = result;
    }

    machine member_full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::PathMemberCapacityExceeded);
    }

    machine reject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::reject_current(parser, input, code);
    }

    machine done() {}
}

// Store a completed node and push its handle as the current operand.
machine emit_expression(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, node: |syntax_trees|::Expression)
crashes Trap
{
    transition parser.output.expression_count < 131072 {
        true -> store(parser, input, node),
        _ -> full(parser, input)
    }

    // Children precede their parent, so an expression's subtree is the
    // contiguous run from its first child's first row to itself.
    machine store(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, node: |syntax_trees|::Expression) {
        let handle: u64 in Trapping = parser.output.expression_count as +Trapping;
        transition node.kind {
            |syntax_trees|::ExpressionKind::Name -> stored(parser, input, node, handle, handle),
            |syntax_trees|::ExpressionKind::Path -> stored(parser, input, node, handle, handle),
            |syntax_trees|::ExpressionKind::Integer -> stored(parser, input, node, handle, handle),
            |syntax_trees|::ExpressionKind::Float -> stored(parser, input, node, handle, handle),
            |syntax_trees|::ExpressionKind::Boolean -> stored(parser, input, node, handle, handle),
            |syntax_trees|::ExpressionKind::String -> stored(parser, input, node, handle, handle),
            _ -> composite(parser, input, node, handle)
        }
    }

    // The first child is `left`, except an array literal's first element
    // and a range's end when it has no start; `[]` and `..` have no child.
    machine composite(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, node: |syntax_trees|::Expression, handle: u64 in Trapping) {
        transition node.kind {
            |syntax_trees|::ExpressionKind::Array -> elements(parser, input, node, handle),
            |syntax_trees|::ExpressionKind::Range -> range(parser, input, node, handle),
            _ -> child(parser, input, node, handle, node.left)
        }
    }

    machine elements(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, node: |syntax_trees|::Expression, handle: u64 in Trapping) {
        transition node.count > 0 {
            true -> first_element(parser, input, node, handle),
            _ -> stored(parser, input, node, handle, handle)
        }
    }

    machine first_element(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, node: |syntax_trees|::Expression, handle: u64 in Trapping) {
        let first_element: u64 in Trapping = |syntax_trees|::syntax_trees_argument(@parser.output, node.first);
        transition { _ -> child(parser, input, node, handle, first_element) }
    }

    machine range(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, node: |syntax_trees|::Expression, handle: u64 in Trapping) {
        transition node.first == 1 {
            true -> child(parser, input, node, handle, node.left),
            _ -> range_end(parser, input, node, handle)
        }
    }

    machine range_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, node: |syntax_trees|::Expression, handle: u64 in Trapping) {
        transition node.count == 1 {
            true -> child(parser, input, node, handle, node.right),
            _ -> stored(parser, input, node, handle, handle)
        }
    }

    machine child(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, node: |syntax_trees|::Expression, handle: u64 in Trapping, first: u64 in Trapping) {
        let first_child: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, first);
        transition { _ -> stored(parser, input, node, handle, first_child.first_row) }
    }

    machine stored(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        node: |syntax_trees|::Expression,
        handle: u64 in Trapping,
        first_row: u64 in Trapping
    ) {
        parser.output.expressions[parser.output.expression_count] = |syntax_trees|::Expression {
            kind: node.kind,
            operator: node.operator,
            left: node.left,
            right: node.right,
            first: node.first,
            count: node.count,
            flag: node.flag,
            name: node.name,
            type_reference: node.type_reference,
            first_row: first_row,
            literal: 0 as +Trapping,
            source_span: node.source_span
        };
        parser.output.expression_count = parser.output.expression_count + 1;
        push_operand(parser, input, handle);
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpressionCapacityExceeded);
    }
}

machine push_operand(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, handle: u64 in Trapping)
crashes Trap
{
    transition parser.expression_operand_depth < 64 {
        true -> push(parser, handle),
        _ -> deep(parser, input)
    }

    machine push(parser: @mutable |parser|::Parser, handle: u64 in Trapping) {
        parser.expression_operands[parser.expression_operand_depth] = handle;
        parser.expression_operand_depth = parser.expression_operand_depth + 1;
    }

    machine deep(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpressionNestingExceeded);
    }
}

// The grammar pushes an operand before every pop, so an empty stack is a
// violated parser invariant.
machine pop_operand(parser: @mutable |parser|::Parser) -> u64 in Trapping
crashes Trap
{
    transition parser.expression_operand_depth > 0 {
        true -> pop(parser),
        _ -> invalid()
    }

    machine pop(parser: @mutable |parser|::Parser) -> u64 in Trapping {
        let top: u64 = parser.expression_operand_depth - 1;
        parser.expression_operand_depth = top;
        transition { _ -> read(parser, top) }
    }

    machine read(parser: @|parser|::Parser, top: u64) -> u64 in Trapping
    requires top <= 63
    {
        parser.expression_operands[top]
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

machine push_operator(
    parser: @mutable |parser|::Parser,
    input: @|tokens|::TokenStream,
    operator: |syntax_trees|::OperatorKind,
    precedence: u64 in Trapping,
    unary: bool,
    start: u64 in Trapping
)
crashes Trap
{
    transition parser.expression_operator_depth < 64 {
        true -> push(parser, operator, precedence, unary, start),
        _ -> deep(parser, input)
    }

    machine push(
        parser: @mutable |parser|::Parser,
        operator: |syntax_trees|::OperatorKind,
        precedence: u64 in Trapping,
        unary: bool,
        start: u64 in Trapping
    ) {
        parser.expression_operators[parser.expression_operator_depth] = |frames|::PendingOperator {
            operator: operator,
            precedence: precedence,
            unary: unary,
            start: start
        };
        parser.expression_operator_depth = parser.expression_operator_depth + 1;
    }

    machine deep(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpressionNestingExceeded);
    }
}

// Reduce pending operators above `base` while the top binds at least as
// tightly as `precedence`.
machine reduce_until(
    parser: @mutable |parser|::Parser,
    input: @|tokens|::TokenStream,
    base: u64 in Trapping,
    precedence: u64 in Trapping
)
crashes Trap
{
    transition { _ -> check(parser, input, base, precedence) }

    machine check(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, precedence: u64 in Trapping) {
        transition parser.expression_operator_depth > base {
            true -> top(parser, input, base, precedence),
            _ -> done()
        }
    }

    machine top(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, precedence: u64 in Trapping) {
        let pending: |frames|::PendingOperator = top_operator(parser);
        transition pending.precedence >= precedence {
            true -> reduce(parser, input, base, precedence, pending),
            _ -> done()
        }
    }

    machine reduce(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        base: u64 in Trapping,
        precedence: u64 in Trapping,
        pending: |frames|::PendingOperator
    ) {
        pop_operator(parser);
        reduce_operator(parser, input, pending);
        transition parser.output.accepted {
            true -> check(parser, input, base, precedence),
            _ -> done()
        }
    }

    machine done() {}
}

machine top_operator(parser: @|parser|::Parser) -> |frames|::PendingOperator
crashes Trap
{
    transition parser.expression_operator_depth > 0 {
        true -> element(parser, parser.expression_operator_depth - 1),
        _ -> invalid()
    }

    machine element(parser: @|parser|::Parser, top: u64) -> |frames|::PendingOperator
    requires top <= 63
    {
        parser.expression_operators[top]
    }

    machine invalid() -> |frames|::PendingOperator {
        crash Trap;
    }
}

machine pop_operator(parser: @mutable |parser|::Parser)
crashes Trap
{
    transition parser.expression_operator_depth > 0 {
        true -> pop(parser),
        _ -> invalid()
    }

    machine pop(parser: @mutable |parser|::Parser) {
        parser.expression_operator_depth = parser.expression_operator_depth - 1;
    }

    machine invalid() {
        crash Trap;
    }
}

// One pending operator becomes a Unary node over one operand or a Binary
// node over two.
machine reduce_operator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, pending: |frames|::PendingOperator)
crashes Trap
{
    transition pending.unary {
        true -> unary(parser, input, pending),
        _ -> binary(parser, input, pending)
    }

    machine unary(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, pending: |frames|::PendingOperator) {
        let operand: u64 in Trapping = pop_operand(parser);
        let operand_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, operand);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Unary,
            operator: pending.operator,
            left: operand,
            right: 0 as +Trapping,
            first: 0 as +Trapping,
            count: 0 as +Trapping,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, pending.start, operand_expression.source_span.span.end)
        };
        emit_expression(parser, input, node);
    }

    machine binary(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, pending: |frames|::PendingOperator) {
        let right: u64 in Trapping = pop_operand(parser);
        let left: u64 in Trapping = pop_operand(parser);
        let left_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, left);
        let right_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, right);
        let node: |syntax_trees|::Expression = |syntax_trees|::Expression {
            kind: |syntax_trees|::ExpressionKind::Binary,
            operator: pending.operator,
            left: left,
            right: right,
            first: 0 as +Trapping,
            count: 0 as +Trapping,
            flag: false,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            type_reference: 0 as +Trapping,
            first_row: 0 as +Trapping,
            literal: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, left_expression.source_span.span.start,
                right_expression.source_span.span.end)
        };
        emit_expression(parser, input, node);
    }
}

// Open a bracket frame; it records where its reductions and staged entries
// begin.
machine parser_push_frame(
    parser: @mutable |parser|::Parser,
    input: @|tokens|::TokenStream,
    kind: |frames|::ExpressionFrameKind,
    callee: u64 in Trapping
)
crashes Trap
{
    let frame: |frames|::ExpressionFrame = |frames|::ExpressionFrame {
        kind: kind,
        operator_base: parser.expression_operator_depth as +Trapping,
        pending_base: parser_pending_base(parser, kind),
        callee: callee,
        field_start: 0 as +Trapping,
        field_end: 0 as +Trapping,
        start: 0 as +Trapping,
        arm_start: 0 as +Trapping,
        pattern: 0 as +Trapping,
        pattern_kind: |syntax_trees|::ArmPatternKind::Wildcard,
        range_start: false,
        range_inclusive: false
    };
    push_frame_row(parser, input, frame);
}

// Push one frame row, when the frame stack has room.
machine push_frame_row(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: |frames|::ExpressionFrame)
crashes Trap
{
    transition parser.expression_frame_depth < 32 {
        true -> push(parser, frame),
        _ -> deep(parser, input)
    }

    machine push(parser: @mutable |parser|::Parser, frame: |frames|::ExpressionFrame) {
        parser.expression_frames[parser.expression_frame_depth] = frame;
        parser.expression_frame_depth = parser.expression_frame_depth + 1;
    }

    machine deep(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpressionNestingExceeded);
    }
}

// Open a range-end frame: whether its range has a start (`start`) and
// includes its end, and where the range begins: at its start operand
// (`from`) or, without one, at its dots.
machine push_range_frame(
    parser: @mutable |parser|::Parser,
    input: @|tokens|::TokenStream,
    has_start: bool,
    start: u64 in Trapping,
    inclusive: bool,
    from: u64 in Trapping,
    dots: u64 in Trapping
)
crashes Trap
{
    transition has_start {
        true -> push(parser, input, has_start, start, inclusive, from),
        _ -> push(parser, input, has_start, start, inclusive, dots)
    }

    machine push(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, has_start: bool, start: u64 in Trapping, inclusive: bool, begin: u64 in Trapping) {
        let frame: |frames|::ExpressionFrame = |frames|::ExpressionFrame {
            kind: |frames|::ExpressionFrameKind::RangeEnd,
            operator_base: parser.expression_operator_depth as +Trapping,
            pending_base: parser_pending_base(parser, |frames|::ExpressionFrameKind::RangeEnd),
            callee: start,
            field_start: 0 as +Trapping,
            field_end: 0 as +Trapping,
            start: begin,
            arm_start: 0 as +Trapping,
            pattern: 0 as +Trapping,
            pattern_kind: |syntax_trees|::ArmPatternKind::Wildcard,
            range_start: has_start,
            range_inclusive: inclusive
        };
        push_frame_row(parser, input, frame);
    }
}

// 1 for a present range endpoint, else 0.
machine presence(present: bool) -> u64 in Trapping {
    transition present {
        true -> one(),
        _ -> zero()
    }

    machine one() -> u64 in Trapping {
        1 as +Trapping
    }

    machine zero() -> u64 in Trapping {
        0 as +Trapping
    }
}

// Arguments stage on the argument stack; construction fields on the field
// stack; match arms on the arm stack.
machine parser_pending_base(parser: @|parser|::Parser, kind: |frames|::ExpressionFrameKind) -> u64 in Trapping {
    transition kind {
        |frames|::ExpressionFrameKind::Construct -> fields(parser),
        |frames|::ExpressionFrameKind::MatchSubject -> arms(parser),
        _ -> arguments(parser)
    }

    machine fields(parser: @|parser|::Parser) -> u64 in Trapping {
        parser.pending_field_count as +Trapping
    }

    machine arms(parser: @|parser|::Parser) -> u64 in Trapping {
        parser.pending_arm_count as +Trapping
    }

    machine arguments(parser: @|parser|::Parser) -> u64 in Trapping {
        parser.pending_argument_count as +Trapping
    }
}

machine top_frame(parser: @|parser|::Parser) -> |frames|::ExpressionFrame
crashes Trap
{
    transition parser.expression_frame_depth > 0 {
        true -> element(parser, parser.expression_frame_depth - 1),
        _ -> invalid()
    }

    machine element(parser: @|parser|::Parser, top: u64) -> |frames|::ExpressionFrame
    requires top <= 31
    {
        parser.expression_frames[top]
    }

    machine invalid() -> |frames|::ExpressionFrame {
        crash Trap;
    }
}

machine parser_pop_frame(parser: @mutable |parser|::Parser)
crashes Trap
{
    transition parser.expression_frame_depth > 0 {
        true -> pop(parser),
        _ -> invalid()
    }

    machine pop(parser: @mutable |parser|::Parser) {
        parser.expression_frame_depth = parser.expression_frame_depth - 1;
    }

    machine invalid() {
        crash Trap;
    }
}

// The innermost frame's operator base, or zero outside every frame.
machine frame_operator_base(parser: @|parser|::Parser) -> u64 in Trapping
crashes Trap
{
    transition parser.expression_frame_depth > 0 {
        true -> innermost(parser),
        _ -> outermost()
    }

    machine innermost(parser: @|parser|::Parser) -> u64 in Trapping {
        let frame: |frames|::ExpressionFrame = top_frame(parser);
        frame.operator_base
    }

    machine outermost() -> u64 in Trapping {
        0 as +Trapping
    }
}

// Rewrite the innermost frame: a match frame moving to its next part.
machine replace_top_frame(parser: @mutable |parser|::Parser, frame: |frames|::ExpressionFrame)
crashes Trap
{
    transition parser.expression_frame_depth > 0 {
        true -> replace(parser, frame),
        _ -> invalid()
    }

    machine replace(parser: @mutable |parser|::Parser, frame: |frames|::ExpressionFrame) {
        let top: u64 = parser.expression_frame_depth - 1;
        parser.expression_frames[top] = frame;
    }

    machine invalid() {
        crash Trap;
    }
}

// The arm a match frame completes with `value`, through `end`.
machine match_arm_row(parser: @|parser|::Parser, frame: |frames|::ExpressionFrame, value: u64 in Trapping, end: u64 in Trapping) -> |syntax_trees|::TransitionArm {
    |syntax_trees|::TransitionArm {
        has_fields: false,
        has_rest: false,
        kind: frame.pattern_kind,
        pattern: frame.pattern,
        first_field: 0 as +Trapping,
        field_count: 0 as +Trapping,
        has_guard: false,
        guard: 0 as +Trapping,
        target_kind: |syntax_trees|::ArmTargetKind::Value,
        target: value,
        source_span: |parser|::parser_source_span(parser, frame.arm_start, end)
    }
}

// Whether a braced path is a construction here: outside every bracket when
// the caller admits one, inside a bracket unless it is a match's subject or
// pattern, where `{` opens the arms or is no value.
machine construct_admitted(parser: @|parser|::Parser) -> bool
crashes Trap
{
    transition parser.expression_frame_depth > 0 {
        true -> innermost(parser),
        _ -> outermost(parser)
    }

    machine innermost(parser: @|parser|::Parser) -> bool {
        let frame: |frames|::ExpressionFrame = top_frame(parser);
        transition frame.kind {
            |frames|::ExpressionFrameKind::MatchSubject -> refused(),
            |frames|::ExpressionFrameKind::MatchPattern -> refused(),
            _ -> admitted()
        }
    }

    machine outermost(parser: @|parser|::Parser) -> bool {
        parser.expression_allow_construct
    }

    machine admitted() -> bool {
        true
    }

    machine refused() -> bool {
        false
    }
}

machine stage_arm(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, arm: |syntax_trees|::TransitionArm)
crashes Trap
{
    transition parser.pending_arm_count < 64 {
        true -> stage(parser, arm),
        _ -> full(parser, input)
    }

    machine stage(parser: @mutable |parser|::Parser, arm: |syntax_trees|::TransitionArm) {
        parser.pending_arms[parser.pending_arm_count] = arm;
        parser.pending_arm_count = parser.pending_arm_count + 1;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::MatchArmCapacityExceeded);
    }
}

// Move the innermost match's staged arms, from `base` up, into
// `SyntaxTrees::match_arms`; their range lands in
// `committed_first`/`committed_count`.
machine commit_arms(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping)
crashes Trap
{
    parser.committed_first = parser.output.match_arm_count as +Trapping;
    parser.committed_count = (parser.pending_arm_count as +Trapping) - base;
    transition { _ -> next(parser, input, base, base) }

    machine next(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping) {
        transition cursor < parser.pending_arm_count && cursor < 64 {
            true -> capacity(parser, input, base, cursor),
            _ -> close(parser, base)
        }
    }

    machine capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 64
    {
        transition parser.output.match_arm_count < 1024 {
            true -> copy(parser, input, base, cursor),
            _ -> full(parser, input)
        }
    }

    machine copy(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 64, parser.output.match_arm_count < 1024
    {
        parser.output.match_arms[parser.output.match_arm_count] = parser.pending_arms[cursor as -Trapping];
        parser.output.match_arm_count = parser.output.match_arm_count + 1;
        transition { _ -> next(parser, input, base, cursor + 1) }
    }

    machine close(parser: @mutable |parser|::Parser, base: u64 in Trapping) {
        let restored: u64 = base as u64;
        transition restored <= 64 {
            true -> truncate(parser, restored),
            _ -> invalid()
        }
    }

    machine truncate(parser: @mutable |parser|::Parser, base: u64)
    requires base <= 64
    {
        parser.pending_arm_count = base;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::MatchArmCapacityExceeded);
    }

    machine invalid() {
        crash Trap;
    }
}

// Record the field name the innermost construction frame is reading.
machine set_frame_field(parser: @mutable |parser|::Parser, start: u64 in Trapping, end: u64 in Trapping)
crashes Trap
{
    transition parser.expression_frame_depth > 0 {
        true -> set(parser, start, end),
        _ -> invalid()
    }

    machine set(parser: @mutable |parser|::Parser, start: u64 in Trapping, end: u64 in Trapping) {
        let top: u64 = parser.expression_frame_depth - 1;
        parser.expression_frames[top].field_start = start;
        parser.expression_frames[top].field_end = end;
    }

    machine invalid() {
        crash Trap;
    }
}

machine stage_argument(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, argument: u64 in Trapping)
crashes Trap
{
    transition parser.pending_argument_count < 256 {
        true -> stage(parser, argument),
        _ -> full(parser, input)
    }

    machine stage(parser: @mutable |parser|::Parser, argument: u64 in Trapping) {
        parser.pending_arguments[parser.pending_argument_count] = argument;
        parser.pending_argument_count = parser.pending_argument_count + 1;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ArgumentCapacityExceeded);
    }
}

machine stage_field(
    parser: @mutable |parser|::Parser,
    input: @|tokens|::TokenStream,
    start: u64 in Trapping,
    end: u64 in Trapping,
    value: u64 in Trapping
)
crashes Trap
{
    transition parser.pending_field_count < 64 {
        true -> stage(parser, start, end, value),
        _ -> full(parser, input)
    }

    machine stage(parser: @mutable |parser|::Parser, start: u64 in Trapping, end: u64 in Trapping, value: u64 in Trapping) {
        let value_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, value);
        parser.pending_fields[parser.pending_field_count] = |syntax_trees|::ConstructField {
            name: |parser|::identifier_span(parser, start, end),
            value: value,
            source_span: |parser|::parser_source_span(parser, start, value_expression.source_span.span.end)
        };
        parser.pending_field_count = parser.pending_field_count + 1;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ConstructFieldCapacityExceeded);
    }
}

// Move the innermost call's staged arguments, from `base` up, into the
// argument table; their range lands in `committed_first`/`committed_count`.
machine commit_arguments(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping)
crashes Trap
{
    parser.committed_first = parser.output.argument_count as +Trapping;
    parser.committed_count = (parser.pending_argument_count as +Trapping) - base;
    transition { _ -> next(parser, input, base, base) }

    machine next(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping) {
        transition cursor < parser.pending_argument_count && cursor < 256 {
            true -> capacity(parser, input, base, cursor),
            _ -> close(parser, base)
        }
    }

    machine capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 256
    {
        transition parser.output.argument_count < 65536 {
            true -> copy(parser, input, base, cursor),
            _ -> full(parser, input)
        }
    }

    machine copy(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 256, parser.output.argument_count < 65536
    {
        parser.output.arguments[parser.output.argument_count] = parser.pending_arguments[cursor as -Trapping];
        parser.output.argument_count = parser.output.argument_count + 1;
        transition { _ -> next(parser, input, base, cursor + 1) }
    }

    machine close(parser: @mutable |parser|::Parser, base: u64 in Trapping) {
        let restored: u64 = base as u64;
        transition restored <= 256 {
            true -> truncate(parser, restored),
            _ -> invalid()
        }
    }

    machine truncate(parser: @mutable |parser|::Parser, base: u64)
    requires base <= 256
    {
        parser.pending_argument_count = base;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ArgumentCapacityExceeded);
    }

    machine invalid() {
        crash Trap;
    }
}

machine commit_fields(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping)
crashes Trap
{
    parser.committed_first = parser.output.construct_field_count as +Trapping;
    parser.committed_count = (parser.pending_field_count as +Trapping) - base;
    transition { _ -> next(parser, input, base, base) }

    machine next(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping) {
        transition cursor < parser.pending_field_count && cursor < 64 {
            true -> capacity(parser, input, base, cursor),
            _ -> close(parser, base)
        }
    }

    machine capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 64
    {
        transition parser.output.construct_field_count < 4096 {
            true -> copy(parser, input, base, cursor),
            _ -> full(parser, input)
        }
    }

    machine copy(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 64, parser.output.construct_field_count < 4096
    {
        parser.output.construct_fields[parser.output.construct_field_count] = parser.pending_fields[cursor as -Trapping];
        parser.output.construct_field_count = parser.output.construct_field_count + 1;
        transition { _ -> next(parser, input, base, cursor + 1) }
    }

    machine close(parser: @mutable |parser|::Parser, base: u64 in Trapping) {
        let restored: u64 = base as u64;
        transition restored <= 64 {
            true -> truncate(parser, restored),
            _ -> invalid()
        }
    }

    machine truncate(parser: @mutable |parser|::Parser, base: u64)
    requires base <= 64
    {
        parser.pending_field_count = base;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ConstructFieldCapacityExceeded);
    }

    machine invalid() {
        crash Trap;
    }
}

// Whether an expression of this kind names a declaration, the only callee a
// static argument list applies to.
machine names_declaration(kind: |syntax_trees|::ExpressionKind) -> bool {
    transition kind {
        |syntax_trees|::ExpressionKind::Name -> named(),
        |syntax_trees|::ExpressionKind::Path -> named(),
        _ -> other()
    }

    machine named() -> bool {
        true
    }

    machine other() -> bool {
        false
    }
}

// The handle on top of the operand stack, left in place.
machine top_operand(parser: @|parser|::Parser) -> u64 in Trapping
crashes Trap
{
    transition parser.expression_operand_depth > 0 {
        true -> read(parser, parser.expression_operand_depth - 1),
        _ -> invalid()
    }

    machine read(parser: @|parser|::Parser, top: u64) -> u64 in Trapping
    requires top <= 63
    {
        parser.expression_operands[top]
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// Read one domain of a membership, including the argument list owned by that
// path. The type grammar commits nested argument rows before its enclosing list.
machine parse_membership_domain(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream)
crashes Trap
{
    |path|::parse_name_path(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMembershipDomain);
    transition parser.output.accepted {
        true -> suffix(parser, input),
        _ -> done()
    }

    machine suffix(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let explicit: bool = |input|::at_expression_arguments(parser, input);
        let bare: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Less);
        transition {
            explicit -> separator(parser, input),
            bare && parser.expression_clause_fact && parser.expression_frame_depth == 0 -> arguments(parser, input),
            bare -> reject(parser, input),
            _ -> done()
        }
    }

    machine separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> arguments(parser, input) }
    }

    machine arguments(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let handle: u64 in Trapping = parser.name_path_result;
        |types|::parse_static_arguments(parser, input, false);
        transition parser.output.accepted {
            true -> retain(parser, handle),
            _ -> done()
        }
    }

    machine retain(parser: @mutable |parser|::Parser, handle: u64 in Trapping) {
        transition handle < parser.output.name_path_count {
            true -> write(parser, handle),
            _ -> invalid()
        }
    }

    machine write(parser: @mutable |parser|::Parser, handle: u64 in Trapping)
    requires handle < parser.output.name_path_count
    {
        let mutable path: |syntax_trees|::NamePath = parser.output.name_paths[handle as -Trapping];
        path.first_argument = parser.committed_type_first;
        path.argument_count = parser.committed_type_count;
        path.source_span.span.end = parser.token_end;
        parser.output.name_paths[handle as -Trapping] = path;
    }

    machine reject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::UnsupportedDomainArguments);
    }

    machine invalid() { crash Trap; }

    machine done() {}
}

// Whether the `<` at the cursor opens a static argument list: its matching
// `>` is followed by `(`, and everything between can spell types and
// integer static values. The scan reads tokens without moving the cursor or
// building anything, so a comparison is untouched.
machine static_arguments_ahead(parser: @|parser|::Parser, input: @|tokens|::TokenStream) -> bool
crashes Trap
{
    transition { _ -> scan(input, parser.cursor + 1, 1 as +Trapping) }

    machine scan(input: @|tokens|::TokenStream, index: u64 in Trapping, depth: u64 in Trapping) -> bool {
        transition index < input.token_count {
            true -> token(input, index, depth),
            _ -> absent()
        }
    }

    machine token(input: @|tokens|::TokenStream, index: u64 in Trapping, depth: u64 in Trapping) -> bool {
        let token: |tokens|::Token = input.tokens[index as -Trapping];
        transition token.kind {
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Less, .. } -> scan(input, index + 1, depth + 1),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Greater, .. } -> close(input, index, depth),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Pipe, .. } -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::ColonColon, .. } -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Comma, .. } -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Ampersand, .. } -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::At, .. } -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::LeftBracket, .. } -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::RightBracket, .. } -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Semicolon, .. } -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Apostrophe, .. } -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Identifier -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Keyword { keyword, .. } -> scan(input, index + 1, depth),
            |tokens|::TokenKind::Integer { base, empty_digits, has_suffix, .. } -> scan(input, index + 1, depth),
            _ -> absent()
        }
    }

    machine close(input: @|tokens|::TokenStream, index: u64 in Trapping, depth: u64 in Trapping) -> bool {
        transition depth > 1 {
            true -> scan(input, index + 1, depth - 1),
            _ -> called(input, index + 1)
        }
    }

    machine called(input: @|tokens|::TokenStream, index: u64 in Trapping) -> bool {
        transition index < input.token_count {
            true -> opens_call(input, index),
            _ -> absent()
        }
    }

    machine opens_call(input: @|tokens|::TokenStream, index: u64 in Trapping) -> bool {
        let token: |tokens|::Token = input.tokens[index as -Trapping];
        transition token.kind {
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::LeftParen, .. } -> present(),
            _ -> absent()
        }
    }

    machine present() -> bool {
        true
    }

    machine absent() -> bool {
        false
    }
}
