use pipeline/tokens_to_syntax_trees/callable_header.omg;
use pipeline/tokens_to_syntax_trees/generics.omg;
use pipeline/tokens_to_syntax_trees/input.omg;
use pipeline/tokens_to_syntax_trees/statement.omg;
use pipeline/tokens_to_syntax_trees/types.omg;
use pipeline/tokens_to_syntax_trees/parser.omg;

use representations/syntax_trees/syntax_trees.omg;
use representations/tokens/tokens.omg;

// What precedes a machine declaration's `machine` keyword: where the
// declaration starts, `public`, a target name (`linux_arm64 machine ...`),
// `boundary`, and whether it stands at the root or inside a trait or a
// conformance.
public data MachineHead [copy] {
    start: u64 in Trapping;
    is_public: bool;
    has_target: bool;
    target_start: u64 in Trapping;
    target_end: u64 in Trapping;
    is_boundary: bool;
    container: |syntax_trees|::MachineContainer;
}

// Machine-declaration grammar attached to the parser owner:
// `[public] [target] [boundary] machine [token] [Owner::]name [<generic
// parameters>] [(parameters)] [-> Type] contracts clauses ({ statements
// state* } | ;)`, entered at the `machine` keyword with its head. A fixed
// operator token (`+`, `==`, `[]`, `[..]`, ...) binds operator syntax to the
// declaration; a conformance member supplies an implementation and binds no
// token. The `requires machine` contracts of its static machine binders precede
// its other clauses. generics.omg owns the generic parameters, shared with
// data declarations; clause.omg owns the clauses and statement.omg the
// statements; the entry's statements precede the `state` members. A bodyless
// declaration ends at `;`: whether its signature has a supply (a compiler
// primitive, a requirement, a boundary provider) is checking's question, not
// the grammar's. A trait or conformance member names no owner, and only a
// root declaration is retained as a root.
public machine parse_machine(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, head: MachineHead)
crashes Trap
{
    parser.machine_parent = 0 as +Trapping;
    parser.machine_start = head.start;
    parser.machine_is_public = head.is_public;
    parser.machine_has_target = head.has_target;
    parser.machine_target_start = head.target_start;
    parser.machine_target_end = head.target_end;
    parser.machine_is_boundary = head.is_boundary;
    parser.machine_container = head.container;
    transition parser.output.machine_count < 10240 {
        true -> keyword(parser, input),
        _ -> machine_full(parser, input)
    }

    machine machine_full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::MachineCapacityExceeded);
    }

    machine keyword(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        parser.machine_first_generic = parser.output.generic_parameter_count as +Trapping;
        parser.machine_generic_count = 0 as +Trapping;
        parser.machine_contract_count = 0 as +Trapping;
        parser.machine_first_expression = parser.output.expression_count as +Trapping;
        parser.machine_operator = |syntax_trees|::OperatorToken::None;
        parser.machine_token_start = 0 as +Trapping;
        parser.machine_token_end = 0 as +Trapping;
        parser.machine_first_component = 0 as +Trapping;
        parser.machine_component_count = 0 as +Trapping;
        parse_operator_token(parser, input);
        let tokened: bool = parser.machine_operator != |syntax_trees|::OperatorToken::None;
        let member: bool = parser.machine_container == |syntax_trees|::MachineContainer::Conformance;
        transition parser.output.accepted {
            true -> token_admitted(parser, input, tokened && member),
            _ -> done()
        }
    }

    // A conformance supplies its trait's requirements and binds no token.
    machine token_admitted(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, refused: bool) {
        transition refused {
            true -> token_refused(parser),
            _ -> name(parser, input)
        }
    }

    machine token_refused(parser: @mutable |parser|::Parser) {
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, |syntax_trees|::ParseDiagnosticCode::OperatorTokenNotAdmitted,
            parser.source, parser.machine_token_start, parser.machine_token_end);
    }

    machine name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMachineName);
        transition parser.output.accepted {
            true -> first_name(parser, input),
            _ -> done()
        }
    }

    machine first_name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.machine_has_owner = false;
        parser.machine_owner_start = 0 as +Trapping;
        parser.machine_owner_end = 0 as +Trapping;
        parser.machine_name_start = parser.name_start;
        parser.machine_name_end = parser.name_end;
        let separator: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::ColonColon);
        let at_root: bool = machine_at_root(parser.machine_container) && parser.machine_parent == 0;
        transition separator && at_root {
            true -> owned_name(parser, input),
            _ -> generic_list(parser, input)
        }
    }

    machine owned_name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        parser.machine_has_owner = true;
        parser.machine_owner_start = parser.machine_name_start;
        parser.machine_owner_end = parser.machine_name_end;
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMachineName);
        transition parser.output.accepted {
            true -> owned_named(parser, input),
            _ -> done()
        }
    }

    machine owned_named(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.machine_name_start = parser.name_start;
        parser.machine_name_end = parser.name_end;
        transition { _ -> generic_list(parser, input) }
    }

    machine generic_list(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let generic: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Less);
        let ordered: bool = parser.machine_container == |syntax_trees|::MachineContainer::Measure
            && |input|::at_word(parser, input, "lexicographic");
        transition generic {
            true -> generics(parser, input),
            _ -> lexicographic_word(parser, input, ordered)
        }
    }

    machine lexicographic_word(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, ordered: bool) {
        transition ordered {
            true -> components_open(parser, input),
            _ -> signature(parser, input)
        }
    }

    // `lexicographic { field, field }`: a bodyless measure ranking by the
    // tuple of its owner's named fields, kept as a member run.
    machine components_open(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        parser.machine_first_component = parser.output.member_count as +Trapping;
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace, |syntax_trees|::ParseDiagnosticCode::ExpectedMeasureComponent);
        transition parser.output.accepted {
            true -> component(parser, input),
            _ -> done()
        }
    }

    machine component(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMeasureComponent);
        transition parser.output.accepted && parser.output.member_count < 32000 {
            true -> component_retained(parser, input),
            _ -> component_full(parser, input)
        }
    }

    machine component_full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.accepted {
            true -> rejected(parser, input, |syntax_trees|::ParseDiagnosticCode::PathMemberCapacityExceeded),
            _ -> done()
        }
    }

    machine component_retained(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.output.members[parser.output.member_count] = |parser|::identifier_span(parser, parser.name_start, parser.name_end);
        parser.output.member_count = parser.output.member_count + 1;
        parser.machine_component_count = parser.machine_component_count + 1;
        let more: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        transition more {
            true -> component_separator(parser, input),
            _ -> components_close(parser, input)
        }
    }

    machine component_separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> component(parser, input) }
    }

    // A lexicographic measure owns empty parameter, clause, statement, state
    // and contract ranges at the tables' ends.
    machine components_close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace, |syntax_trees|::ParseDiagnosticCode::ExpectedMeasureComponent);
        parser.machine_first_parameter = parser.output.parameter_count as +Trapping;
        parser.machine_parameter_count = 0 as +Trapping;
        parser.machine_has_return_type = false;
        parser.machine_return_type = 0 as +Trapping;
        parser.machine_first_clause = parser.output.clause_count as +Trapping;
        parser.machine_clause_count = 0 as +Trapping;
        parser.machine_first_statement = parser.output.statement_count as +Trapping;
        parser.machine_statement_count = 0 as +Trapping;
        parser.machine_first_contract = parser.output.contract_count as +Trapping;
        parser.machine_contract_count = 0 as +Trapping;
        transition parser.output.accepted && parser.output.machine_count < 10240 {
            true -> retain(parser, input, false),
            _ -> components_rejected(parser, input)
        }
    }

    machine components_rejected(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.accepted {
            true -> machine_full(parser, input),
            _ -> done()
        }
    }

    machine rejected(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::reject_current(parser, input, code);
    }

    machine generics(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |generics|::parse_generic_parameters(parser, input);
        parser.machine_generic_count =
            (parser.output.generic_parameter_count as +Trapping) - parser.machine_first_generic;
        transition parser.output.accepted {
            true -> signature(parser, input),
            _ -> done()
        }
    }

    machine signature(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parse_signature(parser, input);
        transition parser.output.accepted {
            true -> clauses(parser, input),
            _ -> done()
        }
    }

    machine clauses(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.machine_first_parameter = parser.signature_first_parameter;
        parser.machine_parameter_count = parser.signature_parameter_count;
        parser.machine_has_return_type = parser.signature_has_return_type;
        parser.machine_return_type = parser.signature_return_type;
        let owner: |syntax_trees|::ClauseOwner = machine_clause_owner(parser.machine_container);
        |callable_header|::parse_callable_header(parser, input, owner);
        transition parser.output.accepted {
            true -> header_end(parser, input),
            _ -> done()
        }
    }

    machine header_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let bodyless: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Semicolon);
        transition bodyless {
            true -> signature_end(parser, input),
            _ -> body_open(parser, input)
        }
    }

    machine body_open(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace,
            |syntax_trees|::ParseDiagnosticCode::ExpectedMachineBody
        );
        transition parser.output.accepted {
            true -> entry_statements(parser, input),
            _ -> done()
        }
    }

    // A bodyless declaration owns an empty executable range at the tables' ends.
    machine signature_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        parser.machine_first_statement = parser.output.statement_count as +Trapping;
        parser.machine_statement_count = 0 as +Trapping;
        transition parser.output.machine_count < 10240 {
            true -> retain(parser, input, false),
            _ -> machine_full(parser, input)
        }
    }

    machine entry_statements(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |statement|::parse_statements(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMachineBodyEnd);
        transition parser.output.accepted {
            true -> entry_statements_retained(parser, input),
            _ -> done()
        }
    }

    machine entry_statements_retained(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.machine_first_statement = parser.body_first_statement;
        parser.machine_statement_count =
            (parser.output.statement_count as +Trapping) - parser.body_first_statement;
        transition parser.output.machine_count < 10240 {
            true -> retain(parser, input, true),
            false -> machine_full(parser, input)
        }
    }

    // Headers and executable ranges are frozen before children append their own rows.
    // The current declaration handle is the parser stack; closing a child resumes its
    // exact lexical parent without keeping invocation-local header scratch alive.
    machine member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace);
        let nested: bool = |input|::at_keyword(parser, input, |tokens|::KeywordKind::Machine);
        transition closing {
            true -> close(parser, input),
            false -> nested_member(parser, input, nested)
        }
    }

    machine nested_member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, nested: bool) {
        transition nested {
            true -> nested_capacity(parser, input),
            false -> body_end_rejected(parser, input)
        }
    }

    machine nested_capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.machine_count < 10240 {
            true -> nested_header(parser, input),
            false -> machine_full(parser, input)
        }
    }

    machine nested_header(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::load_current(parser, input);
        let token: |tokens|::Token = input.tokens[parser.current_index];
        parser.machine_parent = parser.machine_current + 1;
        parser.machine_start = token.start;
        parser.machine_is_public = false;
        parser.machine_has_target = false;
        parser.machine_target_start = 0 as +Trapping;
        parser.machine_target_end = 0 as +Trapping;
        parser.machine_is_boundary = false;
        parser.machine_container = |syntax_trees|::MachineContainer::Root;
        transition { _ -> keyword(parser, input) }
    }

    machine body_end_rejected(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMachineBodyEnd);
    }

    machine close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let current: u64 in Trapping = parser.machine_current;
        transition current < 10240 {
            true -> close_bounded(parser, input, current),
            false -> invalid_handle()
        }
    }

    machine close_bounded(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, current: u64 in Trapping)
    requires current < 10240
    {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(@parser.output, current);
        parser.output.machines[current as -Trapping].source_span.span.end = parser.token_end;
        transition { _ -> completed(parser, input, current, item.parent) }
    }

    machine invalid_handle() { crash Trap; }

    machine completed(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, current: u64 in Trapping, parent: u64 in Trapping) {
        transition parent > 0 {
            true -> resume_parent(parser, input, parent - 1),
            false -> root_completion(parser, input, current)
        }
    }

    machine resume_parent(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, parent: u64 in Trapping) {
        parser.machine_current = parent;
        transition { _ -> member(parser, input) }
    }

    machine root_completion(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, current: u64 in Trapping) {
        parser.machine_result = current;
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(@parser.output, current);
        let at_root: bool = machine_at_root(item.container);
        transition at_root {
            true -> root(parser, input, current),
            false -> done()
        }
    }

    machine retain(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, has_body: bool) {
        let machine_index: u64 in Trapping = parser.output.machine_count as +Trapping;
        parser.output.machines[parser.output.machine_count] = |syntax_trees|::MachineItem {
            has_owner: parser.machine_has_owner,
            owner: |parser|::identifier_span(parser, parser.machine_owner_start, parser.machine_owner_end),
            name: |parser|::identifier_span(parser, parser.machine_name_start, parser.machine_name_end),
            first_generic_parameter: parser.machine_first_generic,
            generic_parameter_count: parser.machine_generic_count,
            first_parameter: parser.machine_first_parameter,
            parameter_count: parser.machine_parameter_count,
            has_return_type: parser.machine_has_return_type,
            return_type: parser.machine_return_type,
            first_clause: parser.machine_first_clause,
            clause_count: parser.machine_clause_count,
            first_statement: parser.machine_first_statement,
            statement_count: parser.machine_statement_count,
            parent: parser.machine_parent,
            has_body: has_body,
            first_expression: parser.machine_first_expression,
            expression_count: (parser.output.expression_count as +Trapping) - parser.machine_first_expression,
            has_target: parser.machine_has_target,
            target: |parser|::identifier_span(parser, parser.machine_target_start, parser.machine_target_end),
            is_boundary: parser.machine_is_boundary,
            container: parser.machine_container,
            is_public: parser.machine_is_public,
            operator: parser.machine_operator,
            token: |parser|::identifier_span(parser, parser.machine_token_start, parser.machine_token_end),
            first_contract: parser.machine_first_contract,
            contract_count: parser.machine_contract_count,
            every_requirement: false,
            first_component: parser.machine_first_component,
            component_count: parser.machine_component_count,
            source_span: |parser|::parser_source_span(parser, parser.machine_start, parser.token_end)
        };
        parser.output.machine_count = parser.output.machine_count + 1;
        parser.machine_current = machine_index;
        let machine_parent: u64 in Trapping = parser.machine_parent;
        transition has_body {
            true -> member(parser, input),
            false -> completed(parser, input, machine_index, machine_parent)
        }
    }

    machine root(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, machine_index: u64 in Trapping) {
        transition parser.output.root_count < 4096 {
            true -> root_bounded(parser, machine_index),
            _ -> root_full(parser, input)
        }
    }

    machine root_bounded(parser: @mutable |parser|::Parser, machine_index: u64 in Trapping) {
        parser.output.roots[parser.output.root_count] = |syntax_trees|::RootItem {
            kind: |syntax_trees|::RootItemKind::Machine,
            item_index: machine_index,
            source_span: |syntax_trees|::machine_item(@parser.output, machine_index).source_span
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    machine root_full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::RootCapacityExceeded);
    }

    machine done() {}
}

// A trait member reads its clauses as a trait member: `requires` after its
// `;` is the trait's body parent.
machine machine_clause_owner(container: |syntax_trees|::MachineContainer) -> |syntax_trees|::ClauseOwner {
    transition container {
        |syntax_trees|::MachineContainer::Trait -> member(),
        _ -> declaration()
    }

    machine member() -> |syntax_trees|::ClauseOwner {
        |syntax_trees|::ClauseOwner::TraitMember
    }

    machine declaration() -> |syntax_trees|::ClauseOwner {
        |syntax_trees|::ClauseOwner::Machine
    }
}

// The optional fixed token after `machine`, from the closed vocabulary of
// wiki/spec/language/expressions.md: an arithmetic or comparison token,
// `[]` or `[..]`. Any other token leaves no token, and the name follows.
// The token lands in `machine_operator` and its span in `machine_token_*`.
machine parse_operator_token(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream)
crashes Trap
{
    |input|::load_current(parser, input);
    transition parser.current_present {
        true -> token(parser, input),
        _ -> done()
    }

    machine token(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        transition token.kind {
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Plus, .. } -> single(parser, input, |syntax_trees|::OperatorToken::Add),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Minus, .. } -> single(parser, input, |syntax_trees|::OperatorToken::Subtract),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Asterisk, .. } -> single(parser, input, |syntax_trees|::OperatorToken::Multiply),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Slash, .. } -> single(parser, input, |syntax_trees|::OperatorToken::Divide),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Percent, .. } -> single(parser, input, |syntax_trees|::OperatorToken::Modulo),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::EqualEqual, .. } -> single(parser, input, |syntax_trees|::OperatorToken::Equal),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::ExclamationEqual, .. } -> single(parser, input, |syntax_trees|::OperatorToken::NotEqual),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Less, .. } -> single(parser, input, |syntax_trees|::OperatorToken::Less),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::LessEqual, .. } -> single(parser, input, |syntax_trees|::OperatorToken::LessEqual),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Greater, .. } -> single(parser, input, |syntax_trees|::OperatorToken::Greater),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::GreaterEqual, .. } -> single(parser, input, |syntax_trees|::OperatorToken::GreaterEqual),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::LeftBracket, .. } -> bracket(parser, input),
            _ -> done()
        }
    }

    machine single(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operator: |syntax_trees|::OperatorToken) {
        |input|::take_current(parser, input);
        parser.machine_token_start = parser.token_start;
        transition { _ -> close(parser, operator) }
    }

    // `[]` indexes and `[..]` slices a range.
    machine bracket(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        parser.machine_token_start = parser.token_start;
        let ranged: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::DotDot);
        transition ranged {
            true -> range(parser, input),
            _ -> bracket_close(parser, input, |syntax_trees|::OperatorToken::Index)
        }
    }

    machine range(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> bracket_close(parser, input, |syntax_trees|::OperatorToken::Range) }
    }

    machine bracket_close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, operator: |syntax_trees|::OperatorToken) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::RightBracket, |syntax_trees|::ParseDiagnosticCode::UnknownOperatorToken);
        transition parser.output.accepted {
            true -> close(parser, operator),
            _ -> done()
        }
    }

    machine close(parser: @mutable |parser|::Parser, operator: |syntax_trees|::OperatorToken) {
        parser.machine_operator = operator;
        parser.machine_token_end = parser.token_end;
    }

    machine done() {}
}

// Append one contract row.
public machine retain_contract(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, contract: |syntax_trees|::Contract)
crashes Trap
{
    transition parser.output.contract_count < 256 {
        true -> append(parser, contract),
        _ -> full(parser, input)
    }

    machine append(parser: @mutable |parser|::Parser, contract: |syntax_trees|::Contract) {
        parser.output.contracts[parser.output.contract_count] = contract;
        parser.output.contract_count = parser.output.contract_count + 1;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ContractCapacityExceeded);
    }
}

machine machine_at_root(container: |syntax_trees|::MachineContainer) -> bool {
    transition container {
        |syntax_trees|::MachineContainer::Root -> root(),
        |syntax_trees|::MachineContainer::Measure -> root(),
        _ -> member()
    }

    machine root() -> bool {
        true
    }

    machine member() -> bool {
        false
    }
}

// `[(parameters)] [-> Type]`, shared by machine and state heads. The result
// lands in the `signature_*` scratch fields.
machine parse_signature(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream)
crashes Trap
{
    parse_parameters(parser, input);
    parser.signature_has_return_type = false;
    parser.signature_return_type = 0 as +Trapping;
    transition parser.output.accepted {
        true -> return_type(parser, input),
        _ -> done()
    }

    machine return_type(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let arrow: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Arrow);
        transition arrow {
            true -> return_type_taken(parser, input),
            _ -> done()
        }
    }

    machine return_type_taken(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        |types|::parse_type_reference(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMachineReturnType);
        transition parser.output.accepted {
            true -> return_type_retained(parser),
            _ -> done()
        }
    }

    machine return_type_retained(parser: @mutable |parser|::Parser) {
        parser.signature_has_return_type = true;
        parser.signature_return_type = parser.type_result;
    }

    machine done() {}
}

// `[([mutable] name: Type, ...)]`, the parameter list of a machine, state or
// proposition head; `mutable` lets the body assign the parameter. The range lands in `signature_first_parameter` and
// `signature_parameter_count`.
machine parse_parameters(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream)
crashes Trap
{
    parser.signature_first_parameter = parser.output.parameter_count as +Trapping;
    parser.signature_parameter_count = 0 as +Trapping;
    let listed: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftParen);
    transition listed {
        true -> parameters(parser, input),
        _ -> done()
    }

    machine parameters(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightParen);
        transition closing {
            true -> close(parser, input),
            _ -> parameter(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMachineParameterOrEnd)
        }
    }

    machine parameter(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        transition parser.output.parameter_count < 32768 {
            true -> parameter_name(parser, input, code),
            _ -> parameter_full(parser, input)
        }
    }

    machine parameter_full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ParameterCapacityExceeded);
    }

    // `mutable` before a name marks the parameter mutable; a parameter named
    // `mutable` is followed by its colon.
    machine parameter_name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        let marked: bool = |input|::at_word(parser, input, "mutable");
        let named: bool = |input|::next_is_punctuation(parser, input, |tokens|::PunctuationKind::Colon);
        parser.parameter_mutable = marked && !named;
        transition marked && !named {
            true -> mutable_name(parser, input, code),
            _ -> parameter_named(parser, input, code)
        }
    }

    machine mutable_name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::take_current(parser, input);
        transition { _ -> parameter_named(parser, input, code) }
    }

    machine parameter_named(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::expect_name(parser, input, code);
        transition parser.output.accepted {
            true -> parameter_marker(parser, input),
            _ -> done()
        }
    }

    machine parameter_marker(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.parameter_name_start = parser.name_start;
        parser.parameter_name_end = parser.name_end;
        |input|::parse_erased_marker(parser, input);
        transition parser.output.accepted {
            true -> parameter_colon(parser, input),
            _ -> done()
        }
    }

    machine parameter_colon(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Colon,
            |syntax_trees|::ParseDiagnosticCode::ExpectedMachineParameterColon
        );
        transition parser.output.accepted {
            true -> parameter_type(parser, input),
            _ -> done()
        }
    }

    machine parameter_type(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |types|::parse_type_reference(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMachineParameterType);
        transition parser.output.accepted {
            true -> retain_capacity(parser, input),
            _ -> done()
        }
    }

    machine retain_capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.parameter_count < 32768 {
            true -> retain(parser, input),
            _ -> parameter_full(parser, input)
        }
    }

    // `parameter` keeps the caller's guarded count across `record_erased`.
    machine retain(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let parameter: u64 in Trapping = parser.output.parameter_count as +Trapping;
        let type_end: u64 in Trapping = parser.type_end;
        |input|::record_erased(parser, |syntax_trees|::ErasedBindingKind::Parameter, parameter, type_end);
        parser.output.parameters[parameter as -Trapping] = |syntax_trees|::Parameter {
            name: |parser|::identifier_span(parser, parser.parameter_name_start, parser.parameter_name_end),
            type_reference: parser.type_result,
            is_mutable: parser.parameter_mutable,
            source_span: |parser|::parser_source_span(parser, parser.parameter_name_start, parser.type_end)
        };
        parser.output.parameter_count = (parameter + 1) as u64;
        let separator: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        transition separator {
            true -> separator_taken(parser, input),
            _ -> parameter_end(parser, input)
        }
    }

    // A comma always introduces another parameter: there is no trailing comma.
    machine separator_taken(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> parameter(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMachineParameter) }
    }

    machine parameter_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightParen);
        transition closing {
            true -> close(parser, input),
            _ -> parameter_end_rejected(parser, input)
        }
    }

    machine parameter_end_rejected(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedMachineParameterEnd);
    }

    machine close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        parser.signature_parameter_count =
            (parser.output.parameter_count as +Trapping) - parser.signature_first_parameter;
    }

    machine done() {}
}
