use pipeline/tokens_to_syntax_trees/input.omg;
use pipeline/tokens_to_syntax_trees/parser.omg;

use representations/source_files/source.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/tokens/tokens.omg;

// One open type constructor. `start` is where its type begins; a
// `Reference` keeps its `access`; an `Arguments` frame keeps its applied
// name's end and the base of its staged arguments. `first_row` is the next
// row when the frame opened, so the finished type's run begins there.
public data TypeFrameKind [copy] {
    case Reference;
    case Array;
    case Arguments;
}

public data TypeFrame [copy] {
    kind: TypeFrameKind;
    access: |syntax_trees|::ReferenceAccess;
    start: u64 in Trapping;
    name_end: u64 in Trapping;
    first_argument: u64 in Trapping;
    first_row: u64 in Trapping;
    has_lifetime: bool;
    lifetime: |syntax_trees|::IdentifierSpan;
    first_lifetime: u64 in Trapping;
}

// The one type grammar every type position shares:
//
//     type     = `@` [`'` tag] [`mutable` | `write`] type
//              | `[` type [`;` length] `]` [`in` Domain]
//              | Name [`<` argument {`,` argument} `>`] [`in` Domain]
//     argument = `'` tag | type | integer
//     length   = integer | Name
//     Domain   = Name {`::` Name}
//
// Types nest, so the grammar keeps an explicit frame stack instead of
// recursing: `@`, `[` and `Name<` each open a frame, and each completed type
// closes the frames above it until one still expects more input. Every row
// is appended after its children, so one type fills a contiguous run of
// `SyntaxTrees::type_references` that ends at its root, and every row records
// where its own run begins. The root's handle lands in `type_result` and its
// source end in `type_end`. `missing` is the caller's diagnostic for an absent
// type; nested positions use the array and static-argument diagnostics.
public machine parse_type_reference(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, missing: |syntax_trees|::ParseDiagnosticCode)
crashes Trap
{
    parser.type_frame_depth = 0;
    transition { _ -> operand(parser, input, missing) }

    // The start of one type: open frames for its prefixes, then read its name.
    // Among a list's arguments, `'tag` is a lifetime argument, which is no
    // type and leaves no row.
    machine operand(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        let reference: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::At);
        let tick: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Apostrophe);
        let argument: bool = in_type_arguments(parser)
            || parser.type_static_argument && parser.type_frame_depth == 0;
        transition tick && argument {
            true -> lifetime_argument(parser, input),
            _ -> operand_type(parser, input, code, reference)
        }
    }

    machine operand_type(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode, reference: bool) {
        transition reference {
            true -> reference_open(parser, input, code),
            _ -> array_word(parser, input, code)
        }
    }

    machine lifetime_argument(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedLifetimeName);
        transition parser.output.accepted {
            true -> lifetime_staged(parser, input),
            _ -> done()
        }
    }

    machine lifetime_staged(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let tag: |syntax_trees|::IdentifierSpan = |parser|::identifier_span(parser, parser.name_start, parser.name_end);
        let listed: bool = in_type_arguments(parser);
        push_type_lifetime(parser, input, tag);
        transition parser.output.accepted && listed {
            true -> lifetime_listed(parser, input),
            _ -> lifetime_static(parser, input)
        }
    }

    // Lifetime arguments precede the other arguments of a list.
    machine lifetime_listed(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let frame: TypeFrame = top_type_frame(parser);
        let staged: u64 in Trapping = parser.pending_type_argument_count as +Trapping;
        transition staged == frame.first_argument {
            true -> argument_separator(parser, input, frame),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::GenericLifetimeOrdering)
        }
    }

    // A static argument that is a lifetime: no row results.
    machine lifetime_static(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.accepted {
            true -> lifetime_only(parser),
            _ -> done()
        }
    }

    machine lifetime_only(parser: @mutable |parser|::Parser) {
        parser.type_result = 0 as +Trapping;
        parser.type_lifetime_argument = true;
    }

    machine array_word(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        let array: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftBracket);
        transition array {
            true -> array_open(parser, input),
            _ -> literal_word(parser, input, code)
        }
    }

    // An integer is a static argument; it is a type only inside `<...>`.
    machine literal_word(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        let integer: bool = |input|::at_integer(parser, input);
        let argument: bool = in_type_arguments(parser)
            || parser.type_static_argument && parser.type_frame_depth == 0;
        transition integer && argument {
            true -> literal(parser, input),
            _ -> name(parser, input, code)
        }
    }

    // `@`, then an optional lifetime tag `'tag` before the access modifier
    // (wiki/spec/language/lifetimes.md#binders-and-source-applications).
    machine reference_open(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::take_current(parser, input);
        let start: u64 in Trapping = parser.token_start;
        let tick: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Apostrophe);
        let none: |syntax_trees|::IdentifierSpan = |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping);
        transition tick {
            true -> reference_lifetime(parser, input, start, code),
            _ -> reference_access(parser, input, start, code, false, none)
        }
    }

    machine reference_lifetime(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::take_current(parser, input);
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedLifetimeName);
        let tag: |syntax_trees|::IdentifierSpan = |parser|::identifier_span(parser, parser.name_start, parser.name_end);
        transition parser.output.accepted {
            true -> reference_access(parser, input, start, code, true, tag),
            _ -> done()
        }
    }

    machine reference_access(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        start: u64 in Trapping,
        code: |syntax_trees|::ParseDiagnosticCode,
        has_lifetime: bool,
        lifetime: |syntax_trees|::IdentifierSpan
    ) {
        let marked_mutable: bool = |input|::at_word(parser, input, "mutable");
        let write_only: bool = |input|::at_word(parser, input, "write");
        let opened: TypeFrame = type_frame(parser, TypeFrameKind::Reference, |syntax_trees|::ReferenceAccess::Shared, start);
        let frame: TypeFrame = lifetime_frame(opened, has_lifetime, lifetime);
        transition marked_mutable {
            true -> accessed(parser, input, frame, code, |syntax_trees|::ReferenceAccess::Mutable),
            _ -> unqualified(parser, input, frame, code, write_only)
        }
    }

    machine unqualified(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, code: |syntax_trees|::ParseDiagnosticCode, write_only: bool) {
        transition write_only {
            true -> accessed(parser, input, frame, code, |syntax_trees|::ReferenceAccess::WriteOnly),
            _ -> push(parser, input, frame, code)
        }
    }

    // `mutable` lends exclusively; `write` lends exclusively without observation.
    machine accessed(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, code: |syntax_trees|::ParseDiagnosticCode, access: |syntax_trees|::ReferenceAccess) {
        |input|::take_current(parser, input);
        let qualified: TypeFrame = frame_access(frame, access);
        transition { _ -> push(parser, input, qualified, code) }
    }

    machine array_open(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let start: u64 in Trapping = parser.token_start;
        let frame: TypeFrame = type_frame(parser, TypeFrameKind::Array, |syntax_trees|::ReferenceAccess::Shared, start);
        transition {
            _ -> push(parser, input, frame,
                |syntax_trees|::ParseDiagnosticCode::ExpectedArrayElementType
            )
        }
    }

    machine push(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, code: |syntax_trees|::ParseDiagnosticCode) {
        transition parser.type_frame_depth < 16 {
            true -> pushed(parser, input, frame, code),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::TypeNestingCapacityExceeded)
        }
    }

    machine pushed(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, code: |syntax_trees|::ParseDiagnosticCode) {
        parser.type_frames[parser.type_frame_depth] = frame;
        parser.type_frame_depth = parser.type_frame_depth + 1;
        transition { _ -> operand(parser, input, code) }
    }

    machine literal(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let literal_handle: u64 in Trapping = |input|::take_integer_literal(parser, input);
        let mutable row: |syntax_trees|::TypeReference = type_row(parser, |syntax_trees|::TypeReferenceKind::Literal,
            parser.token_start, parser.token_end, parser.token_start, parser.token_end);
        row.literal = literal_handle;
        transition parser.output.accepted {
            true -> append(parser, input, row),
            _ -> done()
        }
    }

    machine name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::expect_name(parser, input, code);
        let name_start: u64 in Trapping = parser.name_start;
        transition parser.output.accepted {
            true -> path(parser, input, name_start),
            _ -> done()
        }
    }

    // `a\b\Name` names one declaration through its path; the row's name
    // spans the whole path.
    machine path(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping) {
        let qualified: bool = |input|::at_path_separator(parser, input);
        transition qualified {
            true -> path_member(parser, input, start),
            _ -> named(parser, input, start)
        }
    }

    machine path_member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping) {
        |input|::take_current(parser, input);
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedPathMember);
        transition parser.output.accepted {
            true -> path(parser, input, start),
            _ -> done()
        }
    }

    machine named(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping) {
        let end: u64 in Trapping = parser.name_end;
        let applied: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Less);
        transition applied {
            true -> arguments_open(parser, input, start, end),
            _ -> named_row(parser, input, start, end)
        }
    }

    machine named_row(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, end: u64 in Trapping) {
        let row: |syntax_trees|::TypeReference = type_row(parser, |syntax_trees|::TypeReferenceKind::Named, start, end, start, end);
        transition { _ -> domain(parser, input, row) }
    }

    machine arguments_open(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, start: u64 in Trapping, end: u64 in Trapping) {
        |input|::take_current(parser, input);
        let frame: TypeFrame = type_frame(parser, TypeFrameKind::Arguments, |syntax_trees|::ReferenceAccess::Shared, start);
        transition { _ -> push(parser, input, named_frame(frame, end), |syntax_trees|::ParseDiagnosticCode::ExpectedStaticArgument) }
    }

    // `Named`, `Array` and `Slice` rows may close with `in Domain`, where
    // the domain may be a path such as a case's implied domain `Type::Case`:
    // its last member is the qualifier's own name and the members before it
    // its owner path.
    machine domain(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, row: |syntax_trees|::TypeReference) {
        let qualified: bool = |input|::at_word(parser, input, "in");
        transition qualified {
            true -> domain_name(parser, input, row),
            _ -> append(parser, input, row)
        }
    }

    machine domain_name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, row: |syntax_trees|::TypeReference) {
        |input|::take_current(parser, input);
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedTypeQualifierDomain);
        let name_start: u64 in Trapping = parser.name_start;
        transition parser.output.accepted {
            true -> domain_path(parser, input, row, name_start, name_start),
            _ -> done()
        }
    }

    // The path so far runs from `start`; its members before the latest end
    // at `owner_end`, which is `start` while it has one member.
    machine domain_path(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, row: |syntax_trees|::TypeReference, start: u64 in Trapping, owner_end: u64 in Trapping) {
        let separated: bool = |input|::at_path_separator(parser, input);
        let name_end: u64 in Trapping = parser.name_end;
        transition separated {
            true -> domain_member(parser, input, row, start, name_end),
            _ -> qualified(parser, input, row, start, owner_end)
        }
    }

    machine domain_member(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, row: |syntax_trees|::TypeReference, start: u64 in Trapping, owner_end: u64 in Trapping) {
        |input|::take_current(parser, input);
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedPathMember);
        transition parser.output.accepted {
            true -> domain_path(parser, input, row, start, owner_end),
            _ -> done()
        }
    }

    machine qualified(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, row: |syntax_trees|::TypeReference, start: u64 in Trapping, owner_end: u64 in Trapping) {
        let domain: |syntax_trees|::IdentifierSpan = |parser|::identifier_span(parser, parser.name_start, parser.name_end);
        let owner: |syntax_trees|::IdentifierSpan = |parser|::identifier_span(parser, start, owner_end);
        let span: |source|::SourceSpan = |parser|::parser_source_span(parser, row.source_span.span.start, parser.name_end);
        transition { _ -> append(parser, input, with_domain(row, owner_end > start, owner, domain, span)) }
    }

    machine append(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, row: |syntax_trees|::TypeReference) {
        transition parser.output.type_reference_count < 65536 {
            true -> appended(parser, input, row),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::TypeReferenceCapacityExceeded)
        }
    }

    machine appended(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, row: |syntax_trees|::TypeReference) {
        parser.type_result = parser.output.type_reference_count as +Trapping;
        parser.type_end = row.source_span.span.end;
        parser.output.type_references[parser.output.type_reference_count] = row;
        parser.output.type_reference_count = parser.output.type_reference_count + 1;
        transition { _ -> complete(parser, input) }
    }

    // A type just completed: hand it to the innermost open frame.
    machine complete(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.type_frame_depth > 0 {
            true -> innermost(parser, input),
            _ -> done()
        }
    }

    machine innermost(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let frame: TypeFrame = top_type_frame(parser);
        transition { _ -> close(parser, input, frame) }
    }

    machine close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame) {
        transition frame.kind {
            TypeFrameKind::Reference -> reference_close(parser, input, frame),
            TypeFrameKind::Array -> element_close(parser, input, frame),
            TypeFrameKind::Arguments -> argument_close(parser, input, frame)
        }
    }

    machine reference_close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame) {
        pop_type_frame(parser);
        let row: |syntax_trees|::TypeReference = type_row(parser, |syntax_trees|::TypeReferenceKind::Reference, frame.start, parser.type_end, 0 as +Trapping, 0 as +Trapping);
        let reference: |syntax_trees|::TypeReference = with_children(row, frame.first_row, parser.type_result, 0 as +Trapping);
        let accessed: |syntax_trees|::TypeReference = with_access(reference, frame.access);
        let tagged: |syntax_trees|::TypeReference = with_lifetime(accessed, frame.has_lifetime, frame.lifetime);
        transition { _ -> append(parser, input, tagged) }
    }

    // After an array's element: `;` and a length make a fixed array, `]` a
    // slice.
    machine element_close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame) {
        let element: u64 in Trapping = parser.type_result;
        let fixed: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Semicolon);
        transition fixed {
            true -> length(parser, input, frame, element),
            _ -> slice_end(parser, input, frame, element)
        }
    }

    machine slice_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, element: u64 in Trapping) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::RightBracket,
            |syntax_trees|::ParseDiagnosticCode::ExpectedArraySeparatorOrEnd
        );
        transition parser.output.accepted {
            true -> slice(parser, input, frame, element),
            _ -> done()
        }
    }

    machine slice(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, element: u64 in Trapping) {
        pop_type_frame(parser);
        let row: |syntax_trees|::TypeReference = type_row(parser, |syntax_trees|::TypeReferenceKind::Slice,
            frame.start, parser.token_end, 0 as +Trapping, 0 as +Trapping);
        transition { _ -> domain(parser, input, with_children(row, frame.first_row, element, 0 as +Trapping)) }
    }

    // The length is its own `Literal` or `Named` row, appended before the
    // array row so the run stays contiguous.
    machine length(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, element: u64 in Trapping) {
        |input|::take_current(parser, input);
        let integer: bool = |input|::at_integer(parser, input);
        transition integer {
            true -> length_literal(parser, input, frame, element),
            _ -> length_name(parser, input, frame, element)
        }
    }

    machine length_literal(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, element: u64 in Trapping) {
        let literal_handle: u64 in Trapping = |input|::take_integer_literal(parser, input);
        transition parser.output.accepted {
            true -> length_row(parser, input, frame, element, |syntax_trees|::TypeReferenceKind::Literal, literal_handle),
            _ -> done()
        }
    }

    machine length_name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, element: u64 in Trapping) {
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedArrayLength);
        transition parser.output.accepted {
            true -> length_row(parser, input, frame, element, |syntax_trees|::TypeReferenceKind::Named, 0 as +Trapping),
            _ -> done()
        }
    }

    machine length_row(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        frame: TypeFrame,
        element: u64 in Trapping,
        kind: |syntax_trees|::TypeReferenceKind,
        literal_handle: u64 in Trapping
    ) {
        let mutable row: |syntax_trees|::TypeReference = type_row(parser, kind, parser.token_start, parser.token_end, parser.token_start, parser.token_end);
        row.literal = literal_handle;
        transition parser.output.type_reference_count < 65536 {
            true -> length_appended(parser, input, frame, element, row),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::TypeReferenceCapacityExceeded)
        }
    }

    machine length_appended(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        frame: TypeFrame,
        element: u64 in Trapping,
        row: |syntax_trees|::TypeReference
    ) {
        let length: u64 in Trapping = parser.output.type_reference_count as +Trapping;
        parser.output.type_references[parser.output.type_reference_count] = row;
        parser.output.type_reference_count = parser.output.type_reference_count + 1;
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::RightBracket, |syntax_trees|::ParseDiagnosticCode::ExpectedArrayEnd);
        transition parser.output.accepted {
            true -> array(parser, input, frame, element, length),
            _ -> done()
        }
    }

    machine array(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        frame: TypeFrame,
        element: u64 in Trapping,
        length: u64 in Trapping
    ) {
        pop_type_frame(parser);
        let row: |syntax_trees|::TypeReference = type_row(parser, |syntax_trees|::TypeReferenceKind::Array,
            frame.start, parser.token_end, 0 as +Trapping, 0 as +Trapping);
        transition { _ -> domain(parser, input, with_children(row, frame.first_row, element, length)) }
    }

    // After a static argument: `,` opens the next and `>` closes the list.
    machine argument_close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame) {
        let argument: u64 in Trapping = parser.type_result;
        push_type_argument(parser, input, argument);
        transition parser.output.accepted {
            true -> argument_separator(parser, input, frame),
            _ -> done()
        }
    }

    machine argument_separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame) {
        let comma: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        transition comma {
            true -> next_argument(parser, input),
            _ -> arguments_end(parser, input, frame)
        }
    }

    machine next_argument(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> operand(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedStaticArgument) }
    }

    machine arguments_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Greater,
            |syntax_trees|::ParseDiagnosticCode::ExpectedStaticArgumentEnd
        );
        let token_end: u64 in Trapping = parser.token_end;
        transition parser.output.accepted {
            true -> applied(parser, input, frame, token_end),
            _ -> done()
        }
    }

    machine applied(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, end: u64 in Trapping) {
        pop_type_frame(parser);
        commit_type_arguments(parser, input, frame.first_argument);
        transition parser.output.accepted {
            true -> applied_lifetimes(parser, input, frame, end),
            _ -> done()
        }
    }

    machine applied_lifetimes(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, end: u64 in Trapping) {
        commit_type_lifetimes(parser, input, frame.first_lifetime);
        transition parser.output.accepted {
            true -> applied_row(parser, input, frame, end),
            _ -> done()
        }
    }

    machine applied_row(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, frame: TypeFrame, end: u64 in Trapping) {
        let row: |syntax_trees|::TypeReference = type_row(parser, |syntax_trees|::TypeReferenceKind::Named,
            frame.start, end, frame.start, frame.name_end);
        let applied: |syntax_trees|::TypeReference = with_children(row, frame.first_row, 0 as +Trapping, 0 as +Trapping);
        let argued: |syntax_trees|::TypeReference = with_arguments(applied, parser.committed_type_first, parser.committed_type_count);
        let tagged: |syntax_trees|::TypeReference = with_lifetimes(argued, parser.committed_lifetime_first, parser.committed_lifetime_count);
        transition { _ -> domain(parser, input, tagged) }
    }

    machine reject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::reject_current(parser, input, code);
    }

    machine done() {}
}

machine type_frame(
    parser: @|parser|::Parser,
    kind: TypeFrameKind,
    access: |syntax_trees|::ReferenceAccess,
    start: u64 in Trapping
) -> TypeFrame {
    TypeFrame {
        kind: kind,
        access: access,
        start: start,
        name_end: start,
        first_argument: parser.pending_type_argument_count as +Trapping,
        first_row: parser.output.type_reference_count as +Trapping,
        has_lifetime: false,
        lifetime: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
        first_lifetime: parser.pending_type_lifetime_count as +Trapping
    }
}

machine named_frame(frame: TypeFrame, name_end: u64 in Trapping) -> TypeFrame {
    TypeFrame {
        kind: frame.kind,
        access: frame.access,
        start: frame.start,
        name_end: name_end,
        first_argument: frame.first_argument,
        first_row: frame.first_row,
        has_lifetime: frame.has_lifetime,
        lifetime: frame.lifetime,
        first_lifetime: frame.first_lifetime
    }
}

machine lifetime_frame(frame: TypeFrame, has_lifetime: bool, lifetime: |syntax_trees|::IdentifierSpan) -> TypeFrame {
    TypeFrame {
        kind: frame.kind,
        access: frame.access,
        start: frame.start,
        name_end: frame.name_end,
        first_argument: frame.first_argument,
        first_row: frame.first_row,
        has_lifetime: has_lifetime,
        lifetime: lifetime,
        first_lifetime: frame.first_lifetime
    }
}

machine frame_access(frame: TypeFrame, access: |syntax_trees|::ReferenceAccess) -> TypeFrame {
    TypeFrame {
        kind: frame.kind,
        access: access,
        start: frame.start,
        name_end: frame.name_end,
        first_argument: frame.first_argument,
        first_row: frame.first_row,
        has_lifetime: frame.has_lifetime,
        lifetime: frame.lifetime,
        first_lifetime: frame.first_lifetime
    }
}

// A childless row spanning `start..end` and named `name_start..name_end`,
// which begins its own run at the next row. The `with_` constructors below
// add what each composite form carries.
machine type_row(
    parser: @|parser|::Parser,
    kind: |syntax_trees|::TypeReferenceKind,
    start: u64 in Trapping,
    end: u64 in Trapping,
    name_start: u64 in Trapping,
    name_end: u64 in Trapping
) -> |syntax_trees|::TypeReference {
    |syntax_trees|::TypeReference {
        kind: kind,
        name: |parser|::identifier_span(parser, name_start, name_end),
        has_domain: false,
        domain: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
        has_domain_owner: false,
        domain_owner: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
        access: |syntax_trees|::ReferenceAccess::Shared,
        inner: 0 as +Trapping,
        length: 0 as +Trapping,
        first_argument: 0 as +Trapping,
        argument_count: 0 as +Trapping,
        has_lifetime: false,
        lifetime: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
        first_lifetime: 0 as +Trapping,
        lifetime_count: 0 as +Trapping,
        literal: 0 as +Trapping,
        first_row: parser.output.type_reference_count as +Trapping,
        source_span: |parser|::parser_source_span(parser, start, end)
    }
}

machine with_children(
    row: |syntax_trees|::TypeReference,
    first_row: u64 in Trapping,
    inner: u64 in Trapping,
    length: u64 in Trapping
) -> |syntax_trees|::TypeReference {
    |syntax_trees|::TypeReference {
        kind: row.kind,
        name: row.name,
        has_domain: row.has_domain,
        domain: row.domain,
        has_domain_owner: row.has_domain_owner,
        domain_owner: row.domain_owner,
        access: row.access,
        inner: inner,
        length: length,
        first_argument: row.first_argument,
        argument_count: row.argument_count,
        has_lifetime: row.has_lifetime,
        lifetime: row.lifetime,
        first_lifetime: row.first_lifetime,
        lifetime_count: row.lifetime_count,
        literal: row.literal,
        first_row: first_row,
        source_span: row.source_span
    }
}

machine with_access(row: |syntax_trees|::TypeReference, access: |syntax_trees|::ReferenceAccess) -> |syntax_trees|::TypeReference {
    |syntax_trees|::TypeReference {
        kind: row.kind,
        name: row.name,
