machine with_domain(
    row: |syntax_trees|::TypeReference,
    has_owner: bool,
    owner: |syntax_trees|::IdentifierSpan,
    domain: |syntax_trees|::IdentifierSpan,
    source_span: |source|::SourceSpan
) -> |syntax_trees|::TypeReference {
    |syntax_trees|::TypeReference {
        kind: row.kind,
        name: row.name,
        has_domain: true,
        domain: domain,
        has_domain_owner: has_owner,
        domain_owner: owner,
        access: row.access,
        inner: row.inner,
        length: row.length,
        first_argument: row.first_argument,
        argument_count: row.argument_count,
        has_lifetime: row.has_lifetime,
        lifetime: row.lifetime,
        first_lifetime: row.first_lifetime,
        lifetime_count: row.lifetime_count,
        literal: row.literal,
        first_row: row.first_row,
        source_span: source_span
    }
}

machine top_type_frame(parser: @|parser|::Parser) -> TypeFrame
crashes Trap
{
    transition parser.type_frame_depth > 0 {
        true -> element(parser, parser.type_frame_depth - 1),
        _ -> invalid()
    }

    machine element(parser: @|parser|::Parser, top: u64) -> TypeFrame
    requires top <= 15
    {
        parser.type_frames[top]
    }

    machine invalid() -> TypeFrame {
        crash Trap;
    }
}

machine pop_type_frame(parser: @mutable |parser|::Parser)
crashes Trap
{
    transition parser.type_frame_depth > 0 {
        true -> pop(parser),
        _ -> invalid()
    }

    machine pop(parser: @mutable |parser|::Parser) {
        parser.type_frame_depth = parser.type_frame_depth - 1;
    }

    machine invalid() {
        crash Trap;
    }
}

// Whether the innermost open frame is a static argument list, where an
// integer is an argument rather than a type error.
machine in_type_arguments(parser: @|parser|::Parser) -> bool
crashes Trap
{
    transition parser.type_frame_depth > 0 {
        true -> innermost(parser),
        _ -> outside()
    }

    machine innermost(parser: @|parser|::Parser) -> bool {
        let frame: TypeFrame = top_type_frame(parser);
        transition frame.kind {
            TypeFrameKind::Arguments -> inside(),
            _ -> outside()
        }
    }

    machine inside() -> bool {
        true
    }

    machine outside() -> bool {
        false
    }
}

// Stage one completed argument until its list closes.
machine push_type_argument(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, argument: u64 in Trapping)
crashes Trap
{
    transition parser.pending_type_argument_count < 32 {
        true -> stage(parser, argument),
        _ -> full(parser, input)
    }

    machine stage(parser: @mutable |parser|::Parser, argument: u64 in Trapping) {
        parser.pending_type_arguments[parser.pending_type_argument_count] = argument;
        parser.pending_type_argument_count = parser.pending_type_argument_count + 1;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::TypeArgumentCapacityExceeded);
    }
}

// Move the innermost list's staged arguments, from `base` up, into
// `SyntaxTrees::type_arguments`; their range lands in
// `committed_type_first`/`committed_type_count`.
machine commit_type_arguments(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping)
crashes Trap
{
    parser.committed_type_first = parser.output.type_argument_count as +Trapping;
    parser.committed_type_count = (parser.pending_type_argument_count as +Trapping) - base;
    transition { _ -> next(parser, input, base, base) }

    machine next(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping) {
        transition cursor < parser.pending_type_argument_count && cursor < 32 {
            true -> capacity(parser, input, base, cursor),
            _ -> close(parser, base)
        }
    }

    machine capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 32
    {
        transition parser.output.type_argument_count < 1024 {
            true -> copy(parser, input, base, cursor),
            _ -> full(parser, input)
        }
    }

    machine copy(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 32, parser.output.type_argument_count < 1024
    {
        parser.output.type_arguments[parser.output.type_argument_count] = parser.pending_type_arguments[cursor as -Trapping];
        parser.output.type_argument_count = parser.output.type_argument_count + 1;
        transition { _ -> next(parser, input, base, cursor + 1) }
    }

    machine close(parser: @mutable |parser|::Parser, base: u64 in Trapping) {
        let restored: u64 = base as u64;
        transition restored <= 32 {
            true -> truncate(parser, restored),
            _ -> invalid()
        }
    }

    machine truncate(parser: @mutable |parser|::Parser, base: u64)
    requires base <= 32
    {
        parser.pending_type_argument_count = base;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::TypeArgumentCapacityExceeded);
    }

    machine invalid() {
        crash Trap;
    }
}

// `<argument {, argument}>`, a static argument list, entered at `<`. Each
// argument is a type, or an integer static value, staged on the type
// argument stack until `>` commits the list to `type_arguments`; its range
// lands in `committed_type_first`/`committed_type_count`.
public machine parse_static_arguments(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream)
crashes Trap
{
    let base: u64 in Trapping = parser.pending_type_argument_count as +Trapping;
    let lifetime_base: u64 in Trapping = parser.pending_type_lifetime_count as +Trapping;
    |input|::take_current(parser, input);
    transition { _ -> argument(parser, input, base, lifetime_base) }

    machine argument(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        parse_static_argument(parser, input);
        transition parser.output.accepted {
            true -> staged(parser, input, base, lifetime_base),
            _ -> done()
        }
    }

    // A lifetime argument of an invocation names a region the call binds
    // afresh; it leaves no row and the list keeps only its types.
    machine staged(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        transition parser.type_lifetime_argument {
            true -> separated(parser, input, base, lifetime_base),
            _ -> typed(parser, input, base, lifetime_base)
        }
    }

    machine typed(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        let argument: u64 in Trapping = parser.type_result;
        push_type_argument(parser, input, argument);
        transition parser.output.accepted {
            true -> separated(parser, input, base, lifetime_base),
            _ -> done()
        }
    }

    machine separated(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        let has_comma: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        transition has_comma {
            true -> comma(parser, input, base, lifetime_base),
            _ -> close(parser, input, base, lifetime_base)
        }
    }

    machine comma(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        |input|::take_current(parser, input);
        transition { _ -> argument(parser, input, base, lifetime_base) }
    }

    machine close(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        transition parser.output.accepted {
            true -> greater(parser, input, base, lifetime_base),
            _ -> done()
        }
    }

    machine greater(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Greater,
            |syntax_trees|::ParseDiagnosticCode::ExpectedStaticArgumentEnd
        );
        transition parser.output.accepted {
            true -> commit(parser, input, base, lifetime_base),
            _ -> done()
        }
    }

    machine commit(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, lifetime_base: u64 in Trapping) {
        commit_type_arguments(parser, input, base);
        drop_type_lifetimes(parser, lifetime_base);
    }

    machine done() {}
}

// One static argument: a type, or at its root an integer static value
// (`AtMost<8>`, `Build::f<8>(x)`). Rows and diagnostics are the type
// grammar's.
public machine parse_static_argument(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream)
crashes Trap
{
    parser.type_static_argument = true;
    parser.type_lifetime_argument = false;
    parse_type_reference(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedStaticArgument);
    parser.type_static_argument = false;
}

// Forget the lifetimes staged from `base` up: an invocation's are not kept.
machine drop_type_lifetimes(parser: @mutable |parser|::Parser, base: u64 in Trapping)
crashes Trap
{
    let restored: u64 = base as u64;
    transition restored <= 32 {
        true -> truncate(parser, restored),
        _ -> invalid()
    }

    machine truncate(parser: @mutable |parser|::Parser, base: u64)
    requires base <= 32
    {
        parser.pending_type_lifetime_count = base;
    }

    machine invalid() {
        crash Trap;
    }
}

machine with_lifetime(row: |syntax_trees|::TypeReference, has_lifetime: bool, lifetime: |syntax_trees|::IdentifierSpan) -> |syntax_trees|::TypeReference {
    |syntax_trees|::TypeReference {
        kind: row.kind,
        name: row.name,
        has_domain: row.has_domain,
        domain: row.domain,
        has_domain_owner: row.has_domain_owner,
        domain_owner: row.domain_owner,
        access: row.access,
        inner: row.inner,
        length: row.length,
        first_argument: row.first_argument,
        argument_count: row.argument_count,
        has_lifetime: has_lifetime,
        lifetime: lifetime,
        first_lifetime: row.first_lifetime,
        lifetime_count: row.lifetime_count,
        literal: row.literal,
        first_row: row.first_row,
        source_span: row.source_span
    }
}

machine with_lifetimes(row: |syntax_trees|::TypeReference, first_lifetime: u64 in Trapping, lifetime_count: u64 in Trapping) -> |syntax_trees|::TypeReference {
    |syntax_trees|::TypeReference {
        kind: row.kind,
        name: row.name,
        has_domain: row.has_domain,
        domain: row.domain,
        has_domain_owner: row.has_domain_owner,
        domain_owner: row.domain_owner,
        access: row.access,
        inner: row.inner,
        length: row.length,
        first_argument: row.first_argument,
        argument_count: row.argument_count,
        has_lifetime: row.has_lifetime,
        lifetime: row.lifetime,
        first_lifetime: first_lifetime,
        lifetime_count: lifetime_count,
        literal: row.literal,
        first_row: row.first_row,
        source_span: row.source_span
    }
}

// Stage one lifetime argument until its list closes.
machine push_type_lifetime(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, tag: |syntax_trees|::IdentifierSpan)
crashes Trap
{
    transition parser.pending_type_lifetime_count < 32 {
        true -> stage(parser, tag),
        _ -> full(parser, input)
    }

    machine stage(parser: @mutable |parser|::Parser, tag: |syntax_trees|::IdentifierSpan) {
        parser.pending_type_lifetimes[parser.pending_type_lifetime_count] = tag;
        parser.pending_type_lifetime_count = parser.pending_type_lifetime_count + 1;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::TypeArgumentCapacityExceeded);
    }
}

// Move the innermost list's staged lifetimes, from `base` up, into
// `SyntaxTrees::type_lifetimes`; their range lands in
// `committed_lifetime_first`/`committed_lifetime_count`.
machine commit_type_lifetimes(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping)
crashes Trap
{
    parser.committed_lifetime_first = parser.output.type_lifetime_count as +Trapping;
    parser.committed_lifetime_count = (parser.pending_type_lifetime_count as +Trapping) - base;
    transition { _ -> next(parser, input, base, base) }

    machine next(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping) {
        transition cursor < parser.pending_type_lifetime_count && cursor < 32 {
            true -> capacity(parser, input, base, cursor),
            _ -> close(parser, base)
        }
    }

    machine capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 32
    {
        transition parser.output.type_lifetime_count < 1024 {
            true -> copy(parser, input, base, cursor),
            _ -> full(parser, input)
        }
    }

    machine copy(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, base: u64 in Trapping, cursor: u64 in Trapping)
    requires cursor < 32, parser.output.type_lifetime_count < 1024
    {
        let tag: |syntax_trees|::IdentifierSpan = parser.pending_type_lifetimes[cursor as -Trapping];
        parser.output.type_lifetimes[parser.output.type_lifetime_count] = tag;
        parser.output.type_lifetime_count = parser.output.type_lifetime_count + 1;
        transition { _ -> next(parser, input, base, cursor + 1) }
    }

    machine close(parser: @mutable |parser|::Parser, base: u64 in Trapping) {
        let restored: u64 = base as u64;
        transition restored <= 32 {
            true -> truncate(parser, restored),
            _ -> invalid()
        }
    }

    machine truncate(parser: @mutable |parser|::Parser, base: u64)
    requires base <= 32
    {
        parser.pending_type_lifetime_count = base;
    }

    machine full(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::reject_current(parser, input, |syntax_trees|::ParseDiagnosticCode::TypeArgumentCapacityExceeded);
    }

    machine invalid() {
        crash Trap;
    }
}
