use pipeline/tokens_to_syntax_trees/clause.omg;
use pipeline/tokens_to_syntax_trees/generics.omg;
use pipeline/tokens_to_syntax_trees/input.omg;
use pipeline/tokens_to_syntax_trees/path.omg;
use pipeline/tokens_to_syntax_trees/types.omg;
use pipeline/tokens_to_syntax_trees/parser.omg;

use representations/source_files/source.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/tokens/tokens.omg;

// `[public] domain [<generic parameters>] Carrier::Name [<index arguments>]
// tail`, entered at the `domain` word. Predicates name `self`; an authored
// subject binder is rejected. The carrier is a name or
// a bracketed array or slice type, retained as a type reference; the index
// arguments share the static argument grammar. The tail is a transparent
// alias `= Path {& Path};`, or `[requires facts] [established by Path {,
// Path}]` closed by `;`. Domain bodies, including empty braces, are retired.
// The item and its root are
// retained at its last token.
public machine parse_domain(
    parser: @mutable |parser|::Parser,
    input: @|tokens|::TokenStream,
    item_start: u64 in Trapping,
    is_public: bool
)
crashes Trap
{
    parser.declaration_start = item_start;
    parser.declaration_is_public = is_public;
    transition parser.output.domain_count < 256 {
        true -> keyword(parser, input),
        _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::DomainCapacityExceeded)
    }

    machine keyword(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        parser.declaration_first_generic = parser.output.generic_parameter_count as +Trapping;
        parser.declaration_first_argument = parser.output.type_argument_count as +Trapping;
        parser.declaration_argument_count = 0 as +Trapping;
        parser.declaration_has_subject = false;
        parser.declaration_subject_start = 0 as +Trapping;
        parser.declaration_subject_end = 0 as +Trapping;
        let generic: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Less);
        transition generic {
            true -> generics(parser, input),
            _ -> carrier_form(parser, input)
        }
    }

    machine generics(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |generics|::parse_generic_parameters(parser, input);
        transition parser.output.accepted {
            true -> carrier_form(parser, input),
            _ -> done()
        }
    }

    // A bracketed carrier is a whole type; a named one is its name alone,
    // since the `::` after it begins the domain's own name.
    machine carrier_form(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let bracketed: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftBracket);
        transition bracketed {
            true -> bracketed_carrier(parser, input),
            _ -> named_carrier(parser, input)
        }
    }

    machine bracketed_carrier(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |types|::parse_type_reference(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedDomainCarrier);
        let type_result: u64 in Trapping = parser.type_result;
        transition parser.output.accepted {
            true -> separator(parser, input, type_result),
            _ -> done()
        }
    }

    machine named_carrier(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedDomainCarrier);
        transition parser.output.accepted {
            true -> carrier_capacity(parser, input),
            _ -> done()
        }
    }

    machine carrier_capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        transition parser.output.type_reference_count < 65536 {
            true -> carrier_row(parser, input),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::TypeReferenceCapacityExceeded)
        }
    }

    machine carrier_row(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let carrier: u64 in Trapping = parser.output.type_reference_count as +Trapping;
        let row: |syntax_trees|::TypeReference = |types|::type_row(parser,
            |syntax_trees|::TypeReferenceKind::Named, parser.name_start, parser.name_end, parser.name_start, parser.name_end);
        parser.output.type_references[parser.output.type_reference_count] = row;
        parser.output.type_reference_count = parser.output.type_reference_count + 1;
        transition { _ -> separator(parser, input, carrier) }
    }

    machine separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, carrier: u64 in Trapping) {
        parser.declaration_type = carrier;
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::ColonColon, |syntax_trees|::ParseDiagnosticCode::ExpectedDomainSeparator);
        transition parser.output.accepted {
            true -> domain_name(parser, input),
            _ -> done()
        }
    }

    machine domain_name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedDomainName);
        transition parser.output.accepted {
            true -> named(parser, input),
            _ -> done()
        }
    }

    machine named(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.declaration_name_start = parser.name_start;
        parser.declaration_name_end = parser.name_end;
        let indexed: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Less);
        transition indexed {
            true -> indices(parser, input),
            _ -> subject(parser, input)
        }
    }

    machine indices(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |types|::parse_static_arguments(parser, input, false);
        parser.declaration_first_argument = parser.committed_type_first;
        parser.declaration_argument_count = parser.committed_type_count;
        transition parser.output.accepted {
            true -> subject(parser, input),
            _ -> done()
        }
    }

    // Authored `(subject)` binders are retired. Predicates name the fixed
    // logical subject `self`.
    machine subject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let bound: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftParen);
        transition bound {
            true -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::RetiredDomainSubject),
            _ -> tail(parser, input)
        }
    }

    machine tail(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.declaration_first_path = parser.output.name_path_count as +Trapping;
        let alias: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Equal);
        transition alias {
            true -> alias_open(parser, input),
            _ -> predicates(parser, input)
        }
    }

    machine alias_open(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        parser.declaration_first_clause = parser.output.clause_count as +Trapping;
        parser.declaration_clause_count = 0 as +Trapping;
        transition { _ -> constituent(parser, input) }
    }

    machine constituent(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |path|::parse_name_path(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedDomainConstituent);
        transition parser.output.accepted {
            true -> conjunction(parser, input),
            _ -> done()
        }
    }

    machine conjunction(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let more: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Ampersand);
        transition more {
            true -> next_constituent(parser, input),
            _ -> alias_end(parser, input)
        }
    }

    machine next_constituent(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> constituent(parser, input) }
    }

    machine alias_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Semicolon, |syntax_trees|::ParseDiagnosticCode::ExpectedDomainEnd);
        transition parser.output.accepted {
            true -> retain_capacity(parser, input, true),
            _ -> done()
        }
    }

    machine predicates(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |clause|::parse_clauses(parser, input, |syntax_trees|::ClauseOwner::Domain);
        parser.declaration_first_clause = parser.clause_first;
        parser.declaration_clause_count = (parser.output.clause_count as +Trapping) - parser.clause_first;
        transition parser.output.accepted {
            true -> establishment(parser, input),
            _ -> done()
        }
    }

    machine establishment(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        parser.declaration_first_path = parser.output.name_path_count as +Trapping;
        let routed: bool = |input|::at_word(parser, input, "established");
        transition routed {
            true -> established(parser, input),
            _ -> ending(parser, input)
        }
    }

    machine established(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        let by: bool = |input|::at_word(parser, input, "by");
        transition by {
            true -> routes(parser, input),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedEstablishedBy)
        }
    }

    machine routes(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> route(parser, input) }
    }

    machine route(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |path|::parse_name_path(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedDomainRoute);
        transition parser.output.accepted {
            true -> route_separator(parser, input),
            _ -> done()
        }
    }

    machine route_separator(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let more: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        transition more {
            true -> routes(parser, input),
            _ -> ending(parser, input)
        }
    }

    machine ending(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        let semicolon: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Semicolon);
        transition semicolon {
            true -> closed(parser, input),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedDomainEnd)
        }
    }

    machine closed(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream) {
        |input|::take_current(parser, input);
        transition { _ -> retain_capacity(parser, input, false) }
    }

    machine retain_capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, is_alias: bool) {
        transition parser.output.domain_count < 256 {
            true -> root_capacity(parser, input, is_alias),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::DomainCapacityExceeded)
        }
    }

    machine root_capacity(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, is_alias: bool) {
        transition parser.output.root_count < 4096 {
            true -> retain(parser, is_alias),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::RootCapacityExceeded)
        }
    }

    // An alias's paths are its constituents and a predicate domain's its
    // routes; the other range is empty at the table's end.
    machine retain(parser: @mutable |parser|::Parser, is_alias: bool) {
        let path_end: u64 in Trapping = parser.output.name_path_count as +Trapping;
        let path_count: u64 in Trapping = path_end - parser.declaration_first_path;
        let declaration_first_path: u64 in Trapping = parser.declaration_first_path;
        transition is_alias {
            true -> retained(parser, true, path_end, 0 as +Trapping, declaration_first_path, path_count),
            _ -> retained(parser, false, declaration_first_path, path_count, path_end, 0 as +Trapping)
        }
    }

    machine retained(
        parser: @mutable |parser|::Parser,
        is_alias: bool,
        first_route: u64 in Trapping,
        route_count: u64 in Trapping,
        first_constituent: u64 in Trapping,
        constituent_count: u64 in Trapping
    ) {
        let domain: u64 in Trapping = parser.output.domain_count as +Trapping;
        let span: |source|::SourceSpan = |parser|::parser_source_span(parser, parser.declaration_start, parser.token_end);
        parser.output.domains[parser.output.domain_count] = |syntax_trees|::DomainItem {
            carrier: parser.declaration_type,
            name: |parser|::identifier_span(parser, parser.declaration_name_start, parser.declaration_name_end),
            first_argument: parser.declaration_first_argument,
            argument_count: parser.declaration_argument_count,
            first_generic_parameter: parser.declaration_first_generic,
            generic_parameter_count: (parser.output.generic_parameter_count as +Trapping) - parser.declaration_first_generic,
            has_subject: parser.declaration_has_subject,
            subject: |parser|::identifier_span(parser, parser.declaration_subject_start, parser.declaration_subject_end),
            first_clause: parser.declaration_first_clause,
            clause_count: parser.declaration_clause_count,
            first_route: first_route,
            route_count: route_count,
            is_alias: is_alias,
            first_constituent: first_constituent,
            constituent_count: constituent_count,
            is_public: parser.declaration_is_public,
            source_span: span
        };
        parser.output.domain_count = parser.output.domain_count + 1;
        parser.output.roots[parser.output.root_count] = |syntax_trees|::RootItem {
            kind: |syntax_trees|::RootItemKind::Domain,
            item_index: domain,
            source_span: span
        };
        parser.output.root_count = parser.output.root_count + 1;
    }

    machine reject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::reject_current(parser, input, code);
    }

    machine done() {}
}
