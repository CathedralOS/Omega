use pipeline/tokens_to_syntax_trees/expression.omg;
use pipeline/tokens_to_syntax_trees/input.omg;
use pipeline/tokens_to_syntax_trees/types.omg;
use pipeline/tokens_to_syntax_trees/parser.omg;

use representations/source_files/source.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/tokens/tokens.omg;

// Statement grammar for machine and state bodies: `let [mutable] name: Type
// [= value];`, `crash Trap;` or `crash Abort;`, `place = value;`, the
// intentional discard `_ = value;` (wiki/spec/language/effects.md), `value;`,
// `transition [subject] { arms }`, and a final unterminated `value` before
// the body's `}`, its result; a value-position `match` is a value like any
// other. Statements end at the body's `}` or, in a machine body, at its
// first `state` member; the caller then reads that token. Statement forms of
// later slices (`if`, `loop`, `while`, `return`) reject with the caller's
// `unsupported` diagnostic, the body end the grammar expects instead. The
// range lands in `body_first_statement` and the table count.
public machine parse_statements(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode)
crashes Trap
{
    parser.body_first_statement = parser.output.statement_count as +Trapping;
    transition { _ -> next(parser, input, unsupported) }

    machine next(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |input|::load_current(parser, input);
        transition parser.current_present {
            true -> classify(parser, input, unsupported),
            _ -> done()
        }
    }

    machine classify(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        parser.statement_start = token.start;
        transition token.kind {
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::RightBrace, .. } -> done(),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::Machine, .. } -> done(),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::Let, .. } -> let_statement(parser, input, unsupported),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::Transition, .. } -> transition_statement(parser, input, unsupported),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::If, .. } -> reject(parser, input, unsupported),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::Loop, .. } -> reject(parser, input, unsupported),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::While, .. } -> reject(parser, input, unsupported),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::Return, .. } -> reject(parser, input, unsupported),
            |tokens|::TokenKind::Identifier -> word(parser, input, unsupported),
            _ -> expression_statement(parser, input, unsupported)
        }
    }

    // `crash` is a contextual word: it always opens a crash statement. `_`
    // before `=` opens an intentional discard.
    machine word(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        let crash: bool = |input|::at_word(parser, input, "crash");
        let underscore: bool = |input|::at_word(parser, input, "_");
        let assigned: bool = |input|::next_is_punctuation(parser, input, |tokens|::PunctuationKind::Equal);
        transition crash {
            true -> crash_statement(parser, input, unsupported),
            _ -> discard_or_value(parser, input, unsupported, underscore && assigned)
        }
    }

    machine discard_or_value(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, discard: bool) {
        transition discard {
            true -> discard_statement(parser, input, unsupported),
            _ -> expression_statement(parser, input, unsupported)
        }
    }

    machine discard_statement(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |input|::take_current(parser, input);
        |input|::take_current(parser, input);
        |expression|::parse_expression(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedAssignmentValue, true, true);
        let expression_result: u64 in Trapping = parser.expression_result;
        transition parser.output.accepted {
            true -> discard_end(parser, input, unsupported, expression_result),
            _ -> done()
        }
    }

    machine discard_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, value: u64 in Trapping) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Semicolon,
            |syntax_trees|::ParseDiagnosticCode::ExpectedAssignmentSemicolon
        );
        transition parser.output.accepted {
            true -> discard_retained(parser, input, unsupported, value),
            _ -> done()
        }
    }

    machine discard_retained(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, value: u64 in Trapping) {
        let statement: |syntax_trees|::Statement = |syntax_trees|::Statement {
            kind: |syntax_trees|::StatementKind::Discard,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            is_mutable: false,
            type_reference: 0 as +Trapping,
            has_value: true,
            value: value,
            target: 0 as +Trapping,
            cause: |syntax_trees|::CrashCause::Trap,
            first_arm: 0 as +Trapping,
            arm_count: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    machine crash_statement(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |input|::take_current(parser, input);
        let trap: bool = |input|::at_word(parser, input, "Trap");
        transition trap {
            true -> crash_cause(parser, input, unsupported, |syntax_trees|::CrashCause::Trap),
            _ -> crash_abort(parser, input, unsupported)
        }
    }

    machine crash_abort(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        let abort: bool = |input|::at_word(parser, input, "Abort");
        transition abort {
            true -> crash_cause(parser, input, unsupported, |syntax_trees|::CrashCause::Abort),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedCrashCause)
        }
    }

    machine crash_cause(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, cause: |syntax_trees|::CrashCause) {
        |input|::take_current(parser, input);
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Semicolon, |syntax_trees|::ParseDiagnosticCode::ExpectedCrashEnd);
        transition parser.output.accepted {
            true -> crash_retained(parser, input, unsupported, cause),
            _ -> done()
        }
    }

    machine crash_retained(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, cause: |syntax_trees|::CrashCause) {
        let statement: |syntax_trees|::Statement = |syntax_trees|::Statement {
            kind: |syntax_trees|::StatementKind::Crash,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            is_mutable: false,
            type_reference: 0 as +Trapping,
            has_value: false,
            value: 0 as +Trapping,
            target: 0 as +Trapping,
            cause: cause,
            first_arm: 0 as +Trapping,
            arm_count: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    machine let_statement(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |input|::take_current(parser, input);
        let marked_mutable: bool = |input|::at_word(parser, input, "mutable");
        transition marked_mutable {
            true -> let_mut(parser, input, unsupported),
            _ -> let_name(parser, input, unsupported, false)
        }
    }

    // `mutable` marks mutability only before a name; `let mutable: T` declares a
    // local named `mutable`.
    machine let_mut(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |input|::take_current(parser, input);
        let named: bool = |input|::at_name(parser, input);
        transition named {
            true -> let_name(parser, input, unsupported, true),
            _ -> let_named_mut(parser, input, unsupported)
        }
    }

    machine let_named_mut(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        parser.local_mutable = false;
        parser.local_name_start = parser.token_start;
        parser.local_name_end = parser.token_end;
        transition { _ -> let_marker(parser, input, unsupported) }
    }

    machine let_marker(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |input|::parse_erased_marker(parser, input);
        transition parser.output.accepted {
            true -> let_colon(parser, input, unsupported),
            _ -> done()
        }
    }

    machine let_name(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, marked_mutable: bool) {
        parser.local_mutable = marked_mutable;
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedLocalDataName);
        transition parser.output.accepted {
            true -> let_named(parser, input, unsupported),
            _ -> done()
        }
    }

    machine let_named(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        parser.local_name_start = parser.name_start;
        parser.local_name_end = parser.name_end;
        transition { _ -> let_marker(parser, input, unsupported) }
    }

    machine let_colon(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Colon, |syntax_trees|::ParseDiagnosticCode::ExpectedLocalDataColon);
        transition parser.output.accepted {
            true -> let_type(parser, input, unsupported),
            _ -> done()
        }
    }

    machine let_type(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |types|::parse_type_reference(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedLocalDataType);
        transition parser.output.accepted {
            true -> let_initializer(parser, input, unsupported),
            _ -> done()
        }
    }

    machine let_initializer(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        parser.local_type = parser.type_result;
        let initialized: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Equal);
        transition initialized {
            true -> let_value(parser, input, unsupported),
            _ -> let_end(parser, input, unsupported, false, 0 as +Trapping)
        }
    }

    machine let_value(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |input|::take_current(parser, input);
        |expression|::parse_expression(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedLocalDataInitialValue, true, true);
        let expression_result: u64 in Trapping = parser.expression_result;
        transition parser.output.accepted {
            true -> let_end(parser, input, unsupported, true, expression_result),
            _ -> done()
        }
    }

    machine let_end(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_value: bool,
        value: u64 in Trapping
    ) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Semicolon, |syntax_trees|::ParseDiagnosticCode::ExpectedLocalDataEnd);
        transition parser.output.accepted {
            true -> let_retained(parser, input, unsupported, has_value, value),
            _ -> done()
        }
    }

    machine let_retained(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_value: bool,
        value: u64 in Trapping
    ) {
        let local: u64 in Trapping = parser.output.statement_count as +Trapping;
        let local_end: u64 in Trapping = parser.token_end;
        |input|::record_erased(parser, |syntax_trees|::ErasedBindingKind::Local, local, local_end);
        let statement: |syntax_trees|::Statement = |syntax_trees|::Statement {
            kind: |syntax_trees|::StatementKind::Let,
            name: |parser|::identifier_span(parser, parser.local_name_start, parser.local_name_end),
            is_mutable: parser.local_mutable,
            type_reference: parser.local_type,
            has_value: has_value,
            value: value,
            target: 0 as +Trapping,
            cause: |syntax_trees|::CrashCause::Trap,
            first_arm: 0 as +Trapping,
            arm_count: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    machine expression_statement(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |expression|::parse_expression(parser, input, unsupported, true, true);
        let expression_result: u64 in Trapping = parser.expression_result;
        transition parser.output.accepted {
            true -> after_expression(parser, input, unsupported, expression_result),
            _ -> done()
        }
    }

    machine after_expression(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, value: u64 in Trapping) {
        |input|::load_current(parser, input);
        transition parser.current_present {
            true -> statement_end(parser, input, unsupported, value),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedStatementEnd)
        }
    }

    machine statement_end(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, value: u64 in Trapping) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        transition token.kind {
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Equal, .. } -> assignment(parser, input, unsupported, value),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::Semicolon, .. } -> terminated(parser, input, unsupported, value),
            |tokens|::TokenKind::Punctuation { punctuation: |tokens|::PunctuationKind::RightBrace, .. } -> tail(parser, input, unsupported, value),
            |tokens|::TokenKind::Keyword { keyword: |tokens|::KeywordKind::Machine, .. } -> tail(parser, input, unsupported, value),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedStatementEnd)
        }
    }

    machine assignment(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, target: u64 in Trapping) {
        |input|::take_current(parser, input);
        |expression|::parse_expression(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedAssignmentValue, true, true);
        let expression_result: u64 in Trapping = parser.expression_result;
        transition parser.output.accepted {
            true -> assignment_end(parser, input, unsupported, target, expression_result),
            _ -> done()
        }
    }

    machine assignment_end(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        target: u64 in Trapping,
        value: u64 in Trapping
    ) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Semicolon,
            |syntax_trees|::ParseDiagnosticCode::ExpectedAssignmentSemicolon
        );
        transition parser.output.accepted {
            true -> assignment_retained(parser, input, unsupported, target, value),
            _ -> done()
        }
    }

    machine assignment_retained(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        target: u64 in Trapping,
        value: u64 in Trapping
    ) {
        let statement: |syntax_trees|::Statement = |syntax_trees|::Statement {
            kind: |syntax_trees|::StatementKind::Assign,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            is_mutable: false,
            type_reference: 0 as +Trapping,
            has_value: true,
            value: value,
            target: target,
            cause: |syntax_trees|::CrashCause::Trap,
            first_arm: 0 as +Trapping,
            arm_count: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    machine terminated(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, value: u64 in Trapping) {
        |input|::take_current(parser, input);
        let statement: |syntax_trees|::Statement = |syntax_trees|::Statement {
            kind: |syntax_trees|::StatementKind::Expression,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            is_mutable: false,
            type_reference: 0 as +Trapping,
            has_value: true,
            value: value,
            target: 0 as +Trapping,
            cause: |syntax_trees|::CrashCause::Trap,
            first_arm: 0 as +Trapping,
            arm_count: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    // The body's `}` stays for the caller; the tail ends at its expression.
    machine tail(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, value: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, value);
        let statement: |syntax_trees|::Statement = |syntax_trees|::Statement {
            kind: |syntax_trees|::StatementKind::Tail,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            is_mutable: false,
            type_reference: 0 as +Trapping,
            has_value: true,
            value: value,
            target: 0 as +Trapping,
            cause: |syntax_trees|::CrashCause::Trap,
            first_arm: 0 as +Trapping,
            arm_count: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, parser.statement_start, expression.source_span.span.end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    machine store(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, statement: |syntax_trees|::Statement) {
        transition parser.output.statement_count < 16384 {
            true -> store_bounded(parser, input, unsupported, statement),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::StatementCapacityExceeded)
        }
    }

    machine store_bounded(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, statement: |syntax_trees|::Statement) {
        parser.output.statements[parser.output.statement_count] = statement;
        parser.output.statement_count = parser.output.statement_count + 1;
        transition { _ -> next(parser, input, unsupported) }
    }

    // `transition { guard -> target ... }` or `transition subject { pattern
    // -> target ... }`. The subject admits no construction: its `{` opens
    // the arms.
    machine transition_statement(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |input|::take_current(parser, input);
        let open: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace);
        transition open {
            true -> arms_open(parser, input, unsupported, false, 0 as +Trapping),
            _ -> transition_subject(parser, input, unsupported)
        }
    }

    machine transition_subject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode) {
        |expression|::parse_expression(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedTransitionSubject, false, true);
        let expression_result: u64 in Trapping = parser.expression_result;
        transition parser.output.accepted {
            true -> subject_open(parser, input, unsupported, expression_result),
            _ -> done()
        }
    }

    machine subject_open(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, subject: u64 in Trapping) {
        let open: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace);
        transition open {
            true -> arms_open(parser, input, unsupported, true, subject),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedTransitionArm)
        }
    }

    machine arms_open(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        |input|::take_current(parser, input);
        parser.transition_first_arm = parser.output.arm_count as +Trapping;
        transition { _ -> arm(parser, input, unsupported, has_subject, subject) }
    }

    machine arm(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace);
        transition closing {
            true -> transition_close(parser, input, unsupported, has_subject, subject),
            _ -> arm_start(parser, input, unsupported, has_subject, subject)
        }
    }

    machine arm_start(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        |input|::load_current(parser, input);
        transition parser.current_present {
            true -> arm_pattern(parser, input, unsupported, has_subject, subject),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedTransitionArm)
        }
    }

    machine arm_pattern(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        let token: |tokens|::Token = input.tokens[parser.current_index];
        parser.arm_start = token.start;
        parser.arm_has_fields = false;
        parser.arm_has_rest = false;
        parser.arm_has_guard = false;
        parser.arm_guard = 0 as +Trapping;
        let wildcard: bool = |input|::at_word(parser, input, "_");
        transition wildcard {
            true -> wildcard_arm(parser, input, unsupported, has_subject, subject),
            _ -> arm_expression(parser, input, unsupported, has_subject, subject)
        }
    }

    machine wildcard_arm(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        |input|::take_current(parser, input);
        transition { _ -> arm_guard(parser, input, unsupported, has_subject, subject, |syntax_trees|::ArmPatternKind::Wildcard, 0 as +Trapping, 0 as +Trapping, 0 as +Trapping) }
    }

    machine arm_expression(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        |expression|::parse_expression(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedTransitionArm, false, true);
        let expression_result: u64 in Trapping = parser.expression_result;
        transition parser.output.accepted {
            true -> arm_classify(parser, input, unsupported, has_subject, subject, expression_result),
            _ -> done()
        }
    }

    // A subjectless block's arms are guards. With a subject, a bare name
    // binds while a path or literal selects a value.
    machine arm_classify(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, pattern);
        transition has_subject {
            true -> subject_pattern(parser, input, unsupported, subject, pattern, expression.kind),
            _ -> arm_guard(parser, input, unsupported, false, subject, |syntax_trees|::ArmPatternKind::Guard, pattern, 0 as +Trapping, 0 as +Trapping)
        }
    }

    machine subject_pattern(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        kind: |syntax_trees|::ExpressionKind
    ) {
        transition kind {
            |syntax_trees|::ExpressionKind::Name -> named_pattern(parser, input, unsupported, subject, pattern),
            |syntax_trees|::ExpressionKind::Path -> case_pattern(parser, input, unsupported, subject, pattern),
            _ -> arm_guard(parser, input, unsupported, true, subject, |syntax_trees|::ArmPatternKind::Literal, pattern, 0 as +Trapping, 0 as +Trapping)
        }
    }

    machine named_pattern(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, subject: u64 in Trapping, pattern: u64 in Trapping) {
        let braced: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace);
        transition braced {
            true -> case_pattern(parser, input, unsupported, subject, pattern),
            _ -> arm_guard(parser, input, unsupported, true, subject, |syntax_trees|::ArmPatternKind::Binder, pattern, 0 as +Trapping, 0 as +Trapping)
        }
    }

    machine case_pattern(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        parser.pattern_first_field = parser.output.pattern_field_count as +Trapping;
        let braced: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace);
        parser.arm_has_fields = braced;
        let pattern_first_field: u64 in Trapping = parser.pattern_first_field;
        transition braced {
            true -> pattern_fields_open(parser, input, unsupported, subject, pattern),
            _ -> arm_guard(parser, input, unsupported, true, subject, |syntax_trees|::ArmPatternKind::Case, pattern,
                pattern_first_field, 0 as +Trapping)
        }
    }

    machine pattern_fields_open(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        |input|::take_current(parser, input);
        transition { _ -> pattern_field_or_end(parser, input, unsupported, subject, pattern) }
    }

    machine pattern_field_or_end(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace);
        let rest: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::DotDot);
        transition closing {
            true -> pattern_fields_close(parser, input, unsupported, subject, pattern),
            _ -> pattern_field_or_rest(parser, input, unsupported, subject, pattern, rest)
        }
    }

    machine pattern_field_or_rest(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, subject: u64 in Trapping, pattern: u64 in Trapping, rest: bool) {
        transition rest {
            true -> pattern_rest(parser, input, unsupported, subject, pattern),
            _ -> pattern_field(parser, input, unsupported, subject, pattern)
        }
    }

    // Rest opts out of drift checking without creating a field or binder.
    // It uses the same separator path as fields, including a trailing comma.
    machine pattern_rest(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, unsupported: |syntax_trees|::ParseDiagnosticCode, subject: u64 in Trapping, pattern: u64 in Trapping) {
        parser.arm_has_rest = true;
        |input|::take_current(parser, input);
        let separator: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        transition separator {
            true -> pattern_field_separator(parser, input, unsupported, subject, pattern),
            _ -> pattern_field_end(parser, input, unsupported, subject, pattern)
        }
    }

    machine pattern_field(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedPatternField);
        transition parser.output.accepted {
            true -> pattern_field_named(parser, input, unsupported, subject, pattern),
            _ -> done()
        }
    }

    machine pattern_field_named(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        parser.pattern_field_start = parser.name_start;
        parser.pattern_field_end = parser.name_end;
        let valued: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Colon);
        let renamed: bool = |input|::at_keyword(parser, input, |tokens|::KeywordKind::As);
        let binder: |syntax_trees|::PatternField = pattern_binder(parser);
        transition valued {
            true -> pattern_field_value(parser, input, unsupported, subject, pattern),
            _ -> pattern_field_binder(parser, input, unsupported, subject, pattern, binder, renamed)
        }
    }

    // `field as name` binds the field under another name; `field as _`
    // waives it.
    machine pattern_field_binder(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        binder: |syntax_trees|::PatternField,
        renamed: bool
    ) {
        transition renamed {
            true -> pattern_field_rename(parser, input, unsupported, subject, pattern, binder),
            _ -> pattern_field_store(parser, input, unsupported, subject, pattern, binder)
        }
    }

    machine pattern_field_rename(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        binder: |syntax_trees|::PatternField
    ) {
        |input|::take_current(parser, input);
        let waived: bool = |input|::at_word(parser, input, "_");
        |input|::expect_name(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedPatternRename);
        let field: |syntax_trees|::PatternField = renamed_binder(parser, binder, waived);
        transition parser.output.accepted {
            true -> pattern_field_store(parser, input, unsupported, subject, pattern,
                field),
            _ -> done()
        }
    }

    machine pattern_field_value(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        |input|::take_current(parser, input);
        |expression|::parse_expression(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedPatternField, false, true);
        let expression_result: u64 in Trapping = parser.expression_result;
        transition parser.output.accepted {
            true -> pattern_field_valued(parser, input, unsupported, subject, pattern, expression_result),
            _ -> done()
        }
    }

    machine pattern_field_valued(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        value: u64 in Trapping
    ) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, value);
        let field: |syntax_trees|::PatternField = valued_pattern_field(parser, value, expression.source_span.span.end);
        transition { _ -> pattern_field_store(parser, input, unsupported, subject, pattern,
            field) }
    }

    machine pattern_field_store(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        field: |syntax_trees|::PatternField
    ) {
        transition parser.output.pattern_field_count < 2048 {
            true -> pattern_field_stored(parser, input, unsupported, subject, pattern, field),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::PatternFieldCapacityExceeded)
        }
    }

    machine pattern_field_stored(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping,
        field: |syntax_trees|::PatternField
    ) {
        parser.output.pattern_fields[parser.output.pattern_field_count] = field;
        parser.output.pattern_field_count = parser.output.pattern_field_count + 1;
        let separator: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::Comma);
        transition separator {
            true -> pattern_field_separator(parser, input, unsupported, subject, pattern),
            _ -> pattern_field_end(parser, input, unsupported, subject, pattern)
        }
    }

    machine pattern_field_separator(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        |input|::take_current(parser, input);
        transition { _ -> pattern_field_or_end(parser, input, unsupported, subject, pattern) }
    }

    machine pattern_field_end(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        let closing: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace);
        transition closing {
            true -> pattern_fields_close(parser, input, unsupported, subject, pattern),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedPatternFieldEnd)
        }
    }

    machine pattern_fields_close(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        subject: u64 in Trapping,
        pattern: u64 in Trapping
    ) {
        |input|::take_current(parser, input);
        let count: u64 in Trapping = (parser.output.pattern_field_count as +Trapping) - parser.pattern_first_field;
        let pattern_first_field: u64 in Trapping = parser.pattern_first_field;
        transition { _ -> arm_guard(parser, input, unsupported, true, subject, |syntax_trees|::ArmPatternKind::Case, pattern,
            pattern_first_field, count) }
    }

    // `if condition` after any pattern guards the arm: the condition is an
    // expression over the pattern's binders and the body's names, read
    // before the arrow.
    machine arm_guard(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        let guarded: bool = |input|::at_keyword(parser, input, |tokens|::KeywordKind::If);
        transition guarded {
            true -> guard_condition(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count),
            _ -> arm_arrow(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count)
        }
    }

    machine guard_condition(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        |input|::take_current(parser, input);
        |expression|::parse_expression(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedArmGuard, false, true);
        parser.arm_has_guard = true;
        parser.arm_guard = parser.expression_result;
        transition parser.output.accepted {
            true -> arm_arrow(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count),
            _ -> done()
        }
    }

    machine arm_arrow(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::Arrow, |syntax_trees|::ParseDiagnosticCode::ExpectedTransitionArrow);
        transition parser.output.accepted {
            true -> arm_target(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count),
            _ -> done()
        }
    }

    // A target is `{}`, the explicit Unit completion, or an expression: a
    // call naming a declaration or any terminal value. A value may be a
    // construction, since no arm begins with `{`.
    machine arm_target(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        let terminal: bool = |input|::at_punctuation(parser, input, |tokens|::PunctuationKind::LeftBrace);
        transition terminal {
            true -> terminal_target(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count),
            _ -> call_target(parser, input, unsupported, has_subject, subject, kind, pattern, first_field, field_count)
        }
    }

    machine terminal_target(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        |input|::take_current(parser, input);
        |input|::expect_punctuation(parser, input, |tokens|::PunctuationKind::RightBrace,
            |syntax_trees|::ParseDiagnosticCode::ExpectedTransitionTargetClose
        );
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::TransitionArm {
            has_fields: parser.arm_has_fields,
            has_rest: parser.arm_has_rest,
            kind: kind,
            pattern: pattern,
            first_field: first_field,
            field_count: field_count,
            has_guard: parser.arm_has_guard,
            guard: parser.arm_guard,
            target_kind: |syntax_trees|::ArmTargetKind::Unit,
            target: 0 as +Trapping,
            source_span: |parser|::parser_source_span(parser, parser.arm_start, parser.token_end)
        };
        transition parser.output.accepted {
            true -> store_arm(parser, input, unsupported, has_subject, subject, arm),
            _ -> done()
        }
    }

    machine call_target(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping
    ) {
        |expression|::parse_expression(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedTransitionTarget, true, true);
        let expression_result: u64 in Trapping = parser.expression_result;
        transition parser.output.accepted {
            true -> call_target_shape(parser, input, unsupported, has_subject, subject, kind, pattern, first_field,
                field_count, expression_result),
            _ -> done()
        }
    }

    // A call target names a state or machine: a bare name (a state first)
    // or an owned machine path such as `Owner::step`. Every other expression
    // but an acknowledgement is a terminal value.
    machine call_target_shape(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping,
        target: u64 in Trapping
    ) {
        let call: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, target);
        let acknowledged: bool = acknowledges(call.operator);
        transition call.kind {
            |syntax_trees|::ExpressionKind::Call -> call_target_callee(parser, input, unsupported, has_subject, subject, kind, pattern,
                first_field, field_count, target, call),
            |syntax_trees|::ExpressionKind::Unary -> unary_target(parser, input, unsupported, has_subject, subject, kind,
                pattern, first_field, field_count, target, call, acknowledged),
            _ -> value_target(parser, input, unsupported, has_subject, subject, kind, pattern, first_field,
                field_count, target, call)
        }
    }

    machine unary_target(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping,
        target: u64 in Trapping,
        unary: |syntax_trees|::Expression,
        acknowledged: bool
    ) {
        transition acknowledged {
            true -> acknowledged_target(parser, input, unsupported, has_subject, subject, kind, pattern,
                first_field, field_count, target, unary),
            _ -> value_target(parser, input, unsupported, has_subject, subject, kind, pattern, first_field,
                field_count, target, unary)
        }
    }

    machine value_target(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping,
        target: u64 in Trapping,
        value: |syntax_trees|::Expression
    ) {
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::TransitionArm {
            has_fields: parser.arm_has_fields,
            has_rest: parser.arm_has_rest,
            kind: kind,
            pattern: pattern,
            first_field: first_field,
            field_count: field_count,
            has_guard: parser.arm_has_guard,
            guard: parser.arm_guard,
            target_kind: |syntax_trees|::ArmTargetKind::Value,
            target: target,
            source_span: |parser|::parser_source_span(parser, parser.arm_start, value.source_span.span.end)
        };
        transition {
            _ -> store_arm(parser, input, unsupported, has_subject, subject, arm)
        }
    }

    // A target may acknowledge its call's operational effects
    // (`-> suspend block read(source)`); the arm keeps the acknowledged node,
    // whose operand must be a call.
    machine acknowledged_target(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping,
        target: u64 in Trapping,
        acknowledgement: |syntax_trees|::Expression
    ) {
        let call: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, acknowledgement.left);
        let acknowledged: bool = acknowledges(acknowledgement.operator);
        transition acknowledged && call.kind == |syntax_trees|::ExpressionKind::Call {
            true -> call_target_callee(parser, input, unsupported, has_subject, subject, kind, pattern,
                first_field, field_count, target, call),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ExpectedTransitionTargetOpen)
        }
    }

    machine call_target_callee(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        kind: |syntax_trees|::ArmPatternKind,
        pattern: u64 in Trapping,
        first_field: u64 in Trapping,
        field_count: u64 in Trapping,
        target: u64 in Trapping,
        call: |syntax_trees|::Expression
    ) {
        let callee: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(@parser.output, call.left);
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::TransitionArm {
            has_fields: parser.arm_has_fields,
            has_rest: parser.arm_has_rest,
            kind: kind,
            pattern: pattern,
            first_field: first_field,
            field_count: field_count,
            has_guard: parser.arm_has_guard,
            guard: parser.arm_guard,
            target_kind: |syntax_trees|::ArmTargetKind::Call,
            target: target,
            source_span: |parser|::parser_source_span(parser, parser.arm_start, call.source_span.span.end)
        };
        let named: bool = |expression|::names_declaration(callee.kind);
        transition named {
            true -> store_arm(parser, input, unsupported, has_subject, subject, arm),
            _ -> reject_at(parser, |syntax_trees|::ParseDiagnosticCode::ExpectedTransitionTarget, callee.source_span)
        }
    }

    machine store_arm(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        arm: |syntax_trees|::TransitionArm
    ) {
        transition parser.output.arm_count < 8192 {
            true -> arm_stored(parser, input, unsupported, has_subject, subject, arm),
            _ -> reject(parser, input, |syntax_trees|::ParseDiagnosticCode::ArmCapacityExceeded)
        }
    }

    machine arm_stored(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping,
        current_arm: |syntax_trees|::TransitionArm
    ) {
        parser.output.arms[parser.output.arm_count] = current_arm;
        parser.output.arm_count = parser.output.arm_count + 1;
        transition { _ -> arm(parser, input, unsupported, has_subject, subject) }
    }

    machine transition_close(
        parser: @mutable |parser|::Parser,
        input: @|tokens|::TokenStream,
        unsupported: |syntax_trees|::ParseDiagnosticCode,
        has_subject: bool,
        subject: u64 in Trapping
    ) {
        |input|::take_current(parser, input);
        let statement: |syntax_trees|::Statement = |syntax_trees|::Statement {
            kind: |syntax_trees|::StatementKind::Transition,
            name: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
            is_mutable: false,
            type_reference: 0 as +Trapping,
            has_value: has_subject,
            value: subject,
            target: 0 as +Trapping,
            cause: |syntax_trees|::CrashCause::Trap,
            first_arm: parser.transition_first_arm,
            arm_count: (parser.output.arm_count as +Trapping) - parser.transition_first_arm,
            source_span: |parser|::parser_source_span(parser, parser.statement_start, parser.token_end)
        };
        transition { _ -> store(parser, input, unsupported, statement) }
    }

    machine reject_at(parser: @mutable |parser|::Parser, code: |syntax_trees|::ParseDiagnosticCode, source_span: |source|::SourceSpan) {
        |syntax_trees|::syntax_trees_reject(@mutable parser.output, code, source_span.source, source_span.span.start, source_span.span.end);
    }

    machine reject(parser: @mutable |parser|::Parser, input: @|tokens|::TokenStream, code: |syntax_trees|::ParseDiagnosticCode) {
        |input|::reject_current(parser, input, code);
    }

    machine done() {}
}

// Whether `operator` is a call acknowledgement prefix.
machine acknowledges(operator: |syntax_trees|::OperatorKind) -> bool {
    transition operator {
        |syntax_trees|::OperatorKind::Suspend -> acknowledgement(),
        |syntax_trees|::OperatorKind::Block -> acknowledgement(),
        |syntax_trees|::OperatorKind::SuspendBlock -> acknowledgement(),
        _ -> other()
    }

    machine acknowledgement() -> bool {
        true
    }

    machine other() -> bool {
        false
    }
}

// A pattern field binding its own name, spanning the name.
machine pattern_binder(parser: @|parser|::Parser) -> |syntax_trees|::PatternField {
    |syntax_trees|::PatternField {
        name: |parser|::identifier_span(parser, parser.pattern_field_start, parser.pattern_field_end),
        has_value: false,
        value: 0 as +Trapping,
        has_rename: false,
        rename: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
        is_waived: false,
        source_span: |parser|::parser_source_span(parser, parser.pattern_field_start, parser.pattern_field_end)
    }
}

// The binder renamed by the last name step, through that name; `_` waives it.
machine renamed_binder(parser: @|parser|::Parser, binder: |syntax_trees|::PatternField, waived: bool) -> |syntax_trees|::PatternField {
    |syntax_trees|::PatternField {
        name: binder.name,
        has_value: false,
        value: 0 as +Trapping,
        has_rename: true,
        rename: |parser|::identifier_span(parser, parser.name_start, parser.name_end),
        is_waived: waived,
        source_span: |parser|::parser_source_span(parser, parser.pattern_field_start, parser.name_end)
    }
}

// A pattern field compared with `value`, through `end`.
machine valued_pattern_field(parser: @|parser|::Parser, value: u64 in Trapping, end: u64 in Trapping) -> |syntax_trees|::PatternField {
    |syntax_trees|::PatternField {
        name: |parser|::identifier_span(parser, parser.pattern_field_start, parser.pattern_field_end),
        has_value: true,
        value: value,
        has_rename: false,
        rename: |parser|::identifier_span(parser, 0 as +Trapping, 0 as +Trapping),
        is_waived: false,
        source_span: |parser|::parser_source_span(parser, parser.pattern_field_start, end)
    }
}
