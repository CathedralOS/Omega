use pipeline/source_files_to_tokens/digits.omg;
use representations/source_files/source.omg;
use representations/tokens/numeric.omg;
use representations/tokens/tokens.omg;

// Source-to-token spelling phase for the first product-source live slice.
// Chapter 1's LEXICAL-PROFILE-V1 is authoritative: ASCII identifiers,
// space/tab/CR/LF whitespace, byte-preserving cooked literals, and no raw
// strings or codepoint escapes. Whitespace and comments separate tokens and
// are checked (an unterminated block comment rejects) but are not stored:
// no consumer reads them, and the stream holds only what the parser reads.

public data Lexer {
    source: |source|::SourceUnit;
    output: |tokens|::TokenStream;

    cursor: u64 in Trapping;
    token_start: u64 in Trapping;
    token_end: u64 in Trapping;
    decoded_start: u64 in Trapping;
    // The value of the integer literal under way, accumulated as its digits
    // are consumed, and whether it still fits in 64 bits.
    literal_magnitude: u64 in Wrapping;
    literal_exact: bool;
}

// One decoded Unicode scalar and its encoded width in bytes. A failed decode
// is `valid: false` with scalar 0 and width 0.
data DecodedScalar [copy] {
    scalar: u32 in Trapping;
    width: u64 in Trapping;
    valid: bool;
}

public machine lexer_initialize(lexer: @mutable Lexer, source_id: u32 in Trapping) {
    |source|::source_unit_clear(@mutable lexer.source, |source|::SourceId { value: source_id });
    |tokens|::token_stream_clear(@mutable lexer.output, |source|::SourceId { value: source_id });
    lexer.cursor = 0 as +Trapping;
    lexer.literal_magnitude = 0 as +Wrapping;
    lexer.literal_exact = true;
}

public machine append_source_byte(lexer: @mutable Lexer, byte: u8) {
    |source|::source_unit_append(@mutable lexer.source, byte);
}

public machine lexer_reject(
    lexer: @mutable Lexer,
    code: |tokens|::LexDiagnosticCode,
    start: u64 in Trapping,
    end: u64 in Trapping
) {
    |tokens|::token_stream_reject(@mutable lexer.output, lexer.source.id, code, start, end);
}

// Decode one Unicode scalar at an exact byte coordinate. The source buffer is
// not assumed valid before this operation; overlong forms, surrogates, and
// values beyond U+10FFFF all fail.
machine decode_scalar(source: @|source|::SourceUnit, index: u64 in Trapping) -> DecodedScalar {
    transition index < source.length {
        true -> first(source, index),
        _ -> invalid()
    }

    machine first(source: @|source|::SourceUnit, index: u64 in Trapping) -> DecodedScalar {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(source, index);
        let byte0: u32 in Trapping = (source_byte as u32) as +Trapping;
        transition byte0 < 128 {
            true -> ascii(byte0),
            _ -> two_lead(source, index, byte0)
        }
    }

    machine ascii(byte0: u32 in Trapping) -> DecodedScalar {
        DecodedScalar { scalar: byte0, width: 1 as +Trapping, valid: true }
    }

    machine two_lead(source: @|source|::SourceUnit, index: u64 in Trapping, byte0: u32 in Trapping) -> DecodedScalar {
        transition byte0 >= 194 && byte0 <= 223 {
            true -> two_bound(source, index, byte0),
            _ -> three_lead(source, index, byte0)
        }
    }

    machine two_bound(source: @|source|::SourceUnit, index: u64 in Trapping, byte0: u32 in Trapping) -> DecodedScalar {
        let index1: u64 in Trapping = index + 1;
        transition index1 < source.length {
            true -> two_tail(source, index1, byte0),
            _ -> invalid()
        }
    }

    machine two_tail(source: @|source|::SourceUnit, index1: u64 in Trapping, byte0: u32 in Trapping) -> DecodedScalar {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(source, index1);
        let byte1: u32 in Trapping = (source_byte as u32) as +Trapping;
        transition byte1 >= 128 && byte1 <= 191 {
            true -> two_value(byte0, byte1),
            _ -> invalid()
        }
    }

    machine two_value(byte0: u32 in Trapping, byte1: u32 in Trapping) -> DecodedScalar {
        let scalar: u32 in Trapping = (byte0 - 192) * 64 + (byte1 - 128);
        DecodedScalar { scalar: scalar, width: 2 as +Trapping, valid: true }
    }

    machine three_lead(source: @|source|::SourceUnit, index: u64 in Trapping, byte0: u32 in Trapping) -> DecodedScalar {
        transition byte0 >= 224 && byte0 <= 239 {
            true -> three_bound(source, index, byte0),
            _ -> four_lead(source, index, byte0)
        }
    }

    machine three_bound(source: @|source|::SourceUnit, index: u64 in Trapping, byte0: u32 in Trapping) -> DecodedScalar {
        let index1: u64 in Trapping = index + 1;
        let index2: u64 in Trapping = index + 2;
        transition index2 < source.length {
            true -> three_bytes(source, index1, index2, byte0),
            _ -> invalid()
        }
    }

    machine three_bytes(
        source: @|source|::SourceUnit,
        index1: u64 in Trapping,
        index2: u64 in Trapping,
        byte0: u32 in Trapping
    ) -> DecodedScalar {
        let first_tail: u8 = |source|::source_unit_byte_or_nul(source, index1);
        let second_tail: u8 = |source|::source_unit_byte_or_nul(source, index2);
        let byte1: u32 in Trapping = (first_tail as u32) as +Trapping;
        let byte2: u32 in Trapping = (second_tail as u32) as +Trapping;
        transition byte2 >= 128 && byte2 <= 191 {
            true -> three_second(byte0, byte1, byte2),
            _ -> invalid()
        }
    }

    machine three_second(byte0: u32 in Trapping, byte1: u32 in Trapping, byte2: u32 in Trapping) -> DecodedScalar {
        transition byte0 == 224 {
            true -> three_e0(byte0, byte1, byte2),
            _ -> three_ed_check(byte0, byte1, byte2)
        }
    }

    machine three_e0(byte0: u32 in Trapping, byte1: u32 in Trapping, byte2: u32 in Trapping) -> DecodedScalar {
        transition byte1 >= 160 && byte1 <= 191 {
            true -> three_value(byte0, byte1, byte2),
            _ -> invalid()
        }
    }

    machine three_ed_check(byte0: u32 in Trapping, byte1: u32 in Trapping, byte2: u32 in Trapping) -> DecodedScalar {
        transition byte0 == 237 {
            true -> three_ed(byte0, byte1, byte2),
            _ -> three_regular(byte0, byte1, byte2)
        }
    }

    machine three_ed(byte0: u32 in Trapping, byte1: u32 in Trapping, byte2: u32 in Trapping) -> DecodedScalar {
        transition byte1 >= 128 && byte1 <= 159 {
            true -> three_value(byte0, byte1, byte2),
            _ -> invalid()
        }
    }

    machine three_regular(byte0: u32 in Trapping, byte1: u32 in Trapping, byte2: u32 in Trapping) -> DecodedScalar {
        transition byte1 >= 128 && byte1 <= 191 {
            true -> three_value(byte0, byte1, byte2),
            _ -> invalid()
        }
    }

    machine three_value(byte0: u32 in Trapping, byte1: u32 in Trapping, byte2: u32 in Trapping) -> DecodedScalar {
        let scalar: u32 in Trapping = (byte0 - 224) * 4096
            + (byte1 - 128) * 64
            + (byte2 - 128);
        DecodedScalar { scalar: scalar, width: 3 as +Trapping, valid: true }
    }

    machine four_lead(source: @|source|::SourceUnit, index: u64 in Trapping, byte0: u32 in Trapping) -> DecodedScalar {
        transition byte0 >= 240 && byte0 <= 244 {
            true -> four_bound(source, index, byte0),
            _ -> invalid()
        }
    }

    machine four_bound(source: @|source|::SourceUnit, index: u64 in Trapping, byte0: u32 in Trapping) -> DecodedScalar {
        let index1: u64 in Trapping = index + 1;
        let index2: u64 in Trapping = index + 2;
        let index3: u64 in Trapping = index + 3;
        transition index3 < source.length {
            true -> four_bytes(source, index1, index2, index3, byte0),
            _ -> invalid()
        }
    }

    machine four_bytes(
        source: @|source|::SourceUnit,
        index1: u64 in Trapping,
        index2: u64 in Trapping,
        index3: u64 in Trapping,
        byte0: u32 in Trapping
    ) -> DecodedScalar {
        let first_tail: u8 = |source|::source_unit_byte_or_nul(source, index1);
        let second_tail: u8 = |source|::source_unit_byte_or_nul(source, index2);
        let third_tail: u8 = |source|::source_unit_byte_or_nul(source, index3);
        let byte1: u32 in Trapping = (first_tail as u32) as +Trapping;
        let byte2: u32 in Trapping = (second_tail as u32) as +Trapping;
        let byte3: u32 in Trapping = (third_tail as u32) as +Trapping;
        transition byte2 >= 128 && byte2 <= 191
            && byte3 >= 128 && byte3 <= 191 {
            true -> four_second(byte0, byte1, byte2, byte3),
            _ -> invalid()
        }
    }

    machine four_second(
        byte0: u32 in Trapping,
        byte1: u32 in Trapping,
        byte2: u32 in Trapping,
        byte3: u32 in Trapping
    ) -> DecodedScalar {
        transition byte0 == 240 {
            true -> four_f0(byte0, byte1, byte2, byte3),
            _ -> four_f4_check(byte0, byte1, byte2, byte3)
        }
    }

    machine four_f0(
        byte0: u32 in Trapping,
        byte1: u32 in Trapping,
        byte2: u32 in Trapping,
        byte3: u32 in Trapping
    ) -> DecodedScalar {
        transition byte1 >= 144 && byte1 <= 191 {
            true -> four_value(byte0, byte1, byte2, byte3),
            _ -> invalid()
        }
    }

    machine four_f4_check(
        byte0: u32 in Trapping,
        byte1: u32 in Trapping,
        byte2: u32 in Trapping,
        byte3: u32 in Trapping
    ) -> DecodedScalar {
        transition byte0 == 244 {
            true -> four_f4(byte0, byte1, byte2, byte3),
            _ -> four_regular(byte0, byte1, byte2, byte3)
        }
    }

    machine four_f4(
        byte0: u32 in Trapping,
        byte1: u32 in Trapping,
        byte2: u32 in Trapping,
        byte3: u32 in Trapping
    ) -> DecodedScalar {
        transition byte1 >= 128 && byte1 <= 143 {
            true -> four_value(byte0, byte1, byte2, byte3),
            _ -> invalid()
        }
    }

    machine four_regular(
        byte0: u32 in Trapping,
        byte1: u32 in Trapping,
        byte2: u32 in Trapping,
        byte3: u32 in Trapping
    ) -> DecodedScalar {
        transition byte1 >= 128 && byte1 <= 191 {
            true -> four_value(byte0, byte1, byte2, byte3),
            _ -> invalid()
        }
    }

    machine four_value(
        byte0: u32 in Trapping,
        byte1: u32 in Trapping,
        byte2: u32 in Trapping,
        byte3: u32 in Trapping
    ) -> DecodedScalar {
        let scalar: u32 in Trapping = (byte0 - 240) * 262144
            + (byte1 - 128) * 4096
            + (byte2 - 128) * 64
            + (byte3 - 128);
        DecodedScalar { scalar: scalar, width: 4 as +Trapping, valid: true }
    }

    machine invalid() -> DecodedScalar {
        DecodedScalar { scalar: 0 as +Trapping, width: 0 as +Trapping, valid: false }
    }
}

machine is_whitespace(scalar: u32 in Trapping) -> bool {
    transition scalar {
        9 -> true,
        10 -> true,
        13 -> true,
        32 -> true,
        _ -> false
    }
}

machine is_identifier_start(scalar: u32 in Trapping) -> bool {
    transition scalar == 95 {
        true -> true,
        _ -> upper(scalar)
    }
    machine upper(scalar: u32 in Trapping) -> bool { transition scalar >= 65 && scalar <= 90 { true -> true, _ -> lower(scalar) } }
    machine lower(scalar: u32 in Trapping) -> bool { transition scalar >= 97 && scalar <= 122 { true -> true, _ -> false } }
}

machine is_identifier_continue(scalar: u32 in Trapping) -> bool {
    transition scalar == 95 {
        true -> true,
        _ -> upper(scalar)
    }
    machine upper(scalar: u32 in Trapping) -> bool { transition scalar >= 65 && scalar <= 90 { true -> true, _ -> lower(scalar) } }
    machine lower(scalar: u32 in Trapping) -> bool { transition scalar >= 97 && scalar <= 122 { true -> true, _ -> digit(scalar) } }
    machine digit(scalar: u32 in Trapping) -> bool { transition scalar >= 48 && scalar <= 57 { true -> true, _ -> false } }
}

machine validate_utf8(lexer: @mutable Lexer) {
    lexer.cursor = 0 as +Trapping;
    transition { _ -> step(lexer) }

    machine step(lexer: @mutable Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode(lexer),
            _ -> complete()
        }
    }

    machine decode(lexer: @mutable Lexer) {
        let decoded: DecodedScalar = decode_scalar(@lexer.source, lexer.cursor);
        transition decoded.valid {
            true -> advance(lexer, decoded.width),
            _ -> invalid(lexer)
        }
    }

    machine advance(lexer: @mutable Lexer, width: u64 in Trapping) {
        lexer.cursor = lexer.cursor + width;
        transition { _ -> step(lexer) }
    }

    machine invalid(lexer: @mutable Lexer) {
        let start: u64 in Trapping = lexer.cursor;
        let end: u64 in Trapping = lexer.cursor + 1;
        lexer_reject(lexer, |tokens|::LexDiagnosticCode::InvalidUtf8, start, end);
    }

    machine complete() {}
}

machine push_token(lexer: @mutable Lexer, kind: |tokens|::TokenKind) {
    retain_token(lexer, kind);
}

machine retain_token(lexer: @mutable Lexer, kind: |tokens|::TokenKind) {
    let retained_decoded_start: u64 in Trapping = lexer.decoded_start;
    let retained_decoded_end: u64 in Trapping =
        lexer.output.decoded_length as +Trapping;
    let retained_decoded_length: u64 in Trapping =
        retained_decoded_end - retained_decoded_start;
    let token: |tokens|::Token = |tokens|::Token {
        kind: kind,
        source: lexer.source.id.value,
        start: lexer.token_start,
        end: lexer.token_end,
        decoded_start: retained_decoded_start,
        decoded_length: retained_decoded_length
    };
    |tokens|::token_stream_push(@mutable lexer.output, token);
    transition lexer.output.last_retained {
        true -> done(),
        _ -> full(lexer)
    }
    machine full(lexer: @mutable Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.token_end;
        lexer_reject(lexer, |tokens|::LexDiagnosticCode::TokenCapacityExceeded, start, end);
    }
    machine done() {}
}

machine lexer_push_decoded(lexer: @mutable Lexer, byte: u8) {
    |tokens|::token_stream_push_decoded(@mutable lexer.output, byte);
    transition lexer.output.last_retained {
        true -> done(),
        _ -> full(lexer)
    }
    machine full(lexer: @mutable Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.cursor;
        lexer_reject(lexer, |tokens|::LexDiagnosticCode::DecodedCapacityExceeded, start, end);
    }
    machine done() {}
}

// Whether the current token's source span spells `candidate`. The span is
// read here rather than passed: a caller that lends the lexer exclusively may
// not also read its fields as later operands.
machine token_equals(lexer: @mutable Lexer, candidate: @[u8]) -> bool {
    let start: u64 in Trapping = lexer.token_start;
    let end: u64 in Trapping = lexer.token_end;
    transition end - start == candidate.length {
        true -> scan(lexer, start, candidate, 0 as +Trapping),
        _ -> false
    }

    machine scan(lexer: @mutable Lexer, start: u64 in Trapping, candidate: @[u8], index: u64 in Trapping) -> bool {
        transition index < candidate.length {
            true -> compare(lexer, start, candidate, index),
            _ -> true
        }
    }

    machine compare(lexer: @mutable Lexer, start: u64 in Trapping, candidate: @[u8], index: u64 in Trapping) -> bool {
        let at: u64 in Trapping = start + index;
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, at);
        let candidate_byte: u8 = candidate[index as -Trapping];
        transition source_byte == candidate_byte {
            true -> scan(lexer, start, candidate, index + 1),
            _ -> false
        }
    }
}

machine classify_keyword(lexer: @mutable Lexer) {
    let matched: bool = token_equals(lexer, "as");
    transition matched { true -> yes(lexer, |tokens|::KeywordKind::As), _ -> calling_convention_kw(lexer) }
    machine calling_convention_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "calling_convention"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::CallingConvention), _ -> capability_kw(lexer) } }
    machine capability_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "capability"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Capability), _ -> contains_kw(lexer) } }
    machine contains_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "contains"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Contains), _ -> data_kw(lexer) } }
    machine data_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "data"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Data), _ -> else_kw(lexer) } }
    machine else_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "else"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Else), _ -> false_kw(lexer) } }
    machine false_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "false"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::False), _ -> foreign_kw(lexer) } }
    machine foreign_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "foreign"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Foreign), _ -> host_kw(lexer) } }
    machine host_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "host"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Host), _ -> if_kw(lexer) } }
    machine if_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "if"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::If), _ -> let_kw(lexer) } }
    machine let_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "let"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Let), _ -> library_kw(lexer) } }
    machine library_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "library"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Library), _ -> loop_kw(lexer) } }
    machine loop_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "loop"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Loop), _ -> machine_kw(lexer) } }
    machine machine_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "machine"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Machine), _ -> match_kw(lexer) } }
    machine match_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "match"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Match), _ -> owns_kw(lexer) } }
    machine owns_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "owns"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Owns), _ -> platform_kw(lexer) } }
    machine platform_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "platform"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Platform), _ -> public_kw(lexer) } }
    machine public_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "public"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Public), _ -> return_kw(lexer) } }
    machine return_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "return"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Return), _ -> self_value_kw(lexer) } }
    machine self_value_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "self"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::SelfValue), _ -> struct_kw(lexer) } }
    machine struct_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "struct"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Struct), _ -> target_kw(lexer) } }
    machine target_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "target"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Target), _ -> transition_kw(lexer) } }
    machine transition_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "transition"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Transition), _ -> true_kw(lexer) } }
    machine true_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "true"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::True), _ -> use_kw(lexer) } }
    machine use_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "use"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Use), _ -> when_kw(lexer) } }
    machine when_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "when"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::When), _ -> while_kw(lexer) } }
    machine while_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "while"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::While), _ -> case_kw(lexer) } }
    machine case_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "case"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Case), _ -> copy_kw(lexer) } }
    machine copy_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "copy"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Copy), _ -> linear_kw(lexer) } }
    machine linear_kw(lexer: @mutable Lexer) { let matched: bool = token_equals(lexer, "linear"); transition matched { true -> yes(lexer, |tokens|::KeywordKind::Linear), _ -> identifier(lexer) } }

    machine yes(lexer: @mutable Lexer, keyword: |tokens|::KeywordKind) { push_token(lexer, |tokens|::TokenKind::Keyword { keyword: keyword }); }
    machine identifier(lexer: @mutable Lexer) { push_token(lexer, |tokens|::TokenKind::Identifier); }
}

machine lex_identifier(lexer: @mutable Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as +Trapping;
    let first: DecodedScalar = decode_scalar(@lexer.source, lexer.cursor);
    lexer.cursor = lexer.cursor + first.width;
    transition { _ -> continue_scan(lexer) }

    machine continue_scan(lexer: @mutable Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode_next(lexer),
            _ -> finish(lexer)
        }
    }

    machine decode_next(lexer: @mutable Lexer) {
        let decoded: DecodedScalar = decode_scalar(@lexer.source, lexer.cursor);
        let continues: bool = is_identifier_continue(decoded.scalar);
        transition continues {
            true -> advance(lexer, decoded.width),
            _ -> finish(lexer)
        }
    }

    machine advance(lexer: @mutable Lexer, width: u64 in Trapping) {
        lexer.cursor = lexer.cursor + width;
        transition { _ -> continue_scan(lexer) }
    }

    // A word's spelling is its decoded bytes, so contextual words such as the
    // `in` of a qualified type compare against `TokenStream::decoded`.
    machine finish(lexer: @mutable Lexer) {
        lexer.token_end = lexer.cursor;
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.token_end;
        copy_source_to_decoded(lexer, start, end);
        transition lexer.output.accepted {
            true -> classify(lexer),
            _ -> rejected()
        }
    }

    machine classify(lexer: @mutable Lexer) {
        classify_keyword(lexer);
    }

    machine rejected() {}
}

machine lex_whitespace(lexer: @mutable Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as +Trapping;
    transition { _ -> scan(lexer) }

    machine scan(lexer: @mutable Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode(lexer),
            _ -> finish(lexer)
        }
    }

    machine decode(lexer: @mutable Lexer) {
        let decoded: DecodedScalar = decode_scalar(@lexer.source, lexer.cursor);
        let whitespace: bool = is_whitespace(decoded.scalar);
        transition whitespace {
            true -> advance(lexer, decoded.width),
            _ -> finish(lexer)
        }
    }

    machine advance(lexer: @mutable Lexer, width: u64 in Trapping) {
        lexer.cursor = lexer.cursor + width;
        transition { _ -> scan(lexer) }
    }

    machine finish(lexer: @mutable Lexer) {}
}

machine lex_line_comment(lexer: @mutable Lexer) {
    lexer.cursor = lexer.cursor + 2;
    transition { _ -> scan(lexer) }

    machine scan(lexer: @mutable Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> byte(lexer),
            _ -> finish(lexer)
        }
    }

    machine byte(lexer: @mutable Lexer) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        transition source_byte == 10 {
            true -> consume_newline(lexer),
            _ -> advance(lexer)
        }
    }

    machine advance(lexer: @mutable Lexer) {
        lexer.cursor = lexer.cursor + 1;
        transition { _ -> scan(lexer) }
    }

    machine consume_newline(lexer: @mutable Lexer) {
        lexer.cursor = lexer.cursor + 1;
    }

    machine finish(lexer: @mutable Lexer) {}
}

machine lex_block_comment(lexer: @mutable Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.cursor = lexer.cursor + 2;
    transition { _ -> scan(lexer, 1 as +Trapping) }

    machine scan(lexer: @mutable Lexer, depth: u64 in Trapping) {
        transition lexer.cursor < lexer.source.length {
            true -> pair_bound(lexer, depth),
            _ -> unterminated(lexer)
        }
    }

    machine pair_bound(lexer: @mutable Lexer, depth: u64 in Trapping) {
        let index1: u64 in Trapping = lexer.cursor + 1;
        transition index1 < lexer.source.length {
            true -> open_check(lexer, depth, index1),
            _ -> advance(lexer, depth)
        }
    }

    machine open_check(lexer: @mutable Lexer, depth: u64 in Trapping, index1: u64 in Trapping) {
        let first_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        let second_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, index1);
        transition first_byte == 47 && second_byte == 42 {
            true -> open(lexer, depth),
            _ -> close_check(lexer, depth, first_byte, second_byte)
        }
    }

    machine open(lexer: @mutable Lexer, depth: u64 in Trapping) {
        let deeper: u64 in Trapping = depth + 1;
        lexer.cursor = lexer.cursor + 2;
        transition { _ -> scan(lexer, deeper) }
    }

    machine close_check(lexer: @mutable Lexer, depth: u64 in Trapping, first_byte: u8, second_byte: u8) {
        transition first_byte == 42 && second_byte == 47 {
            true -> close(lexer, depth),
            _ -> advance(lexer, depth)
        }
    }

    machine close(lexer: @mutable Lexer, depth: u64 in Trapping) {
        let shallower: u64 in Trapping = depth - 1;
        lexer.cursor = lexer.cursor + 2;
        transition shallower == 0 {
            true -> finish(lexer),
            _ -> scan(lexer, shallower)
        }
    }

    machine advance(lexer: @mutable Lexer, depth: u64 in Trapping) {
        lexer.cursor = lexer.cursor + 1;
        transition { _ -> scan(lexer, depth) }
    }

    machine finish(lexer: @mutable Lexer) {}

    machine unterminated(lexer: @mutable Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.source.length as +Trapping;
        lexer_reject(lexer, |tokens|::LexDiagnosticCode::UnterminatedBlockComment, start, end);
    }
}

// Append the source bytes `start..end` to the decoded stream.
machine copy_source_to_decoded(lexer: @mutable Lexer, start: u64 in Trapping, end: u64 in Trapping) {
    transition { _ -> scan(lexer, start, end) }

    machine scan(lexer: @mutable Lexer, at: u64 in Trapping, end: u64 in Trapping) {
        transition at < end {
            true -> copy(lexer, at, end),
            _ -> done()
        }
    }
    machine copy(lexer: @mutable Lexer, at: u64 in Trapping, end: u64 in Trapping) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, at);
        lexer_push_decoded(lexer, source_byte);
        let next: u64 in Trapping = at + 1;
        transition lexer.output.accepted { true -> scan(lexer, next, end), _ -> done() }
    }
    machine done() {}
}

machine lex_cooked_string(lexer: @mutable Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as +Trapping;
    lexer.cursor = lexer.cursor + 1;
    transition { _ -> scan(lexer) }

    machine scan(lexer: @mutable Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> decode(lexer),
            _ -> unterminated(lexer)
        }
    }

    machine decode(lexer: @mutable Lexer) {
        let decoded: DecodedScalar = decode_scalar(@lexer.source, lexer.cursor);
        transition decoded.scalar == 34 {
            true -> finish(lexer),
            _ -> newline_check(lexer, decoded.scalar, decoded.width)
        }
    }

    machine newline_check(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping) {
        transition scalar == 10 || scalar == 13 {
            true -> outside_profile_line(lexer),
            _ -> slash(lexer, scalar, width)
        }
    }

    machine slash(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping) {
        transition scalar == 92 {
            true -> escape_begin(lexer),
            _ -> copy_scalar(lexer, width)
        }
    }

    machine copy_scalar(lexer: @mutable Lexer, width: u64 in Trapping) {
        let start: u64 in Trapping = lexer.cursor;
        let end: u64 in Trapping = lexer.cursor + width;
        copy_source_to_decoded(lexer, start, end);
        lexer.cursor = end;
        transition lexer.output.accepted { true -> scan(lexer), _ -> done() }
    }

    machine escape_begin(lexer: @mutable Lexer) {
        let escape_start: u64 in Trapping = lexer.cursor;
        lexer.cursor = lexer.cursor + 1;
        transition lexer.cursor < lexer.source.length {
            true -> escape_byte(lexer, escape_start),
            _ -> unterminated_escape(lexer)
        }
    }

    machine escape_byte(lexer: @mutable Lexer, escape_start: u64 in Trapping) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        let escape: u32 in Trapping = source_byte as u32 +Trapping;
        transition escape {
            34 -> escaped_quote(lexer),
            92 -> escaped_slash(lexer),
            110 -> escaped_n(lexer),
            114 -> escaped_r(lexer),
            116 -> escaped_t(lexer),
            48 -> escaped_zero(lexer),
            120 -> hex_begin(lexer, escape_start),
            117 -> outside_profile_escape(lexer, escape_start),
            _ -> unsupported_escape(lexer, escape_start)
        }
    }

    machine escaped_quote(lexer: @mutable Lexer) { lexer_push_decoded(lexer, 34); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer), _ -> done() } }
    machine escaped_slash(lexer: @mutable Lexer) { lexer_push_decoded(lexer, 92); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer), _ -> done() } }
    machine escaped_n(lexer: @mutable Lexer) { lexer_push_decoded(lexer, 10); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer), _ -> done() } }
    machine escaped_r(lexer: @mutable Lexer) { lexer_push_decoded(lexer, 13); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer), _ -> done() } }
    machine escaped_t(lexer: @mutable Lexer) { lexer_push_decoded(lexer, 9); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer), _ -> done() } }
    machine escaped_zero(lexer: @mutable Lexer) { lexer_push_decoded(lexer, 0); lexer.cursor = lexer.cursor + 1; transition lexer.output.accepted { true -> scan(lexer), _ -> done() } }

    machine hex_begin(lexer: @mutable Lexer, escape_start: u64 in Trapping) {
        let index1: u64 in Trapping = lexer.cursor + 1;
        let index2: u64 in Trapping = lexer.cursor + 2;
        transition index2 < lexer.source.length {
            true -> hex_first(lexer, index1, index2),
            _ -> hex_unterminated(lexer, escape_start)
        }
    }

    machine hex_first(lexer: @mutable Lexer, index1: u64 in Trapping, index2: u64 in Trapping) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, index1);
        let high: u32 in Trapping = |digits|::hex_digit_value(source_byte as u32 +Trapping);
        transition high < 16 {
            true -> hex_second(lexer, index2, high),
            _ -> hex_invalid_first(lexer)
        }
    }

    machine hex_second(lexer: @mutable Lexer, index2: u64 in Trapping, high: u32 in Trapping)
    requires high < 16
    {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, index2);
        let low: u32 in Trapping = |digits|::hex_digit_value(source_byte as u32 +Trapping);
        transition low < 16 {
            true -> hex_emit(lexer, high, low),
            _ -> hex_invalid_second(lexer)
        }
    }

    // Each caller has checked its digit. Retain those bounds across the
    // private calls so exact narrowing follows the actual hexadecimal value.
    machine hex_emit(lexer: @mutable Lexer, high: u32 in Trapping, low: u32 in Trapping)
    requires high < 16, low < 16
    {
        let byte: u8 = ((high * 16 + low) as -Trapping) as u8;
        lexer_push_decoded(lexer, byte);
        lexer.cursor = lexer.cursor + 3;
        transition lexer.output.accepted { true -> scan(lexer), _ -> done() }
    }

    machine finish(lexer: @mutable Lexer) {
        lexer.cursor = lexer.cursor + 1;
        lexer.token_end = lexer.cursor;
        push_token(lexer, |tokens|::TokenKind::StringLiteral);
    }

    machine unterminated(lexer: @mutable Lexer) { let start: u64 in Trapping = lexer.token_start; let end: u64 in Trapping = lexer.source.length as +Trapping; lexer_reject(lexer, |tokens|::LexDiagnosticCode::UnterminatedStringLiteral, start, end); }
    machine unterminated_escape(lexer: @mutable Lexer) { let start: u64 in Trapping = lexer.token_start; let end: u64 in Trapping = lexer.source.length as +Trapping; lexer_reject(lexer, |tokens|::LexDiagnosticCode::UnterminatedStringEscape, start, end); }
    machine unsupported_escape(lexer: @mutable Lexer, escape_start: u64 in Trapping) { let end: u64 in Trapping = lexer.cursor + 1; lexer_reject(lexer, |tokens|::LexDiagnosticCode::UnsupportedEscape, escape_start, end); }
    machine hex_unterminated(lexer: @mutable Lexer, escape_start: u64 in Trapping) { let end: u64 in Trapping = lexer.source.length as +Trapping; lexer_reject(lexer, |tokens|::LexDiagnosticCode::UnterminatedHexEscape, escape_start, end); }
    machine hex_invalid_first(lexer: @mutable Lexer) { let start: u64 in Trapping = lexer.cursor + 1; let end: u64 in Trapping = lexer.cursor + 2; lexer_reject(lexer, |tokens|::LexDiagnosticCode::InvalidHexEscapeDigit, start, end); }
    machine hex_invalid_second(lexer: @mutable Lexer) { let start: u64 in Trapping = lexer.cursor + 2; let end: u64 in Trapping = lexer.cursor + 3; lexer_reject(lexer, |tokens|::LexDiagnosticCode::InvalidHexEscapeDigit, start, end); }
    machine outside_profile_escape(lexer: @mutable Lexer, escape_start: u64 in Trapping) {
        let end: u64 in Trapping = lexer.cursor + 1;
        lexer_reject(lexer, |tokens|::LexDiagnosticCode::OutsideLexicalProfile, escape_start, end);
    }
    machine outside_profile_line(lexer: @mutable Lexer) {
        let start: u64 in Trapping = lexer.cursor;
        let end: u64 in Trapping = lexer.cursor + 1;
        lexer_reject(lexer, |tokens|::LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }
    machine done() {}
}

// Fold one digit of `base` into the integer literal under way. A value past
// 2^64 - 1 clears `literal_exact` rather than wrapping
// (wiki/spec/language/numeric_values.md#literal-landing-and-destinations).
// A float's fraction and exponent digits also pass through here; a float
// token never reads the result.
machine lexer_accumulate_digit(lexer: @mutable Lexer, base: |numeric|::NumericBase, byte: u32 in Trapping) {
    let value: u64 in Wrapping = |digits|::lexer_digit_value(byte);
    let room: u64 in Wrapping = 18446744073709551615 - value;
    transition base {
        |numeric|::NumericBase::Binary -> fold(lexer, 2 as +Wrapping, value, room / 2),
        |numeric|::NumericBase::Octal -> fold(lexer, 8 as +Wrapping, value, room / 8),
        |numeric|::NumericBase::Decimal -> fold(lexer, 10 as +Wrapping, value, room / 10),
        |numeric|::NumericBase::Hexadecimal -> fold(lexer, 16 as +Wrapping, value, room / 16)
    }
    // `magnitude * radix + value` fits exactly when `magnitude <= limit`.
    machine fold(lexer: @mutable Lexer, radix: u64 in Wrapping, value: u64 in Wrapping, limit: u64 in Wrapping) {
        transition lexer.literal_exact && lexer.literal_magnitude <= limit {
            true -> fits(lexer, radix, value),
            _ -> overflows(lexer)
        }
    }
    machine fits(lexer: @mutable Lexer, radix: u64 in Wrapping, value: u64 in Wrapping) {
        lexer.literal_magnitude = lexer.literal_magnitude * radix + value;
    }
    machine overflows(lexer: @mutable Lexer) {
        lexer.literal_exact = false;
    }
}

// The carrier an integer literal's suffix, the bytes `start..end`, names.
machine integer_suffix(source: @|source|::SourceUnit, start: u64 in Trapping, end: u64 in Trapping) -> |numeric|::IntegerSuffix
crashes Trap
{
    let sign: u8 = |source|::source_unit_byte_or_nul(source, start);
    let first: u8 = |source|::source_unit_byte_or_nul(source, start + 1);
    let second: u8 = |source|::source_unit_byte_or_nul(source, start + 2);
    let length: u64 in Trapping = end - start;
    transition length {
        0 -> answer(|numeric|::IntegerSuffix::None),
        2 -> byte_width(sign, first),
        3 -> wide(sign, first, second),
        _ -> answer(|numeric|::IntegerSuffix::Unknown)
    }
    machine byte_width(sign: u8, first: u8) -> |numeric|::IntegerSuffix {
        transition first == 56 {
            true -> signed(sign, |numeric|::IntegerSuffix::U8, |numeric|::IntegerSuffix::I8),
            _ -> answer(|numeric|::IntegerSuffix::Unknown)
        }
    }
    machine wide(sign: u8, first: u8, second: u8) -> |numeric|::IntegerSuffix {
        transition first == 49 && second == 54 {
            true -> signed(sign, |numeric|::IntegerSuffix::U16, |numeric|::IntegerSuffix::I16),
            _ -> thirty_two(sign, first, second)
        }
    }
    machine thirty_two(sign: u8, first: u8, second: u8) -> |numeric|::IntegerSuffix {
        transition first == 51 && second == 50 {
            true -> signed(sign, |numeric|::IntegerSuffix::U32, |numeric|::IntegerSuffix::I32),
            _ -> sixty_four(sign, first, second)
        }
    }
    machine sixty_four(sign: u8, first: u8, second: u8) -> |numeric|::IntegerSuffix {
        transition first == 54 && second == 52 {
            true -> signed(sign, |numeric|::IntegerSuffix::U64, |numeric|::IntegerSuffix::I64),
            _ -> answer(|numeric|::IntegerSuffix::Unknown)
        }
    }
    machine signed(sign: u8, unsigned_suffix: |numeric|::IntegerSuffix, signed_suffix: |numeric|::IntegerSuffix) -> |numeric|::IntegerSuffix {
        transition sign {
            117 -> answer(unsigned_suffix),
            105 -> answer(signed_suffix),
            _ -> answer(|numeric|::IntegerSuffix::Unknown)
        }
    }
    machine answer(suffix: |numeric|::IntegerSuffix) -> |numeric|::IntegerSuffix { suffix }
}

// Consume the digits of `base` and their `_` separators at the cursor. The
// result is whether at least one digit was consumed.
machine consume_digits(lexer: @mutable Lexer, base: |numeric|::NumericBase) -> bool {
    transition { _ -> scan(lexer, base, false) }
    machine scan(lexer: @mutable Lexer, base: |numeric|::NumericBase, saw_digit: bool) -> bool {
        transition lexer.cursor < lexer.source.length {
            true -> byte(lexer, base, saw_digit),
            _ -> done(saw_digit)
        }
    }
    machine byte(lexer: @mutable Lexer, base: |numeric|::NumericBase, saw_digit: bool) -> bool {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        let current: u32 in Trapping = source_byte as u32 +Trapping;
        transition current == 95 {
            true -> underscore(lexer, base, saw_digit),
            _ -> digit(lexer, base, saw_digit, current)
        }
    }
    machine underscore(lexer: @mutable Lexer, base: |numeric|::NumericBase, saw_digit: bool) -> bool { lexer.cursor = lexer.cursor + 1; transition { _ -> scan(lexer, base, saw_digit) } }
    machine digit(lexer: @mutable Lexer, base: |numeric|::NumericBase, saw_digit: bool, current: u32 in Trapping) -> bool {
        let digit: bool = |digits|::lexer_digit_in_base(current, base);
        transition digit {
            true -> consume(lexer, base, current),
            _ -> done(saw_digit)
        }
    }
    machine consume(lexer: @mutable Lexer, base: |numeric|::NumericBase, current: u32 in Trapping) -> bool {
        lexer_accumulate_digit(lexer, base, current);
        lexer.cursor = lexer.cursor + 1;
        transition { _ -> scan(lexer, base, true) }
    }
    machine done(saw_digit: bool) -> bool { saw_digit }
}

// Consume an identifier-shaped literal suffix at the cursor. The result is
// whether one was present.
machine consume_suffix(lexer: @mutable Lexer) -> bool {
    transition lexer.cursor < lexer.source.length {
        true -> decode_first(lexer),
        _ -> false
    }
    machine decode_first(lexer: @mutable Lexer) -> bool {
        let decoded: DecodedScalar = decode_scalar(@lexer.source, lexer.cursor);
        let starts: bool = is_identifier_start(decoded.scalar);
        transition starts {
            true -> consume(lexer, decoded.width),
            _ -> false
        }
    }
    machine consume(lexer: @mutable Lexer, width: u64 in Trapping) -> bool {
        lexer.cursor = lexer.cursor + width;
        transition lexer.cursor < lexer.source.length { true -> decode_next(lexer), _ -> true }
    }
    machine decode_next(lexer: @mutable Lexer) -> bool {
        let decoded: DecodedScalar = decode_scalar(@lexer.source, lexer.cursor);
        let continues: bool = is_identifier_continue(decoded.scalar);
        transition continues { true -> consume(lexer, decoded.width), _ -> true }
    }
}

// Whether the `.` at the cursor continues a float: not when it begins `..`
// or a member name.
machine dot_starts_float(lexer: @mutable Lexer) -> bool {
    transition lexer.cursor + 1 < lexer.source.length {
        true -> decode_after(lexer),
        _ -> true
    }
    machine decode_after(lexer: @mutable Lexer) -> bool {
        let after: u64 in Trapping = lexer.cursor + 1;
        let decoded: DecodedScalar = decode_scalar(@lexer.source, after);
        transition decoded.scalar >= 48 && decoded.scalar <= 57 {
            true -> true,
            _ -> dotdot(decoded.scalar)
        }
    }
    machine dotdot(scalar: u32 in Trapping) -> bool {
        transition scalar == 46 {
            true -> false,
            _ -> identifier(scalar)
        }
    }
    machine identifier(scalar: u32 in Trapping) -> bool {
        let starts: bool = is_identifier_start(scalar);
        transition starts { true -> false, _ -> true }
    }
}

machine lex_number(lexer: @mutable Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as +Trapping;
    lexer.literal_magnitude = 0 as +Wrapping;
    lexer.literal_exact = true;
    let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
    transition source_byte == 46 {
        true -> leading_dot(lexer),
        _ -> integer_begin(lexer)
    }

    machine leading_dot(lexer: @mutable Lexer) {
        lexer.cursor = lexer.cursor + 1;
        _ = consume_digits(lexer, |numeric|::NumericBase::Decimal);
        transition { _ -> exponent_check(lexer, true) }
    }

    machine integer_begin(lexer: @mutable Lexer) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        let first: u32 in Trapping = source_byte as u32 +Trapping;
        lexer.cursor = lexer.cursor + 1;
        lexer.literal_magnitude = ((source_byte as u64) as +Wrapping) - 48;
        transition first == 48 {
            true -> prefix_bound(lexer),
            _ -> decimal_digits(lexer)
        }
    }

    machine prefix_bound(lexer: @mutable Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> prefix(lexer),
            _ -> dot_check(lexer)
        }
    }

    machine prefix(lexer: @mutable Lexer) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        let marker: u32 in Trapping = source_byte as u32 +Trapping;
        transition marker == 98 || marker == 66 {
            true -> based_digits(lexer, |numeric|::NumericBase::Binary),
            _ -> octal_check(lexer, marker)
        }
    }
    machine octal_check(lexer: @mutable Lexer, marker: u32 in Trapping) { transition marker == 111 || marker == 79 { true -> based_digits(lexer, |numeric|::NumericBase::Octal), _ -> hex_check(lexer, marker) } }
    machine hex_check(lexer: @mutable Lexer, marker: u32 in Trapping) { transition marker == 120 || marker == 88 { true -> based_digits(lexer, |numeric|::NumericBase::Hexadecimal), _ -> decimal_digits(lexer) } }
    // Consume the base marker, then the digits it selects.
    machine based_digits(lexer: @mutable Lexer, base: |numeric|::NumericBase) {
        lexer.cursor = lexer.cursor + 1;
        lexer.literal_magnitude = 0 as +Wrapping;
        let saw_digit: bool = consume_digits(lexer, base);
        let empty_digits: bool = !saw_digit;
        transition { _ -> finish_integer(lexer, base, empty_digits) }
    }
    machine decimal_digits(lexer: @mutable Lexer) { _ = consume_digits(lexer, |numeric|::NumericBase::Decimal); transition { _ -> dot_check(lexer) } }

    machine dot_check(lexer: @mutable Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> dot_byte(lexer),
            _ -> exponent_check(lexer, false)
        }
    }
    machine dot_byte(lexer: @mutable Lexer) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        transition source_byte == 46 {
            true -> dot_decision(lexer),
            _ -> exponent_check(lexer, false)
        }
    }
    machine dot_decision(lexer: @mutable Lexer) {
        let starts: bool = dot_starts_float(lexer);
        transition starts {
            true -> dot_consume(lexer),
            _ -> exponent_check(lexer, false)
        }
    }
    machine dot_consume(lexer: @mutable Lexer) {
        lexer.cursor = lexer.cursor + 1;
        _ = consume_digits(lexer, |numeric|::NumericBase::Decimal);
        transition { _ -> exponent_check(lexer, true) }
    }

    // Only decimal literals reach the exponent: a based literal ends at its
    // digits. `is_float` is whether a `.` was consumed.
    machine exponent_check(lexer: @mutable Lexer, is_float: bool) {
        transition lexer.cursor < lexer.source.length {
            true -> exponent_byte(lexer, is_float),
            _ -> no_exponent(lexer, is_float)
        }
    }
    machine exponent_byte(lexer: @mutable Lexer, is_float: bool) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        let marker: u32 in Trapping = source_byte as u32 +Trapping;
        transition marker == 101 || marker == 69 {
            true -> exponent_begin(lexer),
            _ -> no_exponent(lexer, is_float)
        }
    }
    machine no_exponent(lexer: @mutable Lexer, is_float: bool) {
        transition is_float {
            true -> finish_float(lexer, false, false),
            _ -> finish_integer(lexer, |numeric|::NumericBase::Decimal, false)
        }
    }
    machine exponent_begin(lexer: @mutable Lexer) {
        lexer.cursor = lexer.cursor + 1;
        transition lexer.cursor < lexer.source.length { true -> exponent_sign(lexer), _ -> exponent_digits(lexer) }
    }
    machine exponent_sign(lexer: @mutable Lexer) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        let sign: u32 in Trapping = source_byte as u32 +Trapping;
        transition sign == 43 || sign == 45 { true -> exponent_sign_consume(lexer), _ -> exponent_digits(lexer) }
    }
    machine exponent_sign_consume(lexer: @mutable Lexer) { lexer.cursor = lexer.cursor + 1; transition { _ -> exponent_digits(lexer) } }
    machine exponent_digits(lexer: @mutable Lexer) {
        let saw_digit: bool = consume_digits(lexer, |numeric|::NumericBase::Decimal);
        let empty_exponent: bool = !saw_digit;
        transition { _ -> finish_float(lexer, true, empty_exponent) }
    }

    machine finish_float(lexer: @mutable Lexer, has_exponent: bool, empty_exponent: bool) {
        let has_suffix: bool = consume_suffix(lexer);
        lexer.token_end = lexer.cursor;
        let float: |tokens|::TokenKind = |tokens|::TokenKind::Float {
            has_exponent: has_exponent,
            empty_exponent: empty_exponent,
            has_suffix: has_suffix
        };
        push_token(lexer, float);
    }
    machine finish_integer(lexer: @mutable Lexer, base: |numeric|::NumericBase, empty_digits: bool) {
        let suffix_start: u64 in Trapping = lexer.cursor;
        let has_suffix: bool = consume_suffix(lexer);
        lexer.token_end = lexer.cursor;
        let suffix: |numeric|::IntegerSuffix = integer_suffix(@lexer.source, suffix_start, lexer.cursor);
        let integer: |tokens|::TokenKind = |tokens|::TokenKind::Integer {
            base: base,
            empty_digits: empty_digits,
            has_suffix: has_suffix,
            magnitude: lexer.literal_magnitude,
            exact: lexer.literal_exact,
            suffix: suffix
        };
        push_token(lexer, integer);
    }
}

// `scalar_width` is the encoded width of the scalar at the cursor, which
// bounds the span an unsupported scalar rejects.
machine lex_punctuation(lexer: @mutable Lexer, scalar_width: u64 in Trapping) {
    lexer.token_start = lexer.cursor;
    lexer.decoded_start = lexer.output.decoded_length as +Trapping;
    let first_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
    let byte0: u32 in Trapping = first_byte as u32 +Trapping;
    let index1: u64 in Trapping = lexer.cursor + 1;
    let index2: u64 in Trapping = lexer.cursor + 2;
    transition index1 < lexer.source.length { true -> second(lexer, scalar_width, byte0, index1, index2), _ -> classify(lexer, scalar_width, byte0, 4294967295 as +Trapping, 4294967295 as +Trapping) }
    machine second(
        lexer: @mutable Lexer,
        scalar_width: u64 in Trapping,
        byte0: u32 in Trapping,
        index1: u64 in Trapping,
        index2: u64 in Trapping
    ) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, index1);
        let byte1: u32 in Trapping = source_byte as u32 +Trapping;
        transition index2 < lexer.source.length { true -> third(lexer, scalar_width, byte0, byte1, index2), _ -> classify(lexer, scalar_width, byte0, byte1, 4294967295 as +Trapping) }
    }
    machine third(
        lexer: @mutable Lexer,
        scalar_width: u64 in Trapping,
        byte0: u32 in Trapping,
        byte1: u32 in Trapping,
        index2: u64 in Trapping
    ) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, index2);
        let byte2: u32 in Trapping = source_byte as u32 +Trapping;
        transition { _ -> classify(lexer, scalar_width, byte0, byte1, byte2) }
    }

    machine classify(
        lexer: @mutable Lexer,
        scalar_width: u64 in Trapping,
        byte0: u32 in Trapping,
        byte1: u32 in Trapping,
        byte2: u32 in Trapping
    ) {
        transition byte0 {
            38 -> ampersand(lexer, byte1),
            36 -> emit_punctuation(lexer, |tokens|::PunctuationKind::Dollar, 1 as +Trapping),
            92 -> emit_punctuation(lexer, |tokens|::PunctuationKind::Backslash, 1 as +Trapping),
            64 -> emit_punctuation(lexer, |tokens|::PunctuationKind::At, 1 as +Trapping),
            39 -> single_apostrophe(lexer),
            42 -> asterisk(lexer, byte1),
            94 -> single_caret(lexer),
            58 -> colon(lexer, byte1),
            44 -> single_comma(lexer),
            46 -> dot(lexer, byte1, byte2),
            61 -> equal(lexer, byte1),
            33 -> exclamation(lexer, byte1),
            62 -> greater(lexer, byte1),
            35 -> single_hash(lexer),
            123 -> single_left_brace(lexer),
            91 -> single_left_bracket(lexer),
            40 -> single_left_paren(lexer),
            60 -> less(lexer, byte1),
            45 -> minus(lexer, byte1),
            37 -> percent(lexer, byte1),
            124 -> pipe(lexer, byte1),
            43 -> plus(lexer, byte1),
            125 -> single_right_brace(lexer),
            93 -> single_right_bracket(lexer),
            41 -> single_right_paren(lexer),
            59 -> single_semicolon(lexer),
            47 -> slash(lexer, byte1),
            126 -> single_tilde(lexer),
            _ -> unsupported(lexer, scalar_width)
        }
    }

    machine ampersand(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 38 { true -> and_and(lexer), _ -> single_ampersand(lexer) } }
    machine colon(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 58 { true -> colon_colon(lexer), _ -> single_colon(lexer) } }
    machine dot(lexer: @mutable Lexer, byte1: u32 in Trapping, byte2: u32 in Trapping) { transition byte1 == 46 { true -> dotdot(lexer, byte2), _ -> single_dot(lexer) } }
    machine dotdot(lexer: @mutable Lexer, byte2: u32 in Trapping) { transition byte2 == 61 { true -> dotdot_equal(lexer), _ -> dotdot_plain(lexer) } }
    machine equal(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 61 { true -> equal_equal(lexer), _ -> single_equal(lexer) } }
    machine exclamation(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 61 { true -> exclamation_equal(lexer), _ -> single_exclamation(lexer) } }
    // `>>` stays two `>` tokens: nested static argument lists close one `>`
    // at a time, and the expression grammar reads adjacent `>` `>` as a shift.
    machine greater(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 61 { true -> greater_equal(lexer), _ -> single_greater(lexer) } }
    machine less(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 60 { true -> less_less(lexer), _ -> less_equal_check(lexer, byte1) } }
    machine less_equal_check(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 61 { true -> less_equal(lexer), _ -> single_less(lexer) } }
    machine minus(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 62 { true -> arrow(lexer), _ -> minus_equal_check(lexer, byte1) } }
    machine minus_equal_check(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 61 { true -> minus_equal(lexer), _ -> single_minus(lexer) } }
    machine percent(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 61 { true -> percent_equal(lexer), _ -> single_percent(lexer) } }
    machine pipe(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 124 { true -> pipe_pipe(lexer), _ -> single_pipe(lexer) } }
    machine plus(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 61 { true -> plus_equal(lexer), _ -> single_plus(lexer) } }
    machine asterisk(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 61 { true -> asterisk_equal(lexer), _ -> single_asterisk(lexer) } }
    machine slash(lexer: @mutable Lexer, byte1: u32 in Trapping) { transition byte1 == 61 { true -> slash_equal(lexer), _ -> single_slash(lexer) } }

    machine single_ampersand(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Ampersand, 1 as +Trapping); }
    machine and_and(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::AndAnd, 2 as +Trapping); }
    machine single_apostrophe(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Apostrophe, 1 as +Trapping); }
    machine arrow(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Arrow, 2 as +Trapping); }
    machine single_asterisk(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Asterisk, 1 as +Trapping); }
    machine single_caret(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Caret, 1 as +Trapping); }
    machine single_colon(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Colon, 1 as +Trapping); }
    machine colon_colon(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::ColonColon, 2 as +Trapping); }
    machine single_comma(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Comma, 1 as +Trapping); }
    machine single_dot(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Dot, 1 as +Trapping); }
    machine dotdot_plain(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::DotDot, 2 as +Trapping); }
    machine dotdot_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::DotDotEqual, 3 as +Trapping); }
    machine single_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Equal, 1 as +Trapping); }
    machine equal_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::EqualEqual, 2 as +Trapping); }
    machine single_exclamation(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Exclamation, 1 as +Trapping); }
    machine exclamation_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::ExclamationEqual, 2 as +Trapping); }
    machine single_greater(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Greater, 1 as +Trapping); }
    machine greater_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::GreaterEqual, 2 as +Trapping); }
    machine single_hash(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Hash, 1 as +Trapping); }
    machine single_left_brace(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::LeftBrace, 1 as +Trapping); }
    machine single_left_bracket(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::LeftBracket, 1 as +Trapping); }
    machine single_left_paren(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::LeftParen, 1 as +Trapping); }
    machine single_less(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Less, 1 as +Trapping); }
    machine less_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::LessEqual, 2 as +Trapping); }
    machine less_less(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::LessLess, 2 as +Trapping); }
    machine single_minus(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Minus, 1 as +Trapping); }
    machine minus_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::MinusEqual, 2 as +Trapping); }
    machine single_percent(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Percent, 1 as +Trapping); }
    machine percent_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::PercentEqual, 2 as +Trapping); }
    machine single_pipe(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Pipe, 1 as +Trapping); }
    machine pipe_pipe(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::PipePipe, 2 as +Trapping); }
    machine single_plus(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Plus, 1 as +Trapping); }
    machine plus_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::PlusEqual, 2 as +Trapping); }
    machine asterisk_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::AsteriskEqual, 2 as +Trapping); }
    machine slash_equal(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::SlashEqual, 2 as +Trapping); }
    machine single_right_brace(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::RightBrace, 1 as +Trapping); }
    machine single_right_bracket(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::RightBracket, 1 as +Trapping); }
    machine single_right_paren(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::RightParen, 1 as +Trapping); }
    machine single_semicolon(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Semicolon, 1 as +Trapping); }
    machine single_slash(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Slash, 1 as +Trapping); }
    machine single_tilde(lexer: @mutable Lexer) { emit_punctuation(lexer, |tokens|::PunctuationKind::Tilde, 1 as +Trapping); }
    machine unsupported(lexer: @mutable Lexer, scalar_width: u64 in Trapping) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.token_start + scalar_width;
        lexer_reject(lexer, |tokens|::LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }
}

machine emit_punctuation(lexer: @mutable Lexer, kind: |tokens|::PunctuationKind, length: u64 in Trapping) {
    lexer.cursor = lexer.cursor + length;
    lexer.token_end = lexer.cursor;
    push_token(lexer, |tokens|::TokenKind::Punctuation { punctuation: kind });
}

machine reject_raw_string_candidate(lexer: @mutable Lexer) {
    lexer.token_start = lexer.cursor;
    lexer.cursor = lexer.cursor + 1;
    transition { _ -> scan(lexer) }

    machine scan(lexer: @mutable Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> byte(lexer),
            _ -> reject_prefix(lexer)
        }
    }

    machine byte(lexer: @mutable Lexer) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        transition source_byte == 35 {
            true -> hash(lexer),
            _ -> quote(lexer)
        }
    }

    machine hash(lexer: @mutable Lexer) {
        lexer.cursor = lexer.cursor + 1;
        transition { _ -> scan(lexer) }
    }

    machine quote(lexer: @mutable Lexer) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, lexer.cursor);
        transition source_byte == 34 {
            true -> reject_quote(lexer),
            _ -> reject_prefix(lexer)
        }
    }

    machine reject_quote(lexer: @mutable Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.cursor + 1;
        lexer_reject(lexer, |tokens|::LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }

    machine reject_prefix(lexer: @mutable Lexer) {
        let start: u64 in Trapping = lexer.token_start;
        let end: u64 in Trapping = lexer.cursor;
        lexer_reject(lexer, |tokens|::LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }
}

// Whether the `r` at the cursor begins a raw string: `r`, any `#`s, then `"`.
machine is_raw_string_candidate(lexer: @mutable Lexer) -> bool {
    let after: u64 in Trapping = lexer.cursor + 1;
    transition { _ -> scan(lexer, after) }

    machine scan(lexer: @mutable Lexer, at: u64 in Trapping) -> bool {
        transition at < lexer.source.length {
            true -> byte(lexer, at),
            _ -> false
        }
    }

    machine byte(lexer: @mutable Lexer, at: u64 in Trapping) -> bool {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, at);
        transition source_byte == 35 {
            true -> hash(lexer, at),
            _ -> quote(source_byte)
        }
    }

    machine hash(lexer: @mutable Lexer, at: u64 in Trapping) -> bool {
        transition { _ -> scan(lexer, at + 1) }
    }

    machine quote(source_byte: u8) -> bool {
        transition source_byte == 34 {
            true -> true,
            _ -> false
        }
    }
}

machine lex_next(lexer: @mutable Lexer) {
    let decoded: DecodedScalar = decode_scalar(@lexer.source, lexer.cursor);
    transition decoded.scalar >= 128 {
        true -> outside_profile_syntax(lexer, decoded.width),
        _ -> whitespace_check(lexer, decoded.scalar, decoded.width)
    }
    machine outside_profile_syntax(lexer: @mutable Lexer, width: u64 in Trapping) {
        let start: u64 in Trapping = lexer.cursor;
        let end: u64 in Trapping = lexer.cursor + width;
        lexer_reject(lexer, |tokens|::LexDiagnosticCode::OutsideLexicalProfile, start, end);
    }
    machine whitespace_check(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping) {
        transition is_whitespace(scalar) {
            true -> whitespace(lexer),
            _ -> line_comment_bound(lexer, scalar, width)
        }
    }
    machine whitespace(lexer: @mutable Lexer) { lex_whitespace(lexer); }
    machine line_comment_bound(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping) { let index1: u64 in Trapping = lexer.cursor + 1; transition scalar == 47 && index1 < lexer.source.length { true -> comment_second(lexer, scalar, width, index1), _ -> raw_check(lexer, scalar, width) } }
    machine comment_second(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping, index1: u64 in Trapping) {
        let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, index1);
        let second: u32 in Trapping = source_byte as u32 +Trapping;
        transition second == 47 { true -> line_comment(lexer), _ -> block_comment_check(lexer, scalar, width, second) }
    }
    machine line_comment(lexer: @mutable Lexer) { lex_line_comment(lexer); }
    machine block_comment_check(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping, second: u32 in Trapping) { transition second == 42 { true -> block_comment(lexer), _ -> raw_check(lexer, scalar, width) } }
    machine block_comment(lexer: @mutable Lexer) { lex_block_comment(lexer); }
    machine raw_check(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping) {
        transition scalar == 114 {
            true -> raw_candidate(lexer, scalar, width),
            _ -> identifier_check(lexer, scalar, width)
        }
    }
    machine raw_candidate(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping) {
        let candidate: bool = is_raw_string_candidate(lexer);
        transition candidate {
            true -> raw(lexer),
            _ -> identifier_check(lexer, scalar, width)
        }
    }
    machine raw(lexer: @mutable Lexer) { reject_raw_string_candidate(lexer); }
    machine identifier_check(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping) { let starts: bool = is_identifier_start(scalar); transition starts { true -> identifier(lexer), _ -> number_check(lexer, scalar, width) } }
    machine identifier(lexer: @mutable Lexer) { lex_identifier(lexer); }
    machine number_check(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping) { transition scalar >= 48 && scalar <= 57 { true -> number(lexer), _ -> leading_dot_check(lexer, scalar, width) } }
    machine leading_dot_check(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping) { let index1: u64 in Trapping = lexer.cursor + 1; transition scalar == 46 && index1 < lexer.source.length { true -> leading_dot_second(lexer, scalar, width, index1), _ -> string_check(lexer, scalar, width) } }
    machine leading_dot_second(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping, index1: u64 in Trapping) { let source_byte: u8 = |source|::source_unit_byte_or_nul(@lexer.source, index1); let second: u32 in Trapping = source_byte as u32 +Trapping; transition second >= 48 && second <= 57 { true -> number(lexer), _ -> string_check(lexer, scalar, width) } }
    machine number(lexer: @mutable Lexer) { lex_number(lexer); }
    machine string_check(lexer: @mutable Lexer, scalar: u32 in Trapping, width: u64 in Trapping) { transition scalar == 34 { true -> string(lexer), _ -> punctuation(lexer, width) } }
    machine string(lexer: @mutable Lexer) { lex_cooked_string(lexer); }
    machine punctuation(lexer: @mutable Lexer, width: u64 in Trapping) { lex_punctuation(lexer, width); }
}

// Bounded array reads carry their collection's Trapping policy, so tokenizing
// publishes the same crash route its callees do.
public machine tokenize(lexer: @mutable Lexer)
crashes Trap
{
    |tokens|::token_stream_clear(@mutable lexer.output, lexer.source.id);
    validate_utf8(@mutable lexer);
    transition lexer.output.accepted {
        true -> begin(lexer),
        _ -> done()
    }
    machine begin(lexer: @mutable Lexer) { lexer.cursor = 0 as +Trapping; transition { _ -> scan(lexer) } }
    machine scan(lexer: @mutable Lexer) {
        transition lexer.cursor < lexer.source.length {
            true -> token(lexer),
            _ -> done()
        }
    }
    machine token(lexer: @mutable Lexer) {
        lex_next(@mutable lexer);
        transition lexer.output.accepted { true -> scan(lexer), _ -> done() }
    }
    machine done() {}
}
