use pipeline/typed_trees_to_checked_trees/reference_origins.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/holds.omg;
use pipeline/typed_trees_to_checked_trees/owned_places.omg;
use pipeline/typed_trees_to_checked_trees/ownership.omg;
use pipeline/typed_trees_to_checked_trees/places.omg;

use representations/checks/checks.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Loans held by locals (wiki/spec/language/ownership.md#borrows-and-aliases).
// A local whose type holds references holds a loan of every place its
// initializer lends: a borrow `@place` or `@mutable place`, a range slice a
// destination lends, or a reference passed on, directly or as a call's
// argument (a call's result may borrow from any of them) or a
// construction's field. A loan lasts until its holder's last use in the
// body. Copying a reference-bearing local value duplicates its captured loans;
// replacing a local retires its old loans only after capturing the new ones.
// A holder that reborrows another holder keeps its backing loans alive as
// long as itself. While a loan lasts, an access to an overlapping place
// other than through its holder conflicts when the loan is exclusive or the
// access writes, moves or lends exclusively: shared loans admit reads. An
// exit may not return a reference to a place the body owns, nor a holder
// of one.

// Every local's last use in the body from `first` to `end`: the index of
// the last statement whose trees name it.
public machine find_last_uses(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, first: u64 in Trapping, end: u64 in Trapping)
crashes Trap
{
    checker.ownership.use_count = 0;
    checker.ownership.loan_count = 0;
    transition { _ -> next(checker, syntax, resolution, first, end) }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping) {
        transition index < end && checker.output.machine_accepted {
            true -> statement(checker, syntax, resolution, index, end),
            _ -> done()
        }
    }

    machine statement(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping) {
        let statement: |syntax_trees|::Statement = |syntax_trees|::syntax_trees_statement(syntax, index);
        transition statement.kind {
            |syntax_trees|::StatementKind::Let -> optional(checker, syntax, resolution, index, end, statement),
            |syntax_trees|::StatementKind::Assign -> assigned(checker, syntax, resolution, index, end, statement),
            |syntax_trees|::StatementKind::Crash -> next(checker, syntax, resolution, index + 1, end),
            |syntax_trees|::StatementKind::Transition -> transition_uses(checker, syntax, resolution, index, end, statement),
            _ -> valued(checker, syntax, resolution, index, end, statement)
        }
    }

    machine optional(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, statement: |syntax_trees|::Statement) {
        transition statement.has_value {
            true -> valued(checker, syntax, resolution, index, end, statement),
            _ -> next(checker, syntax, resolution, index + 1, end)
        }
    }

    machine valued(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, statement: |syntax_trees|::Statement) {
        record_tree_uses(checker, syntax, resolution, statement.value, index);
        transition { _ -> next(checker, syntax, resolution, index + 1, end) }
    }

    machine assigned(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, statement: |syntax_trees|::Statement) {
        record_tree_uses(checker, syntax, resolution, statement.value, index);
        record_tree_uses(checker, syntax, resolution, statement.target, index);
        transition { _ -> next(checker, syntax, resolution, index + 1, end) }
    }

    machine transition_uses(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, statement: |syntax_trees|::Statement) {
        record_transition_uses(checker, syntax, resolution, statement, index);
        transition { _ -> next(checker, syntax, resolution, index + 1, end) }
    }

    machine done() {}
}

// A transition's subject, guards and targets are uses at its statement.
machine record_transition_uses(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement, index: u64 in Trapping)
crashes Trap
{
    transition statement.has_value {
        true -> subject(checker, syntax, resolution, statement, index),
        _ -> arm(checker, syntax, resolution, statement, index, 0 as +Trapping)
    }

    machine subject(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement, index: u64 in Trapping) {
        record_tree_uses(checker, syntax, resolution, statement.value, index);
        transition { _ -> arm(checker, syntax, resolution, statement, index, 0 as +Trapping) }
    }

    machine arm(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement, index: u64 in Trapping, offset: u64 in Trapping) {
        transition offset < statement.arm_count {
            true -> guarded(checker, syntax, resolution, statement, index, offset),
            _ -> done()
        }
    }

    machine guarded(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, statement: |syntax_trees|::Statement, index: u64 in Trapping, offset: u64 in Trapping) {
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_arm(syntax, statement.first_arm + offset);
        transition arm.kind == |syntax_trees|::ArmPatternKind::Guard {
            true -> guard(checker, syntax, resolution, statement, index, offset, arm),
            _ -> clause(checker, syntax, resolution, statement, index, offset, arm)
        }
    }

    machine guard(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        statement: |syntax_trees|::Statement,
        index: u64 in Trapping,
        offset: u64 in Trapping,
        arm: |syntax_trees|::TransitionArm
    ) {
        record_tree_uses(checker, syntax, resolution, arm.pattern, index);
        transition { _ -> clause(checker, syntax, resolution, statement, index, offset, arm) }
    }

    // An arm's `if` guard uses places as its pattern does.
    machine clause(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        statement: |syntax_trees|::Statement,
        index: u64 in Trapping,
        offset: u64 in Trapping,
        arm: |syntax_trees|::TransitionArm
    ) {
        transition arm.has_guard {
            true -> clause_uses(checker, syntax, resolution, statement, index, offset, arm),
            _ -> target(checker, syntax, resolution, statement, index, offset, arm)
        }
    }

    machine clause_uses(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        statement: |syntax_trees|::Statement,
        index: u64 in Trapping,
        offset: u64 in Trapping,
        arm: |syntax_trees|::TransitionArm
    ) {
        record_tree_uses(checker, syntax, resolution, arm.guard, index);
        transition { _ -> target(checker, syntax, resolution, statement, index, offset, arm) }
    }

    machine target(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        statement: |syntax_trees|::Statement,
        index: u64 in Trapping,
        offset: u64 in Trapping,
        current_arm: |syntax_trees|::TransitionArm
    ) {
        transition current_arm.target_kind == |syntax_trees|::ArmTargetKind::Unit {
            true -> arm(checker, syntax, resolution, statement, index, offset + 1),
            _ -> targeted(checker, syntax, resolution, statement, index, offset, current_arm)
        }
    }

    machine targeted(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        statement: |syntax_trees|::Statement,
        index: u64 in Trapping,
        offset: u64 in Trapping,
        current_arm: |syntax_trees|::TransitionArm
    ) {
        record_tree_uses(checker, syntax, resolution, current_arm.target, index);
        transition { _ -> arm(checker, syntax, resolution, statement, index, offset + 1) }
    }

    machine done() {}
}

// Every local a tree names is used at statement `index`.
machine record_tree_uses(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, root: u64 in Trapping, index: u64 in Trapping)
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    transition tree.first_row <= root {
        true -> node(checker, syntax, resolution, root, index, tree.first_row),
        _ -> done()
    }

    machine node(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, root: u64 in Trapping, index: u64 in Trapping, handle: u64 in Trapping) {
        transition handle <= root && checker.output.machine_accepted {
            true -> named(checker, syntax, resolution, root, index, handle),
            _ -> done()
        }
    }

    machine named(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, root: u64 in Trapping, index: u64 in Trapping, handle: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, handle);
        transition expression.kind == |syntax_trees|::ExpressionKind::Name {
            true -> local(checker, syntax, resolution, root, index, handle, binding),
            _ -> node(checker, syntax, resolution, root, index, handle + 1)
        }
    }

    machine local(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        root: u64 in Trapping,
        index: u64 in Trapping,
        handle: u64 in Trapping,
        binding: |symbol_resolved_trees|::ValueBinding
    ) {
        transition binding {
            |symbol_resolved_trees|::ValueBinding::Local { statement } -> used(checker, syntax, resolution, root, index, handle, statement * 4 + 1),
            _ -> node(checker, syntax, resolution, root, index, handle + 1)
        }
    }

    machine used(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        root: u64 in Trapping,
        index: u64 in Trapping,
        handle: u64 in Trapping,
        key: u64 in Trapping
    ) {
        let retained: bool = use_local(@mutable checker.ownership, key, index);
        transition retained {
            true -> node(checker, syntax, resolution, root, index, handle + 1),
            _ -> full(checker, syntax, handle)
        }
    }

    machine full(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }

    machine done() {}
}

// A local initialized at statement `index` holds a loan of every place its
// initializer lends, when its type holds references.
public machine create_loans(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, statement: |syntax_trees|::Statement)
crashes Trap
{
    let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, statement.value);
    let referencing: bool = holds_references(syntax, typing, type_handle);
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, statement.value);
    transition referencing && tree.first_row <= statement.value {
        true -> node(checker, syntax, resolution, typing, statement.value, index * 4 + 1, tree.first_row),
        _ -> done()
    }

    machine node(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        holder: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        transition handle <= root && checker.output.machine_accepted {
            true -> lends(checker, syntax, resolution, typing, root, holder, handle),
            _ -> done()
        }
    }

    machine lends(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        holder: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        let copied: bool = copy_carrier_loans(checker, syntax, resolution, typing, handle, holder);
        transition copied {
            true -> node(checker, syntax, resolution, typing, root, holder, handle + 1),
            _ -> borrowed(checker, syntax, resolution, typing, root, holder, handle)
        }
    }

    machine borrowed(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        holder: u64 in Trapping,
        handle: u64 in Trapping
    ) {
        let hold: |holds|::Hold = lent_place(checker, syntax, typing, handle);
        transition hold {
            |holds|::Hold::Shared { place } -> lend(checker, syntax, resolution, typing, root, holder, handle, place, false),
            |holds|::Hold::Exclusive { place } -> lend(checker, syntax, resolution, typing, root, holder, handle, place, true),
            _ -> node(checker, syntax, resolution, typing, root, holder, handle + 1)
        }
    }

    machine lend(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        holder: u64 in Trapping,
        handle: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool
    ) {
        let lender: u64 in Trapping = |owned_places|::path_root(syntax, resolution, typing, place, true);
        let inherited: bool = copy_holder_loans(checker, syntax, resolution, typing, handle, holder, lender);
        let owner: u64 in Trapping = |owned_places|::place_root(syntax, resolution, typing, place);
        let owned: bool = lends_owned(syntax, typing, handle, owner);
        let kept: bool = add_loan(@mutable checker.ownership, holder, place, exclusive, owned);
        extend_uses(@mutable checker.ownership, lender, holder);
        transition kept {
            true -> node(checker, syntax, resolution, typing, root, holder, handle + 1),
            _ -> full(checker, syntax, handle)
        }
    }

    machine full(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }

    machine done() {}
}

// A shared reference or an aggregate carrying references takes its local's
// captured loans, not a borrow of the variable holding the value. This also
// keeps loans when replacing a carrier with itself: capture precedes retiring
// the old rows. Explicit borrows and exclusive reborrows retain their access
// route. An originless local has no known local loan to duplicate.
machine copy_carrier_loans(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, holder: u64 in Trapping) -> bool
crashes Trap
{
    let lender: u64 in Trapping = carrier_root(checker, syntax, resolution, typing, handle);
    let copied: bool = copy_holder_loans(checker, syntax, resolution, typing, handle, holder, lender);
    copied
}

// Every derived loan retains the lender's complete backing roster. The new
// direct route separately records how the derived holder may access its
// lender; inherited rows keep their exact places, ownership and exclusivity.
machine copy_holder_loans(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, holder: u64 in Trapping, lender: u64 in Trapping) -> bool
crashes Trap
{
    let loan_count: u64 = checker.ownership.loan_count;
    transition lender > 0 {
        true -> next(checker, syntax, resolution, typing, handle, holder, lender, 0 as +Trapping, loan_count),
        _ -> answer(false)
    }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, holder: u64 in Trapping, lender: u64 in Trapping, index: u64 in Trapping, end: u64) -> bool {
        transition index < end && checker.output.machine_accepted {
            true -> loan(checker, syntax, resolution, typing, handle, holder, lender, index, end),
            _ -> answer(true)
        }
    }

    machine loan(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, holder: u64 in Trapping, lender: u64 in Trapping, index: u64 in Trapping, end: u64) -> bool {
        let source: u64 in Trapping = ownership_loan_holder(@checker.ownership, index);
        transition source == lender {
            true -> copy(checker, syntax, resolution, typing, handle, holder, lender, index, end),
            _ -> next(checker, syntax, resolution, typing, handle, holder, lender, index + 1, end)
        }
    }

    machine copy(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, holder: u64 in Trapping, lender: u64 in Trapping, index: u64 in Trapping, end: u64) -> bool {
        let place: u64 in Trapping = loan_place(@checker.ownership, index);
        let exclusive: bool = loan_exclusive(@checker.ownership, index);
        let owned: bool = loan_owned(@checker.ownership, index);
        let kept: bool = add_loan(@mutable checker.ownership, holder, place, exclusive, owned);
        let backing: u64 in Trapping = |owned_places|::path_root(syntax, resolution, typing, place, true);
        extend_uses(@mutable checker.ownership, backing, holder);
        transition kept {
            true -> next(checker, syntax, resolution, typing, handle, holder, lender, index + 1, end),
            _ -> full(checker, syntax, handle)
        }
    }

    machine full(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) -> bool {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
        true
    }

    machine answer(copied: bool) -> bool {
        copied
    }
}

// Value transport and escape inspect the same local carrier root. A
// projection conservatively inherits all the root's captured loans, including
// siblings: the table records holders, not reference-bearing payload paths.
// Scalar reads and explicit borrows keep their existing routes.
machine carrier_root(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
    let role: |ownership|::UseRole = |ownership|::role_of(checker, handle);
    let adaptation: |typed_trees|::Adaptation = |typed_trees|::typing_adaptation(typing, handle);
    let place: bool = expression.kind == |syntax_trees|::ExpressionKind::Name || expression.kind == |syntax_trees|::ExpressionKind::Field || expression.kind == |syntax_trees|::ExpressionKind::Index;
    transition place && role == |ownership|::UseRole::Value && adaptation == |typed_trees|::Adaptation::None {
        true -> typed(syntax, resolution, typing, handle, expression),
        _ -> absent()
    }

    machine typed(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression) -> u64 in Trapping {
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
        let shared: bool = expression.kind == |syntax_trees|::ExpressionKind::Name && row.kind == |typed_trees|::TypeKind::Reference && row.access == |syntax_trees|::ReferenceAccess::Shared;
        let aggregate: bool = row.kind != |typed_trees|::TypeKind::Reference && holds_references(syntax, typing, type_handle);
        transition shared || aggregate {
            true -> rooted(syntax, resolution, typing, handle),
            _ -> absent()
        }
    }

    machine rooted(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping) -> u64 in Trapping {
        let root: u64 in Trapping = |owned_places|::path_root(syntax, resolution, typing, handle, true);
        // Only locals hold captured rows. Parameters keep ordinary lending.
        transition root > 0 && root % 4 == 1 {
            true -> local(root),
            _ -> absent()
        }
    }

    machine local(root: u64 in Trapping) -> u64 in Trapping {
        root
    }

    machine absent() -> u64 in Trapping {
        0 as +Trapping
    }
}

// Replacing an owned local captures the RHS loans before retiring the previous
// value. Existing loans remain available while capturing the RHS, so even
// `reference = reference` preserves its loans. Writes through exclusive
// references and projected stores do not replace the local's loan carrier.
public machine capture_local_loans(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement) -> u64 in Trapping
crashes Trap
{
    let target: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, statement.target);
    let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, statement.target);
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
    let through: bool = row.kind == |typed_trees|::TypeKind::Reference && row.access != |syntax_trees|::ReferenceAccess::Shared;
    transition checker.output.machine_accepted && target.kind == |syntax_trees|::ExpressionKind::Name {
        true -> binding(checker, syntax, resolution, typing, statement, through),
        _ -> done()
    }

    // Assigning through an exclusive reference local replaces its referent;
    // where that referent is a local, the referent is the holder replaced.
    machine binding(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, through: bool) -> u64 in Trapping {
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, statement.target);
        transition binding {
            |symbol_resolved_trees|::ValueBinding::Local { statement as declaration } -> holder(checker, syntax, resolution, typing, statement, declaration, through),
            _ -> done()
        }
    }

    machine holder(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, declaration: u64 in Trapping, through: bool) -> u64 in Trapping {
        transition through {
            true -> referent(checker, syntax, resolution, typing, statement, declaration),
            _ -> capture(checker, syntax, resolution, typing, statement, declaration)
        }
    }

    machine referent(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, declaration: u64 in Trapping) -> u64 in Trapping {
        let place: u64 in Trapping = |places|::find_place(checker, |places|::PlaceKind::Local, declaration, 0 as +Trapping);
        let origin: u64 in Trapping = local_origin(checker, place);
        transition origin > 0 {
            true -> origin_holder(checker, syntax, resolution, typing, statement, origin),
            _ -> done()
        }
    }

    machine origin_holder(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, origin: u64 in Trapping) -> u64 in Trapping {
        let entry: |places|::Place = |places|::place_at(checker, origin - 1);
        transition entry.kind == |places|::PlaceKind::Local {
            true -> capture(checker, syntax, resolution, typing, statement, entry.handle),
            _ -> done()
        }
    }

    machine capture(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, declaration: u64 in Trapping) -> u64 in Trapping {
        create_loans(checker, syntax, resolution, typing, declaration, statement);
        declaration * 4 + 1
    }

    machine done() -> u64 in Trapping {
        0 as +Trapping
    }
}

// The origin a reference local captured (references.omg), zero when none.
machine local_origin(checker: @|checker|::Checker, place: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition place > 0 && place <= 256 {
        true -> captured(checker, place - 1),
        _ -> none()
    }

    machine captured(checker: @|checker|::Checker, index: u64 in Trapping) -> u64 in Trapping
    requires index < 256
    {
        |reference_origins|::reference_origin_place(checker.reference_origins[index as -Trapping])
    }

    machine none() -> u64 in Trapping {
        0 as +Trapping
    }
}

// A call lending a local `@write` replaces that local's whole value
// without observing it (wiki/spec/language/ownership.md#borrows-and-aliases):
// its old loans retire, and it holds whatever the call's other arguments
// lend, as a value a call returns may. Entered at the call after its
// arguments were walked.
public machine replace_lent_holders(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping)
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
    transition expression.kind == |syntax_trees|::ExpressionKind::Call && checker.output.machine_accepted {
        true -> argument(checker, syntax, resolution, typing, expression, 0 as +Trapping),
        _ -> done()
    }

    machine argument(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, offset: u64 in Trapping) {
        transition offset < expression.count {
            true -> lent(checker, syntax, resolution, typing, expression, offset),
            _ -> done()
        }
    }

    machine lent(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, offset: u64 in Trapping) {
        let node: u64 in Trapping = |syntax_trees|::syntax_trees_argument(syntax, expression.first + offset);
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, node);
        let operand: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, written.left);
        let write_only: bool = written.kind == |syntax_trees|::ExpressionKind::Unary && written.operator == |syntax_trees|::OperatorKind::BorrowWrite
            && operand.kind == |syntax_trees|::ExpressionKind::Name;
        transition write_only {
            true -> local(checker, syntax, resolution, typing, expression, offset, written.left),
            _ -> argument(checker, syntax, resolution, typing, expression, offset + 1)
        }
    }

    machine local(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, offset: u64 in Trapping, name: u64 in Trapping) {
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, name);
        transition binding {
            |symbol_resolved_trees|::ValueBinding::Local { statement as declaration } -> replaced(checker, syntax, resolution, typing, expression, offset, declaration * 4 + 1),
            _ -> argument(checker, syntax, resolution, typing, expression, offset + 1)
        }
    }

    machine replaced(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, offset: u64 in Trapping, holder: u64 in Trapping) {
        let previous_count: u64 = checker.ownership.loan_count;
        lend_arguments(checker, syntax, resolution, typing, expression, offset, holder, 0 as +Trapping);
        replace_loan_holder(@mutable checker.ownership, holder, previous_count);
        transition { _ -> argument(checker, syntax, resolution, typing, expression, offset + 1) }
    }

    machine done() {}
}

// Every argument of `expression` but the one at `skip` lends into `holder`.
machine lend_arguments(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, skip: u64 in Trapping, holder: u64 in Trapping, offset: u64 in Trapping)
crashes Trap
{
    transition offset < expression.count && checker.output.machine_accepted {
        true -> next(checker, syntax, resolution, typing, expression, skip, holder, offset),
        _ -> done()
    }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, skip: u64 in Trapping, holder: u64 in Trapping, offset: u64 in Trapping) {
        let node: u64 in Trapping = |syntax_trees|::syntax_trees_argument(syntax, expression.first + offset);
        transition offset == skip {
            true -> lend_arguments_next(checker, syntax, resolution, typing, expression, skip, holder, offset),
            _ -> lending(checker, syntax, resolution, typing, expression, skip, holder, offset, node)
        }
    }

    machine lending(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, skip: u64 in Trapping, holder: u64 in Trapping, offset: u64 in Trapping, node: u64 in Trapping) {
        lend_into(checker, syntax, resolution, typing, holder, node);
        transition { _ -> lend_arguments_next(checker, syntax, resolution, typing, expression, skip, holder, offset) }
    }

    machine lend_arguments_next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, skip: u64 in Trapping, holder: u64 in Trapping, offset: u64 in Trapping) {
        transition offset + 1 < expression.count && checker.output.machine_accepted {
            true -> next(checker, syntax, resolution, typing, expression, skip, holder, offset + 1),
            _ -> done()
        }
    }

    machine done() {}
}

// One node lends into `holder` what it lends: its carried loans, or the
// place it borrows or passes on.
machine lend_into(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, holder: u64 in Trapping, handle: u64 in Trapping)
crashes Trap
{
    let copied: bool = copy_carrier_loans(checker, syntax, resolution, typing, handle, holder);
    transition copied {
        true -> done(),
        _ -> borrowed(checker, syntax, resolution, typing, holder, handle)
    }

    machine borrowed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, holder: u64 in Trapping, handle: u64 in Trapping) {
        let hold: |holds|::Hold = lent_place(checker, syntax, typing, handle);
        transition hold {
            |holds|::Hold::Shared { place } -> lend(checker, syntax, resolution, typing, holder, handle, place, false),
            |holds|::Hold::Exclusive { place } -> lend(checker, syntax, resolution, typing, holder, handle, place, true),
            _ -> done()
        }
    }

    machine lend(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, holder: u64 in Trapping, handle: u64 in Trapping, place: u64 in Trapping, exclusive: bool) {
        let lender: u64 in Trapping = |owned_places|::path_root(syntax, resolution, typing, place, true);
        let inherited: bool = copy_holder_loans(checker, syntax, resolution, typing, handle, holder, lender);
        let owner: u64 in Trapping = |owned_places|::place_root(syntax, resolution, typing, place);
        let owned: bool = lends_owned(syntax, typing, handle, owner);
        let kept: bool = add_loan(@mutable checker.ownership, holder, place, exclusive, owned);
        extend_uses(@mutable checker.ownership, lender, holder);
        transition kept {
            true -> done(),
            _ -> full(checker, syntax, handle)
        }
    }

    machine full(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }

    machine done() {}
}

// Retire only the old carrier's loans, keeping the replacement captured after
// `previous_count` and every independent holder's earlier captured loans.
public machine replace_loan_holder(ownership: @mutable |ownership|::Ownership, holder: u64 in Trapping, previous_count: u64)
crashes Trap
{
    transition { _ -> next(ownership, holder, previous_count, 0 as +Trapping, 0 as +Trapping) }

    machine next(ownership: @mutable |ownership|::Ownership, holder: u64 in Trapping, previous_count: u64, index: u64 in Trapping, written: u64 in Trapping) {
        transition index < ownership.loan_count && index < 64 && written < 64 {
            true -> loan(ownership, holder, previous_count, index, written),
            _ -> done(ownership, written)
        }
    }

    machine loan(ownership: @mutable |ownership|::Ownership, holder: u64 in Trapping, previous_count: u64, index: u64 in Trapping, written: u64 in Trapping)
    requires index < 64, written < 64
    {
        let source: u64 = ownership.loan_holders[index as -Trapping];
        transition source == holder && index < previous_count {
            true -> next(ownership, holder, previous_count, index + 1, written),
            _ -> keep(ownership, holder, previous_count, index, written)
        }
    }

    machine keep(ownership: @mutable |ownership|::Ownership, holder: u64 in Trapping, previous_count: u64, index: u64 in Trapping, written: u64 in Trapping)
    requires index < 64, written < 64
    {
        ownership.loan_holders[written as -Trapping] = ownership.loan_holders[index as -Trapping];
        ownership.loan_places[written as -Trapping] = ownership.loan_places[index as -Trapping];
        ownership.loan_exclusive[written as -Trapping] = ownership.loan_exclusive[index as -Trapping];
        ownership.loan_owned[written as -Trapping] = ownership.loan_owned[index as -Trapping];
        transition { _ -> next(ownership, holder, previous_count, index + 1, written + 1) }
    }

    machine done(ownership: @mutable |ownership|::Ownership, written: u64 in Trapping) {
        ownership.loan_count = written as u64;
    }
}

// The place a tree node lends, and how: a borrow's operand, a range slice
// a destination lends implicitly, or a reference passed on whole.
public machine lent_place(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping) -> |holds|::Hold
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
    let adaptation: |typed_trees|::Adaptation = |typed_trees|::typing_adaptation(typing, handle);
    let role: |ownership|::UseRole = |ownership|::role_of(checker, handle);
    let flows: bool = role == |ownership|::UseRole::Value || role == |ownership|::UseRole::Borrow || role == |ownership|::UseRole::Exclusive
        || role == |ownership|::UseRole::WriteLend;
    transition flows {
        true -> adapted(syntax, typing, handle, expression, adaptation, role),
        _ -> answer(|holds|::Hold::Released)
    }

    // Only a value taken or lent can carry a loan into what holds it.
    machine adapted(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, adaptation: |typed_trees|::Adaptation, role: |ownership|::UseRole) -> |holds|::Hold {
        transition adaptation {
            |typed_trees|::Adaptation::SharedLend -> answer(|holds|::Hold::Shared { place: handle }),
            |typed_trees|::Adaptation::Read -> answer(|holds|::Hold::Released),
            _ -> written(syntax, typing, handle, expression, role)
        }
    }

    machine written(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, role: |ownership|::UseRole) -> |holds|::Hold {
        transition expression.kind {
            |syntax_trees|::ExpressionKind::Unary -> borrowed(typing, handle, expression, role),
            |syntax_trees|::ExpressionKind::Cast -> recast(syntax, typing, handle, expression, role),
            _ -> passed(typing, handle, expression, role)
        }
    }

    // Chained reference views retain the original borrow's loan. A cast
    // whose result is a scalar captures a value and retains no reference.
    machine recast(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, role: |ownership|::UseRole) -> |holds|::Hold {
        let result_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, result_type);
        transition row.kind == |typed_trees|::TypeKind::Reference {
            true -> reference_cast(syntax, typing, handle, role),
            _ -> answer(|holds|::Hold::Released)
        }
    }

    machine reference_cast(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping, role: |ownership|::UseRole) -> |holds|::Hold {
        let origin: u64 in Trapping = |typed_trees|::reference_cast_source(syntax, typing, handle);
        let operand: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, origin);
        transition operand.kind == |syntax_trees|::ExpressionKind::Unary {
            true -> borrowed(typing, origin, operand, role),
            _ -> passed(typing, origin, operand, |ownership|::UseRole::Value)
        }
    }

    machine borrowed(typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, role: |ownership|::UseRole) -> |holds|::Hold {
        transition expression.operator {
            |syntax_trees|::OperatorKind::Borrow -> answer(|holds|::Hold::Shared { place: expression.left }),
            |syntax_trees|::OperatorKind::BorrowMutable -> answer(|holds|::Hold::Exclusive { place: expression.left }),
            |syntax_trees|::OperatorKind::BorrowWrite -> answer(|holds|::Hold::Exclusive { place: expression.left }),
            _ -> passed(typing, handle, expression, role)
        }
    }

    // A reference value a place holds, taken whole, lends its referent.
    machine passed(typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, role: |ownership|::UseRole) -> |holds|::Hold {
        let node_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, node_type);
        let place: bool = expression.kind == |syntax_trees|::ExpressionKind::Name || expression.kind == |syntax_trees|::ExpressionKind::Field
            || expression.kind == |syntax_trees|::ExpressionKind::Index;
        let is_exclusive: bool = row.access != |syntax_trees|::ReferenceAccess::Shared;
        transition place && role == |ownership|::UseRole::Value && row.kind == |typed_trees|::TypeKind::Reference {
            true -> reference(handle, is_exclusive),
            _ -> answer(|holds|::Hold::Released)
        }
    }

    machine reference(handle: u64 in Trapping, is_exclusive: bool) -> |holds|::Hold {
        transition is_exclusive {
            true -> answer(|holds|::Hold::Exclusive { place: handle }),
            _ -> answer(|holds|::Hold::Shared { place: handle })
        }
    }

    machine answer(hold: |holds|::Hold) -> |holds|::Hold {
        hold
    }
}

// Whether a type may hold a reference through its elements, fields or type
// arguments. Explicit traversal frames retain the next sibling at each depth;
// calls do not recurse. One depth budget follows every structural edge, and
// its limit conservatively retains possible loans.
public machine holds_references(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping) -> bool
crashes Trap
{
    let zero: u64 in Trapping = 0 as +Trapping;
    let mutable handles: [u64 in Trapping; 9] = [zero, zero, zero, zero, zero, zero, zero, zero, zero];
    let mutable offsets: [u64 in Trapping; 9] = [zero, zero, zero, zero, zero, zero, zero, zero, zero];
    handles[0] = handle;
    walk_reference_types(syntax, typing, @mutable handles, @mutable offsets)
}

// The caller owns the traversal buffers for this entire ordinary call.
// Each nested state forwards the same two exclusive loans.
machine walk_reference_types(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing,
    handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9]) -> bool
crashes Trap
{
    transition { _ -> visit(syntax, typing, handles, offsets, 0 as +Trapping) }

    machine visit(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9], depth: u64 in Trapping) -> bool
    requires depth < 9
    {
        let index: u64 = depth as -Trapping;
        let handle: u64 in Trapping = handles[index];
        let offset: u64 in Trapping = offsets[index];
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, handle);
        transition row.kind {
            |typed_trees|::TypeKind::Reference -> answer(true),
            |typed_trees|::TypeKind::Array -> array(syntax, typing, handles, offsets, depth, offset, row),
            |typed_trees|::TypeKind::Data -> data(syntax, typing, handles, offsets, depth, offset, row),
            _ -> finished(syntax, typing, handles, offsets, depth)
        }
    }

    machine array(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9], depth: u64 in Trapping, offset: u64 in Trapping, row: |typed_trees|::TypeRow) -> bool {
        transition depth < 8 {
            true -> element(syntax, typing, handles, offsets, depth, offset, row),
            _ -> answer(true)
        }
    }

    machine element(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9], depth: u64 in Trapping, offset: u64 in Trapping, row: |typed_trees|::TypeRow) -> bool
    requires depth < 8
    {
        transition offset == 0 {
            true -> descend(syntax, typing, handles, offsets, depth, offset, row.inner),
            _ -> finished(syntax, typing, handles, offsets, depth)
        }
    }

    machine data(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9], depth: u64 in Trapping, offset: u64 in Trapping, row: |typed_trees|::TypeRow) -> bool {
        let item: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, row.item);
        transition depth < 8 {
            true -> field(syntax, typing, handles, offsets, depth, offset, row, item),
            _ -> answer(true)
        }
    }

    machine field(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9], depth: u64 in Trapping, offset: u64 in Trapping, row: |typed_trees|::TypeRow, item: |syntax_trees|::DataItem) -> bool
    requires depth < 8
    {
        transition offset < item.field_count {
            true -> field_type(syntax, typing, handles, offsets, depth, offset, item),
            _ -> argument(syntax, typing, handles, offsets, depth, offset, row, item.field_count)
        }
    }

    machine field_type(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9], depth: u64 in Trapping, offset: u64 in Trapping, item: |syntax_trees|::DataItem) -> bool
    requires depth < 8
    {
        let field: |syntax_trees|::DataField = |syntax_trees|::syntax_trees_field(syntax, item.first_field + offset);
        let handle: u64 in Trapping = |typed_trees|::reference_type(typing, field.type_reference);
        transition { _ -> descend(syntax, typing, handles, offsets, depth, offset, handle) }
    }

    machine argument(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9], depth: u64 in Trapping, offset: u64 in Trapping, row: |typed_trees|::TypeRow, fields: u64 in Trapping) -> bool
    requires depth < 8
    {
        let argument: u64 in Trapping = offset - fields;
        transition argument < row.argument_count {
            true -> argument_type(syntax, typing, handles, offsets, depth, offset, row, argument),
            _ -> finished(syntax, typing, handles, offsets, depth)
        }
    }

    machine argument_type(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9], depth: u64 in Trapping, offset: u64 in Trapping, row: |typed_trees|::TypeRow, argument: u64 in Trapping) -> bool
    requires depth < 8
    {
        let handle: u64 in Trapping = |typed_trees|::type_table_argument(@typing.types, row.first_argument + argument);
        transition { _ -> descend(syntax, typing, handles, offsets, depth, offset, handle) }
    }

    machine descend(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9], depth: u64 in Trapping, offset: u64 in Trapping, handle: u64 in Trapping) -> bool
    requires depth < 8
    {
        let index: u64 = depth as -Trapping;
        let next_depth: u64 in Trapping = depth + 1;
        let next_index: u64 = next_depth as -Trapping;
        offsets[index] = offset + 1;
        handles[next_index] = handle;
        offsets[next_index] = 0 as +Trapping;
        transition { _ -> visit(syntax, typing, handles, offsets, next_depth) }
    }

    machine finished(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handles: @mutable [u64 in Trapping; 9], offsets: @mutable [u64 in Trapping; 9], depth: u64 in Trapping) -> bool
    requires depth < 9
    {
        transition depth > 0 {
            true -> visit(syntax, typing, handles, offsets, depth - 1),
            _ -> answer(false)
        }
    }

    machine answer(holds: bool) -> bool {
        holds
    }
}

// An access to a place while loans last: one overlapping a live loan's place,
// not through its holder, conflicts when the loan is exclusive or the access
// writes, moves or lends exclusively.
public machine loan_access(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, excludes: bool)
crashes Trap
{
    let root: u64 in Trapping = |owned_places|::path_root(syntax, resolution, typing, handle, true);
    transition root > 0 && checker.ownership.loan_count > 0 {
        true -> next(checker, syntax, resolution, typing, handle, excludes, root, 0 as +Trapping),
        _ -> done()
    }

    machine next(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        excludes: bool,
        root: u64 in Trapping,
        index: u64 in Trapping
    ) {
        transition index < checker.ownership.loan_count && checker.output.machine_accepted {
            true -> loan(checker, syntax, resolution, typing, handle, excludes, root, index),
            _ -> done()
        }
    }

    machine loan(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        excludes: bool,
        root: u64 in Trapping,
        index: u64 in Trapping
    ) {
        let holder: u64 in Trapping = ownership_loan_holder(@checker.ownership, index);
        let live: bool = loan_live(@checker.ownership, holder);
        transition live && holder != root {
            true -> overlap(checker, syntax, resolution, typing, handle, excludes, root, index),
            _ -> next(checker, syntax, resolution, typing, handle, excludes, root, index + 1)
        }
    }

    machine overlap(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        excludes: bool,
        root: u64 in Trapping,
        index: u64 in Trapping
    ) {
        let place: u64 in Trapping = loan_place(@checker.ownership, index);
        let exclusive: bool = loan_exclusive(@checker.ownership, index);
        let relation: |owned_places|::PlaceRelation = |owned_places|::path_relation(syntax, resolution, typing, handle, place, true);
        let conflict: bool = relation != |owned_places|::PlaceRelation::Apart && (exclusive || excludes);
        transition conflict {
            true -> rejected(checker, syntax, handle),
            _ -> next(checker, syntax, resolution, typing, handle, excludes, root, index + 1)
        }
    }

    machine rejected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::LoanConflict, expression.source_span);
    }

    machine done() {}
}

// An exit's value may not lend a place the body owns, nor be a holder of
// such a loan.
public machine own_escape(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping)
crashes Trap
{
    let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, root);
    let referencing: bool = holds_references(syntax, typing, type_handle);
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    transition referencing && tree.first_row <= root {
        true -> node(checker, syntax, resolution, typing, root, tree.first_row),
        _ -> done()
    }

    machine node(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping, handle: u64 in Trapping) {
        transition handle <= root && checker.output.machine_accepted {
            true -> lends(checker, syntax, resolution, typing, root, handle),
            _ -> done()
        }
    }

    machine lends(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping, handle: u64 in Trapping) {
        let carrier: u64 in Trapping = carrier_root(checker, syntax, resolution, typing, handle);
        let backed: bool = carrier_owns_loan(checker, carrier);
        transition backed {
            true -> escaped(checker, syntax, handle),
            _ -> lent(checker, syntax, resolution, typing, root, handle)
        }
    }

    machine lent(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping, handle: u64 in Trapping) {
        let hold: |holds|::Hold = lent_place(checker, syntax, typing, handle);
        transition hold {
            |holds|::Hold::Shared { place } -> owned(checker, syntax, resolution, typing, root, handle, place),
            |holds|::Hold::Exclusive { place } -> owned(checker, syntax, resolution, typing, root, handle, place),
            _ -> node(checker, syntax, resolution, typing, root, handle + 1)
        }
    }

    // A lent place the body owns, or a holder whose loans a body place
    // backs, would outlive its storage.
    machine owned(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        handle: u64 in Trapping,
        place: u64 in Trapping
    ) {
        let owner: u64 in Trapping = |owned_places|::place_root(syntax, resolution, typing, place);
        let backed: bool = holds_owned_loan(checker, syntax, resolution, typing, place);
        let borrowed: bool = lends_owned(syntax, typing, handle, owner);
        transition borrowed || backed {
            true -> escaped(checker, syntax, handle),
            _ -> node(checker, syntax, resolution, typing, root, handle + 1)
        }
    }

    machine escaped(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::LoanEscapes, expression.source_span);
    }

    machine done() {}
}

// Whether a lending node borrows storage the body owns: a borrow or range
// slice of an owned place. A reference passed on whole lends its referent,
// which the body does not own. Reference policy views keep the lending
// node's provenance; the outer cast cannot turn an owned borrow into a
// reference that merely passes through the body.
machine lends_owned(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping, owner: u64 in Trapping) -> bool
crashes Trap
{
    let origin: u64 in Trapping = |typed_trees|::reference_cast_source(syntax, typing, handle);
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, origin);
    let borrow: bool = expression.kind == |syntax_trees|::ExpressionKind::Unary;
    let slice: bool = expression.kind == |syntax_trees|::ExpressionKind::Index;
    transition owner > 0 && (borrow || slice) {
        true -> answer(true),
        _ -> answer(false)
    }

    machine answer(lends: bool) -> bool {
        lends
    }
}

// Whether a place names a holder local whose loans borrow storage the
// body owns.
machine holds_owned_loan(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, place: u64 in Trapping) -> bool
crashes Trap
{
    let holder: u64 in Trapping = |owned_places|::path_root(syntax, resolution, typing, place, true);
    let owned: bool = carrier_owns_loan(checker, holder);
    owned
}

machine carrier_owns_loan(checker: @|checker|::Checker, holder: u64 in Trapping) -> bool
crashes Trap
{
    transition holder > 0 {
        true -> next(checker, holder, 0 as +Trapping),
        _ -> answer(false)
    }

    machine next(checker: @|checker|::Checker, holder: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < checker.ownership.loan_count {
            true -> loan(checker, holder, index),
            _ -> answer(false)
        }
    }

    machine loan(checker: @|checker|::Checker, holder: u64 in Trapping, index: u64 in Trapping) -> bool {
        let loan_holder: u64 in Trapping = ownership_loan_holder(@checker.ownership, index);
        let owned: bool = loan_owned(@checker.ownership, index);
        transition loan_holder == holder && owned {
            true -> answer(true),
            _ -> next(checker, holder, index + 1)
        }
    }

    machine answer(holds: bool) -> bool {
        holds
    }
}

// Record that local `key` is used at statement `index`; statements are
// scanned in order, so the last record is its last use.
public machine use_local(ownership: @mutable |ownership|::Ownership, key: u64 in Trapping, index: u64 in Trapping) -> bool
crashes Trap
{
    let slot: u64 in Trapping = use_slot(ownership, key);
    let count: u64 = ownership.use_count;
    transition slot > 0 {
        true -> update(ownership, slot - 1, index),
        _ -> add(ownership, key, index, count)
    }

    machine update(ownership: @mutable |ownership|::Ownership, slot: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition slot < 128 {
            true -> write(ownership, slot, index),
            _ -> full()
        }
    }

    machine write(ownership: @mutable |ownership|::Ownership, slot: u64 in Trapping, index: u64 in Trapping) -> bool
    requires slot < 128
    {
        ownership.use_last[slot as -Trapping] = index as -Trapping;
        true
    }

    // Forgetting a local would make its loan appear to expire before its last use.
    machine add(ownership: @mutable |ownership|::Ownership, key: u64 in Trapping, index: u64 in Trapping, count: u64) -> bool {
        transition count < 128 {
            true -> append(ownership, key, index, count),
            _ -> full()
        }
    }

    machine append(ownership: @mutable |ownership|::Ownership, key: u64 in Trapping, index: u64 in Trapping, count: u64) -> bool
    requires count < 128
    {
        ownership.use_locals[count] = key as -Trapping;
        ownership.use_last[count] = index as -Trapping;
        ownership.use_count = count + 1;
        true
    }

    machine full() -> bool { false }
}

// Where local `key` sits in the use table, plus one; zero when absent.
public machine use_slot(ownership: @|ownership|::Ownership, key: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(ownership, key, 0 as +Trapping) }

    machine next(ownership: @|ownership|::Ownership, key: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        transition (index as -Trapping) < ownership.use_count && index < 128 {
            true -> entry(ownership, key, index),
            _ -> answer(0 as +Trapping)
        }
    }

    machine entry(ownership: @|ownership|::Ownership, key: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping
    requires index < 128
    {
        let local: u64 = ownership.use_locals[index as -Trapping];
        transition local == (key as -Trapping) {
            true -> answer(index + 1),
            _ -> next(ownership, key, index + 1)
        }
    }

    machine answer(slot: u64 in Trapping) -> u64 in Trapping {
        slot
    }
}

// Local `key`'s last use; zero when it has none recorded.
public machine last_use(ownership: @|ownership|::Ownership, key: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let slot: u64 in Trapping = use_slot(ownership, key);
    transition slot > 0 && slot <= 128 {
        true -> read(ownership, slot - 1),
        _ -> answer(0 as +Trapping)
    }

    machine read(ownership: @|ownership|::Ownership, index: u64 in Trapping) -> u64 in Trapping {
        transition index < 128 {
            true -> indexed(ownership, index),
            _ -> answer(0 as +Trapping)
        }
    }

    machine indexed(ownership: @|ownership|::Ownership, index: u64 in Trapping) -> u64 in Trapping
    requires index < 128
    {
        let last: u64 = ownership.use_last[index as -Trapping];
        let counted: u64 in Trapping = last as u64 +Trapping;
        transition { _ -> answer(counted) }
    }

    machine answer(last: u64 in Trapping) -> u64 in Trapping {
        last
    }
}

// A holder `lender` lent to `holder` lives at least as long as it.
public machine extend_uses(ownership: @mutable |ownership|::Ownership, lender: u64 in Trapping, holder: u64 in Trapping)
crashes Trap
{
    let lender_last: u64 in Trapping = last_use(ownership, lender);
    let holder_last: u64 in Trapping = last_use(ownership, holder);
    let slot: u64 in Trapping = use_slot(ownership, lender);
    transition slot > 0 && holder_last > lender_last {
        true -> extended(ownership, slot - 1, holder_last),
        _ -> done()
    }

    machine extended(ownership: @mutable |ownership|::Ownership, slot: u64 in Trapping, last: u64 in Trapping) {
        transition slot < 128 {
            true -> write(ownership, slot, last),
            _ -> done()
        }
    }

    machine write(ownership: @mutable |ownership|::Ownership, slot: u64 in Trapping, last: u64 in Trapping)
    requires slot < 128
    {
        ownership.use_last[slot as -Trapping] = last as u64;
    }

    machine done() {}
}

// Record a loan; false when the table is full.
public machine add_loan(ownership: @mutable |ownership|::Ownership, holder: u64 in Trapping, place: u64 in Trapping, exclusive: bool, owned: bool) -> bool
crashes Trap
{
    let loan_count: u64 = ownership.loan_count;
    transition loan_count < 64 {
        true -> write(ownership, holder, place, exclusive, owned, loan_count),
        _ -> full()
    }

    machine write(ownership: @mutable |ownership|::Ownership, holder: u64 in Trapping, place: u64 in Trapping, exclusive: bool, owned: bool, index: u64) -> bool
    requires index < 64
    {
        ownership.loan_holders[index] = holder as u64;
        ownership.loan_places[index] = place as u64;
        ownership.loan_exclusive[index] = exclusive;
        ownership.loan_owned[index] = owned;
        ownership.loan_count = index + 1;
        true
    }

    machine full() -> bool {
        false
    }
}

// Whether a holder's loans last through the statement being walked.
public machine loan_live(ownership: @|ownership|::Ownership, holder: u64 in Trapping) -> bool
crashes Trap
{
    let last: u64 in Trapping = last_use(ownership, holder);
    let live: bool = last >= ownership.statement;
    transition { _ -> answer(live) }

    machine answer(live: bool) -> bool {
        live
    }
}

public machine ownership_loan_holder(ownership: @|ownership|::Ownership, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < 64 {
        true -> read(ownership, index),
        _ -> invalid()
    }

    machine read(ownership: @|ownership|::Ownership, index: u64 in Trapping) -> u64 in Trapping
    requires index < 64
    {
        let holder: u64 = ownership.loan_holders[index as -Trapping];
        holder as u64 +Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

public machine loan_place(ownership: @|ownership|::Ownership, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < 64 {
        true -> read(ownership, index),
        _ -> invalid()
    }

    machine read(ownership: @|ownership|::Ownership, index: u64 in Trapping) -> u64 in Trapping
    requires index < 64
    {
        let place: u64 = ownership.loan_places[index as -Trapping];
        place as u64 +Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

public machine loan_exclusive(ownership: @|ownership|::Ownership, index: u64 in Trapping) -> bool
crashes Trap
{
    transition index < 64 {
        true -> read(ownership, index),
        _ -> invalid()
    }

    machine read(ownership: @|ownership|::Ownership, index: u64 in Trapping) -> bool
    requires index < 64
    {
        ownership.loan_exclusive[index as -Trapping]
    }

    machine invalid() -> bool {
        crash Trap;
    }
}

public machine loan_owned(ownership: @|ownership|::Ownership, index: u64 in Trapping) -> bool
crashes Trap
{
    transition index < 64 {
        true -> read(ownership, index),
        _ -> invalid()
    }

    machine read(ownership: @|ownership|::Ownership, index: u64 in Trapping) -> bool
    requires index < 64
    {
        ownership.loan_owned[index as -Trapping]
    }

    machine invalid() -> bool {
        crash Trap;
    }
}

// Whether an access excludes others: an exclusive loan, an exclusive
// reference passed on rather than read, or a move.
public machine access_excludes(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping, role: |ownership|::UseRole) -> bool
crashes Trap
{
    transition role {
        |ownership|::UseRole::Exclusive -> answer(true),
        |ownership|::UseRole::WriteLend -> answer(true),
        |ownership|::UseRole::Value -> taken(syntax, typing, handle),
        _ -> answer(false)
    }

    machine taken(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping) -> bool {
        let node_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, node_type);
        let adaptation: |typed_trees|::Adaptation = |typed_trees|::typing_adaptation(typing, handle);
        let multiplicity: |syntax_trees|::DataMultiplicity = |owned_places|::checker_multiplicity(syntax, typing, node_type);
        let exclusive: bool = row.kind == |typed_trees|::TypeKind::Reference && row.access != |syntax_trees|::ReferenceAccess::Shared
            && adaptation != |typed_trees|::Adaptation::Read;
        let moves: bool = multiplicity != |syntax_trees|::DataMultiplicity::Unrestricted;
        let excludes: bool = exclusive || moves;
        transition { _ -> answer(excludes) }
    }

    machine answer(excludes: bool) -> bool {
        excludes
    }
}
