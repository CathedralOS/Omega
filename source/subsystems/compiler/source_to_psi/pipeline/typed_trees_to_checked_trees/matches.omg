use pipeline/typed_trees_to_checked_trees/flow.omg;
use pipeline/typed_trees_to_checked_trees/qualification.omg;
use pipeline/typed_trees_to_checked_trees/zone.omg;
use pipeline/typed_trees_to_checked_trees/aliases.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;

use representations/checks/checks.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Value-position matches inside an evaluated tree
// (wiki/spec/language/patterns.md). A match evaluates its subject once; each
// arm then runs on the facts after the subject, assuming its own pattern
// selected and every earlier pattern passed over (`arm_facts`, as
// a transition's arms do); the facts after the match are the join of its
// arms' ends, and its value the hull of its arms' values. A tree evaluates
// in handle order, so a match's events fire as evaluation reaches them: as
// an arm begins (its pattern's first node, or its value's for `_`) and as
// its value begins, then at the match node itself. A match keeps two saved
// zones owned by its handle plus one: below, the join of the arms that have
// ended, unreached until the first does; above, the facts the next arm
// starts from. A match whose events the checker cannot track rejects as
// exceeding its capacity rather than letting its arms run on one another's
// facts.

// Record a match the tree's scan met, its first event pending.
public machine checker_add_match(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping)
crashes Trap
{
    let match_count: u64 = checker.match_count;
    transition match_count < 16 {
        true -> write(checker, match_count, handle),
        _ -> full(checker, syntax, handle)
    }

    machine write(checker: @mutable |checker|::Checker, index: u64, handle: u64 in Trapping)
    requires index < 16
    {
        checker.matches[index] = handle as u64;
        checker.match_events[index] = 0;
        checker.match_count = index + 1;
    }

    machine full(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }
}

// Fire every match event that begins at `handle`: an enclosing match's
// before a nested one's, whose handle is lower.
public machine advance_matches(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    handle: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let match_count: u64 = checker.match_count;
    transition { _ -> next(checker, syntax, resolution, typing, handle, match_count, checking) }

    machine next(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        remaining: u64,
        checking: bool
    ) {
        transition remaining > 0 && remaining <= 16 {
            true -> record(checker, syntax, resolution, typing, handle, remaining - 1, checking),
            _ -> done()
        }
    }

    machine record(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        index: u64,
        checking: bool
    )
    requires index < 16
    {
        let match_handle: u64 = checker.matches[index];
        let event: u64 = checker.match_events[index];
        fire_events(checker, syntax, resolution, typing, handle, match_handle as u64 +Trapping, index, event as u64 +Trapping, checking);
        transition { _ -> next(checker, syntax, resolution, typing, handle, index, checking) }
    }

    machine done() {}
}

// Fire the events of the match at `match_handle` that begin at `handle`,
// from `event`, and keep the next one pending.
machine fire_events(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    handle: u64 in Trapping,
    match_handle: u64 in Trapping,
    index: u64,
    event: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, match_handle);
    transition { _ -> pending(checker, syntax, resolution, typing, handle, match_handle, expression, index, event, checking) }

    machine pending(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        match_handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        index: u64,
        event: u64 in Trapping,
        checking: bool
    ) {
        let begins: u64 in Trapping = event_handle(syntax, expression, event);
        transition begins == handle {
            true -> fire(checker, syntax, resolution, typing, handle, match_handle, expression, index, event, checking),
            _ -> keep(checker, index, event)
        }
    }

    machine fire(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        match_handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        index: u64,
        event: u64 in Trapping,
        checking: bool
    ) {
        match_event(checker, syntax, resolution, typing, match_handle, expression, event, checking);
        transition { _ -> pending(checker, syntax, resolution, typing, handle, match_handle, expression, index, event + 1, checking) }
    }

    machine keep(checker: @mutable |checker|::Checker, index: u64, event: u64 in Trapping) {
        transition index < 16 {
            true -> write(checker, index, event),
            _ -> done()
        }
    }

    machine write(checker: @mutable |checker|::Checker, index: u64, event: u64 in Trapping)
    requires index < 16
    {
        checker.match_events[index] = event as u64;
    }

    machine done() {}
}

// Where a match's event `event` begins: arm `event / 2`'s pattern for an
// even event (its value for `_`), the arm's value for an odd one. Past its
// arms, no node begins one.
machine event_handle(syntax: @|syntax_trees|::SyntaxTrees, expression: |syntax_trees|::Expression, event: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let offset: u64 in Trapping = event / 2;
    let valued: bool = event % 2 == 1;
    transition offset < expression.count {
        true -> arm(syntax, expression, offset, valued),
        _ -> at(18446744073709551615 as +Trapping)
    }

    machine arm(syntax: @|syntax_trees|::SyntaxTrees, expression: |syntax_trees|::Expression, offset: u64 in Trapping, valued: bool) -> u64 in Trapping {
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_match_arm(syntax, expression.first + offset);
        let value: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.target);
        transition valued || arm.kind == |syntax_trees|::ArmPatternKind::Wildcard || arm.kind == |syntax_trees|::ArmPatternKind::Binder {
            true -> at(value.first_row),
            _ -> pattern(syntax, arm)
        }
    }

    machine pattern(syntax: @|syntax_trees|::SyntaxTrees, arm: |syntax_trees|::TransitionArm) -> u64 in Trapping {
        let pattern: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.pattern);
        transition { _ -> at(pattern.first_row) }
    }

    machine at(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

// One event of a match: its first arm saves the arms' join, unreached, and
// the facts after the subject; each later arm ends the one before and
// starts from those facts with the earlier pattern passed over; an arm's
// value begins with its own pattern selected.
machine match_event(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    match_handle: u64 in Trapping,
    expression: |syntax_trees|::Expression,
    event: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let offset: u64 in Trapping = event / 2;
    let valued: bool = event % 2 == 1;
    let held: bool = holds_match(checker, match_handle);
    transition valued {
        true -> selected(checker, syntax, resolution, typing, expression, offset, held),
        _ -> begun(checker, syntax, resolution, typing, match_handle, expression, offset, held, checking)
    }

    machine begun(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        match_handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        offset: u64 in Trapping,
        held: bool,
        checking: bool
    ) {
        transition offset == 0 {
            true -> opened(checker, match_handle, expression),
            _ -> following(checker, syntax, resolution, typing, match_handle, expression, offset, held, checking)
        }
    }

    machine opened(checker: @mutable |checker|::Checker, match_handle: u64 in Trapping, expression: |syntax_trees|::Expression) {
        let joined: bool = |flow|::save_zone(checker, match_handle + 1);
        transition joined {
            true -> unreached(checker, match_handle, expression),
            _ -> overflow(checker, expression)
        }
    }

    machine unreached(checker: @mutable |checker|::Checker, match_handle: u64 in Trapping, expression: |syntax_trees|::Expression) {
        unreach_saved(checker);
        let saved: bool = |flow|::save_zone(checker, match_handle + 1);
        transition saved {
            true -> done(),
            _ -> half_saved(checker, expression)
        }
    }

    // Only the join was saved: drop it, so no later arm or join meets it.
    machine half_saved(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression) {
        |flow|::drop_saved(checker);
        transition { _ -> overflow(checker, expression) }
    }

    machine following(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        match_handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        offset: u64 in Trapping,
        held: bool,
        checking: bool
    ) {
        transition held {
            true -> passed_over(checker, syntax, resolution, typing, match_handle, expression, offset - 1, checking),
            _ -> done()
        }
    }

    machine passed_over(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        match_handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        previous: u64 in Trapping,
        checking: bool
    ) {
        end_arm(checker, syntax, resolution, typing, match_handle, expression, previous, checking);
        |flow|::restore_zone(checker);
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_match_arm(syntax, expression.first + previous);
        let pattern: |evaluation|::Value = checker_pattern_value(checker, arm);
        |flow|::arm_facts(checker, syntax, resolution, typing, expression.left, pattern, arm, false);
        |flow|::resave_zone(checker);
    }

    machine selected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, offset: u64 in Trapping, held: bool) {
        transition held {
            true -> chosen(checker, syntax, resolution, typing, expression, offset),
            _ -> done()
        }
    }

    machine chosen(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, offset: u64 in Trapping) {
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_match_arm(syntax, expression.first + offset);
        let pattern: |evaluation|::Value = checker_pattern_value(checker, arm);
        |flow|::arm_facts(checker, syntax, resolution, typing, expression.left, pattern, arm, true);
    }

    machine overflow(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }

    machine done() {}
}

// A pattern's value, already evaluated; unknown for `_`.
machine checker_pattern_value(checker: @|checker|::Checker, arm: |syntax_trees|::TransitionArm) -> |evaluation|::Value
crashes Trap
{
    transition arm.kind == |syntax_trees|::ArmPatternKind::Literal || arm.kind == |syntax_trees|::ArmPatternKind::Case {
        true -> literal(checker, arm),
        _ -> unknown()
    }

    machine literal(checker: @|checker|::Checker, arm: |syntax_trees|::TransitionArm) -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_at(checker, arm.pattern);
        value
    }

    machine unknown() -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        value
    }
}

// The match node: its last arm ends, the facts after it are its arms'
// join, and its value is already their hull. A match the checker could not
// track has already been rejected; its value is its type's.
public machine close_match(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, checking: bool)
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
    let held: bool = holds_match(checker, handle);
    transition held {
        true -> closed(checker, syntax, resolution, typing, handle, expression, checking),
        _ -> untracked(checker, typing, handle)
    }

    machine closed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, checking: bool) {
        end_arm(checker, syntax, resolution, typing, handle, expression, expression.count - 1, checking);
        checker_take_join(checker);
    }

    machine untracked(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping) {
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
        let value: |evaluation|::Value = |evaluation|::value_typed(row);
        |evaluation|::checker_set_value(checker, handle, value);
    }
}

// An arm's value ends: a value landed at a qualified match type meets the
// qualification, its facts join the arms that have ended, and its interval
// widens the match's value.
machine end_arm(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    match_handle: u64 in Trapping,
    expression: |syntax_trees|::Expression,
    offset: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_match_arm(syntax, expression.first + offset);
    let value: |evaluation|::Value = |evaluation|::value_at(checker, arm.target);
    transition checking {
        true -> qualified(checker, syntax, resolution, typing, match_handle, offset, arm, value),
        _ -> joined(checker, match_handle, offset, value)
    }

    machine qualified(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        match_handle: u64 in Trapping,
        offset: u64 in Trapping,
        arm: |syntax_trees|::TransitionArm,
        value: |evaluation|::Value
    ) {
        let match_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, match_handle);
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.target);
        |qualification|::require_qualification(checker, syntax, resolution, typing, match_type, arm.target, value, written.source_span);
        transition { _ -> joined(checker, match_handle, offset, value) }
    }

    machine joined(checker: @mutable |checker|::Checker, match_handle: u64 in Trapping, offset: u64 in Trapping, value: |evaluation|::Value) {
        join_arms(checker);
        transition offset == 0 {
            true -> first(checker, match_handle, value),
            _ -> widened(checker, match_handle, value)
        }
    }

    machine first(checker: @mutable |checker|::Checker, match_handle: u64 in Trapping, value: |evaluation|::Value) {
        let interval: |evaluation|::Value = |evaluation|::value_interval(value);
        |evaluation|::checker_set_value(checker, match_handle, interval);
    }

    machine widened(checker: @mutable |checker|::Checker, match_handle: u64 in Trapping, value: |evaluation|::Value) {
        let so_far: |evaluation|::Value = |evaluation|::value_at(checker, match_handle);
        let hull: |evaluation|::Value = |evaluation|::value_hull(so_far, value);
        |evaluation|::checker_set_value(checker, match_handle, hull);
    }
}

// Whether the two top saved zones are the match's.
machine holds_match(checker: @|checker|::Checker, match_handle: u64 in Trapping) -> bool
crashes Trap
{
    transition checker.saved_count >= 2 && checker.saved_count <= 8 {
        true -> owners(checker, match_handle, checker.saved_count - 2),
        _ -> answer(false)
    }

    machine owners(checker: @|checker|::Checker, match_handle: u64 in Trapping, below: u64) -> bool
    requires below < 7
    {
        let join: u64 = checker.saved_owners[below];
        let start: u64 = checker.saved_owners[below + 1];
        let held: bool = join == match_handle + 1 && start == match_handle + 1;
        transition { _ -> answer(held) }
    }

    machine answer(held: bool) -> bool {
        held
    }
}

// Mark the top saved zone unreached: the join of no arms.
machine unreach_saved(checker: @mutable |checker|::Checker)
crashes Trap
{
    let saved_count: u64 = checker.saved_count;
    transition saved_count > 0 && saved_count <= 8 {
        true -> mark(checker, saved_count - 1),
        _ -> invalid()
    }

    machine mark(checker: @mutable |checker|::Checker, index: u64)
    requires index < 8
    {
        checker.merged = checker.saved[index];
        checker.merged.infeasible = true;
        checker.saved[index] = checker.merged;
    }

    machine invalid() {
        crash Trap;
    }
}

// Join the zone into the match's arms so far, the saved zone below the top.
machine join_arms(checker: @mutable |checker|::Checker)
crashes Trap
{
    let saved_count: u64 = checker.saved_count;
    transition saved_count >= 2 && saved_count <= 8 {
        true -> join(checker, saved_count - 2),
        _ -> invalid()
    }

    machine join(checker: @mutable |checker|::Checker, index: u64)
    requires index < 8
    {
        checker.merged = checker.saved[index];
        let current_live: bool = !checker.merged.infeasible;
        let other_live: bool = !checker.zone.infeasible;
        let mutable aliases: |aliases|::AliasTable = checker.saved_aliases[index];
        let other: |aliases|::AliasTable = checker.aliases;
        |aliases|::alias_table_join(@mutable aliases, @other, current_live, other_live);
        checker.saved_aliases[index] = aliases;
        let changed: bool = |zone|::zone_join(@mutable checker.merged, @checker.zone);
        checker.saved[index] = checker.merged;
    }

    machine invalid() {
        crash Trap;
    }
}

// The facts after the match: its arms' join, both its saved zones dropped.
machine checker_take_join(checker: @mutable |checker|::Checker)
crashes Trap
{
    let saved_count: u64 = checker.saved_count;
    transition saved_count >= 2 && saved_count <= 8 {
        true -> take(checker, saved_count - 2),
        _ -> invalid()
    }

    machine take(checker: @mutable |checker|::Checker, index: u64)
    requires index < 8
    {
        checker.zone = checker.saved[index];
        checker.aliases = checker.saved_aliases[index];
        checker.saved_count = index;
    }

    machine invalid() {
        crash Trap;
    }
}
