use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;
use pipeline/typed_trees_to_checked_trees/zone.omg;

use foundation/integers.omg;
use representations/checks/checks.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Fixed-integer operators and conversions
// (wiki/spec/language/numeric_values.md). An operation's policy is its
// result type's qualifier: an unqualified (Exact) result must fit its
// carrier, Wrapping and Saturating results are total, and a Trapping
// operation that may leave its carrier is a `Trap` crash site
// (#overflow-policies). A divisor is nonzero under every policy but
// Trapping, where zero is the trap (#integer-quotient-and-remainder); a
// shift count lies below the width unless Wrapping reduces it or Trapping
// traps (#shift-counts).

// The value of a binary operator whose result is a fixed integer.
public machine binary_value(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) -> |evaluation|::Value
crashes Trap
{
    let left: |evaluation|::Value = |evaluation|::value_at(checker, expression.left);
    let right: |evaluation|::Value = |evaluation|::value_at(checker, expression.right);
    transition expression.operator {
        |syntax_trees|::OperatorKind::Add -> add(checker, expression, row, left, right, checking),
        |syntax_trees|::OperatorKind::Subtract -> subtract(checker, expression, row, left, right, checking),
        |syntax_trees|::OperatorKind::Multiply -> multiply(checker, expression, row, left, right, checking),
        |syntax_trees|::OperatorKind::Divide -> divide(checker, expression, row, left, right, checking),
        |syntax_trees|::OperatorKind::Modulo -> modulo(checker, expression, row, left, right, checking),
        |syntax_trees|::OperatorKind::BitAnd -> bitwise(row, left, right),
        |syntax_trees|::OperatorKind::ShiftLeft -> shift(checker, expression, row, left, right, false, checking),
        |syntax_trees|::OperatorKind::ShiftRight -> shift(checker, expression, row, left, right, true, checking),
        _ -> carrier(row)
    }

    machine add(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, left: |evaluation|::Value, right: |evaluation|::Value, checking: bool) -> |evaluation|::Value {
        let interval: |evaluation|::Value = |evaluation|::value_sum(left, right);
        let linear: |evaluation|::Value = |evaluation|::offset_sum(left, right, interval);
        let result: |evaluation|::Value = policy_result(checker, expression, row, linear, |checks|::CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    // A difference also uses the zone's relation between its operands.
    machine subtract(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, left: |evaluation|::Value, right: |evaluation|::Value, checking: bool) -> |evaluation|::Value {
        let interval: |evaluation|::Value = |evaluation|::value_difference(left, right);
        let above: |zone|::Bound = |evaluation|::difference_bound(checker, right, left);
        let below: |zone|::Bound = |evaluation|::difference_bound(checker, left, right);
        let ceiling_tighter: bool = |zone|::bound_at_most(above, interval.ceiling);
        let floor_tighter: bool = |zone|::bound_at_most(below, interval.floor);
        let ceiling: |zone|::Bound = |evaluation|::pick(ceiling_tighter, above, interval.ceiling);
        let floor: |zone|::Bound = |evaluation|::pick(floor_tighter, below, interval.floor);
        let related: |evaluation|::Value = |evaluation|::Value { place: 0 as +Trapping, known: false, subject: 0 as +Trapping, offset: interval.offset, ceiling: ceiling, floor: floor };
        let linear: |evaluation|::Value = |evaluation|::offset_difference(left, right, related);
        let result: |evaluation|::Value = policy_result(checker, expression, row, linear, |checks|::CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    machine multiply(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, left: |evaluation|::Value, right: |evaluation|::Value, checking: bool) -> |evaluation|::Value {
        let interval: |evaluation|::Value = |evaluation|::value_product(left, right);
        let result: |evaluation|::Value = policy_result(checker, expression, row, interval, |checks|::CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    machine divide(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, left: |evaluation|::Value, right: |evaluation|::Value, checking: bool) -> |evaluation|::Value {
        let interval: |evaluation|::Value = |evaluation|::value_quotient(left, right);
        require_divisor(checker, expression, row, right, checking);
        let result: |evaluation|::Value = policy_result(checker, expression, row, interval, |checks|::CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    machine modulo(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, left: |evaluation|::Value, right: |evaluation|::Value, checking: bool) -> |evaluation|::Value {
        let interval: |evaluation|::Value = |evaluation|::value_remainder(left, right);
        require_divisor(checker, expression, row, right, checking);
        let result: |evaluation|::Value = policy_result(checker, expression, row, interval, |checks|::CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    // A bitwise AND of nonnegative values stays below either operand; other
    // bitwise operators are total over the carrier.
    machine bitwise(row: |typed_trees|::TypeRow, left: |evaluation|::Value, right: |evaluation|::Value) -> |evaluation|::Value {
        let interval: |evaluation|::Value = |evaluation|::value_conjunction(left, right);
        let clamped: |evaluation|::Value = |evaluation|::value_clamped(interval, row.builtin);
        clamped
    }

    machine shift(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, left: |evaluation|::Value, right: |evaluation|::Value, rightward: bool, checking: bool) -> |evaluation|::Value {
        require_shift_count(checker, expression, row, right, checking);
        transition rightward {
            true -> shifted_right(checker, expression, row, left, right, checking),
            _ -> shifted_left(checker, expression, row, checking)
        }
    }

    // A right shift stays below its operand.
    machine shifted_right(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, left: |evaluation|::Value, right: |evaluation|::Value, checking: bool) -> |evaluation|::Value {
        let narrowed: |evaluation|::Value = |evaluation|::value_shifted_right(left, right);
        let result: |evaluation|::Value = policy_result(checker, expression, row, narrowed, |checks|::CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    // A left shift is bounded only by its carrier: an Exact one would need a
    // proof this slice does not make.
    machine shifted_left(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) -> |evaluation|::Value {
        let unknown: |evaluation|::Value = |evaluation|::value_unknown();
        let result: |evaluation|::Value = policy_result(checker, expression, row, unknown, |checks|::CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }

    machine carrier(row: |typed_trees|::TypeRow) -> |evaluation|::Value {
        let range: |evaluation|::Value = |evaluation|::value_carrier(row.builtin);
        range
    }
}

// The value of a negation whose result is a fixed integer.
public machine negation_value(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) -> |evaluation|::Value
crashes Trap
{
    let operand: |evaluation|::Value = |evaluation|::value_at(checker, expression.left);
    let constant: bool = |evaluation|::is_constant(operand);
    transition constant {
        true -> folded(operand),
        _ -> negated(checker, expression, row, operand, checking)
    }

    machine folded(operand: |evaluation|::Value) -> |evaluation|::Value {
        let negated: |integers|::ExactInteger = |integers|::exact_integer_negate(operand.offset);
        let value: |evaluation|::Value = |evaluation|::value_constant(negated);
        value
    }

    machine negated(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, operand: |evaluation|::Value, checking: bool) -> |evaluation|::Value {
        let interval: |evaluation|::Value = |evaluation|::value_negation(operand);
        let result: |evaluation|::Value = policy_result(checker, expression, row, interval, |checks|::CheckDiagnosticCode::ArithmeticOverflow, checking);
        result
    }
}

// `value as Target` for a fixed-integer target never changes the denoted
// value (wiki/spec/language/domains.md#exact-coercion-and-erasure): there is
// no hidden wrapping, saturation or trapping in `as`, whatever the target's
// policy, which governs only the target's later operations. The value must
// fit the target carrier, and keeps its term. A Boolean converts to zero or
// one.
public machine conversion_value(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) -> |evaluation|::Value
crashes Trap
{
    let source: |evaluation|::Value = |evaluation|::value_at(checker, expression.left);
    let source_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, expression.left);
    let read_source: u64 in Trapping = |evaluation|::checker_read_type(typing, source_type);
    let source_row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, read_source);
    transition source_row.kind == |typed_trees|::TypeKind::Builtin && source_row.builtin == |symbol_resolved_trees|::BuiltinType::Bool {
        true -> boolean(),
        _ -> converted(checker, expression, row, source, checking)
    }

    machine boolean() -> |evaluation|::Value {
        let zero: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping });
        let one: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: 1 as +Wrapping });
        |evaluation|::Value { place: 0 as +Trapping, known: false, subject: 0 as +Trapping, offset: zero.offset, ceiling: one.ceiling, floor: zero.floor }
    }

    machine converted(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, source: |evaluation|::Value, checking: bool) -> |evaluation|::Value {
        let fits: bool = |evaluation|::value_within(source, row.builtin);
        let kept: |evaluation|::Value = |evaluation|::Value { place: 0 as +Trapping, known: source.known, subject: source.subject, offset: source.offset, ceiling: source.ceiling, floor: source.floor };
        transition fits || !checking {
            true -> exact(kept, row, fits),
            _ -> rejected(checker, expression, row)
        }
    }

    machine exact(kept: |evaluation|::Value, row: |typed_trees|::TypeRow, fits: bool) -> |evaluation|::Value {
        transition fits {
            true -> preserved(kept),
            _ -> carrier(row)
        }
    }

    machine preserved(kept: |evaluation|::Value) -> |evaluation|::Value {
        kept
    }

    machine rejected(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow) -> |evaluation|::Value {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::ConversionOutOfRange, expression.source_span);
        transition { _ -> carrier(row) }
    }

    machine carrier(row: |typed_trees|::TypeRow) -> |evaluation|::Value {
        let range: |evaluation|::Value = |evaluation|::value_carrier(row.builtin);
        range
    }
}

// The policy of a fixed-integer result: an Exact result must fit (else
// `code` rejects when checking), a Trapping one that may not is a crash
// site, Wrapping keeps the result only when it cannot wrap, and Saturating
// clamps. A term survives only where the result is the mathematical one.
public machine policy_result(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, result: |evaluation|::Value, code: |checks|::CheckDiagnosticCode, checking: bool) -> |evaluation|::Value
crashes Trap
{
    let fits: bool = |evaluation|::value_within(result, row.builtin);
    transition fits || checker.exact_body {
        true -> exact(result),
        _ -> overflow(checker, expression, row, result, code, checking)
    }

    machine exact(result: |evaluation|::Value) -> |evaluation|::Value {
        result
    }

    machine overflow(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, result: |evaluation|::Value, code: |checks|::CheckDiagnosticCode, checking: bool) -> |evaluation|::Value {
        transition row.domain {
            |symbol_resolved_trees|::DomainBinding::Trapping -> trapping(checker, row, result),
            |symbol_resolved_trees|::DomainBinding::Wrapping -> wrapped(row, result),
            |symbol_resolved_trees|::DomainBinding::Saturating -> saturated(row, result),
            _ -> unproven(checker, expression, row, code, checking)
        }
    }

    machine trapping(checker: @mutable |checker|::Checker, row: |typed_trees|::TypeRow, result: |evaluation|::Value) -> |evaluation|::Value {
        checker.trap_route = true;
        let clamped: |evaluation|::Value = |evaluation|::value_clamped(result, row.builtin);
        clamped
    }

    // A constant wraps or saturates exactly; any other wrapped value may be
    // anywhere in its carrier.
    machine wrapped(row: |typed_trees|::TypeRow, result: |evaluation|::Value) -> |evaluation|::Value {
        let constant: bool = |evaluation|::is_constant(result);
        transition constant {
            true -> wrapped_constant(row, result),
            _ -> carrier(row)
        }
    }

    machine wrapped_constant(row: |typed_trees|::TypeRow, result: |evaluation|::Value) -> |evaluation|::Value {
        let wrapped: |integers|::ExactInteger = |integers|::wrap(row.builtin, result.offset);
        let value: |evaluation|::Value = |evaluation|::value_constant(wrapped);
        value
    }

    machine carrier(row: |typed_trees|::TypeRow) -> |evaluation|::Value {
        let range: |evaluation|::Value = |evaluation|::value_carrier(row.builtin);
        range
    }

    machine saturated(row: |typed_trees|::TypeRow, result: |evaluation|::Value) -> |evaluation|::Value {
        let constant: bool = |evaluation|::is_constant(result);
        transition constant {
            true -> saturated_constant(row, result),
            _ -> saturated_range(row, result)
        }
    }

    machine saturated_constant(row: |typed_trees|::TypeRow, result: |evaluation|::Value) -> |evaluation|::Value {
        let saturated: |integers|::ExactInteger = |integers|::saturate(row.builtin, result.offset);
        let value: |evaluation|::Value = |evaluation|::value_constant(saturated);
        value
    }

    machine saturated_range(row: |typed_trees|::TypeRow, result: |evaluation|::Value) -> |evaluation|::Value {
        let clamped: |evaluation|::Value = |evaluation|::value_clamped(result, row.builtin);
        let unknown: |evaluation|::Value = |evaluation|::value_unknown();
        |evaluation|::Value { place: 0 as +Trapping, known: false, subject: 0 as +Trapping, offset: unknown.offset, ceiling: clamped.ceiling, floor: clamped.floor }
    }

    machine unproven(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, code: |checks|::CheckDiagnosticCode, checking: bool) -> |evaluation|::Value {
        transition checking {
            true -> rejected(checker, expression, row, code),
            _ -> carrier(row)
        }
    }

    machine rejected(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, code: |checks|::CheckDiagnosticCode) -> |evaluation|::Value {
        |checks|::checks_reject(@mutable checker.output, code, expression.source_span);
        let range: |evaluation|::Value = |evaluation|::value_carrier(row.builtin);
        range
    }
}

// A zero divisor is undefined under every policy but Trapping, where it is
// the trap.
public machine require_divisor(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, divisor: |evaluation|::Value, checking: bool)
crashes Trap
{
    let nonzero: bool = |evaluation|::proves_nonzero(checker, divisor);
    transition nonzero {
        true -> done(),
        _ -> zero(checker, expression, row, checking)
    }

    machine zero(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) {
        transition row.domain == |symbol_resolved_trees|::DomainBinding::Trapping {
            true -> trapped(checker),
            _ -> undefined(checker, expression, checking)
        }
    }

    machine trapped(checker: @mutable |checker|::Checker) {
        checker.trap_route = true;
    }

    machine undefined(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, checking: bool) {
        transition checking {
            true -> rejected(checker, expression),
            _ -> done()
        }
    }

    machine rejected(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::DivisorMayBeZero, expression.source_span);
    }

    machine done() {}
}

// A shift count outside `0..width` is undefined unless Wrapping reduces it,
// and the trap under Trapping.
public machine require_shift_count(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, count: |evaluation|::Value, checking: bool)
crashes Trap
{
    let width: u64 in Trapping = checker_width(row.builtin);
    let magnitude: u64 in Wrapping = width as -Trapping +Wrapping;
    let bits: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: magnitude });
    let zero: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping });
    let below: bool = |evaluation|::proves_less(checker, count, bits);
    let above: bool = |evaluation|::proves_at_most(checker, zero, count);
    transition (below && above) || row.domain == |symbol_resolved_trees|::DomainBinding::Wrapping {
        true -> done(),
        _ -> outside(checker, expression, row, checking)
    }

    machine outside(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) {
        transition row.domain == |symbol_resolved_trees|::DomainBinding::Trapping {
            true -> trapped(checker),
            _ -> undefined(checker, expression, checking)
        }
    }

    machine trapped(checker: @mutable |checker|::Checker) {
        checker.trap_route = true;
    }

    machine undefined(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, checking: bool) {
        transition checking {
            true -> rejected(checker, expression),
            _ -> done()
        }
    }

    machine rejected(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::ShiftCountOutOfRange, expression.source_span);
    }

    machine done() {}
}

// The bit width of a fixed-integer carrier.
public machine checker_width(builtin: |symbol_resolved_trees|::BuiltinType) -> u64 in Trapping {
    transition builtin {
        |symbol_resolved_trees|::BuiltinType::I8 -> bits(8 as +Trapping),
        |symbol_resolved_trees|::BuiltinType::U8 -> bits(8 as +Trapping),
        |symbol_resolved_trees|::BuiltinType::I16 -> bits(16 as +Trapping),
        |symbol_resolved_trees|::BuiltinType::U16 -> bits(16 as +Trapping),
        |symbol_resolved_trees|::BuiltinType::I32 -> bits(32 as +Trapping),
        |symbol_resolved_trees|::BuiltinType::U32 -> bits(32 as +Trapping),
        _ -> bits(64 as +Trapping)
    }

    machine bits(count: u64 in Trapping) -> u64 in Trapping {
        count
    }
}
