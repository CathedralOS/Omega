use pipeline/typed_trees_to_checked_trees/callable_effects.omg;
use pipeline/typed_trees_to_checked_trees/refinement.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/contracts.omg;
use pipeline/typed_trees_to_checked_trees/termination.omg;

use representations/checks/checks.omg;
use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Supply is checked after all bodies, crash routes and termination settle.
// Signatures, public fact implication, operational ceilings and crash subsets
// are independent conjuncts (machines.md#substitution). Fact implication uses
// arbitrary formal values, never a particular static caller or supplier body.
public machine check_supply(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing)
crashes Trap
{
    transition { _ -> next_machine(checker, syntax, resolution, typing, 0 as +Trapping) }

    machine next_machine(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        transition index < syntax.machine_count && checker.output.diagnostic_count < 64 {
            true -> machine(checker, syntax, resolution, typing, index),
            _ -> done()
        }
    }

    machine machine(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        |checks|::open_machine(@mutable checker.output);
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        transition { _ -> next_clause(checker, syntax, resolution, typing, index, item, 0 as +Trapping) }
    }

    machine next_clause(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, item: |syntax_trees|::MachineItem, offset: u64 in Trapping) {
        transition offset < item.clause_count && checker.output.machine_accepted {
            true -> clause(checker, syntax, resolution, typing, index, item, offset),
            _ -> supplied(checker, syntax, resolution, typing, index)
        }
    }

    machine supplied(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        check_supplied_calls(checker, syntax, resolution, typing, index);
        check_progress(checker, syntax, resolution, index);
        transition { _ -> next_machine(checker, syntax, resolution, typing, index + 1) }
    }

    machine clause(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, item: |syntax_trees|::MachineItem, offset: u64 in Trapping) {
        let handle: u64 in Trapping = item.first_clause + offset;
        let clause: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, handle);
        transition clause.kind {
            |syntax_trees|::ClauseKind::Satisfies -> satisfies(checker, syntax, resolution, typing, index, item, offset, handle, clause),
            |syntax_trees|::ClauseKind::Terminates -> terminates(checker, syntax, resolution, typing, index, item, offset, clause),
            _ -> next_clause(checker, syntax, resolution, typing, index, item, offset + 1)
        }
    }

    machine satisfies(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing,
        index: u64 in Trapping,
        item: |syntax_trees|::MachineItem,
        offset: u64 in Trapping,
        handle: u64 in Trapping,
        clause: |syntax_trees|::Clause
    ) {
        let requirement: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::name_resolution_requirement(resolution, handle);
        check_refinement(checker, syntax, resolution, typing, index, item, clause, requirement);
        transition { _ -> next_clause(checker, syntax, resolution, typing, index, item, offset + 1) }
    }

    machine terminates(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing,
        index: u64 in Trapping,
        item: |syntax_trees|::MachineItem,
        offset: u64 in Trapping,
        clause: |syntax_trees|::Clause
    ) {
        transition !item.has_body && clause.argument_count > 0 {
            true -> unranked(checker, syntax, resolution, typing, index, clause.source_span),
            _ -> next_clause(checker, syntax, resolution, typing, index, item, offset + 1)
        }
    }

    machine unranked(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, source_span: |source|::SourceSpan) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::UnsupportedCheck, source_span);
        transition { _ -> next_machine(checker, syntax, resolution, typing, index + 1) }
    }

    machine done() {}
}

// A body promising termination must have settled as terminating
// (termination.omg); one whose own graph is unranked was rejected as its
// cycle was walked.
machine check_progress(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, machine: u64 in Trapping)
crashes Trap
{
    let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, machine);
    let termination: |termination|::TerminationClause = |termination|::checker_termination_clause(syntax, resolution, item);
    let terminating: bool = |termination|::settled_termination(checker, machine);
    transition item.has_body && termination.promised && !terminating && checker.output.machine_accepted {
        true -> unproven(checker, syntax, termination.promise),
        _ -> done()
    }

    machine unproven(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, promise: u64 in Trapping) {
        let clause: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, promise);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::ProgressUnproven, clause.source_span);
    }

    machine done() {}
}

// Refine the static machine arguments of each call machine `caller` makes.
machine check_supplied_calls(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, caller: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, caller, 0 as +Trapping) }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, caller: u64 in Trapping, index: u64 in Trapping) {
        transition index < checker.supplied_count && index < 1024 && checker.output.machine_accepted {
            true -> entry(checker, syntax, resolution, typing, caller, index),
            _ -> done()
        }
    }

    machine entry(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, caller: u64 in Trapping, index: u64 in Trapping)
    requires index < 1024
    {
        let supplied: |checker|::SuppliedCall = checker.supplied[index as -Trapping];
        transition supplied.caller == caller as u64 {
            true -> call(checker, syntax, resolution, typing, caller, index, supplied),
            _ -> next(checker, syntax, resolution, typing, caller, index + 1)
        }
    }

    machine call(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, caller: u64 in Trapping, index: u64 in Trapping, supplied: |checker|::SuppliedCall) {
        let call: u64 in Trapping = supplied.call as u64 +Trapping;
        let callee: u64 in Trapping = supplied.callee as u64 +Trapping;
        refine_static_arguments(checker, syntax, resolution, typing, call, callee);
        transition { _ -> next(checker, syntax, resolution, typing, caller, index + 1) }
    }

    machine done() {}
}

// Each of machine `callee`'s machine binders takes, in order, the next of
// the call's static arguments that names a machine, as typing bound them.
machine refine_static_arguments(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, call: u64 in Trapping, callee: u64 in Trapping)
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, call);
    let applied: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, expression.left);
    let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, callee);
    transition applied.kind == |syntax_trees|::ExpressionKind::Apply {
        true -> binder(checker, syntax, resolution, typing, applied, item, callee, 0 as +Trapping, 0 as +Trapping),
        _ -> done()
    }

    machine binder(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, applied: |syntax_trees|::Expression, item: |syntax_trees|::MachineItem, owner: u64 in Trapping, offset: u64 in Trapping, position: u64 in Trapping) {
        transition offset < item.generic_parameter_count {
            true -> kind(checker, syntax, resolution, typing, applied, item, owner, offset, position),
            _ -> done()
        }
    }

    machine kind(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, applied: |syntax_trees|::Expression, item: |syntax_trees|::MachineItem, owner: u64 in Trapping, offset: u64 in Trapping, position: u64 in Trapping) {
        let generic: |syntax_trees|::GenericParameter = |syntax_trees|::syntax_trees_generic_parameter(syntax, item.first_generic_parameter + offset);
        transition generic.kind == |syntax_trees|::GenericParameterKind::Machine {
            true -> seek(checker, syntax, resolution, typing, applied, item, owner, offset, position),
            _ -> binder(checker, syntax, resolution, typing, applied, item, owner, offset + 1, position)
        }
    }

    machine seek(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, applied: |syntax_trees|::Expression, item: |syntax_trees|::MachineItem, owner: u64 in Trapping, offset: u64 in Trapping, position: u64 in Trapping) {
        transition position < applied.count {
            true -> candidate(checker, syntax, resolution, typing, applied, item, owner, offset, position),
            _ -> done()
        }
    }

    machine candidate(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, applied: |syntax_trees|::Expression, item: |syntax_trees|::MachineItem, owner: u64 in Trapping, offset: u64 in Trapping, position: u64 in Trapping) {
        let row: u64 in Trapping = |syntax_trees|::type_argument(syntax, applied.first + position);
        let argument: |symbol_resolved_trees|::MachineArgument = |symbol_resolved_trees|::name_resolution_machine_argument(syntax, resolution, row);
        transition argument {
            |symbol_resolved_trees|::MachineArgument::Absent -> seek(checker, syntax, resolution, typing, applied, item, owner, offset, position + 1),
            _ -> refine(checker, syntax, resolution, typing, applied, item, owner, offset, position, argument, row)
        }
    }

    machine refine(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing,
        applied: |syntax_trees|::Expression,
        item: |syntax_trees|::MachineItem, owner: u64 in Trapping,
        offset: u64 in Trapping,
        position: u64 in Trapping,
        argument: |symbol_resolved_trees|::MachineArgument,
        row: u64 in Trapping
    ) {
        let contract: |symbol_resolved_trees|::BinderContract = |symbol_resolved_trees|::binder_contract(resolution, item.first_generic_parameter + offset);
        let reference: |syntax_trees|::TypeReference = |syntax_trees|::syntax_trees_type_reference(syntax, row);
        refine_machine_argument(checker, syntax, resolution, typing, owner, contract, argument, reference.source_span);
        transition { _ -> binder(checker, syntax, resolution, typing, applied, item, owner, offset + 1, position + 1) }
    }

    machine done() {}
}

// Static suppliers refine the same full public clause roster as declared
// requirements. Typing already authenticated the complete signature. Facts
// are compared in arbitrary worlds, independently of a particular call.
machine refine_machine_argument(
    checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing, owner: u64 in Trapping, contract: |symbol_resolved_trees|::BinderContract,
    argument: |symbol_resolved_trees|::MachineArgument, source_span: |source|::SourceSpan
)
crashes Trap
{
    transition contract.present {
        true -> contracted(checker, syntax, resolution, typing, owner, contract.contract, argument, source_span),
        _ -> {}
    }
    machine contracted(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, owner: u64 in Trapping, handle: u64 in Trapping, argument: |symbol_resolved_trees|::MachineArgument, source_span: |source|::SourceSpan) {
        let written: |syntax_trees|::Contract = |syntax_trees|::syntax_trees_contract(syntax, handle);
        let required: |contracts|::CallClauses = |contracts|::CallClauses { first_clause: written.first_clause, clause_count: written.clause_count, first_parameter: written.first_parameter, parameter_count: written.parameter_count, has_return_type: written.has_return_type, return_type: written.return_type };
        transition argument {
            |symbol_resolved_trees|::MachineArgument::Declared { machine } -> selected(checker, syntax, resolution, typing, owner, required, |typed_trees|::Selection::Machine { handle: machine }, source_span),
            |symbol_resolved_trees|::MachineArgument::Forwarded { parameter } -> selected(checker, syntax, resolution, typing, owner, required, |typed_trees|::Selection::Binder { parameter: parameter }, source_span),
            _ -> unrefined(checker, source_span)
        }
    }
    machine selected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, owner: u64 in Trapping, required: |contracts|::CallClauses, target: |typed_trees|::Selection, source_span: |source|::SourceSpan) {
        let given: |contracts|::CallClauses = |contracts|::call_clauses(syntax, resolution, target);
        let routes: |checks|::CrashRoutes = selected_routes(checker, syntax, given, target);
        let allowed: |checks|::CrashRoutes = |checker|::declared_causes(syntax, required.first_clause, required.clause_count);
        let trap: bool = |checker|::checker_published(routes.inferred, routes.trap, routes.declares_trap);
        let abort: bool = |checker|::checker_published(routes.inferred, routes.abort, routes.declares_abort);
        transition (trap && !allowed.declares_trap) || (abort && !allowed.declares_abort) {
            true -> undeclared(checker, source_span),
            _ -> facts(checker, syntax, resolution, typing, owner, required, given, target, source_span)
        }
    }
    machine facts(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, owner: u64 in Trapping, required: |contracts|::CallClauses, given: |contracts|::CallClauses, target: |typed_trees|::Selection, source_span: |source|::SourceSpan) {
        let operational: bool = |callable_effects|::callable_markers_refine(checker, syntax, resolution, required, given, target);
        let held: bool = operational && |refinement|::callable_facts_refine(checker, syntax, resolution, typing, owner, required, given, target);
        transition held { true -> {}, _ -> unrefined(checker, source_span) }
    }
    machine unrefined(checker: @mutable |checker|::Checker, source_span: |source|::SourceSpan) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::RefinementUnproven, source_span);
    }
    machine undeclared(checker: @mutable |checker|::Checker, source_span: |source|::SourceSpan) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::CrashNotDeclared, source_span);
    }
}

machine selected_routes(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, clauses: |contracts|::CallClauses, target: |typed_trees|::Selection) -> |checks|::CrashRoutes
crashes Trap
{
    transition target {
        |typed_trees|::Selection::Machine { handle } -> |checks|::checks_routes(@checker.output, handle),
        _ -> |checker|::declared_causes(syntax, clauses.first_clause, clauses.clause_count)
    }
}

// A named satisfier refines the same public contract as a static supplier.
machine check_refinement(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    machine: u64 in Trapping,
    satisfier: |syntax_trees|::MachineItem,
    clause: |syntax_trees|::Clause,
    binding: |symbol_resolved_trees|::ValueBinding
)
crashes Trap
{
    transition binding {
        |symbol_resolved_trees|::ValueBinding::Machine { handle } -> required(checker, syntax, resolution, typing, machine, satisfier, clause, handle),
        _ -> invalid()
    }

    machine required(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        machine: u64 in Trapping,
        satisfier: |syntax_trees|::MachineItem,
        clause: |syntax_trees|::Clause,
        handle: u64 in Trapping
    ) {
        let required: |contracts|::CallClauses = |contracts|::call_clauses(syntax, resolution, |typed_trees|::Selection::Machine { handle: handle });
        let given: |contracts|::CallClauses = |contracts|::call_clauses(syntax, resolution, |typed_trees|::Selection::Machine { handle: machine });
        let operational: bool = |callable_effects|::callable_markers_refine(checker, syntax, resolution, required, given, |typed_trees|::Selection::Machine { handle: machine });
        let held: bool = operational && |refinement|::callable_facts_refine(checker, syntax, resolution, typing, handle, required, given, |typed_trees|::Selection::Machine { handle: machine });
        transition held {
            true -> routes(checker, machine, clause, handle),
            _ -> unrefined(checker, clause.source_span)
        }
    }

    machine unrefined(checker: @mutable |checker|::Checker, source_span: |source|::SourceSpan) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::RefinementUnproven, source_span);
    }

    machine routes(checker: @mutable |checker|::Checker, machine: u64 in Trapping, clause: |syntax_trees|::Clause, handle: u64 in Trapping) {
        let own: |checks|::CrashRoutes = |checks|::checks_routes(@checker.output, machine);
        let owed: |checks|::CrashRoutes = |checks|::checks_routes(@checker.output, handle);
        let trap: bool = |checker|::checker_published(own.inferred, own.trap, own.declares_trap);
        let abort: bool = |checker|::checker_published(own.inferred, own.abort, own.declares_abort);
        let allowed_trap: bool = |checker|::checker_published(owed.inferred, owed.trap, owed.declares_trap);
        let allowed_abort: bool = |checker|::checker_published(owed.inferred, owed.abort, owed.declares_abort);
        transition (trap && !allowed_trap) || (abort && !allowed_abort) {
            true -> undeclared(checker, clause.source_span),
            _ -> done()
        }
    }

    machine undeclared(checker: @mutable |checker|::Checker, source_span: |source|::SourceSpan) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::CrashNotDeclared, source_span);
    }

    machine invalid() {
        crash Trap;
    }

    machine done() {}
}
