use pipeline/typed_trees_to_checked_trees/places.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;

use foundation/integers.omg;
use representations/checks/checks.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// A recast `reference as @T` views the operand's storage under `T`
// (wiki/spec/layouts/recasts.md#shared-and-mutable-views): a shared view
// needs every valid source representation to be a valid target one, and a
// mutable view both directions, since every value written through the
// target must leave the source valid. Typing admitted one scalar width on
// both sides. Same-width integers and IEEE floats share every bit pattern,
// so they view each other either way. A Boolean is one of two bytes: it
// views as an integer shared but never mutably, and an integer views as a
// Boolean only when it is a field of data whose `requires` facts bound it to
// zero or one, which the zone then proves; a fact that only the body
// established does not make every representation of the carrier valid.
// A declared domain narrows the source's set, so a qualified source views
// shared but not mutably; a qualified target asks for predicates checking
// does not compare and is unsupported unless both referents are the one
// type.
public machine check_recast(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool)
crashes Trap
{
    let source_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, expression.left);
    let given: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, source_type);
    transition checking && given.kind == |typed_trees|::TypeKind::Reference && given.inner != row.inner {
        true -> referents(checker, syntax, typing, expression, row, given),
        _ -> done()
    }

    machine referents(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, given: |typed_trees|::TypeRow) {
        let source: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, given.inner);
        let target: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, row.inner);
        let is_exclusive: bool = row.access != |syntax_trees|::ReferenceAccess::Shared;
        let source_boolean: bool = source.kind == |typed_trees|::TypeKind::Builtin && source.builtin == |symbol_resolved_trees|::BuiltinType::Bool;
        let target_boolean: bool = target.kind == |typed_trees|::TypeKind::Builtin && target.builtin == |symbol_resolved_trees|::BuiltinType::Bool;
        transition target.domain == |symbol_resolved_trees|::DomainBinding::Declared {
            true -> fenced(checker, expression),
            _ -> source_domain(checker, syntax, typing, expression, source.domain == |symbol_resolved_trees|::DomainBinding::Declared, is_exclusive, source_boolean, target_boolean)
        }
    }

    machine source_domain(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, qualified: bool, is_exclusive: bool, source_boolean: bool, target_boolean: bool) {
        transition qualified && is_exclusive {
            true -> unproven(checker, expression),
            _ -> shapes(checker, syntax, typing, expression, is_exclusive, source_boolean, target_boolean)
        }
    }

    machine shapes(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, is_exclusive: bool, source_boolean: bool, target_boolean: bool) {
        transition source_boolean == target_boolean {
            true -> done(),
            _ -> mixed(checker, syntax, typing, expression, is_exclusive, target_boolean)
        }
    }

    machine mixed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, is_exclusive: bool, target_boolean: bool) {
        transition target_boolean {
            true -> bounded_field(checker, syntax, typing, expression),
            _ -> boolean_source(checker, expression, is_exclusive)
        }
    }

    machine boolean_source(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, is_exclusive: bool) {
        transition is_exclusive {
            true -> unproven(checker, expression),
            _ -> done()
        }
    }

    // The borrowed place must be a field of data carrying `requires` facts,
    // and those facts must bound it to zero or one.
    machine bounded_field(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression) {
        let operand: |evaluation|::Value = |evaluation|::value_at(checker, expression.left);
        let owner: u64 in Trapping = |places|::window_owner(checker, syntax, typing, operand.place);
        transition owner > 0 {
            true -> proved(checker, expression, operand.place),
            _ -> unproven(checker, expression)
        }
    }

    machine proved(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression, place: u64 in Trapping) {
        let referent: |evaluation|::Value = |places|::place_value(checker, place);
        let zero: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping });
        let one: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: 1 as +Wrapping });
        let at_least_zero: bool = |evaluation|::proves_at_most(checker, zero, referent);
        let at_most_one: bool = |evaluation|::proves_at_most(checker, referent, one);
        transition at_least_zero && at_most_one {
            true -> done(),
            _ -> unproven(checker, expression)
        }
    }

    machine fenced(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::UnsupportedCheck, expression.source_span);
    }

    machine unproven(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::RepresentationUnproven, expression.source_span);
    }

    machine done() {}
}
