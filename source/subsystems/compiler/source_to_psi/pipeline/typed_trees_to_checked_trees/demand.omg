use pipeline/typed_trees_to_checked_trees/domains.omg;
use pipeline/typed_trees_to_checked_trees/obligations.omg;
use pipeline/typed_trees_to_checked_trees/places.omg;
use pipeline/typed_trees_to_checked_trees/arrivals.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/contracts.omg;

use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Arrival demand. A jump projects onto its target state the facts of field
// paths below the state's parameters (arrivals.omg), at most 40 per state.
// Projecting whatever the jumping body touched first loses the facts the
// target needs once a wide value fills the slots (a parser state that read
// two dozen fields before its guard), so each state's paths are derived,
// before its machine's facts are gathered, from what needs them:
//
// - the integer and Boolean fields and lengths its own statements read
//   below its parameters, a slice's length wherever it indexes one;
// - what each state it jumps to demands below the parameter it passes,
//   behind the path the argument names (`next(p)` passes the target's
//   demand on `p` through, `next(@mutable p.output)` prefixes it with `output`);
// - what each machine it calls reads below a parameter in its `requires`
//   facts, behind the path the argument names;
// - the fields a data declaration's `requires` fact names beside a demanded
//   field, whose relation a store into that field must keep.
//
// Demand settles over a machine's states to a fixed point; a path beyond a
// state's 40 arrives unknown.
public machine derive_demand(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem)
crashes Trap
{
    transition { _ -> round(checker, syntax, resolution, typing, item) }

    machine round(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem) {
        transition { _ -> next(checker, syntax, resolution, typing, item, 0 as +Trapping, false) }
    }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, changed: bool) {
        transition offset < checker.body_count {
            true -> member_state(checker, syntax, resolution, typing, item, offset, changed),
            _ -> settled(checker, syntax, resolution, typing, item, changed)
        }
    }

    machine member_state(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, changed: bool) {
        let body: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, |checker|::body_handle(checker, offset));
        let read: bool = demand_statements(checker, syntax, resolution, typing, item, offset, body);
        let related: bool = demand_siblings(checker, syntax, resolution, typing, offset);
        transition { _ -> next(checker, syntax, resolution, typing, item, offset + 1, changed || read || related) }
    }

    machine settled(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, changed: bool) {
        transition changed {
            true -> round(checker, syntax, resolution, typing, item),
            _ -> done()
        }
    }

    machine done() {}
}

// A member path below a parameter in a range: whether the expression names
// one (a parameter itself has depth zero), and the path.
public data MemberChain [copy] {
    rooted: bool;
    path: |arrivals|::ArrivalPath;
}

// The member path `handle` names: field and `.length` steps (and borrows) down
// to a name bound to a parameter from `first_parameter` (`parameter_count`
// of them), at most four steps.
public machine member_chain(
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    handle: u64 in Trapping,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping
) -> MemberChain
crashes Trap
{
    let empty: |arrivals|::ArrivalStep = |arrivals|::ArrivalStep { length: false, field: 0 as +Trapping, type_handle: 0 as +Trapping };
    let none: |arrivals|::ArrivalPath = |arrivals|::ArrivalPath { parameter: 0 as +Trapping, depth: 0 as +Trapping, step0: empty, step1: empty, step2: empty, step3: empty };
    transition { _ -> walk(syntax, resolution, typing, handle, first_parameter, parameter_count, none, 0 as +Trapping) }

    // Steps collect outermost first and are reversed at the root.
    machine walk(
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        current: u64 in Trapping,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        path: |arrivals|::ArrivalPath,
        count: u64 in Trapping
    ) -> MemberChain {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, current);
        transition expression.kind {
            |syntax_trees|::ExpressionKind::Field -> member(syntax, resolution, typing, current, expression, first_parameter, parameter_count, path, count),
            |syntax_trees|::ExpressionKind::Unary -> borrowed(syntax, resolution, typing, expression, first_parameter, parameter_count, path, count),
            |syntax_trees|::ExpressionKind::Name -> root(resolution, current, first_parameter, parameter_count, path, count),
            _ -> unrooted(path)
        }
    }

    machine member(
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        current: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        path: |arrivals|::ArrivalPath,
        count: u64 in Trapping
    ) -> MemberChain {
        let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, current);
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, current);
        transition selection {
            |typed_trees|::Selection::Field { field } -> stepped(syntax, resolution, typing, expression, first_parameter, parameter_count, path, count, |arrivals|::ArrivalStep { length: false, field: field, type_handle: type_handle }),
            |typed_trees|::Selection::Length -> stepped(syntax, resolution, typing, expression, first_parameter, parameter_count, path, count, |arrivals|::ArrivalStep { length: true, field: 0 as +Trapping, type_handle: type_handle }),
            _ -> unrooted(path)
        }
    }

    machine stepped(
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        path: |arrivals|::ArrivalPath,
        count: u64 in Trapping,
        step: |arrivals|::ArrivalStep
    ) -> MemberChain {
        transition count < 4 {
            true -> extended(syntax, resolution, typing, expression, first_parameter, parameter_count, path, count, step),
            _ -> unrooted(path)
        }
    }

    machine extended(
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        path: |arrivals|::ArrivalPath,
        count: u64 in Trapping,
        step: |arrivals|::ArrivalStep
    ) -> MemberChain {
        let longer: |arrivals|::ArrivalPath = |arrivals|::with_step(path, count, step);
        transition { _ -> walk(syntax, resolution, typing, expression.left, first_parameter, parameter_count, longer, count + 1) }
    }

    machine borrowed(
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        path: |arrivals|::ArrivalPath,
        count: u64 in Trapping
    ) -> MemberChain {
        let borrow: bool = expression.operator == |syntax_trees|::OperatorKind::BorrowMutable || expression.operator == |syntax_trees|::OperatorKind::Borrow
            || expression.operator == |syntax_trees|::OperatorKind::BorrowWrite;
        transition borrow {
            true -> walk(syntax, resolution, typing, expression.left, first_parameter, parameter_count, path, count),
            _ -> unrooted(path)
        }
    }

    machine root(resolution: @|symbol_resolved_trees|::NameResolution, current: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, path: |arrivals|::ArrivalPath, count: u64 in Trapping) -> MemberChain {
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, current);
        transition binding {
            |symbol_resolved_trees|::ValueBinding::Parameter { parameter as selected_parameter } -> parameter(first_parameter, parameter_count, path, count, selected_parameter),
            _ -> unrooted(path)
        }
    }

    machine parameter(first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, path: |arrivals|::ArrivalPath, count: u64 in Trapping, parameter: u64 in Trapping) -> MemberChain {
        transition parameter >= first_parameter && parameter - first_parameter < parameter_count {
            true -> rooted(path, count, parameter - first_parameter),
            _ -> unrooted(path)
        }
    }

    machine rooted(path: |arrivals|::ArrivalPath, count: u64 in Trapping, offset: u64 in Trapping) -> MemberChain {
        let mutable ordered: |arrivals|::ArrivalPath = |arrivals|::arrival_path_reversed(path, count);
        ordered.parameter = offset;
        MemberChain { rooted: true, path: ordered }
    }

    machine unrooted(path: |arrivals|::ArrivalPath) -> MemberChain {
        MemberChain { rooted: false, path: path }
    }
}

// `prefix` followed by `suffix`'s steps, below `prefix`'s parameter; depth
// zero when together they pass four steps.
public machine arrival_path_joined(prefix: |arrivals|::ArrivalPath, suffix: |arrivals|::ArrivalPath) -> |arrivals|::ArrivalPath
crashes Trap
{
    transition prefix.depth + suffix.depth <= 4 {
        true -> next(prefix, suffix, 0 as +Trapping),
        _ -> overlong(prefix)
    }

    machine next(path: |arrivals|::ArrivalPath, suffix: |arrivals|::ArrivalPath, index: u64 in Trapping) -> |arrivals|::ArrivalPath {
        transition index < suffix.depth && index < 4 {
            true -> step(path, suffix, index),
            _ -> finished(path)
        }
    }

    machine step(path: |arrivals|::ArrivalPath, suffix: |arrivals|::ArrivalPath, index: u64 in Trapping) -> |arrivals|::ArrivalPath {
        let taken: |arrivals|::ArrivalStep = |arrivals|::arrival_path_step(suffix, index);
        let mutable longer: |arrivals|::ArrivalPath = |arrivals|::with_step(path, path.depth, taken);
        longer.depth = path.depth + 1;
        transition { _ -> next(longer, suffix, index + 1) }
    }

    machine finished(path: |arrivals|::ArrivalPath) -> |arrivals|::ArrivalPath {
        path
    }

    machine overlong(prefix: |arrivals|::ArrivalPath) -> |arrivals|::ArrivalPath {
        let mutable none: |arrivals|::ArrivalPath = prefix;
        none.depth = 0 as +Trapping;
        none
    }
}

// The demand of one state's statements: every tree they evaluate.
machine demand_statements(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem) -> bool
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, item, offset, body, 0 as +Trapping, false) }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, index: u64 in Trapping, changed: bool) -> bool {
        transition index < body.statement_count {
            true -> statement(checker, syntax, resolution, typing, item, offset, body, index, changed),
            _ -> finished(changed)
        }
    }

    machine statement(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, index: u64 in Trapping, changed: bool) -> bool {
        let statement: |syntax_trees|::Statement = |syntax_trees|::syntax_trees_statement(syntax, body.first_statement + index);
        let valued: bool = demand_valued(checker, syntax, resolution, typing, item, offset, body, statement);
        let arms: bool = demand_arms(checker, syntax, resolution, typing, item, offset, body, statement);
        transition { _ -> next(checker, syntax, resolution, typing, item, offset, body, index + 1, changed || valued || arms) }
    }

    machine finished(changed: bool) -> bool {
        changed
    }
}

// A statement's value tree, and an assignment's target tree.
machine demand_valued(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement) -> bool
crashes Trap
{
    let assigned: bool = statement.kind == |syntax_trees|::StatementKind::Assign;
    let evaluated: bool = statement.has_value && statement.kind != |syntax_trees|::StatementKind::Crash;
    transition { _ -> value(checker, syntax, resolution, typing, item, offset, body, statement, assigned, evaluated) }

    machine value(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, assigned: bool, evaluated: bool) -> bool {
        transition evaluated || assigned {
            true -> valued(checker, syntax, resolution, typing, item, offset, body, statement, assigned),
            _ -> target(checker, syntax, resolution, typing, item, offset, body, statement, assigned, false)
        }
    }

    machine valued(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, assigned: bool) -> bool {
        let grew: bool = demand_tree(checker, syntax, resolution, typing, item, offset, body, statement.value);
        transition { _ -> target(checker, syntax, resolution, typing, item, offset, body, statement, assigned, grew) }
    }

    machine target(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, assigned: bool, changed: bool) -> bool {
        transition assigned {
            true -> targeted(checker, syntax, resolution, typing, item, offset, body, statement, changed),
            _ -> finished(changed)
        }
    }

    machine targeted(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, changed: bool) -> bool {
        let grew: bool = demand_tree(checker, syntax, resolution, typing, item, offset, body, statement.target);
        changed || grew
    }

    machine finished(changed: bool) -> bool {
        changed
    }
}

// A transition's arms: each guard, and each target that is not `{}`.
machine demand_arms(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement) -> bool
crashes Trap
{
    transition statement.kind == |syntax_trees|::StatementKind::Transition {
        true -> next(checker, syntax, resolution, typing, item, offset, body, statement, 0 as +Trapping, false),
        _ -> finished(false)
    }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, index: u64 in Trapping, changed: bool) -> bool {
        transition index < statement.arm_count {
            true -> arm(checker, syntax, resolution, typing, item, offset, body, statement, index, changed),
            _ -> finished(changed)
        }
    }

    machine arm(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, index: u64 in Trapping, changed: bool) -> bool {
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_arm(syntax, statement.first_arm + index);
        transition arm.kind == |syntax_trees|::ArmPatternKind::Guard {
            true -> guarded(checker, syntax, resolution, typing, item, offset, body, statement, index, changed, arm),
            _ -> clause(checker, syntax, resolution, typing, item, offset, body, statement, index, changed, arm)
        }
    }

    machine guarded(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, index: u64 in Trapping, changed: bool, arm: |syntax_trees|::TransitionArm) -> bool {
        let grew: bool = demand_tree(checker, syntax, resolution, typing, item, offset, body, arm.pattern);
        transition { _ -> clause(checker, syntax, resolution, typing, item, offset, body, statement, index, changed || grew, arm) }
    }

    // An arm's `if` guard reads as its pattern does.
    machine clause(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, index: u64 in Trapping, changed: bool, arm: |syntax_trees|::TransitionArm) -> bool {
        transition arm.has_guard {
            true -> clause_demanded(checker, syntax, resolution, typing, item, offset, body, statement, index, changed, arm),
            _ -> targeted(checker, syntax, resolution, typing, item, offset, body, statement, index, changed, arm)
        }
    }

    machine clause_demanded(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, index: u64 in Trapping, changed: bool, arm: |syntax_trees|::TransitionArm) -> bool {
        let grew: bool = demand_tree(checker, syntax, resolution, typing, item, offset, body, arm.guard);
        transition { _ -> targeted(checker, syntax, resolution, typing, item, offset, body, statement, index, changed || grew, arm) }
    }

    machine targeted(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, index: u64 in Trapping, changed: bool, arm: |syntax_trees|::TransitionArm) -> bool {
        transition arm.target_kind != |syntax_trees|::ArmTargetKind::Unit {
            true -> target(checker, syntax, resolution, typing, item, offset, body, statement, index, changed, arm),
            _ -> next(checker, syntax, resolution, typing, item, offset, body, statement, index + 1, changed)
        }
    }

    machine target(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, statement: |syntax_trees|::Statement, index: u64 in Trapping, changed: bool, arm: |syntax_trees|::TransitionArm) -> bool {
        let grew: bool = demand_tree(checker, syntax, resolution, typing, item, offset, body, arm.target);
        transition { _ -> next(checker, syntax, resolution, typing, item, offset, body, statement, index + 1, changed || grew) }
    }

    machine finished(changed: bool) -> bool {
        changed
    }
}

// Every node of the tree rooted at `root`.
machine demand_tree(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, root: u64 in Trapping) -> bool
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    transition { _ -> next(checker, syntax, resolution, typing, item, offset, body, root, tree.first_row, false) }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, root: u64 in Trapping, handle: u64 in Trapping, changed: bool) -> bool {
        transition handle <= root {
            true -> node(checker, syntax, resolution, typing, item, offset, body, root, handle, changed),
            _ -> finished(changed)
        }
    }

    machine node(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, root: u64 in Trapping, handle: u64 in Trapping, changed: bool) -> bool {
        let grew: bool = demand_node(checker, syntax, resolution, typing, item, offset, body, handle);
        transition { _ -> next(checker, syntax, resolution, typing, item, offset, body, root, handle + 1, changed || grew) }
    }

    machine finished(changed: bool) -> bool {
        changed
    }
}

// One node: an integer member read below a parameter is demanded; a jump
// passes its target's demand back, and a machine call its callee's
// `requires` reads.
machine demand_node(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, handle: u64 in Trapping) -> bool
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
    let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, handle);
    transition expression.kind {
        |syntax_trees|::ExpressionKind::Field -> read(checker, syntax, resolution, typing, offset, body, handle),
        |syntax_trees|::ExpressionKind::Index -> indexed(checker, syntax, resolution, typing, offset, body, expression),
        |syntax_trees|::ExpressionKind::Call -> called(checker, syntax, resolution, typing, item, offset, body, expression, selection),
        |syntax_trees|::ExpressionKind::Binary -> called(checker, syntax, resolution, typing, item, offset, body, expression, selection),
        _ -> unchanged()
    }

    machine read(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, handle: u64 in Trapping) -> bool {
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
        let carrier: |symbol_resolved_trees|::BuiltinType = |places|::checker_carrier(typing, type_handle);
        let integer: bool = |places|::has_subject(carrier);
        let chain: MemberChain = member_chain(syntax, resolution, typing, handle, body.first_parameter, body.parameter_count);
        transition integer && chain.rooted && chain.path.depth > 0 {
            true -> demanded(checker, offset, chain.path),
            _ -> unchanged()
        }
    }

    machine demanded(checker: @mutable |checker|::Checker, offset: u64 in Trapping, path: |arrivals|::ArrivalPath) -> bool {
        let added: bool = |arrivals|::add_arrival_path(checker, offset, path);
        added
    }

    // Indexing a slice reads its length, as the bounds check does.
    machine indexed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, expression: |syntax_trees|::Expression) -> bool {
        let collection: |typed_trees|::TypeRow = |obligations|::collection_row(typing, expression.left);
        let chain: MemberChain = member_chain(syntax, resolution, typing, expression.left, body.first_parameter, body.parameter_count);
        let empty: |arrivals|::ArrivalStep = |arrivals|::ArrivalStep { length: false, field: 0 as +Trapping, type_handle: 0 as +Trapping };
        let length: |arrivals|::ArrivalStep = |arrivals|::ArrivalStep { length: true, field: 0 as +Trapping, type_handle: 0 as +Trapping };
        let suffix: |arrivals|::ArrivalPath = |arrivals|::ArrivalPath { parameter: 0 as +Trapping, depth: 1 as +Trapping, step0: length, step1: empty, step2: empty, step3: empty };
        let lengthed: |arrivals|::ArrivalPath = arrival_path_joined(chain.path, suffix);
        transition collection.kind == |typed_trees|::TypeKind::Slice {
            true -> sliced(checker, offset, chain.rooted, lengthed),
            _ -> unchanged()
        }
    }

    machine sliced(checker: @mutable |checker|::Checker, offset: u64 in Trapping, rooted: bool, path: |arrivals|::ArrivalPath) -> bool {
        let added: bool = add_rooted(checker, offset, rooted, path);
        added
    }

    machine called(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, expression: |syntax_trees|::Expression, selection: |typed_trees|::Selection) -> bool {
        transition selection {
            |typed_trees|::Selection::Machine { handle } -> selected(checker, syntax, resolution, typing, offset, body, expression, selection, handle),
            |typed_trees|::Selection::Binder { parameter } -> callee(checker, syntax, resolution, typing, offset, body, expression, selection),
            _ -> unchanged()
        }
    }

    machine selected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, expression: |syntax_trees|::Expression, selection: |typed_trees|::Selection, handle: u64 in Trapping) -> bool {
        let slot: u64 in Trapping = |checker|::body_slot(checker, handle);
        transition slot > 0 {
            true -> passed(checker, syntax, resolution, typing, offset, body, expression, slot - 1),
            false -> callee(checker, syntax, resolution, typing, offset, body, expression, selection)
        }
    }

    machine passed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, expression: |syntax_trees|::Expression, target: u64 in Trapping) -> bool {
        let grew: bool = demand_successor(checker, syntax, resolution, typing, offset, body, expression, target);
        grew
    }

    machine callee(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, expression: |syntax_trees|::Expression, selection: |typed_trees|::Selection) -> bool {
        let clauses: |contracts|::CallClauses = |contracts|::call_clauses(syntax, resolution, selection);
        let grew: bool = demand_callee(checker, syntax, resolution, typing, offset, body, expression, clauses);
        grew
    }

    machine unchanged() -> bool {
        false
    }
}

// Each path state `target` demands below its parameter `k`, behind the path
// the jump's argument `k` names below this state's parameters.
machine demand_successor(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, expression: |syntax_trees|::Expression, target: u64 in Trapping) -> bool
crashes Trap
{
    let count: u64 in Trapping = |arrivals|::path_count(checker, target);
    transition { _ -> next(checker, syntax, resolution, typing, offset, body, expression, target, count, 0 as +Trapping, false) }

    machine next(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        offset: u64 in Trapping,
        body: |syntax_trees|::MachineItem,
        expression: |syntax_trees|::Expression,
        target: u64 in Trapping,
        count: u64 in Trapping,
        index: u64 in Trapping,
        changed: bool
    ) -> bool {
        transition index < count && index < 40 {
            true -> path(checker, syntax, resolution, typing, offset, body, expression, target, count, index, changed),
            _ -> finished(changed)
        }
    }

    machine path(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        offset: u64 in Trapping,
        body: |syntax_trees|::MachineItem,
        expression: |syntax_trees|::Expression,
        target: u64 in Trapping,
        count: u64 in Trapping,
        index: u64 in Trapping,
        changed: bool
    ) -> bool {
        let wanted: |arrivals|::ArrivalPath = |arrivals|::arrival_path(checker, target, index);
        transition wanted.parameter < expression.count {
            true -> argument(checker, syntax, resolution, typing, offset, body, expression, target, count, index, changed, wanted),
            _ -> next(checker, syntax, resolution, typing, offset, body, expression, target, count, index + 1, changed)
        }
    }

    machine argument(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        offset: u64 in Trapping,
        body: |syntax_trees|::MachineItem,
        expression: |syntax_trees|::Expression,
        target: u64 in Trapping,
        count: u64 in Trapping,
        index: u64 in Trapping,
        changed: bool,
        wanted: |arrivals|::ArrivalPath
    ) -> bool {
        let handle: u64 in Trapping = |syntax_trees|::syntax_trees_argument(syntax, expression.first + wanted.parameter);
        let chain: MemberChain = member_chain(syntax, resolution, typing, handle, body.first_parameter, body.parameter_count);
        let behind: |arrivals|::ArrivalPath = arrival_path_joined(chain.path, wanted);
        let added: bool = add_rooted(checker, offset, chain.rooted, behind);
        transition { _ -> next(checker, syntax, resolution, typing, offset, body, expression, target, count, index + 1, changed || added) }
    }

    machine finished(changed: bool) -> bool {
        changed
    }
}

// Each path a callee's `requires` facts (a machine binder's: its contract's)
// read below its parameter `k`, behind the path the call's argument `k`
// names below this state's parameters.
machine demand_callee(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, expression: |syntax_trees|::Expression, clauses: |contracts|::CallClauses) -> bool
crashes Trap
{
    transition { _ -> clause(checker, syntax, resolution, typing, offset, body, expression, clauses, 0 as +Trapping, false) }

    machine clause(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, expression: |syntax_trees|::Expression, clauses: |contracts|::CallClauses, index: u64 in Trapping, changed: bool) -> bool {
        transition index < clauses.clause_count {
            true -> requirement(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed),
            _ -> finished(changed)
        }
    }

    machine requirement(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, expression: |syntax_trees|::Expression, clauses: |contracts|::CallClauses, index: u64 in Trapping, changed: bool) -> bool {
        let current_clause: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, clauses.first_clause + index);
        transition current_clause.kind == |syntax_trees|::ClauseKind::Requires && current_clause.has_expression {
            true -> fact(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed, current_clause.expression),
            _ -> clause(checker, syntax, resolution, typing, offset, body, expression, clauses, index + 1, changed)
        }
    }

    machine fact(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, body: |syntax_trees|::MachineItem, expression: |syntax_trees|::Expression, clauses: |contracts|::CallClauses, index: u64 in Trapping, changed: bool, root: u64 in Trapping) -> bool {
        let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
        transition { _ -> node(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed, root, tree.first_row) }
    }

    machine node(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        offset: u64 in Trapping,
        body: |syntax_trees|::MachineItem,
        expression: |syntax_trees|::Expression,
        clauses: |contracts|::CallClauses,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping
    ) -> bool {
        transition handle <= root {
            true -> read(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed, root, handle),
            _ -> clause(checker, syntax, resolution, typing, offset, body, expression, clauses, index + 1, changed)
        }
    }

    machine read(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        offset: u64 in Trapping,
        body: |syntax_trees|::MachineItem,
        expression: |syntax_trees|::Expression,
        clauses: |contracts|::CallClauses,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping
    ) -> bool {
        let node_expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        let wanted: MemberChain = member_chain(syntax, resolution, typing, handle, clauses.first_parameter, clauses.parameter_count);
        let count: u64 in Trapping = |obligations|::operand_count(expression);
        transition node_expression.kind == |syntax_trees|::ExpressionKind::Field && wanted.rooted && wanted.path.depth > 0 && wanted.path.parameter < count {
            true -> lent(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed, root, handle, wanted.path),
            _ -> node(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed, root, handle + 1)
        }
    }

    machine lent(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        offset: u64 in Trapping,
        body: |syntax_trees|::MachineItem,
        expression: |syntax_trees|::Expression,
        clauses: |contracts|::CallClauses,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping,
        wanted: |arrivals|::ArrivalPath
    ) -> bool {
        let argument: u64 in Trapping = |obligations|::checker_operand(syntax, expression, wanted.parameter);
        let chain: MemberChain = member_chain(syntax, resolution, typing, argument, body.first_parameter, body.parameter_count);
        let behind: |arrivals|::ArrivalPath = arrival_path_joined(chain.path, wanted);
        let added: bool = add_rooted(checker, offset, chain.rooted, behind);
        transition { _ -> node(checker, syntax, resolution, typing, offset, body, expression, clauses, index, changed || added, root, handle + 1) }
    }

    machine finished(changed: bool) -> bool {
        changed
    }
}

// Add a joined path when its argument was rooted below this state's
// parameters.
machine add_rooted(checker: @mutable |checker|::Checker, offset: u64 in Trapping, rooted: bool, path: |arrivals|::ArrivalPath) -> bool
crashes Trap
{
    transition rooted && path.depth > 0 {
        true -> added(checker, offset, path),
        _ -> unchanged()
    }

    machine added(checker: @mutable |checker|::Checker, offset: u64 in Trapping, path: |arrivals|::ArrivalPath) -> bool {
        let grew: bool = |arrivals|::add_arrival_path(checker, offset, path);
        grew
    }

    machine unchanged() -> bool {
        false
    }
}

// For each of state `offset`'s paths ending in a field, the fields its
// declaration's `requires` facts name beside it, at the same depth.
machine demand_siblings(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, offset, 0 as +Trapping, false) }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, index: u64 in Trapping, changed: bool) -> bool {
        let count: u64 in Trapping = |arrivals|::path_count(checker, offset);
        transition index < count && index < 40 {
            true -> path(checker, syntax, resolution, typing, offset, index, changed),
            _ -> finished(changed)
        }
    }

    machine path(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, index: u64 in Trapping, changed: bool) -> bool {
        let path: |arrivals|::ArrivalPath = |arrivals|::arrival_path(checker, offset, index);
        transition path.depth > 0 && path.depth <= 4 {
            true -> last(checker, syntax, resolution, typing, offset, index, changed, path),
            _ -> next(checker, syntax, resolution, typing, offset, index + 1, changed)
        }
    }

    machine last(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, index: u64 in Trapping, changed: bool, path: |arrivals|::ArrivalPath) -> bool {
        let step: |arrivals|::ArrivalStep = |arrivals|::arrival_path_step(path, path.depth - 1);
        transition step.length {
            true -> next(checker, syntax, resolution, typing, offset, index + 1, changed),
            _ -> related(checker, syntax, resolution, typing, offset, index, changed, path, step.field)
        }
    }

    machine related(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, index: u64 in Trapping, changed: bool, path: |arrivals|::ArrivalPath, field: u64 in Trapping) -> bool {
        let added: bool = demand_field_relatives(checker, syntax, resolution, typing, offset, path, field);
        transition { _ -> next(checker, syntax, resolution, typing, offset, index + 1, changed || added) }
    }

    machine finished(changed: bool) -> bool {
        changed
    }
}

// The fields each `requires` fact naming `field` of its declaration names, as
// paths beside `path` (whose last step is `field`).
machine demand_field_relatives(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, path: |arrivals|::ArrivalPath, field: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> owner(checker, syntax, resolution, typing, offset, path, field, 0 as +Trapping) }

    machine owner(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, path: |arrivals|::ArrivalPath, field: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < syntax.data_count {
            true -> declaration(checker, syntax, resolution, typing, offset, path, field, index),
            _ -> finished(false)
        }
    }

    machine declaration(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, path: |arrivals|::ArrivalPath, field: u64 in Trapping, index: u64 in Trapping) -> bool {
        let item: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, index);
        transition field >= item.first_field && field - item.first_field < item.field_count {
            true -> clause(checker, syntax, resolution, typing, offset, path, field, item, 0 as +Trapping, false),
            _ -> owner(checker, syntax, resolution, typing, offset, path, field, index + 1)
        }
    }

    machine clause(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, path: |arrivals|::ArrivalPath, field: u64 in Trapping, item: |syntax_trees|::DataItem, index: u64 in Trapping, changed: bool) -> bool {
        transition index < item.clause_count {
            true -> fact(checker, syntax, resolution, typing, offset, path, field, item, index, changed),
            _ -> finished(changed)
        }
    }

    machine fact(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, path: |arrivals|::ArrivalPath, field: u64 in Trapping, item: |syntax_trees|::DataItem, index: u64 in Trapping, changed: bool) -> bool {
        let current_clause: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, item.first_clause + index);
        transition current_clause.kind == |syntax_trees|::ClauseKind::Requires && current_clause.has_expression {
            true -> mentioned(checker, syntax, resolution, typing, offset, path, field, item, index, changed, current_clause.expression),
            _ -> clause(checker, syntax, resolution, typing, offset, path, field, item, index + 1, changed)
        }
    }

    machine mentioned(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, path: |arrivals|::ArrivalPath, field: u64 in Trapping, item: |syntax_trees|::DataItem, index: u64 in Trapping, changed: bool, root: u64 in Trapping) -> bool {
        let named: bool = |domains|::mentions_field(syntax, resolution, root, field);
        transition named {
            true -> relatives(checker, syntax, resolution, typing, offset, path, field, item, index, changed, root),
            _ -> clause(checker, syntax, resolution, typing, offset, path, field, item, index + 1, changed)
        }
    }

    machine relatives(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, path: |arrivals|::ArrivalPath, field: u64 in Trapping, item: |syntax_trees|::DataItem, index: u64 in Trapping, changed: bool, root: u64 in Trapping) -> bool {
        let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
        transition { _ -> node(checker, syntax, resolution, typing, offset, path, field, item, index, changed, root, tree.first_row) }
    }

    machine node(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        offset: u64 in Trapping,
        path: |arrivals|::ArrivalPath,
        field: u64 in Trapping,
        item: |syntax_trees|::DataItem,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping
    ) -> bool {
        transition handle <= root {
            true -> named(checker, syntax, resolution, typing, offset, path, field, item, index, changed, root, handle),
            _ -> clause(checker, syntax, resolution, typing, offset, path, field, item, index + 1, changed)
        }
    }

    machine named(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        offset: u64 in Trapping,
        path: |arrivals|::ArrivalPath,
        field: u64 in Trapping,
        item: |syntax_trees|::DataItem,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping
    ) -> bool {
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, handle);
        transition binding {
            |symbol_resolved_trees|::ValueBinding::Field { field as selected_sibling } -> sibling(checker, syntax, resolution, typing, offset, path, field, item, index, changed, root, handle, selected_sibling),
            _ -> node(checker, syntax, resolution, typing, offset, path, field, item, index, changed, root, handle + 1)
        }
    }

    machine sibling(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        offset: u64 in Trapping,
        path: |arrivals|::ArrivalPath,
        field: u64 in Trapping,
        item: |syntax_trees|::DataItem,
        index: u64 in Trapping,
        changed: bool,
        root: u64 in Trapping,
        handle: u64 in Trapping,
        sibling: u64 in Trapping
    ) -> bool {
        let declared: |syntax_trees|::DataField = |syntax_trees|::syntax_trees_field(syntax, sibling);
        let type_handle: u64 in Trapping = |typed_trees|::reference_type(typing, declared.type_reference);
        let step: |arrivals|::ArrivalStep = |arrivals|::ArrivalStep { length: false, field: sibling, type_handle: type_handle };
        let beside: |arrivals|::ArrivalPath = |arrivals|::with_step(path, path.depth - 1, step);
        let added: bool = |arrivals|::add_arrival_path(checker, offset, beside);
        transition { _ -> node(checker, syntax, resolution, typing, offset, path, field, item, index, changed || added, root, handle + 1) }
    }

    machine finished(changed: bool) -> bool {
        changed
    }
}
