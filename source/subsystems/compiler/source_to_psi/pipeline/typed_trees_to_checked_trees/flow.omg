use pipeline/typed_trees_to_checked_trees/completions.omg;
use pipeline/typed_trees_to_checked_trees/contracts.omg;
use pipeline/typed_trees_to_checked_trees/domains.omg;
use pipeline/typed_trees_to_checked_trees/fact_values.omg;
use pipeline/typed_trees_to_checked_trees/facts.omg;
use pipeline/typed_trees_to_checked_trees/matches.omg;
use pipeline/typed_trees_to_checked_trees/obligations.omg;
use pipeline/typed_trees_to_checked_trees/qualification.omg;
use pipeline/typed_trees_to_checked_trees/reference_origins.omg;
use pipeline/typed_trees_to_checked_trees/reference_writes.omg;
use pipeline/typed_trees_to_checked_trees/references.omg;
use pipeline/typed_trees_to_checked_trees/snapshots.omg;
use pipeline/typed_trees_to_checked_trees/zone.omg;
use pipeline/typed_trees_to_checked_trees/aliases.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;
use pipeline/typed_trees_to_checked_trees/places.omg;

use foundation/integers.omg;
use representations/checks/checks.omg;
use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Live facts through one body (wiki/spec/language/state_contracts.md). Its
// statements run in order: a `let` binds its local to its initializer's
// value, an assignment captures its target before evaluating the value,
// then replaces there, and a crash ends the path.
// A transition's arms each see the facts their selection implies, the
// failure of every earlier guard among them; a jump to a state projects the
// facts about its arguments onto the state's integer parameters. Inside an
// expression, the right operand of `&&` sees its left operand hold and that
// of `||` sees it fail; after the operator, facts hold only when they hold
// whether or not the right operand ran.

// Evaluate the tree rooted at `root`, children before parents.
public machine evaluate_tree(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    root: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    let low: u64 in Trapping = tree.first_row;
    let size: u64 in Trapping = root - low + 1;
    transition checker.retained_values + size <= 4096 {
        true -> sized(checker, syntax, resolution, typing, root, low, size, checking),
        _ -> oversized(checker, syntax, root)
    }

    // A statement-level tree starts the values afresh.
    machine sized(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        size: u64 in Trapping,
        checking: bool
    ) {
        checker.frame_count = 0;
        checker.tree_base = checker.retained_values;
        checker.tree_low = low;
        checker.tree_size = size;
        checker.context_first = 0;
        checker.context_count = 0;
        checker.match_count = 0;
        evaluate_run(checker, syntax, resolution, typing, root, low, checking);
        |domains|::install_domains(checker, syntax, resolution, typing);
    }

    machine oversized(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, root: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::CheckCapacityExceeded, expression.source_span);
    }
}

// Decide a whole fact: a membership through its domain
// (`decide_membership`), any other fact as a tree.
public machine decide_fact(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    root: u64 in Trapping,
    proving: bool
) -> bool
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    transition tree.kind == |syntax_trees|::ExpressionKind::Membership {
        true -> membership(checker, syntax, resolution, typing, root, proving),
        _ -> tree_fact(checker, syntax, resolution, typing, root, proving)
    }

    machine membership(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping, proving: bool) -> bool {
        let decided: bool = |qualification|::decide_membership(checker, syntax, resolution, typing, root, proving);
        decided
    }

    machine tree_fact(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping, proving: bool) -> bool {
        let decided: bool = decide_tree(checker, syntax, resolution, typing, root, proving);
        decided
    }
}

// Evaluate a fact tree while another may be open, then assume it or, when
// `proving`, report whether the facts prove it. Its values sit above the
// open tree's and are gone when it returns. A fact is a proof expression:
// evaluating it executes nothing, so it adds no crash route and its calls
// have no effects (fact_values.omg). A proposition application states
// what no zone fact expresses: assuming it establishes nothing, and where
// it must hold, checking cannot decide it and rejects it as unsupported. A
// membership inside a larger fact is an unknown Boolean.
public machine decide_tree(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    root: u64 in Trapping,
    proving: bool
) -> bool
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    let applied: bool = applies_proposition(syntax, resolution, tree);
    transition applied {
        true -> proposition(checker, tree, proving),
        _ -> sized(checker, syntax, resolution, typing, root, tree, proving)
    }

    machine proposition(checker: @mutable |checker|::Checker, tree: |syntax_trees|::Expression, proving: bool) -> bool {
        transition proving {
            true -> unsupported(checker, tree),
            _ -> assumed()
        }
    }

    machine unsupported(checker: @mutable |checker|::Checker, tree: |syntax_trees|::Expression) -> bool {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::UnsupportedFact, tree.source_span);
        transition { _ -> unproved() }
    }

    machine assumed() -> bool {
        true
    }

    machine unproved() -> bool {
        false
    }

    machine sized(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        tree: |syntax_trees|::Expression,
        proving: bool
    ) -> bool {
        let low: u64 in Trapping = tree.first_row;
        let size: u64 in Trapping = root - low + 1;
        let base: u64 in Trapping = next_base(checker);
        transition base + size <= 4096 && checker.frame_count < 8 {
            true -> framed(checker, syntax, resolution, typing, root, low, size, base, proving),
            _ -> undecided(proving)
        }
    }

    machine framed(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        size: u64 in Trapping,
        base: u64 in Trapping,
        proving: bool
    ) -> bool {
        let trap_route: bool = checker.trap_route;
        let abort_route: bool = checker.abort_route;
        checker_push_frame(checker);
        checker.tree_base = base;
        checker.tree_low = low;
        checker.tree_size = size;
        checker.context_first = checker.context_count;
        |fact_values|::evaluate_fact_run(checker, syntax, resolution, typing, root, low);
        let decided: bool = decide(checker, syntax, root, proving);
        checker.trap_route = trap_route;
        checker.abort_route = abort_route;
        checker_pop_frame(checker);
        decided
    }

    // Too deep to evaluate: nothing is assumed and nothing is proved.
    machine undecided(proving: bool) -> bool {
        !proving
    }
}

// The value of `operand` in the fact tree rooted at `root`, evaluated like
// any fact tree above the open one; unknown when too deep to evaluate.
public machine fact_operand(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    root: u64 in Trapping,
    operand: u64 in Trapping
) -> |evaluation|::Value
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    let low: u64 in Trapping = tree.first_row;
    let size: u64 in Trapping = root - low + 1;
    let base: u64 in Trapping = next_base(checker);
    transition base + size <= 4096 && checker.frame_count < 8 {
        true -> framed(checker, syntax, resolution, typing, root, operand, low, size, base),
        _ -> unknown()
    }

    machine framed(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        operand: u64 in Trapping,
        low: u64 in Trapping,
        size: u64 in Trapping,
        base: u64 in Trapping
    ) -> |evaluation|::Value {
        let trap_route: bool = checker.trap_route;
        let abort_route: bool = checker.abort_route;
        checker_push_frame(checker);
        checker.tree_base = base;
        checker.tree_low = low;
        checker.tree_size = size;
        checker.context_first = checker.context_count;
        |fact_values|::evaluate_fact_run(checker, syntax, resolution, typing, root, low);
        let value: |evaluation|::Value = |evaluation|::value_at(checker, operand);
        checker.trap_route = trap_route;
        checker.abort_route = abort_route;
        checker_pop_frame(checker);
        value
    }

    machine unknown() -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        value
    }
}

// Whether a fact is a proposition application, which resolution admits
// only as a whole fact: `P(...)` or `P<...>(...)`.
machine applies_proposition(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, tree: |syntax_trees|::Expression) -> bool
crashes Trap
{
    transition tree.kind == |syntax_trees|::ExpressionKind::Call {
        true -> callee(syntax, resolution, tree.left),
        _ -> answer(false)
    }

    machine callee(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, left: u64 in Trapping) -> bool {
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, left);
        transition written.kind == |syntax_trees|::ExpressionKind::Apply {
            true -> named(resolution, written.left),
            _ -> named(resolution, left)
        }
    }

    machine named(resolution: @|symbol_resolved_trees|::NameResolution, handle: u64 in Trapping) -> bool {
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, handle);
        transition binding {
            |symbol_resolved_trees|::ValueBinding::Proposition { proposition } -> answer(true),
            _ -> answer(false)
        }
    }

    machine answer(applied: bool) -> bool {
        applied
    }
}

machine decide(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, root: u64 in Trapping, proving: bool) -> bool
crashes Trap
{
    transition proving {
        true -> proved(checker, syntax, root),
        _ -> assumed(checker, syntax, root)
    }

    machine proved(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, root: u64 in Trapping) -> bool {
        let holds: bool = |facts|::proves(checker, syntax, root);
        holds
    }

    machine assumed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, root: u64 in Trapping) -> bool {
        |facts|::assume(checker, syntax, root, true);
        true
    }
}

// The nodes of the tree in the current frame, children before parents.
machine evaluate_run(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    root: u64 in Trapping,
    low: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    transition { _ -> scan(checker, syntax, resolution, typing, root, low, low, checking) }

    // Record where each `&&`/`||` right operand begins, and each match.
    machine scan(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        checking: bool
    ) {
        transition handle <= root {
            true -> scan_node(checker, syntax, resolution, typing, root, low, handle, checking),
            _ -> node(checker, syntax, resolution, typing, root, low, checking)
        }
    }

    machine scan_node(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        checking: bool
    ) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        let logical: bool = expression.kind == |syntax_trees|::ExpressionKind::Binary
            && (expression.operator == |syntax_trees|::OperatorKind::And || expression.operator == |syntax_trees|::OperatorKind::Or);
        transition logical {
            true -> context(checker, syntax, resolution, typing, root, low, handle, expression.right, checking),
            _ -> matched(checker, syntax, resolution, typing, root, low, handle, expression, checking)
        }
    }

    machine matched(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        checking: bool
    ) {
        transition expression.kind == |syntax_trees|::ExpressionKind::Match {
            true -> record_match(checker, syntax, resolution, typing, root, low, handle, checking),
            _ -> scan(checker, syntax, resolution, typing, root, low, handle + 1, checking)
        }
    }

    machine record_match(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        checking: bool
    ) {
        |matches|::checker_add_match(checker, syntax, handle);
        transition { _ -> scan(checker, syntax, resolution, typing, root, low, handle + 1, checking) }
    }

    machine context(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        low: u64 in Trapping,
        handle: u64 in Trapping,
        right: u64 in Trapping,
        checking: bool
    ) {
        let operand: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, right);
        add_context(checker, operand.first_row, handle);
        transition { _ -> scan(checker, syntax, resolution, typing, root, low, handle + 1, checking) }
    }

    machine node(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        handle: u64 in Trapping,
        checking: bool
    ) {
        transition handle <= root {
            true -> enter(checker, syntax, resolution, typing, root, handle, checking),
            _ -> done()
        }
    }

    machine enter(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        handle: u64 in Trapping,
        checking: bool
    ) {
        |domains|::install_domains(checker, syntax, resolution, typing);
        open_contexts(checker, syntax, handle);
        |matches|::advance_matches(checker, syntax, resolution, typing, handle, checking);
        |obligations|::evaluate_node(checker, syntax, resolution, typing, handle, checking);
        close_context(checker, handle);
        transition { _ -> node(checker, syntax, resolution, typing, root, handle + 1, checking) }
    }

    machine done() {}
}

// One open tree's evaluation state, saved while a tree evaluated inside it
// runs.
public data TreeFrame [copy] {
    base: u64 in Trapping;
    low: u64 in Trapping;
    size: u64 in Trapping;
    context_first: u64;
    context_count: u64;
}

// Dispatch subjects retain their evaluated window while guards and targets
// use later scratch. Restoring a header never reexecutes source effects.
public machine tree_frame(checker: @|checker|::Checker) -> TreeFrame {
    TreeFrame {
        base: checker.tree_base, low: checker.tree_low, size: checker.tree_size,
        context_first: checker.context_first, context_count: checker.context_count
    }
}

public machine restore_tree(checker: @mutable |checker|::Checker, frame: TreeFrame) {
    checker.tree_base = frame.base;
    checker.tree_low = frame.low;
    checker.tree_size = frame.size;
    checker.context_first = frame.context_first;
    checker.context_count = frame.context_count;
}

public data CapturedSubject [copy] {
    frame: TreeFrame;
    floor: u64 in Trapping;
}

// Where a fact tree's values begin: past the most recent tree's, which may
// still be open.
machine next_base(checker: @|checker|::Checker) -> u64 in Trapping {
    let end: u64 in Trapping = checker.tree_base + checker.tree_size;
    transition end >= checker.retained_values {
        true -> current(end),
        _ -> retained(checker.retained_values)
    }
    machine current(end: u64 in Trapping) -> u64 in Trapping { end }
    machine retained(end: u64 in Trapping) -> u64 in Trapping { end }
}

machine checker_push_frame(checker: @mutable |checker|::Checker)
crashes Trap
{
    let frame: TreeFrame = tree_frame(checker);
    let frame_count: u64 = checker.frame_count;
    transition frame_count < 8 {
        true -> write(checker, frame_count, frame),
        _ -> invalid()
    }

    machine write(checker: @mutable |checker|::Checker, index: u64, frame: TreeFrame)
    requires index < 8
    {
        checker.frames[index] = frame;
        checker.frame_count = index + 1;
    }

    machine invalid() {
        crash Trap;
    }
}

// Close the innermost tree: its caller's values and contexts are current
// again.
machine checker_pop_frame(checker: @mutable |checker|::Checker)
crashes Trap
{
    let frame_count: u64 = checker.frame_count;
    transition frame_count > 0 && frame_count <= 8 {
        true -> read(checker, frame_count - 1),
        _ -> invalid()
    }

    machine read(checker: @mutable |checker|::Checker, index: u64)
    requires index < 8
    {
        let frame: TreeFrame = checker.frames[index];
        checker.frame_count = index;
        restore_tree(checker, frame);
    }

    machine invalid() {
        crash Trap;
    }
}

// Evaluate an already evaluated tree again for its values alone: its calls
// record nothing and release nothing a second time.
public machine replay_tree(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping)
crashes Trap
{
    checker.replay = true;
    evaluate_tree(checker, syntax, resolution, typing, root, false);
    checker.replay = false;
}

machine add_context(checker: @mutable |checker|::Checker, start: u64 in Trapping, operator: u64 in Trapping)
crashes Trap
{
    let context_count: u64 = checker.context_count;
    transition context_count < 64 {
        true -> write(checker, context_count, start, operator),
        _ -> full()
    }

    machine write(checker: @mutable |checker|::Checker, index: u64, start: u64 in Trapping, operator: u64 in Trapping)
    requires index < 64
    {
        checker.context_starts[index] = start as u64;
        checker.context_operators[index] = operator as u64;
        checker.context_count = index + 1;
    }

    // An operand without a context simply gains no assumption.
    machine full() {}
}

// Open every context whose right operand begins at `handle`: save the
// facts, then assume the left operand held (`&&`) or failed (`||`). A
// context's saved zone is owned by its operator's handle plus one; owner
// zero is a transition's, whose arms restore it, and expression handle zero
// must not close it.
machine open_contexts(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping)
crashes Trap
{
    transition { _ -> first(checker, syntax, handle) }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping, index: u64) {
        transition index < checker.context_count && index < 64 {
            true -> candidate(checker, syntax, handle, index),
            _ -> done()
        }
    }

    machine first(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) {
        let context_first: u64 = checker.context_first;
        transition { _ -> next(checker, syntax, handle, context_first) }
    }

    machine candidate(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping, index: u64)
    requires index < 64
    {
        let start: u64 = checker.context_starts[index];
        let operator: u64 = checker.context_operators[index];
        transition start == handle {
            true -> open(checker, syntax, handle, index, operator as u64 +Trapping),
            _ -> next(checker, syntax, handle, index + 1)
        }
    }

    machine open(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping, index: u64, operator: u64 in Trapping) {
        let saved: bool = save_zone(checker, operator + 1);
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, operator);
        let holds: bool = expression.operator == |syntax_trees|::OperatorKind::And;
        transition saved {
            true -> assumed(checker, syntax, handle, index, expression.left, holds),
            _ -> next(checker, syntax, handle, index + 1)
        }
    }

    machine assumed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping, index: u64, left: u64 in Trapping, holds: bool) {
        |facts|::assume(checker, syntax, left, holds);
        transition { _ -> next(checker, syntax, handle, index + 1) }
    }

    machine done() {}
}

// After an `&&`/`||` node: keep what holds whether or not its right operand
// ran, the join of the saved facts and the current ones.
machine close_context(checker: @mutable |checker|::Checker, handle: u64 in Trapping)
crashes Trap
{
    let saved_count: u64 = checker.saved_count;
    transition saved_count > 0 && saved_count <= 8 {
        true -> top(checker, handle, saved_count - 1),
        _ -> done()
    }

    machine top(checker: @mutable |checker|::Checker, handle: u64 in Trapping, index: u64)
    requires index < 8
    {
        let owner: u64 = checker.saved_owners[index];
        transition owner == handle + 1 {
            true -> joined(checker, index),
            _ -> done()
        }
    }

    machine joined(checker: @mutable |checker|::Checker, index: u64)
    requires index < 8
    {
        checker.previous = checker.saved[index];
        let saved: |aliases|::AliasTable = checker.saved_aliases[index];
        let current_live: bool = !checker.zone.infeasible;
        let saved_live: bool = !checker.previous.infeasible;
        |aliases|::alias_table_join(@mutable checker.aliases, @saved, current_live, saved_live);
        let changed: bool = |zone|::zone_join(@mutable checker.zone, @checker.previous);
        checker.saved_count = index;
    }

    machine done() {}
}

// Push a copy of the zone, owned by `owner`, or report that the stack is
// full.
public machine save_zone(checker: @mutable |checker|::Checker, owner: u64 in Trapping) -> bool
crashes Trap
{
    let saved_count: u64 = checker.saved_count;
    transition saved_count < 8 {
        true -> push(checker, saved_count, owner),
        _ -> full()
    }

    machine push(checker: @mutable |checker|::Checker, index: u64, owner: u64 in Trapping) -> bool
    requires index < 8
    {
        checker.saved[index] = checker.zone;
        checker.saved_aliases[index] = checker.aliases;
        checker.saved_owners[index] = owner as u64;
        checker.saved_count = index + 1;
        true
    }

    machine full() -> bool {
        false
    }
}

// Replace the zone by the top saved copy, keeping it saved.
public machine restore_zone(checker: @mutable |checker|::Checker)
crashes Trap
{
    let saved_count: u64 = checker.saved_count;
    transition saved_count > 0 && saved_count <= 8 {
        true -> copy(checker, saved_count - 1),
        _ -> invalid()
    }

    machine copy(checker: @mutable |checker|::Checker, index: u64)
    requires index < 8
    {
        checker.zone = checker.saved[index];
        checker.aliases = checker.saved_aliases[index];
    }

    machine invalid() {
        crash Trap;
    }
}

// Overwrite the top saved copy with the zone.
public machine resave_zone(checker: @mutable |checker|::Checker)
crashes Trap
{
    let saved_count: u64 = checker.saved_count;
    transition saved_count > 0 && saved_count <= 8 {
        true -> copy(checker, saved_count - 1),
        _ -> invalid()
    }

    machine copy(checker: @mutable |checker|::Checker, index: u64)
    requires index < 8
    {
        checker.saved[index] = checker.zone;
        checker.saved_aliases[index] = checker.aliases;
    }

    machine invalid() {
        crash Trap;
    }
}

public machine drop_saved(checker: @mutable |checker|::Checker) {
    transition checker.saved_count > 0 {
        true -> drop(checker),
        _ -> done()
    }

    machine drop(checker: @mutable |checker|::Checker) {
        checker.saved_count = checker.saved_count - 1;
    }

    machine done() {}
}

// One body's statements, from its opening facts. A body that runs off its
// end returns its tail's value, else Unit, and owes its machine's `ensures`
// facts there.
public machine walk_body(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    first_statement: u64 in Trapping,
    statement_count: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, first_statement, first_statement, first_statement + statement_count, checking) }

    machine next(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        first: u64 in Trapping,
        index: u64 in Trapping,
        end: u64 in Trapping,
        checking: bool
    ) {
        transition index < end && checker.output.machine_accepted {
            true -> statement(checker, syntax, resolution, typing, first, index, end, checking),
            _ -> finished(checker, syntax, resolution, typing, first, end, checking)
        }
    }

    machine statement(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        first: u64 in Trapping,
        index: u64 in Trapping,
        end: u64 in Trapping,
        checking: bool
    ) {
        walk_statement(checker, syntax, resolution, typing, index, checking);
        transition { _ -> next(checker, syntax, resolution, typing, first, index + 1, end, checking) }
    }

    machine finished(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        first: u64 in Trapping,
        end: u64 in Trapping,
        checking: bool
    ) {
        transition checker.output.machine_accepted && !checker.zone.infeasible {
            true -> returned(checker, syntax, resolution, typing, first, end, checking),
            _ -> done()
        }
    }

    machine returned(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, first: u64 in Trapping, end: u64 in Trapping, checking: bool) {
        transition end > first {
            true -> last(checker, syntax, resolution, typing, end - 1, checking),
            _ -> empty(checker, syntax, resolution, typing, checking)
        }
    }

    machine last(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, checking: bool) {
        let statement: |syntax_trees|::Statement = |syntax_trees|::syntax_trees_statement(syntax, index);
        transition statement.kind == |syntax_trees|::StatementKind::Tail {
            true -> tail(checker, syntax, resolution, typing, statement, checking),
            _ -> unit(checker, syntax, resolution, typing, statement.source_span, checking)
        }
    }

    machine tail(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, checking: bool) {
        let value: |evaluation|::Value = |evaluation|::value_at(checker, statement.value);
        |completions|::observe_normal_completion(checker, value);
        transition checking { true -> owed_tail(checker, syntax, resolution, typing, statement, value), false -> done() }
    }

    machine owed_tail(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, value: |evaluation|::Value) {
        |qualification|::require_result_qualification(checker, syntax, resolution, typing, statement.value, value, statement.source_span);
        |contracts|::require_guarantees(checker, syntax, resolution, typing, value, statement.source_span);
    }

    machine empty(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, checking: bool) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, checker.machine);
        transition { _ -> unit(checker, syntax, resolution, typing, item.source_span, checking) }
    }

    machine unit(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, source_span: |source|::SourceSpan, checking: bool) {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        |completions|::observe_normal_completion(checker, value);
        transition checking { true -> owed_unit(checker, syntax, resolution, typing, value, source_span), false -> done() }
    }

    machine owed_unit(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, value: |evaluation|::Value, source_span: |source|::SourceSpan) {
        |contracts|::require_guarantees(checker, syntax, resolution, typing, value, source_span);
    }

    machine done() {}
}

machine walk_statement(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    index: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let statement: |syntax_trees|::Statement = |syntax_trees|::syntax_trees_statement(syntax, index);
    transition statement.kind {
        |syntax_trees|::StatementKind::Let -> binding(checker, syntax, resolution, typing, index, statement, checking),
        |syntax_trees|::StatementKind::Assign -> assignment(checker, syntax, resolution, typing, statement, checking),
        |syntax_trees|::StatementKind::Crash -> crashed(checker, statement),
        |syntax_trees|::StatementKind::Transition -> transition_statement(checker, syntax, resolution, typing, statement, checking),
        _ -> evaluated(checker, syntax, resolution, typing, statement, checking)
    }

    machine binding(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        index: u64 in Trapping,
        statement: |syntax_trees|::Statement,
        checking: bool
    ) {
        let type_handle: u64 in Trapping = |typed_trees|::reference_type(typing, statement.type_reference);
        let place: u64 in Trapping = |places|::checker_place(checker, typing, |places|::PlaceKind::Local, index, 0 as +Trapping, type_handle);
        transition statement.has_value {
            true -> initialized(checker, syntax, resolution, typing, statement, place, type_handle, checking),
            _ -> done()
        }
    }

    // A qualified local's initializer meets its qualification, which then
    // holds of the local (qualification.omg).
    machine initialized(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        statement: |syntax_trees|::Statement,
        place: u64 in Trapping,
        type_handle: u64 in Trapping,
        checking: bool
    ) {
        let epoch: u64 in Trapping = checker.write_epoch;
        evaluate_tree(checker, syntax, resolution, typing, statement.value, checking);
        let value: |evaluation|::Value = |evaluation|::value_at(checker, statement.value);
        let replayable: bool = alias_replayable(checker, syntax, resolution, typing, statement.value, place, epoch);
        |references|::initialize_place(checker, typing, place, value);
        |references|::capture_footprint(checker, syntax, resolution, typing, place, type_handle, statement.value, value);
        |aliases|::record_alias(checker, syntax, typing, place, statement.value, value, replayable);
        let bound: |evaluation|::Value = |references|::reference_value(checker, typing, place);
        |qualification|::assume_qualification(checker, syntax, resolution, typing, type_handle, bound);
        transition checking {
            true -> qualified_local(checker, syntax, resolution, typing, statement, type_handle, value),
            _ -> done()
        }
    }

    machine qualified_local(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, type_handle: u64 in Trapping, value: |evaluation|::Value) {
        |qualification|::require_qualification(checker, syntax, resolution, typing, type_handle, statement.value, value, statement.source_span);
    }

    machine assignment(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        statement: |syntax_trees|::Statement,
        checking: bool
    ) {
        let epoch: u64 in Trapping = checker.write_epoch;
        evaluate_tree(checker, syntax, resolution, typing, statement.target, checking);
        let target: |evaluation|::Value = |evaluation|::value_at(checker, statement.target);
        let owner: u64 in Trapping = |places|::window_owner(checker, syntax, typing, target.place);
        // The target's tree values live only while its tree is the frame;
        // the value's evaluation replaces that frame, so a destination
        // without a place (an element) resolves its storage origin now.
        let origin: u64 in Trapping = |references|::store_origin(checker, syntax, resolution, typing, statement.target);
        evaluate_tree(checker, syntax, resolution, typing, statement.value, checking);
        let value: |evaluation|::Value = |evaluation|::value_at(checker, statement.value);
        let destination: u64 in Trapping = |typed_trees|::typing_expression_type(typing, statement.target);
        |qualification|::require_stored_qualification(checker, syntax, resolution, typing, destination, statement.value, value, statement.source_span, checking);
        let replayable: bool = alias_replayable(checker, syntax, resolution, typing, statement.value, target.place, epoch);
        store_value(checker, syntax, resolution, typing, statement, target, value, origin);
        let captured: |evaluation|::Value = |evaluation|::value_at(checker, statement.value);
        |aliases|::record_alias(checker, syntax, typing, target.place, statement.value, captured, replayable);
        transition owner > 0 {
            true -> window(checker, syntax, resolution, typing, statement, target.place, owner, checking),
            _ -> done()
        }
    }

    // We check the data's `requires` facts again after the field store.
    // During checking, the store is refused if those facts cannot be proved
    // for the updated fields
    // (wiki/spec/language/dependent_values.md#invariant-windows).
    machine window(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        statement: |syntax_trees|::Statement,
        written: u64 in Trapping,
        owner: u64 in Trapping,
        checking: bool
    ) {
        let closed: bool = |domains|::domain_holds(checker, syntax, resolution, typing, written);
        transition closed {
            true -> restored(checker, written),
            _ -> open_window(checker, statement, checking)
        }
    }

    machine restored(checker: @mutable |checker|::Checker, written: u64 in Trapping) {
        |domains|::reopen_domains(checker, written);
    }

    machine open_window(checker: @mutable |checker|::Checker, statement: |syntax_trees|::Statement, checking: bool) {
        transition checking {
            true -> unclosed(checker, statement),
            _ -> done()
        }
    }

    machine unclosed(checker: @mutable |checker|::Checker, statement: |syntax_trees|::Statement) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::DomainUnproven, statement.source_span);
    }

    // A crash ends the path: nothing after it runs.
    machine crashed(checker: @mutable |checker|::Checker, statement: |syntax_trees|::Statement) {
        transition statement.cause {
            |syntax_trees|::CrashCause::Trap -> trapped(checker),
            |syntax_trees|::CrashCause::Abort -> aborted(checker)
        }
    }

    machine trapped(checker: @mutable |checker|::Checker) {
        checker.trap_route = true;
        checker.zone.infeasible = true;
    }

    machine aborted(checker: @mutable |checker|::Checker) {
        checker.abort_route = true;
        checker.zone.infeasible = true;
    }

    machine transition_statement(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        statement: |syntax_trees|::Statement,
        checking: bool
    ) {
        walk_transition(checker, syntax, resolution, typing, statement, checking);
    }

    machine evaluated(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        statement: |syntax_trees|::Statement,
        checking: bool
    ) {
        evaluate_tree(checker, syntax, resolution, typing, statement.value, checking);
    }

    machine done() {}
}

// Replay is valid only while the expression still denotes the value read.
// A call write during evaluation rules it out. The destination must also
// not overwrite a scalar read of the expression (flag = !flag). Inspect a
// proof-only copy before binding: assignment target evaluation has already
// replaced the RHS tree, so its transient value slots cannot be consulted.
// Nested proof evaluation preserves the caller's frame and has no effects.
machine alias_replayable(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping, destination: u64 in Trapping, epoch: u64 in Trapping) -> bool
crashes Trap
{
    let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, root);
    transition epoch == checker.write_epoch && type_handle == typing.boolean && destination > 0 {
        true -> sized(checker, syntax, resolution, typing, root, destination),
        _ -> answer(false)
    }

    machine sized(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping, destination: u64 in Trapping) -> bool {
        let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
        let size: u64 in Trapping = root - tree.first_row + 1;
        let base: u64 in Trapping = next_base(checker);
        transition base + size <= 4096 && checker.frame_count < 8 {
            true -> framed(checker, syntax, resolution, typing, root, destination, tree.first_row, size, base),
            _ -> answer(false)
        }
    }

    machine framed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping, destination: u64 in Trapping, low: u64 in Trapping, size: u64 in Trapping, base: u64 in Trapping) -> bool {
        checker_push_frame(checker);
        checker.tree_base = base;
        checker.tree_low = low;
        checker.tree_size = size;
        checker.context_first = checker.context_count;
        |fact_values|::evaluate_fact_run(checker, syntax, resolution, typing, root, low);
        let reads: bool = tree_reads_place(checker, root, low, destination);
        checker_pop_frame(checker);
        !reads
    }

    machine answer(replayable: bool) -> bool {
        replayable
    }
}

// A field receiver names storage; it does not read every field of that
// storage. Scalar subjects distinguish guard.count from the destination
// guard.valid, preserving aliases assigned into independent fields.
machine tree_reads_place(checker: @|checker|::Checker, root: u64 in Trapping, low: u64 in Trapping, destination: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> node(checker, root, destination, low) }

    machine node(checker: @|checker|::Checker, root: u64 in Trapping, destination: u64 in Trapping, handle: u64 in Trapping) -> bool {
        transition handle <= root {
            true -> inspected(checker, root, destination, handle),
            _ -> answer(false)
        }
    }

    machine inspected(checker: @|checker|::Checker, root: u64 in Trapping, destination: u64 in Trapping, handle: u64 in Trapping) -> bool {
        let value: |evaluation|::Value = |evaluation|::value_at(checker, handle);
        let owner: u64 in Trapping = |places|::subject_place(checker, value.subject);
        let reads: bool = value.known && value.subject > 0 && owner > 0 && |places|::checker_within(checker, owner, destination);
        transition reads {
            true -> answer(true),
            _ -> node(checker, root, destination, handle + 1)
        }
    }

    machine answer(reads: bool) -> bool {
        reads
    }
}

// An untracked array element still writes its collection. A reference with
// no captured origin may alias any live place; refuse that write until its
// footprint can be represented instead of leaving unrelated-looking facts.
// Store `value` at the target: a located place binds it; an element or
// other placeless destination forgets what its storage `origin` (resolved
// while the target's tree was the frame) held.
machine store_value(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, target: |evaluation|::Value, value: |evaluation|::Value, origin: u64 in Trapping)
crashes Trap
{
    let replaced: bool = |references|::replace_reference(checker, syntax, resolution, typing, statement, value);
    transition replaced {
        true -> done(),
        _ -> destination(checker, syntax, typing, statement, target, origin)
    }

    machine destination(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, target: |evaluation|::Value, origin: u64 in Trapping) {
        transition target.place > 0 {
            true -> located(checker, syntax, typing, statement, target.place),
            _ -> containing(checker, syntax, typing, statement, origin)
        }
    }

    // A store through a recast view of another carrier
    // (wiki/spec/layouts/recasts.md) writes bits the storage's own carrier
    // does not read back as the stored value: the storage is forgotten.
    machine located(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, place: u64 in Trapping) {
        |reference_writes|::prepare_reference_store(checker, syntax, typing, statement, place);
        let storage: |places|::Place = |places|::place_at(checker, place - 1);
        let destination: u64 in Trapping = |typed_trees|::typing_expression_type(typing, statement.target);
        let written: u64 in Trapping = |evaluation|::checker_read_type(typing, destination);
        let storing: |symbol_resolved_trees|::BuiltinType = |places|::checker_carrier(typing, written);
        let holding: |symbol_resolved_trees|::BuiltinType = |places|::place_carrier(typing, storage.kind, storage.type_handle);
        transition storing == holding {
            true -> bound(checker, syntax, typing, statement, place),
            _ -> whole(checker, typing, place)
        }
    }

    machine bound(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, place: u64 in Trapping) {
        let captured: |evaluation|::Value = |evaluation|::value_at(checker, statement.value);
        bind_place(checker, typing, place, captured);
    }

    machine containing(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, origin: u64 in Trapping) {
        transition origin > 0 {
            true -> prepared(checker, syntax, typing, statement, origin),
            _ -> unknown(checker, statement)
        }
    }

    machine prepared(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, origin: u64 in Trapping) {
        |reference_writes|::prepare_reference_store(checker, syntax, typing, statement, origin);
        transition { _ -> forgotten(checker, typing, origin) }
    }

    machine forgotten(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, origin: u64 in Trapping) {
        let place: |places|::Place = |places|::place_at(checker, origin - 1);
        let row: |typed_trees|::TypeRow = |obligations|::referent_row(typing, place.type_handle);
        transition row.kind == |typed_trees|::TypeKind::Array || row.kind == |typed_trees|::TypeKind::Slice {
            true -> contents(checker, typing, origin),
            _ -> whole(checker, typing, origin)
        }
    }

    // The missing element place still identifies its collection footprint.
    // This store preserves the collection's own length, unlike replacing it.
    machine contents(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, origin: u64 in Trapping) {
        |places|::forget_contents(checker, typing, origin);
    }

    machine whole(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, origin: u64 in Trapping) {
        |places|::forget_place(checker, typing, origin);
    }

    machine unknown(checker: @mutable |checker|::Checker, statement: |syntax_trees|::Statement) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::UnsupportedCheck, statement.source_span);
    }

    machine done() {}
}

// A place takes a new value: its old facts and those of everything inside
// it are forgotten, and an integer place takes the value's term or
// interval.
public machine bind_place(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping, value: |evaluation|::Value)
crashes Trap
{
    transition place > 0 {
        true -> forget(checker, typing, place, value),
        _ -> done()
    }

    // A value whose term names a subject inside the overwritten place, the
    // place's own included (`x = x + 1`), names the old contents: after the
    // place is forgotten that subject stands for the new ones, so only the
    // value's interval, read before forgetting, carries over.
    machine forget(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping, value: |evaluation|::Value) {
        let owner: u64 in Trapping = |places|::subject_place(checker, value.subject);
        let inside: bool = |places|::checker_within(checker, owner, place);
        let stale: bool = value.known && value.subject > 0 && (owner == 0 || inside);
        |places|::forget_place(checker, typing, place);
        forget_origins(checker, typing, place, value.place);
        |places|::copy_fields(checker, typing, place, value.place);
        let entry: |places|::Place = |places|::place_at(checker, place - 1);
        transition entry.subject > 0 {
            true -> rebound(checker, entry.subject, value, stale),
            _ -> done()
        }
    }

    machine forget_origins(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping, source: u64 in Trapping) {
        transition place != source { true -> replaced(checker, typing, place), false -> {} }
    }
    machine replaced(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping) {
        |reference_origins|::forget_reference_origins(checker, typing, place);
    }

    machine rebound(checker: @mutable |checker|::Checker, subject: u64 in Trapping, value: |evaluation|::Value, stale: bool) {
        transition stale {
            true -> ranged(checker, subject, value),
            _ -> bound(checker, subject, value)
        }
    }

    // subject <= ceiling and -subject <= floor (the floor is stored negated).
    machine ranged(checker: @mutable |checker|::Checker, subject: u64 in Trapping, value: |evaluation|::Value) {
        |zone|::constrain(@mutable checker.zone, 0 as +Trapping, subject, value.ceiling);
        |zone|::constrain(@mutable checker.zone, subject, 0 as +Trapping, value.floor);
    }

    // subject - value <= 0 and value - subject <= 0.
    machine bound(checker: @mutable |checker|::Checker, subject: u64 in Trapping, value: |evaluation|::Value) {
        let zero: |integers|::ExactInteger = |integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping };
        let unknown: |evaluation|::Value = |evaluation|::value_unknown();
        let own: |evaluation|::Value = |evaluation|::Value { place: 0 as +Trapping, known: true, subject: subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        |facts|::constrain_difference(checker, own, value, zero);
        |facts|::constrain_difference(checker, value, own, zero);
    }

    machine done() {}
}

// A transition: the subject once, then each arm under its selection's
// facts, every earlier guard failing.
machine walk_transition(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    statement: |syntax_trees|::Statement,
    checking: bool
)
crashes Trap
{
    transition statement.has_value {
        true -> subject(checker, syntax, resolution, typing, statement, checking),
        _ -> arms(checker, syntax, resolution, typing, statement, checking)
    }

    machine subject(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        statement: |syntax_trees|::Statement,
        checking: bool
    ) {
        evaluate_tree(checker, syntax, resolution, typing, statement.value, checking);
        transition checker.output.machine_accepted {
            true -> captured_subject(checker, syntax, resolution, typing, statement, checking),
            _ -> done()
        }
    }
    machine captured_subject(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, checking: bool) {
        let previous: u64 in Trapping = checker.bound_subject;
        let previous_value: |evaluation|::Value = checker.bound_value;
        checker.bound_subject = statement.value + 1;
        checker.bound_value = |evaluation|::value_interval(|evaluation|::value_at(checker, statement.value));
        arms(checker, syntax, resolution, typing, statement, checking);
        checker.bound_subject = previous;
        checker.bound_value = previous_value;
    }
    machine done() {}

    machine arms(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        statement: |syntax_trees|::Statement,
        checking: bool
    ) {
        let captured: CapturedSubject = |snapshots|::capture_subject(checker, syntax, typing, statement.value, statement.has_value);
        let saved: bool = save_zone(checker, 0 as +Trapping);
        transition saved {
            true -> arm(checker, syntax, resolution, typing, statement, 0 as +Trapping, checking, captured),
            _ -> overflow(checker, statement, captured.floor)
        }
    }

    machine arm(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        statement: |syntax_trees|::Statement,
        offset: u64 in Trapping,
        checking: bool,
        captured: CapturedSubject
    ) {
        transition offset < statement.arm_count && checker.output.machine_accepted {
            true -> selected(checker, syntax, resolution, typing, statement, offset, checking, captured),
            _ -> finished(checker, captured.floor)
        }
    }

    machine selected(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        statement: |syntax_trees|::Statement,
        offset: u64 in Trapping,
        checking: bool,
        captured: CapturedSubject
    ) {
        let current_arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_arm(syntax, statement.first_arm + offset);
        restore_zone(checker);
        select_arm(checker, syntax, resolution, typing, statement, current_arm, true, checking, captured);
        select_guard(checker, syntax, resolution, typing, current_arm, true, checking);
        walk_target(checker, syntax, resolution, typing, current_arm, checking);
        restore_zone(checker);
        select_arm(checker, syntax, resolution, typing, statement, current_arm, false, checking, captured);
        select_guard(checker, syntax, resolution, typing, current_arm, false, checking);
        resave_zone(checker);
        transition { _ -> arm(checker, syntax, resolution, typing, statement, offset + 1, checking, captured) }
    }

    // Typing proved the arms cover the subject (pipeline/symbol_resolved_trees_to_typed_trees/coverage.omg): no
    // path passes over every arm.
    machine finished(checker: @mutable |checker|::Checker, floor: u64 in Trapping) {
        checker.retained_values = floor;
        drop_saved(checker);
        checker.zone.infeasible = true;
    }

    machine overflow(checker: @mutable |checker|::Checker, statement: |syntax_trees|::Statement, floor: u64 in Trapping) {
        checker.retained_values = floor;
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::CheckCapacityExceeded, statement.source_span);
    }
}

// An arm's `if` guard, evaluated after its pattern's facts and binders:
// the guard holds on the selected arm. Passing over the arm establishes
// its failure only where the pattern alone always matched (`_`); after any
// other pattern the subject may have failed to match instead.
public machine select_guard(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    arm: |syntax_trees|::TransitionArm,
    chosen: bool,
    checking: bool
)
crashes Trap
{
    transition arm.has_guard && (chosen || arm.kind == |syntax_trees|::ArmPatternKind::Wildcard || arm.kind == |syntax_trees|::ArmPatternKind::Binder) {
        true -> evaluated(checker, syntax, resolution, typing, arm, chosen, checking),
        _ -> done()
    }

    machine evaluated(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, arm: |syntax_trees|::TransitionArm, chosen: bool, checking: bool) {
        evaluate_tree(checker, syntax, resolution, typing, arm.guard, checking);
        |facts|::assume(checker, syntax, arm.guard, chosen);
        |aliases|::assume_alias(checker, syntax, resolution, typing, arm.guard, chosen);
    }

    machine done() {}
}

// Selection uses the subject evaluated before dispatch. A guard may have
// changed its source, and a target may have evaluated a different tree.
machine select_arm(
    checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, arm: |syntax_trees|::TransitionArm, chosen: bool,
    checking: bool, captured: CapturedSubject
)
crashes Trap
{
    transition arm.kind {
        |syntax_trees|::ArmPatternKind::Guard -> guard(checker, syntax, resolution, typing, statement, arm, chosen, checking),
        |syntax_trees|::ArmPatternKind::Literal -> literal(checker, syntax, resolution, typing, statement, arm, chosen, captured),
        |syntax_trees|::ArmPatternKind::Case -> pattern(checker, syntax, resolution, typing, statement, arm, chosen, captured),
        _ -> done()
    }

    machine guard(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, arm: |syntax_trees|::TransitionArm, chosen: bool, checking: bool) {
        evaluate_tree(checker, syntax, resolution, typing, arm.pattern, checking);
        let unknown: |evaluation|::Value = |evaluation|::value_unknown();
        arm_facts(checker, syntax, resolution, typing, statement.value, unknown, arm, chosen);
        |aliases|::assume_alias(checker, syntax, resolution, typing, arm.pattern, chosen);
    }

    machine literal(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, arm: |syntax_trees|::TransitionArm, chosen: bool, captured: CapturedSubject) {
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.pattern);
        let unknown: |evaluation|::Value = |evaluation|::value_unknown();
        transition written.kind == |syntax_trees|::ExpressionKind::Boolean {
            true -> assumed(checker, syntax, resolution, typing, statement, arm, chosen, captured, unknown),
            _ -> pattern(checker, syntax, resolution, typing, statement, arm, chosen, captured)
        }
    }

    machine pattern(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, arm: |syntax_trees|::TransitionArm, chosen: bool, captured: CapturedSubject) {
        transition chosen {
            true -> evaluated(checker, syntax, resolution, typing, statement, arm, captured),
            _ -> done()
        }
    }

    machine evaluated(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, arm: |syntax_trees|::TransitionArm, captured: CapturedSubject) {
        replay_tree(checker, syntax, resolution, typing, arm.pattern);
        let pattern: |evaluation|::Value = |evaluation|::value_at(checker, arm.pattern);
        transition { _ -> assumed(checker, syntax, resolution, typing, statement, arm, true, captured, pattern) }
    }

    machine assumed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, statement: |syntax_trees|::Statement, arm: |syntax_trees|::TransitionArm, chosen: bool, captured: CapturedSubject, pattern: |evaluation|::Value) {
        restore_tree(checker, captured.frame);
        arm_facts(checker, syntax, resolution, typing, statement.value, pattern, arm, chosen);
        |aliases|::assume_subject_alias(checker, syntax, resolution, typing, statement.value, arm, chosen);
    }

    machine done() {}
}

// The facts of an arm being selected (`chosen`) or passed over, from the
// current values of its subject and patterns (`pattern` is a value
// pattern's): a guard holds or fails, a Boolean literal arm makes the
// subject hold or fail, and another value pattern, an integer literal or a
// path denoting no case, makes the subject equal it. Passing over a value
// pattern establishes nothing. A case arm's binders are places of their
// payload types; a case states no facts of its own.
public machine arm_facts(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    subject: u64 in Trapping,
    pattern: |evaluation|::Value,
    arm: |syntax_trees|::TransitionArm,
    chosen: bool
)
crashes Trap
{
    transition arm.kind {
        |syntax_trees|::ArmPatternKind::Guard -> assumed(checker, syntax, arm.pattern, chosen),
        |syntax_trees|::ArmPatternKind::Literal -> literal(checker, syntax, subject, pattern, arm, chosen),
        |syntax_trees|::ArmPatternKind::Case -> case_arm(checker, syntax, resolution, typing, subject, pattern, arm, chosen),
        _ -> done()
    }

    machine assumed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, root: u64 in Trapping, holds: bool) {
        |facts|::assume(checker, syntax, root, holds);
    }

    // `true -> ...` over a Boolean subject: the subject holds when chosen;
    // `false -> ...` the reverse.
    machine literal(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, subject: u64 in Trapping, pattern: |evaluation|::Value, arm: |syntax_trees|::TransitionArm, chosen: bool) {
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.pattern);
        let holds: bool = written.flag == chosen;
        transition written.kind == |syntax_trees|::ExpressionKind::Boolean {
            true -> assumed(checker, syntax, subject, holds),
            _ -> integer(checker, subject, pattern, chosen)
        }
    }

    machine integer(checker: @mutable |checker|::Checker, subject: u64 in Trapping, pattern: |evaluation|::Value, chosen: bool) {
        transition chosen {
            true -> equal(checker, subject, pattern),
            _ -> done()
        }
    }

    machine equal(checker: @mutable |checker|::Checker, subject: u64 in Trapping, pattern: |evaluation|::Value) {
        let subject_value: |evaluation|::Value = |evaluation|::value_at(checker, subject);
        let zero: |integers|::ExactInteger = |integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping };
        |facts|::constrain_difference(checker, subject_value, pattern, zero);
        |facts|::constrain_difference(checker, pattern, subject_value, zero);
    }

    machine case_arm(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        subject: u64 in Trapping,
        pattern: |evaluation|::Value,
        arm: |syntax_trees|::TransitionArm,
        chosen: bool
    ) {
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, arm.pattern);
        transition chosen {
            true -> matched(checker, subject, pattern, binding),
            _ -> done()
        }
    }

    // A case pattern carries no facts of its own (the data declaration's
    // `requires` states every case condition); a path denoting no case is
    // a value pattern, which the subject equals.
    machine matched(checker: @mutable |checker|::Checker, subject: u64 in Trapping, pattern: |evaluation|::Value, binding: |symbol_resolved_trees|::ValueBinding) {
        transition binding {
            |symbol_resolved_trees|::ValueBinding::DataCase { item, data_case } -> done(),
            _ -> equal(checker, subject, pattern)
        }
    }

    machine done() {}
}

// An arm's target: a jump contributes its arguments' facts to its state's
// arrival; a terminal call or value is evaluated where it completes, and it
// and the Unit completion `{}` return, owing the machine's `ensures` facts.
machine walk_target(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    arm: |syntax_trees|::TransitionArm,
    checking: bool
)
crashes Trap
{
    transition checker.zone.infeasible {
        true -> done(),
        _ -> feasible(checker, syntax, resolution, typing, arm, checking)
    }

    machine feasible(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        arm: |syntax_trees|::TransitionArm,
        checking: bool
    ) {
        transition arm.target_kind == |syntax_trees|::ArmTargetKind::Unit {
            true -> completed(checker, syntax, resolution, typing, arm, checking),
            _ -> evaluated(checker, syntax, resolution, typing, arm, checking)
        }
    }

    machine completed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, arm: |syntax_trees|::TransitionArm, checking: bool) {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        |completions|::observe_normal_completion(checker, value);
        transition checking {
            true -> owed(checker, syntax, resolution, typing, arm, value),
            _ -> done()
        }
    }

    machine owed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, arm: |syntax_trees|::TransitionArm, value: |evaluation|::Value) {
        |contracts|::require_guarantees(checker, syntax, resolution, typing, value, arm.source_span);
    }

    machine evaluated(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        arm: |syntax_trees|::TransitionArm,
        checking: bool
    ) {
        evaluate_tree(checker, syntax, resolution, typing, arm.target, checking);
        let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, arm.target);
        transition selection {
            _ -> terminal(checker, syntax, resolution, typing, arm, checking)
        }
    }

    machine terminal(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, arm: |syntax_trees|::TransitionArm, checking: bool) {
        let value: |evaluation|::Value = |evaluation|::value_at(checker, arm.target);
        |completions|::observe_normal_completion(checker, value);
        transition checking {
            true -> returned(checker, syntax, resolution, typing, arm, value),
            _ -> done()
        }
    }

    // A returned value meets the result's qualification and its machine's
    // `ensures` facts.
    machine returned(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, arm: |syntax_trees|::TransitionArm, value: |evaluation|::Value) {
        |qualification|::require_result_qualification(checker, syntax, resolution, typing, arm.target, value, arm.source_span);
        transition { _ -> owed(checker, syntax, resolution, typing, arm, value) }
    }

    machine done() {}
}
