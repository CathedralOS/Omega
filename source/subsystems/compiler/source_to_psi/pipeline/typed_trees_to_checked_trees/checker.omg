use representations\typed_trees\type_table_row;

// Checking over a typed source set (representations/checks/checks.omg). Every machine declaration
// owns its parameters, executable range, result and contract. Private invocation
// arrivals gather exact argument facts to a fixed point; every reached body is
// checked against the join of all its predecessors, widening recurrent edges.
// An uninvoked declaration is independently checked under its own parameters
// and requirements. Lexical ancestry locates declarations but supplies no facts.
// Crash routes and termination settle over the selected call graph, then each
// satisfaction must refine its declared requirement. One rejected declaration
// does not prevent independent declarations from reporting their obligations.
public data Checker {
    output: Checks;
    // The body being walked: its places, its integer subjects and its zone.
    places: [Place; 256];
    place_count: u64;
    // Reference descriptors retain live storage identity independently of
    // owned scalar snapshots, including inside copied aggregate values.
    reference_origins: [ReferenceOrigin; 256];
    // Append-only per-body result rosters: old aliases retain their group
    // when a later publication reuses a call place.
    reference_views: [ReferenceView; 256];
    reference_view_count: u64 in Trapping;
    reference_backings: [ReferenceOrigin; 256];
    reference_backing_count: u64 in Trapping;
    // Each place's default domain (domains.omg), and the place whose fields a
    // `requires` fact's field names stand for while it is installed.
    domains: [DomainMark; 256];
    domains_pending: bool;
    fields_parent: u64 in Trapping;
    subject_count: u64;
    overflowed: bool;
    zone: Zone;
    // The trees being evaluated, innermost last: each node's value at the
    // tree's base plus its offset from the tree's lowest handle, and where
    // its `&&`/`||` right operands begin. A tree evaluated while another is
    // open, such as a callee's `requires` fact, takes the values and
    // contexts above its caller's.
    values: [Value; 4096];
    tree_base: u64 in Trapping;
    tree_low: u64 in Trapping;
    tree_size: u64 in Trapping;
    frames: [TreeFrame; 8];
    frame_count: u64;
    replay: bool;
    // Statement trees use scratch above every retained dispatch subject.
    // Their evaluated values survive guards and targets without replay.
    retained_values: u64 in Trapping;
    // A transition target or guard evaluates in a different tree frame.
    bound_subject: u64 in Trapping;
    bound_value: Value;
    // Monotone through one machine's walks, including branch restoration.
    // A nonempty call write frame advances it; proof-only nested trees and
    // bookkeeping copies do not. Replay requires unchanged storage.
    write_epoch: u64 in Trapping;
    context_starts: [u64; 64];
    context_operators: [u64; 64];
    context_first: u64;
    context_count: u64;
    // The tree's value-position matches (matches.omg), each with its next
    // arm event pending.
    matches: [u64; 16];
    match_events: [u64; 16];
    match_count: u64;
    assumptions: [u64; 128];
    assumption_count: u64;
    // Saved zones: open `&&`/`||` contexts, transition arms and matches.
    saved: [Zone; 8];
    saved_owners: [u64; 8];
    saved_count: u64;
    // The machine being checked: its private callees' arrival facts and the
    // worklist of declarations whose arrival loosened.
    terminal_calls: [bool; 131072];
    machine: u64 in Trapping;
    graph_root: u64 in Trapping;
    bodies: [u64; 128];
    body_count: u64 in Trapping;
    arrivals: [Zone; 128];
    reached: [bool; 128];
    loosenings: [u64; 128];
    // The order in which declarations were first reached, and the body being
    // walked (zero for the entry, a declaration's offset plus one): a jump into a
    // declaration reached no later than its own is a back edge, and only a back
    // edge's target widens, since every cycle has one.
    discovery: [u64; 128];
    discovered: u64;
    walking: u64;
    queued: [bool; 128];
    queue: [u64; 128];
    queue_count: u64;
    projection: [Value; 64];
    // Each declaration's arrival field paths (arrivals.omg), 40 per declaration.
    paths: [ArrivalPath; 5120];
    path_counts: [u64; 128];
    // While a target's `requires` facts are decided, its parameters from
    // `argument_first` stand for these argument values.
    arguments: [Value; 64];
    argument_first: u64 in Trapping;
    argument_count: u64 in Trapping;
    substituting: bool;
    // While a machine's `ensures` facts are decided, `result` stands for
    // `returned`: what one of its returns produces, or a call's result.
    returned: Value;
    returning: bool;
    // While a domain's predicates are decided, its subject binder stands
    // for `subject` (qualification.omg).
    subject: Value;
    subjecting: bool;
    // While a quoted literal's qualification is decided, its predicate roster
    // answers the domain's byte predicates of the subject.
    subject_literal: bool;
    subject_roster: u64 in Trapping;
    // While a return's result is decided, the machine being checked is the
    // origin of the routed domains that name it (qualification.omg).
    minting: bool;
    // Whether the body being walked computes a rank: a measure's body is a
    // mathematical computation over naturals
    // (wiki/spec/language/termination.md#ranking), so its fixed-integer
    // results are exact rather than carrier obligations.
    exact_body: bool;
    // While a construction's `requires` facts are decided, the fields from
    // `field_first` stand for the same argument values.
    field_values: bool;
    field_first: u64 in Trapping;
    contribution: Zone;
    // Scratch copies: a runtime-indexed zone is copied out before an
    // operation borrows it and stored back after.
    previous: Zone;
    merged: Zone;
    // The current zone while a saved one takes an established value's
    // domain facts (domains.omg).
    stashed: Zone;
    trap_route: bool;
    abort_route: bool;
    // Universal, own-entry completion queries share the exact invocation graph.
    invocations: InvocationGraph;
    completions: [NumericCompletion; 10240];
    entry_rank: NormalizedRank;
    entry_rank_bounds: RankBounds;
    entry_rank_has_range: bool;
    collecting_completion: bool;
    completion_seen: bool;
    completion_value: Value;
    // Machine calls, caller and callee, for settling crash routes.
    callers: [u64; 32768];
    callees: [u64; 32768];
    call_count: u64;
    // Calls supplying static machine arguments, refined against their
    // binders' contracts once crash routes settle (supply.omg).
    supplied: [SuppliedCall; 1024];
    supplied_count: u64;
    // Write frames (frames.omg): per parameter, whether its body may replace
    // an exclusive parameter's whole referent; per machine, whether its
    // writes are unknown, and the data fields it may write, a row of 1,024
    // per machine.
    whole_writes: [bool; 32768];
    unknown_writes: [bool; 10240];
    // Exact 1,024-field sets use sixteen words per declaration, below the old 2 MiB budget.
    field_writes: [u64; 163840];
    // Per declaration, completed global component/termination summaries.
    binder_calls: [bool; 10240];
    terminating: [bool; 10240];
    components_done: [bool; 10240];
    rank_reported: [bool; 10240];
    // The ownership walk of the body being checked (ownership.omg).
    ownership: Ownership;
    // Boolean aliases (aliases.omg): each aliased place, the condition it
    // stands for and how many places existed when it was bound.
    aliases: AliasTable;
    saved_aliases: [AliasTable; 8];
    // Fields constructions wrote that no place holds yet (constructions.omg).
    pending: [PendingField; 32];
    pending_count: u64;
}

public machine checker_check(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing)
crashes Trap
{
    checker_clear(checker, syntax);
    initialize_terminal_calls(checker, syntax);
    derive_frames(checker, syntax, resolution, typing);
    derive_completions(checker, syntax, resolution, typing);
    transition { _ -> next_machine(checker, syntax, resolution, typing, 0) }

    machine next_machine(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping) {
        transition index < syntax.machine_count && checker.output.diagnostic_count < 64 {
            true -> machine(checker, syntax, resolution, typing, index),
            _ -> settle(checker, syntax, resolution, typing)
        }
    }

    machine machine(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, index);
        transition item.has_body && item.parent == 0 {
            true -> body(checker, syntax, resolution, typing, index),
            _ -> next_machine(checker, syntax, resolution, typing, index + 1)
        }
    }

    machine body(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping) {
        check_machine(checker, syntax, resolution, typing, index);
        transition { _ -> next_machine(checker, syntax, resolution, typing, index + 1) }
    }

    // A body that rejected may have stopped before some of its crash sites;
    // its routes are then a subset of what it derives, so settling them
    // finds no cause that a whole walk would not.
    machine settle(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing) {
        settle_routes(checker, syntax);
        settle_termination(checker, syntax, resolution);
        check_service_ceilings(checker, syntax, resolution);
        check_supply(checker, syntax, resolution, typing);
        project_slots(checker, syntax, typing);
    }
}

// An accepted, empty result, with every machine's declared crash causes.
machine checker_clear(checker: @mutable Checker, syntax: @SyntaxTrees)
crashes Trap
{
    checker.output.accepted = true;
    checker.output.machine_accepted = true;
    checker.output.diagnostic_count = 0;
    checker.output.obligation_count = 0;
    clear_slot_records(@mutable checker.output);
    checker.output.machine_count = syntax.machine_count;
    checker.call_count = 0;
    checker.supplied_count = 0;
    transition { _ -> next(checker, syntax, 0) }

    machine next(checker: @mutable Checker, syntax: @SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> declared(checker, syntax, index),
            _ -> done()
        }
    }

    machine declared(checker: @mutable Checker, syntax: @SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, index);
        let routes: CrashRoutes = declared_routes(syntax, item);
        set_routes(@mutable checker.output, index, routes);
        reset_termination(checker, index);
        transition { _ -> next(checker, syntax, index + 1) }
    }

    machine done() {}
}

// A machine's declared crash causes. A private machine with a body and no
// crash clause asks for inference.
machine declared_routes(syntax: @SyntaxTrees, item: MachineItem) -> CrashRoutes
crashes Trap
{
    crash_ceiling(syntax, item.first_clause, item.clause_count, !item.is_public && item.has_body)
}

public machine declared_causes(syntax: @SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping) -> CrashRoutes
crashes Trap
{
    crash_ceiling(syntax, first, count, false)
}

machine crash_ceiling(syntax: @SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, infer_omitted: bool) -> CrashRoutes
crashes Trap
{
    let routes: CrashRoutes = CrashRoutes {
        declares_trap: false, declares_abort: false, inferred: infer_omitted, trap: false, abort: false
    };
    transition { _ -> next(syntax, first, first + count, routes) }

    machine next(syntax: @SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping, routes: CrashRoutes) -> CrashRoutes {
        transition index < end {
            true -> clause(syntax, index, end, routes),
            _ -> finished(routes)
        }
    }

    machine clause(syntax: @SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping, routes: CrashRoutes) -> CrashRoutes {
        let clause: Clause = syntax_trees_clause(syntax, index);
        let mutable updated: CrashRoutes = routes;
        declared_crash_clause(@mutable updated, clause);
        transition { _ -> next(syntax, index + 1, end, updated) }
    }

    machine finished(routes: CrashRoutes) -> CrashRoutes { routes }
}

machine declared_crash_clause(routes: @mutable CrashRoutes, clause: Clause) {
    transition clause.kind {
        ClauseKind::CrashesNone -> empty(routes),
        ClauseKind::Crashes -> cause(routes, clause),
        _ -> done()
    }
    machine cause(routes: @mutable CrashRoutes, clause: Clause) {
        transition clause.cause {
            CrashCause::Trap -> trap(routes),
            CrashCause::Abort -> abort(routes)
        }
    }
    machine empty(routes: @mutable CrashRoutes) { routes.inferred = false; }
    machine trap(routes: @mutable CrashRoutes) {
        routes.inferred = false;
        routes.declares_trap = true;
    }
    machine abort(routes: @mutable CrashRoutes) {
        routes.inferred = false;
        routes.declares_abort = true;
    }
    machine done() {}
}

// One machine: gather facts to a fixed point, then check every body,
// then publish its local crash routes.
public machine check_machine(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping)
crashes Trap
{
    let item: MachineItem = machine_item(syntax, index);
    open_machine(@mutable checker.output);
    prepare_body(checker, item, index);
    collect_bodies(checker, syntax, index);
    checker.trap_route = false;
    checker.abort_route = false;
    checker.queue_count = 0;
    checker.discovered = 0;
    checker.walking = 0;
    transition checker.body_count <= 128 && !checker.overflowed {
        true -> cleared(checker, syntax, resolution, typing, index, item),
        _ -> too_many(checker, item)
    }

    machine cleared(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping, item: MachineItem) {
        transition { _ -> arrivals(checker, syntax, resolution, typing, index, item, 0) }
    }

    machine arrivals(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        transition offset < checker.body_count {
            true -> unreached(checker, syntax, resolution, typing, index, item, offset),
            _ -> explore(checker, syntax, resolution, typing, index, item)
        }
    }

    machine unreached(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        reset_arrival(checker, offset);
        transition { _ -> arrivals(checker, syntax, resolution, typing, index, item, offset + 1) }
    }

    machine explore(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping, item: MachineItem) {
        derive_demand(checker, syntax, resolution, typing, item);
        open_entry(checker, syntax, resolution, typing, item);
        walk_body(checker, syntax, resolution, typing, item.first_statement, item.statement_count, false);
        transition { _ -> drain(checker, syntax, resolution, typing, index, item) }
    }

    machine drain(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping, item: MachineItem) {
        transition checker.queue_count > 0 && checker.output.machine_accepted {
            true -> revisit(checker, syntax, resolution, typing, index, item),
            _ -> closed(checker, syntax, resolution, typing, index, item)
        }
    }

    // The fact-gathering walks took every edge the checking walk can.
    machine closed(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping, item: MachineItem) {
        checker.machine = index;
        transition { _ -> check_entry(checker, syntax, resolution, typing, index, item) }
    }

    machine revisit(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping, item: MachineItem) {
        let offset: u64 in Trapping = checker_dequeue(checker);
        walk_machine(checker, syntax, resolution, typing, offset, true, false);
        transition { _ -> drain(checker, syntax, resolution, typing, index, item) }
    }

    // Crash routes come from the checking walk alone: a fact-gathering walk
    // may see a site its settled facts disprove.
    machine check_entry(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping, item: MachineItem) {
        checker.machine = index;
        checker.trap_route = false;
        checker.abort_route = false;
        open_entry(checker, syntax, resolution, typing, item);
        require_rank_range_entry(checker, syntax, resolution, typing, item);
        walk_body(checker, syntax, resolution, typing, item.first_statement, item.statement_count, true);
        own_body(
            checker,
            syntax,
            resolution,
            typing,
            item.first_parameter,
            item.parameter_count,
            item.first_statement,
            item.statement_count,
            item.source_span
        );
        publish_body_routes(checker, index);
        transition { _ -> check_state(checker, syntax, resolution, typing, index, item, 0) }
    }

    machine check_state(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        transition offset < checker.body_count && checker.output.machine_accepted {
            true -> reached(checker, syntax, resolution, typing, index, item, offset),
            _ -> publish(checker, index, item)
        }
    }

    // A declaration no walk reached is still checked, from its parameters'
    // carrier ranges and its own `requires` facts alone.
    machine reached(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, index: u64 in Trapping, item: MachineItem, offset: u64 in Trapping) {
        let arrived: bool = was_reached(checker, offset);
        walk_machine(checker, syntax, resolution, typing, offset, arrived, true);
        transition { _ -> check_state(checker, syntax, resolution, typing, index, item, offset + 1) }
    }

    machine publish(checker: @mutable Checker, index: u64 in Trapping, item: MachineItem) {
        transition checker.overflowed {
            true -> overflowed(checker, item),
            _ -> done()
        }
    }

    machine overflowed(checker: @mutable Checker, item: MachineItem) {
        checks_reject(@mutable checker.output, CheckDiagnosticCode::CheckCapacityExceeded, item.source_span);
    }

    machine too_many(checker: @mutable Checker, item: MachineItem) {
        checks_reject(@mutable checker.output, CheckDiagnosticCode::CheckCapacityExceeded, item.source_span);
    }

    machine done() {}
}

// Every independent abstract walk starts with the same body-local scratch.
public machine prepare_body(checker: @mutable Checker, item: MachineItem, index: u64 in Trapping) {
    // A previous machine's rejection may have stopped its walk inside a
    // context, frame or substitution.
    checker.saved_count = 0;
    checker.frame_count = 0;
    checker.context_count = 0;
    checker.match_count = 0;
    checker.replay = false;
    checker.write_epoch = 0;
    checker.retained_values = 0;
    checker.bound_subject = 0;
    checker.bound_value = value_unknown();
    checker.substituting = false;
    checker.returning = false;
    checker.subjecting = false;
    checker.subject_literal = false;
    checker.minting = false;
    checker.exact_body = item.container == MachineContainer::Measure;
    checker.field_values = false;
    checker.domains_pending = false;
    checker.fields_parent = 0;
    checker.machine = index;
    checker.graph_root = index;
    checker.overflowed = false;
    checker.entry_rank.valid = false;
    checker.entry_rank_has_range = false;
}

// The entry body's places: its parameters, each integer one in its
// carrier's range, under the machine's `requires` facts.
public machine open_entry(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, item: MachineItem)
crashes Trap
{
    checker.walking = 0;
    open_places(checker);
    enter_parameters(checker, syntax, typing, item.first_parameter, item.parameter_count);
    assume_parameter_qualifications(checker, syntax, resolution, typing, item.first_parameter, item.parameter_count);
    assume_requirements(checker, syntax, resolution, typing, item.first_clause, item.clause_count);
    install_domains(checker, syntax, resolution, typing);
}

// A declaration's places: its parameters, in order, so its integer and Boolean
// parameters are subjects 1, 2, ... as its arrival zone numbers them, then its arrival when
// a walk reached it (`arrival`).
machine walk_machine(
    checker: @mutable Checker,
    syntax: @SyntaxTrees,
    resolution: @NameResolution,
    typing: @Typing,
    offset: u64 in Trapping,
    arrival: bool,
    checking: bool
)
crashes Trap
{
    let handle: u64 in Trapping = body_handle(checker, offset);
    let declaration: MachineItem = machine_item(syntax, handle);
    checker.machine = handle;
    checker.trap_route = false;
    checker.abort_route = false;
    let walking: u64 in Trapping = offset + 1;
    checker.walking = walking as u64;
    open_places(checker);
    enter_parameters(checker, syntax, typing, declaration.first_parameter, declaration.parameter_count);
    let numbered: bool = enter_paths(checker, typing, offset, declaration.first_parameter);
    transition numbered && arrival {
        true -> arrived(checker, syntax, resolution, typing, offset, declaration, checking),
        _ -> opened(checker, syntax, resolution, typing, declaration, checking)
    }

    machine arrived(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, offset: u64 in Trapping, declaration: MachineItem, checking: bool) {
        arrive(checker, offset);
        restore_ranges(checker, typing);
        transition { _ -> opened(checker, syntax, resolution, typing, declaration, checking) }
    }

    // A body whose paths did not take their arrival's numbering keeps only
    // its places' carrier ranges.
    machine opened(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, declaration: MachineItem, checking: bool) {
        assume_parameter_qualifications(checker, syntax, resolution, typing, declaration.first_parameter, declaration.parameter_count);
        assume_requirements(checker, syntax, resolution, typing, declaration.first_clause, declaration.clause_count);
        install_domains(checker, syntax, resolution, typing);
        require_rank_range_entry(checker, syntax, resolution, typing, declaration);
        walk_body(checker, syntax, resolution, typing, declaration.first_statement, declaration.statement_count, checking);
        transition checking {
            true -> owned(checker, syntax, resolution, typing, declaration),
            _ -> done()
        }
    }

    // The checking walk owns the body while its places are open: the
    // ownership walk (ownership.omg) reads the storage origins its
    // reference locals captured.
    machine owned(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, typing: @Typing, declaration: MachineItem) {
        own_body(
            checker,
            syntax,
            resolution,
            typing,
            declaration.first_parameter,
            declaration.parameter_count,
            declaration.first_statement,
            declaration.statement_count,
            declaration.source_span
        );
        let machine: u64 in Trapping = checker.machine;
        publish_body_routes(checker, machine);
    }

    machine done() {}
}

machine enter_parameters(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, first: u64 in Trapping, count: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(checker, syntax, typing, first, first + count) }

    machine next(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, index: u64 in Trapping, end: u64 in Trapping) {
        transition index < end {
            true -> enter(checker, syntax, typing, index, end),
            _ -> done()
        }
    }

    machine enter(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, index: u64 in Trapping, end: u64 in Trapping) {
        let place: u64 in Trapping = parameter_place(checker, syntax, typing, index);
        transition { _ -> next(checker, syntax, typing, index + 1, end) }
    }

    machine done() {}
}

// Authenticate a parameter coordinate through its actual declared type. This
// is also the root of arbitrary formal values in universal contract checking.
public machine parameter_place(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, parameter: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let written: Parameter = syntax_trees_parameter(syntax, parameter);
    let type_handle: u64 in Trapping = reference_type(typing, written.type_reference);
    checker_place(checker, typing, PlaceKind::Parameter, parameter, 0, type_handle)
}

// Machine-local declaration tables, guarded by the declaration's offset.
machine reset_arrival(checker: @mutable Checker, offset: u64 in Trapping)
crashes Trap
{
    transition offset < 128 {
        true -> reset(checker, offset),
        _ -> invalid()
    }

    machine reset(checker: @mutable Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        checker.reached[offset] = false;
        checker.queued[offset] = false;
        checker.loosenings[offset] = 0;
        checker.discovery[offset] = 0;
        checker.path_counts[offset] = 0;
    }

    machine invalid() {
        crash Trap;
    }
}

machine was_reached(checker: @Checker, offset: u64 in Trapping) -> bool
crashes Trap
{
    transition offset < 128 {
        true -> read(checker, offset),
        _ -> invalid()
    }

    machine read(checker: @Checker, offset: u64 in Trapping) -> bool
    requires offset < 128
    {
        checker.reached[offset]
    }

    machine invalid() -> bool {
        crash Trap;
    }
}

machine arrive(checker: @mutable Checker, offset: u64 in Trapping)
crashes Trap
{
    transition offset < 128 {
        true -> copy(checker, offset),
        _ -> invalid()
    }

    machine copy(checker: @mutable Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        checker.zone = checker.arrivals[offset];
    }

    machine invalid() {
        crash Trap;
    }
}

machine checker_dequeue(checker: @mutable Checker) -> u64 in Trapping
crashes Trap
{
    transition checker.queue_count > 0 {
        true -> pop(checker, checker.queue_count - 1),
        _ -> invalid()
    }

    machine pop(checker: @mutable Checker, index: u64) -> u64 in Trapping {
        transition index < 128 {
            true -> read(checker, index),
            _ -> invalid()
        }
    }

    machine read(checker: @mutable Checker, index: u64) -> u64 in Trapping
    requires index < 128
    {
        let offset: u64 = checker.queue[index];
        checker.queue_count = index;
        transition offset < 128 {
            true -> unqueued(checker, offset),
            _ -> invalid()
        }
    }

    machine unqueued(checker: @mutable Checker, offset: u64) -> u64 in Trapping
    requires offset < 128
    {
        checker.queued[offset] = false;
        offset as u64 +Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

machine checker_enqueue(checker: @mutable Checker, offset: u64 in Trapping)
crashes Trap
{
    transition offset < 128 {
        true -> candidate(checker, offset),
        _ -> invalid()
    }

    machine candidate(checker: @mutable Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        let queued: bool = checker.queued[offset];
        transition queued {
            true -> done(),
            _ -> push(checker, offset, checker.queue_count)
        }
    }

    machine push(checker: @mutable Checker, offset: u64 in Trapping, index: u64)
    requires offset < 128
    {
        transition index < 128 {
            true -> write(checker, offset, index),
            _ -> invalid()
        }
    }

    machine write(checker: @mutable Checker, offset: u64 in Trapping, index: u64)
    requires offset < 128, index < 128
    {
        checker.queue[index] = offset as u64;
        checker.queue_count = index + 1;
        checker.queued[offset] = true;
    }

    machine done() {}

    machine invalid() {
        crash Trap;
    }
}

// A jump's contribution to its declaration's arrival: for each pair of the
// declaration's integer and Boolean parameters, the zone's bound on the
// difference of their
// arguments (or of their intervals when either is no linear term), with the
// zero subject for each one's own range. The arrival keeps what every
// contribution so far implies; after three loosenings, bounds that keep
// loosening are dropped.
public machine contribute(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, call: u64 in Trapping, declaration: u64 in Trapping)
crashes Trap
{
    let expression: Expression = syntax_trees_expression(syntax, call);
    let item: MachineItem = machine_item(syntax, declaration);
    let offset: u64 in Trapping = body_slot(checker, declaration) - 1;
    let zero: Value = value_constant(ExactInteger { negative: false, magnitude: 0 });
    set_projection(checker, 0, zero);
    transition checker.zone.infeasible {
        true -> done(),
        _ -> parameter(checker, syntax, typing, expression, item, offset, 0, 1)
    }

    // Project each integer parameter's argument, numbering them as the
    // declaration's body will.
    machine parameter(
        checker: @mutable Checker,
        syntax: @SyntaxTrees,
        typing: @Typing,
        expression: Expression,
        item: MachineItem,
        offset: u64 in Trapping,
        index: u64 in Trapping,
        subject: u64 in Trapping
    ) {
        transition index < item.parameter_count && index < expression.count {
            true -> argument(checker, syntax, typing, expression, item, offset, index, subject),
            _ -> paths(checker, syntax, typing, expression, item, offset, subject)
        }
    }

    machine argument(
        checker: @mutable Checker,
        syntax: @SyntaxTrees,
        typing: @Typing,
        expression: Expression,
        item: MachineItem,
        offset: u64 in Trapping,
        index: u64 in Trapping,
        subject: u64 in Trapping
    ) {
        let parameter: Parameter = syntax_trees_parameter(syntax, item.first_parameter + index);
        let type_handle: u64 in Trapping = reference_type(typing, parameter.type_reference);
        let carrier: BuiltinType = checker_carrier(typing, type_handle);
        let integer: bool = has_subject(carrier);
        let handle: u64 in Trapping = syntax_trees_argument(syntax, expression.first + index);
        let value: Value = value_at(checker, handle);
        transition integer && subject < 64 {
            true -> projected(checker, syntax, typing, expression, item, offset, index, subject, value),
            _ -> parameter(checker, syntax, typing, expression, item, offset, index + 1, subject)
        }
    }

    machine projected(
        checker: @mutable Checker,
        syntax: @SyntaxTrees,
        typing: @Typing,
        expression: Expression,
        item: MachineItem,
        offset: u64 in Trapping,
        index: u64 in Trapping,
        subject: u64 in Trapping,
        value: Value
    ) {
        set_projection(checker, subject, value);
        transition { _ -> parameter(checker, syntax, typing, expression, item, offset, index + 1, subject + 1) }
    }

    // Then the field paths below its other arguments.
    machine paths(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, item: MachineItem, offset: u64 in Trapping, first_subject: u64 in Trapping) {
        let count: u64 in Trapping = project_paths(checker, syntax, typing, expression, item, offset, first_subject);
        transition { _ -> project(checker, offset, count) }
    }

    machine project(checker: @mutable Checker, offset: u64 in Trapping, count: u64 in Trapping) {
        zone_open(@mutable checker.contribution, 64);
        transition { _ -> row(checker, offset, count, 0) }
    }

    machine row(checker: @mutable Checker, offset: u64 in Trapping, count: u64 in Trapping, from: u64 in Trapping) {
        transition from < count {
            true -> column(checker, offset, count, from, 0),
            _ -> joined(checker, offset)
        }
    }

    machine column(checker: @mutable Checker, offset: u64 in Trapping, count: u64 in Trapping, from: u64 in Trapping, to: u64 in Trapping) {
        transition to < count {
            true -> pair(checker, offset, count, from, to),
            _ -> row(checker, offset, count, from + 1)
        }
    }

    machine pair(checker: @mutable Checker, offset: u64 in Trapping, count: u64 in Trapping, from: u64 in Trapping, to: u64 in Trapping) {
        let first: Value = projection_at(checker, from);
        let second: Value = projection_at(checker, to);
        let bound: Bound = projected_bound(checker, first, second);
        transition from == to {
            true -> column(checker, offset, count, from, to + 1),
            _ -> stored(checker, offset, count, from, to, bound)
        }
    }

    machine stored(checker: @mutable Checker, offset: u64 in Trapping, count: u64 in Trapping, from: u64 in Trapping, to: u64 in Trapping, bound: Bound) {
        zone_set(@mutable checker.contribution, from, to, bound);
        transition { _ -> column(checker, offset, count, from, to + 1) }
    }

    machine joined(checker: @mutable Checker, offset: u64 in Trapping) {
        join_arrival(checker, offset);
    }

    machine done() {}
}

// The bound on `second - first` for two projected argument values.
machine projected_bound(checker: @Checker, first: Value, second: Value) -> Bound
crashes Trap
{
    transition first.known && second.known {
        true -> related(checker, first, second),
        _ -> intervals(first, second)
    }

    machine related(checker: @Checker, first: Value, second: Value) -> Bound {
        let bound: Bound = difference_bound(checker, first, second);
        bound
    }

    machine intervals(first: Value, second: Value) -> Bound {
        let bound: Bound = bound_add(second.ceiling, first.floor);
        bound
    }
}

machine join_arrival(checker: @mutable Checker, offset: u64 in Trapping)
crashes Trap
{
    transition offset < 128 {
        true -> arrival(checker, offset),
        _ -> invalid()
    }

    machine arrival(checker: @mutable Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        let reached: bool = checker.reached[offset];
        transition reached {
            true -> loosen(checker, offset),
            _ -> first(checker, offset)
        }
    }

    machine first(checker: @mutable Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        let order: u64 in Trapping = checker.discovered as +Trapping;
        let next: u64 in Trapping = order + 1;
        checker.arrivals[offset] = checker.contribution;
        checker.reached[offset] = true;
        checker.discovery[offset] = order as u64;
        checker.discovered = next as u64;
        checker_enqueue(checker, offset);
    }

    machine loosen(checker: @mutable Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        checker.previous = checker.arrivals[offset];
        checker.merged = checker.arrivals[offset];
        let changed: bool = zone_join(@mutable checker.merged, @checker.contribution);
        transition changed {
            true -> loosened(checker, offset),
            _ -> done()
        }
    }

    machine loosened(checker: @mutable Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        let count: u64 in Trapping = checker.loosenings[offset] as +Trapping;
        let next: u64 in Trapping = count + 1;
        checker.loosenings[offset] = next as u64;
        let back: bool = back_edge(checker, offset);
        transition count >= 3 && back {
            true -> widen(checker, offset),
            _ -> store(checker, offset)
        }
    }

    machine widen(checker: @mutable Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        zone_widen(@mutable checker.merged, @checker.previous);
        transition { _ -> store(checker, offset) }
    }

    machine store(checker: @mutable Checker, offset: u64 in Trapping)
    requires offset < 128
    {
        checker.arrivals[offset] = checker.merged;
        checker_enqueue(checker, offset);
    }

    machine done() {}

    machine invalid() {
        crash Trap;
    }
}

machine set_projection(checker: @mutable Checker, subject: u64 in Trapping, value: Value)
crashes Trap
{
    transition subject < 64 {
        true -> write(checker, subject, value),
        _ -> invalid()
    }

    machine write(checker: @mutable Checker, subject: u64 in Trapping, value: Value)
    requires subject < 64
    {
        checker.projection[subject] = value;
    }

    machine invalid() {
        crash Trap;
    }
}

machine projection_at(checker: @Checker, subject: u64 in Trapping) -> Value
crashes Trap
{
    transition subject < 64 {
        true -> read(checker, subject),
        _ -> invalid()
    }

    machine read(checker: @Checker, subject: u64 in Trapping) -> Value
    requires subject < 64
    {
        checker.projection[subject]
    }

    machine invalid() -> Value {
        crash Trap;
    }
}

// Record a call to a machine for crash-route settlement. A machine binder's
// call derives the causes its `requires machine` contract declares.
public machine record_call(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, selection: Selection)
crashes Trap
{
    transition selection {
        Selection::Machine { handle } -> machine(checker, handle),
        Selection::Binder { parameter } -> binder(checker, syntax, resolution, selection),
        _ -> done()
    }

    machine binder(checker: @mutable Checker, syntax: @SyntaxTrees, resolution: @NameResolution, selection: Selection) {
        let clauses: CallClauses = call_clauses(syntax, resolution, selection);
        let causes: CrashRoutes = declared_causes(syntax, clauses.first_clause, clauses.clause_count);
        checker.trap_route = checker.trap_route || causes.declares_trap;
        checker.abort_route = checker.abort_route || causes.declares_abort;
        record_binder_call(checker);
    }

    machine machine(checker: @mutable Checker, callee: u64 in Trapping) {
        transition checker.call_count < 32768 {
            true -> write(checker, checker.call_count, callee),
            _ -> full(checker)
        }
    }

    machine write(checker: @mutable Checker, index: u64, callee: u64 in Trapping)
    requires index < 32768
    {
        checker.callers[index] = checker.machine as u64;
        checker.callees[index] = callee as u64;
        checker.call_count = index + 1;
    }

    machine full(checker: @mutable Checker) {
        checker.overflowed = true;
    }

    machine done() {}
}

// A call of machine `callee` from machine `caller` that supplies its
// machine binders static arguments.
public data SuppliedCall [copy] {
    caller: u64;
    call: u64;
    callee: u64;
}

// Record a call whose selected machine has machine binders: its static
// arguments must refine their contracts, which supply.omg decides once
// crash routes settle.
public machine record_supply(checker: @mutable Checker, syntax: @SyntaxTrees, selection: Selection, call: u64 in Trapping)
crashes Trap
{
    transition selection {
        Selection::Machine { handle } -> selected(checker, syntax, call, handle),
        _ -> done()
    }

    machine selected(checker: @mutable Checker, syntax: @SyntaxTrees, call: u64 in Trapping, callee: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, callee);
        let binds: bool = binds_machines(syntax, item.first_generic_parameter, item.generic_parameter_count);
        transition binds {
            true -> supplying(checker, call, callee),
            _ -> done()
        }
    }

    machine supplying(checker: @mutable Checker, call: u64 in Trapping, callee: u64 in Trapping) {
        transition checker.supplied_count < 1024 {
            true -> write(checker, checker.supplied_count, call, callee),
            _ -> full(checker)
        }
    }

    machine write(checker: @mutable Checker, index: u64, call: u64 in Trapping, callee: u64 in Trapping)
    requires index < 1024
    {
        checker.supplied[index] = SuppliedCall { caller: checker.machine as u64, call: call as u64, callee: callee as u64 };
        checker.supplied_count = index + 1;
    }

    machine full(checker: @mutable Checker) {
        checker.overflowed = true;
    }

    machine done() {}
}

// Whether any generic parameter in `first .. first + count` is a machine
// binder.
public machine binds_machines(syntax: @SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(syntax, first, count, 0) }

    machine next(syntax: @SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) -> bool {
        transition offset < count {
            true -> parameter(syntax, first, count, offset),
            _ -> none()
        }
    }

    machine parameter(syntax: @SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let generic: GenericParameter = syntax_trees_generic_parameter(syntax, first + offset);
        transition generic.kind == GenericParameterKind::Machine {
            true -> found(),
            _ -> next(syntax, first, count, offset + 1)
        }
    }

    machine found() -> bool {
        true
    }

    machine none() -> bool {
        false
    }
}

// After a call, what the callee may write through an exclusive argument may
// have changed (frames.omg): everything below the argument when the callee
// may replace its parameter's whole referent or its writes are unknown (a
// machine binder's always are), else each field place below it whose field
// the callee may write.
public machine release_exclusive_arguments(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, selection: Selection)
crashes Trap
{
    transition selection {
        Selection::Machine { handle } -> framed(checker, syntax, typing, expression, handle),
        _ -> unframed(checker, syntax, typing, expression)
    }

    machine framed(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, callee: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, callee);
        let unknown: bool = writes_unknown(checker, callee);
        transition { _ -> next(checker, syntax, typing, expression, callee, item.first_parameter, item.parameter_count, unknown, 0) }
    }

    // Unknown writes release every exclusive argument whole, so no callee
    // frame is read.
    machine unframed(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression) {
        transition { _ -> next(checker, syntax, typing, expression, 0, 0, 0, true, 0) }
    }

    machine next(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping) {
        let count: u64 in Trapping = operand_count(expression);
        transition offset < count {
            true -> argument(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset),
            _ -> done()
        }
    }

    machine argument(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping) {
        let handle: u64 in Trapping = checker_operand(syntax, expression, offset);
        let value: Value = value_at(checker, handle);
        let exclusive: bool = exclusive_value(typing, handle);
        let whole: bool = writes_whole(checker, first_parameter + offset);
        transition exclusive {
            true -> origin(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, handle, unknown || whole || offset >= parameter_count),
            _ -> embedded(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, handle, value.place)
        }
    }

    machine embedded(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, lender: u64 in Trapping, place: u64 in Trapping) {
        let release: ReferenceRelease = ReferenceRelease::Invocation { expression: expression, lender: lender };
        forget_exclusive_referents(checker, syntax, typing, place, release);
        transition { _ -> next(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset + 1) }
    }

    machine origin(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, handle: u64 in Trapping, whole: bool) {
        let place: u64 in Trapping = storage_origin(checker, syntax, typing, handle);
        transition place > 0 {
            true -> lent(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, handle, place, whole),
            _ -> unknown_origin(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, whole)
        }
    }

    // A complete empty frame cannot mutate even an unknown referent. Any
    // nonempty frame needs an origin; a returned reference is not evidence
    // of a disjoint new place.
    machine unknown_origin(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, whole: bool) {
        let changes: bool = frame_changes(checker, syntax, callee, whole);
        transition changes {
            true -> unrepresented(checker, expression),
            _ -> next(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset + 1)
        }
    }

    machine unrepresented(checker: @mutable Checker, expression: Expression) {
        checks_reject(@mutable checker.output, CheckDiagnosticCode::UnsupportedCheck, expression.source_span);
    }

    // The operands evaluated before the call keep what they read there.
    machine lent(
        checker: @mutable Checker,
        syntax: @SyntaxTrees,
        typing: @Typing,
        expression: Expression,
        callee: u64 in Trapping,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        unknown: bool,
        offset: u64 in Trapping,
        lender: u64 in Trapping,
        place: u64 in Trapping,
        whole: bool
    ) {
        let changes: bool = frame_changes(checker, syntax, callee, whole);
        transition changes {
            true -> changed(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, lender, place, whole),
            _ -> next(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset + 1)
        }
    }

    machine changed(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, lender: u64 in Trapping, place: u64 in Trapping, whole: bool) {
        checker.write_epoch = checker.write_epoch + 1;
        let write: WriteFootprint = WriteFootprint { place: place, callee: callee, whole: whole };
        snapshot_operands(checker, syntax, typing, expression, lender, write);
        let release: ReferenceRelease = ReferenceRelease::Invocation { expression: expression, lender: lender };
        forget_exclusive_referents(checker, syntax, typing, place, release);
        transition whole {
            true -> released(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, place),
            _ -> narrowed(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset, place)
        }
    }

    machine released(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, place: u64 in Trapping) {
        forget_reference_origins(checker, typing, place);
        forget_place(checker, typing, place);
        transition { _ -> next(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset + 1) }
    }

    machine narrowed(checker: @mutable Checker, syntax: @SyntaxTrees, typing: @Typing, expression: Expression, callee: u64 in Trapping, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, unknown: bool, offset: u64 in Trapping, place: u64 in Trapping) {
        forget_written_fields(checker, typing, place, callee);
        transition { _ -> next(checker, syntax, typing, expression, callee, first_parameter, parameter_count, unknown, offset + 1) }
    }

    machine done() {}
}

// An empty complete write frame changes no storage and must not prevent
// replay. Unknown/whole writes always count; named field writes may be
// pending and therefore need not have a place yet.
machine frame_changes(checker: @Checker, syntax: @SyntaxTrees, callee: u64 in Trapping, whole: bool) -> bool
crashes Trap
{
    transition whole {
        true -> answer(true),
        _ -> field(checker, syntax, callee, 0)
    }

    machine field(checker: @Checker, syntax: @SyntaxTrees, callee: u64 in Trapping, index: u64 in Trapping) -> bool {
        transition index < syntax.field_count {
            true -> inspected(checker, syntax, callee, index),
            _ -> answer(false)
        }
    }

    machine inspected(checker: @Checker, syntax: @SyntaxTrees, callee: u64 in Trapping, index: u64 in Trapping) -> bool {
        let writes: bool = writes_field(checker, callee, index);
        transition writes {
            true -> answer(true),
            _ -> field(checker, syntax, callee, index + 1)
        }
    }

    machine answer(changes: bool) -> bool {
        changes
    }
}

// Forget each field place strictly below `place` (one-based) whose field
// `callee` may write, with everything inside it.
public machine forget_written_fields(checker: @mutable Checker, typing: @Typing, place: u64 in Trapping, callee: u64 in Trapping)
crashes Trap
{
    settle_written_pending(checker, typing, place, callee);
    forget_aliases(checker, place);
    transition { _ -> next(checker, typing, place, callee, 0) }

    machine next(checker: @mutable Checker, typing: @Typing, place: u64 in Trapping, callee: u64 in Trapping, index: u64 in Trapping) {
        transition index < checker.place_count {
            true -> visit(checker, typing, place, callee, index),
            _ -> done()
        }
    }

    machine visit(checker: @mutable Checker, typing: @Typing, place: u64 in Trapping, callee: u64 in Trapping, index: u64 in Trapping) {
        let candidate: Place = place_at(checker, index);
        let inside: bool = checker_within(checker, index + 1, place);
        let written: bool = writes_field(checker, callee, candidate.handle);
        transition index + 1 != place && inside && candidate.kind == PlaceKind::Field && written {
            true -> forgotten(checker, typing, place, callee, index),
            _ -> next(checker, typing, place, callee, index + 1)
        }
    }

    machine forgotten(checker: @mutable Checker, typing: @Typing, place: u64 in Trapping, callee: u64 in Trapping, index: u64 in Trapping) {
        let entry: Place = place_at(checker, index);
        let row: TypeRow = type_table_row(@typing.types, entry.type_handle);
        // A reference-typed target writes its referent. Replacing owned
        // storage can instead replace the descriptors contained in it.
        replace_origins(checker, typing, index + 1, row.kind != TypeKind::Reference);
        forget_place(checker, typing, index + 1);
        transition { _ -> next(checker, typing, place, callee, index + 1) }
    }

    machine replace_origins(checker: @mutable Checker, typing: @Typing, place: u64 in Trapping, replace: bool) {
        transition replace { true -> replaced(checker, typing, place), false -> {} }
    }
    machine replaced(checker: @mutable Checker, typing: @Typing, place: u64 in Trapping) {
        forget_reference_origins(checker, typing, place);
    }

    machine done() {}
}

// Settle crash routes over the call graph: a caller derives each cause its
// callees publish, a callee inferring its causes publishes what it derives
// and any other publishes what it declares, until nothing changes. Then a
// machine that does not infer must declare every cause it derives.
machine settle_routes(checker: @mutable Checker, syntax: @SyntaxTrees)
crashes Trap
{
    transition { _ -> sweep(checker, syntax, 0, false) }

    machine sweep(checker: @mutable Checker, syntax: @SyntaxTrees, index: u64 in Trapping, changed: bool) {
        transition index < checker.call_count {
            true -> edge(checker, syntax, index, changed),
            _ -> swept(checker, syntax, changed)
        }
    }

    machine edge(checker: @mutable Checker, syntax: @SyntaxTrees, index: u64 in Trapping, changed: bool) {
        let call: u64 in Trapping = index;
        let caller: u64 in Trapping = caller_at(checker, call);
        let callee: u64 in Trapping = callee_at(checker, call);
        let from: CrashRoutes = checks_routes(@checker.output, callee);
        let into: CrashRoutes = checks_routes(@checker.output, caller);
        let trap: bool = checker_published(from.inferred, from.trap, from.declares_trap);
        let abort: bool = checker_published(from.inferred, from.abort, from.declares_abort);
        let gained: bool = (trap && !into.trap) || (abort && !into.abort);
        transition gained {
            true -> gain(checker, syntax, index, caller, into, trap, abort),
            _ -> sweep(checker, syntax, index + 1, changed)
        }
    }

    machine gain(checker: @mutable Checker, syntax: @SyntaxTrees, index: u64 in Trapping, caller: u64 in Trapping, into: CrashRoutes, trap: bool, abort: bool) {
        let routes: CrashRoutes = CrashRoutes {
            declares_trap: into.declares_trap,
            declares_abort: into.declares_abort,
            inferred: into.inferred,
            trap: into.trap || trap,
            abort: into.abort || abort
        };
        set_routes(@mutable checker.output, caller, routes);
        transition { _ -> sweep(checker, syntax, index + 1, true) }
    }

    machine swept(checker: @mutable Checker, syntax: @SyntaxTrees, changed: bool) {
        transition changed {
            true -> sweep(checker, syntax, 0, false),
            _ -> fit(checker, syntax, 0)
        }
    }

    machine fit(checker: @mutable Checker, syntax: @SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.machine_count && checker.output.diagnostic_count < 64 {
            true -> machine(checker, syntax, index),
            _ -> done()
        }
    }

    machine machine(checker: @mutable Checker, syntax: @SyntaxTrees, index: u64 in Trapping) {
        open_machine(@mutable checker.output);
        let routes: CrashRoutes = checks_routes(@checker.output, index);
        let undeclared: bool = !routes.inferred
            && ((routes.trap && !routes.declares_trap) || (routes.abort && !routes.declares_abort));
        transition undeclared {
            true -> rejected(checker, syntax, index),
            _ -> fit(checker, syntax, index + 1)
        }
    }

    machine rejected(checker: @mutable Checker, syntax: @SyntaxTrees, index: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, index);
        checks_reject(@mutable checker.output, CheckDiagnosticCode::CrashNotDeclared, item.source_span);
        transition { _ -> fit(checker, syntax, index + 1) }
    }

    machine done() {}
}

// What a callee publishes for one cause.
public machine checker_published(inferred: bool, derived: bool, declared: bool) -> bool {
    transition inferred {
        true -> chosen(derived),
        _ -> chosen(declared)
    }

    machine chosen(cause: bool) -> bool {
        cause
    }
}

machine caller_at(checker: @Checker, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < checker.call_count && index < 32768 {
        true -> read(checker, index),
        _ -> invalid()
    }

    machine read(checker: @Checker, index: u64 in Trapping) -> u64 in Trapping
    requires index < 32768
    {
        checker.callers[index] as +Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

machine callee_at(checker: @Checker, index: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition index < checker.call_count && index < 32768 {
        true -> read(checker, index),
        _ -> invalid()
    }

    machine read(checker: @Checker, index: u64 in Trapping) -> u64 in Trapping
    requires index < 32768
    {
        checker.callees[index] as +Trapping
    }

    machine invalid() -> u64 in Trapping {
        crash Trap;
    }
}

// Whether the body being walked jumps back to declaration `offset`: a declaration reached
// no later than its own, itself included.
machine back_edge(checker: @Checker, offset: u64 in Trapping) -> bool
crashes Trap
{
    let walking: u64 in Trapping = checker.walking as +Trapping;
    transition walking > 0 && walking <= 128 && offset < 128 {
        true -> compared(checker, offset, walking - 1),
        _ -> forward()
    }

    machine compared(checker: @Checker, offset: u64 in Trapping, source: u64 in Trapping) -> bool
    requires offset < 128, source < 128
    {
        let target_order: u64 = checker.discovery[offset];
        let source_order: u64 = checker.discovery[source];
        target_order <= source_order
    }

    machine forward() -> bool {
        false
    }
}

// The declaration group closes private uses; graph edges still come only from
// selected calls with explicit evaluated actuals. Slot zero is the public/root
// invocation, whose arbitrary entry inputs prevent importing a recursive caller's facts.
public machine collect_bodies(checker: @mutable Checker, syntax: @SyntaxTrees, root: u64 in Trapping)
crashes Trap
{
    checker.body_count = 0;
    transition { _ -> candidate(checker, syntax, root, 0) }
    machine candidate(checker: @mutable Checker, syntax: @SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping) {
        transition index < syntax.machine_count {
            true -> ancestry(checker, syntax, root, index, index),
            false -> done()
        }
    }
    machine ancestry(checker: @mutable Checker, syntax: @SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping, ancestor: u64 in Trapping) {
        let item: MachineItem = machine_item(syntax, ancestor);
        transition item.parent > 0 {
            true -> parent(checker, syntax, root, index, item.parent - 1),
            false -> candidate(checker, syntax, root, index + 1)
        }
    }
    machine parent(checker: @mutable Checker, syntax: @SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping, ancestor: u64 in Trapping) {
        transition ancestor == root {
            true -> retain(checker, syntax, root, index),
            false -> ancestry(checker, syntax, root, index, ancestor)
        }
    }
    machine retain(checker: @mutable Checker, syntax: @SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping) {
        transition checker.body_count < 128 {
            true -> bounded(checker, syntax, root, index, checker.body_count),
            false -> full(checker)
        }
    }
    machine bounded(checker: @mutable Checker, syntax: @SyntaxTrees, root: u64 in Trapping, index: u64 in Trapping, slot: u64 in Trapping)
    requires slot < 128
    {
        checker.bodies[slot] = index as u64;
        checker.body_count = slot + 1;
        transition { _ -> candidate(checker, syntax, root, index + 1) }
    }
    machine full(checker: @mutable Checker) { checker.overflowed = true; }
    machine done() {}
}

public machine body_handle(checker: @Checker, slot: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition slot < checker.body_count && slot < 128 {
        true -> checker.bodies[slot] as +Trapping,
        false -> invalid()
    }
    machine invalid() -> u64 in Trapping { crash Trap; }
}

// Slot+1; zero means either the root entry or a call outside this graph.
public machine body_slot(checker: @Checker, handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> candidate(checker, handle, 0) }
    machine candidate(checker: @Checker, handle: u64 in Trapping, slot: u64 in Trapping) -> u64 in Trapping {
        transition slot < checker.body_count && slot < 128 {
            true -> compare(checker, handle, slot),
            false -> 0
        }
    }
    machine compare(checker: @Checker, handle: u64 in Trapping, slot: u64 in Trapping) -> u64 in Trapping
    requires slot < 128
    {
        transition checker.bodies[slot] == handle {
            true -> (slot + 1),
            false -> candidate(checker, handle, slot + 1)
        }
    }
}

// Each declaration publishes its own body routes; call-graph settlement composes them.
machine publish_body_routes(checker: @mutable Checker, index: u64 in Trapping)
crashes Trap
{
        let routes: CrashRoutes = checks_routes(@checker.output, index);
        let local: CrashRoutes = CrashRoutes {
            declares_trap: routes.declares_trap,
            declares_abort: routes.declares_abort,
            inferred: routes.inferred,
            trap: checker.trap_route,
            abort: checker.abort_route
        };
        set_routes(@mutable checker.output, index, local);
}
