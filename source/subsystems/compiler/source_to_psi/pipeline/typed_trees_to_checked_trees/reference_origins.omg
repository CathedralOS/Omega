use pipeline/typed_trees_to_checked_trees/references.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;
use pipeline/typed_trees_to_checked_trees/places.omg;

use representations/typed_trees/typed_trees.omg;

// Unrecorded incoming descriptors have an arbitrary referent. A descriptor
// initialized from unknown storage must stay unknown instead of acquiring a
// fresh, unrelated referent. Footprints locate writes, never observations.
public data ReferenceOrigin [copy] {
    case Unrecorded;
    case Unknown;
    case Exact(place: u64 in Trapping);
    case Footprint(place: u64 in Trapping);
    // A readable logical subject with a separate immutable may-alias roster.
    case View(place: u64 in Trapping, backing: u64 in Trapping);
}

// Value places may be logical returned views. Copy their backing identity,
// never turn the proof subject into independent physical storage.
public machine exact_reference_origin(checker: @|checker|::Checker, place: u64 in Trapping) -> ReferenceOrigin
crashes Trap
{
    transition place > 0 {
        true -> view(checker, place),
        false -> ReferenceOrigin::Unknown
    }
    machine view(checker: @|checker|::Checker, place: u64 in Trapping) -> ReferenceOrigin {
        let backing: u64 in Trapping = reference_view_backing(checker, place);
        transition backing > 0 {
            true -> (ReferenceOrigin::View { place: place, backing: backing }),
            false -> (ReferenceOrigin::Exact { place: place })
        }
    }
}

public machine reference_view_backing(checker: @|checker|::Checker, place: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> next(checker, place, 0 as +Trapping) }
    machine next(checker: @|checker|::Checker, place: u64 in Trapping, depth: u64 in Trapping) -> u64 in Trapping {
        transition place > 0 && place <= 256 && depth < 256 {
            true -> inspect(checker, place, depth),
            false -> 0 as +Trapping
        }
    }
    machine inspect(checker: @|checker|::Checker, place: u64 in Trapping, depth: u64 in Trapping) -> u64 in Trapping {
        let origin: ReferenceOrigin = reference_origin(checker, place);
        transition origin {
            ReferenceOrigin::View { place as observed, backing } -> backing,
            _ -> parent(checker, place, depth)
        }
    }
    machine parent(checker: @|checker|::Checker, place: u64 in Trapping, depth: u64 in Trapping) -> u64 in Trapping {
        let entry: |places|::Place = |places|::place_at(checker, place - 1);
        transition entry.kind == |places|::PlaceKind::Field || entry.kind == |places|::PlaceKind::Length || entry.kind == |places|::PlaceKind::Referent {
            true -> next(checker, entry.parent, depth + 1),
            false -> 0 as +Trapping
        }
    }
}

public machine reference_origin_place(origin: ReferenceOrigin) -> u64 in Trapping {
    transition origin {
        ReferenceOrigin::Exact { place } -> place,
        ReferenceOrigin::Footprint { place } -> place,
        ReferenceOrigin::View { place, backing } -> place,
        _ -> 0 as +Trapping
    }
}

public machine reference_origin(checker: @|checker|::Checker, place: u64 in Trapping) -> ReferenceOrigin
crashes Trap
{
    transition place > 0 && place <= 256 {
        true -> read(checker, place - 1),
        false -> ReferenceOrigin::Unknown
    }
    machine read(checker: @|checker|::Checker, index: u64 in Trapping) -> ReferenceOrigin
    requires index < 256
    { checker.reference_origins[index as -Trapping] }
}

// Zone restore does not restore descriptor captures. An arm may preserve an
// existing identity, but cannot establish a new identity for its siblings.
public machine record_reference_origin(checker: @mutable |checker|::Checker, index: u64 in Trapping, origin: ReferenceOrigin)
requires index < 256
crashes Trap
{
    let previous: ReferenceOrigin = checker.reference_origins[index as -Trapping];
    let same: bool = same_reference_origin(previous, origin);
    transition checker.saved_count == 0 || same {
        true -> capture(checker, index, origin),
        false -> capture(checker, index, ReferenceOrigin::Unknown)
    }
    machine capture(checker: @mutable |checker|::Checker, index: u64 in Trapping, origin: ReferenceOrigin)
    requires index < 256
    { checker.reference_origins[index as -Trapping] = origin; }
}

machine same_reference_origin(left: ReferenceOrigin, right: ReferenceOrigin) -> bool {
    transition left {
        ReferenceOrigin::Exact { place } -> exact(place, right),
        ReferenceOrigin::Footprint { place } -> footprint(place, right),
        ReferenceOrigin::View { place, backing } -> view(place, backing, right),
        _ -> false
    }
    machine exact(place: u64 in Trapping, right: ReferenceOrigin) -> bool {
        transition right {
            ReferenceOrigin::Exact { place as other } -> (place == other),
            _ -> false
        }
    }
    machine footprint(place: u64 in Trapping, right: ReferenceOrigin) -> bool {
        transition right {
            ReferenceOrigin::Footprint { place as other } -> (place == other),
            _ -> false
        }
    }
    machine view(place: u64 in Trapping, backing: u64 in Trapping, right: ReferenceOrigin) -> bool {
        transition right {
            ReferenceOrigin::View { place as other, backing as other_backing } -> (place == other && backing == other_backing),
            _ -> false
        }
    }

}

// Only fields rooted in arbitrary incoming storage may create an arbitrary
// referent. Missing local provenance is not evidence of disjoint storage.
public machine incoming_reference_field(checker: @|checker|::Checker, parent: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(checker, parent, 0 as +Trapping) }
    machine next(checker: @|checker|::Checker, place: u64 in Trapping, depth: u64 in Trapping) -> bool {
        transition place > 0 && depth < 256 {
            true -> inspect(checker, place, depth),
            false -> false
        }
    }
    machine inspect(checker: @|checker|::Checker, place: u64 in Trapping, depth: u64 in Trapping) -> bool {
        let entry: |places|::Place = |places|::place_at(checker, place - 1);
        transition entry.kind {
            |places|::PlaceKind::Parameter -> true,
            |places|::PlaceKind::Call -> true,
            |places|::PlaceKind::ContractResult -> true,
            |places|::PlaceKind::View -> true,
            |places|::PlaceKind::Field -> next(checker, entry.parent, depth + 1),
            |places|::PlaceKind::Referent -> next(checker, entry.parent, depth + 1),
            _ -> false
        }
    }
}

// An owned copy carries descriptor identities, never frozen pointee facts.
// Capture incoming descriptors before rebasing them to a local destination.
public machine copy_reference_origin(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping)
crashes Trap
{
    let origin: ReferenceOrigin = reference_origin(checker, source);
    transition origin {
        ReferenceOrigin::Unrecorded -> incoming(checker, typing, target, source),
        _ -> captured(checker, target, origin)
    }
    machine incoming(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping) {
        let value: |evaluation|::Value = |references|::reference_value(checker, typing, source);
        let origin: ReferenceOrigin = exact_reference_origin(checker, value.place);
        copy_captured_reference(checker, target, origin);
    }
    machine captured(checker: @mutable |checker|::Checker, target: u64 in Trapping, origin: ReferenceOrigin) {
        copy_captured_reference(checker, target, origin);
    }
}

machine copy_captured_reference(checker: @mutable |checker|::Checker, target: u64 in Trapping, origin: ReferenceOrigin)
crashes Trap
{
    transition target > 0 && target <= 256 {
        true -> write(checker, target - 1, origin),
        false -> {}
    }
    machine write(checker: @mutable |checker|::Checker, index: u64 in Trapping, origin: ReferenceOrigin)
    requires index < 256
    { record_reference_origin(checker, index, origin); }
}

// Parent paths describe both owned fields and referent projections. Only
// the former are duplicated or replaced with a containing owned value.
public machine owned_below(checker: @|checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping, child: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(checker, typing, root, child, 0 as +Trapping) }
    machine next(checker: @|checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping, current: u64 in Trapping, depth: u64 in Trapping) -> bool {
        transition current > 0 && root > 0 && depth < 256 {
            true -> inspect(checker, typing, root, current, depth),
            false -> false
        }
    }
    machine inspect(checker: @|checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping, current: u64 in Trapping, depth: u64 in Trapping) -> bool {
        transition current == root {
            true -> true,
            false -> parent(checker, typing, root, current, depth)
        }
    }
    machine parent(checker: @|checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping, current: u64 in Trapping, depth: u64 in Trapping) -> bool {
        let entry: |places|::Place = |places|::place_at(checker, current - 1);
        transition entry.parent > 0 && (entry.kind == |places|::PlaceKind::Field || entry.kind == |places|::PlaceKind::Length) {
            true -> owner(checker, typing, root, entry.parent, depth),
            false -> false
        }
    }
    machine owner(checker: @|checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping, parent: u64 in Trapping, depth: u64 in Trapping) -> bool {
        let owner: |places|::Place = |places|::place_at(checker, parent - 1);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, owner.type_handle);
        transition parent == root || row.kind != |typed_trees|::TypeKind::Reference {
            true -> next(checker, typing, root, parent, depth + 1),
            false -> false
        }
    }
}

public machine forget_reference_origins(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping)
crashes Trap
{
    transition root > 0 && root <= 256 {
        true -> typed(checker, typing, root),
        false -> {}
    }
    machine typed(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping) {
        let entry: |places|::Place = |places|::place_at(checker, root - 1);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, entry.type_handle);
        forget_reference_storage(checker, typing, root, row.kind != |typed_trees|::TypeKind::Reference && entry.kind != |places|::PlaceKind::View);
    }
}

machine forget_reference_descendants(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping)
crashes Trap
{ forget_reference_storage(checker, typing, root, false); }

machine forget_reference_storage(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping, include_root: bool)
crashes Trap
{
    transition { _ -> next(checker, typing, root, include_root, 0 as +Trapping) }
    machine next(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping, include_root: bool, index: u64 in Trapping) {
        transition index < checker.place_count && index < 256 {
            true -> inspect(checker, typing, root, include_root, index),
            false -> {}
        }
    }
    machine inspect(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping, include_root: bool, index: u64 in Trapping)
    requires index < 256
    {
        let replace: bool = (include_root || index + 1 != root) && owned_below(checker, typing, root, index + 1);
        clear(checker, index, replace);
        transition { _ -> next(checker, typing, root, include_root, index + 1) }
    }
    machine clear(checker: @mutable |checker|::Checker, index: u64 in Trapping, replace: bool)
    requires index < 256
    {
        transition replace { true -> forget(checker, index), false -> {} }
    }
    machine forget(checker: @mutable |checker|::Checker, index: u64 in Trapping)
    requires index < 256
    { checker.reference_origins[index as -Trapping] = ReferenceOrigin::Unknown; }
}

public machine clear_reference_origins(checker: @mutable |checker|::Checker)
crashes Trap
{
    checker.reference_view_count = 0 as +Trapping;
    checker.reference_backing_count = 0 as +Trapping;
    transition { _ -> next(checker, 0 as +Trapping) }

    machine next(checker: @mutable |checker|::Checker, index: u64 in Trapping) {
        transition index < 256 {
            true -> clear(checker, index),
            _ -> done()
        }
    }

    machine clear(checker: @mutable |checker|::Checker, index: u64 in Trapping)
    requires index < 256
    {
        checker.reference_origins[index as -Trapping] = ReferenceOrigin::Unrecorded;
        transition { _ -> next(checker, index + 1) }
    }

    machine done() {}
}
