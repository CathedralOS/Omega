use pipeline/typed_trees_to_checked_trees/flow.omg;
use pipeline/typed_trees_to_checked_trees/references.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;
use pipeline/typed_trees_to_checked_trees/invocations.omg;
use pipeline/typed_trees_to_checked_trees/places.omg;

use foundation/integers.omg;
use representations/checks/checks.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// A numeric normal-completion interval belongs to an exact declaration under
// its own entry contracts, never a caller's private arrival. The graph is
// discovered first with declared result cuts. Summaries then follow completed
// callee components; every intra-component call retains its declared cut.
// This makes both the available facts and the refusal boundary independent of
// declaration order. Places and local subjects never escape the query.
public data NumericCompletion [copy] {
    available: bool;
    builtin: |symbol_resolved_trees|::BuiltinType;
    value: |evaluation|::Value;
}

public machine derive_completions(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing)
crashes Trap
{
    let nodes: u64 in Trapping = syntax.machine_count as +Trapping;
    let expressions: u64 in Trapping = syntax.expression_count as +Trapping;
    |invocations|::invocation_graph_initialize(@mutable checker.invocations, nodes, expressions);
    checker.collecting_completion = false;
    transition { _ -> clear(checker, syntax, resolution, typing, 0 as +Trapping) }
    machine clear(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        transition index < syntax.machine_count && index < 10240 {
            true -> cleared(checker, syntax, resolution, typing, index),
            false -> discover(checker, syntax, resolution, typing, 0 as +Trapping)
        }
    }
    machine cleared(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping)
    requires index < 10240
    {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        checker.completions[index as -Trapping] = NumericCompletion { available: false, builtin: |symbol_resolved_trees|::BuiltinType::U8, value: value };
        transition { _ -> clear(checker, syntax, resolution, typing, index + 1) }
    }
    machine discover(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        transition index < syntax.machine_count && index < 10240 {
            true -> declaration(checker, syntax, resolution, typing, index),
            false -> seal(checker, syntax, resolution, typing)
        }
    }
    machine declaration(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        transition item.has_body {
            true -> discovered(checker, syntax, resolution, typing, index, item),
            false -> discover(checker, syntax, resolution, typing, index + 1)
        }
    }
    machine discovered(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, item: |syntax_trees|::MachineItem) {
        let complete: bool = universal_completion_walk(checker, syntax, resolution, typing, index, item);
        checker.invocations.complete = checker.invocations.complete && complete;
        transition { _ -> discover(checker, syntax, resolution, typing, index + 1) }
    }
    machine seal(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing) {
        let sealed: bool = |invocations|::invocation_graph_seal(@mutable checker.invocations);
        transition sealed {
            true -> ordered(checker, syntax, resolution, typing, 0 as +Trapping),
            false -> done(checker)
        }
    }
    machine ordered(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping) {
        transition offset < checker.invocations.order_count && offset < 10240 {
            true -> selected(checker, syntax, resolution, typing, offset),
            false -> done(checker)
        }
    }
    machine selected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping)
    requires offset < 10240
    {
        let index: u64 in Trapping = checker.invocations.order[offset as -Trapping] as +Trapping;
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, index);
        transition item.has_body && item.has_return_type && index < 10240 {
            true -> typed(checker, syntax, resolution, typing, offset, index, item),
            false -> ordered(checker, syntax, resolution, typing, offset + 1)
        }
    }
    machine typed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, index: u64 in Trapping, item: |syntax_trees|::MachineItem) {
        let handle: u64 in Trapping = |typed_trees|::reference_type(typing, item.return_type);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, handle);
        let integer: bool = row.kind == |typed_trees|::TypeKind::Builtin && |integers|::is_carrier(row.builtin);
        transition integer {
            true -> summarize(checker, syntax, resolution, typing, offset, index, item, row.builtin),
            false -> ordered(checker, syntax, resolution, typing, offset + 1)
        }
    }
    machine summarize(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, index: u64 in Trapping, item: |syntax_trees|::MachineItem, builtin: |symbol_resolved_trees|::BuiltinType) {
        checker.collecting_completion = true;
        checker.completion_seen = false;
        checker.completion_value = |evaluation|::value_unknown();
        let complete: bool = universal_completion_walk(checker, syntax, resolution, typing, index, item);
        checker.collecting_completion = false;
        transition complete && checker.invocations.complete && checker.completion_seen && index < 10240 {
            true -> publish(checker, syntax, resolution, typing, offset, index, builtin),
            false -> ordered(checker, syntax, resolution, typing, offset + 1)
        }
    }
    machine publish(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, offset: u64 in Trapping, index: u64 in Trapping, builtin: |symbol_resolved_trees|::BuiltinType)
    requires index < 10240
    {
        let value: |evaluation|::Value = |evaluation|::value_clamped(checker.completion_value, builtin);
        checker.completions[index as -Trapping] = NumericCompletion { available: true, builtin: builtin, value: value };
        transition { _ -> ordered(checker, syntax, resolution, typing, offset + 1) }
    }
    machine done(checker: @mutable |checker|::Checker) { checker.collecting_completion = false; }
}

// Speculative queries preserve diagnostics and never publish private arrivals.
// The body still applies its real effects; replay would wrongly skip them.
machine universal_completion_walk(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, index: u64 in Trapping, item: |syntax_trees|::MachineItem) -> bool
crashes Trap
{
    let accepted: bool = checker.output.accepted;
    let machine_accepted: bool = checker.output.machine_accepted;
    let diagnostics: u64 = checker.output.diagnostic_count;
    let obligations: u64 in Wrapping = checker.output.obligation_count;
    |checker|::prepare_body(checker, item, index);
    checker.body_count = 0 as +Trapping;
    checker.queue_count = 0;
    checker.trap_route = false;
    checker.abort_route = false;
    |checks|::open_machine(@mutable checker.output);
    |checker|::open_entry(checker, syntax, resolution, typing, item);
    |flow|::walk_body(checker, syntax, resolution, typing, item.first_statement, item.statement_count, false);
    let complete: bool = checker.output.machine_accepted && !checker.overflowed;
    checker.output.accepted = accepted;
    checker.output.machine_accepted = machine_accepted;
    checker.output.diagnostic_count = diagnostics;
    checker.output.obligation_count = obligations;
    complete
}

public machine observe_selected_invocation(checker: @mutable |checker|::Checker, selection: |typed_trees|::Selection, expression: u64 in Trapping)
crashes Trap
{
    transition checker.zone.infeasible { true -> {}, false -> selected(checker, selection, expression) }
    machine selected(checker: @mutable |checker|::Checker, selection: |typed_trees|::Selection, expression: u64 in Trapping) {
        transition selection {
            |typed_trees|::Selection::Machine { handle } -> concrete(checker, expression, handle),
            |typed_trees|::Selection::Binder { parameter } -> opaque(checker, expression, parameter),
            _ -> done()
        }
    }
    machine concrete(checker: @mutable |checker|::Checker, expression: u64 in Trapping, handle: u64 in Trapping) {
        let recorded: bool = |invocations|::invocation_graph_record(@mutable checker.invocations, checker.machine, expression, |invocations|::InvocationTarget::Machine { machine: handle });
        transition recorded { true -> done(), false -> invalid(checker) }
    }
    machine opaque(checker: @mutable |checker|::Checker, expression: u64 in Trapping, parameter: u64 in Trapping) {
        let recorded: bool = |invocations|::invocation_graph_record(@mutable checker.invocations, checker.machine, expression, |invocations|::InvocationTarget::Binder { parameter: parameter });
        transition recorded { true -> done(), false -> invalid(checker) }
    }
    machine invalid(checker: @mutable |checker|::Checker) { checker.overflowed = true; }
    machine done() {}
}

public machine observe_normal_completion(checker: @mutable |checker|::Checker, value: |evaluation|::Value) {
    transition checker.collecting_completion && !checker.zone.infeasible {
        true -> observed(checker, value),
        false -> done()
    }
    machine observed(checker: @mutable |checker|::Checker, value: |evaluation|::Value) {
        let interval: |evaluation|::Value = |evaluation|::value_interval(value);
        transition checker.completion_seen {
            true -> joined(checker, interval),
            false -> first(checker, interval)
        }
    }
    machine joined(checker: @mutable |checker|::Checker, interval: |evaluation|::Value) {
        let joined: |evaluation|::Value = |evaluation|::value_hull(checker.completion_value, interval);
        checker.completion_value = joined;
    }
    machine first(checker: @mutable |checker|::Checker, interval: |evaluation|::Value) { checker.completion_seen = true; checker.completion_value = interval; }
    machine done() {}
}

// A fresh call-result place receives only the universal interval. Its snapshot
// has no relation to a callee local or mutable actual; authored ensures are
// assumed separately by the existing call-contract owner.
public machine completed_numeric_result(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, expression: u64 in Trapping, target: u64 in Trapping, row: |typed_trees|::TypeRow) -> bool
crashes Trap
{
    let source_component: u64 in Trapping = |invocations|::invocation_graph_component(@checker.invocations, checker.machine);
    let target_component: u64 in Trapping = |invocations|::invocation_graph_component(@checker.invocations, target);
    transition checker.invocations.complete && source_component > 0 && target_component > 0 && source_component != target_component && target < 10240 && row.kind == |typed_trees|::TypeKind::Builtin {
        true -> retained(checker, typing, expression, target, row),
        false -> false
    }
    machine retained(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, expression: u64 in Trapping, target: u64 in Trapping, row: |typed_trees|::TypeRow) -> bool
    requires target < 10240
    {
        let completion: NumericCompletion = checker.completions[target as -Trapping];
        transition completion.available && completion.builtin == row.builtin {
            true -> materialized(checker, typing, expression, completion.value),
            false -> false
        }
    }
    machine materialized(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, expression: u64 in Trapping, value: |evaluation|::Value) -> bool {
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, expression);
        let place: u64 in Trapping = |places|::checker_place(checker, typing, |places|::PlaceKind::Call, expression, 0 as +Trapping, type_handle);
        |references|::initialize_place(checker, typing, place, value);
        let result: |evaluation|::Value = |references|::reference_value(checker, typing, place);
        |evaluation|::checker_set_value(checker, expression, result);
        place > 0
    }
}
