use pipeline/typed_trees_to_checked_trees/flow.omg;
use pipeline/typed_trees_to_checked_trees/obligations.omg;
use pipeline/typed_trees_to_checked_trees/call_bindings.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;

use representations/checks/checks.omg;
use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Contract facts (wiki/spec/language/state_contracts.md). A body assumes
// its `requires` facts: its callers and predecessors established them. A
// call or state jump owes its target's `requires` facts, decided with each
// target parameter standing for its argument's value. Every normal return
// owes its machine's `ensures` facts with `result` standing for the
// returned value, and after a call its callee's `ensures` facts hold of the
// call's result and arguments (wiki/spec/language/state_contracts.md
// #returns-and-proof-use). Only a typed fact
// carries its meaning, so an untyped one is neither assumed nor proved.

// The clauses and parameters a call's callee declares: a machine's own, or
// a machine binder's `requires machine` contract's (wiki/spec/language/
// generics.md#static-machine-binder-categories). A binder without a contract
// and every other selection declare none.
public data CallClauses [copy] {
    first_clause: u64 in Trapping;
    clause_count: u64 in Trapping;
    first_parameter: u64 in Trapping;
    parameter_count: u64 in Trapping;
    has_return_type: bool;
    return_type: u64 in Trapping;
}

public machine call_clauses(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, selection: |typed_trees|::Selection) -> CallClauses
crashes Trap
{
    transition selection {
        |typed_trees|::Selection::Machine { handle } -> declared(syntax, handle),
        |typed_trees|::Selection::Binder { parameter } -> bound(syntax, resolution, parameter),
        _ -> none()
    }

    machine declared(syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) -> CallClauses {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, handle);
        CallClauses { first_clause: item.first_clause, clause_count: item.clause_count, first_parameter: item.first_parameter, parameter_count: item.parameter_count, has_return_type: item.has_return_type, return_type: item.return_type }
    }

    machine bound(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, parameter: u64 in Trapping) -> CallClauses {
        let contract: |symbol_resolved_trees|::BinderContract = |symbol_resolved_trees|::binder_contract(resolution, parameter);
        transition contract.present {
            true -> contracted(syntax, contract.contract),
            _ -> none()
        }
    }

    machine contracted(syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) -> CallClauses {
        let written: |syntax_trees|::Contract = |syntax_trees|::syntax_trees_contract(syntax, handle);
        CallClauses { first_clause: written.first_clause, clause_count: written.clause_count, first_parameter: written.first_parameter, parameter_count: written.parameter_count, has_return_type: written.has_return_type, return_type: written.return_type }
    }

    machine none() -> CallClauses {
        CallClauses { first_clause: 0 as +Trapping, clause_count: 0 as +Trapping, first_parameter: 0 as +Trapping, parameter_count: 0 as +Trapping, has_return_type: false, return_type: 0 as +Trapping }
    }
}

// Whether a clause run holds a clause of `kind`.
public machine declares(syntax: @|syntax_trees|::SyntaxTrees, first: u64 in Trapping, count: u64 in Trapping, kind: |syntax_trees|::ClauseKind) -> bool
crashes Trap
{
    transition { _ -> next(syntax, first, first + count, kind) }

    machine next(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping, kind: |syntax_trees|::ClauseKind) -> bool {
        transition index < end {
            true -> clause(syntax, index, end, kind),
            _ -> absent()
        }
    }

    machine clause(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping, kind: |syntax_trees|::ClauseKind) -> bool {
        let clause: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, index);
        transition clause.kind == kind {
            true -> present(),
            _ -> next(syntax, index + 1, end, kind)
        }
    }

    machine present() -> bool {
        true
    }

    machine absent() -> bool {
        false
    }
}

// Whether a type, through references, is data whose declaration carries
// `requires` facts.
public machine checker_constrained(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, type_handle: u64 in Trapping) -> bool
crashes Trap
{
    let row: |typed_trees|::TypeRow = |obligations|::referent_row(typing, type_handle);
    transition row.kind == |typed_trees|::TypeKind::Data {
        true -> data(syntax, row.item),
        _ -> unconstrained()
    }

    machine data(syntax: @|syntax_trees|::SyntaxTrees, item_handle: u64 in Trapping) -> bool {
        let item: |syntax_trees|::DataItem = |syntax_trees|::syntax_trees_data_item(syntax, item_handle);
        let required: bool = declares(syntax, item.first_clause, item.clause_count, |syntax_trees|::ClauseKind::Requires);
        transition required {
            true -> carries(),
            _ -> unconstrained()
        }
    }

    machine carries() -> bool {
        true
    }

    machine unconstrained() -> bool {
        false
    }
}

// Whether a clause's fact has been typed: only a typed fact's literals and
// names carry their meaning, so an untyped one is neither assumed nor
// proved.
machine typed_fact(typing: @|typed_trees|::Typing, clause: |syntax_trees|::Clause) -> bool
crashes Trap
{
    transition clause.has_expression {
        true -> typed(typing, clause.expression),
        _ -> untyped()
    }

    machine typed(typing: @|typed_trees|::Typing, root: u64 in Trapping) -> bool {
        let fact_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, root);
        fact_type == typing.boolean
    }

    machine untyped() -> bool {
        false
    }
}

// Assume a body's `requires` facts as it opens: its callers and
// predecessors established them.
public machine assume_requirements(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    first_clause: u64 in Trapping,
    clause_count: u64 in Trapping
)
crashes Trap
{
    let assumed: bool = decide_facts(checker, syntax, resolution, typing, first_clause, clause_count, |syntax_trees|::ClauseKind::Requires, false);
}

// A normal return owes its machine's `ensures` facts, `result` standing for
// the returned value.
public machine require_guarantees(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    returned: |evaluation|::Value,
    source_span: |source|::SourceSpan
)
crashes Trap
{
    let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, checker.machine);
    let returning: bool = checker.returning;
    let previous: |evaluation|::Value = checker.returned;
    checker.returning = true;
    checker.returned = returned;
    let held: bool = decide_facts(checker, syntax, resolution, typing, item.first_clause, item.clause_count, |syntax_trees|::ClauseKind::Ensures, true);
    checker.returning = returning;
    checker.returned = previous;
    transition held {
        true -> done(),
        _ -> unproven(checker, source_span)
    }

    machine unproven(checker: @mutable |checker|::Checker, source_span: |source|::SourceSpan) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::GuaranteeUnproven, source_span);
    }

    machine done() {}
}

// After a call its callee's `ensures` facts hold, `result` standing for the
// call's result and each parameter for its argument's value. An exclusive
// argument's place was released by the call, so a fact about it describes
// what the callee left there.
public machine assume_guarantees(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    clauses: CallClauses,
    call: |syntax_trees|::Expression,
    result: |evaluation|::Value
)
crashes Trap
{
    let returning: bool = checker.returning;
    let previous: |evaluation|::Value = checker.returned;
    checker.returning = true;
    checker.returned = result;
    let assumed: bool = decide_call_facts(checker, syntax, resolution, typing, clauses, call, |syntax_trees|::ClauseKind::Ensures, false);
    checker.returning = returning;
    checker.returned = previous;
}

// Decide a call's or jump's target facts of `kind`: while they are decided,
// each target parameter stands for its argument's value at the call.
public machine decide_call_facts(
    checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing, clauses: CallClauses, call: |syntax_trees|::Expression, kind: |syntax_trees|::ClauseKind,
    proving: bool
) -> bool
crashes Trap
{
    let mutable arguments: |call_bindings|::ArgumentValues;
    |call_bindings|::capture_call_arguments(checker, syntax, call, @mutable arguments);
    |call_bindings|::decide_bound_facts(checker, syntax, resolution, typing, clauses, @arguments, kind, proving)
}

// The next fact clause of `kind` at or after `index` in a clause run ending
// at `end` (`index` is `end` when none is left), and whether it typed.
public data FactClause [copy] {
    index: u64 in Trapping;
    fact: u64 in Trapping;
    typed: bool;
}

machine fact_clause(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, index: u64 in Trapping, end: u64 in Trapping, kind: |syntax_trees|::ClauseKind) -> FactClause
crashes Trap
{
    transition { _ -> next(syntax, typing, index, end, kind) }

    machine next(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, index: u64 in Trapping, end: u64 in Trapping, kind: |syntax_trees|::ClauseKind) -> FactClause {
        transition index < end {
            true -> clause(syntax, typing, index, end, kind),
            _ -> found(end, 0 as +Trapping, false)
        }
    }

    machine clause(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, index: u64 in Trapping, end: u64 in Trapping, kind: |syntax_trees|::ClauseKind) -> FactClause {
        let clause: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, index);
        let typed: bool = typed_fact(typing, clause);
        transition clause.kind == kind && clause.has_expression {
            true -> found(index, clause.expression, typed),
            _ -> next(syntax, typing, index + 1, end, kind)
        }
    }

    machine found(index: u64 in Trapping, fact: u64 in Trapping, typed: bool) -> FactClause {
        FactClause { index: index, fact: fact, typed: typed }
    }
}

// Decide each fact of `kind` in a clause run: assume it, or, when
// `proving`, report whether every one is proved. An untyped fact is not
// assumed and is never proved.
public machine decide_facts(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    first_clause: u64 in Trapping,
    clause_count: u64 in Trapping,
    kind: |syntax_trees|::ClauseKind,
    proving: bool
) -> bool
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, first_clause, first_clause + clause_count, kind, proving) }

    machine next(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        index: u64 in Trapping,
        end: u64 in Trapping,
        kind: |syntax_trees|::ClauseKind,
        proving: bool
    ) -> bool {
        let clause: FactClause = fact_clause(syntax, typing, index, end, kind);
        transition clause.index < end {
            true -> fact(checker, syntax, resolution, typing, clause, end, kind, proving),
            _ -> answer(true)
        }
    }

    machine fact(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        clause: FactClause,
        end: u64 in Trapping,
        kind: |syntax_trees|::ClauseKind,
        proving: bool
    ) -> bool {
        let holds: bool = clause.typed && |flow|::decide_fact(checker, syntax, resolution, typing, clause.fact, proving);
        transition holds || !proving {
            true -> next(checker, syntax, resolution, typing, clause.index + 1, end, kind, proving),
            _ -> answer(false)
        }
    }

    machine answer(held: bool) -> bool {
        held
    }
}

// Decide a declared domain's predicates, its `requires` facts, as trees: a
// membership inside them is an unknown Boolean, so deciding a membership
// through its domain never recurs.
public machine decide_predicates(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    first_clause: u64 in Trapping,
    clause_count: u64 in Trapping,
    proving: bool
) -> bool
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, first_clause, first_clause + clause_count, proving) }

    machine next(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        index: u64 in Trapping,
        end: u64 in Trapping,
        proving: bool
    ) -> bool {
        let clause: FactClause = fact_clause(syntax, typing, index, end, |syntax_trees|::ClauseKind::Requires);
        transition clause.index < end {
            true -> fact(checker, syntax, resolution, typing, clause, end, proving),
            _ -> answer(true)
        }
    }

    machine fact(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        clause: FactClause,
        end: u64 in Trapping,
        proving: bool
    ) -> bool {
        let holds: bool = clause.typed && |flow|::decide_tree(checker, syntax, resolution, typing, clause.fact, proving);
        transition holds || !proving {
            true -> next(checker, syntax, resolution, typing, clause.index + 1, end, proving),
            _ -> answer(false)
        }
    }

    machine answer(held: bool) -> bool {
        held
    }
}

machine set_argument(checker: @mutable |checker|::Checker, offset: u64 in Trapping, value: |evaluation|::Value)
crashes Trap
{
    transition offset < 64 {
        true -> write(checker, offset, value),
        _ -> invalid()
    }

    machine write(checker: @mutable |checker|::Checker, offset: u64 in Trapping, value: |evaluation|::Value)
    requires offset < 64
    {
        checker.arguments[offset as -Trapping] = value;
    }

    machine invalid() {
        crash Trap;
    }
}

// The value a substituted parameter stands for.
public machine argument_value(checker: @|checker|::Checker, offset: u64 in Trapping) -> |evaluation|::Value
crashes Trap
{
    transition offset < checker.argument_count && offset < 64 {
        true -> read(checker, offset),
        _ -> invalid()
    }

    machine read(checker: @|checker|::Checker, offset: u64 in Trapping) -> |evaluation|::Value
    requires offset < 64
    {
        checker.arguments[offset as -Trapping]
    }

    machine invalid() -> |evaluation|::Value {
        crash Trap;
    }
}
