use pipeline/typed_trees_to_checked_trees/flow.omg;
use pipeline/typed_trees_to_checked_trees/obligations.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/contracts.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;
use pipeline/typed_trees_to_checked_trees/places.omg;

use representations/checks/checks.omg;
use representations/source_files/source.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Declared domain qualification (wiki/spec/language/domains.md). A value
// whose type a declared domain qualifies (`value: u64 in Positive`, through
// a reference for `@[u8] in Path`) satisfies that domain's predicates,
// decided with the domain's subject binder standing for the value: a
// parameter's from its body's entry, a qualified local's after its binding.
// Where a value meets a destination a domain qualifies (a call or jump
// argument, a returned value, a `let` initializer, a store, an `as` cast),
// the value must already carry that exact qualification, an unadapted value
// of a type it qualifies, or satisfy the predicates there. A routed domain's
// provenance is never minted from predicates
// (wiki/spec/language/domains.md#exact-coercion-and-erasure): only carrying
// the qualification establishes it. Primitive byte predicates evaluate to
// no known value yet, so a domain naming one is likewise established only
// by carrying it.

// The declared domain qualifying a type, directly or as a reference's
// referent, plus one; zero for none.
public machine qualifying_domain(typing: @|typed_trees|::Typing, type_handle: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
    transition row.kind == |typed_trees|::TypeKind::Reference {
        true -> referent(typing, row.inner),
        _ -> own(row)
    }

    machine referent(typing: @|typed_trees|::Typing, inner: u64 in Trapping) -> u64 in Trapping {
        let inner_row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, inner);
        transition { _ -> own(inner_row) }
    }

    machine own(row: |typed_trees|::TypeRow) -> u64 in Trapping {
        transition row.domain == |symbol_resolved_trees|::DomainBinding::Declared {
            true -> declared(row.domain_item),
            _ -> none()
        }
    }

    machine declared(domain: u64 in Trapping) -> u64 in Trapping {
        domain + 1
    }

    machine none() -> u64 in Trapping {
        0 as +Trapping
    }
}

// Decide domain `domain`'s predicates of `subject`: assume them, or, when
// `proving`, whether every one holds. A routed domain is never proved here.
public machine decide_domain(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    domain: u64 in Trapping,
    subject: |evaluation|::Value,
    proving: bool
) -> bool
crashes Trap
{
    let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, domain);
    transition proving && item.route_count > 0 {
        true -> routed(checker, syntax, resolution, typing, item, subject, proving),
        _ -> predicates(checker, syntax, resolution, typing, item, subject, proving)
    }

    // A routed domain's provenance is its routes: a machine named by one
    // establishes its own result, which still meets the predicates
    // (wiki/spec/language/domains.md: each `established by` entry is an
    // authorized origin).
    machine routed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::DomainItem, subject: |evaluation|::Value, proving: bool) -> bool {
        let origin: bool = routes_to(resolution, item, checker.machine);
        transition checker.minting && origin {
            true -> predicates(checker, syntax, resolution, typing, item, subject, proving),
            _ -> unestablished()
        }
    }

    machine predicates(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::DomainItem, subject: |evaluation|::Value, proving: bool) -> bool {
        let subjecting: bool = checker.subjecting;
        let previous: |evaluation|::Value = checker.subject;
        checker.subjecting = true;
        checker.subject = subject;
        let held: bool = |contracts|::decide_predicates(checker, syntax, resolution, typing, item.first_clause, item.clause_count, proving);
        checker.subjecting = subjecting;
        checker.subject = previous;
        held
    }

    machine unestablished() -> bool {
        false
    }
}

// Whether a fact's operand is `result`.
public machine names_result(resolution: @|symbol_resolved_trees|::NameResolution, node: u64 in Trapping) -> bool
crashes Trap
{
    let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, node);
    transition binding {
        |symbol_resolved_trees|::ValueBinding::ReturnedValue { machine as _ } -> answer(true),
        |symbol_resolved_trees|::ValueBinding::ContractReturnedValue { contract as _ } -> answer(true),
        _ -> answer(false)
    }

    machine answer(result: bool) -> bool {
        result
    }
}

// Whether one of a domain's `established by` routes names machine
// `machine`.
public machine routes_to(resolution: @|symbol_resolved_trees|::NameResolution, item: |syntax_trees|::DomainItem, machine: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(resolution, item, machine, 0 as +Trapping) }

    machine next(resolution: @|symbol_resolved_trees|::NameResolution, item: |syntax_trees|::DomainItem, machine: u64 in Trapping, offset: u64 in Trapping) -> bool {
        transition offset < item.route_count {
            true -> route(resolution, item, machine, offset),
            _ -> answer(false)
        }
    }

    machine route(resolution: @|symbol_resolved_trees|::NameResolution, item: |syntax_trees|::DomainItem, machine: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let binding: |symbol_resolved_trees|::PathBinding = |symbol_resolved_trees|::path_binding_at(resolution, item.first_route + offset);
        transition binding {
            |symbol_resolved_trees|::PathBinding::Machine { handle } -> named(resolution, item, machine, offset, handle),
            _ -> next(resolution, item, machine, offset + 1)
        }
    }

    machine named(resolution: @|symbol_resolved_trees|::NameResolution, item: |syntax_trees|::DomainItem, machine: u64 in Trapping, offset: u64 in Trapping, handle: u64 in Trapping) -> bool {
        transition handle == machine {
            true -> answer(true),
            _ -> next(resolution, item, machine, offset + 1)
        }
    }

    machine answer(found: bool) -> bool {
        found
    }
}

// A whole fact `value in Domain` (wiki/spec/language/domains.md#refinement-and-tests)
// is the domain's predicates with its subject binder standing for the
// value: assumed as they are, or proved, unless the value already carries
// the qualification (an unadapted value of a type it qualifies); a routed
// domain is proved only by carrying it. A case membership
// `value in Type::Case` establishes nothing assumed and, needing case
// knowledge checking does not keep, rejects as unsupported where it must
// hold.
public machine decide_membership(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    root: u64 in Trapping,
    proving: bool
) -> bool
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    let path: |symbol_resolved_trees|::PathBinding = |symbol_resolved_trees|::path_binding_at(resolution, tree.first);
    transition path {
        |symbol_resolved_trees|::PathBinding::Domain { item } -> declared(checker, syntax, resolution, typing, root, tree, item, proving),
        _ -> undecided(checker, tree, proving)
    }

    machine declared(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        tree: |syntax_trees|::Expression,
        item: u64 in Trapping,
        proving: bool
    ) -> bool {
        let value_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, tree.left);
        let carried: u64 in Trapping = qualifying_domain(typing, value_type);
        let adaptation: |typed_trees|::Adaptation = |typed_trees|::typing_adaptation(typing, tree.left);
        transition carried == item + 1 && adaptation == |typed_trees|::Adaptation::None {
            true -> held(),
            _ -> valued(checker, syntax, resolution, typing, root, tree, item, proving)
        }
    }

    machine valued(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        root: u64 in Trapping,
        tree: |syntax_trees|::Expression,
        item: u64 in Trapping,
        proving: bool
    ) -> bool {
        let value: |evaluation|::Value = |flow|::fact_operand(checker, syntax, resolution, typing, root, tree.left);
        let result: bool = names_result(resolution, tree.left);
        let minting: bool = checker.minting;
        checker.minting = proving && checker.returning && result;
        let decided: bool = decide_domain(checker, syntax, resolution, typing, item, value, proving);
        checker.minting = minting;
        decided
    }

    machine undecided(checker: @mutable |checker|::Checker, tree: |syntax_trees|::Expression, proving: bool) -> bool {
        transition proving {
            true -> unsupported(checker, tree),
            _ -> held()
        }
    }

    machine unsupported(checker: @mutable |checker|::Checker, tree: |syntax_trees|::Expression) -> bool {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::UnsupportedFact, tree.source_span);
        transition { _ -> refused() }
    }

    machine held() -> bool {
        true
    }

    machine refused() -> bool {
        false
    }
}

// A value, `expression`'s, meeting a destination of type `destination`.
public machine require_qualification(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    destination: u64 in Trapping,
    expression: u64 in Trapping,
    value: |evaluation|::Value,
    source_span: |source|::SourceSpan
)
crashes Trap
{
    let wanted: u64 in Trapping = qualifying_domain(typing, destination);
    transition wanted > 0 {
        true -> qualified(checker, syntax, resolution, typing, wanted - 1, expression, value, source_span),
        _ -> done()
    }

    machine qualified(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        domain: u64 in Trapping,
        expression: u64 in Trapping,
        value: |evaluation|::Value,
        source_span: |source|::SourceSpan
    ) {
        let given_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, expression);
        let given: u64 in Trapping = qualifying_domain(typing, given_type);
        let adaptation: |typed_trees|::Adaptation = |typed_trees|::typing_adaptation(typing, expression);
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, expression);
        let roster: u64 in Trapping = |typed_trees|::typing_roster(typing, expression);
        transition given == domain + 1 && adaptation == |typed_trees|::Adaptation::None {
            true -> done(),
            _ -> decided(checker, syntax, resolution, typing, domain, value, source_span, written.kind == |syntax_trees|::ExpressionKind::String, roster)
        }
    }

    // A quoted literal's byte predicates are decided from its octets'
    // roster (wiki/spec/terminal-psi/structural_access.md).
    machine decided(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, domain: u64 in Trapping, value: |evaluation|::Value, source_span: |source|::SourceSpan, literal: bool, roster: u64 in Trapping) {
        let previous_literal: bool = checker.subject_literal;
        let previous_roster: u64 in Trapping = checker.subject_roster;
        checker.subject_literal = literal;
        checker.subject_roster = roster;
        let held: bool = decide_domain(checker, syntax, resolution, typing, domain, value, true);
        checker.subject_literal = previous_literal;
        checker.subject_roster = previous_roster;
        transition held {
            true -> done(),
            _ -> unproven(checker, source_span)
        }
    }

    machine unproven(checker: @mutable |checker|::Checker, source_span: |source|::SourceSpan) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::DomainUnproven, source_span);
    }

    machine done() {}
}

// A value of type `type_handle` satisfies the predicates of the declared
// domain qualifying it.
public machine assume_qualification(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, type_handle: u64 in Trapping, value: |evaluation|::Value)
crashes Trap
{
    let wanted: u64 in Trapping = qualifying_domain(typing, type_handle);
    transition wanted > 0 {
        true -> assumed(checker, syntax, resolution, typing, wanted - 1, value),
        _ -> done()
    }

    machine assumed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, domain: u64 in Trapping, value: |evaluation|::Value) {
        let held: bool = decide_domain(checker, syntax, resolution, typing, domain, value, false);
    }

    machine done() {}
}

// Each argument of a call or jump meets its formal's qualification, the
// formals `first_parameter .. first_parameter + parameter_count`.
public machine require_argument_qualifications(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    call: |syntax_trees|::Expression,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping
)
crashes Trap
{
    let count: u64 in Trapping = |obligations|::operand_count(call);
    transition { _ -> next(checker, syntax, resolution, typing, call, first_parameter, parameter_count, count, 0 as +Trapping) }

    machine next(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        call: |syntax_trees|::Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        count: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        transition offset < count && offset < parameter_count {
            true -> argument(checker, syntax, resolution, typing, call, first_parameter, parameter_count, count, offset),
            _ -> done()
        }
    }

    machine argument(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        call: |syntax_trees|::Expression,
        first_parameter: u64 in Trapping,
        parameter_count: u64 in Trapping,
        count: u64 in Trapping,
        offset: u64 in Trapping
    ) {
        let parameter: |syntax_trees|::Parameter = |syntax_trees|::syntax_trees_parameter(syntax, first_parameter + offset);
        let destination: u64 in Trapping = |typed_trees|::reference_type(typing, parameter.type_reference);
        let handle: u64 in Trapping = |obligations|::checker_operand(syntax, call, offset);
        let value: |evaluation|::Value = |evaluation|::value_at(checker, handle);
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
        require_qualification(checker, syntax, resolution, typing, destination, handle, value, written.source_span);
        transition { _ -> next(checker, syntax, resolution, typing, call, first_parameter, parameter_count, count, offset + 1) }
    }

    machine done() {}
}

// A call's arguments meet its callee's formals: a machine's, or a machine
// binder's contract's.
public machine require_call_qualifications(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, selection: |typed_trees|::Selection, call: |syntax_trees|::Expression)
crashes Trap
{
    let clauses: |contracts|::CallClauses = |contracts|::call_clauses(syntax, resolution, selection);
    require_argument_qualifications(checker, syntax, resolution, typing, call, clauses.first_parameter, clauses.parameter_count);
}

// Each formal of a body that opens satisfies its qualification.
public machine assume_parameter_qualifications(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    first_parameter: u64 in Trapping,
    parameter_count: u64 in Trapping
)
crashes Trap
{
    transition { _ -> next(checker, syntax, resolution, typing, first_parameter, parameter_count, 0 as +Trapping) }

    machine next(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, offset: u64 in Trapping) {
        transition offset < parameter_count {
            true -> formal(checker, syntax, resolution, typing, first_parameter, parameter_count, offset),
            _ -> done()
        }
    }

    machine formal(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, first_parameter: u64 in Trapping, parameter_count: u64 in Trapping, offset: u64 in Trapping) {
        let parameter: |syntax_trees|::Parameter = |syntax_trees|::syntax_trees_parameter(syntax, first_parameter + offset);
        let type_handle: u64 in Trapping = |typed_trees|::reference_type(typing, parameter.type_reference);
        let place: u64 in Trapping = |places|::find_place(checker, |places|::PlaceKind::Parameter, first_parameter + offset, 0 as +Trapping);
        let value: |evaluation|::Value = |places|::place_value(checker, place);
        assume_qualification(checker, syntax, resolution, typing, type_handle, value);
        transition { _ -> next(checker, syntax, resolution, typing, first_parameter, parameter_count, offset + 1) }
    }

    machine done() {}
}

// A returned value meets the machine's declared result type.
public machine require_result_qualification(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, expression: u64 in Trapping, value: |evaluation|::Value, source_span: |source|::SourceSpan)
crashes Trap
{
    let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, checker.machine);
    transition item.has_return_type {
        true -> declared(checker, syntax, resolution, typing, item, expression, value, source_span),
        _ -> done()
    }

    // The machine's own result: its routes may mint it.
    machine declared(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, expression: u64 in Trapping, value: |evaluation|::Value, source_span: |source|::SourceSpan) {
        let destination: u64 in Trapping = |typed_trees|::reference_type(typing, item.return_type);
        let minting: bool = checker.minting;
        checker.minting = true;
        require_qualification(checker, syntax, resolution, typing, destination, expression, value, source_span);
        checker.minting = minting;
    }

    machine done() {}
}

// A store meets its target's qualification in the checking walk.
public machine require_stored_qualification(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    destination: u64 in Trapping,
    expression: u64 in Trapping,
    value: |evaluation|::Value,
    source_span: |source|::SourceSpan,
    checking: bool
)
crashes Trap
{
    transition checking {
        true -> stored(checker, syntax, resolution, typing, destination, expression, value, source_span),
        _ -> done()
    }

    machine stored(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, destination: u64 in Trapping, expression: u64 in Trapping, value: |evaluation|::Value, source_span: |source|::SourceSpan) {
        require_qualification(checker, syntax, resolution, typing, destination, expression, value, source_span);
    }

    machine done() {}
}
