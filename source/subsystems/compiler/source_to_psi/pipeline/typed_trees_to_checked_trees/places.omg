use pipeline/typed_trees_to_checked_trees/aliases.omg;
use pipeline/typed_trees_to_checked_trees/constructions.omg;
use pipeline/typed_trees_to_checked_trees/contracts.omg;
use pipeline/typed_trees_to_checked_trees/facts.omg;
use pipeline/typed_trees_to_checked_trees/obligations.omg;
use pipeline/typed_trees_to_checked_trees/reference_origins.omg;
use pipeline/typed_trees_to_checked_trees/references.omg;
use pipeline/typed_trees_to_checked_trees/arrivals.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/domains.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;
use pipeline/typed_trees_to_checked_trees/zone.omg;

use foundation/integers.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// The places a body names and the integer and Boolean subjects among them. A place is a
// parameter, a local, a case-pattern binder, a call's result, a
// construction, an operand's snapshot, or a field or slice length of
// another place; equal paths are one place. An integer place is a subject of
// the body's zone, entered with its carrier's range: a fixed integer's value
// always lies in its carrier, whatever its policy
// (wiki/spec/language/numeric_values.md#integer-equality-and-order). Facts
// about a place hold until a write to it or to a place containing it.
public data PlaceKind [copy] {
    case Parameter;
    case Local;
    case Binder;
    case Field;
    case Length;
    // The scalar contents of a reference parameter, below its storage root.
    case Referent;
    // A call's result, by the call's expression handle: the value its
    // callee's `ensures` facts describe.
    case Call;
    // A construction's value, by its expression handle, its fields pending
    // below it (constructions.omg).
    case Construction;
    // What an operand read before a later operand wrote it, by the lending
    // operand's handle under the place read (snapshots.omg).
    case Snapshot;
    // Immutable invocation-entry ranking coordinates and range endpoints.
    case RankEntry;
    // The one arbitrary typed result in a fresh universal-refinement world.
    // It is not an authored call or an executable/borrow authority.
    case ContractResult;
    // Each returned-view publication owns an immutable logical home. A
    // later use of the same call expression cannot redirect an older alias.
    case View;
}

public data Place [copy] {
    kind: PlaceKind;
    // The parameter, `let` statement, pattern field or data field handle.
    handle: u64 in Trapping;
    // The containing place of a field or length.
    parent: u64 in Trapping;
    type_handle: u64 in Trapping;
    // The zone subject of an integer place; zero for any other.
    subject: u64 in Trapping;
}

public machine place_at(checker: @|checker|::Checker, index: u64 in Trapping) -> Place
crashes Trap
{
    transition index < checker.place_count && index < 256 {
        true -> read(checker, index),
        _ -> invalid()
    }

    machine read(checker: @|checker|::Checker, index: u64 in Trapping) -> Place
    requires index < 256
    {
        checker.places[index as -Trapping]
    }

    machine invalid() -> Place {
        crash Trap;
    }
}

// The carrier of an interned type's subject: a fixed integer's, `Bool` for
// a Boolean, whose subject is 1 when true and 0 when false, or `Never` when
// the type has no subject.
public machine checker_carrier(typing: @|typed_trees|::Typing, type_handle: u64 in Trapping) -> |symbol_resolved_trees|::BuiltinType
crashes Trap
{
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
    let integer: bool = |integers|::is_carrier(row.builtin);
    transition row.kind == |typed_trees|::TypeKind::Builtin && (integer || row.builtin == |symbol_resolved_trees|::BuiltinType::Bool) {
        true -> found(row.builtin),
        _ -> none()
    }

    machine found(builtin: |symbol_resolved_trees|::BuiltinType) -> |symbol_resolved_trees|::BuiltinType {
        builtin
    }

    machine none() -> |symbol_resolved_trees|::BuiltinType {
        |symbol_resolved_trees|::BuiltinType::Never
    }
}

// Whether a place of this carrier is a subject: a fixed integer or a
// Boolean.
public machine has_subject(carrier: |symbol_resolved_trees|::BuiltinType) -> bool {
    |integers|::is_carrier(carrier) || carrier == |symbol_resolved_trees|::BuiltinType::Bool
}

// Reserve all 64 zone subjects. Only subject zero is assigned at entry.
public machine open_places(checker: @mutable |checker|::Checker)
crashes Trap
{
    checker.place_count = 0;
    checker.subject_count = 1;
    checker.domains_pending = false;
    checker.aliases.count = 0;
    checker.pending_count = 0;
    |reference_origins|::clear_reference_origins(checker);
    |zone|::zone_open(@mutable checker.zone, 64 as +Trapping);
}

// The place `kind`/`handle` under `parent`, entered on first use. Zero when
// the tables are full, which rejects the body.
public machine checker_place(
    checker: @mutable |checker|::Checker,
    typing: @|typed_trees|::Typing,
    kind: PlaceKind,
    handle: u64 in Trapping,
    parent: u64 in Trapping,
    type_handle: u64 in Trapping
) -> u64 in Trapping
crashes Trap
{
    transition { _ -> search(checker, typing, kind, handle, parent, type_handle, 0 as +Trapping) }

    machine search(
        checker: @mutable |checker|::Checker,
        typing: @|typed_trees|::Typing,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        index: u64 in Trapping
    ) -> u64 in Trapping {
        transition index < checker.place_count {
            true -> compare(checker, typing, kind, handle, parent, type_handle, index),
            _ -> enter(checker, typing, kind, handle, parent, type_handle)
        }
    }

    machine compare(
        checker: @mutable |checker|::Checker,
        typing: @|typed_trees|::Typing,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        index: u64 in Trapping
    ) -> u64 in Trapping {
        let place: Place = place_at(checker, index);
        let same: bool = same_place(place, kind, handle, parent);
        transition same {
            true -> found(index),
            _ -> search(checker, typing, kind, handle, parent, type_handle, index + 1)
        }
    }

    machine found(index: u64 in Trapping) -> u64 in Trapping {
        index + 1
    }

    machine enter(
        checker: @mutable |checker|::Checker,
        typing: @|typed_trees|::Typing,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping
    ) -> u64 in Trapping {
        let carrier: |symbol_resolved_trees|::BuiltinType = place_carrier(typing, kind, type_handle);
        let integer: bool = has_subject(carrier);
        transition checker.place_count < 256 {
            true -> room(checker, kind, handle, parent, type_handle, carrier, integer),
            _ -> full(checker)
        }
    }

    machine room(
        checker: @mutable |checker|::Checker,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        carrier: |symbol_resolved_trees|::BuiltinType,
        integer: bool
    ) -> u64 in Trapping {
        transition integer {
            true -> subject(checker, kind, handle, parent, type_handle, carrier),
            _ -> plain(checker, kind, handle, parent, type_handle)
        }
    }

    machine plain(
        checker: @mutable |checker|::Checker,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping
    ) -> u64 in Trapping {
        let place: Place = Place { kind: kind, handle: handle, parent: parent, type_handle: type_handle, subject: 0 as +Trapping };
        transition { _ -> stored(checker, place) }
    }

    machine subject(
        checker: @mutable |checker|::Checker,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        carrier: |symbol_resolved_trees|::BuiltinType
    ) -> u64 in Trapping {
        let subject: u64 in Trapping = checker.subject_count as +Trapping;
        transition subject < 64 {
            true -> numbered(checker, kind, handle, parent, type_handle, carrier, subject),
            _ -> full(checker)
        }
    }

    machine numbered(
        checker: @mutable |checker|::Checker,
        kind: PlaceKind,
        handle: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        carrier: |symbol_resolved_trees|::BuiltinType,
        subject: u64 in Trapping
    ) -> u64 in Trapping {
        let next: u64 in Trapping = subject + 1;
        checker.subject_count = next as u64;
        enter_place_range(checker, kind, subject, carrier);
        let place: Place = Place { kind: kind, handle: handle, parent: parent, type_handle: type_handle, subject: subject };
        transition { _ -> stored(checker, place) }
    }

    machine stored(checker: @mutable |checker|::Checker, place: Place) -> u64 in Trapping {
        let index: u64 = checker.place_count;
        store_place(checker, index, place);
        let position: u64 in Trapping = index as u64 +Trapping;
        let next: u64 in Trapping = position + 1;
        checker.place_count = next as u64;
        |domains|::set_domain_mark(checker, position, |domains|::DomainMark::Unseen);
        transition place.kind == PlaceKind::Field {
            true -> field(checker, place, position, next),
            _ -> entered(next)
        }
    }

    // A field a construction wrote there holds its value.
    machine field(checker: @mutable |checker|::Checker, place: Place, position: u64 in Trapping, next: u64 in Trapping) -> u64 in Trapping {
        |domains|::note_field(checker, position);
        |constructions|::take_pending(checker, place);
        next
    }

    machine entered(next: u64 in Trapping) -> u64 in Trapping {
        next
    }

    // A full table loses the place; the body rejects once it ends.
    machine full(checker: @mutable |checker|::Checker) -> u64 in Trapping {
        checker.overflowed = true;
        0 as +Trapping
    }
}

// A place's carrier: a slice length's is `u64`, any other place's its type's.
public machine place_carrier(typing: @|typed_trees|::Typing, kind: PlaceKind, type_handle: u64 in Trapping) -> |symbol_resolved_trees|::BuiltinType
crashes Trap
{
    transition kind == PlaceKind::Length || kind == PlaceKind::RankEntry {
        true -> length(),
        _ -> typed(typing, type_handle)
    }

    machine length() -> |symbol_resolved_trees|::BuiltinType {
        |symbol_resolved_trees|::BuiltinType::U64
    }

    machine typed(typing: @|typed_trees|::Typing, type_handle: u64 in Trapping) -> |symbol_resolved_trees|::BuiltinType {
        let carrier: |symbol_resolved_trees|::BuiltinType = checker_carrier(typing, type_handle);
        carrier
    }
}

// The place `kind`/`handle` under `parent` (one-based), or zero when the
// body has not entered it.
public machine find_place(checker: @|checker|::Checker, kind: PlaceKind, handle: u64 in Trapping, parent: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition { _ -> search(checker, kind, handle, parent, 0 as +Trapping) }

    machine search(checker: @|checker|::Checker, kind: PlaceKind, handle: u64 in Trapping, parent: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        transition index < checker.place_count {
            true -> compare(checker, kind, handle, parent, index),
            _ -> absent()
        }
    }

    machine compare(checker: @|checker|::Checker, kind: PlaceKind, handle: u64 in Trapping, parent: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        let place: Place = place_at(checker, index);
        let same: bool = same_place(place, kind, handle, parent);
        transition same {
            true -> found(index + 1),
            _ -> search(checker, kind, handle, parent, index + 1)
        }
    }

    machine found(place: u64 in Trapping) -> u64 in Trapping {
        place
    }

    machine absent() -> u64 in Trapping {
        0 as +Trapping
    }
}

machine same_place(place: Place, kind: PlaceKind, handle: u64 in Trapping, parent: u64 in Trapping) -> bool {
    place.kind == kind && place.handle == handle && place.parent == parent
}

machine store_place(checker: @mutable |checker|::Checker, index: u64, place: Place)
crashes Trap
{
    transition index < 256 {
        true -> write(checker, index, place),
        _ -> invalid()
    }

    machine write(checker: @mutable |checker|::Checker, index: u64, place: Place) {
        checker.places[index] = place;
    }

    machine invalid() {
        crash Trap;
    }
}

// A new subject's value lies in its carrier's range.
public machine enter_range(checker: @mutable |checker|::Checker, subject: u64 in Trapping, carrier: |symbol_resolved_trees|::BuiltinType)
crashes Trap
{
    let least: |integers|::ExactInteger = |integers|::minimum(carrier);
    let greatest: |integers|::ExactInteger = |integers|::maximum(carrier);
    let floor: |integers|::ExactInteger = |integers|::exact_integer_negate(least);
    let upper: |zone|::Bound = |zone|::exactly(greatest);
    let lower: |zone|::Bound = |zone|::exactly(floor);
    |zone|::constrain(@mutable checker.zone, 0 as +Trapping, subject, upper);
    |zone|::constrain(@mutable checker.zone, subject, 0 as +Trapping, lower);
    transition { _ -> saved(checker, subject, upper, lower, 0 as +Trapping) }

    // The range is a fact of the place's type, so it holds on every path:
    // a zone saved before the place was entered (an open `&&`/`||` context
    // or transition) takes it too, or a later join would lose it.
    machine saved(checker: @mutable |checker|::Checker, subject: u64 in Trapping, upper: |zone|::Bound, lower: |zone|::Bound, index: u64 in Trapping) {
        transition index < checker.saved_count && index < 8 {
            true -> ranged(checker, subject, upper, lower, index),
            _ -> done()
        }
    }

    machine ranged(checker: @mutable |checker|::Checker, subject: u64 in Trapping, upper: |zone|::Bound, lower: |zone|::Bound, index: u64 in Trapping)
    requires index < 8
    {
        checker.merged = checker.saved[index as -Trapping];
        |zone|::constrain(@mutable checker.merged, 0 as +Trapping, subject, upper);
        |zone|::constrain(@mutable checker.merged, subject, 0 as +Trapping, lower);
        checker.saved[index as -Trapping] = checker.merged;
        transition { _ -> saved(checker, subject, upper, lower, index + 1) }
    }

    machine done() {}
}

// Every subject place's carrier range, again. A state's arrival replaces the
// zone its places were entered in, and widening may have dropped a bound
// that only the carrier implied; the range holds on every arrival all the
// same.
public machine restore_ranges(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing)
crashes Trap
{
    transition { _ -> next(checker, typing, 0 as +Trapping) }

    machine next(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        transition index < checker.place_count {
            true -> visit(checker, typing, index),
            _ -> done()
        }
    }

    machine visit(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, index: u64 in Trapping) {
        let candidate: Place = place_at(checker, index);
        transition candidate.subject > 0 {
            true -> ranged(checker, typing, index, candidate),
            _ -> next(checker, typing, index + 1)
        }
    }

    machine ranged(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, index: u64 in Trapping, candidate: Place) {
        let carrier: |symbol_resolved_trees|::BuiltinType = place_carrier(typing, candidate.kind, candidate.type_handle);
        enter_place_range(checker, candidate.kind, candidate.subject, carrier);
        transition { _ -> next(checker, typing, index + 1) }
    }

    machine done() {}
}

// Forget every fact about `place` and the places it contains, as a write to
// it or an exclusive loan of it may change them all. The carrier ranges
// return with the subjects.
public machine forget_place(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping)
crashes Trap
{
    forget_storage(checker, typing, place, false);
    forget_backing(checker, typing, place);
}

// A view (a range slice's place, a referent below its collection with the
// slice's node as its handle) shares its collection's storage: writing or
// lending it exclusively may change any of the collection's contents.
public machine forget_backing(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping)
crashes Trap
{
    transition place > 0 && place <= 256 {
        true -> entered(checker, typing, place),
        _ -> done()
    }

    machine entered(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping) {
        let entry: Place = place_at(checker, place - 1);
        transition entry.kind == PlaceKind::Referent && entry.handle > 0 && entry.parent > 0 {
            true -> backing(checker, typing, entry.parent),
            _ -> done()
        }
    }

    machine backing(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, collection: u64 in Trapping) {
        forget_storage(checker, typing, collection, true);
    }

    machine done() {}
}

// An element store changes collection contents, not the collection's own
// length. Nested lengths are still mutable contents: replacing an element
// may replace a slice inside it. Keep all other write bookkeeping shared.
public machine forget_contents(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping)
crashes Trap
{
    forget_storage(checker, typing, place, true);
    forget_backing(checker, typing, place);
}

machine forget_storage(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping, contents: bool)
crashes Trap
{
    |constructions|::forget_pending(checker, typing, place);
    |aliases|::forget_aliases(checker, place);
    transition { _ -> next(checker, typing, place, contents, 0 as +Trapping) }

    machine next(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping, contents: bool, index: u64 in Trapping) {
        transition index < checker.place_count {
            true -> visit(checker, typing, place, contents, index),
            _ -> done(checker, place)
        }
    }

    machine visit(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping, contents: bool, index: u64 in Trapping) {
        let within: bool = checker_within(checker, index + 1, place);
        let candidate: Place = place_at(checker, index);
        let length: bool = contents && candidate.kind == PlaceKind::Length && candidate.parent == place;
        transition within && candidate.subject > 0 && !length {
            true -> clear(checker, typing, place, contents, index, candidate),
            _ -> next(checker, typing, place, contents, index + 1)
        }
    }

    machine clear(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping, contents: bool, index: u64 in Trapping, candidate: Place) {
        let carrier: |symbol_resolved_trees|::BuiltinType = place_carrier(typing, candidate.kind, candidate.type_handle);
        |zone|::zone_forget(@mutable checker.zone, candidate.subject);
        enter_place_range(checker, candidate.kind, candidate.subject, carrier);
        transition { _ -> next(checker, typing, place, contents, index + 1) }
    }

    machine done(checker: @mutable |checker|::Checker, place: u64 in Trapping) {
        |domains|::reopen_domains(checker, place);
    }
}

// The value (one-based place) whose invariant window storing `place` opens:
// the owner of a stored field when its data carries `requires` facts, else
// zero.
public machine window_owner(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, place: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition place > 0 {
        true -> stored(checker, syntax, typing, place),
        _ -> none()
    }

    machine stored(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, place: u64 in Trapping) -> u64 in Trapping {
        let entry: Place = place_at(checker, place - 1);
        transition entry.kind == PlaceKind::Field && entry.parent > 0 {
            true -> parent(checker, syntax, typing, entry.parent),
            _ -> none()
        }
    }

    machine parent(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, parent: u64 in Trapping) -> u64 in Trapping {
        let owner: Place = place_at(checker, parent - 1);
        let constrained: bool = |contracts|::checker_constrained(syntax, typing, owner.type_handle);
        transition constrained {
            true -> found(parent),
            _ -> none()
        }
    }

    machine found(parent: u64 in Trapping) -> u64 in Trapping {
        parent
    }

    machine none() -> u64 in Trapping {
        0 as +Trapping
    }
}

// Whether place `inner` (one-based) is `outer` (one-based) or lies within it.
public machine checker_within(checker: @|checker|::Checker, inner: u64 in Trapping, outer: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> step(checker, inner, outer, 0 as +Trapping) }

    machine step(checker: @|checker|::Checker, current: u64 in Trapping, outer: u64 in Trapping, depth: u64 in Trapping) -> bool {
        transition current == outer {
            true -> yes(),
            _ -> climb(checker, current, outer, depth)
        }
    }

    machine climb(checker: @|checker|::Checker, current: u64 in Trapping, outer: u64 in Trapping, depth: u64 in Trapping) -> bool {
        transition current > 0 && depth < 256 {
            true -> parent(checker, current, outer, depth),
            _ -> no()
        }
    }

    machine parent(checker: @|checker|::Checker, current: u64 in Trapping, outer: u64 in Trapping, depth: u64 in Trapping) -> bool {
        let place: Place = place_at(checker, current - 1);
        transition place.kind == PlaceKind::Field || place.kind == PlaceKind::Length || place.kind == PlaceKind::Referent {
            true -> step(checker, place.parent, outer, depth + 1),
            _ -> no()
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// The value of a name: the place of a local, parameter or binder. A name
// binding a state, machine or data declaration is no place.
public machine name_value(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    handle: u64 in Trapping,
    type_handle: u64 in Trapping
) -> |evaluation|::Value
crashes Trap
{
    let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, handle);
    transition binding {
        |symbol_resolved_trees|::ValueBinding::Constant { constant } -> constant_value(syntax, typing, constant, type_handle),
        |symbol_resolved_trees|::ValueBinding::Local { statement } -> rooted(checker, typing, PlaceKind::Local, statement, type_handle),
        |symbol_resolved_trees|::ValueBinding::Parameter { parameter as selected_parameter } -> parameter(checker, typing, selected_parameter, type_handle),
        |symbol_resolved_trees|::ValueBinding::PatternBinder { field } -> rooted(checker, typing, PlaceKind::Binder, field, type_handle),
        |symbol_resolved_trees|::ValueBinding::MatchedSubject { subject as saved } -> matched(checker, saved),
        |symbol_resolved_trees|::ValueBinding::Field { field } -> field_name(checker, typing, field, type_handle),
        |symbol_resolved_trees|::ValueBinding::ReturnedValue { machine } -> returned(checker),
        |symbol_resolved_trees|::ValueBinding::ContractReturnedValue { contract as _ } -> returned(checker),
        |symbol_resolved_trees|::ValueBinding::DomainSubject { domain } -> subject(checker),
        _ -> unbounded()
    }

    machine matched(checker: @|checker|::Checker, saved: u64 in Trapping) -> |evaluation|::Value {
        transition checker.bound_subject == saved + 1 {
            true -> checker.bound_value,
            _ -> expression_subject(checker, saved)
        }
    }
    machine expression_subject(checker: @|checker|::Checker, saved: u64 in Trapping) -> |evaluation|::Value {
        transition saved >= checker.tree_low && saved - checker.tree_low < checker.tree_size {
            true -> frozen(checker, checker.tree_base + (saved - checker.tree_low)),
            _ -> unbounded()
        }
    }
    machine frozen(checker: @|checker|::Checker, index: u64 in Trapping) -> |evaluation|::Value {
        transition index < 4096 {
            true -> bounds(checker, index),
            _ -> unbounded()
        }
    }
    machine bounds(checker: @|checker|::Checker, index: u64 in Trapping) -> |evaluation|::Value
    requires index < 4096
    {
        |evaluation|::value_interval(checker.values[index as -Trapping])
    }

    machine constant_value(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, constant: u64 in Trapping, type_handle: u64 in Trapping) -> |evaluation|::Value {
        let value: |evaluation|::Value = checker_constant_value(syntax, typing, constant, type_handle);
        value
    }

    // A domain predicate's subject binder: the value it is decided for.
    machine subject(checker: @|checker|::Checker) -> |evaluation|::Value {
        transition checker.subjecting {
            true -> subject_value(checker),
            _ -> unbounded()
        }
    }

    machine subject_value(checker: @|checker|::Checker) -> |evaluation|::Value {
        let value: |evaluation|::Value = checker.subject;
        value
    }

    // An `ensures` fact's `result`: the returned value it is decided for.
    machine returned(checker: @|checker|::Checker) -> |evaluation|::Value {
        transition checker.returning {
            true -> returned_value(checker),
            _ -> unbounded()
        }
    }

    machine returned_value(checker: @|checker|::Checker) -> |evaluation|::Value {
        let value: |evaluation|::Value = checker.returned;
        value
    }

    // A `requires` fact's field name: the value a construction writes there
    // while its facts are decided, else the field of `fields_parent` while
    // that value's domain is installed.
    machine field_name(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, field: u64 in Trapping, type_handle: u64 in Trapping) -> |evaluation|::Value {
        transition checker.field_values && field >= checker.field_first {
            true -> written(checker, field - checker.field_first),
            _ -> installed(checker, typing, field, type_handle)
        }
    }

    // A construction's fact: the value written to the field.
    machine written(checker: @|checker|::Checker, offset: u64 in Trapping) -> |evaluation|::Value {
        let value: |evaluation|::Value = |contracts|::argument_value(checker, offset);
        value
    }

    machine installed(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, field: u64 in Trapping, type_handle: u64 in Trapping) -> |evaluation|::Value {
        let fields_parent: u64 in Trapping = checker.fields_parent;
        transition fields_parent > 0 {
            true -> member(checker, typing, field, fields_parent, type_handle),
            _ -> unbounded()
        }
    }

    machine member(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, field: u64 in Trapping, parent: u64 in Trapping, type_handle: u64 in Trapping) -> |evaluation|::Value {
        let place: u64 in Trapping = checker_place(checker, typing, PlaceKind::Field, field, parent, type_handle);
        let value: |evaluation|::Value = |references|::reference_value(checker, typing, place);
        value
    }

    // While a target's `requires` or `ensures` facts are decided, its
    // parameters stand for the call's arguments.
    machine parameter(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, parameter: u64 in Trapping, type_handle: u64 in Trapping) -> |evaluation|::Value {
        let substituted: bool = checker.substituting
            && parameter >= checker.argument_first
            && parameter - checker.argument_first < checker.argument_count;
        let argument_first: u64 in Trapping = checker.argument_first;
        transition substituted {
            true -> argument(checker, typing, parameter - argument_first, type_handle),
            _ -> rooted(checker, typing, PlaceKind::Parameter, parameter, type_handle)
        }
    }

    // The argument slot holds what was passed; a reference parameter stands
    // for that argument's referent, as reading the parameter does, so a
    // fact about `index` with `index: @mutable u64` binds to the lent storage.
    machine argument(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, offset: u64 in Trapping, type_handle: u64 in Trapping) -> |evaluation|::Value {
        let value: |evaluation|::Value = |contracts|::argument_value(checker, offset);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
        transition row.kind == |typed_trees|::TypeKind::Reference && value.place > 0 {
            true -> referent(checker, typing, value.place),
            _ -> passed(value)
        }
    }

    machine referent(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, place: u64 in Trapping) -> |evaluation|::Value {
        let value: |evaluation|::Value = |references|::reference_value(checker, typing, place);
        value
    }

    machine passed(value: |evaluation|::Value) -> |evaluation|::Value {
        value
    }

    machine rooted(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, kind: PlaceKind, binding: u64 in Trapping, type_handle: u64 in Trapping) -> |evaluation|::Value {
        let place: u64 in Trapping = checker_place(checker, typing, kind, binding, 0 as +Trapping, type_handle);
        let value: |evaluation|::Value = |references|::reference_value(checker, typing, place);
        value
    }

    machine unbounded() -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        value
    }
}

// A constant's value: exact when its initializer is an anonymous integer
// tree landed at its fixed-integer type, else its type's range.
public machine checker_constant_value(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, constant: u64 in Trapping, type_handle: u64 in Trapping) -> |evaluation|::Value
crashes Trap
{
    let declaration: |syntax_trees|::ConstantItem = |syntax_trees|::constant_item(syntax, constant);
    let adaptation: |typed_trees|::Adaptation = |typed_trees|::typing_adaptation(typing, declaration.value);
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
    let integer: bool = row.kind == |typed_trees|::TypeKind::Builtin && |integers|::is_carrier(row.builtin);
    transition adaptation == |typed_trees|::Adaptation::Landed && integer {
        true -> exact(typing, declaration),
        _ -> typed(row)
    }

    machine exact(typing: @|typed_trees|::Typing, declaration: |syntax_trees|::ConstantItem) -> |evaluation|::Value {
        let landed: |integers|::ExactInteger = |typed_trees|::typing_value(typing, declaration.value);
        let value: |evaluation|::Value = |evaluation|::value_constant(landed);
        value
    }

    machine typed(row: |typed_trees|::TypeRow) -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_typed(row);
        value
    }
}

// The value of `.field` or `.length`: a place below its operand's place, or,
// for a value that is no place (a call's result), its type's range. An
// array's length is its type's.
public machine member_value(
    checker: @mutable |checker|::Checker,
    typing: @|typed_trees|::Typing,
    handle: u64 in Trapping,
    expression: |syntax_trees|::Expression,
    type_handle: u64 in Trapping
) -> |evaluation|::Value
crashes Trap
{
    let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, handle);
    let base: |evaluation|::Value = |evaluation|::value_at(checker, expression.left);
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
    transition selection {
        |typed_trees|::Selection::Field { field } -> member(checker, typing, PlaceKind::Field, field, base.place, type_handle, row),
        |typed_trees|::Selection::Length -> length(checker, typing, expression, base.place, type_handle, row),
        _ -> unbounded()
    }

    // Qualification never changes a fixed array's declaration-owned extent.
    machine length(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, parent: u64 in Trapping, type_handle: u64 in Trapping, row: |typed_trees|::TypeRow) -> |evaluation|::Value {
        let collection: |typed_trees|::TypeRow = |obligations|::collection_row(typing, expression.left);
        transition collection.kind == |typed_trees|::TypeKind::Array {
            true -> fixed(typing, collection),
            _ -> member(checker, typing, PlaceKind::Length, 0 as +Trapping, parent, type_handle, row)
        }
    }

    machine fixed(typing: @|typed_trees|::Typing, collection: |typed_trees|::TypeRow) -> |evaluation|::Value {
        let extent: |evaluation|::Value = |obligations|::array_extent(typing, collection);
        extent
    }

    machine member(
        checker: @mutable |checker|::Checker,
        typing: @|typed_trees|::Typing,
        kind: PlaceKind,
        binding: u64 in Trapping,
        parent: u64 in Trapping,
        type_handle: u64 in Trapping,
        row: |typed_trees|::TypeRow
    ) -> |evaluation|::Value {
        transition parent > 0 {
            true -> projected(checker, typing, kind, binding, parent, type_handle),
            _ -> carried(row)
        }
    }

    machine projected(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, kind: PlaceKind, binding: u64 in Trapping, parent: u64 in Trapping, type_handle: u64 in Trapping) -> |evaluation|::Value {
        let place: u64 in Trapping = checker_place(checker, typing, kind, binding, parent, type_handle);
        let value: |evaluation|::Value = |references|::reference_value(checker, typing, place);
        value
    }

    machine carried(row: |typed_trees|::TypeRow) -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_typed(row);
        value
    }

    machine unbounded() -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        value
    }
}

// A place's value: its subject's term and interval, or the place alone.
public machine place_value(checker: @|checker|::Checker, place: u64 in Trapping) -> |evaluation|::Value
crashes Trap
{
    transition place > 0 {
        true -> entered(checker, place),
        _ -> unbounded()
    }

    machine entered(checker: @|checker|::Checker, place: u64 in Trapping) -> |evaluation|::Value {
        let entry: Place = place_at(checker, place - 1);
        transition entry.subject > 0 {
            true -> term(checker, place, entry.subject),
            _ -> located(place)
        }
    }

    machine term(checker: @|checker|::Checker, place: u64 in Trapping, subject: u64 in Trapping) -> |evaluation|::Value {
        let zero: |integers|::ExactInteger = |integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping };
        let value: |evaluation|::Value = |evaluation|::term_value(checker, place, subject, zero);
        value
    }

    machine located(place: u64 in Trapping) -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::at_place(place);
        value
    }

    machine unbounded() -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        value
    }
}

// The place (one-based) whose subject is `subject`; zero when none is.
public machine subject_place(checker: @|checker|::Checker, subject: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition subject > 0 {
        true -> next(checker, subject, 0 as +Trapping),
        _ -> absent()
    }

    machine next(checker: @|checker|::Checker, subject: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        transition index < checker.place_count {
            true -> candidate(checker, subject, index),
            _ -> absent()
        }
    }

    machine candidate(checker: @|checker|::Checker, subject: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        let place: Place = place_at(checker, index);
        transition place.subject == subject {
            true -> found(index + 1),
            _ -> next(checker, subject, index + 1)
        }
    }

    machine found(place: u64 in Trapping) -> u64 in Trapping {
        place
    }

    machine absent() -> u64 in Trapping {
        0 as +Trapping
    }
}
// A record bound from another place takes that place's known paths: each
// subject place within `source` by at most four field or `.length` steps
// (arrivals.omg) equals the same path below `target` from here on, and
// each field pending below `source` is pending below `target` too. A
// slice bound from a view thus keeps the view's length.
public machine copy_fields(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping)
crashes Trap
{
    |constructions|::copy_pending(checker, typing, target, source);
    let end: u64 in Trapping = checker.place_count as +Trapping;
    transition target > 0 && source > 0 && target != source {
        true -> next(checker, typing, target, source, 0 as +Trapping, end),
        _ -> done()
    }

    // Places the copy enters lie past `end`.
    machine next(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping) {
        transition index < end && index < 256 {
            true -> candidate(checker, typing, target, source, index, end),
            _ -> done()
        }
    }

    machine candidate(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping) {
        let entry: Place = place_at(checker, index);
        let path: |arrivals|::ArrivalPath = |arrivals|::path_below(checker, source, index + 1, 0 as +Trapping);
        let owned: bool = |reference_origins|::owned_below(checker, typing, source, index + 1);
        transition path.depth > 0 && owned {
            true -> typed(checker, typing, target, source, index, end, entry, path),
            _ -> next(checker, typing, target, source, index + 1, end)
        }
    }

    machine typed(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, entry: Place, path: |arrivals|::ArrivalPath) {
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, entry.type_handle);
        transition row.kind == |typed_trees|::TypeKind::Reference {
            true -> reference(checker, typing, target, source, index, end, path),
            false -> scalar(checker, typing, target, source, index, end, entry, path)
        }
    }

    machine reference(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, path: |arrivals|::ArrivalPath) {
        let copy: u64 in Trapping = |arrivals|::enter_path(checker, typing, target, path);
        |reference_origins|::copy_reference_origin(checker, typing, copy, index + 1);
        transition { _ -> next(checker, typing, target, source, index + 1, end) }
    }

    machine scalar(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, entry: Place, path: |arrivals|::ArrivalPath) {
        transition entry.subject > 0 {
            true -> copied(checker, typing, target, source, index, end, entry.subject, path),
            false -> next(checker, typing, target, source, index + 1, end)
        }
    }

    machine copied(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, subject: u64 in Trapping, path: |arrivals|::ArrivalPath) {
        let copy: u64 in Trapping = |arrivals|::enter_path(checker, typing, target, path);
        transition copy > 0 {
            true -> equated(checker, typing, target, source, index, end, subject, copy),
            _ -> done()
        }
    }

    // copy - source <= 0 and source - copy <= 0.
    machine equated(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, subject: u64 in Trapping, copy: u64 in Trapping) {
        let copied: Place = place_at(checker, copy - 1);
        let zero: |integers|::ExactInteger = |integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping };
        let unknown: |evaluation|::Value = |evaluation|::value_unknown();
        let original: |evaluation|::Value = |evaluation|::Value { place: 0 as +Trapping, known: true, subject: subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        let duplicate: |evaluation|::Value = |evaluation|::Value { place: 0 as +Trapping, known: true, subject: copied.subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        transition copied.subject > 0 {
            true -> related(checker, typing, target, source, index, end, original, duplicate),
            _ -> next(checker, typing, target, source, index + 1, end)
        }
    }

    machine related(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, target: u64 in Trapping, source: u64 in Trapping, index: u64 in Trapping, end: u64 in Trapping, original: |evaluation|::Value, duplicate: |evaluation|::Value) {
        let zero: |integers|::ExactInteger = |integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping };
        |facts|::constrain_difference(checker, original, duplicate, zero);
        |facts|::constrain_difference(checker, duplicate, original, zero);
        transition { _ -> next(checker, typing, target, source, index + 1, end) }
    }

    machine done() {}
}

// Rank snapshots are mathematical subjects. Their exact captured facts supply
// their range; importing a fixed carrier range could make a signed endpoint
// contradictory and incorrectly erase a feasible obligation.
machine enter_place_range(checker: @mutable |checker|::Checker, kind: PlaceKind, subject: u64 in Trapping, carrier: |symbol_resolved_trees|::BuiltinType)
crashes Trap
{
    transition kind == PlaceKind::RankEntry { true -> {}, false -> ranged(checker, subject, carrier) }
    machine ranged(checker: @mutable |checker|::Checker, subject: u64 in Trapping, carrier: |symbol_resolved_trees|::BuiltinType) { enter_range(checker, subject, carrier); }
}
