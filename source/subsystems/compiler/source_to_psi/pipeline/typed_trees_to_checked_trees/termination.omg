use pipeline/typed_trees_to_checked_trees/fact_values.omg;
use pipeline/typed_trees_to_checked_trees/flow.omg;
use pipeline/typed_trees_to_checked_trees/obligations.omg;
use pipeline/typed_trees_to_checked_trees/references.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/contracts.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;
use pipeline/typed_trees_to_checked_trees/invocations.omg;
use pipeline/typed_trees_to_checked_trees/places.omg;

use foundation/integers.omg;
use representations/checks/checks.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Termination is a property of the exact global invocation component. Lexical
// parents scope declarations and never supply a hidden witness or parameter
// correspondence. Each occurrence compares the source's immutable own-entry
// rank with the target's own witness over already-evaluated actual arguments.
// The shared graph certifies every cycle after all feasible observations.

// A machine's termination clause: whether it promises termination, and
// whether a `terminates by` witness ranks it, with that clause's handle.
// `promise` is the clause that promises (a bare `terminates;`, or the
// `satisfies` clause inheriting one), `handle` the witness clause.
public data TerminationClause [copy] {
    promised: bool;
    promise: u64 in Trapping;
    ranked: bool;
    handle: u64 in Trapping;
}

public machine checker_termination_clause(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, item: |syntax_trees|::MachineItem) -> TerminationClause
crashes Trap
{
    let none: TerminationClause = TerminationClause { promised: false, promise: 0 as +Trapping, ranked: false, handle: 0 as +Trapping };
    transition { _ -> next(syntax, resolution, item, 0 as +Trapping, none) }

    machine next(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, found: TerminationClause) -> TerminationClause {
        transition offset < item.clause_count {
            true -> clause(syntax, resolution, item, offset, found),
            _ -> finished(found)
        }
    }

    machine clause(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, found: TerminationClause) -> TerminationClause {
        let handle: u64 in Trapping = item.first_clause + offset;
        let written: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, handle);
        transition written.kind {
            |syntax_trees|::ClauseKind::Terminates -> terminates(syntax, resolution, item, offset, found, handle, written.argument_count > 0),
            |syntax_trees|::ClauseKind::Satisfies -> satisfies(syntax, resolution, item, offset, found, handle),
            _ -> next(syntax, resolution, item, offset + 1, found)
        }
    }

    machine terminates(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, found: TerminationClause, handle: u64 in Trapping, ranked: bool) -> TerminationClause {
        let witnessed: TerminationClause = TerminationClause { promised: found.promised, promise: found.promise, ranked: true, handle: handle };
        let promising: TerminationClause = TerminationClause { promised: true, promise: handle, ranked: found.ranked, handle: found.handle };
        transition ranked {
            true -> next(syntax, resolution, item, offset + 1, witnessed),
            _ -> next(syntax, resolution, item, offset + 1, promising)
        }
    }

    machine satisfies(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, item: |syntax_trees|::MachineItem, offset: u64 in Trapping, found: TerminationClause, handle: u64 in Trapping) -> TerminationClause {
        let requirement: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::name_resolution_requirement(resolution, handle);
        let inherited: bool = requirement_promises(syntax, requirement);
        let promising: TerminationClause = TerminationClause { promised: true, promise: handle, ranked: found.ranked, handle: found.handle };
        transition inherited && !found.promised {
            true -> next(syntax, resolution, item, offset + 1, promising),
            _ -> next(syntax, resolution, item, offset + 1, found)
        }
    }

    machine finished(found: TerminationClause) -> TerminationClause {
        found
    }
}

// Whether a satisfied requirement promises termination with a bare
// `terminates;`.
machine requirement_promises(syntax: @|syntax_trees|::SyntaxTrees, requirement: |symbol_resolved_trees|::ValueBinding) -> bool
crashes Trap
{
    transition requirement {
        |symbol_resolved_trees|::ValueBinding::Machine { handle } -> declared(syntax, handle),
        _ -> no()
    }

    machine declared(syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) -> bool {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, handle);
        transition { _ -> next(syntax, item, 0 as +Trapping) }
    }

    machine next(syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem, offset: u64 in Trapping) -> bool {
        transition offset < item.clause_count {
            true -> clause(syntax, item, offset),
            _ -> no()
        }
    }

    machine clause(syntax: @|syntax_trees|::SyntaxTrees, item: |syntax_trees|::MachineItem, offset: u64 in Trapping) -> bool {
        let written: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, item.first_clause + offset);
        transition written.kind == |syntax_trees|::ClauseKind::Terminates && written.argument_count == 0 {
            true -> yes(),
            _ -> next(syntax, item, offset + 1)
        }
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// Forget a machine's local graph summary before checking starts.
public machine reset_termination(checker: @mutable |checker|::Checker, machine: u64 in Trapping) {
    transition machine < 10240 {
        true -> write(checker, machine),
        _ -> done()
    }

    machine write(checker: @mutable |checker|::Checker, callee: u64 in Trapping)
    requires callee < 10240
    {
        checker.binder_calls[callee as -Trapping] = false;
        checker.terminating[callee as -Trapping] = false;
    }

    machine done() {}
}

// The body being checked calls a machine binder.
public machine record_binder_call(checker: @mutable |checker|::Checker)
crashes Trap
{
    let machine: u64 in Trapping = checker.machine;
    transition machine < 10240 {
        true -> write(checker, machine),
        _ -> done()
    }

    machine write(checker: @mutable |checker|::Checker, callee: u64 in Trapping)
    requires callee < 10240
    {
        checker.binder_calls[callee as -Trapping] = true;
    }

    machine done() {}
}

// Whether machine `machine` settled as terminating, and whether its own
// graph is acyclic or ranked.
public machine settled_termination(checker: @|checker|::Checker, machine: u64 in Trapping) -> bool {
    transition machine < 10240 {
        true -> read(checker, machine),
        _ -> no()
    }

    machine read(checker: @|checker|::Checker, callee: u64 in Trapping) -> bool
    requires callee < 10240
    {
        checker.terminating[callee as -Trapping]
    }

    machine no() -> bool {
        false
    }
}

// At a machine's entry, a ranked witness with a rank range owes that the
// rank its view produces from the entry parameters lies within the range
// (wiki/spec/language/termination.md#ranking), under the entry's facts.
// The rank range's endpoints as values in the current capture, with each
// entry parameter standing for its slot: `first` the lower, `second` the
// upper endpoint.
public machine rank_bounds(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, clause: |syntax_trees|::Clause) -> RankBounds
crashes Trap
{
    let range: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, clause.range);
    let lower: |evaluation|::Value = substituted_value(checker, syntax, resolution, typing, item, range.left);
    let upper: |evaluation|::Value = substituted_value(checker, syntax, resolution, typing, item, range.right);
    RankBounds { first: lower, second: upper }
}

// Whether the rank a view produces lies within `bounds`: at least the
// lower endpoint, and at most an inclusive upper endpoint or below an
// exclusive one. A distance view (`Nat::BoundedDistance`,
// `Nat::IncreasingTo`) produces the saturating distance from its leading
// subject to its limit (wiki/spec/language/termination.md#ranking): never
// below 0, and never above the limit itself.
public machine rank_within(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, rank: RankBounds, bounds: RankBounds, clause: |syntax_trees|::Clause, view: |symbol_resolved_trees|::RankingView) -> bool
crashes Trap
{
    let range: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, clause.range);
    transition view {
        |symbol_resolved_trees|::RankingView::BoundedDistance -> distance(checker, rank, bounds, range),
        |symbol_resolved_trees|::RankingView::IncreasingTo -> distance(checker, rank, bounds, range),
        _ -> produced(checker, rank.first, bounds, range)
    }

    machine distance(checker: @|checker|::Checker, rank: RankBounds, bounds: RankBounds, range: |syntax_trees|::Expression) -> bool {
        let produced_rank: |evaluation|::Value = |evaluation|::value_difference(rank.second, rank.first);
        let zero: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping });
        let floor: bool = |evaluation|::proves_at_most(checker, bounds.first, zero)
            || |evaluation|::proves_at_most(checker, bounds.first, produced_rank);
        let at_most: bool = |evaluation|::proves_at_most(checker, produced_rank, bounds.second)
            || |evaluation|::proves_at_most(checker, rank.second, bounds.second);
        let below: bool = |evaluation|::proves_less(checker, produced_rank, bounds.second)
            || |evaluation|::proves_less(checker, rank.second, bounds.second);
        let ceiling: bool = (range.flag && at_most) || (!range.flag && below);
        floor && ceiling
    }

    machine produced(checker: @|checker|::Checker, produced_rank: |evaluation|::Value, bounds: RankBounds, range: |syntax_trees|::Expression) -> bool {
        let floor: bool = |evaluation|::proves_at_most(checker, bounds.first, produced_rank);
        let below: bool = |evaluation|::proves_less(checker, produced_rank, bounds.second);
        let at_most: bool = |evaluation|::proves_at_most(checker, produced_rank, bounds.second);
        let ceiling: bool = (range.flag && at_most) || (!range.flag && below);
        floor && ceiling
    }
}

// A witness's view with its default elaborated by its subject's carrier:
// one unsigned integer descends and one slice ranks by its length. Two or
// more subjects form a tuple, which is not a carrier and declares no
// default (termination.md, "Ranking"), so the author names the view.
// `Default` stays for a witness none of these fit.
public machine elaborated_view(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, termination: TerminationClause) -> |symbol_resolved_trees|::RankingView
crashes Trap
{
    let view: |symbol_resolved_trees|::RankingView = |symbol_resolved_trees|::ranking_view(resolution, termination.handle);
    transition view {
        |symbol_resolved_trees|::RankingView::Default -> defaulted(syntax, typing, termination),
        _ -> chosen(view)
    }

    machine defaulted(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, termination: TerminationClause) -> |symbol_resolved_trees|::RankingView {
        let written: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, termination.handle);
        let root: u64 in Trapping = |syntax_trees|::syntax_trees_argument(syntax, written.first_argument);
        let row: |typed_trees|::TypeRow = |obligations|::collection_row(typing, root);
        let natural: bool = natural_row(row);
        transition written.argument_count {
            1 -> single(natural, row.kind == |typed_trees|::TypeKind::Slice),
            _ -> chosen(|symbol_resolved_trees|::RankingView::Default)
        }
    }

    machine single(natural: bool, sliced: bool) -> |symbol_resolved_trees|::RankingView {
        transition natural {
            true -> chosen(|symbol_resolved_trees|::RankingView::Descending),
            _ -> slice(sliced)
        }
    }

    machine slice(sliced: bool) -> |symbol_resolved_trees|::RankingView {
        transition sliced {
            true -> chosen(|symbol_resolved_trees|::RankingView::SliceLength),
            _ -> chosen(|symbol_resolved_trees|::RankingView::Default)
        }
    }

    machine chosen(view: |symbol_resolved_trees|::RankingView) -> |symbol_resolved_trees|::RankingView {
        view
    }
}

// Whether a type row is an unsigned fixed-width integer, whose values are
// naturals.
public machine natural_row(row: |typed_trees|::TypeRow) -> bool {
    transition row.kind == |typed_trees|::TypeKind::Builtin && |integers|::is_carrier(row.builtin) {
        true -> carrier(row.builtin),
        _ -> no()
    }

    machine carrier(builtin: |symbol_resolved_trees|::BuiltinType) -> bool {
        let least: |integers|::ExactInteger = |integers|::minimum(builtin);
        !least.negative
    }

    machine no() -> bool {
        false
    }
}

// Fill the argument slots from this declaration's exact own parameters.
public machine capture_source(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, item: |syntax_trees|::MachineItem)
crashes Trap
{
    checker.argument_count = item.parameter_count;
    transition { _ -> entry(checker, item, 0 as +Trapping) }

    machine entry(checker: @mutable |checker|::Checker, item: |syntax_trees|::MachineItem, offset: u64 in Trapping) {
        transition offset < item.parameter_count && offset < 64 {
            true -> own(checker, item, offset),
            _ -> done()
        }
    }

    machine own(checker: @mutable |checker|::Checker, item: |syntax_trees|::MachineItem, offset: u64 in Trapping) {
        let place: u64 in Trapping = |places|::find_place(checker, |places|::PlaceKind::Parameter, item.first_parameter + offset, 0 as +Trapping);
        let value: |evaluation|::Value = |places|::place_value(checker, place);
        |contracts|::set_argument(checker, offset, value);
        transition { _ -> entry(checker, item, offset + 1) }
    }

    machine done() {}
}

// The value of witness tree `root` with each of the machine's entry
// parameters standing for its argument slot, evaluated in its own frame as
// a fact is; unknown when too deep to evaluate.
public machine substituted_value(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, item: |syntax_trees|::MachineItem, root: u64 in Trapping) -> |evaluation|::Value
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    let low: u64 in Trapping = tree.first_row;
    let size: u64 in Trapping = root - low + 1;
    let base: u64 in Trapping = |flow|::next_base(checker);
    transition base + size <= 4096 && checker.frame_count < 8 {
        true -> framed(checker, syntax, resolution, typing, item, root, low, size, base),
        _ -> unknown()
    }

    machine framed(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        item: |syntax_trees|::MachineItem,
        root: u64 in Trapping,
        low: u64 in Trapping,
        size: u64 in Trapping,
        base: u64 in Trapping
    ) -> |evaluation|::Value {
        let substituting: bool = checker.substituting;
        let first: u64 in Trapping = checker.argument_first;
        let count: u64 in Trapping = checker.argument_count;
        |flow|::checker_push_frame(checker);
        checker.tree_base = base;
        checker.tree_low = low;
        checker.tree_size = size;
        checker.context_first = checker.context_count;
        checker.substituting = true;
        checker.argument_first = item.first_parameter;
        checker.argument_count = item.parameter_count;
        |fact_values|::evaluate_fact_run(checker, syntax, resolution, typing, root, low);
        let value: |evaluation|::Value = |evaluation|::value_at(checker, root);
        checker.substituting = substituting;
        checker.argument_first = first;
        checker.argument_count = count;
        |flow|::checker_pop_frame(checker);
        value
    }

    machine unknown() -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        value
    }
}

// The value of a declared measure's body with `subject` standing for its
// one parameter, evaluated in its own frame as a witness is; unknown when
// the body is not one expression or too deep to evaluate.
public machine measured_value(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, measure: |syntax_trees|::MachineItem, subject: |evaluation|::Value) -> |evaluation|::Value
crashes Trap
{
    let body: |syntax_trees|::Statement = |syntax_trees|::syntax_trees_statement(syntax, measure.first_statement);
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, body.value);
    let low: u64 in Trapping = tree.first_row;
    let size: u64 in Trapping = body.value - low + 1;
    let base: u64 in Trapping = |flow|::next_base(checker);
    let shaped: bool = measure.statement_count == 1 && body.has_value;
    transition shaped && base + size <= 4096 && checker.frame_count < 8 {
        true -> framed(checker, syntax, resolution, typing, measure, subject, body.value, low, size, base),
        _ -> unknown()
    }

    machine framed(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        measure: |syntax_trees|::MachineItem,
        subject: |evaluation|::Value,
        root: u64 in Trapping,
        low: u64 in Trapping,
        size: u64 in Trapping,
        base: u64 in Trapping
    ) -> |evaluation|::Value {
        let substituting: bool = checker.substituting;
        let first: u64 in Trapping = checker.argument_first;
        let count: u64 in Trapping = checker.argument_count;
        let saved: |evaluation|::Value = checker.arguments[0];
        let exact: bool = checker.exact_body;
        |flow|::checker_push_frame(checker);
        checker.tree_base = base;
        checker.tree_low = low;
        checker.tree_size = size;
        checker.context_first = checker.context_count;
        checker.substituting = true;
        checker.argument_first = measure.first_parameter;
        checker.argument_count = 1 as +Trapping;
        // The body computes a rank over naturals: its arithmetic is exact
        // here as in its own check (arithmetic.omg).
        checker.exact_body = true;
        |contracts|::set_argument(checker, 0 as +Trapping, subject);
        |fact_values|::evaluate_fact_run(checker, syntax, resolution, typing, root, low);
        let value: |evaluation|::Value = |evaluation|::value_at(checker, root);
        |contracts|::set_argument(checker, 0 as +Trapping, saved);
        checker.exact_body = exact;
        checker.substituting = substituting;
        checker.argument_first = first;
        checker.argument_count = count;
        |flow|::checker_pop_frame(checker);
        value
    }

    machine unknown() -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        value
    }
}

// A lexicographic measure's `offset`-th component of `subject`: the value
// at the subject's field the component names (resolution's
// `component_fields`); unknown for a subject without a place.
public machine component_value(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    measure: |syntax_trees|::MachineItem,
    subject: |evaluation|::Value,
    offset: u64 in Trapping
) -> |evaluation|::Value
crashes Trap
{
    let bound: u64 in Trapping = |symbol_resolved_trees|::component_field(resolution, measure.first_component + offset);
    transition offset < measure.component_count && bound > 0 && subject.place > 0 {
        true -> projected(checker, syntax, typing, subject, bound - 1),
        _ -> unknown()
    }

    machine projected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, subject: |evaluation|::Value, field: u64 in Trapping) -> |evaluation|::Value {
        let declared: |syntax_trees|::DataField = |syntax_trees|::syntax_trees_field(syntax, field);
        let type_handle: u64 in Trapping = |typed_trees|::reference_type(typing, declared.type_reference);
        let place: u64 in Trapping = |places|::checker_place(checker, typing, |places|::PlaceKind::Field, field, subject.place, type_handle);
        let value: |evaluation|::Value = |references|::reference_value(checker, typing, place);
        value
    }

    machine unknown() -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        value
    }
}


// A scalar rank range has exactly two endpoints; it is not the witness roster.
public data RankBounds [copy] { first: |evaluation|::Value; second: |evaluation|::Value; }

// The condensation graph's postorder completes dependencies before callers.
// All declarations of one component settle together; a recursive callee never
// borrows a speculative per-machine termination row from an earlier DFS visit.
public machine settle_termination(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution)
crashes Trap
{
    let certified: bool = |invocations|::certify_ranking(@mutable checker.invocations);
    transition { _ -> clear(checker, syntax, resolution, 0 as +Trapping, certified) }
    machine clear(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, certified: bool) {
        transition index < checker.invocations.node_count && index < 10240 {
            true -> cleared(checker, syntax, resolution, index, certified),
            false -> ordered(checker, syntax, resolution, 0 as +Trapping)
        }
    }
    machine cleared(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, certified: bool)
    requires index < 10240
    {
        checker.components_done[index as -Trapping] = false;
        checker.rank_reported[index as -Trapping] = false;
        checker.terminating[index as -Trapping] = false;
        transition { _ -> clear(checker, syntax, resolution, index + 1, certified) }
    }
    machine ordered(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping) {
        transition offset < checker.invocations.order_count && offset < 10240 {
            true -> node(checker, syntax, resolution, offset),
            false -> validate(checker, syntax, resolution, 0 as +Trapping)
        }
    }
    machine node(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping)
    requires offset < 10240
    {
        let node: u64 in Trapping = checker.invocations.order[offset as -Trapping] as +Trapping;
        let current_component: u64 in Trapping = |invocations|::invocation_graph_component(@checker.invocations, node);
        transition current_component > 0 && current_component <= 10240 {
            true -> component(checker, syntax, resolution, offset, current_component - 1),
            false -> ordered(checker, syntax, resolution, offset + 1)
        }
    }
    machine component(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, index: u64 in Trapping)
    requires index < 10240
    {
        transition checker.components_done[index as -Trapping] {
            true -> ordered(checker, syntax, resolution, offset + 1),
            false -> start(checker, syntax, resolution, offset, index)
        }
    }
    machine start(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, index: u64 in Trapping)
    requires index < 10240
    {
        let first: u64 in Trapping = checker.invocations.component_first[index as -Trapping] as +Trapping;
        let ranked: bool = checker.invocations.complete && checker.invocations.component_ranked[index as -Trapping];
        transition { _ -> member(checker, syntax, resolution, offset, index, first, ranked) }
    }
    machine member(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, handle: u64 in Trapping, ready: bool) {
        transition handle > 0 && handle <= 10240 {
            true -> declaration(checker, syntax, resolution, offset, component, handle - 1, ready),
            false -> publish_start(checker, syntax, resolution, offset, component, ready)
        }
    }
    machine declaration(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, node: u64 in Trapping, ready: bool)
    requires node < 10240
    {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, node);
        let termination: TerminationClause = checker_termination_clause(syntax, resolution, item);
        let complete: bool = ready && (item.has_body || termination.promised);
        let first: u64 in Trapping = checker.invocations.first[node as -Trapping] as +Trapping;
        transition { _ -> edge(checker, syntax, resolution, offset, component, node, first, complete) }
    }
    machine edge(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, node: u64 in Trapping, handle: u64 in Trapping, ready: bool) {
        transition handle > 0 && handle <= checker.invocations.edge_count && handle <= 32768 {
            true -> selected(checker, syntax, resolution, offset, component, node, handle - 1, ready),
            false -> next_member(checker, syntax, resolution, offset, component, node, ready)
        }
    }
    machine selected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, node: u64 in Trapping, index: u64 in Trapping, ready: bool)
    requires index < 32768
    {
        let selected: |invocations|::InvocationEdge = checker.invocations.edges[index as -Trapping];
        transition selected.target {
            |invocations|::InvocationTarget::Machine { machine } -> concrete(checker, syntax, resolution, offset, component, node, selected.next, machine, ready),
            |invocations|::InvocationTarget::Binder { parameter } -> binder(checker, syntax, resolution, offset, component, node, selected.next, parameter, ready)
        }
    }
    machine concrete(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, node: u64 in Trapping, next: u64 in Trapping, target: u64 in Trapping, ready: bool) {
        transition target < 10240 {
            true -> dependency(checker, syntax, resolution, offset, component, node, next, target, ready),
            false -> edge(checker, syntax, resolution, offset, component, node, next, false)
        }
    }
    machine dependency(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, node: u64 in Trapping, next: u64 in Trapping, target: u64 in Trapping, ready: bool)
    requires target < 10240
    {
        let target_component: u64 in Trapping = |invocations|::invocation_graph_component(@checker.invocations, target);
        let complete: bool = ready && (target_component == component + 1 || checker.terminating[target as -Trapping]);
        transition { _ -> edge(checker, syntax, resolution, offset, component, node, next, complete) }
    }
    machine binder(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, node: u64 in Trapping, next: u64 in Trapping, parameter: u64 in Trapping, ready: bool) {
        let promised: bool = binder_terminates(syntax, resolution, parameter);
        transition { _ -> edge(checker, syntax, resolution, offset, component, node, next, ready && promised) }
    }
    machine next_member(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, node: u64 in Trapping, ready: bool) {
        transition node < 10240 {
            true -> linked(checker, syntax, resolution, offset, component, node, ready),
            false -> publish_start(checker, syntax, resolution, offset, component, false)
        }
    }
    machine linked(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, node: u64 in Trapping, ready: bool)
    requires node < 10240
    {
        let next: u64 in Trapping = checker.invocations.component_next[node as -Trapping] as +Trapping;
        transition { _ -> member(checker, syntax, resolution, offset, component, next, ready) }
    }
    machine publish_start(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, ready: bool) {
        transition component < 10240 {
            true -> completed(checker, syntax, resolution, offset, component, ready),
            false -> ordered(checker, syntax, resolution, offset + 1)
        }
    }
    machine completed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, component: u64 in Trapping, ready: bool)
    requires component < 10240
    {
        checker.components_done[component as -Trapping] = true;
        let first: u64 in Trapping = checker.invocations.component_first[component as -Trapping] as +Trapping;
        transition { _ -> publish(checker, syntax, resolution, offset, first, ready) }
    }
    machine publish(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, handle: u64 in Trapping, ready: bool) {
        transition handle > 0 && handle <= 10240 {
            true -> published(checker, syntax, resolution, offset, handle - 1, ready),
            false -> ordered(checker, syntax, resolution, offset + 1)
        }
    }
    machine published(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, offset: u64 in Trapping, node: u64 in Trapping, ready: bool)
    requires node < 10240
    {
        checker.terminating[node as -Trapping] = ready;
        let next: u64 in Trapping = checker.invocations.component_next[node as -Trapping] as +Trapping;
        transition { _ -> publish(checker, syntax, resolution, offset, next, ready) }
    }
    machine validate(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping) {
        transition index < checker.invocations.edge_count && index < 32768 {
            true -> validate_edge(checker, syntax, resolution, index),
            false -> {}
        }
    }
    machine validate_edge(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping)
    requires index < 32768
    {
        let edge: |invocations|::InvocationEdge = checker.invocations.edges[index as -Trapping];
        validate_rank_component(checker, syntax, resolution, edge);
        transition { _ -> validate(checker, syntax, resolution, index + 1) }
    }
}

public machine binder_terminates(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, parameter: u64 in Trapping) -> bool
crashes Trap
{
    let clauses: |contracts|::CallClauses = |contracts|::call_clauses(syntax, resolution, |typed_trees|::Selection::Binder { parameter: parameter });
    transition { _ -> next(syntax, clauses.first_clause, clauses.first_clause + clauses.clause_count) }
    machine next(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping) -> bool {
        transition index < end { true -> clause(syntax, index, end), false -> false }
    }
    machine clause(syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, end: u64 in Trapping) -> bool {
        let clause: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, index);
        transition clause.kind == |syntax_trees|::ClauseKind::Terminates && clause.argument_count == 0 {
            true -> true,
            false -> next(syntax, index + 1, end)
        }
    }
}

machine validate_rank_component(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, edge: |invocations|::InvocationEdge)
crashes Trap
{
    transition edge.target {
        |invocations|::InvocationTarget::Machine { machine } -> concrete(checker, syntax, resolution, edge, machine),
        _ -> {}
    }
    machine concrete(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, edge: |invocations|::InvocationEdge, target: u64 in Trapping) {
        let component: u64 in Trapping = |invocations|::invocation_graph_component(@checker.invocations, edge.owner);
        let destination: u64 in Trapping = |invocations|::invocation_graph_component(@checker.invocations, target);
        transition component > 0 && component == destination && component <= 10240 {
            true -> internal(checker, syntax, resolution, edge, component - 1),
            false -> {}
        }
    }
    machine internal(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, edge: |invocations|::InvocationEdge, component: u64 in Trapping)
    requires component < 10240
    {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, edge.owner);
        let termination: TerminationClause = checker_termination_clause(syntax, resolution, item);
        transition termination.ranked && !checker.invocations.component_ranked[component as -Trapping] {
            true -> unproven(checker, syntax, edge),
            false -> {}
        }
    }
    machine unproven(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, edge: |invocations|::InvocationEdge) {
        transition edge.owner < 10240 { true -> first(checker, syntax, edge, edge.owner), false -> {} }
    }
    machine first(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, edge: |invocations|::InvocationEdge, owner: u64 in Trapping)
    requires owner < 10240
    {
        transition checker.rank_reported[owner as -Trapping] { true -> {}, false -> reported(checker, syntax, edge, owner) }
    }
    machine reported(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, edge: |invocations|::InvocationEdge, owner: u64 in Trapping)
    requires owner < 10240
    {
        checker.rank_reported[owner as -Trapping] = true;
        |checks|::open_machine(@mutable checker.output);
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, edge.expression);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::RankUnproven, expression.source_span);
    }
}
