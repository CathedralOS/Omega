use pipeline/typed_trees_to_checked_trees/arithmetic.omg;
use pipeline/typed_trees_to_checked_trees/completions.omg;
use pipeline/typed_trees_to_checked_trees/constructions.omg;
use pipeline/typed_trees_to_checked_trees/domains.omg;
use pipeline/typed_trees_to_checked_trees/flow.omg;
use pipeline/typed_trees_to_checked_trees/matches.omg;
use pipeline/typed_trees_to_checked_trees/qualification.omg;
use pipeline/typed_trees_to_checked_trees/ranking.omg;
use pipeline/typed_trees_to_checked_trees/recasts.omg;
use pipeline/typed_trees_to_checked_trees/reference_backings.omg;
use pipeline/typed_trees_to_checked_trees/references.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/contracts.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;
use pipeline/typed_trees_to_checked_trees/places.omg;

use foundation/integers.omg;
use representations/checks/checks.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Each expression node's value, from its children's, and its definedness
// obligations: a place's subject, a literal's constant, an index inside its
// collection (wiki/spec/language/numeric_values.md#collection-bounds),
// fixed-integer operators and conversions (arithmetic.omg), and a call's
// `requires` facts, effects and `ensures` facts. Values only gather facts
// while `checking` is false; obligations reject only when it holds, after
// the body's facts have settled.
public machine evaluate_node(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    handle: u64 in Trapping,
    checking: bool
)
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
    let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
    let integer: bool = row.kind == |typed_trees|::TypeKind::Builtin && |integers|::is_carrier(row.builtin);
    let landed: bool = |typed_trees|::typing_landed_integer(typing, handle, expression);
    transition landed {
        true -> literal(checker, typing, handle),
        _ -> form(checker, syntax, resolution, typing, handle, checking, expression, type_handle, row, integer)
    }

    machine form(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, checking: bool, expression: |syntax_trees|::Expression, type_handle: u64 in Trapping, row: |typed_trees|::TypeRow, integer: bool) {
        transition expression.kind {
            |syntax_trees|::ExpressionKind::Name -> name(checker, syntax, resolution, typing, handle, type_handle),
            |syntax_trees|::ExpressionKind::Integer -> literal(checker, typing, handle),
            |syntax_trees|::ExpressionKind::Boolean -> boolean(checker, handle, expression),
            |syntax_trees|::ExpressionKind::Field -> field(checker, typing, handle, expression, type_handle),
            |syntax_trees|::ExpressionKind::Index -> index(checker, syntax, typing, handle, expression, row, checking),
            |syntax_trees|::ExpressionKind::Unary -> unary(checker, handle, expression, row, integer, checking),
            |syntax_trees|::ExpressionKind::Binary -> binary(checker, syntax, resolution, typing, handle, expression, row, integer, checking),
            |syntax_trees|::ExpressionKind::Cast -> qualified_cast(checker, syntax, resolution, typing, handle, expression, type_handle, row, integer, checking),
            |syntax_trees|::ExpressionKind::Call -> call(checker, syntax, resolution, typing, handle, expression, row, checking),
            |syntax_trees|::ExpressionKind::Construct -> construct(checker, syntax, resolution, typing, handle, expression, type_handle, row, checking),
            |syntax_trees|::ExpressionKind::Path -> path(checker, syntax, resolution, typing, handle, expression, type_handle, row, checking),
            |syntax_trees|::ExpressionKind::Match -> matched(checker, syntax, resolution, typing, handle, checking),
            |syntax_trees|::ExpressionKind::Array -> array_literal(checker, syntax, resolution, typing, handle, expression, row, checking),
            _ -> typed(checker, handle, row)
        }
    }

    // An array literal's elements meet its element type's qualification.
    machine array_literal(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        row: |typed_trees|::TypeRow,
        checking: bool
    ) {
        transition checking {
            true -> array_element(checker, syntax, resolution, typing, handle, expression, row, 0 as +Trapping),
            _ -> typed(checker, handle, row)
        }
    }

    machine array_element(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        row: |typed_trees|::TypeRow,
        offset: u64 in Trapping
    ) {
        transition offset < expression.count {
            true -> element_qualified(checker, syntax, resolution, typing, handle, expression, row, offset),
            _ -> typed(checker, handle, row)
        }
    }

    machine element_qualified(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        row: |typed_trees|::TypeRow,
        offset: u64 in Trapping
    ) {
        let element: u64 in Trapping = |syntax_trees|::syntax_trees_argument(syntax, expression.first + offset);
        let value: |evaluation|::Value = |evaluation|::value_at(checker, element);
        let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, element);
        |qualification|::require_qualification(checker, syntax, resolution, typing, row.inner, element, value, written.source_span);
        transition { _ -> array_element(checker, syntax, resolution, typing, handle, expression, row, offset + 1) }
    }

    machine matched(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, checking: bool) {
        |matches|::close_match(checker, syntax, resolution, typing, handle, checking);
    }

    machine name(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, type_handle: u64 in Trapping) {
        let value: |evaluation|::Value = |places|::name_value(checker, syntax, resolution, typing, handle, type_handle);
        let read: |evaluation|::Value = |evaluation|::read_interval(typing, type_handle, value);
        |evaluation|::checker_set_value(checker, handle, read);
    }

    machine literal(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping) {
        let literal: |integers|::ExactInteger = |typed_trees|::typing_value(typing, handle);
        let value: |evaluation|::Value = |evaluation|::value_constant(literal);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    machine boolean(checker: @mutable |checker|::Checker, handle: u64 in Trapping, expression: |syntax_trees|::Expression) {
        let value: |evaluation|::Value = |evaluation|::value_truth(expression.flag);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    machine field(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, type_handle: u64 in Trapping) {
        let value: |evaluation|::Value = |places|::member_value(checker, typing, handle, expression, type_handle);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    // `collection[index]`: the index lies in `0..len`.
    machine index(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) {
        let base: |evaluation|::Value = |evaluation|::value_at(checker, expression.left);
        let collection: |typed_trees|::TypeRow = collection_row(typing, expression.left);
        let length: |evaluation|::Value = collection_length(checker, typing, collection, base);
        let operand: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, expression.right);
        transition operand.kind == |syntax_trees|::ExpressionKind::Range {
            true -> sliced(checker, typing, handle, expression, operand, row, length, base, checking),
            _ -> element(checker, handle, expression, row, length, checking)
        }
    }

    machine element(checker: @mutable |checker|::Checker, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, length: |evaluation|::Value, checking: bool) {
        let position: |evaluation|::Value = |evaluation|::value_at(checker, expression.right);
        let below: bool = |evaluation|::proves_less(checker, position, length);
        let zero: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping });
        let above: bool = |evaluation|::proves_at_most(checker, zero, position);
        transition checking && !(below && above) {
            true -> out_of_bounds(checker, handle, expression, row),
            _ -> typed(checker, handle, row)
        }
    }

    // A range slice stays within its collection
    // (wiki/spec/language/expressions.md, Indexing and ranges): its start,
    // zero when omitted, is at most its exclusive end, which is at most the
    // length; an omitted end is the length, and an inclusive end `b` is the
    // exclusive end `b + 1`, valid when `b` is a valid index: neither
    // negative nor past the last element.
    machine sliced(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, operand: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, length: |evaluation|::Value, base: |evaluation|::Value, checking: bool) {
        let zero: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping });
        let one: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: 1 as +Wrapping });
        let start: |evaluation|::Value = range_endpoint(checker, operand.first == 1, operand.left, zero);
        let end: |evaluation|::Value = range_endpoint(checker, operand.count == 1, operand.right, length);
        let interval: |evaluation|::Value = |evaluation|::value_sum(end, one);
        let successor: |evaluation|::Value = |evaluation|::offset_sum(end, one, interval);
        let inclusive: bool = operand.flag && operand.count == 1;
        let within: bool = |evaluation|::proves_at_most(checker, end, length);
        let index_valid: bool = |evaluation|::proves_less(checker, end, length);
        let ordered: bool = |evaluation|::proves_at_most(checker, start, end);
        let ordered_inclusive: bool = |evaluation|::proves_at_most(checker, start, successor);
        let nonnegative: bool = |evaluation|::proves_at_most(checker, zero, start);
        let end_index: bool = |evaluation|::proves_at_most(checker, zero, end) && index_valid;
        let valid: bool = nonnegative && ((inclusive && end_index && ordered_inclusive) || (!inclusive && within && ordered));
        let bound: |evaluation|::Value = checker_range_end(end, successor, inclusive);
        transition checking && !valid {
            true -> out_of_bounds(checker, handle, expression, row),
            _ -> range_viewed(checker, typing, handle, row, base, start, bound)
        }
    }

    // A range slice of a placed collection is a view: a place of its own
    // below the collection, whose live length is the range's extent
    // (wiki/spec/terminal-psi/byte_views.md). A write through it forgets
    // the collection's contents (`Checker::forget_backing`).
    machine range_viewed(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, row: |typed_trees|::TypeRow, base: |evaluation|::Value, start: |evaluation|::Value, bound: |evaluation|::Value) {
        transition base.place > 0 {
            true -> view_place(checker, typing, handle, base.place, start, bound),
            _ -> typed(checker, handle, row)
        }
    }

    machine view_place(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, collection: u64 in Trapping, start: |evaluation|::Value, bound: |evaluation|::Value) {
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
        let view: u64 in Trapping = |places|::checker_place(checker, typing, |places|::PlaceKind::Referent, handle, collection, type_handle);
        let length_place: u64 in Trapping = |places|::checker_place(checker, typing, |places|::PlaceKind::Length, 0 as +Trapping, view, 0 as +Trapping);
        // Kept as a linear term when the start is a constant, so
        // `items[1..]` is one shorter than `items` in the zone.
        let interval: |evaluation|::Value = |evaluation|::value_difference(bound, start);
        let extent: |evaluation|::Value = |evaluation|::offset_difference(bound, start, interval);
        |flow|::bind_place(checker, typing, length_place, extent);
        let value: |evaluation|::Value = |evaluation|::at_place(view);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    machine out_of_bounds(checker: @mutable |checker|::Checker, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::IndexOutOfBounds, expression.source_span);
        transition { _ -> typed(checker, handle, row) }
    }

    // A borrow names its operand's place; a negation is arithmetic.
    machine unary(checker: @mutable |checker|::Checker, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, integer: bool, checking: bool) {
        transition expression.operator {
            |syntax_trees|::OperatorKind::Borrow -> borrowed(checker, handle, expression),
            |syntax_trees|::OperatorKind::BorrowMutable -> borrowed(checker, handle, expression),
            |syntax_trees|::OperatorKind::BorrowWrite -> borrowed(checker, handle, expression),
            |syntax_trees|::OperatorKind::Negate -> negated(checker, handle, expression, row, integer, checking),
            _ -> typed(checker, handle, row)
        }
    }

    machine borrowed(checker: @mutable |checker|::Checker, handle: u64 in Trapping, expression: |syntax_trees|::Expression) {
        let operand: |evaluation|::Value = |evaluation|::value_at(checker, expression.left);
        let value: |evaluation|::Value = |evaluation|::at_place(operand.place);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    machine negated(checker: @mutable |checker|::Checker, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, integer: bool, checking: bool) {
        transition integer {
            true -> negation(checker, handle, expression, row, checking),
            _ -> typed(checker, handle, row)
        }
    }

    machine negation(checker: @mutable |checker|::Checker, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) {
        let value: |evaluation|::Value = |arithmetic|::negation_value(checker, expression, row, checking);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    // Comparisons and Boolean operators carry no obligation, and float
    // arithmetic follows its format's rules, outside this slice.
    // An operator typing selected a machine for is a call of that machine
    // with its operands as arguments; any other is builtin.
    machine binary(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        row: |typed_trees|::TypeRow,
        integer: bool,
        checking: bool
    ) {
        let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, handle);
        let selected: bool = selects_machine(selection);
        transition selected {
            true -> call(checker, syntax, resolution, typing, handle, expression, row, checking),
            _ -> builtin(checker, handle, expression, row, integer, checking)
        }
    }

    machine builtin(checker: @mutable |checker|::Checker, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, integer: bool, checking: bool) {
        transition integer {
            true -> arithmetic(checker, handle, expression, row, checking),
            _ -> typed(checker, handle, row)
        }
    }

    machine arithmetic(checker: @mutable |checker|::Checker, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) {
        let value: |evaluation|::Value = |arithmetic|::binary_value(checker, expression, row, checking);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    // A cast to a type a declared domain qualifies proves its predicates of
    // the operand, whose denotation it keeps (qualification.omg).
    machine qualified_cast(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        type_handle: u64 in Trapping,
        row: |typed_trees|::TypeRow,
        integer: bool,
        checking: bool
    ) {
        transition checking {
            true -> cast_qualification(checker, syntax, resolution, typing, handle, expression, type_handle, row, integer),
            _ -> cast(checker, syntax, typing, handle, expression, row, integer, checking)
        }
    }

    machine cast_qualification(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        type_handle: u64 in Trapping,
        row: |typed_trees|::TypeRow,
        integer: bool
    ) {
        let operand: |evaluation|::Value = |evaluation|::value_at(checker, expression.left);
        |qualification|::require_qualification(checker, syntax, resolution, typing, type_handle, expression.left, operand, expression.source_span);
        transition { _ -> cast(checker, syntax, typing, handle, expression, row, integer, true) }
    }

    machine cast(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, integer: bool, checking: bool) {
        transition row.kind == |typed_trees|::TypeKind::Reference {
            true -> recast(checker, syntax, typing, handle, expression, row, checking),
            _ -> scalar_cast(checker, typing, handle, expression, row, integer, checking)
        }
    }

    // A recast borrows its operand's storage under another shape
    // (wiki/spec/layouts/recasts.md), so its value is that storage's place,
    // as a borrow's is. The storage keeps its facts under its own carrier;
    // a view of another carrier reads it as unknown and its writes forget
    // it (references.omg, flow.omg).
    machine recast(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) {
        |recasts|::check_recast(checker, syntax, typing, expression, row, checking);
        let operand: |evaluation|::Value = |evaluation|::value_at(checker, expression.left);
        let value: |evaluation|::Value = |evaluation|::at_place(operand.place);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    machine scalar_cast(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, integer: bool, checking: bool) {
        transition integer {
            true -> conversion(checker, typing, handle, expression, row, checking),
            _ -> typed(checker, handle, row)
        }
    }

    machine conversion(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) {
        let value: |evaluation|::Value = |arithmetic|::conversion_value(checker, typing, expression, row, checking);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    // In the checking walk a call is recorded for crash routes and its
    // callee's `requires` facts are owed as it is entered. A machine call
    // may change what its write frame says below its exclusive arguments
    // (frames.omg); a jump only transfers its arguments, whose facts its
    // state's arrival projects. Its result lies in its type's range, or,
    // when its callee `ensures` facts, is a place those facts describe. The fact-gathering walks may visit a body several
    // times; a replayed call keeps the result its evaluation gave.
    machine call(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) {
        transition checker.replay {
            true -> replayed(checker, typing, handle, row),
            _ -> entered(checker, syntax, resolution, typing, handle, expression, row, checking)
        }
    }

    machine replayed(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, row: |typed_trees|::TypeRow) {
        let place: u64 in Trapping = |places|::find_place(checker, |places|::PlaceKind::Call, handle, 0 as +Trapping);
        transition place > 0 {
            true -> placed(checker, typing, handle, place),
            _ -> typed(checker, handle, row)
        }
    }

    machine placed(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, place: u64 in Trapping) {
        let value: |evaluation|::Value = |references|::reference_value(checker, typing, place);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    machine entered(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) {
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, expression.left);
        transition binding {
            |symbol_resolved_trees|::ValueBinding::BytePredicate { predicate } -> predicated(checker, syntax, resolution, typing, handle, expression, predicate),
            _ -> selected(checker, syntax, resolution, typing, handle, expression, row, checking)
        }
    }

    // A primitive byte predicate's truth: of a quoted literal by its octets,
    // of a domain's subject under decision by the literal being qualified,
    // and of a value whose declared domain requires that predicate; unknown
    // otherwise.
    machine predicated(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, predicate: |symbol_resolved_trees|::BytePredicate) {
        let argument: u64 in Trapping = |syntax_trees|::syntax_trees_argument(syntax, expression.first);
        let truth: |evaluation|::Value = predicate_value(checker, syntax, resolution, typing, argument, predicate);
        |evaluation|::checker_set_value(checker, handle, truth);
    }

    machine selected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, checking: bool) {
        let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, handle);
        |completions|::observe_selected_invocation(checker, selection, handle);
        observe_invocation(checker, syntax, typing, selection, handle, checking);
        transition checking {
            true -> recorded(checker, syntax, resolution, typing, handle, expression, row),
            _ -> effects(checker, syntax, resolution, typing, handle, expression, row)
        }
    }

    machine recorded(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow) {
        let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, node);
        |checker|::record_call(checker, syntax, resolution, selection);
        |checker|::record_supply(checker, syntax, selection, node);
        |qualification|::require_call_qualifications(checker, syntax, resolution, typing, selection, expression);
        // Input formation and the target's own contract precede any use of
        // recursive comparison evidence. Ranking never establishes an input.
        require_callee_facts(checker, syntax, resolution, typing, selection, expression);
        |ranking|::require_invocation_descent(checker, syntax, resolution, typing, selection, node, expression);
        transition { _ -> effects(checker, syntax, resolution, typing, node, expression, row) }
    }

    machine effects(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow) {
        let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, node);
        let called: bool = selects_machine(selection);
        |reference_backings|::publish_reference_backings(checker, syntax, resolution, typing, node, expression);
        transition called {
            true -> released(checker, syntax, resolution, typing, node, expression, row),
            _ -> resulted(checker, syntax, typing, node, expression, row)
        }
    }

    // A returned reference is a place of its own, standing for its referent
    // (references.omg); any other result is known by its type.
    machine resulted(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow) {
        transition row.kind == |typed_trees|::TypeKind::Reference {
            true -> returned_view(checker, syntax, typing, node, expression, row),
            _ -> typed(checker, node, row)
        }
    }

    // An exclusive returned reference may reach any storage an exclusive
    // argument lent (wiki/spec/language/lifetimes.md#returned-views), and
    // a write through it is not a write the callee's frame records: what
    // those arguments reach is released whole before the view is formed.
    machine returned_view(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow) {
        transition row.access == |syntax_trees|::ReferenceAccess::Shared {
            true -> viewed(checker, typing, node),
            _ -> sourced_view(checker, syntax, typing, node, expression, row)
        }
    }

    // An exclusive view needs every exclusive source's storage known: a
    // write through a view of unknown storage stays refused, as a write
    // through that source would be, rather than gaining facts of its own.
    machine sourced_view(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow) {
        let placed: bool = exclusive_arguments_placed(checker, syntax, typing, expression, 0 as +Trapping);
        transition placed {
            true -> released_view(checker, syntax, typing, node, expression),
            _ -> typed(checker, node, row)
        }
    }

    machine released_view(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression) {
        |checker|::release_exclusive_arguments(checker, syntax, typing, expression, |typed_trees|::Selection::None);
        transition { _ -> viewed(checker, typing, node) }
    }

    // The call's value is what the returned reference denotes: a scalar
    // referent's own subject, or the call place standing for the referent,
    // so a local capturing it reads and writes that storage.
    machine viewed(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, node: u64 in Trapping) {
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, node);
        let place: u64 in Trapping = |places|::checker_place(checker, typing, |places|::PlaceKind::Call, node, 0 as +Trapping, type_handle);
        let referent: |evaluation|::Value = |references|::reference_value(checker, typing, place);
        |evaluation|::checker_set_value(checker, node, referent);
    }

    // A binder may be any machine meeting its contract: its exclusive
    // arguments are released before the same public postconditions used
    // for declared calls are instantiated on the completed result.
    machine released(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow) {
        let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, node);
        |checker|::release_exclusive_arguments(checker, syntax, typing, expression, selection);
        transition selection {
            |typed_trees|::Selection::Machine { handle } -> callee(checker, syntax, resolution, typing, node, expression, row, handle),
            _ -> contracted(checker, syntax, resolution, typing, node, expression, row, false)
        }
    }

    // Only a selected declaration has independently derived completion
    // evidence. Binder calls use their public contract, never a visible
    // current supplier body or the caller's particular instantiation.
    machine callee(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, machine: u64 in Trapping) {
        let completed: bool = |completions|::completed_numeric_result(checker, typing, node, machine, row);
        transition { _ -> contracted(checker, syntax, resolution, typing, node, expression, row, completed) }
    }

    machine contracted(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, completed: bool) {
        let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, node);
        let clauses: |contracts|::CallClauses = |contracts|::call_clauses(syntax, resolution, selection);
        let guarantees: bool = |contracts|::declares(syntax, clauses.first_clause, clauses.clause_count, |syntax_trees|::ClauseKind::Ensures);
        transition guarantees {
            true -> guaranteed(checker, syntax, resolution, typing, node, expression, clauses),
            _ -> completed_or_typed(checker, syntax, typing, node, expression, row, completed)
        }
    }

    machine completed_or_typed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, completed: bool) {
        transition completed { true -> {}, false -> resulted(checker, syntax, typing, node, expression, row) }
    }

    machine guaranteed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, node: u64 in Trapping, expression: |syntax_trees|::Expression, clauses: |contracts|::CallClauses) {
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, node);
        let place: u64 in Trapping = |places|::checker_place(checker, typing, |places|::PlaceKind::Call, node, 0 as +Trapping, type_handle);
        let value: |evaluation|::Value = |references|::reference_value(checker, typing, place);
        |evaluation|::checker_set_value(checker, node, value);
        |contracts|::assume_guarantees(checker, syntax, resolution, typing, clauses, expression, value);
    }

    // Establishing a value of data with `requires` facts owes them: a
    // construction over the values it writes, a payload-free case value
    // (`Type::Case`) over zero fields.
    machine construct(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, type_handle: u64 in Trapping, row: |typed_trees|::TypeRow, checking: bool) {
        let constrained: bool = |contracts|::checker_constrained(syntax, typing, type_handle);
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, expression.left);
        transition checking && constrained {
            true -> written(checker, syntax, resolution, typing, handle, expression, row, binding),
            _ -> composed(checker, syntax, resolution, typing, handle, expression, row)
        }
    }

    machine written(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, binding: |symbol_resolved_trees|::ValueBinding) {
        transition binding {
            |symbol_resolved_trees|::ValueBinding::Data { item } -> constructed(checker, syntax, resolution, typing, handle, expression, row, item, false, 0 as +Trapping, expression.first, expression.count),
            |symbol_resolved_trees|::ValueBinding::DataCase { item, data_case } -> constructed(checker, syntax, resolution, typing, handle, expression, row, item, true, data_case, expression.first, expression.count),
            _ -> composed(checker, syntax, resolution, typing, handle, expression, row)
        }
    }

    machine path(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, type_handle: u64 in Trapping, row: |typed_trees|::TypeRow, checking: bool) {
        let constrained: bool = |contracts|::checker_constrained(syntax, typing, type_handle);
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, handle);
        let constructing: bool = checking && constrained;
        transition binding {
            |symbol_resolved_trees|::ValueBinding::Constant { constant as selected_constant } -> constant(checker, syntax, typing, handle, selected_constant, type_handle),
            _ -> case_path(checker, syntax, resolution, typing, handle, expression, row, binding, constructing)
        }
    }

    machine case_path(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        row: |typed_trees|::TypeRow,
        binding: |symbol_resolved_trees|::ValueBinding,
        constructing: bool
    ) {
        transition constructing {
            true -> case_value(checker, syntax, resolution, typing, handle, expression, row, binding),
            _ -> typed(checker, handle, row)
        }
    }

    machine case_value(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow, binding: |symbol_resolved_trees|::ValueBinding) {
        transition binding {
            |symbol_resolved_trees|::ValueBinding::DataCase { item, data_case } -> constructed(checker, syntax, resolution, typing, handle, expression, row, item, true, data_case, 0 as +Trapping, 0 as +Trapping),
            _ -> typed(checker, handle, row)
        }
    }

    machine constant(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, handle: u64 in Trapping, constant: u64 in Trapping, type_handle: u64 in Trapping) {
        let value: |evaluation|::Value = |places|::checker_constant_value(syntax, typing, constant, type_handle);
        |evaluation|::checker_set_value(checker, handle, value);
    }

    machine constructed(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        handle: u64 in Trapping,
        expression: |syntax_trees|::Expression,
        row: |typed_trees|::TypeRow,
        item: u64 in Trapping,
        has_case: bool,
        data_case: u64 in Trapping,
        first: u64 in Trapping,
        count: u64 in Trapping
    ) {
        let held: bool = |domains|::construction_holds(checker, syntax, resolution, typing, item, has_case, data_case, first, count);
        transition held {
            true -> composed(checker, syntax, resolution, typing, handle, expression, row),
            _ -> unproven_domain(checker, syntax, resolution, typing, handle, expression, row)
        }
    }

    machine unproven_domain(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::DomainUnproven, expression.source_span);
        transition { _ -> composed(checker, syntax, resolution, typing, handle, expression, row) }
    }

    // A construction's value: its own place, the fields it writes pending
    // below it.
    machine composed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression, row: |typed_trees|::TypeRow) {
        |constructions|::construction_value(checker, syntax, resolution, typing, handle, expression, row);
    }

    // A value known only by its type: a fixed integer's carrier range.
    machine typed(checker: @mutable |checker|::Checker, handle: u64 in Trapping, row: |typed_trees|::TypeRow) {
        let value: |evaluation|::Value = |evaluation|::value_typed(row);
        |evaluation|::checker_set_value(checker, handle, value);
    }
}

// A range endpoint's value when it is written, else `omitted`'s.
// A range's exclusive end: the written end, or its successor when the
// range is inclusive.
machine checker_range_end(end: |evaluation|::Value, successor: |evaluation|::Value, inclusive: bool) -> |evaluation|::Value {
    transition inclusive {
        true -> answer(successor),
        _ -> answer(end)
    }

    machine answer(bound: |evaluation|::Value) -> |evaluation|::Value {
        bound
    }
}

machine range_endpoint(checker: @|checker|::Checker, written: bool, handle: u64 in Trapping, omitted: |evaluation|::Value) -> |evaluation|::Value
crashes Trap
{
    transition written {
        true -> read(checker, handle),
        _ -> absent(omitted)
    }

    machine read(checker: @|checker|::Checker, handle: u64 in Trapping) -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_at(checker, handle);
        value
    }

    machine absent(omitted: |evaluation|::Value) -> |evaluation|::Value {
        omitted
    }
}

// A callee's `requires` facts must hold at the call; a machine binder's
// call owes its `requires machine` contract's.
machine require_callee_facts(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, selection: |typed_trees|::Selection, expression: |syntax_trees|::Expression)
crashes Trap
{
    let clauses: |contracts|::CallClauses = |contracts|::call_clauses(syntax, resolution, selection);
    transition clauses.clause_count > 0 {
        true -> owed(checker, syntax, resolution, typing, clauses, expression),
        _ -> done()
    }

    machine owed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, clauses: |contracts|::CallClauses, expression: |syntax_trees|::Expression) {
        let held: bool = |contracts|::decide_call_facts(checker, syntax, resolution, typing, clauses, expression, |syntax_trees|::ClauseKind::Requires, true);
        transition held {
            true -> done(),
            _ -> unproven(checker, expression)
        }
    }

    machine unproven(checker: @mutable |checker|::Checker, expression: |syntax_trees|::Expression) {
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::RequirementUnproven, expression.source_span);
    }

    machine done() {}
}

// The collection type an index or `.length` applies to, through references.
public machine collection_row(typing: @|typed_trees|::Typing, handle: u64 in Trapping) -> |typed_trees|::TypeRow
crashes Trap
{
    let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
    let row: |typed_trees|::TypeRow = referent_row(typing, type_handle);
    row
}

// A type's row through any references.
public machine referent_row(typing: @|typed_trees|::Typing, type_handle: u64 in Trapping) -> |typed_trees|::TypeRow
crashes Trap
{
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
    transition { _ -> through(typing, row, 0 as +Trapping) }

    machine through(typing: @|typed_trees|::Typing, row: |typed_trees|::TypeRow, depth: u64 in Trapping) -> |typed_trees|::TypeRow {
        transition row.kind == |typed_trees|::TypeKind::Reference && depth < 16 {
            true -> referent(typing, row.inner, depth),
            _ -> found(row)
        }
    }

    machine referent(typing: @|typed_trees|::Typing, inner: u64 in Trapping, depth: u64 in Trapping) -> |typed_trees|::TypeRow {
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, inner);
        transition { _ -> through(typing, row, depth + 1) }
    }

    machine found(row: |typed_trees|::TypeRow) -> |typed_trees|::TypeRow {
        row
    }
}

// An array's extent: its static integer, or for a `const` generic extent
// any `u64`, since one body serves every specialization.
// Whether every exclusive reference argument of a call has known storage
// (`Checker::storage_origin`), from operand `offset` on.
public machine exclusive_arguments_placed(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, offset: u64 in Trapping) -> bool
crashes Trap
{
    let count: u64 in Trapping = operand_count(expression);
    transition offset < count {
        true -> operand(checker, syntax, typing, expression, offset, count),
        _ -> answer(true)
    }

    machine operand(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, offset: u64 in Trapping, count: u64 in Trapping) -> bool {
        let handle: u64 in Trapping = checker_operand(syntax, expression, offset);
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
        let exclusive: bool = row.kind == |typed_trees|::TypeKind::Reference && row.access != |syntax_trees|::ReferenceAccess::Shared;
        let origin: u64 in Trapping = |references|::storage_origin(checker, syntax, typing, handle);
        transition exclusive && origin == 0 {
            true -> answer(false),
            _ -> next(checker, syntax, typing, expression, offset, count)
        }
    }

    machine next(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, offset: u64 in Trapping, count: u64 in Trapping) -> bool {
        transition offset + 1 < count {
            true -> operand(checker, syntax, typing, expression, offset + 1, count),
            _ -> answer(true)
        }
    }

    machine answer(placed: bool) -> bool {
        placed
    }
}

// The truth of primitive byte predicate `predicate` of `argument`.
public machine predicate_value(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, argument: u64 in Trapping, predicate: |symbol_resolved_trees|::BytePredicate) -> |evaluation|::Value
crashes Trap
{
    let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, argument);
    let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, argument);
    let bit: u64 in Trapping = roster_bit(predicate);
    transition written.kind == |syntax_trees|::ExpressionKind::String {
        true -> literal(typing, argument, bit),
        _ -> bound(checker, syntax, resolution, typing, argument, binding, bit, predicate)
    }

    machine literal(typing: @|typed_trees|::Typing, argument: u64 in Trapping, bit: u64 in Trapping) -> |evaluation|::Value {
        let roster: u64 in Trapping = |typed_trees|::typing_roster(typing, argument);
        transition { _ -> truth((roster & bit) != 0) }
    }

    machine bound(checker: @|checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, argument: u64 in Trapping, binding: |symbol_resolved_trees|::ValueBinding, bit: u64 in Trapping, predicate: |symbol_resolved_trees|::BytePredicate) -> |evaluation|::Value {
        transition binding {
            |symbol_resolved_trees|::ValueBinding::DomainSubject { domain } -> subject(checker, bit),
            _ -> declared(syntax, resolution, typing, argument, predicate)
        }
    }

    machine subject(checker: @|checker|::Checker, bit: u64 in Trapping) -> |evaluation|::Value {
        let roster: u64 in Trapping = checker.subject_roster;
        transition checker.subject_literal {
            true -> truth((roster & bit) != 0),
            _ -> unknown()
        }
    }

    machine declared(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, argument: u64 in Trapping, predicate: |symbol_resolved_trees|::BytePredicate) -> |evaluation|::Value {
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, argument);
        let domain: u64 in Trapping = |qualification|::qualifying_domain(typing, type_handle);
        transition domain > 0 {
            true -> required(syntax, resolution, domain - 1, predicate),
            _ -> unknown()
        }
    }

    machine required(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, domain: u64 in Trapping, predicate: |symbol_resolved_trees|::BytePredicate) -> |evaluation|::Value {
        let declares: bool = domain_requires(syntax, resolution, domain, predicate);
        transition declares {
            true -> truth(true),
            _ -> unknown()
        }
    }

    machine truth(holds: bool) -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_truth(holds);
        value
    }

    machine unknown() -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_unknown();
        value
    }
}

// The roster bit of a primitive byte predicate.
machine roster_bit(predicate: |symbol_resolved_trees|::BytePredicate) -> u64 in Trapping {
    transition predicate {
        |symbol_resolved_trees|::BytePredicate::ValidUtf8 -> answer(1 as +Trapping),
        |symbol_resolved_trees|::BytePredicate::NoNul -> answer(2 as +Trapping),
        |symbol_resolved_trees|::BytePredicate::AsciiOnly -> answer(4 as +Trapping),
        |symbol_resolved_trees|::BytePredicate::NonEmpty -> answer(8 as +Trapping)
    }

    machine answer(bit: u64 in Trapping) -> u64 in Trapping {
        bit
    }
}

// Whether a declared domain's `requires` facts include primitive byte
// predicate `predicate` of the domain's subject.
machine domain_requires(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, domain: u64 in Trapping, predicate: |symbol_resolved_trees|::BytePredicate) -> bool
crashes Trap
{
    let item: |syntax_trees|::DomainItem = |syntax_trees|::syntax_trees_domain_item(syntax, domain);
    transition { _ -> next(syntax, resolution, item.first_clause, item.first_clause + item.clause_count, predicate) }

    machine next(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, predicate: |symbol_resolved_trees|::BytePredicate) -> bool {
        transition index < end {
            true -> clause(syntax, resolution, index, end, predicate),
            _ -> answer(false)
        }
    }

    machine clause(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, predicate: |symbol_resolved_trees|::BytePredicate) -> bool {
        let written: |syntax_trees|::Clause = |syntax_trees|::syntax_trees_clause(syntax, index);
        transition written.kind == |syntax_trees|::ClauseKind::Requires && written.has_expression {
            true -> fact(syntax, resolution, index, end, predicate, written.expression),
            _ -> next(syntax, resolution, index + 1, end, predicate)
        }
    }

    machine fact(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, predicate: |symbol_resolved_trees|::BytePredicate, fact_handle: u64 in Trapping) -> bool {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, fact_handle);
        transition expression.kind == |syntax_trees|::ExpressionKind::Call && expression.count == 1 {
            true -> callee(syntax, resolution, index, end, predicate, expression),
            _ -> next(syntax, resolution, index + 1, end, predicate)
        }
    }

    machine callee(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, wanted: |symbol_resolved_trees|::BytePredicate, expression: |syntax_trees|::Expression) -> bool {
        let binding: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, expression.left);
        let argument: u64 in Trapping = |syntax_trees|::syntax_trees_argument(syntax, expression.first);
        let subject: |symbol_resolved_trees|::ValueBinding = |symbol_resolved_trees|::value_binding(resolution, argument);
        transition binding {
            |symbol_resolved_trees|::ValueBinding::BytePredicate { predicate } -> named_predicate(syntax, resolution, index, end, wanted, predicate, subject),
            _ -> next(syntax, resolution, index + 1, end, wanted)
        }
    }

    machine named_predicate(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, predicate: |symbol_resolved_trees|::BytePredicate, named: |symbol_resolved_trees|::BytePredicate, subject: |symbol_resolved_trees|::ValueBinding) -> bool {
        transition subject {
            |symbol_resolved_trees|::ValueBinding::DomainSubject { domain } -> matched(syntax, resolution, index, end, predicate, named),
            _ -> next(syntax, resolution, index + 1, end, predicate)
        }
    }

    machine matched(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, index: u64 in Trapping, end: u64 in Trapping, predicate: |symbol_resolved_trees|::BytePredicate, named: |symbol_resolved_trees|::BytePredicate) -> bool {
        transition named == predicate {
            true -> answer(true),
            _ -> next(syntax, resolution, index + 1, end, predicate)
        }
    }

    machine answer(requires: bool) -> bool {
        requires
    }
}

public machine array_extent(typing: @|typed_trees|::Typing, collection: |typed_trees|::TypeRow) -> |evaluation|::Value
crashes Trap
{
    let extent: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, collection.length);
    transition extent.kind == |typed_trees|::TypeKind::StaticInteger {
        true -> fixed(extent.length),
        _ -> parametric()
    }

    machine fixed(length: u64 in Trapping) -> |evaluation|::Value {
        let magnitude: u64 in Wrapping = (length as -Trapping) as +Wrapping;
        let value: |evaluation|::Value = |evaluation|::value_constant(|integers|::ExactInteger { negative: false, magnitude: magnitude });
        value
    }

    machine parametric() -> |evaluation|::Value {
        let value: |evaluation|::Value = |evaluation|::value_carrier(|symbol_resolved_trees|::BuiltinType::U64);
        value
    }
}

// A collection's length: an array's from its type, a slice's from its place.
public machine collection_length(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, collection: |typed_trees|::TypeRow, base: |evaluation|::Value) -> |evaluation|::Value
crashes Trap
{
    transition collection.kind == |typed_trees|::TypeKind::Array {
        true -> fixed(typing, collection),
        _ -> sliced(checker, typing, base)
    }

    machine fixed(typing: @|typed_trees|::Typing, collection: |typed_trees|::TypeRow) -> |evaluation|::Value {
        let extent: |evaluation|::Value = array_extent(typing, collection);
        extent
    }

    // A slice indexes against its live length; fixed arrays use their extent.
    machine sliced(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, base: |evaluation|::Value) -> |evaluation|::Value {
        transition base.place > 0 {
            true -> counted(checker, typing, base.place),
            _ -> unknown()
        }
    }

    machine counted(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, parent: u64 in Trapping) -> |evaluation|::Value {
        let place: u64 in Trapping = |places|::checker_place(checker, typing, |places|::PlaceKind::Length, 0 as +Trapping, parent, 0 as +Trapping);
        let value: |evaluation|::Value = |places|::place_value(checker, place);
        value
    }

    machine unknown() -> |evaluation|::Value {
        let unknown: |evaluation|::Value = |evaluation|::value_unknown();
        unknown
    }
}

// Whether typing selected a machine, or a machine binder through its
// contract.
public machine selects_machine(selection: |typed_trees|::Selection) -> bool {
    transition selection {
        |typed_trees|::Selection::Machine { handle } -> yes(),
        |typed_trees|::Selection::Binder { parameter } -> yes(),
        _ -> no()
    }

    machine yes() -> bool {
        true
    }

    machine no() -> bool {
        false
    }
}

// How many operands a call-like expression passes: a call's arguments, or
// an operator's operands when typing selected a machine for it.
public machine operand_count(expression: |syntax_trees|::Expression) -> u64 in Trapping {
    transition expression.kind {
        |syntax_trees|::ExpressionKind::Binary -> two(),
        _ -> arguments(expression.count)
    }

    machine two() -> u64 in Trapping {
        2 as +Trapping
    }

    machine arguments(count: u64 in Trapping) -> u64 in Trapping {
        count
    }
}

// The handle of a call-like expression's operand `offset`: a call's
// argument, or an operator's left then right operand.
public machine checker_operand(syntax: @|syntax_trees|::SyntaxTrees, expression: |syntax_trees|::Expression, offset: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition expression.kind {
        |syntax_trees|::ExpressionKind::Binary -> sides(expression, offset),
        _ -> argument(syntax, expression, offset)
    }

    machine sides(expression: |syntax_trees|::Expression, offset: u64 in Trapping) -> u64 in Trapping {
        transition offset == 0 {
            true -> chosen(expression.left),
            _ -> chosen(expression.right)
        }
    }

    machine argument(syntax: @|syntax_trees|::SyntaxTrees, expression: |syntax_trees|::Expression, offset: u64 in Trapping) -> u64 in Trapping {
        let handle: u64 in Trapping = |syntax_trees|::syntax_trees_argument(syntax, expression.first + offset);
        handle
    }

    machine chosen(handle: u64 in Trapping) -> u64 in Trapping {
        handle
    }
}

machine observe_invocation(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, selection: |typed_trees|::Selection, call: u64 in Trapping, checking: bool)
crashes Trap
{
    transition !checking && !checker.replay {
        true -> selected(checker, syntax, typing, selection, call),
        false -> done()
    }
    machine selected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, selection: |typed_trees|::Selection, call: u64 in Trapping) {
        transition selection {
            |typed_trees|::Selection::Machine { handle } -> incoming(checker, syntax, typing, call, handle),
            _ -> done()
        }
    }
    machine incoming(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, call: u64 in Trapping, handle: u64 in Trapping) {
        let slot: u64 in Trapping = |checker|::body_slot(checker, handle);
        transition slot > 0 {
            true -> |checker|::contribute(checker, syntax, typing, call, handle),
            false -> done()
        }
    }
    machine done() {}
}
