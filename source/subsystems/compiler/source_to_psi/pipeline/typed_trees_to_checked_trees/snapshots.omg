use pipeline/typed_trees_to_checked_trees/aliases.omg;
use pipeline/typed_trees_to_checked_trees/facts.omg;
use pipeline/typed_trees_to_checked_trees/frames.omg;
use pipeline/typed_trees_to_checked_trees/obligations.omg;
use pipeline/typed_trees_to_checked_trees/zone.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;
use pipeline/typed_trees_to_checked_trees/flow.omg;
use pipeline/typed_trees_to_checked_trees/places.omg;

use foundation/integers.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Operands captured before a later operand writes what they read
// (wiki/spec/language/state_contracts.md#mutation-and-subject-identity:
// "Copies transport facts about the captured value, not source expressions
// to be reevaluated after mutation"). A call that may write a place it
// receives exclusively runs after the operands evaluated before it: its own
// and the earlier operands of every expression around it. Before the call
// forgets what is known of that place, each such operand whose value reads
// it moves to a snapshot keyed by the lending operand: an integer to a
// fresh subject equal to the one it read, a record to a place holding the
// fields known of it. Any other value keeps its interval and loses its
// place. A reference denotes live storage, not its former contents, and
// keeps its place; a Read adaptation instead consumes a scalar snapshot.
// Every exclusive operand the call writes through keeps its live place.

// A call's write footprint. Named frames apply to field identities along
// a scalar's path; whole/unknown frames apply to the entire referent.
public data WriteFootprint [copy] {
    place: u64 in Trapping;
    callee: u64 in Trapping;
    whole: bool;
}

// Whether a represented scalar lies under a written field. Aggregate
// operands are captured separately: their written fields can still be
// pending, or completely unrepresented until a later contract reads them.
machine written_subject(checker: @|checker|::Checker, subject: u64 in Trapping, write: WriteFootprint) -> bool
crashes Trap
{
    let inside: bool = |places|::checker_within(checker, subject, write.place);
    transition inside {
        true -> step(checker, subject, write),
        _ -> no()
    }

    machine step(checker: @|checker|::Checker, current: u64 in Trapping, write: WriteFootprint) -> bool {
        transition write.whole {
            true -> yes(),
            _ -> narrow(checker, current, write)
        }
    }

    machine narrow(checker: @|checker|::Checker, current: u64 in Trapping, write: WriteFootprint) -> bool {
        transition current > 0 && current != write.place {
            true -> inspect(checker, current, write),
            _ -> no()
        }
    }

    machine inspect(checker: @|checker|::Checker, current: u64 in Trapping, write: WriteFootprint) -> bool {
        let entry: |places|::Place = |places|::place_at(checker, current - 1);
        let written: bool = entry.kind == |places|::PlaceKind::Field && |frames|::writes_field(checker, write.callee, entry.handle);
        transition written {
            true -> yes(),
            _ -> step(checker, entry.parent, write)
        }
    }

    machine yes() -> bool { true }
    machine no() -> bool { false }
}

// Snapshot every operand evaluated before the call `expression` whose value
// reads the storage in `write`, lent exclusively by operand `lender`.
public machine snapshot_operands(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    typing: @|typed_trees|::Typing,
    expression: |syntax_trees|::Expression,
    lender: u64 in Trapping,
    write: WriteFootprint
)
crashes Trap
{
    transition { _ -> own(checker, syntax, typing, expression, lender, write, 0 as +Trapping) }

    machine own(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, lender: u64 in Trapping, write: WriteFootprint, offset: u64 in Trapping) {
        let count: u64 in Trapping = |obligations|::operand_count(expression);
        transition offset < count {
            true -> operand(checker, syntax, typing, expression, lender, write, offset),
            _ -> earlier(checker, syntax, typing, expression, lender, write)
        }
    }

    machine operand(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, lender: u64 in Trapping, write: WriteFootprint, offset: u64 in Trapping) {
        let handle: u64 in Trapping = |obligations|::checker_operand(syntax, expression, offset);
        snapshot_tree(checker, syntax, typing, handle, lender, write);
        transition { _ -> own(checker, syntax, typing, expression, lender, write, offset + 1) }
    }

    // The operands before the call's subtree that no node evaluated since
    // has taken: walking back, each is the root of the subtree that ends
    // just before the previous one starts.
    machine earlier(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, lender: u64 in Trapping, write: WriteFootprint) {
        transition expression.first_row > checker.tree_low {
            true -> pending(checker, syntax, typing, lender, write, expression.first_row - 1),
            _ -> done()
        }
    }

    machine pending(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, lender: u64 in Trapping, write: WriteFootprint, root: u64 in Trapping) {
        let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
        snapshot_tree(checker, syntax, typing, root, lender, write);
        transition tree.first_row > checker.tree_low {
            true -> pending(checker, syntax, typing, lender, write, tree.first_row - 1),
            _ -> done()
        }
    }

    machine done() {}
}

// Facts may later inspect a completed operand's children: assuming a
// comparison uses its two reads, even after the comparison itself became a
// Boolean. Capture every evaluated descendant, not just the operand root.
// The caller supplies completed subtrees only; later nodes have no values.
machine snapshot_tree(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, root: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint)
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    transition { _ -> node(checker, typing, root, lender, write, tree.first_row) }

    machine node(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, handle: u64 in Trapping) {
        transition handle <= root {
            true -> captured(checker, typing, root, lender, write, handle),
            _ -> done()
        }
    }

    machine captured(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, root: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, handle: u64 in Trapping) {
        snapshot_node(checker, typing, handle, lender, write);
        transition { _ -> node(checker, typing, root, lender, write, handle + 1) }
    }

    machine done() {}
}

// Capture one completed node before a write overlaps its value. Records
// retain the complete known/pending field tree even when the written field
// has no place yet. Scalar reads use the frame along their existing path;
// snapshotting a disjoint scalar on one short-circuit path loses its live
// equality at the join, despite the call preserving that scalar.
machine snapshot_node(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint)
crashes Trap
{
    let tree_low: u64 in Trapping = checker.tree_low;
    transition handle >= tree_low {
        true -> evaluated(checker, typing, handle, lender, write, handle - tree_low),
        _ -> done()
    }

    // Only a node of the open tree has a value.
    machine evaluated(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, offset: u64 in Trapping) {
        let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
        let adaptation: |typed_trees|::Adaptation = |typed_trees|::typing_adaptation(typing, handle);
        let read: bool = row.kind != |typed_trees|::TypeKind::Reference || adaptation == |typed_trees|::Adaptation::Read;
        transition offset < checker.tree_size && read {
            true -> valued(checker, typing, handle, lender, write, type_handle, row),
            _ -> done()
        }
    }

    machine valued(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, type_handle: u64 in Trapping, row: |typed_trees|::TypeRow) {
        let value: |evaluation|::Value = |evaluation|::value_at(checker, handle);
        transition value.known && value.subject > 0 {
            true -> term(checker, typing, handle, lender, write, value),
            _ -> placed(checker, typing, handle, lender, write, type_handle, row, value)
        }
    }

    machine term(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, value: |evaluation|::Value) {
        let owner: u64 in Trapping = |places|::subject_place(checker, value.subject);
        let reads: bool = owner > 0 && written_subject(checker, owner, write);
        transition reads {
            true -> integer(checker, typing, handle, lender, value, owner),
            _ -> done()
        }
    }

    machine integer(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, lender: u64 in Trapping, value: |evaluation|::Value, owner: u64 in Trapping) {
        // Capture the admitted value's scalar type, not the storage path's
        // metadata. Synthetic lengths have no source type handle; a read
        // adaptation also denotes the scalar value rather than a reference.
        let expression_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, handle);
        let read_type: u64 in Trapping = |evaluation|::checker_read_type(typing, expression_type);
        let snapshot: u64 in Trapping = |places|::checker_place(checker, typing, |places|::PlaceKind::Snapshot, lender, owner, read_type);
        transition snapshot > 0 {
            true -> numbered(checker, handle, value, snapshot),
            _ -> unplaced(checker, handle, value)
        }
    }

    machine numbered(checker: @mutable |checker|::Checker, handle: u64 in Trapping, value: |evaluation|::Value, snapshot: u64 in Trapping) {
        let entry: |places|::Place = |places|::place_at(checker, snapshot - 1);
        transition entry.subject > 0 {
            true -> captured(checker, handle, value, snapshot, entry.subject),
            _ -> unplaced(checker, handle, value)
        }
    }

    // The snapshot's subject equals the one read: captured - read <= 0 and
    // read - captured <= 0. Every operand reading that subject at this call
    // shares the snapshot.
    machine captured(checker: @mutable |checker|::Checker, handle: u64 in Trapping, value: |evaluation|::Value, snapshot: u64 in Trapping, subject: u64 in Trapping) {
        let zero: |integers|::ExactInteger = |integers|::ExactInteger { negative: false, magnitude: 0 as +Wrapping };
        let unknown: |evaluation|::Value = |evaluation|::value_unknown();
        let own: |evaluation|::Value = |evaluation|::Value { place: 0 as +Trapping, known: true, subject: subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        let read: |evaluation|::Value = |evaluation|::Value { place: 0 as +Trapping, known: true, subject: value.subject, offset: zero, ceiling: unknown.ceiling, floor: unknown.floor };
        |zone|::zone_forget(@mutable checker.zone, subject);
        |facts|::constrain_difference(checker, own, read, zero);
        |facts|::constrain_difference(checker, read, own, zero);
        let exact: bool = value.place > 0 && value.offset.magnitude == 0;
        transition exact {
            true -> moved(checker, handle, value, snapshot, subject),
            _ -> moved(checker, handle, value, 0 as +Trapping, subject)
        }
    }

    machine moved(checker: @mutable |checker|::Checker, handle: u64 in Trapping, value: |evaluation|::Value, snapshot: u64 in Trapping, subject: u64 in Trapping) {
        |evaluation|::checker_set_value(checker, handle, |evaluation|::Value { place: snapshot, known: true, subject: subject, offset: value.offset, ceiling: value.ceiling, floor: value.floor });
    }

    machine placed(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, lender: u64 in Trapping, write: WriteFootprint, type_handle: u64 in Trapping, row: |typed_trees|::TypeRow, value: |evaluation|::Value) {
        let reads: bool = value.place > 0 && (|places|::checker_within(checker, value.place, write.place) || |places|::checker_within(checker, write.place, value.place));
        transition reads {
            true -> shaped(checker, typing, handle, lender, type_handle, row, value),
            _ -> done()
        }
    }

    machine shaped(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, lender: u64 in Trapping, type_handle: u64 in Trapping, row: |typed_trees|::TypeRow, value: |evaluation|::Value) {
        transition row.kind == |typed_trees|::TypeKind::Data {
            true -> record(checker, typing, handle, lender, type_handle, value),
            _ -> unplaced(checker, handle, value)
        }
    }

    // A record's snapshot holds the fields known of what it read.
    machine record(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, lender: u64 in Trapping, type_handle: u64 in Trapping, value: |evaluation|::Value) {
        let snapshot: u64 in Trapping = |places|::checker_place(checker, typing, |places|::PlaceKind::Snapshot, lender, value.place, type_handle);
        transition snapshot > 0 {
            true -> fields(checker, typing, handle, value, snapshot),
            _ -> unplaced(checker, handle, value)
        }
    }

    machine fields(checker: @mutable |checker|::Checker, typing: @|typed_trees|::Typing, handle: u64 in Trapping, value: |evaluation|::Value, snapshot: u64 in Trapping) {
        |places|::forget_place(checker, typing, snapshot);
        |places|::copy_fields(checker, typing, snapshot, value.place);
        |evaluation|::checker_set_value(checker, handle, |evaluation|::Value { place: snapshot, known: value.known, subject: 0 as +Trapping, offset: value.offset, ceiling: value.ceiling, floor: value.floor });
    }

    machine unplaced(checker: @mutable |checker|::Checker, handle: u64 in Trapping, value: |evaluation|::Value) {
        |evaluation|::checker_set_value(checker, handle, |evaluation|::Value { place: 0 as +Trapping, known: false, subject: 0 as +Trapping, offset: value.offset, ceiling: value.ceiling, floor: value.floor });
    }

    machine done() {}
}

// Retain the evaluated dispatch subject before exploring either arm. Its
// scratch window is separate from later guards/targets; value facts use the
// same snapshots as call operands, so writes cannot reinterpret old reads.
// Snapshotting is performed once before the arm zone is saved.
public machine capture_subject(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, root: u64 in Trapping, present: bool) -> |flow|::CapturedSubject
crashes Trap
{
    let frame: |flow|::TreeFrame = |flow|::tree_frame(checker);
    let captured: |flow|::CapturedSubject = |flow|::CapturedSubject { frame: frame, floor: checker.retained_values };
    transition present && checker.output.machine_accepted {
        true -> retain(checker, syntax, typing, root, captured),
        _ -> done(captured)
    }

    machine retain(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, root: u64 in Trapping, captured: |flow|::CapturedSubject) -> |flow|::CapturedSubject {
        checker.retained_values = captured.frame.base + captured.frame.size;
        transition { _ -> node(checker, syntax, typing, root, captured, captured.frame.low) }
    }

    machine node(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, root: u64 in Trapping, captured: |flow|::CapturedSubject, handle: u64 in Trapping) -> |flow|::CapturedSubject {
        transition handle <= root {
            true -> valued(checker, syntax, typing, root, captured, handle),
            _ -> done(captured)
        }
    }

    machine valued(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, root: u64 in Trapping, captured: |flow|::CapturedSubject, handle: u64 in Trapping) -> |flow|::CapturedSubject {
        let value: |evaluation|::Value = |evaluation|::value_at(checker, handle);
        transition value.known && value.subject > 0 {
            true -> term(checker, syntax, typing, root, captured, handle, value),
            _ -> placed(checker, syntax, typing, root, captured, handle, value, value.place)
        }
    }

    machine term(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, root: u64 in Trapping, captured: |flow|::CapturedSubject, handle: u64 in Trapping, value: |evaluation|::Value) -> |flow|::CapturedSubject {
        let place: u64 in Trapping = |places|::subject_place(checker, value.subject);
        transition { _ -> placed(checker, syntax, typing, root, captured, handle, value, place) }
    }

    machine placed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, root: u64 in Trapping, captured: |flow|::CapturedSubject, handle: u64 in Trapping, value: |evaluation|::Value, place: u64 in Trapping) -> |flow|::CapturedSubject {
        transition place > 0 {
            true -> snapshotted(checker, syntax, typing, root, captured, handle, value, place),
            _ -> node(checker, syntax, typing, root, captured, handle + 1)
        }
    }

    machine snapshotted(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, root: u64 in Trapping, captured: |flow|::CapturedSubject, handle: u64 in Trapping, value: |evaluation|::Value, place: u64 in Trapping) -> |flow|::CapturedSubject {
        let write: WriteFootprint = WriteFootprint { place: place, callee: 0 as +Trapping, whole: true };
        snapshot_node(checker, typing, handle, root, write);
        let saved: |evaluation|::Value = |evaluation|::value_at(checker, handle);
        |aliases|::copy_alias(checker, value.place, saved.place);
        transition { _ -> node(checker, syntax, typing, root, captured, handle + 1) }
    }

    machine done(captured: |flow|::CapturedSubject) -> |flow|::CapturedSubject { captured }
}

// A store evaluates its RHS before replacing destination storage, exactly as
// a call evaluates operands before applying its write frame. Retain only an
// overlapping completed value. This shared capture preserves the old subject
// for ordinary assignments and ranking comparisons alike; it grants no access
// authority and never reevaluates an operand after the write.
public machine snapshot_assignment(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, root: u64 in Trapping, destination: u64 in Trapping)
crashes Trap
{
    let value: |evaluation|::Value = |evaluation|::value_at(checker, root);
    let owner: u64 in Trapping = |places|::subject_place(checker, value.subject);
    let term: bool = value.known && value.subject > 0 && owner > 0 && |places|::checker_within(checker, owner, destination);
    let placed: bool = value.place > 0 && (|places|::checker_within(checker, value.place, destination) || |places|::checker_within(checker, destination, value.place));
    transition destination > 0 && (term || placed) {
        true -> captured(checker, syntax, typing, root, destination),
        false -> {}
    }
    machine captured(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, root: u64 in Trapping, destination: u64 in Trapping) {
        let write: WriteFootprint = WriteFootprint { place: destination, callee: 0 as +Trapping, whole: true };
        snapshot_tree(checker, syntax, typing, root, root, write);
    }
}
