use pipeline/typed_trees_to_checked_trees/loans.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/obligations.omg;
use pipeline/typed_trees_to_checked_trees/owned_places.omg;
use pipeline/typed_trees_to_checked_trees/ownership.omg;

use representations/checks/checks.omg;
use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// The places one call holds together (wiki/spec/language/ownership.md#borrows-and-aliases).
// A call evaluates its arguments in order. An argument that lends a place
// (`@mutable place`, `@place`, an implicit shared loan, or a reference value)
// holds it until the call returns; a copied read or a computed value holds
// nothing once the next argument begins. A place lent to a nested call
// inside an argument stays held when that call, and every call around it,
// returns a value holding references, which may borrow from it; a nested
// call with a reference-free result completed and released its operands'
// loans. An earlier argument's hold conflicts with every overlapping access
// of a later argument (a read, a loan, or a nested call's argument inside
// it) when either is exclusive. Places overlap when one's path is a prefix
// of the other's, through references; integer-literal indexes that differ
// are apart. A terminal invocation may transfer an existing mutable descriptor after
// completed scalar observations through that same route. Fresh borrows and
// retained reference results retain their ordinary exclusive loan windows.

// What an argument holds while its call runs: nothing, or a shared or an
// exclusive loan of a place expression.
public data Hold [copy] {
    case Released;
    case Shared(place: u64 in Trapping);
    case Exclusive(place: u64 in Trapping);
}

// Only a selected machine or binder establishes an invocation for binary syntax.
// Builtin arithmetic and indexing keep their ordinary expression semantics.
public machine called_binary(typing: @|typed_trees|::Typing, expression: |syntax_trees|::Expression, handle: u64 in Trapping) -> bool
crashes Trap
{
    transition expression.kind == |syntax_trees|::ExpressionKind::Binary {
        true -> selected(typing, handle),
        _ -> false
    }
    machine selected(typing: @|typed_trees|::Typing, handle: u64 in Trapping) -> bool {
        let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, handle);
        let called: bool = |obligations|::selects_machine(selection);
        called
    }
}

// A call's arguments, pairwise: an earlier argument's hold against every
// access of a later one.
public machine check_holds(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping)
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, handle);
    let invocation: bool = expression.kind == |syntax_trees|::ExpressionKind::Call || called_binary(typing, expression, handle);
    let count: u64 in Trapping = |obligations|::operand_count(expression);
    transition invocation && count > 1 && checker.output.machine_accepted {
        true -> called(checker, syntax, resolution, typing, handle, expression),
        _ -> done()
    }

    machine called(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, handle: u64 in Trapping, expression: |syntax_trees|::Expression) {
        let selection: |typed_trees|::Selection = |typed_trees|::typing_selection(typing, handle);
        let first_parameter: u64 in Trapping = callee_parameters(syntax, selection);
        let terminal: bool = terminal_call(checker, handle);
        transition { _ -> earlier(checker, syntax, resolution, typing, expression, terminal, first_parameter, 0 as +Trapping) }
    }

    machine earlier(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        terminal: bool,
        first_parameter: u64 in Trapping,
        index: u64 in Trapping
    ) {
        let count: u64 in Trapping = |obligations|::operand_count(expression);
        transition index + 1 < count && checker.output.machine_accepted {
            true -> held(checker, syntax, resolution, typing, expression, terminal, first_parameter, index),
            _ -> done()
        }
    }

    machine held(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        terminal: bool,
        first_parameter: u64 in Trapping,
        index: u64 in Trapping
    ) {
        let argument: u64 in Trapping = |obligations|::checker_operand(syntax, expression, index);
        let hold: Hold = argument_hold(syntax, typing, argument);
        let forwards: bool = terminal && forwards_reference(syntax, resolution, typing, argument);
        let shared: bool = shared_parameter(syntax, typing, first_parameter, index);
        let exclusive: bool = !shared;
        transition hold {
            Hold::Shared { place } -> whole(checker, syntax, resolution, typing, expression, terminal, first_parameter, index, place, false, forwards),
            Hold::Exclusive { place } -> whole(checker, syntax, resolution, typing, expression, terminal, first_parameter, index, place, exclusive, forwards),
            _ -> retained(checker, syntax, resolution, typing, expression, terminal, first_parameter, index)
        }
    }

    machine whole(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        terminal: bool,
        first_parameter: u64 in Trapping,
        index: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        forwards: bool
    ) {
        pair_hold(checker, syntax, resolution, typing, expression, terminal, index, place, exclusive, forwards);
        transition { _ -> retained(checker, syntax, resolution, typing, expression, terminal, first_parameter, index) }
    }

    machine retained(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        terminal: bool,
        first_parameter: u64 in Trapping,
        index: u64 in Trapping
    ) {
        retained_holds(checker, syntax, resolution, typing, expression, terminal, index);
        transition { _ -> earlier(checker, syntax, resolution, typing, expression, terminal, first_parameter, index + 1) }
    }

    machine done() {}
}

// Argument `index`'s hold of `place` against every access of each later
// argument of the call.
machine pair_hold(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    expression: |syntax_trees|::Expression,
    terminal: bool,
    index: u64 in Trapping,
    place: u64 in Trapping,
    exclusive: bool,
    forwards: bool
)
crashes Trap
{
    transition { _ -> later(checker, syntax, resolution, typing, expression, terminal, place, exclusive, forwards, index + 1) }

    machine later(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        terminal: bool,
        place: u64 in Trapping,
        exclusive: bool,
        forwards: bool,
        other: u64 in Trapping
    ) {
        let count: u64 in Trapping = |obligations|::operand_count(expression);
        transition other < count && checker.output.machine_accepted {
            true -> scanned(checker, syntax, resolution, typing, expression, terminal, place, exclusive, forwards, other),
            _ -> done()
        }
    }

    machine scanned(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        terminal: bool,
        place: u64 in Trapping,
        exclusive: bool,
        forwards: bool,
        other: u64 in Trapping
    ) {
        let argument: u64 in Trapping = |obligations|::checker_operand(syntax, expression, other);
        let argument_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, argument);
        let copied: bool = forwards && !|loans|::holds_references(syntax, typing, argument_type);
        scan_accesses(checker, syntax, resolution, typing, argument, place, exclusive, copied);
        transition { _ -> later(checker, syntax, resolution, typing, expression, terminal, place, exclusive, forwards, other + 1) }
    }

    machine done() {}
}

// The places lent inside argument `index`, below its root, that it keeps
// while the call runs, each against the later arguments: a lend inside
// nested calls whose results all hold references.
machine retained_holds(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    expression: |syntax_trees|::Expression,
    terminal: bool,
    index: u64 in Trapping
)
crashes Trap
{
    let argument: u64 in Trapping = |obligations|::checker_operand(syntax, expression, index);
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, argument);
    transition { _ -> next(checker, syntax, resolution, typing, expression, terminal, index, argument, tree.first_row) }

    machine next(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        terminal: bool,
        index: u64 in Trapping,
        argument: u64 in Trapping,
        node: u64 in Trapping
    ) {
        transition node < argument && checker.output.machine_accepted {
            true -> lends(checker, syntax, resolution, typing, expression, terminal, index, argument, node),
            _ -> done()
        }
    }

    machine lends(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        terminal: bool,
        index: u64 in Trapping,
        argument: u64 in Trapping,
        node: u64 in Trapping
    ) {
        let hold: Hold = |loans|::lent_place(checker, syntax, typing, node);
        transition hold {
            Hold::Shared { place } -> lent(checker, syntax, resolution, typing, expression, terminal, index, argument, node, place, false),
            Hold::Exclusive { place } -> lent(checker, syntax, resolution, typing, expression, terminal, index, argument, node, place, true),
            _ -> next(checker, syntax, resolution, typing, expression, terminal, index, argument, node + 1)
        }
    }

    machine lent(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        terminal: bool,
        index: u64 in Trapping,
        argument: u64 in Trapping,
        node: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool
    ) {
        let kept: bool = outlives_calls(syntax, typing, node, argument);
        transition kept {
            true -> held(checker, syntax, resolution, typing, expression, terminal, index, argument, node, place, exclusive),
            _ -> next(checker, syntax, resolution, typing, expression, terminal, index, argument, node + 1)
        }
    }

    machine held(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        expression: |syntax_trees|::Expression,
        terminal: bool,
        index: u64 in Trapping,
        argument: u64 in Trapping,
        node: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool
    ) {
        pair_hold(checker, syntax, resolution, typing, expression, terminal, index, place, exclusive, false);
        transition { _ -> next(checker, syntax, resolution, typing, expression, terminal, index, argument, node + 1) }
    }

    machine done() {}
}

// Whether a loan made at `node` reaches the call through nested results:
// some call up to `root` encloses it, and every such call's result holds
// references and may borrow from it.
machine outlives_calls(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, node: u64 in Trapping, root: u64 in Trapping) -> bool
crashes Trap
{
    transition { _ -> next(syntax, typing, node, root, node + 1, false) }

    machine next(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, node: u64 in Trapping, root: u64 in Trapping, enclosing: u64 in Trapping, found: bool) -> bool {
        transition enclosing <= root {
            true -> enclosed(syntax, typing, node, root, enclosing, found),
            _ -> answer(found)
        }
    }

    machine enclosed(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, node: u64 in Trapping, root: u64 in Trapping, enclosing: u64 in Trapping, found: bool) -> bool {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, enclosing);
        let invocation: bool = expression.kind == |syntax_trees|::ExpressionKind::Call || called_binary(typing, expression, enclosing);
        let call: bool = invocation && expression.first_row <= node;
        transition call {
            true -> completed(syntax, typing, node, root, enclosing),
            _ -> next(syntax, typing, node, root, enclosing + 1, found)
        }
    }

    machine completed(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, node: u64 in Trapping, root: u64 in Trapping, enclosing: u64 in Trapping) -> bool {
        let result: u64 in Trapping = |typed_trees|::typing_expression_type(typing, enclosing);
        let referencing: bool = |loans|::holds_references(syntax, typing, result);
        transition referencing {
            true -> next(syntax, typing, node, root, enclosing + 1, true),
            _ -> answer(false)
        }
    }

    machine answer(outlives: bool) -> bool {
        outlives
    }
}

// What an argument holds: the place an implicit shared loan or a borrow
// lends, or a reference value's referent; a reference read for its scalar
// holds nothing.
machine argument_hold(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, argument: u64 in Trapping) -> Hold
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, argument);
    let adaptation: |typed_trees|::Adaptation = |typed_trees|::typing_adaptation(typing, argument);
    transition adaptation {
        |typed_trees|::Adaptation::SharedLend -> answer(Hold::Shared { place: argument }),
        |typed_trees|::Adaptation::Read -> answer(Hold::Released),
        _ -> lent(syntax, typing, argument, expression)
    }

    machine lent(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, argument: u64 in Trapping, expression: |syntax_trees|::Expression) -> Hold {
        transition expression.kind {
            |syntax_trees|::ExpressionKind::Unary -> borrowed(typing, argument, expression),
            |syntax_trees|::ExpressionKind::Cast -> recast(syntax, typing, argument, expression),
            _ -> referenced(typing, argument)
        }
    }

    // A reference cast keeps the loan of its original operand through any
    // number of explicit views. A scalar result carries no reference loan.
    machine recast(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, argument: u64 in Trapping, expression: |syntax_trees|::Expression) -> Hold {
        let result_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, argument);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, result_type);
        transition row.kind == |typed_trees|::TypeKind::Reference {
            true -> reference_cast(syntax, typing, argument),
            _ -> answer(Hold::Released)
        }
    }

    machine reference_cast(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, argument: u64 in Trapping) -> Hold {
        let origin: u64 in Trapping = |typed_trees|::reference_cast_source(syntax, typing, argument);
        let operand: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, origin);
        transition operand.kind == |syntax_trees|::ExpressionKind::Unary {
            true -> borrowed(typing, origin, operand),
            _ -> referenced(typing, origin)
        }
    }

    machine borrowed(typing: @|typed_trees|::Typing, argument: u64 in Trapping, expression: |syntax_trees|::Expression) -> Hold {
        transition expression.operator {
            |syntax_trees|::OperatorKind::Borrow -> answer(Hold::Shared { place: expression.left }),
            |syntax_trees|::OperatorKind::BorrowMutable -> answer(Hold::Exclusive { place: expression.left }),
            |syntax_trees|::OperatorKind::BorrowWrite -> answer(Hold::Exclusive { place: expression.left }),
            _ -> referenced(typing, argument)
        }
    }

    machine referenced(typing: @|typed_trees|::Typing, argument: u64 in Trapping) -> Hold {
        let argument_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, argument);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, argument_type);
        let is_exclusive: bool = row.access != |syntax_trees|::ReferenceAccess::Shared;
        transition row.kind == |typed_trees|::TypeKind::Reference {
            true -> reference(argument, is_exclusive),
            _ -> answer(Hold::Released)
        }
    }

    machine reference(argument: u64 in Trapping, is_exclusive: bool) -> Hold {
        transition is_exclusive {
            true -> answer(Hold::Exclusive { place: argument }),
            _ -> answer(Hold::Shared { place: argument })
        }
    }

    machine answer(hold: Hold) -> Hold {
        hold
    }
}

// Whether an argument transfers an existing mutable descriptor.
// Existing descriptor values may transfer at a terminal call. A newly formed
// borrow, recast or returning invocation has its independent loan window.
machine forwards_reference(syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, argument: u64 in Trapping) -> bool
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, argument);
    let declared: bool = expression.kind == |syntax_trees|::ExpressionKind::Name || expression.kind == |syntax_trees|::ExpressionKind::Field || expression.kind == |syntax_trees|::ExpressionKind::Index;
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, |typed_trees|::typing_expression_type(typing, argument));
    declared && row.kind == |typed_trees|::TypeKind::Reference && row.access == |syntax_trees|::ReferenceAccess::Mutable
        && |typed_trees|::typing_adaptation(typing, argument) != |typed_trees|::Adaptation::Read
}

// Every access inside a later argument against an earlier argument's hold
// of `place`: an overlapping access conflicts when either is exclusive.
machine scan_accesses(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    argument: u64 in Trapping,
    place: u64 in Trapping,
    exclusive: bool,
    copied: bool
)
crashes Trap
{
    let tree: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, argument);
    transition { _ -> next(checker, syntax, resolution, typing, argument, place, exclusive, copied, tree.first_row) }

    machine next(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        argument: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        copied: bool,
        node: u64 in Trapping
    ) {
        transition node <= argument && checker.output.machine_accepted {
            true -> access(checker, syntax, resolution, typing, argument, place, exclusive, copied, node),
            _ -> done()
        }
    }

    machine access(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        argument: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        copied: bool,
        node: u64 in Trapping
    ) {
        let role: |ownership|::UseRole = |ownership|::role_of(checker, node);
        let root: u64 in Trapping = |owned_places|::path_root(syntax, resolution, typing, node, true);
        transition role == |ownership|::UseRole::Base || root == 0 {
            true -> next(checker, syntax, resolution, typing, argument, place, exclusive, copied, node + 1),
            _ -> overlapping(checker, syntax, resolution, typing, argument, place, exclusive, copied, node, role)
        }
    }

    machine overlapping(
        checker: @mutable |checker|::Checker,
        syntax: @|syntax_trees|::SyntaxTrees,
        resolution: @|symbol_resolved_trees|::NameResolution,
        typing: @|typed_trees|::Typing,
        argument: u64 in Trapping,
        place: u64 in Trapping,
        exclusive: bool,
        copied: bool,
        node: u64 in Trapping,
        role: |ownership|::UseRole
    ) {
        let relation: |owned_places|::PlaceRelation = |owned_places|::path_relation(syntax, resolution, typing, node, place, true);
        let excludes: bool = exclusive_access(typing, node, role);
        let access_root: u64 in Trapping = |owned_places|::path_root(syntax, resolution, typing, node, true);
        let held_root: u64 in Trapping = |owned_places|::path_root(syntax, resolution, typing, place, true);
        let same_root: bool = access_root == held_root;
        let snapshot: bool = copied && !excludes && same_root && relation == |owned_places|::PlaceRelation::Inside;
        let conflict: bool = relation != |owned_places|::PlaceRelation::Apart && (exclusive || excludes) && !snapshot;
        transition conflict {
            true -> rejected(checker, syntax, node),
            _ -> next(checker, syntax, resolution, typing, argument, place, exclusive, copied, node + 1)
        }
    }

    machine rejected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, node: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, node);
        |checks|::checks_reject(@mutable checker.output, |checks|::CheckDiagnosticCode::OverlappingArguments, expression.source_span);
    }

    machine done() {}
}

// Whether a place access is exclusive: lent `@mutable`, or an exclusive
// reference passed on rather than read.
machine exclusive_access(typing: @|typed_trees|::Typing, node: u64 in Trapping, role: |ownership|::UseRole) -> bool
crashes Trap
{
    let node_type: u64 in Trapping = |typed_trees|::typing_expression_type(typing, node);
    let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, node_type);
    let adaptation: |typed_trees|::Adaptation = |typed_trees|::typing_adaptation(typing, node);
    let reference: bool = row.kind == |typed_trees|::TypeKind::Reference && row.access != |syntax_trees|::ReferenceAccess::Shared
        && adaptation != |typed_trees|::Adaptation::Read;
    let exclusive: bool = role == |ownership|::UseRole::Exclusive || role == |ownership|::UseRole::WriteLend || (role == |ownership|::UseRole::Value && reference);
    transition { _ -> answer(exclusive) }

    machine answer(exclusive: bool) -> bool {
        exclusive
    }
}

// The handle of a call's callee's first parameter, plus one: a machine's or
// zero when the callee has no parameter list here.
public machine callee_parameters(syntax: @|syntax_trees|::SyntaxTrees, selection: |typed_trees|::Selection) -> u64 in Trapping
crashes Trap
{
    transition selection {
        |typed_trees|::Selection::Machine { handle } -> machine_parameters(syntax, handle),
        _ -> answer(0 as +Trapping)
    }

    machine machine_parameters(syntax: @|syntax_trees|::SyntaxTrees, handle: u64 in Trapping) -> u64 in Trapping {
        let item: |syntax_trees|::MachineItem = |syntax_trees|::machine_item(syntax, handle);
        let first: u64 in Trapping = item.first_parameter + 1;
        transition { _ -> answer(first) }
    }

    machine answer(first: u64 in Trapping) -> u64 in Trapping {
        first
    }
}

// Whether a call's parameter `offset` is a shared reference: an exclusive
// argument passed there is held shared.
public machine shared_parameter(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, first_parameter: u64 in Trapping, offset: u64 in Trapping) -> bool
crashes Trap
{
    transition first_parameter > 0 {
        true -> located(syntax, typing, first_parameter, offset),
        _ -> answer(false)
    }

    machine located(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, first_parameter: u64 in Trapping, offset: u64 in Trapping) -> bool {
        let index: u64 in Trapping = (first_parameter - 1) + offset;
        transition { _ -> declared(syntax, typing, index) }
    }

    machine declared(syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, index: u64 in Trapping) -> bool {
        let parameter: |syntax_trees|::Parameter = |syntax_trees|::syntax_trees_parameter(syntax, index);
        let type_handle: u64 in Trapping = |typed_trees|::reference_type(typing, parameter.type_reference);
        let row: |typed_trees|::TypeRow = |typed_trees|::type_table_row(@typing.types, type_handle);
        let shared: bool = row.kind == |typed_trees|::TypeKind::Reference && row.access == |syntax_trees|::ReferenceAccess::Shared;
        transition { _ -> answer(shared) }
    }

    machine answer(shared: bool) -> bool {
        shared
    }
}

// One completion-position roster serves every selected invocation. A terminal
// transition forwards through dispatch result alternatives and acknowledgement
// wrappers. Call operands, dispatch subjects and pattern tests remain ordinary:
// they still have an enclosing evaluation to resume. The expression arena is
// child-before-parent, so one reverse pass propagates completion without a
// recursive parser stack or any lexical/state-specific call permission.
public machine initialize_terminal_calls(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees)
crashes Trap
{
    transition { _ -> clear(checker, syntax, 0 as +Trapping) }
    machine clear(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.expression_count && index < 131072 {
            true -> cleared(checker, syntax, index),
            false -> arm(checker, syntax, 0 as +Trapping)
        }
    }
    machine cleared(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping)
    requires index < 131072
    {
        checker.terminal_calls[index as -Trapping] = false;
        transition { _ -> clear(checker, syntax, index + 1) }
    }
    machine arm(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < syntax.arm_count {
            true -> target(checker, syntax, index),
            false -> initialized(checker, syntax)
        }
    }
    machine target(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let current_arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_arm(syntax, index);
        transition current_arm.target_kind == |syntax_trees|::ArmTargetKind::Unit {
            true -> arm(checker, syntax, index + 1),
            false -> seed(checker, syntax, index, current_arm.target)
        }
    }
    machine seed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, target: u64 in Trapping) {
        mark(checker, syntax, target);
        transition { _ -> arm(checker, syntax, index + 1) }
    }
    machine initialized(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees) {
        let remaining: u64 in Trapping = syntax.expression_count as +Trapping;
        transition { _ -> propagate(checker, syntax, remaining) }
    }
    machine propagate(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, remaining: u64 in Trapping) {
        transition remaining > 0 {
            true -> position(checker, syntax, remaining - 1),
            false -> done()
        }
    }
    machine position(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        transition index < 131072 {
            true -> selected(checker, syntax, index),
            false -> done()
        }
    }
    machine selected(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping)
    requires index < 131072
    {
        transition checker.terminal_calls[index as -Trapping] {
            true -> expression(checker, syntax, index),
            false -> propagate(checker, syntax, index)
        }
    }
    machine expression(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping) {
        let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, index);
        let acknowledged: bool = expression.kind == |syntax_trees|::ExpressionKind::Unary
            && (expression.operator == |syntax_trees|::OperatorKind::Suspend || expression.operator == |syntax_trees|::OperatorKind::Block || expression.operator == |syntax_trees|::OperatorKind::SuspendBlock);
        transition acknowledged {
            true -> wrapped(checker, syntax, index, expression.left),
            false -> dispatch(checker, syntax, index, expression)
        }
    }
    machine wrapped(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, target: u64 in Trapping) {
        mark(checker, syntax, target);
        transition { _ -> propagate(checker, syntax, index) }
    }
    machine dispatch(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, expression: |syntax_trees|::Expression) {
        transition expression.kind == |syntax_trees|::ExpressionKind::Match {
            true -> alternative(checker, syntax, index, expression, 0 as +Trapping),
            false -> propagate(checker, syntax, index)
        }
    }
    machine alternative(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, expression: |syntax_trees|::Expression, offset: u64 in Trapping) {
        transition offset < expression.count {
            true -> result(checker, syntax, index, expression, offset),
            false -> propagate(checker, syntax, index)
        }
    }
    machine result(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, expression: |syntax_trees|::Expression, offset: u64 in Trapping) {
        let arm: |syntax_trees|::TransitionArm = |syntax_trees|::syntax_trees_match_arm(syntax, expression.first + offset);
        transition arm.target_kind == |syntax_trees|::ArmTargetKind::Unit {
            true -> alternative(checker, syntax, index, expression, offset + 1),
            false -> valued(checker, syntax, index, expression, offset, arm.target)
        }
    }
    machine valued(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, index: u64 in Trapping, expression: |syntax_trees|::Expression, offset: u64 in Trapping, target: u64 in Trapping) {
        mark(checker, syntax, target);
        transition { _ -> alternative(checker, syntax, index, expression, offset + 1) }
    }
    // A malformed/missing coordinate gains no terminal borrowing permission.
    machine mark(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, target: u64 in Trapping) {
        transition target < syntax.expression_count && target < 131072 {
            true -> bounded(checker, target),
            false -> done()
        }
    }
    machine bounded(checker: @mutable |checker|::Checker, target: u64 in Trapping)
    requires target < 131072
    {
        checker.terminal_calls[target as -Trapping] = true;
    }
    machine done() {}
}

machine terminal_call(checker: @|checker|::Checker, expression: u64 in Trapping) -> bool
crashes Trap
{
    transition expression < 131072 {
        true -> checker.terminal_calls[expression as -Trapping],
        false -> false
    }
}
