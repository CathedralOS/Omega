use pipeline/typed_trees_to_checked_trees/facts.omg;
use pipeline/typed_trees_to_checked_trees/flow.omg;
use pipeline/typed_trees_to_checked_trees/checker.omg;
use pipeline/typed_trees_to_checked_trees/evaluation.omg;

use representations/symbol_resolved_trees/symbol_resolved_trees.omg;
use representations/syntax_trees/syntax_trees.omg;
use representations/typed_trees/typed_trees.omg;

// Alias metadata follows the same branch lifetime as its zone. At a join
// only associations valid on both reachable paths survive.
public data AliasTable [copy] {
    places: [u64; 16];
    conditions: [u64; 16];
    limits: [u64; 16];
    count: u64;
}

// Boolean aliases. A Boolean place bound from a condition (`let valid: bool
// = count < 64u32;`, `guard.valid = guard.count < 64u32;`), or from another
// aliased Boolean place, stands for that condition while no place that
// existed when it was bound is written: assuming the place at a dispatch or
// guard assumes the condition, evaluated again over the unchanged places.
// A write to any older place, or a call releasing one, forgets the alias.
// An alias lives in its body; a Boolean passed to a state carries none.

// Record that Boolean `place` stands for the condition `root` bound to it,
// whose value is `value`; a copy of an aliased place takes its condition.
// The caller proves replayable before binding: evaluation changed no
// storage, and the destination does not overwrite a read of this condition.
// Later writes still retire aliases through forget_aliases below.
public machine record_alias(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, typing: @|typed_trees|::Typing, place: u64 in Trapping, root: u64 in Trapping, value: |evaluation|::Value, replayable: bool)
crashes Trap
{
    let type_handle: u64 in Trapping = |typed_trees|::typing_expression_type(typing, root);
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    transition replayable && place > 0 && type_handle == typing.boolean {
        true -> condition(checker, place, root, expression, value),
        _ -> done()
    }

    machine condition(checker: @mutable |checker|::Checker, place: u64 in Trapping, root: u64 in Trapping, expression: |syntax_trees|::Expression, value: |evaluation|::Value) {
        transition expression.kind {
            |syntax_trees|::ExpressionKind::Binary -> own(checker, place, root),
            |syntax_trees|::ExpressionKind::Unary -> own(checker, place, root),
            |syntax_trees|::ExpressionKind::Membership -> own(checker, place, root),
            |syntax_trees|::ExpressionKind::Name -> copied(checker, place, value),
            |syntax_trees|::ExpressionKind::Field -> copied(checker, place, value),
            _ -> done()
        }
    }

    machine own(checker: @mutable |checker|::Checker, place: u64 in Trapping, root: u64 in Trapping) {
        add_alias(checker, place, root);
    }

    machine copied(checker: @mutable |checker|::Checker, place: u64 in Trapping, value: |evaluation|::Value) {
        let condition: u64 in Trapping = alias_condition(checker, value.place);
        transition condition > 0 {
            true -> chained(checker, place, condition - 1),
            _ -> done()
        }
    }

    machine chained(checker: @mutable |checker|::Checker, place: u64 in Trapping, condition: u64 in Trapping) {
        add_alias(checker, place, condition);
    }

    machine done() {}
}

// At a statement-level dispatch or guard (never inside a tree, where the
// replay would evaluate over it), a Boolean place, or its negation, assumed
// to hold (or fail) assumes its alias's condition the same way.
public machine assume_alias(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, root: u64 in Trapping, holds: bool)
crashes Trap
{
    let expression: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, root);
    let negated: bool = expression.kind == |syntax_trees|::ExpressionKind::Unary && expression.operator == |syntax_trees|::OperatorKind::Not;
    let fails: bool = !holds;
    transition negated {
        true -> placed(checker, syntax, resolution, typing, expression.left, fails),
        _ -> placed(checker, syntax, resolution, typing, root, holds)
    }

    machine placed(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, node: u64 in Trapping, holds: bool) {
        let value: |evaluation|::Value = |evaluation|::value_at(checker, node);
        let condition: u64 in Trapping = alias_condition(checker, value.place);
        transition condition > 0 {
            true -> aliased(checker, syntax, resolution, typing, condition - 1, holds),
            _ -> done()
        }
    }

    machine aliased(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, condition: u64 in Trapping, holds: bool) {
        |flow|::replay_tree(checker, syntax, resolution, typing, condition);
        |facts|::assume(checker, syntax, condition, holds);
    }

    machine done() {}
}

// A Boolean subject's `true`/`false` arm assumes the subject's alias held or
// failed as its literal says.
public machine assume_subject_alias(
    checker: @mutable |checker|::Checker,
    syntax: @|syntax_trees|::SyntaxTrees,
    resolution: @|symbol_resolved_trees|::NameResolution,
    typing: @|typed_trees|::Typing,
    subject: u64 in Trapping,
    arm: |syntax_trees|::TransitionArm,
    chosen: bool
)
crashes Trap
{
    let written: |syntax_trees|::Expression = |syntax_trees|::syntax_trees_expression(syntax, arm.pattern);
    let holds: bool = written.flag == chosen;
    transition arm.kind == |syntax_trees|::ArmPatternKind::Literal && written.kind == |syntax_trees|::ExpressionKind::Boolean {
        true -> literal(checker, syntax, resolution, typing, subject, holds),
        _ -> done()
    }

    machine literal(checker: @mutable |checker|::Checker, syntax: @|syntax_trees|::SyntaxTrees, resolution: @|symbol_resolved_trees|::NameResolution, typing: @|typed_trees|::Typing, subject: u64 in Trapping, holds: bool) {
        assume_alias(checker, syntax, resolution, typing, subject, holds);
    }

    machine done() {}
}

// The condition `place` stands for, plus one; zero when it has none.
public machine alias_condition(checker: @|checker|::Checker, place: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    transition place > 0 {
        true -> next(checker, place, 0 as +Trapping),
        _ -> answer(0 as +Trapping)
    }

    machine next(checker: @|checker|::Checker, place: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping {
        transition index < checker.aliases.count && index < 16 {
            true -> entry(checker, place, index),
            _ -> answer(0 as +Trapping)
        }
    }

    machine entry(checker: @|checker|::Checker, place: u64 in Trapping, index: u64 in Trapping) -> u64 in Trapping
    requires index < 16
    {
        let aliased: u64 = checker.aliases.places[index as -Trapping];
        let condition: u64 = checker.aliases.conditions[index as -Trapping];
        let found: u64 in Trapping = (condition as u64 +Trapping) + 1;
        transition aliased == place {
            true -> answer(found),
            _ -> next(checker, place, index + 1)
        }
    }

    machine answer(condition: u64 in Trapping) -> u64 in Trapping {
        condition
    }
}

// Bind `place` to `condition`, replacing its alias; a full table keeps
// none, which only forgets facts.
machine add_alias(checker: @mutable |checker|::Checker, place: u64 in Trapping, condition: u64 in Trapping)
crashes Trap
{
    drop_aliases(checker, place, 0 as +Trapping);
    let count: u64 = checker.aliases.count;
    transition count < 16 {
        true -> write(checker, place, condition, count),
        _ -> done()
    }

    machine write(checker: @mutable |checker|::Checker, place: u64 in Trapping, condition: u64 in Trapping, index: u64)
    requires index < 16
    {
        checker.aliases.places[index] = place as u64;
        checker.aliases.conditions[index] = condition as u64;
        checker.aliases.limits[index] = checker.place_count;
        checker.aliases.count = index + 1;
    }

    machine done() {}
}

// A written place forgets every alias it is, and every alias formed while it
// existed, whose condition may read it.
public machine forget_aliases(checker: @mutable |checker|::Checker, place: u64 in Trapping)
crashes Trap
{
    drop_aliases(checker, place, place);
}

// Drop each alias of `place`, and with `older` nonzero each alias formed
// while place `older` existed.
machine drop_aliases(checker: @mutable |checker|::Checker, place: u64 in Trapping, older: u64 in Trapping)
crashes Trap
{
    transition { _ -> next(checker, place, older, 0 as +Trapping) }

    machine next(checker: @mutable |checker|::Checker, place: u64 in Trapping, older: u64 in Trapping, index: u64 in Trapping) {
        transition index < checker.aliases.count && index < 16 {
            true -> entry(checker, place, older, index),
            _ -> done()
        }
    }

    machine entry(checker: @mutable |checker|::Checker, place: u64 in Trapping, older: u64 in Trapping, index: u64 in Trapping)
    requires index < 16
    {
        let aliased: u64 = checker.aliases.places[index as -Trapping];
        let limit: u64 = checker.aliases.limits[index as -Trapping];
        let stale: bool = aliased == place || (older > 0 && older <= limit);
        transition stale {
            true -> removed(checker, place, older, index),
            _ -> next(checker, place, older, index + 1)
        }
    }

    // The last alias takes the removed one's slot and is examined next.
    machine removed(checker: @mutable |checker|::Checker, place: u64 in Trapping, older: u64 in Trapping, index: u64 in Trapping) {
        let count: u64 = checker.aliases.count;
        transition count > 0 && count <= 16 && index < 16 {
            true -> moved(checker, place, older, index, count - 1),
            _ -> done()
        }
    }

    machine moved(checker: @mutable |checker|::Checker, place: u64 in Trapping, older: u64 in Trapping, index: u64 in Trapping, last: u64)
    requires index < 16, last < 16
    {
        let last_place: u64 = checker.aliases.places[last];
        let last_condition: u64 = checker.aliases.conditions[last];
        let last_limit: u64 = checker.aliases.limits[last];
        checker.aliases.places[index as -Trapping] = last_place;
        checker.aliases.conditions[index as -Trapping] = last_condition;
        checker.aliases.limits[index as -Trapping] = last_limit;
        checker.aliases.count = last;
        transition { _ -> next(checker, place, older, index) }
    }

    machine done() {}
}

// Copy only an existing, still-valid predicate association. This does not
// turn an effectful expression into a replayable condition. Ordinary writes
// retire the copied alias through its original live-place dependencies.
public machine copy_alias(checker: @mutable |checker|::Checker, source: u64 in Trapping, target: u64 in Trapping)
crashes Trap
{
    let condition: u64 in Trapping = alias_condition(checker, source);
    transition source != target && target > 0 && condition > 0 {
        true -> copied(checker, target, condition - 1),
        _ -> done()
    }
    machine copied(checker: @mutable |checker|::Checker, target: u64 in Trapping, condition: u64 in Trapping) {
        add_alias(checker, target, condition);
    }
    machine done() {}
}

// Intersect associations by identity; an unreachable predecessor contributes
// no constraint. Taking the larger limit remains conservative for later writes.
public machine alias_table_join(table: @mutable AliasTable, other: @AliasTable, current_live: bool, other_live: bool)
crashes Trap
{
    transition other_live {
        true -> reachable(table, other, current_live),
        _ -> done()
    }
    machine reachable(table: @mutable AliasTable, other: @AliasTable, current_live: bool) {
        transition current_live {
            true -> next(table, other, 0 as +Trapping),
            _ -> copied(table, other)
        }
    }
    machine copied(table: @mutable AliasTable, other: @AliasTable) {
        let saved: AliasTable = AliasTable {
            places: other.places, conditions: other.conditions,
            limits: other.limits, count: other.count
        };
        $table = saved;
    }
    machine next(table: @mutable AliasTable, other: @AliasTable, index: u64 in Trapping) {
        transition index < table.count && index < 16 {
            true -> candidate(table, other, index),
            _ -> done()
        }
    }
    machine candidate(table: @mutable AliasTable, other: @AliasTable, index: u64 in Trapping)
    requires index < 16
    {
        let place: u64 = table.places[index as -Trapping];
        let condition: u64 = table.conditions[index as -Trapping];
        transition { _ -> find(table, other, index, place, condition, 0 as +Trapping) }
    }
    machine find(table: @mutable AliasTable, other: @AliasTable, index: u64 in Trapping, place: u64, condition: u64, offset: u64 in Trapping) {
        transition offset < other.count && offset < 16 {
            true -> compare(table, other, index, place, condition, offset),
            _ -> removed(table, other, index)
        }
    }
    machine compare(table: @mutable AliasTable, other: @AliasTable, index: u64 in Trapping, place: u64, condition: u64, offset: u64 in Trapping)
    requires offset < 16, index < 16
    {
        let same: bool = other.places[offset as -Trapping] == place && other.conditions[offset as -Trapping] == condition;
        transition same {
            true -> kept(table, other, index, offset),
            _ -> find(table, other, index, place, condition, offset + 1)
        }
    }
    machine kept(table: @mutable AliasTable, other: @AliasTable, index: u64 in Trapping, offset: u64 in Trapping)
    requires index < 16, offset < 16
    {
        let limit: u64 = other.limits[offset as -Trapping];
        transition limit > table.limits[index as -Trapping] {
            true -> limited(table, other, index, limit),
            _ -> next(table, other, index + 1)
        }
    }
    machine limited(table: @mutable AliasTable, other: @AliasTable, index: u64 in Trapping, limit: u64)
    requires index < 16
    {
        table.limits[index as -Trapping] = limit;
        transition { _ -> next(table, other, index + 1) }
    }
    machine removed(table: @mutable AliasTable, other: @AliasTable, index: u64 in Trapping) {
        let count: u64 = table.count;
        transition count > 0 && count <= 16 && index < 16 {
            true -> moved(table, other, index, count - 1),
            _ -> done()
        }
    }
    machine moved(table: @mutable AliasTable, other: @AliasTable, index: u64 in Trapping, last: u64)
    requires index < 16, last < 16
    {
        table.places[index as -Trapping] = table.places[last];
        table.conditions[index as -Trapping] = table.conditions[last];
        table.limits[index as -Trapping] = table.limits[last];
        table.count = last;
        transition { _ -> next(table, other, index) }
    }
    machine done() {}
}
