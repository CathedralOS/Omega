use main.omg as span_test;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "source_span_test" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |span_test|::start);
    Build::bind(builder, windows_arm64::ProgramEntry, |span_test|::start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |span_test|::start);
    Build::bind(builder, macos_arm64::ProgramEntry, |span_test|::start);
    Build::bind(builder, linux_arm64::ProgramEntry, |span_test|::start);
}
