use main.omg as place_depth_test;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "place_depth_tests" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |place_depth_test|::start);
    Build::bind(builder, windows_arm64::ProgramEntry, |place_depth_test|::start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |place_depth_test|::start);
    Build::bind(builder, macos_arm64::ProgramEntry, |place_depth_test|::start);
    Build::bind(builder, linux_arm64::ProgramEntry, |place_depth_test|::start);
}
