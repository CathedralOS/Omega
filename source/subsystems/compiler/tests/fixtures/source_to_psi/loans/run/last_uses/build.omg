use main.omg as last_use_test;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "last_use_tests" };
    Build::bind(builder, windows_x86_64::ProgramEntry, |last_use_test|::start);
    Build::bind(builder, windows_arm64::ProgramEntry, |last_use_test|::start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |last_use_test|::start);
    Build::bind(builder, macos_arm64::ProgramEntry, |last_use_test|::start);
    Build::bind(builder, linux_arm64::ProgramEntry, |last_use_test|::start);
}
