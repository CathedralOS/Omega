use {wire}/codec.omg;
use request.omg as input;
use outcome.omg as results;

// The little-endian `u32` at `offset`; callers have bounded `offset + 4`.
machine u32_at(request: @|input|::Request, offset: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let b0: u8 = |input|::request_byte(request, offset);
    let b1: u8 = |input|::request_byte(request, offset + 1);
    let b2: u8 = |input|::request_byte(request, offset + 2);
    let b3: u8 = |input|::request_byte(request, offset + 3);
    |codec|::u32_from_le_bytes(b0, b1, b2, b3) as u64 +Trapping
}

// The OCREQ identity `4F 43 52 45 51 01 00 00` by position.
machine identity_byte(index: u64 in Trapping) -> u64 in Trapping {
    transition index {
        0 -> byte(79),
        1 -> byte(67),
        2 -> byte(82),
        3 -> byte(69),
        4 -> byte(81),
        5 -> byte(1),
        _ -> byte(0)
    }

    machine byte(value: u64) -> u64 in Trapping {
        value as +Trapping
    }
}

// The two sections the envelope frames, as request offsets.
public data Sections [copy] {
    subject_start: u64 in Trapping;
    subject_end: u64 in Trapping;
    invocation_start: u64 in Trapping;
    invocation_end: u64 in Trapping;
}

machine sections_none() -> Sections {
    Sections { subject_start: 0 as +Trapping, subject_end: 0 as +Trapping, invocation_start: 0 as +Trapping, invocation_end: 0 as +Trapping }
}

// What a request phase concludes: it continues into `sections`, or it
// publishes `outcome`.
public data Verdict [copy] {
    complete: bool;
    sections: Sections;
    outcome: |results|::Outcome;
}

machine refuse(outcome: |results|::Outcome) -> Verdict {
    let sections: Sections = sections_none();
    Verdict { complete: false, sections: sections, outcome: outcome }
}

// Phases 0 and 1 over a staged request: the eight identity bytes, the two
// section lengths with their high bits clear, extents compared
// subtractively against what remains, and the exact end; then the declared
// subject and invocation extents against their provisions. A refusal names
// `malformed_request` at the first missing, incorrect or trailing byte; a
// stream shorter than a fixed field is missing its byte at the stream end.
// A request the staging provision could not hold is refused first, at the
// first byte that could not be staged.
public machine request_envelope(request: @|input|::Request) -> Verdict
crashes Trap
{
    let length: u64 in Trapping = |input|::staged(request);
    transition request.observed > length {
        true -> incomplete(|results|::Provision::RequestStagingBytes, 65536 as +Trapping, request.observed),
        _ -> framing(request, length)
    }

    machine framing(request: @|input|::Request, length: u64 in Trapping) -> Verdict {
        transition length >= 8 {
            true -> identity(request, length, 0 as +Trapping),
            _ -> malformed(length)
        }
    }

    machine identity(request: @|input|::Request, length: u64 in Trapping, index: u64 in Trapping) -> Verdict {
        let byte: u64 in Trapping = |input|::request_byte(request, index) as u64 +Trapping;
        let expected: u64 in Trapping = identity_byte(index);
        transition byte == expected {
            true -> identity_next(request, length, index),
            _ -> malformed(index)
        }
    }

    machine identity_next(request: @|input|::Request, length: u64 in Trapping, index: u64 in Trapping) -> Verdict {
        transition index < 7 {
            true -> identity(request, length, index + 1),
            _ -> header(request, length)
        }
    }

    machine header(request: @|input|::Request, length: u64 in Trapping) -> Verdict {
        transition length >= 16 {
            true -> subject_high_bit(request, length),
            _ -> malformed(length)
        }
    }

    machine subject_high_bit(request: @|input|::Request, length: u64 in Trapping) -> Verdict {
        let high: u8 = |input|::request_byte(request, 11 as +Trapping);
        transition high < 128 {
            true -> invocation_high_bit(request, length),
            _ -> malformed(8 as +Trapping)
        }
    }

    machine invocation_high_bit(request: @|input|::Request, length: u64 in Trapping) -> Verdict {
        let high: u8 = |input|::request_byte(request, 15 as +Trapping);
        transition high < 128 {
            true -> lengths(request, length),
            _ -> malformed(12 as +Trapping)
        }
    }

    machine lengths(request: @|input|::Request, length: u64 in Trapping) -> Verdict {
        let subject_length: u64 in Trapping = u32_at(request, 8 as +Trapping);
        let invocation_length: u64 in Trapping = u32_at(request, 12 as +Trapping);
        transition subject_length <= length - 16 {
            true -> subject(length, 16 + subject_length, invocation_length),
            _ -> malformed(8 as +Trapping)
        }
    }

    machine subject(length: u64 in Trapping, subject_end: u64 in Trapping, invocation_length: u64 in Trapping) -> Verdict {
        transition invocation_length <= length - subject_end {
            true -> exact_end(length, subject_end, subject_end + invocation_length),
            _ -> malformed(12 as +Trapping)
        }
    }

    machine exact_end(length: u64 in Trapping, subject_end: u64 in Trapping, invocation_end: u64 in Trapping) -> Verdict {
        transition invocation_end == length {
            true -> subject_extent(subject_end, invocation_end),
            _ -> malformed(invocation_end)
        }
    }

    // Phase 1: the declared extents against their provisions.
    machine subject_extent(subject_end: u64 in Trapping, invocation_end: u64 in Trapping) -> Verdict {
        transition subject_end - 16 <= 67108864 {
            true -> invocation_extent(subject_end, invocation_end),
            _ -> incomplete(|results|::Provision::RequestSubjectBytes, 8 as +Trapping, subject_end - 16)
        }
    }

    machine invocation_extent(subject_end: u64 in Trapping, invocation_end: u64 in Trapping) -> Verdict {
        transition invocation_end - subject_end <= 1048576 {
            true -> framed(subject_end, invocation_end),
            _ -> incomplete(|results|::Provision::RequestInvocationBytes, 12 as +Trapping, invocation_end - subject_end)
        }
    }

    machine framed(subject_end: u64 in Trapping, invocation_end: u64 in Trapping) -> Verdict {
        let sections: Sections = Sections {
            subject_start: 16 as +Trapping,
            subject_end: subject_end,
            invocation_start: subject_end,
            invocation_end: invocation_end
        };
        let outcome: |results|::Outcome = |results|::coverage_request_semantics();
        Verdict { complete: true, sections: sections, outcome: outcome }
    }

    machine malformed(offset: u64 in Trapping) -> Verdict {
        let outcome: |results|::Outcome = |results|::malformed_request(offset);
        refuse(outcome)
    }

    machine incomplete(provision: |results|::Provision, coordinate: u64 in Trapping, requested: u64 in Trapping) -> Verdict {
        let outcome: |results|::Outcome = |results|::outcome_incomplete(provision, coordinate, requested);
        refuse(outcome)
    }
}

// A cursor over one section for the field/tag structure pass. Every read is
// compared subtractively against the section end, a `u32` with its high bit
// set refuses at its first byte, and a declared count must fit the
// remaining extent at its row's minimum width before any row is read, so a
// hostile count cannot stretch the walk. The first failure records where
// `malformed_request` anchors: a missing byte at the section end, an invalid
// value at its field, trailing bytes at the first one. Reads after a
// failure take nothing and return zero.
public data SectionReader {
    cursor: u64 in Trapping;
    end: u64 in Trapping;
    failed: bool;
    failure: u64 in Trapping;
}

machine open(reader: @mutable SectionReader, start: u64 in Trapping, end: u64 in Trapping) {
    transition start <= end {
        true -> framed(reader, start, end),
        _ -> empty(reader, end)
    }

    machine framed(reader: @mutable SectionReader, start: u64 in Trapping, end: u64 in Trapping) {
        reader.end = end;
        reader.cursor = start;
        reader.failed = false;
        reader.failure = 0 as +Trapping;
    }

    machine empty(reader: @mutable SectionReader, end: u64 in Trapping) {
        reader.end = end;
        reader.cursor = end;
        reader.failed = true;
        reader.failure = end;
    }
}

// The bytes left before the section end.
machine section_reader_remaining(reader: @SectionReader) -> u64 in Trapping {
    reader.end - reader.cursor
}

machine fail(reader: @mutable SectionReader, offset: u64 in Trapping) {
    transition reader.failed {
        true -> kept(),
        _ -> record(reader, offset)
    }

    machine record(reader: @mutable SectionReader, offset: u64 in Trapping) {
        reader.failed = true;
        reader.failure = offset;
    }

    machine kept() {}
}

// Move past `width` bytes the caller has bounded by `remaining`.
machine advance(reader: @mutable SectionReader, width: u64 in Trapping) {
    transition width <= reader.end - reader.cursor {
        true -> past(reader, width),
        _ -> missing(reader)
    }

    machine past(reader: @mutable SectionReader, width: u64 in Trapping) {
        reader.cursor = reader.cursor + width;
    }

    machine missing(reader: @mutable SectionReader) {
        let end: u64 in Trapping = reader.end;
        fail(reader, end);
    }
}

// A little-endian `u32` whose high bit is clear.
machine take_u32(reader: @mutable SectionReader, request: @|input|::Request) -> u64 in Trapping
crashes Trap
{
    let remaining: u64 in Trapping = section_reader_remaining(reader);
    transition reader.failed || remaining < 4 {
        true -> missing(reader),
        _ -> high_bit(reader, request)
    }

    machine missing(reader: @mutable SectionReader) -> u64 in Trapping {
        let end: u64 in Trapping = reader.end;
        fail(reader, end);
        0 as +Trapping
    }

    machine high_bit(reader: @mutable SectionReader, request: @|input|::Request) -> u64 in Trapping {
        let high: u8 = |input|::request_byte(request, reader.cursor + 3);
        transition high < 128 {
            true -> value(reader, request),
            _ -> refused(reader)
        }
    }

    machine refused(reader: @mutable SectionReader) -> u64 in Trapping {
        let field: u64 in Trapping = reader.cursor;
        fail(reader, field);
        0 as +Trapping
    }

    machine value(reader: @mutable SectionReader, request: @|input|::Request) -> u64 in Trapping {
        let value: u64 in Trapping = u32_at(request, reader.cursor);
        advance(reader, 4 as +Trapping);
        value
    }
}

// A table count that must fit the remaining extent at `minimum_row` bytes a
// row; an impossible count is malformed at its count field.
machine take_count(reader: @mutable SectionReader, request: @|input|::Request, minimum_row: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let count: u64 in Trapping = take_u32(reader, request);
    let remaining: u64 in Trapping = section_reader_remaining(reader);
    transition reader.failed || count <= remaining / minimum_row {
        true -> fits(count),
        _ -> impossible(reader)
    }

    machine fits(count: u64 in Trapping) -> u64 in Trapping {
        count
    }

    machine impossible(reader: @mutable SectionReader) -> u64 in Trapping {
        let field: u64 in Trapping = reader.cursor - 4;
        fail(reader, field);
        0 as +Trapping
    }
}

// A `u32` tag that must lie in `low..=high`; an empty range refuses every
// value.
machine take_tag(reader: @mutable SectionReader, request: @|input|::Request, low: u64 in Trapping, high: u64 in Trapping) -> u64 in Trapping
crashes Trap
{
    let tag: u64 in Trapping = take_u32(reader, request);
    transition reader.failed || tag >= low && tag <= high {
        true -> member(tag),
        _ -> refused(reader)
    }

    machine member(tag: u64 in Trapping) -> u64 in Trapping {
        tag
    }

    machine refused(reader: @mutable SectionReader) -> u64 in Trapping {
        let field: u64 in Trapping = reader.cursor - 4;
        fail(reader, field);
        0 as +Trapping
    }
}

// A length-framed byte field: its content's first offset, with the cursor
// moved past it.
machine take_bytes(reader: @mutable SectionReader, request: @|input|::Request) -> u64 in Trapping
crashes Trap
{
    let length: u64 in Trapping = take_u32(reader, request);
    let start: u64 in Trapping = reader.cursor;
    advance(reader, length);
    start
}

// Bytes left in the section are malformed at the first one.
machine finish(reader: @mutable SectionReader) {
    transition reader.failed || reader.cursor == reader.end {
        true -> done(),
        _ -> trailing(reader)
    }

    machine trailing(reader: @mutable SectionReader) {
        let cursor: u64 in Trapping = reader.cursor;
        fail(reader, cursor);
    }

    machine done() {}
}

// Phases 2 and 6: the subject's and the invocation's field/tag shape, read
// positionally in the contract's table order. Reads are fail-sticky, so a
// table whose count failed reads no rows. A request that survives is
// well formed, but its semantic phases (package keys, ordering, graph,
// snapshots, admissions, commitment) are not implemented yet, so it
// publishes the `coverage_request_semantics` provision rather than a
// verdict it cannot defend.
public machine request_structure(request: @|input|::Request, sections: Sections) -> |results|::Outcome
crashes Trap
{
    let mutable reader: SectionReader;
    open(@mutable reader, sections.subject_start, sections.subject_end);
    // A package row is at least its eight framing words and snapshot count.
    let packages: u64 in Trapping = take_count(@mutable reader, request, 36 as +Trapping);
    transition { _ -> package(request, sections, @mutable reader, packages, 0 as +Trapping) }

    machine package(request: @|input|::Request, sections: Sections, reader: @mutable SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> |results|::Outcome {
        transition index < count && !reader.failed {
            true -> package_fields(request, sections, reader, count, index),
            _ -> edges(request, sections, reader)
        }
    }

    machine package_fields(request: @|input|::Request, sections: Sections, reader: @mutable SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> |results|::Outcome {
        let name: u64 in Trapping = take_bytes(reader, request);
        let lineage_kind: u64 in Trapping = take_tag(reader, request, 1 as +Trapping, 2 as +Trapping);
        let lineage: u64 in Trapping = take_bytes(reader, request);
        let revision: u64 in Trapping = take_bytes(reader, request);
        let tree: u64 in Trapping = take_bytes(reader, request);
        let content: u64 in Trapping = take_bytes(reader, request);
        let member: u64 in Trapping = take_bytes(reader, request);
        let role: u64 in Trapping = take_tag(reader, request, 1 as +Trapping, 2 as +Trapping);
        // A snapshot row is at least its kind and path length.
        let rows: u64 in Trapping = take_count(reader, request, 8 as +Trapping);
        transition { _ -> snapshot(request, sections, reader, count, index, rows, 0 as +Trapping) }
    }

    machine snapshot(
        request: @|input|::Request,
        sections: Sections,
        reader: @mutable SectionReader,
        count: u64 in Trapping,
        index: u64 in Trapping,
        rows: u64 in Trapping,
        row: u64 in Trapping
    ) -> |results|::Outcome {
        transition row < rows && !reader.failed {
            true -> snapshot_row(request, sections, reader, count, index, rows, row),
            _ -> package(request, sections, reader, count, index + 1)
        }
    }

    // Kind 1 is a directory with no payload, 2 a regular file with its
    // executable tag and content, 3 a symbolic link with its target.
    machine snapshot_row(
        request: @|input|::Request,
        sections: Sections,
        reader: @mutable SectionReader,
        count: u64 in Trapping,
        index: u64 in Trapping,
        rows: u64 in Trapping,
        row: u64 in Trapping
    ) -> |results|::Outcome {
        let kind: u64 in Trapping = take_tag(reader, request, 1 as +Trapping, 3 as +Trapping);
        let path: u64 in Trapping = take_bytes(reader, request);
        transition kind {
            2 -> regular_file(request, sections, reader, count, index, rows, row),
            3 -> link(request, sections, reader, count, index, rows, row),
            _ -> snapshot(request, sections, reader, count, index, rows, row + 1)
        }
    }

    machine regular_file(
        request: @|input|::Request,
        sections: Sections,
        reader: @mutable SectionReader,
        count: u64 in Trapping,
        index: u64 in Trapping,
        rows: u64 in Trapping,
        row: u64 in Trapping
    ) -> |results|::Outcome {
        let executable: u64 in Trapping = take_tag(reader, request, 0 as +Trapping, 1 as +Trapping);
        let content: u64 in Trapping = take_bytes(reader, request);
        transition { _ -> snapshot(request, sections, reader, count, index, rows, row + 1) }
    }

    machine link(
        request: @|input|::Request,
        sections: Sections,
        reader: @mutable SectionReader,
        count: u64 in Trapping,
        index: u64 in Trapping,
        rows: u64 in Trapping,
        row: u64 in Trapping
    ) -> |results|::Outcome {
        let target: u64 in Trapping = take_bytes(reader, request);
        transition { _ -> snapshot(request, sections, reader, count, index, rows, row + 1) }
    }

    // An edge row is four words: requester, scope, alias length, target.
    machine edges(request: @|input|::Request, sections: Sections, reader: @mutable SectionReader) -> |results|::Outcome {
        let count: u64 in Trapping = take_count(reader, request, 16 as +Trapping);
        transition { _ -> edge(request, sections, reader, count, 0 as +Trapping) }
    }

    machine edge(request: @|input|::Request, sections: Sections, reader: @mutable SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> |results|::Outcome {
        transition index < count && !reader.failed {
            true -> edge_fields(request, sections, reader, count, index),
            _ -> root(request, sections, reader)
        }
    }

    machine edge_fields(request: @|input|::Request, sections: Sections, reader: @mutable SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> |results|::Outcome {
        let requester: u64 in Trapping = take_u32(reader, request);
        let scope: u64 in Trapping = take_tag(reader, request, 1 as +Trapping, 2 as +Trapping);
        let alias: u64 in Trapping = take_bytes(reader, request);
        let target: u64 in Trapping = take_u32(reader, request);
        transition { _ -> edge(request, sections, reader, count, index + 1) }
    }

    machine root(request: @|input|::Request, sections: Sections, reader: @mutable SectionReader) -> |results|::Outcome {
        let package: u64 in Trapping = take_u32(reader, request);
        let role: u64 in Trapping = take_tag(reader, request, 1 as +Trapping, 2 as +Trapping);
        finish(reader);
        transition reader.failed {
            true -> malformed(reader.failure),
            _ -> invocation(request, sections, reader)
        }
    }

    // The invocation: product, target profile, admissions (no admission kind
    // is assigned, so any present row refuses), and the 32-byte commitment.
    machine invocation(request: @|input|::Request, sections: Sections, reader: @mutable SectionReader) -> |results|::Outcome {
        open(reader, sections.invocation_start, sections.invocation_end);
        let product: u64 in Trapping = take_tag(reader, request, 1 as +Trapping, 4 as +Trapping);
        let target_profile: u64 in Trapping = take_bytes(reader, request);
        // An admission row is at least its kind and data length.
        let admissions: u64 in Trapping = take_count(reader, request, 8 as +Trapping);
        transition { _ -> admission(request, reader, admissions, 0 as +Trapping) }
    }

    machine admission(request: @|input|::Request, reader: @mutable SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> |results|::Outcome {
        transition index < count && !reader.failed {
            true -> admission_fields(request, reader, count, index),
            _ -> commitment(reader)
        }
    }

    machine admission_fields(request: @|input|::Request, reader: @mutable SectionReader, count: u64 in Trapping, index: u64 in Trapping) -> |results|::Outcome {
        let kind: u64 in Trapping = take_tag(reader, request, 1 as +Trapping, 0 as +Trapping);
        let data: u64 in Trapping = take_bytes(reader, request);
        transition { _ -> admission(request, reader, count, index + 1) }
    }

    machine commitment(reader: @mutable SectionReader) -> |results|::Outcome {
        advance(reader, 32 as +Trapping);
        finish(reader);
        transition reader.failed {
            true -> malformed(reader.failure),
            _ -> semantics()
        }
    }

    machine malformed(offset: u64 in Trapping) -> |results|::Outcome {
        |results|::malformed_request(offset)
    }

    machine semantics() -> |results|::Outcome {
        |results|::coverage_request_semantics()
    }
}

// Run the OCREQ phases in contract order and return the first refusal.
public machine compile_request(request: @|input|::Request) -> |results|::Outcome
crashes Trap
{
    let verdict: Verdict = request_envelope(request);
    transition verdict.complete {
        true -> request_structure(request, verdict.sections),
        _ -> refused(verdict.outcome)
    }

    machine refused(outcome: |results|::Outcome) -> |results|::Outcome {
        outcome
    }
}
