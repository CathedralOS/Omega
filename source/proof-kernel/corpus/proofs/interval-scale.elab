; refinement-subtyping VC: scaling a bounded value scales its range.
;   a<=x & x<=b -> a*c<=x*c & x*c<=b*c   (x : {a..b} implies x*c : {a*c..b*c})
; two applications of mult-mono (a<=b -> a*c<=b*c), paired. Completes the refinement-arithmetic trio with interval-refinement (widen) and interval-shift (offset). The obligation for `x * c` on a bounded value (cf. the strided-access bounds).
(def 0 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 1 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 2 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 3 (all x1 (all x2 (all x3 (= (* (+ x3 x1) x2) (+ (* x3 x2) (* x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (* (+ x6 x4) x5) (+ (* x6 x5) (* x4 x5))) (refl (* x4 x5)) (gen x7 (lam h8 (= (* (+ x7 x4) x5) (+ (* x7 x5) (* x4 x5))) (app (app (inst (inst (inst (use 2) (+ x5 (* (+ x7 x4) x5))) (+ x5 (+ (* x7 x5) (* x4 x5)))) (+ (+ x5 (* x7 x5)) (* x4 x5))) (eqelim x9 (= (+ x5 (* (+ x7 x4) x5)) (+ x5 x9)) h8 (refl (+ x5 (* (+ x7 x4) x5))))) (app (inst (inst (use 1) (+ (+ x5 (* x7 x5)) (* x4 x5))) (+ x5 (+ (* x7 x5) (* x4 x5)))) (inst (inst (inst (use 0) (* x7 x5)) (* x4 x5)) x5)))))))))
(def 4 (all x1 (all x2 (all x3 (-> (ex x4 (= (+ x1 x4) x2)) (ex x5 (= (+ (* x1 x3) x5) (* x2 x3))))))) (gen x6 (gen x7 (gen x8 (lam h9 (ex x10 (= (+ x6 x10) x7)) (unpack h9 (gen x11 (lam h12 (= (+ x6 x11) x7) (wit x13 (= (+ (* x6 x8) x13) (* x7 x8)) (* x11 x8) (app (app (inst (inst (inst (use 2) (+ (* x6 x8) (* x11 x8))) (* (+ x6 x11) x8)) (* x7 x8)) (app (inst (inst (use 1) (* (+ x6 x11) x8)) (+ (* x6 x8) (* x11 x8))) (inst (inst (inst (use 3) x11) x8) x6))) (eqelim x14 (= (* x14 x8) (* x7 x8)) (app (inst (inst (use 1) (+ x6 x11)) x7) h12) (refl (* x7 x8)))))))))))))
(all x1 (all x2 (all x3 (all x4 (-> (ex x5 (= (+ x1 x5) x2)) (-> (ex x6 (= (+ x2 x6) x3)) (& (ex x7 (= (+ (* x1 x4) x7) (* x2 x4))) (ex x8 (= (+ (* x2 x4) x8) (* x3 x4))))))))))
(gen x1 (gen x2 (gen x3 (gen x4 (lam h5 (ex x6 (= (+ x1 x6) x2)) (lam h7 (ex x8 (= (+ x2 x8) x3)) (pair (app (inst (inst (inst (use 4) x1) x2) x4) h5) (app (inst (inst (inst (use 4) x2) x3) x4) h7))))))))
