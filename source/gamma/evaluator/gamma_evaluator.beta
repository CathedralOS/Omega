; Direct Beta evaluator for the typed scalar/effect Gamma bootstrap profile.
; Request: u32 little-endian source length, source bytes, sealed input bytes.
; Returning main's Int writes its low byte and completes with status zero.
;
; Persistent registers:
; r80 request end, r81 source start, r82 source end, r83 input start,
; r84 input length, r85 cursor, r86 token start, r87 token length,
; r88 function count, r89 environment count, r8a value-stack pointer,
; r8b main function row, r8c active environment base,
; r8d function-frame pointer, r8e call-context depth.
; r90 zero, r91 one, r92 request base, r93 request limit,
; r94 function table, r95 environment table, r96 value-stack base,
; r97 value-stack end, r98 tail-request flag, r99 tail function,
; r9a tail argument base, r9b tail argument count,
; ra0 immutable-pair heap cursor, ra1 immutable-pair heap limit,
; rb0 output count, rb1 output limit.
; Low registers are caller-clobbered scratch.

0x0: ; main:
        imm r90 0x0
        imm r91 0x1
        imm r92 0x100000
        imm r93 0x1100000
        imm r94 0x1200000
        imm r95 0x1300000
        imm r96 0x1500000
        imm r97 0x1d00000
        imm ra0 0x2000000
        imm ra1 0xe000000
        mov rb0 r90
        imm rb1 0x4000000
        mov r0 r92
0x74: ; read_loop:
        jeq r0 r93 0x9b ; -> read_full:
        read r1
        jlt r1 r90 0xb1 ; -> read_done:
        storeb r0 r1
        add r0 r91
        jmp 0x74 ; -> read_loop:
0x9b: ; read_full:
        read r1
        jlt r1 r90 0xb1 ; -> read_done:
        jmp 0x1879 ; -> incomplete:
0xb1: ; read_done:
        mov r80 r0
        mov r1 r92
        imm r2 0x4
        add r1 r2
        jlt r80 r1 0x1861 ; -> invalid:
        mov r0 r92
        call 0x1a7 ; -> read_u32:
        mov r81 r92
        imm r1 0x4
        add r81 r1
        mov r82 r81
        add r82 r0
        jlt r82 r81 0x1861 ; -> invalid:
        jlt r80 r82 0x1861 ; -> invalid:
        mov r83 r82
        mov r84 r80
        sub r84 r83
        call 0x1f3 ; -> validate_source:
        call 0x9da ; -> census:
        mov r89 r90
        mov r8c r90
        mov r8a r96
        mov r8e r90
        call 0xbad ; -> validate_program:
        mov r89 r90
        mov r8c r90
        mov r8a r96
        imm r8d 0x1e00000
        mov r8e r90
        mov r0 r8b
        mov r1 r8a
        mov r2 r90
        call 0xf63 ; -> enter_function:
        jlt r0 r90 0x186d ; -> authored_trap:
        imm r1 0x100
        jlt r0 r1 0x188 ; -> main_write:
        jmp 0x186d ; -> authored_trap:
0x188: ; main_write:
        call 0x196 ; -> write_output:
        mov r0 r90
        halt r0

0x196: ; write_output:
        jeq rb0 rb1 0x1879 ; -> incomplete:
        write r0
        add rb0 r91
        ret

; r0 points to four little-endian bytes; returns u32 in r0.
0x1a7: ; read_u32:
        loadb r1 r0
        mov r2 r0
        add r2 r91
        loadb r3 r2
        imm r4 0x100
        mul r3 r4
        add r1 r3
        add r2 r91
        loadb r3 r2
        imm r4 0x10000
        mul r3 r4
        add r1 r3
        add r2 r91
        loadb r3 r2
        imm r4 0x1000000
        mul r3 r4
        add r1 r3
        mov r0 r1
        ret

0x1f3: ; validate_source:
        mov r0 r81
0x1f6: ; validate_source_loop:
        jlt r0 r82 0x202 ; -> validate_source_byte:
        ret
0x202: ; validate_source_byte:
        loadb r1 r0
        imm r2 0x9
        jeq r1 r2 0x277 ; -> validate_source_next:
        imm r2 0xa
        jeq r1 r2 0x277 ; -> validate_source_next:
        imm r2 0xd
        jeq r1 r2 0x277 ; -> validate_source_next:
        imm r2 0x20
        jlt r1 r2 0x1861 ; -> invalid:
        imm r2 0x7f
        jlt r1 r2 0x277 ; -> validate_source_next:
        jmp 0x1861 ; -> invalid:
0x277: ; validate_source_next:
        add r0 r91
        jmp 0x1f6 ; -> validate_source_loop:

; Tokenizer. Returns r0=1 with r86/r87, or r0=0 at source end.
0x283: ; next_token:
        mov r0 r85
0x286: ; next_skip:
        jlt r0 r82 0x298 ; -> next_have:
        mov r85 r0
        mov r0 r90
        ret
0x298: ; next_have:
        loadb r1 r0
        imm r2 0x21
        jlt r1 r2 0x2ce ; -> next_advance:
        imm r2 0x3b
        jeq r1 r2 0x2da ; -> next_comment:
        jmp 0x32a ; -> next_begin:
0x2ce: ; next_advance:
        add r0 r91
        jmp 0x286 ; -> next_skip:
0x2da: ; next_comment:
        add r0 r91
0x2dd: ; next_comment_loop:
        jlt r0 r82 0x2f1 ; -> next_comment_byte:
        jmp 0x286 ; -> next_skip:
0x2f1: ; next_comment_byte:
        loadb r1 r0
        add r0 r91
        imm r2 0xa
        jeq r1 r2 0x286 ; -> next_skip:
        imm r2 0xd
        jeq r1 r2 0x286 ; -> next_skip:
        jmp 0x2dd ; -> next_comment_loop:
0x32a: ; next_begin:
        mov r86 r0
        imm r2 0x27
        jeq r1 r2 0x3ef ; -> next_character:
        imm r2 0x28
        jeq r1 r2 0x3e3 ; -> next_punctuation:
        imm r2 0x29
        jeq r1 r2 0x3e3 ; -> next_punctuation:
0x36c: ; next_body:
        jlt r0 r82 0x380 ; -> next_body_byte:
        jmp 0x47c ; -> next_done:
0x380: ; next_body_byte:
        loadb r1 r0
        imm r2 0x21
        jlt r1 r2 0x47c ; -> next_done:
        imm r2 0x3b
        jeq r1 r2 0x47c ; -> next_done:
        imm r2 0x28
        jeq r1 r2 0x47c ; -> next_done:
        imm r2 0x29
        jeq r1 r2 0x47c ; -> next_done:
        add r0 r91
        jmp 0x36c ; -> next_body:
0x3e3: ; next_punctuation:
        add r0 r91
        jmp 0x47c ; -> next_done:
0x3ef: ; next_character:
        add r0 r91
        jlt r0 r82 0x406 ; -> next_character_byte:
        jmp 0x1861 ; -> invalid:
0x406: ; next_character_byte:
        loadb r1 r0
        imm r2 0x5c
        jeq r1 r2 0x42a ; -> next_character_escape:
        add r0 r91
        jmp 0x444 ; -> next_character_close:
0x42a: ; next_character_escape:
        add r0 r91
        jlt r0 r82 0x441 ; -> next_character_escape_byte:
        jmp 0x1861 ; -> invalid:
0x441: ; next_character_escape_byte:
        add r0 r91
0x444: ; next_character_close:
        jlt r0 r82 0x458 ; -> next_character_close_byte:
        jmp 0x1861 ; -> invalid:
0x458: ; next_character_close_byte:
        loadb r1 r0
        imm r2 0x27
        jeq r1 r2 0x479 ; -> next_character_done:
        jmp 0x1861 ; -> invalid:
0x479: ; next_character_done:
        add r0 r91
0x47c: ; next_done:
        mov r87 r0
        sub r87 r86
        mov r85 r0
        mov r0 r91
        ret

0x489: ; need_token:
        call 0x283 ; -> next_token:
        jz r0 0x1861 ; -> invalid:
        ret

; r0 packed ASCII, r1 length. Return r0=0/1 against current token.
0x49d: ; token_equals:
        jeq r87 r1 0x4ac ; -> token_equals_begin:
        mov r0 r90
        ret
0x4ac: ; token_equals_begin:
        mov r2 r90
        mov r3 r0
0x4b2: ; token_equals_loop:
        jeq r2 r1 0x4f4 ; -> token_equals_true:
        mov r4 r86
        add r4 r2
        loadb r5 r4
        imm r6 0x100
        mov r7 r3
        mod r7 r6
        jeq r5 r7 0x4e5 ; -> token_equals_next:
        mov r0 r90
        ret
0x4e5: ; token_equals_next:
        div r3 r6
        add r2 r91
        jmp 0x4b2 ; -> token_equals_loop:
0x4f4: ; token_equals_true:
        mov r0 r91
        ret

; Classify the current list head through the explicit table below. Zero is call.
0x4f8: ; classify_list_head:
        imm r8 0x1891 ; -> list_head_table:
0x502: ; classify_list_head_loop:
        load r0 r8
        imm r1 0x8
        add r8 r1
        load r3 r8
        jz r3 0x569 ; -> classify_list_head_call:
        mov r1 r3
        imm r4 0x100
        mod r1 r4
        call 0x49d ; -> token_equals:
        jnz r0 0x558 ; -> classify_list_head_found:
        imm r1 0x8
        add r8 r1
        jmp 0x502 ; -> classify_list_head_loop:
0x558: ; classify_list_head_found:
        load r0 r8
        imm r1 0x100
        div r0 r1
        ret
0x569: ; classify_list_head_call:
        mov r0 r90
        ret

0x56d: ; is_open:
        imm r0 0x28
        imm r1 0x1
        call 0x49d ; -> token_equals:
        ret
0x58b: ; is_close:
        imm r0 0x29
        imm r1 0x1
        call 0x49d ; -> token_equals:
        ret
0x5a9: ; expect_open:
        call 0x489 ; -> need_token:
        call 0x56d ; -> is_open:
        jz r0 0x1861 ; -> invalid:
        ret
0x5c6: ; expect_close:
        call 0x489 ; -> need_token:
        call 0x58b ; -> is_close:
        jz r0 0x1861 ; -> invalid:
        ret
0x5e3: ; expect_int:
        call 0x489 ; -> need_token:
        imm r0 0x746e49
        imm r1 0x3
        call 0x49d ; -> token_equals:
        jz r0 0x1861 ; -> invalid:
        ret

; Parse current decimal token. Return value r0 and success flag r1.
0x614: ; parse_integer:
        jz r87 0x6ef ; -> parse_integer_fail:
        mov r2 r90
        mov r3 r90
        mov r4 r90
        loadb r5 r86
        imm r6 0x27
        jeq r5 r6 0x6f6 ; -> parse_character:
        imm r6 0x2d
        jeq r5 r6 0x65d ; -> parse_integer_minus:
        jmp 0x66e ; -> parse_integer_loop:
0x65d: ; parse_integer_minus:
        mov r4 r91
        add r2 r91
        jeq r2 r87 0x6ef ; -> parse_integer_fail:
0x66e: ; parse_integer_loop:
        jeq r2 r87 0x6d4 ; -> parse_integer_done:
        mov r5 r86
        add r5 r2
        loadb r5 r5
        imm r6 0x30
        jlt r5 r6 0x6ef ; -> parse_integer_fail:
        imm r7 0x3a
        jlt r5 r7 0x6b5 ; -> parse_integer_digit:
        jmp 0x6ef ; -> parse_integer_fail:
0x6b5: ; parse_integer_digit:
