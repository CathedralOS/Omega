0x43b: ; require_memory_byte:
        loadb r6, r4
        jeq r6, r5, 0x452                   ; -> require_memory_byte_ok:
        jmp 0x3277                          ; -> gamma_invalid:
0x452: ; require_memory_byte_ok:
