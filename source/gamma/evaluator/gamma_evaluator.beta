        mov rc, ra
        add rc, rb
        imm rd, 0x11
        add rc, rd
        imm r1, 0x900000
        load r2, r1
        jeq rc, r2, 0x138                   ; -> request_extent_valid:
        jmp 0x3277                          ; -> gamma_invalid:
0x138: ; request_extent_valid:
        imm r0, 0x100011
        imm r1, 0x900008
        store r1, r0
        mov r1, r0
        add r1, ra
        imm r2, 0x900018
        store r2, r1
        imm r2, 0x900020
        store r2, r1

        call 0x4b6                          ; -> validate_source_envelope:

        imm r0, 0x900088
        imm r1, 0x900100
        store r0, r1
        imm r0, 0x900090
        imm r1, 0x0
        store r0, r1
        imm r0, 0x900008
        load r1, r0
        imm r0, 0x900030
        store r0, r1
        call 0x567                          ; -> parse_program:

        imm r0, 0x2100000
        jeq rf, r0, 0x1e7                   ; -> parser_stack_balanced:
        jmp 0x329b                          ; -> gamma_internal:
0x1e7: ; parser_stack_balanced:
        imm r0, 0x2100000
        mov rf, r0
        imm r0, 0x9000e8
