        imm r4 0x2
        add r2 r4
        loadb r2 r2
        imm r3 0x6e
        jeq r2 r3 0x791 ; -> parse_character_newline:
        imm r3 0x73
        jeq r2 r3 0x7a4 ; -> parse_character_space:
        jmp 0x7b2 ; -> parse_character_fail:
0x791: ; parse_character_newline:
        imm r0 0xa
        jmp 0x7ae ; -> parse_character_true:
0x7a4: ; parse_character_space:
        imm r0 0x20
0x7ae: ; parse_character_true:
        mov r1 r91
        ret
0x7b2: ; parse_character_fail:
