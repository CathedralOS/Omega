        imm r6, 0x1
        add r4, r6
        loadb r7, r4
        imm r8, 0x100
        mul r7, r8
        add r5, r7
        add r4, r6
        loadb r7, r4
        imm r8, 0x10000
        mul r7, r8
        add r5, r7
        add r4, r6
        loadb r7, r4
        imm r8, 0x1000000
        mul r7, r8
        add r5, r7
        mov r0, r5
        ret

