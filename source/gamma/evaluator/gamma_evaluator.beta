; Gamma evaluator core, written in Beta.
;
; Implemented now:
; - exact-ended GAMMAREQ v1 loading and source-envelope validation;
; - unary function declaration rows plus one entry, selected by exact name;
; - unary calls with isolated lexical environments and bounded recursion;
; - complete structural validation for the retained expression surface;
; - input and lowercase #x byte values;
; - heterogeneous pair values and checked first/second projection;
; - Complete, Reject, checked integer operations, and every byte primitive;
; - immutable raw/hex/single/concat/slice byte nodes in the bounded value arena;
; - one-pass output whose bytes are authoritative only with status zero.
;
; Ordinary calls use the fixed evaluator stack; collision is Incomplete rather
; than a Gamma result. This source is not the canonical evaluator tape.

; Global words in the declaration region.
; 9437184 total request bytes
; 9437192 source start
; 9437200 source length
; 9437208 source end
; 9437216 input start
; 9437224 input length
; 9437232 cursor
; 9437240 token start
; 9437248 token length
; 9437256 def name start
; 9437264 def name length
; 9437272 parameter start
; 9437280 parameter length
; 9437288 body start
; 9437296 body end
; 9437304 entry name start
; 9437312 entry name length
; 9437320 function-row end cursor
; 9437328 have entry
; 9437336 input Bytes handle
; 9437344 arena cursor
; 9437352 value tag
; 9437360 value word zero
; 9437368 value word one
; 9437416 binding cursor
; 9437464 active binding base
; Function rows begin at 0x901000 and contain six source-span words.

        imm rf, 0x2100000
        imm re, 0x100000
0x14: ; read_request_loop:
        imm r2, 0x900000
        jeq re, r2, 0x59                    ; -> read_request_probe:
        read r1
        imm r3, 0x0
        jlt r1, r3, 0x79                    ; -> read_request_done:
        storeb re, r1
        imm r3, 0x1
        add re, r3
        jmp 0x14                            ; -> read_request_loop:
0x59: ; read_request_probe:
        read r1
        imm r3, 0x0
        jlt r1, r3, 0x79                    ; -> read_request_done:
        jmp 0x34a1                          ; -> gamma_incomplete:
0x79: ; read_request_done:
        mov r0, re
        imm r1, 0x100000
        sub r0, r1
        imm r1, 0x900000
        store r1, r0
        imm r1, 0x11
        jlt r0, r1, 0x3489                  ; -> gamma_invalid:

        imm r0, 0x100000
        call 0x3e7                          ; -> validate_request_magic:

        imm r0, 0x100009
        call 0x4bb                          ; -> read_u32:
        imm r1, 0x900010
        store r1, r0
        mov ra, r0
        imm r0, 0x10000d
        call 0x4bb                          ; -> read_u32:
        imm r1, 0x900028
        store r1, r0
        mov rb, r0

        mov rc, ra
        add rc, rb
        imm rd, 0x11
        add rc, rd
        imm r1, 0x900000
        load r2, r1
        jeq rc, r2, 0x138                   ; -> request_extent_valid:
        jmp 0x3489                          ; -> gamma_invalid:
0x138: ; request_extent_valid:
        imm r0, 0x100011
        imm r1, 0x900008
        store r1, r0
        mov r1, r0
        add r1, ra
        imm r2, 0x900018
        store r2, r1
        imm r2, 0x900020
        store r2, r1

        call 0x511                          ; -> validate_source_envelope:

        imm r0, 0x900088
        imm r1, 0x901000
        store r0, r1
        imm r0, 0x900090
        imm r1, 0x0
        store r0, r1
        imm r0, 0x900008
        load r1, r0
        imm r0, 0x900030
        store r0, r1
        call 0x5c2                          ; -> parse_program:

        imm r0, 0x2100000
        jeq rf, r0, 0x1e7                   ; -> parser_stack_balanced:
        jmp 0x34ad                          ; -> gamma_internal:
0x1e7: ; parser_stack_balanced:
        imm r0, 0x2100000
        mov rf, r0
        imm r0, 0x9000e8
        imm r1, 0x1100000
        store r0, r1
        imm r0, 0x2100000
        ; rf already set; initialize the immutable arena.
        imm r0, 0x2100000
        imm r1, 0x9000a0
        store r1, r0
        ; Correct arena start is 0x02100000 = 34603008.

        imm r0, 0x900028
        load r1, r0
        imm r2, 0x0
        jeq r1, r2, 0x297                   ; -> input_is_empty:
        imm r0, 0x1
        mov r2, r1
        imm r1, 0x900020
        load r3, r1
        mov r1, r2
        mov r2, r3
        imm r3, 0x0
        call 0x239e                         ; -> allocate_node:
        imm r1, 0x900098
        store r1, r0
        jmp 0x2ae                           ; -> input_ready:
0x297: ; input_is_empty:
        imm r0, 0x900098
        imm r1, 0x0
        store r0, r1
0x2ae: ; input_ready:
        imm r0, 0x1100000
        imm r1, 0x900118
        store r1, r0
        imm r0, 0x900058
        load r0, r0
        imm r1, 0x900060
        load r1, r1
        imm r2, 0x2
        imm r3, 0x900098
        load r3, r3
        imm r4, 0x0
        call 0x3405                         ; -> push_binding:
        imm r0, 0x900068
        load r1, r0
        imm r0, 0x900030
        store r0, r1
        call 0xd01                          ; -> evaluate_expression:
        imm r0, 0x900030
        load r1, r0
        imm r0, 0x900070
        load r2, r0
        jeq r1, r2, 0x35a                   ; -> body_consumed:
        jmp 0x34ad                          ; -> gamma_internal:
0x35a: ; body_consumed:
        imm r0, 0x9000a8
        load r1, r0
        imm r2, 0x3
        jeq r1, r2, 0x385                   ; -> outcome_ready:
        jmp 0x34ad                          ; -> gamma_internal:
0x385: ; outcome_ready:
        imm r0, 0x9000b0
        load r1, r0
        imm r2, 0x2
        jeq r1, r2, 0x3495                  ; -> gamma_authored_trap:
        imm r2, 0x1
        jeq r1, r2, 0x3c5                   ; -> emit_complete:
        jmp 0x34ad                          ; -> gamma_internal:
0x3c5: ; emit_complete:
        imm r0, 0x9000b8
        load r0, r0
        call 0x26b1                         ; -> emit_bytes:
        imm r0, 0x0
        halt r0

; r0 = request base. Exact nine-byte GAMMAREQ v1 magic.
0x3e7: ; validate_request_magic:
        mov r4, r0
        imm r5, 0x47
        call 0x496                          ; -> require_memory_byte:
        imm r5, 0x41
        call 0x496                          ; -> require_memory_byte:
        imm r5, 0x4d
        call 0x496                          ; -> require_memory_byte:
        imm r5, 0x4d
        call 0x496                          ; -> require_memory_byte:
        imm r5, 0x41
        call 0x496                          ; -> require_memory_byte:
        imm r5, 0x52
        call 0x496                          ; -> require_memory_byte:
        imm r5, 0x45
        call 0x496                          ; -> require_memory_byte:
        imm r5, 0x51
        call 0x496                          ; -> require_memory_byte:
        imm r5, 0x1
        call 0x496                          ; -> require_memory_byte:
        ret

; r4 = pointer, r5 = expected byte. Advances r4.
0x496: ; require_memory_byte:
        loadb r6, r4
        jeq r6, r5, 0x4ad                   ; -> require_memory_byte_ok:
        jmp 0x3489                          ; -> gamma_invalid:
0x4ad: ; require_memory_byte_ok:
        imm r6, 0x1
        add r4, r6
        ret

; r0 = pointer, returns little-endian u32 in r0.
0x4bb: ; read_u32:
        mov r4, r0
        loadb r5, r4
        imm r6, 0x1
        add r4, r6
        loadb r7, r4
        imm r8, 0x100
        mul r7, r8
        add r5, r7
        add r4, r6
        loadb r7, r4
        imm r8, 0x10000
        mul r7, r8
        add r5, r7
        add r4, r6
        loadb r7, r4
        imm r8, 0x1000000
        mul r7, r8
        add r5, r7
        mov r0, r5
        ret

0x511: ; validate_source_envelope:
        imm r0, 0x900008
        load r4, r0
        imm r0, 0x900018
        load r5, r0
0x52b: ; source_envelope_loop:
        jlt r4, r5, 0x537                   ; -> source_envelope_byte:
        ret
0x537: ; source_envelope_byte:
        loadb r6, r4
        imm r7, 0x9
        jeq r6, r7, 0x5ac                   ; -> source_envelope_next:
        imm r7, 0xa
        jeq r6, r7, 0x5ac                   ; -> source_envelope_next:
        imm r7, 0xd
        jeq r6, r7, 0x5ac                   ; -> source_envelope_next:
        imm r7, 0x20
        jlt r6, r7, 0x3489                  ; -> gamma_invalid:
        imm r7, 0x7f
        jlt r6, r7, 0x5ac                   ; -> source_envelope_next:
        jmp 0x3489                          ; -> gamma_invalid:
0x5ac: ; source_envelope_next:
        imm r7, 0x1
        add r4, r7
        jmp 0x52b                           ; -> source_envelope_loop:

0x5c2: ; parse_program:
0x5c2: ; parse_program_loop:
        call 0x2e44                         ; -> skip_trivia:
        imm r0, 0x900030
        load r4, r0
        imm r0, 0x900018
        load r5, r0
        jlt r4, r5, 0x5f9                   ; -> parse_program_form:
        jmp 0x8da                           ; -> parse_program_done:
0x5f9: ; parse_program_form:
        call 0x2d5e                         ; -> consume_open:
        call 0x2f70                         ; -> next_token:
        imm r0, 0x34b9
        imm r1, 0x3
        call 0x319d                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0x678                   ; -> parse_def:
        imm r0, 0x34bc
        imm r1, 0x5
        call 0x319d                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0x840                   ; -> parse_entry:
        jmp 0x3489                          ; -> gamma_invalid:
0x678: ; parse_def:
        imm r0, 0x900088
        load r1, r0
        mov r2, r1
        imm r3, 0x30
        add r2, r3
        imm r3, 0x1100000
        jlt r2, r3, 0x6b3                   ; -> parse_def_new:
        jmp 0x34a1                          ; -> gamma_incomplete:
0x6b3: ; parse_def_new:
        call 0x2f70                         ; -> next_token:
        call 0x2c09                         ; -> require_lower_name:
        imm r1, 0x900040
        load r1, r1
        imm r0, 0x900038
        load r0, r0
        call 0x9ad                          ; -> find_function:
        imm r1, 0x0
        jeq r0, r1, 0x706                   ; -> parse_def_unique:
        jmp 0x3489                          ; -> gamma_invalid:
0x706: ; parse_def_unique:
        imm r0, 0x900088
        load r4, r0
        imm r0, 0x900038
        load r1, r0
        store r4, r1
        imm r2, 0x8
        add r4, r2
        imm r0, 0x900040
        load r1, r0
        store r4, r1
        call 0x2d5e                         ; -> consume_open:
        call 0x2f70                         ; -> next_token:
        call 0x2c09                         ; -> require_lower_name:
        imm r0, 0x900088
        load r4, r0
        imm r2, 0x10
        add r4, r2
        imm r0, 0x900038
        load r1, r0
        store r4, r1
        imm r2, 0x8
        add r4, r2
        imm r0, 0x900040
        load r1, r0
        store r4, r1
        call 0x2dd1                         ; -> consume_close:
        call 0x2e44                         ; -> skip_trivia:
        imm r0, 0x900088
        load r4, r0
        imm r2, 0x20
        add r4, r2
        imm r0, 0x900030
        load r1, r0
        store r4, r1
        call 0xa34                          ; -> validate_expression:
        imm r0, 0x900088
        load r4, r0
        imm r2, 0x28
        add r4, r2
        imm r0, 0x900030
        load r1, r0
        store r4, r1
        call 0x2dd1                         ; -> consume_close:
        imm r0, 0x900088
        load r1, r0
        imm r2, 0x30
        add r1, r2
        store r0, r1
        jmp 0x5c2                           ; -> parse_program_loop:
0x840: ; parse_entry:
        imm r0, 0x900090
        load r1, r0
        imm r2, 0x0
        jeq r1, r2, 0x86b                   ; -> parse_entry_new:
        jmp 0x3489                          ; -> gamma_invalid:
0x86b: ; parse_entry_new:
        call 0x2f70                         ; -> next_token:
        call 0x2c09                         ; -> require_lower_name:
        imm r0, 0x900038
        load r1, r0
        imm r0, 0x900078
        store r0, r1
        imm r0, 0x900040
        load r1, r0
        imm r0, 0x900080
        store r0, r1
        call 0x2dd1                         ; -> consume_close:
        imm r0, 0x900090
        imm r1, 0x1
        store r0, r1
        jmp 0x5c2                           ; -> parse_program_loop:
0x8da: ; parse_program_done:
        imm r0, 0x900088
        load r1, r0
        imm r2, 0x901000
        jlt r2, r1, 0x905                   ; -> parse_have_def:
        jmp 0x3489                          ; -> gamma_invalid:
0x905: ; parse_have_def:
        imm r0, 0x900090
        load r1, r0
        imm r2, 0x1
        jeq r1, r2, 0x930                   ; -> parse_have_entry:
        jmp 0x3489                          ; -> gamma_invalid:
0x930: ; parse_have_entry:
        imm r0, 0x900078
        load r0, r0
        imm r1, 0x900080
        load r1, r1
        call 0x9ad                          ; -> find_function:
        imm r1, 0x1
        jlt r0, r1, 0x3489                  ; -> gamma_invalid:
        mov r4, r0
        imm r5, 0x900048
        imm r6, 0x6
        imm r7, 0x1
0x989: ; parse_select_entry_loop:
        load r1, r4
        store r5, r1
        imm r2, 0x8
        add r4, r2
        add r5, r2
        sub r6, r7
        jnz r6, 0x989                       ; -> parse_select_entry_loop:
0x9ac: ; parse_program_ok:
        ret

; r0/r1 function-name span. Returns its 48-byte row or zero.
0x9ad: ; find_function:
        mov r8, r0
        mov r9, r1
        imm ra, 0x901000
        imm r0, 0x900088
        load rb, r0
0x9ca: ; find_function_loop:
        jlt ra, rb, 0x9e0                   ; -> find_function_row:
        imm r0, 0x0
        ret
0x9e0: ; find_function_row:
        load r2, ra
        mov r3, ra
        imm r4, 0x8
        add r3, r4
        load r3, r3
        mov r0, r8
        mov r1, r9
        call 0x3231                         ; -> spans_equal:
        imm r1, 0x1
        jeq r0, r1, 0xa30                   ; -> find_function_found:
        imm r4, 0x30
        add ra, r4
        jmp 0x9ca                           ; -> find_function_loop:
0xa30: ; find_function_found:
        mov r0, ra
        ret

; Complete structural validation for the implemented expression subset.
0xa34: ; validate_expression:
        call 0x2e44                         ; -> skip_trivia:
        imm r0, 0x900030
        load r4, r0
        imm r0, 0x900018
        load r5, r0
        jlt r4, r5, 0xa6b                   ; -> validate_expression_byte:
        jmp 0x3489                          ; -> gamma_invalid:
0xa6b: ; validate_expression_byte:
        loadb r6, r4
        imm r7, 0x28
        jeq r6, r7, 0xaf9                   ; -> validate_expression_list:
        call 0x2f70                         ; -> next_token:
        imm r0, 0x900038
        load r4, r0
        loadb r6, r4
        imm r7, 0x23
        jeq r6, r7, 0xcb1                   ; -> validate_hex_token:
        imm r7, 0x2d
        jeq r6, r7, 0xcbb                   ; -> validate_integer_token:
        imm r7, 0x30
        jlt r6, r7, 0xcc5                   ; -> validate_identifier_token:
        imm r7, 0x3a
        jlt r6, r7, 0xcbb                   ; -> validate_integer_token:
        jmp 0xcc5                           ; -> validate_identifier_token:
0xaf9: ; validate_expression_list:
        call 0x2d5e                         ; -> consume_open:
        call 0x2f70                         ; -> next_token:
        call 0x30a3                         ; -> parse_reserved:
        imm r1, 0x1
        jeq r0, r1, 0xc5e                   ; -> validate_ternary:
        imm r1, 0x2
        jeq r0, r1, 0xc83                   ; -> validate_let:
        imm r1, 0x3
        jlt r0, r1, 0xbbb                   ; -> validate_unknown_form:
        imm r1, 0x6
        jlt r0, r1, 0xc2f                   ; -> validate_unary:
        imm r1, 0xe
        jlt r0, r1, 0xc42                   ; -> validate_binary:
        jeq r0, r1, 0xc5e                   ; -> validate_ternary:
        imm r1, 0x11
        jlt r0, r1, 0xc42                   ; -> validate_binary:
        imm r1, 0x13
        jlt r0, r1, 0xc2f                   ; -> validate_unary:
        jmp 0x34ad                          ; -> gamma_internal:
0xbbb: ; validate_unknown_form:
        imm r0, 0x900038
        load r0, r0
        loadb r0, r0
        imm r1, 0x5f
        jeq r0, r1, 0xc13                   ; -> validate_call:
        imm r1, 0x61
        jlt r0, r1, 0x3489                  ; -> gamma_invalid:
        imm r1, 0x7b
        jlt r0, r1, 0xc13                   ; -> validate_call:
        jmp 0x3489                          ; -> gamma_invalid:
0xc13: ; validate_call:
        call 0x2c09                         ; -> require_lower_name:
        call 0xa34                          ; -> validate_expression:
        call 0x2dd1                         ; -> consume_close:
        ret
0xc2f: ; validate_unary:
        call 0xa34                          ; -> validate_expression:
        call 0x2dd1                         ; -> consume_close:
        ret
0xc42: ; validate_binary:
        call 0xa34                          ; -> validate_expression:
        call 0xa34                          ; -> validate_expression:
        call 0x2dd1                         ; -> consume_close:
        ret
0xc5e: ; validate_ternary:
        call 0xa34                          ; -> validate_expression:
        call 0xa34                          ; -> validate_expression:
        call 0xa34                          ; -> validate_expression:
        call 0x2dd1                         ; -> consume_close:
        ret
0xc83: ; validate_let:
        call 0x2f70                         ; -> next_token:
        call 0x2c09                         ; -> require_lower_name:
        call 0xa34                          ; -> validate_expression:
        call 0xa34                          ; -> validate_expression:
        call 0x2dd1                         ; -> consume_close:
        ret
0xcb1: ; validate_hex_token:
        call 0x294c                         ; -> require_hex_token:
        ret
0xcbb: ; validate_integer_token:
        call 0x2aa4                         ; -> parse_integer_token:
        ret
0xcc5: ; validate_identifier_token:
        imm r0, 0x34c1
        imm r1, 0x6
        call 0x319d                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xd00                   ; -> validate_identifier_ok:
        call 0x2c09                         ; -> require_lower_name:
0xd00: ; validate_identifier_ok:
        ret

0xd01: ; evaluate_expression:
        call 0x2e44                         ; -> skip_trivia:
        imm r0, 0x900030
        load r4, r0
        imm r0, 0x900018
        load r5, r0
        jlt r4, r5, 0xd38                   ; -> evaluate_expression_byte:
        jmp 0x34ad                          ; -> gamma_internal:
0xd38: ; evaluate_expression_byte:
        loadb r6, r4
        imm r7, 0x28
        jeq r6, r7, 0xf70                   ; -> evaluate_expression_list:
        call 0x2f70                         ; -> next_token:
        imm r0, 0x900038
        load r4, r0
        loadb r6, r4
        imm r7, 0x23
        jeq r6, r7, 0xdc6                   ; -> evaluate_hex:
        imm r7, 0x2d
        jeq r6, r7, 0xe81                   ; -> evaluate_integer:
        imm r7, 0x30
        jlt r6, r7, 0xeab                   ; -> evaluate_identifier:
        imm r7, 0x3a
        jlt r6, r7, 0xe81                   ; -> evaluate_integer:
        jmp 0xeab                           ; -> evaluate_identifier:
0xdc6: ; evaluate_hex:
        call 0x294c                         ; -> require_hex_token:
        imm r0, 0x900040
        load r1, r0
        imm r2, 0x2
        sub r1, r2
        imm r2, 0x2
        div r1, r2
        imm r2, 0x0
        jeq r1, r2, 0xe59                   ; -> set_empty_bytes:
        imm r0, 0x2
        imm r2, 0x900038
        load r2, r2
        imm r3, 0x2
        add r2, r3
        imm r3, 0x0
        call 0x239e                         ; -> allocate_node:
        mov r1, r0
        imm r0, 0x2
        call 0x22d2                         ; -> set_value:
        ret
0xe59: ; set_empty_bytes:
        imm r0, 0x2
        imm r1, 0x0
        imm r2, 0x0
        call 0x22d2                         ; -> set_value:
        ret
0xe81: ; evaluate_integer:
        call 0x2aa4                         ; -> parse_integer_token:
        mov r1, r0
        imm r0, 0x1
        imm r2, 0x0
        call 0x22d2                         ; -> set_value:
        ret
0xeab: ; evaluate_identifier:
        imm r0, 0x34c1
        imm r1, 0x6
        call 0x319d                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xf48                   ; -> set_reject:
        imm r0, 0x900038
        load r0, r0
        imm r1, 0x900040
        load r1, r1
        call 0x337b                         ; -> find_binding:
        imm r1, 0x0
        jeq r0, r1, 0x3495                  ; -> gamma_authored_trap:
        mov r4, r0
        imm r5, 0x10
        add r4, r5
        load r0, r4
        imm r5, 0x8
        add r4, r5
        load r1, r4
        add r4, r5
        load r2, r4
        call 0x22d2                         ; -> set_value:
        ret
0xf48: ; set_reject:
        imm r0, 0x3
        imm r1, 0x2
        imm r2, 0x0
        call 0x22d2                         ; -> set_value:
        ret
0xf70: ; evaluate_expression_list:
        call 0x2d5e                         ; -> consume_open:
        call 0x2f70                         ; -> next_token:
        call 0x30a3                         ; -> parse_reserved:
        imm r1, 0x1
        jeq r0, r1, 0x1648                  ; -> evaluate_if:
        imm r1, 0x2
        jeq r0, r1, 0x16d6                  ; -> evaluate_let:
        imm r1, 0x3
        jeq r0, r1, 0x17f2                  ; -> evaluate_complete:
        imm r1, 0x4
        jeq r0, r1, 0x1872                  ; -> evaluate_bytes_single:
        imm r1, 0x5
        jeq r0, r1, 0x1952                  ; -> evaluate_bytes_length:
        imm r1, 0x6
        jeq r0, r1, 0x19d8                  ; -> evaluate_bytes_get:
        imm r1, 0x7
