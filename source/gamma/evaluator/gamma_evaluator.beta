; Gamma evaluator development slice, written in Beta.
;
; Implemented now:
; - exact-ended GAMMAREQ v1 loading and source-envelope validation;
; - unary function declaration rows plus one entry, selected by exact name;
; - complete structural validation for the implemented expression subset;
; - input and lowercase #x byte values;
; - Complete, Reject, bytes-single, and bytes-concat;
; - immutable raw/hex/single/concat byte nodes in the bounded value arena;
; - one-pass output whose bytes are authoritative only with status zero.
;
; Valid Gamma outside this development slice returns Incomplete. This source is
; not the canonical gamma_evaluator_bytecode.tape.

; Global words in the declaration region.
; 9437184 total request bytes
; 9437192 source start
; 9437200 source length
; 9437208 source end
; 9437216 input start
; 9437224 input length
; 9437232 cursor
; 9437240 token start
; 9437248 token length
; 9437256 def name start
; 9437264 def name length
; 9437272 parameter start
; 9437280 parameter length
; 9437288 body start
; 9437296 body end
; 9437304 entry name start
; 9437312 entry name length
; 9437320 function-row end cursor
; 9437328 have entry
; 9437336 input Bytes handle
; 9437344 arena cursor
; 9437352 value tag
; 9437360 value word zero
; 9437368 value word one
; 9437416 binding cursor

        imm rf, 0x2100000
        imm re, 0x100000
0x14: ; read_request_loop:
