        mov r1 r92
        imm r2 0x4
        add r1 r2
        jlt r80 r1 0x1f87 ; -> invalid:
        mov r0 r92
        call 0x1a7 ; -> read_u32:
        mov r81 r92
        imm r1 0x4
        add r81 r1
        mov r82 r81
        add r82 r0
        jlt r82 r81 0x1f87 ; -> invalid:
        jlt r80 r82 0x1f87 ; -> invalid:
        mov r83 r82
        mov r84 r80
        sub r84 r83
        call 0x1f3 ; -> validate_source:
        call 0xd1a ; -> census:
        mov r89 r90
        mov r8c r90
        mov r8a r96
        mov r8e r90
        call 0xec5 ; -> validate_program:
        mov r89 r90
        mov r8c r90
        mov r8a r96
        imm r8d 0x1e00000
        mov r8e r90
        mov r0 r8b
        mov r1 r8a
        mov r2 r90
        call 0x1315 ; -> enter_function:
        jlt r0 r90 0x1f93 ; -> authored_trap:
