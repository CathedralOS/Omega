        mov r1 r90
        ret

; Value stack stores evaluator intermediates and call arguments.
0x7b9: ; push_value:
        jeq r8a r97 0x1879 ; -> incomplete:
        store r8a r0
        imm r1 0x8
        add r8a r1
        ret
0x7d5: ; pop_value:
        jeq r8a r96 0x1885 ; -> internal:
        imm r1 0x8
        sub r8a r1
        load r0 r8a
        ret

; Function row is five words: name start/length, params start, body start, arity.
0x7f1: ; function_row:
        imm r1 0x28
        mul r0 r1
        add r0 r94
        ret

; r3 is a row beginning with name start/length. Match the current token.
0x802: ; row_matches_token:
        mov r4 r3
        imm r5 0x8
        add r4 r5
        load r4 r4
        jeq r4 r87 0x824 ; -> row_matches_token_begin:
        mov r0 r90
        ret
0x824: ; row_matches_token_begin:
        load r4 r3
        mov r5 r90
0x82a: ; row_matches_token_loop:
        jeq r5 r87 0x862 ; -> row_matches_token_true:
        mov r6 r4
        add r6 r5
        loadb r6 r6
        mov r7 r86
        add r7 r5
        loadb r7 r7
        jeq r6 r7 0x856 ; -> row_matches_token_next:
        mov r0 r90
        ret
0x856: ; row_matches_token_next:
