        imm r0, 0x900040
        load r1, r0
        imm r2, 0x2
        sub r1, r2
        imm r2, 0x2
        div r1, r2
        imm r2, 0x0
        jeq r1, r2, 0x1065                  ; -> set_empty_bytes:
        imm r0, 0x2
        imm r2, 0x900038
        load r2, r2
        imm r3, 0x2
        add r2, r3
        imm r3, 0x0
        call 0x24b1                         ; -> allocate_node:
        mov r1, r0
        imm r0, 0x2
        call 0x23e5                         ; -> set_value:
        ret
0x1065: ; set_empty_bytes:
        imm r0, 0x2
        imm r1, 0x0
        imm r2, 0x0
        call 0x23e5                         ; -> set_value:
        ret
0x108d: ; evaluate_integer:
        call 0x2b1a                         ; -> parse_integer_token:
        mov r1, r0
