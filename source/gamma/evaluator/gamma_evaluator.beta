        mov r2 r0
        add r2 r91
        loadb r3 r2
        imm r4 0x100
        mul r3 r4
        add r1 r3
        add r2 r91
        loadb r3 r2
        imm r4 0x10000
        mul r3 r4
        add r1 r3
        add r2 r91
        loadb r3 r2
        imm r4 0x1000000
        mul r3 r4
        add r1 r3
        mov r0 r1
        ret

0x1f3: ; validate_source:
