        imm r8, 0x8
        add r6, r8
        store r6, r1
        add r6, r8
        store r6, r2
        add r6, r8
        store r6, r3
        add r6, r8
        store r6, r4
        store r5, r7
        ret

0x3244: ; pop_binding:
