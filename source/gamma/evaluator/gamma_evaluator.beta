        jlt r0 r1 0x188 ; -> main_write:
        jmp 0x1f93 ; -> authored_trap:
0x188: ; main_write:
        call 0x196 ; -> write_output:
        mov r0 r90
        halt r0

0x196: ; write_output:
        jeq rb0 rb1 0x1f9f ; -> incomplete:
        write r0
        add rb0 r91
        ret

; r0 points to four little-endian bytes; returns u32 in r0.
0x1a7: ; read_u32:
