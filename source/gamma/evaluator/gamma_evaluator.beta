        imm r1, 0x9
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe80                   ; -> validate_binary:
        imm r0, 0x35f0
        imm r1, 0x1
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe80                   ; -> validate_binary:
        imm r0, 0x35f1
        imm r1, 0x1
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe80                   ; -> validate_binary:
        imm r0, 0x35f2
        imm r1, 0x1
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe80                   ; -> validate_binary:
        imm r0, 0x35f3
        imm r1, 0x1
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe80                   ; -> validate_binary:
        imm r0, 0x35f4
        imm r1, 0x1
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe80                   ; -> validate_binary:
        imm r0, 0x35f5
        imm r1, 0x1
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe80                   ; -> validate_binary:
        imm r0, 0x35f6
        imm r1, 0x1
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe80                   ; -> validate_binary:
        imm r0, 0x35f7
        imm r1, 0xb
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe9c                   ; -> validate_ternary:
        imm r0, 0x3602
