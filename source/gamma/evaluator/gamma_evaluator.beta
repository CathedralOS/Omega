; r0/r1 function-name span. Returns its 48-byte row or zero.
0x9ad: ; find_function:
        mov r8, r0
        mov r9, r1
        imm ra, 0x901000
        imm r0, 0x900088
        load rb, r0
0x9ca: ; find_function_loop:
        jlt ra, rb, 0x9e0                   ; -> find_function_row:
        imm r0, 0x0
        ret
0x9e0: ; find_function_row:
        load r2, ra
        mov r3, ra
        imm r4, 0x8
        add r3, r4
        load r3, r3
        mov r0, r8
        mov r1, r9
        call 0x332c                         ; -> spans_equal:
        imm r1, 0x1
        jeq r0, r1, 0xa30                   ; -> find_function_found:
        imm r4, 0x30
        add ra, r4
        jmp 0x9ca                           ; -> find_function_loop:
0xa30: ; find_function_found:
        mov r0, ra
        ret

; Complete structural validation for the implemented expression subset.
0xa34: ; validate_expression:
        call 0x3039                         ; -> skip_trivia:
        imm r0, 0x900030
        load r4, r0
        imm r0, 0x900018
        load r5, r0
        jlt r4, r5, 0xa6b                   ; -> validate_expression_byte:
        jmp 0x3584                          ; -> gamma_invalid:
0xa6b: ; validate_expression_byte:
        loadb r6, r4
        imm r7, 0x28
        jeq r6, r7, 0xaf9                   ; -> validate_expression_list:
        call 0x3165                         ; -> next_token:
        imm r0, 0x900038
        load r4, r0
        loadb r6, r4
        imm r7, 0x23
        jeq r6, r7, 0xeef                   ; -> validate_hex_token:
        imm r7, 0x2d
        jeq r6, r7, 0xef9                   ; -> validate_integer_token:
        imm r7, 0x30
        jlt r6, r7, 0xf03                   ; -> validate_identifier_token:
        imm r7, 0x3a
        jlt r6, r7, 0xef9                   ; -> validate_integer_token:
        jmp 0xf03                           ; -> validate_identifier_token:
0xaf9: ; validate_expression_list:
        call 0x2f53                         ; -> consume_open:
        call 0x3165                         ; -> next_token:
        imm r0, 0x35bc
        imm r1, 0x2
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe9c                   ; -> validate_ternary:
        imm r0, 0x35be
        imm r1, 0x3
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xec1                   ; -> validate_let:
        imm r0, 0x35c1
        imm r1, 0x8
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe6d                   ; -> validate_unary:
        imm r0, 0x35cf
        imm r1, 0xc
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe6d                   ; -> validate_unary:
        imm r0, 0x35db
        imm r1, 0xc
        call 0x3298                         ; -> token_equals:
        imm r1, 0x1
        jeq r0, r1, 0xe6d                   ; -> validate_unary:
