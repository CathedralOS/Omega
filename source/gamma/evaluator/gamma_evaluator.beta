        jlt r0, r1, 0x3584                  ; -> gamma_invalid:
        mov r4, r0
        imm r5, 0x900048
        imm r6, 0x6
        imm r7, 0x1
0x989: ; parse_select_entry_loop:
        load r1, r4
        store r5, r1
        imm r2, 0x8
        add r4, r2
        add r5, r2
        sub r6, r7
        jnz r6, 0x989                       ; -> parse_select_entry_loop:
0x9ac: ; parse_program_ok:
