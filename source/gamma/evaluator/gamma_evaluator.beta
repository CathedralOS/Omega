        sub r0 r3
        mov r1 r91
        ret
0x6e8: ; parse_integer_positive:
        mov r0 r3
        mov r1 r91
        ret
0x6ef: ; parse_integer_fail:
        mov r0 r90
        mov r1 r90
        ret

; Tokenization has established 'X' or one closed escape: \n or \s.
0x6f6: ; parse_character:
        imm r2 0x3
        jeq r87 r2 0x729 ; -> parse_character_simple:
        imm r2 0x4
        jeq r87 r2 0x74b ; -> parse_character_escape:
        jmp 0x7b2 ; -> parse_character_fail:
0x729: ; parse_character_simple:
        mov r0 r86
        add r0 r91
        loadb r0 r0
        imm r2 0x27
        jeq r0 r2 0x7b2 ; -> parse_character_fail:
        mov r1 r91
        ret
0x74b: ; parse_character_escape:
