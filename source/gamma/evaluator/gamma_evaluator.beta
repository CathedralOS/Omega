        call 0x7f1 ; -> function_row:
        mov r3 r0
        call 0x802 ; -> row_matches_token:
        jnz r0 0x8a2 ; -> find_function_present:
0x896: ; find_function_next:
        add r2 r91
        jmp 0x869 ; -> find_function_loop:
0x8a2: ; find_function_present:
        mov r0 r3
        ret
0x8a6: ; find_function_absent:
