        jlt r6, r7, 0x10b7                  ; -> evaluate_identifier:
        imm r7, 0x3a
        jlt r6, r7, 0x108d                  ; -> evaluate_integer:
        jmp 0x10b7                          ; -> evaluate_identifier:
