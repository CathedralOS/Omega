        add r3, r4
        load r3, r3
        mov r0, r8
        mov r1, r9
        call 0x2fed                         ; -> spans_equal:
        imm r1, 0x1
        jeq r0, r1, 0x3283                  ; -> gamma_authored_trap:
        imm r4, 0x28
        add ra, r4
        jmp 0x3110                          ; -> require_fresh_local_loop:

; r0 name start, r1 name length. Returns binding row or zero.
0x316c: ; find_binding:
        mov r8, r0
        mov r9, r1
        imm ra, 0x1100000
        imm r0, 0x9000e8
        load rb, r0
0x3189: ; find_binding_loop:
