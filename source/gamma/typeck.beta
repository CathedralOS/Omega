; typeck.beta - a pre-contract Gamma static-semantics oracle, written in Beta.
;
; This program exercises candidate monomorphic type rules. It is not a proof
; kernel, a selected executable Gamma contract, or a compiler stage. The selected
; Gamma contract decides which rules enter the Beta-written Gamma compiler and
; whether this standalone parser/checker is then deleted.
;
; Phase 1: builtin Int + top-level functions with typed params and a declared return
; type; arithmetic/comparisons are Int x Int -> Int, `if` wants an Int condition and
; equal branches, `let` binds the synthesised type, a call checks arg types + arity.
; Phase 2: data declarations (ADTs) + `match`.
;
; Surface (prefix; Int is builtin, every binder annotated):
;   program := (data T (C TYPE...)...)*  (def NAME ((PARAM TYPE)...) RETTYPE EXPR)*
; Output: every function well-typed -> exit 1 ; a type error -> exit 0.
;
; CONTROL FLOW is CFG/Omega-shaped: each proc is a set of `state` basic blocks linked
; by guarded `to ... when ...` transitions - no if/while.
;
; Memory:  2097152 SRC  2097144 CUR  2097136 LEN  2097128 APTR  2097120 NFUN
;          2097112 TENVN 2097104 NTY 2097096 NCON 2097088 INVALID_TYPE
;          16777216 ARENA (~48 MB)
;          4194304 FUNS
;          4259840 TYNAMES  4325376 CONS  5242880 TENV
; "type" = small id: Int = 0. AST nodes 4 words. Func entry 4 words
; [name_off, params, ret_tyid, body]; PARAM node [50, name_off, tyid]. TENV [var_off, tyid].
; AST tags: 0 INT 1 VAR 2 PRIM 3 IF 4 LET 5 CALL 6 CONS 7 CONAPP 8 MATCH
;           9 PVAR 10 PCON 11 ARM 50 PARAM

proc slurp() {
    let n = 0
    let c = read_byte()
    state loop {
        to body when (c >= 0)
        to done
    }
    state body {
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
        to loop
    }
    state done {
        word[2097136] = n
        word[2097144] = 0
        word[2097128] = 16777216 ; Match interp.beta's non-overlapping arena. The old
                                 ; 1 MB arena overwrote FUNS while checking complete
                                 ; canonical decoders with monomorphic result ADTs.
        word[2097120] = 0        ; NFUN
        word[2097112] = 0        ; TENVN
        word[2097104] = 1        ; NTY (id 0 = builtin Int)
        word[2097096] = 0        ; NCON
        word[2097088] = 0        ; INVALID_TYPE
    }
}

proc cbyte() {
    let i = word[2097144]
    state chk { to hit when (i < word[2097136])  return 0 }
    state hit { return byte[2097152 + i] }
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

proc is_space(c) {
    state c1 { to yes when (c == ' ')  to c2 }
    state c2 { to yes when (c == 9)    to c3 }
    state c3 { to yes when (c == 10)   to c4 }
    state c4 { to yes when (c == 13)   return 0 }
    state yes { return 1 }
}

proc skip_ws() {
    let go = 1
    state loop {
        to done when (go == 0)
        let c = cbyte()
        to sp when (is_space(c) == 1)
        to semi
    }
    state sp { adv()  to loop }
    state semi {
        to cmt when (c == ';')
        go = 0
        to loop
    }
    state cmt {
        to loop when (cbyte() == 10)
        to ceof when (cbyte() == 0)
        adv()
        to cmt
    }
    state ceof { return 0 }
    state done { return 0 }
}

proc is_digit(c) {
    state c1 { to no when (c < '0')  to c2 }
    state c2 { to no when (c > '9')  return 1 }
    state no { return 0 }
}

proc is_delim(c) {
    state c1 { to yes when (is_space(c) == 1)  to c2 }
    state c2 { to yes when (c == '(')  to c3 }
    state c3 { to yes when (c == ')')  to c4 }
    state c4 { to yes when (c == 0)    return 0 }
    state yes { return 1 }
}

proc is_op(c) {
    state c1 { to yes when (c == '+')  to c2 }
    state c2 { to yes when (c == '-')  to c3 }
    state c3 { to yes when (c == '*')  to c4 }
    state c4 { to yes when (c == '/')  to c5 }
    state c5 { to yes when (c == '%')  return 0 }
    state yes { return 1 }
}

proc skip_ident() {
    state loop {
        to body when (is_delim(cbyte()) == 0)
        return 0
    }
    state body { adv()  to loop }
}

proc parse_number() {
    let v = 0
    state loop {
        to body when (is_digit(cbyte()) == 1)
        return v
    }
    state body { v = v * 10 + (cbyte() - '0')  adv()  to loop }
}

proc alloc(tag, f0, f1, f2) {
    let p = word[2097128]
    word[p] = tag
    word[p + 8] = f0
    word[p + 16] = f1
    word[p + 24] = f2
    word[2097128] = p + 32
    return p
}

proc name_eq(o1, o2) {
    let i = 0
    state loop {
        let c1 = byte[2097152 + o1 + i]
        let c2 = byte[2097152 + o2 + i]
        to end1 when (is_delim(c1) == 1)
        to end2 when (is_delim(c2) == 1)
        to diff when (c1 != c2)
        i = i + 1
        to loop
    }
    state end1 { return is_delim(c2) }
    state end2 { return 0 }
    state diff { return 0 }
}

proc name_is2(off, a, b) {
    state c1 { to c2 when (byte[2097152 + off] == a)  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == b)  return 0 }
    state c3 { to yes when (is_delim(byte[2097152 + off + 2]) == 1)  return 0 }
    state yes { return 1 }
}

proc name_is3(off, a, b, c) {
    state c1 { to c2 when (byte[2097152 + off] == a)  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == b)  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == c)  return 0 }
    state c4 { to yes when (is_delim(byte[2097152 + off + 3]) == 1)  return 0 }
    state yes { return 1 }
}

proc is_upper(c) {
    state c1 { to no when (c < 'A')  to c2 }
    state c2 { to no when (c > 'Z')  return 1 }
    state no { return 0 }
}

proc is_match_kw(off) {
    state c1 { to c2 when (byte[2097152 + off] == 'm')  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == 'a')  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == 't')  return 0 }
    state c4 { to c5 when (byte[2097152 + off + 3] == 'c')  return 0 }
    state c5 { to c6 when (byte[2097152 + off + 4] == 'h')  return 0 }
    state c6 { to yes when (is_delim(byte[2097152 + off + 5]) == 1)  return 0 }
    state yes { return 1 }
}

; resolve a type name to a type id: Int = 0, else a declared data type, else -1.
proc tyid(off) {
    state intchk { to scan when (name_is3(off, 'I', 'n', 't') == 0)  return 0 }
    state scan {
        let n = word[2097104]
        let i = 1
        to loop
    }
    state loop {
        to body when (i < n)
        to missing
    }
    state body {
        to hit when (name_eq(off, word[4259840 + i * 8]) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
    state missing {
        word[2097088] = 1
        return 0 - 1
    }
}

proc con_lookup(coff) {              ; constructor index by name, or -1
    let n = word[2097096]
    let i = 0
    state loop {
        to body when (i < n)
        return 0 - 1
    }
    state body {
        to hit when (name_eq(coff, word[4325376 + i * 24]) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
}

; ---- parser (core expressions) ----

proc parse_args() {
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        let h = parse_expr()
        let t = parse_args()
        return alloc(6, h, t, 0)
    }
}

proc parse_expr() {
    skip_ws()
    let c = cbyte()
    state num { to do_num when (is_digit(c) == 1)  to lparen }
    state do_num { return alloc(0, parse_number(), 0, 0) }
    state lparen { to compound when (c == '(')  to atom }
    state compound {
        adv()
        skip_ws()
        let h = cbyte()
        to do_op when (is_op(h) == 1)
        to head
    }
    state do_op {
        adv()
        let a = parse_expr()
        let b = parse_expr()
        skip_ws()
        adv()
        return alloc(2, h, a, b)
    }
    state head {
        let hoff = word[2097144]
        skip_ident()
        to do_if when (name_is2(hoff, 'i', 'f') == 1)
        to k_let
    }
    state do_if {
        let c1 = parse_expr()
        let t1 = parse_expr()
        let e1 = parse_expr()
        skip_ws()
        adv()
        return alloc(3, c1, t1, e1)
    }
    state k_let { to do_let when (name_is3(hoff, 'l', 'e', 't') == 1)  to k_eq }
    state do_let {
        skip_ws()
        let noff = word[2097144]
        skip_ident()
        let e2 = parse_expr()
        let body = parse_expr()
        skip_ws()
        adv()
        return alloc(4, noff, e2, body)
    }
    state k_eq { to do_eq when (name_is2(hoff, 'e', 'q') == 1)  to k_lt }
    state do_eq {
        let a2 = parse_expr()
        let b2 = parse_expr()
        skip_ws()
        adv()
        return alloc(2, 'e', a2, b2)
    }
    state k_lt { to do_lt when (name_is2(hoff, 'l', 't') == 1)  to k_match }
    state do_lt {
        let a3 = parse_expr()
        let b3 = parse_expr()
        skip_ws()
        adv()
        return alloc(2, 'l', a3, b3)
    }
    state k_match { to do_match when (is_match_kw(hoff) == 1)  to k_con }
    state do_match {
        let scrut = parse_expr()
        let arms = parse_arms()
        skip_ws()
        adv()
        return alloc(8, scrut, arms, 0)
    }
    state k_con { to do_con when (is_upper(byte[2097152 + hoff]) == 1)  to do_call }
    state do_con {
        let cargs = parse_args()
        skip_ws()
        adv()
        return alloc(7, hoff, cargs, 0)
    }
    state do_call {
        let args = parse_args()
        skip_ws()
        adv()
        return alloc(5, hoff, args, 0)
    }
    state atom {
        let voff = word[2097144]
        skip_ident()
        to nullcon when (is_upper(byte[2097152 + voff]) == 1)
        return alloc(1, voff, 0, 0)
    }
    state nullcon { return alloc(7, voff, 0, 0) }     ; nullary constructor
}

proc parse_pvars() {
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        let voff = word[2097144]
        skip_ident()
        let t = parse_pvars()
        return alloc(6, voff, t, 0)
    }
}

proc parse_pat() {
    skip_ws()
    state chk { to pcon when (cbyte() == '(')  to atom }
    state pcon {
        adv()
        skip_ws()
        let coff = word[2097144]
        skip_ident()
        let vars = parse_pvars()
        skip_ws()
        adv()
        return alloc(10, coff, vars, 0)               ; PCON
    }
    state atom {
        let voff = word[2097144]
        skip_ident()
        to nullcon when (is_upper(byte[2097152 + voff]) == 1)
        return alloc(9, voff, 0, 0)                   ; PVAR
    }
    state nullcon { return alloc(10, voff, 0, 0) }    ; nullary constructor pattern
}

proc parse_arms() {
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        adv()
        let pat = parse_pat()
        let body = parse_expr()
        skip_ws()
        adv()
        let t = parse_arms()
        return alloc(6, alloc(11, pat, body, 0), t, 0)
    }
}

proc parse_typed_params() {       ; (pname Ty) pairs until ')', CONS of PARAM nodes
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        adv()                     ; '('
        skip_ws()
        let poff = word[2097144]
        skip_ident()
        skip_ws()
        let toff = word[2097144]
        skip_ident()
        skip_ws()
        adv()                     ; ')'
        let node = alloc(50, poff, tyid(toff), 0)
        let t = parse_typed_params()
        return alloc(6, node, t, 0)
    }
}

proc parse_def() {
    adv()                         ; '('
    skip_ws()
    skip_ident()                  ; "def"
    skip_ws()
    let noff = word[2097144]
    skip_ident()
    skip_ws()
    adv()                         ; '(' param list
    let params = parse_typed_params()
    skip_ws()
    adv()                         ; ')' end params
    skip_ws()
    let rtoff = word[2097144]
    skip_ident()
    let rtid = tyid(rtoff)
    let body = parse_expr()
    skip_ws()
    adv()                         ; ')' end def
    let i = word[2097120]
    word[4194304 + i * 32] = noff
    word[4194304 + i * 32 + 8] = params
    word[4194304 + i * 32 + 16] = rtid
    word[4194304 + i * 32 + 24] = body
    word[2097120] = i + 1
    return 0
}

proc parse_argtypes() {           ; constructor arg type names until ')', CONS of tyids
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        let toff = word[2097144]
        skip_ident()
        let t = parse_argtypes()
        return alloc(6, tyid(toff), t, 0)
    }
}

proc parse_data() {               ; (data T (C ArgTy...)...) -> register type + cons
    adv()                         ; '('
    skip_ws()
    skip_ident()                  ; "data"
    skip_ws()
    let toff = word[2097144]
    skip_ident()
    let tid = word[2097104]        ; register the type first (self-recursion resolves)
    word[4259840 + tid * 8] = toff
    word[2097104] = tid + 1
    skip_ws()
    state loop {
        to body when (cbyte() != ')')
        to done
    }
    state body {
        adv()                     ; '(' constructor
        skip_ws()
        let coff = word[2097144]
        skip_ident()
        let argtys = parse_argtypes()
        skip_ws()
        adv()                     ; ')'
        let ci = word[2097096]
        word[4325376 + ci * 24] = coff
        word[4325376 + ci * 24 + 8] = tid
        word[4325376 + ci * 24 + 16] = argtys
        word[2097096] = ci + 1
        skip_ws()
        to loop
    }
    state done { adv()  return 0 }   ; ')' end data
}

proc is_data() {
    state chk { to paren when (cbyte() == '(')  return 0 }
    state paren {
        let save = word[2097144]
        adv()
        skip_ws()
        let o = word[2097144]
        word[2097144] = save         ; peek only
        to c1 when (byte[2097152 + o] == 'd')
        return 0
    }
    state c1 { to c2 when (byte[2097152 + o + 1] == 'a')  return 0 }
    state c2 { to c3 when (byte[2097152 + o + 2] == 't')  return 0 }
    state c3 { to c4 when (byte[2097152 + o + 3] == 'a')  return 0 }
    state c4 { to yes when (is_delim(byte[2097152 + o + 4]) == 1)  return 0 }
    state yes { return 1 }
}

proc is_def() {
    state chk { to paren when (cbyte() == '(')  return 0 }
    state paren {
        let save = word[2097144]
        adv()
        skip_ws()
        let r = name_is3(word[2097144], 'd', 'e', 'f')
        word[2097144] = save
        return r
    }
}

proc fun_lookup(noff) {
    let n = word[2097120]
    let i = 0
    state loop {
        to body when (i < n)
        return 0 - 1
    }
    state body {
        to hit when (name_eq(noff, word[4194304 + i * 32]) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
}

; ---- type environment (var -> tyid), frame-local lookup ----

proc tenv_push(off, t) {
    let n = word[2097112]
    word[5242880 + n * 16] = off
    word[5242880 + n * 16 + 8] = t
    word[2097112] = n + 1
}

proc tenv_lookup(qoff) {
    let j = word[2097112] - 1
    let result = 0 - 1
    state loop {
        to body when (j >= 0)
        return result
    }
    state body {
        to hit when (name_eq(qoff, word[5242880 + j * 16]) == 1)
        j = j - 1
        to loop
    }
    state hit {
        result = word[5242880 + j * 16 + 8]
        return result
    }
}

; ---- the type checker: tc(expr) -> tyid, or -1 on a type error ----

proc tc_call(fname, args) {
    let fi = fun_lookup(fname)
    state fchk { to known when (fi != 0 - 1)  return 0 - 1 }   ; unknown function
    state known {
        let p = word[4194304 + fi * 32 + 8]
        let a = args
        let fail = 0
        to loop
    }
    state loop {
        to pdone when (p == 0)
        to achk
    }
    state achk {
        to adone when (a == 0)
        let pty = word[word[p + 8] + 16]
        to mark when (tc(word[a + 8]) != pty)
        to advance
    }
    state mark { fail = 1  to advance }
    state advance { p = word[p + 16]  a = word[a + 16]  to loop }
    state pdone { to overmark when (a != 0)  to finish }       ; too many args
    state adone { fail = 1  to finish }                        ; p != 0: too few
    state overmark { fail = 1  to finish }
    state finish {
        to failret when (fail == 1)
        return word[4194304 + fi * 32 + 16]
    }
    state failret { return 0 - 1 }
}

proc tc_conapp(coff, args) {
    let ci = con_lookup(coff)
    state cchk { to known when (ci != 0 - 1)  return 0 - 1 }   ; unknown constructor
    state known {
        let p = word[4325376 + ci * 24 + 16]
        let a = args
        let fail = 0
        to loop
    }
    state loop {
        to pdone when (p == 0)
        to achk
    }
    state achk {
        to adone when (a == 0)
        to mark when (tc(word[a + 8]) != word[p + 8])
        to advance
    }
    state mark { fail = 1  to advance }
    state advance { p = word[p + 16]  a = word[a + 16]  to loop }
    state pdone { to overmark when (a != 0)  to finish }
    state adone { fail = 1  to finish }
    state overmark { fail = 1  to finish }
    state finish {
        to failret when (fail == 1)
        return word[4325376 + ci * 24 + 8]
    }
    state failret { return 0 - 1 }
}

proc tc_match(scrut, arms) {
    let st = tc(scrut)
    state schk { to ok when (st != 0 - 1)  return 0 - 1 }
    state ok {
        let arm = arms
        let rty = 0 - 2                ; -2 = result type not yet seen
        let fail = 0
        to loop
    }
    state loop {
        to armbody when (arm != 0)
        to finish
    }
    state armbody {
        let armnode = word[arm + 8]
        let pat = word[armnode + 8]
        let base = word[2097112]
        to pvar when (word[pat] == 9)
        to pcon
    }
    state pvar { tenv_push(word[pat + 8], st)  to checkbody }
    state pcon {
        let ci = con_lookup(word[pat + 8])
        to badcon when (ci == 0 - 1)
        to tymatch
    }
    state badcon { fail = 1  to checkbody }
    state tymatch {
        to badty when (word[4325376 + ci * 24 + 8] != st)
        to bindvars
    }
    state badty { fail = 1  to checkbody }
    state bindvars {
        let pv = word[pat + 16]
        let av = word[4325376 + ci * 24 + 16]
        to bindloop
    }
    state bindloop {
        to bindpv when (pv != 0)
        to bindrest                   ; pv == 0
    }
    state bindpv {
        to bindav0 when (av == 0)     ; too many pattern vars
        tenv_push(word[pv + 8], word[av + 8])
        pv = word[pv + 16]
        av = word[av + 16]
        to bindloop
    }
    state bindav0 { fail = 1  to checkbody }
    state bindrest {
        to bindavmark when (av != 0)  ; too few pattern vars
        to checkbody
    }
    state bindavmark { fail = 1  to checkbody }
    state checkbody {
        let bt = tc(word[armnode + 16])
        word[2097112] = base
        to btfail when (bt == 0 - 1)
        to rtychk
    }
    state btfail { fail = 1  to rtychk }
    state rtychk {
        to setrty when (rty == 0 - 2)
        to cmprty
    }
    state setrty { rty = bt  to nextarm }
    state cmprty {
        to rtymark when (bt != rty)
        to nextarm
    }
    state rtymark { fail = 1  to nextarm }
    state nextarm { arm = word[arm + 16]  to loop }
    state finish {
        to failret when (fail == 1)
        return rty
    }
    state failret { return 0 - 1 }
}

proc tc(expr) {
    let tag = word[expr]
    state t0 { to ret_int when (tag == 0)  to t1 }
    state ret_int { return 0 }                       ; INT : Int
    state t1 { to ret_var when (tag == 1)  to t2 }
    state ret_var { return tenv_lookup(word[expr + 8]) }   ; VAR
    state t2 { to prim when (tag == 2)  to t3 }
    state prim {                                      ; PRIM : Int x Int -> Int
        let a = tc(word[expr + 16])
        let b = tc(word[expr + 24])
        to prim_a when (a == 0)
        return 0 - 1
    }
    state prim_a {
        to prim_int when (b == 0)
        return 0 - 1
    }
    state prim_int { return 0 }
    state t3 { to ifexpr when (tag == 3)  to t4 }
    state ifexpr {                                    ; IF : cond Int, branches equal
        let c = tc(word[expr + 8])
        let t = tc(word[expr + 16])
        let e = tc(word[expr + 24])
        to if_cond when (c == 0)
        return 0 - 1
    }
    state if_cond {
        to if_eq when (t == e)
        return 0 - 1
    }
    state if_eq { return t }
    state t4 { to letexpr when (tag == 4)  to t5 }
    state letexpr {                                   ; LET : bind the synthesised type
        let vt = tc(word[expr + 16])
        to let_ok when (vt != 0 - 1)
        return 0 - 1
    }
    state let_ok {
        tenv_push(word[expr + 8], vt)
        let r = tc(word[expr + 24])
        word[2097112] = word[2097112] - 1
        return r
    }
    state t5 { to callexpr when (tag == 5)  to t7 }
    state callexpr { return tc_call(word[expr + 8], word[expr + 16]) }
    state t7 { to conapp when (tag == 7)  to t8 }
    state conapp { return tc_conapp(word[expr + 8], word[expr + 16]) }
    state t8 { to matchexpr when (tag == 8)  return 0 - 1 }
    state matchexpr { return tc_match(word[expr + 8], word[expr + 16]) }
}

proc main() {
    slurp()
    skip_ws()
    state dataloop {
        to databody when (is_data() == 1)
        to defloop
    }
    state databody { parse_data()  skip_ws()  to dataloop }
    state defloop {
        to defbody when (is_def() == 1)
        to checkfns
    }
    state defbody { parse_def()  skip_ws()  to defloop }
    state checkfns {
        let ok = 1
        let i = 0
        to invalid_type when (word[2097088] != 0)
        to floop
    }
    state invalid_type { ok = 0  to floop }
    state floop {
        to fbody when (i < word[2097120])
        return ok
    }
    state fbody {
        let base = word[2097112]
        let p = word[4194304 + i * 32 + 8]
        to ploop
    }
    state ploop {
        to pbody when (p != 0)
        to docheck
    }
    state pbody {
        tenv_push(word[word[p + 8] + 8], word[word[p + 8] + 16])
        p = word[p + 16]
        to ploop
    }
    state docheck {
        to okmark when (tc(word[4194304 + i * 32 + 24]) != word[4194304 + i * 32 + 16])
        to advance
    }
    state okmark { ok = 0  to advance }
    state advance {
        word[2097112] = base
        i = i + 1
        to floop
    }
}
