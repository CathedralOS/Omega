; typeck.beta - a temporary Gamma static-semantics oracle, written in Beta.
;
; This program exercises candidate monomorphic type rules. It is not a proof
; kernel or a compiler stage. D16 selects the executable Gamma contract; this
; candidate material must be absorbed by the Beta-written Gamma compiler and the
; standalone parser/checker then deleted when its last unique gate is subsumed.
;
; Builtin Int/Bytes + top-level functions with typed params and a declared return
; type; arithmetic/comparisons are Int x Int -> Int, `if` wants an Int condition and
; equal branches, `let` binds the synthesised type, a call checks arg types + arity,
; and the six closed Bytes primitives have their D16 signatures. Data declarations
; (ADTs) and exhaustive `match` provide the nominal surface.
;
; Surface (prefix; Int is builtin, every binder annotated):
;   program := (data T (C TYPE...)...)*  (def NAME ((PARAM TYPE)...) RETTYPE EXPR)*
; Output: every function well-typed -> exit 1 ; a type error -> exit 0.
;
; CONTROL FLOW is CFG/Omega-shaped: each proc is a set of `state` basic blocks linked
; by guarded `to ... when ...` transitions - no if/while.
;
; Memory:  2097152 SRC  2097144 CUR  2097136 LEN  2097128 APTR  2097120 NFUN
;          2097112 TENVN 2097104 NTY 2097096 NCON 2097088 INVALID_TYPE
;          2097080 MATCH_EPOCH
;          6291456 TYNAMES [6 MiB,6.5 MiB)
;          6815744 CONS [6.5 MiB,8 MiB)  8388608 FUNS [8 MiB,9 MiB)
;          9437184 TENV [9 MiB,10 MiB)  10485760 COVERAGE [10 MiB,10.5 MiB)
;          16777216 ERROR_NODE + ARENA [16 MiB,64 MiB)
; "type" = small id: Int = 0, Bytes = 1, nominal types start at 2.
; AST nodes 4 words. Func entry 4 words
; [name_off, params, ret_tyid, body]; PARAM node [50, name_off, tyid]. TENV [var_off, tyid].
; AST tags: 0 INT 1 VAR 2 PRIM 3 IF 4 LET 5 CALL 6 CONS 7 CONAPP 8 MATCH
;           9 PVAR 10 PCON 11 ARM 50 PARAM

proc source_byte_allowed(c) {
    state ht { to yes when (c == 9)  to lf }
    state lf { to yes when (c == 10)  to cr }
    state cr { to yes when (c == 13)  to printable_low }
    state printable_low { to no when (c < 32)  to printable_high }
    state printable_high { to no when (c > 126)  return 1 }
    state yes { return 1 }
    state no { return 0 }
}

proc slurp() {
    let n = 0
    let c = read_byte()
    state loop {
        to body when (c >= 0)
        to done
    }
    state body {
        to exhausted when (n == 4194304)
        to invalid when (source_byte_allowed(c) == 0)
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
        to loop
    }
    state done {
        word[2097136] = n
        word[2097144] = 0
        ; Keep one readable zero node as the return value of a failed allocation.
        ; The real arena begins after it and grows to the 64 MiB raw-memory edge.
        word[16777216] = 0
        word[16777224] = 0
        word[16777232] = 0
        word[16777240] = 0
        word[2097128] = 16777248
        word[2097120] = 0        ; NFUN
        word[2097112] = 0        ; TENVN
        word[2097104] = 2        ; NTY (id 0 = Int, id 1 = Bytes)
        word[2097096] = 0        ; NCON
        word[2097088] = 0        ; INVALID_TYPE
        word[2097080] = 0        ; MATCH_EPOCH
        return 0
    }
    state invalid { return 1 }
    state exhausted { return 2 }
}

proc cbyte() {
    let i = word[2097144]
    state chk { to hit when (i < word[2097136])  return 0 }
    state hit { return byte[2097152 + i] }
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

proc is_space(c) {
    state c1 { to yes when (c == ' ')  to c2 }
    state c2 { to yes when (c == 9)    to c3 }
    state c3 { to yes when (c == 10)   to c4 }
    state c4 { to yes when (c == 13)   return 0 }
    state yes { return 1 }
}

proc skip_ws() {
    let go = 1
    state loop {
        to done when (go == 0)
        let c = cbyte()
        to sp when (is_space(c) == 1)
        to semi
    }
    state sp { adv()  to loop }
    state semi {
        to cmt when (c == ';')
        go = 0
        to loop
    }
    state cmt {
        to loop when (cbyte() == 10)
        to loop when (cbyte() == 13)
        to ceof when (cbyte() == 0)
        adv()
        to cmt
    }
    state ceof { return 0 }
    state done { return 0 }
}

proc is_digit(c) {
    state c1 { to no when (c < '0')  to c2 }
    state c2 { to no when (c > '9')  return 1 }
    state no { return 0 }
}

proc is_ident_start(c) {
    state underscore { to yes when (c == '_')  to upper_low }
    state upper_low { to lower_low when (c < 'A')  to upper_high }
    state upper_high { to yes when (c <= 'Z')  to lower_low }
    state lower_low { to no when (c < 'a')  to lower_high }
    state lower_high { to no when (c > 'z')  return 1 }
    state yes { return 1 }
    state no { return 0 }
}

proc is_ident_continue(c) {
    state start { to yes when (is_ident_start(c) == 1)  to digit }
    state digit { to yes when (is_digit(c) == 1)  return 0 }
    state yes { return 1 }
}

proc is_op(c) {
    state c1 { to yes when (c == '+')  to c2 }
    state c2 { to yes when (c == '-')  to c3 }
    state c3 { to yes when (c == '*')  to c4 }
    state c4 { to yes when (c == '/')  to c5 }
    state c5 { to yes when (c == '%')  return 0 }
    state yes { return 1 }
}

proc skip_ident() {
    state first {
        to body when (is_ident_start(cbyte()) == 1)
        return 0
    }
    state loop {
        to body when (is_ident_continue(cbyte()) == 1)
        return 0
    }
    state body { adv()  to loop }
}

proc mark_invalid() {
    word[2097088] = 1
    return 0
}

proc take_ident() {
    skip_ws()
    let off = word[2097144]
    state valid {
        to consume when (is_ident_start(cbyte()) == 1)
        to invalid
    }
    state consume { skip_ident()  return off }
    state invalid {
        mark_invalid()
        to advance_bad when (cbyte() != 0)
        return off
    }
    state advance_bad { adv()  return off }
}

proc consume_expected(c) {
    skip_ws()
    state valid { to consume when (cbyte() == c)  to invalid }
    state consume { adv()  return 1 }
    state invalid {
        mark_invalid()
        to advance_bad when (cbyte() != 0)
        return 0
    }
    state advance_bad { adv()  return 0 }
}

proc parse_integer() {
    let negative = 0
    state sign {
        to minus when (cbyte() == '-')
        to digits
    }
    state minus { negative = 1  adv()  to digits }
    state digits {
    let v = 0
        to loop
    }
    state loop {
        to body when (is_digit(cbyte()) == 1)
        to done
    }
    state body {
        let d = cbyte() - '0'
        to overflow when (v > 922337203685477580)
        to edge when (v == 922337203685477580)
        to append
    }
    state edge {
        to positive_edge when (negative == 0)
        to overflow when (d > 8)
        to append
    }
    state positive_edge { to overflow when (d > 7)  to append }
    state append { v = v * 10 + d  adv()  to loop }
    state overflow {
        word[2097088] = 1
        ; Consume the rest of the literal so the parser still makes progress.
        to consume
    }
    state consume {
        to consume_digit when (is_digit(cbyte()) == 1)
        return 0
    }
    state consume_digit { adv()  to consume }
    state done { to negate when (negative == 1)  return v }
    state negate { return 0 - v }
}

proc alloc(tag, f0, f1, f2) {
    let p = word[2097128]
    state capacity { to write when (p <= 67108832)  to exhausted }
    state write {
    word[p] = tag
    word[p + 8] = f0
    word[p + 16] = f1
    word[p + 24] = f2
    word[2097128] = p + 32
    return p
    }
    state exhausted { mark_invalid()  return 16777216 }
}

proc name_eq(o1, o2) {
    let i = 0
    state loop {
        let c1 = byte[2097152 + o1 + i]
        let c2 = byte[2097152 + o2 + i]
        to end1 when (is_ident_continue(c1) == 0)
        to end2 when (is_ident_continue(c2) == 0)
        to diff when (c1 != c2)
        i = i + 1
        to loop
    }
    state end1 { return 1 - is_ident_continue(c2) }
    state end2 { return 0 }
    state diff { return 0 }
}

proc name_is2(off, a, b) {
    state c1 { to c2 when (byte[2097152 + off] == a)  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == b)  return 0 }
    state c3 { to yes when (is_ident_continue(byte[2097152 + off + 2]) == 0)  return 0 }
    state yes { return 1 }
}

proc name_is3(off, a, b, c) {
    state c1 { to c2 when (byte[2097152 + off] == a)  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == b)  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == c)  return 0 }
    state c4 { to yes when (is_ident_continue(byte[2097152 + off + 3]) == 0)  return 0 }
    state yes { return 1 }
}

proc is_bytes_type(off) {
    state c1 { to c2 when (byte[2097152 + off] == 'B')  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == 'y')  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == 't')  return 0 }
    state c4 { to c5 when (byte[2097152 + off + 3] == 'e')  return 0 }
    state c5 { to c6 when (byte[2097152 + off + 4] == 's')  return 0 }
    state c6 { to yes when (is_ident_continue(byte[2097152 + off + 5]) == 0)  return 0 }
    state yes { return 1 }
}

; Closed D16 builtin identity. Return 1 empty, 2 single, 3 length, 4 get,
; 5 slice, 6 concat, or 0 for an ordinary function name.
proc bytes_builtin_kind(off) {
    state b0 { to b1 when (byte[2097152 + off] == 'b')  return 0 }
    state b1 { to b2 when (byte[2097152 + off + 1] == 'y')  return 0 }
    state b2 { to b3 when (byte[2097152 + off + 2] == 't')  return 0 }
    state b3 { to b4 when (byte[2097152 + off + 3] == 'e')  return 0 }
    state b4 { to b5 when (byte[2097152 + off + 4] == 's')  return 0 }
    state b5 { to suffix when (byte[2097152 + off + 5] == '_')  return 0 }
    state suffix {
        let s = off + 6
        to empty1 when (byte[2097152 + s] == 'e')
        to s_second when (byte[2097152 + s] == 's')
        to length1 when (byte[2097152 + s] == 'l')
        to get1 when (byte[2097152 + s] == 'g')
        to concat1 when (byte[2097152 + s] == 'c')
        return 0
    }
    state empty1 { to empty2 when (byte[2097152 + s + 1] == 'm')  return 0 }
    state empty2 { to empty3 when (byte[2097152 + s + 2] == 'p')  return 0 }
    state empty3 { to empty4 when (byte[2097152 + s + 3] == 't')  return 0 }
    state empty4 { to empty5 when (byte[2097152 + s + 4] == 'y')  return 0 }
    state empty5 { to ret_empty when (is_ident_continue(byte[2097152 + s + 5]) == 0)  return 0 }
    state ret_empty { return 1 }
    state s_second {
        to single2 when (byte[2097152 + s + 1] == 'i')
        to slice2 when (byte[2097152 + s + 1] == 'l')
        return 0
    }
    state single2 { to single3 when (byte[2097152 + s + 2] == 'n')  return 0 }
    state single3 { to single4 when (byte[2097152 + s + 3] == 'g')  return 0 }
    state single4 { to single5 when (byte[2097152 + s + 4] == 'l')  return 0 }
    state single5 { to single6 when (byte[2097152 + s + 5] == 'e')  return 0 }
    state single6 { to ret_single when (is_ident_continue(byte[2097152 + s + 6]) == 0)  return 0 }
    state ret_single { return 2 }
    state slice2 { to slice3 when (byte[2097152 + s + 2] == 'i')  return 0 }
    state slice3 { to slice4 when (byte[2097152 + s + 3] == 'c')  return 0 }
    state slice4 { to slice5 when (byte[2097152 + s + 4] == 'e')  return 0 }
    state slice5 { to ret_slice when (is_ident_continue(byte[2097152 + s + 5]) == 0)  return 0 }
    state ret_slice { return 5 }
    state length1 { to length2 when (byte[2097152 + s + 1] == 'e')  return 0 }
    state length2 { to length3 when (byte[2097152 + s + 2] == 'n')  return 0 }
    state length3 { to length4 when (byte[2097152 + s + 3] == 'g')  return 0 }
    state length4 { to length5 when (byte[2097152 + s + 4] == 't')  return 0 }
    state length5 { to length6 when (byte[2097152 + s + 5] == 'h')  return 0 }
    state length6 { to ret_length when (is_ident_continue(byte[2097152 + s + 6]) == 0)  return 0 }
    state ret_length { return 3 }
    state get1 { to get2 when (byte[2097152 + s + 1] == 'e')  return 0 }
    state get2 { to get3 when (byte[2097152 + s + 2] == 't')  return 0 }
    state get3 { to ret_get when (is_ident_continue(byte[2097152 + s + 3]) == 0)  return 0 }
    state ret_get { return 4 }
    state concat1 { to concat2 when (byte[2097152 + s + 1] == 'o')  return 0 }
    state concat2 { to concat3 when (byte[2097152 + s + 2] == 'n')  return 0 }
    state concat3 { to concat4 when (byte[2097152 + s + 3] == 'c')  return 0 }
    state concat4 { to concat5 when (byte[2097152 + s + 4] == 'a')  return 0 }
    state concat5 { to concat6 when (byte[2097152 + s + 5] == 't')  return 0 }
    state concat6 { to ret_concat when (is_ident_continue(byte[2097152 + s + 6]) == 0)  return 0 }
    state ret_concat { return 6 }
}

proc is_upper(c) {
    state c1 { to no when (c < 'A')  to c2 }
    state c2 { to no when (c > 'Z')  return 1 }
    state no { return 0 }
}

proc is_value_name_start(c) {
    state underscore { to yes when (c == '_')  to lower_low }
    state lower_low { to no when (c < 'a')  to lower_high }
    state lower_high { to no when (c > 'z')  return 1 }
    state yes { return 1 }
    state no { return 0 }
}

proc is_match_kw(off) {
    state c1 { to c2 when (byte[2097152 + off] == 'm')  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == 'a')  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == 't')  return 0 }
    state c4 { to c5 when (byte[2097152 + off + 3] == 'c')  return 0 }
    state c5 { to c6 when (byte[2097152 + off + 4] == 'h')  return 0 }
    state c6 { to yes when (is_ident_continue(byte[2097152 + off + 5]) == 0)  return 0 }
    state yes { return 1 }
}

proc is_data_kw(off) {
    state c1 { to c2 when (byte[2097152 + off] == 'd')  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == 'a')  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == 't')  return 0 }
    state c4 { to exact when (byte[2097152 + off + 3] == 'a')  return 0 }
    state exact { to yes when (is_ident_continue(byte[2097152 + off + 4]) == 0)  return 0 }
    state yes { return 1 }
}

proc is_reserved_value_name(off) {
    state builtin { to yes when (bytes_builtin_kind(off) != 0)  to k_if }
    state k_if { to yes when (name_is2(off, 'i', 'f') == 1)  to k_eq }
    state k_eq { to yes when (name_is2(off, 'e', 'q') == 1)  to k_lt }
    state k_lt { to yes when (name_is2(off, 'l', 't') == 1)  to k_let }
    state k_let { to yes when (name_is3(off, 'l', 'e', 't') == 1)  to k_def }
    state k_def { to yes when (name_is3(off, 'd', 'e', 'f') == 1)  to k_data }
    state k_data { to yes when (is_data_kw(off) == 1)  to k_match }
    state k_match { to yes when (is_match_kw(off) == 1)  return 0 }
    state yes { return 1 }
}

proc valid_value_name(off) {
    state first {
        to reserved when (is_value_name_start(byte[2097152 + off]) == 1)
        return 0
    }
    state reserved { to yes when (is_reserved_value_name(off) == 0)  return 0 }
    state yes { return 1 }
}

proc valid_declared_type_name(off) {
    state first { to int_check when (is_upper(byte[2097152 + off]) == 1)  return 0 }
    state int_check { to bytes_check when (name_is3(off, 'I', 'n', 't') == 0)  return 0 }
    state bytes_check { to yes when (is_bytes_type(off) == 0)  return 0 }
    state yes { return 1 }
}

proc valid_constructor_name(off) {
    state first { to int_check when (is_upper(byte[2097152 + off]) == 1)  return 0 }
    state int_check { to bytes_check when (name_is3(off, 'I', 'n', 't') == 0)  return 0 }
    state bytes_check { to yes when (is_bytes_type(off) == 0)  return 0 }
    state yes { return 1 }
}

; resolve a type name to a type id: Int = 0, Bytes = 1, else nominal, else -1.
proc tyid(off) {
    state intchk { to byteschk when (name_is3(off, 'I', 'n', 't') == 0)  return 0 }
    state byteschk { to scan when (is_bytes_type(off) == 0)  return 1 }
    state scan {
        let n = word[2097104]
        let i = 2
        to loop
    }
    state loop {
        to body when (i < n)
        to missing
    }
    state body {
        to hit when (name_eq(off, word[6291456 + i * 8]) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
    state missing {
        word[2097088] = 1
        return 0 - 1
    }
}

proc con_lookup(coff) {              ; constructor index by name, or -1
    let n = word[2097096]
    let i = 0
    state loop {
        to body when (i < n)
        return 0 - 1
    }
    state body {
        to hit when (name_eq(coff, word[6815744 + i * 24]) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
}

; ---- parser (core expressions) ----

proc parse_args() {
    let head = 0
    let tail = 0
    state loop {
        skip_ws()
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        let item = parse_expr()
        let node = alloc(6, item, 0, 0)
        to first when (head == 0)
        word[tail + 16] = node
        tail = node
        to loop
    }
    state first { head = node  tail = node  to loop }
    state eof { mark_invalid()  return head }
    state done { return head }
}

proc parse_expr() {
    skip_ws()
    let c = cbyte()
    state start {
        to invalid when (c == 0)
        to invalid when (c == ')')
        to num
    }
    state num { to do_num when (is_digit(c) == 1)  to negnum }
    state negnum {
        to lparen when (c != '-')
        to lparen when (is_digit(byte[2097152 + word[2097144] + 1]) == 0)
        to do_num
    }
    state do_num { return alloc(0, parse_integer(), 0, 0) }
    state lparen { to compound when (c == '(')  to atom }
    state compound {
        adv()
        skip_ws()
        let h = cbyte()
        to do_op when (is_op(h) == 1)
        to head
    }
    state do_op {
        adv()
        let a = parse_expr()
        let b = parse_expr()
        consume_expected(')')
        return alloc(2, h, a, b)
    }
    state head {
        to invalid_compound when (is_ident_start(cbyte()) == 0)
        let hoff = take_ident()
        to do_if when (name_is2(hoff, 'i', 'f') == 1)
        to k_let
    }
    state do_if {
        let c1 = parse_expr()
        let t1 = parse_expr()
        let e1 = parse_expr()
        consume_expected(')')
        return alloc(3, c1, t1, e1)
    }
    state k_let { to do_let when (name_is3(hoff, 'l', 'e', 't') == 1)  to k_eq }
    state do_let {
        let noff = take_ident()
        to let_name_ok when (valid_value_name(noff) == 1)
        mark_invalid()
        to let_name_ok
    }
    state let_name_ok {
        let e2 = parse_expr()
        let body = parse_expr()
        consume_expected(')')
        return alloc(4, noff, e2, body)
    }
    state k_eq { to do_eq when (name_is2(hoff, 'e', 'q') == 1)  to k_lt }
    state do_eq {
        let a2 = parse_expr()
        let b2 = parse_expr()
        consume_expected(')')
        return alloc(2, 'e', a2, b2)
    }
    state k_lt { to do_lt when (name_is2(hoff, 'l', 't') == 1)  to k_match }
    state do_lt {
        let a3 = parse_expr()
        let b3 = parse_expr()
        consume_expected(')')
        return alloc(2, 'l', a3, b3)
    }
    state k_match { to do_match when (is_match_kw(hoff) == 1)  to k_con }
    state do_match {
        let scrut = parse_expr()
        let arms = parse_arms()
        consume_expected(')')
        return alloc(8, scrut, arms, 0)
    }
    state k_con { to do_con when (is_upper(byte[2097152 + hoff]) == 1)  to do_call }
    state do_con {
        let cargs = parse_args()
        consume_expected(')')
        return alloc(7, hoff, cargs, 0)
    }
    state do_call {
        to call_name_ok when (valid_value_name(hoff) == 1)
        ; The six reserved bytes_* forms are parsed through the same argument
        ; list representation but remain closed builtins in tc_call.
        to call_name_ok when (bytes_builtin_kind(hoff) != 0)
        mark_invalid()
        to call_name_ok
    }
    state call_name_ok {
        let args = parse_args()
        consume_expected(')')
        return alloc(5, hoff, args, 0)
    }
    state atom {
        to invalid when (is_ident_start(cbyte()) == 0)
        let voff = take_ident()
        to nullcon when (is_upper(byte[2097152 + voff]) == 1)
        to atom_name_ok when (valid_value_name(voff) == 1)
        mark_invalid()
        to atom_name_ok
    }
    state atom_name_ok {
        return alloc(1, voff, 0, 0)
    }
    state nullcon { return alloc(7, voff, 0, 0) }     ; nullary constructor
    state invalid_compound {
        mark_invalid()
        to invalid_advance when (cbyte() != 0)
        return alloc(0, 0, 0, 0)
    }
    state invalid {
        mark_invalid()
        to invalid_advance when (cbyte() != 0)
        return alloc(0, 0, 0, 0)
    }
    state invalid_advance { adv()  return alloc(0, 0, 0, 0) }
}

proc parse_pvars() {
    let head = 0
    let tail = 0
    state loop {
        skip_ws()
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        let voff = take_ident()
        to name_ok when (valid_value_name(voff) == 1)
        mark_invalid()
        to name_ok
    }
    state name_ok {
        let node = alloc(6, voff, 0, 0)
        to first when (head == 0)
        word[tail + 16] = node
        tail = node
        to loop
    }
    state first { head = node  tail = node  to loop }
    state eof { mark_invalid()  return head }
    state done { return head }
}

proc parse_pat() {
    skip_ws()
    state chk { to pcon when (cbyte() == '(')  to atom }
    state pcon {
        consume_expected('(')
        let coff = take_ident()
        to pcon_name_ok when (valid_constructor_name(coff) == 1)
        mark_invalid()
        to pcon_name_ok
    }
    state pcon_name_ok {
        let vars = parse_pvars()
        consume_expected(')')
        return alloc(10, coff, vars, 0)               ; PCON
    }
    state atom {
        let voff = take_ident()
        to nullcon when (is_upper(byte[2097152 + voff]) == 1)
        to pvar_name_ok when (valid_value_name(voff) == 1)
        mark_invalid()
        to pvar_name_ok
    }
    state pvar_name_ok {
        return alloc(9, voff, 0, 0)                   ; PVAR
    }
    state nullcon {
        to nullcon_ok when (valid_constructor_name(voff) == 1)
        mark_invalid()
        to nullcon_ok
    }
    state nullcon_ok { return alloc(10, voff, 0, 0) } ; nullary constructor pattern
}

proc parse_arms() {
    let head = 0
    let tail = 0
    state loop {
        skip_ws()
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        consume_expected('(')
        let pat = parse_pat()
        let body = parse_expr()
        consume_expected(')')
        let node = alloc(6, alloc(11, pat, body, 0), 0, 0)
        to first when (head == 0)
        word[tail + 16] = node
        tail = node
        to loop
    }
    state first { head = node  tail = node  to loop }
    state eof { mark_invalid()  return head }
    state done { return head }
}

proc parse_typed_params() {       ; (pname Ty) pairs until ')', CONS of PARAM nodes
    let head = 0
    let tail = 0
    state loop {
        skip_ws()
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        consume_expected('(')
        let poff = take_ident()
        to param_name_ok when (valid_value_name(poff) == 1)
        mark_invalid()
        to param_name_ok
    }
    state param_name_ok {
        let toff = take_ident()
        to param_type_ok when (is_upper(byte[2097152 + toff]) == 1)
        mark_invalid()
        to param_type_ok
    }
    state param_type_ok {
        consume_expected(')')
        let node = alloc(50, poff, tyid(toff), 0)
        let link = alloc(6, node, 0, 0)
        to first when (head == 0)
        word[tail + 16] = link
        tail = link
        to loop
    }
    state first { head = link  tail = link  to loop }
    state eof { mark_invalid()  return head }
    state done { return head }
}

proc parse_def() {
    consume_expected('(')
    let keyword = take_ident()
    to keyword_ok when (name_is3(keyword, 'd', 'e', 'f') == 1)
    mark_invalid()
    to keyword_ok
    state keyword_ok {
    let noff = take_ident()
    to name_ok when (valid_value_name(noff) == 1)
    mark_invalid()
    to name_ok
    }
    state name_ok {
    consume_expected('(')
    let params = parse_typed_params()
    consume_expected(')')
    let rtoff = take_ident()
    to return_type_ok when (is_upper(byte[2097152 + rtoff]) == 1)
    mark_invalid()
    to return_type_ok
    }
    state return_type_ok {
    let rtid = tyid(rtoff)
    let body = parse_expr()
    consume_expected(')')
    let i = word[2097120]
    word[8388608 + i * 32] = noff
    word[8388608 + i * 32 + 8] = params
    word[8388608 + i * 32 + 16] = rtid
    word[8388608 + i * 32 + 24] = body
    word[2097120] = i + 1
    return 0
    }
}

proc parse_argtypes() {           ; constructor arg type names until ')', CONS of tyids
    let head = 0
    let tail = 0
    state loop {
        skip_ws()
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        let toff = take_ident()
        to type_name_ok when (is_upper(byte[2097152 + toff]) == 1)
        mark_invalid()
        to type_name_ok
    }
    state type_name_ok {
        let node = alloc(6, tyid(toff), 0, 0)
        to first when (head == 0)
        word[tail + 16] = node
        tail = node
        to loop
    }
    state first { head = node  tail = node  to loop }
    state eof { mark_invalid()  return head }
    state done { return head }
}

proc parse_data() {               ; (data T (C ArgTy...)...) -> register type + cons
    consume_expected('(')
    let keyword = take_ident()
    to keyword_ok when (is_data_kw(keyword) == 1)
    mark_invalid()
    to keyword_ok
    state keyword_ok {
    let toff = take_ident()
    to type_name_ok when (valid_declared_type_name(toff) == 1)
    mark_invalid()
    to type_name_ok
    }
    state type_name_ok {
    let tid = word[2097104]        ; register the type first (self-recursion resolves)
    word[6291456 + tid * 8] = toff
    word[2097104] = tid + 1
    let first_con = word[2097096]
    skip_ws()
    to loop
    }
    state loop {
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        to body
    }
    state body {
        consume_expected('(')
        let coff = take_ident()
        to con_name_ok when (valid_constructor_name(coff) == 1)
        mark_invalid()
        to con_name_ok
    }
    state con_name_ok {
        let argtys = parse_argtypes()
        consume_expected(')')
        let ci = word[2097096]
        word[6815744 + ci * 24] = coff
        word[6815744 + ci * 24 + 8] = tid
        word[6815744 + ci * 24 + 16] = argtys
        word[2097096] = ci + 1
        skip_ws()
        to loop
    }
    state eof { mark_invalid()  return 0 }
    state done {
        to have_constructor when (word[2097096] != first_con)
        mark_invalid()
        to have_constructor
    }
    state have_constructor {
        consume_expected(')')
        return 0
    }
}

proc is_data() {
    state chk { to paren when (cbyte() == '(')  return 0 }
    state paren {
        let save = word[2097144]
        adv()
        skip_ws()
        let o = word[2097144]
        word[2097144] = save         ; peek only
        to c1 when (byte[2097152 + o] == 'd')
        return 0
    }
    state c1 { to c2 when (byte[2097152 + o + 1] == 'a')  return 0 }
    state c2 { to c3 when (byte[2097152 + o + 2] == 't')  return 0 }
    state c3 { to c4 when (byte[2097152 + o + 3] == 'a')  return 0 }
    state c4 { to yes when (is_ident_continue(byte[2097152 + o + 4]) == 0)  return 0 }
    state yes { return 1 }
}

proc is_def() {
    state chk { to paren when (cbyte() == '(')  return 0 }
    state paren {
        let save = word[2097144]
        adv()
        skip_ws()
        let r = name_is3(word[2097144], 'd', 'e', 'f')
        word[2097144] = save
        return r
    }
}

proc fun_lookup(noff) {
    let n = word[2097120]
    let i = 0
    state loop {
        to body when (i < n)
        return 0 - 1
    }
    state body {
        to hit when (name_eq(noff, word[8388608 + i * 32]) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
}

; ---- type environment (var -> tyid), frame-local lookup ----

proc tenv_push(off, t) {
    let n = word[2097112]
    word[9437184 + n * 16] = off
    word[9437184 + n * 16 + 8] = t
    word[2097112] = n + 1
}

proc tenv_lookup(qoff) {
    let j = word[2097112] - 1
    let result = 0 - 1
    state loop {
        to body when (j >= 0)
        return result
    }
    state body {
        to hit when (name_eq(qoff, word[9437184 + j * 16]) == 1)
        j = j - 1
        to loop
    }
    state hit {
        result = word[9437184 + j * 16 + 8]
        return result
    }
}

; ---- the type checker: tc(expr) -> tyid, or -1 on a type error ----

proc tc_bytes_builtin(kind, args) {
    state dispatch {
        to empty when (kind == 1)
        to single when (kind == 2)
        to length when (kind == 3)
        to get when (kind == 4)
        to slice when (kind == 5)
        to concat
    }
    state empty { to bytesret when (args == 0)  return 0 - 1 }
    state single {
        to bad when (args == 0)
        let a1 = args
        to bad when (word[a1 + 16] != 0)
        to bytesret when (tc(word[a1 + 8]) == 0)
        to bad
    }
    state length {
        to bad when (args == 0)
        let a2 = args
        to bad when (word[a2 + 16] != 0)
        to intret when (tc(word[a2 + 8]) == 1)
        to bad
    }
    state get {
        to bad when (args == 0)
        let g1 = args
        let g2 = word[g1 + 16]
        to bad when (g2 == 0)
        to bad when (word[g2 + 16] != 0)
        to bad when (tc(word[g1 + 8]) != 1)
        to intret when (tc(word[g2 + 8]) == 0)
        to bad
    }
    state slice {
        to bad when (args == 0)
        let s1 = args
        let s2 = word[s1 + 16]
        to bad when (s2 == 0)
        let s3 = word[s2 + 16]
        to bad when (s3 == 0)
        to bad when (word[s3 + 16] != 0)
        to bad when (tc(word[s1 + 8]) != 1)
        to bad when (tc(word[s2 + 8]) != 0)
        to bytesret when (tc(word[s3 + 8]) == 0)
        to bad
    }
    state concat {
        to bad when (args == 0)
        let c1 = args
        let c2 = word[c1 + 16]
        to bad when (c2 == 0)
        to bad when (word[c2 + 16] != 0)
        to bad when (tc(word[c1 + 8]) != 1)
        to bytesret when (tc(word[c2 + 8]) == 1)
        to bad
    }
    state intret { return 0 }
    state bytesret { return 1 }
    state bad { return 0 - 1 }
}

proc tc_call(fname, args) {
    let builtin = bytes_builtin_kind(fname)
    state builtin_check { to builtin_call when (builtin != 0)  to ordinary }
    state builtin_call { return tc_bytes_builtin(builtin, args) }
    state ordinary {
        let fi = fun_lookup(fname)
        to fchk
    }
    state fchk { to known when (fi != 0 - 1)  return 0 - 1 }   ; unknown function
    state known {
        let p = word[8388608 + fi * 32 + 8]
        let a = args
        let fail = 0
        to loop
    }
    state loop {
        to pdone when (p == 0)
        to achk
    }
    state achk {
        to adone when (a == 0)
        let pty = word[word[p + 8] + 16]
        to mark when (tc(word[a + 8]) != pty)
        to advance
    }
    state mark { fail = 1  to advance }
    state advance { p = word[p + 16]  a = word[a + 16]  to loop }
    state pdone { to overmark when (a != 0)  to finish }       ; too many args
    state adone { fail = 1  to finish }                        ; p != 0: too few
    state overmark { fail = 1  to finish }
    state finish {
        to failret when (fail == 1)
        return word[8388608 + fi * 32 + 16]
    }
    state failret { return 0 - 1 }
}

proc tc_conapp(coff, args) {
    let ci = con_lookup(coff)
    state cchk { to known when (ci != 0 - 1)  return 0 - 1 }   ; unknown constructor
    state known {
        let p = word[6815744 + ci * 24 + 16]
        let a = args
        let fail = 0
        to loop
    }
    state loop {
        to pdone when (p == 0)
        to achk
    }
    state achk {
        to adone when (a == 0)
        to mark when (tc(word[a + 8]) != word[p + 8])
        to advance
    }
    state mark { fail = 1  to advance }
    state advance { p = word[p + 16]  a = word[a + 16]  to loop }
    state pdone { to overmark when (a != 0)  to finish }
    state adone { fail = 1  to finish }
    state overmark { fail = 1  to finish }
    state finish {
        to failret when (fail == 1)
        return word[6815744 + ci * 24 + 8]
    }
    state failret { return 0 - 1 }
}

proc tc_match(scrut, arms) {
    let st = tc(scrut)
    state schk { to algebraic when (st > 1)  return 0 - 1 }
    state algebraic {
        word[2097080] = word[2097080] + 1
        to ok
    }
    state ok {
        let arm = arms
        let rty = 0 - 2                ; -2 = result type not yet seen
        let fail = 0
        let catchall = 0
        let seen = 0
        let epoch = word[2097080]
        to loop
    }
    state loop {
        to armbody when (arm != 0)
        to finish
    }
    state armbody {
        let armnode = word[arm + 8]
        let pat = word[armnode + 8]
        let base = word[2097112]
        seen = 1
        to after_catchall when (catchall == 1)
        to patkind
    }
    state after_catchall { fail = 1  to patkind }
    state patkind {
        to pvar when (word[pat] == 9)
        to pcon
    }
    state pvar {
        catchall = 1
        tenv_push(word[pat + 8], st)
        to checkbody
    }
    state pcon {
        let ci = con_lookup(word[pat + 8])
        to badcon when (ci == 0 - 1)
        to tymatch
    }
    state badcon { fail = 1  to checkbody }
    state tymatch {
        to badty when (word[6815744 + ci * 24 + 8] != st)
        to duplicate when (word[10485760 + ci * 8] == epoch)
        word[10485760 + ci * 8] = epoch
        to bindvars
    }
    state badty { fail = 1  to checkbody }
    state duplicate { fail = 1  to bindvars }
    state bindvars {
        let pv = word[pat + 16]
        let av = word[6815744 + ci * 24 + 16]
        to bindloop
    }
    state bindloop {
        to bindpv when (pv != 0)
        to bindrest                   ; pv == 0
    }
    state bindpv {
        to bindav0 when (av == 0)     ; too many pattern vars
        tenv_push(word[pv + 8], word[av + 8])
        pv = word[pv + 16]
        av = word[av + 16]
        to bindloop
    }
    state bindav0 { fail = 1  to checkbody }
    state bindrest {
        to bindavmark when (av != 0)  ; too few pattern vars
        to checkbody
    }
    state bindavmark { fail = 1  to checkbody }
    state checkbody {
        let bt = tc(word[armnode + 16])
        word[2097112] = base
        to btfail when (bt == 0 - 1)
        to rtychk
    }
    state btfail { fail = 1  to rtychk }
    state rtychk {
        to setrty when (rty == 0 - 2)
        to cmprty
    }
    state setrty { rty = bt  to nextarm }
    state cmprty {
        to rtymark when (bt != rty)
        to nextarm
    }
    state rtymark { fail = 1  to nextarm }
    state nextarm { arm = word[arm + 16]  to loop }
    state finish {
        to failret when (fail == 1)
        to failret when (seen == 0)
        to complete when (catchall == 1)
        let ci2 = 0
        to coverloop
    }
    state coverloop {
        to coverbody when (ci2 < word[2097096])
        to complete
    }
    state coverbody {
        to covernext when (word[6815744 + ci2 * 24 + 8] != st)
        to missing when (word[10485760 + ci2 * 8] != epoch)
        to covernext
    }
    state covernext { ci2 = ci2 + 1  to coverloop }
    state missing { return 0 - 1 }
    state complete { return rty }
    state failret { return 0 - 1 }
}

proc tc(expr) {
    let tag = word[expr]
    state t0 { to ret_int when (tag == 0)  to t1 }
    state ret_int { return 0 }                       ; INT : Int
    state t1 { to ret_var when (tag == 1)  to t2 }
    state ret_var { return tenv_lookup(word[expr + 8]) }   ; VAR
    state t2 { to prim when (tag == 2)  to t3 }
    state prim {                                      ; PRIM : Int x Int -> Int
        let a = tc(word[expr + 16])
        let b = tc(word[expr + 24])
        to prim_a when (a == 0)
        return 0 - 1
    }
    state prim_a {
        to prim_int when (b == 0)
        return 0 - 1
    }
    state prim_int { return 0 }
    state t3 { to ifexpr when (tag == 3)  to t4 }
    state ifexpr {                                    ; IF : cond Int, branches equal
        let c = tc(word[expr + 8])
        let t = tc(word[expr + 16])
        let e = tc(word[expr + 24])
        to if_cond when (c == 0)
        return 0 - 1
    }
    state if_cond {
        to if_eq when (t == e)
        return 0 - 1
    }
    state if_eq { return t }
    state t4 { to letexpr when (tag == 4)  to t5 }
    state letexpr {                                   ; LET : bind the synthesised type
        let vt = tc(word[expr + 16])
        to let_ok when (vt != 0 - 1)
        return 0 - 1
    }
    state let_ok {
        tenv_push(word[expr + 8], vt)
        let r = tc(word[expr + 24])
        word[2097112] = word[2097112] - 1
        return r
    }
    state t5 { to callexpr when (tag == 5)  to t7 }
    state callexpr { return tc_call(word[expr + 8], word[expr + 16]) }
    state t7 { to conapp when (tag == 7)  to t8 }
    state conapp { return tc_conapp(word[expr + 8], word[expr + 16]) }
    state t8 { to matchexpr when (tag == 8)  return 0 - 1 }
    state matchexpr { return tc_match(word[expr + 8], word[expr + 16]) }
}

proc main() {
    let slurp_status = slurp()
    state source {
        to source_failed when (slurp_status != 0)
        skip_ws()
        to dataloop
    }
    state source_failed { return 0 }
    state dataloop {
        to databody when (is_data() == 1)
        to defloop
    }
    state databody { parse_data()  skip_ws()  to dataloop }
    state defloop {
        to defbody when (is_def() == 1)
        to program_shape
    }
    state defbody { parse_def()  skip_ws()  to defloop }
    state program_shape {
        to invalid_program when (word[2097120] == 0)
        to invalid_program when (word[2097144] != word[2097136])
        to checkfns
    }
    state invalid_program { word[2097088] = 1  to checkfns }
    state checkfns {
        let ok = 1
        let i = 0
        to invalid_type when (word[2097088] != 0)
        to floop
    }
    state invalid_type { ok = 0  to floop }
    state floop {
        to fbody when (i < word[2097120])
        return ok
    }
    state fbody {
        let base = word[2097112]
        let p = word[8388608 + i * 32 + 8]
        to ploop
    }
    state ploop {
        to pbody when (p != 0)
        to docheck
    }
    state pbody {
        tenv_push(word[word[p + 8] + 8], word[word[p + 8] + 16])
        p = word[p + 16]
        to ploop
    }
    state docheck {
        to okmark when (tc(word[8388608 + i * 32 + 24]) != word[8388608 + i * 32 + 16])
        to advance
    }
    state okmark { ok = 0  to advance }
    state advance {
        word[2097112] = base
        i = i + 1
        to floop
    }
}
