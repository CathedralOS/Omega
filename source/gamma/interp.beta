; interp.beta — a bounded pre-Q9 Gamma semantic oracle, written in Beta.
;
; The canonical next edge is a Beta-written Gamma compiler that emits Alpha tape.
; This interpreter exercises candidate evaluation rules; it is neither the Gamma
; compiler nor permission to keep an evaluator in the compiler chain. OWNER Q9 decides
; which rules are absorbed and whether the remainder is deleted.
;
; Stage 1: the pure functional, FUEL-bounded core — integer values, top-level
; recursive functions, `if`, `let`, arithmetic and comparisons. Stage 2: the
; gamma-DEFINING features — algebraic data types (constructors) and pattern matching.
;
; Surface (prefix s-expressions; `;` comments; Uppercase head = constructor):
;   program := (def NAME (PARAM...) EXPR)*  EXPR        ; defs, then the goal expr
;   EXPR    := INT | VAR | (if E E E) | (let NAME E E)
;            | (+ E E) | (- E E) | (* E E) | (/ E E) | (% E E) | (eq E E) | (lt E E)
;            | (fn E...) | Con | (Con E...) | (match E (PAT E)...)
;   PAT     := var | Con | (Con var...)
; The final EXPR is evaluated; the integer value is the process exit code.
;
; CONTROL FLOW is CFG/Omega-shaped: each proc is a set of `state` basic blocks linked
; by guarded `to … when …` transitions — no if/while. A proc falls into its first
; state and into the next unless it transitions or returns; a loop is a state that
; transitions back to itself.
;
; Memory:  2097152 SRC [2 MiB,6 MiB)  2097144 CUR  2097136 LEN  2097128 APTR  2097120 NFUNC
;          2097112 ENVN 2097104 FRAMEBASE 2097096 ARGSP 2097088 ARG_EXHAUSTED
;          2097080 ARENA_EXHAUSTED
;          6291456 FUNCS [6 MiB,7 MiB)
;          7340032 ENV [7 MiB,12 MiB)
;          14680096 ARG_SCRATCH [4 KiB; 512 values)  14684192 VTAIL_SENTINEL
;          16777216 HEAP [16 MiB,32 MiB)
; All addresses are logical Beta raw-memory addresses inside the 32 MiB profile.
; AST/value nodes are 2-4 words [tag,f0,f1,f2]. Func entries 3 words
; [name_off, paramlist, body]. Env entries 2 words [name_off, value]; -1 = unnamed arg.
;
; AST tags:   0 INT(v) 1 VAR(off) 2 PRIM(op,a,b) 3 IF(c,t,e) 4 LET(off,e,body)
;             5 CALL(foff,args) 6 CONS(head,tail) 7 CONAPP(con_off,args)
;             8 MATCH(scrut,arms) 9 PVAR(off) 10 PCON(con_off,varlist) 11 ARM(pat,body)
; pattern tags: 12 PNIL 14 PCONS
; value tags: 100 VINT(n)  101 VCON(con_off, value-arglist)
;             102 VCONS(head, tail) — headerless tagged handle for `(Cons h t)`
;             103 VTAIL(function_index, evaluated-value-list) — evaluator-private trampoline request
; A nullary constructor value reuses its immutable tag-7 AST node.

proc slurp() {
    let n = 0
    let c = read_byte()
    state loop {
        to done when (c < 0)
        to exhausted when (n == 4194304)  ; 4 MiB source ceiling, before FUNCS at 6 MiB
        to body
    }
    state body {
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
        to loop
    }
    state done {
        word[2097136] = n        ; LEN
        word[2097144] = 0        ; CUR
        word[2097128] = 16777216 ; APTR — checked fixed arena [16 MiB,32 MiB).
        word[2097120] = 0        ; NFUNC
        word[2097112] = 0        ; ENVN
        word[2097104] = 0        ; FRAMEBASE
        word[2097096] = 14680096 ; ARGSP — checked evaluator-private argument scratch
        word[2097088] = 0        ; ARG_EXHAUSTED
        word[2097080] = 0        ; ARENA_EXHAUSTED
        word[14684192] = 103     ; stable evaluator-private VTAIL sentinel
        word[14684224] = 0       ; allocation-failure AST sentinel: INT(0)
        word[14684232] = 0
        word[14684256] = 100     ; allocation-failure value sentinel: VINT(0)
        word[14684264] = 0
        word[14684288] = 100     ; stable boxed -1 (nonnegative u32 values are immediate)
        word[14684296] = 0 - 1
        return 0
    }
    state exhausted { return 252 }
}

proc cbyte() {
    let i = word[2097144]
    state chk { to hit when (i < word[2097136])  return 0 }
    state hit { return byte[2097152 + i] }
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

proc is_space(c) {
    state c1 { to yes when (c == ' ')  to c2 }
    state c2 { to yes when (c == 9)    to c3 }
    state c3 { to yes when (c == 10)   to c4 }
    state c4 { to yes when (c == 13)   return 0 }
    state yes { return 1 }
}

proc skip_ws() {
    let go = 1
    state loop {
        to done when (go == 0)
        let c = cbyte()
        to sp when (is_space(c) == 1)
        to semi
    }
    state sp { adv()  to loop }
    state semi {
        to cmt when (c == ';')
        go = 0
        to loop
    }
    state cmt {
        to loop when (cbyte() == 10)     ; comment ends at newline -> outer loop
        to ceof when (cbyte() == 0)
        adv()
        to cmt
    }
    state ceof { return 0 }
    state done { return 0 }
}

proc is_digit(c) {
    state c1 { to no when (c < '0')  to c2 }
    state c2 { to no when (c > '9')  return 1 }
    state no { return 0 }
}

proc is_delim(c) {
    state c1 { to yes when (is_space(c) == 1)  to c2 }
    state c2 { to yes when (c == '(')  to c3 }
    state c3 { to yes when (c == ')')  to c4 }
    state c4 { to yes when (c == 0)    return 0 }
    state yes { return 1 }
}

proc is_op(c) {
    state c1 { to yes when (c == '+')  to c2 }
    state c2 { to yes when (c == '-')  to c3 }
    state c3 { to yes when (c == '*')  to c4 }
    state c4 { to yes when (c == '/')  to c5 }
    state c5 { to yes when (c == '%')  return 0 }
    state yes { return 1 }
}

proc skip_ident() {
    state loop {
        to body when (is_delim(cbyte()) == 0)
        return 0
    }
    state body { adv()  to loop }
}

proc parse_number() {
    let v = 0
    state loop {
        to body when (is_digit(cbyte()) == 1)
        return v
    }
    state body {
        v = v * 10 + (cbyte() - '0')
        adv()
        to loop
    }
}

proc allocation_exhausted(tag) {
    word[2097080] = 1
    state value { to value_sentinel when (tag >= 100)  return 14684224 }
    state value_sentinel { return 14684256 }
}

; ---- fixed evaluation arena ----
;
; The parsed AST and all evaluation values share one stable-address bump arena.
; Exhaustion is explicit and fail-closed. In particular, the interpreter does
; not inspect compiler-generated Beta frames through source-visible memory.
proc reserve(words, kind) {
    let p = word[2097128]
    state bump { to bump_hit when (p + words * 8 <= 33554432)  return 0 }
    state bump_hit {
        word[2097128] = p + words * 8
        return p
    }
}

proc alloc2(tag, f0) {
    let p = reserve(2, 2)
    state room {
        to exhausted when (p == 0)
        word[p] = tag
        word[p + 8] = f0
        return p
    }
    state exhausted { return allocation_exhausted(tag) }
}

proc alloc3(tag, f0, f1) {
    let p = reserve(3, 3)
    state room {
        to exhausted when (p == 0)
        word[p] = tag
        word[p + 8] = f0
        word[p + 16] = f1
        return p
    }
    state exhausted { return allocation_exhausted(tag) }
}

proc alloc4(tag, f0, f1, f2) {
    let p = reserve(4, 4)
    state room {
        to exhausted when (p == 0)
        word[p] = tag
        word[p + 8] = f0
        word[p + 16] = f1
        word[p + 24] = f2
        return p
    }
    state exhausted { return allocation_exhausted(tag) }
}

; Ordinary two-field Cons cells use one disjoint out-of-memory pointer range as
; a representation-only tag. The payload stays two aligned words in the heap;
; the returned handle selects the constructor without a third header word.
proc alloc_cons(head, tail) {
    let p = reserve(2, 6)
    state room {
        to exhausted when (p == 0)
        word[p] = head
        word[p + 8] = tail
        return p + 201326592
    }
    state exhausted { return allocation_exhausted(102) }
}

; do the names at SRC offsets o1 and o2 (each ending at a delimiter) match?
proc name_eq(o1, o2) {
    let i = 0
    state loop {
        let c1 = byte[2097152 + o1 + i]
        let c2 = byte[2097152 + o2 + i]
        to end1 when (is_delim(c1) == 1)
        to end2 when (is_delim(c2) == 1)    ; c1 not delim but c2 is -> mismatch
        to diff when (c1 != c2)
        i = i + 1
        to loop
    }
    state end1 { return is_delim(c2) }       ; both delim here -> equal (1); else 0
    state end2 { return 0 }
    state diff { return 0 }
}

proc name_is2(off, a, b) {
    state c1 { to c2 when (byte[2097152 + off] == a)  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == b)  return 0 }
    state c3 { to yes when (is_delim(byte[2097152 + off + 2]) == 1)  return 0 }
    state yes { return 1 }
}

proc name_is3(off, a, b, c) {
    state c1 { to c2 when (byte[2097152 + off] == a)  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == b)  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == c)  return 0 }
    state c4 { to yes when (is_delim(byte[2097152 + off + 3]) == 1)  return 0 }
    state yes { return 1 }
}

proc is_match_kw(off) {          ; the 5-char keyword "match"
    state c1 { to c2 when (byte[2097152 + off] == 'm')  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == 'a')  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == 't')  return 0 }
    state c4 { to c5 when (byte[2097152 + off + 3] == 'c')  return 0 }
    state c5 { to c6 when (byte[2097152 + off + 4] == 'h')  return 0 }
    state c6 { to yes when (is_delim(byte[2097152 + off + 5]) == 1)  return 0 }
    state yes { return 1 }
}

proc is_cons_name(off) {         ; the 4-char constructor name "Cons"
    state c1 { to c2 when (byte[2097152 + off] == 'C')  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == 'o')  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == 'n')  return 0 }
    state c4 { to c5 when (byte[2097152 + off + 3] == 's')  return 0 }
    state c5 { to yes when (is_delim(byte[2097152 + off + 4]) == 1)  return 0 }
    state yes { return 1 }
}

proc is_nil_name(off) {          ; the 3-char constructor name "Nil"
    state c1 { to c2 when (byte[2097152 + off] == 'N')  return 0 }
    state c2 { to c3 when (byte[2097152 + off + 1] == 'i')  return 0 }
    state c3 { to c4 when (byte[2097152 + off + 2] == 'l')  return 0 }
    state c4 { to yes when (is_delim(byte[2097152 + off + 3]) == 1)  return 0 }
    state yes { return 1 }
}

proc is_upper(c) {               ; capitalized head => a constructor (ADT value)
    state c1 { to no when (c < 'A')  to c2 }
    state c2 { to no when (c > 'Z')  return 1 }
    state no { return 0 }
}

; ---- boxed values: VINT(100,n), VCON(101, con_off, arglist of value-ptrs),
;      and VCONS(102, head, tail). The compact tag is representation-only:
;      matching and printing remain exactly those of the corresponding ADTs. ----
proc mk_int(n) {
    ; Common compiler offsets and every u32 value use negative immediate words rather
    ; than consuming the managed heap. Values outside this bounded range retain
    ; the ordinary boxed path, so Gamma's full signed-word behavior is unchanged.
    state negative { to minus_one when (n == 0 - 1)  to low }
    state minus_one { return 14684288 }
    state low { to boxed when (n < 0)  to high }
    state high { to boxed when (n > 4294967295)  return 0 - n - 2 }
    state boxed { return alloc2(100, n) }
}

proc get_int(v) {                ; the integer of a VINT (0 for a constructor)
    state immediate { to direct when (v < 0 - 1)  to tagged }
    state direct { return 0 - v - 2 }
    state tagged { to constructor when (v >= 83886080)  to boxed }
    state boxed { to vint when (word[v] == 100)  return 0 }
    state vint { return word[v + 8] }
    state constructor { return 0 }
}

proc value_tag(v) {
    state immediate { to vint when (v < 0 - 1)  to raw }
    state raw { to raw_pointer when (v < 83886080)  to vcons }
    state raw_pointer { return word[v] }
    state vint { return 100 }
    state vcons { return 102 }
}

; ---- parser ----

proc parse_args() {              ; exprs until ')', as a CONS list
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        let h = parse_expr()
        let t = parse_args()
        return alloc3(6, h, t)
    }
}

proc parse_params() {            ; param NAMES until ')', as a CONS of name-offsets
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        let poff = word[2097144]
        skip_ident()
        let t = parse_params()
        return alloc3(6, poff, t)
    }
}

proc parse_expr() {
    skip_ws()
    let c = cbyte()
    state num { to do_num when (is_digit(c) == 1)  to lparen }
    state do_num { return alloc2(0, parse_number()) }
    state lparen { to compound when (c == '(')  to atom }
    state compound {
        adv()
        skip_ws()
        let h = cbyte()
        to do_op when (is_op(h) == 1)
        to head
    }
    state do_op {
        adv()
        let a = parse_expr()
        let b = parse_expr()
        skip_ws()
        adv()
        return alloc4(2, h, a, b)
    }
    state head {
        let hoff = word[2097144]
        skip_ident()
        to do_if when (name_is2(hoff, 'i', 'f') == 1)
        to k_let
    }
    state do_if {
        let c1 = parse_expr()
        let t1 = parse_expr()
        let e1 = parse_expr()
        skip_ws()
        adv()
        return alloc4(3, c1, t1, e1)
    }
    state k_let { to do_let when (name_is3(hoff, 'l', 'e', 't') == 1)  to k_eq }
    state do_let {
        skip_ws()
        let noff = word[2097144]
        skip_ident()
        let e2 = parse_expr()
        let body = parse_expr()
        skip_ws()
        adv()
        return alloc4(4, noff, e2, body)
    }
    state k_eq { to do_eq when (name_is2(hoff, 'e', 'q') == 1)  to k_lt }
    state do_eq {
        let a2 = parse_expr()
        let b2 = parse_expr()
        skip_ws()
        adv()
        return alloc4(2, 'e', a2, b2)
    }
    state k_lt { to do_lt when (name_is2(hoff, 'l', 't') == 1)  to k_match }
    state do_lt {
        let a3 = parse_expr()
        let b3 = parse_expr()
        skip_ws()
        adv()
        return alloc4(2, 'l', a3, b3)
    }
    state k_match { to do_match when (is_match_kw(hoff) == 1)  to k_con }
    state do_match {                         ; (match E (pat body)...)
        let scrut = parse_expr()
        let arms = parse_arms()
        skip_ws()
        adv()
        return alloc3(8, scrut, arms)
    }
    state k_con { to do_con when (is_upper(byte[2097152 + hoff]) == 1)  to do_call }
    state do_con {                           ; (Con args...) constructor
        let cargs = parse_args()
        skip_ws()
        adv()
        return alloc3(7, hoff, cargs)
    }
    state do_call {                          ; (fn args...) call
        let args = parse_args()
        skip_ws()
        adv()
        return alloc3(5, hoff, args)
    }
    state atom {
        let voff = word[2097144]
        skip_ident()
        to nullcon when (is_upper(byte[2097152 + voff]) == 1)
        return alloc2(1, voff)          ; variable
    }
    state nullcon { return alloc3(7, voff, 0) }
}

proc parse_pvars() {             ; pattern variable NAMES until ')', a CONS of offsets
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        let voff = word[2097144]
        skip_ident()
        let t = parse_pvars()
        return alloc3(6, voff, t)
    }
}

proc parse_pat() {               ; (Con v0 v1...) | var
    skip_ws()
    state chk { to pcon when (cbyte() == '(')  to atom }
    state pcon {
        adv()
        skip_ws()
        let coff = word[2097144]
        skip_ident()
        let vars = parse_pvars()
        skip_ws()
        adv()                    ; ')'
        to known_nil when (is_nil_name(coff) == 1)
        to known_cons when (is_cons_name(coff) == 1)
        return alloc3(10, coff, vars)      ; PCON
    }
    state known_nil { return alloc3(12, coff, vars) }
    state known_cons { return alloc3(14, coff, vars) }
    state atom {
        let voff = word[2097144]
        skip_ident()
        to nullcon when (is_upper(byte[2097152 + voff]) == 1)
        return alloc2(9, voff)          ; PVAR (binds anything)
    }
    state nullcon {
        to atom_nil when (is_nil_name(voff) == 1)
        to atom_cons when (is_cons_name(voff) == 1)
        return alloc3(10, voff, 0)
    }
    state atom_nil { return alloc3(12, voff, 0) }
    state atom_cons { return alloc3(14, voff, 0) }
}

proc parse_arms() {              ; (pat body) pairs until ')', a CONS of ARM nodes
    skip_ws()
    state chk { to more when (cbyte() != ')')  return 0 }
    state more {
        adv()                    ; '('
        let pat = parse_pat()
        let body = parse_expr()
        skip_ws()
        adv()                    ; ')'
        let t = parse_arms()
        return alloc3(6, alloc3(11, pat, body), t)
    }
}

proc parse_def() {               ; (def NAME (PARAMS) BODY) -> add to the func table
    adv()                        ; '('
    skip_ws()
    skip_ident()                 ; "def"
    skip_ws()
    let noff = word[2097144]
    skip_ident()
    skip_ws()
    adv()                        ; '('
    let params = parse_params()
    skip_ws()
    adv()                        ; ')'
    let body = parse_expr()
    skip_ws()
    adv()                        ; ')'
    let i = word[2097120]
    word[6291456 + i * 24] = noff
    word[6291456 + i * 24 + 8] = params
    word[6291456 + i * 24 + 16] = body
    word[2097120] = i + 1
    return 0
}

proc is_def() {
    state chk { to paren when (cbyte() == '(')  return 0 }
    state paren {
        let save = word[2097144]
        adv()
        skip_ws()
        let r = name_is3(word[2097144], 'd', 'e', 'f')
        word[2097144] = save
        return r
    }
}

proc func_lookup(noff) {
    let n = word[2097120]
    let i = 0
    state loop {
        to done when (i < n)
        return 0 - 1
    }
    state done {
        to hit when (name_eq(noff, word[6291456 + i * 24]) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
}

; Resolve a call AST once, then memoize the immutable function-table index in
; its private f0 word as `-index-1`. Function declarations are fixed after
; parsing, so this removes repeated global name scans without changing Gamma
; evaluation, call order, or fuel accounting.
proc resolve_call(expr) {
    let ref = word[expr + 8]
    state cached { to hit when (ref < 0)  to lookup }
    state hit { return 0 - ref - 1 }
    state lookup {
        let fi = func_lookup(ref)
        to missing when (fi < 0)
        word[expr + 8] = 0 - fi - 1
        return fi
    }
    state missing { return 0 - 1 }
}

; ---- environment (named bindings; lookup is frame-local) ----

proc env_push(off, val) {
    let n = word[2097112]
    word[7340032 + n * 16] = off
    word[7340032 + n * 16 + 8] = val
    word[2097112] = n + 1
}

; A variable AST has one fixed lexical position inside one parsed function
; body. Gamma has no closures and lookup never crosses the current frame,
; so the binding's slot relative to the frame base is invariant across calls
; and recursive re-entry. Resolve its source name once, then keep `-slot-1` in
; the interpreter-private AST word, as resolve_call does for function indexes.
; Unbound variables retain their source offset and continue to evaluate to 0.
proc resolve_var(expr) {
    let ref = word[expr + 8]
    state cached { to hit when (ref < 0)  to lookup }
    state hit {
        let slot = 0 - ref - 1
        return word[7340032 + (word[2097104] + slot) * 16 + 8]
    }
    state lookup {
        let j = word[2097112] - 1
        let base = word[2097104]
        state loop {
            to miss when (j < base)
            let boff = word[7340032 + j * 16]
            to named when (boff >= 0)
            to next
        }
        state named { to found when (name_eq(ref, boff) == 1)  to next }
        state found {
            word[expr + 8] = 0 - (j - base) - 1
            return word[7340032 + j * 16 + 8]
        }
        state next { j = j - 1  to loop }
        state miss { return 0 }
    }
}

; ---- evaluator (fuel-bounded) ----

proc eval_args(args, fuel) {         ; AST arg-CONS -> value-CONS (evaluated)
    state chk { to more when (args != 0)  return 0 }
    state more {
        let h = eval_positive(word[args + 8], fuel)
        let t = eval_args(word[args + 16], fuel)
        return alloc3(6, h, t)
    }
}

; Evaluate call arguments left-to-right into a bounded evaluator-private stack.
; A nested call starts above its caller's pending arguments and restores its own
; mark after binding, so no source-visible Gamma value aliases this storage.
proc eval_scratch_args(args, fuel) {
    state loop {
        to done when (args == 0)
        to exhausted when (word[2097096] == 14684192)
        let h = eval_positive(word[args + 8], fuel)
        to exhausted when (word[2097088] != 0)
        word[word[2097096]] = h
        word[2097096] = word[2097096] + 8
        args = word[args + 16]
        to loop
    }
    state exhausted { word[2097088] = 1  return 0 }
    state done { return 0 }
}

proc bind_scratch_args(fi, values) {
    let p = word[6291456 + fi * 24 + 8]
    state loop {
        to body when (p != 0)
        return 0
    }
    state body {
        env_push(word[p + 8], word[values])
        p = word[p + 16]
        values = values + 8
        to loop
    }
}

; Select a match arm for tail evaluation. Successful pattern bindings deliberately
; stay in the current frame; eval_call discards the whole frame when the tail chain
; finishes or transfers to another function.
proc tail_match_body(scrut, arms, fuel) {
    let sv = eval_positive(scrut, fuel)
    let arm = arms
    state loop {
        to body when (arm != 0)
        return 0
    }
    state body {
        let armnode = word[arm + 8]
        let savedepth = word[2097112]
        to matched when (try_match(word[armnode + 8], sv) == 1)
        word[2097112] = savedepth
        arm = word[arm + 16]
        to loop
    }
    state matched { return word[armnode + 16] }
}

; Reduce tail-position control iteratively. This is the evaluator's proper tail-call
; boundary: generated Gamma state machines and ordinary functional loops no longer
; consume one Beta/Alpha return frame per logical iteration.
proc eval_tail(expr, fuel) {
    state loop {
        to arena_exhausted when (word[2097080] != 0)
        to exhausted when (fuel <= 0)
        let tag = word[expr]
        to tail_let when (tag == 4)
        to tail_if when (tag == 3)
        to tail_call when (tag == 5)
        to tail_match when (tag == 8)
        return eval_positive(expr, fuel)
    }
    state arena_exhausted { return 14684256 }
    state exhausted { return 0 - 2 }
    state tail_let {
        let lv = eval_positive(word[expr + 16], fuel)
        env_push(word[expr + 8], lv)
        expr = word[expr + 24]
        to loop
    }
    state tail_if {
        let cond = eval_positive(word[expr + 8], fuel)
        to tail_if_immediate when (cond < 0 - 1)
        to tail_if_boxed
    }
    state tail_if_immediate {
        to tail_then when (cond != 0 - 2)
        expr = word[expr + 24]
        to loop
    }
    state tail_if_boxed {
        to tail_then when (get_int(cond) != 0)
        expr = word[expr + 24]
        to loop
    }
    state tail_then {
        expr = word[expr + 16]
        to loop
    }
    state tail_match {
        let chosen = tail_match_body(word[expr + 8], word[expr + 16], fuel)
        to tail_no_match when (chosen == 0)
        expr = chosen
        to loop
    }
    state tail_no_match { return 0 - 2 }
    state tail_call {
        let values = word[2097096]
        eval_scratch_args(word[expr + 16], fuel)
        word[14684200] = resolve_call(expr)
        word[14684208] = values
        word[14684216] = word[2097096]
        return 14684192
    }
}

proc eval_call(fi, args, fuel) {
    let base = word[2097112]         ; env depth before args
    let savebase = word[2097104]
    let values = word[2097096]
    eval_scratch_args(args, fuel)
    state install {
        to exhausted when (word[2097088] != 0)
        word[2097112] = base
        word[2097104] = base
        bind_scratch_args(fi, values)
        word[2097096] = values
        to body
    }
    state body {
        let r = eval_tail(word[6291456 + fi * 24 + 16], fuel - 1)
        to exhausted when (word[2097088] != 0)
        to tail when (r == 14684192)
        word[2097112] = base
        word[2097104] = savebase
        return r
    }
    state exhausted {
        word[2097096] = values
        word[2097112] = base
        word[2097104] = savebase
        return mk_int(0)
    }
    state tail {
        fi = word[r + 8]
        values = word[r + 16]
        fuel = fuel - 1
        to install
    }
}

proc eval_conapp(con, args, fuel) {
    state cons_name {
        to cons_arity when (is_cons_name(con) == 1)
        to generic
    }
    state cons_arity {
        to generic when (args == 0)
        let rest = word[args + 16]
        to generic when (rest == 0)
        to generic when (word[rest + 16] != 0)
        to compact
    }
    state compact {
        ; Preserve source argument evaluation order while avoiding the two
        ; value-arglist nodes of the generic constructor representation.
        let h = eval_positive(word[args + 8], fuel)
        let t = eval_positive(word[rest + 8], fuel)
        return alloc_cons(h, t)
    }
    state generic {
        return alloc3(101, con, eval_args(args, fuel))
    }
}

proc try_match_compact_cons(pat, val) {
    let payload = val - 201326592
    state bind {
        let pv = word[pat + 16]
        to no when (pv == 0)
        env_push(word[pv + 8], word[payload])
        pv = word[pv + 16]
        to no when (pv == 0)
        env_push(word[pv + 8], word[payload + 8])
        pv = word[pv + 16]
        to no when (pv != 0)
        return 1
    }
    state no { return 0 }
}

; try to match pattern `pat` against value `val`; on success push its bindings.
proc try_match(pat, val) {
    let ptag = word[pat]
    let vtag = 0
    state isvar { to pvar when (ptag == 9)  to iscon }
    state pvar {                     ; PVAR — binds anything to the whole value
        env_push(word[pat + 8], val)
        return 1
    }
    state iscon {
        vtag = value_tag(val)
        to nullary_ast when (vtag == 7)
        to compact_cons when (vtag == 102)
        to no when (vtag != 101)        ; PCON needs a constructor value
        to namechk
    }
    state nullary_ast {
        to nullary_nil when (ptag == 12)
        to no when (name_eq(word[pat + 8], word[val + 8]) == 0)
        to no when (word[pat + 16] != 0)
        return 1
    }
    state nullary_nil {
        to no when (is_nil_name(word[val + 8]) == 0)
        to no when (word[pat + 16] != 0)
        return 1
    }
    state compact_cons {
        to no when (ptag != 14)
        return try_match_compact_cons(pat, val)
    }
    state no { return 0 }
    state namechk {
        to no when (name_eq(word[pat + 8], word[val + 8]) == 0)   ; constructor must match
        to bind
    }
    state bind {
        let pv = word[pat + 16]      ; pattern var offsets
        let av = word[val + 16]      ; constructor arg values
        to bindloop
    }
    state bindloop {
        to bindbody when (pv != 0)
        to no when (av != 0)
        return 1
    }
    state bindbody {
        to no when (av == 0)
        env_push(word[pv + 8], word[av + 8])
        pv = word[pv + 16]
        av = word[av + 16]
        to bindloop
    }
}

proc eval_match(scrut, arms, fuel) {
    let sv = eval_positive(scrut, fuel)
    let arm = arms
    let result = 0
    state loop {
        to body when (arm != 0)
        return result               ; no arm matched
    }
    state body {
        let armnode = word[arm + 8]
        let savedepth = word[2097112]
        to matched when (try_match(word[armnode + 8], sv) == 1)
        word[2097112] = savedepth
        arm = word[arm + 16]
        to loop
    }
    state matched {
        result = eval_positive(word[armnode + 16], fuel)
        word[2097112] = savedepth
        return result
    }
}

; Establish the positive-fuel invariant once at the external evaluator entry.
; Recursive expression evaluation preserves it; eval_tail rejects zero before
; re-entering the core; and eval_call decrements only before eval_tail.
proc eval(expr, fuel) {
    state chk { to positive when (fuel >= 1)  return 0 }
    state positive { return eval_positive(expr, fuel) }
}

; Fuel is positive on entry. Keep exhaustion at the decrement boundary instead
; of rechecking it for every literal, variable, operand, and constructor child.
proc eval_positive(expr, fuel) {
    state arena { to arena_exhausted when (word[2097080] != 0)  to live }
    state arena_exhausted { return 14684256 }
    state live {
        let tag = word[expr]
        to t_int when (tag == 0)
        to t1
    }
    state t_int {                                          ; INT literal -> VINT
        ; Mirror mk_int's canonical immediate range locally on this hot path.
        ; Focused boundary tests pin -1, both u32 bounds, and boxed fallbacks.
        let n = word[expr + 8]
        to t_int_negative when (n < 0)
        to t_int_high
    }
    state t_int_negative {
        to t_int_minus_one when (n == 0 - 1)
        return alloc2(100, n)
    }
    state t_int_minus_one { return 14684288 }
    state t_int_high {
        to t_int_boxed when (n > 4294967295)
        return 0 - n - 2
    }
    state t_int_boxed { return alloc2(100, n) }
    state t1 { to t_var when (tag == 1)  to t2 }
    state t_var {
        ; After the first lookup, the immutable AST word is `-slot-1` relative
        ; to the current function frame. Keep the hot read in the evaluator;
        ; unresolved and unbound names retain the complete fallback.
        let ref = word[expr + 8]
        to t_var_cached when (ref < 0)
        return resolve_var(expr)
    }
    state t_var_cached {
        let slot = 0 - ref - 1
        return word[7340032 + (word[2097104] + slot) * 16 + 8]
    }
    state t2 { to t_prim when (tag == 2)  to t3 }
    state t_prim {                   ; PRIM op a b (on integers)
        let av = eval_positive(word[expr + 16], fuel)
        let a = 0
        let b = 0
        to prim_a_immediate when (av < 0 - 1)
        to prim_a_boxed
    }
    state prim_a_immediate {
        a = 0 - av - 2
        to prim_b_eval
    }
    state prim_a_boxed {
        a = get_int(av)
        to prim_b_eval
    }
    state prim_b_eval {
        let bv = eval_positive(word[expr + 24], fuel)
        to prim_b_immediate when (bv < 0 - 1)
        to prim_b_boxed
    }
    state prim_b_immediate {
        b = 0 - bv - 2
        to prim_dispatch
    }
    state prim_b_boxed {
        b = get_int(bv)
        to prim_dispatch
    }
    state prim_dispatch {
        let op = word[expr + 8]
        to p_add when (op == '+')
        to p1
    }
    state p_add { a = a + b  to p_pack }
    state p1 { to p_sub when (op == '-')  to p2 }
    state p_sub { a = a - b  to p_pack }
    state p2 { to p_mul when (op == '*')  to p3 }
    state p_mul { a = a * b  to p_pack }
    state p3 { to p_div when (op == '/')  to p4 }
    state p_div { a = a / b  to p_pack }
    state p4 { to p_mod when (op == '%')  to p5 }
    state p_mod { a = a % b  to p_pack }
    state p_pack { to p_pack_boxed when (a < 0)  to p_pack_high }
    state p_pack_high {
        to p_pack_boxed when (a > 4294967295)
        return 0 - a - 2
    }
    state p_pack_boxed { return mk_int(a) }
    state p5 { to p_eq when (op == 'e')  to p6 }
    state p_eq {
        to p_eq1 when (a == b)
        return 0 - 2
    }
    state p_eq1 { return 0 - 3 }
    state p6 { to p_lt when (op == 'l')  return 0 - 2 }
    state p_lt {
        to p_lt1 when (a < b)
        return 0 - 2
    }
    state p_lt1 { return 0 - 3 }
    state t3 { to t_if when (tag == 3)  to t4 }
    state t_if {                     ; IF c t e
        let cond = eval_positive(word[expr + 8], fuel)
        to if_immediate when (cond < 0 - 1)
        to if_boxed
    }
    state if_immediate {
        to if_then when (cond != 0 - 2)
        return eval_positive(word[expr + 24], fuel)
    }
    state if_boxed {
        to if_then when (get_int(cond) != 0)
        return eval_positive(word[expr + 24], fuel)
    }
    state if_then { return eval_positive(word[expr + 16], fuel) }
    state t4 { to t_let when (tag == 4)  to t5 }
    state t_let {                    ; LET off e body
        let v = eval_positive(word[expr + 16], fuel)
        env_push(word[expr + 8], v)
        let r = eval_positive(word[expr + 24], fuel)
        word[2097112] = word[2097112] - 1
        return r
    }
    state t5 { to t_call when (tag == 5)  to t7 }
    state t_call { return eval_call(resolve_call(expr), word[expr + 16], fuel) }
    state t7 { to t_conapp when (tag == 7)  to t8 }
    state t_conapp {
        ; Immutable nullary constructor syntax is already the complete value;
        ; reusing it avoids allocating identical nullary values in loops.
        to t_nullcon when (word[expr + 16] == 0)
        return eval_conapp(word[expr + 8], word[expr + 16], fuel)
    }
    state t_nullcon { return expr }
    state t8 { to t_match when (tag == 8)  return 0 }
    state t_match { return eval_match(word[expr + 8], word[expr + 16], fuel) }
}

; ---- print a value (so a program can return data, not just an int) ----

proc emit_dec(n) {
    state neg { to do_neg when (n < 0)  to big }
    state do_neg {
        write_byte('-')
        emit_dec(0 - n)
        return 0
    }
    state big {
        to rec when (n >= 10)
        to digit
    }
    state rec { emit_dec(n / 10)  to digit }
    state digit {
        write_byte(n % 10 + '0')
        return 0
    }
}

proc print_con_name(off) {           ; the constructor name lives at SRC[off]
    let i = 0
    state loop {
        to body when (is_delim(byte[2097152 + off + i]) == 0)
        return 0
    }
    state body {
        write_byte(byte[2097152 + off + i])
        i = i + 1
        to loop
    }
}

proc print_value(v) {
    let tag = value_tag(v)
    state vint { to do_int when (tag == 100)  to vcons }
    state do_int { emit_dec(get_int(v))  return 0 }
    state vcons { to nullary_ast when (tag == 7)  to compact_cons_check }
    state nullary_ast { print_con_name(word[v + 8])  return 0 }
    state compact_cons_check { to compact_cons when (tag == 102)  to vcon }
    state compact_cons {
        emit("(Cons ")
        print_value(word[v - 201326592])
        write_byte(' ')
        print_value(word[v - 201326584])
        write_byte(')')
        return 0
    }
    state vcon {
        let args = word[v + 16]      ; VCON con_off arglist
        to nullary when (args == 0)
        to applied
    }
    state nullary { print_con_name(word[v + 8])  return 0 }   ; just its name
    state applied {
        write_byte('(')
        print_con_name(word[v + 8])
        to argloop
    }
    state argloop {
        to argbody when (args != 0)
        write_byte(')')
        return 0
    }
    state argbody {
        write_byte(' ')
        print_value(word[args + 8])
        args = word[args + 16]
        to argloop
    }
}

proc main() {
    let slurp_status = slurp()
    state source {
        to source_exhausted when (slurp_status != 0)
        to start
    }
    state source_exhausted { return 252 }
    state start { skip_ws()  to defloop }
    state defloop {
        to defbody when (is_def() == 1)
        to run
    }
    state defbody {
        parse_def()
        to arena_exhausted when (word[2097080] != 0)
        skip_ws()
        to defloop
    }
    state run {
        let expr = parse_expr()
        let result = eval(expr, 50000000)           ; fuel is an upper bound on calls, not a cost;
                                                    ; programs that terminate sooner are unaffected.
        to arena_exhausted when (word[2097080] != 0)
        to argument_exhausted when (word[2097088] != 0)
        print_value(result)          ; render the value (int or constructor tree)
        write_byte(10)
        return get_int(result)       ; and deliver an int result as the exit code
    }
    state arena_exhausted { return 254 }
    state argument_exhausted { return 253 }
}
