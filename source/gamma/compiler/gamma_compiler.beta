; gamma_compiler.beta - canonical Beta-written Gamma compiler (in progress).
;
; The strict parser, declaration tables, coordinate custody, and static checks
; below are retained compiler frontend material. The current gate supplies a
; temporary frontend-only entry; no compiler tape or emitted-program adapter is
; published until the remaining lowering and D19 application-adapter work is
; complete.
;
; Builtin Int/Bytes + top-level functions with typed params and a declared return
; type; arithmetic/comparisons are Int x Int -> Int, `if` wants an Int condition and
; equal branches, `let` binds the synthesised type, a call checks arg types + arity,
; and the six closed Bytes primitives have their D16 signatures. Data declarations
; (ADTs) and exhaustive `match` provide the nominal surface.
;
; Surface (prefix; Int is builtin, every binder annotated):
;   program := (data T (C TYPE...)...)*  (def NAME ((PARAM TYPE)...) RETTYPE EXPR)*
; The temporary frontend gate maps a fully well-typed program to exit 1 and a
; type error to exit 0. The final compiler output boundary is not implemented.
;
; CONTROL FLOW is CFG/Omega-shaped: each proc is a set of `state` basic blocks linked
; by guarded `to ... when ...` transitions - no if/while.
;
; Memory:  2097152 SRC  2097144 CUR  2097136 LEN  2097128 APTR  2097120 NFUN
;          2097112 TENVN 2097104 NTY 2097096 NCON 2097088 INVALID_TYPE
;          2097080 MATCH_EPOCH 2097072 RESOURCE_FAILED 2097064 PARSE_DEPTH
;          2097056 FAIL_OFF 2097048 NODE_OFF 2097040 PAYLOAD_LEN
;          2097032 LABEL_COUNT 2097024 FIXUP_COUNT 2097016 EMIT_FAILURE
;          2097008 EMIT_FAILURE_COORDINATE
;          2097000 STACK_HELPER_LABEL 2096992 ADD_LABEL 2096984 SUB_LABEL
;          2096976 MUL_LABEL 2096968 DIV_LABEL 2096960 MOD_LABEL
;          2096952 HEAP_LABEL 2096944 BYTES_SINGLE_LABEL
;          2096936 BYTES_LENGTH_LABEL 2096928 BYTES_GET_LABEL
;          2096920 BYTES_SLICE_LABEL 2096912 BYTES_CONCAT_LABEL
;          2096904 CALL_RESOURCE_LABEL
;          2096896 NEXT_LOCAL_SLOT 2096888 MAX_LOCAL_SLOTS
;          2096880 CURRENT_FRAME_PREFIX 2096872 CURRENT_PARAMETER_COUNT
;          2096864 RUNTIME_INTERNAL_LABEL
;          6291456 TYNAMES [6 MiB,6.5 MiB)
;          6815744 CONS [6.5 MiB,8 MiB)  8388608 FUNS [8 MiB,9 MiB)
;          9437184 TENV [9 MiB,10 MiB)  10485760 COVERAGE [10 MiB,10.5 MiB)
;          11010048 LABELS [10.5 MiB,11 MiB)
;          11534336 FIXUPS [11 MiB,13 MiB); 116508 x 16-byte rows
;          16777216 ERROR_NODE + ARENA [16 MiB,125 MiB)
;          132120576 PAYLOAD_STARTS [126 MiB,127 MiB)
;          133169152 PAYLOAD [127 MiB,128 MiB)
; "type" = small id: Int = 0, Bytes = 1, nominal types start at 2.
; AST nodes 4 words: [source_off * 256 + tag, f0, f1, f2]. Func entry 4 words
; [name_off, params, packed profile, body]; PARAM [50, name_off, tyid, index+1].
; TENV [name_off, tyid + 65536 + local_kind*131072 + index*262144].
; Function profile = return_tyid + max_live_locals*65536 + parameter_count*4294967296.
; AST tags: 0 INT 1 VAR 2 PRIM 3 IF 4 LET 5 CALL 6 CONS 7 CONAPP 8 MATCH
;           9 PVAR 10 PCON 11 ARM 50 PARAM
; Checked CALL/CONAPP/PCON nodes retain one-based function/constructor table
; identities in f2; zero remains the unresolved or builtin sentinel.

proc source_byte_allowed(c) {
    state ht { to yes when (c == 9)  to lf }
    state lf { to yes when (c == 10)  to cr }
    state cr { to yes when (c == 13)  to printable_low }
    state printable_low { to no when (c < 32)  to printable_high }
    state printable_high { to no when (c > 126)  return 1 }
    state yes { return 1 }
    state no { return 0 }
}

proc slurp() {
    let n = 0
    word[2097088] = 0        ; INVALID_TYPE
    word[2097056] = 0        ; FAIL_OFF (meaningful when INVALID_TYPE != 0)
    word[2097048] = 0        ; NODE_OFF for the next AST allocation
    let c = read_byte()
    state loop {
        to body when (c >= 0)
        to done
    }
    state body {
        to exhausted when (n == 4194304)
        to invalid when (source_byte_allowed(c) == 0)
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
        to loop
    }
    state done {
        word[2097136] = n
        word[2097144] = 0
        ; Keep one readable zero node as the return value of a failed allocation.
        ; The real arena begins after it and ends at the reserved 125 MiB
        ; compiler boundary. AlphaBootstrapV2 gives Beta programs 128 MiB of
        ; biased logical raw memory; final replay scratch and payload own its
        ; last two MiB with a one-MiB guard between arena and scratch.
        word[16777216] = 255      ; reserved immutable error-node tag
        word[16777224] = 0
        word[16777232] = 0
        word[16777240] = 0
        word[2097128] = 16777248
        word[2097120] = 0        ; NFUN
        word[2097112] = 0        ; TENVN
        word[2097104] = 2        ; NTY (id 0 = Int, id 1 = Bytes)
        word[2097096] = 0        ; NCON
        word[2097080] = 0        ; MATCH_EPOCH
        word[2097072] = 0        ; RESOURCE_FAILED
        word[2097064] = 0        ; PARSE_DEPTH
        return 0
    }
    state invalid { mark_invalid_at(n)  return 1 }
    state exhausted { return 2 }
}

proc cbyte() {
    let i = word[2097144]
    state chk { to hit when (i < word[2097136])  return 0 }
    state hit { return byte[2097152 + i] }
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

proc is_space(c) {
    state c1 { to yes when (c == ' ')  to c2 }
    state c2 { to yes when (c == 9)    to c3 }
    state c3 { to yes when (c == 10)   to c4 }
    state c4 { to yes when (c == 13)   return 0 }
    state yes { return 1 }
}

proc skip_ws() {
    let go = 1
    state loop {
        to done when (go == 0)
        let c = cbyte()
        to sp when (is_space(c) == 1)
        to semi
    }
    state sp { adv()  to loop }
    state semi {
        to cmt when (c == ';')
        go = 0
        to loop
    }
    state cmt {
        to loop when (cbyte() == 10)
        to loop when (cbyte() == 13)
        to ceof when (cbyte() == 0)
        adv()
        to cmt
    }
    state ceof { return 0 }
    state done { return 0 }
}

proc is_digit(c) {
    state c1 { to no when (c < '0')  to c2 }
    state c2 { to no when (c > '9')  return 1 }
    state no { return 0 }
}

proc is_ident_start(c) {
    state underscore { to yes when (c == '_')  to upper_low }
    state upper_low { to lower_low when (c < 'A')  to upper_high }
    state upper_high { to yes when (c <= 'Z')  to lower_low }
    state lower_low { to no when (c < 'a')  to lower_high }
    state lower_high { to no when (c > 'z')  return 1 }
    state yes { return 1 }
    state no { return 0 }
}

proc is_ident_continue(c) {
    state start { to yes when (is_ident_start(c) == 1)  to digit }
    state digit { to yes when (is_digit(c) == 1)  return 0 }
    state yes { return 1 }
}

proc is_op(c) {
    state c1 { to yes when (c == '+')  to c2 }
    state c2 { to yes when (c == '-')  to c3 }
    state c3 { to yes when (c == '*')  to c4 }
    state c4 { to yes when (c == '/')  to c5 }
    state c5 { to yes when (c == '%')  return 0 }
    state yes { return 1 }
}

proc skip_ident() {
    state first {
        to body when (is_ident_start(cbyte()) == 1)
        return 0
    }
    state loop {
        to body when (is_ident_continue(cbyte()) == 1)
        return 0
    }
    state body { adv()  to loop }
}

proc mark_invalid_at(off) {
    state first {
        to recorded when (word[2097088] != 0)
        word[2097056] = off
        to recorded
    }
    state recorded { word[2097088] = 1  return 0 }
}

proc mark_invalid() {
    return mark_invalid_at(word[2097144])
}

proc mark_resource_failed() {
    word[2097072] = 1
    return 0
}

proc take_ident() {
    skip_ws()
    let off = word[2097144]
    state valid {
        to consume when (is_ident_start(cbyte()) == 1)
        to invalid
    }
    state consume { skip_ident()  return off }
    state invalid {
        mark_invalid()
        to advance_bad when (cbyte() != 0)
        return off
    }
    state advance_bad { adv()  return off }
}

proc consume_expected(c) {
    skip_ws()
    state valid { to consume when (cbyte() == c)  to invalid }
    state consume { adv()  return 1 }
    state invalid {
        mark_invalid()
        to advance_bad when (cbyte() != 0)
        return 0
    }
    state advance_bad { adv()  return 0 }
}

proc parse_integer() {
    let start = word[2097144]
    let negative = 0
    state sign {
        to minus when (cbyte() == '-')
        to digits
    }
    state minus { negative = 1  adv()  to digits }
    state digits {
    let v = 0
        to loop
    }
    state loop {
        to body when (is_digit(cbyte()) == 1)
        to done
    }
    state body {
        let d = cbyte() - '0'
        to overflow when (v > 922337203685477580)
        to edge when (v == 922337203685477580)
        to append
    }
    state edge {
        to positive_edge when (negative == 0)
        to overflow when (d > 8)
        to append
    }
    state positive_edge { to overflow when (d > 7)  to append }
    state append { v = v * 10 + d  adv()  to loop }
    state overflow {
        mark_invalid_at(word[2097144])
        ; Consume the rest of the literal so the parser still makes progress.
        to consume
    }
    state consume {
        to consume_digit when (is_digit(cbyte()) == 1)
        return 0
    }
    state consume_digit { adv()  to consume }
    state done { to negate when (negative == 1)  return v }
    state negate { return 0 - v }
}

proc alloc(tag, f0, f1, f2) {
    let p = word[2097128]
    state capacity { to write when (p <= 131071968)  to exhausted }
    state write {
    word[p] = word[2097048] * 256 + tag
    word[p + 8] = f0
    word[p + 16] = f1
    word[p + 24] = f2
    word[2097128] = p + 32
    return p
    }
    state exhausted { mark_resource_failed()  return 16777216 }
}

proc name_eq(o1, o2) {
    let i = 0
    state loop {
        let c1 = byte[2097152 + o1 + i]
        let c2 = byte[2097152 + o2 + i]
        to end1 when (is_ident_continue(c1) == 0)
        to end2 when (is_ident_continue(c2) == 0)
        to diff when (c1 != c2)
        i = i + 1
        to loop
    }
    state end1 { return 1 - is_ident_continue(c2) }
    state end2 { return 0 }
    state diff { return 0 }
}

; Match one closed ASCII identifier from up to two little-endian eight-byte
; words. The packed spelling is compiler source data, not emitted-program data.
proc name_is_packed(off, low, high, length) {
    let i = 0
    let remaining = low
    state loop {
        to exact when (i == length)
        to upper when (i == 8)
        to byte_check
    }
    state upper { remaining = high  to byte_check }
    state byte_check {
        let expected = remaining % 256
        to no when (byte[2097152 + off + i] != expected)
        remaining = remaining / 256
        i = i + 1
        to loop
    }
    state exact { return 1 - is_ident_continue(byte[2097152 + off + length]) }
    state no { return 0 }
}
; D19's exact source-owned Delta schema contains identifiers longer than the
; ordinary two-word keyword matcher. Codes 1..26 are the ruled DCOUT v1
; rejection bijection, followed by the two nominal types and four outcome
; constructors. Initialize this private compile-time table only while checking
; the selected schema; later function labels and retained D19 identities reuse
; COVERAGE without deriving any code from declaration order or hashing.
proc d19_initialize_name_table() {
    word[10747904] = 17
