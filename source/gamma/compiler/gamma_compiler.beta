; gamma_compiler.beta - canonical Beta-written compiler for Gamma.
;
; Normative source (GAMMA-FLATTENED-CFG-INITIALIZATION):
;   proc IDENT(PARAMS) BLOCK
;   BLOCK := '{' ORDINARY* STATE* '}'
;   STATE := 'state' IDENT BLOCK
;   ORDINARY := 'let' IDENT '=' EXPR | IDENT '=' EXPR | 'return' EXPR
;             | 'to' IDENT ('when' EXPR)?
;             | ('byte'|'word') '[' EXPR ']' '=' EXPR
;             | IDENT '(' ARGS ')' | 'emit' '(' STRING ')'
;   EXPR := SUM (('<'|'>'|'=='|'!='|'<='|'>=') SUM)?
;   SUM := TERM (('+' | '-') TERM)*
;   TERM := FACTOR (('*' | '/' | '%') FACTOR)*
;   FACTOR := DECIMAL | CHAR | IDENT | IDENT(ARGS)
;           | ('byte'|'word') '[' EXPR ']' | '(' EXPR ')'
;
; Whitespace and `;` line comments are accepted between tokens. Decimal
; literals are checked across the complete unsigned 64-bit Word range. Character
; literals accept printable bytes plus \n \t \r \0 \\ \'. The whole source is
; validated before any output is published. Nested STATE rows emit in normative
; depth-first lexical order; formation, combined-depth, reachability, and
; fixed-point initialization checks complete before replay.
;
; Globals (i64):
;   524288 LEN       524296 CUR       524304 ERROR     524312 EMIT
;   524320 NAMESTART 524328 NAMELEN   524336 EXPECT    524344 EXPECTLEN
;   524352 BOUNDARY  524360 EXPECTCHR
;   524392 DEPTH     524400 OUTLEN     524408 PROC_COUNT
;   524416 CALL_COUNT 524424 SLOT_COUNT 524432 CURPROCSTART
;   524440 CURPROCLEN 524448 CURPROCINDEX 524456 ARGCOUNT
;   524464 TMPSTART  524472 TMPLEN     524480 PROC_CURSOR
;   524488 TARGET_SLOT/scan flag      524496 SCAN
;   524504 CMPLEN    524536 LABEL_COUNT
;   524544 LABEL_A   524552 LABEL_B   524560 INVERT
;   524568 STATE_COUNT 524576 EDGE_COUNT 524584 ASSIGN_SLOT
;   524592 PROC_STATE_COUNT 524600 PROC_EDGE_COUNT
;   524608 STATE_CURSOR 524616 EDGE_CURSOR 524624 CALL_CURSOR
;   524640 STORE_WIDTH 524648 MAIN_PROC 524656 FIXUP_COUNT
;   524664 EXPECT_OUTLEN 524672 MEM_ADDR_REG 524680 MEM_LIMIT
;   524688 U64_SCRATCH 524696 U64_INDEX
;   524704 MEM_GUARD_ID 524712 MEM_GUARD_NEEDED
;   524720 MEM_SITE_LABEL 524728 STACK_FAULT_LABEL 524736 STACK_BYTES
;   524744 OUTCOME_CODE 524752 OUTCOME_SPACE 524760 OUTCOME_COORD
;   524768 OUTCOME_LIMIT 524776 OUTCOME_REQUESTED
;   524784 INIT_BLOCK_ID 524792 STMT_TERMINATOR
;   524800 INIT_CHANGED 524808 INIT_PROC 524816 INIT_FIRST_STATE
;   524824 INIT_STATE_TOTAL 524832 INIT_BLOCK_COUNT 524840 INIT_LOCAL
;   524848 INIT_EDGE 524856 INIT_SLOT 524864 INIT_SOURCE_LOCAL
;   524872 INIT_TARGET_LOCAL 524880 INIT_FIRST_EDGE 524888 INIT_EDGE_TOTAL
; Buffers. D58 leaves these canonical addresses and limits unchanged until the
; complete Delta compiler selects and atomically publishes a measured profile.
; Any changed count tables and derived initialization rows then move to one new
; aligned private region above FIXUP_TABLE rather than repacking this block.
;   1048576 SOURCE (1048576-byte checked compiler extent)
;   550000 CALL_TABLE (1024 x 24: start, len, argc)
;   575000 CALL_TARGET_PROC (1024 x 8)
;   600000 SLOT_TABLE (64 x 16: start, len)
;   610000 NAME_STACK (64 x 24: start, len, argc)
;   620000 CMP_STACK (65 x 8: comparison opcode at depths 0..64)
;   621000 WIDTH_STACK (64 x 8: nested memory-load widths)
;   630000 STATE_TABLE (1024 x 24: start, len, proc index)
;   655360 STATE_PC (1024 x 8)
;   680000 EDGE_TABLE (1024 x 24: start, len, proc index)
;   705000 EDGE_TARGET_STATE (1024 x 8)
;   5242880 PROC_TABLE (256 x 32: start, len, params, slots)
;   5251072 PROC_PC (256 x 8)
;   5253120 INIT_PROC_FIRST_STATE (256 x 8)
;   5255168 INIT_PROC_STATE_TOTAL (256 x 8)
;   5257216 INIT_PROC_PARAM_COUNT (256 x 8)
;   5259264 INIT_PROC_FIRST_EDGE (256 x 8)
;   5261312 INIT_PROC_EDGE_TOTAL (256 x 8)
;   5308416 INIT_BLOCK_REQUIRED (1280 x 64 bytes)
;   5390336 INIT_BLOCK_GENERATED (1280 x 64 bytes)
;   5472256 INIT_EDGE_GENERATED (1024 x 64 bytes)
;   5537792 INIT_EDGE_SOURCE_BLOCK (1024 x 8)
;   5545984 INIT_BLOCK_TERMINATOR (1280 bytes: 0 fallthrough, 1 to, 2 return)
;   5548032 INIT_IN_WORK (129 x 64 reusable bytes)
;   5556288 INIT_REACH_WORK (129 reusable bytes)
;   16777216 TAPE_BUFFER (1048572-byte checked Alpha payload extent)
;   20971520 INTERNAL_PC (262144 x 8)
;   25165824 FIXUP_TABLE (116508 x 24: operand offset, kind, identity)

; ---------------- entry and checked slurp ----------------
        imm   r6, 0
read_source:
        read  r0
        imm   r1, 0
        jlt   r0, r1, source_done
        imm   r1, 1048576
        jeq   r6, r1, source_too_large
        imm   r2, 1048576
        add   r2, r6
        storeb r2, r0
        imm   r1, 1
        add   r6, r1
        jmp   read_source
source_done:
        imm   r0, 524288
        store r0, r6
        imm   r0, 524296
        imm   r1, 0
        store r0, r1
        imm   r0, 524304
        store r0, r1
        imm   r0, 524312
        store r0, r1
        imm   r0, 524392
        store r0, r1
        imm   r0, 524400
        store r0, r1
        imm   r0, 524408
        store r0, r1
        imm   r0, 524416
        store r0, r1
        imm   r0, 524568
        store r0, r1
        imm   r0, 524576
        store r0, r1
        call  validate_source_envelope
        call  error_value
        jnz   r0, invalid_source
        call  parse_program
        imm   r0, 524304
        load  r0, r0
        jnz   r0, invalid_source

        imm   r0, 524400
        load  r1, r0
        imm   r0, 524664
        store r0, r1

        ; Replay frozen semantic rows into a private Alpha tape. Nothing is
        ; published until every address fixup and extent check succeeds.
        imm   r0, 524296
        imm   r1, 0
        store r0, r1
        imm   r0, 524400
        store r0, r1
        imm   r0, 524656
        store r0, r1
        imm   r0, 524312
        imm   r1, 1
        store r0, r1
        call  parse_program
        imm   r0, 524304
        load  r0, r0
        jnz   r0, internal_error
        imm   r0, 524400
        load  r1, r0
        imm   r0, 524664
        load  r2, r0
        jeq   r1, r2, source_patch
        imm   r0, 2
        imm   r1, 2
        imm   r2, 524400
        load  r2, r2
        call  set_internal
        jmp   internal_error
source_patch:
        call  patch_fixups
        call  error_value
        jnz   r0, internal_error
        call  publish_tape
        imm   r0, 0
        halt  r0
source_too_large:
        imm   r0, 1
        imm   r1, 1048576
        imm   r2, 1048577
        imm   r3, 1
        imm   r4, 1048576
        call  set_incomplete
        jmp   publish_failure
invalid_source:
        jmp   publish_failure
internal_error:
        call  promote_internal_failure
publish_failure:
        call  publish_diagnostic
        call  error_value
        halt  r0

; ---------------- program ----------------
parse_program:
        imm   r0, 524480
        imm   r1, 0
        store r0, r1
        imm   r0, 524536
        store r0, r1
        imm   r0, 524704
        store r0, r1
        imm   r0, 524712
        store r0, r1
        imm   r0, 524608
        store r0, r1
        imm   r0, 524616
        store r0, r1
        imm   r0, 524624
        store r0, r1
        call  emit_program_prelude
pp_loop:
        call  skip_trivia
        imm   r0, 524296
        load  r1, r0
        imm   r0, 524288
        load  r2, r0
        jeq   r1, r2, pp_finish
        call  parse_proc
        call  error_value
        jnz   r0, pp_return
        jmp   pp_loop
pp_finish:
        call  emit_memory_guard_runtime
        call  error_value
        jnz   r0, pp_return
        imm   r0, 524312
        load  r0, r0
        jnz   r0, pp_check_publication
        call  validate_program
        ret
pp_check_publication:
        call  check_publication_tables
pp_return:
        ret

parse_proc:
        imm   r0, kw_proc
        imm   r1, 4
        imm   r2, 1
        call  expect_literal
        call  error_value
        jnz   r0, ppr_return
        call  parse_identifier
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524320
        load  r1, r0
        imm   r0, 524432
        store r0, r1
        imm   r0, 524328
        load  r1, r0
        imm   r0, 524440
        store r0, r1
        imm   r0, 40
        call  expect_char
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524424
        imm   r1, 0
        store r0, r1
        imm   r0, 524592
        store r0, r1
        imm   r0, 524600
        store r0, r1
        call  peek_token_char
        imm   r1, 41
        jeq   r0, r1, ppr_params_done
ppr_param_loop:
        call  parse_identifier
        call  error_value
        jnz   r0, ppr_return
        call  declare_name
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524424
        load  r0, r0
        imm   r1, 4
        jlt   r1, r0, ppr_error
        call  peek_token_char
        imm   r1, 44
        jeq   r0, r1, ppr_more_param
        jmp   ppr_params_done
ppr_more_param:
        call  consume_one
        jmp   ppr_param_loop
ppr_params_done:
        imm   r0, 41
        call  expect_char
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524312
        load  r0, r0
        jnz   r0, ppr_known_proc
        call  add_proc
        jmp   ppr_proc_ready
ppr_known_proc:
        call  select_proc
ppr_proc_ready:
        call  error_value
        jnz   r0, ppr_return
        call  begin_init_proc
        imm   r0, 123
        call  expect_char
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524312
        load  r0, r0
        jz    r0, ppr_body
        call  emit_proc_header
ppr_body:
        call  parse_block_body
        call  error_value
        jnz   r0, ppr_return
        imm   r0, 524312
        load  r0, r0
        jnz   r0, ppr_check_slots
        call  finish_proc
        call  emit_proc_header
        jmp   ppr_epilogue
ppr_check_slots:
        call  check_proc_slots
        call  error_value
        jnz   r0, ppr_return
ppr_epilogue:
        imm   r0, 0
        imm   r1, 0
        call  emit_imm
        call  emit_epilogue
        call  emit_stack_fault_block
        imm   r0, 524480
        load  r1, r0
        imm   r2, 1
        add   r1, r2
        store r0, r1
ppr_return:
        ret
ppr_error:
        call  set_error
        ret

; Parse one recursive Gamma block after its opening brace. The call frame itself
; remembers whether this block has entered its child-state suffix, so nested
; blocks need no parallel parser stack.
parse_block_body:
pbb_ordinary:
        call  peek_token_char
        imm   r1, 125
        jeq   r0, r1, pbb_close
        imm   r0, kw_state
        imm   r1, 5
        call  match_literal
        jnz   r0, pbb_state
        call  parse_statement
        call  error_value
        jnz   r0, pbb_return
        imm   r0, 524792
        load  r0, r0
        jz    r0, pbb_ordinary
        call  record_block_terminator
        jmp   pbb_state_suffix
pbb_state:
        call  parse_state_after_keyword
        call  error_value
        jnz   r0, pbb_return
pbb_state_suffix:
        call  peek_token_char
        imm   r1, 125
        jeq   r0, r1, pbb_close
        imm   r0, kw_state
        imm   r1, 5
        call  match_literal
        jz    r0, pbb_error
        call  parse_state_after_keyword
        call  error_value
        jnz   r0, pbb_return
        jmp   pbb_state_suffix
pbb_close:
        imm   r0, 125
        call  expect_char
pbb_return:
        ret
pbb_error:
        call  set_error
        ret

enter_syntax_depth:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 64
        jeq   r6, r1, esd_incomplete
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
esd_incomplete:
        imm   r0, 3
        imm   r1, 64
        imm   r2, 65
        call  set_incomplete_at_source
        ret

leave_syntax_depth:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        store r0, r6
        ret

; Parse a state declaration after its `state` keyword. State bodies consume the
; same checked recursion counter as parentheses, calls, and nested loads.
parse_state_after_keyword:
        call  parse_identifier
        call  error_value
        jnz   r0, psak_return
        imm   r0, 524312
        load  r0, r0
        jnz   r0, psak_select
        call  add_state
        call  begin_init_state
        jmp   psak_checked
psak_select:
        call  select_state
psak_checked:
        call  error_value
        jnz   r0, psak_return
        call  emit_state_label
        imm   r0, 123
        call  expect_char
        call  error_value
        jnz   r0, psak_return
        call  enter_syntax_depth
        call  error_value
        jnz   r0, psak_return
        call  parse_block_body
        call  leave_syntax_depth
psak_return:
        ret

; ---------------- statements ----------------
parse_statement:
        imm   r0, 524792
        imm   r1, 0
        store r0, r1
        imm   r0, kw_return
        imm   r1, 6
        call  match_literal
        jnz   r0, ps_return_stmt
        imm   r0, kw_let
        imm   r1, 3
        call  match_literal
        jnz   r0, ps_let
        imm   r0, kw_to
        imm   r1, 2
        call  match_literal
        jnz   r0, ps_to
        imm   r0, kw_byte
        imm   r1, 4
        call  match_literal
        jnz   r0, ps_store_byte
        imm   r0, kw_word
        imm   r1, 4
        call  match_literal
        jnz   r0, ps_store_word
        imm   r0, kw_emit
        imm   r1, 4
        call  match_literal
        jnz   r0, ps_emit
        call  parse_identifier
        call  error_value
        jnz   r0, ps_done
        call  peek_token_char
        imm   r1, 40
        jeq   r0, r1, ps_call_stmt
        call  lookup_name
        imm   r1, 524584
        store r1, r0
        call  error_value
        jnz   r0, ps_done
        imm   r0, 61
        call  expect_char
        call  error_value
        jnz   r0, ps_done
        call  parse_expr
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524584
        load  r0, r0
        call  emit_store_slot
        ret
ps_call_stmt:
        call  parse_call
        ret
ps_let:
        call  parse_identifier
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524320
        load  r1, r0
        imm   r0, 524464
        store r0, r1
        imm   r0, 524328
        load  r1, r0
        imm   r0, 524472
        store r0, r1
        imm   r0, 61
        call  expect_char
        call  error_value
        jnz   r0, ps_done
        call  parse_expr
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524464
        load  r1, r0
        imm   r0, 524320
        store r0, r1
        imm   r0, 524472
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        call  declare_name
        imm   r1, 524488
        store r1, r0
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524488
        load  r0, r0
        call  emit_store_slot
        ret
ps_return_stmt:
        call  parse_expr
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524792
        imm   r1, 2
        store r0, r1
        call  emit_epilogue
        ret
ps_to:
        call  parse_identifier
        call  error_value
        jnz   r0, ps_done
        imm   r0, 524320
        load  r1, r0
        imm   r0, 524464
        store r0, r1
        imm   r0, 524328
        load  r1, r0
        imm   r0, 524472
        store r0, r1
        imm   r0, 524312
        load  r0, r0
        jnz   r0, ps_to_select
        call  add_edge
        jmp   ps_to_checked
ps_to_select:
        call  select_edge
ps_to_checked:
        call  error_value
        jnz   r0, ps_done
ps_to_guard:
        imm   r0, kw_when
        imm   r1, 4
        call  match_literal
        jnz   r0, ps_to_when
        call  restore_tmp_name
        imm   r0, 524792
        imm   r1, 1
        store r0, r1
        call  emit_jump_target
        ret
ps_to_when:
        call  parse_expr
        call  error_value
        jnz   r0, ps_done
        call  restore_tmp_name
        call  emit_guarded_target
        ret
ps_store_byte:
        imm   r0, 524640
        imm   r1, 1
        store r0, r1
        jmp   ps_store
ps_store_word:
        imm   r0, 524640
        imm   r1, 8
        store r0, r1
ps_store:
        imm   r0, 91
        call  expect_char
        call  error_value
        jnz   r0, ps_done
        call  parse_expr
        call  error_value
        jnz   r0, ps_done
        imm   r0, 93
        call  expect_char
        call  error_value
        jnz   r0, ps_done
        imm   r0, 61
        call  expect_char
        call  error_value
        jnz   r0, ps_done
        call  emit_push
        call  parse_expr
        call  error_value
        jnz   r0, ps_done
        call  emit_memory_store
        ret
ps_emit:
        imm   r0, 40
        call  expect_char
        call  error_value
        jnz   r0, ps_done
        call  parse_emit_string
        call  error_value
        jnz   r0, ps_done
        imm   r0, 41
        call  expect_char
ps_done:
        ret

; ---------------- expression parser and Alpha lowering ----------------
parse_expr:
        call  parse_sum
        call  error_value
        jnz   r0, px_return
        call  peek_token_char
        imm   r1, 60
        jeq   r0, r1, px_lt
        imm   r1, 62
        jeq   r0, r1, px_gt
        imm   r1, 61
        jeq   r0, r1, px_eq
        imm   r1, 33
        jeq   r0, r1, px_ne
        ret
px_lt:
        call  consume_one
        call  peek_raw_char
        imm   r1, 61
        jeq   r0, r1, px_le
        imm   r6, 0
        jmp   px_right
px_le:
        call  consume_one
        imm   r6, 4
        jmp   px_right
px_gt:
        call  consume_one
        call  peek_raw_char
        imm   r1, 61
        jeq   r0, r1, px_ge
        imm   r6, 1
        jmp   px_right
px_ge:
        call  consume_one
        imm   r6, 5
        jmp   px_right
px_eq:
        call  consume_one
        imm   r0, 61
        call  expect_raw_char
        call  error_value
        jnz   r0, px_return
        imm   r6, 2
        jmp   px_right
px_ne:
        call  consume_one
        imm   r0, 61
        call  expect_raw_char
        call  error_value
        jnz   r0, px_return
        imm   r6, 3
px_right:
        mov   r7, r6
        imm   r0, 524392
        load  r6, r0
        imm   r0, 8
        mul   r0, r6
        imm   r1, 620000
        add   r0, r1
        store r0, r7
        call  emit_push
        call  parse_sum
        call  error_value
        jnz   r0, px_return
        call  emit_comparison
px_return:
        ret

parse_sum:
        call  parse_term
        call  error_value
        jnz   r0, pe_return
pe_loop:
        call  peek_token_char
        imm   r1, 43
        jeq   r0, r1, pe_add
        imm   r1, 45
        jeq   r0, r1, pe_sub
        ret
pe_add:
        call  consume_one
        call  emit_push
        call  parse_term
        call  error_value
        jnz   r0, pe_return
        imm   r0, 3
        call  emit_pop_binary
        jmp   pe_loop
pe_sub:
        call  consume_one
        call  emit_push
        call  parse_term
        call  error_value
        jnz   r0, pe_return
        imm   r0, 4
        call  emit_pop_binary
        jmp   pe_loop
pe_return:
        ret

parse_term:
        call  parse_factor
        call  error_value
        jnz   r0, pt_return
pt_loop:
        call  peek_token_char
        imm   r1, 42
        jeq   r0, r1, pt_mul
        imm   r1, 47
        jeq   r0, r1, pt_div
        imm   r1, 37
        jeq   r0, r1, pt_mod
        ret
pt_mul:
        call  consume_one
        call  emit_push
        call  parse_factor
        call  error_value
        jnz   r0, pt_return
        imm   r0, 5
        call  emit_pop_binary
        jmp   pt_loop
pt_div:
        call  consume_one
        call  emit_push
        call  parse_factor
        call  error_value
        jnz   r0, pt_return
        imm   r0, 6
        call  emit_pop_binary
        jmp   pt_loop
pt_mod:
        call  consume_one
        call  emit_push
        call  parse_factor
        call  error_value
        jnz   r0, pt_return
        imm   r0, 7
        call  emit_pop_binary
        jmp   pt_loop
pt_return:
        ret

parse_factor:
        imm   r0, kw_byte
        imm   r1, 4
        call  match_literal
        jnz   r0, pf_load_byte
        imm   r0, kw_word
        imm   r1, 4
        call  match_literal
        jnz   r0, pf_load_word
        call  peek_token_char
        imm   r1, 40
        jeq   r0, r1, pf_paren
        imm   r1, 39
        jeq   r0, r1, pf_char
        imm   r1, 48
        jlt   r0, r1, pf_error
        imm   r1, 58
        jlt   r0, r1, pf_decimal
        call  is_ident_start
        imm   r1, 1
        jeq   r0, r1, pf_identifier
        jmp   pf_error
pf_paren:
        call  consume_one
        imm   r0, 524392
        load  r1, r0
        imm   r2, 64
        jeq   r1, r2, pf_depth_incomplete
        imm   r2, 1
        add   r1, r2
        store r0, r1
        call  parse_expr
        imm   r0, 524392
        load  r1, r0
        imm   r2, 1
        sub   r1, r2
        store r0, r1
        call  error_value
        jnz   r0, pf_return
        imm   r0, 41
        call  expect_char
        ret
pf_char:
        call  parse_character
        ret
pf_decimal:
        call  parse_decimal
        ret
pf_load_byte:
        imm   r0, 1
        call  push_load_width
        jmp   pf_load
pf_load_word:
        imm   r0, 8
        call  push_load_width
pf_load:
        call  error_value
        jnz   r0, pf_return
        imm   r0, 91
        call  expect_char
        call  error_value
        jnz   r0, pf_return
        call  parse_expr
        call  error_value
        jnz   r0, pf_return
        imm   r0, 93
        call  expect_char
        call  error_value
        jnz   r0, pf_return
        call  finish_memory_load
        ret
pf_identifier:
        call  parse_identifier
        call  error_value
        jnz   r0, pf_return
        call  peek_token_char
        imm   r1, 40
        jeq   r0, r1, pf_call_factor
        call  lookup_name
        imm   r1, 524488
        store r1, r0
        call  error_value
        jnz   r0, pf_return
        imm   r0, 524488
        load  r0, r0
        call  emit_load_slot
        ret
pf_call_factor:
        call  parse_call
        ret
pf_error:
        call  set_error
pf_return:
        ret
pf_depth_incomplete:
        imm   r0, 3
        imm   r1, 64
        imm   r2, 65
        call  set_incomplete_at_source
        ret

; Parse a call after parse_identifier has retained its name and the token cursor
; is at '('. Keeping this as its own callable region prevents an internal
; parse_factor target from also becoming a procedure entry.
parse_call:
        call  push_call_name
        call  error_value
        jnz   r0, parse_call_return
        call  consume_one
        call  peek_token_char
        imm   r1, 41
        jeq   r0, r1, parse_call_done
parse_call_arg_loop:
        call  parse_expr
        call  error_value
        jnz   r0, parse_call_return
        call  emit_push
        call  increment_call_arg
        call  error_value
        jnz   r0, parse_call_return
        call  peek_token_char
        imm   r1, 44
        jeq   r0, r1, parse_call_more_arg
        jmp   parse_call_done
parse_call_more_arg:
        call  consume_one
        jmp   parse_call_arg_loop
parse_call_done:
        imm   r0, 41
        call  expect_char
        call  error_value
        jnz   r0, parse_call_return
        call  finish_call
parse_call_return:
        ret

; Record a source-local read against the current validation-pass block. A read
; satisfied by an earlier write in the same block needs no incoming fact;
; otherwise it contributes to that block's required set.
record_slot_read:
        imm   r1, 524312
        load  r1, r1
        jnz   r1, rsr_done
        mov   r7, r0
        imm   r0, 524784
        load  r6, r0
        imm   r0, 64
        mul   r0, r6
        add   r0, r7
        imm   r1, 5390336
        add   r1, r0
        loadb r2, r1
        jnz   r2, rsr_done
        imm   r1, 5308416
        add   r1, r0
        imm   r2, 1
        storeb r1, r2
rsr_done:
        ret

record_slot_write:
        imm   r1, 524312
        load  r1, r1
        jnz   r1, rsw_done
        mov   r7, r0
        imm   r0, 524784
        load  r6, r0
        imm   r0, 64
        mul   r0, r6
        add   r0, r7
        imm   r1, 5390336
        add   r1, r0
        imm   r2, 1
        storeb r1, r2
rsw_done:
        ret

emit_push:
        imm   r0, 8
        call  emit_stack_reserve
        imm   r0, 11
        imm   r1, 15
        imm   r2, 0
        call  emit_rr
        ret

; Input r0=slot. Emit a frame-slot load into r0.
emit_load_slot:
        mov   r10, r0
        call  record_slot_read
        imm   r0, 2
        imm   r1, 0
        imm   r2, 14
        call  emit_rr
        imm   r0, 8
        mul   r10, r0
        add   r10, r0
        imm   r0, 1
        mov   r1, r10
        call  emit_imm
        imm   r0, 4
        imm   r1, 0
        imm   r2, 1
        call  emit_rr
        imm   r0, 10
        imm   r1, 0
        imm   r2, 0
        call  emit_rr
        ret

; Input r0=slot. The generated expression result remains in runtime r0.
emit_store_slot:
        mov   r10, r0
        call  record_slot_write
        imm   r0, 2
        imm   r1, 1
        imm   r2, 14
        call  emit_rr
        imm   r0, 8
        mul   r10, r0
        add   r10, r0
        imm   r0, 2
        mov   r1, r10
        call  emit_imm
        imm   r0, 4
        imm   r1, 1
        imm   r2, 2
        call  emit_rr
        imm   r0, 11
        imm   r1, 1
        imm   r2, 0
        call  emit_rr
        ret

; Input r0 is 1 or 8. Memory-load brackets consume one checked expression
; depth so nested byte[word[...]] forms cannot overwrite the outer width.
push_load_width:
        mov   r7, r0
        imm   r0, 524392
        load  r6, r0
        imm   r1, 64
        jeq   r6, r1, plw_error
        imm   r0, 8
        mul   r0, r6
        imm   r1, 621000
        add   r0, r1
        store r0, r7
        imm   r0, 524392
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
plw_error:
        imm   r0, 3
        imm   r1, 64
        imm   r2, 65
        call  set_incomplete_at_source
        ret

finish_memory_load:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        store r0, r6
        imm   r0, 8
        mul   r0, r6
        imm   r1, 621000
        add   r0, r1
        load  r6, r0
        imm   r0, 1
        jeq   r6, r0, fml_byte
        imm   r0, 0
        imm   r1, 134217721
        call  emit_memory_guard
        imm   r0, 10
        imm   r1, 0
        imm   r2, 0
        call  emit_rr
        ret
fml_byte:
        imm   r0, 0
        imm   r1, 134217728
        call  emit_memory_guard
        imm   r0, 8
        imm   r1, 0
        imm   r2, 0
        call  emit_rr
        ret

emit_memory_store:
        imm   r0, 1
        call  emit_pop_register
        imm   r0, 524640
        load  r6, r0
        imm   r1, 1
        jeq   r6, r1, ems_guard_byte
        imm   r0, 1
        imm   r1, 134217721
        call  emit_memory_guard
        imm   r0, 11
        imm   r1, 1
        imm   r2, 0
        call  emit_rr
        ret
ems_guard_byte:
        imm   r0, 1
        imm   r1, 134217728
        call  emit_memory_guard
        imm   r0, 9
        imm   r1, 1
        imm   r2, 0
        call  emit_rr
        ret

; Input r0 is the generated address register and r1 is the exclusive logical
; bound. Call one emitted runtime guard, which returns the biased address in r4.
emit_memory_guard:
        imm   r2, 524672
        store r2, r0
        imm   r2, 524680
        store r2, r1
        imm   r0, 524712
        load  r6, r0
        jnz   r6, emg_known
        imm   r0, 524536
        load  r6, r0
        imm   r1, 262144
        jeq   r6, r1, emg_error
        imm   r0, 524704
        store r0, r6
        imm   r1, 1
        add   r6, r1
        imm   r0, 524536
        store r0, r6
        imm   r0, 524712
        store r0, r1
emg_known:
        imm   r0, 524536
        load  r6, r0
        imm   r1, 262144
        jeq   r6, r1, emg_error
        imm   r0, 524720
        store r0, r6
        imm   r1, 1
        add   r6, r1
        imm   r0, 524536
        store r0, r6
        imm   r0, 2
        imm   r1, 4
        imm   r2, 524672
        load  r2, r2
        call  emit_rr
        imm   r0, 5
        imm   r1, 524680
        load  r1, r1
        call  emit_imm
        imm   r0, 19
        imm   r1, 2
        imm   r2, 524704
        load  r2, r2
        call  emit_ref0
        imm   r0, 13
        imm   r1, 3
        imm   r2, 2
        imm   r3, 524720
        load  r3, r3
        call  emit_ref1
        imm   r0, 0
        imm   r1, 251
        call  emit_imm
        imm   r0, 0
        imm   r1, 0
        call  emit_r
        imm   r0, 524720
        load  r0, r0
        call  record_internal_pc
        imm   r0, 2
        imm   r1, 524672
        load  r1, r1
        imm   r2, 4
        call  emit_rr
        ret
emg_error:
        imm   r0, 5
        imm   r1, 3
        mov   r2, r6
        call  set_internal
        ret

; Emit the shared generated guard after all procedures. Its private ABI
; preserves r0/r1 (the live memory value/address operands), takes the candidate
; address in r4 and exclusive bound in r5, and returns r3=1 for a negative or
; too-large Word address or r3=0 with the biased address in r4.
; Each call site owns its unreachable fail-closed Halt(251), so this callable
; region always returns and remains structurally ordinary. The helper adds one
; transient Alpha return frame per memory access instead of duplicating the full
; comparison and bias sequence at every access site.
emit_memory_guard_runtime:
        imm   r0, 524712
        load  r0, r0
        jz    r0, emgr_done
        imm   r0, 524704
        load  r0, r0
        call  record_internal_pc
        imm   r0, 524536
        load  r6, r0
        imm   r1, 262142
        jlt   r6, r1, emgr_labels
        imm   r0, 5
        imm   r1, 3
        mov   r2, r6
        call  set_internal
        ret
emgr_labels:
        imm   r0, 524544
        store r0, r6
        imm   r1, 1
        add   r6, r1
        imm   r0, 524552
        store r0, r6
        add   r6, r1
        imm   r0, 524536
        store r0, r6
        imm   r0, 2
        imm   r1, 0
        call  emit_imm
        imm   r0, 15
        imm   r1, 4
        imm   r2, 2
        imm   r3, 2
        imm   r4, 524544
        load  r4, r4
        call  emit_ref2
        imm   r0, 15
        imm   r1, 4
        imm   r2, 5
        imm   r3, 2
        imm   r4, 524552
        load  r4, r4
        call  emit_ref2
        imm   r0, 524544
        load  r0, r0
        call  record_internal_pc
        imm   r0, 3
        imm   r1, 1
        call  emit_imm
        imm   r0, 20
        call  emit_op0

        imm   r0, 524552
        load  r0, r0
        call  record_internal_pc
        imm   r0, 2
        imm   r1, 4194304
        call  emit_imm
        imm   r0, 3
        imm   r1, 4
        imm   r2, 2
        call  emit_rr
        imm   r0, 3
        imm   r1, 0
        call  emit_imm
        imm   r0, 20
        call  emit_op0
emgr_done:
        ret

restore_tmp_name:
        imm   r0, 524464
        load  r1, r0
        imm   r0, 524320
        store r0, r1
        imm   r0, 524472
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        ret

emit_state_label:
        imm   r0, 524608
        load  r0, r0
        imm   r1, 1
        sub   r0, r1
        call  record_state_pc
        ret

emit_jump_target:
        call  load_selected_edge_target
        mov   r2, r0
        imm   r0, 12
        imm   r1, 1
        call  emit_ref0
        ret

emit_guarded_target:
        imm   r0, 524536
        load  r6, r0
        imm   r0, 524544
        store r0, r6
        imm   r1, 1
        add   r6, r1
        imm   r0, 524536
        store r0, r6
        imm   r0, 13
        imm   r1, 0
        imm   r2, 2
        imm   r3, 524544
        load  r3, r3
        call  emit_ref1
        call  emit_jump_target
        imm   r0, 524544
        load  r0, r0
        call  record_internal_pc
        ret

emit_comparison:
        imm   r0, 1
        call  emit_pop_register
        imm   r0, 524536
        load  r6, r0
        imm   r0, 524544
        store r0, r6
        imm   r1, 1
        add   r6, r1
        imm   r0, 524552
        store r0, r6
        add   r6, r1
        imm   r0, 524536
        store r0, r6
        imm   r0, 524560
        imm   r1, 0
        store r0, r1
        imm   r0, 524392
        load  r6, r0
        imm   r0, 8
        mul   r0, r6
        imm   r1, 620000
        add   r0, r1
        load  r6, r0
        imm   r0, 0
        jeq   r6, r0, ecmp_lt
        imm   r0, 1
        jeq   r6, r0, ecmp_gt
        imm   r0, 2
        jeq   r6, r0, ecmp_eq
        imm   r0, 3
        jeq   r6, r0, ecmp_ne
        imm   r0, 4
        jeq   r6, r0, ecmp_le
        jmp   ecmp_ge
ecmp_lt:
        imm   r4, 15
        imm   r5, 1
        imm   r6, 0
        jmp   ecmp_branch_done
ecmp_gt:
        imm   r4, 15
        imm   r5, 0
        imm   r6, 1
        jmp   ecmp_branch_done
ecmp_eq:
        imm   r4, 16
        imm   r5, 1
        imm   r6, 0
        jmp   ecmp_branch_done
ecmp_ne:
        imm   r0, 524560
        imm   r1, 1
        store r0, r1
        imm   r4, 16
        imm   r5, 1
        imm   r6, 0
        jmp   ecmp_branch_done
ecmp_le:
        imm   r0, 524560
        imm   r1, 1
        store r0, r1
        imm   r4, 15
        imm   r5, 0
        imm   r6, 1
        jmp   ecmp_branch_done
ecmp_ge:
        imm   r0, 524560
        imm   r1, 1
        store r0, r1
        imm   r4, 15
        imm   r5, 1
        imm   r6, 0
ecmp_branch_done:
        mov   r0, r4
        mov   r1, r5
        mov   r2, r6
        imm   r3, 2
        imm   r4, 524544
        load  r4, r4
        call  emit_ref2
        imm   r0, 524560
        load  r0, r0
        jnz   r0, ecmp_inverted
        imm   r0, 0
        imm   r1, 0
        call  emit_imm
        jmp   ecmp_fall_done
ecmp_inverted:
        imm   r0, 0
        imm   r1, 1
        call  emit_imm
ecmp_fall_done:
        imm   r0, 12
        imm   r1, 2
        imm   r2, 524552
        load  r2, r2
        call  emit_ref0
        imm   r0, 524544
        load  r0, r0
        call  record_internal_pc
        imm   r0, 524560
        load  r0, r0
        jnz   r0, ecmp_hit_false
        imm   r0, 0
        imm   r1, 1
        call  emit_imm
        jmp   ecmp_hit_done
ecmp_hit_false:
        imm   r0, 0
        imm   r1, 0
        call  emit_imm
ecmp_hit_done:
        imm   r0, 524552
        load  r0, r0
        call  record_internal_pc
        ret

; ---------------- literals ----------------
parse_decimal:
        call  skip_trivia
        imm   r0, 524296
        load  r6, r0
        imm   r7, 0
        imm   r10, 0
pd_loop:
        imm   r0, 524288
        load  r1, r0
        add   r1, r6
        add   r1, r7
        imm   r2, 1048576
        add   r2, r6
        add   r2, r7
        imm   r3, 524288
        load  r3, r3
        mov   r4, r6
        add   r4, r7
        jlt   r4, r3, pd_have
        jmp   pd_done
pd_have:
        loadb r5, r2
        imm   r0, 48
        jlt   r5, r0, pd_done
        imm   r0, 58
        jlt   r5, r0, pd_digit
        jmp   pd_done
pd_digit:
        imm   r0, 48
        sub   r5, r0
        ; Refuse values above 2^64-1 before the wrapping multiply/add. The
        ; quotient threshold fits signed Alpha comparison.
        imm   r0, 1844674407370955161
        jlt   r0, r10, pd_error
        jlt   r10, r0, pd_accumulate
        imm   r0, 5
        jlt   r0, r5, pd_error
pd_accumulate:
        imm   r0, 10
        mul   r10, r0
        add   r10, r5
        imm   r0, 1
        add   r7, r0
        jmp   pd_loop
pd_done:
        imm   r0, 0
        jeq   r7, r0, pd_error
        imm   r0, 524296
        mov   r1, r6
        add   r1, r7
        store r0, r1
        imm   r0, 0
        mov   r1, r10
        call  emit_imm
        ret
pd_error:
        call  set_error
        ret

parse_character:
        call  skip_trivia
        imm   r0, 524296
        load  r6, r0
        imm   r0, 1
        add   r6, r0
        call  char_at_cursor
        mov   r7, r0
        call  error_value
        jnz   r0, pc_return
        imm   r1, 39
        jeq   r7, r1, pc_error
        imm   r1, 32
        jlt   r7, r1, pc_error
        imm   r1, 127
        jlt   r7, r1, pc_plain
        jmp   pc_error
pc_plain:
        imm   r1, 92
        jeq   r7, r1, pc_escape
        imm   r0, 1
        add   r6, r0
        jmp   pc_close
pc_escape:
        imm   r0, 1
        add   r6, r0
        call  char_at_cursor
        mov   r7, r0
        call  error_value
        jnz   r0, pc_return
        imm   r1, 110
        jeq   r7, r1, pc_newline
        imm   r1, 116
        jeq   r7, r1, pc_tab
        imm   r1, 114
        jeq   r7, r1, pc_cr
        imm   r1, 48
        jeq   r7, r1, pc_zero
        imm   r1, 92
        jeq   r7, r1, pc_escaped_ok
        imm   r1, 39
        jeq   r7, r1, pc_escaped_ok
        jmp   pc_error
pc_newline:
        imm   r7, 10
        jmp   pc_escaped_ok
pc_tab:
        imm   r7, 9
        jmp   pc_escaped_ok
pc_cr:
        imm   r7, 13
        jmp   pc_escaped_ok
pc_zero:
        imm   r7, 0
pc_escaped_ok:
        imm   r0, 1
        add   r6, r0
pc_close:
        call  char_at_cursor
        mov   r2, r0
        call  error_value
        jnz   r0, pc_return
        imm   r1, 39
        jeq   r2, r1, pc_closed
        jmp   pc_error
pc_closed:
        imm   r0, 1
        add   r6, r0
        imm   r0, 524296
        store r0, r6
        imm   r0, 0
        mov   r1, r7
        call  emit_imm
        ret
pc_error:
        call  set_error
pc_return:
        ret

parse_emit_string:
        imm   r0, 34
        call  expect_char
        call  error_value
        jnz   r0, pes_return
pes_loop:
        call  peek_raw_char
        imm   r1, 0
        jlt   r0, r1, pes_error
        imm   r1, 34
        jeq   r0, r1, pes_close
        imm   r1, 92
        jeq   r0, r1, pes_escape
        mov   r7, r0
        call  consume_one
        jmp   pes_emit
pes_escape:
        call  consume_one
        call  peek_raw_char
        imm   r1, 0
        jlt   r0, r1, pes_error
        imm   r1, 110
        jeq   r0, r1, pes_newline
        imm   r1, 116
        jeq   r0, r1, pes_tab
        imm   r1, 114
        jeq   r0, r1, pes_cr
        imm   r1, 48
        jeq   r0, r1, pes_zero
        imm   r1, 92
        jeq   r0, r1, pes_literal_escape
        imm   r1, 34
        jeq   r0, r1, pes_literal_escape
        jmp   pes_error
pes_newline:
        imm   r7, 10
        jmp   pes_escape_done
pes_tab:
        imm   r7, 9
        jmp   pes_escape_done
pes_cr:
        imm   r7, 13
        jmp   pes_escape_done
pes_zero:
        imm   r7, 0
        jmp   pes_escape_done
pes_literal_escape:
        mov   r7, r0
pes_escape_done:
        call  consume_one
pes_emit:
        imm   r0, 0
        mov   r1, r7
        call  emit_imm
        imm   r0, 18
        imm   r1, 0
        call  emit_r
        jmp   pes_loop
pes_close:
        call  consume_one
pes_return:
        ret
pes_error:
        call  set_error
        ret

; Input r6 is a source cursor. Return byte in r0 or set ERROR at EOF.
char_at_cursor:
        imm   r0, 524288
        load  r1, r0
        jlt   r6, r1, cac_have
        call  set_error
        imm   r0, 0
        ret
cac_have:
        imm   r0, 1048576
        add   r0, r6
        loadb r0, r0
        ret

; ---------------- bounded procedure, call, and local tables ----------------
begin_init_proc:
        imm   r0, 524312
        load  r0, r0
        jnz   r0, bip_done
        imm   r0, 524448
        load  r6, r0
        imm   r0, 524784
        store r0, r6
        imm   r0, 8
        mul   r0, r6
        imm   r1, 5253120
        add   r0, r1
        imm   r1, 524568
        load  r1, r1
        store r0, r1
        imm   r0, 8
        mul   r0, r6
        imm   r1, 5257216
        add   r0, r1
        imm   r1, 524424
        load  r1, r1
        store r0, r1
        imm   r0, 8
        mul   r0, r6
        imm   r1, 5259264
        add   r0, r1
        imm   r1, 524576
        load  r1, r1
        store r0, r1
bip_done:
        ret

begin_init_state:
        imm   r0, 524312
        load  r0, r0
        jnz   r0, bis_done
        imm   r0, 524568
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        imm   r1, 256
        add   r6, r1
        imm   r0, 524784
        store r0, r6
bis_done:
        ret

record_block_terminator:
        imm   r0, 524312
        load  r0, r0
        jnz   r0, rbt_done
        imm   r0, 524784
        load  r6, r0
        imm   r0, 5545984
        add   r0, r6
        imm   r1, 524792
        load  r1, r1
        storeb r0, r1
rbt_done:
        ret

load_current_proc_name:
        imm   r0, 524432
        load  r1, r0
        imm   r0, 524320
        store r0, r1
        imm   r0, 524440
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        ret

; r0 points at a record whose first two words are a source span. Compare it
; with NAMESTART/NAMELEN and return 1/0.
name_equals_record:
        mov   r5, r0
        imm   r0, 524328
        load  r1, r0
        imm   r0, 524504
        store r0, r1
        imm   r2, 8
        add   r2, r5
        load  r2, r2
        jeq   r1, r2, ner_length_ok
        imm   r0, 0
        ret
ner_length_ok:
        imm   r6, 0
ner_loop:
        imm   r0, 524504
        load  r1, r0
        jlt   r6, r1, ner_byte
        imm   r0, 1
        ret
ner_byte:
        imm   r0, 524320
        load  r0, r0
        imm   r2, 1048576
        add   r0, r2
        add   r0, r6
        loadb r3, r0
        load  r0, r5
        add   r0, r2
        add   r0, r6
        loadb r4, r0
        jeq   r3, r4, ner_next
        imm   r0, 0
        ret
ner_next:
        imm   r0, 1
        add   r6, r0
        jmp   ner_loop

; Declare NAME in the current procedure. Return its zero-based frame slot.
declare_name:
        call  name_is_reserved
        jnz   r0, dn_error
        imm   r0, 524424
        load  r7, r0
        imm   r1, 64
        jeq   r7, r1, dn_slot_incomplete
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
dn_scan:
        imm   r0, 524496
        load  r6, r0
        jlt   r6, r7, dn_compare
        jmp   dn_add
dn_compare:
        imm   r0, 16
        mul   r0, r6
        imm   r1, 600000
        add   r0, r1
        call  name_equals_record
        jnz   r0, dn_error
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   dn_scan
dn_add:
        imm   r0, 16
        mul   r0, r7
        imm   r1, 600000
        add   r0, r1
        imm   r1, 524320
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524328
        load  r2, r1
        store r0, r2
        imm   r0, 524424
        imm   r1, 1
        add   r1, r7
        store r0, r1
        mov   r0, r7
        ret
dn_error:
        call  set_error
        ret
dn_slot_incomplete:
        imm   r0, 10
        imm   r1, 64
        imm   r2, 65
        call  set_incomplete_at_source
        ret

; Look up NAME in the current procedure. Return its frame slot.
lookup_name:
        imm   r0, 524424
        load  r7, r0
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
ln_scan:
        imm   r0, 524496
        load  r6, r0
        jlt   r6, r7, ln_compare
        call  set_error
        ret
ln_compare:
        imm   r0, 16
        mul   r0, r6
        imm   r1, 600000
        add   r0, r1
        call  name_equals_record
        jnz   r0, ln_found
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   ln_scan
ln_found:
        imm   r0, 524496
        load  r0, r0
        ret

add_proc:
        call  load_current_proc_name
        call  name_is_reserved
        jnz   r0, ap_error
        imm   r0, 524408
        load  r7, r0
        imm   r1, 256
        jeq   r7, r1, ap_incomplete
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
ap_scan:
        imm   r0, 524496
        load  r6, r0
        jlt   r6, r7, ap_compare
        jmp   ap_add
ap_compare:
        imm   r0, 32
        mul   r0, r6
        imm   r1, 5242880
        add   r0, r1
        call  name_equals_record
        jnz   r0, ap_error
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   ap_scan
ap_add:
        imm   r0, 32
        mul   r0, r7
        imm   r1, 5242880
        add   r0, r1
        imm   r1, 524432
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524440
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524424
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r2, 0
        store r0, r2
        imm   r0, 524448
        store r0, r7
        imm   r0, 524408
        imm   r1, 1
        add   r1, r7
        store r0, r1
        ret
ap_error:
        call  set_error
        ret
ap_incomplete:
        imm   r0, 4
        imm   r1, 256
        imm   r2, 257
        call  set_incomplete_at_source
        ret

select_proc:
        call  load_current_proc_name
        imm   r0, 524480
        load  r6, r0
        imm   r0, 524408
        load  r7, r0
        jlt   r6, r7, sp_have
        jmp   sp_error
sp_have:
        imm   r0, 32
        mul   r0, r6
        imm   r1, 5242880
        add   r0, r1
        call  name_equals_record
        jz    r0, sp_error
        imm   r0, 524480
        load  r6, r0
        imm   r0, 524448
        store r0, r6
        imm   r0, 32
        mul   r0, r6
        imm   r1, 5242896
        add   r0, r1
        load  r1, r0
        imm   r0, 524424
        load  r2, r0
        jeq   r1, r2, sp_done
sp_error:
        call  set_error
sp_done:
        ret

finish_proc:
        imm   r0, 524448
        load  r6, r0
        imm   r0, 32
        mul   r0, r6
        imm   r1, 5242904
        add   r0, r1
        imm   r1, 524424
        load  r1, r1
        store r0, r1
        imm   r0, 8
        mul   r0, r6
        imm   r1, 5253120
        add   r0, r1
        load  r2, r0
        imm   r0, 524568
        load  r1, r0
        sub   r1, r2
        imm   r0, 8
        mul   r0, r6
        imm   r2, 5255168
        add   r0, r2
        store r0, r1
        imm   r0, 8
        mul   r0, r6
        imm   r1, 5259264
        add   r0, r1
        load  r2, r0
        imm   r0, 524576
        load  r1, r0
        sub   r1, r2
        imm   r0, 8
        mul   r0, r6
        imm   r2, 5261312
        add   r0, r2
        store r0, r1
        ret

emit_proc_header:
        imm   r0, 524536
        load  r6, r0
        imm   r1, 262144
        jeq   r6, r1, eph_error
        imm   r0, 524728
        store r0, r6
        imm   r1, 1
        add   r6, r1
        imm   r0, 524536
        store r0, r6
        imm   r0, 524448
        load  r0, r0
        call  record_proc_pc
        imm   r0, 8
        call  emit_stack_reserve
        imm   r0, 11
        imm   r1, 15
        imm   r2, 14
        call  emit_rr
        imm   r0, 2
        imm   r1, 14
        imm   r2, 15
        call  emit_rr
        imm   r0, 524448
        load  r6, r0
        imm   r0, 32
        mul   r0, r6
        imm   r1, 5242880
        mov   r7, r0
        add   r7, r1
        imm   r0, 24
        add   r0, r7
        load  r6, r0
        imm   r0, 0
        jeq   r6, r0, eph_params
        mov   r7, r6
        imm   r1, 8
        mul   r7, r1
        mov   r0, r7
        call  emit_stack_reserve
eph_params:
        imm   r0, 524448
        load  r6, r0
        imm   r0, 32
        mul   r0, r6
        imm   r1, 5242896
        add   r0, r1
        load  r6, r0
        imm   r0, 524456
        store r0, r6
        imm   r0, 0
        jeq   r6, r0, eph_done
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
eph_param_loop:
        imm   r0, 524496
        load  r5, r0
        imm   r0, 524456
        load  r6, r0
        jlt   r5, r6, eph_param
        ret
eph_param:
        imm   r0, 2
        imm   r1, 5
        imm   r2, 14
        call  emit_rr
        mov   r7, r5
        imm   r1, 8
        mul   r7, r1
        imm   r1, 8
        add   r7, r1
        imm   r0, 4
        mov   r1, r7
        call  emit_imm
        imm   r0, 4
        imm   r1, 5
        imm   r2, 4
        call  emit_rr
        imm   r0, 11
        imm   r1, 5
        mov   r2, r5
        call  emit_rr
        imm   r0, 524496
        load  r5, r0
        imm   r1, 1
        add   r5, r1
        store r0, r5
        jmp   eph_param_loop
eph_done:
        ret
eph_error:
        imm   r0, 5
        imm   r1, 3
        mov   r2, r6
        call  set_internal
        ret

check_proc_slots:
        imm   r0, 524448
        load  r6, r0
        imm   r0, 32
        mul   r0, r6
        imm   r1, 5242904
        add   r0, r1
        load  r1, r0
        imm   r0, 524424
        load  r2, r0
        jeq   r1, r2, cps_done
        call  set_error
cps_done:
        ret

; Save a possibly nested call name and its argument count at the expression
; depth. Parentheses and calls share the same checked depth budget.
push_call_name:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 64
        jeq   r6, r1, pcn_error
        imm   r0, 24
        mul   r0, r6
        imm   r1, 610000
        add   r0, r1
        imm   r1, 524320
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524328
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r2, 0
        store r0, r2
        imm   r0, 524392
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
pcn_error:
        imm   r0, 3
        imm   r1, 64
        imm   r2, 65
        call  set_incomplete_at_source
        ret

increment_call_arg:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        imm   r0, 24
        mul   r0, r6
        imm   r1, 610016
        add   r0, r1
        load  r2, r0
        imm   r1, 4
        jeq   r2, r1, ica_error
        imm   r1, 1
        add   r2, r1
        store r0, r2
        ret
ica_error:
        call  set_error
        ret

finish_call:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        imm   r0, 24
        mul   r0, r6
        imm   r1, 610000
        mov   r7, r0
        add   r7, r1
        load  r1, r7
        imm   r0, 524320
        store r0, r1
        imm   r0, 8
        add   r0, r7
        load  r1, r0
        imm   r0, 524328
        store r0, r1
        imm   r0, kw_read_byte
        imm   r1, 9
        call  name_equals_literal
        jnz   r0, fc_read_byte
        imm   r0, kw_write_byte
        imm   r1, 10
        call  name_equals_literal
        jnz   r0, fc_write_byte
        imm   r0, 524312
        load  r0, r0
        jnz   r0, fc_select
        mov   r0, r7
        call  add_call
        jmp   fc_call_checked
fc_select:
        mov   r0, r7
        call  select_call
fc_call_checked:
        call  error_value
        jnz   r0, fc_return
fc_emit_args:
        imm   r0, 524392
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        imm   r0, 24
        mul   r0, r6
        imm   r1, 610000
        mov   r7, r0
        add   r7, r1
        imm   r0, 16
        add   r0, r7
        load  r6, r0
        imm   r0, 4
        jeq   r6, r0, fc_pop3
        imm   r0, 3
        jeq   r6, r0, fc_pop2
        imm   r0, 2
        jeq   r6, r0, fc_pop1
        imm   r0, 1
        jeq   r6, r0, fc_pop0
        jmp   fc_emit_call
fc_pop3:
        imm   r0, 3
        call  emit_pop_register
fc_pop2:
        imm   r0, 2
        call  emit_pop_register
fc_pop1:
        imm   r0, 1
        call  emit_pop_register
fc_pop0:
        imm   r0, 0
        call  emit_pop_register
fc_emit_call:
        call  load_selected_call_target
        mov   r2, r0
        imm   r0, 19
        imm   r1, 0
        call  emit_ref0
        jmp   fc_leave
fc_read_byte:
        imm   r0, 16
        add   r0, r7
        load  r0, r0
        jnz   r0, fc_builtin_error
        imm   r0, 17
        imm   r1, 0
        call  emit_r
        jmp   fc_leave
fc_write_byte:
        imm   r0, 16
        add   r0, r7
        load  r0, r0
        imm   r1, 1
        jeq   r0, r1, fc_write_ok
        jmp   fc_builtin_error
fc_write_ok:
        imm   r0, 0
        call  emit_pop_register
        imm   r0, 18
        imm   r1, 0
        call  emit_r
fc_leave:
        imm   r0, 524392
        load  r1, r0
        imm   r2, 1
        sub   r1, r2
        store r0, r1
fc_return:
        ret
fc_builtin_error:
        call  set_error
        ret

; r0 points at a NAME_STACK record.
add_call:
        mov   r5, r0
        imm   r0, 524416
        load  r6, r0
        imm   r1, 1024
        jeq   r6, r1, ac_incomplete
        imm   r0, 24
        mul   r0, r6
        imm   r1, 550000
        add   r0, r1
        load  r1, r5
        store r0, r1
        imm   r2, 8
        add   r0, r2
        mov   r1, r5
        add   r1, r2
        load  r1, r1
        store r0, r1
        add   r0, r2
        add   r5, r2
        add   r5, r2
        load  r1, r5
        store r0, r1
        imm   r0, 524416
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
ac_incomplete:
        imm   r0, 9
        imm   r1, 1024
        imm   r2, 1025
        call  set_incomplete_at_source
        ret

add_state:
        call  name_is_reserved
        jnz   r0, ast_error
        imm   r0, 524592
        load  r6, r0
        imm   r1, 128
        jeq   r6, r1, ast_proc_incomplete
        imm   r0, 524568
        load  r7, r0
        imm   r1, 1024
        jeq   r7, r1, ast_global_incomplete
        imm   r0, 524496
        imm   r1, 0
        store r0, r1
ast_scan:
        imm   r0, 524496
        load  r6, r0
        jlt   r6, r7, ast_compare
        jmp   ast_add
ast_compare:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 630000
        add   r0, r1
        mov   r5, r0
        imm   r1, 16
        add   r0, r1
        load  r1, r0
        imm   r0, 524448
        load  r2, r0
        jeq   r1, r2, ast_compare_name
        jmp   ast_next
ast_compare_name:
        mov   r0, r5
        call  name_equals_record
        jnz   r0, ast_error
ast_next:
        imm   r0, 524496
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   ast_scan
ast_add:
        imm   r0, 24
        mul   r0, r7
        imm   r1, 630000
        add   r0, r1
        imm   r1, 524320
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524328
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524448
        load  r2, r1
        store r0, r2
        imm   r0, 524568
        imm   r1, 1
        add   r7, r1
        store r0, r7
        imm   r0, 524592
        load  r6, r0
        add   r6, r1
        store r0, r6
        ret
ast_error:
        call  set_error
        ret
ast_proc_incomplete:
        imm   r0, 5
        imm   r1, 128
        imm   r2, 129
        call  set_incomplete_at_source
        ret
ast_global_incomplete:
        imm   r0, 6
        imm   r1, 1024
        imm   r2, 1025
        call  set_incomplete_at_source
        ret

add_edge:
        call  name_is_reserved
        jnz   r0, ae_error
        imm   r0, 524600
        load  r7, r0
        imm   r1, 256
        jeq   r7, r1, ae_proc_incomplete
        imm   r0, 524576
        load  r6, r0
        imm   r1, 1024
        jeq   r6, r1, ae_global_incomplete
        mov   r0, r6
        call  record_init_edge
        imm   r0, 24
        mul   r0, r6
        imm   r1, 680000
        add   r0, r1
        imm   r1, 524320
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524328
        load  r2, r1
        store r0, r2
        imm   r1, 8
        add   r0, r1
        imm   r1, 524448
        load  r2, r1
        store r0, r2
        imm   r0, 524576
        imm   r1, 1
        add   r6, r1
        store r0, r6
        imm   r0, 524600
        load  r7, r0
        add   r7, r1
        store r0, r7
        ret
ae_error:
        call  set_error
        ret
ae_proc_incomplete:
        imm   r0, 7
        imm   r1, 256
        imm   r2, 257
        call  set_incomplete_at_source
        ret
ae_global_incomplete:
        imm   r0, 8
        imm   r1, 1024
        imm   r2, 1025
        call  set_incomplete_at_source
        ret

; Input r0 is the new global edge index. Capture the exact generated-local set
; at this transition coordinate and its source block.
record_init_edge:
        mov   r5, r0
        imm   r0, 524784
        load  r4, r0
        mov   r0, r5
        imm   r1, 8
        mul   r0, r1
        imm   r1, 5537792
        add   r0, r1
        store r0, r4
        imm   r3, 0
rie_loop:
        imm   r0, 64
        jeq   r3, r0, rie_done
        mov   r0, r4
        imm   r1, 64
        mul   r0, r1
        add   r0, r3
        imm   r1, 5390336
        add   r0, r1
        loadb r2, r0
        mov   r0, r5
        imm   r1, 64
        mul   r0, r1
        add   r0, r3
        imm   r1, 5472256
        add   r0, r1
        storeb r0, r2
        imm   r0, 1
        add   r3, r0
        jmp   rie_loop
rie_done:
        ret

select_state:
        imm   r0, 524608
        load  r6, r0
        imm   r0, 524568
        load  r7, r0
        jlt   r6, r7, sst_have
        jmp   sst_error
sst_have:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 630000
        add   r0, r1
        mov   r5, r0
        imm   r1, 16
        add   r0, r1
        load  r1, r0
        imm   r0, 524448
        load  r2, r0
        jeq   r1, r2, sst_name
        jmp   sst_error
sst_name:
        mov   r0, r5
        call  name_equals_record
        jz    r0, sst_error
        imm   r0, 524608
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
sst_error:
        call  set_error
        ret

select_edge:
        imm   r0, 524616
        load  r6, r0
        imm   r0, 524576
        load  r7, r0
        jlt   r6, r7, sed_have
        jmp   sed_error
sed_have:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 680000
        add   r0, r1
        mov   r5, r0
        imm   r1, 16
        add   r0, r1
        load  r1, r0
        imm   r0, 524448
        load  r2, r0
        jeq   r1, r2, sed_name
        jmp   sed_error
sed_name:
        mov   r0, r5
        call  name_equals_record
        jz    r0, sed_error
        imm   r0, 524616
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        ret
sed_error:
        call  set_error
        ret

; Input r0 points at the active NAME_STACK record.
select_call:
        mov   r5, r0
        load  r1, r5
