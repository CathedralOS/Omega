; ---------------- flattened CFG definite initialization ----------------
; All authored blocks and transition-coordinate generated sets were recorded
; during validation parsing. Analyze one procedure at a time with 129 x 64
; reusable bytes: entry is a root, reachability ignores expression values, and
; incoming facts monotonically descend from top by predecessor intersection.
validate_initialization:
        imm   r0, 524808
        imm   r1, 0
        store r0, r1
vi_proc_loop:
        imm   r0, 524808
        load  r6, r0
        imm   r0, 524408
        load  r7, r0
        jlt   r6, r7, vi_proc
        ret
vi_proc:
        imm   r0, 8
        mul   r0, r6
        mov   r5, r0
        imm   r1, 5253120
        add   r0, r1
        load  r1, r0
        imm   r0, 524816
        store r0, r1
        mov   r0, r5
        imm   r1, 5255168
        add   r0, r1
        load  r1, r0
        imm   r0, 524824
        store r0, r1
        imm   r2, 1
        add   r1, r2
        imm   r0, 524832
        store r0, r1
        mov   r0, r5
        imm   r1, 5259264
        add   r0, r1
        load  r1, r0
        imm   r0, 524880
        store r0, r1
        mov   r0, r5
        imm   r1, 5261312
        add   r0, r1
        load  r1, r0
        imm   r0, 524888
        store r0, r1
        call  initialize_init_work
        call  compute_init_reachability
        call  solve_init_intersection
        call  validate_init_reads
        call  error_value
        jnz   r0, vi_return
        imm   r0, 524808
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   vi_proc_loop
vi_return:
        ret

