        add   r0, r7
        imm   r1, 5548032
        add   r0, r1
        loadb r0, r0
        jnz   r0, vir_slot_next
        call  set_error
        ret
vir_slot_next:
        imm   r0, 524856
        load  r7, r0
        imm   r1, 1
        add   r7, r1
        store r0, r7
        jmp   vir_slot_loop
vir_next_block:
        imm   r0, 524840
        load  r6, r0
        imm   r1, 1
        add   r6, r1
        store r0, r6
        jmp   vir_block_loop

; Map a global entry/state block identity to the current procedure's local
; 0..128 work row, or return -1 when it belongs to another procedure.
init_source_local:
        mov   r6, r0
        imm   r0, 524808
        load  r1, r0
        jeq   r6, r1, isl_entry
        imm   r0, 524816
        load  r2, r0
        imm   r3, 256
        add   r2, r3
        jlt   r6, r2, isl_other
        imm   r0, 524824
        load  r3, r0
        mov   r4, r2
        add   r4, r3
        jlt   r6, r4, isl_state
isl_other:
        imm   r0, 0
        imm   r1, 1
        sub   r0, r1
        ret
isl_entry:
        imm   r0, 0
        ret
isl_state:
        sub   r6, r2
        imm   r0, 1
        add   r6, r0
        mov   r0, r6
        ret

; Map a current-procedure local work row to its global entry/state block.
init_local_to_global:
        imm   r1, 0
        jeq   r0, r1, iltg_entry
        imm   r1, 1
        sub   r0, r1
        imm   r1, 524816
        load  r1, r1
        add   r0, r1
        imm   r1, 256
        add   r0, r1
        ret
iltg_entry:
        imm   r0, 524808
        load  r0, r0
        ret

; ---------------- identifiers and token expectations ----------------
parse_identifier:
        call  skip_trivia
        imm   r0, 524296
        load  r6, r0
        imm   r0, 524320
        store r0, r6
        call  source_char_at
        call  is_ident_start
        imm   r1, 1
        jeq   r0, r1, pi_started
        call  set_error
        ret
pi_started:
        imm   r7, 0
pi_loop:
        imm   r0, 524320
        load  r6, r0
        mov   r0, r6
        add   r0, r7
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, pi_done
        call  is_ident_continue
        imm   r1, 1
        jeq   r0, r1, pi_more
        jmp   pi_done
pi_more:
        imm   r0, 64
        jeq   r7, r0, pi_error
        imm   r0, 1
        add   r7, r0
        jmp   pi_loop
pi_done:
        imm   r0, 524320
        load  r6, r0
        imm   r0, 524328
        store r0, r7
        imm   r0, 524296
        add   r6, r7
        store r0, r6
        ret
pi_error:
        imm   r0, 2
        imm   r1, 64
        imm   r2, 65
        imm   r3, 1
        imm   r4, 524320
        load  r4, r4
        imm   r5, 64
        add   r4, r5
        call  set_incomplete
        ret

; Inputs r0=fixed bytes and r1=length. Compare against NAMESTART/NAMELEN.
name_equals_literal:
        mov   r5, r0
        mov   r2, r1
        imm   r0, 524328
        load  r1, r0
        jeq   r1, r2, nel_compare
        imm   r0, 0
        ret
nel_compare:
        imm   r6, 0
nel_loop:
        jlt   r6, r2, nel_byte
        imm   r0, 1
        ret
nel_byte:
        imm   r0, 524320
        load  r0, r0
        imm   r1, 1048576
        add   r1, r0
        add   r1, r6
        loadb r3, r1
        mov   r1, r5
        add   r1, r6
        loadb r4, r1
        jeq   r3, r4, nel_next
        imm   r0, 0
        ret
nel_next:
        imm   r0, 1
        add   r6, r0
        jmp   nel_loop

; Inputs r0=literal address, r1=length. If it matches at the token cursor with
; an identifier boundary, consume it and return 1; otherwise return 0.
match_literal:
        imm   r3, 524336
        store r3, r0
        imm   r3, 524344
        store r3, r1
        call  skip_trivia
        imm   r3, 524296
        load  r6, r3
        imm   r7, 0
ml_loop:
        imm   r3, 524344
        load  r4, r3
        jlt   r7, r4, ml_compare
        jmp   ml_boundary
ml_compare:
        imm   r3, 524296
        load  r6, r3
        mov   r0, r6
        add   r0, r7
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, ml_no
        mov   r5, r0
        imm   r3, 524336
        load  r3, r3
        add   r3, r7
        loadb r4, r3
        jeq   r5, r4, ml_next
        jmp   ml_no
ml_next:
        imm   r0, 1
        add   r7, r0
        jmp   ml_loop
ml_boundary:
        imm   r3, 524296
        load  r6, r3
        mov   r0, r6
        add   r0, r7
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, ml_yes
        call  is_ident_continue
        imm   r1, 1
        jeq   r0, r1, ml_no
ml_yes:
        imm   r0, 524296
        load  r6, r0
        add   r6, r7
        store r0, r6
        imm   r0, 1
        ret
ml_no:
        imm   r0, 0
        ret

; Inputs r0=literal address, r1=length, r2=identifier-boundary flag.
expect_literal:
        imm   r3, 524336
        store r3, r0
        imm   r3, 524344
        store r3, r1
        imm   r3, 524352
        store r3, r2
        call  skip_trivia
        imm   r3, 524296
        load  r6, r3
        imm   r7, 0
el_loop:
        imm   r3, 524344
        load  r4, r3
        jlt   r7, r4, el_compare
        jmp   el_boundary
el_compare:
        imm   r3, 524296
        load  r6, r3
        mov   r0, r6
        add   r0, r7
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, el_error
        mov   r5, r0
        imm   r3, 524336
        load  r3, r3
        add   r3, r7
        loadb r4, r3
        jeq   r5, r4, el_next
        jmp   el_error
el_next:
        imm   r0, 1
        add   r7, r0
        jmp   el_loop
el_boundary:
        imm   r3, 524352
        load  r3, r3
        imm   r4, 0
        jeq   r3, r4, el_commit
        imm   r3, 524296
        load  r6, r3
        mov   r0, r6
        add   r0, r7
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, el_commit
        call  is_ident_continue
        imm   r1, 1
        jeq   r0, r1, el_error
el_commit:
        imm   r3, 524296
        load  r6, r3
        add   r6, r7
        imm   r0, 524296
        store r0, r6
        ret
el_error:
        call  set_error
        ret

expect_char:
        imm   r1, 524360
        store r1, r0
        call  skip_trivia
        imm   r0, 524296
        load  r6, r0
        mov   r0, r6
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, ec_error
        mov   r2, r0
        imm   r1, 524360
        load  r1, r1
        jeq   r2, r1, ec_ok
ec_error:
        call  set_error
        ret
ec_ok:
        imm   r0, 1
        add   r6, r0
        imm   r0, 524296
        store r0, r6
        ret

; ---------------- source cursor helpers ----------------
; Validate the complete source byte stream before tokenization. On failure,
; CUR is the exact first invalid byte offset recorded by the canonical Reject.
validate_source_envelope:
        imm   r6, 0
vse_loop:
        imm   r0, 524288
        load  r7, r0
        jlt   r6, r7, vse_byte
        imm   r0, 524296
        imm   r1, 0
        store r0, r1
        ret
vse_byte:
        imm   r0, 1048576
        add   r0, r6
        loadb r0, r0
        imm   r1, 9
        jeq   r0, r1, vse_next
        imm   r1, 10
        jeq   r0, r1, vse_next
        imm   r1, 13
        jeq   r0, r1, vse_next
        imm   r1, 32
        jlt   r0, r1, vse_invalid
        imm   r1, 127
        jlt   r0, r1, vse_next
vse_invalid:
        imm   r0, 524296
        store r0, r6
        call  set_error
        ret
vse_next:
        imm   r0, 1
        add   r6, r0
        jmp   vse_loop

skip_trivia:
        imm   r0, 524296
        load  r6, r0
st_loop:
        mov   r0, r6
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, st_done
        mov   r7, r0
        imm   r1, 32
        jeq   r7, r1, st_advance
        imm   r1, 9
        jeq   r7, r1, st_advance
        imm   r1, 10
        jeq   r7, r1, st_advance
        imm   r1, 13
        jeq   r7, r1, st_advance
        imm   r1, 59
        jeq   r7, r1, st_comment
        jmp   st_done
st_advance:
        imm   r0, 1
        add   r6, r0
        jmp   st_loop
st_comment:
        imm   r0, 1
        add   r6, r0
st_comment_loop:
        mov   r0, r6
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, st_done
        imm   r1, 1
        add   r6, r1
        imm   r1, 10
        jeq   r0, r1, st_loop
        imm   r1, 13
        jeq   r0, r1, st_loop
        jmp   st_comment_loop
st_done:
        imm   r0, 524296
        store r0, r6
        ret

peek_token_char:
        call  skip_trivia
        call  peek_raw_char
        ret
peek_raw_char:
        imm   r0, 524296
        load  r0, r0
        call  source_char_at_or_eof
        ret

; Input r0=required adjacent byte. Unlike expect_char, do not consume trivia.
expect_raw_char:
        imm   r1, 524360
        store r1, r0
        call  peek_raw_char
        mov   r2, r0
        imm   r1, 524360
        load  r1, r1
        jeq   r2, r1, erc_ok
        call  set_error
        ret
erc_ok:
        call  consume_one
        ret

consume_one:
        imm   r0, 524296
        load  r1, r0
        imm   r2, 1
        add   r1, r2
        store r0, r1
        ret

; r0=source offset; return byte or -1.
source_char_at_or_eof:
        mov   r6, r0
        imm   r1, 524288
        load  r1, r1
        jlt   r6, r1, scaoe_have
        imm   r0, 0
        imm   r1, 1
        sub   r0, r1
        ret
scaoe_have:
        imm   r0, 1048576
        add   r0, r6
        loadb r0, r0
        ret

; r6=source offset; return byte or set ERROR.
source_char_at:
        mov   r0, r6
        call  source_char_at_or_eof
        imm   r1, 0
        jlt   r0, r1, sca_error
        ret
sca_error:
        call  set_error
        imm   r0, 0
        ret

is_ident_start:
        mov   r6, r0
        imm   r1, 95
        jeq   r6, r1, iis_yes
        imm   r1, 65
        jlt   r6, r1, iis_no
        imm   r1, 91
        jlt   r6, r1, iis_yes
        imm   r1, 97
        jlt   r6, r1, iis_no
        imm   r1, 123
        jlt   r6, r1, iis_yes
iis_no:
        imm   r0, 0
        ret
iis_yes:
        imm   r0, 1
        ret

is_ident_continue:
        mov   r6, r0
        call  is_ident_start
        imm   r1, 1
        jeq   r0, r1, iic_yes
        imm   r1, 48
        jlt   r6, r1, iic_no
        imm   r1, 58
        jlt   r6, r1, iic_yes
iic_no:
        imm   r0, 0
        ret
iic_yes:
        imm   r0, 1
        ret

; ---------------- direct Alpha tape output ----------------
; The validation pass reserves exact instruction widths. The publication pass
; writes the same bytes into a private buffer, records symbolic address fixups,
; patches them after EOF, and only then writes stdout.
emit_program_prelude:
        imm   r0, 15
        imm   r1, 2097152
        call  emit_imm
        imm   r0, 14
        imm   r1, 2097152
        call  emit_imm
        imm   r0, 13
        imm   r1, 8
        call  emit_imm
        imm   r0, 524648
        load  r2, r0
        imm   r0, 19
        imm   r1, 0
        call  emit_ref0
        imm   r0, 0
        imm   r1, 0
        call  emit_r
        ret

; Input r0 is a positive fixed byte count. Subtract it, then branch to the
; current procedure's terminal fault block if the positive aligned stack drops
; below 1048576. No generated load/store occurs between subtraction and check.
emit_stack_reserve:
        imm   r1, 524736
        store r1, r0
        imm   r0, 5
        imm   r1, 524736
        load  r1, r1
        call  emit_imm
        imm   r0, 4
        imm   r1, 15
        imm   r2, 5
        call  emit_rr
        imm   r0, 4
        imm   r1, 1048576
        call  emit_imm
        imm   r0, 15
        imm   r1, 15
        imm   r2, 4
        imm   r3, 2
        imm   r4, 524728
        load  r4, r4
        call  emit_ref2
        ret

; Emit the current procedure's local terminal stack-fault region after its
; ordinary fallthrough epilogue. All reservation branches therefore stay
; inside one structurally admitted callable region.
emit_stack_fault_block:
        imm   r0, 524728
        load  r0, r0
        call  record_internal_pc
        imm   r0, 4
        imm   r1, 250
        call  emit_imm
        imm   r0, 0
        imm   r1, 4
        call  emit_r
        ret

emit_epilogue:
        imm   r0, 2
        imm   r1, 15
        imm   r2, 14
        call  emit_rr
        imm   r0, 10
        imm   r1, 14
        imm   r2, 15
        call  emit_rr
        imm   r0, 3
        imm   r1, 15
        imm   r2, 13
        call  emit_rr
        imm   r0, 20
        call  emit_op0
        ret

; Input r0 is the generated register to pop.
emit_pop_register:
        mov   r5, r0
        imm   r0, 10
        mov   r1, r5
        imm   r2, 15
        call  emit_rr
        imm   r0, 3
        imm   r1, 15
        imm   r2, 13
        call  emit_rr
        ret

; Input r0 is add/sub/mul/div/mod. Pop the left operand and leave r0=result.
emit_pop_binary:
        mov   r10, r0
        imm   r0, 1
        call  emit_pop_register
        mov   r0, r10
        imm   r1, 1
        imm   r2, 0
        call  emit_rr
        imm   r0, 2
        imm   r1, 0
        imm   r2, 1
        call  emit_rr
        ret

emit_op0:
        call  emit_byte
        ret

; Input r0=opcode, r1=register.
emit_r:
        mov   r6, r0
        mov   r7, r1
        mov   r0, r6
        call  emit_byte
        mov   r0, r7
        call  emit_byte
        ret

; Input r0=opcode, r1=first register, r2=second register.
emit_rr:
        mov   r4, r0
        mov   r6, r1
        mov   r7, r2
        mov   r0, r4
        call  emit_byte
        mov   r0, r6
        call  emit_byte
        mov   r0, r7
        call  emit_byte
        ret

; Input r0=register, r1=immediate.
emit_imm:
        mov   r6, r0
        mov   r7, r1
        imm   r0, 1
        call  emit_byte
        mov   r0, r6
        call  emit_byte
        mov   r0, r7
        call  emit_u64
        ret

; Input r0=opcode, r1=kind, r2=identity.
emit_ref0:
        mov   r4, r0
        mov   r6, r1
        mov   r7, r2
        mov   r0, r4
        call  emit_byte
        imm   r0, 524400
        load  r0, r0
        mov   r1, r6
        mov   r2, r7
        call  add_fixup
        imm   r0, 0
        call  emit_u64
        ret

; Input r0=opcode, r1=register, r2=kind, r3=identity.
emit_ref1:
        mov   r4, r0
        mov   r5, r1
        mov   r6, r2
        mov   r7, r3
        mov   r0, r4
        call  emit_byte
        mov   r0, r5
        call  emit_byte
        imm   r0, 524400
        load  r0, r0
        mov   r1, r6
        mov   r2, r7
        call  add_fixup
        imm   r0, 0
        call  emit_u64
        ret

; Input r0=opcode, r1/r2=registers, r3=kind, r4=identity.
emit_ref2:
        mov   r10, r4
        mov   r4, r0
        mov   r5, r1
        mov   r6, r2
        mov   r7, r3
        mov   r0, r4
        call  emit_byte
        mov   r0, r5
        call  emit_byte
        mov   r0, r6
        call  emit_byte
        imm   r0, 524400
        load  r0, r0
        mov   r1, r7
        mov   r2, r10
        call  add_fixup
        imm   r0, 0
        call  emit_u64
        ret

; Input r0=word. Append little-endian bytes.
emit_u64:
        imm   r1, 524688
        store r1, r0
        imm   r0, 524696
        imm   r1, 0
        store r0, r1
eu64_loop:
        imm   r0, 524696
        load  r7, r0
        imm   r0, 8
        jeq   r7, r0, eu64_done
        imm   r0, 524688
        add   r0, r7
        loadb r0, r0
        call  emit_byte
        imm   r0, 524696
        load  r7, r0
        imm   r0, 1
        add   r7, r0
        imm   r0, 524696
        store r0, r7
        jmp   eu64_loop
eu64_done:
        ret

; Input r0=byte. This is the sole tape-buffer mutation tooth.
emit_byte:
        mov   r4, r0
        call  error_value
        jnz   r0, eb_done
        imm   r0, 524312
        load  r0, r0
        jnz   r0, eb_store
        imm   r1, 1
        call  reserve_output
        ret
eb_store:
        imm   r0, 524400
        load  r1, r0
        imm   r2, 1048572
        jeq   r1, r2, eb_error
        imm   r2, 16777216
        add   r2, r1
        storeb r2, r4
        imm   r2, 1
        add   r1, r2
        store r0, r1
eb_done:
        ret
eb_error:
        imm   r0, 3
        imm   r1, 2
        imm   r2, 524400
        load  r2, r2
        call  set_internal
        ret

; Input r0=operand offset, r1=identity kind (0 proc, 1 state, 2 internal),
; r2=identity. Validation reserves bytes but owns no provisional fixups.
add_fixup:
        imm   r3, 524312
        load  r3, r3
        jz    r3, af_done
        mov   r4, r0
        mov   r5, r1
        mov   r6, r2
        imm   r0, 524656
        load  r7, r0
        imm   r1, 116508
        jeq   r7, r1, af_error
        imm   r1, 24
        mul   r1, r7
        imm   r2, 25165824
        add   r1, r2
        store r1, r4
        imm   r2, 8
        add   r1, r2
        store r1, r5
        add   r1, r2
        store r1, r6
        imm   r1, 1
        add   r7, r1
        store r0, r7
af_done:
        ret
af_error:
        imm   r0, 4
        imm   r1, 3
        imm   r2, 524656
        load  r2, r2
        call  set_internal
        ret

; Input r0=procedure identity.
record_proc_pc:
        imm   r1, 524312
        load  r1, r1
        jz    r1, rpc_done
        mov   r6, r0
        imm   r0, 524408
        load  r1, r0
        jlt   r6, r1, rpc_store
        jmp   rpc_error
rpc_store:
        imm   r0, 8
        mul   r0, r6
        imm   r1, 5251072
        add   r0, r1
        imm   r1, 524400
        load  r1, r1
        store r0, r1
rpc_done:
        ret
rpc_error:
        imm   r0, 6
        imm   r1, 3
        mov   r2, r6
        call  set_internal
        ret

; Input r0=state identity.
record_state_pc:
        imm   r1, 524312
        load  r1, r1
        jz    r1, rsp_done
        mov   r6, r0
        imm   r0, 524568
        load  r1, r0
        jlt   r6, r1, rsp_store
        jmp   rsp_error
rsp_store:
        imm   r0, 8
        mul   r0, r6
        imm   r1, 655360
        add   r0, r1
        imm   r1, 524400
        load  r1, r1
        store r0, r1
rsp_done:
        ret
rsp_error:
        imm   r0, 6
        imm   r1, 3
        mov   r2, r6
        call  set_internal
        ret

; Input r0=internal numeric identity.
record_internal_pc:
        imm   r1, 524312
        load  r1, r1
        jz    r1, rip_done
        mov   r6, r0
        imm   r1, 262144
        jlt   r6, r1, rip_store
        jmp   rip_error
rip_store:
        imm   r0, 8
        mul   r0, r6
        imm   r1, 20971520
        add   r0, r1
        imm   r1, 524400
        load  r1, r1
        store r0, r1
rip_done:
        ret
rip_error:
        imm   r0, 5
        imm   r1, 3
        mov   r2, r6
        call  set_internal
        ret

load_selected_call_target:
        imm   r0, 524312
        load  r0, r0
        jz    r0, lsct_zero
        imm   r0, 524624
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        imm   r0, 8
        mul   r0, r6
        imm   r1, 575000
        add   r0, r1
        load  r0, r0
        ret
lsct_zero:
        imm   r0, 0
        ret

load_selected_edge_target:
        imm   r0, 524312
        load  r0, r0
        jz    r0, lset_zero
        imm   r0, 524616
        load  r6, r0
        imm   r1, 1
        sub   r6, r1
        imm   r0, 8
        mul   r0, r6
        imm   r1, 705000
        add   r0, r1
        load  r0, r0
        ret
lset_zero:
        imm   r0, 0
        ret

patch_fixups:
        imm   r6, 0
pfu_loop:
        imm   r0, 524656
        load  r7, r0
        jlt   r6, r7, pfu_row
        ret
pfu_row:
        imm   r0, 24
        mul   r0, r6
        imm   r1, 25165824
        add   r0, r1
        mov   r5, r0
        load  r4, r5
        imm   r1, 8
        add   r5, r1
        load  r7, r5
        add   r5, r1
        load  r10, r5
        imm   r0, 0
        jeq   r7, r0, pfu_proc
        imm   r0, 1
        jeq   r7, r0, pfu_state
        imm   r0, 2
        jeq   r7, r0, pfu_internal
        jmp   pfu_error
pfu_proc:
        imm   r0, 524408
        load  r1, r0
        jlt   r10, r1, pfu_proc_load
        jmp   pfu_error
pfu_proc_load:
        imm   r0, 8
        mul   r0, r10
        imm   r1, 5251072
        add   r0, r1
        load  r10, r0
        jmp   pfu_patch
pfu_state:
        imm   r0, 524568
        load  r1, r0
        jlt   r10, r1, pfu_state_load
        jmp   pfu_error
pfu_state_load:
        imm   r0, 8
        mul   r0, r10
        imm   r1, 655360
        add   r0, r1
        load  r10, r0
        jmp   pfu_patch
pfu_internal:
        imm   r0, 524536
        load  r1, r0
        jlt   r10, r1, pfu_internal_load
        jmp   pfu_error
pfu_internal_load:
        imm   r0, 8
        mul   r0, r10
        imm   r1, 20971520
        add   r0, r1
        load  r10, r0
pfu_patch:
        imm   r0, 524400
        load  r1, r0
        mov   r2, r4
        imm   r3, 8
        add   r2, r3
        jlt   r1, r2, pfu_error
        imm   r0, 16777216
        add   r0, r4
        store r0, r10
        imm   r0, 1
        add   r6, r0
        jmp   pfu_loop
pfu_error:
        imm   r0, 6
        imm   r1, 3
        mov   r2, r6
        call  set_internal
        ret

publish_tape:
        imm   r6, 0
ptape_loop:
        imm   r0, 524400
        load  r7, r0
        jlt   r6, r7, ptape_byte
        ret
ptape_byte:
        imm   r0, 16777216
        add   r0, r6
        loadb r0, r0
        write r0
        imm   r0, 1
        add   r6, r0
        jmp   ptape_loop

; Input r1=prospective byte count. Both passes enforce Alpha's actual maximum
; runnable payload before any output is published.
reserve_output:
        imm   r2, 1048572
        sub   r2, r1
        imm   r3, 524400
        load  r4, r3
        jlt   r2, r4, ro_error
        add   r4, r1
        store r3, r4
        ret
ro_error:
        mov   r5, r4
        mov   r2, r4
        add   r2, r1
        imm   r0, 11
        imm   r1, 1048572
        imm   r3, 2
        mov   r4, r5
        call  set_incomplete
        ret

; Record the first source-level failure. All parser/static failures deliberately
; share one stable v1 reason instead of exposing private parser phases.
set_error:
        imm   r0, 524304
        load  r1, r0
        jnz   r1, se_done
        imm   r1, 1
        store r0, r1
        imm   r0, 524744
        imm   r1, 1
        store r0, r1
        imm   r0, 524752
        store r0, r1
        imm   r0, 524296
        load  r1, r0
        imm   r0, 524760
        store r0, r1
        imm   r0, 524768
        imm   r1, 0
        store r0, r1
        imm   r0, 524776
        store r0, r1
se_done:
        ret

; Inputs r0=resource code, r1=limit, r2=requested. The decisive source cursor
; is the coordinate. Preserve any earlier outcome.
set_incomplete_at_source:
        mov   r6, r0
        mov   r7, r1
        mov   r10, r2
        imm   r3, 1
        imm   r4, 524296
        load  r4, r4
        mov   r0, r6
        mov   r1, r7
        mov   r2, r10
        call  set_incomplete
        ret

; Inputs r0=resource code, r1=limit, r2=requested, r3=coordinate space,
; r4=coordinate. Preserve the first decisive outcome.
set_incomplete:
        mov   r5, r0
        imm   r0, 524304
        load  r6, r0
        jnz   r6, si_done
        imm   r6, 2
        store r0, r6
        imm   r0, 524744
        store r0, r5
        imm   r0, 524752
        store r0, r3
        imm   r0, 524760
        store r0, r4
        imm   r0, 524768
        store r0, r1
        imm   r0, 524776
        store r0, r2
si_done:
        ret

; Inputs r0=internal reason, r1=coordinate space, r2=coordinate. An explicit
; internal contradiction supersedes no prior event; replay promotion below
; handles earlier Reject/Incomplete outcomes from a supposedly identical pass.
set_internal:
        mov   r5, r0
        imm   r0, 524304
        load  r6, r0
        jnz   r6, sint_done
        imm   r6, 3
        store r0, r6
        imm   r0, 524744
        store r0, r5
        imm   r0, 524752
        store r0, r1
        imm   r0, 524760
        store r0, r2
        imm   r0, 524768
        imm   r1, 0
        store r0, r1
        imm   r0, 524776
        store r0, r1
sint_done:
        ret

; Replay must never rediscover a source rejection or private exhaustion after
; the complete validation pass. Preserve a more specific InternalFailure, or
; promote any other replay outcome to REPLAY_REJECTED at the current cursor.
promote_internal_failure:
        imm   r0, 524304
        load  r1, r0
        imm   r2, 3
        jeq   r1, r2, pif_done
        imm   r1, 0
        store r0, r1
        imm   r0, 1
        imm   r1, 1
        imm   r2, 524296
        load  r2, r2
        call  set_internal
pif_done:
        ret

; Emit the exact GCOUT v1 frame after all fields and the halt tag have been
; committed. The first byte is permanently outside Alpha's opcode space.
publish_diagnostic:
        imm   r0, 255
        write r0
        imm   r0, 71
        write r0
        imm   r0, 67
        write r0
        imm   r0, 79
        write r0
        imm   r0, 85
        write r0
        imm   r0, 84
        write r0
        imm   r0, 1
        write r0
        imm   r0, 0
        write r0
        imm   r0, 524304
        load  r0, r0
        write r0
        imm   r0, 524752
        load  r0, r0
        write r0
        imm   r0, 0
        write r0
        write r0
        imm   r0, 524744
        imm   r1, 4
        call  publish_memory_bytes
        imm   r0, 524760
        imm   r1, 8
        call  publish_memory_bytes
        imm   r0, 524768
        imm   r1, 8
        call  publish_memory_bytes
        imm   r0, 524776
        imm   r1, 8
        call  publish_memory_bytes
        ret

; Inputs r0=memory address and r1=byte count.
publish_memory_bytes:
        mov   r6, r0
        mov   r7, r1
pmb_loop:
        imm   r0, 0
        jeq   r7, r0, pmb_done
        loadb r0, r6
        write r0
        imm   r0, 1
        add   r6, r0
        sub   r7, r0
        jmp   pmb_loop
pmb_done:
        ret

error_value:
        imm   r0, 524304
        load  r0, r0
        ret

; ---------------- static output and keyword bytes ----------------
kw_proc:
        db "proc"
kw_return:
        db "return"
kw_let:
        db "let"
kw_state:
        db "state"
kw_to:
        db "to"
kw_when:
        db "when"
kw_byte:
        db "byte"
kw_word:
        db "word"
kw_emit:
        db "emit"
kw_read_byte:
        db "read_byte"
kw_write_byte:
        db "write_byte"
kw_main:
        db "main"
