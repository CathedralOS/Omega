proc d19_name_matches(off, code) {
    let i = 0
    state code {
        to no when ((code < 1) + (code > 32) != 0)
        let base = 10747904 + (code - 1) * 32
        let length = word[base]
        to loop
    }
    state loop {
        to exact when (i == length)
        to no when (byte[2097152 + off + i] != byte[base + 8 + i])
        i = i + 1
        to loop
    }
    state exact { return 1 - is_ident_continue(byte[2097152 + off + length]) }
    state no { return 0 }
}

proc d19_name_code(off) {
    let code = 1
    state loop { to compare when (code <= 32)  return 0 }
    state compare {
        to found when (d19_name_matches(off, code) == 1)
        code = code + 1
        to loop
    }
    state found { return code }
}


; Closed D16 builtin identity. Return 1 empty, 2 single, 3 length, 4 get,
; 5 slice, 6 concat, or 0 for an ordinary function name.
proc bytes_builtin_kind(off) {
    state empty {
        to ret_empty when (name_is_packed(off, 7882811672009931106, 7959664, 11) == 1)
        to single
    }
    state ret_empty { return 1 }
    state single {
        to ret_single when (name_is_packed(off, 7598521945532168546, 1701603182, 12) == 1)
        to length
    }
    state ret_single { return 2 }
    state length {
        to ret_length when (name_is_packed(off, 7308321244543482210, 1752459118, 12) == 1)
        to get
    }
    state ret_length { return 3 }
    state get {
        to ret_get when (name_is_packed(off, 7306913869659928930, 116, 9) == 1)
        to slice
    }
    state ret_get { return 4 }
    state slice {
        to ret_slice when (name_is_packed(off, 7814694727645952354, 6644585, 11) == 1)
        to concat
    }
    state ret_slice { return 5 }
    state concat {
        to ret_concat when (name_is_packed(off, 8026363910132365666, 1952539502, 12) == 1)
        return 0
    }
    state ret_concat { return 6 }
}

proc is_upper(c) {
    state c1 { to no when (c < 'A')  to c2 }
    state c2 { to no when (c > 'Z')  return 1 }
    state no { return 0 }
}

proc is_value_name_start(c) {
    state underscore { to yes when (c == '_')  to lower_low }
    state lower_low { to no when (c < 'a')  to lower_high }
    state lower_high { to no when (c > 'z')  return 1 }
    state yes { return 1 }
    state no { return 0 }
}

proc is_reserved_value_name(off) {
    state builtin { to yes when (bytes_builtin_kind(off) != 0)  to k_if }
    state k_if { to yes when (name_is_packed(off, 26217, 0, 2) == 1)  to k_eq }
    state k_eq { to yes when (name_is_packed(off, 29029, 0, 2) == 1)  to k_lt }
    state k_lt { to yes when (name_is_packed(off, 29804, 0, 2) == 1)  to k_let }
    state k_let { to yes when (name_is_packed(off, 7628140, 0, 3) == 1)  to k_def }
    state k_def { to yes when (name_is_packed(off, 6710628, 0, 3) == 1)  to k_data }
    state k_data { to yes when (name_is_packed(off, 1635017060, 0, 4) == 1)  to k_match }
    state k_match { to yes when (name_is_packed(off, 448345170285, 0, 5) == 1)  return 0 }
    state yes { return 1 }
}

proc valid_value_name(off) {
    state first {
        to reserved when (is_value_name_start(byte[2097152 + off]) == 1)
        return 0
    }
    state reserved { to yes when (is_reserved_value_name(off) == 0)  return 0 }
    state yes { return 1 }
}

; Declared nominal types and constructors share D16's capitalization and
; builtin-name exclusion while D20 keeps their semantic namespaces separate.
proc valid_nominal_name(off) {
    state first { to int_check when (is_upper(byte[2097152 + off]) == 1)  return 0 }
    state int_check { to bytes_check when (name_is_packed(off, 7630409, 0, 3) == 0)  return 0 }
    state bytes_check { to yes when (name_is_packed(off, 495623371074, 0, 5) == 0)  return 0 }
    state yes { return 1 }
}

; Hash one exact ASCII identifier into the reusable 65,536-row coverage table.
; Reducing after every byte avoids relying on wrapping arithmetic.
proc name_hash(off) {
    let h = 0
    let i = off
    state bound {
        to loop when (i < word[2097136])
        return h
    }
    state loop {
        to body when (is_ident_continue(byte[2097152 + i]) == 1)
        return h
    }
    state body {
        h = (h * 131 + byte[2097152 + i]) % 65536
        i = i + 1
        to bound
    }
}

; Return the earlier of best_off and this namespace's first later duplicate.
; COVERAGE is scratch here and is cleared before each grammar-selected
; namespace. Rows retain declaration indexes, so hash collisions are resolved
; by exact source-name comparison and never acquire semantic meaning.
proc namespace_duplicate_before(base, stride, count, best_off) {
    let clear = 0
    state clear_loop {
        to clear_body when (clear < 65536)
        let i = 0
        to declaration_loop
    }
    state clear_body {
        word[10485760 + clear * 8] = 0
        clear = clear + 1
        to clear_loop
    }
    state declaration_loop {
        to declaration_body when (i < count)
        return best_off
    }
    state declaration_body {
        let name_off = word[base + i * stride]
        let bucket = name_hash(name_off)
        let probes = 0
        to probe
    }
    state probe {
        let retained = word[10485760 + bucket * 8]
        to empty when (retained == 0)
        to duplicate when (name_eq(name_off, word[base + (retained - 1) * stride]) == 1)
        probes = probes + 1
        to exhausted when (probes == 65536)
        bucket = (bucket + 1) % 65536
        to probe
    }
    state empty {
        word[10485760 + bucket * 8] = i + 1
        i = i + 1
        to declaration_loop
    }
    state duplicate { to earlier when (name_off < best_off)  return best_off }
    state earlier { return name_off }
    state exhausted { mark_resource_failed()  return best_off }
}

; resolve a type name to a type id: Int = 0, Bytes = 1, else nominal, else -1.
proc tyid(off) {
    state intchk { to byteschk when (name_is_packed(off, 7630409, 0, 3) == 0)  return 0 }
    state byteschk { to scan when (name_is_packed(off, 495623371074, 0, 5) == 0)  return 1 }
    state scan {
        let n = word[2097104]
        let i = 2
        to loop
    }
    state loop {
        to body when (i < n)
        to missing
    }
    state body {
        to hit when (name_eq(off, word[6291456 + i * 8]) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
    state missing {
        mark_invalid_at(off)
        return 0 - 1
    }
}

proc global_lookup(noff, base, stride, n) { ; global index by name, or -1
    let i = 0
    state loop {
        to body when (i < n)
        return 0 - 1
    }
    state body {
        to hit when (name_eq(noff, word[base + i * stride]) == 1)
        i = i + 1
        to loop
    }
    state hit { return i }
}

; ---- parser (core expressions) ----

proc parse_args() {
    let head = 0
    let tail = 0
    state loop {
        skip_ws()
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        let item = parse_expr()
        to exhausted when (word[2097072] != 0)
        word[2097048] = word[item] / 256
        let node = alloc(6, item, 0, 0)
        to exhausted when (word[2097072] != 0)
        to first when (head == 0)
        word[tail + 16] = node
        tail = node
        to loop
    }
    state first { head = node  tail = node  to loop }
    state exhausted { return head }
    state eof { mark_invalid()  return head }
    state done { return head }
}

proc parse_expr() {
    skip_ws()
    let start = word[2097144]
    let depth = word[2097064]
    state capacity { to enter when (depth < 1024)  to exhausted }
    state enter {
        word[2097064] = depth + 1
        let result = parse_expr_inner(start)
        word[2097064] = depth
        return result
    }
    state exhausted { mark_resource_failed()  return 16777216 }
}

proc parse_expr_inner(start) {
    skip_ws()
    let c = cbyte()
    state start {
        to invalid when (c == 0)
        to invalid when (c == ')')
        to num
    }
    state num { to do_num when (is_digit(c) == 1)  to negnum }
    state negnum {
        to lparen when (c != '-')
        to lparen when (is_digit(byte[2097152 + word[2097144] + 1]) == 0)
        to do_num
    }
    state do_num {
        let value = parse_integer()
        word[2097048] = start
        return alloc(0, value, 0, 0)
    }
    state lparen { to compound when (c == '(')  to atom }
    state compound {
        adv()
        skip_ws()
        let h = cbyte()
        to do_op when (is_op(h) == 1)
        to head
    }
    state do_op {
        adv()
        let a = parse_expr()
        let b = parse_expr()
        consume_expected(')')
        word[2097048] = start
        return alloc(2, h, a, b)
    }
    state head {
        to invalid_compound when (is_ident_start(cbyte()) == 0)
        let hoff = take_ident()
        to do_if when (name_is_packed(hoff, 26217, 0, 2) == 1)
        to k_let
    }
    state do_if {
        let c1 = parse_expr()
        let t1 = parse_expr()
        let e1 = parse_expr()
        consume_expected(')')
        word[2097048] = start
        return alloc(3, c1, t1, e1)
    }
    state k_let { to do_let when (name_is_packed(hoff, 7628140, 0, 3) == 1)  to k_eq }
    state do_let {
        let noff = take_ident()
        to let_name_ok when (valid_value_name(noff) == 1)
        mark_invalid_at(noff)
        to let_name_ok
    }
    state let_name_ok {
        let e2 = parse_expr()
        let body = parse_expr()
        consume_expected(')')
        word[2097048] = start
        return alloc(4, noff, e2, body)
    }
    state k_eq { to do_eq when (name_is_packed(hoff, 29029, 0, 2) == 1)  to k_lt }
    state do_eq {
        let a2 = parse_expr()
        let b2 = parse_expr()
        consume_expected(')')
        word[2097048] = start
        return alloc(2, 'e', a2, b2)
    }
    state k_lt { to do_lt when (name_is_packed(hoff, 29804, 0, 2) == 1)  to k_match }
    state do_lt {
        let a3 = parse_expr()
        let b3 = parse_expr()
        consume_expected(')')
        word[2097048] = start
        return alloc(2, 'l', a3, b3)
    }
    state k_match { to do_match when (name_is_packed(hoff, 448345170285, 0, 5) == 1)  to k_con }
    state do_match {
        let scrut = parse_expr()
        let arms = parse_arms()
        consume_expected(')')
        word[2097048] = start
        return alloc(8, scrut, arms, 0)
    }
    state k_con { to do_con when (is_upper(byte[2097152 + hoff]) == 1)  to do_call }
    state do_con {
        let cargs = parse_args()
        consume_expected(')')
        word[2097048] = start
        return alloc(7, hoff, cargs, 0)
    }
    state do_call {
        to call_name_ok when (valid_value_name(hoff) == 1)
        ; The six reserved bytes_* forms are parsed through the same argument
        ; list representation but remain closed builtins in tc_call.
        to call_name_ok when (bytes_builtin_kind(hoff) != 0)
        mark_invalid_at(hoff)
        to call_name_ok
    }
    state call_name_ok {
        let args = parse_args()
        consume_expected(')')
        word[2097048] = start
        return alloc(5, hoff, args, 0)
    }
    state atom {
        to invalid when (is_ident_start(cbyte()) == 0)
        let voff = take_ident()
        to nullcon when (is_upper(byte[2097152 + voff]) == 1)
        to atom_name_ok when (valid_value_name(voff) == 1)
        mark_invalid_at(voff)
        to atom_name_ok
    }
    state atom_name_ok {
        word[2097048] = start
        return alloc(1, voff, 0, 0)
    }
    state nullcon {
        word[2097048] = start
        return alloc(7, voff, 0, 0)
    }                                                ; nullary constructor
    state invalid_compound {
        mark_invalid()
        to invalid_advance when (cbyte() != 0)
        return 16777216
    }
    state invalid {
        mark_invalid_at(start)
        to invalid_advance when (cbyte() != 0)
        return 16777216
    }
    state invalid_advance { adv()  return 16777216 }
}

proc parse_pvars() {
    let head = 0
    let tail = 0
    state loop {
        skip_ws()
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        let voff = take_ident()
        to name_ok when (valid_value_name(voff) == 1)
        mark_invalid_at(voff)
        to name_ok
    }
    state name_ok {
        word[2097048] = voff
        let node = alloc(6, voff, 0, 0)
        to exhausted when (word[2097072] != 0)
        to first when (head == 0)
        word[tail + 16] = node
        tail = node
        to loop
    }
    state first { head = node  tail = node  to loop }
    state exhausted { return head }
    state eof { mark_invalid()  return head }
    state done { return head }
}

proc parse_pat() {
    skip_ws()
    let start = word[2097144]
    state chk { to pcon when (cbyte() == '(')  to atom }
    state pcon {
        consume_expected('(')
        let coff = take_ident()
        to pcon_name_ok when (valid_nominal_name(coff) == 1)
        mark_invalid_at(coff)
        to pcon_name_ok
    }
    state pcon_name_ok {
        let vars = parse_pvars()
        consume_expected(')')
        word[2097048] = start
        return alloc(10, coff, vars, 0)               ; PCON
    }
    state atom {
        let voff = take_ident()
        to nullcon when (is_upper(byte[2097152 + voff]) == 1)
        to pvar_name_ok when (valid_value_name(voff) == 1)
        mark_invalid_at(voff)
        to pvar_name_ok
    }
    state pvar_name_ok {
        word[2097048] = start
        return alloc(9, voff, 0, 0)                   ; PVAR
    }
    state nullcon {
        to nullcon_ok when (valid_nominal_name(voff) == 1)
        mark_invalid_at(voff)
        to nullcon_ok
    }
    state nullcon_ok {
        word[2097048] = start
        return alloc(10, voff, 0, 0)
    }                                                ; nullary constructor pattern
}

proc parse_arms() {
    let head = 0
    let tail = 0
    state loop {
        skip_ws()
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        let arm_start = word[2097144]
        consume_expected('(')
        let pat = parse_pat()
        let body = parse_expr()
        consume_expected(')')
        to exhausted when (word[2097072] != 0)
        word[2097048] = arm_start
        let armnode = alloc(11, pat, body, 0)
        to exhausted when (word[2097072] != 0)
        word[2097048] = arm_start
        let node = alloc(6, armnode, 0, 0)
        to exhausted when (word[2097072] != 0)
        to first when (head == 0)
        word[tail + 16] = node
        tail = node
        to loop
    }
    state first { head = node  tail = node  to loop }
    state exhausted { return head }
    state eof { mark_invalid()  return head }
    state done { return head }
}

proc parse_typed_params() {       ; (pname Ty) pairs until ')', CONS of PARAM nodes
    let head = 0
    let tail = 0
    state loop {
        skip_ws()
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        let param_start = word[2097144]
        consume_expected('(')
        let poff = take_ident()
        to param_name_ok when (valid_value_name(poff) == 1)
        mark_invalid_at(poff)
        to param_name_ok
    }
    state param_name_ok {
        let toff = take_ident()
        to param_type_ok when (is_upper(byte[2097152 + toff]) == 1)
        mark_invalid_at(toff)
        to param_type_ok
    }
    state param_type_ok {
        consume_expected(')')
        ; Keep the source spelling until every nominal declaration exists.
        word[2097048] = param_start
        let node = alloc(50, poff, toff, 0)
        to exhausted when (word[2097072] != 0)
        word[2097048] = param_start
        let link = alloc(6, node, 0, 0)
        to exhausted when (word[2097072] != 0)
        to first when (head == 0)
        word[tail + 16] = link
        tail = link
        to loop
    }
    state first { head = link  tail = link  to loop }
    state exhausted { return head }
    state eof { mark_invalid()  return head }
    state done { return head }
}

proc parse_def() {
    consume_expected('(')
    let keyword = take_ident()
    to keyword_ok when (name_is_packed(keyword, 6710628, 0, 3) == 1)
    mark_invalid_at(keyword)
    to keyword_ok
    state keyword_ok {
    let noff = take_ident()
    to name_ok when (valid_value_name(noff) == 1)
    mark_invalid_at(noff)
    to name_ok
    }
    state name_ok {
    consume_expected('(')
    let params = parse_typed_params()
    consume_expected(')')
    let rtoff = take_ident()
    to return_type_ok when (is_upper(byte[2097152 + rtoff]) == 1)
    mark_invalid_at(rtoff)
    to return_type_ok
    }
    state return_type_ok {
    let body = parse_expr()
    consume_expected(')')
    let i = word[2097120]
    to store when (i < 32768)
    mark_resource_failed()
    return 0
    }
    state store {
    word[8388608 + i * 32] = noff
    word[8388608 + i * 32 + 8] = params
    ; Keep the source spelling until the post-parse type-resolution phase.
    word[8388608 + i * 32 + 16] = rtoff
    word[8388608 + i * 32 + 24] = body
    word[2097120] = i + 1
    return 0
    }
}

proc parse_argtypes() {           ; constructor arg type names until ')', CONS of tyids
    let head = 0
    let tail = 0
    state loop {
        skip_ws()
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        let toff = take_ident()
        to type_name_ok when (is_upper(byte[2097152 + toff]) == 1)
        mark_invalid_at(toff)
        to type_name_ok
    }
    state type_name_ok {
        ; Constructor field types are symbolic until all data declarations land.
        word[2097048] = toff
        let node = alloc(6, toff, 0, 0)
        to exhausted when (word[2097072] != 0)
        to first when (head == 0)
        word[tail + 16] = node
        tail = node
        to loop
    }
    state first { head = node  tail = node  to loop }
    state exhausted { return head }
    state eof { mark_invalid()  return head }
    state done { return head }
}

proc parse_data() {               ; (data T (C ArgTy...)...) -> register type + cons
    consume_expected('(')
    let keyword = take_ident()
    to keyword_ok when (name_is_packed(keyword, 1635017060, 0, 4) == 1)
    mark_invalid_at(keyword)
    to keyword_ok
    state keyword_ok {
    let toff = take_ident()
    to type_name_ok when (valid_nominal_name(toff) == 1)
    mark_invalid_at(toff)
    to type_name_ok
    }
    state type_name_ok {
    let tid = word[2097104]        ; register the type first (self-recursion resolves)
    to store_type when (tid < 65536)
    mark_resource_failed()
    tid = 0
    to type_registered
    }
    state store_type {
    word[6291456 + tid * 8] = toff
    word[2097104] = tid + 1
    to type_registered
    }
    state type_registered {
    let first_con = word[2097096]
    skip_ws()
    to loop
    }
    state loop {
        to done when (cbyte() == ')')
        to eof when (cbyte() == 0)
        to body
    }
    state body {
        consume_expected('(')
        let coff = take_ident()
        to con_name_ok when (valid_nominal_name(coff) == 1)
        mark_invalid_at(coff)
        to con_name_ok
    }
    state con_name_ok {
        let argtys = parse_argtypes()
        consume_expected(')')
        let ci = word[2097096]
        to store_con when (ci < 65536)
        mark_resource_failed()
        to loop_after_con
    }
    state store_con {
        word[6815744 + ci * 24] = coff
        word[6815744 + ci * 24 + 8] = tid
        word[6815744 + ci * 24 + 16] = argtys
        word[2097096] = ci + 1
        to loop_after_con
    }
    state loop_after_con {
        skip_ws()
        to loop
    }
    state eof { mark_invalid()  return 0 }
    state done {
        to have_constructor when (word[2097096] != first_con)
        mark_invalid()
        to have_constructor
    }
    state have_constructor {
        consume_expected(')')
        return 0
    }
}

proc is_root_form(packed_name, name_length) {
    state chk { to paren when (cbyte() == '(')  return 0 }
    state paren {
        let save = word[2097144]
        adv()
        skip_ws()
        let r = name_is_packed(word[2097144], packed_name, 0, name_length)
        word[2097144] = save
        return r
    }
}

; ---- type environment (var -> tyid), frame-local lookup ----

proc tenv_push(off, t, local_kind, index) {
    let n = word[2097112]
    state unique {
        to capacity when (tenv_lookup(off) == 0 - 1)
        mark_invalid_at(off)
        return 0
    }
    state capacity { to store when (n < 65536)  to exhausted }
    state store {
    word[9437184 + n * 16] = off
    word[9437184 + n * 16 + 8] = t + 65536 + local_kind * 131072 + index * 262144
    word[2097112] = n + 1
    return 1
    }
    state exhausted { mark_resource_failed()  return 0 }
}

; Commit one local binder only after D20's source duplicate check and both
; private capacities succeed. This keeps source rejection ahead of resource
; exhaustion and prevents a failed bind from mutating TENV, slot cursors, or
; the packed-profile maximum.
proc tenv_push_local(off, t, slot) {
    let n = word[2097112]
    state unique {
        to environment_capacity when (tenv_lookup(off) == 0 - 1)
        mark_invalid_at(off)
        return 0
    }
    state environment_capacity { to slot_capacity when (n < 65536)  to exhausted }
    state slot_capacity { to commit when (slot < 65535)  to exhausted }
    state commit {
        word[9437184 + n * 16] = off
        word[9437184 + n * 16 + 8] = t + 196608 + slot * 262144
        word[2097112] = n + 1
        word[2096896] = slot + 1
        to maximum
    }
    state maximum { to update when (word[2096896] > word[2096888])  return 1 }
    state update { word[2096888] = word[2096896]  return 1 }
    state exhausted { mark_resource_failed()  return 0 }
}

proc tenv_lookup(qoff) {
    let j = word[2097112] - 1
    let result = 0 - 1
    state loop {
        to body when (j >= 0)
        return result
    }
    state body {
        to hit when (name_eq(qoff, word[9437184 + j * 16]) == 1)
        j = j - 1
        to loop
    }
    state hit {
        result = word[9437184 + j * 16 + 8]
        return result
    }
}

; Resolve declaration type spellings only after the complete data* / def+
; sequence has been collected. D20 duplicate rejection runs first over those
; exact rows; the remainder implements D16 forward/mutual nominal references.
proc resolve_decl_types() {
    let duplicate = word[2097136]
    duplicate = namespace_duplicate_before(6291472, 8, word[2097104] - 2, duplicate)
    duplicate = namespace_duplicate_before(6815744, 24, word[2097096], duplicate)
    duplicate = namespace_duplicate_before(8388608, 32, word[2097120], duplicate)
    ; Function rows retain at most 32,768 one-based indexes in COVERAGE. Start
    ; match epochs above that range so the final hash table needs no fourth
    ; 65,536-row clearing pass before exhaustiveness checking.
    word[2097080] = 65536
    state declarations {
        to duplicate_declaration when (duplicate < word[2097136])
        let ci = 0
        to con_loop
    }
    state duplicate_declaration { mark_invalid_at(duplicate)  return 0 }
    state con_loop {
        to con_body when (ci < word[2097096])
        to fun_start
    }
    state con_body {
        let fields = word[6815744 + ci * 24 + 16]
        to field_loop
    }
    state field_loop {
        to field_body when (fields != 0)
        ci = ci + 1
        to con_loop
    }
    state field_body {
        word[fields + 8] = tyid(word[fields + 8])
        fields = word[fields + 16]
        to field_loop
    }
    state fun_start { let fi = 0  to fun_loop }
    state fun_loop {
        to fun_body when (fi < word[2097120])
        return 0
    }
    state fun_body {
        word[8388608 + fi * 32 + 16] = tyid(word[8388608 + fi * 32 + 16])
        let params = word[8388608 + fi * 32 + 8]
        to param_loop
    }
    state param_loop {
        to param_body when (params != 0)
        fi = fi + 1
        to fun_loop
    }
    state param_body {
        let param = word[params + 8]
        word[param + 16] = tyid(word[param + 16])
        params = word[params + 16]
        to param_loop
    }
}

; ---- the type checker: tc(expr) -> tyid, or -1 on a type error ----

proc tc_bytes_builtin(kind, args) {
    state dispatch {
        to empty when (kind == 1)
        to single when (kind == 2)
        to length when (kind == 3)
        to get when (kind == 4)
        to slice when (kind == 5)
        to concat
    }
    state empty { to bytesret when (args == 0)  return 0 - 1 }
    state single {
        to bad when (args == 0)
        let a1 = args
        to bad when (word[a1 + 16] != 0)
        to bytesret when (tc(word[a1 + 8]) == 0)
        to bad
    }
    state length {
        to bad when (args == 0)
        let a2 = args
        to bad when (word[a2 + 16] != 0)
        to intret when (tc(word[a2 + 8]) == 1)
        to bad
    }
    state get {
        to bad when (args == 0)
        let g1 = args
        let g2 = word[g1 + 16]
        to bad when (g2 == 0)
        to bad when (word[g2 + 16] != 0)
        to bad when (tc(word[g1 + 8]) != 1)
        to intret when (tc(word[g2 + 8]) == 0)
        to bad
    }
    state slice {
        to bad when (args == 0)
        let s1 = args
        let s2 = word[s1 + 16]
        to bad when (s2 == 0)
        let s3 = word[s2 + 16]
        to bad when (s3 == 0)
        to bad when (word[s3 + 16] != 0)
        to bad when (tc(word[s1 + 8]) != 1)
        to bad when (tc(word[s2 + 8]) != 0)
        to bytesret when (tc(word[s3 + 8]) == 0)
        to bad
    }
    state concat {
        to bad when (args == 0)
        let c1 = args
        let c2 = word[c1 + 16]
        to bad when (c2 == 0)
        to bad when (word[c2 + 16] != 0)
        to bad when (tc(word[c1 + 8]) != 1)
        to bytesret when (tc(word[c2 + 8]) == 1)
        to bad
    }
    state intret { return 0 }
    state bytesret { return 1 }
    state bad { return 0 - 1 }
}

proc tc_arguments(params, args, params_are_nodes) {
    let p = params
    let a = args
    let fail = 0
    state loop {
        to pdone when (p == 0)
        to achk
    }
    state achk {
        to adone when (a == 0)
        let expected = word[p + 8]
        to parameter_node when (params_are_nodes == 1)
        to compare
    }
    state parameter_node { expected = word[expected + 16]  to compare }
    state compare { to mark when (tc(word[a + 8]) != expected)  to advance }
    state mark { fail = 1  to advance }
    state advance { p = word[p + 16]  a = word[a + 16]  to loop }
    state pdone { to overmark when (a != 0)  return 1 - fail }
    state adone { return 0 }
    state overmark { return 0 }
}

proc tc_call(expr) {
    let fname = word[expr + 8]
    let args = word[expr + 16]
    let builtin = bytes_builtin_kind(fname)
    state builtin_check { to builtin_call when (builtin != 0)  to ordinary }
    state builtin_call { return tc_bytes_builtin(builtin, args) }
    state ordinary {
        let fi = global_lookup(fname, 8388608, 32, word[2097120])
        to fchk
    }
    state fchk { to known when (fi != 0 - 1)  return 0 - 1 }   ; unknown function
    state known {
        ; Zero remains the unresolved/builtin sentinel; table identities are
        ; retained one-based for the eventual tag-5 lowering join.
        word[expr + 24] = fi + 1
        let args_ok = tc_arguments(word[8388608 + fi * 32 + 8], args, 1)
        to failret when (args_ok == 0)
        return word[8388608 + fi * 32 + 16] % 65536
    }
    state failret { return 0 - 1 }
}

proc tc_conapp(expr) {
    let coff = word[expr + 8]
    let args = word[expr + 16]
    let ci = global_lookup(coff, 6815744, 24, word[2097096])
    state cchk { to known when (ci != 0 - 1)  return 0 - 1 }   ; unknown constructor
    state known {
        word[expr + 24] = ci + 1
        let args_ok = tc_arguments(word[6815744 + ci * 24 + 16], args, 0)
        to failret when (args_ok == 0)
        return word[6815744 + ci * 24 + 8]
    }
    state failret { return 0 - 1 }
}

proc tc_match(scrut, arms) {
    let st = tc(scrut)
    state schk { to algebraic when (st > 1)  return 0 - 1 }
    state algebraic {
        word[2097080] = word[2097080] + 1
        to ok
    }
    state ok {
        let arm = arms
        let rty = 0 - 2                ; -2 = result type not yet seen
        let fail = 0
        let catchall = 0
        let covered_by_catchall = 0
        let seen = 0
        let epoch = word[2097080]
        let phase = 0                  ; 0 types bodies, 1 rebuilds coverage
        let ci2 = 0
        to loop
    }
    state loop {
        to armbody when (arm != 0)
        to finish
    }
    state armbody {
        let armnode = word[arm + 8]
        let pat = word[armnode + 8]
        let base = word[2097112]
        let local_base = word[2096896]
        seen = 1
        to after_catchall when (catchall == 1)
        to patkind
    }
    state after_catchall { fail = 1  to patkind }
    state patkind {
        to pvar when (word[pat] % 256 == 9)
        to pcon
    }
    state pvar {
        to nextarm when (phase == 1)
        catchall = 1
        covered_by_catchall = 1
        let slot = word[2096896]
        to pvar_bound when (tenv_push_local(word[pat + 8], st, slot) == 1)
        to binding_resource when (word[2097072] != 0)
        fail = 1
        to checkbody
    }
    state pvar_bound {
        word[pat + 16] = slot + 1
        to checkbody
    }
    state pcon {
        let ci = global_lookup(word[pat + 8], 6815744, 24, word[2097096])
        to pattern_fail when (ci == 0 - 1)
        to tymatch
    }
    state tymatch {
        to pattern_fail when (word[6815744 + ci * 24 + 8] != st)
        to duplicate when (word[10485760 + ci * 8] == epoch)
        word[10485760 + ci * 8] = epoch
        word[pat + 24] = ci + 1
        to bindvars
    }
    state pattern_fail { fail = 1  to checkbody }
    state duplicate {
        fail = 1
        to bindvars
    }
    state bindvars {
        to nextarm when (phase == 1)
        let pv = word[pat + 16]
        let av = word[6815744 + ci * 24 + 16]
        to bindloop
    }
    state bindloop {
        to bindpv when (pv != 0)
        to bindrest                   ; pv == 0
    }
    state bindpv {
        to pattern_fail when (av == 0)   ; too many pattern vars
        let slot2 = word[2096896]
        to bind_record when (tenv_push_local(word[pv + 8], word[av + 8], slot2) == 1)
        to binding_resource when (word[2097072] != 0)
        fail = 1
        to bind_advance
    }
    state bind_record {
        word[pv + 24] = slot2 + 1
        to bind_advance
    }
    state bind_advance {
        pv = word[pv + 16]
        av = word[av + 16]
        to bindloop
    }
    state bindrest {
        to pattern_fail when (av != 0)   ; too few pattern vars
        to checkbody
    }
    state checkbody {
        let bt = tc(word[armnode + 16])
        word[2097112] = base
        word[2096896] = local_base
        to body_resource when (word[2097072] != 0)
        to btfail when (bt == 0 - 1)
        to rtychk
    }
    state binding_resource {
        word[2097112] = base
        word[2096896] = local_base
        return 0 - 1
    }
    state body_resource { return 0 - 1 }
    state btfail { fail = 1  to rtychk }
    state rtychk {
        to setrty when (rty == 0 - 2)
        to cmprty
    }
    state setrty { rty = bt  to nextarm }
    state cmprty {
        to rtymark when (bt != rty)
        to nextarm
    }
    state rtymark { fail = 1  to nextarm }
    state nextarm { arm = word[arm + 16]  to loop }
    state finish {
        to failret when (fail == 1)
        to failret when (seen == 0)
        to complete when (phase * covered_by_catchall == 1)
        to coverloop when (phase == 1)
        ; Recursive body checking may have reused the epoch table. Rewalk the
        ; already-resolved patterns without rechecking bodies, so duplicate and
        ; exhaustive coverage are owned by one stable fresh epoch.
        phase = 1
        word[2097080] = word[2097080] + 1
        epoch = word[2097080]
        catchall = 0
        arm = arms
        to loop
    }
    state coverloop {
        to coverbody when (ci2 < word[2097096])
        to complete
    }
    state coverbody {
        to covernext when (word[6815744 + ci2 * 24 + 8] != st)
        to missing when (word[10485760 + ci2 * 8] != epoch)
        to covernext
    }
    state covernext { ci2 = ci2 + 1  to coverloop }
    state missing { return 0 - 1 }
    state complete { return rty }
    state failret { return 0 - 1 }
}

proc tc(expr) {
    let result = tc_inner(expr)
    state checked { to invalid when (result == 0 - 1)  return result }
    state invalid {
        to resource when (word[2097072] != 0)
        mark_invalid_at(word[expr] / 256)
        return 0 - 1
    }
    state resource { return 0 - 1 }
}

proc tc_inner(expr) {
    let tag = word[expr] % 256
    state t0 { to ret_int when (tag == 0)  to t1 }
    state ret_int { return 0 }                       ; INT : Int
    state t1 { to ret_var when (tag == 1)  to t2 }
    state ret_var {
        let binding = tenv_lookup(word[expr + 8])
        to missing_var when (binding == 0 - 1)
        word[expr + 16] = binding
        return binding % 65536
    }
    state missing_var { return 0 - 1 }
    state t2 { to prim when (tag == 2)  to t3 }
    state prim {                                      ; PRIM : Int x Int -> Int
        let a = tc(word[expr + 16])
        let b = tc(word[expr + 24])
        to prim_a when (a == 0)
        return 0 - 1
    }
    state prim_a {
        to prim_int when (b == 0)
        return 0 - 1
    }
    state prim_int { return 0 }
    state t3 { to ifexpr when (tag == 3)  to t4 }
    state ifexpr {                                    ; IF : cond Int, branches equal
        let c = tc(word[expr + 8])
        let t = tc(word[expr + 16])
        let e = tc(word[expr + 24])
        to if_cond when (c == 0)
        return 0 - 1
    }
    state if_cond {
        to if_eq when (t == e)
        return 0 - 1
    }
    state if_eq { return t }
    state t4 { to letexpr when (tag == 4)  to t5 }
    state letexpr {                                   ; LET : bind the synthesised type
        let vt = tc(word[expr + 16])
        to let_ok when (vt != 0 - 1)
        return 0 - 1
    }
    state let_ok {
        let local_base = word[2096896]
        let slot = local_base
        to let_bound when (tenv_push_local(word[expr + 8], vt, slot) == 1)
        return 0 - 1
    }
    state let_bound {
        let r = tc(word[expr + 24])
        word[2097112] = word[2097112] - 1
        word[2096896] = local_base
        word[expr + 8] = slot + 1
        return r
    }
    state t5 { to callexpr when (tag == 5)  to t7 }
    state callexpr { return tc_call(expr) }
    state t7 { to conapp when (tag == 7)  to t8 }
    state conapp { return tc_conapp(expr) }
    state t8 { to matchexpr when (tag == 8)  return 0 - 1 }
    state matchexpr { return tc_match(word[expr + 8], word[expr + 16]) }
}

; ---- direct Alpha payload and fixup substrate -------------------------
;
; The canonical compiler authors bytes only in its private final buffer. No
; byte is published until lowering, fixup resolution, payload validation, and
; the D19-selected adapter all complete. Failure is sticky and records one
; private code/coordinate pair for the eventual compiler boundary.

proc emit_fail_once(code, coordinate) {
    state open { to done when (word[2097016] != 0)  to record }
    state record {
        word[2097016] = code
        word[2097008] = coordinate
        return 0
    }
    state done { return 0 }
}

proc emit_reset() {
    word[2097040] = 0        ; payload length
    word[2097032] = 0        ; allocated labels
    word[2097024] = 0        ; retained fixups
    word[2097016] = 0        ; sticky failure code
    word[2097008] = 0        ; sticky failure coordinate
    return 0
}

proc payload_reserve(count) {
    state sticky { to failed when (word[2097016] != 0)  to nonnegative }
    state nonnegative { to invalid when (count < 0)  to capacity }
    state capacity {
        to available when (count <= 1048572 - word[2097040])
        emit_fail_once(1, word[2097040])
        return 0
    }
    state invalid { emit_fail_once(1, word[2097040])  return 0 }
    state available { return 1 }
    state failed { return 0 }
}

proc put_byte(value) {
    state range_low { to invalid when (value < 0)  to range_high }
    state range_high { to invalid when (value > 255)  to reserve }
    state reserve { to write when (payload_reserve(1) == 1)  return 0 }
    state write {
        byte[133169152 + word[2097040]] = value
        word[2097040] = word[2097040] + 1
        return 1
    }
    state invalid { emit_fail_once(2, word[2097040])  return 0 }
}

proc put_u64(value) {
    state reserve { to write when (payload_reserve(8) == 1)  return 0 }
    state write {
        word[133169152 + word[2097040]] = value
        word[2097040] = word[2097040] + 8
        return 1
    }
}

proc new_label() {
    let label = word[2097032]
    state sticky { to failed when (word[2097016] != 0)  to capacity }
    state capacity { to allocate when (label < 65536)  to exhausted }
    state allocate {
        word[11010048 + label * 8] = 0
        word[2097032] = label + 1
        return label
    }
    state exhausted { emit_fail_once(3, label)  return 0 - 1 }
    state failed { return 0 - 1 }
}

proc define_label(label) {
    state sticky { to failed when (word[2097016] != 0)  to range_low }
    state range_low { to invalid when (label < 0)  to range_high }
    state range_high { to invalid when (label >= word[2097032])  to unused }
    state unused {
        to duplicate when (word[11010048 + label * 8] != 0)
        word[11010048 + label * 8] = word[2097040] + 1
        return 1
    }
    state duplicate { emit_fail_once(4, label)  return 0 }
    state invalid { emit_fail_once(5, label)  return 0 }
    state failed { return 0 }
}

proc add_fixup(payload_offset, label) {
    let row = word[2097024]
    state sticky { to failed when (word[2097016] != 0)  to label_low }
    state label_low { to invalid when (label < 0)  to label_high }
    state label_high { to invalid when (label >= word[2097032])  to offset_low }
    state offset_low { to invalid when (payload_offset < 0)  to offset_high }
    state offset_high {
        to invalid when (payload_offset > word[2097040] - 8)
        to capacity
    }
    state capacity { to write when (row < 116508)  to exhausted }
    state write {
        word[11534336 + row * 16] = payload_offset
        word[11534336 + row * 16 + 8] = label
        word[2097024] = row + 1
        return 1
    }
    state exhausted { emit_fail_once(6, row)  return 0 }
    state invalid { emit_fail_once(7, payload_offset)  return 0 }
    state failed { return 0 }
}

proc put_label_word(label) {
    let payload_offset = word[2097040]
    state placeholder { to fixup when (put_u64(0) == 1)  return 0 }
    state fixup { return add_fixup(payload_offset, label) }
}

proc resolve_fixups() {
    let row = 0
    state sticky { to failed when (word[2097016] != 0)  to loop }
    state loop { to body when (row < word[2097024])  to complete }
    state body {
        let payload_offset = word[11534336 + row * 16]
        let label = word[11534336 + row * 16 + 8]
        let encoded = word[11010048 + label * 8]
        to missing when (encoded == 0)
        let target = encoded - 1
        to invalid_target when (target >= word[2097040])
        word[133169152 + payload_offset] = target
        row = row + 1
        to loop
    }
    state missing { emit_fail_once(8, label)  return 0 }
    state invalid_target { emit_fail_once(11, target)  return 0 }
    state complete { return 1 }
    state failed { return 0 }
}

proc emit_register(value) {
    state low { to invalid when (value < 0)  to high }
    state high { to invalid when (value > 255)  return put_byte(value) }
    state invalid { emit_fail_once(9, word[2097040])  return 0 }
}

proc emit_r(op, reg) {
    state opcode {
        to accepted when (op == 0)
        to accepted when (op == 17)
        to accepted when (op == 18)
        to invalid
    }
    state accepted { to register when (put_byte(op) == 1)  return 0 }
    state register { return emit_register(reg) }
    state invalid { emit_fail_once(10, word[2097040])  return 0 }
}

proc emit_rr(op, left, right) {
    state opcode_low { to invalid when (op < 2)  to opcode_high }
    state opcode_high { to invalid when (op > 11)  to first }
    state first { to second when (put_byte(op) == 1)  return 0 }
    state second { to third when (emit_register(left) == 1)  return 0 }
    state third { return emit_register(right) }
    state invalid { emit_fail_once(10, word[2097040])  return 0 }
}

proc emit_imm(reg, value) {
    state opcode { to register when (put_byte(1) == 1)  return 0 }
    state register { to immediate when (emit_register(reg) == 1)  return 0 }
    state immediate { return put_u64(value) }
}

proc emit_jump(op, label) {
    state opcode {
        to accepted when (op == 12)
        to accepted when (op == 19)
        to invalid
    }
    state accepted { to target when (put_byte(op) == 1)  return 0 }
    state target { return put_label_word(label) }
    state invalid { emit_fail_once(10, word[2097040])  return 0 }
}

proc emit_rx(op, reg, label) {
    state opcode {
        to accepted when (op == 13)
        to accepted when (op == 14)
        to invalid
    }
    state accepted { to register when (put_byte(op) == 1)  return 0 }
    state register { to target when (emit_register(reg) == 1)  return 0 }
    state target { return put_label_word(label) }
    state invalid { emit_fail_once(10, word[2097040])  return 0 }
}

proc emit_rrx(op, left, right, label) {
    state opcode {
        to accepted when (op == 15)
        to accepted when (op == 16)
        to invalid
    }
    state accepted { to first when (put_byte(op) == 1)  return 0 }
    state first { to second when (emit_register(left) == 1)  return 0 }
    state second { to target when (emit_register(right) == 1)  return 0 }
    state target { return put_label_word(label) }
    state invalid { emit_fail_once(10, word[2097040])  return 0 }
}

proc emit_ret() {
    return put_byte(20)
}

; Generated Gamma code treats r249/r250 as caller-clobbered address scratch.
; Centralizing fixed-offset word access keeps object/frame layout emission
; auditable and avoids recompiling the same four-instruction address sequence
; at every field site.
proc emit_word_load(destination_register, base_register, offset) {
    emit_rr(2, 249, base_register)
    emit_imm(250, offset)
    emit_rr(3, 249, 250)
    emit_rr(10, destination_register, 249)
    return 0
}

proc emit_word_store(base_register, offset, value_register) {
    emit_rr(2, 249, base_register)
    emit_imm(250, offset)
    emit_rr(3, 249, 250)
    emit_rr(11, 249, value_register)
    return 0
}

; ---- emitted Gamma runtime containment --------------------------------
;
; Generated code reserves r252 as the downward explicit-stack pointer, r253
; as the current frame base, r254 as the upward immutable-heap pointer, and
; r255 as the heap limit. Allocation requests arrive in r2 and return their
; base in r0. A failed request transfers to the caller-supplied terminal label;
; it never falls into Alpha's undefined out-of-range memory behavior.

proc emit_runtime_init() {
    emit_imm(252, 16777216)
    emit_imm(253, 16777216)
    emit_imm(254, 16777248)
    emit_imm(255, 134217728)
    return 0
}

proc emit_heap_allocator(entry_label, failure_label) {
    define_label(entry_label)
    emit_imm(3, 0)
    emit_rrx(15, 2, 3, failure_label)
    emit_rr(2, 0, 254)
    emit_rr(2, 4, 254)
    emit_rr(3, 4, 2)
    emit_rrx(15, 4, 254, failure_label)
    emit_rrx(15, 255, 4, failure_label)
    emit_rr(2, 254, 4)
    emit_ret()
    return 0
}

proc emit_stack_reserver(entry_label, failure_label) {
    define_label(entry_label)
    emit_imm(3, 0)
    emit_rrx(15, 2, 3, failure_label)
    emit_rr(2, 4, 252)
    emit_rr(4, 4, 2)
    emit_imm(5, 1048576)
    emit_rrx(15, 4, 5, failure_label)
    emit_rr(2, 252, 4)
    emit_rr(2, 0, 4)
    emit_ret()
    return 0
}

; Frames retain complete two-word `(kind,payload)` values. A frame
; occupies `[r253, caller_cursor)`: previous r253 at +0, the caller's pre-arg
; r252 at +8, fixed local slots next, and parameters at the high end in source
; order (parameter zero is `caller_cursor - 16`). Expression temporaries and
; evaluated arguments grow below r253 through r252. Every non-tail call reserves
; at least the 16-byte header before using Alpha call/ret. The explicit stack
; therefore reaches its one-MiB guard while Alpha's hidden return stack remains
; above the 128 MiB heap ceiling, making hidden-stack overlap unreachable. Tail
; calls copy their already-evaluated arguments upward, inherit the caller
; cursor, replace the frame in place, and jump directly to the resolved callee.
; Compiler-owned prefix and field profiles are capped by the 15,728,640-byte
; explicit-stack extent before their 16-byte count arithmetic is evaluated.

proc emit_gamma_call_frame(stack_label, callee_label, prefix_bytes, parameter_count) {
    state prefix_low { to invalid when (prefix_bytes < 16)  to prefix_aligned }
    state prefix_aligned { to invalid when (prefix_bytes % 16 != 0)  to prefix_high }
    state prefix_high { to invalid when (prefix_bytes > 15728640)  to count_low }
    state count_low { to invalid_count when (parameter_count < 0)  to count_high }
    state count_high { to invalid_count when (parameter_count > 983040)  to valid }
    state valid {
        emit_rr(2, 6, 253)
        emit_rr(2, 7, 252)
        emit_imm(8, parameter_count * 16)
        emit_rr(3, 7, 8)
        emit_imm(2, prefix_bytes)
        emit_jump(19, stack_label)
        emit_rr(2, 9, 0)
        emit_word_store(9, 0, 6)
        emit_word_store(9, 8, 7)
        emit_rr(2, 253, 9)
        emit_jump(19, callee_label)
        return 1
    }
    state invalid { emit_fail_once(13, prefix_bytes)  return 0 }
    state invalid_count { emit_fail_once(13, parameter_count)  return 0 }
}

proc emit_gamma_return_frame() {
    emit_rr(2, 6, 253)
    emit_word_load(7, 6, 8)
    emit_word_load(8, 6, 0)
    emit_rr(2, 252, 7)
    emit_rr(2, 253, 8)
    emit_ret()
    return 1
}

; Expand one compiler-resolved fixed-local access inside the current Gamma
; frame. Mode 0 loads the complete pair into r0/r1; mode 1 stores r0/r1. The
; resolver later assigns opaque slot indexes, but this ABI owns their exact
; containment inside the fixed prefix after the two-word frame header.

proc validate_gamma_frame_local(frame_prefix_bytes, local_index) {
    state prefix_low { to invalid_prefix when (frame_prefix_bytes < 16)  to prefix_aligned }
    state prefix_aligned { to invalid_prefix when (frame_prefix_bytes % 16 != 0)  to prefix_high }
    state prefix_high { to invalid_prefix when (frame_prefix_bytes > 15728640)  to index_low }
    state index_low { to invalid_index when (local_index < 0)  to index_high }
    state index_high {
        to invalid_index when (local_index >= (frame_prefix_bytes - 16) / 16)
        return 1
    }
    state invalid_prefix { emit_fail_once(13, frame_prefix_bytes)  return 0 }
    state invalid_index { emit_fail_once(13, local_index)  return 0 }
}

proc emit_gamma_frame_local(frame_prefix_bytes, local_index, store_mode) {
    let profile_ok = validate_gamma_frame_local(frame_prefix_bytes, local_index)
    state profile { to offset when (profile_ok == 1)  return 0 }
    state offset { let slot_offset = 16 + local_index * 16  to mode }
    state mode { to load when (store_mode == 0)  to store_check }
    state store_check { to store when (store_mode == 1)  to invalid_mode }
    state load {
        emit_word_load(0, 253, slot_offset)
        emit_word_load(1, 253, slot_offset + 8)
        return 1
    }
    state store {
        emit_word_store(253, slot_offset, 0)
        emit_word_store(253, slot_offset + 8, 1)
        return 1
    }
    state invalid_mode { emit_fail_once(13, store_mode)  return 0 }
}

; Load one compiler-resolved parameter from the current Gamma frame. Parameters
; occupy complete two-word values above the fixed prefix in reverse physical
; order, so source parameter zero is the pair nearest the caller cursor. D20's
; resolver maps a source spelling to the opaque index; this seam owns only the
; already-fixed frame layout and rejects malformed metadata before emission.

proc lower_resolved_parameter(frame_prefix_bytes, parameter_count, parameter_index) {
    state prefix_low { to invalid_prefix when (frame_prefix_bytes < 16)  to prefix_aligned }
    state prefix_aligned { to invalid_prefix when (frame_prefix_bytes % 16 != 0)  to prefix_high }
    state prefix_high { to invalid_prefix when (frame_prefix_bytes > 15728640)  to count_low }
    state count_low { to invalid_count when (parameter_count < 0)  to count_high }
    state count_high { to invalid_count when (parameter_count > 983040)  to combined_extent }
    state combined_extent {
        to invalid_count when (parameter_count > (15728640 - frame_prefix_bytes) / 16)
        to index_low
    }
    state index_low { to invalid_index when (parameter_index < 0)  to index_high }
    state index_high { to invalid_index when (parameter_index >= parameter_count)  to load }
    state load {
        let parameter_offset = frame_prefix_bytes + (parameter_count - parameter_index - 1) * 16
        emit_word_load(0, 253, parameter_offset)
        emit_word_load(1, 253, parameter_offset + 8)
        return 1
    }
    state invalid_prefix { emit_fail_once(13, frame_prefix_bytes)  return 0 }
    state invalid_count { emit_fail_once(13, parameter_count)  return 0 }
    state invalid_index { emit_fail_once(13, parameter_index)  return 0 }
}

proc emit_gamma_tail_frame(target_prefix_bytes, parameter_count, callee_label,
                           failure_label) {
    state target_low { to invalid_target when (target_prefix_bytes < 16)  to target_aligned }
    state target_aligned { to invalid_target when (target_prefix_bytes % 16 != 0)  to target_high }
    state target_high { to invalid_target when (target_prefix_bytes > 15728640)  to count_low }
    state count_low { to invalid_count when (parameter_count < 0)  to count_high }
    state count_high { to invalid_count when (parameter_count > 983040)  to setup }
    state setup {
        emit_rr(2, 6, 253)
        emit_word_load(7, 6, 0)
        emit_word_load(8, 6, 8)
        emit_imm(10, target_prefix_bytes + parameter_count * 16)
        emit_rrx(15, 8, 10, failure_label)
        emit_rr(2, 9, 8)
        emit_rr(4, 9, 10)
        emit_imm(10, 1048576)
        emit_rrx(15, 9, 10, failure_label)
        let parameter_index = 0
        to copy_loop
    }
    state copy_loop { to copy_body when (parameter_index < parameter_count)  to install }
    state copy_body {
        let parameter_offset = (parameter_index + 1) * 16
        emit_rr(2, 10, 253)
        emit_imm(11, parameter_offset)
        emit_rr(4, 10, 11)
        emit_word_load(12, 10, 8)
        emit_rr(2, 13, 8)
        emit_imm(14, parameter_offset)
        emit_rr(4, 13, 14)
        emit_word_store(13, 8, 12)
        emit_word_load(12, 10, 0)
        emit_word_store(13, 0, 12)
        parameter_index = parameter_index + 1
        to copy_loop
    }
    state install {
        emit_word_store(9, 0, 7)
        emit_word_store(9, 8, 8)
        emit_rr(2, 253, 9)
        emit_rr(2, 252, 9)
        emit_jump(12, callee_label)
        return 1
    }
    state invalid_target { emit_fail_once(13, target_prefix_bytes)  return 0 }
    state invalid_count { emit_fail_once(13, parameter_count)  return 0 }
}

; Algebraic constructor tags are compiler-resolved private kinds >= 2. Fields
; retain complete two-word values in source order. Odd field counts round their
; vectors to the next 32-byte row so every heap allocation preserves the Bytes
; descriptor alignment invariant. Nullary constructors carry payload zero and
; allocate nothing.

proc emit_gamma_constructor_value(heap_label, constructor_tag, field_count) {
    state tag_low { to invalid_tag when (constructor_tag < 2)  to count_low }
    state count_low { to invalid_count when (field_count < 0)  to count_high }
    state count_high { to invalid_count when (field_count > 983040)  to empty_check }
    state empty_check { to empty when (field_count == 0)  to allocate }
    state empty {
        emit_imm(0, constructor_tag)
        emit_imm(1, 0)
        return 1
    }
    state allocate {
        let allocation_bytes = ((field_count + 1) / 2) * 32
        emit_imm(2, allocation_bytes)
        emit_jump(19, heap_label)
        emit_rr(2, 6, 0)
        let field_index = 0
        to copy_loop
    }
    state copy_loop { to copy_field when (field_index < field_count)  to finish }
    state copy_field {
        let source_offset = (field_count - field_index - 1) * 16
        let target_offset = field_index * 16
        emit_rr(2, 7, 252)
        emit_imm(8, source_offset)
        emit_rr(3, 7, 8)
        emit_word_load(9, 7, 0)
        emit_word_load(10, 7, 8)
        emit_word_store(6, target_offset, 9)
        emit_word_store(6, target_offset + 8, 10)
        field_index = field_index + 1
        to copy_loop
    }
    state finish {
        emit_imm(7, field_count * 16)
        emit_rr(3, 252, 7)
        emit_imm(0, constructor_tag)
        emit_rr(2, 1, 6)
        return 1
    }
    state invalid_tag { emit_fail_once(14, constructor_tag)  return 0 }
    state invalid_count { emit_fail_once(14, field_count)  return 0 }
}

proc emit_gamma_field_load(field_count, field_index, internal_label) {
    let below_heap = new_label()
    state count_low { to invalid when (field_count <= 0)  to count_high }
    state count_high { to invalid when (field_count > 983040)  to index_low }
    state index_low { to invalid when (field_index < 0)  to index_high }
    state index_high { to invalid when (field_index >= field_count)  to valid }
    state valid {
        let allocation_bytes = ((field_count + 1) / 2) * 32
        emit_rr(2, 6, 1)
        emit_imm(12, 16777248)
        emit_rrx(15, 6, 12, internal_label)
        emit_rrx(15, 6, 254, below_heap)
        emit_jump(12, internal_label)
        define_label(below_heap)
        emit_rr(2, 13, 6)
        emit_imm(14, allocation_bytes)
        emit_rr(3, 13, 14)
        emit_rrx(15, 13, 6, internal_label)
        emit_rrx(15, 254, 13, internal_label)
        emit_rr(2, 13, 6)
        emit_imm(14, 16777216)
        emit_rr(4, 13, 14)
        emit_imm(14, 32)
        emit_rr(7, 13, 14)
        emit_rx(14, 13, internal_label)
        emit_rr(2, 13, 6)
        emit_imm(14, field_index * 16)
        emit_rr(3, 13, 14)
        emit_word_load(0, 13, 0)
        emit_word_load(1, 13, 8)
        return 1
    }
    state invalid { emit_fail_once(14, field_index)  return 0 }
}

proc emit_checked_add(entry_label, failure_label) {
    let left_negative = new_label()
    let both_negative = new_label()
    let success = new_label()
    define_label(entry_label)
    emit_rr(2, 0, 2)
    emit_rr(3, 0, 3)
    emit_imm(4, 0)
    emit_rrx(15, 2, 4, left_negative)
    emit_rrx(15, 3, 4, success)
    emit_rrx(15, 0, 4, failure_label)
    emit_jump(12, success)
    define_label(left_negative)
    emit_rrx(15, 3, 4, both_negative)
    emit_jump(12, success)
    define_label(both_negative)
    emit_rrx(15, 0, 4, success)
    emit_jump(12, failure_label)
    define_label(success)
    emit_ret()
    return 0
}

proc emit_checked_sub(entry_label, failure_label) {
    let left_negative = new_label()
    let positive_minus_negative = new_label()
    let negative_minus_positive = new_label()
    let success = new_label()
    define_label(entry_label)
    emit_rr(2, 0, 2)
    emit_rr(4, 0, 3)
    emit_imm(4, 0)
    emit_rrx(15, 2, 4, left_negative)
    emit_rrx(15, 3, 4, positive_minus_negative)
    emit_jump(12, success)
    define_label(positive_minus_negative)
    emit_rrx(15, 0, 4, failure_label)
    emit_jump(12, success)
    define_label(left_negative)
    emit_rrx(15, 3, 4, success)
    emit_jump(12, negative_minus_positive)
    define_label(negative_minus_positive)
    emit_rrx(15, 0, 4, success)
    emit_jump(12, failure_label)
    define_label(success)
    emit_ret()
    return 0
}

proc emit_checked_mul(entry_label, failure_label) {
    let left_minimum = new_label()
    let right_minimum = new_label()
    let minimum_result = new_label()
    let zero_result = new_label()
    let success = new_label()
    define_label(entry_label)
    emit_imm(4, 0)
    emit_rrx(16, 2, 4, zero_result)
    emit_rrx(16, 3, 4, zero_result)
    emit_imm(5, 9223372036854775808)
    emit_rrx(16, 2, 5, left_minimum)
    emit_rrx(16, 3, 5, right_minimum)
    emit_rr(2, 0, 2)
    emit_rr(5, 0, 3)
    emit_rr(2, 6, 0)
    emit_rr(6, 6, 3)
    emit_rrx(16, 6, 2, success)
    emit_jump(12, failure_label)
    define_label(left_minimum)
    emit_imm(6, 1)
    emit_rrx(16, 3, 6, minimum_result)
    emit_jump(12, failure_label)
    define_label(right_minimum)
    emit_imm(6, 1)
    emit_rrx(16, 2, 6, minimum_result)
    emit_jump(12, failure_label)
    define_label(minimum_result)
    emit_rr(2, 0, 5)
    emit_jump(12, success)
    define_label(zero_result)
    emit_imm(0, 0)
    define_label(success)
    emit_ret()
    return 0
}

proc emit_checked_divmod(entry_label, failure_label, opcode) {
    state div_opcode { to labels when (opcode == 6)  to mod_opcode }
    state mod_opcode { to invalid_opcode when (opcode != 7)  to labels }
    state labels {
        let operate = new_label()
        let minimum_left = new_label()
        to body
    }
    state body {
        define_label(entry_label)
        emit_imm(4, 0)
        emit_rrx(16, 3, 4, failure_label)
        emit_imm(4, 9223372036854775808)
        emit_rrx(16, 2, 4, minimum_left)
        emit_jump(12, operate)
        define_label(minimum_left)
        emit_imm(4, 18446744073709551615)
        emit_rrx(16, 3, 4, failure_label)
        define_label(operate)
        emit_rr(2, 0, 2)
        emit_rr(opcode, 0, 3)
        emit_ret()
        return 0
    }
    state invalid_opcode { return 0 }
}

; Bytes descriptors are four words `[descriptor_kind, first, second,
; logical_length]`. Alpha's zeroed memory at 16 MiB is the one canonical EMPTY
; row. Dynamic rows begin at 16 MiB + 32: LEAF stores its byte pointer in
; `first` and may use its nonsemantic second word as inline storage, CONCAT
; stores left/right descriptors, and SLICE stores base/start. Private helper
; inputs and scalar/pointer outputs use r2..r4 and r0 respectively; general
; lowering reconstructs the public `(kind,payload)` pair.

; A D19-selected application profile supplies `maximum_bytes`; D21 requires the
; compiler to validate it in `0..INT64_MAX` before adapter emission. This helper
; does not select that profile or interpret the returned program value. It consumes
; sealed stdin once, stores the exact bytes in the private heap, and returns a
; canonical Bytes descriptor in r0. EOF at the exact maximum is accepted; the
; adjacent byte transfers to the supplied input-resource label. Heap extent
; exhaustion transfers independently to `heap_resource_label`; neither path
; changes r254 or publishes a partial descriptor. No path writes
; stdout. Generated r3..r14 plus the standard r249/r250 address scratch are
; caller-clobbered; r252/r253/r255 are preserved, and r254 changes only on
; nonempty success. The compiler-owned RUNTIME_INTERNAL_LABEL supplies the
; containment destination without exceeding Beta's four-argument ABI.
proc emit_gamma_read_sealed_bytes(entry_label, input_resource_label,
                                  heap_resource_label, maximum_bytes) {
    state maximum_low { to invalid when (maximum_bytes < 0)  to valid }
    state valid {
        let loop = new_label()
        let capacity_ok = new_label()
        let heap_ok = new_label()
        let done = new_label()
        let aligned = new_label()
        let empty = new_label()
        define_label(entry_label)
        emit_rr(2, 6, 254)
        emit_imm(7, 0)
        emit_imm(9, 16777216)
        emit_rrx(15, 6, 9, word[2096864])
        emit_rrx(15, 255, 6, word[2096864])
        emit_rr(2, 10, 6)
        emit_rr(4, 10, 9)
        emit_imm(9, 32)
        emit_rr(7, 10, 9)
        emit_rx(14, 10, word[2096864])
        emit_rr(2, 8, 6)
        emit_rr(3, 8, 9)
        emit_rr(2, 14, 8)
        define_label(loop)
        emit_r(17, 3)
        emit_imm(4, 0 - 1)
        emit_rrx(16, 3, 4, done)
        emit_imm(4, maximum_bytes)
        emit_rrx(15, 7, 4, capacity_ok)
        emit_jump(12, input_resource_label)
        define_label(capacity_ok)
        emit_rrx(15, 8, 255, heap_ok)
        emit_jump(12, heap_resource_label)
        define_label(heap_ok)
        emit_rr(9, 8, 3)
        emit_imm(4, 1)
        emit_rr(3, 8, 4)
        emit_rr(3, 7, 4)
        emit_jump(12, loop)
        define_label(done)
        emit_rx(13, 7, empty)
        emit_rr(2, 10, 8)
        emit_imm(9, 32)
        emit_rr(7, 8, 9)
        emit_imm(11, 0)
        emit_rx(13, 8, aligned)
        emit_imm(11, 32)
        emit_rr(4, 11, 8)
        define_label(aligned)
        emit_rr(2, 12, 10)
        emit_rr(3, 12, 11)
        emit_rrx(15, 12, 10, word[2096864])
        emit_rrx(15, 255, 12, heap_resource_label)
        emit_imm(13, 1)
        emit_word_store(6, 0, 13)
        emit_word_store(6, 8, 14)
        emit_imm(13, 0)
        emit_word_store(6, 16, 13)
        emit_word_store(6, 24, 7)
        emit_rr(2, 254, 12)
        emit_rr(2, 0, 6)
        emit_ret()
        define_label(empty)
        emit_imm(0, 16777216)
        emit_ret()
        return 1
    }
    state invalid { emit_fail_once(15, maximum_bytes)  return 0 }
}

proc emit_bytes_descriptor_check(pointer_register, internal_label) {
    let below_heap = new_label()
    let empty_row = new_label()
    let known_kind = new_label()
    let done = new_label()
    emit_imm(12, 16777216)
    emit_rrx(15, pointer_register, 12, internal_label)
    emit_rrx(15, pointer_register, 254, below_heap)
    emit_jump(12, internal_label)
    define_label(below_heap)
    emit_rr(2, 13, pointer_register)
    emit_imm(14, 32)
    emit_rr(3, 13, 14)
    emit_rrx(15, 254, 13, internal_label)
    emit_rr(2, 13, pointer_register)
    emit_rr(4, 13, 12)
    emit_rr(7, 13, 14)
    emit_rx(14, 13, internal_label)
    emit_rrx(16, pointer_register, 12, empty_row)
    emit_word_load(13, pointer_register, 0)
    emit_imm(14, 1)
    emit_rrx(16, 13, 14, known_kind)
    emit_imm(14, 2)
    emit_rrx(16, 13, 14, known_kind)
    emit_imm(14, 3)
    emit_rrx(16, 13, 14, known_kind)
    emit_jump(12, internal_label)
    define_label(known_kind)
    emit_word_load(13, pointer_register, 24)
    emit_imm(14, 0)
    emit_rrx(15, 13, 14, internal_label)
    emit_rx(13, 13, internal_label)
    emit_jump(12, done)
    define_label(empty_row)
    emit_word_load(13, pointer_register, 0)
    emit_rx(14, 13, internal_label)
    emit_word_load(13, pointer_register, 8)
    emit_rx(14, 13, internal_label)
    emit_word_load(13, pointer_register, 16)
    emit_rx(14, 13, internal_label)
    emit_word_load(13, pointer_register, 24)
    emit_rx(14, 13, internal_label)
    define_label(done)
    return 0
}

proc emit_bytes_single(entry_label, heap_label, trap_label) {
    define_label(entry_label)
    emit_imm(3, 0)
    emit_rrx(15, 2, 3, trap_label)
    emit_imm(3, 255)
    emit_rrx(15, 3, 2, trap_label)
    emit_rr(2, 7, 2)
    emit_imm(2, 32)
    emit_jump(19, heap_label)
    emit_rr(2, 6, 0)
    emit_imm(5, 1)
    emit_word_store(6, 0, 5)
    emit_rr(2, 8, 6)
    emit_imm(3, 16)
    emit_rr(3, 8, 3)
    emit_word_store(6, 8, 8)
    emit_imm(5, 1)
    emit_word_store(6, 24, 5)
    emit_rr(9, 8, 7)
    emit_rr(2, 0, 6)
    emit_ret()
    return 0
}

proc emit_bytes_length(entry_label, internal_label) {
    define_label(entry_label)
    emit_bytes_descriptor_check(2, internal_label)
    emit_word_load(0, 2, 24)
    emit_ret()
    return 0
}

; D21: add the operands' stored logical lengths before allocation. The selected
; checked-add terminal is the authored trap; malformed descriptors use the
; independent internal terminal and allocator failure remains separate.
proc emit_bytes_concat(entry_label, heap_label, add_label, internal_label) {
    let return_left = new_label()
    let return_right = new_label()
    define_label(entry_label)
    emit_bytes_descriptor_check(2, internal_label)
    emit_bytes_descriptor_check(3, internal_label)
    emit_rr(2, 7, 2)
    emit_rr(2, 8, 3)
    emit_word_load(2, 7, 24)
    emit_word_load(3, 8, 24)
    emit_rx(13, 2, return_right)
    emit_rx(13, 3, return_left)
    emit_jump(19, add_label)
    emit_rr(2, 9, 0)
    emit_imm(2, 32)
    emit_jump(19, heap_label)
    emit_rr(2, 6, 0)
    emit_imm(5, 2)
    emit_word_store(6, 0, 5)
    emit_word_store(6, 24, 9)
    emit_word_store(6, 8, 7)
    emit_word_store(6, 16, 8)
    emit_rr(2, 0, 6)
    emit_ret()
    define_label(return_left)
    emit_rr(2, 0, 7)
    emit_ret()
    define_label(return_right)
    emit_rr(2, 0, 8)
    emit_ret()
    return 0
}

proc emit_bytes_slice(entry_label, heap_label, trap_label, internal_label) {
    let empty_result = new_label()
    let start_zero = new_label()
    let identity_result = new_label()
    let allocate = new_label()
    define_label(entry_label)
    emit_bytes_descriptor_check(2, internal_label)
    emit_imm(5, 0)
    emit_rrx(15, 3, 5, trap_label)
    emit_rrx(15, 4, 5, trap_label)
    emit_rr(2, 6, 2)
    emit_word_load(6, 6, 24)
    emit_rrx(15, 6, 3, trap_label)
    emit_rr(2, 5, 6)
    emit_rr(4, 5, 3)
    emit_rrx(15, 5, 4, trap_label)
    emit_rx(13, 4, empty_result)
    emit_rx(13, 3, start_zero)
    emit_jump(12, allocate)
    define_label(start_zero)
    emit_rrx(16, 4, 6, identity_result)
    emit_jump(12, allocate)
    define_label(allocate)
    emit_rr(2, 7, 2)
    emit_rr(2, 8, 3)
    emit_rr(2, 9, 4)
    emit_imm(2, 32)
    emit_jump(19, heap_label)
    emit_rr(2, 6, 0)
    emit_imm(5, 3)
    emit_word_store(6, 0, 5)
    emit_word_store(6, 24, 9)
    emit_word_store(6, 8, 7)
    emit_word_store(6, 16, 8)
    emit_rr(2, 0, 6)
    emit_ret()
    define_label(empty_result)
    emit_imm(0, 16777216)
    emit_ret()
    define_label(identity_result)
    emit_rr(2, 0, 2)
    emit_ret()
    return 0
}

proc emit_bytes_get(entry_label, trap_label, internal_label) {
    let loop = new_label()
    let leaf = new_label()
    let concat = new_label()
    let concat_left = new_label()
    let slice = new_label()
    define_label(entry_label)
    emit_bytes_descriptor_check(2, internal_label)
    emit_imm(4, 0)
    emit_rrx(15, 3, 4, trap_label)
    emit_rr(2, 5, 2)
    emit_word_load(5, 5, 24)
    emit_rrx(15, 3, 5, loop)
    emit_jump(12, trap_label)
    define_label(loop)
    emit_bytes_descriptor_check(2, internal_label)
    emit_word_load(4, 2, 0)
    emit_imm(5, 1)
    emit_rrx(16, 4, 5, leaf)
    emit_imm(5, 2)
    emit_rrx(16, 4, 5, concat)
    emit_imm(5, 3)
    emit_rrx(16, 4, 5, slice)
    emit_jump(12, internal_label)
    define_label(leaf)
    emit_word_load(5, 2, 8)
    emit_rr(3, 5, 3)
    emit_rr(8, 0, 5)
    emit_ret()
    define_label(concat)
    emit_word_load(5, 2, 8)
    emit_word_load(6, 2, 16)
    emit_word_load(7, 5, 24)
    emit_rrx(15, 3, 7, concat_left)
    emit_rr(4, 3, 7)
    emit_rr(2, 2, 6)
    emit_jump(12, loop)
    define_label(concat_left)
    emit_rr(2, 2, 5)
    emit_jump(12, loop)
    define_label(slice)
    emit_word_load(5, 2, 8)
    emit_word_load(6, 2, 16)
    emit_rr(3, 3, 6)
    emit_rr(2, 2, 5)
    emit_jump(12, loop)
    return 0
}

; Return `instruction_width + 16 * direct_target_operand_offset`, where a zero
; target offset means ordinary fallthrough/no encoded target. Zero is invalid.
proc alpha_instruction_shape(op) {
    state halt { to width2 when (op == 0)  to immediate }
    state immediate { to width10 when (op == 1)  to rr_low }
    state rr_low { to invalid when (op < 2)  to rr_high }
    state rr_high { to width3 when (op < 12)  to jump }
    state jump { to target1_width9 when (op == 12)  to rx }
    state rx { to target2_width10 when (op < 15)  to rrx }
    state rrx { to target3_width11 when (op < 17)  to io }
    state io { to width2 when (op < 19)  to call }
    state call { to target1_width9 when (op == 19)  to ret }
    state ret { to width1 when (op == 20)  to invalid }
    state width1 { return 1 }
    state width2 { return 2 }
    state width3 { return 3 }
    state width10 { return 10 }
    state target1_width9 { return 25 }
    state target2_width10 { return 42 }
    state target3_width11 { return 59 }
    state invalid { return 0 }
}

; Replay the completed payload independently of the emitter call sequence.
; Every byte belongs to one closed Alpha instruction, and every encoded direct
; target lands on an instruction start. The scratch map is private compiler
; memory and is cleared for repeated validation in one compiler execution.
proc validate_payload_structure() {
    let pc = 0
    state clear_loop { to clear_byte when (pc < word[2097040])  to first_setup }
    state clear_byte {
        byte[132120576 + pc] = 0
        pc = pc + 1
        to clear_loop
    }
    state first_setup { pc = 0  to first_loop }
    state first_loop { to first_body when (pc < word[2097040])  to second_setup }
    state first_body {
        let shape = alpha_instruction_shape(byte[133169152 + pc])
        let width = shape % 16
        to invalid when (shape == 0)
        to first_extent
    }
    state first_extent {
        let instruction_end = pc + width
        to invalid when (instruction_end > word[2097040])
        byte[132120576 + pc] = 1
        pc = instruction_end
        to first_loop
    }
    state second_setup { pc = 0  to second_loop }
    state second_loop { to second_body when (pc < word[2097040])  return 1 }
    state second_body {
        let shape2 = alpha_instruction_shape(byte[133169152 + pc])
        let width2 = shape2 % 16
        let target_delta = shape2 / 16
        to invalid when (shape2 == 0)
        to target when (target_delta != 0)
        to advance
    }
    state target {
        let target = word[133169152 + pc + target_delta]
        to invalid when (target < 0)
        to invalid when (target >= word[2097040])
        to invalid when (byte[132120576 + target] != 1)
        to advance
    }
    state advance { pc = pc + width2  to second_loop }
    state invalid { emit_fail_once(16, pc)  return 0 }
}

proc validate_payload() {
    state sticky { to invalid when (word[2097016] != 0)  to nonempty }
    state nonempty { to empty when (word[2097040] == 0)  to resolve }
    state resolve { to resolved when (resolve_fixups() == 1)  return 0 }
    state resolved {
        to invalid when (word[2097016] != 0)
        return validate_payload_structure()
    }
    state empty { emit_fail_once(12, 0)  return 0 }
    state invalid { return 0 }
}

; This is the eventual expression dispatcher with its first retained lowering
; slice, not an accepted subset compiler. It currently consumes already checked
; trees containing literals, the seven primitive operators,
; conditionals, and the six closed Bytes builtins. Conditionals preserve the
; tail-position bit for both arms; the resolved-call seam below consumes it,
; while connecting tag-5 source calls must implement D20's resolved identities.
; Runtime intermediate values use the explicit stack so compile-time expression
; depth does not become a generated register limit.

proc lower_bytes_builtin(kind, args) {
    state dispatch {
        to empty when (kind == 1)
        to single when (kind == 2)
        to length when (kind == 3)
        to get when (kind == 4)
        to slice when (kind == 5)
        to concat
    }
    state empty {
        emit_imm(0, 1)
        return emit_imm(1, 16777216)
    }
    state single {
        let single_arg = word[args + 8]
        to single_done when (lower_expr(single_arg, 0) == 1)
        return 0
    }
    state single_done {
        emit_rr(2, 2, 1)
        emit_jump(19, word[2096944])
        emit_rr(2, 1, 0)
        return emit_imm(0, 1)
    }
    state length {
        let length_arg = word[args + 8]
        to length_done when (lower_expr(length_arg, 0) == 1)
        return 0
    }
    state length_done {
        emit_rr(2, 2, 1)
        emit_jump(19, word[2096936])
        emit_rr(2, 1, 0)
        return emit_imm(0, 0)
    }
    state get {
        let get_bytes = word[args + 8]
        let get_rest = word[args + 16]
        let get_index = word[get_rest + 8]
        to get_bytes_done when (lower_expr(get_bytes, 0) == 1)
        return 0
    }
    state get_bytes_done {
        emit_imm(2, 8)
        emit_jump(19, word[2097000])
        emit_word_store(0, 0, 1)
        to get_index_done when (lower_expr(get_index, 0) == 1)
        return 0
    }
    state get_index_done {
        emit_rr(2, 3, 1)
        emit_word_load(2, 252, 0)
        emit_imm(4, 8)
        emit_rr(3, 252, 4)
        emit_jump(19, word[2096928])
        emit_rr(2, 1, 0)
        return emit_imm(0, 0)
    }
    state slice {
        let slice_bytes = word[args + 8]
        let slice_second = word[args + 16]
        let slice_start = word[slice_second + 8]
        let slice_third = word[slice_second + 16]
        let slice_length = word[slice_third + 8]
        to slice_bytes_done when (lower_expr(slice_bytes, 0) == 1)
        return 0
    }
    state slice_bytes_done {
        emit_imm(2, 8)
        emit_jump(19, word[2097000])
        emit_word_store(0, 0, 1)
        to slice_start_done when (lower_expr(slice_start, 0) == 1)
        return 0
    }
    state slice_start_done {
        emit_imm(2, 8)
        emit_jump(19, word[2097000])
        emit_word_store(0, 0, 1)
        to slice_length_done when (lower_expr(slice_length, 0) == 1)
        return 0
    }
    state slice_length_done {
        emit_rr(2, 4, 1)
        emit_word_load(3, 252, 0)
        emit_imm(5, 8)
        emit_rr(3, 252, 5)
        emit_word_load(2, 252, 0)
        emit_rr(3, 252, 5)
        emit_jump(19, word[2096920])
        emit_rr(2, 1, 0)
        return emit_imm(0, 1)
    }
    state concat {
        let concat_left = word[args + 8]
        let concat_rest = word[args + 16]
        let concat_right = word[concat_rest + 8]
        to concat_left_done when (lower_expr(concat_left, 0) == 1)
        return 0
    }
    state concat_left_done {
        emit_imm(2, 8)
        emit_jump(19, word[2097000])
        emit_word_store(0, 0, 1)
        to concat_right_done when (lower_expr(concat_right, 0) == 1)
        return 0
    }
    state concat_right_done {
        emit_rr(2, 3, 1)
        emit_word_load(2, 252, 0)
        emit_imm(4, 8)
        emit_rr(3, 252, 4)
        emit_jump(19, word[2096912])
        emit_rr(2, 1, 0)
        return emit_imm(0, 1)
    }
}

; Validate and lower one canonical source-order argument list shared by the
; resolved call and constructor seams. Validation completes before emission;
; each expression then lowers non-tail exactly once and its complete
; `(kind,payload)` pair survives the stack-reserver call through r6/r7. The
; returned nonnegative count is derived from the list rather than supplied by
; either caller. A malformed compiler-owned list records the caller's private
; failure class; an unsupported child lowering returns -1 without publication.

proc lower_resolved_arguments(args, failure_code) {
    let cursor = args
    let argument_count = 0
    let arena_end = word[2097128]
    state failure_call { to arena_low when (failure_code == 13)  to failure_constructor }
    state failure_constructor { to arena_low when (failure_code == 14)  to invalid_failure_code }
    state arena_low { to invalid_list when (arena_end < 16777248)  to arena_high }
    state arena_high { to invalid_list when (arena_end > 131072000)  to arena_aligned }
    state arena_aligned { to invalid_list when ((arena_end - 16777248) % 32 != 0)  to validate_loop }
    state validate_loop { to validate_node when (cursor != 0)  to validate_extent }
    state validate_node {
        to invalid_list when (cursor < 16777248)
        to invalid_list when (cursor > arena_end - 32)
        to invalid_list when ((cursor - 16777248) % 32 != 0)
        to invalid_list when (word[cursor] % 256 != 6)
        let expression = word[cursor + 8]
        let next_cursor = word[cursor + 16]
        to invalid_list when (expression < 16777248)
        to invalid_list when (expression >= cursor)
        to invalid_list when ((expression - 16777248) % 32 != 0)
        to validate_advance when (next_cursor == 0)
        to invalid_list when (next_cursor <= cursor)
        to validate_advance
    }
    state validate_advance {
        to invalid_list when (argument_count == 983040)
        argument_count = argument_count + 1
        cursor = next_cursor
        to validate_loop
    }
    state validate_extent {
        cursor = args
        to argument_loop
    }
    state argument_loop { to argument when (cursor != 0)  to dispatch }
    state argument {
        to argument_lowered when (lower_expr(word[cursor + 8], 0) == 1)
        return 0 - 1
    }
    state argument_lowered {
        emit_rr(2, 6, 0)
        emit_rr(2, 7, 1)
        emit_imm(2, 16)
        emit_jump(19, word[2097000])
        emit_word_store(0, 0, 6)
        emit_word_store(0, 8, 7)
        cursor = word[cursor + 16]
        to argument_loop
    }
    state dispatch { return argument_count }
    state invalid_list { emit_fail_once(failure_code, cursor)  return 0 - 1 }
    state invalid_failure_code { emit_fail_once(14, failure_code)  return 0 - 1 }
}

; Lower an ordinary or tail call after the resolver has supplied its opaque
; target label and complete fixed frame prefix. This seam deliberately does not
; inspect or resolve the call spelling. D20 owns the later tag-5 source connection.

proc lower_resolved_call(args, tail_position, callee_label, callee_prefix_bytes) {
    state prefix_low { to invalid_profile when (callee_prefix_bytes < 16)  to prefix_aligned }
    state prefix_aligned { to invalid_profile when (callee_prefix_bytes % 16 != 0)  to prefix_high }
    state prefix_high { to invalid_profile when (callee_prefix_bytes > 15728640)  to arguments }
    state arguments {
        let parameter_count = lower_resolved_arguments(args, 13)
        to failed when (parameter_count < 0)
        to dispatch
    }
    state dispatch { to tail when (tail_position != 0)  to ordinary }
    state ordinary {
        return emit_gamma_call_frame(word[2097000], callee_label,
                                     callee_prefix_bytes, parameter_count)
    }
    state tail {
        return emit_gamma_tail_frame(callee_prefix_bytes, parameter_count,
                                     callee_label, word[2096904])
    }
    state failed { return 0 }
    state invalid_profile { emit_fail_once(13, callee_prefix_bytes)  return 0 }
}

; Lower one constructor application after the resolver supplies only its
; opaque runtime kind. Constructor arguments are always non-tail. Spelling,
; declaration identity, and the eventual tag-7 source connection follow D20.

proc lower_resolved_constructor(args, constructor_tag) {
    state tag { to invalid_tag when (constructor_tag < 2)  to arguments }
    state arguments {
        let field_count = lower_resolved_arguments(args, 14)
        to failed when (field_count < 0)
        return emit_gamma_constructor_value(word[2096952], constructor_tag,
                                            field_count)
    }
    state failed { return 0 }
    state invalid_tag { emit_fail_once(14, constructor_tag)  return 0 }
}

; Lower one local reference after the resolver supplies only its opaque fixed
; frame slot. Source spelling, scope, and shadowing remain outside this seam.

; Lower one let after the resolver supplies its opaque fixed frame slot. Beta's
; four-argument procedure limit carries `(prefix,index)` in one nonnegative
; scalar as `prefix + index * 16777216`; validation recovers both exact values.
; The initializer is non-tail and evaluated exactly once; its complete result is
; retained in the frame before the body inherits the caller's tail context.
; Validate the private slot profile before lowering the initializer so malformed
; resolver metadata cannot author even a partial candidate payload.

proc lower_resolved_let(value_expr, body_expr, tail_position, frame_local_profile) {
    state encoded { to invalid_profile when (frame_local_profile < 0)  to decode }
    state decode {
        let frame_prefix_bytes = frame_local_profile % 16777216
        let local_index = frame_local_profile / 16777216
        to validate
    }
    state validate {
        let profile_ok = validate_gamma_frame_local(frame_prefix_bytes, local_index)
        to profile
    }
    state profile { to value when (profile_ok == 1)  return 0 }
    state value {
        to store when (lower_expr(value_expr, 0) == 1)
        return 0
    }
    state store {
        to body when (emit_gamma_frame_local(frame_prefix_bytes, local_index, 1) == 1)
        return 0
    }
    state body { return lower_expr(body_expr, tail_position) }
    state invalid_profile { emit_fail_once(13, frame_local_profile)  return 0 }
}

; A selected match consumes only checked, resolver-owned AST metadata. Validate
; the complete arm spine, arm/pattern nodes, constructor identities, exact field
; arities, and every resolved binder slot before lowering the scrutinee. Forward
; arena links make this walk total without a visited set. The label budget
; includes one join, two control labels per constructor arm, and the private
; field-pointer containment label allocated by each field load.

proc validate_resolved_match(arms, frame_prefix_bytes) {
    let cursor = arms
    let seen = 0
    let required_labels = 1
    let arena_end = word[2097128]
    state prefix {
        to invalid when (frame_prefix_bytes < 16)
        to invalid when (frame_prefix_bytes % 16 != 0)
        to invalid when (frame_prefix_bytes > 15728640)
        to invalid when (arena_end < 16777248)
        to invalid when (arena_end > 131072000)
        to arm_loop
    }
    state arm_loop { to arm when (cursor != 0)  to finish }
    state arm {
        to invalid when (cursor < 16777248)
        to invalid when (cursor > arena_end - 32)
        to invalid when ((cursor - 16777248) % 32 != 0)
        to invalid when (word[cursor] % 256 != 6)
        let arm_node = word[cursor + 8]
        let next_cursor = word[cursor + 16]
        to invalid when (arm_node < 16777248)
        to invalid when (arm_node > arena_end - 32)
        to invalid when ((arm_node - 16777248) % 32 != 0)
        to invalid when (arm_node >= cursor)
        to invalid when (word[arm_node] % 256 != 11)
        to next_check when (next_cursor != 0)
        to arm_children
    }
    state next_check { to invalid when (next_cursor <= cursor)  to arm_children }
    state arm_children {
        let pattern = word[arm_node + 8]
        let body = word[arm_node + 16]
        to invalid when (pattern < 16777248)
        to invalid when (pattern > arena_end - 32)
        to invalid when ((pattern - 16777248) % 32 != 0)
        to invalid when (body < 16777248)
        to invalid when (body > arena_end - 32)
        to invalid when ((body - 16777248) % 32 != 0)
        to invalid when (pattern >= arm_node)
        to invalid when (body >= arm_node)
        let body_tag = word[body] % 256
        to invalid when (body_tag == 6)
        to invalid when (body_tag > 8)
        let pattern_tag = word[pattern] % 256
        to catchall when (pattern_tag == 9)
        to constructor when (pattern_tag == 10)
        to invalid
    }
    state catchall {
        let catchall_identity = word[pattern + 16]
        to invalid when (catchall_identity == 0)
        to invalid when (word[pattern + 24] != 0)
        to invalid when (next_cursor != 0)
        to invalid when (catchall_identity - 1 >= (frame_prefix_bytes - 16) / 16)
        to advance
    }
    state constructor {
        let constructor_identity = word[pattern + 24]
        to invalid when (constructor_identity == 0)
        to invalid when (constructor_identity > word[2097096])
        required_labels = required_labels + 2
        let pattern_fields = word[pattern + 16]
        let declared_fields = word[6815744 + (constructor_identity - 1) * 24 + 16]
        let field_count = 0
        to field_loop
    }
    state field_loop {
        to pattern_field when (pattern_fields != 0)
        to invalid when (declared_fields != 0)
        to advance
    }
    state pattern_field { to field when (declared_fields != 0)  to invalid }
    state field {
        to invalid when (pattern_fields < 16777248)
        to invalid when (pattern_fields > arena_end - 32)
        to invalid when ((pattern_fields - 16777248) % 32 != 0)
        to invalid when (declared_fields < 16777248)
        to invalid when (declared_fields > arena_end - 32)
        to invalid when ((declared_fields - 16777248) % 32 != 0)
        to invalid when (pattern_fields >= pattern)
        to invalid when (word[pattern_fields] % 256 != 6)
        to invalid when (word[declared_fields] % 256 != 6)
        to invalid when (field_count == 983040)
        let binder_identity = word[pattern_fields + 24]
        to invalid when (binder_identity == 0)
        to invalid when (binder_identity - 1 >= (frame_prefix_bytes - 16) / 16)
        let next_pattern_field = word[pattern_fields + 16]
        let next_declared_field = word[declared_fields + 16]
        to next_pattern_check when (next_pattern_field != 0)
        to next_declared_dispatch
    }
    state next_pattern_check {
        to invalid when (next_pattern_field <= pattern_fields)
        to next_declared_dispatch
    }
    state next_declared_dispatch {
        to next_declared_check when (next_declared_field != 0)
        to field_advance
    }
    state next_declared_check {
        to invalid when (next_declared_field <= declared_fields)
        to field_advance
    }
    state field_advance {
        pattern_fields = next_pattern_field
        declared_fields = next_declared_field
        field_count = field_count + 1
        required_labels = required_labels + 1
        to field_loop
    }
    state advance {
        seen = 1
        cursor = next_cursor
        to arm_loop
    }
    state finish {
        to invalid when (seen == 0)
        to label_exhausted when (required_labels > 65536 - word[2097032])
        return 1
    }
    state label_exhausted { emit_fail_once(3, word[2097032])  return 0 }
    state invalid { emit_fail_once(14, cursor)  return 0 }
}

; Evaluate the scrutinee exactly once and retain its complete value in r20/r21.
; Constructor tests follow source arm order and use the same one-based identity
; to runtime-kind map as constructor construction. Only a selected arm binds
; values and runs. Pattern fields are loaded and stored in source order; a
; catch-all stores the original pair. Every selected body inherits the caller's
; tail-position bit, so a tail call replaces the current frame as usual.

proc lower_resolved_match(scrutinee, arms, tail_position, internal_label) {
    state tail_zero { to internal_low when (tail_position == 0)  to tail_one }
    state tail_one { to internal_low when (tail_position == 1)  to invalid_profile }
    state internal_low { to invalid_profile when (internal_label < 0)  to internal_high }
    state internal_high {
        to invalid_profile when (internal_label >= word[2097032])
        to scrutinee_node
    }
    state scrutinee_node {
        to invalid_scrutinee when (scrutinee < 16777248)
        to invalid_scrutinee when (scrutinee > word[2097128] - 32)
        to invalid_scrutinee when ((scrutinee - 16777248) % 32 != 0)
        let scrutinee_tag = word[scrutinee] % 256
        to invalid_scrutinee when (scrutinee_tag == 6)
        to invalid_scrutinee when (scrutinee_tag > 8)
        let metadata_ok = validate_resolved_match(arms, word[2096880])
        to metadata
    }
    state metadata { to invalid_metadata when (metadata_ok != 1)  to lower_scrutinee }
    state lower_scrutinee {
        to scrutinee_lowered when (lower_expr(scrutinee, 0) == 1)
        return 0
    }
    state scrutinee_lowered {
        emit_rr(2, 20, 0)
        emit_rr(2, 21, 1)
        let done_label = new_label()
        let cursor = arms
        to arm_loop
    }
    state arm_loop { to arm when (cursor != 0)  to no_match }
    state arm {
        let arm_node = word[cursor + 8]
        let pattern = word[arm_node + 8]
        let body = word[arm_node + 16]
        let next_cursor = word[cursor + 16]
        to catchall when (word[pattern] % 256 == 9)
        to constructor
    }
    state catchall {
        emit_rr(2, 0, 20)
        emit_rr(2, 1, 21)
        let catchall_identity = word[pattern + 16]
        let catchall_store = emit_gamma_frame_local(word[2096880],
                                                     catchall_identity - 1, 1)
        to catchall_stored
    }
    state catchall_stored { to failed when (catchall_store != 1)  to lower_body }
    state constructor {
        let constructor_identity = word[pattern + 24]
        let selected_label = new_label()
        let next_label = new_label()
        emit_imm(22, constructor_identity + 1)
        emit_rrx(16, 20, 22, selected_label)
        emit_jump(12, next_label)
        define_label(selected_label)
        let pattern_fields = word[pattern + 16]
        let field_count = 0
        let count_cursor = pattern_fields
        to count_fields
    }
    state count_fields {
        to count_field when (count_cursor != 0)
        let field_index = 0
        to bind_fields
    }
    state count_field {
        field_count = field_count + 1
        count_cursor = word[count_cursor + 16]
        to count_fields
    }
    state bind_fields { to bind_field when (pattern_fields != 0)  to lower_body }
    state bind_field {
        emit_rr(2, 1, 21)
        let load_status = emit_gamma_field_load(field_count, field_index,
                                                internal_label)
        to field_loaded
    }
    state field_loaded { to failed when (load_status != 1)  to store_field }
    state store_field {
        let binder_identity = word[pattern_fields + 24]
        let store_status = emit_gamma_frame_local(word[2096880],
                                                  binder_identity - 1, 1)
        to field_stored
    }
    state field_stored {
        to failed when (store_status != 1)
        pattern_fields = word[pattern_fields + 16]
        field_index = field_index + 1
        to bind_fields
    }
    state lower_body {
        to body_lowered when (lower_expr(body, tail_position) == 1)
        return 0
    }
    state body_lowered {
        emit_jump(12, done_label)
        cursor = next_cursor
        to arm_advance
    }
    state arm_advance {
        to define_next when (word[pattern] % 256 == 10)
        to arm_loop
    }
    state define_next {
        define_label(next_label)
        to arm_loop
    }
    state no_match {
        emit_jump(12, internal_label)
        return define_label(done_label)
    }
    state invalid_profile { emit_fail_once(14, internal_label)  return 0 }
    state invalid_scrutinee { emit_fail_once(14, scrutinee)  return 0 }
    state invalid_metadata { return 0 }
    state failed { return 0 }
}

proc lower_expr(expr, tail_position) {
    let tag = word[expr] % 256
    state literal_check { to literal when (tag == 0)  to variable_check }
    state literal {
        emit_imm(0, 0)
        return emit_imm(1, word[expr + 8])
    }
    state variable_check { to variable when (tag == 1)  to primitive_check }
    state variable {
        let binding = word[expr + 16]
        to resolved_invalid when (binding < 65536)
        let binding_kind = (binding / 131072) % 2
        let binding_index = binding / 262144
        to local_variable when (binding_kind == 1)
        return lower_resolved_parameter(word[2096880], word[2096872], binding_index)
    }
    state local_variable {
        return emit_gamma_frame_local(word[2096880], binding_index, 0)
    }
    state primitive_check { to primitive when (tag == 2)  to if_check }
    state if_check { to if_expr when (tag == 3)  to let_check }
    state let_check { to let_expr when (tag == 4)  to call_check }
    state let_expr {
        let slot_identity = word[expr + 8]
        to resolved_invalid when (slot_identity == 0)
        let frame_local_profile = word[2096880] + (slot_identity - 1) * 16777216
        return lower_resolved_let(word[expr + 16], word[expr + 24],
                                  tail_position, frame_local_profile)
    }
    state call_check { to call_expr when (tag == 5)  to constructor_check }
    state call_expr {
        let builtin = bytes_builtin_kind(word[expr + 8])
        to bytes_expr when (builtin != 0)
        let function_identity = word[expr + 24]
        to resolved_invalid when (function_identity == 0)
        let function_index = function_identity - 1
        to resolved_invalid when (function_index >= word[2097120])
        let encoded_label = word[10485760 + function_index * 8]
        to resolved_invalid when (encoded_label == 0)
        let function_profile = word[8388608 + function_index * 32 + 16]
        let callee_prefix = 16 + ((function_profile / 65536) % 65536) * 16
        return lower_resolved_call(word[expr + 16], tail_position,
                                   encoded_label - 1, callee_prefix)
    }
    state bytes_expr { return lower_bytes_builtin(builtin, word[expr + 16]) }
    state constructor_check { to constructor_expr when (tag == 7)  to match_check }
    state constructor_expr {
        let constructor_identity = word[expr + 24]
        to resolved_invalid when (constructor_identity == 0)
        return lower_resolved_constructor(word[expr + 16], constructor_identity + 1)
    }
    state match_check { to match_expr when (tag == 8)  return 0 }
    state match_expr {
        return lower_resolved_match(word[expr + 8], word[expr + 16],
                                    tail_position, word[2096864])
    }
    state resolved_invalid { emit_fail_once(13, word[expr] / 256)  return 0 }
    state if_expr {
        let else_label = new_label()
        let done_label = new_label()
        to if_condition_done when (lower_expr(word[expr + 8], 0) == 1)
        return 0
    }
    state if_condition_done {
        emit_rx(13, 1, else_label)
        to if_then_done when (lower_expr(word[expr + 16], tail_position) == 1)
        return 0
    }
    state if_then_done {
        emit_jump(12, done_label)
        define_label(else_label)
        to if_else_done when (lower_expr(word[expr + 24], tail_position) == 1)
        return 0
    }
    state if_else_done { return define_label(done_label) }
    state primitive {
        to left_done when (lower_expr(word[expr + 16], 0) == 1)
        return 0
    }
    state left_done {
        emit_imm(2, 8)
        emit_jump(19, word[2097000])
        emit_word_store(0, 0, 1)
        to right_done when (lower_expr(word[expr + 24], 0) == 1)
        return 0
    }
    state right_done {
        emit_rr(2, 3, 1)
        emit_word_load(2, 252, 0)
        emit_imm(4, 8)
        emit_rr(3, 252, 4)
        let op = word[expr + 8]
        to add when (op == '+')
        to sub when (op == '-')
        to mul when (op == '*')
        to div when (op == '/')
        to mod when (op == '%')
        to equal when (op == 'e')
        to less
    }
    state add { emit_jump(19, word[2096992])  to scalar_result }
    state sub { emit_jump(19, word[2096984])  to scalar_result }
    state mul { emit_jump(19, word[2096976])  to scalar_result }
    state div { emit_jump(19, word[2096968])  to scalar_result }
    state mod { emit_jump(19, word[2096960])  to scalar_result }
    state equal {
        let equal_true = new_label()
        let equal_done = new_label()
        emit_imm(0, 0)
        emit_rrx(16, 2, 3, equal_true)
        emit_jump(12, equal_done)
        define_label(equal_true)
        emit_imm(0, 1)
        define_label(equal_done)
        to scalar_result
    }
    state less {
        let less_true = new_label()
        let less_done = new_label()
        emit_imm(0, 0)
        emit_rrx(15, 2, 3, less_true)
        emit_jump(12, less_done)
        define_label(less_true)
        emit_imm(0, 1)
        define_label(less_done)
        to scalar_result
    }
    state scalar_result {
        emit_rr(2, 1, 0)
        return emit_imm(0, 0)
    }
}

; ---- D19 selected application schemas --------------------------------
;
; These checks consume only resolved D20 identities and author no candidate
; payload. D30 fixes the compilation-request envelope, exact profile maxima,
; and GCOUT/DCOUT tables. D33 requires the completed boundary to retain every
; schema (reason, coordinate) candidate, apply category order 19/20/21, use
; coordinate space none for absent facts, and validate code availability
; against the originating request profile. These Boolean validators do not yet
; implement that public judgment; embedding it and emitting the selected
; adapter remain outside this slice.

proc validate_d19_conformance_schema() {
    let function_index = 0
    let main_count = 0
    let main_identity = 0
    state loop { to row when (function_index < word[2097120])  to result }
    state row {
        let name_off = word[8388608 + function_index * 32]
        let is_main = name_is_packed(name_off, 1852399981, 0, 4)
        main_count = main_count + is_main
        main_identity = main_identity + (function_index + 1) * is_main
        function_index = function_index + 1
        to loop
    }
    state result {
        to invalid when (main_count != 1)
        let main_index = main_identity - 1
        let profile = word[8388608 + main_index * 32 + 16]
        to invalid when (profile / 4294967296 != 1)
        let parameters = word[8388608 + main_index * 32 + 8]
        let parameter = word[parameters + 8]
        let accepted = (profile % 65536 == 1) * (word[parameter + 16] == 1)
        return main_identity * accepted
    }
    state invalid { return 0 }
}

proc d19_fields_match(fields, first_type, second_type, expected_count) {
    let cursor = fields
    let seen = 0
    let invalid = 0
    state loop { to row when (cursor != 0)  return (seen == expected_count) * (invalid == 0) }
    state row {
        let actual_type = word[cursor + 8]
        invalid = invalid + (word[cursor] % 256 != 6)
        invalid = invalid + (seen >= expected_count)
        invalid = invalid + (seen == 0) * (actual_type != first_type)
        invalid = invalid + (seen == 1) * (actual_type != second_type)
        seen = seen + 1
        cursor = word[cursor + 16]
        to loop
    }
}

proc d19_three_int_fields_match(fields) {
    let cursor = fields
    let seen = 0
    let invalid = 0
    state loop { to row when (cursor != 0)  return (seen == 3) * (invalid == 0) }
    state row {
        invalid = invalid + (word[cursor] % 256 != 6)
        invalid = invalid + (word[cursor + 8] != 0)
        seen = seen + 1
        cursor = word[cursor + 16]
        to loop
    }
}

proc validate_d19_delta_schema() {
    d19_initialize_name_table()
    let reason_type = 0 - 1
    let outcome_type = 0 - 1
    let type_index = 2
    state type_loop { to type_row when (type_index < word[2097104])  to constructor_start }
    state type_row {
        let type_code = d19_name_code(word[6291456 + type_index * 8])
        reason_type = reason_type + (type_index + 1) * (type_code == 27)
        outcome_type = outcome_type + (type_index + 1) * (type_code == 28)
        type_index = type_index + 1
        to type_loop
    }
    state constructor_start {
        let constructor_index = 0
        let reason_count = 0
        let outcome_count = 0
        let complete_identity = 0
        let reject_identity = 0
        let storage_at_identity = 0
        let storage_total_identity = 0
        let schema_invalid = (reason_type < 2) + (outcome_type < 2)
        to constructor_loop
    }
    state constructor_loop { to constructor_row when (constructor_index < word[2097096])  to function_start }
    state constructor_row {
        let owner_type = word[6815744 + constructor_index * 24 + 8]
        let constructor_code = d19_name_code(word[6815744 + constructor_index * 24])
        let fields = word[6815744 + constructor_index * 24 + 16]
        let is_reason = owner_type == reason_type
        let is_outcome = owner_type == outcome_type
        let is_complete = is_outcome * (constructor_code == 29)
        let is_reject = is_outcome * (constructor_code == 30)
        let is_storage_at = is_outcome * (constructor_code == 31)
        let is_storage_total = is_outcome * (constructor_code == 32)
        let reason_fields_ok = d19_fields_match(fields, 0, 0, 0)
        let complete_fields_ok = d19_fields_match(fields, 1, 0, 1)
        let reject_fields_ok = d19_fields_match(fields, reason_type, 0, 2)
        let storage_at_fields_ok = d19_three_int_fields_match(fields)
        let storage_total_fields_ok = d19_fields_match(fields, 0, 0, 2)
        schema_invalid = schema_invalid + is_reason * (constructor_code < 1)
        schema_invalid = schema_invalid + is_reason * (constructor_code > 26)
        schema_invalid = schema_invalid + is_reason * (1 - reason_fields_ok)
        schema_invalid = schema_invalid + is_outcome * (1 - is_complete - is_reject - is_storage_at - is_storage_total)
        schema_invalid = schema_invalid + is_complete * (1 - complete_fields_ok)
        schema_invalid = schema_invalid + is_reject * (1 - reject_fields_ok)
        schema_invalid = schema_invalid + is_storage_at * (1 - storage_at_fields_ok)
        schema_invalid = schema_invalid + is_storage_total * (1 - storage_total_fields_ok)
        reason_count = reason_count + is_reason
        outcome_count = outcome_count + is_outcome
        complete_identity = complete_identity + (constructor_index + 1) * is_complete
        reject_identity = reject_identity + (constructor_index + 1) * is_reject
        storage_at_identity = storage_at_identity + (constructor_index + 1) * is_storage_at
        storage_total_identity = storage_total_identity + (constructor_index + 1) * is_storage_total
        word[10750000 + (constructor_code - 1) * 8] = (constructor_index + 1) * (is_reason + is_outcome)
        constructor_index = constructor_index + 1
        to constructor_loop
    }
    state function_start {
        let function_index = 0
        let main_count = 0
        let main_identity = 0
        to function_loop
    }
    state function_loop { to function_row when (function_index < word[2097120])  to result }
    state function_row {
        let function_name = word[8388608 + function_index * 32]
        let is_main = name_is_packed(function_name, 1852399981, 0, 4)
        main_count = main_count + is_main
        main_identity = main_identity + (function_index + 1) * is_main
        function_index = function_index + 1
        to function_loop
    }
    state result {
        schema_invalid = schema_invalid + (reason_count != 26)
        schema_invalid = schema_invalid + (outcome_count != 4)
        schema_invalid = schema_invalid + (complete_identity == 0)
        schema_invalid = schema_invalid + (reject_identity == 0)
        schema_invalid = schema_invalid + (storage_at_identity == 0)
        schema_invalid = schema_invalid + (storage_total_identity == 0)
        schema_invalid = schema_invalid + (main_count != 1)
        to invalid when (schema_invalid != 0)
        let main_index = main_identity - 1
        let main_profile = word[8388608 + main_index * 32 + 16]
        to invalid when (main_profile / 4294967296 != 1)
        let main_parameters = word[8388608 + main_index * 32 + 8]
        let main_parameter = word[main_parameters + 8]
        schema_invalid = (main_profile % 65536 != outcome_type) + (word[main_parameter + 16] != 1)
        to invalid when (schema_invalid != 0)
        word[10750208] = complete_identity
        word[10750216] = reject_identity
        word[10750224] = main_identity
        word[10750232] = reason_type
        word[10750240] = outcome_type
        word[10750256] = storage_at_identity
        word[10750264] = storage_total_identity
        return 1
    }
    state invalid { return 0 }
}

; ---- resolved whole-function emission --------------------------------
;
; D20 has already retained exact one-based function identities and a packed
; frame profile in every FUNS row.  D19 still owns entry selection and the
; generated application adapter.  Keep the two concerns separate: first
; validate every row and publish all forward labels without authoring payload
; bytes, then let the adapter occupy pc zero before these bodies are emitted.

proc validate_gamma_function_rows() {
    let function_count = word[2097120]
    let arena_end = word[2097128]
    let failure_coordinate = 0
    let parameter_cursor = 0
    let parameter_seen = 0
    let next_parameter_cursor = 0
    state count {
        to invalid_count when ((function_count < 1) + (function_count > 32768) != 0)
        to arena
    }
    state arena {
        to invalid_arena when ((arena_end < 16777248) + (arena_end > 131072000) != 0)
        to arena_align
    }
    state arena_align {
        to invalid_arena when ((arena_end - 16777248) % 32 != 0)
        let function_index = 0
        to loop
    }
    state loop { to row when (function_index < function_count)  return 1 }
    state row {
        let profile = word[8388608 + function_index * 32 + 16]
        let body = word[8388608 + function_index * 32 + 24]
        to invalid_profile when (profile < 0)
        let return_type = profile % 65536
        let maximum_locals = (profile / 65536) % 65536
        let parameter_count = profile / 4294967296
        let frame_prefix = 16 + maximum_locals * 16
        let profile_invalid = (return_type >= word[2097104])
        profile_invalid = profile_invalid + (frame_prefix < 16)
        profile_invalid = profile_invalid + (frame_prefix % 16 != 0)
        profile_invalid = profile_invalid + (frame_prefix > 15728640)
        profile_invalid = profile_invalid + (parameter_count < 0)
        profile_invalid = profile_invalid + (parameter_count > 983040)
        profile_invalid = profile_invalid + (parameter_count > (15728640 - frame_prefix) / 16)
        to invalid_profile when (profile_invalid != 0)
        to body_bounds
    }
    state body_bounds {
        to invalid_body when ((body < 16777248) + (body > arena_end - 32) != 0)
        to invalid_body when ((body - 16777248) % 32 != 0)
        let body_tag = word[body] % 256
        to invalid_body when ((body_tag < 0) + (body_tag == 6) + (body_tag > 8) != 0)
        parameter_cursor = word[8388608 + function_index * 32 + 8]
        parameter_seen = 0
        to parameter_loop
    }
    state parameter_loop {
        to parameter_finish when (parameter_cursor == 0)
        to invalid_parameter when (parameter_seen >= parameter_count)
        to parameter_link
    }
    state parameter_link {
        to invalid_parameter when ((parameter_cursor < 16777248) + (parameter_cursor > arena_end - 32) != 0)
        to invalid_parameter when ((parameter_cursor - 16777248) % 32 != 0)
        to invalid_parameter when ((word[parameter_cursor] % 256 != 6) + (word[parameter_cursor + 24] != 0) != 0)
        let parameter = word[parameter_cursor + 8]
        next_parameter_cursor = word[parameter_cursor + 16]
        to parameter_node
    }
    state parameter_node {
        to invalid_parameter when ((parameter < 16777248) + (parameter > arena_end - 32) != 0)
        to invalid_parameter when ((parameter - 16777248) % 32 != 0)
        let parameter_invalid = (parameter >= parameter_cursor)
        parameter_invalid = parameter_invalid + (word[parameter] % 256 != 50)
        parameter_invalid = parameter_invalid + (word[parameter + 16] < 0)
        parameter_invalid = parameter_invalid + (word[parameter + 16] >= word[2097104])
        parameter_invalid = parameter_invalid + (word[parameter + 24] != parameter_seen + 1)
        to invalid_parameter when (parameter_invalid != 0)
        to parameter_next_check when (next_parameter_cursor != 0)
        to parameter_advance
    }
    state parameter_next_check {
        to invalid_parameter when (next_parameter_cursor <= parameter_cursor)
        to parameter_advance
    }
    state parameter_advance {
        parameter_seen = parameter_seen + 1
        parameter_cursor = next_parameter_cursor
        to parameter_loop
    }
    state parameter_finish {
        to invalid_parameter when (parameter_seen != parameter_count)
        to advance
    }
    state advance { function_index = function_index + 1  to loop }
    state invalid_count { failure_coordinate = function_count  to invalid }
    state invalid_arena { failure_coordinate = arena_end  to invalid }
    state invalid_profile { failure_coordinate = function_index  to invalid }
    state invalid_body { failure_coordinate = body  to invalid }
    state invalid_parameter { failure_coordinate = parameter_cursor  to invalid }
    state invalid { emit_fail_once(13, failure_coordinate)  return 0 }
}

proc prepare_gamma_function_labels() {
    let failure_coordinate = 0
    state sticky { to failed when (word[2097016] != 0)  to label_low }
    state label_low { to label_invalid when (word[2097032] < 0)  to label_high }
    state label_high { to label_invalid when (word[2097032] > 65536)  to rows }
    state rows {
        let rows_ok = validate_gamma_function_rows()
        to rows_checked
    }
    state rows_checked { to failed when (rows_ok != 1)  to capacity }
    state capacity {
        to label_exhausted when (word[2097120] > 65536 - word[2097032])
        let function_index = 0
        to loop
    }
    state loop { to allocate when (function_index < word[2097120])  return 1 }
    state allocate {
        let label = new_label()
        to allocation_failed when (label < 0)
        word[10485760 + function_index * 8] = label + 1
        function_index = function_index + 1
        to loop
    }
    state label_exhausted { failure_coordinate = 65536  to label_failure }
    state label_invalid { failure_coordinate = word[2097032]  to label_failure }
    state label_failure { emit_fail_once(3, failure_coordinate)  return 0 }
    state allocation_failed { return 0 }
    state failed { return 0 }
}

proc emit_gamma_function_bodies() {
    let saved_frame_prefix = word[2096880]
    let saved_parameter_count = word[2096872]
    let function_index = 0
    let failure_coordinate = 0
    state labels_start {
        let first_encoded = word[10485760]
        to invalid_labels when (first_encoded <= 0)
        to invalid_labels when (first_encoded - 1 >= word[2097032])
        to invalid_labels when (word[2097120] > word[2097032] - first_encoded + 1)
        function_index = 0
        to labels_loop
    }
    state labels_loop {
        to labels_row when (function_index < word[2097120])
        function_index = 0
        to body_loop
    }
    state labels_row {
        let encoded = word[10485760 + function_index * 8]
        to invalid_labels when (encoded != first_encoded + function_index)
        to invalid_labels when (word[11010048 + (encoded - 1) * 8] != 0)
        function_index = function_index + 1
        to labels_loop
    }
    state body_loop { to body when (function_index < word[2097120])  to complete }
    state body {
        let profile = word[8388608 + function_index * 32 + 16]
        let body_expression = word[8388608 + function_index * 32 + 24]
        let label = word[10485760 + function_index * 8] - 1
        to body_defined when (define_label(label) == 1)
        to restore_failure
    }
    state body_defined {
        word[2096880] = 16 + ((profile / 65536) % 65536) * 16
        word[2096872] = profile / 4294967296
        let lower_status = lower_expr(body_expression, 1)
        to body_lowered
    }
    state body_lowered { to lowering_failed when (lower_status != 1)  to epilogue }
    state epilogue {
        emit_gamma_return_frame()
        to restore_failure when (word[2097016] != 0)
        function_index = function_index + 1
        to body_loop
    }
    state lowering_failed {
        failure_coordinate = body_expression
        to function_failure
    }
    state invalid_labels {
        failure_coordinate = function_index
        to function_failure
    }
    state function_failure {
        emit_fail_once(13, failure_coordinate)
        to restore_failure
    }
    state complete {
        word[2096880] = saved_frame_prefix
        word[2096872] = saved_parameter_count
        return 1
    }
    state restore_failure {
        word[2096880] = saved_frame_prefix
        word[2096872] = saved_parameter_count
        return 0
    }
}

proc frontend_check_main() {
    let slurp_status = slurp()
    state source {
        to source_failed when (slurp_status != 0)
        skip_ws()
        to dataloop
    }
    state source_failed { return 0 }
    state dataloop {
        to databody when (is_root_form(1635017060, 4) == 1)
        to defloop
    }
    state databody { parse_data()  skip_ws()  to dataloop }
    state defloop {
        to defbody when (is_root_form(6710628, 3) == 1)
        to program_shape
    }
    state defbody { parse_def()  skip_ws()  to defloop }
    state program_shape {
        to invalid_program when (word[2097120] == 0)
        to invalid_program when (word[2097144] != word[2097136])
        to resolve_types
    }
    state invalid_program { mark_invalid()  to checkfns }
    state resolve_types {
        to checkfns when (word[2097072] != 0)
        to checkfns when (word[2097088] != 0)
        resolve_decl_types()
        to checkfns
    }
    state checkfns {
        let i = 0
        to invalid_type when (word[2097072] != 0)
        to invalid_type when (word[2097088] != 0)
        to floop
    }
    state invalid_type { return 0 }
    state floop {
        to fbody when (i < word[2097120])
        return 1
    }
    state fbody {
        let base = word[2097112]
        let p = word[8388608 + i * 32 + 8]
        let parameter_index = 0
        word[2096896] = 0
        word[2096888] = 0
        to ploop
    }
    state ploop {
        to pbody when (p != 0)
        to docheck
    }
    state pbody {
        let parameter = word[p + 8]
        to param_bound when (tenv_push(word[parameter + 8], word[parameter + 16], 0, parameter_index) == 1)
        return 0
    }
    state param_bound {
        word[parameter + 24] = parameter_index + 1
        parameter_index = parameter_index + 1
        p = word[p + 16]
        to ploop
    }
    state docheck {
        let declared_return = word[8388608 + i * 32 + 16] % 65536
        let actual_return = tc(word[8388608 + i * 32 + 24])
        to function_resource when (word[2097072] != 0)
        to okmark when (actual_return != declared_return)
        to advance
    }
    state function_resource {
        word[2097112] = base
        return 0
    }
    state okmark {
        mark_invalid_at(word[word[8388608 + i * 32 + 24]] / 256)
        return 0
    }
    state advance {
        word[8388608 + i * 32 + 16] = declared_return + word[2096888] * 65536 + parameter_index * 4294967296
        word[2097112] = base
        i = i + 1
        to floop
    }
}
