: emit_literal
  0x0 beta_imm
  0x83 beta_call
;
: emit_branch
  0xa9 beta_call
  swap
  0x0 beta_jnz
  beta_jmp
;

: emit_definitions 0x0 set_cursor jump emit_definition_loop ;
: emit_definition_loop next 0x0 = branch emit_done emit_colon ;
: emit_colon is_colon branch emit_name bad ;
: emit_name
  need_token find_word 0x1 assert-equal dup emit_definition_assertion
  jump emit_body
;
: emit_body need_token is_semicolon branch emit_ret emit_jump_test ;
: emit_jump_test is_jump branch emit_jump_item emit_branch_test ;
: emit_jump_item
  need_token find_word 0x1 assert-equal beta_jmp jump emit_body
;
: emit_branch_test is_branch branch emit_branch_item emit_normal ;
: emit_branch_item
  need_token find_word 0x1 assert-equal
  need_token find_word 0x1 assert-equal
  emit_branch jump emit_body
;
: emit_normal
  token_start token_length parse_hex 0x1 = branch emit_literal_item emit_name_item
;
: emit_literal_item emit_literal jump emit_body ;
: emit_name_item
  builtin_address 0x1 = branch emit_builtin emit_user
;
: emit_builtin beta_call jump emit_body ;
: emit_user find_word 0x1 assert-equal beta_call jump emit_body ;
: emit_ret beta_ret jump emit_definition_loop ;
: emit_done ;

: bad input-length input-get ;
: main pass_one validate_source emit_runtime emit_definitions ;
