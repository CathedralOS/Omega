# Experimental Gamma-to-Beta source elaborator.
# This program emits textual Beta mnemonics and owns no Alpha opcode encoding.

: cursor 0x0 cell-get ;
: set_cursor 0x0 cell-set ;
: advance cursor + set_cursor ;
: token_start 0x1 cell-get ;
: set_token_start 0x1 cell-set ;
: token_length 0x2 cell-get ;
: set_token_length 0x2 cell-set ;
: pc 0x3 cell-get ;
: set_pc 0x3 cell-set ;
: row_count 0x4 cell-get ;
: set_row_count 0x4 cell-set ;
: number_index 0x7 cell-get ;
: set_number_index 0x7 cell-set ;
: number_end 0x8 cell-get ;
: set_number_end 0x8 cell-set ;
: number_value 0x9 cell-get ;
: set_number_value 0x9 cell-set ;
: row_index 0xa cell-get ;
: set_row_index 0xa cell-set ;
: main_address 0xb cell-get ;
: set_main_address 0xb cell-set ;
: candidate_start 0xc cell-get ;
: set_candidate_start 0xc cell-set ;
: compare_index 0xd cell-get ;
: set_compare_index 0xd cell-set ;
: expected_low 0xe cell-get ;
: set_expected_low 0xe cell-set ;
: expected_high 0xf cell-get ;
: set_expected_high 0xf cell-set ;
: expected_length 0x10 cell-get ;
: set_expected_length 0x10 cell-set ;
: exact_index 0x11 cell-get ;
: set_exact_index 0x11 cell-set ;
: exact_remaining 0x12 cell-get ;
: set_exact_remaining 0x12 cell-set ;

: next jump skip ;
: skip cursor input-length = branch no_token skip_char ;
: no_token 0x0 ;
: skip_char cursor input-get dup 0x21 < branch skip_space skip_hash ;
: skip_space drop 0x1 advance jump skip ;
: skip_hash 0x23 = branch skip_comment token_begin ;
: skip_comment 0x1 advance jump comment_loop ;
: comment_loop cursor input-length = branch no_token comment_char ;
: comment_char cursor input-get dup 0xa = branch comment_end comment_cr ;
: comment_cr dup 0xd = branch comment_end comment_advance ;
: comment_end drop 0x1 advance jump skip ;
: comment_advance drop 0x1 advance jump comment_loop ;
: token_begin cursor set_token_start jump token_loop ;
: token_loop cursor input-length = branch token_done token_body ;
: token_body cursor input-get dup 0x21 < branch token_delimiter token_hash_test ;
: token_hash_test 0x23 = branch token_done token_advance ;
: token_delimiter drop jump token_done ;
: token_advance 0x1 advance jump token_loop ;
: token_done cursor token_start - set_token_length 0x1 ;
: need_token next 0x1 assert-equal ;

: token_exact
  set_expected_length set_expected_high set_expected_low
  token_length expected_length = branch exact_begin exact_false
;
: exact_begin 0x0 set_exact_index expected_low set_exact_remaining jump exact_loop ;
: exact_loop exact_index expected_length = branch exact_true exact_switch ;
: exact_switch exact_index 0x8 = branch exact_use_high exact_byte ;
: exact_use_high expected_high set_exact_remaining jump exact_byte ;
: exact_byte
  exact_remaining 0x100 % token_start exact_index + input-get =
  branch exact_next exact_false
;
: exact_next
  exact_remaining 0x100 / set_exact_remaining
  exact_index 0x1 + set_exact_index jump exact_loop
;
: exact_true 0x1 ;
: exact_false 0x0 ;

: is_colon 0x3a 0x0 0x1 token_exact ;
: is_semicolon 0x3b 0x0 0x1 token_exact ;
: is_main 0x6e69616d 0x0 0x4 token_exact ;
: is_jump 0x706d756a 0x0 0x4 token_exact ;
: is_branch 0x68636e617262 0x0 0x6 token_exact ;

: nibble dup 0x3a < branch nibble_decimal nibble_alpha ;
: nibble_decimal 0x30 - ;
: nibble_alpha 0x57 - ;
: parse_hex token_length 0x3 < branch parse_fail parse_width ;
: parse_width token_length 0x13 < branch parse_prefix parse_fail ;
: parse_prefix
  token_start input-get 0x30 =
  token_start 0x1 + input-get 0x78 = *
  0x0 = branch parse_fail parse_begin
;
: parse_begin
  0x2 set_number_index token_length set_number_end 0x0 set_number_value
  jump parse_loop
;
: parse_loop number_index number_end = branch parse_done parse_digit ;
: parse_digit
  number_value 0x10 * token_start number_index + input-get nibble + set_number_value
  number_index 0x1 + set_number_index jump parse_loop
;
: parse_done number_value 0x1 ;
: parse_fail 0x0 0x0 ;

: row_address 0x3 * 0x100 + ;
: find_word 0x0 set_row_index jump find_loop ;
: find_loop row_index row_count = branch find_absent find_row ;
: find_row
  row_index row_address dup cell-get set_candidate_start
  0x1 + cell-get token_length = branch find_compare_begin find_next
;
: find_compare_begin 0x0 set_compare_index jump find_compare ;
: find_compare compare_index token_length = branch find_present find_compare_byte ;
: find_compare_byte
  candidate_start compare_index + input-get
  token_start compare_index + input-get = branch find_compare_next find_next
;
: find_compare_next compare_index 0x1 + set_compare_index jump find_compare ;
: find_next row_index 0x1 + set_row_index jump find_loop ;
: find_present row_index row_address 0x2 + cell-get 0x1 ;
: find_absent 0x0 0x0 ;

: add_pc pc + set_pc ;
: pass_one
  0x0 set_cursor 0x462 set_pc 0x0 set_row_count 0x0 set_main_address
  jump census
;
: census next 0x0 = branch census_done census_colon ;
: census_colon is_colon branch census_name bad ;
: census_name
  need_token
  row_count row_address
  token_start over cell-set
  token_length over 0x1 + cell-set
  pc swap 0x2 + cell-set
  is_main branch census_main census_next
;
: census_main pc set_main_address jump census_next ;
: census_next row_count 0x1 + set_row_count jump count_body ;
: count_body need_token is_semicolon branch count_end count_jump ;
: count_jump is_jump branch count_jump_item count_branch ;
: count_jump_item need_token 0x9 add_pc jump count_body ;
: count_branch is_branch branch count_branch_item count_normal ;
: count_branch_item need_token need_token 0x1c add_pc jump count_body ;
: count_normal
  token_start token_length parse_hex 0x1 = branch count_literal count_name
;
: count_literal drop 0x13 add_pc jump count_body ;
: count_name drop 0x9 add_pc jump count_body ;
: count_end 0x1 add_pc jump census ;
: census_done main_address 0x0 = branch bad census_output_bound ;
: census_output_bound pc 0xffffd < 0x1 assert-equal jump census_ready ;
: census_ready ;

: builtin_address is_input_length branch b_input_length b_input_get ;
: is_input_length 0x656c2d7475706e69 0x6874676e 0xc token_exact ;
: b_input_length 0x16b 0x1 ;
: b_input_get is_input_get branch b_input_get_yes b_output_byte ;
: is_input_get 0x65672d7475706e69 0x74 0x9 token_exact ;
: b_input_get_yes 0x17b 0x1 ;
: b_output_byte is_output_byte branch b_output_byte_yes b_output_word ;
: is_output_byte 0x622d74757074756f 0x657479 0xb token_exact ;
: b_output_byte_yes 0x1b6 0x1 ;
: b_output_word is_output_word branch b_output_word_yes b_output_position ;
: is_output_word 0x772d74757074756f 0x64726f 0xb token_exact ;
: b_output_word_yes 0x203 0x1 ;
: b_output_position is_output_position branch b_output_position_yes b_assert_equal ;
: is_output_position 0x702d74757074756f 0x6e6f697469736f 0xf token_exact ;
: b_output_position_yes 0x257 0x1 ;
: b_assert_equal is_assert_equal branch b_assert_equal_yes b_cell_get ;
: is_assert_equal 0x652d747265737361 0x6c617571 0xc token_exact ;
: b_assert_equal_yes 0x264 0x1 ;
: b_cell_get is_cell_get branch b_cell_get_yes b_cell_set ;
: is_cell_get 0x7465672d6c6c6563 0x0 0x8 token_exact ;
: b_cell_get_yes 0x28e 0x1 ;
: b_cell_set is_cell_set branch b_cell_set_yes b_dup ;
: is_cell_set 0x7465732d6c6c6563 0x0 0x8 token_exact ;
: b_cell_set_yes 0x2a4 0x1 ;
: b_dup is_dup branch b_dup_yes b_swap ;
: is_dup 0x707564 0x0 0x3 token_exact ;
: b_dup_yes 0x2bd 0x1 ;
: b_swap is_swap branch b_swap_yes b_over ;
: is_swap 0x70617773 0x0 0x4 token_exact ;
: b_swap_yes 0x2df 0x1 ;
: b_over is_over branch b_over_yes b_drop ;
: is_over 0x7265766f 0x0 0x4 token_exact ;
: b_over_yes 0x310 0x1 ;
: b_drop is_drop branch b_drop_yes b_add ;
: is_drop 0x706f7264 0x0 0x4 token_exact ;
: b_drop_yes 0x34a 0x1 ;
: b_add is_add branch b_add_yes b_sub ;
: is_add 0x2b 0x0 0x1 token_exact ;
: b_add_yes 0x354 0x1 ;
: b_sub is_sub branch b_sub_yes b_mul ;
: is_sub 0x2d 0x0 0x1 token_exact ;
: b_sub_yes 0x36d 0x1 ;
: b_mul is_mul branch b_mul_yes b_div ;
: is_mul 0x2a 0x0 0x1 token_exact ;
: b_mul_yes 0x386 0x1 ;
: b_div is_div branch b_div_yes b_mod ;
: is_div 0x2f 0x0 0x1 token_exact ;
: b_div_yes 0x39f 0x1 ;
: b_mod is_mod branch b_mod_yes b_less ;
: is_mod 0x25 0x0 0x1 token_exact ;
: b_mod_yes 0x3c1 0x1 ;
: b_less is_less branch b_less_yes b_equal ;
: is_less 0x3c 0x0 0x1 token_exact ;
: b_less_yes 0x3e3 0x1 ;
: b_equal is_equal branch b_equal_yes b_absent ;
: is_equal 0x3d 0x0 0x1 token_exact ;
: b_equal_yes 0x404 0x1 ;
: b_absent 0x0 0x0 ;

: validate_source 0x0 set_cursor 0x462 set_pc jump validate_definitions ;
: validate_definitions next 0x0 = branch validate_done validate_colon ;
: validate_colon is_colon branch validate_name bad ;
: validate_name
  need_token find_word 0x1 assert-equal pc assert-equal jump validate_body
;
: validate_body need_token is_semicolon branch validate_ret validate_jump_test ;
: validate_jump_test is_jump branch validate_jump_item validate_branch_test ;
: validate_jump_item
  need_token find_word 0x1 assert-equal drop 0x9 add_pc jump validate_body
;
: validate_branch_test is_branch branch validate_branch_item validate_normal ;
: validate_branch_item
  need_token find_word 0x1 assert-equal drop
  need_token find_word 0x1 assert-equal drop
  0x1c add_pc jump validate_body
;
: validate_normal
  token_start token_length parse_hex 0x1 = branch validate_literal validate_word
;
: validate_literal drop 0x13 add_pc jump validate_body ;
: validate_word drop builtin_address 0x1 = branch validate_builtin validate_user ;
: validate_builtin drop 0x9 add_pc jump validate_body ;
: validate_user drop find_word 0x1 assert-equal drop 0x9 add_pc jump validate_body ;
: validate_ret 0x1 add_pc jump validate_definitions ;
: validate_done ;

: emit_word_value 0x20 cell-get ;
: set_emit_word_value 0x20 cell-set ;
: emit_divisor 0x21 cell-get ;
: set_emit_divisor 0x21 cell-set ;
: emit_count 0x22 cell-get ;
: set_emit_count 0x22 cell-set ;
: emit_digit 0x23 cell-get ;
: set_emit_digit 0x23 cell-set ;
: emit_reg0 0x24 cell-get ;
: set_emit_reg0 0x24 cell-set ;
: emit_reg1 0x25 cell-get ;
: set_emit_reg1 0x25 cell-set ;
: emit_reg2 0x26 cell-get ;
: set_emit_reg2 0x26 cell-set ;

: space 0x20 output-byte ;
: newline 0xa output-byte ;
: emit_0x 0x30 output-byte 0x78 output-byte ;
: emit_r 0x72 output-byte ;

: emit_hex_digit
  emit_digit 0xa < branch emit_hex_decimal emit_hex_alpha
;
: emit_hex_decimal emit_digit 0x30 + output-byte jump emit_hex_digit_done ;
: emit_hex_alpha emit_digit 0x57 + output-byte jump emit_hex_digit_done ;
: emit_hex_digit_done ;

: emit_hex_word
  set_emit_word_value emit_0x
  0x1000000000000000 set_emit_divisor
  emit_word_value 0x0 < branch emit_hex_word_negative emit_hex_word_positive
;
: emit_hex_word_negative
  emit_word_value 0x8000000000000000 - set_emit_word_value
  emit_word_value emit_divisor / 0x8 + set_emit_digit emit_hex_digit
  jump emit_hex_word_remainder
;
: emit_hex_word_positive
  emit_word_value emit_divisor / set_emit_digit emit_hex_digit
  jump emit_hex_word_remainder
;
: emit_hex_word_remainder
  emit_word_value emit_divisor % set_emit_word_value
  emit_divisor 0x10 / set_emit_divisor
  0xf set_emit_count jump emit_hex_word_loop
;
: emit_hex_word_loop emit_count 0x0 = branch emit_hex_word_done emit_hex_word_body ;
: emit_hex_word_body
  emit_word_value emit_divisor / set_emit_digit emit_hex_digit
  emit_word_value emit_divisor % set_emit_word_value
  emit_divisor 0x10 / set_emit_divisor
  emit_count 0x1 - set_emit_count jump emit_hex_word_loop
;
: emit_hex_word_done ;

: emit_register
  emit_r dup 0x10 < branch emit_register_one emit_register_two
;
: emit_register_one set_emit_digit emit_hex_digit ;
: emit_register_two
  dup 0x10 / set_emit_digit emit_hex_digit
  0x10 % set_emit_digit emit_hex_digit
;
: emit_register_space emit_register space ;
: emit_word_newline emit_hex_word newline ;

: beta_halt
  0x68 output-byte 0x61 output-byte 0x6c output-byte 0x74 output-byte space
  emit_register newline
;
: beta_imm
  set_emit_reg0 set_emit_word_value
  0x69 output-byte 0x6d output-byte 0x6d output-byte space
  emit_reg0 emit_register_space emit_word_value emit_word_newline
;
: beta_mov
  set_emit_reg0 set_emit_reg1
  0x6d output-byte 0x6f output-byte 0x76 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register newline
;
: beta_add
  set_emit_reg0 set_emit_reg1
  0x61 output-byte 0x64 output-byte 0x64 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register newline
;
: beta_sub
  set_emit_reg0 set_emit_reg1
  0x73 output-byte 0x75 output-byte 0x62 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register newline
;
: beta_mul
  set_emit_reg0 set_emit_reg1
  0x6d output-byte 0x75 output-byte 0x6c output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register newline
;
: beta_div
  set_emit_reg0 set_emit_reg1
  0x64 output-byte 0x69 output-byte 0x76 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register newline
;
: beta_mod
  set_emit_reg0 set_emit_reg1
  0x6d output-byte 0x6f output-byte 0x64 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register newline
;
: beta_loadb
  set_emit_reg0 set_emit_reg1
  0x6c output-byte 0x6f output-byte 0x61 output-byte 0x64 output-byte
  0x62 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register newline
;
: beta_storeb
  set_emit_reg0 set_emit_reg1
  0x73 output-byte 0x74 output-byte 0x6f output-byte 0x72 output-byte
  0x65 output-byte 0x62 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register newline
;
: beta_load
  set_emit_reg0 set_emit_reg1
  0x6c output-byte 0x6f output-byte 0x61 output-byte 0x64 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register newline
;
: beta_store
  set_emit_reg0 set_emit_reg1
  0x73 output-byte 0x74 output-byte 0x6f output-byte 0x72 output-byte
  0x65 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register newline
;
: beta_jmp
  0x6a output-byte 0x6d output-byte 0x70 output-byte space emit_word_newline
;
: beta_jz
  set_emit_reg0 set_emit_word_value
  0x6a output-byte 0x7a output-byte space
  emit_reg0 emit_register_space emit_word_value emit_word_newline
;
: beta_jnz
  set_emit_reg0 set_emit_word_value
  0x6a output-byte 0x6e output-byte 0x7a output-byte space
  emit_reg0 emit_register_space emit_word_value emit_word_newline
;
: beta_jlt
  set_emit_reg0 set_emit_reg1 set_emit_word_value
  0x6a output-byte 0x6c output-byte 0x74 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register_space
  emit_word_value emit_word_newline
;
: beta_jeq
  set_emit_reg0 set_emit_reg1 set_emit_word_value
  0x6a output-byte 0x65 output-byte 0x71 output-byte space
  emit_reg0 emit_register_space emit_reg1 emit_register_space
  emit_word_value emit_word_newline
;
: beta_read
  0x72 output-byte 0x65 output-byte 0x61 output-byte 0x64 output-byte space
  emit_register newline
;
: beta_write
  0x77 output-byte 0x72 output-byte 0x69 output-byte 0x74 output-byte
  0x65 output-byte space emit_register newline
;
: beta_call
  0x63 output-byte 0x61 output-byte 0x6c output-byte 0x6c output-byte space
  emit_word_newline
;
: beta_ret
  0x72 output-byte 0x65 output-byte 0x74 output-byte newline
;

: emit_expected_text
  0x0 set_exact_index expected_low set_exact_remaining jump emit_expected_loop
;
: emit_expected_loop exact_index expected_length = branch emit_expected_done emit_expected_switch ;
: emit_expected_switch exact_index 0x8 = branch emit_expected_high emit_expected_byte ;
: emit_expected_high expected_high set_exact_remaining jump emit_expected_byte ;
: emit_expected_next
  exact_remaining 0x100 / set_exact_remaining
  exact_index 0x1 + set_exact_index jump emit_expected_loop
;
: emit_expected_done ;
: emit_expected_byte
  exact_remaining 0x100 % output-byte
  jump emit_expected_next
;

: emit_assertion emit_hex_word 0x3a output-byte space ;
: emit_runtime_assertion
  emit_assertion
  0x3b output-byte space
  0x72 output-byte 0x75 output-byte 0x6e output-byte 0x74 output-byte
  0x69 output-byte 0x6d output-byte 0x65 output-byte newline
;
: emit_named_assertion
  set_expected_length set_expected_high set_expected_low
  emit_assertion 0x3b output-byte space emit_expected_text newline
;
: emit_definition_assertion
  emit_assertion 0x3b output-byte space
  0x64 output-byte 0x65 output-byte 0x66 output-byte 0x69 output-byte
  0x6e output-byte 0x69 output-byte 0x74 output-byte 0x69 output-byte
  0x6f output-byte 0x6e output-byte space
  0x0 set_compare_index jump emit_definition_name
;
: emit_definition_name
  compare_index token_length = branch emit_definition_done emit_definition_byte
;
: emit_definition_byte
  token_start compare_index + input-get output-byte
  compare_index 0x1 + set_compare_index jump emit_definition_name
;
: emit_definition_done newline ;

