; OMGRFN2 layer-4 source-only selected-result join.
; Concatenate after the generic component envelope, the layer-4 source/witness
; model, the source-body reconstruction procedures selected from
; ckir-refinement-source-lowering.beta, and the helper procedures from
; ckir-refinement-source-result.beta.  CKIR readers and comparison procedures
; are absent from this executable; the gate additionally audits the call graph
; and accepts opaque CKIR/ELF positives.

proc main() {
    let status=omgrfn2_component_read()
    state frame { to done when (status != 0)  status=l4_model_prepare()  to done when (status != 0)  src_init_words()  to lowering }
    state lowering { status=src_reconstruct_lowering_check()  to done when (status != 0)  to result }
    state result { status=src_refinement_source_result_check()  to done }
    state done { return status }
}
