; OMGRFN16 responsibility 4b: source-only mathematical result / first trap.
; This owner never calls a witness, CKIR, or ELF decoder.

proc d_name_equal(a_source,a_token,b_source,b_token) {
    return omgrfn4_r2_token_equal(a_source,a_token,b_source,b_token)
}

proc d_register(source,token,type_id) {
    let count=word[14200000] let at=0
    state room { to exhausted when(count>=512) at=14200100+count*40 word[at]=source word[at+8]=token word[at+16]=type_id word[at+24]=0 word[at+32]=0 word[14200000]=count+1 return count }
    state exhausted { omgrfn4_l2_exhaust() return 4294967295 }
}

proc d_declarations() {
    let source=0 let token=0 let count=0 let kind=0 let binding=0
    word[14200000]=0
    state sources { to source_one when(source<word[500320]) return 0 }
    state source_one { token=0 count=word[880000+source*8] to tokens }
    state tokens { to one when(token+2<count) source=source+1 to sources }
    state one { to next when(omgrfn4_r2_tkind(source,token)!=256) to next when(omgrfn4_r2_tkind(source,token+1)!=58) to u8 when(omgrfn4_r2_is_word(source,token+2,7)==1) to u32 when(omgrfn4_r2_is_word(source,token+2,8)==1) to next }
    state u8 { binding=d_register(source,token,1) to done when(binding==4294967295) token=token+3 to tokens }
    state u32 { to next when(token+4>=count) to next when(omgrfn4_r2_is_word(source,token+3,9)==0) to next when(omgrfn4_r2_is_word(source,token+4,10)==0) binding=d_register(source,token,2) to done when(binding==4294967295) token=token+5 to tokens }
    state next { token=token+1 to tokens }
    state done { return word[700000] }
}

proc d_find(source,token,type_id) {
    let i=0 let at=0
    state loop { to one when(i<word[14200000]) return 4294967295 }
    state one { at=14200100+i*40 to next when(word[at+16]!=type_id) to found when(d_name_equal(source,token,word[at],word[at+8])==1) }
    state next { i=i+1 to loop }
    state found { return i }
}

proc d_find_exact(source,token) {
    let i=0 let at=0
    state loop { to one when(i<word[14200000]) return 4294967295 }
    state one { at=14200100+i*40 to found when(word[at]==source) to next }
    state found { to yes when(word[at+8]==token) to next }
    state next { i=i+1 to loop }
    state yes { return i }
}

proc d_find_nearest(source,token,type_id) {
    let i=0 let at=0 let position=omgrfn4_r2_tstart(source,token) let best=4294967295 let best_position=0 let candidate=0
    state loop { to one when(i<word[14200000]) return best }
    state one { at=14200100+i*40 to next when(word[at]!=source) to next when(word[at+16]!=type_id) to next when(d_name_equal(source,token,word[at],word[at+8])==0) candidate=omgrfn4_r2_tstart(source,word[at+8]) to next when(candidate>position) to take when(best==4294967295) to take when(candidate>best_position) to next }
    state take { best=i best_position=candidate to next }
    state next { i=i+1 to loop }
}

proc r416_leaf_type(source,token,self_field) {
    let binding=d_find(source,token,2)
    state full { to byte when(binding==4294967295) word[13000056]=binding return 2 }
    state byte { binding=d_find(source,token,1) to missing when(binding==4294967295) word[13000056]=binding return 1 }
    state missing { word[13000056]=4294967295 return 0 }
}

proc r416_target_binding(source,token) {
    let binding=d_find(source,token,2)
    state found { to byte when(binding==4294967295) return binding }
    state byte { return d_find(source,token,1) }
}

proc r416_binding_type(binding) {
    state bounds { to missing when(binding>=word[14200000]) return word[14200116+binding*40] }
    state missing { return 0 }
}

proc r416_argument_binding(source,opening,ordinal) {
    let callee=opening-1 let token=word[13000008] let end=word[13000016] let p=0 let close=0 let start=0 let colon=0 let typed=0
    state states { to one when(token+1<end) return 4294967295 }
    state one { to next when(omgrfn4_r2_is_word(source,token,2)==0) to next when(omgrfn4_r2_token_equal(source,token+1,source,callee)==0) p=token+2 to opening }
    state opening { to next when(p>=end) to opened when(omgrfn4_r2_tkind(source,p)==40) p=p+1 to opening }
    state opened { to next when(r416_matching(source,p,40,41)!=0) close=word[13000096] start=p+1 p=start to segments }
    state segments { to one_segment when(p<close) to final }
    state one_segment { to segment when(omgrfn4_r2_tkind(source,p)==44) p=p+1 to segments }
    state segment { colon=start to seek_colon }
    state seek_colon { to have_colon when(colon<p) start=p+1 p=p+1 to segments }
    state have_colon { to colon_found when(omgrfn4_r2_tkind(source,colon)==58) colon=colon+1 to seek_colon }
    state colon_found { to selected when(typed==ordinal) typed=typed+1 start=p+1 p=p+1 to segments }
    state final { colon=start to final_seek }
    state final_seek { to final_colon when(colon<close) return 4294967295 }
    state final_colon { to final_found when(omgrfn4_r2_tkind(source,colon)==58) colon=colon+1 to final_seek }
    state final_found { to selected when(typed==ordinal) return 4294967295 }
    state selected { to next when(colon==0) return d_find_exact(source,colon-1) }
    state next { token=token+1 to states }
}

proc d_initialize_head() {
    let source=word[13000000] let token=word[13000008] let end=word[13000016] let binding=0 let value=0
    state tokens { to one when(token<end) return 0 }
    state one { to string when(omgrfn4_r2_tkind(source,token)==258) token=token+1 to tokens }
    state string { to next when(omgrfn4_r2_tlen(source,token)<=2) value=omgrfn4_l2_source_byte(source,omgrfn4_r2_tstart(source,token)+1) binding=0 to bindings }
    state bindings { to binding_one when(binding<word[14200000]) return 0 }
    state binding_one { to set when(word[14200100+binding*40+16]==1) binding=binding+1 to bindings }
    state set { to binding_next when(r416_is_head(word[14200100+binding*40],word[14200108+binding*40])==0) word[14200124+binding*40]=value word[14200132+binding*40]=1 to binding_next }
    state binding_next { binding=binding+1 to bindings }
    state next { token=token+1 to tokens }
}

proc d_initialize_named_literals() {
    let source=word[13000000] let token=word[13000008] let end=word[13000016] let value=0 let binding=0 let at=0
    state loop { to one when(token+2<end) return 0 }
    state one { to next when(omgrfn4_r2_tkind(source,token)!=256) to next when(omgrfn4_r2_tkind(source,token+1)!=58) to next when(omgrfn4_r2_tkind(source,token+2)!=257) to next when(p_decimal(source,token+2)!=0) value=word[13000144] binding=0 to bindings }
    state bindings { to binding_one when(binding<word[14200000]) token=token+3 to loop }
    state binding_one { at=14200100+binding*40 to binding_next when(word[at+16]!=1) to binding_next when(value>255) to binding_next when(d_name_equal(source,token,word[at],word[at+8])==0) word[at+24]=value word[at+32]=1 to binding_next }
    state binding_next { binding=binding+1 to bindings }
    state next { token=token+1 to loop }
}

proc e_eval(node) {
    let kind=n_kind(node) let left=0 let right=0 let value=0 let binding=0
    state choose { to literal when(kind==1) to leaf when(kind==2) to unary when(kind==3) to binary }
    state literal { word[14300008]=n_value(node) return 0 }
    state leaf { binding=n_value(node) to bad when(binding>=word[14200000]) to bad when(word[14200132+binding*40]==0) word[14300008]=word[14200124+binding*40] return 0 }
    state unary { to done when(e_eval(n_left(node))!=0) to done }
    state binary { to done when(e_eval(n_left(node))!=0) left=word[14300008] to done when(e_eval(n_right(node))!=0) right=word[14300008] to add when(kind==8) to subtract when(kind==26) to multiply }
    state add { to trap when(left>4294967295-right) value=left+right to publish }
    state subtract { to trap when(left<right) value=left-right to publish }
    state multiply { to zero when(right==0) to trap when(left>4294967295/right) value=left*right to publish }
    state zero { value=0 to publish }
    state publish { word[14300008]=value return 0 }
    state trap { word[14300000]=1 word[14300016]=kind return 1 }
    state bad { return omgrfn4_l2_reject() }
    state done { return word[700000]+word[14300000] }
}

proc e_sites() {
    let site=0 let at=0 let node=0 let target=0 let status=0 let value=0 let type_id=0
    word[14300000]=0
    state loop { to one when(site<word[13000032]) return 0 }
    state one { at=13200000+site*40 node=word[at] target=word[at+16] status=e_eval(node) to trap when(word[14300000]==1) to done when(status!=0) value=word[14300008] to next when(target==4294967295) to bad when(target>=word[14200000]) type_id=word[14200116+target*40] to byte when(type_id==1) word[14200124+target*40]=value word[14200132+target*40]=1 to next }
    state byte { to bad when(value>255) word[14200124+target*40]=value word[14200132+target*40]=1 to next }
    state next { site=site+1 to loop }
    state trap { return 1 }
    state bad { return omgrfn4_l2_reject() }
    state done { return status }
}

proc d_state_literal(wanted) {
    let source=word[13000000] let token=word[13000008] let end=word[13000016] let p=0 let close=0 let count=0 let value=0
    state loop { to one when(token+1<end) word[14300024]=4294967295 return 1 }
    state one { to next when(omgrfn4_r2_is_word(source,token,2)==0) to passed when(wanted==1) to failed }
    state passed { to next when(r416_is_passed(source,token+1)==0) p=token+2 to open }
    state failed { to next when(r416_is_failed(source,token+1)==0) p=token+2 to open }
    state one_name { to next when(r416_is_passed(source,token+1)==0) p=token+2 to open }
    state open { to bad when(p>=end) to opened when(omgrfn4_r2_tkind(source,p)==123) p=p+1 to open }
    state opened { to bad when(r416_matching(source,p,123,125)!=0) close=word[13000096] p=p+1 to numbers }
    state numbers { to number when(p<close) to exact }
    state number { to value_one when(omgrfn4_r2_tkind(source,p)==257) p=p+1 to numbers }
    state value_one { to bad when(p_decimal(source,p)!=0) value=word[13000144] count=count+1 p=p+1 to numbers }
    state exact { to bad when(count!=1) word[14300024]=value return 0 }
    state next { token=token+1 to loop }
    state bad { return omgrfn4_l2_reject() }
}

proc d_state_value(wanted) {
    return d_state_literal(wanted)
}

proc d_guards_hold() {
    let source=0 let token=0 let end=0 let binding=0 let expected=0 let status=0
    state bounds { status=r416_find_run() to bad when(status!=0) source=word[13000000] token=word[13000008] end=word[13000016] to loop }
    state loop { to one when(token+3<end) return 1 }
    state one { to self when(token+5<end) to bare }
    state self { to bare when(omgrfn4_r2_is_word(source,token,5)==0) to bare when(omgrfn4_r2_tkind(source,token+1)!=46) to bare when(omgrfn4_r2_tkind(source,token+2)!=256) to bare when(omgrfn4_r2_tkind(source,token+3)!=61) to bare when(omgrfn4_r2_tkind(source,token+4)!=61) to bare when(omgrfn4_r2_tkind(source,token+5)!=257) binding=d_find(source,token+2,2) to check when(binding!=4294967295) to bad }
    state bare { to next when(omgrfn4_r2_tkind(source,token)!=256) to next when(omgrfn4_r2_tkind(source,token+1)!=61) to next when(omgrfn4_r2_tkind(source,token+2)!=61) to next when(omgrfn4_r2_tkind(source,token+3)!=257) binding=d_find_nearest(source,token,2) to bare_byte when(binding==4294967295) to bare_check }
    state bare_byte { binding=d_find_nearest(source,token,1) to bad when(binding==4294967295) to bare_check }
    state bare_check { to false when(word[14200132+binding*40]==0) to bad when(p_decimal(source,token+3)!=0) expected=word[13000144] to false when(word[14200124+binding*40]!=expected) token=token+4 to loop }
    state check { to false when(word[14200132+binding*40]==0) to bad when(p_decimal(source,token+5)!=0) expected=word[13000144] to false when(word[14200124+binding*40]!=expected) token=token+6 to loop }
    state next { token=token+1 to loop }
    state false { return 0 }
    state bad { return 251 }
}

proc r416_prepare_result() {
    let status=0 let source=0
    state frame { word[700000]=0 status=omgrfn5_r2_read_frame() to done when(status!=0) status=omgrfn4_l2_decode_compilation() to done when(status!=0) omgrfn4_r2_init_words() r416_words() to tokenize }
    state tokenize { to one when(source<word[500320]) status=d_declarations() to done }
    state one { status=omgrfn4_r2_tokenize(source) to done when(status!=0) source=source+1 to tokenize }
    state done { return status }
}

proc main() {
    let status=r416_prepare_result() let runtime=0 let result=0
    state prepared { to done when(status!=0) status=r416_sites(1) to done when(status!=0) d_initialize_head() d_initialize_named_literals() runtime=e_sites() to malformed when(word[700000]!=0) to trapped when(runtime==1) to success }
    state trapped { to malformed when(word[500016]!=3) return 0 }
    state success { to malformed when(word[500016]!=1) status=d_guards_hold() to malformed when(status==251) to failed when(status==0) status=d_state_value(1) to done when(status!=0) result=word[14300024] to claim }
    state failed { status=d_state_value(0) to done when(status!=0) result=word[14300024] to claim }
    state claim { to malformed when(result!=word[500088]) return 0 }
    state malformed { return 251 }
    state done { return status }
}
