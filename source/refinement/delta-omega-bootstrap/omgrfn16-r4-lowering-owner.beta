proc c_expect_selected(op) {
    let i=word[14000000] let opcode=0
    state loop { to one when(i<word[950096]) to bad }
    state one { opcode=r47_ckir_byte(word[950296]+i*40+12) to found when(c_selected(opcode)==1) i=i+1 to loop }
    state found { to bad when(i!=op) word[14000000]=i+1 byte[14100000+i]=1 return 0 }
    state bad { return omgrfn4_l2_reject() }
}

proc c_claim_op(op) {
    state fresh { to bad when(byte[14100000+op]!=0) byte[14100000+op]=1 return 0 }
    state bad { return omgrfn4_l2_reject() }
}

