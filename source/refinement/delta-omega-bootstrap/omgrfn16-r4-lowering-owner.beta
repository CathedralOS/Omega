    state mp_next { i=i+1 to machine_params }
    state block_params { to bp when(i<word[950072]) return 1 }
    state bp { p=word[950272]+i*20 to bp_next when(r47_ckir_u32(p+16)!=value) to bp_name }
    state bp_name { to bad when(n_self(node)!=0) to bad when(c_type(r47_ckir_u32(p+12),n_type(node))==0) to bad when(i>=word[879048]) wid=893000+i*48 block=word[wid] to bad when(block>=word[879040]) machine=word[888000+block*96] to bad when(c_name_equal(node,word[884000+machine*128],word[wid+24],word[wid+32])==0) return 0 }
    state bp_next { i=i+1 to block_params }
    state bad { return 1 }
}

proc c_leaf_field(node,value) {
    let load=0 let p=0 let place=0 let field_op=0 let field=0 let owner=0
    state source { to no when(n_self(node)!=1) to no when(c_value_op(value,1)!=0) load=word[14000016] p=word[950296]+load*40 to no when(r47_ckir_byte(p+12)!=5) to no when(r47_ckir_u32(p+28)!=1) place=r47_row_word(13,r47_ckir_u32(p+24),0) to no when(c_value_op(place,2)!=0) field_op=word[14000016] p=word[950296]+field_op*40 to no when(r47_ckir_byte(p+12)!=3) to no when(r47_ckir_u32(p+28)!=1) field=r47_ckir_u32(p+32) to no when(field>=word[879016]) owner=word[882000+field*64] to no when(c_name_equal(node,word[881000+owner*64],word[882032+field*64],word[882040+field*64])==0) to no when(c_type(r412_value_type(value),n_type(node))==0) to no when(c_claim_op(load)!=0) return 0 }
    state no { return 1 }
}

proc c_compare(node,value) {
    let kind=n_kind(node) let op=0 let at=0 let start=0 let left=0 let right=0 let status=0
    state choose { to literal when(kind==1) to leaf when(kind==2) to widen when(kind==3) to arithmetic }
    state literal { to bad when(c_value_op(value,1)!=0) op=word[14000016] at=word[950296]+op*40 to bad when(r47_ckir_byte(at+12)!=1) to bad when(r47_ckir_u32(at+20)>=word[950000]) to bad when(c_type(r47_ckir_u32(at+20),n_type(node))==0) to bad when(r47_ckir_u32(at+28)!=0) to bad when(r47_ckir_u32(at+32)!=n_value(node)) to bad when(r47_ckir_u32(at+36)!=0) return c_claim_op(op) }
    state leaf { to field when(n_self(node)==1) status=c_leaf_parameter(node,value) to ok when(status==0) to bad }
    state field { status=c_leaf_field(node,value) to ok when(status==0) to bad }
