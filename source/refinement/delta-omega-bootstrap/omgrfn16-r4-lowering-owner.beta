    state widen { to bad when(c_value_op(value,1)!=0) op=word[14000016] at=word[950296]+op*40 to bad when(r47_ckir_byte(at+12)!=21) to bad when(r47_ckir_byte(at+13)!=1) to bad when(r47_ckir_byte(at+14)!=0) to bad when(r47_ckir_byte(at+15)!=0) to bad when(c_type(r47_ckir_u32(at+20),2)==0) start=r47_ckir_u32(at+24) to bad when(r47_ckir_u32(at+28)!=1) to bad when(r47_ckir_u32(at+32)!=0) to bad when(r47_ckir_u32(at+36)!=0) left=r47_row_word(13,start,0) status=c_compare(n_left(node),left) to bad when(status!=0) status=c_expect_selected(op) to done }
    state arithmetic { to bad when(c_value_op(value,1)!=0) op=word[14000016] at=word[950296]+op*40 to bad when(r47_ckir_byte(at+12)!=kind) to bad when(r47_ckir_byte(at+13)!=1) to bad when(r47_ckir_byte(at+14)!=0) to bad when(r47_ckir_byte(at+15)!=0) to bad when(c_type(r47_ckir_u32(at+20),2)==0) start=r47_ckir_u32(at+24) to bad when(r47_ckir_u32(at+28)!=2) to bad when(r47_ckir_u32(at+32)!=0) to bad when(r47_ckir_u32(at+36)!=0) left=r47_row_word(13,start,0) right=r47_row_word(13,start+1,0) status=c_compare(n_left(node),left) to bad when(status!=0) status=c_compare(n_right(node),right) to bad when(status!=0) status=c_expect_selected(op) to done }
    state bad { return omgrfn4_l2_reject() }
