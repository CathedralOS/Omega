    state static { to bad when(r47_ckir_byte(p+13)!=1) to bad when(r47_ckir_u32(p+28)!=0) to bad when(r47_ckir_u32(p+36)!=0) to bad when(c_type(r47_ckir_u32(p+20),7)==0) return 0 }
    state nonempty { to bad when(r47_ckir_byte(p+13)!=1) to bad when(c_type(r47_ckir_u32(p+20),3)==0) return 0 }
    state head { to bad when(r47_ckir_byte(p+13)!=1) to bad when(c_type(r47_ckir_u32(p+20),1)==0) block=r47_ckir_u32(p+8) to bad when(block>=word[950064]) to bad when(r47_ckir_byte(word[950264]+block*32+9)!=1) return 0 }
    state tail { to bad when(r47_ckir_byte(p+13)!=1) to bad when(c_type(r47_ckir_u32(p+20),7)==0) block=r47_ckir_u32(p+8) to bad when(block>=word[950064]) to bad when(r47_ckir_byte(word[950264]+block*32+9)!=1) return 0 }
    state bad { return omgrfn4_l2_reject() }
}

proc v_views() {
    let source=word[13000000] let token=word[13000008] let end=word[13000016] let op22=0 let e23=0 let e24=0 let e25=0 let a23=0 let a24=0 let a25=0 let op=0 let p=0 let kind=0
    state tokens { to one when(token<end) to op_counts }
    state one { kind=omgrfn4_r2_tkind(source,token) to string when(kind==258) to dot when(kind==46) to bracket when(kind==91) token=token+1 to tokens }
    state string { v_next(22,op22) to bad when(word[14000032]==4294967295) op=word[14000032] to done when(v_shape(op)!=0) to done when(v_literal_equal(source,token,op)!=0) op22=op+1 token=token+1 to tokens }
    state dot { to next when(token+4>=end) to next when(omgrfn4_r2_tkind(source,token+1)!=256) to next when(omgrfn4_r2_tlen(source,token+1)!=3) to next when(omgrfn4_l2_source_byte(source,omgrfn4_r2_tstart(source,token+1))!='l') to next when(omgrfn4_l2_source_byte(source,omgrfn4_r2_tstart(source,token+1)+1)!='e') to next when(omgrfn4_l2_source_byte(source,omgrfn4_r2_tstart(source,token+1)+2)!='n') to next when(omgrfn4_r2_tkind(source,token+2)!=62) to next when(omgrfn4_r2_tkind(source,token+3)!=257) e23=e23+1 token=token+4 to tokens }
    state bracket { to next when(token+2>=end) to next when(omgrfn4_r2_tkind(source,token+1)!=257) to next when(omgrfn4_r2_tlen(source,token+1)!=1) p=omgrfn4_r2_tstart(source,token+1) to head when(omgrfn4_l2_source_byte(source,p)=='0') to tail }
    state head { to next when(omgrfn4_l2_source_byte(source,p)!='0') to next when(omgrfn4_r2_tkind(source,token+2)!=93) e24=e24+1 token=token+3 to tokens }
    state tail { to next when(token+4>=end) to next when(omgrfn4_r2_tlen(source,token+1)!=1) to next when(omgrfn4_l2_source_byte(source,p)!='1') to next when(omgrfn4_r2_tkind(source,token+2)!=46) to next when(omgrfn4_r2_tkind(source,token+3)!=46) to next when(omgrfn4_r2_tkind(source,token+4)!=93) e25=e25+1 token=token+5 to tokens }
    state next { token=token+1 to tokens }
    state op_counts { op=0 to operations }
    state operations { to op_one when(op<word[950096]) to exact22 }
    state op_one { kind=r47_ckir_byte(word[950296]+op*40+12) to c23 when(kind==23) to c24 when(kind==24) to c25 when(kind==25) op=op+1 to operations }
    state c23 { to done when(v_shape(op)!=0) a23=a23+1 op=op+1 to operations } state c24 { to done when(v_shape(op)!=0) a24=a24+1 op=op+1 to operations } state c25 { to done when(v_shape(op)!=0) a25=a25+1 op=op+1 to operations }
    state exact22 { v_next(22,op22) to bad when(word[14000032]!=4294967295) to bad when(a23!=e23) to bad when(a24!=e24) to bad when(a25!=e25) return 0 }
    state bad { return omgrfn4_l2_reject() }
    state done { return word[700000] }
}

proc r416_prepare_lowering() {
    let status=0 let source=0
    state frame { word[700000]=0 status=omgrfn5_r2_read_frame() to done when(status!=0) status=omgrfn4_l2_decode_compilation() to done when(status!=0) status=r47_witness_prepare() to done when(status!=0) omgrfn4_r2_init_words() r416_words() to tokenize }
    state tokenize { to one when(source<word[500320]) status=r47_ckir_prepare() to done }
    state one { status=omgrfn4_r2_tokenize(source) to done when(status!=0) source=source+1 to tokenize }
    state done { return status }
}

proc main() {
    let status=r416_prepare_lowering()
    state prepared { to done when(status!=0) status=r416_sites(2) to done when(status!=0) status=c_relation() to done when(status!=0) status=v_views() to done }
    state done { return status }
}
