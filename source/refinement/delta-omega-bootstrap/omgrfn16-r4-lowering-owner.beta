; OMGRFN16 responsibility 4a: exact recursive source -> CKIR14 join.

proc r416_wtype(type_id,kind) {
    let at=0
    state bounds { to no when(type_id>=word[954032]) at=word[954232]+type_id*24 to u8 when(kind==1) to full }
    state u8 { to no when(r47_wbyte(at+4)!=1) to no when(r47_wbyte(at+5)!=0) to no when(r47_wu32(at+8)!=0) to no when(r47_wu32(at+12)!=0) to no when(r47_wu32(at+16)!=0) to no when(r47_wu32(at+20)!=255) return 1 }
    state full { to no when(r47_wbyte(at+4)!=2) to no when(r47_wbyte(at+5)!=1) to no when(r47_wu32(at+8)!=0) to no when(r47_wu32(at+12)!=0) to no when(r47_wu32(at+16)!=0) to no when(r47_wu32(at+20)!=4294967295) return 1 }
    state no { return 0 }
}

proc r416_source_block(source,token) {
    let i=0 let position=omgrfn4_r2_tstart(source,token) let machine=0
    state blocks { to one when(i<word[879040]) return 4294967295 }
    state one { machine=word[888000+i*96] to next when(word[884000+machine*128]!=source) to next when(position<word[888024+i*96]) to next when(position>=word[888032+i*96]) return i }
    state next { i=i+1 to blocks }
}

proc r416_span_name(source,token,span_source,start) {
    word[955000]=word[13000160]
    return r47_token_span_equal(source,token,span_source,start)
}

proc r416_leaf_type(source,token,self_field) {
    let i=0 let block=r416_source_block(source,token) let machine=0 let owner=0 let at=0 let type_id=0
    state context { to missing when(block==4294967295) machine=word[888000+block*96] owner=word[884088+machine*128] to fields when(self_field==1) to mparams }
    state fields { to field when(i<word[879016]) i=0 to missing }
    state field { at=882000+i*64 to field_next when(word[at]!=owner) word[13000160]=word[at+40] to field_next when(r416_span_name(source,token,word[881000+owner*64],word[at+32])==0) type_id=word[at+16] word[13000056]=i to u8 when(r416_wtype(type_id,1)==1) to full when(r416_wtype(type_id,2)==1) to missing }
    state field_next { i=i+1 to fields }
    state mparams { to mparam when(i<word[879032]) i=0 to bparams }
    state mparam { at=886000+i*48 to mparam_next when(word[at]!=machine) word[13000160]=word[at+32] to mparam_next when(r416_span_name(source,token,word[884000+machine*128],word[at+24])==0) type_id=word[at+16] word[13000056]=i to u8 when(r416_wtype(type_id,1)==1) to full when(r416_wtype(type_id,2)==1) to missing }
    state mparam_next { i=i+1 to mparams }
    state bparams { to bparam when(i<word[879048]) to missing }
    state bparam { at=893000+i*48 to bparam_next when(word[at]!=block) word[13000160]=word[at+32] to bparam_next when(r416_span_name(source,token,word[884000+machine*128],word[at+24])==0) type_id=word[at+16] word[13000056]=i to u8 when(r416_wtype(type_id,1)==1) to full when(r416_wtype(type_id,2)==1) to missing }
    state bparam_next { i=i+1 to bparams }
    state u8 { return 1 } state full { return 2 }
    state missing { word[13000056]=4294967295 return 0 }
}

proc r416_target_binding(source,token) {
    state lookup { to bad when(r416_leaf_type(source,token,1)==0) return word[13000056] }
    state bad { return 4294967295 }
}

proc r416_argument_binding(source,opening,ordinal) {
    let caller=r416_source_block(source,opening) let machine=0 let callee=opening-1 let block=0 let i=0 let at=0 let seen=0
    state caller_ok { to missing when(caller==4294967295) machine=word[888000+caller*96] to blocks }
    state blocks { to one when(block<word[879040]) return 4294967295 }
    state one { to next when(word[888000+block*96]!=machine) to next when(word[888048+block*96]==0) word[13000160]=word[888048+block*96] to params when(r416_span_name(source,callee,source,word[888040+block*96])==1) }
    state next { block=block+1 to blocks }
    state params { to param when(i<word[879048]) return 4294967295 }
    state param { at=893000+i*48 to param_next when(word[at]!=block) to found when(seen==ordinal) seen=seen+1 }
    state param_next { i=i+1 to params }
    state found { return i }
    state missing { return 4294967295 }
}

proc r416_binding_type(binding) {
    let type_id=0
    state bounds { to missing when(binding>=word[879048]) type_id=word[893016+binding*48] to byte when(r416_wtype(type_id,1)==1) to full when(r416_wtype(type_id,2)==1) to missing }
    state byte { return 1 } state full { return 2 } state missing { return 0 }
}

proc c_type(type_id,kind) {
    let at=0
    state bounds { to no when(type_id>=word[950000]) at=word[950200]+type_id*24 to u8 when(kind==1) to full when(kind==2) to view when(kind==7) to boolean }
    state u8 { to no when(r47_ckir_byte(at+4)!=1) to no when(r47_ckir_byte(at+5)!=0) to no when(r47_ckir_u32(at+8)!=0) to no when(r47_ckir_u32(at+12)!=0) to no when(r47_ckir_u32(at+16)!=0) to no when(r47_ckir_u32(at+20)!=255) return 1 }
    state full { to no when(r47_ckir_byte(at+4)!=2) to no when(r47_ckir_byte(at+5)!=1) to no when(r47_ckir_u32(at+8)!=0) to no when(r47_ckir_u32(at+12)!=0) to no when(r47_ckir_u32(at+16)!=0) to no when(r47_ckir_u32(at+20)!=4294967295) return 1 }
    state view { to no when(r47_ckir_byte(at+4)!=7) return 1 }
    state boolean { to no when(r47_ckir_byte(at+4)!=3) to no when(r47_ckir_u32(at+16)!=0) to no when(r47_ckir_u32(at+20)!=1) return 1 }
    state no { return 0 }
}

proc c_selected(opcode) {
    state one { to yes when(opcode==8) to yes when(opcode==21) to yes when(opcode==26) to yes when(opcode==27) return 0 }
    state yes { return 1 }
}

proc c_value_op(value,result_kind) {
    let op=0 let at=0
    state loop { to one when(op<word[950096]) word[14000016]=4294967295 return 1 }
    state one { at=word[950296]+op*40 to next when(r47_ckir_byte(at+13)!=result_kind) to found when(r47_ckir_u32(at+16)==value) }
