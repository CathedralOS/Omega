; DATA-DEPENDENT loop with a counter-LINEAR delta: total += (a*i) + b for i=0..n-1.
; a*i is the weighted arithmetic series a·g(n); +b adds n·b. Both sides emit init + n·b + a·g(n).
proc main() {
    let n = read_byte()
    let a = read_byte()
    let b = read_byte()
    let total = 0
    let i = 0
    state loop { to body when (i < n)  return total }
    state body { total = total + ((a * i) + b)  i = i + 1  to loop }
}
