machine observe<'source, View>(source: View) -> View where View == &'source mut u64 { source }
// A saved observation of an unwritten array element stays equal to 7 across a write to a disjoint element.
// Expected exit: 0
machine agree(observed: u64, current: u64) -> u64
requires observed == 7
{
    observed
}

machine main() crashes Trap {
    let mut items: [u64; 2] = [7, 1];
    let saved: u64 = observe<&mut u64>(&mut items[0]);
    items[0] = 4;
    transition agree(saved, items[0]) == 7 && items[0] == 4 && items[1] == 1 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
