// GRAMMAR.md: right shift is two `>` that touch; a policy suffix touches the second.
machine shifts(a: u32, b: u32, c: Vec<Vec<u8>>) {
    _ = a >> b;
    _ = a >>% b;
    _ = a >>| b;
    _ = a >>! b;
    _ = a >> !b;
    _ = a >> b > c;
    _ = a > b >> c;
    _ = a >> b + c;
    _ = (a > b) > c;
}
