// GRAMMAR.md: patterns.
machine patterns(value: Shape, pair: Pair) -> u32 {
    match value {
        _ -> 0,
        7 -> 1,
        "seven" -> 2,
        limit -> 3,
        Shape::Empty -> 4,
        Shape::Circle { radius } -> 5,
        Shape::Square { side as width } -> 6,
        Shape::Rect { width as _, height: 4 } -> 7,
        Shape::Poly { count, .. } -> 8,
        Shape::Blank { } -> 9,
        Shape::Open { .. } -> 10,
        Envelope::<u32>::Body::Value { value } -> 11,
        value.limit + 1 -> 12,
    };
    match pair {
        () -> 0,
        (a, b) -> 1,
        (a, (b, c),) -> 2,
        (Shape::Circle { radius }, _) -> 3,
    }
}
