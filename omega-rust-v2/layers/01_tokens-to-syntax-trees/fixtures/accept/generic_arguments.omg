// GRAMMAR.md: generic arguments. Bare `<` in types, `::<` in expressions, and how each
// argument is read as a type or as a value.
machine arguments(
    a: Outcome<u32, Never>,
    b: ByteBuffer<64>,
    c: Buffer<N>,
    d: Buffer<N * 2>,
    e: Buffer<(Other::<T>::SIZE + 1)>,
    f: Wrapper<@u8, [u8], [u8; 4], [[u8; 2]; 2]>,
    g: Routes<2, [open_file(), open_dir()]>,
    h: Routes<1, [(open_file)]>,
    i: Table<[a, b]>,
    j: Callback<machine(value: u32) -> u32, A -> B>,
    k: Holder<'a, core::Level>,
    l: Chosen<(clear satisfies A::clear)>,
    m: Signed<-1, !flag>,
) {
    _ = apply::<set_time>(@mut e, 5);
    _ = integer::max::<i32>();
    _ = Sensor::<29u64>::read();
    _ = convert::<Outcome<u32, Never>, 64>(a);
    _ = a < b;
    _ = a < b && c > d;
}
