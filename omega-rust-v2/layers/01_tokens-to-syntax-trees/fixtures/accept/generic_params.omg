// GRAMMAR.md: generic parameters, every form.
data Transform = machine(v: u32) -> u32;
machine every_form<
    T,
    Element [copy],
    Count: u32,
    u: core\Level,
    const N: u64,
    const F: Transform,
    const G: machine,
    machine Step,
    some S,
    'a,
>(value: @'a T) {
}

// The aliased contract retains its result guarantee when used as a static bound.
data MonotoneStep = machine(value: u64) -> u64 ensures result >= value;
machine forward<const F: MonotoneStep>(x: u64) -> u64 {
    F(x)
}

// `const`, `machine` and `some` are parameter names when no name follows them.
machine names<const, machine, some>(a: const, b: some) {
}
