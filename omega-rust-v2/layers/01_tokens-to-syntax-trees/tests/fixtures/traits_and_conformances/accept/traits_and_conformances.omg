// GRAMMAR.md: trait, conformance.
trait Incrementable<T> {
    machine increment(value: @mut T) -> T;
    machine + add(left: T, right: T) -> T reaches none;
}

boundary trait WallClock: ClockOps<NoState> {}

public trait LocalLogger = Logger {
    machine * reaches none blocks false;
}

public SaturatingIncrement satisfies Incrementable<Counter> {
    machine increment(value: @mut Counter) -> Counter {
        value.count = value.count +| 1;
        value
    }
}

Folded<T, machine Step> satisfies Fold<T>
requires machine Step(value: T) -> T
    requires valid(value)
    ensures valid(result);
{
    machine fold(value: T) -> T {
        Step(value)
    }
}

// A type named `public` still gets a conformance.
public satisfies Marker {}

Forwarder satisfies Logger {
    Logger::write = logging::write_log;
}
