use language::core;
use language::core::reflect;

public machine new_plan<'text>(schema: @TypeSchema<'text>, issuance: Issuance<'text>) -> AccessPlan<'text>
reaches none
crashes none
terminates
ensures result.field_count == 0 && result.reader_count == 0 &&
    result.writer_count == 0 && result.reach.service_count == 0
{
    let fields: [AccessFieldEntry<'text>; 32];
    let readers: [AccessCallerRule<'text>; 32];
    let writers: [AccessCallerRule<'text>; 32];
    let reach: BoundaryReach;
    AccessPlan::<'text> {
        schema: TypeSchema::<'text> { storage: schema.storage },
        issuance: issuance,
        fields: fields, field_count: 0,
        readers: readers, reader_count: 0,
        writers: writers, writer_count: 0,
        reach: reach
    }
}
