use language::core::reflect;

public data Exposure {
    case Exported;
    case BindingPrivate;
}

public data ExternalRead {
    case None;
    case Read;
    case Take;
}

public data AtomicOperations [copy] {
    load: bool;
    store: bool;
    fetch_add: bool;
    fetch_sub: bool;
    fetch_xor: bool;
    fetch_or: bool;
    fetch_and: bool;
    swap: bool;
    compare_exchange: bool;
    compare_exchange_once: bool;
    try_exchange: bool;
    try_exchange_once: bool;
}

public data FieldAccess {
    case Inaccessible;
    case Stable(
        read: bool,
        write: bool,
        exposure: Exposure
    );
    case External(
        read: ExternalRead,
        write: bool,
        exposure: Exposure
    );
    case Atomic(
        operations: AtomicOperations,
        exposure: Exposure
    );
}

public data AccessFieldEntry<'text> {
    field: FieldInfo<'text>;
    access: FieldAccess;
}

public data BoundaryReach requires service_count <= 32 {
    services: [u64; 32];
    service_count: u64;
}

public data Issuance<'text> {
    case Only(routes: [CallableInfo<'text>]);
    case Unrestricted;
}

public data AccessRegion<'text> {
    case Subject(schema: TypeSchema<'text>);
    case Field(field: FieldInfo<'text>);
}

public data AccessCallerRule<'text> {
    region: AccessRegion<'text>;
    callers: [CallableInfo<'text>];
}

public data AccessPlan<'text>
requires field_count <= 32 && reader_count <= 32 && writer_count <= 32
{
    schema: TypeSchema<'text>;
    issuance: Issuance<'text>;
    fields: [AccessFieldEntry<'text>; 32];
    field_count: u64;
    readers: [AccessCallerRule<'text>; 32];
    reader_count: u64;
    writers: [AccessCallerRule<'text>; 32];
    writer_count: u64;
    reach: BoundaryReach;
}

public trait AccessPolicy {
    machine plan<'text>(schema: TypeSchema<'text>) -> AccessPlan<'text>;
}
