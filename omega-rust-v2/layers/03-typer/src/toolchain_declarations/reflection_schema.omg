public data TypeSchema<'graph> [copy] { storage: @'graph [u8]; }

public data CallableInfo<'text> [copy] {
    case Machine(declaration_identity: @'text [u8], callable_identity: @'text [u8], source_revision: @'text [u8]);
    case Requirement(declaration_identity: @'text [u8], callable_identity: @'text [u8], source_revision: @'text [u8]);
}

public data FieldInfo<'text> {
    member_identity: @'text [u8];
    case_identity: @'text [u8];
    owner_identity: @'text [u8];
    owner_application: @'text [u8];
    name: @'text [u8];
    qualified_type: @'text [u8];
    declaration_position: u64;
    has_stable_number: bool;
    is_erased: bool;
    stable_number: u64;
    source_revision: @'text [u8];
}
