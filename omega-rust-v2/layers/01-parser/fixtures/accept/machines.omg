// GRAMMAR.md: machine. Names, operators, results, bodies, nested machines.
machine main() {
}

public machine EchoSupplier::supply(self: @mut EchoSupplier, value: u32) -> u32 {
    value
}

boundary machine platform_write(bytes: @[u8]) -> u64;

machine + add(left: Metres, right: Metres) -> Metres {
    left
}

machine > Small::greater(left: u16 in Small, right: u16) -> bool {
    (left as -Small) > right
}

machine [] read<Element [copy]>(view: @[Element], index: u64) -> Element {
    view[index]
}

machine [..] view<Element>(view: @[Element], from: u64, to: u64) -> @[Element] {
    view[from..to]
}

machine outer(count: u32) -> u32 {
    let doubled = twice(count);
    doubled

    machine twice(value: u32) -> u32 {
        value * 2
    }

    machine unused() {
    }
}

machine apply(step: machine(value: u32) -> u32 reaches none, start: u32) -> u32 {
    step(start)
}

// A hypothesis on a machine: the one clause that ends in a semicolon.
machine existence_follows<A, machine Step>(P: A -> core::Strict<v>, present: A)
requires machine Step(value: A)
    requires P(value)
    ensures Q(value);
ensures core::Squash::<Witness<u, w, A, Q>>
{
    present
}
