use language::core::reflect;

public data Exposure {
    case Exported;
    case BindingPrivate;
}

public data ExternalRead {
    case None;
    case Read;
    case Take;
}

public data AtomicOperations [copy] {
    load: bool;
    store: bool;
    fetch_add: bool;
    fetch_sub: bool;
    fetch_xor: bool;
    fetch_or: bool;
    fetch_and: bool;
    swap: bool;
    compare_exchange: bool;
    compare_exchange_once: bool;
    try_exchange: bool;
    try_exchange_once: bool;
}

public data FieldAccess {
    case Inaccessible;
    case Stable(read: bool, write: bool, exposure: Exposure);
    case External(read: ExternalRead, write: bool, exposure: Exposure);
    case Atomic(operations: AtomicOperations, exposure: Exposure);
}

public data AccessFieldEntry<'t> {
    field: FieldInfo<'t>;
    access: FieldAccess;
}

public data BoundaryReach
    requires self.service_count <= 32
{
    services: [u64; 32];
    service_count: u64;
}

public data Issuance<'t> {
    case Only(routes: [CallableInfo<'t>]);
    case Unrestricted;
}

public data AccessRegion<'t> {
    case Subject(schema: TypeSchema<'t>);
    case Field(field: FieldInfo<'t>);
}

public data AccessCallerRule<'t> {
    region: AccessRegion<'t>;
    callers: [CallableInfo<'t>];
}

public data AccessPlan<'t>
    requires self.field_count <= 32
    requires self.reader_count <= 32
    requires self.writer_count <= 32
{
    schema: TypeSchema<'t>;
    issuance: Issuance<'t>;
    fields: [AccessFieldEntry<'t>; 32];
    field_count: u64;
    readers: [AccessCallerRule<'t>; 32];
    reader_count: u64;
    writers: [AccessCallerRule<'t>; 32];
    writer_count: u64;
    reach: BoundaryReach;
}

public trait AccessPolicy {
    machine plan<'t>(schema: TypeSchema<'t>) -> AccessPlan<'t>;
}
