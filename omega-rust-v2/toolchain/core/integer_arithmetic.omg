    requires N > 0
{ (left +| (right as -u<N>::Saturating)) as +u<N>::Saturating }

public machine + add<const N:u64>(left:u<N> in Trapping, right:u<N> in Trapping) -> u<N> in Trapping
    requires N > 0 crashes Trap
{ ((left as -u<N>::Trapping) +! (right as -u<N>::Trapping)) as +u<N>::Trapping }

public machine + add<const N:u64>(left:u<N> in Trapping, right:u<N>) -> u<N> in Trapping
    requires N > 0 crashes Trap
{ ((left as -u<N>::Trapping) +! right) as +u<N>::Trapping }

