// Each operand keeps its declared carrier. The suffixed primitive selects the overflow behavior.
use core;

public machine + add<const N:u64>(left:u<N> in Wrapping, right:u<N> in Wrapping) -> u<N> in Wrapping
    requires N > 0
{ ((left as -u<N>::Wrapping) +% (right as -u<N>::Wrapping)) as +u<N>::Wrapping }

public machine + add<const N:u64>(left:u<N> in Wrapping, right:u<N>) -> u<N> in Wrapping
    requires N > 0
{ ((left as -u<N>::Wrapping) +% right) as +u<N>::Wrapping }

public machine + add<const N:u64>(left:u<N>, right:u<N> in Wrapping) -> u<N> in Wrapping
    requires N > 0
{ (left +% (right as -u<N>::Wrapping)) as +u<N>::Wrapping }

public machine + add<const N:u64>(left:u<N> in Saturating, right:u<N> in Saturating) -> u<N> in Saturating
    requires N > 0
{ ((left as -u<N>::Saturating) +| (right as -u<N>::Saturating)) as +u<N>::Saturating }

public machine + add<const N:u64>(left:u<N> in Saturating, right:u<N>) -> u<N> in Saturating
    requires N > 0
