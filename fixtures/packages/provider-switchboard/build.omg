// package-manager fixture: exact build-owned provider selection.
const PACKAGE: Package = Package {
    name: "provider-switchboard"
};

target windows_x64 { }
target linux_x64 { }
target linux_arm64 { }
target macos_arm64 { }

machine build(builder: &mut Build) {
    builder.select_provider<ClockHost, MonotonicClock>();
}
