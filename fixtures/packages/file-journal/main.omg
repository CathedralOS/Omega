// Public filesystem-reach fixture.
pub boundary trait FilesystemHost {
    machine append(path: &[u8], bytes: &[u8]);
}

pub data Journal {
    files: FilesystemHost;
}

pub machine Journal::append_line(&mut self, path: &[u8], line: &[u8])
reaches FilesystemHost
invokes FilesystemHost;
{
    self.files.append(path, line);
}
