// Capability acquisition/return fixture.
pub boundary trait SecretLease {
    machine read_word() -> u64 reaches SecretLease;
}

pub boundary trait SecretHost {
    machine open(name: &[u8]) -> SecretLease reaches SecretHost;
}

pub data Vault {
    host: SecretHost;
}

pub machine Vault::open_secret(&mut self, name: &[u8]) -> SecretLease
reaches SecretHost
invokes SecretHost;
{
    self.host.open(name)
}
