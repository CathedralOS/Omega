; calc.beta — a recursive-descent calculator, written in Beta. (slice 6: the self-check)
;
; Reads ONE arithmetic expression from stdin — decimal integers, the operators
; + - * / with the usual precedence, and parentheses — evaluates it, prints the
; result in decimal, and also returns it as the process exit code. It exercises char
; literals, the read_byte/write_byte host boundary, a memory-backed input buffer +
; cursor, recursion (recursive descent through parentheses), and the whole surface.
;
; CONTROL FLOW is CFG/Omega-shaped: each proc is `state` basic blocks linked by
; guarded `to … when …` transitions — no if/while.
;
;   echo "2+3*4"     ->  14        echo "(2+3)*4"   ->  20
;   echo "100-58"    ->  42        echo "2*(3+4)*5" ->  70
;
; Memory layout, just above the 1 MiB data stack (which grows down from 1 MiB):
;   buf      = 2 MiB      input bytes, growing up
;   buf - 8  = cursor     (word) index of the next unread byte
;   buf - 16 = length     (word) number of bytes read

proc main() {
    let buf = 2097152
    let n = 0
    let c = read_byte()
    state loop { to body when (c >= 0)  to done }       ; read_byte() returns -1 at EOF
    state body { byte[buf + n] = c  n = n + 1  c = read_byte()  to loop }
    state done {
        word[buf - 16] = n             ; length
        word[buf - 8] = 0              ; cursor
        let result = parse_expr(buf)
        print_num(result)
        write_byte('\n')
        return result
    }
}

; the byte at the cursor, or 0 (a sentinel no expression char equals) past the end
proc peek(buf) {
    let i = word[buf - 8]
    state chk { to hit when (i < word[buf - 16])  return 0 }
    state hit { return byte[buf + i] }
}

proc advance(buf) {
    word[buf - 8] = word[buf - 8] + 1
}

proc skip_ws(buf) {
    state loop { to body when (peek(buf) == ' ')  return 0 }
    state body { advance(buf)  to loop }
}

proc is_digit(c) {
    state c1 { to no when (c < '0')  to c2 }
    state c2 { to no when (c > '9')  return 1 }
    state no { return 0 }
}

proc is_muldiv(c) {
    state s1 { to yes when (c == '*')  to s2 }
    state s2 { to yes when (c == '/')  return 0 }
    state yes { return 1 }
}

proc is_addsub(c) {
    state s1 { to yes when (c == '+')  to s2 }
    state s2 { to yes when (c == '-')  return 0 }
    state yes { return 1 }
}

proc parse_number(buf) {
    let v = 0
    state loop { to body when (is_digit(peek(buf)) == 1)  return v }
    state body { v = v * 10 + (peek(buf) - '0')  advance(buf)  to loop }
}

proc parse_factor(buf) {
    skip_ws(buf)
    state chk { to paren when (peek(buf) == '(')  return parse_number(buf) }
    state paren {
        advance(buf)                   ; consume '('
        let v = parse_expr(buf)
        skip_ws(buf)
        advance(buf)                   ; consume ')'
        return v
    }
}

proc parse_term(buf) {
    let v = parse_factor(buf)
    skip_ws(buf)
    state loop { to body when (is_muldiv(peek(buf)) == 1)  return v }
    state body {
        let op = peek(buf)
        advance(buf)
        let rhs = parse_factor(buf)
        to mul when (op == '*')
        v = v / rhs
        skip_ws(buf)
        to loop
    }
    state mul { v = v * rhs  skip_ws(buf)  to loop }
}

proc parse_expr(buf) {
    let v = parse_term(buf)
    skip_ws(buf)
    state loop { to body when (is_addsub(peek(buf)) == 1)  return v }
    state body {
        let op = peek(buf)
        advance(buf)
        let rhs = parse_term(buf)
        to add when (op == '+')
        v = v - rhs
        skip_ws(buf)
        to loop
    }
    state add { v = v + rhs  skip_ws(buf)  to loop }
}

; print n in decimal (n >= 0), most-significant digit first
proc print_num(n) {
    state big { to rec when (n >= 10)  to digit }
    state rec { print_num(n / 10)  to digit }
    state digit { write_byte(n % 10 + '0')  return 0 }
}
