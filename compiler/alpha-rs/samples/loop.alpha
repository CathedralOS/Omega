// Slice 5: mutable reassignment + a real loop (back-edge transition).
// Counts i from 0 up to 3, then exits with the final counter value (3).
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_line(text: &[u8] in Utf8);
}
data Main { console: Console; }

machine Main::main(&mut self) {
    let i: i32 = 0;
    transition 0 { _ -> step() }

    state step() {
        transition i < 3 {
            true -> body()
            false -> finish()
        }
    }
    state body() {
        write_line("tick");
        i = i + 1;
        transition 0 { _ -> step() } // back-edge: loop
    }
    state finish() {
        self.console.exit_process(i)
    }
}
