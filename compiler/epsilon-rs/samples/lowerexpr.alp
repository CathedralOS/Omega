// SELF-HOSTING / CODEGEN (expression arc): the ORCHESTRATOR. The first program to lower a
// COMPLETE expression end-to-end -- it composes the pieces proved separately. It runs the
// shunting-yard (as rpn.alp) but, instead of printing each RPN token, EMITS that token's
// ARM64: an int-literal operand -> its constant load (movz/movk, as loadk.alp) + push; a
// binary operator -> its pop/op/push snippet (as lowerop.alp). The output is exactly the
// instruction sequence the backend's recursive lower_expression produces for the subject.
// Scope: int literals + the binary operators (the symbol-free subset, no layout table).
// Field/local/array operands plug into the same operand slot next.
//   printf '2 + 3 * 4' | lowerexpr  -> load 2,push / load 3,push / load 4,push / mul / add
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    n: i32; pos: i32; c: i32; start: i32; w: i32; curp: i32; curl: i32; sp: i32;
    num: i32; q: i32; low: i32; high: i32; v: i32; di: i32; ek: i32;
    ostart: [i32; 128]; oend: [i32; 128]; oprec: [i32; 128];
    dig: [i32; 16];
    buf: [u8; 16384];
}
machine Main::is_word(&mut self, c: i32) -> i32 {     // digits only here (int literals)
    transition c < 48 { true -> no()  false -> w2() }
    state w2() { transition c <= 57 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::emit_int(&mut self) {     // self.v as decimal
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::emit_movz(&mut self) {     // "    movz w0, #"  (4 leading spaces)
    write_byte(32);
    transition 0 { _ -> s1b() }
    state s1b(){ write_byte(32); transition 0 { _ -> s2() } }
    state s2(){ write_byte(32);  transition 0 { _ -> s3() } }
    state s3(){ write_byte(32);  transition 0 { _ -> s4() } }
    state s4(){ write_byte(109); transition 0 { _ -> a() } }
    state a() { write_byte(111); transition 0 { _ -> b() } }
    state b() { write_byte(118); transition 0 { _ -> c2() } }
    state c2(){ write_byte(122); transition 0 { _ -> d() } }
    state d() { write_byte(32);  transition 0 { _ -> e() } }
    state e() { write_byte(119); transition 0 { _ -> f() } }
    state f() { write_byte(48);  transition 0 { _ -> g() } }
    state g() { write_byte(44);  transition 0 { _ -> h() } }
    state h() { write_byte(32);  transition 0 { _ -> i() } }
    state i() { write_byte(35); }
}
machine Main::emit_movk(&mut self) {     // "    movk w0, #"  (4 leading spaces)
    write_byte(32);
    transition 0 { _ -> s1b() }
    state s1b(){ write_byte(32); transition 0 { _ -> s2() } }
    state s2(){ write_byte(32);  transition 0 { _ -> s3() } }
    state s3(){ write_byte(32);  transition 0 { _ -> s4() } }
    state s4(){ write_byte(109); transition 0 { _ -> a() } }
    state a() { write_byte(111); transition 0 { _ -> b() } }
    state b() { write_byte(118); transition 0 { _ -> c2() } }
    state c2(){ write_byte(107); transition 0 { _ -> d() } }
    state d() { write_byte(32);  transition 0 { _ -> e() } }
    state e() { write_byte(119); transition 0 { _ -> f() } }
    state f() { write_byte(48);  transition 0 { _ -> g() } }
    state g() { write_byte(44);  transition 0 { _ -> h() } }
    state h() { write_byte(32);  transition 0 { _ -> i() } }
    state i() { write_byte(35); }
}
machine Main::emit_lsl(&mut self) {       // ", lsl #16"
    write_byte(44);
    transition 0 { _ -> a() }
    state a() { write_byte(32);  transition 0 { _ -> b() } }
    state b() { write_byte(108); transition 0 { _ -> c2() } }
    state c2(){ write_byte(115); transition 0 { _ -> d() } }
    state d() { write_byte(108); transition 0 { _ -> e() } }
    state e() { write_byte(32);  transition 0 { _ -> f() } }
    state f() { write_byte(35);  transition 0 { _ -> g() } }
    state g() { write_byte(49);  transition 0 { _ -> h() } }
    state h() { write_byte(54); }
}
machine Main::push(&mut self) {  self.console.write_line("    str x0, [sp, #-16]!") }
machine Main::pops(&mut self) {
    self.console.write_line("    ldr x1, [sp], #16");
    self.console.write_line("    ldr x0, [sp], #16")
}
// emit an int-literal operand: load the constant (movz/movk) then push
machine Main::emit_lit(&mut self, s: i32, e: i32) {
    self.num = 0; self.pos = s;
    transition 0 { _ -> atoi() }
    state atoi() { transition self.pos < e { true -> acc()  false -> mat() } }
    state acc()  { self.num = self.num * 10 + self.buf[self.pos] - 48; self.pos = self.pos + 1; transition 0 { _ -> atoi() } }
    state mat()  { self.q = self.num / 65536; self.low = self.num - self.q * 65536; self.high = self.q - self.q / 65536 * 65536; transition 0 { _ -> ez() } }
    state ez()   { self.emit_movz(); self.v = self.low; self.emit_int(); write_byte(10); transition self.high == 0 { true -> pu()  false -> ek() } }
    state ek()   { self.emit_movk(); self.v = self.high; self.emit_int(); self.emit_lsl(); write_byte(10); transition 0 { _ -> pu() } }
    state pu()   { self.push() }
}
// emit a binary operator's snippet (pops + op-specific + push)
machine Main::emit_op(&mut self, s: i32) {
    transition self.buf[s] == 42 { true -> mul()  false -> o1() }   // '*'
    state o1()  { transition self.buf[s] == 47 { true -> divi()  false -> o2() } }
    state o2()  { transition self.buf[s] == 43 { true -> add()  false -> o3() } }
    state o3()  { transition self.buf[s] == 45 { true -> sub()  false -> o4() } }
    state o4()  { transition self.buf[s] == 60 { true -> lt2()  false -> o5() } }
    state o5()  { transition self.buf[s] == 62 { true -> gt2()  false -> o6() } }
    state o6()  { transition self.buf[s] == 61 { true -> eq()  false -> o7() } }
    state o7()  { transition self.buf[s] == 33 { true -> ne()  false -> o8() } }
    state o8()  { transition self.buf[s] == 37  { true -> rem()  false -> o9() } }   // '%'
    state o9()  { transition self.buf[s] == 38  { true -> band()  false -> o10() } } // '&'
    state o10() { transition self.buf[s] == 124 { true -> bor()  false -> o11() } }  // '|'
    state o11() { transition self.buf[s] == 94  { true -> bxor()  false -> ret() } } // '^'
    state lt2() { transition self.buf[s + 1] == 61 { true -> le()  false -> lt2b() } }
    state lt2b(){ transition self.buf[s + 1] == 60 { true -> shl()  false -> lt() } } // '<<'
    state gt2() { transition self.buf[s + 1] == 61 { true -> ge()  false -> gt2b() } }
    state gt2b(){ transition self.buf[s + 1] == 62 { true -> shr()  false -> gt() } } // '>>'
    state add() { self.pops(); self.console.write_line("    adds w0, w0, w1"); self.console.write_line("    b.vs Ltrap"); self.push(); transition 0 { _ -> ret() } }
    state sub() { self.pops(); self.console.write_line("    subs w0, w0, w1"); self.console.write_line("    b.vs Ltrap"); self.push(); transition 0 { _ -> ret() } }
    state mul() { self.pops(); self.console.write_line("    smull x0, w0, w1"); self.console.write_line("    sxtw x2, w0"); self.console.write_line("    cmp x0, x2"); self.console.write_line("    b.ne Ltrap"); self.push(); transition 0 { _ -> ret() } }
    state divi(){ self.pops(); self.console.write_line("    cbz w1, Ltrap"); self.console.write_line("    sdiv w0, w0, w1"); self.push(); transition 0 { _ -> ret() } }
    state lt()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, lt"); self.push(); transition 0 { _ -> ret() } }
    state le()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, le"); self.push(); transition 0 { _ -> ret() } }
    state gt()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, gt"); self.push(); transition 0 { _ -> ret() } }
    state ge()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, ge"); self.push(); transition 0 { _ -> ret() } }
    state eq()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, eq"); self.push(); transition 0 { _ -> ret() } }
    state ne()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, ne"); self.push(); transition 0 { _ -> ret() } }
    state rem() { self.pops(); self.console.write_line("    cbz w1, Ltrap"); self.console.write_line("    sdiv w2, w0, w1"); self.console.write_line("    msub w0, w2, w1, w0"); self.push(); transition 0 { _ -> ret() } }
    state band(){ self.pops(); self.console.write_line("    and w0, w0, w1"); self.push(); transition 0 { _ -> ret() } }
    state bor() { self.pops(); self.console.write_line("    orr w0, w0, w1"); self.push(); transition 0 { _ -> ret() } }
    state bxor(){ self.pops(); self.console.write_line("    eor w0, w0, w1"); self.push(); transition 0 { _ -> ret() } }
    state shl() { self.pops(); self.console.write_line("    lsl w0, w0, w1"); self.push(); transition 0 { _ -> ret() } }
    state shr() { self.pops(); self.console.write_line("    asr w0, w0, w1"); self.push(); transition 0 { _ -> ret() } }
    state ret() { }
}
machine Main::main(&mut self) {
    self.n = 0; self.sp = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { transition self.n < 16384 { true -> store2()  false -> rd() } }
    state store2(){ self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state scan()  { self.pos = 0; transition 0 { _ -> sk() } }
    state sk()    { transition self.pos < self.n { true -> ws()  false -> flush() } }
    state ws()    { transition self.buf[self.pos] <= 32 { true -> wadv()  false -> tok() } }
    state wadv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state tok()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> atom()  false -> op() } }
    // operand (int literal) -> emit its load immediately (shunting-yard: operands go straight out)
    state atom()  { self.start = self.pos; transition 0 { _ -> arun() } }
    state arun()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> aadv()  false -> aemit() } }
    state aadv()  { self.pos = self.pos + 1; transition 0 { _ -> arun() } }
    state aemit() { self.emit_lit(self.start, self.pos); transition 0 { _ -> sk() } }
    // operator: classify precedence + length, shunting-yard pop (emit) then push
    state op()    { transition self.buf[self.pos] == 42 { true -> p3()  false -> opc() } }
    state opc()   { transition self.buf[self.pos] == 47 { true -> p3()  false -> opd() } }
    state opd()   { transition self.buf[self.pos] == 43 { true -> p2()  false -> ope() } }
    state ope()   { transition self.buf[self.pos] == 45 { true -> p2()  false -> opf() } }
    state opf()   { transition self.buf[self.pos] == 60 { true -> p1m()  false -> opg() } }
    state opg()   { transition self.buf[self.pos] == 62 { true -> p1m()  false -> oph() } }
    state oph()   { transition self.buf[self.pos] == 61 { true -> p1t()  false -> opi() } }
    state opi()   { transition self.buf[self.pos] == 33 { true -> p1t()  false -> opj() } }
    state opj()   { transition self.buf[self.pos] == 37  { true -> p3()  false -> opk() } }  // '%' (with * /)
    state opk()   { transition self.buf[self.pos] == 38  { true -> p0()  false -> opl() } }  // '&'
    state opl()   { transition self.buf[self.pos] == 124 { true -> p0()  false -> opm() } }  // '|'
    state opm()   { transition self.buf[self.pos] == 94  { true -> p0()  false -> padv() } } // '^'
    state p3()    { self.curp = 3; self.curl = 1; transition 0 { _ -> sypop() } }
    state p2()    { self.curp = 2; self.curl = 1; transition 0 { _ -> sypop() } }
    state p0()    { self.curp = 0; self.curl = 1; transition 0 { _ -> sypop() } }             // & | ^ (lowest)
    state p1m()   { self.curp = 1; transition self.buf[self.pos + 1] == 61 { true -> p1l2()  false -> p1mshc() } }
    state p1l2()  { self.curl = 2; transition 0 { _ -> sypop() } }
    state p1mshc(){ transition self.buf[self.pos + 1] == self.buf[self.pos] { true -> p1msh()  false -> p1l1() } } // '<<' / '>>'
    state p1msh() { self.curp = 0; self.curl = 2; transition 0 { _ -> sypop() } }             // shifts: prec 0, len 2
    state p1l1()  { self.curl = 1; transition 0 { _ -> sypop() } }
    state p1t()   { self.curp = 1; self.curl = 2; transition 0 { _ -> sypop() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state sypop() { transition self.sp > 0 { true -> syp2()  false -> opush() } }
    state syp2()  { transition self.oprec[self.sp - 1] < self.curp { true -> opush()  false -> syem() } }
    state syem()  { self.emit_op(self.ostart[self.sp - 1]); self.sp = self.sp - 1; transition 0 { _ -> sypop() } }
    state opush() { self.ostart[self.sp] = self.pos; self.oend[self.sp] = self.pos + self.curl; self.oprec[self.sp] = self.curp; self.sp = self.sp + 1; self.pos = self.pos + self.curl; transition 0 { _ -> sk() } }
    state flush() { transition self.sp > 0 { true -> flem()  false -> done() } }
    state flem()  { self.emit_op(self.ostart[self.sp - 1]); self.sp = self.sp - 1; transition 0 { _ -> flush() } }
    state done()  { self.console.exit_process(0) }
}
