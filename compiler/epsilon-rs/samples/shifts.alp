// Shift operators: `<<` (left) and `>>` (arithmetic right, sign-preserving for i32).
// They join `& | ^` at the single bit-operator precedence level (looser than `+`/`*`,
// left-associative). The shift amount is taken mod 32 by the hardware on BOTH backends
// (x64 masks cl to 5 bits; arm64 masks w1) — a defined, consistent value, no trap.
// Hand-checked:
//   1 << 4    = 16
//   200 >> 2  = 50
//   1 << 2 + 1 = 1 << 3 = 8   (parses as 1 << (2+1) — `+` binds tighter than `<<`)
//   (3 << 4) | 7 = 48 | 7 = 55   (the field-building idiom a codegen needs)
//   => 16 + 50 + 8 + 55 = 129
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: i32 = 1 << 4;
    let b: i32 = 200 >> 2;
    let c: i32 = 1 << 2 + 1;
    let d: i32 = (3 << 4) | 7;
    self.console.exit_process(a + b + c + d)
}
