// DOMAIN TYPES slice 5: the arithmetic domain on a FIELD's type (not just a `let`-local).
// The real Omega bounded_counter declares `value: i32 in Saturating` on the struct; arithmetic that
// stores INTO such a field clamps to i32 MIN/MAX on overflow instead of trapping (default) or wrapping.
// Here `self.v = self.v + 2e9` overflows and saturates to MAX (positive), so the program reaches exit 42.
//   fieldsat  ->  exit 42   (a plain `v: i32` field would trap -> 133; `in Wrapping` would go negative -> 7)
boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    v: i32 in Saturating;
}

machine Main::main(&mut self) {
    self.v = 2000000000;
    self.v = self.v + 2000000000;   // overflows i32; saturates because v is `in Saturating`
    transition self.v > 0 {
        true -> ok()
        false -> bad()
    }

    state ok() { self.console.exit_process(42) }
    state bad() { self.console.exit_process(7) }
}
