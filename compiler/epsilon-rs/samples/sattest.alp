// DOMAIN TYPES slice 3: `i32 in Saturating` (the domain the real Omega bounded_counter sample uses).
// On overflow, a saturating value CLAMPS to i32 MIN/MAX instead of trapping (default) or wrapping. Here
// a+b = 2e9 + 2e9 overflows i32 and saturates to MAX (2147483647, positive), so the program reaches exit
// 42. (Checks `s > 0` -- still distinguishes the three domains: Saturating -> positive MAX (42); Wrapping
// -> negative (7); Trapping -> trap (133). The exact saturated value is i32 MAX, by the clamp codegen.)
//   sattest  ->  exit 42
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
    a: i32; b: i32;
}
machine Main::main(&mut self) {
    self.a = 2000000000;
    self.b = 2000000000;
    transition 0 { _ -> step() }
    state step() {
        let s: i32 in Saturating = self.a + self.b;
        transition s > 0 { true -> ok()  false -> bad() }
    }
    state ok()  { self.console.exit_process(42) }
    state bad() { self.console.exit_process(7) }
}
