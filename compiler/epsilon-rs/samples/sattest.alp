// DOMAIN TYPES slice 3: `i32 in Saturating` (the domain the real Omega bounded_counter sample uses).
// On overflow, a saturating value CLAMPS to i32 MIN/MAX instead of trapping (default) or wrapping. Here
// a+b = 2e9 + 2e9 overflows i32 and saturates to MAX (2147483647), so the program reaches exit 42.
//   sattest  ->  exit 42   (default would trap -> 133; Wrapping would be negative)
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
    a: i32; b: i32;
}
machine Main::main(&mut self) {
    self.a = 2000000000;
    self.b = 2000000000;
    transition 0 { _ -> step() }
    state step() {
        let s: i32 in Saturating = self.a + self.b;
        transition s == 2147483647 { true -> ok()  false -> bad() }
    }
    state ok()  { self.console.exit_process(42) }
    state bad() { self.console.exit_process(7) }
}
