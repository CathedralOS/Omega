// Payload construction + enum-field sizing (binding is a later slice). A `case Circle(r: i32)`
// variant carries an i32 payload at the enum value's offset + 8 (the tag is at + 0), so the enum
// field `sh: Shape` is sized to tag + widest payload (here 8 + 8 = 16 bytes). Construction
// `self.sh = Shape::Square(36)` stores the tag at sh+0 and the payload at sh+8; a bare match arm
// dispatches by tag. Square (tag 1) -> b() -> exit 2. (Binding `{ s }` to read the payload back is
// the next slice; here the payload is written but not yet read.)
boundary trait Console { machine exit_process(return_code: i32); }
data Shape { case Circle(r: i32); case Square(s: i32); }
data Main { console: Console; sh: Shape; }
machine Main::main(&mut self) {
    self.sh = Shape::Square(36);
    transition self.sh {
        Shape::Circle -> a()
        Shape::Square -> b()
    }
    state a() { self.console.exit_process(1) }
    state b() { self.console.exit_process(2) }
}
