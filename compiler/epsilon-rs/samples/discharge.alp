// STATIC CONTRACT DISCHARGE — the compiler PROVES an `ensures` contract at BUILD time.
//
// The runtime contract path desugars `ensures` into an assert that traps if violated for the
// concrete inputs of one call. Static discharge is the other half: `EPS_EMIT=contracts` makes
// the compiler emit, for each machine below, a delta certificate that the postcondition holds
// for ALL inputs (a closed `forall a… obligation`), which the trust anchor checks. The compiler
// proves the contract; it is not trusted to — a false postcondition emits a certificate the
// checker REJECTS, failing the build before the program runs. (See contracts.sh.)
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }

// EQUALITY (proved by refl):
// identity: result == a + b, returned verbatim
machine adds(a: i32, b: i32) -> i32 ensures result == a + b { return a + b; }
// reduction: result == a, returned as 0 + a -> (p z (v0)) reduces to (v0)
machine zadd(a: i32) -> i32 ensures result == a { return 0 + a; }
// LEMMA CITATION: result == a, returned as a + 0 -> (p (v0) z) does NOT reduce (p recurses on
// the left); refl can't prove it. The compiler cites add-zero-right: (inst (use 0) a).
machine azr(a: i32) -> i32 ensures result == a { return a + 0; }
// LEMMA CITATION (multi-arg): result == b + a, returned as a + b -> commutativity, which refl
// can't see. The compiler cites add-commutes at both terms: (inst (inst (use 5) b) a).
machine comm(a: i32, b: i32) -> i32 ensures result == b + a { return a + b; }
// multiplication: result == a * 3, returned verbatim
machine triple(a: i32) -> i32 ensures result == a * 3 { return a * 3; }
// LEMMA CITATION (multiplicative): result == b * a, returned as a * b -> commutativity of `*`,
// which refl can't see (m recurses on the left, so a*b vs b*a is stuck). The compiler cites
// mult-commutes at both terms: (inst (inst (use 20) b) a) -- the * mirror of the `comm` case.
machine mcomm(a: i32, b: i32) -> i32 ensures result == b * a { return a * b; }

// STRICT ORDER (proved by an existential witness, a < b == exists w. a+(s w)=b):
// result exceeds the input: result > a, returned as a + 1 -> witness 0
machine succ_gt(a: i32) -> i32 ensures result > a { return a + 1; }
// bounded below by a margin: result > a, returned as a + 5 -> witness 4
machine plus5_gt(a: i32) -> i32 ensures result > a { return a + 5; }
// upper bound: result < a + 1 (i.e. result <= a), returned verbatim a -> witness 0
machine lt_succ(a: i32) -> i32 ensures result < a + 1 { return a; }

// NON-STRICT ORDER (a <= b == exists w. a+w=b; the witness IS the gap, so it can be a param):
// constant margin: result <= a + 10, returned verbatim a -> witness 10 (a literal, so
// provably >= 0 -- sound for signed i32). A PARAMETER gap (result <= a + b) is deliberately
// NOT discharged: b could be negative, which would make the runtime assert trap while a
// natural-number proof "accepts" -- the discharge refuses unprovably-non-negative witnesses.
machine within10(a: i32) -> i32 ensures result <= a + 10 { return a; }

// CALL-SITE COMPOSITION (modular verification): a wrapper forwards its parameter to a callee
// with the SAME precondition. The compiler proves the callee's `requires` holds for the
// argument FROM the wrapper's own `requires` -- omega's call-argument obligation, discharged.
machine needs_pos(x: i32) -> i32 requires x >= 1 { return x; }
machine fwd(a: i32) -> i32 requires a >= 1 { return needs_pos(a); }
// multi-parameter wrapper: forwards its SECOND parameter (b) to the callee; the cert binds
// both parameters and names b inside the existential at (v 2).
machine fwd2(a: i32, b: i32) -> i32 requires b >= 1 { return needs_pos(b); }
// PRECONDITION WEAKENING: the wrapper demands a STRONGER bound (a >= 3) than the callee needs
// (x >= 1). The compiler discharges the callee's precondition from the caller's via le-trans
// (3 >= 1, so a >= 3 implies a >= 1) -- the common modular case, not just identical contracts.
machine weaken(a: i32) -> i32 requires a >= 3 { return needs_pos(a); }
// UPPER-BOUND weakening (mirror): wrapper demands a TIGHTER ceiling (a <= 2) than the callee
// needs (x <= 5); a <= 2 implies a <= 5, again via le-trans.
machine bounded(x: i32) -> i32 requires x <= 5 { return x; }
machine tighten(a: i32) -> i32 requires a <= 2 { return bounded(a); }

machine Main::main(&mut self) { let r: i32 = adds(20, 22); self.console.exit_process(r) }
