// CERTIFYING COMPILER — one program, one whole-program safety proof. Where the single
// certifiers each discharge one obligation, this reads a SEQUENCE of 2D array accesses
// (each a quad i n j m: index i*n+j into an m-by-n array) and emits ONE delta
// certificate -- a CONJUNCTION -- proving EVERY access is in bounds:
//   (& bound_1 (& bound_2 ... bound_K))   proved by   (pair p_1 (pair p_2 ... p_K))
// where each bound_t is  exists k. (i*n+j) + (k+1) = m*n  with witness m*n-(i*n+j)-1.
// The trust anchor checks the entire conjunction in one shot: the program ships a
// single proof that the whole program's array accesses are safe -- the obligation an
// Omega compiler discharges for a function body, here emitted and machine-checked.
//   printf '2 5 3 4  1 3 0 2' | certify-accesses | check.exe  ->  accept  (13<20 AND 3<6)
// Contract: each access has i*n+j < m*n; accesses are quads of decimal numbers.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 128]; n: i32; pos: i32; c: i32;
    nums: [i32; 64]; cnt: i32; K: i32; Km1: i32; cur: i32;
    gi: i32; cp: i32; w: i32; uv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// (= (p (p (m AI AN) AJ) (s (v 0))) (m AM AN))  for the access at nums[base..base+3]
machine Main::emit_eqbody(&mut self, base: i32) {
    write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);
    write_byte(40); write_byte(112); write_byte(32); write_byte(40); write_byte(109); write_byte(32); // "(= (p (p (m "
    self.emit_nat(self.nums[base]);
    write_byte(32);
    self.emit_nat(self.nums[base + 1]);
    write_byte(41); write_byte(32);                                                                   // ") "
    self.emit_nat(self.nums[base + 2]);
    write_byte(41); write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40);
    write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(41);
    write_byte(32); write_byte(40); write_byte(109); write_byte(32);                                   // ") (s (v 0))) (m "
    self.emit_nat(self.nums[base + 3]);
    write_byte(32);
    self.emit_nat(self.nums[base + 1]);
    write_byte(41); write_byte(41);                                                                   // "))"
}
// one conjunct of the GOAL:  (Exists BODY)
machine Main::emit_bound(&mut self, base: i32) {
    write_byte(40); write_byte(69); write_byte(120); write_byte(105); write_byte(115);
    write_byte(116); write_byte(115); write_byte(32);                                                 // "(Exists "
    self.emit_eqbody(base);
    write_byte(41);                                                                                   // ")"
}
// one conjunct of the PROOF:  (wit BODY W (refl (m M N)))
machine Main::emit_pf(&mut self, base: i32) {
    write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32);                // "(wit "
    self.emit_eqbody(base);
    write_byte(32);
    self.w = self.nums[base + 3] * self.nums[base + 1] - (self.nums[base] * self.nums[base + 1] + self.nums[base + 2]) - 1;
    self.emit_nat(self.w);
    write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102);
    write_byte(108); write_byte(32); write_byte(40); write_byte(109); write_byte(32);                 // " (refl (m "
    self.emit_nat(self.nums[base + 3]);
    write_byte(32);
    self.emit_nat(self.nums[base + 1]);
    write_byte(41); write_byte(41); write_byte(41);                                                   // ")))"
}
machine Main::main(&mut self) {
    self.n = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    // parse every decimal number into nums[]
    state scan()  { self.pos = 0; self.cnt = 0; transition 0 { _ -> nxt() } }
    state nxt()   { transition self.pos < self.n { true -> sd()  false -> compute() } }
    state sd()    { transition self.buf[self.pos] < 48 { true -> adv()  false -> sdHi() } }
    state sdHi()  { transition self.buf[self.pos] > 57 { true -> adv()  false -> pnum() } }
    state adv()   { self.pos = self.pos + 1; transition 0 { _ -> nxt() } }
    state pnum()  { self.cur = 0; transition 0 { _ -> pd() } }
    state pd()    { transition self.buf[self.pos] < 48 { true -> psave()  false -> pdHi() } }
    state pdHi()  { transition self.buf[self.pos] > 57 { true -> psave()  false -> pacc() } }
    state pacc()  { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pd() } }
    state psave() { self.nums[self.cnt] = self.cur; self.cnt = self.cnt + 1; transition 0 { _ -> nxt() } }
    state compute(){ self.K = self.cnt / 4; self.Km1 = self.K - 1; transition 0 { _ -> goal() } }
    // GOAL: (& b0 (& b1 ... bK-1))
    state goal()   { self.gi = 0; transition 0 { _ -> gloop() } }
    state gloop()  { transition self.gi < self.Km1 { true -> gw()  false -> glast() } }
    state gw()     { write_byte(40); write_byte(38); write_byte(32); self.cur = self.gi * 4; self.emit_bound(self.cur); write_byte(32); self.gi = self.gi + 1; transition 0 { _ -> gloop() } } // "(& " bound " "
    state glast()  { self.cur = self.Km1 * 4; self.emit_bound(self.cur); transition 0 { _ -> gclose() } }
    state gclose() { self.cp = 0; transition 0 { _ -> gcloop() } }
    state gcloop() { transition self.cp < self.Km1 { true -> gcw()  false -> gdone() } }
    state gcw()    { write_byte(41); self.cp = self.cp + 1; transition 0 { _ -> gcloop() } }
    state gdone()  { write_byte(32); transition 0 { _ -> proof() } }
    // PROOF: (pair p0 (pair p1 ... pK-1))
    state proof()  { self.gi = 0; transition 0 { _ -> ploop() } }
    state ploop()  { transition self.gi < self.Km1 { true -> pw()  false -> plast() } }
    state pw()     { write_byte(40); write_byte(112); write_byte(97); write_byte(105); write_byte(114); write_byte(32); self.cur = self.gi * 4; self.emit_pf(self.cur); write_byte(32); self.gi = self.gi + 1; transition 0 { _ -> ploop() } } // "(pair " pf " "
    state plast()  { self.cur = self.Km1 * 4; self.emit_pf(self.cur); transition 0 { _ -> pclose() } }
    state pclose() { self.cp = 0; transition 0 { _ -> pcloop() } }
    state pcloop() { transition self.cp < self.Km1 { true -> pcw()  false -> fin() } }
    state pcw()    { write_byte(41); self.cp = self.cp + 1; transition 0 { _ -> pcloop() } }
    state fin()    { self.console.exit_process(0) }
}
