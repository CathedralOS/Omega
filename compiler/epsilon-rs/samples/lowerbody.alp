// SELF-HOSTING / CODEGEN: a COMPLETE transition -- fuses the subject lowering (lowersubj) with the
// arm dispatch (armdispatch). Phase 0 collects the field table (scalar fields, offset = 8*index),
// phase 1 the state labels (Lm<mi>s<si>), phase 2 lowers the first transition: the SUBJECT (a literal
// `movz w0,#v` / push, OR a `self.field` load `ldr x9,[x29,#16]; ldr w0,[x9,#off]` / push) then the
// subject-pop and per-arm dispatch -- exactly the backend's Transition lowering (src/aarch64.rs):
//     ldr x0, [sp], #16              pop the subject
//   per value arm  (true=1, false=0, N):
//     movz w1, #<value> / cmp w0, w1 / b.eq Lm<mi>s<target>
//   per wild arm `_`:
//     b Lm<mi>s<target>
// Combined with lowersubj (the subject), this is a complete transition. Single-machine inputs
// (mi 0) for verification; the target is resolved via the state table by name.
//   ... transition self.x { true -> a() false -> b() } state a(){} state b(){} ...
//     -> pop / movz w1,#1; cmp; b.eq Lm0s0 / movz w1,#0; cmp; b.eq Lm0s1
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    n: i32; pos: i32; c: i32; start: i32; w: i32; pend: i32; phase: i32; depth: i32; mi: i32; si: i32;
    ps: i32; pe: i32; kind: i32; val: i32; cj: i32; tsi: i32; tmi: i32; found: i32; v: i32; di: i32; ek: i32;
    nf: i32; dp: i32; ind: i32; expf: i32; fs: i32; fe: i32; foff: i32; sval: i32; lsi: i32;
    fns: [i32; 64]; fne: [i32; 64];
    sns: [i32; 256]; sne: [i32; 256]; smi: [i32; 256]; ssi: [i32; 256];
    qa: i32; qb: i32; qc: i32; qd: i32; qk: i32;
    dig: [i32; 16];
    buf: [u8; 16384];
}
machine Main::is_word(&mut self, c: i32) -> i32 {
    transition c == 95 { true -> yes()  false -> w1() }
    state w1() { transition c < 48  { true -> no()  false -> w2() } }
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }
    state w3() { transition c < 65  { true -> no()  false -> w4() } }
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }
    state w5() { transition c < 97  { true -> no()  false -> w6() } }
    state w6() { transition c <= 122 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::is_state(&mut self, s: i32, e: i32) -> i32 {     // "state"
    transition e - s == 5 { true -> k0()  false -> kno() }
    state k0() { transition self.buf[s]     == 115 { true -> k1()  false -> kno() } }
    state k1() { transition self.buf[s + 1] == 116 { true -> k2()  false -> kno() } }
    state k2() { transition self.buf[s + 2] == 97  { true -> k3()  false -> kno() } }
    state k3() { transition self.buf[s + 3] == 116 { true -> k4()  false -> kno() } }
    state k4() { transition self.buf[s + 4] == 101 { true -> kyes() false -> kno() } }
    state kyes() { return 1; }
    state kno()  { return 0; }
}
machine Main::is_machine(&mut self, s: i32, e: i32) -> i32 {   // "machine"
    transition e - s == 7 { true -> m0()  false -> mno() }
    state m0() { transition self.buf[s]     == 109 { true -> m1()  false -> mno() } }
    state m1() { transition self.buf[s + 1] == 97  { true -> m2()  false -> mno() } }
    state m2() { transition self.buf[s + 2] == 99  { true -> m3()  false -> mno() } }
    state m3() { transition self.buf[s + 3] == 104 { true -> m4()  false -> mno() } }
    state m4() { transition self.buf[s + 4] == 105 { true -> m5()  false -> mno() } }
    state m5() { transition self.buf[s + 5] == 110 { true -> m6()  false -> mno() } }
    state m6() { transition self.buf[s + 6] == 101 { true -> myes() false -> mno() } }
    state myes() { return 1; }
    state mno()  { return 0; }
}
machine Main::is_trans(&mut self, s: i32, e: i32) -> i32 {    // "transition"
    transition e - s == 10 { true -> t0()  false -> tno() }
    state t0() { transition self.buf[s]     == 116 { true -> t1()  false -> tno() } }
    state t1() { transition self.buf[s + 1] == 114 { true -> t2()  false -> tno() } }
    state t2() { transition self.buf[s + 2] == 97  { true -> t3()  false -> tno() } }
    state t3() { transition self.buf[s + 3] == 110 { true -> t4()  false -> tno() } }
    state t4() { transition self.buf[s + 4] == 115 { true -> t5()  false -> tno() } }
    state t5() { transition self.buf[s + 5] == 105 { true -> t6()  false -> tno() } }
    state t6() { transition self.buf[s + 6] == 116 { true -> t7()  false -> tno() } }
    state t7() { transition self.buf[s + 7] == 105 { true -> t8()  false -> tno() } }
    state t8() { transition self.buf[s + 8] == 111 { true -> t9()  false -> tno() } }
    state t9() { transition self.buf[s + 9] == 110 { true -> tyes() false -> tno() } }
    state tyes() { return 1; }
    state tno()  { return 0; }
}
machine Main::is_true(&mut self, s: i32, e: i32) -> i32 {     // "true"
    transition e - s == 4 { true -> a0()  false -> ano() }
    state a0() { transition self.buf[s]     == 116 { true -> a1()  false -> ano() } }
    state a1() { transition self.buf[s + 1] == 114 { true -> a2()  false -> ano() } }
    state a2() { transition self.buf[s + 2] == 117 { true -> a3()  false -> ano() } }
    state a3() { transition self.buf[s + 3] == 101 { true -> ayes() false -> ano() } }
    state ayes() { return 1; }
    state ano()  { return 0; }
}
machine Main::is_false(&mut self, s: i32, e: i32) -> i32 {    // "false"
    transition e - s == 5 { true -> f0()  false -> fno() }
    state f0() { transition self.buf[s]     == 102 { true -> f1()  false -> fno() } }
    state f1() { transition self.buf[s + 1] == 97  { true -> f2()  false -> fno() } }
    state f2() { transition self.buf[s + 2] == 108 { true -> f3()  false -> fno() } }
    state f3() { transition self.buf[s + 3] == 115 { true -> f4()  false -> fno() } }
    state f4() { transition self.buf[s + 4] == 101 { true -> fyes() false -> fno() } }
    state fyes() { return 1; }
    state fno()  { return 0; }
}
machine Main::streq(&mut self) -> i32 {     // buf[qa..qb) == buf[qc..qd)
    transition self.qb - self.qa == self.qd - self.qc { true -> q0()  false -> qno() }
    state q0()  { self.qk = 0; transition 0 { _ -> ql() } }
    state ql()  { transition self.qa + self.qk < self.qb { true -> qc2()  false -> qyes() } }
    state qc2() { transition self.buf[self.qa + self.qk] == self.buf[self.qc + self.qk] { true -> qa2()  false -> qno() } }
    state qa2() { self.qk = self.qk + 1; transition 0 { _ -> ql() } }
    state qyes(){ return 1; }
    state qno() { return 0; }
}
machine Main::emit_int(&mut self) {
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::p_movw1(&mut self) {       // "    movz w1, #"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(109); transition 0 { _ -> b4() } }
    state b4(){ write_byte(111); transition 0 { _ -> b5() } }
    state b5(){ write_byte(118); transition 0 { _ -> b6() } }
    state b6(){ write_byte(122); transition 0 { _ -> b7() } }
    state b7(){ write_byte(32);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(119); transition 0 { _ -> b9() } }
    state b9(){ write_byte(49);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(44);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(32);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(35); }
}
machine Main::p_beq(&mut self) {          // "    b.eq Lm"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(98);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(46);  transition 0 { _ -> b5() } }
    state b5(){ write_byte(101); transition 0 { _ -> b6() } }
    state b6(){ write_byte(113); transition 0 { _ -> b7() } }
    state b7(){ write_byte(32);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(76);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(109); }
}
machine Main::p_b(&mut self) {            // "    b Lm"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(98);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(32);  transition 0 { _ -> b5() } }
    state b5(){ write_byte(76);  transition 0 { _ -> b6() } }
    state b6(){ write_byte(109); }
}
machine Main::emit_lab(&mut self) {       // <mi> 's' <tsi> then newline   (after p_b/p_beq emitted "Lm")
    self.v = self.tmi; self.emit_int(); write_byte(115);
    self.v = self.tsi; self.emit_int(); write_byte(10)
}
machine Main::is_data(&mut self, s: i32, e: i32) -> i32 {     // "data"
    transition e - s == 4 { true -> d0()  false -> dno() }
    state d0() { transition self.buf[s]     == 100 { true -> d1()  false -> dno() } }
    state d1() { transition self.buf[s + 1] == 97  { true -> d2()  false -> dno() } }
    state d2() { transition self.buf[s + 2] == 116 { true -> d3()  false -> dno() } }
    state d3() { transition self.buf[s + 3] == 97  { true -> dyes() false -> dno() } }
    state dyes() { return 1; }
    state dno()  { return 0; }
}
machine Main::p_movw0(&mut self) {       // "    movz w0, #"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(109); transition 0 { _ -> b4() } }
    state b4(){ write_byte(111); transition 0 { _ -> b5() } }
    state b5(){ write_byte(118); transition 0 { _ -> b6() } }
    state b6(){ write_byte(122); transition 0 { _ -> b7() } }
    state b7(){ write_byte(32);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(119); transition 0 { _ -> b9() } }
    state b9(){ write_byte(48);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(44);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(32);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(35); }
}
machine Main::p_ldrw0(&mut self) {       // "    ldr w0, [x9, #"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(108); transition 0 { _ -> b4() } }
    state b4(){ write_byte(100); transition 0 { _ -> b5() } }
    state b5(){ write_byte(114); transition 0 { _ -> b6() } }
    state b6(){ write_byte(32);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(119); transition 0 { _ -> b8() } }
    state b8(){ write_byte(48);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(44);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(32);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(91);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(120); transition 0 { _ -> bd() } }
    state bd(){ write_byte(57);  transition 0 { _ -> be() } }
    state be(){ write_byte(44);  transition 0 { _ -> bf() } }
    state bf(){ write_byte(32);  transition 0 { _ -> bg() } }
    state bg(){ write_byte(35); }
}
machine Main::p_lm(&mut self) {          // "Lm"  (label def, column 0)
    write_byte(76);  transition 0 { _ -> b0() }
    state b0(){ write_byte(109); }
}
machine Main::main(&mut self) {
    self.n = 0; self.phase = 0; self.depth = 0; self.mi = 0 - 1; self.si = 0; self.pend = 0; self.nf = 0; self.dp = 0; self.ind = 0; self.expf = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { transition self.n < 16384 { true -> store2()  false -> rd() } }
    state store2(){ self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state scan()  { self.pos = 0; transition 0 { _ -> sk() } }
    state sk()    { transition self.pos < self.n { true -> ws()  false -> endph() } }
    state ws()    { transition self.buf[self.pos] <= 32 { true -> wadv()  false -> cm() } }
    state wadv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state cm()    { transition self.buf[self.pos] == 47 { true -> cm2()  false -> str0() } }
    state cm2()   { transition self.buf[self.pos + 1] == 47 { true -> cms()  false -> str0() } }
    state cms()   { transition self.pos < self.n { true -> cnl()  false -> endph() } }
    state cnl()   { transition self.buf[self.pos] == 10 { true -> wadv()  false -> cadv() } }
    state cadv()  { self.pos = self.pos + 1; transition 0 { _ -> cms() } }
    state str0()  { transition self.buf[self.pos] == 34 { true -> stra()  false -> tok() } }
    state stra()  { self.pos = self.pos + 1; transition 0 { _ -> ssx() } }
    state ssx()   { transition self.pos < self.n { true -> ss2()  false -> endph() } }
    state ss2()   { transition self.buf[self.pos] == 34 { true -> wadv()  false -> ssa() } }
    state ssa()   { self.pos = self.pos + 1; transition 0 { _ -> ssx() } }
    state tok()   { transition self.phase == 0 { true -> tok0()  false -> tok12() } }
    state tok12() { transition self.phase == 1 { true -> tok1()  false -> tok2() } }
    // ---- phase 0: collect the field table (scalar fields in decl order; offset = 8*index) ----
    state tok0()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word0()  false -> punc0() } }
    state word0() { self.start = self.pos; transition 0 { _ -> wr0() } }
    state wr0()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wa0()  false -> wc0() } }
    state wa0()   { self.pos = self.pos + 1; transition 0 { _ -> wr0() } }
    state wc0()   { self.w = self.is_data(self.start, self.pos); transition self.w == 1 { true -> setdp()  false -> wc0b() } }
    state setdp() { self.dp = 1; transition 0 { _ -> sk() } }
    state wc0b()  { transition self.ind == 1 { true -> wc0c()  false -> sk() } }
    state wc0c()  { transition self.expf == 1 { true -> addF()  false -> sk() } }
    state addF()  { self.fns[self.nf] = self.start; self.fne[self.nf] = self.pos; self.nf = self.nf + 1; self.expf = 0; transition 0 { _ -> sk() } }
    state punc0() { transition self.buf[self.pos] == 123 { true -> opn0()  false -> p0b() } }
    state opn0()  { transition self.dp == 1 { true -> opn0b()  false -> p0adv() } }
    state opn0b() { self.ind = 1; self.expf = 1; self.dp = 0; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state p0b()   { transition self.buf[self.pos] == 125 { true -> cls0()  false -> p0c() } }
    state cls0()  { self.ind = 0; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state p0c()   { transition self.buf[self.pos] == 59 { true -> semi0()  false -> p0adv() } }
    state semi0() { transition self.ind == 1 { true -> semi0b()  false -> p0adv() } }
    state semi0b(){ self.expf = 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state p0adv() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    // ---- pass 1: collect state labels (mi over depth-0 machines, si over depth-1 states) ----
    state tok1()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word1()  false -> punc1() } }
    state punc1() { transition self.buf[self.pos] == 123 { true -> opn1()  false -> p1b() } }
    state opn1()  { self.depth = self.depth + 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state p1b()   { transition self.buf[self.pos] == 125 { true -> cls1()  false -> padv1() } }
    state cls1()  { self.depth = self.depth - 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state padv1() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state word1() { self.start = self.pos; transition 0 { _ -> wr1() } }
    state wr1()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wa1()  false -> wc1() } }
    state wa1()   { self.pos = self.pos + 1; transition 0 { _ -> wr1() } }
    state wc1()   { transition self.pend == 1 { true -> addS()  false -> ck1m() } }
    state addS()  { self.sns[self.si + 0] = self.start; transition 0 { _ -> addS2() } }
    state addS2() { self.sne[self.si] = self.pos; self.smi[self.si] = self.mi; self.ssi[self.si] = self.si; self.si = self.si + 1; self.pend = 0; transition 0 { _ -> sk() } }
    state ck1m()  { self.w = self.is_machine(self.start, self.pos); transition self.w == 1 { true -> newM1()  false -> ck1s() } }
    state newM1() { transition self.depth == 0 { true -> nm1()  false -> sk() } }
    state nm1()   { self.mi = self.mi + 1; self.si = 0; transition 0 { _ -> sk() } }
    state ck1s()  { transition self.depth == 1 { true -> ck1s2()  false -> sk() } }
    state ck1s2() { self.w = self.is_state(self.start, self.pos); transition self.w == 1 { true -> setP1()  false -> sk() } }
    state setP1() { self.pend = 1; transition 0 { _ -> sk() } }
    // ---- pass 2: find the first `transition`, skip its subject, emit pop + arm dispatch ----
    state tok2()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word2()  false -> padv2() } }
    state padv2() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state word2() { self.start = self.pos; transition 0 { _ -> wr2() } }
    state wr2()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wa2()  false -> wc2() } }
    state wa2()   { self.pos = self.pos + 1; transition 0 { _ -> wr2() } }
    state wc2()   { self.w = self.is_machine(self.start, self.pos); transition self.w == 1 { true -> nm2()  false -> ck2t() } }
    state nm2()   { self.mi = self.mi + 1; self.lsi = 0; transition 0 { _ -> sk() } }             // new machine: bump mi, reset label counter
    state ck2t()  { self.w = self.is_trans(self.start, self.pos); transition self.w == 1 { true -> subj0()  false -> ck2s() } }
    state ck2s()  { self.w = self.is_state(self.start, self.pos); transition self.w == 1 { true -> emitL()  false -> sk() } }
    state emitL() { self.p_lm(); self.v = self.mi; self.emit_int(); write_byte(115); self.v = self.lsi; self.emit_int(); write_byte(58); write_byte(10); self.lsi = self.lsi + 1; transition 0 { _ -> sk() } }
    // lower the SUBJECT: skip ws, then a literal (digits) or a self.field
    state subj0() { transition self.buf[self.pos] <= 32 { true -> subadv()  false -> subc() } }
    state subadv(){ self.pos = self.pos + 1; transition 0 { _ -> subj0() } }
    state subc()  { transition self.buf[self.pos] < 48 { true -> fldsub()  false -> subc2() } }
    state subc2() { transition self.buf[self.pos] > 57 { true -> fldsub()  false -> litsub() } }
    state litsub(){ self.sval = 0; transition 0 { _ -> litr() } }
    state litr()  { transition self.buf[self.pos] < 48 { true -> litdone()  false -> litr2() } }
    state litr2() { transition self.buf[self.pos] > 57 { true -> litdone()  false -> litacc() } }
    state litacc(){ self.sval = self.sval * 10 + self.buf[self.pos] - 48; self.pos = self.pos + 1; transition 0 { _ -> litr() } }
    state litdone(){ self.p_movw0(); self.v = self.sval; self.emit_int(); write_byte(10); self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> toarms() } }
    state fldsub(){ transition self.buf[self.pos] == 46 { true -> fldname()  false -> fldsk() } }  // scan to '.'
    state fldsk() { self.pos = self.pos + 1; transition 0 { _ -> fldsub() } }
    state fldname(){ self.pos = self.pos + 1; self.fs = self.pos; transition 0 { _ -> fldr() } }   // past '.', capture name
    state fldr()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> flda()  false -> flde() } }
    state flda()  { self.pos = self.pos + 1; transition 0 { _ -> fldr() } }
    state flde()  { self.fe = self.pos; self.qa = self.fs; self.qb = self.fe; self.cj = 0; self.foff = 0; transition 0 { _ -> flk() } }
    state flk()   { transition self.cj < self.nf { true -> flkc()  false -> femit() } }
    state flkc()  { self.qc = self.fns[self.cj]; self.qd = self.fne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> flkh()  false -> flkn() } }
    state flkh()  { self.foff = self.cj * 8; transition 0 { _ -> femit() } }
    state flkn()  { self.cj = self.cj + 1; transition 0 { _ -> flk() } }
    state femit() { self.console.write_line("    ldr x9, [x29, #16]"); self.p_ldrw0(); self.v = self.foff; self.emit_int(); write_byte(93); write_byte(10); self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> toarms() } }
    state toarms(){ transition self.buf[self.pos] == 123 { true -> arms0()  false -> toaadv() } }
    state toaadv(){ self.pos = self.pos + 1; transition 0 { _ -> toarms() } }
    state arms0() { self.console.write_line("    ldr x0, [sp], #16"); self.pos = self.pos + 1; self.tmi = self.mi; transition 0 { _ -> arm() } }   // '{', emit subject pop
    // arm loop: skip ws, then a pattern token (-> '_'/true/false/N), '->', target '(', emit dispatch; '}' ends
    state arm()   { transition self.buf[self.pos] <= 32 { true -> aadv()  false -> arm2() } }
    state aadv()  { self.pos = self.pos + 1; transition 0 { _ -> arm() } }
    state arm2()  { transition self.buf[self.pos] == 125 { true -> armend()  false -> patw() } }   // arms '}' -> continue the body walk
    state armend(){ self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state patw()  { self.ps = self.pos; transition 0 { _ -> pwr() } }
    state pwr()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> pwa()  false -> pwe() } }
    state pwa()   { self.pos = self.pos + 1; transition 0 { _ -> pwr() } }
    state pwe()   { self.pe = self.pos; transition 0 { _ -> cls() } }   // classify the pattern buf[ps..pe)
    state cls()   { transition self.pe - self.ps == 1 { true -> cku()  false -> ckk() } }
    state cku()   { transition self.buf[self.ps] == 95 { true -> setWild()  false -> ckdig() } }  // '_'
    state setWild(){ self.kind = 0; transition 0 { _ -> toarrow() } }
    state ckk()   { self.w = self.is_true(self.ps, self.pe); transition self.w == 1 { true -> setT()  false -> ckf() } }
    state setT()  { self.kind = 1; self.val = 1; transition 0 { _ -> toarrow() } }
    state ckf()   { self.w = self.is_false(self.ps, self.pe); transition self.w == 1 { true -> setF()  false -> ckdig() } }
    state setF()  { self.kind = 1; self.val = 0; transition 0 { _ -> toarrow() } }
    state ckdig() { self.kind = 1; self.val = 0; self.cj = self.ps; transition 0 { _ -> diga() } } // int literal pattern
    state diga()  { transition self.cj < self.pe { true -> digacc()  false -> toarrow() } }
    state digacc(){ self.val = self.val * 10 + self.buf[self.cj] - 48; self.cj = self.cj + 1; transition 0 { _ -> diga() } }
    // advance to the target name (skip ws + the "->")
    state toarrow(){ transition self.buf[self.pos] == 45 { true -> arrskip()  false -> toa2() } }  // '-'
    state arrskip(){ self.pos = self.pos + 2; transition 0 { _ -> totgt() } }                      // skip "->"
    state toa2()  { self.pos = self.pos + 1; transition 0 { _ -> toarrow() } }
    state totgt() { transition self.buf[self.pos] <= 32 { true -> tgadv()  false -> tgt0() } }
    state tgadv() { self.pos = self.pos + 1; transition 0 { _ -> totgt() } }
    state tgt0()  { self.start = self.pos; transition 0 { _ -> tgr() } }
    state tgr()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> tga()  false -> tge() } }
    state tga()   { self.pos = self.pos + 1; transition 0 { _ -> tgr() } }
    state tge()   { self.qa = self.start; self.qb = self.pos; self.cj = 0; self.found = 0; transition 0 { _ -> lk() } } // resolve target -> tsi
    state lk()    { transition self.cj < self.si { true -> lkc()  false -> emitA() } }
    state lkc()   { transition self.smi[self.cj] == self.tmi { true -> lkc2()  false -> lkn() } }
    state lkc2()  { self.qc = self.sns[self.cj]; self.qd = self.sne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> lkh()  false -> lkn() } }
    state lkh()   { self.tsi = self.ssi[self.cj]; self.found = 1; transition 0 { _ -> emitA() } }
    state lkn()   { self.cj = self.cj + 1; transition 0 { _ -> lk() } }
    // emit the arm
    state emitA() { transition self.found == 1 { true -> ekind()  false -> aend() } }
    state ekind() { transition self.kind == 0 { true -> ewild()  false -> eval() } }
    state ewild() { self.p_b(); self.emit_lab(); transition 0 { _ -> aend() } }
    state eval()  { self.p_movw1(); self.v = self.val; self.emit_int(); write_byte(10); self.console.write_line("    cmp w0, w1"); self.p_beq(); self.emit_lab(); transition 0 { _ -> aend() } }
    state aend()  { transition self.buf[self.pos] == 41 { true -> aend2()  false -> aendsk() } }     // skip up to & incl ')' after target
    state aendsk(){ self.pos = self.pos + 1; transition 0 { _ -> aend() } }
    state aend2() { self.pos = self.pos + 1; transition 0 { _ -> arm() } }
    state endph() { transition self.phase == 0 { true -> p1()  false -> endph1() } }
    state endph1(){ transition self.phase == 1 { true -> p2()  false -> done() } }
    state p1()    { self.phase = 1; self.pos = 0; self.mi = 0 - 1; self.depth = 0; self.pend = 0; transition 0 { _ -> sk() } }
    state p2()    { self.phase = 2; self.pos = 0; self.mi = 0 - 1; self.lsi = 0; self.depth = 0; self.pend = 0; transition 0 { _ -> sk() } }
    state done()  { self.console.exit_process(0) }
}
