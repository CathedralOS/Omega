// SELF-HOSTING / CODEGEN: STATEMENT lowering begins. An assignment `self.x = expr` lowers
// the value (the expression machinery already built) and then STORES it; storefield.alp emits
// that store half, exactly as the backend's StoreSelfField (src/aarch64.rs) -- given the field
// offset, with the value already on the stack:
//     ldr x0, [sp], #16      pop value
//     ldr x9, [x29, #16]     self pointer (self_disp 16, local-free machine)
//     str w0, [x9, #offset]  self.<field> = value
// The store counterpart of fieldload (the load). Reads the field offset on stdin.
//   printf '8' | storefield   ->  store to self.<field at offset 8>
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    c: i32; off: i32; v: i32; di: i32; ek: i32;
    dig: [i32; 16];
}
machine Main::emit_int(&mut self) {     // self.v as decimal
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::p_strw0(&mut self) {       // "    str w0, [x9, #"  (4 leading spaces)
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(115); transition 0 { _ -> b4() } }
    state b4(){ write_byte(116); transition 0 { _ -> b5() } }
    state b5(){ write_byte(114); transition 0 { _ -> b6() } }
    state b6(){ write_byte(32);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(119); transition 0 { _ -> b8() } }
    state b8(){ write_byte(48);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(44);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(32);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(91);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(120); transition 0 { _ -> bd() } }
    state bd(){ write_byte(57);  transition 0 { _ -> be() } }
    state be(){ write_byte(44);  transition 0 { _ -> bf() } }
    state bf(){ write_byte(32);  transition 0 { _ -> bg() } }
    state bg(){ write_byte(35); }
}
machine Main::main(&mut self) {
    self.off = 0;
    transition 0 { _ -> rd() }
    state rd()   { self.c = read_byte(); transition self.c < 0 { true -> emit()  false -> dg() } }
    state dg()   { transition self.c < 48 { true -> rd()  false -> dg2() } }
    state dg2()  { transition self.c > 57 { true -> rd()  false -> acc() } }
    state acc()  { self.off = self.off * 10 + self.c - 48; transition 0 { _ -> rd() } }
    state emit()  { self.console.write_line("    ldr x0, [sp], #16"); self.console.write_line("    ldr x9, [x29, #16]"); self.p_strw0(); self.v = self.off; self.emit_int(); write_byte(93); write_byte(10); transition 0 { _ -> done() } }
    state done()  { self.console.exit_process(0) }
}
