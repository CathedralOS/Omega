// CERTIFYING COMPUTATION: variable-length INDUCTIVE-PREDICATE proof. certify-member proves membership in a
// fixed 4-element list; this reads `x` followed by a list of ANY length, finds x, and certifies
// `Mem(x, list)` (Rel 777, the inductive predicate behind the FTA) by CONSTRUCTING the proof at runtime --
// a `memtail` chain (one link per element skipped) ending in a `memhead`, its length scaling with x's
// position:
//   goal   (Rel 777 x (cons a0 (cons a1 ... nil)))
//   proof  (memtail a0 (memtail a1 ... (memhead x <rest>)))
// `memhead x rest` proves x is the head of `cons x rest`; `memtail a p` lifts a membership proof past a
// skipped head a. So the trust anchor walks the same inductive structure the program built, over an
// arbitrarily long list. The first input number is x; the rest is the list (x must occur in it).
//   printf '5 9 4 5 1' | certify-member-any | check.exe  ->  accept   (5 is in [9 4 5 1])
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    vals: [i32; 16]; vn: i32; cur: i32; inb: i32; uv: i32;
    j: i32; mi: i32; ci: i32; li: i32; lc: i32;   // j = x's index in vals; mi/ci proof loops; li/lc list loops
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// emit the cons-list of vals[lo .. hi-1]: (cons vals[lo] (cons vals[lo+1] ... nil))
machine Main::emit_clist(&mut self, lo: i32, hi: i32) {
    self.li = lo;
    transition 0 { _ -> clw() }
    state clw()    { transition self.li < hi { true -> clc()  false -> clnil() } }
    state clc()    { write_line("(cons"); self.emit_nat(self.vals[self.li]); self.li = self.li + 1; transition 0 { _ -> clw() } }
    state clnil()  { write_line("nil"); self.lc = lo; transition 0 { _ -> clcl() } }
    state clcl()   { transition self.lc < hi { true -> clcw()  false -> cldone() } }
    state clcw()   { write_byte(41); self.lc = self.lc + 1; transition 0 { _ -> clcl() } }
    state cldone() {}
}
machine Main::main(&mut self) {
    self.n = 0; self.vn = 0; self.cur = 0; self.inb = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> pp()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state pp()    { self.pos = 0; transition 0 { _ -> pscan() } }
    state pscan() { transition self.pos < self.n { true -> pc()  false -> pend() } }
    state pc()    { transition self.buf[self.pos] < 48 { true -> psep()  false -> pcHi() } }
    state pcHi()  { transition self.buf[self.pos] > 57 { true -> psep()  false -> pdig() } }
    state pdig()  { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.inb = 1; self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state psep()  { transition self.inb == 1 { true -> pstore()  false -> padv() } }
    state pstore(){ self.vals[self.vn] = self.cur; self.vn = self.vn + 1; self.cur = 0; self.inb = 0; transition 0 { _ -> padv() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state pend()  { transition self.inb == 1 { true -> pendS()  false -> findx() } }
    state pendS() { self.vals[self.vn] = self.cur; self.vn = self.vn + 1; transition 0 { _ -> findx() } }
    // find x = vals[0] in the list vals[1..vn-1]; j = its index (first occurrence; x assumed present)
    state findx() { self.j = 1; transition 0 { _ -> floop() } }
    state floop() { transition self.j < self.vn { true -> fchk()  false -> emit() } }
    state fchk()  { transition self.vals[self.j] == self.vals[0] { true -> emit()  false -> fadv() } }
    state fadv()  { self.j = self.j + 1; transition 0 { _ -> floop() } }
    state emit()  {
        // goal: (Rel 777 x (cons a0 (cons a1 ... nil)))
        write_line("(Rel 777"); self.emit_nat(self.vals[0]); self.emit_clist(1, self.vn); write_line(")");
        // proof: memtail chain over vals[1 .. j-1], then memhead x <rest = vals[j+1 .. vn-1]>
        self.mi = 1; transition 0 { _ -> mloop() }
    }
    state mloop() { transition self.mi < self.j { true -> mw()  false -> mhead() } }
    state mw()    { write_line("(memtail"); self.emit_nat(self.vals[self.mi]); self.mi = self.mi + 1; transition 0 { _ -> mloop() } }
    state mhead() { write_line("(memhead"); self.emit_nat(self.vals[0]); self.emit_clist(self.j + 1, self.vn); write_line(")"); self.ci = 1; transition 0 { _ -> mclose() } }
    state mclose(){ transition self.ci < self.j { true -> mcw()  false -> fin() } }
    state mcw()   { write_byte(41); self.ci = self.ci + 1; transition 0 { _ -> mclose() } }
    state fin()   { self.console.exit_process(0) }
}
