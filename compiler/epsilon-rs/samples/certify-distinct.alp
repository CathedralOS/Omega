// CERTIFYING COMPUTATION — a NEGATIVE fact (a refutation). Every prior certifier proves a
// POSITIVE proposition (an equality, ordering, existential, membership). This one proves
// an INEQUALITY, x != y, i.e. (= x y) -> bot — the producer must refute, not exhibit. It
// reads two distinct numbers x and y, finds where they differ, and emits:
//   proposition  (-> (= X Y) (bot))
//   proof        (lam (= X Y) (disj (sinj (sinj ... (hyp 0)))))   -- d = min(x,y) sinj's
// Each `sinj` peels a successor off both sides (s a = s b -> a = b, injectivity); after
// min(x,y) of them one side is z and the other is (s _), and `disj` (0 != s _, no-
// confusion) derives bot. The trust anchor accepts only because injectivity + no-confusion
// are sound -- the program proves two numbers are genuinely unequal, machine-checked.
//   printf '3 5' | certify-distinct | check.exe  ->  accept   (3 != 5: 3 sinj, then z != s s)
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    dx: i32; dy: i32; dd: i32; uv: i32; sv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// emit  (sinj (sinj ... (hyp 0)))  with `d` sinj's wrapping the hypothesis
machine Main::emit_sinj(&mut self, d: i32) {
    self.sv = d;
    transition 0 { _ -> so() }
    state so()  { transition self.sv == 0 { true -> sh()  false -> so2() } }
    state so2() { write_line("(sinj"); self.sv = self.sv - 1; transition 0 { _ -> so() } }
    state sh()  { write_line("(hyp 0)"); self.sv = d; transition 0 { _ -> sc() } }
    state sc()  { transition self.sv == 0 { true -> sd()  false -> sc2() } }
    state sc2() { write_byte(41); self.sv = self.sv - 1; transition 0 { _ -> sc() } }
    state sd()  {}
}
machine Main::main(&mut self) {
    self.n = 0; self.dx = 0; self.dy = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> pa() } }
    state pa()    { transition self.buf[self.pos] < 48 { true -> skipnd()  false -> paHi() } }
    state paHi()  { transition self.buf[self.pos] > 57 { true -> skipnd()  false -> paD() } }
    state paD()   { self.dx = self.dx * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pa() } }
    state skipnd(){ transition self.pos < self.n { true -> snd()  false -> compute() } }
    state snd()   { transition self.buf[self.pos] < 48 { true -> snda()  false -> sndHi() } }
    state sndHi() { transition self.buf[self.pos] > 57 { true -> snda()  false -> pb() } }
    state snda()  { self.pos = self.pos + 1; transition 0 { _ -> skipnd() } }
    state pb()    { transition self.buf[self.pos] < 48 { true -> compute()  false -> pbHi() } }
    state pbHi()  { transition self.buf[self.pos] > 57 { true -> compute()  false -> pbD() } }
    state pbD()   { self.dy = self.dy * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pb() } }
    // d = min(x, y) -- the number of successors common to both, peeled by sinj
    state compute(){ transition self.dx < self.dy { true -> dmx()  false -> dmy() } }
    state dmx()   { self.dd = self.dx; transition 0 { _ -> emit() } }
    state dmy()   { self.dd = self.dy; transition 0 { _ -> emit() } }
    state emit() {
        // proposition: (-> (= X Y) (bot))
        write_line("(->  (=");
        self.emit_nat(self.dx);
        self.emit_nat(self.dy);
        write_line(") (bot))");
        // proof: (lam (= X Y) (disj <d sinj's> (hyp 0)))
        write_line("(lam (=");
        self.emit_nat(self.dx);
        self.emit_nat(self.dy);
        write_line(") (disj");
        self.emit_sinj(self.dd);
        write_line("))");
        self.console.exit_process(0)
    }
}
