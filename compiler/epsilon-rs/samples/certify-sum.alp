// CERTIFYING COMPUTATION over a USER-DEFINED FUNCTION. Every prior certifier reduces only
// builtins (s/p/m, cons, Mem...). This one ships a recursive function definition and proves
// a fact about it — the checker must REDUCE the user function during validation, the same
// fun/rec machinery behind the reverse/sum/map theorems, now exercised through the
// convergence. It reads a 3-element list and certifies that a user `sum` over a user list
// equals the elements added up:
//   defs   (data 2 0 0 0) (data 3 2 0 1)            -- a list ADT: nil (cid 2), cons (cid 3)
//          (fun 9 2 z) (fun 9 3 (p (v 0) (rec 1)))  -- sum nil = 0; sum (h::t) = h + sum t
//   proposition  (= (f 9 (k 3 A (k 3 B (k 3 C (k 2))))) (p A (p B (p C z))))
//   proof        (refl (p A (p B (p C z))))
// The trust anchor reduces (f 9 list) by the fun rules to A+B+C and checks it equals the
// symbolic sum -- the program asserts the list, the checker runs the user function.
//   printf '2 3 5' | certify-sum | check.exe  ->  accept   (sum [2 3 5] = 10)
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    vals: [i32; 8]; vn: i32; cur: i32; inb: i32; uv: i32;
    a: i32; b: i32; d: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// emit the symbolic sum  (p A (p B (p C z)))
machine Main::emit_sum(&mut self) {
    write_line("(p");
    self.emit_nat(self.a);
    write_line("(p");
    self.emit_nat(self.b);
    write_line("(p");
    self.emit_nat(self.d);
    write_line("z)))");
}
machine Main::main(&mut self) {
    self.n = 0; self.vn = 0; self.cur = 0; self.inb = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> pp()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state pp()    { self.pos = 0; transition 0 { _ -> pscan() } }
    state pscan() { transition self.pos < self.n { true -> pc()  false -> pend() } }
    state pc()    { transition self.buf[self.pos] < 48 { true -> psep()  false -> pcHi() } }
    state pcHi()  { transition self.buf[self.pos] > 57 { true -> psep()  false -> pdig() } }
    state pdig()  { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.inb = 1; self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state psep()  { transition self.inb == 1 { true -> pstore()  false -> padv() } }
    state pstore(){ self.vals[self.vn] = self.cur; self.vn = self.vn + 1; self.cur = 0; self.inb = 0; transition 0 { _ -> padv() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state pend()  { transition self.inb == 1 { true -> pendS()  false -> pick() } }
    state pendS() { self.vals[self.vn] = self.cur; self.vn = self.vn + 1; transition 0 { _ -> pick() } }
    state pick()  { self.a = self.vals[0]; self.b = self.vals[1]; self.d = self.vals[2]; transition 0 { _ -> emit() } }
    state emit() {
        // the user list ADT + the recursive sum function
        write_line("(data 2 0 0 0) (data 3 2 0 1) (fun 9 2 z) (fun 9 3 (p (v 0) (rec 1)))");
        // proposition: (= (f 9 (k 3 A (k 3 B (k 3 C (k 2))))) <symbolic sum>)
        write_line("(= (f 9 (k 3");
        self.emit_nat(self.a);
        write_line("(k 3");
        self.emit_nat(self.b);
        write_line("(k 3");
        self.emit_nat(self.d);
        write_line("(k 2)))))");
        self.emit_sum();
        write_line(")");
        // proof: (refl <symbolic sum>)
        write_line("(refl");
        self.emit_sum();
        write_line(")");
        self.console.exit_process(0)
    }
}
