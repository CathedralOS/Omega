// CERTIFYING COMPUTATION: a verified 3-element SORT. The full correctness of a sort is two claims --
// the output is ORDERED and it is a PERMUTATION of the input -- and this certifies BOTH for three
// elements (certify-sort2 did two via a 2-way disjunction; three needs the Perm inductive predicate,
// since a 6-way disjunction does not scale). It reads a, b, c, outputs (x, y, z) = sorted, and emits:
//   goal   (& (Exists x<=y) (& (Exists y<=z) (Rel 779 [a b c] [x y z])))
//   proof  (pair <x<=y wit> (pair <y<=z wit> <perm>))
// The permutation proof tracks a 3-compare-swap BUBBLE NETWORK (positions (0,1)(1,2)(0,1)) and composes
// one perm step per compare-swap via permtrans: a swap at adjacent positions is a permswap (with a
// permskip prefix to reach the position); no swap is the identity permutation (a permskip chain). So the
// trust anchor confirms the program SORTED its input -- ordered AND a genuine rearrangement of the same
// elements -- functional correctness of a real algorithm, not just an arithmetic result.
//   printf '3 1 2' | certify-sort3 | check.exe  ->  accept   ((1,2,3) sorts (3,1,2))
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    vals: [i32; 8]; vn: i32; cur: i32; inb: i32; uv: i32;
    a: i32; b: i32; d: i32;          // the input elements
    mn: i32; md: i32; mx: i32;       // sorted output (min, mid, max)
    g1: i32; g2: i32;                // order gaps: md-mn, mx-md
    l0: i32; l1: i32; l2: i32; tmp: i32;  // the bubble-network working list
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// (cons l0 (cons l1 (cons l2 nil)))  -- the current working list
machine Main::emit_l012(&mut self) {
    write_line("(cons"); self.emit_nat(self.l0);
    write_line("(cons"); self.emit_nat(self.l1);
    write_line("(cons"); self.emit_nat(self.l2);
    write_line("nil)))");
}
// identity permutation over the working list: (permskip l0 (permskip l1 (permskip l2 (permnil))))
machine Main::emit_idperm(&mut self) {
    write_line("(permskip"); self.emit_nat(self.l0);
    write_line("(permskip"); self.emit_nat(self.l1);
    write_line("(permskip"); self.emit_nat(self.l2);
    write_line("(permnil))))");
}
machine Main::main(&mut self) {
    self.n = 0; self.vn = 0; self.cur = 0; self.inb = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> pp()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state pp()    { self.pos = 0; transition 0 { _ -> pscan() } }
    state pscan() { transition self.pos < self.n { true -> pc()  false -> pend() } }
    state pc()    { transition self.buf[self.pos] < 48 { true -> psep()  false -> pcHi() } }
    state pcHi()  { transition self.buf[self.pos] > 57 { true -> psep()  false -> pdig() } }
    state pdig()  { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.inb = 1; self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state psep()  { transition self.inb == 1 { true -> pstore()  false -> padv() } }
    state pstore(){ self.vals[self.vn] = self.cur; self.vn = self.vn + 1; self.cur = 0; self.inb = 0; transition 0 { _ -> padv() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state pend()  { transition self.inb == 1 { true -> pendS()  false -> pick() } }
    state pendS() { self.vals[self.vn] = self.cur; self.vn = self.vn + 1; transition 0 { _ -> pick() } }
    state pick()  { self.a = self.vals[0]; self.b = self.vals[1]; self.d = self.vals[2]; transition 0 { _ -> mnI() } }
    // min = mn
    state mnI()   { self.mn = self.a; transition self.b < self.mn { true -> mnB()  false -> mnC() } }
    state mnB()   { self.mn = self.b; transition 0 { _ -> mnC() } }
    state mnC()   { transition self.d < self.mn { true -> mnD()  false -> mxI() } }
    state mnD()   { self.mn = self.d; transition 0 { _ -> mxI() } }
    // max = mx
    state mxI()   { self.mx = self.a; transition self.b > self.mx { true -> mxB()  false -> mxC() } }
    state mxB()   { self.mx = self.b; transition 0 { _ -> mxC() } }
    state mxC()   { transition self.d > self.mx { true -> mxD()  false -> midC() } }
    state mxD()   { self.mx = self.d; transition 0 { _ -> midC() } }
    // mid = a+b+c-min-max ; gaps
    state midC()  { self.md = self.a + self.b + self.d - self.mn - self.mx; self.g1 = self.md - self.mn; self.g2 = self.mx - self.md; transition 0 { _ -> emit() } }
    state emit()  {
        // goal: (& (Exists (= (p x (v 0)) y)) (& (Exists (= (p y (v 0)) z)) (Rel 779 [a b c] [x y z])))
        write_line("(& (Exists (= (p"); self.emit_nat(self.mn); write_line("(v 0))"); self.emit_nat(self.md); write_line(")) (& (Exists (= (p"); self.emit_nat(self.md); write_line("(v 0))"); self.emit_nat(self.mx); write_line(")) (Rel 779");
        // input list [a b c]
        self.l0 = self.a; self.l1 = self.b; self.l2 = self.d; self.emit_l012();
        // sorted list [x y z]
        self.l0 = self.mn; self.l1 = self.md; self.l2 = self.mx; self.emit_l012();
        write_line(")))");   // close Rel, inner &, outer &
        // proof: (pair <x<=y wit> (pair <y<=z wit> <perm>))
        write_line("(pair (wit (= (p"); self.emit_nat(self.mn); write_line("(v 0))"); self.emit_nat(self.md); write_line(")"); self.emit_nat(self.g1); write_line("(refl"); self.emit_nat(self.md); write_line(")) (pair (wit (= (p"); self.emit_nat(self.md); write_line("(v 0))"); self.emit_nat(self.mx); write_line(")"); self.emit_nat(self.g2); write_line("(refl"); self.emit_nat(self.mx); write_line("))");
        // perm = (permtrans s1 (permtrans s2 s3)); reset the working list to the input and re-run the network
        self.l0 = self.a; self.l1 = self.b; self.l2 = self.d;
        write_line("(permtrans");
        transition 0 { _ -> s1() }
    }
    // step 1: compare positions 0,1
    state s1()    { transition self.l0 > self.l1 { true -> s1sw()  false -> s1id() } }
    state s1sw()  { write_line("(permswap"); self.emit_nat(self.l0); self.emit_nat(self.l1); write_line("(cons"); self.emit_nat(self.l2); write_line("nil))"); self.tmp = self.l0; self.l0 = self.l1; self.l1 = self.tmp; transition 0 { _ -> s2pre() } }
    state s1id()  { self.emit_idperm(); transition 0 { _ -> s2pre() } }
    state s2pre() { write_line("(permtrans"); transition 0 { _ -> s2() } }
    // step 2: compare positions 1,2
    state s2()    { transition self.l1 > self.l2 { true -> s2sw()  false -> s2id() } }
    state s2sw()  { write_line("(permskip"); self.emit_nat(self.l0); write_line("(permswap"); self.emit_nat(self.l1); self.emit_nat(self.l2); write_line("nil))"); self.tmp = self.l1; self.l1 = self.l2; self.l2 = self.tmp; transition 0 { _ -> s3() } }
    state s2id()  { self.emit_idperm(); transition 0 { _ -> s3() } }
    // step 3: compare positions 0,1
    state s3()    { transition self.l0 > self.l1 { true -> s3sw()  false -> s3id() } }
    state s3sw()  { write_line("(permswap"); self.emit_nat(self.l0); self.emit_nat(self.l1); write_line("(cons"); self.emit_nat(self.l2); write_line("nil))"); transition 0 { _ -> fin() } }
    state s3id()  { self.emit_idperm(); transition 0 { _ -> fin() } }
    state fin()   { write_line("))))"); self.console.exit_process(0) }
}
