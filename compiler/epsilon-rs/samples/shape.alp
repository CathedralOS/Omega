// Multi-field payload variants — the shape of Omega's shape_area. An enum's variants may
// carry different numbers of i32 payload fields; the enum is sized to the WIDEST variant
// (here Rectangle's 2 fields -> 8 tag + 16 payload = 24 bytes), and each variant's fields
// live at offset + 8, + 16, ... Construction passes one value per field; a match arm
// `Rectangle { w, h } -> area(w * h)` binds each field (a read of the subject at its
// offset) and passes the result as a state argument. Here Rectangle(6, 7) -> 6*7 = 42.
boundary trait Console { machine exit_process(return_code: i32); }
data Shape { case Circle(r: i32); case Rectangle(w: i32, h: i32); }
data Main { console: Console; sh: Shape; }
machine Main::main(&mut self) {
    self.sh = Shape::Rectangle(6, 7);
    transition self.sh {
        Shape::Circle { r } -> area(r * r * 3)
        Shape::Rectangle { w, h } -> area(w * h)
    }
    state area(v: i32) {
        self.console.exit_process(v)
    }
}
