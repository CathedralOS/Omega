// SELF-HOSTING step: member name resolution. The state checks resolve transition
// labels; this resolves FIELD accesses. Every `self.X` (a data-field read/write -- NOT
// a method call `self.m(...)`) must name a declared field. A typo like `self.bufx` is
// reported. Sound + simple: collect every `name:` (data fields; the set also includes
// machine params, harmless because a `self.X` only ever names a field), then check each
// `self.X` against it. `self.m(` (immediately followed by `(`) is a method call and is
// skipped. Reports unknown fields one per line, exit 1; clean exits 0.
//   printf 'data M{ x:i32; } machine A::a(&mut self){ state s(){ self.y=1; } }' | fieldcheck
//     -> prints y, exit 1   (no field `y`)
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    n: i32; pos: i32; c: i32; start: i32; w: i32; pend: i32; nn: i32; na: i32;
    ci: i32; cj: i32; found: i32; bad: i32; ei: i32; qa: i32; qb: i32; qc: i32; qd: i32; qk: i32;
    ns: [i32; 512]; ne: [i32; 512];     // declared `name:` names  [start,end)
    xs: [i32; 512]; xe: [i32; 512];     // self.X accesses
    buf: [u8; 16384];
}
machine Main::is_word(&mut self, c: i32) -> i32 {
    transition c == 95 { true -> yes()  false -> w1() }
    state w1() { transition c < 48  { true -> no()  false -> w2() } }
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }
    state w3() { transition c < 65  { true -> no()  false -> w4() } }
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }
    state w5() { transition c < 97  { true -> no()  false -> w6() } }
    state w6() { transition c <= 122 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::is_self(&mut self, s: i32, e: i32) -> i32 {      // "self" = 115 101 108 102
    transition e - s == 4 { true -> s0()  false -> sno() }
    state s0() { transition self.buf[s]     == 115 { true -> s1()  false -> sno() } }
    state s1() { transition self.buf[s + 1] == 101 { true -> s2()  false -> sno() } }
    state s2() { transition self.buf[s + 2] == 108 { true -> s3()  false -> sno() } }
    state s3() { transition self.buf[s + 3] == 102 { true -> syes() false -> sno() } }
    state syes() { return 1; }
    state sno()  { return 0; }
}
machine Main::streq(&mut self) -> i32 {
    transition self.qb - self.qa == self.qd - self.qc { true -> sq0()  false -> sqno() }
    state sq0()  { self.qk = 0; transition 0 { _ -> sloop() } }
    state sloop(){ transition self.qa + self.qk < self.qb { true -> scmp()  false -> sqyes() } }
    state scmp() { transition self.buf[self.qa + self.qk] == self.buf[self.qc + self.qk] { true -> sadv()  false -> sqno() } }
    state sadv() { self.qk = self.qk + 1; transition 0 { _ -> sloop() } }
    state sqyes()  { return 1; }
    state sqno()   { return 0; }
}
machine Main::emit_range(&mut self, a: i32, b: i32) {
    self.ei = a;
    transition 0 { _ -> el() }
    state el() { transition self.ei < b { true -> ew()  false -> enl() } }
    state ew() { write_byte(self.buf[self.ei]); self.ei = self.ei + 1; transition 0 { _ -> el() } }
    state enl(){ write_byte(10); }
}
machine Main::main(&mut self) {
    self.n = 0; self.nn = 0; self.na = 0; self.pend = 0; self.bad = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { transition self.n < 16384 { true -> store2()  false -> rd() } }
    state store2(){ self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state scan()    { self.pos = 0; transition 0 { _ -> sk() } }
    state sk()      { transition self.pos < self.n { true -> ws()  false -> xcheck() } }
    state ws()      { transition self.buf[self.pos] <= 32 { true -> wadv()  false -> commck() } }
    state wadv()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state commck()  { transition self.buf[self.pos] == 47 { true -> commck2()  false -> strck() } }
    state commck2() { transition self.buf[self.pos + 1] == 47 { true -> skipc()  false -> strck() } }
    state skipc()   { transition self.pos < self.n { true -> cnl()  false -> xcheck() } }
    state cnl()     { transition self.buf[self.pos] == 10 { true -> wadv()  false -> cadv() } }
    state cadv()    { self.pos = self.pos + 1; transition 0 { _ -> skipc() } }
    state strck()   { transition self.buf[self.pos] == 34 { true -> stradv()  false -> tok() } }
    state stradv()  { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    state ss()      { transition self.pos < self.n { true -> ss2()  false -> xcheck() } }
    state ss2()     { transition self.buf[self.pos] == 34 { true -> wadv()  false -> ssa() } }
    state ssa()     { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    state tok()     { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word()  false -> punc() } }
    state punc()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state word()    { self.start = self.pos; transition 0 { _ -> wrun() } }
    state wrun()    { transition self.pos < self.n { true -> wrck()  false -> wclass() } }
    state wrck()    { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wradv()  false -> wclass() } }
    state wradv()   { self.pos = self.pos + 1; transition 0 { _ -> wrun() } }
    // classify: `self` (opens an access), the access word, or a `name:` declaration
    state wclass()  { transition self.pend == 3 { true -> doAcc()  false -> ckSelf() } }
    state ckSelf()  { self.w = self.is_self(self.start, self.pos); transition self.w == 1 { true -> selfDot()  false -> ckColon() } }
    state selfDot() { transition self.buf[self.pos] == 46 { true -> openAcc()  false -> sk() } }     // `self` then '.'
    state openAcc() { self.pend = 3; self.pos = self.pos + 1; transition 0 { _ -> sk() } }            // next word is self.X
    state doAcc()   { self.pend = 0; transition self.buf[self.pos] == 40 { true -> sk()  false -> accCap() } } // self.m( -> method, skip
    state accCap()  { transition self.na < 512 { true -> addAcc()  false -> sk() } }
    state addAcc()  { self.xs[self.na] = self.start; self.xe[self.na] = self.pos; self.na = self.na + 1; transition 0 { _ -> sk() } }
    state ckColon() { transition self.buf[self.pos] == 58 { true -> nmCap()  false -> sk() } }        // word ':' -> a declared name
    state nmCap()   { transition self.nn < 512 { true -> addNm()  false -> sk() } }
    state addNm()   { self.ns[self.nn] = self.start; self.ne[self.nn] = self.pos; self.nn = self.nn + 1; transition 0 { _ -> sk() } }
    // ---- each self.X access must match a declared name ----
    state xcheck()  { self.ci = 0; transition 0 { _ -> il() } }
    state il()      { transition self.ci < self.na { true -> jset()  false -> report() } }
    state jset()    { self.cj = 0; self.found = 0; self.qa = self.xs[self.ci]; self.qb = self.xe[self.ci]; transition 0 { _ -> jl() } }
    state jl()      { transition self.cj < self.nn { true -> jeq()  false -> idone() } }
    state jeq()     { self.qc = self.ns[self.cj]; self.qd = self.ne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> jfound()  false -> jnext() } }
    state jfound()  { self.found = 1; transition 0 { _ -> idone() } }
    state jnext()   { self.cj = self.cj + 1; transition 0 { _ -> jl() } }
    state idone()   { transition self.found == 0 { true -> unk()  false -> inext() } }
    state unk()     { self.bad = 1; self.emit_range(self.xs[self.ci], self.xe[self.ci]); transition 0 { _ -> inext() } }
    state inext()   { self.ci = self.ci + 1; transition 0 { _ -> il() } }
    state report()  { transition self.bad == 1 { true -> fail()  false -> ok() } }
    state fail()    { self.console.exit_process(1) }
    state ok()      { self.console.exit_process(0) }
}
