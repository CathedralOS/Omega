// SELF-HOSTING / CODEGEN: the machine FRAME -- the prologue + trailing default + epilogue
// that wrap a machine body, exactly as the backend's lower_machine (src/aarch64.rs) for the
// ENTRY machine (`_main`, &mut self, 0 value params -- i.e. Main::main). Given the body's
// local_count it emits:
//     _main:
//       sub sp, sp, #frame              frame = align16(16 + 8*local_count + 8) (self slot)
//       stp x29, x30, [sp] / mov x29, sp
//       adrp x9, _selfdata@PAGE / add x9, x9, _selfdata@PAGEOFF / str x9, [x29, #self_disp]
//       <body goes here>                self_disp = 16 + 8*local_count
//       mov w0, #0                      trailing default (fall-through return 0)
//       mov sp, x29 / ldp x29, x30, [sp] / add sp, sp, #frame / ret    (epilogue)
// align16(n) = ((n+15)/16)*16 -- no bitwise & in .alp. Ties the layout's frame size into codegen.
//   printf '0' | scaffold   -> frame 32, self_disp 16 (a local-free Main::main)
//   printf '2' | scaffold   -> frame 48, self_disp 32
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    c: i32; lc: i32; frame: i32; sd: i32; v: i32; di: i32; ek: i32;
    dig: [i32; 16];
}
machine Main::emit_int(&mut self) {
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::p_subsp(&mut self) {       // "    sub sp, sp, #"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(115); transition 0 { _ -> b4() } }
    state b4(){ write_byte(117); transition 0 { _ -> b5() } }
    state b5(){ write_byte(98);  transition 0 { _ -> b6() } }
    state b6(){ write_byte(32);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(115); transition 0 { _ -> b8() } }
    state b8(){ write_byte(112); transition 0 { _ -> b9() } }
    state b9(){ write_byte(44);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(32);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(115); transition 0 { _ -> bc() } }
    state bc(){ write_byte(112); transition 0 { _ -> bd() } }
    state bd(){ write_byte(44);  transition 0 { _ -> be() } }
    state be(){ write_byte(32);  transition 0 { _ -> bf() } }
    state bf(){ write_byte(35); }
}
machine Main::p_addsp(&mut self) {       // "    add sp, sp, #"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(97);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(100); transition 0 { _ -> b5() } }
    state b5(){ write_byte(100); transition 0 { _ -> b6() } }
    state b6(){ write_byte(32);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(115); transition 0 { _ -> b8() } }
    state b8(){ write_byte(112); transition 0 { _ -> b9() } }
    state b9(){ write_byte(44);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(32);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(115); transition 0 { _ -> bc() } }
    state bc(){ write_byte(112); transition 0 { _ -> bd() } }
    state bd(){ write_byte(44);  transition 0 { _ -> be() } }
    state be(){ write_byte(32);  transition 0 { _ -> bf() } }
    state bf(){ write_byte(35); }
}
machine Main::p_strx9(&mut self) {       // "    str x9, [x29, #"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(115); transition 0 { _ -> b4() } }
    state b4(){ write_byte(116); transition 0 { _ -> b5() } }
    state b5(){ write_byte(114); transition 0 { _ -> b6() } }
    state b6(){ write_byte(32);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(120); transition 0 { _ -> b8() } }
    state b8(){ write_byte(57);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(44);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(32);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(91);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(120); transition 0 { _ -> bd() } }
    state bd(){ write_byte(50);  transition 0 { _ -> be() } }
    state be(){ write_byte(57);  transition 0 { _ -> bf() } }
    state bf(){ write_byte(44);  transition 0 { _ -> bg() } }
    state bg(){ write_byte(32);  transition 0 { _ -> bh() } }
    state bh(){ write_byte(35); }
}
machine Main::main(&mut self) {
    self.lc = 0;
    transition 0 { _ -> rd() }
    state rd()   { self.c = read_byte(); transition self.c < 0 { true -> comp()  false -> dg() } }
    state dg()   { transition self.c < 48 { true -> rd()  false -> dg2() } }
    state dg2()  { transition self.c > 57 { true -> rd()  false -> acc() } }
    state acc()  { self.lc = self.lc * 10 + self.c - 48; transition 0 { _ -> rd() } }
    state comp() { self.sd = 16 + 8 * self.lc; self.frame = (16 + 8 * self.lc + 8 + 15) / 16 * 16; transition 0 { _ -> emit() } }
    state emit()  {
        self.console.write_line("_main:");
        self.p_subsp(); self.v = self.frame; self.emit_int(); write_byte(10);
        self.console.write_line("    stp x29, x30, [sp]");
        self.console.write_line("    mov x29, sp");
        self.console.write_line("    adrp x9, _selfdata@PAGE");
        self.console.write_line("    add x9, x9, _selfdata@PAGEOFF");
        self.p_strx9(); self.v = self.sd; self.emit_int(); write_byte(93); write_byte(10);
        self.console.write_line("    mov w0, #0");
        self.console.write_line("    mov sp, x29");
        self.console.write_line("    ldp x29, x30, [sp]");
        self.p_addsp(); self.v = self.frame; self.emit_int(); write_byte(10);
        self.console.write_line("    ret")
    }
}
