// SELF-HOSTING / CODEGEN (expression arc): infix -> RPN (postfix) for .alp expressions,
// by shunting-yard. RPN is exactly the order the backend's recursive stack-machine lowering
// visits operands and operators (lower lhs, lower rhs, apply op = post-order = RPN), so this
// linearizes an expression into the sequence a codegen emits -- iteratively, no recursion.
// Atoms: int literals, locals (idents), self.field, and ARRAY INDEX self.buf[expr] (the
// index is a nested sub-expression; in RPN the index's tokens come first, then a
// `self.buf[]` indexed-load token -- the backend's SelfIndex order). Operators by precedence
// * / (3) > + - (2) > comparisons < <= == > >= != (1), left-associative. (Calls self.f(x)
// are deferred -- those belong to statement lowering, not transition subjects.)
//   printf 'self.buf[self.pos + 1] == 47' | rpn  ->  self.pos / 1 / + / self.buf[] / 47 / ==
//   printf 'e - s == 5'                   | rpn  ->  e / s / - / 5 / ==
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    n: i32; pos: i32; c: i32; start: i32; w: i32; curp: i32; curl: i32; sp: i32; ek: i32;
    ostart: [i32; 128]; oend: [i32; 128]; oprec: [i32; 128]; obrk: [i32; 128];
    buf: [u8; 16384];
}
machine Main::is_word(&mut self, c: i32) -> i32 {
    transition c == 95 { true -> yes()  false -> w1() }
    state w1() { transition c < 48  { true -> no()  false -> w2() } }
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }
    state w3() { transition c < 65  { true -> no()  false -> w4() } }
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }
    state w5() { transition c < 97  { true -> no()  false -> w6() } }
    state w6() { transition c <= 122 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::emit_tok(&mut self, a: i32, b: i32) {     // buf[a..b) then newline
    self.ek = a;
    transition 0 { _ -> el() }
    state el() { transition self.ek < b { true -> ew()  false -> nl() } }
    state ew() { write_byte(self.buf[self.ek]); self.ek = self.ek + 1; transition 0 { _ -> el() } }
    state nl() { write_byte(10); }
}
machine Main::emit_idx(&mut self, a: i32, b: i32) {      // buf[a..b) then "[]" then newline
    self.ek = a;
    transition 0 { _ -> il() }
    state il() { transition self.ek < b { true -> iw()  false -> ib() } }
    state iw() { write_byte(self.buf[self.ek]); self.ek = self.ek + 1; transition 0 { _ -> il() } }
    state ib() { write_byte(91); transition 0 { _ -> ib2() } }
    state ib2(){ write_byte(93); transition 0 { _ -> ib3() } }
    state ib3(){ write_byte(10); }
}
machine Main::main(&mut self) {
    self.n = 0; self.sp = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { transition self.n < 16384 { true -> store2()  false -> rd() } }
    state store2(){ self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state scan()  { self.pos = 0; transition 0 { _ -> sk() } }
    state sk()    { transition self.pos < self.n { true -> ws()  false -> flush() } }
    state ws()    { transition self.buf[self.pos] <= 32 { true -> wadv()  false -> tok() } }
    state wadv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state tok()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> atom()  false -> op() } }
    // operand: a word, optionally extended by `.field`; may be followed by `[index]`
    state atom()  { self.start = self.pos; transition 0 { _ -> arun() } }
    state arun()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> aadv()  false -> adot() } }
    state aadv()  { self.pos = self.pos + 1; transition 0 { _ -> arun() } }
    state adot()  { transition self.buf[self.pos] == 46 { true -> aext()  false -> abrk() } }   // '.'
    state aext()  { self.pos = self.pos + 1; transition 0 { _ -> arun2() } }
    state arun2() { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> aadv2()  false -> abrk() } }
    state aadv2() { self.pos = self.pos + 1; transition 0 { _ -> arun2() } }
    state abrk()  { transition self.buf[self.pos] == 91 { true -> pushIdx()  false -> aemit() } } // '[' -> array index
    state pushIdx(){ self.ostart[self.sp] = self.start; self.oend[self.sp] = self.pos; self.oprec[self.sp] = 0 - 1; self.obrk[self.sp] = 1; self.sp = self.sp + 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } } // hold base; oprec -1 so NO operator (incl. prec-0 bit ops) pops past it
    state aemit() { self.emit_tok(self.start, self.pos); transition 0 { _ -> sk() } }            // plain operand -> output now
    // operator (or ']'): classify precedence + length, then shunting-yard
    state op()    { transition self.buf[self.pos] == 93 { true -> rbrk()  false -> opc() } }     // ']' -> close an index
    state opc()   { transition self.buf[self.pos] == 42 { true -> p3()  false -> op2() } }       // '*'
    state op2()   { transition self.buf[self.pos] == 47 { true -> p3()  false -> op3() } }       // '/'
    state op3()   { transition self.buf[self.pos] == 43 { true -> p2()  false -> op4() } }       // '+'
    state op4()   { transition self.buf[self.pos] == 45 { true -> p2()  false -> op5() } }       // '-'
    state op5()   { transition self.buf[self.pos] == 60 { true -> p1m()  false -> op6() } }      // '<'
    state op6()   { transition self.buf[self.pos] == 62 { true -> p1m()  false -> op7() } }      // '>'
    state op7()   { transition self.buf[self.pos] == 61 { true -> p1two()  false -> op8() } }    // '=' (==)
    state op8()   { transition self.buf[self.pos] == 33 { true -> p1two()  false -> opm() } }    // '!' (!=)
    state opm()   { transition self.buf[self.pos] == 37  { true -> p3()  false -> opand() } }    // '%' (prec 3, with * /)
    state opand() { transition self.buf[self.pos] == 38  { true -> p0()  false -> opor() } }     // '&' (prec 0)
    state opor()  { transition self.buf[self.pos] == 124 { true -> p0()  false -> opxor() } }    // '|' (prec 0)
    state opxor() { transition self.buf[self.pos] == 94  { true -> p0()  false -> padv() } }     // '^' (prec 0)
    state p3()    { self.curp = 3; self.curl = 1; transition 0 { _ -> sypop() } }
    state p2()    { self.curp = 2; self.curl = 1; transition 0 { _ -> sypop() } }
    state p0()    { self.curp = 0; self.curl = 1; transition 0 { _ -> sypop() } }                // & | ^
    state p1m()   { self.curp = 1; transition self.buf[self.pos + 1] == 61 { true -> p1mlen2()  false -> p1mshc() } } // <=, >=
    state p1mlen2(){ self.curl = 2; transition 0 { _ -> sypop() } }
    state p1mshc(){ transition self.buf[self.pos + 1] == self.buf[self.pos] { true -> p1mshift()  false -> p1mlen1() } } // '<<' / '>>' (second char == first)
    state p1mshift(){ self.curp = 0; self.curl = 2; transition 0 { _ -> sypop() } }              // shifts: prec 0, length 2
    state p1mlen1(){ self.curl = 1; transition 0 { _ -> sypop() } }
    state p1two() { self.curp = 1; self.curl = 2; transition 0 { _ -> sypop() } }                // ==, !=
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }                        // unknown punct: skip
    // pop operators of >= precedence (stop at a bracket marker: oprec 0 < curp), then push
    state sypop() { transition self.sp > 0 { true -> sypop2()  false -> opush() } }
    state sypop2(){ transition self.oprec[self.sp - 1] < self.curp { true -> opush()  false -> syemit() } }
    state syemit(){ self.emit_tok(self.ostart[self.sp - 1], self.oend[self.sp - 1]); self.sp = self.sp - 1; transition 0 { _ -> sypop() } }
    state opush() { self.ostart[self.sp] = self.pos; self.oend[self.sp] = self.pos + self.curl; self.oprec[self.sp] = self.curp; self.obrk[self.sp] = 0; self.sp = self.sp + 1; self.pos = self.pos + self.curl; transition 0 { _ -> sk() } }
    // ']' : pop operators until the bracket marker, then emit the indexed-load token `base[]`
    state rbrk()  { transition self.sp > 0 { true -> rbrk2()  false -> padv() } }
    state rbrk2() { transition self.obrk[self.sp - 1] == 1 { true -> rbemit()  false -> rbpop() } }
    state rbpop() { self.emit_tok(self.ostart[self.sp - 1], self.oend[self.sp - 1]); self.sp = self.sp - 1; transition 0 { _ -> rbrk() } }
    state rbemit(){ self.emit_idx(self.ostart[self.sp - 1], self.oend[self.sp - 1]); self.sp = self.sp - 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    // end of input: pop the rest of the operator stack
    state flush() { transition self.sp > 0 { true -> flem()  false -> done() } }
    state flem()  { self.emit_tok(self.ostart[self.sp - 1], self.oend[self.sp - 1]); self.sp = self.sp - 1; transition 0 { _ -> flush() } }
    state done()  { self.console.exit_process(0) }
}
