// State parameters: a `state name(p: i32, ...)` takes value arguments, passed by a
// transition arm `pat -> name(args)`. The args are evaluated and stored into the
// machine's shared state-arg slots, then control branches to the state; inside, the
// parameters read those slots. This is what lets a loop carry an accumulator without a
// `self` field — and it's the groundwork for binding enum payloads in a match arm.
// Here `go` carries (i, acc); each pass doubles acc until i reaches 4: 1·2·2·2·2 = 16.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    transition 0 { _ -> go(0, 1) }
    state go(i: i32, acc: i32) {
        transition i < 4 {
            true -> go(i + 1, acc * 2)
            _ -> fin(acc)
        }
    }
    state fin(r: i32) {
        self.console.exit_process(r)
    }
}
