// Tag-only enums (sum types, no payload) — the first slice of Omega's `case`. A
// `data E { case A; case B; ... }` declares E whose variants get tag = declaration
// index. The value of a tag-only variant IS that i32 tag, so:
//   - an enum-typed field (`c: Color`) is just a scalar slot holding the tag,
//   - `Color::Green` is the tag constant (1), and
//   - a `transition` arm `Color::Green -> state()` matches that tag.
// A transition over an enum field is EXHAUSTIVENESS-CHECKED: it must cover every
// variant or include a `_` arm, else the compiler rejects it. Here all three variants
// are handled, so no `_` is needed. Color::Green (tag 1) dispatches to green() -> 7.
// (Payload variants `case X(..)` and mixed field+case data are later slices — payloads
// are rejected with a clear error today.)
boundary trait Console { machine exit_process(return_code: i32); }
data Color { case Red; case Green; case Blue; }
data Main { console: Console; c: Color; }
machine Main::main(&mut self) {
    self.c = Color::Green;
    transition self.c {
        Color::Red -> red()
        Color::Green -> green()
        Color::Blue -> blue()
    }
    state red() { self.console.exit_process(1) }
    state green() { self.console.exit_process(7) }
    state blue() { self.console.exit_process(3) }
}
