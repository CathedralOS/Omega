// SELF-HOSTING step: a real .alp frontend pass, written in .alp. It reads .alp source
// and checks NAME RESOLUTION of the state machine: every transition target `-> name()`
// must refer to a declared `state name`. Undefined targets (typos) are reported, one
// per line, and the program exits 1; clean source exits 0. This is the analysis a
// compiler runs to catch "goto undefined label" -- here over .alp's own grammar.
//   collects `state NAME` declarations and `-> NAME` targets by a mode-tracking scan
//   (skipping whitespace, // comments, and "..." strings), then cross-checks each
//   target against the declarations by byte-for-byte name equality.
//   printf 'machine M::m(){ state a(){ transition 0 { _ -> a() } } }' | statecheck -> exit 0
//   ... -> b() ... with no `state b` -> prints "b", exit 1
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    // scalars FIRST (low offsets -- scalar str/ldr immediates are bounded ~16380); the
    // big buf/arrays go LAST and are reached via the array-element address path (which
    // handles offsets > 4095). nd = #declared states, nt = #targets.
    console: Console;
    n: i32; pos: i32; c: i32; start: i32; w: i32; pend: i32; nd: i32; nt: i32;
    ci: i32; cj: i32; found: i32; bad: i32; ei: i32; qa: i32; qb: i32; qc: i32; qd: i32; qk: i32;
    ds: [i32; 384]; de: [i32; 384];     // declared states  [ds..de)
    ts: [i32; 384]; te: [i32; 384];     // transition targets
    buf: [u8; 16384];
}
machine Main::is_word(&mut self, c: i32) -> i32 {
    transition c == 95 { true -> yes()  false -> w1() }
    state w1() { transition c < 48  { true -> no()  false -> w2() } }
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }
    state w3() { transition c < 65  { true -> no()  false -> w4() } }
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }
    state w5() { transition c < 97  { true -> no()  false -> w6() } }
    state w6() { transition c <= 122 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::is_state(&mut self, s: i32, e: i32) -> i32 {     // "state" = 115 116 97 116 101
    transition e - s == 5 { true -> k0()  false -> kno() }
    state k0() { transition self.buf[s]     == 115 { true -> k1()  false -> kno() } }
    state k1() { transition self.buf[s + 1] == 116 { true -> k2()  false -> kno() } }
    state k2() { transition self.buf[s + 2] == 97  { true -> k3()  false -> kno() } }
    state k3() { transition self.buf[s + 3] == 116 { true -> k4()  false -> kno() } }
    state k4() { transition self.buf[s + 4] == 101 { true -> kyes() false -> kno() } }
    state kyes() { return 1; }
    state kno()  { return 0; }
}
// equal?  buf[qa..qb) == buf[qc..qd)   (operands in fields, to fit the 3-arg ABI)
machine Main::streq(&mut self) -> i32 {
    transition self.qb - self.qa == self.qd - self.qc { true -> sq0()  false -> sno() }
    state sq0()  { self.qk = 0; transition 0 { _ -> sloop() } }
    state sloop(){ transition self.qa + self.qk < self.qb { true -> scmp()  false -> syes() } }
    state scmp() { transition self.buf[self.qa + self.qk] == self.buf[self.qc + self.qk] { true -> sadv()  false -> sno() } }
    state sadv() { self.qk = self.qk + 1; transition 0 { _ -> sloop() } }
    state syes()  { return 1; }
    state sno()   { return 0; }
}
machine Main::emit_range(&mut self, a: i32, b: i32) {
    self.ei = a;
    transition 0 { _ -> el() }
    state el() { transition self.ei < b { true -> ew()  false -> enl() } }
    state ew() { write_byte(self.buf[self.ei]); self.ei = self.ei + 1; transition 0 { _ -> el() } }
    state enl(){ write_byte(10); }
}
machine Main::main(&mut self) {
    self.n = 0; self.nd = 0; self.nt = 0; self.pend = 0; self.bad = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { transition self.n < 16384 { true -> store2()  false -> rd() } }   // guard: drop overflow
    state store2(){ self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    // ---- scan: collect `state NAME` decls and `-> NAME` targets ----
    state scan()    { self.pos = 0; transition 0 { _ -> sk() } }
    state sk()      { transition self.pos < self.n { true -> ws()  false -> xcheck() } }
    state ws()      { transition self.buf[self.pos] <= 32 { true -> wadv()  false -> commck() } }
    state wadv()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state commck()  { transition self.buf[self.pos] == 47 { true -> commck2()  false -> strck() } }   // '/'
    state commck2() { transition self.buf[self.pos + 1] == 47 { true -> skipc()  false -> strck() } }
    state skipc()   { transition self.pos < self.n { true -> cnl()  false -> xcheck() } }
    state cnl()     { transition self.buf[self.pos] == 10 { true -> wadv()  false -> cadv() } }
    state cadv()    { self.pos = self.pos + 1; transition 0 { _ -> skipc() } }
    state strck()   { transition self.buf[self.pos] == 34 { true -> stradv()  false -> tok() } }       // '"'
    state stradv()  { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    state ss()      { transition self.pos < self.n { true -> ss2()  false -> xcheck() } }
    state ss2()     { transition self.buf[self.pos] == 34 { true -> wadv()  false -> ssa() } }
    state ssa()     { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    // a token: a word, the -> arrow, or other punctuation
    state tok()     { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word()  false -> punc() } }
    state word()    { self.start = self.pos; transition 0 { _ -> wrun() } }
    state wrun()    { transition self.pos < self.n { true -> wrck()  false -> wclass() } }
    state wrck()    { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wradv()  false -> wclass() } }
    state wradv()   { self.pos = self.pos + 1; transition 0 { _ -> wrun() } }
    state wclass()  { self.w = self.is_state(self.start, self.pos); transition self.w == 1 { true -> setDecl()  false -> useWord() } }
    state setDecl() { self.pend = 1; transition 0 { _ -> sk() } }                                       // saw `state` -> next word is a decl
    state useWord() { transition self.pend == 1 { true -> ckDecl()  false -> ckTgt() } }
    state ckDecl()  { transition self.nd < 384 { true -> addDecl()  false -> resetP() } }   // guard arrays
    state addDecl() { self.ds[self.nd] = self.start; self.de[self.nd] = self.pos; self.nd = self.nd + 1; self.pend = 0; transition 0 { _ -> sk() } }
    state ckTgt()   { transition self.pend == 2 { true -> tgtP()  false -> sk() } }
    // a transition target is a state CALL: the name is immediately followed by '(' --
    // this distinguishes `pat -> state()` from a return-type arrow `machine f() -> i32`.
    state tgtP()    { transition self.buf[self.pos] == 40 { true -> ckTcap()  false -> resetP() } }
    state ckTcap()  { transition self.nt < 384 { true -> addTgt()  false -> resetP() } }   // guard arrays
    state resetP()  { self.pend = 0; transition 0 { _ -> sk() } }
    state addTgt()  { self.ts[self.nt] = self.start; self.te[self.nt] = self.pos; self.nt = self.nt + 1; self.pend = 0; transition 0 { _ -> sk() } }
    state punc()    { transition self.buf[self.pos] == 45 { true -> arrck()  false -> padv() } }        // '-'
    state arrck()   { transition self.buf[self.pos + 1] == 62 { true -> arrow()  false -> padv() } }    // '>'
    state arrow()   { self.pend = 2; self.pos = self.pos + 2; transition 0 { _ -> sk() } }              // saw `->` -> next word is a target
    state padv()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    // ---- cross-check: every target must match a declared state ----
    state xcheck()  { self.ci = 0; transition 0 { _ -> xloop() } }
    state xloop()   { transition self.ci < self.nt { true -> xinit()  false -> report() } }
    state xinit()   { self.cj = 0; self.found = 0; self.qa = self.ts[self.ci]; self.qb = self.te[self.ci]; transition 0 { _ -> jloop() } }
    state jloop()   { transition self.cj < self.nd { true -> jcmp()  false -> xdone() } }
    state jcmp()    { self.qc = self.ds[self.cj]; self.qd = self.de[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> jfound()  false -> jnext() } }
    state jfound()  { self.found = 1; transition 0 { _ -> xdone() } }
    state jnext()   { self.cj = self.cj + 1; transition 0 { _ -> jloop() } }
    state xdone()   { transition self.found == 0 { true -> undef()  false -> xnext() } }
    state undef()   { self.bad = 1; self.emit_range(self.ts[self.ci], self.te[self.ci]); transition 0 { _ -> xnext() } }
    state xnext()   { self.ci = self.ci + 1; transition 0 { _ -> xloop() } }
    state report()  { transition self.bad == 1 { true -> fail()  false -> ok() } }
    state fail()    { self.console.exit_process(1) }
    state ok()      { self.console.exit_process(0) }
}
