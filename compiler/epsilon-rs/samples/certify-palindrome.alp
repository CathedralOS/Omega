// CERTIFYING COMPUTATION: a verified PALINDROME. This reads a 3-element list and certifies a
// genuine structural property of it -- that it reads the same forwards and backwards -- by shipping
// a user-defined `reverse` (itself defined via a user `append`) and proving `reverse(L) = L`:
//   defs   (data 2 0 0 0) (data 3 2 0 1)                        -- a list ADT: nil (cid 2), cons (cid 3)
//          (fun 8 2 (y 0)) (fun 8 3 (k 3 (v 0) (rec 1)))        -- append nil b = b ; append (h::t) b = h::append t b
//          (fun 9 2 (k 2)) (fun 9 3 (f 8 (rec 1) (k 3 (v 0) (k 2))))  -- reverse nil = nil ; reverse (h::t) = append (reverse t) [h]
//   proposition  (= (f 9 (k 3 A (k 3 B (k 3 C (k 2))))) (k 3 A (k 3 B (k 3 C (k 2)))))
//   proof        (refl (k 3 A (k 3 B (k 3 C (k 2)))))
// The trust anchor must REDUCE reverse over the user list -- which recursively reduces append -- and
// confirm the result is the input itself. So the checker runs a real recursive algorithm with a nested
// recursive call and certifies the list is a palindrome. A non-palindrome makes reverse(L) differ from
// L, and the certificate is rejected.
//   printf '2 3 2' | certify-palindrome | check.exe  ->  accept   (reverse [2 3 2] = [2 3 2])
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    vals: [i32; 8]; vn: i32; cur: i32; inb: i32; uv: i32;
    a: i32; b: i32; d: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// emit the user list  (k 3 A (k 3 B (k 3 C (k 2))))  -- cons A (cons B (cons C nil))
machine Main::emit_list(&mut self) {
    write_line("(k 3");
    self.emit_nat(self.a);
    write_line("(k 3");
    self.emit_nat(self.b);
    write_line("(k 3");
    self.emit_nat(self.d);
    write_line("(k 2))))");
}
machine Main::main(&mut self) {
    self.n = 0; self.vn = 0; self.cur = 0; self.inb = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> pp()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state pp()    { self.pos = 0; transition 0 { _ -> pscan() } }
    state pscan() { transition self.pos < self.n { true -> pc()  false -> pend() } }
    state pc()    { transition self.buf[self.pos] < 48 { true -> psep()  false -> pcHi() } }
    state pcHi()  { transition self.buf[self.pos] > 57 { true -> psep()  false -> pdig() } }
    state pdig()  { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.inb = 1; self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state psep()  { transition self.inb == 1 { true -> pstore()  false -> padv() } }
    state pstore(){ self.vals[self.vn] = self.cur; self.vn = self.vn + 1; self.cur = 0; self.inb = 0; transition 0 { _ -> padv() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state pend()  { transition self.inb == 1 { true -> pendS()  false -> pick() } }
    state pendS() { self.vals[self.vn] = self.cur; self.vn = self.vn + 1; transition 0 { _ -> pick() } }
    state pick()  { self.a = self.vals[0]; self.b = self.vals[1]; self.d = self.vals[2]; transition 0 { _ -> emit() } }
    state emit() {
        // the user list ADT + append (fun 8) + reverse (fun 9, which calls append)
        write_line("(data 2 0 0 0) (data 3 2 0 1) (fun 8 2 (y 0)) (fun 8 3 (k 3 (v 0) (rec 1))) (fun 9 2 (k 2)) (fun 9 3 (f 8 (rec 1) (k 3 (v 0) (k 2))))");
        // proposition: (= (f 9 <L>) <L>)
        write_line("(= (f 9");
        self.emit_list();
        write_line(")");
        self.emit_list();
        write_line(")");
        // proof: (refl <L>)
        write_line("(refl");
        self.emit_list();
        write_line(")");
        self.console.exit_process(0)
    }
}
