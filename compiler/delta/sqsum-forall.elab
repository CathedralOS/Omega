; sqsum-forall.elab — the SUM-OF-SQUARES ∀-input fold: a fold adding each element's SQUARE. Shape of
; dual_accumulator_recursion's `sum_sq(s[1..], acc + s[0]*s[0])` machine.  ∀xs ∀n. sqfold(xs, n) = sumSq(xs) + n,
; sumSq(Cons h t)=h*h + sumSq t. Same uadd commutative-monoid proof as sum-forall (the added value h*h is opaque to
; the assoc/comm reasoning); needs umul (fun 22) for the square. ℤ-FREE: squares are non-negative, so the NAT theorem
; applies to the signed sample (in-range, per the meaning route's domain-erasure soundness).
(data 2 0 0 0) (data 3 1 1 0) (data 60 0 0 0) (data 61 2 0 1)
(fun 21 2 (y 0)) (fun 21 3 (k 3 (rec 0)))                ; uadd
(fun 22 2 (k 2)) (fun 22 3 (f 21 (y 0) (rec 0)))         ; umul(0,n)=0 ; umul(s m,n)=uadd(n, umul(m,n))
(fun 94 60 (k 2)) (fun 94 61 (f 21 (f 22 (v 0) (v 0)) (rec 1)))   ; sumSq(Nil)=0 ; sumSq(Cons h t)=h*h + sumSq t
(fun 95 60 (y 0)) (fun 95 61 (recx 1 (f 21 (f 22 (v 0) (v 0)) (y 0))))  ; sqfold(Nil,n)=n ; (Cons h t,n)=sqfold(t, h*h + n)

(all xs (all n (= (f 95 xs n) (f 21 (f 94 xs) n))))
(have add0r (all a (= (f 21 a (k 2)) a))
  (rec 2 3 a (= (f 21 a (k 2)) a)
    (refl (k 2))
    (gen a1 (lam ih (= (f 21 a1 (k 2)) a1)
      (eqelim x (= (k 3 (f 21 a1 (k 2))) (k 3 x)) ih (refl (k 3 (f 21 a1 (k 2))))))))
(have uaddsuc (all a (all b (= (f 21 a (k 3 b)) (k 3 (f 21 a b)))))
  (rec 2 3 a (all b (= (f 21 a (k 3 b)) (k 3 (f 21 a b))))
    (gen b (refl (k 3 b)))
    (gen a1 (lam ih (all b (= (f 21 a1 (k 3 b)) (k 3 (f 21 a1 b))))
      (gen b (eqelim x (= (k 3 (f 21 a1 (k 3 b))) (k 3 x)) (inst ih b) (refl (k 3 (f 21 a1 (k 3 b)))))))))
(have addcomm (all a (all b (= (f 21 a b) (f 21 b a))))
  (rec 2 3 a (all b (= (f 21 a b) (f 21 b a)))
    (gen b (eqelim x (= x (f 21 b (k 2))) (inst add0r b) (refl (f 21 b (k 2)))))
    (gen a1 (lam ih (all b (= (f 21 a1 b) (f 21 b a1)))
      (gen b
        (have s1 (= (k 3 (f 21 a1 b)) (k 3 (f 21 b a1)))
          (eqelim x (= (k 3 (f 21 a1 b)) (k 3 x)) (inst ih b) (refl (k 3 (f 21 a1 b))))
        (have s2 (= (k 3 (f 21 b a1)) (f 21 b (k 3 a1)))
          (eqelim x (= x (f 21 b (k 3 a1))) (inst* uaddsuc b a1) (refl (f 21 b (k 3 a1))))
          (eqelim x (= (k 3 (f 21 a1 b)) x) s2 s1)))))))
(have addassoc (all a (all b (all c (= (f 21 (f 21 a b) c) (f 21 a (f 21 b c))))))
  (rec 2 3 a (all b (all c (= (f 21 (f 21 a b) c) (f 21 a (f 21 b c)))))
    (gen b (gen c (refl (f 21 b c))))
    (gen a1 (lam ih (all b (all c (= (f 21 (f 21 a1 b) c) (f 21 a1 (f 21 b c)))))
      (gen b (gen c
        (eqelim x (= (k 3 (f 21 (f 21 a1 b) c)) (k 3 x)) (inst* ih b c) (refl (k 3 (f 21 (f 21 a1 b) c)))))))))
(rec 60 61 xs (all n (= (f 95 xs n) (f 21 (f 94 xs) n)))
  (gen n (refl n))
  (gen h (gen t (lam ih (all n (= (f 95 t n) (f 21 (f 94 t) n)))
    (gen n
      (have s1 (= (f 21 (f 94 t) (f 21 (f 22 h h) n)) (f 21 (f 21 (f 94 t) (f 22 h h)) n))
        (eqelim x (= x (f 21 (f 21 (f 94 t) (f 22 h h)) n)) (inst* addassoc (f 94 t) (f 22 h h) n) (refl (f 21 (f 21 (f 94 t) (f 22 h h)) n)))
      (have s2 (= (f 21 (f 21 (f 94 t) (f 22 h h)) n) (f 21 (f 21 (f 22 h h) (f 94 t)) n))
        (eqelim x (= (f 21 (f 21 (f 94 t) (f 22 h h)) n) (f 21 x n)) (inst* addcomm (f 94 t) (f 22 h h)) (refl (f 21 (f 21 (f 94 t) (f 22 h h)) n)))
      (have bridge (= (f 21 (f 94 t) (f 21 (f 22 h h) n)) (f 21 (f 21 (f 22 h h) (f 94 t)) n))
        (eqelim x (= (f 21 (f 94 t) (f 21 (f 22 h h) n)) x) s2 s1)
        (eqelim x (= (f 95 t (f 21 (f 22 h h) n)) x) bridge (inst ih (f 21 (f 22 h h) n)))))))))))))))
