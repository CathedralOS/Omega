; lib/nat-semiring.elab — SHARED nat COMMUTATIVE-SEMIRING library: extends nat-monoid (0,uadd) with umul
; (fun 22) and its laws. Pulled in via `(include lib/nat-semiring.elab)` (which itself includes nat-monoid, so a
; consumer gets BOTH the additive monoid lemmas add0r/uaddsuc/addcomm/addassoc AND the multiplicative
; mul0r/mulsucr/mulcomm/muldist/mulassoc, all auto-wrapping the consuming proof). Single-responsibility: the
; (0,uadd,1,umul) semiring lives HERE, once, instead of being re-inlined into every proof that multiplies
; (prod-forall, the triangular closed form, ...). The mul lemmas are extracted verbatim from prod-forall's
; already-checked proofs; still fully checked. mul0r a*0=0 ; mulsucr a*(s b)=a+a*b ; mulcomm a*b=b*a ;
; muldist (a+b)*c=a*c+b*c (right-distributivity) ; mulassoc (a*b)*c=a*(b*c).
(include lib/nat-monoid.elab)
(fun 22 2 (k 2)) (fun 22 3 (f 21 (y 0) (rec 0)))          ; umul(0,n)=0 ; umul(s m,n)=uadd(n, umul(m,n))

(lemma mul0r (all a (= (f 22 a (k 2)) (k 2)))
  (rec 2 3 a (= (f 22 a (k 2)) (k 2)) (refl (k 2)) (gen a1 (lam ih (= (f 22 a1 (k 2)) (k 2)) ih))))
(lemma mulsucr (all a (all b (= (f 22 a (k 3 b)) (f 21 a (f 22 a b)))))
  (rec 2 3 a (all b (= (f 22 a (k 3 b)) (f 21 a (f 22 a b)))) (gen b (refl (k 2))) (gen a1 (lam ih (all b (= (f 22 a1 (k 3 b)) (f 21 a1 (f 22 a1 b)))) (gen b (have viaih (= (f 22 a1 (k 3 b)) (f 21 a1 (f 22 a1 b))) (inst ih b) (have t1 (= (f 21 b (f 21 a1 (f 22 a1 b))) (f 21 (f 21 b a1) (f 22 a1 b))) (eqelim x (= x (f 21 (f 21 b a1) (f 22 a1 b))) (inst* addassoc b a1 (f 22 a1 b)) (refl (f 21 (f 21 b a1) (f 22 a1 b)))) (have t2 (= (f 21 (f 21 b a1) (f 22 a1 b)) (f 21 (f 21 a1 b) (f 22 a1 b))) (eqelim x (= (f 21 (f 21 b a1) (f 22 a1 b)) (f 21 x (f 22 a1 b))) (inst* addcomm b a1) (refl (f 21 (f 21 b a1) (f 22 a1 b)))) (have swap (= (f 21 b (f 21 a1 (f 22 a1 b))) (f 21 a1 (f 21 b (f 22 a1 b)))) (eqelim x (= (f 21 b (f 21 a1 (f 22 a1 b))) x) (inst* addassoc a1 b (f 22 a1 b)) (eqelim x (= (f 21 b (f 21 a1 (f 22 a1 b))) x) t2 t1)) (have stepA (= (k 3 (f 21 b (f 22 a1 (k 3 b)))) (k 3 (f 21 b (f 21 a1 (f 22 a1 b))))) (eqelim x (= (k 3 (f 21 b (f 22 a1 (k 3 b)))) (k 3 (f 21 b x))) viaih (refl (k 3 (f 21 b (f 22 a1 (k 3 b)))))) (have stepB (= (k 3 (f 21 b (f 21 a1 (f 22 a1 b)))) (k 3 (f 21 a1 (f 21 b (f 22 a1 b))))) (eqelim x (= (k 3 (f 21 b (f 21 a1 (f 22 a1 b)))) (k 3 x)) swap (refl (k 3 (f 21 b (f 21 a1 (f 22 a1 b)))))) (eqelim x (= (k 3 (f 21 b (f 22 a1 (k 3 b)))) x) stepB stepA))))))))))))
(lemma mulcomm (all a (all b (= (f 22 a b) (f 22 b a))))
  (rec 2 3 a (all b (= (f 22 a b) (f 22 b a))) (gen b (eqelim x (= x (f 22 b (k 2))) (inst mul0r b) (refl (f 22 b (k 2))))) (gen a1 (lam ih (all b (= (f 22 a1 b) (f 22 b a1))) (gen b (have viaih (= (f 21 b (f 22 a1 b)) (f 21 b (f 22 b a1))) (eqelim x (= (f 21 b (f 22 a1 b)) (f 21 b x)) (inst ih b) (refl (f 21 b (f 22 a1 b)))) (have msr (= (f 22 b (k 3 a1)) (f 21 b (f 22 b a1))) (inst* mulsucr b a1) (eqelim x (= (f 21 b (f 22 a1 b)) x) (eqelim x (= x (f 22 b (k 3 a1))) msr (refl (f 22 b (k 3 a1)))) viaih))))))))
(lemma muldist (all a (all b (all c (= (f 22 (f 21 a b) c) (f 21 (f 22 a c) (f 22 b c))))))
  (rec 2 3 a (all b (all c (= (f 22 (f 21 a b) c) (f 21 (f 22 a c) (f 22 b c))))) (gen b (gen c (refl (f 22 b c)))) (gen a1 (lam ih (all b (all c (= (f 22 (f 21 a1 b) c) (f 21 (f 22 a1 c) (f 22 b c))))) (gen b (gen c (have viaih (= (f 21 c (f 22 (f 21 a1 b) c)) (f 21 c (f 21 (f 22 a1 c) (f 22 b c)))) (eqelim x (= (f 21 c (f 22 (f 21 a1 b) c)) (f 21 c x)) (inst* ih b c) (refl (f 21 c (f 22 (f 21 a1 b) c)))) (have reassoc (= (f 21 c (f 21 (f 22 a1 c) (f 22 b c))) (f 21 (f 21 c (f 22 a1 c)) (f 22 b c))) (eqelim x (= x (f 21 (f 21 c (f 22 a1 c)) (f 22 b c))) (inst* addassoc c (f 22 a1 c) (f 22 b c)) (refl (f 21 (f 21 c (f 22 a1 c)) (f 22 b c)))) (eqelim x (= (f 21 c (f 22 (f 21 a1 b) c)) x) reassoc viaih)))))))))
(lemma mulassoc (all a (all b (all c (= (f 22 (f 22 a b) c) (f 22 a (f 22 b c))))))
  (rec 2 3 a (all b (all c (= (f 22 (f 22 a b) c) (f 22 a (f 22 b c))))) (gen b (gen c (refl (k 2)))) (gen a1 (lam ih (all b (all c (= (f 22 (f 22 a1 b) c) (f 22 a1 (f 22 b c))))) (gen b (gen c (have dist (= (f 22 (f 21 b (f 22 a1 b)) c) (f 21 (f 22 b c) (f 22 (f 22 a1 b) c))) (inst* muldist b (f 22 a1 b) c) (have viaih (= (f 21 (f 22 b c) (f 22 (f 22 a1 b) c)) (f 21 (f 22 b c) (f 22 a1 (f 22 b c)))) (eqelim x (= (f 21 (f 22 b c) (f 22 (f 22 a1 b) c)) (f 21 (f 22 b c) x)) (inst* ih b c) (refl (f 21 (f 22 b c) (f 22 (f 22 a1 b) c)))) (eqelim x (= (f 22 (f 21 b (f 22 a1 b)) c) x) viaih dist)))))))))

; mulldist a*(b+c)=a*b+a*c (LEFT-distributivity, from mulcomm+muldist) — the workhorse for polynomial identities
(lemma mulldist (all a (all b (all c (= (f 22 a (f 21 b c)) (f 21 (f 22 a b) (f 22 a c))))))
  (gen a (gen b (gen c (eqelim x (= (f 22 a (f 21 b c)) x) (eqelim x (= (f 21 (f 22 a b) (f 22 c a)) (f 21 (f 22 a b) x)) (inst* mulcomm c a) (refl (f 21 (f 22 a b) (f 22 c a)))) (eqelim x (= (f 22 a (f 21 b c)) x) (eqelim x (= (f 21 (f 22 b a) (f 22 c a)) (f 21 x (f 22 c a))) (inst* mulcomm b a) (refl (f 21 (f 22 b a) (f 22 c a)))) (eqelim x (= (f 22 a (f 21 b c)) x) (inst* muldist b c a) (eqelim x (= (f 22 a (f 21 b c)) x) (inst* mulcomm a (f 21 b c)) (refl (f 22 a (f 21 b c)))))))))))
