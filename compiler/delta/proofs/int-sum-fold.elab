(fun 100 70 (v 0)) (fun 101 70 (v 1))
(fun 95 70 (k 70 (+ (v 0) (f 100 (y 0))) (+ (v 1) (f 101 (y 0)))))
(fun 94 60 (k 70 z z)) (fun 94 61 (f 95 (v 0) (rec 1)))
(fun 96 60 (y 0)) (fun 96 61 (recx 1 (f 95 (y 0) (v 0))))
