; a<=b -> b<=c -> a<=c   with named lemmas assoc/sym/trans
(def 0 (all A (all B (all C (= (+ (+ C A) B) (+ C (+ A B))))))
  (gen A (gen B (natind C (= (+ (+ C A) B) (+ C (+ A B)))
    (refl (+ A B))
    (gen C2 (lam ih (= (+ (+ C2 A) B) (+ C2 (+ A B)))
      (eqelim hole (= (s (+ (+ C2 A) B)) (s hole)) ih (refl (s (+ (+ C2 A) B))))))))))
(def 1 (all x (all y (-> (= x y) (= y x))))
  (gen x (gen y (lam h (= x y) (eqelim hole (= hole x) h (refl x))))))
(def 2 (all x (all y (all z (-> (= x y) (-> (= y z) (= x z))))))
  (gen x (gen y (gen z (lam h1 (= x y) (lam h2 (= y z) (eqelim hole (= x hole) h2 h1)))))))
; theorem
(all a (all b (all c (-> (ex d (= (+ a d) b)) (-> (ex e (= (+ b e) c)) (ex f (= (+ a f) c)))))))
(gen a (gen b (gen c (lam h1 (ex d (= (+ a d) b)) (lam h2 (ex e (= (+ b e) c))
  (unpack h1 (gen d (lam p1 (= (+ a d) b)
    (unpack h2 (gen e (lam p2 (= (+ b e) c)
      (wit f (= (+ a f) c) (+ d e)
        (app (app (inst (inst (inst (use 2) (+ a (+ d e))) (+ (+ a d) e)) c)
                  (app (inst (inst (use 1) (+ (+ a d) e)) (+ a (+ d e)))
                       (inst (inst (inst (use 0) d) e) a)))
             (app (app (inst (inst (inst (use 2) (+ (+ a d) e)) (+ b e)) c)
                       (eqelim hole (= (+ (+ a d) e) (+ hole e)) p1 (refl (+ (+ a d) e))))
                  p2))))))))))))))
