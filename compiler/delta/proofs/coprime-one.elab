; coprimality with 1: 1 is a gcd of a and 1 (everything is coprime to 1)
(def 0 (all x1 (= (* x1 (s z)) x1)) (natind x2 (= (* x2 (s z)) x2) (refl z) (gen x3 (lam h4 (= (* x3 (s z)) x3) (eqelim x5 (= (s (* x3 (s z))) (s x5)) h4 (refl (s (* x3 (s z)))))))))
(all x1 (& (ex x2 (= (* x2 (s z)) x1)) (& (ex x3 (= (* x3 (s z)) (s z))) (all x4 (-> (ex x5 (= (* x5 x4) x1)) (-> (ex x6 (= (* x6 x4) (s z))) (ex x7 (= (* x7 x4) (s z)))))))))
(gen x1 (pair (wit x2 (= (* x2 (s z)) x1) x1 (inst (use 0) x1)) (pair (wit x3 (= (* x3 (s z)) (s z)) (s z) (inst (use 0) (s z))) (gen x4 (lam h5 (ex x6 (= (* x6 x4) x1)) (lam h7 (ex x8 (= (* x8 x4) (s z))) h7))))))
