; le-total.elab — the decidable order `le` is TOTAL:  ∀a b.  a≤b  ∨  b≤a  (where x≤y is le(x,y)=True). The
; third total-order property (with le-refl in le-max-bound and le-trans): `le` is now a decidable TOTAL ORDER —
; the foundation a Sorted predicate and insertion-sort correctness stand on. `le` returns a built-in nat Bool
; (True=(s z)) over user-nat elements (k2/k3), same as le-trans. Proof: induction on a — a=0 gives the LEFT
; disjunct (le(0,b)=True) via inl; a=s.., b=0 gives the RIGHT (le(0,s a)=True) via inr; the all-successor case
; peels one s off both sides (le(s x,s y)=le(x,y)) so the goal is exactly the induction hypothesis at (a1,b1).
(data 2 0 0 0) (data 3 1 1 0)
(fun 25 2 (s z)) (fun 25 3 (f 26 (y 0) (v 0)))          ; le(0,n)=True ; le(s m,n)=lehelp(n,m)
(fun 26 2 z) (fun 26 3 (f 25 (y 0) (v 0)))              ; lehelp(0,m)=False ; lehelp(s n,m)=le(m,n)

(all a (all b (or (= (f 25 a b) (s z)) (= (f 25 b a) (s z)))))
(rec 2 3 a (all b (or (= (f 25 a b) (s z)) (= (f 25 b a) (s z)))) (gen b (inl (= (f 25 b (k 2)) (s z)) (refl (s z)))) (gen a1 (lam iha (all b (or (= (f 25 a1 b) (s z)) (= (f 25 b a1) (s z)))) (rec 2 3 b (or (= (f 25 (k 3 a1) b) (s z)) (= (f 25 b (k 3 a1)) (s z))) (inr (= (f 25 (k 3 a1) (k 2)) (s z)) (refl (s z))) (gen b1 (lam ihb (or (= (f 25 (k 3 a1) b1) (s z)) (= (f 25 b1 (k 3 a1)) (s z))) (inst iha b1)))))))
