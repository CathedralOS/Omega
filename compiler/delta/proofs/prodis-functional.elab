; the relational product is deterministic: ProdIs(L,m) & ProdIs(L,n) -> m=n
; listind on L; nil via prodnilinv (both =1); cons via prodconsinv (m=h*a, n=h*b) + IH (a=b) + mult-cong.
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(all x1 (all x2 (all x3 (-> (rel 778 x1 x2) (-> (rel 778 x1 x3) (= x2 x3))))))
(listind x1 (all x2 (all x3 (-> (rel 778 x1 x2) (-> (rel 778 x1 x3) (= x2 x3))))) (gen x4 (gen x5 (lam h6 (rel 778 nil x4) (lam h7 (rel 778 nil x5) (app (app (inst (inst (inst (use 1) x4) (s z)) x5) (prodnilinv h6)) (app (inst (inst (use 0) x5) (s z)) (prodnilinv h7))))))) (gen x8 (gen x9 (lam h10 (all x11 (all x12 (-> (rel 778 x9 x11) (-> (rel 778 x9 x12) (= x11 x12))))) (gen x13 (gen x14 (lam h15 (rel 778 (cons x8 x9) x13) (lam h16 (rel 778 (cons x8 x9) x14) (unpack (prodconsinv h15) (gen x17 (lam h18 (& (= x13 (* x8 x17)) (rel 778 x9 x17)) (unpack (prodconsinv h16) (gen x19 (lam h20 (& (= x14 (* x8 x19)) (rel 778 x9 x19)) (app (app (inst (inst (inst (use 1) x13) (* x8 x17)) x14) (fst h18)) (app (app (inst (inst (inst (use 1) (* x8 x17)) (* x8 x19)) x14) (eqelim x21 (= (* x8 x17) (* x8 x21)) (app (app (inst (inst h10 x17) x19) (snd h18)) (snd h20)) (refl (* x8 x17)))) (app (inst (inst (use 0) x14) (* x8 x19)) (fst h20))))))))))))))))))
