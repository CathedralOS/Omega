; 0<a -> 0<b -> 0<a*b   — same proof, using inst*/app* sugar (no hand nesting)
(def 0 (all x (all y (all z (-> (= x y) (-> (= y z) (= x z))))))
  (gen x (gen y (gen z (lam h1 (= x y) (lam h2 (= y z) (eqelim hole (= x hole) h2 h1)))))))
(all a (all b (-> (ex k (= (+ 0 (s k)) a)) (-> (ex j (= (+ 0 (s j)) b)) (ex c (= (+ 0 (s c)) (* a b)))))))
(gen a (gen b (lam ha (ex k (= (+ 0 (s k)) a)) (lam hb (ex j (= (+ 0 (s j)) b))
  (unpack ha (gen k (lam pfa (= (+ 0 (s k)) a)
    (unpack hb (gen j (lam pfb (= (+ 0 (s j)) b)
      (wit c (= (+ 0 (s c)) (* a b)) (+ j (* k (s j)))
        (app* (inst* (use 0) (+ 0 (s (+ j (* k (s j))))) (* (s k) (s j)) (* a b))
              (refl (+ 0 (s (+ j (* k (s j))))))
              (app* (inst* (use 0) (* (s k) (s j)) (* a (s j)) (* a b))
                    (eqelim hole (= (* (s k) (s j)) (* hole (s j)))
                       (eqelim h2 (= (s k) h2) pfa (refl (s k))) (refl (* (s k) (s j))))
                    (eqelim hole (= (* a (s j)) (* a hole))
                       (eqelim h2 (= (s j) h2) pfb (refl (s j))) (refl (* a (s j)))))))))))))))))
