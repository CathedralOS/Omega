; le-add-both: a<=b & c<=d -> a+c <= b+d
(def 0 (all n (= (+ n 0) n))
  (natind n (= (+ n 0) n) (refl 0)
    (gen n2 (lam ih (= (+ n2 0) n2) (eqelim hole (= (s (+ n2 0)) (s hole)) ih (refl (s (+ n2 0))))))))
(def 1 (all x (all y (= (+ (s x) y) (s (+ x y)))))
  (gen x (gen y (refl (+ (s x) y)))))
(def 2 (all a (all m (= (+ a (s m)) (s (+ a m)))))
  (natind a (all m (= (+ a (s m)) (s (+ a m))))
    (gen m (refl (s m)))
    (gen a2 (lam ih (all m (= (+ a2 (s m)) (s (+ a2 m))))
      (gen m (eqelim hole (= (+ (s a2) (s m)) (s hole)) (inst ih m) (refl (+ (s a2) (s m)))))))))
(def 3 (all x (all y (-> (= x y) (= y x))))
  (gen x (gen y (lam h (= x y) (eqelim hole (= hole x) h (refl x))))))
(def 4 (all x (all y (all z (-> (= x y) (-> (= y z) (= x z))))))
  (gen x (gen y (gen z (lam h1 (= x y) (lam h2 (= y z) (eqelim hole (= x hole) h2 h1)))))))
(def 5 (all a (all b (all c (= (+ (+ a b) c) (+ a (+ b c)))))) (natind a (all b (all c (= (+ (+ a b) c) (+ a (+ b c)))))   (gen b (gen c (refl (+ b c))))   (gen a2 (lam ih (all b (all c (= (+ (+ a2 b) c) (+ a2 (+ b c)))))     (gen b (gen c (eqelim hole (= (+ (+ (s a2) b) c) (s hole)) (inst* ih b c) (refl (+ (+ (s a2) b) c)))))))))
(def 6 (all a (all b (= (+ a b) (+ b a)))) (natind a (all b (= (+ a b) (+ b a)))
  (gen b (app (inst* (use 3) (+ b 0) b) (inst (use 0) b)))
  (gen a2 (lam ih (all b (= (+ a2 b) (+ b a2)))
    (gen b
      (app* (inst* (use 4) (+ (s a2) b) (s (+ a2 b)) (+ b (s a2)))
            (inst* (use 1) a2 b)
            (app* (inst* (use 4) (s (+ a2 b)) (s (+ b a2)) (+ b (s a2)))
                  (eqelim hole (= (s (+ a2 b)) (s hole)) (inst ih b) (refl (s (+ a2 b))))
                  (app (inst* (use 3) (+ b (s a2)) (s (+ b a2))) (inst* (use 2) b a2)))))))))
(all a (all b (all c (all d (-> (ex x (= (+ a x) b)) (-> (ex y (= (+ c y) d)) (ex z (= (+ (+ a c) z) (+ b d)))))))))
(gen a (gen b (gen c (gen d (lam hab (ex x (= (+ a x) b)) (lam hcd (ex y (= (+ c y) d)) (unpack hab (gen x (lam p1 (= (+ a x) b) (unpack hcd (gen y (lam p2 (= (+ c y) d) (wit z (= (+ (+ a c) z) (+ b d)) (+ x y)(app* (inst* (use 4) (+ (+ a c) (+ x y)) (+ (+ a x) (+ c y)) (+ b d)) (app* (inst* (use 4) (+ (+ a c) (+ x y)) (+ a (+ c (+ x y))) (+ (+ a x) (+ c y))) (inst* (use 5) a c (+ x y)) (app* (inst* (use 4) (+ a (+ c (+ x y))) (+ a (+ (+ c x) y)) (+ (+ a x) (+ c y))) (eqelim hole (= (+ a (+ c (+ x y))) (+ a hole)) (app (inst* (use 3) (+ (+ c x) y) (+ c (+ x y))) (inst* (use 5) c x y)) (refl (+ a (+ c (+ x y))))) (app* (inst* (use 4) (+ a (+ (+ c x) y)) (+ a (+ (+ x c) y)) (+ (+ a x) (+ c y))) (eqelim hole (= (+ a (+ (+ c x) y)) (+ a (+ hole y))) (inst* (use 6) c x) (refl (+ a (+ (+ c x) y)))) (app* (inst* (use 4) (+ a (+ (+ x c) y)) (+ a (+ x (+ c y))) (+ (+ a x) (+ c y))) (eqelim hole (= (+ a (+ (+ x c) y)) (+ a hole)) (inst* (use 5) x c y) (refl (+ a (+ (+ x c) y)))) (app (inst* (use 3) (+ (+ a x) (+ c y)) (+ a (+ x (+ c y)))) (inst* (use 5) a x (+ c y))))))) (app* (inst* (use 4) (+ (+ a x) (+ c y)) (+ b (+ c y)) (+ b d)) (eqelim hole (= (+ (+ a x) (+ c y)) (+ hole (+ c y))) p1 (refl (+ (+ a x) (+ c y)))) (eqelim hole (= (+ b (+ c y)) (+ b hole)) p2 (refl (+ b (+ c y)))))))))))))))))))
