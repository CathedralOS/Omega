; lt-le bound: r<b & b<=Sn -> r<=n  (the gcd/Euclid recursion bound)
(def 0 (all x (all y (-> (= x y) (= y x))))
  (gen x (gen y (lam h (= x y) (eqelim hole (= hole x) h (refl x))))))
(def 1 (all x (all y (all z (-> (= x y) (-> (= y z) (= x z))))))
  (gen x (gen y (gen z (lam h1 (= x y) (lam h2 (= y z) (eqelim hole (= x hole) h2 h1)))))))
(def 2 (all x (all y (= (+ (s x) y) (s (+ x y)))))
  (gen x (gen y (refl (+ (s x) y)))))
(def 3 (all a (all m (= (+ a (s m)) (s (+ a m)))))
  (natind a (all m (= (+ a (s m)) (s (+ a m))))
    (gen m (refl (s m)))
    (gen a2 (lam ih (all m (= (+ a2 (s m)) (s (+ a2 m))))
      (gen m (eqelim hole (= (+ (s a2) (s m)) (s hole)) (inst ih m) (refl (+ (s a2) (s m)))))))))
(def 4 (all a (all b (all c (= (+ (+ a b) c) (+ a (+ b c))))))
  (natind a (all b (all c (= (+ (+ a b) c) (+ a (+ b c)))))
    (gen b (gen c (refl (+ b c))))
    (gen a2 (lam ih (all b (all c (= (+ (+ a2 b) c) (+ a2 (+ b c)))))
      (gen b (gen c (eqelim hole (= (+ (+ (s a2) b) c) (s hole)) (inst* ih b c) (refl (+ (+ (s a2) b) c)))))))))
(all r (all b (all n (-> (ex c (= (+ r (s c)) b)) (-> (ex e (= (+ b e) (s n))) (ex f (= (+ r f) n)))))))
(gen r (gen b (gen n (lam hlt (ex c (= (+ r (s c)) b)) (lam hle (ex e (= (+ b e) (s n)))
  (unpack hlt (gen c (lam pc (= (+ r (s c)) b)
    (unpack hle (gen e (lam pe (= (+ b e) (s n))
      (wit f (= (+ r f) n) (+ c e)
        (sinj
          (app* (inst* (use 1) (s (+ r (+ c e))) (+ (+ r (s c)) e) (s n))
            (app (inst* (use 0) (+ (+ r (s c)) e) (s (+ r (+ c e))))
              (app* (inst* (use 1) (+ (+ r (s c)) e) (+ r (+ (s c) e)) (s (+ r (+ c e))))
                (inst* (use 4) r (s c) e)
                (app* (inst* (use 1) (+ r (+ (s c) e)) (+ r (s (+ c e))) (s (+ r (+ c e))))
                  (eqelim hole (= (+ r (+ (s c) e)) (+ r hole)) (inst* (use 2) c e) (refl (+ r (+ (s c) e))))
                  (inst* (use 3) r (+ c e)))))
            (app* (inst* (use 1) (+ (+ r (s c)) e) (+ b e) (s n))
              (eqelim hole (= (+ (+ r (s c)) e) (+ hole e)) pc (refl (+ (+ r (s c)) e)))
              pe)))))))))))))))
