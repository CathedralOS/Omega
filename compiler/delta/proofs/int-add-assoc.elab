; ZZ-addition is associative (up to ~)
; ZZ as difference pairs: an integer (a,b) means a-b; intEq((a,b),(c,d)) := a+d=c+b
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 2 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 3 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 4 (all x1 (all x2 (= (+ x2 (s x1)) (s (+ x2 x1))))) (gen x3 (natind x4 (= (+ x4 (s x3)) (s (+ x4 x3))) (refl (s x3)) (gen x5 (lam h6 (= (+ x5 (s x3)) (s (+ x5 x3))) (eqelim x7 (= (s (+ x5 (s x3))) (s x7)) h6 (refl (s (+ x5 (s x3))))))))))
(def 5 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 6 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 7 (all x1 (all x2 (= (+ x2 x1) (+ x1 x2)))) (gen x3 (natind x4 (= (+ x4 x3) (+ x3 x4)) (eqelim x5 (= x5 (+ x3 z)) (inst (use 3) x3) (refl (+ x3 z))) (gen x6 (lam h7 (= (+ x6 x3) (+ x3 x6)) (app (app (inst (inst (inst (use 6) (s (+ x6 x3))) (s (+ x3 x6))) (+ x3 (s x6))) (eqelim x8 (= (s (+ x6 x3)) (s x8)) h7 (refl (s (+ x6 x3))))) (app (inst (inst (use 5) (+ x3 (s x6))) (s (+ x3 x6))) (inst (inst (use 4) x6) x3))))))))
(def 8 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 9 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 10 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(def 11 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 12 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 13 (all x1 (all x2 (all x3 (-> (= (+ x1 x3) (+ x2 x3)) (= x1 x2))))) (gen x4 (gen x5 (natind x6 (-> (= (+ x4 x6) (+ x5 x6)) (= x4 x5)) (lam h7 (= (+ x4 z) (+ x5 z)) (app (app (inst (inst (inst (use 12) x4) (+ x5 z)) x5) (app (app (inst (inst (inst (use 12) x4) (+ x4 z)) (+ x5 z)) (app (inst (inst (use 11) (+ x4 z)) x4) (inst (use 9) x4))) h7)) (inst (use 9) x5))) (gen x8 (lam h9 (-> (= (+ x4 x8) (+ x5 x8)) (= x4 x5)) (lam h10 (= (+ x4 (s x8)) (+ x5 (s x8))) (app h9 (sinj (app (app (inst (inst (inst (use 12) (s (+ x4 x8))) (+ x5 (s x8))) (s (+ x5 x8))) (app (app (inst (inst (inst (use 12) (s (+ x4 x8))) (+ x4 (s x8))) (+ x5 (s x8))) (app (inst (inst (use 11) (+ x4 (s x8))) (s (+ x4 x8))) (inst (inst (use 10) x4) x8))) h10)) (inst (inst (use 10) x5) x8)))))))))))
(all x1 (all x2 (all x3 (all x4 (all x5 (all x6 (= (+ (+ (+ x1 x3) x5) (+ x2 (+ x4 x6))) (+ (+ x1 (+ x3 x5)) (+ (+ x2 x4) x6)))))))))
(gen x1 (gen x2 (gen x3 (gen x4 (gen x5 (gen x6 (app (app (inst (inst (inst (use 1) (+ (+ (+ x1 x3) x5) (+ x2 (+ x4 x6)))) (+ (+ x1 (+ x3 x5)) (+ x2 (+ x4 x6)))) (+ (+ x1 (+ x3 x5)) (+ (+ x2 x4) x6))) (eqelim x7 (= (+ (+ (+ x1 x3) x5) (+ x2 (+ x4 x6))) (+ x7 (+ x2 (+ x4 x6)))) (inst (inst (inst (use 8) x3) x5) x1) (refl (+ (+ (+ x1 x3) x5) (+ x2 (+ x4 x6)))))) (eqelim x8 (= (+ (+ x1 (+ x3 x5)) (+ x2 (+ x4 x6))) (+ (+ x1 (+ x3 x5)) x8)) (app (inst (inst (use 0) (+ (+ x2 x4) x6)) (+ x2 (+ x4 x6))) (inst (inst (inst (use 8) x4) x6) x2)) (refl (+ (+ x1 (+ x3 x5)) (+ x2 (+ x4 x6))))))))))))
