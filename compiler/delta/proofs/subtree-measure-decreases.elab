(gen x1 (gen x2 (unpack (inst (use 0) x2) (gen x3 (lam h4 (= (+ z (s x3)) (f 13 x2)) (wit x5 (= (+ (f 13 x1) (s x5)) (f 13 (k 7 x1 x2))) x3 (eqelim x6 (= (+ (f 13 x1) (s x3)) (+ (f 13 x1) x6)) h4 (refl (+ (f 13 x1) (s x3))))))))))
