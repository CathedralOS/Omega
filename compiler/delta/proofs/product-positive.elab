; product of a list of primes is positive: allPrime(L) & ProdIs(L,n) -> 0<n
; listind on L: nil -> n=1>0 (prodnilinv); cons -> h prime so 0<h, 0<m by IH, mult-positive
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 2 (all x1 (all x2 (-> (ex x3 (= (+ z (s x3)) x1)) (-> (ex x4 (= (+ z (s x4)) x2)) (ex x5 (= (+ z (s x5)) (* x1 x2))))))) (gen x6 (gen x7 (lam h8 (ex x9 (= (+ z (s x9)) x6)) (lam h10 (ex x11 (= (+ z (s x11)) x7)) (unpack h8 (gen x12 (lam h13 (= (+ z (s x12)) x6) (unpack h10 (gen x14 (lam h15 (= (+ z (s x14)) x7) (wit x16 (= (+ z (s x16)) (* x6 x7)) (+ x14 (* x12 (s x14))) (app (app (inst (inst (inst (use 1) (+ z (s (+ x14 (* x12 (s x14)))))) (* (s x12) (s x14))) (* x6 x7)) (refl (+ z (s (+ x14 (* x12 (s x14))))))) (app (app (inst (inst (inst (use 1) (* (s x12) (s x14))) (* x6 (s x14))) (* x6 x7)) (eqelim x17 (= (* (s x12) (s x14)) (* x17 (s x14))) (eqelim x18 (= (s x12) x18) h13 (refl (s x12))) (refl (* (s x12) (s x14))))) (eqelim x19 (= (* x6 (s x14)) (* x6 x19)) (eqelim x20 (= (s x14) x20) h15 (refl (s x14))) (refl (* x6 (s x14))))))))))))))))))
(all x1 (-> (all x2 (-> (rel 777 x2 x1) (& (ex x3 (= (+ (s z) (s x3)) x2)) (all x4 (-> (ex x5 (= (* x5 x4) x2)) (or (= x4 (s z)) (= x4 x2))))))) (all x6 (-> (rel 778 x1 x6) (ex x7 (= (+ z (s x7)) x6))))))
(listind x1 (-> (all x2 (-> (rel 777 x2 x1) (& (ex x3 (= (+ (s z) (s x3)) x2)) (all x4 (-> (ex x5 (= (* x5 x4) x2)) (or (= x4 (s z)) (= x4 x2))))))) (all x6 (-> (rel 778 x1 x6) (ex x7 (= (+ z (s x7)) x6))))) (lam h8 (all x9 (-> (rel 777 x9 nil) (& (ex x10 (= (+ (s z) (s x10)) x9)) (all x11 (-> (ex x12 (= (* x12 x11) x9)) (or (= x11 (s z)) (= x11 x9))))))) (gen x13 (lam h14 (rel 778 nil x13) (wit x15 (= (+ z (s x15)) x13) z (app (inst (inst (use 0) x13) (s z)) (prodnilinv h14)))))) (gen x16 (gen x17 (lam h18 (-> (all x19 (-> (rel 777 x19 x17) (& (ex x20 (= (+ (s z) (s x20)) x19)) (all x21 (-> (ex x22 (= (* x22 x21) x19)) (or (= x21 (s z)) (= x21 x19))))))) (all x23 (-> (rel 778 x17 x23) (ex x24 (= (+ z (s x24)) x23))))) (lam h25 (all x26 (-> (rel 777 x26 (cons x16 x17)) (& (ex x27 (= (+ (s z) (s x27)) x26)) (all x28 (-> (ex x29 (= (* x29 x28) x26)) (or (= x28 (s z)) (= x28 x26))))))) (gen x30 (lam h31 (rel 778 (cons x16 x17) x30) (unpack (prodconsinv h31) (gen x32 (lam h33 (& (= x30 (* x16 x32)) (rel 778 x17 x32)) (eqelim x34 (ex x35 (= (+ z (s x35)) x34)) (app (inst (inst (use 0) x30) (* x16 x32)) (fst h33)) (app (app (inst (inst (use 2) x16) x32) (unpack (fst (app (inst h25 x16) (memhead x16 x17))) (gen x36 (lam h37 (= (+ (s z) (s x36)) x16) (wit x38 (= (+ z (s x38)) x16) (s x36) h37))))) (app (inst (app h18 (gen x39 (lam h40 (rel 777 x39 x17) (app (inst h25 x39) (memtail x16 h40))))) x32) (snd h33))))))))))))))
