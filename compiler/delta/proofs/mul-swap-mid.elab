; mul-swap-mid: a*(b*c) = b*(a*c) -- the multiplicative rearrangement the FTA-uniqueness
; ProdIs-carrying surgery needs (h*(p*q) = p*(h*q)). From commutativity (use 15) and
; associativity (use 22): a*(b*c) = (a*b)*c = (b*a)*c = b*(a*c), via cong-left (use 23) + trans.
; (eq-symm = use 0, eq-trans = use 1, both inherited from the mult-comm prelude.)
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 2 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 3 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 4 (all x1 (all x2 (-> (= (+ x1 x2) z) (= x1 z)))) (natind x3 (all x4 (-> (= (+ x3 x4) z) (= x3 z))) (gen x5 (lam h6 (= (+ z x5) z) (refl z))) (gen x7 (lam h8 (all x9 (-> (= (+ x7 x9) z) (= x7 z))) (gen x10 (lam h11 (= (+ (s x7) x10) z) (absurd (= (s x7) z) (disj (app (app (inst (inst (inst (use 3) z) (+ (s x7) x10)) (s (+ x7 x10))) (app (inst (inst (use 2) (+ (s x7) x10)) z) h11)) (refl (+ (s x7) x10)))))))))))
(def 5 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 6 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 7 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 8 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 9 (all x1 (all x2 (-> (= x1 x2) (= (s x1) (s x2))))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= (s x3) (s x6)) h5 (refl (s x3)))))))
(def 10 (all x1 (all x2 (= (+ x2 (s x1)) (s (+ x2 x1))))) (gen x3 (natind x4 (= (+ x4 (s x3)) (s (+ x4 x3))) (refl (s x3)) (gen x5 (lam h6 (= (+ x5 (s x3)) (s (+ x5 x3))) (eqelim x7 (= (s (+ x5 (s x3))) (s x7)) h6 (refl (s (+ x5 (s x3))))))))))
(def 11 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(def 12 (all x1 (all x2 (= (+ x2 x1) (+ x1 x2)))) (gen x3 (natind x4 (= (+ x4 x3) (+ x3 x4)) (eqelim x5 (= x5 (+ x3 z)) (inst (use 5) x3) (refl (+ x3 z))) (gen x6 (lam h7 (= (+ x6 x3) (+ x3 x6)) (app (app (inst (inst (inst (use 7) (s (+ x6 x3))) (s (+ x3 x6))) (+ x3 (s x6))) (eqelim x8 (= (s (+ x6 x3)) (s x8)) h7 (refl (s (+ x6 x3))))) (app (inst (inst (use 6) (+ x3 (s x6))) (s (+ x3 x6))) (inst (inst (use 10) x6) x3))))))))
(def 13 (all x1 (all x2 (= (* x1 (s x2)) (+ (* x1 x2) x1)))) (natind x3 (all x4 (= (* x3 (s x4)) (+ (* x3 x4) x3))) (gen x5 (refl z)) (gen x6 (lam h7 (all x8 (= (* x6 (s x8)) (+ (* x6 x8) x6))) (gen x9 (app (app (inst (inst (inst (use 7) (* (s x6) (s x9))) (s (+ (+ x9 (* x6 x9)) x6))) (+ (+ x9 (* x6 x9)) (s x6))) (app (app (inst (inst (inst (use 7) (* (s x6) (s x9))) (+ (s x9) (+ (* x6 x9) x6))) (s (+ (+ x9 (* x6 x9)) x6))) (eqelim x10 (= (* (s x6) (s x9)) (+ (s x9) x10)) (inst h7 x9) (refl (* (s x6) (s x9))))) (app (inst (inst (use 9) (+ x9 (+ (* x6 x9) x6))) (+ (+ x9 (* x6 x9)) x6)) (app (inst (inst (use 6) (+ (+ x9 (* x6 x9)) x6)) (+ x9 (+ (* x6 x9) x6))) (inst (inst (inst (use 8) (* x6 x9)) x6) x9))))) (app (inst (inst (use 6) (+ (+ x9 (* x6 x9)) (s x6))) (s (+ (+ x9 (* x6 x9)) x6))) (inst (inst (use 11) (+ x9 (* x6 x9))) x6))))))))
(def 14 (all x1 (= (* x1 z) z)) (natind x2 (= (* x2 z) z) (refl z) (gen x3 (lam h4 (= (* x3 z) z) h4))))
(def 15 (all x1 (all x2 (= (* x2 x1) (* x1 x2)))) (gen x3 (natind x4 (= (* x4 x3) (* x3 x4)) (app (inst (inst (use 6) (* x3 z)) z) (inst (use 14) x3)) (gen x5 (lam h6 (= (* x5 x3) (* x3 x5)) (app (app (inst (inst (inst (use 7) (* (s x5) x3)) (+ x3 (* x3 x5))) (* x3 (s x5))) (eqelim x7 (= (* (s x5) x3) (+ x3 x7)) h6 (refl (* (s x5) x3)))) (app (app (inst (inst (inst (use 7) (+ x3 (* x3 x5))) (+ (* x3 x5) x3)) (* x3 (s x5))) (inst (inst (use 12) (* x3 x5)) x3)) (app (inst (inst (use 6) (* x3 (s x5))) (+ (* x3 x5) x3)) (inst (inst (use 13) x3) x5)))))))))
(def 16 (all a (all b (all c (= (+ (+ a b) c) (+ a (+ b c)))))) (natind a (all b (all c (= (+ (+ a b) c) (+ a (+ b c)))))     (gen b (gen c (refl (+ b c))))     (gen a2 (lam ih (all b (all c (= (+ (+ a2 b) c) (+ a2 (+ b c)))))       (gen b (gen c (eqelim hole (= (+ (+ (s a2) b) c) (s hole)) (inst* ih b c) (refl (+ (+ (s a2) b) c)))))))))
(def 17 (all x (all y (-> (= x y) (= y x)))) (gen x (gen y (lam h (= x y) (eqelim hole (= hole x) h (refl x))))))
(def 18 (all x (all y (all z (-> (= x y) (-> (= y z) (= x z)))))) (gen x (gen y (gen z (lam h1 (= x y) (lam h2 (= y z) (eqelim hole (= x hole) h2 h1)))))))
(def 19 (all x (all y (= (+ (s x) y) (s (+ x y))))) (gen x (gen y (refl (+ (s x) y)))))
(def 20 (all x (all y (= (* (s x) y) (+ y (* x y))))) (gen x (gen y (refl (* (s x) y)))))
(def 21 (all x (all y (all z (= (* (+ x y) z) (+ (* x z) (* y z)))))) (natind x (all y (all z (= (* (+ x y) z) (+ (* x z) (* y z)))))   (gen y (gen z (refl (* y z))))   (gen x2 (lam ih (all y (all z (= (* (+ x2 y) z) (+ (* x2 z) (* y z)))))     (gen y (gen z       (app* (inst* (use 18) (* (+ (s x2) y) z) (* (s (+ x2 y)) z) (+ (* (s x2) z) (* y z)))             (eqelim hole (= (* (+ (s x2) y) z) (* hole z)) (inst* (use 19) x2 y) (refl (* (+ (s x2) y) z)))             (app* (inst* (use 18) (* (s (+ x2 y)) z) (+ z (* (+ x2 y) z)) (+ (* (s x2) z) (* y z)))                   (inst* (use 20) (+ x2 y) z)                   (app* (inst* (use 18) (+ z (* (+ x2 y) z)) (+ z (+ (* x2 z) (* y z))) (+ (* (s x2) z) (* y z)))                         (eqelim hole (= (+ z (* (+ x2 y) z)) (+ z hole)) (inst* ih y z) (refl (+ z (* (+ x2 y) z))))                         (app* (inst* (use 18) (+ z (+ (* x2 z) (* y z))) (+ (+ z (* x2 z)) (* y z)) (+ (* (s x2) z) (* y z)))                               (app (inst* (use 17) (+ (+ z (* x2 z)) (* y z)) (+ z (+ (* x2 z) (* y z)))) (inst* (use 16) z (* x2 z) (* y z)))                               (eqelim hole (= (+ (+ z (* x2 z)) (* y z)) (+ hole (* y z)))                                  (app (inst* (use 17) (* (s x2) z) (+ z (* x2 z))) (inst* (use 20) x2 z))                                  (refl (+ (+ z (* x2 z)) (* y z)))))))))))) ))
(def 22 (all a (all b (all c (= (* (* a b) c) (* a (* b c)))))) (natind a (all b (all c (= (* (* a b) c) (* a (* b c)))))   (gen b (gen c (refl (* 0 (* b c)))))   (gen a2 (lam ih (all b (all c (= (* (* a2 b) c) (* a2 (* b c)))))     (gen b (gen c       (app* (inst* (use 18) (* (* (s a2) b) c) (* (+ b (* a2 b)) c) (* (s a2) (* b c)))             (eqelim hole (= (* (* (s a2) b) c) (* hole c)) (inst* (use 20) a2 b) (refl (* (* (s a2) b) c)))             (app* (inst* (use 18) (* (+ b (* a2 b)) c) (+ (* b c) (* (* a2 b) c)) (* (s a2) (* b c)))                   (inst* (use 21) b (* a2 b) c)                   (app* (inst* (use 18) (+ (* b c) (* (* a2 b) c)) (+ (* b c) (* a2 (* b c))) (* (s a2) (* b c)))                         (eqelim hole (= (+ (* b c) (* (* a2 b) c)) (+ (* b c) hole)) (inst* ih b c) (refl (+ (* b c) (* (* a2 b) c))))                         (app (inst* (use 17) (* (s a2) (* b c)) (+ (* b c) (* a2 (* b c)))) (inst* (use 20) a2 (* b c))))))))))))
(def 23 (all x (all y (all c (-> (= x y) (= (* x c) (* y c)))))) (gen x (gen y (gen c (lam h (= x y) (eqelim w (= (* x c) (* w c)) h (refl (* x c))))))))
(all a (all b (all c (= (* a (* b c)) (* b (* a c))))))
(gen a (gen b (gen c (app (app (inst (inst (inst (use 1) (* a (* b c))) (* (* b a) c)) (* b (* a c))) (app (app (inst (inst (inst (use 1) (* a (* b c))) (* (* a b) c)) (* (* b a) c)) (app (inst (inst (use 0) (* (* a b) c)) (* a (* b c))) (inst (inst (inst (use 22) a) b) c))) (app (inst (inst (inst (use 23) (* a b)) (* b a)) c) (inst (inst (use 15) b) a)))) (inst (inst (inst (use 22) b) a) c)))))
