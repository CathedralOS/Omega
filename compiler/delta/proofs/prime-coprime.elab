; a prime is coprime to any non-multiple: prime(p) & not(p|a) -> gcd(p,a)=1
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 2 (all x1 (= (* x1 (s z)) x1)) (natind x2 (= (* x2 (s z)) x2) (refl z) (gen x3 (lam h4 (= (* x3 (s z)) x3) (eqelim x5 (= (s (* x3 (s z))) (s x5)) h4 (refl (s (* x3 (s z)))))))))
(def 3 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 4 (all x1 (= (* (s z) x1) x1)) (gen x2 (inst (use 3) x2)))
(all x1 (all x2 (-> (& (ex x3 (= (+ (s z) (s x3)) x1)) (all x4 (-> (ex x5 (= (* x5 x4) x1)) (or (= x4 (s z)) (= x4 x1))))) (-> (-> (ex x6 (= (* x6 x1) x2)) bot) (& (ex x7 (= (* x7 (s z)) x1)) (& (ex x8 (= (* x8 (s z)) x2)) (all x9 (-> (ex x10 (= (* x10 x9) x1)) (-> (ex x11 (= (* x11 x9) x2)) (ex x12 (= (* x12 x9) (s z))))))))))))
(gen x1 (gen x2 (lam h3 (& (ex x4 (= (+ (s z) (s x4)) x1)) (all x5 (-> (ex x6 (= (* x6 x5) x1)) (or (= x5 (s z)) (= x5 x1))))) (lam h7 (-> (ex x8 (= (* x8 x1) x2)) bot) (pair (wit x9 (= (* x9 (s z)) x1) x1 (inst (use 2) x1)) (pair (wit x10 (= (* x10 (s z)) x2) x2 (inst (use 2) x2)) (gen x11 (lam h12 (ex x13 (= (* x13 x11) x1)) (lam h14 (ex x15 (= (* x15 x11) x2)) (case (app (inst (snd h3) x11) h12) (lam h16 (= x11 (s z)) (wit x17 (= (* x17 x11) (s z)) (s z) (app (app (inst (inst (inst (use 1) (* (s z) x11)) x11) (s z)) (inst (use 4) x11)) h16))) (lam h18 (= x11 x1) (absurd (ex x19 (= (* x19 x11) (s z))) (app h7 (eqelim x20 (ex x21 (= (* x21 x20) x2)) h18 h14))))))))))))))
