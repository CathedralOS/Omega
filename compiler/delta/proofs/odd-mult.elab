; odd(a) & odd(b) -> odd(a*b)  (odd n := exists k. n = s(k+k) = 2k+1)
; Completes the parity multiplication table: even*x=even is banked (even-mult); this is the odd*odd corner.
; a=s(j+j), so a*b = b + (jb+jb) [mul-succ + right-distrib]; b=s(k+k) makes a*b = s((k+k)+(jb+jb)),
; and the interchange (k+k)+(jb+jb) = (k+jb)+(k+jb) [assoc+comm] gives the witness m = k + j*b.
(def 0 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 1 (all x1 (all x2 (= (+ x2 (s x1)) (s (+ x2 x1))))) (gen x3 (natind x4 (= (+ x4 (s x3)) (s (+ x4 x3))) (refl (s x3)) (gen x5 (lam h6 (= (+ x5 (s x3)) (s (+ x5 x3))) (eqelim x7 (= (s (+ x5 (s x3))) (s x7)) h6 (refl (s (+ x5 (s x3))))))))))
(def 2 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 3 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 4 (all x1 (all x2 (= (+ x2 x1) (+ x1 x2)))) (gen x3 (natind x4 (= (+ x4 x3) (+ x3 x4)) (eqelim x5 (= x5 (+ x3 z)) (inst (use 0) x3) (refl (+ x3 z))) (gen x6 (lam h7 (= (+ x6 x3) (+ x3 x6)) (app (app (inst (inst (inst (use 3) (s (+ x6 x3))) (s (+ x3 x6))) (+ x3 (s x6))) (eqelim x8 (= (s (+ x6 x3)) (s x8)) h7 (refl (s (+ x6 x3))))) (app (inst (inst (use 2) (+ x3 (s x6))) (s (+ x3 x6))) (inst (inst (use 1) x6) x3))))))))
(def 5 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 6 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 7 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 8 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 9 (all x1 (all x2 (all x3 (= (* (+ x3 x1) x2) (+ (* x3 x2) (* x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (* (+ x6 x4) x5) (+ (* x6 x5) (* x4 x5))) (refl (* x4 x5)) (gen x7 (lam h8 (= (* (+ x7 x4) x5) (+ (* x7 x5) (* x4 x5))) (app (app (inst (inst (inst (use 8) (+ x5 (* (+ x7 x4) x5))) (+ x5 (+ (* x7 x5) (* x4 x5)))) (+ (+ x5 (* x7 x5)) (* x4 x5))) (eqelim x9 (= (+ x5 (* (+ x7 x4) x5)) (+ x5 x9)) h8 (refl (+ x5 (* (+ x7 x4) x5))))) (app (inst (inst (use 7) (+ (+ x5 (* x7 x5)) (* x4 x5))) (+ x5 (+ (* x7 x5) (* x4 x5)))) (inst (inst (inst (use 6) (* x7 x5)) (* x4 x5)) x5)))))))))
(def 10 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 11 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 12 (all x1 (all x2 (= (+ (s x1) x2) (s (+ x1 x2))))) (gen x3 (gen x4 (refl (+ (s x3) x4)))))
(def 13 (all x1 (all x2 (= (* (s x1) x2) (+ x2 (* x1 x2))))) (gen x3 (gen x4 (refl (* (s x3) x4)))))
(all x1 (all x2 (-> (ex x3 (= x1 (s (+ x3 x3)))) (-> (ex x4 (= x2 (s (+ x4 x4)))) (ex x5 (= (* x1 x2) (s (+ x5 x5))))))))
(gen x1 (gen x2 (lam h3 (ex x4 (= x1 (s (+ x4 x4)))) (unpack h3 (gen x5 (lam h6 (= x1 (s (+ x5 x5))) (lam h7 (ex x8 (= x2 (s (+ x8 x8)))) (unpack h7 (gen x9 (lam h10 (= x2 (s (+ x9 x9))) (wit x11 (= (* x1 x2) (s (+ x11 x11))) (+ x9 (* x5 x2)) (app (app (inst (inst (inst (use 11) (* x1 x2)) (s (+ (+ x9 x9) (+ (* x5 x2) (* x5 x2))))) (s (+ (+ x9 (* x5 x2)) (+ x9 (* x5 x2))))) (app (app (inst (inst (inst (use 11) (* x1 x2)) (+ (s (+ x9 x9)) (+ (* x5 x2) (* x5 x2)))) (s (+ (+ x9 x9) (+ (* x5 x2) (* x5 x2))))) (app (app (inst (inst (inst (use 11) (* x1 x2)) (+ x2 (+ (* x5 x2) (* x5 x2)))) (+ (s (+ x9 x9)) (+ (* x5 x2) (* x5 x2)))) (app (app (inst (inst (inst (use 11) (* x1 x2)) (+ x2 (* (+ x5 x5) x2))) (+ x2 (+ (* x5 x2) (* x5 x2)))) (app (app (inst (inst (inst (use 11) (* x1 x2)) (* (s (+ x5 x5)) x2)) (+ x2 (* (+ x5 x5) x2))) (eqelim x12 (= (* x1 x2) (* x12 x2)) h6 (refl (* x1 x2)))) (inst (inst (use 13) (+ x5 x5)) x2))) (eqelim x13 (= (+ x2 (* (+ x5 x5) x2)) (+ x2 x13)) (inst (inst (inst (use 9) x5) x2) x5) (refl (+ x2 (* (+ x5 x5) x2)))))) (eqelim x14 (= (+ x2 (+ (* x5 x2) (* x5 x2))) (+ x14 (+ (* x5 x2) (* x5 x2)))) h10 (refl (+ x2 (+ (* x5 x2) (* x5 x2))))))) (inst (inst (use 12) (+ x9 x9)) (+ (* x5 x2) (* x5 x2))))) (eqelim x15 (= (s (+ (+ x9 x9) (+ (* x5 x2) (* x5 x2)))) (s x15)) (app (inst (inst (use 10) (+ (+ x9 (* x5 x2)) (+ x9 (* x5 x2)))) (+ (+ x9 x9) (+ (* x5 x2) (* x5 x2)))) (app (app (inst (inst (inst (use 11) (+ (+ x9 (* x5 x2)) (+ x9 (* x5 x2)))) (+ x9 (+ x9 (+ (* x5 x2) (* x5 x2))))) (+ (+ x9 x9) (+ (* x5 x2) (* x5 x2)))) (app (app (inst (inst (inst (use 11) (+ (+ x9 (* x5 x2)) (+ x9 (* x5 x2)))) (+ x9 (+ (* x5 x2) (+ x9 (* x5 x2))))) (+ x9 (+ x9 (+ (* x5 x2) (* x5 x2))))) (inst (inst (inst (use 5) (* x5 x2)) (+ x9 (* x5 x2))) x9)) (eqelim x16 (= (+ x9 (+ (* x5 x2) (+ x9 (* x5 x2)))) (+ x9 x16)) (app (app (inst (inst (inst (use 11) (+ (* x5 x2) (+ x9 (* x5 x2)))) (+ (+ x9 (* x5 x2)) (* x5 x2))) (+ x9 (+ (* x5 x2) (* x5 x2)))) (app (app (inst (inst (inst (use 11) (+ (* x5 x2) (+ x9 (* x5 x2)))) (+ (+ (* x5 x2) x9) (* x5 x2))) (+ (+ x9 (* x5 x2)) (* x5 x2))) (app (inst (inst (use 10) (+ (+ (* x5 x2) x9) (* x5 x2))) (+ (* x5 x2) (+ x9 (* x5 x2)))) (inst (inst (inst (use 5) x9) (* x5 x2)) (* x5 x2)))) (eqelim x17 (= (+ (+ (* x5 x2) x9) (* x5 x2)) (+ x17 (* x5 x2))) (inst (inst (use 4) x9) (* x5 x2)) (refl (+ (+ (* x5 x2) x9) (* x5 x2)))))) (inst (inst (inst (use 5) (* x5 x2)) (* x5 x2)) x9)) (refl (+ x9 (+ (* x5 x2) (+ x9 (* x5 x2)))))))) (app (inst (inst (use 10) (+ (+ x9 x9) (+ (* x5 x2) (* x5 x2)))) (+ x9 (+ x9 (+ (* x5 x2) (* x5 x2))))) (inst (inst (inst (use 5) x9) (+ (* x5 x2) (* x5 x2))) x9)))) (refl (s (+ (+ x9 x9) (+ (* x5 x2) (* x5 x2))))))))))))))))))
