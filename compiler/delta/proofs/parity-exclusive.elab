; a number is NOT both even and odd: even m & odd m -> bot.
; even m := exists j. m = j+j ; odd m := exists k. m = s(k+k). The crux is the core lemma
; CORE: j+j = s(k+k) -> bot, by induction on j. Base: 0 = s(k+k) contradicts zero<>succ (via
; lt-not-zero, which yields bot). Step: (Sj')+(Sj') = s(s(j'+j')) [DBL_S, from right-succ]; sinj
; reduces the goal to s(j'+j') = k+k, then case k: k=0 gives s(..)=0 -> bot; k=Sk' gives (after
; DBL_S + sinj) j'+j' = s(k'+k'), closed by the IH. The well-definedness of parity -- the result
; that underwrites square-parity (even n^2 -> even n) and the irrationality-of-sqrt2 style arguments.
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 2 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 3 (all x1 (all x2 (-> (= (+ x1 x2) z) (= x1 z)))) (natind x3 (all x4 (-> (= (+ x3 x4) z) (= x3 z))) (gen x5 (lam h6 (= (+ z x5) z) (refl z))) (gen x7 (lam h8 (all x9 (-> (= (+ x7 x9) z) (= x7 z))) (gen x10 (lam h11 (= (+ (s x7) x10) z) (absurd (= (s x7) z) (disj (app (app (inst (inst (inst (use 1) z) (+ (s x7) x10)) (s (+ x7 x10))) (app (inst (inst (use 0) (+ (s x7) x10)) z) h11)) (refl (+ (s x7) x10)))))))))))
(def 4 (all x1 (-> (ex x2 (= (+ x1 (s x2)) z)) bot)) (gen x3 (lam h4 (ex x5 (= (+ x3 (s x5)) z)) (unpack h4 (gen x6 (lam h7 (= (+ x3 (s x6)) z) (disj (app (inst (inst (use 0) (+ z (s x6))) z) (eqelim x8 (= (+ x8 (s x6)) z) (app (inst (inst (use 3) x3) (s x6)) h7) h7)))))))))
(def 5 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(def 6 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 7 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 8 (all x1 (= (+ (s x1) (s x1)) (s (s (+ x1 x1))))) (gen x2 (eqelim x3 (= (+ (s x2) (s x2)) (s x3)) (inst (inst (use 5) x2) x2) (refl (+ (s x2) (s x2))))))
(def 9 (all x1 (or (= x1 z) (ex x2 (= x1 (s x2))))) (natind x3 (or (= x3 z) (ex x4 (= x3 (s x4)))) (inl (ex x5 (= z (s x5))) (refl z)) (gen x6 (lam h7 (or (= x6 z) (ex x8 (= x6 (s x8)))) (inr (= (s x6) z) (wit x9 (= (s x6) (s x9)) x6 (refl (s x6))))))))
(def 10 (all x1 (all x2 (-> (= (+ x1 x1) (s (+ x2 x2))) bot))) (natind x3 (all x4 (-> (= (+ x3 x3) (s (+ x4 x4))) bot)) (gen x5 (lam h6 (= (+ z z) (s (+ x5 x5))) (app (inst (use 4) z) (wit x7 (= (+ z (s x7)) z) (+ x5 x5) (app (inst (inst (use 6) (+ z z)) (s (+ x5 x5))) h6))))) (gen x8 (lam h9 (all x10 (-> (= (+ x8 x8) (s (+ x10 x10))) bot)) (gen x11 (lam h12 (= (+ (s x8) (s x8)) (s (+ x11 x11))) (case (inst (use 9) x11) (lam h13 (= x11 z) (app (inst (use 4) z) (wit x14 (= (+ z (s x14)) z) (+ x8 x8) (eqelim x15 (= (s (+ x8 x8)) (+ x15 x15)) h13 (sinj (app (app (inst (inst (inst (use 7) (s (s (+ x8 x8)))) (+ (s x8) (s x8))) (s (+ x11 x11))) (app (inst (inst (use 6) (+ (s x8) (s x8))) (s (s (+ x8 x8)))) (inst (use 8) x8))) h12)))))) (lam h16 (ex x17 (= x11 (s x17))) (unpack h16 (gen x18 (lam h19 (= x11 (s x18)) (app (inst h9 x18) (sinj (app (app (inst (inst (inst (use 7) (s (+ x8 x8))) (+ (s x18) (s x18))) (s (s (+ x18 x18)))) (eqelim x20 (= (s (+ x8 x8)) (+ x20 x20)) h19 (sinj (app (app (inst (inst (inst (use 7) (s (s (+ x8 x8)))) (+ (s x8) (s x8))) (s (+ x11 x11))) (app (inst (inst (use 6) (+ (s x8) (s x8))) (s (s (+ x8 x8)))) (inst (use 8) x8))) h12)))) (inst (use 8) x18)))))))))))))))
(all x1 (-> (ex x2 (= x1 (+ x2 x2))) (-> (ex x3 (= x1 (s (+ x3 x3)))) bot)))
(gen x1 (lam h2 (ex x3 (= x1 (+ x3 x3))) (lam h4 (ex x5 (= x1 (s (+ x5 x5)))) (unpack h2 (gen x6 (lam h7 (= x1 (+ x6 x6)) (unpack h4 (gen x8 (lam h9 (= x1 (s (+ x8 x8))) (app (inst (inst (use 10) x6) x8) (app (app (inst (inst (inst (use 7) (+ x6 x6)) x1) (s (+ x8 x8))) (app (inst (inst (use 6) x1) (+ x6 x6)) h7)) h9)))))))))))
