; refinement-subtyping VC: offsetting a bounded value shifts its range.
;   a<=x & x<=b -> a+c<=x+c & x+c<=b+c   (x : {a..b} implies x+c : {a+c..b+c})
; two applications of le-add-mono-right (a<=b -> a+c<=b+c), paired. The obligation Omega emits for `x + c` arithmetic on a refinement-bounded value.
(def 0 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 1 (all x1 (all x2 (= (+ x2 (s x1)) (s (+ x2 x1))))) (gen x3 (natind x4 (= (+ x4 (s x3)) (s (+ x4 x3))) (refl (s x3)) (gen x5 (lam h6 (= (+ x5 (s x3)) (s (+ x5 x3))) (eqelim x7 (= (s (+ x5 (s x3))) (s x7)) h6 (refl (s (+ x5 (s x3))))))))))
(def 2 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 3 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 4 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 5 (all x1 (all x2 (= (+ x2 x1) (+ x1 x2)))) (gen x3 (natind x4 (= (+ x4 x3) (+ x3 x4)) (eqelim x5 (= x5 (+ x3 z)) (inst (use 0) x3) (refl (+ x3 z))) (gen x6 (lam h7 (= (+ x6 x3) (+ x3 x6)) (app (app (inst (inst (inst (use 3) (s (+ x6 x3))) (s (+ x3 x6))) (+ x3 (s x6))) (eqelim x8 (= (s (+ x6 x3)) (s x8)) h7 (refl (s (+ x6 x3))))) (app (inst (inst (use 2) (+ x3 (s x6))) (s (+ x3 x6))) (inst (inst (use 1) x6) x3))))))))
(def 6 (all x1 (all x2 (all x3 (-> (ex x4 (= (+ x1 x4) x2)) (ex x5 (= (+ (+ x1 x3) x5) (+ x2 x3))))))) (gen x6 (gen x7 (gen x8 (lam h9 (ex x10 (= (+ x6 x10) x7)) (unpack h9 (gen x11 (lam h12 (= (+ x6 x11) x7) (wit x13 (= (+ (+ x6 x8) x13) (+ x7 x8)) x11 (app (app (inst (inst (inst (use 3) (+ (+ x6 x8) x11)) (+ x6 (+ x8 x11))) (+ x7 x8)) (inst (inst (inst (use 4) x8) x11) x6)) (app (app (inst (inst (inst (use 3) (+ x6 (+ x8 x11))) (+ x6 (+ x11 x8))) (+ x7 x8)) (eqelim x14 (= (+ x6 (+ x8 x11)) (+ x6 x14)) (inst (inst (use 5) x11) x8) (refl (+ x6 (+ x8 x11))))) (app (app (inst (inst (inst (use 3) (+ x6 (+ x11 x8))) (+ (+ x6 x11) x8)) (+ x7 x8)) (app (inst (inst (use 2) (+ (+ x6 x11) x8)) (+ x6 (+ x11 x8))) (inst (inst (inst (use 4) x11) x8) x6))) (eqelim x15 (= (+ (+ x6 x11) x8) (+ x15 x8)) h12 (refl (+ (+ x6 x11) x8)))))))))))))))
(all x1 (all x2 (all x3 (all x4 (-> (ex x5 (= (+ x1 x5) x2)) (-> (ex x6 (= (+ x2 x6) x3)) (& (ex x7 (= (+ (+ x1 x4) x7) (+ x2 x4))) (ex x8 (= (+ (+ x2 x4) x8) (+ x3 x4))))))))))
(gen x1 (gen x2 (gen x3 (gen x4 (lam h5 (ex x6 (= (+ x1 x6) x2)) (lam h7 (ex x8 (= (+ x2 x8) x3)) (pair (app (inst (inst (inst (use 6) x1) x2) x4) h5) (app (inst (inst (inst (use 6) x2) x3) x4) h7))))))))
