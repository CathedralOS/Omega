; div recursive step: b+k=a & k=b*q+r -> a=b*Sq+r
(def 0 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 1 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(def 2 (all x1 (all x2 (-> (= x1 x2) (= (s x1) (s x2))))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= (s x3) (s x6)) h5 (refl (s x3)))))))
(def 3 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 4 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 5 (all x1 (all x2 (= (* x1 (s x2)) (+ (* x1 x2) x1)))) (natind x1 (all x2 (= (* x1 (s x2)) (+ (* x1 x2) x1))) (gen x3 (refl z)) (gen x4 (lam h5 (all x6 (= (* x4 (s x6)) (+ (* x4 x6) x4))) (gen x7 (app (app (inst (inst (inst (use 4) (* (s x4) (s x7))) (s (+ (+ x7 (* x4 x7)) x4))) (+ (+ x7 (* x4 x7)) (s x4))) (app (app (inst (inst (inst (use 4) (* (s x4) (s x7))) (+ (s x7) (+ (* x4 x7) x4))) (s (+ (+ x7 (* x4 x7)) x4))) (eqelim x8 (= (* (s x4) (s x7)) (+ (s x7) x8)) (inst h5 x7) (refl (* (s x4) (s x7))))) (app (inst (inst (use 2) (+ x7 (+ (* x4 x7) x4))) (+ (+ x7 (* x4 x7)) x4)) (app (inst (inst (use 3) (+ (+ x7 (* x4 x7)) x4)) (+ x7 (+ (* x4 x7) x4))) (inst (inst (inst (use 0) (* x4 x7)) x4) x7))))) (app (inst (inst (use 3) (+ (+ x7 (* x4 x7)) (s x4))) (s (+ (+ x7 (* x4 x7)) x4))) (inst (inst (use 1) (+ x7 (* x4 x7))) x4))))))))
(def 6 (all n (= (+ n 0) n)) (natind n (= (+ n 0) n) (refl 0) (gen n2 (lam ih (= (+ n2 0) n2) (eqelim hole (= (s (+ n2 0)) (s hole)) ih (refl (s (+ n2 0))))))))
(def 7 (all x (all y (= (+ (s x) y) (s (+ x y))))) (gen x (gen y (refl (+ (s x) y)))))
(def 8 (all a (all b (= (+ a b) (+ b a)))) (natind a (all b (= (+ a b) (+ b a)))   (gen b (app (inst* (use 3) (+ b 0) b) (inst (use 6) b)))   (gen a2 (lam ih (all b (= (+ a2 b) (+ b a2)))     (gen b (app* (inst* (use 4) (+ (s a2) b) (s (+ a2 b)) (+ b (s a2)))                  (inst* (use 7) a2 b)                  (app* (inst* (use 4) (s (+ a2 b)) (s (+ b a2)) (+ b (s a2)))                        (eqelim hole (= (s (+ a2 b)) (s hole)) (inst ih b) (refl (s (+ a2 b))))                        (app (inst* (use 3) (+ b (s a2)) (s (+ b a2))) (inst* (use 1) b a2)))))))))
(all a (all b (all q (all r (all k (-> (= (+ b k) a) (-> (= k (+ (* b q) r)) (= a (+ (* b (s q)) r))))))))) (gen a (gen b (gen q (gen r (gen k (lam h1 (= (+ b k) a) (lam h2 (= k (+ (* b q) r)) (app* (inst* (use 4) a (+ b k) (+ (* b (s q)) r)) (app (inst* (use 3) (+ b k) a) h1) (app* (inst* (use 4) (+ b k) (+ b (+ (* b q) r)) (+ (* b (s q)) r)) (eqelim hole (= (+ b k) (+ b hole)) h2 (refl (+ b k))) (app* (inst* (use 4) (+ b (+ (* b q) r)) (+ (+ b (* b q)) r) (+ (* b (s q)) r)) (app (inst* (use 3) (+ (+ b (* b q)) r) (+ b (+ (* b q) r))) (inst* (use 0) (* b q) r b)) (app* (inst* (use 4) (+ (+ b (* b q)) r) (+ (+ (* b q) b) r) (+ (* b (s q)) r)) (eqelim hole (= (+ (+ b (* b q)) r) (+ hole r)) (inst* (use 8) b (* b q)) (refl (+ (+ b (* b q)) r))) (eqelim hole (= (+ (+ (* b q) b) r) (+ hole r)) (app (inst* (use 3) (* b (s q)) (+ (* b q) b)) (inst* (use 5) b q)) (refl (+ (+ (* b q) b) r))))))))))))))
