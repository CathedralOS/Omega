; lt-le transitivity: i<m & m<=c -> i<c  (the array-bounds weakening lemma: a tighter index
; precondition i<m composes with a ground bound m<=count to discharge the real obligation i<count).
; Existential forms: i<m = ex w. i+(s w)=m ; m<=c = ex u. m+u=c ; i<c = ex v. i+(s v)=c.
; Witness v = w+u, then i+(s(w+u)) is convertible to i+((s w)+u), and add-assoc + the two
; hypotheses chain (i+((s w)+u) = (i+(s w))+u = m+u = c). No sinj -- the s lands where it is needed.
(def 0 (all x (all y (-> (= x y) (= y x))))
  (gen x (gen y (lam h (= x y) (eqelim hole (= hole x) h (refl x))))))
(def 1 (all x (all y (all z (-> (= x y) (-> (= y z) (= x z))))))
  (gen x (gen y (gen z (lam h1 (= x y) (lam h2 (= y z) (eqelim hole (= x hole) h2 h1)))))))
(def 2 (all a (all b (all c (= (+ (+ a b) c) (+ a (+ b c))))))
  (natind a (all b (all c (= (+ (+ a b) c) (+ a (+ b c)))))
    (gen b (gen c (refl (+ b c))))
    (gen a2 (lam ih (all b (all c (= (+ (+ a2 b) c) (+ a2 (+ b c)))))
      (gen b (gen c (eqelim hole (= (+ (+ (s a2) b) c) (s hole)) (inst* ih b c) (refl (+ (+ (s a2) b) c)))))))))
(all i (all m (all c (-> (ex w (= (+ i (s w)) m)) (-> (ex u (= (+ m u) c)) (ex v (= (+ i (s v)) c)))))))
(gen i (gen m (gen c (lam hlt (ex w (= (+ i (s w)) m)) (lam hle (ex u (= (+ m u) c))
  (unpack hlt (gen w (lam pw (= (+ i (s w)) m)
    (unpack hle (gen u (lam pu (= (+ m u) c)
      (wit v (= (+ i (s v)) c) (+ w u)
        (app* (inst* (use 1) (+ i (+ (s w) u)) (+ (+ i (s w)) u) c)
          (app (inst* (use 0) (+ (+ i (s w)) u) (+ i (+ (s w) u)))
            (inst* (use 2) i (s w) u))
          (app* (inst* (use 1) (+ (+ i (s w)) u) (+ m u) c)
            (eqelim hole (= (+ (+ i (s w)) u) (+ hole u)) pw (refl (+ (+ i (s w)) u)))
            pu))))))))))))))
