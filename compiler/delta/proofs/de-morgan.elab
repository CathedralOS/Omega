; de-morgan.elab — DE MORGAN'S LAWS for the decidable Boolean the lattice's decision procedures use (le/nateq/
; contains all return this user Bool True=k80/False=k81):
;   (1) not(and(a,b)) = or(not a, not b)      (2) not(or(a,b)) = and(not a, not b)
; A Boolean-algebra result, distinct from the arithmetic/order/list themes. Proof: induction on a — each arm
; reduces DEFINITIONALLY to a single refl (no split on b needed): e.g. a=True in (1) makes both sides not(b),
; a=False makes both sides True. and(True,b)=b/and(False,b)=False, or(True,b)=True/or(False,b)=b, not(T)=F/not(F)=T.
(data 80 0 0 0) (data 81 0 0 0)
(fun 27 80 (y 0)) (fun 27 81 (k 81))          ; and(True,b)=b ; and(False,b)=False
(fun 41 80 (k 81)) (fun 41 81 (k 80))          ; not(True)=False ; not(False)=True
(fun 42 80 (k 80)) (fun 42 81 (y 0))          ; or(True,b)=True ; or(False,b)=b

(& (all a (all b (= (f 41 (f 27 a b)) (f 42 (f 41 a) (f 41 b)))))
   (all a (all b (= (f 41 (f 42 a b)) (f 27 (f 41 a) (f 41 b))))))

(pair
  (rec 80 81 a (all b (= (f 41 (f 27 a b)) (f 42 (f 41 a) (f 41 b))))
    (gen b (refl (f 41 b)))
    (gen b (refl (k 80))))
  (rec 80 81 a (all b (= (f 41 (f 42 a b)) (f 27 (f 41 a) (f 41 b))))
    (gen b (refl (k 81)))
    (gen b (refl (f 41 b)))))
