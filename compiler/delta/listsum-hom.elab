; listsum-hom.elab — the MapReduce law for SUM: listsum distributes over list concatenation.
;
;     ∀xs ∀ys.  listsum(xs ++ ys)  =  listsum(xs) + listsum(ys)
;
; The additive-homomorphism foundation of divide-and-conquer / chunked aggregation: summing two chunks and
; adding equals summing the whole. Proved by induction on xs; the step is a single transitivity — rewrite
; listsum(t++ys) by the IH, then reassociate by sym(add-assoc). All user nats (k2/k3) / lists (k60/k61).

(data 2 0 0 0) (data 3 1 1 0) (data 60 0 0 0) (data 61 2 0 1)

(fun 21 2 (y 0)) (fun 21 3 (k 3 (rec 0)))                 ; uadd(0,n)=n ; uadd(s m,n)=s(uadd(m,n))
(fun 94 60 (k 2)) (fun 94 61 (f 21 (v 0) (rec 1)))        ; listsum(Nil)=0 ; listsum(Cons h t)=h+listsum(t)
(fun 62 60 (y 0)) (fun 62 61 (k 61 (v 0) (rec 1)))        ; append(Nil,ys)=ys ; append(Cons h t,ys)=Cons h (append t ys)

(all xs (all ys (= (f 94 (f 62 xs ys)) (f 21 (f 94 xs) (f 94 ys)))))

(have addassoc (all a (all b (all c (= (f 21 (f 21 a b) c) (f 21 a (f 21 b c))))))
  (rec 2 3 a (all b (all c (= (f 21 (f 21 a b) c) (f 21 a (f 21 b c)))))
    (gen b (gen c (refl (f 21 b c))))
    (gen a1 (lam ih (all b (all c (= (f 21 (f 21 a1 b) c) (f 21 a1 (f 21 b c)))))
      (gen b (gen c
        (eqelim x (= (k 3 (f 21 (f 21 a1 b) c)) (k 3 x)) (inst* ih b c) (refl (k 3 (f 21 (f 21 a1 b) c)))))))))
(rec 60 61 xs (all ys (= (f 94 (f 62 xs ys)) (f 21 (f 94 xs) (f 94 ys))))
  (gen ys (refl (f 94 ys)))                               ; base: listsum(Nil++ys) = listsum ys = 0+listsum ys
  (gen h (gen t (lam ih (all ys (= (f 94 (f 62 t ys)) (f 21 (f 94 t) (f 94 ys))))
    (gen ys
      ; LHS converts to  uadd(h, listsum(t++ys)) ; goal RHS = uadd(uadd(h, listsum t), listsum ys).
      ; trans: rewrite listsum(t++ys) -> uadd(listsum t, listsum ys) by IH, then sym(add-assoc).
      (eqelim x (= (f 21 h (f 94 (f 62 t ys))) x)
        (eqelim x (= x (f 21 (f 21 h (f 94 t)) (f 94 ys))) (inst* addassoc h (f 94 t) (f 94 ys)) (refl (f 21 (f 21 h (f 94 t)) (f 94 ys))))
        (eqelim x (= (f 21 h (f 94 (f 62 t ys))) (f 21 h x)) (inst ih ys) (refl (f 21 h (f 94 (f 62 t ys))))))))))))
