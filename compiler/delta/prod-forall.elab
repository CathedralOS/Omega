; prod-forall.elab — the MULTIPLICATIVE fold ∀-input theorem (factorial-style products over a list). Where
; sum-forall's fold ADDS the element, this MULTIPLIES by it:  prodfold(Cons h t, n) = prodfold(t, h*n).
; Proving it universal needs the user nat to be a commutative SEMIRING under uadd (already a comm monoid) and
; umul: mul-zero-right, mul-succ-right, mul-comm, right-distributivity, mul-assoc — each by induction. Then:
;
;     ∀xs ∀n.  prodfold(xs, n)  =  listprod(xs) * n
;
; All user nats (k2/k3) and user lists (k60/k61). uadd = fun 21, umul = fun 22, listprod = fun 98.

(data 2 0 0 0) (data 3 1 1 0) (data 60 0 0 0) (data 61 2 0 1)

(fun 21 2 (y 0)) (fun 21 3 (k 3 (rec 0)))                 ; uadd(0,n)=n ; uadd(s m,n)=s(uadd(m,n))
(fun 22 2 (k 2)) (fun 22 3 (f 21 (y 0) (rec 0)))          ; umul(0,n)=0 ; umul(s m,n)=uadd(n, umul(m,n))
(fun 98 60 (k 3 (k 2))) (fun 98 61 (f 22 (v 0) (rec 1)))  ; listprod(Nil)=1 ; listprod(Cons h t)=h*listprod(t)
(fun 99 60 (y 0)) (fun 99 61 (recx 1 (f 22 (v 0) (y 0)))) ; prodfold(Nil,n)=n ; (Cons h t,n)=prodfold(t, h*n)

(all xs (all n (= (f 99 xs n) (f 22 (f 98 xs) n))))

; --- uadd commutative monoid (reused from sum-forall) ---------------------------------------------------
(have add0r (all a (= (f 21 a (k 2)) a))
  (rec 2 3 a (= (f 21 a (k 2)) a)
    (refl (k 2))
    (gen a1 (lam ih (= (f 21 a1 (k 2)) a1)
      (eqelim x (= (k 3 (f 21 a1 (k 2))) (k 3 x)) ih (refl (k 3 (f 21 a1 (k 2))))))))
(have uaddsuc (all a (all b (= (f 21 a (k 3 b)) (k 3 (f 21 a b)))))
  (rec 2 3 a (all b (= (f 21 a (k 3 b)) (k 3 (f 21 a b))))
    (gen b (refl (k 3 b)))
    (gen a1 (lam ih (all b (= (f 21 a1 (k 3 b)) (k 3 (f 21 a1 b))))
      (gen b (eqelim x (= (k 3 (f 21 a1 (k 3 b))) (k 3 x)) (inst ih b) (refl (k 3 (f 21 a1 (k 3 b)))))))))
(have addcomm (all a (all b (= (f 21 a b) (f 21 b a))))
  (rec 2 3 a (all b (= (f 21 a b) (f 21 b a)))
    (gen b (eqelim x (= x (f 21 b (k 2))) (inst add0r b) (refl (f 21 b (k 2)))))
    (gen a1 (lam ih (all b (= (f 21 a1 b) (f 21 b a1)))
      (gen b
        (have s1 (= (k 3 (f 21 a1 b)) (k 3 (f 21 b a1)))
          (eqelim x (= (k 3 (f 21 a1 b)) (k 3 x)) (inst ih b) (refl (k 3 (f 21 a1 b))))
        (have s2 (= (k 3 (f 21 b a1)) (f 21 b (k 3 a1)))
          (eqelim x (= x (f 21 b (k 3 a1))) (inst* uaddsuc b a1) (refl (f 21 b (k 3 a1))))
          (eqelim x (= (k 3 (f 21 a1 b)) x) s2 s1)))))))
(have addassoc (all a (all b (all c (= (f 21 (f 21 a b) c) (f 21 a (f 21 b c))))))
  (rec 2 3 a (all b (all c (= (f 21 (f 21 a b) c) (f 21 a (f 21 b c)))))
    (gen b (gen c (refl (f 21 b c))))
    (gen a1 (lam ih (all b (all c (= (f 21 (f 21 a1 b) c) (f 21 a1 (f 21 b c)))))
      (gen b (gen c
        (eqelim x (= (k 3 (f 21 (f 21 a1 b) c)) (k 3 x)) (inst* ih b c) (refl (k 3 (f 21 (f 21 a1 b) c)))))))))

; --- umul is a commutative semiring over uadd -----------------------------------------------------------
(have mul0r (all a (= (f 22 a (k 2)) (k 2)))
  (rec 2 3 a (= (f 22 a (k 2)) (k 2))
    (refl (k 2))
    (gen a1 (lam ih (= (f 22 a1 (k 2)) (k 2)) ih)))
; swap-under-plus:  b + (a1 + P) = a1 + (b + P)   (a helper used by mul-succ-right)
(have mulsucr (all a (all b (= (f 22 a (k 3 b)) (f 21 a (f 22 a b)))))
  (rec 2 3 a (all b (= (f 22 a (k 3 b)) (f 21 a (f 22 a b))))
    (gen b (refl (k 2)))
    (gen a1 (lam ih (all b (= (f 22 a1 (k 3 b)) (f 21 a1 (f 22 a1 b))))
      (gen b
        (have viaih (= (f 22 a1 (k 3 b)) (f 21 a1 (f 22 a1 b))) (inst ih b)
        (have t1 (= (f 21 b (f 21 a1 (f 22 a1 b))) (f 21 (f 21 b a1) (f 22 a1 b)))
          (eqelim x (= x (f 21 (f 21 b a1) (f 22 a1 b))) (inst* addassoc b a1 (f 22 a1 b)) (refl (f 21 (f 21 b a1) (f 22 a1 b))))
        (have t2 (= (f 21 (f 21 b a1) (f 22 a1 b)) (f 21 (f 21 a1 b) (f 22 a1 b)))
          (eqelim x (= (f 21 (f 21 b a1) (f 22 a1 b)) (f 21 x (f 22 a1 b))) (inst* addcomm b a1) (refl (f 21 (f 21 b a1) (f 22 a1 b))))
        (have swap (= (f 21 b (f 21 a1 (f 22 a1 b))) (f 21 a1 (f 21 b (f 22 a1 b))))
          (eqelim x (= (f 21 b (f 21 a1 (f 22 a1 b))) x) (inst* addassoc a1 b (f 22 a1 b)) (eqelim x (= (f 21 b (f 21 a1 (f 22 a1 b))) x) t2 t1))
        (have stepA (= (k 3 (f 21 b (f 22 a1 (k 3 b)))) (k 3 (f 21 b (f 21 a1 (f 22 a1 b)))))
          (eqelim x (= (k 3 (f 21 b (f 22 a1 (k 3 b)))) (k 3 (f 21 b x))) viaih (refl (k 3 (f 21 b (f 22 a1 (k 3 b))))))
        (have stepB (= (k 3 (f 21 b (f 21 a1 (f 22 a1 b)))) (k 3 (f 21 a1 (f 21 b (f 22 a1 b)))))
          (eqelim x (= (k 3 (f 21 b (f 21 a1 (f 22 a1 b)))) (k 3 x)) swap (refl (k 3 (f 21 b (f 21 a1 (f 22 a1 b))))))
          (eqelim x (= (k 3 (f 21 b (f 22 a1 (k 3 b)))) x) stepB stepA)))))))))))
(have mulcomm (all a (all b (= (f 22 a b) (f 22 b a))))
  (rec 2 3 a (all b (= (f 22 a b) (f 22 b a)))
    (gen b (eqelim x (= x (f 22 b (k 2))) (inst mul0r b) (refl (f 22 b (k 2)))))
    (gen a1 (lam ih (all b (= (f 22 a1 b) (f 22 b a1)))
      (gen b
        (have viaih (= (f 21 b (f 22 a1 b)) (f 21 b (f 22 b a1)))
          (eqelim x (= (f 21 b (f 22 a1 b)) (f 21 b x)) (inst ih b) (refl (f 21 b (f 22 a1 b))))
        (have msr (= (f 22 b (k 3 a1)) (f 21 b (f 22 b a1))) (inst* mulsucr b a1)
          (eqelim x (= (f 21 b (f 22 a1 b)) x) (eqelim x (= x (f 22 b (k 3 a1))) msr (refl (f 22 b (k 3 a1)))) viaih)))))))
(have muldist (all a (all b (all c (= (f 22 (f 21 a b) c) (f 21 (f 22 a c) (f 22 b c))))))
  (rec 2 3 a (all b (all c (= (f 22 (f 21 a b) c) (f 21 (f 22 a c) (f 22 b c)))))
    (gen b (gen c (refl (f 22 b c))))
    (gen a1 (lam ih (all b (all c (= (f 22 (f 21 a1 b) c) (f 21 (f 22 a1 c) (f 22 b c)))))
      (gen b (gen c
        (have viaih (= (f 21 c (f 22 (f 21 a1 b) c)) (f 21 c (f 21 (f 22 a1 c) (f 22 b c))))
          (eqelim x (= (f 21 c (f 22 (f 21 a1 b) c)) (f 21 c x)) (inst* ih b c) (refl (f 21 c (f 22 (f 21 a1 b) c))))
        (have reassoc (= (f 21 c (f 21 (f 22 a1 c) (f 22 b c))) (f 21 (f 21 c (f 22 a1 c)) (f 22 b c)))
          (eqelim x (= x (f 21 (f 21 c (f 22 a1 c)) (f 22 b c))) (inst* addassoc c (f 22 a1 c) (f 22 b c)) (refl (f 21 (f 21 c (f 22 a1 c)) (f 22 b c))))
          (eqelim x (= (f 21 c (f 22 (f 21 a1 b) c)) x) reassoc viaih))))))))
(have mulassoc (all a (all b (all c (= (f 22 (f 22 a b) c) (f 22 a (f 22 b c))))))
  (rec 2 3 a (all b (all c (= (f 22 (f 22 a b) c) (f 22 a (f 22 b c)))))
    (gen b (gen c (refl (k 2))))
    (gen a1 (lam ih (all b (all c (= (f 22 (f 22 a1 b) c) (f 22 a1 (f 22 b c)))))
      (gen b (gen c
        (have dist (= (f 22 (f 21 b (f 22 a1 b)) c) (f 21 (f 22 b c) (f 22 (f 22 a1 b) c))) (inst* muldist b (f 22 a1 b) c)
        (have viaih (= (f 21 (f 22 b c) (f 22 (f 22 a1 b) c)) (f 21 (f 22 b c) (f 22 a1 (f 22 b c))))
          (eqelim x (= (f 21 (f 22 b c) (f 22 (f 22 a1 b) c)) (f 21 (f 22 b c) x)) (inst* ih b c) (refl (f 21 (f 22 b c) (f 22 (f 22 a1 b) c))))
          (eqelim x (= (f 22 (f 21 b (f 22 a1 b)) c) x) viaih dist))))))))

; --- the multiplicative fold theorem, by induction on xs ---
(rec 60 61 xs (all n (= (f 99 xs n) (f 22 (f 98 xs) n)))
  (gen n (eqelim x (= x (f 22 (f 98 (k 60)) n)) (inst add0r n) (refl (f 22 (f 98 (k 60)) n))))
  (gen h (gen t (lam ih (all n (= (f 99 t n) (f 22 (f 98 t) n)))
    (gen n
      ; LHS converts to  prodfold(t, h*n)  ; IH at (h*n):  = listprod(t) * (h*n)
      ; goal RHS = listprod(Cons h t) * n = (h * listprod t) * n
      ; bridge: listprod(t) * (h*n) = (h * listprod t) * n   [assoc + comm, multiplicative]
      (have s1 (= (f 22 (f 98 t) (f 22 h n)) (f 22 (f 22 (f 98 t) h) n))
        (eqelim x (= x (f 22 (f 22 (f 98 t) h) n)) (inst* mulassoc (f 98 t) h n) (refl (f 22 (f 22 (f 98 t) h) n)))
      (have s2 (= (f 22 (f 22 (f 98 t) h) n) (f 22 (f 22 h (f 98 t)) n))
        (eqelim x (= (f 22 (f 22 (f 98 t) h) n) (f 22 x n)) (inst* mulcomm (f 98 t) h) (refl (f 22 (f 22 (f 98 t) h) n)))
      (have bridge (= (f 22 (f 98 t) (f 22 h n)) (f 22 (f 22 h (f 98 t)) n))
        (eqelim x (= (f 22 (f 98 t) (f 22 h n)) x) s2 s1)
        (eqelim x (= (f 99 t (f 22 h n)) x) bridge (inst ih (f 22 h n))))))))))))))))))))
