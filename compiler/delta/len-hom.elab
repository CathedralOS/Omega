; len-hom.elab — the MapReduce law for COUNT: length distributes over list concatenation.
;
;     ∀xs ∀ys.  len(xs ++ ys)  =  len(xs) + len(ys)
;
; The count-homomorphism companion to listsum-hom. Proved by induction on xs; the step is a single
; congruence under successor (len's Cons case is s(len t), and uadd(s x, y) reduces to s(uadd x y)), so
; NO associativity lemma is needed. All user nats (k2/k3) / lists (k60/k61). len = fun 97, append = fun 62.

(data 2 0 0 0) (data 3 1 1 0) (data 60 0 0 0) (data 61 2 0 1)

(fun 21 2 (y 0)) (fun 21 3 (k 3 (rec 0)))                 ; uadd(0,n)=n ; uadd(s m,n)=s(uadd(m,n))
(fun 97 60 (k 2)) (fun 97 61 (k 3 (rec 1)))              ; len(Nil)=0 ; len(Cons h t)=s(len t)
(fun 62 60 (y 0)) (fun 62 61 (k 61 (v 0) (rec 1)))        ; append(Nil,ys)=ys ; append(Cons h t,ys)=Cons h (append t ys)

(all xs (all ys (= (f 97 (f 62 xs ys)) (f 21 (f 97 xs) (f 97 ys)))))

(rec 60 61 xs (all ys (= (f 97 (f 62 xs ys)) (f 21 (f 97 xs) (f 97 ys))))
  (gen ys (refl (f 97 ys)))                               ; base: len(Nil++ys) = len ys = 0+len ys
  (gen h (gen t (lam ih (all ys (= (f 97 (f 62 t ys)) (f 21 (f 97 t) (f 97 ys))))
    (gen ys
      ; LHS converts to s(len(t++ys)) ; RHS = s(len t)+len ys converts to s(len t + len ys). Congruence of IH under s.
      (eqelim x (= (k 3 (f 97 (f 62 t ys))) (k 3 x)) (inst ih ys) (refl (k 3 (f 97 (f 62 t ys))))))))))
