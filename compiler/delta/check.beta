; check.beta — a minimal Delta-rung certificate checker, written in Beta.
;
; This is the first appearance of the lattice's whole point (rungs/delta.md): a
; SMALL, hand-auditable checker that validates evidence. An untrusted, arbitrarily
; clever proof-SEARCH engine may produce certificates; this checker has the only
; authority — a false proposition cannot get past it, however the certificate was
; found.
;
; Full intuitionistic propositional natural deduction (implication, conjunction,
; disjunction, falsity — so ¬A = A -> ⊥) PLUS equality of Peano terms with a
; computation-aware `refl`. That last part is the CONVERSION RULE: an equation
; (= t1 t2) is provable by `refl` exactly when t1 and t2 reduce to the same normal
; form under the definitional rules — so "2+2 = 4" is proved by *computation*, and
; equations are first-class propositions that combine with ->, &, +, ⊥. This is
; the heart of how logic meets computation (the gamma/delta soundness seam), in a
; checker small enough to read.
;
; By Curry-Howard the checker IS a simply-typed lambda-calculus type checker (sums,
; products, function and void types) with a definitional-equality (conversion) rule:
;   proposition A -> B   =   function type A -> B        (implication / ->intro,elim)
;   proposition A & B    =   product type A x B          (conjunction / &intro,elim)
;   proposition A + B    =   sum type A + B              (disjunction / +intro,elim)
;   proposition ⊥        =   the empty type Void         (falsity / ex falso)
;   a proof of A         =   a term of type A
;   ->intro = lambda   ->elim = application(modus ponens)
;   &intro  = pair     &elim  = fst / snd     hypothesis = variable (de Bruijn)
;   +intro  = inl/inr  +elim  = case          ex falso = absurd
; So "does this certificate prove this proposition?" = "does this term have this
; type?" — decided by structural type inference. The checker accepts iff it does.
;
; Note on rungs: delta.md says the checker is a *Gamma* program (ADTs + pattern
; matching make it small). Gamma doesn't exist yet, so this is a Beta prototype —
; and writing it shows exactly what Gamma must provide: sum types for the term/type
; trees and pattern matching for infer(), both hand-encoded here as tagged nodes in
; raw memory with if-cascades. That is the motivation for the Gamma rung, made
; concrete.
;
; Input (stdin): a goal proposition, then a certificate term, in prefix syntax.
;   proposition := UPPERCASE | ( -> prop prop ) | ( & prop prop )
;                | ( + prop prop ) | ( bot ) | ( = nat nat )
;                | ( All prop ) | ( Exists prop ) | ( Pred id nat )    ; ∀, ∃, predicate
;   nat         := z | ( s nat ) | ( p nat nat ) | ( m nat nat ) | ( v k )
;                  ; Peano: zero, succ, plus, multiply, and (v k) = individual var
;   term        := ( hyp N ) | ( lam prop term ) | ( app term term )
;                | ( pair term term ) | ( fst term ) | ( snd term )
;                | ( inl prop term ) | ( inr prop term ) | ( case term term term )
;                | ( absurd prop term )           ; ex falso: prop from a ⊥-proof
;                | ( refl nat )                   ; proves (= t t) up to reduction
;                | ( gen term )                   ; ∀-intro (fresh individual var)
;                | ( inst term nat )              ; ∀-elim (instantiate at a closed nat)
;                | ( wit prop nat term )          ; ∃-intro (witness + proof of body[t])
;                | ( unpack term term )           ; ∃-elim (handler is a ∀(body -> C))
; Output: "accept\n" (exit 1) if the term proves the goal, else "reject\n" (exit 0).
; Example — the identity proof of P -> P :   (-> P P)  (lam P (hyp 0))   -> accept
;
; Memory:  2097152 SRC   2097144 CUR   2097136 LEN   2097128 APTR (arena bump)
;          2097120 CTXN (context depth)   3145728 ARENA   4194304 CTX (type stack)
; Nodes are 3 words [tag, f0, f1] at 24-byte stride. 0 is the reject/none sentinel
; (no real node lives at address 0).
;
; Tags:  type  0 ATOM(char) 1 ARROW(l,r) 2 AND(l,r) 3 FALSE 4 OR(l,r) 5 EQ(t1,t2)
;             6 ALL(body)  7 PRED(id,term)  8 EXISTS(body)
;        term 10 HYP(idx)   11 LAM(ty,body) 12 APP(f,a) 13 PAIR(a,b) 14 FST(p)
;             15 SND(p)     16 ABSURD(Cty,p) 17 INL(Bty,p) 18 INR(Aty,p)
;             19 CASE(p, aux)  20 REFL(t)  21 GEN(pf)  22 INST(pf,term)
;             23 WIT(body, (99 t pf))  24 UNPACK(epf, handler)
;        nat  30 ZERO  31 SUC(x)  32 PLUS(a,b)  33 MUL(a,b)  34 IVAR(k)

proc slurp() {
    let n = 0
    let c = read_byte()
    while c >= 0 {
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
    }
    word[2097136] = n            ; LEN
    word[2097144] = 0            ; CUR
    word[2097128] = 3145728      ; APTR = ARENA base
    word[2097120] = 0            ; CTXN
}

proc cbyte() {
    let i = word[2097144]
    if i < word[2097136] {
        return byte[2097152 + i]
    }
    return 0
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

proc is_space(c) {
    if c == ' ' {
        return 1
    }
    if c == 9 {
        return 1
    }
    if c == 10 {
        return 1
    }
    if c == 13 {
        return 1
    }
    return 0
}

proc skip_ws() {
    while is_space(cbyte()) == 1 {
        adv()
    }
}

proc is_digit(c) {
    if c < '0' {
        return 0
    }
    if c > '9' {
        return 0
    }
    return 1
}

proc is_upper(c) {
    if c < 'A' {
        return 0
    }
    if c > 'Z' {
        return 0
    }
    return 1
}

proc is_lower(c) {
    if c < 'a' {
        return 0
    }
    if c > 'z' {
        return 0
    }
    return 1
}

proc parse_number() {
    let v = 0
    while is_digit(cbyte()) == 1 {
        v = v * 10 + (cbyte() - '0')
        adv()
    }
    return v
}

; ---- Peano terms (for equality propositions): z, (s t), (p a b) ----
; tags 30 ZERO, 31 SUC(x), 32 PLUS(a,b). Definitional rules drive `refl` below.
proc parse_nat() {
    skip_ws()
    let a = 0
    let b = 0
    if cbyte() == 'z' {
        adv()
        return alloc(30, 0, 0)
    }
    adv()                        ; '('
    skip_ws()
    let op = cbyte()
    adv()
    if op == 's' {               ; (s x)
        a = parse_nat()
        skip_ws()
        adv()                    ; ')'
        return alloc(31, a, 0)
    }
    if op == 'm' {               ; (m a b) multiply
        a = parse_nat()
        b = parse_nat()
        skip_ws()
        adv()                    ; ')'
        return alloc(33, a, b)
    }
    if op == 'v' {               ; (v k) individual variable (de Bruijn)
        skip_ws()
        a = parse_number()
        skip_ws()
        adv()                    ; ')'
        return alloc(34, a, 0)
    }
    a = parse_nat()              ; (p a b) plus
    b = parse_nat()
    skip_ws()
    adv()                        ; ')'
    return alloc(32, a, b)
}

; reduce a Peano term to normal form, fuel-bounded (total — the slow ref route).
proc normalize(t, fuel) {
    if fuel < 1 {
        return t
    }
    let tag = word[t]
    if tag == 30 {
        return t
    }
    if tag == 34 {                              ; Ivar — a free individual var, normal
        return t
    }
    let a = 0
    let b = 0
    if tag == 31 {
        a = normalize(word[t + 8], fuel - 1)
        return alloc(31, a, 0)
    }
    if tag == 32 {                              ; (p a b)
        a = normalize(word[t + 8], fuel - 1)
        b = normalize(word[t + 16], fuel - 1)
        if word[a] == 30 {       ; p z b => b
            return b
        }
        if word[a] == 31 {       ; p (s x) b => s (p x b)
            a = normalize(alloc(32, word[a + 8], b), fuel - 1)
            return alloc(31, a, 0)
        }
        return alloc(32, a, b)
    }
    ; tag == 33 : (m a b)  -- m z y => z ; m (s x) y => p y (m x y)
    a = normalize(word[t + 8], fuel - 1)
    if word[a] == 30 {
        return alloc(30, 0, 0)
    }
    if word[a] == 31 {
        b = alloc(33, word[a + 8], word[t + 16])
        return normalize(alloc(32, word[t + 16], b), fuel - 1)
    }
    return alloc(33, a, word[t + 16])
}

proc nat_eq(a, b) {
    if word[a] != word[b] {
        return 0
    }
    if word[a] == 30 {
        return 1
    }
    if word[a] == 34 {                ; Ivar: equal iff same de Bruijn index
        if word[a + 8] == word[b + 8] {
            return 1
        }
        return 0
    }
    if word[a] == 31 {
        return nat_eq(word[a + 8], word[b + 8])
    }
    if nat_eq(word[a + 8], word[b + 8]) == 0 {
        return 0
    }
    return nat_eq(word[a + 16], word[b + 16])
}

; does an individual term / proposition mention any Ivar?  (gen's freshness guard)
proc ivar_in_term(t) {
    if word[t] == 34 {
        return 1
    }
    if word[t] == 30 {
        return 0
    }
    if word[t] == 31 {
        return ivar_in_term(word[t + 8])
    }
    if ivar_in_term(word[t + 8]) == 1 {
        return 1
    }
    return ivar_in_term(word[t + 16])
}

proc ivar_in_prop(p) {
    let tag = word[p]
    if tag == 0 {                     ; Atom
        return 0
    }
    if tag == 3 {                     ; Bot
        return 0
    }
    if tag == 7 {                     ; Pred id term
        return ivar_in_term(word[p + 16])
    }
    if tag == 5 {                     ; Eq t1 t2
        if ivar_in_term(word[p + 8]) == 1 {
            return 1
        }
        return ivar_in_term(word[p + 16])
    }
    if tag == 6 {                     ; All body
        return ivar_in_prop(word[p + 8])
    }
    if tag == 8 {                     ; Exists body
        return ivar_in_prop(word[p + 8])
    }
    if ivar_in_prop(word[p + 8]) == 1 {   ; Arrow/And/Or
        return 1
    }
    return ivar_in_prop(word[p + 16])
}

; substitute individual term `s` (assumed closed) for Ivar `depth`, in a term.
proc subst_term(t, s, depth) {
    if word[t] == 34 {
        if word[t + 8] == depth {
            return s
        }
        if word[t + 8] > depth {
            return alloc(34, word[t + 8] - 1, 0)
        }
        return t
    }
    if word[t] == 30 {
        return t
    }
    if word[t] == 31 {
        return alloc(31, subst_term(word[t + 8], s, depth), 0)
    }
    return alloc(word[t], subst_term(word[t + 8], s, depth), subst_term(word[t + 16], s, depth))
}

proc subst_prop(p, s, depth) {
    let tag = word[p]
    if tag == 0 {                     ; Atom
        return p
    }
    if tag == 3 {                     ; Bot
        return p
    }
    if tag == 7 {                     ; Pred id term
        return alloc(7, word[p + 8], subst_term(word[p + 16], s, depth))
    }
    if tag == 5 {                     ; Eq t1 t2
        return alloc(5, subst_term(word[p + 8], s, depth), subst_term(word[p + 16], s, depth))
    }
    if tag == 6 {                     ; All body — bound var deeper
        return alloc(6, subst_prop(word[p + 8], s, depth + 1), 0)
    }
    if tag == 8 {                     ; Exists body — bound var deeper
        return alloc(8, subst_prop(word[p + 8], s, depth + 1), 0)
    }
    return alloc(tag, subst_prop(word[p + 8], s, depth), subst_prop(word[p + 16], s, depth))
}

; definitional equality: normalize both, then compare (the conversion rule).
proc conv_eq(a, b) {
    return nat_eq(normalize(a, 100000), normalize(b, 100000))
}

proc skip_ident() {              ; advance over a lowercase keyword
    while is_lower(cbyte()) == 1 {
        adv()
    }
}

proc is_kwchar(c) {              ; a letter, either case (for All / Pred keywords)
    if is_lower(c) == 1 {
        return 1
    }
    if c < 'A' {
        return 0
    }
    if c > 'Z' {
        return 0
    }
    return 1
}

proc skip_kw() {                 ; advance over a keyword of any case
    while is_kwchar(cbyte()) == 1 {
        adv()
    }
}

proc expect(ch) {
    skip_ws()
    if cbyte() == ch {
        adv()
    }
}

; ---- node arena: 3 words per node, bump-allocated ----
proc alloc(tag, f0, f1) {
    let p = word[2097128]
    word[p] = tag
    word[p + 8] = f0
    word[p + 16] = f1
    word[2097128] = p + 24
    return p
}

; ---- parsers ----

proc parse_type() {
    skip_ws()
    let a = 0                    ; one declaration each (function-scoped locals)
    let b = 0
    if cbyte() == '(' {
        adv()
        skip_ws()
        if cbyte() == '-' {      ; -> implication
            adv()
            adv()                ; the '>'
            a = parse_type()
            b = parse_type()
            expect(')')
            return alloc(1, a, b)
        }
        if cbyte() == 'b' {      ; (bot) falsity ⊥ — a leaf
            skip_ident()
            expect(')')
            return alloc(3, 0, 0)
        }
        if cbyte() == '+' {      ; (+ A B) disjunction A ∨ B
            adv()
            a = parse_type()
            b = parse_type()
            expect(')')
            return alloc(4, a, b)
        }
        if cbyte() == '=' {      ; (= t1 t2) equality of Peano terms
            adv()
            a = parse_nat()
            b = parse_nat()
            expect(')')
            return alloc(5, a, b)
        }
        if cbyte() == 'A' {      ; (All body) universal quantifier
            skip_kw()
            a = parse_type()
            expect(')')
            return alloc(6, a, 0)
        }
        if cbyte() == 'E' {      ; (Exists body) existential quantifier
            skip_kw()
            a = parse_type()
            expect(')')
            return alloc(8, a, 0)
        }
        if cbyte() == 'P' {      ; (Pred id term) a predicate applied to an individual
            skip_kw()
            skip_ws()
            a = parse_number()
            b = parse_nat()
            expect(')')
            return alloc(7, a, b)
        }
        adv()                    ; '&' conjunction
        a = parse_type()
        b = parse_type()
        expect(')')
        return alloc(2, a, b)
    }
    a = cbyte()                  ; atom: a single uppercase letter
    adv()
    return alloc(0, a, 0)
}

proc parse_term() {
    skip_ws()
    expect('(')
    skip_ws()
    let kc = cbyte()             ; first letter of the rule keyword
    let kc2 = byte[2097152 + word[2097144] + 1]   ; second letter (app vs absurd)
    let kc3 = byte[2097152 + word[2097144] + 2]   ; third letter (inl vs inr)
    skip_ident()
    let x = 0
    let y = 0
    let z = 0
    if kc == 'h' {               ; (hyp N)
        skip_ws()
        x = parse_number()
        expect(')')
        return alloc(10, x, 0)
    }
    if kc == 'l' {               ; (lam type body)
        x = parse_type()
        y = parse_term()
        expect(')')
        return alloc(11, x, y)
    }
    if kc == 'a' {
        if kc2 == 'b' {          ; (absurd Cty p)  ex falso
            x = parse_type()
            y = parse_term()
            expect(')')
            return alloc(16, x, y)
        }
        x = parse_term()         ; (app fn arg)
        y = parse_term()
        expect(')')
        return alloc(12, x, y)
    }
    if kc == 'p' {               ; (pair a b)
        x = parse_term()
        y = parse_term()
        expect(')')
        return alloc(13, x, y)
    }
    if kc == 'f' {               ; (fst p)
        x = parse_term()
        expect(')')
        return alloc(14, x, 0)
    }
    if kc == 'i' {
        if kc3 == 's' {              ; (inst pf term) — ∀-elim
            x = parse_term()
            y = parse_nat()
            expect(')')
            return alloc(22, x, y)
        }
        x = parse_type()             ; (inl/inr Bty p) — inject into a sum
        y = parse_term()
        expect(')')
        if kc3 == 'l' {
            return alloc(17, x, y)   ; inl: (typeof y) ∨ x
        }
        return alloc(18, x, y)       ; inr: x ∨ (typeof y)
    }
    if kc == 'g' {                   ; (gen pf) — ∀-intro
        x = parse_term()
        expect(')')
        return alloc(21, x, 0)
    }
    if kc == 'w' {                   ; (wit body t pf) — ∃-intro: witness t, pf : body[t]
        x = parse_type()             ; body (predicate with bound var)
        y = parse_nat()              ; the witness (a closed individual)
        z = parse_term()             ; proof of body[t/x]
        expect(')')
        return alloc(23, x, alloc(99, y, z))
    }
    if kc == 'u' {                   ; (unpack epf handler) — ∃-elim
        x = parse_term()             ; epf : Exists body
        y = parse_term()             ; handler : All (body -> C)
        expect(')')
        return alloc(24, x, y)
    }
    if kc == 'c' {               ; (case p f g): p:A∨B, f:A->C, g:B->C => C
        x = parse_term()         ; p
        y = parse_term()         ; f
        z = parse_term()         ; g
        expect(')')
        return alloc(19, x, alloc(99, y, z))   ; nest (f,g) in an aux node
    }
    if kc == 'r' {               ; (refl t): proves (= t t) — discharged by reduction
        x = parse_nat()
        expect(')')
        return alloc(20, x, 0)
    }
    x = parse_term()             ; (snd p)
    expect(')')
    return alloc(15, x, 0)
}

; ---- structural type equality ----
proc type_eq(a, b) {
    if word[a] != word[b] {
        return 0
    }
    if word[a] == 0 {            ; ATOM: compare the char
        if word[a + 8] == word[b + 8] {
            return 1
        }
        return 0
    }
    if word[a] == 3 {            ; FALSE (⊥): a leaf, no payload — equal by tag
        return 1
    }
    if word[a] == 5 {            ; EQ(t1,t2): compare sides up to DEFINITIONAL equality
        if conv_eq(word[a + 8], word[b + 8]) == 0 {   ; the conversion rule
            return 0
        }
        return conv_eq(word[a + 16], word[b + 16])
    }
    if word[a] == 6 {            ; All body
        return type_eq(word[a + 8], word[b + 8])
    }
    if word[a] == 8 {            ; Exists body
        return type_eq(word[a + 8], word[b + 8])
    }
    if word[a] == 7 {            ; Pred id term — same predicate id, defn'lly-equal arg
        if word[a + 8] != word[b + 8] {
            return 0
        }
        return conv_eq(word[a + 16], word[b + 16])
    }
    if type_eq(word[a + 8], word[b + 8]) == 0 {
        return 0
    }
    return type_eq(word[a + 16], word[b + 16])
}

; ---- the checker: infer the proposition a term proves, or 0 (reject) ----
proc ctx_push(ty) {
    let n = word[2097120]
    word[4194304 + n * 8] = ty
    word[2097120] = n + 1
}

proc ctx_pop() {
    word[2097120] = word[2097120] - 1
}

proc infer(term) {
    let tag = word[term]
    let t1 = 0                   ; shared temps (function-scoped, declared once)
    let t2 = 0
    let t3 = 0
    if tag == 10 {               ; HYP idx — de Bruijn: 0 is the innermost binder
        t1 = word[term + 8]      ; idx
        t2 = word[2097120]       ; ctx depth
        if t1 < t2 {
            return word[4194304 + (t2 - 1 - t1) * 8]
        }
        return 0                 ; unbound hypothesis
    }
    if tag == 11 {               ; LAM ty body  ->  ty -> typeof(body in ctx+ty)
        t1 = word[term + 8]      ; ty
        ctx_push(t1)
        t2 = infer(word[term + 16])
        ctx_pop()
        if t2 == 0 {
            return 0
        }
        return alloc(1, t1, t2)
    }
    if tag == 12 {               ; APP f a  (modus ponens)
        t1 = infer(word[term + 8])
        if t1 == 0 {
            return 0
        }
        if word[t1] != 1 {       ; f must prove an implication
            return 0
        }
        t2 = infer(word[term + 16])
        if t2 == 0 {
            return 0
        }
        if type_eq(word[t1 + 8], t2) == 0 {   ; the antecedent must match the arg
            return 0
        }
        return word[t1 + 16]     ; the consequent
    }
    if tag == 13 {               ; PAIR a b  (&-intro)
        t1 = infer(word[term + 8])
        if t1 == 0 {
            return 0
        }
        t2 = infer(word[term + 16])
        if t2 == 0 {
            return 0
        }
        return alloc(2, t1, t2)
    }
    if tag == 14 {               ; FST p  (&-elim left)
        t1 = infer(word[term + 8])
        if t1 == 0 {
            return 0
        }
        if word[t1] != 2 {
            return 0
        }
        return word[t1 + 8]
    }
    if tag == 15 {               ; SND p  (&-elim right)
        t1 = infer(word[term + 8])
        if t1 == 0 {
            return 0
        }
        if word[t1] != 2 {
            return 0
        }
        return word[t1 + 16]
    }
    if tag == 16 {               ; ABSURD Cty p  (ex falso: from ⊥, anything)
        t1 = infer(word[term + 16])    ; p must prove falsity
        if t1 == 0 {
            return 0
        }
        if word[t1] != 3 {
            return 0
        }
        return word[term + 8]          ; the claimed Cty
    }
    if tag == 17 {               ; INL Bty p  :  (typeof p) ∨ Bty
        t1 = infer(word[term + 16])
        if t1 == 0 {
            return 0
        }
        return alloc(4, t1, word[term + 8])
    }
    if tag == 18 {               ; INR Aty p  :  Aty ∨ (typeof p)
        t1 = infer(word[term + 16])
        if t1 == 0 {
            return 0
        }
        return alloc(4, word[term + 8], t1)
    }
    if tag == 19 {               ; CASE p (aux f g) : p:A∨B, f:A->C, g:B->C => C
        t1 = infer(word[term + 8])              ; tp = OR(A, B)
        if t1 == 0 {
            return 0
        }
        if word[t1] != 4 {
            return 0
        }
        t2 = infer(word[word[term + 16] + 8])   ; tf = infer(f) = A' -> C1
        if t2 == 0 {
            return 0
        }
        if word[t2] != 1 {
            return 0
        }
        if type_eq(word[t2 + 8], word[t1 + 8]) == 0 {    ; A' == A
            return 0
        }
        t3 = infer(word[word[term + 16] + 16])  ; tg = infer(g) = B' -> C2
        if t3 == 0 {
            return 0
        }
        if word[t3] != 1 {
            return 0
        }
        if type_eq(word[t3 + 8], word[t1 + 16]) == 0 {   ; B' == B
            return 0
        }
        if type_eq(word[t2 + 16], word[t3 + 16]) == 0 {  ; C1 == C2
            return 0
        }
        return word[t2 + 16]                    ; C
    }
    if tag == 20 {               ; REFL t : proves (= t t)
        return alloc(5, word[term + 8], word[term + 8])
    }
    if tag == 21 {               ; GEN pf : ∀-intro  ->  All (typeof pf)
        ; freshness (sound, conservative): no hypothesis in scope may mention an
        ; individual variable — then the fresh ∀-bound var cannot be captured and
        ; no de Bruijn shifting of the context is needed.
        t1 = 0
        t2 = word[2097120]                    ; CTXN
        while t1 < t2 {
            if ivar_in_prop(word[4194304 + t1 * 8]) == 1 {
                return 0
            }
            t1 = t1 + 1
        }
        t1 = infer(word[term + 8])
        if t1 == 0 {
            return 0
        }
        return alloc(6, t1, 0)
    }
    if tag == 22 {               ; INST pf t : ∀-elim  ->  body[t / bound var]
        if ivar_in_term(word[term + 16]) == 1 {   ; instantiate with a CLOSED term
            return 0
        }
        t1 = infer(word[term + 8])
        if t1 == 0 {
            return 0
        }
        if word[t1] != 6 {                    ; pf must prove a universal
            return 0
        }
        return subst_prop(word[t1 + 8], word[term + 16], 0)
    }
    if tag == 23 {               ; WIT body t pf : ∃-intro  ->  Exists body
        ; node = (23, body, (99, t, pf)).  pf must prove body[t/x] for a CLOSED t.
        if ivar_in_term(word[word[term + 16] + 8]) == 1 {
            return 0
        }
        t1 = infer(word[word[term + 16] + 16])           ; typeof pf
        if t1 == 0 {
            return 0
        }
        t2 = subst_prop(word[term + 8], word[word[term + 16] + 8], 0)   ; body[t/x]
        if type_eq(t1, t2) == 0 {
            return 0
        }
        return alloc(8, word[term + 8], 0)
    }
    if tag == 24 {               ; UNPACK epf handler : ∃-elim  ->  C
        ; epf : Exists b ;  handler : All (b -> C) with C individual-closed.
        t1 = infer(word[term + 8])                       ; Exists b
        if t1 == 0 {
            return 0
        }
        if word[t1] != 8 {
            return 0
        }
        t2 = infer(word[term + 16])                      ; All (b' -> C)
        if t2 == 0 {
            return 0
        }
        if word[t2] != 6 {                               ; handler must be a universal
            return 0
        }
        if word[word[t2 + 8]] != 1 {                     ; whose body is an implication
            return 0
        }
        if type_eq(word[word[t2 + 8] + 8], word[t1 + 8]) == 0 {   ; antecedent == b
            return 0
        }
        if ivar_in_prop(word[word[t2 + 8] + 16]) == 1 {  ; C must not mention the var
            return 0
        }
        return word[word[t2 + 8] + 16]                   ; the conclusion C
    }
    return 0
}

proc main() {
    slurp()
    let goal = parse_type()
    let term = parse_term()
    let proved = infer(term)
    if proved == 0 {
        emit("reject\n")
        return 0
    }
    if type_eq(proved, goal) == 1 {
        emit("accept\n")
        return 1
    }
    emit("reject\n")
    return 0
}
