; eq.beta — a definitional-equality checker, written in Beta.  (Delta companion)
;
; check.beta validates *logical* proofs (natural deduction). This validates
; *computational* claims: "do these two terms denote the same value?", decided by
; reducing both to normal form with the definitional rules and comparing. It is
; the other half of what a real Delta needs — the bridge from a proposition to
; "what a program actually computes" runs through definitional equality.
;
; Crucially the reducer is FUEL-BOUNDED: normalize(term, fuel) either returns a
; normal form or stops at OutOfFuel. That is exactly the totality discipline
; gamma.md / delta.md require — a total checker cannot contain an unbounded
; evaluator, so the slow reference route is bounded and explicit. Here closed
; terms over {z, s, p} always terminate well within the fuel; the bound is the
; honest guard, not a workaround.
;
; Signature (Peano arithmetic, enough to demonstrate proof-by-computation):
;   z          zero
;   (s t)      successor
;   (p a b)    plus  ;  (m a b)  multiply
;            rules:  p z b => b   p (s x) b => s (p x b)
;                    m z y => z   m (s x) y => p y (m x y)
;
; Input (stdin): two terms. Output: "equal\n" (exit 1) if they have the same
; normal form, else "differ\n" (exit 0).
;   echo '(p (s (s z)) (s (s z)))  (s (s (s (s z))))' | eq    ->  equal   (2+2 = 4)
;
; Also Lists (a second inductive type): nil, (cons h t), (app l1 l2) append, (len l)
; length — append/length compute, so e.g. ([0]++[1] = [0,1]) and (len [0,1] = 2) decide.
;
; Memory: 2097152 SRC  2097144 CUR  2097136 LEN  2097128 APTR  3145728 ARENA.
; Nodes [tag,f0,f1] at 24-byte stride.  tag 0 ZERO 1 SUC 2 PLUS 3 MUL ; 4 NIL 5 CONS 6 APPEND 7 LEN.

proc slurp() {
    let n = 0
    let c = read_byte()
    while c >= 0 {
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
    }
    word[2097136] = n
    word[2097144] = 0
    word[2097128] = 3145728
}

proc cbyte() {
    let i = word[2097144]
    if i < word[2097136] {
        return byte[2097152 + i]
    }
    return 0
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

proc is_space(c) {
    if c == ' ' {
        return 1
    }
    if c == 9 {
        return 1
    }
    if c == 10 {
        return 1
    }
    if c == 13 {
        return 1
    }
    return 0
}

proc skip_ws() {
    while is_space(cbyte()) == 1 {
        adv()
    }
}

proc alloc(tag, f0, f1) {
    let p = word[2097128]
    word[p] = tag
    word[p + 8] = f0
    word[p + 16] = f1
    word[2097128] = p + 24
    return p
}

proc is_lower(c) {
    if c < 'a' {
        return 0
    }
    if c > 'z' {
        return 0
    }
    return 1
}

proc skip_ident() {              ; consume a lowercase keyword (s / m / cons / app / len ...)
    while is_lower(cbyte()) == 1 {
        adv()
    }
}

proc parse_term() {
    skip_ws()
    let a = 0
    let b = 0
    if cbyte() == 'z' {          ; zero
        adv()
        return alloc(0, 0, 0)
    }
    if cbyte() == 'n' {          ; nil (empty list)
        skip_ident()
        return alloc(4, 0, 0)
    }
    adv()                        ; '('
    skip_ws()
    let op = cbyte()
    skip_ident()                 ; consume the whole operator keyword
    if op == 's' {               ; (s x)
        a = parse_term()
        skip_ws()
        adv()                    ; ')'
        return alloc(1, a, 0)
    }
    if op == 'm' {               ; (m a b) multiply
        a = parse_term()
        b = parse_term()
        skip_ws()
        adv()                    ; ')'
        return alloc(3, a, b)
    }
    if op == 'c' {               ; (cons h t)
        a = parse_term()
        b = parse_term()
        skip_ws()
        adv()                    ; ')'
        return alloc(5, a, b)
    }
    if op == 'a' {               ; (app l1 l2) list append
        a = parse_term()
        b = parse_term()
        skip_ws()
        adv()                    ; ')'
        return alloc(6, a, b)
    }
    if op == 'l' {               ; (len l) list length
        a = parse_term()
        skip_ws()
        adv()                    ; ')'
        return alloc(7, a, 0)
    }
    a = parse_term()             ; (p a b) plus
    b = parse_term()
    skip_ws()
    adv()                        ; ')'
    return alloc(2, a, b)
}

; reduce to normal form using the definitional rules; fuel-bounded (total).
proc normalize(t, fuel) {
    if fuel < 1 {
        return t                 ; OutOfFuel — return the partial term as-is
    }
    let tag = word[t]
    if tag == 0 {                ; z is a normal form
        return t
    }
    if tag == 4 {                ; nil is a normal form
        return t
    }
    let a = 0
    let b = 0
    if tag == 1 {                ; (s x) -> s of normalized x
        a = normalize(word[t + 8], fuel - 1)
        return alloc(1, a, 0)
    }
    if tag == 5 {                ; (cons h t) -> reduce both
        a = normalize(word[t + 8], fuel - 1)
        b = normalize(word[t + 16], fuel - 1)
        return alloc(5, a, b)
    }
    if tag == 2 {                ; (p a b)
        a = normalize(word[t + 8], fuel - 1)
        b = normalize(word[t + 16], fuel - 1)
        if word[a] == 0 {        ; p z b  =>  b
            return b
        }
        if word[a] == 1 {        ; p (s x) b  =>  s (p x b)
            a = normalize(alloc(2, word[a + 8], b), fuel - 1)
            return alloc(1, a, 0)
        }
        return alloc(2, a, b)    ; stuck
    }
    if tag == 6 {                ; (app l1 l2)  -- app nil l2 => l2 ; app (cons h t) l2 => cons h (app t l2)
        a = normalize(word[t + 8], fuel - 1)
        if word[a] == 4 {
            return normalize(word[t + 16], fuel - 1)
        }
        if word[a] == 5 {
            b = alloc(6, word[a + 16], word[t + 16])
            return alloc(5, word[a + 8], normalize(b, fuel - 1))
        }
        return alloc(6, a, normalize(word[t + 16], fuel - 1))
    }
    if tag == 7 {                ; (len l)  -- len nil => z ; len (cons h t) => s (len t)
        a = normalize(word[t + 8], fuel - 1)
        if word[a] == 4 {
            return alloc(0, 0, 0)
        }
        if word[a] == 5 {
            b = normalize(alloc(7, word[a + 16], 0), fuel - 1)
            return alloc(1, b, 0)
        }
        return alloc(7, a, 0)
    }
    if tag == 3 {                ; (m a b) -- m z y => z ; m (s x) y => p y (m x y)
        a = normalize(word[t + 8], fuel - 1)
        if word[a] == 0 {
            return alloc(0, 0, 0)
        }
        if word[a] == 1 {
            b = alloc(3, word[a + 8], word[t + 16])              ; m x y
            return normalize(alloc(2, word[t + 16], b), fuel - 1) ; p y (m x y)
        }
        return alloc(3, a, word[t + 16])
    }
    return t
}

proc term_eq(a, b) {
    if word[a] != word[b] {
        return 0
    }
    if word[a] == 0 {            ; z
        return 1
    }
    if word[a] == 4 {            ; nil
        return 1
    }
    if word[a] == 1 {            ; s — compare the child
        return term_eq(word[a + 8], word[b + 8])
    }
    if word[a] == 7 {            ; len — unary, compare the child
        return term_eq(word[a + 8], word[b + 8])
    }
    if term_eq(word[a + 8], word[b + 8]) == 0 {   ; plus/mul/cons/app — both children
        return 0
    }
    return term_eq(word[a + 16], word[b + 16])
}

proc main() {
    slurp()
    let t1 = parse_term()
    let t2 = parse_term()
    let n1 = normalize(t1, 1000000)
    let n2 = normalize(t2, 1000000)
    if term_eq(n1, n2) == 1 {
        emit("equal\n")
        return 1
    }
    emit("differ\n")
    return 0
}
