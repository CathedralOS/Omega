; sum-forall.elab — the SUM-fold ∀-input theorem, the add-the-element fold family (the shape of
; stdin_checksum's real accumulator). Where count-forall adds a CONSTANT per element, this adds the
; ELEMENT itself:  sumfold(Cons h t, n) = sumfold(t, h + n).  Proving it universal needs the user nat to
; be a COMMUTATIVE MONOID, so this file first proves uadd's right-identity, successor-pushout,
; commutativity, and associativity (each by induction), then the fold theorem:
;
;     ∀xs ∀n.  sumfold(xs, n)  =  listsum(xs) + n
;
; All user nats (k2/k3) and user lists (k60/k61), matching the meaning route's USER_PRELUDE.

(data 2 0 0 0) (data 3 1 1 0) (data 60 0 0 0) (data 61 2 0 1)

(fun 21 2 (y 0)) (fun 21 3 (k 3 (rec 0)))                ; uadd(0,n)=n ; uadd(s m,n)=s(uadd(m,n))
(fun 94 60 (k 2)) (fun 94 61 (f 21 (v 0) (rec 1)))        ; listsum(Nil)=0 ; listsum(Cons h t)=h+listsum(t)
(fun 95 60 (y 0)) (fun 95 61 (recx 1 (f 21 (v 0) (y 0)))) ; sumfold(Nil,n)=n ; (Cons h t,n)=sumfold(t, h+n)

(all xs (all n (= (f 95 xs n) (f 21 (f 94 xs) n))))

; --- uadd is a commutative monoid: right identity, successor pushout, commutativity, associativity ---
(have add0r (all a (= (f 21 a (k 2)) a))
  (rec 2 3 a (= (f 21 a (k 2)) a)
    (refl (k 2))
    (gen a1 (lam ih (= (f 21 a1 (k 2)) a1)
      (eqelim x (= (k 3 (f 21 a1 (k 2))) (k 3 x)) ih (refl (k 3 (f 21 a1 (k 2))))))))
(have uaddsuc (all a (all b (= (f 21 a (k 3 b)) (k 3 (f 21 a b)))))
  (rec 2 3 a (all b (= (f 21 a (k 3 b)) (k 3 (f 21 a b))))
    (gen b (refl (k 3 b)))
    (gen a1 (lam ih (all b (= (f 21 a1 (k 3 b)) (k 3 (f 21 a1 b))))
      (gen b (eqelim x (= (k 3 (f 21 a1 (k 3 b))) (k 3 x)) (inst ih b) (refl (k 3 (f 21 a1 (k 3 b)))))))))
(have addcomm (all a (all b (= (f 21 a b) (f 21 b a))))
  (rec 2 3 a (all b (= (f 21 a b) (f 21 b a)))
    (gen b (eqelim x (= x (f 21 b (k 2))) (inst add0r b) (refl (f 21 b (k 2)))))
    (gen a1 (lam ih (all b (= (f 21 a1 b) (f 21 b a1)))
      (gen b
        (have s1 (= (k 3 (f 21 a1 b)) (k 3 (f 21 b a1)))
          (eqelim x (= (k 3 (f 21 a1 b)) (k 3 x)) (inst ih b) (refl (k 3 (f 21 a1 b))))
        (have s2 (= (k 3 (f 21 b a1)) (f 21 b (k 3 a1)))
          (eqelim x (= x (f 21 b (k 3 a1))) (inst* uaddsuc b a1) (refl (f 21 b (k 3 a1))))
          (eqelim x (= (k 3 (f 21 a1 b)) x) s2 s1)))))))
(have addassoc (all a (all b (all c (= (f 21 (f 21 a b) c) (f 21 a (f 21 b c))))))
  (rec 2 3 a (all b (all c (= (f 21 (f 21 a b) c) (f 21 a (f 21 b c)))))
    (gen b (gen c (refl (f 21 b c))))
    (gen a1 (lam ih (all b (all c (= (f 21 (f 21 a1 b) c) (f 21 a1 (f 21 b c)))))
      (gen b (gen c
        (eqelim x (= (k 3 (f 21 (f 21 a1 b) c)) (k 3 x)) (inst* ih b c) (refl (k 3 (f 21 (f 21 a1 b) c)))))))))

; --- the fold theorem, by induction on xs ---
(rec 60 61 xs (all n (= (f 95 xs n) (f 21 (f 94 xs) n)))
  (gen n (refl n))                                      ; base xs=Nil: both sides reduce to n
  (gen h (gen t (lam ih (all n (= (f 95 t n) (f 21 (f 94 t) n)))
    (gen n
      ; goal reduces to:  sumfold(t, h+n)  =  uadd(uadd(h, listsum t), n)   [A=listsum t, B=h, C=n]
      ; IH at (h+n):       sumfold(t, h+n)  =  uadd(A, uadd(B,C))
      ; bridge: uadd(A, uadd(B,C)) = uadd(uadd(B,A), C)  by assoc (reversed) then comm-under-(.,C)
      (have s1 (= (f 21 (f 94 t) (f 21 h n)) (f 21 (f 21 (f 94 t) h) n))     ; sym(assoc): A+(B+C) = (A+B)+C
        (eqelim x (= x (f 21 (f 21 (f 94 t) h) n)) (inst* addassoc (f 94 t) h n) (refl (f 21 (f 21 (f 94 t) h) n)))
      (have s2 (= (f 21 (f 21 (f 94 t) h) n) (f 21 (f 21 h (f 94 t)) n))     ; comm under (.,C): (A+B)+C = (B+A)+C
        (eqelim x (= (f 21 (f 21 (f 94 t) h) n) (f 21 x n)) (inst* addcomm (f 94 t) h) (refl (f 21 (f 21 (f 94 t) h) n)))
      (have bridge (= (f 21 (f 94 t) (f 21 h n)) (f 21 (f 21 h (f 94 t)) n))  ; trans: A+(B+C) = (B+A)+C
        (eqelim x (= (f 21 (f 94 t) (f 21 h n)) x) s2 s1)
        (eqelim x (= (f 95 t (f 21 h n)) x) bridge (inst ih (f 21 h n)))))))))))))))
