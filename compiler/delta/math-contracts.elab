; math-contracts.elab — discharge the EQUALITY contracts of samples/math_proofs/main.omg as delta
; certificates. Each `machine M(..) requires R ensures E {}` in that sample is a proof obligation:
; the ensures proposition holds (under the requires). This proves the ARITHMETIC-EQUALITY subset with
; a kernel proof — the omega-rs contracts/obligations concept, discharged by the lattice's own anchor.
; Built-in nats (z/s), + = Pl (recurses on the left), * = Mu; contract2delta.py emits the matching goal.
;
; Proven here (goal = the ensures, ∀-closed over the machine params, requires as antecedents):
;   pythagorean_three_four_five :  3*3 + 4*4 == 5*5
;   add_one_congruence          :  a == b -> a+1 == b+1
;   add_commutative             :  a + b == b + a
;   multiply_distributes        :  (a+b)*c == a*c + b*c
; Each is a separate (def N ..) lemma; the gate checks all four accept in all three checkers.

; --- helpers: + right-identity and successor-pushout (by induction), used by the ∀ contracts ---
(def 0 (all a (= (+ a z) a))
  (natind a (= (+ a z) a)
    (refl z)
    (gen a1 (lam ih (= (+ a1 z) a1)
      (eqelim x (= (s (+ a1 z)) (s x)) ih (refl (s (+ a1 z))))))))
(def 1 (all a (all b (= (+ a (s b)) (s (+ a b)))))
  (natind a (all b (= (+ a (s b)) (s (+ a b))))
    (gen b (refl (s b)))
    (gen a1 (lam ih (all b (= (+ a1 (s b)) (s (+ a1 b))))
      (gen b (eqelim x (= (s (+ a1 (s b))) (s x)) (inst ih b) (refl (s (+ a1 (s b))))))))))

; --- CONTRACT: pythagorean_three_four_five : 3*3 + 4*4 == 5*5  (ground, refl) ---
(def 2 (= (+ (* 3 3) (* 4 4)) (* 5 5)) (refl (* 5 5)))

; --- CONTRACT: add_one_congruence : forall a b. a==b -> a+1 == b+1 ---
(def 3 (all a (all b (-> (= a b) (= (+ a 1) (+ b 1)))))
  (gen a (gen b (lam h (= a b) (eqelim x (= (+ a 1) (+ x 1)) h (refl (+ a 1)))))))

; --- CONTRACT: add_commutative : forall a b. a + b == b + a  (uses def 0, def 1) ---
(def 4 (all a (all b (= (+ a b) (+ b a))))
  (natind a (all b (= (+ a b) (+ b a)))
    (gen b (eqelim x (= x (+ b z)) (inst (use 0) b) (refl (+ b z))))
    (gen a1 (lam ih (all b (= (+ a1 b) (+ b a1)))
      (gen b
        (have s1 (= (s (+ a1 b)) (s (+ b a1)))
          (eqelim x (= (s (+ a1 b)) (s x)) (inst ih b) (refl (s (+ a1 b))))
        (have s2 (= (s (+ b a1)) (+ b (s a1)))
          (eqelim x (= x (+ b (s a1))) (inst* (use 1) b a1) (refl (+ b (s a1))))
          (eqelim x (= (s (+ a1 b)) x) s2 s1))))))))

; --- addassoc : forall a b c. (a+b)+c == a+(b+c)  (helper for distributivity) ---
(def 5 (all a (all b (all c (= (+ (+ a b) c) (+ a (+ b c))))))
  (natind a (all b (all c (= (+ (+ a b) c) (+ a (+ b c)))))
    (gen b (gen c (refl (+ b c))))
    (gen a1 (lam ih (all b (all c (= (+ (+ a1 b) c) (+ a1 (+ b c)))))
      (gen b (gen c
        (eqelim x (= (s (+ (+ a1 b) c)) (s x)) (inst* ih b c) (refl (s (+ (+ a1 b) c))))))))))

; --- CONTRACT: multiply_distributes : forall a b c. (a+b)*c == a*c + b*c  (uses addassoc = def 5) ---
; * = Mu recurses on the left: (s a)*c = c + a*c, z*c = z.  Induct on a.
(def 6 (all a (all b (all c (= (* (+ a b) c) (+ (* a c) (* b c))))))
  (natind a (all b (all c (= (* (+ a b) c) (+ (* a c) (* b c)))))
    (gen b (gen c (refl (* b c))))
    (gen a1 (lam ih (all b (all c (= (* (+ a1 b) c) (+ (* a1 c) (* b c)))))
      (gen b (gen c
        ; goal reduces to: c + (a1+b)*c  =  (c + a1*c) + b*c
        (have congr (= (+ c (* (+ a1 b) c)) (+ c (+ (* a1 c) (* b c))))
          (eqelim x (= (+ c (* (+ a1 b) c)) (+ c x)) (inst* ih b c) (refl (+ c (* (+ a1 b) c))))
        (have symA (= (+ c (+ (* a1 c) (* b c))) (+ (+ c (* a1 c)) (* b c)))
          (eqelim y (= y (+ (+ c (* a1 c)) (* b c))) (inst* (use 5) c (* a1 c) (* b c)) (refl (+ (+ c (* a1 c)) (* b c))))
          (eqelim x (= (+ c (* (+ a1 b) c)) x) symA congr)))))))))

; top-level goal (whole library consistent): re-assert pythagorean
(= (+ (* 3 3) (* 4 4)) (* 5 5))
(use 2)
