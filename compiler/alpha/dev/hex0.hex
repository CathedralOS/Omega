; ===========================================================================
; hex0 — a hand-assembled flat-hex transcriber (Windows x64 PE). Reads hex digit
; pairs from stdin (every non-hex byte ignored, so whitespace/newlines are free) and
; writes the bytes to stdout. This REPLACES the Python materializer in the build
; loop: once hex0 exists it reproduces itself and materializes the VM with no Python.
;
; r12 = "have a high nibble yet" (0/1), r13 = the pending high nibble.
; Win64-preserved regs survive the ReadFile/WriteFile calls. Sections + import table
; + getbyte/putbyte are identical to the VM's (same .data scratch addresses).
; ===========================================================================

; --- DOS header ---
4D 5A z58
40 00 00 00

; --- PE signature + COFF ---
50 45 00 00
64 86
03 00                    ; 3 sections
00 00 00 00
00 00 00 00
00 00 00 00
F0 00
22 00

; --- Optional header (PE32+) ---
0B 02
00 00
00 10 00 00              ; SizeOfCode
00 02 00 00              ; SizeOfInitializedData (.rdata)
00 10 00 00              ; SizeOfUninitializedData (.data, 0x1000)
00 10 00 00              ; AddressOfEntryPoint
00 10 00 00              ; BaseOfCode
00 00 00 40 01 00 00 00  ; ImageBase
00 10 00 00
00 02 00 00
06 00 00 00
00 00 00 00
06 00 00 00
00 00 00 00
00 40 00 00              ; SizeOfImage = 0x4000
00 02 00 00              ; SizeOfHeaders
00 00 00 00
03 00
00 00
00 00 10 00 00 00 00 00
00 10 00 00 00 00 00 00
00 00 10 00 00 00 00 00
00 10 00 00 00 00 00 00
00 00 00 00
10 00 00 00
00 00 00 00 00 00 00 00          ; dir[0]
.rva idt 28 00 00 00             ; dir[1] import
z80
.rva iat 20 00 00 00             ; dir[12] IAT
z24

; --- section headers ---
2E 74 65 78 74 00 00 00          ; .text
00 10 00 00
00 10 00 00
00 10 00 00
00 02 00 00
00 00 00 00 00 00 00 00
00 00 00 00
20 00 00 60
2E 72 64 61 74 61 00 00          ; .rdata
00 02 00 00
00 20 00 00
00 02 00 00
00 12 00 00
00 00 00 00 00 00 00 00
00 00 00 00
40 00 00 40
2E 64 61 74 61 00 00 00          ; .data
00 10 00 00
00 30 00 00
00 00 00 00
00 00 00 00
00 00 00 00 00 00 00 00
00 00 00 00
80 00 00 C0
.pad 0x200

; ===================== .text (RVA 0x1000) =====================
48 83 EC 28                     ; sub rsp, 0x28
B9 F6 FF FF FF                  ; mov ecx, -10 (STD_INPUT)
FF 15 .rel32 iat_gsh
48 B9 80 30 00 40 01 00 00 00   ; &stdin_h
48 89 01
B9 F5 FF FF FF                  ; mov ecx, -11 (STD_OUTPUT)
FF 15 .rel32 iat_gsh
48 B9 88 30 00 40 01 00 00 00   ; &stdout_h
48 89 01
4D 31 E4                        ; xor r12, r12   (no high nibble yet)

mainloop:
E8 .rel32 getbyte               ; eax = char, or -1 at EOF
85 C0                           ; test eax, eax
78 .rel8 hx_exit                ; js -> EOF
83 F8 30                        ; cmp eax, '0'(48)
7C .rel8 hx_ignore              ; jl  -> not hex
83 F8 39                        ; cmp eax, '9'(57)
7F .rel8 hx_lower               ; jg  -> try a-f / A-F
83 E8 30                        ; sub eax, 48     (0..9)
EB .rel8 hx_have
hx_lower:
83 F8 61                        ; cmp eax, 'a'(97)
7C .rel8 hx_upper
83 F8 66                        ; cmp eax, 'f'(102)
7F .rel8 hx_ignore
83 E8 57                        ; sub eax, 87     (a..f -> 10..15)
EB .rel8 hx_have
hx_upper:
83 F8 41                        ; cmp eax, 'A'(65)
7C .rel8 hx_ignore
83 F8 46                        ; cmp eax, 'F'(70)
7F .rel8 hx_ignore
83 E8 37                        ; sub eax, 55     (A..F -> 10..15)
hx_have:
4D 85 E4                        ; test r12, r12
75 .rel8 hx_low                 ; jnz -> this completes a byte
49 89 C5                        ; mov r13, rax    (stash high nibble)
41 BC 01 00 00 00               ; mov r12d, 1
EB .rel8 mainloop
hx_low:
89 C1                           ; mov ecx, eax    (low nibble)
44 89 E8                        ; mov eax, r13d   (high nibble)
C1 E0 04                        ; shl eax, 4
01 C8                           ; add eax, ecx    (byte = high<<4 | low)
E8 .rel32 putbyte               ; write al
4D 31 E4                        ; xor r12, r12
EB .rel8 mainloop
hx_ignore:
EB .rel8 mainloop
hx_exit:
48 83 C4 28                     ; add rsp, 0x28
31 C0                           ; xor eax, eax    (exit 0)
C3

; --- getbyte: rax = next stdin byte, or -1 at EOF (self-aligning frame) ---
getbyte:
48 83 EC 28
48 B8 80 30 00 40 01 00 00 00
48 8B 08
48 BA 90 30 00 40 01 00 00 00
41 B8 01 00 00 00
49 B9 98 30 00 40 01 00 00 00
48 C7 44 24 20 00 00 00 00
FF 15 .rel32 iat_rf
48 B8 98 30 00 40 01 00 00 00
48 8B 00
48 85 C0
74 .rel8 gb_eof
48 B8 90 30 00 40 01 00 00 00
0F B6 00
48 83 C4 28
C3
gb_eof:
48 C7 C0 FF FF FF FF
48 83 C4 28
C3

; --- putbyte: write al to stdout (self-aligning frame) ---
putbyte:
48 83 EC 28
48 BA 90 30 00 40 01 00 00 00
88 02
48 B8 88 30 00 40 01 00 00 00
48 8B 08
48 BA 90 30 00 40 01 00 00 00
41 B8 01 00 00 00
49 B9 98 30 00 40 01 00 00 00
48 C7 44 24 20 00 00 00 00
FF 15 .rel32 iat_wf
48 83 C4 28
C3
.pad 0x1200

; ===================== .rdata (RVA 0x2000, file 0x1200) =====================
idt:
.rva ilt
00 00 00 00
00 00 00 00
.rva dllname
.rva iat
z20
ilt:
.rva n_gsh 00 00 00 00
.rva n_rf  00 00 00 00
.rva n_wf  00 00 00 00
z8
iat:
iat_gsh: .rva n_gsh 00 00 00 00
iat_rf:  .rva n_rf  00 00 00 00
iat_wf:  .rva n_wf  00 00 00 00
z8
n_gsh:
00 00 47 65 74 53 74 64 48 61 6E 64 6C 65 00 00
n_rf:
00 00 52 65 61 64 46 69 6C 65 00 00
n_wf:
00 00 57 72 69 74 65 46 69 6C 65 00
dllname:
6B 65 72 6E 65 6C 33 32 2E 64 6C 6C 00 00
.pad 0x1400
