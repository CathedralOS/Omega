// The Alpha compiler, written in Alpha (compiled by the alpha-rs on-ramp).
//
// Increment 2: a real lexer. Reads the whole source from stdin into a buffer,
// tokenizes it into parallel token arrays (kind/start/len), and — to verify the
// lexer end to end — emits a PE that exits with the token count. (Increment 3 will
// add the parser + emitter so the output is a real translation of the input.)
//
// The byte-exact PE writer (write_pe + emit helpers) is unchanged from increment 1
// and is reused verbatim. Alpha has no bitwise ops, so bytes are split with integer
// division (write_byte keeps only the low 8 bits, so `v / 256` shifts right a byte).

boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_line(text: &[u8] in Utf8);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}

// Token kinds (Alpha has no enums; these are the integer tags used everywhere).
//  0 Eof      1 Ident    2 Int      3 LBrace   4 RBrace   5 LParen   6 RParen
//  7 LBracket 8 RBracket 9 Semi    10 Colon   11 ColonColon 12 Comma 13 Dot
// 14 Amp     15 Eq      16 Plus    17 Minus   18 Star    19 Slash   20 Lt
// 21 Gt      22 Le      23 Ge      24 EqEq    25 Ne      26 Arrow   27 Str

data Main {
    console: Console;
    source: [u8; 65536];          // source text
    source_length: i32;
    token_kind: [i32; 16384];
    token_start: [i32; 16384];
    token_length: [i32; 16384];
    token_count: i32;
    lex_position: i32;            // lexer cursor into source
    current_byte: i32;            // current byte
    next_byte: i32;               // lookahead byte
    token_text_start: i32;        // token start
    token_position: i32;          // parser token cursor
    int_accumulator: i32;         // token_int accumulator
    digit_position: i32;          // token_int byte cursor
    digit_end: i32;               // token_int byte end
    operator_stack: [i32; 64];    // shunting-yard operator stack (token kinds)
    operator_count: i32;
    current_operator: i32;
    top_precedence: i32;          // precedence scratch
    current_precedence: i32;
    keyword_bytes: [u8; 32];      // keyword-compare buffer
    compare_position: i32;
    left_byte: i32;               // byte-compare scratch
    right_byte: i32;
    local_token: [i32; 64];       // symbol table: token index naming each local
    local_count: i32;
    current_slot: i32;            // current let's slot
    resolve_position: i32;        // resolve_local cursor
    emit_scratch: i32;            // emit_i32 scratch
    brace_depth: i32;             // brace depth while finding the top-level machine
    code: [u8; 512];              // generated machine code
    code_length: i32;
    pending_value: i32;
    raw_section_size: i32;
    image_size: i32;
    write_cursor: i32;            // scratch loop cursor
    setcc_byte: i32;              // setcc opcode for a comparison
    state_name_token: [i32; 128]; // token index naming each state (prescan order)
    state_offset: [i32; 128];     // code offset (label) of each state
    state_count: i32;
    state_emit_index: i32;        // which state we are emitting
    fixup_at: [i32; 256];         // code offset of each jump rel32 to patch
    fixup_target: [i32; 256];     // target state index for each fixup
    fixup_count: i32;
    scan_position: i32;           // state pre-scan cursor
    pattern_value: i32;           // transition arm: the matched integer
    arm_is_wild: i32;             // transition arm: is it the `_` default?
    target_state: i32;            // transition arm: resolved target state index
    machine_start: [i32; 128];    // token index of each top-level machine's `machine` keyword
    machine_name: [i32; 128];     // token index of each machine's callable name
    machine_offset: [i32; 128];   // code offset of each machine (filled as emitted)
    machine_count: i32;
    entry_machine: i32;           // index of the machine named `main`
    param_count: i32;             // value params of the machine being emitted
    call_at: [i32; 256];          // code offset of each call rel32 to patch
    call_target: [i32; 256];      // target machine index for each call
    call_count: i32;
    target_machine: i32;          // patch_calls scratch
    emit_machine_index: i32;      // driver loop over machines
    probe: i32;                   // prescan_machines name-finding cursor
    field_name_token: [i32; 256]; // data Main's field names (token index)
    field_offset: [i32; 256];     // each field's byte offset within the instance
    field_elem_bytes: [i32; 256]; // element width for array fields (1 or 8), else 0
    field_count: i32;
    data_size: i32;               // total bytes of the Main instance (the .data section)
    machine_has_self: i32;        // does the machine being emitted take `&mut self`?
    data_reloc_at: i32;           // code offset of the entry's `lea rax,[rip+data]` disp32
    field_offset_result: i32;     // resolve_field scratch
    data_raw_size: i32;           // .data size rounded up to FileAlignment
    data_rva: i32;                // .data virtual address
    section_count: i32;           // 1 (.text only) or 2 (.text + .data)
}

// --- byte classifiers (free machines returning 0/1) ---

machine is_space(byte: i32) -> i32 {
    transition byte {
        32 -> return_true()
        9 -> return_true()
        13 -> return_true()
        10 -> return_true()
        _ -> return_false()
    }
    state return_true() { return 1; }
    state return_false() { return 0; }
}

machine is_digit(byte: i32) -> i32 {
    transition byte < 48 { true -> return_false() _ -> check_high() }
    state check_high() {
        transition byte > 57 { true -> return_false() _ -> return_true() }
    }
    state return_true() { return 1; }
    state return_false() { return 0; }
}

machine is_alpha(byte: i32) -> i32 {
    transition byte { 95 -> return_true() _ -> check_low() } // '_'
    state check_low() {
        transition byte < 65 { true -> return_false() _ -> check_high() }
    }
    state check_high() {
        transition byte > 122 { true -> return_false() _ -> check_upper_range() }
    }
    state check_upper_range() {
        transition byte < 91 { true -> return_true() _ -> check_lower_range() } // 65..90 = A-Z
    }
    state check_lower_range() {
        transition byte > 96 { true -> return_true() _ -> return_false() }      // 97..122 = a-z
    }
    state return_true() { return 1; }
    state return_false() { return 0; }
}

machine is_alnum(byte: i32) -> i32 {
    transition is_alpha(byte) { 1 -> return_true() _ -> check_digit() }
    state check_digit() {
        transition is_digit(byte) { 1 -> return_true() _ -> return_false() }
    }
    state return_true() { return 1; }
    state return_false() { return 0; }
}

// --- byte output helpers (write_byte keeps only the low 8 bits) ---

machine emit_u16(value: i32) {
    write_byte(value);
    write_byte(value / 256);
}

machine emit_u32(value: i32) {
    write_byte(value);
    write_byte(value / 256);
    write_byte(value / 65536);
    write_byte(value / 16777216);
}

machine emit_zeros(count: i32) {
    let written: i32 = 0;
    transition 0 { _ -> step() }
    state step() {
        transition written < count { true -> write_one() false -> done() }
    }
    state write_one() {
        write_byte(0);
        written = written + 1;
        transition 0 { _ -> step() }
    }
    state done() { }
}

machine align_up(value: i32, alignment: i32) -> i32 {
    return ((value + alignment - 1) / alignment) * alignment;
}

// operator precedence: * / (2) bind tighter than + - (1), which bind tighter
// than the comparisons < > <= >= == != (0).
machine precedence(operator: i32) -> i32 {
    transition operator {
        18 -> high()
        19 -> high()
        20 -> comparison()
        21 -> comparison()
        22 -> comparison()
        23 -> comparison()
        24 -> comparison()
        25 -> comparison()
        _ -> low()
    }
    state high() { return 2; }
    state low() { return 1; }
    state comparison() { return 0; }
}

// arithmetic shift right by 8 bits = floor(value/256). Alpha's `/` truncates toward
// zero, so for negatives we bias by -255 to get floor. Used to emit the bytes of
// a (possibly negative) i32 in two's complement, since there are no bitwise ops.
machine arithmetic_shift_8(value: i32) -> i32 {
    transition value < 0 { true -> negative() false -> positive() }
    state negative() { return (value - 255) / 256; }
    state positive() { return value / 256; }
}

// --- the lexer ---

machine Main::read_source(&mut self) {
    self.source_length = 0;
    transition 0 { _ -> step() }
    state step() {
        self.current_byte = read_byte();
        transition self.current_byte < 0 { true -> done() false -> store() }
    }
    state store() {
        self.source[self.source_length] = self.current_byte;
        self.source_length = self.source_length + 1;
        transition 0 { _ -> step() }
    }
    state done() { }
}

machine Main::push_token(&mut self, kind: i32, start: i32, length: i32) {
    self.token_kind[self.token_count] = kind;
    self.token_start[self.token_count] = start;
    self.token_length[self.token_count] = length;
    self.token_count = self.token_count + 1;
}

machine Main::lex(&mut self) {
    self.token_count = 0;
    self.lex_position = 0;
    transition 0 { _ -> scan() }

    // skip whitespace and // line comments, then dispatch one token
    state scan() {
        transition self.lex_position < self.source_length { true -> peek() false -> at_eof() }
    }
    state peek() {
        self.current_byte = self.source[self.lex_position];
        transition is_space(self.current_byte) { 1 -> advance() _ -> peek_slash() }
    }
    state advance() {
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> scan() }
    }
    state peek_slash() {
        transition self.current_byte { 47 -> peek_second_slash() _ -> dispatch() } // '/'
    }
    state peek_second_slash() {
        self.next_byte = self.source[self.lex_position + 1];
        transition self.next_byte { 47 -> skip_comment() _ -> dispatch() } // '//' -> comment
    }
    state skip_comment() {
        transition self.lex_position < self.source_length { true -> comment_look() false -> scan() }
    }
    state comment_look() {
        self.current_byte = self.source[self.lex_position];
        transition self.current_byte { 10 -> advance() _ -> comment_advance() } // newline ends the comment
    }
    state comment_advance() {
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> skip_comment() }
    }

    state dispatch() {
        transition is_alpha(self.current_byte) { 1 -> ident() _ -> dispatch_digit() }
    }
    state dispatch_digit() {
        transition is_digit(self.current_byte) { 1 -> int() _ -> dispatch_string() }
    }
    state dispatch_string() {
        transition self.current_byte { 34 -> string() _ -> op() } // '"'
    }

    // identifier
    state ident() {
        self.token_text_start = self.lex_position;
        transition 0 { _ -> ident_loop() }
    }
    state ident_loop() {
        transition self.lex_position < self.source_length { true -> ident_check() false -> ident_end() }
    }
    state ident_check() {
        self.current_byte = self.source[self.lex_position];
        transition is_alnum(self.current_byte) { 1 -> ident_advance() _ -> ident_end() }
    }
    state ident_advance() {
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> ident_loop() }
    }
    state ident_end() {
        self.push_token(1, self.token_text_start, self.lex_position - self.token_text_start);
        transition 0 { _ -> scan() }
    }

    // integer
    state int() {
        self.token_text_start = self.lex_position;
        transition 0 { _ -> int_loop() }
    }
    state int_loop() {
        transition self.lex_position < self.source_length { true -> int_check() false -> int_end() }
    }
    state int_check() {
        self.current_byte = self.source[self.lex_position];
        transition is_digit(self.current_byte) { 1 -> int_advance() _ -> int_end() }
    }
    state int_advance() {
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> int_loop() }
    }
    state int_end() {
        self.push_token(2, self.token_text_start, self.lex_position - self.token_text_start);
        transition 0 { _ -> scan() }
    }

    // string literal: start/len cover the bytes between the quotes
    state string() {
        self.lex_position = self.lex_position + 1;
        self.token_text_start = self.lex_position;
        transition 0 { _ -> string_loop() }
    }
    state string_loop() {
        transition self.lex_position < self.source_length { true -> string_check() false -> string_end() }
    }
    state string_check() {
        self.current_byte = self.source[self.lex_position];
        transition self.current_byte { 34 -> string_end() _ -> string_advance() }
    }
    state string_advance() {
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> string_loop() }
    }
    state string_end() {
        self.push_token(27, self.token_text_start, self.lex_position - self.token_text_start);
        self.lex_position = self.lex_position + 1; // skip closing quote
        transition 0 { _ -> scan() }
    }

    // operators / punctuation (two-char forms first)
    state op() {
        self.next_byte = self.source[self.lex_position + 1];
        transition self.current_byte {
            45 -> op_minus()   // -
            58 -> op_colon()   // :
            61 -> op_eq()      // =
            33 -> op_bang()    // !
            60 -> op_lt()      // <
            62 -> op_gt()      // >
            _  -> op_single()
        }
    }
    state op_minus() {
        transition self.next_byte { 62 -> set_arrow() _ -> emit_minus() }
    }
    state emit_minus() {
        self.push_token(17, self.lex_position, 1);
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> scan() }
    }
    state op_colon() {
        transition self.next_byte { 58 -> set_colon_colon() _ -> emit_colon() }
    }
    state emit_colon() {
        self.push_token(10, self.lex_position, 1);
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> scan() }
    }
    state op_eq() {
        transition self.next_byte { 61 -> set_eq_eq() _ -> emit_eq() }
    }
    state emit_eq() {
        self.push_token(15, self.lex_position, 1);
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> scan() }
    }
    state op_bang() {
        transition self.next_byte { 61 -> set_ne() _ -> skip_bad() }
    }
    state skip_bad() {
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> scan() }
    }
    state op_lt() {
        transition self.next_byte { 61 -> set_le() _ -> emit_lt() }
    }
    state emit_lt() {
        self.push_token(20, self.lex_position, 1);
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> scan() }
    }
    state op_gt() {
        transition self.next_byte { 61 -> set_ge() _ -> emit_gt() }
    }
    state emit_gt() {
        self.push_token(21, self.lex_position, 1);
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> scan() }
    }

    // two-char tokens: a setter puts the kind in self.pending_value, then `emit_two_char` emits it
    // (transition arm targets are parameterless, so the kind can't be passed inline)
    state set_arrow() {
        self.pending_value = 26;
        transition 0 { _ -> emit_two_char() }
    }
    state set_colon_colon() {
        self.pending_value = 11;
        transition 0 { _ -> emit_two_char() }
    }
    state set_eq_eq() {
        self.pending_value = 24;
        transition 0 { _ -> emit_two_char() }
    }
    state set_ne() {
        self.pending_value = 25;
        transition 0 { _ -> emit_two_char() }
    }
    state set_le() {
        self.pending_value = 22;
        transition 0 { _ -> emit_two_char() }
    }
    state set_ge() {
        self.pending_value = 23;
        transition 0 { _ -> emit_two_char() }
    }
    state emit_two_char() {
        self.push_token(self.pending_value, self.lex_position, 2);
        self.lex_position = self.lex_position + 2;
        transition 0 { _ -> scan() }
    }

    // single-char punctuation
    state op_single() {
        transition self.current_byte {
            123 -> set_lbrace()
            125 -> set_rbrace()
            40 -> set_lparen()
            41 -> set_rparen()
            91 -> set_lbracket()
            93 -> set_rbracket()
            59 -> set_semi()
            44 -> set_comma()
            46 -> set_dot()
            38 -> set_amp()
            43 -> set_plus()
            42 -> set_star()
            47 -> set_slash()
            _ -> skip_bad()
        }
    }
    state set_lbrace() {
        self.pending_value = 3;
        transition 0 { _ -> emit_one_char() }
    }
    state set_rbrace() {
        self.pending_value = 4;
        transition 0 { _ -> emit_one_char() }
    }
    state set_lparen() {
        self.pending_value = 5;
        transition 0 { _ -> emit_one_char() }
    }
    state set_rparen() {
        self.pending_value = 6;
        transition 0 { _ -> emit_one_char() }
    }
    state set_lbracket() {
        self.pending_value = 7;
        transition 0 { _ -> emit_one_char() }
    }
    state set_rbracket() {
        self.pending_value = 8;
        transition 0 { _ -> emit_one_char() }
    }
    state set_semi() {
        self.pending_value = 9;
        transition 0 { _ -> emit_one_char() }
    }
    state set_comma() {
        self.pending_value = 12;
        transition 0 { _ -> emit_one_char() }
    }
    state set_dot() {
        self.pending_value = 13;
        transition 0 { _ -> emit_one_char() }
    }
    state set_amp() {
        self.pending_value = 14;
        transition 0 { _ -> emit_one_char() }
    }
    state set_plus() {
        self.pending_value = 16;
        transition 0 { _ -> emit_one_char() }
    }
    state set_star() {
        self.pending_value = 18;
        transition 0 { _ -> emit_one_char() }
    }
    state set_slash() {
        self.pending_value = 19;
        transition 0 { _ -> emit_one_char() }
    }
    state emit_one_char() {
        self.push_token(self.pending_value, self.lex_position, 1);
        self.lex_position = self.lex_position + 1;
        transition 0 { _ -> scan() }
    }

    state at_eof() { self.push_token(0, self.lex_position, 0); }
}

// --- the PE writer (single-section, no imports), reused from increment 1 ---

machine Main::write_pe(&mut self) {
    self.raw_section_size = align_up(self.code_length, 512);
    self.data_raw_size = align_up(self.data_size, 512);
    self.data_rva = 4096 + align_up(self.code_length, 4096);
    transition self.data_size { 0 -> no_data() _ -> with_data() }

    state no_data() {
        self.image_size = 4096 + align_up(self.code_length, 4096);
        self.section_count = 1;
        transition 0 { _ -> headers() }
    }
    state with_data() {
        self.image_size = self.data_rva + align_up(self.data_size, 4096);
        self.section_count = 2;
        // patch the entry's `lea rax,[rip+disp32]` to point at the .data section
        self.patch_i32(self.data_reloc_at, self.data_rva - (4096 + self.data_reloc_at + 4));
        transition 0 { _ -> headers() }
    }

    state headers() {
        write_byte(77); write_byte(90);  // "MZ"
        emit_zeros(58);
        emit_u32(64);                    // e_lfanew = 0x40

        write_byte(80); write_byte(69); write_byte(0); write_byte(0); // "PE\0\0"
        emit_u16(34404); emit_u16(self.section_count); // Machine x86-64, section count
        emit_u32(0); emit_u32(0); emit_u32(0);
        emit_u16(240); emit_u16(34);     // SizeOfOptionalHeader, Characteristics

        emit_u16(523);                   // PE32+
        write_byte(0); write_byte(0);
        emit_u32(self.raw_section_size); // SizeOfCode
        emit_u32(self.data_raw_size);    // SizeOfInitializedData
        emit_u32(0);
        emit_u32(4096); emit_u32(4096);  // entry point, base of code
        emit_u32(1073741824); emit_u32(1); // ImageBase = 0x140000000
        emit_u32(4096); emit_u32(512);   // section + file alignment
        emit_u16(6); emit_u16(0); emit_u16(0); emit_u16(0); emit_u16(6); emit_u16(0);
        emit_u32(0);
        emit_u32(self.image_size);
        emit_u32(512);                   // SizeOfHeaders
        emit_u32(0);
        emit_u16(3); emit_u16(0);        // Subsystem = console
        emit_u32(1048576); emit_u32(0);
        emit_u32(4096); emit_u32(0);
        emit_u32(1048576); emit_u32(0);
        emit_u32(4096); emit_u32(0);
        emit_u32(0); emit_u32(16);
        emit_zeros(128);                 // 16 data directories

        write_byte(46); write_byte(116); write_byte(101); write_byte(120); write_byte(116); // ".text"
        write_byte(0); write_byte(0); write_byte(0);
        emit_u32(self.code_length);
        emit_u32(4096);
        emit_u32(self.raw_section_size);
        emit_u32(512);
        emit_u32(0); emit_u32(0);
        emit_u16(0); emit_u16(0);
        emit_u32(1610612768);            // 0x60000020 (code | execute | read)
        transition self.data_size { 0 -> pad_one_section() _ -> data_header() }
    }
    state data_header() {
        write_byte(46); write_byte(100); write_byte(97); write_byte(116); write_byte(97); // ".data"
        write_byte(0); write_byte(0); write_byte(0);
        emit_u32(self.data_size);              // VirtualSize
        emit_u32(self.data_rva);               // VirtualAddress
        emit_u32(self.data_raw_size);          // SizeOfRawData
        emit_u32(512 + self.raw_section_size); // PointerToRawData (after .text)
        emit_u32(0); emit_u32(0);
        emit_u16(0); emit_u16(0);
        write_byte(64); write_byte(0); write_byte(0); write_byte(192); // 0xC0000040 (init|read|write)
        emit_zeros(104);                       // pad headers 408 -> 512
        transition 0 { _ -> emit_text() }
    }
    state pad_one_section() {
        emit_zeros(144);                       // pad headers 368 -> 512
        transition 0 { _ -> emit_text() }
    }

    state emit_text() {
        self.write_cursor = 0;
        transition 0 { _ -> code_step() }
    }
    state code_step() {
        transition self.write_cursor < self.code_length { true -> code_one() false -> code_pad() }
    }
    state code_one() {
        write_byte(self.code[self.write_cursor]);
        self.write_cursor = self.write_cursor + 1;
        transition 0 { _ -> code_step() }
    }
    state code_pad() {
        transition self.write_cursor < self.raw_section_size { true -> code_pad_one() false -> emit_data() }
    }
    state code_pad_one() {
        write_byte(0);
        self.write_cursor = self.write_cursor + 1;
        transition 0 { _ -> code_pad() }
    }
    state emit_data() {
        transition self.data_size { 0 -> done() _ -> data_bytes() }
    }
    state data_bytes() {
        emit_zeros(self.data_raw_size); // .data is zero-initialized
        transition 0 { _ -> done() }
    }
    state done() { }
}

// --- parser (increment 3) ---

// Parse the decimal value of an Int token from its source bytes.
machine Main::token_int(&mut self, token: i32) -> i32 {
    self.int_accumulator = 0;
    self.digit_position = self.token_start[token];
    self.digit_end = self.token_start[token] + self.token_length[token];
    transition 0 { _ -> step() }
    state step() {
        transition self.digit_position < self.digit_end { true -> digit() false -> done() }
    }
    state digit() {
        self.int_accumulator = self.int_accumulator * 10 + self.source[self.digit_position] - 48;
        self.digit_position = self.digit_position + 1;
        transition 0 { _ -> step() }
    }
    state done() { return self.int_accumulator; }
}

// Does `token`'s source text equal the `length` bytes already placed in
// keyword_bytes? The thin is_<keyword> wrappers below fill keyword_bytes and call this.
machine Main::keyword_equals(&mut self, token: i32, length: i32) -> i32 {
    transition self.token_length[token] == length { false -> return_false() _ -> setup() }
    state setup() {
        self.compare_position = 0;
        transition 0 { _ -> compare() }
    }
    state compare() {
        transition self.compare_position < length { true -> compare_byte() false -> return_true() }
    }
    state compare_byte() {
        self.left_byte = self.source[self.token_start[token] + self.compare_position];
        self.right_byte = self.keyword_bytes[self.compare_position];
        transition self.left_byte == self.right_byte { true -> advance() false -> return_false() }
    }
    state advance() {
        self.compare_position = self.compare_position + 1;
        transition 0 { _ -> compare() }
    }
    state return_true() { return 1; }
    state return_false() { return 0; }
}

machine Main::is_exit_process(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 101; self.keyword_bytes[1] = 120; self.keyword_bytes[2] = 105; self.keyword_bytes[3] = 116;   // e x i t
    self.keyword_bytes[4] = 95;  self.keyword_bytes[5] = 112; self.keyword_bytes[6] = 114; self.keyword_bytes[7] = 111;   // _ p r o
    self.keyword_bytes[8] = 99;  self.keyword_bytes[9] = 101; self.keyword_bytes[10] = 115; self.keyword_bytes[11] = 115; // c e s s
    return self.keyword_equals(token, 12);
}

// Do tokens first and second have identical source text?
machine Main::tokens_equal(&mut self, first: i32, second: i32) -> i32 {
    transition self.token_length[first] == self.token_length[second] { false -> return_false() _ -> setup() }
    state setup() {
        self.compare_position = 0;
        transition 0 { _ -> compare() }
    }
    state compare() {
        transition self.compare_position < self.token_length[first] { true -> compare_byte() false -> return_true() }
    }
    state compare_byte() {
        self.left_byte = self.source[self.token_start[first] + self.compare_position];
        self.right_byte = self.source[self.token_start[second] + self.compare_position];
        transition self.left_byte == self.right_byte { true -> advance() false -> return_false() }
    }
    state advance() {
        self.compare_position = self.compare_position + 1;
        transition 0 { _ -> compare() }
    }
    state return_true() { return 1; }
    state return_false() { return 0; }
}

machine Main::is_let(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 108; self.keyword_bytes[1] = 101; self.keyword_bytes[2] = 116; // l e t
    return self.keyword_equals(token, 3);
}

machine Main::is_state(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 115; self.keyword_bytes[1] = 116; self.keyword_bytes[2] = 97;
    self.keyword_bytes[3] = 116; self.keyword_bytes[4] = 101; // s t a t e
    return self.keyword_equals(token, 5);
}

machine Main::is_transition(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 116; self.keyword_bytes[1] = 114; self.keyword_bytes[2] = 97;
    self.keyword_bytes[3] = 110; self.keyword_bytes[4] = 115; self.keyword_bytes[5] = 105;
    self.keyword_bytes[6] = 116; self.keyword_bytes[7] = 105; self.keyword_bytes[8] = 111;
    self.keyword_bytes[9] = 110; // t r a n s i t i o n
    return self.keyword_equals(token, 10);
}

machine Main::is_true(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 116; self.keyword_bytes[1] = 114; self.keyword_bytes[2] = 117;
    self.keyword_bytes[3] = 101; // t r u e
    return self.keyword_equals(token, 4);
}

machine Main::is_false(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 102; self.keyword_bytes[1] = 97; self.keyword_bytes[2] = 108;
    self.keyword_bytes[3] = 115; self.keyword_bytes[4] = 101; // f a l s e
    return self.keyword_equals(token, 5);
}

machine Main::is_return(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 114; self.keyword_bytes[1] = 101; self.keyword_bytes[2] = 116;
    self.keyword_bytes[3] = 117; self.keyword_bytes[4] = 114; self.keyword_bytes[5] = 110; // r e t u r n
    return self.keyword_equals(token, 6);
}

machine Main::is_data(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 100; self.keyword_bytes[1] = 97; self.keyword_bytes[2] = 116;
    self.keyword_bytes[3] = 97; // d a t a
    return self.keyword_equals(token, 4);
}

machine Main::is_self(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 115; self.keyword_bytes[1] = 101; self.keyword_bytes[2] = 108;
    self.keyword_bytes[3] = 102; // s e l f
    return self.keyword_equals(token, 4);
}

machine Main::is_machine(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 109; self.keyword_bytes[1] = 97; self.keyword_bytes[2] = 99;
    self.keyword_bytes[3] = 104; self.keyword_bytes[4] = 105; self.keyword_bytes[5] = 110;
    self.keyword_bytes[6] = 101; // m a c h i n e
    return self.keyword_equals(token, 7);
}

// Resolve identifier token to a local slot (0 if not found — increment 5 assumes
// every referenced local was declared).
machine Main::resolve_local(&mut self, token: i32) -> i32 {
    self.resolve_position = 0;
    transition 0 { _ -> step() }
    state step() {
        transition self.resolve_position < self.local_count { true -> check() false -> not_found() }
    }
    state check() {
        transition self.tokens_equal(self.local_token[self.resolve_position], token) { 1 -> found() _ -> next() }
    }
    state next() {
        self.resolve_position = self.resolve_position + 1;
        transition 0 { _ -> step() }
    }
    state found() { return self.resolve_position; }
    state not_found() { return 0; }
}

// Resolve a state-name token to its index (matched against the pre-scanned states).
machine Main::resolve_state(&mut self, name_token: i32) -> i32 {
    self.resolve_position = 0;
    transition 0 { _ -> step() }
    state step() {
        transition self.resolve_position < self.state_count { true -> check() false -> not_found() }
    }
    state check() {
        transition self.tokens_equal(self.state_name_token[self.resolve_position], name_token) {
            1 -> found()
            _ -> next()
        }
    }
    state next() {
        self.resolve_position = self.resolve_position + 1;
        transition 0 { _ -> step() }
    }
    state found() { return self.resolve_position; }
    state not_found() { return 0; }
}

machine Main::is_main(&mut self, token: i32) -> i32 {
    self.keyword_bytes[0] = 109; self.keyword_bytes[1] = 97; self.keyword_bytes[2] = 105;
    self.keyword_bytes[3] = 110; // m a i n
    return self.keyword_equals(token, 4);
}

// Pre-scan every top-level (depth-0) machine: record its `machine` keyword position
// and its callable name (the last identifier before the parameter-list '('), in
// declaration order. Sets entry_machine to the one named `main`.
machine Main::prescan_machines(&mut self) {
    self.machine_count = 0;
    self.entry_machine = 0;
    self.scan_position = 0;
    self.brace_depth = 0;
    transition 0 { _ -> step() }
    state step() {
        transition self.scan_position < self.token_count { true -> look() false -> done() }
    }
    state look() {
        transition self.token_kind[self.scan_position] {
            3 -> open()    // {
            4 -> close()   // }
            _ -> maybe_machine()
        }
    }
    state open() {
        self.brace_depth = self.brace_depth + 1;
        transition 0 { _ -> advance() }
    }
    state close() {
        self.brace_depth = self.brace_depth - 1;
        transition 0 { _ -> advance() }
    }
    state maybe_machine() {
        transition self.brace_depth { 0 -> check_machine() _ -> advance() }
    }
    state check_machine() {
        transition self.is_machine(self.scan_position) { 1 -> record() _ -> advance() }
    }
    state record() {
        self.machine_start[self.machine_count] = self.scan_position;
        // find the callable name with a separate probe, so scan_position stays on the
        // `machine` keyword and the normal scan still counts the body braces.
        self.probe = self.scan_position + 1;
        transition 0 { _ -> find_name() }
    }
    state find_name() {
        transition self.token_kind[self.probe] {
            5 -> name_done()   // '(' : parameter list
            3 -> name_done()   // '{' : no parameter list
            _ -> name_next()
        }
    }
    state name_next() {
        self.machine_name[self.machine_count] = self.probe; // last segment before '(' or '{'
        self.probe = self.probe + 1;
        transition 0 { _ -> find_name() }
    }
    state name_done() {
        transition self.is_main(self.machine_name[self.machine_count]) { 1 -> set_entry() _ -> count() }
    }
    state set_entry() {
        self.entry_machine = self.machine_count;
        transition 0 { _ -> count() }
    }
    state count() {
        self.machine_count = self.machine_count + 1;
        transition 0 { _ -> advance() } // advance moves past the `machine` keyword only
    }
    state advance() {
        self.scan_position = self.scan_position + 1;
        transition 0 { _ -> step() }
    }
    state done() { }
}

// Resolve a machine-name token (a call target) to its machine index.
machine Main::resolve_machine(&mut self, name_token: i32) -> i32 {
    self.resolve_position = 0;
    transition 0 { _ -> step() }
    state step() {
        transition self.resolve_position < self.machine_count { true -> check() false -> not_found() }
    }
    state check() {
        transition self.tokens_equal(self.machine_name[self.resolve_position], name_token) {
            1 -> found()
            _ -> next()
        }
    }
    state next() {
        self.resolve_position = self.resolve_position + 1;
        transition 0 { _ -> step() }
    }
    state found() { return self.resolve_position; }
    state not_found() { return 0; }
}

// Patch every cross-machine call: rel32 = callee_offset - (rel32_position + 4).
machine Main::patch_calls(&mut self) {
    self.resolve_position = 0;
    transition 0 { _ -> step() }
    state step() {
        transition self.resolve_position < self.call_count { true -> patch_one() false -> done() }
    }
    state patch_one() {
        self.target_machine = self.call_target[self.resolve_position];
        self.pending_value = self.machine_offset[self.target_machine] - (self.call_at[self.resolve_position] + 4);
        self.patch_i32(self.call_at[self.resolve_position], self.pending_value);
        self.resolve_position = self.resolve_position + 1;
        transition 0 { _ -> step() }
    }
    state done() { }
}

// Lay out the (single) `data` type's fields: each scalar field is 8 bytes, a
// boundary capability (an uppercase type name, e.g. Console) is 0, and an array
// `[u8;N]`/`[i32;N]` is N*1 / N*8. Records each field's name token + byte offset,
// and the total instance size (the .data section). alphac.alp has one data type.
machine Main::prescan_data(&mut self) {
    self.field_count = 0;
    self.data_size = 0;
    self.scan_position = 0;
    self.brace_depth = 0;
    transition 0 { _ -> step() }
    state step() {
        transition self.scan_position < self.token_count { true -> look() false -> done() }
    }
    state look() {
        transition self.token_kind[self.scan_position] {
            3 -> open()
            4 -> close()
            _ -> maybe_data()
        }
    }
    state open() { self.brace_depth = self.brace_depth + 1; transition 0 { _ -> advance() } }
    state close() { self.brace_depth = self.brace_depth - 1; transition 0 { _ -> advance() } }
    state maybe_data() {
        transition self.brace_depth { 0 -> check_data() _ -> advance() }
    }
    state check_data() {
        transition self.is_data(self.scan_position) { 1 -> enter_data() _ -> advance() }
    }
    state advance() {
        self.scan_position = self.scan_position + 1;
        transition 0 { _ -> step() }
    }
    state enter_data() {
        self.scan_position = self.scan_position + 3; // skip 'data' NAME '{'
        transition 0 { _ -> field_loop() }
    }
    state field_loop() {
        transition self.token_kind[self.scan_position] { 4 -> done() _ -> a_field() } // '}' ends the data body
    }
    state a_field() {
        self.field_name_token[self.field_count] = self.scan_position;
        self.field_offset[self.field_count] = self.data_size;
        self.field_elem_bytes[self.field_count] = 0;
        self.scan_position = self.scan_position + 2; // skip IDENT ':'
        transition self.token_kind[self.scan_position] {
            7 -> array_field()  // '[' : an array type
            _ -> scalar_field() // an identifier type (scalar or boundary)
        }
    }
    state scalar_field() {
        self.left_byte = self.source[self.token_start[self.scan_position]];
        transition self.left_byte < 97 { true -> boundary_size() false -> scalar_size() } // < 'a' = uppercase = boundary
    }
    state scalar_size() {
        self.data_size = self.data_size + 8;
        self.scan_position = self.scan_position + 1;
        transition 0 { _ -> finish_field() }
    }
    state boundary_size() {
        self.scan_position = self.scan_position + 1; // a capability occupies no storage
        transition 0 { _ -> finish_field() }
    }
    state array_field() {
        self.scan_position = self.scan_position + 1; // skip '['
        transition self.token_length[self.scan_position] { 2 -> array_byte() _ -> array_word() } // "u8" is 2 chars
    }
    state array_byte() {
        self.field_elem_bytes[self.field_count] = 1;
        transition 0 { _ -> array_count() }
    }
    state array_word() {
        self.field_elem_bytes[self.field_count] = 8;
        transition 0 { _ -> array_count() }
    }
    state array_count() {
        self.scan_position = self.scan_position + 2; // skip element type and ';'
        self.pending_value = self.token_int(self.scan_position);
        self.data_size = self.data_size + self.pending_value * self.field_elem_bytes[self.field_count];
        self.scan_position = self.scan_position + 2; // skip N and ']'
        transition 0 { _ -> finish_field() }
    }
    state finish_field() {
        self.field_count = self.field_count + 1;
        transition self.token_kind[self.scan_position] {
            9 -> skip_semicolon() // ';'
            4 -> done()           // '}' (last field, no trailing ;)
            _ -> skip_token()
        }
    }
    state skip_token() {
        self.scan_position = self.scan_position + 1;
        transition 0 { _ -> finish_field() }
    }
    state skip_semicolon() {
        self.scan_position = self.scan_position + 1;
        transition 0 { _ -> field_loop() }
    }
    state done() { }
}

// Resolve a field-name token to its byte offset within the data instance.
machine Main::resolve_field(&mut self, name_token: i32) -> i32 {
    self.resolve_position = 0;
    transition 0 { _ -> step() }
    state step() {
        transition self.resolve_position < self.field_count { true -> check() false -> not_found() }
    }
    state check() {
        transition self.tokens_equal(self.field_name_token[self.resolve_position], name_token) { 1 -> found() _ -> next() }
    }
    state next() {
        self.resolve_position = self.resolve_position + 1;
        transition 0 { _ -> step() }
    }
    state found() { return self.field_offset[self.resolve_position]; }
    state not_found() { return 0; }
}

// --- machine-code emission into self.code ---

machine Main::emit_byte(&mut self, byte: i32) {
    self.code[self.code_length] = byte;
    self.code_length = self.code_length + 1;
}

// emit a little-endian i32 into the code (two's complement, handles negatives)
machine Main::emit_i32(&mut self, value: i32) {
    self.emit_scratch = value;
    self.emit_byte(self.emit_scratch); self.emit_scratch = arithmetic_shift_8(self.emit_scratch);
    self.emit_byte(self.emit_scratch); self.emit_scratch = arithmetic_shift_8(self.emit_scratch);
    self.emit_byte(self.emit_scratch); self.emit_scratch = arithmetic_shift_8(self.emit_scratch);
    self.emit_byte(self.emit_scratch);
}

machine Main::emit_push_immediate(&mut self, value: i32) {
    self.emit_byte(184);          // mov eax, imm32 (0xB8)
    self.emit_i32(value);
    self.emit_byte(80);           // push rax
}

// mov eax, [rbp + disp32] ; push rax     (load local `slot` onto the stack)
machine Main::emit_load_local(&mut self, slot: i32) {
    self.emit_byte(139); self.emit_byte(133);   // 8B /0 mod=10 rm=rbp
    self.emit_i32(0 - 8 * (slot + 1));
    self.emit_byte(80);                          // push rax
}

// pop rax ; mov [rbp + disp32], eax     (store top of stack into local `slot`)
machine Main::emit_store_local(&mut self, slot: i32) {
    self.emit_byte(88);                          // pop rax
    self.emit_byte(137); self.emit_byte(133);    // 89 /0 mod=10 rm=rbp
    self.emit_i32(0 - 8 * (slot + 1));
}

// Spill an incoming register argument into the callee's frame slot.
// `register_index` 0..3 = rcx/rdx/r8/r9; stores `mov [rbp+disp32], <reg>` (64-bit).
machine Main::emit_spill_param(&mut self, slot: i32, register_index: i32) {
    transition register_index {
        0 -> rcx()
        1 -> rdx()
        2 -> r8()
        _ -> r9()
    }
    state rcx() { self.emit_byte(72); self.emit_byte(137); self.emit_byte(141); transition 0 { _ -> disp() } } // 48 89 8D
    state rdx() { self.emit_byte(72); self.emit_byte(137); self.emit_byte(149); transition 0 { _ -> disp() } } // 48 89 95
    state r8()  { self.emit_byte(76); self.emit_byte(137); self.emit_byte(133); transition 0 { _ -> disp() } } // 4C 89 85
    state r9()  { self.emit_byte(76); self.emit_byte(137); self.emit_byte(141); transition 0 { _ -> disp() } } // 4C 89 8D
    state disp() { self.emit_i32(0 - 8 * (slot + 1)); }
}

// Load a pushed call argument from the stack into its ABI register:
// `mov <reg>, [rsp + disp8]` (64-bit). register_index 0..3 = rcx/rdx/r8/r9.
machine Main::emit_load_arg(&mut self, register_index: i32, disp: i32) {
    transition register_index {
        0 -> rcx()
        1 -> rdx()
        2 -> r8()
        _ -> r9()
    }
    state rcx() { self.emit_byte(72); self.emit_byte(139); self.emit_byte(76); self.emit_byte(36); transition 0 { _ -> tail() } } // 48 8B 4C 24
    state rdx() { self.emit_byte(72); self.emit_byte(139); self.emit_byte(84); self.emit_byte(36); transition 0 { _ -> tail() } } // 48 8B 54 24
    state r8()  { self.emit_byte(76); self.emit_byte(139); self.emit_byte(68); self.emit_byte(36); transition 0 { _ -> tail() } } // 4C 8B 44 24
    state r9()  { self.emit_byte(76); self.emit_byte(139); self.emit_byte(76); self.emit_byte(36); transition 0 { _ -> tail() } } // 4C 8B 4C 24
    state tail() { self.emit_byte(disp); } // disp8 (0..24)
}

// Record a forward jump to `target_state` and emit a placeholder rel32 (patched
// once every state's offset is known). The je/jmp opcode is emitted by the caller.
machine Main::record_jump(&mut self, target_state: i32) {
    self.fixup_at[self.fixup_count] = self.code_length;
    self.fixup_target[self.fixup_count] = target_state;
    self.fixup_count = self.fixup_count + 1;
    self.emit_i32(0);
}

// Overwrite the 4 code bytes at `offset` with a little-endian i32.
machine Main::patch_i32(&mut self, offset: i32, value: i32) {
    self.emit_scratch = value;
    self.code[offset] = self.emit_scratch;
    self.emit_scratch = arithmetic_shift_8(self.emit_scratch);
    self.code[offset + 1] = self.emit_scratch;
    self.emit_scratch = arithmetic_shift_8(self.emit_scratch);
    self.code[offset + 2] = self.emit_scratch;
    self.emit_scratch = arithmetic_shift_8(self.emit_scratch);
    self.code[offset + 3] = self.emit_scratch;
}

// Patch every recorded jump: rel32 = target_state_offset - (rel32_position + 4).
machine Main::patch_jumps(&mut self) {
    self.resolve_position = 0;
    transition 0 { _ -> step() }
    state step() {
        transition self.resolve_position < self.fixup_count { true -> patch_one() false -> done() }
    }
    state patch_one() {
        self.target_state = self.fixup_target[self.resolve_position];
        self.pending_value = self.state_offset[self.target_state] - (self.fixup_at[self.resolve_position] + 4);
        self.patch_i32(self.fixup_at[self.resolve_position], self.pending_value);
        self.resolve_position = self.resolve_position + 1;
        transition 0 { _ -> step() }
    }
    state done() { }
}

// pop rcx (rhs); pop rax (lhs); <op> eax,ecx [+ overflow trap]; push rax
machine Main::emit_binary_op(&mut self, operator: i32) {
    self.emit_byte(89);  // pop rcx
    self.emit_byte(88);  // pop rax
    transition operator {
        16 -> emit_add()
        17 -> emit_sub()
        18 -> emit_mul()
        19 -> emit_div()
        20 -> set_less()
        21 -> set_greater()
        22 -> set_less_equal()
        23 -> set_greater_equal()
        24 -> set_equal()
        25 -> set_not_equal()
        _  -> emit_add()
    }
    state emit_add() {
        self.emit_byte(1); self.emit_byte(200);   // add eax,ecx
        transition 0 { _ -> trap() }
    }
    state emit_sub() {
        self.emit_byte(41); self.emit_byte(200);  // sub eax,ecx
        transition 0 { _ -> trap() }
    }
    state emit_mul() {
        self.emit_byte(15); self.emit_byte(175); self.emit_byte(193); // imul eax,ecx
        transition 0 { _ -> trap() }
    }
    state emit_div() {
        self.emit_byte(153); self.emit_byte(247); self.emit_byte(249); // cdq; idiv ecx
        transition 0 { _ -> push_result() }
    }
    state trap() {
        self.emit_byte(113); self.emit_byte(2); self.emit_byte(15); self.emit_byte(11); // jno +2 ; ud2
        transition 0 { _ -> push_result() }
    }
    // comparisons: a setter picks the setcc opcode, then emit_comparison emits
    // cmp eax,ecx ; setcc al ; movzx eax,al  (result is 0 or 1)
    state set_less()          { self.setcc_byte = 156; transition 0 { _ -> emit_comparison() } } // setl  0x9C
    state set_greater()       { self.setcc_byte = 159; transition 0 { _ -> emit_comparison() } } // setg  0x9F
    state set_less_equal()    { self.setcc_byte = 158; transition 0 { _ -> emit_comparison() } } // setle 0x9E
    state set_greater_equal() { self.setcc_byte = 157; transition 0 { _ -> emit_comparison() } } // setge 0x9D
    state set_equal()         { self.setcc_byte = 148; transition 0 { _ -> emit_comparison() } } // sete  0x94
    state set_not_equal()     { self.setcc_byte = 149; transition 0 { _ -> emit_comparison() } } // setne 0x95
    state emit_comparison() {
        self.emit_byte(57); self.emit_byte(200);                              // cmp eax, ecx
        self.emit_byte(15); self.emit_byte(self.setcc_byte); self.emit_byte(192); // setcc al
        self.emit_byte(15); self.emit_byte(182); self.emit_byte(192);         // movzx eax, al
        transition 0 { _ -> push_result() }
    }
    state push_result() { self.emit_byte(80); } // push rax
}

// Compile an arithmetic expression (Int / + - * /) from self.token_position until ')' or Eof,
// emitting stack-machine code. Iterative shunting-yard (no recursion).
machine Main::compile_expr(&mut self) {
    // The operator stack is shared, but each (possibly nested, via a call operand)
    // compile_expr only owns the operators it pushes above `base`, and flushes back
    // down to `base` — so recursion through call arguments is safe.
    let base: i32 = self.operator_count;
    transition 0 { _ -> step() }
    state step() {
        transition self.token_kind[self.token_position] {
            6 -> flush()   // )
            9 -> flush()   // ;
            3 -> flush()   // {  (end of a transition subject)
            12 -> flush()  // ,  (end of a call argument)
            0 -> flush()   // Eof
            _ -> item()
        }
    }
    state item() {
        transition self.token_kind[self.token_position] {
            2 -> operand_int()
            1 -> operand_name()
            16 -> binop()
            17 -> binop()
            18 -> binop()
            19 -> binop()
            20 -> binop()
            21 -> binop()
            22 -> binop()
            23 -> binop()
            24 -> binop()
            25 -> binop()
            _ -> skip()
        }
    }
    state operand_int() {
        self.pending_value = self.token_int(self.token_position);
        self.emit_push_immediate(self.pending_value);
        self.token_position = self.token_position + 1;
        transition 0 { _ -> step() }
    }
    // an identifier is `self.<field>` / `self.<method>(...)`, a free call `name(...)`,
    // or a local load
    state operand_name() {
        transition self.is_self(self.token_position) { 1 -> operand_self() _ -> operand_name2() }
    }
    state operand_self() {
        self.token_position = self.token_position + 2; // skip 'self' '.'
        transition self.token_kind[self.token_position + 1] { 5 -> operand_self_call() _ -> operand_self_field() } // 5 = '('
    }
    state operand_self_call() {
        self.compile_self_call(); // method call; leaves the result pushed
        transition 0 { _ -> step() }
    }
    state operand_self_field() {
        self.field_offset_result = self.resolve_field(self.token_position);
        self.token_position = self.token_position + 1; // skip field name
        self.emit_byte(72); self.emit_byte(139); self.emit_byte(133); self.emit_i32(0 - 512); // mov rax,[rbp-512]
        self.emit_byte(139); self.emit_byte(128); self.emit_i32(self.field_offset_result);    // mov eax,[rax+off]
        self.emit_byte(80); // push rax
        transition 0 { _ -> step() }
    }
    state operand_name2() {
        transition self.token_kind[self.token_position + 1] { 5 -> operand_call() _ -> operand_local() } // 5 = '('
    }
    state operand_call() {
        self.compile_call(); // leaves the result pushed; advances past the call
        transition 0 { _ -> step() }
    }
    state operand_local() {
        self.pending_value = self.resolve_local(self.token_position);
        self.emit_load_local(self.pending_value);
        self.token_position = self.token_position + 1;
        transition 0 { _ -> step() }
    }
    state skip() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> step() }
    }
    state binop() {
        self.current_operator = self.token_kind[self.token_position];
        transition 0 { _ -> pop_loop() }
    }
    state pop_loop() {
        transition self.operator_count > base { true -> pop_test() false -> push_op() }
    }
    state pop_test() {
        self.top_precedence = precedence(self.operator_stack[self.operator_count - 1]);
        self.current_precedence = precedence(self.current_operator);
        transition self.top_precedence < self.current_precedence { true -> push_op() false -> pop_emit() } // emit while top prec >= cur
    }
    state pop_emit() {
        self.operator_count = self.operator_count - 1;
        self.emit_binary_op(self.operator_stack[self.operator_count]);
        transition 0 { _ -> pop_loop() }
    }
    state push_op() {
        self.operator_stack[self.operator_count] = self.current_operator;
        self.operator_count = self.operator_count + 1;
        self.token_position = self.token_position + 1;
        transition 0 { _ -> step() }
    }
    state flush() {
        transition self.operator_count > base { true -> flush_emit() false -> done() }
    }
    state flush_emit() {
        self.operator_count = self.operator_count - 1;
        self.emit_binary_op(self.operator_stack[self.operator_count]);
        transition 0 { _ -> flush() }
    }
    state done() { }
}

// Compile a call `name(args)` with token_position at the callee name: evaluate
// each argument (leaving it pushed), load the first four into rcx/rdx/r8/r9,
// discard them from the stack, `call rel32` the callee (recorded for patching),
// and leave the result pushed. Per-call locals survive nested-call recursion.
machine Main::compile_call(&mut self) {
    let callee: i32 = self.resolve_machine(self.token_position);
    let argument_count: i32 = 0;
    let load_index: i32 = 0;
    self.token_position = self.token_position + 2; // skip name '('
    transition 0 { _ -> arg_loop() }
    state arg_loop() {
        transition self.token_kind[self.token_position] { 6 -> begin_loads() _ -> one_arg() } // 6 = ')'
    }
    state one_arg() {
        self.compile_expr(); // pushes the argument
        argument_count = argument_count + 1;
        transition self.token_kind[self.token_position] { 12 -> skip_comma() _ -> arg_loop() } // 12 = ','
    }
    state skip_comma() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> arg_loop() }
    }
    state begin_loads() {
        self.token_position = self.token_position + 1; // skip ')'
        transition 0 { _ -> load_loop() }
    }
    state load_loop() {
        transition load_index < argument_count { true -> load_one() false -> discard_args() }
    }
    state load_one() {
        self.emit_load_arg(load_index, 8 * (argument_count - 1 - load_index));
        load_index = load_index + 1;
        transition 0 { _ -> load_loop() }
    }
    state discard_args() {
        transition argument_count { 0 -> emit_call() _ -> drop() }
    }
    state drop() {
        self.emit_byte(72); self.emit_byte(131); self.emit_byte(196); // add rsp, imm8 (48 83 C4)
        self.emit_byte(8 * argument_count);
        transition 0 { _ -> emit_call() }
    }
    state emit_call() {
        self.emit_byte(232); // call rel32 (0xE8)
        self.call_at[self.call_count] = self.code_length;
        self.call_target[self.call_count] = callee;
        self.call_count = self.call_count + 1;
        self.emit_i32(0);    // placeholder rel32
        self.emit_byte(80);  // push rax (return value)
    }
}

// Compile a method call `self.m(args)` with token_position at the method name:
// like compile_call, but self goes in rcx and the args shift to rdx/r8/r9.
machine Main::compile_self_call(&mut self) {
    let callee: i32 = self.resolve_machine(self.token_position);
    let argument_count: i32 = 0;
    let load_index: i32 = 0;
    self.token_position = self.token_position + 2; // skip name '('
    transition 0 { _ -> arg_loop() }
    state arg_loop() {
        transition self.token_kind[self.token_position] { 6 -> begin_loads() _ -> one_arg() } // 6 = ')'
    }
    state one_arg() {
        self.compile_expr();
        argument_count = argument_count + 1;
        transition self.token_kind[self.token_position] { 12 -> skip_comma() _ -> arg_loop() } // 12 = ','
    }
    state skip_comma() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> arg_loop() }
    }
    state begin_loads() {
        self.token_position = self.token_position + 1; // skip ')'
        transition 0 { _ -> load_loop() }
    }
    state load_loop() {
        transition load_index < argument_count { true -> load_one() false -> discard_args() }
    }
    state load_one() {
        self.emit_load_arg(load_index + 1, 8 * (argument_count - 1 - load_index)); // +1: skip rcx (=self)
        load_index = load_index + 1;
        transition 0 { _ -> load_loop() }
    }
    state discard_args() {
        transition argument_count { 0 -> pass_self() _ -> drop() }
    }
    state drop() {
        self.emit_byte(72); self.emit_byte(131); self.emit_byte(196); // add rsp, imm8
        self.emit_byte(8 * argument_count);
        transition 0 { _ -> pass_self() }
    }
    state pass_self() {
        self.emit_byte(72); self.emit_byte(139); self.emit_byte(141); self.emit_i32(0 - 512); // mov rcx, [rbp-512]
        transition 0 { _ -> emit_call() }
    }
    state emit_call() {
        self.emit_byte(232); // call rel32
        self.call_at[self.call_count] = self.code_length;
        self.call_target[self.call_count] = callee;
        self.call_count = self.call_count + 1;
        self.emit_i32(0);    // placeholder rel32
        self.emit_byte(80);  // push rax (return value)
    }
}

// Pre-scan the machine body (from token_position, just past its '{') for the
// names of its top-level states, in declaration order. Depth-aware: only `state`
// keywords directly inside the body (depth 1) count, not ones nested in arms.
machine Main::prescan_states(&mut self) {
    self.state_count = 0;
    self.scan_position = self.token_position;
    self.brace_depth = 1;
    transition 0 { _ -> step() }
    state step() {
        transition self.brace_depth { 0 -> done() _ -> scan() }
    }
    state scan() {
        transition self.scan_position < self.token_count { true -> look() false -> done() }
    }
    state look() {
        transition self.token_kind[self.scan_position] {
            3 -> open()    // {
            4 -> close()   // }
            _ -> maybe_state()
        }
    }
    state open() {
        self.brace_depth = self.brace_depth + 1;
        transition 0 { _ -> advance() }
    }
    state close() {
        self.brace_depth = self.brace_depth - 1;
        transition 0 { _ -> advance() }
    }
    state maybe_state() {
        transition self.brace_depth { 1 -> check_state() _ -> advance() }
    }
    state check_state() {
        transition self.is_state(self.scan_position) { 1 -> record() _ -> advance() }
    }
    state record() {
        self.state_name_token[self.state_count] = self.scan_position + 1; // the name after 'state'
        self.state_count = self.state_count + 1;
        transition 0 { _ -> advance() }
    }
    state advance() {
        self.scan_position = self.scan_position + 1;
        transition 0 { _ -> step() }
    }
    state done() { }
}

// Compile one statement at token_position, advancing past it. Handles
// `let`, local reassignment `IDENT = expr;`, `transition`, and `exit_process(expr)`.
machine Main::compile_statement(&mut self) {
    transition self.is_let(self.token_position) { 1 -> do_let() _ -> not_let() }
    state not_let() {
        transition self.is_return(self.token_position) { 1 -> do_return() _ -> not_return() }
    }
    state not_return() {
        transition self.is_transition(self.token_position) { 1 -> do_transition() _ -> not_transition() }
    }
    state not_transition() {
        transition self.is_exit_process(self.token_position) { 1 -> do_exit() _ -> not_exit() }
    }
    state not_exit() {
        transition self.is_self(self.token_position) { 1 -> self_statement() _ -> maybe_ident() }
    }
    state maybe_ident() {
        transition self.token_kind[self.token_position] { 1 -> ident_statement() _ -> skip_one() } // 1 = Ident
    }
    state ident_statement() {
        transition self.token_kind[self.token_position + 1] {
            15 -> do_reassign()      // '=' : local reassignment
            5 -> do_call_statement() // '(' : a call evaluated for effect
            _ -> skip_one()
        }
    }
    state skip_one() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> done() }
    }
    state do_return() {
        self.token_position = self.token_position + 1; // skip 'return'
        self.compile_expr();
        self.emit_byte(88);                            // pop rax
        self.emit_byte(72); self.emit_byte(137); self.emit_byte(236); // mov rsp,rbp
        self.emit_byte(93);                            // pop rbp
        self.emit_byte(195);                           // ret
        transition self.token_kind[self.token_position] { 9 -> skip_semicolon() _ -> done() }
    }
    state do_call_statement() {
        self.compile_call(); // pushes the result
        self.emit_byte(88);  // pop rax (discard it)
        transition self.token_kind[self.token_position] { 9 -> skip_semicolon() _ -> done() }
    }

    // a `self`-led statement: a field write, a method-call statement, or a
    // capability call `self.console.exit_process(...)`. Dispatch on the token after
    // the field name — i.e. self(.0) .(.1) field(.2) <here .3>.
    state self_statement() {
        transition self.token_kind[self.token_position + 3] {
            15 -> self_field_write()     // self . field =
            5 -> self_method_statement() // self . method (
            13 -> self_boundary()        // self . capability . op (...)
            _ -> skip_one()
        }
    }
    state self_field_write() {
        self.token_position = self.token_position + 2; // skip 'self' '.'
        self.field_offset_result = self.resolve_field(self.token_position);
        self.token_position = self.token_position + 2; // skip field '='
        self.compile_expr();
        self.emit_byte(89);  // pop rcx (value)
        self.emit_byte(72); self.emit_byte(139); self.emit_byte(133); self.emit_i32(0 - 512); // mov rax,[rbp-512]
        self.emit_byte(137); self.emit_byte(136); self.emit_i32(self.field_offset_result);    // mov [rax+off],ecx
        transition self.token_kind[self.token_position] { 9 -> skip_semicolon() _ -> done() }
    }
    state self_method_statement() {
        self.token_position = self.token_position + 2; // skip 'self' '.' (at method name)
        self.compile_self_call(); // pushes the result
        self.emit_byte(88);       // pop rax (discard it)
        transition self.token_kind[self.token_position] { 9 -> skip_semicolon() _ -> done() }
    }
    state self_boundary() {
        self.token_position = self.token_position + 4; // skip 'self' '.' capability '.'
        transition 0 { _ -> boundary_op() }
    }
    state boundary_op() {
        // exit_process is the only capability op compiled for now (I/O comes in 7d)
        transition self.is_exit_process(self.token_position) { 1 -> do_exit() _ -> skip_one() }
    }

    state do_let() {
        self.token_position = self.token_position + 1;            // skip 'let'
        self.local_token[self.local_count] = self.token_position; // IDENT names this local
        self.current_slot = self.local_count;
        self.local_count = self.local_count + 1;
        self.token_position = self.token_position + 4;            // skip IDENT : TYPE =
        self.compile_expr();
        self.emit_store_local(self.current_slot);
        transition self.token_kind[self.token_position] { 9 -> skip_semicolon() _ -> done() }
    }
    state do_reassign() {
        self.current_slot = self.resolve_local(self.token_position);
        self.token_position = self.token_position + 2;            // skip IDENT '='
        self.compile_expr();
        self.emit_store_local(self.current_slot);
        transition self.token_kind[self.token_position] { 9 -> skip_semicolon() _ -> done() }
    }
    state skip_semicolon() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> done() }
    }

    state do_exit() {
        self.token_position = self.token_position + 2;            // skip 'exit_process' '('
        self.compile_expr();
        self.emit_byte(88);                                       // pop rax
        self.emit_byte(72); self.emit_byte(137); self.emit_byte(236); // mov rsp,rbp
        self.emit_byte(93);                                       // pop rbp
        self.emit_byte(195);                                      // ret
        transition self.token_kind[self.token_position] { 6 -> skip_rparen() _ -> done() } // skip ')'
    }
    state skip_rparen() {
        self.token_position = self.token_position + 1;
        transition self.token_kind[self.token_position] { 9 -> skip_semicolon() _ -> done() }
    }

    state do_transition() {
        self.token_position = self.token_position + 1;            // skip 'transition'
        self.compile_expr();                                       // subject; stops at '{'
        self.emit_byte(88);                                       // pop rax (subject value)
        self.token_position = self.token_position + 1;            // skip '{'
        transition 0 { _ -> arm_loop() }
    }
    state arm_loop() {
        transition self.token_kind[self.token_position] {
            4 -> arm_end()   // '}'
            0 -> arm_end()   // Eof
            _ -> arm()
        }
    }
    state arm() {
        transition self.token_kind[self.token_position] {
            2 -> arm_int()      // Int pattern
            1 -> arm_ident()    // true / false / _
            _ -> arm_skip()
        }
    }
    state arm_int() {
        self.pattern_value = self.token_int(self.token_position);
        self.arm_is_wild = 0;
        transition 0 { _ -> arm_target() }
    }
    state arm_ident() {
        transition self.is_true(self.token_position) { 1 -> arm_true() _ -> arm_ident_false() }
    }
    state arm_true() {
        self.pattern_value = 1;
        self.arm_is_wild = 0;
        transition 0 { _ -> arm_target() }
    }
    state arm_ident_false() {
        transition self.is_false(self.token_position) { 1 -> arm_false() _ -> arm_wild() }
    }
    state arm_false() {
        self.pattern_value = 0;
        self.arm_is_wild = 0;
        transition 0 { _ -> arm_target() }
    }
    state arm_wild() {
        self.arm_is_wild = 1;
        transition 0 { _ -> arm_target() }
    }
    state arm_target() {
        self.token_position = self.token_position + 1;            // skip pattern
        self.token_position = self.token_position + 1;            // skip '->'
        self.target_state = self.resolve_state(self.token_position);
        self.token_position = self.token_position + 3;            // skip name '(' ')'
        transition self.arm_is_wild { 1 -> emit_jump() _ -> emit_branch() }
    }
    state emit_branch() {
        self.emit_byte(61);                                       // cmp eax, imm32 (0x3D)
        self.emit_i32(self.pattern_value);
        self.emit_byte(15); self.emit_byte(132);                  // je rel32 (0F 84)
        self.record_jump(self.target_state);
        transition 0 { _ -> arm_loop() }
    }
    state emit_jump() {
        self.emit_byte(233);                                      // jmp rel32 (0xE9)
        self.record_jump(self.target_state);
        transition 0 { _ -> arm_loop() }
    }
    state arm_skip() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> arm_loop() }
    }
    state arm_end() {
        self.token_position = self.token_position + 1;            // skip '}'
        transition 0 { _ -> done() }
    }

    state done() { }
}

// Compile statements until the end of a block: '}', a 'state' keyword (entry block
// ending), or Eof. Leaves token_position at that terminator.
machine Main::compile_block(&mut self) {
    transition 0 { _ -> step() }
    state step() {
        transition self.token_kind[self.token_position] {
            4 -> stop()   // '}'
            0 -> stop()   // Eof
            _ -> check_state()
        }
    }
    state check_state() {
        transition self.is_state(self.token_position) { 1 -> stop() _ -> one_statement() }
    }
    state one_statement() {
        self.compile_statement();
        transition 0 { _ -> step() }
    }
    state stop() { }
}

// Emit a frame prologue, then the entry block and each state block (states become
// code labels), then a trailing exit-0 and the jump fixups.
// Driver: pre-scan all machines, emit the entry machine first (so the PE entry
// stays at code offset 0), then the rest, then patch cross-machine call rel32s.
machine Main::parse(&mut self) {
    self.code_length = 0;
    self.call_count = 0;
    self.token_position = 0;
    self.prescan_machines();
    self.prescan_data(); // lay out data fields (consumed by self.field codegen in 7b part 2)
    self.emit_machine(self.entry_machine);
    self.emit_machine_index = 0;
    transition 0 { _ -> loop() }
    state loop() {
        transition self.emit_machine_index < self.machine_count { true -> consider() false -> finish() }
    }
    state consider() {
        transition self.emit_machine_index == self.entry_machine { true -> skip_entry() false -> emit_it() }
    }
    state skip_entry() {
        self.emit_machine_index = self.emit_machine_index + 1;
        transition 0 { _ -> loop() }
    }
    state emit_it() {
        self.emit_machine(self.emit_machine_index);
        self.emit_machine_index = self.emit_machine_index + 1;
        transition 0 { _ -> loop() }
    }
    state finish() {
        self.patch_calls();
    }
}

// Emit one machine as a function: parse its header (spilling value params to frame
// slots), emit a frame prologue, the entry block, each state block (states become
// code labels), a trailing exit-0, then patch this machine's state-jump fixups.
machine Main::emit_machine(&mut self, machine_index: i32) {
    let spill_index: i32 = 0;
    self.machine_offset[machine_index] = self.code_length;
    self.token_position = self.machine_start[machine_index];
    self.local_count = 0;
    self.param_count = 0;
    self.state_count = 0;
    self.state_emit_index = 0;
    self.fixup_count = 0;
    self.machine_has_self = 0;
    self.token_position = self.token_position + 1; // skip 'machine'
    transition 0 { _ -> skip_name() }

    state skip_name() {
        transition self.token_kind[self.token_position] {
            5 -> open_params()   // '(' : a parameter list follows
            3 -> prologue()      // '{' : no parameter list (param_count stays 0)
            _ -> skip_name_token()
        }
    }
    state skip_name_token() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> skip_name() }
    }
    state open_params() {
        self.token_position = self.token_position + 1; // skip '('
        transition 0 { _ -> param_loop() }
    }
    state param_loop() {
        transition self.token_kind[self.token_position] {
            6 -> close_params()  // ')'
            14 -> receiver()     // '&' : a `&mut self` / `&self` receiver
            _ -> one_param()
        }
    }
    state receiver() {
        self.machine_has_self = 1;
        self.token_position = self.token_position + 1; // skip '&'
        transition 0 { _ -> skip_receiver() }
    }
    state skip_receiver() {
        // skip the `mut` and `self` identifiers
        transition self.token_kind[self.token_position] { 1 -> skip_receiver_word() _ -> after_param() } // 1 = Ident
    }
    state skip_receiver_word() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> skip_receiver() }
    }
    state one_param() {
        self.local_token[self.local_count] = self.token_position; // value param name
        self.local_count = self.local_count + 1;
        self.param_count = self.param_count + 1;
        self.token_position = self.token_position + 3; // skip IDENT ':' TYPE
        transition 0 { _ -> after_param() }
    }
    state after_param() {
        transition self.token_kind[self.token_position] { 12 -> skip_param_comma() _ -> param_loop() } // 12 = ','
    }
    state skip_param_comma() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> param_loop() }
    }
    state close_params() {
        self.token_position = self.token_position + 1; // skip ')'
        transition 0 { _ -> skip_return_type() }
    }
    state skip_return_type() {
        transition self.token_kind[self.token_position] { 3 -> prologue() _ -> skip_return_token() } // 3 = '{'
    }
    state skip_return_token() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> skip_return_type() }
    }
    state prologue() {
        self.emit_byte(85);                                          // push rbp
        self.emit_byte(72); self.emit_byte(137); self.emit_byte(229); // mov rbp, rsp
        self.emit_byte(72); self.emit_byte(129); self.emit_byte(236); // sub rsp, imm32
        self.emit_i32(512);
        transition 0 { _ -> spill_loop() }
    }
    state spill_loop() {
        transition spill_index < self.param_count { true -> spill_one() false -> setup_self() }
    }
    state spill_one() {
        // a `&mut self` method takes self in rcx, so value params start at register 1
        self.emit_spill_param(spill_index, spill_index + self.machine_has_self);
        spill_index = spill_index + 1;
        transition 0 { _ -> spill_loop() }
    }
    state setup_self() {
        transition self.machine_has_self { 1 -> self_present() _ -> body() }
    }
    state self_present() {
        transition machine_index == self.entry_machine { true -> entry_self() false -> method_self() }
    }
    state entry_self() {
        // self = the static .data instance:  lea rax, [rip+disp32] ; mov [rbp-512], rax
        self.emit_byte(72); self.emit_byte(141); self.emit_byte(5); // 48 8D 05 (lea rax,[rip+disp32])
        self.data_reloc_at = self.code_length;
        self.emit_i32(0); // disp32 placeholder, patched in write_pe
        self.emit_byte(72); self.emit_byte(137); self.emit_byte(133); self.emit_i32(0 - 512); // mov [rbp-512], rax
        transition 0 { _ -> body() }
    }
    state method_self() {
        // self came in rcx:  mov [rbp-512], rcx
        self.emit_byte(72); self.emit_byte(137); self.emit_byte(141); self.emit_i32(0 - 512); // 48 89 8D disp32
        transition 0 { _ -> body() }
    }
    state body() {
        self.token_position = self.token_position + 1; // skip the body '{'
        self.prescan_states();
        transition 0 { _ -> entry_block() }
    }
    state entry_block() {
        self.compile_block(); // entry statements, until the first 'state' or '}'
        transition 0 { _ -> state_loop() }
    }
    state state_loop() {
        transition self.is_state(self.token_position) { 1 -> begin_state() _ -> finalize() }
    }
    state begin_state() {
        self.state_offset[self.state_emit_index] = self.code_length; // this state's label
        self.state_emit_index = self.state_emit_index + 1;
        self.token_position = self.token_position + 2; // skip 'state' and its name
        transition 0 { _ -> skip_to_brace() }
    }
    state skip_to_brace() {
        transition self.token_kind[self.token_position] { 3 -> enter_state_body() _ -> skip_state_header() } // 3 = '{'
    }
    state skip_state_header() {
        self.token_position = self.token_position + 1;
        transition 0 { _ -> skip_to_brace() }
    }
    state enter_state_body() {
        self.token_position = self.token_position + 1; // skip '{'
        self.compile_block();                           // state body, until '}'
        self.token_position = self.token_position + 1; // skip '}'
        transition 0 { _ -> state_loop() }
    }
    state finalize() {
        // trailing default: xor eax,eax ; mov rsp,rbp ; pop rbp ; ret  (fall-through exit 0)
        self.emit_byte(49); self.emit_byte(192);
        self.emit_byte(72); self.emit_byte(137); self.emit_byte(236);
        self.emit_byte(93); self.emit_byte(195);
        self.patch_jumps();
    }
}

machine Main::main(&mut self) {
    self.read_source();
    self.lex();
    self.parse();      // builds self.code / self.code_length
    self.write_pe();
    self.console.exit_process(0)
}
