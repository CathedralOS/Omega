; SUBTRACTING LOOP: total starts at n*a and loses a per iteration over i<n — a data-dependent loop whose
; accumulator DECREASES. Summarized as a ℤ difference-pair whose pos/neg components are independent series:
; (k 5 (m n a) (p z (m n a))). Numerically drains to 0 for every input; the FORM certifies the compilation.
proc main() {
    let n = read_byte()
    let a = read_byte()
    let total = (n * a)
    let i = 0
    state loop { to body when (i < n)  to done }
    state body { total = (total - a)  i = (i + 1)  to loop }
    state done { return total }
}
