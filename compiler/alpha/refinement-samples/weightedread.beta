; COEFFICIENTED STREAM SUM: the loop delta mixes a read with ordinary terms — a*read_byte() + i per
; iteration splits into an invariant-coefficient stream sum a·Σ input[2..2+n) plus the ordinary series g(n).
; _split_stream separates the delta's stream part from its rest; the rest goes through the usual linear
; decompose, the stream part becomes (m (k 8 lo hi) coef). read·read (a quadratic stream) refuses.
proc main() {
    let n = read_byte()
    let a = read_byte()
    let total = 0
    let i = 0
    state loop { to body when (i < n)  to done }
    state body { total = (total + ((a * read_byte()) + i))  i = (i + 1)  to loop }
    state done { return total }
}
