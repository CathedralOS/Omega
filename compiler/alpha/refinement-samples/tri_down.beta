; DOWN-COUNTING Σ: total += i while i drains n..1 — the sum 1+2+…+n = n(n+1)/2. Under i ↦ n-k the delta's
; linear part folds into the invariant coefficient and its triangular part flips sign across the ℤ pair:
; (k 5 (p z (m n n)) (p z (f 90 n))) = n² - g(n) = n(n+1)/2. The mirror of the up-counting tri sample.
proc main() {
    let n = read_byte()
    let total = 0
    let i = n
    state loop { to body when (0 < i)  to done }
    state body { total = (total + i)  i = (i - 1)  to loop }
    state done { return total }
}
