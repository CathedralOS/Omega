; DATA-DEPENDENT loop: add a to a running total n times (n is an input) -> n*a.
; Neither symbolic evaluator can unroll a symbolic trip count; both SUMMARIZE the loop to a closed form.
proc main() {
    let n = read_byte()
    let a = read_byte()
    let total = 0
    let i = 0
    state loop { to body when (i < n)  return total }
    state body { total = total + a  i = i + 1  to loop }
}
