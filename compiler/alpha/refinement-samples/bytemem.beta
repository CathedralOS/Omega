; BYTE MEMORY (straight-line, concrete addresses): values round-trip through byte[..] stores/loads. A stored
; SYMBOLIC value is modelled UNTRUNCATED even though storeb keeps only the low byte — sound because the
; observable is mod 256 and +/-/* respect mod-256 congruence, so every observed byte matches the machine
; (validated here with a+b up to 510). Addresses are high (5000+) — low addresses alias the program image on
; the machine (initial memory IS the tape) but read 0 in the source interpreter, and would honestly FAIL.
proc main() {
    let a = read_byte()
    let b = read_byte()
    byte[5000] = (a + b)
    byte[5001] = 7
    byte[5001] = b
    return ((byte[5000] * 2) + byte[5001])
}
