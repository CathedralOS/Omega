; DOWN-COUNTING LOOP: i drains from n to 0 under guard (0 < i); total accumulates a per iteration — exactly n
; trips, so total = n*a, the SAME closed form the up-counting muln reaches. The counter steps by the ℤ pair -1;
; counter-dependent deltas are refused under a down-counter (its value is n-k, not k).
proc main() {
    let n = read_byte()
    let a = read_byte()
    let total = 0
    let i = n
    state loop { to body when (0 < i)  to done }
    state body { total = (total + a)  i = (i - 1)  to loop }
    state done { return total }
}
