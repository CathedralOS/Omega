; PROC CALL INSIDE A SUMMARIZED LOOP: double(i) is inlined during the placeholder body run (alpha's body
; runner gained call/ret; beta's ev always inlined). The callee's temp slots are REWRITE slots — fully
; overwritten each iteration, no additive delta — dropped post-loop (poisoned; a stale read refuses).
; Here the call's result is counter-linear: total += i+i per iteration → 2·g(n).
proc double(x) {
    return (x + x)
}
proc main() {
    let n = read_byte()
    let total = 0
    let i = 0
    state loop { to body when (i < n)  to done }
    state body { total = (total + double(i))  i = (i + 1)  to loop }
    state done { return total }
}
