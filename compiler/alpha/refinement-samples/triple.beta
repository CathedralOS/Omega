; one input byte, tripled by a concrete-bounded state loop (total += a, three times).
; The loop's control flow is data-independent, so it unrolls; the accumulated value stays symbolic.
; refines 3*a.
proc main() {
    let a = read_byte()
    let total = 0
    let i = 0
    state loop { to body when (i < 3)  return total }
    state body { total = total + a  i = i + 1  to loop }
}
