; STORED COMPARISON: a boolean is a first-class VALUE — (a < b) materializes as the constructor (k 10 a b)
; (0/1 under evaluation, exactly the byte the machine's compare idiom writes), flows through arithmetic,
; byte memory, and later branches. Here: f*10 + [a!=b], summing two independent boolean facts.
proc main() {
    let a = read_byte()
    let b = read_byte()
    let f = (a < b)
    byte[5000] = (a != b)
    return ((f * 10) + byte[5000])
}
