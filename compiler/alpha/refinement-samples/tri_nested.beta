; TRIANGULAR NESTED LOOP: the inner bound IS the outer counter (j < i), so the inner summary's trip count is
; the outer counter's marker — the outer delta comes out counter-LINEAR (a*i) and the existing linear
; machinery finishes: total = a * g(n) = a * n(n-1)/2. Recursive summarization composing with the
; counter-linear class, no new theory.
proc main() {
    let n = read_byte()
    let a = read_byte()
    let total = 0
    let i = 0
    state outer { to obody when (i < n)  to done }
    state obody { let j = 0  to inner }
    state inner { to ibody when (j < i)  to onext }
    state ibody { total = (total + a)  j = (j + 1)  to inner }
    state onext { i = (i + 1)  to outer }
    state done { return total }
}
