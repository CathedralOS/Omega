; MONUS TRIP COUNT: the counter starts at a symbolic input a — trip = n ∸ a (truncated subtraction, the
; constructor (k 6 n a)), the BRANCH-FREE trip count: a > n runs 0 times on the machine and 0 = n ∸ a in ℕ
; alike, so the closed form holds for ALL inputs with no case split. Counter-linear deltas fold the start
; offset into the invariant coefficient: Σ_{i=a}^{n-1} i = (n∸a)·a + g(n∸a). Like the ℤ pair, monus is a
; plain binary constructor to the kernel ((data 6 2 0 0), certs by refl); its meaning lives in the two
; differentially-pinned evaluators.
proc main() {
    let n = read_byte()
    let a = read_byte()
    let total = 0
    let i = a
    state loop { to body when (i < n)  to done }
    state body { total = (total + i)  i = (i + 1)  to loop }
    state done { return total }
}
