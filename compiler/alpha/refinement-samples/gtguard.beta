; >-SPELLED GUARD: (i > 0) is the swapped spelling of (0 < i). bc's codegen swaps the operands into the same
; jlt idiom, so the BYTECODE recognizer never sees > at all; beta_symbolic normalizes the source guard the
; same way ((a > b) ≡ (b < a)) before recognition. Same closed form as the countdown sample: n*a.
proc main() {
    let n = read_byte()
    let a = read_byte()
    let total = 0
    let i = n
    state loop { to body when (i > 0)  to done }
    state body { total = (total + a)  i = (i - 1)  to loop }
    state done { return total }
}
