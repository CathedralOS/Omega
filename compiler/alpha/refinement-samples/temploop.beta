; PER-ITERATION REWRITE TEMP: t is fully overwritten each iteration (t = a*i) — no additive delta exists for
; it, so it is dropped post-loop rather than refusing the whole loop; total's delta reads the FRESH t through
; register flow, giving the counter-linear a·i → a·g(n). A delta reading t's STALE (previous-iteration)
; value is order-sensitive and refuses.
proc main() {
    let n = read_byte()
    let a = read_byte()
    let total = 0
    let t = 0
    let i = 0
    state loop { to body when (i < n)  to done }
    state body { t = (a * i)  total = (total + t)  i = (i + 1)  to loop }
    state done { return total }
}
