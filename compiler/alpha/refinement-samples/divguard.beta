; GUARDED variable division: if b != 0 then a/b else 0. The cond term guards the divisor; both engines fork
; at b!=0, and the differential pin's lazy cond never evaluates a/0 on the b==0 path.
proc main() {
    let a = read_byte()
    let b = read_byte()
    let r = 0
    state s0 { to dv when (b != 0)  to done }
    state dv { r = (a / b)  to done }
    state done { return r }
}
