; READ-LOOP (the stream class opens): total accumulates one read_byte() per iteration over i<n — the meaning
; is Σ input[1..1+n), the stream-sum constructor (k 8 lo hi). The read POSITION is a hidden loop variable
; (a virtual frame slot on the machine side) with delta +1, so the ordinary summarizer machinery handles the
; stream; the post-loop read is the stream ELEMENT (k 7 1+n). Like zz/monus, both are plain constructors to
; the kernel; their meaning lives in the two differentially-pinned evaluators (padded input vectors).
proc main() {
    let n = read_byte()
    let total = 0
    let i = 0
    state loop { to body when (i < n)  to done }
    state body { total = (total + read_byte())  i = (i + 1)  to loop }
    state done { return (total + read_byte()) }
}
