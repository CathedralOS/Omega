// SELF-HOSTING / CODEGEN (expression arc): constant materialization, the first
// instruction-emitting EXPRESSION primitive. loadk.alp reads a decimal integer and emits
// its ARM64 load, exactly as the backend's emit_load_reg (src/aarch64.rs): split the value
// into 16-bit halves -- low = v & 0xffff, high = (v >> 16) & 0xffff -- emit `movz w0, #low`,
// then `movk w0, #high, lsl #16` when high != 0. This is what an int-literal operand lowers
// to (lower_expression(Int v) = emit_load_w0(v) + push). Bitwise & is unavailable in .alp,
// so the halves use /,*,-: low = v - (v/65536)*65536; high = (v/65536) mod 65536.
//   printf '115'    | loadk  ->  movz w0, #115
//   printf '100000' | loadk  ->  movz w0, #34464 / movk w0, #1, lsl #16
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    c: i32; num: i32; low: i32; high: i32; q: i32; v: i32; di: i32; ek: i32;
    dig: [i32; 16];
}
machine Main::emit_int(&mut self) {     // self.v as decimal
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::emit_movz(&mut self) {     // "movz w0, #"
    write_byte(109);
    transition 0 { _ -> a() }
    state a() { write_byte(111); transition 0 { _ -> b() } }
    state b() { write_byte(118); transition 0 { _ -> c2() } }
    state c2(){ write_byte(122); transition 0 { _ -> d() } }
    state d() { write_byte(32);  transition 0 { _ -> e() } }
    state e() { write_byte(119); transition 0 { _ -> f() } }
    state f() { write_byte(48);  transition 0 { _ -> g() } }
    state g() { write_byte(44);  transition 0 { _ -> h() } }
    state h() { write_byte(32);  transition 0 { _ -> i() } }
    state i() { write_byte(35); }
}
machine Main::emit_movk(&mut self) {     // "movk w0, #"
    write_byte(109);
    transition 0 { _ -> a() }
    state a() { write_byte(111); transition 0 { _ -> b() } }
    state b() { write_byte(118); transition 0 { _ -> c2() } }
    state c2(){ write_byte(107); transition 0 { _ -> d() } }
    state d() { write_byte(32);  transition 0 { _ -> e() } }
    state e() { write_byte(119); transition 0 { _ -> f() } }
    state f() { write_byte(48);  transition 0 { _ -> g() } }
    state g() { write_byte(44);  transition 0 { _ -> h() } }
    state h() { write_byte(32);  transition 0 { _ -> i() } }
    state i() { write_byte(35); }
}
machine Main::emit_lsl(&mut self) {       // ", lsl #16"
    write_byte(44);
    transition 0 { _ -> a() }
    state a() { write_byte(32);  transition 0 { _ -> b() } }
    state b() { write_byte(108); transition 0 { _ -> c2() } }
    state c2(){ write_byte(115); transition 0 { _ -> d() } }
    state d() { write_byte(108); transition 0 { _ -> e() } }
    state e() { write_byte(32);  transition 0 { _ -> f() } }
    state f() { write_byte(35);  transition 0 { _ -> g() } }
    state g() { write_byte(49);  transition 0 { _ -> h() } }
    state h() { write_byte(54); }
}
machine Main::main(&mut self) {
    self.num = 0;
    transition 0 { _ -> rd() }
    state rd()   { self.c = read_byte(); transition self.c < 0 { true -> comp()  false -> d1() } }
    state d1()   { transition self.c < 48 { true -> rd()  false -> d2() } }
    state d2()   { transition self.c > 57 { true -> rd()  false -> acc() } }
    state acc()  { self.num = self.num * 10 + self.c - 48; transition 0 { _ -> rd() } }
    // low = v - (v/65536)*65536 ; high = (v/65536) mod 65536
    state comp() { self.q = self.num / 65536; self.low = self.num - self.q * 65536; self.high = self.q - self.q / 65536 * 65536; transition 0 { _ -> ez() } }
    state ez()   { self.emit_movz(); self.v = self.low; self.emit_int(); write_byte(10); transition self.high == 0 { true -> done()  false -> ek() } }
    state ek()   { self.emit_movk(); self.v = self.high; self.emit_int(); self.emit_lsl(); write_byte(10); transition 0 { _ -> done() } }
    state done() { self.console.exit_process(0) }
}
