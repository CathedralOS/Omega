// Slice 6: machine calls (the DAG model). Free machines with value params and a
// `return`, called in value position. Forward references are fine (the call graph
// is order-free), and a callee may have its own control flow.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_line(text: &[u8] in Utf8);
}
data Main { console: Console; }

machine max(a: i32, b: i32) -> i32 {
    transition a < b {
        true -> pick_b()
        _    -> pick_a()
    }
    state pick_a() { return a; }
    state pick_b() { return b; }
}

machine Main::main(&mut self) {
    let m: i32 = max(7, 19);   // 19
    let n: i32 = max(m, 12);   // 19
    self.console.exit_process(n)
}
