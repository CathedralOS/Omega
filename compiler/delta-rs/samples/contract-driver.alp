// RUNTIME-SOUNDNESS DRIVER for static contract discharge.
//
// Each machine below has an `ensures` contract that the compiler discharges STATICALLY (see
// contracts.sh: it proves the obligation for ALL inputs and the trust anchor checks it). The
// SAME contract is also desugared to a RUNTIME assert that traps if violated for the actual
// input. discharge-soundness.sh runs this driver across many inputs n and confirms it always
// exits 42 -- i.e. no runtime assert ever trips. That cross-checks the two contract paths: the
// static proof says "holds for all inputs", execution confirms "never traps". A discrepancy
// (statically accepted yet trapping at runtime) would expose a discharge bug.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine read_byte() -> i32;
}
data Main { console: Console; }

machine succ_gt(a: i32) -> i32 ensures result > a { return a + 1; }       // discharged: existential, const witness
machine within10(a: i32) -> i32 ensures result <= a + 10 { return a; }    // discharged: existential, non-strict
machine azr(a: i32) -> i32 ensures result == a { return a + 0; }          // discharged: lemma citation (add-zero)
machine triple(a: i32) -> i32 ensures result == a * 3 { return a * 3; }   // discharged: refl

machine Main::main(&mut self) {
    let n: i32 = read_byte();
    let g: i32 = succ_gt(n);
    let w: i32 = within10(n);
    let z: i32 = azr(n);
    let t: i32 = triple(n);
    self.console.exit_process(42)
}
