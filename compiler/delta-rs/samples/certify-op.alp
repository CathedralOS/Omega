// CERTIFYING COMPUTATION over a SUM TYPE — convergence that exercises the self-hosted compiler's
// newer machinery (enum construction + match, value-returning self-calls, reassigned locals) in the
// certified path. Reads `op a b`: op selects an operation via an `Op` enum, the program applies it,
// and EMITS A PROOF CERTIFICATE of the result that the trust anchor independently checks.
//   op 0 -> Op::Sum  : proves  a + b = s   ->  (= (p A B) S) (refl S)
//   op 1 -> Op::Prod : proves  a * b = s   ->  (= (m A B) S) (refl S)
//   printf '0 2 3' | certify-op | check.exe  ->  accept   (2 + 3 = 5)
//   printf '1 2 3' | certify-op | check.exe  ->  accept   (2 * 3 = 6)
// A wrong computation, or the wrong branch, emits a certificate proof kernel REJECTS -- the anchor checks
// the computation, not the compiler that built it (here, the self-hosted lowermachine).
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Op { case Sum; case Prod; }
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    op: i32; a: i32; b: i32; s: i32; uv: i32;
    kind: Op;
}
// emit a natural as the checker's unary literal: v copies of "(s ", then "z", then v copies of ")".
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// skip non-digits, then read one decimal number from self.buf[self.pos..], advancing self.pos.
// (value-returning self-call + a reassigned local -- both self-hosted-compiler features.)
machine Main::next_num(&mut self) -> i32 {
    let v: i32 = 0;
    transition 0 { _ -> sk() }
    state sk()   { transition self.pos < self.n { true -> sk2()  false -> done() } }
    state sk2()  { transition self.buf[self.pos] < 48 { true -> adv()  false -> sk3() } }
    state sk3()  { transition self.buf[self.pos] > 57 { true -> adv()  false -> rdn() } }   // a digit
    state adv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state rdn()  { transition self.pos < self.n { true -> rdn2()  false -> done() } }
    state rdn2() { transition self.buf[self.pos] < 48 { true -> done()  false -> rdn3() } }
    state rdn3() { transition self.buf[self.pos] > 57 { true -> done()  false -> acc() } }
    state acc()  { v = v * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> rdn() } }
    state done() { return v; }
}
machine Main::main(&mut self) {
    self.n = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; self.op = self.next_num(); self.a = self.next_num(); self.b = self.next_num(); transition 0 { _ -> selk() } }
    // construct the Op enum from the op tag, then MATCH on it to pick the operation + its proof
    state selk()  { transition self.op == 0 { true -> mksum()  false -> mkprod() } }
    state mksum() { self.kind = Op::Sum;  transition 0 { _ -> disp() } }
    state mkprod(){ self.kind = Op::Prod; transition 0 { _ -> disp() } }
    state disp()  {
        transition self.kind {
            Op::Sum  -> dosum()
            Op::Prod -> doprod()
        }
    }
    state dosum() { self.s = self.a + self.b; transition 0 { _ -> emitp() } }   // "+" is the raw `p`
    state doprod(){ self.s = self.a * self.b; transition 0 { _ -> emitm() } }   // "*" is the raw `m`
    // emit  (= (p A B) S) (refl S)
    state emitp() {
        write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32); // "(= (p "
        self.emit_nat(self.a); write_byte(32); self.emit_nat(self.b);
        write_byte(41); write_byte(32);                                                                   // ") "
        self.emit_nat(self.s);
        write_byte(41); write_byte(32); write_byte(40); write_byte(114); write_byte(101);
        write_byte(102); write_byte(108); write_byte(32);                                                 // ") (refl "
        self.emit_nat(self.s); write_byte(41);                                                            // ")"
        self.console.exit_process(0)
    }
    // emit  (= (m A B) S) (refl S)
    state emitm() {
        write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(109); write_byte(32); // "(= (m "
        self.emit_nat(self.a); write_byte(32); self.emit_nat(self.b);
        write_byte(41); write_byte(32);                                                                   // ") "
        self.emit_nat(self.s);
        write_byte(41); write_byte(32); write_byte(40); write_byte(114); write_byte(101);
        write_byte(102); write_byte(108); write_byte(32);                                                 // ") (refl "
        self.emit_nat(self.s); write_byte(41);                                                            // ")"
        self.console.exit_process(0)
    }
}
