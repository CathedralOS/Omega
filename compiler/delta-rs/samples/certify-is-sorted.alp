// CERTIFYING COMPUTATION over a VARIABLE-LENGTH input. Every prior certifier is fixed-arity (sort2 reads
// two numbers, sort3 three, palindrome three). This one reads a list of ANY length and certifies it is
// SORTED, emitting a right-nested conjunction of one adjacent-order witness per pair -- the proof's SIZE
// grows with the input, driven by a loop (the same variable-length &/pair machinery certify-accesses uses
// for an array's bounds obligations):
//   goal   (& (Exists a0<=a1) (& (Exists a1<=a2) ... (Exists a_{k-1}<=a_k)))
//   proof  (pair <a0<=a1 wit> (pair <a1<=a2 wit> ... <a_{k-1}<=a_k wit>))
// Each a_i<=a_{i+1} is the existential `∃w. a_i + w = a_{i+1}`, witness the gap a_{i+1}-a_i. The trust
// anchor checks every adjacent pair is ordered -- so the program certifies a property of an arbitrarily
// long input, the proof scaling with it. Assumes a sorted input (a descending pair gives a negative gap,
// which emit_nat cannot render -- feed only sorted lists, exactly as certify-bounds needs in-bounds input).
//   printf '1 3 3 7 9' | certify-is-sorted | check.exe  ->  accept   ([1 3 3 7 9] is sorted)
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    vals: [i32; 16]; vn: i32; cur: i32; inb: i32; uv: i32;
    k: i32; km1: i32; gi: i32; cp: i32;     // k = number of adjacent pairs = vn-1
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// the i-th adjacent-order proposition: (Exists (= (p vals[i] (v 0)) vals[i+1]))
machine Main::emit_le(&mut self, i: i32) {
    write_line("(Exists (= (p");
    self.emit_nat(self.vals[i]);
    write_line("(v 0))");
    self.emit_nat(self.vals[i + 1]);
    write_line("))");
}
// the i-th order witness: (wit (= (p vals[i] (v 0)) vals[i+1]) <gap> (refl vals[i+1]))
machine Main::emit_lewit(&mut self, i: i32) {
    write_line("(wit (= (p");
    self.emit_nat(self.vals[i]);
    write_line("(v 0))");
    self.emit_nat(self.vals[i + 1]);
    write_line(")");
    self.emit_nat(self.vals[i + 1] - self.vals[i]);
    write_line("(refl");
    self.emit_nat(self.vals[i + 1]);
    write_line("))");
}
machine Main::main(&mut self) {
    self.n = 0; self.vn = 0; self.cur = 0; self.inb = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> pp()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state pp()    { self.pos = 0; transition 0 { _ -> pscan() } }
    state pscan() { transition self.pos < self.n { true -> pc()  false -> pend() } }
    state pc()    { transition self.buf[self.pos] < 48 { true -> psep()  false -> pcHi() } }
    state pcHi()  { transition self.buf[self.pos] > 57 { true -> psep()  false -> pdig() } }
    state pdig()  { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.inb = 1; self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state psep()  { transition self.inb == 1 { true -> pstore()  false -> padv() } }
    state pstore(){ self.vals[self.vn] = self.cur; self.vn = self.vn + 1; self.cur = 0; self.inb = 0; transition 0 { _ -> padv() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state pend()  { transition self.inb == 1 { true -> pendS()  false -> comp() } }
    state pendS() { self.vals[self.vn] = self.cur; self.vn = self.vn + 1; transition 0 { _ -> comp() } }
    state comp()  { self.k = self.vn - 1; self.km1 = self.k - 1; transition 0 { _ -> goal() } }
    // goal: (& P0 (& P1 ... P_{k-1}))  -- k pairs, k-1 "(& " prefixes, k-1 closing parens
    state goal()  { self.gi = 0; transition 0 { _ -> gloop() } }
    state gloop() { transition self.gi < self.km1 { true -> gw()  false -> glast() } }
    state gw()    { write_byte(40); write_byte(38); write_byte(32); self.emit_le(self.gi); write_byte(32); self.gi = self.gi + 1; transition 0 { _ -> gloop() } }
    state glast() { self.emit_le(self.km1); transition 0 { _ -> gclose() } }
    state gclose(){ self.cp = 0; transition 0 { _ -> gcloop() } }
    state gcloop(){ transition self.cp < self.km1 { true -> gcw()  false -> gdone() } }
    state gcw()   { write_byte(41); self.cp = self.cp + 1; transition 0 { _ -> gcloop() } }
    state gdone() { write_byte(32); transition 0 { _ -> proof() } }
    // proof: (pair W0 (pair W1 ... W_{k-1}))
    state proof() { self.gi = 0; transition 0 { _ -> ploop() } }
    state ploop() { transition self.gi < self.km1 { true -> pw()  false -> plast() } }
    state pw()    { write_byte(40); write_byte(112); write_byte(97); write_byte(105); write_byte(114); write_byte(32); self.emit_lewit(self.gi); write_byte(32); self.gi = self.gi + 1; transition 0 { _ -> ploop() } }
    state plast() { self.emit_lewit(self.km1); transition 0 { _ -> pclose() } }
    state pclose(){ self.cp = 0; transition 0 { _ -> pcloop() } }
    state pcloop(){ transition self.cp < self.km1 { true -> pcw()  false -> fin() } }
    state pcw()   { write_byte(41); self.cp = self.cp + 1; transition 0 { _ -> pcloop() } }
    state fin()   { self.console.exit_process(0) }
}
