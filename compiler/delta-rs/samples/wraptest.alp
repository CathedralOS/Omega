// DOMAIN TYPES (Omega's arithmetic-safety model), first slice: `i32 in Wrapping`. delta traps on
// integer overflow by DEFAULT; a value typed `in Wrapping` wraps instead. Here a+b overflows i32
// (2e9 + 2e9 = 4e9 > 2^31-1): the default would TRAP, but the Wrapping `let` wraps to a negative value,
// so the program reaches `exit 42` (proving no trap occurred and the result wrapped).
//   wraptest  ->  exit 42   (without `in Wrapping`, the add would trap -> exit 133)
boundary trait Console {
    machine exit_process(return_code: i32);
}
data Main {
    console: Console;
    a: i32; b: i32;
}
machine Main::main(&mut self) {
    self.a = 2000000000;
    self.b = 2000000000;
    transition 0 { _ -> step() }
    state step() {
        let s: i32 in Wrapping = self.a + self.b;
        transition s < 0 { true -> ok()  false -> bad() }
    }
    state ok()  { self.console.exit_process(42) }
    state bad() { self.console.exit_process(7) }
}
