// SELF-HOSTING / CODEGEN: the first real instruction-emitting pass. branches.alp lowers
// every transition arm to its branch instruction, exactly as the backend does
// (src/aarch64.rs): an arm `_ -> s()` becomes `b Lm<mi>s<si>` (unconditional); an arm
// `true/false/N -> s()` becomes `b.eq Lm<mi>s<si>` (the conditional after the cmp). The
// new capability is TARGET RESOLUTION: the target NAME is resolved to its state-index
// label via a first pass that collects every state's (machine, index), the symbol step a
// codegen runs to turn `-> rd()` into `b Lm4s0`. Two passes (collect states, then emit),
// brace-depth-aware (depth-0 machines, depth-1 states). Each emitted line matches a real
// `b`/`b.eq Lm<mi>s<si>` line the backend produces.
//   printf 'machine M::m(){ transition 0 { _ -> a() } state a(){ transition self.x { true -> b() false -> a() } } state b(){} }' | branches
//     ->  b Lm0s0 / b.eq Lm0s1 / b.eq Lm0s0
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    n: i32; pos: i32; c: i32; start: i32; w: i32; pend: i32; phase: i32; depth: i32; mi: i32; si: i32;
    ps: i32; pe: i32; isWild: i32; cj: i32; tsi: i32; found: i32;
    v: i32; di: i32; ek: i32; qa: i32; qb: i32; qc: i32; qd: i32; qk: i32; nd: i32;
    ds: [i32; 512]; de: [i32; 512]; dm: [i32; 512]; dsi: [i32; 512];
    dig: [i32; 16];
    buf: [u8; 16384];
}
machine Main::is_word(&mut self, c: i32) -> i32 {
    transition c == 95 { true -> yes()  false -> w1() }
    state w1() { transition c < 48  { true -> no()  false -> w2() } }
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }
    state w3() { transition c < 65  { true -> no()  false -> w4() } }
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }
    state w5() { transition c < 97  { true -> no()  false -> w6() } }
    state w6() { transition c <= 122 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::is_state(&mut self, s: i32, e: i32) -> i32 {     // "state"
    transition e - s == 5 { true -> k0()  false -> kno() }
    state k0() { transition self.buf[s]     == 115 { true -> k1()  false -> kno() } }
    state k1() { transition self.buf[s + 1] == 116 { true -> k2()  false -> kno() } }
    state k2() { transition self.buf[s + 2] == 97  { true -> k3()  false -> kno() } }
    state k3() { transition self.buf[s + 3] == 116 { true -> k4()  false -> kno() } }
    state k4() { transition self.buf[s + 4] == 101 { true -> kyes() false -> kno() } }
    state kyes() { return 1; }
    state kno()  { return 0; }
}
machine Main::is_machine(&mut self, s: i32, e: i32) -> i32 {   // "machine"
    transition e - s == 7 { true -> m0()  false -> mno() }
    state m0() { transition self.buf[s]     == 109 { true -> m1()  false -> mno() } }
    state m1() { transition self.buf[s + 1] == 97  { true -> m2()  false -> mno() } }
    state m2() { transition self.buf[s + 2] == 99  { true -> m3()  false -> mno() } }
    state m3() { transition self.buf[s + 3] == 104 { true -> m4()  false -> mno() } }
    state m4() { transition self.buf[s + 4] == 105 { true -> m5()  false -> mno() } }
    state m5() { transition self.buf[s + 5] == 110 { true -> m6()  false -> mno() } }
    state m6() { transition self.buf[s + 6] == 101 { true -> myes() false -> mno() } }
    state myes() { return 1; }
    state mno()  { return 0; }
}
machine Main::streq(&mut self) -> i32 {     // buf[qa..qb) == buf[qc..qd)
    transition self.qb - self.qa == self.qd - self.qc { true -> q0()  false -> qno() }
    state q0()  { self.qk = 0; transition 0 { _ -> ql() } }
    state ql()  { transition self.qa + self.qk < self.qb { true -> qc2()  false -> qyes() } }
    state qc2() { transition self.buf[self.qa + self.qk] == self.buf[self.qc + self.qk] { true -> qa2()  false -> qno() } }
    state qa2() { self.qk = self.qk + 1; transition 0 { _ -> ql() } }
    state qyes(){ return 1; }
    state qno() { return 0; }
}
machine Main::emit_int(&mut self) {     // self.v as decimal
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::main(&mut self) {
    self.n = 0; self.pend = 0; self.phase = 1; self.depth = 0; self.mi = 0 - 1; self.si = 0; self.nd = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { transition self.n < 16384 { true -> store2()  false -> rd() } }
    state store2(){ self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state scan()  { self.pos = 0; transition 0 { _ -> sk() } }
    // ---- shared scanner: skip ws/comments/strings, yield words & puncts ----
    state sk()    { transition self.pos < self.n { true -> ws()  false -> endph() } }
    state ws()    { transition self.buf[self.pos] <= 32 { true -> wadv()  false -> cm() } }
    state wadv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state cm()    { transition self.buf[self.pos] == 47 { true -> cm2()  false -> str0() } }
    state cm2()   { transition self.buf[self.pos + 1] == 47 { true -> cms()  false -> str0() } }
    state cms()   { transition self.pos < self.n { true -> cnl()  false -> endph() } }
    state cnl()   { transition self.buf[self.pos] == 10 { true -> wadv()  false -> cadv() } }
    state cadv()  { self.pos = self.pos + 1; transition 0 { _ -> cms() } }
    state str0()  { transition self.buf[self.pos] == 34 { true -> stra()  false -> tok() } }
    state stra()  { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    state ss()    { transition self.pos < self.n { true -> ss2()  false -> endph() } }
    state ss2()   { transition self.buf[self.pos] == 34 { true -> wadv()  false -> ssa() } }
    state ssa()   { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    state tok()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word()  false -> punc() } }
    state word()  { self.start = self.pos; transition 0 { _ -> wrun() } }
    state wrun()  { transition self.pos < self.n { true -> wrck()  false -> wcl() } }
    state wrck()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wra()  false -> wcl() } }
    state wra()   { self.pos = self.pos + 1; transition 0 { _ -> wrun() } }
    // word classify: prevWord, then pending (state-name P1 / target P2), then keywords
    state wcl()   { self.ps = self.start; self.pe = self.pos; transition self.pend == 1 { true -> colS()  false -> wcl2() } }
    state colS()  { self.ds[self.nd] = self.start; self.de[self.nd] = self.pos; self.dm[self.nd] = self.mi; self.dsi[self.nd] = self.si; self.nd = self.nd + 1; self.si = self.si + 1; self.pend = 0; transition 0 { _ -> sk() } }
    state wcl2()  { transition self.pend == 2 { true -> tg()  false -> wcl3() } }
    state tg()    { self.pend = 0; transition self.buf[self.pos] == 40 { true -> rslv()  false -> sk() } }   // a target is followed by '('
    state wcl3()  { self.w = self.is_machine(self.start, self.pos); transition self.w == 1 { true -> ckMd()  false -> wcl4() } }
    state ckMd()  { transition self.depth == 0 { true -> newM()  false -> sk() } }
    state newM()  { self.mi = self.mi + 1; self.si = 0; transition 0 { _ -> sk() } }
    state wcl4()  { transition self.phase == 1 { true -> ckSt()  false -> sk() } }
    state ckSt()  { self.w = self.is_state(self.start, self.pos); transition self.w == 1 { true -> ckSd()  false -> sk() } }
    state ckSd()  { transition self.depth == 1 { true -> setP()  false -> sk() } }
    state setP()  { self.pend = 1; transition 0 { _ -> sk() } }
    // resolve target buf[start..pos) -> state index, then emit the branch
    state rslv()  { self.cj = 0; self.found = 0; self.qa = self.start; self.qb = self.pos; transition 0 { _ -> rl() } }
    state rl()    { transition self.cj < self.nd { true -> rck()  false -> emit() } }
    state rck()   { transition self.dm[self.cj] == self.mi { true -> req()  false -> rnext() } }
    state req()   { self.qc = self.ds[self.cj]; self.qd = self.de[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> rhit()  false -> rnext() } }
    state rhit()  { self.tsi = self.dsi[self.cj]; self.found = 1; transition 0 { _ -> emit() } }
    state rnext() { self.cj = self.cj + 1; transition 0 { _ -> rl() } }
    state emit()  { transition self.found == 1 { true -> ekind()  false -> sk() } }
    state ekind() { transition self.isWild == 1 { true -> eb()  false -> ebeq() } }
    state eb()    { write_byte(98); write_byte(32); transition 0 { _ -> elab() } }                 // "b "
    state ebeq()  { write_byte(98); write_byte(46); write_byte(101); write_byte(113); write_byte(32); transition 0 { _ -> elab() } } // "b.eq "
    state elab()  { write_byte(76); write_byte(109); self.v = self.mi; self.emit_int(); write_byte(115); self.v = self.tsi; self.emit_int(); write_byte(10); transition 0 { _ -> sk() } } // Lm<mi>s<tsi>
    // punctuation: brace depth, and (phase 2) the `->` arrow opening a target
    state punc()  { transition self.buf[self.pos] == 123 { true -> opn()  false -> pcl() } }   // '{'
    state opn()   { self.depth = self.depth + 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state pcl()   { transition self.buf[self.pos] == 125 { true -> cls()  false -> arr0() } }  // '}'
    state cls()   { self.depth = self.depth - 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state arr0()  { transition self.buf[self.pos] == 45 { true -> arr1()  false -> padv() } }  // '-'
    state arr1()  { transition self.buf[self.pos + 1] == 62 { true -> arrow()  false -> padv() } } // '>'
    state arrow() { transition self.phase == 2 { true -> aw()  false -> askip() } }
    state aw()    { self.pend = 2; transition self.pe - self.ps == 1 { true -> awc()  false -> anw() } }   // pattern = prevWord; wild iff it is "_"
    state awc()   { transition self.buf[self.ps] == 95 { true -> awy()  false -> anw() } }
    state awy()   { self.isWild = 1; self.pos = self.pos + 2; transition 0 { _ -> sk() } }
    state anw()   { self.isWild = 0; self.pos = self.pos + 2; transition 0 { _ -> sk() } }
    state askip() { self.pos = self.pos + 2; transition 0 { _ -> sk() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    // end of a pass
    state endph() { transition self.phase == 1 { true -> p2()  false -> ok() } }
    state p2()    { self.phase = 2; self.pos = 0; self.mi = 0 - 1; self.depth = 0; self.pend = 0; transition 0 { _ -> sk() } }
    state ok()    { self.console.exit_process(0) }
}
