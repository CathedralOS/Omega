// Slice 9: &mut self method calls on data. A tiny stack lives in self; push/pop
// are methods that mutate the shared self instance (the self-pointer is passed in
// rcx, so every method sees the same data). main pushes 3,5,7 then pops twice.
//   7*10 + 5 = 75
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_line(text: &[u8] in Utf8);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    items: [i32; 16];
    top: i32;
}

machine Main::push(&mut self, v: i32) {
    self.items[self.top] = v;
    self.top = self.top + 1;
}
machine Main::pop(&mut self) -> i32 {
    self.top = self.top - 1;
    return self.items[self.top];
}

machine Main::main(&mut self) {
    self.top = 0;
    self.push(3);
    self.push(5);
    self.push(7);
    let a: i32 = self.pop(); // 7
    let b: i32 = self.pop(); // 5
    self.console.exit_process(a * 10 + b)
}
