// SELF-HOSTING / CODEGEN (expression arc): lower a real TRANSITION SUBJECT end-to-end --
// the orchestrator now resolves self.field OPERANDS, not just literals. It reads a .alp
// file, builds a field->offset table from the `data` struct, finds the first transition's
// subject expression, linearizes it (shunting-yard), and emits each RPN token's ARM64:
//   int literal -> movz/movk + push (loadk)
//   self.field  -> ldr x9,[x29,#16]; ldr w0,[x9,#offset]; push  (fieldload; offset from the table)
//   operator    -> pop/op/push snippet (lowerop)
// Scope: a SCALAR-only data struct (each field 8 bytes, so field N is at offset 8*N -- the
// general Console=0/[u8;N] layout is fieldload's job and plugs into the same table); the
// subject uses literals, self.field, and binary operators (array-index subjects deferred).
//   data Main{ a:i32; b:i32; } ... transition self.b < 5 ...  -> load self.b@8, load 5, cmp/cset lt
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    n: i32; pos: i32; c: i32; start: i32; w: i32; pend: i32; inData: i32; sub: i32;
    num: i32; q: i32; low: i32; high: i32; v: i32; di: i32; ek: i32;
    nf: i32; foffc: i32; cj: i32; fs: i32; fe: i32; curp: i32; curl: i32; sp: i32;
    ostart: [i32; 128]; oend: [i32; 128]; oprec: [i32; 128];
    fns: [i32; 128]; fne: [i32; 128]; foff: [i32; 128];
    qa: i32; qb: i32; qc: i32; qd: i32; qk: i32;
    dig: [i32; 16];
    buf: [u8; 16384];
}
machine Main::is_word(&mut self, c: i32) -> i32 {       // identifier char: _, 0-9, A-Z, a-z
    transition c == 95 { true -> yes()  false -> w1() }
    state w1() { transition c < 48  { true -> no()  false -> w2() } }
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }
    state w3() { transition c < 65  { true -> no()  false -> w4() } }
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }
    state w5() { transition c < 97  { true -> no()  false -> w6() } }
    state w6() { transition c <= 122 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::is_dig(&mut self, c: i32) -> i32 {        // 0-9 (an int literal)
    transition c < 48 { true -> no()  false -> d2() }
    state d2() { transition c <= 57 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::is_data(&mut self, s: i32, e: i32) -> i32 {     // "data"
    transition e - s == 4 { true -> d0()  false -> dno() }
    state d0() { transition self.buf[s]     == 100 { true -> d1()  false -> dno() } }
    state d1() { transition self.buf[s + 1] == 97  { true -> d2()  false -> dno() } }
    state d2() { transition self.buf[s + 2] == 116 { true -> d3()  false -> dno() } }
    state d3() { transition self.buf[s + 3] == 97  { true -> dyes() false -> dno() } }
    state dyes() { return 1; }
    state dno()  { return 0; }
}
machine Main::is_trans(&mut self, s: i32, e: i32) -> i32 {    // "transition"
    transition e - s == 10 { true -> t0()  false -> tno() }
    state t0() { transition self.buf[s]     == 116 { true -> t1()  false -> tno() } }
    state t1() { transition self.buf[s + 1] == 114 { true -> t2()  false -> tno() } }
    state t2() { transition self.buf[s + 2] == 97  { true -> t3()  false -> tno() } }
    state t3() { transition self.buf[s + 3] == 110 { true -> t4()  false -> tno() } }
    state t4() { transition self.buf[s + 4] == 115 { true -> t5()  false -> tno() } }
    state t5() { transition self.buf[s + 5] == 105 { true -> t6()  false -> tno() } }
    state t6() { transition self.buf[s + 6] == 116 { true -> t7()  false -> tno() } }
    state t7() { transition self.buf[s + 7] == 105 { true -> t8()  false -> tno() } }
    state t8() { transition self.buf[s + 8] == 111 { true -> t9()  false -> tno() } }
    state t9() { transition self.buf[s + 9] == 110 { true -> tyes() false -> tno() } }
    state tyes() { return 1; }
    state tno()  { return 0; }
}
machine Main::is_self(&mut self, s: i32, e: i32) -> i32 {     // "self." prefix (>=5 chars, self + '.')
    transition e - s < 5 { true -> sno() false -> s0() }
    state s0() { transition self.buf[s]     == 115 { true -> s1()  false -> sno() } }
    state s1() { transition self.buf[s + 1] == 101 { true -> s2()  false -> sno() } }
    state s2() { transition self.buf[s + 2] == 108 { true -> s3()  false -> sno() } }
    state s3() { transition self.buf[s + 3] == 102 { true -> s4()  false -> sno() } }
    state s4() { transition self.buf[s + 4] == 46  { true -> syes() false -> sno() } }
    state syes() { return 1; }
    state sno()  { return 0; }
}
machine Main::streq(&mut self) -> i32 {     // buf[qa..qb) == buf[qc..qd)
    transition self.qb - self.qa == self.qd - self.qc { true -> q0()  false -> qno() }
    state q0()  { self.qk = 0; transition 0 { _ -> ql() } }
    state ql()  { transition self.qa + self.qk < self.qb { true -> qc2()  false -> qyes() } }
    state qc2() { transition self.buf[self.qa + self.qk] == self.buf[self.qc + self.qk] { true -> qa2()  false -> qno() } }
    state qa2() { self.qk = self.qk + 1; transition 0 { _ -> ql() } }
    state qyes(){ return 1; }
    state qno() { return 0; }
}
machine Main::emit_int(&mut self) {     // self.v as decimal
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::emit_movz(&mut self) {     // "    movz w0, #"
    write_byte(32);  transition 0 { _ -> b1() }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(32);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(109); transition 0 { _ -> b5() } }
    state b5(){ write_byte(111); transition 0 { _ -> b6() } }
    state b6(){ write_byte(118); transition 0 { _ -> b7() } }
    state b7(){ write_byte(122); transition 0 { _ -> b8() } }
    state b8(){ write_byte(32);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(119); transition 0 { _ -> ba() } }
    state ba(){ write_byte(48);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(44);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(32);  transition 0 { _ -> bd() } }
    state bd(){ write_byte(35); }
}
machine Main::emit_movk(&mut self) {     // "    movk w0, #"
    write_byte(32);  transition 0 { _ -> b1() }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(32);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(109); transition 0 { _ -> b5() } }
    state b5(){ write_byte(111); transition 0 { _ -> b6() } }
    state b6(){ write_byte(118); transition 0 { _ -> b7() } }
    state b7(){ write_byte(107); transition 0 { _ -> b8() } }
    state b8(){ write_byte(32);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(119); transition 0 { _ -> ba() } }
    state ba(){ write_byte(48);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(44);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(32);  transition 0 { _ -> bd() } }
    state bd(){ write_byte(35); }
}
machine Main::emit_lsl(&mut self) {       // ", lsl #16"
    write_byte(44);  transition 0 { _ -> b1() }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(108); transition 0 { _ -> b3() } }
    state b3(){ write_byte(115); transition 0 { _ -> b4() } }
    state b4(){ write_byte(108); transition 0 { _ -> b5() } }
    state b5(){ write_byte(32);  transition 0 { _ -> b6() } }
    state b6(){ write_byte(35);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(49);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(54); }
}
machine Main::emit_ldrw0(&mut self) {     // "    ldr w0, [x9, #"
    write_byte(32);  transition 0 { _ -> b1() }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(32);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(108); transition 0 { _ -> b5() } }
    state b5(){ write_byte(100); transition 0 { _ -> b6() } }
    state b6(){ write_byte(114); transition 0 { _ -> b7() } }
    state b7(){ write_byte(32);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(119); transition 0 { _ -> b9() } }
    state b9(){ write_byte(48);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(44);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(32);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(91);  transition 0 { _ -> bd() } }
    state bd(){ write_byte(120); transition 0 { _ -> be() } }
    state be(){ write_byte(57);  transition 0 { _ -> bf() } }
    state bf(){ write_byte(44);  transition 0 { _ -> bg() } }
    state bg(){ write_byte(32);  transition 0 { _ -> bh() } }
    state bh(){ write_byte(35); }
}
machine Main::push(&mut self) { self.console.write_line("    str x0, [sp, #-16]!") }
machine Main::pops(&mut self) {
    self.console.write_line("    ldr x1, [sp], #16");
    self.console.write_line("    ldr x0, [sp], #16")
}
// int literal operand: movz/movk then push
machine Main::emit_lit(&mut self, s: i32, e: i32) {
    self.num = 0; self.pos = s;
    transition 0 { _ -> ai() }
    state ai()  { transition self.pos < e { true -> ac()  false -> mt() } }
    state ac()  { self.num = self.num * 10 + self.buf[self.pos] - 48; self.pos = self.pos + 1; transition 0 { _ -> ai() } }
    state mt()  { self.q = self.num / 65536; self.low = self.num - self.q * 65536; self.high = self.q - self.q / 65536 * 65536; transition 0 { _ -> ez() } }
    state ez()  { self.emit_movz(); self.v = self.low; self.emit_int(); write_byte(10); transition self.high == 0 { true -> pu()  false -> ek() } }
    state ek()  { self.emit_movk(); self.v = self.high; self.emit_int(); self.emit_lsl(); write_byte(10); transition 0 { _ -> pu() } }
    state pu()  { self.push() }
}
// self.field operand: ldr x9,[x29,#16]; ldr w0,[x9,#offset]; push   (offset in self.foffc)
machine Main::emit_field(&mut self) {
    self.console.write_line("    ldr x9, [x29, #16]");
    self.emit_ldrw0(); self.v = self.foffc; self.emit_int(); write_byte(93); write_byte(10);
    self.push()
}
// binary operator snippet (the op char at buf[s])
machine Main::emit_op(&mut self, s: i32) {
    transition self.buf[s] == 42 { true -> mul()  false -> o1() }
    state o1()  { transition self.buf[s] == 47 { true -> divi()  false -> o2() } }
    state o2()  { transition self.buf[s] == 43 { true -> add()  false -> o3() } }
    state o3()  { transition self.buf[s] == 45 { true -> sub()  false -> o4() } }
    state o4()  { transition self.buf[s] == 60 { true -> lt2()  false -> o5() } }
    state o5()  { transition self.buf[s] == 62 { true -> gt2()  false -> o6() } }
    state o6()  { transition self.buf[s] == 61 { true -> eq()  false -> o7() } }
    state o7()  { transition self.buf[s] == 33 { true -> ne()  false -> ret() } }
    state lt2() { transition self.buf[s + 1] == 61 { true -> le()  false -> lt() } }
    state gt2() { transition self.buf[s + 1] == 61 { true -> ge()  false -> gt() } }
    state add() { self.pops(); self.console.write_line("    adds w0, w0, w1"); self.console.write_line("    b.vs Ltrap"); self.push(); transition 0 { _ -> ret() } }
    state sub() { self.pops(); self.console.write_line("    subs w0, w0, w1"); self.console.write_line("    b.vs Ltrap"); self.push(); transition 0 { _ -> ret() } }
    state mul() { self.pops(); self.console.write_line("    smull x0, w0, w1"); self.console.write_line("    sxtw x2, w0"); self.console.write_line("    cmp x0, x2"); self.console.write_line("    b.ne Ltrap"); self.push(); transition 0 { _ -> ret() } }
    state divi(){ self.pops(); self.console.write_line("    cbz w1, Ltrap"); self.console.write_line("    sdiv w0, w0, w1"); self.push(); transition 0 { _ -> ret() } }
    state lt()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, lt"); self.push(); transition 0 { _ -> ret() } }
    state le()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, le"); self.push(); transition 0 { _ -> ret() } }
    state gt()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, gt"); self.push(); transition 0 { _ -> ret() } }
    state ge()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, ge"); self.push(); transition 0 { _ -> ret() } }
    state eq()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, eq"); self.push(); transition 0 { _ -> ret() } }
    state ne()  { self.pops(); self.console.write_line("    cmp w0, w1"); self.console.write_line("    cset w0, ne"); self.push(); transition 0 { _ -> ret() } }
    state ret() { }
}
machine Main::main(&mut self) {
    self.n = 0; self.nf = 0; self.foffc = 0; self.inData = 0; self.pend = 0; self.sub = 0; self.sp = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { transition self.n < 16384 { true -> store2()  false -> rd() } }
    state store2(){ self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state scan()  { self.pos = 0; transition 0 { _ -> sk() } }
    state sk()    { transition self.pos < self.n { true -> ws()  false -> done() } }
    state ws()    { transition self.buf[self.pos] <= 32 { true -> wadv()  false -> cm() } }
    state wadv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state cm()    { transition self.buf[self.pos] == 47 { true -> cm2()  false -> str0() } }
    state cm2()   { transition self.buf[self.pos + 1] == 47 { true -> cms()  false -> str0() } }
    state cms()   { transition self.pos < self.n { true -> cnl()  false -> done() } }
    state cnl()   { transition self.buf[self.pos] == 10 { true -> wadv()  false -> cadv() } }
    state cadv()  { self.pos = self.pos + 1; transition 0 { _ -> cms() } }
    state str0()  { transition self.buf[self.pos] == 34 { true -> stra()  false -> disp() } }
    state stra()  { self.pos = self.pos + 1; transition 0 { _ -> ssx() } }
    state ssx()   { transition self.pos < self.n { true -> ss2()  false -> done() } }
    state ss2()   { transition self.buf[self.pos] == 34 { true -> wadv()  false -> ssa() } }
    state ssa()   { self.pos = self.pos + 1; transition 0 { _ -> ssx() } }
    state disp()  { transition self.sub == 1 { true -> subj()  false -> nrm() } }
    state nrm()   { transition self.inData == 1 { true -> fld()  false -> top() } }
    // ---- top level: enter `data {`, then hunt `transition` to start the subject ----
    state top()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> tw()  false -> tpunc() } }
    state tpunc() { transition self.buf[self.pos] == 123 { true -> obrace()  false -> tpadv() } }
    state obrace(){ transition self.pend == 3 { true -> entD()  false -> tpadv() } }
    state entD()  { self.inData = 1; self.pend = 0; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state tpadv() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state tw()    { self.start = self.pos; transition 0 { _ -> twr() } }
    state twr()   { transition self.pos < self.n { true -> twc()  false -> done() } }
    state twc()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> twa()  false -> tcl() } }
    state twa()   { self.pos = self.pos + 1; transition 0 { _ -> twr() } }
    state tcl()   { transition self.pend == 2 { true -> setDN()  false -> tcl2() } }
    state setDN() { self.pend = 3; transition 0 { _ -> sk() } }
    state tcl2()  { self.w = self.is_data(self.start, self.pos); transition self.w == 1 { true -> sawDa()  false -> tcl3() } }
    state sawDa() { self.pend = 2; transition 0 { _ -> sk() } }
    state tcl3()  { self.w = self.is_trans(self.start, self.pos); transition self.w == 1 { true -> startS()  false -> sk() } }   // first `transition` -> lower its subject
    state startS(){ self.sub = 1; self.sp = 0; transition 0 { _ -> sk() } }
    // ---- data body: each `field : type ;` -> record (name, 8*index) ----
    state fld()   { transition self.buf[self.pos] == 125 { true -> endD()  false -> fn0() } }
    state endD()  { self.inData = 0; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state fn0()   { self.fs = self.pos; transition 0 { _ -> fnr() } }
    state fnr()   { transition self.pos < self.n { true -> fnc()  false -> done() } }
    state fnc()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> fna()  false -> fne2() } }
    state fna()   { self.pos = self.pos + 1; transition 0 { _ -> fnr() } }
    state fne2()  { self.fe = self.pos; transition 0 { _ -> isCon() } }
    // a Console (boundary) field is 0 bytes and not addressable as a scalar -- record it with
    // its current offset but DON'T advance (only scalars advance 8). Heuristic: a field whose
    // type is not present here is scalar; the lone boundary field is `console:` -- detect by
    // the type token, but for the scalar-only scope we just treat every field as 8 bytes EXCEPT
    // we special-case `console` so real structs (console first) still line up.
    state isCon() { self.qa = self.fs; self.qb = self.fe; self.qc = 900; self.qd = 907; self.w = self.streqlit(); transition self.w == 1 { true -> recC()  false -> recS() } }
    state recC()  { self.fns[self.nf] = self.fs; self.fne[self.nf] = self.fe; self.foff[self.nf] = self.foffc; self.nf = self.nf + 1; transition 0 { _ -> semi() } } // console: 0 bytes, no advance
    state recS()  { self.fns[self.nf] = self.fs; self.fne[self.nf] = self.fe; self.foff[self.nf] = self.foffc; self.nf = self.nf + 1; self.foffc = self.foffc + 8; transition 0 { _ -> semi() } }
    state semi()  { transition self.buf[self.pos] == 59 { true -> semia()  false -> semiB() } }
    state semiB() { transition self.buf[self.pos] == 125 { true -> endD()  false -> semsk() } }
    state semsk() { self.pos = self.pos + 1; transition 0 { _ -> semi() } }
    state semia() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    // ---- subject lowering: shunting-yard until '{', operands literal | self.field ----
    state subj()  { transition self.buf[self.pos] == 123 { true -> flush()  false -> sj2() } }   // '{' ends the subject
    state sj2()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> atom()  false -> op() } }
    state atom()  { self.start = self.pos; transition 0 { _ -> arun() } }
    state arun()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> aadv()  false -> adot() } }
    state aadv()  { self.pos = self.pos + 1; transition 0 { _ -> arun() } }
    state adot()  { transition self.buf[self.pos] == 46 { true -> aext()  false -> aem() } }       // '.' -> self.field
    state aext()  { self.pos = self.pos + 1; transition 0 { _ -> arn2() } }
    state arn2()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> aad2()  false -> aem() } }
    state aad2()  { self.pos = self.pos + 1; transition 0 { _ -> arn2() } }
    state aem()   { self.w = self.is_self(self.start, self.pos); transition self.w == 1 { true -> fldop()  false -> litop() } }
    state litop() { self.emit_lit(self.start, self.pos); transition 0 { _ -> subj() } }            // int literal
    state fldop() { self.qa = self.start + 5; self.qb = self.pos; self.cj = 0; transition 0 { _ -> fl() } }  // field name = after "self."
    state fl()    { transition self.cj < self.nf { true -> flc()  false -> subj() } }
    state flc()   { self.qc = self.fns[self.cj]; self.qd = self.fne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> flhit()  false -> fln() } }
    state flhit() { self.foffc = self.foff[self.cj]; self.emit_field(); transition 0 { _ -> subj() } }
    state fln()   { self.cj = self.cj + 1; transition 0 { _ -> fl() } }
    state op()    { transition self.buf[self.pos] == 42 { true -> p3()  false -> opc() } }
    state opc()   { transition self.buf[self.pos] == 47 { true -> p3()  false -> opd() } }
    state opd()   { transition self.buf[self.pos] == 43 { true -> p2()  false -> ope() } }
    state ope()   { transition self.buf[self.pos] == 45 { true -> p2()  false -> opf() } }
    state opf()   { transition self.buf[self.pos] == 60 { true -> p1m()  false -> opg() } }
    state opg()   { transition self.buf[self.pos] == 62 { true -> p1m()  false -> oph() } }
    state oph()   { transition self.buf[self.pos] == 61 { true -> p1t()  false -> opi() } }
    state opi()   { transition self.buf[self.pos] == 33 { true -> p1t()  false -> spadv() } }
    state p3()    { self.curp = 3; self.curl = 1; transition 0 { _ -> syp() } }
    state p2()    { self.curp = 2; self.curl = 1; transition 0 { _ -> syp() } }
    state p1m()   { self.curp = 1; transition self.buf[self.pos + 1] == 61 { true -> p1l2()  false -> p1l1() } }
    state p1l2()  { self.curl = 2; transition 0 { _ -> syp() } }
    state p1l1()  { self.curl = 1; transition 0 { _ -> syp() } }
    state p1t()   { self.curp = 1; self.curl = 2; transition 0 { _ -> syp() } }
    state spadv() { self.pos = self.pos + 1; transition 0 { _ -> subj() } }
    state syp()   { transition self.sp > 0 { true -> syp2()  false -> opush() } }
    state syp2()  { transition self.oprec[self.sp - 1] < self.curp { true -> opush()  false -> syem() } }
    state syem()  { self.emit_op(self.ostart[self.sp - 1]); self.sp = self.sp - 1; transition 0 { _ -> syp() } }
    state opush() { self.ostart[self.sp] = self.pos; self.oend[self.sp] = self.pos + self.curl; self.oprec[self.sp] = self.curp; self.sp = self.sp + 1; self.pos = self.pos + self.curl; transition 0 { _ -> subj() } }
    state flush() { transition self.sp > 0 { true -> flem()  false -> done() } }
    state flem()  { self.emit_op(self.ostart[self.sp - 1]); self.sp = self.sp - 1; transition 0 { _ -> flush() } }
    state done()  { self.console.exit_process(0) }
}
machine Main::streqlit(&mut self) -> i32 {     // buf[qa..qb) == the literal "console" (stored at a fixed scratch -- see note)
    transition self.qb - self.qa == 7 { true -> k0()  false -> kno() }
    state k0() { transition self.buf[self.qa]     == 99  { true -> k1()  false -> kno() } }  // c
    state k1() { transition self.buf[self.qa + 1] == 111 { true -> k2()  false -> kno() } }  // o
    state k2() { transition self.buf[self.qa + 2] == 110 { true -> k3()  false -> kno() } }  // n
    state k3() { transition self.buf[self.qa + 3] == 115 { true -> k4()  false -> kno() } }  // s
    state k4() { transition self.buf[self.qa + 4] == 111 { true -> k5()  false -> kno() } }  // o
    state k5() { transition self.buf[self.qa + 5] == 108 { true -> k6()  false -> kno() } }  // l
    state k6() { transition self.buf[self.qa + 6] == 101 { true -> kyes() false -> kno() } } // e
    state kyes() { return 1; }
    state kno()  { return 0; }
}
