// SELF-HOSTING / CODEGEN (expression arc): the array-index operand emit (SelfIndex), the
// last operand kind. Given an array field's `offset count element_bytes`, arrindex.alp emits
// the ARM64 that loads self.arr[index] -- with the index already on the stack (the prior RPN
// token) -- exactly as the backend's emit_self_element_address + load + push (src/aarch64.rs):
//     ldr x0, [sp], #16            pop index
//     movz w1, #count [movk ...]   the bound
//     cmp w0, w1 / b.hs Ltrap      runtime bounds check (mirror of the delta array-bounds VC)
//     uxtw x0, w0                  zero-extend the validated index
//     ldr x9, [x29, #16]           self pointer (self_disp 16, local-free machine)
//     add x9, x9, #offset          field offset (hi/lo split if >= 4096)
//     add x9, x9, x0[, lsl #3]     + index*element_bytes (shift 3 for 8-byte, 0 for u8)
//     ldrb|ldr w0, [x9]            load (ldrb for u8)
//     str x0, [sp, #-16]!          push
//   printf '0 16 1'      | arrindex   ->  u8 array at offset 0, count 16
//   printf '12432 16384 1'| arrindex  ->  large offset (hi/lo split) -- statecheck's buf
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    c: i32; ni: i32; cur: i32; inn: i32;
    off: i32; cnt: i32; eb: i32;
    v: i32; q: i32; low: i32; high: i32; di: i32; ek: i32;
    nums: [i32; 4]; dig: [i32; 16];
}
machine Main::emit_int(&mut self) {     // self.v as decimal
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::p_movw1(&mut self) {       // "    movz w1, #"
    write_byte(32);  transition 0 { _ -> b1() }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(32);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(109); transition 0 { _ -> b5() } }
    state b5(){ write_byte(111); transition 0 { _ -> b6() } }
    state b6(){ write_byte(118); transition 0 { _ -> b7() } }
    state b7(){ write_byte(122); transition 0 { _ -> b8() } }
    state b8(){ write_byte(32);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(119); transition 0 { _ -> ba() } }
    state ba(){ write_byte(49);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(44);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(32);  transition 0 { _ -> bd() } }
    state bd(){ write_byte(35); }
}
machine Main::p_movkw1(&mut self) {      // "    movk w1, #"
    write_byte(32);  transition 0 { _ -> b1() }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(32);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(109); transition 0 { _ -> b5() } }
    state b5(){ write_byte(111); transition 0 { _ -> b6() } }
    state b6(){ write_byte(118); transition 0 { _ -> b7() } }
    state b7(){ write_byte(107); transition 0 { _ -> b8() } }
    state b8(){ write_byte(32);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(119); transition 0 { _ -> ba() } }
    state ba(){ write_byte(49);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(44);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(32);  transition 0 { _ -> bd() } }
    state bd(){ write_byte(35); }
}
machine Main::p_addx9(&mut self) {       // "    add x9, x9, #"  (4 leading spaces)
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(97);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(100); transition 0 { _ -> b5() } }
    state b5(){ write_byte(100); transition 0 { _ -> b6() } }
    state b6(){ write_byte(32);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(120); transition 0 { _ -> b8() } }
    state b8(){ write_byte(57);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(44);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(32);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(120); transition 0 { _ -> bc() } }
    state bc(){ write_byte(57);  transition 0 { _ -> bd() } }
    state bd(){ write_byte(44);  transition 0 { _ -> be() } }
    state be(){ write_byte(32);  transition 0 { _ -> bf() } }
    state bf(){ write_byte(35); }
}
machine Main::s_lsl16(&mut self) {       // ", lsl #16"
    write_byte(44);  transition 0 { _ -> b1() }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(108); transition 0 { _ -> b3() } }
    state b3(){ write_byte(115); transition 0 { _ -> b4() } }
    state b4(){ write_byte(108); transition 0 { _ -> b5() } }
    state b5(){ write_byte(32);  transition 0 { _ -> b6() } }
    state b6(){ write_byte(35);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(49);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(54); }
}
machine Main::s_lsl12(&mut self) {       // ", lsl #12"
    write_byte(44);  transition 0 { _ -> b1() }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(108); transition 0 { _ -> b3() } }
    state b3(){ write_byte(115); transition 0 { _ -> b4() } }
    state b4(){ write_byte(108); transition 0 { _ -> b5() } }
    state b5(){ write_byte(32);  transition 0 { _ -> b6() } }
    state b6(){ write_byte(35);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(49);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(50); }
}
machine Main::main(&mut self) {
    self.ni = 0; self.cur = 0; self.inn = 0;
    transition 0 { _ -> rd() }
    state rd()   { self.c = read_byte(); transition self.c < 0 { true -> fin()  false -> dg() } }
    state dg()   { transition self.c < 48 { true -> sep()  false -> dg2() } }
    state dg2()  { transition self.c > 57 { true -> sep()  false -> acc() } }
    state acc()  { self.cur = self.cur * 10 + self.c - 48; self.inn = 1; transition 0 { _ -> rd() } }
    state sep()  { transition self.inn == 1 { true -> stor()  false -> rd() } }
    state stor() { self.nums[self.ni] = self.cur; self.ni = self.ni + 1; self.cur = 0; self.inn = 0; transition 0 { _ -> rd() } }
    state fin()  { transition self.inn == 1 { true -> finS()  false -> go() } }
    state finS() { self.nums[self.ni] = self.cur; self.ni = self.ni + 1; transition 0 { _ -> go() } }
    state go()   { self.off = self.nums[0]; self.cnt = self.nums[1]; self.eb = self.nums[2]; transition 0 { _ -> e1() } }
    // ---- emit the SelfIndex sequence ----
    state e1()   { self.console.write_line("    ldr x0, [sp], #16"); transition 0 { _ -> e2() } }
    state e2()   { self.q = self.cnt / 65536; self.low = self.cnt - self.q * 65536; self.high = self.q - self.q / 65536 * 65536; self.p_movw1(); self.v = self.low; self.emit_int(); write_byte(10); transition self.high == 0 { true -> e4()  false -> e3() } }
    state e3()   { self.p_movkw1(); self.v = self.high; self.emit_int(); self.s_lsl16(); write_byte(10); transition 0 { _ -> e4() } }
    state e4()   { self.console.write_line("    cmp w0, w1"); self.console.write_line("    b.hs Ltrap"); self.console.write_line("    uxtw x0, w0"); self.console.write_line("    ldr x9, [x29, #16]"); transition self.off == 0 { true -> idx()  false -> eoff() } }
    state eoff() { transition self.off < 4096 { true -> osmall()  false -> obig() } }
    state osmall(){ self.p_addx9(); self.v = self.off; self.emit_int(); write_byte(10); transition 0 { _ -> idx() } }
    state obig()  { self.p_addx9(); self.v = self.off / 4096; self.emit_int(); self.s_lsl12(); write_byte(10); self.low = self.off - self.off / 4096 * 4096; transition self.low == 0 { true -> idx()  false -> olo() } }
    state olo()   { self.p_addx9(); self.v = self.low; self.emit_int(); write_byte(10); transition 0 { _ -> idx() } }
    // index add: shift 3 for 8-byte elements, 0 for u8
    state idx()   { transition self.eb == 1 { true -> ix0()  false -> ix3() } }
    state ix0()   { self.console.write_line("    add x9, x9, x0"); transition 0 { _ -> ld() } }
    state ix3()   { self.console.write_line("    add x9, x9, x0, lsl #3"); transition 0 { _ -> ld() } }
    state ld()    { transition self.eb == 1 { true -> ldb()  false -> ldw() } }
    state ldb()   { self.console.write_line("    ldrb w0, [x9]"); transition 0 { _ -> pu() } }
    state ldw()   { self.console.write_line("    ldr w0, [x9]"); transition 0 { _ -> pu() } }
    state pu()    { self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> done() } }
    state done()  { self.console.exit_process(0) }
}
