// CERTIFYING COMPUTATION — a STRUCTURAL property (not arithmetic). Every prior certifier
// proves a fact about numbers or array indices; this one proves an INDUCTIVE-PREDICATE
// fact: list membership, Mem(x, L) = (Rel 777 x L) — the very predicate the infinitude-
// of-primes capstone reasons with. It reads x and a 3-element list [a b c] (with x among
// them), finds x, and emits a proof certificate that x is a member:
//   proposition  (Rel 777 X (cons A (cons B (cons C nil))))
//   proof, by position of x:
//     x = a:  (memhead X (cons B (cons C nil)))
//     x = b:  (memtail A (memhead X (cons C nil)))
//     x = c:  (memtail A (memtail B (memhead X nil)))
// The trust anchor accepts ONLY because memhead/memtail are the sound intros of Mem — a
// proof that walks to x's actual position. A wrong position emits a cert proof kernel REJECTS.
//   printf '7 4 7 9' | certify-member | check.exe  ->  accept   (7 is in [4 7 9], at index 1)
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    vals: [i32; 8]; vn: i32; cur: i32; inb: i32; uv: i32;
    x: i32; a: i32; b: i32; d: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
machine Main::main(&mut self) {
    self.n = 0; self.vn = 0; self.cur = 0; self.inb = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> pp()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    // parse buf into vals[] (whitespace-separated decimals)
    state pp()    { self.pos = 0; transition 0 { _ -> pscan() } }
    state pscan() { transition self.pos < self.n { true -> pc()  false -> pend() } }
    state pc()    { transition self.buf[self.pos] < 48 { true -> psep()  false -> pcHi() } }
    state pcHi()  { transition self.buf[self.pos] > 57 { true -> psep()  false -> pdig() } }
    state pdig()  { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.inb = 1; self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state psep()  { transition self.inb == 1 { true -> pstore()  false -> padv() } }
    state pstore(){ self.vals[self.vn] = self.cur; self.vn = self.vn + 1; self.cur = 0; self.inb = 0; transition 0 { _ -> padv() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> pscan() } }
    state pend()  { transition self.inb == 1 { true -> pendS()  false -> pick() } }
    state pendS() { self.vals[self.vn] = self.cur; self.vn = self.vn + 1; transition 0 { _ -> pick() } }
    // x = vals[0]; list = [vals[1] vals[2] vals[3]]
    state pick()  { self.x = self.vals[0]; self.a = self.vals[1]; self.b = self.vals[2]; self.d = self.vals[3]; transition 0 { _ -> prop() } }
    // emit the proposition  (Rel 777 X (cons A (cons B (cons C nil))))  -- shared by all cases
    state prop()  {
        write_line("(Rel 777");
        self.emit_nat(self.x);
        write_line("(cons");
        self.emit_nat(self.a);
        write_line("(cons");
        self.emit_nat(self.b);
        write_line("(cons");
        self.emit_nat(self.d);
        write_line("nil)))");
        // then the position-specific proof
        transition self.x == self.a { true -> caseA()  false -> nb() }
    }
    state nb()    { transition self.x == self.b { true -> caseB()  false -> caseC() } }
    // x = a:  (memhead X (cons B (cons C nil)))
    state caseA() {
        write_line("(memhead");
        self.emit_nat(self.x);
        write_line("(cons");
        self.emit_nat(self.b);
        write_line("(cons");
        self.emit_nat(self.d);
        write_line("nil)))");
        self.console.exit_process(0)
    }
    // x = b:  (memtail A (memhead X (cons C nil)))
    state caseB() {
        write_line("(memtail");
        self.emit_nat(self.a);
        write_line("(memhead");
        self.emit_nat(self.x);
        write_line("(cons");
        self.emit_nat(self.d);
        write_line("nil)))");
        self.console.exit_process(0)
    }
    // x = c:  (memtail A (memtail B (memhead X nil)))
    state caseC() {
        write_line("(memtail");
        self.emit_nat(self.a);
        write_line("(memtail");
        self.emit_nat(self.b);
        write_line("(memhead");
        self.emit_nat(self.x);
        write_line("nil)))");
        self.console.exit_process(0)
    }
}
