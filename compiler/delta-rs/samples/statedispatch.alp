// Eval-arm state arguments — a tag-matched transition arm `N -> s(EXPR)` evaluates EXPR and passes
// it to the target state's parameter. Unlike a wildcard arm (which branches unconditionally), a
// matched arm must store the argument only when the tag matches, so it lowers as
// `cmp w0, #N; b.ne Lsk<k>; <store arg>; b target; Lsk<k>:`. This is the dispatch skeleton that
// `case` payload-binding arms reuse. Here x = 1 selects the `1 ->` arm, passing 6 * 7 = 42.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; x: i32; a: i32; b: i32; }
machine Main::main(&mut self) {
    self.x = 1; self.a = 6; self.b = 7;
    transition self.x {
        0 -> show(0)
        1 -> show(self.a * self.b)
        _ -> show(99)
    }
    state show(v: i32) { self.console.exit_process(v) }
}
