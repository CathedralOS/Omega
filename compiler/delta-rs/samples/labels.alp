// SELF-HOSTING / BUILDING: the control analog of layout. layout assigns each data field a
// byte offset; labels.alp assigns each STATE its assembly label -- the backend's own scheme
// (src/aarch64.rs): state si of machine mi is `Lm<mi>s<si>`, where mi is the declaration
// index over DEPTH-0 machines (a `machine` inside a boundary/data block does not count,
// src/parse.rs:324) and si is the state's 0-based order within that machine. So this is the
// symbol pass a codegen runs before emitting branches. Brace-depth tracking is the new bit:
// count `machine` only at depth 0 and `state` only at depth 1 (the machine-body level).
// Output: one `statename Lm<mi>s<si>` per line.
//   printf 'machine A::a(){ state p(){} state q(){} } machine B::b(){ state r(){} }' | labels
//     ->  p Lm0s0 / q Lm0s1 / r Lm1s0
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    n: i32; pos: i32; c: i32; start: i32; w: i32; pend: i32; depth: i32; mi: i32; si: i32;
    v: i32; di: i32; ek: i32;
    dig: [i32; 16];
    buf: [u8; 16384];
}
machine Main::is_word(&mut self, c: i32) -> i32 {
    transition c == 95 { true -> yes()  false -> w1() }
    state w1() { transition c < 48  { true -> no()  false -> w2() } }
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }
    state w3() { transition c < 65  { true -> no()  false -> w4() } }
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }
    state w5() { transition c < 97  { true -> no()  false -> w6() } }
    state w6() { transition c <= 122 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::is_state(&mut self, s: i32, e: i32) -> i32 {     // "state"
    transition e - s == 5 { true -> k0()  false -> kno() }
    state k0() { transition self.buf[s]     == 115 { true -> k1()  false -> kno() } }
    state k1() { transition self.buf[s + 1] == 116 { true -> k2()  false -> kno() } }
    state k2() { transition self.buf[s + 2] == 97  { true -> k3()  false -> kno() } }
    state k3() { transition self.buf[s + 3] == 116 { true -> k4()  false -> kno() } }
    state k4() { transition self.buf[s + 4] == 101 { true -> kyes() false -> kno() } }
    state kyes() { return 1; }
    state kno()  { return 0; }
}
machine Main::is_machine(&mut self, s: i32, e: i32) -> i32 {   // "machine"
    transition e - s == 7 { true -> m0()  false -> mno() }
    state m0() { transition self.buf[s]     == 109 { true -> m1()  false -> mno() } }
    state m1() { transition self.buf[s + 1] == 97  { true -> m2()  false -> mno() } }
    state m2() { transition self.buf[s + 2] == 99  { true -> m3()  false -> mno() } }
    state m3() { transition self.buf[s + 3] == 104 { true -> m4()  false -> mno() } }
    state m4() { transition self.buf[s + 4] == 105 { true -> m5()  false -> mno() } }
    state m5() { transition self.buf[s + 5] == 110 { true -> m6()  false -> mno() } }
    state m6() { transition self.buf[s + 6] == 101 { true -> myes() false -> mno() } }
    state myes() { return 1; }
    state mno()  { return 0; }
}
machine Main::emit_name(&mut self, a: i32, b: i32) {
    self.ek = a;
    transition 0 { _ -> el() }
    state el() { transition self.ek < b { true -> ew()  false -> done() } }
    state ew() { write_byte(self.buf[self.ek]); self.ek = self.ek + 1; transition 0 { _ -> el() } }
    state done(){ }
}
machine Main::emit_int(&mut self) {     // self.v as decimal
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::main(&mut self) {
    self.n = 0; self.pend = 0; self.depth = 0; self.mi = 0 - 1; self.si = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { transition self.n < 16384 { true -> store2()  false -> rd() } }
    state store2(){ self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state scan()  { self.pos = 0; transition 0 { _ -> sk() } }
    state sk()    { transition self.pos < self.n { true -> ws()  false -> ok() } }
    state ws()    { transition self.buf[self.pos] <= 32 { true -> wadv()  false -> cm() } }
    state wadv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state cm()    { transition self.buf[self.pos] == 47 { true -> cm2()  false -> str0() } }
    state cm2()   { transition self.buf[self.pos + 1] == 47 { true -> cms()  false -> str0() } }
    state cms()   { transition self.pos < self.n { true -> cnl()  false -> ok() } }
    state cnl()   { transition self.buf[self.pos] == 10 { true -> wadv()  false -> cadv() } }
    state cadv()  { self.pos = self.pos + 1; transition 0 { _ -> cms() } }
    state str0()  { transition self.buf[self.pos] == 34 { true -> stra()  false -> tok() } }
    state stra()  { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    state ss()    { transition self.pos < self.n { true -> ss2()  false -> ok() } }
    state ss2()   { transition self.buf[self.pos] == 34 { true -> wadv()  false -> ssa() } }
    state ssa()   { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    state tok()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word()  false -> punc() } }
    state word()  { self.start = self.pos; transition 0 { _ -> wrun() } }
    state wrun()  { transition self.pos < self.n { true -> wrck()  false -> wcl() } }
    state wrck()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wra()  false -> wcl() } }
    state wra()   { self.pos = self.pos + 1; transition 0 { _ -> wrun() } }
    // classify: pending state-name word, or `machine`(depth 0) / `state`(depth 1) keyword
    state wcl()   { transition self.pend == 1 { true -> emit()  false -> ckM() } }
    state ckM()   { self.w = self.is_machine(self.start, self.pos); transition self.w == 1 { true -> ckMd()  false -> ckS() } }
    state ckMd()  { transition self.depth == 0 { true -> newM()  false -> sk() } }
    state newM()  { self.mi = self.mi + 1; self.si = 0; transition 0 { _ -> sk() } }
    state ckS()   { self.w = self.is_state(self.start, self.pos); transition self.w == 1 { true -> ckSd()  false -> sk() } }
    state ckSd()  { transition self.depth == 1 { true -> setP()  false -> sk() } }
    state setP()  { self.pend = 1; transition 0 { _ -> sk() } }
    // emit `statename Lm<mi>s<si>` and bump si
    state emit()  { self.pend = 0; self.emit_name(self.start, self.pos); write_byte(32); write_byte(76); write_byte(109); transition 0 { _ -> emi() } } // " Lm"
    state emi()   { self.v = self.mi; self.emit_int(); write_byte(115); transition 0 { _ -> esi() } }   // mi then 's'
    state esi()   { self.v = self.si; self.emit_int(); write_byte(10); self.si = self.si + 1; transition 0 { _ -> sk() } }
    // punctuation: maintain brace depth
    state punc()  { transition self.buf[self.pos] == 123 { true -> opn()  false -> pcl() } }   // '{'
    state opn()   { self.depth = self.depth + 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state pcl()   { transition self.buf[self.pos] == 125 { true -> cls()  false -> padv() } }  // '}'
    state cls()   { self.depth = self.depth - 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state ok()    { self.console.exit_process(0) }
}
