// State parameters — a transition arm `_ -> s(EXPR)` passes EXPR as an argument to the target
// state's parameter: EXPR is evaluated and stored into the state's frame slot before the branch,
// and read by name inside the state body. (This is the mechanism that Omega's `case` payload
// binding reuses, where the bound value is a read of the subject's payload.) Here main computes
// 6 * 7 and passes it to show(v), which exits 42.
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; a: i32; b: i32; }
machine Main::main(&mut self) {
    self.a = 6;
    self.b = 7;
    transition 0 { _ -> show(self.a * self.b) }
    state show(v: i32) { self.console.exit_process(v) }
}
