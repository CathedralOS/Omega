// min/max builtins — Omega's clamp idiom `max(lo, min(v, hi))` (from samples/clamp_sum). Clamp the raw
// readings [80, -5, 50, 200, 30] into the band [0, 60] and sum: the clamped values are [60, 0, 50, 60, 30],
// summing to 200. Exercises both builtins together and nested (max over min).
//   minmax  ->  exit 200
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: i32 = max(0, min(80, 60));    // min(80,60)=60,  max(0,60)=60
    let b: i32 = max(0, min(-5, 60));    // min(-5,60)=-5,  max(0,-5)=0
    let c: i32 = max(0, min(50, 60));    // 50
    let d: i32 = max(0, min(200, 60));   // 60
    let e: i32 = max(0, min(30, 60));    // 30
    self.console.exit_process(a + b + c + d + e)   // 200
}
