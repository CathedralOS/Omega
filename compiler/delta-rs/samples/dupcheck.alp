// SELF-HOSTING step: another real .alp frontend pass, with SCOPING. dupcheck.alp reads
// .alp source and reports DUPLICATE state declarations within a machine -- two
// `state foo` in the same machine is a redefinition error. Crucially, the same state
// name in DIFFERENT machines is legal (e.g. every machine with emit_nat has `state uo`),
// so the check is MACHINE-SCOPED: each `machine` keyword opens a new scope, and a
// duplicate is two `state NAME` with the same name AND the same enclosing machine.
// This is the "duplicate definition" diagnostic a real compiler emits, and the first
// .alp analysis that tracks scope (not just a flat global scan).
//   printf 'machine M::m(){ state a(){} state a(){} }' | dupcheck  -> prints a, exit 1
//   printf 'machine A::a(){ state s(){} } machine B::b(){ state s(){} }' | dupcheck -> exit 0
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    // scalars first (low offsets), big arrays/buf last (reached via the array-element path)
    console: Console;
    n: i32; pos: i32; c: i32; start: i32; w: i32; pend: i32; mi: i32; nd: i32;
    ci: i32; cj: i32; bad: i32; ei: i32; qa: i32; qb: i32; qc: i32; qd: i32; qk: i32;
    ds: [i32; 384]; de: [i32; 384]; dm: [i32; 384];     // state decl [start,end) + machine index
    buf: [u8; 16384];
}
machine Main::is_word(&mut self, c: i32) -> i32 {
    transition c == 95 { true -> yes()  false -> w1() }
    state w1() { transition c < 48  { true -> no()  false -> w2() } }
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }
    state w3() { transition c < 65  { true -> no()  false -> w4() } }
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }
    state w5() { transition c < 97  { true -> no()  false -> w6() } }
    state w6() { transition c <= 122 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::is_state(&mut self, s: i32, e: i32) -> i32 {     // "state" = 115 116 97 116 101
    transition e - s == 5 { true -> k0()  false -> kno() }
    state k0() { transition self.buf[s]     == 115 { true -> k1()  false -> kno() } }
    state k1() { transition self.buf[s + 1] == 116 { true -> k2()  false -> kno() } }
    state k2() { transition self.buf[s + 2] == 97  { true -> k3()  false -> kno() } }
    state k3() { transition self.buf[s + 3] == 116 { true -> k4()  false -> kno() } }
    state k4() { transition self.buf[s + 4] == 101 { true -> kyes() false -> kno() } }
    state kyes() { return 1; }
    state kno()  { return 0; }
}
machine Main::is_machine(&mut self, s: i32, e: i32) -> i32 {   // "machine" = 109 97 99 104 105 110 101
    transition e - s == 7 { true -> m0()  false -> mno() }
    state m0() { transition self.buf[s]     == 109 { true -> m1()  false -> mno() } }
    state m1() { transition self.buf[s + 1] == 97  { true -> m2()  false -> mno() } }
    state m2() { transition self.buf[s + 2] == 99  { true -> m3()  false -> mno() } }
    state m3() { transition self.buf[s + 3] == 104 { true -> m4()  false -> mno() } }
    state m4() { transition self.buf[s + 4] == 105 { true -> m5()  false -> mno() } }
    state m5() { transition self.buf[s + 5] == 110 { true -> m6()  false -> mno() } }
    state m6() { transition self.buf[s + 6] == 101 { true -> myes() false -> mno() } }
    state myes() { return 1; }
    state mno()  { return 0; }
}
machine Main::streq(&mut self) -> i32 {     // buf[qa..qb) == buf[qc..qd)
    transition self.qb - self.qa == self.qd - self.qc { true -> sq0()  false -> sno() }
    state sq0()  { self.qk = 0; transition 0 { _ -> sloop() } }
    state sloop(){ transition self.qa + self.qk < self.qb { true -> scmp()  false -> syes() } }
    state scmp() { transition self.buf[self.qa + self.qk] == self.buf[self.qc + self.qk] { true -> sadv()  false -> sno() } }
    state sadv() { self.qk = self.qk + 1; transition 0 { _ -> sloop() } }
    state syes()  { return 1; }
    state sno()   { return 0; }
}
machine Main::emit_range(&mut self, a: i32, b: i32) {
    self.ei = a;
    transition 0 { _ -> el() }
    state el() { transition self.ei < b { true -> ew()  false -> enl() } }
    state ew() { write_byte(self.buf[self.ei]); self.ei = self.ei + 1; transition 0 { _ -> el() } }
    state enl(){ write_byte(10); }
}
machine Main::main(&mut self) {
    self.n = 0; self.nd = 0; self.mi = 0; self.pend = 0; self.bad = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { transition self.n < 16384 { true -> store2()  false -> rd() } }
    state store2(){ self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    // ---- scan: count machines (scope) and collect `state NAME` decls tagged by machine ----
    state scan()    { self.pos = 0; transition 0 { _ -> sk() } }
    state sk()      { transition self.pos < self.n { true -> ws()  false -> xcheck() } }
    state ws()      { transition self.buf[self.pos] <= 32 { true -> wadv()  false -> commck() } }
    state wadv()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state commck()  { transition self.buf[self.pos] == 47 { true -> commck2()  false -> strck() } }
    state commck2() { transition self.buf[self.pos + 1] == 47 { true -> skipc()  false -> strck() } }
    state skipc()   { transition self.pos < self.n { true -> cnl()  false -> xcheck() } }
    state cnl()     { transition self.buf[self.pos] == 10 { true -> wadv()  false -> cadv() } }
    state cadv()    { self.pos = self.pos + 1; transition 0 { _ -> skipc() } }
    state strck()   { transition self.buf[self.pos] == 34 { true -> stradv()  false -> tok() } }
    state stradv()  { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    state ss()      { transition self.pos < self.n { true -> ss2()  false -> xcheck() } }
    state ss2()     { transition self.buf[self.pos] == 34 { true -> wadv()  false -> ssa() } }
    state ssa()     { self.pos = self.pos + 1; transition 0 { _ -> ss() } }
    state tok()     { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word()  false -> punc() } }
    state punc()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state word()    { self.start = self.pos; transition 0 { _ -> wrun() } }
    state wrun()    { transition self.pos < self.n { true -> wrck()  false -> wclass() } }
    state wrck()    { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wradv()  false -> wclass() } }
    state wradv()   { self.pos = self.pos + 1; transition 0 { _ -> wrun() } }
    state wclass()  { self.w = self.is_machine(self.start, self.pos); transition self.w == 1 { true -> newMach()  false -> ckState() } }
    state newMach() { self.mi = self.mi + 1; self.pend = 0; transition 0 { _ -> sk() } }            // new machine scope
    state ckState() { self.w = self.is_state(self.start, self.pos); transition self.w == 1 { true -> setD()  false -> useW() } }
    state setD()    { self.pend = 1; transition 0 { _ -> sk() } }                                    // `state` -> next word is a decl
    state useW()    { transition self.pend == 1 { true -> ckCap()  false -> sk() } }
    state ckCap()   { transition self.nd < 384 { true -> addD()  false -> rstP() } }
    state addD()    { self.ds[self.nd] = self.start; self.de[self.nd] = self.pos; self.dm[self.nd] = self.mi; self.nd = self.nd + 1; self.pend = 0; transition 0 { _ -> sk() } }
    state rstP()    { self.pend = 0; transition 0 { _ -> sk() } }
    // ---- cross-check: any two decls with the same machine AND name are duplicates ----
    state xcheck()  { self.ci = 0; transition 0 { _ -> il() } }
    state il()      { transition self.ci < self.nd { true -> jset()  false -> report() } }
    state jset()    { self.cj = self.ci + 1; transition 0 { _ -> jl() } }
    state jl()      { transition self.cj < self.nd { true -> jck()  false -> inext() } }
    state jck()     { transition self.dm[self.ci] == self.dm[self.cj] { true -> jeq()  false -> jnext() } }
    state jeq()     { self.qa = self.ds[self.ci]; self.qb = self.de[self.ci]; self.qc = self.ds[self.cj]; self.qd = self.de[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> dup()  false -> jnext() } }
    state dup()     { self.bad = 1; self.emit_range(self.ds[self.ci], self.de[self.ci]); transition 0 { _ -> inext() } } // report once per ci
    state jnext()   { self.cj = self.cj + 1; transition 0 { _ -> jl() } }
    state inext()   { self.ci = self.ci + 1; transition 0 { _ -> il() } }
    state report()  { transition self.bad == 1 { true -> fail()  false -> ok() } }
    state fail()    { self.console.exit_process(1) }
    state ok()      { self.console.exit_process(0) }
}
