// Number I/O: parse a non-negative decimal integer from stdin, square it, and
// print the result back as decimal. The load-bearing primitive a self-hosting
// Delta compiler needs — it must parse numeric literals from source and emit
// numeric immediates into its output. Exercises, in one program:
//   - multi-digit decimal PARSE      (n = n*10 + (c - '0'))
//   - arithmetic on the real value   (n*n, not mod 256 — output proves it)
//   - integer division + the %-via-(x - (x/10)*10) idiom (predates delta's `%`;
//     kept as-is to exercise division — see modulo.alp for the `%` operator)
//   - a [u8;N] digit buffer, filled least-significant-first
//   - reversed output                (write the buffer most-significant-first)
//   square(144) = 20736.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    n: i32; c: i32; sq: i32; d: i32; len: i32; i: i32;
    buf: [u8; 16];
}
machine Main::main(&mut self) {
    self.n = 0;
    transition 0 { _ -> read() }

    state read() {
        self.c = read_byte();
        // any byte below '0' ends the number: covers EOF (-1), '\n', ' '.
        transition self.c < 48 { true -> compute()  false -> accum() }
    }
    state accum() {
        self.n = self.n * 10 + (self.c - 48);
        transition 0 { _ -> read() }
    }
    state compute() {
        self.sq = self.n * self.n;
        self.len = 0;
        transition self.sq == 0 { true -> zero()  false -> extract() }
    }
    state zero() {
        write_byte(48); // '0'
        self.console.exit_process(0)
    }
    state extract() {
        self.d = self.sq / 10;
        self.buf[self.len] = 48 + (self.sq - self.d * 10); // '0' + (sq % 10)
        self.sq = self.d;
        self.len = self.len + 1;
        transition self.sq == 0 { true -> output()  false -> extract() }
    }
    state output() {
        self.i = self.len - 1;
        transition 0 { _ -> emit() }
    }
    state emit() {
        transition self.i < 0 { true -> fin()  false -> emit_one() }
    }
    state emit_one() {
        write_byte(self.buf[self.i]);
        self.i = self.i - 1;
        transition 0 { _ -> emit() }
    }
    state fin() {
        self.console.exit_process(0)
    }
}
