// CERTIFYING COMPUTATION over a PAYLOAD sum type — convergence exercising the self-hosted compiler's
// full enum machinery (payload construction with variable fields, single AND multi-field binding, and
// state arguments) inside a delta-checked proof. Reads `tag ...`: tag selects a Shape variant carrying
// its dimensions, the program binds those payload fields, computes the area, and EMITS A DELTA
// CERTIFICATE that the area is correct, which the trust anchor independently checks.
//   tag 0 -> Square(s)   : binds s,    proves  s * s = area  ->  (= (m S S) AREA) (refl AREA)
//   tag 1 -> Rect(w, h)  : binds w, h, proves  w * h = area  ->  (= (m W H) AREA) (refl AREA)
//   printf '0 4'   | certify-shape | check.exe  ->  accept   (4*4 = 16)
//   printf '1 6 7' | certify-shape | check.exe  ->  accept   (6*7 = 42)
// A wrong area emits a certificate proof kernel REJECTS -- the anchor checks the computation, not the
// (self-hosted) compiler that built it.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Shape { case Square(s: i32); case Rect(w: i32, h: i32); }
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    sh: Shape;
    tag: i32; sv: i32; wv: i32; hv: i32; a: i32; b: i32; area: i32; uv: i32;
}
// emit a natural as the checker's unary literal: v copies of "(s ", then "z", then v copies of ")".
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// skip non-digits, then read one decimal number from self.buf[self.pos..], advancing self.pos.
machine Main::next_num(&mut self) -> i32 {
    let v: i32 = 0;
    transition 0 { _ -> sk() }
    state sk()   { transition self.pos < self.n { true -> sk2()  false -> done() } }
    state sk2()  { transition self.buf[self.pos] < 48 { true -> adv()  false -> sk3() } }
    state sk3()  { transition self.buf[self.pos] > 57 { true -> adv()  false -> rdn() } }
    state adv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state rdn()  { transition self.pos < self.n { true -> rdn2()  false -> done() } }
    state rdn2() { transition self.buf[self.pos] < 48 { true -> done()  false -> rdn3() } }
    state rdn3() { transition self.buf[self.pos] > 57 { true -> done()  false -> acc() } }
    state acc()  { v = v * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> rdn() } }
    state done() { return v; }
}
machine Main::main(&mut self) {
    self.n = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; self.tag = self.next_num(); transition 0 { _ -> seltag() } }
    // CONSTRUCT the Shape variant from the tag, reading its payload field(s) from the input
    state seltag()  { transition self.tag == 0 { true -> mksq()  false -> mkrect() } }
    state mksq()    { self.sv = self.next_num(); self.sh = Shape::Square(self.sv); transition 0 { _ -> disp() } }
    state mkrect()  { self.wv = self.next_num(); self.hv = self.next_num(); self.sh = Shape::Rect(self.wv, self.hv); transition 0 { _ -> disp() } }
    // MATCH + bind the payload field(s), passing them as state arguments
    state disp() {
        transition self.sh {
            Shape::Square { s }   -> emitsq(s)
            Shape::Rect   { w, h } -> emitrect(w, h)
        }
    }
    state emitsq(s: i32)            { self.a = s; self.b = s; self.area = s * s; transition 0 { _ -> emit() } }   // square: s*s
    state emitrect(w: i32, h: i32)  { self.a = w; self.b = h; self.area = w * h; transition 0 { _ -> emit() } }   // rect: w*h
    // emit  (= (m A B) AREA) (refl AREA)
    state emit() {
        write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(109); write_byte(32); // "(= (m "
        self.emit_nat(self.a); write_byte(32); self.emit_nat(self.b);
        write_byte(41); write_byte(32);                                                                   // ") "
        self.emit_nat(self.area);
        write_byte(41); write_byte(32); write_byte(40); write_byte(114); write_byte(101);
        write_byte(102); write_byte(108); write_byte(32);                                                 // ") (refl "
        self.emit_nat(self.area); write_byte(41);                                                         // ")"
        self.console.exit_process(0)
    }
}
