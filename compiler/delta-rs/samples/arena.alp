// Slice 7b: array fields + trap-checked indexing. Computes Fibonacci into an
// array held in self, then exits with fib(11) = 89. Every `self.fib[i]` access is
// bounds-checked (index >= length traps via ud2), per the Alpha spec.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_line(text: &[u8] in Utf8);
}
data Main {
    console: Console;
    fib: [i32; 16];
    i: i32;
}

machine Main::main(&mut self) {
    self.fib[0] = 0;
    self.fib[1] = 1;
    self.i = 2;
    transition 0 { _ -> step() }

    state step() {
        transition self.i < 12 {
            true  -> compute()
            false -> done()
        }
    }
    state compute() {
        self.fib[self.i] = self.fib[self.i - 1] + self.fib[self.i - 2];
        self.i = self.i + 1;
        transition 0 { _ -> step() }
    }
    state done() {
        self.console.exit_process(self.fib[11])
    }
}
