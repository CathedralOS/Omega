// Recursive-descent arithmetic evaluator — the heart of a compiler front-end,
// shown to be expressible in delta. Reads an expression from stdin, evaluates
// it with correct precedence and parentheses, and prints the decimal result.
//   expr   = term (('+'|'-') term)*
//   term   = factor (('*'|'/') factor)*
//   factor = number | '(' expr ')'      <- parens recurse: factor calls expr
// The parse position (self.pos) is shared state (the global cursor); each
// machine's accumulator is a LOCAL, so the recursion through '(' expr ')' is
// re-entrant. Division traps on /0 (the trap-everything decision). Integer math.
//   2+3*4 = 14 ; (2+3)*4 = 20 ; 100/5/2 = 10 ; ((1+2))*3 = 9
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 256]; obuf: [u8; 16];
    pos: i32; c: i32; acc: i32;
    pv: i32; d: i32; olen: i32; oi: i32;
}
// factor = number | '(' expr ')'
machine Main::factor(&mut self) -> i32 {
    let v: i32 = 0;
    let pv: i32 = 0;
    transition self.buf[self.pos] == 40 { true -> fparen()  false -> floop() }
    state fparen() {
        self.pos = self.pos + 1;       // skip '('
        pv = self.expr();              // recurse
        self.pos = self.pos + 1;       // skip ')'
        return pv;
    }
    state floop() {
        transition self.buf[self.pos] < 48 { true -> fdone()  false -> fdig() }
    }
    state fdig() {
        v = v * 10 + (self.buf[self.pos] - 48);
        self.pos = self.pos + 1;
        transition 0 { _ -> floop() }
    }
    state fdone() { return v; }
}
// term = factor (('*'|'/') factor)*
machine Main::term(&mut self) -> i32 {
    let acc: i32 = 0;
    acc = self.factor();
    transition 0 { _ -> tloop() }
    state tloop()  { transition self.buf[self.pos] == 42 { true -> tmul()  false -> tdivc() } }
    state tdivc()  { transition self.buf[self.pos] == 47 { true -> tdiv()  false -> tdone() } }
    state tmul()   { self.pos = self.pos + 1; acc = acc * self.factor(); transition 0 { _ -> tloop() } }
    state tdiv()   { self.pos = self.pos + 1; acc = acc / self.factor(); transition 0 { _ -> tloop() } }
    state tdone()  { return acc; }
}
// expr = term (('+'|'-') term)*
machine Main::expr(&mut self) -> i32 {
    let acc: i32 = 0;
    acc = self.term();
    transition 0 { _ -> eloop() }
    state eloop()  { transition self.buf[self.pos] == 43 { true -> eadd()  false -> esubc() } }
    state esubc()  { transition self.buf[self.pos] == 45 { true -> esub()  false -> edone() } }
    state eadd()   { self.pos = self.pos + 1; acc = acc + self.term(); transition 0 { _ -> eloop() } }
    state esub()   { self.pos = self.pos + 1; acc = acc - self.term(); transition 0 { _ -> eloop() } }
    state edone()  { return acc; }
}
machine Main::printn(&mut self, v: i32) {
    self.pv = v;
    self.olen = 0;
    transition self.pv == 0 { true -> pzero()  false -> pext() }
    state pzero() { write_byte(48); transition 0 { _ -> pend() } }
    state pext() {
        self.d = self.pv / 10;
        self.obuf[self.olen] = 48 + (self.pv - self.d * 10);
        self.pv = self.d; self.olen = self.olen + 1;
        transition self.pv == 0 { true -> pout()  false -> pext() }
    }
    state pout()  { self.oi = self.olen - 1; transition 0 { _ -> pemit() } }
    state pemit() { transition self.oi < 0 { true -> pend()  false -> pe1() } }
    state pe1()   { write_byte(self.obuf[self.oi]); self.oi = self.oi - 1; transition 0 { _ -> pemit() } }
    state pend()  {}
}
machine Main::main(&mut self) {
    self.pos = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.pos] = self.c; self.pos = self.pos + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; self.acc = self.expr(); transition 0 { _ -> pr() } }
    state pr()    { self.printn(self.acc); self.console.exit_process(0) }
}
