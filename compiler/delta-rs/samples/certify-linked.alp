// CERTIFYING COMPILER that LINKS against a proof library. The other certifiers
// re-derive each bound from scratch (computing the gap witness). This one instead
// CITES a proven theorem: bounds-2d (forall i n j m. i<m & j<n -> i*n+j < m*n), which
// ships once as a delta `def` in a library prefix. For an access a[i][j] into an
// m-by-n array it emits only the LINKAGE -- the goal plus a proof that applies the
// library theorem to the two site premises:
//   (app (app (inst (inst (inst (inst (use 30) I) N) J) M)  <proof I<M>)  <proof J<N>)
// where <proof I<M> = (wit (= (p I (s (v 0))) M) (M-I-1) (refl M)), likewise J<N.
// A linker prepends the library; the trust anchor checks library + linkage together.
// This is how a verified compiler discharges an obligation: invoke the proven lemma
// with the specific facts, not re-prove it. (use 30) is bounds-2d's def id in the lib.
//   { lib2d.proof ; printf 'I N J M' | certify-linked ; } | check.exe  ->  accept
// Contract: I<M and J<N. NB the library def id (30) is the linker contract.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    nums: [i32; 4]; ni: i32; cur: i32; wim: i32; wjn: i32; bad: i32; uv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// the goal body  (= (p (p (m I N) J) (s (v 0))) (m M N))  -- nums[0..3] = i n j m
machine Main::emit_eqbody(&mut self) {
    write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);
    write_byte(40); write_byte(112); write_byte(32); write_byte(40); write_byte(109); write_byte(32);
    self.emit_nat(self.nums[0]);
    write_byte(32);
    self.emit_nat(self.nums[1]);
    write_byte(41); write_byte(32);
    self.emit_nat(self.nums[2]);
    write_byte(41); write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40);
    write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(41);
    write_byte(32); write_byte(40); write_byte(109); write_byte(32);
    self.emit_nat(self.nums[3]);
    write_byte(32);
    self.emit_nat(self.nums[1]);
    write_byte(41); write_byte(41);
}
// a premise proof  (wit (= (p av (s (v 0))) bv) wv (refl bv))   i.e. av < bv, witness wv
machine Main::emit_lt(&mut self, av: i32, bv: i32, wv: i32) {
    write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32);                // "(wit "
    write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);  // "(= (p "
    self.emit_nat(av);
    write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40); write_byte(118);
    write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(41); write_byte(32);    // " (s (v 0))) "
    self.emit_nat(bv);
    write_byte(41); write_byte(32);                                                                   // ") "
    self.emit_nat(wv);
    write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32); // " (refl "
    self.emit_nat(bv);
    write_byte(41); write_byte(41);                                                                   // "))"
}
machine Main::main(&mut self) {
    self.n = 0; self.ni = 0; self.bad = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> nxt() } }
    state nxt()   { transition self.ni < 4 { true -> skipnd()  false -> compute() } }
    state skipnd(){ transition self.pos < self.n { true -> sndck()  false -> compute() } }
    state sndck() { transition self.buf[self.pos] < 48 { true -> snda()  false -> sndHi() } }
    state sndHi() { transition self.buf[self.pos] > 57 { true -> snda()  false -> pnum() } }
    state snda()  { self.pos = self.pos + 1; transition 0 { _ -> skipnd() } }
    state pnum()  { self.cur = 0; transition 0 { _ -> pd() } }
    state pd()    { transition self.buf[self.pos] < 48 { true -> psave()  false -> pdHi() } }
    state pdHi()  { transition self.buf[self.pos] > 57 { true -> psave()  false -> pacc() } }
    state pacc()  { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pd() } }
    state psave() { self.nums[self.ni] = self.cur; self.ni = self.ni + 1; transition 0 { _ -> nxt() } }
    // premise witnesses, with a safety check (the linker rejects unsafe accesses)
    state compute(){
        self.wim = self.nums[3] - self.nums[0] - 1;   // i < m
        self.wjn = self.nums[1] - self.nums[2] - 1;   // j < n
        transition self.nums[0] < self.nums[3] { true -> ck2()  false -> reject() }
    }
    state ck2()    { transition self.nums[2] < self.nums[1] { true -> emit()  false -> reject() } }
    state reject() { write_byte(117); write_byte(110); write_byte(115); write_byte(97); write_byte(102); write_byte(101); write_byte(10); self.console.exit_process(1) }
    state emit() {
        // goal:  (Exists BODY)
        write_byte(40); write_byte(69); write_byte(120); write_byte(105); write_byte(115);
        write_byte(116); write_byte(115); write_byte(32);                          // "(Exists "
        self.emit_eqbody();
        write_byte(41); write_byte(32);                                            // ") "
        // proof:  (app (app (inst (inst (inst (inst (use 30) I) N) J) M) <I<M>) <J<N>)
        write_byte(40); write_byte(97); write_byte(112); write_byte(112); write_byte(32);
        write_byte(40); write_byte(97); write_byte(112); write_byte(112); write_byte(32);   // "(app (app "
        write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32);
        write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32);
        write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32);
        write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32);
        write_byte(40); write_byte(117); write_byte(115); write_byte(101); write_byte(32);
        write_byte(51); write_byte(48); write_byte(41); write_byte(32);             // "(inst (inst (inst (inst (use 30) "
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.nums[2]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.nums[3]);
        write_byte(41); write_byte(32);                                            // close the 4 insts, then " "
        self.emit_lt(self.nums[0], self.nums[3], self.wim);                        // I < M
        write_byte(41); write_byte(32);                                            // close app2, " "
        self.emit_lt(self.nums[2], self.nums[1], self.wjn);                        // J < N
        write_byte(41);                                                            // close app1
        self.console.exit_process(0)
    }
}
