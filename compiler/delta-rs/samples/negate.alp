// Unary minus. delta lexed `-3` as `Minus Int(3)` but had no unary `-`, so a
// negative literal or `-x` failed to parse — yet Omega programs use negative literals
// freely. `-x` desugars to `(0 - x)` in the parser, so it reuses `Sub`'s overflow trap
// (negating INT_MIN traps) and binds tighter than the binary operators. Hand-checked:
//   -7         negative literal
//   -a         = 7   (unary minus on a local)
//   2 * -3 + 20 = -6 + 20 = 14   (unary binds tighter than `*`)
//   10 - -5    = 15  (subtracting a negative)
//   => 7 + 14 + 15 = 36
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }
machine Main::main(&mut self) {
    let a: i32 = -7;
    let b: i32 = -a;
    let c: i32 = 2 * -3 + 20;
    let d: i32 = 10 - -5;
    self.console.exit_process(b + c + d)
}
