// CERTIFYING COMPUTATION over a LIST of payload sum types — the capstone of the convergence vein.
// One certified computation that COMPOSES the self-hosted compiler's machinery: a counted loop
// (recursion), per-element enum construction with variable payloads, single + multi-field binding,
// state arguments, multiplication, and an accumulating sum. Reads `count` then `count` shapes; for
// each it binds the dimensions and forms the area; it EMITS A PROOF CERTIFICATE that the total area
// equals the nested sum of the per-shape products, which the trust anchor independently checks.
//   each Square(s)  contributes  (m s s)   ;   each Rect(w,h)  contributes  (m w h)
//   total = sum of the areas, proved as  (= (p (m ..) (p (m ..) ... z)) TOTAL) (refl TOTAL)
//   printf '2  1 6 7  0 4'   | certify-shapes | check.exe  ->  accept   (6*7 + 4*4 = 58)
//   printf '3  0 2  0 3  1 4 5' | certify-shapes | check.exe -> accept   (4 + 9 + 20 = 33)
// A wrong total, or a wrong per-shape area, yields a certificate proof kernel REJECTS.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Shape { case Square(s: i32); case Rect(w: i32, h: i32); }
data Main {
    console: Console;
    buf: [u8; 128]; n: i32; pos: i32; c: i32;
    sh: Shape;
    cnt: i32; i: i32; tag: i32; sv: i32; wv: i32; hv: i32; d1: i32; d2: i32; total: i32; uv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {     // v copies of "(s ", then "z", then v copies of ")"
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
machine Main::next_num(&mut self) -> i32 {
    let v: i32 = 0;
    transition 0 { _ -> sk() }
    state sk()   { transition self.pos < self.n { true -> sk2()  false -> done() } }
    state sk2()  { transition self.buf[self.pos] < 48 { true -> adv()  false -> sk3() } }
    state sk3()  { transition self.buf[self.pos] > 57 { true -> adv()  false -> rdn() } }
    state adv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state rdn()  { transition self.pos < self.n { true -> rdn2()  false -> done() } }
    state rdn2() { transition self.buf[self.pos] < 48 { true -> done()  false -> rdn3() } }
    state rdn3() { transition self.buf[self.pos] > 57 { true -> done()  false -> acc() } }
    state acc()  { v = v * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> rdn() } }
    state done() { return v; }
}
machine Main::main(&mut self) {
    self.n = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; self.total = 0; self.i = 0; self.cnt = self.next_num(); transition 0 { _ -> ohead() } }
    // emit  (= (p (m d1 d2) (p (m d3 d4) ... z)) TOTAL) (refl TOTAL)
    state ohead() { write_byte(40); write_byte(61); write_byte(32); transition 0 { _ -> loop() } }   // "(= "
    // for each shape: read it, construct + match the Shape, bind its dims, emit "(p (m d1 d2) "
    state loop()  { transition self.i < self.cnt { true -> rdtag()  false -> tailz() } }
    state rdtag() { self.tag = self.next_num(); transition self.tag == 0 { true -> mksq()  false -> mkrect() } }
    state mksq()  { self.sv = self.next_num(); self.sh = Shape::Square(self.sv); transition 0 { _ -> disp() } }
    state mkrect(){ self.wv = self.next_num(); self.hv = self.next_num(); self.sh = Shape::Rect(self.wv, self.hv); transition 0 { _ -> disp() } }
    state disp() {
        transition self.sh {
            Shape::Square { s }    -> bsq(s)
            Shape::Rect   { w, h } -> brect(w, h)
        }
    }
    state bsq(s: i32)            { self.d1 = s; self.d2 = s; transition 0 { _ -> term() } }
    state brect(w: i32, h: i32)  { self.d1 = w; self.d2 = h; transition 0 { _ -> term() } }
    state term() {
        write_byte(40); write_byte(112); write_byte(32); write_byte(40); write_byte(109); write_byte(32); // "(p (m "
        self.emit_nat(self.d1); write_byte(32); self.emit_nat(self.d2);
        write_byte(41); write_byte(32);                                                                   // ") "
        self.total = self.total + self.d1 * self.d2;
        self.i = self.i + 1;
        transition 0 { _ -> loop() }
    }
    // the nested sum's base, then one ')' per shape to close the (p ..., then the total + refl
    state tailz() { write_byte(122); self.i = 0; transition 0 { _ -> closep() } }                          // "z"
    state closep(){ transition self.i < self.cnt { true -> cp1()  false -> ttail() } }
    state cp1()   { write_byte(41); self.i = self.i + 1; transition 0 { _ -> closep() } }                  // ")" x cnt
    state ttail() {
        write_byte(32); self.emit_nat(self.total);                                                         // " TOTAL"
        write_byte(41); write_byte(32); write_byte(40); write_byte(114); write_byte(101);
        write_byte(102); write_byte(108); write_byte(32);                                                  // ") (refl "
        self.emit_nat(self.total); write_byte(41);                                                         // ")"
        self.console.exit_process(0)
    }
}
