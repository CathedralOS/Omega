// STATIC CONTRACT DISCHARGE — the compiler PROVES an `ensures` contract at BUILD time.
//
// The runtime contract path desugars `ensures` into an assert that traps if violated for the
// concrete inputs of one call. Static discharge is the other half: `DELTA_EMIT=contracts` makes
// the compiler emit, for each machine below, a proof certificate that the postcondition holds
// for ALL inputs (a closed `forall a… obligation`), which the trust anchor checks. The compiler
// proves the contract; it is not trusted to — a false postcondition emits a certificate the
// checker REJECTS, failing the build before the program runs. (See contracts.sh.)
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }

// EQUALITY (proved by refl):
// identity: result == a + b, returned verbatim
machine adds(a: i32, b: i32) -> i32 ensures result == a + b { return a + b; }
// reduction: result == a, returned as 0 + a -> (p z (v0)) reduces to (v0)
machine zadd(a: i32) -> i32 ensures result == a { return 0 + a; }
// LEMMA CITATION: result == a, returned as a + 0 -> (p (v0) z) does NOT reduce (p recurses on
// the left); refl can't prove it. The compiler cites add-zero-right: (inst (use 0) a).
machine azr(a: i32) -> i32 ensures result == a { return a + 0; }
// LEMMA CITATION (multi-arg): result == b + a, returned as a + b -> commutativity, which refl
// can't see. The compiler cites add-commutes at both terms: (inst (inst (use 5) b) a).
machine comm(a: i32, b: i32) -> i32 ensures result == b + a { return a + b; }
// multiplication: result == a * 3, returned verbatim
machine triple(a: i32) -> i32 ensures result == a * 3 { return a * 3; }
// LEMMA CITATION (multiplicative): result == b * a, returned as a * b -> commutativity of `*`,
// which refl can't see (m recurses on the left, so a*b vs b*a is stuck). The compiler cites
// mult-commutes at both terms: (inst (inst (use 20) b) a) -- the * mirror of the `comm` case.
machine mcomm(a: i32, b: i32) -> i32 ensures result == b * a { return a * b; }
// LEMMA CITATION (associativity): result == a + (b + c), returned as (a + b) + c -> re-association,
// which refl can't see ((p (p a b) c) is stuck). The compiler cites add-assoc (inst order b, c, a).
machine assoc(a: i32, b: i32, c: i32) -> i32 ensures result == a + (b + c) { return (a + b) + c; }
// LEMMA CITATION (multiplicative associativity): result == a * (b * c), returned as (a * b) * c -> the
// * mirror of `assoc`; refl can't see it ((m (m a b) c) is stuck). Cites mult-assoc (inst order a, b, c).
machine massoc(a: i32, b: i32, c: i32) -> i32 ensures result == a * (b * c) { return (a * b) * c; }

// STRICT ORDER (proved by an existential witness, a < b == exists w. a+(s w)=b):
// result exceeds the input: result > a, returned as a + 1 -> witness 0
machine succ_gt(a: i32) -> i32 ensures result > a { return a + 1; }
// bounded below by a margin: result > a, returned as a + 5 -> witness 4
machine plus5_gt(a: i32) -> i32 ensures result > a { return a + 5; }
// upper bound: result < a + 1 (i.e. result <= a), returned verbatim a -> witness 0
machine lt_succ(a: i32) -> i32 ensures result < a + 1 { return a; }

// NON-STRICT ORDER (a <= b == exists w. a+w=b; the witness IS the gap, so it can be a param):
// constant margin: result <= a + 10, returned verbatim a -> witness 10 (a literal, so
// provably >= 0 -- sound for signed i32, discharged UNCONDITIONALLY).
machine within10(a: i32) -> i32 ensures result <= a + 10 { return a; }
// PARAMETER gap: result <= a + b, witness the parameter b. A negative b would trap the runtime
// while a naturals proof "accepts", so the bare gap is unsound -- UNLESS the machine guarantees
// b >= 0. Under `requires b >= 0` the discharge emits a CONDITIONAL cert `∀a∀b. (b >= 0) -> result
// <= a+b`, the postcondition mirror of the call-site `a+k` slice; the entry assert of `requires b
// >= 0` then makes the postcondition assert sound. Without the `requires`, no cert (still refused).
machine within_b(a: i32, b: i32) -> i32 requires b >= 0 ensures result <= a + b { return a; }
// The Ge twin: `result >= a` returning `a + b`, witness the parameter b -- the SWAP branch
// (smaller=bound, larger=returned). Same conditional cert under `requires b >= 0`, sound the same way.
machine atleast_b(a: i32, b: i32) -> i32 requires b >= 0 ensures result >= a { return a + b; }
// REFLEXIVE bound: result <= a (and result >= a), returned verbatim. The gap is 0, but `(p a z)` does
// not reduce (p recurses on the left, a is stuck), so refl can't prove `a <= a` -- the discharge cites
// add-zero-right, exactly like `result == a` returned as `a + 0`. Two postconditions, both reflexive.
machine cap(a: i32) -> i32 ensures result <= a ensures result >= a { return a; }

// SAME-BASE OFFSET GAP: both sides are `a + literal`. `result < a + 5` returned as `a + 2` is
// `a+2 < a+5` -- additive_gap can't see it (a+5 is not syntactically (a+2)+k), and the gap is on a
// COMMON base that cancels, so it is sound for any sign of a (unlike a bare parameter gap). The
// witness is (5-2)-1=2; add-assoc factors `(a+2)+3 = a+(2+3)`, whose inner ground sum reduces to 5
// under the stuck `(p a _)`, converting to `a+5`. The non-strict `<=` twin discharges the same way.
machine offlt(a: i32) -> i32 ensures result < a + 5 { return a + 2; }
machine offle(a: i32) -> i32 ensures result <= a + 7 { return a + 3; }

// MULTIPLE POSTCONDITIONS: a machine may declare several `ensures`; each is discharged independently
// into its own certificate (mirroring the runtime path, which desugars each to its own assert). Here
// `return a + 5` proves TWO postconditions of different KINDS -- a strict order (result > a, witness 4)
// AND an equality (result == a + 5, by refl) -- two certs from one machine. A false ensures among
// several is still caught: only the true ones discharge, and any cert the checker rejects fails the build.
machine bump(a: i32) -> i32 ensures result > a ensures result == a + 5 { return a + 5; }

// CALL-SITE COMPOSITION (modular verification): a wrapper forwards its parameter to a callee
// with the SAME precondition. The compiler proves the callee's `requires` holds for the
// argument FROM the wrapper's own `requires` -- omega's call-argument obligation, discharged.
machine needs_pos(x: i32) -> i32 requires x >= 1 { return x; }
machine fwd(a: i32) -> i32 requires a >= 1 { return needs_pos(a); }
// multi-parameter wrapper: forwards its SECOND parameter (b) to the callee; the cert binds
// both parameters and names b inside the existential at (v 2).
machine fwd2(a: i32, b: i32) -> i32 requires b >= 1 { return needs_pos(b); }
// PRECONDITION WEAKENING: the wrapper demands a STRONGER bound (a >= 3) than the callee needs
// (x >= 1). The compiler discharges the callee's precondition from the caller's via le-trans
// (3 >= 1, so a >= 3 implies a >= 1) -- the common modular case, not just identical contracts.
machine weaken(a: i32) -> i32 requires a >= 3 { return needs_pos(a); }
// UPPER-BOUND weakening (mirror): wrapper demands a TIGHTER ceiling (a <= 2) than the callee
// needs (x <= 5); a <= 2 implies a <= 5, again via le-trans.
machine bounded(x: i32) -> i32 requires x <= 5 { return x; }
machine tighten(a: i32) -> i32 requires a <= 2 { return bounded(a); }
// CONSTANT CALL ARGUMENT: a call passing a LITERAL that meets the callee's precondition directly. The
// obligation `5 >= 1` is GROUND -- no caller `requires` is needed -- so a ground witness proves it.
machine call_pos() -> i32 { return needs_pos(5); }

// IMPLICIT ARRAY-BOUNDS (compiler-emitted memory safety): every `self.vals[i]` owes `i < 16` (the
// declared length). The programmer never wrote that obligation -- the compiler finds the access and
// discharges it. `first` indexes a literal 0, proved in range by a ground witness (0 < 16). `get`
// indexes a parameter, discharged by forwarding its `requires i < 16` (the access is safe under the
// contract). An access the compiler can't justify simply emits no certificate (conservative).
data Store { vals: [u8; 16]; }
machine Store::first(&mut self) -> i32 { return self.vals[0]; }
machine Store::get(&mut self, i: i32) -> i32 requires i < 16 { return self.vals[i]; }
// WEAKENING: a TIGHTER precondition than the array size. `self.vals[i]` owes `i < 16`, but this
// machine only promises `i < 8`. Since 8 <= 16, lt-le-trans composes i<8 with the ground bound 8<=16
// to discharge i<16 -- the compiler proves the access safe from a stronger-than-needed contract.
machine Store::tight(&mut self, i: i32) -> i32 requires i < 8 { return self.vals[i]; }
// RANGE-REFINEMENT TYPE (Omega's bounded type): `i: i32 in 0..16` desugars to preconditions i >= 0 and
// i < 16, so the array access self.vals[i] discharges its bounds obligation FROM THE TYPE -- no explicit
// `requires i < 16`. Memory safety comes from the parameter's type, exactly as in Omega's bounded-value model.
machine Store::rget(&mut self, i: i32 in 0..16) -> i32 { return self.vals[i]; }
// The range may be TIGHTER than the array size (0..8 into a 16-slot array): the type's `i < 8` composes
// with the ground bound 8 <= 16 through lt-le-trans, exactly like the `requires i < 8` weakening above.
machine Store::rtight(&mut self, i: i32 in 0..8) -> i32 { return self.vals[i]; }
// BOUNDED-STORE obligation (Omega's BoundedAssignment): a RANGE-refined FIELD `slot: i32 in 0..100` makes
// every `self.slot = v` owe `v < 100` (the store's value in range), discharged statically. `slit` stores a
// literal (proved in range by a ground witness); `sparam` stores a range-typed parameter (p: i32 in 0..50),
// whose type's `p < 50` weakens to `p < 100` via lt-le-trans -- the range PARAM and range FIELD compose.
data Cell { slot: i32 in 0..100; }
machine Cell::slit(&mut self) { self.slot = 42; }
machine Cell::sparam(&mut self, p: i32 in 0..50) { self.slot = p; }

// STORE-SIDE INTERVAL PROPAGATION: storing a COMPUTED sum `self.sum = i + j` into a bounded field
// `sum: i32 in 0..100` owes `i+j < 100`, discharged from the operand ranges (i: 0..8, j: 0..8 -> i+j < 16
// <= 100) by the SAME banked additive-comp lemma the array-index case uses. The store path routes the stored
// value through prove_lt_bound, so the value-domain `+` reasoning is shared between reads (arr[i+j]) and
// writes (f = i+j) with no extra code -- and this is the WEAKENING path (16 < 100).
data Acc { sum: i32 in 0..100; }
machine Acc::add2(&mut self, i: i32 in 0..8, j: i32 in 0..8) { self.sum = i + j; }
// RANGE-REFINED RETURN (Omega's BoundedStateReturn / output contract): `-> i32 in 0..100` makes every
// `return e` owe `e < 100`. `rlit` returns a literal (ground); `rparam` returns a range-typed parameter,
// weakening its type's `p < 50` to `p < 100` via lt-le-trans -- so callers can RELY on the declared range.
machine rlit() -> i32 in 0..100 { return 42; }
machine rparam(p: i32 in 0..50) -> i32 in 0..100 { return p; }
// RANGE-TYPED LOCAL with value-domain FLOW: a never-reassigned `let x: i32 in 0..16 = i` equals `i`
// throughout, so `self.data[x]` discharges its array-bounds obligation `x < 16` through i's range -- the
// computed index carries its domain. (The let's own initializer obligation `i < 16` is discharged too.)
data Buf { data: [u8; 16]; }
machine Buf::atidx(&mut self, i: i32 in 0..16) -> i32 { let x: i32 in 0..16 = i; return self.data[x]; }
// VALUE-DOMAIN PROPAGATION for `+` (Omega's interval reasoning): a COMPUTED index `self.cells[i+j]` with
// i: 0..2, j: 0..3 into a 5-cell array proves `i+j < 5` from the operand types, via the banked additive-comp
// lemma (x<A & y<B => x+y<A+B). Memory safety for a computed index -- the sum of two bounded values is bounded.
data Grid { cells: [u8; 5]; }
machine Grid::at(&mut self, i: i32 in 0..2, j: i32 in 0..3) -> i32 { return self.cells[i + j]; }

// INTERVAL WEAKENING (A+B < len, the common slack-sized case): same operand bounds (i: 0..2, j: 0..3, so
// i+j < 5) but a LARGER 8-cell array. `i+j < 8` is proven by weakening `i+j < 5` up through the banked
// lt-le-trans and a ground `5 <= 8` fact -- arrays needn't be sized to the exact operand-bound sum.
data Pad { cells: [u8; 8]; }
machine Pad::at(&mut self, i: i32 in 0..2, j: i32 in 0..3) -> i32 { return self.cells[i + j]; }

// EXPRESSION CALL ARGUMENT (a + k via commutativity): fwd_off promises `a >= 0` and calls
// needs3(a + 3), where needs3 requires its argument >= 3. The obligation `(a+3) >= 3` is not ground
// (a is a parameter) but holds whenever a >= 0 -- so it discharges CONDITIONALLY on fwd_off's own
// precondition: a+3 >= 3 because 3+a = a+3 (add-commutes) and a >= 0 is guaranteed at the call site.
machine needs3(x: i32) -> i32 requires x >= 3 { return x; }
machine fwd_off(a: i32) -> i32 requires a >= 0 { return needs3(a + 3); }

machine Main::main(&mut self) { let r: i32 = adds(20, 22); self.console.exit_process(r) }
