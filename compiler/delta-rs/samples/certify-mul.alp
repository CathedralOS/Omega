// CERTIFYING COMPILER, overflow safety by LINKING. A multiplication a*b is within a
// bound B*C whenever a<B and b<C -- the multiplication-overflow obligation. This
// compiler discharges it the verified way: it CITES the library theorem mult-overflow
// (forall a b B C. a<B & b<C -> a*b < B*C, shipped as use 66) and supplies only the two
// site premises. For inputs a b B C it emits the short linkage:
//   (app (app (inst (inst (inst (inst (use 66) a) b) B) C)  <proof a<B>)  <proof b<C>)
// A linker prepends the proof library; the trust anchor checks library + linkage. So a
// product's overflow safety is one cited theorem plus two one-line premise witnesses --
// the newest library theorem made load-bearing.
//   { lib.proof ; printf 'a b B C' | certify-mul ; } | check.exe  ->  accept
// Contract: a<B and b<C. (use id 66 is the linker contract.)
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    nums: [i32; 4]; ni: i32; cur: i32; wab: i32; wbc: i32; bad: i32; uv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// a premise proof  (wit (= (p av (s (v 0))) bv) wv (refl bv))   i.e. av < bv, witness wv
machine Main::emit_lt(&mut self, av: i32, bv: i32, wv: i32) {
    write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32);                // "(wit "
    write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);  // "(= (p "
    self.emit_nat(av);
    write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40); write_byte(118);
    write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(41); write_byte(32);    // " (s (v 0))) "
    self.emit_nat(bv);
    write_byte(41); write_byte(32);                                                                   // ") "
    self.emit_nat(wv);
    write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32); // " (refl "
    self.emit_nat(bv);
    write_byte(41); write_byte(41);                                                                   // "))"
}
machine Main::main(&mut self) {
    self.n = 0; self.ni = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> nxt() } }
    state nxt()   { transition self.ni < 4 { true -> sk()  false -> compute() } }
    state sk()    { transition self.pos < self.n { true -> skc()  false -> compute() } }
    state skc()   { transition self.buf[self.pos] < 48 { true -> ad()  false -> skh() } }
    state skh()   { transition self.buf[self.pos] > 57 { true -> ad()  false -> pn() } }
    state ad()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state pn()    { self.cur = 0; transition 0 { _ -> pd() } }
    state pd()    { transition self.buf[self.pos] < 48 { true -> pv()  false -> pdh() } }
    state pdh()   { transition self.buf[self.pos] > 57 { true -> pv()  false -> pa() } }
    state pa()    { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pd() } }
    state pv()    { self.nums[self.ni] = self.cur; self.ni = self.ni + 1; transition 0 { _ -> nxt() } }
    // premise witnesses + the overflow safety check (a<B and b<C)
    state compute(){
        self.wab = self.nums[2] - self.nums[0] - 1;   // a < B
        self.wbc = self.nums[3] - self.nums[1] - 1;   // b < C
        transition self.nums[0] < self.nums[2] { true -> ck2()  false -> rej() }
    }
    state ck2()    { transition self.nums[1] < self.nums[3] { true -> emit()  false -> rej() } }
    state rej()    { write_byte(117); write_byte(110); write_byte(115); write_byte(97); write_byte(102); write_byte(101); write_byte(10); self.console.exit_process(1) }
    state emit() {
        // goal:  (Exists (= (p (m a b) (s (v 0))) (m B C)))
        write_byte(40); write_byte(69); write_byte(120); write_byte(105); write_byte(115);
        write_byte(116); write_byte(115); write_byte(32); write_byte(40); write_byte(61); write_byte(32);
        write_byte(40); write_byte(112); write_byte(32); write_byte(40); write_byte(109); write_byte(32);   // "(Exists (= (p (m "
        self.emit_nat(self.nums[0]);
        write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40);
        write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(41);
        write_byte(32); write_byte(40); write_byte(109); write_byte(32);                                    // ") (s (v 0))) (m "
        self.emit_nat(self.nums[2]);
        write_byte(32);
        self.emit_nat(self.nums[3]);
        write_byte(41); write_byte(41); write_byte(41); write_byte(32);                                     // "))) "
        // proof:  (app (app (inst (inst (inst (inst (use 66) a) b) B) C) <a<B>) <b<C>)
        write_byte(40); write_byte(97); write_byte(112); write_byte(112); write_byte(32);
        write_byte(40); write_byte(97); write_byte(112); write_byte(112); write_byte(32);   // "(app (app "
        write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32);
        write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32);
        write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32);
        write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32);
        write_byte(40); write_byte(117); write_byte(115); write_byte(101); write_byte(32);
        write_byte(54); write_byte(54); write_byte(41); write_byte(32);                      // "(inst (inst (inst (inst (use 66) "
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.nums[2]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.nums[3]);
        write_byte(41); write_byte(32);                                                     // close 4 insts, " "
        self.emit_lt(self.nums[0], self.nums[2], self.wab);                                 // a < B
        write_byte(41); write_byte(32);                                                     // close app2, " "
        self.emit_lt(self.nums[1], self.nums[3], self.wbc);                                 // b < C
        write_byte(41);                                                                     // close app1
        self.console.exit_process(0)
    }
}
