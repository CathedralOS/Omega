machine Main::foldx9(&mut self) {        // fold self.fv into x9 (mirrors backend add_imm_to_x9: 0 / single / hi<<12 + lo)
    transition self.fv == 0 { true -> fxdone()  false -> fxsmall() }
    state fxsmall() { transition self.fv < 4096 { true -> fxone()  false -> fxhi() } }
    state fxone()   { self.p_addx9i(); self.v = self.fv; self.emit_int(); write_byte(10); transition 0 { _ -> fxdone() } }
    state fxhi()    { self.fhipart = self.fv / 4096; self.flopart = self.fv - self.fhipart * 4096; self.p_addx9i(); self.v = self.fhipart; self.emit_int(); write_byte(44); write_byte(32); write_byte(108); write_byte(115); write_byte(108); write_byte(32); write_byte(35); write_byte(49); write_byte(50); write_byte(10); transition self.flopart > 0 { true -> fxlo()  false -> fxdone() } }
    state fxlo()    { self.p_addx9i(); self.v = self.flopart; self.emit_int(); write_byte(10); transition 0 { _ -> fxdone() } }
    state fxdone()  { }
}
