// SELF-HOSTING / CODEGEN: a COMPLETE transition -- fuses the subject lowering (lowersubj) with the
// arm dispatch (armdispatch). Phase 0 collects the field table (scalar fields, offset = 8*index),
// phase 1 the state labels (Lm<mi>s<si>), phase 2 lowers the first transition: the SUBJECT (a literal
// `movz w0,#v` / push, OR a `self.field` load `ldr x9,[x29,#16]; ldr w0,[x9,#off]` / push) then the
// subject-pop and per-arm dispatch -- exactly the backend's Transition lowering (src/aarch64.rs):
//     ldr x0, [sp], #16              pop the subject
//   per value arm  (true=1, false=0, N):
//     movz w1, #<value> / cmp w0, w1 / b.eq Lm<mi>s<target>
//   per wild arm `_`:
//     b Lm<mi>s<target>
// Combined with lowersubj (the subject), this is a complete transition. Single-machine inputs
// (mi 0) for verification; the target is resolved via the state table by name.
//   ... transition self.x { true -> a() false -> b() } state a(){} state b(){} ...
//     -> pop / movz w1,#1; cmp; b.eq Lm0s0 / movz w1,#0; cmp; b.eq Lm0s1
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main {
    console: Console;
    n: i32; pos: i32; c: i32; start: i32; w: i32; pend: i32; phase: i32; depth: i32; mi: i32; si: i32;
    ps: i32; pe: i32; kind: i32; val: i32; cj: i32; tsi: i32; tmi: i32; found: i32; v: i32; di: i32; ek: i32;
    nf: i32; dp: i32; ind: i32; expf: i32; fs: i32; fe: i32; foff: i32; sval: i32; lsi: i32; opnd: i32; cc: i32; mode: i32; laoff: i32; ns: i32;
    aoff: i32; acnt: i32; aeb: i32; omode: i32; oopnd: i32; astore: i32; aidx: i32; rpos: i32; fv: i32; fhipart: i32; flopart: i32; aop: i32; nstr: i32; wlstart: i32; wllen: i32;
    osp: i32; naop: i32; ncc: i32; nprec: i32; opret: i32; usesio: i32; lstri: i32; wrap: i32; sacnt: i32; saeb: i32; saoff: i32; callmode: i32; ocmode: i32; ocopnd: i32; stoff: i32; stcnt: i32; steb: i32; opaop: [i32; 16]; opcc: [i32; 16]; opprec: [i32; 16];
    coff: i32; dsize: i32; foffs: [i32; 256]; fcnt: [i32; 256]; feb: [i32; 256]; fdom: [i32; 256];
    lc: i32; frame: i32; sd: i32; nl: i32; lpend: i32; ldisp: i32; lstgt: i32; lns: [i32; 32]; lne: [i32; 32]; lmi: [i32; 32]; plidx: [i32; 32]; lcs: [i32; 64];
    vns: [i32; 32]; vne: [i32; 32]; vtag: [i32; 32]; nv: i32; vcc: i32;
    spls: [i32; 3072]; skl: i32; eskl: i32;
    etn: [i32; 32]; etne: [i32; 32]; etsz: [i32; 32]; ne: i32; cei: i32; cdtns: i32; cdtne: i32; fc: i32;
    bns: [i32; 8]; bne: [i32; 8]; bndoff: [i32; 8]; nb: i32; subjoff: i32; payidx: i32; unegate: i32;
    apbase: i32; aix: i32; scc: i32; mmk: i32;
    mn: i32; mdecl: i32; cmi: i32; emi: i32; lastws: i32; lastwe: i32; argc: i32; insig: i32; cp: i32; np: i32; pcs: [i32; 64]; hsf: [i32; 64]; mns: [i32; 64]; mne: [i32; 64];
    pns: [i32; 64]; pne: [i32; 64]; pmi: [i32; 64]; ppidx: [i32; 64];
    fns: [i32; 256]; fne: [i32; 256];
    sns: [i32; 3072]; sne: [i32; 3072]; smi: [i32; 3072]; ssi: [i32; 3072];
    qa: i32; qb: i32; qc: i32; qd: i32; qk: i32;
    dig: [i32; 16];
    buf: [u8; 262144];
}
machine Main::is_word(&mut self, c: i32) -> i32 {
    transition c == 95 { true -> yes()  false -> w1() }
    state w1() { transition c < 48  { true -> no()  false -> w2() } }
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }
    state w3() { transition c < 65  { true -> no()  false -> w4() } }
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }
    state w5() { transition c < 97  { true -> no()  false -> w6() } }
    state w6() { transition c <= 122 { true -> yes() false -> no() } }
    state yes() { return 1; }
    state no()  { return 0; }
}
machine Main::is_state(&mut self, s: i32, e: i32) -> i32 {     // "state"
    transition e - s == 5 { true -> k0()  false -> kno() }
    state k0() { transition self.buf[s]     == 115 { true -> k1()  false -> kno() } }
    state k1() { transition self.buf[s + 1] == 116 { true -> k2()  false -> kno() } }
    state k2() { transition self.buf[s + 2] == 97  { true -> k3()  false -> kno() } }
    state k3() { transition self.buf[s + 3] == 116 { true -> k4()  false -> kno() } }
    state k4() { transition self.buf[s + 4] == 101 { true -> kyes() false -> kno() } }
    state kyes() { return 1; }
    state kno()  { return 0; }
}
machine Main::is_machine(&mut self, s: i32, e: i32) -> i32 {   // "machine"
    transition e - s == 7 { true -> m0()  false -> mno() }
    state m0() { transition self.buf[s]     == 109 { true -> m1()  false -> mno() } }
    state m1() { transition self.buf[s + 1] == 97  { true -> m2()  false -> mno() } }
    state m2() { transition self.buf[s + 2] == 99  { true -> m3()  false -> mno() } }
    state m3() { transition self.buf[s + 3] == 104 { true -> m4()  false -> mno() } }
    state m4() { transition self.buf[s + 4] == 105 { true -> m5()  false -> mno() } }
    state m5() { transition self.buf[s + 5] == 110 { true -> m6()  false -> mno() } }
    state m6() { transition self.buf[s + 6] == 101 { true -> myes() false -> mno() } }
    state myes() { return 1; }
    state mno()  { return 0; }
}
machine Main::is_trans(&mut self, s: i32, e: i32) -> i32 {    // "transition"
    transition e - s == 10 { true -> t0()  false -> tno() }
    state t0() { transition self.buf[s]     == 116 { true -> t1()  false -> tno() } }
    state t1() { transition self.buf[s + 1] == 114 { true -> t2()  false -> tno() } }
    state t2() { transition self.buf[s + 2] == 97  { true -> t3()  false -> tno() } }
    state t3() { transition self.buf[s + 3] == 110 { true -> t4()  false -> tno() } }
    state t4() { transition self.buf[s + 4] == 115 { true -> t5()  false -> tno() } }
    state t5() { transition self.buf[s + 5] == 105 { true -> t6()  false -> tno() } }
    state t6() { transition self.buf[s + 6] == 116 { true -> t7()  false -> tno() } }
    state t7() { transition self.buf[s + 7] == 105 { true -> t8()  false -> tno() } }
    state t8() { transition self.buf[s + 8] == 111 { true -> t9()  false -> tno() } }
    state t9() { transition self.buf[s + 9] == 110 { true -> tyes() false -> tno() } }
    state tyes() { return 1; }
    state tno()  { return 0; }
}
machine Main::is_true(&mut self, s: i32, e: i32) -> i32 {     // "true"
    transition e - s == 4 { true -> a0()  false -> ano() }
    state a0() { transition self.buf[s]     == 116 { true -> a1()  false -> ano() } }
    state a1() { transition self.buf[s + 1] == 114 { true -> a2()  false -> ano() } }
    state a2() { transition self.buf[s + 2] == 117 { true -> a3()  false -> ano() } }
    state a3() { transition self.buf[s + 3] == 101 { true -> ayes() false -> ano() } }
    state ayes() { return 1; }
    state ano()  { return 0; }
}
machine Main::is_false(&mut self, s: i32, e: i32) -> i32 {    // "false"
    transition e - s == 5 { true -> f0()  false -> fno() }
    state f0() { transition self.buf[s]     == 102 { true -> f1()  false -> fno() } }
    state f1() { transition self.buf[s + 1] == 97  { true -> f2()  false -> fno() } }
    state f2() { transition self.buf[s + 2] == 108 { true -> f3()  false -> fno() } }
    state f3() { transition self.buf[s + 3] == 115 { true -> f4()  false -> fno() } }
    state f4() { transition self.buf[s + 4] == 101 { true -> fyes() false -> fno() } }
    state fyes() { return 1; }
    state fno()  { return 0; }
}
machine Main::streq(&mut self) -> i32 {     // buf[qa..qb) == buf[qc..qd)
    transition self.qb - self.qa == self.qd - self.qc { true -> q0()  false -> qno() }
    state q0()  { self.qk = 0; transition 0 { _ -> ql() } }
    state ql()  { transition self.qa + self.qk < self.qb { true -> qc2()  false -> qyes() } }
    state qc2() { transition self.buf[self.qa + self.qk] == self.buf[self.qc + self.qk] { true -> qa2()  false -> qno() } }
    state qa2() { self.qk = self.qk + 1; transition 0 { _ -> ql() } }
    state qyes(){ return 1; }
    state qno() { return 0; }
}
machine Main::emit_int(&mut self) {
    transition self.v == 0 { true -> z()  false -> ex0() }
    state z()    { write_byte(48); }
    state ex0()  { self.di = 0; transition 0 { _ -> exl() } }
    state exl()  { transition self.v > 0 { true -> ex()  false -> em0() } }
    state ex()   { self.dig[self.di] = self.v - (self.v / 10) * 10; self.v = self.v / 10; self.di = self.di + 1; transition 0 { _ -> exl() } }
    state em0()  { self.ek = self.di; transition 0 { _ -> eml() } }
    state eml()  { transition self.ek > 0 { true -> emd()  false -> ed() } }
    state emd()  { write_byte(48 + self.dig[self.ek - 1]); self.ek = self.ek - 1; transition 0 { _ -> eml() } }
    state ed()   { }
}
machine Main::p_movw1(&mut self) {       // "    movz w1, #"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(109); transition 0 { _ -> b4() } }
    state b4(){ write_byte(111); transition 0 { _ -> b5() } }
    state b5(){ write_byte(118); transition 0 { _ -> b6() } }
    state b6(){ write_byte(122); transition 0 { _ -> b7() } }
    state b7(){ write_byte(32);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(119); transition 0 { _ -> b9() } }
    state b9(){ write_byte(49);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(44);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(32);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(35); }
}
machine Main::p_beq(&mut self) {          // "    b.eq Lm"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(98);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(46);  transition 0 { _ -> b5() } }
    state b5(){ write_byte(101); transition 0 { _ -> b6() } }
    state b6(){ write_byte(113); transition 0 { _ -> b7() } }
    state b7(){ write_byte(32);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(76);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(109); }
}
machine Main::p_b(&mut self) {            // "    b Lm"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(98);  transition 0 { _ -> b4() } }
    state b4(){ write_byte(32);  transition 0 { _ -> b5() } }
    state b5(){ write_byte(76);  transition 0 { _ -> b6() } }
    state b6(){ write_byte(109); }
}
machine Main::p_bnesk(&mut self) {        // "    b.ne Lsk"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(98);  transition 0 { _ -> b4() } }   // 'b'
    state b4(){ write_byte(46);  transition 0 { _ -> b5() } }   // '.'
    state b5(){ write_byte(110); transition 0 { _ -> b6() } }   // 'n'
    state b6(){ write_byte(101); transition 0 { _ -> b7() } }   // 'e'
    state b7(){ write_byte(32);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(76);  transition 0 { _ -> b9() } }   // 'L'
    state b9(){ write_byte(115); transition 0 { _ -> b10() } }  // 's'
    state b10(){ write_byte(107); }                             // 'k'
}
machine Main::p_lsk(&mut self) {          // "Lsk"
    write_byte(76);  transition 0 { _ -> b0() }   // 'L'
    state b0(){ write_byte(115); transition 0 { _ -> b1() } }   // 's'
    state b1(){ write_byte(107); }                              // 'k'
}
machine Main::emit_lab(&mut self) {       // <mi> 's' <tsi> then newline   (after p_b/p_beq emitted "Lm")
    self.v = self.tmi; self.emit_int(); write_byte(115);
    self.v = self.tsi; self.emit_int(); write_byte(10)
}
machine Main::is_data(&mut self, s: i32, e: i32) -> i32 {     // "data"
    transition e - s == 4 { true -> d0()  false -> dno() }
    state d0() { transition self.buf[s]     == 100 { true -> d1()  false -> dno() } }
    state d1() { transition self.buf[s + 1] == 97  { true -> d2()  false -> dno() } }
    state d2() { transition self.buf[s + 2] == 116 { true -> d3()  false -> dno() } }
    state d3() { transition self.buf[s + 3] == 97  { true -> dyes() false -> dno() } }
    state dyes() { return 1; }
    state dno()  { return 0; }
}
machine Main::p_movw0(&mut self) {       // "    movz w0, #"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(109); transition 0 { _ -> b4() } }
    state b4(){ write_byte(111); transition 0 { _ -> b5() } }
    state b5(){ write_byte(118); transition 0 { _ -> b6() } }
    state b6(){ write_byte(122); transition 0 { _ -> b7() } }
    state b7(){ write_byte(32);  transition 0 { _ -> b8() } }
    state b8(){ write_byte(119); transition 0 { _ -> b9() } }
    state b9(){ write_byte(48);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(44);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(32);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(35); }
}
machine Main::p_ldrw0(&mut self) {       // "    ldr w0, [x9, #"
    write_byte(32);  transition 0 { _ -> b0() }
    state b0(){ write_byte(32);  transition 0 { _ -> b1() } }
    state b1(){ write_byte(32);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(32);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(108); transition 0 { _ -> b4() } }
    state b4(){ write_byte(100); transition 0 { _ -> b5() } }
    state b5(){ write_byte(114); transition 0 { _ -> b6() } }
    state b6(){ write_byte(32);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(119); transition 0 { _ -> b8() } }
    state b8(){ write_byte(48);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(44);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(32);  transition 0 { _ -> bb() } }
    state bb(){ write_byte(91);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(120); transition 0 { _ -> bd() } }
    state bd(){ write_byte(57);  transition 0 { _ -> be() } }
    state be(){ write_byte(44);  transition 0 { _ -> bf() } }
    state bf(){ write_byte(32);  transition 0 { _ -> bg() } }
    state bg(){ write_byte(35); }
}
machine Main::is_boundary(&mut self, s: i32, e: i32) -> i32 {  // "boundary"
    transition e - s == 8 { true -> y0()  false -> yno() }
    state y0() { transition self.buf[s]     == 98  { true -> y1()  false -> yno() } }
    state y1() { transition self.buf[s + 1] == 111 { true -> y2()  false -> yno() } }
    state y2() { transition self.buf[s + 2] == 117 { true -> y3()  false -> yno() } }
    state y3() { transition self.buf[s + 3] == 110 { true -> y4()  false -> yno() } }
    state y4() { transition self.buf[s + 4] == 100 { true -> y5()  false -> yno() } }
    state y5() { transition self.buf[s + 5] == 97  { true -> y6()  false -> yno() } }
    state y6() { transition self.buf[s + 6] == 114 { true -> y7()  false -> yno() } }
    state y7() { transition self.buf[s + 7] == 121 { true -> yyes() false -> yno() } }
    state yyes() { return 1; }
    state yno()  { return 0; }
}
machine Main::is_u8(&mut self, s: i32, e: i32) -> i32 {       // "u8"
    transition e - s == 2 { true -> u0()  false -> uno() }
    state u0() { transition self.buf[s]     == 117 { true -> u1()  false -> uno() } }
    state u1() { transition self.buf[s + 1] == 56  { true -> uyes() false -> uno() } }
    state uyes() { return 1; }
    state uno()  { return 0; }
}
machine Main::is_let(&mut self, s: i32, e: i32) -> i32 {      // "let"
    transition e - s == 3 { true -> l0()  false -> lno() }
    state l0() { transition self.buf[s]     == 108 { true -> l1()  false -> lno() } }
    state l1() { transition self.buf[s + 1] == 101 { true -> l2()  false -> lno() } }
    state l2() { transition self.buf[s + 2] == 116 { true -> lyes() false -> lno() } }
    state lyes() { return 1; }
    state lno()  { return 0; }
}
machine Main::is_case(&mut self, s: i32, e: i32) -> i32 {     // "case"
    transition e - s == 4 { true -> cs0()  false -> csno() }
    state cs0() { transition self.buf[s]     == 99  { true -> cs1()  false -> csno() } }  // 'c'
    state cs1() { transition self.buf[s + 1] == 97  { true -> cs2()  false -> csno() } }  // 'a'
    state cs2() { transition self.buf[s + 2] == 115 { true -> cs3()  false -> csno() } }  // 's'
    state cs3() { transition self.buf[s + 3] == 101 { true -> csyes() false -> csno() } } // 'e'
    state csyes(){ return 1; }
    state csno() { return 0; }
}
machine Main::is_wbyte(&mut self, s: i32, e: i32) -> i32 {    // "write_byte"
    transition e - s == 10 { true -> wz0()  false -> wzn() }
    state wz0() { transition self.buf[s]     == 119 { true -> wz1()  false -> wzn() } }
    state wz1() { transition self.buf[s + 1] == 114 { true -> wz2()  false -> wzn() } }
    state wz2() { transition self.buf[s + 2] == 105 { true -> wz3()  false -> wzn() } }
    state wz3() { transition self.buf[s + 3] == 116 { true -> wz4()  false -> wzn() } }
    state wz4() { transition self.buf[s + 4] == 101 { true -> wz5()  false -> wzn() } }
    state wz5() { transition self.buf[s + 5] == 95  { true -> wz6()  false -> wzn() } }
    state wz6() { transition self.buf[s + 6] == 98  { true -> wz7()  false -> wzn() } }
    state wz7() { transition self.buf[s + 7] == 121 { true -> wz8()  false -> wzn() } }
    state wz8() { transition self.buf[s + 8] == 116 { true -> wz9()  false -> wzn() } }
    state wz9() { transition self.buf[s + 9] == 101 { true -> wzy()  false -> wzn() } }
    state wzy()  { return 1; }
    state wzn()  { return 0; }
}
machine Main::is_rbyte(&mut self, s: i32, e: i32) -> i32 {    // "read_byte"
    transition e - s == 9 { true -> rz0()  false -> rzn() }
    state rz0() { transition self.buf[s]     == 114 { true -> rz1()  false -> rzn() } }
    state rz1() { transition self.buf[s + 1] == 101 { true -> rz2()  false -> rzn() } }
    state rz2() { transition self.buf[s + 2] == 97  { true -> rz3()  false -> rzn() } }
    state rz3() { transition self.buf[s + 3] == 100 { true -> rz4()  false -> rzn() } }
    state rz4() { transition self.buf[s + 4] == 95  { true -> rz5()  false -> rzn() } }
    state rz5() { transition self.buf[s + 5] == 98  { true -> rz6()  false -> rzn() } }
    state rz6() { transition self.buf[s + 6] == 121 { true -> rz7()  false -> rzn() } }
    state rz7() { transition self.buf[s + 7] == 116 { true -> rz8()  false -> rzn() } }
    state rz8() { transition self.buf[s + 8] == 101 { true -> rzy()  false -> rzn() } }
    state rzy()  { return 1; }
    state rzn()  { return 0; }
}
machine Main::is_minmax(&mut self, s: i32, e: i32) -> i32 {    // "min" -> 1, "max" -> 2, else 0
    transition e - s == 3 { true -> mmz0()  false -> mmzn() }
    state mmz0() { transition self.buf[s] == 109 { true -> mmz1()  false -> mmzn() } }        // 'm'
    state mmz1() { transition self.buf[s + 1] == 105 { true -> mmzi()  false -> mmza() } }    // 'i' -> min, else check 'a'
    state mmzi() { transition self.buf[s + 2] == 110 { true -> mmymin()  false -> mmzn() } }  // 'n'
    state mmza() { transition self.buf[s + 1] == 97 { true -> mmza2()  false -> mmzn() } }    // 'a'
    state mmza2(){ transition self.buf[s + 2] == 120 { true -> mmymax()  false -> mmzn() } }  // 'x'
    state mmymin(){ return 1; }
    state mmymax(){ return 2; }
    state mmzn()  { return 0; }
}
machine Main::is_exitp(&mut self, s: i32, e: i32) -> i32 {    // "exit_process"
    transition e - s == 12 { true -> ez0()  false -> ezn() }
    state ez0() { transition self.buf[s]      == 101 { true -> ez1()  false -> ezn() } }
    state ez1() { transition self.buf[s + 1]  == 120 { true -> ez2()  false -> ezn() } }
    state ez2() { transition self.buf[s + 2]  == 105 { true -> ez3()  false -> ezn() } }
