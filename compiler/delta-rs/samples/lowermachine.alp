machine Main::p_spsuf(&mut self) {       // ", [sp], #16"
    write_byte(44); transition 0 { _ -> b1() }
    state b1(){ write_byte(32); transition 0 { _ -> b2() } }  state b2(){ write_byte(91);  transition 0 { _ -> b3() } }
    state b3(){ write_byte(115); transition 0 { _ -> b4() } } state b4(){ write_byte(112); transition 0 { _ -> b5() } }
    state b5(){ write_byte(93);  transition 0 { _ -> b6() } } state b6(){ write_byte(44);  transition 0 { _ -> b7() } }
    state b7(){ write_byte(32);  transition 0 { _ -> b8() } } state b8(){ write_byte(35);  transition 0 { _ -> b9() } }
    state b9(){ write_byte(49);  transition 0 { _ -> ba() } } state ba(){ write_byte(54); }
}
machine Main::p_ldrx0x29(&mut self) {    // "    ldr x0, [x29, #"
    write_byte(32); transition 0 { _ -> b0() }
    state b0(){ write_byte(32); transition 0 { _ -> b1() } }  state b1(){ write_byte(32); transition 0 { _ -> b2() } }
    state b2(){ write_byte(32); transition 0 { _ -> b3() } }  state b3(){ write_byte(108); transition 0 { _ -> b4() } }
    state b4(){ write_byte(100); transition 0 { _ -> b5() } } state b5(){ write_byte(114); transition 0 { _ -> b6() } }
    state b6(){ write_byte(32);  transition 0 { _ -> b7() } } state b7(){ write_byte(120); transition 0 { _ -> b8() } }
    state b8(){ write_byte(48);  transition 0 { _ -> b9() } } state b9(){ write_byte(44);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(32);  transition 0 { _ -> bb() } } state bb(){ write_byte(91);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(120); transition 0 { _ -> bd() } } state bd(){ write_byte(50);  transition 0 { _ -> be() } }
    state be(){ write_byte(57);  transition 0 { _ -> bf() } } state bf(){ write_byte(44);  transition 0 { _ -> bg() } }
    state bg(){ write_byte(32);  transition 0 { _ -> bh() } } state bh(){ write_byte(35); }
}
machine Main::p_bl(&mut self) {          // "    bl "
    write_byte(32); transition 0 { _ -> b0() }
    state b0(){ write_byte(32); transition 0 { _ -> b1() } }  state b1(){ write_byte(32); transition 0 { _ -> b2() } }
    state b2(){ write_byte(32); transition 0 { _ -> b3() } }  state b3(){ write_byte(98); transition 0 { _ -> b4() } }
    state b4(){ write_byte(108); transition 0 { _ -> b5() } } state b5(){ write_byte(32); }
}
machine Main::p_lmachine(&mut self) {     // "Lmachine"  (non-entry label, column 0)
    write_byte(76);  transition 0 { _ -> b0() }
    state b0(){ write_byte(109); transition 0 { _ -> b1() } } state b1(){ write_byte(97);  transition 0 { _ -> b2() } }
    state b2(){ write_byte(99);  transition 0 { _ -> b3() } } state b3(){ write_byte(104); transition 0 { _ -> b4() } }
    state b4(){ write_byte(105); transition 0 { _ -> b5() } } state b5(){ write_byte(110); transition 0 { _ -> b6() } }
    state b6(){ write_byte(101); }
}
machine Main::p_strx0x29(&mut self) {     // "    str x0, [x29, #"
    write_byte(32); transition 0 { _ -> b0() }
    state b0(){ write_byte(32); transition 0 { _ -> b1() } }  state b1(){ write_byte(32); transition 0 { _ -> b2() } }
    state b2(){ write_byte(32); transition 0 { _ -> b3() } }  state b3(){ write_byte(115); transition 0 { _ -> b4() } }
    state b4(){ write_byte(116); transition 0 { _ -> b5() } } state b5(){ write_byte(114); transition 0 { _ -> b6() } }
    state b6(){ write_byte(32);  transition 0 { _ -> b7() } } state b7(){ write_byte(120); transition 0 { _ -> b8() } }
    state b8(){ write_byte(48);  transition 0 { _ -> b9() } } state b9(){ write_byte(44);  transition 0 { _ -> ba() } }
    state ba(){ write_byte(32);  transition 0 { _ -> bb() } } state bb(){ write_byte(91);  transition 0 { _ -> bc() } }
    state bc(){ write_byte(120); transition 0 { _ -> bd() } } state bd(){ write_byte(50);  transition 0 { _ -> be() } }
    state be(){ write_byte(57);  transition 0 { _ -> bf() } } state bf(){ write_byte(44);  transition 0 { _ -> bg() } }
    state bg(){ write_byte(32);  transition 0 { _ -> bh() } } state bh(){ write_byte(35); }
}
machine Main::emit_prologue(&mut self) {
    transition self.mi == self.emi { true -> ent()  false -> non() }
    state ent() { self.console.write_line("_main:"); transition 0 { _ -> common() } }
    state non() { self.p_lmachine(); self.v = self.mi; self.emit_int(); write_byte(58); write_byte(10); transition 0 { _ -> common() } }
    state common() {
        self.p_subsp(); self.v = self.frame; self.emit_int(); write_byte(10);
        self.console.write_line("    stp x29, x30, [sp]");
        self.console.write_line("    mov x29, sp");
        transition self.mi == self.emi { true -> selfent()  false -> selfnon() }
    }
    state selfent() { transition self.dsize > 0 { true -> selfent2()  false -> pdone() } }   // empty self (struct has only the console boundary): no _selfdata to point at, skip the init
    state selfent2() {
        self.console.write_line("    adrp x9, _selfdata@PAGE");
        self.console.write_line("    add x9, x9, _selfdata@PAGEOFF");
        self.p_strx9(); self.v = self.sd; self.emit_int(); write_byte(93); write_byte(10);
        transition 0 { _ -> pdone() }
    }
    state selfnon() { self.cj = 1; transition 0 { _ -> spar() } }
    state spar()  { transition self.cj <= self.cp { true -> spar1()  false -> snself() } }
    state spar1() { self.p_strw(); self.v = self.cj - 1 + self.hsf[self.mi]; self.emit_int(); self.p_x29suf(); self.v = 8 + 8 * self.cj; self.emit_int(); write_byte(93); write_byte(10); self.cj = self.cj + 1; transition 0 { _ -> spar() } }
    state snself(){ transition self.hsf[self.mi] == 1 { true -> snself2()  false -> pdone() } }
    state snself2(){ self.p_strx0x29(); self.v = self.sd; self.emit_int(); write_byte(93); write_byte(10); transition 0 { _ -> pdone() } }
    state pdone() { }
}
machine Main::emit_epilogue(&mut self) {
    self.console.write_line("    mov w0, #0");
    self.console.write_line("    mov sp, x29");
    self.console.write_line("    ldp x29, x30, [sp]");
    self.p_addsp(); self.v = self.frame; self.emit_int(); write_byte(10);
    self.console.write_line("    ret")
}
machine Main::p_lm(&mut self) {          // "Lm"  (label def, column 0)
    write_byte(76);  transition 0 { _ -> b0() }
    state b0(){ write_byte(109); }
}
machine Main::main(&mut self) {
    self.n = 0; self.phase = 0; self.depth = 0; self.mi = 0 - 1; self.si = 0; self.pend = 0; self.nf = 0; self.dp = 0; self.ind = 0; self.expf = 0; self.nl = 0; self.lpend = 0; self.ns = 0; self.mn = 0; self.mdecl = 0; self.insig = 0; self.np = 0; self.emi = 0; self.nstr = 0; self.osp = 0; self.usesio = 0; self.skl = 0; self.ne = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> scan()  false -> store() } }
    state store() { transition self.n < 1024 * 256 { true -> store2()  false -> source_too_large() } }
    state store2(){ self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state source_too_large() { self.console.exit_process(2) }
    state scan()  { self.pos = 0; transition 0 { _ -> sk() } }
    state sk()    { self.wrap = 0; transition self.pos < self.n { true -> ws()  false -> endph() } }
    state ws()    { transition self.buf[self.pos] <= 32 { true -> wadv()  false -> cm() } }
    state wadv()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state cm()    { transition self.buf[self.pos] == 47 { true -> cm2()  false -> str0() } }
    state cm2()   { transition self.buf[self.pos + 1] == 47 { true -> cms()  false -> str0() } }
    state cms()   { transition self.pos < self.n { true -> cnl()  false -> endph() } }
    state cnl()   { transition self.buf[self.pos] == 10 { true -> wadv()  false -> cadv() } }
    state cadv()  { self.pos = self.pos + 1; transition 0 { _ -> cms() } }
    state str0()  { transition self.buf[self.pos] == 34 { true -> stra()  false -> tok() } }
    state stra()  { self.pos = self.pos + 1; transition 0 { _ -> ssx() } }
    state ssx()   { transition self.pos < self.n { true -> ss2()  false -> endph() } }
    state ss2()   { transition self.buf[self.pos] == 34 { true -> wadv()  false -> ssa() } }
    state ssa()   { self.pos = self.pos + 1; transition 0 { _ -> ssx() } }
    state tok()   { transition self.phase == 0 { true -> tok0()  false -> tok12() } }
    state tok12() { transition self.phase == 1 { true -> tok1()  false -> tok2() } }
    // ---- phase 0: collect the field table (scalar fields in decl order; offset = 8*index) ----
    state tok0()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word0()  false -> punc0() } }
    state word0() { self.start = self.pos; transition 0 { _ -> wr0() } }
    state wr0()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wa0()  false -> wc0() } }
    state wa0()   { self.pos = self.pos + 1; transition 0 { _ -> wr0() } }
    state wc0()   { self.w = self.is_data(self.start, self.pos); transition self.w == 1 { true -> setdp()  false -> wc0b() } }
    state setdp() { self.dp = 1; transition 0 { _ -> sk() } }
    state wc0b()  { transition self.dp == 1 { true -> captype()  false -> wc0bb() } }   // 'data NAME' -> capture NAME (for enum-field sizing)
    state captype(){ self.cdtns = self.start; self.cdtne = self.pos; self.cei = 0 - 1; transition 0 { _ -> sk() } }
    state wc0bb() { transition self.ind == 1 { true -> wc0c()  false -> sk() } }
    state wc0c()  { transition self.expf == 1 { true -> ckcase()  false -> ckdom() } }
    // a skipped type token of the last-parsed field: capture `in Wrapping`/`in Saturating` -> fdom[nf-1]
    state ckdom() { transition self.buf[self.start] == 87 { true -> ckdomw()  false -> ckdoms() } }   // 'W'
    state ckdomw(){ self.fdom[self.nf - 1] = 1; transition 0 { _ -> sk() } }
    state ckdoms(){ transition self.buf[self.start] == 83 { true -> ckdomsat()  false -> sk() } }       // 'S'
    state ckdomsat(){ self.fdom[self.nf - 1] = 2; transition 0 { _ -> sk() } }
    state ckcase()  { self.w = self.is_case(self.start, self.pos); transition self.w == 1 { true -> casev0()  false -> addF() } }   // 'case X;' enum variant, else a normal field
    state casev0()  { transition self.buf[self.pos] <= 32 { true -> casev0a()  false -> casev1() } }   // skip ws after 'case'
    state casev0a() { self.pos = self.pos + 1; transition 0 { _ -> casev0() } }
    state casev1()  { self.qa = self.pos; transition 0 { _ -> casevr() } }                              // variant name start
    state casevr()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> caseva()  false -> casevd() } }
    state caseva()  { self.pos = self.pos + 1; transition 0 { _ -> casevr() } }
    state casevd()  { self.vns[self.nv] = self.qa; self.vne[self.nv] = self.pos; self.vtag[self.nv] = self.vcc; self.nv = self.nv + 1; self.vcc = self.vcc + 1; self.expf = 0; transition 0 { _ -> cpc0() } }
    // count this variant's payload fields (one per ':' in its `(...)`) and size the enum to the widest variant
    state cpc0()  { self.fc = 0; transition self.buf[self.pos] == 40 { true -> cpc1()  false -> regenum() } }   // '(' -> has payload
    state cpc1()  { self.pos = self.pos + 1; transition 0 { _ -> cpcscan() } }
    state cpcscan(){ transition self.buf[self.pos] == 41 { true -> regenum()  false -> cpcchk() } }   // ')' -> done counting
    state cpcchk(){ transition self.buf[self.pos] == 58 { true -> cpcinc()  false -> cpcadv() } }     // ':' -> one payload field
    state cpcinc(){ self.fc = self.fc + 1; self.pos = self.pos + 1; transition 0 { _ -> cpcscan() } }
    state cpcadv(){ self.pos = self.pos + 1; transition 0 { _ -> cpcscan() } }
    state regenum(){ transition self.cei == 0 - 1 { true -> regnew()  false -> regupd() } }   // first case of this enum -> register; else widen
    state regnew(){ self.etn[self.ne] = self.cdtns; self.etne[self.ne] = self.cdtne; self.etsz[self.ne] = 8 + 8 * self.fc; self.cei = self.ne; self.ne = self.ne + 1; transition 0 { _ -> sk() } }
    state regupd(){ transition 8 + 8 * self.fc > self.etsz[self.cei] { true -> regbig()  false -> sk() } }
    state regbig(){ self.etsz[self.cei] = 8 + 8 * self.fc; transition 0 { _ -> sk() } }
    state addF()  { self.fns[self.nf] = self.start; self.fne[self.nf] = self.pos; self.foffs[self.nf] = self.coff; self.fcnt[self.nf] = 0; self.feb[self.nf] = 0; self.fdom[self.nf] = 0; transition 0 { _ -> ftc() } }
    state ftc()   { transition self.buf[self.pos] == 58 { true -> ftc2()  false -> ftadv() } }     // skip to ':'
    state ftadv() { self.pos = self.pos + 1; transition 0 { _ -> ftc() } }
    state ftc2()  { self.pos = self.pos + 1; transition 0 { _ -> ftw() } }                          // past ':'
    state ftw()   { transition self.buf[self.pos] <= 32 { true -> ftw2()  false -> ftt() } }
    state ftw2()  { self.pos = self.pos + 1; transition 0 { _ -> ftw() } }
    state ftt()   { transition self.buf[self.pos] == 91 { true -> farr()  false -> ftt2() } }       // '[' -> array type
    state ftt2()  { transition self.buf[self.pos] <= 90 { true -> ftname()  false -> fscal() } }    // uppercase -> enum-or-boundary; else scalar
    state ftname(){ self.start = self.pos; transition 0 { _ -> ftnr() } }                            // capture the type name to look it up
    state ftnr()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> ftna()  false -> ftne() } }
    state ftna()  { self.pos = self.pos + 1; transition 0 { _ -> ftnr() } }
    state ftne()  { self.qa = self.start; self.qb = self.pos; self.cj = 0; transition 0 { _ -> ftelk() } }
    state ftelk() { transition self.cj < self.ne { true -> ftelkc()  false -> fbnd() } }             // not a known enum -> boundary (size 0)
    state ftelkc(){ self.qc = self.etn[self.cj]; self.qd = self.etne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> ftelkh()  false -> ftelkn() } }
    state ftelkh(){ self.coff = self.coff + self.etsz[self.cj]; transition 0 { _ -> fdone() } }      // enum field: reserve tag + widest payload
    state ftelkn(){ self.cj = self.cj + 1; transition 0 { _ -> ftelk() } }
    state fbnd()  { transition 0 { _ -> fdone() } }                                                 // boundary (Console): size 0
    state fscal() { self.coff = self.coff + 8; transition 0 { _ -> fdone() } }                      // scalar: 8
    state farr()  { self.pos = self.pos + 1; transition 0 { _ -> farw() } }                          // past '['
    state farw()  { transition self.buf[self.pos] <= 32 { true -> farw2()  false -> fare() } }
    state farw2() { self.pos = self.pos + 1; transition 0 { _ -> farw() } }
    state fare()  { self.start = self.pos; transition 0 { _ -> farr2() } }                           // capture element type
    state farr2() { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> fara()  false -> faret() } }
    state fara()  { self.pos = self.pos + 1; transition 0 { _ -> farr2() } }
    state faret() { self.w = self.is_u8(self.start, self.pos); transition self.w == 1 { true -> faeb1()  false -> faeb8() } }
    state faeb1() { self.feb[self.nf] = 1; transition 0 { _ -> facnt() } }
    state faeb8() { self.feb[self.nf] = 8; transition 0 { _ -> facnt() } }
    state facnt() { transition self.buf[self.pos] == 59 { true -> facn2()  false -> facadv() } }     // skip to ';' inside []
    state facadv(){ self.pos = self.pos + 1; transition 0 { _ -> facnt() } }
    state facn2() { self.pos = self.pos + 1; transition 0 { _ -> facw() } }                          // past ';'
    state facw()  { transition self.buf[self.pos] <= 32 { true -> facw2()  false -> facd() } }
    state facw2() { self.pos = self.pos + 1; transition 0 { _ -> facw() } }
    state facd()  { transition self.buf[self.pos] < 48 { true -> fasz()  false -> facd2() } }
    state facd2() { transition self.buf[self.pos] > 57 { true -> fasz()  false -> facacc() } }
    state facacc(){ self.fcnt[self.nf] = self.fcnt[self.nf] * 10 + self.buf[self.pos] - 48; self.pos = self.pos + 1; transition 0 { _ -> facw() } }
    state fasz()  { self.coff = self.coff + self.fcnt[self.nf] * self.feb[self.nf]; transition 0 { _ -> fdone() } }
    state fdone() { self.nf = self.nf + 1; self.expf = 0; transition 0 { _ -> sk() } }
    state punc0() { transition self.buf[self.pos] == 123 { true -> opn0()  false -> p0b() } }
    state opn0()  { transition self.dp == 1 { true -> opn0b()  false -> p0adv() } }
    state opn0b() { self.ind = 1; self.expf = 1; self.dp = 0; self.coff = 0; self.vcc = 0; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state p0b()   { transition self.buf[self.pos] == 125 { true -> cls0()  false -> p0c() } }
    state cls0()  { self.ind = 0; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state p0c()   { transition self.buf[self.pos] == 59 { true -> semi0()  false -> p0adv() } }
    state semi0() { transition self.ind == 1 { true -> semi0b()  false -> p0adv() } }
    state semi0b(){ self.expf = 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state p0adv() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    // ---- pass 1: collect state labels (mi over depth-0 machines, si over depth-1 states) ----
    state tok1()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word1()  false -> punc1() } }
    state punc1() { transition self.buf[self.pos] == 123 { true -> opn1()  false -> p1b() } }
    state opn1()  { self.depth = self.depth + 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state p1b()   { transition self.buf[self.pos] == 125 { true -> cls1()  false -> p1c() } }
    state p1c()   { transition self.buf[self.pos] == 40 { true -> mname()  false -> p1d() } }
    state p1d()   { transition self.buf[self.pos] == 58 { true -> colon()  false -> p1e() } }    // ':'
    state colon() { transition self.insig == 1 { true -> coln2()  false -> padv1() } }
    state coln2() { self.pns[self.np] = self.lastws; self.pne[self.np] = self.lastwe; self.pmi[self.np] = self.mi; self.ppidx[self.np] = self.pcs[self.mi]; self.np = self.np + 1; self.pcs[self.mi] = self.pcs[self.mi] + 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state p1e()   { transition self.buf[self.pos] == 41 { true -> rparen()  false -> padv1() } } // ')'
    state rparen(){ transition self.insig == 1 { true -> rpar2()  false -> padv1() } }
    state rpar2() { self.insig = 0; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state mname() { transition self.mdecl == 1 { true -> mrec()  false -> p1d() } }
    state mrec()  { self.mns[self.mi] = self.lastws; self.mne[self.mi] = self.lastwe; self.mn = self.mi + 1; self.mdecl = 0; self.insig = 1; transition self.lastwe - self.lastws == 4 { true -> mck0()  false -> mrecd() } }
    state mck0()  { transition self.buf[self.lastws] == 109 { true -> mck1()  false -> mrecd() } }
    state mck1()  { transition self.buf[self.lastws + 1] == 97 { true -> mck2()  false -> mrecd() } }
    state mck2()  { transition self.buf[self.lastws + 2] == 105 { true -> mck3()  false -> mrecd() } }
    state mck3()  { transition self.buf[self.lastws + 3] == 110 { true -> mckok()  false -> mrecd() } }
    state mckok() { self.emi = self.mi; transition 0 { _ -> mrecd() } }
    state mrecd() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state cls1()  { self.depth = self.depth - 1; self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state padv1() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state word1() { self.start = self.pos; transition 0 { _ -> wr1() } }
    state wr1()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wa1()  false -> wlw() } }
    state wlw()   { self.lastws = self.start; self.lastwe = self.pos; transition self.insig == 1 { true -> wsig()  false -> wc1() } }
    state wsig()  { self.w = self.is_self(self.start, self.pos); transition self.w == 1 { true -> wsig2()  false -> wc1() } }
    state wsig2() { self.hsf[self.mi] = 1; transition 0 { _ -> wc1() } }
    state wa1()   { self.pos = self.pos + 1; transition 0 { _ -> wr1() } }
    state wc1()   { transition self.pend == 1 { true -> addS()  false -> wc1b() } }
    state wc1b()  { transition self.lpend == 1 { true -> addL()  false -> ck1m() } }
    state addL()  { self.lns[self.nl] = self.start; self.lne[self.nl] = self.pos; self.lmi[self.nl] = self.mi; self.plidx[self.nl] = self.lcs[self.mi]; self.nl = self.nl + 1; self.lcs[self.mi] = self.lcs[self.mi] + 1; self.lpend = 0; transition 0 { _ -> sk() } }
    state addS()  { self.sns[self.ns] = self.start; transition 0 { _ -> addS2() } }
    state addS2() { self.sne[self.ns] = self.pos; self.smi[self.ns] = self.mi; self.ssi[self.ns] = self.si; self.spls[self.ns] = 0 - 1; transition 0 { _ -> ckspar() } }
    // state parameter: `state got(v: i32)` registers v as a machine local (slot after params), and
    // records spls[state] = that local's index so an arm `got(EXPR)` can store EXPR to it before branching.
    state ckspar(){ self.scc = 0; transition self.buf[self.pos] == 40 { true -> spar0()  false -> addSf() } }   // '(' -> params; reset the param counter
    state spar0() { self.pos = self.pos + 1; transition 0 { _ -> sparw() } }
    state sparw() { transition self.buf[self.pos] <= 32 { true -> sparws()  false -> sparck() } }
    state sparws(){ self.pos = self.pos + 1; transition 0 { _ -> sparw() } }
    state sparck(){ transition self.buf[self.pos] == 41 { true -> addSf()  false -> spar1() } }   // ')' -> empty params
    state spar1() { self.start = self.pos; transition 0 { _ -> sparr() } }
    state sparr() { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> spara()  false -> spare() } }
    state spara() { self.pos = self.pos + 1; transition 0 { _ -> sparr() } }
    state spare() { self.lns[self.nl] = self.start; self.lne[self.nl] = self.pos; self.lmi[self.nl] = self.mi; self.plidx[self.nl] = self.lcs[self.mi]; transition self.scc == 0 { true -> spsetf()  false -> sparx() } }   // each param is a consecutive local
    state spsetf(){ self.spls[self.ns] = self.lcs[self.mi]; transition 0 { _ -> sparx() } }   // the FIRST param's local index is spls[state]
    state sparx() { self.nl = self.nl + 1; self.lcs[self.mi] = self.lcs[self.mi] + 1; self.scc = self.scc + 1; transition 0 { _ -> sparnx() } }
    state sparnx(){ transition self.buf[self.pos] == 41 { true -> addSf()  false -> sparnc() } }   // ')' -> done
    state sparnc(){ transition self.buf[self.pos] == 44 { true -> sparcom()  false -> sparadv() } }   // ',' -> next param, else skip the ': type' chars
    state sparcom(){ self.pos = self.pos + 1; transition 0 { _ -> sparw() } }
    state sparadv(){ self.pos = self.pos + 1; transition 0 { _ -> sparnx() } }
    state addSf() { self.ns = self.ns + 1; self.si = self.si + 1; self.pend = 0; transition 0 { _ -> sk() } }
    state ck1m()  { self.w = self.is_machine(self.start, self.pos); transition self.w == 1 { true -> newM1()  false -> ck1l() } }
    state ck1l()  { self.w = self.is_let(self.start, self.pos); transition self.w == 1 { true -> setL1()  false -> ck1s() } }
    state setL1() { self.lpend = 1; transition 0 { _ -> sk() } }
    state newM1() { transition self.depth == 0 { true -> nm1()  false -> sk() } }
    state nm1()   { self.mi = self.mi + 1; self.si = 0; self.mdecl = 1; self.hsf[self.mi] = 0; transition 0 { _ -> sk() } }
    state ck1s()  { transition self.depth == 1 { true -> ck1s2()  false -> sk() } }
    state ck1s2() { self.w = self.is_state(self.start, self.pos); transition self.w == 1 { true -> setP1()  false -> sk() } }
    state setP1() { self.pend = 1; transition 0 { _ -> sk() } }
    // ---- pass 2: find the first `transition`, skip its subject, emit pop + arm dispatch ----
    state tok2()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> word2()  false -> padv2() } }
    state padv2() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state word2() { self.start = self.pos; transition 0 { _ -> wr2() } }
    state wr2()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> wa2()  false -> wc2() } }
    state wa2()   { self.pos = self.pos + 1; transition 0 { _ -> wr2() } }
    state wc2()   { self.w = self.is_boundary(self.start, self.pos); transition self.w == 1 { true -> bskip()  false -> wc2m() } }
    state wc2m()  { self.w = self.is_machine(self.start, self.pos); transition self.w == 1 { true -> nm2()  false -> ck2t() } }
    state bskip() { transition self.buf[self.pos] == 123 { true -> bskip2()  false -> bsadv() } }   // skip to '{'
    state bsadv() { self.pos = self.pos + 1; transition 0 { _ -> bskip() } }
    state bskip2(){ transition self.buf[self.pos] == 125 { true -> bskip3()  false -> bsadv2() } }   // skip to '}' (no nested braces in a boundary trait)
    state bsadv2(){ self.pos = self.pos + 1; transition 0 { _ -> bskip2() } }
    state bskip3(){ self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state nm2()   { transition self.mi < 0 { true -> nm2b()  false -> nm2a() } }   // emit previous machine's epilogue first (unless this is the first)
    state nm2a()  { self.emit_epilogue(); transition 0 { _ -> nm2b() } }
    state nm2b()  { self.mi = self.mi + 1; self.lsi = 0; self.cp = self.pcs[self.mi]; self.sd = 16 + 8 * (self.pcs[self.mi] + self.lcs[self.mi]); self.frame = (31 + 8 * self.hsf[self.mi] + 8 * (self.pcs[self.mi] + self.lcs[self.mi])) / 16 * 16; transition 0 { _ -> nm2c() } }
    state nm2c()  { self.emit_prologue(); transition 0 { _ -> sk() } }
    state ck2t()  { self.w = self.is_trans(self.start, self.pos); transition self.w == 1 { true -> subjinit()  false -> ck2s() } }
    state subjinit(){ self.mode = 0; self.opnd = 0; transition 0 { _ -> subj0() } }
    state ck2s()  { self.w = self.is_state(self.start, self.pos); transition self.w == 1 { true -> emitL()  false -> ck2self() } }
    state ck2self(){ self.w = self.is_self(self.start, self.pos); transition self.w == 1 { true -> asgn0()  false -> ck2let() } }
    state ck2let() { self.w = self.is_let(self.start, self.pos); transition self.w == 1 { true -> let0()  false -> ck2ret() } }
    state ck2ret() { self.w = self.is_return(self.start, self.pos); transition self.w == 1 { true -> ret0()  false -> ck2wb() } }
    state ck2wb()  { self.w = self.is_wbyte(self.start, self.pos); transition self.w == 1 { true -> wb0()  false -> ck2wl() } }
    state ck2wl()  { self.w = self.is_wline(self.start, self.pos); transition self.w == 1 { true -> wline()  false -> ckas() } }   // bare `write_line("...")` statement (reuses the qualified-call string emitter)
    state ckas()   { self.w = self.is_assert(self.start, self.pos); transition self.w == 1 { true -> asrt0()  false -> lasgn0() } }
    state asrt0()  { self.mode = 9; self.opnd = 0; transition 0 { _ -> subj0() } }   // lower the assert condition; mode 9 -> asrtemit (cbz w0, Ltrap)
    // local reassignment: `localname = expr` (bare ident; not self./let/return/write_byte). STRICT --
    // only fires when the ident resolves to a declared local AND is followed by '='; else -> sk (the
    // prior drop behavior). Reuses lstgt + mode 2 + ltStore, exactly like a `let` initializer store.
    state lasgn0(){ self.qa = self.start; self.qb = self.pos; self.cj = 0; transition 0 { _ -> lalk() } }
    state lalk()  { transition self.cj < self.nl { true -> lalkc()  false -> sk() } }
    state lalkc() { transition self.lmi[self.cj] == self.mi { true -> lalkc2()  false -> lalkn() } }
    state lalkc2(){ self.qc = self.lns[self.cj]; self.qd = self.lne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> lalkh()  false -> lalkn() } }
    state lalkh() { self.lstgt = 16 + 8 * (self.pcs[self.mi] + self.plidx[self.cj]); transition 0 { _ -> laeq() } }
    state lalkn() { self.cj = self.cj + 1; transition 0 { _ -> lalk() } }
    state laeq()  { transition self.buf[self.pos] <= 32 { true -> laeqa()  false -> laeqck() } }   // skip ws to '='
    state laeqa() { self.pos = self.pos + 1; transition 0 { _ -> laeq() } }
    state laeqck(){ transition self.buf[self.pos] == 61 { true -> laeq2()  false -> sk() } }        // '=' -> assign; else not a local-assignment stmt
    state laeq2() { self.pos = self.pos + 1; self.mode = 2; self.opnd = 0; transition 0 { _ -> subj0() } }   // past '=', lower RHS (mode 2 -> ltStore to lstgt)
    state wb0()    { transition self.buf[self.pos] == 40 { true -> wb1()  false -> wbadv() } }   // skip to '('
    state wbadv()  { self.pos = self.pos + 1; transition 0 { _ -> wb0() } }
    state wb1()    { self.pos = self.pos + 1; self.mode = 8; self.opnd = 0; transition 0 { _ -> subj0() } }   // past '(', lower the byte arg
    state wbemit() { self.usesio = 1; self.console.write_line("    ldr x0, [sp], #16"); self.console.write_line("    adrp x9, _iobyte@PAGE"); self.console.write_line("    add x9, x9, _iobyte@PAGEOFF"); self.console.write_line("    strb w0, [x9]"); self.console.write_line("    mov x0, #1"); self.console.write_line("    adrp x1, _iobyte@PAGE"); self.console.write_line("    add x1, x1, _iobyte@PAGEOFF"); self.console.write_line("    mov x2, #1"); self.console.write_line("    bl _write"); transition 0 { _ -> wbsk() } }
    state wbsk()   { transition self.buf[self.pos] == 59 { true -> wbsk2()  false -> wbsk3() } }   // ';' -> consume
    state wbsk3()  { transition self.buf[self.pos] == 125 { true -> sk()  false -> wbadv2() } }    // '}' -> stop (block end)
    state wbadv2() { self.pos = self.pos + 1; transition 0 { _ -> wbsk() } }
    state wbsk2()  { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state ret0()  { self.mode = 4; self.opnd = 0; transition 0 { _ -> subj0() } }
    state retemit(){ self.console.write_line("    ldr x0, [sp], #16"); self.console.write_line("    mov sp, x29"); self.console.write_line("    ldp x29, x30, [sp]"); self.p_addsp(); self.v = self.frame; self.emit_int(); write_byte(10); self.console.write_line("    ret"); transition 0 { _ -> retsk() } }
    state retsk() { transition self.buf[self.pos] == 59 { true -> retsk2()  false -> retsk3() } }
    state retsk3(){ transition self.buf[self.pos] == 125 { true -> sk()  false -> retadv() } }   // '}' (no trailing ';') -> stop, leave it for the block handler
    state retadv(){ self.pos = self.pos + 1; transition 0 { _ -> retsk() } }
    state retsk2(){ self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state let0()  { transition self.buf[self.pos] <= 32 { true -> let0a()  false -> let1() } }
    state let0a() { self.pos = self.pos + 1; transition 0 { _ -> let0() } }
    state let1()  { self.fs = self.pos; transition 0 { _ -> letr() } }
    state letr()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> leta()  false -> lete() } }
    state leta()  { self.pos = self.pos + 1; transition 0 { _ -> letr() } }
    state lete()  { self.fe = self.pos; self.qa = self.fs; self.qb = self.fe; self.cj = 0; self.ldisp = 0; transition 0 { _ -> llk() } }
    state llk()   { transition self.cj < self.nl { true -> llkc()  false -> leteq() } }
    state llkc()  { transition self.lmi[self.cj] == self.mi { true -> llkc2()  false -> llkn() } }
    state llkc2() { self.qc = self.lns[self.cj]; self.qd = self.lne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> llkh()  false -> llkn() } }
    state llkh()  { self.lstgt = 16 + 8 * (self.pcs[self.mi] + self.plidx[self.cj]); transition 0 { _ -> leteq() } }
    state llkn()  { self.cj = self.cj + 1; transition 0 { _ -> llk() } }
    state leteq() { transition self.buf[self.pos] == 61 { true -> leteq2()  false -> letadv() } }
    state letadv(){ transition self.buf[self.pos] == 87 { true -> letadvw()  false -> letadvs() } }   // 'W' of `in Wrapping` (unique in a let's type region)
    state letadvs(){ transition self.buf[self.pos] == 83 { true -> letadvsat()  false -> letadv2() } } // 'S' of `in Saturating`
    state letadvw(){ self.wrap = 1; self.pos = self.pos + 1; transition 0 { _ -> leteq() } }           // wrap = domain: 1 Wrapping
    state letadvsat(){ self.wrap = 2; self.pos = self.pos + 1; transition 0 { _ -> leteq() } }         // 2 Saturating
    state letadv2(){ self.pos = self.pos + 1; transition 0 { _ -> leteq() } }
    state leteq2(){ self.pos = self.pos + 1; self.mode = 2; self.opnd = 0; transition 0 { _ -> subj0() } }
    state asgn0() { transition self.buf[self.pos] == 46 { true -> asgn1()  false -> sk() } }                  // '.' ? else not an assignment
    state asgn1() { self.pos = self.pos + 1; self.fs = self.pos; transition 0 { _ -> asgnr() } }              // past '.', capture LHS field
    state asgnr() { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> asgna()  false -> asgne() } }
    state asgna() { self.pos = self.pos + 1; transition 0 { _ -> asgnr() } }
    state asgne() { self.fe = self.pos; transition self.buf[self.pos] == 91 { true -> astore0()  false -> asgne2() } }   // '[' -> array store
    state asgne2(){ transition self.buf[self.pos] == 46 { true -> qcall0()  false -> asgnws() } }   // '.' -> qualified console call (self.console.METHOD)
    state qcall0(){ self.pos = self.pos + 1; self.fs = self.pos; transition 0 { _ -> qcr() } }   // skip '.', mark method-name start (reuse fs)
    state qcr()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> qca()  false -> qce() } }
    state qca()   { self.pos = self.pos + 1; transition 0 { _ -> qcr() } }
    state qce()   { self.w = self.is_exitp(self.fs, self.pos); transition self.w == 1 { true -> exitp0()  false -> ck_wl() } }
    state ck_wl() { self.w = self.is_wline(self.fs, self.pos); transition self.w == 1 { true -> wline()  false -> sk() } }
    state wline() { transition self.buf[self.pos] == 40 { true -> wlq()  false -> wladv() } }   // skip to '('
    state wladv() { self.pos = self.pos + 1; transition 0 { _ -> wline() } }
    state wlq()   { self.pos = self.pos + 1; transition 0 { _ -> wlq2() } }                      // past '('
    state wlq2()  { transition self.buf[self.pos] == 34 { true -> wlstr()  false -> wlq2a() } }  // skip to '"'
    state wlq2a() { self.pos = self.pos + 1; transition 0 { _ -> wlq2() } }
    state wlstr() { self.pos = self.pos + 1; self.wlstart = self.pos; transition 0 { _ -> wlscan() } }   // past '"', mark string start
    state wlscan(){ transition self.buf[self.pos] == 34 { true -> wllen0()  false -> wlsadv() } }   // scan to closing '"'
    state wlsadv(){ self.pos = self.pos + 1; transition 0 { _ -> wlscan() } }
    state wllen0(){ self.wllen = self.pos - self.wlstart + 1; transition 0 { _ -> wlemit() } }   // len = content + trailing '\n'
    state wlemit(){ self.usesio = 1; self.console.write_line("    mov x0, #1"); self.p_adrpx1l(); self.v = self.nstr; self.emit_int(); self.console.write_line("@PAGE"); self.p_addx1l(); self.v = self.nstr; self.emit_int(); self.console.write_line("@PAGEOFF"); self.p_movw2(); self.v = self.wllen; self.emit_int(); write_byte(10); self.console.write_line("    bl _write"); self.nstr = self.nstr + 1; transition 0 { _ -> wlsk() } }
    state wlsk()  { self.pos = self.pos + 1; transition 0 { _ -> wlsk2() } }   // past the closing '"'
    state wlsk2() { transition self.buf[self.pos] == 41 { true -> wlsk3()  false -> wlsadv2() } }   // skip to write_line's ')'
    state wlsadv2(){ self.pos = self.pos + 1; transition 0 { _ -> wlsk2() } }
    state wlsk3() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }   // past ')', resume the walker (it handles ; / next stmt / })
    state exitp0(){ transition self.buf[self.pos] == 40 { true -> exitp1()  false -> exitpadv() } }   // skip to '('
    state exitpadv(){ self.pos = self.pos + 1; transition 0 { _ -> exitp0() } }
    state exitp1(){ self.pos = self.pos + 1; self.mode = 4; self.opnd = 0; transition 0 { _ -> subj0() } }   // past '(', lower the exit code as a return value (mode 4 -> retemit)
    state astore0(){ self.qa = self.fs; self.qb = self.fe; self.cj = 0; self.aoff = 0; self.acnt = 0; self.aeb = 0; self.astore = 1; transition 0 { _ -> aslk() } }
    state aslk()  { transition self.cj < self.nf { true -> aslkc()  false -> asidx() } }
    state aslkc() { self.qc = self.fns[self.cj]; self.qd = self.fne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> aslkh()  false -> aslkn() } }
    state aslkh() { self.aoff = self.foffs[self.cj]; self.acnt = self.fcnt[self.cj]; self.aeb = self.feb[self.cj]; self.stoff = self.aoff; self.stcnt = self.acnt; self.steb = self.aeb; transition 0 { _ -> asidx() } }
    state aslkn() { self.cj = self.cj + 1; transition 0 { _ -> aslk() } }
    state asidx() { self.pos = self.pos + 1; self.aidx = self.pos; transition 0 { _ -> assk() } }   // past '[', save index span start
    state assk()  { transition self.buf[self.pos] == 93 { true -> assk2()  false -> assadv() } }    // skip to ']'
    state assadv(){ self.pos = self.pos + 1; transition 0 { _ -> assk() } }
    state assk2() { self.pos = self.pos + 1; transition 0 { _ -> aseq() } }                          // past ']'
    state aseq()  { transition self.buf[self.pos] == 61 { true -> aseq2()  false -> aseqadv() } }    // skip to '='
    state aseqadv(){ self.pos = self.pos + 1; transition 0 { _ -> aseq() } }
    state aseq2() { self.pos = self.pos + 1; self.mode = 6; self.opnd = 0; transition 0 { _ -> subj0() } }   // past '=', lower the VALUE first (mode 6)
    state asgnws(){ transition self.buf[self.pos] <= 32 { true -> asgnw2()  false -> asgneq() } }             // skip ws to '='
    state asgnw2(){ self.pos = self.pos + 1; transition 0 { _ -> asgnws() } }
    state asgneq(){ transition self.buf[self.pos] == 61 { true -> asgnlk()  false -> ckparen() } }            // '=' assign? else maybe a method call
    state ckparen(){ transition self.buf[self.pos] == 40 { true -> stmtcall()  false -> sk() } }                // '(' -> method call (statement position)
    state stmtcall(){ self.callmode = 0; transition 0 { _ -> calllk() } }
    state calllk(){ self.qa = self.fs; self.qb = self.fe; self.cj = 0; self.cmi = 0 - 1; transition 0 { _ -> mlk() } }  // resolve callee -> mi
    state mlk()   { transition self.cj < self.mn { true -> mlkc()  false -> carg0() } }
    state mlkc()  { self.qc = self.mns[self.cj]; self.qd = self.mne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> mlkh()  false -> mlkn() } }
    state mlkh()  { self.cmi = self.cj; transition 0 { _ -> carg0() } }
    state mlkn()  { self.cj = self.cj + 1; transition 0 { _ -> mlk() } }
    state carg0() { self.pos = self.pos + 1; self.argc = 0; transition 0 { _ -> carg() } }      // past '(', argc 0
    state carg()  { transition self.buf[self.pos] <= 32 { true -> cargws()  false -> cargck() } }
    state cargws(){ self.pos = self.pos + 1; transition 0 { _ -> carg() } }
    state cargck(){ transition self.buf[self.pos] == 41 { true -> cargdone()  false -> cargl() } } // ')' no more args
    state cargl() { self.opaop[self.osp] = 0; self.opcc[self.osp] = 0; self.opprec[self.osp] = 0 - 2; self.osp = self.osp + 1; self.mode = 3; self.opnd = 0; transition 0 { _ -> subj0() } }                  // lower one arg (pushes it)
    state cargnext(){ self.argc = self.argc + 1; transition 0 { _ -> cnws() } }
    state cnws()  { transition self.buf[self.pos] <= 32 { true -> cnws2()  false -> cncheck() } }
    state cnws2() { self.pos = self.pos + 1; transition 0 { _ -> cnws() } }
    state cncheck(){ transition self.buf[self.pos] == 44 { true -> cncomma()  false -> cargdone() } } // ',' more args
    state cncomma(){ self.pos = self.pos + 1; transition 0 { _ -> carg() } }
    state cargdone(){ transition 0 { _ -> callemit2() } }
    state callemit2(){ self.cj = self.argc; transition 0 { _ -> cpop() } }                          // pop args x{argc}..x1
    state cpop()  { transition self.cj > 0 { true -> cpop1()  false -> cself() } }
    state cpop1() { self.p_ldrx(); self.v = self.cj - 1 + self.hsf[self.cmi]; self.emit_int(); self.p_spsuf(); write_byte(10); self.cj = self.cj - 1; transition 0 { _ -> cpop() } }
    state cself() { transition self.hsf[self.cmi] == 1 { true -> cself2()  false -> cselfbl() } }
    state cself2() { self.p_ldrx0x29(); self.v = self.sd; self.emit_int(); write_byte(93); write_byte(10); transition 0 { _ -> cselfbl() } }
    state cselfbl(){ self.p_bl(); transition self.cmi == self.emi { true -> blmain()  false -> blmach() } }
    state blmain(){ write_byte(95); write_byte(109); write_byte(97); write_byte(105); write_byte(110); write_byte(10); transition 0 { _ -> callpush() } }
    state blmach(){ self.p_lmachine(); self.v = self.cmi; self.emit_int(); write_byte(10); transition 0 { _ -> callpush() } }
    state callpush(){ transition self.callmode == 1 { true -> ocallret()  false -> callpush0() } }
    state callpush0(){ self.console.write_line("    str x0, [sp, #-16]!"); self.console.write_line("    ldr x0, [sp], #16"); transition 0 { _ -> callsk() } }
    state ocallret(){ self.console.write_line("    str x0, [sp, #-16]!"); self.pos = self.pos + 1; self.mode = self.ocmode; self.opnd = self.ocopnd; transition 0 { _ -> opdisp() } }
    state callsk(){ transition self.buf[self.pos] == 59 { true -> callsk2()  false -> callsk3() } }   // ';' -> consume
    state callsk3(){ transition self.buf[self.pos] == 125 { true -> sk()  false -> calladv() } }       // '}' -> stop (last stmt in a block, no trailing ';')
    state calladv(){ self.pos = self.pos + 1; transition 0 { _ -> callsk() } }
    state callsk2(){ self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state asgnlk(){ self.qa = self.fs; self.qb = self.fe; self.cj = 0; self.laoff = 0; transition 0 { _ -> alk() } } // resolve LHS offset
    state alk()   { transition self.cj < self.nf { true -> alkc()  false -> argo() } }
    state alkc()  { self.qc = self.fns[self.cj]; self.qd = self.fne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> alkh()  false -> alkn() } }
    state alkh()  { self.laoff = self.foffs[self.cj]; self.wrap = self.fdom[self.cj]; transition 0 { _ -> argo() } }   // store into a domain-typed field uses its domain
    state alkn()  { self.cj = self.cj + 1; transition 0 { _ -> alk() } }
    state argo()  { self.pos = self.pos + 1; transition 0 { _ -> argows() } }    // past '='
    state argows(){ transition self.buf[self.pos] <= 32 { true -> argowsa()  false -> ckctor() } }   // skip ws to the RHS
    state argowsa(){ self.pos = self.pos + 1; transition 0 { _ -> argows() } }
    state ckctor(){ self.start = self.pos; transition 0 { _ -> ckctr2() } }   // capture the RHS first ident, to detect Type::Variant construction
    state ckctr2(){ self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> ckctr3()  false -> ckctr4() } }
    state ckctr3(){ self.pos = self.pos + 1; transition 0 { _ -> ckctr2() } }
    state ckctr4(){ transition self.buf[self.pos] == 58 { true -> ctor0()  false -> argplain() } }   // '::' -> enum construction, else a normal value RHS
    state argplain(){ self.pos = self.start; self.mode = 1; self.opnd = 0; transition 0 { _ -> subj0() } }   // lower the RHS as a value (-> stStore at laoff)
    // enum construction: self.FIELD = Type::Variant(payload) -> store tag at laoff, payload at laoff+8
    state ctor0() { self.pos = self.pos + 2; self.qa = self.pos; transition 0 { _ -> ctorr() } }   // skip '::', mark variant name
    state ctorr() { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> ctora()  false -> ctore() } }
    state ctora() { self.pos = self.pos + 1; transition 0 { _ -> ctorr() } }
    state ctore() { self.qb = self.pos; self.cj = 0; self.sval = 0; transition 0 { _ -> ctlk() } }   // variant -> tag
    state ctlk()  { transition self.cj < self.nv { true -> ctlkc()  false -> ctstag() } }
    state ctlkc() { self.qc = self.vns[self.cj]; self.qd = self.vne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> ctlkh()  false -> ctlkn() } }
    state ctlkh() { self.sval = self.vtag[self.cj]; transition 0 { _ -> ctstag() } }
    state ctlkn() { self.cj = self.cj + 1; transition 0 { _ -> ctlk() } }
    state ctstag(){ self.movw0v(); self.p_ldrx29(); self.v = self.sd; self.emit_int(); write_byte(93); write_byte(10); self.p_strw0(); self.v = self.laoff; self.emit_int(); write_byte(93); write_byte(10); transition 0 { _ -> ctpay() } }   // movz w0,#tag ; ldr x9,[x29,#sd] ; str w0,[x9,#laoff]
    state ctpay() { transition self.buf[self.pos] == 40 { true -> ctpay2()  false -> ctpsk() } }   // '(' -> payload(s), else tag-only variant
    state ctpay2(){ self.pos = self.pos + 1; self.payidx = 0; transition 0 { _ -> ctpayw() } }    // past '('
    state ctpayw(){ transition self.buf[self.pos] <= 32 { true -> ctpayws()  false -> ctpayl() } }   // skip ws (also after ',')
    state ctpayws(){ self.pos = self.pos + 1; transition 0 { _ -> ctpayw() } }
    state ctpayl(){ self.lstgt = self.laoff + 8 + 8 * self.payidx; self.mode = 12; self.opnd = 0; transition 0 { _ -> subj0() } }   // lower the payidx-th payload (mode 12 -> ctpemit stores at laoff+8+8*i)
    state ctpsk() { transition self.buf[self.pos] == 59 { true -> ctpsk2()  false -> ctpsk3() } }   // ';' -> consume
    state ctpsk3(){ transition self.buf[self.pos] == 125 { true -> sk()  false -> ctpadv() } }       // '}' -> stop
    state ctpadv(){ self.pos = self.pos + 1; transition 0 { _ -> ctpsk() } }
    state ctpsk2(){ self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state stStore(){ self.console.write_line("    ldr x0, [sp], #16"); self.p_ldrx29(); self.v = self.sd; self.emit_int(); write_byte(93); write_byte(10); transition self.laoff > 16380 { true -> stBig()  false -> stImm() } }
    state stImm()  { self.p_strw0(); self.v = self.laoff; self.emit_int(); write_byte(93); write_byte(10); transition 0 { _ -> stsk() } }
    state stBig()  { self.fv = self.laoff; self.foldx9(); self.console.write_line("    str w0, [x9]"); transition 0 { _ -> stsk() } }
    state stsk()  { transition self.buf[self.pos] == 59 { true -> stsk2()  false -> stadv() } }               // skip past ';'
    state stadv() { self.pos = self.pos + 1; transition 0 { _ -> stsk() } }
    state stsk2() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state emitL() { self.p_lm(); self.v = self.mi; self.emit_int(); write_byte(115); self.v = self.lsi; self.emit_int(); write_byte(58); write_byte(10); self.lsi = self.lsi + 1; transition 0 { _ -> sk() } }
    // lower the SUBJECT: skip ws, then a literal (digits) or a self.field
    state subj0() { transition self.buf[self.pos] <= 32 { true -> subadv()  false -> subc() } }
    state subadv(){ self.pos = self.pos + 1; transition 0 { _ -> subj0() } }
    state subc()  { transition self.buf[self.pos] == 45 { true -> uminus0()  false -> subc0() } }    // '-' -> unary minus on the following primary
    state uminus0(){ self.pos = self.pos + 1; self.unegate = 1; transition 0 { _ -> subj0() } }       // skip '-', flag negate, re-lower the operand
    state subc0() { transition self.buf[self.pos] == 40 { true -> opensent()  false -> subc1() } }   // '(' -> parenthesized sub-expression
    state subc1() { transition self.buf[self.pos] < 48 { true -> idsub()  false -> subc2() } }
    state opensent(){ self.opaop[self.osp] = 0; self.opcc[self.osp] = 0; self.opprec[self.osp] = 0 - 3; self.osp = self.osp + 1; self.pos = self.pos + 1; transition 0 { _ -> subj0() } }   // push paren sentinel (-3, below the -1 bit-op prec), skip '(', lower the inner operand
    state subc2() { transition self.buf[self.pos] > 57 { true -> idsub()  false -> litsub() } }
    state idsub() { self.start = self.pos; transition 0 { _ -> idr() } }
    state idr()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> ida()  false -> ide() } }
    state ida()   { self.pos = self.pos + 1; transition 0 { _ -> idr() } }
    state ide()   { self.w = self.is_self(self.start, self.pos); transition self.w == 1 { true -> fldname()  false -> ck_rb() } }
    state ck_rb() { self.w = self.is_rbyte(self.start, self.pos); transition self.w == 1 { true -> rbemit()  false -> ck_mm() } }
    // min(a,b)/max(a,b): handled via the OPERAND STACK (not the call machinery). Push a sentinel (prec -4 min /
    // -5 max, below the -3 paren sentinel), lower arg1; the ',' drains arg1's ops to the sentinel (mmcomma) then
    // lowers arg2; the ')' pops the sentinel and emits cmp+csel (mmclose). Nests correctly (the op stack is a stack).
    state ck_mm() { self.mmk = self.is_minmax(self.start, self.pos); transition self.mmk > 0 { true -> mmopen()  false -> ckcolon() } }
    state mmopen(){ transition self.buf[self.pos] == 40 { true -> mmopen2()  false -> ckcolon() } }   // a call `min(` else a plain ident
    state mmopen2(){ self.opaop[self.osp] = 0; self.opcc[self.osp] = 0; self.opprec[self.osp] = 0 - 3 - self.mmk; self.osp = self.osp + 1; self.pos = self.pos + 1; transition 0 { _ -> subj0() } }   // push -4/-5 sentinel, skip '(', lower arg1
    state ckcolon(){ transition self.buf[self.pos] == 58 { true -> cvar0()  false -> ckfcall() } }   // 'Type::Variant' enum-tag literal (else a bare ident -> call/local)
    state cvar0() { self.pos = self.pos + 2; self.qa = self.pos; transition 0 { _ -> cvarr() } }     // skip '::', mark variant name
    state cvarr() { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> cvara()  false -> cvare() } }
    state cvara() { self.pos = self.pos + 1; transition 0 { _ -> cvarr() } }
    state cvare() { self.qb = self.pos; self.cj = 0; self.sval = 0; transition 0 { _ -> cvlk() } }    // look the variant up -> its tag
    state cvlk()  { transition self.cj < self.nv { true -> cvlkc()  false -> cvemit() } }
    state cvlkc() { self.qc = self.vns[self.cj]; self.qd = self.vne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> cvlkh()  false -> cvlkn() } }
    state cvlkh() { self.sval = self.vtag[self.cj]; transition 0 { _ -> cvemit() } }
    state cvlkn() { self.cj = self.cj + 1; transition 0 { _ -> cvlk() } }
    state cvemit(){ self.movw0v(); self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> opdisp() } }   // tag as a constant operand
    state ckfcall(){ transition self.buf[self.pos] == 40 { true -> fcall()  false -> bchk() } }   // bare ident '(' -> free-machine call; else maybe a payload binding, else a local/param
    state bchk()  { self.cj = 0; transition 0 { _ -> bchk2() } }                                      // search the binding table
    state bchk2() { transition self.cj < self.nb { true -> bchk3()  false -> locsub() } }              // not a binding -> local/param
    state bchk3() { self.qa = self.start; self.qb = self.pos; self.qc = self.bns[self.cj]; self.qd = self.bne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> bemit()  false -> bchkn() } }
    state bchkn() { self.cj = self.cj + 1; transition 0 { _ -> bchk2() } }
    state bemit() { self.p_ldrx29(); self.v = self.sd; self.emit_int(); write_byte(93); write_byte(10); self.p_ldrw0(); self.v = self.bndoff[self.cj]; self.emit_int(); write_byte(93); write_byte(10); self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> opdisp() } }   // payload read: ldr x9,[x29,#sd]; ldr w0,[x9,#bndoff[i]]; push
    state fcall() { self.ocmode = self.mode; self.ocopnd = self.opnd; self.callmode = 1; self.fs = self.start; self.fe = self.pos; transition 0 { _ -> calllk() } }
    state rbemit(){ self.usesio = 1; self.console.write_line("    mov x0, #0"); self.console.write_line("    adrp x1, _iobyte@PAGE"); self.console.write_line("    add x1, x1, _iobyte@PAGEOFF"); self.console.write_line("    mov x2, #1"); self.console.write_line("    bl _read"); self.console.write_line("    adrp x9, _iobyte@PAGE"); self.console.write_line("    add x9, x9, _iobyte@PAGEOFF"); self.console.write_line("    ldrb w1, [x9]"); self.console.write_line("    movz w2, #65535"); self.console.write_line("    movk w2, #65535, lsl #16"); self.console.write_line("    cmp x0, #1"); self.console.write_line("    csel w0, w1, w2, ge"); self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> rbsk() } }
    state rbsk()  { transition self.buf[self.pos] == 41 { true -> rbsk2()  false -> rbadv() } }   // skip to ')'
    state rbadv() { self.pos = self.pos + 1; transition 0 { _ -> rbsk() } }
    state rbsk2() { self.pos = self.pos + 1; transition 0 { _ -> opdisp() } }   // past ')', operand done
    state locsub(){ self.qa = self.start; self.qb = self.pos; self.cj = 0; self.ldisp = 0; transition 0 { _ -> plk() } }
    state plk()   { transition self.cj < self.np { true -> plkc()  false -> rlk0() } }
    state plkc()  { transition self.pmi[self.cj] == self.mi { true -> plkc2()  false -> plkn() } }
    state plkc2() { self.qc = self.pns[self.cj]; self.qd = self.pne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> plkh()  false -> plkn() } }
    state plkh()  { self.ldisp = 16 + 8 * self.ppidx[self.cj]; transition 0 { _ -> remit() } }
    state plkn()  { self.cj = self.cj + 1; transition 0 { _ -> plk() } }
    state rlk0()  { self.cj = 0; transition 0 { _ -> rlk() } }
    state rlk()   { transition self.cj < self.nl { true -> rlkc()  false -> remit() } }
    state rlkc()  { transition self.lmi[self.cj] == self.mi { true -> rlkc2()  false -> rlkn() } }
    state rlkc2() { self.qc = self.lns[self.cj]; self.qd = self.lne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> rlkh()  false -> rlkn() } }
    state rlkh()  { self.ldisp = 16 + 8 * (self.pcs[self.mi] + self.plidx[self.cj]); transition 0 { _ -> remit() } }
    state rlkn()  { self.cj = self.cj + 1; transition 0 { _ -> rlk() } }
    state remit() { self.p_ldrw0x29(); self.v = self.ldisp; self.emit_int(); write_byte(93); write_byte(10); self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> opdisp() } }
    state litsub(){ self.sval = 0; transition 0 { _ -> litr() } }
    state litr()  { transition self.buf[self.pos] < 48 { true -> litdone()  false -> litr2() } }
    state litr2() { transition self.buf[self.pos] > 57 { true -> litdone()  false -> litacc() } }
    state litacc(){ self.sval = self.sval * 10 + self.buf[self.pos] - 48; self.pos = self.pos + 1; transition 0 { _ -> litr() } }
    state litdone(){ self.movw0v(); self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> opdisp() } }
    state fldname(){ self.pos = self.pos + 1; self.fs = self.pos; transition 0 { _ -> fldr() } }   // past '.', capture field name
    state fldr()  { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> flda()  false -> flde() } }
    state flda()  { self.pos = self.pos + 1; transition 0 { _ -> fldr() } }
    state flde()  { self.fe = self.pos; self.qa = self.fs; self.qb = self.fe; transition self.buf[self.pos] == 40 { true -> ocall()  false -> flk0() } }   // '(' -> self-machine call in operand position
    state flk0()  { self.cj = 0; self.foff = 0; transition 0 { _ -> flk() } }
    state ocall() { self.ocmode = self.mode; self.ocopnd = self.opnd; self.callmode = 1; transition 0 { _ -> calllk() } }
    state flk()   { transition self.cj < self.nf { true -> flkc()  false -> femit() } }
    state flkc()  { self.qc = self.fns[self.cj]; self.qd = self.fne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> flkh()  false -> flkn() } }
    state flkh()  { self.foff = self.foffs[self.cj]; self.acnt = self.fcnt[self.cj]; self.aeb = self.feb[self.cj]; transition 0 { _ -> fchk() } }
    state fchk()  { transition self.buf[self.pos] == 91 { true -> arr0()  false -> femit() } }     // '[' -> array index
    state arr0()  { self.omode = self.mode; self.oopnd = self.opnd; self.aoff = self.foff; self.sacnt = self.acnt; self.saeb = self.aeb; self.saoff = self.foff; self.astore = 0; self.pos = self.pos + 1; self.opaop[self.osp] = 0; self.opcc[self.osp] = 0; self.opprec[self.osp] = 0 - 3; self.osp = self.osp + 1; self.mode = 5; self.opnd = 0; transition 0 { _ -> subj0() } }
    state arremit(){ transition self.mode == 7 { true -> aremst()  false -> aremrd() } }
    state aremst() { self.acnt = self.stcnt; self.aeb = self.steb; self.aoff = self.stoff; self.astore = 1; transition 0 { _ -> arem2() } }
    state aremrd() { self.acnt = self.sacnt; self.aeb = self.saeb; self.aoff = self.saoff; transition 0 { _ -> arem2() } }
    state arem2(){
        self.console.write_line("    ldr x0, [sp], #16");
        self.movw1v();
        self.console.write_line("    cmp w0, w1");
        self.console.write_line("    b.hs Ltrap");
        self.console.write_line("    uxtw x0, w0");
        self.p_ldrx29(); self.v = self.sd; self.emit_int(); write_byte(93); write_byte(10);
        transition self.aoff > 0 { true -> aroff()  false -> aridx() }
    }
    state aroff() { self.fv = self.aoff; self.foldx9(); transition 0 { _ -> aridx() } }
    state aridx() { self.p_addidx(); transition self.aeb == 8 { true -> arlsl()  false -> aridxe() } }
    state arlsl() { write_byte(44); write_byte(32); write_byte(108); write_byte(115); write_byte(108); write_byte(32); write_byte(35); write_byte(51); write_byte(10); transition 0 { _ -> arend() } }
    state aridxe(){ write_byte(10); transition 0 { _ -> arend() } }
    state arend() { transition self.astore == 1 { true -> astload()  false -> arload() } }
    state astload(){ self.console.write_line("    ldr x1, [sp], #16"); transition self.aeb == 1 { true -> aststrb()  false -> aststrw() } }
    state aststrb(){ self.console.write_line("    strb w1, [x9]"); transition 0 { _ -> astdone() } }
    state aststrw(){ self.console.write_line("    str w1, [x9]"); transition 0 { _ -> astdone() } }
    state astdone(){ self.pos = self.rpos; transition 0 { _ -> astsk() } }
    state astsk()  { transition self.buf[self.pos] == 59 { true -> astsk2()  false -> astadv() } }
    state astadv() { self.pos = self.pos + 1; transition 0 { _ -> astsk() } }
    state astsk2() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state arload(){ transition self.aeb == 1 { true -> arldb()  false -> arldw() } }
    state arldb() { self.console.write_line("    ldrb w0, [x9]"); transition 0 { _ -> arpush() } }
    state arldw() { self.console.write_line("    ldr w0, [x9]"); transition 0 { _ -> arpush() } }
    state arpush(){ self.console.write_line("    str x0, [sp, #-16]!"); self.mode = self.omode; self.opnd = self.oopnd; transition 0 { _ -> arsk() } }
    state arsk()  { transition self.buf[self.pos] == 93 { true -> arsk2()  false -> arsadv() } }   // skip ']'
    state arsadv(){ self.pos = self.pos + 1; transition 0 { _ -> arsk() } }
    state arsk2() { self.pos = self.pos + 1; transition 0 { _ -> opdisp() } }
    state flkn()  { self.cj = self.cj + 1; transition 0 { _ -> flk() } }
    state femit() { transition self.mode == 0 { true -> fsubj()  false -> femit2() } }   // mode 0 = transition subject: remember its field offset for payload binding
    state fsubj() { self.subjoff = self.foff; transition 0 { _ -> femit2() } }
    state femit2(){ self.p_ldrx29(); self.v = self.sd; self.emit_int(); write_byte(93); write_byte(10); transition self.foff > 16380 { true -> fBig()  false -> fImm() } }
    state fImm()  { self.p_ldrw0(); self.v = self.foff; self.emit_int(); write_byte(93); write_byte(10); transition 0 { _ -> fpush() } }
    state fBig()  { self.fv = self.foff; self.foldx9(); self.console.write_line("    ldr w0, [x9]"); transition 0 { _ -> fpush() } }
    state fpush() { self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> opdisp() } }
    // after an operand: first operand -> check for an operator; second operand -> emit it
    state opdisp(){ transition self.unegate == 1 { true -> uneg()  false -> opchk() } }   // negate the just-lowered primary if a unary '-' preceded it
    state uneg()  { self.unegate = 0; self.console.write_line("    ldr x0, [sp], #16"); self.console.write_line("    neg w0, w0"); self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> opchk() } }
    state opchk() { transition self.buf[self.pos] <= 32 { true -> opadv()  false -> opchk2() } }
    state opadv() { self.pos = self.pos + 1; transition 0 { _ -> opchk() } }
    state opchk2(){ transition self.buf[self.pos] == 123 { true -> opflush()  false -> opchk3() } }  // '{' subject end
    state opchk3(){ transition self.buf[self.pos] == 59 { true -> opflush()  false -> opchk4() } }   // ';' RHS end
    state opchk4(){ transition self.buf[self.pos] == 44 { true -> caclose()  false -> opchk5() } }   // ',' call-arg end -> drain to the arg's -2 sentinel
    state opchk5(){ transition self.buf[self.pos] == 41 { true -> pclose()  false -> opchk6() } }   // ')' -> paren close (if sentinel on stack) or arg/context end
    state opchk6(){ transition self.buf[self.pos] == 93 { true -> aclose()  false -> opp() } }      // ']' index end -> pop to sentinel
    state subjend(){ transition self.mode == 0 { true -> toarms()  false -> sjm12() } }
    state sjm12()  { transition self.mode == 1 { true -> stStore()  false -> sjm23() } }
    state sjm23()  { transition self.mode == 2 { true -> ltStore()  false -> sjm34() } }
    state sjm34()  { transition self.mode == 3 { true -> cargnext()  false -> sjm45() } }
    state sjm45()  { transition self.mode == 4 { true -> retemit()  false -> sjm56() } }
    state sjm56()  { transition self.mode == 5 { true -> arremit()  false -> sjm67() } }
    state sjm67()  { transition self.mode == 6 { true -> astidx()  false -> sjm78() } }
    state sjm78()  { transition self.mode == 7 { true -> arremit()  false -> sjm89() } }
    state sjm89()  { transition self.mode == 8 { true -> wbemit()  false -> sjm9a() } }
    state sjm9a()  { transition self.mode == 9 { true -> asrtemit()  false -> sjm10a() } }
    state sjm10a() { transition self.mode == 10 { true -> sargemit()  false -> sjm11a() } }
    state sjm11a() { transition self.mode == 11 { true -> eargemit()  false -> ctpemit() } }   // mode 12 -> enum-construction payload: store at laoff+8
    state ctpemit(){ self.console.write_line("    ldr x0, [sp], #16"); self.p_ldrx29(); self.v = self.sd; self.emit_int(); write_byte(93); write_byte(10); self.p_strw0(); self.v = self.lstgt; self.emit_int(); write_byte(93); write_byte(10); transition 0 { _ -> ctpnx() } }
    state ctpnx() { transition self.buf[self.pos] <= 32 { true -> ctpnxa()  false -> ctpnxc() } }   // skip ws after a payload
    state ctpnxa(){ self.pos = self.pos + 1; transition 0 { _ -> ctpnx() } }
    state ctpnxc(){ transition self.buf[self.pos] == 44 { true -> ctpcom()  false -> ctpdone() } }   // ',' -> another payload, else ')'
    state ctpcom(){ self.pos = self.pos + 1; self.payidx = self.payidx + 1; transition 0 { _ -> ctpayw() } }   // past ',', next payload at +8*(i+1)
    state ctpdone(){ self.pos = self.pos + 1; transition 0 { _ -> ctpsk() } }   // past ')'
    state eargemit(){ self.console.write_line("    ldr x0, [sp], #16"); self.p_strw0x29(); self.v = self.lstgt; self.emit_int(); write_byte(93); write_byte(10); transition 0 { _ -> eargnx() } }   // store this arg, then check for more
    state eargnx(){ transition self.buf[self.pos] <= 32 { true -> eargnxa()  false -> eargnxc() } }
    state eargnxa(){ self.pos = self.pos + 1; transition 0 { _ -> eargnx() } }
    state eargnxc(){ transition self.buf[self.pos] == 44 { true -> eargcom()  false -> eargbr() } }   // ',' -> next arg, else ')' -> branch + skip label
    state eargcom(){ self.pos = self.pos + 1; self.aix = self.aix + 1; transition 0 { _ -> eargw() } }
    state eargbr(){ self.p_b(); self.emit_lab(); self.p_lsk(); self.v = self.eskl; self.emit_int(); write_byte(58); write_byte(10); transition 0 { _ -> aend() } }   // b target ; Lsk<eskl>:
    state sargemit(){ self.console.write_line("    ldr x0, [sp], #16"); self.p_strw0x29(); self.v = self.lstgt; self.emit_int(); write_byte(93); write_byte(10); transition 0 { _ -> sargnx() } }   // store this arg, then check for more
    state sargnx(){ transition self.buf[self.pos] <= 32 { true -> sargnxa()  false -> sargnxc() } }
    state sargnxa(){ self.pos = self.pos + 1; transition 0 { _ -> sargnx() } }
    state sargnxc(){ transition self.buf[self.pos] == 44 { true -> sargcom()  false -> sargbr() } }   // ',' -> next arg, else ')' -> branch
    state sargcom(){ self.pos = self.pos + 1; self.aix = self.aix + 1; transition 0 { _ -> ewargw() } }
    state sargbr(){ self.p_b(); self.emit_lab(); transition 0 { _ -> aend() } }   // all args stored -> b target
    state asrtemit(){ self.console.write_line("    ldr x0, [sp], #16"); self.console.write_line("    cbz w0, Ltrap"); transition 0 { _ -> asrtsk() } }
    state asrtsk()  { transition self.buf[self.pos] == 59 { true -> asrtsk2()  false -> asrtsk3() } }   // ';' -> consume
    state asrtsk3() { transition self.buf[self.pos] == 125 { true -> sk()  false -> asrtadv() } }       // '}' -> stop (block end)
    state asrtadv() { self.pos = self.pos + 1; transition 0 { _ -> asrtsk() } }
    state asrtsk2() { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state astidx() { self.rpos = self.pos; self.pos = self.aidx; self.opaop[self.osp] = 0; self.opcc[self.osp] = 0; self.opprec[self.osp] = 0 - 3; self.osp = self.osp + 1; self.mode = 7; self.opnd = 0; transition 0 { _ -> subj0() } }
    state ltStore(){ self.console.write_line("    ldr x0, [sp], #16"); self.p_strw0x29(); self.v = self.lstgt; self.emit_int(); write_byte(93); write_byte(10); transition 0 { _ -> stsk() } }
    state opp()   { self.naop = 0; transition self.buf[self.pos] == 60 { true -> oplt()  false -> opp2() } }     // '<'
    state oplt()  { transition self.buf[self.pos + 1] == 61 { true -> ople()  false -> opltsh() } }
    state opltsh(){ transition self.buf[self.pos + 1] == 60 { true -> opshl()  false -> opltx() } }   // '<<'
    state ople()  { self.ncc = 1; self.nprec = 0; self.pos = self.pos + 2; transition 0 { _ -> opclimb() } }
    state opltx() { self.ncc = 0; self.nprec = 0; self.pos = self.pos + 1; transition 0 { _ -> opclimb() } }
    state opp2()  { transition self.buf[self.pos] == 62 { true -> opgt()  false -> opp3() } }      // '>'
    state opgt()  { transition self.buf[self.pos + 1] == 61 { true -> opge()  false -> opgtsh() } }
    state opgtsh(){ transition self.buf[self.pos + 1] == 62 { true -> opshr()  false -> opgtx() } }   // '>>'
    state opge()  { self.ncc = 5; self.nprec = 0; self.pos = self.pos + 2; transition 0 { _ -> opclimb() } }
    state opgtx() { self.ncc = 4; self.nprec = 0; self.pos = self.pos + 1; transition 0 { _ -> opclimb() } }
    state opp3()  { transition self.buf[self.pos] == 61 { true -> opeq()  false -> opp4() } }      // '=='
    state opeq()  { self.ncc = 2; self.nprec = 0; self.pos = self.pos + 2; transition 0 { _ -> opclimb() } }
    state opp4()  { transition self.buf[self.pos] == 33 { true -> opne()  false -> opar() } }       // '!' -> '!=' ; else arithmetic
    state opne()  { self.ncc = 3; self.nprec = 0; self.pos = self.pos + 2; transition 0 { _ -> opclimb() } }   // '!=' -> ne
    state opar()  { transition self.buf[self.pos] == 43 { true -> opadd()  false -> opar2() } }      // '+'
    state opar2() { transition self.buf[self.pos] == 45 { true -> opsub()  false -> opar3() } }      // '-'
    state opar3() { transition self.buf[self.pos] == 42 { true -> opmul()  false -> opar4() } }      // '*'
    state opar4() { transition self.buf[self.pos] == 47 { true -> opdiv()  false -> opcls() } }      // '/'
    state opcls() { transition self.buf[self.pos] == 37  { true -> opmod()  false -> opand() } }     // '%'
    state opand() { transition self.buf[self.pos] == 38  { true -> opbitand()  false -> opor() } }   // '&'
    state opor()  { transition self.buf[self.pos] == 124 { true -> opbitor()  false -> opxor() } }   // '|'
    state opxor() { transition self.buf[self.pos] == 94  { true -> opbitxor()  false -> opmod() } }  // '^' (else: unknown op char -> old % catch-all)
    state opadd() { self.naop = 1; self.nprec = 1; self.pos = self.pos + 1; transition 0 { _ -> opclimb() } }
    state opsub() { self.naop = 2; self.nprec = 1; self.pos = self.pos + 1; transition 0 { _ -> opclimb() } }
    state opmul() { self.naop = 3; self.nprec = 2; self.pos = self.pos + 1; transition 0 { _ -> opclimb() } }
    state opdiv() { self.naop = 4; self.nprec = 2; self.pos = self.pos + 1; transition 0 { _ -> opclimb() } }
    state opmod() { self.naop = 5; self.nprec = 2; self.pos = self.pos + 1; transition 0 { _ -> opclimb() } }   // '%' (multiplicative, with * /)
    state opbitand(){ self.naop = 6; self.nprec = 0 - 1; self.pos = self.pos + 1; transition 0 { _ -> opclimb() } }  // '&' prec -1 (below comparisons=0)
    state opbitor() { self.naop = 7; self.nprec = 0 - 1; self.pos = self.pos + 1; transition 0 { _ -> opclimb() } }  // '|'
    state opbitxor(){ self.naop = 8; self.nprec = 0 - 1; self.pos = self.pos + 1; transition 0 { _ -> opclimb() } }  // '^'
    state opshl()   { self.naop = 9; self.nprec = 0 - 1; self.pos = self.pos + 2; transition 0 { _ -> opclimb() } }  // '<<' (two-char)
    state opshr()   { self.naop = 10; self.nprec = 0 - 1; self.pos = self.pos + 2; transition 0 { _ -> opclimb() } } // '>>'
    // shunting-yard: pop stacked ops of >= precedence (emit them), then push this op (precedence climb -> left-assoc)
    state opclimb(){ transition self.osp > 0 { true -> opclimb2()  false -> oppush() } }
    state opclimb2(){ transition self.opprec[self.osp - 1] >= self.nprec { true -> oppop()  false -> oppush() } }
    state oppop() { self.aop = self.opaop[self.osp - 1]; self.cc = self.opcc[self.osp - 1]; self.osp = self.osp - 1; self.opret = 0; transition 0 { _ -> emitop() } }
    state oppush(){ self.opaop[self.osp] = self.naop; self.opcc[self.osp] = self.ncc; self.opprec[self.osp] = self.nprec; self.osp = self.osp + 1; transition 0 { _ -> op2() } }
    state op2()   { transition 0 { _ -> subj0() } }
    state opflush(){ transition self.osp > 0 { true -> opfpop()  false -> subjend() } }   // expression end: emit all remaining stacked ops, then end
    state opfpop(){ self.aop = self.opaop[self.osp - 1]; self.cc = self.opcc[self.osp - 1]; self.osp = self.osp - 1; self.opret = 1; transition 0 { _ -> emitop() } }
    state opretdisp(){ transition self.opret == 0 { true -> opclimb()  false -> opretd2() } }
    state opretd2(){ transition self.opret == 1 { true -> opflush()  false -> opretd3() } }
    state opretd3(){ transition self.opret == 2 { true -> pclose()  false -> opretd4() } }
    state opretd4(){ transition self.opret == 3 { true -> aclose()  false -> caclose() } }   // 2=paren 3=array 4=call-arg close
    // ')' : pop+emit stacked ops until the precedence -1 sentinel; if one is found it's a paren close (discard + continue), else it's the context end (arg/subject)
    state pclose(){ transition self.osp > 0 { true -> pclose2()  false -> subjend() } }
    state pclose2(){ transition self.opprec[self.osp - 1] == 0 - 3 { true -> pdiscard()  false -> pclose3() } }
    state pclose3(){ transition self.opprec[self.osp - 1] == 0 - 2 { true -> cadiscard()  false -> pclose4() } }
    state pclose4(){ transition self.opprec[self.osp - 1] <= 0 - 4 { true -> mmclose()  false -> pcpop() } }   // -4/-5 = min/max close -> pop sentinel, emit cmp+csel
    state mmclose(){ self.mmk = self.opprec[self.osp - 1]; self.osp = self.osp - 1; self.pos = self.pos + 1; transition 0 { _ -> mmemit() } }   // save kind (-4 min/-5 max), pop sentinel, skip ')'
    state mmemit(){ self.console.write_line("    ldr x1, [sp], #16"); self.console.write_line("    ldr x0, [sp], #16"); self.console.write_line("    cmp w0, w1"); transition self.mmk == 0 - 4 { true -> mmemin()  false -> mmemax() } }
    state mmemin(){ self.console.write_line("    csel w0, w0, w1, lt"); transition 0 { _ -> mmepush() } }   // min: keep the smaller
    state mmemax(){ self.console.write_line("    csel w0, w0, w1, gt"); transition 0 { _ -> mmepush() } }   // max: keep the larger
    state mmepush(){ self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> opdisp() } }
    state pcpop(){ self.aop = self.opaop[self.osp - 1]; self.cc = self.opcc[self.osp - 1]; self.osp = self.osp - 1; self.opret = 2; transition 0 { _ -> emitop() } }
    state pdiscard(){ self.osp = self.osp - 1; self.pos = self.pos + 1; transition 0 { _ -> opdisp() } }   // drop sentinel, skip ')', the paren value is now an operand
    state aclose(){ transition self.osp > 0 { true -> aclose2()  false -> subjend() } }
    state aclose2(){ transition self.opprec[self.osp - 1] == 0 - 3 { true -> adiscard()  false -> acpop() } }
    state acpop(){ self.aop = self.opaop[self.osp - 1]; self.cc = self.opcc[self.osp - 1]; self.osp = self.osp - 1; self.opret = 3; transition 0 { _ -> emitop() } }
    state adiscard(){ self.osp = self.osp - 1; transition 0 { _ -> subjend() } }
    state caclose(){ transition self.osp > 0 { true -> caclose2()  false -> subjend() } }
    state caclose2(){ transition self.opprec[self.osp - 1] == 0 - 2 { true -> cadiscard()  false -> caclose3() } }
    state caclose3(){ transition self.opprec[self.osp - 1] <= 0 - 4 { true -> mmcomma()  false -> cacpop() } }   // -4/-5 = min/max: arg1 done (stays pushed under the sentinel), lower arg2
    state mmcomma(){ self.pos = self.pos + 1; transition 0 { _ -> subj0() } }   // skip ',', lower arg2
    state cacpop(){ self.aop = self.opaop[self.osp - 1]; self.cc = self.opcc[self.osp - 1]; self.osp = self.osp - 1; self.opret = 4; transition 0 { _ -> emitop() } }
    state cadiscard(){ self.osp = self.osp - 1; transition 0 { _ -> subjend() } }
    state emitop(){ self.console.write_line("    ldr x1, [sp], #16"); self.console.write_line("    ldr x0, [sp], #16"); transition self.aop == 0 { true -> emitcmp()  false -> emitar() } }
    state emitcmp(){ self.console.write_line("    cmp w0, w1"); self.p_cset(); transition 0 { _ -> ec() } }
    state emitar() { transition self.aop == 1 { true -> aadd()  false -> emitar2() } }
    state emitar2(){ transition self.aop == 2 { true -> asub()  false -> emitar3() } }
    state emitar3(){ transition self.aop == 3 { true -> amul()  false -> emitar4() } }
    state emitar4(){ transition self.aop == 4 { true -> adiv()  false -> emitar5() } }
    state emitar5(){ transition self.aop == 5 { true -> arem()  false -> emitar6() } }
    state emitar6(){ transition self.aop == 6 { true -> aband()  false -> emitar7() } }
    state emitar7(){ transition self.aop == 7 { true -> abor()  false -> emitar8() } }
    state emitar8(){ transition self.aop == 8 { true -> abxor()  false -> emitar9() } }
    state emitar9(){ transition self.aop == 9 { true -> ashl()  false -> ashr() } }
    state aadd()   { transition self.wrap == 1 { true -> aaddw()  false -> aadds() } }
    state aadds()  { transition self.wrap == 2 { true -> aaddsat()  false -> aaddt() } }
    state aaddw()  { self.console.write_line("    add w0, w0, w1"); transition 0 { _ -> apush() } }   // 1 Wrapping: no overflow trap
    state aaddt()  { self.console.write_line("    adds w0, w0, w1"); self.console.write_line("    b.vs Ltrap"); transition 0 { _ -> apush() } }
    state aaddsat(){ self.console.write_line("    adds w0, w0, w1"); self.console.write_line("    asr w2, w0, #31"); self.console.write_line("    movz w3, #0x8000, lsl #16"); self.console.write_line("    eor w2, w2, w3"); self.console.write_line("    csel w0, w2, w0, vs"); transition 0 { _ -> apush() } }   // 2 Saturating: clamp to MIN/MAX
    state asub()   { transition self.wrap == 1 { true -> asubw()  false -> asubs() } }
    state asubs()  { transition self.wrap == 2 { true -> asubsat()  false -> asubt() } }
    state asubw()  { self.console.write_line("    sub w0, w0, w1"); transition 0 { _ -> apush() } }
    state asubt()  { self.console.write_line("    subs w0, w0, w1"); self.console.write_line("    b.vs Ltrap"); transition 0 { _ -> apush() } }
    state asubsat(){ self.console.write_line("    subs w0, w0, w1"); self.console.write_line("    asr w2, w0, #31"); self.console.write_line("    movz w3, #0x8000, lsl #16"); self.console.write_line("    eor w2, w2, w3"); self.console.write_line("    csel w0, w2, w0, vs"); transition 0 { _ -> apush() } }
    state amul()   { transition self.wrap == 1 { true -> amulw()  false -> amuls() } }
    state amuls()  { transition self.wrap == 2 { true -> amulsat()  false -> amult() } }
    state amulw()  { self.console.write_line("    mul w0, w0, w1"); transition 0 { _ -> apush() } }
    state amulsat(){ self.console.write_line("    smull x0, w0, w1"); self.console.write_line("    sxtw x2, w0"); self.console.write_line("    asr x3, x0, #63"); self.console.write_line("    eor w3, w3, #0x7fffffff"); self.console.write_line("    cmp x0, x2"); self.console.write_line("    csel w0, w0, w3, eq"); transition 0 { _ -> apush() } }
    state amult()  { self.console.write_line("    smull x0, w0, w1"); self.console.write_line("    sxtw x2, w0"); self.console.write_line("    cmp x0, x2"); self.console.write_line("    b.ne Ltrap"); transition 0 { _ -> apush() } }
    state adiv()   { self.console.write_line("    cbz w1, Ltrap"); self.console.write_line("    sdiv w0, w0, w1"); transition 0 { _ -> apush() } }
    state arem()   { self.console.write_line("    cbz w1, Ltrap"); self.console.write_line("    sdiv w2, w0, w1"); self.console.write_line("    msub w0, w2, w1, w0"); transition 0 { _ -> apush() } }
    state aband()  { self.console.write_line("    and w0, w0, w1"); transition 0 { _ -> apush() } }
    state abor()   { self.console.write_line("    orr w0, w0, w1"); transition 0 { _ -> apush() } }
    state abxor()  { self.console.write_line("    eor w0, w0, w1"); transition 0 { _ -> apush() } }
    state ashl()   { self.console.write_line("    lsl w0, w0, w1"); transition 0 { _ -> apush() } }
    state ashr()   { self.console.write_line("    asr w0, w0, w1"); transition 0 { _ -> apush() } }
    state apush()  { self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> opretdisp() } }
    state opcont() { self.opnd = 0; transition 0 { _ -> opdisp() } }   // result is now the left operand of any following operator (left-assoc chain)
    state ec()    { transition self.cc == 0 { true -> eclt()  false -> ec1() } }
    state ec1()   { transition self.cc == 1 { true -> ecle()  false -> ec2() } }
    state ec2()   { transition self.cc == 2 { true -> eceq()  false -> ec3() } }
    state ec3()   { transition self.cc == 3 { true -> ecne()  false -> ec4() } }
    state ec4()   { transition self.cc == 4 { true -> ecgt()  false -> ecge() } }
    state eclt()  { write_byte(108); write_byte(116); transition 0 { _ -> ecend() } }
    state ecle()  { write_byte(108); write_byte(101); transition 0 { _ -> ecend() } }
    state eceq()  { write_byte(101); write_byte(113); transition 0 { _ -> ecend() } }
    state ecne()  { write_byte(110); write_byte(101); transition 0 { _ -> ecend() } }
    state ecgt()  { write_byte(103); write_byte(116); transition 0 { _ -> ecend() } }
    state ecge()  { write_byte(103); write_byte(101); transition 0 { _ -> ecend() } }
    state ecend() { write_byte(10); self.console.write_line("    str x0, [sp, #-16]!"); transition 0 { _ -> opretdisp() } }
    state toarms(){ transition self.buf[self.pos] == 123 { true -> arms0()  false -> toaadv() } }
    state toaadv(){ self.pos = self.pos + 1; transition 0 { _ -> toarms() } }
    state arms0() { self.console.write_line("    ldr x0, [sp], #16"); self.pos = self.pos + 1; self.tmi = self.mi; transition 0 { _ -> arm() } }   // '{', emit subject pop
    // arm loop: skip ws, then a pattern token (-> '_'/true/false/N), '->', target '(', emit dispatch; '}' ends
    state arm()   { transition self.buf[self.pos] <= 32 { true -> aadv()  false -> arm2() } }
    state aadv()  { self.pos = self.pos + 1; transition 0 { _ -> arm() } }
    state arm2()  { transition self.buf[self.pos] == 125 { true -> armend()  false -> patw() } }   // arms '}' -> continue the body walk
    state armend(){ self.nb = 0; self.pos = self.pos + 1; transition 0 { _ -> sk() } }   // arms done -> clear bindings so state bodies don't see them
    state patw()  { self.ps = self.pos; self.nb = 0; transition 0 { _ -> pwr() } }   // reset the payload bindings for this arm
    state pwr()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> pwa()  false -> pwe() } }
    state pwa()   { self.pos = self.pos + 1; transition 0 { _ -> pwr() } }
    state pwe()   { self.pe = self.pos; transition self.buf[self.pos] == 58 { true -> pvar0()  false -> cls() } }   // 'Type::Variant' arm pattern, else classify
    state pvar0() { self.pos = self.pos + 2; self.qa = self.pos; transition 0 { _ -> pvarr() } }
    state pvarr() { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> pvara()  false -> pvare() } }
    state pvara() { self.pos = self.pos + 1; transition 0 { _ -> pvarr() } }
    state pvare() { self.qb = self.pos; self.cj = 0; self.kind = 1; self.val = 0; transition 0 { _ -> pvlk() } }
    state pvlk()  { transition self.cj < self.nv { true -> pvlkc()  false -> ckbind() } }
    state pvlkc() { self.qc = self.vns[self.cj]; self.qd = self.vne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> pvlkh()  false -> pvlkn() } }
    state pvlkh() { self.val = self.vtag[self.cj]; transition 0 { _ -> ckbind() } }
    // payload binding: after a variant pattern, an optional `{ name }` binds name to the subject's payload (subjoff + 8)
    state ckbind(){ transition self.buf[self.pos] <= 32 { true -> ckbinda()  false -> ckbindc() } }   // skip ws
    state ckbinda(){ self.pos = self.pos + 1; transition 0 { _ -> ckbind() } }
    state ckbindc(){ transition self.buf[self.pos] == 123 { true -> bind0()  false -> toarrow() } }   // '{' -> a binding, else go to '->'
    state bind0() { self.pos = self.pos + 1; transition 0 { _ -> bindw() } }   // past '{'
    state bindw() { transition self.buf[self.pos] <= 32 { true -> bindws()  false -> bind1() } }
    state bindws(){ self.pos = self.pos + 1; transition 0 { _ -> bindw() } }
    state bind1() { self.bns[self.nb] = self.pos; transition 0 { _ -> bindr() } }                     // i-th binding name start
    state bindr() { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> binda()  false -> binde() } }
    state binda() { self.pos = self.pos + 1; transition 0 { _ -> bindr() } }
    state binde() { self.bne[self.nb] = self.pos; self.bndoff[self.nb] = self.subjoff + 8 + 8 * self.nb; self.nb = self.nb + 1; transition 0 { _ -> bindnx() } }   // i-th field at subject + 8 + 8*i
    state bindnx(){ transition self.buf[self.pos] <= 32 { true -> bindnxa()  false -> bindnxc() } }   // skip ws
    state bindnxa(){ self.pos = self.pos + 1; transition 0 { _ -> bindnx() } }
    state bindnxc(){ transition self.buf[self.pos] == 44 { true -> bindcom()  false -> bindend() } }  // ',' -> another field, else '}'
    state bindcom(){ self.pos = self.pos + 1; transition 0 { _ -> bindw() } }                          // past ',', next name
    state bindend(){ transition self.buf[self.pos] == 125 { true -> bindend2()  false -> bindenda() } } // skip to '}'
    state bindenda(){ self.pos = self.pos + 1; transition 0 { _ -> bindend() } }
    state bindend2(){ self.pos = self.pos + 1; transition 0 { _ -> toarrow() } }
    state pvlkn() { self.cj = self.cj + 1; transition 0 { _ -> pvlk() } }
    state cls()   { transition self.pe - self.ps == 1 { true -> cku()  false -> ckk() } }
    state cku()   { transition self.buf[self.ps] == 95 { true -> setWild()  false -> ckdig() } }  // '_'
    state setWild(){ self.kind = 0; transition 0 { _ -> toarrow() } }
    state ckk()   { self.w = self.is_true(self.ps, self.pe); transition self.w == 1 { true -> setT()  false -> ckf() } }
    state setT()  { self.kind = 1; self.val = 1; transition 0 { _ -> toarrow() } }
    state ckf()   { self.w = self.is_false(self.ps, self.pe); transition self.w == 1 { true -> setF()  false -> ckdig() } }
    state setF()  { self.kind = 1; self.val = 0; transition 0 { _ -> toarrow() } }
    state ckdig() { self.kind = 1; self.val = 0; self.cj = self.ps; transition 0 { _ -> diga() } } // int literal pattern
    state diga()  { transition self.cj < self.pe { true -> digacc()  false -> toarrow() } }
    state digacc(){ self.val = self.val * 10 + self.buf[self.cj] - 48; self.cj = self.cj + 1; transition 0 { _ -> diga() } }
    // advance to the target name (skip ws + the "->")
    state toarrow(){ transition self.buf[self.pos] == 45 { true -> arrskip()  false -> toa2() } }  // '-'
    state arrskip(){ self.pos = self.pos + 2; transition 0 { _ -> totgt() } }                      // skip "->"
    state toa2()  { self.pos = self.pos + 1; transition 0 { _ -> toarrow() } }
    state totgt() { transition self.buf[self.pos] <= 32 { true -> tgadv()  false -> tgt0() } }
    state tgadv() { self.pos = self.pos + 1; transition 0 { _ -> totgt() } }
    state tgt0()  { self.start = self.pos; transition 0 { _ -> tgr() } }
    state tgr()   { self.w = self.is_word(self.buf[self.pos]); transition self.w == 1 { true -> tga()  false -> tge() } }
    state tga()   { self.pos = self.pos + 1; transition 0 { _ -> tgr() } }
    state tge()   { self.qa = self.start; self.qb = self.pos; self.cj = 0; self.found = 0; transition 0 { _ -> lk() } } // resolve target -> tsi
    state lk()    { transition self.cj < self.ns { true -> lkc()  false -> emitA() } }
    state lkc()   { transition self.smi[self.cj] == self.tmi { true -> lkc2()  false -> lkn() } }
    state lkc2()  { self.qc = self.sns[self.cj]; self.qd = self.sne[self.cj]; self.w = self.streq(); transition self.w == 1 { true -> lkh()  false -> lkn() } }
    state lkh()   { self.tsi = self.ssi[self.cj]; self.found = 1; transition 0 { _ -> emitA() } }
    state lkn()   { self.cj = self.cj + 1; transition 0 { _ -> lk() } }
    // emit the arm
    state emitA() { transition self.found == 1 { true -> ekind()  false -> aend() } }
    state ekind() { transition self.kind == 0 { true -> ewild()  false -> eval() } }
    state ewild() { transition self.spls[self.cj] == 0 - 1 { true -> ewildp()  false -> ewilda() } }   // target has a param? -> pass the arg
    state ewildp(){ self.p_b(); self.emit_lab(); transition 0 { _ -> aend() } }                          // plain unconditional branch
    state ewilda(){ self.apbase = self.spls[self.cj]; self.aix = 0; transition 0 { _ -> ewa2() } }   // target's first param index + arg index 0
    state ewa2()  { transition self.buf[self.pos] == 40 { true -> ewa3()  false -> ewaadv() } }          // skip to '('
    state ewaadv(){ self.pos = self.pos + 1; transition 0 { _ -> ewa2() } }
    state ewa3()  { self.pos = self.pos + 1; transition 0 { _ -> ewargw() } }   // past '('
    state ewargw(){ transition self.buf[self.pos] <= 32 { true -> ewargws()  false -> ewargl() } }   // skip ws (also after ',')
    state ewargws(){ self.pos = self.pos + 1; transition 0 { _ -> ewargw() } }
    state ewargl(){ self.lstgt = 16 + 8 * (self.pcs[self.tmi] + self.apbase + self.aix); self.mode = 10; self.opnd = 0; transition 0 { _ -> subj0() } }   // lower arg aix -> param slot (mode 10 -> sargemit)
    state eval()  { transition self.spls[self.cj] == 0 - 1 { true -> evalp()  false -> evala() } }   // target has a param? -> store the arg on match
    state evalp() { self.p_movw1(); self.v = self.val; self.emit_int(); write_byte(10); self.console.write_line("    cmp w0, w1"); self.p_beq(); self.emit_lab(); transition 0 { _ -> aend() } }
    state evala() { self.p_movw1(); self.v = self.val; self.emit_int(); write_byte(10); self.console.write_line("    cmp w0, w1"); self.eskl = self.skl; self.skl = self.skl + 1; self.apbase = self.spls[self.cj]; self.aix = 0; self.p_bnesk(); self.v = self.eskl; self.emit_int(); write_byte(10); transition 0 { _ -> evarg() } }   // cmp; b.ne Lsk<eskl> (skip if no match)
    state evarg() { transition self.buf[self.pos] == 40 { true -> evarg2()  false -> evargadv() } }   // skip to '('
    state evargadv(){ self.pos = self.pos + 1; transition 0 { _ -> evarg() } }
    state evarg2(){ self.pos = self.pos + 1; transition 0 { _ -> eargw() } }   // past '('
    state eargw(){ transition self.buf[self.pos] <= 32 { true -> eargws()  false -> eargl() } }   // skip ws (also after ',')
    state eargws(){ self.pos = self.pos + 1; transition 0 { _ -> eargw() } }
    state eargl(){ self.lstgt = 16 + 8 * (self.pcs[self.tmi] + self.apbase + self.aix); self.mode = 11; self.opnd = 0; transition 0 { _ -> subj0() } }   // lower arg aix (mode 11 -> eargemit)
    state aend()  { transition self.buf[self.pos] == 41 { true -> aend2()  false -> aendsk() } }     // skip up to & incl ')' after target
    state aendsk(){ self.pos = self.pos + 1; transition 0 { _ -> aend() } }
    state aend2() { self.pos = self.pos + 1; transition 0 { _ -> arm() } }
    state endph() { transition self.phase == 0 { true -> p1()  false -> endph1() } }
    state endph1(){ transition self.phase == 1 { true -> p2()  false -> done() } }
    state p1()    { self.dsize = self.coff; self.phase = 1; self.pos = 0; self.mi = 0 - 1; self.depth = 0; self.pend = 0; self.nl = 0; self.lpend = 0; self.ns = 0; self.si = 0; self.mn = 0; self.mdecl = 0; self.insig = 0; self.np = 0; transition 0 { _ -> sk() } }   // capture the entry struct's data size (coff is final after phase 0)
    state p2()    { self.console.write_line("// generated by the proof kernel-rs aarch64 backend (slices 1-2, 4-6)"); self.console.write_line(".global _main"); self.console.write_line(".align 2"); self.phase = 2; self.pos = 0; self.mi = 0 - 1; self.lsi = 0; self.depth = 0; self.pend = 0; transition 0 { _ -> sk() } }   // emit the asm header before any machine
    state done()  { self.emit_epilogue(); self.console.write_line("Ltrap:"); self.console.write_line("    brk #0x1"); transition self.dsize > 0 { true -> wself()  false -> wdone() } }
    state wself() { self.fv = (self.dsize + 7) / 8 * 8; self.p_zerosd(); self.v = self.fv; self.emit_int(); write_byte(44); write_byte(51); write_byte(10); transition 0 { _ -> wdone() } }   // .zerofill ...,_selfdata,align8(dsize),3
    state wdone() { transition self.usesio > 0 { true -> wio()  false -> wfin() } }
    state wio()   { self.console.write_line(".zerofill __DATA,__bss,_iobyte,1,0"); transition 0 { _ -> wfin() } }
    state wfin()  { transition self.nstr > 0 { true -> wsec()  false -> wexit() } }
    state wexit() { self.console.exit_process(0) }
    state wsec()  { self.console.write_line(".section __TEXT,__const"); self.console.write_line(".align 2"); self.pos = 0; self.lstri = 0; transition 0 { _ -> rps() } }
    // re-scan the source for write_line string literals (in source order = nstr order); skip // comments
    state rps()   { transition self.pos < self.n { true -> rps2()  false -> wexit() } }
    state rps2()  { transition self.buf[self.pos] == 47 { true -> rpcm()  false -> rps3() } }   // '/'
    state rpcm()  { transition self.buf[self.pos + 1] == 47 { true -> rpcm2()  false -> rpadv() } }   // '//' comment
    state rpcm2() { transition self.buf[self.pos] == 10 { true -> rpadv()  false -> rpcmadv() } }     // skip to newline
    state rpcmadv(){ self.pos = self.pos + 1; transition 0 { _ -> rpcm2() } }
    state rps3()  { transition self.buf[self.pos] == 34 { true -> rpstr()  false -> rpadv() } }   // '"' -> string literal
    state rpadv() { self.pos = self.pos + 1; transition 0 { _ -> rps() } }
    state rpstr() { self.p_lstr(); self.v = self.lstri; self.emit_int(); write_byte(58); write_byte(10); self.p_dotbyte(); self.pos = self.pos + 1; transition 0 { _ -> rpbyte() } }   // Lstr<i>:\n    .byte  ; skip opening '"'
    state rpbyte(){ transition self.buf[self.pos] == 34 { true -> rpbend()  false -> rpb2() } }   // closing '"'?
    state rpb2()  { self.v = self.buf[self.pos]; self.emit_int(); write_byte(44); self.pos = self.pos + 1; transition 0 { _ -> rpbyte() } }   // "<byte>,"
    state rpbend(){ self.v = 10; self.emit_int(); write_byte(10); self.pos = self.pos + 1; self.lstri = self.lstri + 1; transition 0 { _ -> rps() } }
}
