// A TOKENIZER written in Delta — the first real stage of a Delta-in-Delta
// compiler (not a toy-language demo; this splits genuine source text). Reads from
// stdin and writes each token (lexeme) on its own line to stdout. A token is a
// maximal run of "word" characters (letters, digits, '_') or a single punctuation
// character; whitespace (any byte <= 32) separates and is dropped, and "//" line
// comments are dropped through end-of-line.
//   printf 'machine f(x){return x+1;}' | tokenize
//     -> machine / f / ( / x / ) / { / return / x / + / 1 / ; / }   (one per line)
// Keyword classification and multi-char operators (-> :: &mut) are clean follow-ups;
// this is the tokenization core plus comment handling.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 512]; n: i32; pos: i32; c: i32; start: i32; w: i32; ei: i32; tw: i32;
}

// is (a, b) a two-character operator? -> :: == != <= >= ; returns 2 or 0.
machine Main::two_op(&mut self, a: i32, b: i32) -> i32 {
    transition a == 45 { true -> o_arrow()  false -> o1() }      // '-'
    state o_arrow() { transition b == 62 { true -> two()  false -> none() } }  // "->"
    state o1() { transition a == 58 { true -> o_colon()  false -> o2() } }     // ':'
    state o_colon() { transition b == 58 { true -> two()  false -> none() } }  // "::"
    state o2() { transition b == 61 { true -> o_eq()  false -> none() } }      // second char '='?
    state o_eq()  { transition a == 61 { true -> two()  false -> o_eq2() } }   // "=="
    state o_eq2() { transition a == 33 { true -> two()  false -> o_eq3() } }   // "!="
    state o_eq3() { transition a == 60 { true -> two()  false -> o_eq4() } }   // "<="
    state o_eq4() { transition a == 62 { true -> two()  false -> none() } }    // ">="
    state two()  { return 2; }
    state none() { return 0; }
}

// is this byte a word character? letters, digits, or '_'.
machine Main::is_word(&mut self, c: i32) -> i32 {
    transition c == 95 { true -> yes()  false -> w1() }     // '_'
    state w1() { transition c < 48  { true -> no()  false -> w2() } }   // below '0'
    state w2() { transition c <= 57 { true -> yes() false -> w3() } }   // '0'..'9'
    state w3() { transition c < 65  { true -> no()  false -> w4() } }   // 58..64
    state w4() { transition c <= 90 { true -> yes() false -> w5() } }   // 'A'..'Z'
    state w5() { transition c < 97  { true -> no()  false -> w6() } }   // 91..96
    state w6() { transition c <= 122 { true -> yes() false -> no() } }  // 'a'..'z'
    state yes() { return 1; }
    state no()  { return 0; }
}

// write buf[a..b] then a newline.
machine Main::emit_range(&mut self, a: i32, b: i32) {
    self.ei = a;
    transition 0 { _ -> eloop() }
    state eloop() { transition self.ei < b { true -> ew()  false -> enl() } }
    state ew()    { write_byte(self.buf[self.ei]); self.ei = self.ei + 1; transition 0 { _ -> eloop() } }
    state enl()   { write_byte(10); }
}

machine Main::main(&mut self) {
    self.n = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> tok()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }

    state tok()      { self.pos = 0; transition 0 { _ -> skipws() } }
    state skipws()   { transition self.pos < self.n { true -> wsck()  false -> fin() } }
    state wsck()     { transition self.buf[self.pos] <= 32 { true -> wsadv()  false -> commck() } }
    state wsadv()    { self.pos = self.pos + 1; transition 0 { _ -> skipws() } }
    // line comments: "//" to end of line is dropped (then re-enter skipws so runs
    // of whitespace and comments are all skipped before the next token).
    state commck()   { transition self.buf[self.pos] == 47 { true -> commck2()  false -> begin() } }
    state commck2()  { transition self.buf[self.pos + 1] == 47 { true -> skipcomm()  false -> begin() } }
    state skipcomm() { transition self.pos < self.n { true -> commnl()  false -> fin() } }
    state commnl()   { transition self.buf[self.pos] == 10 { true -> skipws()  false -> commadv() } }
    state commadv()  { self.pos = self.pos + 1; transition 0 { _ -> skipcomm() } }
    state begin() {
        self.start = self.pos;
        self.w = self.is_word(self.buf[self.pos]);
        transition self.w == 1 { true -> wordrun()  false -> punct() }
    }
    state wordrun()  { transition self.pos < self.n { true -> wrck()  false -> emit() } }
    state wrck() {
        self.w = self.is_word(self.buf[self.pos]);
        transition self.w == 1 { true -> wradv()  false -> emit() }
    }
    state wradv()    { self.pos = self.pos + 1; transition 0 { _ -> wordrun() } }
    // punctuation: a two-char operator (-> :: == != <= >=) or a single char.
    state punct() {
        self.tw = self.two_op(self.buf[self.pos], self.buf[self.pos + 1]);
        transition self.tw == 2 { true -> punct2()  false -> punct1() }
    }
    state punct1()   { self.pos = self.pos + 1; transition 0 { _ -> emit() } }
    state punct2()   { self.pos = self.pos + 2; transition 0 { _ -> emit() } }
    state emit()     { self.emit_range(self.start, self.pos); transition 0 { _ -> skipws() } }
    state fin()      { self.console.exit_process(0) }
}
