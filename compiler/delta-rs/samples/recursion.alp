// Recursion: a machine that calls ITSELF. The "call graph is a DAG" note describes
// the conceptual model, but the machine-code mechanism (bl + a fresh frame per
// call) handles self-recursion fine — each invocation gets its own locals/params.
// This is the shape recursive descent (parse, codegen) takes, so it matters for a
// self-hosting Delta compiler.
//
// fact(5) = 5*4*3*2*1 = 120; tri(9) = 9+8+...+1 = 45; we exit with fact(5).
boundary trait Console { machine exit_process(return_code: i32); }
data Main { console: Console; }

machine fact(n: i32) -> i32 {
    transition n <= 1 {
        true -> base()
        _    -> recurse()
    }
    state base()    { return 1; }
    state recurse() { return n * fact(n - 1); }
}

machine Main::main(&mut self) {
    self.console.exit_process(fact(5))
}
