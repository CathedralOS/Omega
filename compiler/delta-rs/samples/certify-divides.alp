// CERTIFYING COMPUTATION, fourth form — a MULTIPLICATIVE obligation. The earlier
// certifiers prove equalities, orderings, and additive array bounds; this one proves
// DIVISIBILITY, n | a, the witness shape underlying the GCD / prime / factorization
// theory in delta. It reads n and a (with n dividing a), computes the cofactor
// q = a / n, and emits a proof certificate of
//   n | a   ==   exists w. w*n = a
// namely  (Exists (= (m (v 0) N) A)) (wit (= (m (v 0) N) A) Q (refl A)).
// The trust anchor checks that q*n really reduces to a -- so a program proves a
// number-theoretic fact about its own data, machine-checked end to end.
//   printf '3 12' | certify-divides | check.exe  ->  accept   (3 | 12, cofactor 4)
// Contract: n | a and n > 0. Naturals are the checker's unary form; * is raw `m`;
// (v 0) is the bound variable w under the existential.
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    dn: i32; da: i32; dq: i32; uv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
// the proposition body  (= (m (v 0) N) A)  -- shared by the Exists and the wit.
machine Main::emit_body(&mut self) {
    write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(109); write_byte(32); // "(= (m "
    write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(32); // "(v 0) "
    self.emit_nat(self.dn);
    write_byte(41); write_byte(32);                                                                  // ") "
    self.emit_nat(self.da);
    write_byte(41);                                                                                  // ")"
}
machine Main::main(&mut self) {
    self.n = 0; self.dn = 0; self.da = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> pa() } }
    state pa()    { transition self.buf[self.pos] < 48 { true -> skipnd()  false -> paHi() } }
    state paHi()  { transition self.buf[self.pos] > 57 { true -> skipnd()  false -> paD() } }
    state paD()   { self.dn = self.dn * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pa() } }
    state skipnd(){ transition self.pos < self.n { true -> snd()  false -> compute() } }
    state snd()   { transition self.buf[self.pos] < 48 { true -> snda()  false -> sndHi() } }
    state sndHi() { transition self.buf[self.pos] > 57 { true -> snda()  false -> pb() } }
    state snda()  { self.pos = self.pos + 1; transition 0 { _ -> skipnd() } }
    state pb()    { transition self.buf[self.pos] < 48 { true -> compute()  false -> pbHi() } }
    state pbHi()  { transition self.buf[self.pos] > 57 { true -> compute()  false -> pbD() } }
    state pbD()   { self.da = self.da * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pb() } }
    // cofactor: q = a / n  (exact, since n | a)
    state compute(){ self.dq = self.da / self.dn; transition 0 { _ -> emit() } }
    // emit  (Exists BODY) (wit BODY Q (refl A))
    state emit() {
        write_byte(40); write_byte(69); write_byte(120); write_byte(105); write_byte(115);
        write_byte(116); write_byte(115); write_byte(32);                         // "(Exists "
        self.emit_body();
        write_byte(41); write_byte(32);                                           // ") "
        write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32); // "(wit "
        self.emit_body();
        write_byte(32);                                                           // " "
        self.emit_nat(self.dq);
        write_byte(32); write_byte(40); write_byte(114); write_byte(101);
        write_byte(102); write_byte(108); write_byte(32);                         // " (refl "
        self.emit_nat(self.da);
        write_byte(41); write_byte(41);                                           // "))"
        self.console.exit_process(0)
    }
}
