// CERTIFYING COMPILER, universal-loop linkage. A bounded loop "for i in 0..K {
// arr[i][J] }" into an m-by-n array is proved safe ONCE, not by unrolling K accesses:
// it emits a single forall-quantified proof  forall i. i<K -> i*n+j < m*n  that CITES
// two library theorems composed -- lt-le-trans (i<K & K<=m -> i<m) and bounds-2d
// (i<m & j<n -> i*n+j < m*n). The proof structure is fixed; only the loop's constants
// (K, n, j, m and the premises m-K, n-j-1) vary. A linker prepends the proof library
// (bounds-2d = use 30, lt-le-trans = use 34) and the trust anchor checks the whole.
//   { lib.proof ; printf 'K n j m' | certify-loop ; } | check.exe  ->  accept
// Contract: K<=m and j<n. Reads K n j m. (use ids 30/34 are the linker contract.)
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; n: i32; pos: i32; c: i32;
    nums: [i32; 4]; ni: i32; cur: i32; wmk: i32; wnj: i32; uv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
machine Main::main(&mut self) {
    self.n = 0; self.ni = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> go()  false -> store() } }
    state store() { self.buf[self.n] = self.c; self.n = self.n + 1; transition 0 { _ -> rd() } }
    state go()    { self.pos = 0; transition 0 { _ -> nxt() } }
    state nxt()   { transition self.ni < 4 { true -> sk()  false -> compute() } }
    state sk()    { transition self.pos < self.n { true -> skc()  false -> compute() } }
    state skc()   { transition self.buf[self.pos] < 48 { true -> ad()  false -> skh() } }
    state skh()   { transition self.buf[self.pos] > 57 { true -> ad()  false -> pn() } }
    state ad()    { self.pos = self.pos + 1; transition 0 { _ -> sk() } }
    state pn()    { self.cur = 0; transition 0 { _ -> pd() } }
    state pd()    { transition self.buf[self.pos] < 48 { true -> pv()  false -> pdh() } }
    state pdh()   { transition self.buf[self.pos] > 57 { true -> pv()  false -> pa() } }
    state pa()    { self.cur = self.cur * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pd() } }
    state pv()    { self.nums[self.ni] = self.cur; self.ni = self.ni + 1; transition 0 { _ -> nxt() } }
    // premises, with the loop-safety check (K<=m and j<n)
    state compute(){ self.wmk = self.nums[3] - self.nums[0]; self.wnj = self.nums[1] - self.nums[2] - 1;
                     transition self.nums[0] <= self.nums[3] { true -> ck2()  false -> rej() } }
    state ck2()    { transition self.nums[2] < self.nums[1] { true -> emit()  false -> rej() } }
    state rej()    { write_byte(117); write_byte(110); write_byte(115); write_byte(97); write_byte(102); write_byte(101); write_byte(10); self.console.exit_process(1) }
    state emit() {
        write_byte(40); write_byte(65); write_byte(108); write_byte(108); write_byte(32); write_byte(40); write_byte(45); write_byte(62); write_byte(32); write_byte(40); write_byte(69); write_byte(120);
        write_byte(105); write_byte(115); write_byte(116); write_byte(115); write_byte(32); write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32); write_byte(40);
        write_byte(118); write_byte(32); write_byte(49); write_byte(41); write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40); write_byte(118); write_byte(32); write_byte(48);
        write_byte(41); write_byte(41); write_byte(41); write_byte(32);
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(41); write_byte(32); write_byte(40); write_byte(69); write_byte(120); write_byte(105); write_byte(115); write_byte(116); write_byte(115); write_byte(32); write_byte(40);
        write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32); write_byte(40); write_byte(112); write_byte(32); write_byte(40); write_byte(109); write_byte(32); write_byte(40);
        write_byte(118); write_byte(32); write_byte(49); write_byte(41); write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.nums[2]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(41);
        write_byte(32); write_byte(40); write_byte(109); write_byte(32);
        self.emit_nat(self.nums[3]);
        write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(41); write_byte(41); write_byte(41); write_byte(41);
        write_byte(32);
        write_byte(40); write_byte(103); write_byte(101); write_byte(110); write_byte(32); write_byte(40); write_byte(108); write_byte(97); write_byte(109); write_byte(32); write_byte(40); write_byte(69);
        write_byte(120); write_byte(105); write_byte(115); write_byte(116); write_byte(115); write_byte(32); write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);
        write_byte(40); write_byte(118); write_byte(32); write_byte(49); write_byte(41); write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40); write_byte(118); write_byte(32);
        write_byte(48); write_byte(41); write_byte(41); write_byte(41); write_byte(32);
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(41); write_byte(32); write_byte(40); write_byte(97); write_byte(112); write_byte(112); write_byte(32); write_byte(40); write_byte(97); write_byte(112); write_byte(112);
        write_byte(32); write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32); write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116);
        write_byte(32); write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32); write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116);
        write_byte(32); write_byte(40); write_byte(117); write_byte(115); write_byte(101); write_byte(32); write_byte(51); write_byte(48); write_byte(41); write_byte(32); write_byte(40); write_byte(118);
        write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.nums[2]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.nums[3]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(97); write_byte(112); write_byte(112); write_byte(32); write_byte(40); write_byte(97); write_byte(112); write_byte(112); write_byte(32);
        write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32); write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32);
        write_byte(40); write_byte(105); write_byte(110); write_byte(115); write_byte(116); write_byte(32); write_byte(40); write_byte(117); write_byte(115); write_byte(101); write_byte(32); write_byte(51);
        write_byte(52); write_byte(41); write_byte(32); write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(32);
        self.emit_nat(self.nums[0]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.nums[3]);
        write_byte(41); write_byte(32); write_byte(40); write_byte(104); write_byte(121); write_byte(112); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(32); write_byte(40);
        write_byte(119); write_byte(105); write_byte(116); write_byte(32); write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(112); write_byte(32);
        self.emit_nat(self.nums[0]);
        write_byte(32); write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(32);
        self.emit_nat(self.nums[3]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.wmk);
        write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32);
        self.emit_nat(self.nums[3]);
        write_byte(41); write_byte(41); write_byte(41); write_byte(41); write_byte(32); write_byte(40); write_byte(119); write_byte(105); write_byte(116); write_byte(32); write_byte(40); write_byte(61);
        write_byte(32); write_byte(40); write_byte(112); write_byte(32);
        self.emit_nat(self.nums[2]);
        write_byte(32); write_byte(40); write_byte(115); write_byte(32); write_byte(40); write_byte(118); write_byte(32); write_byte(48); write_byte(41); write_byte(41); write_byte(41); write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(32);
        self.emit_nat(self.wnj);
        write_byte(32); write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32);
        self.emit_nat(self.nums[1]);
        write_byte(41); write_byte(41); write_byte(41); write_byte(41); write_byte(41);
        self.console.exit_process(0)
    }
}
