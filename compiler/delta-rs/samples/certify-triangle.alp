// CERTIFYING COMPUTATION against a CLOSED FORM. This program accumulates a sum in a
// loop -- s = 1 + 2 + ... + n -- and then emits a proof certificate that the value it
// computed satisfies GAUSS'S formula:
//   2 * s = n * (n + 1)
// = (= (m (s (s z)) s) (m n (s n)))  proved by refl, since both sides reduce to the
// same number. So the trust anchor confirms an iterative accumulation matches its
// mathematical closed form -- a different correctness flavor than divisibility (gcd)
// or ordering (sort): a loop result verified against a formula.
//   printf '4' | certify-triangle | check.exe   ->  accept   (1+2+3+4 = 10, 2*10 = 4*5)
boundary trait Console {
    machine exit_process(return_code: i32);
    machine write_byte(b: i32);
    machine read_byte() -> i32;
}
data Main {
    console: Console;
    buf: [u8; 64]; blen: i32; pos: i32; c: i32;
    nn: i32; s: i32; i: i32; uv: i32;
}
machine Main::emit_nat(&mut self, v: i32) {
    self.uv = v;
    transition 0 { _ -> uo() }
    state uo()   { transition self.uv == 0 { true -> uz()  false -> uo2() } }
    state uo2()  { write_byte(40); write_byte(115); write_byte(32); self.uv = self.uv - 1; transition 0 { _ -> uo() } }
    state uz()   { write_byte(122); self.uv = v; transition 0 { _ -> uc() } }
    state uc()   { transition self.uv == 0 { true -> ud()  false -> uc2() } }
    state uc2()  { write_byte(41); self.uv = self.uv - 1; transition 0 { _ -> uc() } }
    state ud()   {}
}
machine Main::main(&mut self) {
    self.blen = 0; self.nn = 0;
    transition 0 { _ -> rd() }
    state rd()    { self.c = read_byte(); transition self.c < 0 { true -> parse()  false -> store() } }
    state store() { self.buf[self.blen] = self.c; self.blen = self.blen + 1; transition 0 { _ -> rd() } }
    // parse the single number n
    state parse() { self.pos = 0; transition 0 { _ -> pskip() } }
    state pskip() { transition self.pos < self.blen { true -> pck()  false -> sum() } }
    state pck()   { transition self.buf[self.pos] < 48 { true -> padv()  false -> pckh() } }
    state pckh()  { transition self.buf[self.pos] > 57 { true -> padv()  false -> pd() } }
    state padv()  { self.pos = self.pos + 1; transition 0 { _ -> pskip() } }
    state pd()    { transition self.buf[self.pos] < 48 { true -> sum()  false -> pdh() } }
    state pdh()   { transition self.buf[self.pos] > 57 { true -> sum()  false -> pacc() } }
    state pacc()  { self.nn = self.nn * 10 + (self.buf[self.pos] - 48); self.pos = self.pos + 1; transition 0 { _ -> pd() } }
    // accumulate s = 1 + 2 + ... + n
    state sum()   { self.s = 0; self.i = 1; transition 0 { _ -> sloop() } }
    state sloop() { transition self.i <= self.nn { true -> sadd()  false -> emit() } }
    state sadd()  { self.s = self.s + self.i; self.i = self.i + 1; transition 0 { _ -> sloop() } }
    state emit() {
        // goal:  (= (m (s (s z)) s) (m n (s n)))      -- 2*s = n*(n+1)
        write_byte(40); write_byte(61); write_byte(32); write_byte(40); write_byte(109); write_byte(32);
        write_byte(40); write_byte(115); write_byte(32); write_byte(40); write_byte(115); write_byte(32);
        write_byte(122); write_byte(41); write_byte(41); write_byte(32);                  // "(= (m (s (s z)) "
        self.emit_nat(self.s);
        write_byte(41); write_byte(32); write_byte(40); write_byte(109); write_byte(32);  // ") (m "
        self.emit_nat(self.nn);
        write_byte(32); write_byte(40); write_byte(115); write_byte(32);                  // " (s "
        self.emit_nat(self.nn);
        write_byte(41); write_byte(41); write_byte(41); write_byte(32);                   // "))) "
        // proof:  (refl (m (s (s z)) s))
        write_byte(40); write_byte(114); write_byte(101); write_byte(102); write_byte(108); write_byte(32);
        write_byte(40); write_byte(109); write_byte(32); write_byte(40); write_byte(115); write_byte(32);
        write_byte(40); write_byte(115); write_byte(32); write_byte(122); write_byte(41); write_byte(41); write_byte(32); // "(refl (m (s (s z)) "
        self.emit_nat(self.s);
        write_byte(41); write_byte(41);                                                   // "))"
        self.console.exit_process(0)
    }
}
