; eps2gamma.beta — the epsilon->gamma MEANING translator, written in Beta (Rust-FREE).
;
; Rust-free counterpart to epsilon-rs/src/gamma_emit.rs. rungs/epsilon.md: epsilon's meaning is defined
; by the reference interpreter, not the native backend. gamma_emit.rs pins that meaning but is RUST; this
; removes it — reads epsilon SOURCE on stdin, prints a gamma s-expr on stdout, which the Rust-free
; reference interpreter (gamma/interp.beta) runs. Both halves of the meaning route are now Rust-free.
;
; SUPPORTED SUBSET — a single entry machine `Main::main` with i32 locals and scalar i32 self-fields
; (no arrays / cross-machine calls / read_byte yet):
;   machine Main::main(&mut self) {
;       let a: i32 = <expr>;                      ; entry: locals, declared here
;       self.f = <expr>;                          ; self-field write (fields declared in `data Main`)
;       transition <subj> { <pat> -> <state>() ...}   ; and/or a terminal exit
;       self.console.exit_process(<expr>)
;       state name() { <stmt>* <terminal> }       ; parameterless states
;   }
; <expr> (slice 0) := integer arithmetic + - * / %, parens, integer literals, locals.
; <expr> (slice 1) := also comparisons < > <= >= == != (lowest precedence), via interp's eq/lt.
; <expr> (slice 3) := also `self.f` field reads.
; <stmt>  := local assignment `x = <expr>;`  OR  self-field write `self.f = <expr>;` (slice 3).
; <terminal> := `transition <subj> { <arm>* }` (arm = <pat> -> <state>() ; pat = int|true|false|_,
;   last arm is the default/else) OR `self.console.exit_process(<expr>)`.
;
; Emission (matching gamma_emit.rs slices 3-4): the machine becomes mutually-recursive gamma defs sharing
; the full-slot signature `(l0.. g0..)` — `(def m0_me (l0.. g0..) <entry>) (def m0_s{k} (..) <state k>) ...
; (m0_me 0..)`. Mutation is SSA-threaded: each write `x = e` (local or field) -> `(let t{fresh}
; <e-under-current-names> <rest>)`, updating a per-block name map. A transition -> nested `(if (eq subj
; pat) (target <current names>) else)`, last arm the default. Fields thread like locals (slot g{i}),
; zero-initialised. A straight-line main falls out as the no-states case.
;
; Memory:  2097152 SRC  2097144 CUR  2097136 LEN  2097128 APTR (arena@3145728)
; Scratch: 6000000 LOCAL_CNT  6000008 STATE_CNT  6000016 ENTRY_START  6000024 FRESH  6000032 FIELD_CNT
;          6100000 NAMES[k]  6200000 STATE_NAME[s]  6300000 STATE_BODY[s]  6800000 FIELD_NAME[g]
;          6400000 CURKIND[i]/6500000 CURVAL[i] (locals)   6420000 FCURKIND[g]/6520000 FCURVAL[g] (fields)
;          (kind 0 = param l{i}/g{g}, 1 = t{val})   6600000 ARM_PAT[j]  6700000 ARM_TGT[j]
; AST nodes are 4 words [tag,f0,f1,f2] (32-byte stride): 0 INT(v)  1 LOCAL(idx)  2 BIN(opchar,a,b)  3 FIELD(g).

proc slurp() {
    let n = 0
    let c = read_byte()
    state loop { to body when (c >= 0)  to done }
    state body {
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
        to loop
    }
    state done {
        word[2097136] = n         ; LEN
        word[2097144] = 0         ; CUR
        word[2097128] = 3145728   ; APTR (arena base)
    }
}

proc cbyte() {
    let i = word[2097144]
    state chk { to hit when (i < word[2097136])  return 0 }
    state hit { return byte[2097152 + i] }
}

proc adv() { word[2097144] = word[2097144] + 1 }

proc alloc(tag, f0, f1, f2) {
    let p = word[2097128]
    word[p] = tag
    word[p + 8] = f0
    word[p + 16] = f1
    word[p + 24] = f2
    word[2097128] = p + 32
    return p
}

proc is_space(c) {
    state c1 { to yes when (c == ' ')  to c2 }
    state c2 { to yes when (c == 9)    to c3 }
    state c3 { to yes when (c == 10)   to c4 }
    state c4 { to yes when (c == 13)   return 0 }
    state yes { return 1 }
}

proc is_digit(c) {
    state c1 { to no when (c < '0')  to c2 }
    state c2 { to no when (c > '9')  return 1 }
    state no { return 0 }
}

; an identifier character: [a-zA-Z0-9_]
proc is_idchar(c) {
    state a1 { to a2 when (c < 'a')  to yes when (c <= 'z')  to a2 }
    state a2 { to a3 when (c < 'A')  to yes when (c <= 'Z')  to a3 }
    state a3 { to a4 when (c < '0')  to yes when (c <= '9')  to a4 }
    state a4 { to yes when (c == '_')  return 0 }
    state yes { return 1 }
}

; skip whitespace and `//` line comments (epsilon uses //). A lone '/' is the divide op.
proc skip_ws() {
    state loop {
        let c = cbyte()
        to sp when (is_space(c) == 1)
        to slash when (c == '/')
        return 0
    }
    state sp { adv()  to loop }
    state slash {
        to cmt when (byte[2097152 + word[2097144] + 1] == '/')
        return 0                       ; not `//` -> the divide operator
    }
    state cmt {
        to loop when (cbyte() == 10)
        to ceof when (cbyte() == 0)
        adv()
        to cmt
    }
    state ceof { return 0 }
}

proc skip_ident() {
    state loop {
        to body when (is_idchar(cbyte()) == 1)
        return 0
    }
    state body { adv()  to loop }
}

proc parse_number() {
    let v = 0
    state loop {
        to body when (is_digit(cbyte()) == 1)
        return v
    }
    state body {
        v = v * 10 + (cbyte() - '0')
        adv()
        to loop
    }
}

; do the identifiers at SRC offsets o1 and o2 (each ending at a non-idchar) match?
proc name_eq2(o1, o2) {
    let i = 0
    state loop {
        let c1 = byte[2097152 + o1 + i]
        let c2 = byte[2097152 + o2 + i]
        to c1end when (is_idchar(c1) == 0)
        to mism when (is_idchar(c2) == 0)
        to mism when (c1 != c2)
        i = i + 1
        to loop
    }
    state c1end { to mism when (is_idchar(c2) == 1)  return 1 }
    state mism { return 0 }
}

; map an identifier at offset `off` to its local index (its NAMES slot). -> 0 if unknown.
proc lookup_local(off) {
    let k = 0
    state loop {
        to nomatch when (k == word[6000000])
        to hit when (name_eq2(off, word[6100000 + k * 8]) == 1)
        k = k + 1
        to loop
    }
    state hit { return k }
    state nomatch { return 0 }
}

; map a state name at offset `off` to its state index. -> 0 if unknown.
proc lookup_state(off) {
    let k = 0
    state loop {
        to nomatch when (k == word[6000008])
        to hit when (name_eq2(off, word[6200000 + k * 8]) == 1)
        k = k + 1
        to loop
    }
    state hit { return k }
    state nomatch { return 0 }
}

; map a self-field name at offset `off` to its field slot index. -> 0 if unknown.
proc field_lookup(off) {
    let k = 0
    state loop {
        to nomatch when (k == word[6000032])          ; FIELD_CNT
        to hit when (name_eq2(off, word[6800000 + k * 8]) == 1)
        k = k + 1
        to loop
    }
    state hit { return k }
    state nomatch { return 0 }
}

; ---- expression parser: precedence-climbing, builds a left-associative AST ----

proc parse_term() {
    skip_ws()
    let c = cbyte()
    state disp {
        to paren when (c == '(')
        to lit when (is_digit(c) == 1)
        to ident
    }
    state ident {
        to selffield when (is_self() == 1)
        let off = word[2097144]
        skip_ident()
        return alloc(1, lookup_local(off), 0, 0)
    }
    state selffield {                  ; `self.NAME` -> a field read (AST tag 3)
        skip_ident()                   ; past "self"
        adv()                          ; past '.'
        let foff = word[2097144]
        skip_ident()                   ; past field name
        return alloc(3, field_lookup(foff), 0, 0)
    }
    state paren {
        adv()
        let e = parse_cmp()
        skip_ws()
        adv()
        return e
    }
    state lit { return alloc(0, parse_number(), 0, 0) }
}

proc parse_product() {
    let a = parse_term()
    state loop {
        skip_ws()
        let c = cbyte()
        to mul when (c == '*')
        to divd when (c == '/')
        to modo when (c == '%')
        return a
    }
    ; distinct temp names per state (bc keys locals by name proc-wide; reuse collides slots)
    state mul  { adv()  let bm = parse_term()  a = alloc(2, '*', a, bm)  to loop }
    state divd { adv()  let bd = parse_term()  a = alloc(2, '/', a, bd)  to loop }
    state modo { adv()  let bo = parse_term()  a = alloc(2, '%', a, bo)  to loop }
}

proc parse_sum() {
    let a = parse_product()
    state loop {
        skip_ws()
        let c = cbyte()
        to add when (c == '+')
        to sub when (c == '-')
        return a
    }
    state add { adv()  let bp = parse_product()  a = alloc(2, '+', a, bp)  to loop }
    state sub { adv()  let bs = parse_product()  a = alloc(2, '-', a, bs)  to loop }
}

; comparisons — the LOWEST precedence level; op chars: < > = (==) L (<=) G (>=) N (!=)
proc parse_cmp() {
    let a = parse_sum()
    state loop {
        skip_ws()
        let c = cbyte()
        to lt when (c == '<')
        to gt when (c == '>')
        to eqx when (c == '=')
        to nex when (c == '!')
        return a
    }
    state lt {
        adv()
        to le when (cbyte() == '=')
        let bl = parse_sum()
        a = alloc(2, '<', a, bl)
        to loop
    }
    state le  { adv()  let ble = parse_sum()  a = alloc(2, 'L', a, ble)  to loop }
    state gt {
        adv()
        to ge when (cbyte() == '=')
        let bg = parse_sum()
        a = alloc(2, '>', a, bg)
        to loop
    }
    state ge  { adv()  let bge = parse_sum()  a = alloc(2, 'G', a, bge)  to loop }
    state eqx { adv()  adv()  let beq = parse_sum()  a = alloc(2, '=', a, beq)  to loop }
    state nex { adv()  adv()  let bne = parse_sum()  a = alloc(2, 'N', a, bne)  to loop }
}

; ---- keyword detectors (bytes at CUR spell WORD, then a non-idchar boundary) ----

proc is_let() {
    let o = word[2097144]
    state c1 { to c2 when (byte[2097152 + o] == 'l')  return 0 }
    state c2 { to c3 when (byte[2097152 + o + 1] == 'e')  return 0 }
    state c3 { to c4 when (byte[2097152 + o + 2] == 't')  return 0 }
    state c4 { to yes when (is_idchar(byte[2097152 + o + 3]) == 0)  return 0 }
    state yes { return 1 }
}

proc is_state() {
    let o = word[2097144]
    state c1 { to c2 when (byte[2097152 + o] == 's')  return 0 }
    state c2 { to c3 when (byte[2097152 + o + 1] == 't')  return 0 }
    state c3 { to c4 when (byte[2097152 + o + 2] == 'a')  return 0 }
    state c4 { to c5 when (byte[2097152 + o + 3] == 't')  return 0 }
    state c5 { to c6 when (byte[2097152 + o + 4] == 'e')  return 0 }
    state c6 { to yes when (is_idchar(byte[2097152 + o + 5]) == 0)  return 0 }
    state yes { return 1 }
}

proc is_transition() {
    let o = word[2097144]
    state c1 { to c2 when (byte[2097152 + o] == 't')  return 0 }
    state c2 { to c3 when (byte[2097152 + o + 1] == 'r')  return 0 }
    state c3 { to c4 when (byte[2097152 + o + 2] == 'a')  return 0 }
    state c4 { to c5 when (byte[2097152 + o + 3] == 'n')  return 0 }
    state c5 { to c6 when (byte[2097152 + o + 4] == 's')  return 0 }
    state c6 { to c7 when (byte[2097152 + o + 5] == 'i')  return 0 }
    state c7 { to c8 when (byte[2097152 + o + 6] == 't')  return 0 }
    state c8 { to c9 when (byte[2097152 + o + 7] == 'i')  return 0 }
    state c9 { to c10 when (byte[2097152 + o + 8] == 'o')  return 0 }
    state c10 { to c11 when (byte[2097152 + o + 9] == 'n')  return 0 }
    state c11 { to yes when (is_idchar(byte[2097152 + o + 10]) == 0)  return 0 }
    state yes { return 1 }
}

proc is_self() {
    let o = word[2097144]
    state c1 { to c2 when (byte[2097152 + o] == 's')  return 0 }
    state c2 { to c3 when (byte[2097152 + o + 1] == 'e')  return 0 }
    state c3 { to c4 when (byte[2097152 + o + 2] == 'l')  return 0 }
    state c4 { to c5 when (byte[2097152 + o + 3] == 'f')  return 0 }
    state c5 { to yes when (is_idchar(byte[2097152 + o + 4]) == 0)  return 0 }
    state yes { return 1 }
}

proc is_true() {
    let o = word[2097144]
    state c1 { to c2 when (byte[2097152 + o] == 't')  return 0 }
    state c2 { to c3 when (byte[2097152 + o + 1] == 'r')  return 0 }
    state c3 { to c4 when (byte[2097152 + o + 2] == 'u')  return 0 }
    state c4 { to c5 when (byte[2097152 + o + 3] == 'e')  return 0 }
    state c5 { to yes when (is_idchar(byte[2097152 + o + 4]) == 0)  return 0 }
    state yes { return 1 }
}

proc is_false() {
    let o = word[2097144]
    state c1 { to c2 when (byte[2097152 + o] == 'f')  return 0 }
    state c2 { to c3 when (byte[2097152 + o + 1] == 'a')  return 0 }
    state c3 { to c4 when (byte[2097152 + o + 2] == 'l')  return 0 }
    state c4 { to c5 when (byte[2097152 + o + 3] == 's')  return 0 }
    state c5 { to c6 when (byte[2097152 + o + 4] == 'e')  return 0 }
    state c6 { to yes when (is_idchar(byte[2097152 + o + 5]) == 0)  return 0 }
    state yes { return 1 }
}

; ---- printing ----

proc emit_dec(n) {
    state neg { to do_neg when (n < 0)  to big }
    state do_neg { write_byte('-')  emit_dec(0 - n)  return 0 }
    state big { to rec when (n >= 10)  to digit }
    state rec { emit_dec(n / 10)  to digit }
    state digit { write_byte(n % 10 + '0')  return 0 }
}

; local i's CURRENT gamma name: l{i} if unwritten in this block, else t{curval}
proc print_curname(i) {
    state k { to isL when (word[6400000 + i * 8] == 0)  to isT }
    state isL { write_byte('l')  emit_dec(i)  return 0 }
    state isT { write_byte('t')  emit_dec(word[6500000 + i * 8])  return 0 }
}

; field g's CURRENT gamma name: g{g} if unwritten in this block, else t{fcurval}
proc print_fcurname(g) {
    state k { to isG when (word[6420000 + g * 8] == 0)  to isT }
    state isG { write_byte('g')  emit_dec(g)  return 0 }
    state isT { write_byte('t')  emit_dec(word[6520000 + g * 8])  return 0 }
}

proc print_expr(node) {
    state s { to isint when (word[node] == 0)  to islocal when (word[node] == 1)  to isfield when (word[node] == 3)  to isbin }
    state isint { emit_dec(word[node + 8])  return 0 }
    state islocal { print_curname(word[node + 8])  return 0 }
    state isfield { print_fcurname(word[node + 8])  return 0 }
    state isbin {
        let op = word[node + 8]
        to c_lt when (op == '<')
        to c_gt when (op == '>')
        to c_eq when (op == '=')
        to c_le when (op == 'L')
        to c_ge when (op == 'G')
        to c_ne when (op == 'N')
        write_byte('(')
        write_byte(op)                 ; arithmetic: gamma uses the same + - * / % prefix ops
        write_byte(' ')
        print_expr(word[node + 16])
        write_byte(' ')
        print_expr(word[node + 24])
        write_byte(')')
        return 0
    }
    state c_lt { emit("(lt ")  print_expr(word[node + 16])  write_byte(' ')  print_expr(word[node + 24])  write_byte(')')  return 0 }
    state c_gt { emit("(lt ")  print_expr(word[node + 24])  write_byte(' ')  print_expr(word[node + 16])  write_byte(')')  return 0 }
    state c_eq { emit("(eq ")  print_expr(word[node + 16])  write_byte(' ')  print_expr(word[node + 24])  write_byte(')')  return 0 }
    state c_le {
        emit("(+ (lt ")  print_expr(word[node + 16])  write_byte(' ')  print_expr(word[node + 24])
        emit(") (eq ")   print_expr(word[node + 16])  write_byte(' ')  print_expr(word[node + 24])
        emit("))")  return 0
    }
    state c_ge {
        emit("(+ (lt ")  print_expr(word[node + 24])  write_byte(' ')  print_expr(word[node + 16])
        emit(") (eq ")   print_expr(word[node + 16])  write_byte(' ')  print_expr(word[node + 24])
        emit("))")  return 0
    }
    state c_ne { emit("(- 1 (eq ")  print_expr(word[node + 16])  write_byte(' ')  print_expr(word[node + 24])  emit("))")  return 0 }
}

; a tail-call to state `tgt`, passing every local's current name: (m0_s{tgt} <n0> <n1> ...)
proc emit_call_state(tgt) {
    emit("(m0_s")  emit_dec(tgt)
    let i = 0
    state loop {
        to fields when (i == word[6000000])
        write_byte(' ')
        print_curname(i)
        i = i + 1
        to loop
    }
    state fields { let g = 0  to floop }
    state floop {
        to done when (g == word[6000032])         ; FIELD_CNT
        write_byte(' ')
        print_fcurname(g)
        g = g + 1
        to floop
    }
    state done { write_byte(')')  return 0 }
}

; ---- block translation (SSA name threading) ----

proc reset_curname() {
    let i = 0
    state loop {
        to fields when (i == word[6000000])
        word[6400000 + i * 8] = 0      ; local kind L
        word[6500000 + i * 8] = i      ; local val i
        i = i + 1
        to loop
    }
    state fields { let g = 0  to floop }
    state floop {
        to done when (g == word[6000032])    ; FIELD_CNT
        word[6420000 + g * 8] = 0      ; field kind G
        word[6520000 + g * 8] = g      ; field val g
        g = g + 1
        to floop
    }
    state done { return 0 }
}

; emit `(let t{fresh} <rhs-under-current-names> ` and rebind local i to t{fresh}. Leaves the let open;
; the block closes it after the terminal. CUR is positioned before the '='.
; emit `(let t{fresh} <rhs-under-current-names> ` and rebind slot `idx` (in the kind/val arrays at kindb/
; valb) to t{fresh}. Leaves the let open; the block closes it after the terminal. Works for a local slot
; (kindb=6400000 valb=6500000) or a field slot (kindb=6420000 valb=6520000). CUR is before the '='.
proc do_write_slot(kindb, valb, idx) {
    state toeq { to eat when (cbyte() == '=')  adv()  to toeq }
    state eat {
        adv()                          ; consume '='
        skip_ws()
        let node = parse_cmp()
        emit("(let t")  emit_dec(word[6000024])  write_byte(' ')
        print_expr(node)               ; value under the PRE-write names
        write_byte(' ')
        word[kindb + idx * 8] = 1                       ; kind T
        word[valb + idx * 8] = word[6000024]            ; val = fresh
        word[6000024] = word[6000024] + 1               ; fresh++
        to tosemi
    }
    state tosemi { to esemi when (cbyte() == ';')  adv()  to tosemi }
    state esemi { adv()  return 0 }
}

proc do_let() {
    adv()  adv()  adv()                ; past "let"
    skip_ws()
    let off = word[2097144]
    skip_ident()                       ; past name
    do_write_slot(6400000, 6500000, lookup_local(off))
    return 0
}

proc do_assign() {
    let off = word[2097144]
    skip_ident()                       ; past name
    do_write_slot(6400000, 6500000, lookup_local(off))
    return 0
}

; a transition arm pattern: true->1, false->0, `_`->0 (last-arm default, value unused), else an integer.
proc parse_arm_pat() {
    skip_ws()
    state d {
        to p_true when (is_true() == 1)
        to p_false when (is_false() == 1)
        to p_wild when (cbyte() == '_')
        to p_int
    }
    state p_true { skip_ident()  return 1 }
    state p_false { skip_ident()  return 0 }
    state p_wild { adv()  return 0 }
    state p_int { return parse_number() }
}

; emit the guarded if-chain: arms 0..last-1 are `(if (eq subj pat) <call> ...)`, the last is the else.
proc emit_ifchain(subj, ac) {
    let last = ac - 1
    let j = 0
    state loop {
        to tail when (j == last)
        emit("(if (eq ")
        print_expr(subj)
        write_byte(' ')
        emit_dec(word[6600000 + j * 8])       ; arm pattern
        emit(") ")
        emit_call_state(word[6700000 + j * 8])
        write_byte(' ')
        j = j + 1
        to loop
    }
    state tail {
        emit_call_state(word[6700000 + last * 8])
        let k = 0
        to closed
    }
    state closed { to done when (k == last)  write_byte(')')  k = k + 1  to closed }
    state done { return 0 }
}

; `transition <subj> { <arm>* }` — parse subject + arms, then emit the if-chain (a terminal).
proc emit_transition() {
    skip_ident()                       ; past "transition"
    skip_ws()
    let subj = parse_cmp()
    skip_ws()
    adv()                              ; consume '{'
    let ac = 0
    state armloop {
        skip_ws()
        to armend when (cbyte() == '}')
        word[6600000 + ac * 8] = parse_arm_pat()
        skip_ws()
        adv()  adv()                   ; consume '->'
        skip_ws()
        let toff = word[2097144]
        skip_ident()                   ; past target state name
        word[6700000 + ac * 8] = lookup_state(toff)
        skip_ws()
        adv()  adv()                   ; consume '()'
        ac = ac + 1
        to armloop
    }
    state armend {
        adv()                          ; consume '}'
        emit_ifchain(subj, ac)
        return 0
    }
}

; `self.console.exit_process(<expr>)` — the expr is the terminal value.
proc emit_exit() {
    state toopen { to open when (cbyte() == '(')  adv()  to toopen }
    state open {
        adv()                          ; consume '('
        let e = parse_cmp()
        print_expr(e)
        return 0
    }
}

; translate one block (entry or a state body) from `startoff`: SSA-thread the writes, then the terminal.
proc translate_block(startoff) {
    word[2097144] = startoff
    reset_curname()
    let depth = 0
    state loop {
        skip_ws()
        to t_let when (is_let() == 1)
        to t_trans when (is_transition() == 1)
        to t_exit when (is_self() == 1)
        do_assign()                    ; else: a local assignment
        depth = depth + 1
        to loop
    }
    state t_let { do_let()  depth = depth + 1  to loop }
    state t_trans { emit_transition()  to close }
    state t_exit {                     ; `self.NAME ...` — a field store, or the console exit
        skip_ident()                   ; past "self"
        adv()                          ; past '.'
        let foff = word[2097144]
        skip_ident()                   ; past NAME
        skip_ws()
        to t_fstore when (cbyte() == '=')
        emit_exit()                    ; else: self.console.exit_process(...) (CUR at ".exit_process(")
        to close
    }
    state t_fstore {                   ; self.NAME = <expr>;  -> a field write
        do_write_slot(6420000, 6520000, field_lookup(foff))
        depth = depth + 1
        to loop
    }
    state close { let j = 0  to closed }
    state closed { to fin when (j == depth)  write_byte(')')  j = j + 1  to closed }
    state fin { return 0 }
}

; ---- top-level scan + assembly ----

proc is_main_here() {
    let o = word[2097144]
    state c1 { to c2 when (byte[2097152 + o] == 'm')  return 0 }
    state c2 { to c3 when (byte[2097152 + o + 1] == 'a')  return 0 }
    state c3 { to c4 when (byte[2097152 + o + 2] == 'i')  return 0 }
    state c4 { to c5 when (byte[2097152 + o + 3] == 'n')  return 0 }
    state c5 { to yes when (is_idchar(byte[2097152 + o + 4]) == 0)  return 0 }
    state yes { return 1 }
}

; advance CUR to just past the '{' opening main's body
proc find_main() {
    state scan {
        to hit when (is_main_here() == 1)
        adv()
        to scan
    }
    state hit { skip_ident()  to brace }
    state brace { to inside when (cbyte() == '{')  adv()  to brace }
    state inside { adv()  return 0 }
}

; collect the entry's `let`-declared locals into NAMES / LOCAL_CNT (they end at the first non-let stmt).
proc collect_locals() {
    word[6000000] = 0
    word[2097144] = word[6000016]      ; CUR = ENTRY_START
    state loop {
        skip_ws()
        to done when (is_let() == 0)
        adv()  adv()  adv()            ; past "let"
        skip_ws()
        word[6100000 + word[6000000] * 8] = word[2097144]   ; NAMES[LOCAL_CNT] = name off
        word[6000000] = word[6000000] + 1                   ; LOCAL_CNT++
        skip_ident()
        to semi
    }
    state semi { to eat when (cbyte() == ';')  adv()  to semi }
    state eat { adv()  to loop }
    state done { return 0 }
}

; add a distinct self-field name (dedup) to the FIELD_NAME table.
proc add_field(off) {
    let g = 0
    state loop {
        to add when (g == word[6000032])
        to dup when (name_eq2(off, word[6800000 + g * 8]) == 1)
        g = g + 1
        to loop
    }
    state add {
        word[6800000 + word[6000032] * 8] = off
        word[6000032] = word[6000032] + 1
        return 0
    }
    state dup { return 0 }
}

; scan the machine body for `self.NAME` reads/writes; each distinct NAME that is NOT a boundary access
; (`self.console.` — followed by another `.`) is a threaded scalar field, slot g{index} by first sight.
proc collect_fields() {
    word[6000032] = 0                  ; FIELD_CNT
    word[2097144] = word[6000016]      ; CUR = ENTRY_START
    state loop {
        skip_ws()
        to done when (cbyte() == 0)
        to is_s when (is_self() == 1)
        to skiptok when (is_idchar(cbyte()) == 1)
        adv()
        to loop
    }
    state skiptok { skip_ident()  to loop }
    state is_s {
        skip_ident()                   ; past "self"
        adv()                          ; past '.'
        let foff = word[2097144]
        skip_ident()                   ; past NAME
        skip_ws()
        to skipb when (cbyte() == '.')  ; self.console. -> boundary, not a field
        add_field(foff)
        to loop
    }
    state skipb { to loop }
    state done { return 0 }
}

; scan the machine body for top-level `state NAME() {` blocks, recording name + body-start offsets.
; A brace-depth walk (depth 0 = machine top level); `state` is only recognised at depth 0.
proc scan_states() {
    word[6000008] = 0
    word[2097144] = word[6000016]      ; CUR = ENTRY_START
    let depth = 0
    state loop {
        skip_ws()
        let c = cbyte()
        to eof when (c == 0)
        to close_br when (c == '}')
        to open_br when (c == '{')
        to maybe when (depth == 0)
        adv()                          ; depth>0 filler char
        to loop
    }
    state close_br {
        to eof when (depth == 0)       ; machine close
        depth = depth - 1
        adv()
        to loop
    }
    state open_br { depth = depth + 1  adv()  to loop }
    state maybe {
        to id_tok when (is_idchar(cbyte()) == 1)
        adv()                          ; depth-0 non-identifier char (digit/operator)
        to loop
    }
    state id_tok {
        to is_st when (is_state() == 1)
        skip_ident()                   ; a non-state identifier at depth 0 -> skip the whole token
        to loop
    }
    state is_st {
        skip_ident()                   ; past "state"
        skip_ws()
        word[6200000 + word[6000008] * 8] = word[2097144]   ; STATE_NAME[s] = name off
        skip_ident()                   ; past state name
        skip_ws()
        adv()                          ; '('
        skip_ws()
        adv()                          ; ')'
        skip_ws()
        adv()                          ; '{'
        depth = depth + 1
        word[6300000 + word[6000008] * 8] = word[2097144]   ; STATE_BODY[s] = after '{'
        word[6000008] = word[6000008] + 1
        to loop
    }
    state eof { return 0 }
}

; the shared def signature: l0 .. l{n-1}  g0 .. g{m-1}  (locals then fields)
proc emit_sig() {
    let tot = word[6000000] + word[6000032]
    let x = 0
    state loop {
        to done when (x == tot)
        to sep when (x > 0)
        to name
    }
    state sep { write_byte(' ')  to name }
    state name {
        to fld when (x >= word[6000000])
        write_byte('l')  emit_dec(x)  to next
    }
    state fld { write_byte('g')  emit_dec(x - word[6000000])  to next }
    state next { x = x + 1  to loop }
    state done { return 0 }
}

proc render() {
    emit("(def m0_me (")
    emit_sig()
    emit(") ")
    translate_block(word[6000016])     ; ENTRY_START
    emit(") ")
    let s = 0
    state sloop {
        to sdone when (s == word[6000008])
        emit("(def m0_s")  emit_dec(s)  emit(" (")
        emit_sig()
        emit(") ")
        translate_block(word[6300000 + s * 8])
        emit(") ")
        s = s + 1
        to sloop
    }
    state sdone {
        emit("(m0_me")
        let k = 0
        to iloop
    }
    state iloop { to idone when (k == word[6000000] + word[6000032])  emit(" 0")  k = k + 1  to iloop }
    state idone { write_byte(')')  write_byte(10)  return 0 }
}

proc main() {
    slurp()
    find_main()
    word[6000016] = word[2097144]      ; ENTRY_START
    word[6000024] = 0                  ; FRESH
    collect_locals()
    collect_fields()
    scan_states()
    render()
    return 0
}
