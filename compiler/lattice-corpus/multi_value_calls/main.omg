// Multiple sequential value-returning calls: exercises slot isolation for
// three sequential value-position calls with varying arities, then uses
// all three results in arithmetic to produce a final value.
//
// Exercises: 3 sequential value-returning calls in the same machine scope,
// all results used together in a final arithmetic expression, with an
// intermediate mutation of self that tests that the call results survive.
//
// Value-returning machines:
//   double(n) = n * 2               (1 arg, simple)
//   add3(a, b, c) = a + b + c       (3 args, wider arity)
//   clamp_low(n, min) -> n if n>=min, else min  (2 args, uses guard)
//
// Scripted:
//   r1 = self.double(15)     = 30
//   r2 = self.add3(5, 10, 7) = 22
//   r3 = self.clamp_low(18, 20) = 20   (18 < 20, so clamped to 20)
//   total = r1 + r2 - r3 + self.offset
//         = 30 + 22 - 20 + 38 = 70
//
// self.offset is set to 38 before the calls, then the calls complete.
// Verifies: results survive a field write between calls.
//
// Expected exit: 70.

use omega::language::std::console;

data Main {
    console: Console;
    offset: i32 in Saturating;
}

machine Main::double_val(&mut self, n: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> (n * 2)
    }
}

machine Main::add3(&mut self, a: i32 in Saturating, b: i32 in Saturating, c: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> (a + b + c)
    }
}

machine Main::clamp_low(&mut self, n: i32 in Saturating, min_val: i32 in Saturating) -> i32 in Saturating {
    transition n < min_val {
        true -> min_val
        _ -> n
    }
}

machine Main::main(&mut self) {
    // Set up a field to test that it doesn't interfere with call results.
    self.offset = 38;

    // Three sequential value-returning calls with different arities.
    let r1: i32 in Saturating = self.double_val(15);    // r1 = 30
    let r2: i32 in Saturating = self.add3(5, 10, 7);   // r2 = 22
    let r3: i32 in Saturating = self.clamp_low(18, 20); // r3 = 20

    // Use all three results together with self.offset.
    let total: i32 in Saturating = r1 + r2 - r3 + self.offset;

    transition total == 70 {
        true -> check_r1()
        _ -> bad_total()
    }

    state bad_total(&mut self) { self.console.exit_process(71); }

    state check_r1(&mut self) {
        transition r1 == 30 {
            true -> check_r2()
            _ -> bad_r1()
        }
    }

    state bad_r1(&mut self) { self.console.exit_process(72); }

    state check_r2(&mut self) {
        transition r2 == 22 {
            true -> check_r3()
            _ -> bad_r2()
        }
    }

    state bad_r2(&mut self) { self.console.exit_process(73); }

    state check_r3(&mut self) {
        transition r3 == 20 {
            true -> good()
            _ -> bad_r3()
        }
    }

    state bad_r3(&mut self) { self.console.exit_process(74); }

    state good(&mut self) { self.console.exit_process(70); }
}
