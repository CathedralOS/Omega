// account_ledger: event-sourced account simulation.
//
// Exercises: multi-field case payload dispatch (3 payload variants + 3 no-payload
// variants, no-payload AFTER payload), fixed [Account; 4] record array, frozen
// flag gate, value-returning helpers (balance_of with self-mutation, total()),
// and sequential value-call results combined in arithmetic.
//
// *** MISCOMPILE DOCUMENTED ***
//
// Native exit: 93  (wrong)
// Interpreter exit: 70  (correct)
//
// Root cause (confirmed by arm-argument probes):
//   When dispatching the THIRD case variant `Transaction::Transfer { to, amount }`
//   and passing both fields as sub-state arguments `check_xfer(idx, to, amount)`,
//   the SECOND payload field `amount` receives the value of the FIRST payload
//   field `to` in native emission.  The interpreter extracts both fields correctly.
//
// Minimal trigger:
//   data Transaction {
//     case Deposit(amount: i32);     // 1st variant
//     case Withdraw(amount: i32);    // 2nd variant
//     case Transfer(to: i32, amount: i32);  // 3rd variant - 2-field payload
//     case Freeze;                   // 4th - no payload
//     ...
//   }
//   machine M::apply(&mut self, idx: i32, tx: Transaction) {
//     transition tx {
//       Transaction::Transfer { to, amount } -> check_xfer(idx, to, amount)
//       ...
//     }
//     state check_xfer(&mut self, idx: i32, to: i32, amount: i32) {
//       // In native: `amount` == `to` (3 instead of 40).
//       // Confirmed: `to`==3 passes, `amount`==3 passes, `amount`==40 fails.
//     }
//   }
//   // Call: self.apply(0, Transaction::Transfer { to: 3, amount: 40 });
//   // Expected: check_xfer(0, 3, 40) -- `to`=3, `amount`=40.
//   // Actual:   check_xfer(0, 3, 3)  -- `amount` reads first-field slot (3).
//
// This is a different bug from the stack_vm sequential-value-call slot reuse.
// That bug requires a value-returning callee that captures+mutates+returns self.
// This bug is purely in case-payload argument extraction for the 3rd+ variant
// with 2+ payload fields.
//
// Transaction sequence (hand-traced):
//   apply(0, Deposit(100))              acc[0].bal=100
//   apply(1, Deposit(200))              acc[1].bal=200
//   apply(1, Withdraw(80))              acc[1].bal=120
//   apply(2, Freeze)                    acc[2].frozen=1
//   apply(2, Deposit(50))               acc[2] frozen -> skipped
//   apply(0, Transfer(to=3, amount=40)) acc[0].bal=60, acc[3].bal=40  [MISCOMPILE]
//   apply(2, Unfreeze)                  acc[2].frozen=0
//   apply(2, Deposit(30))               acc[2].bal=30
//   apply(1, Query)                     query_count++ only
//   apply(0, Withdraw(20))              acc[0].bal=40
//
// Correct final balances: acc[0]=40, acc[1]=120, acc[2]=30, acc[3]=40, total=230
// Correct checksum: balance_of(0) + balance_of(2) = 40 + 30 = 70 -> exit 70
//
// Exit codes:
//   70  success
//   71  raw acc[0].balance != 40 (Transfer miscompile propagates here)
//   72  raw acc[2].balance != 30
//   73  raw acc[1].balance != 120
//   74  raw acc[3].balance != 40
//   75  balance_of(0) != 40 (value-call read layer)
//   76  balance_of(2) != 30 (value-call read layer)
//   77  balance_of(0)+balance_of(2) != 70 (sequential value-call arithmetic)
//   78  total() != 230
//   91  Transfer sub-state: src (idx) != 0  [probe arm]
//   92  Transfer sub-state: dst (to) != 3   [probe arm]
//   93  Transfer sub-state: amount != 40    [FIRES in native -- amount==3 not 40]
//
// Expected exit: 70.

use omega::language::std::console;

data Transaction {
    case Deposit(amount: i32 in Wrapping);
    case Withdraw(amount: i32 in Wrapping);
    case Transfer(to: i32 in Wrapping, amount: i32 in Wrapping);
    case Freeze;
    case Unfreeze;
    case Query;
}

data Account [copy] {
    balance: i32 in Wrapping;
    frozen: i32 in Wrapping;
}

data Main {
    console: Console;
    accounts: [Account; 4];
    query_count: i32 in Wrapping;
}

// ── write helpers: deposit/withdraw per const index ────────────────────────────

machine Main::do_deposit(&mut self, idx: i32 in Wrapping, amount: i32 in Wrapping) {
    transition idx == 0 {
        true -> dep0(amount)
        _ -> dep_try1(idx, amount)
    }
    state dep0(&mut self, amount: i32 in Wrapping) {
        self.accounts[0].balance = self.accounts[0].balance + amount;
    }
    state dep_try1(&mut self, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        transition idx == 1 {
            true -> dep1(amount)
            _ -> dep_try2(idx, amount)
        }
    }
    state dep1(&mut self, amount: i32 in Wrapping) {
        self.accounts[1].balance = self.accounts[1].balance + amount;
    }
    state dep_try2(&mut self, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        transition idx == 2 {
            true -> dep2(amount)
            _ -> dep3(amount)
        }
    }
    state dep2(&mut self, amount: i32 in Wrapping) {
        self.accounts[2].balance = self.accounts[2].balance + amount;
    }
    state dep3(&mut self, amount: i32 in Wrapping) {
        self.accounts[3].balance = self.accounts[3].balance + amount;
    }
}

machine Main::do_withdraw(&mut self, idx: i32 in Wrapping, amount: i32 in Wrapping) {
    transition idx == 0 {
        true -> wd0(amount)
        _ -> wd_try1(idx, amount)
    }
    state wd0(&mut self, amount: i32 in Wrapping) {
        self.accounts[0].balance = self.accounts[0].balance - amount;
    }
    state wd_try1(&mut self, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        transition idx == 1 {
            true -> wd1(amount)
            _ -> wd_try2(idx, amount)
        }
    }
    state wd1(&mut self, amount: i32 in Wrapping) {
        self.accounts[1].balance = self.accounts[1].balance - amount;
    }
    state wd_try2(&mut self, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        transition idx == 2 {
            true -> wd2(amount)
            _ -> wd3(amount)
        }
    }
    state wd2(&mut self, amount: i32 in Wrapping) {
        self.accounts[2].balance = self.accounts[2].balance - amount;
    }
    state wd3(&mut self, amount: i32 in Wrapping) {
        self.accounts[3].balance = self.accounts[3].balance - amount;
    }
}

machine Main::do_freeze(&mut self, idx: i32 in Wrapping) {
    transition idx == 0 {
        true -> fr0()
        _ -> fr_try1(idx)
    }
    state fr0(&mut self) { self.accounts[0].frozen = 1; }
    state fr_try1(&mut self, idx: i32 in Wrapping) {
        transition idx == 1 {
            true -> fr1()
            _ -> fr_try2(idx)
        }
    }
    state fr1(&mut self) { self.accounts[1].frozen = 1; }
    state fr_try2(&mut self, idx: i32 in Wrapping) {
        transition idx == 2 {
            true -> fr2()
            _ -> fr3()
        }
    }
    state fr2(&mut self) { self.accounts[2].frozen = 1; }
    state fr3(&mut self) { self.accounts[3].frozen = 1; }
}

machine Main::do_unfreeze(&mut self, idx: i32 in Wrapping) {
    transition idx == 0 {
        true -> uf0()
        _ -> uf_try1(idx)
    }
    state uf0(&mut self) { self.accounts[0].frozen = 0; }
    state uf_try1(&mut self, idx: i32 in Wrapping) {
        transition idx == 1 {
            true -> uf1()
            _ -> uf_try2(idx)
        }
    }
    state uf1(&mut self) { self.accounts[1].frozen = 0; }
    state uf_try2(&mut self, idx: i32 in Wrapping) {
        transition idx == 2 {
            true -> uf2()
            _ -> uf3()
        }
    }
    state uf2(&mut self) { self.accounts[2].frozen = 0; }
    state uf3(&mut self) { self.accounts[3].frozen = 0; }
}

// Read frozen flag (value-returning).
machine Main::is_frozen(&mut self, idx: i32 in Wrapping) -> i32 {
    transition idx == 0 {
        true -> (self.accounts[0].frozen)
        _ -> try_f1(idx)
    }
    state try_f1(&mut self, idx: i32 in Wrapping) {
        transition idx == 1 {
            true -> (self.accounts[1].frozen)
            _ -> try_f2(idx)
        }
    }
    state try_f2(&mut self, idx: i32 in Wrapping) {
        transition idx == 2 {
            true -> (self.accounts[2].frozen)
            _ -> (self.accounts[3].frozen)
        }
    }
}

// ── value-returning: balance_of (capture+mutate self+return) ──────────────────
// Each readN: (1) capture balance into local b, (2) mutate self.query_count,
// (3) return b. Replicates the stack_vm miscompile surface.
machine Main::balance_of(&mut self, idx: i32 in Wrapping) -> i32 {
    transition idx == 0 {
        true -> read0()
        _ -> try1(idx)
    }
    state read0(&mut self) {
        let b: i32 in Wrapping = self.accounts[0].balance;
        self.query_count = self.query_count + 1;
        transition { _ -> (b) }
    }
    state try1(&mut self, idx: i32 in Wrapping) {
        transition idx == 1 {
            true -> read1()
            _ -> try2(idx)
        }
    }
    state read1(&mut self) {
        let b: i32 in Wrapping = self.accounts[1].balance;
        self.query_count = self.query_count + 1;
        transition { _ -> (b) }
    }
    state try2(&mut self, idx: i32 in Wrapping) {
        transition idx == 2 {
            true -> read2()
            _ -> read3()
        }
    }
    state read2(&mut self) {
        let b: i32 in Wrapping = self.accounts[2].balance;
        self.query_count = self.query_count + 1;
        transition { _ -> (b) }
    }
    state read3(&mut self) {
        let b: i32 in Wrapping = self.accounts[3].balance;
        self.query_count = self.query_count + 1;
        transition { _ -> (b) }
    }
}

// ── value-returning: sum all four balances ────────────────────────────────────
machine Main::total(&mut self) -> i32 {
    let t: i32 in Wrapping = self.accounts[0].balance
               + self.accounts[1].balance
               + self.accounts[2].balance
               + self.accounts[3].balance;
    transition { _ -> (t) }
}

// ── case dispatcher: apply a transaction to an account index ──────────────────
machine Main::apply(&mut self, idx: i32 in Wrapping, tx: Transaction) {
    transition tx {
        Transaction::Deposit { amount } -> check_frozen_dep(idx, amount)
        Transaction::Withdraw { amount } -> check_frozen_wd(idx, amount)
        Transaction::Transfer { to, amount } -> check_xfer(idx, to, amount)
        Transaction::Freeze -> do_freeze_now(idx)
        Transaction::Unfreeze -> do_unfreeze_now(idx)
        Transaction::Query -> do_query()
        _ -> done()
    }

    state check_frozen_dep(&mut self, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        let frozen: i32 in Wrapping = self.is_frozen(idx);
        transition frozen == 0 {
            true -> exec_dep(idx, amount)
            _ -> done()
        }
    }

    state exec_dep(&mut self, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        self.do_deposit(idx, amount);
    }

    state check_frozen_wd(&mut self, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        let frozen: i32 in Wrapping = self.is_frozen(idx);
        transition frozen == 0 {
            true -> exec_wd(idx, amount)
            _ -> done()
        }
    }

    state exec_wd(&mut self, idx: i32 in Wrapping, amount: i32 in Wrapping) {
        self.do_withdraw(idx, amount);
    }

    // Transfer path: probe the extracted payload fields.
    // In native: `amount` receives the value of `to` (the first payload field).
    state check_xfer(&mut self, idx: i32 in Wrapping, to: i32 in Wrapping, amount: i32 in Wrapping) {
        // Guard chain to expose the miscompile:
        // src (=idx) should be 0 for our apply(0, Transfer{...}) call.
        transition idx == 0 {
            true -> xfer_check_to(to, amount)
            _ -> xfer_bad_idx()
        }
    }

    state xfer_bad_idx(&mut self) { self.console.exit_process(91); }

    state xfer_check_to(&mut self, to: i32 in Wrapping, amount: i32 in Wrapping) {
        // to should be 3.
        transition to == 3 {
            true -> xfer_check_amount(to, amount)
            _ -> xfer_bad_to()
        }
    }

    state xfer_bad_to(&mut self) { self.console.exit_process(92); }

    state xfer_check_amount(&mut self, to: i32 in Wrapping, amount: i32 in Wrapping) {
        // amount should be 40. In native: amount==3 (same as `to`).
        // MISCOMPILE: this arm fires in native (exit 93).
        transition amount == 40 {
            true -> xfer_do(to, amount)
            _ -> xfer_bad_amount()
        }
    }

    state xfer_bad_amount(&mut self) { self.console.exit_process(93); }

    state xfer_do(&mut self, to: i32 in Wrapping, amount: i32 in Wrapping) {
        self.do_withdraw(0, amount);
        self.do_deposit(to, amount);
    }

    state do_freeze_now(&mut self, idx: i32 in Wrapping) {
        self.do_freeze(idx);
    }

    state do_unfreeze_now(&mut self, idx: i32 in Wrapping) {
        self.do_unfreeze(idx);
    }

    state do_query(&mut self) {
        self.query_count = self.query_count + 1;
    }

    state done(&mut self) {}
}

// ── main: scripted transaction sequence + multi-layer verification ─────────────
machine Main::main(&mut self) {
    // 10 apply calls.
    self.apply(0, Transaction::Deposit { amount: 100 });
    self.apply(1, Transaction::Deposit { amount: 200 });
    self.apply(1, Transaction::Withdraw { amount: 80 });
    self.apply(2, Transaction::Freeze);
    self.apply(2, Transaction::Deposit { amount: 50 });
    self.apply(0, Transaction::Transfer { to: 3, amount: 40 });
    self.apply(2, Transaction::Unfreeze);
    self.apply(2, Transaction::Deposit { amount: 30 });
    self.apply(1, Transaction::Query);
    self.apply(0, Transaction::Withdraw { amount: 20 });

    // Layer 1: raw field guards (bypass value-call entirely).
    transition self.accounts[0].balance == 40 {
        true -> raw_check_acc2()
        _ -> bad_raw0()
    }

    state bad_raw0(&mut self) { self.console.exit_process(71); }

    state raw_check_acc2(&mut self) {
        transition self.accounts[2].balance == 30 {
            true -> raw_check_acc1()
            _ -> bad_raw2()
        }
    }

    state bad_raw2(&mut self) { self.console.exit_process(72); }

    state raw_check_acc1(&mut self) {
        transition self.accounts[1].balance == 120 {
            true -> raw_check_acc3()
            _ -> bad_raw1()
        }
    }

    state bad_raw1(&mut self) { self.console.exit_process(73); }

    state raw_check_acc3(&mut self) {
        transition self.accounts[3].balance == 40 {
            true -> vcall_check_b0()
            _ -> bad_raw3()
        }
    }

    state bad_raw3(&mut self) { self.console.exit_process(74); }

    // Layer 2: value-call reads (balance_of captures+mutates+returns).
    state vcall_check_b0(&mut self) {
        let b0: i32 in Wrapping = self.balance_of(0);
        transition b0 == 40 {
            true -> vcall_check_b2(b0)
            _ -> bad_vcall0()
        }
    }

    state bad_vcall0(&mut self) { self.console.exit_process(75); }

    state vcall_check_b2(&mut self, b0: i32 in Wrapping) {
        let b2: i32 in Wrapping = self.balance_of(2);
        transition b2 == 30 {
            true -> vcall_check_sum(b0, b2)
            _ -> bad_vcall2()
        }
    }

    state bad_vcall2(&mut self) { self.console.exit_process(76); }

    // Layer 3: two sequential value-call results combined in arithmetic.
    // balance_of(0) + balance_of(2) = 40 + 30 = 70 (the key checksum).
    // If layers 1-2 pass but this fires, it's a value-call arithmetic miscompile
    // (the stack_vm-style bug -- distinct from the payload-extraction bug above).
    state vcall_check_sum(&mut self, b0: i32 in Wrapping, b2: i32 in Wrapping) {
        let checksum: i32 in Wrapping = b0 + b2;
        transition checksum == 70 {
            true -> check_total()
            _ -> bad_sum()
        }
    }

    state bad_sum(&mut self) { self.console.exit_process(77); }

    // Layer 4: total() value-call.
    state check_total(&mut self) {
        let t: i32 in Wrapping = self.total();
        transition t == 230 {
            true -> good()
            _ -> bad_total()
        }
    }

    state bad_total(&mut self) { self.console.exit_process(78); }

    state good(&mut self) { self.console.exit_process(70); }
}
