// Leap-year test -- the classic compound-boolean algorithm: a year is a leap year
// if it is divisible by 4 AND not by 100, OR it is divisible by 400. This exercises
// `&&`, `||`, `==`, `!=`, and `%` together in a single guard. Omega uses standard
// operator precedence (`&&` binds tighter than `||`), so `A && B || C` parses as
// `(A && B) || C` -- no parentheses needed (and a transition subject cannot begin
// with `(` anyway). The three boundary cases prove the precedence is correct: 2024
// (div by 4, not 100) and 2000 (div by 400) are leap; 1900 (div by 100, not 400) is
// not. This sample checks 2024 -> exit 1 (leap).
// Expected exit: 1.

boundary trait Console {
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    year: i32 in Trapping;
}

machine Main::main(&mut self) {
    self.year = 2024;

    transition self.year % 4 == 0 && self.year % 100 != 0 || self.year % 400 == 0 {
        true -> leap()
        _ -> common()
    }

    state leap(&mut self) { self.console.exit_process(1); }
    state common(&mut self) { self.console.exit_process(0); }
}
