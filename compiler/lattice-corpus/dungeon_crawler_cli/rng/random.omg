use rng::random_state;

data Random {
}

machine Random::seed(
    &mut self,
    value: u64 in Wrapping,
    state: &mut RandomState
) {
    state.seed = value;
    state.calls = 0;
}

machine Random::next_u32(
    &mut self,
    state: &mut RandomState
    ) -> u32 {
    state.seed = state.seed * 6364136223846793005 + 1442695040888963407;
    state.calls = state.calls + 1;

    transition {
        _ -> ((state.seed >> 32) as u32)
    }
}

machine Random::range(
    &mut self,
    state: &mut RandomState,
    exclusive_max: u32 in Wrapping
    ) -> u32 {
    let raw: u32 in Wrapping = self.next_u32(state);

    transition {
        _ -> (raw % exclusive_max)
    }
}

machine Random::chance(
    &mut self,
    state: &mut RandomState,
    numerator: u32 in Wrapping,
    denominator: u32 in Wrapping
    ) -> bool {
    let roll: u32 in Wrapping = self.range(state, denominator);

    transition {
        _ -> (roll < numerator)
    }
}

