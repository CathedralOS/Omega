data CellId {
    case Empty;
    case R00;
    case R01;
    case R02;
    case R03;
    case R04;
    case R05;
    case R06;
    case R07;
    case R08;
    case R09;
    case R10;
    case R11;
    case R12;
    case R13;
    case R14;
    case R15;
}

data Direction {
    case North;
    case South;
    case East;
    case West;
}

data NavigationChoice {
    case Quit;
    case Look;
    case Exits;
    case Inventory;
    case Character;
    case UseEvent;
    case Fight;
    case Move;
    case Invalid;
}

data GameMode {
    case Title;
    case Exploring;
    case Combat;
    case GameOver;
}

data Navigation {
    choice: NavigationChoice;
    destination: CellId;
}
