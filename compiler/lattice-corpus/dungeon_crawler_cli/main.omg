// Interactive dungeon crawler. With closed stdin (the runtime harness, EOF on the
// first prompt) the game loop reads an empty command and exits cleanly via
// `finished()`. Expected exit: 0.
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
domain [u8; 16]::Utf8
requires
    valid_utf8(self);
domain [u8; 24]::Utf8
requires
    valid_utf8(self);
domain [u8; 64]::Utf8
requires
    valid_utf8(self);
domain [u8; 128]::Utf8
requires
    valid_utf8(self);
domain [u8; 256]::Utf8
requires
    valid_utf8(self);
use game::game;

data Main {
    game: Game;
}

machine Main::main(&mut self) -> i32 {
    self.game.initialize(7);

    transition {
        _ -> running()
    }


    state running(&mut self) {
        self.game.run_game_loop();

        transition {
            _ -> shutdown()
        }
    }

    state shutdown(&mut self) {
        0
    }
}
