// Extract and checksum the payload of a framed message. The frame is
// [header, b0, b1, b2, trailer]; the payload is the middle three bytes, obtained
// with the TWO-BOUND subslice `full[1..4]` (the `Slice::range` operator, distinct
// from the one-bound tail `s[1..]` used elsewhere). The bound proof `1 <= 4 &&
// 4 <= len` is discharged from the array's static length of 5. For
// [255, 10, 20, 30, 0] the payload [10, 20, 30] sums to 60. The inner `sum`
// walks the payload with the shrinking-window recursion.
// Expected exit: 60.

use omega::language::std::console;

data Frame {
    bytes: [i32 in Trapping; 5];
}

machine Frame::sum(&mut self, s: &[i32 in Trapping], acc: i32 in Trapping) -> i32 in Trapping {
    transition s.len > 0 {
        true -> sum(s[1..], acc + s[0])
        false -> (acc)
    }
}

data Main {
    console: Console;
    frame: Frame;
}

machine Main::main(&mut self) {
    self.frame.bytes[0] = 255;
    self.frame.bytes[1] = 10;
    self.frame.bytes[2] = 20;
    self.frame.bytes[3] = 30;
    self.frame.bytes[4] = 0;

    let full: &[i32 in Trapping] = self.frame.bytes.as_slice();
    let checksum: i32 = self.frame.sum(full[1..4], 0);
    self.console.exit_process(checksum);
}
