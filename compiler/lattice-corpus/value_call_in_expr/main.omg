// Expected exit: 70.
// Value-call result used inline in arithmetic expressions.
//
// MISCOMPILE FOUND 2026-06-14:
//   `let r1 = self.base + self.calc.double_val(6) * 3`
//   produces the wrong result (exit 72, r1 != 46) even though
//   `double_val(6)` alone = 12 (verified by standalone check, passes exit 76).
//
//   This is a miscompile in inline value-call arithmetic:
//   the call result embedded in a binary expression gets the wrong value.
//
//   Minimal trigger:
//     let dv6: i32 in Saturating = self.calc.double_val(6);   // = 12, correct alone
//     let r1:  i32 = self.base + self.calc.double_val(6) * 3;  // wrong
//   where `self.base = 10`.
//
//   Expected: r1 = 10 + 12 * 3 = 46
//   Actual:   r1 != 46 (exact wrong value not captured)
//
//   Diagnostic note: exit 72 = r1 check (this path is the failing check).
//   Exit 76 = standalone double_val(6) check (passes = 12 is correct alone).
//
// FIXED 2026-06-14 -- now exits 70. Two bugs were behind the original exit 72:
//   1. slot-name collision: a let-binding whose initializer contains a call gave
//      its embedded-call scratch slot the binding's name, so name-based reads hit
//      the scratch (partial value). Fixed in the slot planner.
//   2. cross-state arg fold: passing such a local as a transition argument folded
//      it back into its initializer and re-evaluated the call in the target state
//      (whose scratch is unreachable), never materializing the param. Fixed by
//      blocking the inline fold when the initializer contains a result call.
// Guarded by calls/value_call_embedded_in_binary_exit and
// calls/transition_arg_local_from_embedded_call_exit.

use omega::language::std::console;

data Calc {}

data Main {
    console: Console;
    base: i32 in Saturating;
    calc: Calc;
}

machine Calc::double_val(&mut self, n: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> (n * 2)
    }
}

machine Calc::add5(&mut self, n: i32 in Saturating) -> i32 in Saturating {
    transition {
        _ -> (n + 5)
    }
}

machine Main::main(&mut self) {
    self.base = 10;

    // Verify double_val standalone = 12 (passes).
    let dv6: i32 in Saturating = self.calc.double_val(6);
    transition dv6 == 12 {
        true -> check_r1()
        _ -> bad_dv6()
    }

    state bad_dv6(&mut self) { self.console.exit_process(76); }

    state check_r1(&mut self) {
        // MISCOMPILE: inline value-call in arithmetic.
        // Expected: 10 + double(6)*3 = 10 + 36 = 46.
        // Actual: wrong (exit 72 fired in original version).
        let r1: i32 in Saturating = self.base + self.calc.double_val(6) * 3;
        transition r1 == 46 {
            true -> check_r2(r1)
            _ -> bad_r1()
        }
    }

    state bad_r1(&mut self) { self.console.exit_process(72); }

    state check_r2(&mut self, r1: i32 in Saturating) {
        // r1 - add5(2) + 1 = 46 - 7 + 1 = 40.
        let r2: i32 in Saturating = r1 - self.calc.add5(2) + 1;
        transition r2 == 40 {
            true -> check_inner(r1, r2)
            _ -> bad_r2()
        }
    }

    state bad_r2(&mut self) { self.console.exit_process(73); }

    state check_inner(&mut self, r1: i32 in Saturating, r2: i32 in Saturating) {
        let inner: i32 in Saturating = self.calc.add5(7);
        transition inner == 12 {
            true -> check_r3(r1, r2, inner)
            _ -> bad_inner()
        }
    }

    state bad_inner(&mut self) { self.console.exit_process(74); }

    state check_r3(&mut self, r1: i32 in Saturating, r2: i32 in Saturating, inner: i32 in Saturating) {
        let r3: i32 in Saturating = r2 + self.calc.double_val(inner);
        transition r3 == 64 {
            true -> compute_final(r1, r2, r3)
            _ -> bad_r3()
        }
    }

    state bad_r3(&mut self) { self.console.exit_process(75); }

    state compute_final(&mut self, r1: i32 in Saturating, r2: i32 in Saturating, r3: i32 in Saturating) {
        let result: i32 in Saturating = r3 + self.calc.add5(1);
        transition result == 70 {
            true -> good()
            _ -> bad_result()
        }
    }

    state bad_result(&mut self) { self.console.exit_process(71); }

    state good(&mut self) { self.console.exit_process(70); }
}
