// Expected exit: 70.
// Cross-platform atomics smoke test: exercises BOTH atomic read-modify-write
// ops so each target's real atomic instruction is emitted end-to-end.
//
//   fetch_add        -> LOCK xadd  (x86_64) / LDADDAL (aarch64)
//   compare_exchange -> LOCK CMPXCHG (x86_64) / CASAL (aarch64)
//
// All operands are constants and nothing is passed as a state argument, so the
// program compiles for every declared target. Exit 70 iff both ops behaved:
//   store(10); fetch_add(5)  -> old1==10, counter==15
//   compare_exchange(15,99)  -> prior==15 (match), counter==99
//
// Verified on the host (windows_x64) by execution; the aarch64 LDADDAL/CASAL
// paths are verified by cross-emission + disassembly (this box cannot run them).

use omega::language::std::console;

data Main {
    console: Console;
    counter: AtomicU32;
}

machine Main::main(&mut self) {
    self.counter.store(10, Relaxed);

    let old1: u32 in Wrapping = self.counter.fetch_add(5, Relaxed);
    transition old1 == 10 {
        true -> after_add()
        _ -> bad()
    }

    state after_add(&mut self) {
        // counter is now 15 (a field, so it survived the transition).
        let prior: u32 in Wrapping = self.counter.compare_exchange(15, 99, AcqRel, Acquire);
        transition prior == 15 {
            true -> after_cas()
            _ -> bad()
        }
    }

    state after_cas(&mut self) {
        transition self.counter == 99 {
            true -> good()
            _ -> bad()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }
    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
