// The minimal Omega program -- "hello world". `main` prints a line through the std
// console boundary and exits cleanly. This is the simplest end-to-end smoke test
// (frontend + codegen + host console) and the runnable baseline behind every other
// sample. Annotated so the samples harness value-asserts it (runs + checks the
// exit), not just compiles it.
// Expected exit: 0.

use omega::language::std::console;

data Main {
    console: Console;
}

machine Main::main(&mut self) {
    self.console.write_line("Hello, Omega.");
    self.console.exit_process(0);
}
