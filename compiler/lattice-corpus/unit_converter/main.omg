// Unit converter. Exercises f32 and f64 scalar conversions:
// temperature (Celsius ↔ Fahrenheit ↔ Kelvin), distance (km ↔ miles),
// and mass (kg ↔ lbs). Stresses f32 parameter passing, f64 arithmetic
// chains, and cross-width casts.
//
// Conversion checks:
//   100°C  → 212.0°F           (should be 212.0 ± 0.1)
//   212°F  → 100.0°C           (should be 100.0 ± 0.1)
//   373.15K → 100.0°C          (should be 100.0 ± 0.1)
//   10 km  → 6.2137 miles      (should be > 6.1, < 6.3)
//   5.0 kg → 11.023 lbs        (should be > 11.0, < 11.1)
//
// All guard ladders exit 70 on success.
//
// Expected exit: 70.

use omega::language::std::console;

data Main {
    console: Console;
    result: f64;
}

// Temperature conversions.
machine celsius_to_fahrenheit(c: f64) -> f64 {
    c * 1.8 + 32.0
}

machine fahrenheit_to_celsius(f: f64) -> f64 {
    let shifted: f64 = f - 32.0;
    shifted * 0.5555555555555556
}

machine kelvin_to_celsius(k: f64) -> f64 {
    k - 273.15
}

// Distance conversion.
machine km_to_miles(km: f64) -> f64 {
    km * 0.621371
}

// Mass conversion.
machine kg_to_lbs(kg: f64) -> f64 {
    kg * 2.20462
}

machine Main::main(&mut self) {
    // Check 1: 100°C → 212°F.
    self.result = celsius_to_fahrenheit(100.0);
    transition self.result > 211.5 {
        true -> check_c2f_upper()
        _ -> bad_c2f_low()
    }
    state bad_c2f_low(&mut self) { self.console.exit_process(71); }

    state check_c2f_upper(&mut self) {
        transition self.result < 212.5 {
            true -> check_f2c()
            _ -> bad_c2f_high()
        }
    }
    state bad_c2f_high(&mut self) { self.console.exit_process(72); }

    // Check 2: 212°F → 100°C.
    state check_f2c(&mut self) {
        self.result = fahrenheit_to_celsius(212.0);
        transition self.result > 99.5 {
            true -> check_f2c_upper()
            _ -> bad_f2c_low()
        }
    }
    state bad_f2c_low(&mut self) { self.console.exit_process(73); }

    state check_f2c_upper(&mut self) {
        transition self.result < 100.5 {
            true -> check_k2c()
            _ -> bad_f2c_high()
        }
    }
    state bad_f2c_high(&mut self) { self.console.exit_process(74); }

    // Check 3: 373.15K → 100°C.
    state check_k2c(&mut self) {
        self.result = kelvin_to_celsius(373.15);
        transition self.result > 99.9 {
            true -> check_k2c_upper()
            _ -> bad_k2c_low()
        }
    }
    state bad_k2c_low(&mut self) { self.console.exit_process(75); }

    state check_k2c_upper(&mut self) {
        transition self.result < 100.1 {
            true -> check_km()
            _ -> bad_k2c_high()
        }
    }
    state bad_k2c_high(&mut self) { self.console.exit_process(76); }

    // Check 4: 10 km → ~6.21 miles.
    state check_km(&mut self) {
        self.result = km_to_miles(10.0);
        transition self.result > 6.1 {
            true -> check_km_upper()
            _ -> bad_km_low()
        }
    }
    state bad_km_low(&mut self) { self.console.exit_process(77); }

    state check_km_upper(&mut self) {
        transition self.result < 6.3 {
            true -> check_kg()
            _ -> bad_km_high()
        }
    }
    state bad_km_high(&mut self) { self.console.exit_process(78); }

    // Check 5: 5 kg → ~11.023 lbs.
    state check_kg(&mut self) {
        self.result = kg_to_lbs(5.0);
        transition self.result > 11.0 {
            true -> check_kg_upper()
            _ -> bad_kg_low()
        }
    }
    state bad_kg_low(&mut self) { self.console.exit_process(79); }

    state check_kg_upper(&mut self) {
        transition self.result < 11.1 {
            true -> good()
            _ -> bad_kg_high()
        }
    }
    state bad_kg_high(&mut self) { self.console.exit_process(80); }

    state good(&mut self) { self.console.exit_process(70); }
}
