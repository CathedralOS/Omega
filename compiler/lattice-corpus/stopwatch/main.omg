// Stopwatch with split/lap commands as case payloads.
//
// Stresses: case members (Tick, Lap, Split), payload-bound i32 args,
// [copy] property, accumulated scalar writes, value-position
// calls returning i32.
//
// Commands:
//   Tick(n)  -- advance time by n ticks
//   Lap      -- record current time as a lap (resets elapsed to 0)
//   Split    -- snapshot current time (does not reset elapsed)
//
// Scripted sequence:
//   Tick(10)  -> elapsed=10, total=10
//   Split     -> split=10,   elapsed=10, total=10
//   Tick(20)  -> elapsed=30, total=30
//   Lap       -> lap=30,     elapsed=0,  total=30
//   Tick(15)  -> elapsed=15, total=45
//   Tick(25)  -> elapsed=40, total=70
//   Split     -> split=40,   elapsed=40, total=70
//
// Final: total==70, split==40, lap==30, elapsed==40. Exit 70 when correct.
//
// Expected exit: 70.

use omega::language::std::console;

data Command {
    case Tick(n: i32 in Saturating);
    case Lap;
    case Split;
}

data Watch [copy] {
    elapsed: i32 in Saturating;
    total: i32 in Saturating;
    last_lap: i32 in Saturating;
    last_split: i32 in Saturating;
}

data Main {
    console: Console;
    watch: Watch;
}

machine Main::main(&mut self) {
    self.send(Command::Tick { n: 10 });
    self.send(Command::Split);
    self.send(Command::Tick { n: 20 });
    self.send(Command::Lap);
    self.send(Command::Tick { n: 15 });
    self.send(Command::Tick { n: 25 });
    self.send(Command::Split);

    // total==70, split==40, lap==30, elapsed==40.
    transition self.watch.total == 70 {
        true -> check_split()
        _ -> bad_total()
    }

    state check_split(&mut self) {
        transition self.watch.last_split == 40 {
            true -> check_lap()
            _ -> bad_split()
        }
    }

    state check_lap(&mut self) {
        transition self.watch.last_lap == 30 {
            true -> check_elapsed()
            _ -> bad_lap()
        }
    }

    state check_elapsed(&mut self) {
        transition self.watch.elapsed == 40 {
            true -> good()
            _ -> bad_elapsed()
        }
    }

    state good(&mut self) { self.console.exit_process(70); }
    state bad_total(&mut self) { self.console.exit_process(71); }
    state bad_split(&mut self) { self.console.exit_process(72); }
    state bad_lap(&mut self) { self.console.exit_process(73); }
    state bad_elapsed(&mut self) { self.console.exit_process(74); }
}

// Apply a command to the stopwatch.
machine Main::send(&mut self, cmd: Command) {
    transition cmd {
        Command::Tick { n } -> do_tick(n)
        Command::Lap -> do_lap()
        Command::Split -> do_split()
        _ -> done()
    }

    state do_tick(&mut self, n: i32 in Saturating) {
        self.watch.elapsed = self.watch.elapsed + n;
        self.watch.total = self.watch.total + n;
    }

    state do_lap(&mut self) {
        self.watch.last_lap = self.watch.elapsed;
        self.watch.elapsed = 0;
    }

    state do_split(&mut self) {
        self.watch.last_split = self.watch.elapsed;
    }

    state done(&mut self) {}
}
