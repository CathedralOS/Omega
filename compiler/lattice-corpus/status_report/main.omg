// Build a status message with `[u8; N] in Utf8` text carriers INSIDE conditional
// control flow: depending on the reading, the `high` or `normal` arm concatenates
// a different prefix onto the shared `label` carrier, prints it, and verifies the
// result with `==`. (text_greeting shows a single straight-line concat; this shows
// carrier concatenation composing across transition arms.) With reading 95 > 90 the
// `high` arm builds "ALERT temp", so the program prints it and exits 70.
//
// (Verification uses `==`, a content check stronger than a length check. A
// carrier's `.len` also marshals as a value/host-call operand now -- see the
// runtime_bounded_carrier_length_exit canary.)
// Expected exit: 70.

domain [u8]::Utf8
requires
    valid_utf8(self);
domain [u8; 8]::Utf8
requires
    valid_utf8(self);
domain [u8; 32]::Utf8
requires
    valid_utf8(self);
boundary trait Console {
    machine write_line(text: &[u8] in Utf8);
    machine exit_process(return_code: i32);
}

data Main {
    console: Console;
    label: [u8; 8] in Utf8;
    message: [u8; 32] in Utf8;
    reading: i32;
}

machine Main::main(&mut self) {
    self.label = "temp";
    self.reading = 95;

    transition self.reading > 90 {
        true -> high()
        _ -> normal()
    }

    state high(&mut self) {
        self.message = "ALERT " + self.label;
        self.console.write_line(self.message);
        transition self.message == "ALERT temp" { true -> ok() _ -> bad() }
    }

    state normal(&mut self) {
        self.message = "ok " + self.label;
        self.console.write_line(self.message);
        transition self.message == "ok temp" { true -> ok() _ -> bad() }
    }

    state ok(&mut self) { self.console.exit_process(70); }
    state bad(&mut self) { self.console.exit_process(71); }
}
