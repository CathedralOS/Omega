// Modular exponentiation by repeated squaring: compute (base ^ exponent) mod m.
// This is the workhorse of public-key crypto (RSA, Diffie-Hellman); doing it by
// squaring keeps every intermediate small instead of forming the astronomically
// large base^exponent. Here 3 ^ 7 mod 100 = 2187 mod 100 = 87.
//
// Showcases the full integer-arithmetic kit over a self-transition loop: `% m`
// and `/ 2` (modulo/division), `*` under a TRAPPING domain (products stay well
// under i32::MAX for m = 100, so the overflow obligation provably never trips),
// and a parity branch on the exponent's low bit.
// Expected exit: 87.

use omega::language::std::console;

data ModExp [copy] {
    result: i32 in Trapping;
    base: i32 in Trapping;
    exponent: i32;
    modulus: i32;
}

data Main {
    console: Console;
    state: ModExp;
}

machine Main::main(&mut self) {
    self.state.base = 3;
    self.state.exponent = 7;
    self.state.modulus = 100;
    self.state.result = 1;
    self.state.base = self.state.base % self.state.modulus;

    transition {
        _ -> step()
    }

    // Process the exponent bit by bit, lowest first; stop once it is exhausted.
    state step(&mut self) {
        transition self.state.exponent == 0 {
            true -> done()
            _ -> classify()
        }
    }

    // Fold the current squared base into the result only when this bit is set.
    state classify(&mut self) {
        let bit: i32 = self.state.exponent % 2;
        transition bit == 1 {
            true -> accumulate()
            _ -> square()
        }
    }

    state accumulate(&mut self) {
        self.state.result = (self.state.result * self.state.base) % self.state.modulus;
        transition {
            _ -> square()
        }
    }

    // Square the base and halve the exponent for the next bit.
    state square(&mut self) {
        self.state.base = (self.state.base * self.state.base) % self.state.modulus;
        self.state.exponent = self.state.exponent / 2;
        transition {
            _ -> step()
        }
    }

    state done(&mut self) {
        self.console.exit_process(self.state.result);
    }
}
