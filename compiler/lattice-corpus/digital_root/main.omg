// Digital root: repeatedly sum a number's decimal digits until a single digit
// remains. For 12345 -> 1+2+3+4+5 = 15 -> 1+5 = 6. (It equals 1 + (n-1) mod 9, the
// basis of casting out nines.) Showcases NESTED self-transition loops -- an outer
// loop that repeats while the value has more than one digit, and an inner loop
// that sums the digits via `% 10` (last digit) and `/ 10` (drop it). No `let`
// local crosses a field reassignment, so the digit accumulation writes fields
// directly.
// Expected exit: 6.

use omega::language::std::console;

data Roots [copy] {
    n: i32 in Trapping;
    sum: i32 in Trapping;
}

data Main {
    console: Console;
    state: Roots;
}

machine Main::main(&mut self) {
    self.state.n = 12345;

    transition {
        _ -> collapse()
    }

    // Outer loop: stop once n is a single digit, else sum its digits.
    state collapse(&mut self) {
        transition self.state.n < 10 {
            true -> done()
            _ -> begin_sum()
        }
    }

    state begin_sum(&mut self) {
        self.state.sum = 0;
        transition {
            _ -> digits()
        }
    }

    // Inner loop: peel off decimal digits, adding each to the running sum.
    state digits(&mut self) {
        transition self.state.n == 0 {
            true -> fold_in()
            _ -> add_digit()
        }
    }

    state add_digit(&mut self) {
        self.state.sum = self.state.sum + self.state.n % 10;
        self.state.n = self.state.n / 10;
        transition {
            _ -> digits()
        }
    }

    // The digit sum becomes the new value; loop until it is a single digit.
    state fold_in(&mut self) {
        self.state.n = self.state.sum;
        transition {
            _ -> collapse()
        }
    }

    state done(&mut self) {
        self.console.exit_process(self.state.n);
    }
}
