// Deterministic dice roller using a linear congruential generator (LCG).
//
// LCG parameters: multiplier=1103, increment=12345, modulus=65536.
// All intermediates fit in i32 (max product: 65535 * 1103 = 72,285,105 < 2^31).
//
// Seed: 42. Five d6 rolls (d6 = state % 6 + 1):
//   step1: state=58671  d6=4
//   step2: state=42426  d6=1
//   step3: state=15519  d6=4
//   step4: state=24906  d6=1
//   step5: state=24079  d6=2
//   sum of rolls = 12; final rng_state = 24079
//
// Design: all five LCG steps are computed inline in main using let-bindings,
// avoiding sub-machine value calls and field-read-after-sub-call patterns.
//
// Verification: rng_state == 24079 AND total == 12 -> exit 70.
//
// Expected exit: 70.

use omega::language::std::console;

data Roller [copy] {
    rng_state: i32;
    total: i32;
}

data Main {
    console: Console;
    roller: Roller;
}

machine Main::main(&mut self) {
    // Seed the generator.
    let s0: i32 = 42;

    // Roll 1: next = (42*1103 + 12345) % 65536 = 58671; d6 = (58671%6)+1 = 4
    let s1: i32 = (s0 * 1103 + 12345) % 65536;
    let r1: i32 = (s1 % 6) + 1;

    // Roll 2: next = (58671*1103 + 12345) % 65536 = 42426; d6 = (42426%6)+1 = 1
    let s2: i32 = (s1 * 1103 + 12345) % 65536;
    let r2: i32 = (s2 % 6) + 1;

    // Roll 3: next = (42426*1103 + 12345) % 65536 = 15519; d6 = (15519%6)+1 = 4
    let s3: i32 = (s2 * 1103 + 12345) % 65536;
    let r3: i32 = (s3 % 6) + 1;

    // Roll 4: next = (15519*1103 + 12345) % 65536 = 24906; d6 = (24906%6)+1 = 1
    let s4: i32 = (s3 * 1103 + 12345) % 65536;
    let r4: i32 = (s4 % 6) + 1;

    // Roll 5: next = (24906*1103 + 12345) % 65536 = 24079; d6 = (24079%6)+1 = 2
    let s5: i32 = (s4 * 1103 + 12345) % 65536;
    let r5: i32 = (s5 % 6) + 1;

    // Store final state.
    self.roller.rng_state = s5;
    self.roller.total = r1 + r2 + r3 + r4 + r5;

    // Verify: state chain ended at 24079.
    transition self.roller.rng_state == 24079 {
        true -> check_total()
        _ -> bad_state()
    }

    state check_total(&mut self) {
        // r1=4, r2=1, r3=4, r4=1, r5=2 -> total=12
        transition self.roller.total == 12 {
            true -> good()
            _ -> bad_total()
        }
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad_state(&mut self) {
        self.console.exit_process(71);
    }

    state bad_total(&mut self) {
        self.console.exit_process(72);
    }
}
