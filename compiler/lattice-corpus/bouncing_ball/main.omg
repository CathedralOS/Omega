// Bouncing ball simulation: 1D integer physics, integer velocity, fixed box [0,9].
//
// Start: pos=0, vel=3
// Box:   [0, 9] inclusive (width 10)
// Step:  new_pos = pos + vel
//        if new_pos > 9: pos = 18 - new_pos, vel = -vel   (upper wall bounce)
//        elif new_pos < 0: pos = -new_pos, vel = -vel       (lower wall bounce)
//        else: pos = new_pos, vel unchanged
//
// 8 steps hand-verified:
//   init:   pos=0, vel=3
//   step 1: new=3,  ok    -> pos=3,  vel=3
//   step 2: new=6,  ok    -> pos=6,  vel=3
//   step 3: new=9,  ok    -> pos=9,  vel=3
//   step 4: new=12, >9    -> pos=18-12=6, vel=-3
//   step 5: new=6+(-3)=3, ok -> pos=3, vel=-3
//   step 6: new=3+(-3)=0, ok -> pos=0, vel=-3
//   step 7: new=0+(-3)=-3, <0 -> pos=3, vel=3
//   step 8: new=3+3=6, ok -> pos=6, vel=3
//
// Final: pos=6, exit = 6 + 64 = 70.
//
// Expected exit: 70.

use omega::language::std::console;

data Sim [copy] {
    pos: i32 in Wrapping;
    vel: i32 in Wrapping;
}

data Main {
    console: Console;
    s: Sim;
}

// Perform one step of the simulation.
// Computes new_pos = pos + vel, then applies bounce rules.
machine Main::step(&mut self) {
    let new_pos: i32 in Wrapping = self.s.pos + self.s.vel;
    transition new_pos > 9 {
        true -> upper_bounce(new_pos)
        _ -> check_lower(new_pos)
    }

    state upper_bounce(&mut self, new_pos: i32 in Wrapping) {
        // Reflect off upper wall: pos = 18 - new_pos, vel = -vel.
        self.s.pos = 18 - new_pos;
        let old_vel: i32 in Wrapping = self.s.vel;
        self.s.vel = 0 - old_vel;
    }

    state check_lower(&mut self, new_pos: i32 in Wrapping) {
        transition new_pos < 0 {
            true -> lower_bounce(new_pos)
            _ -> move_normal(new_pos)
        }
    }

    state lower_bounce(&mut self, new_pos: i32 in Wrapping) {
        // Reflect off lower wall: pos = -new_pos, vel = -vel.
        self.s.pos = 0 - new_pos;
        let old_vel: i32 in Wrapping = self.s.vel;
        self.s.vel = 0 - old_vel;
    }

    state move_normal(&mut self, new_pos: i32 in Wrapping) {
        self.s.pos = new_pos;
    }
}

machine Main::main(&mut self) {
    // Initialize: pos=0, vel=3.
    self.s.pos = 0;
    self.s.vel = 3;

    // Run 8 steps.
    self.step();
    self.step();
    self.step();
    self.step();
    self.step();
    self.step();
    self.step();
    self.step();

    // After 8 steps: pos=6, vel=3.
    // Exit code = pos + 64 = 70.
    let code: i32 in Wrapping = self.s.pos + 64;

    transition code == 70 {
        true -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(70);
    }

    state bad(&mut self) {
        self.console.exit_process(71);
    }
}
