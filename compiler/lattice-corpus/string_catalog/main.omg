// Text catalog: bounded UTF-8 fields in a data type with field copies,
// concatenation, equality guards, and a numeric score derived from matches.
//
// Exercises: carrier field assignments, copying carriers between places,
// `+` concatenation of carrier fields and literals, `==` equality guards, and
// a numeric accumulator driven by text-guard arms.
//
// Scenario: a small catalog with two entries. Each entry has a bounded UTF-8
// name and a score. After setting up the entries, the program verifies
// the names match expected values, builds a combined label by concatenation,
// verifies the concatenated label, and totals the scores.
//
// Data:
//   entry1.name = "Alpha", entry1.score = 30
//   entry2.name = "Beta",  entry2.score = 40
//
// Concatenated label: "[" + entry1.name + "+" + entry2.name + "]"
//                   = "[Alpha+Beta]"
// Total score: 30 + 40 = 70.
//
// Checks:
//   1. entry1.name == "Alpha"     -> pass
//   2. entry2.name == "Beta"      -> pass
//   3. label == "[Alpha+Beta]"    -> pass
//   4. total == 70                -> exit 70
//
// Exit 71 = wrong entry1.name, 72 = wrong entry2.name,
//           73 = wrong label, 74 = wrong total.
//
// Expected exit: 70.

domain [u8; 5]::Utf8
requires
    valid_utf8(self);
domain [u8; 16]::Utf8
requires
    valid_utf8(self);
use omega::language::std::console;

data Entry {
    name: [u8; 5] in Utf8;
    // Ranged so the exact total is statically bounded.
    score: i32 [0..=100];
}

data Catalog {
    entry1: Entry;
    entry2: Entry;
    label: [u8; 16] in Utf8;
    total: i32;
}

data Main {
    console: Console;
    catalog: Catalog;
}

machine Main::set_entry1(&mut self) {
    self.catalog.entry1.name = "Alpha";
    self.catalog.entry1.score = 30;
}

machine Main::set_entry2(&mut self) {
    self.catalog.entry2.name = "Beta";
    self.catalog.entry2.score = 40;
}

machine Main::build_label(&mut self) {
    self.catalog.label = "[" + self.catalog.entry1.name + "+" + self.catalog.entry2.name + "]";
}

machine Main::compute_total(&mut self) {
    self.catalog.total = self.catalog.entry1.score + self.catalog.entry2.score;
}

machine Main::main(&mut self) {
    self.set_entry1();
    self.set_entry2();
    self.build_label();
    self.compute_total();

    // Check entry1.name.
    transition self.catalog.entry1.name == "Alpha" {
        true -> check_name2()
        _ -> bad_name1()
    }

    state bad_name1(&mut self) { self.console.exit_process(71); }

    state check_name2(&mut self) {
        transition self.catalog.entry2.name == "Beta" {
            true -> check_label()
            _ -> bad_name2()
        }
    }

    state bad_name2(&mut self) { self.console.exit_process(72); }

    state check_label(&mut self) {
        transition self.catalog.label == "[Alpha+Beta]" {
            true -> check_total()
            _ -> bad_label()
        }
    }

    state bad_label(&mut self) { self.console.exit_process(73); }

    state check_total(&mut self) {
        transition self.catalog.total == 70 {
            true -> good()
            _ -> bad_total()
        }
    }

    state bad_total(&mut self) { self.console.exit_process(74); }

    state good(&mut self) { self.console.exit_process(70); }
}
