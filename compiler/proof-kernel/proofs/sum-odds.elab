; sum-odds.elab — the sum of the first n ODD numbers is a perfect square:  sumOdd(n) = n*n,
; where sumOdd(n) = 1 + 3 + 5 + ... + (2n-1)  (the n-th odd number added at step s n is s(n+n) = 2n+1).
; A classic closed form (a NEW kind: odd-sum -> square). By induction on n; the successor step is
; n*n + (2n+1) = (n+1)*(n+1), discharged with uaddsuc/addcomm/addassoc/mulsucr from lib/nat-semiring.elab.
(include lib/nat-semiring.elab)
(fun 46 2 (k 2)) (fun 46 3 (f 21 (rec 0) (k 3 (f 21 (v 0) (v 0)))))   ; sumOdd(0)=0 ; sumOdd(s n)=sumOdd(n)+s(n+n)

(all n (= (f 46 n) (f 22 n n)))
(rec 2 3 n (= (f 46 n) (f 22 n n))
  (refl (k 2))
  (gen n (lam ih (= (f 46 n) (f 22 n n))
    (eqelim x (= (f 21 (f 46 n) (k 3 (f 21 n n))) x) (eqelim x (= (k 3 (f 21 n (f 21 n (f 22 n n)))) (k 3 (f 21 n x))) (eqelim x (= x (f 22 n (k 3 n))) (inst* mulsucr n n) (refl (f 22 n (k 3 n)))) (refl (k 3 (f 21 n (f 21 n (f 22 n n)))))) (eqelim x (= (f 21 (f 46 n) (k 3 (f 21 n n))) x) (eqelim x (= (k 3 (f 21 (f 21 n n) (f 22 n n))) (k 3 x)) (inst* addassoc n n (f 22 n n)) (refl (k 3 (f 21 (f 21 n n) (f 22 n n))))) (eqelim x (= (f 21 (f 46 n) (k 3 (f 21 n n))) x) (eqelim x (= (k 3 (f 21 (f 22 n n) (f 21 n n))) (k 3 x)) (inst* addcomm (f 22 n n) (f 21 n n)) (refl (k 3 (f 21 (f 22 n n) (f 21 n n))))) (eqelim x (= (f 21 (f 46 n) (k 3 (f 21 n n))) x) (inst* uaddsuc (f 22 n n) (f 21 n n)) (eqelim x (= (f 21 (f 46 n) (k 3 (f 21 n n))) x) (eqelim x (= (f 21 (f 46 n) (k 3 (f 21 n n))) (f 21 x (k 3 (f 21 n n)))) ih (refl (f 21 (f 46 n) (k 3 (f 21 n n))))) (refl (f 21 (f 46 n) (k 3 (f 21 n n))))))))))))
