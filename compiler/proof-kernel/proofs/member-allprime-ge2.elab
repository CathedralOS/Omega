; a member of an all-prime list is at least 2: Mem(x,L) & allPrime(L) -> 2<=x
; allPrime(L) = forall y. Mem(y,L) -> prime(y). Apply allPrime to x (giving prime(x)), then prime-ge-2.
(def 0 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(def 1 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 2 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 3 (all x1 (all x2 (-> (ex x3 (= (+ x1 (s x3)) x2)) (ex x4 (= (+ (s x1) x4) x2))))) (gen x5 (gen x6 (lam h7 (ex x8 (= (+ x5 (s x8)) x6)) (unpack h7 (gen x9 (lam h10 (= (+ x5 (s x9)) x6) (wit x11 (= (+ (s x5) x11) x6) x9 (app (app (inst (inst (inst (use 2) (s (+ x5 x9))) (+ x5 (s x9))) x6) (app (inst (inst (use 1) (+ x5 (s x9))) (s (+ x5 x9))) (inst (inst (use 0) x5) x9))) h10)))))))))
(def 4 (all x1 (-> (& (ex x2 (= (+ (s z) (s x2)) x1)) (all x3 (-> (ex x4 (= (* x4 x3) x1)) (or (= x3 (s z)) (= x3 x1))))) (ex x5 (= (+ (s (s z)) x5) x1)))) (gen x6 (lam h7 (& (ex x8 (= (+ (s z) (s x8)) x6)) (all x9 (-> (ex x10 (= (* x10 x9) x6)) (or (= x9 (s z)) (= x9 x6))))) (app (inst (inst (use 3) (s z)) x6) (fst h7)))))
(all x1 (all x2 (-> (rel 777 x1 x2) (-> (all x3 (-> (rel 777 x3 x2) (& (ex x4 (= (+ (s z) (s x4)) x3)) (all x5 (-> (ex x6 (= (* x6 x5) x3)) (or (= x5 (s z)) (= x5 x3))))))) (ex x7 (= (+ (s (s z)) x7) x1))))))
(gen x1 (gen x2 (lam h3 (rel 777 x1 x2) (lam h4 (all x5 (-> (rel 777 x5 x2) (& (ex x6 (= (+ (s z) (s x6)) x5)) (all x7 (-> (ex x8 (= (* x8 x7) x5)) (or (= x7 (s z)) (= x7 x5))))))) (app (inst (use 4) x1) (app (inst h4 x1) h3))))))
