; sum of (map successor): sum(map L) = sum L + len L  (each element +1 raises the sum by the count)
; induction on L; cons case rewrites sum(map t) via IH, then reassociates h+(sumt+lent)=(h+sumt)+lent (+ associative, s congruence) to match (h+sumt)+S(lent).
(data 2 0 0 0)
(data 3 2 0 1)
(fun 10 2 z)
(fun 10 3 (s (rec 1)))
(fun 11 2 (k 2))
(fun 11 3 (k 3 (s (v 0)) (rec 1)))
(fun 12 2 z)
(fun 12 3 (+ (v 0) (rec 1)))
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 2 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 3 (all x1 (all x2 (-> (= x1 x2) (= (s x1) (s x2))))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= (s x3) (s x6)) h5 (refl (s x3)))))))
(def 4 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(all x1 (= (f 12 (f 11 x1)) (+ (f 12 x1) (f 10 x1))))
(rec 2 3 x1 (= (f 12 (f 11 x1)) (+ (f 12 x1) (f 10 x1))) (refl z) (gen x2 (gen x3 (lam h4 (= (f 12 (f 11 x3)) (+ (f 12 x3) (f 10 x3))) (app (app (inst (inst (inst (use 1) (+ (s x2) (f 12 (f 11 x3)))) (+ (s x2) (+ (f 12 x3) (f 10 x3)))) (+ (+ x2 (f 12 x3)) (s (f 10 x3)))) (eqelim x5 (= (+ (s x2) (f 12 (f 11 x3))) (+ (s x2) x5)) h4 (refl (+ (s x2) (f 12 (f 11 x3)))))) (app (app (inst (inst (inst (use 1) (+ (s x2) (+ (f 12 x3) (f 10 x3)))) (s (+ (+ x2 (f 12 x3)) (f 10 x3)))) (+ (+ x2 (f 12 x3)) (s (f 10 x3)))) (app (inst (inst (use 3) (+ x2 (+ (f 12 x3) (f 10 x3)))) (+ (+ x2 (f 12 x3)) (f 10 x3))) (app (inst (inst (use 0) (+ (+ x2 (f 12 x3)) (f 10 x3))) (+ x2 (+ (f 12 x3) (f 10 x3)))) (inst (inst (inst (use 2) (f 12 x3)) (f 10 x3)) x2)))) (app (inst (inst (use 0) (+ (+ x2 (f 12 x3)) (s (f 10 x3)))) (s (+ (+ x2 (f 12 x3)) (f 10 x3)))) (inst (inst (use 4) (+ x2 (f 12 x3))) (f 10 x3)))))))))
