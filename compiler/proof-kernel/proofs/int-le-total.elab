; ZZ-order is total: x<=y or y<=x  (immediate from N totality at (a+d),(c+b))
(def 0 (all x1 (all x2 (-> (ex x3 (= (+ x1 x3) x2)) (ex x4 (= (+ (s x1) x4) (s x2)))))) (gen x5 (gen x6 (lam h7 (ex x8 (= (+ x5 x8) x6)) (unpack h7 (gen x9 (lam h10 (= (+ x5 x9) x6) (wit x11 (= (+ (s x5) x11) (s x6)) x9 (eqelim x12 (= (+ (s x5) x9) (s x12)) h10 (refl (+ (s x5) x9)))))))))))
(def 1 (all x1 (or (= x1 z) (ex x2 (= x1 (s x2))))) (natind x3 (or (= x3 z) (ex x4 (= x3 (s x4)))) (inl (ex x5 (= z (s x5))) (refl z)) (gen x6 (lam h7 (or (= x6 z) (ex x8 (= x6 (s x8)))) (inr (= (s x6) z) (wit x9 (= (s x6) (s x9)) x6 (refl (s x6))))))))
(def 2 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 3 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 4 (all x1 (all x2 (or (ex x3 (= (+ x1 x3) x2)) (ex x4 (= (+ x2 x4) x1))))) (natind x5 (all x6 (or (ex x7 (= (+ x5 x7) x6)) (ex x8 (= (+ x6 x8) x5)))) (gen x9 (inl (ex x10 (= (+ x9 x10) z)) (wit x11 (= (+ z x11) x9) x9 (refl x9)))) (gen x12 (lam h13 (all x14 (or (ex x15 (= (+ x12 x15) x14)) (ex x16 (= (+ x14 x16) x12)))) (gen x17 (case (inst (use 1) x17) (lam h18 (= x17 z) (inr (ex x19 (= (+ (s x12) x19) x17)) (wit x20 (= (+ x17 x20) (s x12)) (s x12) (eqelim x21 (= (+ x21 (s x12)) (s x12)) (app (inst (inst (use 2) x17) z) h18) (refl (s x12)))))) (lam h22 (ex x23 (= x17 (s x23))) (unpack h22 (gen x24 (lam h25 (= x17 (s x24)) (case (inst h13 x24) (lam h26 (ex x27 (= (+ x12 x27) x24)) (inl (ex x28 (= (+ x17 x28) (s x12))) (unpack (app (inst (inst (use 0) x12) x24) h26) (gen x29 (lam h30 (= (+ (s x12) x29) (s x24)) (wit x31 (= (+ (s x12) x31) x17) x29 (app (app (inst (inst (inst (use 3) (+ (s x12) x29)) (s x24)) x17) h30) (app (inst (inst (use 2) x17) (s x24)) h25)))))))) (lam h32 (ex x33 (= (+ x24 x33) x12)) (inr (ex x34 (= (+ (s x12) x34) x17)) (unpack (app (inst (inst (use 0) x24) x12) h32) (gen x35 (lam h36 (= (+ (s x24) x35) (s x12)) (wit x37 (= (+ x17 x37) (s x12)) x35 (app (app (inst (inst (inst (use 3) (+ x17 x35)) (+ (s x24) x35)) (s x12)) (eqelim x38 (= (+ x17 x35) (+ x38 x35)) h25 (refl (+ x17 x35)))) h36))))))))))))))))))
(all x1 (all x2 (all x3 (all x4 (or (ex x5 (= (+ (+ x1 x4) x5) (+ x3 x2))) (ex x6 (= (+ (+ x3 x2) x6) (+ x1 x4))))))))
(gen x1 (gen x2 (gen x3 (gen x4 (inst (inst (use 4) (+ x1 x4)) (+ x3 x2))))))
