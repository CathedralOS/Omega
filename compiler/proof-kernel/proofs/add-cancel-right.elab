; right cancellation: a+c=b+c -> a=b   (induction on c, a/b fixed)
(def 0 (all n (= (+ n 0) n))
  (natind n (= (+ n 0) n) (refl 0)
    (gen n2 (lam ih (= (+ n2 0) n2) (eqelim hole (= (s (+ n2 0)) (s hole)) ih (refl (s (+ n2 0))))))))
(def 1 (all a (all m (= (+ a (s m)) (s (+ a m)))))
  (natind a (all m (= (+ a (s m)) (s (+ a m))))
    (gen m (refl (s m)))
    (gen a2 (lam ih (all m (= (+ a2 (s m)) (s (+ a2 m))))
      (gen m (eqelim hole (= (+ (s a2) (s m)) (s hole)) (inst ih m) (refl (+ (s a2) (s m)))))))))
(def 2 (all x (all y (-> (= x y) (= y x))))
  (gen x (gen y (lam h (= x y) (eqelim hole (= hole x) h (refl x))))))
(def 3 (all x (all y (all z (-> (= x y) (-> (= y z) (= x z))))))
  (gen x (gen y (gen z (lam h1 (= x y) (lam h2 (= y z) (eqelim hole (= x hole) h2 h1)))))))
(all a (all b (all c (-> (= (+ a c) (+ b c)) (= a b)))))
(gen a (gen b (natind c (-> (= (+ a c) (+ b c)) (= a b))
  (lam h (= (+ a 0) (+ b 0))
    (app* (inst* (use 3) a (+ b 0) b)
          (app* (inst* (use 3) a (+ a 0) (+ b 0))
                (app (inst* (use 2) (+ a 0) a) (inst (use 0) a))
                h)
          (inst (use 0) b)))
  (gen c2 (lam ih (-> (= (+ a c2) (+ b c2)) (= a b))
    (lam h (= (+ a (s c2)) (+ b (s c2)))
      (app ih
        (sinj
          (app* (inst* (use 3) (s (+ a c2)) (+ b (s c2)) (s (+ b c2)))
                (app* (inst* (use 3) (s (+ a c2)) (+ a (s c2)) (+ b (s c2)))
                      (app (inst* (use 2) (+ a (s c2)) (s (+ a c2))) (inst* (use 1) a c2))
                      h)
                (inst* (use 1) b c2))))))))))
