; gcd(a,a)=a: a is a gcd of itself
(def 0 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 1 (all x1 (= (* (s z) x1) x1)) (gen x2 (inst (use 0) x2)))
(all x1 (& (ex x2 (= (* x2 x1) x1)) (& (ex x3 (= (* x3 x1) x1)) (all x4 (-> (ex x5 (= (* x5 x4) x1)) (-> (ex x6 (= (* x6 x4) x1)) (ex x7 (= (* x7 x4) x1))))))))
(gen x1 (pair (wit x2 (= (* x2 x1) x1) (s z) (inst (use 1) x1)) (pair (wit x3 (= (* x3 x1) x1) (s z) (inst (use 1) x1)) (gen x4 (lam h5 (ex x6 (= (* x6 x4) x1)) (lam h7 (ex x8 (= (* x8 x4) x1)) h5))))))
