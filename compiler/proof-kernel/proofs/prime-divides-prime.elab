; a prime dividing a prime are EQUAL: prime(p) & prime(q) & p|q -> p=q.
; q prime gives (p|q -> p=1 or p=q) by instantiating its divisor-universal (snd) at p, applied to p|q;
; p prime gives p>=2 (fst), ruling out p=1 -- since 1+(1+k)=1 forces s(s k)=s z, refuted by
; s-injectivity then z/s constructor-disjointness. So the surviving disjunct is p=q.
; This is the equality step FTA UNIQUENESS turns on: a prime in one factor list divides the other
; list's product, hence (Euclid) divides a prime there, hence -- by THIS lemma -- equals it.
; prime(x) := (exists k. 1+(1+k) = x) & (forall d. (exists e. e*d = x) -> (d=1 or d=x))   [the >=2 form]
(def 0 (all a (all b (all c (-> (= a b) (-> (= b c) (= a c))))))
  (gen a (gen b (gen c (lam hab (= a b) (lam hbc (= b c) (eqelim w (= a w) hbc hab)))))))
(all p (all q (-> (& (ex k (= (+ (s z) (s k)) p)) (all d (-> (ex e (= (* e d) p)) (or (= d (s z)) (= d p)))))
  (-> (& (ex k2 (= (+ (s z) (s k2)) q)) (all d2 (-> (ex e2 (= (* e2 d2) q)) (or (= d2 (s z)) (= d2 q)))))
    (-> (ex c (= (* c p) q)) (= p q))))))
(gen p (gen q
  (lam hp (& (ex k (= (+ (s z) (s k)) p)) (all d (-> (ex e (= (* e d) p)) (or (= d (s z)) (= d p)))))
  (lam hq (& (ex k2 (= (+ (s z) (s k2)) q)) (all d2 (-> (ex e2 (= (* e2 d2) q)) (or (= d2 (s z)) (= d2 q)))))
  (lam hpq (ex c (= (* c p) q))
    (case (app (inst (snd hq) p) hpq)
      (lam he1 (= p (s z))
        (unpack (fst hp) (gen k (lam eq0 (= (+ (s z) (s k)) p)
          (absurd (= p q) (disj (sinj (app* (inst* (use 0) (s (s k)) p (s z)) eq0 he1))))))))
      (lam heq (= p q) heq)))))))
