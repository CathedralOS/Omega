; binary-tree mirror is an involution: mirror(mirror t) = t
; structural rec on the Tree (Leaf=k4, Node(l,r)=k5 l r); mirror swaps children (fun 9).
; Node step has TWO IHs (one per subtree); the tree analog of reverse-involution.
(data 4 0 0 0)
(data 5 2 1 1)
(fun 9 4 (k 4))
(fun 9 5 (k 5 (rec 1) (rec 0)))
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(all x1 (= (f 9 (f 9 x1)) x1))
(rec 4 5 x1 (= (f 9 (f 9 x1)) x1) (refl (k 4)) (gen x2 (gen x3 (lam h4 (= (f 9 (f 9 x2)) x2) (lam h5 (= (f 9 (f 9 x3)) x3) (app (app (inst (inst (inst (use 1) (k 5 (f 9 (f 9 x2)) (f 9 (f 9 x3)))) (k 5 x2 (f 9 (f 9 x3)))) (k 5 x2 x3)) (eqelim x6 (= (k 5 (f 9 (f 9 x2)) (f 9 (f 9 x3))) (k 5 x6 (f 9 (f 9 x3)))) h4 (refl (k 5 (f 9 (f 9 x2)) (f 9 (f 9 x3)))))) (eqelim x7 (= (k 5 x2 (f 9 (f 9 x3))) (k 5 x2 x7)) h5 (refl (k 5 x2 (f 9 (f 9 x3)))))))))))
