(def 14 (all x1 (all x2 (all x3 (-> (ex x4 (= (+ x1 (s x4)) x2)) (-> (ex x5 (= (+ x2 x5) x3)) (ex x6 (= (+ x1 (s x6)) x3))))))) (gen x7 (gen x8 (gen x9 (lam h10 (ex x11 (= (+ x7 (s x11)) x8)) (lam h12 (ex x13 (= (+ x8 x13) x9)) (unpack h10 (gen x14 (lam h15 (= (+ x7 (s x14)) x8) (unpack h12 (gen x16 (lam h17 (= (+ x8 x16) x9) (wit x18 (= (+ x7 (s x18)) x9) (+ x14 x16) (app (app (inst (inst (inst (use 13) (+ x7 (+ (s x14) x16))) (+ (+ x7 (s x14)) x16)) x9) (app (inst (inst (use 12) (+ (+ x7 (s x14)) x16)) (+ x7 (+ (s x14) x16))) (inst (inst (inst (use 11) (s x14)) x16) x7))) (app (app (inst (inst (inst (use 13) (+ (+ x7 (s x14)) x16)) (+ x8 x16)) x9) (eqelim x19 (= (+ (+ x7 (s x14)) x16) (+ x19 x16)) h15 (refl (+ (+ x7 (s x14)) x16)))) h17)))))))))))))))
(all x1 (all x2 (all x3 (all x4 (all x5 (-> (ex x6 (= (+ (+ x1 (* x2 x3)) x6) x4)) (-> (ex x7 (= (+ x5 (s x7)) x2)) (-> (ex x8 (= (+ z (s x8)) x3)) (ex x9 (= (+ (+ x1 (* x5 x3)) (s x9)) x4))))))))))
(gen x1 (gen x2 (gen x3 (gen x4 (gen x5 (lam h6 (ex x7 (= (+ (+ x1 (* x2 x3)) x7) x4)) (lam h8 (ex x9 (= (+ x5 (s x9)) x2)) (lam h10 (ex x11 (= (+ z (s x11)) x3)) (app (app (inst (inst (inst (use 14) (+ x1 (* x5 x3))) (+ x1 (* x2 x3))) x4) (app (inst (inst (inst (use 10) (* x5 x3)) (* x2 x3)) x1) (app (app (inst (inst (inst (use 6) x5) x2) x3) h8) h10))) h6)))))))))
