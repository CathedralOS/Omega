; memory-safety VC for strided / struct-array indexing:
;   (base + count*stride <= total) & (i < count) & (0 < stride) -> base + i*stride < total
; element i of an array of `count` items each `stride` bytes (stride = struct size, cf. layout) stays in bounds. Generalizes slice-index (stride 1). Chain: lt-mult-mono (i*stride<count*stride), lt-add-left (base+..), lt-le-trans (<=total).
(def 0 (all x1 (all x2 (all x3 (= (+ (+ x1 x2) x3) (+ x1 (+ x2 x3)))))) (natind x4 (all x5 (all x6 (= (+ (+ x4 x5) x6) (+ x4 (+ x5 x6))))) (gen x7 (gen x8 (refl (+ x7 x8)))) (gen x9 (lam h10 (all x11 (all x12 (= (+ (+ x9 x11) x12) (+ x9 (+ x11 x12))))) (gen x13 (gen x14 (eqelim x15 (= (+ (+ (s x9) x13) x14) (s x15)) (inst (inst h10 x13) x14) (refl (+ (+ (s x9) x13) x14)))))))))
