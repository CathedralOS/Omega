; cons is injective: cons h1 t1 = cons h2 t2 -> h1 = h2 AND t1 = t2
; project head (field 0) and tail (field 1) through Leibniz congruence; each projection equation reduces to the component equality by conversion.
(data 2 0 0 0)
(data 3 2 0 1)
(fun 6 2 z)
(fun 6 3 (v 0))
(fun 7 2 (k 2))
(fun 7 3 (v 1))
(all x1 (all x2 (all x3 (all x4 (-> (= (k 3 x1 x2) (k 3 x3 x4)) (& (= x1 x3) (= x2 x4)))))))
(gen x1 (gen x2 (gen x3 (gen x4 (lam h5 (= (k 3 x1 x2) (k 3 x3 x4)) (pair (eqelim x6 (= (f 6 (k 3 x1 x2)) (f 6 x6)) h5 (refl (f 6 (k 3 x1 x2)))) (eqelim x7 (= (f 7 (k 3 x1 x2)) (f 7 x7)) h5 (refl (f 7 (k 3 x1 x2))))))))))
