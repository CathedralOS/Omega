(fun 31 60 (k 60)) (fun 31 61 (f 30 (rec 1) (v 0)))
(fun 35 60 z) (fun 35 61 (s (rec 1)))

(all l (= (f 35 (f 31 l)) (f 35 l)))
(have booldec (all b (or (= b (k 80)) (= b (k 81)))) (rec 80 81 b (or (= b (k 80)) (= b (k 81))) (inl (= (k 80) (k 81)) (refl (k 80))) (inr (= (k 81) (k 80)) (refl (k 81)))) (have insred1 (all x (all z (all zs (-> (= (f 25 x z) (k 80)) (= (f 30 (k 61 z zs) x) (k 61 x (k 61 z zs))))))) (gen x (gen z (gen zs (lam eqT (= (f 25 x z) (k 80)) (eqelim w (= (f 29 w (k 70 (k 61 x (k 61 z zs)) (k 61 z (f 30 zs x)))) (k 61 x (k 61 z zs))) (eqelim v (= v (f 25 x z)) eqT (refl (f 25 x z))) (refl (k 61 x (k 61 z zs)))))))) (have insred2 (all x (all z (all zs (-> (= (f 25 x z) (k 81)) (= (f 30 (k 61 z zs) x) (k 61 z (f 30 zs x))))))) (gen x (gen z (gen zs (lam eqF (= (f 25 x z) (k 81)) (eqelim w (= (f 29 w (k 70 (k 61 x (k 61 z zs)) (k 61 z (f 30 zs x)))) (k 61 z (f 30 zs x))) (eqelim v (= v (f 25 x z)) eqF (refl (f 25 x z))) (refl (k 61 z (f 30 zs x)))))))) (have insertlen (all l (all x (= (f 35 (f 30 l x)) (s (f 35 l))))) (rec 60 61 l (all x (= (f 35 (f 30 l x)) (s (f 35 l)))) (gen x (refl (s (f 35 (k 60))))) (gen z (gen zs (lam ih (all x (= (f 35 (f 30 zs x)) (s (f 35 zs)))) (gen x (case (inst* booldec (f 25 x z)) (lam eqT (= (f 25 x z) (k 80)) (eqelim sv1 (= (f 35 sv1) (s (f 35 (k 61 z zs)))) (eqelim sv2 (= sv2 (f 30 (k 61 z zs) x)) (app (inst* insred1 x z zs) eqT) (refl (f 30 (k 61 z zs) x))) (refl (s (f 35 (k 61 z zs)))))) (lam eqF (= (f 25 x z) (k 81)) (eqelim sv5 (= (f 35 sv5) (s (f 35 (k 61 z zs)))) (eqelim sv6 (= sv6 (f 30 (k 61 z zs) x)) (app (inst* insred2 x z zs) eqF) (refl (f 30 (k 61 z zs) x))) (eqelim sv3 (= (s sv3) (s (f 35 (k 61 z zs)))) (eqelim sv4 (= sv4 (f 35 (f 30 zs x))) (inst* ih x) (refl (f 35 (f 30 zs x)))) (refl (s (f 35 (k 61 z zs))))))))))))) (rec 60 61 l (= (f 35 (f 31 l)) (f 35 l)) (refl z) (gen h (gen t (lam ih (= (f 35 (f 31 t)) (f 35 t)) (eqelim w (= (f 35 (f 30 (f 31 t) h)) (s w)) ih (inst* insertlen (f 31 t) h))))))))))
