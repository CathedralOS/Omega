; even n  <->  2 | n : the bridge between the parity sub-theory and the divisibility sub-theory.
; even n = exists k. n = k+k (additive) ; 2|n = exists c. c*2 = n (divisibility). The witness is the
; same number both ways; n+n = 2*n (doubling=times-two) plus mult-comm convert between k+k and k*2.
; Lets parity facts (parity-exclusive, even-square) transfer to the divides machinery (Euclid, FTA)
; and back -- e.g. 2|n^2 -> 2|n becomes a corollary of even-square-even through this equivalence.
(def 0 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 1 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 2 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 3 (all x1 (= (+ x1 x1) (* (s (s z)) x1))) (gen x2 (app (inst (inst (use 1) (* (s (s z)) x2)) (+ x2 x2)) (app (app (inst (inst (inst (use 2) (* (s (s z)) x2)) (+ x2 (+ x2 z))) (+ x2 x2)) (refl (* (s (s z)) x2))) (eqelim x3 (= (+ x2 (+ x2 z)) (+ x2 x3)) (inst (use 0) x2) (refl (+ x2 (+ x2 z))))))))
(def 4 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 5 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 6 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 7 (all x1 (all x2 (all x3 (= (+ (+ x3 x1) x2) (+ x3 (+ x1 x2)))))) (gen x4 (gen x5 (natind x6 (= (+ (+ x6 x4) x5) (+ x6 (+ x4 x5))) (refl (+ x4 x5)) (gen x7 (lam h8 (= (+ (+ x7 x4) x5) (+ x7 (+ x4 x5))) (eqelim x9 (= (s (+ (+ x7 x4) x5)) (s x9)) h8 (refl (s (+ (+ x7 x4) x5))))))))))
(def 8 (all x1 (all x2 (-> (= x1 x2) (= (s x1) (s x2))))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= (s x3) (s x6)) h5 (refl (s x3)))))))
(def 9 (all x1 (all x2 (= (+ x2 (s x1)) (s (+ x2 x1))))) (gen x3 (natind x4 (= (+ x4 (s x3)) (s (+ x4 x3))) (refl (s x3)) (gen x5 (lam h6 (= (+ x5 (s x3)) (s (+ x5 x3))) (eqelim x7 (= (s (+ x5 (s x3))) (s x7)) h6 (refl (s (+ x5 (s x3))))))))))
(def 10 (all x1 (all x2 (= (+ x1 (s x2)) (s (+ x1 x2))))) (natind x3 (all x4 (= (+ x3 (s x4)) (s (+ x3 x4)))) (gen x5 (refl (s x5))) (gen x6 (lam h7 (all x8 (= (+ x6 (s x8)) (s (+ x6 x8)))) (gen x9 (eqelim x10 (= (+ (s x6) (s x9)) (s x10)) (inst h7 x9) (refl (+ (s x6) (s x9)))))))))
(def 11 (all x1 (all x2 (= (+ x2 x1) (+ x1 x2)))) (gen x3 (natind x4 (= (+ x4 x3) (+ x3 x4)) (eqelim x5 (= x5 (+ x3 z)) (inst (use 4) x3) (refl (+ x3 z))) (gen x6 (lam h7 (= (+ x6 x3) (+ x3 x6)) (app (app (inst (inst (inst (use 6) (s (+ x6 x3))) (s (+ x3 x6))) (+ x3 (s x6))) (eqelim x8 (= (s (+ x6 x3)) (s x8)) h7 (refl (s (+ x6 x3))))) (app (inst (inst (use 5) (+ x3 (s x6))) (s (+ x3 x6))) (inst (inst (use 9) x6) x3))))))))
(def 12 (all x1 (all x2 (= (* x1 (s x2)) (+ (* x1 x2) x1)))) (natind x3 (all x4 (= (* x3 (s x4)) (+ (* x3 x4) x3))) (gen x5 (refl z)) (gen x6 (lam h7 (all x8 (= (* x6 (s x8)) (+ (* x6 x8) x6))) (gen x9 (app (app (inst (inst (inst (use 6) (* (s x6) (s x9))) (s (+ (+ x9 (* x6 x9)) x6))) (+ (+ x9 (* x6 x9)) (s x6))) (app (app (inst (inst (inst (use 6) (* (s x6) (s x9))) (+ (s x9) (+ (* x6 x9) x6))) (s (+ (+ x9 (* x6 x9)) x6))) (eqelim x10 (= (* (s x6) (s x9)) (+ (s x9) x10)) (inst h7 x9) (refl (* (s x6) (s x9))))) (app (inst (inst (use 8) (+ x9 (+ (* x6 x9) x6))) (+ (+ x9 (* x6 x9)) x6)) (app (inst (inst (use 5) (+ (+ x9 (* x6 x9)) x6)) (+ x9 (+ (* x6 x9) x6))) (inst (inst (inst (use 7) (* x6 x9)) x6) x9))))) (app (inst (inst (use 5) (+ (+ x9 (* x6 x9)) (s x6))) (s (+ (+ x9 (* x6 x9)) x6))) (inst (inst (use 10) (+ x9 (* x6 x9))) x6))))))))
(def 13 (all x1 (= (* x1 z) z)) (natind x2 (= (* x2 z) z) (refl z) (gen x3 (lam h4 (= (* x3 z) z) h4))))
(def 14 (all x1 (all x2 (= (* x2 x1) (* x1 x2)))) (gen x3 (natind x4 (= (* x4 x3) (* x3 x4)) (app (inst (inst (use 5) (* x3 z)) z) (inst (use 13) x3)) (gen x5 (lam h6 (= (* x5 x3) (* x3 x5)) (app (app (inst (inst (inst (use 6) (* (s x5) x3)) (+ x3 (* x3 x5))) (* x3 (s x5))) (eqelim x7 (= (* (s x5) x3) (+ x3 x7)) h6 (refl (* (s x5) x3)))) (app (app (inst (inst (inst (use 6) (+ x3 (* x3 x5))) (+ (* x3 x5) x3)) (* x3 (s x5))) (inst (inst (use 11) (* x3 x5)) x3)) (app (inst (inst (use 5) (* x3 (s x5))) (+ (* x3 x5) x3)) (inst (inst (use 12) x3) x5)))))))))
(def 15 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 16 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(all x1 (& (-> (ex x2 (= x1 (+ x2 x2))) (ex x3 (= (* x3 (s (s z))) x1))) (-> (ex x4 (= (* x4 (s (s z))) x1)) (ex x5 (= x1 (+ x5 x5))))))
(gen x1 (pair (lam h2 (ex x3 (= x1 (+ x3 x3))) (unpack h2 (gen x4 (lam h5 (= x1 (+ x4 x4)) (wit x6 (= (* x6 (s (s z))) x1) x4 (app (app (inst (inst (inst (use 16) (* x4 (s (s z)))) (* (s (s z)) x4)) x1) (inst (inst (use 14) (s (s z))) x4)) (app (app (inst (inst (inst (use 16) (* (s (s z)) x4)) (+ x4 x4)) x1) (app (inst (inst (use 15) (+ x4 x4)) (* (s (s z)) x4)) (inst (use 3) x4))) (app (inst (inst (use 15) x1) (+ x4 x4)) h5)))))))) (lam h7 (ex x8 (= (* x8 (s (s z))) x1)) (unpack h7 (gen x9 (lam h10 (= (* x9 (s (s z))) x1) (wit x11 (= x1 (+ x11 x11)) x9 (app (app (inst (inst (inst (use 16) x1) (* x9 (s (s z)))) (+ x9 x9)) (app (inst (inst (use 15) (* x9 (s (s z)))) x1) h10)) (app (app (inst (inst (inst (use 16) (* x9 (s (s z)))) (* (s (s z)) x9)) (+ x9 x9)) (inst (inst (use 14) (s (s z))) x9)) (app (inst (inst (use 15) (+ x9 x9)) (* (s (s z)) x9)) (inst (use 3) x9)))))))))))
