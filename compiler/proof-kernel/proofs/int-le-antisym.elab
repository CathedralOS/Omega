(def 4 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 5 (all x1 (all x2 (= (+ x2 (s x1)) (s (+ x2 x1))))) (gen x3 (natind x4 (= (+ x4 (s x3)) (s (+ x4 x3))) (refl (s x3)) (gen x5 (lam h6 (= (+ x5 (s x3)) (s (+ x5 x3))) (eqelim x7 (= (s (+ x5 (s x3))) (s x7)) h6 (refl (s (+ x5 (s x3))))))))))
(def 6 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 7 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 8 (all x1 (all x2 (= (+ x2 x1) (+ x1 x2)))) (gen x3 (natind x4 (= (+ x4 x3) (+ x3 x4)) (eqelim x5 (= x5 (+ x3 z)) (inst (use 4) x3) (refl (+ x3 z))) (gen x6 (lam h7 (= (+ x6 x3) (+ x3 x6)) (app (app (inst (inst (inst (use 7) (s (+ x6 x3))) (s (+ x3 x6))) (+ x3 (s x6))) (eqelim x8 (= (s (+ x6 x3)) (s x8)) h7 (refl (s (+ x6 x3))))) (app (inst (inst (use 6) (+ x3 (s x6))) (s (+ x3 x6))) (inst (inst (use 5) x6) x3))))))))
(def 9 (all x1 (all x2 (all x3 (-> (= (+ x1 x2) (+ x1 x3)) (= x2 x3))))) (natind x4 (all x5 (all x6 (-> (= (+ x4 x5) (+ x4 x6)) (= x5 x6)))) (gen x7 (gen x8 (lam h9 (= (+ z x7) (+ z x8)) h9))) (gen x10 (lam h11 (all x12 (all x13 (-> (= (+ x10 x12) (+ x10 x13)) (= x12 x13)))) (gen x14 (gen x15 (lam h16 (= (+ (s x10) x14) (+ (s x10) x15)) (app (inst (inst h11 x14) x15) (sinj h16)))))))))
(def 10 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 11 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 12 (all x1 (all x2 (-> (= (+ x1 x2) z) (= x1 z)))) (natind x3 (all x4 (-> (= (+ x3 x4) z) (= x3 z))) (gen x5 (lam h6 (= (+ z x5) z) (refl z))) (gen x7 (lam h8 (all x9 (-> (= (+ x7 x9) z) (= x7 z))) (gen x10 (lam h11 (= (+ (s x7) x10) z) (absurd (= (s x7) z) (disj (app (app (inst (inst (inst (use 11) z) (+ (s x7) x10)) (s (+ x7 x10))) (app (inst (inst (use 10) (+ (s x7) x10)) z) h11)) (refl (+ (s x7) x10)))))))))))
(all x1 (all x2 (all x3 (all x4 (-> (ex x5 (= (+ (+ x1 x4) x5) (+ x3 x2))) (-> (ex x6 (= (+ (+ x3 x2) x6) (+ x1 x4))) (= (+ x1 x4) (+ x3 x2))))))))
(gen x1 (gen x2 (gen x3 (gen x4 (lam h5 (ex x6 (= (+ (+ x1 x4) x6) (+ x3 x2))) (lam h7 (ex x8 (= (+ (+ x3 x2) x8) (+ x1 x4))) (unpack h5 (gen x9 (lam h10 (= (+ (+ x1 x4) x9) (+ x3 x2)) (unpack h7 (gen x11 (lam h12 (= (+ (+ x3 x2) x11) (+ x1 x4)) (app (app (inst (inst (inst (use 1) (+ x1 x4)) (+ (+ x1 x4) z)) (+ x3 x2)) (app (inst (inst (use 0) (+ (+ x1 x4) z)) (+ x1 x4)) (inst (use 2) (+ x1 x4)))) (eqelim x13 (= (+ (+ x1 x4) x13) (+ x3 x2)) (app (inst (inst (use 12) x9) x11) (app (app (inst (inst (inst (use 1) (+ x9 x11)) (+ x11 x9)) z) (inst (inst (use 8) x11) x9)) (app (inst (inst (inst (use 9) (+ x3 x2)) (+ x11 x9)) z) (app (app (inst (inst (inst (use 1) (+ (+ x3 x2) (+ x11 x9))) (+ x3 x2)) (+ (+ x3 x2) z)) (app (app (inst (inst (inst (use 1) (+ (+ x3 x2) (+ x11 x9))) (+ (+ (+ x3 x2) x11) x9)) (+ x3 x2)) (app (inst (inst (use 0) (+ (+ (+ x3 x2) x11) x9)) (+ (+ x3 x2) (+ x11 x9))) (inst (inst (inst (use 3) x11) x9) (+ x3 x2)))) (app (app (inst (inst (inst (use 1) (+ (+ (+ x3 x2) x11) x9)) (+ (+ x1 x4) x9)) (+ x3 x2)) (eqelim x14 (= (+ (+ (+ x3 x2) x11) x9) (+ x14 x9)) h12 (refl (+ (+ (+ x3 x2) x11) x9)))) h10))) (app (inst (inst (use 0) (+ (+ x3 x2) z)) (+ x3 x2)) (inst (use 2) (+ x3 x2))))))) h10))))))))))))))
