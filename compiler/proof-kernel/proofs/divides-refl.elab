; a|a  — divisibility is reflexive (witness 1; 1*a = a+0*a = a+0 = a)
(def 0 (all n (= (+ n 0) n))
  (natind n (= (+ n 0) n) (refl 0)
    (gen n2 (lam ih (= (+ n2 0) n2) (eqelim hole (= (s (+ n2 0)) (s hole)) ih (refl (s (+ n2 0))))))))
(all a (ex m (= (* m a) a)))
(gen a (wit m (= (* m a) a) 1 (inst (use 0) a)))
