; every prime is its own factorization: prime(p) -> Factor(p), witnessed by the singleton list [p]
; Factor(k) := exists L. ProdIs(L,k) & (forall x. Mem(x,L) -> prime(x))
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (= (* x1 (s z)) x1)) (natind x2 (= (* x2 (s z)) x2) (refl z) (gen x3 (lam h4 (= (* x3 (s z)) x3) (eqelim x5 (= (s (* x3 (s z))) (s x5)) h4 (refl (s (* x3 (s z)))))))))
(all x1 (-> (& (ex x2 (= (+ (s z) (s x2)) x1)) (all x3 (-> (ex x4 (= (* x4 x3) x1)) (or (= x3 (s z)) (= x3 x1))))) (ex x5 (& (rel 778 x5 x1) (all x6 (-> (rel 777 x6 x5) (& (ex x7 (= (+ (s z) (s x7)) x6)) (all x8 (-> (ex x9 (= (* x9 x8) x6)) (or (= x8 (s z)) (= x8 x6)))))))))))
(gen x1 (lam h2 (& (ex x3 (= (+ (s z) (s x3)) x1)) (all x4 (-> (ex x5 (= (* x5 x4) x1)) (or (= x4 (s z)) (= x4 x1))))) (wit x6 (& (rel 778 x6 x1) (all x7 (-> (rel 777 x7 x6) (& (ex x8 (= (+ (s z) (s x8)) x7)) (all x9 (-> (ex x10 (= (* x10 x9) x7)) (or (= x9 (s z)) (= x9 x7)))))))) (cons x1 nil) (pair (eqelim x11 (rel 778 (cons x1 nil) x11) (inst (use 1) x1) (pcons x1 (pnil))) (gen x12 (lam h13 (rel 777 x12 (cons x1 nil)) (case (memcons h13) (lam h14 (= x12 x1) (eqelim x15 (& (ex x16 (= (+ (s z) (s x16)) x15)) (all x17 (-> (ex x18 (= (* x18 x17) x15)) (or (= x17 (s z)) (= x17 x15))))) (app (inst (inst (use 0) x12) x1) h14) h2)) (lam h19 (rel 777 x12 nil) (absurd (& (ex x20 (= (+ (s z) (s x20)) x12)) (all x21 (-> (ex x22 (= (* x22 x21) x12)) (or (= x21 (s z)) (= x21 x12))))) (memnil h19))))))))))
