; membership distributes over append: x in (L1++L2) -> x in L1 or x in L2
; listind on L1; memcons needs a SYNTACTIC cons, so (cons h t)++l2 is coerced to cons h (t++l2) first.
(all x1 (all x2 (all x3 (-> (rel 777 x2 (++ x1 x3)) (or (rel 777 x2 x1) (rel 777 x2 x3))))))
(listind x1 (all x2 (all x3 (-> (rel 777 x2 (++ x1 x3)) (or (rel 777 x2 x1) (rel 777 x2 x3))))) (gen x4 (gen x5 (lam h6 (rel 777 x4 (++ nil x5)) (inr (rel 777 x4 nil) h6)))) (gen x7 (gen x8 (lam h9 (all x10 (all x11 (-> (rel 777 x10 (++ x8 x11)) (or (rel 777 x10 x8) (rel 777 x10 x11))))) (gen x12 (gen x13 (lam h14 (rel 777 x12 (++ (cons x7 x8) x13)) (case (memcons (eqelim x15 (rel 777 x12 x15) (refl (cons x7 (++ x8 x13))) h14)) (lam h16 (= x12 x7) (inl (rel 777 x12 x13) (eqelim x17 (rel 777 x12 (cons x17 x8)) h16 (memhead x12 x8)))) (lam h18 (rel 777 x12 (++ x8 x13)) (case (app (inst (inst h9 x12) x13) h18) (lam h19 (rel 777 x12 x8) (inl (rel 777 x12 x13) (memtail x7 h19))) (lam h20 (rel 777 x12 x13) (inr (rel 777 x12 (cons x7 x8)) h20))))))))))))
