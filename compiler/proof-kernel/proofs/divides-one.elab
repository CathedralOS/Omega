; 1|a   (one divides everything)   a|b := exists m. m*a=b ;  witness a, via n*1=n
(def 0 (all x (all y (= (* (s x) y) (+ y (* x y)))))
  (gen x (gen y (refl (* (s x) y)))))
(def 1 (all x (all y (all z (-> (= x y) (-> (= y z) (= x z))))))
  (gen x (gen y (gen z (lam h1 (= x y) (lam h2 (= y z) (eqelim hole (= x hole) h2 h1)))))))
(def 2 (all n (= (* n (s 0)) n))
  (natind n (= (* n (s 0)) n)
    (refl 0)
    (gen n2 (lam ih (= (* n2 (s 0)) n2)
      (app* (inst* (use 1) (* (s n2) (s 0)) (+ (s 0) (* n2 (s 0))) (s n2))
            (inst* (use 0) n2 (s 0))
            (eqelim hole (= (+ (s 0) (* n2 (s 0))) (s hole)) ih (refl (+ (s 0) (* n2 (s 0))))))))))
(all a (ex m (= (* m (s 0)) a)))
(gen a (wit m (= (* m (s 0)) a) a (inst (use 2) a)))
