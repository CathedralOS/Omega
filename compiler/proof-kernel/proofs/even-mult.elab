; even(a) -> even(a*b)  (even n := exists k. n=k+k)
(def 0 (all a (all b (all c (= (+ (+ a b) c) (+ a (+ b c))))))       
  (natind a (all b (all c (= (+ (+ a b) c) (+ a (+ b c)))))
    (gen b (gen c (refl (+ b c))))
    (gen a2 (lam ih (all b (all c (= (+ (+ a2 b) c) (+ a2 (+ b c)))))
      (gen b (gen c (eqelim hole (= (+ (+ (s a2) b) c) (s hole)) (inst* ih b c) (refl (+ (+ (s a2) b) c)))))))))
(def 1 (all x (all y (-> (= x y) (= y x))))                           
  (gen x (gen y (lam h (= x y) (eqelim hole (= hole x) h (refl x))))))
(def 2 (all x (all y (all z (-> (= x y) (-> (= y z) (= x z))))))      
  (gen x (gen y (gen z (lam h1 (= x y) (lam h2 (= y z) (eqelim hole (= x hole) h2 h1)))))))
(def 3 (all x (all y (= (+ (s x) y) (s (+ x y)))))                    
  (gen x (gen y (refl (+ (s x) y)))))
(def 4 (all x (all y (= (* (s x) y) (+ y (* x y)))))                  
  (gen x (gen y (refl (* (s x) y)))))
(def 5 (all x (all y (all z (= (* (+ x y) z) (+ (* x z) (* y z)))))) (natind x (all y (all z (= (* (+ x y) z) (+ (* x z) (* y z)))))
  (gen y (gen z (refl (* y z))))
  (gen x2 (lam ih (all y (all z (= (* (+ x2 y) z) (+ (* x2 z) (* y z)))))
    (gen y (gen z
      (app* (inst* (use 2) (* (+ (s x2) y) z) (* (s (+ x2 y)) z) (+ (* (s x2) z) (* y z)))
            (eqelim hole (= (* (+ (s x2) y) z) (* hole z)) (inst* (use 3) x2 y) (refl (* (+ (s x2) y) z)))
            (app* (inst* (use 2) (* (s (+ x2 y)) z) (+ z (* (+ x2 y) z)) (+ (* (s x2) z) (* y z)))
                  (inst* (use 4) (+ x2 y) z)
                  (app* (inst* (use 2) (+ z (* (+ x2 y) z)) (+ z (+ (* x2 z) (* y z))) (+ (* (s x2) z) (* y z)))
                        (eqelim hole (= (+ z (* (+ x2 y) z)) (+ z hole)) (inst* ih y z) (refl (+ z (* (+ x2 y) z))))
                        (app* (inst* (use 2) (+ z (+ (* x2 z) (* y z))) (+ (+ z (* x2 z)) (* y z)) (+ (* (s x2) z) (* y z)))
                              (app (inst* (use 1) (+ (+ z (* x2 z)) (* y z)) (+ z (+ (* x2 z) (* y z)))) (inst* (use 0) z (* x2 z) (* y z)))
                              (eqelim hole (= (+ (+ z (* x2 z)) (* y z)) (+ hole (* y z)))
                                 (app (inst* (use 1) (* (s x2) z) (+ z (* x2 z))) (inst* (use 4) x2 z))
                                 (refl (+ (+ z (* x2 z)) (* y z))))))))))))
))
(all a (all b (-> (ex k (= a (+ k k))) (ex k (= (* a b) (+ k k))))))
(gen a (gen b (lam h (ex k (= a (+ k k)))
  (unpack h (gen k (lam p (= a (+ k k))
    (wit k2 (= (* a b) (+ k2 k2)) (* k b)
      (app* (inst* (use 2) (* a b) (* (+ k k) b) (+ (* k b) (* k b)))
            (eqelim hole (= (* a b) (* hole b)) p (refl (* a b)))
            (inst* (use 5) k k b)))))))))
