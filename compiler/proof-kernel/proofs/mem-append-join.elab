; the other half of membership-vs-append: (x in L1 or x in L2) -> x in (L1++L2)
; two inject lemmas by listind on L1 (left uses memnil->absurd at nil; both lift via memtail + cons->append coercion), combined by case.
; together with mem-append-split this is the full iff: x in L1++L2 <-> x in L1 or x in L2.
(def 0 (all x1 (all x2 (all x3 (-> (rel 777 x2 x1) (rel 777 x2 (++ x1 x3)))))) (listind x4 (all x5 (all x6 (-> (rel 777 x5 x4) (rel 777 x5 (++ x4 x6))))) (gen x7 (gen x8 (lam h9 (rel 777 x7 nil) (absurd (rel 777 x7 (++ nil x8)) (memnil h9))))) (gen x10 (gen x11 (lam h12 (all x13 (all x14 (-> (rel 777 x13 x11) (rel 777 x13 (++ x11 x14))))) (gen x15 (gen x16 (lam h17 (rel 777 x15 (cons x10 x11)) (case (memcons h17) (lam h18 (= x15 x10) (eqelim x19 (rel 777 x15 x19) (refl (++ (cons x10 x11) x16)) (eqelim x20 (rel 777 x15 (cons x20 (++ x11 x16))) h18 (memhead x15 (++ x11 x16))))) (lam h21 (rel 777 x15 x11) (eqelim x22 (rel 777 x15 x22) (refl (++ (cons x10 x11) x16)) (memtail x10 (app (inst (inst h12 x15) x16) h21)))))))))))))
(def 1 (all x1 (all x2 (all x3 (-> (rel 777 x2 x3) (rel 777 x2 (++ x1 x3)))))) (listind x4 (all x5 (all x6 (-> (rel 777 x5 x6) (rel 777 x5 (++ x4 x6))))) (gen x7 (gen x8 (lam h9 (rel 777 x7 x8) h9))) (gen x10 (gen x11 (lam h12 (all x13 (all x14 (-> (rel 777 x13 x14) (rel 777 x13 (++ x11 x14))))) (gen x15 (gen x16 (lam h17 (rel 777 x15 x16) (eqelim x18 (rel 777 x15 x18) (refl (++ (cons x10 x11) x16)) (memtail x10 (app (inst (inst h12 x15) x16) h17)))))))))))
(all x1 (all x2 (all x3 (-> (or (rel 777 x2 x1) (rel 777 x2 x3)) (rel 777 x2 (++ x1 x3))))))
(gen x1 (gen x2 (gen x3 (lam h4 (or (rel 777 x2 x1) (rel 777 x2 x3)) (case h4 (lam h5 (rel 777 x2 x1) (app (inst (inst (inst (use 0) x1) x2) x3) h5)) (lam h6 (rel 777 x2 x3) (app (inst (inst (inst (use 1) x1) x2) x3) h6)))))))
