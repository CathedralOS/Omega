; append is empty only if both halves are: L++M = nil -> (L = nil & M = nil)
; induction on L; nil case via (f8 nil m = m) conv; cons case is impossible -- map both sides of (cons = nil) through len (cons->s_, nil->z) so disj (Nat s vs z) fires.
(data 2 0 0 0)
(data 3 2 0 1)
(fun 8 2 (y 0))
(fun 8 3 (k 3 (v 0) (rec 1)))
(fun 10 2 z)
(fun 10 3 (s (rec 1)))
(all x1 (all x2 (-> (= (f 8 x2 x1) (k 2)) (& (= x2 (k 2)) (= x1 (k 2))))))
(gen x1 (rec 2 3 x2 (-> (= (f 8 x2 x1) (k 2)) (& (= x2 (k 2)) (= x1 (k 2)))) (lam h3 (= (f 8 (k 2) x1) (k 2)) (pair (refl (k 2)) h3)) (gen x4 (gen x5 (lam h6 (-> (= (f 8 x5 x1) (k 2)) (& (= x5 (k 2)) (= x1 (k 2)))) (lam h7 (= (f 8 (k 3 x4 x5) x1) (k 2)) (absurd (& (= (k 3 x4 x5) (k 2)) (= x1 (k 2))) (disj (eqelim x8 (= (f 10 (f 8 (k 3 x4 x5) x1)) (f 10 x8)) h7 (refl (f 10 (f 8 (k 3 x4 x5) x1))))))))))))
