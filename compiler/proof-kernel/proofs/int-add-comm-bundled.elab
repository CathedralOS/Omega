; int-add-comm-bundled: ZZ addition commutes (up to ~) for BUNDLED integers — the first ℤ theorem over
; PACKED difference-pairs (k 70 a b), bridged to the component-based ZZ library by the PRODUCT ELIMINATOR.
;
; The existing int-add-comm states commutativity over UNBUNDLED components (four separate nat args x1..x4),
; which suffices for scalars but NOT for a list element, which must be ONE value — a bundled pair (k 70 a b).
; This lemma lifts it: for integers given only as ABSTRACT variables p, q, prodrec splits each into its sole
; constructor (k 70 a b) / (k 70 c d), where intAdd (fun 95) and fst/snd (fun 100/101) fire, reducing the goal
; to int-add-comm's component form (use 8), closed by the reused proof. This nested prodrec (p then q) bridging
; abstract packed integers to the component ring is EXACTLY the move the ℤ signed-sum FOLD's Cons step needs to
; split each abstract list element. intEq((A,B),(C,D)) := A+D = C+B; here A,B = intAdd(p,q), C,D = intAdd(q,p).
(data 70 2 0 0)
(fun 100 70 (v 0)) (fun 101 70 (v 1))          ; fst(k70 a b)=a ; snd(k70 a b)=b
(fun 95 70 (k 70 (+ (v 0) (f 100 (y 0))) (+ (v 1) (f 101 (y 0)))))  ; intAdd(p,q)=(fst p+fst q, snd p+snd q)
(prod 70)
(def 0 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 1 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 2 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 3 (all x1 (= (+ x1 z) x1)) (natind x2 (= (+ x2 z) x2) (refl z) (gen x3 (lam h4 (= (+ x3 z) x3) (eqelim x5 (= (s (+ x3 z)) (s x5)) h4 (refl (s (+ x3 z))))))))
(def 4 (all x1 (all x2 (= (+ x2 (s x1)) (s (+ x2 x1))))) (gen x3 (natind x4 (= (+ x4 (s x3)) (s (+ x4 x3))) (refl (s x3)) (gen x5 (lam h6 (= (+ x5 (s x3)) (s (+ x5 x3))) (eqelim x7 (= (s (+ x5 (s x3))) (s x7)) h6 (refl (s (+ x5 (s x3))))))))))
(def 5 (all x1 (all x2 (-> (= x1 x2) (= x2 x1)))) (gen x3 (gen x4 (lam h5 (= x3 x4) (eqelim x6 (= x6 x3) h5 (refl x3))))))
(def 6 (all x1 (all x2 (all x3 (-> (= x1 x2) (-> (= x2 x3) (= x1 x3)))))) (gen x4 (gen x5 (gen x6 (lam h7 (= x4 x5) (lam h8 (= x5 x6) (eqelim x9 (= x4 x9) h8 h7)))))))
(def 7 (all x1 (all x2 (= (+ x2 x1) (+ x1 x2)))) (gen x3 (natind x4 (= (+ x4 x3) (+ x3 x4)) (eqelim x5 (= x5 (+ x3 z)) (inst (use 3) x3) (refl (+ x3 z))) (gen x6 (lam h7 (= (+ x6 x3) (+ x3 x6)) (app (app (inst (inst (inst (use 6) (s (+ x6 x3))) (s (+ x3 x6))) (+ x3 (s x6))) (eqelim x8 (= (s (+ x6 x3)) (s x8)) h7 (refl (s (+ x6 x3))))) (app (inst (inst (use 5) (+ x3 (s x6))) (s (+ x3 x6))) (inst (inst (use 4) x6) x3))))))))
(def 8 (all x1 (all x2 (all x3 (all x4 (= (+ (+ x1 x3) (+ x4 x2)) (+ (+ x3 x1) (+ x2 x4))))))) (gen x1 (gen x2 (gen x3 (gen x4 (app (app (inst (inst (inst (use 1) (+ (+ x1 x3) (+ x4 x2))) (+ (+ x3 x1) (+ x4 x2))) (+ (+ x3 x1) (+ x2 x4))) (eqelim x5 (= (+ (+ x1 x3) (+ x4 x2)) (+ x5 (+ x4 x2))) (inst (inst (use 7) x3) x1) (refl (+ (+ x1 x3) (+ x4 x2))))) (eqelim x6 (= (+ (+ x3 x1) (+ x4 x2)) (+ (+ x3 x1) x6)) (inst (inst (use 7) x2) x4) (refl (+ (+ x3 x1) (+ x4 x2))))))))))

(all p (all q (= (+ (f 100 (f 95 p q)) (f 101 (f 95 q p))) (+ (f 100 (f 95 q p)) (f 101 (f 95 p q))))))
(prodrec 70 p (all q (= (+ (f 100 (f 95 p q)) (f 101 (f 95 q p))) (+ (f 100 (f 95 q p)) (f 101 (f 95 p q)))))
  (gen a (gen b
    (prodrec 70 q (= (+ (f 100 (f 95 (k 70 a b) q)) (f 101 (f 95 q (k 70 a b)))) (+ (f 100 (f 95 q (k 70 a b))) (f 101 (f 95 (k 70 a b) q))))
      (gen c (gen d
        (inst* (use 8) a b c d)))))))

