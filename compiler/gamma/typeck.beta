; typeck.beta — a static TYPE CHECKER for Gamma, written in Beta.  (phase 1)
;
; gamma.md asks for "a simple static type system — just enough to make the delta
; checker safe to write, no more". This is the companion to interp.beta: where the
; interpreter says what a program MEANS, this says whether it is well-TYPED, before
; it runs. Monomorphic and fully annotated, so there is no inference — type
; checking is synthesis + a name/id comparison, small and auditable.
;
; Phase 1 covers the core: the builtin type Int, and top-level functions with typed
; parameters and a declared return type. It checks each function body against its
; signature: arithmetic and comparisons are Int x Int -> Int, `if` wants an Int
; condition and equal branch types, `let` binds the synthesised type, and a call
; checks argument types + arity against the callee's signature. Phase 2 adds data
; declarations (ADTs) + `match`, where the interesting type errors live (e.g. an Int
; where a List is wanted).
;
; Surface (prefix; Int is builtin, every binder is annotated):
;   program := (def NAME ((PARAM TYPE)...) RETTYPE EXPR)*
;   EXPR    := INT | VAR | (if E E E) | (let NAME E E)
;            | (+ E E) | (- E E) | (* E E) | (/ E E) | (% E E) | (eq E E) | (lt E E)
;            | (NAME E...)
; Output: every function well-typed -> exit 1 ; a type error -> exit 0.
;   (def add ((a Int) (b Int)) Int (+ a b)) (def main () Int (add 2 3))   -> 1
;
; Memory:  2097152 SRC  2097144 CUR  2097136 LEN  2097128 APTR  2097120 NFUN
;          2097112 TENVN   3145728 ARENA   4194304 FUNS   5242880 TENV
; A "type" is a small id: Int = 0 (more in phase 2). AST nodes 4 words
; [tag,f0,f1,f2]. Func entry 4 words [name_off, params, ret_tyid, body]. A param is
; a node [50, name_off, tyid]. TENV entry 2 words [var_off, tyid].
;
; AST tags: 0 INT 1 VAR(off) 2 PRIM(op,a,b) 3 IF(c,t,e) 4 LET(off,e,body)
;           5 CALL(foff,args) 6 CONS(head,tail) 50 PARAM(name_off,tyid)

proc slurp() {
    let n = 0
    let c = read_byte()
    while c >= 0 {
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
    }
    word[2097136] = n
    word[2097144] = 0
    word[2097128] = 3145728
    word[2097120] = 0        ; NFUN
    word[2097112] = 0        ; TENVN
}

proc cbyte() {
    let i = word[2097144]
    if i < word[2097136] {
        return byte[2097152 + i]
    }
    return 0
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

proc is_space(c) {
    if c == ' ' {
        return 1
    }
    if c == 9 {
        return 1
    }
    if c == 10 {
        return 1
    }
    if c == 13 {
        return 1
    }
    return 0
}

proc skip_ws() {
    let go = 1
    while go == 1 {
        let c = cbyte()
        if is_space(c) == 1 {
            adv()
        } else {
            if c == ';' {
                while cbyte() != 10 {
                    if cbyte() == 0 {
                        return 0
                    }
                    adv()
                }
            } else {
                go = 0
            }
        }
    }
    return 0
}

proc is_digit(c) {
    if c < '0' {
        return 0
    }
    if c > '9' {
        return 0
    }
    return 1
}

proc is_delim(c) {
    if is_space(c) == 1 {
        return 1
    }
    if c == '(' {
        return 1
    }
    if c == ')' {
        return 1
    }
    if c == 0 {
        return 1
    }
    return 0
}

proc is_op(c) {
    if c == '+' {
        return 1
    }
    if c == '-' {
        return 1
    }
    if c == '*' {
        return 1
    }
    if c == '/' {
        return 1
    }
    if c == '%' {
        return 1
    }
    return 0
}

proc skip_ident() {
    while is_delim(cbyte()) == 0 {
        adv()
    }
}

proc parse_number() {
    let v = 0
    while is_digit(cbyte()) == 1 {
        v = v * 10 + (cbyte() - '0')
        adv()
    }
    return v
}

proc alloc(tag, f0, f1, f2) {
    let p = word[2097128]
    word[p] = tag
    word[p + 8] = f0
    word[p + 16] = f1
    word[p + 24] = f2
    word[2097128] = p + 32
    return p
}

proc name_eq(o1, o2) {
    let i = 0
    let go = 1
    let result = 0
    while go == 1 {
        let c1 = byte[2097152 + o1 + i]
        let c2 = byte[2097152 + o2 + i]
        if is_delim(c1) == 1 {
            result = is_delim(c2)
            go = 0
        } else {
            if is_delim(c2) == 1 {
                go = 0
            } else {
                if c1 != c2 {
                    go = 0
                } else {
                    i = i + 1
                }
            }
        }
    }
    return result
}

proc name_is2(off, a, b) {
    if byte[2097152 + off] == a {
        if byte[2097152 + off + 1] == b {
            if is_delim(byte[2097152 + off + 2]) == 1 {
                return 1
            }
        }
    }
    return 0
}

proc name_is3(off, a, b, c) {
    if byte[2097152 + off] == a {
        if byte[2097152 + off + 1] == b {
            if byte[2097152 + off + 2] == c {
                if is_delim(byte[2097152 + off + 3]) == 1 {
                    return 1
                }
            }
        }
    }
    return 0
}

; resolve a type name to a type id. Phase 1: only Int (id 0); anything else -> -1.
proc tyid(off) {
    if name_is3(off, 'I', 'n', 't') == 1 {
        return 0
    }
    return 0 - 1
}

; ---- parser (core expressions) ----

proc parse_args() {
    skip_ws()
    if cbyte() == ')' {
        return 0
    }
    let h = parse_expr()
    let t = parse_args()
    return alloc(6, h, t, 0)
}

proc parse_expr() {
    skip_ws()
    let c = cbyte()
    if is_digit(c) == 1 {
        return alloc(0, parse_number(), 0, 0)
    }
    if c == '(' {
        adv()
        skip_ws()
        let h = cbyte()
        if is_op(h) == 1 {
            adv()
            let a = parse_expr()
            let b = parse_expr()
            skip_ws()
            adv()
            return alloc(2, h, a, b)
        }
        let hoff = word[2097144]
        skip_ident()
        if name_is2(hoff, 'i', 'f') == 1 {
            let c1 = parse_expr()
            let t1 = parse_expr()
            let e1 = parse_expr()
            skip_ws()
            adv()
            return alloc(3, c1, t1, e1)
        }
        if name_is3(hoff, 'l', 'e', 't') == 1 {
            skip_ws()
            let noff = word[2097144]
            skip_ident()
            let e2 = parse_expr()
            let body = parse_expr()
            skip_ws()
            adv()
            return alloc(4, noff, e2, body)
        }
        if name_is2(hoff, 'e', 'q') == 1 {
            let a2 = parse_expr()
            let b2 = parse_expr()
            skip_ws()
            adv()
            return alloc(2, 'e', a2, b2)
        }
        if name_is2(hoff, 'l', 't') == 1 {
            let a3 = parse_expr()
            let b3 = parse_expr()
            skip_ws()
            adv()
            return alloc(2, 'l', a3, b3)
        }
        let args = parse_args()
        skip_ws()
        adv()
        return alloc(5, hoff, args, 0)
    }
    let voff = word[2097144]
    skip_ident()
    return alloc(1, voff, 0, 0)
}

proc parse_typed_params() {       ; (pname Ty) pairs until ')', CONS of PARAM nodes
    skip_ws()
    if cbyte() == ')' {
        return 0
    }
    adv()                         ; '('
    skip_ws()
    let poff = word[2097144]
    skip_ident()
    skip_ws()
    let toff = word[2097144]
    skip_ident()
    skip_ws()
    adv()                         ; ')'
    let node = alloc(50, poff, tyid(toff), 0)
    let t = parse_typed_params()
    return alloc(6, node, t, 0)
}

proc parse_def() {
    adv()                         ; '('
    skip_ws()
    skip_ident()                  ; "def"
    skip_ws()
    let noff = word[2097144]
    skip_ident()
    skip_ws()
    adv()                         ; '(' param list
    let params = parse_typed_params()
    skip_ws()
    adv()                         ; ')' end params
    skip_ws()
    let rtoff = word[2097144]
    skip_ident()
    let rtid = tyid(rtoff)
    let body = parse_expr()
    skip_ws()
    adv()                         ; ')' end def
    let i = word[2097120]
    word[4194304 + i * 32] = noff
    word[4194304 + i * 32 + 8] = params
    word[4194304 + i * 32 + 16] = rtid
    word[4194304 + i * 32 + 24] = body
    word[2097120] = i + 1
    return 0
}

proc is_def() {
    if cbyte() != '(' {
        return 0
    }
    let save = word[2097144]
    adv()
    skip_ws()
    let r = name_is3(word[2097144], 'd', 'e', 'f')
    word[2097144] = save
    return r
}

proc fun_lookup(noff) {
    let n = word[2097120]
    let i = 0
    while i < n {
        if name_eq(noff, word[4194304 + i * 32]) == 1 {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

; ---- type environment (var -> tyid), frame-local lookup ----

proc tenv_push(off, t) {
    let n = word[2097112]
    word[5242880 + n * 16] = off
    word[5242880 + n * 16 + 8] = t
    word[2097112] = n + 1
}

proc tenv_lookup(qoff) {
    let j = word[2097112] - 1
    let go = 1
    let result = 0 - 1
    while go == 1 {
        if j < 0 {
            go = 0
        } else {
            if name_eq(qoff, word[5242880 + j * 16]) == 1 {
                result = word[5242880 + j * 16 + 8]
                go = 0
            }
            j = j - 1
        }
    }
    return result
}

; ---- the type checker: tc(expr) -> tyid, or -1 on a type error ----

proc tc_call(fname, args) {
    let fi = fun_lookup(fname)
    if fi == 0 - 1 {
        return 0 - 1                          ; unknown function
    }
    let p = word[4194304 + fi * 32 + 8]       ; params (CONS of PARAM nodes)
    let a = args
    let fail = 0
    let go = 1
    while go == 1 {
        if p == 0 {
            go = 0
        } else {
            if a == 0 {
                go = 0
            } else {
                let pty = word[word[p + 8] + 16]   ; the param's declared tyid
                if tc(word[a + 8]) != pty {
                    fail = 1
                }
                p = word[p + 16]
                a = word[a + 16]
            }
        }
    }
    if p != 0 {
        fail = 1                              ; too few arguments
    }
    if a != 0 {
        fail = 1                              ; too many arguments
    }
    if fail == 1 {
        return 0 - 1
    }
    return word[4194304 + fi * 32 + 16]       ; the return tyid
}

proc tc(expr) {
    let tag = word[expr]
    if tag == 0 {
        return 0                              ; INT : Int
    }
    if tag == 1 {
        return tenv_lookup(word[expr + 8])    ; VAR
    }
    if tag == 2 {                             ; PRIM : Int x Int -> Int
        let a = tc(word[expr + 16])
        let b = tc(word[expr + 24])
        if a == 0 {
            if b == 0 {
                return 0
            }
        }
        return 0 - 1
    }
    if tag == 3 {                             ; IF : cond Int, branches equal
        let c = tc(word[expr + 8])
        let t = tc(word[expr + 16])
        let e = tc(word[expr + 24])
        if c == 0 {
            if t == e {
                return t
            }
        }
        return 0 - 1
    }
    if tag == 4 {                             ; LET : bind the synthesised type
        let vt = tc(word[expr + 16])
        if vt == 0 - 1 {
            return 0 - 1
        }
        tenv_push(word[expr + 8], vt)
        let r = tc(word[expr + 24])
        word[2097112] = word[2097112] - 1
        return r
    }
    if tag == 5 {                             ; CALL
        return tc_call(word[expr + 8], word[expr + 16])
    }
    return 0 - 1
}

proc main() {
    slurp()
    skip_ws()
    while is_def() == 1 {
        parse_def()
        skip_ws()
    }
    ; check every function body against its declared return type
    let ok = 1
    let i = 0
    while i < word[2097120] {
        let base = word[2097112]
        let p = word[4194304 + i * 32 + 8]    ; params
        while p != 0 {
            tenv_push(word[word[p + 8] + 8], word[word[p + 8] + 16])
            p = word[p + 16]
        }
        if tc(word[4194304 + i * 32 + 24]) != word[4194304 + i * 32 + 16] {
            ok = 0
        }
        word[2097112] = base
        i = i + 1
    }
    return ok
}
