; Focused executable contract for the shared typed byte decoder.

(def rint_exact_empty ((result RInt) (want Int)) Int
  (match result
    (RIntBad 0)
    ((RInt got rest)
      (if (eq got want) (match rest (BNil 1) ((B h t) 0)) 0))))

(def rint_exact_one ((result RInt) (want Int) (tail Int)) Int
  (match result
    (RIntBad 0)
    ((RInt got rest)
      (if (eq got want)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def rint_bad ((result RInt)) Int
  (match result (RIntBad 1) ((RInt got rest) 0)))

(def rbytes_exact_one ((result RBytes) (tail Int)) Int
  (match result
    (RBytesBad 0)
    ((RBytes rest)
      (match rest
        (BNil 0)
        ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0))))))

(def rbytes_bad ((result RBytes)) Int
  (match result (RBytesBad 1) ((RBytes rest) 0)))

(def canonical_bytes_self_test () Int
  (if (rint_exact_empty (read_u8 (B 255 BNil)) 255)
    (if (rint_bad (read_u8 (B 256 BNil)))
      (if (rint_bad (read_u8 (B (- 0 1) BNil)))
        (if (rint_exact_one (read_u16 (B 52 (B 18 (B 9 BNil)))) 4660 9)
          (if (rint_exact_empty (read_u32 (B 120 (B 86 (B 52 (B 18 BNil))))) 305419896)
            (if (rint_bad (read_u32 (B 1 (B 2 (B 3 BNil)))))
              (if (rbytes_exact_one (expect_byte (B 80 (B 9 BNil)) 80) 9)
                (if (rbytes_bad (expect_byte (B 81 BNil) 80))
                  (if (rbytes_exact_one (consume_zeroes (B 0 (B 0 (B 7 BNil))) 2) 7)
                    (rbytes_bad (consume_zeroes (B 0 (B 1 BNil)) 2))
                    0)
                  0)
                0)
              0)
            0)
          0)
        0)
      0)
    0))
