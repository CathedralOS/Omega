; Shared typed byte-cursor vocabulary for low-rung canonical decoders.
;
; Bytes may be constructed from arbitrary Gamma Int values, so read_u8 still
; validates every element before exposing it as one canonical byte.

(data Bytes (BNil) (B Int Bytes))
(data RInt (RInt Int Bytes) (RIntBad))
(data RBytes (RBytes Bytes) (RBytesBad))
