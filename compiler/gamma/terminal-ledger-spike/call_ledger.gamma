; Q7 canonical-byte Unit/boundary composition evaluation.
;
; The decoder retains exact current artifact custody.  This evaluator validates
; the bounded module shape, then feeds the decoded Unit and boundary sites into
; the same three-row composition table used by scalar calls.  It publishes no
; primitive denotation row and performs no algebraic reduction.

(def cc_ints_equal ((left Ints) (right Ints)) Int
  (match left
    (INil (match right (INil 1) (z 0)))
    ((ICons h t)
      (match right
        (INil 0)
        ((ICons q r) (if (eq h q) (cc_ints_equal t r) 0))))))

(def cc_resource_identity () Ints
  (ICons 83 (ICons 112 (ICons 105 (ICons 107 (ICons 101
    (ICons 58 (ICons 58 (ICons 82 (ICons 101 (ICons 115
      (ICons 111 (ICons 117 (ICons 114 (ICons 99 (ICons 101 INil))))))))))))))))

(def cc_pending_identity () Ints
  (ICons 83 (ICons 112 (ICons 105 (ICons 107 (ICons 101
    (ICons 58 (ICons 58 (ICons 82 (ICons 101 (ICons 115
      (ICons 111 (ICons 117 (ICons 114 (ICons 99 (ICons 101
        (ICons 58 (ICons 58 (ICons 80 (ICons 101 (ICons 110
          (ICons 100 (ICons 105 (ICons 110 (ICons 103 INil)))))))))))))))))))))))))

(def cc_settle_identity () Ints
  (ICons 83 (ICons 112 (ICons 105 (ICons 107 (ICons 101
    (ICons 58 (ICons 58 (ICons 82 (ICons 101 (ICons 115
      (ICons 111 (ICons 117 (ICons 114 (ICons 99 (ICons 101
        (ICons 58 (ICons 58 (ICons 115 (ICons 101 (ICons 116
          (ICons 116 (ICons 108 (ICons 101 INil))))))))))))))))))))))))

(def cc_empty_decls ((values Decls)) Int (match values (DNil 1) (z 0)))
(def cc_empty_ints ((values Ints)) Int (match values (INil 1) (z 0)))
(def cc_empty_fields ((values SEFields)) Int (match values (SEFNil 1) (z 0)))
(def cc_empty_services ((values SEServices)) Int (match values (SESNil 1) (z 0)))
(def cc_empty_arguments ((values CCArguments)) Int (match values (CCANil 1) (z 0)))
(def cc_empty_transfers ((values CCTransfers)) Int (match values (CCTNil 1) (z 0)))
(def cc_empty_ops ((values CCOps)) Int (match values (CCONil 1) (z 0)))
(def cc_empty_blocks ((values CCBlocks)) Int (match values (CCBLNil 1) (z 0)))

(def cc_exact_type_shape ((types SETypes)) Int
  (match types
    ((SETCons structural_type rest)
      (match rest
        (SETNil
          (match structural_type
            ((SEType id identity fields)
              (if (eq id 10)
                (if (cc_ints_equal identity (cc_resource_identity))
                  (cc_empty_fields fields) 0)
                0))))
        (z 0)))
    (z 0)))

(def cc_exact_domain_shape ((domains CCDomains)) Int
  (match domains
    ((CCDCons domain rest)
      (match rest
        (CCDNil
          (match domain
            ((CCDomain id identity carrier)
              (if (if (eq id 10) (eq carrier 10) 0)
                (cc_ints_equal identity (cc_pending_identity)) 0))))
        (z 0)))
    (z 0)))

(def cc_exact_qualifications ((values Ints)) Int
  (match values
    ((ICons domain rest) (if (eq domain 10) (cc_empty_ints rest) 0))
    (z 0)))

(def cc_exact_parameter
  ((parameter SEParameter) (place Int) (is_self Int)) Int
  (match parameter
    ((SEParameter actual position actual_self structural_type multiplicity qualifications)
      (if (if (eq actual place) (eq position 0) 0)
        (if (if (eq actual_self is_self) (eq structural_type 10) 0)
          (if (eq multiplicity 3) (cc_exact_qualifications qualifications) 0)
          0)
        0))))

(def cc_exact_parameters
  ((parameters SEParameters) (place Int) (is_self Int)) Int
  (match parameters
    ((SEPCons parameter rest)
      (if (cc_exact_parameter parameter place is_self)
        (match rest (SEPNil 1) (z 0)) 0))
    (z 0)))

(def cc_exact_boundary_shape ((boundaries CCBoundaries)) Int
  (match boundaries
    ((CCBCons boundary rest)
      (match rest
        (CCBNil
          (match boundary
            ((CCBoundary id identity attachment parameters result requirements services)
              (if (if (eq id 10) (eq attachment 10) 0)
                (if (cc_ints_equal identity (cc_settle_identity))
                  (if (cc_exact_parameters parameters 30 1)
                    (match result
                      (CCBoundaryUnit
                        (match requirements
                          ((CCRCons requirement tail)
                            (match tail
                              (CCRNil
                                (match requirement
                                  ((CCRequirement argument domain)
                                    (if (if (eq argument 0) (eq domain 10) 0)
                                      (cc_empty_ints services) 0))))
                              (z 0)))
                          (z 0)))
                      (z 0))
                    0)
                  0)
                0))))
        (z 0)))
    (z 0)))

(def cc_exact_place ((places SEPlaces) (place Int)) Int
  (match places
    ((SEPlCons declaration rest)
      (match rest
        (SEPlNil
          (match declaration
            ((SEPlace actual kind)
              (if (eq actual place)
                (match kind
                  ((SEParameterPlace position is_self)
                    (if (eq position 0) (eq is_self 0) 0))
                  (z 0))
                0))))
        (z 0)))
    (z 0)))

(def cc_exact_claim ((claims CCEntryClaims) (place Int)) Int
  (match claims
    ((CCECons claim rest)
      (match rest
        (CCENil
          (match claim
            ((CCEntryClaim id input) (if (eq id 1) (eq input place) 0))))
        (z 0)))
    (z 0)))

(def cc_exact_argument ((arguments CCArguments) (place Int)) Int
  (match arguments
    ((CCACons argument rest)
      (match rest
        (CCANil (match argument ((CCArgument actual) (eq actual place))))
        (z 0)))
    (z 0)))

(def cc_exact_transfer ((transfers CCTransfers)) Int
  (match transfers
    ((CCTCons transfer rest)
      (match rest
        (CCTNil
          (match transfer
            ((CCTransfer claim argument)
              (if (eq claim 1) (eq argument 0) 0))))
        (z 0)))
    (z 0)))

(def cc_contract_empty ((contract Contract) (id Int)) Int
  (match contract
    ((Contract actual requires)
      (if (eq actual id) (match requires (PNil 1) (z 0)) 0))))

(def cc_return_unit_shape ((terminator SETerminator) (edge Int)) Int
  (match terminator
    ((SEReturnUnit actual discards)
      (if (eq actual edge) (cc_empty_ints discards) 0))
    (z 0)))

(def cc_unit_operation_shape ((operations CCOps)) Int
  (match operations
    ((CCOCons operation rest)
      (match rest
        (CCONil
          (match operation
            ((CCOp id result kind)
              (if (eq id 10)
                (match result
                  (SEUnitResult
                    (match kind
                      ((CCCallUnit target arguments transfers obligations)
                        (if (eq target 20)
                          (if (cc_exact_argument arguments 10)
                            (if (cc_exact_transfer transfers)
                              (cc_empty_ints obligations) 0)
                            0)
                          0))
                      (z 0)))
                  (z 0))
                0))))
        (z 0)))
    (z 0)))

(def cc_boundary_operation_shape ((operations CCOps)) Int
  (match operations
    ((CCOCons operation rest)
      (match rest
        (CCONil
          (match operation
            ((CCOp id result kind)
              (if (eq id 20)
                (match result
                  (SEUnitResult
                    (match kind
                      ((CCBoundaryCall target arguments receipts obligations)
                        (if (eq target 10)
                          (if (cc_exact_argument arguments 20)
                            (if (cc_exact_transfer receipts)
                              (cc_empty_ints obligations) 0)
                            0)
                          0))
                      (z 0)))
                  (z 0))
                0))))
        (z 0)))
    (z 0)))

(def cc_block_shape ((blocks CCBlocks) (id Int) (unit_call Int)) Int
  (match blocks
    ((CCBLCons block rest)
      (match rest
        (CCBLNil
          (match block
            ((CCBlock actual parameters operations terminator)
              (if (if (eq actual id) (cc_empty_decls parameters) 0)
                (if (if unit_call (cc_unit_operation_shape operations)
                      (cc_boundary_operation_shape operations))
                  (cc_return_unit_shape terminator id) 0)
                0))))
        (z 0)))
    (z 0)))

(def cc_machine_shape ((machine CCMachine) (id Int) (place Int) (unit_call Int)) Int
  (match machine
    ((CCMachine actual attachment parameters structural_parameters result places claims
       services entry blocks contract)
      (if (if (eq actual id) (eq attachment 0) 0)
        (if (cc_empty_decls parameters)
          (if (cc_exact_parameters structural_parameters place 0)
            (match result
              (SEUnitResult
                (if (cc_exact_place places place)
                  (if (cc_exact_claim claims place)
                    (if (cc_empty_ints services)
                      (if (eq entry id)
                        (if (cc_block_shape blocks id unit_call)
                          (cc_contract_empty contract id) 0)
                        0)
                      0)
                    0)
                  0))
              (z 0))
            0)
          0)
        0))))

(def cc_exact_machines_shape ((machines CCMachines)) Int
  (match machines
    ((CCMCons caller rest)
      (match rest
        ((CCMCons callee tail)
          (match tail
            (CCMNil
              (if (cc_machine_shape caller 10 10 1)
                (cc_machine_shape callee 20 20 0) 0))
            (z 0)))
        (z 0)))
    (z 0)))

(def cc_exact_module_shape ((module CCModule)) Int
  (match module
    ((CCModule vocabulary entry types domains services boundaries machines)
      (if (if (eq vocabulary 20) (eq entry 10) 0)
        (if (cc_exact_type_shape types)
          (if (cc_exact_domain_shape domains)
            (if (cc_empty_services services)
              (if (cc_exact_boundary_shape boundaries)
                (cc_exact_machines_shape machines) 0)
              0)
            0)
          0)
        0))))

(def build_call_composition_module
  ((schemas CallSchemas) (module CCModule)) Int
  (if (cc_exact_module_shape module)
    (if (call_composition_valid schemas (valid_unit_call_input))
      (call_composition_valid schemas (valid_boundary_call_input)) 0)
    0))

(def run_call_composition_with_schemas ((schemas CallSchemas) (bytes Bytes)) Int
  (match (decode_call_composition_module bytes)
    (RCCModuleBad 0)
    ((RCCModule module) (build_call_composition_module schemas module))))

(def run_call_composition_spike ((bytes Bytes)) Int
  (run_call_composition_with_schemas (canonical_call_schemas) bytes))

(def call_composition_byte_schema_mutation_self_test ((bytes Bytes)) Int
  (if (run_call_composition_with_schemas (canonical_call_schemas) bytes)
    (if (eq (run_call_composition_with_schemas (calls_without_unit) bytes) 0)
      (if (eq (run_call_composition_with_schemas
                (calls_with_duplicate_boundary) bytes) 0)
        (if (eq (run_call_composition_with_schemas
                  (calls_with_weakened_unit_requirements) bytes) 0)
          (eq (run_call_composition_with_schemas
                (calls_with_weakened_boundary_frontier) bytes) 0)
          0)
        0)
      0)
    0))
