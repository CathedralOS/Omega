; Q7 canonical-byte decoder for the bounded Unit/boundary composition fixture.
;
; The shared structural decoder owns record, parameter, place, result, and
; service syntax.  This module owns the additional domain, boundary, claim,
; structural-argument, transfer/receipt, and call-operation vocabulary.  It
; accepts exact current PSITERM v18 bytes and no target/ABI representation.

(def read_cc_domain ((bs Bytes)) RCCDomain
  (match (read_id bs)
    (RIntBad RCCDomainBad)
    ((RInt id r1)
      (match (read_spike_identity r1)
        (RIntsBad RCCDomainBad)
        ((RInts identity r2)
          (match (read_id r2)
            (RIntBad RCCDomainBad)
            ((RInt carrier rest)
              (RCCDomain (CCDomain id identity carrier) rest))))))))

(def read_cc_domains_n ((bs Bytes) (n Int)) RCCDomains
  (if (eq n 0) (RCCDomains CCDNil bs)
    (match (read_cc_domain bs)
      (RCCDomainBad RCCDomainsBad)
      ((RCCDomain domain rest)
        (match (read_cc_domains_n rest (- n 1))
          (RCCDomainsBad RCCDomainsBad)
          ((RCCDomains domains end)
            (RCCDomains (CCDCons domain domains) end)))))))

(def read_cc_domains ((bs Bytes)) RCCDomains
  (match (read_u32 bs)
    (RIntBad RCCDomainsBad)
    ((RInt count rest) (read_cc_domains_n rest count))))

(def read_cc_requirement ((bs Bytes)) RCCRequirement
  (match (read_u32 bs)
    (RIntBad RCCRequirementBad)
    ((RInt argument r1)
      (match (read_id r1)
        (RIntBad RCCRequirementBad)
        ((RInt domain rest)
          (RCCRequirement (CCRequirement argument domain) rest))))))

(def read_cc_requirements_n ((bs Bytes) (n Int)) RCCRequirements
  (if (eq n 0) (RCCRequirements CCRNil bs)
    (match (read_cc_requirement bs)
      (RCCRequirementBad RCCRequirementsBad)
      ((RCCRequirement requirement rest)
        (match (read_cc_requirements_n rest (- n 1))
          (RCCRequirementsBad RCCRequirementsBad)
          ((RCCRequirements requirements end)
            (RCCRequirements (CCRCons requirement requirements) end)))))))

(def read_cc_requirements ((bs Bytes)) RCCRequirements
  (match (read_u32 bs)
    (RIntBad RCCRequirementsBad)
    ((RInt count rest) (read_cc_requirements_n rest count))))

(def read_cc_boundary_result ((bs Bytes)) RSEResult
  (match (read_u8 bs)
    (RIntBad RSEResultBad)
    ((RInt tag rest)
      (if (eq tag 0) (RSEResult SEUnitResult rest)
        (if (eq tag 1)
          (match (read_terminal_scalar_type rest)
            (RTerminalScalarTypeBad RSEResultBad)
            ((RTerminalScalarType scalar_type end)
              (RSEResult (SEScalarResult (Decl 1 scalar_type)) end)))
          RSEResultBad)))))

(def read_cc_boundary ((bs Bytes)) RCCBoundary
  (match (read_id bs)
    (RIntBad RCCBoundaryBad)
    ((RInt id r1)
      (match (read_spike_identity r1)
        (RIntsBad RCCBoundaryBad)
        ((RInts identity r2)
          (match (read_optional_id r2)
            (RIntBad RCCBoundaryBad)
            ((RInt attachment r3)
              (match (read_se_parameters r3)
                (RSEParametersBad RCCBoundaryBad)
                ((RSEParameters parameters r4)
                  (match (read_cc_boundary_result r4)
                    (RSEResultBad RCCBoundaryBad)
                    ((RSEResult result r5)
                      (match (read_cc_requirements r5)
                        (RCCRequirementsBad RCCBoundaryBad)
                        ((RCCRequirements requirements r6)
                          (match (read_ids r6)
                            (RIntsBad RCCBoundaryBad)
                            ((RInts services rest)
                              (match result
                                (SEUnitResult
                                  (RCCBoundary
                                    (CCBoundary id identity attachment parameters
                                      CCBoundaryUnit requirements services)
                                    rest))
                                ((SEScalarResult declaration)
                                  (RCCBoundary
                                    (CCBoundary id identity attachment parameters
                                      (CCBoundaryScalar (decl_ty declaration))
                                      requirements services)
                                    rest))))))))))))))))))

(def read_cc_boundaries_n ((bs Bytes) (n Int)) RCCBoundaries
  (if (eq n 0) (RCCBoundaries CCBNil bs)
    (match (read_cc_boundary bs)
      (RCCBoundaryBad RCCBoundariesBad)
      ((RCCBoundary boundary rest)
        (match (read_cc_boundaries_n rest (- n 1))
          (RCCBoundariesBad RCCBoundariesBad)
          ((RCCBoundaries boundaries end)
            (RCCBoundaries (CCBCons boundary boundaries) end)))))))

(def read_cc_boundaries ((bs Bytes)) RCCBoundaries
  (match (read_u32 bs)
    (RIntBad RCCBoundariesBad)
    ((RInt count rest) (read_cc_boundaries_n rest count))))

(def read_cc_entry_claim ((bs Bytes)) RCCEntryClaim
  (match (read_id bs)
    (RIntBad RCCEntryClaimBad)
    ((RInt claim r1)
      (match (read_id r1)
        (RIntBad RCCEntryClaimBad)
        ((RInt input r2)
          (match (expect_zero_count r2)
            (RBytesBad RCCEntryClaimBad)
            ((RBytes rest)
              (RCCEntryClaim (CCEntryClaim claim input) rest))))))))

(def read_cc_entry_claims_n ((bs Bytes) (n Int)) RCCEntryClaims
  (if (eq n 0) (RCCEntryClaims CCENil bs)
    (match (read_cc_entry_claim bs)
      (RCCEntryClaimBad RCCEntryClaimsBad)
      ((RCCEntryClaim claim rest)
        (match (read_cc_entry_claims_n rest (- n 1))
          (RCCEntryClaimsBad RCCEntryClaimsBad)
          ((RCCEntryClaims claims end)
            (RCCEntryClaims (CCECons claim claims) end)))))))

(def read_cc_entry_claims ((bs Bytes)) RCCEntryClaims
  (match (read_u32 bs)
    (RIntBad RCCEntryClaimsBad)
    ((RInt count rest) (read_cc_entry_claims_n rest count))))

(def read_cc_argument ((bs Bytes)) RCCArgument
  (match (read_id bs)
    (RIntBad RCCArgumentBad)
    ((RInt place r1)
      (match (expect_zero_count r1)
        (RBytesBad RCCArgumentBad)
        ((RBytes rest) (RCCArgument (CCArgument place) rest))))))

(def read_cc_arguments_n ((bs Bytes) (n Int)) RCCArguments
  (if (eq n 0) (RCCArguments CCANil bs)
    (match (read_cc_argument bs)
      (RCCArgumentBad RCCArgumentsBad)
      ((RCCArgument argument rest)
        (match (read_cc_arguments_n rest (- n 1))
          (RCCArgumentsBad RCCArgumentsBad)
          ((RCCArguments arguments end)
            (RCCArguments (CCACons argument arguments) end)))))))

(def read_cc_arguments ((bs Bytes)) RCCArguments
  (match (read_u32 bs)
    (RIntBad RCCArgumentsBad)
    ((RInt count rest) (read_cc_arguments_n rest count))))

(def read_cc_transfer ((bs Bytes)) RCCTransfer
  (match (read_id bs)
    (RIntBad RCCTransferBad)
    ((RInt claim r1)
      (match (read_u32 r1)
        (RIntBad RCCTransferBad)
        ((RInt argument rest)
          (RCCTransfer (CCTransfer claim argument) rest))))))

(def read_cc_transfers_n ((bs Bytes) (n Int)) RCCTransfers
  (if (eq n 0) (RCCTransfers CCTNil bs)
    (match (read_cc_transfer bs)
      (RCCTransferBad RCCTransfersBad)
      ((RCCTransfer transfer rest)
        (match (read_cc_transfers_n rest (- n 1))
          (RCCTransfersBad RCCTransfersBad)
          ((RCCTransfers transfers end)
            (RCCTransfers (CCTCons transfer transfers) end)))))))

(def read_cc_transfers ((bs Bytes)) RCCTransfers
  (match (read_u32 bs)
    (RIntBad RCCTransfersBad)
    ((RInt count rest) (read_cc_transfers_n rest count))))

(def finish_cc_unit_call ((target Int) (bs Bytes)) RCCOpKind
  (match (read_cc_arguments bs)
    (RCCArgumentsBad RCCOpKindBad)
    ((RCCArguments arguments r1)
      (match (read_cc_transfers r1)
        (RCCTransfersBad RCCOpKindBad)
        ((RCCTransfers transfers r2)
          (match (read_ids r2)
            (RIntsBad RCCOpKindBad)
            ((RInts obligations r3)
              (match (expect_zero_count r3)
                (RBytesBad RCCOpKindBad)
                ((RBytes rest)
                  (RCCOpKind
                    (CCCallUnit target arguments transfers obligations) rest))))))))))

(def finish_cc_boundary_call ((target Int) (bs Bytes)) RCCOpKind
  (match (read_cc_arguments bs)
    (RCCArgumentsBad RCCOpKindBad)
    ((RCCArguments arguments r1)
      (match (read_cc_transfers r1)
        (RCCTransfersBad RCCOpKindBad)
        ((RCCTransfers receipts r2)
          (match (read_ids r2)
            (RIntsBad RCCOpKindBad)
            ((RInts obligations rest)
              (RCCOpKind
                (CCBoundaryCall target arguments receipts obligations) rest))))))))

(def read_cc_op_kind ((bs Bytes)) RCCOpKind
  (match (read_u8 bs)
    (RIntBad RCCOpKindBad)
    ((RInt tag r1)
      (match (read_id r1)
        (RIntBad RCCOpKindBad)
        ((RInt target rest)
          (if (eq tag 34) (finish_cc_unit_call target rest)
            (if (eq tag 35) (finish_cc_boundary_call target rest)
              RCCOpKindBad)))))))

(def read_cc_op ((bs Bytes)) RCCOp
  (match (read_id bs)
    (RIntBad RCCOpBad)
    ((RInt operation r1)
      (match (read_se_result r1)
        (RSEResultBad RCCOpBad)
        ((RSEResult result r2)
          (match (read_cc_op_kind r2)
            (RCCOpKindBad RCCOpBad)
            ((RCCOpKind kind rest)
              (RCCOp (CCOp operation result kind) rest))))))))

(def read_cc_ops_n ((bs Bytes) (n Int)) RCCOps
  (if (eq n 0) (RCCOps CCONil bs)
    (match (read_cc_op bs)
      (RCCOpBad RCCOpsBad)
      ((RCCOp operation rest)
        (match (read_cc_ops_n rest (- n 1))
          (RCCOpsBad RCCOpsBad)
          ((RCCOps operations end)
            (RCCOps (CCOCons operation operations) end)))))))

(def read_cc_ops ((bs Bytes)) RCCOps
  (match (read_u32 bs)
    (RIntBad RCCOpsBad)
    ((RInt count rest) (read_cc_ops_n rest count))))

(def read_cc_block ((bs Bytes)) RCCBlock
  (match (read_id bs)
    (RIntBad RCCBlockBad)
    ((RInt id r1)
      (match (read_decls r1)
        (RDeclsBad RCCBlockBad)
        ((RDecls parameters r2)
          (match (read_cc_ops r2)
            (RCCOpsBad RCCBlockBad)
            ((RCCOps operations r3)
              (match (read_se_terminator r3)
                (RSETerminatorBad RCCBlockBad)
                ((RSETerminator terminator rest)
                  (RCCBlock (CCBlock id parameters operations terminator) rest))))))))))

(def read_cc_blocks_n ((bs Bytes) (n Int)) RCCBlocks
  (if (eq n 0) (RCCBlocks CCBLNil bs)
    (match (read_cc_block bs)
      (RCCBlockBad RCCBlocksBad)
      ((RCCBlock block rest)
        (match (read_cc_blocks_n rest (- n 1))
          (RCCBlocksBad RCCBlocksBad)
          ((RCCBlocks blocks end)
            (RCCBlocks (CCBLCons block blocks) end)))))))

(def read_cc_blocks ((bs Bytes)) RCCBlocks
  (match (read_u32 bs)
    (RIntBad RCCBlocksBad)
    ((RInt count rest) (read_cc_blocks_n rest count))))

(def finish_cc_machine
  ((id Int) (attachment Int) (parameters Decls)
   (structural_parameters SEParameters) (result SEResult) (places SEPlaces)
   (claims CCEntryClaims) (services Ints) (bs Bytes)) RCCMachine
  (match (expect_zero_sections bs 3)
    (RBytesBad RCCMachineBad)
    ((RBytes r1)
      (match (read_id r1)
        (RIntBad RCCMachineBad)
        ((RInt entry r2)
          (match (read_cc_blocks r2)
            (RCCBlocksBad RCCMachineBad)
            ((RCCBlocks blocks r3)
              (match (read_contract r3)
                (RContractBad RCCMachineBad)
                ((RContract contract rest)
                  (RCCMachine
                    (CCMachine id attachment parameters structural_parameters result
                      places claims services entry blocks contract)
                    rest))))))))))

(def read_cc_machine_body
  ((id Int) (attachment Int) (parameters Decls)
   (structural_parameters SEParameters) (result SEResult) (bs Bytes)) RCCMachine
  (match (read_se_places bs)
    (RSEPlacesBad RCCMachineBad)
    ((RSEPlaces places r1)
      (match (read_cc_entry_claims r1)
        (RCCEntryClaimsBad RCCMachineBad)
        ((RCCEntryClaims claims r2)
          (match (read_ids r2)
            (RIntsBad RCCMachineBad)
            ((RInts services rest)
              (finish_cc_machine id attachment parameters structural_parameters
                result places claims services rest))))))))

(def read_cc_machine ((bs Bytes)) RCCMachine
  (match (read_id bs)
    (RIntBad RCCMachineBad)
    ((RInt id r1)
      (match (read_optional_id r1)
        (RIntBad RCCMachineBad)
        ((RInt attachment r2)
          (match (read_decls r2)
            (RDeclsBad RCCMachineBad)
            ((RDecls parameters r3)
              (match (read_se_parameters r3)
                (RSEParametersBad RCCMachineBad)
                ((RSEParameters structural_parameters r4)
                  (match (read_se_result r4)
                    (RSEResultBad RCCMachineBad)
                    ((RSEResult result rest)
                      (read_cc_machine_body id attachment parameters
                        structural_parameters result rest))))))))))))

(def read_cc_machines_n ((bs Bytes) (n Int)) RCCMachines
  (if (eq n 0) (RCCMachines CCMNil bs)
    (match (read_cc_machine bs)
      (RCCMachineBad RCCMachinesBad)
      ((RCCMachine machine rest)
        (match (read_cc_machines_n rest (- n 1))
          (RCCMachinesBad RCCMachinesBad)
          ((RCCMachines machines end)
            (RCCMachines (CCMCons machine machines) end)))))))

(def finish_cc_module
  ((vocabulary Int) (entry Int) (types SETypes)
   (domains CCDomains) (services SEServices) (boundaries CCBoundaries)
   (bs Bytes)) RCCModule
  (match (expect_zero_sections bs 7)
    (RBytesBad RCCModuleBad)
    ((RBytes r1)
      (match (read_u32 r1)
        (RIntBad RCCModuleBad)
        ((RInt count r2)
          (match (read_cc_machines_n r2 count)
            (RCCMachinesBad RCCModuleBad)
            ((RCCMachines machines end)
              (if (match end (BNil 1) (z 0))
                (RCCModule
                  (CCModule vocabulary entry types domains services boundaries
                    machines))
                RCCModuleBad))))))))

(def decode_call_composition_module ((bs Bytes)) RCCModule
  (match (read_terminal_header bs)
    (RTerminalHeaderBad RCCModuleBad)
    ((RTerminalHeader vocabulary r1)
      (match (read_id r1)
        (RIntBad RCCModuleBad)
        ((RInt entry r2)
          (match (read_se_types r2)
            (RSETypesBad RCCModuleBad)
            ((RSETypes types r3)
              (match (read_cc_domains r3)
                (RCCDomainsBad RCCModuleBad)
                ((RCCDomains domains r4)
                  (match (read_se_services r4)
                    (RSEServicesBad RCCModuleBad)
                    ((RSEServices services r5)
                      (match (read_cc_boundaries r5)
                        (RCCBoundariesBad RCCModuleBad)
                        ((RCCBoundaries boundaries rest)
                          (finish_cc_module vocabulary entry types domains
                            services boundaries rest))))))))))))))
