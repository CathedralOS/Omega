; Q7 closed leaf-operation schema table and its generic row interpreter.
;
; This module owns only leaf well-formedness, direct denotation, canonical
; safety goals, post-discharge facts, crash policy, and local fuel/frontier
; effects. Calls, control flow, premise lifetime, and ledger sequencing remain
; separate algebra in ledger.gamma.

(def scalar_logic_schemas () LeafSchemas
  (LSCons
    (LeafSchema LIntConst ResultI8 IntegerLiteralPayload DIntConst GoalNone
      FactEquation NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
    (LSCons
      (LeafSchema LBoolConst ResultBool BooleanLiteralPayload DBoolConst GoalNone
        FactEquation NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
      (LSCons
        (LeafSchema LBoolNot ResultBool UnaryBooleanOperand DBoolNot GoalNone
          FactEquation NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
        (LSCons
          (LeafSchema LBoolEq ResultBool BinaryBooleanOperands DBoolEq GoalNone
            FactEquation NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
          (LSCons
            (LeafSchema LIntEq ResultBool BinaryIntegerOperands DIntEq GoalNone
              FactEquation NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
            (LSCons
              (LeafSchema LLessEq ResultBool BinaryIntegerOperands DLessEq GoalNone
                FactEquation NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
              LSNil)))))))

(def exact_arithmetic_schemas () LeafSchemas
  (LSCons
    (LeafSchema LExactAdd ResultI8 BinaryIntegerOperands DExactAdd GoalFitsI8 FactEquation
      CrashesUnlessGoal ConsumesOneFuel KeepsLocalFrontier)
    (LSCons
      (LeafSchema LExactSub ResultI8 BinaryIntegerOperands DExactSub GoalFitsI8 FactEquation
        CrashesUnlessGoal ConsumesOneFuel KeepsLocalFrontier)
      (LSCons
        (LeafSchema LExactMul ResultI8 BinaryIntegerOperands DExactMul GoalFitsI8 FactEquation
          CrashesUnlessGoal ConsumesOneFuel KeepsLocalFrontier)
        LSNil))))

(def total_arithmetic_schemas () LeafSchemas
  (LSCons
    (LeafSchema LWrapAdd ResultI8 BinaryIntegerOperands DWrapAdd GoalNone FactEquation
      NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
    (LSCons
      (LeafSchema LSatAdd ResultI8 BinaryIntegerOperands DSatAdd GoalNone FactEquation
        NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
      (LSCons
        (LeafSchema LWrapSub ResultI8 BinaryIntegerOperands DWrapSub GoalNone FactEquation
          NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
        (LSCons
          (LeafSchema LSatSub ResultI8 BinaryIntegerOperands DSatSub GoalNone FactEquation
            NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
          (LSCons
            (LeafSchema LWrapMul ResultI8 BinaryIntegerOperands DWrapMul GoalNone FactEquation
              NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
            (LSCons
              (LeafSchema LSatMul ResultI8 BinaryIntegerOperands DSatMul GoalNone FactEquation
                NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
              LSNil)))))))

(def div_rem_comparison_schemas () LeafSchemas
  (LSCons
    (LeafSchema LExactDiv ResultI8 BinaryIntegerOperands DExactDiv GoalExactDiv FactEquation
      CrashesUnlessGoal ConsumesOneFuel KeepsLocalFrontier)
    (LSCons
      (LeafSchema LExactRem ResultI8 BinaryIntegerOperands DExactRem GoalExactDiv FactEquation
        CrashesUnlessGoal ConsumesOneFuel KeepsLocalFrontier)
      (LSCons
        (LeafSchema LWrapDiv ResultI8 BinaryIntegerOperands DWrapDiv GoalNonZero FactEquation
          CrashesUnlessGoal ConsumesOneFuel KeepsLocalFrontier)
          (LSCons
            (LeafSchema LWrapRem ResultI8 BinaryIntegerOperands DWrapRem GoalNonZero FactEquation
              CrashesUnlessGoal ConsumesOneFuel KeepsLocalFrontier)
            (LSCons
              (LeafSchema LSatDiv ResultI8 BinaryIntegerOperands DSatDiv GoalNonZero FactEquation
                CrashesUnlessGoal ConsumesOneFuel KeepsLocalFrontier)
              (LSCons
                (LeafSchema LSatRem ResultI8 BinaryIntegerOperands DSatRem GoalNonZero FactEquation
                  CrashesUnlessGoal ConsumesOneFuel KeepsLocalFrontier)
                (LSCons
                  (LeafSchema LLess ResultBool BinaryIntegerOperands DLess GoalNone FactEquation
                    NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
                  LSNil))))))))

(def leaf_schemas_append ((left LeafSchemas) (right LeafSchemas)) LeafSchemas
  (match left
    (LSNil right)
    ((LSCons schema rest) (LSCons schema (leaf_schemas_append rest right)))))

(def canonical_leaf_schemas () LeafSchemas
  (leaf_schemas_append (scalar_logic_schemas)
    (leaf_schemas_append (exact_arithmetic_schemas)
      (leaf_schemas_append (total_arithmetic_schemas) (div_rem_comparison_schemas)))))

(def leaf_kind_equal ((a LeafKind) (b LeafKind)) Int
  (match a
    (LIntConst (match b (LIntConst 1) (z 0)))
    (LBoolConst (match b (LBoolConst 1) (z 0)))
    (LBoolNot (match b (LBoolNot 1) (z 0)))
    (LBoolEq (match b (LBoolEq 1) (z 0)))
    (LIntEq (match b (LIntEq 1) (z 0)))
    (LLessEq (match b (LLessEq 1) (z 0)))
    (LExactAdd (match b (LExactAdd 1) (z 0)))
    (LExactSub (match b (LExactSub 1) (z 0)))
    (LExactMul (match b (LExactMul 1) (z 0)))
    (LWrapAdd (match b (LWrapAdd 1) (z 0)))
    (LSatAdd (match b (LSatAdd 1) (z 0)))
    (LWrapSub (match b (LWrapSub 1) (z 0)))
    (LSatSub (match b (LSatSub 1) (z 0)))
    (LWrapMul (match b (LWrapMul 1) (z 0)))
    (LSatMul (match b (LSatMul 1) (z 0)))
    (LExactDiv (match b (LExactDiv 1) (z 0)))
    (LExactRem (match b (LExactRem 1) (z 0)))
    (LWrapDiv (match b (LWrapDiv 1) (z 0)))
    (LWrapRem (match b (LWrapRem 1) (z 0)))
    (LSatDiv (match b (LSatDiv 1) (z 0)))
    (LSatRem (match b (LSatRem 1) (z 0)))
    (LLess (match b (LLess 1) (z 0)))))

(def schema_kind ((schema LeafSchema)) LeafKind
  (match schema
    ((LeafSchema kind result operands denotation goal fact crash fuel frontier) kind)))

(def merge_leaf_schema_match
  ((schema LeafSchema) (want LeafKind) (tail RLeafSchema)) RLeafSchema
  (if (leaf_kind_equal (schema_kind schema) want)
    (match tail
      (LeafSchemaMissing (LeafSchemaFound schema))
      (z LeafSchemaDuplicate))
    tail))

(def find_leaf_schema ((schemas LeafSchemas) (want LeafKind)) RLeafSchema
  (match schemas
    (LSNil LeafSchemaMissing)
    ((LSCons first rest)
      (match rest
        (LSNil (merge_leaf_schema_match first want LeafSchemaMissing))
        ((LSCons second tail)
          (merge_leaf_schema_match first want
            (merge_leaf_schema_match second want (find_leaf_schema tail want))))))))

(def view_leaf ((kind OpKind)) LeafView
  (match kind
    ((KIntConst value) (LeafView LIntConst value 0 0))
    ((KBoolConst value) (LeafView LBoolConst value 0 0))
    ((KBoolNot operand) (LeafView LBoolNot operand 0 0))
    ((KBoolEq left right) (LeafView LBoolEq left right 0))
    ((KIntEq left right) (LeafView LIntEq left right 0))
    ((KLessEq left right) (LeafView LLessEq left right 0))
    ((KExactAdd left right obligation) (LeafView LExactAdd left right obligation))
    ((KExactSub left right obligation) (LeafView LExactSub left right obligation))
    ((KExactMul left right obligation) (LeafView LExactMul left right obligation))
    ((KWrapAdd left right) (LeafView LWrapAdd left right 0))
    ((KSatAdd left right) (LeafView LSatAdd left right 0))
    ((KWrapSub left right) (LeafView LWrapSub left right 0))
    ((KSatSub left right) (LeafView LSatSub left right 0))
    ((KWrapMul left right) (LeafView LWrapMul left right 0))
    ((KSatMul left right) (LeafView LSatMul left right 0))
    ((KExactDiv left right obligation) (LeafView LExactDiv left right obligation))
    ((KExactRem left right obligation) (LeafView LExactRem left right obligation))
    ((KWrapDiv left right obligation) (LeafView LWrapDiv left right obligation))
    ((KWrapRem left right obligation) (LeafView LWrapRem left right obligation))
    ((KSatDiv left right obligation) (LeafView LSatDiv left right obligation))
    ((KSatRem left right obligation) (LeafView LSatRem left right obligation))
    ((KLess left right) (LeafView LLess left right 0))
    ((KCall target arguments obligations) NotLeaf)))

(def result_shape_type ((shape ResultShape)) Int
  (match shape (ResultI8 2) (ResultBool 1)))

(def denotation_expression ((denotation Denotation) (left Int) (right Int)) Expr
  (match denotation
    (DIntConst (Lit left))
    (DBoolConst (BoolLit left))
    (DBoolNot (BoolNot (Val left)))
    (DBoolEq (BoolEq (Val left) (Val right)))
    (DIntEq (IntEq (Val left) (Val right)))
    (DLessEq (LessEq (Val left) (Val right)))
    (DExactAdd (Add (Val left) (Val right)))
    (DExactSub (Sub (Val left) (Val right)))
    (DExactMul (Mul (Val left) (Val right)))
    (DWrapAdd (WrapAdd (Val left) (Val right)))
    (DSatAdd (SatAdd (Val left) (Val right)))
    (DWrapSub (WrapSub (Val left) (Val right)))
    (DSatSub (SatSub (Val left) (Val right)))
    (DWrapMul (WrapMul (Val left) (Val right)))
    (DSatMul (SatMul (Val left) (Val right)))
    (DExactDiv (TzDiv (Val left) (Val right)))
    (DExactRem (TzRem (Val left) (Val right)))
    (DWrapDiv (WrapDiv (Val left) (Val right)))
    (DWrapRem (WrapRem (Val left) (Val right)))
    (DSatDiv (SatDiv (Val left) (Val right)))
    (DSatRem (SatRem (Val left) (Val right)))
    (DLess (Less (Val left) (Val right)))))

(def schema_policy_valid
  ((result ResultShape) (goal GoalShape) (fact FactShape) (crash CrashShape)
   (fuel FuelShape) (frontier FrontierShape) (obligation Int)) Int
  (match fuel
    (ConsumesOneFuel
      (match frontier
        (KeepsLocalFrontier
          (match goal
            (GoalNone
              (if (eq obligation 0)
                (match crash
                  (NeverCrashes
                    (match fact (FactEquation 1)))
                  (z 0))
                0))
            (z
              (if (nonzero obligation)
                (match crash
                  (CrashesUnlessGoal
                    (match result
                      (ResultI8 (match fact (FactEquation 1)))
                      (ResultBool 0)))
                  (z 0))
                0))))))))

(def leaf_goal_formula
  ((goal GoalShape) (obligation Int) (expression Expr) (left Int) (right Int)) Formula
  (match goal
    (GoalFitsI8 (SafetyFitsI8 obligation expression))
    (GoalExactDiv (SafetyExactDiv obligation left right))
    (GoalNonZero (SafetyNonZero obligation right))
    (GoalNone (SafetyNonZero 0 0))))

(def leaf_fact_formula
  ((fact FactShape) (result Int) (expression Expr) (left Int) (right Int)) Formula
  (match fact (FactEquation (ResultEq result expression))))

(def build_leaf_from_schema
  ((schema LeafSchema) (operation Int) (result Decl) (known Decls)
   (machine Int) (block Int) (rank Int) (left Int) (right Int) (obligation Int)) Build
  (match schema
    ((LeafSchema kind result_shape operand_shape denotation goal fact crash fuel frontier)
      (if (schema_policy_valid result_shape goal fact crash fuel frontier obligation)
        (if (valid_leaf_result result known operand_shape left right
              (result_shape_type result_shape))
          (let expression (denotation_expression denotation left right)
            (let fact_formula (leaf_fact_formula fact (decl_id result) expression left right)
              (match goal
                (GoalNone
                  (Built
                    (LCons (Row rank (PrimitiveOrigin operation) fact_formula
                             block (MachineScope machine) INil) LNil)
                    (+ rank 1) (DCons result known)))
                (z
                  (Built
                    (LCons (Row rank (PrimitiveOrigin operation)
                             (leaf_goal_formula goal obligation expression left right)
                             block (MachineScope machine) INil)
                      (LCons (Row (+ rank 1) (PrimitiveOrigin operation) fact_formula
                               block (MachineScope machine) (ICons rank INil)) LNil))
                    (+ rank 2) (DCons result known))))))
          BuildBad)
        BuildBad))))
