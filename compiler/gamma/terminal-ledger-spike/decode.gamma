; Q7 spike decoder for the closed scalar/logic/arithmetic/control/call PSITERM v18 slice.
; Fixed-width little-endian fields are consumed directly from Bytes.  The spike
; retains only small nonzero u64 identities (upper half zero), which is an
; explicit measured limitation of this fixture vocabulary.  The shared byte
; layer still decodes the complete unsigned range without collapsing it into
; Gamma's signed Int.

(def both ((a Int) (b Int)) Int (if a b 0))
(def nonzero ((a Int)) Int (if (eq a 0) 0 1))

(def narrow_spike_identity ((identity TerminalSemanticId) (rest Bytes)) RInt
  (match identity
    ((TerminalSemanticId value)
      (match value
        ((U64 low high) (if (eq high 0) (RInt low rest) RIntBad))))))

(def read_id ((bs Bytes)) RInt
  (match (read_terminal_semantic_id bs)
    (RTerminalSemanticIdBad RIntBad)
    ((RTerminalSemanticId identity rest)
      (narrow_spike_identity identity rest))))

(def expect_zero_count ((bs Bytes)) RBytes
  (match (read_u32 bs)
    (RIntBad RBytesBad)
    ((RInt n rest) (if (eq n 0) (RBytes rest) RBytesBad))))

(def expect_zero_sections ((bs Bytes) (n Int)) RBytes
  (if (eq n 0) (RBytes bs)
    (match (expect_zero_count bs)
      (RBytesBad RBytesBad)
      ((RBytes rest) (expect_zero_sections rest (- n 1))))))

(def read_i8_integer_value ((bs Bytes)) RInt
  (match (read_terminal_integer_value bs)
    (RTerminalIntegerValueBad RIntBad)
    ((RTerminalIntegerValue value rest)
      (match (narrow_spike_i8_value value)
        (NarrowI8Bad RIntBad)
        ((NarrowI8 narrowed) (RInt narrowed rest))))))

(def narrow_spike_integer_type
  ((integer TerminalIntegerType) (rest Bytes)) RInt
  (match integer
    ((TerminalFixedSigned bits)
      (if (eq bits 8) (RInt 2 rest)
        (if (eq bits 16) (RInt 3 rest) RIntBad)))
    ((TerminalFixedUnsigned bits) RIntBad)
    ((TerminalAddress bits) RIntBad)))

(def read_integer_type ((bs Bytes)) RInt
  (match (read_terminal_integer_type bs)
    (RTerminalIntegerTypeBad RIntBad)
    ((RTerminalIntegerType integer rest)
      (narrow_spike_integer_type integer rest))))

(def narrow_spike_scalar_type
  ((scalar TerminalScalarType) (rest Bytes)) RInt
  (match scalar
    (TerminalBoolean (RInt 1 rest))
    ((TerminalInteger integer) (narrow_spike_integer_type integer rest))))

(def read_scalar_type ((bs Bytes)) RInt
  (match (read_terminal_scalar_type bs)
    (RTerminalScalarTypeBad RIntBad)
    ((RTerminalScalarType scalar rest)
      (narrow_spike_scalar_type scalar rest))))

(def read_decl ((bs Bytes)) RDecl
  (match (read_id bs)
    (RIntBad RDeclBad)
    ((RInt id rest)
      (match (read_terminal_scalar_type rest)
        (RTerminalScalarTypeBad RDeclBad)
        ((RTerminalScalarType ty tail) (RDecl (Decl id ty) tail))))))

(def read_decls_n ((bs Bytes) (n Int)) RDecls
  (if (eq n 0) (RDecls DNil bs)
    (match (read_decl bs)
      (RDeclBad RDeclsBad)
      ((RDecl h rest)
        (match (read_decls_n rest (- n 1))
          (RDeclsBad RDeclsBad)
          ((RDecls t tail) (RDecls (DCons h t) tail)))))))

(def read_decls ((bs Bytes)) RDecls
  (match (read_u32 bs)
    (RIntBad RDeclsBad)
    ((RInt n rest) (read_decls_n rest n))))

(def read_ids_n ((bs Bytes) (n Int)) RInts
  (if (eq n 0) (RInts INil bs)
    (match (read_id bs)
      (RIntBad RIntsBad)
      ((RInt h rest)
        (match (read_ids_n rest (- n 1))
          (RIntsBad RIntsBad)
          ((RInts t tail) (RInts (ICons h t) tail)))))))

(def read_ids ((bs Bytes)) RInts
  (match (read_u32 bs)
    (RIntBad RIntsBad)
    ((RInt n rest) (read_ids_n rest n))))

(def read_expr ((bs Bytes)) RExpr
  (match (read_u8 bs)
    (RIntBad RExprBad)
    ((RInt tag rest)
      (if (eq tag 1)
        (match (read_id rest)
          (RIntBad RExprBad)
          ((RInt id tail)
            (match (read_scalar_type tail)
              (RIntBad RExprBad)
              ((RInt ty end) (if (eq ty 2) (RExpr (Val id) end) RExprBad)))))
        (if (eq tag 3)
          (match (read_integer_type rest)
            (RIntBad RExprBad)
            ((RInt ty tail)
              (match (read_i8_integer_value tail)
                (RIntBad RExprBad)
                ((RInt value end) (if (eq ty 2) (RExpr (Lit value) end) RExprBad)))))
          RExprBad)))))

(def read_prop ((bs Bytes)) RProp
  (match (read_u8 bs)
    (RIntBad RPropBad)
    ((RInt tag rest)
      (if (eq tag 6)
        (match (read_expr rest)
          (RExprBad RPropBad)
          ((RExpr left tail)
            (match (read_expr tail)
              (RExprBad RPropBad)
              ((RExpr right end) (RProp (Le left right) end)))))
        RPropBad))))

(def read_props_n ((bs Bytes) (n Int)) RProps
  (if (eq n 0) (RProps PNil bs)
    (match (read_prop bs)
      (RPropBad RPropsBad)
      ((RProp h rest)
        (match (read_props_n rest (- n 1))
          (RPropsBad RPropsBad)
          ((RProps t tail) (RProps (PCons h t) tail)))))))

(def read_props ((bs Bytes)) RProps
  (match (read_u32 bs)
    (RIntBad RPropsBad)
    ((RInt n rest) (read_props_n rest n))))

(def read_exact_kind ((bs Bytes) (tag Int)) RKind
  (match (read_id bs)
    (RIntBad RKindBad)
    ((RInt left r1)
      (match (read_id r1)
        (RIntBad RKindBad)
        ((RInt right r2)
          (match (read_id r2)
            (RIntBad RKindBad)
            ((RInt obligation rest)
              (if (eq tag 24) (RKind (KExactAdd left right obligation) rest)
                (if (eq tag 25) (RKind (KExactSub left right obligation) rest)
                  (if (eq tag 26) (RKind (KExactMul left right obligation) rest)
                    (if (eq tag 27) (RKind (KExactDiv left right obligation) rest)
                      (if (eq tag 28) (RKind (KExactRem left right obligation) rest)
                        RKindBad))))))))))))

(def read_literal_kind ((bs Bytes) (tag Int)) RKind
  (if (eq tag 1)
    (match (read_terminal_integer_value bs)
      (RTerminalIntegerValueBad RKindBad)
      ((RTerminalIntegerValue value rest) (RKind (KIntConst value) rest)))
    (if (eq tag 2)
      (match (read_u8 bs)
        (RIntBad RKindBad)
        ((RInt value rest)
          (if (lt value 2) (RKind (KBoolConst value) rest) RKindBad)))
      RKindBad)))

(def read_unary_kind ((bs Bytes) (tag Int)) RKind
  (match (read_id bs)
    (RIntBad RKindBad)
    ((RInt operand rest)
      (if (eq tag 9) (RKind (KBoolNot operand) rest) RKindBad))))

(def read_integer_unary_kind ((bs Bytes) (tag Int)) RKind
  (match (read_id bs)
    (RIntBad RKindBad)
    ((RInt operand rest)
      (if (eq tag 19) (RKind (KBitNot operand) rest)
        (if (eq tag 20) (RKind (KWiden operand) rest) RKindBad)))))

(def read_exact_cast_kind ((bs Bytes)) RKind
  (match (read_id bs)
    (RIntBad RKindBad)
    ((RInt operand r1)
      (match (read_id r1)
        (RIntBad RKindBad)
        ((RInt obligation rest) (RKind (KExactCast operand obligation) rest))))))

(def read_shift_kind ((bs Bytes) (tag Int)) RKind
  (match (read_id bs)
    (RIntBad RKindBad)
    ((RInt value r1)
      (match (read_id r1)
        (RIntBad RKindBad)
        ((RInt count r2)
          (if (lt tag 19)
            (if (eq tag 17) (RKind (KWrapShl value count) r2)
              (if (eq tag 18) (RKind (KWrapShr value count) r2) RKindBad))
            (match (read_id r2)
              (RIntBad RKindBad)
              ((RInt obligation rest)
                (if (eq tag 22) (RKind (KExactShr value count obligation) rest)
                  (if (eq tag 23) (RKind (KExactShl value count obligation) rest)
                    RKindBad))))))))))

(def read_binary_kind ((bs Bytes) (tag Int)) RKind
  (match (read_id bs)
    (RIntBad RKindBad)
    ((RInt left r1)
      (match (read_id r1)
        (RIntBad RKindBad)
        ((RInt right rest)
          (if (eq tag 3) (RKind (KWrapAdd left right) rest)
            (if (eq tag 4) (RKind (KSatAdd left right) rest)
              (if (eq tag 5) (RKind (KWrapSub left right) rest)
                (if (eq tag 6) (RKind (KSatSub left right) rest)
                  (if (eq tag 7) (RKind (KWrapMul left right) rest)
                    (if (eq tag 8) (RKind (KSatMul left right) rest)
                      (if (eq tag 10) (RKind (KBoolEq left right) rest)
                        (if (eq tag 11) (RKind (KIntEq left right) rest)
                          (if (eq tag 12) (RKind (KLess left right) rest)
                            (if (eq tag 13) (RKind (KLessEq left right) rest)
                              (if (eq tag 14) (RKind (KBitAnd left right) rest)
                                (if (eq tag 15) (RKind (KBitOr left right) rest)
                                  (if (eq tag 16) (RKind (KBitXor left right) rest)
                                    RKindBad))))))))))))))))))

(def read_divisor_gated_kind ((bs Bytes) (tag Int)) RKind
  (match (read_id bs)
    (RIntBad RKindBad)
    ((RInt left r1)
      (match (read_id r1)
        (RIntBad RKindBad)
        ((RInt right r2)
          (match (read_id r2)
            (RIntBad RKindBad)
            ((RInt obligation rest)
              (if (eq tag 29) (RKind (KWrapDiv left right obligation) rest)
                (if (eq tag 30) (RKind (KWrapRem left right obligation) rest)
                  (if (eq tag 31) (RKind (KSatDiv left right obligation) rest)
                    (if (eq tag 32) (RKind (KSatRem left right obligation) rest)
                      RKindBad)))))))))))

(def read_call_kind ((bs Bytes)) RKind
  (match (read_id bs)
    (RIntBad RKindBad)
    ((RInt callee r1)
      (match (read_ids r1)
        (RIntsBad RKindBad)
        ((RInts arguments r2)
          (match (read_ids r2)
            (RIntsBad RKindBad)
            ((RInts obligations r3)
              (match (expect_zero_count r3)
                (RBytesBad RKindBad)
                ((RBytes rest) (RKind (KCall callee arguments obligations) rest))))))))))

(def read_kind ((bs Bytes)) RKind
  (match (read_u8 bs)
    (RIntBad RKindBad)
    ((RInt tag rest)
      (if (lt tag 3) (read_literal_kind rest tag)
        (if (lt tag 9) (read_binary_kind rest tag)
          (if (lt tag 14)
            (if (eq tag 9) (read_unary_kind rest tag) (read_binary_kind rest tag))
            (if (lt tag 17) (read_binary_kind rest tag)
              (if (lt tag 19) (read_shift_kind rest tag)
                (if (lt tag 21) (read_integer_unary_kind rest tag)
                  (if (eq tag 21) (read_exact_cast_kind rest)
                    (if (lt tag 24) (read_shift_kind rest tag)
                      (if (lt tag 29) (read_exact_kind rest tag)
                        (if (lt tag 33) (read_divisor_gated_kind rest tag)
                          (if (eq tag 33) (read_call_kind rest) RKindBad))))))))))))))

(def read_op ((bs Bytes)) ROp
  (match (read_id bs)
    (RIntBad ROpBad)
    ((RInt id r1)
      (match (read_u8 r1)
        (RIntBad ROpBad)
        ((RInt result_tag r2)
          (if (eq result_tag 1)
            (match (read_decl r2)
              (RDeclBad ROpBad)
              ((RDecl result r3)
                (match (read_kind r3)
                  (RKindBad ROpBad)
                  ((RKind kind rest) (ROp (Op id result kind) rest)))))
            ROpBad))))))

(def read_ops_n ((bs Bytes) (n Int)) ROps
  (if (eq n 0) (ROps ONil bs)
    (match (read_op bs)
      (ROpBad ROpsBad)
      ((ROp h rest)
        (match (read_ops_n rest (- n 1))
          (ROpsBad ROpsBad)
          ((ROps t tail) (ROps (OCons h t) tail)))))))

(def read_ops ((bs Bytes)) ROps
  (match (read_u32 bs)
    (RIntBad ROpsBad)
    ((RInt n rest) (read_ops_n rest n))))

(def read_edge ((bs Bytes)) REdge
  (match (read_id bs)
    (RIntBad REdgeBad)
    ((RInt id r1)
      (match (read_id r1)
        (RIntBad REdgeBad)
        ((RInt target r2)
          (match (read_ids r2)
            (RIntsBad REdgeBad)
            ((RInts arguments r3)
              (match (expect_zero_count r3)
                (RBytesBad REdgeBad)
                ((RBytes rest) (REdge (Edge id target arguments) rest))))))))))

(def read_term ((bs Bytes)) RTerm
  (match (read_u8 bs)
    (RIntBad RTermBad)
    ((RInt tag rest)
      (if (eq tag 1)
        (match (read_edge rest)
          (REdgeBad RTermBad)
          ((REdge edge tail) (RTerm (Jump edge) tail)))
        (if (eq tag 2)
          (match (read_id rest)
            (RIntBad RTermBad)
            ((RInt edge r1)
              (match (read_id r1)
                (RIntBad RTermBad)
                ((RInt value r2)
                  (match (expect_zero_count r2)
                    (RBytesBad RTermBad)
                    ((RBytes tail) (RTerm (Ret edge value) tail)))))))
          (if (eq tag 3)
            (match (read_id rest)
              (RIntBad RTermBad)
              ((RInt condition r1)
                (match (read_edge r1)
                  (REdgeBad RTermBad)
                  ((REdge yes r2)
                    (match (read_edge r2)
                      (REdgeBad RTermBad)
                      ((REdge no tail) (RTerm (Cond condition yes no) tail)))))))
            RTermBad))))))

(def read_block ((bs Bytes)) RBlock
  (match (read_id bs)
    (RIntBad RBlockBad)
    ((RInt id r1)
      (match (read_decls r1)
        (RDeclsBad RBlockBad)
        ((RDecls parameters r2)
          (match (read_ops r2)
            (ROpsBad RBlockBad)
            ((ROps operations r3)
              (match (read_term r3)
                (RTermBad RBlockBad)
                ((RTerm term rest) (RBlock (Block id parameters operations term) rest))))))))))

(def read_blocks_n ((bs Bytes) (n Int)) RBlocks
  (if (eq n 0) (RBlocks BLNil bs)
    (match (read_block bs)
      (RBlockBad RBlocksBad)
      ((RBlock h rest)
        (match (read_blocks_n rest (- n 1))
          (RBlocksBad RBlocksBad)
          ((RBlocks t tail) (RBlocks (BLCons h t) tail)))))))

(def read_blocks ((bs Bytes)) RBlocks
  (match (read_u32 bs)
    (RIntBad RBlocksBad)
    ((RInt n rest) (read_blocks_n rest n))))

(def read_contract ((bs Bytes)) RContract
  (match (read_id bs)
    (RIntBad RContractBad)
    ((RInt id r1)
      (match (expect_zero_count r1)
        (RBytesBad RContractBad)
        ((RBytes r2)
          (match (read_props r2)
            (RPropsBad RContractBad)
            ((RProps requires r3)
              (match (expect_zero_count r3)
                (RBytesBad RContractBad)
                ((RBytes rest) (RContract (Contract id requires) rest))))))))))

(def read_machine_tail ((id Int) (parameters Decls) (result Decl) (bs Bytes)) RMachine
  (match (expect_zero_sections bs 6)
    (RBytesBad RMachineBad)
    ((RBytes r1)
      (match (read_id r1)
        (RIntBad RMachineBad)
        ((RInt entry r2)
          (match (read_blocks r2)
            (RBlocksBad RMachineBad)
            ((RBlocks blocks r3)
              (match (read_contract r3)
                (RContractBad RMachineBad)
                ((RContract contract rest)
                  (RMachine (Machine id parameters result entry blocks contract) rest))))))))))

(def read_machine ((bs Bytes)) RMachine
  (match (read_id bs)
    (RIntBad RMachineBad)
    ((RInt id r1)
      (match (expect_byte r1 0)
        (RBytesBad RMachineBad)
        ((RBytes r2)
          (match (read_decls r2)
            (RDeclsBad RMachineBad)
            ((RDecls parameters r3)
              (match (expect_zero_count r3)
                (RBytesBad RMachineBad)
                ((RBytes r4)
                  (match (expect_byte r4 1)
                    (RBytesBad RMachineBad)
                    ((RBytes r5)
                      (match (read_decl r5)
                        (RDeclBad RMachineBad)
                        ((RDecl result rest)
                          (read_machine_tail id parameters result rest))))))))))))))

(def read_machines_n ((bs Bytes) (n Int)) RMachines
  (if (eq n 0) (RMachines MNil bs)
    (match (read_machine bs)
      (RMachineBad RMachinesBad)
      ((RMachine h rest)
        (match (read_machines_n rest (- n 1))
          (RMachinesBad RMachinesBad)
          ((RMachines t tail) (RMachines (MCons h t) tail)))))))

(def decode_module ((bs Bytes)) RModule
  (match (read_terminal_header bs)
    (RTerminalHeaderBad RModuleBad)
    ((RTerminalHeader vocabulary r1)
      (match (read_id r1)
        (RIntBad RModuleBad)
        ((RInt entry r2)
          (match (expect_zero_sections r2 11)
            (RBytesBad RModuleBad)
            ((RBytes r3)
              (match (read_u32 r3)
                (RIntBad RModuleBad)
                ((RInt count r4)
                  (match (read_machines_n r4 count)
                    (RMachinesBad RModuleBad)
                    ((RMachines machines tail)
                      (match tail
                        (BNil (RModule (Module vocabulary entry machines)))
                        (z RModuleBad)))))))))))))
