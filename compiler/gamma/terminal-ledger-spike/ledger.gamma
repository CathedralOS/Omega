; Q7 spike ledger reconstruction over the decoded PSITERM subset.
; No interval or affine reduction appears here: rows contain only direct leaf
; denotation, safety goals, branch premises, exact call substitution, and the
; all-predecessor merge rule.

(def ints_len ((xs Ints)) Int
  (match xs (INil 0) ((ICons h t) (+ 1 (ints_len t)))))

(def unpack_bytes ((packed Int) (count Int) (tail Bytes)) Bytes
  (if (eq count 0) tail
    (B (% packed 256) (unpack_bytes (/ packed 256) (- count 1) tail))))

(def ints_has ((xs Ints) (x Int)) Int
  (match xs (INil 0) ((ICons h t) (if (eq h x) 1 (ints_has t x)))))

(def ints_append ((a Ints) (b Ints)) Ints
  (match a (INil b) ((ICons h t) (ICons h (ints_append t b)))))

(def rows_append ((a Rows) (b Rows)) Rows
  (match a (LNil b) ((LCons h t) (LCons h (rows_append t b)))))

(def rows_len ((rows Rows)) Int
  (match rows (LNil 0) ((LCons h t) (+ 1 (rows_len t)))))

(def decl_id ((decl Decl)) Int (match decl ((Decl id ty) id)))
(def decl_ty ((decl Decl)) Int (match decl ((Decl id ty) ty)))

(def decls_ids ((decls Decls)) Ints
  (match decls
    (DNil INil)
    ((DCons h t) (ICons (decl_id h) (decls_ids t)))))

(def decls_all_i8 ((decls Decls)) Int
  (match decls
    (DNil 1)
    ((DCons h t) (if (eq (decl_ty h) 2) (decls_all_i8 t) 0))))

(def machine_id ((machine Machine)) Int
  (match machine ((Machine id parameters result entry blocks contract) id)))

(def machine_parameters ((machine Machine)) Decls
  (match machine ((Machine id parameters result entry blocks contract) parameters)))

(def machine_result ((machine Machine)) Decl
  (match machine ((Machine id parameters result entry blocks contract) result)))

(def machine_entry ((machine Machine)) Int
  (match machine ((Machine id parameters result entry blocks contract) entry)))

(def machine_blocks ((machine Machine)) Blocks
  (match machine ((Machine id parameters result entry blocks contract) blocks)))

(def machine_requires ((machine Machine)) Props
  (match machine
    ((Machine id parameters result entry blocks contract)
      (match contract ((Contract contract_id requires) requires)))))

(def machines_len ((machines Machines)) Int
  (match machines (MNil 0) ((MCons h t) (+ 1 (machines_len t)))))

(def machine_at ((machines Machines) (index Int)) Machine
  (match machines
    (MNil (Machine 0 DNil (Decl 0 0) 0 BLNil (Contract 0 PNil)))
    ((MCons h t) (if (eq index 0) h (machine_at t (- index 1))))))

(def first_decl_id ((decls Decls)) Int
  (match decls ((DCons h t) (decl_id h)) (z 0)))

(def second_decl_id ((decls Decls)) Int
  (match decls
    ((DCons h t) (match t ((DCons s rest) (decl_id s)) (z 0)))
    (z 0)))

(def first_int ((values Ints)) Int
  (match values ((ICons h t) h) (z 0)))

(def second_int ((values Ints)) Int
  (match values
    ((ICons h t) (match t ((ICons s rest) s) (z 0)))
    (z 0)))

(def expr_equal ((a Expr) (b Expr)) Int
  (match a
    ((Val x) (match b ((Val y) (eq x y)) (z 0)))
    ((Lit x) (match b ((Lit y) (eq x y)) (z 0)))
    ((Add x y) (match b ((Add p q) (if (expr_equal x p) (expr_equal y q) 0)) (z 0)))
    ((TzDiv x y) (match b ((TzDiv p q) (if (expr_equal x p) (expr_equal y q) 0)) (z 0)))
    ((TzRem x y) (match b ((TzRem p q) (if (expr_equal x p) (expr_equal y q) 0)) (z 0)))
    ((WrapAdd x y) (match b ((WrapAdd p q) (if (expr_equal x p) (expr_equal y q) 0)) (z 0)))
    ((WrapDiv x y) (match b ((WrapDiv p q) (if (expr_equal x p) (expr_equal y q) 0)) (z 0)))
    ((WrapRem x y) (match b ((WrapRem p q) (if (expr_equal x p) (expr_equal y q) 0)) (z 0)))
    ((Less x y) (match b ((Less p q) (if (expr_equal x p) (expr_equal y q) 0)) (z 0)))))

(def prop_equal ((a Prop) (b Prop)) Int
  (match a ((Le x y) (match b ((Le p q) (if (expr_equal x p) (expr_equal y q) 0))))))

(def subst_expr ((expr Expr) (p0 Int) (a0 Int) (p1 Int) (a1 Int)) Expr
  (match expr
    ((Val x) (if (eq x p0) (Val a0) (if (eq x p1) (Val a1) (Val x))))
    ((Lit x) (Lit x))
    ((Add x y) (Add (subst_expr x p0 a0 p1 a1) (subst_expr y p0 a0 p1 a1)))
    ((TzDiv x y) (TzDiv (subst_expr x p0 a0 p1 a1) (subst_expr y p0 a0 p1 a1)))
    ((TzRem x y) (TzRem (subst_expr x p0 a0 p1 a1) (subst_expr y p0 a0 p1 a1)))
    ((WrapAdd x y) (WrapAdd (subst_expr x p0 a0 p1 a1) (subst_expr y p0 a0 p1 a1)))
    ((WrapDiv x y) (WrapDiv (subst_expr x p0 a0 p1 a1) (subst_expr y p0 a0 p1 a1)))
    ((WrapRem x y) (WrapRem (subst_expr x p0 a0 p1 a1) (subst_expr y p0 a0 p1 a1)))
    ((Less x y) (Less (subst_expr x p0 a0 p1 a1) (subst_expr y p0 a0 p1 a1)))))

(def subst_prop ((prop Prop) (p0 Int) (a0 Int) (p1 Int) (a1 Int)) Prop
  (match prop
    ((Le left right)
      (Le (subst_expr left p0 a0 p1 a1) (subst_expr right p0 a0 p1 a1)))))

(def exact_add_i8 ((left Int) (right Int)) Calc
  (let result (+ left right)
    (if (lt result (- 0 128)) CalcBad (if (lt 127 result) CalcBad (CalcOk result)))))

(def exact_div_i8 ((left Int) (right Int)) Calc
  (if (eq right 0) CalcBad
    (if (if (eq left (- 0 128)) (eq right (- 0 1)) 0) CalcBad (CalcOk (/ left right)))))

(def exact_rem_i8 ((left Int) (right Int)) Calc
  (if (eq right 0) CalcBad
    (if (if (eq left (- 0 128)) (eq right (- 0 1)) 0) CalcBad (CalcOk (% left right)))))

(def wrapping_div_i8 ((left Int) (right Int)) Calc
  (if (eq right 0) CalcBad
    (if (if (eq left (- 0 128)) (eq right (- 0 1)) 0)
      (CalcOk (- 0 128)) (CalcOk (/ left right)))))

(def wrapping_rem_i8 ((left Int) (right Int)) Calc
  (if (eq right 0) CalcBad
    (if (if (eq left (- 0 128)) (eq right (- 0 1)) 0) (CalcOk 0) (CalcOk (% left right)))))

(def wrapping_add_i8 ((left Int) (right Int)) Int
  (let shifted (+ (+ left right) 128)
    (let first (% shifted 256)
      (let positive (if (lt first 0) (+ first 256) first)
        (- positive 128)))))

(def calc_bad ((value Calc)) Int
  (match value (CalcBad 1) ((CalcOk x) 0)))

(def calc_eq ((value Calc) (want Int)) Int
  (match value (CalcBad 0) ((CalcOk x) (eq x want))))

(def arithmetic_self_test () Int
  (if (calc_bad (exact_add_i8 120 20))
    (if (calc_bad (exact_div_i8 (- 0 128) (- 0 1)))
      (if (calc_bad (exact_rem_i8 (- 0 128) (- 0 1)))
        (if (calc_eq (wrapping_div_i8 (- 0 128) (- 0 1)) (- 0 128))
          (if (calc_eq (wrapping_rem_i8 (- 0 128) (- 0 1)) 0)
            (if (calc_eq (exact_div_i8 (- 0 7) 3) (- 0 2))
              (if (calc_eq (exact_rem_i8 (- 0 7) 3) (- 0 1))
                (eq (wrapping_add_i8 120 20) (- 0 116))
                0)
              0)
            0)
          0)
        0)
      0)
    0))

(def emit_requirements
  ((props Props) (obligations Ints) (p0 Int) (a0 Int) (p1 Int) (a1 Int)
   (operation Int) (ordinal Int) (rank Int)) ReqBuild
  (match props
    (PNil (match obligations (INil (ReqBuilt LNil rank)) (z ReqBuildBad)))
    ((PCons prop rest)
      (match obligations
        (INil ReqBuildBad)
        ((ICons obligation more)
          (match (emit_requirements rest more p0 a0 p1 a1 operation (+ ordinal 1) (+ rank 1))
            (ReqBuildBad ReqBuildBad)
            ((ReqBuilt rows next)
              (ReqBuilt
                (LCons
                  (Row rank (CallOrigin operation ordinal)
                    (CallRequirement operation obligation (subst_prop prop p0 a0 p1 a1))
                    operation (MachineScope operation) INil)
                  rows)
                next))))))))

(def valid_binary_result ((result Decl) (known Ints) (left Int) (right Int) (ty Int)) Int
  (if (ints_has known (decl_id result)) 0
    (if (eq (decl_ty result) ty)
      (if (ints_has known left) (ints_has known right) 0)
      0)))

(def build_exact_add
  ((operation Int) (result Decl) (known Ints) (machine Int) (block Int)
   (rank Int) (left Int) (right Int) (obligation Int)) Build
  (if (valid_binary_result result known left right 2)
    (Built
      (LCons (Row rank (PrimitiveOrigin operation)
               (SafetyFitsI8 obligation (Add (Val left) (Val right)))
               block (MachineScope machine) INil)
        (LCons (Row (+ rank 1) (PrimitiveOrigin operation)
                 (ResultEq (decl_id result) (Add (Val left) (Val right)))
                 block (MachineScope machine) (ICons rank INil)) LNil))
      (+ rank 2) (ICons (decl_id result) known))
    BuildBad))

(def build_wrap_add
  ((operation Int) (result Decl) (known Ints) (machine Int) (block Int)
   (rank Int) (left Int) (right Int)) Build
  (if (valid_binary_result result known left right 2)
    (Built
      (LCons (Row rank (PrimitiveOrigin operation)
               (ResultEq (decl_id result) (WrapAdd (Val left) (Val right)))
               block (MachineScope machine) INil) LNil)
      (+ rank 1) (ICons (decl_id result) known))
    BuildBad))

(def build_exact_partial
  ((operation Int) (result Decl) (known Ints) (machine Int) (block Int)
   (rank Int) (left Int) (right Int) (obligation Int) (remainder Int)) Build
  (if (valid_binary_result result known left right 2)
    (let expression (if remainder (TzRem (Val left) (Val right)) (TzDiv (Val left) (Val right)))
      (Built
        (LCons (Row rank (PrimitiveOrigin operation)
                 (SafetyExactDiv obligation left right)
                 block (MachineScope machine) INil)
          (LCons (Row (+ rank 1) (PrimitiveOrigin operation)
                   (ResultEq (decl_id result) expression)
                   block (MachineScope machine) (ICons rank INil)) LNil))
        (+ rank 2) (ICons (decl_id result) known)))
    BuildBad))

(def build_wrapping_partial
  ((operation Int) (result Decl) (known Ints) (machine Int) (block Int)
   (rank Int) (left Int) (right Int) (obligation Int) (remainder Int)) Build
  (if (valid_binary_result result known left right 2)
    (let expression (if remainder (WrapRem (Val left) (Val right)) (WrapDiv (Val left) (Val right)))
      (Built
        (LCons (Row rank (PrimitiveOrigin operation)
                 (SafetyNonZero obligation right)
                 block (MachineScope machine) INil)
          (LCons (Row (+ rank 1) (PrimitiveOrigin operation)
                   (ResultEq (decl_id result) expression)
                   block (MachineScope machine) (ICons rank INil)) LNil))
        (+ rank 2) (ICons (decl_id result) known)))
    BuildBad))

(def build_less
  ((operation Int) (result Decl) (known Ints) (machine Int) (block Int)
   (rank Int) (left Int) (right Int)) Build
  (if (valid_binary_result result known left right 1)
    (Built
      (LCons (Row rank (PrimitiveOrigin operation)
               (ConditionalEq (decl_id result) left right)
               block (MachineScope machine) INil) LNil)
      (+ rank 1) (ICons (decl_id result) known))
    BuildBad))

(def build_call_exact
  ((operation Int) (result Decl) (known Ints) (rank Int) (target Int)
   (callee_id Int) (callee_result Decl) (p0 Int) (p1 Int) (a0 Int) (a1 Int)
   (requires Props) (obligations Ints)) Build
  (if (if (ints_has known (decl_id result)) 0
        (if (eq target callee_id)
          (if (eq (decl_ty result) (decl_ty callee_result))
            (if (ints_has known a0) (ints_has known a1) 0) 0) 0))
    (match (emit_requirements requires obligations p0 a0 p1 a1 operation 0 rank)
      (ReqBuildBad BuildBad)
      ((ReqBuilt rows next) (Built rows next (ICons (decl_id result) known))))
    BuildBad))

(def build_call
  ((operation Int) (result Decl) (known Ints) (callee Machine) (rank Int)
   (target Int) (arguments Ints) (obligations Ints)) Build
  (let parameters (machine_parameters callee)
    (if (eq (ints_len (decls_ids parameters)) 2)
      (if (eq (ints_len arguments) 2)
        (build_call_exact operation result known rank target
          (machine_id callee) (machine_result callee)
          (first_decl_id parameters) (second_decl_id parameters)
          (first_int arguments) (second_int arguments)
          (machine_requires callee) obligations)
        BuildBad)
      BuildBad)))

(def build_kind
  ((kind OpKind) (operation Int) (result Decl) (known Ints) (callee Machine)
   (machine Int) (block Int) (rank Int)) Build
  (match kind
    ((KExactAdd left right obligation)
      (build_exact_add operation result known machine block rank left right obligation))
    ((KWrapAdd left right)
      (build_wrap_add operation result known machine block rank left right))
    ((KExactDiv left right obligation)
      (build_exact_partial operation result known machine block rank left right obligation 0))
    ((KExactRem left right obligation)
      (build_exact_partial operation result known machine block rank left right obligation 1))
    ((KWrapDiv left right obligation)
      (build_wrapping_partial operation result known machine block rank left right obligation 0))
    ((KWrapRem left right obligation)
      (build_wrapping_partial operation result known machine block rank left right obligation 1))
    ((KLess left right)
      (build_less operation result known machine block rank left right))
    ((KCall target arguments obligations)
      (build_call operation result known callee rank target arguments obligations))))

(def build_ops
  ((ops Ops) (known Ints) (callee Machine) (machine Int) (block Int) (rank Int)) Build
  (match ops
    (ONil (Built LNil rank known))
    ((OCons op rest)
      (match op
        ((Op operation result kind)
          (match (build_kind kind operation result known callee machine block rank)
            (BuildBad BuildBad)
            ((Built rows next next_known)
              (match (build_ops rest next_known callee machine block next)
                (BuildBad BuildBad)
                ((Built tail final final_known)
                  (Built (rows_append rows tail) final final_known))))))))))

(def authored_requirements ((props Props) (machine Int) (block Int) (ordinal Int) (rank Int)) ReqBuild
  (match props
    (PNil (ReqBuilt LNil rank))
    ((PCons prop rest)
      (match (authored_requirements rest machine block (+ ordinal 1) (+ rank 1))
        (ReqBuildBad ReqBuildBad)
        ((ReqBuilt rows next)
          (ReqBuilt
            (LCons (Row rank (CallOrigin machine ordinal)
                     (AuthoredRequirement machine ordinal prop)
                     block (MachineScope machine) INil) rows)
            next))))))

(def find_conditional_rank ((rows Rows) (condition Int)) Int
  (match rows
    (LNil 0)
    ((LCons row rest)
      (match row
        ((Row rank origin formula establishment scope prerequisites)
          (match formula
            ((ConditionalEq result left right)
              (if (eq result condition) rank (find_conditional_rank rest condition)))
            (z (find_conditional_rank rest condition))))))))

(def one_arg ((arguments Ints)) Int
  (if (eq (ints_len arguments) 1) (first_int arguments) 0))

(def one_decl_id ((decls Decls)) Int
  (if (eq (ints_len (decls_ids decls)) 1) (first_decl_id decls) 0))

(def edge_id_of ((edge Edge)) Int
  (match edge ((Edge id target arguments) id)))

(def edge_target ((edge Edge)) Int
  (match edge ((Edge id target arguments) target)))

(def block_id_of ((block Block)) Int
  (match block ((Block id parameters operations term) id)))

(def block_parameters ((block Block)) Decls
  (match block ((Block id parameters operations term) parameters)))

(def block_term ((block Block)) Term
  (match block ((Block id parameters operations term) term)))

(def block_ops ((block Block)) Ops
  (match block ((Block id parameters operations term) operations)))

(def blocks_len ((blocks Blocks)) Int
  (match blocks (BLNil 0) ((BLCons h t) (+ 1 (blocks_len t)))))

(def block_at ((blocks Blocks) (index Int)) Block
  (match blocks
    (BLNil (Block 0 DNil ONil (Ret 0 0)))
    ((BLCons h t) (if (eq index 0) h (block_at t (- index 1))))))

(def jump_argument ((term Term)) Int
  (match term
    ((Jump edge) (match edge ((Edge id target arguments) (one_arg arguments))))
    (z 0)))

(def jump_edge_id ((term Term)) Int
  (match term
    ((Jump edge) (edge_id_of edge))
    (z 0)))

(def control_shape_valid
  ((condition_rank Int) (yes_target Int) (true_id Int)
   (no_target Int) (false_id Int) (yes_value Int) (no_value Int)
   (join_parameter Int)) Int
  (if (eq condition_rank 0) 0
    (if (eq yes_target true_id)
      (if (eq no_target false_id)
        (if (eq yes_value no_value) (nonzero join_parameter) 0)
        0)
      0)))

(def emit_control_rows
  ((condition Int) (yes_edge Int) (no_edge Int) (true_id Int)
   (false_id Int) (join_id Int) (condition_rank Int) (yes_value Int)
   (no_value Int) (join_parameter Int) (rank Int)) RLedger
  (RLedger
    (LCons (Row rank (BranchOrigin condition 1)
             (BranchPremise condition 1) true_id
             (UntilBlock join_id) (ICons condition_rank INil))
      (LCons (Row (+ rank 1) (BranchOrigin condition 0)
               (BranchPremise condition 0) false_id
               (UntilBlock join_id) (ICons condition_rank INil))
        (LCons (Row (+ rank 2) (EdgeOrigin yes_edge)
                 (EdgeArgument yes_edge join_parameter yes_value) true_id
                 (EdgeScope yes_edge) (ICons rank INil))
          (LCons (Row (+ rank 3) (EdgeOrigin no_edge)
                   (EdgeArgument no_edge join_parameter no_value) false_id
                   (EdgeScope no_edge) (ICons (+ rank 1) INil))
            (LCons (Row (+ rank 4) (MergeOrigin join_id)
                     (MergeEq join_parameter yes_value) join_id
                     (BlockScope join_id)
                     (ICons (+ rank 2) (ICons (+ rank 3) INil)))
              LNil)))))))

(def control_rows
  ((term Term) (true_block Block) (false_block Block) (join Block)
   (prior Rows) (rank Int)) RLedger
  (match term
    ((Cond condition yes no)
      (let true_id (block_id_of true_block)
        (let false_id (block_id_of false_block)
          (let join_id (block_id_of join)
            (let condition_rank (find_conditional_rank prior condition)
              (let yes_value (jump_argument (block_term true_block))
                (let no_value (jump_argument (block_term false_block))
                  (let join_parameter (one_decl_id (block_parameters join))
                    (let yes_edge (jump_edge_id (block_term true_block))
                      (let no_edge (jump_edge_id (block_term false_block))
                        (if (control_shape_valid condition_rank
                              (edge_target yes) true_id (edge_target no) false_id
                              yes_value no_value join_parameter)
                          (emit_control_rows condition yes_edge no_edge true_id false_id join_id
                            condition_rank yes_value no_value join_parameter rank)
                          RLedgerBad)))))))))))
    (z RLedgerBad)))

(def prerequisites_before ((prerequisites Ints) (rank Int)) Int
  (match prerequisites
    (INil 1)
    ((ICons h t) (if (lt h rank) (prerequisites_before t rank) 0))))

(def ranks_valid_from ((rows Rows) (previous Int)) Int
  (match rows
    (LNil 1)
    ((LCons row rest)
      (match row
        ((Row rank origin formula establishment scope prerequisites)
          (if (lt previous rank)
            (if (prerequisites_before prerequisites rank) (ranks_valid_from rest rank) 0)
            0))))))

(def row_available_at ((row Row) (block Int)) Int
  (match row
    ((Row rank origin formula establishment scope prerequisites)
      (match scope
        ((MachineScope machine) 1)
        ((BlockScope owner) (eq owner block))
        ((EdgeScope edge) 0)
        ((UntilBlock invalidating) (if (eq block invalidating) 0 1))))))

(def find_branch_row ((rows Rows) (truth Int)) Row
  (match rows
    (LNil (Row 0 (BranchOrigin 0 0) (BranchPremise 0 0) 0 (BlockScope 0) INil))
    ((LCons row rest)
      (match row
        ((Row rank origin formula establishment scope prerequisites)
          (match formula
            ((BranchPremise condition branch)
              (if (eq branch truth) row (find_branch_row rest truth)))
            (z (find_branch_row rest truth))))))))

(def call_requirement_code ((formula Formula)) Int
  (match formula
    ((CallRequirement operation obligation prop)
      (if (eq operation 17)
        (if (eq obligation 105)
          (if (prop_equal prop (Le (Val 11) (Lit 127))) 1 100)
          (if (eq obligation 106)
            (if (prop_equal prop (Le (Lit (- 0 128)) (Val 10))) 2 100)
            100))
        100))
    (z 0)))

(def authored_requirement_code ((formula Formula)) Int
  (match formula
    ((AuthoredRequirement machine ordinal prop)
      (if (eq machine 2)
        (if (eq ordinal 0)
          (if (prop_equal prop (Le (Val 201) (Lit 127))) 1 100)
          (if (eq ordinal 1)
            (if (prop_equal prop (Le (Lit (- 0 128)) (Val 200))) 2 100)
            100))
        100))
    (z 0)))

(def safety_code ((formula Formula)) Int
  (match formula
    ((SafetyFitsI8 obligation expr)
      (if (if (eq obligation 100) (expr_equal expr (Add (Val 10) (Val 11))) 0) 1 100))
    ((SafetyExactDiv obligation left right)
      (if (if (eq left 10) (eq right 11) 0)
        (if (eq obligation 101) 2 (if (eq obligation 102) 4 100))
        100))
    ((SafetyNonZero obligation divisor)
      (if (eq divisor 11)
        (if (eq obligation 103) 8 (if (eq obligation 104) 16 100))
        100))
    (z 0)))

(def result_code ((formula Formula)) Int
  (match formula
    ((ResultEq result expr)
      (if (eq result 20) (if (expr_equal expr (Add (Val 10) (Val 11))) 1 1000)
        (if (eq result 21) (if (expr_equal expr (WrapAdd (Val 10) (Val 11))) 2 1000)
          (if (eq result 22) (if (expr_equal expr (TzDiv (Val 10) (Val 11))) 4 1000)
            (if (eq result 23) (if (expr_equal expr (TzRem (Val 10) (Val 11))) 8 1000)
              (if (eq result 24) (if (expr_equal expr (WrapDiv (Val 10) (Val 11))) 16 1000)
                (if (eq result 25) (if (expr_equal expr (WrapRem (Val 10) (Val 11))) 32 1000)
                  (if (eq result 31) (if (expr_equal expr (WrapAdd (Val 30) (Val 11))) 128 1000)
                    1000))))))))
    ((ConditionalEq result left right)
      (if (if (eq result 26) (if (eq left 10) (eq right 11) 0) 0) 64 1000))
    (z 0)))

(def control_code ((formula Formula)) Int
  (match formula
    ((BranchPremise condition truth)
      (if (eq condition 26) (if (eq truth 1) 1 (if (eq truth 0) 2 100)) 100))
    ((EdgeArgument edge parameter value)
      (if (if (eq parameter 30) (eq value 20) 0)
        (if (eq edge 102) 4 (if (eq edge 103) 8 100))
        100))
    ((MergeEq parameter value)
      (if (if (eq parameter 30) (eq value 20) 0) 16 100))
    (z 0)))

(def formulas_code ((rows Rows) (kind Int)) Int
  (match rows
    (LNil 0)
    ((LCons row rest)
      (match row
        ((Row rank origin formula establishment scope prerequisites)
          (+ (if (eq kind 0) (call_requirement_code formula)
               (if (eq kind 1) (authored_requirement_code formula)
                 (if (eq kind 2) (safety_code formula)
                   (if (eq kind 3) (result_code formula) (control_code formula)))))
             (formulas_code rest kind)))))))

(def formulas_count ((rows Rows) (kind Int)) Int
  (match rows
    (LNil 0)
    ((LCons row rest)
      (match row
        ((Row rank origin formula establishment scope prerequisites)
          (+ (if (eq kind 0) (nonzero (call_requirement_code formula))
               (if (eq kind 1) (nonzero (authored_requirement_code formula))
                 (if (eq kind 2) (nonzero (safety_code formula))
                   (if (eq kind 3) (nonzero (result_code formula))
                     (nonzero (control_code formula))))))
             (formulas_count rest kind)))))))

(def exact_ledger_inventory ((rows Rows)) Int
  (if (eq (rows_len rows) 22)
    (if (if (eq (formulas_count rows 0) 2) (eq (formulas_code rows 0) 3) 0)
      (if (if (eq (formulas_count rows 1) 2) (eq (formulas_code rows 1) 3) 0)
        (if (if (eq (formulas_count rows 2) 5) (eq (formulas_code rows 2) 31) 0)
          (if (if (eq (formulas_count rows 3) 8) (eq (formulas_code rows 3) 255) 0)
            (if (eq (formulas_count rows 4) 5) (eq (formulas_code rows 4) 31) 0)
            0)
          0)
        0)
      0)
    0))

(def expression_size ((expr Expr)) Int
  (match expr
    ((Val id) 9) ((Lit value) 9)
    ((Add a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((TzDiv a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((TzRem a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((WrapAdd a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((WrapDiv a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((WrapRem a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((Less a b) (+ 1 (+ (expression_size a) (expression_size b))))))

(def prop_size ((prop Prop)) Int
  (match prop ((Le a b) (+ 1 (+ (expression_size a) (expression_size b))))))

(def formula_size ((formula Formula)) Int
  (match formula
    ((SafetyFitsI8 obligation expr) (+ 9 (expression_size expr)))
    ((SafetyExactDiv obligation left right) 25)
    ((SafetyNonZero obligation divisor) 17)
    ((ResultEq result expr) (+ 9 (expression_size expr)))
    ((ConditionalEq result left right) 25)
    ((BranchPremise condition truth) 17)
    ((EdgeArgument edge parameter value) 25)
    ((MergeEq parameter value) 17)
    ((AuthoredRequirement machine ordinal prop) (+ 13 (prop_size prop)))
    ((CallRequirement operation obligation prop) (+ 17 (prop_size prop)))))

(def origin_size ((origin Origin)) Int
  (match origin
    ((PrimitiveOrigin operation) 9)
    ((BranchOrigin condition truth) 17)
    ((EdgeOrigin edge) 9)
    ((MergeOrigin block) 9)
    ((CallOrigin operation ordinal) 17)))

(def scope_size ((scope Scope)) Int
  (match scope
    ((MachineScope machine) 9)
    ((BlockScope block) 9)
    ((EdgeScope edge) 9)
    ((UntilBlock block) 9)))

(def row_ledger_size ((row Row)) Int
  (match row
    ((Row rank origin formula establishment scope prerequisites)
      (+ 8 (+ (origin_size origin)
        (+ (formula_size formula)
          (+ 8 (+ (scope_size scope) (+ 4 (* 8 (ints_len prerequisites)))))))))))

(def ledger_size ((rows Rows)) Int
  (match rows (LNil 4) ((LCons row rest) (+ (row_ledger_size row) (ledger_size rest)))))

(def certificate_size ((rows Rows)) Int
  (match rows
    (LNil 32)
    ((LCons row rest)
      (match row
        ((Row rank origin formula establishment scope prerequisites)
          (+ (+ 44 (* 32 (ints_len prerequisites))) (certificate_size rest)))))))

(def empty_decls ((decls Decls)) Int
  (match decls (DNil 1) (z 0)))

(def empty_ops ((ops Ops)) Int
  (match ops (ONil 1) (z 0)))

(def empty_props ((props Props)) Int
  (match props (PNil 1) (z 0)))

(def spike_machine_shape_valid
  ((vocabulary Int) (entry Int) (caller Machine) (callee Machine)
   (entry_block Block) (callee_block Block)) Int
  (if (eq vocabulary 16)
    (if (eq entry (machine_id caller))
      (if (lt (machine_id caller) (machine_id callee))
        (if (eq (machine_entry caller) (block_id_of entry_block))
          (eq (machine_entry callee) (block_id_of callee_block))
          0)
        0)
      0)
    0))

(def spike_type_shape_valid ((caller Machine) (callee Machine)) Int
  (let caller_parameters (machine_parameters caller)
    (let callee_parameters (machine_parameters callee)
      (if (eq (ints_len (decls_ids caller_parameters)) 2)
        (if (eq (ints_len (decls_ids callee_parameters)) 2)
          (if (decls_all_i8 caller_parameters)
            (if (decls_all_i8 callee_parameters)
              (if (eq (decl_ty (machine_result caller)) 2)
                (if (eq (decl_ty (machine_result callee)) 2)
                  (empty_props (machine_requires caller))
                  0)
                0)
              0)
            0)
          0)
        0))))

(def spike_block_shape_valid
  ((entry_block Block) (true_block Block) (false_block Block)
   (callee_block Block)) Int
  (if (empty_decls (block_parameters entry_block))
    (if (empty_decls (block_parameters true_block))
      (if (empty_decls (block_parameters false_block))
        (if (empty_ops (block_ops true_block))
          (if (empty_ops (block_ops false_block))
            (empty_ops (block_ops callee_block))
            0)
          0)
        0)
      0)
    0))

(def finish_control_ledger
  ((entry_term Term) (true_block Block) (false_block Block) (join_block Block)
   (prior Rows) (rank Int)) RLedger
  (match (control_rows entry_term true_block false_block join_block prior rank)
    (RLedgerBad RLedgerBad)
    ((RLedger control)
      (let rows (rows_append prior control)
        (if (if (exact_ledger_inventory rows) (ranks_valid_from rows 0) 0)
          (let true_premise (find_branch_row rows 1)
            (if (row_available_at true_premise (block_id_of true_block))
              (if (row_available_at true_premise (block_id_of join_block))
                RLedgerBad
                (RLedger rows))
              RLedgerBad))
          RLedgerBad)))))

(def finish_authored_ledger
  ((entry_rows Rows) (join_rows Rows) (next Int) (callee Machine)
   (entry_term Term) (true_block Block) (false_block Block) (join_block Block)) RLedger
  (match (authored_requirements (machine_requires callee) (machine_id callee)
           (machine_entry callee) 0 next)
    (ReqBuildBad RLedgerBad)
    ((ReqBuilt authored_rows after_authored)
      (finish_control_ledger entry_term true_block false_block join_block
        (rows_append entry_rows (rows_append join_rows authored_rows)) after_authored))))

(def finish_join_ledger
  ((entry_rows Rows) (known Ints) (next Int) (caller Machine) (callee Machine)
   (entry_block Block) (true_block Block) (false_block Block) (join_block Block)) RLedger
  (match (build_ops (block_ops join_block)
           (ints_append (decls_ids (block_parameters join_block)) known)
           callee (machine_id caller) (block_id_of join_block) next)
    (BuildBad RLedgerBad)
    ((Built join_rows after_join final_known)
      (finish_authored_ledger entry_rows join_rows after_join callee
        (block_term entry_block) true_block false_block join_block))))

(def build_spike_ledger
  ((caller Machine) (callee Machine) (entry_block Block) (true_block Block)
   (false_block Block) (join_block Block)) RLedger
  (match (build_ops (block_ops entry_block) (decls_ids (machine_parameters caller))
           callee (machine_id caller) (block_id_of entry_block) 1)
    (BuildBad RLedgerBad)
    ((Built entry_rows next known)
      (finish_join_ledger entry_rows known next caller callee entry_block
        true_block false_block join_block))))

(def build_two_machine_ledger
  ((vocabulary Int) (entry Int) (caller Machine) (callee Machine)) RLedger
  (let caller_blocks (machine_blocks caller)
    (let callee_blocks (machine_blocks callee)
      (if (eq (blocks_len caller_blocks) 4)
        (if (eq (blocks_len callee_blocks) 1)
          (let entry_block (block_at caller_blocks 0)
            (let true_block (block_at caller_blocks 1)
              (let false_block (block_at caller_blocks 2)
                (let join_block (block_at caller_blocks 3)
                  (let callee_block (block_at callee_blocks 0)
                    (if (spike_machine_shape_valid vocabulary entry caller callee
                          entry_block callee_block)
                      (if (spike_type_shape_valid caller callee)
                        (if (spike_block_shape_valid entry_block true_block false_block callee_block)
                          (build_spike_ledger caller callee entry_block true_block false_block join_block)
                          RLedgerBad)
                        RLedgerBad)
                      RLedgerBad))))))
          RLedgerBad)
        RLedgerBad))))

(def build_module_ledger ((module Module)) RLedger
  (match module
    ((Module vocabulary entry machines)
      (if (eq (machines_len machines) 2)
        (build_two_machine_ledger vocabulary entry (machine_at machines 0) (machine_at machines 1))
        RLedgerBad))))

(def run_spike ((bytes Bytes)) Int
  (if (arithmetic_self_test)
    (match (decode_module bytes)
      (RModuleBad 0)
      ((RModule module)
        (match (build_module_ledger module)
          (RLedgerBad 0)
          ((RLedger rows) 1))))
    0))

(def measure_spike ((bytes Bytes)) Metrics
  (match (decode_module bytes)
    (RModuleBad (Metrics 0 0 0))
    ((RModule module)
      (match (build_module_ledger module)
        (RLedgerBad (Metrics 0 0 0))
        ((RLedger rows) (Metrics (rows_len rows) (ledger_size rows) (certificate_size rows)))))))
