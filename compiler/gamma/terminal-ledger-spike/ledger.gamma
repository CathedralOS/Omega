    ((BitNot operand) (+ 1 (expression_size operand)))
    ((WidenI8I16 operand) (+ 1 (expression_size operand)))
    ((CastI16I8 operand) (+ 1 (expression_size operand)))
    ((BitAnd a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((BitOr a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((BitXor a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((WrapShl a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((WrapShr a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((ExactShl a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((ExactShr a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((Add a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((Sub a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((Mul a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((TzDiv a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((TzRem a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((WrapAdd a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((SatAdd a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((WrapSub a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((SatSub a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((WrapMul a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((SatMul a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((WrapDiv a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((WrapRem a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((SatDiv a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((SatRem a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((Less a b) (+ 1 (+ (expression_size a) (expression_size b))))
    ((LessEq a b) (+ 1 (+ (expression_size a) (expression_size b))))))

