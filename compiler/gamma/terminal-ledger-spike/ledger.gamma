  (match (build_ops schemas call_schemas (block_ops entry_block)
           (machine_parameters caller) callee (machine_id caller)
           (block_id_of entry_block) 1)
    (BuildBad RLedgerBad)
    ((Built entry_rows next known)
      (finish_join_ledger schemas call_schemas entry_rows known next caller callee
        entry_block true_block false_block join_block))))

(def build_two_machine_ledger
  ((schemas LeafSchemas) (call_schemas CallSchemas) (vocabulary Int) (entry Int)
   (caller Machine) (callee Machine)) RLedger
  (let caller_blocks (machine_blocks caller)
    (let callee_blocks (machine_blocks callee)
      (if (eq (blocks_len caller_blocks) 4)
        (if (eq (blocks_len callee_blocks) 1)
          (let entry_block (block_at caller_blocks 0)
            (let true_block (block_at caller_blocks 1)
              (let false_block (block_at caller_blocks 2)
                (let join_block (block_at caller_blocks 3)
                  (let callee_block (block_at callee_blocks 0)
                    (if (spike_machine_shape_valid vocabulary entry caller callee
                          entry_block callee_block)
                      (if (spike_type_shape_valid caller callee)
                        (if (spike_block_shape_valid entry_block true_block false_block callee_block)
                          (build_spike_ledger schemas call_schemas caller callee entry_block
                            true_block false_block join_block)
                          RLedgerBad)
                        RLedgerBad)
                      RLedgerBad))))))
          RLedgerBad)
        RLedgerBad))))

(def build_module_ledger_with_tables
  ((schemas LeafSchemas) (call_schemas CallSchemas) (module Module)) RLedger
  (match module
    ((Module vocabulary entry machines)
      (if (eq (machines_len machines) 2)
        (build_two_machine_ledger schemas call_schemas vocabulary entry
          (machine_at machines 0) (machine_at machines 1))
        RLedgerBad))))

(def build_module_ledger_with_schemas ((schemas LeafSchemas) (module Module)) RLedger
  (build_module_ledger_with_tables schemas (canonical_call_schemas) module))

(def build_module_ledger ((module Module)) RLedger
  (build_module_ledger_with_tables (canonical_leaf_schemas)
    (canonical_call_schemas) module))

(def schemas_without_first () LeafSchemas
  (match (canonical_leaf_schemas)
    ((LSCons first rest) rest)
    (LSNil LSNil)))

(def schemas_with_duplicate_first () LeafSchemas
  (match (canonical_leaf_schemas)
    ((LSCons first rest) (LSCons first (LSCons first rest)))
    (LSNil LSNil)))

(def schemas_with_altered_first () LeafSchemas
  (match (canonical_leaf_schemas)
    ((LSCons first rest)
      (LSCons
        (LeafSchema LIntConst ResultI8 UnaryBooleanOperand DIntConst GoalNone FactEquation
          NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
        rest))
    (LSNil LSNil)))

(def schemas_with_altered_first_denotation () LeafSchemas
  (match (canonical_leaf_schemas)
    ((LSCons first rest)
      (LSCons
        (LeafSchema LIntConst ResultI8 IntegerLiteralPayload DWrapAdd GoalNone FactEquation
          NeverCrashes ConsumesOneFuel KeepsLocalFrontier)
        rest))
    (LSNil LSNil)))

(def schemas_with_weakened_exact_shift_left ((schemas LeafSchemas)) LeafSchemas
  (match schemas
    (LSNil LSNil)
    ((LSCons schema rest)
      (if (leaf_kind_equal (schema_kind schema) LExactShl)
        (LSCons
          (LeafSchema LExactShl ResultI8 ShiftI8ByI16Operands DExactShl GoalShiftCountI8
            FactEquation CrashesUnlessGoal ConsumesOneFuel KeepsLocalFrontier)
          rest)
        (LSCons schema (schemas_with_weakened_exact_shift_left rest))))))

(def run_spike_with_tables
  ((schemas LeafSchemas) (call_schemas CallSchemas) (bytes Bytes)) Int
  (if (arithmetic_self_test)
    (if (typed_environment_self_test)
      (if (conversion_typed_environment_self_test)
        (if (full_scalar_type_environment_self_test)
          (if (integer_literal_custody_self_test)
            (if (call_typed_environment_self_test)
              (if (call_composition_self_test)
                (match (decode_module bytes)
                  (RModuleBad 0)
                  ((RModule module)
                    (match (build_module_ledger_with_tables schemas call_schemas module)
                      (RLedgerBad 0)
                      ((RLedger rows) 1))))
                0)
              0)
            0)
          0)
        0)
      0)
    0))

(def run_spike_with_schemas ((schemas LeafSchemas) (bytes Bytes)) Int
  (run_spike_with_tables schemas (canonical_call_schemas) bytes))

(def run_spike ((bytes Bytes)) Int
  (run_spike_with_schemas (canonical_leaf_schemas) bytes))

(def schema_mutation_self_test ((bytes Bytes)) Int
  (if (run_spike_with_schemas (canonical_leaf_schemas) bytes)
    (if (eq (run_spike_with_schemas (schemas_without_first) bytes) 0)
      (if (eq (run_spike_with_schemas (schemas_with_duplicate_first) bytes) 0)
        (if (eq (run_spike_with_schemas (schemas_with_altered_first) bytes) 0)
          (if (eq (run_spike_with_schemas (schemas_with_altered_first_denotation) bytes) 0)
            (eq (run_spike_with_schemas
                  (schemas_with_weakened_exact_shift_left (canonical_leaf_schemas)) bytes) 0)
            0)
          0)
        0)
      0)
    0))

(def call_schema_mutation_self_test ((bytes Bytes)) Int
  (if (run_spike_with_tables (canonical_leaf_schemas)
        (canonical_call_schemas) bytes)
    (if (eq (run_spike_with_tables (canonical_leaf_schemas)
              (calls_without_scalar) bytes) 0)
      (if (eq (run_spike_with_tables (canonical_leaf_schemas)
                (calls_with_duplicate_scalar) bytes) 0)
        (eq (run_spike_with_tables (canonical_leaf_schemas)
              (calls_with_weakened_scalar_evidence) bytes) 0)
        0)
      0)
    0))

(def measure_spike ((bytes Bytes)) Metrics
  (match (decode_module bytes)
    (RModuleBad (Metrics 0 0 0))
    ((RModule module)
      (match (build_module_ledger module)
        (RLedgerBad (Metrics 0 0 0))
        ((RLedger rows) (Metrics (rows_len rows) (ledger_size rows) (certificate_size rows)))))))
