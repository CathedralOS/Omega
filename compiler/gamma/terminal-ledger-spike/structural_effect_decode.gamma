; Q7 structural/effect canonical-fixture decoder.
;
; These three leaves deliberately do not inhabit LeafSchema.  Scalar rows own
; mathematical result terms; these rows instead own exact place custody, live
; affine-frontier transitions, and an externally observable effect.  One small
; PSITERM v18 fixture exercises the bounded vocabulary without duplicating the
; scalar interpreter or making target layout part of terminal semantics.  The
; closed data declarations live beside the shared ledger vocabulary in
; types.gamma; this file owns byte decoding only.

(def bytes_to_ints ((bytes Bytes)) Ints
  (match bytes
    (BNil INil)
    ((B first rest) (ICons first (bytes_to_ints rest)))))

(def read_spike_identity ((bs Bytes)) RInts
  (match (read_utf8_string bs)
    (RUtf8Bad RIntsBad)
    ((RUtf8 value rest)
      (match value
        (BNil RIntsBad)
        ((B first tail) (RInts (ICons first (bytes_to_ints tail)) rest))))))

(def read_se_field ((bs Bytes)) RSEField
  (match (read_id bs)
    (RIntBad RSEFieldBad)
    ((RInt id r1)
      (match (read_spike_identity r1)
        (RIntsBad RSEFieldBad)
        ((RInts identity r2)
          (match (read_u8 r2)
            (RIntBad RSEFieldBad)
            ((RInt relevance r3)
              (match (expect_byte r3 1)
                (RBytesBad RSEFieldBad)
                ((RBytes r4)
                  (match (read_scalar_type r4)
                    (RIntBad RSEFieldBad)
                    ((RInt scalar_type rest)
                      (if (if (lt 0 relevance) (lt relevance 3) 0)
                        (RSEField (SEField id relevance scalar_type identity) rest)
                        RSEFieldBad))))))))))))

(def read_se_fields_n ((bs Bytes) (n Int)) RSEFields
  (if (eq n 0) (RSEFields SEFNil bs)
    (match (read_se_field bs)
      (RSEFieldBad RSEFieldsBad)
      ((RSEField field rest)
        (match (read_se_fields_n rest (- n 1))
          (RSEFieldsBad RSEFieldsBad)
          ((RSEFields fields end) (RSEFields (SEFCons field fields) end)))))))

(def read_se_type ((bs Bytes)) RSEType
  (match (read_id bs)
    (RIntBad RSETypeBad)
    ((RInt id r1)
      (match (read_spike_identity r1)
        (RIntsBad RSETypeBad)
        ((RInts identity r2)
          (match (expect_byte r2 1)
            (RBytesBad RSETypeBad)
            ((RBytes r3)
              (match (read_u32 r3)
                (RIntBad RSETypeBad)
                ((RInt count r4)
                  (match (read_se_fields_n r4 count)
                    (RSEFieldsBad RSETypeBad)
                    ((RSEFields fields rest)
                      (RSEType (SEType id identity fields) rest))))))))))))

(def read_se_types_n ((bs Bytes) (n Int)) RSETypes
  (if (eq n 0) (RSETypes SETNil bs)
    (match (read_se_type bs)
      (RSETypeBad RSETypesBad)
      ((RSEType structural_type rest)
        (match (read_se_types_n rest (- n 1))
          (RSETypesBad RSETypesBad)
          ((RSETypes types end) (RSETypes (SETCons structural_type types) end)))))))

(def read_se_types ((bs Bytes)) RSETypes
  (match (read_u32 bs)
    (RIntBad RSETypesBad)
    ((RInt count rest) (read_se_types_n rest count))))

(def read_se_service ((bs Bytes)) RSEService
  (match (read_id bs)
    (RIntBad RSEServiceBad)
    ((RInt id r1)
      (match (read_spike_identity r1)
        (RIntsBad RSEServiceBad)
        ((RInts identity r2)
          (match (read_ids r2)
            (RIntsBad RSEServiceBad)
            ((RInts parents rest)
              (RSEService (SEService id identity parents) rest))))))))

(def read_se_services_n ((bs Bytes) (n Int)) RSEServices
  (if (eq n 0) (RSEServices SESNil bs)
    (match (read_se_service bs)
      (RSEServiceBad RSEServicesBad)
      ((RSEService service rest)
        (match (read_se_services_n rest (- n 1))
          (RSEServicesBad RSEServicesBad)
          ((RSEServices services end) (RSEServices (SESCons service services) end)))))))

(def read_se_services ((bs Bytes)) RSEServices
  (match (read_u32 bs)
    (RIntBad RSEServicesBad)
    ((RInt count rest) (read_se_services_n rest count))))

(def read_se_parameter ((bs Bytes)) RSEParameter
  (match (read_id bs)
    (RIntBad RSEParameterBad)
    ((RInt place r1)
      (match (read_u32 r1)
        (RIntBad RSEParameterBad)
        ((RInt position r2)
          (match (read_terminal_boolean r2)
            (RIntBad RSEParameterBad)
            ((RInt is_self r3)
              (match (read_id r3)
                (RIntBad RSEParameterBad)
                ((RInt structural_type r4)
                  (match (read_u8 r4)
                    (RIntBad RSEParameterBad)
                    ((RInt multiplicity r5)
                      (match (read_ids r5)
                        (RIntsBad RSEParameterBad)
                        ((RInts qualifications rest)
                          (if (if (lt 0 multiplicity) (lt multiplicity 4) 0)
                            (RSEParameter
                              (SEParameter place position is_self structural_type
                                multiplicity qualifications) rest)
                            RSEParameterBad))))))))))))))

(def read_se_parameters_n ((bs Bytes) (n Int)) RSEParameters
  (if (eq n 0) (RSEParameters SEPNil bs)
    (match (read_se_parameter bs)
      (RSEParameterBad RSEParametersBad)
      ((RSEParameter parameter rest)
        (match (read_se_parameters_n rest (- n 1))
          (RSEParametersBad RSEParametersBad)
          ((RSEParameters parameters end)
            (RSEParameters (SEPCons parameter parameters) end)))))))

(def read_se_parameters ((bs Bytes)) RSEParameters
  (match (read_u32 bs)
    (RIntBad RSEParametersBad)
    ((RInt count rest) (read_se_parameters_n rest count))))

(def read_se_place ((bs Bytes)) RSEPlace
  (match (read_id bs)
    (RIntBad RSEPlaceBad)
    ((RInt place r1)
      (match (read_u8 r1)
        (RIntBad RSEPlaceBad)
        ((RInt tag r2)
          (if (eq tag 1)
            (match (read_u32 r2)
              (RIntBad RSEPlaceBad)
              ((RInt position r3)
                (match (read_terminal_boolean r3)
                  (RIntBad RSEPlaceBad)
                  ((RInt is_self rest)
                    (RSEPlace
                      (SEPlace place (SEParameterPlace position is_self)) rest)))))
            (if (eq tag 3)
              (match (read_u32 r2)
                (RIntBad RSEPlaceBad)
                ((RInt ordinal r3)
                  (match (read_id r3)
                    (RIntBad RSEPlaceBad)
                    ((RInt structural_type rest)
                      (RSEPlace
                        (SEPlace place (SETrivialAffineLocal ordinal structural_type)) rest)))))
              RSEPlaceBad)))))))

(def read_se_places_n ((bs Bytes) (n Int)) RSEPlaces
  (if (eq n 0) (RSEPlaces SEPlNil bs)
    (match (read_se_place bs)
      (RSEPlaceBad RSEPlacesBad)
      ((RSEPlace place rest)
        (match (read_se_places_n rest (- n 1))
          (RSEPlacesBad RSEPlacesBad)
          ((RSEPlaces places end) (RSEPlaces (SEPlCons place places) end)))))))

(def read_se_places ((bs Bytes)) RSEPlaces
  (match (read_u32 bs)
    (RIntBad RSEPlacesBad)
    ((RInt count rest) (read_se_places_n rest count))))

(def read_se_result ((bs Bytes)) RSEResult
  (match (read_u8 bs)
    (RIntBad RSEResultBad)
    ((RInt tag rest)
      (if (eq tag 0) (RSEResult SEUnitResult rest)
        (if (eq tag 1)
          (match (read_decl rest)
            (RDeclBad RSEResultBad)
            ((RDecl result end) (RSEResult (SEScalarResult result) end)))
          RSEResultBad)))))

(def read_se_op_kind ((bs Bytes)) RSEOpKind
  (match (read_u8 bs)
    (RIntBad RSEOpKindBad)
    ((RInt tag rest)
      (if (eq tag 37)
        (match (read_id rest)
          (RIntBad RSEOpKindBad)
          ((RInt destination end) (RSEOpKind (SEEstablish destination) end)))
        (if (eq tag 38)
          (match (read_id rest)
            (RIntBad RSEOpKindBad)
            ((RInt source r1)
              (match (read_id r1)
                (RIntBad RSEOpKindBad)
                ((RInt field end) (RSEOpKind (SEBooleanField source field) end)))))
          (if (eq tag 36)
            (match (read_id rest)
              (RIntBad RSEOpKindBad)
              ((RInt service r1)
                (match (read_u16 r1)
                  (RIntBad RSEOpKindBad)
                  ((RInt port r2)
                    (match (read_u8 r2)
                      (RIntBad RSEOpKindBad)
                      ((RInt value end)
                        (RSEOpKind (SEPortWrite service port value) end)))))))
            RSEOpKindBad))))))

(def read_se_op ((bs Bytes)) RSEOp
  (match (read_id bs)
    (RIntBad RSEOpBad)
    ((RInt operation r1)
      (match (read_se_result r1)
        (RSEResultBad RSEOpBad)
        ((RSEResult result r2)
          (match (read_se_op_kind r2)
            (RSEOpKindBad RSEOpBad)
            ((RSEOpKind kind rest)
              (RSEOp (SEOp operation result kind) rest))))))))

(def read_se_ops_n ((bs Bytes) (n Int)) RSEOps
  (if (eq n 0) (RSEOps SEONil bs)
    (match (read_se_op bs)
      (RSEOpBad RSEOpsBad)
      ((RSEOp operation rest)
        (match (read_se_ops_n rest (- n 1))
          (RSEOpsBad RSEOpsBad)
          ((RSEOps operations end) (RSEOps (SEOCons operation operations) end)))))))

(def read_se_ops ((bs Bytes)) RSEOps
  (match (read_u32 bs)
    (RIntBad RSEOpsBad)
    ((RInt count rest) (read_se_ops_n rest count))))

(def read_se_nominal_cleanup
  ((edge Int) (value Int) (place Int) (bs Bytes)) RSETerminator
  (match (read_id bs)
    (RIntBad RSETerminatorBad)
    ((RInt structural_type r1)
      (match (read_id r1)
        (RIntBad RSETerminatorBad)
        ((RInt cleanup_machine r2)
          (match (expect_byte r2 0)
            (RBytesBad RSETerminatorBad)
            ((RBytes r3)
              (match (expect_zero_count r3)
                (RBytesBad RSETerminatorBad)
                ((RBytes end)
                  (RSETerminator
                    (SEReturnNominal edge value place structural_type cleanup_machine)
                    end))))))))))

(def read_se_scalar_return ((edge Int) (bs Bytes)) RSETerminator
  (match (read_id bs)
    (RIntBad RSETerminatorBad)
    ((RInt value r1)
      (match (read_u32 r1)
        (RIntBad RSETerminatorBad)
        ((RInt count r2)
          (if (eq count 1)
            (match (expect_byte r2 3)
              (RBytesBad RSETerminatorBad)
              ((RBytes r3)
                (match (read_id r3)
                  (RIntBad RSETerminatorBad)
                  ((RInt place rest)
                    (read_se_nominal_cleanup edge value place rest)))))
            RSETerminatorBad))))))

(def read_se_terminator ((bs Bytes)) RSETerminator
  (match (read_u8 bs)
    (RIntBad RSETerminatorBad)
    ((RInt tag rest)
      (match (read_id rest)
        (RIntBad RSETerminatorBad)
        ((RInt edge body)
          (if (eq tag 2) (read_se_scalar_return edge body)
            (if (eq tag 5)
              (match (read_ids body)
                (RIntsBad RSETerminatorBad)
                ((RInts discards end)
                  (RSETerminator (SEReturnUnit edge discards) end)))
              RSETerminatorBad)))))))

(def read_se_block ((bs Bytes)) RSEBlock
  (match (read_id bs)
    (RIntBad RSEBlockBad)
    ((RInt id r1)
      (match (read_decls r1)
        (RDeclsBad RSEBlockBad)
        ((RDecls parameters r2)
          (match (read_se_ops r2)
            (RSEOpsBad RSEBlockBad)
            ((RSEOps operations r3)
              (match (read_se_terminator r3)
                (RSETerminatorBad RSEBlockBad)
                ((RSETerminator terminator rest)
                  (RSEBlock (SEBlock id parameters operations terminator) rest))))))))))

(def read_se_blocks_n ((bs Bytes) (n Int)) RSEBlocks
  (if (eq n 0) (RSEBlocks SEBNil bs)
    (match (read_se_block bs)
      (RSEBlockBad RSEBlocksBad)
      ((RSEBlock block rest)
        (match (read_se_blocks_n rest (- n 1))
          (RSEBlocksBad RSEBlocksBad)
          ((RSEBlocks blocks end) (RSEBlocks (SEBCons block blocks) end)))))))

(def read_se_blocks ((bs Bytes)) RSEBlocks
  (match (read_u32 bs)
    (RIntBad RSEBlocksBad)
    ((RInt count rest) (read_se_blocks_n rest count))))

(def read_optional_id ((bs Bytes)) RInt
  (match (read_optional_semantic_id bs)
    (ROptionalTerminalSemanticIdBad RIntBad)
    ((ROptionalTerminalSemanticIdNone rest) (RInt 0 rest))
    ((ROptionalTerminalSemanticIdSome identity rest)
      (narrow_spike_identity identity rest))))

(def finish_se_machine
  ((id Int) (attachment Int) (parameters Decls)
   (structural_parameters SEParameters) (result SEResult) (places SEPlaces)
   (services Ints) (bs Bytes)) RSEMachine
  (match (expect_zero_sections bs 3)
    (RBytesBad RSEMachineBad)
    ((RBytes r1)
      (match (read_id r1)
        (RIntBad RSEMachineBad)
        ((RInt entry r2)
          (match (read_se_blocks r2)
            (RSEBlocksBad RSEMachineBad)
            ((RSEBlocks blocks r3)
              (match (read_contract r3)
                (RContractBad RSEMachineBad)
                ((RContract contract rest)
                  (RSEMachine
                    (SEMachine id attachment parameters structural_parameters result
                      places services entry blocks contract)
                    rest))))))))))

(def read_se_machine_places
  ((id Int) (attachment Int) (parameters Decls)
   (structural_parameters SEParameters) (result SEResult) (bs Bytes)) RSEMachine
  (match (read_se_places bs)
    (RSEPlacesBad RSEMachineBad)
    ((RSEPlaces places r1)
      (match (expect_zero_count r1)
        (RBytesBad RSEMachineBad)
        ((RBytes r2)
          (match (read_ids r2)
            (RIntsBad RSEMachineBad)
            ((RInts services rest)
              (finish_se_machine id attachment parameters structural_parameters
                result places services rest))))))))

(def read_se_machine_signature
  ((id Int) (attachment Int) (parameters Decls) (bs Bytes)) RSEMachine
  (match (read_se_parameters bs)
    (RSEParametersBad RSEMachineBad)
    ((RSEParameters structural_parameters r1)
      (match (read_se_result r1)
        (RSEResultBad RSEMachineBad)
        ((RSEResult result rest)
          (read_se_machine_places id attachment parameters structural_parameters
            result rest))))))

(def read_se_machine ((bs Bytes)) RSEMachine
  (match (read_id bs)
    (RIntBad RSEMachineBad)
    ((RInt id r1)
      (match (read_optional_id r1)
        (RIntBad RSEMachineBad)
        ((RInt attachment r2)
          (match (read_decls r2)
            (RDeclsBad RSEMachineBad)
            ((RDecls parameters rest)
              (read_se_machine_signature id attachment parameters rest))))))))

(def read_se_machines_n ((bs Bytes) (n Int)) RSEMachines
  (if (eq n 0) (RSEMachines SEMNil bs)
    (match (read_se_machine bs)
      (RSEMachineBad RSEMachinesBad)
      ((RSEMachine machine rest)
        (match (read_se_machines_n rest (- n 1))
          (RSEMachinesBad RSEMachinesBad)
          ((RSEMachines machines end)
            (RSEMachines (SEMCons machine machines) end)))))))

(def finish_structural_effect_module
  ((vocabulary Int) (entry Int) (types SETypes)
   (services SEServices) (bs Bytes)) RSEModule
  (match (expect_zero_sections bs 8)
    (RBytesBad RSEModuleBad)
    ((RBytes r1)
      (match (read_u32 r1)
        (RIntBad RSEModuleBad)
        ((RInt count r2)
          (match (read_se_machines_n r2 count)
            (RSEMachinesBad RSEModuleBad)
            ((RSEMachines machines end)
              (if (match end (BNil 1) (z 0))
                (RSEModule (SEModule vocabulary entry types services machines))
                RSEModuleBad))))))))

(def read_structural_effect_sections
  ((vocabulary Int) (entry Int) (types SETypes) (bs Bytes)) RSEModule
  (match (expect_zero_count bs)
    (RBytesBad RSEModuleBad)
    ((RBytes r1)
      (match (read_se_services r1)
        (RSEServicesBad RSEModuleBad)
        ((RSEServices services rest)
          (finish_structural_effect_module vocabulary entry types services rest))))))

(def decode_structural_effect_module ((bs Bytes)) RSEModule
  (match (read_terminal_header bs)
    (RTerminalHeaderBad RSEModuleBad)
    ((RTerminalHeader vocabulary r1)
      (match (read_id r1)
        (RIntBad RSEModuleBad)
        ((RInt entry r2)
          (match (read_se_types r2)
            (RSETypesBad RSEModuleBad)
            ((RSETypes types rest)
              (read_structural_effect_sections vocabulary entry types rest))))))))
