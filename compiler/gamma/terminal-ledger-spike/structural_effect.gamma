; Q7 structural/effect leaf schemas and canonical ledger evaluation.
;
; Exact artifact decoding is isolated in structural_effect_decode.gamma. This
; module owns the three closed policy rows, their place/frontier/effect custody,
; canonical row publication, mutation tests, and measurements.

(def canonical_structural_effect_schemas () SESchemas
  (SELSCons
    (SESchema SELBooleanField SEBooleanResult SEExactLiveBooleanField
      SEReadBooleanField SENoExternalEffect ConsumesOneFuel
      SERequiresKeepsAffinePlace)
    (SELSCons
      (SESchema SELPortWrite SEUnitSemanticResult SEExactPublishedService
        SEEmitPortWrite SEPortWriteExternalEffect ConsumesOneFuel
        SEKeepsPlaceFrontier)
      (SELSCons
        (SESchema SELEstablish SEUnitSemanticResult SEExactEmptyAffineLocal
          SEEstablishAffinePlace SENoExternalEffect ConsumesOneFuel
          SEAddsAffinePlace)
        SELSNil))))

(def se_kind_equal ((left SEKind) (right SEKind)) Int
  (match left
    (SELBooleanField (match right (SELBooleanField 1) (z 0)))
    (SELPortWrite (match right (SELPortWrite 1) (z 0)))
    (SELEstablish (match right (SELEstablish 1) (z 0)))))

(def se_schema_kind ((schema SESchema)) SEKind
  (match schema
    ((SESchema kind result custody action effect fuel frontier) kind)))

(def merge_se_schema ((schema SESchema) (want SEKind) (tail RSESchema)) RSESchema
  (if (se_kind_equal (se_schema_kind schema) want)
    (match tail
      (SESchemaMissing (SESchemaFound schema))
      (z SESchemaDuplicate))
    tail))

(def find_se_schema ((schemas SESchemas) (want SEKind)) RSESchema
  (match schemas
    (SELSNil SESchemaMissing)
    ((SELSCons first rest)
      (match rest
        (SELSNil (merge_se_schema first want SESchemaMissing))
        ((SELSCons second tail)
          (merge_se_schema first want
            (merge_se_schema second want (find_se_schema tail want))))))))

(def se_fields_len ((fields SEFields)) Int
  (match fields (SEFNil 0) ((SEFCons field rest) (+ 1 (se_fields_len rest)))))

(def se_types_len ((types SETypes)) Int
  (match types (SETNil 0) ((SETCons structural_type rest) (+ 1 (se_types_len rest)))))

(def se_services_len ((services SEServices)) Int
  (match services (SESNil 0) ((SESCons service rest) (+ 1 (se_services_len rest)))))

(def se_machines_len ((machines SEMachines)) Int
  (match machines (SEMNil 0) ((SEMCons machine rest) (+ 1 (se_machines_len rest)))))

(def se_machine_at ((machines SEMachines) (index Int)) SEMachine
  (match machines
    (SEMNil
      (SEMachine 0 0 DNil SEPNil SEUnitResult SEPlNil INil 0 SEBNil
        (Contract 0 PNil)))
    ((SEMCons machine rest)
      (if (eq index 0) machine (se_machine_at rest (- index 1))))))

(def se_block_at ((blocks SEBlocks) (index Int)) SEBlock
  (match blocks
    (SEBNil (SEBlock 0 DNil SEONil (SEReturnUnit 0 INil)))
    ((SEBCons block rest) (if (eq index 0) block (se_block_at rest (- index 1))))))

(def se_empty_ints ((values Ints)) Int (match values (INil 1) (z 0)))
(def se_empty_parameters ((values SEParameters)) Int (match values (SEPNil 1) (z 0)))
(def se_empty_places ((values SEPlaces)) Int (match values (SEPlNil 1) (z 0)))
(def se_empty_ops ((values SEOps)) Int (match values (SEONil 1) (z 0)))
(def se_empty_blocks ((values SEBlocks)) Int (match values (SEBNil 1) (z 0)))

(def se_boolean_field_shape ((field SEField)) Int
  (match field
    ((SEField id relevance scalar_type identity)
      (if (if (eq id 1) (eq relevance 1) 0)
        (if (eq scalar_type 1) (nonzero (ints_len identity)) 0)
        0))))

(def se_boolean_fields_shape ((fields SEFields)) Int
  (match fields
    ((SEFCons field rest)
      (match rest
        (SEFNil (se_boolean_field_shape field))
        (z 0)))
    (z 0)))

(def se_boolean_type_shape ((structural_type SEType)) Int
  (match structural_type
    ((SEType id identity fields)
      (if (eq id 1)
        (if (nonzero (ints_len identity)) (se_boolean_fields_shape fields) 0)
        0))))

(def se_empty_type_shape ((structural_type SEType)) Int
  (match structural_type
    ((SEType id identity fields)
      (if (eq id 2)
        (if (nonzero (ints_len identity)) (eq (se_fields_len fields) 0) 0)
        0))))

(def se_exact_type_shape ((types SETypes)) Int
  (match types
    ((SETCons first rest)
      (match rest
        ((SETCons second tail)
          (match tail
            (SETNil
              (if (se_boolean_type_shape first) (se_empty_type_shape second) 0))
            (z 0)))
        (z 0)))
    (z 0)))

(def se_exact_service_shape ((services SEServices)) Int
  (match services
    ((SESCons service rest)
      (match rest
        (SESNil
          (match service
            ((SEService id identity parents)
              (if (eq id 1)
                (if (nonzero (ints_len identity)) (se_empty_ints parents) 0)
                0))))
        (z 0)))
    (z 0)))

(def blocks_len_as_se ((blocks SEBlocks)) Int
  (match blocks (SEBNil 0) ((SEBCons block rest) (+ 1 (blocks_len_as_se rest)))))

(def machine_contract_requires ((contract Contract)) Props
  (match contract ((Contract id requires) requires)))

(def se_entry_parameter_shape ((parameters SEParameters)) Int
  (match parameters
    ((SEPCons parameter rest)
      (match rest
        (SEPNil
          (match parameter
            ((SEParameter place position is_self structural_type multiplicity qualifications)
              (if (if (eq place 1) (eq position 0) 0)
                (if (if (eq is_self 0) (eq structural_type 1) 0)
                  (if (eq multiplicity 2) (se_empty_ints qualifications) 0)
                  0)
                0))))
        (z 0)))
    (z 0)))

(def se_entry_result_place_shape ((result SEResult) (places SEPlaces)) Int
  (match result
    ((SEScalarResult declaration)
      (if (decls_has_exact
            (DCons declaration DNil) 11 (spike_boolean_type))
        (match places
          ((SEPlCons place rest)
            (match rest
              (SEPlNil
                (match place
                  ((SEPlace root kind)
                    (match kind
                      ((SEParameterPlace position is_self)
                        (if (if (eq root 1) (eq position 0) 0) (eq is_self 0) 0))
                      (z 0)))))
              (z 0)))
          (z 0))
        0))
    (z 0)))

(def se_entry_shape ((machine SEMachine)) Int
  (match machine
    ((SEMachine id attachment parameters structural_parameters result places services
      entry blocks contract)
      (if (if (eq id 1) (eq attachment 0) 0)
        (if (if (eq (decls_len parameters) 1)
              (decls_has_exact parameters 10 (spike_boolean_type)) 0)
          (if (se_entry_parameter_shape structural_parameters)
            (if (se_entry_result_place_shape result places)
              (if (if (eq (ints_len services) 1) (ints_has services 1) 0)
                (if (if (eq entry 10) (eq (blocks_len_as_se blocks) 1) 0)
                  (empty_props (machine_contract_requires contract))
                  0)
                0)
              0)
            0)
          0)
        0))))

(def se_boolean_schema_valid ((schemas SESchemas)) Int
  (match (find_se_schema schemas SELBooleanField)
    ((SESchemaFound schema)
      (match schema
        ((SESchema kind result custody action effect fuel frontier)
          (if (se_kind_equal kind SELBooleanField)
            (match result
              (SEBooleanResult
                (match custody
                  (SEExactLiveBooleanField
                    (match action
                      (SEReadBooleanField
                        (match effect
                          (SENoExternalEffect
                            (match fuel
                              (ConsumesOneFuel
                                (match frontier (SERequiresKeepsAffinePlace 1) (z 0)))
                              (z 0)))
                          (z 0)))
                      (z 0)))
                  (z 0)))
              (z 0))
            0))))
    (z 0)))

(def se_port_schema_valid ((schemas SESchemas)) Int
  (match (find_se_schema schemas SELPortWrite)
    ((SESchemaFound schema)
      (match schema
        ((SESchema kind result custody action effect fuel frontier)
          (if (se_kind_equal kind SELPortWrite)
            (match result
              (SEUnitSemanticResult
                (match custody
                  (SEExactPublishedService
                    (match action
                      (SEEmitPortWrite
                        (match effect
                          (SEPortWriteExternalEffect
                            (match fuel
                              (ConsumesOneFuel
                                (match frontier (SEKeepsPlaceFrontier 1) (z 0)))
                              (z 0)))
                          (z 0)))
                      (z 0)))
                  (z 0)))
              (z 0))
            0))))
    (z 0)))

(def se_boolean_field_result_valid ((result SEResult)) Int
  (match result
    ((SEScalarResult declaration)
      (decls_has_exact
        (DCons declaration DNil) 12 (spike_boolean_type)))
    (z 0)))

(def se_boolean_field_operation_valid ((operation SEOp)) Int
  (match operation
    ((SEOp id result kind)
      (match kind
        ((SEBooleanField source field)
          (if (if (eq id 10) (eq source 1) 0)
            (if (eq field 1) (se_boolean_field_result_valid result) 0)
            0))
        (z 0)))))

(def se_port_write_operation_valid ((operation SEOp)) Int
  (match operation
    ((SEOp id result kind)
      (match kind
        ((SEPortWrite service port value)
          (if (if (eq id 11) (eq service 1) 0)
            (if (if (eq port 1016) (eq value 75) 0)
              (match result (SEUnitResult 1) (z 0))
              0)
            0))
        (z 0)))))

(def se_entry_operations_valid ((operations SEOps)) Int
  (match operations
    ((SEOCons first rest)
      (match rest
        ((SEOCons second tail)
          (match tail
            (SEONil
              (if (se_boolean_field_operation_valid first)
                (se_port_write_operation_valid second) 0))
            (z 0)))
        (z 0)))
    (z 0)))

(def se_entry_terminator_valid ((terminator SETerminator)) Int
  (match terminator
    ((SEReturnNominal edge value place structural_type cleanup_machine)
      (if (if (eq edge 10) (eq value 12) 0)
        (if (if (eq place 1) (eq structural_type 1) 0)
          (eq cleanup_machine 3)
          0)
        0))
    (z 0)))

(def se_entry_rows ((schemas SESchemas) (machine SEMachine) (rank Int)) RLedger
  (match machine
    ((SEMachine id attachment parameters structural_parameters result places services
      entry blocks contract)
      (match (se_block_at blocks 0)
        ((SEBlock block block_parameters operations terminator)
          (if (if (se_boolean_schema_valid schemas) (se_port_schema_valid schemas) 0)
            (if (if (empty_decls block_parameters) (se_entry_operations_valid operations) 0)
              (if (se_entry_terminator_valid terminator)
                (RLedger
                  (LCons
                    (Row rank (PrimitiveOrigin 10)
                      (StructuralFieldEq 12 1 1) block (MachineScope id) INil)
                    (LCons
                      (Row (+ rank 1) (PrimitiveOrigin 11)
                        (PortWriteEffect 1 1016 75) block (MachineScope id) INil)
                      LNil)))
                RLedgerBad)
              RLedgerBad)
            RLedgerBad))))))

(def se_exact_establish_place_kind ((kind SEPlaceKind)) Int
  (match kind
    ((SETrivialAffineLocal ordinal structural_type)
      (if (eq ordinal 0) (eq structural_type 2) 0))
    (z 0)))

(def se_exact_establish_place ((place SEPlace)) Int
  (match place
    ((SEPlace id kind)
      (if (eq id 2) (se_exact_establish_place_kind kind) 0))))

(def se_exact_establish_places ((places SEPlaces)) Int
  (match places
    ((SEPlCons place rest)
      (match rest
        (SEPlNil (se_exact_establish_place place))
        (z 0)))
    (z 0)))

(def se_establish_machine_tail_valid
  ((places SEPlaces) (services Ints) (entry Int) (blocks SEBlocks)
    (contract Contract)) Int
  (if (se_exact_establish_places places)
    (if (se_empty_ints services)
      (if (if (eq entry 20) (eq (blocks_len_as_se blocks) 1) 0)
        (empty_props (machine_contract_requires contract))
        0)
      0)
    0))

(def se_establish_shape ((machine SEMachine)) Int
  (match machine
    ((SEMachine id attachment parameters structural_parameters result places services
      entry blocks contract)
      (if (if (eq id 2) (eq attachment 0) 0)
        (if (if (empty_decls parameters) (se_empty_parameters structural_parameters) 0)
          (match result
            (SEUnitResult
              (se_establish_machine_tail_valid places services entry blocks contract))
            (z 0))
          0)
        0))))

(def se_establish_schema_valid ((schemas SESchemas)) Int
  (match (find_se_schema schemas SELEstablish)
    ((SESchemaFound schema)
      (match schema
        ((SESchema kind result custody action effect fuel frontier)
          (if (se_kind_equal kind SELEstablish)
            (match result
              (SEUnitSemanticResult
                (match custody
                  (SEExactEmptyAffineLocal
                    (match action
                      (SEEstablishAffinePlace
                        (match effect
                          (SENoExternalEffect
                            (match fuel
                              (ConsumesOneFuel
                                (match frontier (SEAddsAffinePlace 1) (z 0)))
                              (z 0)))
                          (z 0)))
                      (z 0)))
                  (z 0)))
              (z 0))
            0))))
    (z 0)))

(def se_establish_terminator_valid
  ((terminator SETerminator) (edge Int) (destination Int)) Int
  (match terminator
    ((SEReturnUnit actual_edge discards)
      (if (eq actual_edge edge)
        (if (eq (ints_len discards) 1) (ints_has discards destination) 0)
        0))
    (z 0)))

(def se_establish_kind_valid
  ((kind SEOpKind) (operation Int) (terminator SETerminator)) Int
  (match kind
    ((SEEstablish destination)
      (if (if (eq operation 20) (eq destination 2) 0)
        (se_establish_terminator_valid terminator operation destination)
        0))
    (z 0)))

(def se_establish_operation_valid
  ((operation SEOp) (terminator SETerminator)) Int
  (match operation
    ((SEOp id result kind)
      (match result
        (SEUnitResult (se_establish_kind_valid kind id terminator))
        (z 0)))))

(def se_establish_operations_valid
  ((operations SEOps) (terminator SETerminator)) Int
  (match operations
    ((SEOCons operation rest)
      (match rest
        (SEONil (se_establish_operation_valid operation terminator))
        (z 0)))
    (z 0)))

(def se_establish_body_valid ((block SEBlock)) Int
  (match block
    ((SEBlock id parameters operations terminator)
      (if (empty_decls parameters)
        (se_establish_operations_valid operations terminator)
        0))))

(def se_establish_row ((schemas SESchemas) (machine SEMachine) (rank Int)) RLedger
  (if (if (se_establish_shape machine) (se_establish_schema_valid schemas) 0)
    (match machine
      ((SEMachine id attachment parameters structural_parameters result places services
        entry blocks contract)
        (let block (se_block_at blocks 0)
          (if (se_establish_body_valid block)
            (RLedger
              (LCons
                (Row rank (PrimitiveOrigin 20)
                  (AffinePlaceEstablished 2 2) entry (MachineScope id) INil)
                LNil))
            RLedgerBad))))
    RLedgerBad))

(def se_cleanup_shape ((machine SEMachine)) Int
  (match machine
    ((SEMachine id attachment parameters structural_parameters result places services
      entry blocks contract)
      (if (if (eq id 3) (eq attachment 1) 0)
        (if (if (empty_decls parameters) (se_empty_parameters structural_parameters) 0)
          (if (se_empty_places places)
            (if (se_empty_ints services)
              (match result
                (SEUnitResult
                  (if (if (eq entry 30) (eq (blocks_len_as_se blocks) 1) 0)
                    (match (se_block_at blocks 0)
                      ((SEBlock block block_parameters operations terminator)
                        (if (if (empty_decls block_parameters) (se_empty_ops operations) 0)
                          (match terminator
                            ((SEReturnUnit edge discards) (se_empty_ints discards))
                            (z 0))
                          0)))
                    0))
                (z 0))
              0)
            0)
          0)
        0))))

(def structural_effect_formula_code ((formula Formula)) Int
  (match formula
    ((StructuralFieldEq result source field)
      (if (if (eq result 12) (eq source 1) 0) (if (eq field 1) 1 100) 100))
    ((PortWriteEffect service port value)
      (if (if (eq service 1) (eq port 1016) 0) (if (eq value 75) 2 100) 100))
    ((AffinePlaceEstablished place structural_type)
      (if (if (eq place 2) (eq structural_type 2) 0) 4 100))
    (z 0)))

(def structural_effect_formula_count ((rows Rows)) Int
  (match rows
    (LNil 0)
    ((LCons row rest)
      (match row
        ((Row rank origin formula establishment scope prerequisites)
          (+ (nonzero (structural_effect_formula_code formula))
            (structural_effect_formula_count rest)))))))

(def structural_effect_formula_sum ((rows Rows)) Int
  (match rows
    (LNil 0)
    ((LCons row rest)
      (match row
        ((Row rank origin formula establishment scope prerequisites)
          (+ (structural_effect_formula_code formula)
            (structural_effect_formula_sum rest)))))))

(def structural_effect_rows_valid ((rows Rows)) Int
  (if (eq (rows_len rows) 3)
    (if (eq (structural_effect_formula_count rows) 3)
      (if (eq (structural_effect_formula_sum rows) 7) (ranks_valid_from rows 0) 0)
      0)
    0))

(def combine_structural_effect_rows
  ((schemas SESchemas) (entry_machine SEMachine) (establish_machine SEMachine)) RLedger
  (match (se_entry_rows schemas entry_machine 1)
    (RLedgerBad RLedgerBad)
    ((RLedger entry_rows)
      (match (se_establish_row schemas establish_machine 3)
        (RLedgerBad RLedgerBad)
        ((RLedger establish_rows)
          (let rows (rows_append entry_rows establish_rows)
            (if (structural_effect_rows_valid rows) (RLedger rows) RLedgerBad)))))))

(def build_structural_effect_machine_rows
  ((schemas SESchemas) (machines SEMachines)) RLedger
  (if (eq (se_machines_len machines) 3)
    (let entry_machine (se_machine_at machines 0)
      (let establish_machine (se_machine_at machines 1)
        (let cleanup_machine (se_machine_at machines 2)
          (if (if (se_entry_shape entry_machine) (se_establish_shape establish_machine) 0)
            (if (se_cleanup_shape cleanup_machine)
              (combine_structural_effect_rows schemas entry_machine establish_machine)
              RLedgerBad)
            RLedgerBad))))
    RLedgerBad))

(def build_structural_effect_ledger_with_schemas
  ((schemas SESchemas) (module SEModule)) RLedger
  (match module
    ((SEModule vocabulary entry types services machines)
      (if (if (eq vocabulary 20) (eq entry 1) 0)
        (if (if (se_exact_type_shape types) (se_exact_service_shape services) 0)
          (build_structural_effect_machine_rows schemas machines)
          RLedgerBad)
        RLedgerBad))))

(def structural_effect_schemas_without_first () SESchemas
  (match (canonical_structural_effect_schemas)
    ((SELSCons first rest) rest)
    (SELSNil SELSNil)))

(def structural_effect_schemas_with_duplicate_first () SESchemas
  (match (canonical_structural_effect_schemas)
    ((SELSCons first rest) (SELSCons first (SELSCons first rest)))
    (SELSNil SELSNil)))

(def structural_effect_schemas_with_weakened_frontier () SESchemas
  (match (canonical_structural_effect_schemas)
    ((SELSCons first rest)
      (SELSCons
        (SESchema SELBooleanField SEBooleanResult SEExactLiveBooleanField
          SEReadBooleanField SENoExternalEffect ConsumesOneFuel
          SEKeepsPlaceFrontier)
        rest))
    (SELSNil SELSNil)))

(def run_structural_effect_spike_with_schemas ((schemas SESchemas) (bytes Bytes)) Int
  (match (decode_structural_effect_module bytes)
    (RSEModuleBad 0)
    ((RSEModule module)
      (match (build_structural_effect_ledger_with_schemas schemas module)
        (RLedgerBad 0)
        ((RLedger rows) 1)))))

(def run_structural_effect_spike ((bytes Bytes)) Int
  (run_structural_effect_spike_with_schemas
    (canonical_structural_effect_schemas) bytes))

(def structural_effect_schema_mutation_self_test ((bytes Bytes)) Int
  (if (run_structural_effect_spike bytes)
    (if (eq (run_structural_effect_spike_with_schemas
          (structural_effect_schemas_without_first) bytes) 0)
      (if (eq (run_structural_effect_spike_with_schemas
            (structural_effect_schemas_with_duplicate_first) bytes) 0)
        (eq (run_structural_effect_spike_with_schemas
              (structural_effect_schemas_with_weakened_frontier) bytes) 0)
        0)
      0)
    0))

(def measure_structural_effect_spike ((bytes Bytes)) Metrics
  (match (decode_structural_effect_module bytes)
    (RSEModuleBad (Metrics 0 0 0))
    ((RSEModule module)
      (match (build_structural_effect_ledger_with_schemas
              (canonical_structural_effect_schemas) module)
        (RLedgerBad (Metrics 0 0 0))
        ((RLedger rows)
          (Metrics (rows_len rows) (ledger_size rows)
            (certificate_size rows)))))))
