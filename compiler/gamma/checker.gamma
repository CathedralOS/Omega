; checker.gamma — the proof kernel's core, in Gamma.  THE PAYOFF OF THE RUNG.
;
; The same checker as bootstrap/assurance/proof-kernel/check.beta — full intuitionistic propositional
; logic (-> & + bot) PLUS equality of Peano terms with the conversion rule — but
; where check.beta hand-encodes term/type trees as tagged 3-word memory nodes and
; decides everything with if-cascades on integer tags (~350 lines), here they are
; ALGEBRAIC DATA + PATTERN MATCHING: a dozen tiny functions, no manual memory, no
; tags. That contrast IS why the Gamma rung exists (proof_kernel.md: "the checker is a
; Gamma program — small, audited"; gamma.md: ADTs + match keep it small).
;
; Types: (Atom n) | (Arrow a b) | (And a b) | (Or a b) | Bot | (Eq t1 t2) | Bad
;      | (All body) | (Exists body) | (Pred id nat) | (Rel id nat nat)  ; ∀ ∃ + atoms
; Terms: (Hyp n) | (Lam ty body) | (App f a) | (Pair a b) | (Fst p) | (Snd p)
;      | (Inl bty p) | (Inr aty p) | (Case p f g) | (Absurd cty p) | (Refl nat)
;      | (Gen pf) | (Inst pf nat) | (Wit body nat pf) | (Unpack epf handler)  ; ∀/∃
; Peano (inside Eq/Refl/Pred):  Ze | (Su x) | (Pl a b) | (Mu a b) | (Iv k)  ; Iv=indiv var
; Context: a list  Nil | (Cons ty rest)   (de Bruijn: Hyp 0 is the innermost).
; infer returns a type (or Bad); check = "the inferred type equals the goal".
;
; Run via the Gamma reference interpreter (interp.beta) by appending a goal, e.g.:
;   ...defs...  (check (Lam (Atom 0) (Hyp 0)) (Arrow (Atom 0) (Atom 0)))   -> 1
; the identity proof  λx:P. x  of  P -> P.

(def nth (ctx n)
  (match ctx
    (Nil Bad)
    ((Cons h t) (if (eq n 0) h (nth t (- n 1))))))

; Peano normalization (the conversion rule's engine): Pl reduced away.
; padd/pmul keep a STUCK left operand (an Iv, i.e. an open term) as Pl/Mu, exactly as
; check.beta's normalize does — so open Peano terms like n+0 have a normal form.
(def padd (a b) (match a (Ze b) ((Su x) (Su (padd x b))) (z (Pl a b))))
(def pmul (a b) (match a (Ze Ze) ((Su x) (padd b (pmul x b))) (z (Mu a b))))
(def lapp (a b) (match a (Lnil b) ((Lcons h t) (Lcons h (lapp t b))) (z (Lapp a b))))
(def llen (l) (match l (Lnil Ze) ((Lcons h t) (Su (llen t))) (z (Llen l))))
; ---- user-defined recursive functions: (Fapp arg ruleA ruleB) carries its rules INLINE
; (the pure-functional analogue of check.beta's (fid,cid) table). finst instantiates a
; rule body: (Iv 0) -> the constructor field, (Reccall 0) -> the recursive call (re-
; attaching the same rules). A function reduces only on a constructor head; else STUCK.
; (Iv 0/1) -> field a0/a1 ; (Par k) -> the extra (2nd) argument ; (Reccall 0/1) -> the
; recursive call on a0/a1, re-bundling extra when binary. extra = Bad means unary.
(def finst (body a0 a1 extra rA rB)
  (match body
    ((Iv k) (if (eq k 0) a0 (if (eq k 1) a1 body)))
    ((Par k) extra)
    ((Reccall i) (let fld (if (eq i 0) a0 a1) (match extra (Bad (Fapp fld rA rB)) (z (Fapp (Fbundle fld extra) rA rB)))))
    (Ze Ze) ((Su x) (Su (finst x a0 a1 extra rA rB)))
    ((Pl a b) (Pl (finst a a0 a1 extra rA rB) (finst b a0 a1 extra rA rB)))
    ((Mu a b) (Mu (finst a a0 a1 extra rA rB) (finst b a0 a1 extra rA rB)))
    (Lnil Lnil) ((Lcons a b) (Lcons (finst a a0 a1 extra rA rB) (finst b a0 a1 extra rA rB)))
    ((Lapp a b) (Lapp (finst a a0 a1 extra rA rB) (finst b a0 a1 extra rA rB)))
    ((Llen a) (Llen (finst a a0 a1 extra rA rB))) ((Con q) (Con q))
    ((Apply f g) (Apply (finst f a0 a1 extra rA rB) (finst g a0 a1 extra rA rB)))
    ((Fbundle x y) (Fbundle (finst x a0 a1 extra rA rB) (finst y a0 a1 extra rA rB)))
    ((Fapp a x y) (Fapp (finst a a0 a1 extra rA rB) x y))
    (z body)))
(def rfind (cid r)                 ; search one rule position: an (Frule ..) leaf or an (Fmore r1 r2)
  (match r                         ; chain (functions with MORE than two rules, e.g. 3-constructor
    ((Frule ca ba) (if (eq cid ca) ba Bad))                        ; binary-numeral dispatch)
    ((Fmore r1 r2) (let bd (rfind cid r1) (match bd (Bad (rfind cid r2)) (z bd))))
    (z Bad)))
(def frule (cid rA rB)             ; the rule body firing on cid, or Bad if no rule fires
  (let bd (rfind cid rA) (match bd (Bad (rfind cid rB)) (z bd))))
(def freb (na extra rA rB)         ; reconstruct a STUCK application (unary or binary)
  (match extra (Bad (Fapp na rA rB)) (z (Fapp (Fbundle na extra) rA rB))))
(def ffire (na extra rA rB)        ; na = normalized scrutinee — fire the matching rule, else STUCK
  (match na
    ((Con cid) (let bd (frule cid rA rB) (match bd (Bad (freb na extra rA rB)) (z (pnorm (finst bd Ze Ze extra rA rB))))))
    ((Apply h x)
      (match h
        ((Con cid) (let bd (frule cid rA rB) (match bd (Bad (freb na extra rA rB)) (z (pnorm (finst bd x Ze extra rA rB))))))
        ((Apply h2 a0) (match h2 ((Con cid) (let bd (frule cid rA rB) (match bd (Bad (freb na extra rA rB)) (z (pnorm (finst bd a0 x extra rA rB)))))) (z (freb na extra rA rB))))
        (z (freb na extra rA rB))))
    (z (freb na extra rA rB))))

; ---- table-carrying user functions: (Fap tab gid arg) — the pure-functional analogue of check.beta's
; GLOBAL (fid,cid) rule table, needed for MUTUALLY recursive families (binary-numeral badd/bmul), where
; the inline-rules Fapp above would have to inline forever. tab = (Tcons (Trule gid cid body) rest)/Tnil
; rides every application and is re-attached by Reccall (self) and Fcall/Fcall2 (cross-function) alike.
(def tfind (tab gid cid)
  (match tab
    ((Tcons r rest) (match r ((Trule g c b) (if (eq g gid) (if (eq c cid) b (tfind rest gid cid)) (tfind rest gid cid))) (z Bad)))
    (z Bad)))
(def finst2 (body a0 a1 extra tab gid)
  (match body
    ((Iv k) (if (eq k 0) a0 (if (eq k 1) a1 body)))
    ((Par k) extra)
    ((Reccall i) (let fld (if (eq i 0) a0 a1) (match extra (Bad (Fap tab gid fld)) (z (Fap tab gid (Fbundle fld extra))))))
    ((Recx i e) (let fld (if (eq i 0) a0 a1) (Fap tab gid (Fbundle fld (finst2 e a0 a1 extra tab gid)))))
    ((Fcall g e) (Fap tab g (finst2 e a0 a1 extra tab gid)))
    ((Fcall2 g x y) (Fap tab g (Fbundle (finst2 x a0 a1 extra tab gid) (finst2 y a0 a1 extra tab gid))))
    (Ze Ze) ((Su x) (Su (finst2 x a0 a1 extra tab gid)))
    ((Pl a b) (Pl (finst2 a a0 a1 extra tab gid) (finst2 b a0 a1 extra tab gid)))
    ((Mu a b) (Mu (finst2 a a0 a1 extra tab gid) (finst2 b a0 a1 extra tab gid)))
    ((Con q) (Con q))
    ((Apply f g) (Apply (finst2 f a0 a1 extra tab gid) (finst2 g a0 a1 extra tab gid)))
    ((Fbundle x y) (Fbundle (finst2 x a0 a1 extra tab gid) (finst2 y a0 a1 extra tab gid)))
    (z body)))
(def freb2 (na extra tab gid)      ; reconstruct a STUCK table application (unary or binary)
  (match extra (Bad (Fap tab gid na)) (z (Fap tab gid (Fbundle na extra)))))
(def ffire2 (na extra tab gid)     ; na = normalized scrutinee — fire the (gid, cid) rule, else STUCK
  (match na
    ((Con cid) (let bd (tfind tab gid cid) (match bd (Bad (freb2 na extra tab gid)) (z (pnorm (finst2 bd Ze Ze extra tab gid))))))
    ((Apply h x)
      (match h
        ((Con cid) (let bd (tfind tab gid cid) (match bd (Bad (freb2 na extra tab gid)) (z (pnorm (finst2 bd x Ze extra tab gid))))))
        ((Apply h2 a0) (match h2 ((Con cid) (let bd (tfind tab gid cid) (match bd (Bad (freb2 na extra tab gid)) (z (pnorm (finst2 bd a0 x extra tab gid)))))) (z (freb2 na extra tab gid))))
        (z (freb2 na extra tab gid))))
    (z (freb2 na extra tab gid))))
(def pnorm (t)                     ; Nat (Ze/Su/Pl/Mu), (Iv k) indiv var, Lists (Lnil/Lcons/Lapp)
  (match t
    (Ze Ze)
    ((Su x) (Su (pnorm x)))
    ((Iv k) (Iv k))
    ((Pl a b) (padd (pnorm a) (pnorm b)))
    ((Mu a b) (pmul (pnorm a) (pnorm b)))
    (Lnil Lnil)
    ((Lcons h t) (Lcons (pnorm h) (pnorm t)))
    ((Lapp a b) (lapp (pnorm a) (pnorm b)))
    ((Llen l) (llen (pnorm l))) ((Con q) (Con q)) ((Apply f g) (Apply (pnorm f) (pnorm g)))
    ((Fapp arg rA rB)              ; (Fbundle x y) arg = BINARY (extra y); else unary. pnorm BOTH x and the
      (match arg                   ; extra y: a stuck binary application (x symbolic) must still normalize its
        ((Fbundle x y) (ffire (pnorm x) (pnorm y) rA rB))   ; extra, or a reducible accumulator (e.g. fst of a
        (z (ffire (pnorm arg) Bad rA rB))))                 ; pair, in a two-accumulator fold) stays stuck here
    ((Fap tab gid arg)             ; while check.beta reduces it -- the two checkers would then disagree.
      (match arg
        ((Fbundle x y) (ffire2 (pnorm x) (pnorm y) tab gid))
        (z (ffire2 (pnorm arg) Bad tab gid))))))
(def nateq (a b)                   ; structural — incl. stuck Pl/Mu (open normal forms)
  (match a
    (Ze (match b (Ze 1) (z 0)))
    ((Iv k) (match b ((Iv j) (eq k j)) (z 0)))
    ((Su x) (match b ((Su y) (nateq x y)) (z 0)))
    ((Pl p q) (match b ((Pl r s) (if (nateq p r) (nateq q s) 0)) (z 0)))
    ((Mu p q) (match b ((Mu r s) (if (nateq p r) (nateq q s) 0)) (z 0)))
    (Lnil (match b (Lnil 1) (z 0)))
    ((Lcons p q) (match b ((Lcons r s) (if (nateq p r) (nateq q s) 0)) (z 0)))
    ((Lapp p q) (match b ((Lapp r s) (if (nateq p r) (nateq q s) 0)) (z 0)))
    ((Llen x) (match b ((Llen y) (nateq x y)) (z 0))) ((Con q) (match b ((Con r) (eq q r)) (z 0))) ((Apply f g) (match b ((Apply h k) (if (nateq f h) (nateq g k) 0)) (z 0)))
    ; STUCK user-function applications compare structurally — argument AND inline rules (check.beta's rules
    ; live in a global table so its equality compares only (fid,arg); here the rules ride the term, and
    ; requiring them equal is the same-or-stricter check). Rule bodies bring Reccall/Par/Fbundle along.
    ((Fapp a x y) (match b ((Fapp c w v) (if (nateq a c) (if (nateq x w) (nateq y v) 0) 0)) (z 0)))
    ((Frule ca ba) (match b ((Frule cb bb) (if (eq ca cb) (nateq ba bb) 0)) (z 0)))
    ((Fmore x y) (match b ((Fmore w v) (if (nateq x w) (nateq y v) 0)) (z 0)))
    ((Reccall i) (match b ((Reccall j) (eq i j)) (z 0)))
    ((Par k) (match b ((Par j) (eq k j)) (z 0)))
    ((Fbundle x y) (match b ((Fbundle w v) (if (nateq x w) (nateq y v) 0)) (z 0)))
    ((Fap t g a2) (match b ((Fap u h b2) (if (eq g h) (if (nateq a2 b2) (nateq t u) 0) 0)) (z 0)))
    ((Tcons r rest) (match b ((Tcons s rest2) (if (nateq r s) (nateq rest rest2) 0)) (z 0)))
    (Tnil (match b (Tnil 1) (z 0)))
    ((Trule g c bd) (match b ((Trule h d be) (if (eq g h) (if (eq c d) (nateq bd be) 0) 0)) (z 0)))
    ((Fcall g e) (match b ((Fcall h e2) (if (eq g h) (nateq e e2) 0)) (z 0)))
    ((Fcall2 g x y) (match b ((Fcall2 h w v) (if (eq g h) (if (nateq x w) (nateq y v) 0) 0)) (z 0)))
    ((Recx i e) (match b ((Recx j f) (if (eq i j) (nateq e f) 0)) (z 0)))))
(def conveq (a b) (nateq (pnorm a) (pnorm b)))   ; definitional equality

; substitute closed individual term s for the var bound at depth d
(def subt (t s d)
  (match t
    ((Iv k)   (if (eq k d) s (if (lt d k) (Iv (- k 1)) (Iv k))))
    (Ze Ze)
    ((Su x)   (Su (subt x s d)))
    ((Pl a b) (Pl (subt a s d) (subt b s d)))
    ((Mu a b) (Mu (subt a s d) (subt b s d)))
    (Lnil Lnil)
    ((Lcons a b) (Lcons (subt a s d) (subt b s d)))
    ((Lapp a b) (Lapp (subt a s d) (subt b s d)))
    ((Llen a) (Llen (subt a s d))) ((Con q) (Con q)) ((Apply f g) (Apply (subt f s d) (subt g s d)))
    ((Fap tab g a) (Fap tab g (subt a s d)))
    ((Fbundle x y) (Fbundle (subt x s d) (subt y s d)))))
(def subp (p s d)
  (match p
    ((Pred id t) (Pred id (subt t s d)))
    ((Rel id u v) (Rel id (subt u s d) (subt v s d)))
    ((Eq a b)    (Eq (subt a s d) (subt b s d)))
    ((All x)     (All (subp x (shiftt s 1 0) (+ d 1))))
    ((Exists x)  (Exists (subp x (shiftt s 1 0) (+ d 1))))
    ((Arrow a b) (Arrow (subp a s d) (subp b s d)))
    ((And a b)   (And (subp a s d) (subp b s d)))
    ((Or a b)    (Or (subp a s d) (subp b s d)))
    (z p)))                        ; Atom / Bot unchanged

; depth-aware FREE-variable check: an Ivar bound by a quantifier inside the prop is
; not free, so (All P(Iv0)) does not block generalization.
(def freet (t d)
  (match t
    ((Iv k) (if (lt k d) 0 1))
    (Ze 0)
    ((Su x) (freet x d))
    ((Pl a b) (if (freet a d) 1 (freet b d)))
    ((Mu a b) (if (freet a d) 1 (freet b d)))
    (Lnil 0)
    ((Lcons a b) (if (freet a d) 1 (freet b d)))
    ((Lapp a b) (if (freet a d) 1 (freet b d)))
    ((Llen a) (freet a d)) ((Con q) 0) ((Apply f g) (if (freet f d) 1 (freet g d)))
    ((Fap tab g a) (freet a d))
    ((Fbundle x y) (if (freet x d) 1 (freet y d)))))
(def freep (p d)
  (match p
    ((Pred id t) (freet t d))
    ((Rel id s t) (if (freet s d) 1 (freet t d)))
    ((Eq a b)    (if (freet a d) 1 (freet b d)))
    ((All x)     (freep x (+ d 1)))
    ((Exists x)  (freep x (+ d 1)))
    ((Arrow a b) (if (freep a d) 1 (freep b d)))
    ((And a b)   (if (freep a d) 1 (freep b d)))
    ((Or a b)    (if (freep a d) 1 (freep b d)))
    (z 0)))
; does t/p reference the var bound EXACTLY d levels out (the ∃-elim witness)?  freep
; tests index >= d; this tests index == d, so an outer individual is allowed but the
; witness is not — lets unpack admit a C that mentions outer individuals.
(def witt (t d)
  (match t
    ((Iv k) (if (eq k d) 1 0))
    (Ze 0)
    ((Su x) (witt x d))
    ((Pl a b) (if (witt a d) 1 (witt b d)))
    ((Mu a b) (if (witt a d) 1 (witt b d)))
    (Lnil 0)
    ((Lcons a b) (if (witt a d) 1 (witt b d)))
    ((Lapp a b) (if (witt a d) 1 (witt b d)))
    ((Llen a) (witt a d)) ((Con q) 0) ((Apply f g) (if (witt f d) 1 (witt g d)))))
(def witp (p d)
  (match p
    ((Pred id t) (witt t d))
    ((Rel id s t) (if (witt s d) 1 (witt t d)))
    ((Eq a b)    (if (witt a d) 1 (witt b d)))
    ((All x)     (witp x (+ d 1)))
    ((Exists x)  (witp x (+ d 1)))
    ((Arrow a b) (if (witp a d) 1 (witp b d)))
    ((And a b)   (if (witp a d) 1 (witp b d)))
    ((Or a b)    (if (witp a d) 1 (witp b d)))
    (z 0)))
; shift free individual vars (index >= c) up by d — lifts a witness across a binder
(def shiftt (t d c)
  (match t
    ((Iv k) (if (lt k c) (Iv k) (Iv (+ k d))))
    (Ze Ze)
    ((Su x) (Su (shiftt x d c)))
    ((Pl a b) (Pl (shiftt a d c) (shiftt b d c)))
    ((Mu a b) (Mu (shiftt a d c) (shiftt b d c)))
    (Lnil Lnil)
    ((Lcons a b) (Lcons (shiftt a d c) (shiftt b d c)))
    ((Lapp a b) (Lapp (shiftt a d c) (shiftt b d c)))
    ((Llen a) (Llen (shiftt a d c))) ((Con q) (Con q)) ((Apply f g) (Apply (shiftt f d c) (shiftt g d c)))
    ((Fap tab g a) (Fap tab g (shiftt a d c)))
    ((Fbundle x y) (Fbundle (shiftt x d c) (shiftt y d c)))))
; shift free individual vars (>= c) up by d in a PROPOSITION — list induction lifts the
; motive's parameters past the extra h binder the step (forall h t. ...) introduces.
(def shiftp (p d c)
  (match p
    ((Pred id t) (Pred id (shiftt t d c)))
    ((Rel id u v) (Rel id (shiftt u d c) (shiftt v d c)))
    ((Eq a b) (Eq (shiftt a d c) (shiftt b d c)))
    ((All x) (All (shiftp x d (+ c 1))))
    ((Exists x) (Exists (shiftp x d (+ c 1))))
    ((Arrow a b) (Arrow (shiftp a d c) (shiftp b d c)))
    ((And a b) (And (shiftp a d c) (shiftp b d c)))
    ((Or a b) (Or (shiftp a d c) (shiftp b d c)))
    (z p)))
; gen's freshness guard: no hypothesis in scope has a FREE individual var
(def ctxclean (ctx) (match ctx (Nil 1) ((Cons h t) (if (freep h 0) 0 (ctxclean t)))))
; ∀-intro lifts every hypothesis one individual binder deeper, so its free individual
; vars shift up by 1 (cutoff 0). After this the freshly bound variable (Iv 0) is mentioned
; by NO hypothesis — the eigenvariable condition holds structurally, not by forbidding open
; hypotheses. This makes ∃-elimination under an open context (e.g. <=-transitivity) provable.
(def shiftctx (ctx) (match ctx (Nil Nil) ((Cons h t) (Cons (shiftp h 1 0) (shiftctx t)))))

; the expected CASE type for a constructor (cid, arity, recursion flags r0 r1) under
; motive P — general structural induction, subsuming natind/listind. (Con cid) is the
; head, applied via Apply. arity-2 shifts P past the extra binder, like listind.
(def concase2 (cid r0 r1 mp)
  (let inner0 (subpk mp (Apply (Apply (Con cid) (Iv 1)) (Iv 0)) 0)
    (let inner1 (if r1 (Arrow mp inner0) inner0)
      (if r0 (Arrow (subpk mp (Iv 1) 0) inner1) inner1))))
(def concase (cid arity r0 r1 motive)
  (if (eq arity 0)
    (subp motive (Con cid) 0)
    (if (eq arity 1)
      (All (if r0 (Arrow motive (subpk motive (Apply (Con cid) (Iv 0)) 0))
                  (subpk motive (Apply (Con cid) (Iv 0)) 0)))
      (All (All (concase2 cid r0 r1 (shiftp motive 1 1)))))))

(def teq (a b)                     ; structural type equality (defn'l for Eq) -> 1/0
  (match a
    ((Atom x)    (match b ((Atom y)  (eq x y))                  (z 0)))
    ((Arrow p q) (match b ((Arrow r s) (if (teq p r) (teq q s) 0)) (z 0)))
    ((And p q)   (match b ((And r s)   (if (teq p r) (teq q s) 0)) (z 0)))
    ((Or p q)    (match b ((Or r s)    (if (teq p r) (teq q s) 0)) (z 0)))
    (Bot         (match b (Bot 1) (z 0)))
    ((Eq t1 t2)  (match b ((Eq u1 u2) (if (conveq t1 u1) (conveq t2 u2) 0)) (z 0)))
    ((All x)     (match b ((All y) (teq x y)) (z 0)))
    ((Exists x)  (match b ((Exists y) (teq x y)) (z 0)))
    ((Pred id t) (match b ((Pred jd u) (if (eq id jd) (conveq t u) 0)) (z 0)))
    ((Rel id s t) (match b ((Rel jd u v) (if (eq id jd) (if (conveq s u) (conveq t v) 0) 0)) (z 0)))
    (z 0)))

; keep-the-binder substitution (induction's P(s n)): rename the var at d to s, do NOT
; lower the variables above it.  shiftt lifts the renamer across inner binders.
(def subtk (t s d)
  (match t
    ((Iv k) (if (eq k d) s (Iv k)))
    (Ze Ze)
    ((Su x) (Su (subtk x s d)))
    ((Pl a b) (Pl (subtk a s d) (subtk b s d)))
    ((Mu a b) (Mu (subtk a s d) (subtk b s d)))
    (Lnil Lnil)
    ((Lcons a b) (Lcons (subtk a s d) (subtk b s d)))
    ((Lapp a b) (Lapp (subtk a s d) (subtk b s d)))
    ((Llen a) (Llen (subtk a s d))) ((Con q) (Con q)) ((Apply f g) (Apply (subtk f s d) (subtk g s d)))
    ((Fap tab g a) (Fap tab g (subtk a s d)))
    ((Fbundle x y) (Fbundle (subtk x s d) (subtk y s d)))))
(def subpk (p s d)
  (match p
    ((Pred id t) (Pred id (subtk t s d)))
    ((Rel id u v) (Rel id (subtk u s d) (subtk v s d)))
    ((Eq a b) (Eq (subtk a s d) (subtk b s d)))
    ((All x) (All (subpk x (shiftt s 1 0) (+ d 1))))
    ((Exists x) (Exists (subpk x (shiftt s 1 0) (+ d 1))))
    ((Arrow a b) (Arrow (subpk a s d) (subpk b s d)))
    ((And a b) (And (subpk a s d) (subpk b s d)))
    ((Or a b) (Or (subpk a s d) (subpk b s d)))
    (z p)))

(def isbad (t) (match t (Bad 1) (z 0)))

; the +-elim (case) rule, factored out: p:A+B, f:A->C, g:B->C  =>  C
(def infcase (tp tf tg)
  (match tp
    ((Or a b)
      (match tf
        ((Arrow fa fc)
          (match tg
            ((Arrow ga gc)
              (if (teq fa a) (if (teq ga b) (if (teq fc gc) fc Bad) Bad) Bad))
            (z Bad)))
        (z Bad)))
    (z Bad)))

(def infer (tm ctx)                ; the proposition a term proves, or Bad
  (match tm
    ((Hyp n)        (nth ctx n))
    ((Lam ty body)  (let bt (infer body (Cons ty ctx))
                      (if (isbad bt) Bad (Arrow ty bt))))
    ((App f a)      (match (infer f ctx)
                      ((Arrow p q) (if (teq (infer a ctx) p) q Bad))
                      (z Bad)))
    ((Pair a b)     (let ta (infer a ctx)
                      (let tb (infer b ctx)
                        (if (isbad ta) Bad (if (isbad tb) Bad (And ta tb))))))
    ((Fst p)        (match (infer p ctx) ((And r s) r) (z Bad)))
    ((Snd p)        (match (infer p ctx) ((And r s) s) (z Bad)))
    ((Inl bty p)    (let tp (infer p ctx) (if (isbad tp) Bad (Or tp bty))))
    ((Inr aty p)    (let tp (infer p ctx) (if (isbad tp) Bad (Or aty tp))))
    ((Case p f g)   (infcase (infer p ctx) (infer f ctx) (infer g ctx)))
    ((Absurd cty p) (match (infer p ctx) (Bot cty) (z Bad)))
    ((Refl t)       (Eq t t))
    ((Gen pf)       (let bt (infer pf (shiftctx ctx))        ; ∀-intro — shift ctx one binder
                      (if (isbad bt) Bad (All bt))))
    ((Inst pf t)    (match (infer pf ctx)                    ; ∀-elim — capture-avoiding
                      ((All body) (subp body t 0))           ; subst, so any witness ok
                      (z Bad)))
    ((Wit body t pf)                                         ; ∃-intro (witness may be open)
                      (let pt (infer pf ctx)
                        (if (isbad pt) Bad
                          (if (teq pt (subp body t 0)) (Exists body) Bad))))
    ((Natind motive base step)                              ; Peano induction
      (let tb (infer base ctx)
        (let ts (infer step ctx)
          (if (isbad tb) Bad
            (if (isbad ts) Bad
              (if (teq tb (subp motive Ze 0))               ; base : P(0)
                (if (teq ts (All (Arrow motive (subpk motive (Su (Iv 0)) 0))))  ; step
                  (All motive)                              ; ∀n. P(n)
                  Bad)
                Bad))))))
    ((Listind motive base step)                             ; list induction
      (let tb (infer base ctx)
        (let ts (infer step ctx)
          (let m2 (shiftp motive 1 1)
            (if (isbad tb) Bad
              (if (isbad ts) Bad
                (if (teq tb (subp motive Lnil 0))            ; base : P(nil)
                  (if (teq ts (All (All (Arrow m2 (subpk m2 (Lcons (Iv 1) (Iv 0)) 0)))))
                    (All motive) Bad)
                  Bad)))))))
    ((Eqelim motive pfeq pfpa)                              ; Leibniz: P(a), a=b |- P(b)
      (match (infer pfeq ctx)
        ((Eq a b) (if (teq (infer pfpa ctx) (subp motive a 0)) (subp motive b 0) Bad))
        (z Bad)))
    ((Rec sa sb motive cA cB)                               ; general structural induction
      (match sa ((Mkspec ca aa r0a r1a)
        (match sb ((Mkspec cb ab r0b r1b)
          (if (teq (infer cA ctx) (concase ca aa r0a r1a motive))
            (if (teq (infer cB ctx) (concase cb ab r0b r1b motive)) (All motive) Bad)
            Bad))))))
    ((Prodrec spec motive case)                             ; SINGLE-constructor product elimination
      (match spec                                           ; SOUNDNESS GUARD: the spec must be a Mkprod, which
        ((Mkprod cid arity r0 r1)                           ; the translator emits ONLY for (prod cid)-declared
          (if (teq (infer case ctx) (concase cid arity r0 r1 motive))  ; cids; a plain Mkspec (undeclared) falls
            (All motive) Bad))                              ; through to Bad — mirrors check.beta's PRODUCTS guard.
        (z Bad)))
    ((Disj pf)                                              ; no-confusion: 0 != s t
      (match (infer pf ctx)
        ((Eq a b)
          (match (pnorm a)
            (Ze (match (pnorm b) ((Su y) Bot) (z Bad)))
            ((Su x) (match (pnorm b) (Ze Bot) (z Bad)))
            (z Bad)))
        (z Bad)))
    ((Sinj pf)                                              ; s injective: s a = s b |- a = b
      (match (infer pf ctx)
        ((Eq a b)
          (match (pnorm a)
            ((Su x) (match (pnorm b) ((Su y) (Eq x y)) (z Bad)))
            (z Bad)))
        (z Bad)))
    ((Unpack epf h) (match (infer epf ctx)                   ; ∃-elim
                      ((Exists b)
                        (match (infer h ctx)
                          ((All inner)
                            (match inner
                              ((Arrow ante c)
                                (if (teq ante b) (if (witp c 0) Bad (subp c Ze 0)) Bad))
                              (z Bad)))
                          (z Bad)))
                      (z Bad)))
    ; ---- list membership: Mem(x,L) = (Rel 777 x L), an inductive predicate. Two intros
    ; (head/tail) + matching inversions (cons/nil). The ONLY closed sources of (Rel 777 ..)
    ; are these intros, so the inversions are sound. Mirrors check.beta exactly.
    ((MemHead x t) (Rel 777 x (Lcons x t)))                    ; Mem(x, cons x t)
    ((MemTail h pf) (match (infer pf ctx)
                      ((Rel id x t) (if (eq id 777) (Rel 777 x (Lcons h t)) Bad))
                      (z Bad)))                                 ; Mem(x,t) |- Mem(x, cons h t)
    ((MemCons pf) (match (infer pf ctx)
                    ((Rel id x l) (if (eq id 777)
                                    (match l ((Lcons h t) (Or (Eq x h) (Rel 777 x t))) (z Bad))
                                    Bad))
                    (z Bad)))                                   ; Mem(x, cons h t) |- (x=h) ∨ Mem(x,t)
    ((MemNil pf) (match (infer pf ctx)
                   ((Rel id x l) (if (eq id 777) (match l (Lnil Bot) (z Bad)) Bad))
                   (z Bad)))                                    ; Mem(x, nil) |- falsity
    ; ---- product-of-a-list as a relation: ProdIs(L,n) = (Rel 778 L n); two intros, no inversion
    ((Pnil) (Rel 778 Lnil (Su Ze)))                            ; ProdIs(nil, 1)
    ((Pcons h pf) (match (infer pf ctx)
                    ((Rel id t m) (if (eq id 778) (Rel 778 (Lcons h t) (Mu h m)) Bad))
                    (z Bad)))                                   ; ProdIs(t,m) |- ProdIs(cons h t, h*m)
    ; ProdIs inversions (sound: only pnil/pcons produce Rel(778,..))
    ((Prodnilinv pf) (match (infer pf ctx)
                       ((Rel id l n) (if (eq id 778) (match l (Lnil (Eq n (Su Ze))) (z Bad)) Bad)) (z Bad)))
    ((Prodconsinv pf) (match (infer pf ctx)
                        ((Rel id l n) (if (eq id 778)
                          (match l ((Lcons h t) (Exists (And (Eq (shiftt n 1 0) (Mu (shiftt h 1 0) (Iv 0))) (Rel 778 (shiftt t 1 0) (Iv 0))))) (z Bad)) Bad)) (z Bad)))
    ; ---- list permutation: Perm(L1,L2) = (Rel 779 L1 L2), four sound intro-only rules
    ; (nil, skip=cons-congruence, swap=adjacent transposition, trans). Mirrors check.beta exactly.
    ((Permnil) (Rel 779 Lnil Lnil))                            ; Perm(nil, nil)
    ((Permskip x pf) (match (infer pf ctx)
                       ((Rel id t1 t2) (if (eq id 779) (Rel 779 (Lcons x t1) (Lcons x t2)) Bad))
                       (z Bad)))                                ; Perm(t1,t2) |- Perm(cons x t1, cons x t2)
    ((Permswap x y r) (Rel 779 (Lcons x (Lcons y r)) (Lcons y (Lcons x r))))   ; adjacent transposition
    ((Permtrans p1 p2) (match (infer p1 ctx)
                         ((Rel i1 a b1) (if (eq i1 779)
                           (match (infer p2 ctx)
                             ((Rel i2 b2 c) (if (eq i2 779) (if (conveq b1 b2) (Rel 779 a c) Bad) Bad))
                             (z Bad))
                           Bad))
                         (z Bad)))                              ; Perm(a,b) & Perm(b,c) |- Perm(a,c)
    (z Bad)))

(def check (tm goal) (teq (infer tm Nil) goal))
