; checker.gamma — the Delta checker's core, in Gamma.  THE PAYOFF OF THE RUNG.
;
; The same checker as compiler/delta/check.beta — full intuitionistic propositional
; logic (-> & + bot) PLUS equality of Peano terms with the conversion rule — but
; where check.beta hand-encodes term/type trees as tagged 3-word memory nodes and
; decides everything with if-cascades on integer tags (~350 lines), here they are
; ALGEBRAIC DATA + PATTERN MATCHING: a dozen tiny functions, no manual memory, no
; tags. That contrast IS why the Gamma rung exists (delta.md: "the checker is a
; Gamma program — small, audited"; gamma.md: ADTs + match keep it small).
;
; Types: (Atom n) | (Arrow a b) | (And a b) | (Or a b) | Bot | (Eq t1 t2) | Bad
; Terms: (Hyp n) | (Lam ty body) | (App f a) | (Pair a b) | (Fst p) | (Snd p)
;      | (Inl bty p) | (Inr aty p) | (Case p f g) | (Absurd cty p) | (Refl nat)
; Peano (inside Eq/Refl):  Ze | (Su x) | (Pl a b)
; Context: a list  Nil | (Cons ty rest)   (de Bruijn: Hyp 0 is the innermost).
; infer returns a type (or Bad); check = "the inferred type equals the goal".
;
; Run via the Gamma reference interpreter (interp.beta) by appending a goal, e.g.:
;   ...defs...  (check (Lam (Atom 0) (Hyp 0)) (Arrow (Atom 0) (Atom 0)))   -> 1
; the identity proof  λx:P. x  of  P -> P.

(def nth (ctx n)
  (match ctx
    (Nil Bad)
    ((Cons h t) (if (eq n 0) h (nth t (- n 1))))))

; Peano normalization (the conversion rule's engine): Pl reduced away.
(def padd (a b) (match a (Ze b) ((Su x) (Su (padd x b)))))
(def pnorm (t)
  (match t
    (Ze Ze)
    ((Su x) (Su (pnorm x)))
    ((Pl a b) (padd (pnorm a) (pnorm b)))))
(def nateq (a b)
  (match a
    (Ze (match b (Ze 1) (z 0)))
    ((Su x) (match b ((Su y) (nateq x y)) (z 0)))))
(def conveq (a b) (nateq (pnorm a) (pnorm b)))   ; definitional equality

(def teq (a b)                     ; structural type equality (defn'l for Eq) -> 1/0
  (match a
    ((Atom x)    (match b ((Atom y)  (eq x y))                  (z 0)))
    ((Arrow p q) (match b ((Arrow r s) (if (teq p r) (teq q s) 0)) (z 0)))
    ((And p q)   (match b ((And r s)   (if (teq p r) (teq q s) 0)) (z 0)))
    ((Or p q)    (match b ((Or r s)    (if (teq p r) (teq q s) 0)) (z 0)))
    (Bot         (match b (Bot 1) (z 0)))
    ((Eq t1 t2)  (match b ((Eq u1 u2) (if (conveq t1 u1) (conveq t2 u2) 0)) (z 0)))
    (z 0)))

(def isbad (t) (match t (Bad 1) (z 0)))

; the +-elim (case) rule, factored out: p:A+B, f:A->C, g:B->C  =>  C
(def infcase (tp tf tg)
  (match tp
    ((Or a b)
      (match tf
        ((Arrow fa fc)
          (match tg
            ((Arrow ga gc)
              (if (teq fa a) (if (teq ga b) (if (teq fc gc) fc Bad) Bad) Bad))
            (z Bad)))
        (z Bad)))
    (z Bad)))

(def infer (tm ctx)                ; the proposition a term proves, or Bad
  (match tm
    ((Hyp n)        (nth ctx n))
    ((Lam ty body)  (let bt (infer body (Cons ty ctx))
                      (if (isbad bt) Bad (Arrow ty bt))))
    ((App f a)      (match (infer f ctx)
                      ((Arrow p q) (if (teq (infer a ctx) p) q Bad))
                      (z Bad)))
    ((Pair a b)     (let ta (infer a ctx)
                      (let tb (infer b ctx)
                        (if (isbad ta) Bad (if (isbad tb) Bad (And ta tb))))))
    ((Fst p)        (match (infer p ctx) ((And r s) r) (z Bad)))
    ((Snd p)        (match (infer p ctx) ((And r s) s) (z Bad)))
    ((Inl bty p)    (let tp (infer p ctx) (if (isbad tp) Bad (Or tp bty))))
    ((Inr aty p)    (let tp (infer p ctx) (if (isbad tp) Bad (Or aty tp))))
    ((Case p f g)   (infcase (infer p ctx) (infer f ctx) (infer g ctx)))
    ((Absurd cty p) (match (infer p ctx) (Bot cty) (z Bad)))
    ((Refl t)       (Eq t t))
    (z Bad)))

(def check (tm goal) (teq (infer tm Nil) goal))
