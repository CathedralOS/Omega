; checker_typed.gamma — the proof kernel, fully type-annotated, so that GAMMA'S OWN
; STATIC TYPE CHECKER (typeck.beta) accepts it. This is the point of gamma.md's
; "simple static type system — just enough to make the proof kernel safe to write":
; here the trust anchor's code is shown to be statically TYPE-SAFE. Same logic as
; checker.gamma (and check.beta) — full first-order predicate logic (∀ ∃ over Peano
; individuals) included; the only additions over checker.gamma are the data
; declarations and the parameter/return type annotations the type checker reads.
;
;   sh test-typeck.sh-style:  typeck < this  -> 1 (well-typed)

(data Nat (Ze) (Su Nat) (Pl Nat Nat) (Mu Nat Nat) (Iv Int) (Lnil) (Lcons Nat Nat) (Lapp Nat Nat) (Llen Nat) (Con Int) (Apply Nat Nat)
          (Fapp Nat Int Nat Int Nat) (Reccall Int) (Fbundle Nat Nat) (Par Int) (Fnone))   ; user-function application (rules inline, flat) + recursive call + binary-arg bundle + 2nd-arg ref + unary sentinel
(data Type (Atom Int) (Arrow Type Type) (And Type Type) (Or Type Type) (Bot) (Eq Nat Nat) (Bad)
           (All Type) (Exists Type) (Pred Int Nat) (Rel Int Nat Nat))
(data Spec (Mkspec Int Int Int Int))
(data Term (Hyp Int) (Lam Type Term) (App Term Term) (Pair Term Term) (Fst Term) (Snd Term)
           (Inl Type Term) (Inr Type Term) (Case Term Term Term) (Absurd Type Term) (Refl Nat)
           (Gen Term) (Inst Term Nat) (Wit Type Nat Term) (Unpack Term Term)
           (Natind Type Term Term) (Eqelim Type Term Term) (Disj Term) (Sinj Term)
           (Listind Type Term Term) (Rec Spec Spec Type Term Term)
           (MemHead Nat Nat) (MemTail Nat Term) (MemCons Term) (MemNil Term)
           (Pnil) (Pcons Nat Term) (Prodnilinv Term) (Prodconsinv Term)
           (Permnil) (Permskip Nat Term) (Permswap Nat Nat Nat) (Permtrans Term Term))
(data Ctx (Nil) (Cons Type Ctx))

(def nth ((ctx Ctx) (n Int)) Type
  (match ctx
    (Nil Bad)
    ((Cons h t) (if (eq n 0) h (nth t (- n 1))))))

(def padd ((a Nat) (b Nat)) Nat (match a (Ze b) ((Su x) (Su (padd x b))) (z (Pl a b))))
(def pmul ((a Nat) (b Nat)) Nat (match a (Ze Ze) ((Su x) (padd b (pmul x b))) (z (Mu a b))))
(def lapp ((a Nat) (b Nat)) Nat (match a (Lnil b) ((Lcons h t) (Lcons h (lapp t b))) (z (Lapp a b))))
(def llen ((l Nat)) Nat (match l (Lnil Ze) ((Lcons h t) (Su (llen t))) (z (Llen l))))
; user-defined recursive functions: (Fapp arg cA bA cB bB) carries its two rules inline
; (cid, body). finst instantiates a body — (Iv 0)->the field, (Reccall 0)->the recursive
; call; ffire fires the rule matching the constructor id and re-normalizes, else STUCK.
(def finst ((body Nat) (a0 Nat) (a1 Nat) (extra Nat) (cA Int) (bA Nat) (cB Int) (bB Nat)) Nat
  (match body
    ((Iv k) (if (eq k 0) a0 (if (eq k 1) a1 body)))
    ((Par k) extra)
    ((Reccall i) (let fld (if (eq i 0) a0 a1) (match extra (Fnone (Fapp fld cA bA cB bB)) (z (Fapp (Fbundle fld extra) cA bA cB bB)))))
    (Ze Ze) ((Su x) (Su (finst x a0 a1 extra cA bA cB bB)))
    ((Pl a b) (Pl (finst a a0 a1 extra cA bA cB bB) (finst b a0 a1 extra cA bA cB bB)))
    ((Mu a b) (Mu (finst a a0 a1 extra cA bA cB bB) (finst b a0 a1 extra cA bA cB bB)))
    (Lnil Lnil) ((Lcons a b) (Lcons (finst a a0 a1 extra cA bA cB bB) (finst b a0 a1 extra cA bA cB bB)))
    ((Lapp a b) (Lapp (finst a a0 a1 extra cA bA cB bB) (finst b a0 a1 extra cA bA cB bB)))
    ((Llen a) (Llen (finst a a0 a1 extra cA bA cB bB))) ((Con q) (Con q))
    ((Apply f g) (Apply (finst f a0 a1 extra cA bA cB bB) (finst g a0 a1 extra cA bA cB bB)))
    ((Fbundle x y) (Fbundle (finst x a0 a1 extra cA bA cB bB) (finst y a0 a1 extra cA bA cB bB)))
    ((Fapp a x1 y1 x2 y2) (Fapp (finst a a0 a1 extra cA bA cB bB) x1 y1 x2 y2))
    (z body)))
(def freb ((na Nat) (extra Nat) (cA Int) (bA Nat) (cB Int) (bB Nat)) Nat
  (match extra (Fnone (Fapp na cA bA cB bB)) (z (Fapp (Fbundle na extra) cA bA cB bB))))
(def ffire ((cid Int) (a0 Nat) (a1 Nat) (extra Nat) (na Nat) (cA Int) (bA Nat) (cB Int) (bB Nat)) Nat
  (if (eq cid cA) (pnorm (finst bA a0 a1 extra cA bA cB bB))
    (if (eq cid cB) (pnorm (finst bB a0 a1 extra cA bA cB bB)) (freb na extra cA bA cB bB))))
(def fdisp ((na Nat) (extra Nat) (cA Int) (bA Nat) (cB Int) (bB Nat)) Nat   ; fire on a constructor head
  (match na
    ((Con cid) (ffire cid Ze Ze extra na cA bA cB bB))                 ; arity 0
    ((Apply h x)
      (match h
        ((Con cid) (ffire cid x Ze extra na cA bA cB bB))              ; arity 1: field x
        ((Apply h2 a0) (match h2 ((Con cid) (ffire cid a0 x extra na cA bA cB bB))  ; arity 2: a0,x
                                 (z (freb na extra cA bA cB bB))))
        (z (freb na extra cA bA cB bB))))
    (z (freb na extra cA bA cB bB))))
(def pnorm ((t Nat)) Nat
  (match t (Ze Ze) ((Su x) (Su (pnorm x))) ((Iv k) (Iv k))
           ((Pl a b) (padd (pnorm a) (pnorm b))) ((Mu a b) (pmul (pnorm a) (pnorm b)))
           (Lnil Lnil) ((Lcons h t) (Lcons (pnorm h) (pnorm t))) ((Lapp a b) (lapp (pnorm a) (pnorm b))) ((Llen l) (llen (pnorm l))) ((Con q) (Con q)) ((Apply f g) (Apply (pnorm f) (pnorm g)))
           ((Fapp arg cA bA cB bB)
             (match arg
               ((Fbundle x y) (fdisp (pnorm x) y cA bA cB bB))   ; binary: scrutinee x, extra y
               (z (fdisp (pnorm arg) Fnone cA bA cB bB))))))      ; unary: extra=Fnone
(def nateq ((a Nat) (b Nat)) Int
  (match a (Ze (match b (Ze 1) (z 0))) ((Iv k) (match b ((Iv j) (eq k j)) (z 0)))
           ((Su x) (match b ((Su y) (nateq x y)) (z 0)))
           ((Pl p q) (match b ((Pl r s) (if (nateq p r) (nateq q s) 0)) (z 0)))
           ((Mu p q) (match b ((Mu r s) (if (nateq p r) (nateq q s) 0)) (z 0)))
           (Lnil (match b (Lnil 1) (z 0)))
           ((Lcons p q) (match b ((Lcons r s) (if (nateq p r) (nateq q s) 0)) (z 0)))
           ((Lapp p q) (match b ((Lapp r s) (if (nateq p r) (nateq q s) 0)) (z 0))) ((Llen x) (match b ((Llen y) (nateq x y)) (z 0))) ((Con q) (match b ((Con r) (eq q r)) (z 0))) ((Apply f g) (match b ((Apply h k) (if (nateq f h) (nateq g k) 0)) (z 0)))
           ; STUCK user-function applications compare structurally (flat rule form: arg, cidA, bodyA, cidB, bodyB)
           ((Fapp a x1 y1 x2 y2) (match b ((Fapp c w1 v1 w2 v2) (if (nateq a c) (if (eq x1 w1) (if (nateq y1 v1) (if (eq x2 w2) (nateq y2 v2) 0) 0) 0) 0)) (z 0)))
           ((Reccall i) (match b ((Reccall j) (eq i j)) (z 0)))
           ((Par k) (match b ((Par j) (eq k j)) (z 0)))
           ((Fbundle x y) (match b ((Fbundle w v) (if (nateq x w) (nateq y v) 0)) (z 0)))
           (Fnone (match b (Fnone 1) (z 0)))))
(def conveq ((a Nat) (b Nat)) Int (nateq (pnorm a) (pnorm b)))

(def subt ((t Nat) (s Nat) (d Int)) Nat
  (match t ((Iv k) (if (eq k d) s (if (lt d k) (Iv (- k 1)) (Iv k)))) (Ze Ze)
           ((Su x) (Su (subt x s d))) ((Pl a b) (Pl (subt a s d) (subt b s d)))
           ((Mu a b) (Mu (subt a s d) (subt b s d)))
           (Lnil Lnil) ((Lcons a b) (Lcons (subt a s d) (subt b s d))) ((Lapp a b) (Lapp (subt a s d) (subt b s d))) ((Llen a) (Llen (subt a s d))) ((Con q) (Con q)) ((Apply f g) (Apply (subt f s d) (subt g s d)))))
(def subp ((p Type) (s Nat) (d Int)) Type
  (match p ((Pred id t) (Pred id (subt t s d))) ((Rel id u v) (Rel id (subt u s d) (subt v s d))) ((Eq a b) (Eq (subt a s d) (subt b s d)))
           ((All x) (All (subp x (shiftt s 1 0) (+ d 1)))) ((Exists x) (Exists (subp x (shiftt s 1 0) (+ d 1))))
           ((Arrow a b) (Arrow (subp a s d) (subp b s d))) ((And a b) (And (subp a s d) (subp b s d)))
           ((Or a b) (Or (subp a s d) (subp b s d))) (z p)))
(def freet ((t Nat) (d Int)) Int
  (match t ((Iv k) (if (lt k d) 0 1)) (Ze 0) ((Su x) (freet x d))
           ((Pl a b) (if (freet a d) 1 (freet b d))) ((Mu a b) (if (freet a d) 1 (freet b d)))
           (Lnil 0) ((Lcons a b) (if (freet a d) 1 (freet b d))) ((Lapp a b) (if (freet a d) 1 (freet b d))) ((Llen a) (freet a d)) ((Con q) 0) ((Apply f g) (if (freet f d) 1 (freet g d)))))
(def freep ((p Type) (d Int)) Int
  (match p ((Pred id t) (freet t d)) ((Rel id s t) (if (freet s d) 1 (freet t d))) ((Eq a b) (if (freet a d) 1 (freet b d)))
           ((All x) (freep x (+ d 1))) ((Exists x) (freep x (+ d 1)))
           ((Arrow a b) (if (freep a d) 1 (freep b d))) ((And a b) (if (freep a d) 1 (freep b d)))
           ((Or a b) (if (freep a d) 1 (freep b d))) (z 0)))
; index == d (the ∃-elim witness), vs freep's index >= d: lets unpack admit a C that
; mentions outer individuals while still forbidding the witness.
(def witt ((t Nat) (d Int)) Int
  (match t ((Iv k) (if (eq k d) 1 0)) (Ze 0) ((Su x) (witt x d))
           ((Pl a b) (if (witt a d) 1 (witt b d))) ((Mu a b) (if (witt a d) 1 (witt b d)))
           (Lnil 0) ((Lcons a b) (if (witt a d) 1 (witt b d))) ((Lapp a b) (if (witt a d) 1 (witt b d))) ((Llen a) (witt a d)) ((Con q) 0) ((Apply f g) (if (witt f d) 1 (witt g d)))))
(def witp ((p Type) (d Int)) Int
  (match p ((Pred id t) (witt t d)) ((Rel id s t) (if (witt s d) 1 (witt t d))) ((Eq a b) (if (witt a d) 1 (witt b d)))
           ((All x) (witp x (+ d 1))) ((Exists x) (witp x (+ d 1)))
           ((Arrow a b) (if (witp a d) 1 (witp b d))) ((And a b) (if (witp a d) 1 (witp b d)))
           ((Or a b) (if (witp a d) 1 (witp b d))) (z 0)))
(def shiftt ((t Nat) (d Int) (c Int)) Nat
  (match t ((Iv k) (if (lt k c) (Iv k) (Iv (+ k d)))) (Ze Ze) ((Su x) (Su (shiftt x d c)))
           ((Pl a b) (Pl (shiftt a d c) (shiftt b d c))) ((Mu a b) (Mu (shiftt a d c) (shiftt b d c)))
           (Lnil Lnil) ((Lcons a b) (Lcons (shiftt a d c) (shiftt b d c))) ((Lapp a b) (Lapp (shiftt a d c) (shiftt b d c))) ((Llen a) (Llen (shiftt a d c))) ((Con q) (Con q)) ((Apply f g) (Apply (shiftt f d c) (shiftt g d c)))))
(def shiftp ((p Type) (d Int) (c Int)) Type
  (match p ((Pred id t) (Pred id (shiftt t d c))) ((Rel id u v) (Rel id (shiftt u d c) (shiftt v d c)))
           ((Eq a b) (Eq (shiftt a d c) (shiftt b d c)))
           ((All x) (All (shiftp x d (+ c 1)))) ((Exists x) (Exists (shiftp x d (+ c 1))))
           ((Arrow a b) (Arrow (shiftp a d c) (shiftp b d c))) ((And a b) (And (shiftp a d c) (shiftp b d c)))
           ((Or a b) (Or (shiftp a d c) (shiftp b d c))) (z p)))
(def ctxclean ((ctx Ctx)) Int (match ctx (Nil 1) ((Cons h t) (if (freep h 0) 0 (ctxclean t)))))
; ∀-intro lifts every hypothesis one individual binder deeper (free indiv vars +1, cutoff 0),
; so the freshly bound variable is mentioned by no hypothesis — eigenvariable holds structurally.
(def shiftctx ((ctx Ctx)) Ctx (match ctx (Nil Nil) ((Cons h t) (Cons (shiftp h 1 0) (shiftctx t)))))
(def concase2 ((cid Int) (r0 Int) (r1 Int) (mp Type)) Type
  (let inner0 (subpk mp (Apply (Apply (Con cid) (Iv 1)) (Iv 0)) 0)
    (let inner1 (if r1 (Arrow mp inner0) inner0)
      (if r0 (Arrow (subpk mp (Iv 1) 0) inner1) inner1))))
(def concase ((cid Int) (arity Int) (r0 Int) (r1 Int) (motive Type)) Type
  (if (eq arity 0) (subp motive (Con cid) 0)
    (if (eq arity 1) (All (if r0 (Arrow motive (subpk motive (Apply (Con cid) (Iv 0)) 0)) (subpk motive (Apply (Con cid) (Iv 0)) 0)))
      (All (All (concase2 cid r0 r1 (shiftp motive 1 1)))))))

(def teq ((a Type) (b Type)) Int
  (match a
    ((Atom x)    (match b ((Atom y) (eq x y))                  (z 0)))
    ((Arrow p q) (match b ((Arrow r s) (if (teq p r) (teq q s) 0)) (z 0)))
    ((And p q)   (match b ((And r s)   (if (teq p r) (teq q s) 0)) (z 0)))
    ((Or p q)    (match b ((Or r s)    (if (teq p r) (teq q s) 0)) (z 0)))
    (Bot         (match b (Bot 1) (z 0)))
    ((Eq t1 t2)  (match b ((Eq u1 u2) (if (conveq t1 u1) (conveq t2 u2) 0)) (z 0)))
    ((All x)     (match b ((All y) (teq x y)) (z 0)))
    ((Exists x)  (match b ((Exists y) (teq x y)) (z 0)))
    ((Pred id t) (match b ((Pred jd u) (if (eq id jd) (conveq t u) 0)) (z 0)))
    ((Rel id s t) (match b ((Rel jd u v) (if (eq id jd) (if (conveq s u) (conveq t v) 0) 0)) (z 0)))
    (z 0)))

(def subtk ((t Nat) (s Nat) (d Int)) Nat
  (match t ((Iv k) (if (eq k d) s (Iv k))) (Ze Ze) ((Su x) (Su (subtk x s d)))
           ((Pl a b) (Pl (subtk a s d) (subtk b s d))) ((Mu a b) (Mu (subtk a s d) (subtk b s d)))
           (Lnil Lnil) ((Lcons a b) (Lcons (subtk a s d) (subtk b s d))) ((Lapp a b) (Lapp (subtk a s d) (subtk b s d))) ((Llen a) (Llen (subtk a s d))) ((Con q) (Con q)) ((Apply f g) (Apply (subtk f s d) (subtk g s d)))))
(def subpk ((p Type) (s Nat) (d Int)) Type
  (match p ((Pred id t) (Pred id (subtk t s d))) ((Rel id u v) (Rel id (subtk u s d) (subtk v s d)))
           ((Eq a b) (Eq (subtk a s d) (subtk b s d)))
           ((All x) (All (subpk x (shiftt s 1 0) (+ d 1)))) ((Exists x) (Exists (subpk x (shiftt s 1 0) (+ d 1))))
           ((Arrow a b) (Arrow (subpk a s d) (subpk b s d))) ((And a b) (And (subpk a s d) (subpk b s d)))
           ((Or a b) (Or (subpk a s d) (subpk b s d))) (z p)))

(def isbad ((t Type)) Int (match t (Bad 1) (z 0)))

(def infcase ((tp Type) (tf Type) (tg Type)) Type
  (match tp
    ((Or a b)
      (match tf
        ((Arrow fa fc)
          (match tg
            ((Arrow ga gc) (if (teq fa a) (if (teq ga b) (if (teq fc gc) fc Bad) Bad) Bad))
            (z Bad)))
        (z Bad)))
    (z Bad)))

(def infer ((tm Term) (ctx Ctx)) Type
  (match tm
    ((Hyp n)        (nth ctx n))
    ((Lam ty body)  (let bt (infer body (Cons ty ctx)) (if (isbad bt) Bad (Arrow ty bt))))
    ((App f a)      (match (infer f ctx) ((Arrow p q) (if (teq (infer a ctx) p) q Bad)) (z Bad)))
    ((Pair a b)     (let ta (infer a ctx) (let tb (infer b ctx)
                      (if (isbad ta) Bad (if (isbad tb) Bad (And ta tb))))))
    ((Fst p)        (match (infer p ctx) ((And r s) r) (z Bad)))
    ((Snd p)        (match (infer p ctx) ((And r s) s) (z Bad)))
    ((Inl bty p)    (let tp (infer p ctx) (if (isbad tp) Bad (Or tp bty))))
    ((Inr aty p)    (let tp (infer p ctx) (if (isbad tp) Bad (Or aty tp))))
    ((Case p f g)   (infcase (infer p ctx) (infer f ctx) (infer g ctx)))
    ((Absurd cty p) (match (infer p ctx) (Bot cty) (z Bad)))
    ((Refl t)       (Eq t t))
    ((Gen pf)       (let bt (infer pf (shiftctx ctx)) (if (isbad bt) Bad (All bt))))
    ((Inst pf t)    (match (infer pf ctx) ((All body) (subp body t 0)) (z Bad)))
    ((Wit body t pf)
                       (let pt (infer pf ctx)
                         (if (isbad pt) Bad (if (teq pt (subp body t 0)) (Exists body) Bad))))
    ((Natind motive base step)
      (let tb (infer base ctx)
        (let ts (infer step ctx)
          (if (isbad tb) Bad
            (if (isbad ts) Bad
              (if (teq tb (subp motive Ze 0))
                (if (teq ts (All (Arrow motive (subpk motive (Su (Iv 0)) 0)))) (All motive) Bad)
                Bad))))))
    ((Listind motive base step)
      (let tb (infer base ctx)
        (let ts (infer step ctx)
          (let m2 (shiftp motive 1 1)
            (if (isbad tb) Bad
              (if (isbad ts) Bad
                (if (teq tb (subp motive Lnil 0))
                  (if (teq ts (All (All (Arrow m2 (subpk m2 (Lcons (Iv 1) (Iv 0)) 0))))) (All motive) Bad)
                  Bad)))))))
    ((Eqelim motive pfeq pfpa)
      (match (infer pfeq ctx)
        ((Eq a b) (if (teq (infer pfpa ctx) (subp motive a 0)) (subp motive b 0) Bad))
        (z Bad)))
    ((Rec sa sb motive cA cB)
      (match sa ((Mkspec ca aa r0a r1a)
        (match sb ((Mkspec cb ab r0b r1b)
          (if (teq (infer cA ctx) (concase ca aa r0a r1a motive))
            (if (teq (infer cB ctx) (concase cb ab r0b r1b motive)) (All motive) Bad)
            Bad))))))
    ((Disj pf)
      (match (infer pf ctx)
        ((Eq a b)
          (match (pnorm a)
            (Ze (match (pnorm b) ((Su y) Bot) (z Bad)))
            ((Su x) (match (pnorm b) (Ze Bot) (z Bad)))
            (z Bad)))
        (z Bad)))
    ((Sinj pf)
      (match (infer pf ctx)
        ((Eq a b)
          (match (pnorm a) ((Su x) (match (pnorm b) ((Su y) (Eq x y)) (z Bad))) (z Bad)))
        (z Bad)))
    ((Unpack epf h) (match (infer epf ctx)
                      ((Exists b)
                        (match (infer h ctx)
                          ((All inner)
                            (match inner
                              ((Arrow ante c) (if (teq ante b) (if (witp c 0) Bad (subp c Ze 0)) Bad))
                              (z Bad)))
                          (z Bad)))
                      (z Bad)))
    ; list membership Mem(x,L) = (Rel 777 x L): inductive predicate (intros + inversions)
    ((MemHead x t) (Rel 777 x (Lcons x t)))
    ((MemTail h pf) (match (infer pf ctx)
                      ((Rel id x t) (if (eq id 777) (Rel 777 x (Lcons h t)) Bad)) (z Bad)))
    ((MemCons pf) (match (infer pf ctx)
                    ((Rel id x l) (if (eq id 777)
                                    (match l ((Lcons h t) (Or (Eq x h) (Rel 777 x t))) (z Bad)) Bad)) (z Bad)))
    ((MemNil pf) (match (infer pf ctx)
                   ((Rel id x l) (if (eq id 777) (match l (Lnil Bot) (z Bad)) Bad)) (z Bad)))
    ; product-of-a-list as a relation: ProdIs(L,n) = (Rel 778 L n); two intros, no inversion
    ((Pnil) (Rel 778 Lnil (Su Ze)))
    ((Pcons h pf) (match (infer pf ctx)
                    ((Rel id t m) (if (eq id 778) (Rel 778 (Lcons h t) (Mu h m)) Bad)) (z Bad)))
    ((Prodnilinv pf) (match (infer pf ctx)
                       ((Rel id l n) (if (eq id 778) (match l (Lnil (Eq n (Su Ze))) (z Bad)) Bad)) (z Bad)))
    ((Prodconsinv pf) (match (infer pf ctx)
                        ((Rel id l n) (if (eq id 778)
                          (match l ((Lcons h t) (Exists (And (Eq (shiftt n 1 0) (Mu (shiftt h 1 0) (Iv 0))) (Rel 778 (shiftt t 1 0) (Iv 0))))) (z Bad)) Bad)) (z Bad)))
    ; list permutation Perm(L1,L2) = (Rel 779 L1 L2): four sound intro-only rules. Mirrors check.beta.
    ((Permnil) (Rel 779 Lnil Lnil))
    ((Permskip x pf) (match (infer pf ctx)
                       ((Rel id t1 t2) (if (eq id 779) (Rel 779 (Lcons x t1) (Lcons x t2)) Bad)) (z Bad)))
    ((Permswap x y r) (Rel 779 (Lcons x (Lcons y r)) (Lcons y (Lcons x r))))
    ((Permtrans p1 p2) (match (infer p1 ctx)
                         ((Rel i1 a b1) (if (eq i1 779)
                           (match (infer p2 ctx)
                             ((Rel i2 b2 c) (if (eq i2 779) (if (conveq b1 b2) (Rel 779 a c) Bad) Bad)) (z Bad))
                           Bad)) (z Bad)))
    (z Bad)))

(def check ((tm Term) (goal Type)) Int (teq (infer tm Nil) goal))
