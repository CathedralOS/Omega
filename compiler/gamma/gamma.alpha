; gamma.alpha — the gamma compiler, written in alpha assembly.
;
; gamma reads gamma source on stdin and emits alpha assembly on stdout; beta lowers
; that to a tape, which is stamped into the alpha seed to make a standalone .exe.
;
; v4: variables, statements, AND control flow (if).
;   program   := statement*
;   statement := var '=' expr  |  'if' expr '{' statement* '}'
;   expr      := term (('+'|'-') term)*    term := factor (('*'|'/') factor)*
;   factor    := number | var
; var = a letter a..j held in registers r6..r15. An `if` runs its body when the
; condition is nonzero. The program exits with the value of its last expression (r0).
;     a = 1   \n  if a { a = 42 }      -> 42
;     a = 0   \n  if a { a = 42 }      -> 0
; Labels are generated L<n>e via a label counter; a label-number stack lets ifs nest.
;
; Globals (calls clobber registers, so cross-call state lives in memory):
;   524288 LA   524296 TGT   524304 REGN   524312 LSP   524320 NUMV   524328 LCTR
;   label-number stack at 524400 ; emit_dec digit buffer at 525000

; ---------------- main ----------------
        imm   r0, 0                ; LCTR = 0
        imm   r1, 524328
        store r1, r0
        imm   r0, 524400           ; LSP = stack base
        imm   r1, 524312
        store r1, r0
        call  advance              ; prime the lookahead
        imm   r0, 105
        write r0
        imm   r0, 109
        write r0
        imm   r0, 109
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 51
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 52
        write r0
        imm   r0, 49
        write r0
        imm   r0, 57
        write r0
        imm   r0, 52
        write r0
        imm   r0, 51
        write r0
        imm   r0, 49
        write r0
        imm   r0, 50
        write r0
        imm   r0, 10
        write r0
        imm   r0, 105
        write r0
        imm   r0, 109
        write r0
        imm   r0, 109
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 53
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 51
        write r0
        imm   r0, 49
        write r0
        imm   r0, 52
        write r0
        imm   r0, 53
        write r0
        imm   r0, 55
        write r0
        imm   r0, 50
        write r0
        imm   r0, 56
        write r0
        imm   r0, 10
        write r0
        imm   r0, 115
        write r0
        imm   r0, 116
        write r0
        imm   r0, 111
        write r0
        imm   r0, 114
        write r0
        imm   r0, 101
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 51
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 53
        write r0
        imm   r0, 10
        write r0
        call  parse_program
        ; exit with the last variable assigned: if LASTREG != 0, emit "mov r0, r<LASTREG>\n"
        imm   r1, 524336
        load  r3, r1               ; LASTREG (0 = no assignment; valid regs are 6..15)
        imm   r2, 0
        jeq   r3, r2, main_halt
        imm   r0, 109              ; m
        write r0
        imm   r0, 111              ; o
        write r0
        imm   r0, 118              ; v
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114              ; r
        write r0
        imm   r0, 48               ; 0
        write r0
        imm   r0, 44               ; ,
        write r0
        imm   r0, 32
        write r0
        imm   r1, 524304
        store r1, r3               ; REGN = LASTREG
        call  emit_reg
        imm   r0, 10
        write r0
main_halt:
        ; emit "halt r0\n"
        imm   r0, 104
        write r0
        imm   r0, 97
        write r0
        imm   r0, 108
        write r0
        imm   r0, 116
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 48
        write r0
        imm   r0, 10
        write r0
        imm   r1, 524352
        load  r0, r1               ; PRINTED
        imm   r2, 0
        jeq   r0, r2, main_rd
        call  emit_pd_routine
main_rd:
        imm   r1, 524360
        load  r0, r1
        imm   r2, 0
        jeq   r0, r2, main_done
        call  emit_rd_routine
main_done:
        imm   r0, 0
        halt  r0

; ---------------- parse_program: statement* ----------------
parse_program:
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 0
        jlt   r0, r2, pp_done      ; EOF
        call  parse_statement
        jmp   parse_program
pp_done:
        ret

; ---------------- parse_statement: assignment or if ----------------
parse_statement:
        call  skip_spaces
        imm   r1, 524288
        load  r3, r1               ; c = LA
        imm   r2, 105
        jeq   r3, r2, ps_i         ; 'i' -> maybe "if", maybe var i
        imm   r2, 119
        jeq   r3, r2, ps_w         ; 'w' -> "while"
        imm   r2, 112
        jeq   r3, r2, ps_p         ; 'p' -> "print"
        imm   r2, 114
        jeq   r3, r2, ps_r         ; 'r' -> "read"
        imm   r2, 97
        jlt   r3, r2, ps_err       ; < 'a'
        imm   r2, 106
        jlt   r2, r3, ps_err       ; > 'j'
        imm   r2, 91
        sub   r3, r2               ; regnum
        imm   r1, 524296
        store r1, r3               ; TGT
        call  advance              ; consume the letter
        jmp   ps_eq
ps_i:
        call  advance              ; consume 'i'
        imm   r1, 524288
        load  r3, r1
        imm   r2, 102
        jeq   r3, r2, ps_if        ; 'f' -> "if"
        imm   r3, 14               ; var 'i' -> r14
        imm   r1, 524296
        store r1, r3               ; TGT = 14
        jmp   ps_eq
ps_if:
        call  advance              ; consume 'f'
        call  parse_if
        ret
ps_w:
        call  advance              ; consume 'w'
psw_skip:
        imm   r1, 524288
        load  r3, r1
        imm   r2, 97
        jlt   r3, r2, psw_done     ; past the keyword's letters
        imm   r2, 122
        jlt   r2, r3, psw_done
        call  advance
        jmp   psw_skip
psw_done:
        call  parse_while
        ret
ps_p:
        call  advance              ; consume 'p'
psp_skip:
        imm   r1, 524288
        load  r3, r1
        imm   r2, 97
        jlt   r3, r2, psp_done
        imm   r2, 122
        jlt   r2, r3, psp_done
        call  advance
        jmp   psp_skip
psp_done:
        call  parse_print
        ret
ps_r:
        call  advance              ; consume 'r'
psr_skip:
        imm   r1, 524288
        load  r3, r1
        imm   r2, 97
        jlt   r3, r2, psr_done
        imm   r2, 122
        jlt   r2, r3, psr_done
        call  advance
        jmp   psr_skip
psr_done:
        call  parse_read
        ret
ps_err:
        imm   r0, 8
        halt  r0
ps_eq:
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 61
        jeq   r0, r2, ps_do        ; '='
        imm   r0, 8
        halt  r0
ps_do:
        call  advance              ; consume '='
        call  parse_expr           ; value -> r0
        ; emit "mov r<TGT>, r0\n"
        imm   r0, 109
        write r0
        imm   r0, 111
        write r0
        imm   r0, 118
        write r0
        imm   r0, 32
        write r0
        imm   r1, 524296
        load  r3, r1
        imm   r1, 524304
        store r1, r3               ; REGN = TGT
        call  emit_reg
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 48
        write r0
        imm   r0, 10
        write r0
        ; remember this as the last assignment (for the program's exit value)
        imm   r1, 524296
        load  r3, r1               ; TGT
        imm   r1, 524336
        store r1, r3               ; LASTREG = TGT
        ret

; ---------------- parse_if: 'if' expr '{' statement* '}' ----------------
parse_if:
        ; n = LCTR; LCTR = n + 1
        imm   r1, 524328
        load  r3, r1
        mov   r4, r3
        imm   r2, 1
        add   r4, r2
        store r1, r4
        ; push n on the label stack
        imm   r1, 524312
        load  r5, r1               ; LSP
        store r5, r3
        imm   r2, 8
        add   r5, r2
        imm   r1, 524312
        store r1, r5
        ; condition -> r0
        call  parse_expr
        ; emit "jz r0, L<n>e\n"
        imm   r0, 106              ; j
        write r0
        imm   r0, 122              ; z
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114              ; r
        write r0
        imm   r0, 48               ; 0
        write r0
        imm   r0, 44               ; ,
        write r0
        imm   r0, 32
        write r0
        imm   r0, 76               ; L
        write r0
        call  emit_top_lnum
        imm   r0, 101              ; e
        write r0
        imm   r0, 10
        write r0
        ; expect '{'
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 123
        jeq   r0, r2, pi_brace
        imm   r0, 8
        halt  r0
pi_brace:
        call  advance              ; consume '{'
pi_body:
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 125
        jeq   r0, r2, pi_close      ; '}'
        imm   r2, 0
        jlt   r0, r2, pi_fin        ; EOF -> end (unterminated)
        call  parse_statement
        jmp   pi_body
pi_close:
        call  advance              ; consume close brace
        call  skip_spaces
        imm   r1, 524288
        load  r3, r1
        imm   r2, 101
        jeq   r3, r2, pi_maybe_else
        jmp   pi_noelse
pi_fin:
pi_noelse:
        imm   r0, 76
        write r0
        call  emit_top_lnum
        imm   r0, 101
        write r0
        imm   r0, 58
        write r0
        imm   r0, 10
        write r0
        jmp   pi_pop
pi_maybe_else:
        call  advance
        imm   r1, 524288
        load  r3, r1
        imm   r2, 108
        jeq   r3, r2, pi_else
        imm   r1, 524368
        store r1, r3
        imm   r1, 524288
        imm   r0, 101
        store r1, r0
        jmp   pi_noelse
pi_else:
pie_idskip:
        imm   r1, 524288
        load  r3, r1
        imm   r2, 97
        jlt   r3, r2, pie_iddone
        imm   r2, 122
        jlt   r2, r3, pie_iddone
        call  advance
        jmp   pie_idskip
pie_iddone:
        imm   r0, 106
        write r0
        imm   r0, 109
        write r0
        imm   r0, 112
        write r0
        imm   r0, 32
        write r0
        imm   r0, 76
        write r0
        call  emit_top_lnum
        imm   r0, 120
        write r0
        imm   r0, 10
        write r0
        imm   r0, 76
        write r0
        call  emit_top_lnum
        imm   r0, 101
        write r0
        imm   r0, 58
        write r0
        imm   r0, 10
        write r0
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 123
        jeq   r0, r2, pie_brace
        imm   r0, 8
        halt  r0
pie_brace:
        call  advance
pie_body:
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 125
        jeq   r0, r2, pie_eclose
        imm   r2, 0
        jlt   r0, r2, pie_efin
        call  parse_statement
        jmp   pie_body
pie_eclose:
        call  advance
pie_efin:
        imm   r0, 76
        write r0
        call  emit_top_lnum
        imm   r0, 120
        write r0
        imm   r0, 58
        write r0
        imm   r0, 10
        write r0
pi_pop:
        imm   r1, 524312
        load  r5, r1
        imm   r2, 8
        sub   r5, r2
        imm   r1, 524312
        store r1, r5
        ret
; ---------------- parse_while: 'while' expr '{' statement* '}' ----------------
parse_while:
        ; n = LCTR; LCTR = n + 1
        imm   r1, 524328
        load  r3, r1
        mov   r4, r3
        imm   r2, 1
        add   r4, r2
        store r1, r4
        ; push n on the label stack
        imm   r1, 524312
        load  r5, r1
        store r5, r3
        imm   r2, 8
        add   r5, r2
        imm   r1, 524312
        store r1, r5
        ; emit "L<n>t:\n" (loop top)
        imm   r0, 76               ; L
        write r0
        call  emit_top_lnum
        imm   r0, 116              ; t
        write r0
        imm   r0, 58               ; :
        write r0
        imm   r0, 10
        write r0
        ; condition -> r0
        call  parse_expr
        ; emit "jz r0, L<n>e\n"
        imm   r0, 106              ; j
        write r0
        imm   r0, 122              ; z
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114              ; r
        write r0
        imm   r0, 48               ; 0
        write r0
        imm   r0, 44               ; ,
        write r0
        imm   r0, 32
        write r0
        imm   r0, 76               ; L
        write r0
        call  emit_top_lnum
        imm   r0, 101              ; e
        write r0
        imm   r0, 10
        write r0
        ; expect '{'
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 123
        jeq   r0, r2, pw_brace
        imm   r0, 8
        halt  r0
pw_brace:
        call  advance              ; consume '{'
pw_body:
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 125
        jeq   r0, r2, pw_close      ; '}'
        imm   r2, 0
        jlt   r0, r2, pw_fin        ; EOF
        call  parse_statement
        jmp   pw_body
pw_close:
        call  advance              ; consume '}'
pw_fin:
        ; emit "jmp L<n>t\n"
        imm   r0, 106              ; j
        write r0
        imm   r0, 109              ; m
        write r0
        imm   r0, 112              ; p
        write r0
        imm   r0, 32
        write r0
        imm   r0, 76               ; L
        write r0
        call  emit_top_lnum
        imm   r0, 116              ; t
        write r0
        imm   r0, 10
        write r0
        ; emit "L<n>e:\n"
        imm   r0, 76               ; L
        write r0
        call  emit_top_lnum
        imm   r0, 101              ; e
        write r0
        imm   r0, 58               ; :
        write r0
        imm   r0, 10
        write r0
        ; pop n
        imm   r1, 524312
        load  r5, r1
        imm   r2, 8
        sub   r5, r2
        imm   r1, 524312
        store r1, r5
        ret

; ---------------- parse_print: 'print' expr  (writes the low byte of expr) ----------------
parse_print:
        call  parse_expr           ; value -> r0
        imm   r0, 99
        write r0
        imm   r0, 97
        write r0
        imm   r0, 108
        write r0
        imm   r0, 108
        write r0
        imm   r0, 32
        write r0
        imm   r0, 80
        write r0
        imm   r0, 68
        write r0
        imm   r0, 10
        write r0
        imm   r1, 524352
        imm   r0, 1
        store r1, r0               ; PRINTED = 1
        ret

; ---------------- parse_expr: comparison level  sum (cmpop sum)? ----------------
; Comparisons < > == <= >= != yield 0/1 in r0 (target regs r1=saved left, r3=result).
parse_expr:
        call  parse_sum
        call  skip_spaces
        imm   r1, 524288
        load  r3, r1
        imm   r2, 60
        jeq   r3, r2, pc_lt
        imm   r2, 62
        jeq   r3, r2, pc_gt
        imm   r2, 61
        jeq   r3, r2, pc_eq
        imm   r2, 33
        jeq   r3, r2, pc_ne
        ret
pc_lt:
        call  advance
        imm   r1, 524288
        load  r3, r1
        imm   r2, 61
        jeq   r3, r2, pc_le
        imm   r6, 0
        imm   r1, 524344
        store r1, r6
        jmp   pc_common
pc_le:
        call  advance
        imm   r6, 3
        imm   r1, 524344
        store r1, r6
        jmp   pc_common
pc_gt:
        call  advance
        imm   r1, 524288
        load  r3, r1
        imm   r2, 61
        jeq   r3, r2, pc_ge
        imm   r6, 1
        imm   r1, 524344
        store r1, r6
        jmp   pc_common
pc_ge:
        call  advance
        imm   r6, 4
        imm   r1, 524344
        store r1, r6
        jmp   pc_common
pc_eq:
        call  advance
        imm   r1, 524288
        load  r3, r1
        imm   r2, 61
        jeq   r3, r2, pc_eq2
        imm   r0, 8
        halt  r0
pc_eq2:
        call  advance
        imm   r6, 2
        imm   r1, 524344
        store r1, r6
        jmp   pc_common
pc_ne:
        call  advance
        imm   r1, 524288
        load  r3, r1
        imm   r2, 61
        jeq   r3, r2, pc_ne2
        imm   r0, 8
        halt  r0
pc_ne2:
        call  advance
        imm   r6, 5
        imm   r1, 524344
        store r1, r6
pc_common:
        call  emit_save_left
        call  parse_sum
        call  cmp_alloc
        imm   r1, 524344
        load  r3, r1
        imm   r2, 0
        jeq   r3, r2, pm_lt
        imm   r2, 1
        jeq   r3, r2, pm_gt
        imm   r2, 2
        jeq   r3, r2, pm_eq
        imm   r2, 3
        jeq   r3, r2, pm_le
        imm   r2, 4
        jeq   r3, r2, pm_ge
pm_ne:
        call  emit_imm_r3_0
        call  emit_jeq_10
        call  emit_imm_r3_1
        call  emit_ctail
        ret
pm_lt:
        call  emit_imm_r3_1
        call  emit_jlt_10
        call  emit_imm_r3_0
        call  emit_ctail
        ret
pm_gt:
        call  emit_imm_r3_1
        call  emit_jlt_01
        call  emit_imm_r3_0
        call  emit_ctail
        ret
pm_eq:
        call  emit_imm_r3_1
        call  emit_jeq_10
        call  emit_imm_r3_0
        call  emit_ctail
        ret
pm_le:
        call  emit_imm_r3_1
        call  emit_jlt_10
        call  emit_jeq_10
        call  emit_imm_r3_0
        call  emit_ctail
        ret
pm_ge:
        call  emit_imm_r3_1
        call  emit_jlt_01
        call  emit_jeq_10
        call  emit_imm_r3_0
        call  emit_ctail
        ret

; comparison emit helpers
emit_save_left:
        imm   r0, 109
        write r0
        imm   r0, 111
        write r0
        imm   r0, 118
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 49
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 48
        write r0
        imm   r0, 10
        write r0
        ret
emit_imm_r3_1:
        imm   r0, 105
        write r0
        imm   r0, 109
        write r0
        imm   r0, 109
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 51
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 49
        write r0
        imm   r0, 10
        write r0
        ret
emit_imm_r3_0:
        imm   r0, 105
        write r0
        imm   r0, 109
        write r0
        imm   r0, 109
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 51
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 48
        write r0
        imm   r0, 10
        write r0
        ret
cmp_alloc:
        imm   r1, 524328
        load  r9, r1
        mov   r3, r9
        imm   r2, 1
        add   r3, r2
        store r1, r3
        ret
emit_cnum:
        imm   r0, 67
        write r0
        imm   r1, 524320
        store r1, r9
        call  emit_dec
        ret
emit_jlt_10:
        imm   r0, 106
        write r0
        imm   r0, 108
        write r0
        imm   r0, 116
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 49
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 48
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        call  emit_cnum
        imm   r0, 10
        write r0
        ret
emit_jlt_01:
        imm   r0, 106
        write r0
        imm   r0, 108
        write r0
        imm   r0, 116
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 48
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 49
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        call  emit_cnum
        imm   r0, 10
        write r0
        ret
emit_jeq_10:
        imm   r0, 106
        write r0
        imm   r0, 101
        write r0
        imm   r0, 113
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 49
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 48
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        call  emit_cnum
        imm   r0, 10
        write r0
        ret
emit_ctail:
        call  emit_cnum
        imm   r0, 58
        write r0
        imm   r0, 10
        write r0
        imm   r0, 109
        write r0
        imm   r0, 111
        write r0
        imm   r0, 118
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 48
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 51
        write r0
        imm   r0, 10
        write r0
        ret

; ---------------- parse_sum / parse_term ----------------
parse_sum:
        call  parse_term
        imm   r0, 109              ; m  (mov r0, r4)
        write r0
        imm   r0, 111
        write r0
        imm   r0, 118
        write r0
        call  emit_r0r4
pe_loop:
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 43
        jeq   r0, r2, pe_add
        imm   r2, 45
        jeq   r0, r2, pe_sub
        ret
pe_add:
        call  advance
        call  parse_term
        imm   r0, 97
        write r0
        imm   r0, 100
        write r0
        imm   r0, 100
        write r0
        call  emit_r0r4
        jmp   pe_loop
pe_sub:
        call  advance
        call  parse_term
        imm   r0, 115
        write r0
        imm   r0, 117
        write r0
        imm   r0, 98
        write r0
        call  emit_r0r4
        jmp   pe_loop
parse_term:
        call  parse_factor_first
pt_loop:
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 42
        jeq   r0, r2, pt_mul
        imm   r2, 47
        jeq   r0, r2, pt_div
        imm   r2, 37
        jeq   r0, r2, pt_mod
        ret
pt_mul:
        call  advance
        call  parse_factor_next
        imm   r0, 109
        write r0
        imm   r0, 117
        write r0
        imm   r0, 108
        write r0
        call  emit_r4r5
        jmp   pt_loop
pt_div:
        call  advance
        call  parse_factor_next
        imm   r0, 100
        write r0
        imm   r0, 105
        write r0
        imm   r0, 118
        write r0
        call  emit_r4r5
        jmp   pt_loop
pt_mod:
        call  advance
        call  parse_factor_next
        imm   r0, 109              ; m
        write r0
        imm   r0, 111              ; o
        write r0
        imm   r0, 100              ; d
        write r0
        call  emit_r4r5
        jmp   pt_loop

; ---------------- factors: number or variable ----------------
parse_factor_first:
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 40
        jeq   r0, r2, pff_paren
        imm   r2, 48
        jlt   r0, r2, pff_var
        imm   r2, 57
        jlt   r2, r0, pff_var
        imm   r0, 105
        write r0
        imm   r0, 109
        write r0
        imm   r0, 109
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 52               ; 4
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        call  copy_digits
        imm   r0, 10
        write r0
        ret
pff_var:
        imm   r1, 524288
        load  r3, r1
        imm   r2, 97
        jlt   r3, r2, pf_err
        imm   r2, 106
        jlt   r2, r3, pf_err
        imm   r2, 91
        sub   r3, r2
        imm   r1, 524304
        store r1, r3
        call  advance
        imm   r0, 109
        write r0
        imm   r0, 111
        write r0
        imm   r0, 118
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 52               ; 4
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        call  emit_reg
        imm   r0, 10
        write r0
        ret
pf_err:
        imm   r0, 8
        halt  r0
parse_factor_next:
        call  skip_spaces
        imm   r1, 524288
        load  r0, r1
        imm   r2, 40
        jeq   r0, r2, pfn_paren
        imm   r2, 48
        jlt   r0, r2, pfn_var
        imm   r2, 57
        jlt   r2, r0, pfn_var
        imm   r0, 105
        write r0
        imm   r0, 109
        write r0
        imm   r0, 109
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 53               ; 5
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        call  copy_digits
        imm   r0, 10
        write r0
        ret
pfn_var:
        imm   r1, 524288
        load  r3, r1
        imm   r2, 97
        jlt   r3, r2, pf_err
        imm   r2, 106
        jlt   r2, r3, pf_err
        imm   r2, 91
        sub   r3, r2
        imm   r1, 524304
        store r1, r3
        call  advance
        imm   r0, 109
        write r0
        imm   r0, 111
        write r0
        imm   r0, 118
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 53               ; 5
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        call  emit_reg
        imm   r0, 10
        write r0
        ret

; ---------------- emit_reg: "r" + decimal of REGN (6..15) ----------------
emit_reg:
        imm   r0, 114
        write r0
        imm   r1, 524304
        load  r3, r1
        imm   r2, 10
        jlt   r3, r2, er_single
        imm   r0, 49               ; '1'
        write r0
        imm   r2, 10
        sub   r3, r2
        imm   r2, 48
        add   r3, r2
        write r3
        ret
er_single:
        imm   r2, 48
        add   r3, r2
        write r3
        ret

; ---------------- emit_top_lnum: emit decimal of the top label number ----------------
emit_top_lnum:
        imm   r1, 524312
        load  r5, r1
        imm   r2, 8
        sub   r5, r2
        load  r3, r5
        imm   r1, 524320
        store r1, r3               ; NUMV = top
        call  emit_dec
        ret

; ---------------- emit_dec: emit the decimal text of NUMV (>= 0) ----------------
emit_dec:
        imm   r1, 524320
        load  r3, r1               ; value
        imm   r2, 0
        jeq   r3, r2, ed_zero
        imm   r5, 525000           ; digit buffer
        imm   r4, 0                ; count
ed_collect:
        imm   r2, 0
        jeq   r3, r2, ed_emit
        mov   r6, r3
        imm   r2, 10
        mod   r6, r2               ; digit
        imm   r2, 48
        add   r6, r2
        mov   r7, r5
        add   r7, r4
        storeb r7, r6
        imm   r2, 1
        add   r4, r2
        imm   r2, 10
        div   r3, r2
        jmp   ed_collect
ed_emit:
        imm   r2, 0
        jeq   r4, r2, ed_done
        imm   r2, 1
        sub   r4, r2
        mov   r7, r5
        add   r7, r4
        loadb r6, r7
        write r6
        jmp   ed_emit
ed_done:
        ret
ed_zero:
        imm   r0, 48
        write r0
        ret

; ---------------- emit_r0r4 / emit_r4r5 ----------------
emit_r0r4:
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 48
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 52
        write r0
        imm   r0, 10
        write r0
        ret
emit_r4r5:
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 52
        write r0
        imm   r0, 44
        write r0
        imm   r0, 32
        write r0
        imm   r0, 114
        write r0
        imm   r0, 53
        write r0
        imm   r0, 10
        write r0
        ret

; ---------------- advance / skip_spaces / copy_digits ----------------
advance:
        imm   r1, 524368
        load  r0, r1               ; PUSHED
        imm   r2, 0
        jeq   r0, r2, adv_read
        imm   r2, 0
        store r1, r2               ; clear PUSHED
        imm   r1, 524288
        store r1, r0               ; LA = pushed char
        ret
adv_read:
        read  r0
        imm   r1, 524288
        store r1, r0
        ret
skip_spaces:
        imm   r1, 524288
        load  r0, r1
        imm   r2, 32
        jeq   r0, r2, ss_adv
        imm   r2, 10
        jeq   r0, r2, ss_adv
        imm   r2, 13
        jeq   r0, r2, ss_adv
        imm   r2, 9
        jeq   r0, r2, ss_adv
        imm   r2, 35
        jeq   r0, r2, ss_comment    ; '#' -> line comment
        ret
ss_adv:
        call  advance
        jmp   skip_spaces
ss_comment:
        call  advance               ; consume '#', then run to end of line
        imm   r1, 524288
        load  r0, r1
        imm   r2, 0
        jlt   r0, r2, ss_cdone       ; EOF ends the comment
        imm   r2, 10
        jeq   r0, r2, skip_spaces    ; newline ends the comment; resume skipping
        jmp   ss_comment
ss_cdone:
        ret
copy_digits:
        imm   r1, 524288
        load  r0, r1
        imm   r2, 48
        jlt   r0, r2, cd_done
        imm   r2, 57
        jlt   r2, r0, cd_done
        write r0
        call  advance
        jmp   copy_digits
cd_done:
        ret

