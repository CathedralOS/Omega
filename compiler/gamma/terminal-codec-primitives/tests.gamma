; Focused executable contract for current terminal-codec envelope, scalars,
; and canonical UTF-8 strings.

(def bytes_equal ((left Bytes) (right Bytes)) Int
  (match left
    (BNil (match right (BNil 1) ((B h t) 0)))
    ((B first rest)
      (match right
        (BNil 0)
        ((B other tail) (if (eq first other) (bytes_equal rest tail) 0))))))

(def rutf8_exact_empty ((result RUtf8) (want Bytes)) Int
  (match result
    (RUtf8Bad 0)
    ((RUtf8 got rest)
      (if (bytes_equal got want) (match rest (BNil 1) ((B h t) 0)) 0))))

(def rutf8_exact_one ((result RUtf8) (want Bytes) (tail Int)) Int
  (match result
    (RUtf8Bad 0)
    ((RUtf8 got rest)
      (if (bytes_equal got want)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def rutf8_bad ((result RUtf8)) Int
  (match result (RUtf8Bad 1) ((RUtf8 got rest) 0)))

(def rheader_exact_one ((result RTerminalHeader) (tail Int)) Int
  (match result
    (RTerminalHeaderBad 0)
    ((RTerminalHeader vocabulary rest)
      (if (eq vocabulary 16)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def rheader_bad ((result RTerminalHeader)) Int
  (match result
    (RTerminalHeaderBad 1)
    ((RTerminalHeader vocabulary rest) 0)))

(def terminal_header_positive_test () Int
  (rheader_exact_one
    (read_terminal_header
      (B 80 (B 83 (B 73 (B 84 (B 69 (B 82 (B 77 (B 0
        (B 11 (B 0 (B 16 (B 0 (B 9 BNil))))))))))))))
    9))

(def terminal_header_negative_test () Int
  (if (rheader_bad
        (read_terminal_header
          (B 81 (B 83 (B 73 (B 84 (B 69 (B 82 (B 77 (B 0
            (B 11 (B 0 (B 16 (B 0 BNil))))))))))))))
    (if (rheader_bad
          (read_terminal_header
            (B 80 (B 83 (B 73 (B 84 (B 69 (B 82 (B 77 (B 0
              (B 10 (B 0 (B 16 (B 0 BNil))))))))))))))
      (if (rheader_bad
            (read_terminal_header
              (B 80 (B 83 (B 73 (B 84 (B 69 (B 82 (B 77 (B 0
                (B 11 (B 0 (B 15 (B 0 BNil))))))))))))))
        (if (rheader_bad
              (read_terminal_header
                (B 80 (B 83 (B 73 (B 84 (B 69 (B 82 (B 77 (B 0
                  (B 11 BNil)))))))))))
          1 0)
        0)
      0)
    0))

(def rint_exact_one ((result RInt) (want Int) (tail Int)) Int
  (match result
    (RIntBad 0)
    ((RInt got rest)
      (if (eq got want)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def roptional_none_one ((result ROptionalU64) (tail Int)) Int
  (match result
    (ROptionalU64Bad 0)
    ((ROptionalU64Some value rest) 0)
    ((ROptionalU64None rest)
      (match rest
        (BNil 0)
        ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0))))))

(def roptional_some_one
  ((result ROptionalU64) (want U64) (tail Int)) Int
  (match result
    (ROptionalU64Bad 0)
    ((ROptionalU64None rest) 0)
    ((ROptionalU64Some got rest)
      (if (u64_equal got want)
        (match rest
          (BNil 0)
          ((B h t) (if (eq h tail) (match t (BNil 1) ((B x xs) 0)) 0)))
        0))))

(def roptional_bad ((result ROptionalU64)) Int
  (match result
    (ROptionalU64Bad 1)
    ((ROptionalU64None rest) 0)
    ((ROptionalU64Some value rest) 0)))

(def terminal_scalar_positive_test () Int
  (if (rint_exact_one (read_terminal_boolean (B 0 (B 9 BNil))) 0 9)
    (if (rint_exact_one (read_terminal_boolean (B 1 (B 9 BNil))) 1 9)
      (if (roptional_none_one
            (read_optional_semantic_id (B 0 (B 9 BNil))) 9)
        (roptional_some_one
          (read_optional_semantic_id
            (B 1 (B 255 (B 255 (B 255 (B 255
              (B 255 (B 255 (B 255 (B 255 (B 9 BNil)))))))))))
          (U64 4294967295 4294967295) 9)
        0)
      0)
    0))

(def terminal_scalar_negative_test () Int
  (if (match (read_terminal_boolean (B 2 BNil))
        (RIntBad 1) ((RInt value rest) 0))
    (if (match (read_terminal_boolean BNil)
          (RIntBad 1) ((RInt value rest) 0))
      (if (roptional_bad (read_optional_semantic_id (B 2 BNil)))
        (if (roptional_bad
              (read_optional_semantic_id
                (B 1 (B 0 (B 0 (B 0 (B 0 (B 0 (B 0 (B 0 (B 0 BNil)))))))))))
          (if (roptional_bad
                (read_optional_semantic_id (B 1 (B 1 (B 0 BNil)))))
            1 0)
          0)
        0)
      0)
    0))

(def terminal_utf8_positive_test () Int
  (if (rutf8_exact_empty (read_utf8_string (B 0 (B 0 (B 0 (B 0 BNil))))) BNil)
    (if (rutf8_exact_empty
          (read_utf8_string (B 2 (B 0 (B 0 (B 0 (B 65 (B 0 BNil)))))))
          (B 65 (B 0 BNil)))
      (if (rutf8_exact_empty
            (read_utf8_string (B 2 (B 0 (B 0 (B 0 (B 194 (B 162 BNil)))))))
            (B 194 (B 162 BNil)))
        (if (rutf8_exact_empty
              (read_utf8_string
                (B 3 (B 0 (B 0 (B 0 (B 226 (B 130 (B 172 BNil))))))))
              (B 226 (B 130 (B 172 BNil))))
          (if (rutf8_exact_one
                (read_utf8_string
                  (B 4 (B 0 (B 0 (B 0
                    (B 240 (B 159 (B 152 (B 128 (B 9 BNil))))))))))
                (B 240 (B 159 (B 152 (B 128 BNil)))) 9)
            1 0)
          0)
        0)
      0)
    0))

(def terminal_utf8_negative_test () Int
  (if (rutf8_bad
        (read_utf8_string (B 2 (B 0 (B 0 (B 0 (B 192 (B 128 BNil))))))))
    (if (rutf8_bad
          (read_utf8_string
            (B 3 (B 0 (B 0 (B 0 (B 224 (B 128 (B 128 BNil)))))))))
      (if (rutf8_bad
            (read_utf8_string
              (B 3 (B 0 (B 0 (B 0 (B 237 (B 160 (B 128 BNil)))))))))
        (if (rutf8_bad
              (read_utf8_string
                (B 4 (B 0 (B 0 (B 0
                  (B 244 (B 144 (B 128 (B 128 BNil))))))))))
          (if (rutf8_bad
                (read_utf8_string (B 1 (B 0 (B 0 (B 0 (B 128 BNil)))))))
            (if (rutf8_bad
                  (read_utf8_string
                    (B 4 (B 0 (B 0 (B 0 (B 240 (B 159 (B 152 BNil)))))))))
              (if (rutf8_bad (read_utf8_string (B 1 (B 0 (B 16 (B 0 BNil))))))
                1 0)
              0)
            0)
          0)
        0)
      0)
    0))

(def terminal_codec_primitives_self_test () Int
  (if (terminal_header_positive_test)
    (if (terminal_header_negative_test)
      (if (terminal_scalar_positive_test)
        (if (terminal_scalar_negative_test)
          (if (terminal_utf8_positive_test) (terminal_utf8_negative_test) 0)
          0)
        0)
      0)
    0))
