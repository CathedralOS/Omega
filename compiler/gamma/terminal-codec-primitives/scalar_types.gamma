; Complete terminal-Psi scalar-type wire grammar.

(def valid_terminal_integer_width ((bits Int)) Int
  (if (lt bits 1) 0 (if (lt 128 bits) 0 1)))

(def terminal_integer_type_equal
  ((left TerminalIntegerType) (right TerminalIntegerType)) Int
  (match left
    ((TerminalFixedSigned left_bits)
      (match right
        ((TerminalFixedSigned right_bits) (eq left_bits right_bits))
        ((TerminalFixedUnsigned right_bits) 0)
        ((TerminalAddress right_bits) 0)))
    ((TerminalFixedUnsigned left_bits)
      (match right
        ((TerminalFixedSigned right_bits) 0)
        ((TerminalFixedUnsigned right_bits) (eq left_bits right_bits))
        ((TerminalAddress right_bits) 0)))
    ((TerminalAddress left_bits)
      (match right
        ((TerminalFixedSigned right_bits) 0)
        ((TerminalFixedUnsigned right_bits) 0)
        ((TerminalAddress right_bits) (eq left_bits right_bits))))))

(def terminal_scalar_type_equal
  ((left TerminalScalarType) (right TerminalScalarType)) Int
  (match left
    (TerminalBoolean
      (match right (TerminalBoolean 1) ((TerminalInteger integer) 0)))
    ((TerminalInteger left_integer)
      (match right
        (TerminalBoolean 0)
        ((TerminalInteger right_integer)
          (terminal_integer_type_equal left_integer right_integer))))))

(def read_terminal_integer_type ((bs Bytes)) RTerminalIntegerType
  (match (read_u8 bs)
    (RIntBad RTerminalIntegerTypeBad)
    ((RInt tag r1)
      (match (read_u16 r1)
        (RIntBad RTerminalIntegerTypeBad)
        ((RInt bits rest)
          (if (valid_terminal_integer_width bits)
            (if (eq tag 1)
              (RTerminalIntegerType (TerminalFixedSigned bits) rest)
              (if (eq tag 2)
                (RTerminalIntegerType (TerminalFixedUnsigned bits) rest)
                (if (eq tag 3)
                  (RTerminalIntegerType (TerminalAddress bits) rest)
                  RTerminalIntegerTypeBad)))
            RTerminalIntegerTypeBad))))))

(def read_terminal_scalar_type ((bs Bytes)) RTerminalScalarType
  (match (read_u8 bs)
    (RIntBad RTerminalScalarTypeBad)
    ((RInt tag rest)
      (if (eq tag 1) (RTerminalScalarType TerminalBoolean rest)
        (if (eq tag 2)
          (match (read_terminal_integer_type rest)
            (RTerminalIntegerTypeBad RTerminalScalarTypeBad)
            ((RTerminalIntegerType integer tail)
              (RTerminalScalarType (TerminalInteger integer) tail)))
          RTerminalScalarTypeBad)))))
