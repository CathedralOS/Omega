; Exact current terminal-Psi envelope prefix.
;
; The deployment codec accepts one eight-byte magic, format marker 18, and the
; single current semantic vocabulary marker 20.  This parser consumes no module
; body bytes and retains the accepted vocabulary marker explicitly.

(def read_terminal_header ((bs Bytes)) RTerminalHeader
  (match (expect_byte bs 80)
    (RBytesBad RTerminalHeaderBad)
    ((RBytes a)
      (match (expect_byte a 83)
        (RBytesBad RTerminalHeaderBad)
        ((RBytes b)
          (match (expect_byte b 73)
            (RBytesBad RTerminalHeaderBad)
            ((RBytes c)
              (match (expect_byte c 84)
                (RBytesBad RTerminalHeaderBad)
                ((RBytes d)
                  (match (expect_byte d 69)
                    (RBytesBad RTerminalHeaderBad)
                    ((RBytes e)
                      (match (expect_byte e 82)
                        (RBytesBad RTerminalHeaderBad)
                        ((RBytes f)
                          (match (expect_byte f 77)
                            (RBytesBad RTerminalHeaderBad)
                            ((RBytes g)
                              (match (expect_byte g 0)
                                (RBytesBad RTerminalHeaderBad)
                                ((RBytes r1)
                                  (match (read_u16 r1)
                                    (RIntBad RTerminalHeaderBad)
                                    ((RInt format r2)
                                      (if (eq format 18)
                                        (match (read_u16 r2)
                                          (RIntBad RTerminalHeaderBad)
                                          ((RInt vocabulary rest)
                                            (if (eq vocabulary 20)
                                              (RTerminalHeader vocabulary rest)
                                              RTerminalHeaderBad)))
                                        RTerminalHeaderBad))))))))))))))))))))
