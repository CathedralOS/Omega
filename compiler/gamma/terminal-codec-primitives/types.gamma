; Shared terminal-codec result vocabulary layered over canonical Bytes.

(data RUtf8 (RUtf8 Bytes Bytes) (RUtf8Bad))
(data RTerminalHeader
  (RTerminalHeader Int Bytes)                 ; vocabulary marker, unread tail
  (RTerminalHeaderBad))
(data ROptionalU64
  (ROptionalU64None Bytes)
  (ROptionalU64Some U64 Bytes)
  (ROptionalU64Bad))
(data TerminalIntegerType
  (TerminalFixedSigned Int)
  (TerminalFixedUnsigned Int)
  (TerminalAddress Int))
(data TerminalScalarType
  (TerminalBoolean)
  (TerminalInteger TerminalIntegerType))
(data RTerminalIntegerType
  (RTerminalIntegerType TerminalIntegerType Bytes)
  (RTerminalIntegerTypeBad))
(data RTerminalScalarType
  (RTerminalScalarType TerminalScalarType Bytes)
  (RTerminalScalarTypeBad))
(data TerminalIntegerValue
  (TerminalSignedValue U128)
  (TerminalUnsignedValue U128))
(data RTerminalIntegerValue
  (RTerminalIntegerValue TerminalIntegerValue Bytes)
  (RTerminalIntegerValueBad))
