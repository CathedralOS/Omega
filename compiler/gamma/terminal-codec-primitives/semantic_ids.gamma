; Exact terminal semantic identities over the complete unsigned 64-bit carrier.
;
; Consumers must not collapse these identities into Gamma's signed Int.  The
; explicit wrapper also prevents counts, tags, and byte offsets from being used
; accidentally as semantic identities in the production ledger decoder.

(def read_terminal_semantic_id ((bs Bytes)) RTerminalSemanticId
  (match (read_nonzero_u64 bs)
    (RU64Bad RTerminalSemanticIdBad)
    ((RU64 value rest)
      (RTerminalSemanticId (TerminalSemanticId value) rest))))

(def terminal_semantic_id_equal
  ((left TerminalSemanticId) (right TerminalSemanticId)) Int
  (match left
    ((TerminalSemanticId left-value)
      (match right
        ((TerminalSemanticId right-value)
          (u64_equal left-value right-value))))))

; Both halves are canonical nonnegative u32 values, so Gamma's signed Int
; comparison is an exact unsigned comparison for each half.
(def terminal_semantic_id_less
  ((left TerminalSemanticId) (right TerminalSemanticId)) Int
  (match left
    ((TerminalSemanticId left-value)
      (match right
        ((TerminalSemanticId right-value)
          (u64_less left-value right-value))))))
