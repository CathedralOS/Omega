; Exact v18 grammar for structural IEEE/byte-sequence and sum
; case-membership proposition leaves, including exact case-payload paths.
; It preserves full-width identities and indices and checks only byte-level
; canonical form.  Declared structural types and semantic leaf meaning remain
; responsibilities of the eventual complete ledger generator.

(def read_terminal_ieee_float_comparison_kind
  ((bs Bytes)) RTerminalIeeeFloatComparisonKind
  (match (read_u8 bs)
    (RIntBad RTerminalIeeeFloatComparisonKindBad)
    ((RInt tag rest)
      (if (eq tag 1)
        (RTerminalIeeeFloatComparisonKind TerminalIeeeEqual rest)
        (if (eq tag 2)
          (RTerminalIeeeFloatComparisonKind TerminalIeeeNotEqual rest)
          RTerminalIeeeFloatComparisonKindBad)))))

(def read_terminal_ieee_float_format ((bs Bytes)) RTerminalIeeeFloatFormat
  (match (read_u8 bs)
    (RIntBad RTerminalIeeeFloatFormatBad)
    ((RInt tag rest)
      (if (eq tag 1)
        (RTerminalIeeeFloatFormat TerminalIeeeBinary32 rest)
        (if (eq tag 2)
          (RTerminalIeeeFloatFormat TerminalIeeeBinary64 rest)
          RTerminalIeeeFloatFormatBad)))))

(def read_terminal_byte_sequence_carrier
  ((bs Bytes)) RTerminalByteSequenceCarrier
  (match (read_u8 bs)
    (RIntBad RTerminalByteSequenceCarrierBad)
    ((RInt tag rest)
      (if (eq tag 1)
        (RTerminalByteSequenceCarrier TerminalBorrowedByteView rest)
        (if (eq tag 2)
          (match (read_u64 rest)
            (RU64Bad RTerminalByteSequenceCarrierBad)
            ((RU64 capacity tail)
              (RTerminalByteSequenceCarrier
                (TerminalBoundedOwnedBytes capacity) tail)))
          RTerminalByteSequenceCarrierBad)))))

(def read_terminal_canonical_structural_path_n
  ((bs Bytes) (count Int)) RTerminalCanonicalStructuralPath
  (if (eq count 0)
    (RTerminalCanonicalStructuralPath TerminalStructuralPathNil bs)
    (match (read_u8 bs)
      (RIntBad RTerminalCanonicalStructuralPathBad)
      ((RInt tag rest)
        (if (eq tag 1)
          (match (read_terminal_semantic_id rest)
            (RTerminalSemanticIdBad RTerminalCanonicalStructuralPathBad)
            ((RTerminalSemanticId field tail)
              (match
                (read_terminal_canonical_structural_path_n tail (- count 1))
                (RTerminalCanonicalStructuralPathBad
                  RTerminalCanonicalStructuralPathBad)
                ((RTerminalCanonicalStructuralPath path end)
                  (RTerminalCanonicalStructuralPath
                    (TerminalStructuralPathCons
                      (TerminalStructuralField field) path)
                    end)))))
          (if (eq tag 2)
            (match (read_u64 rest)
              (RU64Bad RTerminalCanonicalStructuralPathBad)
              ((RU64 index tail)
                (match
                  (read_terminal_canonical_structural_path_n tail (- count 1))
                  (RTerminalCanonicalStructuralPathBad
                    RTerminalCanonicalStructuralPathBad)
                  ((RTerminalCanonicalStructuralPath path end)
                    (RTerminalCanonicalStructuralPath
                      (TerminalStructuralPathCons
                        (TerminalStructuralFixedIndex index) path)
                      end)))))
            (if (eq tag 3)
              (match (read_terminal_semantic_id rest)
                (RTerminalSemanticIdBad RTerminalCanonicalStructuralPathBad)
                ((RTerminalSemanticId case-id tail)
                  (match
                    (read_terminal_canonical_structural_path_n tail (- count 1))
                    (RTerminalCanonicalStructuralPathBad
                      RTerminalCanonicalStructuralPathBad)
                    ((RTerminalCanonicalStructuralPath path end)
                      (RTerminalCanonicalStructuralPath
                        (TerminalStructuralPathCons
                          (TerminalStructuralCase case-id) path)
                        end)))))
              RTerminalCanonicalStructuralPathBad)))))))

(def read_terminal_canonical_structural_path
  ((bs Bytes)) RTerminalCanonicalStructuralPath
  (match (read_u32 bs)
    (RIntBad RTerminalCanonicalStructuralPathBad)
    ((RInt count rest)
      (read_terminal_canonical_structural_path_n rest count))))

(def read_terminal_canonical_structural_field
  ((bs Bytes)) RTerminalCanonicalStructuralField
  (match (read_terminal_semantic_id bs)
    (RTerminalSemanticIdBad RTerminalCanonicalStructuralFieldBad)
    ((RTerminalSemanticId root rest)
      (match (read_terminal_canonical_structural_path rest)
        (RTerminalCanonicalStructuralPathBad RTerminalCanonicalStructuralFieldBad)
        ((RTerminalCanonicalStructuralPath path tail)
          (RTerminalCanonicalStructuralField
            (TerminalCanonicalStructuralField root path) tail))))))

(def terminal_canonical_structural_path_nonempty
  ((path TerminalCanonicalStructuralPath)) Int
  (match path
    (TerminalStructuralPathNil 0)
    ((TerminalStructuralPathCons head tail) 1)))

(def terminal_canonical_structural_segment_equal
  ((left TerminalCanonicalStructuralPathSegment)
   (right TerminalCanonicalStructuralPathSegment)) Int
  (match left
    ((TerminalStructuralField left-id)
      (match right
        ((TerminalStructuralField right-id)
          (terminal_semantic_id_equal left-id right-id))
        ((TerminalStructuralFixedIndex right-index) 0)
        ((TerminalStructuralCase right-id) 0)))
    ((TerminalStructuralFixedIndex left-index)
      (match right
        ((TerminalStructuralField right-id) 0)
        ((TerminalStructuralFixedIndex right-index)
          (u64_equal left-index right-index))
        ((TerminalStructuralCase right-id) 0)))
    ((TerminalStructuralCase left-id)
      (match right
        ((TerminalStructuralField right-id) 0)
        ((TerminalStructuralFixedIndex right-index) 0)
        ((TerminalStructuralCase right-id)
          (terminal_semantic_id_equal left-id right-id))))))

(def terminal_canonical_structural_segment_less
  ((left TerminalCanonicalStructuralPathSegment)
   (right TerminalCanonicalStructuralPathSegment)) Int
  (match left
    ((TerminalStructuralField left-id)
      (match right
        ((TerminalStructuralField right-id)
          (terminal_semantic_id_less left-id right-id))
        ((TerminalStructuralFixedIndex right-index) 1)
        ((TerminalStructuralCase right-id) 1)))
    ((TerminalStructuralFixedIndex left-index)
      (match right
        ((TerminalStructuralField right-id) 0)
        ((TerminalStructuralFixedIndex right-index)
          (u64_less left-index right-index))
        ((TerminalStructuralCase right-id) 1)))
    ((TerminalStructuralCase left-id)
      (match right
        ((TerminalStructuralField right-id) 0)
        ((TerminalStructuralFixedIndex right-index) 0)
        ((TerminalStructuralCase right-id)
          (terminal_semantic_id_less left-id right-id))))))

(def terminal_canonical_structural_path_equal
  ((left TerminalCanonicalStructuralPath)
   (right TerminalCanonicalStructuralPath)) Int
  (match left
    (TerminalStructuralPathNil
      (match right
        (TerminalStructuralPathNil 1)
        ((TerminalStructuralPathCons head tail) 0)))
    ((TerminalStructuralPathCons left-head left-tail)
      (match right
        (TerminalStructuralPathNil 0)
        ((TerminalStructuralPathCons right-head right-tail)
          (if (terminal_canonical_structural_segment_equal left-head right-head)
            (terminal_canonical_structural_path_equal left-tail right-tail)
            0))))))

(def terminal_canonical_structural_path_less
  ((left TerminalCanonicalStructuralPath)
   (right TerminalCanonicalStructuralPath)) Int
  (match left
    (TerminalStructuralPathNil
      (match right
        (TerminalStructuralPathNil 0)
        ((TerminalStructuralPathCons head tail) 1)))
    ((TerminalStructuralPathCons left-head left-tail)
      (match right
        (TerminalStructuralPathNil 0)
        ((TerminalStructuralPathCons right-head right-tail)
          (if (terminal_canonical_structural_segment_equal left-head right-head)
            (terminal_canonical_structural_path_less left-tail right-tail)
            (terminal_canonical_structural_segment_less left-head right-head)))))))

(def terminal_canonical_structural_field_equal
  ((left TerminalCanonicalStructuralField)
   (right TerminalCanonicalStructuralField)) Int
  (match left
    ((TerminalCanonicalStructuralField left-root left-path)
      (match right
        ((TerminalCanonicalStructuralField right-root right-path)
          (if (terminal_semantic_id_equal left-root right-root)
            (terminal_canonical_structural_path_equal left-path right-path)
            0))))))

(def terminal_canonical_structural_field_less
  ((left TerminalCanonicalStructuralField)
   (right TerminalCanonicalStructuralField)) Int
  (match left
    ((TerminalCanonicalStructuralField left-root left-path)
      (match right
        ((TerminalCanonicalStructuralField right-root right-path)
          (if (terminal_semantic_id_equal left-root right-root)
            (terminal_canonical_structural_path_less left-path right-path)
            (terminal_semantic_id_less left-root right-root)))))))

(def terminal_canonical_structural_field_nonempty
  ((field TerminalCanonicalStructuralField)) Int
  (match field
    ((TerminalCanonicalStructuralField root path)
      (terminal_canonical_structural_path_nonempty path))))

(def terminal_canonical_structural_field_pair
  ((left TerminalCanonicalStructuralField)
   (right TerminalCanonicalStructuralField)) Int
  (if (terminal_canonical_structural_field_nonempty left)
    (if (terminal_canonical_structural_field_nonempty right)
      (eq (terminal_canonical_structural_field_less right left) 0)
      0)
    0))

(def read_terminal_structural_leaf_proposition
  ((bs Bytes)) RTerminalStructuralLeafProposition
  (match (read_u8 bs)
    (RIntBad RTerminalStructuralLeafPropositionBad)
    ((RInt tag rest)
      (if (eq tag 11)
        (match (read_terminal_ieee_float_comparison_kind rest)
          (RTerminalIeeeFloatComparisonKindBad RTerminalStructuralLeafPropositionBad)
          ((RTerminalIeeeFloatComparisonKind kind r1)
            (match (read_terminal_ieee_float_format r1)
              (RTerminalIeeeFloatFormatBad RTerminalStructuralLeafPropositionBad)
              ((RTerminalIeeeFloatFormat format r2)
                (match (read_terminal_canonical_structural_field r2)
                  (RTerminalCanonicalStructuralFieldBad
                    RTerminalStructuralLeafPropositionBad)
                  ((RTerminalCanonicalStructuralField left r3)
                    (match (read_terminal_canonical_structural_field r3)
                      (RTerminalCanonicalStructuralFieldBad
                        RTerminalStructuralLeafPropositionBad)
                      ((RTerminalCanonicalStructuralField right tail)
                        (if (terminal_canonical_structural_field_pair left right)
                          (RTerminalStructuralLeafProposition
                            (TerminalIeeeFloatComparison kind format left right)
                            tail)
                          RTerminalStructuralLeafPropositionBad)))))))))
        (if (eq tag 12)
          (match (read_terminal_canonical_structural_field rest)
            (RTerminalCanonicalStructuralFieldBad
              RTerminalStructuralLeafPropositionBad)
            ((RTerminalCanonicalStructuralField left r1)
              (match (read_terminal_canonical_structural_field r1)
                (RTerminalCanonicalStructuralFieldBad
                  RTerminalStructuralLeafPropositionBad)
                ((RTerminalCanonicalStructuralField right tail)
                  (if (terminal_canonical_structural_field_pair left right)
                    (RTerminalStructuralLeafProposition
                      (TerminalByteSequenceEqual left right) tail)
                    RTerminalStructuralLeafPropositionBad)))))
          (if (eq tag 13)
            (match (read_terminal_canonical_structural_field rest)
              (RTerminalCanonicalStructuralFieldBad
                RTerminalStructuralLeafPropositionBad)
              ((RTerminalCanonicalStructuralField subject r1)
                (match (read_terminal_semantic_id r1)
                  (RTerminalSemanticIdBad RTerminalStructuralLeafPropositionBad)
                  ((RTerminalSemanticId case-id tail)
                    (RTerminalStructuralLeafProposition
                      (TerminalStructuralCaseMembership subject case-id) tail)))))
            RTerminalStructuralLeafPropositionBad))))))
