; Exact terminal-codec UTF-8 string decoding.
;
; The Rust codec writes a little-endian u32 byte count, rejects counts above
; 1 MiB, and then requires the exact byte slice to be canonical UTF-8.  This
; low-rung definition retains the original bytes; it does not normalize text.

(def byte_between ((value Int) (low Int) (high Int)) Int
  (if (lt value low) 0 (if (lt high value) 0 1)))

(def utf8_continuation ((value Int)) Int (byte_between value 128 191))

(def utf8_second_of_three ((lead Int) (second Int)) Int
  (if (eq lead 224) (byte_between second 160 191)
    (if (eq lead 237) (byte_between second 128 159)
      (utf8_continuation second))))

(def utf8_second_of_four ((lead Int) (second Int)) Int
  (if (eq lead 240) (byte_between second 144 191)
    (if (eq lead 244) (byte_between second 128 143)
      (utf8_continuation second))))

(def read_utf8_n ((bs Bytes) (n Int)) RUtf8
  (if (eq n 0) (RUtf8 BNil bs)
    (match (read_u8 bs)
      (RIntBad RUtf8Bad)
      ((RInt first rest)
        (if (lt first 128)
          (match (read_utf8_n rest (- n 1))
            (RUtf8Bad RUtf8Bad)
            ((RUtf8 suffix end) (RUtf8 (B first suffix) end)))
          (if (byte_between first 194 223)
            (if (lt n 2) RUtf8Bad
              (match (read_u8 rest)
                (RIntBad RUtf8Bad)
                ((RInt second tail)
                  (if (utf8_continuation second)
                    (match (read_utf8_n tail (- n 2))
                      (RUtf8Bad RUtf8Bad)
                      ((RUtf8 suffix end)
                        (RUtf8 (B first (B second suffix)) end)))
                    RUtf8Bad))))
            (if (byte_between first 224 239)
              (if (lt n 3) RUtf8Bad
                (match (read_u8 rest)
                  (RIntBad RUtf8Bad)
                  ((RInt second r2)
                    (match (read_u8 r2)
                      (RIntBad RUtf8Bad)
                      ((RInt third tail)
                        (if (if (utf8_second_of_three first second)
                              (utf8_continuation third) 0)
                          (match (read_utf8_n tail (- n 3))
                            (RUtf8Bad RUtf8Bad)
                            ((RUtf8 suffix end)
                              (RUtf8
                                (B first (B second (B third suffix))) end)))
                          RUtf8Bad))))))
              (if (byte_between first 240 244)
                (if (lt n 4) RUtf8Bad
                  (match (read_u8 rest)
                    (RIntBad RUtf8Bad)
                    ((RInt second r2)
                      (match (read_u8 r2)
                        (RIntBad RUtf8Bad)
                        ((RInt third r3)
                          (match (read_u8 r3)
                            (RIntBad RUtf8Bad)
                            ((RInt fourth tail)
                              (if (if (utf8_second_of_four first second)
                                    (if (utf8_continuation third)
                                      (utf8_continuation fourth) 0) 0)
                                (match (read_utf8_n tail (- n 4))
                                  (RUtf8Bad RUtf8Bad)
                                  ((RUtf8 suffix end)
                                    (RUtf8
                                      (B first (B second
                                        (B third (B fourth suffix)))) end)))
                                RUtf8Bad))))))))
                RUtf8Bad))))))))

(def read_utf8_string ((bs Bytes)) RUtf8
  (match (read_u32 bs)
    (RIntBad RUtf8Bad)
    ((RInt count rest)
      (if (lt 1048576 count) RUtf8Bad (read_utf8_n rest count)))))
