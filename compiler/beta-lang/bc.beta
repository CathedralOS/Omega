; bc.beta — the Beta compiler, WRITTEN IN BETA.  (slice 2a: named locals)
;
; Reads Beta source on stdin, emits Alpha assembly on stdout — the self-hosting
; path (slice 7): once bc compiles its own source to a fixed point, Rust leaves
; the lineage. Built slice-by-slice, mirroring beta-lang-rs.
;
;   slice 1  : proc main() { return <arith> }
;   slice 2a : + `let` locals, assignment, variable references  (THIS)
;
; Single pass with one pre-scan: to emit the prologue's frame allocation we must
; know how many locals the proc has, so count_lets() scans the body once before
; codegen. Locals are addressed at [fp - 8 - 8*slot], matching the on-ramp.
;
; emit() costs ~12 tape bytes/char, so bc emits COMPACT asm (no indent, commas
; attached — the assembler treats those as whitespace) to stay within the hole.
;
; Fixed memory (above the 1 MiB data stack):
;   2097152 SRC    source bytes        2097144 CUR    cursor (index into SRC)
;   2097136 LEN    source length       2097128 NLOC   declared local count
;   2097120 IDOFF  last ident offset    2097112 IDLEN  last ident length
;   3145728 NAMEOFF[i] (word)          3153920 NAMELEN[i] (word)   ; i = slot

; ---------------- reading the source ----------------

proc slurp() {
    let n = 0
    let c = read_byte()
    while c >= 0 {
        byte[2097152 + n] = c
        n = n + 1
        c = read_byte()
    }
    word[2097136] = n        ; LEN
    word[2097144] = 0        ; CUR
    word[2097128] = 0        ; NLOC
    word[2097104] = 0        ; LBL (label counter)
}

proc new_label() {
    let n = word[2097104]
    word[2097104] = n + 1
    return n
}

proc emit_lref(n) {          ; emit a label name _L<n>
    emit("_L")
    emit_dec(n)
}

proc cur() {
    return word[2097144]
}

proc cbyte() {               ; byte at cursor, or 0 past end
    let i = word[2097144]
    if i < word[2097136] {
        return byte[2097152 + i]
    }
    return 0
}

proc adv() {
    word[2097144] = word[2097144] + 1
}

; ---------------- character classes ----------------

proc is_digit(c) {
    if c < '0' {
        return 0
    }
    if c > '9' {
        return 0
    }
    return 1
}

proc is_alpha(c) {
    if c == '_' {
        return 1
    }
    if c < 'A' {
        return 0
    }
    if c <= 'Z' {
        return 1
    }
    if c < 'a' {
        return 0
    }
    if c <= 'z' {
        return 1
    }
    return 0
}

proc is_alnum(c) {
    if is_alpha(c) == 1 {
        return 1
    }
    return is_digit(c)
}

proc is_space(c) {
    if c == ' ' {
        return 1
    }
    if c == 9 {
        return 1
    }
    if c == 10 {
        return 1
    }
    if c == 13 {
        return 1
    }
    return 0
}

; ---------------- tokenizer ----------------

proc skip_ws() {             ; spaces, newlines, and ;-to-end-of-line comments
    while skip_ws_step() == 1 {
    }
}

proc skip_ws_step() {        ; advance over one ws/comment run; 1 if it did, else 0
    let c = cbyte()
    if is_space(c) == 1 {
        adv()
        return 1
    }
    if c == ';' {
        while cbyte() != 10 {
            if cbyte() == 0 {
                return 0
            }
            adv()
        }
        return 1
    }
    return 0
}

proc read_ident() {          ; cursor at an alpha; record IDOFF/IDLEN, consume it
    word[2097120] = word[2097144]                  ; IDOFF = CUR
    while is_alnum(cbyte()) == 1 {
        adv()
    }
    word[2097112] = word[2097144] - word[2097120]  ; IDLEN = CUR - IDOFF
}

; does the last-read ident (IDOFF/IDLEN) equal a keyword?
proc id_char(k) {            ; k-th byte of the current ident
    return byte[2097152 + word[2097120] + k]
}

proc is_let() {
    if word[2097112] == 3 {
        if id_char(0) == 'l' {
            if id_char(1) == 'e' {
                if id_char(2) == 't' {
                    return 1
                }
            }
        }
    }
    return 0
}

proc is_return() {
    if word[2097112] == 6 {
        if id_char(0) == 'r' {
            if id_char(1) == 'e' {
                if id_char(2) == 't' {
                    if id_char(3) == 'u' {
                        if id_char(4) == 'r' {
                            if id_char(5) == 'n' {
                                return 1
                            }
                        }
                    }
                }
            }
        }
    }
    return 0
}

proc is_if() {
    if word[2097112] == 2 {
        if id_char(0) == 'i' {
            if id_char(1) == 'f' {
                return 1
            }
        }
    }
    return 0
}

proc is_else() {
    if word[2097112] == 4 {
        if id_char(0) == 'e' {
            if id_char(1) == 'l' {
                if id_char(2) == 's' {
                    if id_char(3) == 'e' {
                        return 1
                    }
                }
            }
        }
    }
    return 0
}

proc is_while() {
    if word[2097112] == 5 {
        if id_char(0) == 'w' {
            if id_char(1) == 'h' {
                if id_char(2) == 'i' {
                    if id_char(3) == 'l' {
                        if id_char(4) == 'e' {
                            return 1
                        }
                    }
                }
            }
        }
    }
    return 0
}

proc is_byte() {
    if word[2097112] == 4 {
        if id_char(0) == 'b' {
            if id_char(1) == 'y' {
                if id_char(2) == 't' {
                    if id_char(3) == 'e' {
                        return 1
                    }
                }
            }
        }
    }
    return 0
}

proc is_word() {
    if word[2097112] == 4 {
        if id_char(0) == 'w' {
            if id_char(1) == 'o' {
                if id_char(2) == 'r' {
                    if id_char(3) == 'd' {
                        return 1
                    }
                }
            }
        }
    }
    return 0
}

proc expect(ch) {            ; skip ws then consume ch if present
    skip_ws()
    if cbyte() == ch {
        adv()
    }
}

proc gen_load(w) {           ; byte[addr] / word[addr] -> r0
    expect('[')
    gen_expr()
    expect(']')
    if w == 1 {
        emit("loadb r0,r0\n")
    } else {
        emit("load r0,r0\n")
    }
    return 0
}

proc gen_store(w) {          ; byte[addr] = val / word[addr] = val
    expect('[')
    gen_expr()               ; addr
    expect(']')
    emit_push()              ; save addr
    expect('=')
    gen_expr()               ; val -> r0
    emit_pop_into(1)         ; r1 = addr
    if w == 1 {
        emit("storeb r1,r0\n")
    } else {
        emit("store r1,r0\n")
    }
    return 0
}

proc gen_call() {            ; f(args): callee name is in IDOFF/IDLEN, cursor at '('
    let nameoff = word[2097120]    ; IDOFF — save before arg parsing clobbers it
    let namelen = word[2097112]    ; IDLEN
    expect('(')
    let nargs = 0
    skip_ws()
    while cbyte() != ')' {
        gen_expr()                 ; stage each arg onto the data stack, left to right
        emit_push()
        nargs = nargs + 1
        skip_ws()
        if cbyte() == ',' {
            adv()
            skip_ws()
        }
    }
    adv()                          ; consume ')'
    let k = nargs                  ; unstage top..bottom into r(nargs-1)..r0
    while k > 0 {
        k = k - 1
        emit_pop_into(k)
    }
    emit("call ")
    emit_ident_at(nameoff, namelen)
    emit("\n")
    return 0
}

proc parse_number() {
    let v = 0
    while is_digit(cbyte()) == 1 {
        v = v * 10 + (cbyte() - '0')
        adv()
    }
    return v
}

; ---------------- symbol table (per-proc locals) ----------------

proc declare() {             ; declare a local named by IDOFF/IDLEN; return its slot
    let s = word[2097128]                          ; NLOC
    word[3145728 + s * 8] = word[2097120]          ; NAMEOFF[s] = IDOFF
    word[3153920 + s * 8] = word[2097112]          ; NAMELEN[s] = IDLEN
    word[2097128] = s + 1
    return s
}

proc name_eq(i) {            ; does local i's name match the current IDOFF/IDLEN?
    if word[3153920 + i * 8] == word[2097112] {
        let a = word[3145728 + i * 8]              ; local i name offset
        let b = word[2097120]                      ; IDOFF
        let len = word[2097112]
        let k = 0
        while k < len {
            if byte[2097152 + a + k] != byte[2097152 + b + k] {
                return 0
            }
            k = k + 1
        }
        return 1
    }
    return 0
}

proc lookup() {              ; slot of the current IDOFF/IDLEN (0 if unknown)
    let n = word[2097128]
    let i = 0
    while i < n {
        if name_eq(i) == 1 {
            return i
        }
        i = i + 1
    }
    return 0
}

; count `let` declarations in the body from the cursor to the matching `}`,
; leaving the cursor unmoved. (Slice 2a programs have no char/string literals.)
proc count_lets() {
    let start = word[2097144]
    let depth = 1
    let count = 0
    while depth > 0 {
        skip_ws()
        let c = cbyte()
        if c == 0 {
            depth = 0
        } else {
            if c == '{' {
                depth = depth + 1
                adv()
            } else {
                if c == '}' {
                    depth = depth - 1
                    adv()
                } else {
                    if is_alpha(c) == 1 {
                        read_ident()
                        if is_let() == 1 {
                            count = count + 1
                        }
                    } else {
                        adv()
                    }
                }
            }
        }
    }
    word[2097144] = start
    return count
}

; ---------------- emit decimal ----------------

proc emit_dec(n) {
    if n >= 10 {
        emit_dec(n / 10)
    }
    write_byte(n % 10 + '0')
}

; ---------------- fixed asm fragments (compact) ----------------

proc emit_prelude() {            ; program entry: init sp/fp, call main, halt
    emit("; bc\n")
    emit("imm r15,1048576\n")
    emit("imm r14,1048576\n")
    emit("call main\n")
    emit("halt r0\n")
}

proc emit_proc_prologue(nslots) {
    emit("imm r2,8\n")
    emit("sub r15,r2\n")
    emit("store r15,r14\n")
    emit("mov r14,r15\n")
    if nslots > 0 {
        emit("imm r2,")
        emit_dec(nslots * 8)
        emit("\n")
        emit("sub r15,r2\n")
    }
}

proc emit_param_store(k) {       ; store arg register r<k> into frame slot k
    emit("mov r5,r14\n")
    emit("imm r4,")
    emit_dec(8 + 8 * k)
    emit("\n")
    emit("sub r5,r4\n")
    emit("store r5,r")
    emit_dec(k)
    emit("\n")
}

proc emit_pop_into(k) {          ; pop the data stack top into r<k>
    emit("load r")
    emit_dec(k)
    emit(",r15\n")
    emit("imm r5,8\n")
    emit("add r15,r5\n")
}

proc emit_ident_at(off, len) {   ; write `len` source bytes starting at SRC[off]
    let k = 0
    while k < len {
        write_byte(byte[2097152 + off + k])
        k = k + 1
    }
}

proc emit_epilogue() {
    emit("mov r15,r14\n")
    emit("load r14,r15\n")
    emit("imm r2,8\n")
    emit("add r15,r2\n")
    emit("ret\n")
}

proc emit_push() {
    emit("imm r2,8\n")
    emit("sub r15,r2\n")
    emit("store r15,r0\n")
}

proc emit_mnemonic(op) {
    if op == '+' {
        emit("add")
    }
    if op == '-' {
        emit("sub")
    }
    if op == '*' {
        emit("mul")
    }
    if op == '/' {
        emit("div")
    }
    if op == '%' {
        emit("mod")
    }
}

proc emit_combine(op) {
    emit("mov r1,r0\n")
    emit("load r0,r15\n")
    emit("imm r5,8\n")
    emit("add r15,r5\n")
    emit_mnemonic(op)
    emit(" r0,r1\n")
}

proc emit_slot_addr(reg, slot) {   ; reg = &slot  (reg is 0 or 1)
    emit("mov r")
    emit_dec(reg)
    emit(",r14\n")
    emit("imm r2,")
    emit_dec(8 + 8 * slot)
    emit("\n")
    emit("sub r")
    emit_dec(reg)
    emit(",r2\n")
}

proc emit_load_slot(slot) {        ; r0 = local[slot]
    emit_slot_addr(0, slot)
    emit("load r0,r0\n")
}

proc emit_store_slot(slot) {       ; local[slot] = r0
    emit_slot_addr(1, slot)
    emit("store r1,r0\n")
}

; ---------------- character classes for operators ----------------

proc is_muldiv(c) {
    if c == '*' {
        return 1
    }
    if c == '/' {
        return 1
    }
    if c == '%' {
        return 1
    }
    return 0
}

proc is_addsub(c) {
    if c == '+' {
        return 1
    }
    if c == '-' {
        return 1
    }
    return 0
}

; ---------------- recursive-descent codegen ----------------

proc gen_factor() {
    skip_ws()
    let c = cbyte()
    if c == '(' {
        adv()
        gen_expr()
        expect(')')
        return 0
    }
    if is_alpha(c) == 1 {
        read_ident()
        if is_byte() == 1 {
            gen_load(1)             ; byte[addr]
            return 0
        }
        if is_word() == 1 {
            gen_load(8)             ; word[addr]
            return 0
        }
        skip_ws()
        if cbyte() == '(' {
            gen_call()              ; f(args) — uses the ident just read as the callee
            return 0
        }
        emit_load_slot(lookup())    ; variable reference
        return 0
    }
    let v = parse_number()
    emit("imm r0,")
    emit_dec(v)
    emit("\n")
    return 0
}

proc gen_term() {
    gen_factor()
    skip_ws()
    while is_muldiv(cbyte()) == 1 {
        let op = cbyte()
        adv()
        emit_push()
        gen_factor()
        emit_combine(op)
        skip_ws()
    }
    return 0
}

proc gen_sum() {
    gen_term()
    skip_ws()
    while is_addsub(cbyte()) == 1 {
        let op = cbyte()
        adv()
        emit_push()
        gen_term()
        emit_combine(op)
        skip_ws()
    }
    return 0
}

; comparison operator at the cursor -> code 0..5 (consumed), or -1 if none.
;   0 '<'   1 '>'   2 '=='   3 '!='   4 '<='   5 '>='
proc cmp_op() {
    let c = cbyte()
    if c == '<' {
        adv()
        if cbyte() == '=' {
            adv()
            return 4
        }
        return 0
    }
    if c == '>' {
        adv()
        if cbyte() == '=' {
            adv()
            return 5
        }
        return 1
    }
    if c == '!' {
        adv()
        adv()                ; '!='
        return 3
    }
    if c == '=' {
        let i = word[2097144]
        if byte[2097152 + i + 1] == '=' {
            adv()
            adv()
            return 2
        }
    }
    return 0 - 1
}

; r0 = right operand; pop left into r0 (right into r1), branch-materialize 0/1.
proc emit_cmp(code) {
    emit("mov r1,r0\n")
    emit("load r0,r15\n")
    emit("imm r5,8\n")
    emit("add r15,r5\n")
    let set = new_label()
    let done = new_label()
    if code == 0 {
        emit("jlt r0,r1,")
    }
    if code == 1 {
        emit("jlt r1,r0,")
    }
    if code == 2 {
        emit("jeq r0,r1,")
    }
    if code == 3 {
        emit("jeq r0,r1,")
    }
    if code == 4 {
        emit("jlt r1,r0,")
    }
    if code == 5 {
        emit("jlt r0,r1,")
    }
    emit_lref(set)
    emit("\n")
    if code < 3 {
        emit("imm r0,0\n")   ; fall-through value
    } else {
        emit("imm r0,1\n")
    }
    emit("jmp ")
    emit_lref(done)
    emit("\n")
    emit_lref(set)
    emit(":\n")
    if code < 3 {
        emit("imm r0,1\n")   ; branch-taken value
    } else {
        emit("imm r0,0\n")
    }
    emit_lref(done)
    emit(":\n")
    return 0
}

proc gen_expr() {
    gen_sum()
    skip_ws()
    let code = cmp_op()
    if code >= 0 {
        emit_push()
        gen_sum()
        emit_cmp(code)
    }
    return 0
}

; ---------------- statements ----------------

proc gen_stmts() {               ; parse statements until '}', consume the '}'
    skip_ws()
    while cbyte() != '}' {
        if cbyte() == 0 {
            return 0
        }
        gen_stmt()
        skip_ws()
    }
    adv()
    return 0
}

proc gen_block() {               ; { statements }
    expect('{')
    gen_stmts()
    return 0
}

; was there an `else` next? consume it and return 1, else leave the cursor and 0.
proc has_else() {
    skip_ws()
    let save = word[2097144]
    if is_alpha(cbyte()) == 1 {
        read_ident()
        if is_else() == 1 {
            return 1
        }
    }
    word[2097144] = save
    return 0
}

proc gen_if() {
    let elsel = new_label()
    let endl = new_label()
    gen_expr()                   ; condition -> r0
    emit("jz r0,")
    emit_lref(elsel)
    emit("\n")
    gen_block()                  ; then-block
    emit("jmp ")
    emit_lref(endl)
    emit("\n")
    emit_lref(elsel)
    emit(":\n")
    if has_else() == 1 {
        gen_block()              ; else-block
    }
    emit_lref(endl)
    emit(":\n")
    return 0
}

proc gen_while() {
    let top = new_label()
    let endl = new_label()
    emit_lref(top)
    emit(":\n")
    gen_expr()                   ; condition -> r0
    emit("jz r0,")
    emit_lref(endl)
    emit("\n")
    gen_block()                  ; body
    emit("jmp ")
    emit_lref(top)
    emit("\n")
    emit_lref(endl)
    emit(":\n")
    return 0
}

proc gen_stmt() {
    skip_ws()
    read_ident()                 ; let / return / if / while / an lvalue
    let slot = 0                 ; one declaration (Beta locals are function-scoped)
    if is_let() == 1 {
        skip_ws()
        read_ident()             ; the new local's name
        slot = declare()
        expect('=')
        gen_expr()
        emit_store_slot(slot)
        return 0
    }
    if is_return() == 1 {
        gen_expr()
        emit_epilogue()
        return 0
    }
    if is_if() == 1 {
        gen_if()
        return 0
    }
    if is_while() == 1 {
        gen_while()
        return 0
    }
    if is_byte() == 1 {
        gen_store(1)             ; byte[addr] = val
        return 0
    }
    if is_word() == 1 {
        gen_store(8)             ; word[addr] = val
        return 0
    }
    ; otherwise the ident just read is an assignment target
    slot = lookup()
    expect('=')
    gen_expr()
    emit_store_slot(slot)
    return 0
}

proc parse_proc() {
    word[2097128] = 0            ; NLOC = 0 (locals are per-proc)
    skip_ws()
    read_ident()                 ; "proc"
    skip_ws()
    read_ident()                 ; the proc name
    let nameoff = word[2097120]  ; save it (param/let parsing clobbers IDOFF/IDLEN)
    let namelen = word[2097112]
    expect('(')                  ; parameters -> slots 0..nparams-1
    skip_ws()
    while cbyte() != ')' {
        read_ident()
        declare()
        skip_ws()
        if cbyte() == ',' {
            adv()
            skip_ws()
        }
    }
    adv()                        ; consume ')'
    let nparams = word[2097128]  ; NLOC after the params
    expect('{')
    let nslots = nparams + count_lets()
    emit_ident_at(nameoff, namelen)
    emit(":\n")
    emit_proc_prologue(nslots)
    let k = 0
    while k < nparams {
        emit_param_store(k)
        k = k + 1
    }
    gen_stmts()                  ; body (consumes the closing '}')
    emit_epilogue()              ; fall-through tear-down (matches on-ramp)
    return 0
}

proc main() {
    slurp()
    emit_prelude()
    skip_ws()
    while cbyte() != 0 {
        parse_proc()
        skip_ws()
    }
    return 0
}
