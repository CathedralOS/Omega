+#[test]
+fn checksum_action_gate_rechecks_the_build_scripts_watched_contents() {
+    let package = tempfile::tempdir().unwrap();
+    let out_dir = package.path().join("target/debug/build/fixture/out");
+    std::fs::create_dir_all(&out_dir).unwrap();
+    std::fs::write(
+        out_dir.parent().unwrap().join("output"),
+        "cargo::rerun-if-changed=watched.txt\n",
+    )
+    .unwrap();
+    let watched = package.path().join("watched.txt");
+    std::fs::write(&watched, b"first").unwrap();
+    let before = std::fs::metadata(&watched).unwrap();
+    let inputs = crate::build_script::CompilationInputs::read(&out_dir, package.path()).unwrap();
+    inputs.verify().unwrap();
+    let context = ActionContext {
+        compiler: CompilerIdentity {
+            toolchain: "fixture".into(),
+            rustc_version: "rustc test".into(),
+            host: "test-host".into(),
+            driver: None,
+        },
+        working_dir: package.path().into(),
+        path_mappings: vec![PathMapping::new(package.path(), "workspace")],
+        environment: BTreeMap::new(),
+        portable_environment: BTreeSet::new(),
+        inputs: vec![inputs.input.clone()],
+    };
+    let portable = Portable {
+        mappings: context.path_mappings.clone(),
+        arguments: Vec::new(),
+        build_script_inputs: Some(inputs),
+    };
+    let invocation = RustcInvocation::parse(
+        &[
+            "--crate-name=widget",
+            "--crate-type=lib",
+            "--emit=dep-info,metadata,link",
+            "-Zchecksum-hash-algorithm=blake3",
+            "src/lib.rs",
+        ]
+        .map(OsString::from),
+    )
+    .unwrap();
+    let compilation = Compilation {
+        rustc: OsStr::new("rustc"),
+        arguments: &[],
+        invocation: &invocation,
+        working_dir: package.path(),
+        portable: &portable,
+        linker: None,
+    };
+    std::fs::write(&watched, b"other").unwrap();
+    filetime::set_file_mtime(
+        &watched,
+        filetime::FileTime::from_last_modification_time(&before),
+    )
+    .unwrap();
+    let after = std::fs::metadata(&watched).unwrap();
+    assert_eq!(before.len(), after.len());
+    assert_eq!(before.modified().unwrap(), after.modified().unwrap());
+    // The Cargo stdout input did not change. Its transitive watch signature
+    // must still be checked before either cache key route can use it.
+    let error = ActionCandidates::build(&compilation, context)
+        .err()
+        .unwrap();
+    assert!(
+        matches!(
+            error.downcast_ref::<BypassReason>(),
+            Some(BypassReason::BuildScriptInputsChanged(_))
+        ),
+        "{error:#}"
+    );
+}
