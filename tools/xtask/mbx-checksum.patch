+/// Locate this checkout's own Git metadata, including a linked worktree or submodule.
+pub(crate) fn git_checkout(workspace_root: &Path) -> Option<(&Path, PathBuf)> {
+    let checkout = workspace_root
+        .ancestors()
+        .find(|dir| dir.join(".git").exists())?;
+    let dot_git = checkout.join(".git");
+    if dot_git.is_dir() {
+        return Some((checkout, dot_git));
+    }
+    let pointer = read_small_text_file(&dot_git)?;
+    let git_dir = pointer.strip_prefix("gitdir:")?.trim();
+    (!git_dir.is_empty()).then(|| (checkout, checkout.join(git_dir)))
+}
+
+/// Discovery can reach other checkouts. Bound what it reads and skip special files.
+pub(crate) fn read_small_text_file(path: &Path) -> Option<String> {
+    use std::io::Read;
+    const LIMIT: u64 = 64 * 1024;
+    let meta = std::fs::metadata(path).ok()?;
+    if !meta.is_file() || meta.len() > LIMIT {
+        return None;
+    }
+    let mut text = String::new();
+    std::fs::File::open(path)
+        .ok()?
+        .take(LIMIT + 1)
+        .read_to_string(&mut text)
+        .ok()?;
+    (text.len() as u64 <= LIMIT).then_some(text)
+}
