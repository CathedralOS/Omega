+#[test]
+fn a_checkout_can_prefer_its_target_until_its_assignment_ends() {
+    let directory = tempfile::tempdir().unwrap();
+    let config = test_config(directory.path(), true);
+    let [old, new, _, _] = ranked_views(directory.path(), &config);
+    let admin = directory.path().join("old-admin");
+    std::fs::create_dir(&admin).unwrap();
+    let marker = admin.join("assignment");
+    std::fs::write(old.0.join(".git"), "gitdir: ../old-admin\n").unwrap();
+    std::fs::write(
+        old.0.join(".mbx.toml"),
+        "prefer_target_while_git_file = \"assignment\"",
+    )
+    .unwrap();
+    std::fs::write(&marker, "compiling\n").unwrap();
+    assert!(checkout_prefers_its_target(&old.0));
+    collect_by(
+        &config.target.root,
+        Some(21),
+        None,
+        &Precedence::default(),
+        RunningPrograms::Spare,
+        false,
+    )
+    .unwrap();
+    assert!(old.1.exists());
+    assert!(!new.1.exists());
+    std::fs::remove_file(marker).unwrap();
+    assert!(!checkout_prefers_its_target(&old.0));
+    collect_by(
+        &config.target.root,
+        Some(0),
+        None,
+        &Precedence::default(),
+        RunningPrograms::Spare,
+        false,
+    )
+    .unwrap();
+    assert!(!old.1.exists());
+}
