+#[test]
+fn checksum_hashing_is_retained_in_actions_predictions_and_dep_info() {
+    let invocation = |selection: &[&str]| {
+        let mut arguments = vec![
+            "--crate-name=widget",
+            "--crate-type=lib",
+            "--emit=dep-info,metadata,link",
+        ];
+        arguments.extend_from_slice(selection);
+        arguments.push("src/lib.rs");
+        RustcInvocation::parse(&args(&arguments)).unwrap()
+    };
+    let selected = invocation(&["-Zchecksum-hash-algorithm=blake3"]);
+    assert_eq!(
+        selected,
+        invocation(&["-Z", "checksum-hash-algorithm=blake3"])
+    );
+    assert!(selected.uses_checksum_hashing());
+    let plain = invocation(&[]);
+    assert!(!plain.uses_checksum_hashing());
+    let context = context(&[("src/lib.rs", "source")]);
+    let descriptor: serde_json::Value =
+        serde_json::from_slice(&selected.action(context.clone()).unwrap().bytes).unwrap();
+    assert_eq!(
+        descriptor["checksum_adapter"],
+        "CathedralOS/Omega:checksum-v1"
+    );
+    let descriptor: serde_json::Value =
+        serde_json::from_slice(&plain.action(context.clone()).unwrap().bytes).unwrap();
+    assert!(descriptor.get("checksum_adapter").is_none());
+    let prediction = ActionBuilder::new(&selected, context.clone())
+        .invocation_descriptor()
+        .unwrap();
+    assert_eq!(
+        prediction.checksum_adapter,
+        Some("CathedralOS/Omega:checksum-v1")
+    );
+    assert_ne!(
+        selected.action(context.clone()).unwrap().digest,
+        plain.action(context.clone()).unwrap().digest
+    );
+    assert_ne!(
+        selected.invocation_digest(&context).unwrap(),
+        plain.invocation_digest(&context).unwrap()
+    );
+    let discovery = selected
+        .dep_info_command(&workspace().join("probe.d"))
+        .unwrap();
+    assert!(
+        discovery
+            .arguments()
+            .iter()
+            .any(|arg| arg == "-Zchecksum-hash-algorithm=blake3")
+    );
+}
+
