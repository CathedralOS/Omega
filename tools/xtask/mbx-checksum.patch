+/// Object identity detects replacement, but cannot detect an in-place write
+/// whose size and modification time were restored. Checksum actions need the
+/// stronger token or must leave caching unavailable on this filesystem.
+fn require_checksum_input_identity(path: &Path, identity: Option<&FileIdentity>) -> Result<()> {
+    if !identity.is_some_and(|identity| identity.changed.is_some()) {
+        return Err(BypassReason::ChecksumInputIdentity(path.to_path_buf()).into());
+    }
+    Ok(())
+}
