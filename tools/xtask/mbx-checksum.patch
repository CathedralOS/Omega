+#[test]
+fn checksum_caching_requires_a_change_token_even_with_an_object_identity() {
+    let path = PathBuf::from("/nfs/input.rs");
+    let mut identity = FileIdentity {
+        path: path.clone(),
+        len: 10,
+        modified: SystemTime::UNIX_EPOCH,
+        changed: None,
+        object: Some(mbx_cache_core::FileObjectIdentity {
+            device_major: 0,
+            device_minor: 42,
+            mount_id: 7,
+            inode: 99,
+        }),
+    };
+    for keep_object in [true, false] {
+        if !keep_object {
+            identity.object = None;
+        }
+        let error = require_checksum_input_identity(&path, Some(&identity)).unwrap_err();
+        assert!(
+            matches!(error.downcast_ref::<BypassReason>(), Some(BypassReason::ChecksumInputIdentity(found)) if found == &path)
+        );
+    }
+    assert!(require_checksum_input_identity(&path, None).is_err());
+    identity.changed = Some((10, 1));
+    require_checksum_input_identity(&path, Some(&identity)).unwrap();
+}
