 #[test]
+fn checksum_algorithm_is_retained_in_the_action_key() {
+    let invocation = |options: &[&str]| {
+        let mut arguments = vec![
+            "--crate-name=widget",
+            "--crate-type=lib",
+            "--emit=dep-info,metadata,link",
+        ];
+        arguments.extend_from_slice(options);
+        arguments.push("src/lib.rs");
+        RustcInvocation::parse(&args(&arguments)).unwrap()
+    };
+    let key = |invocation: RustcInvocation| {
+        invocation
+            .action(context(&[("src/lib.rs", "source")]))
+            .unwrap()
+            .digest
+    };
+    let attached = invocation(&["-Zchecksum-hash-algorithm=blake3"]);
+    assert_eq!(
+        attached,
+        invocation(&["-Z", "checksum-hash-algorithm=blake3"])
+    );
+    let digest = key(attached);
+    assert_ne!(digest, key(invocation(&[])));
+    assert_ne!(
+        digest,
+        key(invocation(&["-Zchecksum-hash-algorithm=sha256"]))
+    );
+}
+
+#[test]
+fn checksum_algorithm_reaches_dependency_discovery() {
+    let invocation = RustcInvocation::parse(&args(&[
+        "--crate-name=widget",
+        "--crate-type=lib",
+        "--emit=dep-info,metadata,link",
+        "-Zchecksum-hash-algorithm=blake3",
+        "src/lib.rs",
+    ]))
+    .unwrap();
+    let output = std::env::temp_dir().join("checksum-probe.d");
+    let command = invocation.dep_info_command(&output).unwrap();
+    assert!(
+        command
+            .arguments()
+            .iter()
+            .any(|argument| argument == "-Zchecksum-hash-algorithm=blake3")
+    );
+}
+
+#[test]
+fn checksum_algorithm_requires_a_value() {
+    for option in ["-Zchecksum-hash-algorithm", "-Zchecksum-hash-algorithm="] {
+        assert_eq!(
+            RustcInvocation::parse(&args(&[option])).unwrap_err(),
+            BypassReason::MissingValue("-Zchecksum-hash-algorithm".into())
+        );
+    }
+}
