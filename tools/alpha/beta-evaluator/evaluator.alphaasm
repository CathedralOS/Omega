        jlt r7, r8, beta_invalid
        imm r8, 103
        jlt r7, r8, require_hex_next
        jmp beta_invalid
require_hex_next:
        imm r8, 1
        add r4, r8
        add r6, r8
        jmp require_hex_loop

; Parses current token as exact signed i64. Returns value in r0.
parse_integer_token:
        imm r0, 9437240
