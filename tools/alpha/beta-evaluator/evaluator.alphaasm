        imm r8, 58
        jlt r7, r8, require_identifier_next
        imm r8, 65
        jlt r7, r8, beta_invalid
        imm r8, 91
        jlt r7, r8, require_identifier_next
        imm r8, 97
        jlt r7, r8, beta_invalid
        imm r8, 123
