        jeq r6, r7, skip_trivia_next
        imm r7, 10
        jeq r6, r7, skip_trivia_next
        imm r7, 13
        jeq r6, r7, skip_trivia_next
        imm r7, 32
        jeq r6, r7, skip_trivia_next
