        imm r7, 10
        jeq r6, r7, skip_trivia_next
        imm r7, 13
        jeq r6, r7, skip_trivia_next
        imm r7, 1
        add r4, r7
        jmp skip_comment_loop

next_token:
        call skip_trivia
        imm r0, 9437232
        load r4, r0
        imm r0, 9437208
        load r5, r0
        jlt r4, r5, next_token_start
        jmp beta_invalid
next_token_start:
        mov r6, r4
next_token_loop:
        jlt r4, r5, next_token_byte
        jmp next_token_done
next_token_byte:
        loadb r7, r4
        imm r8, 9
        jeq r7, r8, next_token_done
        imm r8, 10
        jeq r7, r8, next_token_done
        imm r8, 13
        jeq r7, r8, next_token_done
        imm r8, 32
        jeq r7, r8, next_token_done
        imm r8, 40
        jeq r7, r8, next_token_done
        imm r8, 41
        jeq r7, r8, next_token_done
        imm r8, 59
        jeq r7, r8, next_token_done
        imm r8, 1
        add r4, r8
        jmp next_token_loop
next_token_done:
        jeq r4, r6, beta_invalid
        imm r0, 9437240
        store r0, r6
        mov r7, r4
        sub r7, r6
        imm r0, 9437248
        store r0, r7
        imm r0, 9437232
        store r0, r4
        ret

; Current token versus expected bytes at r0 with expected length r1.
token_equals:
        mov r8, r0
        mov r9, r1
        imm r0, 9437248
        load r5, r0
        jeq r5, r9, token_equals_length
        imm r0, 0
        ret
token_equals_length:
        imm r0, 9437240
        load r4, r0
        imm r6, 0
token_equals_loop:
        jlt r6, r5, token_equals_byte
        imm r0, 1
        ret
token_equals_byte:
        mov r10, r4
        add r10, r6
        loadb r11, r10
        mov r10, r8
        add r10, r6
        loadb r12, r10
        jeq r11, r12, token_equals_next
        imm r0, 0
        ret
token_equals_next:
        imm r10, 1
        add r6, r10
        jmp token_equals_loop

; r0/startA r1/lenA r2/startB r3/lenB.
spans_equal:
        jeq r1, r3, spans_equal_length
        imm r0, 0
        ret
spans_equal_length:
        imm r4, 0
spans_equal_loop:
        jlt r4, r1, spans_equal_byte
        imm r0, 1
        ret
spans_equal_byte:
        mov r5, r0
        add r5, r4
        loadb r6, r5
        mov r5, r2
        add r5, r4
        loadb r7, r5
        jeq r6, r7, spans_equal_next
        imm r0, 0
        ret
spans_equal_next:
        imm r5, 1
        add r4, r5
        jmp spans_equal_loop

push_word:
        imm r1, 8
        sub r15, r1
        imm r1, 9437416
        load r2, r1
        jlt r15, r2, beta_incomplete
        jeq r15, r2, beta_incomplete
        store r15, r0
        ret
pop_word:
        imm r1, 34603008
        jeq r15, r1, beta_internal
        load r0, r15
        imm r1, 8
        add r15, r1
        ret

; r0 name start, r1 name length. Duplicate active locals trap when reached.
require_fresh_local:
        mov r8, r0
        mov r9, r1
        imm r2, 9437272
        load r2, r2
        imm r3, 9437280
        load r3, r3
        call spans_equal
        imm r1, 1
        jeq r0, r1, beta_authored_trap
        imm r10, 17825792
        imm r0, 9437416
        load r11, r0
require_fresh_local_loop:
        jlt r10, r11, require_fresh_local_row
        ret
require_fresh_local_row:
        load r2, r10
        mov r3, r10
        imm r4, 8
        add r3, r4
        load r3, r3
        mov r0, r8
        mov r1, r9
        call spans_equal
        imm r1, 1
        jeq r0, r1, beta_authored_trap
        imm r4, 40
        add r10, r4
        jmp require_fresh_local_loop

; r0 name start, r1 name length. Returns binding row or zero.
find_binding:
        mov r8, r0
        mov r9, r1
        imm r10, 17825792
        imm r0, 9437416
        load r11, r0
find_binding_loop:
        jlt r10, r11, find_binding_row
        imm r0, 0
        ret
find_binding_row:
        load r2, r10
        mov r3, r10
        imm r4, 8
        add r3, r4
        load r3, r3
        mov r0, r8
        mov r1, r9
        call spans_equal
        imm r1, 1
        jeq r0, r1, find_binding_found
        imm r4, 40
        add r10, r4
        jmp find_binding_loop
find_binding_found:
        mov r0, r10
        ret

; r0/r1 name span, r2 tag, r3/r4 value words.
push_binding:
        imm r5, 9437416
        load r6, r5
        mov r7, r6
        imm r8, 40
        add r7, r8
        jlt r15, r7, beta_incomplete
        store r6, r0
        imm r8, 8
        add r6, r8
        store r6, r1
        add r6, r8
        store r6, r2
        add r6, r8
        store r6, r3
        add r6, r8
        store r6, r4
        store r5, r7
        ret

pop_binding:
        imm r0, 9437416
        load r1, r0
        imm r2, 40
        sub r1, r2
        imm r2, 17825792
        jlt r1, r2, beta_internal
        store r0, r1
        ret

beta_invalid:
        imm r0, 1
        halt r0
beta_authored_trap:
        imm r0, 2
        halt r0
beta_incomplete:
        imm r0, 3
        halt r0
beta_internal:
        imm r0, 4
        halt r0

kw_def:
        db "def"
kw_entry:
        db "entry"
kw_if:
        db "if"
kw_let:
        db "let"
kw_complete:
        db "Complete"
kw_reject:
        db "Reject"
kw_bytes_single:
        db "bytes-single"
kw_bytes_length:
        db "bytes-length"
kw_bytes_get:
        db "bytes-get"
kw_add:
        db "+"
kw_subtract:
        db "-"
kw_multiply:
        db "*"
kw_divide:
        db "/"
kw_remainder:
        db "%"
kw_less:
        db "<"
kw_equal:
        db "="
kw_bytes_slice:
        db "bytes-slice"
kw_bytes_concat:
        db "bytes-concat"