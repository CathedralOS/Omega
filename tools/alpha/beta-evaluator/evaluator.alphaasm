        call set_int
        ret
evaluate_equal_false:
        imm r0, 0
        call set_int
        ret

; Strictly evaluates two integer operands and returns left/right in r8/r9.
evaluate_binary_ints:
        call evaluate_expression
        imm r0, 9437352
        load r1, r0
        imm r2, 1
        jeq r1, r2, evaluate_binary_left_int
        jmp beta_authored_trap
evaluate_binary_left_int:
