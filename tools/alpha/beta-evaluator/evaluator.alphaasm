        imm r0, 9437352
        load r0, r0
        call push_word
        imm r0, 9437360
        load r0, r0
        call push_word
        imm r0, 9437368
        load r0, r0
        call push_word
        call evaluate_expression
        call consume_close
        imm r0, 9437352
        load r8, r0
        imm r0, 9437360
        load r9, r0
        imm r0, 9437368
        load r10, r0
        call pop_word
        mov r13, r0
        call pop_word
        mov r12, r0
        call pop_word
