        jlt r8, r11, evaluate_add_left_negative
        jlt r9, r11, evaluate_add_ok
        jlt r10, r11, beta_authored_trap
        jmp evaluate_add_ok
evaluate_add_left_negative:
        jlt r9, r11, evaluate_add_both_negative
        jmp evaluate_add_ok
evaluate_add_both_negative:
        jlt r10, r11, evaluate_add_ok
        jmp beta_authored_trap
evaluate_add_ok:
        mov r0, r10
        call set_int
        ret
evaluate_subtract:
        call evaluate_binary_ints
        mov r10, r8
        sub r10, r9
        imm r11, 0
        jlt r8, r11, evaluate_subtract_left_negative
        jlt r9, r11, evaluate_subtract_positive_negative
        jmp evaluate_subtract_ok
evaluate_subtract_positive_negative:
        jlt r10, r11, beta_authored_trap
        jmp evaluate_subtract_ok
evaluate_subtract_left_negative:
        jlt r9, r11, evaluate_subtract_ok
        jlt r10, r11, evaluate_subtract_ok
        jmp beta_authored_trap
evaluate_subtract_ok:
        mov r0, r10
        call set_int
        ret
evaluate_multiply:
        call evaluate_binary_ints
        imm r10, 0
        jeq r8, r10, evaluate_multiply_zero
        jeq r9, r10, evaluate_multiply_zero
        imm r10, 9223372036854775808
        imm r11, 18446744073709551615
        jeq r8, r10, evaluate_multiply_left_min
        jmp evaluate_multiply_check_right_min
evaluate_multiply_left_min:
        jeq r9, r11, beta_authored_trap
evaluate_multiply_check_right_min:
        jeq r9, r10, evaluate_multiply_right_min
        jmp evaluate_multiply_product
evaluate_multiply_right_min:
