        jeq r11, r8, evaluate_equal_same_kind
        jmp evaluate_equal_false
evaluate_equal_same_kind:
        imm r0, 1
        jeq r11, r0, evaluate_equal_word_zero
        imm r0, 2
        jeq r11, r0, evaluate_equal_bytes
        imm r0, 3
        jeq r11, r0, evaluate_equal_constructor
        jmp beta_internal
evaluate_equal_word_zero:
