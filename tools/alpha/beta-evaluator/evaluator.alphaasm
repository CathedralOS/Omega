; Beta evaluator development slice.
;
; Implemented now:
; - exact-ended BETAREQ v1 loading and source-envelope validation;
; - one unary def plus one entry, in either order, selected by exact name;
; - complete structural validation for the implemented expression subset;
; - input and lowercase #x byte values;
; - Complete, Reject, bytes-single, and bytes-concat;
; - immutable raw/hex/single/concat byte nodes in the bounded value arena;
; - one-pass output whose bytes are authoritative only with status zero.
;
; Valid Beta outside this development slice returns Incomplete. This source is
; not the canonical beta_evaluator_bytecode.tape.

; Global words in the declaration region.
; 9437184 total request bytes
; 9437192 source start
; 9437200 source length
; 9437208 source end
; 9437216 input start
; 9437224 input length
; 9437232 cursor
; 9437240 token start
; 9437248 token length
; 9437256 def name start
; 9437264 def name length
; 9437272 parameter start
; 9437280 parameter length
; 9437288 body start
; 9437296 body end
; 9437304 entry name start
; 9437312 entry name length
; 9437320 have def
; 9437328 have entry
; 9437336 input Bytes handle
; 9437344 arena cursor
; 9437352 value tag
; 9437360 value word zero
; 9437368 value word one
; 9437416 binding cursor

        imm r15, 34603008
        imm r14, 1048576
read_request_loop:
        imm r2, 9437184
        jeq r14, r2, read_request_probe
        read r1
        imm r3, 0
        jlt r1, r3, read_request_done
        storeb r14, r1
        imm r3, 1
        add r14, r3
        jmp read_request_loop
read_request_probe:
        read r1
        imm r3, 0
        jlt r1, r3, read_request_done
        jmp beta_incomplete
read_request_done:
        mov r0, r14
        imm r1, 1048576
        sub r0, r1
        imm r1, 9437184
        store r1, r0
        imm r1, 16
        jlt r0, r1, beta_invalid

        imm r0, 1048576
        call validate_request_magic

        imm r0, 1048584
        call read_u32
        imm r1, 9437200
        store r1, r0
        mov r10, r0
        imm r0, 1048588
        call read_u32
        imm r1, 9437224
        store r1, r0
        mov r11, r0

        mov r12, r10
        add r12, r11
        imm r13, 16
        add r12, r13
        imm r1, 9437184
        load r2, r1
        jeq r12, r2, request_extent_valid
        jmp beta_invalid
request_extent_valid:
        imm r0, 1048592
        imm r1, 9437192
        store r1, r0
        mov r1, r0
        add r1, r10
        imm r2, 9437208
        store r2, r1
        imm r2, 9437216
        store r2, r1

        call validate_source_envelope

        imm r0, 9437320
        imm r1, 0
        store r0, r1
        imm r0, 9437328
        store r0, r1
        imm r0, 9437192
        load r1, r0
        imm r0, 9437232
        store r0, r1
        call parse_program

        imm r0, 34603008
        jeq r15, r0, parser_stack_balanced
        jmp beta_internal
parser_stack_balanced:
        imm r0, 34603008
        mov r15, r0
        imm r0, 9437416
        imm r1, 17825792
        store r0, r1
        imm r0, 34603008
        ; r15 already set; initialize the immutable arena.
        imm r0, 34603008
        imm r1, 9437344
        store r1, r0
        ; Correct arena start is 0x02100000 = 34603008.

        imm r0, 9437224
        load r1, r0
        imm r2, 0
        jeq r1, r2, input_is_empty
        imm r0, 1
        mov r2, r1
        imm r1, 9437216
        load r3, r1
        mov r1, r2
        mov r2, r3
        imm r3, 0
        call allocate_node
        imm r1, 9437336
        store r1, r0
        jmp input_ready
input_is_empty:
        imm r0, 9437336
        imm r1, 0
        store r0, r1
input_ready:
        imm r0, 9437288
        load r1, r0
        imm r0, 9437232
        store r0, r1
        call evaluate_expression
        imm r0, 9437232
        load r1, r0
        imm r0, 9437296
        load r2, r0
        jeq r1, r2, body_consumed
        jmp beta_internal
body_consumed:
        imm r0, 9437352
        load r1, r0
        imm r2, 3
        jeq r1, r2, outcome_ready
        jmp beta_internal
outcome_ready:
        imm r0, 9437360
        load r1, r0
        imm r2, 2
        jeq r1, r2, beta_authored_trap
        imm r2, 1
        jeq r1, r2, emit_complete
        jmp beta_internal
emit_complete:
        imm r0, 9437368
        load r0, r0
        call emit_bytes
        imm r0, 0
        halt r0

; r0 = request base. Exact eight-byte BETAREQ v1 magic.
validate_request_magic:
        mov r4, r0
        imm r5, 66
        call require_memory_byte
        imm r5, 69
        call require_memory_byte
        imm r5, 84
        call require_memory_byte
        imm r5, 65
        call require_memory_byte
        imm r5, 82
        call require_memory_byte
        imm r5, 69
        call require_memory_byte
        imm r5, 81
        call require_memory_byte
        imm r5, 1
        call require_memory_byte
        ret

; r4 = pointer, r5 = expected byte. Advances r4.
require_memory_byte:
        loadb r6, r4
        jeq r6, r5, require_memory_byte_ok
        jmp beta_invalid
require_memory_byte_ok:
        imm r6, 1
        add r4, r6
        ret

; r0 = pointer, returns little-endian u32 in r0.
read_u32:
        mov r4, r0
        loadb r5, r4
        imm r6, 1
        add r4, r6
        loadb r7, r4
        imm r8, 256
        mul r7, r8
        add r5, r7
        add r4, r6
        loadb r7, r4
        imm r8, 65536
        mul r7, r8
        add r5, r7
        add r4, r6
        loadb r7, r4
        imm r8, 16777216
        mul r7, r8
        add r5, r7
        mov r0, r5
        ret

validate_source_envelope:
        imm r0, 9437192
        load r4, r0
        imm r0, 9437208
        load r5, r0
source_envelope_loop:
        jlt r4, r5, source_envelope_byte
        ret
source_envelope_byte:
        loadb r6, r4
        imm r7, 9
        jeq r6, r7, source_envelope_next
        imm r7, 10
        jeq r6, r7, source_envelope_next
        imm r7, 13
        jeq r6, r7, source_envelope_next
        imm r7, 32
        jlt r6, r7, beta_invalid
        imm r7, 127
        jlt r6, r7, source_envelope_next
        jmp beta_invalid
source_envelope_next:
        imm r7, 1
        add r4, r7
        jmp source_envelope_loop

parse_program:
parse_program_loop:
        call skip_trivia
        imm r0, 9437232
        load r4, r0
        imm r0, 9437208
        load r5, r0
        jlt r4, r5, parse_program_form
        jmp parse_program_done
parse_program_form:
        call consume_open
        call next_token
        imm r0, kw_def
        imm r1, 3
        call token_equals
        imm r1, 1
        jeq r0, r1, parse_def
        imm r0, kw_entry
        imm r1, 5
        call token_equals
        imm r1, 1
        jeq r0, r1, parse_entry
        jmp beta_incomplete
parse_def:
        imm r0, 9437320
        load r1, r0
        imm r2, 0
        jeq r1, r2, parse_def_new
        jmp beta_incomplete
parse_def_new:
        call next_token
        call require_lower_name
        imm r0, 9437240
        load r1, r0
        imm r0, 9437256
        store r0, r1
        imm r0, 9437248
        load r1, r0
        imm r0, 9437264
        store r0, r1
        call consume_open
        call next_token
        call require_lower_name
        imm r0, 9437240
        load r1, r0
        imm r0, 9437272
        store r0, r1
        imm r0, 9437248
        load r1, r0
        imm r0, 9437280
        store r0, r1
        call consume_close
        call skip_trivia
        imm r0, 9437232
        load r1, r0
        imm r0, 9437288
        store r0, r1
        call validate_expression
        imm r0, 9437232
        load r1, r0
        imm r0, 9437296
        store r0, r1
        call consume_close
        imm r0, 9437320
        imm r1, 1
        store r0, r1
        jmp parse_program_loop
parse_entry:
        imm r0, 9437328
        load r1, r0
        imm r2, 0
        jeq r1, r2, parse_entry_new
        jmp beta_invalid
parse_entry_new:
        call next_token
        call require_lower_name
        imm r0, 9437240
        load r1, r0
        imm r0, 9437304
        store r0, r1
        imm r0, 9437248
        load r1, r0
        imm r0, 9437312
        store r0, r1
        call consume_close
        imm r0, 9437328
        imm r1, 1
        store r0, r1
        jmp parse_program_loop
parse_program_done:
        imm r0, 9437320
        load r1, r0
        imm r2, 1
        jeq r1, r2, parse_have_def
        jmp beta_invalid
parse_have_def:
        imm r0, 9437328
        load r1, r0
        imm r2, 1
        jeq r1, r2, parse_have_entry
        jmp beta_invalid
parse_have_entry:
        imm r0, 9437256
        load r0, r0
        imm r1, 9437264
        load r1, r1
        imm r2, 9437304
        load r2, r2
        imm r3, 9437312
        load r3, r3
        call spans_equal
        imm r1, 1
        jeq r0, r1, parse_program_ok
        jmp beta_invalid
parse_program_ok:
        ret

; Complete structural validation for the implemented expression subset.
validate_expression:
        call skip_trivia
        imm r0, 9437232
        load r4, r0
        imm r0, 9437208
        load r5, r0
        jlt r4, r5, validate_expression_byte
        jmp beta_invalid
validate_expression_byte:
        loadb r6, r4
        imm r7, 40
        jeq r6, r7, validate_expression_list
        call next_token
        imm r0, 9437240
        load r4, r0
        loadb r6, r4
        imm r7, 35
        jeq r6, r7, validate_hex_token
        imm r7, 45
        jeq r6, r7, validate_integer_token
        imm r7, 48
        jlt r6, r7, validate_identifier_token
        imm r7, 58
        jlt r6, r7, validate_integer_token
        jmp validate_identifier_token
validate_expression_list:
        call consume_open
        call next_token
        imm r0, kw_if
        imm r1, 2
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_ternary
        imm r0, kw_let
        imm r1, 3
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_let
        imm r0, kw_complete
        imm r1, 8
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_unary
        imm r0, kw_bytes_single
        imm r1, 12
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_unary
        imm r0, kw_bytes_length
        imm r1, 12
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_unary
        imm r0, kw_bytes_get
        imm r1, 9
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_binary
        imm r0, kw_add
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_binary
        imm r0, kw_subtract
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_binary
        imm r0, kw_multiply
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_binary
        imm r0, kw_divide
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_binary
        imm r0, kw_remainder
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_binary
        imm r0, kw_less
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_binary
        imm r0, kw_equal
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_binary
        imm r0, kw_bytes_slice
        imm r1, 11
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_ternary
        imm r0, kw_bytes_concat
        imm r1, 12
        call token_equals
        imm r1, 1
        jeq r0, r1, validate_binary
        jmp beta_incomplete
validate_unary:
        call validate_expression
        call consume_close
        ret
validate_binary:
        call validate_expression
        call validate_expression
        call consume_close
        ret
validate_ternary:
        call validate_expression
        call validate_expression
        call validate_expression
        call consume_close
        ret
validate_let:
        call next_token
        call require_lower_name
        call validate_expression
        call validate_expression
        call consume_close
        ret
validate_hex_token:
        call require_hex_token
        ret
validate_integer_token:
        call parse_integer_token
        ret
validate_identifier_token:
        call require_identifier
        ret

evaluate_expression:
        call skip_trivia
        imm r0, 9437232
        load r4, r0
        imm r0, 9437208
        load r5, r0
        jlt r4, r5, evaluate_expression_byte
        jmp beta_internal
evaluate_expression_byte:
        loadb r6, r4
        imm r7, 40
        jeq r6, r7, evaluate_expression_list
        call next_token
        imm r0, 9437240
        load r4, r0
        loadb r6, r4
        imm r7, 35
        jeq r6, r7, evaluate_hex
        imm r7, 45
        jeq r6, r7, evaluate_integer
        imm r7, 48
        jlt r6, r7, evaluate_identifier
        imm r7, 58
        jlt r6, r7, evaluate_integer
        jmp evaluate_identifier
evaluate_hex:
        call require_hex_token
        imm r0, 9437248
        load r1, r0
        imm r2, 2
        sub r1, r2
        imm r2, 2
        div r1, r2
        imm r2, 0
        jeq r1, r2, set_empty_bytes
        imm r0, 2
        imm r2, 9437240
        load r2, r2
        imm r3, 2
        add r2, r3
        imm r3, 0
        call allocate_node
        mov r1, r0
        imm r0, 2
        call set_value
        ret
set_empty_bytes:
        imm r0, 2
        imm r1, 0
        imm r2, 0
        call set_value
        ret
evaluate_integer:
        call parse_integer_token
        mov r1, r0
        imm r0, 1
        imm r2, 0
        call set_value
        ret
evaluate_identifier:
        imm r0, kw_reject
        imm r1, 6
        call token_equals
        imm r1, 1
        jeq r0, r1, set_reject
        imm r0, 9437240
        load r0, r0
        imm r1, 9437248
        load r1, r1
        imm r2, 9437272
        load r2, r2
        imm r3, 9437280
        load r3, r3
        call spans_equal
        imm r1, 1
        jeq r0, r1, set_input_value
        imm r0, 9437240
        load r0, r0
        imm r1, 9437248
        load r1, r1
        call find_binding
        imm r1, 0
        jeq r0, r1, beta_authored_trap
        mov r4, r0
        imm r5, 16
        add r4, r5
        load r0, r4
        imm r5, 8
        add r4, r5
        load r1, r4
        add r4, r5
        load r2, r4
        call set_value
        ret
set_reject:
        imm r0, 3
        imm r1, 2
        imm r2, 0
        call set_value
        ret
set_input_value:
        imm r0, 9437336
        load r1, r0
        imm r0, 2
        imm r2, 0
        call set_value
        ret
evaluate_expression_list:
        call consume_open
        call next_token
        imm r0, kw_if
        imm r1, 2
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_if
        imm r0, kw_let
        imm r1, 3
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_let
        imm r0, kw_complete
        imm r1, 8
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_complete
        imm r0, kw_bytes_single
        imm r1, 12
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_bytes_single
        imm r0, kw_bytes_length
        imm r1, 12
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_bytes_length
        imm r0, kw_bytes_get
        imm r1, 9
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_bytes_get
        imm r0, kw_add
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_add
        imm r0, kw_subtract
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_subtract
        imm r0, kw_multiply
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_multiply
        imm r0, kw_divide
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_divide
        imm r0, kw_remainder
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_remainder
        imm r0, kw_less
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_less
        imm r0, kw_equal
        imm r1, 1
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_equal
        imm r0, kw_bytes_slice
        imm r1, 11
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_bytes_slice
        imm r0, kw_bytes_concat
        imm r1, 12
        call token_equals
        imm r1, 1
        jeq r0, r1, evaluate_bytes_concat
        jmp beta_incomplete
evaluate_if:
        call evaluate_expression
        imm r0, 9437352
        load r1, r0
        imm r2, 1
        jeq r1, r2, evaluate_if_int
        jmp beta_authored_trap
evaluate_if_int:
        imm r0, 9437360
        load r1, r0
        imm r2, 0
        jeq r1, r2, evaluate_if_false
        call evaluate_expression
        call validate_expression
        call consume_close
        ret
evaluate_if_false:
        call validate_expression
        call evaluate_expression
        call consume_close
        ret
evaluate_let:
        call next_token
        call require_lower_name
        imm r0, 9437240
        load r0, r0
        imm r1, 9437248
        load r1, r1
        call require_fresh_local
        imm r0, 9437240
        load r0, r0
        call push_word
        imm r0, 9437248
        load r0, r0
        call push_word
        call evaluate_expression
        imm r0, 9437352
        load r0, r0
        call push_word
        imm r0, 9437360
        load r0, r0
        call push_word
        imm r0, 9437368
        load r0, r0
        call push_word
        call pop_word
        mov r12, r0
        call pop_word
        mov r11, r0
        call pop_word
        mov r10, r0
        call pop_word
        mov r9, r0
        call pop_word
        mov r8, r0
        mov r0, r8
        mov r1, r9
        mov r2, r10
        mov r3, r11
        mov r4, r12
        call push_binding
        call evaluate_expression
        call consume_close
        call pop_binding
        ret
evaluate_complete:
        call evaluate_expression
        imm r0, 9437352
        load r1, r0
        imm r2, 2
        jeq r1, r2, evaluate_complete_bytes
        jmp beta_authored_trap
evaluate_complete_bytes:
        imm r0, 9437360
        load r0, r0
        call push_word
        call consume_close
        call pop_word
        mov r4, r0
        imm r0, 3
        imm r1, 1
        mov r2, r4
        call set_value
        ret
evaluate_bytes_single:
        call evaluate_expression
        imm r0, 9437352
        load r1, r0
        imm r2, 1
        jeq r1, r2, evaluate_bytes_single_int
        jmp beta_authored_trap
evaluate_bytes_single_int:
        imm r0, 9437360
        load r4, r0
        imm r5, 0
        jlt r4, r5, beta_authored_trap
        imm r5, 256
        jlt r4, r5, evaluate_bytes_single_range
        jmp beta_authored_trap
evaluate_bytes_single_range:
        mov r0, r4
        call push_word
        call consume_close
        call pop_word
        mov r4, r0
        imm r0, 3
        imm r1, 1
        mov r2, r4
        imm r3, 0
        call allocate_node
        mov r1, r0
        imm r0, 2
        imm r2, 0
        call set_value
        ret
evaluate_bytes_length:
        call evaluate_expression
        imm r0, 9437352
        load r1, r0
        imm r2, 2
        jeq r1, r2, evaluate_bytes_length_bytes
        jmp beta_authored_trap
evaluate_bytes_length_bytes:
        imm r0, 9437360
        load r0, r0
        call bytes_length
        call push_word
        call consume_close
        call pop_word
        mov r1, r0
        imm r0, 1
        imm r2, 0
        call set_value
        ret
evaluate_bytes_get:
        call evaluate_expression
        imm r0, 9437352
        load r1, r0
        imm r2, 2
        jeq r1, r2, evaluate_bytes_get_source
        jmp beta_authored_trap
evaluate_bytes_get_source:
        imm r0, 9437360
        load r0, r0
        call push_word
        call evaluate_expression
        imm r0, 9437352
        load r1, r0
        imm r2, 1
        jeq r1, r2, evaluate_bytes_get_index
        jmp beta_authored_trap
evaluate_bytes_get_index:
        imm r0, 9437360
        load r0, r0
        call push_word
        call consume_close
        call pop_word
        mov r9, r0
        call pop_word
        mov r8, r0
        imm r10, 0
        jlt r9, r10, beta_authored_trap
        mov r0, r8
        call bytes_length
        jlt r9, r0, evaluate_bytes_get_in_bounds
        jmp beta_authored_trap
evaluate_bytes_get_in_bounds:
        mov r0, r8
        mov r1, r9
        call bytes_at
        mov r1, r0
        imm r0, 1
        imm r2, 0
        call set_value
        ret
evaluate_bytes_slice:
        call evaluate_expression
        imm r0, 9437352
        load r1, r0
        imm r2, 2
        jeq r1, r2, evaluate_bytes_slice_source
        jmp beta_authored_trap
evaluate_bytes_slice_source:
        imm r0, 9437360
        load r0, r0
        call push_word
        call evaluate_expression
        imm r0, 9437352
        load r1, r0
        imm r2, 1
        jeq r1, r2, evaluate_bytes_slice_start
        jmp beta_authored_trap
evaluate_bytes_slice_start:
        imm r0, 9437360
        load r0, r0
        call push_word
        call evaluate_expression
        imm r0, 9437352
        load r1, r0
        imm r2, 1
        jeq r1, r2, evaluate_bytes_slice_length
        jmp beta_authored_trap
evaluate_bytes_slice_length:
        imm r0, 9437360
        load r0, r0
        call push_word
        call consume_close
        call pop_word
        mov r10, r0
        call pop_word
        mov r9, r0
        call pop_word
        mov r8, r0
        imm r11, 0
        jlt r9, r11, beta_authored_trap
        jlt r10, r11, beta_authored_trap
        mov r0, r8
        call bytes_length
        mov r12, r0
        jlt r12, r9, beta_authored_trap
        sub r12, r9
        jlt r12, r10, beta_authored_trap
