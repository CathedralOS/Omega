        store r5, r8
        imm r7, 8
        add r5, r7
        store r5, r9
        add r5, r7
        store r5, r10
        add r5, r7
        store r5, r11
        store r4, r6
        mov r0, r6
        imm r7, 32
        sub r0, r7
        ret

