{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Omega",
  "scopeName": "source.omega",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#lifetimes"
    },
    {
      "include": "#import-aliases"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#clause-values"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#names"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.omega",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.omega",
          "match": "//.*$"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.omega",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.omega",
      "begin": "\"",
      "end": "\"|$",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.omega"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.omega"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.omega",
          "match": "\\\\(?:[\"\\\\nrt0]|x[0-9a-fA-F]{2})"
        },
        {
          "name": "invalid.illegal.escape.omega",
          "match": "\\\\."
        }
      ]
    },
    "lifetimes": {
      "comment": "Lifetime binders and reference lifetimes: <'a>, @'a mutable T.",
      "match": "(')([A-Za-z_][A-Za-z_0-9]*)\\b",
      "captures": {
        "1": {
          "name": "punctuation.definition.lifetime.omega"
        },
        "2": {
          "name": "entity.name.type.lifetime.omega"
        }
      },
      "name": "storage.modifier.lifetime.omega"
    },
    "import-aliases": {
      "comment": "A file import alias selects a declaration as |alias|::name. `flags||wire|::MASK` lexes as logical OR, so a preceding bar is not an alias.",
      "match": "(?<!\\|)(\\|)([A-Za-z_][A-Za-z_0-9]*)(\\|)(?=::)",
      "captures": {
        "1": {
          "name": "punctuation.definition.namespace.begin.omega"
        },
        "2": {
          "name": "entity.name.namespace.omega"
        },
        "3": {
          "name": "punctuation.definition.namespace.end.omega"
        }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(machine|state)\\s+([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.omega"
            },
            "2": {
              "name": "entity.name.function.omega"
            }
          }
        },
        {
          "match": "\\b(data|trait|domain|proposition)\\s+([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "storage.type.omega"
            },
            "2": {
              "name": "entity.name.type.omega"
            }
          }
        },
        {
          "match": "\\b(measure)\\s+([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "storage.type.omega"
            },
            "2": {
              "name": "entity.name.function.omega"
            }
          }
        },
        {
          "match": "\\b(case)\\s+([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.omega"
            },
            "2": {
              "name": "entity.name.type.enum.omega"
            }
          }
        },
        {
          "match": "\\b(const)\\s+([A-Za-z_][A-Za-z_0-9]*)",
          "captures": {
            "1": {
              "name": "storage.modifier.omega"
            },
            "2": {
              "name": "constant.other.omega"
            }
          }
        }
      ]
    },
    "clause-values": {
      "comment": "`none` is a value only after the clauses that accept it: `crashes none`, `clobbers none`.",
      "match": "\\b(crashes|clobbers)\\s+(none)\\b",
      "captures": {
        "1": {
          "name": "keyword.other.contract.omega"
        },
        "2": {
          "name": "constant.language.none.omega"
        }
      }
    },
    "keywords": {
      "comment": "The lexer reserves only a few words; most clause words are contextual, so a word followed by a call `(`, a field `:`, an assignment `=` or a member `.` is a name, not a keyword.",
      "patterns": [
        {
          "name": "constant.language.boolean.omega",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "comment": "Builtin type names: bool, addr, f32, f64 and the open-ended integer family i/u followed by digits. Bare i/u are left uncolored because value bindings commonly use those spellings.",
          "name": "entity.name.type.primitive.omega",
          "match": "\\b(?:bool|addr|f32|f64|[ui][0-9]+)\\b"
        },
        {
          "name": "variable.language.self.omega",
          "match": "\\bself\\b"
        },
        {
          "comment": "The retired dyn type spelling; the parser rejects it.",
          "name": "invalid.deprecated.omega",
          "match": "\\bdyn\\b(?=\\s+[A-Za-z_|@])"
        },
        {
          "comment": "A machine value type, as in `data Step = machine() -> u64;`.",
          "name": "storage.type.function.omega",
          "match": "\\bmachine\\b"
        },
        {
          "name": "storage.modifier.visibility.omega",
          "match": "\\bpublic\\b(?![(]|\\s*:(?!:)|\\s*=(?![=>])|\\.(?!\\.))"
        },
        {
          "comment": "Borrow access modes: @mutable T, @write T, and `let mutable`.",
          "name": "storage.modifier.mutability.omega",
          "match": "\\b(?:mutable|write)\\b(?![(]|\\s*:(?!:)|\\s*=(?![=>])|\\.(?!\\.))"
        },
        {
          "name": "storage.type.omega",
          "match": "\\b(?:data|state|struct|trait|domain|proposition|measure)\\b(?![(]|\\s*:(?!:)|\\s*=(?![=>])|\\.(?!\\.))"
        },
        {
          "name": "keyword.control.omega",
          "match": "\\b(?:if|else|loop|match|return|transition|when|while|suspend|block|crash)\\b(?![(]|\\s*:(?!:)|\\s*=(?![=>])|\\.(?!\\.))"
        },
        {
          "comment": "Contract and effect clauses on machines and machine types.",
          "name": "keyword.other.contract.omega",
          "match": "\\b(?:requires|ensures|satisfies|crashes|reaches|terminates|decreases|increases|suspends|blocks|invokes|invariant|established|lexicographic|clobbers)\\b(?![(]|\\s*:(?!:)|\\s*=(?![=>])|\\.(?!\\.))"
        },
        {
          "name": "keyword.other.omega",
          "match": "\\b(?:as|asm|boundary|by|calling_convention|capability|case|const|contains|foreign|host|in|let|library|operator|owns|platform|retired|some|target|use|via)\\b(?![(]|\\s*:(?!:)|\\s*=(?![=>])|\\.(?!\\.))"
        }
      ]
    },
    "numbers": {
      "comment": "Integer suffixes take any decimal width (17u13, 41u257) or none (bare i/u); floats take f32 or f64.",
      "patterns": [
        {
          "name": "constant.numeric.omega",
          "match": "\\b0(?:[xX][0-9a-fA-F][0-9a-fA-F_]*|[bB][01][01_]*|[oO][0-7][0-7_]*)(?:[ui][0-9]*)?\\b"
        },
        {
          "name": "constant.numeric.omega",
          "match": "(?<![\\w.])\\.[0-9][0-9_]*(?:[eE][+-]?[0-9][0-9_]*)?(?:f(?:32|64))?\\b"
        },
        {
          "name": "constant.numeric.omega",
          "match": "\\b[0-9][0-9_]*(?:\\.(?!\\.|[A-Za-z_])[0-9_]*)?(?:[eE][+-]?[0-9][0-9_]*)?(?:[ui][0-9]*|f(?:32|64))?\\b"
        }
      ]
    },
    "names": {
      "patterns": [
        {
          "comment": "Compiler-known layout queries, called as size_of::<T>().",
          "name": "support.function.omega",
          "match": "\\b(?:size_of|align_of|address_of|code_layout)\\b"
        },
        {
          "name": "entity.name.function.omega",
          "match": "\\b[A-Za-z_][A-Za-z_0-9]*(?=\\s*(?:::)?(?:<[^<>\\n]*>\\s*)?\\()"
        },
        {
          "name": "constant.other.omega",
          "match": "\\b[A-Z][A-Z_0-9]+\\b"
        },
        {
          "name": "entity.name.type.omega",
          "match": "\\b[A-Z][A-Za-z_0-9]*\\b"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "comment": "`::` selects a member; `\\` selects a provider or measure, as in windows_arm64\\ProgramEntry or Nat\\Descending.",
          "name": "punctuation.accessor.omega",
          "match": "::|\\\\"
        },
        {
          "comment": "Each @ adds one reference or borrow layer.",
          "name": "keyword.operator.borrow.omega",
          "match": "@"
        },
        {
          "name": "keyword.operator.omega",
          "match": "->|=>|\\.\\.=|\\.\\.|==|!=|<=|>=|&&|\\|\\||<<|>>|[+*/%=!<>|&~^?-]"
        },
        {
          "name": "punctuation.section.omega",
          "match": "[{}\\[\\]()]"
        },
        {
          "name": "punctuation.separator.omega",
          "match": "[,;:.#]"
        }
      ]
    }
  }
}
