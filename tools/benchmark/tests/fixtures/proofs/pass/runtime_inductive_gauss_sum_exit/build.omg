// Deployable native canary: every hosted target selects its exact entry.

use {omega}/build/dependency.omg;
use {system}/console.omg;
use main.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "runtime_inductive_gauss_sum_exit" };
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "../../../../../../../source/library/system" }));
    Build::select_provider::<|console|::Console, |console|::LinuxArm64Console>(builder, linux_arm64);
    Build::select_provider::<|console|::Console, |console|::LinuxX86Console>(builder, linux_x86_64);
    Build::select_provider::<|console|::Console, |console|::DarwinArm64Console>(builder, macos_arm64);
    Build::select_provider::<|console|::Console, |console|::DarwinX86Console>(builder, macos_x86_64);
    Build::select_provider::<|console|::Console, |console|::WindowsConsole>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |main|::entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |main|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |main|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |main|::entry_start);
}
