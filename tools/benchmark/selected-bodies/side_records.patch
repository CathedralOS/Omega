+fn profile_clone_payload<T>(field: &'static str, clone: impl FnOnce() -> T) -> T {
+    // The table directory's children have their own disjoint windows. Do not
+    // count the enclosing directory again or include logging in a window.
+    if field == "tables" || selected_body_allocation_trace::directory().is_none() {
+        return clone();
+    }
+    let (value, counts) = selected_body_allocation_trace::measure(clone);
+    selected_body_allocation_trace::log(format_args!(
+        "SIDE_COPY context={} field={} allocations={} requested_bytes={} live_delta={} peak_delta={} ns={}",
+        selected_body_allocation_trace::current_context(), field, counts.allocations,
+        counts.requested_bytes, counts.live_delta, counts.peak_delta, counts.nanoseconds,
+    ));
+    value
+}
