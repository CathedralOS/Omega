// Both scalar passes are selected so the compile exercises each one's
// withheld-rewrite decision on the same proof-bearing module.
machine build(builder: &mut Build) {
    Build::application(builder, "withheld_rewrite_report");
    builder.roots.bind(windows_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_arm64::ProgramEntry, main);
    builder.roots.bind(macos_arm64::ProgramEntry, main);
    Optimizations::enable(&mut builder.optimizations, Optimization::CopyPropagation);
    Optimizations::enable(
        &mut builder.optimizations,
        Optimization::DeadPureScalarElimination,
    );
}
