use omega::language::core::reflect;
use omega::language::core::AccessPlan;
use omega::language::core::AccessPlan::new;
use omega::language::core::Issuance;
use vec::VecCell;

machine describe_cell() -> reflect::TypeSchema {
    reflect::schema<VecCell>()
}

machine construct_restricted_plan(schema: reflect::TypeSchema) -> AccessPlan {
    AccessPlan::new(&schema, Issuance::Only { routes: [] })
}

machine construct_unrestricted_plan(schema: reflect::TypeSchema) -> AccessPlan {
    AccessPlan::new(&schema, Issuance::Unrestricted)
}

machine return_plan(plan: AccessPlan) -> AccessPlan { plan }
