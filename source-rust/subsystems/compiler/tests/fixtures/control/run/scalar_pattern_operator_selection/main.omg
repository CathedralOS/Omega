use {omega}/language/core/process_exit.omg;

machine choose(value: u64 in Trapping) -> u8 {
    transition value {
        0 -> (7),
        _ -> (0)
    }
}

machine main()
reaches |process_exit|::ProcessExit
{
    let chosen: u8 = choose(0u64 as +Trapping);
    transition chosen == 7 {
        true -> |process_exit|::ProcessExit::exit_process(0),
        _ -> |process_exit|::ProcessExit::exit_process(17)
    }
}
