use {omega}/language/core/external_binding.omg as foreign;
use {omega}/language/core/process_exit.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "source_scalar_operator_selection");
    Build::bind_native::<|process_exit|::ProcessExit::exit_process>(builder, linux_x86_64,
        |foreign|::ForeignBinding::Syscall { number: 231u64 });
    Build::bind_native::<|process_exit|::ProcessExit::exit_process>(builder, linux_arm64,
        |foreign|::ForeignBinding::Syscall { number: 94u64 });
    Build::bind_native::<|process_exit|::ProcessExit::exit_process>(builder, macos_arm64,
        |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::MachODylibSymbol {
            install_name: "/usr/lib/libSystem.B.dylib", symbol: "__exit"
        } });
    Build::bind_native::<|process_exit|::ProcessExit::exit_process>(builder, windows_x86_64,
        |foreign|::ForeignBinding::DllImport { import: |foreign|::DllImport::PeByName {
            library: "kernel32.dll", export: "ExitProcess"
        } });
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
