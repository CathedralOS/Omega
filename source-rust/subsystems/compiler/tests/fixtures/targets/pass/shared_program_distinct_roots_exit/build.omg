machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "shared_program_distinct_roots_exit" };
    Build::bind(builder, windows_x86_64::ProgramEntry, normal);
    Build::bind(builder, macos_arm64::ProgramEntry, normal);
    Build::bind(builder, linux_x86_64::ProgramEntry, trapping);
    Optimizations::enable(@mutable builder.optimizations, Optimization::ControlFlowCleanup);
}
