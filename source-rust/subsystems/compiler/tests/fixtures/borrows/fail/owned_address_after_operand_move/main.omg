data Cell { value: u64; }
machine consume(cell: Cell) -> u64 { cell.value }
machine replace(slot: @mutable Cell) -> u64 { slot.value = 9; 0 }
machine receive(first: u64, second: u64) {}
machine main() {
    let mutable cell: Cell = Cell { value: 7 };
    receive(consume(cell), replace(@mutable cell));
}
