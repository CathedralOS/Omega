use omega\language\core\ProcessExit;
data Main { status: i32; }

machine finish(first: @mutable Main, second: @mutable Main) reaches ProcessExit {
    ProcessExit::exit_process(0);
}

machine entry_start() reaches ProcessExit {
    let mutable first: Main;
    let mutable second: Main;
    finish(@mutable first, @mutable first);
}
