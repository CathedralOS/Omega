use {omega}/language/core/process_exit.omg;
data Main { status: i32; }

machine finish(first: @mutable Main, second: @mutable Main) reaches |process_exit|::ProcessExit {
    |process_exit|::ProcessExit::exit_process(0);
}

machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable first: Main;
    let mutable second: Main;
    finish(@mutable first, @mutable first);
}
