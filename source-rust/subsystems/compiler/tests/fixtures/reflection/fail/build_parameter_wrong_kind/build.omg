use main.omg as app;
use {api}/main.omg as api;
use {omega}/build/dependency.omg;
use {omega}/language/core/reflect/reflect.omg;
machine build(builder: @mutable Build) {
    Build::application(builder, "build_parameter_description");
    let mutable description: DependencyDescription = |dependency|::from_source(Source::Path { location: "../../run/build_parameter_description/library" });
    |dependency|::with_alias(@mutable description, "api");
    let registration: DependencyRegistration = Build::dependency(builder, description);
    let parameter: |reflect|::ParameterInfo = |reflect|::parameter(|api|::Table::invoke);
    let field: |reflect|::FieldInfo = |reflect|::field(|api|::Table::invoke);
    transition parameter.declaration_position == 1u64 && field.declaration_position == 1u64
        && field.name == "invoke" && parameter.parameter_identity != ""
        && parameter.requirement_application != "" && field.owner_application != ""
        && parameter.source_revision != "" && field.source_revision != "" {
        true -> accept(builder),
        false -> reject()
    }
    machine accept(builder: @mutable Build) {
        Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
        Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
        Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
        Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    }
    machine reject() crashes Trap { crash Trap; }
}
