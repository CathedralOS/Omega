// The column loop requires `x <= grid.columns`, but the row state's own
// requirement names only `grid.rows`. Entering the column loop with x = 0
// needs the value `grid.columns` holds when the row state is entered.
data Grid {
    rows: u32;
    columns: u32;
}

machine main() crashes Trap {
    let mutable grid: Grid;
    grid.rows = 2;
    grid.columns = 3;
    walk(@mutable grid);
}

machine walk(grid: @mutable Grid) {
    transition { _ -> row(grid, 0) }

    machine row(grid: @mutable Grid, y: u32)
        requires y <= grid.rows
    {
        transition { _ -> column(grid, y, 0) }
    }
    machine column(grid: @mutable Grid, y: u32, x: u32)
        requires y <= grid.rows && x <= grid.columns
    {
        transition x < grid.columns {
            true -> column(grid, y, x + 1),
            _ -> next_row(grid, y)
        }
    }
    machine next_row(grid: @mutable Grid, y: u32)
        requires y <= grid.rows
    {
        transition y < grid.rows {
            true -> row(grid, y + 1),
            _ -> done()
        }
    }
    machine done() {}
}
