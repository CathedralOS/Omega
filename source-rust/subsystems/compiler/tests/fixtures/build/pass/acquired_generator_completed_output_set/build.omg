use {omega}/build/dependency.omg;

machine build(plan: @mutable BuildPlan) {
    let mutable generator: DependencyDescription = |dependency|::from_source(Source::Path { location: "generator" });
    |dependency|::with_alias(@mutable generator, "generator");
    _ = |dependency|::add(plan, generator);
    plan.product = BuildProduct::InterpretedBuild { entry: "outputs.omg" };
}
