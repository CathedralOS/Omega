// Deployable native canary: every hosted target binds the entry through a
// compiler-issued product-entry description returned by a build helper,
// never a declaration path re-resolved at the bind site.

use left/left.omg;
use {omega}/build/dependency.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "described_runner_entry_left_exit");
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "../../../../../../../../source/library/system" }));
    Build::select_provider::<|left|::Reader, |left|::ProviderReaderImplementation>(builder, linux_arm64);
    Build::select_provider::<|left|::Reader, |left|::ProviderReaderImplementation>(builder, linux_x86_64);
    Build::select_provider::<|left|::Reader, |left|::ProviderReaderImplementation>(builder, macos_arm64);
    Build::select_provider::<|left|::Reader, |left|::ProviderReaderImplementation>(builder, macos_x86_64);
    Build::select_provider::<|left|::Reader, |left|::ProviderReaderImplementation>(builder, windows_x86_64);
    Build::select_provider::<|left|::Reader, |left|::ProviderReaderImplementation>(builder, uefi_x86_64);
    Build::select_provider::<|left|::Reader, |left|::ProviderReaderImplementation>(builder, cross_platform_cli);
    Build::select_provider::<|left|::Reader, |left|::ProviderReaderImplementation>(builder, local_unchecked);
    Build::select_provider::<|left|::Reader, |left|::ProviderReaderImplementation>(builder, alpha_bootstrap);
    Build::bind(builder, macos_arm64::ProgramEntry, choose(builder, "macos_arm64::ProgramEntry"));
    Build::bind(builder, linux_arm64::ProgramEntry, choose(builder, "linux_arm64::ProgramEntry"));
    Build::bind(builder, linux_x86_64::ProgramEntry, choose(builder, "linux_x86_64::ProgramEntry"));
    Build::bind(builder, windows_x86_64::ProgramEntry, choose(builder, "windows_x86_64::ProgramEntry"));
}

// The helper selects under this package's own product frontier and hands the
// opaque description back; `roots.bind` rejoins it to the exact machine the
// query chose.
machine choose(builder: @mutable Build, slot: @[u8]) -> ProductEntryRef {
    BuildDeclarations::entry(@builder.declarations, "left::run", slot)
}
