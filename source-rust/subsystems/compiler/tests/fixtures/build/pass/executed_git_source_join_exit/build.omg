use main.omg as app;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "executed_git_source_join_exit" };
    request_sources(builder);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
}

machine request_sources(builder: @mutable BuildPlan) {
    let mutable selected_dependency: DependencyDescription = |dependency|::from_source(Source::Git {
        repository: "https://omega-source.invalid/executed-source.git",
        revision: "executed-build-fixture-v1",
        selection: PackageSelection::Root
    });
    |dependency|::with_alias(@mutable selected_dependency, "selected");
    let selected_registration: DependencyRegistration = Build::dependency(builder, selected_dependency);
    let mutable shared_dependency: DependencyDescription = |dependency|::from_source(Source::Git {
        repository: "https://omega-source.invalid/executed-source.git",
        revision: "executed-build-fixture-v1",
        selection: PackageSelection::Root
    });
    |dependency|::with_alias(@mutable shared_dependency, "shared");
    let shared_registration: DependencyRegistration = Build::dependency(builder, shared_dependency);
}
