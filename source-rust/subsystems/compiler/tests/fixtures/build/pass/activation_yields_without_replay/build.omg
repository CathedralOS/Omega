// The role is issued before enough ordinary work to cross a scheduling slice.
// Replaying it would create a duplicate project declaration at the final join.
use main.omg as app;

machine build(builder: @mutable Build) {
    Build::application(builder, "activation_yields_without_replay");
    let remaining: u64 = count_down(512);
    transition remaining == 0 {
        true -> bind_entries(builder),
        false -> unexpected_result(builder)
    }
}

machine count_down(remaining: u64) -> u64
terminates by remaining {
    transition remaining > 0 {
        true -> count_down(remaining - 1),
        false -> 0
    }
}

machine bind_entries(builder: @mutable Build) {
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}

machine unexpected_result(builder: @mutable Build) {
    Build::application(builder, "unexpected_result");
}
