use {leaf}/main.omg as leaf;
use {omega}/build/dependency.omg;
use {omega}/language/core/program_image.omg as image;

machine build(builder: @mutable BuildPlan) suspends
requires address::Bound == 18446744073709551616 {
    builder.product = BuildProduct::Package { name: "nested_backing" };
    let mutable leaf_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "leaf" });
    |dependency|::with_alias(@mutable leaf_dependency, "leaf");
    let leaf_registration: DependencyRegistration = Build::build_dependency(builder, leaf_dependency);
    BuildLog::write_line(@mutable builder.log, "backing before");
    suspend Build::await_provider::<|image|::ProgramImage, |leaf|::LeafImage>(builder);
    let observed: address = |image|::ProgramImage::retained_suffix_start();
    transition observed == 64 {
        true -> finish(builder),
        _ -> wrong(builder)
    }
    machine finish(builder: @mutable BuildPlan) {
        BuildLog::write_line(@mutable builder.log, "backing after");
    }
    machine wrong(builder: @mutable BuildPlan) {
        builder.product = BuildProduct::Package { name: "wrong_nested_backing" };
    }
}
