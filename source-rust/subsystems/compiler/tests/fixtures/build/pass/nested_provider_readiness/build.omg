use main.omg as app;
use {backing}/main.omg as backing;
use {omega}/build/dependency.omg;
use {omega}/language/core/program_image.omg as image;

machine build(builder: @mutable BuildPlan) suspends
requires address::Bound == 18446744073709551616 {
    builder.product = BuildProduct::Application { name: "nested_readiness" };
    let mutable backing_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "backing" });
    |dependency|::with_alias(@mutable backing_dependency, "backing");
    let backing_registration: DependencyRegistration = Build::build_dependency(builder, backing_dependency);
    BuildLog::write_line(@mutable builder.log, "root before");
    suspend Build::await_provider::<|image|::ProgramImage, |backing|::TestImage>(builder);
    let observed: address = |image|::ProgramImage::retained_suffix_start();
    transition observed == 64 {
        true -> finish(builder),
        _ -> wrong(builder)
    }
    machine finish(builder: @mutable BuildPlan) {
        BuildLog::write_line(@mutable builder.log, "root after");
        Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
        Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
        Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
        Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    }
    machine wrong(builder: @mutable BuildPlan) {
        builder.product = BuildProduct::Application { name: "wrong_root_backing" };
    }
}
