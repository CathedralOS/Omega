machine build(builder: @mutable Build) {
    Build::application(builder, "captured_named_input_required_output");
    Build::artifact_only(builder);
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "named.txt");
    let input: BuildSource = BuildInputs::get(@builder.inputs, "template");
    let path: BuildPath = BuildSource::resolve(@input, "input.txt");
    let reader: i32 = BuildSource::open(@input, path, 0);
    let mutable bytes: [u8; 6];
    let read_count: i64 = BuildSource::read(@input, reader, @mutable bytes[..], 6);
    _ = BuildSource::close(@input, reader);
    let missing_path: BuildPath = BuildSource::resolve(@input, "package-only.txt");
    let missing_reader: i32 = BuildSource::open(@input, missing_path, 0);
    transition read_count == 6 && bytes[0] == 78 && bytes[5] == 10 && missing_reader < 0 {
        true -> correct(builder, obligation, @bytes),
        _ -> incorrect(builder, obligation)
    }
    machine correct(builder: @mutable Build, obligation: RequiredOutput, bytes: @[u8; 6]) {
        let output: BuildPath = BuildOutput::resolve(@builder.output, "named.txt");
        let writer: i32 = BuildOutput::create(@mutable builder.output, output, 0);
        _ = BuildOutput::write(@mutable builder.output, writer, @bytes[..]);
        _ = BuildOutput::close(@mutable builder.output, writer);
        let completion: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, output);
        settle(builder, completion);
    }
    machine incorrect(builder: @mutable Build, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "named input read did not retain slot bytes");
    }
}

machine settle(builder: @mutable Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: @mutable Build) {}
    machine failed(builder: @mutable Build, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "named output did not seal");
    }
}
