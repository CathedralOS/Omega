machine build(plan: @mutable BuildPlan) {
    copy(plan, "main.omg", "main.omg");
    copy(plan, "asset.txt", "generated.omg");
    copy(plan, "finish.template", "finish.omg");
    let output: BuildPath = BuildOutput::resolve(@plan.output, "");
    plan.package_root = BuildPackageRoot::Directory { path: output };
    plan.product = BuildProduct::InterpretedBuild { entry: "finish.omg" };
}

machine copy(plan: @mutable BuildPlan, source_name: @[u8], destination_name: @[u8]) crashes Trap {
    let source: BuildPath = BuildSource::resolve(@plan.source, source_name);
    let reader: i32 = BuildSource::open(@plan.source, source, 0);
    let destination: BuildPath = BuildOutput::resolve(@plan.output, destination_name);
    let writer: i32 = BuildOutput::create(@mutable plan.output, destination, 0);
    transfer(plan, reader, writer);
    _ = BuildSource::close(@plan.source, reader);
    _ = BuildOutput::close(@mutable plan.output, writer);
}

machine transfer(plan: @mutable BuildPlan, reader: i32, writer: i32) crashes Trap {
    let mutable byte: [u8; 1];
    let count: i64 = BuildSource::read(@plan.source, reader, @mutable byte[..], 1u64);
    transition count {
        0i64 -> done(),
        1i64 -> write_byte(plan, reader, writer, byte),
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
    machine write_byte(plan: @mutable BuildPlan, reader: i32, writer: i32, byte: [u8; 1]) {
        let written: i64 = BuildOutput::write(@mutable plan.output, writer, @byte[..]);
        transition written == 1i64 {
            true -> transfer(plan, reader, writer),
            false -> failed()
        }
    }
}
