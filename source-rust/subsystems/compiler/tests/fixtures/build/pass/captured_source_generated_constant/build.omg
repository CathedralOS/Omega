machine build(builder: @mutable Build) {
    Build::application(builder, "captured_source_generated_constant");
    Build::artifact_only(builder);
    let source_path: BuildPath = BuildSource::resolve(@builder.source, "asset.txt");
    let reader: i32 = BuildSource::open(@builder.source, source_path, 0);
    let mutable bytes: [u8; 31];
    _ = BuildSource::read(@builder.source, reader, @mutable bytes[..], 31);
    _ = BuildSource::close(@builder.source, reader);
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "generated.omg");
    let generated: BuildPath = BuildOutput::resolve(@builder.output, "generated.omg");
    let writer: i32 = BuildOutput::create(@mutable builder.output, generated, 0);
    _ = BuildOutput::write(@mutable builder.output, writer, @bytes[..]);
    _ = BuildOutput::close(@mutable builder.output, writer);
    Build::include_source(builder, "generated.omg", @bytes[..]);
    let completion: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, generated);
    settle(builder, completion);
}

machine settle(builder: @mutable Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: @mutable Build) {}
    machine failed(builder: @mutable Build, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "generated source did not seal");
    }
}
