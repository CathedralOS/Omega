use main.omg as app;
use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
 builder.product = BuildProduct::Application { name: "native_row_outranks_scoped_implementations" };
 Build::select_provider::<|app|::Distance, |app|::MacosDistance>(builder, macos_arm64);
 Build::select_provider::<|app|::Distance, |app|::LinuxArmDistance>(builder, linux_arm64);
 Build::bind_native::<|app|::Distance::absolute>(builder, windows_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::PeByName { library: "msvcrt.dll", export: "abs" } });
 Build::bind_native::<|app|::Distance::absolute>(builder, linux_x86_64, |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned { object: "libc.so.6", symbol: "abs", version: "GLIBC_2.2.5" } });
 Build::bind(builder, windows_x86_64::ProgramEntry, |app|::native_entry);
 Build::bind(builder, linux_x86_64::ProgramEntry, |app|::native_entry);
 Build::bind(builder, linux_arm64::ProgramEntry, |app|::linux_arm_entry);
 Build::bind(builder, macos_arm64::ProgramEntry, |app|::macos_entry);
}
