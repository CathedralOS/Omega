// Expected diagnostic contains: cannot prove requires contract for call launch.
// The installed arrival establishes the named source predicate before invocation.
use {omega}/language/core/foundation.omg as proof;

let is_zero(value: u32): |proof|::Strict<0> = value == 0u32;

let reflexive(value: u32): |proof|::Strict<0> = value == value;

machine launch() requires is_zero(1u32) { }
