use main.omg as app;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "installed_named_predicate" };
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::launch);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::launch);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::launch);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::launch);
}
