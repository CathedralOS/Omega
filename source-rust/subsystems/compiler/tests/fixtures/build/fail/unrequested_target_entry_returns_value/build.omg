use main.omg as app;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "unrequested_target_entry_returns_value" };
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::launch);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::foreign_launch);
}
