machine build(builder: @mutable Build) {
    Build::application(builder, "staging_byte_limit_exhausted");
    Build::artifact_only(builder);
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "output.txt");
    let path: BuildPath = BuildOutput::resolve(@builder.output, "output.txt");
    let writer: i32 = BuildOutput::create(@mutable builder.output, path, 0);
    _ = BuildOutput::write(@mutable builder.output, writer, "four");
    _ = BuildOutput::close(@mutable builder.output, writer);
    let completion: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, path);
    settle(builder, completion);
}

machine settle(builder: @mutable Build, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: @mutable Build) {}
    machine failed(builder: @mutable Build, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "output did not seal");
    }
}
