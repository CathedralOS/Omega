// A domain that applies its policy at static arguments. No pass resolves those
// arguments yet, so the domain holds a deferred refusal instead of stopping
// the program.

use {omega}/language/core/layout.omg;
use {omega}/language/core/reflect/reflect.omg;
use {omega}/language/core/access/access.omg;

data Cell {
    value: u64;
}

data Other {
    value: u64;
}

CellAccess satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan reaches none crashes none terminates {
        |access|::new_plan(@schema, |layout|::Issuance::Only { routes: [] })
    }
}

NumericAccess<const Count: u64> satisfies |layout|::AccessPolicy {
    |layout|::AccessPolicy::plan = CellAccess::plan;
}

domain Cell::Controlled
    requires self.value <= 100
    access CellAccess<Cell>;

domain Other::Controlled
    requires self.value <= 100
    access CellAccess<Cell>;

domain Cell::Counted
    requires self.value <= 100
    access NumericAccess<7>;

domain Cell::Plain
    requires self.value <= 100;

machine main() { }
