
data Checksum { count: i32 in Saturating; }

machine touch(sink: @mutable Checksum) { sink.count = sink.count + 1; }

machine carry(value: f64, sink: @mutable Checksum) -> f64 {
    touch(sink);
    (value + 1.0)
}

machine main() crashes Trap {
    let mutable sink: Checksum;
    let observed: f64 = carry(41.5, @mutable sink);
    transition observed == 42.5 && sink.count == 1 {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
