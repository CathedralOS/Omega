use {system}/filesystem_host.omg;
use {omega}/language/core/filesystem_authority.omg;
use {omega}/language/core/process_exit.omg;
use {system}/filesystem.omg;
// Canonicalize a file and a directory, then require NotFound for a missing
// path. Windows opens either kind with CreateFileW(FILE_FLAG_BACKUP_SEMANTICS)
// and asks GetFinalPathNameByHandleW for the DOS spelling before CloseHandle.
// A Windows host returns a leading backslash. The Windows Psi receiver retains
// the relative probe key starting with 'o'. The POSIX entry expects '/'.
// exits: 70 good; 71 seed write failed; 72 canonicalize refused; 73 the
// resolved buffer starts with neither model's spelling; 74 the
// missing-path leg did not refuse; 75 the refusal kind was not NotFound;
// 76 directory creation failed; 77 directory canonicalize refused; 78 the
// resolved directory buffer starts with neither model's spelling.



// Separate entry for the host-call-count regression: failed acquisition must
// observe its error without querying or closing the invalid handle.
data FailedOpen {
    buffer: [u8; 1024];
    result: |filesystem|::UnitResult;
}

machine failed_open_result(failed_open: @mutable FailedOpen) -> i32
reaches |filesystem_authority|::FilesystemMetadataQuery blocks {
    let outcome: |filesystem|::UnitResult = block |filesystem|::Filesystem::canonicalize("omega_wcanon_missing.txt" as + |filesystem_host|::Path, @mutable failed_open.buffer[..]);
    transition outcome {
        |filesystem|::UnitResult::Error { kind } -> failed(kind),
        _ -> unexpected()
    }
    machine failed(kind: |filesystem|::ErrorKind) -> i32 {
        transition kind { |filesystem|::ErrorKind::NotFound -> expected(), _ -> unexpected() }
    }
    machine expected() -> i32 { 70 }
    machine unexpected() -> i32 { 71 }
}

data Main {
    windows: bool;
    unit_result: |filesystem|::UnitResult;
    canon: [u8; 1024];
}

machine run(main: @mutable Main)
reaches |process_exit|::ProcessExit + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemNamespaceMutation
blocks {
    main.unit_result = block |filesystem|::Filesystem::write_all("omega_wcanon_probe.txt" as + |filesystem_host|::Path, "canon");
    transition main.unit_result { |filesystem|::UnitResult::Ok -> block resolve(main), _ -> bad(main, 71) }
    machine resolve(main: @mutable Main) {
        main.unit_result = block |filesystem|::Filesystem::canonicalize("omega_wcanon_probe.txt" as + |filesystem_host|::Path, @mutable main.canon[..]);
        transition main.unit_result { |filesystem|::UnitResult::Ok -> block spelled(main), _ -> bad(main, 72) }
    }
    machine spelled(main: @mutable Main) {
        // Native: '\\' (92, the \\?\ prefix). Hermetic: 'o' (111, the key
        // verbatim). Anything else = the resolve never wrote the buffer.
        transition canonical_prefix_is_valid(main.windows, main.canon[0]) { true -> block make_dir(main), _ -> bad(main, 73) }
    }
    machine make_dir(main: @mutable Main) {
        main.unit_result = block |filesystem|::Filesystem::create_dir("omega_wcanon_dir" as + |filesystem_host|::Path);
        transition main.unit_result { |filesystem|::UnitResult::Ok -> block resolve_dir(main), _ -> bad(main, 76) }
    }
    machine resolve_dir(main: @mutable Main) {
        main.unit_result = block |filesystem|::Filesystem::canonicalize("omega_wcanon_dir" as + |filesystem_host|::Path, @mutable main.canon[..]);
        transition main.unit_result { |filesystem|::UnitResult::Ok -> block spelled_dir(main), _ -> bad(main, 77) }
    }
    machine spelled_dir(main: @mutable Main) {
        transition canonical_prefix_is_valid(main.windows, main.canon[0]) { true -> block missing(main), _ -> bad(main, 78) }
    }
    machine missing(main: @mutable Main) {
        let outcome: |filesystem|::UnitResult = block |filesystem|::Filesystem::canonicalize("omega_wcanon_missing.txt" as + |filesystem_host|::Path, @mutable main.canon[..]);
        transition outcome { |filesystem|::UnitResult::Error { kind } -> block kindcheck(main, kind), _ -> bad(main, 74) }
    }
    machine kindcheck(main: @mutable Main, kind: |filesystem|::ErrorKind) {
        // The open leg's captured GetLastError supplies this classification.
        transition kind { |filesystem|::ErrorKind::NotFound -> block cleanup(main), _ -> bad(main, 75) }
    }
    machine cleanup(main: @mutable Main) {
        main.unit_result = block |filesystem|::Filesystem::remove("omega_wcanon_probe.txt" as + |filesystem_host|::Path);
        transition { _ -> block cleanup_dir(main) }
    }
    machine cleanup_dir(main: @mutable Main) {
        main.unit_result = block |filesystem|::Filesystem::remove_dir("omega_wcanon_dir" as + |filesystem_host|::Path);
        transition { _ -> good(main) }
    }
    machine good(main: @mutable Main) { |process_exit|::ProcessExit::exit_process(70); }
    machine bad(main: @mutable Main, code: i32) { |process_exit|::ProcessExit::exit_process(code); }
}

// Native POSIX paths start with '/'. Windows returns a DOS path prefix or the
// hermetic receiver's stored relative key. The selected entry supplies the OS.
machine canonical_prefix_is_valid(windows: bool, byte: u8) -> bool {
    transition windows { true -> (byte == 92 || byte == 111), false -> (byte == 47) }
}

machine windows_entry()
reaches |process_exit|::ProcessExit + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemNamespaceMutation
blocks {
    let mutable storage: Main;
    storage.windows = true;
    block run(@mutable storage);
}

machine posix_entry()
reaches |process_exit|::ProcessExit + |filesystem_authority|::FilesystemContentRead + |filesystem_authority|::FilesystemContentWrite + |filesystem_authority|::FilesystemMetadataMutation + |filesystem_authority|::FilesystemMetadataQuery + |filesystem_authority|::FilesystemNamespaceMutation
blocks {
    let mutable storage: Main;
    storage.windows = false;
    block run(@mutable storage);
}
