use {omega}/language/core/layout.omg;
public boundary trait FatalVector00 { machine enter() reaches none crashes Abort ensures false; }
public data InterruptGate { selector: u16; ist: u8; attributes: u8; reserved: u32; }

public GateSlot00 satisfies |layout|::PrivateCallbackSlot<InterruptGate, GateLayout00, FatalVector00::enter> {}
public GateLayout00 satisfies |layout|::FixedLayout<InterruptGate> {
    machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan reaches none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 2 } };
        entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 4 } };
        entries[2] = |layout|::FieldEntry { key: schema.fields[2].key, representation: |layout|::FieldPlan::At { offset: 5 } };
        entries[3] = |layout|::FieldEntry { key: schema.fields[3].key, representation: |layout|::FieldPlan::At { offset: 12 } };
        let plan: |layout|::LayoutPlan = |layout|::LayoutPlan { entries: entries, entry_count: 4, size_fixed: 16, size_is_dynamic: false, align: 8 };
        let low: |layout|::LayoutPlan = |layout|::layout_plan_place_private_field::<GateSlot00>(plan,
            |layout|::FieldPlan::Bits { container: 0, container_width: 16, destination_lsb: 0, source_lsb: 0, width: 16 });
        let middle: |layout|::LayoutPlan = |layout|::layout_plan_place_private_field::<GateSlot00>(low,
            |layout|::FieldPlan::Bits { container: 6, container_width: 16, destination_lsb: 0, source_lsb: 16, width: 16 });
        |layout|::layout_plan_place_private_field::<GateSlot00>(middle,
            |layout|::FieldPlan::Bits { container: 8, container_width: 32, destination_lsb: 0, source_lsb: 32, width: 32 })
    }
}

machine main() crashes Trap {
    let mutable value: |layout|::LayoutStorage<InterruptGate, GateLayout00>;
    value.selector = 3u16;
    transition size_of::<|layout|::LayoutStorage<InterruptGate, GateLayout00>>() == 16u64 && value.selector == 3u16 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
