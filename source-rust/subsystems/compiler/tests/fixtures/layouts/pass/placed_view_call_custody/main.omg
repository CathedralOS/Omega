// Source-produced helper custody qualification; no native entry is bound.
// The embedding test establishes exact backings and checks external effects.
use {omega}/language/core/layout.omg;
use {omega}/language/core/reflect/reflect.omg;
use {omega}/language/core/access/access.omg;

public data Registers {
    status: u32;
    transmit: u8;
}

// Geometry and access are separate selections: the layout places status at 0
// and transmit at 4, and the policy grants an external read of status and an
// external write of transmit, with no issuer restriction and no added reach.
public data RegisterStorage = |layout|::LayoutStorage<Registers, RegisterLayout>;
public domain Registers::Placed
    access RegisterAccess;

public RegisterLayout satisfies |layout|::FixedLayout<Registers> {
    public machine plan(schema: |layout|::Schema, target: |layout|::LayoutTarget) -> |layout|::LayoutPlan reaches none crashes none terminates {
        let mutable entries: [|layout|::FieldEntry; 64];
        entries[0] = |layout|::FieldEntry { key: schema.fields[0].key, representation: |layout|::FieldPlan::At { offset: 0 } };
        entries[1] = |layout|::FieldEntry { key: schema.fields[1].key, representation: |layout|::FieldPlan::At { offset: 4 } };
        |layout|::LayoutPlan { entries: entries, entry_count: 2, size_fixed: 8, size_is_dynamic: false, align: 4 }
    }
}

public RegisterAccess satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan reaches none crashes none terminates {
        let mutable plan: |layout|::AccessPlan = |access|::new_plan(@schema, |layout|::Issuance::Unrestricted);
        |access|::observe(@mutable plan, |reflect|::field(Registers::status),
            |layout|::FieldAccess::External { read: |layout|::ExternalRead::Read, write: false, exposure: |layout|::Exposure::Exported });
        |access|::observe(@mutable plan, |reflect|::field(Registers::transmit),
            |layout|::FieldAccess::External { read: |layout|::ExternalRead::None, write: true, exposure: |layout|::Exposure::Exported });
        plan
    }
}

// The host establishes the backing and binds these exact generated accessors.
// Delegation retains the original backing; neither wrapper stages contents.
machine observe(view: @RegisterStorage in Registers::Placed) -> u32 {
    |layout|::read::<|layout|::Accessor<u32>, u32>(@view.status)
}

machine delegate(view: @RegisterStorage in Registers::Placed) -> u32 { observe(view) }

machine mutate(view: @mutable RegisterStorage in Registers::Placed) -> u32 {
    |layout|::write::<|layout|::Accessor<u8>, u8>(@mutable view.transmit, 9u8);
    |layout|::read::<|layout|::Accessor<u32>, u32>(@view.status)
}

machine delegate_mutable(view: @mutable RegisterStorage in Registers::Placed) -> u32 { mutate(view) }

machine forward(view: @mutable RegisterStorage in Registers::Placed) -> u32 { delegate_mutable(view) }

machine ordered(first: @RegisterStorage in Registers::Placed, second: @RegisterStorage in Registers::Placed) -> u64 {
    let first_status: u32 = observe(first);
    let second_status: u32 = observe(second);
    (first_status as u64) * 1000 + (second_status as u64)
}

machine reordered(left: @RegisterStorage in Registers::Placed, right: @RegisterStorage in Registers::Placed) -> u64 {
    ordered(right, left)
}

machine alias_entry(shared: @RegisterStorage in Registers::Placed, exclusive: @mutable RegisterStorage in Registers::Placed) -> u64 {
    let first: u32 = observe(shared);
    let second: u32 = mutate(exclusive);
    (first as u64) + (second as u64)
}

public data Plain { value: u32; }

machine mixed(seed: u32, plain: @Plain, view: @mutable RegisterStorage in Registers::Placed) -> u64 {
    let status: u32 = delegate_mutable(view);
    (seed as u64) + (plain.value as u64) + (status as u64)
}

machine ordinary_alias(view: @RegisterStorage in Registers::Placed, storage: @mutable Plain) -> u32 {
    observe(view)
}

machine later(view: @mutable RegisterStorage in Registers::Placed) -> u32 {
    transition { _ -> next(view) }
    machine next(view: @mutable RegisterStorage in Registers::Placed) -> u32 {
        delegate_mutable(view)
    }
}

// Unit-returning helpers use the same structural telescope and occurrence.
machine write_only(view: @mutable RegisterStorage in Registers::Placed) {
    |layout|::write::<|layout|::Accessor<u8>, u8>(@mutable view.transmit, 9u8);
}
machine unit_delegate(view: @mutable RegisterStorage in Registers::Placed) -> u32 {
    write_only(view);
    observe(view)
}

// Initialized ordinary RAM lends its source through the explicit factory.
// Runtime acceptance is 41 with transmit changed to 9 in the same backing.
machine ram_borrow() -> u32 {
    let mutable registers: Registers = Registers { status: 41, transmit: 3 };
    let view: @mutable RegisterStorage in Registers::Placed = |access|::view_mut::<Registers, RegisterStorage in Registers::Placed>(@mutable registers);
    let observed: u32 = mutate(view);
    observed
}

machine ram_descriptor() -> u32 {
    let mutable registers: Registers = Registers { status: 41, transmit: 3 };
    let source: @mutable Registers = @mutable registers;
    let view: @mutable RegisterStorage in Registers::Placed = |access|::view_mut::<Registers, RegisterStorage in Registers::Placed>(source);
    mutate(view)
}

public data SelectionCounter { count: u32; }
machine choose_register(counter: @mutable SelectionCounter) -> u64
requires counter.count < 2
ensures counter.count <= 2
ensures result == 0
{
    counter.count = counter.count + 1;
    0
}

// The selector must execute once; the independent eventual runtime oracle is 4101.
machine ram_indexed() -> u64 {
    let mutable registers: [Registers; 2] = [
        Registers { status: 41, transmit: 3 },
        Registers { status: 73, transmit: 5 }
    ];
    let mutable counter: SelectionCounter = SelectionCounter { count: 0 };
    let view: @mutable RegisterStorage in Registers::Placed = |access|::view_mut::<Registers, RegisterStorage in Registers::Placed>(@mutable registers[choose_register(@mutable counter)]);
    let observed: u32 = mutate(view);
    (observed as u64) * 100 + (counter.count as u64)
}

// Capture and retire initialized RAM without granting a scalar field operation.
// Frozen interpreter result: 41 from the original storage after retirement.
machine ram_capture_only() -> u32 {
    let mutable registers: Registers = Registers { status: 41, transmit: 3 };
    let view: @mutable RegisterStorage in Registers::Placed = |access|::view_mut::<Registers, RegisterStorage in Registers::Placed>(@mutable registers);
    registers.status
}

machine retain_ram(view: @mutable RegisterStorage in Registers::Placed, counter: @mutable SelectionCounter)
requires counter.count < 1
ensures counter.count <= 1
{
    counter.count = counter.count + 1;
}

machine return_ram<'a>(view: @'a mutable RegisterStorage in Registers::Placed, counter: @mutable SelectionCounter) -> @'a mutable RegisterStorage in Registers::Placed
requires counter.count < 1
ensures counter.count <= 1
{
    counter.count = counter.count + 1;
    view
}

// Frozen results: 4101; the ordinary helper runs once and the RAM loan retires.
machine ram_capture_helper() -> u64 {
    let mutable registers: Registers = Registers { status: 41, transmit: 3 };
    let mutable counter: SelectionCounter = SelectionCounter { count: 0 };
    let view: @mutable RegisterStorage in Registers::Placed = |access|::view_mut::<Registers, RegisterStorage in Registers::Placed>(@mutable registers);
    retain_ram(view, @mutable counter);
    (registers.status as u64) * 100 + (counter.count as u64)
}

machine ram_capture_return() -> u64 {
    let mutable registers: Registers = Registers { status: 41, transmit: 3 };
    let mutable counter: SelectionCounter = SelectionCounter { count: 0 };
    let view: @mutable RegisterStorage in Registers::Placed = |access|::view_mut::<Registers, RegisterStorage in Registers::Placed>(@mutable registers);
    let returned: @mutable RegisterStorage in Registers::Placed = return_ram(view, @mutable counter);
    (registers.status as u64) * 100 + (counter.count as u64)
}

// Frozen result4109 observes the original RAM after the write/read pair.
machine ram_original_backing() -> u64 {
    let mutable registers: Registers = Registers { status: 41, transmit: 3 };
    let view: @mutable RegisterStorage in Registers::Placed = |access|::view_mut::<Registers, RegisterStorage in Registers::Placed>(@mutable registers);
    let observed: u32 = mutate(view);
    (observed as u64) * 100 + (registers.transmit as u64)
}
