use main.omg as app;
use {support}/values.omg as support;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "unannotated_imported_boundary_call_through_local" };
    let support_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "../support" }));
    Build::select_provider::<|support|::Mark, |app|::MarkerMark>(builder, linux_arm64);
    Build::select_provider::<|support|::Mark, |app|::MarkerMark>(builder, linux_x86_64);
    Build::select_provider::<|support|::Mark, |app|::MarkerMark>(builder, macos_arm64);
    Build::select_provider::<|support|::Mark, |app|::MarkerMark>(builder, macos_x86_64);
    Build::select_provider::<|support|::Mark, |app|::MarkerMark>(builder, windows_x86_64);
    Build::select_provider::<|support|::Mark, |app|::MarkerMark>(builder, uefi_x86_64);
    Build::select_provider::<|support|::Mark, |app|::MarkerMark>(builder, cross_platform_cli);
    Build::select_provider::<|support|::Mark, |app|::MarkerMark>(builder, local_unchecked);
    Build::select_provider::<|support|::Mark, |app|::MarkerMark>(builder, alpha_bootstrap);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
