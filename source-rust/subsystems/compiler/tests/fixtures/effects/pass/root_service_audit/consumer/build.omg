use {audit_driver}/main.omg as audit_driver;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Package { name: "audit_consumer" };
    let driver_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "../driver" }));
    configure(builder);
    transition false {
        true -> unselected(builder),
        false -> done()
    }
    machine unselected(builder: @mutable BuildPlan) {
        Build::audit_service::<|audit_driver|::Untaken>(builder);
    }
    machine done() {}
}

machine configure(builder: @mutable BuildPlan) {
    Build::audit_service::<|audit_driver|::MotorControl>(builder);
    Build::audit_service::<|audit_driver|::MotorControl>(builder);
}