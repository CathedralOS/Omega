use {omega}/language/core/content.omg;
use {owner}/main.omg as owner;
use {omega}/language/core/nat.omg;

// Importing a qualification does not authorize publishing its projection.
machine Owned::content(region: @|owner|::Region) -> |content|::CountedQuantity<|owner|::ByteUnit>
satisfies |content|::Content<|owner|::Region, |content|::CountedQuantity<|owner|::ByteUnit>>::project
{
    |content|::CountedQuantity { magnitude: |nat|::Nat::Zero }
}

machine main() {}
