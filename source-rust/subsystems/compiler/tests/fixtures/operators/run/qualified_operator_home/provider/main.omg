use units/units.omg;

machine raw_sum(left: u32, right: u32) -> u32 {
    left +% right
}

// Association with Distance must not switch this body's lexical helper.
public machine + |units|::u32::Distance::add(left: u32 in |units|::u32::Distance, right: u32 in |units|::u32::Distance) -> u32 in |units|::u32::Distance {
    raw_sum(left as - |units|::u32::Distance, right as - |units|::u32::Distance) as + |units|::u32::Distance
}
