use units/units.omg;

machine raw_sum(left: u32, right: u32) -> u32 {
    (left +% right) +% 20u32
}

// The consumer imports units, never this declaring module.
public machine + |units|::u32::Offset::add(left: u32 in |units|::u32::Offset, right: u32 in |units|::u32::Offset) -> u32 in |units|::u32::Offset {
    raw_sum(left as - |units|::u32::Offset, right as - |units|::u32::Offset) as + |units|::u32::Offset
}
