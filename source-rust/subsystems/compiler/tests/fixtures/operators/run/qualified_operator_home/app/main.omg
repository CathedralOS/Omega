use {measure}/units/units.omg;

machine main() crashes Trap {
    let distance_left: u32 in |units|::u32::Distance = 2u32 as + |units|::u32::Distance;
    let distance_right: u32 in |units|::u32::Distance = 5u32 as + |units|::u32::Distance;
    let distance: u32 in |units|::u32::Distance = distance_left + distance_right;
    let span_left: u32 in |units|::u32::Span = 3u32 as + |units|::u32::Span;
    let span_right: u32 in |units|::u32::Span = 8u32 as + |units|::u32::Span;
    let span: u32 in |units|::u32::Span = span_left + span_right;
    let offset_left: u32 in |units|::u32::Offset = 4u32 as + |units|::u32::Offset;
    let offset_right: u32 in |units|::u32::Offset = 9u32 as + |units|::u32::Offset;
    let offset: u32 in |units|::u32::Offset = offset_left + offset_right;
    transition (distance as - |units|::u32::Distance) == 7u32 && (span as - |units|::u32::Span) == 21u32 && (offset as - |units|::u32::Offset) == 33u32 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
