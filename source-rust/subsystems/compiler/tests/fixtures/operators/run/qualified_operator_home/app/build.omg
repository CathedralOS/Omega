use main.omg as app;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "qualified_operator_home" };
    let mutable selected: DependencyDescription = |dependency|::from_source(Source::Path { location: "../provider" });
    |dependency|::with_alias(@mutable selected, "measure");
    let registration: DependencyRegistration = Build::dependency(builder, selected);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
