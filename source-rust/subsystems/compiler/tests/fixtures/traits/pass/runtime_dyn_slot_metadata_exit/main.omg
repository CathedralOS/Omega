// Expected exit: 0.
// Owning requirement: RESTORE-DYNAMIC-DESCRIPTOR-AND-TABLE-CUSTODY.
// Package review keeps the argument's Utf8 requirement and records that
// the returned view borrows from that argument.
use {omega}/language/core/byte_observation/byte_observation.omg;

public domain [u8]::Utf8 requires |byte_observation|::valid_utf8(@self[..]);

data Utf8View = machine(packet: @[u8] in Utf8) -> @[u8] in Utf8 reaches none crashes none;

public trait Window {
    machine view<'input>(packet: @'input [u8] in Utf8) -> @'input [u8] in Utf8;
}

Direct satisfies Window {
    machine view<'input>(packet: @'input [u8] in Utf8) -> @'input [u8] in Utf8 { packet }
}

machine main() crashes Trap {
    let packet: @[u8] in Utf8 = "é" as +Utf8;
    let selected: Utf8View = Direct::view;
    let viewed: @[u8] in Utf8 = selected(packet);
    transition (viewed as -Utf8) == "é" {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
