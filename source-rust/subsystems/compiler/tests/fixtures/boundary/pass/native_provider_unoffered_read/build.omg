use main.omg as app;
use {omega}/language/core/external_binding.omg as native;
machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "native_provider_unoffered_read" };
    Build::bind_native::<|app|::Probe::read>(builder, linux_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "read", version: "GLIBC_2.2.5",
        } });
    Build::bind_native::<|app|::Probe::read>(builder, linux_arm64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "read", version: "GLIBC_2.17",
        } });
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);
}
