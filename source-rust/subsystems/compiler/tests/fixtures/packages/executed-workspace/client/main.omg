// Expected exit: 0
use {selected}/main.omg as selected;
use {shared}/main.omg as shared;

machine main() crashes Trap {
    transition |selected|::answer() == 73u32 && |shared|::answer() == 73u32 {
        true -> done(),
        false -> bad()
    }
}
machine done() {}
machine bad() crashes Trap { crash Trap; }
