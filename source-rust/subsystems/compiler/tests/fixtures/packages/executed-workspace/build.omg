use {omega}/build/workspace.omg;

machine build(builder: @mutable BuildPlan) {
    let members: WorkspaceMembers = declared_members(builder);
    builder.product = BuildProduct::Workspace { members: members };
}

machine declared_members(builder: @mutable BuildPlan) -> WorkspaceMembers {
    let member: WorkspaceMembers = |workspace|::with_member(builder, WorkspaceMembers {}, "member");
    let siblings: WorkspaceMembers = |workspace|::with_member(builder, member, "sibling");
    |workspace|::with_member(builder, siblings, "unselected")
}
