use {omega}/build/dependency.omg;
use {omega}/language/core/program_image.omg as image;

machine build(builder: @mutable BuildPlan)
requires address::Bound == 18446744073709551616 {
    let observed: address = |image|::ProgramImage::retained_suffix_start();
    transition observed == 64 {
        true -> declare_member(builder),
        _ -> wrong_helper(builder)
    }
    machine declare_member(builder: @mutable BuildPlan) {
        builder.product = BuildProduct::Package { name: "workspace_unselected" };
        let mutable missing_dependency: DependencyDescription = |dependency|::from_source(Source::Path { location: "../never_acquired" });
        |dependency|::with_alias(@mutable missing_dependency, "missing");
        _ = |dependency|::add(builder, missing_dependency);
    }
    machine wrong_helper(builder: @mutable BuildPlan) {
        builder.product = BuildProduct::Package { name: "workspace_selected" };
    }
}
