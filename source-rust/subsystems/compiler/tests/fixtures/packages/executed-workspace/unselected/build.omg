use {omega}/build/dependency.omg;
use {omega}/language/core/program_image.omg as image;
use {naming}/main.omg as backing;

machine build(builder: @mutable Build) {
    let mutable naming_dependency: DependencyDescription = |dependency|::from_source(Source::Git {
        repository: "https://omega-source.invalid/catalog-helper.git",
        revision: "executed-build-fixture-v1",
        selection: PackageSelection::Root
    });
    |dependency|::with_alias(@mutable naming_dependency, "naming");
    _ = |dependency|::add(builder, naming_dependency);
    Build::select_provider::<|image|::ProgramImage, |backing|::CatalogImage>(builder, interpreter);
    Build::build_entry(builder, "name.omg");
}
