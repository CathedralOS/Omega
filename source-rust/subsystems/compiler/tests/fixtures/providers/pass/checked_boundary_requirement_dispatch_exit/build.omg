// Deployable native canary: every hosted target selects its exact entry.

use main.omg as app;
use {omega}/build/dependency.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "checked_boundary_requirement_dispatch_exit");
    let system_registration: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "../../../../../../../../source/library/system" }));
    Build::select_provider::<|app|::CheckedMath, |app|::CheckedMathProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::CheckedMath, |app|::CheckedMathProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::CheckedMath, |app|::CheckedMathProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::CheckedMath, |app|::CheckedMathProvider>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::entry_start);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::entry_start);
}
