// Expected rejection: the selected child exceeds its caller's installation bound.
boundary trait X { machine touch(value: @mutable u32) reaches X crashes none; }
boundary trait Y { machine touch(value: @mutable u32) reaches Y crashes none; }
XProvider satisfies X { machine touch(value: @mutable u32) { $value = 11; } }
YProvider satisfies Y { machine touch(value: @mutable u32) { $value = 22; } }

boundary trait A { machine visit(first: @mutable u32, second: @mutable u32) reaches <= X crashes none; }
boundary trait B { machine visit(value: @mutable u32) reaches <= X + Y crashes none; }
boundary trait C { machine visit(value: @mutable u32) reaches <= X + Y crashes none; }
boundary trait D { machine visit(value: @mutable u32) reaches <= X + Y crashes none; }

AProvider satisfies A {
    machine visit(first: @mutable u32, second: @mutable u32) { B::visit(first); }
}
BProvider satisfies B { machine visit(value: @mutable u32) { Y::touch(value); } }
CProvider satisfies C { machine visit(value: @mutable u32) { D::visit(value); } }
DProvider satisfies D { machine visit(value: @mutable u32) { Y::touch(value); } }

machine main() reaches X + Y crashes Trap {
    let mutable first: u32 = 0;
    let mutable second: u32 = 0;
    A::visit(@mutable first, @mutable second);
    C::visit(@mutable second);
    transition first == 11 && second == 22 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
