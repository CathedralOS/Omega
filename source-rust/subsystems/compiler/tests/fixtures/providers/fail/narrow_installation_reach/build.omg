use main.omg as app;

machine build(builder: @mutable Build) {
    Build::application(builder, "installation_reach_baseline");
    Build::select_provider::<|app|::A, |app|::AProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::B, |app|::BProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::C, |app|::CProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::D, |app|::DProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::X, |app|::XProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::Y, |app|::YProvider>(builder, linux_x86_64);
    Build::select_provider::<|app|::A, |app|::AProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::B, |app|::BProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::C, |app|::CProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::D, |app|::DProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::X, |app|::XProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::Y, |app|::YProvider>(builder, linux_arm64);
    Build::select_provider::<|app|::A, |app|::AProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::B, |app|::BProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::C, |app|::CProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::D, |app|::DProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::X, |app|::XProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::Y, |app|::YProvider>(builder, windows_x86_64);
    Build::select_provider::<|app|::A, |app|::AProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::B, |app|::BProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::C, |app|::CProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::D, |app|::DProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::X, |app|::XProvider>(builder, macos_arm64);
    Build::select_provider::<|app|::Y, |app|::YProvider>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
