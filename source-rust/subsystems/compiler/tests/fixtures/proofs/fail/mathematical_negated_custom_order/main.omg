use {omega}/language/core/foundation.omg as proof;

data Number [copy] { value: u64; }
machine > Number::greater(left: Number, right: Number) -> bool { false }
let below(value: Number): |proof|::Strict<0> = !(value > Number { value: 5 });
machine unjustified(value: Number) -> u64
requires below(value)
{ 5u64 - value.value }
machine main() {}
