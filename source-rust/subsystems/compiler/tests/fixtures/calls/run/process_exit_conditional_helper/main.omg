use {omega}/language/core/process_exit.omg;

// Expected exit: 0. The program ends through the canonical process-exit
// requirement, which has no normal return. `require_success` exits on one
// arm and returns on the other: only the returning arm owes the guarantee,
// and there the status is zero. `main` never returns, so the storage
// `entry_start` lends it is carried into that call and nothing runs after it.
data Main { status: i32; }

machine require_success(status: i32) ensures status == 0 reaches |process_exit|::ProcessExit {
    transition status == 0 {
        true -> {},
        false -> |process_exit|::ProcessExit::exit_process(status)
    }
}

machine main(root: @mutable Main) reaches |process_exit|::ProcessExit {
    require_success(root.status);
    |process_exit|::ProcessExit::exit_process(0);
}

machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
