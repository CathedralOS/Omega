use {omega}/language/core/process_exit.omg;

// Rejected. Twin of `run/calls/statement_after_process_exit`: the
// statement after the call that never returns names a machine nothing
// declares. An unreachable statement is still source, so the unknown name
// is an error here as it is anywhere else.
data Main { status: i32; count: i32; }

machine main(root: @mutable Main) reaches |process_exit|::ProcessExit {
    |process_exit|::ProcessExit::exit_process(root.status);
    undeclared_machine(root.count);
}

machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    main(@mutable entry_storage);
}
