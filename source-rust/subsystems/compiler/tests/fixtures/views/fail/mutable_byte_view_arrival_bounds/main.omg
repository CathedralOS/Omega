machine retain(input: @mutable @mutable [u8]) {}

machine main() crashes Trap {
    let mutable backing: [u8; 2] = [41u8, 19u8];
    let mutable window: @mutable [u8] = @mutable backing[..];
    transition window.length == 2 {
        true -> inspect(window),
        false -> wrong()
    }
    machine inspect(input: @mutable [u8]) requires input.length == 2 {
        transition input[0] == 41u8 && input[2] == 19u8 {
            true -> done(),
            false -> wrong()
        }
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
