machine retain(input: @mutable @mutable [u8]) {}

machine main() crashes Trap {
    let mutable backing: [u8; 2] = [41u8, 19u8];
    let mutable window: @mutable [u8] = @mutable backing[..];
    transition window.length == 2 && window[0] == 41u8 && window[1] == 19u8 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
