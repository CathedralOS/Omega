use {omega}/language/core/layout.omg;
use {omega}/language/core/reflect/reflect.omg;
use {omega}/language/core/access/access.omg;

StampAccess satisfies |layout|::AccessPolicy {
    machine plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan reaches none crashes none terminates {
        |access|::new_plan(@schema, |layout|::Issuance::Only { routes: [|reflect|::callable(stamp)] })
    }
}

data Ticket { number: i32; }
domain Ticket::Stamped access StampAccess;
machine stamp(ticket: Ticket) -> Ticket in Stamped { ticket as +Stamped }
machine stamped(ticket: Ticket) -> Ticket in Stamped { stamp(ticket) }
machine number(ticket: Ticket in Stamped) -> i32 { ticket.number }
machine complete() { }
machine fail() crashes Trap { crash Trap; }
machine main() crashes Trap {
    let observed: i32 = number(stamped(Ticket { number: 4 }));
    transition observed == 4 { true -> complete(), _ -> fail() }
}

machine describe_ticket() -> |reflect|::TypeSchema { |reflect|::schema::<Ticket>() }

machine construct_direct_plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan {
    |access|::new_plan(@schema, |layout|::Issuance::Only { routes: [|reflect|::callable(stamp)] })
}
