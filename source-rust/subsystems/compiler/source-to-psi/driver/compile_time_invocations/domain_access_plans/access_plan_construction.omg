use {omega}/language/core/reflect/reflect.omg;
use {omega}/language/core/layout.omg;
use {omega}/language/core/access/access.omg;
use vec/vec.omg;

machine describe_cell() -> |reflect|::TypeSchema {
    |reflect|::schema::<|vec|::VecCell>()
}

machine construct_restricted_plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan {
    |access|::new_plan(@schema, |layout|::Issuance::Only { routes: [] })
}

machine construct_unrestricted_plan(schema: |reflect|::TypeSchema) -> |layout|::AccessPlan {
    |access|::new_plan(@schema, |layout|::Issuance::Unrestricted)
}

machine return_plan(plan: |layout|::AccessPlan) -> |layout|::AccessPlan { plan }



public data RuleCell { value: u32; }
public trait PlanReader { machine read() -> u32; }

machine describe_rule_cell() -> |reflect|::TypeSchema { |reflect|::schema::<RuleCell>() }

// Naming VecCell does not publish its private value field to this source file.
machine inaccessible_cell_field() -> |reflect|::FieldInfo { |reflect|::field(|vec|::VecCell::value) }

machine describe_machine() -> |reflect|::CallableInfo { |reflect|::callable(return_plan) }
machine describe_requirement() -> |reflect|::CallableInfo { |reflect|::callable(PlanReader::read) }

// The repeated field restriction cannot restore a caller denied by an earlier
// row. Descriptors remain ordinary data, including the public requirement.
machine construct_observed_plan<'text>(
    schema: |reflect|::TypeSchema<'text>,
    machine_route: |reflect|::CallableInfo<'text>,
    required_route: |reflect|::CallableInfo<'text>
) -> |layout|::AccessPlan<'text> {
    let mutable plan: |layout|::AccessPlan<'text> = |access|::new_plan(
        @schema, |layout|::Issuance::Only { routes: [machine_route, required_route] }
    );
    |access|::allow_readers(@mutable plan,
        |layout|::AccessRegion::Subject { schema: schema }, [machine_route, required_route]);
    |access|::allow_readers(@mutable plan,
        |layout|::AccessRegion::Field { field: |reflect|::field(RuleCell::value) }, [machine_route]);
    |access|::allow_readers(@mutable plan,
        |layout|::AccessRegion::Field { field: |reflect|::field(RuleCell::value) }, []);
    |access|::allow_writers(@mutable plan,
        |layout|::AccessRegion::Field { field: |reflect|::field(RuleCell::value) }, []);
    |access|::observe(@mutable plan, |reflect|::field(RuleCell::value),
        |layout|::FieldAccess::Stable { read: true, take: true, write: false, swap: true, exposure: |layout|::Exposure::Exported });
    |access|::observe(@mutable plan, |reflect|::field(RuleCell::value), |layout|::FieldAccess::Inaccessible);
    plan
}

// Transport supplied ordinary data through the same checked result owner. The
// normalizer must authenticate its contents even though the record type is real.
machine transport_observed_plan<'schema, 'text>(schema: |reflect|::TypeSchema<'schema>, plan: |layout|::AccessPlan<'text>) -> |layout|::AccessPlan<'text> { plan }


data PlanLookalike<'text> { schema: |reflect|::TypeSchema<'text>; }
machine construct_lookalike<'text>(schema: |reflect|::TypeSchema<'text>) -> PlanLookalike<'text> {
    PlanLookalike { schema: schema }
}
