// The imported file supplies both overloads of pick.
// Expected exit: 0
use kit/kit.omg;

machine main() crashes Trap {
    let first: u32 = |kit|::pick(9u32);
    let second: u64 = |kit|::pick(9u64);
    transition first == 17u32 && second == 64u64 {
        true -> done(),
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
