// Expected: native exit 0 and Psi exit 0, no output.
// The spec's `Command` example (data_and_literals.md, "Records, sums and
// nested declarations") with one more level: `op: Operation` names the
// nested sum, `user: Account` the record nested in it, and outside the
// owner they are `Command::Operation` and `Command::Operation::Account`.
// A wrong selection reaches `bad` and traps.
data Command {
    command_id: u64;
    op: Operation;

    data Operation {
        case GetUser(user: Account);
        case CountUsers;

        data Account { id: u64; }
    }
}

machine targets_one_user(op: @Command::Operation) -> bool {
    match op {
        Command::Operation::GetUser { user } -> user.id == 42,
        Command::Operation::CountUsers -> false,
    }
}

machine main() crashes Trap {
    let command: Command = Command {
        command_id: 17,
        op: Command::Operation::GetUser { user: Command::Operation::Account { id: 42 } },
    };
    transition targets_one_user(@command.op) && command.command_id == 17 {
        true -> done(),
        false -> bad(),
    }
    machine done() {}
    machine bad() { crash Trap; }
}
