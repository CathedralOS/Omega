data Item { value: u32; }
machine replace(owner: @mutable Item) {
    let replacement: Item = Item { value: 7 };
    let held: @u32 = @owner.value;
    observe(held);
    $owner = replacement;
}
machine consume(item: Item) { }
machine observe(value: @u32) { }
machine main() crashes Trap {
    let mutable item: Item = Item { value: 3 };
    replace(@mutable item);
    transition item.value == 7 {
        true -> consume(item),
        false -> bad()
    }
    machine bad() { crash Trap; }
}
