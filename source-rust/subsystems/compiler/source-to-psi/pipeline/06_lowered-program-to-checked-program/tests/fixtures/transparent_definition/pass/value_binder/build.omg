// A transparent definition with a value binder: `below` takes its bound
// as `Limit`, written at each use. `check` requires `below::<10>(value)`,
// which unfolds to `value < 10` and proves its guarantee.
let below<Limit: u64>(value: u64): core\Strict<0> = value < Limit;
machine check(value: u64) -> u64 requires below::<10>(value) ensures result < 10 { value }
machine build_entry() { let checked: u64 = check(3); }
