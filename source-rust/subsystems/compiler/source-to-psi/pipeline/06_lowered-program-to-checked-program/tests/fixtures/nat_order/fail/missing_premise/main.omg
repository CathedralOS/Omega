// The positive twin without its `requires`. `difference` holds nothing about
// `a` and `b`, so the checker refuses the `b <= a` that core's `-` requires
// at `a - b`. Here `a - b` is the first use of `subtract`, so reading its
// signature also reads `less_or_equal` for the first time; the call must
// still be checked against `subtract`.
use omega\language\core\ProcessExit;
use omega\language\core\Nat;
use omega\language\core\less_or_equal;
use omega\language\core\subtract;

machine difference(a: Nat, b: Nat) -> Nat
{
    transition { _ -> (a - b) }
}

data Main { }
machine exit_with_status(main: @mutable Main) reaches ProcessExit {
    ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit {
    let mutable entry_storage: Main;
    block exit_with_status(@mutable entry_storage);
}
