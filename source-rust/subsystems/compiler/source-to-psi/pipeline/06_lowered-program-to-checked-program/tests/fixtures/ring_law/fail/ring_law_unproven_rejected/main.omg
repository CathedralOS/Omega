// NEGATIVE 1: the law satisfier proves NOTHING (no ensures) -> must error.
use {omega}/language/core/process_exit.omg;
use {omega}/language/core/foundation.omg as proof;
data Peano { case Zero; case Succ(pred: Peano); }
trait RingOps2<T> {
    machine add(a: T, b: T) -> T reaches none crashes none terminates;
    machine add_assoc(a: T, b: T, c: T)
    ensures |proof|::Identity::<T>(add(add(a, b), c), add(a, add(b, c)));
}
machine plus(a: Peano, b: Peano) -> Peano
satisfies RingOps2<Peano>::add
terminates by a
{
    transition a {
        Peano::Zero -> (b),
        Peano::Succ { pred } -> Peano::Succ { pred: plus(pred, b) }
    }
}
machine lawless(a: Peano, b: Peano, c: Peano)
satisfies RingOps2<Peano>::add_assoc
{
}
data Main { }
machine exit_with_status(main: @mutable Main) reaches |process_exit|::ProcessExit { |process_exit|::ProcessExit::exit_process(70); }
