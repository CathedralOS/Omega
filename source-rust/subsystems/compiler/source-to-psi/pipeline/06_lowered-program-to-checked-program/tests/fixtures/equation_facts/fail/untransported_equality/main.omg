// Without `m == t` the two equations share no term, so `c` and `w` are
// unrelated.
machine transported(w: u64, r: u64, t: u64, m: u64, c: u64)
requires embed(w) == embed(r) + embed(t), embed(r) + embed(m) == embed(c)
{
    same(c, w);
}

machine same(a: u64, b: u64)
requires a == b
{}

machine main() {}
