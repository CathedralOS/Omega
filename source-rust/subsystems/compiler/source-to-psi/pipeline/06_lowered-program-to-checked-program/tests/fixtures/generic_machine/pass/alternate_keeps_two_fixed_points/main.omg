// A generic mathematical machine may call itself at other machines.
// `alternate::<Step, Other>` applies `Step` and `Other` in turn, by calling
// itself with the two swapped; its law is an induction whose hypothesis is
// the law at the swapped machines, so both must fix `a`.
use {omega}/language/core/process_exit.omg;
use {omega}/language/core/foundation.omg as proof;

data Peano {
    case Zero;
    case Succ(pred: Peano);
}

machine alternate<machine Step, machine Other>(n: Peano, a: Peano) -> Peano
requires machine Step(a: Peano) -> Peano terminates;
requires machine Other(a: Peano) -> Peano terminates;
terminates by n
{
    transition n {
        Peano::Zero -> (a),
        Peano::Succ { pred } -> (Step(alternate::<Other, Step>(pred, a)))
    }
}

machine alternate_keeps<machine Step, machine Other>(n: Peano, a: Peano)
requires machine Step(a: Peano) -> Peano terminates;
requires machine Other(a: Peano) -> Peano terminates;
terminates by n
requires
    |proof|::Identity::<Peano>(Step(a), a),
    |proof|::Identity::<Peano>(Other(a), a)
ensures
    |proof|::Identity::<Peano>(alternate::<Step, Other>(n, a), a)
{
    transition n {
        Peano::Zero -> base(),
        Peano::Succ { pred } -> step(pred, a)
    }
    machine base() {
    }
    machine step(pred: Peano, a: Peano) {
        alternate_keeps::<Other, Step>(pred, a);
    }
}

machine succ(a: Peano) -> Peano
{
    transition { _ -> Peano::Succ { pred: a } }
}

machine id(a: Peano) -> Peano
{
    transition { _ -> (a) }
}

machine alternate_twice(a: Peano)
ensures
    |proof|::Identity::<Peano>(alternate::<succ, id>(Peano::Succ { pred: Peano::Succ { pred: Peano::Zero } }, a), Peano::Succ { pred: a })
{
}

data Main { }
machine exit_with_status(main: @mutable Main) reaches |process_exit|::ProcessExit {
    |process_exit|::ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    block exit_with_status(@mutable entry_storage);
}
