data Item { value: u32; }
machine exchange(owner: @mutable Item, next: Item) -> Item {
    let local: @mutable Item = @mutable owner;
    let old: Item = move $local;
    $local = next;
    old
}
machine consume(first: Item, second: Item) { }
machine main() crashes Trap {
    let mutable owner: Item = Item { value: 3u32 };
    let next: Item = Item { value: 7u32 };
    let old: Item = exchange(@mutable owner, next);
    transition old.value == 3u32 && owner.value == 7u32 {
        true -> consume(old, owner),
        false -> bad()
    }
    machine bad() { crash Trap; }
}
