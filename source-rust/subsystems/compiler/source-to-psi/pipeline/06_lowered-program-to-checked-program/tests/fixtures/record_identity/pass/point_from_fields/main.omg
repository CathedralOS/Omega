// Two records are identical when every corresponding field is: the checker
// rebuilds each `Point` from its two fields.
use {omega}/language/core/foundation.omg as proof;

data Point {
    x: i32;
    y: i32;
}

machine same_point(a: Point, b: Point)
requires
    |proof|::Identity::<i32>(a.x, b.x)
requires
    |proof|::Identity::<i32>(a.y, b.y)
ensures
    |proof|::Identity::<Point>(a, b)
{
}
