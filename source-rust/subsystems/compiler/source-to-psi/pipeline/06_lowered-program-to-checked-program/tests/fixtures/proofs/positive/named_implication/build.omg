use main.omg as program;

machine hosted_entry() crashes Trap {
    transition |program|::entry() == 0u8 {
        true -> done(),
        false -> unexpected()
    }
    machine done() {}
    machine unexpected() crashes Trap { crash Trap; }
}

machine build(builder: @mutable Build) {
    Build::application(builder, "theorem_proof_parameters");
    Build::bind(builder, windows_x86_64::ProgramEntry, hosted_entry);
    Build::bind(builder, windows_arm64::ProgramEntry, hosted_entry);
    Build::bind(builder, linux_x86_64::ProgramEntry, hosted_entry);
    Build::bind(builder, macos_arm64::ProgramEntry, hosted_entry);
    Build::bind(builder, linux_arm64::ProgramEntry, hosted_entry);
}
