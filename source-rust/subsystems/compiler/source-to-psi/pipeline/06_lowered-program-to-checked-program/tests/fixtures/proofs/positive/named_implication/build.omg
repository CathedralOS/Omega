use main.omg as program;

machine build(builder: @mutable Build) {
    Build::application(builder, "theorem_proof_parameters");
    Build::bind(builder, windows_x86_64\ProgramEntry, |program|::entry);
    Build::bind(builder, windows_arm64\ProgramEntry, |program|::entry);
    Build::bind(builder, linux_x86_64\ProgramEntry, |program|::entry);
    Build::bind(builder, macos_arm64\ProgramEntry, |program|::entry);
    Build::bind(builder, linux_arm64\ProgramEntry, |program|::entry);
}
