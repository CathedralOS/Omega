// A quotient of mathematical data by a relation, and the one law every
// quotient gives: related representatives have equal classes. Two numbers
// are related here when both are zero or neither is, so `Succ(Zero)` and
// `Succ(Succ(Zero))` are different numbers with one class. The relation is
// declared an equivalence by a named conformance whose three rows are
// proved, and the quotient declaration selects that conformance. A value
// enters the quotient only by `as`.
use {omega}/language/core/relation.omg;
use {omega}/language/core/process_exit.omg;
use {omega}/language/core/foundation.omg as proof;

data Representative {
    case Zero;
    case Next(previous: Representative);
}

// Zero for zero, one for everything else.
machine sign(a: Representative) -> Representative {
    transition a {
        Representative::Zero -> Representative::Zero,
        Representative::Next { previous } -> Representative::Next { previous: Representative::Zero }
    }
}

proposition same_sign(a: Representative, b: Representative) =
    |proof|::Identity::<Representative>(sign(a), sign(b));

SameSign satisfies |relation|::MereEquivalence<Representative, same_sign> {
    machine reflexive(value: Representative) ensures same_sign(value, value) { }
    machine symmetric(left: Representative, right: Representative) requires same_sign(left, right) ensures same_sign(right, left) { }
    machine transitive(left: Representative, middle: Representative, right: Representative) requires same_sign(left, middle), same_sign(middle, right) ensures same_sign(left, right) { }
    machine proofs_agree(a: Representative, b: Representative) ensures |relation|::IsMere(same_sign(a, b)) { }
}

data Sign = Representative % same_sign
requires same_sign satisfies
    |relation|::MereEquivalence<Representative, same_sign>
    as SameSign;

machine related_representatives_have_one_class(a: Representative, b: Representative)
requires same_sign(a, b)
ensures |proof|::Identity::<Sign>(a as Sign, b as Sign)
{
}

data Main { }
machine exit_with_status(main: @mutable Main) reaches |process_exit|::ProcessExit {
    |process_exit|::ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    block exit_with_status(@mutable entry_storage);
}
