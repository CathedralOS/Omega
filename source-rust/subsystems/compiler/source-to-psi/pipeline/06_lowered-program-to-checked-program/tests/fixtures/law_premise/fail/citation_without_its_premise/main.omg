// The passing program, and a law that cites the cancellation law where its
// premise does not hold.
use omega\language\core\ProcessExit;

data Peano {
    case Zero;
    case Succ(pred: Peano);
}

machine plus(a: Peano, b: Peano) -> Peano
terminates by a
{
    transition a {
        Peano::Zero -> (b),
        Peano::Succ { pred } -> Peano::Succ { pred: plus(pred, b) }
    }
}

// Addition cancels on the left. The premise is a hypothesis of the proof. In
// the successor case it reads `Succ(plus(pred, a)) = Succ(plus(pred, b))`,
// and the law at `pred` requires `plus(pred, a) = plus(pred, b)`: the same
// equality with the constructor taken off both sides.
machine plus_cancel(c: Peano, a: Peano, b: Peano)
terminates by c
requires
    core\Identity::<Peano>(plus(c, a), plus(c, b))
ensures
    core\Identity::<Peano>(a, b)
{
    transition c {
        Peano::Zero -> base(),
        Peano::Succ { pred } -> step(pred, a, b)
    }
    machine base() {
    }
    machine step(pred: Peano, a: Peano, b: Peano) {
        plus_cancel(pred, a, b);
    }
}

// No value is both a successor and zero, so a law that requires it holds
// of whatever it states.
machine never_zero(a: Peano, b: Peano)
requires
    core\Identity::<Peano>(Peano::Succ { pred: a }, Peano::Zero)
ensures
    core\Identity::<Peano>(a, b)
{
}

// Cites the cancellation law with nothing that says `plus(c, a) = plus(c, b)`.
machine cancels_without_its_premise(c: Peano, a: Peano, b: Peano)
ensures
    core\Identity::<Peano>(a, b)
{
    plus_cancel(c, a, b);
}

data Main { }
machine exit_with_status(main: @mutable Main) reaches ProcessExit {
    ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit {
    let mutable entry_storage: Main;
    block exit_with_status(@mutable entry_storage);
}
