data Mode { case Idle; case Busy(level: u64); }
data Engine { mode: Mode; count: u64; }
data Holder<'storage> { engine: @'storage mutable Engine; }
machine start(holder: @mutable Holder) { holder.engine.mode = Mode::Busy { level: 7 }; }
machine entry() crashes Trap {
    let mutable engine: Engine = Engine { mode: Mode::Idle, count: 3 };
    let mutable holder: Holder = Holder { engine: @mutable engine };
    start(@mutable holder);
    transition engine.mode {
        Mode::Busy { level } -> check(level, engine.count),
        Mode::Idle -> bad()
    }
    machine check(level: u64, count: u64) crashes Trap {
        transition level == 7 && count == 3 {
            true -> done(),
            false -> bad()
        }
    }
    machine done() {}
    machine bad() { crash Trap; }
}
