// COMPILE CANARY. N3 rearrange tier 2: Nat has conformed all five semiring
// laws, so the structural judge may distribute multiplication through
// addition and canonically reorder both sums and products. No theorem citation
// appears here; the license comes solely from explicit conformance.
use omega\language\core\Nat;
use omega\language\core\add;
use omega\language\core\mul;

use omega\language\core\ProcessExit;
data Main { }
machine exit_with_status(main: @mutable Main) reaches ProcessExit {
    ProcessExit::exit_process(70);
}

machine four_term_expansion(a: Nat, b: Nat, c: Nat, d: Nat)
ensures
    core\Identity::<Nat>((mul(add(a, b), add(c, d))), (add(add(mul(a, c), mul(a, d)), add(mul(b, c), mul(b, d)))))
{
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches ProcessExit {
    let mutable entry_storage: Main;
    block exit_with_status(@mutable entry_storage);
}
