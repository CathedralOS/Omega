// COMPILE CANARY. N3 rearrange tier 2: Nat has conformed all five semiring
// laws, so the structural judge may distribute multiplication through
// addition and canonically reorder both sums and products. No theorem citation
// appears here; the license comes solely from explicit conformance.
use {omega}/language/core/nat.omg;
use {omega}/language/core/process_exit.omg;
use {omega}/language/core/foundation.omg as proof;

data Main { }
machine exit_with_status(main: @mutable Main) reaches |process_exit|::ProcessExit {
    |process_exit|::ProcessExit::exit_process(70);
}

machine four_term_expansion(a: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat, d: |nat|::Nat)
ensures
    |proof|::Identity::<|nat|::Nat>((|nat|::mul(|nat|::add(a, b), |nat|::add(c, d))), (|nat|::add(|nat|::add(|nat|::mul(a, c), |nat|::mul(a, d)), |nat|::add(|nat|::mul(b, c), |nat|::mul(b, d)))))
{
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    block exit_with_status(@mutable entry_storage);
}
