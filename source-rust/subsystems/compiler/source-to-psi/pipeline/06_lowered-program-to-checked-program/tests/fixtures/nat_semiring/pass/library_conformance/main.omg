// A program that only adds and multiplies the library's `Nat`. Its law says
// two sums of the same three terms are equal, and its body cites nothing:
// `core/nat.omg` declares `Nat` a `CommutativeSemiring`, so the checker reads
// that whole conformance, has the kernel judge its laws, and may then reorder
// and regroup `add` and reorder `mul` under them.
use {omega}/language/core/nat.omg;

machine relies_on_the_semiring(a: |nat|::Nat, b: |nat|::Nat, c: |nat|::Nat)
ensures core\Identity::<|nat|::Nat>(
    |nat|::add(|nat|::mul(a, b), |nat|::add(c, a)),
    |nat|::add(a, |nat|::add(c, |nat|::mul(b, a)))
)
{
}

public machine entry_start() {}
