// A machine that calls itself on a computed value of local data. `drain`
// steps its argument down by one until the step below it is zero. Its
// recursive call is at `before(a)`, which is no field of a case of `a`, so
// the call must descend under natural order: `saturating_sub(Succ(next), a)
// = Zero`. This program declares no truncated subtraction over `Peano`, so
// there is no order to state that descent in, and the compiler refuses
// `drain` rather than define it on fuel without the check. The same kind of
// recursion over core `Nat`, with its descent cited, compiles
// (`computed_descent/pass`).
use {omega}/language/core/foundation.omg as proof;

data Peano {
    case Zero;
    case Succ(pred: Peano);
}

machine before(a: Peano) -> Peano {
    transition a {
        Peano::Zero -> Peano::Zero,
        Peano::Succ { pred } -> (pred)
    }
}

machine drain(a: Peano) -> Peano
terminates by a
ensures
    |proof|::Identity::<Peano>(result, Peano::Zero)
{
    transition (before(a)) {
        Peano::Zero -> Peano::Zero,
        Peano::Succ { pred as rest } -> again(a)
    }

    machine again(a: Peano) -> Peano {
        transition { _ -> (drain(before(a))) }
    }
}

data Main { }

// The entry does nothing: the program is here for its proofs.
machine entry_start() { }
