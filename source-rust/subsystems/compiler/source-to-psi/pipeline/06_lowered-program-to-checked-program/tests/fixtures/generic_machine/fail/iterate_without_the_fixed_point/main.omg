// The twin of `pass/iterate_keeps_a_fixed_point` without the premise that
// `Step` fixes `a`. The successor case is left with `Step(a) = a`, which no
// machine `Step` is known to satisfy, so the law is refused.
use {omega}/language/core/process_exit.omg;
use {omega}/language/core/foundation.omg as proof;

data Peano {
    case Zero;
    case Succ(pred: Peano);
}

machine iterate<machine Step>(n: Peano, a: Peano) -> Peano
requires machine Step(a: Peano) -> Peano terminates;
terminates by n
{
    transition n {
        Peano::Zero -> (a),
        Peano::Succ { pred } -> (Step(iterate::<Step>(pred, a)))
    }
}

machine iterate_keeps_a_fixed_point<machine Step>(n: Peano, a: Peano)
requires machine Step(a: Peano) -> Peano terminates;
terminates by n
ensures
    |proof|::Identity::<Peano>(iterate::<Step>(n, a), a)
{
    transition n {
        Peano::Zero -> base(),
        Peano::Succ { pred } -> step(pred, a)
    }
    machine base() {
    }
    machine step(pred: Peano, a: Peano) {
        iterate_keeps_a_fixed_point::<Step>(pred, a);
    }
}

data Main { }
machine exit_with_status(main: @mutable Main) reaches |process_exit|::ProcessExit {
    |process_exit|::ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    block exit_with_status(@mutable entry_storage);
}
