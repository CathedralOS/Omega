// A clause may pass a concrete machine to a machine generic over machines.
// `twice::<succ>(a)` is the definition of `twice` applied to the definition
// of `succ`, so the law that it adds two is proved by unfolding both.
use {omega}/language/core/process_exit.omg;
use {omega}/language/core/foundation.omg as proof;

data Peano {
    case Zero;
    case Succ(pred: Peano);
}

machine twice<machine Step>(a: Peano) -> Peano
requires machine Step(a: Peano) -> Peano terminates;
{
    let once: Peano = Step(a);
    transition { _ -> (Step(once)) }
}

machine succ(a: Peano) -> Peano
{
    transition { _ -> Peano::Succ { pred: a } }
}

machine twice_succ_adds_two(a: Peano)
ensures
    |proof|::Identity::<Peano>(twice::<succ>(a), Peano::Succ { pred: Peano::Succ { pred: a } })
{
}

data Main { }
machine exit_with_status(main: @mutable Main) reaches |process_exit|::ProcessExit {
    |process_exit|::ProcessExit::exit_process(0);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches |process_exit|::ProcessExit {
    let mutable entry_storage: Main;
    block exit_with_status(@mutable entry_storage);
}
