use main.omg as app;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "product_declaration_batch" };
    Build::select_provider::<|app|::LookupService, |app|::SelectedLookup>(builder, windows_x86_64);
    Build::select_provider::<|app|::LookupService, |app|::SelectedLookup>(builder, linux_x86_64);
    Build::select_provider::<|app|::LookupService, |app|::SelectedLookup>(builder, macos_arm64);
    Build::select_provider::<|app|::LookupService, |app|::SelectedLookup>(builder, linux_arm64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
