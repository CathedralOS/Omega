// Store a finite snapshot in the original group, for each invocation.
public machine stdin(group: TestGroup, bytes: @[u8]) reaches BuildRequestOperations invokes BuildRequestOperations {
    BuildRequestOperations::configure_test_fixture(group, 0u64, "", bytes);
}

public machine expect(group: TestGroup, output: TestOutput, bytes: @[u8]) reaches BuildRequestOperations invokes BuildRequestOperations {
    BuildRequestOperations::configure_test_fixture(group, stream_number(output), "", bytes);

    machine stream_number(output: TestOutput) -> u64 {
        transition output {
            TestOutput::Stdout -> 1u64,
            TestOutput::Stderr -> 2u64
        }
    }
}

// File names are byte paths relative to this invocation's private root.
public machine seed_file(group: TestGroup, path: @[u8], bytes: @[u8]) reaches BuildRequestOperations invokes BuildRequestOperations {
    BuildRequestOperations::configure_test_fixture(group, 3u64, path, bytes);
}

public machine observe_file(group: TestGroup, path: @[u8]) reaches BuildRequestOperations invokes BuildRequestOperations {
    BuildRequestOperations::configure_test_fixture(group, 4u64, path, "");
}

public machine expect_missing(group: TestGroup, path: @[u8]) reaches BuildRequestOperations invokes BuildRequestOperations {
    BuildRequestOperations::configure_test_fixture(group, 5u64, path, "");
}

public machine expect_file(group: TestGroup, path: @[u8], bytes: @[u8]) reaches BuildRequestOperations invokes BuildRequestOperations {
    BuildRequestOperations::configure_test_fixture(group, 6u64, path, bytes);
}
