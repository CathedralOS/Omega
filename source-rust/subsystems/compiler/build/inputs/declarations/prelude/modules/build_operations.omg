public machine dependency(builder: @mutable BuildPlan, description: DependencyDescription) -> DependencyRegistration reaches BuildRequestOperations invokes BuildRequestOperations {
    Build::request_dependency(builder, description.explicit_alias, description.alias, description.source, DependencyOptions {})
}

public machine dependency(builder: @mutable BuildPlan, source: Source) -> DependencyRegistration reaches BuildRequestOperations invokes BuildRequestOperations {
    Build::request_dependency(builder, false, "", source, DependencyOptions {})
}

public machine dependency(builder: @mutable BuildPlan, source: Source, options: DependencyOptions) -> DependencyRegistration reaches BuildRequestOperations invokes BuildRequestOperations {
    Build::request_dependency(builder, false, "", source, options)
}

public machine dependency(builder: @mutable BuildPlan, description: DependencyDescription, options: DependencyOptions) -> DependencyRegistration reaches BuildRequestOperations invokes BuildRequestOperations {
    Build::request_dependency(builder, description.explicit_alias, description.alias, description.source, options)
}

// Checking the selected dependency is scheduled after this Build returns.
public machine validate(builder: @mutable BuildPlan, registered: @DependencyRegistration) reaches BuildRequestOperations invokes BuildRequestOperations {
    BuildRequestOperations::validate_dependency(builder, $registered);
}

// The readiness boundary for one exact registration: the Build parks here
// until the evaluator has acquired that dependency, run its Build and
// prepared it, then resumes. Earlier statements never run again.
public machine prepare_dependency(builder: @mutable BuildPlan, registered: DependencyRegistration) reaches BuildRequestOperations invokes BuildRequestOperations suspends {
    suspend BuildRequestOperations::prepare_dependency(builder, registered);
}

machine request_dependency(builder: @BuildPlan, explicit_alias: bool, alias: @[u8], source: Source, max_reach: DependencyOptions) -> DependencyRegistration reaches BuildRequestOperations {
    transition source {
        Source::Path { location } -> Build::request_path(builder, explicit_alias, alias, location, max_reach),
        Source::Git { repository, revision, selection } -> Build::request_git(builder, explicit_alias, alias, repository, revision, selection, max_reach),
    }
}

machine request_path(builder: @BuildPlan, explicit_alias: bool, alias: @[u8], location: @[u8], max_reach: DependencyOptions) -> DependencyRegistration reaches BuildRequestOperations {
    BuildRequestOperations::register_path_dependency(builder, explicit_alias, alias, location, max_reach)
}

machine request_git(builder: @BuildPlan, explicit_alias: bool, alias: @[u8], repository: @[u8], revision: @[u8], selection: PackageSelection, max_reach: DependencyOptions) -> DependencyRegistration reaches BuildRequestOperations {
    transition selection {
        PackageSelection::Root -> Build::request_selected_git(builder, explicit_alias, alias, repository, revision, false, "", max_reach),
        PackageSelection::Named { package } -> Build::request_selected_git(builder, explicit_alias, alias, repository, revision, true, package, max_reach),
    }
}

machine request_selected_git(builder: @BuildPlan, explicit_alias: bool, alias: @[u8], repository: @[u8], revision: @[u8], named_package: bool, package: @[u8], max_reach: DependencyOptions) -> DependencyRegistration reaches BuildRequestOperations {
    BuildRequestOperations::register_git_dependency(builder, explicit_alias, alias, repository, revision, named_package, package, max_reach)
}

// Publish a snapshot of these bytes under a package-relative source filename.
public machine include_source(builder: @mutable BuildPlan, name: @[u8], source: @[u8]) reaches BuildRequestOperations invokes BuildRequestOperations {
    BuildRequestOperations::publish_source(builder, name, source);
}

// The executed request is joined with the application role and required outputs.
public machine artifact_only(builder: @mutable BuildPlan) reaches BuildRequestOperations invokes BuildRequestOperations {
    BuildRequestOperations::artifact_only(builder);
}

// Behavior exclusion (wiki/spec/build/behavior_exclusions.md): a
// product-admission requirement that the selected executable composition
// contains no reachable site of the named crash cause. The selection is
// recorded when this call executes against the original Build value;
// typing normalizes the declaration to the authenticated selection protocol. A
// declaration that permits Trap cannot override it.
public machine exclude_crash(builder: @mutable BuildPlan, cause: CrashCause) {
}

// Native realization checks this executed selection using the shared
// physical mechanism classifier, independently of receiver permissions.
public machine exclude_physical_authority(builder: @mutable BuildPlan, authority: PhysicalAuthorityClass) {
}
