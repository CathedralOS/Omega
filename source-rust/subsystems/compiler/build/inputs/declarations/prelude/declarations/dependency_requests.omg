public data PackageSelection<'storage> {
    case Root;
    case Named(package: @'storage [u8]);
}
public data Source<'storage> {
    case Path(location: @'storage [u8]);
    case Git(repository: @'storage [u8], revision: @'storage [u8], selection: PackageSelection<'storage>);
}
// Executed project requests cross one compiler-issued host protocol. Source
// variants are decomposed by ordinary Omega code, not a host syntax visitor.
public boundary trait BuildRequestOperations {
    machine copy_bytes<'storage>(builder: @BuildPlan<'storage>, bytes: @[u8]) -> @'storage [u8] reaches none crashes none;
    machine extend_workspace(builder: @BuildPlan, prefix: WorkspaceMembers, path: @[u8]) -> WorkspaceMembers reaches none crashes none;
    machine artifact_only(builder: @BuildPlan) reaches none crashes none;
    machine register_path_dependency(builder: @BuildPlan, explicit_alias: bool, alias: @[u8], location: @[u8], max_reach: DependencyOptions) -> DependencyRegistration reaches none crashes none;
    machine register_git_dependency(builder: @BuildPlan, explicit_alias: bool, alias: @[u8], repository: @[u8], revision: @[u8], named_package: bool, package: @[u8], max_reach: DependencyOptions) -> DependencyRegistration reaches none crashes none;
    machine input_binding(builder: @BuildPlan, alias: @[u8]) -> PackageBinding reaches none crashes none;
    machine forward_program<Program>() -> DependencyOptions reaches none crashes none;
    machine extend_reach(builder: @BuildPlan, prior: DependencyOptions, service: BoundaryServiceReference) -> DependencyOptions reaches none crashes none;
    machine add_binding(builder: @BuildPlan, binding: PackageBinding, max_reach: DependencyOptions) -> DependencyRegistration reaches none crashes none;
    machine validate_binding(builder: @BuildPlan, binding: PackageBinding) reaches none crashes none;
    machine validate_dependency(builder: @BuildPlan, registered: DependencyRegistration) reaches none crashes none;
    machine prepare_dependency(builder: @BuildPlan, registered: DependencyRegistration) reaches none crashes none suspends;
    machine configure_test_engine(group: @mutable TestGroupSettings, target: u64, engine: u64, policy: u64) reaches none crashes none;
    machine configure_test_fixture(group: @mutable TestGroupSettings, setting: u64, path: @[u8], bytes: @[u8]) reaches none crashes none;
    machine write_log(log: @BuildLog, text: @[u8]) reaches none crashes none;
}
// Configured dependency description
// (wiki/spec/build/scoped_execution.md#dependency-declarations-and-binding).
// Ordinary helpers prepare it before registration. `Build::dependency` fixes
// the source and alias for the immediate product.
// Constructing one grants no host or package authority.
public data DependencyDescription<'storage> {
    source: Source<'storage>;
    explicit_alias: bool;
    alias: @'storage [u8];
}
// The exact registration one executed request fixed
// (wiki/spec/build/scoped_execution.md#dependency-declarations-and-binding).
// Only the evaluator issues one: the registration request returns a marker
// whose row lives in the activation's request table, so an authored
// `DependencyRegistration {}` has the same static shape and names no
// registration. Retaining or copying the marker grants nothing; it names the
// registered edge for later Build operations.
public data DependencyRegistration [copy] {
}

// An issued binding names one immutable input of this Build activation.
public data PackageBinding [copy] {}
// The host recognizes only service references issued by this Build activation.
public data BoundaryServiceReference [copy] {}
public data DependencyOptions [copy] {}
