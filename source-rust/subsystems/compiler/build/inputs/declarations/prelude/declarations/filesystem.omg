// Ordinary boundary calls carry evaluated operands. Installation requires exact
// toolchain provenance and the activation's original facets or issued markers.
public boundary trait BuildFilesystemOperations {
    machine resolve_source(source: @BuildSource, relative: @[u8]) -> BuildPath reaches none crashes none;
    machine resolve_output(output: @BuildOutput, relative: @[u8]) -> BuildPath reaches none crashes none;
    machine map_directory(prefix: BuildDirectories, directory: BuildPath, guest: @[u8], writable: bool) -> BuildDirectories reaches none crashes none;
    machine forward_directory(prefix: BuildDirectories, from: @[u8], guest: @[u8], writable: bool) -> BuildDirectories reaches none crashes none;
    machine open(source: @BuildSource, path: BuildPath, flags: i32) -> i32 reaches none crashes none;
    machine read(source: @BuildSource, descriptor: i32, buffer: @mutable [u8], count: u64) -> i64 reaches none crashes none;
    machine close_source(source: @BuildSource, descriptor: i32) -> i32 reaches none crashes none;
    machine create(output: @mutable BuildOutput, path: BuildPath, mode: i32) -> i32 reaches none crashes none;
    machine write(output: @mutable BuildOutput, descriptor: i32, bytes: @[u8]) -> i64 reaches none crashes none;
    machine close_output(output: @mutable BuildOutput, descriptor: i32) -> i32 reaches none crashes none;
    machine require(output: @mutable BuildOutput, name: @[u8]) -> RequiredOutput reaches none crashes none;
    machine can_complete(output: @BuildOutput, obligation: @RequiredOutput, file: BuildPath) -> bool reaches none crashes none;
    machine complete(output: @mutable BuildOutput, obligation: RequiredOutput, file: BuildPath) -> OutputReceipt reaches none crashes none;
    machine fail(output: @mutable BuildOutput, obligation: RequiredOutput, diagnostic: @[u8]) reaches none crashes none;
    machine required_path(output: @RequiredOutput) -> @[u8] reaches none crashes none;
}
