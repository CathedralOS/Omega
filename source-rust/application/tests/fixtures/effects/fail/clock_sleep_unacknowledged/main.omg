use {omega}/language/core/process_exit.omg;
use {system}/clock.omg;

// `Clock::sleep` holds the caller's worker for the whole wait, so system declares
// it `blocks`. This call omits the `block` marker and the checker refuses it.
// Its twin under `pass/effects/clock_sleep_acknowledged` writes the marker.
machine entry_start() reaches |process_exit|::ProcessExit + |clock|::Clock {
    |clock|::Clock::sleep(200);
    |process_exit|::ProcessExit::exit_process(70);
}
