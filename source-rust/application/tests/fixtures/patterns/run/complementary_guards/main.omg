public machine pick(a: u32, b: u32) -> u32 {
    match { a == b -> 3, a != b -> 7 }
}
public machine choose(a: u32, b: u32) -> u32 {
    transition { a != b -> different(), a == b -> same() }
    machine same() -> u32 { 3 }
    machine different() -> u32 { 7 }
}
machine read_then_clear(flag: @mutable bool) -> bool {
    let prior: bool = $flag;
    $flag = false;
    prior
}
public machine captured(input: bool) -> u32 {
    let mutable flag: bool = input;
    let seen: bool = read_then_clear(@mutable flag);
    match { seen == false -> 3, seen != false -> 7 }
}
machine main() crashes Trap {
    transition pick(1, 1) == 3 && choose(1, 1) == 3
        && pick(0, 2) == 7 && choose(0, 2) == 7
        && captured(true) == 7 && captured(false) == 3 {
        true -> done(), _ -> wrong(),
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
