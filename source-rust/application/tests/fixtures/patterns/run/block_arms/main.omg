data Counter { value: u32; }
data Shape {
    case Square(side: u32);
    case Empty;
}
machine read(counter: @Counter) -> u32 { counter.value }
machine double(value: u32) -> u32 { value * 2 }
machine port_of(code: u32) -> u32 {
    match code { 0 -> { let port: u32 = 1; port }, _ -> 2, }
}
machine choose(code: u32) -> u32 {
    transition code { 0 -> { let port: u32 = 1; done(port) }, _ -> other() }
    machine done(port: u32) -> u32 { port + 10 }
    machine other() -> u32 { 20 }
}
machine in_let(code: u32) -> u32 {
    let port: u32 = match code { 0 -> { let inner: u32 = 1; inner + 1 }, _ -> 3 };
    port
}
machine as_argument(code: u32) -> u32 {
    double(match code { 0 -> { let base: u32 = 4; base + 1 }, _ -> 0 })
}
machine nested(a: u32, b: u32) -> u32 {
    match a {
        0 -> {
            let inner: u32 = match b { 0 -> { let deep: u32 = 7; deep }, _ -> 8 };
            inner + 1
        },
        _ -> 0,
    }
}
machine borrow_then_write(code: u32) -> u32 {
    let mutable counter: Counter = Counter { value: 5 };
    let seen: u32 = match code { 0 -> { let view: @Counter = @counter; read(view) }, _ -> 0 };
    counter.value = 9;
    seen
}
machine half_side(shape: Shape) -> u32 {
    match shape { Shape::Square { side } -> { let half: u32 = side / 2; half }, Shape::Empty -> 0 }
}
machine made(code: u32) -> Counter {
    match code { 0 -> { let made: Counter = Counter { value: 6 }; made }, _ -> Counter { value: 7 } }
}
machine reused(code: u32) -> u32 {
    match code { 0 -> { let tmp: u32 = 1; tmp }, _ -> { let tmp: u32 = 2; tmp } }
}
machine main() crashes Trap {
    let first: Counter = made(0);
    let second: Counter = made(1);
    transition port_of(0) == 1 && port_of(5) == 2 && choose(0) == 11 && choose(4) == 20
        && in_let(0) == 2 && in_let(1) == 3 && as_argument(0) == 10 && as_argument(1) == 0
        && nested(0, 0) == 8 && nested(0, 1) == 9 && nested(1, 0) == 0
        && borrow_then_write(0) == 5 && borrow_then_write(1) == 0
        && half_side(Shape::Square { side: 4 }) == 2 && half_side(Shape::Empty) == 0
        && first.value == 6 && second.value == 7 && reused(0) == 1 && reused(1) == 2 {
        true -> done(),
        false -> failed(),
    }
    machine done() {}
    machine failed() { crash Trap; }
}
