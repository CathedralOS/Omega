data Outcome { seen: u32; other: u32; total: u32; }

machine result(code: u32, mutable total: u32) -> Outcome {
    let mutable other: u32 = 2;
    let seen: u32 = match code {
        0 -> { total = 8; other = total + 2; other },
        _ -> { other = 5; total },
    };
    Outcome { seen: seen, other: other, total: total }
}

machine dispatch(code: u32) -> u32 {
    let mutable port: u32 = 3;
    transition code { 0 -> { port = 9; done(port) }, _ -> done(port) }
    machine done(chosen: u32) -> u32 { chosen }
}

machine main() crashes Trap {
    let written: Outcome = result(0, 3);
    let skipped: Outcome = result(1, 3);
    transition written.seen == 10 && written.other == 10 && written.total == 8
        && skipped.seen == 3 && skipped.other == 5 && skipped.total == 3
        && dispatch(0) == 9 && dispatch(1) == 3 {
        true -> success(),
        false -> failed(),
    }
    machine success() {}
    machine failed() { crash Trap; }
}
