data Operation [copy] {
    case GetUser(user_id: u64);
    case CountUsers;
}
data Command {
    command_id: u64;
    op: Operation;
}
machine user_of(command: @Command) -> u64 {
    let (operation,) = command;
    match operation {
        Operation::GetUser { user_id } -> user_id,
        Operation::CountUsers -> 0u64,
    }
}
machine main() crashes Trap {
    let asks: Command = Command { command_id: 17, op: Operation::GetUser { user_id: 42 } };
    let counts: Command = Command { command_id: 42, op: Operation::CountUsers };
    transition user_of(@asks) == 42 && user_of(@counts) == 0 { true -> done(), false -> failed() }
    machine done() {}
    machine failed() { crash Trap; }
}
