machine build(builder: @mutable Build) {
    Build::application(builder, "registered_files");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind_native::<FileCalls::open>(builder, linux_x86_64, ForeignBinding::Syscall { number: 257 });
    Build::bind_native::<FileCalls::write>(builder, linux_x86_64, ForeignBinding::Syscall { number: 1 });
    Build::bind_native::<FileCalls::read>(builder, linux_x86_64, ForeignBinding::Syscall { number: 0 });
    Build::bind_native::<FileCalls::close>(builder, linux_x86_64, ForeignBinding::Syscall { number: 3 });
    Build::bind_native::<FileCalls::open>(builder, linux_arm64, ForeignBinding::Syscall { number: 56 });
    Build::bind_native::<FileCalls::write>(builder, linux_arm64, ForeignBinding::Syscall { number: 64 });
    Build::bind_native::<FileCalls::read>(builder, linux_arm64, ForeignBinding::Syscall { number: 63 });
    Build::bind_native::<FileCalls::close>(builder, linux_arm64, ForeignBinding::Syscall { number: 57 });
    let group: TestGroup = builder.tests.group::<Checks::file>();
    group.inputs.private_filesystem = true;
    let mutable seed: [u8; 1] = [254u8];
    TestGroup::seed_file(group, "sub/seed", @seed[..]);
    seed[0] = 0u8;
    TestGroup::seed_file(group, "empty", "");
    TestGroup::expect_file(group, "empty", "");
    TestGroup::expect_missing(group, "missing");
    TestGroup::expect_file(group, "note.txt", "Z");
    TestGroup::observe_file(group, "sub/seed");
}
