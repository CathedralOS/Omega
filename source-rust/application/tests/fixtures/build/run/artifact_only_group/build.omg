machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "build_artifact_only" };
    Build::artifact_only(builder);
    _ = builder.tests.group::<Tests::arithmetic>();
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "blob.bin");
    let path: BuildPath = BuildOutput::resolve(@builder.output, "blob.bin");
    let writer: i32 = BuildOutput::create(@mutable builder.output, path, 0);
    _ = BuildOutput::write(@mutable builder.output, writer, "blobdata\n");
    let _sealed: i32 = BuildOutput::close(@mutable builder.output, writer);
    let settled: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, path);
    settle(builder, settled);
}

machine settle(builder: @mutable BuildPlan, completion: OutputCompletion) {
    transition completion {
        OutputCompletion::Sealed { receipt } -> sealed(builder),
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine sealed(builder: @mutable BuildPlan) {
    }
    machine failed(builder: @mutable BuildPlan, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "require did not settle");
    }
}
