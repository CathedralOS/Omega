use main.omg as app;

machine build(builder: @mutable Build) {
    Build::application(builder, "registered_streams");
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind_native::<|app|::Streams::read>(builder, linux_x86_64, ForeignBinding::Syscall { number: 0 });
    Build::bind_native::<|app|::Streams::write>(builder, linux_x86_64, ForeignBinding::Syscall { number: 1 });
    Build::bind_native::<|app|::Streams::read>(builder, linux_arm64, ForeignBinding::Syscall { number: 63 });
    Build::bind_native::<|app|::Streams::write>(builder, linux_arm64, ForeignBinding::Syscall { number: 64 });

    _ = builder.tests.group::<|app|::Checks::empty_input>();
    let echo: TestGroup = builder.tests.group::<|app|::Checks::echo>();
    let mutable bytes: [u8; 2] = [57, 57];
    TestGroup::stdin(echo, @bytes[..]);
    bytes[0] = 52;
    TestGroup::expect(echo, TestOutput::Stdout, "99");
    TestGroup::expect(echo, TestOutput::Stderr, "!");
}
