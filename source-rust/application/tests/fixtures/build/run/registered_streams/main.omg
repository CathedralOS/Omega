use {omega}/language/core/process_authority.omg;

boundary trait Streams {
    machine read(fd: i32, byte: @mutable u8, count: u64) -> i64 reaches |process_authority|::StandardInput crashes none;
    machine write(fd: i32, byte: @u8, count: u64) -> i64 reaches |process_authority|::StandardOutput crashes none;
}

trait Checks {
    machine empty_input() reaches |process_authority|::StandardInput crashes Trap;
    machine echo() reaches |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap;
}

machine default_input_is_empty() satisfies Checks::empty_input {
    let mutable byte: u8 = 17;
    let read: i64 = Streams::read(0, @mutable byte, 1);
    transition read == 0 && byte == 17u8 {
        true -> passed(),
        _ -> failed()
    }
    machine passed() {}
    machine failed() crashes Trap { crash Trap; }
}

machine first_echo() satisfies Checks::echo { echo(); }
machine second_echo() satisfies Checks::echo { echo(); }

machine echo() reaches |process_authority|::StandardInput + |process_authority|::StandardOutput crashes Trap {
    let mutable byte: u8 = 0;
    let first: i64 = Streams::read(0, @mutable byte, 1);
    let written_first: i64 = Streams::write(1, @byte, 1);
    let second: i64 = Streams::read(0, @mutable byte, 1);
    let written_second: i64 = Streams::write(1, @byte, 1);
    let eof: i64 = Streams::read(0, @mutable byte, 1);
    let punctuation: u8 = 33;
    let written_stderr: i64 = Streams::write(2, @punctuation, 1);
    transition first == 1 && written_first == 1 && second == 1 && written_second == 1 && eof == 0 && written_stderr == 1 {
        true -> passed(),
        _ -> failed()
    }
    machine passed() {}
    machine failed() crashes Trap { crash Trap; }
}

machine main() {}
