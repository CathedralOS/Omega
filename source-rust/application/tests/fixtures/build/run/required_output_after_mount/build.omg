use {omega}/build/dependency.omg;

machine helper_value() -> i32 { 7 }
machine build(builder: @mutable Build) suspends {
    Build::application(builder, "promised");
    let mutable request: DependencyDescription = |dependency|::from_source(Source::Path { location: "dep" });
    |dependency|::with_alias(@mutable request, "kit");
    let registration: DependencyRegistration = Build::dependency(builder, request);
    let obligation: RequiredOutput = BuildOutput::require(@mutable builder.output, "answer.dat");
    let held: @[u8] = RequiredOutput::path(@obligation);
    let file: BuildPath = BuildOutput::resolve(@builder.output, "answer.dat");
    let writer: i32 = BuildOutput::create(@mutable builder.output, file, 0);
    _ = BuildOutput::write(@mutable builder.output, writer, "forty-two");
    _ = BuildOutput::close(@mutable builder.output, writer);
    suspend Build::prepare_dependency(builder, registration);
    let seven: i32 = helper_value();
    let checked: BuildPath = BuildOutput::resolve(@builder.output, held);
    let passed: bool = seven == 7 && held.length == 10u64;
    let settled: OutputCompletion = BuildOutput::complete(@mutable builder.output, obligation, checked);
    settle(builder, settled);
    transition passed {
        true -> good(builder), _ -> wrong(builder)
    }
    machine good(builder: @mutable Build) { Build::bind(builder, linux_x86_64\ProgramEntry, main); }
    machine wrong(builder: @mutable Build) { Build::application(builder, "second_role"); }
}
machine settle(builder: @mutable Build, settled: OutputCompletion) {
    transition settled {
        OutputCompletion::Sealed { receipt } -> done(),
        OutputCompletion::Retry { obligation, file } -> failed(builder, obligation)
    }
    machine done() {}
    machine failed(builder: @mutable Build, obligation: RequiredOutput) {
        BuildOutput::fail(@mutable builder.output, obligation, "output was not sealed");
    }
}
