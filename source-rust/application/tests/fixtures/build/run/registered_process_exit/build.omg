use {omega}/build/dependency.omg;
use {omega}/language/core/process_exit.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "registered_process_exit");
    let allowed: [BoundaryServiceReference; 1] = [Build::service::<|process_exit|::ProcessExit>(builder)];
    let adapter: DependencyDescription = |dependency|::from_source(Source::Path { location: "exit_adapter" });
    _ = |dependency|::add(builder, adapter, @allowed[..]);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, macos_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::bind(builder, windows_arm64::ProgramEntry, main);
    _ = builder.tests.group::<Tests::exits>();
}
