use {omega}/build/dependency.omg;

machine helper_value() -> i32 { 7 }

data Gauge { amount: i32; neighbor: i32; }

machine initial(builder: @mutable Build) -> Gauge {
    Build::application(builder, "field_borrow");
    Gauge { amount: 3, neighbor: 19 }
}

machine build(builder: @mutable Build) suspends {
    builder.tests.disabled = true;
    let mutable request: DependencyDescription = |dependency|::from_source(Source::Path { location: "dep" });
    |dependency|::with_alias(@mutable request, "kit");
    let registration: DependencyRegistration = Build::dependency(builder, request);
    let mutable gauge: Gauge = initial(builder);
    let held: @mutable i32 = @mutable gauge.amount;
    suspend Build::prepare_dependency(builder, registration);
    let seven: i32 = helper_value();
    $held = seven;
    let observed: i32 = $held;
    transition observed == 7 && gauge.amount == 7 && gauge.neighbor == 19 {
        true -> done(builder),
        _ -> wrong(builder)
    }
    machine done(builder: @mutable Build) { Build::bind(builder, linux_x86_64::ProgramEntry, main); }
    machine wrong(builder: @mutable Build) { Build::application(builder, "duplicate_role"); }
}
