// Size and alignment queries observe the C layout the selected policy laid out
// for the target: one u8, one address at offset 8 and one u16 at offset 16 make a
// 24-byte, 8-aligned record on every hosted target.
// Expected exit: 0
use {omega}/language/core/c_layout.omg;
data Record [copy] { first: u8; location: address; last: u16; }
public machine main() crashes Trap {
    let bytes: u64 = size_of::<|c_layout|::CLayout<Record>>();
    transition bytes == 24u64 && align_of::<|c_layout|::CLayout<Record>>() == 8u64 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
