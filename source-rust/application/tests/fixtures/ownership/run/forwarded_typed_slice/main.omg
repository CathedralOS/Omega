data Room [copy] { value: u32; }
data Level { rooms: [Room; 2]; }

machine select(level: @mutable Level) -> @mutable Room {
    let rooms: @mutable [Room] = @mutable level.rooms[..];
    transition { _ -> seek(rooms) }
    machine seek(rooms: @mutable [Room]) -> @mutable Room
    requires rooms.length == 2u64 {
        @mutable rooms[1u64]
    }
}

machine count(rooms: [Room]) -> u64 { rooms.length }
machine view_count(rooms: @[Room]) -> u64 { rooms.length }

machine main() crashes Trap {
    let mutable level: Level;
    level.rooms[0u64].value = 7u32;
    let selected: @mutable Room = select(@mutable level);
    selected.value = 42u32;
    let owned: [Room] = [Room { value: 11u32 }];
    let length: u64 = count(owned);
    let window: @[Room] = @level.rooms[..];
    let viewed: u64 = view_count(window);
    transition length == 1u64 && viewed == 2u64 && level.rooms[0u64].value == 7u32 && level.rooms[1u64].value == 42u32 {
        true -> done(), false -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
