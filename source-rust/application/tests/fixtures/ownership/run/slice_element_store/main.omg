use {omega}/language/core/byte_observation/byte_observation.omg;
public domain [u8; 8]::Ascii requires |byte_observation|::ascii_only(@self[..]);
data Command [copy] { storage: [u8; 8] in Ascii; used: u64; }
data Exit [copy] { command: Command; destination: u32; }
data Room [copy] { exits: [Exit; 2]; }
machine apply_room(room: Room, out_room: @mutable Room) {
    let out_exits: @mutable [Exit] = @mutable out_room.exits[..];
    let room_exits: @[Exit] = @room.exits[..];
    out_exits[0] = room_exits[0];
    out_exits[1] = room_exits[1];
}
machine main() crashes Trap {
    let mutable source: Room;
    source.exits[1].destination = 7u32;
    let mutable target: Room;
    apply_room(source, @mutable target);
    transition target.exits[0].destination == 0u32 && target.exits[1].destination == 7u32 {
        true -> end(), false -> trapped()
    }
    machine end() {}
    machine trapped() crashes Trap { crash Trap; }
}
