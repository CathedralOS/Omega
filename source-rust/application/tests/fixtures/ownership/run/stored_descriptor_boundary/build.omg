use main.omg as app;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "stored_descriptor_boundary" };
    Build::select_provider::<|app|::Probe, |app|::CheckedProbe>(builder, macos_arm64);
    Build::select_provider::<|app|::Probe, |app|::CheckedProbe>(builder, linux_arm64);
    Build::select_provider::<|app|::Probe, |app|::CheckedProbe>(builder, linux_x86_64);
    Build::select_provider::<|app|::Probe, |app|::CheckedProbe>(builder, windows_x86_64);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
}
