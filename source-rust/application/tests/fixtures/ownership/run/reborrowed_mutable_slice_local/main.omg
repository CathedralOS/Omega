data Both { short: [u32; 3]; long: [u32; 5]; }

machine store<'a>(left: @'a mutable [u32], right: @'a mutable [u32], value: u32) -> u64
requires left.length > 1 requires left.length < 1000 requires right.length < 1000 {
    let chosen: @'a mutable [u32] = left;
    chosen[1u64] = value;
    chosen.length + right.length
}

machine pick<'a>(flag: bool, left: @'a mutable [u32], right: @'a mutable [u32]) -> u64 {
    let chosen: @'a mutable [u32] = match flag { true -> left, false -> right, };
    chosen.length
}

machine main() crashes Trap {
    let mutable both: Both = Both {
        short: [1u32, 2u32, 3u32],
        long: [1u32, 2u32, 3u32, 4u32, 5u32],
    };
    let total = store(@mutable both.short[..], @mutable both.long[..], 40u32);
    let short = pick(true, @mutable both.short[..], @mutable both.long[..]);
    let long = pick(false, @mutable both.short[..], @mutable both.long[..]);
    transition total == 8u64 && short == 3u64 && long == 5u64
        && both.short[0u64] == 1u32 && both.short[1u64] == 40u32
        && both.short[2u64] == 3u32 && both.long[1u64] == 2u32 {
        true -> done(), false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
