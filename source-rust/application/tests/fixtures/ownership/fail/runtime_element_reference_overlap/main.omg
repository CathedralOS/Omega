// The returned element reference keeps the array it was selected from
// borrowed: another element of that array cannot change while it is live.
data Cell { x: i64; y: i64; }
data Grid { cells: [Cell; 4]; tag: i64; }
machine pick<'a>(grid: @'a mutable Grid, index: u64) -> @'a mutable i64 requires index < 4 {
    @mutable grid.cells[index].x
}
machine main() crashes Trap {
    let mutable grid: Grid = Grid {
        cells: [Cell { x: 1, y: 2 }, Cell { x: 3, y: 4 }, Cell { x: 5, y: 6 }, Cell { x: 7, y: 8 }],
        tag: 0,
    };
    let index: u64 = 1;
    let chosen: @mutable i64 = pick(@mutable grid, index);
    grid.cells[0].x = 9;
    $chosen = 10;
    transition grid.cells[1].x == 10 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
