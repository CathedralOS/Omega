// With the default Psi budget the program returns; a one-unit budget stops before the return.
// Expected exit: 0
machine main() crashes Trap {
    let total: u64 = 3u64 + 4u64;
    transition total == 7u64 {
        true -> done(),
        _ -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
