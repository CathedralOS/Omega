// Expected exit: 0
machine forward<const Count: u64>(pick: bool) -> u64
requires Count > 0u64
{
    first(pick)
    machine first(pick: bool) -> u64 {
        transition pick { true -> second(), false -> 0u64 }
    }
    machine second() -> u64 { Count }
}
machine main() crashes Trap {
    let result: u64 = forward::<3u64>(true);
    let fallback: u64 = forward::<3u64>(false);
    transition result == 3u64 && fallback == 0u64 {
        true -> done(),
        false -> wrong()
    }
    machine done() {}
    machine wrong() crashes Trap { crash Trap; }
}
