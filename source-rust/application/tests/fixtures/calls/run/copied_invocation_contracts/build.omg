use main.omg as app;

machine build(builder: @mutable Build) {
    Build::application(builder, "copied_invocation_contracts");
    Build::select_provider::<|app|::Registrar, |app|::Runner>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Registrar, |app|::Runner>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Registrar, |app|::Runner>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Registrar, |app|::Runner>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
