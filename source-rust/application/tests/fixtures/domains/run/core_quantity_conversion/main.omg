use {omega}/language/core/units.omg;

machine main() crashes Trap {
    let start: i64 in |units|::Quantity<|units|::Units::KILOMETER> = |units|::kilometers_i64(2);
    let distance: i64 in |units|::Quantity<|units|::Units::METER> = |units|::kilometers_to_meters_trapping_i64(start);
    let measured: i64 = distance as - |units|::Quantity<|units|::Units::METER>;
    transition measured == 2000 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "core_quantity_conversion" };
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
