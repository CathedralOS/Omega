use omega\language\core\Units;
use omega\language\core\Quantity;
use omega\language\core\kilometers_i64;
use omega\language\core\kilometers_to_meters_trapping_i64;

machine main() crashes Trap {
    let start: i64 in Quantity<Units::KILOMETER> = kilometers_i64(2);
    let distance: i64 in Quantity<Units::METER> = kilometers_to_meters_trapping_i64(start);
    let measured: i64 = distance as -Quantity<Units::METER>;
    transition measured == 2000 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}

machine build(builder: @mutable Build) {
    Build::application(builder, "core_quantity_conversion");
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
}
