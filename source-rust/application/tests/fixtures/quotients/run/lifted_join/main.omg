// A class of `Representative` is stored as its representative. `observe`
// picks one of two classes at a join and `lifted` reads it only through
// `Quotient::lift` with the constant `3i32`, which meets `representative`'s
// `requires amount == 3i32`. The program crashes unless the lift returns 3.

use {omega}/language/core/relation.omg;
use {omega}/language/core/foundation.omg as proof;

data Representative [copy] { value: i32; }

proposition equivalent(a: Representative, b: Representative) = |proof|::Identity::<Representative>(a, b);

machine equivalent_reflexive(a: Representative)
ensures |proof|::Identity::<Representative>(a, a)
{
}

machine equivalent_symmetric(a: Representative, b: Representative)
requires
    |proof|::Identity::<Representative>(a, b)
ensures |proof|::Identity::<Representative>(b, a)
{
}

machine equivalent_transitive(
    a: Representative,
    b: Representative,
    c: Representative
)
requires
    |proof|::Identity::<Representative>(a, b),
    |proof|::Identity::<Representative>(b, c)
ensures |proof|::Identity::<Representative>(a, c)
{
}

RepresentativeEquivalence satisfies |relation|::Equivalence<Representative, equivalent> {
    machine reflexive(value: Representative) ensures equivalent(value, value) { equivalent_reflexive(value) }
    machine symmetric(left: Representative, right: Representative) requires equivalent(left, right) ensures equivalent(right, left) { equivalent_symmetric(left, right) }
    machine transitive(left: Representative, middle: Representative, right: Representative) requires equivalent(left, middle), equivalent(middle, right) ensures equivalent(left, right) { equivalent_transitive(left, middle, right) }
}

data EquivalenceClass [copy] = Representative % equivalent
requires equivalent satisfies
    |relation|::Equivalence<Representative, equivalent>
    as RepresentativeEquivalence;

machine representative(value: Representative, amount: i32) -> i32
requires amount == 3i32
{ amount }

machine representative_respects(left: Representative, right: Representative, amount: i32)
requires
    equivalent(left, right),
    amount == 3i32,
    amount == 3i32
ensures representative(left, amount) == representative(right, amount)
{}

machine lifted(value: EquivalenceClass) -> i32 {
    Quotient::lift::<representative, representative_respects>(value, 3i32)
}

machine observe(left: EquivalenceClass, right: EquivalenceClass, flag: bool) -> i32 {
    let chosen: EquivalenceClass = match flag { true -> left, false -> right };
    lifted(chosen)
}

machine main() crashes Trap {
    let left: EquivalenceClass = Representative { value: 11 } as EquivalenceClass;
    let right: EquivalenceClass = Representative { value: 17 } as EquivalenceClass;
    transition observe(left, right, true) == 3 { true -> done(), _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}