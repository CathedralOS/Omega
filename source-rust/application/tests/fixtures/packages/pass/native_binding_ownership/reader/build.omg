use {omega}/language/core/external_binding.omg as native;
use main.omg as app;
use {omega}/build/dependency.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "reader" };
    _ = Build::dependency(builder,
        |dependency|::from_source(Source::Path { location: "../reading" }));
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::bind_native::<|app|::ReadParent::read>(builder, linux_x86_64,
        |native|::ForeignBinding::DllImport { import: |native|::DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "getppid", version: "GLIBC_2.2.5"
        } });
}
