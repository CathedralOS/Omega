machine build(builder: @mutable Build) {
    Build::application(builder, "reader");
    let registration: DependencyRegistration = Build::dependency(builder,
        dependency\from_source(Source::Path { location: "../reading" }));
    Build::bind(builder, linux_x86_64\ProgramEntry, main);
    Build::bind_native::<ReadParent::read>(builder, linux_x86_64,
        ForeignBinding::DllImport { import: DllImport::ElfVersioned {
            object: "libc.so.6", symbol: "getppid", version: "GLIBC_2.2.5"
        } });
}
