// Library package whose Build declares target defaults for `Measure`. The
// Windows default lays its storage out with overlapping fields, so preparing
// that layout refuses the program. A consumer pays for a default's layout only
// on the targets that choose it (wiki/spec/layouts/plans.md, "Layout demand
// and validation").

use main/layouts.omg;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Package { name: "layout_default_kit" };
    Build::select_provider::<|layouts|::Measure, |layouts|::PairMeasure>(builder, linux_x86_64);
    Build::select_provider::<|layouts|::Measure, |layouts|::PairMeasure>(builder, linux_arm64);
    Build::select_provider::<|layouts|::Measure, |layouts|::PairMeasure>(builder, macos_arm64);
    Build::select_provider::<|layouts|::Measure, |layouts|::OverlappingMeasure>(builder, windows_x86_64);
}
