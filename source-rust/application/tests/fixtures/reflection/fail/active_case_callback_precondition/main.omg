// Report the active case, visit its payload in order, and restore the enclosing record.
// Expected exit: 0
use {omega}/language/core/reflect/reflect.omg;

data Choice [copy] {
    #90 case Left;
    #7 case Pair(#20 first: u64, #3 second: u64);
    #23 case Right;
}
data Envelope [copy] { before: u64; choice: Choice; after: u64; }
data Trace { calls: u64; order: u64; }

machine report_case(trace: @mutable Trace, selected: @|reflect|::CaseInfo)
requires trace.calls == 0u64
{
    trace.calls = ((trace.calls as +Wrapping) + (1u64 as u64 +Wrapping)) as -Wrapping;
    trace.order = ((selected.stable_number as +Wrapping)
                 + (selected.declaration_position as +Wrapping)) as -Wrapping;
}

// Multiplying before each addition makes the visit order visible.
machine report_field<Kind>(trace: @mutable Trace, field: @|reflect|::FieldInfo, value: @Kind)
requires Kind == u64
{
    trace.calls = ((trace.calls as +Wrapping) + (1u64 as u64 +Wrapping)) as -Wrapping;
    trace.order = ((trace.order as +Wrapping) * (31u64 as u64 +Wrapping)
                 + (($value as u64) as +Wrapping)
                 + (field.stable_number as +Wrapping)) as -Wrapping;
}

machine observe(choice: @Choice, calls: u64, order: u64) crashes Trap {
    let mutable trace: Trace = Trace { calls: 0u64, order: 0u64 };
    |reflect|::visit_active_fields::<Choice, report_case, report_field>(choice, @mutable trace);
    transition trace.calls == calls && trace.order == order {
        true -> done(),
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}

machine shared_cases() crashes Trap {
    let left: Choice = Choice::Left {};
    let right: Choice = Choice::Right {};
    let pair: Choice = Choice::Pair { first: 37u64, second: 81u64 };
    observe(@left, 1u64, 90u64);
    observe(@right, 1u64, 25u64);
    observe(@pair, 3u64, 9539u64);
}

machine edit_field<Kind>(trace: @mutable Trace, field: @|reflect|::FieldInfo, value: @mutable Kind)
requires Kind == u64
{
    trace.calls = ((trace.calls as +Wrapping) + (1u64 as u64 +Wrapping)) as -Wrapping;
    let seen: u64 = $value as u64;
    trace.order = ((trace.order as +Wrapping) * (31u64 as u64 +Wrapping)
                 + (seen as +Wrapping)) as -Wrapping;
    let next: u64 = match field.stable_number { 20u64 -> 85u64, _ -> seen };
    $value = next;
}

machine mutable_case() crashes Trap {
    let mutable envelope: Envelope = Envelope {
        before: 27u64,
        choice: Choice::Pair { first: 37u64, second: 81u64 },
        after: 41u64,
    };
    let mutable trace: Trace = Trace { calls: 0u64, order: 0u64 };
    |reflect|::visit_active_fields_mut::<Choice, report_case, edit_field>(@mutable envelope.choice, @mutable trace);
    transition envelope.choice {
        Choice::Pair { first, second } ->
            verify(envelope.before, envelope.after, first, second, trace.calls, trace.order),
        _ -> wrong()
    }
    machine verify(before: u64, after: u64, first: u64, second: u64, calls: u64, order: u64) crashes Trap {
        transition before == 27u64 && after == 41u64
            && first == 85u64 && second == 81u64
            && calls == 3u64 && order == 8916u64 {
            true -> done(),
            _ -> wrong()
        }
        machine done() {}
    }
    machine wrong() { crash Trap; }
}

machine main() crashes Trap {
    shared_cases();
    mutable_case();
}
