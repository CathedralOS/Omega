// Visit the possible payload through a mutable loan.
// Expected exit: 0
use {omega}/language/core/never.omg;
use {omega}/language/core/reflect/reflect.omg;

data Outcome<T, E> {
    case Value(value: T);
    case Error(cause: E);
}

machine report_case(calls: @mutable u64, selected: @|reflect|::CaseInfo) {
    $calls = (($calls as u64 +Wrapping) + (1u64 as u64 +Wrapping)) as -Wrapping;
}

machine edit_field<Kind>(calls: @mutable u64, field: @|reflect|::FieldInfo, value: @mutable Kind)
requires Kind == u64
{
    $value = (($value as u64 +Wrapping) + (17u64 as u64 +Wrapping)) as -Wrapping;
    $calls = (($calls as u64 +Wrapping) + (1u64 as u64 +Wrapping)) as -Wrapping;
}

machine main() crashes Trap {
    let mutable outcome: Outcome<u64, u8> = Outcome::Value { value: 37u64 };
    let mutable calls: u64 = 0u64;
    |reflect|::visit_active_fields_mut::<Outcome<u64, u8>, report_case, edit_field>(@mutable outcome, @mutable calls);
    transition outcome {
        Outcome::Value { value } -> verify(value, calls),
        Outcome::Error { cause } -> wrong_case()
    }
    machine wrong_case() { crash Trap; }
    machine verify(value: u64, calls: u64) crashes Trap {
        transition value == 54u64 && calls == 2u64 { true -> done(), _ -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
