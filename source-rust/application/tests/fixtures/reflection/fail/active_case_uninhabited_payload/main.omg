// Visit the possible payload through a mutable loan.
// Expected exit: 0
use omega::language::core::Never;
use omega::language::core::reflect;

data Outcome<T, E> {
    case Value(value: T);
    case Error(cause: E);
}

machine report_case(calls: @mut u64, selected: @reflect::CaseInfo) {
    calls = ((calls as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
}

machine edit_field<Kind>(calls: @mut u64, field: @reflect::FieldInfo, value: @mut Kind)
requires Kind == u64
{
    value = ((value as u64 in Wrapping) + (17u64 as u64 in Wrapping)) as u64;
    calls = ((calls as u64 in Wrapping) + (1u64 as u64 in Wrapping)) as u64;
}

machine main() crashes Trap {
    let mut outcome: Outcome<u64, u8> = Outcome::Value { value: 37u64 };
    let mut calls: u64 = 0u64;
    reflect::visit_active_fields_mut::<Outcome<u64, u8>, report_case, edit_field>(@mut outcome, @mut calls);
    transition outcome {
        Outcome::Value { value } -> verify(value, calls),
        Outcome::Error { cause } -> wrong_case()
    }
    machine wrong_case() { crash Trap; }
    machine verify(value: u64, calls: u64) crashes Trap {
        transition value == 54u64 && calls == 2u64 { true -> done(), _ -> wrong() }
        machine done() {}
        machine wrong() { crash Trap; }
    }
}
