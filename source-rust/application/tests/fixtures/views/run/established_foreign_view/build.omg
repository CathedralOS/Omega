use omega\language\core\ForeignBinding;
machine build(builder: @mutable Build) {
    Build::application(builder, "established_foreign_view");
    let std_registration: DependencyRegistration = Build::dependency(builder, dependency\from_source(Source::Path { location: "../../../../../../../source/library/std" }));
    Build::bind(builder, linux_x86_64\ProgramEntry, main);
    Build::bind::<Output::write>(builder, linux_x86_64, ForeignBinding::Syscall { number: 1 });
    _ = builder.tests.group::<Tests::capture>();
}
