// The array's length is a call, and that call reads a constant another call
// computes. `last` requires four bytes, so the program is valid only while
// `measure` returns 4.
const WIDTH: u64 = measure();
machine measure() -> u64 crashes none { 4u64 }
machine width() -> u64 crashes Trap { crash Trap; }

machine last(values: @[u8; 4]) -> u8 { values[3u64] }

machine main() crashes Trap {
    let mutable values: [u8; width()];
    values[0u64] = 7u8;
    values[1u64] = 8u8;
    values[2u64] = 9u8;
    values[3u64] = 10u8;
    let end: u8 = last(@values);
    transition end == 10u8 && values[0u64] == 7u8 && values.length == 4u64 {
        true -> done(), false -> failed()
    }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
