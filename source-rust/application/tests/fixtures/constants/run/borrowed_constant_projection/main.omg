// Expected exit: 0
const BYTES: [u8; 3] = [11u8, 17u8, 23u8];

machine deref(value: @u8) -> u8 { $value }
machine element(values: @[u8], position: u64) -> u8
requires position < values.length
{ values[position] }

machine read(position: u64) -> u8
requires position < 3u64
crashes none
{ deref(@BYTES[position]) }

machine from_view(position: u64) -> u8
requires position < 3u64
crashes none
{ element(@BYTES[..], position) }

machine main() crashes Trap {
    transition read(0u64) == 11u8 && read(2u64) == 23u8
            && from_view(0u64) == 11u8 && from_view(2u64) == 23u8 {
        true -> done(), false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
