boundary trait HostProcessId {
    machine get() -> i32 reaches none crashes none;
}

boundary trait HostFile {
    machine resize(fd: i32, length: i64) -> i32 reaches none crashes none;
}

trait Tests {
    machine host() reaches none crashes Trap;
}

machine test_calls_host()
satisfies Tests::host
reaches none
crashes Trap
{
    let process: i32 = HostProcessId::get();
    transition process > 0 {
        true -> done(),
        false -> failed()
    }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}

machine main() {}

// The invalid descriptor keeps the fixture harmless even on a runner that
// forgets to check the selected host binding.
machine test_needs_file_write()
satisfies Tests::host
reaches none
crashes Trap
{
    let result: i32 = HostFile::resize(-1i32, 0i64);
    transition result < 0 {
        true -> done(),
        false -> failed()
    }
    machine done() {}
    machine failed() crashes Trap { crash Trap; }
}
