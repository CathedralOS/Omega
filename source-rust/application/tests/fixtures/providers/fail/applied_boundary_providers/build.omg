use main.omg as app;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "applied_providers" };
    Build::select_provider::<|app|::Service<u32>, First>(builder, windows_x86_64);
    Build::select_provider::<|app|::Service<Slot<ProductRole>>, First>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Service<u32>, First>(builder, linux_x86_64);
    Build::select_provider::<|app|::Service<Slot<ProductRole>>, First>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Service<u32>, First>(builder, macos_arm64);
    Build::select_provider::<|app|::Service<Slot<ProductRole>>, First>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, |app|::main);
    Build::select_provider::<|app|::Service<u32>, First>(builder, linux_arm64);
    Build::select_provider::<|app|::Service<Slot<ProductRole>>, First>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, |app|::main);
}
