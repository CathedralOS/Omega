use main.omg as app;

machine build(builder: @mutable BuildPlan) {
    builder.product = BuildProduct::Application { name: "unissued_test_group_provider" };
    Build::bind(builder, linux_x86_64::ProgramEntry, |app|::main);
    _ = builder.tests.group::<|app|::Tests::reading>();
    let mutable local: TestGroupSettings;
    Build::select_provider::<|app|::Reading, |app|::FixedReading>(builder, linux_x86_64, @mutable local);
}
