use {omega}/build/dependency.omg;

machine build(builder: @mutable Build) {
    Build::application(builder, "test_provider_selection");
    let kit: DependencyRegistration = Build::dependency(builder, |dependency|::from_source(Source::Path { location: "kit" }));
    Build::select_provider::<test_provider_kit\Reading, test_provider_kit\ApplicationReading>(builder, linux_x86_64, CompositionMode::Fused);
    Build::bind(builder, linux_x86_64\ProgramEntry, main);
    let group: TestGroup = builder.tests.group::<Tests::reading>();
    _ = builder.tests.group::<Tests::sibling>();
    Build::select_provider::<test_provider_kit\Reading, test_provider_kit\GroupReading>(builder, linux_x86_64, group);
}
