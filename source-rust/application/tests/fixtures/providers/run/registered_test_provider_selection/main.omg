use test_provider_kit\Reading;

trait Tests {
    machine reading() reaches none crashes Trap;
    machine sibling() reaches none crashes Trap;
}

machine selected_group_uses_override()
satisfies Tests::reading
reaches none
crashes Trap
{
    expect(41u8);
}

machine sibling_uses_default()
satisfies Tests::sibling
reaches none
crashes Trap
{
    expect(17u8);
}

machine main() crashes Trap {
    expect(29u8);
}

machine expect(expected: u8) reaches none crashes Trap {
    let actual: u8 = Reading::value();
    transition actual == expected {
        true -> passed(),
        false -> wrong()
    }
    machine passed() {}
    machine wrong() crashes Trap { crash Trap; }
}
