machine build(builder: @mutable Build) {
    Build::application(builder, "applied_providers");
    Build::select_provider::<Service<u32>, First>(builder, windows_x86_64);
    Build::select_provider::<Service<Slot<ProductRole>>, Second>(builder, windows_x86_64);
    Build::bind(builder, windows_x86_64::ProgramEntry, main);
    Build::select_provider::<Service<u32>, First>(builder, linux_x86_64);
    Build::select_provider::<Service<Slot<ProductRole>>, Second>(builder, linux_x86_64);
    Build::bind(builder, linux_x86_64::ProgramEntry, main);
    Build::select_provider::<Service<u32>, First>(builder, macos_arm64);
    Build::select_provider::<Service<Slot<ProductRole>>, Second>(builder, macos_arm64);
    Build::bind(builder, macos_arm64::ProgramEntry, main);
    Build::select_provider::<Service<u32>, First>(builder, linux_arm64);
    Build::select_provider::<Service<Slot<ProductRole>>, Second>(builder, linux_arm64);
    Build::bind(builder, linux_arm64::ProgramEntry, main);
}
