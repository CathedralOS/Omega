data Reading { value: u8; }
machine take(n: u8) -> u8 { n }
machine read(v: @u8) -> u8
requires $v < 9u8
ensures result <= $v
{
    let copied: u8 = $v;
    let record: Reading = Reading { value: $v };
    let small: bool = match $v { 0 -> false, _ -> true };
    transition small && $v < 9u8 && take($v) == copied && record.value == 4u8 {
        true -> ($v),
        false -> (0u8),
    }
}
machine held(f: @bool) -> bool
requires $f
{
    $f
}
machine main() crashes Trap {
    let byte: u8 = 4;
    let on: bool = true;
    transition read(@byte) == 4u8 && held(@on) { true -> done(), false -> failed() }
    machine done() {}
    machine failed() { crash Trap; }
}
