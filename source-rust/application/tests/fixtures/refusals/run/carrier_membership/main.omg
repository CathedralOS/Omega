domain u16::Small requires self <= 10;
machine fits(x: u8) -> bool { (x as u16) in Small }
machine wide(x: u16) -> bool { x in Small }
machine main() crashes Trap {
    transition fits(7u8) && wide(7u16) && !wide(11u16) { true -> done(), false -> failed() }
    machine done() {}
    machine failed() { crash Trap; }
}
