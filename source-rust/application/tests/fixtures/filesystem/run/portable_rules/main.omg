// Five portable filesystem calls must mean the same thing on every target.
// Each check exits with its own number when the call misbehaves, so a failure
// names the rule it broke; exit 42 means every rule held.
//
// The test gives each engine a separate directory containing all 4200 files.
//
//  3, 4  open_with refuses truncate without write access, and truncate with
//        append, instead of emptying the file.
//  6-8   read_all, copy and read refuse a count larger than the buffer
//        instead of clamping it.
//  9     Permissions::Default only adds write bits; 0o555 becomes 0o777, not
//        0o666.
// 10     create_dir_all creates parents whose prefix ends past byte 255.
// 11     create_dir_all stops at a parent that is a file.
// 12     remove_dir_all removes a tree 21 directories deep.
// 13     remove_dir_all removes a directory of more than 4096 entries.
use {omega}/language/core/filesystem_authority.omg as authority;
use {omega}/language/core/process_exit.omg;
use {system}/filesystem.omg;
use {system}/filesystem_host.omg as paths;

data Main {
}

machine main(context: @mutable Main)
reaches |process_exit|::ProcessExit
    + |authority|::DirectoryEnumeration
    + |authority|::FilesystemContentRead
    + |authority|::FilesystemContentWrite
    + |authority|::FilesystemMetadataMutation
    + |authority|::FilesystemMetadataQuery
    + |authority|::FilesystemNamespaceMutation
{
    let stale: |filesystem|::UnitResult = block |filesystem|::FilesystemService::remove_dir_all("omega_fs_rules" as + |paths|::Path);
    let made: |filesystem|::UnitResult = block |filesystem|::FilesystemService::create_dir_all("omega_fs_rules" as + |paths|::Path);
    transition made { |filesystem|::UnitResult::Ok -> block seed(context), _ -> done(1) }

    machine seed(context: @mutable Main) {
        let written: |filesystem|::UnitResult = block |filesystem|::FilesystemService::write_all("omega_fs_rules/keep.txt" as + |paths|::Path, "hello");
        transition written { |filesystem|::UnitResult::Ok -> block read_only_truncate(context), _ -> done(2) }
    }
    machine read_only_truncate(context: @mutable Main) {
        let options: |filesystem|::OpenOptions = |filesystem|::OpenOptions { read: true, write: false, append: false, truncate: true, create: false, create_new: false };
        let opened: |filesystem|::OpenResult = block |filesystem|::FilesystemService::open_with("omega_fs_rules/keep.txt" as + |paths|::Path, options);
        transition opened {
            |filesystem|::OpenResult::Error { kind } -> block read_only_truncate_kind(context, kind),
            _ -> done(3)
        }
    }
    machine read_only_truncate_kind(context: @mutable Main, kind: |filesystem|::ErrorKind) {
        transition kind { |filesystem|::ErrorKind::InvalidInput -> block append_truncate(context), _ -> done(3) }
    }
    machine append_truncate(context: @mutable Main) {
        let options: |filesystem|::OpenOptions = |filesystem|::OpenOptions { read: false, write: false, append: true, truncate: true, create: false, create_new: false };
        let opened: |filesystem|::OpenResult = block |filesystem|::FilesystemService::open_with("omega_fs_rules/keep.txt" as + |paths|::Path, options);
        transition opened {
            |filesystem|::OpenResult::Error { kind } -> block append_truncate_kind(context, kind),
            _ -> done(4)
        }
    }
    machine append_truncate_kind(context: @mutable Main, kind: |filesystem|::ErrorKind) {
        transition kind { |filesystem|::ErrorKind::InvalidInput -> block intact(context), _ -> done(4) }
    }
    machine intact(context: @mutable Main) {
        let found: |filesystem|::MetadataResult = block |filesystem|::FilesystemService::metadata_path("omega_fs_rules/keep.txt" as + |paths|::Path);
        transition found {
            |filesystem|::MetadataResult::Ok { meta } -> block intact_len(context, meta),
            _ -> done(5)
        }
    }
    machine intact_len(context: @mutable Main, meta: |filesystem|::Metadata) {
        transition meta.length == 5 { true -> block oversized_read_all(context), _ -> done(5) }
    }
    machine oversized_read_all(context: @mutable Main) {
        let mutable buffer: [u8; 4];
        let read: |filesystem|::IoResult = block |filesystem|::FilesystemService::read_all("omega_fs_rules/keep.txt" as + |paths|::Path, @mutable buffer[..], 8);
        transition read {
            |filesystem|::IoResult::Error { kind } -> block oversized_read_all_kind(context, kind),
            _ -> done(6)
        }
    }
    machine oversized_read_all_kind(context: @mutable Main, kind: |filesystem|::ErrorKind) {
        transition kind { |filesystem|::ErrorKind::InvalidInput -> block oversized_copy(context), _ -> done(6) }
    }
    machine oversized_copy(context: @mutable Main) {
        let mutable buffer: [u8; 4];
        let copied: |filesystem|::IoResult = block |filesystem|::FilesystemService::copy("omega_fs_rules/keep.txt" as + |paths|::Path, "omega_fs_rules/copy.txt" as + |paths|::Path, @mutable buffer[..], 8);
        transition copied {
            |filesystem|::IoResult::Error { kind } -> block oversized_copy_kind(context, kind),
            _ -> done(7)
        }
    }
    machine oversized_copy_kind(context: @mutable Main, kind: |filesystem|::ErrorKind) {
        transition kind { |filesystem|::ErrorKind::InvalidInput -> block oversized_read(context), _ -> done(7) }
    }
    machine oversized_read(context: @mutable Main) {
        let opened: |filesystem|::OpenResult = block |filesystem|::FilesystemService::open("omega_fs_rules/keep.txt" as + |paths|::Path);
        transition opened {
            |filesystem|::OpenResult::Ok { file } -> block oversized_read_file(context, file),
            _ -> done(8)
        }
    }
    machine oversized_read_file(context: @mutable Main, file: |filesystem|::File) {
        let mutable buffer: [u8; 4];
        let read: |filesystem|::IoResult = block |filesystem|::FilesystemService::read(file, @mutable buffer[..], 8);
        let closed: |filesystem|::UnitResult = block |filesystem|::FilesystemService::close(file);
        transition read {
            |filesystem|::IoResult::Error { kind } -> block oversized_read_file_kind(context, kind),
            _ -> done(8)
        }
    }
    machine oversized_read_file_kind(context: @mutable Main, kind: |filesystem|::ErrorKind) {
        transition kind { |filesystem|::ErrorKind::InvalidInput -> block default_permissions(context), _ -> done(8) }
    }
    machine default_permissions(context: @mutable Main) {
        let narrowed: |filesystem|::UnitResult = block |filesystem|::FilesystemService::set_permissions("omega_fs_rules/keep.txt" as + |paths|::Path, |filesystem|::Permissions::Posix { mode: 365 });
        let restored: |filesystem|::UnitResult = block |filesystem|::FilesystemService::set_permissions("omega_fs_rules/keep.txt" as + |paths|::Path, |filesystem|::Permissions::Default);
        let found: |filesystem|::MetadataResult = block |filesystem|::FilesystemService::metadata_path("omega_fs_rules/keep.txt" as + |paths|::Path);
        transition found {
            |filesystem|::MetadataResult::Ok { meta } -> block default_mode(context, meta),
            _ -> done(9)
        }
    }
    machine default_mode(context: @mutable Main, meta: |filesystem|::Metadata) {
        transition meta.posix {
            |filesystem|::PosixMetadataResult::Ok { details } -> block default_bits(context, details.mode & 511),
            _ -> done(9)
        }
    }
    machine default_bits(context: @mutable Main, mode: u32) {
        transition mode == 511 { true -> block long_parents(context), _ -> done(9) }
    }
    machine long_parents(context: @mutable Main) {
        let made: |filesystem|::UnitResult = block |filesystem|::FilesystemService::create_dir_all("omega_fs_" as + |paths|::Path);
        transition made { |filesystem|::UnitResult::Ok -> block blocked_parent(context), _ -> done(10) }
    }
    machine blocked_parent(context: @mutable Main) {
        let made: |filesystem|::UnitResult = block |filesystem|::FilesystemService::create_dir_all("omega_fs_rules/keep.txt/inner/leaf" as + |paths|::Path);
        transition made { |filesystem|::UnitResult::Ok -> done(11), _ -> block deep(context) }
    }
    machine deep(context: @mutable Main) {
        let made: |filesystem|::UnitResult = block |filesystem|::FilesystemService::create_dir_all("omega_fs_rules/deep/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d/d" as + |paths|::Path);
        transition made { |filesystem|::UnitResult::Ok -> block wide(context), _ -> done(12) }
    }
    machine wide(context: @mutable Main) {
        let removed: |filesystem|::UnitResult = block |filesystem|::FilesystemService::remove_dir_all("omega_fs_rules_wide" as + |paths|::Path);
        let present: bool = block |filesystem|::FilesystemService::exists("omega_fs_rules_wide" as + |paths|::Path);
        transition removed {
            |filesystem|::UnitResult::Ok -> block wide_gone(context, present),
            _ -> done(13)
        }
    }
    machine wide_gone(context: @mutable Main, present: bool) {
        transition present { true -> done(13), false -> block drain(context) }
    }
    machine drain(context: @mutable Main) {
        let removed: |filesystem|::UnitResult = block |filesystem|::FilesystemService::remove_dir_all("omega_fs_rules" as + |paths|::Path);
        let present: bool = block |filesystem|::FilesystemService::exists("omega_fs_rules" as + |paths|::Path);
        transition removed {
            |filesystem|::UnitResult::Ok -> drained(present),
            _ -> done(12)
        }
    }
    machine drained(present: bool) {
        transition present { true -> done(12), false -> done(42) }
    }

    machine done(code: i32) { |process_exit|::ProcessExit::exit_process(code); }
}

machine entry_start()
reaches |process_exit|::ProcessExit
    + |authority|::DirectoryEnumeration
    + |authority|::FilesystemContentRead
    + |authority|::FilesystemContentWrite
    + |authority|::FilesystemMetadataMutation
    + |authority|::FilesystemMetadataQuery
    + |authority|::FilesystemNamespaceMutation
{
    let mutable entry_storage: Main;
    block main(@mutable entry_storage);
}
