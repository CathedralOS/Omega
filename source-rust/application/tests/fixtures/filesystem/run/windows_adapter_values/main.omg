// Expected exit: 0
machine unsupported(seconds: i64) -> bool {
    let encoded: |metadata|::WindowsTimestampEncoding = |metadata|::windows_filesystem_encode_timestamp(seconds);
    transition encoded {
        |metadata|::WindowsTimestampEncoding::Error { kind } -> error(kind),
        _ -> false
    }
    machine error(kind: |filesystem|::ErrorKind) -> bool {
        transition kind { |filesystem|::ErrorKind::Unsupported -> true, _ -> false }
    }
}
machine ticks(seconds: i64, expected: u64) -> bool {
    let encoded: |metadata|::WindowsTimestampEncoding = |metadata|::windows_filesystem_encode_timestamp(seconds);
    transition encoded {
        |metadata|::WindowsTimestampEncoding::Ticks { value } -> (value == expected),
        _ -> false
    }
}
