// Expected exit: 0
machine invalid_length(length: u64) -> bool {
    let mutable record: |win_fs|::WindowsDirectoryEntry;
    record.name_len = length;
    let result: |filesystem|::DirEntryResult = |directory|::windows_filesystem_directory_entry(record);
    transition result {
        |filesystem|::DirEntryResult::Error { kind } -> invalid_kind(kind),
        _ -> false
    }
    machine invalid_kind(kind: |filesystem|::ErrorKind) -> bool {
        transition kind { |filesystem|::ErrorKind::Other -> true, _ -> false }
    }
}
