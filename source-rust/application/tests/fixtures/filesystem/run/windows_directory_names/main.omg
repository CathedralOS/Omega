use native_record.omg as directory_io;
use omega\language\core\DirectoryEnumeration;
use windows_filesystem_host.omg as win_fs;
use filesystem_host.omg as paths;
use control.omg as control;
use omega\language\core\narrow_i64_to_u64_wrapping;
use omega\language\core\FilesystemContentRead;
use omega\language\core\FilesystemContentWrite;
use omega\language\core\FilesystemMetadataMutation;
use omega\language\core\FilesystemNamespaceMutation;

// The handles select deterministic native name streams. The production scan,
// dot filter, status conversion and native record declaration are supplied
// by portable_filesystem_values.rs.
domain i64::WindowsPrivateNonalertFileOrAbsent requires self != -1;

machine windows_directory_next(handle: i64 in WindowsPrivateNonalertFileOrAbsent, output: @mutable |directory_io|::WindowsNativeDirectoryNameInfo) -> WindowsDirectoryStep
reaches DirectoryEnumeration {
    transition output.control {
        0 -> dot(output),
        1 -> parent(output),
        2 -> first(handle, output),
        _ -> following(handle)
    }
    machine dot(output: @mutable |directory_io|::WindowsNativeDirectoryNameInfo) -> WindowsDirectoryStep {
        output.control = 1;
        output.characters[0] = 46;
        WindowsDirectoryStep::Name { length: 1 }
    }
    machine parent(output: @mutable |directory_io|::WindowsNativeDirectoryNameInfo) -> WindowsDirectoryStep {
        output.control = 2;
        output.characters[1] = 46;
        WindowsDirectoryStep::Name { length: 2 }
    }
    machine first(handle: i64 in WindowsPrivateNonalertFileOrAbsent, output: @mutable |directory_io|::WindowsNativeDirectoryNameInfo) -> WindowsDirectoryStep {
        transition (handle as -WindowsPrivateNonalertFileOrAbsent) == 1 {
            true -> WindowsDirectoryStep::End,
            false -> ordinary(output)
        }
    }
    machine ordinary(output: @mutable |directory_io|::WindowsNativeDirectoryNameInfo) -> WindowsDirectoryStep {
        output.control = 3;
        // Counting names does not decode an unmatched UTF-16 surrogate.
        output.characters[0] = 55296;
        WindowsDirectoryStep::Name { length: 1 }
    }
    machine following(handle: i64 in WindowsPrivateNonalertFileOrAbsent) -> WindowsDirectoryStep {
        transition (handle as -WindowsPrivateNonalertFileOrAbsent) == 2 {
            true -> WindowsDirectoryStep::Error { code: 5 },
            false -> WindowsDirectoryStep::End
        }
    }
}

// Both path-based scans use the stream whose second record fails with code 5.
// The close hook fails with code 6, so the successful first-only scan reports 6
// and the full scan retains the earlier enumeration error.
machine windows_directory_open(path: @[u8] in |paths|::Path) -> i64 in WindowsPrivateNonalertFileOrAbsent {
    2 as +WindowsPrivateNonalertFileOrAbsent
}

machine scan(handle: i64 in WindowsPrivateNonalertFileOrAbsent, count: u64, first_only: bool) -> |win_fs|::WindowsDirectoryCountResult
requires (handle as -WindowsPrivateNonalertFileOrAbsent) != 0
reaches DirectoryEnumeration {
    let mutable record: |directory_io|::WindowsNativeDirectoryNameInfo;
    block windows_directory_scan_names(handle, @mutable record, count, first_only)
}

machine has_count(result: |win_fs|::WindowsDirectoryCountResult, expected: u64) -> bool {
    transition result {
        |win_fs|::WindowsDirectoryCountResult::Count { count } -> (count == expected),
        |win_fs|::WindowsDirectoryCountResult::Error { code } -> false
    }
}

machine has_error(result: |win_fs|::WindowsDirectoryCountResult, expected: u32) -> bool {
    transition result {
        |win_fs|::WindowsDirectoryCountResult::Count { count } -> false,
        |win_fs|::WindowsDirectoryCountResult::Error { code } -> (code == expected)
    }
}

machine main() crashes Trap {
    let empty: |win_fs|::WindowsDirectoryCountResult = block scan(1 as +WindowsPrivateNonalertFileOrAbsent, 0, true);
    let first: |win_fs|::WindowsDirectoryCountResult = block scan(2 as +WindowsPrivateNonalertFileOrAbsent, 0, true);
    let counted: |win_fs|::WindowsDirectoryCountResult = block scan(3 as +WindowsPrivateNonalertFileOrAbsent, 9223372036854775807, false);
    let full: |win_fs|::WindowsDirectoryCountResult = block scan(1 as +WindowsPrivateNonalertFileOrAbsent, 18446744073709551615, false);
    let overflow: |win_fs|::WindowsDirectoryCountResult = block scan(3 as +WindowsPrivateNonalertFileOrAbsent, 18446744073709551615, false);
    let close_error: |win_fs|::WindowsDirectoryCountResult = block windows_directory_count_names("." as + |paths|::Path, true);
    let earlier_error: |win_fs|::WindowsDirectoryCountResult = block windows_directory_count_names("." as + |paths|::Path, false);
    transition has_count(empty, 0) && has_count(first, 1) && has_count(counted, 9223372036854775808)
        && has_count(full, 18446744073709551615) && has_error(overflow, 534)
        && has_error(close_error, 6) && has_error(earlier_error, 5) {
        true -> done(),
        false -> bad()
    }
    machine done() {}
    machine bad() crashes Trap { crash Trap; }
}
