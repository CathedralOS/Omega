use filesystem.omg as fs;
use filesystem_host.omg as paths;
use posix_filesystem_adapter.omg as adapter;
machine count(path: @[u8] in |paths|::Path) -> i64 {
    let mutable context: |adapter|::PosixFilesystem;
    let out: |fs|::IoResult = |adapter|::posix_filesystem_read_dir_count(@mutable context, path);
    transition out { |fs|::IoResult::Ok { count } -> small(count), |fs|::IoResult::Error { kind } -> (-1) }
    machine small(count: u64) -> i64 { transition count < 10 { true -> (count as i64), false -> (-2) } }
}
machine empty(path: @[u8] in |paths|::Path) -> i64 {
    let mutable context: |adapter|::PosixFilesystem;
    let out: |fs|::EmptyResult = |adapter|::posix_filesystem_read_dir_is_empty(@mutable context, path);
    transition out { |fs|::EmptyResult::Empty -> 1, |fs|::EmptyResult::NonEmpty -> 0, _ -> (-1) }
}
machine indexed(path: @[u8] in |paths|::Path, n: u64) -> i64 {
    let mutable context: |adapter|::PosixFilesystem;
    let out: |fs|::DirEntryResult = |adapter|::posix_filesystem_read_dir_nth(@mutable context, path, n);
    transition out { |fs|::DirEntryResult::Ok { entry } -> (entry.name[0] as i64), |fs|::DirEntryResult::End -> 0, _ -> (-1) }
}
machine main() crashes Trap {
    let missing: i64 = count("a" as + |paths|::Path);
    let mixed: i64 = count("batches" as + |paths|::Path);
    let late: i64 = count("io" as + |paths|::Path);
    let dots: i64 = empty("dot" as + |paths|::Path);
    let early: i64 = empty("io" as + |paths|::Path);
    let unknown: i64 = empty("child" as + |paths|::Path);
    let malformed: i64 = count("torn" as + |paths|::Path);
    let too_long: i64 = count("excess" as + |paths|::Path);
    let hidden: i64 = indexed("batches" as + |paths|::Path, 1);
    let last: i64 = indexed("batches" as + |paths|::Path, 2);
    let end: i64 = indexed("batches" as + |paths|::Path, 3);
    transition missing == 2 && mixed == 3 && late == -1
        && dots == 1 && early == 0 && unknown == 0
        && malformed == -1 && too_long == -1
        && hidden == 46 && last == 122 && end == 0 {
        true -> done(), false -> bad()
    }
    machine done() {} machine bad() { crash Trap; }
}
