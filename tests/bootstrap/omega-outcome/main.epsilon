boundary trait Console {
    machine exit_process(return_code: i32) -> never;
    machine write_byte(value: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}

data Main {
    console: Console;
    compiler: OmegaScalarCompiler;
    envelope: OmegaRequestEnvelope;
    structure: OmegaRequestStructure;
    frame: OmegaOutcomeFrame;
    req: [u8; 160];
    req_cursor: i32;
    subject_at: i32;
    invocation_at: i32;
    product_at: i32;
    end_at: i32;
}

machine Main::req_u32(&mut self, value: i32) {
    self.req[self.req_cursor] = value & 255;
    self.req[self.req_cursor + 1] = (value >> 8) & 255;
    self.req[self.req_cursor + 2] = (value >> 16) & 255;
    self.req[self.req_cursor + 3] = (value >> 24) & 255;
    self.req_cursor = self.req_cursor + 4;
    return;
}

machine Main::req_poke_u32(&mut self, offset: i32, value: i32) {
    self.req[offset] = value & 255;
    self.req[offset + 1] = (value >> 8) & 255;
    self.req[offset + 2] = (value >> 16) & 255;
    self.req[offset + 3] = (value >> 24) & 255;
    return;
}

machine Main::req_raw(&mut self, text: &[u8]) {
    transition true { true -> byte(0) }

    state byte(index: i32) {
        transition index < text.len {
            true -> write(index)
            _ -> return
        }
    }

    state write(index: i32) {
        self.req[self.req_cursor] = text[index];
        self.req_cursor = self.req_cursor + 1;
        transition true { true -> byte(index + 1) }
    }
}

machine Main::req_bytes(&mut self, text: &[u8]) {
    self.req_u32(text.len);
    self.req_raw(text);
    return;
}

// The smallest canonical OCREQ V1 request: one external-local package row
// with an empty snapshot table, no edges, the package root role, and an
// alpha_bootstrap_tape invocation with an empty admission table and a 32-byte
// commitment.
machine Main::build_request(&mut self) {
    self.req_cursor = 0;
    self.req_raw("OCREQ\x01\x00\x00");
    self.req_u32(0);
    self.req_u32(0);
    self.subject_at = self.req_cursor;
    self.req_u32(1);
    self.req_bytes("a");
    self.req_u32(1);
    self.req_bytes("l");
    self.req_bytes("r");
    self.req_bytes("t");
    self.req_bytes("c");
    self.req_bytes("");
    self.req_u32(1);
    self.req_u32(0);
    self.req_u32(0);
    self.req_u32(0);
    self.req_u32(1);
    self.invocation_at = self.req_cursor;
    self.product_at = self.req_cursor;
    self.req_u32(4);
    self.req_bytes("alpha_bootstrap");
    self.req_u32(0);
    self.req_raw("\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA\xAA");
    self.end_at = self.req_cursor;
    self.req_poke_u32(8, self.invocation_at - self.subject_at);
    self.req_poke_u32(12, self.end_at - self.invocation_at);
    return;
}

machine Main::emit_i32(&mut self, value: i32) {
    self.console.write_byte(value & 255);
    self.console.write_byte((value >> 8) & 255);
    self.console.write_byte((value >> 16) & 255);
    self.console.write_byte((value >> 24) & 255);
    return;
}

machine Main::emit_frame(&mut self) {
    transition true { true -> byte(0) }

    state byte(index: i32) {
        transition index < self.frame.length {
            true -> write(index)
            _ -> return
        }
    }

    state write(index: i32) {
        self.console.write_byte(self.frame.bytes[index]);
        transition true { true -> byte(index + 1) }
    }
}

// The six-tuple omits the canonical ordinals this single-unit adapter always
// leaves zero; asserting them here pins that adapter invariant.
machine Main::emit_tuple(&mut self) {
    assert self.compiler.outcome_package_ordinal == 0;
    assert self.compiler.outcome_unit_ordinal == 0;
    self.emit_i32(self.compiler.outcome_tag);
    self.emit_i32(self.compiler.outcome_space);
    self.emit_i32(self.compiler.outcome_code);
    self.emit_i32(self.compiler.outcome_coordinate);
    self.emit_i32(self.compiler.outcome_limit);
    self.emit_i32(self.compiler.outcome_requested);
    return;
}

// Publishes the compiler's recorded tuple through the canonical encoder and
// emits the resulting frame, asserting the expected canonical extent. Only
// tuples carrying assigned codes reach this helper; unassigned-inventory
// tuples are asserted unencodable at their recording sites.
machine Main::encode_outcome(&mut self, length: i32) {
    assert self.frame.encode(
        self.compiler.outcome_tag, self.compiler.outcome_space,
        self.compiler.outcome_code, self.compiler.outcome_coordinate,
        self.compiler.outcome_package_ordinal,
        self.compiler.outcome_unit_ordinal,
        self.compiler.outcome_limit,
        self.compiler.outcome_requested) == 1;
    assert self.frame.length == length;
    self.emit_frame();
    return;
}

machine Main::main(&mut self) {
    // Embedded scalar-resource projection: every assigned code pairs its
    // selected limit with its fixed coordinate space.
    assert omega_compiler_resource_limit(1) == 67108864;
    assert omega_compiler_resource_space(1) == 1;
    assert omega_compiler_resource_limit(2) == 1048576;
    assert omega_compiler_resource_space(2) == 1;
    assert omega_compiler_resource_limit(3) == 4096;
    assert omega_compiler_resource_space(3) == 4;
    assert omega_compiler_resource_limit(4) == 4096;
    assert omega_compiler_resource_space(4) == 4;
    assert omega_compiler_resource_limit(5) == 16384;
    assert omega_compiler_resource_space(5) == 4;
    assert omega_compiler_resource_limit(6) == 16384;
    assert omega_compiler_resource_space(6) == 4;
    assert omega_compiler_resource_limit(7) == 16384;
    assert omega_compiler_resource_space(7) == 4;
    assert omega_compiler_resource_limit(8) == 128;
    assert omega_compiler_resource_space(8) == 4;
    assert omega_compiler_resource_limit(9) == 128;
    assert omega_compiler_resource_space(9) == 4;
    assert omega_compiler_resource_limit(10) == 16384;
    assert omega_compiler_resource_space(10) == 4;
    assert omega_compiler_resource_limit(11) == 16384;
    assert omega_compiler_resource_space(11) == 4;
    assert omega_compiler_resource_limit(12) == 16777212;
    assert omega_compiler_resource_space(12) == 2;
    assert omega_compiler_resource_limit(13) == 1864134;
    assert omega_compiler_resource_space(13) == 2;
    assert omega_compiler_resource_limit(14) == 16777212;
    assert omega_compiler_resource_space(14) == 2;
    assert omega_compiler_resource_limit(0) == 0;
    assert omega_compiler_resource_limit(15) == 0;
    assert omega_compiler_resource_limit(24) == 0;
    assert omega_compiler_resource_space(0) == -1;
    // Coverage provisions 15..23 anchor in canonical source; 24 and 25 are
    // coordinate-free; request_staging_bytes stays request-anchored.
    assert omega_compiler_resource_space(15) == 4;
    assert omega_compiler_resource_space(23) == 4;
    assert omega_compiler_resource_space(24) == 0;
    assert omega_compiler_resource_space(25) == 0;
    assert omega_compiler_resource_space(26) == 1;
    assert omega_compiler_resource_space(27) == -1;

    // Parser resource projection onto wire codes 3..11.
    assert omega_parser_resource_code(OmegaParserResource::Roots) == 3;
    assert omega_parser_resource_code(OmegaParserResource::States) == 4;
    assert omega_parser_resource_code(OmegaParserResource::PathMembers) == 5;
    assert omega_parser_resource_code(OmegaParserResource::DataMembers) == 6;
    assert omega_parser_resource_code(OmegaParserResource::TypeNodes) == 7;
    assert omega_parser_resource_code(OmegaParserResource::TypeDepth) == 8;
    assert omega_parser_resource_code(OmegaParserResource::ExpressionDepth) == 9;
    assert omega_parser_resource_code(OmegaParserResource::Statements) == 10;
    assert omega_parser_resource_code(OmegaParserResource::Expressions) == 11;
    assert omega_parser_resource_code(OmegaParserResource::None) == 0;

    // Assigned non-resource codes: malformed_request anchors in the request,
    // the lexical refusals and duplicate_name/integer_literal_out_of_range
    // anchor in canonical source, and missing_entry carries no coordinate.
    assert omega_reject_code_space(1) == 1;
    assert omega_reject_code_space(2) == 4;
    assert omega_reject_code_space(3) == 4;
    assert omega_reject_code_space(4) == 4;
    assert omega_reject_code_space(5) == 4;
    assert omega_reject_code_space(6) == 4;
    assert omega_reject_code_space(7) == 4;
    assert omega_reject_code_space(8) == 4;
    assert omega_reject_code_space(9) == 4;
    assert omega_reject_code_space(10) == 4;
    assert omega_reject_code_space(11) == 0;
    assert omega_reject_code_space(12) == 4;
    // The syntax inventory 13..89 and the checking codes 90..97 all anchor
    // in canonical source; 98 is the next unassigned code.
    assert omega_reject_code_space(0) == -1;
    assert omega_reject_code_space(13) == 4;
    assert omega_reject_code_space(89) == 4;
    assert omega_reject_code_space(90) == 4;
    assert omega_reject_code_space(97) == 4;
    assert omega_reject_code_space(98) == -1;

    // The retained lexical diagnostic projects onto Reject codes 2..9.
    assert omega_lexical_reject_code(
        OmegaLexDiagnosticCode::InvalidUtf8) == 2;
    assert omega_lexical_reject_code(
        OmegaLexDiagnosticCode::OutsideLexicalProfile) == 3;
    assert omega_lexical_reject_code(
        OmegaLexDiagnosticCode::UnterminatedBlockComment) == 4;
    assert omega_lexical_reject_code(
        OmegaLexDiagnosticCode::UnterminatedStringLiteral) == 5;
    assert omega_lexical_reject_code(
        OmegaLexDiagnosticCode::UnterminatedStringEscape) == 6;
    assert omega_lexical_reject_code(
        OmegaLexDiagnosticCode::UnsupportedEscape) == 7;
    assert omega_lexical_reject_code(
        OmegaLexDiagnosticCode::UnterminatedHexEscape) == 8;
    assert omega_lexical_reject_code(
        OmegaLexDiagnosticCode::InvalidHexEscapeDigit) == 9;

    assert omega_internal_code_space(1) == 3;
    assert omega_internal_code_space(0) == -1;
    assert omega_internal_code_space(2) == -1;

    // Exact frame vectors: malformed_request at request offset 37.
    assert self.frame.encode(1, 1, 1, 37, 0, 0, 0, 0) == 1;
    assert self.frame.encoded == 1;
    assert self.frame.length == 40;
    self.emit_frame();

    // A refusal after a success proves the record resets before checks.
    assert self.frame.encode(0, 0, 0, 0, 0, 0, 0, 0) == 0;
    assert self.frame.encoded == 0;
    assert self.frame.length == 0;

    // Incomplete parser_roots at source offset 1234 of unit 7, package 5.
    assert self.frame.encode(2, 4, 3, 1234, 5, 7, 4096, 4097) == 1;
    assert self.frame.encoded == 1;
    assert self.frame.length == 48;
    self.emit_frame();

    // Incomplete tape_payload_bytes at payload offset 100.
    assert self.frame.encode(2, 2, 12, 100, 0, 0, 16777212, 16777213) == 1;
    assert self.frame.length == 40;
    self.emit_frame();

    // InternalFailure invariant_violation at internal row 9.
    assert self.frame.encode(3, 3, 1, 9, 0, 0, 0, 0) == 1;
    assert self.frame.length == 40;
    self.emit_frame();

    // Noncanonical tuples refuse without publishing.
    assert self.frame.encode(4, 0, 1, 0, 0, 0, 0, 0) == 0;
    assert self.frame.encode(1, 1, 2, 0, 0, 0, 0, 0) == 0;
    assert self.frame.encode(2, 4, 15, 0, 0, 0, 4096, 1) == 0;
    assert self.frame.encode(2, 1, 3, 0, 0, 0, 4096, 4097) == 0;
    assert self.frame.encode(2, 4, 12, 0, 0, 0, 16777212, 1) == 0;
    assert self.frame.encode(2, 0, 3, 5, 0, 0, 4096, 1) == 0;
    assert self.frame.encode(1, 1, 1, -1, 0, 0, 0, 0) == 0;
    assert self.frame.encode(1, 1, 1, 0, 3, 0, 0, 0) == 0;
    assert self.frame.encode(1, 1, 1, 0, 0, 0, 5, 0) == 0;
    assert self.frame.encode(3, 3, 1, 0, 0, 0, 0, 7) == 0;
    assert self.frame.encode(2, 4, 3, 0, 0, 0, 4095, 1) == 0;
    assert self.frame.encode(2, 4, 3, 0, 0, -1, 4096, 1) == 0;
    assert self.frame.encode(1, 3, 1, 0, 0, 0, 0, 0) == 0;
    assert self.frame.encode(1, 1, -1, 0, 0, 0, 0, 0) == 0;
    // Assigned codes still refuse the wrong space, a noncanonical coordinate,
    // and the first unassigned Reject code.
    assert self.frame.encode(1, 1, 5, 0, 0, 0, 0, 0) == 0;
    assert self.frame.encode(1, 0, 11, 5, 0, 0, 0, 0) == 0;
    assert self.frame.encode(1, 4, 98, 0, 0, 0, 0, 0) == 0;
    assert self.frame.encoded == 0;
    assert self.frame.length == 0;

    // Newly assigned codes encode: a syntax Reject anchors in canonical
    // source, a source-anchored coverage Incomplete reports its refused
    // occurrence count with no provisioned limit, and a coordinate-free
    // coverage provision publishes a 40-byte frame.
    assert self.frame.encode(1, 4, 13, 777, 1, 2, 0, 0) == 1;
    assert self.frame.length == 48;
    self.emit_frame();
    assert self.frame.encode(2, 4, 20, 888, 3, 4, 0, 1) == 1;
    assert self.frame.length == 48;
    self.emit_frame();
    assert self.frame.encode(2, 0, 24, 0, 0, 0, 0, 5) == 1;
    assert self.frame.length == 40;
    self.emit_frame();

    // Bounded publication arithmetic: exact, saturated, and defect results.
    self.emit_i32(omega_saturating_i32_sum(3, 4));
    self.emit_i32(omega_saturating_i32_sum(2147483640, 8));
    self.emit_i32(omega_saturating_i32_sum(-1, 5));
    self.emit_i32(omega_saturating_i32_sum(2147483647, 0));
    self.emit_i32(omega_saturating_i32_sum(2147483647, 1));

    // Phase-1 declared extents on the framed request envelope.
    self.emit_i32(self.envelope.extent_resource());
    self.envelope.frame_ocreq(
        "OCREQ\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00");
    assert self.envelope.complete == 1;
    self.emit_i32(self.envelope.extent_resource());

    // Recorded outcome tuples: a duplicate name refuses at the later name.
    self.compiler.compile(
        "machine answer() -> u8 { 1 } machine answer() -> u8 { 2 }",
        "answer");
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Reject -> duplicate_tuple()
        _ -> self.console.exit_process(1)
    }

    state duplicate_tuple() {
        self.emit_tuple();
        self.encode_outcome(48);
        transition true { true -> out_of_range() }
    }

    // An out-of-range literal refuses at the refused literal's first byte.
    state out_of_range() {
        self.compiler.compile("machine answer() -> u8 { 256 }", "answer");
        transition self.compiler.status {
            OmegaScalarCompilationStatus::Reject -> out_of_range_tuple()
            _ -> self.console.exit_process(5)
        }
    }

    state out_of_range_tuple() {
        self.emit_tuple();
        self.encode_outcome(48);
        transition true { true -> missing_entry() }
    }

    // A missing selected entry refuses with no source anchor.
    state missing_entry() {
        self.compiler.compile("machine spare() -> u8 { 7 }", "answer");
        transition self.compiler.status {
            OmegaScalarCompilationStatus::Reject -> missing_tuple()
            _ -> self.console.exit_process(2)
        }
    }

    state missing_tuple() {
        self.emit_tuple();
        self.encode_outcome(40);
        transition true { true -> unsupported() }
    }

    // An unsupported expression stops as a coverage refusal at the machine.
    state unsupported() {
        self.compiler.compile("machine answer() -> u8 { missing }", "answer");
        transition self.compiler.status {
            OmegaScalarCompilationStatus::Incomplete -> unsupported_tuple()
            _ -> self.console.exit_process(3)
        }
    }

    // The coverage provisions are still unassigned, so this tuple cannot
    // publish a frame.
    state unsupported_tuple() {
        self.emit_tuple();
        assert self.frame.encode(
            self.compiler.outcome_tag, self.compiler.outcome_space,
            self.compiler.outcome_code, self.compiler.outcome_coordinate,
            self.compiler.outcome_package_ordinal,
            self.compiler.outcome_unit_ordinal,
            self.compiler.outcome_limit,
            self.compiler.outcome_requested) == 0;
        transition true { true -> lexical() }
    }

    // An unterminated string publishes unterminated_string_literal at the
    // opening quote.
    state lexical() {
        self.compiler.compile("machine a() -> u8 { \"x }", "answer");
        transition self.compiler.status {
            OmegaScalarCompilationStatus::Reject -> lexical_tuple()
            _ -> self.console.exit_process(6)
        }
    }

    state lexical_tuple() {
        self.emit_tuple();
        self.encode_outcome(48);
        transition true { true -> invalid_utf8() }
    }

    // A malformed UTF-8 scalar publishes invalid_utf8 at its first byte.
    state invalid_utf8() {
        self.compiler.compile("\xFF", "answer");
        transition self.compiler.status {
            OmegaScalarCompilationStatus::Reject -> utf8_tuple()
            _ -> self.console.exit_process(7)
        }
    }

    state utf8_tuple() {
        self.emit_tuple();
        self.encode_outcome(48);
        transition true { true -> completed() }
    }

    state completed() {
        self.compiler.compile("machine answer() -> u8 { 42 }", "answer");
        transition self.compiler.status {
            OmegaScalarCompilationStatus::Complete -> completed_tuple()
            _ -> self.console.exit_process(4)
        }
    }

    // A post-Complete tuple carries no publishable frame.
    state completed_tuple() {
        self.emit_tuple();
        assert self.frame.encode(
            self.compiler.outcome_tag, self.compiler.outcome_space,
            self.compiler.outcome_code, self.compiler.outcome_coordinate,
            self.compiler.outcome_package_ordinal,
            self.compiler.outcome_unit_ordinal,
            self.compiler.outcome_limit,
            self.compiler.outcome_requested) == 0;
        transition true { true -> request_structure() }
    }

    // The OCREQ V1 field/tag shape pass over the whole compiled D: a
    // canonical request completes phases 0, 2, and 6 with the retained
    // summary, and an unassigned product tag publishes the malformed_request
    // tuple anchored at the tag field.
    state request_structure() {
        self.build_request();
        self.structure.check(self.req.as_slice[0..self.end_at]);
        assert self.structure.complete == 1;
        assert self.structure.package_count == 1;
        assert self.structure.edge_count == 0;
        assert self.structure.root_package == 0;
        assert self.structure.root_role == 1;
        assert self.structure.product == 4;
        assert self.structure.admission_count == 0;
        assert self.structure.malformed_offset == -1;
        assert self.structure.outcome_tag == 0;
        assert self.structure.outcome_code == -1;
        transition true { true -> request_refusal() }
    }

    state request_refusal() {
        self.req_poke_u32(self.product_at, 5);
        self.structure.check(self.req.as_slice[0..self.end_at]);
        assert self.structure.complete == 0;
        assert self.structure.outcome_tag == 1;
        assert self.structure.outcome_space == 1;
        assert self.structure.outcome_code == 1;
        assert self.structure.outcome_coordinate == self.product_at;
        assert self.structure.outcome_limit == 0;
        assert self.structure.outcome_requested == 0;
        assert self.frame.encode(
            self.structure.outcome_tag, self.structure.outcome_space,
            self.structure.outcome_code, self.structure.outcome_coordinate,
            0, 0, 0, 0) == 1;
        assert self.frame.length == 40;
        return;
    }
}
