machine main() -> u8 crashes Trap {
    let mutable emitter: AlphaEmitter;
    emitter.length = 0;
    emitter.layout = false;
    emitter.complete = true;
    alpha_byte(@mutable emitter, 173);
    emitter.layout = true;
    emitter.bytes[1] = 87;
    alpha_byte(@mutable emitter, 15);
    let initial: bool = emitter.complete && emitter.length == 2
        && emitter.bytes[0] == 173 && emitter.bytes[1] == 87;
    emitter.layout = false;
    emitter.length = 2097151;
    alpha_byte(@mutable emitter, 201);
    let full: bool = emitter.complete && emitter.length == 2097152 && emitter.bytes[2097151] == 201;
    alpha_byte(@mutable emitter, 0);
    transition initial && full && emitter.complete == false
        && emitter.length == 2097152 && emitter.bytes[2097151] == 201 {
        true -> pass(),
        _ -> failed()
    }
    machine failed() -> u8 { 1 }
    machine pass() -> u8 { 42 }
}
