machine Main::check_machine_requirement_owners(&mut self) {
    self.check_complete();
    self.check_call_stacks_empty();
    assert self.parser.root_count == 4;
    assert self.parser.data_count == 2;
    assert self.parser.machine_count == 2;
    assert self.parser.machine_state_count == 4;
    assert self.parser.requirement_count == 7;
    assert self.parser.data_items[0].first_requirement == 0;
    assert self.parser.data_items[0].requirement_count == 1;
    assert self.parser.data_items[1].first_requirement == 6;
    assert self.parser.data_items[1].requirement_count == 1;
    self.check_state_requirement_range(0, 1, 3);
    self.check_state_requirement_range(1, 4, 2);
    self.check_state_requirement_range(2, 6, 0);
    self.check_state_requirement_range(3, 7, 0);
    assert self.parser.machine_states[0].has_return_type == 1;
    assert self.parser.machine_states[0].statement_count == 0;
    assert self.parser.machine_states[1].has_return_type == 1;
    assert self.parser.machine_states[1].statement_count == 1;
    let predicate:i32 = self.parser.requirements[4].expression;
    let row:i32 = self.parser.expressions[predicate].payload0;
    let field:i32 = self.parser.binary_expressions[row].left;
    assert self.parser.expressions[field].payload1 == 2;
    assert self.parser.requirements[1].end < self.parser.requirements[2].start;
    assert self.parser.requirements[2].end < self.parser.requirements[3].start;
    assert self.parser.requirements[3].end < self.parser.requirements[4].start;
    transition self.parser.expressions[predicate].kind {
        OmegaExpressionKind::Binary -> operator(row)
        _ -> self.console.exit_process(1)
    }
    state operator(selected_row:i32) {
        transition self.parser.binary_expressions[selected_row].operator {
            OmegaBinaryOperatorKind::Less -> return
            _ -> self.console.exit_process(1)
        }
    }
}

machine Main::check_machine_requirement_refused(&mut self, start:i32, end:i32) {
    transition self.parser.diagnostic_code {
        OmegaParseDiagnosticCode::ExpectedMachineRequirement -> coordinates()
        _ -> self.console.exit_process(1)
    }
    state coordinates() {
        self.check_syntax_refused(start, end);
    }
}

machine Main::check_subject_string(&mut self, expression: i32, start: i32, end: i32, length: i32) {
    let literal: OmegaExpressionSyntax = self.parser.expressions[expression];
    assert literal.payload0 == start;
    assert literal.payload1 == end;
    assert literal.payload2 == length;
    transition literal.kind {
        OmegaExpressionKind::String -> return
        _ -> self.console.exit_process(1)
    }
}

// The same spelling can occur in more than one overload. Keep both signatures
// under their declaring trait and keep free machines in their own table.
machine Main::check_declared_domains(&mut self, source: &[u8]) {
    self.parser.parse_view(source);
    self.check_complete();
    assert self.parser.root_count == 3;
    assert self.parser.domain_count == 3;
    assert self.parser.requirement_count == 2;
    let raw: OmegaDomainSyntax = self.parser.domains[0];
    self.check_span(source, raw.name, "Raw");
    self.check_type_name(source, raw.carrier, "u8");
    assert raw.is_public == 0;
    assert raw.requirement_count == 0;
    let utf8: OmegaDomainSyntax = self.parser.domains[1];
    self.check_span(source, utf8.name, "Utf8");
    assert utf8.is_public == 1;
    assert utf8.start == raw.end + 1;
    assert utf8.first_requirement == 0;
    assert utf8.requirement_count == 1;
    assert self.parser.call_expression_count == 1;
    let checked: OmegaDomainSyntax = self.parser.domains[2];
    self.check_span(source, checked.name, "Checked");
    assert checked.first_requirement == 1;
    assert checked.requirement_count == 1;
    assert checked.end == source.len;
    assert self.parser.roots[1].item_index == 1;
    transition self.parser.roots[1].kind {
        OmegaRootKind::Domain -> slice(utf8.carrier)
        _ -> self.console.exit_process(1)
    }
    state slice(carrier: i32) {
        transition self.parser.type_references[carrier].kind {
            OmegaTypeReferenceKind::Slice -> element(carrier)
            _ -> self.console.exit_process(1)
        }
    }
    state element(carrier: i32) {
        self.check_type_name(source, self.parser.type_references[carrier].payload0, "u8");
    }
}

machine Main::check_boundary_traits(&mut self, source: &[u8]) {
    self.parser.parse_view(source);
    self.check_complete();
    assert self.parser.root_count == 3;
    assert self.parser.boundary_trait_count == 2;
    assert self.parser.boundary_requirement_count == 2;
    assert self.parser.machine_count == 1;
    assert self.parser.machine_state_count == 1;
    let service: OmegaBoundaryTraitSyntax = self.parser.boundary_traits[0];
    assert service.is_public == 1;
    assert service.first_requirement == 0;
    assert service.requirement_count == 2;
    self.check_span(source, service.name, "Service");
    self.check_span(source, service.boundary_keyword, "boundary");
    let other: OmegaBoundaryTraitSyntax = self.parser.boundary_traits[1];
    assert other.is_public == 0;
    assert other.first_requirement == 2;
    assert other.requirement_count == 0;
    self.check_span(source, other.name, "Other");
    let stop: OmegaBoundaryRequirementSyntax = self.parser.boundary_requirements[0];
    self.check_span(source, stop.name, "stop");
    assert stop.first_parameter == 0;
    assert stop.parameter_count == 1;
    assert stop.has_return_type == 1;
    self.check_span(source, self.parser.machine_parameters[0].name, "code");
    self.check_type_name(source, self.parser.machine_parameters[0].type_reference, "i32");
    self.check_type_name(source, stop.return_type, "Never");
    assert stop.first_clause == 0;
    assert stop.clause_count == 3;
    let overload: OmegaBoundaryRequirementSyntax = self.parser.boundary_requirements[1];
    self.check_span(source, overload.name, "stop");
    assert overload.parameter_count == 0;
    assert overload.has_return_type == 1;
    assert overload.clause_count == 0;
    self.check_type_name(source, overload.return_type, "u8");
    transition self.parser.roots[0].kind {
        OmegaRootKind::BoundaryTrait -> check_reach()
        _ -> self.console.exit_process(1)
    }
    state check_reach() {
        transition self.parser.machine_clauses[0].kind {
            OmegaMachineClauseKind::Reaches -> check_crash()
            _ -> self.console.exit_process(1)
        }
    }
    state check_crash() {
        transition self.parser.machine_clauses[1].kind {
            OmegaMachineClauseKind::CrashesNone -> check_progress()
            _ -> self.console.exit_process(1)
        }
    }
    state check_progress() {
        transition self.parser.machine_clauses[2].kind {
            OmegaMachineClauseKind::EventualTermination -> return
            _ -> self.console.exit_process(1)
        }
    }
}

machine Main::check_span(&mut self, source: &[u8], span: OmegaRelativeSpan, expected: &[u8]) {
    assert self.parser.scan.span_equals(source, span.start, span.end, expected) == 1;
}

machine Main::check_type_name(&mut self, source: &[u8], node: i32, expected: &[u8]) {
    let row: OmegaTypeReferenceSyntax = self.parser.type_references[node];
    transition row.kind {
        OmegaTypeReferenceKind::Named -> check_name(row)
        _ -> self.console.exit_process(1)
    }
    state check_name(type_row: OmegaTypeReferenceSyntax) {
        assert self.parser.scan.span_equals(source, type_row.payload0, type_row.payload1, expected) == 1;
    }
}

// Ordinary requirements and boundary requirements share signature storage.
// Each body owns a disjoint range; only the boundary enters service lookup.
machine Main::check_trait_owners(&mut self, source: &[u8]) {
    self.parser.parse_view(source);
    self.check_complete();
    assert self.parser.ordinary_trait_count == 2;
    assert self.parser.boundary_trait_count == 1;
    assert self.parser.boundary_requirement_count == 2;
    let ordinary: OmegaTraitSyntax = self.parser.ordinary_traits[0];
    let external: OmegaBoundaryTraitSyntax = self.parser.boundary_traits[0];
    let empty: OmegaTraitSyntax = self.parser.ordinary_traits[1];
    self.check_span(source, ordinary.keyword, "trait");
    self.check_span(source, ordinary.name, "Plain");
    self.check_span(source, external.boundary_keyword, "boundary");
    self.check_span(source, external.name, "External");
    assert ordinary.is_public == 1;
    assert ordinary.first_requirement == 0;
    assert ordinary.requirement_count == 1;
    assert external.first_requirement == 1;
    assert external.requirement_count == 1;
    assert empty.is_public == 0;
    assert empty.first_requirement == 2;
    assert empty.requirement_count == 0;
    assert self.parser.boundary_requirements[ordinary.first_requirement].parameter_count == 1;
    assert self.parser.boundary_requirements[external.first_requirement].parameter_count == 0;
    transition self.parser.roots[0].kind {
        OmegaRootKind::Trait -> return
        _ -> self.console.exit_process(1)
    }
}

machine Main::check_arm_condition(&mut self, source: &[u8]) {
    self.parser.parse_view(source);
    self.check_complete();
    assert self.parser.transition_statement_count == 2;
    let arm: OmegaTransitionStatementSyntax = self.parser.transition_statements[0];
    assert arm.has_subject == 0;
    assert self.parser.scan.span_equals(source, arm.guard_start, arm.guard_end, "x.kind == 0 || x.ready") == 1;
    transition arm.guard_kind {
        OmegaTransitionGuardKind::Predicate -> expression(self.parser.expressions[arm.guard_expression])
        _ -> self.console.exit_process(1)
    }
    state expression(row: OmegaExpressionSyntax) {
        transition row.kind {
            OmegaExpressionKind::Binary -> operation(self.parser.binary_expressions[row.payload0].operator)
            _ -> self.console.exit_process(1)
        }
    }
    state operation(kind: OmegaBinaryOperatorKind) {
        transition kind {
            OmegaBinaryOperatorKind::Or -> wildcard()
            _ -> self.console.exit_process(1)
        }
    }
    state wildcard() {
        transition self.parser.transition_statements[1].guard_kind {
            OmegaTransitionGuardKind::Always -> return
            _ -> self.console.exit_process(1)
        }
    }
}

machine Main::check_data_lifetime_names(&mut self, source: &[u8]) {
    self.parser.parse_view(source);
    self.check_complete();
    assert self.parser.data_count == 3;
    let rejection: OmegaDataSyntax = self.parser.data_items[0];
    let result: OmegaDataSyntax = self.parser.data_items[1];
    assert rejection.lifetime_count == 1;
    assert result.lifetime_count == 2;
    assert self.parser.data_items[2].lifetime_count == 0;
    self.check_span(source, self.parser.members[rejection.first_lifetime], "reason");
    self.check_span(source, self.parser.members[result.first_lifetime], "other");
    self.check_span(source, self.parser.members[result.first_lifetime + 1], "chosen");
    self.check_lifetime_payload(source, self.parser.data_payload_fields[0].type_reference, "chosen");
    self.check_lifetime_payload(source, self.parser.data_payload_fields[1].type_reference, "other");
    let reference: OmegaTypeReferenceSyntax = self.parser.type_references[self.parser.data_fields[0].type_reference];
    transition reference.kind {
        OmegaTypeReferenceKind::Reference -> reference_name(reference)
        _ -> self.console.exit_process(1)
    }
    state reference_name(row: OmegaTypeReferenceSyntax) {
        assert row.payload2 == 1;
        assert self.parser.scan.span_equals(source, row.payload3, row.payload4, "reason") == 1;
    }
}
machine Main::check_lifetime_payload(&mut self, source: &[u8], type_reference: i32, expected: &[u8]) {
    let row: OmegaTypeReferenceSyntax = self.parser.type_references[type_reference];
    transition row.kind {
        OmegaTypeReferenceKind::NamedWithLifetimes -> check(row)
        _ -> self.console.exit_process(1)
    }
    state check(application: OmegaTypeReferenceSyntax) {
        assert self.parser.scan.span_equals(source, application.payload0, application.payload1, "CallingPolicyRejection") == 1;
        assert application.payload3 == 1;
        self.check_span(source, self.parser.members[application.payload2], expected);
    }
}

machine Main::check_field_lifetime_order(&mut self, source: &[u8]) {
    self.parser.parse_view(source);
    self.check_complete();
    let array: OmegaTypeReferenceSyntax = self.parser.type_references[self.parser.data_fields[0].type_reference];
    transition array.kind {
        OmegaTypeReferenceKind::FixedArray -> element(self.parser.type_references[array.payload0])
        _ -> self.console.exit_process(1)
    }
    state element(row: OmegaTypeReferenceSyntax) {
        transition row.kind {
            OmegaTypeReferenceKind::NamedWithLifetimes -> order(row)
            _ -> self.console.exit_process(1)
        }
    }
    state order(application: OmegaTypeReferenceSyntax) {
        assert application.payload3 == 2;
        self.check_span(source, self.parser.members[application.payload2], "b");
        self.check_span(source, self.parser.members[application.payload2 + 1], "a");
    }
}

machine Main::check_trait_static_parameters(&mut self, source: &[u8]) {
    self.parser.parse_view(source);
    self.check_complete();
    assert self.parser.ordinary_trait_count == 3;
    assert self.parser.trait_static_parameter_count == 3;
    let calling: OmegaTraitSyntax = self.parser.ordinary_traits[0];
    let empty: OmegaTraitSyntax = self.parser.ordinary_traits[1];
    let separate: OmegaTraitSyntax = self.parser.ordinary_traits[2];
    assert calling.is_public == 1;
    assert calling.first_static_parameter == 0;
    assert calling.static_parameter_count == 2;
    assert calling.requirement_count == 1;
    assert empty.static_parameter_count == 0;
    assert separate.first_static_parameter == 2;
    assert separate.static_parameter_count == 1;
    self.check_trait_static_parameter(source, 0, "Policy", "CallingPolicy");
    self.check_trait_static_parameter(source, 1, "Limit", "u64");
    self.check_trait_static_parameter(source, 2, "Policy", "Other");
}

machine Main::check_trait_static_parameter(&mut self, source: &[u8], slot: i32, name: &[u8], declared_type: &[u8]) {
    let parameter: OmegaTraitStaticParameterSyntax = self.parser.trait_static_parameters[slot];
    self.check_span(source, parameter.name, name);
    self.check_type_name(source, parameter.type_reference, declared_type);
}

machine Main::check_retired_trait_binder(&mut self) {
    transition self.parser.diagnostic_code {
        OmegaParseDiagnosticCode::RetiredTraitEvidenceBinder -> return
        _ -> self.console.exit_process(1)
    }
}

// A boundary requirement, an ordinary trait member and a free machine each
// own their authored entry names. Repeated rows preserve distinct identities.
machine Main::check_invokes_rows(&mut self, source: &[u8]) {
    self.parser.parse_view(source);
    self.check_complete();
    let sleep: OmegaBoundaryRequirementSyntax = self.parser.boundary_requirements[0];
    assert sleep.first_clause == 0;
    assert sleep.clause_count == 5;
    assert self.parser.boundary_requirements[1].clause_count == 0;
    assert self.parser.boundary_requirements[2].first_clause == 5;
    assert self.parser.boundary_requirements[2].clause_count == 1;
    assert self.parser.machine_items[0].first_clause == 6;
    assert self.parser.machine_items[0].clause_count == 1;
    self.check_invokes_row(source, 1, "Raw");
    self.check_invokes_row(source, 2, "Other");
    self.check_invokes_row(source, 5, "First");
    self.check_invokes_row(source, 6, "Last");

    // Clause and name storage both stop exactly before the first absent slot.
    self.parser.parse_view("");
    self.parser.machine_clause_count = 16384;
    self.parser.append_unit("machine f() invokes Entry {}", 0);
    self.check_full_path_arena(20, 25);
    self.parser.parse_view("");
    self.parser.member_count = 16383;
    self.parser.append_unit("machine f() invokes Entry {}", 0);
    self.check_full_path_arena(20, 25);
}

machine Main::check_invokes_row(&mut self, source: &[u8], index: i32, expected: &[u8]) {
    let row: OmegaMachineClauseSyntax = self.parser.machine_clauses[index];
    transition row.kind {
        OmegaMachineClauseKind::Invokes -> entry(row)
        _ -> self.console.exit_process(1)
    }
    state entry(clause: OmegaMachineClauseSyntax) {
        assert clause.member_count == 1;
        assert self.parser.scan.span_equals(source, clause.start, clause.start + 7, "invokes") == 1;
        let name: OmegaRelativeSpan = self.parser.members[clause.first_member];
        self.check_span(source, name, expected);
        assert clause.end == name.end;
    }
}
