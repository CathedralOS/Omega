// Diagnostic layer-0 customer. Match D's real array-backed source input.
// Modes: 0 startup only, 1 read/report only, 2 read/parse/report each unit.
boundary trait Console {
    machine exit_process(return_code: i32) -> never;
    machine write_byte(value: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}

data Main {
    console: Console;
    parser: OmegaParser;
    source: [u8; 131072];
    mode: i32;
    length: i32;
    cursor: i32;
    status: i32;
}

machine Main::main(&mut self) {
    self.mode = self.console.read_byte();
    self.console.write_byte(76);
    self.console.write_byte(48);
    transition self.mode {
        0 -> finish()
        1 -> header()
        2 -> header()
        _ -> self.console.exit_process(1)
    }

    state header() {
        self.length = self.read_integer();
        self.cursor = 0;
        transition self.length == 0 {
            true -> finish()
            _ -> length_bound()
        }
    }

    state length_bound() {
        transition (self.length > 0) && (self.length <= 131072) {
            true -> read()
            _ -> self.console.exit_process(3)
        }
    }

    state read() {
        transition self.cursor < self.length {
            true -> byte()
            _ -> loaded()
        }
    }

    state byte() {
        let value: i32 = self.console.read_byte();
        transition value >= 0 {
            true -> retain(value)
            _ -> self.console.exit_process(1)
        }
    }

    state retain(value: i32) {
        self.source[self.cursor] = value;
        self.cursor = self.cursor + 1;
        transition true { true -> read() }
    }

    state loaded() {
        self.status = 0;
        transition self.mode == 2 {
            true -> parse()
            _ -> publish()
        }
    }

    state parse() {
        self.console.write_byte(240);
        self.parser.parse_view(self.source.as_slice[0..self.length]);
        self.console.write_byte(241);
        transition self.parser.status {
            OmegaParserStatus::Complete -> result(1)
            OmegaParserStatus::LexicalFailure -> result(2)
            OmegaParserStatus::SyntaxFailure -> result(3)
            OmegaParserStatus::Incomplete -> result(4)
            OmegaParserStatus::ResourceFailure -> result(5)
            _ -> result(6)
        }
    }

    state result(status: i32) {
        self.status = status;
        transition true { true -> publish() }
    }

    state publish() {
        self.write_integer(self.length);
        self.write_integer(self.status);
        self.write_integer(self.parser.cursor);
        self.write_integer(self.parser.diagnostic_start);
        self.write_integer(self.parser.diagnostic_end);
        self.write_integer(self.parser.incomplete_start);
        self.write_integer(self.parser.incomplete_end);
        self.write_integer(self.parser.resource_limit);
        self.write_integer(self.parser.resource_requested);
        self.write_integer(self.parser.root_count);
        transition true { true -> header() }
    }

    state finish() {
        let trailing: i32 = self.console.read_byte();
        transition trailing == -1 {
            true -> complete()
            _ -> self.console.exit_process(1)
        }
    }

    state complete() {
        self.console.write_byte(69);
    }
}

machine Main::read_integer(&mut self) -> i32 {
    let first: i32 = self.console.read_byte();
    let second: i32 = self.console.read_byte();
    let third: i32 = self.console.read_byte();
    let fourth: i32 = self.console.read_byte();
    transition (first >= 0) && (second >= 0) && (third >= 0) && (fourth == 0) {
        true -> return first + second * 256 + third * 65536
        _ -> self.console.exit_process(1)
    }
}

machine Main::write_integer(&mut self, value: i32) {
    self.console.write_byte(value % 256);
    self.console.write_byte((value / 256) % 256);
    self.console.write_byte((value / 65536) % 256);
    self.console.write_byte((value / 16777216) % 256);
}
