    self.check_call_expression(self.parser.binary_expressions[0].left, 1);
}
machine Main::check_range_flags(&mut self, row:i32, start:i32, end:i32, inclusive:i32) {
    assert self.parser.range_expressions[row].has_start == start;
    assert self.parser.range_expressions[row].has_end == end;
    assert self.parser.range_expressions[row].end_inclusive == inclusive;
    let index:i32 = self.parser.indexed_expressions[row].index;
    assert self.parser.expressions[index].payload0 == row;
    transition self.parser.expressions[index].kind {
        OmegaExpressionKind::Range -> return
        _ -> self.console.exit_process(1)
    }
}
machine Main::check_index_prefix_context(&mut self) {
    self.check_complete(); self.check_call_stacks_empty();
    assert self.parser.indexed_expression_count == 2;
    assert self.parser.call_expression_count == 3;
    assert self.parser.call_argument_count == 1;
    assert self.parser.unary_expression_count == 1;
    assert self.parser.binary_expression_count == 1;
    self.check_call_expression(self.parser.indexed_expressions[0].index, 0);
    self.check_call_expression(self.parser.indexed_expressions[1].index, 1);
    self.check_index_expression(self.parser.call_arguments[0], 1);
    self.check_index_expression(self.parser.binary_expressions[0].left, 0);
    self.check_call_expression(self.parser.binary_expressions[0].right, 2);
    let operand:i32 = self.parser.unary_expressions[0].operand;
    transition self.parser.expressions[operand].kind {
        OmegaExpressionKind::Binary -> return
        _ -> self.console.exit_process(1)
    }
}
machine Main::check_grouped_assignment(&mut self) {
    self.check_complete(); self.check_call_stacks_empty();
    assert self.parser.call_statement_count == 1;
    assert self.parser.call_expression_count == 1;
    assert self.parser.assignment_statement_count == 1;
    assert self.parser.assignment_statements[0].start == 23;
    self.check_call_expression(self.parser.assignment_statements[0].value, 0);
    transition self.parser.expressions[self.parser.assignment_statements[0].target].kind {
        OmegaExpressionKind::Path -> return
        _ -> self.console.exit_process(1)
    }
}
machine Main::check_missing_index_range_end(&mut self) {
    transition self.parser.status {
        OmegaParserStatus::SyntaxFailure -> diagnostic()
        _ -> self.console.exit_process(1)
    }
    state diagnostic() {
        assert self.parser.diagnostic_start == 33;
        assert self.parser.diagnostic_end == 34;
        transition self.parser.diagnostic_code {
            OmegaParseDiagnosticCode::ExpectedIndexedRangeEnd -> return
            _ -> self.console.exit_process(1)
        }
    }
}
machine Main::check_lexical_index_failure(&mut self) {
    assert self.parser.diagnostic_start == 25;
    assert self.parser.diagnostic_end == 26;
    transition self.parser.status {
        OmegaParserStatus::LexicalFailure -> return
        _ -> self.console.exit_process(1)
    }
}
machine Main::check_index_reset(&mut self) {
    self.check_complete(); self.check_call_stacks_empty();
    assert self.parser.assignment_statement_count == 1;
    assert self.parser.indexed_expression_count == 1;
    assert self.parser.range_expression_count == 0;
    assert self.parser.cast_expression_count == 0;
    assert self.parser.call_expression_count == 0;
    assert self.parser.expression_prefix_count == 0;
    self.check_index_expression(self.parser.assignment_statements[0].target, 0);
}
