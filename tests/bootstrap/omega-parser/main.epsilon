    assert self.parser.transition_statements[2].subject == self.parser.transition_statements[3].subject;
    transition self.parser.expressions[self.parser.transition_statements[0].subject].kind {
        OmegaExpressionKind::Binary -> direct()
        _ -> self.console.exit_process(1)
    }
    state direct() {
        transition self.parser.expressions[self.parser.transition_statements[2].subject].kind {
            OmegaExpressionKind::Call -> return
            _ -> self.console.exit_process(1)
        }
    }
}

machine Main::check_borrow_node(&mut self, expression: i32, access: i32) {
    transition self.parser.expressions[expression].kind {
        OmegaExpressionKind::Borrow -> row()
        _ -> self.console.exit_process(1)
    }
    state row() {
        assert self.parser.expressions[expression].payload0 < expression;
        assert self.parser.expressions[expression].payload1 == access;
        assert self.parser.expressions[expression].payload3 > self.parser.expressions[expression].payload2;
        assert self.parser.expressions[expression].payload4 == 0;
        assert self.parser.expressions[expression].payload5 == 0;
    }
}
machine Main::check_borrow_argument(&mut self, offset: i32, access: i32) {
    let first: i32 = self.parser.call_statements[0].first_argument;
    self.check_borrow_node(self.parser.call_arguments[first + offset], access);
}
