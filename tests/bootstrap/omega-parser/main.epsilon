boundary trait Console {
    machine exit_process(return_code: i32) -> never;
    machine write_byte(value: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}

data Main {
    console: Console;
    parser: OmegaParser;
}

machine Main::main(&mut self) {
    self.parser.parse_view("data R requires b <= 9 { a: [u8; 2]; b: u32; c: &u8; d: u32 in Domain; }");
    self.check_data_rows();

    self.parser.parse_view("machine p() { x = 7; y = Packet { tag: 1 }; z = value as +Trapping; transition 1 { 1 -> done() } machine done() {} }");
    self.check_machine_rows();

    self.parser.parse_view("machine p(scalar: u32 in Trapping) -> bool { transition scalar == 95 { true -> true _ -> other(scalar) } machine other(value: u32 in Trapping) -> bool { transition value < 128 { true -> false _ -> true } } }");
    self.check_transition_results();

    // The retired declaration is not an alias; the word remains an identifier.
    self.parser.parse_view("machine p() { state old() {} }");
    self.check_refused();
    self.parser.parse_view("machine state() -> bool { true }");
    self.check_complete();

    // A prior Result arm must not classify a later invocation's machine call.
    self.parser.parse_view("machine p() { transition { _ -> done(7) } machine done(value: u32) {} }");
    self.check_complete();
    self.check_machine_target(0, 1);

    self.parser.parse_view("machine ext() satisfies Service::f via Binding::CompilerIntrinsic;");
    self.check_external_rows();

    self.parser.parse_view("machine p() terminates by n -> Ordinal::Down reaches Console {}");
    self.check_header_rows(0, 1, 44, 60);

    self.parser.parse_view("machine p() reaches Console terminates by n -> Ordinal::Down {}");
    self.check_header_rows(1, 0, 60, 27);

    self.parser.parse_view("machine p() terminates by n -> Ordinal::Down; {}");
    self.check_incomplete(44, 45);

    self.parser.parse_view("machine p() reaches Console; {}");
    self.check_incomplete(27, 28);

    // A previous complete clause must not satisfy this invocation's count guard.
    self.parser.parse_view("machine p() via Binding::CompilerIntrinsic;");
    self.check_incomplete(12, 15);

    self.parser.parse_view("machine p() { x = 0x1; }");
    self.check_incomplete(18, 21);

    self.parser.parse_view("data R { a: [u8; 0x2]; }");
    self.check_incomplete(17, 20);

    self.parser.parse_view("data R { a: u32 [0x0..=9]; }");
    self.check_suffix_refused(16, 17);

    self.parser.parse_view("data R { a: u32 [0..=0x9]; }");
    self.check_suffix_refused(16, 17);

    self.parser.parse_view("machine p() { transition 1 { 0x1 -> done() } machine done() {} }");
    self.check_incomplete(29, 32);

    self.parser.parse_view("machine p() { x = self { tag: 1 }; }");
    self.check_incomplete(23, 24);

    self.parser.parse_view("machine p() { x = value as &u8; }");
    self.check_incomplete(27, 28);

    self.parser.parse_view("data Bound [copy] requires self.b > 0 requires self.b in Positive requires b <= (3 + 6) || false { b: u32; } data Plain { value: u32; } data Flag requires ready { ready: bool; }");
    self.check_requirement_owners();

    self.parser.parse_view("data Missing requires { value: u32; }");
    self.check_requirement_refused(22, 23);
    self.parser.parse_view("data Missing requires");
    self.check_requirement_refused(21, 21);
    self.parser.parse_view("data Missing requires value <=");
    self.check_requirement_refused(30, 30);

    // Calls retain their surrounding operators, prefixes and groups while
    // argument parsing temporarily reuses the active expression stacks.
    self.parser.parse_view("machine p() { let x: bool = !(f(1) < g(2)) && h(); }");
    self.check_complete();
    assert self.parser.call_expression_count == 3;
    assert self.parser.binary_expression_count == 2;
    assert self.parser.unary_expression_count == 1;
    self.check_call_stacks_empty();
    self.parser.parse_view("machine p() { let x: u8 = f(g(1) + h(2), i(3)); }");
    self.check_nested_call_rows();
    self.parser.parse_view("machine p() { let x: u8 = pick<Type>(1); }");
    self.check_complete();
    assert self.parser.call_expression_count == 1;
    assert self.parser.call_expressions[0].machine_argument_count == 1;
    assert self.parser.call_expressions[0].argument_count == 1;
    self.check_call_stacks_empty();

    self.parser.parse_view("machine p() { let x: u32 in Trapping = 65 as +Trapping; let y: u32 = x as -Trapping; let z: u32 = (7 as u32); }");
    self.check_complete();
    assert self.parser.cast_expression_count == 3;
    assert self.parser.type_reference_count == 5;
    self.check_cast_kind(0, 1);
    self.check_cast_kind(1, 2);
    self.check_cast_kind(2, 0);
    self.parser.parse_view("machine p() { let x: u32 = value as +Policy::Trapping; }");
    self.check_complete();
    self.check_cast_kind(0, 1);
    assert self.parser.cast_expressions[0].domain.end -
        self.parser.cast_expressions[0].domain.start == 16;

    // Retired whole-type domain casts and unsupported multi-entry casts must
    // not become successful casts or accidental arithmetic expressions.
    self.parser.parse_view("machine p() { x = value as u32 in Trapping; }");
    self.check_refused();
    self.parser.parse_view("machine p() { x = value as +Trapping -Other; }");
    self.check_refused();
    self.parser.parse_view("machine p() { x = value as u32 +Trapping; }");
    self.check_refused();
    self.parser.parse_view("machine p() { x = value as =Trapping; }");
    self.check_incomplete(27, 28);
    self.parser.parse_view("machine p() { x = value as +");
    self.check_refused();
    self.parser.parse_view("machine p() { let x: bool = scalar < @; }");
    self.check_lexical_failure();

    // Reusing the same receiver after failures must rebuild the same live rows.
    self.parser.parse_view("data R requires b <= 9 { a: [u8; 2]; b: u32; c: &u8; d: u32 in Domain; }");
    self.check_data_rows();
    self.parser.parse_view("machine logical() -> bool { !false } machine negative() -> u8 { -1 } machine inverted() -> u8 { ~1 }");
    self.check_complete();
    assert self.parser.machine_count == 3;
    assert self.parser.unary_expression_count == 3;
    assert self.parser.expression_prefix_count == 0;
    assert self.parser.expression_group_count == 0;
    self.check_call_stacks_empty();

    self.parser.parse_view("machine p() -> bool { transition !f(1) && g(h(2)) { true -> true _ -> false } } machine q() -> bool { transition compare(47) { true -> true _ -> false } }");
    self.check_subject_call_rows();

    // These declarations and clear body are exact canonical source bytes;
    // the ordinary caller adds no parser-specific recognition or lowering.
    self.parser.parse_view("public data SourceId [copy] {\n    value: u32 in Trapping;\n}\n\n\npublic data SourceUnit\nrequires\n    length <= 131072,\n{\n    id: SourceId;\n    bytes: [u8; 131072] in Trapping;\n    length: u64;\n    last_retained: bool;\n}\n\n\nmachine source_unit_clear(source_unit: &mut SourceUnit, id: SourceId) {\n    source_unit.id = id;\n    source_unit.length = 0;\n    source_unit.last_retained = true;\n}\n\nmachine caller() { let mut unit: SourceUnit; let id: SourceId = SourceId { value: 42 as +Trapping }; source_unit_clear(&mut unit, id); }");
    self.check_source_unit_clear_rows();

    self.parser.parse_view("machine p() { take(&value, &mut value, &write value); }");
    self.check_complete();
    assert self.parser.call_statement_count == 1;
    assert self.parser.unary_expression_count == 0;
    self.check_borrow_argument(0, 0);
    self.check_borrow_argument(1, 1);
    self.check_borrow_argument(2, 2);

    self.parser.parse_view("machine p() { take(&mut value as -Trapping); }");
    self.check_borrow_cast(0);

    self.parser.parse_view("machine p() { take(&mut items[0] as -Trapping); }");
    self.check_borrow_cast(1);

    self.parser.parse_view("machine p() { take(&mut (value as -Trapping)); }");
    self.check_cast_inside_borrow();

    self.parser.parse_view("machine p() { take(!&value as -Trapping); }");
    self.check_outer_unary_borrow_cast();

    self.parser.parse_view("machine p() -> &u8 { &value }");
    self.check_complete();
    assert self.parser.statement_count == 1;
    self.check_borrow_node(self.parser.statements[0].item_index, 0);

    self.parser.parse_view("machine p() { take(&");
    self.check_syntax_refused(20, 20);

    self.parser.parse_view("machine p() { take(&mut ; }");
    self.check_refused();

    self.parser.parse_view("machine p() { take(value); }");
    self.check_complete();
    self.check_call_stacks_empty();
    assert self.parser.expression_prefix_count == 0;
    assert self.parser.cast_expression_count == 0;
    self.check_plain_call_argument();

    self.parser.parse_view("data D requires first <= 4, second <= 8, { first: u8; second: u8; }");
    self.check_complete();
    assert self.parser.data_items[0].requirement_count == 2;
    assert self.parser.binary_expression_count == 2;
    assert self.parser.data_requirements[0].end < self.parser.data_requirements[1].start;

    self.parser.parse_view("data D requires first <= 4,, { first: u8; }");
    self.check_refused();

    self.parser.parse_view("machine outer() { machine helper() {} }");
    self.check_empty_unit_entry();

    // Nested literals publish only their own contiguous fields. A child may
    // finish first without becoming a field of its parent's row interval.
    self.parser.parse_view("machine p() { let packet: Packet = Packet { left: Leaf {word:1 as +Trapping}, right: Leaf {word:9 as +Trapping} }; }");
    self.check_nested_record_literals();

    self.parser.parse_view("machine make(x:u32 in Trapping)->Leaf { Leaf {word:x} }");
    self.check_complete();
    self.check_call_stacks_empty();
    assert self.parser.struct_literal_count == 1;
    assert self.parser.struct_literal_field_count == 1;
    assert self.parser.machine_states[0].statement_count == 1;
    self.check_record_expression(self.parser.statements[0].item_index, 0);

    self.parser.parse_view("machine p() { consume(7, Packet {left:make(1), right:make(9)}, 11); }");
    self.check_record_field_calls();

    self.parser.parse_view("machine p() { target = Pair { left: Empty {}, right: Empty {} }; }");
    self.check_complete();
    self.check_call_stacks_empty();
    assert self.parser.struct_literal_count == 3;
    assert self.parser.struct_literal_field_count == 2;
    assert self.parser.struct_literals[0].field_count == 0;
    assert self.parser.struct_literals[1].field_count == 0;
    assert self.parser.struct_literals[2].first_field == 0;
    assert self.parser.struct_literals[2].field_count == 2;
    self.check_record_expression(self.parser.assignment_statements[0].value, 2);
    self.check_record_expression(self.parser.struct_literal_fields[0].value, 0);
    self.check_record_expression(self.parser.struct_literal_fields[1].value, 1);

    self.parser.parse_view("machine p() { take(&mut Packet {left:(7 + read()), right:!false}); }");
    self.check_record_field_frames();

    self.parser.parse_view("machine p() { take(Packet {left: Leaf {word:}, right: Leaf {word:9}}); }");
    self.check_refused();
    self.parser.parse_view("machine p() { take(Packet {left: Leaf {word:1}");
    self.check_refused();

    self.parser.parse_view("machine p() { let x: R = R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: R { a: 0 } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } } }; }");
    self.check_expression_depth_refused();

    // A failed nested parse must not leak lists, call headers, or saved stacks.
    self.parser.parse_view("machine make()->Empty { Empty {} }");
    self.check_complete();
    self.check_call_stacks_empty();
    assert self.parser.struct_literal_count == 1;
    assert self.parser.struct_literal_field_count == 0;
    assert self.parser.pending_struct_field_count == 0;
    self.check_record_expression(self.parser.statements[0].item_index, 0);

    // A domain-removal view keeps its borrow and cast below the indexed
    // place; the selector owns a fresh expression frame.
    self.parser.parse_view("machine append(source_unit:&mut SourceUnit, byte:u8) { (&mut source_unit.bytes as -Trapping)[source_unit.length] = byte; } machine read(source_unit:&SourceUnit, index:u64 in Trapping)->u8 { (&source_unit.bytes as -Trapping)[index as -Trapping] }");
    self.check_domain_view_indices();

    self.parser.parse_view("machine p(){ before(); ((&mut matrix as -D)[rows[next((offset() + 1))]])[column()] = value(); }");
    self.check_nested_index_custody();

    self.parser.parse_view("machine p(){ consume(7, Packet { value: (&array as -D)[(next() as -D)] }, 9); }");
    self.check_record_index_context();

    self.parser.parse_view("machine p(){ make()[index()] = value(); } machine read()->u8 { make()[index()] }");
    self.check_factory_indices();

    self.parser.parse_view("machine p(){ array[(lo() + rows[i]) * (hi as u64)] = value; }");
    self.check_index_operators();

    self.parser.parse_view("machine p(){ let a:R = array[1..3]; let b:R = array[..3]; let c:R = array[..]; let d:R = array[1..]; let e:R = array[1..=3]; let f:R = array[lo()..(hi() - 1)]; }");
    self.check_index_ranges();

    self.parser.parse_view("machine p(){ let yes:bool = !(flags[choose()] && check(bits[other()])); }");
    self.check_index_prefix_context();

    self.parser.parse_view("machine p(){ before(); (value) = next(); }");
    self.check_grouped_assignment();

    self.parser.parse_view("machine p(){ array[rows[next()] = value; }");
    self.check_refused();
    self.parser.parse_view("machine p(){ (array[index] = value); }");
    self.check_refused();
    self.parser.parse_view("machine p(){ array[] = value; }");
    self.check_refused();
    self.parser.parse_view("machine p(){ (array)[index] = ; }");
    self.check_refused();
    self.parser.parse_view("machine p(){ array[1..2..3] = value; }");
    self.check_refused();
    self.parser.parse_view("machine p(){ array[(next()");
    self.check_refused();

    self.parser.parse_view("machine p(){ let x:R = array[1..=]; }");
    self.check_missing_index_range_end();
    self.parser.parse_view("machine p(){ array[index ` 1] = value; }");
    self.check_lexical_index_failure();
    self.parser.parse_view("machine p(){ let x:u8 = array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[array[0]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]; }");
    self.check_expression_depth_refused();
    self.parser.parse_view("machine p(){ array[index] = value; }");
    self.check_index_reset();

    self.console.write_byte(65);
}

machine Main::check_complete(&mut self) {
    transition self.parser.status {
        OmegaParserStatus::Complete -> return
        _ -> self.console.exit_process(1)
    }
}

machine Main::check_incomplete(&mut self, start: i32, end: i32) {
    transition self.parser.status {
        OmegaParserStatus::Incomplete -> coordinates()
        _ -> self.console.exit_process(1)
    }

    state coordinates() {
        assert self.parser.incomplete_start == start;
        assert self.parser.incomplete_end == end;
    }
}

machine Main::check_data_rows(&mut self) {
    self.check_complete();
    assert self.parser.root_count == 1;
    assert self.parser.data_count == 1;
    assert self.parser.machine_count == 0;
    assert self.parser.data_field_count == 4;
    assert self.parser.type_reference_count == 7;
    assert self.parser.type_constraint_count == 1;
    assert self.parser.statement_count == 0;
    assert self.parser.data_fields[0].type_reference == 1;
    assert self.parser.data_fields[1].type_reference == 2;
    assert self.parser.data_fields[2].type_reference == 4;
    assert self.parser.data_fields[3].type_reference == 6;
    assert self.parser.type_references[1].payload0 == 0;
    assert self.parser.type_references[2].payload0 == 40;
    assert self.parser.type_references[2].payload1 == 43;
    assert self.parser.type_references[4].payload0 == 3;
    assert self.parser.type_references[4].payload1 == 0;
    assert self.parser.type_references[6].payload0 == 5;
    assert self.parser.type_references[6].payload1 == 0;
    assert self.parser.type_references[6].payload2 == 1;
    assert self.parser.type_constraints[0].path_member_count == 1;
    assert self.parser.members[self.parser.type_constraints[0].first_path_member].start == 63;
    assert self.parser.members[self.parser.type_constraints[0].first_path_member].end == 69;
    assert self.parser.data_requirement_count == 1;
    assert self.parser.data_items[0].first_requirement == 0;
    assert self.parser.data_items[0].requirement_count == 1;
    assert self.parser.data_requirements[0].expression == 2;
    assert self.parser.data_requirements[0].start == 7;
    assert self.parser.data_requirements[0].end == 22;
    assert self.parser.expression_count == 3;
    assert self.parser.binary_expression_count == 1;
    assert self.parser.binary_expressions[0].left == 0;
    assert self.parser.binary_expressions[0].right == 1;
    assert self.parser.binary_expressions[0].operator_start == 18;
    assert self.parser.binary_expressions[0].operator_end == 20;
    assert self.parser.expressions[0].payload1 == 1;
    assert self.parser.members[self.parser.expressions[0].payload0].start == 16;
    assert self.parser.members[self.parser.expressions[0].payload0].end == 17;
    assert self.parser.expressions[1].payload0 == 21;
    assert self.parser.expressions[1].payload1 == 22;
    transition self.parser.binary_expressions[0].operator {
        OmegaBinaryOperatorKind::LessEqual -> return
        _ -> self.console.exit_process(1)
    }
}

machine Main::check_requirement_owners(&mut self) {
    self.check_complete();
    assert self.parser.root_count == 3;
    assert self.parser.data_count == 3;
    assert self.parser.data_requirement_count == 4;
    assert self.parser.data_items[0].first_requirement == 0;
    assert self.parser.data_items[0].requirement_count == 3;
    assert self.parser.data_items[1].first_requirement == 3;
    assert self.parser.data_items[1].requirement_count == 0;
    assert self.parser.data_items[2].first_requirement == 3;
    assert self.parser.data_items[2].requirement_count == 1;
    assert self.parser.expression_count == 13;
    assert self.parser.binary_expression_count == 4;
    assert self.parser.data_requirements[0].expression == 2;
    assert self.parser.data_requirements[1].expression == 4;
    assert self.parser.data_requirements[2].expression == 11;
    assert self.parser.data_requirements[3].expression == 12;
    assert self.parser.binary_expressions[2].right == 8;
    assert self.parser.binary_expressions[3].left == 9;
    assert self.parser.binary_expressions[3].right == 10;
    assert self.parser.expressions[0].payload1 == 2;
    assert self.parser.expressions[0].payload2 == 1;
    assert self.parser.members[self.parser.expressions[0].payload0].start == 27;
    assert self.parser.members[self.parser.expressions[0].payload0].end == 31;
    assert self.parser.members[self.parser.expressions[0].payload0 + 1].start == 32;
    assert self.parser.members[self.parser.expressions[0].payload0 + 1].end == 33;
    assert self.parser.expressions[4].payload0 == 3;
    assert self.parser.expressions[4].payload2 == 1;
    transition self.parser.binary_expressions[0].operator {
        OmegaBinaryOperatorKind::Greater -> addition()
        _ -> self.console.exit_process(1)
    }
    state addition() {
        transition self.parser.binary_expressions[1].operator {
            OmegaBinaryOperatorKind::Add -> comparison()
            _ -> self.console.exit_process(1)
        }
    }
    state comparison() {
        transition self.parser.binary_expressions[2].operator {
            OmegaBinaryOperatorKind::LessEqual -> logical()
            _ -> self.console.exit_process(1)
        }
    }
    state logical() {
        transition self.parser.binary_expressions[3].operator {
            OmegaBinaryOperatorKind::Or -> self_path()
            _ -> self.console.exit_process(1)
        }
    }
    state self_path() {
        transition self.parser.expressions[0].path_kind {
            OmegaPathExpressionKind::Member -> membership()
            _ -> self.console.exit_process(1)
        }
    }
    state membership() {
        transition self.parser.expressions[4].kind {
            OmegaExpressionKind::Membership -> return
            _ -> self.console.exit_process(1)
        }
    }
}

machine Main::check_suffix_refused(&mut self, start: i32, end: i32) {
    transition self.parser.diagnostic_code {
        OmegaParseDiagnosticCode::UnexpectedTypeSuffix -> coordinates()
        _ -> self.console.exit_process(1)
    }
    state coordinates() {
        self.check_syntax_refused(start, end);
    }
}

machine Main::check_requirement_refused(&mut self, start: i32, end: i32) {
    transition self.parser.diagnostic_code {
        OmegaParseDiagnosticCode::ExpectedDataRequirement -> coordinates()
        _ -> self.console.exit_process(1)
    }
    state coordinates() {
        self.check_syntax_refused(start, end);
    }
}

machine Main::check_syntax_refused(&mut self, start: i32, end: i32) {
    transition self.parser.status {
        OmegaParserStatus::SyntaxFailure -> coordinates()
        _ -> self.console.exit_process(1)
    }
    state coordinates() {
        assert self.parser.diagnostic_start == start;
        assert self.parser.diagnostic_end == end;
    }
}

machine Main::check_machine_rows(&mut self) {
    self.check_complete();
    assert self.parser.root_count == 1;
    assert self.parser.data_count == 0;
    assert self.parser.machine_count == 1;
    assert self.parser.machine_state_count == 2;
    assert self.parser.assignment_statement_count == 3;
    assert self.parser.transition_statement_count == 1;
    assert self.parser.statement_count == 4;
    assert self.parser.expression_count == 9;
    assert self.parser.struct_literal_count == 1;
    assert self.parser.struct_literal_field_count == 1;
    assert self.parser.cast_expression_count == 1;
    assert self.parser.type_reference_count == 0;
    assert self.parser.type_constraint_count == 0;
    self.check_cast_kind(0, 1);
}

machine Main::check_transition_results(&mut self) {
    self.check_complete();
    assert self.parser.machine_state_count == 2;
    assert self.parser.machine_parameter_count == 2;
    assert self.parser.machine_states[0].parameter_count == 1;
    assert self.parser.machine_states[1].parameter_count == 1;
    assert self.parser.transition_statement_count == 4;
    self.check_result_target(0, 1);
    self.check_machine_target(1, 1);
    self.check_result_target(2, 0);
    self.check_result_target(3, 1);
}

machine Main::check_result_target(&mut self, index: i32, value: i32) {
    transition self.parser.transition_statements[index].target_kind {
        OmegaTransitionTargetKind::Result -> result()
        _ -> self.console.exit_process(1)
    }
    state result() {
        assert self.parser.transition_statements[index].argument_count == 0;
        assert self.parser.transition_statements[index].target.start == 0;
        assert self.parser.transition_statements[index].target.end == 0;
        let expression: i32 = self.parser.transition_statements[index].result_expression;
        assert self.parser.expressions[expression].payload0 == value;
        transition self.parser.expressions[expression].kind {
            OmegaExpressionKind::Boolean -> return
            _ -> self.console.exit_process(1)
        }
    }
}

machine Main::check_machine_target(&mut self, index: i32, arguments: i32) {
    transition self.parser.transition_statements[index].target_kind {
        OmegaTransitionTargetKind::Machine -> machine_target()
        _ -> self.console.exit_process(1)
    }
    state machine_target() {
        assert self.parser.transition_statements[index].result_expression == 0;
        assert self.parser.transition_statements[index].argument_count == arguments;
        assert self.parser.transition_statements[index].target.end >
            self.parser.transition_statements[index].target.start;
    }
}

machine Main::check_refused(&mut self) {
    transition self.parser.status {
        OmegaParserStatus::Incomplete -> return
        OmegaParserStatus::SyntaxFailure -> return
        _ -> self.console.exit_process(1)
    }
}

machine Main::check_external_rows(&mut self) {
    self.check_complete();
    assert self.parser.root_count == 1;
    assert self.parser.data_count == 0;
    assert self.parser.machine_count == 1;
    assert self.parser.machine_state_count == 1;
    assert self.parser.machine_clause_count == 1;
    assert self.parser.statement_count == 0;
    assert self.parser.machine_items[0].is_bodyless == 1;
    assert self.parser.machine_clauses[0].has_external_binding == 1;
    transition self.parser.machine_clauses[0].kind {
        OmegaMachineClauseKind::Satisfies -> binding()
        _ -> self.console.exit_process(1)
    }

    state binding() {
        transition self.parser.machine_clauses[0].external_binding_kind {
            OmegaExternalBindingKind::CompilerIntrinsic -> return
        }
    }
}

// Supported callable clauses retain their exact subject/view and service
// ranges while the declaration owns the body boundary. Reverse ordering
// exercises both continuations through the shared header owner.
machine Main::check_header_rows(&mut self, termination: i32, reached: i32, termination_end: i32, reaches_end: i32) {
    self.check_complete();
    assert self.parser.root_count == 1;
    assert self.parser.machine_count == 1;
    assert self.parser.machine_state_count == 1;
    assert self.parser.machine_clause_count == 2;
    assert self.parser.machine_items[0].first_clause == 0;
    assert self.parser.machine_items[0].clause_count == 2;
    assert self.parser.machine_clauses[termination].member_count == 1;
    assert self.parser.machine_clauses[termination].view_member_count == 2;
    assert self.parser.machine_clauses[termination].end == termination_end;
    assert self.parser.machine_clauses[reached].member_count == 1;
    assert self.parser.machine_clauses[reached].end == reaches_end;
    transition self.parser.machine_clauses[termination].kind {
        OmegaMachineClauseKind::Terminates -> service(reached)
        _ -> self.console.exit_process(1)
    }
    state service(service_index: i32) {
        transition self.parser.machine_clauses[service_index].kind {
            OmegaMachineClauseKind::Reaches -> return
            _ -> self.console.exit_process(1)
        }
    }
}

machine Main::check_call_stacks_empty(&mut self) {
    assert self.parser.indexed_expression_frame_count == 0;
    assert self.parser.struct_literal_frame_count == 0;
    assert self.parser.call_parse_frame_count == 0;
    assert self.parser.suspended_expression_frame_count == 0;
    assert self.parser.suspended_expression_slot_count == 0;
}

machine Main::check_nested_call_rows(&mut self) {
    self.check_complete();
    self.check_call_stacks_empty();
    assert self.parser.call_expression_count == 4;
    assert self.parser.binary_expression_count == 1;
    assert self.parser.call_expressions[3].first_argument == 3;
    assert self.parser.call_expressions[3].argument_count == 2;
    assert self.parser.call_arguments[3] == 4;
    assert self.parser.call_arguments[4] == 6;
    transition self.parser.expressions[4].kind {
        OmegaExpressionKind::Binary -> right()
        _ -> self.console.exit_process(1)
    }
    state right() {
        transition self.parser.expressions[6].kind {
            OmegaExpressionKind::Call -> return
            _ -> self.console.exit_process(1)
        }
    }
}

machine Main::check_cast_kind(&mut self, index: i32, expected: i32) {
    transition self.parser.cast_expressions[index].kind {
        OmegaCastKind::Carrier -> carrier()
        OmegaCastKind::AddDomain -> add()
        OmegaCastKind::RemoveDomain -> remove()
    }
    state carrier() {
        assert expected == 0;
        assert self.parser.cast_expressions[index].target_type < self.parser.type_reference_count;
        assert self.parser.cast_expressions[index].domain.start == 0;
        assert self.parser.cast_expressions[index].domain.end == 0;
    }
    state add() { assert expected == 1; transition true { true -> domain() } }
    state remove() { assert expected == 2; transition true { true -> domain() } }
    state domain() {
        assert self.parser.cast_expressions[index].target_type == 0;
        assert self.parser.cast_expressions[index].domain.end >
            self.parser.cast_expressions[index].domain.start;
    }
}

machine Main::check_lexical_failure(&mut self) {
