boundary trait Console {
    machine exit_process(return_code: i32) -> never;
    machine write_byte(value: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}

data Main {
    console: Console;
    compiler: OmegaScalarCompiler;
}

machine Main::main(&mut self) {
    self.compiler.compile("machine helper() -> u8 { 40 } machine answer() -> u8 { helper(); (helper()) }", "answer");
    self.complete(41);
    assert self.compiler.tape.decode_address(1) == 22;
    assert self.compiler.tape.bytes[13] == 40;
    assert self.compiler.tape.decode_address(23) == 11;
    assert self.compiler.tape.decode_address(32) == 11;
    assert self.compiler.tape.bytes[40] == 20;

    self.compiler.compile("machine helper() -> u8 { 6 * 7 } machine answer() -> u8 { transition { _ -> finish() } state finish() { helper(); (helper()) } }", "answer");
    self.complete(50);
    assert self.compiler.tape.decode_address(1) == 22;
    assert self.compiler.tape.bytes[13] == 42;
    assert self.compiler.tape.decode_address(23) == 31;
    assert self.compiler.tape.decode_address(32) == 11;
    assert self.compiler.tape.decode_address(41) == 11;
    assert self.compiler.tape.bytes[49] == 20;

    self.compiler.compile("machine answer() -> u8 { transition 2 - 1 { 1 -> finish() _ -> other() } state finish() { 42 } state other() { 0 } }", "answer");
    self.complete(42);
    assert self.compiler.tape.decode_address(1) == 11;
    assert self.compiler.tape.decode_address(12) == 20;
    assert self.compiler.tape.bytes[22] == 42;
    assert self.compiler.tape.bytes[33] == 0;
    assert self.compiler.tape.bytes[41] == 20;

    self.compiler.compile("machine answer() -> u8 { (helper()) } machine helper() -> u8 { 7 }", "answer");
    self.complete(32);
    assert self.compiler.tape.decode_address(1) == 11;
    assert self.compiler.tape.decode_address(12) == 21;
    assert self.compiler.tape.bytes[23] == 7;
    assert self.compiler.tape.bytes[31] == 20;

    self.compiler.compile("machine answer() -> u8 { transition true { true -> yes() _ -> no() } state yes() { 1 } state no() { 0 } }", "answer");
    self.complete(42);
    assert self.compiler.tape.decode_address(1) == 11;
    assert self.compiler.tape.decode_address(12) == 20;
    assert self.compiler.tape.bytes[22] == 1;
    assert self.compiler.tape.bytes[33] == 0;
    assert self.compiler.tape.bytes[41] == 20;

    self.compiler.compile("machine answer() -> u8 { missing(); 1 }", "answer");
    self.rejected();

    self.compiler.compile("machine answer() -> u8 { (missing()) }", "answer");
    self.rejected();

    self.compiler.compile("machine answer() -> u8 { 20 + 22 }", "answer");
    self.complete(22);
    assert self.compiler.selected_machine == 0;
    assert self.compiler.tape.decode_address(1) == 11;
    assert self.compiler.tape.bytes[13] == 42;
    self.console.write_byte(67);
    transition true { true -> publish(0) }

    state publish(index: i32) {
        transition index < self.compiler.tape.payload_length() {
            true -> byte(index)
            _ -> return
        }
    }

    state byte(index: i32) {
        self.console.write_byte(self.compiler.tape.bytes[index]);
        transition true { true -> publish(index + 1) }
    }
}

machine Main::complete(&mut self, length: i32) {
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Complete -> check()
        _ -> self.console.exit_process(1)
    }

    state check() {
        assert self.compiler.tape.finalized == 1;
        assert self.compiler.tape.payload_length() == length;
        assert self.compiler.tape.bytes[0] == 19;
        assert self.compiler.tape.bytes[9] == 0;
        assert self.compiler.tape.bytes[10] == 0;
        assert self.compiler.tape.bytes[length - 1] == 20;
    }
}

machine Main::rejected(&mut self) {
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Reject -> check()
        _ -> self.console.exit_process(2)
    }

    state check() {
        assert self.compiler.tape.finalized == 0;
        assert self.compiler.tape.payload_length() == 0;
    }
}

machine Main::incomplete(&mut self) {
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Incomplete -> check()
        _ -> self.console.exit_process(3)
    }

    state check() {
        assert self.compiler.tape.finalized == 0;
        assert self.compiler.tape.payload_length() == 0;
    }
}
