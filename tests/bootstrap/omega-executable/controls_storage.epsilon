// The first input contains the exact SourceId, SourceUnit and clear declarations
// followed by storage_controls.omg. Other cases exercise generic storage rules.
boundary trait Console {
    machine exit_process(return_code: i32) -> never;
    machine write_byte(value: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main { console: Console; compiler: OmegaScalarCompiler; source: [u8; 65536]; length: i32; }
machine Main::main(&mut self) {
    self.length = 0;
    transition true { true -> read() }
    state read() {
        let value: i32 = self.console.read_byte();
        transition value == -1 { true -> run() _ -> append(value) }
    }
    state append(value: i32) {
        assert self.length < 65536;
        self.source[self.length] = value;
        self.length = self.length + 1;
        transition true { true -> read() }
    }
    state run() {
        self.positive(self.source.as_slice[0..self.length], 42, 10);
        // disjoint fields
        self.positive("data Leaf [copy] { word: u32 in Trapping; } data Packet [copy] { left: Leaf; right: Leaf; } machine replace(target: &mut Leaf, value: Leaf) { target.word = value.word; } machine main() -> u8 { let mut packet: Packet = Packet { left: Leaf { word: 1 as +Trapping }, right: Leaf { word: 9 as +Trapping } }; replace(&mut packet.left, packet.right); transition packet.left.word == packet.right.word { true -> yes() _ -> no() } machine yes() -> u8 { 43 } machine no() -> u8 { 1 } }", 43, 11);
        // shared read
        self.positive("data Leaf [copy] { word: u32 in Trapping; } machine same(source: &Leaf, other: Leaf) -> bool { source.word == other.word } machine main() -> u8 { let leaf: Leaf = Leaf { word: 31 as +Trapping }; transition same(&leaf, leaf) { true -> yes() _ -> no() } machine yes() -> u8 { 44 } machine no() -> u8 { 1 } }", 44, 12);
        // bounds and copy
        self.positive("data Counter [copy] requires value <= 4, { value: u64; } machine main() -> u8 { let mut counter: Counter; counter.value = 4; let snapshot: Counter = counter; counter.value = 0; transition snapshot.value == 4 && counter.value == 0 { true -> yes() _ -> no() } machine yes() -> u8 { 45 } machine no() -> u8 { 1 } }", 45, 13);
        // record result staging
        self.positive("data Leaf [copy] { word: u32 in Trapping; } machine make(value: u32 in Trapping) -> Leaf { Leaf { word: value } } machine first(a: Leaf, b: Leaf) -> Leaf { a } machine main() -> u8 { let saved: Leaf = first(make(7 as +Trapping), make(9 as +Trapping)); transition saved.word == 7 { true -> yes() _ -> no() } machine yes() -> u8 { 46 } machine no() -> u8 { 1 } }", 46, 14);
        // zero local
        self.positive("machine main() -> u8 { let value: u8; value }", 0, 15);
        // mutable local
        self.positive("machine main() -> u8 { let mut value: u8 = 2; value }", 2, 16);
        // An earlier by-value argument stays copied when a later call mutates its origin.
        self.positive("data Leaf [copy] {word:u8;} machine change(target:&mut Leaf)->Leaf {target.word=9;Leaf{word:target.word}} machine first(a:Leaf,b:Leaf)->Leaf {a} machine main()->u8 {let mut original:Leaf=Leaf{word:7};let saved:Leaf=first(original,change(&mut original));transition saved.word==7 && original.word==9 {true->yes() _->no()} machine yes()->u8 {48} machine no()->u8 {1}}", 48, 17);
        // The index is captured before a disjoint selector field changes in the RHS.
        self.positive("data Cursor [copy] requires value <= 1, { value:u64; } data Buffer {bytes:[u8;2];cursor:Cursor;} machine change(target:&mut Cursor)->u8 {target.value=1;7} machine main()->u8 {let mut buffer:Buffer;buffer.bytes[buffer.cursor.value]=change(&mut buffer.cursor);transition buffer.bytes[0]==7 && buffer.bytes[1]==0 && buffer.cursor.value==1 {true->yes() _->no()} machine yes()->u8 {44} machine no()->u8 {1}}", 44, 18);
        // borrow immutable
        self.refusal("data Leaf [copy] { word: u32 in Trapping; } machine replace(target: &mut Leaf, value: Leaf) { target.word = value.word; } machine main() -> u8 { let target: Leaf; let value: Leaf; replace(&mut target,value); 42 }", 1, 40);
        // later overlap read
        self.refusal("data Leaf [copy] { word: u32 in Trapping; } machine replace(target: &mut Leaf, value: Leaf) { target.word = value.word; } machine main() -> u8 { let mut target: Leaf; replace(&mut target,target); 42 }", 1, 41);
        // shared write
        self.refusal("data Leaf [copy] { word: u32 in Trapping; } machine write(target: &Leaf) { target.word = 1 as +Trapping; } machine main() -> u8 { 42 }", 1, 42);
        // wrong field carrier
        self.refusal("data Leaf [copy] { word: u32 in Trapping; } machine main() -> u8 { let mut target: Leaf; target.word = true; 42 }", 1, 43);
        // missing domain
        self.refusal("data Leaf [copy] { word: u32 in Trapping; } machine main() -> u8 { let target: Leaf = Leaf { word: 7 }; 42 }", 1, 44);
        // duplicate literal field
        self.refusal("data Pair [copy] { a:u8; b:u8; } machine main()->u8 {let pair:Pair=Pair {a:1,a:2};42}", 1, 45);
        // missing literal field
        self.refusal("data Leaf [copy] { word: u32 in Trapping; } machine main() -> u8 { let target: Leaf = Leaf { }; 42 }", 1, 46);
        // violated upper bound
        self.refusal("data Counter requires value <= 4, { value:u64; } machine write(target:&mut Counter) { target.value=5; } machine main()->u8 {42}", 2, 47);
        // unsupported default
        self.refusal("data Counter requires value > 0, { value:u64; } machine main()->u8 {let counter:Counter;42}", 2, 48);
        // implicit shared
        self.refusal("data Leaf [copy] { word: u32 in Trapping; } machine read(target:&Leaf)->u32 in Trapping { target.word } machine main()->u8 {let target:Leaf;read(target);42}", 2, 49);
        // stored reference
        self.refusal("data Leaf [copy] { word: u32 in Trapping; } machine main()->u8 {let mut target:Leaf;let view:&mut Leaf=&mut target;42}", 2, 50);
        // affine value
        self.refusal("data Box { value:u8; } machine main()->u8 {let original:Box;let moved:Box=original;42}", 2, 51);
        // omitted unit result
        self.refusal("machine main()->u8 {transition{_->finish()} machine finish(){42}}", 1, 52);
        // Equivalent separately spelled arrays need structural type admission.
        self.refusal("machine main()->u8 {let first:[u8;2];let second:[u8;2]=first;42}", 2, 53);
        // Requirement literals must land in the compared field's carrier.
        self.refusal("data R requires x <= 256, {x:u8;} machine main()->u8 {let r:R;0}", 2, 54);
        // Projected writes retain the nested owner's default predicate.
        self.refusal("data Counter [copy] requires value<=4, {value:u64;} data Outer {inner:Counter;} machine main()->u8 {let mut outer:Outer;outer.inner.value=5;42}", 2, 55);
        // Fixed-byte indexing checks authority, bounds, shell domains and overlapping RHS loans.
        self.refusal("data B {bytes:[u8;2];} machine main()->u8 {let mut b:B;(&b.bytes)[0]=1;42}", 1, 60);
        self.refusal("data B {bytes:[u8;2];} machine main()->u8 {let b:B;b.bytes[0]=1;42}", 1, 61);
        self.refusal("data B {bytes:[u8;2] in Trapping;} machine main()->u8 {let mut b:B;b.bytes[0]=1;42}", 2, 62);
        self.refusal("data B {bytes:[u8;2];} machine main()->u8 {let mut b:B;b.bytes[true]=1;42}", 1, 63);
        self.refusal("data B {words:[u32;2];} machine main()->u8 {let mut b:B;b.words[0]=1;42}", 2, 64);
        self.refusal("data B {bytes:[u8;2];} machine main()->u8 {let mut b:B;b.bytes[2]=1;42}", 1, 65);
        self.refusal("data B {bytes:[u8;2];} machine main()->u8 {let mut b:B;let mut index:u64=0;b.bytes[index]=1;42}", 2, 66);
        self.refusal("data I [copy] requires value<=2, {value:u64;} data B {bytes:[u8;2];index:I;} machine main()->u8 {let mut b:B;b.bytes[b.index.value]=1;42}", 2, 67);
        self.refusal("data B {bytes:[u8;2];} machine write(target:&mut B)->u8 {target.bytes[0]=1;9} machine main()->u8 {let mut b:B;b.bytes[0]=write(&mut b);42}", 2, 68);
        self.refusal("public machine compare(value:u64 in Trapping)->bool {value==0} machine main()->u8 {42}", 2, 69);
        // A tail transfer cannot reuse a local backing while its shared loan remains live.
        self.refusal("data Cell {value:u8;} machine main()->u8 {let seed:Cell=Cell{value:0};transition{_->again(&seed,42,false)} machine again(view:&Cell,n:u8,done:bool)->u8 {let temp:Cell=Cell{value:n};transition done {true->view.value _->again(&temp,44,true)}}}", 2, 70);
        self.positive("machine main() -> u8 { 59 }", 59, 90);
    }
}

machine Main::positive(&mut self, source: &[u8], expected: i32, failure: i32) {
    self.compiler.compile(source, "main");
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Complete -> publish()
        _ -> self.console.exit_process(failure)
    }
    state publish() {
        assert self.compiler.tape.finalized == 1;
        self.console.write_byte(expected);
        let length: i32 = self.compiler.tape.payload_length();
        self.console.write_byte(length % 256);
        self.console.write_byte((length / 256) % 256);
        self.console.write_byte((length / 65536) % 256);
        self.console.write_byte((length / 16777216) % 256);
        transition true { true -> byte(0) }
    }
    state byte(index: i32) {
        transition index < self.compiler.tape.payload_length() {
            true -> write(index)
            _ -> return
        }
    }
    state write(index: i32) {
        self.console.write_byte(self.compiler.tape.bytes[index]);
        transition true { true -> byte(index + 1) }
    }
}
machine Main::refusal(&mut self, source: &[u8], expected: i32, failure: i32) {
    self.compiler.compile(source, "main");
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Reject -> check(1)
        OmegaScalarCompilationStatus::Incomplete -> check(2)
        _ -> self.console.exit_process(failure)
    }
    state check(actual: i32) {
        assert (expected == 0) || (expected == actual);
        assert self.compiler.tape.finalized == 0;
        assert self.compiler.tape.payload_length() == 0;
    }
}
