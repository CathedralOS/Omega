// Actual UTF-8 decoder plus checked unsigned arithmetic and loan controls.
// Input starts with a validation batch selector. Batch zero compiles the exact
// SourceUnit/decoder declarations followed by utf8_controls.omg. Other batches
// retain generic arithmetic, loan and refusal/reset controls.
boundary trait Console {
    machine exit_process(return_code: i32) -> never;
    machine write_byte(value: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main { console: Console; compiler: OmegaScalarCompiler; source: [u8; 65536]; length: i32; selection: i32; }
machine Main::main(&mut self) {
    self.selection=self.console.read_byte();
    self.length=0;
    transition true {true->read()}
    state read() {
        let value:i32=self.console.read_byte();
        transition value == -1 {true->run() _->append(value)}
    }
    state append(value:i32) {
        assert self.length < 65536;
        self.source[self.length]=value;
        self.length=self.length+1;
        transition true {true->read()}
    }
    state run() {
        transition self.selection {
            0 -> batch_0()
            1 -> batch_1()
            2 -> batch_2()
            3 -> batch_3()
            4 -> batch_4()
            5 -> batch_5()
            6 -> batch_6()
            7 -> batch_7()
            8 -> batch_8()
            _ -> self.console.exit_process(99)
        }
    }
    state batch_0() {
        self.positive(self.source.as_slice[0..self.length],42,10);
    }
    state batch_1() {
        // u32-boundaries; expected normal completion.
        self.positive("machine add(value:u32 in Trapping)->u32 in Trapping {value+1} machine sub(value:u32 in Trapping)->u32 in Trapping {value-1} machine mul(value:u32 in Trapping)->u32 in Trapping {value*65535} machine main()->u8 {let a:u32 in Trapping=add(4294967294 as +Trapping);let b:u32 in Trapping=sub(1 as +Trapping);let c:u32 in Trapping=mul(65535 as +Trapping);transition a==4294967295 && b==0 && c==4294836225 {true->yes() _->no()} machine yes()->u8{42} machine no()->u8{1}}",42,20);
        // u32-add-overflow; Alpha must Trap, not return normally.
        self.positive("machine operation(value:u32 in Trapping)->u32 in Trapping {value+1} machine main()->u8 {let result:u32 in Trapping=operation(4294967295 as +Trapping);42}",0,21);
        // u32-sub-underflow; Alpha must Trap, not return normally.
        self.positive("machine operation(value:u32 in Trapping)->u32 in Trapping {value-1} machine main()->u8 {let result:u32 in Trapping=operation(0 as +Trapping);42}",0,22);
        // u32-mul-overflow; Alpha must Trap, not return normally.
        self.positive("machine operation(value:u32 in Trapping)->u32 in Trapping {value*2} machine main()->u8 {let result:u32 in Trapping=operation(4294967295 as +Trapping);42}",0,23);
        // capture-order; expected normal completion.
        self.positive("data Cell [copy] {value:u32 in Trapping;} machine change(cell:&mut Cell)->u32 in Trapping {cell.value=9 as +Trapping;cell.value} machine main()->u8 {let mut cell:Cell=Cell{value:7 as +Trapping};let result:u32 in Trapping=cell.value+change(&mut cell);transition result==16 && cell.value==9 {true->yes() _->no()} machine yes()->u8{42} machine no()->u8{1}}",42,24);
        // short-circuit; expected normal completion.
        self.positive("machine overflow()->bool {let value:u32 in Trapping=4294967295 as +Trapping;let sum:u32 in Trapping=value+1;sum==0} machine main()->u8 {transition false && overflow() {true->no() _->yes()} machine yes()->u8{42} machine no()->u8{1}}",42,25);
        // plain-peer; expected normal completion.
        self.positive("machine operation(value:u32 in Trapping,plain:u32)->u32 in Trapping {plain+value} machine main()->u8 {let result:u32 in Trapping=operation(40 as +Trapping,2);transition result==42 {true->yes() _->no()} machine yes()->u8{42} machine no()->u8{1}}",42,26);
    }
    state batch_2() {
        // u64-boundaries; expected normal completion.
        self.positive("machine twice(value:u64 in Trapping)->u64 in Trapping {value+value} machine maximum()->u64 in Trapping {let x0:u64 in Trapping=4294967295 as +Trapping;let x1:u64 in Trapping=twice(x0);let x2:u64 in Trapping=twice(x1);let x3:u64 in Trapping=twice(x2);let x4:u64 in Trapping=twice(x3);let x5:u64 in Trapping=twice(x4);let x6:u64 in Trapping=twice(x5);let x7:u64 in Trapping=twice(x6);let x8:u64 in Trapping=twice(x7);let x9:u64 in Trapping=twice(x8);let x10:u64 in Trapping=twice(x9);let x11:u64 in Trapping=twice(x10);let x12:u64 in Trapping=twice(x11);let x13:u64 in Trapping=twice(x12);let x14:u64 in Trapping=twice(x13);let x15:u64 in Trapping=twice(x14);let x16:u64 in Trapping=twice(x15);let x17:u64 in Trapping=twice(x16);let x18:u64 in Trapping=twice(x17);let x19:u64 in Trapping=twice(x18);let x20:u64 in Trapping=twice(x19);let x21:u64 in Trapping=twice(x20);let x22:u64 in Trapping=twice(x21);let x23:u64 in Trapping=twice(x22);let x24:u64 in Trapping=twice(x23);let x25:u64 in Trapping=twice(x24);let x26:u64 in Trapping=twice(x25);let x27:u64 in Trapping=twice(x26);let x28:u64 in Trapping=twice(x27);let x29:u64 in Trapping=twice(x28);let x30:u64 in Trapping=twice(x29);let x31:u64 in Trapping=twice(x30);let x32:u64 in Trapping=twice(x31);x32+4294967295} machine main()->u8 {let high:u64 in Trapping=maximum();let zero:u64 in Trapping=high-high;let one:u64 in Trapping=high-(high-1);transition zero==0 && one==1 {true->yes() _->no()} machine yes()->u8{42} machine no()->u8{1}}",42,27);
        // u64-add-overflow; Alpha must Trap, not return normally.
        self.positive("machine twice(value:u64 in Trapping)->u64 in Trapping {value+value} machine maximum()->u64 in Trapping {let x0:u64 in Trapping=4294967295 as +Trapping;let x1:u64 in Trapping=twice(x0);let x2:u64 in Trapping=twice(x1);let x3:u64 in Trapping=twice(x2);let x4:u64 in Trapping=twice(x3);let x5:u64 in Trapping=twice(x4);let x6:u64 in Trapping=twice(x5);let x7:u64 in Trapping=twice(x6);let x8:u64 in Trapping=twice(x7);let x9:u64 in Trapping=twice(x8);let x10:u64 in Trapping=twice(x9);let x11:u64 in Trapping=twice(x10);let x12:u64 in Trapping=twice(x11);let x13:u64 in Trapping=twice(x12);let x14:u64 in Trapping=twice(x13);let x15:u64 in Trapping=twice(x14);let x16:u64 in Trapping=twice(x15);let x17:u64 in Trapping=twice(x16);let x18:u64 in Trapping=twice(x17);let x19:u64 in Trapping=twice(x18);let x20:u64 in Trapping=twice(x19);let x21:u64 in Trapping=twice(x20);let x22:u64 in Trapping=twice(x21);let x23:u64 in Trapping=twice(x22);let x24:u64 in Trapping=twice(x23);let x25:u64 in Trapping=twice(x24);let x26:u64 in Trapping=twice(x25);let x27:u64 in Trapping=twice(x26);let x28:u64 in Trapping=twice(x27);let x29:u64 in Trapping=twice(x28);let x30:u64 in Trapping=twice(x29);let x31:u64 in Trapping=twice(x30);let x32:u64 in Trapping=twice(x31);x32+4294967295} machine main()->u8 {let high:u64 in Trapping=maximum();let overflow:u64 in Trapping=high+1;42}",0,28);
        // u64-sub-underflow; Alpha must Trap, not return normally.
        self.positive("machine operation(value:u64 in Trapping)->u64 in Trapping {value-1} machine main()->u8 {let result:u64 in Trapping=operation(0 as +Trapping);42}",0,29);
    }
    state batch_3() {
        // ordinary-forward; expected normal completion.
        self.positive("data Cell [copy] {value:u8;} machine read(cell:&Cell)->u8 {cell.value} machine forward(cell:&Cell)->u8 {read(cell)} machine main()->u8 {let cell:Cell=Cell{value:42};forward(&cell)}",42,30);
        // carrier mismatch.
        self.refusal("machine bad(a:u32 in Trapping,b:u64)->u32 in Trapping {a+b} machine main()->u8{0}",1,50);
        // implicit domain removal.
        self.refusal("machine bad(a:u32 in Trapping)->u32 {a+1} machine main()->u8{0}",1,51);
        // unsupported wide multiply.
        self.refusal("machine bad(a:u64 in Trapping)->u64 in Trapping {a*2} machine main()->u8{0}",2,52);
        // ordinary forwarding retains loan.
        self.refusal("data Cell [copy] {value:u8;} machine take(cell:&mut Cell,value:u8)->u8 {value} machine forward(cell:&mut Cell)->u8 {take(cell,cell.value)} machine main()->u8{0}",1,53);
        // ordinary forwarding holds later borrow.
        self.refusal("data Cell [copy] {value:u8;} machine change(cell:&mut Cell)->u8{cell.value=1;1} machine take(cell:&mut Cell,value:u8)->u8 {value} machine forward(cell:&mut Cell)->u8 {take(cell,change(cell))} machine main()->u8{0}",1,54);
        // local backing in tail transfer.
        self.refusal("data Cell [copy] {value:u8;} machine main()->u8 {let seed:Cell;transition{_->again(&seed,42,false)} machine again(view:&Cell,n:u8,done:bool)->u8 {let temp:Cell=Cell{value:n};transition done {true->view.value _->again(&temp,44,true)}}",2,55);
        // Unsupported indexed carriers remain coverage failures; known mismatches reject.
        // word-right.
        self.refusal("data Words{values:[u32;1];} machine f(value:u32 in Trapping)->u32 in Trapping{let w:Words;value+w.values[0]} machine main()->u8{0}",2,56);
        // word-left.
        self.refusal("data Words{values:[u32;1];} machine f(value:u32 in Trapping)->u32 in Trapping{let w:Words;w.values[0]+value} machine main()->u8{0}",2,57);
        // word-comparison.
        self.refusal("data Words{values:[u32;1];} machine f(value:u32 in Trapping)->bool{let w:Words;value==w.values[0]} machine main()->u8{0}",2,58);
        // byte-mismatch.
        self.refusal("data Bytes{values:[u8;1];} machine f(value:u32 in Trapping)->u32 in Trapping{let w:Bytes;value+w.values[0]} machine main()->u8{0}",1,59);
        // A coverage fallback must preserve diagnosed unknown-name failures.
        // missing-right.
        self.refusal("machine f(value:u32 in Trapping)->u32 in Trapping{value+missing} machine main()->u8{0}",1,60);
        // missing-left.
        self.refusal("machine f(value:u32 in Trapping)->u32 in Trapping{missing+value} machine main()->u8{0}",1,61);
        // missing-index.
        self.refusal("machine f(value:u32 in Trapping)->u32 in Trapping{value+missing[0]} machine main()->u8{0}",1,62);
        // missing-comparison.
        self.refusal("machine f(value:u32 in Trapping)->bool{value==missing[0]} machine main()->u8{0}",1,63);
        // Unconditional crash abandons a scalar return. Its empty-ceiling twin is invalid
        // even if no caller selects that declaration. A possible call without path proof
        // and a guarded declaration outside this slice both refuse coverage.
        self.positive("public machine leaf()->u8 crashes Trap {crash Trap;} machine main()->u8 crashes Trap {leaf()}",0,64);
        self.refusal("public machine leaf()->u8 crashes none {crash Trap;} machine main()->u8 {42}",1,65);
        self.refusal("machine leaf()->u8{crash Trap;} machine main()->u8 crashes none {leaf()}",2,66);
        self.refusal("machine guarded(n:u8)->u8 crashes Trap n == 0 {crash Trap;} machine main()->u8{42}",2,67);
        self.refusal("machine main()->u8 crashes none crashes Trap {42}",1,68);
        self.refusal("machine main()->u8 crashes Abort {42}",2,69);
        self.positive("machine main()->u8 crashes none {59}",59,90);
    }

    state batch_4() {
        // A pure body can publish a blocking ceiling. A private omitted wrapper
        // infers it, and each ordinary call must acknowledge its exact callee.
        self.positive("public machine leaf()->u8 blocks true {42} machine id(x:u8)->u8 blocks {x} machine wrap()->u8 {block id(block leaf())} public machine main()->u8 blocks {let x:u8=block wrap();x}",42,100);
        self.positive("machine block()->u8 {43} public machine main()->u8 blocks false {block()}",43,101);
        self.positive("machine wait() blocks {} public machine main()->u8 blocks {block wait();44}",44,102);
        self.refusal("machine leaf()->u8 blocks {42} machine unused()->u8 {leaf()} machine main()->u8 {1}",1,103);
        self.refusal("machine leaf()->u8 blocks {42} machine wrap()->u8 {block leaf()} machine main()->u8 {wrap()}",1,104);
        self.refusal("machine leaf()->u8 blocks {42} public machine main()->u8 {block leaf()}",1,105);
        self.refusal("machine leaf()->u8 blocks {42} machine main()->u8 blocks false {block leaf()}",1,106);
        self.refusal("machine leaf()->u8 blocks {42} machine main()->u8 blocks {suspend leaf()}",1,107);
        self.refusal("machine leaf()->u8 blocks {42} machine main()->u8 blocks {block suspend leaf()}",1,108);
        self.refusal("machine leaf()->u8 blocks {42} machine main()->u8 blocks {block block leaf()}",1,109);
        self.refusal("machine main()->u8 blocks true blocks false {42}",1,110);
        self.refusal("machine leaf()->u8 blocks {42} machine id(x:u8)->u8 blocks{x} machine main()->u8 blocks {block id(leaf())}",1,111);
        self.refusal("machine main()->u8 {let x:u8=42;block x}",1,112);
        self.refusal("machine leaf()->u8 blocks {42} machine main()->u8 blocks {suspend block leaf()}",2,113);
        self.positive("machine leaf()->u8 blocks false {59} public machine main()->u8 {block leaf()}",59,114);
    }

    state batch_5() {
        // Both arms need markers even though only the selected arm executes.
        self.positive("machine leaf()->u8 blocks {42} machine main()->u8 blocks {transition true {true->block work() _->quiet()} machine work()->u8 {block leaf()} machine quiet()->u8 {0}}",42,120);
        self.refusal("machine leaf()->u8 blocks {42} machine main()->u8 blocks {transition true {true->work() _->quiet()} machine work()->u8 {block leaf()} machine quiet()->u8 {0}}",1,121);
        self.refusal("machine leaf()->u8 blocks {42} machine main()->u8 blocks {transition true {true->suspend work() _->quiet()} machine work()->u8 {block leaf()} machine quiet()->u8 {0}}",1,122);
        self.refusal("machine leaf()->u8 blocks {42} machine main()->u8 blocks {transition true {true->suspend block work() _->quiet()} machine work()->u8 {block leaf()} machine quiet()->u8 {0}}",2,123);
        self.refusal("machine leaf()->u8 blocks {42} machine main()->u8 blocks {transition true {true->block suspend work() _->quiet()} machine work()->u8 {block leaf()} machine quiet()->u8 {0}}",1,124);
        self.refusal("machine leaf()->u8 blocks {42} machine main()->u8 blocks {transition true {true->block block work() _->quiet()} machine work()->u8 {block leaf()} machine quiet()->u8 {0}}",1,125);
        // The unentered helper cannot widen the public entry. Its own body is checked.
        self.positive("machine leaf()->u8 blocks {42} public machine main()->u8 {transition true {true->quiet()} machine quiet()->u8 {42} machine unused()->u8 {block leaf()}}",42,126);
        self.refusal("machine leaf()->u8 blocks {42} public machine main()->u8 {transition true {true->quiet()} machine quiet()->u8 {42} machine unused()->u8 {leaf()}}",1,127);
        self.refusal("machine other()->u8 {transition true {true->hidden()} machine hidden()->u8 {0}} machine main()->u8 {transition true {true->block hidden()}}",1,128);
        // An unseeded cycle is total. An exit with a published blocking ceiling
        // reaches both cycle members, including the edge taken on the second visit.
        self.positive("machine main()->u8 {transition true {true->first(false)} machine first(done:bool)->u8 {transition done {true->answer() _->block second()}} machine second()->u8 {transition true {true->first(true)}} machine answer()->u8 {43}}",43,129);
        self.positive("machine main()->u8 {transition true {true->block first(false)} machine first(done:bool)->u8 {transition done {true->block answer() _->block second()}} machine second()->u8 {transition true {true->block first(true)}} machine answer()->u8 blocks true {44}}",44,130);
        // Reuse the same four state slots and cycle edges with an unmarked, total program.
        self.positive("machine main()->u8 {transition true {true->first(false)} machine first(done:bool)->u8 {transition done {true->answer() _->second()}} machine second()->u8 {transition true {true->first(true)}} machine answer()->u8 {43}}",43,142);
        self.refusal("machine main()->u8 {transition true {true->block first(false)} machine first(done:bool)->u8 {transition done {true->block answer() _->second()}} machine second()->u8 {transition true {true->block first(true)}} machine answer()->u8 blocks true {44}}",1,131);
        self.refusal("machine main()->u8 {transition true {true->block first(false)} machine first(done:bool)->u8 {transition done {true->block answer() _->block second()}} machine second()->u8 {transition true {true->first(true)}} machine answer()->u8 blocks true {44}}",1,132);
        self.refusal("machine main()->u8 {transition true {true->block first(false)} machine first(done:bool)->u8 {transition done {true->block answer() _->block second()}} machine second()->u8 blocks false {transition true {true->block first(true)}} machine answer()->u8 blocks true {44}}",1,133);
        self.refusal("machine main()->u8 {transition true {true->block first(false)} machine first(done:bool)->u8 {transition done {true->block answer() _->block second()}} machine second()->u8 {transition true {true->block first(true)}} machine answer()->u8 blocks true blocks false {44}}",1,134);
        self.refusal("machine rec()->u8 {rec()} machine main()->u8 {42}",2,135);
        self.refusal("machine separate()->u8 blocks {42} machine main()->u8 {transition true {true->block separate()}}",2,136);
        self.refusal("machine main()->u8 blocks {transition true {true->quiet() _->wait()} machine quiet()->u8 {0} machine wait()->u8 blocks {42}}",1,138);
        // The marker grants no exemption from the target's signature or entry contract.
        self.refusal("machine main()->u8 {transition true {true->block limit()} machine limit(n:u64)->u8 blocks {45}}",1,139);
        self.refusal("machine main()->u8 {transition true {true->block limit(4)} machine limit(n:u64)->u8 blocks requires n<4 {45}}",2,140);
        self.positive("machine main()->u8 {transition true {true->block limit(3)} machine limit(n:u64)->u8 blocks requires n<4 {45}}",45,141);
        self.positive("machine main()->u8 {transition true {true->block()} machine block()->u8 {59}}",59,137);
    }

    state batch_6() {
        // Use ordinary precedence, explicit grouping and nested argument extents.
        self.positive("machine main()->u8 {let x:u32 in Trapping=5 as +Trapping; transition true {true->finish(x+3*x)} machine finish(n:u32 in Trapping)->u8 {transition n==20 {true->pass() _->miss()}} machine pass()->u8 {42} machine miss()->u8 {1}}",42,150);
        self.positive("machine main()->u8 {let x:u32 in Trapping=5 as +Trapping; transition true {true->finish((x+3)*x)} machine finish(n:u32 in Trapping)->u8 {transition n==40 {true->pass() _->miss()}} machine pass()->u8 {42} machine miss()->u8 {1}}",42,151);
        self.positive("machine advance(n:u32 in Trapping)->u32 in Trapping {n+1} machine main()->u8 {let x:u32 in Trapping=5 as +Trapping; transition true {true->finish(advance(x),advance(advance(x)),x)} machine finish(a:u32 in Trapping,b:u32 in Trapping,c:u32 in Trapping)->u8 {transition a==6 && b==7 && c==5 {true->pass() _->miss()}} machine pass()->u8 {42} machine miss()->u8 {1}}",42,152);
        // The target signature and the ordinary call in an operand are checked.
        self.refusal("machine main()->u8 {let x:u32 in Trapping=5 as +Trapping; transition true {true->finish(x+3*x,1)} machine finish(n:u32 in Trapping)->u8 {transition n==20 {true->pass() _->miss()}} machine pass()->u8 {42} machine miss()->u8 {1}}",1,153);
        self.refusal("machine main()->u8 {let x:u32 in Trapping=5 as +Trapping; transition true {true->finish(x==3*x)} machine finish(n:u32 in Trapping)->u8 {transition n==20 {true->pass() _->miss()}} machine pass()->u8 {42} machine miss()->u8 {1}}",1,154);
        self.refusal("machine main()->u8 {let x:u32 in Trapping=5 as +Trapping; transition true {true->finish(x+unknown())} machine finish(n:u32 in Trapping)->u8 {transition n==20 {true->pass() _->miss()}} machine pass()->u8 {42} machine miss()->u8 {1}}",2,155);
        // A mutation in the middle argument is observed once, from left to right.
        self.positive("data Cell [copy] {n:u32 in Trapping;} machine tick(cell:&mut Cell)->u32 in Trapping {let old:u32 in Trapping=cell.n;cell.n=old+1;cell.n} machine main()->u8 {let mut cell:Cell;cell.n=1 as +Trapping; transition true {true->finish(cell.n,tick(&mut cell),cell.n)} machine finish(a:u32 in Trapping,b:u32 in Trapping,c:u32 in Trapping)->u8 {transition a==1 && b==2 && c==2 {true->pass() _->miss()}} machine pass()->u8 {42} machine miss()->u8 {1}}",42,156);
    }

    state batch_7() {
        // Untaken transfer arguments and skipped logical operands cannot crash.
        self.positive("machine fail()->bool crashes Trap {crash Trap;} machine main()->u8 {transition true {true->pick(false && fail()) _->pick(fail())} machine pick(n:bool)->u8 {transition n {true->miss() _->pass()}} machine pass()->u8 {42} machine miss()->u8 {1}}",42,157);
        self.positive("machine fail()->bool crashes Trap {crash Trap;} machine main()->u8 {transition true {true->pick(true && fail()) _->pick(fail())} machine pick(n:bool)->u8 {transition n {true->miss() _->pass()}} machine pass()->u8 {42} machine miss()->u8 {1}}",0,158);
        self.positive("machine leaf()->u8 blocks {43} machine main()->u8 blocks {transition true {true->take(block leaf())} machine take(n:u8)->u8 {n}}",43,159);
        // A loan and a blocking call nested in an operand keep their normal obligations.
        self.refusal("data I {n:u32 in Trapping;} machine go(input:&mut I)->u8 { transition true {true->block rows(input,input.n+1)} machine rows(input:&mut I,n:u32 in Trapping)->u8 blocks {43}} machine main()->u8 blocks {let mut x:I;block go(&mut x)}",1,160);
        self.refusal("machine leaf()->u8 blocks {43} machine main()->u8 blocks {transition true {true->take(leaf())} machine take(n:u8)->u8 {n}}",1,161);
        // Plain unsigned arithmetic and the target precondition still require proof.
        self.refusal("machine step(index:u64)->u8 requires index<4 {transition true {true->next(index+1)} machine next(n:u64)->u8 requires n<2 {44}} machine main()->u8 {step(2)}",2,162);
        self.refusal("machine choose(v:u64)->u8 {transition true {true->take(v*3)} machine take(n:u64)->u8 {42}} machine main()->u8 {choose(3)}",2,163);
        self.positive("data I {n:u32 in Trapping;} machine go(input:&mut I)->u8 {let n:u32 in Trapping=input.n; transition true {true->block rows(input,n+1)} machine rows(input:&mut I,n:u32 in Trapping)->u8 blocks {43}} machine main()->u8 blocks {let mut x:I;block go(&mut x)}",43,164);
        self.positive("machine step(index:u64)->u8 requires index<4 {transition true {true->next(index+1)} machine next(n:u64)->u8 requires n<=4 {44}} machine main()->u8 {step(2)}",44,165);
    }

    state batch_8() {
        // Keyword spellings bind as names after literal and match dispatch.
        self.positive("machine main()->u8 {let target:u8=3;let host:u8=4;let data:u8=5;transition target<host && data==5 {true->pass() _->miss()} machine pass()->u8 {42} machine miss()->u8 {1}}",42,170);
        self.refusal("machine main()->u8 {transition true && target<4 {true->pass() _->miss()} machine pass()->u8 {42} machine miss()->u8 {1}}",1,171);
        self.refusal("machine unused()->u8 {transition true && target<4 {true->pass() _->miss()} machine pass()->u8 {42} machine miss()->u8 {1}} machine main()->u8 {0}",1,172);
        self.refusal("machine main()->u8 {let x:bool=true;transition (match x {true -> false, _ -> true}) {true->miss() _->pass()} machine pass()->u8 {42} machine miss()->u8 {1}}",2,173);
        self.positive("machine main()->u8 {transition false {true->miss() _->pass()} machine pass()->u8 {44} machine miss()->u8 {1}}",44,174);
    }

}
machine Main::positive(&mut self, source: &[u8], expected: i32, failure: i32) {
    self.compiler.compile(source, "main");
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Complete -> publish()
        _ -> self.console.exit_process(failure)
    }
    state publish() {
        assert self.compiler.tape.finalized == 1;
        self.console.write_byte(expected);
        let length: i32 = self.compiler.tape.payload_length();
        self.console.write_byte(length % 256);
        self.console.write_byte((length / 256) % 256);
        self.console.write_byte((length / 65536) % 256);
        self.console.write_byte((length / 16777216) % 256);
        transition true { true -> byte(0) }
    }
    state byte(index: i32) {
        transition index < self.compiler.tape.payload_length() {
            true -> write(index)
            _ -> return
        }
    }
    state write(index: i32) {
        self.console.write_byte(self.compiler.tape.bytes[index]);
        transition true { true -> byte(index + 1) }
    }
}
machine Main::refusal(&mut self, source: &[u8], expected: i32, failure: i32) {
    self.compiler.compile(source, "main");
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Reject -> check(1)
        OmegaScalarCompilationStatus::Incomplete -> check(2)
        _ -> self.console.exit_process(failure)
    }
    state check(actual: i32) {
        assert (expected == 0) || (expected == actual);
        assert self.compiler.tape.finalized == 0;
        assert self.compiler.tape.payload_length() == 0;
    }
}
