machine main() -> u8 {
    let mixed: u32 = u32_from_le_bytes(120, 86, 52, 18);
    let zero: u32 = u32_from_le_bytes(0, 0, 0, 0);
    let high: u32 = u32_from_le_bytes(255, 255, 255, 255);
    transition mixed == 305419896 && zero == 0 && high == 4294967295 {
        true -> yes(),
        _ -> no()
    }
    machine yes() -> u8 { 42 }
    machine no() -> u8 { 1 }
}
