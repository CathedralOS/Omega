    state loan_traversal() {
        // The supplied file starts after its logical path, main.omg. The
        // loan checker can refer to the fixture's tables through file aliases.
        let path: &[u8] = "main.omg";
        self.compiler.parser.sources.single(self.length);
        self.compiler.parser.sources.units[0].path.end = path.len;
        self.compiler.parser.sources.units[0].start = path.len;
