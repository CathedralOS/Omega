// The first program is the exact canonical lexer declarations followed by
// lexer_controls.omg. Remaining controls exercise the same generic backend.
boundary trait Console {
    machine exit_process(return_code: i32) -> never;
    machine write_byte(value: i32);
    machine read_byte() -> i32;
    machine write_line(text: &[u8]);
}
data Main { console: Console; compiler: OmegaScalarCompiler; source: [u8; 65536]; length: i32; }
machine Main::main(&mut self) {
    self.length = 0;
    transition true { true -> read() }
    state read() {
        let value: i32 = self.console.read_byte();
        transition value == -1 { true -> run() _ -> append(value) }
    }
    state append(value: i32) {
        assert self.length < 65536;
        self.source[self.length] = value;
        self.length = self.length + 1;
        transition true { true -> read() }
    }
    state run() {
        self.positive(self.source.as_slice[0..self.length], 42, 10);
        self.positive("machine main() -> u8 { transition { _ -> target(41, 42, false) } machine target(a: u8, b: u8, done: bool) -> u8 { transition done { true -> platform(a),_ -> target(b, a, true) } } machine platform(answer: u8) -> u8 { answer } }", 42, 11);
        self.refusal("machine main()->u8{transition{_->target(42)}machine other(value:u8)->u8{value}}", 1, 181);
        self.refusal("machine main()->u8{transition{_->target()}machine target(value:u8)->u8{value}}", 1, 182);
        self.positive("machine negated() -> bool { !false } machine looping() -> bool { transition { _ -> again() } machine again() -> bool { transition { _ -> again() } } } machine main() -> u8 { let left: bool = false && looping(); let right: bool = true || looping(); transition !left && right && negated() { true -> yes(),_ -> no() } machine yes() -> u8 { 43 } machine no() -> u8 { 1 } }", 43, 12);
        self.positive("machine word(x: u32 in Trapping) -> u32 in Trapping { x } machine main() -> u8 { let high: u32 in Trapping = word(4294967295 as +Trapping); let low: u32 in Trapping = word(2147483648 as +Trapping); let plain_high: u32 = high as -Trapping; let byte: u8 = 255; let good: bool = plain_high > byte && high > low && high >= word(4294967295 as +Trapping) && low < word(4294967295 as +Trapping) && low <= word(2147483648 as +Trapping) && high != low && (high == word(4294967295 as +Trapping)) == true; transition good { true -> yes(),_ -> no() } machine yes() -> u8 { 44 } machine no() -> u8 { 1 } }", 44, 13);
        self.positive("machine word(x: u32 in Trapping) -> u32 in Trapping { x } machine main() -> u8 { let good: bool = (word(1 as +Trapping) < word(2 as +Trapping)) == (word(3 as +Trapping) >= word(3 as +Trapping)); transition good { false -> no(),true -> yes() } machine yes() -> u8 { 45 } machine no() -> u8 { 1 } }", 45, 14);
        self.refusal("machine word(x: u32 in Trapping) -> bool { x == 0 } machine main() -> u8 { let bad: bool = word(4294967296 as +Trapping); 42 }", 1, 40);
        self.refusal("machine main() -> u8 { let bad: bool = 1; 42 }", 1, 41);
        self.refusal("machine main() -> u8 { let bad: u8 = true; 42 }", 1, 42);
        self.refusal("machine word(x: u32 in Trapping) -> bool { x == 0 } machine main() -> u8 { let small: u8 = 1; let bad: bool = word(small); 42 }", 1, 43);
        self.refusal("machine word(x: u32 in Wrapping) -> bool { x == 0 } machine main() -> u8 { 42 }", 2, 44);
        self.refusal("machine main() -> u8 { transition { _ -> next(1) } machine next(value: bool) -> u8 { 42 } }", 1, 45);
        self.refusal("machine main() -> u8 { transition { _ -> next() } machine next(value: bool) -> u8 { 42 } }", 1, 46);
        self.refusal("machine choose(value: bool) -> u8 { transition value { true -> yes() } machine yes() -> u8 { 42 } } machine main() -> u8 { choose(true) }", 1, 47);
        self.refusal("machine main() -> u8 { transition { _ -> next() } machine next() -> bool { true } }", 1, 48);
        self.refusal("machine main() -> u8 { transition { _ -> finish() } state finish() { 42 } }", 2, 49);
        self.refusal("machine main() -> u8 { transition { _ -> next(1) } machine next(value: u8) -> u8 { value } machine next(value: bool) -> u8 { 42 } }", 2, 50);
        self.refusal("machine main() -> u8 { transition { _ -> next(1) } machine next(first: u8) -> u8 { first } machine next(second: u8) -> u8 { second } }", 1, 51);
        self.refusal("machine guarded(x: u32 in Trapping) -> bool requires x == 0 { true } machine main() -> u8 { let bad: bool = guarded(1 as +Trapping); 42 }", 0, 52);
        self.refusal("machine dead(x: bool) -> bool { transition x { true -> true,_ -> missing(1) } } machine main() -> u8 { 42 }", 1, 53);
        self.refusal("machine main() -> u8 { transition { _ -> finish() } machine finish() { 42 } }", 1, 55);
        self.refusal("machine word(x: u32 in Trapping) -> bool { x == 0 } machine main() -> u8 { let bad: bool = word(0); 42 }", 1, 56);
        self.refusal("machine main() -> u8 { let bad: u32 in Trapping = 1; 42 }", 1, 57);
        self.refusal("machine word() -> u32 in Trapping { 1 } machine main() -> u8 { 42 }", 1, 58);
        self.refusal("machine main() -> u8 { transition { _ -> next(1) } machine next(value: u32 in Trapping) -> u8 { 42 } }", 1, 59);
        self.refusal("machine main() -> u8 { let plain: u32 = 1; let bad: u32 in Trapping = plain as u32 in Trapping; 42 }", 0, 60);
        self.refusal("machine main() -> u8 { let flag: bool = true; transition flag && (1 < 2) { true -> yes() } machine yes() -> u8 { 42 } }", 1, 54);
        assert self.compiler.outcome_space == 4;
        assert self.compiler.outcome_coordinate == 80;
        self.positive("machine word(x: u32 in Trapping) -> u32 in Trapping { x } machine main() -> u8 { let small: u8 = 42; let plain: u32 = small as u32; let qualified: u32 in Trapping = plain as +Trapping; let copied: u32 in Trapping = word(qualified); let restored: u32 = copied as -Trapping; transition restored == small { true -> yes(),_ -> no() } machine yes() -> u8 { 46 } machine no() -> u8 { 1 } }", 46, 16);
        self.refusal("machine target() -> u8 { 42 } machine main() -> u8 { transition { _ -> target() } }", 2, 65);
        self.positive("public machine compare(value:u32 in Trapping)->bool crashes none {value==0} machine main()->u8 {transition compare(0 as +Trapping) {true->yes(),_->no()} machine yes()->u8{42} machine no()->u8{7}}", 42, 61);
        self.refusal("machine compare(value: u32 in Trapping) -> bool { (value + 1) == 0 } public machine expose(value: u32 in Trapping) -> bool { compare(value) } machine main() -> u8 { 42 }", 2, 62);
        assert self.compiler.outcome_space == 4;
        assert self.compiler.outcome_coordinate == 69;
        self.refusal("public machine expose(value: u32 in Trapping) -> bool { compare(value) } machine compare(value: u32 in Trapping) -> bool { value == (value + 1) } machine main() -> u8 { 42 }", 2, 63);
        assert self.compiler.outcome_space == 4;
        assert self.compiler.outcome_coordinate == 0;
        self.refusal("pub machine main() -> u8 { 42 }", 2, 64);
        self.positive("public machine compare(value: u32) -> bool { let pub: u32 = value; pub == 47 } public machine main() -> u8 { transition compare(47) { true -> yes(),_ -> no() } machine yes() -> u8 { 47 } machine no() -> u8 { 1 } }", 47, 90);
        // default
        self.positive("data Mode [copy] {case First;case Second;}machine choose(value:Mode)->u8 {transition value {Mode::First->first(),Mode::Second->second()} machine first()->u8{42} machine second()->u8{43}}machine main()->u8{let value:Mode;choose(value)}",42,100);
        // copy/result
        self.positive("data Mode [copy] {case First;case Second;}machine choose(value:Mode)->u8 {transition value {Mode::First->first(),Mode::Second->second()} machine first()->u8{42} machine second()->u8{43}}machine make()->Mode{let value:Mode=Mode::Second;value} machine first(a:Mode,b:Mode)->Mode{a} machine main()->u8{let value:Mode=first(make(),Mode::First);choose(value)}",43,101);
        // field
        self.positive("data Mode [copy] {case First;case Second;}machine choose(value:Mode)->u8 {transition value {Mode::First->first(),Mode::Second->second()} machine first()->u8{42} machine second()->u8{43}}data Holder [copy]{mode:Mode;} machine main()->u8{let mutable holder:Holder;holder.mode=Mode::Second;let snapshot:Holder=holder;holder.mode=Mode::First;choose(snapshot.mode)}",43,102);
        // parallel tail
        self.positive("data Mode [copy] {case First;case Second;}machine choose(value:Mode)->u8 {transition value {Mode::First->first(),Mode::Second->second()} machine first()->u8{42} machine second()->u8{43}}machine main()->u8{transition{_->again(Mode::First,Mode::Second,false)} machine again(a:Mode,b:Mode,done:bool)->u8{transition done{true->finish(a),_->again(b,a,true)}} machine finish(value:Mode)->u8{choose(value)}}",43,103);
        // ordered wildcard
        self.positive("data Mode [copy] {case First;case Second;}machine choose(value:Mode)->u8{transition value{_->yes(),Mode::First->no(),Mode::Second->no()} machine yes()->u8{42} machine no()->u8{1}} machine main()->u8{choose(Mode::First)}",42,104);
        // same spelling distinct owners
        self.positive("data Mode [copy] {case First;case Second;}data Other [copy]{case First;case Second;}machine choose(value:Mode)->u8 {transition value {Mode::First->first(),Mode::Second->second()} machine first()->u8{42} machine second()->u8{43}}machine main()->u8{choose(Mode::Second)}",43,105);
        // hash collision
        self.positive("data Mode [copy]{case Ab;case BA;} machine choose(value:Mode)->u8{transition value{Mode::Ab->a(),Mode::BA->b()} machine a()->u8{1} machine b()->u8{42}} machine main()->u8{choose(Mode::BA)}",42,106);
        // argument snapshot
        self.positive("data Mode [copy] {case First;case Second;}machine choose(value:Mode)->u8 {transition value {Mode::First->first(),Mode::Second->second()} machine first()->u8{42} machine second()->u8{43}}data Holder {mode:Mode;} machine change(holder:@mutable Holder)->Mode{holder.mode=Mode::First;holder.mode} machine first(a:Mode,b:Mode)->Mode{a} machine main()->u8{let mutable holder:Holder;holder.mode=Mode::Second;let snapshot:Mode=first(holder.mode,change(@mutable holder));choose(snapshot)}",43,107);
        // subject once
        self.positive("data Mode [copy] {case First;case Second;}data Counter {value:u32 in Trapping;} machine subject(counter:@mutable Counter)->Mode{counter.value=counter.value+1;let result:Mode=Mode::Second;result} machine observe(counter:@mutable Counter)->u8{transition subject(counter){Mode::First->bad(),Mode::Second->good()} machine bad()->u8{1} machine good()->u8{42}} machine main()->u8{let mutable counter:Counter;let answer:u8=observe(@mutable counter);transition answer==42 && counter.value==1{true->yes(),_->no()} machine yes()->u8{42} machine no()->u8{1}}",42,108);
        // nominal mismatch
        self.refusal("data Mode [copy] {case First;case Second;}data Other [copy]{case First;case Second;}machine choose(value:Mode)->u8 {transition value {Mode::First->first(),Mode::Second->second()} machine first()->u8{42} machine second()->u8{43}}machine main()->u8{choose(Other::First)}",1,120);
        // missing case
        self.refusal("data Mode [copy] {case First;case Second;}machine choose(value:Mode)->u8 {transition value {Mode::First->first(),Mode::Second->second()} machine first()->u8{42} machine second()->u8{43}}machine main()->u8{choose(Mode::Missing)}",1,121);
        // nonexhaustive
        self.refusal("data Mode [copy] {case First;case Second;}machine choose(value:Mode)->u8{transition value{Mode::First->yes()} machine yes()->u8{42}} machine main()->u8{choose(Mode::First)}",1,122);
        // bad arm after wildcard
        self.refusal("data Mode [copy] {case First;case Second;}data Other [copy]{case First;} machine choose(value:Mode)->u8{transition value{_->yes(),Other::First->yes()} machine yes()->u8{42}} machine main()->u8{choose(Mode::First)}",1,123);
        // duplicate case
        self.refusal("data Mode [copy]{case First;case First;} machine main()->u8{42}",1,124);
        // mixed record/sum
        self.refusal("data Mode [copy]{word:u8;case First;} machine main()->u8{42}",1,125);
        // record-shaped sum
        self.refusal("data Mode [copy] {case First;case Second;}machine main()->u8{let x:Mode=Mode{};42}",1,126);
        // integer forgery
        self.refusal("data Mode [copy] {case First;case Second;}machine main()->u8{let x:Mode=0;42}",1,127);
        // noncopy
        self.refusal("data Mode {case First;} machine main()->u8{42}",2,128);
        // A case with a payload requires an explicit value.
        self.refusal("data Mode [copy]{case First(value:u8);} machine main()->u8{let v:Mode=Mode::First;42}",1,129);
        assert self.compiler.parser.data_cases[0].payload_field_count == 1;
        assert self.compiler.outcome_coordinate == 40;
        self.payload_bindings();
        self.payload_omissions();
        // Rebuild the first-case default after failed partial case censuses.
        self.positive("data Mode [copy] {case First;case Second;}machine choose(value:Mode)->u8 {transition value {Mode::First->first(),Mode::Second->second()} machine first()->u8{42} machine second()->u8{43}}machine main()->u8{let value:Mode;choose(value)}",42,140);
        self.source_sets();
        self.named_terminal_values();
        self.nested_machines();
        // The product type checker strips the source domain before widening and reapplying it.
        self.positive("data Index [copy]{value:u32 in Trapping;} machine main()->u8{let mutable s:Index;s.value=42 as +Trapping;let w:u64 in Trapping=s.value as -Trapping as u64 +Trapping;transition (w as -Trapping)==42{true->yes(),_->no()} machine yes()->u8{42} machine no()->u8{1}}", 42, 212);
        self.positive("machine main()->u8{let w:u64=42 as u8 as u64;transition w==42{true->yes(),_->no()} machine yes()->u8{42} machine no()->u8{1}}", 42, 213);
        self.refusal("machine main()->u8{let v:u32 in Trapping=42 as +Trapping;let w:u64 in Trapping=v as u64 +Trapping;42}", 1, 214);
        self.integer_patterns();
    }
}

machine Main::positive(&mut self, source: &[u8], expected: i32, failure: i32) {
    self.compiler.compile(source, "main");
    self.publish(expected, failure);
}

machine Main::publish(&mut self, expected: i32, failure: i32) {
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Complete -> publish()
        _ -> self.console.exit_process(failure)
    }
    state publish() {
        assert self.compiler.tape.finalized == 1;
        self.console.write_byte(expected);
        let length: i32 = self.compiler.tape.payload_length();
        self.console.write_byte(length % 256);
        self.console.write_byte((length / 256) % 256);
        self.console.write_byte((length / 65536) % 256);
        self.console.write_byte((length / 16777216) % 256);
        transition true { true -> byte(0) }
    }
    state byte(index: i32) {
        transition index < self.compiler.tape.payload_length() {
            true -> write(index)
            _ -> return
        }
    }
    state write(index: i32) {
        self.console.write_byte(self.compiler.tape.bytes[index]);
        transition true { true -> byte(index + 1) }
    }
}
machine Main::refusal(&mut self, source: &[u8], expected: i32, failure: i32) {
    self.compiler.compile(source, "main");
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Reject -> check(1)
        OmegaScalarCompilationStatus::Incomplete -> check(2)
        _ -> self.console.exit_process(failure)
    }
    state check(actual: i32) {
        assert (expected == 0) || (expected == actual);
        assert self.compiler.tape.finalized == 0;
        assert self.compiler.tape.payload_length() == 0;
    }
}

// Two exact source units exercise a declaration import across one supplied edge.
// Removing that edge must refuse, even after the successful lookup; restoring
// it must rebuild rather than inheriting a partial failed invocation.
machine Main::source_sets(&mut self) {
    let source: &[u8] = "appdepmain.omganswer.omguse {dep}/answer.omg; machine main()->u8 {|answer|::answer()}public machine answer()->u8 {let mutable s:Score;s.points=42;read_score(@s)}machine read_score(s:@Score)->u8{s.points}data Score requires points<=42,{points:u8;}";
    self.compiler.parser.sources.package_count = 2;
    self.compiler.parser.sources.packages[0].name.start = 0;
    self.compiler.parser.sources.packages[0].name.end = 3;
    self.compiler.parser.sources.packages[0].role = 0;
    self.compiler.parser.sources.packages[1].name.start = 3;
    self.compiler.parser.sources.packages[1].name.end = 6;
    self.compiler.parser.sources.packages[1].role = 0;
    self.compiler.parser.sources.dependency_count = 1;
    self.compiler.parser.sources.dependencies[0].requester = 0;
    self.compiler.parser.sources.dependencies[0].target = 1;
    self.compiler.parser.sources.dependencies[0].alias.start = 3;
    self.compiler.parser.sources.dependencies[0].alias.end = 6;
    self.compiler.parser.sources.unit_count = 2;
    self.compiler.parser.sources.units[0].path.start = 6;
    self.compiler.parser.sources.units[0].path.end = 14;
    self.compiler.parser.sources.units[0].package = 0;
    self.compiler.parser.sources.units[0].start = 24;
    self.compiler.parser.sources.units[0].end = 85;
    self.compiler.parser.sources.units[1].path.start = 14;
    self.compiler.parser.sources.units[1].path.end = 24;
    self.compiler.parser.sources.units[1].package = 1;
    self.compiler.parser.sources.units[1].start = 85;
    self.compiler.parser.sources.units[1].end = source.len;
    self.compiler.compile_set(source, 0, "main");
    // The bounded record and its shared parameter must use the per-file compiler.
    assert self.compiler.construction.active == 1;
    self.publish(42, 141);
    self.compiler.parser.sources.dependency_count = 0;
    self.compiler.compile_set(source, 0, "main");
    transition self.compiler.status {
        OmegaScalarCompilationStatus::Reject -> restore(source)
        _ -> self.console.exit_process(142)
    }
    state restore(source: &[u8]) {
        assert self.compiler.tape.finalized == 0;
        assert self.compiler.tape.payload_length() == 0;
        self.compiler.parser.sources.dependency_count = 1;
        self.compiler.compile_set(source, 0, "absent");
        transition self.compiler.status {
            OmegaScalarCompilationStatus::Reject -> retry(source)
            _ -> self.console.exit_process(142)
        }
    }
    state retry(source: &[u8]) {
        assert self.compiler.outcome_code == 11;
        assert self.compiler.tape.finalized == 0;
        assert self.compiler.tape.payload_length() == 0;
        self.compiler.compile_set(source, 0, "main");
        self.publish(42, 143);
    }
}

// Each selection tests the original field name. Only the binding to its
// right is visible in that arm's target.
machine Main::payload_bindings(&mut self) {
    self.positive("data M [copy]{case P(a:u8,b:u8);}machine pick(s:M)->u8{transition s{M::P{b as answer,a as _}->done(answer)}machine done(x:u8)->u8{x}}machine main()->u8{let p:M=M::P{b:42,a:7};pick(p)}",42,151);
    // Missing original field.
    self.rejected_at("data M [copy]{case P(a:u8);}machine pick(s:M)->u8{transition s{M::P{bad as x}->done(x)}machine done(x:u8)->u8{x}}machine main()->u8{42}", 68, 152);
    // One field cannot supply two bindings, even with distinct aliases.
    self.rejected_at("data M [copy]{case P(a:u8);}machine pick(s:M)->u8{transition s{M::P{a as x,a as y}->done(x)}machine done(x:u8)->u8{x}}machine main()->u8{42}", 75, 153);
    // Two fields cannot establish the same local.
    self.rejected_at("data M [copy]{case P(a:u8,b:u8);}machine pick(s:M)->u8{transition s{M::P{a as x,b as x}->done(x)}machine done(x:u8)->u8{x}}machine main()->u8{42}", 85, 154);
    // Renaming removes the shorthand binding. Another arm cannot see the alias.
    self.rejected_at("data M [copy]{case P(a:u8);}machine pick(s:M)->u8{transition s{M::P{a as x}->done(a)}machine done(x:u8)->u8{x}}machine main()->u8{42}", 82, 155);
    self.rejected_at("data M [copy]{case P(a:u8);case None;}machine pick(s:M)->u8{transition s{M::P{a as x}->done(x),M::None->done(x)}machine done(x:u8)->u8{x}}machine main()->u8{42}", 109, 156);
    // Omitted fields require an explicit '..'.
    self.rejected_at("data M [copy]{case P(a:u8,b:u8);}machine pick(s:M)->u8{transition s{M::P{a as x}->done(x)}machine done(x:u8)->u8{x}}machine main()->u8{42}", 68, 157);
    // Construction names are case-local, complete, and unique.
    self.rejected_at("data M [copy]{case P(a:u8,b:u8);case Q(c:u8);}machine main()->u8{let v:M=M::P{a:1,c:2};42}", 82, 158);
    self.rejected_at("data M [copy]{case P(a:u8,b:u8);}machine main()->u8{let v:M=M::P{a:1,a:2};42}", 69, 159);
    self.rejected_at("data M [copy]{case P(a:u8,b:u8);}machine main()->u8{let v:M=M::P{a:1};42}", 60, 160);
    // Zero storage establishes the first case with a zero-valued payload.
    self.positive("data M [copy]{case P(a:u8);}machine main()->u8{let p:M;transition p{M::P{a as result}->done(result)}machine done(x:u8)->u8{x}}",0,161);
    // The selected sum owns its copy of the record.
    self.positive("data Box [copy]{value:u8;} data M [copy]{case P(box:Box);} machine read(s:M)->u8 {transition s{M::P{box as saved}->done(saved.value)}machine done(x:u8)->u8{x}} machine main()->u8{let mutable b:Box;b.value=42;let p:M=M::P{box:b};b.value=0;read(p)}",42,162);
    // A mutation in a terminal sibling cannot invalidate this arm's entry bound.
    self.positive("data C { bytes:[u8;2]; length:u64; } data S [copy] {case First(v:u8);case Last;} machine change(c:@mutable C)->u8 {c.length=2;0} machine choose(c:@mutable C,s:S)->u8 { transition c.length<2 {true->pick(c,s),_->miss()} machine pick(c:@mutable C,s:S)->u8 requires c.length<2 { transition s {S::First {v as _}->done(change(c)),S::Last->done(c.bytes[c.length])} } machine done(x:u8)->u8 {x} machine miss()->u8 {1} } machine main()->u8 {let mutable c:C;c.bytes[0]=42;choose(@mutable c,S::Last)}",42,163);
}

machine Main::rejected_at(&mut self, source: &[u8], coordinate: i32, failure: i32) {
    self.refusal(source, 1, failure);
    assert self.compiler.outcome_coordinate == coordinate;
}

// A literal's final marker authorizes zero for fields of that literal.
machine Main::payload_omissions(&mut self) {
    self.positive("data Box [copy]{value:u8;zero:u8;}data M [copy]{case Empty;case P(box:Box,unused:u8);}machine read(s:M)->u8{transition s{M::P{box as b,unused as n}->check(b.value,b.zero,n),_->no()}machine check(x:u8,y:u8,z:u8)->u8{transition y==0&&z==0{true->done(x),_->no()}}machine done(x:u8)->u8{x}machine no()->u8{1}}machine main()->u8{let p:M=M::P{box:Box{value:42,..},..};read(p)}", 42, 164);
    self.positive("data M [copy]{case Empty;case P(a:u8,b:u8);}machine main()->u8{let p:M=M::P{..};transition p{M::P{a as x,b as _}->done(x),_->bad()}machine done(x:u8)->u8{x}machine bad()->u8{1}}", 0, 165);
    self.rejected_at("data M [copy]{case Empty;case P(a:u8,b:u8);}machine main()->u8{let p:M=M::P{..,a:42};42}", 79, 166);
    self.rejected_at("data M [copy]{case Empty;case P(a:u8,b:u8);}machine main()->u8{let p:M=M::P{..,..};42}", 79, 167);
    self.rejected_at("data M [copy]{case Empty;case P(a:u8,b:u8);}machine main()->u8{let p:M=M::P{..p};42}", 78, 168);
    self.rejected_at("data B [copy]{x:u8;y:u8;}data M [copy]{case P(b:B,z:u8);}machine main()->u8{let p:M=M::P{b:B{x:42},..};42}", 91, 169);
}

machine Main::named_terminal_values(&mut self) {
    self.refusal("data Hidden [copy]{value:u8;}public data Visible [copy]{case One(item:Hidden);}machine main()->u8{42}", 1, 218);
    self.positive("data Value [copy]{case Missing;case Found(value:u8);} machine pick(x:bool)->Value{transition x{false->Value::Missing,_->Value::Found{value:42}}} machine score(v:Value)->u8{transition v{Value::Found{value as n}->n,_->0}} machine main()->u8{transition score(pick(false))==0 && score(pick(true))==42{true->42,_->7}}", 42, 216);
    self.positive("machine select(take:bool, matched:u8, other:u8)->u8 { transition take { true -> matched, false -> other } } machine main()->u8 { transition select(true, 42, 7)==42 && select(false, 7, 42)==42 {true->pass(),_->fail()} machine pass()->u8{42} machine fail()->u8{7} }", 42, 171);
    self.positive("data OverloadMatch [copy] { case None; case One(handle: u64 in Trapping); case Ambiguous; } machine choose(value:OverloadMatch, choose_value:bool)->OverloadMatch { transition choose_value { true -> value, false -> other() } machine other()->OverloadMatch { OverloadMatch::None } } machine observe(item:OverloadMatch)->u8 crashes Trap { transition item { OverloadMatch::One {handle as n} -> check(n), _ -> no() } machine check(n:u64 in Trapping)->u8 {transition n==42 {true->yes(),_->no()}} machine yes()->u8{42} machine no()->u8{7} } machine main()->u8 crashes Trap { let handle:u64 in Trapping=42 as u64 +Trapping; let val:OverloadMatch=OverloadMatch::One {handle:handle}; transition observe(choose(val,true))==42 && observe(choose(val,false))==7 {true->yes(),_->no()} machine yes()->u8{42} machine no()->u8{7} }", 42, 172);
    self.refusal("data V [copy]{case None;case Some(x:u8);}machine pick()->V{transition{_->V::Some{unknown:42}}}machine main()->u8{42}", 1, 217);
    self.refusal("machine main()->u8{transition{_->missing}}", 1, 173);
    self.refusal("machine main()->u8{let value:bool=true;transition{_->value}}", 1, 174);
    self.refusal("machine main()->u8{let value:u8=42;transition{_->block value}}", 1, 175);
}

// Helpers with the same name in separate branches resolve at their own calls.
machine Main::nested_machines(&mut self) {
    self.positive("machine choose(left:bool)->u8{transition left{true->a(),_->b()}machine a()->u8{transition{_->leaf()}machine leaf()->u8{42}}machine b()->u8{transition{_->leaf()}machine leaf()->u8{7}}}machine main()->u8{transition choose(true)==42 && choose(false)==7{true->yes(),_->no()}machine yes()->u8{42}machine no()->u8{7}}", 42, 201);
    self.positive("machine main()->u8{transition{_->outer()}machine outer()->u8{transition{_->inner()}machine inner()->u8{transition{_->common()}}}machine common()->u8{42}}", 42, 202);
    self.positive("machine main()->u8{transition{_->outer()}machine leaf()->u8{7}machine outer()->u8{transition{_->leaf()}machine leaf()->u8{42}}}", 42, 203);
    self.positive("machine main()->u8{transition{_->outer(true)}machine outer(first:bool)->u8{transition first{true->inner(),_->done()}machine inner()->u8{transition{_->outer(false)}}machine done()->u8{42}}}", 42, 204);
    self.positive("machine main()->u8{transition{_->outer(42)}machine outer(value:u8)->u8{transition{_->inner(value)}machine inner(value:u8)->u8{value}}}", 42, 205);
    self.positive("machine helper(){machine outer(){machine leaf(){}}}machine main()->u8{helper();42}", 42, 206);
    self.positive("machine main()->u8{transition{_->outer(42)}machine outer(leaf:u8)->u8{transition{_->inner(leaf)}machine inner(x:u8)->u8{x}}machine cousin()->u8{transition{_->leaf()}machine leaf()->u8{7}}}", 42, 207);
    self.rejected_at("machine main()->u8{transition{_->sibling()}machine outer()->u8{transition{_->hidden()}machine hidden()->u8{42}}machine sibling()->u8{transition{_->hidden()}}}", 147, 208);
    self.rejected_at("machine main()->u8{transition{_->outer()}machine outer()->u8{transition{_->inner()}machine inner()->u8{42}machine inner()->u8{7}}}", 114, 209);
    self.rejected_at("machine main()->u8{transition{_->outer(42)}machine outer(value:u8)->u8{transition{_->inner()}machine inner()->u8{value}}}", 113, 210);
    self.rejected_at("machine main()->u8{transition{_->outer()}machine outer()->u8{transition{_->inner()}machine inner()->u8{42}7}}", 106, 211);
    // An ordinary global call is available in a cousin and hidden beneath a local helper.
    self.positive("machine leaf()->u8{42}machine main()->u8{transition{_->sibling()}machine outer()->u8{transition{_->leaf()}machine leaf()->u8{7}}machine sibling()->u8{leaf()}}", 42, 212);
    self.refusal("machine leaf()->u8{7}machine main()->u8{transition{_->outer()}machine outer()->u8{let answer:u8=leaf();transition{_->answer}machine leaf()->u8{42}}}", 2, 213);
    assert self.compiler.outcome_coordinate == 96;
}

// The first and second labels have the same low word. A truncated comparison
// selects the first arm. The last label also sets every bit of the high word.
machine Main::integer_patterns(&mut self) {
    self.positive("machine which(n:u64)->u8{transition n{1->7,0x1_0000_0001->42,_->0}} machine main()->u8{which(4294967297)}", 42, 222);
    self.positive("machine which(n:u64)->u8{transition n{4294967295->7,18_446_744_073_709_551_615->42,_->0}} machine main()->u8{which(0xffff_ffff_ffff_ffff)}", 42, 223);
    self.refusal("machine which(n:u8)->u8{transition n{0x100->7,_->42}} machine main()->u8{which(0)}", 1, 224);
    self.refusal("machine which(n:u32)->u8{transition n{0x1_0000_0000->7,_->42}} machine main()->u8{which(0)}", 1, 225);
    self.refusal("machine which(n:u64)->u8{transition n{0x1_0000_0000_0000_0000->7,_->42}} machine main()->u8{which(0)}", 1, 226);
    self.refusal("machine which(n:u8)->u8{transition n{true->7,_->42}} machine main()->u8{which(0)}", 1, 227);
    self.refusal("machine which(n:bool)->u8{transition n{1->7,_->42}} machine main()->u8{which(true)}", 1, 228);
    self.refusal("machine which(n:u64)->u8{transition n{0->1,1->42}} machine main()->u8{which(1)}", 1, 229);
}
