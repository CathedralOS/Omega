data Page [copy] {
    rows: [[u64 in Trapping; 2]; 3];
    marker: u8;
}

machine mark(page: @mut Page, value: u8) {
    page.marker = value;
}

machine qualified_array_element_copy() -> u8 {
    let mut first: Page;
    mark(@mut first, 42);
    let second: Page = first;
    mark(@mut first, 1);
    second.marker
}
