data Marker [copy] { copy: u8; }
data Markers { rows: [Marker; 1]; }

machine indexed_record_fields() -> u8 {
    let mutable sources: SourceSet;
    let mutable selected: Markers;
    selected.rows[0] = Marker { copy: 42 };
    store_unit_count(@mutable sources, 511 as +Trapping);
    let last_count: u64 = sources.unit_count;
    sources.units[511] = SourceRange { start: 3 as +Trapping, length: 1 as +Trapping };
    sources.bytes[3] = 42;
    let last_id: SourceId = SourceId { value: 511 as +Trapping };
    let past_end: SourceId = SourceId { value: 512 as +Trapping };
    let last_byte: u8 = source_set_byte_or_nul(@sources, last_id, 0 as +Trapping);
    let past_byte: u8 = source_set_byte_or_nul(@sources, last_id, 1 as +Trapping);
    let past_unit: u8 = source_set_byte_or_nul(@sources, past_end, 0 as +Trapping);
    store_unit_count(@mutable sources, 1 as +Trapping);
    sources.unit_packages[0] = 73;
    sources.byte_count = 4194262;
    sources.path_byte_count = 16382;
    let mutable unit: SourceUnit;
    let mutable path: ModulePath;
    unit.length = 42;
    path.length = 2;
    let fits: bool = has_room(@sources, @unit, @path);
    unit.length = 43;
    let extra_byte: bool = has_room(@sources, @unit, @path);
    unit.length = 42;
    path.length = 3;
    sources.paths[0] = SourceRange { start: 5 as +Trapping, length: 17 as +Trapping };
    sources.paths[1] = SourceRange { start: 31 as +Trapping, length: 42 as +Trapping };
    let snapshot: SourceRange = sources.paths[0];
    sources.paths[0] = SourceRange { start: 6 as +Trapping, length: 18 as +Trapping };
    sources.paths[511] = snapshot;
    transition selected.rows[0].copy == 42 && snapshot.length == 17 && sources.paths[511].start == 5 &&
        path_length(@sources, 0 as +Trapping) == 18 &&
        path_length(@sources, 1 as +Trapping) == 42 &&
        sources.paths[1].start == 31 && sources.unit_packages[0] == 73 &&
        last_count == 512 && last_byte == 42 && past_byte == 0 && past_unit == 0 &&
        fits && !extra_byte && !has_room(@sources, @unit, @path) {
        true -> pass(), _ -> miss()
    }
    machine pass() -> u8 { 42 }
    machine miss() -> u8 { 7 }
}

// The remaining-byte and remaining-path tests from source_set_add.
machine has_room(sources: @SourceSet, unit: @SourceUnit, module_path: @ModulePath) -> bool {
    unit.length <= 4194304 - sources.byte_count &&
        module_path.length <= 16384 - sources.path_byte_count
}

// The count increment from source_set_add::store_ranges.
machine store_unit_count(sources: @mutable SourceSet, unit_count: u64 in Trapping)
requires unit_count < 512
{
    sources.unit_count = (unit_count + 1) as -Trapping;
}
