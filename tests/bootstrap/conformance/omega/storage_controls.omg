data LoanCell { value: u8; }
data LoanPair { left: LoanCell; right: LoanCell; }

machine fill_cells(left: @mut LoanCell, right: @mut LoanCell) {
    transition { _ -> write(right, left) }
    machine write(first: @mut LoanCell, second: @mut LoanCell) {
        first.value = 41;
        second.value = 42;
    }
}

machine copy_cell(dst: @mut LoanCell, src: @LoanCell) {
    dst.value = src.value;
}

machine both_forty_two(left: @LoanCell, right: @LoanCell) -> bool {
    left.value == 42 && right.value == 42
}

machine disjoint_reference_parameters() -> bool {
    let mut pair: LoanPair;
    fill_cells(@mut pair.left, @mut pair.right);
    let swapped: bool = pair.left.value == 42 && pair.right.value == 41;
    copy_cell(@mut pair.right, @pair.left);
    swapped && both_forty_two(@pair.left, @pair.left) && pair.right.value == 42
}

// An odd-sized byte array is copied with its enclosing record. Adjacent
// elements and the field after the array must retain their own values.
data ByteTail [copy] { bytes: [u8; 9]; after: u64; }

machine byte_view_length(bytes: @[u8]) -> u64 { bytes.len }

machine second_byte(bytes: @[u8]) -> u8
requires bytes.len >= 2
{
    transition { _ -> read(bytes) }
    machine read(bytes: @[u8]) -> u8 requires bytes.len >= 2 { bytes[1] }
}

machine construction_byte_arena() -> u8 {
    let mut input: ConstructionInput;
    input.unit_count = 305;
    input.bytes[4194303] = 255;
    input.bytes[4194302] = 41;
    input.bytes[0] = 42;
    let mut small: ByteTail;
    small.after = 77;
    small.bytes[1] = 255;
    small.bytes[0] = 19;
    small.bytes[8] = 73;
    let saved: ByteTail = small;
    small.bytes[1] = 3;
    transition input.unit_count == 305 && input.bytes[0] == 42 &&
        input.bytes[4194302] == 41 && input.bytes[4194303] == 255 &&
        saved.bytes[1] == 255 && saved.bytes[8] == 73 && saved.after == 77 &&
        small.bytes[0] == 19 && small.bytes[1] == 3 &&
        second_byte(@input.bytes[4194302..4194304]) == 255 &&
        byte_view_length(@small.bytes[..]) == 9 &&
        byte_view_length(small.bytes[5..5]) == 0 {
        true -> pass(), _ -> miss()
    }
    machine pass() -> u8 { 42 }
    machine miss() -> u8 { 7 }
}

// In value position each name selects its local or parameter, even when
// another machine in the enclosing scope has the same name.
machine read_helper_names() -> u8 {
    transition { _ -> read(42) }
    machine read(marker: u8) -> u8 {
        let sibling: u8 = marker;
        sibling
    }
    machine marker() -> u8 { 7 }
    machine sibling() -> u8 { 9 }
}

machine main() -> u8 {
    let mut unit: SourceUnit;
    let id: SourceId = SourceId { value: 77 as +Trapping };
    unit.length = 19;
    unit.last_retained = false;
    unit.bytes[0] = 77;
    source_unit_clear(@mut unit, id);
    let canary: u8 = unit.bytes[0];
    source_unit_append(@mut unit, 41);
    let first: u8 = source_unit_byte_or_nul(@unit, 0 as +Trapping);
    let absent: u8 = source_unit_byte_or_nul(@unit, 1 as +Trapping);
    unit.length = 131071;
    source_unit_append(@mut unit, 42);
    let last: u8 = source_unit_byte_or_nul(@unit, 131071 as +Trapping);
    let retained: bool = unit.last_retained;
    source_unit_append(@mut unit, 55);
    let preserved: u8 = source_unit_byte_or_nul(@unit, 131071 as +Trapping);
    let mut path: ModulePath;
    path.length = 255;
    let path_last: bool = module_path_append(@mut path, 73);
    let path_full: bool = module_path_append(@mut path, 99);
    transition read_helper_names() == 42 && disjoint_reference_parameters() && unit.id.value == id.value && canary == 77 && first == 41 && absent == 0 && last == 42 && retained && unit.length == 131072 && !unit.last_retained && preserved == 42 && path_last && !path_full && path.length == 256 && path.bytes[255] == 73 && qualified_array_element_copy() == 42 && indexed_record_fields() == 42 && construction_byte_arena() == 42 {
        true -> yes(),
        _ -> no()
    }
    machine yes() -> u8 { 42 }
    machine no() -> u8 { 1 }
}
