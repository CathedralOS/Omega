; Diagnostic only: Grounded does not assert equality or proof acceptance.
(def $application () Int 1)
(def main () Int
  (let result Int (check_derivation_ground)
    (let tag Int (first result)
      (let prefix Int (write tag)
        (let observed Int
          (if (eq tag 5)
            (ground_test_success (second result))
            (ground_test_failure (second result)))
          (pair 0 1))))))

(def ground_test_success ((payload Int)) Int
  (let frame Int (formed_frame (grounded_theory payload))
    (let theory Int (ground_test_word (admission_theory_end frame) 8)
      (let proposition Int (ground_test_word (admission_proposition_end frame) 8)
        (let certificate Int (ground_test_word (admission_certificate_end frame) 8)
          (let owners Int (ground_test_word (formation_index_count (grounded_owner_terms payload)) 8)
            (let witnesses Int (ground_test_word (formation_index_count (grounded_witness_terms payload)) 8)
              (let left Int (ground_test_word (layout_word (- (admission_proposition_end frame) 8)) 8)
                (let right Int (ground_test_word (layout_word (- (admission_proposition_end frame) 4)) 8)
                  (ground_test_word (grounded_proof_table payload) 8))))))))))

(def ground_test_failure ((failure Int)) Int
  (let code Int (ground_test_word (admission_failure_code failure) 8)
    (let coordinate Int (ground_test_word (admission_failure_coordinate failure) 8)
      (let limit Int (ground_test_word (admission_failure_limit failure) 8)
        (ground_test_word (admission_failure_requested failure) 8)))))

(def ground_test_word ((value Int) (remaining Int)) Int
  (if (eq remaining 0)
    0
    (let byte Int (write (% value 256))
      (ground_test_word (/ value 256) (- remaining 1)))))
