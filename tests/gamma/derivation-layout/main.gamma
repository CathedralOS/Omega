; Diagnostic only: physical Layout never claims theory or proof acceptance.
(def $application () Int 1)
(def main () Int
  (let result Int (admit_derivation_layout)
    (let tag Int (first result)
      (let prefix Int (write tag)
        (let observed Int
          (if (eq tag 3)
            (layout_test_sections (second result))
            (layout_test_failure (second result)))
          (pair 0 1))))))

(def layout_test_sections ((frame Int)) Int
  (let theory Int (layout_test_word (admission_theory_end frame) 4)
    (let proposition Int (layout_test_word (admission_proposition_end frame) 4)
      (layout_test_word (admission_certificate_end frame) 4))))

(def layout_test_failure ((failure Int)) Int
  (let code Int (layout_test_word (admission_failure_code failure) 4)
    (let coordinate Int (layout_test_word (admission_failure_coordinate failure) 4)
      (let limit Int (layout_test_word (admission_failure_limit failure) 4)
        (layout_test_word (admission_failure_requested failure) 4)))))

(def layout_test_word ((value Int) (remaining Int)) Int
  (if (eq remaining 0)
    0
    (let byte Int (write (% value 256))
      (layout_test_word (/ value 256) (- remaining 1)))))
