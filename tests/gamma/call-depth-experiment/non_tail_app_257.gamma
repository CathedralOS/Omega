; The same refusal through the application result convention: the Delta
; compiler is an application source, so its evaluator-level call-stack
; exhaustion surfaces as status 250, the raw outcome the rejected
; direct-recursion rewrite observed at depth 256.
(def $application () Int 1)

(def descend ((n Int)) Int
  (if (eq n 0) 1 (+ 0 (descend (- n 1)))))

(def main () Int (pair (descend 257) 1))
