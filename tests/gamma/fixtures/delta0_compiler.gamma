# Delta0 compiler in concatenative Gamma.
# Cell 0 is the input cursor. Every operation state tail-jumps to compile.

: nibble
  dup 0x3a < branch nibble_digit nibble_alpha
;
: nibble_digit 0x30 - ;
: nibble_alpha 0x57 - ;

# input index -- byte
: hex_byte
  dup input-get nibble 0x10 *
  swap 0x1 + input-get nibble +
;

: cursor 0x0 cell-get ;
: advance cursor + 0x0 cell-set ;

: compile
  cursor input-length = branch done dispatch_s
;
: done ;

: dispatch_s cursor input-get 0x53 = branch op_s dispatch_h ;
: dispatch_h cursor input-get 0x48 = branch op_h dispatch_i ;
: dispatch_i cursor input-get 0x49 = branch op_i dispatch_m ;
: dispatch_m cursor input-get 0x4d = branch op_m dispatch_a ;
: dispatch_a cursor input-get 0x41 = branch op_a dispatch_u ;
: dispatch_u cursor input-get 0x55 = branch op_u dispatch_j ;
: dispatch_j cursor input-get 0x4a = branch op_j dispatch_n ;
: dispatch_n cursor input-get 0x4e = branch op_n bad ;
: bad input-length input-get ;

: op_s
  cursor 0x1 + hex_byte output-position assert-equal
  0x3 advance jump compile
;
: op_h
  0x0 output-byte
  cursor 0x1 + hex_byte output-byte
  0x3 advance jump compile
;
: op_i
  0x1 output-byte
  cursor 0x1 + hex_byte output-byte
  cursor 0x3 + hex_byte output-word
  0x5 advance jump compile
;
: op_m
  0x2 output-byte
  cursor 0x1 + hex_byte output-byte
  cursor 0x3 + hex_byte output-byte
  0x5 advance jump compile
;
: op_a
  0x3 output-byte
  cursor 0x1 + hex_byte output-byte
  cursor 0x3 + hex_byte output-byte
  0x5 advance jump compile
;
: op_u
  0x4 output-byte
  cursor 0x1 + hex_byte output-byte
  cursor 0x3 + hex_byte output-byte
  0x5 advance jump compile
;
: op_j
  0xc output-byte
  cursor 0x1 + hex_byte output-word
  0x3 advance jump compile
;
: op_n
  0xe output-byte
  cursor 0x1 + hex_byte output-byte
  cursor 0x3 + hex_byte output-word
  0x5 advance jump compile
;

: main
  0x0 0x0 cell-set
  jump compile
;