; Direct Beta evaluator for the typed scalar/effect Gamma bootstrap profile.
; Request: u32 little-endian source length, source bytes, sealed input bytes.
; Returning main's Int writes its low byte and completes with status zero.
;
; Persistent registers:
; r80 request end, r81 source start, r82 source end, r83 input start,
; r84 input length, r85 cursor, r86 token start, r87 token length,
; r88 function count, r89 environment count, r8a value-stack pointer,
; r8b main function row, r8c active environment base,
; r8d function-frame pointer, r8e call-context depth.
; r90 zero, r91 one, r92 request base, r93 request limit,
; r94 function table, r95 environment table, r96 value-stack base,
; r97 value-stack end, r98 tail-request flag, r99 tail function,
; r9a tail argument base, r9b tail argument count,
; ra0 immutable-pair heap cursor, ra1 immutable-pair heap limit,
; rb0 output count, rb1 output limit.
; Low registers are caller-clobbered scratch.

main:
        imm r90 0x0
        imm r91 0x1
        imm r92 0x100000
        imm r93 0x1100000
        imm r94 0x1200000
        imm r95 0x1300000
        imm r96 0x1500000
        imm r97 0x1d00000
        imm ra0 0x2000000
        imm ra1 0xe000000
        mov rb0 r90
        imm rb1 0x4000000
        mov r0 r92
read_loop:
        jeq r0 r93 @read_full
        read r1
        jlt r1 r90 @read_done
        storeb r0 r1
        add r0 r91
        jmp @read_loop
read_full:
        read r1
        jlt r1 r90 @read_done
        jmp @incomplete
read_done:
        mov r80 r0
        mov r1 r92
        imm r2 0x4
        add r1 r2
        jlt r80 r1 @invalid
        mov r0 r92
        call @read_u32
        mov r81 r92
        imm r1 0x4
        add r81 r1
        mov r82 r81
        add r82 r0
        jlt r82 r81 @invalid
        jlt r80 r82 @invalid
        mov r83 r82
        mov r84 r80
        sub r84 r83
        call @validate_source
        call @census
        mov r89 r90
        mov r8c r90
        mov r8a r96
        mov r8e r90
        call @validate_program
        mov r89 r90
        mov r8c r90
        mov r8a r96
        imm r8d 0x1e00000
        mov r8e r90
        mov r0 r8b
        mov r1 r8a
        mov r2 r90
        call @enter_function
        jlt r0 r90 @authored_trap
        imm r1 0x100
        jlt r0 r1 @main_write
        jmp @authored_trap
main_write:
        call @write_output
        mov r0 r90
        halt r0

write_output:
        jeq rb0 rb1 @incomplete
        write r0
        add rb0 r91
        ret

; r0 points to four little-endian bytes; returns u32 in r0.
read_u32:
        loadb r1 r0
        mov r2 r0
        add r2 r91
        loadb r3 r2
        imm r4 0x100
        mul r3 r4
        add r1 r3
        add r2 r91
        loadb r3 r2
        imm r4 0x10000
        mul r3 r4
        add r1 r3
        add r2 r91
        loadb r3 r2
        imm r4 0x1000000
        mul r3 r4
        add r1 r3
        mov r0 r1
        ret

validate_source:
        mov r0 r81
validate_source_loop:
        jlt r0 r82 @validate_source_byte
        ret
validate_source_byte:
        loadb r1 r0
        imm r2 0x9
        jeq r1 r2 @validate_source_next
        imm r2 0xa
        jeq r1 r2 @validate_source_next
        imm r2 0xd
        jeq r1 r2 @validate_source_next
        imm r2 0x20
        jlt r1 r2 @invalid
        imm r2 0x7f
        jlt r1 r2 @validate_source_next
        jmp @invalid
validate_source_next:
        add r0 r91
        jmp @validate_source_loop

; Tokenizer. Returns r0=1 with r86/r87, or r0=0 at source end.
next_token:
        mov r0 r85
next_skip:
        jlt r0 r82 @next_have
        mov r85 r0
        mov r0 r90
        ret
next_have:
        loadb r1 r0
        imm r2 0x21
        jlt r1 r2 @next_advance
        imm r2 0x3b
        jeq r1 r2 @next_comment
        jmp @next_begin
next_advance:
        add r0 r91
        jmp @next_skip
next_comment:
        add r0 r91
next_comment_loop:
        jlt r0 r82 @next_comment_byte
        jmp @next_skip
next_comment_byte:
        loadb r1 r0
        add r0 r91
        imm r2 0xa
        jeq r1 r2 @next_skip
        imm r2 0xd
        jeq r1 r2 @next_skip
        jmp @next_comment_loop
next_begin:
        mov r86 r0
        imm r2 0x27
        jeq r1 r2 @next_character
        imm r2 0x28
        jeq r1 r2 @next_punctuation
        imm r2 0x29
        jeq r1 r2 @next_punctuation
next_body:
        jlt r0 r82 @next_body_byte
        jmp @next_done
next_body_byte:
        loadb r1 r0
        imm r2 0x21
        jlt r1 r2 @next_done
        imm r2 0x3b
        jeq r1 r2 @next_done
        imm r2 0x28
        jeq r1 r2 @next_done
        imm r2 0x29
        jeq r1 r2 @next_done
        add r0 r91
        jmp @next_body
next_punctuation:
        add r0 r91
        jmp @next_done
next_character:
        add r0 r91
        jlt r0 r82 @next_character_byte
        jmp @invalid
next_character_byte:
        loadb r1 r0
        imm r2 0x5c
        jeq r1 r2 @next_character_escape
        add r0 r91
        jmp @next_character_close
next_character_escape:
        add r0 r91
        jlt r0 r82 @next_character_escape_byte
        jmp @invalid
next_character_escape_byte:
        add r0 r91
next_character_close:
        jlt r0 r82 @next_character_close_byte
        jmp @invalid
next_character_close_byte:
        loadb r1 r0
        imm r2 0x27
        jeq r1 r2 @next_character_done
        jmp @invalid
next_character_done:
        add r0 r91
next_done:
        mov r87 r0
        sub r87 r86
        mov r85 r0
        mov r0 r91
        ret

need_token:
        call @next_token
        jz r0 @invalid
        ret

; r0 packed ASCII, r1 length. Return r0=0/1 against current token.
token_equals:
        jeq r87 r1 @token_equals_begin
        mov r0 r90
        ret
token_equals_begin:
        mov r2 r90
        mov r3 r0
token_equals_loop:
        jeq r2 r1 @token_equals_true
        mov r4 r86
        add r4 r2
        loadb r5 r4
        imm r6 0x100
        mov r7 r3
        mod r7 r6
        jeq r5 r7 @token_equals_next
        mov r0 r90
        ret
token_equals_next:
        div r3 r6
        add r2 r91
        jmp @token_equals_loop
token_equals_true:
        mov r0 r91
        ret

is_open:
        imm r0 0x28
        imm r1 0x1
        call @token_equals
        ret
is_close:
        imm r0 0x29
        imm r1 0x1
        call @token_equals
        ret
is_def:
        imm r0 0x666564
        imm r1 0x3
        call @token_equals
        ret
is_int:
        imm r0 0x746e49
        imm r1 0x3
        call @token_equals
        ret
is_main:
        imm r0 0x6e69616d
        imm r1 0x4
        call @token_equals
        ret
is_if:
        imm r0 0x6669
        imm r1 0x2
        call @token_equals
        ret
is_let:
        imm r0 0x74656c
        imm r1 0x3
        call @token_equals
        ret
is_add:
        imm r0 0x2b
        imm r1 0x1
        call @token_equals
        ret
is_sub:
        imm r0 0x2d
        imm r1 0x1
        call @token_equals
        ret
is_mul:
        imm r0 0x2a
        imm r1 0x1
        call @token_equals
        ret
is_div:
        imm r0 0x2f
        imm r1 0x1
        call @token_equals
        ret
is_mod:
        imm r0 0x25
        imm r1 0x1
        call @token_equals
        ret
is_eq:
        imm r0 0x7165
        imm r1 0x2
        call @token_equals
        ret
is_lt:
        imm r0 0x746c
        imm r1 0x2
        call @token_equals
        ret
is_input:
        imm r0 0x7475706e69
        imm r1 0x5
        call @token_equals
        ret
is_read:
        imm r0 0x64616572
        imm r1 0x4
        call @token_equals
        ret
is_write:
        imm r0 0x6574697277
        imm r1 0x5
        call @token_equals
        ret
is_pair:
        imm r0 0x72696170
        imm r1 0x4
        call @token_equals
        ret
is_first:
        imm r0 0x7473726966
        imm r1 0x5
        call @token_equals
        ret
is_second:
        imm r0 0x646e6f636573
        imm r1 0x6
        call @token_equals
        ret

expect_open:
        call @need_token
        call @is_open
        jz r0 @invalid
        ret
expect_close:
        call @need_token
        call @is_close
        jz r0 @invalid
        ret
expect_int:
        call @need_token
        call @is_int
        jz r0 @invalid
        ret

; Parse current decimal token. Return value r0 and success flag r1.
parse_integer:
        jz r87 @parse_integer_fail
        mov r2 r90
        mov r3 r90
        mov r4 r90
        loadb r5 r86
        imm r6 0x27
        jeq r5 r6 @parse_character
        imm r6 0x2d
        jeq r5 r6 @parse_integer_minus
        jmp @parse_integer_loop
parse_integer_minus:
        mov r4 r91
        add r2 r91
        jeq r2 r87 @parse_integer_fail
parse_integer_loop:
        jeq r2 r87 @parse_integer_done
        mov r5 r86
        add r5 r2
        loadb r5 r5
        imm r6 0x30
        jlt r5 r6 @parse_integer_fail
        imm r7 0x3a
        jlt r5 r7 @parse_integer_digit
        jmp @parse_integer_fail
parse_integer_digit:
        sub r5 r6
        imm r6 0xa
        mul r3 r6
        add r3 r5
        add r2 r91
        jmp @parse_integer_loop
parse_integer_done:
        jz r4 @parse_integer_positive
        mov r0 r90
        sub r0 r3
        mov r1 r91
        ret
parse_integer_positive:
        mov r0 r3
        mov r1 r91
        ret
parse_integer_fail:
        mov r0 r90
        mov r1 r90
        ret

; Parse 'X' or one closed escape: \n, \r, \t, \s, \', or \\.
parse_character:
        imm r2 0x3
        jeq r87 r2 @parse_character_simple
        imm r2 0x4
        jeq r87 r2 @parse_character_escape
        jmp @parse_character_fail
parse_character_simple:
        loadb r2 r86
        imm r3 0x27
        jeq r2 r3 @parse_character_simple_end
        jmp @parse_character_fail
parse_character_simple_end:
        mov r2 r86
        imm r4 0x2
        add r2 r4
        loadb r2 r2
        jeq r2 r3 @parse_character_simple_value
        jmp @parse_character_fail
parse_character_simple_value:
        mov r2 r86
        add r2 r91
        loadb r0 r2
        imm r2 0x27
        jeq r0 r2 @parse_character_fail
        imm r2 0x5c
        jeq r0 r2 @parse_character_fail
        mov r1 r91
        ret
parse_character_escape:
        loadb r2 r86
        imm r3 0x27
        jeq r2 r3 @parse_character_escape_slash
        jmp @parse_character_fail
parse_character_escape_slash:
        mov r2 r86
        add r2 r91
        loadb r2 r2
        imm r4 0x5c
        jeq r2 r4 @parse_character_escape_end
        jmp @parse_character_fail
parse_character_escape_end:
        mov r2 r86
        imm r4 0x3
        add r2 r4
        loadb r2 r2
        jeq r2 r3 @parse_character_escape_value
        jmp @parse_character_fail
parse_character_escape_value:
        mov r2 r86
        imm r4 0x2
        add r2 r4
        loadb r2 r2
        imm r3 0x6e
        jeq r2 r3 @parse_character_newline
        imm r3 0x72
        jeq r2 r3 @parse_character_return
        imm r3 0x74
        jeq r2 r3 @parse_character_tab
        imm r3 0x73
        jeq r2 r3 @parse_character_space
        imm r3 0x27
        jeq r2 r3 @parse_character_quote
        imm r3 0x5c
        jeq r2 r3 @parse_character_slash
        jmp @parse_character_fail
parse_character_newline:
        imm r0 0xa
        jmp @parse_character_true
parse_character_return:
        imm r0 0xd
        jmp @parse_character_true
parse_character_tab:
        imm r0 0x9
        jmp @parse_character_true
parse_character_space:
        imm r0 0x20
        jmp @parse_character_true
parse_character_quote:
        imm r0 0x27
        jmp @parse_character_true
parse_character_slash:
        imm r0 0x5c
parse_character_true:
        mov r1 r91
        ret
parse_character_fail:
        mov r0 r90
        mov r1 r90
        ret

; Value stack stores evaluator intermediates and call arguments.
push_value:
        jeq r8a r97 @incomplete
        store r8a r0
        imm r1 0x8
        add r8a r1
        ret
pop_value:
        jeq r8a r96 @internal
        imm r1 0x8
        sub r8a r1
        load r0 r8a
        ret

; Function row is five words: name start/length, params start, body start, arity.
function_row:
        imm r1 0x28
        mul r0 r1
        add r0 r94
        ret

; Current token lookup. Return row pointer or zero.
find_function:
        mov r2 r90
find_function_loop:
        jeq r2 r88 @find_function_absent
        mov r0 r2
        call @function_row
        mov r3 r0
        mov r4 r3
        imm r5 0x8
        add r4 r5
        load r4 r4
        jeq r4 r87 @find_function_compare_begin
        jmp @find_function_next
find_function_compare_begin:
        load r4 r3
        mov r5 r90
find_function_compare_loop:
        jeq r5 r87 @find_function_present
        mov r6 r4
        add r6 r5
        loadb r6 r6
        mov r7 r86
        add r7 r5
        loadb r7 r7
        jeq r6 r7 @find_function_compare_next
        jmp @find_function_next
find_function_compare_next:
        add r5 r91
        jmp @find_function_compare_loop
find_function_next:
        add r2 r91
        jmp @find_function_loop
find_function_present:
        mov r0 r3
        ret
find_function_absent:
        mov r0 r90
        ret

; Reverse lexical lookup. Return environment row or zero.
find_environment:
        mov r2 r89
find_environment_loop:
        jeq r2 r8c @find_environment_absent
        sub r2 r91
        imm r0 0x18
        mul r0 r2
        add r0 r95
        mov r3 r0
        mov r4 r3
        imm r5 0x8
        add r4 r5
        load r4 r4
        jeq r4 r87 @find_environment_compare_begin
        jmp @find_environment_loop
find_environment_compare_begin:
        load r4 r3
        mov r5 r90
find_environment_compare_loop:
        jeq r5 r87 @find_environment_present
        mov r6 r4
        add r6 r5
        loadb r6 r6
        mov r7 r86
        add r7 r5
        loadb r7 r7
        jeq r6 r7 @find_environment_compare_next
        jmp @find_environment_loop
find_environment_compare_next:
        add r5 r91
        jmp @find_environment_compare_loop
find_environment_present:
        mov r0 r3
        ret
find_environment_absent:
        mov r0 r90
        ret

; r0=value, current token=name. Active shadowing rejects.
add_environment:
        mov r8 r0
        call @find_environment
        jnz r0 @invalid
        imm r0 0x18
        mul r0 r89
        add r0 r95
        store r0 r86
        imm r1 0x8
        add r0 r1
        store r0 r87
        add r0 r1
        store r0 r8
        add r89 r91
        imm r1 0x15555
        jlt r89 r1 @add_environment_done
        jmp @incomplete
add_environment_done:
        ret

; Structurally consume one expression without evaluating it.
skip_expression:
        call @need_token
        call @is_open
        jnz r0 @skip_expression_list
        ret
skip_expression_list:
        mov r8f r91
skip_expression_loop:
        call @need_token
        call @is_open
        jnz r0 @skip_expression_open
        call @is_close
        jnz r0 @skip_expression_close
        jmp @skip_expression_loop
skip_expression_open:
        add r8f r91
        imm r0 0x100
        jlt r8f r0 @skip_expression_loop
        jmp @incomplete
skip_expression_close:
        sub r8f r91
        jnz r8f @skip_expression_loop
        ret

; Census declarations and retain only signatures plus body source positions.
census:
        mov r85 r81
        mov r88 r90
        mov r8b r90
census_loop:
        call @next_token
        jz r0 @census_done
        call @is_open
        jz r0 @invalid
        call @need_token
        call @is_def
        jz r0 @invalid
        call @need_token
        call @find_function
        jnz r0 @invalid
        mov r0 r88
        call @function_row
        mov r8c r0
        store r8c r86
        mov r0 r8c
        imm r1 0x8
        add r0 r1
        store r0 r87
        call @is_main
        jz r0 @census_parameters
        jnz r8b @invalid
        mov r8b r8c
census_parameters:
        call @expect_open
        mov r0 r8c
        imm r1 0x10
        add r0 r1
        store r0 r86
        mov r8f r90
census_parameter_loop:
        call @need_token
        call @is_close
        jnz r0 @census_parameters_done
        call @is_open
        jz r0 @invalid
        call @need_token
        call @expect_int
        call @expect_close
        add r8f r91
        jmp @census_parameter_loop
census_parameters_done:
        call @expect_int
        mov r0 r8c
        imm r1 0x18
        add r0 r1
        store r0 r85
        mov r0 r8c
        imm r1 0x20
        add r0 r1
        store r0 r8f
        call @skip_expression
        call @expect_close
        add r88 r91
        imm r0 0x1000
        jlt r88 r0 @census_loop
        jmp @incomplete
census_done:
        jz r8b @invalid
        mov r0 r8b
        imm r1 0x20
        add r0 r1
        load r0 r0
        jnz r0 @invalid
        ret

; Validate every body before evaluation or output. All Gamma values are Int,
; so this pass checks structure, lexical names, call targets, and exact arity.
validate_program:
        mov r9d r90
validate_program_loop:
        jeq r9d r88 @validate_program_done
        mov r0 r9d
        call @function_row
        mov r9c r0
        mov r89 r90
        mov r8c r90
        mov r0 r9c
        imm r1 0x10
        add r0 r1
        load r85 r0
        call @expect_open
        mov r8f r90
validate_parameter_loop:
        call @need_token
        call @is_close
        jnz r0 @validate_parameters_done
        call @is_open
        jz r0 @invalid
        call @need_token
        mov r0 r90
        call @add_environment
        call @expect_int
        call @expect_close
        add r8f r91
        jmp @validate_parameter_loop
validate_parameters_done:
        mov r0 r9c
        imm r1 0x20
        add r0 r1
        load r0 r0
        jeq r8f r0 @validate_return_type
        jmp @invalid
validate_return_type:
        call @expect_int
        call @validate_expression
        call @expect_close
        add r9d r91
        jmp @validate_program_loop
validate_program_done:
        ret

validate_expression:
        call @need_token
        call @is_open
        jnz r0 @validate_list_expression
        call @parse_integer
        jnz r1 @validate_expression_done
        call @find_environment
        jz r0 @invalid
validate_expression_done:
        ret

validate_list_expression:
        call @need_token
        call @is_if
        jnz r0 @validate_if_expression
        call @is_let
        jnz r0 @validate_let_expression
        call @is_add
        jnz r0 @validate_binary_expression
        call @is_sub
        jnz r0 @validate_binary_expression
        call @is_mul
        jnz r0 @validate_binary_expression
        call @is_div
        jnz r0 @validate_binary_expression
        call @is_mod
        jnz r0 @validate_binary_expression
        call @is_eq
        jnz r0 @validate_binary_expression
        call @is_lt
        jnz r0 @validate_binary_expression
        call @is_input
        jnz r0 @validate_input_expression
        call @is_read
        jnz r0 @validate_unary_expression
        call @is_write
        jnz r0 @validate_unary_expression
        call @is_pair
        jnz r0 @validate_binary_expression
        call @is_first
        jnz r0 @validate_unary_expression
        call @is_second
        jnz r0 @validate_unary_expression
        jmp @validate_call_expression
validate_if_expression:
        call @validate_expression
        call @validate_expression
        call @validate_expression
        call @expect_close
        ret
validate_binary_expression:
        call @validate_expression
        call @validate_expression
        call @expect_close
        ret
validate_input_expression:
        call @expect_close
        ret
validate_unary_expression:
        call @validate_expression
        call @expect_close
        ret
validate_let_expression:
        mov r0 r89
        call @push_value
        call @need_token
        mov r0 r86
        call @push_value
        mov r0 r87
        call @push_value
        call @expect_int
        call @validate_expression
        call @pop_value
        mov r87 r0
        call @pop_value
        mov r86 r0
        mov r0 r90
        call @add_environment
        call @validate_expression
        call @expect_close
        call @pop_value
        mov r89 r0
        ret
validate_call_expression:
        call @find_function
        jz r0 @invalid
        add r8e r91
        imm r1 0x100
        jlt r8e r1 @validate_call_context_ready
        jmp @incomplete
validate_call_context_ready:
        mov r6 r0
        call @call_context
        mov r7 r0
        store r7 r6
        imm r1 0x10
        add r7 r1
        store r7 r90
validate_call_arguments:
        call @need_token
        call @is_close
        jnz r0 @validate_call_done
        mov r85 r86
        call @validate_expression
        call @call_context
        imm r1 0x10
        add r0 r1
        load r2 r0
        add r2 r91
        store r0 r2
        jmp @validate_call_arguments
validate_call_done:
        call @call_context
        mov r7 r0
        load r6 r7
        imm r1 0x10
        add r7 r1
        load r2 r7
        mov r0 r6
        imm r1 0x20
        add r0 r1
        load r0 r0
        jeq r2 r0 @validate_call_ready
        jmp @invalid
validate_call_ready:
        sub r8e r91
        ret

; Call-context row by current r8e: function row, argument base, argument count.
call_context:
        imm r0 0x18
        mul r0 r8e
        imm r1 0x1f00000
        add r0 r1
        ret

; Enter r0 function with argument base r1 and count r2. Return value r0.
enter_function:
        mov r3 r8d
        imm r4 0x30
        add r4 r3
        imm r5 0x1f00000
        jlt r5 r4 @incomplete
        store r3 r85
        imm r5 0x8
        add r3 r5
        store r3 r89
        add r3 r5
        store r3 r8c
        add r3 r5
        store r3 r0
        add r3 r5
        store r3 r1
        add r3 r5
        store r3 r2
        mov r8d r4
        mov r8c r89
        mov r3 r0
        imm r4 0x10
        add r3 r4
        load r85 r3
        call @expect_open
        mov r8f r90
enter_parameter_loop:
        call @need_token
        call @is_close
        jnz r0 @enter_parameters_done
        call @is_open
        jz r0 @invalid
        call @need_token
        mov r0 r8d
        imm r1 0x10
        sub r0 r1
        load r0 r0
        mov r1 r8f
        imm r2 0x8
        mul r1 r2
        add r0 r1
        load r0 r0
        call @add_environment
        call @expect_int
        call @expect_close
        add r8f r91
        jmp @enter_parameter_loop
enter_parameters_done:
        mov r0 r8d
        imm r1 0x8
        sub r0 r1
        load r0 r0
        jeq r8f r0 @enter_parameters_match
        jmp @invalid
enter_parameters_match:
        mov r0 r8d
        imm r1 0x10
        sub r0 r1
        load r8a r0
enter_body:
        mov r0 r8d
        imm r1 0x18
        sub r0 r1
        load r0 r0
        imm r1 0x18
        add r0 r1
        load r85 r0
        mov r98 r90
        call @eval_tail_expression
        jnz r98 @enter_tail_restart
        call @push_value
        mov r0 r8d
        imm r1 0x30
        sub r0 r1
        mov r8d r0
        load r85 r0
        imm r1 0x8
        add r0 r1
        load r89 r0
        add r0 r1
        load r8c r0
        call @pop_value
        ret

enter_tail_restart:
        mov r89 r8c
        mov r0 r8d
        imm r1 0x18
        sub r0 r1
        store r0 r99
        imm r1 0x8
        add r0 r1
        store r0 r9a
        add r0 r1
        store r0 r9b
        mov r0 r99
        imm r1 0x10
        add r0 r1
        load r85 r0
        call @expect_open
        mov r8f r90
        mov r98 r90
        jmp @enter_parameter_loop

; Evaluate one expression in function-tail position. Tail if/let paths loop;
; a tail call returns a request for enter_function to reuse this activation.
eval_tail_expression:
        mov r9c r85
        call @need_token
        call @is_open
        jz r0 @eval_tail_fallback_reset
        call @need_token
        call @is_if
        jnz r0 @eval_tail_if
        call @is_let
        jnz r0 @eval_tail_let
        call @is_add
        jnz r0 @eval_tail_fallback_reset
        call @is_sub
        jnz r0 @eval_tail_fallback_reset
        call @is_mul
        jnz r0 @eval_tail_fallback_reset
        call @is_div
        jnz r0 @eval_tail_fallback_reset
        call @is_mod
        jnz r0 @eval_tail_fallback_reset
        call @is_eq
        jnz r0 @eval_tail_fallback_reset
        call @is_lt
        jnz r0 @eval_tail_fallback_reset
        call @is_input
        jnz r0 @eval_tail_fallback_reset
        call @is_read
        jnz r0 @eval_tail_fallback_reset
        call @is_write
        jnz r0 @eval_tail_fallback_reset
        call @is_pair
        jnz r0 @eval_tail_fallback_reset
        call @is_first
        jnz r0 @eval_tail_fallback_reset
        call @is_second
        jnz r0 @eval_tail_fallback_reset
        jmp @eval_tail_call
eval_tail_fallback_reset:
        mov r85 r9c
        call @eval_expression
        ret
eval_tail_if:
        call @eval_expression
        jz r0 @eval_tail_if_false
        jmp @eval_tail_expression
eval_tail_if_false:
        call @skip_expression
        jmp @eval_tail_expression
eval_tail_let:
        call @need_token
        mov r0 r86
        call @push_value
        mov r0 r87
        call @push_value
        call @expect_int
        call @eval_expression
        mov r8 r0
        call @pop_value
        mov r87 r0
        call @pop_value
        mov r86 r0
        mov r0 r8
        call @add_environment
        jmp @eval_tail_expression

eval_tail_call:
        call @find_function
        jz r0 @authored_trap
        add r8e r91
        imm r1 0x100
        jlt r8e r1 @eval_tail_call_context_ready
        jmp @incomplete
eval_tail_call_context_ready:
        mov r6 r0
        call @call_context
        mov r7 r0
        store r7 r6
        imm r1 0x8
        add r7 r1
        store r7 r8a
        add r7 r1
        store r7 r90
eval_tail_call_arguments:
        call @need_token
        call @is_close
        jnz r0 @eval_tail_call_done
        mov r85 r86
        call @eval_expression
        call @push_value
        call @call_context
        imm r1 0x10
        add r0 r1
        load r2 r0
        add r2 r91
        store r0 r2
        jmp @eval_tail_call_arguments
eval_tail_call_done:
        call @call_context
        mov r7 r0
        load r99 r7
        imm r1 0x8
        add r7 r1
        load r9a r7
        add r7 r1
        load r9b r7
        mov r0 r99
        imm r1 0x20
        add r0 r1
        load r0 r0
        jeq r9b r0 @eval_tail_call_ready
        jmp @invalid
eval_tail_call_ready:
        sub r8e r91
        mov r98 r91
        ret

; Evaluate one expression at r85 and leave r85 after it.
eval_expression:
        call @need_token
        call @is_open
        jnz r0 @eval_list
        call @parse_integer
        jnz r1 @eval_return
        call @find_environment
        jz r0 @authored_trap
        imm r1 0x10
        add r0 r1
        load r0 r0
eval_return:
        ret

eval_list:
        call @need_token
        call @is_if
        jnz r0 @eval_if
        call @is_let
        jnz r0 @eval_let
        call @is_add
        jnz r0 @eval_add
        call @is_sub
        jnz r0 @eval_sub
        call @is_mul
        jnz r0 @eval_mul
        call @is_div
        jnz r0 @eval_div
        call @is_mod
        jnz r0 @eval_mod
        call @is_eq
        jnz r0 @eval_eq
        call @is_lt
        jnz r0 @eval_lt
        call @is_input
        jnz r0 @eval_input
        call @is_read
        jnz r0 @eval_read
        call @is_write
        jnz r0 @eval_write
        call @is_pair
        jnz r0 @eval_pair
        call @is_first
        jnz r0 @eval_first
        call @is_second
        jnz r0 @eval_second
        jmp @eval_call

eval_if:
        call @eval_expression
        jz r0 @eval_if_false
        call @eval_expression
        call @push_value
        call @skip_expression
        call @expect_close
        call @pop_value
        ret
eval_if_false:
        call @skip_expression
        call @eval_expression
        call @push_value
        call @expect_close
        call @pop_value
        ret

eval_let:
        mov r0 r89
        call @push_value
        call @need_token
        mov r0 r86
        call @push_value
        mov r0 r87
        call @push_value
        call @expect_int
        call @eval_expression
        mov r6 r0
        call @pop_value
        mov r87 r0
        call @pop_value
        mov r86 r0
        mov r0 r6
        call @add_environment
        call @eval_expression
        call @push_value
        call @expect_close
        call @pop_value
        mov r6 r0
        call @pop_value
        mov r89 r0
        mov r0 r6
        ret

eval_add:
        imm r0 0x0
        jmp @eval_binary
eval_sub:
        imm r0 0x1
        jmp @eval_binary
eval_mul:
        imm r0 0x2
        jmp @eval_binary
eval_div:
        imm r0 0x3
        jmp @eval_binary
eval_mod:
        imm r0 0x4
        jmp @eval_binary
eval_eq:
        imm r0 0x5
        jmp @eval_binary
eval_lt:
        imm r0 0x6

eval_binary:
        call @push_value
        call @eval_expression
        call @push_value
        call @eval_expression
        call @push_value
        call @expect_close
        call @pop_value
        mov r5 r0
        call @pop_value
        mov r4 r0
        call @pop_value
        mov r6 r0
        mov r0 r4
        jz r6 @eval_binary_add
        imm r1 0x1
        jeq r6 r1 @eval_binary_sub
        imm r1 0x2
        jeq r6 r1 @eval_binary_mul
        imm r1 0x3
        jeq r6 r1 @eval_binary_div
        imm r1 0x4
        jeq r6 r1 @eval_binary_mod
        imm r1 0x5
        jeq r6 r1 @eval_binary_eq
        jmp @eval_binary_lt
eval_binary_add:
        add r0 r5
        ret
eval_binary_sub:
        sub r0 r5
        ret
eval_binary_mul:
        mul r0 r5
        ret
eval_binary_div:
        div r0 r5
        ret
eval_binary_mod:
        mod r0 r5
        ret
eval_binary_eq:
        jeq r0 r5 @eval_binary_true
        mov r0 r90
        ret
eval_binary_lt:
        jlt r0 r5 @eval_binary_true
        mov r0 r90
        ret
eval_binary_true:
        mov r0 r91
        ret

eval_input:
        call @expect_close
        mov r0 r84
        ret
eval_read:
        call @eval_expression
        jlt r0 r90 @authored_trap
        jlt r0 r84 @eval_read_ok
        jmp @authored_trap
eval_read_ok:
        add r0 r83
        loadb r0 r0
        call @push_value
        call @expect_close
        call @pop_value
        ret
eval_write:
        call @eval_expression
        jlt r0 r90 @authored_trap
        imm r1 0x100
        jlt r0 r1 @eval_write_ok
        jmp @authored_trap
eval_write_ok:
        call @write_output
        call @push_value
        call @expect_close
        call @pop_value
        ret

eval_pair:
        call @eval_expression
        call @push_value
        call @eval_expression
        call @push_value
        call @expect_close
        call @pop_value
        mov r5 r0
        call @pop_value
        mov r4 r0
        mov r6 ra0
        imm r1 0x18
        add r6 r1
        jlt ra1 r6 @incomplete
        mov r0 ra0
        imm r1 0x50414952
        store r0 r1
        imm r1 0x8
        add r0 r1
        store r0 r4
        add r0 r1
        store r0 r5
        mov r0 ra0
        mov ra0 r6
        ret

validate_pair:
        mov r6 r0
        imm r1 0x2000000
        jlt r6 r1 @authored_trap
        jlt r6 ra0 @validate_pair_extent
        jmp @authored_trap
validate_pair_extent:
        mov r2 r6
        sub r2 r1
        imm r3 0x18
        mod r2 r3
        jnz r2 @authored_trap
        load r2 r6
        imm r3 0x50414952
        jeq r2 r3 @validate_pair_done
        jmp @authored_trap
validate_pair_done:
        mov r0 r6
        ret

eval_first:
        call @eval_expression
        call @validate_pair
        imm r1 0x8
        add r0 r1
        load r0 r0
        call @push_value
        call @expect_close
        call @pop_value
        ret

eval_second:
        call @eval_expression
        call @validate_pair
        imm r1 0x10
        add r0 r1
        load r0 r0
        call @push_value
        call @expect_close
        call @pop_value
        ret

; Current token is the callee name.
eval_call:
        call @find_function
        jz r0 @authored_trap
        add r8e r91
        imm r1 0x100
        jlt r8e r1 @eval_call_context_ready
        jmp @incomplete
eval_call_context_ready:
        mov r6 r0
        call @call_context
        mov r7 r0
        store r7 r6
        imm r1 0x8
        add r7 r1
        store r7 r8a
        add r7 r1
        store r7 r90
eval_call_arguments:
        call @need_token
        call @is_close
        jnz r0 @eval_call_done
        mov r85 r86
        call @eval_expression
        call @push_value
        call @call_context
        imm r1 0x10
        add r0 r1
        load r2 r0
        add r2 r91
        store r0 r2
        jmp @eval_call_arguments
eval_call_done:
        call @call_context
        mov r7 r0
        load r6 r7
        imm r1 0x8
        add r7 r1
        load r1 r7
        imm r4 0x8
        add r7 r4
        load r2 r7
        mov r3 r6
        imm r4 0x20
        add r3 r4
        load r3 r3
        jeq r2 r3 @eval_call_enter
        jmp @invalid
eval_call_enter:
        mov r0 r6
        call @enter_function
        mov r6 r0
        call @call_context
        imm r1 0x8
        add r0 r1
        load r8a r0
        sub r8e r91
        mov r0 r6
        ret

invalid:
        imm r0 0x1
        halt r0
authored_trap:
        imm r0 0x2
        halt r0
incomplete:
        imm r0 0x3
        halt r0
internal:
        imm r0 0x4
        halt r0
