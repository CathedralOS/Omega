; Diagnostic only: Formed is neither proof acceptance nor subject authority.
(def $application () Int 1)
(def main () Int
  (let result Int (form_derivation_theory)
    (let tag Int (first result)
      (let prefix Int (write tag)
        (let observed Int
          (if (eq tag 4)
            (formation_test_formed (second result))
            (formation_test_failure (second result)))
          (pair 0 1))))))

(def formation_test_formed ((payload Int)) Int
  (let frame Int (formed_frame payload)
    (let theory Int (formation_test_word (admission_theory_end frame) 8)
      (let proposition Int (formation_test_word (admission_proposition_end frame) 8)
        (let certificate Int (formation_test_word (admission_certificate_end frame) 8)
          (let sorts Int (formation_test_word (formed_sort_count payload) 8)
            (let constructors Int (formation_test_word (formation_index_count (formed_constructors payload)) 8)
              (formation_test_word (formation_index_count (formed_functions payload)) 8))))))))

(def formation_test_failure ((failure Int)) Int
  (let code Int (formation_test_word (admission_failure_code failure) 8)
    (let coordinate Int (formation_test_word (admission_failure_coordinate failure) 8)
      (let limit Int (formation_test_word (admission_failure_limit failure) 8)
        (formation_test_word (admission_failure_requested failure) 8)))))

(def formation_test_word ((value Int) (remaining Int)) Int
  (if (eq remaining 0)
    0
    (let byte Int (write (% value 256))
      (formation_test_word (/ value 256) (- remaining 1)))))
