; Candidate D residual hole: the same declaration, consumer, and field values
; as nominal_order.delta, but the construction swaps fields three and four.
; Both positions are Int, so every declaration and call judgment accepts; the
; program compiles, runs, and publishes the wrong byte (6, not 4). Positional
; agreement among same-typed fields stays manual under nominal typing too.
(data ArgumentFrame
  (ArgumentFrame Int Int Int Int Int Int Int))
(def consume_frame ((frame ArgumentFrame)) Int
  (match frame
    ((ArgumentFrame node actual_count arguments expected_count
       expected_types result_type locals)
     (+ (- node actual_count)
        (+ (- arguments expected_count)
           (+ (- expected_types result_type) locals))))))
(def main ((source Bytes)) Bytes
  (bytes_single (consume_frame (ArgumentFrame 1 2 4 3 5 6 7))))
