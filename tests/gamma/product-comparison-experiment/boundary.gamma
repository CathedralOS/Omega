; Candidate C: a checked frame boundary, not a checked payload. The producer
; wraps the same seven-field spine in the dispatcher's (pair kind payload)
; frame; the consumer checks the kind word before decoding and maps a wrong
; kind to a chosen scalar. This is the shape the selected checker already
; uses, where the dispatcher maps an unknown continuation kind to
; InternalFailure code 1. The payload spine stays an unchecked convention.
(def argument_frame_kind () Int 3)

(def build_frame
  ((node Int) (actual_count Int) (arguments Int) (expected_count Int)
   (expected_types Int) (result_type Int) (locals Int)) Int
  (pair (argument_frame_kind)
    (pair node (pair actual_count (pair arguments
      (pair expected_count (pair expected_types (pair result_type locals))))))))

(def consume_fields ((payload Int)) Int
  (let ((actual Int (second payload))
        (arguments_and_expected Int (second actual))
        (expected Int (second arguments_and_expected))
        (types_and_result Int (second expected))
        (result_and_locals Int (second types_and_result)))
    (+ (first payload) (+ (first actual) (+ (first arguments_and_expected)
      (+ (first expected) (+ (first types_and_result)
        (+ (first result_and_locals) (second result_and_locals)))))))))

(def consume_frame ((frame Int)) Int
  (if (eq (first frame) (argument_frame_kind))
    (consume_fields (second frame))
    203))

(def main () Int (consume_frame (build_frame 1 2 3 4 5 6 7)))
