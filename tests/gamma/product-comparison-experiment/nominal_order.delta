; Candidate D order witness: the consumer folds fields with alternating signs
; so the result depends on construction order, not just the field multiset.
; A correct seven-field construction returns 4; compare nominal_swapped.delta.
(data ArgumentFrame
  (ArgumentFrame Int Int Int Int Int Int Int))
(def consume_frame ((frame ArgumentFrame)) Int
  (match frame
    ((ArgumentFrame node actual_count arguments expected_count
       expected_types result_type locals)
     (+ (- node actual_count)
        (+ (- arguments expected_count)
           (+ (- expected_types result_type) locals))))))
(def main ((source Bytes)) Bytes
  (bytes_single (consume_frame (ArgumentFrame 1 2 3 4 5 6 7))))
