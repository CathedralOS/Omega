; Candidate D, the seven-field payload: the continuation record as a nominal
; Delta declaration. build_frame mirrors typing_arguments' field order and
; consume_frame mirrors typing_resume_argument's decode, but the declaration
; checks producer/consumer agreement instead of a manual spine convention.
(data ArgumentFrame
  (ArgumentFrame Int Int Int Int Int Int Int))
(def build_frame
  ((node Int) (actual_count Int) (arguments Int) (expected_count Int)
   (expected_types Int) (result_type Int) (locals Int)) ArgumentFrame
  (ArgumentFrame node actual_count arguments expected_count
    expected_types result_type locals))
(def consume_frame ((frame ArgumentFrame)) Int
  (match frame
    ((ArgumentFrame node actual_count arguments expected_count
       expected_types result_type locals)
     (+ node (+ actual_count (+ arguments (+ expected_count
       (+ expected_types (+ result_type locals)))))))))
(def main ((source Bytes)) Bytes
  (bytes_single (consume_frame (build_frame 1 2 3 4 5 6 7))))
