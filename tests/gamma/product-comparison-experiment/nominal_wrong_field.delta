; Candidate D, per-field type disagreement: a Bytes argument in the first
; Int field position. The argument judgment rejects it at compile time with
; the argument's source coordinate, where a pair spine would trap only when
; the consumer projected the wrong shape.
(data ArgumentFrame
  (ArgumentFrame Int Int Int Int Int Int Int))
(def consume_frame ((frame ArgumentFrame)) Int
  (match frame
    ((ArgumentFrame node actual_count arguments expected_count
       expected_types result_type locals)
     node)))
(def main ((source Bytes)) Bytes
  (bytes_single
    (consume_frame (ArgumentFrame (bytes_single 0) 2 3 4 5 6 7))))
