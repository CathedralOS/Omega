; Candidate D, the forged-identity analog: OtherFrame declares exactly the
; same seven-Int shape, so it is a byte-for-byte layout forgery of
; ArgumentFrame. Nominal typing rejects the delivery at compile time because
; identity is the declaration itself, not a forgeable header word; the hole
; forged.gamma demonstrates under source-level candidate B cannot exist.
(data ArgumentFrame
  (ArgumentFrame Int Int Int Int Int Int Int))
(data OtherFrame
  (OtherFrame Int Int Int Int Int Int Int))
(def consume_frame ((frame ArgumentFrame)) Int
  (match frame
    ((ArgumentFrame node actual_count arguments expected_count
       expected_types result_type locals)
     node)))
(def main ((source Bytes)) Bytes
  (bytes_single (consume_frame (OtherFrame 1 2 3 4 5 6 7))))
