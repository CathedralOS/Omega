; Candidate D with the order hole closed: each field carries its own nominal
; wrapper type, so positions disagree in type and a swap rejects at compile
; time. The price is seven extra declarations plus one match per field read,
; the only form of order checking nominal typing offers this payload.
(data NodeF (NodeF Int))
(data ActualF (ActualF Int))
(data ArgumentsF (ArgumentsF Int))
(data ExpectedF (ExpectedF Int))
(data TypesF (TypesF Int))
(data ResultF (ResultF Int))
(data LocalsF (LocalsF Int))
(data ArgumentFrame
  (ArgumentFrame NodeF ActualF ArgumentsF ExpectedF TypesF ResultF
    LocalsF))
(def consume_frame ((frame ArgumentFrame)) Int
  (match frame
    ((ArgumentFrame node actual_count arguments expected_count
       expected_types result_type locals)
     (+ (- (match node ((NodeF n) n))
           (match actual_count ((ActualF a) a)))
        (+ (- (match arguments ((ArgumentsF g) g))
              (match expected_count ((ExpectedF e) e)))
           (+ (- (match expected_types ((TypesF t) t))
                 (match result_type ((ResultF r) r)))
              (match locals ((LocalsF l) l))))))))
(def main ((source Bytes)) Bytes
  (bytes_single (consume_frame
    (ArgumentFrame (NodeF 1) (ActualF 2) (ArgumentsF 3) (ExpectedF 4)
      (TypesF 5) (ResultF 6) (LocalsF 7)))))
