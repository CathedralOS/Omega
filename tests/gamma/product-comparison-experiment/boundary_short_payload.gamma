; Candidate C given the right kind over a six-field payload spine. The
; boundary check passes and the decode traps exactly like candidate A's
; short producer and B's forged header: the kind word does not describe the
; payload shape, which remains a manual agreement.
(def argument_frame_kind () Int 3)

(def consume_fields ((payload Int)) Int
  (let ((actual Int (second payload))
        (arguments_and_expected Int (second actual))
        (expected Int (second arguments_and_expected))
        (types_and_result Int (second expected))
        (result_and_locals Int (second types_and_result)))
    (+ (first payload) (+ (first actual) (+ (first arguments_and_expected)
      (+ (first expected) (+ (first types_and_result)
        (+ (first result_and_locals) (second result_and_locals)))))))))

(def consume_frame ((frame Int)) Int
  (if (eq (first frame) (argument_frame_kind))
    (consume_fields (second frame))
    203))

(def main () Int
  (consume_frame (pair 3
    (pair 1 (pair 2 (pair 3 (pair 4 (pair 5 6))))))))
