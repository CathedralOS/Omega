; Candidate D, arity disagreement: a producer supplying six fields to the
; declared seven-field constructor. The checker's declaration-versus-call
; judgment rejects at compile time with a source coordinate; no program exists
; to trap. The pair analog is pairs_short.gamma's authored trap, status 2.
(data ArgumentFrame
  (ArgumentFrame Int Int Int Int Int Int Int))
(def build_frame
  ((node Int) (actual_count Int) (arguments Int) (expected_count Int)
   (expected_types Int) (result_type Int)) ArgumentFrame
  (ArgumentFrame node actual_count arguments expected_count
    expected_types result_type))
(def main ((source Bytes)) Bytes
  (bytes_single 0))
