// Library package for corpus fixtures: one abstract Sink service, a silent provider for
// it, and an ordinary silent logger that only publishes a broad Sink
// allowance (wiki/spec/build/behavior_exclusions.md, Console rows).

machine build(builder: &mut Build) {
    Build::package(builder, "logger_kit");
    Build::select_provider<Sink, QuietSink>(builder, linux_arm64);
    Build::select_provider<Sink, QuietSink>(builder, linux_x86_64);
    Build::select_provider<Sink, QuietSink>(builder, macos_arm64);
    Build::select_provider<Sink, QuietSink>(builder, macos_x86_64);
    Build::select_provider<Sink, QuietSink>(builder, windows_x86_64);
    Build::select_provider<Sink, QuietSink>(builder, uefi_x86_64);
    Build::select_provider<Sink, QuietSink>(builder, cross_platform_cli);
    Build::select_provider<Sink, QuietSink>(builder, local_unchecked);
    Build::select_provider<Sink, QuietSink>(builder, alpha_bootstrap);
}
