// `Sink` stands in for an abstract output service such as Console: invoking
// it through a boundary is a service invocation whatever the selected
// provider does. `log_quiet` merely retains the conservative allowance; its
// verified body never invokes the service.
module main;


public boundary trait Sink {
    machine emit(text: &[u8]) reaches;
}

public data QuietSink { }

public QuietSinkProvider satisfies Sink {
    Sink::emit = QuietSink::emit;
}

machine QuietSink::emit(text: &[u8])
satisfies Sink::emit
{
}

public machine log_quiet(text: &[u8])
reaches Sink
{
    let marker: u8 = 0;
}
