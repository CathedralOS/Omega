// package-manager fixture: composes assert-kit's NoOpAssert and excludes
// Trap from the product; the optional optimization must not decide the
// verdict.

machine build(builder: &mut Build) {
    Build::application(builder, "no_op_assert_app");
    Build::depend(builder, Source::Path { location: "../assert-kit" });
    Build::select_provider<assert_kit::main::Assert, assert_kit::main::NoOpAssert>(builder);
    Optimizations::enable(&mut builder.optimizations, Optimization::ControlFlowCleanup);
    Build::exclude_crash(builder, CrashCause::Trap);
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
}
