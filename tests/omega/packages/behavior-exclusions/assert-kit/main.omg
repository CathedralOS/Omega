// The shared requirement permits a guarded Trap without requiring it. Both
// implementations satisfy it; neither edits the public ceiling. Which one an
// application composes is ordinary build provider selection.
//
// The helper and the separate direct-Unit control exercise the same crash
// exclusion across an ordinary call and a direct guarded trap.
module main;

use omega::language::core::binding;

pub boundary trait Assert {
    machine check(ok: bool) crashes Trap;
}

machine verify(ok: bool) -> bool
crashes Trap
{
    transition ok { true -> pass() false -> fail() }
    state pass() -> bool { true }
    state fail() -> bool { crash Trap; }
}

pub data CheckingAssert { }

machine CheckingAssert::check(ok: bool)
satisfies Assert::check
crashes Trap
{
    let verdict: bool = verify(ok);
}

pub data NoOpAssert { }

machine NoOpAssert::check(ok: bool)
satisfies Assert::check
{
}
