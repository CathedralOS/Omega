// package-manager fixture: excludes the Sink service; the composition only
// ever calls the silent ordinary logger, so the exclusion holds despite the
// logger's published allowance.

machine build(builder: &mut Build) {
    Build::application(builder, "quiet_logger_app");
    Build::depend(builder, Source::Path { location: "../logger-kit" });
    builder.exclude_service<Sink>();
    builder.roots.bind(linux_x86_64::ProgramEntry, main);
    builder.roots.bind(linux_arm64::ProgramEntry, main);
    builder.roots.bind(macos_arm64::ProgramEntry, main);
    builder.roots.bind(windows_x86_64::ProgramEntry, main);
}
