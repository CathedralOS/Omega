// package-manager fixture: excludes the Sink service while composing a
// silent provider for a real Sink invocation; the exclusion must reject.

machine build(builder: &mut Build) {
    Build::application(builder, "sink_app");
    Build::depend(builder, Source::Path { location: "../logger-kit" });
    Build::select_provider<logger_kit::main::Sink, logger_kit::main::QuietSink>(builder);
    builder.exclude_service<Sink>();
    Build::bind(builder, linux_x86_64::ProgramEntry, Main::main);
    Build::bind(builder, linux_arm64::ProgramEntry, Main::main);
    Build::bind(builder, macos_arm64::ProgramEntry, Main::main);
    Build::bind(builder, windows_x86_64::ProgramEntry, Main::main);
}
