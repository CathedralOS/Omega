// Public reach of one exact ordinary-package filesystem boundary.
use host_services::filesystem_host;
use omega::language::core::binding;

pub data Journal {
    files: Binding<FilesystemHost>;
    written: i64;
}

pub machine Journal::append_line(journal: &mut Journal, descriptor: i32, line: &[u8])
reaches FilesystemHost
invokes FilesystemHost;
{
    journal.written = journal.files.write(descriptor, line);
}
