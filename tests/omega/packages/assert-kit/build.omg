// Library package for corpus fixtures: one assertion library with a checking and a no-op
// implementation behind the same public Trap ceiling
// (wiki/spec/build/behavior_exclusions.md). The library composes the no-op
// implementation by default; an application selects the one it composes.

machine build(builder: &mut Build) {
    Build::package(builder, "assert_kit");
    Build::select_provider<Assert, NoOpAssert>(builder, linux_arm64);
    Build::select_provider<Assert, NoOpAssert>(builder, linux_x86_64);
    Build::select_provider<Assert, NoOpAssert>(builder, macos_arm64);
    Build::select_provider<Assert, NoOpAssert>(builder, macos_x86_64);
    Build::select_provider<Assert, NoOpAssert>(builder, windows_x86_64);
    Build::select_provider<Assert, NoOpAssert>(builder, uefi_x86_64);
    Build::select_provider<Assert, NoOpAssert>(builder, cross_platform_cli);
    Build::select_provider<Assert, NoOpAssert>(builder, local_unchecked);
    Build::select_provider<Assert, NoOpAssert>(builder, alpha_bootstrap);
}
