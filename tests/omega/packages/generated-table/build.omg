// package-manager fixture: build reads inputs/table.txt and publishes generated
// Omega source only through its compiler-owned Source and Output facets.

machine build(builder: &mut Build) {
    Build::package(builder, "generated_table");
    let mut input_bytes: [u8; 64];
    let input: BuildPath = BuildSource::resolve(&builder.source, "inputs/table.txt");
    let input_descriptor: i32 = BuildSource::open(&builder.source, input, 0);
    let input_count: i64 = BuildSource::read(&builder.source, input_descriptor, &mut input_bytes, 64);
    let input_close: i32 = BuildSource::close(&builder.source, input_descriptor);

    let generated: BuildPath = BuildOutput::resolve(&builder.output, "table.generated.omg");
    let output_descriptor: i32 = BuildOutput::create(&mut builder.output, generated, 438);
    let output_count: i64 = BuildOutput::write(
        &mut builder.output,
        output_descriptor,
        "pub machine table_size() -> u64 {\n    3\n}\n"
    );
    let output_close: i32 = BuildOutput::close(&mut builder.output, output_descriptor);
    BuildOutput::include_source(&mut builder.output, generated);
}
