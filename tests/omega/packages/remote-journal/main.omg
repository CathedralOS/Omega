// Retained accepted-filesystem plus package-local network reach fixture.
use host_services::filesystem_host;
use omega::language::core::binding;

pub boundary trait NetworkHost {
    machine send(endpoint: &[u8], bytes: &[u8]);
}

pub data RemoteJournal {
    files: Binding<FilesystemHost>;
    network: Binding<NetworkHost>;
    written: i64;
}

pub machine RemoteJournal::append_and_send(
    &mut self,
    descriptor: i32,
    endpoint: &[u8],
    bytes: &[u8]
)
reaches FilesystemHost, NetworkHost
invokes FilesystemHost;
invokes NetworkHost;
{
    self.written = self.files.write(descriptor, bytes);
    self.network.send(endpoint, bytes);
}
