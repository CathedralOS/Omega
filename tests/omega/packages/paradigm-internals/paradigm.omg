// The dependency-package half of the inert-sibling rule: target-scoped
// machines declared by a package rather than by the compilation root.
//
// `paradigm_internal` and `record_paradigm_event` are implemented by exactly
// ONE non-selected target (`uefi_x86_64` — a real profile that is nobody's
// development host, for the reason tests/omega/fail/targets/
// single_target_internal_caller_rejected records), so every hosted build
// leaves them inert siblings and a surviving portable caller of either must
// reject at command level.
//
// `paradigm_caller` is the package-internal same-target caller: scoped to
// `uefi_x86_64` as well, it goes inert alongside its callee, so the
// exemption applies inside a dependency package and produces no diagnostic.
//
// `shared` is the portable member dependents call so the package demonstrably
// links into the program that executes.

public data Helper { seed: i32; }

public machine Helper::shared() -> i32 {
    transition { _ -> 7 }
}

public uefi_x86_64 machine Helper::paradigm_internal(helper: &Helper) -> i32 {
    transition { _ -> 63 }
}

public uefi_x86_64 machine Helper::record_paradigm_event(helper: &mut Helper) {
    transition { _ -> done() }
    machine done() { }
}

public uefi_x86_64 machine Helper::paradigm_caller(helper: &Helper) -> i32 {
    transition { _ -> (Helper::paradigm_internal(helper)) }
}
