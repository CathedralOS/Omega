module main;

use omega::language::core::external_binding;

public machine marker() -> i32 {
    0
}

// These private leaves are unused. Review must disclose both under their
// authored target, without selecting either as an executable provider.
data Wait {}
boundary requirement Wait::poll(descriptors: u64, count: u32, timeout: i32);
data WaitLeaf {}

linux_x86_64 machine WaitLeaf::poll(descriptors: u64, count: u32, timeout: i32)
    satisfies Wait::poll via ForeignBinding::Syscall(7);

macos_arm64 machine WaitLeaf::poll(descriptors: u64, count: u32, timeout: i32)
    satisfies Wait::poll via macos_wait_binding();

macos_arm64 machine macos_wait_binding() -> ForeignBinding<17, 5, 0> {
    ForeignBinding::DllImport {
        import: DllImport::MachODylibSymbol {
            install_name: "libSystem.B.dylib",
            symbol: "_poll",
        },
    }
}

// A pure unknown deployment tag is valid source and inert policy, not a
// request to invent a native profile while reviewing the package.
public reserved_target machine retained_marker() -> i32 {
    9
}

// The body is checked and retained, but a catalogued activation cannot make
// a selected-plan claim about a boundary call in this inactive deployment.
reserved_target machine retained_wait() {
    Wait::poll(0, 0, 0);
}
