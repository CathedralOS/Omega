use omega_language_std::console;
use io::input;
use io::output;
use domain::settings;
use domain::adc;

data Main { }
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    let mut configuration: Settings;
    let accepted: bool = block settings(&mut configuration);
    transition accepted { true -> header(&configuration) _ -> invalid() }
    state header(configuration: &Settings) {
        Console::write_line("raw,code,reconstructed_num,reconstructed_den,clip,error_num,error_den,bound_num,bound_den");
        transition { _ -> sample(configuration, 0) }
    }
    state sample(configuration: &Settings, index: i64 in Wrapping) {
        transition index < configuration.count { true -> read(configuration, index) _ -> trailing() }
    }
    state read(configuration: &Settings, index: i64 in Wrapping) {
        let raw: i64 in Wrapping = block number();
        transition raw >= -1000 && raw <= 1000 { true -> convert(configuration, index, raw) _ -> invalid() }
    }
    state convert(configuration: &Settings, index: i64 in Wrapping, raw: i64 in Wrapping) {
        let mut result: Conversion;
        quantize(configuration, raw, &mut result);
        integer(raw); Console::write(",");
        integer(result.code); Console::write(",");
        integer(result.reconstruction_numerator); Console::write(",");
        integer(result.reconstruction_denominator); Console::write(",");
        integer(result.clipped); Console::write(",");
        integer(result.error_numerator); Console::write(",");
        integer(result.error_denominator); Console::write(",");
        integer(result.bound_numerator); Console::write(",");
        integer(result.bound_denominator); Console::write_line("");
        transition { _ -> sample(configuration, index + 1) }
    }
    state trailing() {
        let extra: i64 in Wrapping = block number();
        transition extra == 2002 { true -> done() _ -> invalid() }
    }
    state done() { Console::exit_process(0); }
    state invalid() { Console::write_line("ERROR: malformed ADC settings or readings"); Console::exit_process(64); }
}
