use omega_language_std::console;
use io::input;
use io::output;
use domain::settings;
use domain::adc;
use omega::language::core::binding;

data Main { console: Binding<Console>; }
machine Main::main(main: &mut Main) reaches Console crashes Trap {
    let mut configuration: Settings;
    let accepted: bool = block settings(&main.console, &mut configuration);
    transition accepted { true -> header(&main.console, &configuration) _ -> invalid(&main.console) }
    state header(console: &Binding<Console>, configuration: &Settings) {
        Console::write_line(console, "raw,code,reconstructed_num,reconstructed_den,clip,error_num,error_den,bound_num,bound_den");
        transition { _ -> sample(console, configuration, 0) }
    }
    state sample(console: &Binding<Console>, configuration: &Settings, index: i64 in Wrapping) {
        transition index < configuration.count { true -> read(console, configuration, index) _ -> trailing(console) }
    }
    state read(console: &Binding<Console>, configuration: &Settings, index: i64 in Wrapping) {
        let raw: i64 in Wrapping = block number(console);
        transition raw >= -1000 && raw <= 1000 { true -> convert(console, configuration, index, raw) _ -> invalid(console) }
    }
    state convert(console: &Binding<Console>, configuration: &Settings, index: i64 in Wrapping, raw: i64 in Wrapping) {
        let mut result: Conversion;
        quantize(configuration, raw, &mut result);
        integer(console, raw); Console::write(console, ",");
        integer(console, result.code); Console::write(console, ",");
        integer(console, result.reconstruction_numerator); Console::write(console, ",");
        integer(console, result.reconstruction_denominator); Console::write(console, ",");
        integer(console, result.clipped); Console::write(console, ",");
        integer(console, result.error_numerator); Console::write(console, ",");
        integer(console, result.error_denominator); Console::write(console, ",");
        integer(console, result.bound_numerator); Console::write(console, ",");
        integer(console, result.bound_denominator); Console::write_line(console, "");
        transition { _ -> sample(console, configuration, index + 1) }
    }
    state trailing(console: &Binding<Console>) {
        let extra: i64 in Wrapping = block number(console);
        transition extra == 2002 { true -> done(console) _ -> invalid(console) }
    }
    state done(console: &Binding<Console>) { Console::exit_process(console, 0); }
    state invalid(console: &Binding<Console>) { Console::write_line(console, "ERROR: malformed ADC settings or readings"); Console::exit_process(console, 64); }
}
