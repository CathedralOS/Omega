use omega_language_std::console;
use omega::language::core::numeric_conversion;
use omega::language::core::binding;
// Every emitted quantity is below 10^12 in magnitude by the input envelope.
pub machine integer(console: &Binding<Console>, value: i64 in Wrapping) reaches Console
invokes Console;
crashes Trap
{
    transition value < 0 { true -> negative(console, value) _ -> digits(console, value, 1000000000000, false) }
    state negative(console: &Binding<Console>, value: i64 in Wrapping) {
        Console::write(console, "-");
        transition { _ -> digits(console, 0 - value, 1000000000000, false) }
    }
    state digits(console: &Binding<Console>, value: i64 in Wrapping, divisor: i64 in Wrapping, started: bool)
    requires divisor > 0
    {
        let digit: i64 in Wrapping = value / divisor;
        transition digit != 0 || started || divisor == 1 {
            true -> emit(console, value, divisor, digit)
            _ -> advance(console, value, divisor, false)
        }
    }
    state emit(console: &Binding<Console>, value: i64 in Wrapping, divisor: i64 in Wrapping, digit: i64 in Wrapping)
    requires divisor > 0
    {
        Console::write_byte(console, narrow_i64_to_i32_trapping((digit + 48) as i64));
        transition { _ -> advance(console, value % divisor, divisor, true) }
    }
    state advance(console: &Binding<Console>, value: i64 in Wrapping, divisor: i64 in Wrapping, started: bool) {
        transition divisor >= 10 { true -> next(console, value, divisor, started) _ -> done() }
    }
    state next(console: &Binding<Console>, value: i64 in Wrapping, divisor: i64 in Wrapping, started: bool)
    requires divisor >= 10
    {
        transition { _ -> digits(console, value, divisor / 10, started) }
    }
    state done() { }
}
