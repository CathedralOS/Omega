// Runtime decimal formatting keeps one operand for multiple fixed-view
// divisions, across hosted byte writes that clobber those views. A validated
// spill must split the operand's uses rather than drop a fixed-view constraint.
use omega_language_std::console;

data Main { }

machine number(value: i32 in Saturating) reaches Console {
    Console::write_byte(((value / 100) % 10 + 48) as i32);
    Console::write_byte(((value / 10) % 10 + 48) as i32);
    Console::write_byte((value % 10 + 48) as i32);
}

machine next(value: i32 in Saturating) -> i32 in Saturating { value + 1 }

machine Main::main(main: &mut Main) reaches Console {
    let observed: ByteRead = block Console::read_byte();
    transition observed {
        ByteRead::Byte { value } -> output(main, value as i32 in Saturating)
        _ -> bad(main)
    }
    state output(main: &mut Main, value: i32 in Saturating) {
        number(value);
        Console::write(" ");
        number(next(value));
        Console::write(" ");
        number(next(next(value)));
        Console::write_line("");
        Console::exit_process(0);
    }
    state bad(main: &mut Main) { Console::exit_process(1); }
}
