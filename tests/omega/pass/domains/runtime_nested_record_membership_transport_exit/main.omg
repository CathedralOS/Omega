// Copying and nesting preserve the issued child, not its source's later epoch.
data Ticket [copy] { amount: i32; marker: i32; }
domain Ticket::Issued established by Ticket::issue;
machine Ticket::issue() -> Ticket ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}
data Envelope [copy] { ticket: Ticket in Issued; replaced: bool; }
data Wrapper [copy] { envelope: Envelope; }
data Main { ticket: Ticket; }
machine Main::replace(main: &mut Main) -> bool {
    main.ticket = Ticket { amount: 0, marker: 0 };
    true
}
machine verify(ticket: Ticket in Issued) crashes Trap {
    transition ticket.amount == 41 && ticket.marker == 9 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
machine observe(value: Envelope) crashes Trap {
    verify(value.ticket);
}
machine consume(value: Wrapper) crashes Trap {
    observe(value.envelope);
}
machine Main::main(main: &mut Main) crashes Trap {
    main.ticket = Ticket::issue();
    consume(Wrapper { envelope: Envelope { ticket: main.ticket, replaced: Main::replace(main) } });
    transition main.ticket.amount == 0 && main.ticket.marker == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
