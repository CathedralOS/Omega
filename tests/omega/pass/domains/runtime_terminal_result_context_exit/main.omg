use omega_language_std::console;
use omega::language::core::float_operations;
domain f64::TravelTime;
domain f64::SurfaceOffset;
domain i32::Positive(value) requires value > 0;
machine measure(value: f64) -> f64 { value }
machine measure(value: f64) -> f64 in TravelTime {
 let seconds: f64 = value / 1000.0;
 seconds as f64 in TravelTime
}
machine measure(value: f64) -> f64 in SurfaceOffset {
 let distance: f64 = value / 100.0;
 distance as f64 in SurfaceOffset
}
machine tail(value: f64) -> f64 in TravelTime { measure(value) }
machine distance(value: f64) -> f64 in SurfaceOffset { measure(value) }
machine choose(left: bool, value: f64) -> f64 in TravelTime {
 match left { true -> measure(value), false -> measure(4000.0) }
}
machine named(value: f64) -> f64 in TravelTime {
 transition { _ -> finish(value) }
 state finish(value: f64) -> f64 in TravelTime { measure(value) }
}
machine transition_tail(value: f64) -> f64 in TravelTime {
 transition { _ -> (measure(value)) }
}
machine default_tail(value: f64) -> f64 { measure(value) }
machine positive() -> i32 in Positive { 70 as i32 in Positive }
machine refined() -> i32 in Positive { positive() }
data Observation { time: f64 in TravelTime; }
machine accept(time: f64 in TravelTime) -> f64 { time as f64 }
data Main { }
machine Main::main(main: &mut Main) reaches Console {
 let checked: i32 in Positive = refined();
 let explicit: f64 in TravelTime = measure(2500.0);
 let trailing: f64 in TravelTime = tail(2500.0);
 let offset: f64 in SurfaceOffset = distance(2500.0);
 let left: f64 in TravelTime = choose(true, 2500.0);
 let right: f64 in TravelTime = choose(false, 2500.0);
 let state: f64 in TravelTime = named(2500.0);
 let transition_value: f64 in TravelTime = transition_tail(2500.0);
 let ordinary: f64 = default_tail(2500.0);
 let observation: Observation = Observation { time: measure(2500.0) };
 let argument: f64 = accept(measure(2500.0));
 let field: f64 = observation.time as f64;
 let a: f64 = explicit as f64; let b: f64 = trailing as f64;
 let c: f64 = offset as f64; let d: f64 = left as f64;
 let e: f64 = right as f64; let f: f64 = state as f64;
 let g: f64 = transition_value as f64;
 transition checked == 70 && a == 2.5 && b == 2.5 && c == 25.0 && d == 2.5 && e == 4.0 && f == 2.5 && g == 2.5 && ordinary == 2500.0 && field == 2.5 && argument == 2.5 {
  true -> good(main) false -> bad(main)
 }
 state good(main: &mut Main) {
  Console::write_line("time 2.5 offset 25 alternate 4 default 2500");
  Console::exit_process(0);
 }
 state bad(main: &mut Main) { Console::exit_process(77); }
}
