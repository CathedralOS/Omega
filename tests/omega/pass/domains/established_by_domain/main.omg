// `pub domain Folder::Writable established by Desktop::choose_folder,
// DesktopProvider::choose_folder` — the domain's establishment is
// granted by named machines; a helper's capability-typed return hands
// the minted `Folder` onward (`acquires` propagates up the call graph).
pub domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
pub data Folder {}
pub domain Folder::Writable
established by Desktop::choose_folder, DesktopProvider::choose_folder;
pub boundary trait Desktop {
    machine choose_folder(prompt: &[u8] in Utf8) -> Folder
    ensures
        result in Folder::Writable
    reaches
        Desktop;
}
data DesktopProvider {}
machine DesktopProvider::choose_folder(prompt: &[u8] in Utf8) -> Folder
    satisfies Desktop::choose_folder
    ensures result in Folder::Writable
{
    Folder {}
}
data Vault {
}
machine Vault::pick(vault: &mut Vault) -> Folder
    reaches Desktop
{
    Desktop::choose_folder("pick a folder")
}
data Backup {
    vault: Vault;
}
machine Backup::stage(backup: &mut Backup) -> Folder
    reaches Desktop
{
    Vault::pick(&mut backup.vault)
}
data Main { backup: Backup; }
machine Main::main(main: &mut Main) reaches Desktop {
    let folder: Folder = Backup::stage(&mut main.backup);
}
