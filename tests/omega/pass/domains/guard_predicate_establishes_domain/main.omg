// A guard on a transition into a qualified state parameter establishes the
// predicate-only domain membership: the guard's own predicate is the domain's
// requirement, compared as an interval and as a label.
domain u64::Small(v) requires v <= 3;

machine producer(source: u64) -> u64 in Small crashes Trap {
    transition source <= 3 {
        true -> checked(source)
        _ -> bad()
    }
    state checked(source: u64 in Small) -> u64 in Small { source }
    state bad() -> u64 in Small { crash Trap; }
}

data Main { value: u64; }
machine Main::main(main: &mut Main) crashes Trap {
    let observed: u64 in Small = producer(2);
    transition observed == 2 { true -> done() _ -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
