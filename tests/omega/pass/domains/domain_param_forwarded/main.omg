// #66 Phase 1 fact-flow: a `T in Domain` parameter is not only an obligation on
// callers -- inside the body the membership is ASSUMED (the synthesized
// `requires <param> in Domain` is a precondition the body may rely on). So a
// domained parameter forwards to another domained parameter with no re-proof:
// `consume`'s `item in Scanned` assumption discharges `inspect`'s requirement.
// This is the carrier-orthogonal domain fact flowing through a call.

data Blob [copy] {
    payload: i32;
}

domain Blob::Scanned(blob)
requires
    blob.payload > 0;

data Main {
    blob: Blob;
}

machine inspect(item: Blob in Scanned) {
}

machine consume(item: Blob in Scanned) {
    inspect(item);
}

machine Main::main(main: &mut Main)
requires
    main.blob in Blob::Scanned
{
    consume(main.blob);
}
