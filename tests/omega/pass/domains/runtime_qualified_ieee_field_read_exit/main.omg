// Qualified IEEE observation preserves the field's declaration and owner.
use omega::language::core::float_operations;
domain f64::Time;
data Observation { time: f64 in Time; }
data Nested { observation: Observation; }
machine read(observation: &Observation) -> f64 { observation.time as f64 }
machine main() crashes Trap {
 let observation: Observation = Observation { time: 2.5 as f64 in Time };
 let value: f64 = observation.time as f64;
 let shared: f64 = read(&observation);
 let nested: Nested = Nested { observation: Observation { time: 4.0 as f64 in Time } };
 let projected: f64 = nested.observation.time as f64;
 transition value == 2.5 && shared == 2.5 && projected == 4.0 {
  true -> good() false -> bad()
 }
 machine good() {}
 machine bad() { crash Trap; }
}
