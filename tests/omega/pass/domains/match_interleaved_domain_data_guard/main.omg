// Chapter 8 "Domain Patterns": domain patterns interleave with ordinary
// data patterns and guards in a control dispatch. The record-destructure +
// guard arm (`Player { health, .. } if health > 5`) is `transition`
// grammar; value-position `match` admits value and wildcard arms only.

data Player {
    health: i32;
}

domain Player::Valid
requires
    self.health >= 0;

domain Player::Alive
requires
    self in Player::Valid;
    self.health > 0;

data Main {
    player: Player;
}

machine Main::main(&mut self) {
    transition self.player {
        Player::Alive -> done()
        Player { health, .. } if health > 5 -> done()
        _ -> done()
    }

    state done() { }
}
