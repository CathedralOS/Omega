// A predicate domain: `domain i32::Step(value) requires 0 <= value && value <= 50`
// — the declaration's own binder names the candidate for its requires clause.
domain i32::Step(value) requires 0 <= value && value <= 50;

machine nudge(value: i32 in Step) -> i32 {
    // 0 <= value <= 50 bounds the operand: `value + 40` lands in 40..=90 —
    // exact arithmetic provable without a domain opt-in.
    let moved: i32 = value + 40;
    transition { _ -> moved }
}

machine clamp(value: i32 in Step) -> i32 in Step {
    transition { _ -> value }
}

data Msg {
    case Move(dx: i32 in Step, dy: i32 in Step);
}

machine dispatch(m: Msg) -> i32 {
    transition m {
        Msg::Move { dx, dy } -> combine(dx, dy)
    }

    machine combine(dx: i32 in Step, dy: i32 in Step) -> i32 {
        let left: i32 = nudge(dx);
        let right: i32 = clamp(dy) as i32;
        let sum: i32 = left + right;
        transition { _ -> sum }
    }
}

machine main() -> i32 {
    transition { _ -> dispatch(Msg::Move { dx: 30, dy: 40 }) }
}
