// Expected exit: 0
// Domain arguments select the carrier's exact type application, not just its name.
data Pair<A, B> { first: A; second: B; }
domain<A, B> Pair<A, B>::Typed<A, B>;

machine retain<A, B>(pair: Pair<A, B> in Typed<A, B>) -> Pair<A, B> in Typed<A, B> {
    pair
}

machine main() crashes Trap {
    let pair: Pair<u32, u64> =
        Pair { first: 17, second: 25 };
    let marked: Pair<u32, u64> in Typed<u32, u64> = pair as Pair<u32, u64> in Typed<u32, u64>;
    let result: Pair<u32, u64> in Typed<u32, u64> = retain<u32, u64>(marked);
    transition result.first == 17 && result.second == 25 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
