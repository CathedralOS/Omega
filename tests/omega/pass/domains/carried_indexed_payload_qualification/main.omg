// Expected exit: 0.
data Ticket [copy] { value: u64; }
domain Ticket::Issued established by mint;
data Choice { case Empty; case Ready(ticket: Ticket in Issued); }
data Envelope { entries: [Choice; 2]; }
machine mint(value: u64) -> Ticket in Issued { Ticket { value: value } }
machine main() crashes Trap {
    let mut envelope: Envelope;
    envelope.entries[0] = Choice::Ready { ticket: mint(73) };
    transition { _ -> forward(envelope) }
    state forward(envelope: Envelope) {
        transition envelope.entries[0] {
            Choice::Ready { ticket } -> verify(ticket)
            Choice::Empty -> wrong()
        }
    }
    state verify(ticket: Ticket in Issued) {
        transition ticket.value == 73 { true -> done() _ -> wrong() }
    }
    state done() {}
    state wrong() { crash Trap; }
}
