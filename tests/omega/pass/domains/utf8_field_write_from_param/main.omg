// A qualified slice parameter replaces a local record's complete descriptor.
// Literal-backed descriptors have no activation-local parent. Replacement
// preserves a sibling and detached copies, including their original extents.
domain [u8]::Utf8(bytes) requires valid_utf8(bytes);
data Slot { out: &[u8] in Utf8; sibling: &[u8] in Utf8; }

machine store(text: &[u8] in Utf8) -> bool {
    let mut slot: Slot = Slot { out: "old", sibling: "keep" };
    let previous: &[u8] in Utf8 = slot.out;
    slot.out = text;
    let installed: &[u8] in Utf8 = slot.out;
    slot.out = "";
    previous == "old" && installed == text && text == installed
        && previous != installed && slot.sibling != text
        && slot.out.len == 0 && slot.sibling == "keep"
}

machine Main::main() crashes Trap {
    let populated: bool = store("new");
    let empty: bool = store("");
    transition populated && empty {
        true -> passed()
        false -> failed()
    }
    machine passed() {}
    machine failed() { crash Trap; }
}
