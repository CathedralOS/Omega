// #66 GAP (field write from a `&[u8] in Utf8` PARAM): a domained-slice-view
// parameter stored into a LOCAL aggregate's `&[u8] in Utf8` field lowers to the
// same 16-byte descriptor `CopyRuntimeStorage` path. The local shape is
// intentional: an elided call-scoped parameter cannot soundly escape into a
// persistent machine field. This still pins data-field layout through
// `Reference { Constrained { Slice } }` as the fat `{ptr, len}` descriptor;
// before the layout fix the field was a thin 8-byte pointer and the copy
// silently dropped its length.
domain [u8]::Utf8
requires
    valid_utf8(self);
data Slot {
    out: &[u8] in Utf8;
}

machine store(text: &[u8] in Utf8) {
    let mut slot: Slot = Slot { out: "" };
    slot.out = text;
}

machine Main::main() {
    store("Gate");
}
