// Expected exit: 0
// An uninhabited alternative does not prevent using the empty alternative.
domain u64::Impossible(value) requires false;

data Choice [copy] {
    case Empty;
    case Unavailable(value: u64 in Impossible);
}

machine impossible() -> u64 requires false { 7 }

machine consume(choice: Choice) -> u64 {
    // The contradictory premise is usable only under its own selected case.
    transition choice in Choice::Unavailable {
        true -> impossible()
        false -> 7
    }
}

machine consume_negated(choice: Choice) -> u64 {
    transition !(choice in Choice::Unavailable) {
        false -> impossible()
        true -> 7
    }
}

machine main() crashes Trap {
    transition consume(Choice::Empty) == 7 && consume_negated(Choice::Empty) == 7 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
