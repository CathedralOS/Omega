// Each domain subject shadows the module constant of the same name.
use omega_language_std::console;

const value: u64 = 99;
const bytes: u64 = 99;
const packet: u64 = 99;

domain u64::Small(value) requires value < 5;
domain u64::Small::Inherited;
domain u64::Small::Explicit(value) requires value < 4;
domain u64::Nested(value) requires value in Small;
domain<const Bound: u64> u64::Below<Bound>(value) requires value < Bound;
domain<const Index: u64> [u64; 2]::SmallAt<Index>(bytes)
requires bytes[Index] in Small;

data Packet [copy] {
    count: u64;
}

domain Packet::SmallCount(packet) requires packet.count in Nested;

const SCALAR: u64 in Nested = 3;
const INHERITED: u64 in Small::Inherited = 3;
const QUALIFIED: u64 in u64::Small::Inherited = 3;
const EXPLICIT: u64 in Small::Explicit = 3;
const INDEXED: u64 in Below<5> = 3;
const ARRAY: [u64; 2] in SmallAt<1> = [99, 3];
const RECORD: Packet in SmallCount = Packet { count: 3 };

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    Console::exit_process(INHERITED as i32);
}
