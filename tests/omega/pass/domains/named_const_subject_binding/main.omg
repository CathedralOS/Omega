// Logical self denotes the exact qualified constant, independently of outer names.
use omega_language_std::console;

const value: u64 = 99;
const bytes: u64 = 99;
const packet: u64 = 99;

domain u64::Small requires self < 5;
domain u64::Small::Inherited;
domain u64::Small::Explicit requires self < 4;
domain u64::Nested requires self in Small;
domain<const Bound: u64> u64::Below<Bound> requires self < Bound;
domain<const Index: u64> [u64; 2]::SmallAt<Index>
requires Index < 2 && (self[Index] in Small);

data Packet [copy] {
    count: u64;
}

domain Packet::SmallCount requires self.count in Nested;

const SCALAR: u64 in Nested = 3;
const INHERITED: u64 in Small::Inherited = 3;
const QUALIFIED: u64 in u64::Small::Inherited = 3;
const EXPLICIT: u64 in Small::Explicit = 3;
const INDEXED: u64 in Below<5> = 3;
const ARRAY: [u64; 2] in SmallAt<1> = [99, 3];
const RECORD: Packet in SmallCount = Packet { count: 3 };

data Main {
}

machine Main::main(main: &mut Main) reaches Console {
    Console::exit_process(INHERITED as i32);
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
