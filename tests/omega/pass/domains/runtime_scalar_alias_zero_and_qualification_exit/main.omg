// Zero establishment and explicit qualification prove the same complete theory.
domain i32::NotFive(value) requires value != 5;
domain i32::BelowFive(value) requires value < 5;
domain i32::Small = i32::NotFive & i32::BelowFive;
domain<const Bound: u64> u64::Below<Bound>(value) requires value < Bound;

data Main { value: i32 in Small; }

machine selected_value() -> i32 in Small { 3 as i32 in Small }
machine indexed_value(value: u64 in Below<4>) -> u64 in Below<4> { value }

machine Main::main(main: &mut Main) crashes Trap {
    let qualified: i32 in Small = 3 as i32 in Small;
    let returned: i32 in Small = selected_value();
    let raw: i32 = 2;
    let computed: i32 in Small = (raw + 1) as i32 in Small;
    let indexed: u64 in Below<4> = indexed_value(3 as u64 in Below<4>);
    transition main.value == 0 && qualified == 3 && returned == 3 && computed == 3 && indexed == 3 {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() crashes Trap {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
