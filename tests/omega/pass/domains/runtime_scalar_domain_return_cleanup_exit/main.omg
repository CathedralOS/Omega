// Expected exit: 0.
// A result-completion formation retains its edge through nominal cleanup.
data Token { ready: bool; }
machine Token::drop(token: &mut Token) requires token.ready { token.ready = false; }
domain i64::Nonnegative(value) requires value >= 0 established by seed, choose;
machine seed() -> i64 in Nonnegative { 17 }
machine choose(old: bool, existing: i64 in Nonnegative) -> i64 in Nonnegative {
    let token: Token = Token { ready: true };
    transition old { true -> (existing) _ -> (17) }
}
machine main() crashes Trap {
    let existing: i64 in Nonnegative = seed();
    let saved: i64 in Nonnegative = choose(true, existing);
    let fresh: i64 in Nonnegative = choose(false, existing);
    transition saved == 17 && fresh == 17 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
