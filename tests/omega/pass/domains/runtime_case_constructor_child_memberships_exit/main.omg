// Completed common and payload children retain their own issued values.
// The last child replaces the common child's former source storage.
data Ticket [copy] { amount: i32; marker: i32; }
data Spare [copy] { value: i32; }
domain Ticket::Issued established by Ticket::issue;

machine Ticket::issue() -> Ticket
ensures result in Ticket::Issued {
    Ticket { amount: 41, marker: 9 }
}

data Event [copy] {
    common: Ticket in Issued;
    spare: Spare;
    replaced: bool;
    case Packed(payload: Ticket in Issued);
    case Empty;
}
data Main { ticket: Ticket; }

machine Main::replace(main: &mut Main) -> bool {
    main.ticket = Ticket { amount: 0, marker: 0 };
    true
}

machine observe(event: Event) -> bool {
    transition event {
        Event::Packed { common as _, spare as _, replaced as _, payload } -> (event.replaced && event.spare.value == 0
            && event.common.amount == 41 && event.common.marker == 9
            && payload.amount == 41 && payload.marker == 9)
        Event::Empty -> false
    }
}

machine observe_empty(event: Event) -> bool {
    transition event {
        Event::Packed { common as _, spare as _, replaced as _, payload } -> false
        Event::Empty -> (event.common.amount == 41 && event.common.marker == 9
            && event.spare.value == 0)
    }
}

machine Main::main(main: &mut Main) crashes Trap {
    main.ticket = Ticket::issue();
    let event: Event = Event::Packed {
        common: main.ticket,
        payload: Ticket::issue(),
        replaced: Main::replace(main)
    };
    let bound: bool = observe(event);
    main.ticket = Ticket::issue();
    let inline: bool = observe(Event::Packed {
        common: main.ticket,
        payload: Ticket::issue(),
        replaced: Main::replace(main)
    });
    let empty: bool = observe_empty(Event::Empty { common: Ticket::issue() });
    transition bound && inline && empty && main.ticket.amount == 0 && main.ticket.marker == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
