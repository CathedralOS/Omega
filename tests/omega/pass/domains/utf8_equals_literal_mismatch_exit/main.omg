// RUN CANARY (exit 71): the mismatch control for utf8_equals_literal_exit. A
// `&[u8] in Utf8` parameter compared with a string literal of the same length
// must read the view's bytes: "look" against "quit" takes the `_` arm. A
// comparison of descriptor words or lengths alone would select `finished`
// and exit 70.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
}

machine Main::classify(main: &Main, text: &[u8] in Utf8) reaches Console {
    transition text == "quit" {
        true -> finished(main)
        _ -> other(main)
    }

    state finished(main: &Main) { Console::exit_process(70); }
    state other(main: &Main) { Console::exit_process(71); }
}

machine Main::main(main: &mut Main) {
    Main::classify(main, "look");
}
