data Password {
    length: i32;
    score: i32;
}

domain Password::Valid
requires
    self.length > 0;

domain Password::Secure
requires
    self.score >= 8;

data Main {
    password: Password;
}

machine Main::main(&mut self) -> i32
requires
    self.password in Password::Valid
ensures
    self.password in Password::Valid | Password::Secure
{
    0
}
