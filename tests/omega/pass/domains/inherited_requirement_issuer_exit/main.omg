// Expected exit: 0
// Naming an inherited issuer preserves the original requirement's authority.
data Ticket { value: u64; }
domain Ticket::Issued established by Derived::issue;
trait Base { machine issue(value: u64) -> Ticket in Issued; }
trait Derived: Base {}
machine make(value: u64) -> Ticket in Issued satisfies Base::issue {
    Ticket { value: value }
}
machine read(ticket: Ticket in Issued) -> u64 { ticket.value }
machine start() crashes Trap {
    let first: u64 = read(make(11));
    let second: u64 = read(make(13));
    transition first == 11 && second == 13 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
