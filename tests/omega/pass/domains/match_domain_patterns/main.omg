// Chapter 8 "Domain Patterns": a value can be dispatched against
// type-qualified domain patterns. Each arm checks whether the value is in
// that domain and dispatches to a distinct state. The trailing `_` makes
// the dispatch exhaustive.

data Player {
    health: i32;
}

domain Player::Valid(player)
requires
    player.health >= 0;

domain Player::Alive(player)
requires
    player in Player::Valid;
    player.health > 0;

domain Player::Dead(player)
requires
    player in Player::Valid;
    player.health == 0;

data Main {
    player: Player;
}

machine Main::main(main: &mut Main) {
    transition main.player {
        Player::Alive -> alive()
        Player::Dead -> dead()
        _ -> other()
    }

    machine alive() { }
    machine dead() { }
    machine other() { }
}
