// Binding-site operator selection (chapter 8, "Domain-Sensitive Operators"):
// the signature's `requires` selects `Quantity::Additive` for the `left`
// binding, so the unique domain-owned `+` meaning is selected. This is a static
// signature choice, not an inference from the body's flow facts. Without that
// binding-site selection this exact program is rejected (see
// fail/domains/domain_operator_meaning_unproven).

data Quantity {
    value: i32;
}

domain Quantity::Additive
requires
    self.value >= 0;

operator + Quantity::Additive::add(left: Quantity, right: Quantity) -> Quantity;

data Main {
}

machine Main::combine(&self, left: Quantity, right: Quantity)
requires
    left in Quantity::Additive
{
    let sum: Quantity = left + right;
}

machine Main::main(&mut self) {
}
