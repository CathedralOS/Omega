use omega_language_std::console;

data Password {
    length: i32;
    score: i32;
}

domain Password::Valid(password)
requires
    password.length > 0;

domain Password::Secure(password)
requires
    password.score >= 8;

data Main {
    password: Password;
}

machine Main::main(main: &mut Main) reaches Console {
    main.password.length = 12;
    main.password.score = 2;

    transition (main.password in Password::Valid | Password::Secure) {
        (true) -> good(main)
        _ -> bad(main)
    }

    machine good(main: &mut Main) {
        Console::exit_process(241);
    }

    machine bad(main: &mut Main) {
        Console::exit_process(242);
    }
}

// The entry owns ordinary local state; selection supplies no context.
machine entry_start() reaches Console {
    let mut entry_storage: Main;
    Main::main(&mut entry_storage);
}
