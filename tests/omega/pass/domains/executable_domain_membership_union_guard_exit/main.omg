use omega_language_std::console;
use omega::language::core::binding;

data Password {
    length: i32;
    score: i32;
}

domain Password::Valid(password)
requires
    password.length > 0;

domain Password::Secure(password)
requires
    password.score >= 8;

data Main {
    console: Binding<Console>;
    password: Password;
}

machine Main::main(main: &mut Main) reaches Console {
    main.password.length = 12;
    main.password.score = 2;

    transition (main.password in Password::Valid | Password::Secure) {
        (true) -> good(main)
        _ -> bad(main)
    }

    state good(main: &mut Main) {
        main.console.exit_process(241);
    }

    state bad(main: &mut Main) {
        main.console.exit_process(242);
    }
}
