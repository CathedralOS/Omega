// Established receiver and named arguments carry the same nonzero field domain.
domain [u8; 8]::NonEmpty(bytes) requires non_empty(bytes);
data Label { text: [u8; 8] in NonEmpty; }
data Packet { label: Label; }

machine observe(text: &[u8; 8] in NonEmpty) -> bool { text.len > 0 }

machine Packet::replace(&mut self) -> bool {
    let before: bool = observe(&self.label.text);
    self.label.text = "method";
    before && observe(&self.label.text)
}

machine replace(packet: &mut Packet) -> bool {
    let before: bool = observe(&packet.label.text);
    packet.label.text = "named";
    before && observe(&packet.label.text)
}

machine main() crashes Trap {
    let mut packet: Packet = Packet { label: Label { text: "start" } };
    let method: bool = packet.replace();
    let named: bool = replace(&mut packet);
    transition method && named && packet.label.text == "named" {
        true -> done()
        _ -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
