data Player [copy] {
    health: i32;
}

domain Player::Alive
requires
    self.health > 0;

data Main {
    player: Player;
}

machine Main::inspect(player: Player)
requires
    player in Player::Alive
{
}

machine Main::main(&mut self)
requires
    self.player in Player::Alive
{
    let mut copy: Player = self.player;
    self.inspect(copy);
}
