// Decision 17 stage S1b: the SIGNED `Saturating` arithmetic domain.
// i8 range is [-128, 127]: `100 + 100` overflows positive and clamps to
// 127, not the wrapped -56. The `Trapping` domain compiles the same
// operation class — overflow is a runtime abort, not a check failure.
data Main {}

machine Main::main(main: &mut Main) {
    let a: i8 in Saturating = 100;
    let b: i8 in Saturating = 100;
    let c: i8 in Saturating = a + b;
    let d: u8 in Trapping = 200;
    let e: u8 in Trapping = 100;
    let f: u8 in Trapping = d - e;
    transition c == 127 && f == 100 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
