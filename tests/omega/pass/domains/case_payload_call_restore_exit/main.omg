// Calls restore conditional payload validity, not an old case selection.
use omega_language_std::console;
use omega::language::core::binding;

domain i32::NonZero(value) requires value != 0;
data Divisor { case Unset; case By(amount: i32 in NonZero); }
data Main { console: Binding<Console>; divisor: Divisor; }

machine install(main: &mut Main) {
    let replacement: Divisor = Divisor::By { amount: 7 };
    main.divisor = replacement;
}

machine clear(main: &mut Main) { main.divisor = Divisor::Unset; }

machine Main::main(main: &mut Main) reaches Console {
    main.divisor = Divisor::Unset;
    install(main);
    transition main.divisor {
        Divisor::By { amount } -> quotient(main, 490 / amount)
        Divisor::Unset -> fail(main)
    }
    state quotient(main: &mut Main, result: i32) {
        clear(main);
        transition main.divisor {
            Divisor::Unset -> done(main, result)
            Divisor::By { amount as _ } -> fail(main)
        }
    }
    state done(main: &mut Main, result: i32) { main.console.exit_process(result); }
    state fail(main: &mut Main) { main.console.exit_process(71); }
}
