// Every arrival owes its parameter's declared field domains, including when
// the argument is the caller's own subject. The boundary read writes only
// `game.input`; that write must not retire the disjoint `game.room.label`
// qualification. Enum payload extraction and later operands likewise retain
// facts outside their actual write footprints. No receiver exemption applies.
//
// Expected exit: 0.

use omega_language_std::console;
use omega::language::core::binding;

domain [u8; 8]::Utf8(bytes)
requires
    valid_utf8(bytes);

data Room { label: [u8; 8] in Utf8; }
data Game {
    console: Binding<Console>;
    room: Room;
    input: [u8; 32];
    count: u64;
}

machine Game::main(game: &mut Game) reaches Console {
    transition block game.console.read_line(&mut game.input) {
        LineReadResult::LineComplete { count } -> received(game, count)
        LineReadResult::EndOfInput { count } -> received(game, count)
        _ -> done(game)
    }

    state received(game: &mut Game, count: u64) {
        game.count = count;
        transition { _ -> done(game) }
    }
    state done(game: &mut Game) { game.console.exit_process(0); }
}
