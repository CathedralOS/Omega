data Inner { quota: u64; }
machine make() -> Inner { Inner { quota: 30 } }
data Outer { inner: Inner; header: u64; }
machine inspect(outer: Outer) -> u64 { outer.header }
machine main() crashes Trap {
    let seen: u64 = inspect(Outer { inner: make(), header: 10 });
    transition seen == 10 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
