// Expected exit: 0.
// Issuance names the exact generic declaration, not its instantiated spelling.
domain i64::Nonnegative(value) requires value >= 0 established by issue;
machine issue<P>(value: i64) -> i64 in Nonnegative requires value >= 0 { value }
machine main() crashes Trap {
    let value: i64 in Nonnegative = issue<u64>(17);
    transition value == 17 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
