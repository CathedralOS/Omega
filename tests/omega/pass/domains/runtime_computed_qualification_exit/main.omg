use omega::language::core::float_operations;

domain i32::Three(value) requires value == 3;
domain i32::Positive(value) requires value > 0;

machine classified() -> i32 in Three { 3.0f64 as i32 in Three }
machine observe(value: i32 in Three) -> i32 { value as i32 }

machine guarded(value: i32) -> i32 {
    transition value > 0 { true -> positive(value) false -> empty() }
    machine positive(value: i32) -> i32 { (value as i32 in Positive) as i32 }
    machine empty() -> i32 { 0 }
}

machine main() crashes Trap {
    let classified: i32 in Three = classified();
    let observed: i32 = observe(classified);
    let inline: i32 = observe(I32::from_f64(3.75f64) as i32 in Three);
    let anonymous: i32 = observe((1 + 2) as i32 in Three);
    let stored: i32 = 2;
    let computed: i32 in Positive = (stored + 1) as i32 in Positive;
    let mut live: i32 = 1;
    live = 2;
    let current: i32 in Positive = live as i32 in Positive;
    let guarded: i32 = guarded(4);
    transition observed == 3 && inline == 3 && anonymous == 3 && (computed as i32) == 3
        && (current as i32) == 2 && guarded == 4 {
        true -> done()
        false -> bad()
    }
    machine done() {}
    machine bad() { crash Trap; }
}
