// Expected exit: 0. Target specialization retains the exact issuer declaration.
domain u64::Issued(value) requires value >= 100 established by issue;
macos_arm64 machine issue<Element>(value: u64) -> u64 in Issued requires value >= 100 { value }
linux_arm64 machine issue<Element>(value: u64) -> u64 in Issued requires value >= 100 { value }
linux_x86_64 machine issue<Element>(value: u64) -> u64 in Issued requires value >= 100 { value }
windows_x86_64 machine issue<Element>(value: u64) -> u64 in Issued requires value >= 100 { value }
machine forward(value: u64) -> u64 in Issued requires value >= 100 { issue<u64>(value) }
machine consume(value: u64 in Issued) -> u64 { value - 100 }
machine main() crashes Trap {
    let difference: u64 = consume(forward(100));
    transition difference == 0 { true -> done() false -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
