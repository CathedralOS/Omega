// Expected exit: 0. Reading a field in a later conjunct preserves the earlier
// conjunct's predicate-only domain fact through capture and the state jump.
domain u64::Small(v) requires v <= 3;
data Value { number: u64; }
machine observe(value: &Value) -> u64 { value.number }
machine producer(source: u64) -> u64 in Small crashes Trap {
    let value: Value = Value { number: source };
    transition value.number <= 3 && observe(&value) == 2 {
        true -> checked(value.number)
        _ -> bad()
    }
    machine checked(value: u64 in Small) -> u64 in Small { value }
    machine bad() -> u64 in Small { crash Trap; }
}
machine main() crashes Trap {
    let observed: u64 in Small = producer(2);
    transition observed == 2 { true -> done() _ -> bad() }
    machine done() {}
    machine bad() { crash Trap; }
}
