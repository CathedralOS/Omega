use omega::language::core::binding;
// Chapter 18 authority flow: a boundary trait signature's `requires` is the
// caller's proof obligation, discharged here by the caller's own `requires`
// carrying the same fact for the forwarded argument. Companion to
// fail/domains/call_requires_platform_unproven.

pub data Item {
    value: i32;
}

pub domain Item::Ready
requires
    self.value > 0;

pub boundary trait Console {
    machine show(item: &Item)
    requires
        item in Item::Ready;
}

data Worker {
    console: Binding<Console>;
}

machine Worker::run(&self, item: &Item)
requires
    item in Item::Ready
reaches Console {
    self.console.show(item);
}

data Main {
    worker: Worker;
    item: Item;
}

machine Main::main(&mut self) {
}
