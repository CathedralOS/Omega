// Expected exit: 0. Earlier siblings establish the value actually read, while
// later siblings cannot change a detached scalar already copied into a field.
domain<const Excluded: u64> u64::Except<Excluded>(value) requires value != Excluded;
data Source { value: u64; }
data Holder { changed: u64; scoped: u64 in Except<9>; }
data Envelope { item: Source; }

machine repair(source: &mut Source) -> u64 in Except<9>
ensures source.value == 3 {
    source.value = 3;
    3
}
machine overwrite(source: &mut Source) -> u64
ensures source.value == 9 {
    source.value = 9;
    0
}
machine identity(value: u64) -> u64 ensures result == value { value }
machine assign(source: &mut Source, value: u64)
ensures source.value == value {
    source.value = value;
}
machine repair_record(source: &mut Source) -> Source
ensures source.value == 3
ensures result.value == 3 {
    source.value = 3;
    Source { value: 3 }
}

machine main() crashes Trap {
    let mut source: Source = Source { value: 9 };
    let repaired: Holder = Holder { changed: repair(&mut source) as u64, scoped: source.value };
    source.value = 3;
    let copied: Holder = Holder { scoped: source.value, changed: overwrite(&mut source) };
    source.value = 9;
    let values: [u64 in Except<9>; 2] = [repair(&mut source), source.value];
    let local: u64 in Except<9> = source.value;
    let returned: u64 in Except<9> = identity(3);
    source.value = 9;
    assign(&mut source, 3);
    let unit: u64 in Except<9> = source.value;
    source.value = 9;
    let produced: Source = repair_record(&mut source);
    let structural_call: u64 in Except<9> = source.value;
    let structural_result: u64 in Except<9> = produced.value;
    let mut envelope: Envelope = Envelope { item: Source { value: 9 } };
    assign(&mut envelope.item, 3);
    let projected: u64 in Except<9> = envelope.item.value;
    transition repaired.scoped == 3 && copied.scoped == 3
        && values[0] == 3 && values[1] == 3 && local == 3 && returned == 3
        && unit == 3 && structural_call == 3 && structural_result == 3 && projected == 3 {
        true -> done()
        _ -> failed()
    }
    machine done() {}
    machine failed() { crash Trap; }
}
