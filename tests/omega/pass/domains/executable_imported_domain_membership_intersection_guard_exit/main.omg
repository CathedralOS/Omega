use omega_language_std::console;

data Player {
    health: i32;
}

domain Player::Valid
requires
    self.health >= 0;

domain Player::Alive
requires
    self in Player::Valid;
    self.health > 0;

domain Player::Critical
requires
    self.health <= 5;

data Main {
    console: Console;
    player: Player;
}

machine Main::main(&mut self) {
    self.player.health = 3;

    transition (self.player in Player::Alive & Player::Critical) {
        (true) -> good()
        _ -> bad()
    }

    state good(&mut self) {
        self.console.exit_process(219);
    }

    state bad(&mut self) {
        self.console.exit_process(220);
    }
}
