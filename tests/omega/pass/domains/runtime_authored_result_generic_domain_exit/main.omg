use omega::language::core::float_operations;
data Cell [copy] { mantissa:f64; power:i32; }
domain Cell::Admitted established by Cell::accept;
machine Cell::accept()->Cell ensures result in Cell::Admitted { Cell { mantissa:0.75, power:-2 } }
machine forward<Carrier>(cell:Carrier)->Carrier requires cell in Cell::Admitted ensures result in Cell::Admitted { cell }
machine main() crashes Trap { let cell:Cell=forward<Cell>(Cell::accept()); transition cell.mantissa == 0.75 { true -> good() false -> bad() } state good() {} state bad() { crash Trap; } }
