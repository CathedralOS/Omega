// A captured scalar keeps its completed guarantee after its former slot changes.
// Expected exit: 0.
domain i64::Issued(value) requires value >= 0 established by issue;
machine query(input: i64) -> i64 ensures result >= 0 {
    transition input >= 0 { true -> (input) _ -> (0) }
}
machine mutate(value: &mut i64) { value = -1; }
machine issue(input: i64) -> i64 in Issued {
    let mut original: i64 = query(input);
    let saved: i64 = original;
    mutate(&mut original);
    saved
}
machine main() crashes Trap {
    let value: i64 in Issued = issue(17);
    transition value == 17 { true -> done() _ -> wrong() }
    machine done() {}
    machine wrong() { crash Trap; }
}
