// A plain record member under a plain domain that means exactly an interval
// (`level: i32 in Ten`) constructs like the case payload member that
// `pass/structs/case_field_type_store_shapes` runs: the literal proves the
// member's range obligation, and the bounded carrier holds the membership.
// It is stored directly, then through a local. Exit 70 = both read back;
// 71 = a wrong value.
// Records and cases share the construction contents rule, including the
// bounded carrier and its independently checked member range obligation.
use omega_language_std::console;

domain i32::Ten(value) requires 0 <= value && value <= 10;

data Gauge { level: i32 in Ten; }

data Main {
    gauge: Gauge;
    spare: Gauge;
}

machine Main::fill_spare(main: &mut Main) {
    let filled: Gauge = Gauge { level: 3 };
    main.spare = filled;
}

machine Main::main(main: &mut Main) reaches Console {
    main.gauge = Gauge { level: 7 };
    Main::fill_spare(main);
    transition main.gauge.level == 7 && main.spare.level == 3 {
        true -> passed(main)
        false -> failed(main)
    }
    state passed(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}
