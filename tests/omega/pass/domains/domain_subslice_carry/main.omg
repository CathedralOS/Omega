// Primitive byte domains survive runtime subslices: `bytes[0..main.end]`
// stays `in Ascii` through a helper parameter and a named local, and the
// empty view `prefix[0..0]` remains a valid ASCII view.
domain [u8]::Ascii(bytes) requires ascii_only(bytes);

data Main { end: u64; }

machine Main::relay(main: &Main, bytes: &[u8] in Ascii) {
    transition main.end < bytes.len {
        true -> Main::cut(main, bytes[0..main.end])
        false -> bad(main)
    }
    machine bad(main: &Main) {}
}
machine Main::cut(main: &Main, prefix: &[u8] in Ascii) {
    let empty: &[u8] = prefix[0..0];
    Main::inspect(main, empty, prefix);
}
machine Main::inspect(main: &Main, empty: &[u8] in Ascii, prefix: &[u8] in Ascii) {
    transition empty.len == 0 && prefix == "ABCD" {
        true -> good()
        false -> bad()
    }
    machine good() {}
    machine bad() {}
}
machine Main::main(main: &mut Main) {
    main.end = 4;
    Main::relay(main, "ABCDE");
}
