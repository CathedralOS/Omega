// `domain<const Axis: u64> i64::Coordinate<Axis>` — a const-generic
// marker domain family: match results deliver `i64 in Coordinate<7>`
// through call arguments and returns; `as i64` strips the tag.
domain<const Axis: u64> i64::Coordinate<Axis>;

machine mark(value: i64) -> i64 in Coordinate<7> {
    value as i64 in Coordinate<7>
}

machine relay(value: i64 in Coordinate<7>) -> i64 in Coordinate<7> {
    value
}

machine choose(select_left: bool, left: i64, right: i64) -> i64 in Coordinate<7> {
    relay(match select_left {
        true -> mark(left),
        false -> mark(right)
    })
}

data Main {}

machine Main::main(main: &mut Main) {
    let picked: i64 = relay(choose(true, 3, 5)) as i64;
    transition picked == 3 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
