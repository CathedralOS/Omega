// A case payload member under a predicate domain that is not an interval:
// `NonZero` excludes one value from the middle of `i32`, so no bounded carrier
// represents its membership. Construction must prove `7 != 0` and retain that
// membership through lowering, and the dispatched payload must carry it into
// the division, whose divisor obligation it discharges. Exit 70 = the payload
// read back 7 and divided 490; 71 = wrong case.
use omega_language_std::console;
use omega::language::core::binding;

domain i32::NonZero(value) requires value != 0;

data Divisor {
    case Unset;
    case By(amount: i32 in NonZero);
}

data Main {
    console: Binding<Console>;
    divisor: Divisor;
}

machine Main::main(main: &mut Main) reaches Console {
    main.divisor = Divisor::By { amount: 7 };
    transition main.divisor {
        Divisor::By { amount } -> quotient(main, 490 / amount)
        Divisor::Unset -> wrong_case(main)
    }
    state quotient(main: &mut Main, value: i32) { main.console.exit_process(value); }
    state wrong_case(main: &mut Main) { main.console.exit_process(71); }
}
