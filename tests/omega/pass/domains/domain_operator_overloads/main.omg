// Domain-scoped operator declarations: `operator Domain::name` overloads
// per operand types — each spelling pins an operator signature under the
// domain's provenance.
data Quantity {
    value: i32;
}
domain Quantity::Additive
requires
    self.value >= 0;
operator Quantity::Additive::combine(left: i32, right: i32) -> i32;
operator Quantity::Additive::combine(left: u64, right: u64) -> u64;
operator Quantity::Additive::scale(factor: i32, quantity: Quantity) -> Quantity;
machine main() {
}
