// Expected exit: 0.
// Returning existing membership and freshly issuing it are distinct origins.
domain i64::Nonnegative(value) requires value >= 0 established by seed, issue, choose;
machine seed() -> i64 in Nonnegative { 17 }
machine issue(old: bool, existing: i64 in Nonnegative) -> i64 in Nonnegative {
    transition old { true -> saved(existing) _ -> fresh() }
    machine saved(value: i64 in Nonnegative) -> i64 in Nonnegative { value }
    machine fresh() -> i64 in Nonnegative { 17 }
}
machine choose(old: bool, existing: i64 in Nonnegative) -> i64 in Nonnegative {
    transition old { true -> (existing) _ -> (17) }
}
machine forward(existing: i64 in Nonnegative) -> i64 in Nonnegative {
    transition { _ -> (existing) }
}
machine main() crashes Trap {
    let existing: i64 in Nonnegative = seed();
    let saved: i64 in Nonnegative = issue(true, existing);
    let fresh: i64 in Nonnegative = issue(false, existing);
    let saved_arm: i64 in Nonnegative = choose(true, existing);
    let fresh_arm: i64 in Nonnegative = choose(false, existing);
    let forwarded: i64 in Nonnegative = forward(existing);
    transition saved == 17 && fresh == 17 && saved_arm == 17 && fresh_arm == 17 && forwarded == 17 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
