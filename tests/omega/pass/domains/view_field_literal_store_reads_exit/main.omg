// RUN CANARY (exit 70). A shared view field takes a literal's descriptor:
// replacing `name` twice leaves the second literal, `raw` holds non-UTF-8
// octets because its plain declaration imposes no predicate, and the
// qualified `name` field is lent whole to a `&[u8] in Utf8` parameter.
// Its length and bytes are observed through the stored descriptor, and a
// later state compares the raw field with the same octets.
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;

data Main {
    name: &[u8] in Utf8;
    raw: &[u8];
}

machine Main::check(main: &Main, text: &[u8] in Utf8) reaches Console {
    transition text == "Door" {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &Main) {
        Console::exit_process(70);
    }

    state bad(main: &Main) {
        Console::exit_process(71);
    }
}

machine Main::main(main: &mut Main) reaches Console {
    main.name = "Gate";
    main.raw = "\xff\x00";
    main.name = "Door";

    transition main.raw.len == 2 {
        true -> raw_bytes(main)
        false -> wrong(main)
    }

    state raw_bytes(main: &mut Main) {
        transition main.raw == "\xff\x00" {
            true -> report(main)
            false -> wrong(main)
        }
    }

    state report(main: &mut Main) {
        Main::check(main, main.name);
    }

    state wrong(main: &mut Main) {
        Console::exit_process(72);
    }
}
