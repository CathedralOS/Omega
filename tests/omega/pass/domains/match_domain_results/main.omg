// `as i64 in Km` inside match arm results delivers each arm in the
// marker domain the `-> i64 in Km` return declares.
domain i64::Km;
machine choose(select_left: bool, left: i64, right: i64) -> i64 in Km {
    match select_left {
        true -> left as i64 in Km,
        false -> right as i64 in Km
    }
}
data Main { left: i64; }
machine Main::main(main: &mut Main) {
    main.left = 40;
    let picked: i64 in Km = choose(true, main.left, 3);
    transition picked == 40 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
