// A non-interval predicate admits zero initially, then survives record
// construction, a local copy and a direct member replacement. The excluded
// value is deliberately not zero: field validity is not a NonZero special case.
use omega_language_std::console;

domain i32::NotFive(value) requires value != 5;
data Gauge { level: i32 in NotFive; }
data Main { gauge: Gauge; spare: Gauge; }

machine Main::fill_spare(main: &mut Main) {
    let filled: Gauge = Gauge { level: 3 };
    main.spare = filled;
}

machine Main::main(main: &mut Main) reaches Console {
    main.gauge = Gauge { level: 7 };
    Main::fill_spare(main);
    main.gauge.level = 8;
    transition main.gauge.level == 8 && main.spare.level == 3 {
        true -> passed(main)
        false -> failed(main)
    }
    state passed(main: &mut Main) { Console::exit_process(70); }
    state failed(main: &mut Main) { Console::exit_process(71); }
}
