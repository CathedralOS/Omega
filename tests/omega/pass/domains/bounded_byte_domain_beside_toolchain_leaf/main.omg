// `std::calling` declares `pub domain [u8; 256]::Utf8`. A bounded byte domain
// normalizes its capacity to `[u8; N]`, so an authored declaration over a
// different capacity shares that normalized name with the bundled one. The two
// are unrelated owners, so they hold separate identities and this declaration
// is admitted beside the toolchain leaf.
domain [u8; 8]::Utf8
requires
    valid_utf8(self);

data Main {
    items: [u8; 8] in Utf8;
}

machine Main::main(&mut self) {
}
