// P1a: the canonical semicolon spelling and the empty-braced spelling both
// declare bodyless facts. An explicit `true` body remains a predicate body.

use omega_language_std::console;
use omega::language::core::service;

data Ticket {
    serial: u64;
}

domain Ticket::Issued;
domain Ticket::Recorded;
domain Ticket::Universal
requires
    true;

data Main {
    console: Binding<Console>;
}

machine Main::main(&mut self) reaches Console {
    self.console.exit_process(70);
}
