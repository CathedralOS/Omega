// Expected exit: 0. Literal, live storage, qualification and forwarding use
// the same selected fixed-width predicate, including unsigned and signed edges.
const MASK: u32 = 2;
const WRAPPED_MASK: u8 = ((255u8 as u8 in Wrapping) + (3u8 as u8 in Wrapping)) as u8;
domain u32::Flags(value)
    requires (value & 2) == 0;
    (value & MASK) == 0;
    (value | 1u32) == 129;
    (value ^ (1 as u32)) == 129;
domain u64::High(value) requires (value & 9223372036854775808) == 9223372036854775808;
domain i8::Even(value) requires (value & 1) == 0;
domain u8::Clear(value) requires (value & WRAPPED_MASK) == 0;
domain u8::Small(value) requires value <= 10;
domain i32::Always(value) requires true;
domain u32::Issued(value) requires (value & 2) == 0 established by Issuer::issue;
trait Issuer { machine issue() -> u32 ensures result in Issued; }
domain u32::Nested(value) requires value in Issued;

data Options { flags: u32; }
data Guarded { value: i8 in Even; }
machine accept(flags: u32 in Flags) -> u32 { flags as u32 }
machine forward(flags: u32 in Flags) -> u32 { accept(flags) }
machine high(flags: u64 in High) -> u64 { flags as u64 }
machine even(value: i8 in Even) -> i8 { value as i8 }
machine wrapped_mask(value: u8 in Clear) -> u8 { value as u8 }
machine bounded_wrapping(value: u8 in Small & Wrapping) -> u8 { value as u8 }
machine read_guarded(guarded: &Guarded) -> i8 { even(guarded.value) }
machine always(value: i32 in Always) -> i32 { value as i32 }
machine unknown(value: i32) -> i32 { always(value) }
machine nested(value: u32 in Nested) -> u32 { value as u32 }
machine retain(value: u32 in Issued) -> u32 { nested(value) }
machine arrival(options: &Options, value: u32 in Flags) -> u32 {
    transition { _ -> observed(options, value) }
    machine observed(options: &Options, value: u32 in Flags) -> u32 {
        accept(value)
    }
}

machine main() crashes Trap {
    let literal: u32 = accept(128);
    let local: u32 = 128;
    let options: Options = Options { flags: 128 };
    let from_local: u32 = accept(local);
    let from_field: u32 = accept(options.flags);
    let qualified: u32 in Flags = 128 as u32 in Flags;
    let forwarded: u32 = forward(qualified);
    let arrived: u32 = arrival(&options, qualified);
    let unsigned: u64 = high(18446744073709551615);
    let signed: i8 = even(-2);
    let guarded: Guarded = Guarded { value: -2 };
    let qualified_field: i8 = read_guarded(&guarded);
    let independent: i32 = unknown(23);
    let wrapped: u8 = wrapped_mask(128);
    let bounded: u8 = bounded_wrapping(7);
    transition literal == 128 && from_local == 128 && from_field == 128
        && forwarded == 128 && unsigned == 18446744073709551615 && signed == -2
        && independent == 23 && arrived == 128 && qualified_field == -2
        && wrapped == 128 && bounded == 7 {
        true -> done()
        false -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
