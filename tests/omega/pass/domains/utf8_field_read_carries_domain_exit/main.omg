// RUN CANARY (exit 70). #66 read-narrowing: a DECLARED-domain field
// (`out: &[u8] in Utf8`) carries its `in Utf8` fact when READ. `main.out = "Gate"`
// stores a literal (granted Utf8, write-enforced); then `Main::check(main, main.out)`
// passes the field READ to a `&[u8] in Utf8` parameter -- which only discharges
// because the field read carries the declared domain (before this fix it failed
// with "cannot prove requires contract ... main.out in [u8]::Utf8"). `check`
// guards `text == "Gate"` (content equality over the carried view) and exits 70.
// (Counter-checked: storing "Door" makes the `== "Gate"` guard false -> exit 71.)
domain [u8]::Utf8(bytes)
requires
    valid_utf8(bytes);
use omega_language_std::console;
use omega::language::core::binding;

data Main {
    console: Binding<Console>;
    out: &[u8] in Utf8;
}

machine Main::check(main: &Main, text: &[u8] in Utf8) reaches Console {
    transition text == "Gate" {
        true -> good(main)
        _ -> bad(main)
    }

    state good(main: &Main) {
        main.console.exit_process(70);
    }

    state bad(main: &Main) {
        main.console.exit_process(71);
    }
}

machine Main::main(main: &mut Main) {
    main.out = "Gate";
    Main::check(main, main.out);
}
