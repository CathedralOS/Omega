// Coherence is judged from the domains participating at an operator use, not
// by globally comparing every declaration in the program. These two semantic
// domains may therefore provide the same spelling and operand tuple over the
// same carrier. A binding that selects both is rejected by the matching fail
// canary `domain_operator_competing_spelling_meanings`.

data Quantity {
    value: i32;
}

domain Quantity::Linear
requires
    self.value >= 0;

machine + Quantity::Linear::add(left: Quantity, right: Quantity) -> Quantity {
    Quantity { value: ((left.value as i32 in Wrapping) + (right.value as i32 in Wrapping)) as i32 }
}

domain Quantity::Cyclic
requires
    self.value >= 0;

machine + Quantity::Cyclic::add(left: Quantity, right: Quantity) -> Quantity {
    Quantity { value: ((left.value as i32 in Wrapping) + (right.value as i32 in Wrapping)) as i32 }
}

data Main {}

machine Main::main(&mut self) {}
