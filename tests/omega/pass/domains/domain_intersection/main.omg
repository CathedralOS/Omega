// A requires fact may demand several domains at once:
// `password in Password::Valid & Password::Secure` — each member's
// ensures establishes its own fact on the caller's place, and an
// unrelated `in Wrapping` field write in between keeps both alive.
data Password [copy] {
    length: i32;
    score: i32;
    salt: i32 in Wrapping;
}
domain Password::Valid
requires
    self.length > 0;
domain Password::Secure
requires
    self.score >= 8;
machine mark_valid(password: &mut Password)
ensures
    password in Password::Valid
{
    password.length = 12;
}
machine mark_secure(password: &mut Password)
ensures
    password in Password::Secure
{
    password.score = 10;
}
machine touch_salt(password: &mut Password) {
    password.salt = password.salt + 1;
}
data Main {
    password: Password;
}
machine Main::accept(password: Password)
requires
    password in Password::Valid & Password::Secure
{
}
machine Main::main(main: &mut Main) {
    mark_valid(&mut main.password);
    mark_secure(&mut main.password);
    touch_salt(&mut main.password);
    Main::accept(main.password);
}
