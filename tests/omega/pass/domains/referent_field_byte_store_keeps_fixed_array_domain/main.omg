// A named `&mut T` referent's fixed-array field keeps its byte class across an
// indexed store whose byte a taken-arm guard bounds. The store re-mints the
// carrier's class at the referent's own root spelling -- the same law an
// attached machine field follows -- so the normal return still proves the
// field's declared domain. The guard is spelled as a transition SUBJECT, whose
// capture must carry the same bound an authored arm guard would.
domain [u8; 4]::Utf8(bytes) requires valid_utf8(bytes);

data Buffer { label: [u8; 4] in Utf8; }

machine store(buffer: &mut Buffer, byte: u8) {
    buffer.label = "Gate";
    transition byte < 128 {
        true -> write(buffer, byte)
        _ -> keep(buffer)
    }
    machine write(buffer: &mut Buffer, byte: u8) { buffer.label[1] = byte; }
    machine keep(buffer: &mut Buffer) { }
}