// A wire-policy plan vocabulary: `FieldPlan` sum carrying the wire
// placement cases (`At`, `Bits`, `Varint`, `LengthPrefixed`) distinct
// from the layout plan's `IntegerAt`/`Bits` fragment vocabulary.
data FieldKind { case Scalar; case Text; case Nested; case Repeated; }
data FieldPlan [copy] {
    case At(offset: u64);
    case Bits(container: u64, container_width: u64, lsb: u64, width: u64);
    case Varint(tag: u64);
    case LengthPrefixed(tag: u64);
}
data Plan {
    fields: [FieldPlan; 32];
    entry_count: u64;
    size_fixed: u64;
    size_is_dynamic: bool;
    align: u64;
}
machine describe(field: FieldPlan) -> u64 in Wrapping {
    transition field {
        FieldPlan::At{offset} -> (offset as u64 in Wrapping)
        FieldPlan::Bits{container, container_width, lsb, width} -> ((container_width as u64 in Wrapping) + (width as u64 in Wrapping))
        FieldPlan::Varint{tag} -> ((tag as u64 in Wrapping) + 1)
        FieldPlan::LengthPrefixed{tag} -> ((tag as u64 in Wrapping) + 2)
    }
}
data Main { plan: Plan; }
machine Main::main(main: &mut Main) {
    main.plan.fields[0] = FieldPlan::Varint { tag: 7 };
    main.plan.fields[1] = FieldPlan::LengthPrefixed { tag: 9 };
    main.plan.fields[2] = FieldPlan::Bits { container: 0, container_width: 8, lsb: 3, width: 2 };
    main.plan.fields[3] = FieldPlan::At { offset: 24 };
    main.plan.entry_count = 4;
    let total: u64 in Wrapping = describe(main.plan.fields[0]) + describe(main.plan.fields[1]) + describe(main.plan.fields[2]) + describe(main.plan.fields[3]);
    transition total == 8 + 11 + 10 + 24 {
        true -> done()
        _ -> bad()
    }
    machine done() {}
    machine bad() {}
}
