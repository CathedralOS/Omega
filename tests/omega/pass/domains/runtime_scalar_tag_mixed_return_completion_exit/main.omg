// Expected exit: 0.
// Empty tags still retain the exact fresh result-completion binding.
domain i64::Tagged(value);
machine seed() -> i64 in Tagged { 17 }
machine choose(old: bool, existing: i64 in Tagged) -> i64 in Tagged {
    transition old { true -> (existing) _ -> (17) }
}
machine consume(value: i64 in Tagged) -> i64 { value as i64 }
machine main() crashes Trap {
    let existing: i64 in Tagged = seed();
    let saved: i64 in Tagged = choose(true, existing);
    let fresh: i64 in Tagged = choose(false, existing);
    transition consume(saved) == 17 && consume(fresh) == 17 {
        true -> done()
        _ -> wrong()
    }
    machine done() {}
    machine wrong() { crash Trap; }
}
