// Expected exit: 0
domain [u16; 4]::Terminated(value) requires value[3] == 0;
machine read(value: &[u16; 4]) -> u16 { value[0] }
machine classify(value: [u16; 4] in Terminated) -> u64 {
    let first: u16 = read(&value);
    transition first > 0 { true -> 3 false -> 0 }
}
machine main() crashes Trap {
    let mut ready: [u16; 4];
    ready[0] = 3;
    ready[3] = 0;
    let ready_result: u64 = classify(ready);
    let mut empty: [u16; 4];
    empty[3] = 0;
    let empty_result: u64 = classify(empty);
    transition ready_result == 3 && empty_result == 0 {
        true -> done()
        false -> bad()
    }
    state done() {}
    state bad() { crash Trap; }
}
