// Expected exit: 0
// A completed owned selected-element copy retains conditional routed payloads.
domain u64::Issued(value) requires value > 0 established by issue;
machine issue() -> u64 in Issued { 3 }
machine consume(value: u64 in Issued) -> u64 { value - 1 }
data Frame [copy] { case Empty; case Ready(value: u64 in Issued); }
machine select(frames: &[Frame; 4096], position: u64) -> u64
requires position < 4096 {
    let copied: Frame = frames[position];
    transition copied { Frame::Empty -> 99 Frame::Ready { value } -> (consume(value)) }
}
machine main() crashes Trap {
    let mut frames: [Frame; 4096];
    frames[9] = Frame::Ready { value: issue() };
    let observed: u64 = select(&frames, 9);
    frames[9] = Frame::Empty;
    transition observed == 2 { true -> done() false -> bad() }
    state done() {}
    state bad() { crash Trap; }
}
